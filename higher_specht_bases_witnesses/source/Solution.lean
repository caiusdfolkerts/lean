module

public import higher_specht.verified.remaining04_geometry_complete

@[expose] public section
noncomputable section

open TauCeti MvPolynomial
open scoped BigOperators

namespace HigherSpecht

/-- The Specht representation of this shape, presented as the left ideal
generated by the row symmetrizer times the column antisymmetrizer. -/
abbrev paperYoungIdealRepresentation {n : ℕ} (part : n.Partition)
    (T : YoungTableau (YoungDiagram.ofPartition part)) :=
  Representation.ofModule' (k := ℂ) (G := Equiv.Perm (Fin n))
    (Ideal.span {(MonoidAlgebra.domCongr ℂ ℂ
        (finCongr (YoungDiagram.card_ofPartition part)).permCongrHom
        (TauCeti.YoungTableau.youngSymmetrizerOver ℂ T))} :
      Ideal (MonoidAlgebra ℂ (Equiv.Perm (Fin n))))

/-- The ordinary apolar pairing written in monomial coefficients. -/
def apolarCoefficientPairing {n : ℕ} (f p : PolynomialRing n ℂ) : ℂ :=
  ∑ a ∈ f.support, f.coeff a * (p.coeff a * ((∏ j, (a j).factorial : ℕ) : ℂ))

private theorem apolarCoefficientPairing_eq {n : ℕ} (f p : PolynomialRing n ℂ) :
    apolarCoefficientPairing f p = ordinaryApolarFunctional p f := by
  unfold apolarCoefficientPairing
  conv_rhs => rw [MvPolynomial.as_sum f]
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro a ha
  have hm : MvPolynomial.monomial a (f.coeff a) =
      f.coeff a • MvPolynomial.monomial a (1 : ℂ) := by
    rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  rw [hm, map_smul, ordinaryApolar_monomial] <;> rfl

/-- The untruncated witness is the actual Vandermonde column product times
the exterior cocharge monomial, with exactly the prescribed rejection and
factorial. -/
def literalUntruncatedHarmonicVector {n : ℕ} (i : UnboundedHarmonicIndex n)
    (T : YoungTableau (YoungDiagram.ofPartition i.part)) : PolynomialRing n ℂ :=
  let k := maximalUntruncatedPrefix i
  let hk := maximalUntruncatedPrefix_le i
  let e := prefixAmbientEmbedding i.left T k hk
  let U := (insertionFilling (prefixTableau i.left k hk)
    (prefixTableau i.left k hk).toTableau).toEmbedding.trans e
  let G : PolynomialRing (YoungDiagram.ofPartition i.part).card ℂ :=
    (∏ j ∈ Finset.range (YoungDiagram.ofPartition i.part).card, columnAlternant U j) *
      MvPolynomial.monomial (exteriorPart e (transportedBoosted i.left T i.multiplier)) 1
  MvPolynomial.rename (finCongr (YoungDiagram.card_ofPartition i.part))
    (adjointYoungApply T (normalizedOrdinaryDerivative
      (untruncatedWitnessRejection i.left T i.multiplier k hk) G))

private theorem literalUntruncatedHarmonicVector_eq {n : ℕ}
    (i : UnboundedHarmonicIndex n) (T : YoungTableau (YoungDiagram.ofPartition i.part)) :
    literalUntruncatedHarmonicVector i T = untruncatedCommonHarmonicVectorWithTableau i T := by
  rw [literalUntruncatedHarmonicVector, untruncatedCommonHarmonicVectorWithTableau,
    untruncatedApolarWitness_eq]

theorem finite_harmonics_literal_witnesses
    (n s : ℕ) (hn : 0 < n) (hs : 0 < s)
    (T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part)) :
    ∃ S : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part),
    ∃ W : FiniteHarmonicIndex n s → Subrepresentation (polynomialRepresentation ℂ n),
      (∀ i, (W i).toSubmodule = cyclicPolynomialCopy (finiteCommonHarmonicVectorWithTableau i (T i.part)) ∧
        Nonempty (Representation.Equiv
          (paperYoungIdealRepresentation i.part (S i.part)) (W i).toRepresentation) ∧
        (W i).toRepresentation.IsIrreducible ∧
        (W i).toSubmodule ≤
          homogeneousSubmodule (Fin n) ℂ i.toUnboundedHarmonicIndex.degree) ∧
      iSupIndep (fun i => (W i).toSubmodule) ∧
      ∀ (lam : YoungDiagram) (hk : lam.card ≤ n), lam.colLen 0 ≤ s →
        ∀ p : PolynomialRing n ℂ,
          (∀ f ∈ griffinIdeal ℂ n lam s, apolarCoefficientPairing f p = 0) ↔
          p ∈ ⨆ i : {i : FiniteHarmonicIndex n s //
            i.toUnboundedHarmonicIndex.eligible lam hk}, (W i.val).toSubmodule := by
  classical
  let S : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part) :=
    fun part => (StandardYoungTableau.rowSuperstandard _).toTableau
  obtain ⟨hcopy, hind, hdecomp⟩ := theorem_5_2_any_right_tableaux n s hn hs T
  let W : FiniteHarmonicIndex n s → Subrepresentation (polynomialRepresentation ℂ n) :=
    fun i => (Classical.choose (hcopy i).1).range
  have hW (i) : (W i).toSubmodule = finiteCommonHarmonicCopyWithTableau i (T i.part) :=
    (Classical.choose_spec (hcopy i).1).2
  refine ⟨S, W, ?_, ?_, ?_⟩
  · intro i
    let f := Classical.choose (hcopy i).1
    let E := f.equivOfRange (Classical.choose_spec (hcopy i).1).1 (P := W i) rfl
    letI := complexYoungIdealRepresentation_isIrreducible i.part
    exact ⟨hW i, ⟨E⟩, irreducible_of_representation_equiv E,
      by simpa only [hW] using (hcopy i).2⟩
  · simpa only [hW] using hind
  · intro lam hk hheight p
    simpa only [apolarCoefficientPairing_eq, ← mem_ordinaryHarmonics_iff_apolar, hW] using
      (show p ∈ ordinaryHarmonics (griffinIdeal ℂ n lam s) ↔
        p ∈ ⨆ i : {i : FiniteHarmonicIndex n s // i.toUnboundedHarmonicIndex.eligible lam hk},
          finiteCommonHarmonicCopyWithTableau i.val (T i.val.part) from by rw [hdecomp lam hk hheight])

theorem untruncated_harmonics_literal_witnesses
    (n : ℕ) (T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part)) :
    ∃ S : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part),
    ∃ W : UnboundedHarmonicIndex n → Subrepresentation (polynomialRepresentation ℂ n),
      (∀ i, (W i).toSubmodule = cyclicPolynomialCopy (literalUntruncatedHarmonicVector i (T i.part)) ∧
        Nonempty (Representation.Equiv
          (paperYoungIdealRepresentation i.part (S i.part)) (W i).toRepresentation) ∧
        (W i).toRepresentation.IsIrreducible ∧
        (W i).toSubmodule ≤ homogeneousSubmodule (Fin n) ℂ i.degree) ∧
      iSupIndep (fun i => (W i).toSubmodule) ∧
      (∀ d : ℕ, Set.Finite {i : UnboundedHarmonicIndex n | i.degree = d}) ∧
      ∀ (lam : YoungDiagram) (hk : lam.card ≤ n), ∀ p : PolynomialRing n ℂ,
        (∀ f ∈ untruncatedIdeal ℂ n lam, apolarCoefficientPairing f p = 0) ↔
        p ∈ ⨆ i : {i : UnboundedHarmonicIndex n // i.eligible lam hk}, (W i.val).toSubmodule := by
  classical
  let S : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part) :=
    fun part => (StandardYoungTableau.rowSuperstandard _).toTableau
  obtain ⟨hcopy, hind, hfinite, hdecomp⟩ := theorem_6_6_any_right_tableaux n T
  let W : UnboundedHarmonicIndex n → Subrepresentation (polynomialRepresentation ℂ n) :=
    fun i => (Classical.choose (hcopy i).1).range
  have hW (i) : (W i).toSubmodule = untruncatedCommonHarmonicCopyWithTableau i (T i.part) :=
    (Classical.choose_spec (hcopy i).1).2
  refine ⟨S, W, ?_, ?_, hfinite, ?_⟩
  · intro i
    let f := Classical.choose (hcopy i).1
    let E := f.equivOfRange (Classical.choose_spec (hcopy i).1).1 (P := W i) rfl
    letI := complexYoungIdealRepresentation_isIrreducible i.part
    exact ⟨by rw [literalUntruncatedHarmonicVector_eq]; exact hW i, ⟨E⟩, irreducible_of_representation_equiv E,
      by simpa only [hW] using (hcopy i).2⟩
  · simpa only [hW] using hind
  · intro lam hk p
    simpa only [apolarCoefficientPairing_eq, ← mem_ordinaryHarmonics_iff_apolar, hW] using
      (show p ∈ ordinaryHarmonics (untruncatedIdeal ℂ n lam) ↔
        p ∈ ⨆ i : {i : UnboundedHarmonicIndex n // i.eligible lam hk},
          untruncatedCommonHarmonicCopyWithTableau i.val (T i.val.part) from by rw [hdecomp lam hk])

theorem springer_literal_column_witness {n : ℕ} (hn : 0 < n)
    (z : SpringerCommonIndex n) (T : YoungTableau (YoungDiagram.ofPartition z.1)) :
    springerCommonHarmonicVectorWithTableau hn z T =
      MvPolynomial.rename (finCongr (YoungDiagram.card_ofPartition z.1))
        (adjointYoungApply T
          (normalizedOrdinaryDerivative (insertionRejectionExponent z.2 T)
            (columnWitness (insertionFilling z.2 T).toEmbedding 1))) := by
  rw [springerCommonHarmonicVectorWithTableau_literal_formula,
    higherSpechtWitness_eq_columnWitness]

end HigherSpecht
