module

public import sunlet.permutation_families
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-! A proof that the finite graph definition of a color orbit is exactly
the orbit of the subgroup generated by the actual permutations. -/

@[expose] public section
noncomputable section

namespace Sunlet

variable {ι Ω : Type*} [Fintype Ω] [DecidableEq Ω]

theorem colorConnected_iff_generated_action
    (π : ι → Equiv.Perm Ω) (P : Set ι) (x y : Ω) :
    ColorConnected π P x y ↔
      ∃ g : Equiv.Perm Ω, g ∈ Subgroup.closure (π '' P) ∧ g x = y := by
  constructor
  · intro h
    induction h with
    | rel x y h =>
        obtain ⟨a, ha, heq⟩ := h
        exact ⟨π a, Subgroup.subset_closure ⟨a, ha, rfl⟩, heq⟩
    | refl x => exact ⟨1, (Subgroup.closure _).one_mem, rfl⟩
    | symm x y _ ih =>
        obtain ⟨g, hg, heq⟩ := ih
        refine ⟨g⁻¹, (Subgroup.closure _).inv_mem hg, ?_⟩
        rw [← heq]
        simp
    | trans x y z _ _ ih₁ ih₂ =>
        obtain ⟨g, hg, hgx⟩ := ih₁
        obtain ⟨h, hh, hhy⟩ := ih₂
        refine ⟨h * g, (Subgroup.closure _).mul_mem hh hg, ?_⟩
        simpa [Equiv.Perm.mul_apply, hgx] using hhy
  · rintro ⟨g, hg, rfl⟩
    have hall : ∀ z, ColorConnected π P z (g z) := by
      induction hg using Subgroup.closure_induction with
      | mem g hg =>
          obtain ⟨a, ha, rfl⟩ := hg
          exact colorConnected_step π P ha
      | one => exact colorConnected_refl π P
      | mul g h hg hh ihg ihh =>
          intro z
          exact Relation.EqvGen.trans _ _ _ (ihh z) (ihg (h z))
      | inv g hg ih =>
          intro z
          have h := ih (g⁻¹ z)
          have hs := Relation.EqvGen.symm _ _ h
          simpa [ColorConnected] using hs
    exact hall x

theorem transitiveFamily_iff_generated_action (π : ι → Equiv.Perm Ω) (P : Set ι) :
    TransitiveFamily π P ↔
      ∀ x y, ∃ g : Equiv.Perm Ω, g ∈ Subgroup.closure (π '' P) ∧ g x = y := by
  simp only [TransitiveFamily, colorConnected_iff_generated_action]

end Sunlet
