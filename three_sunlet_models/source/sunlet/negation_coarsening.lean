module

public import sunlet.index_two_orbit_rigidity

/-!
# The actual automorphism subgroup obtained by adjoining negation

The coarse classes below are genuine automorphism orbits. Their relation is
proved to be the union of a fine orbit and its negative, rather than supplied
as an abstract partition hypothesis.
-/

@[expose] public section
noncomputable section

namespace Sunlet.OrbitClasses

variable {G : Type*} [AddCommGroup G]

@[simp] theorem negation_apply (x : G) : negation (G := G) x = -x := rfl

theorem negation_add_comm (φ : AddAut G) :
    negation (G := G) + φ = φ + negation := by
  ext x
  change -(φ x) = φ (-x)
  exact (map_neg φ x).symm

@[simp] theorem negation_add_self :
    negation (G := G) + negation = 0 := by
  ext x
  exact neg_neg x

@[simp] theorem neg_negation : -negation (G := G) = negation := rfl

private theorem add_negation_add_negation (φ ψ : AddAut G) :
    (φ + negation) + (ψ + negation) = φ + ψ := by
  ext x
  change φ (-(ψ (-x))) = φ (ψ x)
  simp only [map_neg, neg_neg]

private theorem add_negation_comm_right (φ ψ : AddAut G) :
    (φ + negation) + ψ = (φ + ψ) + negation := by
  rw [add_assoc, negation_add_comm, ← add_assoc]

private theorem neg_add_negation (φ : AddAut G) :
    -(φ + negation) = (-φ) + negation := by
  rw [neg_add_rev, neg_negation, negation_add_comm]

/-- The actual subgroup generated by `B` and inversion. The explicit two-coset
description is valid because inversion is central and has order at most two. -/
def withNegation (B : AddSubgroup (AddAut G)) : AddSubgroup (AddAut G) where
  carrier := {φ | φ ∈ B ∨ φ + negation ∈ B}
  zero_mem' := Or.inl B.zero_mem
  add_mem' := by
    rintro φ ψ (hφ | hφ) (hψ | hψ)
    · exact Or.inl (B.add_mem hφ hψ)
    · exact Or.inr (by simpa only [add_assoc] using B.add_mem hφ hψ)
    · exact Or.inr (by simpa only [add_negation_comm_right] using B.add_mem hφ hψ)
    · exact Or.inl (by simpa only [add_negation_add_negation] using B.add_mem hφ hψ)
  neg_mem' := by
    rintro φ (hφ | hφ)
    · exact Or.inl (B.neg_mem hφ)
    · exact Or.inr (by simpa only [neg_add_negation] using B.neg_mem hφ)

@[simp] theorem mem_withNegation (B : AddSubgroup (AddAut G)) (φ : AddAut G) :
    φ ∈ withNegation B ↔ φ ∈ B ∨ φ + negation ∈ B := Iff.rfl

theorem le_withNegation (B : AddSubgroup (AddAut G)) : B ≤ withNegation B :=
  fun _ h => Or.inl h

theorem negation_mem_withNegation (B : AddSubgroup (AddAut G)) :
    negation (G := G) ∈ withNegation B :=
  Or.inr (by simpa only [negation_add_self] using B.zero_mem)

/-- The explicit subgroup has the universal property of adjoining inversion. -/
theorem withNegation_le (B C : AddSubgroup (AddAut G))
    (hBC : B ≤ C) (hneg : negation (G := G) ∈ C) : withNegation B ≤ C := by
  intro φ hφ
  rcases hφ with hφ | hφ
  · exact hBC hφ
  · have h := C.add_mem (hBC hφ) hneg
    simpa only [add_assoc, negation_add_self, add_zero] using h

theorem withNegation_eq_of_mem (B : AddSubgroup (AddAut G))
    (hneg : negation (G := G) ∈ B) : withNegation B = B :=
  le_antisymm (withNegation_le B B le_rfl hneg) (le_withNegation B)

theorem withNegation_eq_of_negation_zero (B : AddSubgroup (AddAut G))
    (hneg : negation (G := G) = 0) : withNegation B = B :=
  withNegation_eq_of_mem B (by simpa only [hneg] using B.zero_mem)

/-- Two coarse classes agree exactly when the fine classes agree up to
negation. Every witness is an actual automorphism in the indicated subgroup. -/
theorem classOf_withNegation_eq_iff (B : AddSubgroup (AddAut G)) (a b : G) :
    classOf (withNegation B) a = classOf (withNegation B) b ↔
      classOf B a = classOf B b ∨ classOf B (-a) = classOf B b := by
  constructor
  · intro h
    obtain ⟨φ, hφ⟩ := (classOf_eq_iff (withNegation B) a b).mp h
    rcases φ.property with hmem | hmem
    · exact Or.inl ((classOf_eq_iff B a b).mpr ⟨⟨φ.val, hmem⟩, hφ⟩)
    · apply Or.inr
      apply (classOf_eq_iff B (-a) b).mpr
      refine ⟨⟨φ.val + negation, hmem⟩, ?_⟩
      change φ.val (-(-a)) = b
      simpa only [neg_neg] using hφ
  · rintro (h | h)
    · obtain ⟨φ, hφ⟩ := (classOf_eq_iff B a b).mp h
      exact (classOf_eq_iff (withNegation B) a b).mpr
        ⟨⟨φ.val, le_withNegation B φ.property⟩, hφ⟩
    · obtain ⟨φ, hφ⟩ := (classOf_eq_iff B (-a) b).mp h
      refine (classOf_eq_iff (withNegation B) a b).mpr ⟨⟨φ.val + negation, ?_⟩, hφ⟩
      exact (withNegation B).add_mem (le_withNegation B φ.property)
        (negation_mem_withNegation B)

/-- The literal quotient map from fine automorphism orbits to coarse orbits. -/
def coarsenClass (B : AddSubgroup (AddAut G)) : Class B → Class (withNegation B) :=
  Quotient.map' id (by
    rintro a b ⟨φ, hφ⟩
    exact ⟨⟨φ.val, le_withNegation B φ.property⟩, hφ⟩)

@[simp] theorem coarsen_classOf (B : AddSubgroup (AddAut G)) (a : G) :
    coarsenClass B (classOf B a) = classOf (withNegation B) a := rfl

theorem coarsenClass_surjective (B : AddSubgroup (AddAut G)) :
    Function.Surjective (coarsenClass B) := by
  intro q
  obtain ⟨a, rfl⟩ := classOf_surjective (withNegation B) q
  exact ⟨classOf B a, rfl⟩

theorem coarsenClass_eq_iff (B : AddSubgroup (AddAut G)) (c d : Class B) :
    coarsenClass B c = coarsenClass B d ↔ c = d ∨ negClass B c = d := by
  refine Quotient.inductionOn₂ c d ?_
  intro a b
  exact classOf_withNegation_eq_iff B a b

@[simp] theorem coarsenClass_negClass (B : AddSubgroup (AddAut G)) (c : Class B) :
    coarsenClass B (negClass B c) = coarsenClass B c := by
  refine Quotient.inductionOn c ?_
  intro a
  exact classOf_neg (withNegation B) (negation_mem_withNegation B) a

theorem coarsenClass_zero_iff (B : AddSubgroup (AddAut G)) (c : Class B) :
    coarsenClass B c = classOf (withNegation B) 0 ↔ c = classOf B 0 := by
  refine Quotient.inductionOn c ?_
  intro a
  exact (zero_class_iff (withNegation B) a).trans (zero_class_iff B a).symm

/-- In the index-two coarse exception, adjoining inversion did not enlarge
the original automorphism subgroup: the actual group has exponent two. -/
theorem coarse_indexTwoException_withNegation_eq [Fintype G]
    (B : AddSubgroup (AddAut G)) (hm : 5 ≤ Fintype.card G)
    (hex : (inverseStablePartition (withNegation B)
      (negation_mem_withNegation B)).IndexTwoException) : withNegation B = B := by
  have h := indexTwoException_exponent_two (withNegation B)
    (negation_mem_withNegation B) hm hex
  apply withNegation_eq_of_negation_zero
  ext x
  change -x = x
  exact (eq_neg_of_add_eq_zero_left (by simpa only [two_nsmul] using h x)).symm

/-- With two coarse classes, every nonzero element has the same coarse class
as any specified nonzero fine class. -/
theorem coarse_two_nonzero_class [Fintype G]
    (B : AddSubgroup (AddAut G))
    (hr : Fintype.card (Class (withNegation B)) = 2)
    (c : Class B) (hc : c ≠ classOf B 0) (x : G) (hx : x ≠ 0) :
    classOf (withNegation B) x = coarsenClass B c := by
  classical
  have hc' : coarsenClass B c ≠ classOf (withNegation B) 0 :=
    fun h => hc ((coarsenClass_zero_iff B c).mp h)
  have hp : ({classOf (withNegation B) 0, coarsenClass B c} :
      Finset (Class (withNegation B))) = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    simpa only [Finset.card_univ, hr, Finset.card_pair hc'.symm] using Nat.le_refl 2
  have hm : classOf (withNegation B) x ∈
      ({classOf (withNegation B) 0, coarsenClass B c} :
        Finset (Class (withNegation B))) := by
    rw [hp]
    exact Finset.mem_univ _
  rcases Finset.mem_insert.mp hm with hz | hc
  · exact (hx ((zero_class_iff (withNegation B) x).mp hz)).elim
  · exact Finset.mem_singleton.mp hc

/-- A fine nonzero orbit generates the whole abelian group whenever its
coarsening is the unique nonzero coarse orbit. No element-order classification
is required. -/
theorem orbit_fiber_generates_of_coarse_two [Fintype G]
    (B : AddSubgroup (AddAut G))
    (hr : Fintype.card (Class (withNegation B)) = 2)
    (c : Class B) (hc : c ≠ classOf B 0) :
    AddSubgroup.closure {x : G | classOf B x = c} = ⊤ := by
  classical
  apply top_unique
  intro x _
  by_cases hx : x = 0
  · simpa only [hx] using (AddSubgroup.closure {x : G | classOf B x = c}).zero_mem
  · obtain ⟨a, ha⟩ := classOf_surjective B c
    have heq : classOf (withNegation B) x = classOf (withNegation B) a := by
      exact (coarse_two_nonzero_class B hr c hc x hx).trans
        (congrArg (coarsenClass B) ha).symm
    rcases (classOf_withNegation_eq_iff B x a).mp heq with h | h
    · exact AddSubgroup.subset_closure (h.trans ha)
    · have hn : -x ∈ AddSubgroup.closure {x : G | classOf B x = c} :=
        AddSubgroup.subset_closure (h.trans ha)
      simpa only [neg_neg] using (AddSubgroup.closure {x : G | classOf B x = c}).neg_mem hn

/-- Under the paper's size hypothesis each nonzero fine orbit in the two-class
coarsening contains at least two elements. -/
theorem orbit_fiber_nontrivial_of_coarse_two [Fintype G]
    (B : AddSubgroup (AddAut G))
    (hr : Fintype.card (Class (withNegation B)) = 2)
    (c : Class B) (hc : c ≠ classOf B 0)
    (hm : 5 ≤ Fintype.card G) :
    Set.Nontrivial {x : G | classOf B x = c} := by
  classical
  obtain ⟨a, ha⟩ := classOf_surjective B c
  by_contra h
  have hone : ∀ x : G, classOf B x = c → x = a := by
    intro x hx
    by_contra hxa
    exact h ⟨x, hx, a, ha, hxa⟩
  have hsmall : (Finset.univ : Finset G) ⊆ {0, a, -a} := by
    intro x _
    by_cases hx : x = 0
    · simp only [hx, Finset.mem_insert, true_or]
    · have heq : classOf (withNegation B) x = classOf (withNegation B) a := by
        exact (coarse_two_nonzero_class B hr c hc x hx).trans
          (congrArg (coarsenClass B) ha).symm
      rcases (classOf_withNegation_eq_iff B x a).mp heq with hx' | hx'
      · have hxa := hone x (hx'.trans ha)
        simp only [hxa, Finset.mem_insert, true_or, or_true]
      · have hxa : x = -a := by
          simpa only [neg_neg] using congrArg Neg.neg (hone (-x) (hx'.trans ha))
        simp only [hxa, Finset.mem_insert, Finset.mem_singleton, or_true]
  have hcard := Finset.card_le_card hsmall
  have hbound := Finset.card_le_three (a := (0 : G)) (b := a) (c := -a)
  simp only [Finset.card_univ] at hcard
  omega

end Sunlet.OrbitClasses
