def annihilator (i : Fin 56) : Matrix (Fin 7) (Fin 4 × Fin 5) ℚ :=
  fun d ab => rowRead (annihilatorData i) d.val (ab.1.val * 5 + ab.2.val)

def combination (i : Fin 56) : Matrix Direction (Fin 7) ℚ :=
  fun j d => rowRead (combinationData i) (directionEquiv.symm j).val d.val

def contractions (i : Fin 56) : Matrix (Fin 7) Direction ℚ :=
  fun d j => rowRead (contractionsData i) d.val (directionEquiv.symm j).val

def tangent (i : Fin 56) := SparseContactCertificate.tangentMatrix (K := ℚ)
  (permutations i) 0 (firstSupport i : Set (Fin 4)) (secondSupport i : Set (Fin 4))

def hessian (i : Fin 56) := SparseContactCertificate.hessianMatrix (K := ℚ)
  (permutations i) 0 (firstSupport i : Set (Fin 4))

def radialVector (i : Fin 56) := SparseContactCertificate.radialVector (K := ℚ)
  (0 : Fin 5) (firstSupport i : Set (Fin 4))

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem annihilator_check (i : Fin 56) : annihilator i * tangent i = 0 := by
  rw [tangent, SparseContactEntries.tangentMatrix_eq_entries]
  fin_cases i <;> decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem contractions_check (i : Fin 56) : contractions i =
    (fun d j => ∑ ab, annihilator i d ab * hessian i (directionEquiv (testIndex i d)) ab j) := by
  have hc : ∀ (d : Fin 7) (j : Fin 8), contractions i d (directionEquiv j) =
      ∑ ab : Fin 4 × Fin 5, annihilator i d ab *
        SparseContactEntries.hessianEntries (permutations i) 0
          (firstSupport i : Set (Fin 4)) (directionEquiv (testIndex i d)) ab (directionEquiv j) := by
    fin_cases i <;> decide +kernel
  funext d j
  simp only [hessian, SparseContactEntries.hessianMatrix_eq_entries]
  simpa only [Equiv.apply_symm_apply] using hc d (directionEquiv.symm j)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem projection_check (i : Fin 56) : combination i * contractions i =
    ContactCertificate.radialProjection (radialVector i) (directionEquiv (pivotIndex i)) := by
  fin_cases i <;> decide +kernel

/-- Every enumerated reduced square has a fully checked contact certificate. -/
def certificate (i : Fin 56) : ContactCertificate.Certificate (D := Fin 7)
    (tangent i) (hessian i) (radialVector i) (directionEquiv (pivotIndex i)) where
  tests d := directionEquiv (testIndex i d)
  annihilator := annihilator i
  combination := combination i
