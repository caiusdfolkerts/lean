section Source_ExceptionalContactReduction


/-! Complete coordinate reductions for the two exceptional contact
calculations. The order-five enumeration covers every finite loop; the
order-eight calculation applies to every loop explicitly identified with
the elementary abelian cube. -/


namespace Sunlet.LoopData

variable {Ω : Type*} [Fintype Ω] [DecidableEq Ω] (L : LoopData Ω)

abbrev Nonidentity := {x : Ω // x ≠ L.identity}

def nonidentityLabels {n : ℕ} (ev : Fin (n + 1) ≃ Ω) (he : ev 0 = L.identity) :
    Fin n ≃ L.Nonidentity :=
  (finSuccAboveEquiv (0 : Fin (n + 1))).trans
    (Equiv.subtypeEquiv ev (by intro x; rw [← he]; exact not_congr ev.injective.eq_iff.symm))

@[simp] theorem nonidentityLabels_value {n : ℕ}
    (ev : Fin (n + 1) ≃ Ω) (he : ev 0 = L.identity) (a : Fin n) :
    (L.nonidentityLabels ev he a).val = ev a.succ := rfl

theorem nonidentity_derangement (a : L.Nonidentity) (x : Ω) : L.left a x ≠ x := by
  intro h
  apply a.property
  apply (L.column_bijective x).injective
  simpa [L.left_identity] using h

def labelsAtIdentity {n : ℕ} (hcard : Fintype.card Ω = n + 1) : Fin (n + 1) ≃ Ω :=
  let e := Fintype.equivFinOfCardEq hcard
  (Equiv.swap 0 (e L.identity)).trans e.symm

@[simp] theorem labelsAtIdentity_zero {n : ℕ} (hcard : Fintype.card Ω = n + 1) :
    L.labelsAtIdentity hcard 0 = L.identity := by
  simp [labelsAtIdentity]

def conjugateNonidentity {n : ℕ} (ev : Fin (n + 1) ≃ Ω) (he : ev 0 = L.identity)
    (a : Fin n) : Equiv.Perm (Fin (n + 1)) :=
  (ev.trans (L.left (L.nonidentityLabels ev he a))).trans ev.symm

@[simp] theorem conjugateNonidentity_apply {n : ℕ}
    (ev : Fin (n + 1) ≃ Ω) (he : ev 0 = L.identity) (a : Fin n) (x : Fin (n + 1)) :
    ev (L.conjugateNonidentity ev he a x) =
      L.left (L.nonidentityLabels ev he a) (ev x) := by
  simp [conjugateNonidentity]

/-- Every order-five loop is transported to one of the 56 reduced tables,
with explicit color and point bijections and the exact translation identity. -/
theorem exists_five_point_labels (hm : Fintype.card Ω = 5) :
    ∃ (i : Fin 56) (ev : Fin 5 ≃ Ω) (ec : Fin 4 ≃ L.Nonidentity),
      ev 0 = L.identity ∧ ∀ a x,
        ev (FivePointContact.permutations i a x) = L.left (ec a) (ev x) := by
  let ev := L.labelsAtIdentity (n := 4) hm
  have he : ev 0 = L.identity := L.labelsAtIdentity_zero hm
  let ec := L.nonidentityLabels ev he
  let π := L.conjugateNonidentity ev he
  have hfirst : ∀ a, π a 0 = a.succ := by
    intro a
    apply ev.injective
    rw [conjugateNonidentity_apply, he, L.right_identity]
    rfl
  have hder : ∀ a x, π a x ≠ x := by
    intro a x hx
    apply L.nonidentity_derangement (ec a) (ev x)
    have hh := congrArg ev hx
    simpa [π, ec] using hh
  have hcol : FivePointContact.LatinColumns (fun a x => π a x) := by
    intro x a b hab
    apply ec.injective
    apply Subtype.ext
    apply (L.column_bijective (ev x)).injective
    have hh := congrArg ev hab
    simpa [π, ec] using hh
  obtain ⟨i, hi⟩ := FivePointContact.enumeration_complete (fun a x => π a x)
    hfirst (fun a => (π a).bijective) hder hcol
  refine ⟨i, ev, ec, he, ?_⟩
  intro a x
  change ev (FivePointContact.reducedTable i a x) = _
  rw [hi]
  exact L.conjugateNonidentity_apply ev he a x

/-- Any multiplication-preserving cube coordinates give exactly the
single order-eight table used in the rational matrix certificate. -/
theorem exists_eight_point_labels
    (e : Ω ≃ (Fin 3 → ZMod 2)) (he : e L.identity = 0)
    (hmul : ∀ x y, e (L.mul x y) = e x + e y) :
    ∃ (ev : Fin 8 ≃ Ω) (ec : Fin 7 ≃ L.Nonidentity),
      ev 0 = L.identity ∧ ∀ a x,
        ev (EightPointContact.permutations a x) = L.left (ec a) (ev x) := by
  let ev := EightPointContact.cubeEquiv.trans e.symm
  have ho : ev 0 = L.identity := by
    apply e.injective
    simp [ev, EightPointContact.cubeEquiv_zero, he]
  let ec := L.nonidentityLabels ev ho
  refine ⟨ev, ec, ho, ?_⟩
  intro a x
  apply e.injective
  change e (ev (EightPointContact.permutations a x)) = e (L.mul (ec a) (ev x))
  rw [hmul]
  simp only [ev, Equiv.trans_apply, Equiv.apply_symm_apply, ec, nonidentityLabels_value]
  exact EightPointContact.cubeEquiv_translation a x

end Sunlet.LoopData

