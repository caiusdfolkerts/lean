theorem validTables_eq : validTables = List.ofFn reducedTable := by decide +kernel

/-- Completeness of the finite reduction, not just a check of selected examples. -/
theorem enumeration_complete (t : Table)
    (hfirst : ∀ a, t a 0 = a.succ) (hbij : ∀ a, Function.Bijective (t a))
    (hder : ∀ a b, t a b ≠ b) (hcol : LatinColumns t) :
    ∃ i : Fin 56, reducedTable i = t := by
  have h := mem_validTables t hfirst hbij hder hcol
  rw [validTables_eq] at h
  exact List.mem_ofFn.mp h

