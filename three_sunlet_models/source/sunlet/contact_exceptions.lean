private theorem permutation_row_coverage : ∀ (a : Fin 4) (f : Equiv.Perm (Fin 5)),
    f 0 = a.succ → (∀ b, f b ≠ b) → (fun b => f b) ∈ candidateRows a := by
  letI : Fintype (Equiv.Perm (Fin 5)) := fintypePerm
  intro a
  fin_cases a <;> decide

theorem row_coverage (a : Fin 4) (f : Fin 5 → Fin 5)
    (hfirst : f 0 = a.succ) (hbij : Function.Bijective f) (hder : ∀ b, f b ≠ b) :
    f ∈ candidateRows a :=
  permutation_row_coverage a (Equiv.ofBijective f hbij) hfirst hder

def RowsSeparate (f g : Fin 5 → Fin 5) : Prop := ∀ b, f b ≠ g b

instance (f g : Fin 5 → Fin 5) : Decidable (RowsSeparate f g) :=
  inferInstanceAs (Decidable (∀ b, f b ≠ g b))

def allTables : List Table :=
  (candidateRows 0).flatMap fun a =>
  ((candidateRows 1).filter (fun b => decide (RowsSeparate a b))).flatMap fun b =>
  ((candidateRows 2).filter (fun c => decide (RowsSeparate a c ∧ RowsSeparate b c))).flatMap fun c =>
  ((candidateRows 3).filter (fun d => decide (RowsSeparate a d ∧ RowsSeparate b d ∧ RowsSeparate c d))).map
    fun d => ![a, b, c, d]

def LatinColumns (t : Table) : Prop := ∀ b, Function.Injective (fun a => t a b)

instance (t : Table) : Decidable (LatinColumns t) := inferInstanceAs (Decidable (∀ b, Function.Injective (fun a => t a b)))

def validTables : List Table := allTables.filter (fun t => decide (LatinColumns t))

theorem mem_validTables (t : Table)
    (hfirst : ∀ a, t a 0 = a.succ) (hbij : ∀ a, Function.Bijective (t a))
    (hder : ∀ a b, t a b ≠ b) (hcol : LatinColumns t) : t ∈ validTables := by
  have hsep (a b : Fin 4) (hab : a ≠ b) : RowsSeparate (t a) (t b) :=
    fun j he => hab (hcol j he)
  apply List.mem_filter.mpr
  refine ⟨?_, by simpa using hcol⟩
  apply List.mem_flatMap.mpr
  refine ⟨t 0, row_coverage 0 _ (hfirst 0) (hbij 0) (hder 0), ?_⟩
  apply List.mem_flatMap.mpr
  refine ⟨t 1, List.mem_filter.mpr ⟨row_coverage 1 _ (hfirst 1) (hbij 1) (hder 1),
    by simpa using hsep 0 1 (by decide)⟩, ?_⟩
  apply List.mem_flatMap.mpr
  refine ⟨t 2, List.mem_filter.mpr ⟨row_coverage 2 _ (hfirst 2) (hbij 2) (hder 2),
    by simpa using And.intro (hsep 0 2 (by decide)) (hsep 1 2 (by decide))⟩, ?_⟩
  apply List.mem_map.mpr
  refine ⟨t 3, ?_, ?_⟩
  · apply List.mem_filter.mpr
    refine ⟨row_coverage 3 _ (hfirst 3) (hbij 3) (hder 3), ?_⟩
    have hs : RowsSeparate (t 0) (t 3) ∧ RowsSeparate (t 1) (t 3) ∧
        RowsSeparate (t 2) (t 3) :=
      ⟨hsep 0 3 (by decide), hsep 1 3 (by decide), hsep 2 3 (by decide)⟩
    simpa using hs
  · funext a
    fin_cases a <;> rfl

