module

public import sunlet.rational_partials
public import Mathlib.RingTheory.Unramified.Field
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-! Generic finiteness from an injective rational Jacobian.
The proof passes through the universal module of Kähler differentials:
vanishing derivations imply formal unramifiedness, and finite generation of
the rational function field then gives a finite separable extension. -/

@[expose] public section
noncomputable section
open scoped BigOperators

namespace Sunlet.JacobianFinite

/-- A field extension with no nonzero derivations into its own field has
zero Kähler differentials. This is proved using separation by the algebraic
dual, without assuming the conclusion as a Jacobian criterion. -/
theorem formallyUnramified_of_derivations_zero
    (F E : Type*) [Field F] [Field E] [Algebra F E]
    (h : ∀ D : Derivation F E E, D = 0) : Algebra.FormallyUnramified F E := by
  constructor
  apply (Module.subsingleton_dual_iff E).mp
  constructor
  intro φ ψ
  apply (KaehlerDifferential.linearMapEquivDerivation F E).injective
  exact (h _).trans (h _).symm

open RationalPartials

variable {k ι κ : Type*} [Field k] [Fintype ι] [DecidableEq ι]

/-- The literal Jacobian linear map of the coordinate rational functions. -/
def jacobian (q : κ → FunctionField k ι) :
    (ι → FunctionField k ι) →ₗ[FunctionField k ι] (κ → FunctionField k ι) :=
  Matrix.mulVecLin (fun j i => partialDerivative (k := k) i (q j))

@[simp] theorem jacobian_apply (q : κ → FunctionField k ι)
    (v : ι → FunctionField k ι) (j : κ) :
    jacobian q v j = ∑ i, partialDerivative (k := k) i (q j) * v i := rfl

abbrev generatedField (q : κ → FunctionField k ι) : IntermediateField k (FunctionField k ι) :=
  IntermediateField.adjoin k (Set.range q)

lemma coordinate_mem_generatedField (q : κ → FunctionField k ι) (j : κ) :
    q j ∈ generatedField q := IntermediateField.subset_adjoin k (Set.range q) ⟨j, rfl⟩

/-- A full column rank rational Jacobian kills every derivation over the
field generated by the image coordinates. -/
theorem derivations_zero_of_jacobian_injective
    (q : κ → FunctionField k ι) (hinj : Function.Injective (jacobian q)) :
    ∀ D : Derivation (generatedField q) (FunctionField k ι) (FunctionField k ι), D = 0 := by
  intro D
  have hq : ∀ j, D (q j) = 0 := by
    intro j
    exact D.map_algebraMap (⟨q j, coordinate_mem_generatedField q j⟩ : generatedField q)
  have hJ : jacobian q (fun i => D (coordinateVariable i)) = 0 := by
    funext j
    have hc := chain_rule (D.restrictScalars k) (q j)
    simpa only [Derivation.restrictScalars_apply, Algebra.algebraMap_self, RingHom.id_apply,
      mul_comm, hq j, jacobian_apply, Pi.zero_apply] using hc.symm
  have hcoords : (fun i => D (coordinateVariable i)) = 0 :=
    (injective_iff_map_eq_zero (jacobian q)).mp hinj _ hJ
  have hD : D.restrictScalars k = 0 := by
    apply RationalPartials.ext
    intro i
    exact congrFun hcoords i
  apply Derivation.ext
  intro f
  exact congrArg (fun d : Derivation k (FunctionField k ι) (FunctionField k ι) => d f) hD

/-- A rational map with an injective generic Jacobian induces a finite
separable extension of its actual image-coordinate field. -/
theorem finite_separable_of_jacobian_injective
    (q : κ → FunctionField k ι) (hinj : Function.Injective (jacobian q)) :
    Module.Finite (generatedField q) (FunctionField k ι) ∧
      Algebra.IsSeparable (generatedField q) (FunctionField k ι) := by
  letI : Algebra.EssFiniteType (PolynomialRing k ι) (FunctionField k ι) :=
    Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors (PolynomialRing k ι))
  letI : Algebra.EssFiniteType k (FunctionField k ι) :=
    Algebra.EssFiniteType.comp k (PolynomialRing k ι) (FunctionField k ι)
  letI : Algebra.EssFiniteType (generatedField q) (FunctionField k ι) :=
    Algebra.EssFiniteType.of_comp k (generatedField q) (FunctionField k ι)
  letI : Algebra.FormallyUnramified (generatedField q) (FunctionField k ι) :=
    formallyUnramified_of_derivations_zero _ _ (derivations_zero_of_jacobian_injective q hinj)
  exact ⟨Algebra.FormallyUnramified.finite_of_free _ _,
    Algebra.FormallyUnramified.isSeparable _ _⟩

end Sunlet.JacobianFinite
