module

public import sunlet.basic
public import Mathlib.Algebra.MvPolynomial.Funext
public import Mathlib.RingTheory.Nullstellensatz
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# The actual image equations of a polynomial map

The kernel of substitution agrees, over an infinite field, with the ideal of
polynomials vanishing on the full parameter image.  Thus the quotient used for
dimension computations is isomorphic to the subalgebra generated by the literal
coordinate polynomials.
-/

@[expose] public section
noncomputable section

namespace PolynomialImage

variable {K σ ι : Type*} [Field K]

def parameterMap (P : ι → MvPolynomial σ K) (x : σ → K) (i : ι) : K :=
  MvPolynomial.aeval x (P i)

def comorphism (P : ι → MvPolynomial σ K) :
    MvPolynomial ι K →ₐ[K] MvPolynomial σ K :=
  MvPolynomial.aeval P

def definingIdeal (P : ι → MvPolynomial σ K) : Ideal (MvPolynomial ι K) :=
  RingHom.ker (comorphism P)

def imageAlgebra (P : ι → MvPolynomial σ K) : Subalgebra K (MvPolynomial σ K) :=
  (comorphism P).range

def coordinateRing (P : ι → MvPolynomial σ K) :=
  MvPolynomial ι K ⧸ definingIdeal P

def closure (P : ι → MvPolynomial σ K) : Set (ι → K) :=
  MvPolynomial.zeroLocus K (definingIdeal P)

/-- Polynomial substitution commutes with evaluating a parameter point. -/
theorem aeval_comorphism (P : ι → MvPolynomial σ K) (x : σ → K)
    (f : MvPolynomial ι K) :
    MvPolynomial.aeval x (comorphism P f) =
      MvPolynomial.aeval (parameterMap P x) f := by
  have h : (MvPolynomial.aeval x).comp (comorphism P) =
      MvPolynomial.aeval (parameterMap P x) := by
    ext i
    simp [comorphism, parameterMap]
  exact AlgHom.congr_fun h f

/-- Over an infinite field, polynomial identities are exactly the equations
vanishing on the full affine image. -/
theorem definingIdeal_eq_vanishingIdeal [Infinite K] (P : ι → MvPolynomial σ K) :
    definingIdeal P = MvPolynomial.vanishingIdeal K (Set.range (parameterMap P)) := by
  ext f
  change comorphism P f = 0 ↔ _
  rw [MvPolynomial.mem_vanishingIdeal_iff]
  constructor
  · intro hf y hy
    obtain ⟨x, rfl⟩ := hy
    rw [← aeval_comorphism, hf, map_zero]
  · intro hf
    apply MvPolynomial.funext
    intro x
    simpa only [← MvPolynomial.aeval_eq_eval, aeval_comorphism, map_zero] using
      hf (parameterMap P x) ⟨x, rfl⟩

/-- The coordinate ring defined by substitution is the actual image subalgebra. -/
def coordinateRingEquivImage (P : ι → MvPolynomial σ K) :
    (MvPolynomial ι K ⧸ definingIdeal P) ≃ₐ[K] imageAlgebra P :=
  Ideal.quotientKerEquivRange (comorphism P)

/-- Taking the common zero locus of all equations of a set preserves its ideal. -/
theorem vanishingIdeal_closure (S : Set (ι → K)) :
    MvPolynomial.vanishingIdeal K
      (MvPolynomial.zeroLocus K (MvPolynomial.vanishingIdeal K S)) =
        MvPolynomial.vanishingIdeal K S := by
  exact le_antisymm
    (MvPolynomial.vanishingIdeal_anti_mono (MvPolynomial.zeroLocus_vanishingIdeal_le S))
    (MvPolynomial.le_vanishingIdeal_zeroLocus _)

theorem vanishingIdeal_imageClosure [Infinite K] (P : ι → MvPolynomial σ K) :
    MvPolynomial.vanishingIdeal K (closure P) = definingIdeal P := by
  rw [closure, definingIdeal_eq_vanishingIdeal, vanishingIdeal_closure]

end PolynomialImage

namespace Sunlet

variable {K ι Ω : Type*} [Field K]

/-- The record parameterization and its literal polynomial family have equal
full images, including all points with zero parameter coordinates. -/
theorem parameterImage_eq_polynomialImage (π : ι → Equiv.Perm Ω) :
    Set.range (parameterMap (K := K) π) =
      Set.range (PolynomialImage.parameterMap (coordinatePolynomial (K := K) π)) := by
  ext q
  constructor
  · rintro ⟨p, rfl⟩
    refine ⟨p.toCoordinates, ?_⟩
    funext ab
    exact aeval_coordinatePolynomial π p ab
  · rintro ⟨x, rfl⟩
    refine ⟨Parameters.ofCoordinates x, ?_⟩
    funext ab
    exact (aeval_coordinatePolynomial_ofCoordinates π x ab).symm

/-- The algebraic image closure of the literal sunlet coordinate polynomials. -/
def imageClosure (π : ι → Equiv.Perm Ω) : Set (ι × Ω → K) :=
  PolynomialImage.closure (coordinatePolynomial π)

theorem imageClosure_eq_zeroLocus_image [Infinite K] (π : ι → Equiv.Perm Ω) :
    imageClosure (K := K) π =
      MvPolynomial.zeroLocus K
        (MvPolynomial.vanishingIdeal K (Set.range (parameterMap (K := K) π))) := by
  rw [imageClosure, PolynomialImage.closure,
    PolynomialImage.definingIdeal_eq_vanishingIdeal, parameterImage_eq_polynomialImage]

end Sunlet
