module

public import sunlet.punctured_differences
public import Mathlib.Logic.Relation
public import Mathlib.Data.Fintype.Card

/-! Generated orbits of actual permutations, and the full family form of Lemma 2.1. -/

@[expose] public section
noncomputable section
open scoped BigOperators

namespace Sunlet

variable {ι Ω : Type*} [Fintype Ω] [DecidableEq Ω]

def ColorEdge (π : ι → Equiv.Perm Ω) (P : Set ι) (x y : Ω) : Prop :=
  ∃ a ∈ P, π a x = y

def ColorConnected (π : ι → Equiv.Perm Ω) (P : Set ι) (x y : Ω) : Prop :=
  Relation.EqvGen (ColorEdge π P) x y

/-- Transitivity means that the graph generated by the indicated permutation edges
has one orbit. Inverses are included by the equivalence closure. -/
def TransitiveFamily (π : ι → Equiv.Perm Ω) (P : Set ι) : Prop :=
  ∀ x y, ColorConnected π P x y

theorem colorConnected_refl (π : ι → Equiv.Perm Ω) (P : Set ι) (x : Ω) :
    ColorConnected π P x x := Relation.EqvGen.refl x

theorem colorConnected_step (π : ι → Equiv.Perm Ω) (P : Set ι)
    {a : ι} (ha : a ∈ P) (x : Ω) : ColorConnected π P x (π a x) :=
  Relation.EqvGen.rel _ _ ⟨a, ha, rfl⟩

theorem colorConnected_mono {π : ι → Equiv.Perm Ω} {P Q : Set ι}
    (hPQ : P ⊆ Q) {x y : Ω} (h : ColorConnected π P x y) :
    ColorConnected π Q x y := by
  apply Relation.EqvGen.mono (r := ColorEdge π P) (p := ColorEdge π Q) ?_ x y h
  intro a b hab
  obtain ⟨i, hi, he⟩ := hab
  exact ⟨i, hPQ hi, he⟩

theorem transitiveFamily_mono {π : ι → Equiv.Perm Ω} {P Q : Set ι}
    (hPQ : P ⊆ Q) (hP : TransitiveFamily π P) : TransitiveFamily π Q :=
  fun x y => colorConnected_mono hPQ (hP x y)

theorem invariant_on_colorConnected {A : Type*} {π : ι → Equiv.Perm Ω}
    {P : Set ι} {F : Ω → A} (hF : ∀ a ∈ P, ∀ x, F (π a x) = F x)
    {x y : Ω} (h : ColorConnected π P x y) : F x = F y := by
  induction h with
  | rel x y h =>
      obtain ⟨a, ha, rfl⟩ := h
      exact (hF a ha x).symm
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem invariant_constant_of_transitive {A : Type*} {π : ι → Equiv.Perm Ω}
    {P : Set ι} {F : Ω → A} (hP : TransitiveFamily π P)
    (hF : ∀ a ∈ P, ∀ x, F (π a x) = F x) (o x : Ω) : F x = F o :=
  invariant_on_colorConnected hF (hP x o)

namespace PuncturedDifferences

/-- The complete outgoing-hole assertion of Lemma 2.1, for an arbitrary family. -/
theorem family_outgoing {o : Ω} {π : ι → Equiv.Perm Ω} {P : Set ι}
    {F : Ω → ℚ} {c : ι → ℚ}
    (hne : ∀ a ∈ P, π a ≠ 1)
    (htwo : ∃ a ∈ P, ∃ b ∈ P, π a ≠ π b)
    (h : ∀ a ∈ P, Outgoing o (π a) F (c a)) :
    ∀ a ∈ P, c a = 0 ∧ ∀ x, F (π a x) = F x := by
  obtain ⟨a, ha, b, hb, hab⟩ := htwo
  intro d hd
  by_cases hda : π d = π a
  · have hdb : π d ≠ π b := by simpa [hda] using hab
    obtain ⟨hc, _, hi, _⟩ := two_permutations_outgoing
      (h d hd) (h b hb) (hne d hd) (hne b hb) hdb
    exact ⟨hc, hi⟩
  · obtain ⟨hc, _, hi, _⟩ := two_permutations_outgoing
      (h d hd) (h a ha) (hne d hd) (hne a ha) hda
    exact ⟨hc, hi⟩

/-- The complete incoming-hole assertion of Lemma 2.1. -/
theorem family_incoming {o : Ω} {π : ι → Equiv.Perm Ω} {P : Set ι}
    {F : Ω → ℚ} {c : ι → ℚ}
    (hne : ∀ a ∈ P, π a ≠ 1)
    (htwo : ∃ a ∈ P, ∃ b ∈ P, π a ≠ π b)
    (h : ∀ a ∈ P, ∀ x, x ≠ (π a).symm o → F (π a x) - F x = c a) :
    ∀ a ∈ P, c a = 0 ∧ ∀ x, F (π a x) = F x := by
  obtain ⟨a, ha, b, hb, hab⟩ := htwo
  intro d hd
  by_cases hda : π d = π a
  · have hdb : π d ≠ π b := by simpa [hda] using hab
    obtain ⟨hc, _, hi, _⟩ := two_permutations_incoming
      (h d hd) (h b hb) (hne d hd) (hne b hb) hdb
    exact ⟨hc, hi⟩
  · obtain ⟨hc, _, hi, _⟩ := two_permutations_incoming
      (h d hd) (h a ha) (hne d hd) (hne a ha) hda
    exact ⟨hc, hi⟩

theorem constant_of_outgoing_transitive {o : Ω} {π : ι → Equiv.Perm Ω}
    {P : Set ι} {F : Ω → ℚ} {c : ι → ℚ}
    (hne : ∀ a ∈ P, π a ≠ 1)
    (htwo : ∃ a ∈ P, ∃ b ∈ P, π a ≠ π b)
    (hP : TransitiveFamily π P)
    (h : ∀ a ∈ P, Outgoing o (π a) F (c a)) : ∀ x, F x = F o := by
  exact invariant_constant_of_transitive hP (fun a ha => (family_outgoing hne htwo h a ha).2) o

theorem constant_of_incoming_transitive {o : Ω} {π : ι → Equiv.Perm Ω}
    {P : Set ι} {F : Ω → ℚ} {c : ι → ℚ}
    (hne : ∀ a ∈ P, π a ≠ 1)
    (htwo : ∃ a ∈ P, ∃ b ∈ P, π a ≠ π b)
    (hP : TransitiveFamily π P)
    (h : ∀ a ∈ P, ∀ x, x ≠ (π a).symm o → F (π a x) - F x = c a) :
    ∀ x, F x = F o := by
  exact invariant_constant_of_transitive hP (fun a ha => (family_incoming hne htwo h a ha).2) o

end PuncturedDifferences
end Sunlet
