namespace PolynomialImage section set_option Elab.async false open scoped BigOperators variable {k E I J S : Type*} [Field k] [Field E] [Algebra k E]
/-- Membership in a generated field gives a quotient whose denominator is genuinely nonzero, including when the element itself is z... -/
theorem rational_form_of_mem (q : J → E) (x : E) (hx : x ∈ IntermediateField.adjoin k (Set.range q)) : ∃ N D : MvPolynomial J k, MvPolynomial.aeval q D ≠ 0 ∧ x * MvPolynomial.aeval q D = MvPolynomial.aeval q N := by sorry
/-- Concrete rational reconstruction identities in the original model coordinate ring; no generic parameters occur in this structure. -/
structure RationalCoordinateInverse (P : I → MvPolynomial S k) (ρ : J → I) where
  numerator : I → MvPolynomial J k
  denominator : I → MvPolynomial J k
  denominator_not_mem : ∀ i, MvPolynomial.rename ρ (denominator i) ∉ PolynomialImage.definingIdeal P
  relation_mem : ∀ i,
    MvPolynomial.X i * MvPolynomial.rename ρ (denominator i) -
      MvPolynomial.rename ρ (numerator i) ∈ PolynomialImage.definingIdeal P
/-- A faithful realization of the model function field transports exact field-generation equality to rational reconstruction over k... -/
def rationalCoordinateInverseOfFieldEquality (P : I → MvPolynomial S k) (q : I → E) (ρ : J → I) (hkernel : ∀ f : MvPolynomial I k, MvPolynomial.aeval q f=0 ↔ f ∈ PolynomialImage.definingIdeal P) (hfield : IntermediateField.adjoin k (Set.range (q ∘ ρ)) = IntermediateField.adjoin k (Set.range q)) : RationalCoordinateInverse P ρ := by
  have hq (i : I) : q i ∈ IntermediateField.adjoin k (Set.range (q ∘ ρ)) := by
    rw [hfield]
    exact IntermediateField.subset_adjoin k _ ⟨i,rfl⟩
  choose N D hD hND using fun i => rational_form_of_mem (q ∘ ρ) (q i) (hq i)
  refine ⟨N,D,?_,?_⟩
  · intro i hi
    apply hD i
    simpa only [MvPolynomial.aeval_rename] using (hkernel _).mpr hi
  · intro i
    apply (hkernel _).mp
    simp only [map_sub,map_mul,MvPolynomial.aeval_X,MvPolynomial.aeval_rename]
    exact sub_eq_zero.mpr (hND i)
end end PolynomialImage
namespace PolynomialImage.RationalCoordinateInverse section set_option Elab.async false open scoped BigOperators variable {k E I J S : Type*} [Field k] [Field E] [Algebra k E] open scoped IntermediateField.algebraAdjoinAdjoin variable {P : I → MvPolynomial S k} {ρ : J → I} (R : RationalCoordinateInverse P ρ)
/-- The actual rational inverse as a vector of quotients. -/
