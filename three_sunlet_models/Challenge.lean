namespace Sunlet section open scoped BigOperators variable {ι Ω : Type*} [Fintype Ω] [DecidableEq Ω]
/-- Exact source definition of ColorEdge. -/
def ColorEdge (π : ι → Equiv.Perm Ω) (P : Set ι) (x y : Ω) : Prop := ∃ a ∈ P, π a x = y
/-- Exact source definition of ColorConnected. -/
def ColorConnected (π : ι → Equiv.Perm Ω) (P : Set ι) (x y : Ω) : Prop := Relation.EqvGen (ColorEdge π P) x y
/-- Transitivity means that the graph generated by the indicated permutation edges has one orbit. -/
def TransitiveFamily (π : ι → Equiv.Perm Ω) (P : Set ι) : Prop := ∀ x y, ColorConnected π P x y
end end Sunlet
namespace Sunlet section open Finset variable {ι Ω : Type*} [Fintype ι] [Fintype Ω] [DecidableEq ι] [DecidableEq Ω]
/-- The literal normalized Latin property. Every column is a bijection. -/
structure NormalizedLatinSystem (ι Ω : Type*) where
  perm : ι → Equiv.Perm Ω
  identity : ι
  normalized : perm identity = Equiv.refl Ω
  column_bijective : ∀ b, Function.Bijective (fun a => perm a b)
end end Sunlet
namespace Sunlet section 
/-- The five independent families of affine parameter variables. -/
inductive ParamVar (ι Ω : Type*) where
  | s : Ω → Sunlet.ParamVar ι Ω
  | t : Ω → Sunlet.ParamVar ι Ω
  | h : Ω → Sunlet.ParamVar ι Ω
  | u : ι → Sunlet.ParamVar ι Ω
  | v : ι → Sunlet.ParamVar ι Ω
  deriving DecidableEq, Fintype
/-- An arbitrary point of the full parameter space. -/
structure Parameters (K ι Ω : Type*) where
  s : Ω → K
  t : Ω → K
  h : Ω → K
  u : ι → K
  v : ι → K
end end Sunlet
namespace Sunlet.Parameters section variable {K ι Ω : Type*}
/-- Exact source definition of ofCoordinates. -/
def ofCoordinates (x : Sunlet.ParamVar ι Ω → K) : Sunlet.Parameters K ι Ω where
  s b := x (.s b)
  t b := x (.t b)
  h b := x (.h b)
  u a := x (.u a)
  v a := x (.v a)
end end Sunlet.Parameters
namespace Sunlet section variable {K ι Ω : Type*} [CommSemiring K]
/-- The coordinate with color `a` and position `b`. -/
def coordinate (π : ι → Equiv.Perm Ω) (p : Sunlet.Parameters K ι Ω) (a : ι) (b : Ω) : K := p.s b * p.t (π a b) * (p.u a * p.h (π a b) + p.v a * p.h b)
/-- The literal five-family map on the entire affine parameter space. -/
def parameterMap (π : ι → Equiv.Perm Ω) (p : Sunlet.Parameters K ι Ω) (ab : ι × Ω) : K := Sunlet.coordinate π p ab.1 ab.2
/-- The coordinate map as a family of multivariate polynomials. -/
def coordinatePolynomial (π : ι → Equiv.Perm Ω) (ab : ι × Ω) : MvPolynomial (Sunlet.ParamVar ι Ω) K := MvPolynomial.X (.s ab.2) * MvPolynomial.X (.t (π ab.1 ab.2)) * (MvPolynomial.X (.u ab.1) * MvPolynomial.X (.h (π ab.1 ab.2)) + MvPolynomial.X (.v ab.1) * MvPolynomial.X (.h ab.2))
end end Sunlet
namespace PolynomialImage section variable {K σ ι : Type*} [Field K]
/-- Exact source definition of comorphism. -/
def comorphism (P : ι → MvPolynomial σ K) : MvPolynomial ι K →ₐ[K] MvPolynomial σ K := MvPolynomial.aeval P
/-- Exact source definition of definingIdeal. -/
def definingIdeal (P : ι → MvPolynomial σ K) : Ideal (MvPolynomial ι K) := RingHom.ker (comorphism P)
/-- Exact source definition of closure. -/
def closure (P : ι → MvPolynomial σ K) : Set (ι → K) := MvPolynomial.zeroLocus K (PolynomialImage.definingIdeal P)
end end PolynomialImage
namespace Sunlet section variable {K ι Ω : Type*} [Field K]
/-- The algebraic image closure of the literal sunlet coordinate polynomials. -/
def imageClosure (π : ι → Equiv.Perm Ω) : Set (ι × Ω → K) := PolynomialImage.closure (Sunlet.coordinatePolynomial π)
end end Sunlet
namespace Sunlet.Normalization section variable {K ι Ω : Type*} [DecidableEq ι]
/-- Normalized parameters, with both unit families fixed to one at the base. -/
structure Parameters (K ι Ω : Type*) [CommRing K] (e : ι) (o : Ω) where
  z : Ω → K
  k : Ω → Kˣ
  l : Ω → Kˣ
  u : {a : ι // a ≠ e} → K
  v : {a : ι // a ≠ e} → K
  k_base : k o = 1
  l_base : l o = 1
end end Sunlet.Normalization
namespace Sunlet.Normalization section variable {K ι Ω : Type*} [DecidableEq ι] variable [CommRing K] {e : ι} {o : Ω}
/-- The identity-color coordinates are the free diagonal coordinates. -/
def coordinate (π : ι → Equiv.Perm Ω) (p : Sunlet.Normalization.Parameters K ι Ω e o) (a : ι) (b : Ω) : K := if ha : a = e then p.z b else p.z (π a b) * (p.u ⟨a, ha⟩ * (p.k b : K) * ((p.k (π a b))⁻¹ : Kˣ) + p.v ⟨a, ha⟩ * (p.l b : K) * ((p.l (π a b))⁻¹ : Kˣ))
/-- Exact source definition of parameterMap. -/
def parameterMap (π : ι → Equiv.Perm Ω) (p : Sunlet.Normalization.Parameters K ι Ω e o) (ab : ι × Ω) : K := Sunlet.Normalization.coordinate π p ab.1 ab.2
end end Sunlet.Normalization
namespace Sunlet.Normalization section open scoped BigOperators
/-- Exact source definition of Variable. -/
inductive Variable (ι Ω : Type*) (e : ι) (o : Ω) where
  | z : Ω → Sunlet.Normalization.Variable ι Ω e o
  | k : {b : Ω // b ≠ o} → Sunlet.Normalization.Variable ι Ω e o
  | l : {b : Ω // b ≠ o} → Sunlet.Normalization.Variable ι Ω e o
  | u : {a : ι // a ≠ e} → Sunlet.Normalization.Variable ι Ω e o
  | v : {a : ι // a ≠ e} → Sunlet.Normalization.Variable ι Ω e o
  deriving DecidableEq
end end Sunlet.Normalization
namespace Sunlet.Normalization section open scoped BigOperators variable {ι Ω : Type*} [DecidableEq ι] [DecidableEq Ω] [Fintype Ω]
/-- Exact source definition of PolynomialRing. -/
abbrev PolynomialRing (K : Type*) [CommRing K] (e : ι) (o : Ω) := MvPolynomial (Sunlet.Normalization.Variable ι Ω e o) K
/-- Exact source definition of denominator. -/
def denominator (K : Type*) [CommRing K] (e : ι) (o : Ω) : Sunlet.Normalization.PolynomialRing K e o := ∏ b : {b : Ω // b ≠ o}, MvPolynomial.X (.k b) * MvPolynomial.X (.l b)
end end Sunlet.Normalization
namespace Sunlet section variable {G : Type*} [AddCommGroup G]
/-- The actual left and right inverse equations of translation. -/
theorem palomarTranslationLeft (a b : G) : -a + (a + b) = b := by simp [← add_assoc]
theorem palomarTranslationRight (a b : G) : a + (-a + b) = b := by simp [← add_assoc]
/-- Translation by a group element, as the permutation used in the Latin map. -/
def addTranslationPerm (a : G) : Equiv.Perm G where
  toFun b := a + b
  invFun b := -a + b
  left_inv b := palomarTranslationLeft a b
  right_inv b := palomarTranslationRight a b
/-- Exact source definition of addTranslationPerm_apply. -/
@[simp] theorem addTranslationPerm_apply (a b : G) : addTranslationPerm a b = a + b := by sorry
end end Sunlet
namespace Sunlet.GroupCoordinates section variable {K G : Type*} [Field K] [AddCommGroup G]
/-- Exact source definition of Parameters. -/
abbrev Parameters := Fin 6 → G → K
/-- Six independent Fourier edge families, in the order of the manuscript. -/
def coordinate (w : Sunlet.GroupCoordinates.Parameters (K := K) (G := G)) (a b c : G) : K := w 0 a * w 1 b * w 2 c * (w 3 (a + b) * w 4 a + w 3 b * w 5 a)
/-- Exact source definition of parameterMap. -/
def parameterMap (w : Sunlet.GroupCoordinates.Parameters (K := K) (G := G)) (ab : G × G) : K := Sunlet.GroupCoordinates.coordinate w ab.1 ab.2 (-(ab.1 + ab.2))
/-- Exact source definition of FlowIndex. -/
abbrev FlowIndex (G : Type*) [AddCommGroup G] := {abc : G × G × G // abc.1 + abc.2.1 + abc.2.2 = 0}
/-- The literal map with the paper's constraint `a+b+c=0`. -/
def tripleParameterMap (w : Sunlet.GroupCoordinates.Parameters (K := K) (G := G)) (abc : Sunlet.GroupCoordinates.FlowIndex G) : K := Sunlet.GroupCoordinates.coordinate w abc.val.1 abc.val.2.1 abc.val.2.2
/-- Exact source definition of imageClosure. -/
def imageClosure : Set (G × G → K) := MvPolynomial.zeroLocus K (MvPolynomial.vanishingIdeal K (Set.range (Sunlet.GroupCoordinates.parameterMap (K := K) (G := G))))
/-- Exact source definition of tripleImageClosure. -/
def tripleImageClosure : Set (Sunlet.GroupCoordinates.FlowIndex G → K) := MvPolynomial.zeroLocus K (MvPolynomial.vanishingIdeal K (Set.range (Sunlet.GroupCoordinates.tripleParameterMap (K := K) (G := G))))
end end Sunlet.GroupCoordinates
namespace Sunlet section variable {K ι Ω : Type*} [Field K] [Fintype ι] [Fintype Ω] [DecidableEq ι] [DecidableEq Ω]
/-- Exact hypotheses of the two transitive color families in Theorem 2.3. -/
structure TransitiveColorSplit (π : ι → Equiv.Perm Ω) (e : ι) where
  positive : Finset ι
  negative : Finset ι
  disjoint : Disjoint positive negative
  partition : positive ∪ negative = Finset.univ.erase e
  positive_card : 2 ≤ positive.card
  negative_card : 2 ≤ negative.card
  positive_transitive : TransitiveFamily π (positive : Set ι)
  negative_transitive : TransitiveFamily π (negative : Set ι)
/-- Theorem 1.1: every normalized Latin system of every order at least five. -/
theorem paper_theorem_1_1 [IsAlgClosed K] (L : NormalizedLatinSystem ι Ω) (hm : 5 ≤ Fintype.card Ω) : ringKrullDim (MvPolynomial (ι × Ω) K ⧸ MvPolynomial.vanishingIdeal K (Sunlet.imageClosure (K := K) L.perm)) = (5 * Fintype.card Ω - 4 : ℕ) := by sorry
end end Sunlet
namespace Sunlet.GroupCoordinates section variable {K G : Type*} [Field K] [IsAlgClosed K] [AddCommGroup G] [Fintype G]
/-- Group translations form the normalized Latin system in the paper. -/
def translationLatinSystem : NormalizedLatinSystem G G where
  perm := addTranslationPerm
  identity := 0
  normalized := by ext b; simp
  column_bijective b := by
    constructor
    · intro a c h
      exact add_right_cancel h
    · intro y
      refine ⟨y - b, ?_⟩
      simp
/-- The original six-family, constrained-triple-coordinate statement of Theorem 1.1. -/
theorem paper_theorem_1_1_original_coordinates (hm : 5 ≤ Fintype.card G) : ringKrullDim (MvPolynomial (Sunlet.GroupCoordinates.FlowIndex G) K ⧸ MvPolynomial.vanishingIdeal K (Sunlet.GroupCoordinates.tripleImageClosure (K := K) (G := G))) = (5 * Fintype.card G - 4 : ℕ) := by sorry
end end Sunlet.GroupCoordinates
namespace Sunlet section variable {ι Ω : Type*} [Fintype ι] [Fintype Ω] [DecidableEq ι] [DecidableEq Ω]
/-- Theorem 2.3 with distinctness assumed only for the `c` nonidentity derangements, exactly as in the displayed manuscript statement. -/
theorem paper_theorem_2_3_literal {K : Type*} [Field K] [IsAlgClosed K] (c : ℕ) (π : Fin (c + 1) → Equiv.Perm Ω) (he : π 0 = Equiv.refl Ω) (hπ : Function.Injective (fun a : {a : Fin (c + 1) // a ≠ 0} => π a)) (hder : ∀ a, a ≠ 0 → ∀ x, π a x ≠ x) (S : TransitiveColorSplit π 0) : ringKrullDim (MvPolynomial (Fin (c + 1) × Ω) K ⧸ MvPolynomial.vanishingIdeal K (Sunlet.imageClosure (K := K) π)) = (3 * Fintype.card Ω + 2 * c - 2 : ℕ) := by sorry
end end Sunlet
namespace Sunlet.ToricDifferential section variable {F E ι Ω : Type*} [Field F] [Field E] [Algebra F E]
/-- Exact source definition of ratio. -/
def ratio (π : ι → Equiv.Perm Ω) (k : Ω → E) (a : ι) (b : Ω) : E := k b / k (π a b)
/-- Exact source definition of coordinate. -/
def coordinate (π : ι → Equiv.Perm Ω) (U : ι → E) (k : Ω → E) (a : ι) (b : Ω) : E := U a * Sunlet.ToricDifferential.ratio π k a b
end end Sunlet.ToricDifferential
namespace Sunlet.NormalizedVariations section variable {ι Ω K : Type*} [Field K] [DecidableEq Ω]
/-- Exact source definition of Index. -/
abbrev Index (ι Ω : Type*) (o : Ω) := ι ⊕ {x : Ω // x ≠ o}
end end Sunlet.NormalizedVariations
namespace Sunlet.InvariantFunctions section variable {Ω K : Type*} [Fintype Ω] [DecidableEq Ω] [Field K]
/-- Exact source definition of normalized. -/
def normalized (o : Ω) (π : Equiv.Perm Ω) : Submodule K (Ω → K) where
  carrier := {F | F o = 0 ∧ ∀ x, F (π x) = F x}
  zero_mem' := by simp
  add_mem' := by
    intro F G hF hG
    exact ⟨by simp [hF.1, hG.1], fun x => by simp [hF.2 x, hG.2 x]⟩
  smul_mem' := by
    intro a F hF
    exact ⟨by simp [hF.1], fun x => by simp [hF.2 x]⟩
end end Sunlet.InvariantFunctions
namespace Sunlet section 
/-- A loop written as normalized left translations, with both Latin conditions retained explicitly. -/
structure LoopData (Ω : Type*) where
  identity : Ω
  left : Ω → Equiv.Perm Ω
  left_identity : left identity = Equiv.refl Ω
  right_identity : ∀ x, left x identity = x
  column_bijective : ∀ y, Function.Bijective (fun x => left x y)
end end Sunlet
namespace Sunlet.LoopData section variable {Ω : Type*} (L : LoopData Ω)
/-- Exact source definition of mul. -/
def mul (x y : Ω) : Ω := L.left x y
/-- Associativity has its ordinary quantified meaning, not a new typeclass assumption on the loop. -/
def IsAssociative : Prop := ∀ x y z, L.mul (L.mul x y) z = L.mul x (L.mul y z)
/-- Exact source definition of relations. -/
def relations : AddSubgroup (FreeAbelianGroup Ω) := AddSubgroup.closure ({FreeAbelianGroup.of L.identity} ∪ Set.range (fun xy : Ω × Ω => FreeAbelianGroup.of (L.mul xy.1 xy.2) - FreeAbelianGroup.of xy.1 - FreeAbelianGroup.of xy.2))
/-- Exact source definition of AbelianGroup. -/
abbrev AbelianGroup := FreeAbelianGroup Ω ⧸ L.relations
end end Sunlet.LoopData
namespace Sunlet.NormalizedLatinSystem section variable {ι Ω : Type*} (L : NormalizedLatinSystem ι Ω)
/-- Relabeling a normalized Latin system by its column at the chosen point produces the literal loop used in the degree statement. -/
def loopAt (o : Ω) : LoopData Ω := by
  let e : ι ≃ Ω := Equiv.ofBijective (fun a => L.perm a o) (L.column_bijective o)
  have he : e.symm o = L.identity := by
    apply e.injective
    simp only [Equiv.apply_symm_apply]
    change o = L.perm L.identity o
    simp [L.normalized]
  exact
    { identity := o
      left := fun x => L.perm (e.symm x)
      left_identity := by rw [he, L.normalized]
      right_identity := fun x => e.apply_symm_apply x
      column_bijective := fun y => (L.column_bijective y).comp e.symm.bijective }
end end Sunlet.NormalizedLatinSystem
namespace Sunlet.LoopData section variable {Ω M : Type*} (L : LoopData Ω) [CommGroup M]
/-- Exact source definition of characterSubgroup. -/
def characterSubgroup : Subgroup (Ω → M) where
  carrier := {χ | χ L.identity = 1 ∧ ∀ x y, χ (L.mul x y) = χ x * χ y}
  one_mem' := by simp
  mul_mem' := by
    intro χ ψ hχ hψ
    refine ⟨by simp [hχ.1, hψ.1], ?_⟩
    intro x y
    simp only [Pi.mul_apply, hχ.2, hψ.2]
    ac_rfl
  inv_mem' := by
    intro χ hχ
    refine ⟨by simp [hχ.1], ?_⟩
    intro x y
    simp only [Pi.inv_apply, hχ.2, mul_inv_rev]
    exact mul_comm _ _
