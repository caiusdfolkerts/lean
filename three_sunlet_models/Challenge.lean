/-- In this Mathlib version `AddAut G` uses additive notation for composition. -/
def relation (B : AddSubgroup (AddAut G)) (a b : G) : Prop := ∃ φ : B, (φ.val : G → G) a = b
/-- Exact source definition of orbitSetoid. -/
def orbitSetoid (B : AddSubgroup (AddAut G)) : Setoid G where
  r := Sunlet.OrbitClasses.relation B
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      exact ⟨0, rfl⟩
    · rintro a b ⟨φ,hφ⟩
      refine ⟨-φ, ?_⟩
      change φ.val.symm b = a
      rw [← hφ]
      exact φ.val.symm_apply_apply a
    · rintro a b c ⟨φ,hφ⟩ ⟨ψ,hψ⟩
      refine ⟨ψ+φ, ?_⟩
      change ψ.val (φ.val a) = c
      rw [hφ,hψ]
