instance instFintypeClass [Fintype G] (B : AddSubgroup (AddAut G)) : Fintype (Class B) :=
  Fintype.ofFinite _
/-- Exact source definition of classOf. -/
def classOf (B : AddSubgroup (AddAut G)) (a : G) : Class B := Quotient.mk (Sunlet.OrbitClasses.orbitSetoid B) a
end end Sunlet.OrbitClasses
namespace Sunlet.OrbitHeight section open scoped BigOperators attribute [local instance 0] Classical.propDecidable
/-- Order-free statement of the full inverse-stable clause of Theorem 7.1. -/
theorem inverse_stable_original_coordinates_order_free {K G C : Type*} [Field K] [IsAlgClosed K] [AddCommGroup G] [Fintype G] [Fintype C] (P : InverseStablePartition G C) (hm : 5 ≤ Fintype.card G) : ringKrullDim (MvPolynomial (GroupCoordinates.FlowIndex G) K ⧸ MvPolynomial.vanishingIdeal K (ClassGroupCoordinates.tripleImageClosure (K := K) P.classOf)) = (if Fintype.card C = 2 then (5 : ℕ) else if P.IndexTwoException then 10 else 5 * Fintype.card C - 4) := by sorry
end end Sunlet.OrbitHeight
namespace Sunlet.OrbitClasses section attribute [local instance 0] Classical.propDecidable variable {G : Type*} [AddCommGroup G] [Fintype G]
/-- Exact source definition of OrbitIndexTwoException. -/
def OrbitIndexTwoException (B : AddSubgroup (AddAut G)) : Prop := ∃ (H : AddSubgroup G) (d c : Class B), H.index = 2 ∧ d ≠ classOf B 0 ∧ c ≠ classOf B 0 ∧ d ≠ c ∧ (∀ a, classOf B a = d ↔ a ∉ H) ∧ (∀ a, classOf B a = c ↔ a ∈ H ∧ a ≠ 0)
/-- The full Theorem 7.1 in the paper's original six-family flow-indexed coordinates. -/
theorem paper_theorem_7_1 {K : Type*} [Field K] [IsAlgClosed K] (B : AddSubgroup (AddAut G)) (hm : 5 ≤ Fintype.card G) : ringKrullDim (MvPolynomial (GroupCoordinates.FlowIndex G) K ⧸ MvPolynomial.vanishingIdeal K (ClassGroupCoordinates.tripleImageClosure (K := K) (classOf B))) = (if Fintype.card (Class B) = 2 then (5 : ℕ) else if OrbitIndexTwoException B then 10 else 5 * Fintype.card (Class B) - 4) := by sorry
end end Sunlet.OrbitClasses
namespace Sunlet.OrbitClasses section attribute [local instance 0] Classical.propDecidable
/-- Corollary 7.4 in the original six-family flow coordinates. -/
theorem paper_corollary_7_4 {K : Type*} [Field K] [IsAlgClosed K]
    (n : ℕ) (hn : 5 ≤ n) (B : AddSubgroup (AddAut (ZMod n))) :
    letI : NeZero n := Sunlet.palomarNeZeroOfFiveLe n hn
    ringKrullDim (MvPolynomial (GroupCoordinates.FlowIndex (ZMod n)) K ⧸
      MvPolynomial.vanishingIdeal K
        (ClassGroupCoordinates.tripleImageClosure (K := K) (classOf B))) =
      (if n.Prime ∧ B = ⊤ then (5 : ℕ) else 5 * Fintype.card (Class B) - 4) := by sorry
end end Sunlet.OrbitClasses
