/- Literal source: PaperVerification/FermionNewtonHomogeneity.lean -/


/-!
# Homogeneity of the common-numerator Newton columns

Clearing a homogeneous denominator is handled inside the polynomial ring:
the defining multiplication relation shows that the polynomial quotient is
homogeneous of the difference of the actual degrees. This includes zero
numerators and every allowed signed height.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial
open scoped BigOperators Matrix

variable {F : Type*} [Field F] {n : ℕ}

def signedEdges (σ : Fin n → ℤ) (a : ℤ) : Finset (Edge n) :=
  Finset.univ.filter (fun e ↦ σ e.1.1 = a)

def negativeEdgeCount (σ : Fin n → ℤ) : ℕ := (signedEdges σ (-1)).card

def positiveEdgeCount (σ : Fin n → ℤ) : ℕ := (signedEdges σ 1).card

def columnNumeratorDegree (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i : Fin n) : ℕ :=
  negativeEdgeCount σ + δ i + (earlierPositive σ i).card - (earlierNegative σ i).card

theorem starDenominator_homogeneous (k : Fin n) (T : Finset (Fin n)) :
    (starDenominator (F := F) k T).IsHomogeneous T.card := by
  have h := IsHomogeneous.prod T (fun j ↦ (X k - X j : P (F := F) (n := n))) (fun _ ↦ 1)
    (fun j hj ↦ (isHomogeneous_X F k).sub (isHomogeneous_X F j))
  simpa only [starDenominator, Finset.sum_const, nsmul_eq_mul, mul_one, Nat.cast_id] using h

theorem negativeDenominator_homogeneous (σ : Fin n → ℤ) :
    (negativeDenominator (F := F) σ).IsHomogeneous (negativeEdgeCount σ) := by
  have h := IsHomogeneous.prod (signedEdges σ (-1)) (edgeLinear (F := F)) (fun _ ↦ 1)
    (fun e he ↦ (isHomogeneous_X F e.1.1).sub (isHomogeneous_X F e.1.2))
  simpa only [negativeDenominator, negativeEdgeCount, signedEdges,
    Finset.sum_const, nsmul_eq_mul, mul_one, Nat.cast_id] using h

theorem evaluated_columnNumerator_homogeneous
    (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k : Fin n) :
    ((columnNumerator (F := F) δ σ i).eval (X k)).IsHomogeneous
      (δ i + (earlierPositive σ i).card) := by
  rw [columnNumerator, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_prod]
  simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
  exact (isHomogeneous_X_pow k (δ i)).mul (starDenominator_homogeneous k _)

theorem clearedFractionNumerator_homogeneous
    (Q N D : P (F := F) (n := n)) (q r d : ℕ) (hdiv : D ∣ Q)
    (hQ : Q.IsHomogeneous q) (hN : N.IsHomogeneous r) (hD : D.IsHomogeneous d)
    (hQ0 : Q ≠ 0) :
    (clearedFractionNumerator Q N D hdiv).IsHomogeneous (q + r - d) := by
  let A := clearedFractionNumerator Q N D hdiv
  have he : D * A = Q * N := clearedFractionNumerator_relation Q N D hdiv
  have hD0 : D ≠ 0 := fun hz ↦ hQ0 (by obtain ⟨a,ha⟩ := hdiv; simpa only [hz, zero_mul] using ha)
  by_cases hN0 : N = 0
  · have hA0 : A = 0 := by
      rw [hN0, mul_zero] at he
      exact (mul_eq_zero.mp he).resolve_left hD0
    rw [show clearedFractionNumerator Q N D hdiv = 0 from hA0]
    exact isHomogeneous_zero (Fin n) F _
  · have hprod : (D * A).IsHomogeneous (q + r) := he.symm ▸ hQ.mul hN
    have hprod0 : D * A ≠ 0 := he.symm ▸ mul_ne_zero hQ0 hN0
    have hA := hprod.of_mul_right hprod0
    have hA0 : A ≠ 0 := right_ne_zero_of_mul hprod0
    have hdeg := hprod.totalDegree hprod0
    rw [totalDegree_mul_of_isDomain hD0 hA0, hD.totalDegree hD0] at hdeg
    have hdegree : A.totalDegree = q + r - d := by omega
    simpa only [A, hdegree] using hA

theorem activeNumerator_homogeneous
    (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k : Fin n)
    (hk : k ∈ activeInterval δ i) :
    (activeNumerator (F := F) δ σ i k hk).IsHomogeneous (columnNumeratorDegree δ σ i) := by
  have h := clearedFractionNumerator_homogeneous (negativeDenominator (F := F) σ)
    ((columnNumerator δ σ i).eval (X k)) (starDenominator k (earlierNegative σ i))
    (negativeEdgeCount σ) (δ i + (earlierPositive σ i).card) (earlierNegative σ i).card
    (active_denominator_dvd δ σ i k hk) (negativeDenominator_homogeneous σ)
    (evaluated_columnNumerator_homogeneous δ σ i k) (starDenominator_homogeneous k _)
    (negativeDenominator_ne_zero σ)
  simpa only [activeNumerator, columnNumeratorDegree, Nat.add_assoc] using h

theorem residueNumerator_homogeneous
    (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k l : Fin n)
    (hk : k ∈ earlierNegative σ i) (hl : l ∈ activeInterval δ i) :
    (residueNumerator (F := F) δ σ i k l hk hl).IsHomogeneous
      (columnNumeratorDegree δ σ i) := by
  have hD : (starDenominator (F := F) k ((earlierNegative σ i).erase k) *
      (X k - X l)).IsHomogeneous (earlierNegative σ i).card := by
    have h := (starDenominator_homogeneous (F := F) k ((earlierNegative σ i).erase k)).mul
      ((isHomogeneous_X F k).sub (isHomogeneous_X F l))
    have he : ((earlierNegative σ i).erase k).card + 1 = (earlierNegative σ i).card := by
      rw [Finset.card_erase_of_mem hk]
      have hc := Finset.card_pos.mpr ⟨k,hk⟩
      omega
    simpa only [he] using h
  have h := clearedFractionNumerator_homogeneous (negativeDenominator (F := F) σ)
    ((columnNumerator δ σ i).eval (X k))
    (starDenominator k ((earlierNegative σ i).erase k) * (X k - X l))
    (negativeEdgeCount σ) (δ i + (earlierPositive σ i).card) (earlierNegative σ i).card
    (residue_denominator_dvd δ σ i k l hk hl) (negativeDenominator_homogeneous σ)
    (evaluated_columnNumerator_homogeneous δ σ i k) hD (negativeDenominator_ne_zero σ)
  simpa only [residueNumerator, columnNumeratorDegree, Nat.add_assoc] using h

theorem columnCommonNumerator_homogeneous
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) :
    (columnCommonNumerator β δ σ hc i k).IsHomogeneous (columnNumeratorDegree δ σ i) := by
  by_cases ha : k ∈ activeInterval δ i
  · rw [columnCommonNumerator_eq_active β δ σ hc i k ha]
    exact activeNumerator_homogeneous δ σ i k ha
  · by_cases hn : k ∈ earlierNegative σ i
    · rw [columnCommonNumerator_eq_residue_sum β δ σ hc i k hn]
      apply IsHomogeneous.sum
      intro l hl
      exact (residueNumerator_homogeneous δ σ i k l.val hn l.property).C_mul _
    · rw [columnCommonNumerator_eq_zero_of_outside β δ σ hc i k ha hn]
      exact isHomogeneous_zero (Fin n) F _

theorem commonNumeratorMatrix_det_homogeneous
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ) :
    (commonNumeratorMatrix β δ σ hc).det.IsHomogeneous (∑ i, columnNumeratorDegree δ σ i) := by
  rw [Matrix.det_apply']
  apply IsHomogeneous.sum
  intro π hπ
  have h := IsHomogeneous.prod Finset.univ _ (columnNumeratorDegree δ σ)
    (fun i hi ↦ columnCommonNumerator_homogeneous β δ σ hc i (π i))
  simpa only [map_intCast, commonNumeratorMatrix] using h.C_mul (((Equiv.Perm.sign π : ℤ) : F))

end PaperVerification.Fermion.Newton
end
end
end BatchFile_62

section BatchFile_63
/- Literal source: PaperVerification/FermionNewtonDegreeCount.lean -/


/-!
# The exact degree count in the Newton determinant

Counting each signed edge by its later endpoint identifies the sum of column
degrees with the degree of the full local determinant divisor. Together with
nonvanishing and local divisibility, this forces a nonzero scalar quotient.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial
open scoped BigOperators Matrix

variable {F : Type*} [Field F] {n : ℕ}

def edgeEndEquiv (σ : Fin n → ℤ) (a : ℤ) :
    (Σ i : Fin n, {j : Fin n // j < i ∧ σ j = a}) ≃ {e : Edge n // σ e.1.1 = a} where
  toFun x := ⟨⟨(x.2.val,x.1),x.2.property.1⟩,x.2.property.2⟩
  invFun e := ⟨e.val.val.2,⟨e.val.val.1,e.val.property,e.property⟩⟩
  left_inv x := by cases x; rfl
  right_inv e := by cases e; rfl

theorem sum_earlier_sign_card (σ : Fin n → ℤ) (a : ℤ) :
    (∑ i : Fin n, (Finset.univ.filter (fun j ↦ j < i ∧ σ j = a)).card) =
      (signedEdges σ a).card := by
  have h := Fintype.card_congr (edgeEndEquiv σ a)
  simpa only [Fintype.card_sigma, Fintype.card_subtype, signedEdges] using h

theorem sum_earlierPositive_card (σ : Fin n → ℤ) :
    (∑ i, (earlierPositive σ i).card) = positiveEdgeCount σ :=
  sum_earlier_sign_card σ 1

theorem sum_earlierNegative_card (σ : Fin n → ℤ) :
    (∑ i, (earlierNegative σ i).card) = negativeEdgeCount σ :=
  sum_earlier_sign_card σ (-1)

theorem earlierNegative_card_le (σ : Fin n → ℤ) (i : Fin n) :
    (earlierNegative σ i).card ≤ negativeEdgeCount σ := by
  rw [← sum_earlierNegative_card]
  exact Finset.single_le_sum (fun j hj ↦ Nat.zero_le (earlierNegative σ j).card)
    (Finset.mem_univ i)

def determinantDegree (δ : Fin n → ℕ) (σ : Fin n → ℤ) : ℕ :=
  (∑ i, δ i) + positiveEdgeCount σ + (n - 1) * negativeEdgeCount σ

theorem sum_numeratorMultiplicity (δ : Fin n → ℕ) (σ : Fin n → ℤ) :
    (∑ h : Hyperplane n, numeratorMultiplicity δ σ h) = determinantDegree δ σ := by
  rw [Fintype.sum_sum_type]
  have hterm (e : Edge n) : numeratorMultiplicity δ σ (.inr e) =
      (if σ e.1.1 = 1 then 1 else 0) + (if σ e.1.1 = -1 then n - 1 else 0) := by
    by_cases hp : σ e.1.1 = 1
    · simp only [numeratorMultiplicity, if_pos hp, if_neg (by omega : σ e.1.1 ≠ -1), add_zero]
    · by_cases hn : σ e.1.1 = -1 <;> simp [numeratorMultiplicity, hp, hn]
  simp_rw [hterm]
  rw [Finset.sum_add_distrib]
  have hp : (∑ e : Edge n, if σ e.1.1 = 1 then 1 else 0) = positiveEdgeCount σ := by
    simp only [positiveEdgeCount, signedEdges, ← Finset.sum_filter,
      Finset.sum_const, nsmul_eq_mul, Nat.cast_id, mul_one]
  have hn : (∑ e : Edge n, if σ e.1.1 = -1 then n - 1 else 0) =
      (n - 1) * negativeEdgeCount σ := by
    simp only [negativeEdgeCount, signedEdges, ← Finset.sum_filter,
      Finset.sum_const, nsmul_eq_mul, Nat.cast_id]
    exact mul_comm _ _
  rw [hp,hn]
  simp only [numeratorMultiplicity, determinantDegree, Nat.add_assoc]

theorem sum_columnNumeratorDegree (δ : Fin n → ℕ) (σ : Fin n → ℤ) :
    (∑ i, columnNumeratorDegree δ σ i) = determinantDegree δ σ := by
  have hi (i : Fin n) : columnNumeratorDegree δ σ i + (earlierNegative σ i).card =
      negativeEdgeCount σ + δ i + (earlierPositive σ i).card := by
    unfold columnNumeratorDegree
    apply Nat.sub_add_cancel
    exact (earlierNegative_card_le σ i).trans (by omega)
  have hsum := Finset.sum_congr (s₁ := Finset.univ) (s₂ := Finset.univ) rfl (fun i hi' ↦ hi i)
  simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul, Nat.cast_id,
    sum_earlierNegative_card, sum_earlierPositive_card] at hsum
  by_cases hn : n = 0
  · subst n
    simp [determinantDegree, positiveEdgeCount, negativeEdgeCount, signedEdges]
  · have hmul : n * negativeEdgeCount σ = (n - 1) * negativeEdgeCount σ + negativeEdgeCount σ := by
      have he : n = (n - 1) + 1 := by omega
      calc
        n * negativeEdgeCount σ = ((n - 1) + 1) * negativeEdgeCount σ := congrArg (· * _) he
        _ = _ := by rw [Nat.add_mul, one_mul]
    rw [hmul] at hsum
    unfold determinantDegree
    omega

theorem numeratorDetFactor_homogeneous (δ : Fin n → ℕ) (σ : Fin n → ℤ) :
    (numeratorDetFactor (F := F) δ σ).IsHomogeneous (determinantDegree δ σ) := by
  rw [← sum_numeratorMultiplicity δ σ]
  apply IsHomogeneous.prod
  intro h hh
  cases h with
  | inl i => exact isHomogeneous_X_pow i (δ i)
  | inr e =>
      have he := ((isHomogeneous_X F e.1.1).sub (isHomogeneous_X F e.1.2)).pow
        (numeratorMultiplicity δ σ (.inr e))
      simpa only [hyperplaneLinear,edgeLinear,one_mul] using he

theorem commonNumeratorMatrix_det_homogeneous_degree
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ) :
    (commonNumeratorMatrix β δ σ hc).det.IsHomogeneous (determinantDegree δ σ) := by
  rw [← sum_columnNumeratorDegree δ σ]
  exact commonNumeratorMatrix_det_homogeneous β δ σ hc

/-- Local divisibility, the exact degree count, and the complete determinant
induction yield a nonzero scalar factor for the literal matrix. -/
theorem exists_commonNumerator_determinant_scalar
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    ∃ c : F, c ≠ 0 ∧ (commonNumeratorMatrix β δ σ hc).det = C c * numeratorDetFactor δ σ := by
  have hβi (i : Fin n) : β i ≠ 0 := by
    simpa only [Finset.sum_singleton] using (hβ {i} (Finset.singleton_nonempty i)).ne_zero
  obtain ⟨u,hu⟩ := numeratorDetFactor_dvd_commonNumeratorMatrix β δ σ hc hβi
  have hdet := commonNumeratorMatrix_det_ne_zero β δ σ hc hσ hβ
  have hD := numeratorDetFactor_ne_zero (F := F) δ σ
  have hu0 : u ≠ 0 := by
    intro hz
    apply hdet
    rw [hu,hz,mul_zero]
  have hdegree := congrArg MvPolynomial.totalDegree hu
  rw [(commonNumeratorMatrix_det_homogeneous_degree β δ σ hc).totalDegree hdet,
    totalDegree_mul_of_isDomain hD hu0,
    (numeratorDetFactor_homogeneous δ σ).totalDegree hD] at hdegree
  have huzero : u.totalDegree = 0 := by omega
  have huC := totalDegree_eq_zero_iff_eq_C.mp huzero
  refine ⟨u.coeff 0, ?_, ?_⟩
  · intro hzero
    apply hu0
    rw [huC,hzero,map_zero]
  · rw [hu]
    exact (congrArg (fun x => numeratorDetFactor δ σ * x) huC).trans (mul_comm _ _)

end PaperVerification.Fermion.Newton
end
end
end BatchFile_63

section BatchFile_64
/- Literal source: PaperVerification/FermionNewtonBasis.lean -/


/-!
# The full rational Newton basis and its actual contraction ideal

All determinant hypotheses are discharged here for the literal columns.
The rational module is the image of the paper's common-numerator module under
division by its nonzero common denominator. The basis vectors are identified
coordinate by coordinate with equation (7).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial Module
open scoped BigOperators Matrix

variable {F : Type*} [Field F] {n : ℕ}

theorem singleton_weight_ne_zero
    (β : Fin n → F)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) (i : Fin n) : β i ≠ 0 := by
  simpa only [Finset.sum_singleton] using (hβ {i} (Finset.singleton_nonempty i)).ne_zero

def newtonNumeratorBasis
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    Module.Basis (Fin n) (P (F := F) (n := n)) (numeratorModule β δ σ) := by
  let c := Classical.choose (exists_commonNumerator_determinant_scalar β δ σ hc hσ hβ)
  have hcdata := Classical.choose_spec (exists_commonNumerator_determinant_scalar β δ σ hc hσ hβ)
  exact numeratorBasisOfDeterminant β δ σ (commonNumeratorMatrix β δ σ hc)
    (singleton_weight_ne_zero β hβ)
    (commonNumeratorMatrix_column_mem β δ σ hc (singleton_weight_ne_zero β hβ))
    (C c) ((isUnit_iff_ne_zero.mpr hcdata.1).map MvPolynomial.C) hcdata.2

@[simp] theorem newtonNumeratorBasis_apply
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) (i : Fin n) :
    ((newtonNumeratorBasis β δ σ hc hσ hβ i : numeratorModule β δ σ) : Fin n → (P (F := F) (n := n))) =
      columnCommonNumerator β δ σ hc i := by
  simp only [newtonNumeratorBasis, numeratorBasisOfDeterminant_apply, commonNumeratorMatrix]

def divideByNegativeDenominator (σ : Fin n → ℤ) :
    (Fin n → P (F := F) (n := n)) →ₗ[P (F := F) (n := n)] (Fin n → RationalFunctions (F := F) (n := n)) where
  toFun a k := algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (a k) /
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ)
  map_add' a b := by
    funext k
    simp only [Pi.add_apply, map_add, add_div]
  map_smul' p a := by
    funext k
    simp only [Pi.smul_apply, smul_eq_mul, map_mul, Algebra.smul_def, RingHom.id_apply]
    ring

theorem divideByNegativeDenominator_injective (σ : Fin n → ℤ) :
    Function.Injective (divideByNegativeDenominator (F := F) σ) := by
  have hq : algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) ≠ 0 := by
    intro hz
    exact negativeDenominator_ne_zero σ
      (IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (by simpa using hz))
  intro a b hab
  funext k
  apply IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n))
  apply mul_right_cancel₀ (inv_ne_zero hq)
  simpa only [divideByNegativeDenominator, LinearMap.coe_mk, AddHom.coe_mk,
    div_eq_mul_inv] using congrFun hab k

/-- The exact rational module of Section 2.1, realized inside the actual
fraction field of the original polynomial ring. -/
def rationalNewtonModule (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) :
    Submodule (P (F := F) (n := n)) (Fin n → RationalFunctions (F := F) (n := n)) :=
  (numeratorModule β δ σ).map (divideByNegativeDenominator σ)

def newtonFieldBasis
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    Module.Basis (Fin n) (P (F := F) (n := n)) (rationalNewtonModule β δ σ) :=
  (newtonNumeratorBasis β δ σ hc hσ hβ).map
    (Submodule.equivMapOfInjective (divideByNegativeDenominator σ)
      (divideByNegativeDenominator_injective σ) (numeratorModule β δ σ))

/-- The constructed basis is exactly the paper's displayed rational columns. -/
@[simp] theorem newtonFieldBasis_apply
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) (i k : Fin n) :
    ((newtonFieldBasis β δ σ hc hσ hβ i : rationalNewtonModule β δ σ) :
      Fin n → RationalFunctions (F := F) (n := n)) k = newtonColumn β δ σ i k := by
  change (((newtonNumeratorBasis β δ σ hc hσ hβ).map
    (Submodule.equivMapOfInjective (divideByNegativeDenominator σ)
      (divideByNegativeDenominator_injective σ) (numeratorModule β δ σ))) i :
      Fin n → RationalFunctions (F := F) (n := n)) k = _
  rw [Module.Basis.map_apply, Submodule.coe_equivMapOfInjective_apply,
    newtonNumeratorBasis_apply]
  change algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (columnCommonNumerator β δ σ hc i k) /
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) = _
  rw [map_columnCommonNumerator]
  have hq : algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) ≠ 0 := by
    intro hz
    exact negativeDenominator_ne_zero σ
      (IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (by simpa using hz))
  exact mul_div_cancel_left₀ _ hq

def weightedNumeratorMap (β : Fin n → F) : (Fin n → P (F := F) (n := n)) →ₗ[P (F := F) (n := n)] (P (F := F) (n := n)) :=
  ∑ k, (C (β k) : P (F := F) (n := n)) •
    (LinearMap.proj k : (Fin n → P (F := F) (n := n)) →ₗ[P (F := F) (n := n)] P (F := F) (n := n))

@[simp] theorem weightedNumeratorMap_apply (β : Fin n → F) (a : Fin n → P (F := F) (n := n)) :
    weightedNumeratorMap β a = ∑ k, C (β k) * a k := by
  simp only [weightedNumeratorMap, LinearMap.sum_apply, LinearMap.smul_apply,
    LinearMap.proj_apply, smul_eq_mul]

/-- The ideal generated by the displayed polynomial contractions equals the
contraction ideal of the full module. The reverse inclusion is proved by the
actual Newton basis expansion, not assumed from a determinant calculation. -/
theorem span_columnContractions_eq_contractionIdeal
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    Ideal.span (Set.range (columnContraction β δ σ)) = contractionIdeal β δ σ := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    exact columnContraction_mem_contractionIdeal β δ σ hc (singleton_weight_ne_zero β hβ) i
  · rintro p ⟨a,ha,hap⟩
    let B := newtonNumeratorBasis β δ σ hc hσ hβ
    let v : numeratorModule β δ σ := ⟨a,ha⟩
