/-- For a prime `p` of a commutative ring `R`, `ht p + dim (R ⧸ p) ≤ dim R`. -/
theorem height_add_ringKrullDim_quotient_le (p : Ideal R) [p.IsPrime] :
    p.height + ringKrullDim (R ⧸ p) ≤ ringKrullDim R := by
  let P : PrimeSpectrum R := ⟨p, ‹_›⟩
