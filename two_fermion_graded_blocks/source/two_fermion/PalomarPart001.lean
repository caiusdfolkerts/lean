      change weightedNumeratorMap β (B i : Fin n → (P (F := F) (n := n))) = _
      rw [newtonNumeratorBasis_apply, weightedNumeratorMap_apply]
      exact columnCommonNumerator_weighted_sum β δ σ hc (singleton_weight_ne_zero β hβ) i
