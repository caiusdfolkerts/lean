module
public import Mathlib

/-!
# Recognition of polymatroidal ideals

Caius Folkerts, *Characterizations of polymatroidal ideals*, Theorem 1.1(A)
for literal arbitrary monomial ideals including zero, and Theorem 1.1(B) in
the stronger Corollary 3.10 form for arbitrary minimal generator antichains.
Linear resolutions are actual exact complexes of finite free polynomial
modules with homogeneous differential entries and augmentation, rather than
a surrogate Betti-vanishing predicate. Quotients are actual colon ideals.
Every custom mathematical definition used by these declarations is below.
-/

@[expose] public noncomputable section
open scoped BigOperators
open Filter Asymptotics
namespace CommAlg.Polymatroid
open Classical Finset
section ExponentSource
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Natural exponent vectors of monomials. -/
abbrev Exponent (V : Type*) := V →₀ ℕ
/-- A finite monomial exponent family. -/
abbrev Family (V : Type*) := Finset (Exponent V)

/-- Every displayed monomial has degree d. -/
def Equigenerated (B : Family V) (d : ℕ) : Prop := ∀ a ∈ B, a.degree = d

/-- No distinct displayed monomial divides another. -/
def Antichain (B : Family V) : Prop := ∀ a ∈ B, ∀ b ∈ B, a ≤ b → a = b
/-- Remove one unit from coordinate i and add one at coordinate j. -/
def exchange (a : Exponent V) (i j : V) : Exponent V :=
  a - Finsupp.single i 1 + Finsupp.single j 1

/-- The ordinary polymatroid exchange axiom. -/
def ExchangeAxiom (B : Family V) : Prop :=
  ∀ a ∈ B, ∀ b ∈ B, ∀ i, b i < a i →
    ∃ j, a j < b j ∧ exchange a i j ∈ B

/-- Equigeneration together with the ordinary exchange axiom. -/
def IsPolymatroidal (B : Family V) : Prop :=
  (∃ d, Equigenerated B d) ∧ ExchangeAxiom B

/-- The genuine polynomial ideal generated by the displayed monomials. -/
def monomialIdeal (k : Type*) [CommSemiring k] (B : Family V) :
    Ideal (MvPolynomial V k) :=
  Ideal.span ((fun a : Exponent V => MvPolynomial.monomial a (1 : k)) '' (B : Set (Exponent V)))
end ExponentSource
section Ideals
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [CommRing k] [Nontrivial k]
/-- A polynomial ideal admitting a finite equigenerated exchange family. -/
def IsPolymatroidalIdeal (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ B : Family V, IsPolymatroidal B ∧ I = monomialIdeal k B
end Ideals
end CommAlg.Polymatroid
namespace CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [LinearOrder V]
variable {k : Type*} [CommSemiring k]
/-- Ideal generated by the variables indexed by the finite set C. -/
def variableIdeal (C : Finset V) : Ideal (MvPolynomial V k) :=
  Ideal.span (MvPolynomial.X '' (C : Set V))
end CommAlg.Polymatroid
namespace Characterizations
open Classical Finset CommAlg CommAlg.Polymatroid MvPolynomial
section Orders
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- A comparison relation on monomial exponent vectors. -/
abbrev GeneratorOrder (V : Type*) := Exponent V → Exponent V → Prop
/-- Generators preceding the specified exponent under the chosen comparison. -/
def preceding (B : Family V) (r : GeneratorOrder V) (b : Exponent V) : Family V :=
  B.filter (fun a => r a b)

/-- Each predecessor colon is generated by some set of variables. -/
def HasLinearQuotients (k : Type*) [CommSemiring k]
    (B : Family V) (r : GeneratorOrder V) : Prop :=
  ∀ b ∈ B, ∃ D : Finset V,
    (monomialIdeal k (preceding B r b)).colon {MvPolynomial.monomial b (1 : k)} =
      variableIdeal (k := k) D
/-- A variable ordering is a permutation of the finite variable set. -/
abbrev VariableOrder (V : Type*) [Fintype V] := V ≃ Fin (Fintype.card V)
/-- Decreasing pure reverse lexicographic comparison in that ordering. -/
def variableRevlex (o : VariableOrder V) (a b : Exponent V) : Prop :=
  ∃ i, a i < b i ∧ ∀ j, o i < o j → a j = b j
/-- Corollary 3.10 strengthens Theorem 1.1(B) by dropping equigeneration. -/
theorem polymatroidal_iff_universal_pure_revlex {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} (hB : Antichain B) :
    IsPolymatroidal B ↔ ∀ o : VariableOrder V, HasLinearQuotients k B (variableRevlex o) := by sorry
end Orders
end Characterizations
section HomogeneousFreeSource
local instance (priority := 2000) classicalBasisDecidableEqHomogeneousFree (α : Type*) [Fintype α] : DecidableEq α := Classical.decEq α
namespace Characterizations.Resolution
universe u v w
variable {V k : Type u} {J : Type v} {L : Type w} [CommRing k] [Fintype J] [Fintype L]
/-- The actual multivariate polynomial coefficient ring. -/
abbrev Polynomial := MvPolynomial V k
/-- A finite free module with its displayed coordinate basis. -/
abbrev Free (J : Type v) := J → Polynomial (V := V) (k := k)
/-- All entries of the matrix of the actual polynomial-linear map have degree `r`. -/
def IsHomogeneousMap (f : Free (V := V) (k := k) J →ₗ[Polynomial (V := V) (k := k)]
    Free (V := V) (k := k) L) (r : ℕ) : Prop :=
  ∀ a b, (f (Pi.single b 1) a).IsHomogeneous r
end Characterizations.Resolution
end HomogeneousFreeSource
section ResolutionBasicSource
local instance (priority := 2000) classicalBasisDecidableEqBasic (α : Type*) [Fintype α] : DecidableEq α := Classical.decEq α
namespace Characterizations
open Resolution
section Resolutions
universe u
variable {V k : Type u} [CommRing k]
/-- An exact augmented complex of finite free polynomial modules, with linear
matrix entries and degree-d homogeneous augmentation. -/
structure LinearResolution (I : Ideal (MvPolynomial V k)) (d : ℕ) where
  Index : ℕ → Type
  finite : ∀ n, Fintype (Index n)
  differential : ∀ n, (Index (n + 1) → MvPolynomial V k) →ₗ[MvPolynomial V k]
    (Index n → MvPolynomial V k)
  augmentation : (Index 0 → MvPolynomial V k) →ₗ[MvPolynomial V k] MvPolynomial V k
  augmentation_range : LinearMap.range augmentation = I
  exact_zero : LinearMap.range (differential 0) = LinearMap.ker augmentation
  exact_succ : ∀ n, LinearMap.range (differential (n + 1)) = LinearMap.ker (differential n)
  linear : ∀ n, letI := finite n; letI := finite (n + 1)
    IsHomogeneousMap (differential n) 1
  augmentation_homogeneous : ∀ b, (augmentation (Pi.single b 1)).IsHomogeneous d

attribute [instance] LinearResolution.finite

/-- Existence of an exact finite-free resolution with shifts `d + i`. -/
def HasLinearResolution (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ d, Nonempty (LinearResolution I d)
end Resolutions
end Characterizations
end ResolutionBasicSource
