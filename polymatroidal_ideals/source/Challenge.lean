section LocalDefs
variable {V : Type*} [Fintype V] [DecidableEq V]
variable (k : Type*) [CommSemiring k]
/-- Substitution of one for each variable outside U. -/
def localizationMap (U : Finset V) : MvPolynomial V k →ₐ[k] MvPolynomial U k :=
  MvPolynomial.aeval (fun i => if hi : i ∈ U then MvPolynomial.X ⟨i, hi⟩ else 1)
/-- The ordinary image ideal under that monomial localization. -/
def monomialLocalization (I : Ideal (MvPolynomial V k)) (U : Finset V) :
    Ideal (MvPolynomial U k) := Ideal.map (localizationMap k U).toRingHom I
end LocalDefs
section Localization
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]
/-- The ordinary meaning of a monomial ideal, permitting an arbitrary exponent set. -/
def IsMonomialIdeal (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ A : Set (Exponent V), I = Ideal.span ((fun a => monomial a (1 : k)) '' A)
/-- Theorem 1.1(A), including zero and the unlocalized ideal. -/
theorem monomialIdeal_polymatroidal_iff_local_linear {I : Ideal (MvPolynomial V k)}
    (hI : IsMonomialIdeal I) :
    IsPolymatroidalIdeal I ↔
      ∀ U : Finset V, HasLinearResolution (monomialLocalization k I U) := by sorry
end Localization
section FieldIndependence
universe u
variable {V k : Type u} [Fintype V] [DecidableEq V] [Field k]
/-- Corollary 2.10: the local linear-resolution criterion is field independent. -/
theorem local_linearResolutions_field_independent {k' : Type u} [Field k']
    {B : Family V} (hB : B.Nonempty) (hanti : Antichain B) :
    (∀ U : Finset V, HasLinearResolution (monomialLocalization k (monomialIdeal k B) U)) ↔
    (∀ U : Finset V, HasLinearResolution (monomialLocalization k' (monomialIdeal k' B) U)) := by sorry
end FieldIndependence
end Characterizations
namespace CommAlg
variable {R : Type*} [CommRing R]
/-- The standard monic-equation definition of integrality over an ideal. -/
def IntegralOverIdeal (I : Ideal R) (x : R) : Prop :=
  ∃ n : ℕ, 0 < n ∧ ∃ c : ℕ → R,
    (∀ i < n, c i ∈ I ^ (n - i)) ∧ x ^ n + ∑ i ∈ Finset.range n, c i * x ^ i = 0
/-- Ordinary integral closedness of a polynomial ideal. -/
def IsIntegrallyClosedIdeal (I : Ideal R) : Prop :=
  ∀ x : R, IntegralOverIdeal I x → x ∈ I
end CommAlg
namespace CommAlg.Polymatroid
open Classical Finset
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Delete every generator divisible by a distinct displayed generator. -/
def minimalFamily (B : Family V) : Family V :=
  B.filter (fun a => ∀ b ∈ B, b ≤ a → b = a)
/-- Set coordinates outside U to zero in the exponent vector, corresponding
to setting their variables to one in the monomial. -/
def project (U : Finset V) (a : Exponent V) : Exponent V := a.filter (· ∈ U)
/-- Minimal exponent family after monomial localization, in ambient coordinates. -/
def localize (B : Family V) (U : Finset V) : Family V :=
  minimalFamily (B.image (project U))
/-- Every monomial localization has generators of one degree. -/
def LocallyEquigenerated (B : Family V) : Prop :=
  ∀ U : Finset V, ∃ d, Equigenerated (localize B U) d
end CommAlg.Polymatroid
namespace Characterizations
open Classical CommAlg CommAlg.Polymatroid
section IntegralCharacterization
universe u
variable {V : Type u} [Fintype V] [DecidableEq V]
variable {k : Type*} [CommRing k] [IsDomain k]
/-- Corollary 2.12 / Equation2.5: ordinary ideal integrality plus local
equigeneration recovers the full exchange axiom. -/
theorem polymatroidal_iff_integrallyClosed_localEquigenerated {B : Family V}
    (hB : B.Nonempty) (hanti : Antichain B) :
    IsPolymatroidal B ↔ IsIntegrallyClosedIdeal (monomialIdeal k B) ∧
      LocallyEquigenerated B := by sorry
end IntegralCharacterization
namespace TermOrders
universe u
variable {V : Type u} [Fintype V] [DecidableEq V]
/-- Decreasing comparison under an arbitrary monomial term order. -/
def termBefore (m : MonomialOrder V) (a b : Exponent V) : Prop := m.toSyn b < m.toSyn a
end TermOrders
open TermOrders
section ArbitraryTermOrders
universe u
variable {V : Type u} {k : Type*} [Fintype V] [DecidableEq V] [CommSemiring k] [Nontrivial k]
/-- Theorem 3.12: every monomial term order gives linear quotients, and
for equigenerated families this condition also characterizes exchange. -/
theorem polymatroidal_iff_all_termOrder_linearQuotients {B : Family V} {d : ℕ}
    (hB : Equigenerated B d) : IsPolymatroidal B ↔
      ∀ m : MonomialOrder.{u,u} V, HasLinearQuotients k B (termBefore m) := by sorry
end ArbitraryTermOrders
section QuantitativeOrderDefs
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- A set of orders recognizing every equigenerated family in every degree. -/
def UniversalOrderTests (k : Type*) [CommSemiring k] (F : Set (VariableOrder V)) : Prop :=
  ∀ (B : Family V) (d : ℕ), Equigenerated B d →
    (∀ o ∈ F, HasLinearQuotients k B (variableRevlex o)) → IsPolymatroidal B
/-- A set of orders recognizing every equigenerated family in degree d. -/
def DegreeOrderTests (k : Type*) [CommSemiring k] (d : ℕ) (F : Set (VariableOrder V)) : Prop :=
  ∀ B : Family V, Equigenerated B d →
    (∀ o ∈ F, HasLinearQuotients k B (variableRevlex o)) → IsPolymatroidal B
/-- The equigenerated form of Theorem 1.1(B). -/
theorem polymatroidal_iff_universal_revlex {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} {d : ℕ} (hB : Equigenerated B d) :
    IsPolymatroidal B ↔ ∀ o : VariableOrder V, HasLinearQuotients k B (variableRevlex o) := by sorry
end QuantitativeOrderDefs
section ProbabilitySource
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The single-pattern rejection probability used in the logarithmic test bound. -/
def testProbability (d : ℕ) : ℝ := 2 / ((d:ℝ)*((d:ℝ)+1)*((d:ℝ)+2))
end ProbabilitySource
section TestNumbers
open Classical Finset
variable (k : Type*) [CommSemiring k] [Nontrivial k]
theorem exists_degree_test_size (n d : ℕ) :
    ∃ m, ∃ F : Finset (VariableOrder (Fin n)),
      DegreeOrderTests k d (F : Set (VariableOrder (Fin n))) ∧ F.card = m := by
  refine ⟨Fintype.card (VariableOrder (Fin n)),univ,?_,card_univ⟩
  intro B hB hL
  exact (polymatroidal_iff_universal_revlex hB).mpr (fun o => hL o (mem_univ _))
/-- The least cardinality of a family of degree-d recognition orders. -/
def orderTestNumber (n d : ℕ) : ℕ := Nat.find (exists_degree_test_size k n d)
theorem exists_universal_test_size (n : ℕ) :
    ∃ m, ∃ F : Finset (VariableOrder (Fin n)),
      UniversalOrderTests k (F : Set (VariableOrder (Fin n))) ∧ F.card = m := by
  refine ⟨Fintype.card (VariableOrder (Fin n)),univ,?_,card_univ⟩
  intro B d hB hL
  exact (polymatroidal_iff_universal_revlex hB).mpr (fun o => hL o (mem_univ _))

/-- The least cardinality of a family of recognition orders valid in all degrees. -/
def universalTestNumber (n : ℕ) : ℕ := Nat.find (exists_universal_test_size k n)
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem universalTestNumber_ge_four {n : ℕ} (hn : 4 ≤ n) :
    universalTestNumber k n = 3*n.choose 3 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem universalTestNumber_one : universalTestNumber k 1 = 0 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem universalTestNumber_two : universalTestNumber k 2 = 1 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem universalTestNumber_three : universalTestNumber k 3 = 6 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_small_degree {n d : ℕ} (hd : d ≤ 1) : orderTestNumber k n d = 0 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_small_dimension {n d : ℕ} (hn : n ≤ 1) : orderTestNumber k n d = 0 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_two {d : ℕ} (hd : 2 ≤ d) : orderTestNumber k 2 d = 1 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_three {d : ℕ} (hd : 2 ≤ d) : orderTestNumber k 3 d = 6 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_high_degree {n d : ℕ} (hn : 4 ≤ n) (hd : n-2 ≤ d) :
    orderTestNumber k n d = 3*n.choose 3 := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_logarithmic_upper {n d : ℕ} (hn : 4 ≤ n) (hd : 2 ≤ d) (hdn : d ≤ n-2) :
    orderTestNumber k n d ≤ ⌈(testProbability d)⁻¹ *
      (Real.log (n * (n-1).choose 2 * (n-3).choose (d-1)) + 1)⌉₊ := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_counting_lower {n d : ℕ} (hn : 4 ≤ n) (hd : 2 ≤ d) (hdn : d ≤ n-2) :
    3*(d+2).choose 3 ≤ orderTestNumber k n d := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_signature_bound {n d : ℕ} (hn : 4 ≤ n) (hd : 2 ≤ d) :
    n-1 ≤ (orderTestNumber k n d).choose (orderTestNumber k n d / 2) := by sorry
/-- Theorems 5.3–5.4 and Corollary 5.5: exact minima and sharp quantitative consequences. -/
theorem orderTestNumber_isTheta_log (d : ℕ) (hd : 2 ≤ d) :
    (fun n : ℕ => (orderTestNumber k n d : ℝ)) =Θ[atTop] (fun n : ℕ => Real.log n) := by sorry
end TestNumbers
section FiniteFractionSource
variable {X Y : Type*} [Fintype X] [Fintype Y]
/-- Proportion of a finite type satisfying the displayed predicate. -/
def finiteFraction (P : X → Prop) : ℝ :=
  (Nat.card {x // P x} : ℝ) / Nat.card X
end FiniteFractionSource
section Rejection
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Fraction of variable orders rejecting the actual colon-ideal quotient test. -/
def rejectionFraction (k : Type*) [CommSemiring k] (B : Family V) : ℝ :=
  finiteFraction (fun o : VariableOrder V => ¬ HasLinearQuotients k B (variableRevlex o))
/-- The sharp probability of a single active order pattern. -/
def patternMass (s : ℕ) : ℝ := 1 / ((s+3)*(s+2).choose 2 : ℕ)
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem rejection_fraction_lower_bound {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} {d : ℕ} (hB : Equigenerated B d) (hd : 2 ≤ d)
    (hcard : 4 ≤ Fintype.card V) (hnot : ¬ IsPolymatroidal B) :
    patternMass (min (d-1) (Fintype.card V-3)) ≤ rejectionFraction k B := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem exists_sharp_rejection_family {k : Type*} [CommSemiring k] [Nontrivial k]
    (d : ℕ) (hd : 2 ≤ d) (hcard : 4 ≤ Fintype.card V) :
    ∃ B : Family V, Equigenerated B d ∧ ¬ IsPolymatroidal B ∧
      rejectionFraction k B = patternMass (min (d-1) (Fintype.card V-3)) := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem rejection_fraction_displayed {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} {d : ℕ} (hB : Equigenerated B d) (hd : 2 ≤ d)
    (hcard : 4 ≤ Fintype.card V) (hnot : ¬ IsPolymatroidal B) :
    let t := min d (Fintype.card V-2)
    2 / ((t:ℝ)*((t:ℝ)+1)*((t:ℝ)+2)) ≤ rejectionFraction k B := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem exists_sharp_rejection_displayed {k : Type*} [CommSemiring k] [Nontrivial k]
    (d : ℕ) (hd : 2 ≤ d) (hcard : 4 ≤ Fintype.card V) :
    ∃ B : Family V, Equigenerated B d ∧ ¬ IsPolymatroidal B ∧
      let t := min d (Fintype.card V-2)
      rejectionFraction k B = 2 / ((t:ℝ)*((t:ℝ)+1)*((t:ℝ)+2)) := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem independent_tests_miss_bound {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} {d : ℕ} (hB : Equigenerated B d) (hd : 2 ≤ d)
    (hcard : 4 ≤ Fintype.card V) (hnot : ¬ IsPolymatroidal B) (M : ℕ) :
    finiteFraction (fun f : Fin M → VariableOrder V =>
      ∀ j, HasLinearQuotients k B (variableRevlex (f j))) ≤
      (1-patternMass (min (d-1) (Fintype.card V-3)))^M := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem rejection_fraction_three {k : Type*} [CommSemiring k] [Nontrivial k]
    (hcard : Fintype.card V = 3) {B : Family V} {d : ℕ} (hB : Equigenerated B d)
    (hnot : ¬ IsPolymatroidal B) : (1:ℝ)/6 ≤ rejectionFraction k B := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem exists_sharp_rejection_three {k : Type*} [CommSemiring k] [Nontrivial k]
    (hcard : Fintype.card V = 3) (d : ℕ) (hd : 2 ≤ d) :
    ∃ B : Family V, Equigenerated B d ∧ ¬ IsPolymatroidal B ∧ rejectionFraction k B = (1:ℝ)/6 := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem rejection_fraction_two {k : Type*} [CommSemiring k] [Nontrivial k]
    (hcard : Fintype.card V ≤ 2) {B : Family V} {d : ℕ} (hB : Equigenerated B d)
    (hnot : ¬ IsPolymatroidal B) : rejectionFraction k B = 1 := by sorry
/-- Theorem 5.6: uniform rejection, attained sharpness, small cases, or independent repetition. -/
theorem exists_sharp_rejection_two {k : Type*} [CommSemiring k] [Nontrivial k]
    (hcard : Fintype.card V = 2) (d : ℕ) (hd : 2 ≤ d) :
    ∃ B : Family V, Equigenerated B d ∧ ¬ IsPolymatroidal B ∧ rejectionFraction k B = 1 := by sorry
end Rejection
section LocalizationBands
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]
/-- Theorem 4.5: the exact localization codimension band. -/
theorem polymatroidal_iff_pure_localization_band {B : Family V} (hB : B.Nonempty)
    {d : ℕ} (hd : Equigenerated B d) (hd2 : 2 ≤ d) (hl : LocallyEquigenerated B) :
    IsPolymatroidal B ↔
      ∀ U : Finset V, 2 ≤ U.card → Fintype.card V-U.card ≤ d-2 →
        HasLinearResolution (monomialLocalization k (monomialIdeal k B) U) := by sorry
/-- Theorem 4.5: the exact localization codimension band. -/
theorem polymatroidal_iff_localization_band {B : Family V} (hB : B.Nonempty)
    {d : ℕ} (hd : Equigenerated B d) (hd2 : 2 ≤ d) :
    IsPolymatroidal B ↔
      ∀ U : Finset V, 2 ≤ U.card → Fintype.card V-U.card ≤ d-1 →
        HasLinearResolution (monomialLocalization k (monomialIdeal k B) U) := by sorry
end LocalizationBands
section Coverage
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The designated two variables are the last two, in the specified order. -/
def FinalPair (o : VariableOrder V) (i j : V) : Prop :=
  o i < o j ∧ ∀ h, h ≠ i → h ≠ j → o h < o i
/-- The designated last variable follows the other two designated variables,
which both follow every remaining variable. -/
def FinalTriple (o : VariableOrder V) (i q j : V) : Prop :=
  o i < o j ∧ o q < o j ∧
    ∀ h, h ≠ i → h ≠ q → h ≠ j → o h < o i ∧ o h < o q
/-- Every ordered final pair is attained by a test order. -/
def CoversFinalPairs (F : Set (VariableOrder V)) : Prop :=
  ∀ i j, i ≠ j → ∃ o ∈ F, FinalPair o i j
/-- Every pointed final triple is attained by a test order. -/
def CoversFinalTriples (F : Set (VariableOrder V)) : Prop :=
  ∀ i q j, i ≠ q → i ≠ j → q ≠ j → ∃ o ∈ F, FinalTriple o i q j
/-- Coordinates outside the three designated variables. -/
def tripleCap (i q z : V) : Finset V := univ \ {i, q, z}
/-- The finite active-order pattern in Theorem5.4. -/
def OrderPattern (o : VariableOrder V) (C : Finset V) (i q j : V) : Prop :=
  o i < o j ∧ o q < o j ∧ ∀ t ∈ C, o t < o i ∧ o t < o q
/-- Every active set of size s and every designated triple has a witnessing order. -/
def CoversPatterns (s : ℕ) (F : Set (VariableOrder V)) : Prop :=
  ∀ i q j, i ≠ q → i ≠ j → q ≠ j → ∀ C : Finset V,
    C ⊆ tripleCap i q j → C.card = s → ∃ o ∈ F, OrderPattern o C i q j
/-- The full necessary-and-sufficient recognition coverage condition. -/
theorem universalOrderTests_iff_coverage {k : Type*} [CommSemiring k] [Nontrivial k]
    (hcard : 4 ≤ Fintype.card V) (F : Set (VariableOrder V)) :
    UniversalOrderTests k F ↔ CoversFinalPairs F ∧ CoversFinalTriples F := by sorry
/-- The full necessary-and-sufficient recognition coverage condition. -/
theorem degreeOrderTests_iff_coverage {k : Type*} [CommSemiring k] [Nontrivial k]
    (d : ℕ) (hd : 2 ≤ d) (hcard : 4 ≤ Fintype.card V) (F : Set (VariableOrder V)) :
    DegreeOrderTests k d F ↔
      CoversPatterns (min (d - 1) (Fintype.card V - 3)) F ∧
      (Fintype.card V - 1 ≤ d → CoversFinalPairs F) := by sorry
end Coverage
end Characterizations
namespace Characterizations
open Classical Finset CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The retained-coordinate exponent vector in the smaller polynomial ring. -/
def restrictExponent (U : Finset V) (a : Exponent V) : Exponent U :=
  a.subtypeDomain (· ∈ U)
/-- The actual minimal generator family after substitution of one outside U. -/
def localFamily (B : Family V) (U : Finset V) : Family U :=
  minimalFamily (B.image (restrictExponent U))
end Characterizations
namespace CommAlg.Polymatroid
open Classical Finset
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Sum of a monomial exponent over a coordinate set. -/
def subsetSum (a : Exponent V) (U : Finset V) : ℕ := ∑ i ∈ U, a i
/-- Minimum retained degree among the displayed monomial generators. -/
def lowerRank (B : Family V) (U : Finset V) : ℕ :=
  if h : B.Nonempty then B.inf' h (fun a => subsetSum a U) else 0
end CommAlg.Polymatroid
namespace Characterizations
open Classical Finset CommAlg.Polymatroid MvPolynomial
section Socle
variable {V : Type*} [Fintype V] [DecidableEq V]
variable {k : Type*} [CommRing k] [Nontrivial k]
/-- The socle of the actual polynomial quotient, annihilated by all variables. -/
def quotientSocle (I : Ideal (MvPolynomial V k)) : Set (MvPolynomial V k ⧸ I) :=
  {q | ∀ i : V, Ideal.Quotient.mk I (X i) * q = 0}
/-- Every socle class admits a homogeneous representative of degree d. -/
def SocleConcentrated (I : Ideal (MvPolynomial V k)) (d : ℕ) : Prop :=
  ∀ q ∈ quotientSocle I, ∃ f : MvPolynomial V k,
    f.IsHomogeneous d ∧ Ideal.Quotient.mk I f = q
end Socle
section SocleCharacterization
variable {V : Type*} [Fintype V] [DecidableEq V]
variable (k : Type*) [CommRing k] [Nontrivial k]
/-- Corollary2.7: genuine quotient socles together with local purity detect exchange. -/
theorem polymatroidal_iff_local_socles {B : Family V} (hB : B.Nonempty)
    (hanti : Antichain B) :
    IsPolymatroidal B ↔ LocallyEquigenerated B ∧
      ∀ U : Finset V, monomialIdeal k (localFamily B U) ≠ ⊤ →
        SocleConcentrated (monomialIdeal k (localFamily B U)) (lowerRank B U - 1) := by sorry
end SocleCharacterization
section LocalizationQuotients
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Corollary3.11: universal pure reverse-lexicographic linear quotients survive every localization. -/
theorem universal_pure_revlex_localization {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} (hB : Antichain B)
    (h : ∀ o : VariableOrder V, HasLinearQuotients k B (variableRevlex o))
    (U : Finset V) (o : VariableOrder U) :
    HasLinearQuotients k (localFamily B U) (variableRevlex o) := by sorry
end LocalizationQuotients
namespace Isolators
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]
/-- A fixed family of actual localization tests is sufficient in degree d. -/
def LocalizationTestSufficient (Γ : Finset (Finset V)) (d : ℕ) : Prop :=
  ∀ B : Family V, B.Nonempty → Equigenerated B d →
    (∀ U ∈ Γ, HasLinearResolution (monomialLocalization k (monomialIdeal k B) U)) →
      IsPolymatroidal B

/-- The same test with prior equigeneration at every localization. -/
def PureLocalizationTestSufficient (Γ : Finset (Finset V)) (d : ℕ) : Prop :=
  ∀ B : Family V, B.Nonempty → Equigenerated B d → LocallyEquigenerated B →
    (∀ U ∈ Γ, HasLinearResolution (monomialLocalization k (monomialIdeal k B) U)) →
      IsPolymatroidal B
/-- The exact nontrivial localization codimension band. -/
def localizationBand (t : ℕ) : Finset (Finset V) :=
  Finset.univ.filter (fun U => 2 ≤ U.card ∧ Uᶜ.card ≤ t)
/-- Theorem4.5 and Corollary4.8: exact necessary testing sets and attained minima. -/
theorem localizationTestSufficient_iff (Γ : Finset (Finset V)) (d : ℕ) (hd : 2 ≤ d) :
    LocalizationTestSufficient (k := k) Γ d ↔ localizationBand (V := V) (d-1) ⊆ Γ := by sorry
/-- Theorem4.5 and Corollary4.8: exact necessary testing sets and attained minima. -/
theorem pureLocalizationTestSufficient_iff (Γ : Finset (Finset V)) (d : ℕ) (hd : 2 ≤ d) :
    PureLocalizationTestSufficient (k := k) Γ d ↔ localizationBand (V := V) (d-2) ⊆ Γ := by sorry
/-- Theorem4.5 and Corollary4.8: exact necessary testing sets and attained minima. -/
theorem localizationTest_minimum (d : ℕ) (hd : 2 ≤ d) (hn : 2 ≤ Fintype.card V) :
    (∃ Γ : Finset (Finset V), LocalizationTestSufficient (k := k) Γ d ∧
      Γ.card = ∑ j ∈ Finset.range (min (d-1) (Fintype.card V-2)+1), Nat.choose (Fintype.card V) j) ∧
    (∀ Γ : Finset (Finset V), LocalizationTestSufficient (k := k) Γ d →
      (∑ j ∈ Finset.range (min (d-1) (Fintype.card V-2)+1), Nat.choose (Fintype.card V) j) ≤ Γ.card) := by sorry
/-- Theorem4.5 and Corollary4.8: exact necessary testing sets and attained minima. -/
theorem pureLocalizationTest_minimum (d : ℕ) (hd : 2 ≤ d) (hn : 2 ≤ Fintype.card V) :
    (∃ Γ : Finset (Finset V), PureLocalizationTestSufficient (k := k) Γ d ∧
      Γ.card = ∑ j ∈ Finset.range (min (d-2) (Fintype.card V-2)+1), Nat.choose (Fintype.card V) j) ∧
    (∀ Γ : Finset (Finset V), PureLocalizationTestSufficient (k := k) Γ d →
      (∑ j ∈ Finset.range (min (d-2) (Fintype.card V-2)+1), Nat.choose (Fintype.card V) j) ≤ Γ.card) := by sorry
end Isolators
end Characterizations

namespace CommAlg.Polymatroid
open Classical Finset
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Every coordinate has the displayed constant exponent. -/
def constExponent (n : ℕ) : Exponent V := Finsupp.equivFunOnFinite.symm (fun _ => n)
/-- All literal lower-rank subset inequalities on an integer exponent. -/
def LowerFeasible (r : Finset V → ℕ) (a : Exponent V) : Prop :=
  ∀ U, r U ≤ subsetSum a U
end CommAlg.Polymatroid
namespace Characterizations
open Classical CommAlg CommAlg.Polymatroid Finset MvPolynomial
section Polytope
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The real coordinate vector of a monomial exponent. -/
def realExponent (a : Exponent V) : V → ℝ := fun i => a i
/-- Sum of real coordinates on the indicated subset. -/
def realSubsetSum (x : V → ℝ) (U : Finset V) : ℝ := ∑ i ∈ U, x i
/-- The actual nonnegative real polytope of total degree d and every lower-rank inequality. -/
def lowerRankPolytope (B : Family V) (d : ℕ) : Set (V → ℝ) :=
  {x | (∀ i, 0 ≤ x i) ∧ realSubsetSum x univ = d ∧
    ∀ U, (lowerRank B U : ℝ) ≤ realSubsetSum x U}
/-- The full integer base family, with the original finite coordinate bound. -/
def lowerBaseFamily (r : Finset V → ℕ) (d : ℕ) : Family V :=
  (Finset.Iic (constExponent d)).filter (fun a => a.degree = d ∧ LowerFeasible r a)
/-- Theorem2.11, Equation2.3: equality of the actual real convex sets. -/
theorem convexHull_generators_eq_lowerRankPolytope {B : Family V} (hB : B.Nonempty)
    (hanti : Antichain B) (hl : LocallyEquigenerated B) {d : ℕ} (hd : Equigenerated B d) :
    convexHull ℝ (realExponent '' (B : Set (Exponent V))) = lowerRankPolytope B d := by sorry
end Polytope
section IntegralClosure
universe u
variable {V : Type u} [Fintype V] [DecidableEq V]
variable {k : Type*} [CommRing k] [IsDomain k]
/-- Theorem2.11: every polynomial in the integral closure, expressed by ordinary monic equations. -/
theorem integralOverIdeal_iff_mem_canonicalLowerBases {B : Family V} (hB : B.Nonempty)
    (hanti : Antichain B) (hl : LocallyEquigenerated B) {d : ℕ} (hd : Equigenerated B d)
    (f : MvPolynomial V k) :
    IntegralOverIdeal (monomialIdeal k B) f ↔
      f ∈ monomialIdeal k (lowerBaseFamily (lowerRank B) d) := by sorry
/-- Theorem2.11: equality with the literal monomial ideal of all feasible integer bases. -/
theorem integralClosure_set_eq {B : Family V} (hB : B.Nonempty)
    (hanti : Antichain B) (hl : LocallyEquigenerated B) {d : ℕ} (hd : Equigenerated B d) :
    {f : MvPolynomial V k | IntegralOverIdeal (monomialIdeal k B) f} =
      (monomialIdeal k (lowerBaseFamily (lowerRank B) d) : Set (MvPolynomial V k)) := by sorry
end IntegralClosure
section OrderCoverage
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Theorem3.6: the exact final-pair/final-triple coverage suffices for the full donor exchange axiom. -/
theorem exchange_of_order_coverage {k : Type*} [CommSemiring k] [Nontrivial k]
    {B : Family V} {d : ℕ} (hB : Equigenerated B d) (F : Set (VariableOrder V))
    (hne : F.Nonempty) (hpairs : CoversFinalPairs F) (htriples : CoversFinalTriples F)
    (hL : ∀ o ∈ F, HasLinearQuotients k B (variableRevlex o)) : ExchangeAxiom B := by sorry
end OrderCoverage
end Characterizations

namespace Characterizations
open Classical Finset CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The actual sum of absolute coordinate differences of integer exponent vectors. -/
def l1Distance (a b : Exponent V) : ℕ := (a - b).degree + (b - a).degree
end Characterizations
section FinitePresentationSource
@[reducible] local instance (priority := 2000) presentationDecEq (α : Type*) [Fintype α] : DecidableEq α := Classical.decEq α
namespace Characterizations.Presentation
open Classical Finset MvPolynomial CommAlg.Polymatroid
universe u
variable {V k : Type u} [Fintype V] [DecidableEq V] [CommRing k]
/-- The actual minimal monomial labels of the canonical free module. -/
abbrev Generators (B : Family V) := {b // b ∈ B}
/-- The free polynomial module on those labels. -/
abbrev Free (B : Family V) := Generators B → MvPolynomial V k
/-- The actual augmentation mapping a basis vector to its labelled monomial. -/
def augmentation (B : Family V) : Free (k := k) B →ₗ[MvPolynomial V k] MvPolynomial V k :=
  Fintype.linearCombination _ (fun b : Generators B => monomial b.val 1)
/-- An exact finite free presentation whose actual first differential entries are linear. -/
structure FiniteLinearPresentation (B : Family V) where
  rank : ℕ
  differential : (Fin rank → MvPolynomial V k) →ₗ[MvPolynomial V k] Free (k := k) B
  exact : LinearMap.range differential = LinearMap.ker (augmentation B)
  linear : Resolution.IsHomogeneousMap differential 1
/-- The full prescribed-donor exchange condition on every pair at distance exactly four. -/
def DistanceFourExchange (B : Family V) : Prop :=
  ∀ a ∈ B, ∀ b ∈ B, l1Distance a b = 4 → ∀ i, b i < a i →
    ∃ j, a j < b j ∧ exchange a i j ∈ B
/-- Theorem3.3: a genuine finite linear presentation together with distance-four exchange characterizes polymatroidality. -/
theorem polymatroidal_iff_linearPresentation_distanceFour [Nontrivial k]
    {B : Family V} {d : ℕ} (hB : Equigenerated B d) :
    IsPolymatroidal B ↔ Nonempty (FiniteLinearPresentation (k := k) B) ∧ DistanceFourExchange B := by sorry
end Characterizations.Presentation
end FinitePresentationSource
