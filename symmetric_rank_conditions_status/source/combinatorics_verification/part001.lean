 theorem map_dualLetter_pairInsert_high {k a : ℕ} {rows : List (List ℕ)}
    (ha : a < k) (hrows : ∀ x ∈ rows.flatten, x < k) (s i : Fin 3) :
    (pairInsert a (k+i.val) rows).map (List.map (dualLetter k s)) =
      pairInsert a (dualLetter k s (k+i.val)) rows := by
  unfold pairInsert
  rw [map_appendToRow,map_dualLetter_rowInsert_low ha hrows]

 theorem dualRows_cons_low {k : ℕ} (row : List ℕ) (rows : List (List ℕ))
    (hrow : ∀ x ∈ row, x < k) : dualRows k (row::rows) = row::dualRows k rows := by
  have hf : tripleFootprint k row = [] := tripleFootprint_eq_nil_of_forall_lt hrow
  unfold dualRows
  rw [rowWordRows_cons,tripleFootprint_append,hf,List.append_nil,List.map_cons,
    map_dualLetter_eq_self hf]

