    (hs : dualSelector (tripleFootprint k (rowWordRows rows ++ [a])) = s)
    (hf : StrictMonoOn (dualLetter k s) {x : ℕ | x ≠ a}) :
    rowInsert (dualLetter k s a) (rows.map (List.map (dualLetter k s))) =
      dualRows k (rowInsert a rows) := by
