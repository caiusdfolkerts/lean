      rw [endpointWord_append,List.map_append] at hnmap
      simpa only [endpointWord,List.flatMap_cons,List.flatMap_nil,List.append_nil,
        List.map_cons,List.map_nil,hfb] using hnmap
  · have hrows : pairInsertList (relabelPairs f w) =
        (pairInsertList w).map (List.map f) := by
      simpa only [relabelPairs,List.map_nil] using
        pairInsertList_map_on f {x : ℕ | x ≠ k+d.val} hf w hS
          (by simp : ∀ x ∈ ([] : List (List ℕ)).flatten, x ≠ k+d.val)
    rw [pairInsertList_append_singleton,pairInsertList_append_singleton,hrows]
