def relabelPairs (f : ℕ → ℕ) (w : List (ℕ × ℕ)) : List (ℕ × ℕ) :=
  w.map fun p => (f p.1,f p.2)

theorem endpointWord_relabelPairs (f : ℕ → ℕ) (w : List (ℕ × ℕ)) :
    endpointWord (relabelPairs f w) = (endpointWord w).map f := by
  induction w with
  | nil => rfl
  | cons p w ih =>
    simpa only [relabelPairs,List.map_cons,endpointWord,List.flatMap_cons,
      List.map_append,List.map_cons,List.map_nil,Function.comp_apply,
      List.cons_append,List.nil_append] using congrArg (List.cons (f p.1) ∘
        List.cons (f p.2)) ih

theorem MatchingWord.relabel_on {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    (f : ℕ ≃ ℕ) (S : Set ℕ) (hf : StrictMonoOn f S)
    (hS : ∀ x ∈ endpointWord w, x ∈ S) : MatchingWord (relabelPairs f w) := by
  constructor
  · intro p hp
    obtain ⟨q,hq,rfl⟩ := List.mem_map.mp hp
    exact hf (hS q.1 (mem_endpointWord.mpr ⟨q,hq,Or.inl rfl⟩))
      (hS q.2 (mem_endpointWord.mpr ⟨q,hq,Or.inr rfl⟩)) (hw.lower_lt_upper q hq)
  · apply List.pairwise_map.mpr
    apply hw.ordered.imp_of_mem
    intro p q hp hq hpq
    exact hf (hS p.2 (mem_endpointWord.mpr ⟨p,hp,Or.inr rfl⟩))
      (hS q.2 (mem_endpointWord.mpr ⟨q,hq,Or.inr rfl⟩)) hpq
  · rw [endpointWord_relabelPairs]
    exact hw.distinct.map f.injective

/-- If the final distinguished label enters as the lower endpoint of its edge,
the actual dual tableau has a matching preimage obtained by an adjacent relabeling.
The result includes validity of the new matching word, not just tableau equality. -/
theorem matching_last_label_dual_move {k b : ℕ} (d : Fin 3)
    (w : List (ℕ × ℕ)) (hw : MatchingWord (w++[(k+d.val,b)]))
    (hm : ∀ e : Fin 3, k+e.val ∈ endpointWord w ++ [k+d.val])
    (hbout : tripleTag k b = none) :
