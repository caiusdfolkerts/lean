          (R++[k,k+1])::pairInsert p (k+2) rows := by
        rw [hp0]
        have hb' := rowBump_append_of_snd_eq_some hb [k,k+1]
        rw [pairInsert_cons_of_some rows (by rw [hb']),hb']
      rw [hY,hZ]
      have hf : tripleFootprint k (rowWordRows ((R++[k,k+2])::pairInsert p (k+1) rows)) =
