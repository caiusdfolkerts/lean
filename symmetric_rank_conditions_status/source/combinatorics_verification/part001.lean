  have hbound : ∀ p ∈ relabelPairs f w, p.2 < b := by
    intro p hp'
    obtain ⟨q,hq,rfl⟩ := List.mem_map.mp hp'
    have hqS := hS q.2 (mem_endpointWord.mpr ⟨q,hq,Or.inr rfl⟩)
    have hbS : b ∈ {x : ℕ | x ≠ k+d.val} := ne_of_gt hab
