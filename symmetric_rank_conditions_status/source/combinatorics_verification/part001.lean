    MatchingWord (relabelPairs f w ++ [(f (k+d.val),b)]) ∧
      pairInsertList (relabelPairs f w ++ [(f (k+d.val),b)]) =
        dualRows k (pairInsertList (w++[(k+d.val,b)])) := by
  let s := dualSelector (tripleFootprint k (rowWordRows (pairInsertList w) ++ [k+d.val]))
  let f := dualLetter k s
  have hp : MatchingWord w := hw.prefix
  have hfresh := hw.last_fresh
  have ha : k+d.val ∉ (pairInsertList w).flatten := by
    intro hx
    apply hfresh.1
    simpa only [List.flatten_nil,List.append_nil] using
      (flatten_pairInsertList_perm w []).mem_iff.mp hx
  have hletters : ∀ e : Fin 3,
      k+e.val ∈ rowWordRows (pairInsertList w) ++ [k+d.val] := by
    intro e
    simpa only [List.mem_append,mem_rowWordRows_pairInsertList] using hm e
  have hnd : (rowWordRows (pairInsertList w) ++ [k+d.val]).Nodup := by
    refine List.nodup_append.mpr ⟨(rowWordRows_nodup_iff _).mpr hp.output_distinct,by simp,?_⟩
    intro x hx y hy hxy
    have hy' : y = k+d.val := List.mem_singleton.mp hy
    exact ha ((mem_rowWordRows_iff _ _).mp (hxy.trans hy' ▸ hx))
  have hf : StrictMonoOn f {x : ℕ | x ≠ k+d.val} :=
    dualLetter_missing_strictMonoOn hnd hletters
  have hS : ∀ x ∈ endpointWord w, x ∈ {x : ℕ | x ≠ k+d.val} := by
    intro x hx hxa
    exact hfresh.1 (hxa ▸ hx)
  have hmap : MatchingWord (relabelPairs f w) := hp.relabel_on f _ hf hS
  have hfb : f b = b := dualLetter_eq_self_of_none s hbout
  have hab : k+d.val < b := hw.lower_lt_upper (k+d.val,b) (by simp)
  have hdb := d.isLt
  have hbne := (tripleTag_eq_none_iff k b).mp hbout
  have hbig : k+2 < b := by omega
  have hfab : f (k+d.val) < b := by
    dsimp only [f]
    rw [dualLetter_label]
    have hd' := (dualTag s d).isLt
