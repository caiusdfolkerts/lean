  rw [pairInsert_high hrows,map_appendToRow,map_appendToRow,map_dualLetter_low_rows hrows]

/-- The internal-edge critical relation, with no restriction on the number or
lengths of the initial rows. -/
theorem paired_internal_dual {k c : ℕ} {rows : List (List ℕ)}
    (hc : c < k) (hrows : ∀ x ∈ rows.flatten, x < k) :
    dualRows k (pairInsert k (k+2) (pairInsert c (k+1) rows)) =
      pairInsert c (k+2) (pairInsert k (k+1) rows) := by
  have hc0 := tripleTag_eq_none_of_lt hc
  cases rows with
  | nil =>
    simp only [pairInsert_nil]
    have hbY : rowBump k [c,k+1] = ([c,k],some (k+1)) := by
      rw [rowBump_cons_of_le _ hc.le,rowBump_cons_of_lt _ (by omega : k < k+1)]
    have hbZ : rowBump c [k,k+1] = ([c,k+1],some k) := by
      rw [rowBump_cons_of_lt _ hc]
    rw [pairInsert_cons_of_some [] (by rw [hbY]),hbY,
      pairInsert_cons_of_some [] (by rw [hbZ]),hbZ]
    simp [pairInsert_nil,dualRows,rowWordRows_cons,rowWordRows_nil,tripleFootprint,
      List.filterMap_cons,hc0,dualSelector,dualLetter,Equiv.swap_apply_def,Nat.add_assoc,
      show c ≠ k from by omega,show c ≠ k+1 from by omega]
  | cons row rows =>
    have hr : ∀ x ∈ row, x < k := fun x hx => hrows x (List.mem_append_left _ hx)
    have ht : ∀ x ∈ rows.flatten, x < k := fun x hx => hrows x (List.mem_append_right _ hx)
    have hkrow := rowBump_of_forall_le k row (fun x hx => (hr x hx).le)
    have hp0 : pairInsert k (k+1) (row::rows) = (row++[k,k+1])::rows := by
      rw [pairInsert_cons_of_none rows (by rw [hkrow]),hkrow]
      simp only [List.append_assoc,List.singleton_append]
    cases hb : (rowBump c row).2 with
    | none =>
      have hle := (rowBump_snd_eq_none_iff c row).mp hb
      have hcb := rowBump_of_forall_le c row hle
      have hY : pairInsert k (k+2) (pairInsert c (k+1) (row::rows)) =
          (row++[c,k])::pairInsert (k+1) (k+2) rows := by
        rw [pairInsert_cons_of_none rows hb,hcb]
        simp only [List.append_assoc,List.singleton_append]
        have hb' : rowBump k (row++[c,k+1]) = (row++[c,k],some (k+1)) := by
          rw [rowBump_append k row _ (fun x hx => (hr x hx).le)]
          simp [rowBump_cons_of_le _ hc.le,rowBump_cons_of_lt _ (by omega : k < k+1)]
        rw [pairInsert_cons_of_some rows (by rw [hb']),hb']
      have hZ : pairInsert c (k+2) (pairInsert k (k+1) (row::rows)) =
          (row++[c,k+1])::pairInsert k (k+2) rows := by
        rw [hp0]
        have hb' : rowBump c (row++[k,k+1]) = (row++[c,k+1],some k) := by
          rw [rowBump_append c row _ hle,rowBump_cons_of_lt _ hc]
        rw [pairInsert_cons_of_some rows (by rw [hb']),hb']
      rw [hY,hZ]
      have hf : tripleFootprint k (rowWordRows ((row++[c,k])::pairInsert (k+1) (k+2) rows)) =
          [1,2,0] := by
        rw [rowWordRows_cons,tripleFootprint_append,
          show pairInsert (k+1) (k+2) rows = pairInsert (k+(1:Fin 3).val) (k+(2:Fin 3).val) rows from rfl,
          tripleFootprint_pairInsert_two_high ht]
        rw [tripleFootprint_low_append row [c,k] hr]
        simp [tripleFootprint,List.filterMap_cons,hc0]
      unfold dualRows
      rw [hf]
      have hs : dualSelector ([1,2,0] : List (Fin 3)) = 1 := by decide
      rw [hs,List.map_cons,List.map_append,map_dualLetter_eq_self (tripleFootprint_eq_nil_of_forall_lt hr)]
      have htail := map_dualLetter_pairInsert_two_high ht (1:Fin 3) 1 2
      have hhigh := pairInsert_high ht (0:Fin 3) 2
      have htail' : (pairInsert (k+1) (k+2) rows).map (List.map (dualLetter k 1)) =
          pairInsert k (k+2) rows := by
        calc
          _ = appendToRow (k+2) 0 (appendToRow k 0 rows) := by
            simpa [dualLetter,Equiv.swap_apply_def,Nat.add_assoc] using htail
