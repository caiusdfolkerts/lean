    (hrows : ∀ x ∈ rows.flatten, x < k) (s i j : Fin 3) :
    (pairInsert (k+i.val) (k+j.val) rows).map (List.map (dualLetter k s)) =
      appendToRow (dualLetter k s (k+j.val)) 0
