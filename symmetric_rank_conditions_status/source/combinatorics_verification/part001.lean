  (tripleTag_eq_some_iff k (k+i.val) i).mpr rfl

 theorem rowWordRows_perm_flatten (rows : List (List ℕ)) :
    (rowWordRows rows).Perm rows.flatten := (List.reverse_perm rows).flatten

 theorem tripleFootprint_pairInsert_high {k a : ℕ} {rows : List (List ℕ)}
    (ha : a < k) (hrows : ∀ x ∈ rows.flatten, x < k) (i : Fin 3) :
    tripleFootprint k (rowWordRows (pairInsert a (k+i.val) rows)) = [i] := by
