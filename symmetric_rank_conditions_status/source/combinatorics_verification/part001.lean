        rw [rowWordRows_cons,tripleFootprint_append,
          show pairInsert p (k+1) rows = pairInsert p (k+(1:Fin 3).val) rows from rfl,
          tripleFootprint_pairInsert_high hp ht]
        rw [tripleFootprint_low_append R [k,k+2] hlow]
        simp [tripleFootprint,List.filterMap_cons]
      unfold dualRows
      rw [hf]
      have hs : dualSelector ([1,0,2] : List (Fin 3)) = 2 := by decide
      rw [hs,List.map_cons,List.map_append,map_dualLetter_eq_self (tripleFootprint_eq_nil_of_forall_lt hlow)]
      have htail := map_dualLetter_pairInsert_high hp ht (2:Fin 3) 1
      simpa [R,dualLetter,Equiv.swap_apply_def,Nat.add_assoc] using
        congrArg (List.cons (R++[k,k+1])) htail

end FourPapers.Symmetric


