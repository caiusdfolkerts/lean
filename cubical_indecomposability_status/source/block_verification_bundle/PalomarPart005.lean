theorem seed_from_H (h : Assignment) (H : Constraints h) (j : Fin 7) :
    seeds h j = ∑ k : Fin 7, hInverse j k * hSeeds h k := by
  fin_cases j
  · norm_num [seeds, hInverse, hSeeds, Fin.sum_univ_succ]
    all_goals linear_combination seed_from_H_0 h H
  · norm_num [seeds, hInverse, hSeeds, Fin.sum_univ_succ]
    all_goals linear_combination seed_from_H_1 h H
  · norm_num [seeds, hInverse, hSeeds, Fin.sum_univ_succ]
    all_goals linear_combination seed_from_H_2 h H
  · norm_num [seeds, hInverse, hSeeds, Fin.sum_univ_succ]
