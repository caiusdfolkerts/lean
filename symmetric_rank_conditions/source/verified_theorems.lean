section

set_option autoImplicit false
set_option maxHeartbeats 1200000

namespace FourPapers.Symmetric

@[simp] theorem matchingFold_eq_fold {n : ℕ} (i j : Fin n) : matchingFold i j = fold i j := rfl

@[simp] theorem matchingAntidiagonalExponent_eq_antidiagonalExponent {n t : ℕ}
    (a b : Fin t ↪o Fin n) : matchingAntidiagonalExponent a b = antidiagonalExponent a b := rfl

/-- Equation (2.2), for the independently defined northwest antidiagonal rank
and the actual endpoint-stage paired-insertion tableau. -/
theorem pairedTableau_rank_statistics {n : ℕ} (m : Entry n →₀ ℕ)
    (i j : Fin n) (hij : i ≤ j) :
    antidiagonalRank m i j = entryPrefixHeight (pairedPrefixTableau m j) i := by
  have h := monomialRectangular_shape m i j hij
  change (∃ a b : Fin (entryPrefixHeight (pairedPrefixTableau m j) i) ↪o Fin n,
    (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧ matchingAntidiagonalExponent a b ≤ m) ∧
    (∀ (t : ℕ) (a b : Fin t ↪o Fin n), (∀ p, a p ≤ i) → (∀ p, b p ≤ j) →
      matchingAntidiagonalExponent a b ≤ m →
      t ≤ entryPrefixHeight (pairedPrefixTableau m j) i) at h
  apply Nat.le_antisymm
  · obtain ⟨a,b,ha,hb,hm⟩ := hasAntidiagonal_rank m i j
    exact h.2 _ a b ha hb hm
  · exact (le_antidiagonalRank_iff m i j).mpr h.1

/-- Equation (2.3), for the independently defined maximum degree of a
product of k actual antidiagonals dividing the input monomial. -/
theorem pairedTableau_packing_statistics {n : ℕ} (m : Entry n →₀ ℕ) (k : ℕ) :
    packingDegree m k = ((halfShape m).map (min k)).sum := by
  have h := monomialPacking_shape m k
  have hr : ((pairedTableau m).map (fun row => min k (row.length/2))).sum =
      ((halfShape m).map (min k)).sum := by
    simp only [halfShape,List.map_map,Function.comp_def]
  rw [hr] at h
  apply Nat.le_antisymm
  · obtain ⟨s,a,b,hs,hm⟩ := hasPackingDegree_max m k
    rw [← hs]
    exact h.2 s a b hm
  · obtain ⟨s,a,b,hs,hm⟩ := h.1
    exact HasPackingDegree.le_max ⟨s,a,b,hs,hm⟩

/-- The `(j+1)`-st part of the conjugate half-shape, defined by counting its
rows of length greater than `j`, independently of the packing statistic. -/
noncomputable def halfShapeConjugate {n : ℕ} (m : Entry n →₀ ℕ) (j : ℕ) : ℕ :=
  ((halfShape m).filter (fun r => j < r)).length

theorem sum_min_eq_sum_conjugate (μ : List ℕ) (k : ℕ) :
    (μ.map (min k)).sum =
      ∑ j ∈ Finset.range k, (μ.filter (fun r => j < r)).length := by
  induction μ with
  | nil => simp
  | cons a μ ih =>
    have hlen (j : ℕ) : ((a::μ).filter (fun r => j < r)).length =
        (if j < a then 1 else 0) + (μ.filter (fun r => j < r)).length := by
      by_cases h : j < a <;> simp [h, Nat.add_comm]
    simp only [List.map_cons,List.sum_cons,hlen,Finset.sum_add_distrib]
    rw [sum_range_ite_lt_matching,ih]

/-- The conjugate-partition expression in equation (2.3), with zero-based
column indices, so that the sum is precisely `μ′₁ + ··· + μ′ₖ`. -/
theorem pairedTableau_packing_conjugate {n : ℕ} (m : Entry n →₀ ℕ) (k : ℕ) :
    packingDegree m k = ∑ j ∈ Finset.range k, halfShapeConjugate m j := by
  rw [pairedTableau_packing_statistics]
  exact sum_min_eq_sum_conjugate (halfShape m) k

/-- Theorem 2.1 in full: the actual paired insertion map is a content-preserving
bijection onto all even-row semistandard tableaux, and has both independently
defined rank and packing statistics. -/
theorem insertion_statistics : InsertionStatisticsAssertion := by
  intro n
  constructor
  · intro m
    refine ⟨pairedTableau_isTableauRows m, pairedTableau_evenRows m, ?_,
      fun i j hij => pairedTableau_rank_statistics m i j hij,
      pairedTableau_packing_statistics m⟩
    simpa only [pairedTableau, List.flatten_nil, List.append_nil] using
      flatten_pairInsertList_perm (monomialPairs m) []
  · intro rows hrows heven
    obtain ⟨m, hm⟩ := exists_monomial_of_evenTableau hrows heven
    refine ⟨m, hm, ?_⟩
    intro m' hm'
    exact pairedTableau_injective (hm'.trans hm.symm)

/-- The paper's symbolic order is the literal tail of the half-shape. -/
noncomputable def gamma {n : ℕ} (t : ℕ) (m : Entry n →₀ ℕ) : ℕ := ((halfShape m).drop (t-1)).sum

/-- Lemma 5.1 with precisely the paper's exact-score product generators. -/
theorem hasSymbolicAntidiagonal_iff_gamma {n : ℕ} (m : Entry n →₀ ℕ)
    (t s : ℕ) (ht : 0 < t) : HasSymbolicAntidiagonal t s m ↔ s ≤ gamma t m := by
  have hh := monomialSymbolic_shape m t s ht
  change (∃ (k : ℕ) (sizes : Fin k → ℕ) (a b : ∀ c, Fin (sizes c) ↪o Fin n),
      (∀ c, t ≤ sizes c) ∧ (∑ c, (sizes c-t+1)) = s ∧
      (∑ c, matchingAntidiagonalExponent (a c) (b c)) ≤ m) ↔ s ≤ gamma t m at hh
  rw [← hh]
  constructor
  · rintro ⟨k,δ,hsize,hscore,hdiv⟩
    exact ⟨k,fun c => (δ c).size,fun c => (δ c).rows,fun c => (δ c).cols,
      hsize,hscore,hdiv⟩
  · rintro ⟨k,sizes,a,b,hsize,hscore,hdiv⟩
    exact ⟨k,fun c => ⟨sizes c,a c,b c⟩,hsize,hscore,hdiv⟩

theorem gamma_eq_max_packing {n : ℕ} (m : Entry n →₀ ℕ) (t : ℕ) :
    (∀ k, packingDegree m k - k*(t-1) ≤ gamma t m) ∧
    packingDegree m ((halfShape m).getD (t-1) 0) -
      ((halfShape m).getD (t-1) 0)*(t-1) = gamma t m := by
  simp only [pairedTableau_packing_statistics]
  exact rowTailScore_is_max (halfShape m) (pairedTableau_halfLengths_sorted m) (t-1)

end FourPapers.Symmetric
