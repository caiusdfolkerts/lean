# Principal theorems of “Gröbner bases for symmetric rank conditions”

The statement propositions below were defined independently of all the proof
constructions. They retain every matrix size, field, coefficient ring, rank
bound, symbolic threshold, and symbolic exponent from the paper.
-/

namespace FourPapers.Symmetric
universe u v

/-- Theorem 1.1: prime symmetric northwest rank ideals over every coefficient
field, their folded initial ideals, and the defining-ideal assertion over
algebraically closed coefficient fields. The realization field is independent. -/
theorem symmetric_rank_loci : SymmetricRankLociTheorem.{u,v} :=
  symmetricRankLociTheorem_of_carrierCorrespondence northwestCarrierCorrespondence

/-- Theorem 1.2 over fields, for every symmetric array and every finite valid
list of genuine symbolic powers, using the paper's exact-score generators. -/
theorem compatible_rank_and_symbolic_conditions : CompatibleGroebnerAssertion.{u} :=
  compatibleGroebner_of_mixedCarrier mixedCarrierCorrespondence

/-- The displayed initial-ideal equality in Theorem 1.2, for the same genuine
symbolic powers and exact-score antidiagonal generators. -/
theorem compatible_initial_ideal (n : ℕ) (K : Type u) [Field K] (r : RankArray n)
    (hr : ∀ i j, r i j = r j i) (conditions : List (ℕ × ℕ))
    (hc : ValidSymbolicConditions n conditions) :
    initialIdeal K (mixedIdeal K r conditions) = northwestAntidiagonalIdeal K r ⊔
      ∑ ts ∈ conditions.toFinset, symbolicAntidiagonalIdeal K n ts.1 ts.2 :=
  mixed_initial_eq_of_groebner K r conditions
    (compatible_rank_and_symbolic_conditions n K r hr conditions hc)

/-- The integral and arbitrary commutative base-change conclusions of
Theorem 1.2, including the specified standard-monomial quotient basis. -/
theorem integral_rank_and_symbolic_conditions : IntegralBaseChangeAssertion.{u} :=
  integralBaseChange_of_mixedCarrier mixedCarrierCorrespondence

/-- The literal standard-monomial basis in Theorem 1.2, as a `Basis` object
over every commutative coefficient ring. Its index set is fixed over the
integers, before the coefficient ring is chosen. -/
noncomputable def integralMixedBasis (n : ℕ) (R : Type u) [CommRing R]
    (r : RankArray n) (hr : ∀ i j, r i j = r j i)
    (conditions : List (ℕ × ℕ)) (hc : ValidSymbolicConditions n conditions) :
    Module.Basis (MixedStandardExponents r conditions) R
      (CoordinateRing n R ⧸ integralMixedIdeal R r conditions) := by
  let h := (integral_rank_and_symbolic_conditions n r hr conditions hc).2.2 R
  exact Module.Basis.mk h.1 h.2.ge

/-- The basis vectors are precisely the specified monomial residue classes. -/
@[simp] theorem integralMixedBasis_apply (n : ℕ) (R : Type u) [CommRing R]
    (r : RankArray n) (hr : ∀ i j, r i j = r j i)
    (conditions : List (ℕ × ℕ)) (hc : ValidSymbolicConditions n conditions)
    (e : MixedStandardExponents r conditions) :
    integralMixedBasis n R r hr conditions hc e =
      Ideal.Quotient.mk (integralMixedIdeal R r conditions)
        (MvPolynomial.monomial e.val 1) := by
  simp only [integralMixedBasis, Module.Basis.mk_apply]

/-- Proposition 4.1, with arbitrary symmetric nonnegative bounds and no
realizability hypothesis. -/
theorem northwest_groebner (n : ℕ) (K : Type u) [Field K] (r : RankArray n)
    (hr : ∀ i j, r i j = r j i) :
    (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r) :=
  northwestGroebner_of_carrierCorrespondence northwestCarrierCorrespondence n K r hr

/-- Corollary 6.1, domain clause: a realized symmetric rank-profile quotient
is a domain over every coefficient integral domain, independently of the
realizing field. -/
theorem symmetric_rank_quotient_isDomain {n : ℕ}
    {F : Type u} [Field F] (w : Matrix (Fin n) (Fin n) F)
    (hw : w.transpose = w) (R : Type v) [CommRing R] [IsDomain R] :
    IsDomain (CoordinateRing n R ⧸ northwestIdeal R (matrixRankArray w)) := by
  letI : (northwestIdeal R (matrixRankArray w)).IsPrime :=
    northwestIdeals_prime_of_northwestGroebner northwest_groebner n F w hw R
  infer_instance

end FourPapers.Symmetric
