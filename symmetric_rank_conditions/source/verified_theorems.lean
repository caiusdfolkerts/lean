section

set_option autoImplicit false
set_option maxHeartbeats 1400000
noncomputable section

namespace FourPapers.Symmetric
open Finsupp

@[simp] theorem matchingLiftPivotExponent_eq {n : ℕ} (m : PivotVariables n →₀ ℕ) :
    matchingLiftPivotExponent m = Pivot.liftPivotExponent m := by
  have he : matchingPivotNonzero (n := n) =
      (fun v : PivotVariables n => Pivot.pivotEntry (Option.some v)) := by
    funext v
    cases v <;> rfl
  change m.mapDomain matchingPivotNonzero =
    m.mapDomain (fun v => Pivot.pivotEntry (Option.some v))
  rw [he]

theorem antidiagonalExponent_transpose {n t : ℕ} (a b : Fin t ↪o Fin n) :
    antidiagonalExponent a b = antidiagonalExponent b a := by
  unfold antidiagonalExponent
  calc
    (∑ p, single (fold (a p) (b p.rev)) 1) =
        ∑ p, single (fold (b p.rev) (a p)) 1 := by simp only [fold_comm]
    _ = ∑ p, single (fold (b p) (a p.rev)) 1 := by
      simpa only [Fin.revPerm_apply,Fin.rev_rev] using
        Equiv.sum_comp (Fin.revPerm : Equiv.Perm (Fin t))
          (fun p => single (fold (b p) (a p.rev)) (1 : ℕ))

theorem HasAntidiagonal.transpose {n t : ℕ} {m : Entry n →₀ ℕ} {i j : Fin n}
    (h : HasAntidiagonal m i j t) : HasAntidiagonal m j i t := by
  obtain ⟨a,b,ha,hb,hm⟩ := h
  exact ⟨b,a,hb,ha,by simpa only [antidiagonalExponent_transpose b a] using hm⟩

theorem antidiagonalRank_symm {n : ℕ} (m : Entry n →₀ ℕ) (i j : Fin n) :
    antidiagonalRank m i j = antidiagonalRank m j i := by
  apply Nat.le_antisymm
  · exact (le_antidiagonalRank_iff m j i).mpr (hasAntidiagonal_rank m i j).transpose
  · exact (le_antidiagonalRank_iff m i j).mpr (hasAntidiagonal_rank m j i).transpose

theorem antidiagonalRank_first_row_le_one {n : ℕ} (m : Entry (n+1) →₀ ℕ)
    (j : Fin (n+1)) : antidiagonalRank m 0 j ≤ 1 := by
  obtain ⟨a,b,ha,hb,hm⟩ := hasAntidiagonal_rank m 0 j
  by_contra hn
  have htwo : 1 < antidiagonalRank m 0 j := by omega
  have hs := a.strictMono (show (⟨0,by omega⟩ : Fin (antidiagonalRank m 0 j)) <
    ⟨1,htwo⟩ from by change (0 : ℕ) < 1; omega)
  have hh := ha ⟨1,htwo⟩
  have hs' : (a ⟨0,by omega⟩).val < (a ⟨1,htwo⟩).val := hs
  have hh' : (a ⟨1,htwo⟩).val ≤ 0 := hh
  omega

theorem rowsPrefixHeight_nat_prefix {n : ℕ} (m : Entry n →₀ ℕ) (i j : Fin n) :
    rowsPrefixHeight
      (pairInsertList ((natMonomialPairs m).filter (fun p => p.2 ≤ j.val))) (i.val+1) =
      entryPrefixHeight (pairedPrefixTableau m j) i := by
  have hf : StrictMono (fun x : Fin n => x.val) := fun _ _ h => h
  have h := pairInsertList_map_strictMono (fun x : Fin n => x.val) hf
    ((monomialPairs m).filter (fun p => p.2 ≤ j)) []
  simp only [List.map_nil] at h
  have hw : (natMonomialPairs m).filter (fun p => p.2 ≤ j.val) =
      ((monomialPairs m).filter (fun p => p.2 ≤ j)).map (fun p => (p.1.val,p.2.val)) := by
    simp only [natMonomialPairs,List.filter_map,Function.comp_def,← Fin.le_def]
  rw [hw,h]
  simp only [List.map_nil,rowsPrefixHeight_map_fin,entryPrefixHeight,pairedPrefixTableau]

theorem carrier_rank_recurrence_le {n : ℕ} (m : PivotVariables n →₀ ℕ)
    (i j : Fin n) (hij : i ≤ j) :
    antidiagonalRank (monomialCarrierEquiv n m).2 i j =
      antidiagonalRank (Pivot.liftPivotExponent m) i.succ j.succ - 1 := by
  rw [pairedTableau_rank_statistics _ i j hij,
    pairedTableau_rank_statistics _ i.succ j.succ (by simpa using hij)]
  have h := monomialCarrierEquiv_prefix_height (j.val+1) (by omega) m (i.val+1)
  have hpred : (fun p : ℕ × ℕ => decide (p.2 < j.val+1)) =
      (fun p : ℕ × ℕ => decide (p.2 ≤ j.val)) := by
    funext p
    simp only [Nat.lt_succ_iff]
  rw [hpred] at h
  have hleft := rowsPrefixHeight_nat_prefix (monomialCarrierEquiv n m).2 i j
  have hright := rowsPrefixHeight_nat_prefix (Pivot.liftPivotExponent m) i.succ j.succ
  simp only [matchingLiftPivotExponent_eq,Fin.val_succ] at hright h
  rw [hleft,hright] at h
  exact h

theorem carrier_rank_recurrence {n : ℕ} (m : PivotVariables n →₀ ℕ) (i j : Fin n) :
    antidiagonalRank (monomialCarrierEquiv n m).2 i j =
      antidiagonalRank (Pivot.liftPivotExponent m) i.succ j.succ - 1 := by
  rcases le_total i j with h | h
  · exact carrier_rank_recurrence_le m i j h
  · rw [antidiagonalRank_symm _ i j,antidiagonalRank_symm _ i.succ j.succ]
    exact carrier_rank_recurrence_le m j i h

theorem carrier_halfShape_recurrence {n : ℕ} (m : PivotVariables n →₀ ℕ) :
    halfShape (monomialCarrierEquiv n m).2 = (halfShape (Pivot.liftPivotExponent m)).tail := by
  have h := monomialCarrierEquiv_halfShape_tail m
  simpa only [halfLengths_natMonomialPairs,matchingLiftPivotExponent_eq,halfShape] using h.symm

theorem carrier_gamma_recurrence {n : ℕ} (m : PivotVariables n →₀ ℕ)
    (t : ℕ) (ht : 0 < t) :
    gamma (t+1) (Pivot.liftPivotExponent m) = gamma t (monomialCarrierEquiv n m).2 := by
  simp only [gamma,carrier_halfShape_recurrence,Nat.add_sub_cancel,List.drop_tail]
  have he : t-1+1 = t := by omega
  rw [he]

theorem not_hasForbiddenAntidiagonal_iff_ranks {n : ℕ} (r : RankArray n)
    (m : Entry n →₀ ℕ) :
    ¬HasForbiddenAntidiagonal r m ↔ ∀ i j, antidiagonalRank m i j ≤ r i j := by
  constructor
  · intro h i j
    by_contra hbad
    obtain ⟨a,b,ha,hb,hm⟩ := hasAntidiagonal_rank m i j
    exact h ⟨_,i,j,a,b,by omega,ha,hb,hm⟩
  · rintro h ⟨t,i,j,a,b,hrt,ha,hb,hm⟩
    have hle := (le_antidiagonalRank_iff m i j).mpr ⟨a,b,ha,hb,hm⟩
    have hr := h i j
    omega

/-- The exact carrier bijection preserves all northwest avoidance conditions
after decreasing the positive bounds by one. Boundary rectangles are included. -/
theorem carrier_northwest_avoidance {n : ℕ} (m : PivotVariables n →₀ ℕ)
    (r : RankArray (n+1)) (hpos : ∀ i j, 0 < r i j) :
    ¬HasForbiddenAntidiagonal r (Pivot.liftPivotExponent m) ↔
      ¬HasForbiddenAntidiagonal (Pivot.residualRankArray r) (monomialCarrierEquiv n m).2 := by
  rw [not_hasForbiddenAntidiagonal_iff_ranks,not_hasForbiddenAntidiagonal_iff_ranks]
  constructor
  · intro h i j
    rw [carrier_rank_recurrence]
    exact Nat.sub_le_sub_right (h i.succ j.succ) 1
  · intro h i j
    refine Fin.cases ?_ (fun i => ?_) i
    · have hh := antidiagonalRank_first_row_le_one (Pivot.liftPivotExponent m) j
      exact hh.trans (hpos 0 j)
    · refine Fin.cases ?_ (fun j => ?_) j
      · rw [antidiagonalRank_symm]
        exact (antidiagonalRank_first_row_le_one (Pivot.liftPivotExponent m) i.succ).trans
          (hpos i.succ 0)
      · have hh := h i j
        rw [carrier_rank_recurrence] at hh
        have hp := hpos i.succ j.succ
        change _ ≤ r i.succ j.succ-1 at hh
        omega

theorem carrier_symbolic_obstruction {n : ℕ} (m : PivotVariables n →₀ ℕ)
    (t s : ℕ) (ht : 0 < t) :
    HasSymbolicAntidiagonal (t+1) s (Pivot.liftPivotExponent m) ↔
      HasSymbolicAntidiagonal t s (monomialCarrierEquiv n m).2 := by
  rw [hasSymbolicAntidiagonal_iff_gamma _ _ _ (by omega),
    hasSymbolicAntidiagonal_iff_gamma _ _ _ ht,carrier_gamma_recurrence m t ht]

theorem carrier_mixed_obstruction {n : ℕ} (m : PivotVariables n →₀ ℕ)
    (r : RankArray (n+1)) (hpos : ∀ i j, 0 < r i j)
    (conditions : List (ℕ × ℕ)) (hvalid : ValidSymbolicConditions n conditions) :
    HasMixedObstruction r (conditions.map (fun ts => (ts.1+1,ts.2))) (Pivot.liftPivotExponent m) ↔
      HasMixedObstruction (Pivot.residualRankArray r) conditions (monomialCarrierEquiv n m).2 := by
  have hNW : HasForbiddenAntidiagonal r (Pivot.liftPivotExponent m) ↔
      HasForbiddenAntidiagonal (Pivot.residualRankArray r) (monomialCarrierEquiv n m).2 :=
    not_iff_not.mp (carrier_northwest_avoidance m r hpos)
  unfold HasMixedObstruction
  apply or_congr hNW
  constructor
  · rintro ⟨ts,hts,h⟩
    obtain ⟨uv,huv,rfl⟩ := List.mem_map.mp hts
    exact ⟨uv,huv,(carrier_symbolic_obstruction m uv.1 uv.2 (hvalid uv huv).1).mp h⟩
  · rintro ⟨ts,hts,h⟩
    exact ⟨(ts.1+1,ts.2),List.mem_map.mpr ⟨ts,hts,rfl⟩,
      (carrier_symbolic_obstruction m ts.1 ts.2 (hvalid ts hts).1).mpr h⟩

end FourPapers.Symmetric
end
