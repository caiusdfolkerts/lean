namespace FourPapers.Symmetric
open Finsupp

/-- Write the finite carrier vector as a finitely supported exponent vector,
so that the actual carrier bijection has exactly the algebraic grading type. -/
def carrierExponentEquiv (n : ℕ) :
    (PivotVariables n →₀ ℕ) ≃ (Fin n →₀ ℕ) × (Entry n →₀ ℕ) :=
  (monomialCarrierEquiv n).trans
    (Equiv.prodCongr Finsupp.equivFunOnFinite.symm (Equiv.refl _))

@[simp] theorem carrierExponentEquiv_snd {n : ℕ} (m : PivotVariables n →₀ ℕ) :
    (carrierExponentEquiv n m).2 = (monomialCarrierEquiv n m).2 := rfl

@[simp] theorem carrierExponentEquiv_fst_apply {n : ℕ}
    (m : PivotVariables n →₀ ℕ) (k : Fin n) :
    (carrierExponentEquiv n m).1 k = (monomialCarrierEquiv n m).1 k := rfl

theorem endpointWeight_apply_as_carrier_sum {n : ℕ} (m : Entry n →₀ ℕ) (k : Fin n) :
    weight endpointWeight m k = ∑ e : Entry n, m e *
      ((if e.val.2 = k then 1 else 0) + (if e.val.1 = k then 1 else 0)) := by
  classical
  simp only [weight_eq_sum,Finsupp.finsetSum_apply,Finsupp.smul_apply,
    endpointWeight,Finsupp.add_apply,Finsupp.single_apply,smul_eq_mul]
  apply Finset.sum_congr rfl
  intro e he
  congr 1
  exact Nat.add_comm _ _

theorem pivotEndpointWeight_apply_as_carrier_sum {n : ℕ}
    (m : PivotVariables n →₀ ℕ) (k : Fin n) :
    weight Pivot.pivotEndpointWeight m k = m (Sum.inl k) +
      ∑ e : Entry n, m (Sum.inr e) *
        ((if e.val.2 = k then 1 else 0) + (if e.val.1 = k then 1 else 0)) := by
  classical
  rw [weight_eq_sum,Fintype.sum_sum_type,Finsupp.add_apply]
  simp only [Finsupp.finsetSum_apply,Finsupp.smul_apply,Pivot.pivotEndpointWeight,
    Sum.elim_inl,Sum.elim_inr,endpointWeight,Finsupp.add_apply,Finsupp.single_apply,smul_eq_mul]
  rw [show (∑ i : Fin n, m (Sum.inl i) * (if i = k then 1 else 0)) = m (Sum.inl k) by simp]
  congr 1
  apply Finset.sum_congr rfl
  intro e he
  congr 1
  exact Nat.add_comm _ _

/-- Exact endpoint-multidegree preservation for the same exponent bijection
used to transport the antidiagonal obstructions. -/
theorem carrierExponentEquiv_weight {n : ℕ} (m : PivotVariables n →₀ ℕ) :
    (carrierExponentEquiv n m).1 + weight endpointWeight (carrierExponentEquiv n m).2 =
      weight Pivot.pivotEndpointWeight m := by
  ext k
  simp only [Finsupp.add_apply,carrierExponentEquiv_fst_apply,carrierExponentEquiv_snd,
    endpointWeight_apply_as_carrier_sum,pivotEndpointWeight_apply_as_carrier_sum]
  exact monomialCarrierEquiv_preserves_weight n m k

/-- The full combinatorial input to the two algebraic inductions, now proved
from paired insertion, matching-chain statistics, and explicit carrier
arithmetic. It has no field, ideal equality, or Gröbner hypothesis. -/
theorem mixedCarrierCorrespondence : Pivot.MixedCarrierCorrespondence := by
  intro n r hr hpos conditions hvalid d
  refine ⟨(carrierExponentEquiv n).subtypeEquiv ?_⟩
  intro m
  change (¬HasMixedObstruction r (conditions.map (fun ts => (ts.1+1,ts.2)))
      (Pivot.liftPivotExponent m) ∧ weight Pivot.pivotEndpointWeight m = d) ↔
    (¬HasMixedObstruction (Pivot.residualRankArray r) conditions (carrierExponentEquiv n m).2 ∧
      (carrierExponentEquiv n m).1 + weight endpointWeight (carrierExponentEquiv n m).2 = d)
  rw [carrierExponentEquiv_weight,carrierExponentEquiv_snd]
  exact and_congr (not_congr (carrier_mixed_obstruction m r hpos conditions hvalid)) Iff.rfl

theorem northwestCarrierCorrespondence : Pivot.NorthwestCarrierCorrespondence :=
  Pivot.northwestCarrierCorrespondence_of_mixed mixedCarrierCorrespondence

end FourPapers.Symmetric
end
end
