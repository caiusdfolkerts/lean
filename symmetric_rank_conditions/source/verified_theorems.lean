/- EXACT SOURCE FourPapers.Symmetric.AntidiagonalRanks -/
section

set_option autoImplicit false

/-!
# Antidiagonal ranks as actual divisibility statistics

The rank is the largest size of an increasing-row, decreasing-column antidiagonal
whose folded exponent vector is bounded by the given monomial.  In particular a
transposed pair consumes two occurrences of its common independent variable.
-/

noncomputable section

open Finset MvPolynomial

namespace FourPapers.Symmetric

variable {n k t : ℕ}

/-- Existence of a folded antidiagonal of exactly `t` entries in a northwest prefix. -/
def HasAntidiagonal (m : Entry n →₀ ℕ) (i j : Fin n) (t : ℕ) : Prop :=
  ∃ a b : Fin t ↪o Fin n, (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧
    antidiagonalExponent a b ≤ m

 theorem hasAntidiagonal_zero (m : Entry n →₀ ℕ) (i j : Fin n) :
    HasAntidiagonal m i j 0 := by
  let e : Fin 0 ↪o Fin n := OrderEmbedding.ofStrictMono Fin.elim0
    (fun a => Fin.elim0 a)
  exact ⟨e, e, (fun p => Fin.elim0 p), (fun p => Fin.elim0 p), by
    simp [antidiagonalExponent]⟩

 theorem HasAntidiagonal.size_le {m : Entry n →₀ ℕ} {i j : Fin n}
    (h : HasAntidiagonal m i j t) : t ≤ n := by
  obtain ⟨a, b, ha, hb, hm⟩ := h
  simpa using Fintype.card_le_of_injective a a.injective

/-- Reverse both source and target of an increasing embedding. -/
def reverseEmbedding (e : Fin k ↪o Fin t) : Fin k ↪o Fin t :=
  OrderEmbedding.ofStrictMono (fun p => (e p.rev).rev) (by
    intro p q hpq
    apply Fin.rev_lt_rev.mpr
    exact e.strictMono (Fin.rev_lt_rev.mpr hpq))

@[simp] theorem reverseEmbedding_apply (e : Fin k ↪o Fin t) (p : Fin k) :
    reverseEmbedding e p = (e p.rev).rev := rfl

/-- Taking any ordered subset of an antidiagonal preserves exponent divisibility. -/
theorem antidiagonalExponent_subsequence_le (a b : Fin t ↪o Fin n)
    (e : Fin k ↪o Fin t) :
    antidiagonalExponent (e.comp a) ((reverseEmbedding e).comp b) ≤
      antidiagonalExponent a b := by
  classical
  intro v
  simp only [antidiagonalExponent, Finsupp.finsetSum_apply, OrderEmbedding.coe_comp, Function.comp_apply,
    reverseEmbedding_apply, Fin.rev_rev]
  apply Finset.sum_le_sum_of_injOn e (fun _ _ _ _ h => e.injective h)
    (Finset.subset_univ _)
  · intro p hp
    exact le_rfl
  · intro p hp hpn
    exact Nat.zero_le _

/-- Every smaller size occurs by taking a sub-antidiagonal. -/
theorem HasAntidiagonal.mono_size {m : Entry n →₀ ℕ} {i j : Fin n}
    (h : HasAntidiagonal m i j t) (hkt : k ≤ t) : HasAntidiagonal m i j k := by
  obtain ⟨a, b, ha, hb, hm⟩ := h
  let e := Fin.castLEOrderEmb hkt
  exact ⟨e.comp a, (reverseEmbedding e).comp b,
    (fun p => ha _), (fun p => hb _),
    (antidiagonalExponent_subsequence_le a b e).trans hm⟩

 theorem HasAntidiagonal.mono_monomial {m m' : Entry n →₀ ℕ} {i j : Fin n}
    (h : HasAntidiagonal m i j t) (hmm' : m ≤ m') : HasAntidiagonal m' i j t := by
  obtain ⟨a, b, ha, hb, hm⟩ := h
  exact ⟨a, b, ha, hb, hm.trans hmm'⟩

 theorem HasAntidiagonal.mono_prefix {m : Entry n →₀ ℕ} {i j i' j' : Fin n}
    (h : HasAntidiagonal m i j t) (hi : i ≤ i') (hj : j ≤ j') :
    HasAntidiagonal m i' j' t := by
  obtain ⟨a, b, ha, hb, hm⟩ := h
  exact ⟨a, b, fun p => (ha p).trans hi, fun p => (hb p).trans hj, hm⟩

/-- The paper's northwest antidiagonal rank, including rank zero. -/
def antidiagonalRank (m : Entry n →₀ ℕ) (i j : Fin n) : ℕ := by
  classical
  exact Nat.findGreatest (HasAntidiagonal m i j) n

 theorem antidiagonalRank_le_size (m : Entry n →₀ ℕ) (i j : Fin n) :
    antidiagonalRank m i j ≤ n := by
  classical
  exact Nat.findGreatest_le _

 theorem hasAntidiagonal_rank (m : Entry n →₀ ℕ) (i j : Fin n) :
    HasAntidiagonal m i j (antidiagonalRank m i j) := by
  classical
  exact Nat.findGreatest_spec (Nat.zero_le n) (hasAntidiagonal_zero m i j)

 theorem le_antidiagonalRank_iff (m : Entry n →₀ ℕ) (i j : Fin n) :
    t ≤ antidiagonalRank m i j ↔ HasAntidiagonal m i j t := by
  classical
  constructor
  · exact (hasAntidiagonal_rank m i j).mono_size
  · intro h
    exact Nat.le_findGreatest h.size_le h

 theorem antidiagonalRank_le_iff (m : Entry n →₀ ℕ) (i j : Fin n) (r : ℕ) :
    antidiagonalRank m i j ≤ r ↔ ¬HasAntidiagonal m i j (r + 1) := by
  rw [← le_antidiagonalRank_iff]
  omega

 theorem antidiagonalRank_mono_monomial {m m' : Entry n →₀ ℕ} (h : m ≤ m')
    (i j : Fin n) : antidiagonalRank m i j ≤ antidiagonalRank m' i j :=
  (le_antidiagonalRank_iff m' i j).mpr ((hasAntidiagonal_rank m i j).mono_monomial h)

/-- The exponent vectors of the prescribed northwest minors. -/
def northwestExponentGenerators (r : RankArray n) : Set (Entry n →₀ ℕ) :=
  {e | ∃ (i j : Fin n) (a b : Fin (r i j + 1) ↪o Fin n),
    (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧ e = antidiagonalExponent a b}

 theorem northwestAntidiagonals_eq_image (K : Type*) [CommRing K] (r : RankArray n) :
    northwestAntidiagonals K r =
      (fun e => monomial e (1 : K)) '' northwestExponentGenerators r := by
  ext f
  constructor
  · rintro ⟨i, j, a, b, ha, hb, rfl⟩
    exact ⟨antidiagonalExponent a b, ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩
  · rintro ⟨e, ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩
    exact ⟨i, j, a, b, ha, hb, rfl⟩

/-- Membership in the actual proposed initial ideal is equivalent to violation of
one of the rank bounds; no combinatorial replacement ideal is used. -/
theorem monomial_mem_northwestAntidiagonalIdeal_iff (K : Type*) [CommRing K]
    [Nontrivial K] (r : RankArray n) (m : Entry n →₀ ℕ) :
    monomial m (1 : K) ∈ northwestAntidiagonalIdeal K r ↔
      ∃ i j, HasAntidiagonal m i j (r i j + 1) := by
  classical
  rw [northwestAntidiagonalIdeal, northwestAntidiagonals_eq_image,
    mem_ideal_span_monomial_image]
  simp only [support_monomial, one_ne_zero, ite_false, Finset.mem_singleton]
  constructor
  · intro h
    obtain ⟨e, ⟨i, j, a, b, ha, hb, rfl⟩, hm⟩ := h m rfl
    exact ⟨i, j, a, b, ha, hb, hm⟩
  · rintro ⟨i, j, a, b, ha, hb, hm⟩ e rfl
    exact ⟨antidiagonalExponent a b, ⟨i, j, a, b, ha, hb, rfl⟩, hm⟩

/-- Equation (2.1) of the paper, with all matrix sizes, exponents and rank bounds. -/
theorem monomial_standard_iff_rank_bounds (K : Type*) [CommRing K] [Nontrivial K]
    (r : RankArray n) (m : Entry n →₀ ℕ) :
    monomial m (1 : K) ∉ northwestAntidiagonalIdeal K r ↔
      ∀ i j, antidiagonalRank m i j ≤ r i j := by
  rw [monomial_mem_northwestAntidiagonalIdeal_iff]
  simp only [not_exists, antidiagonalRank_le_iff]

end FourPapers.Symmetric

end
end

/- EXACT SOURCE FourPapers.Symmetric.InsertionStatistics -/
section

set_option autoImplicit false

/-!
# Exact unbounded insertion-statistics targets

The packing statistic is defined by genuine products of folded antidiagonals
which divide the input monomial. It is independent of the insertion algorithm.
The proposition at the end is the full target of Theorem 2.1, not a proof of it.
-/

noncomputable section

namespace FourPapers.Symmetric

open Finset

variable {n : ℕ}

/-- A divisor is a product of exactly `k` antidiagonals with total degree `d`.
Size-zero factors are allowed, as in the manuscript. Every repeated folded
coordinate consumes its full exponent multiplicity in the divisor inequality. -/
def HasPackingDegree (m : Entry n →₀ ℕ) (k d : ℕ) : Prop :=
  ∃ s : Fin k → ℕ,
    ∃ a b : ∀ q, Fin (s q) ↪o Fin n,
      (∑ q, s q) = d ∧ (∑ q, antidiagonalExponent (a q) (b q)) ≤ m

 theorem HasPackingDegree.le_size {m : Entry n →₀ ℕ} {k d : ℕ}
    (h : HasPackingDegree m k d) : d ≤ k * n := by
  obtain ⟨s, a, b, hd, hm⟩ := h
  rw [← hd]
  calc
    ∑ q, s q ≤ ∑ _q : Fin k, n := by
      apply Finset.sum_le_sum
      intro q _
      simpa using Fintype.card_le_of_injective (a q) (a q).injective
    _ = k * n := by simp

 theorem hasPackingDegree_zero (m : Entry n →₀ ℕ) (k : ℕ) :
    HasPackingDegree m k 0 := by
  let e : Fin 0 ↪o Fin n := OrderEmbedding.ofStrictMono Fin.elim0
    (fun q => Fin.elim0 q)
  refine ⟨fun _ => 0, fun _ => e, fun _ => e, by simp, ?_⟩
  simp [antidiagonalExponent]

/-- The paper's `G_k`: largest degree of an actual divisor expressible as a
product of `k` antidiagonals. The bound `k*n` follows from injectivity of each
row selection; it is not a restriction on the input monomial or its degree. -/
def packingDegree (m : Entry n →₀ ℕ) (k : ℕ) : ℕ :=
  by classical exact Nat.findGreatest (HasPackingDegree m k) (k * n)

 theorem hasPackingDegree_max (m : Entry n →₀ ℕ) (k : ℕ) :
    HasPackingDegree m k (packingDegree m k) := by
  classical
  exact Nat.findGreatest_spec (Nat.zero_le _) (hasPackingDegree_zero m k)

 theorem HasPackingDegree.le_max {m : Entry n →₀ ℕ} {k d : ℕ}
    (h : HasPackingDegree m k d) : d ≤ packingDegree m k := by
  classical
  exact Nat.le_findGreatest h.le_size h

/-- The tableau after all edges with larger endpoint at most `j` have actually
been inserted. This does not replace the prefix by a statistic of the full tableau. -/
def pairedPrefixTableau (m : Entry n →₀ ℕ) (j : Fin n) : List (List (Fin n)) :=
  pairInsertList ((monomialPairs m).filter fun p => p.2 ≤ j)

/-- Number of nonempty rows after retaining entries at most `i`. For a
semistandard tableau this is the height of its actual entry-prefix subtableau. -/
def entryPrefixHeight (rows : List (List (Fin n))) (i : Fin n) : ℕ :=
  (rows.filter fun row => (row.filter fun x => x ≤ i) ≠ []).length

/-- The half-shape is read from the actual row lengths of the output. -/
def halfShape (m : Entry n →₀ ℕ) : List ℕ :=
  (pairedTableau m).map fun row => row.length / 2

/-- Complete statement target of Theorem 2.1. In particular, the prefix-rank
and packing statistics are independently defined, and the claimed bijection is
onto all semistandard tableaux of even row lengths. This definition proves none
of its constituent assertions. -/
def InsertionStatisticsAssertion : Prop :=
  ∀ n : ℕ,
    (∀ m : Entry n →₀ ℕ,
      (pairedTableau m).IsTableauRows ∧ EvenRows (pairedTableau m) ∧
      (pairedTableau m).flatten.Perm (endpointWord (monomialPairs m)) ∧
      (∀ i j : Fin n, i ≤ j →
        antidiagonalRank m i j = entryPrefixHeight (pairedPrefixTableau m j) i) ∧
      (∀ k : ℕ, packingDegree m k = ((halfShape m).map (min k)).sum)) ∧
    (∀ rows : List (List (Fin n)), rows.IsTableauRows → EvenRows rows →
      ∃! m : Entry n →₀ ℕ, pairedTableau m = rows)

end FourPapers.Symmetric

end
end

end
