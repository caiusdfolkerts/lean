noncomputable section

namespace FourPapers.Symmetric.Deformation

open MvPolynomial Finsupp

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {n : ℕ}

abbrev DeformationField := FractionRing (Polynomial ℤ)

def deformationCoefficientMap : Polynomial ℤ →+* DeformationField := algebraMap _ _

def genericParameter : DeformationFieldˣ :=
  Units.mk0 (deformationCoefficientMap Polynomial.X) (by
    intro h
    apply (Polynomial.X_ne_zero (R := ℤ))
    apply IsFractionRing.injective (Polynomial ℤ) DeformationField
    simpa only [deformationCoefficientMap, map_zero] using h)

@[simp] theorem genericParameter_coe : (genericParameter : DeformationField) =
    deformationCoefficientMap Polynomial.X := rfl

theorem deformedMixed_groebner (D : MixedDatum n) :
    (foldedOrder n).IsGroebnerBasis (deformedMixedGenerators D) (deformedMixedIdeal D) := by
  let φ := deformationCoefficientMap
  let x := genericParameter
  let u : Entry n → DeformationFieldˣ := fun i => x ^ entryWeight i
  have hG := Paper.theorem_1_2_field n DeformationField D.rank D.symmetric D.conditions D.valid
  have hscale := groebner_variableScaling (foldedOrder n) u _ _ hG
    (mixedGenerators_unit_leading DeformationField D.rank D.conditions)
  have hrel := deformed_mixed_rescaling φ x rfl D
  have hnew := groebner_unit_rescaling (foldedOrder n) _ _
    (MvPolynomial.map φ '' deformedMixedGenerators D) hscale
    (fun g hg hg0 => (foldedOrder n).isUnit_leadingCoeff.mpr hg0) hrel.1 hrel.2
  rw [hnew.ideal_eq_span] at hnew
  apply (MonomialOrder.isGroebnerBasis_map_iff (m := foldedOrder n) (φ := φ)
    (G := deformedMixedGenerators D) (I := deformedMixedIdeal D)
    (IsFractionRing.injective (Polynomial ℤ) DeformationField)
    (deformedMixedGenerators_unit_leading D) Ideal.subset_span).mp
  simpa only [deformedMixedIdeal, Ideal.map_span] using hnew

theorem deformedMixed_union_groebner (D E : MixedDatum n) :
    (foldedOrder n).IsGroebnerBasis
      (deformedMixedGenerators D ∪ deformedMixedGenerators E)
      (deformedMixedIdeal D ⊔ deformedMixedIdeal E) := by
  let φ := deformationCoefficientMap
  let x := genericParameter
  let u : Entry n → DeformationFieldˣ := fun i => x ^ entryWeight i
  have hG := mixed_union_groebner DeformationField D E
  have hscale := groebner_variableScaling (foldedOrder n) u _ _ hG
    (fun g hg hg0 => (foldedOrder n).isUnit_leadingCoeff.mpr hg0)
  rw [Set.image_union] at hscale
  have hD := deformed_mixed_rescaling φ x rfl D
  have hE := deformed_mixed_rescaling φ x rfl E
  have hHG : ∀ h ∈ (MvPolynomial.map φ '' deformedMixedGenerators D) ∪
      (MvPolynomial.map φ '' deformedMixedGenerators E),
      ∃ g ∈ (variableScaling u '' mixedGenerators DeformationField D.rank D.conditions) ∪
        (variableScaling u '' mixedGenerators DeformationField E.rank E.conditions),
      ∃ c : DeformationFieldˣ, h = (c : DeformationField) • g := by
    intro h hh
    rcases hh with hh | hh
    · obtain ⟨g, hg, c, hc⟩ := hD.1 h hh
      exact ⟨g, Or.inl hg, c, hc⟩
    · obtain ⟨g, hg, c, hc⟩ := hE.1 h hh
      exact ⟨g, Or.inr hg, c, hc⟩
  have hGH : ∀ g ∈ (variableScaling u '' mixedGenerators DeformationField D.rank D.conditions) ∪
      (variableScaling u '' mixedGenerators DeformationField E.rank E.conditions),
      ∃ h ∈ (MvPolynomial.map φ '' deformedMixedGenerators D) ∪
        (MvPolynomial.map φ '' deformedMixedGenerators E),
      ∃ c : DeformationFieldˣ, h = (c : DeformationField) • g := by
    intro g hg
    rcases hg with hg | hg
    · obtain ⟨h, hh, c, hc⟩ := hD.2 g hg
      exact ⟨h, Or.inl hh, c, hc⟩
    · obtain ⟨h, hh, c, hc⟩ := hE.2 g hg
      exact ⟨h, Or.inr hh, c, hc⟩
  have hnew := groebner_unit_rescaling (foldedOrder n) _ _ _ hscale
    (fun g hg hg0 => (foldedOrder n).isUnit_leadingCoeff.mpr hg0) hHG hGH
  have hu : ∀ f ∈ deformedMixedGenerators D ∪ deformedMixedGenerators E,
      f ≠ 0 → IsUnit ((foldedOrder n).leadingCoeff f) := by
    intro f hf hf0
    exact hf.elim (fun h => deformedMixedGenerators_unit_leading D f h hf0)
      (fun h => deformedMixedGenerators_unit_leading E f h hf0)
  rw [hnew.ideal_eq_span] at hnew
  apply (MonomialOrder.isGroebnerBasis_map_iff (m := foldedOrder n) (φ := φ)
    (G := deformedMixedGenerators D ∪ deformedMixedGenerators E)
    (I := deformedMixedIdeal D ⊔ deformedMixedIdeal E)
    (IsFractionRing.injective (Polynomial ℤ) DeformationField) hu ?_).mp
  · simpa only [deformedMixedIdeal, ← Ideal.span_union,
      Ideal.map_span, Set.image_union] using hnew
  · intro f hf
    rcases hf with h | h
    · exact (show deformedMixedIdeal D ≤ deformedMixedIdeal D ⊔ deformedMixedIdeal E
        from le_sup_left) (Ideal.subset_span h)
    · exact (show deformedMixedIdeal E ≤ deformedMixedIdeal D ⊔ deformedMixedIdeal E
        from le_sup_right) (Ideal.subset_span h)

theorem minorDeformation_homogeneous {t : ℕ} (a b : Fin t ↪o Fin n) :
    (minorDeformation a b).IsWeightedHomogeneous (fun _ : Entry n => (1 : ℕ)) t := by
  unfold minorDeformation
  apply (weightedHomogeneousSubmodule (Polynomial ℤ) (fun _ : Entry n => (1 : ℕ)) t).sum_mem
  intro π hπ
  apply isWeightedHomogeneous_monomial
  simp only [permutationExponent, map_sum, weight_single, one_nsmul,
    Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_id, mul_one]

theorem deformedMixed_homogeneous (D : MixedDatum n) :
    (deformedMixedIdeal D).IsHomogeneous
      (weightedHomogeneousSubmodule (Polynomial ℤ) (fun _ : Entry n => (1 : ℕ))) := by
  apply Ideal.homogeneous_span
  rintro f (hf | ⟨ts, hts, hf⟩)
  · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hf
    exact ⟨D.rank i j + 1, minorDeformation_homogeneous a b⟩
  · obtain ⟨k, δ, hs, hc, rfl⟩ := hf
    exact ⟨∑ j, (δ j).size, IsWeightedHomogeneous.prod _ _ _
      (fun j _ => minorDeformation_homogeneous (δ j).rows (δ j).cols)⟩

theorem specialization_one_generators (D : MixedDatum n) :
    specialization 1 '' deformedMixedGenerators D = mixedGenerators ℤ D.rank D.conditions := by
  ext f
  constructor
  · rintro ⟨g, hg, rfl⟩
    rcases hg with hg | ⟨ts, hts, hg⟩
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
      rw [minorDeformation_at_one]
      exact Or.inl ⟨i, j, a, b, ha, hb, rfl⟩
    · obtain ⟨k, δ, hs, hc, rfl⟩ := hg
      apply Or.inr
      refine ⟨ts, hts, k, δ, hs, hc, ?_⟩
      simp only [map_prod, deformedMinor, minorDeformation_at_one, MinorData.polynomial]
  · rintro (hf | ⟨ts, hts, hf⟩)
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hf
      exact ⟨minorDeformation a b, Or.inl ⟨i, j, a, b, ha, hb, rfl⟩,
        minorDeformation_at_one a b⟩
    · obtain ⟨k, δ, hs, hc, rfl⟩ := hf
      refine ⟨∏ j, deformedMinor (δ j), Or.inr ⟨ts, hts, k, δ, hs, hc, rfl⟩, ?_⟩
      simp only [map_prod, deformedMinor, minorDeformation_at_one, MinorData.polynomial]

theorem specialization_zero_minor {t : ℕ} (a b : Fin t ↪o Fin n) :
    specialization 0 (minorDeformation a b) = (foldedOrder n).leadingTerm (minor ℤ a b) := by
  rw [minorDeformation_at_zero, MonomialOrder.leadingTerm, minor_degree, minor_leadingCoeff]

theorem specialization_zero_product {k : ℕ} (δ : Fin k → MinorData n) :
    specialization 0 (∏ j, deformedMinor (δ j)) =
      (foldedOrder n).leadingTerm (∏ j, (δ j).polynomial ℤ) := by
  rw [map_prod, (foldedOrder n).leadingTerm_prod_of_regular
    (fun j _ => ((δ j).leadingCoeff_polynomial_isUnit ℤ).isRegular)]
  apply Finset.prod_congr rfl
  intro j hj
  exact specialization_zero_minor (δ j).rows (δ j).cols

theorem specialization_zero_generators (D : MixedDatum n) :
    specialization 0 '' deformedMixedGenerators D =
      (foldedOrder n).leadingTerm '' mixedGenerators ℤ D.rank D.conditions := by
  ext f
  constructor
  · rintro ⟨g, hg, rfl⟩
    rcases hg with hg | ⟨ts, hts, hg⟩
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
      exact ⟨minor ℤ a b, Or.inl ⟨i, j, a, b, ha, hb, rfl⟩,
        (specialization_zero_minor a b).symm⟩
    · obtain ⟨k, δ, hs, hc, rfl⟩ := hg
      exact ⟨∏ j, (δ j).polynomial ℤ, Or.inr ⟨ts, hts, k, δ, hs, hc, rfl⟩,
        (specialization_zero_product δ).symm⟩
  · rintro ⟨g, hg, rfl⟩
    rcases hg with hg | ⟨ts, hts, hg⟩
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
      exact ⟨minorDeformation a b, Or.inl ⟨i, j, a, b, ha, hb, rfl⟩,
        specialization_zero_minor a b⟩
    · obtain ⟨k, δ, hs, hc, rfl⟩ := hg
      exact ⟨∏ j, deformedMinor (δ j), Or.inr ⟨ts, hts, k, δ, hs, hc, rfl⟩,
        specialization_zero_product δ⟩

theorem deformedMixed_at_one (D : MixedDatum n) :
    (deformedMixedIdeal D).map (specialization 1) = mixedIntegralSpan D := by
  rw [deformedMixedIdeal, Ideal.map_span, specialization_one_generators]
  rfl

theorem deformedMixed_at_zero (D : MixedDatum n) :
    (deformedMixedIdeal D).map (specialization 0) =
      Simultaneous.orderInitialIdeal (foldedOrder n) (mixedIntegralSpan D) := by
  rw [deformedMixedIdeal, Ideal.map_span, specialization_zero_generators,
    Simultaneous.orderInitialIdeal, (mixedIntegralSpan_groebner D).span_leadingTerm_image]

theorem deformedMixed_standardMonomials (D : MixedDatum n) :
    (foldedOrder n).standardMonomials (deformedMixedIdeal D) =
      (foldedOrder n).standardMonomials (mixedIntegralSpan D) := by
  have h := (deformedMixed_groebner D).standardMonomials_map_of_unit_leading
    (Polynomial.evalRingHom (1 : ℤ)) (deformedMixedGenerators_unit_leading D)
  rw [show MvPolynomial.map (Polynomial.evalRingHom (1 : ℤ)) = specialization 1 from rfl,
    deformedMixed_at_one] at h
  exact h.symm

end FourPapers.Symmetric.Deformation

