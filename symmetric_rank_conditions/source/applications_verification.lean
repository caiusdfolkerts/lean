namespace FourPapers.Symmetric

open MvPolynomial Simultaneous

universe u
variable {n : ℕ}

theorem integralMixedIdeal_field_eq_mixedIdeal (K : Type u) [Field K]
    (D : MixedDatum n) :
    integralMixedIdeal K D.rank D.conditions = mixedIdeal K D.rank D.conditions := by
  rw [integralMixedIdeal_eq_map_span K D, mixedIntegralSpan, Ideal.map_span,
    map_mixedGenerators]
  exact (Paper.theorem_1_2_field n K D.rank D.symmetric D.conditions D.valid).ideal_eq_span.symm

/-- Evaluate a finite lattice expression using actual symbolic powers over
the given field. -/
def MixedLatticeExpression.fieldIdeal (K : Type u) [Field K] :
    MixedLatticeExpression n → Ideal (CoordinateRing n K)
  | .atom D => mixedIdeal K D.rank D.conditions
  | .sup e f => e.fieldIdeal K ⊔ f.fieldIdeal K
  | .inf e f => e.fieldIdeal K ⊓ f.fieldIdeal K

theorem MixedLatticeExpression.baseChangedIdeal_eq_fieldIdeal (K : Type u) [Field K]
    (e : MixedLatticeExpression n) : e.baseChangedIdeal K = e.fieldIdeal K := by
  induction e with
  | atom D => exact integralMixedIdeal_field_eq_mixedIdeal K D
  | sup e f he hf =>
    change e.baseChangedIdeal K ⊔ f.baseChangedIdeal K = e.fieldIdeal K ⊔ f.fieldIdeal K
    rw [he, hf]
  | inf e f he hf =>
    change e.baseChangedIdeal K ⊓ f.baseChangedIdeal K = e.fieldIdeal K ⊓ f.fieldIdeal K
    rw [he, hf]

theorem mixed_field_lattice_initial_sup (K : Type u) [Field K]
    (e f : MixedLatticeExpression n) :
    initialIdeal K (e.fieldIdeal K ⊔ f.fieldIdeal K) =
      initialIdeal K (e.fieldIdeal K) ⊔ initialIdeal K (f.fieldIdeal K) := by
  simpa only [MixedLatticeExpression.baseChangedIdeal_eq_fieldIdeal, orderInitialIdeal,
    initialIdeal] using mixed_lattice_initial_sup_after_baseChange K e f

theorem mixed_field_lattice_initial_inf (K : Type u) [Field K]
    (e f : MixedLatticeExpression n) :
    initialIdeal K (e.fieldIdeal K ⊓ f.fieldIdeal K) =
      initialIdeal K (e.fieldIdeal K) ⊓ initialIdeal K (f.fieldIdeal K) := by
  simpa only [MixedLatticeExpression.baseChangedIdeal_eq_fieldIdeal, orderInitialIdeal,
    initialIdeal] using mixed_lattice_initial_inf_after_baseChange K e f

theorem mixed_field_lattice_distributive (K : Type u) [Field K]
    (e f g : MixedLatticeExpression n) :
    e.fieldIdeal K ⊓ (f.fieldIdeal K ⊔ g.fieldIdeal K) =
      (e.fieldIdeal K ⊓ f.fieldIdeal K) ⊔ (e.fieldIdeal K ⊓ g.fieldIdeal K) := by
  simpa only [MixedLatticeExpression.baseChangedIdeal_eq_fieldIdeal] using
    mixed_lattice_distributive_after_baseChange K e f g

/-- The same integral standard exponents index the literal residue-class
monomial basis of every field evaluation of the lattice expression. -/
theorem mixed_field_lattice_monomial_basis (K : Type u) [Field K]
    (e : MixedLatticeExpression n) :
    let v : (foldedOrder n).standardMonomials e.ideal →
        CoordinateRing n K ⧸ e.fieldIdeal K :=
      fun a => Ideal.Quotient.mk _ (monomial a.val 1)
    LinearIndependent K v ∧ Submodule.span K (Set.range v) = ⊤ := by
  have h := mixed_lattice_standard_monomial_basis K e
  dsimp only at h ⊢
  rw [MixedLatticeExpression.baseChangedIdeal_eq_fieldIdeal] at h
  exact h

end FourPapers.Symmetric
