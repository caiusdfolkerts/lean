namespace FourPapers.Symmetric.Simultaneous

open MvPolynomial Finsupp Module

attribute [local instance] MvPolynomial.weightedGradedAlgebra

section BoundedDivision

variable {σ R : Type*} [CommRing R]

/-- Bounded division by a union splits a polynomial in the sum into two
summands, each with leading degree bounded by that of the original polynomial.
This is the precise bounded statement used in Lemma 6.2. -/
theorem bounded_split_of_union_groebner
    (m : MonomialOrder σ) (I J : Ideal (MvPolynomial σ R))
    (G H : Set (MvPolynomial σ R)) (hGI : G ⊆ I) (hHJ : H ⊆ J)
    (hGH : m.IsGroebnerBasis (G ∪ H) (I ⊔ J))
    {f : MvPolynomial σ R} (hf : f ∈ I ⊔ J) :
    ∃ a ∈ I, ∃ b ∈ J, a + b = f ∧
      m.toWithBotSyn (m.withBotDegree a) ≤ m.toWithBotSyn (m.withBotDegree f) ∧
      m.toWithBotSyn (m.withBotDegree b) ≤ m.toWithBotSyn (m.withBotDegree f) := by
  classical
  obtain ⟨q, hq, hdegree⟩ := (hGH.isRemainder_zero_iff_mem.mpr hf).exists_linearCombination
  let u : ↥(G ∪ H) → MvPolynomial σ R := fun g => if g.val ∈ G then q g * g.val else 0
  let v : ↥(G ∪ H) → MvPolynomial σ R := fun g => if g.val ∈ G then 0 else q g * g.val
  have hbound (g : ↥(G ∪ H)) :
      m.toWithBotSyn (m.withBotDegree (q g * g.val)) ≤
        m.toWithBotSyn (m.withBotDegree f) :=
    (m.toWithBotSyn_withBotDegree_mul_le _ _).trans
      ((add_comm _ _).trans_le (hdegree g))
  refine ⟨∑ g ∈ q.support, u g, ?_, ∑ g ∈ q.support, v g, ?_, ?_, ?_, ?_⟩
  · apply I.sum_mem
    intro g hg
    by_cases h : g.val ∈ G
    · simpa only [u, if_pos h] using I.mul_mem_left (q g) (hGI h)
    · simp only [u, if_neg h, Ideal.zero_mem]
  · apply J.sum_mem
    intro g hg
    by_cases h : g.val ∈ G
    · simp only [v, if_pos h, Ideal.zero_mem]
    · have hgH : g.val ∈ H := g.property.resolve_left h
      simpa only [v, if_neg h] using J.mul_mem_left (q g) (hHJ hgH)
  · have hrep : f = ∑ g ∈ q.support, q g * g.val := by
      simpa only [Finsupp.linearCombination_apply, Finsupp.sum, smul_eq_mul, add_zero] using hq
    rw [← Finset.sum_add_distrib]
    apply Eq.trans ?_ hrep.symm
    apply Finset.sum_congr rfl
    intro g hg
    by_cases h : g.val ∈ G <;> simp only [u, v, h, if_true, if_false, zero_add, add_zero]
  · apply m.withBotDegree_sum_le.trans
    apply Finset.sup_le
    intro g hg
    by_cases h : g.val ∈ G
    · simpa only [u, if_pos h] using hbound g
    · simp only [u, if_neg h, m.withBotDegree_zero, m.toWithBotSyn_apply_bot, bot_le]
  · apply m.withBotDegree_sum_le.trans
    apply Finset.sup_le
    intro g hg
    by_cases h : g.val ∈ G
    · simp only [v, if_pos h, m.withBotDegree_zero, m.toWithBotSyn_apply_bot, bot_le]
    · simpa only [v, if_neg h] using hbound g

/-- The bounded split may be taken in the original homogeneous degree,
regardless of whether the selected Gröbner bases are themselves homogeneous. -/
theorem bounded_homogeneous_split_of_union_groebner
    {D : Type*} [AddCommMonoid D] [DecidableEq D]
    (m : MonomialOrder σ) (I J : Ideal (MvPolynomial σ R))
    (G H : Set (MvPolynomial σ R)) (hGI : G ⊆ I) (hHJ : H ⊆ J)
    (hGH : m.IsGroebnerBasis (G ∪ H) (I ⊔ J))
    (w : σ → D) (d : D)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w))
    (hJ : J.IsHomogeneous (weightedHomogeneousSubmodule R w))
    {f : MvPolynomial σ R} (hf : f ∈ I ⊔ J) (hfd : f.IsWeightedHomogeneous w d) :
    ∃ a ∈ I, ∃ b ∈ J, a + b = f ∧ a.IsWeightedHomogeneous w d ∧
      b.IsWeightedHomogeneous w d ∧
      m.toWithBotSyn (m.withBotDegree a) ≤ m.toWithBotSyn (m.withBotDegree f) ∧
      m.toWithBotSyn (m.withBotDegree b) ≤ m.toWithBotSyn (m.withBotDegree f) := by
  obtain ⟨a, ha, b, hb, hab, hda, hdb⟩ :=
    bounded_split_of_union_groebner m I J G H hGI hHJ hGH hf
  have hbnd (p : MvPolynomial σ R) :
      m.toWithBotSyn (m.withBotDegree (weightedHomogeneousComponent w d p)) ≤
        m.toWithBotSyn (m.withBotDegree p) := by
    apply m.withBotDegree_le_withBotDegree_of_support_subset
    rw [support_weightedHomogeneousComponent]
    exact Finset.filter_subset _ _
  refine ⟨weightedHomogeneousComponent w d a,
    weightedHomogeneousComponent_mem_of_mem R w hI ha d,
    weightedHomogeneousComponent w d b,
    weightedHomogeneousComponent_mem_of_mem R w hJ hb d,
    ?_, weightedHomogeneousComponent_isWeightedHomogeneous _ _,
    weightedHomogeneousComponent_isWeightedHomogeneous _ _,
    (hbnd a).trans hda, (hbnd b).trans hdb⟩
  rw [← map_add, hab, hfd.weightedHomogeneousComponent_same]

/-- A nonstandard monomial has a homogeneous, normalized lift in its ideal.
The entire support is bounded by the prescribed monomial in the original
order. This formulation also works over a coefficient ring with zero divisors. -/
theorem homogeneous_normalized_lift
    {D : Type*} [AddCommMonoid D] [DecidableEq D]
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R)) (G : Set (MvPolynomial σ R))
    (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (w : σ → D) (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w))
    (e : σ →₀ ℕ) (he : e ∉ m.standardMonomials I) :
    ∃ p ∈ I, p.coeff e = 1 ∧ p.IsWeightedHomogeneous w (weight w e) ∧
      m.toSyn (m.degree p) ≤ m.toSyn e := by
  classical
  let f : MvPolynomial σ R := monomial e 1
  let r := hG.normalForm hu f
  have hfhom : f.IsWeightedHomogeneous w (weight w e) :=
    isWeightedHomogeneous_monomial w e 1 rfl
  have hrhom := Pivot.normalForm_isWeightedHomogeneous m I G hG hu w hI hfhom
  have hrc : r.coeff e = 0 := by
    by_contra hne
    exact he ((mem_restrictSupport_iff R).mp (hG.normalForm_mem_restrictSupport hu f)
      (MvPolynomial.mem_support_iff.mpr hne))
  have hr : m.IsRemainder f G r := hG.isRemainder_iff_eq_normalForm hu |>.mpr rfl
  obtain ⟨q, hq, hdegree⟩ := hr.exists_linearCombination
  have heq : f - r = ∑ g ∈ q.support, q g * g.val := by
    rw [hq, add_sub_cancel_right, Finsupp.linearCombination_apply, Finsupp.sum]
    rfl
  have hb : m.toWithBotSyn (m.withBotDegree (f - r)) ≤
      m.toWithBotSyn (m.withBotDegree f) := by
    rw [heq]
    apply m.withBotDegree_sum_le.trans
    apply Finset.sup_le
    intro g hg
    exact (m.toWithBotSyn_withBotDegree_mul_le _ _).trans
      ((add_comm _ _).trans_le (hdegree g))
  refine ⟨f - r, hG.sub_normalForm_mem hu f, ?_, hfhom.sub hrhom, ?_⟩
  · simp only [coeff_sub, f, coeff_monomial, ite_true, hrc, sub_zero]
  · exact ((m.withBotDegree_le_withBotDegree_iff _ _).mp hb).1.trans
      (m.degree_monomial_le _)

end BoundedDivision

end FourPapers.Symmetric.Simultaneous
end
end
