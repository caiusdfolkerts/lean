    apply Ideal.mem_map_of_mem
    change b e ∈ I.restrictScalars R
    rw [hI]
    exact Submodule.subset_span ⟨e, he, rfl⟩

/-- Intersections commute with every coefficient extension for ideals
adapted to one common basis, with no flatness assumption on `R → S`. -/
theorem coordinate_ideals_map_inf (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (I J : Ideal (MvPolynomial σ R)) (s t : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s)
    (hJ : J.restrictScalars R = coordinateSpan b t) :
    (I ⊓ J).map (MvPolynomial.map (algebraMap R S)) =
      I.map (MvPolynomial.map (algebraMap R S)) ⊓ J.map (MvPolynomial.map (algebraMap R S)) := by
  have hIJ : (I ⊓ J).restrictScalars R = coordinateSpan b (s ∩ t) := by
    rw [coordinateSpan_inter, ← hI, ← hJ]
    rfl
  have h := coordinate_ideal_map (S := S) b (I ⊓ J) (s ∩ t) hIJ
  rw [coordinateSpan_inter, ← coordinate_ideal_map (S := S) b I s hI,
    ← coordinate_ideal_map (S := S) b J t hJ] at h
  apply SetLike.coe_injective
  exact congrArg (fun N : Submodule S (MvPolynomial σ S) => (N : Set (MvPolynomial σ S))) h

/-- These quotients are free over the new coefficient ring, including after
nonflat specializations or base changes to rings with zero divisors. -/
theorem coordinate_ideal_map_quotient_free (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (I : Ideal (MvPolynomial σ R)) (s : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s) :
    Module.Free S (MvPolynomial σ S ⧸ I.map (MvPolynomial.map (algebraMap R S))) := by
  have h := coordinateQuotient_free (coefficientBasis (S := S) b) s
  rw [← coordinate_ideal_map (S := S) b I s hI] at h
  exact h

end FourPapers.Symmetric.Simultaneous

namespace FourPapers.Symmetric

open MvPolynomial Module Simultaneous

variable {n : ℕ}

def MixedLatticeExpression.baseChangedIdeal (S : Type*) [CommRing S] :
    MixedLatticeExpression n → Ideal (CoordinateRing n S)
  | .atom D => integralMixedIdeal S D.rank D.conditions
  | .sup e f => e.baseChangedIdeal S ⊔ f.baseChangedIdeal S
  | .inf e f => e.baseChangedIdeal S ⊓ f.baseChangedIdeal S

theorem integralMixedIdeal_eq_map_span (S : Type*) [CommRing S] (D : MixedDatum n) :
    integralMixedIdeal S D.rank D.conditions =
      (mixedIntegralSpan D).map (MvPolynomial.map (Int.castRingHom S)) := by
  rw [mixedIntegralSpan_eq_normalized, Ideal.map_span]
  rfl

/-- Corollary 6.3: every finite expression formed using sums and
intersections commutes with arbitrary base change from the integers. -/
theorem mixed_lattice_baseChange (S : Type*) [CommRing S]
    (e : MixedLatticeExpression n) :
    e.baseChangedIdeal S = e.ideal.map (MvPolynomial.map (Int.castRingHom S)) := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  induction e with
  | atom D => exact integralMixedIdeal_eq_map_span S D
  | sup e f he hf =>
    change e.baseChangedIdeal S ⊔ f.baseChangedIdeal S = (e.ideal ⊔ f.ideal).map _
    rw [he, hf, Ideal.map_sup]
  | inf e f he hf =>
    change e.baseChangedIdeal S ⊓ f.baseChangedIdeal S = (e.ideal ⊓ f.ideal).map _
    rw [he, hf]
    exact (coordinate_ideals_map_inf (S := S) b e.ideal f.ideal e.monomials f.monomials
      (e.adapted b hspan) (f.adapted b hspan)).symm

/-- All integral lattice quotients remain free after every base change. -/
theorem mixed_lattice_quotient_free (S : Type*) [CommRing S]
    (e : MixedLatticeExpression n) :
    Module.Free S (CoordinateRing n S ⧸ e.baseChangedIdeal S) := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  rw [mixed_lattice_baseChange S e]
  exact coordinate_ideal_map_quotient_free (S := S) b e.ideal e.monomials (e.adapted b hspan)

theorem mixed_lattice_quotient_flat (S : Type*) [CommRing S]
    (e : MixedLatticeExpression n) :
    Module.Flat S (CoordinateRing n S ⧸ e.baseChangedIdeal S) := by
  letI := mixed_lattice_quotient_free S e
  infer_instance

/-- Exact preservation of finite lattice operations by the initial ideal. -/
theorem mixed_lattice_initial_sup (e f : MixedLatticeExpression n) :
    orderInitialIdeal (foldedOrder n) (e.ideal ⊔ f.ideal) =
      orderInitialIdeal (foldedOrder n) e.ideal ⊔ orderInitialIdeal (foldedOrder n) f.ideal := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  exact triangular_ideals_initial_sup (foldedOrder n) b (fun e => ⟨(hb e).1, (hb e).2.2⟩)
    e.ideal f.ideal e.monomials f.monomials (e.adapted b hspan) (f.adapted b hspan)

theorem mixed_lattice_initial_inf (e f : MixedLatticeExpression n) :
    orderInitialIdeal (foldedOrder n) (e.ideal ⊓ f.ideal) =
      orderInitialIdeal (foldedOrder n) e.ideal ⊓ orderInitialIdeal (foldedOrder n) f.ideal := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  exact triangular_ideals_initial_inf (foldedOrder n) b (fun e => ⟨(hb e).1, (hb e).2.2⟩)
    e.ideal f.ideal e.monomials f.monomials (e.adapted b hspan) (f.adapted b hspan)

end FourPapers.Symmetric

namespace FourPapers.Symmetric

open MvPolynomial Module Simultaneous

variable {n : ℕ}

/-- The free quotient basis consists of the actual standard monomial
residue classes, uniformly even under nonflat coefficient changes. -/
theorem mixed_lattice_standard_monomial_basis (S : Type*) [CommRing S]
    (e : MixedLatticeExpression n) :
    let v : (foldedOrder n).standardMonomials e.ideal →
        CoordinateRing n S ⧸ e.baseChangedIdeal S :=
      fun a => Ideal.Quotient.mk _ (monomial a.val 1)
    LinearIndependent S v ∧ Submodule.span S (Set.range v) = ⊤ := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  have hG := triangular_ideal_groebner (foldedOrder n) b
    (fun a => ⟨(hb a).1, (hb a).2.2⟩) e.ideal e.monomials (e.adapted b hspan)
  have hu : ∀ g ∈ b '' e.monomials, g ≠ 0 → IsUnit ((foldedOrder n).leadingCoeff g) := by
    rintro _ ⟨a, ha, rfl⟩ hg0
    rw [triangular_basis_leadingCoeff (foldedOrder n) b (fun a => ⟨(hb a).1, (hb a).2.2⟩)]
    exact isUnit_one
  have h := hG.fixed_standard_basis_after_basechange (Int.castRingHom S) hu
  rw [mixed_lattice_baseChange S e]
  exact h

theorem mixed_lattice_baseChanged_adapted (S : Type*) [CommRing S]
    (b : Basis (Entry n →₀ ℕ) ℤ (CoordinateRing n ℤ))
    (hspan : ∀ D : MixedDatum n, (mixedIntegralSpan D).restrictScalars ℤ =
      coordinateSpan b ((foldedOrder n).standardMonomials (mixedIntegralSpan D))ᶜ)
    (e : MixedLatticeExpression n) :
    (e.baseChangedIdeal S).restrictScalars S =
      coordinateSpan (coefficientBasis (S := S) b) e.monomials := by
  rw [mixed_lattice_baseChange S e]
  exact coordinate_ideal_map (S := S) b e.ideal e.monomials (e.adapted b hspan)

theorem mixed_lattice_distributive_after_baseChange (S : Type*) [CommRing S]
    (e f g : MixedLatticeExpression n) :
    e.baseChangedIdeal S ⊓ (f.baseChangedIdeal S ⊔ g.baseChangedIdeal S) =
      (e.baseChangedIdeal S ⊓ f.baseChangedIdeal S) ⊔
        (e.baseChangedIdeal S ⊓ g.baseChangedIdeal S) := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  have h := coordinateSpan_inf_sup_distrib (coefficientBasis (S := S) b)
    e.monomials f.monomials g.monomials
  rw [← mixed_lattice_baseChanged_adapted S b hspan e,
    ← mixed_lattice_baseChanged_adapted S b hspan f,
    ← mixed_lattice_baseChanged_adapted S b hspan g] at h
  simp only [← Submodule.restrictScalars_inf, ← Submodule.restrictScalars_sup] at h
  apply SetLike.coe_injective
  exact congrArg (fun N : Submodule S (CoordinateRing n S) => (N : Set (CoordinateRing n S))) h

theorem coefficientBasis_triangular (S : Type*) [CommRing S]
    (b : Basis (Entry n →₀ ℕ) ℤ (CoordinateRing n ℤ))
    (hb : ∀ a, (b a).coeff a = 1 ∧
      (foldedOrder n).toSyn ((foldedOrder n).degree (b a)) ≤ (foldedOrder n).toSyn a) :
    ∀ a, (coefficientBasis (S := S) b a).coeff a = 1 ∧
      (foldedOrder n).toSyn ((foldedOrder n).degree (coefficientBasis (S := S) b a)) ≤
        (foldedOrder n).toSyn a := by
  intro a
  rw [coefficientBasis_apply]
  refine ⟨by simp only [coeff_map, (hb a).1, map_one], ?_⟩
  apply (foldedOrder n).degree_le_iff.mpr
  intro c hc
  have hc' : c ∈ (b a).support :=
    support_map_subset (algebraMap ℤ S) (b a) hc
  exact ((foldedOrder n).le_degree hc').trans (hb a).2

theorem mixed_lattice_initial_sup_after_baseChange (S : Type*) [CommRing S]
    (e f : MixedLatticeExpression n) :
    orderInitialIdeal (foldedOrder n) (e.baseChangedIdeal S ⊔ f.baseChangedIdeal S) =
      orderInitialIdeal (foldedOrder n) (e.baseChangedIdeal S) ⊔
        orderInitialIdeal (foldedOrder n) (f.baseChangedIdeal S) := by
  rcases subsingleton_or_nontrivial S with hS | hS
  · letI := hS
    exact Subsingleton.elim _ _
  · letI := hS
    obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
    exact triangular_ideals_initial_sup (foldedOrder n) (coefficientBasis (S := S) b)
      (coefficientBasis_triangular S b (fun a => ⟨(hb a).1, (hb a).2.2⟩))
      (e.baseChangedIdeal S) (f.baseChangedIdeal S) e.monomials f.monomials
      (mixed_lattice_baseChanged_adapted S b hspan e)
      (mixed_lattice_baseChanged_adapted S b hspan f)

theorem mixed_lattice_initial_inf_after_baseChange (S : Type*) [CommRing S]
    (e f : MixedLatticeExpression n) :
    orderInitialIdeal (foldedOrder n) (e.baseChangedIdeal S ⊓ f.baseChangedIdeal S) =
      orderInitialIdeal (foldedOrder n) (e.baseChangedIdeal S) ⊓
        orderInitialIdeal (foldedOrder n) (f.baseChangedIdeal S) := by
  rcases subsingleton_or_nontrivial S with hS | hS
  · letI := hS
    exact Subsingleton.elim _ _
  · letI := hS
    obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
    exact triangular_ideals_initial_inf (foldedOrder n) (coefficientBasis (S := S) b)
      (coefficientBasis_triangular S b (fun a => ⟨(hb a).1, (hb a).2.2⟩))
      (e.baseChangedIdeal S) (f.baseChangedIdeal S) e.monomials f.monomials
      (mixed_lattice_baseChanged_adapted S b hspan e)
      (mixed_lattice_baseChanged_adapted S b hspan f)

end FourPapers.Symmetric
