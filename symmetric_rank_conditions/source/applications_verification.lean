variable {n : ℕ}

theorem deformed_simultaneous_basis (n : ℕ) :
    ∃ b : Basis (Entry n →₀ ℕ) (Polynomial ℤ) (CoordinateRing n (Polynomial ℤ)),
      (∀ e, (b e).coeff e = 1 ∧
        (foldedOrder n).toSyn ((foldedOrder n).degree (b e)) ≤ (foldedOrder n).toSyn e) ∧
      ∀ D : MixedDatum n, (deformedMixedIdeal D).restrictScalars (Polynomial ℤ) =
        coordinateSpan b ((foldedOrder n).standardMonomials (mixedIntegralSpan D))ᶜ := by
  obtain ⟨b, hb, hspan⟩ := exists_polynomial_simultaneous_basis (foldedOrder n)
    deformedMixedIdeal deformedMixedGenerators deformedMixed_groebner
    deformedMixedGenerators_unit_leading deformedMixed_homogeneous deformedMixed_union_groebner
  refine ⟨b, fun e => ⟨(hb e).1, (hb e).2.2⟩, ?_⟩
  intro D
  simpa only [deformedMixed_standardMonomials D] using hspan D

def latticeDeformation : MixedLatticeExpression n → Ideal (CoordinateRing n (Polynomial ℤ))
  | .atom D => deformedMixedIdeal D
  | .sup e f => latticeDeformation e ⊔ latticeDeformation f
  | .inf e f => latticeDeformation e ⊓ latticeDeformation f

theorem latticeDeformation_adapted
    (b : Basis (Entry n →₀ ℕ) (Polynomial ℤ) (CoordinateRing n (Polynomial ℤ)))
    (hb : ∀ D : MixedDatum n, (deformedMixedIdeal D).restrictScalars (Polynomial ℤ) =
      coordinateSpan b ((foldedOrder n).standardMonomials (mixedIntegralSpan D))ᶜ) :
    ∀ e : MixedLatticeExpression n,
      (latticeDeformation e).restrictScalars (Polynomial ℤ) = coordinateSpan b e.monomials := by
  intro e
  induction e with
  | atom D => exact hb D
  | sup e f he hf =>
    change (latticeDeformation e ⊔ latticeDeformation f).restrictScalars (Polynomial ℤ) =
      coordinateSpan b (e.monomials ∪ f.monomials)
    rw [coordinateSpan_union, ← he, ← hf]
    exact Submodule.restrictScalars_sup (Polynomial ℤ) _ _
  | inf e f he hf =>
    change (latticeDeformation e ⊓ latticeDeformation f).restrictScalars (Polynomial ℤ) =
      coordinateSpan b (e.monomials ∩ f.monomials)
    rw [coordinateSpan_inter, ← he, ← hf]
    rfl

/-- Arbitrary specialization of the parameter and of the coefficient ring
commutes with intersections of all finite lattice expressions. -/
theorem latticeDeformation_map_inf (A : Type*) [CommRing A]
    (φ : Polynomial ℤ →+* A) (e f : MixedLatticeExpression n) :
    (latticeDeformation e ⊓ latticeDeformation f).map (MvPolynomial.map φ) =
      (latticeDeformation e).map (MvPolynomial.map φ) ⊓
        (latticeDeformation f).map (MvPolynomial.map φ) := by
  letI : Algebra (Polynomial ℤ) A := φ.toAlgebra
  obtain ⟨b, hb, hspan⟩ := deformed_simultaneous_basis n
  exact coordinate_ideals_map_inf (S := A) b (latticeDeformation e) (latticeDeformation f)
    e.monomials f.monomials (latticeDeformation_adapted b hspan e)
    (latticeDeformation_adapted b hspan f)

/-- The fiber at one recovers the exact original integral lattice
expression, including every intersection. -/
theorem latticeDeformation_at_one (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (specialization 1) = e.ideal := by
  induction e with
  | atom D => exact deformedMixed_at_one D
  | sup e f he hf =>
    change (latticeDeformation e ⊔ latticeDeformation f).map _ = e.ideal ⊔ f.ideal
    rw [Ideal.map_sup, he, hf]
  | inf e f he hf =>
    change (latticeDeformation e ⊓ latticeDeformation f).map _ = e.ideal ⊓ f.ideal
    have hm := latticeDeformation_map_inf ℤ (Polynomial.evalRingHom (1 : ℤ)) e f
    change (latticeDeformation e ⊓ latticeDeformation f).map (specialization 1) =
      (latticeDeformation e).map (specialization 1) ⊓
        (latticeDeformation f).map (specialization 1) at hm
    rw [hm, he, hf]

/-- The fiber at zero is the actual initial ideal of the original lattice
expression. Nilpotent monomial structure is preserved. -/
theorem latticeDeformation_at_zero (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (specialization 0) =
      orderInitialIdeal (foldedOrder n) e.ideal := by
  induction e with
  | atom D => exact deformedMixed_at_zero D
  | sup e f he hf =>
    change (latticeDeformation e ⊔ latticeDeformation f).map _ =
      orderInitialIdeal (foldedOrder n) (e.ideal ⊔ f.ideal)
    rw [Ideal.map_sup, he, hf, mixed_lattice_initial_sup]
  | inf e f he hf =>
    change (latticeDeformation e ⊓ latticeDeformation f).map _ =
      orderInitialIdeal (foldedOrder n) (e.ideal ⊓ f.ideal)
    have hm := latticeDeformation_map_inf ℤ (Polynomial.evalRingHom (0 : ℤ)) e f
    change (latticeDeformation e ⊓ latticeDeformation f).map (specialization 0) =
      (latticeDeformation e).map (specialization 0) ⊓
        (latticeDeformation f).map (specialization 0) at hm
    rw [hm, he, hf, mixed_lattice_initial_inf]

theorem latticeDeformation_groebner (e : MixedLatticeExpression n) :
    ∃ G : Set (CoordinateRing n (Polynomial ℤ)),
      (foldedOrder n).IsGroebnerBasis G (latticeDeformation e) ∧
      ∀ g ∈ G, g ≠ 0 → IsUnit ((foldedOrder n).leadingCoeff g) := by
  obtain ⟨b, hb, hspan⟩ := deformed_simultaneous_basis n
  refine ⟨b '' e.monomials,
    triangular_ideal_groebner (foldedOrder n) b hb (latticeDeformation e) e.monomials
      (latticeDeformation_adapted b hspan e), ?_⟩
  rintro _ ⟨a, ha, rfl⟩ hg0
  rw [triangular_basis_leadingCoeff (foldedOrder n) b hb]
  exact isUnit_one

theorem latticeDeformation_standardMonomials (e : MixedLatticeExpression n) :
    (foldedOrder n).standardMonomials (latticeDeformation e) =
      (foldedOrder n).standardMonomials e.ideal := by
  obtain ⟨G, hG, hu⟩ := latticeDeformation_groebner e
  have h := hG.standardMonomials_map_of_unit_leading (Polynomial.evalRingHom (1 : ℤ)) hu
  rw [show MvPolynomial.map (Polynomial.evalRingHom (1 : ℤ)) = specialization 1 from rfl,
    latticeDeformation_at_one] at h
  exact h.symm

/-- Proposition 6.4's free basis is the literal family of standard monomial
residue classes, over `ℤ[τ]` and after every specialization/base change. -/
theorem latticeDeformation_standard_basis (A : Type*) [CommRing A]
    (φ : Polynomial ℤ →+* A) (e : MixedLatticeExpression n) :
    let I := (latticeDeformation e).map (MvPolynomial.map φ)
    let v : (foldedOrder n).standardMonomials e.ideal → CoordinateRing n A ⧸ I :=
      fun a => Ideal.Quotient.mk I (monomial a.val 1)
    LinearIndependent A v ∧ Submodule.span A (Set.range v) = ⊤ := by
  obtain ⟨G, hG, hu⟩ := latticeDeformation_groebner e
  have h := hG.fixed_standard_basis_after_basechange φ hu
  rw [latticeDeformation_standardMonomials e] at h
  exact h

theorem latticeDeformation_quotient_free (A : Type*) [CommRing A]
    (φ : Polynomial ℤ →+* A) (e : MixedLatticeExpression n) :
    Module.Free A (CoordinateRing n A ⧸ (latticeDeformation e).map (MvPolynomial.map φ)) := by
  letI : Algebra (Polynomial ℤ) A := φ.toAlgebra
  obtain ⟨b, hb, hspan⟩ := deformed_simultaneous_basis n
  exact coordinate_ideal_map_quotient_free (S := A) b (latticeDeformation e) e.monomials
    (latticeDeformation_adapted b hspan e)

theorem latticeDeformation_quotient_flat (A : Type*) [CommRing A]
    (φ : Polynomial ℤ →+* A) (e : MixedLatticeExpression n) :
    Module.Flat A (CoordinateRing n A ⧸ (latticeDeformation e).map (MvPolynomial.map φ)) := by
  letI := latticeDeformation_quotient_free A φ e
  infer_instance

section UnitFibers

variable {A : Type*} [CommRing A]

theorem span_eq_of_unit_rescaling {σ : Type*} (G H : Set (MvPolynomial σ A))
    (hHG : ∀ h ∈ H, ∃ g ∈ G, ∃ c : Aˣ, h = (c : A) • g)
    (hGH : ∀ g ∈ G, ∃ h ∈ H, ∃ c : Aˣ, h = (c : A) • g) :
    Ideal.span H = Ideal.span G := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro h hh
    obtain ⟨g, hg, c, rfl⟩ := hHG h hh
    exact (Ideal.span G).smul_of_tower_mem _ (Ideal.subset_span hg)
  · apply Ideal.span_le.mpr
    intro g hg
    obtain ⟨h, hh, c, hc⟩ := hGH g hg
    have hmem := (Ideal.span H).smul_of_tower_mem ((c⁻¹ : Aˣ) : A) (Ideal.subset_span hh)
    change g ∈ Ideal.span H
    simpa only [hc, smul_smul, Units.inv_mul, one_smul] using hmem

theorem integralMixedIdeal_eq_span_mixedGenerators (D : MixedDatum n) :
    integralMixedIdeal A D.rank D.conditions = Ideal.span (mixedGenerators A D.rank D.conditions) := by
  rw [integralMixedIdeal_eq_map_span A D, mixedIntegralSpan, Ideal.map_span, map_mixedGenerators]

theorem deformedMixed_map_unit (φ : Polynomial ℤ →+* A) (x : Aˣ)
    (hx : φ Polynomial.X = (x : A)) (D : MixedDatum n) :
    (deformedMixedIdeal D).map (MvPolynomial.map φ) =
      (integralMixedIdeal A D.rank D.conditions).map
        (variableScaling (fun i : Entry n => x ^ entryWeight i)).toRingHom := by
  have hrel := deformed_mixed_rescaling φ x hx D
  rw [deformedMixedIdeal, Ideal.map_span, integralMixedIdeal_eq_span_mixedGenerators,
    Ideal.map_span]
  exact span_eq_of_unit_rescaling _ _ hrel.1 hrel.2

theorem ideal_map_inf_ringEquiv {B C : Type*} [CommRing B] [CommRing C]
    (φ : B ≃+* C) (I J : Ideal B) :
    (I ⊓ J).map φ.toRingHom = I.map φ.toRingHom ⊓ J.map φ.toRingHom := by
  ext y
  simp only [Ideal.mem_inf, Ideal.mem_map_iff_of_surjective φ.toRingHom φ.surjective]
  constructor
  · rintro ⟨x, ⟨hxI, hxJ⟩, hxy⟩
    exact ⟨⟨x, hxI, hxy⟩, ⟨x, hxJ, hxy⟩⟩
  · rintro ⟨⟨x, hxI, hxy⟩, ⟨z, hzJ, hzy⟩⟩
    have hxz := φ.injective (hxy.trans hzy.symm)
    subst z
    exact ⟨x, ⟨hxI, hzJ⟩, hxy⟩

/-- Every invertible fiber is the specified diagonal rescaling of the
original lattice expression, over an arbitrary commutative coefficient ring. -/
theorem latticeDeformation_map_unit (φ : Polynomial ℤ →+* A) (x : Aˣ)
    (hx : φ Polynomial.X = (x : A)) (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (MvPolynomial.map φ) =
      (e.baseChangedIdeal A).map
        (variableScaling (fun i : Entry n => x ^ entryWeight i)).toRingHom := by
  induction e with
  | atom D => exact deformedMixed_map_unit φ x hx D
  | sup e f he hf =>
    change (latticeDeformation e ⊔ latticeDeformation f).map _ =
      (e.baseChangedIdeal A ⊔ f.baseChangedIdeal A).map _
    rw [Ideal.map_sup, Ideal.map_sup, he, hf]
  | inf e f he hf =>
    change (latticeDeformation e ⊓ latticeDeformation f).map _ =
      (e.baseChangedIdeal A ⊓ f.baseChangedIdeal A).map _
    rw [latticeDeformation_map_inf A φ, he, hf,
      ideal_map_inf_ringEquiv (variableScaling (fun i : Entry n => x ^ entryWeight i)).toRingEquiv]

