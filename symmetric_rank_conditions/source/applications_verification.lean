namespace FourPapers.Symmetric.Deformation

open MvPolynomial Finsupp

variable {n t : ℕ} {R : Type*} [CommRing R]

theorem map_signCoefficient {A B : Type*} [CommRing A] [CommRing B]
    (φ : A →+* B) (π : Equiv.Perm (Fin t)) :
    φ (signCoefficient A π) = signCoefficient B π := by
  simp [signCoefficient, Units.smul_def]

theorem monomialScale_power (x : Rˣ) (w : Entry n → ℕ) (e : Entry n →₀ ℕ) :
    monomialScale (fun i => x ^ w i) e = x ^ weight w e := by
  classical
  simp only [monomialScale, ← pow_mul, weight_apply, Finsupp.sum, nsmul_eq_mul]
  rw [Finset.prod_pow_eq_pow_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  exact Nat.mul_comm _ _

theorem power_sub_normalization (x : Rˣ) {a b : ℕ} (hab : a ≤ b) :
    x ^ (b - a) = (x ^ a)⁻¹ * x ^ b := by
  have hpow : x ^ a * x ^ (b - a) = x ^ b := by
    rw [← pow_add, Nat.add_sub_of_le hab]
  calc
    x ^ (b - a) = (x ^ a)⁻¹ * (x ^ a * x ^ (b - a)) := by simp only [inv_mul_cancel_left]
    _ = (x ^ a)⁻¹ * x ^ b := congrArg (fun y : Rˣ => (x ^ a)⁻¹ * y) hpow

/-- At any invertible value of the parameter, the displayed deformed minor
is exactly its original minor under diagonal variable scaling, multiplied
by the prescribed inverse normalizing power. -/
theorem map_minorDeformation_unit (φ : Polynomial ℤ →+* R) (x : Rˣ)
    (hx : φ Polynomial.X = (x : R)) (a b : Fin t ↪o Fin n) :
    MvPolynomial.map φ (minorDeformation a b) =
      ((x ^ minorWeight a b)⁻¹ : Rˣ) •
        variableScaling (fun i : Entry n => x ^ entryWeight i) (minor R a b) := by
  classical
  rw [minorDeformation, map_sum, minor_eq_sum, map_sum, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro π hπ
  rw [map_monomial, map_mul, map_pow, hx, variableScaling_monomial,
    smul_monomial, Units.smul_def, smul_eq_mul]
  have hsign : φ (Polynomial.C (signCoefficient ℤ π)) = signCoefficient R π :=
    map_signCoefficient (φ.comp Polynomial.C) π
  rw [hsign, monomialScale_power, weight_permutationExponent]
  apply congrArg (monomial (permutationExponent a b π))
  have hpow := congrArg (fun z : Rˣ => (z : R))
    (power_sub_normalization x (minorWeight_le_termWeight a b π))
  simp only [Units.val_pow_eq_pow_val, Units.val_mul] at hpow
  rw [hpow]
  simp only [Units.val_pow_eq_pow_val]
  ring

def deformedMinor (δ : MinorData n) : CoordinateRing n (Polynomial ℤ) :=
  minorDeformation δ.rows δ.cols

def minorNormalizer (x : Rˣ) (δ : MinorData n) : Rˣ :=
  (x ^ minorWeight δ.rows δ.cols)⁻¹

theorem map_deformed_product (φ : Polynomial ℤ →+* R) (x : Rˣ)
    (hx : φ Polynomial.X = (x : R)) {k : ℕ} (δ : Fin k → MinorData n) :
    MvPolynomial.map φ (∏ j, deformedMinor (δ j)) =
      ((∏ j, minorNormalizer x (δ j)) : Rˣ) •
        variableScaling (fun i : Entry n => x ^ entryWeight i) (∏ j, (δ j).polynomial R) := by
  classical
  rw [map_prod, map_prod]
  simp_rw [deformedMinor, MinorData.polynomial, map_minorDeformation_unit φ x hx,
    minorNormalizer, Units.smul_def, smul_eq_C_mul]
  rw [Finset.prod_mul_distrib]
  simp only [Units.coe_prod, ← map_prod]

def deformedNorthwestGenerators (r : RankArray n) : Set (CoordinateRing n (Polynomial ℤ)) :=
  {f | ∃ (i j : Fin n) (a b : Fin (r i j + 1) ↪o Fin n),
    (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧ f = minorDeformation a b}

def deformedSymbolicGenerators (n t s : ℕ) : Set (CoordinateRing n (Polynomial ℤ)) :=
  {f | ∃ (k : ℕ) (δ : Fin k → MinorData n),
    (∀ j, t ≤ (δ j).size) ∧ (∑ j, ((δ j).size - t + 1)) = s ∧
    f = ∏ j, deformedMinor (δ j)}

def deformedMixedGenerators (D : MixedDatum n) : Set (CoordinateRing n (Polynomial ℤ)) :=
  deformedNorthwestGenerators D.rank ∪
    {f | ∃ ts ∈ D.conditions, f ∈ deformedSymbolicGenerators n ts.1 ts.2}

def deformedMixedIdeal (D : MixedDatum n) : Ideal (CoordinateRing n (Polynomial ℤ)) :=
  Ideal.span (deformedMixedGenerators D)

/-- Both directions of the literal correspondence of the displayed
families under a generic diagonal rescaling. -/
theorem deformed_mixed_rescaling (φ : Polynomial ℤ →+* R) (x : Rˣ)
    (hx : φ Polynomial.X = (x : R)) (D : MixedDatum n) :
    (∀ h ∈ MvPolynomial.map φ '' deformedMixedGenerators D,
      ∃ g ∈ variableScaling (fun i : Entry n => x ^ entryWeight i) '' mixedGenerators R D.rank D.conditions,
        ∃ c : Rˣ, h = (c : R) • g) ∧
    (∀ g ∈ variableScaling (fun i : Entry n => x ^ entryWeight i) '' mixedGenerators R D.rank D.conditions,
      ∃ h ∈ MvPolynomial.map φ '' deformedMixedGenerators D,
        ∃ c : Rˣ, h = (c : R) • g) := by
  constructor
  · rintro _ ⟨f, hf, rfl⟩
    rcases hf with hf | ⟨ts, hts, hf⟩
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hf
      refine ⟨variableScaling _ (minor R a b), ⟨minor R a b, Or.inl ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩,
        (x ^ minorWeight a b)⁻¹, ?_⟩
      exact map_minorDeformation_unit φ x hx a b
    · obtain ⟨k, δ, hs, hc, rfl⟩ := hf
      refine ⟨variableScaling _ (∏ j, (δ j).polynomial R),
        ⟨_, Or.inr ⟨ts, hts, k, δ, hs, hc, rfl⟩, rfl⟩,
        ∏ j, minorNormalizer x (δ j), ?_⟩
      exact map_deformed_product φ x hx δ
  · rintro _ ⟨g, hg, rfl⟩
    rcases hg with hg | ⟨ts, hts, hg⟩
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
      refine ⟨MvPolynomial.map φ (minorDeformation a b),
        ⟨_, Or.inl ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩,
        (x ^ minorWeight a b)⁻¹, ?_⟩
      exact map_minorDeformation_unit φ x hx a b
    · obtain ⟨k, δ, hs, hc, rfl⟩ := hg
      refine ⟨MvPolynomial.map φ (∏ j, deformedMinor (δ j)),
        ⟨_, Or.inr ⟨ts, hts, k, δ, hs, hc, rfl⟩, rfl⟩,
        ∏ j, minorNormalizer x (δ j), ?_⟩
      exact map_deformed_product φ x hx δ

theorem deformedMixedGenerators_unit_leading (D : MixedDatum n) :
    ∀ f ∈ deformedMixedGenerators D, f ≠ 0 → IsUnit ((foldedOrder n).leadingCoeff f) := by
  rintro f (hf | ⟨ts, hts, hf⟩) hf0
  · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hf
    exact minorDeformation_unit_leading a b
  · obtain ⟨k, δ, hs, hc, rfl⟩ := hf
    change IsUnit ((foldedOrder n).leadingCoeff
      (∏ j, minorDeformation (δ j).rows (δ j).cols))
    rw [(foldedOrder n).leadingCoeff_prod_of_regular
      (fun j _ => (minorDeformation_unit_leading (δ j).rows (δ j).cols).isRegular)]
    exact IsUnit.prod_iff.mpr (fun j _ => minorDeformation_unit_leading (δ j).rows (δ j).cols)

end FourPapers.Symmetric.Deformation
end
