set_option autoImplicit false
set_option maxHeartbeats 1800000

/-!
# Adding a full antidiagonal to the exact carrier sweep

The argument tracks an explicit offset through the complete carrier sweep
when a full determinant antidiagonal is added.

The source matrix has vertices `0,...,n`, with pivot `0`. On the residual
alphabet `Fin n`, the full source antidiagonal has multiplicity two at
`lower + upper + 2 = n`, or one on its diagonal, and carrier multiplicity two
at the final vertex. The residual full antidiagonal is the adjacent line
`lower + upper + 1 = n`. Every exponent of the underlying state is arbitrary.

At a cutoff `(j,i)`, stages below `j` and lower indices below `i` in stage `j`
have been processed. The explicit carrier boundary below makes the offsets of
the two carriers equal at each off-diagonal step. Therefore min commutes with
addition of this boundary. Its diagonal carrier offsets are even, so the
parity/division step also commutes. This is a proof by arbitrary-size sweep
induction, not a finite computation or an assumed commutation principle.
-/

namespace FourPapers.Symmetric.DeterminantCarrier

def addState {n : ℕ} (s t : ExactCarrierState n) : ExactCarrierState n :=
  (fun k => s.1 k + t.1 k, fun e => s.2 e + t.2 e)

def scaleState {n : ℕ} (b : ℕ) (s : ExactCarrierState n) : ExactCarrierState n :=
  (fun k => b * s.1 k, fun e => b * s.2 e)

/-- Multiplicity of a folded antidiagonal on one of the two adjacent lines. -/
def antiOffset (n a : ℕ) (e : MatchingEntry n) : ℕ :=
  if e.val.2.val + e.val.1.val + a = n then
    if e.val.2.val = e.val.1.val then 1 else 2
  else 0

/-- Offset in a carrier immediately before lower index `i` of upper stage `j`. -/
def carrierOffset (n j i k : ℕ) : ℕ :=
  if j < k then
    if k + 1 = n then 2 else 0
  else if k = j then
    if i + j + 1 = n then 2 else 0
  else if (k + j + 1 = n ∧ i ≤ k) ∨ (k + j + 2 = n ∧ k < i) then 2 else 0

/-- Processed entries carry the residual antidiagonal; unprocessed entries
still carry the source antidiagonal. -/
def entryOffset (n j i : ℕ) (e : MatchingEntry n) : ℕ :=
  if e.val.1.val < j ∨ (e.val.1.val = j ∧ e.val.2.val < i) then
    antiOffset n 1 e
  else antiOffset n 2 e

def cut (n j i : ℕ) : ExactCarrierState n :=
  (fun k => carrierOffset n j i k.val, entryOffset n j i)

def sourceAntidiagonal (n : ℕ) : ExactCarrierState n :=
  (fun k => if k.val + 1 = n then 2 else 0, antiOffset n 2)

def residualAntidiagonal (n : ℕ) : ExactCarrierState n :=
  (fun _ => 0, antiOffset n 1)

theorem carrierOffset_upper (n j i : ℕ) :
    carrierOffset n j i j = if i+j+1=n then 2 else 0 := by
  simp [carrierOffset]

theorem carrierOffset_lower {n j i : ℕ} (hi : i < j) :
    carrierOffset n j i i = if i+j+1=n then 2 else 0 := by
  unfold carrierOffset
  split_ifs <;> omega

theorem carrierOffset_lower_after {n j i : ℕ} (hi : i < j) :
    carrierOffset n j (i+1) i = if i+j+2=n then 2 else 0 := by
  unfold carrierOffset
  split_ifs <;> omega

theorem carrierOffset_upper_after (n j i : ℕ) :
    carrierOffset n j (i+1) j = if i+j+2=n then 2 else 0 := by
  unfold carrierOffset
  split_ifs <;> omega

theorem carrierOffset_off_fixed {n j i k : ℕ} (hki : k ≠ i) (hkj : k ≠ j) :
    carrierOffset n j (i+1) k = carrierOffset n j i k := by
  unfold carrierOffset
  split_ifs <;> omega

theorem carrierOffset_diagonal_after (n j : ℕ) :
    carrierOffset n (j+1) 0 j = if j+j+2=n then 2 else 0 := by
  unfold carrierOffset
  split_ifs <;> omega

theorem carrierOffset_diagonal_fixed {n j k : ℕ} (hkj : k ≠ j) :
    carrierOffset n (j+1) 0 k = carrierOffset n j j k := by
  unfold carrierOffset
  split_ifs <;> omega

theorem cut_initial (n : ℕ) : cut n 0 0 = sourceAntidiagonal n := by
  apply Prod.ext
  · funext k
    dsimp [cut,sourceAntidiagonal]
    unfold carrierOffset
    split_ifs <;> omega
  · funext e
    simp [cut,sourceAntidiagonal,entryOffset]

theorem cut_final (n : ℕ) : cut n n 0 = residualAntidiagonal n := by
  apply Prod.ext
  · funext k
    have hk := k.isLt
    dsimp [cut,residualAntidiagonal]
    unfold carrierOffset
    split_ifs <;> omega
  · funext e
    simp [cut,residualAntidiagonal,entryOffset,e.val.1.isLt]

/-- Equal increments of the two carriers pass through an off-diagonal update
without any restriction on the original carriers or entry multiplicity. -/
theorem off_add {n : ℕ} (e : MatchingEntry n) (s t : ExactCarrierState n)
    (he : e.val.2 ≠ e.val.1) (ht : t.1 e.val.2 = t.1 e.val.1) :
    exactOffDiagonal e (addState s t) =
      addState (exactOffDiagonal e s) (exactOffDiagonal e t) := by
  have h : offDiagonalCarrier
      (s.1 e.val.2 + t.1 e.val.2, s.1 e.val.1 + t.1 e.val.1, s.2 e + t.2 e) =
      let u := offDiagonalCarrier (s.1 e.val.2,s.1 e.val.1,s.2 e)
      let v := offDiagonalCarrier (t.1 e.val.2,t.1 e.val.1,t.2 e)
      (u.1+v.1,u.2.1+v.2.1,u.2.2+v.2.2) := by
    dsimp [offDiagonalCarrier]
    apply Prod.ext
    · omega
    · apply Prod.ext <;> dsimp only <;> omega
  apply Prod.ext
  · funext k
    by_cases hki : k = e.val.2
    · subst k
      simpa [exactOffDiagonal,addState,he,he.symm] using congrArg Prod.fst h
    · by_cases hkj : k = e.val.1
      · subst k
        simpa [exactOffDiagonal,addState,he,he.symm] using
          congrArg (fun x : ℕ × ℕ × ℕ => x.2.1) h
      · simp [exactOffDiagonal,addState,hki,hkj]
  · funext f
    by_cases hf : f = e
    · subst f
      simpa [exactOffDiagonal,addState] using
        congrArg (fun x : ℕ × ℕ × ℕ => x.2.2) h
    · simp [exactOffDiagonal,addState,hf]

/-- An even increment of the carrier passes through the parity/division step.
The original carrier is not required to be even. -/
theorem diagonal_add {n : ℕ} (e : MatchingEntry n) (s t : ExactCarrierState n)
    (ht : Even (t.1 e.val.2)) :
    exactDiagonal e (addState s t) =
      addState (exactDiagonal e s) (exactDiagonal e t) := by
  obtain ⟨d,hd⟩ := ht
  have h : diagonalCarrier (s.1 e.val.2+t.1 e.val.2,s.2 e+t.2 e) =
      let u := diagonalCarrier (s.1 e.val.2,s.2 e)
      let v := diagonalCarrier (t.1 e.val.2,t.2 e)
      (u.1+v.1,u.2+v.2) := by
    dsimp [diagonalCarrier]
    apply Prod.ext <;> omega
  apply Prod.ext
  · funext k
    by_cases hk : k = e.val.2
    · subst k
      simpa [exactDiagonal,addState] using congrArg Prod.fst h
    · simp [exactDiagonal,addState,hk]
  · funext f
    by_cases hf : f = e
    · subst f
      simpa [exactDiagonal,addState] using congrArg Prod.snd h
    · simp [exactDiagonal,addState,hf]

theorem entryOffset_off_fixed {n : ℕ} (j : Fin n) (i : Fin j.val)
    (f : MatchingEntry n) (hf : f ≠ carrierOffEntry j i) :
    entryOffset n j.val (i.val+1) f = entryOffset n j.val i.val f := by
  have hn : ¬(f.val.1.val = j.val ∧ f.val.2.val = i.val) := by
    rintro ⟨hu,hl⟩
    apply hf
    apply Subtype.ext
    exact Prod.ext (Fin.ext hu) (Fin.ext hl)
  have hp : (f.val.1.val < j.val ∨
      (f.val.1.val = j.val ∧ f.val.2.val < i.val+1)) ↔
      (f.val.1.val < j.val ∨ (f.val.1.val = j.val ∧ f.val.2.val < i.val)) := by omega
  simp only [entryOffset,hp]

theorem entryOffset_diagonal_fixed {n : ℕ} (j : Fin n)
    (f : MatchingEntry n) (hf : f ≠ carrierDiagonalEntry j) :
    entryOffset n (j.val+1) 0 f = entryOffset n j.val j.val f := by
  have hn : ¬(f.val.1.val = j.val ∧ f.val.2.val = j.val) := by
    rintro ⟨hu,hl⟩
    apply hf
    apply Subtype.ext
    exact Prod.ext (Fin.ext hu) (Fin.ext hl)
  have hle : f.val.2.val ≤ f.val.1.val := f.property
  have hp : (f.val.1.val < j.val+1 ∨
      (f.val.1.val = j.val+1 ∧ f.val.2.val < 0)) ↔
      (f.val.1.val < j.val ∨ (f.val.1.val = j.val ∧ f.val.2.val < j.val)) := by omega
  simp only [entryOffset,hp]

/-- The offset itself advances through one off-diagonal cell. -/
theorem off_cut {n : ℕ} (j : Fin n) (i : Fin j.val) :
    exactOffDiagonal (carrierOffEntry j i) (cut n j.val i.val) =
      cut n j.val (i.val+1) := by
  let e := carrierOffEntry j i
  have he : e.val.2 ≠ e.val.1 := by
    intro h
    have hv := congrArg Fin.val h
    have hi := i.isLt
    change i.val = j.val at hv
    omega
  have hl : (cut n j.val i.val).1 e.val.2 =
      if i.val+j.val+1=n then 2 else 0 := carrierOffset_lower i.isLt
  have hu : (cut n j.val i.val).1 e.val.1 =
      if i.val+j.val+1=n then 2 else 0 := carrierOffset_upper n j.val i.val
  have hr : (cut n j.val i.val).2 e =
      if i.val+j.val+2=n then 2 else 0 := by
    simp [cut,entryOffset,antiOffset,e,carrierOffEntry,carrierLowerIndex,i.isLt.ne]
  have hl' : (cut n j.val (i.val+1)).1 e.val.2 =
      if i.val+j.val+2=n then 2 else 0 := carrierOffset_lower_after i.isLt
  have hu' : (cut n j.val (i.val+1)).1 e.val.1 =
      if i.val+j.val+2=n then 2 else 0 := carrierOffset_upper_after n j.val i.val
  have hr' : (cut n j.val (i.val+1)).2 e =
      if i.val+j.val+1=n then 2 else 0 := by
    simp [cut,entryOffset,antiOffset,e,carrierOffEntry,carrierLowerIndex,i.isLt.ne]
  apply Prod.ext
  · funext k
    by_cases hki : k = e.val.2
    · subst k
      rw [exactOffDiagonal_lower e _ he,hl,hu,hr,hl']
      simp
    · by_cases hkj : k = e.val.1
      · subst k
        rw [exactOffDiagonal_upper,hl,hu,hr,hu']
        simp
      · have hkiv : k.val ≠ i.val := fun h => hki (Fin.ext h)
        have hkjv : k.val ≠ j.val := fun h => hkj (Fin.ext h)
        change (exactOffDiagonal e (cut n j.val i.val)).1 k =
          (cut n j.val (i.val+1)).1 k
        rw [← exactCarrierStep_off e _ he, exactCarrierStep_fst_fixed e _ k hkj hki]
        exact (carrierOffset_off_fixed (n := n) hkiv hkjv).symm
  · funext f
    by_cases hf : f = e
    · subst f
      rw [exactOffDiagonal_entry,hl,hu,hr']
      simp
    · change (exactOffDiagonal e (cut n j.val i.val)).2 f =
        (cut n j.val (i.val+1)).2 f
      rw [← exactCarrierStep_off e _ he, exactCarrierStep_snd_fixed e f _ hf]
      exact (entryOffset_off_fixed j i f hf).symm

/-- The offset advances through the diagonal, including both parity boundaries. -/
theorem diagonal_cut {n : ℕ} (j : Fin n) :
    exactDiagonal (carrierDiagonalEntry j) (cut n j.val j.val) =
      cut n (j.val+1) 0 := by
  let e := carrierDiagonalEntry j
  have hc : (cut n j.val j.val).1 j =
      if j.val+j.val+1=n then 2 else 0 := carrierOffset_upper n j.val j.val
  have hr : (cut n j.val j.val).2 e =
      if j.val+j.val+2=n then 1 else 0 := by
    simp [cut,entryOffset,antiOffset,e,carrierDiagonalEntry]
  have hc' : (cut n (j.val+1) 0).1 j =
      if j.val+j.val+2=n then 2 else 0 := carrierOffset_diagonal_after n j.val
  have hr' : (cut n (j.val+1) 0).2 e =
      if j.val+j.val+1=n then 1 else 0 := by
    simp [cut,entryOffset,antiOffset,e,carrierDiagonalEntry]
  apply Prod.ext
  · funext k
    by_cases hk : k = j
    · subst k
      simp only [exactDiagonal,e,carrierDiagonalEntry,Function.update_self,diagonalCarrier]
      change (cut n j.val j.val).1 j % 2 + 2*(cut n j.val j.val).2 e = _
      rw [hc,hr,hc']
      split_ifs <;> omega
    · simp only [exactDiagonal,e,carrierDiagonalEntry,Function.update_of_ne hk]
      have hkv : k.val ≠ j.val := fun h => hk (Fin.ext h)
      exact (carrierOffset_diagonal_fixed hkv).symm
  · funext f
    by_cases hf : f = e
    · subst f
      change (exactDiagonal e (cut n j.val j.val)).2 e =
        (cut n (j.val+1) 0).2 e
      simp only [exactDiagonal,Function.update_self,diagonalCarrier]
      change (cut n j.val j.val).1 j / 2 = _
      rw [hc,hr']
      split_ifs <;> omega
    · change (exactDiagonal e (cut n j.val j.val)).2 f =
        (cut n (j.val+1) 0).2 f
      rw [← exactCarrierStep_diag e _ rfl, exactCarrierStep_snd_fixed e f _ hf]
      exact (entryOffset_diagonal_fixed j f hf).symm

theorem off_translation {n : ℕ} (j : Fin n) (i : Fin j.val) (s : ExactCarrierState n) :
    exactCarrierStep (carrierOffEntry j i) (addState s (cut n j.val i.val)) =
      addState (exactCarrierStep (carrierOffEntry j i) s) (cut n j.val (i.val+1)) := by
  have he : (carrierOffEntry j i).val.2 ≠ (carrierOffEntry j i).val.1 := by
    intro h
    have hv := congrArg Fin.val h
    have hi := i.isLt
    change i.val = j.val at hv
    omega
  rw [exactCarrierStep_off _ _ he,exactCarrierStep_off _ _ he]
  rw [off_add _ _ _ he,off_cut]
  change carrierOffset n j.val i.val i.val = carrierOffset n j.val i.val j.val
  rw [carrierOffset_lower i.isLt,carrierOffset_upper]

theorem diagonal_translation {n : ℕ} (j : Fin n) (s : ExactCarrierState n) :
    exactCarrierStep (carrierDiagonalEntry j) (addState s (cut n j.val j.val)) =
      addState (exactCarrierStep (carrierDiagonalEntry j) s) (cut n (j.val+1) 0) := by
  have ht : Even ((cut n j.val j.val).1 j) := by
    change Even (carrierOffset n j.val j.val j.val)
    rw [carrierOffset_upper]
    split_ifs
    · exact ⟨1,rfl⟩
    · exact ⟨0,rfl⟩
  have hd (u : ExactCarrierState n) :
      exactCarrierStep (carrierDiagonalEntry j) u = exactDiagonal (carrierDiagonalEntry j) u := by
    exact exactCarrierStep_diag _ _ rfl
  rw [hd,hd,diagonal_add _ _ _ ht,diagonal_cut]

/-- Prefix induction over the actual increasing list of lower endpoints. -/
theorem off_prefix {n : ℕ} (j : Fin n) :
    ∀ q, q ≤ j.val → ∀ s : ExactCarrierState n,
      exactCarrierSequence ((carrierOffEntries j).take q) (addState s (cut n j.val 0)) =
        addState (exactCarrierSequence ((carrierOffEntries j).take q) s) (cut n j.val q) := by
  intro q
  induction q with
  | zero =>
    intro hq s
    simp only [List.take_zero,exactCarrierSequence,Equiv.refl_apply]
  | succ q ih =>
    intro hq s
    have hqj : q < j.val := by omega
    have ht : (carrierOffEntries j).take (q+1) =
        (carrierOffEntries j).take q ++ [carrierOffEntry j ⟨q,hqj⟩] := by
      rw [List.take_succ_eq_append_getElem (by simpa [carrierOffEntries] using hqj)]
      simp only [carrierOffEntries,List.getElem_ofFn]
    rw [ht,exactCarrierSequence_append_apply,exactCarrierSequence_append_apply]
    simp only [exactCarrierSequence,Equiv.trans_apply,Equiv.refl_apply]
    rw [ih (by omega) s,off_translation]

theorem full_stage {n : ℕ} (j : Fin n) (s : ExactCarrierState n) :
    exactCarrierSequence (carrierFullStage j) (addState s (cut n j.val 0)) =
      addState (exactCarrierSequence (carrierFullStage j) s) (cut n (j.val+1) 0) := by
  have h := off_prefix j j.val le_rfl s
  have ht : (carrierOffEntries j).take j.val = carrierOffEntries j :=
    List.take_of_length_le (by simp [carrierOffEntries])
  rw [ht] at h
  rw [carrierFullStage,exactCarrierSequence_append_apply,exactCarrierSequence_append_apply]
  simp only [exactCarrierSequence,Equiv.trans_apply,Equiv.refl_apply]
  rw [h,diagonal_translation]

/-- Full induction over all upper endpoint stages, without an alphabet-size bound. -/
theorem sweep_cut (n : ℕ) :
    ∀ q, q ≤ n → ∀ s : ExactCarrierState n,
      exactCarrierSequence (carrierEntriesBefore n q) (addState s (cut n 0 0)) =
        addState (exactCarrierSequence (carrierEntriesBefore n q) s) (cut n q 0) := by
  intro q
  induction q with
  | zero =>
    intro hq s
    simp only [carrierEntriesBefore,List.take_zero,List.flatMap_nil,
      exactCarrierSequence,Equiv.refl_apply]
  | succ q ih =>
    intro hq s
    have hqn : q < n := by omega
    rw [carrierEntriesBefore_succ hqn,exactCarrierSequence_append_apply,
      exactCarrierSequence_append_apply,ih (by omega) s,full_stage]

/-- Adding the source full antidiagonal leaves the final carrier vector unchanged
and adds precisely the full residual antidiagonal. This holds for every natural
state, including arbitrary repeated edges and loops. For `n=0` both coordinate
spaces are empty; the one-vertex determinant itself is the omitted pivot loop. -/
theorem sweep_add_antidiagonal (n : ℕ) (s : ExactCarrierState n) :
    exactCarrierEquiv n (addState s (sourceAntidiagonal n)) =
      addState (exactCarrierEquiv n s) (residualAntidiagonal n) := by
  have h := sweep_cut n n le_rfl s
  rw [carrierEntriesBefore_full,cut_initial,cut_final] at h
  exact h

/-- The same exact identity for every power of the determinant antidiagonal. -/
theorem sweep_add_antidiagonal_power (n b : ℕ) (s : ExactCarrierState n) :
    exactCarrierEquiv n (addState s (scaleState b (sourceAntidiagonal n))) =
      addState (exactCarrierEquiv n s) (scaleState b (residualAntidiagonal n)) := by
  induction b with
  | zero => simp [addState,scaleState]
  | succ b ih =>
    have hi : addState s (scaleState (b+1) (sourceAntidiagonal n)) =
        addState (addState s (scaleState b (sourceAntidiagonal n))) (sourceAntidiagonal n) := by
      apply Prod.ext <;> funext k <;> simp [addState,scaleState,Nat.succ_mul,Nat.add_assoc]
    rw [hi,sweep_add_antidiagonal,ih]
    apply Prod.ext <;> funext k <;> simp [addState,scaleState,Nat.succ_mul,Nat.add_assoc]

end FourPapers.Symmetric.DeterminantCarrier
end
