  simp only [coefficientBasis, Basis.map_apply, Basis.baseChange_apply,
    AlgEquiv.coe_toLinearEquiv, MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]

/-- Actual coefficient extension of an ideal adapted to a basis is the
span of the same basis indices after extension. This is an equality of
submodules of `S[X]`, not merely an abstract tensor-product isomorphism. -/
theorem coordinate_ideal_map (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (I : Ideal (MvPolynomial σ R)) (s : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s) :
    (I.map (MvPolynomial.map (algebraMap R S))).restrictScalars S =
      coordinateSpan (coefficientBasis (S := S) b) s := by
