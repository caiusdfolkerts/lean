        (latticeDeformation f).map (MvPolynomial.map φ) :=
  latticeDeformation_map_inf A φ e f

example {n : ℕ} (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (specialization 1) = e.ideal :=
  latticeDeformation_at_one e

example {n : ℕ} (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (specialization 0) =
      Simultaneous.orderInitialIdeal (foldedOrder n) e.ideal :=
  latticeDeformation_at_zero e

/-- The fibers after arbitrary change of coefficient ring. -/
example {n : ℕ} (A : Type u_target) [CommRing A]
    (e : MixedLatticeExpression n) :
    (latticeDeformation e).map
        (MvPolynomial.map (Polynomial.eval₂RingHom (Int.castRingHom A) (1 : A))) =
      e.baseChangedIdeal A :=
  latticeDeformation_at_one_after_baseChange A e

example {n : ℕ} (A : Type u_target) [CommRing A]
    (e : MixedLatticeExpression n) :
    (latticeDeformation e).map
        (MvPolynomial.map (Polynomial.eval₂RingHom (Int.castRingHom A) (0 : A))) =
      Simultaneous.orderInitialIdeal (foldedOrder n) (e.baseChangedIdeal A) :=
  latticeDeformation_at_zero_after_baseChange A e

/-- Every unit parameter fiber is the specified invertible diagonal rescaling. -/
example {n : ℕ} {A : Type u_target} [CommRing A]
    (φ : Polynomial ℤ →+* A) (x : Aˣ) (hx : φ Polynomial.X = (x : A))
    (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (MvPolynomial.map φ) =
      (e.baseChangedIdeal A).map
        (variableScaling (fun i : Entry n => x ^ ((i.val.1.val + 1) *
          (i.val.2.val + 1)))).toRingHom :=
  latticeDeformation_map_unit φ x hx e

end FourPapers.Symmetric.SectionSixStatementAudit
end

/-! ## Section 7: literal symbolic Rees and joint SAGBI statements -/

noncomputable section
namespace FourPapers.Symmetric
universe applications_audit_u applications_audit_v

/-- Corollary 7.1: the exact finite single-grading collection. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K] (t : ℕ) (ht : 0 < t) (htn : t ≤ n) :
    (Rees.singleGenerators (n := n) K t).Finite ∧
      Rees.IsSagbiBasis (foldedOrder n) (Rees.determinantalSymbolicRees n K t ht)
        (Rees.singleGenerators K t) :=
  Rees.corollary_7_1_sagbi n K t ht htn

/-- The same corollary's literal monomial basis, with every score and exponent. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K] (t : ℕ) (ht : 0 < t) (htn : t ≤ n) :
    Module.Basis {p : (Entry n →₀ ℕ) × ℕ // p.2 ≤ gamma t p.1} K
      (Rees.initialAlgebra (foldedOrder n) (Rees.determinantalSymbolicRees n K t ht)) :=
  Rees.corollary_7_1_monomialBasis n K t ht htn

/-- Proposition 7.3: no bound on either symbolic exponent or the polynomial. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K] (r : ℕ) (hr : 0 < r) (hrn : r ≤ n)
    (a b : ℕ) (f : CoordinateRing n K) :
    fullDeterminant n K ^ b * f ∈ symbolicPower (determinantalIdeal n K r) a ↔
      f ∈ symbolicPower (determinantalIdeal n K r) (a - b * (n-r+1)) :=
  fullDeterminant_pow_mul_mem_symbolicPower_iff n K r hr hrn a b f

/-- The actual symbolic-ideal identity in the proposition. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K] (r : ℕ) (hr : 0 < r) (hrn : r ≤ n)
    (a b : ℕ) :
    symbolicPower (determinantalIdeal n K r) a ⊓ symbolicPower (determinantalIdeal n K n) b =
      Ideal.span {fullDeterminant n K ^ b} *
        symbolicPower (determinantalIdeal n K r) (a - b * (n-r+1)) :=
  symbolicPower_inter_fullDeterminantal n K r hr hrn a b

/-- The paper's score formula for the literal full antidiagonal exponent. -/
example (n r : ℕ) (hr : 0 < r) (hrn : r ≤ n) (m : Entry n →₀ ℕ) (b : ℕ) :
    gamma r (b • fullAntidiagonalExponent n + m) = b * (n-r+1) + gamma r m := by
  simpa only [add_comm] using gamma_add_determinant_antidiagonal n r hr hrn m b

namespace JointSagbi

/-- Proposition 7.3: the full finite proposed collection for every allowed order. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K] (r : ℕ) (hr : 0 < r) (hrn : r ≤ n)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    (minorGenerators n K r n).Finite ∧
      IsSagbiBasis ω (determinantalJointRees n K r n hr (hr.trans_le hrn))
        (minorGenerators n K r n) :=
  ⟨minorGenerators_finite (n := n) K r n, proposition_7_3_sagbi K r hr hrn ω hω⟩

/-- The smaller collection displayed in the same proposition is itself finite and SAGBI. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K] (r : ℕ) (hr : 0 < r) (hrn : r ≤ n)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    (determinantGenerators (n := n) K r).Finite ∧
      IsSagbiBasis ω (determinantalJointRees n K r n hr (hr.trans_le hrn))
        (determinantGenerators (n := n) K r) :=
  ⟨determinantGenerators_finite K r, determinantGenerators_sagbi K r hr hrn ω hω⟩

/-- Proposition 7.4: every field, every t≥4, every n≥t+1, every allowed order. -/
example (n t : ℕ) (K : Type applications_audit_u) [Field K] (ht : 4 ≤ t) (hn : t+1 ≤ n)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    ¬ IsSagbiBasis ω (determinantalJointRees n K 2 t (by omega) (by omega))
      (minorGenerators n K 2 t) :=
  not_isSagbiBasis_two_threshold n t K ht hn ω hω

/-- The exact valid-size boundary, stated independently of its proof. -/
example (n t : ℕ) (K : Type applications_audit_u) [Field K]
    (ht : 4 ≤ t) (htn : t ≤ n)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    IsSagbiBasis ω (determinantalJointRees n K 2 t (by omega) (by omega))
      (minorGenerators n K 2 t) ↔ n = t :=
  joint_minor_sagbi_iff_full_size n t K ht htn ω hω

/-- Both algebra-generation equalities in the paper's leading-monomial convention. -/
example {K : Type applications_audit_u} [Field K] {σ : Type applications_audit_v}
    (ω : MonomialOrder (Variables σ))
    (S : Subalgebra K (Ring σ K)) (G : Set (Ring σ K)) :
    IsSagbiBasis ω S G ↔
      Algebra.adjoin K G = S ∧
        Algebra.adjoin K (leadingMonomial ω '' G) =
          Algebra.adjoin K (leadingMonomial ω '' (S : Set (Ring σ K))) :=
  isSagbiBasis_iff_leadingMonomials ω S G

end JointSagbi

/-- The single Rees initial-algebra basis vectors are literal tagged monomials. -/
example (n : ℕ) (K : Type applications_audit_u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n)
    (p : {p : (Entry n →₀ ℕ) × ℕ // p.2 ≤ gamma t p.1}) :
    (Rees.corollary_7_1_monomialBasis n K t ht htn p : Polynomial (CoordinateRing n K)) =
      Polynomial.monomial p.val.2 (MvPolynomial.monomial p.val.1 1) :=
  Rees.corollary_7_1_monomialBasis_apply n K t ht htn p

end FourPapers.Symmetric
end

