open MvPolynomial

/-- Clearing the paper's displayed normalizing denominator gives the
literal determinant of the weighted generic symmetric matrix. This
identifies the Leibniz-sum definition with its stated closed formula. -/
theorem minorDeformation_normalized_determinant {n t : ℕ}
    (a b : Fin t ↪o Fin n) :
    C (Polynomial.X ^ minorWeight a b) * minorDeformation a b =
      Matrix.det (Matrix.of (fun i j : Fin t =>
        C (Polynomial.X ^ (((a i).val + 1) * ((b j).val + 1))) *
          (X (fold (a i) (b j)) : CoordinateRing n (Polynomial ℤ)))) := by
  let φ := deformationCoefficientMap
  let x := genericParameter
  let u : Entry n → DeformationFieldˣ := fun i => x ^ entryWeight i
  apply MvPolynomial.map_injective φ (IsFractionRing.injective (Polynomial ℤ) DeformationField)
  rw [map_mul, map_C, map_pow, map_minorDeformation_unit φ x rfl]
  have hdet : MvPolynomial.map φ
      (Matrix.det (Matrix.of (fun i j : Fin t =>
        C (Polynomial.X ^ (((a i).val + 1) * ((b j).val + 1))) *
          (X (fold (a i) (b j)) : CoordinateRing n (Polynomial ℤ))))) =
      variableScaling u (minor DeformationField a b) := by
    rw [minor, RingHom.map_det, AlgEquiv.map_det]
    congr 1
    funext i j
    simp only [RingHom.mapMatrix_apply, AlgEquiv.mapMatrix_apply, Matrix.map_apply,
      Matrix.of_apply, Matrix.submatrix_apply, genericMatrix_apply,
      map_mul, map_C, map_pow, map_X]
    rw [← map_pow]
    change C ((x : DeformationField) ^ (((a i).val + 1) * ((b j).val + 1))) *
        X (fold (a i) (b j)) =
      scalingHom u (X (fold (a i) (b j)))
    simp only [scalingHom, aeval_X, u, Units.val_pow_eq_pow_val, entryWeight_fold]
  rw [hdet, Units.smul_def, smul_eq_C_mul]
  change C ((x : DeformationField) ^ minorWeight a b) *
    (C (((x ^ minorWeight a b)⁻¹ : DeformationFieldˣ) : DeformationField) *
      variableScaling u (minor DeformationField a b)) = _
  rw [← mul_assoc, ← map_mul]
  simp only [← Units.val_pow_eq_pow_val, Units.mul_inv, map_one, one_mul]

end FourPapers.Symmetric.Deformation
