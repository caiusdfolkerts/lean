section

set_option autoImplicit false
set_option maxHeartbeats 1600000

/-!
# The actual joint symbolic Rees algebra

The two symbolic gradings are independent polynomial variables.  Membership
is defined coefficient by coefficient using the intersection of the two actual
symbolic powers.  We then transport this ordinary iterated polynomial algebra
through an explicit algebra equivalence to a multivariate polynomial ring, so
that the obstruction can be stated for every monomial order with the paper's
restriction on homogeneous components.

The definitions retain both symbolic gradings and the full coefficient algebra.
-/

noncomputable section
namespace FourPapers.Symmetric.JointSagbi

open Finset MvPolynomial
open scoped MonomialOrder

universe u v
variable {K : Type u} [Field K] {σ : Type v}

abbrev Variables (σ : Type v) := Option (Option σ)
abbrev Ring (σ : Type v) (K : Type u) [Field K] := MvPolynomial (Variables σ) K

/-- Outer `none` is V, inner `none` is T, and inner `some` is an original
coefficient-ring variable. -/
def coordinates (K : Type u) [Field K] (σ : Type v) :
    Ring σ K ≃ₐ[K] Polynomial (Polynomial (MvPolynomial σ K)) :=
  (MvPolynomial.optionEquivLeft K (Option σ)).trans
    (Polynomial.mapAlgEquiv (MvPolynomial.optionEquivLeft K σ))

@[simp] theorem coordinates_monomial (d : Variables σ →₀ ℕ) (c : K) :
    coordinates K σ (MvPolynomial.monomial d c) =
      Polynomial.monomial (d none)
        (Polynomial.monomial (d.some none) (MvPolynomial.monomial d.some.some c)) := by
  simp only [coordinates, AlgEquiv.trans_apply, MvPolynomial.optionEquivLeft_monomial,
    Polynomial.coe_mapAlgEquiv, Polynomial.map_monomial]
  change Polynomial.monomial (d none)
    ((MvPolynomial.optionEquivLeft K σ) (MvPolynomial.monomial d.some c)) = _
  rw [MvPolynomial.optionEquivLeft_monomial]

/-- The exponent vector of m T^a V^b, retaining all multiplicities of m. -/
def taggedExponent (a b : ℕ) (e : σ →₀ ℕ) : Variables σ →₀ ℕ :=
  (e.optionElim a).optionElim b

@[simp] theorem taggedExponent_none (a b : ℕ) (e : σ →₀ ℕ) :
    taggedExponent a b e none = b := by simp [taggedExponent]

@[simp] theorem taggedExponent_some_none (a b : ℕ) (e : σ →₀ ℕ) :
    taggedExponent a b e (some none) = a := by simp [taggedExponent]

@[simp] theorem taggedExponent_some_some (a b : ℕ) (e : σ →₀ ℕ) (i : σ) :
    taggedExponent a b e (some (some i)) = e i := by simp [taggedExponent]

@[simp] theorem taggedExponent_add (a b c d : ℕ) (e f : σ →₀ ℕ) :
    taggedExponent (a + c) (b + d) (e + f) =
      taggedExponent a b e + taggedExponent c d f := by
  ext i
  rcases i with _ | (_ | i) <;> simp [taggedExponent]

theorem taggedExponent_injective (a b : ℕ) :
    Function.Injective (taggedExponent (σ := σ) a b) := by
  intro e f h
  ext i
  simpa only [taggedExponent_some_some] using
    congrArg (fun d => d (some (some i))) h

@[simp] theorem taggedExponent_reconstruct (d : Variables σ →₀ ℕ) :
    taggedExponent (d.some none) (d none) d.some.some = d := by
  ext i
  rcases i with _ | (_ | i) <;> simp [taggedExponent]

/-- Multiplication by the two grading monomials, expressed in the actual
multivariate polynomial ring. -/
def tag (a b : ℕ) (f : MvPolynomial σ K) : Ring σ K :=
  (coordinates K σ).symm (Polynomial.monomial b (Polynomial.monomial a f))

@[simp] theorem tag_monomial (a b : ℕ) (e : σ →₀ ℕ) (c : K) :
    tag a b (MvPolynomial.monomial e c) = MvPolynomial.monomial (taggedExponent a b e) c := by
  apply (coordinates K σ).injective
  simp [tag, taggedExponent, coordinates_monomial]

@[simp] theorem tag_zero (a b : ℕ) : tag a b (0 : MvPolynomial σ K) = 0 := by
  simp [tag]

@[simp] theorem tag_add (a b : ℕ) (f g : MvPolynomial σ K) :
    tag a b (f + g) = tag a b f + tag a b g := by simp [tag]

@[simp] theorem tag_smul (a b : ℕ) (c : K) (f : MvPolynomial σ K) :
    tag a b (c • f) = c • tag a b f := by
  simp only [tag, ← Polynomial.smul_monomial, map_smul]

@[simp] theorem tag_mul (a b c d : ℕ) (f g : MvPolynomial σ K) :
    tag a b f * tag c d g = tag (a + c) (b + d) (f * g) := by
  apply (coordinates K σ).injective
  simp only [map_mul, tag, AlgEquiv.apply_symm_apply, Polynomial.monomial_mul_monomial]

@[simp] theorem tag_one : tag 0 0 (1 : MvPolynomial σ K) = 1 := by
  simp [tag]

theorem tag_ne_zero (a b : ℕ) {f : MvPolynomial σ K} (hf : f ≠ 0) : tag a b f ≠ 0 := by
  intro h
  apply hf
  have hh := congrArg (fun p => ((coordinates K σ p).coeff b).coeff a) h
  simpa [tag] using hh

/-- The full coefficientwise direct sum of intersections of actual symbolic
powers, before changing polynomial coordinates. -/
def coefficientAlgebra (P Q : Ideal (MvPolynomial σ K)) [P.IsPrime] [Q.IsPrime] :
    Subalgebra K (Polynomial (Polynomial (MvPolynomial σ K))) where
  carrier := {p | ∀ a b,
    (p.coeff b).coeff a ∈ symbolicPower P a ∧
    (p.coeff b).coeff a ∈ symbolicPower Q b}
  mul_mem' hp hq a b := by
    rw [Polynomial.coeff_mul, Polynomial.finsetSum_coeff]
    constructor
    · apply Ideal.sum_mem
      rintro ⟨b₁, b₂⟩ hb
      rw [Polynomial.coeff_mul]
      apply Ideal.sum_mem
      rintro ⟨a₁, a₂⟩ ha
      have has := Finset.mem_antidiagonal.mp ha
      simpa only [has] using mul_mem_symbolicPower_add P (hp a₁ b₁).1 (hq a₂ b₂).1
    · apply Ideal.sum_mem
      rintro ⟨b₁, b₂⟩ hb
      rw [Polynomial.coeff_mul]
      apply Ideal.sum_mem
      rintro ⟨a₁, a₂⟩ ha
      have hbs := Finset.mem_antidiagonal.mp hb
      simpa only [hbs] using mul_mem_symbolicPower_add Q (hp a₁ b₁).2 (hq a₂ b₂).2
  one_mem' a b := by
    by_cases ha : a = 0 <;> by_cases hb : b = 0 <;>
      simp [Polynomial.coeff_one, ha, hb, symbolicPower_zero]
  add_mem' hp hq a b := by
    simp only [Polynomial.coeff_add]
    exact ⟨(symbolicPower P a).add_mem (hp a b).1 (hq a b).1,
      (symbolicPower Q b).add_mem (hp a b).2 (hq a b).2⟩
  zero_mem' a b := by simp
  algebraMap_mem' c a b := by
    by_cases ha : a = 0 <;> by_cases hb : b = 0 <;>
      simp [Polynomial.algebraMap_apply, Polynomial.coeff_C, ha, hb, symbolicPower_zero]

/-- The actual joint symbolic Rees algebra in the independent variables. -/
def jointRees (P Q : Ideal (MvPolynomial σ K)) [P.IsPrime] [Q.IsPrime] :
    Subalgebra K (Ring σ K) :=
  (coefficientAlgebra P Q).comap (coordinates K σ).toAlgHom

@[simp] theorem tag_mem_jointRees (P Q : Ideal (MvPolynomial σ K))
    [P.IsPrime] [Q.IsPrime] (a b : ℕ) (f : MvPolynomial σ K) :
    tag a b f ∈ jointRees P Q ↔ f ∈ symbolicPower P a ⊓ symbolicPower Q b := by
  change (∀ i j,
      (((coordinates K σ) (tag a b f)).coeff j).coeff i ∈ symbolicPower P i ∧
      (((coordinates K σ) (tag a b f)).coeff j).coeff i ∈ symbolicPower Q j) ↔ _
  simp only [tag, AlgEquiv.apply_symm_apply]
  constructor
  · intro h
    simpa using h a b
  · intro h i j
    by_cases hb : b = j
    · subst j
      by_cases ha : a = i
      · subst i
        simpa using h
      · simp [Polynomial.coeff_monomial, ha]
    · simp [Polynomial.coeff_monomial, hb]

/-- The precise restriction on term orders stipulated in §7.3. -/
def RespectsCoefficientOrder (ω : MonomialOrder (Variables σ)) (m : MonomialOrder σ) : Prop :=
  ∀ a b e f, taggedExponent a b e ≼[ω] taggedExponent a b f ↔ e ≼[m] f

theorem coefficient_coordinates (d : Variables σ →₀ ℕ) (p : Ring σ K) :
    (((coordinates K σ p).coeff (d none)).coeff (d.some none)).coeff d.some.some = p.coeff d := by
  simp only [coordinates, AlgEquiv.trans_apply, Polynomial.coe_mapAlgEquiv, Polynomial.coeff_map]
  change (((MvPolynomial.optionEquivLeft K σ)
    (((MvPolynomial.optionEquivLeft K (Option σ)) p).coeff (d none))).coeff
      (d.some none)).coeff d.some.some = p.coeff d
  rw [MvPolynomial.optionEquivLeft_coeff_some_coeff_none,
    MvPolynomial.optionEquivLeft_coeff_some_coeff_none]

theorem coeff_tag (a b : ℕ) (f : MvPolynomial σ K) (d : Variables σ →₀ ℕ) :
    (tag a b f).coeff d =
      if b = d none ∧ a = d.some none then f.coeff d.some.some else 0 := by
  classical
  rw [← coefficient_coordinates d (tag a b f)]
  simp only [tag, AlgEquiv.apply_symm_apply]
  by_cases hb : b = d none
  · rw [Polynomial.coeff_monomial, if_pos hb]
    by_cases ha : a = d.some none
    · rw [Polynomial.coeff_monomial, if_pos ha]
      simp only [hb, ha, and_self, if_true]
    · rw [Polynomial.coeff_monomial, if_neg ha]
      simp only [MvPolynomial.coeff_zero, ha, and_false, if_false]
      rfl
  · rw [Polynomial.coeff_monomial, if_neg hb]
    simp only [Polynomial.coeff_zero, MvPolynomial.coeff_zero, hb, false_and, if_false]
    rfl

open scoped Classical in
theorem support_tag (a b : ℕ) (f : MvPolynomial σ K) :
    (tag a b f).support = f.support.image (taggedExponent a b) := by
  classical
  ext d
  simp only [MvPolynomial.mem_support_iff, coeff_tag, Finset.mem_image]
  constructor
  · intro hd
    have hb : b = d none := by
      by_contra h
      exact hd (by simp only [h, false_and, if_false])
    have ha : a = d.some none := by
      by_contra h
      exact hd (by simp only [h, and_false, if_false])
    refine ⟨d.some.some, ?_, ?_⟩
    · simpa only [hb, ha, and_self, if_true] using hd
    · simpa only [hb, ha] using taggedExponent_reconstruct d
  · rintro ⟨e, he, rfl⟩
    simpa [taggedExponent] using he

/-- The original monomial order is retained on every literal homogeneous
component, with no assumption about how different bidegrees are compared. -/
theorem degree_tag (ω : MonomialOrder (Variables σ)) (m : MonomialOrder σ)
    (hω : RespectsCoefficientOrder ω m) (a b : ℕ) (f : MvPolynomial σ K) (hf : f ≠ 0) :
    ω.degree (tag a b f) = taggedExponent a b (m.degree f) := by
  classical
  apply ω.toSyn.injective
  apply le_antisymm
  · apply ω.degree_le_iff.mpr
    intro d hd
    rw [support_tag] at hd
    obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp hd
    exact (hω a b e (m.degree f)).mpr (m.le_degree he)
  · apply ω.le_degree
    rw [support_tag]
    exact Finset.mem_image_of_mem _ (m.degree_mem_support hf)

theorem leadingTerm_tag (ω : MonomialOrder (Variables σ)) (m : MonomialOrder σ)
    (hω : RespectsCoefficientOrder ω m) (a b : ℕ) (f : MvPolynomial σ K) :
    ω.leadingTerm (tag a b f) = tag a b (m.leadingTerm f) := by
  by_cases hf : f = 0
  · simp [hf]
  · rw [MonomialOrder.leadingTerm, degree_tag ω m hω a b f hf]
    rw [MonomialOrder.leadingCoeff, degree_tag ω m hω a b f hf, coeff_tag]
    simp [taggedExponent, MonomialOrder.leadingTerm, MonomialOrder.leadingCoeff]

/-- Initial algebra for the chosen actual monomial order. -/
def initialAlgebra (ω : MonomialOrder (Variables σ)) (S : Subalgebra K (Ring σ K)) :
    Subalgebra K (Ring σ K) := Algebra.adjoin K (ω.leadingTerm '' (S : Set _))

def IsSagbiBasis (ω : MonomialOrder (Variables σ)) (S : Subalgebra K (Ring σ K))
    (G : Set (Ring σ K)) : Prop :=
  Algebra.adjoin K G = S ∧ Algebra.adjoin K (ω.leadingTerm '' G) = initialAlgebra ω S

/-- The exact proposed collection, including all permissible intermediate
symbolic grades of every minor. -/
def minorGenerators (n : ℕ) (K : Type u) [Field K] (r t : ℕ) :
    Set (Ring (Entry n) K) :=
  Set.range (fun e : Entry n => tag 0 0 (MvPolynomial.X e)) ∪
    {p | ∃ (δ : MinorData n) (a b : ℕ),
      a ≤ δ.size - (r - 1) ∧ b ≤ δ.size - (t - 1) ∧ p = tag a b (δ.polynomial K)}

def determinantalJointRees (n : ℕ) (K : Type u) [Field K] (r t : ℕ)
    (hr : 0 < r) (ht : 0 < t) : Subalgebra K (Ring (Entry n) K) := by
  letI := Rees.determinantal_prime n K r hr
  letI := Rees.determinantal_prime n K t ht
  exact jointRees (determinantalIdeal n K r) (determinantalIdeal n K t)

end FourPapers.Symmetric.JointSagbi
end
end
