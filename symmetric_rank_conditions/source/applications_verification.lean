  let N := coordinateSpan (coefficientBasis (S := S) b) s
  have hmap : ∀ f ∈ I, MvPolynomial.map (algebraMap R S) f ∈ N := by
    intro f hf
    have hfs : f ∈ coordinateSpan b s := by rwa [← hI]
    clear hf
    change f ∈ Submodule.span R (b '' s) at hfs
    induction hfs using Submodule.span_induction with
    | mem f hf =>
      obtain ⟨e, he, rfl⟩ := hf
      rw [← coefficientBasis_apply]
      exact Submodule.subset_span ⟨e, he, rfl⟩
    | zero => simpa using N.zero_mem
    | add f g hf hg ihf ihg => simpa only [map_add] using N.add_mem ihf ihg
    | smul a f hf ih =>
      rw [smul_eq_C_mul, map_mul, map_C, ← smul_eq_C_mul]
      exact N.smul_mem _ ih
  have hmul : ∀ f ∈ I, ∀ p : MvPolynomial σ S,
      p * MvPolynomial.map (algebraMap R S) f ∈ N := by
    intro f hf p
    rw [p.as_sum, Finset.sum_mul]
    apply N.sum_mem
    intro e he
    have hm := hmap (monomial e 1 * f) (I.mul_mem_left _ hf)
    have hm' := N.smul_mem (p.coeff e) hm
    simpa only [map_mul, map_monomial, map_one, ← smul_mul_assoc, smul_monomial,
      smul_eq_mul, mul_one] using hm' 
