theorem degreePolynomial_below_of_bounded (m : MonomialOrder σ) (d k : ℕ)
    (x y : DegreeIndex m d → R) (hx : Below k x)
    (hxy : m.toWithBotSyn (m.withBotDegree (degreePolynomial m d y)) ≤
      m.toWithBotSyn (m.withBotDegree (degreePolynomial m d x))) : Below k y := by
  intro j hj
  by_contra hyj
  have hys : (degreeEnumeration m d j).val ∈ (degreePolynomial m d y).support := by
    exact MvPolynomial.mem_support_iff.mpr (by simpa only [degreePolynomial_coeff] using hyj)
