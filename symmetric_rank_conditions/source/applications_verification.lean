variable {n : ℕ}

/-- All the exact parameters allowed in Theorem 1.2, with no bound on the
number or sizes of the positive symbolic thresholds. -/
structure MixedDatum (n : ℕ) where
  rank : RankArray n
  symmetric : ∀ i j, rank i j = rank j i
  conditions : List (ℕ × ℕ)
  valid : ValidSymbolicConditions n conditions

def MixedDatum.meetBounds (D E : MixedDatum n) : MixedDatum n where
  rank i j := min (D.rank i j) (E.rank i j)
  symmetric i j := by rw [D.symmetric i j, E.symmetric i j]
  conditions := D.conditions ++ E.conditions
  valid ts hts := by
    rcases List.mem_append.mp hts with h | h
    · exact D.valid ts h
    · exact E.valid ts h

theorem matrixMinorIdeal_antitone_size {R ι κ : Type*} [CommRing R]
    [Fintype ι] [Fintype κ] (M : Matrix ι κ R) : Antitone (matrixMinorIdeal M) := by
  intro a b hab
  rw [matrixMinorIdeal_eq_minorsIdeal_range, matrixMinorIdeal_eq_minorsIdeal_range]
  exact Submodule.minorsIdeal_antitone _ hab

theorem northwestIdeal_antitone (R : Type*) [CommRing R] {r s : RankArray n}
    (hrs : ∀ i j, r i j ≤ s i j) : northwestIdeal R s ≤ northwestIdeal R r := by
  rw [northwestIdeal_eq_iSup_prefixMinorIdeals, northwestIdeal_eq_iSup_prefixMinorIdeals]
  apply iSup_mono
  intro i
  apply iSup_mono
  intro j
  exact matrixMinorIdeal_antitone_size _ (Nat.add_le_add_right (hrs i j) 1)

theorem northwestGenerators_min_subset (R : Type*) [CommRing R] (r s : RankArray n) :
    northwestGenerators R (fun i j => min (r i j) (s i j)) ⊆
      northwestGenerators R r ∪ northwestGenerators R s := by
  rintro f ⟨i, j, hf⟩
  change ∃ (a b : Fin (min (r i j) (s i j) + 1) ↪o Fin n),
    (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧ f = minor R a b at hf
  by_cases h : r i j ≤ s i j
  · left
    refine ⟨i, j, ?_⟩
    have he : min (r i j) (s i j) = r i j := min_eq_left h
    rw [he] at hf
    exact hf
  · right
    refine ⟨i, j, ?_⟩
    have he : min (r i j) (s i j) = s i j := min_eq_right (le_of_not_ge h)
    rw [he] at hf
    exact hf

theorem northwestIdeal_min (R : Type*) [CommRing R] (r s : RankArray n) :
    northwestIdeal R (fun i j => min (r i j) (s i j)) =
      northwestIdeal R r ⊔ northwestIdeal R s := by
  apply le_antisymm
  · rw [northwestIdeal, northwestIdeal, northwestIdeal, ← Ideal.span_union]
    exact Ideal.span_mono (northwestGenerators_min_subset R r s)
  · apply sup_le
    · exact northwestIdeal_antitone R (fun i j => min_le_left _ _)
    · exact northwestIdeal_antitone R (fun i j => min_le_right _ _)

theorem mixedIdeal_meetBounds (R : Type*) [CommRing R] (D E : MixedDatum n) :
    mixedIdeal R (D.meetBounds E).rank (D.meetBounds E).conditions =
      mixedIdeal R D.rank D.conditions ⊔ mixedIdeal R E.rank E.conditions := by
  simp only [mixedIdeal, MixedDatum.meetBounds, northwestIdeal_min,
    List.map_append, List.sum_append]
  change (_ ⊔ _) ⊔ (_ ⊔ _) = (_ ⊔ _) ⊔ (_ ⊔ _)
  ac_rfl

theorem mixedGenerators_meetBounds_subset (R : Type*) [CommRing R] (D E : MixedDatum n) :
    mixedGenerators R (D.meetBounds E).rank (D.meetBounds E).conditions ⊆
      mixedGenerators R D.rank D.conditions ∪ mixedGenerators R E.rank E.conditions := by
  rintro f (h | ⟨ts, hts, hf⟩)
  · rcases northwestGenerators_min_subset R D.rank E.rank h with h | h
    · exact Or.inl (Or.inl h)
    · exact Or.inr (Or.inl h)
  · rcases List.mem_append.mp hts with hts | hts
    · exact Or.inl (Or.inr ⟨ts, hts, hf⟩)
    · exact Or.inr (Or.inr ⟨ts, hts, hf⟩)

theorem mixed_union_groebner (K : Type*) [Field K] (D E : MixedDatum n) :
    (foldedOrder n).IsGroebnerBasis
      (mixedGenerators K D.rank D.conditions ∪ mixedGenerators K E.rank E.conditions)
      (mixedIdeal K D.rank D.conditions ⊔ mixedIdeal K E.rank E.conditions) := by
  have h := Paper.theorem_1_2_field n K (D.meetBounds E).rank (D.meetBounds E).symmetric
    (D.meetBounds E).conditions (D.meetBounds E).valid
  rw [mixedIdeal_meetBounds K D E] at h
  apply h.mono (mixedGenerators_meetBounds_subset K D E)
  intro f hf
  rcases hf with hf | hf
  · exact (show mixedIdeal K D.rank D.conditions ≤
      mixedIdeal K D.rank D.conditions ⊔ mixedIdeal K E.rank E.conditions from le_sup_left)
      ((Paper.theorem_1_2_field n K D.rank D.symmetric D.conditions D.valid).subset hf)
  · exact (show mixedIdeal K E.rank E.conditions ≤
      mixedIdeal K D.rank D.conditions ⊔ mixedIdeal K E.rank E.conditions from le_sup_right)
      ((Paper.theorem_1_2_field n K E.rank E.symmetric E.conditions E.valid).subset hf)

def mixedIntegralSpan (D : MixedDatum n) : Ideal (CoordinateRing n ℤ) :=
  Ideal.span (mixedGenerators ℤ D.rank D.conditions)

theorem mixedIntegralSpan_groebner (D : MixedDatum n) :
    (foldedOrder n).IsGroebnerBasis (mixedGenerators ℤ D.rank D.conditions) (mixedIntegralSpan D) :=
  integral_mixedGroebner_of_rational D.rank D.conditions
    (Paper.theorem_1_2_field n ℚ D.rank D.symmetric D.conditions D.valid)

theorem mixedIntegralSpan_union_groebner (D E : MixedDatum n) :
    (foldedOrder n).IsGroebnerBasis
      (mixedGenerators ℤ D.rank D.conditions ∪ mixedGenerators ℤ E.rank E.conditions)
      (mixedIntegralSpan D ⊔ mixedIntegralSpan E) := by
  have hunit : ∀ g ∈ mixedGenerators ℤ D.rank D.conditions ∪ mixedGenerators ℤ E.rank E.conditions,
      g ≠ 0 → IsUnit ((foldedOrder n).leadingCoeff g) := by
    intro g hg hg0
    rcases hg with hg | hg
    · exact mixedGenerators_unit_leading ℤ D.rank D.conditions g hg hg0
    · exact mixedGenerators_unit_leading ℤ E.rank E.conditions g hg hg0
  have hinj : Function.Injective (Int.castRingHom ℚ) := Int.cast_injective
  apply (MonomialOrder.isGroebnerBasis_map_iff hinj hunit ?_).mp
  · have hQ := mixed_union_groebner ℚ D E
    rw [mixedIntegralSpan, mixedIntegralSpan, ← Ideal.span_union, Ideal.map_span,
      Set.image_union, map_mixedGenerators, map_mixedGenerators]
    rw [← hQ.ideal_eq_span]
    exact hQ
  · intro g hg
    rcases hg with hg | hg
    · exact (show mixedIntegralSpan D ≤ mixedIntegralSpan D ⊔ mixedIntegralSpan E from le_sup_left)
        (Ideal.subset_span hg)
    · exact (show mixedIntegralSpan E ≤ mixedIntegralSpan D ⊔ mixedIntegralSpan E from le_sup_right)
        (Ideal.subset_span hg)

theorem mixedIntegralSpan_homogeneous (D : MixedDatum n) :
    (mixedIntegralSpan D).IsHomogeneous
      (weightedHomogeneousSubmodule ℤ (fun _ : Entry n => (1 : ℕ))) := by
  apply Ideal.homogeneous_span
  exact mixedGenerators_homogeneous ℤ D.rank D.conditions

theorem mixedIntegralSpan_eq_normalized (D : MixedDatum n) :
    mixedIntegralSpan D = Ideal.span (normalizedMixedGenerators D.rank D.conditions) :=
  ((mixedIntegralSpan_groebner D).normalize_involutive_leading
    (mixedGenerators_leadingCoeff_mul_self ℤ D.rank D.conditions)).1.ideal_eq_span

/-- One integral homogeneous triangular basis simultaneously adapts to
*all* the ideals in Theorem 1.2 at the fixed matrix size. -/
theorem all_mixed_integral_simultaneous_basis (n : ℕ) :
    ∃ b : Basis (Entry n →₀ ℕ) ℤ (CoordinateRing n ℤ),
      (∀ e, (b e).coeff e = 1 ∧ (b e).IsWeightedHomogeneous (fun _ : Entry n => (1 : ℕ))
        (Finsupp.weight (fun _ : Entry n => (1 : ℕ)) e) ∧
        (foldedOrder n).toSyn ((foldedOrder n).degree (b e)) ≤ (foldedOrder n).toSyn e) ∧
      ∀ D : MixedDatum n, (mixedIntegralSpan D).restrictScalars ℤ =
        coordinateSpan b ((foldedOrder n).standardMonomials (mixedIntegralSpan D))ᶜ := by
  exact exists_polynomial_simultaneous_basis (foldedOrder n) mixedIntegralSpan
    (fun D => mixedGenerators ℤ D.rank D.conditions) mixedIntegralSpan_groebner
    (fun D => mixedGenerators_unit_leading ℤ D.rank D.conditions)
    mixedIntegralSpan_homogeneous mixedIntegralSpan_union_groebner

/-- Finite lattice expressions record the actual sums and intersections,
without replacing ideals by their initial monomial sets. -/
inductive MixedLatticeExpression (n : ℕ) where
  | atom : MixedDatum n → MixedLatticeExpression n
  | sup : MixedLatticeExpression n → MixedLatticeExpression n → MixedLatticeExpression n
  | inf : MixedLatticeExpression n → MixedLatticeExpression n → MixedLatticeExpression n

def MixedLatticeExpression.ideal : MixedLatticeExpression n → Ideal (CoordinateRing n ℤ)
  | .atom D => mixedIntegralSpan D
  | .sup e f => e.ideal ⊔ f.ideal
  | .inf e f => e.ideal ⊓ f.ideal

def MixedLatticeExpression.monomials : MixedLatticeExpression n → Set (Entry n →₀ ℕ)
  | .atom D => ((foldedOrder n).standardMonomials (mixedIntegralSpan D))ᶜ
  | .sup e f => e.monomials ∪ f.monomials
  | .inf e f => e.monomials ∩ f.monomials

theorem MixedLatticeExpression.adapted (b : Basis (Entry n →₀ ℕ) ℤ (CoordinateRing n ℤ))
    (hb : ∀ D : MixedDatum n, (mixedIntegralSpan D).restrictScalars ℤ =
      coordinateSpan b ((foldedOrder n).standardMonomials (mixedIntegralSpan D))ᶜ) :
    ∀ e : MixedLatticeExpression n, e.ideal.restrictScalars ℤ = coordinateSpan b e.monomials := by
  intro e
  induction e with
  | atom D => exact hb D
  | sup e f he hf =>
    change (e.ideal ⊔ f.ideal).restrictScalars ℤ = coordinateSpan b (e.monomials ∪ f.monomials)
    rw [coordinateSpan_union, ← he, ← hf]
    exact Submodule.restrictScalars_sup ℤ e.ideal f.ideal
  | inf e f he hf =>
    change (e.ideal ⊓ f.ideal).restrictScalars ℤ = coordinateSpan b (e.monomials ∩ f.monomials)
    rw [coordinateSpan_inter, ← he, ← hf]
    rfl

/-- Distributivity in the actual finite lattice generated by the ideals. -/
theorem mixed_integral_lattice_distributive (e f g : MixedLatticeExpression n) :
    e.ideal ⊓ (f.ideal ⊔ g.ideal) = (e.ideal ⊓ f.ideal) ⊔ (e.ideal ⊓ g.ideal) := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  have h := coordinateSpan_inf_sup_distrib b e.monomials f.monomials g.monomials
  rw [← MixedLatticeExpression.adapted b hspan e,
    ← MixedLatticeExpression.adapted b hspan f,
    ← MixedLatticeExpression.adapted b hspan g] at h
  rw [← Submodule.restrictScalars_sup, ← Submodule.restrictScalars_inf,
    ← Submodule.restrictScalars_inf, ← Submodule.restrictScalars_inf,
    ← Submodule.restrictScalars_sup] at h
  exact congrArg (fun N : Submodule ℤ (CoordinateRing n ℤ) => (N : Set (CoordinateRing n ℤ))) h
    |> SetLike.coe_injective

end FourPapers.Symmetric
end
