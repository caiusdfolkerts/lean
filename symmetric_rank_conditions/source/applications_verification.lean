  rw [← hj, degreeEnumeration_le_iff]
  by_contra hji
  change ¬ j.val ≤ i.val at hji
  exact hxj (hx j (by omega))

theorem degreePolynomial_below_of_degree_le (m : MonomialOrder σ) (d : ℕ)
    (x : DegreeIndex m d → R) (i : DegreeIndex m d)
    (hx : m.toSyn (m.degree (degreePolynomial m d x)) ≤
