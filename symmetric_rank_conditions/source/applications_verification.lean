section

set_option autoImplicit false
set_option maxHeartbeats 1600000
noncomputable section

/-!
# Additivity of the actual determinant antidiagonal score

The statements are unrestricted in the monomial and the natural determinant
exponent. The proof reduces both size and score threshold by the exact carrier,
and removes pivot loops by the actual insertion identity.
-/

namespace FourPapers.Symmetric

theorem twice_half_row_sum {α : Type*} (rows : List (List α)) (heven : EvenRows rows) :
    2 * (rows.map (fun row => row.length / 2)).sum = rows.flatten.length := by
  revert heven
  induction rows with
  | nil => intro _; simp
  | cons row rows ih =>
    intro heven
    have hrow : ∃ r : ℕ, row.length = r+r := by
      simpa only [List.getD_cons_zero] using heven 0
    have htail : EvenRows rows := by
      intro i
      simpa only [List.getD_cons_succ] using heven (i+1)
    have ht := ih htail
    obtain ⟨r,hr⟩ := hrow
    simp only [List.map_cons,List.sum_cons,Nat.mul_add,List.flatten_cons,
      List.length_append,ht,hr]
    omega

theorem monomialPairs_length_eq_degree {n : ℕ} (m : Entry n →₀ ℕ) :
    (monomialPairs m).length = m.degree := by
  simp only [monomialPairs,List.length_map,Multiset.length_sort,
    Finsupp.card_toMultiset]
  rfl

/-- At threshold one the actual tableau tail counts every factor. -/
theorem gamma_one_eq_degree {n : ℕ} (m : Entry n →₀ ℕ) : gamma 1 m = m.degree := by
  have h := twice_half_row_sum (pairedTableau m) (pairedTableau_evenRows m)
  rw [pairedTableau,pairInsertList_flatten_length,monomialPairs_length_eq_degree] at h
  change 2 * (halfShape m).sum = 2 * m.degree at h
  simp only [gamma,Nat.sub_self,List.drop_zero]
  omega

@[simp] theorem fullAntidiagonalExponent_degree (n : ℕ) :
    (fullAntidiagonalExponent n).degree = n := by
  classical
  simp [fullAntidiagonalExponent,antidiagonalExponent,map_sum]

/-- Forget only the actual diagonal pivot exponent. -/
def restrictPivotExponent {n : ℕ} (m : Entry (n+1) →₀ ℕ) : PivotVariables n →₀ ℕ :=
  (m.mapDomain Pivot.pivotEntryEquiv.symm).some

@[simp] theorem restrictPivotExponent_apply {n : ℕ} (m : Entry (n+1) →₀ ℕ)
    (v : PivotVariables n) : restrictPivotExponent m v = m (Pivot.pivotEntry (.some v)) := by
  rw [restrictPivotExponent,Finsupp.some_apply,Finsupp.mapDomain_equiv_apply]
  rfl

@[simp] theorem restrictPivotExponent_add {n : ℕ} (m q : Entry (n+1) →₀ ℕ) :
    restrictPivotExponent (m+q) = restrictPivotExponent m + restrictPivotExponent q := by
  ext v
  simp only [restrictPivotExponent_apply,Finsupp.add_apply]

@[simp] theorem restrictPivotExponent_nsmul {n : ℕ} (m : Entry (n+1) →₀ ℕ) (b : ℕ) :
    restrictPivotExponent (b • m) = b • restrictPivotExponent m := by
  ext v
  simp only [restrictPivotExponent_apply,Finsupp.smul_apply]

/-- This is a coordinate decomposition, without any assumption on the pivot. -/
theorem lift_restrictPivotExponent {n : ℕ} (m : Entry (n+1) →₀ ℕ) :
    Pivot.liftPivotExponent (restrictPivotExponent m) +
      Finsupp.single (fold 0 0) (m (fold 0 0)) = m := by
  classical
  ext e
  obtain ⟨o,rfl⟩ := Pivot.pivotEntry_surjective e
  cases o with
  | none =>
    have hz : Pivot.liftPivotExponent (restrictPivotExponent m) (fold 0 0) = 0 := by
      simpa only [Pivot.pivotEntry_none] using
        Pivot.liftPivotExponent_apply_none (restrictPivotExponent m)
    simp only [Finsupp.add_apply,Pivot.pivotEntry_none,hz,
      Finsupp.single_eq_same,zero_add]
  | some v =>
    have hv : Pivot.pivotEntry (.some v) ≠ fold (0 : Fin (n+1)) 0 := by
      intro h
      have he : Pivot.pivotEntry (.some v) = Pivot.pivotEntry none := by
        simpa only [Pivot.pivotEntry_none] using h
      have ho : (Option.some v : Option (PivotVariables n)) = none :=
        Pivot.pivotEntry_injective he
      cases ho
    simp only [Finsupp.add_apply,Pivot.liftPivotExponent_apply_some,
      restrictPivotExponent_apply,Finsupp.single_apply,hv,hv.symm,if_false,add_zero]

theorem restrict_fullAntidiagonalExponent (n : ℕ) :
    restrictPivotExponent (fullAntidiagonalExponent (n+1)) = fullAntidiagonalPivot n := by
  ext v
  rw [restrictPivotExponent_apply,fullAntidiagonalPivot_apply]
  congr 1
  cases v <;> rfl

/-- Every score above one ignores the omitted pivot coordinate. -/
theorem gamma_restrictPivotExponent {n : ℕ} (m : Entry (n+1) →₀ ℕ) (t : ℕ) :
    gamma (t+2) m = gamma (t+1) (monomialCarrierEquiv n (restrictPivotExponent m)).2 := by
  calc
    gamma (t+2) m =
        gamma (t+2) (Pivot.liftPivotExponent (restrictPivotExponent m)) := by
      calc
        gamma (t+2) m = gamma (t+2)
            (Pivot.liftPivotExponent (restrictPivotExponent m) +
              Finsupp.single (fold 0 0) (m (fold 0 0))) :=
          congrArg (gamma (t+2)) (lift_restrictPivotExponent m).symm
        _ = gamma (t+2) (Pivot.liftPivotExponent (restrictPivotExponent m)) :=
          gamma_add_least_loop _ _ _
    _ = gamma (t+1) (monomialCarrierEquiv n (restrictPivotExponent m)).2 :=
      carrier_gamma_recurrence (restrictPivotExponent m) (t+1) (by omega)

/-- Proposition 7.3's monomial score identity, with all thresholds included. The
formula is proved for arbitrary monomials and powers, not bounded samples. -/
theorem gamma_add_fullAntidiagonal (n t : ℕ) (m : Entry n →₀ ℕ) (b : ℕ) :
    gamma (t+1) (m + b • fullAntidiagonalExponent n) =
      gamma (t+1) m + b * (n-t) := by
  induction n generalizing t b with
  | zero =>
    have hm : m = 0 := by ext e; exact Fin.elim0 e.val.1
    have hd : fullAntidiagonalExponent 0 = 0 := by ext e; exact Fin.elim0 e.val.1
    simp only [hm,hd,smul_zero,add_zero,Nat.zero_sub,mul_zero]
  | succ n ih =>
    cases t with
    | zero =>
      simp only [Nat.zero_add,gamma_one_eq_degree,map_add,map_nsmul,
        fullAntidiagonalExponent_degree,nsmul_eq_mul,Nat.cast_id,Nat.sub_zero]
    | succ t =>
      rw [gamma_restrictPivotExponent,gamma_restrictPivotExponent,
        restrictPivotExponent_add,restrictPivotExponent_nsmul,
        restrict_fullAntidiagonalExponent,monomialCarrierEquiv_add_fullAntidiagonal]
      simpa only [Nat.succ_sub_succ_eq_sub] using
        ih (t := t) (m := (monomialCarrierEquiv n (restrictPivotExponent m)).2) b

end FourPapers.Symmetric
end
end
