section

set_option autoImplicit false
set_option maxHeartbeats 1200000

/-!
# Loops at the least endpoint

These identities support the determinant application by describing the actual
paired-insertion algorithm at the least endpoint, for arbitrary natural
multiplicities, including zero.
-/

namespace FourPapers.Symmetric

/-- A block of loops at a least endpoint changes only the first insertion row. -/
theorem pairInsertList_tail_least_loops {α : Type*} [LinearOrder α]
    (pairs : List (α × α)) (b : α) (k : ℕ)
    (hmin : ∀ p ∈ pairs, b ≤ p.1) :
    (pairInsertList (List.replicate k (b,b) ++ pairs)).tail =
      (pairInsertList pairs).tail := by
  rw [pairInsertList_tail, pairInsertList_tail, firstRowProcess_append,
    firstRowProcess_loops b k [] (by simp)]
  simp only [List.nil_append]
  have h := firstRowProcess_passed_prefix pairs (List.replicate (2*k) b) [] (by
    intro p hp z hz
    have hz' : z = b := List.eq_of_mem_replicate hz
    subst z
    exact hmin p hp)
  simpa only [List.append_nil] using
    congrArg (fun z : List α × List (α × α) => pairInsertList z.2) h

/-- Sorted exponent serialization places every added least coordinate first. -/
theorem sort_toMultiset_add_single_least {α : Type*} [LinearOrder α]
    (m : α →₀ ℕ) (z : α) (hz : ∀ a, z ≤ a) (k : ℕ) :
    (m + Finsupp.single z k).toMultiset.sort (· ≤ ·) =
      List.replicate k z ++ m.toMultiset.sort (· ≤ ·) := by
  have hc (f : α →₀ ℕ) (a : α) :
      (f.toMultiset.sort (· ≤ ·)).count a = f a := by
    rw [← Multiset.coe_count, Multiset.sort_eq, Finsupp.count_toMultiset]
  have hp : ((m + Finsupp.single z k).toMultiset.sort (· ≤ ·)).Perm
      (List.replicate k z ++ m.toMultiset.sort (· ≤ ·)) := by
    apply List.perm_iff_count.mpr
    intro a
    rw [hc,List.count_append,hc]
    by_cases ha : a = z
    · subst a
      simp [List.count_replicate,Finsupp.add_apply,Nat.add_comm]
    · simp [List.count_replicate,Finsupp.add_apply,Finsupp.single_apply,ha,Ne.symm ha]
  have hs : (List.replicate k z ++ m.toMultiset.sort (· ≤ ·)).Pairwise (· ≤ ·) := by
    apply List.pairwise_append.mpr
    refine ⟨List.pairwise_replicate.mpr (Or.inr le_rfl),
      Multiset.pairwise_sort _ _, ?_⟩
    intro a ha b hb
    have ha' : a = z := List.eq_of_mem_replicate ha
    subst a
    exact hz b
  exact hp.eq_of_pairwise' (Multiset.pairwise_sort _ _) hs

theorem fold_zero_le {n : ℕ} (e : Entry (n+1)) : fold 0 0 ≤ e := by
  change (fold (0 : Fin (n+1)) 0).val ≤ e.val
  rw [fold_self]
  apply Prod.Lex.le_iff.mpr
  rcases eq_or_lt_of_le (Fin.zero_le e.val.1) with h | h
  · exact Or.inr ⟨h,Fin.zero_le e.val.2⟩
  · exact Or.inl h

/-- The literal sorted word of a monomial after adjoining arbitrary pivot loops. -/
theorem monomialPairs_add_least_loop {n : ℕ} (m : Entry (n+1) →₀ ℕ) (k : ℕ) :
    monomialPairs (m + Finsupp.single (fold 0 0) k) =
      List.replicate k ((0 : Fin (n+1)),0) ++ monomialPairs m := by
  unfold monomialPairs
  rw [sort_toMultiset_add_single_least m (fold 0 0) fold_zero_le k]
  simp only [List.map_append,List.map_replicate,fold_self]
  rfl

/-- Every row below the first is unchanged, for all monomial multiplicities. -/
theorem pairedTableau_tail_add_least_loop {n : ℕ} (m : Entry (n+1) →₀ ℕ) (k : ℕ) :
    (pairedTableau (m + Finsupp.single (fold 0 0) k)).tail = (pairedTableau m).tail := by
  unfold pairedTableau
  rw [monomialPairs_add_least_loop]
  exact pairInsertList_tail_least_loops (monomialPairs m) 0 k
    (fun p hp => Fin.zero_le p.1)

theorem halfShape_tail_add_least_loop {n : ℕ} (m : Entry (n+1) →₀ ℕ) (k : ℕ) :
    (halfShape (m + Finsupp.single (fold 0 0) k)).tail = (halfShape m).tail := by
  simpa only [halfShape,List.map_tail] using
    congrArg (List.map (fun row : List (Fin (n+1)) => row.length / 2))
      (pairedTableau_tail_add_least_loop m k)

/-- All symbolic scores of threshold at least two ignore least-endpoint loops. -/
theorem gamma_add_least_loop {n : ℕ} (m : Entry (n+1) →₀ ℕ) (k t : ℕ) :
    gamma (t+2) (m + Finsupp.single (fold 0 0) k) = gamma (t+2) m := by
  unfold gamma
  have he : t+2-1 = t+1 := by omega
  simp only [he,←List.drop_tail]
  rw [halfShape_tail_add_least_loop]

end FourPapers.Symmetric
end
