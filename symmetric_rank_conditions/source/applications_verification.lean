namespace FourPapers.Symmetric.Deformation

open MvPolynomial Finsupp

variable {σ R : Type*} [CommRing R]

def scalingHom (u : σ → Rˣ) : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
  MvPolynomial.aeval (fun i => C (u i : R) * X i)

def variableScaling (u : σ → Rˣ) : MvPolynomial σ R ≃ₐ[R] MvPolynomial σ R :=
  AlgEquiv.ofAlgHom (scalingHom u) (scalingHom (fun i => (u i)⁻¹))
    (by
      ext i
      simp only [AlgHom.comp_apply, AlgHom.id_apply, scalingHom, aeval_X,
        map_mul, aeval_C, MvPolynomial.algebraMap_eq]
      rw [← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul])
    (by
      ext i
      simp only [AlgHom.comp_apply, AlgHom.id_apply, scalingHom, aeval_X,
        map_mul, aeval_C, MvPolynomial.algebraMap_eq]
      rw [← mul_assoc, ← map_mul, Units.mul_inv, map_one, one_mul])

def monomialScale (u : σ → Rˣ) (e : σ →₀ ℕ) : Rˣ :=
  ∏ i ∈ e.support, u i ^ e i

theorem variableScaling_monomial (u : σ → Rˣ) (e : σ →₀ ℕ) (c : R) :
    variableScaling u (monomial e c) = monomial e (c * (monomialScale u e : R)) := by
  classical
  change scalingHom u (monomial e c) = _
  rw [scalingHom, aeval_monomial]
  simp only [Finsupp.prod, MvPolynomial.algebraMap_eq, mul_pow, Finset.prod_mul_distrib,
    ← map_pow, ← map_prod, monomialScale, Units.coe_prod, Units.val_pow_eq_pow_val,
    monomial_eq, Finsupp.prod, map_mul]
  ring

theorem variableScaling_coeff (u : σ → Rˣ) (p : MvPolynomial σ R) (e : σ →₀ ℕ) :
    (variableScaling u p).coeff e = p.coeff e * (monomialScale u e : R) := by
  classical
  conv_lhs => rw [p.as_sum, map_sum]
  simp only [variableScaling_monomial, coeff_sum, coeff_monomial]
  rw [Finset.sum_eq_single e]
  · simp only [ite_true]
  · intro a ha hae
    simp only [if_neg hae]
  · intro he
    simp only [ite_true, MvPolynomial.notMem_support_iff.mp he, zero_mul]

theorem variableScaling_support (u : σ → Rˣ) (p : MvPolynomial σ R) :
    (variableScaling u p).support = p.support := by
  ext e
  rw [MvPolynomial.mem_support_iff, MvPolynomial.mem_support_iff, variableScaling_coeff]
  constructor
  · intro h hp
    exact h (by rw [hp, zero_mul])
  · intro hp h
    apply hp
    have h' := congrArg (fun x : R => x * ((monomialScale u e)⁻¹ : Rˣ)) h
    simpa only [mul_assoc, Units.mul_inv, mul_one, zero_mul] using h'

theorem variableScaling_degree (m : MonomialOrder σ) (u : σ → Rˣ) (p : MvPolynomial σ R) :
    m.degree (variableScaling u p) = m.degree p := by
  apply m.toSyn.injective
  exact (m.degree_le_degree_of_support_subset (variableScaling_support u p).le).antisymm
    (m.degree_le_degree_of_support_subset (variableScaling_support u p).ge)

/-- Invertible diagonal rescaling preserves the actual Gröbner property
for every fixed monomial order. -/
theorem groebner_variableScaling (m : MonomialOrder σ) (u : σ → Rˣ)
    (I : Ideal (MvPolynomial σ R)) (G : Set (MvPolynomial σ R))
    (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g)) :
    m.IsGroebnerBasis (variableScaling u '' G) (I.map (variableScaling u).toRingHom) := by
  have hu' : ∀ g ∈ variableScaling u '' G, g ≠ 0 → IsUnit (m.leadingCoeff g) := by
    rintro _ ⟨g, hg, rfl⟩ hg0
    rw [MonomialOrder.leadingCoeff, variableScaling_degree, variableScaling_coeff]
    exact (hu g hg (by intro h; exact hg0 (by simp [h]))).mul (monomialScale u _).isUnit
  apply (MonomialOrder.isGroebnerBasis_iff_forall_exists_degree_le_degree hu').mpr
  refine ⟨?_, ?_⟩
  · rintro _ ⟨g, hg, rfl⟩
    exact Ideal.mem_map_of_mem _ (hG.subset hg)
  · intro f hf hf0
    obtain ⟨p, hp, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective (variableScaling u).toRingHom (variableScaling u).surjective).mp hf
    have hp0 : p ≠ 0 := by intro h; exact hf0 (by simp [h])
    obtain ⟨g, hg, hg0, hgp⟩ := hG.exists_degree_le_degree hp hp0
    refine ⟨variableScaling u g, ⟨g, hg, rfl⟩,
      (map_ne_zero_iff _ (variableScaling u).injective).mpr hg0, ?_⟩
    change m.degree (variableScaling u g) ≤ m.degree (variableScaling u p)
    simpa only [variableScaling_degree] using hgp

/-- Replacing every member of a Gröbner family by a unit scalar multiple
preserves both the actual ideal and its Gröbner basis. This allows different
normalizing powers of the deformation parameter for different minors. -/
theorem groebner_unit_rescaling (m : MonomialOrder σ)
    (I : Ideal (MvPolynomial σ R)) (G H : Set (MvPolynomial σ R))
    (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (hHG : ∀ h ∈ H, ∃ g ∈ G, ∃ c : Rˣ, h = (c : R) • g)
    (hGH : ∀ g ∈ G, ∃ h ∈ H, ∃ c : Rˣ, h = (c : R) • g) :
    m.IsGroebnerBasis H I := by
  have hdeg (c : Rˣ) (g : MvPolynomial σ R) : m.degree ((c : R) • g) = m.degree g :=
    m.degree_smul_of_isRegular c.isUnit.isRegular
  have huH : ∀ h ∈ H, h ≠ 0 → IsUnit (m.leadingCoeff h) := by
    intro h hh hh0
    obtain ⟨g, hg, c, rfl⟩ := hHG h hh
    rw [MonomialOrder.leadingCoeff, hdeg, coeff_smul, smul_eq_mul]
    exact c.isUnit.mul (hu g hg (by intro h; exact hh0 (by simp [h])))
  apply (MonomialOrder.isGroebnerBasis_iff_forall_exists_degree_le_degree huH).mpr
  refine ⟨?_, ?_⟩
  · intro h hh
    obtain ⟨g, hg, c, rfl⟩ := hHG h hh
    exact I.smul_of_tower_mem _ (hG.subset hg)
  · intro p hp hp0
    obtain ⟨g, hg, hg0, hgp⟩ := hG.exists_degree_le_degree hp hp0
    obtain ⟨h, hh, c, rfl⟩ := hGH g hg
    refine ⟨(c : R) • g, hh, ?_, by simpa only [hdeg] using hgp⟩
    intro hz
    apply hg0
    have h := congrArg (fun q : MvPolynomial σ R => ((c⁻¹ : Rˣ) : R) • q) hz
    simpa only [smul_smul, Units.inv_mul, one_smul, smul_zero] using h

end FourPapers.Symmetric.Deformation
end
