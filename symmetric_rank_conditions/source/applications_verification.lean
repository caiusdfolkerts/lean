namespace FourPapers.Symmetric.SagbiObstruction
open Inflation
open scoped BigOperators

def exponentDegree {n : ℕ} (m : Entry n →₀ ℕ) : ℕ := m.sum (fun _ d => d)

theorem exponentDegree_eq_sum {n : ℕ} (m : Entry n →₀ ℕ) :
    exponentDegree m = ∑ e, m e :=
  Finsupp.sum_fintype _ _ (fun _ => rfl)

theorem exponentDegree_mono {n : ℕ} {m d : Entry n →₀ ℕ} (h : m ≤ d) :
    exponentDegree m ≤ exponentDegree d := by
  rw [exponentDegree_eq_sum, exponentDegree_eq_sum]
  exact Finset.sum_le_sum (fun e _ => h e)

theorem exponentDegree_sum {n : ℕ} {ι : Type*} [Fintype ι]
    (m : ι → Entry n →₀ ℕ) : exponentDegree (∑ i, m i) = ∑ i, exponentDegree (m i) := by
  classical
  simp only [exponentDegree_eq_sum, Finsupp.finsetSum_apply]
  exact Finset.sum_comm

theorem minor_exponent_degree {n : ℕ} (δ : MinorData n) :
    exponentDegree δ.exponent = δ.size := by
  change exponentDegree (antidiagonalExponent δ.rows δ.cols) = δ.size
  rw [← pointMonomial_antidiagonalPoints_eq]
  exact (pointMonomial_degree _).trans (antidiagonalPoints_card _ _)

theorem packing_degree_le {n k d : ℕ} {m : Entry n →₀ ℕ}
    (h : HasPackingDegree m k d) : d ≤ exponentDegree m := by
  obtain ⟨s, a, b, hd, hm⟩ := h
  let δ : Fin k → MinorData n := fun i => ⟨s i, a i, b i⟩
  calc
    d = ∑ i, exponentDegree (δ i).exponent := by
      simp only [minor_exponent_degree]
      exact hd.symm
    _ = exponentDegree (∑ i, (δ i).exponent) := (exponentDegree_sum _).symm
    _ ≤ exponentDegree m := exponentDegree_mono hm

theorem packingDegree_le_degree {n : ℕ} (m : Entry n →₀ ℕ) (k : ℕ) :
    packingDegree m k ≤ exponentDegree m := packing_degree_le (hasPackingDegree_max m k)

theorem packingDegree_zero {n : ℕ} (m : Entry n →₀ ℕ) : packingDegree m 0 = 0 := by
  obtain ⟨s, a, b, hd, hm⟩ := hasPackingDegree_max m 0
  simpa using hd.symm

def pointMinor {n : ℕ} (S : Finset (Point n)) (hS : IsAntidiagonal S) : MinorData n where
  size := S.card
  rows := Classical.choose hS.exists_embeddings
  cols := Classical.choose (Classical.choose_spec hS.exists_embeddings)

@[simp] theorem pointMinor_size {n : ℕ} (S : Finset (Point n)) (hS : IsAntidiagonal S) :
    (pointMinor S hS).size = S.card := rfl

theorem pointMinor_points {n : ℕ} (S : Finset (Point n)) (hS : IsAntidiagonal S) :
    antidiagonalPoints (pointMinor S hS).rows (pointMinor S hS).cols = S :=
  Classical.choose_spec (Classical.choose_spec hS.exists_embeddings)

theorem pointMinor_exponent {n : ℕ} (S : Finset (Point n)) (hS : IsAntidiagonal S) :
    (pointMinor S hS).exponent = pointMonomial S := by
  change antidiagonalExponent _ _ = _
  rw [← pointMonomial_antidiagonalPoints_eq, pointMinor_points]

/-- The graph construction expressed in the original exponents of minors.
All statements concern actual divisibility in the symmetric polynomial ring. -/
structure MonomialObstruction (n t : ℕ) where
  monomial : Entry n →₀ ℕ
  largest : MinorData n
  largest_size : largest.size = t
  largest_divides : largest.exponent ≤ monomial
  degree : exponentDegree monomial = t + 2
  maximal : ∀ δ : MinorData n, δ.exponent ≤ monomial → δ.size ≤ t
  unique : ∀ δ : MinorData n, δ.exponent ≤ monomial → δ.size = t →
    δ.exponent = largest.exponent
  complement_bad : ∀ δ : MinorData n, 2 ≤ δ.size →
    ¬ δ.exponent ≤ monomial - largest.exponent
  two_cover : HasPackingDegree monomial 2 (t + 2)

def GraphObstruction.toMonomial {n t : ℕ} (W : GraphObstruction n t) :
    MonomialObstruction n t where
  monomial := graphMonomial W.graph
  largest := pointMinor W.largest W.largest_admissible.anti
  largest_size := W.largest_card
  largest_divides := by
    rw [pointMinor_exponent]
    exact ((admissible_iff_monomial _ _).mp W.largest_admissible).2
  degree := (graphMonomial_degree W.graph).trans W.graph_card
  maximal := by
    intro δ hδ
    let S := antidiagonalPoints δ.rows δ.cols
    have hS : Admissible W.graph S := (admissible_iff_monomial _ _).mpr
      ⟨antidiagonalPoints_isAntidiagonal _ _, by
        simpa only [S, pointMonomial_antidiagonalPoints_eq, MinorData.exponent] using hδ⟩
    have hb := W.card_le hS
    simpa only [S, antidiagonalPoints_card] using hb
  unique := by
    intro δ hδ hsize
    let S := antidiagonalPoints δ.rows δ.cols
    have hS : Admissible W.graph S := (admissible_iff_monomial _ _).mpr
      ⟨antidiagonalPoints_isAntidiagonal _ _, by
        simpa only [S, pointMonomial_antidiagonalPoints_eq, MinorData.exponent] using hδ⟩
    have hScard : S.card = t := by simpa only [S, antidiagonalPoints_card] using hsize
    have he := (W.large_unique S hS hScard.ge).2
    calc
      δ.exponent = pointMonomial S := (pointMonomial_antidiagonalPoints_eq _ _).symm
      _ = graphMonomial (edges S) := pointMonomial_eq_graph_edges hS
      _ = graphMonomial (edges W.largest) := congrArg graphMonomial he
      _ = pointMonomial W.largest := (pointMonomial_eq_graph_edges W.largest_admissible).symm
      _ = (pointMinor W.largest W.largest_admissible.anti).exponent :=
        (pointMinor_exponent _ _).symm
  complement_bad := by
    intro δ hsize hdiv
    rw [pointMinor_exponent, pointMonomial_eq_graph_edges W.largest_admissible,
      graphMonomial_sdiff] at hdiv
    let S := antidiagonalPoints δ.rows δ.cols
    have hS : Admissible (W.graph \ edges W.largest) S := (admissible_iff_monomial _ _).mpr
      ⟨antidiagonalPoints_isAntidiagonal _ _, by
        simpa only [S, pointMonomial_antidiagonalPoints_eq, MinorData.exponent] using hdiv⟩
    have hb := W.complement_bad S hS
    have hc : S.card = δ.size := antidiagonalPoints_card _ _
    omega
  two_cover := by
    apply (hasPackingDegree_iff_points _ 2 (t + 2)).mpr
    let S : Fin 2 → Finset (Point n) := ![W.left, W.right]
    refine ⟨S, ?_, ?_, ?_⟩
    · intro c
      fin_cases c
      · exact W.left_admissible.anti
      · exact W.right_admissible.anti
    · intro e
      simp only [Fin.sum_univ_two, S, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons]
      rw [pointMonomial_eq_graph_edges W.left_admissible,
        pointMonomial_eq_graph_edges W.right_admissible,
        ← Finsupp.add_apply, ← graphMonomial_union W.covering_disjoint, W.covering]
    · simp only [Fin.sum_univ_two, S, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons]
      rw [← W.left_admissible.card_edges, ← W.right_admissible.card_edges,
        ← Finset.card_union_of_disjoint W.covering_disjoint, W.covering, W.graph_card]

/-- An explicit, unrestricted monomial family on every allowed ambient size. -/
def obstruction (t n : ℕ) (ht : 4 ≤ t) (hn : t + 1 ≤ n) : MonomialObstruction n t :=
  (witnessIn t n ht hn).toMonomial

theorem MonomialObstruction.packing_one {n t : ℕ} (W : MonomialObstruction n t) :
    packingDegree W.monomial 1 = t := by
  apply le_antisymm
  · obtain ⟨s, a, b, hd, hm⟩ := hasPackingDegree_max W.monomial 1
    have hd' : s 0 = packingDegree W.monomial 1 := by simpa only [Fin.sum_univ_one] using hd
    have hm' : antidiagonalExponent (a 0) (b 0) ≤ W.monomial := by
      simpa only [Fin.sum_univ_one] using hm
    simpa only [← hd'] using W.maximal ⟨s 0, a 0, b 0⟩ hm'
  · apply HasPackingDegree.le_max
    refine ⟨fun _ => W.largest.size, fun _ => W.largest.rows,
      fun _ => W.largest.cols, ?_, ?_⟩
    · simpa only [Fin.sum_univ_one] using W.largest_size
    · simpa only [Fin.sum_univ_one, MinorData.exponent] using W.largest_divides

theorem MonomialObstruction.packing_two {n t : ℕ} (W : MonomialObstruction n t) :
    packingDegree W.monomial 2 = t + 2 := by
  exact le_antisymm ((packingDegree_le_degree W.monomial 2).trans_eq W.degree)
    W.two_cover.le_max

theorem MonomialObstruction.packing_all_bound {n t : ℕ} (W : MonomialObstruction n t)
    (k : ℕ) : packingDegree W.monomial k ≤ t + 2 :=
  (packingDegree_le_degree W.monomial k).trans_eq W.degree

/-- This excludes every finite product of the proposed leading monomials.
Extra degree-zero coefficient monomials are already allowed by `hdiv`.
The two grade bounds use truncated subtraction, including minors below either
threshold. No term order or coefficient-field assumption enters this lemma. -/
theorem MonomialObstruction.no_graded_factorization {n t k : ℕ}
    (W : MonomialObstruction n t) (ht : 4 ≤ t)
    (δ : Fin k → MinorData n) (a b : Fin k → ℕ)
    (ha : ∀ i, a i ≤ (δ i).size - 1)
    (hb : ∀ i, b i ≤ (δ i).size - (t - 1))
    (hdiv : (∑ i, (δ i).exponent) ≤ W.monomial)
    (ha_sum : ∑ i, a i = t) (hb_sum : ∑ i, b i = 1) : False := by
  classical
  have hdiv_single (i : Fin k) : (δ i).exponent ≤ W.monomial := by
    apply le_trans ?_ hdiv
    exact Finset.single_le_sum (f := fun j => (δ j).exponent)
      (fun j _ => zero_le) (Finset.mem_univ i)
  have hpos : 0 < ∑ i, b i := by omega
  obtain ⟨i, hi, hbi⟩ := Finset.sum_pos_iff.mp hpos
  have hsize_i : (δ i).size = t := by
    have hupper := W.maximal (δ i) (hdiv_single i)
    have hlower := hb i
    omega
  have hei := W.unique (δ i) (hdiv_single i) hsize_i
  have hrest (j : Fin k) (hji : j ≠ i) :
      (δ j).exponent ≤ W.monomial - W.largest.exponent := by
    intro e
    have hjmem : j ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩
    have hjle : (δ j).exponent e ≤ ∑ q ∈ Finset.univ.erase i, (δ q).exponent e :=
      Finset.single_le_sum (f := fun q => (δ q).exponent e)
        (fun q _ => Nat.zero_le _) hjmem
    have hparts := Finset.sum_erase_add Finset.univ (fun q => (δ q).exponent e)
      (Finset.mem_univ i)
    have hbudget : (∑ q, (δ q).exponent e) ≤ W.monomial e := by
      simpa only [Finsupp.finsetSum_apply] using hdiv e
    have hieval : (δ i).exponent e = W.largest.exponent e := congrArg (fun d => d e) hei
    change (δ j).exponent e ≤ W.monomial e - W.largest.exponent e
    omega
  have hazero (j : Fin k) (hji : j ≠ i) : a j = 0 := by
    have hs : (δ j).size < 2 := by
      by_contra hn
      exact W.complement_bad (δ j) (by omega) (hrest j hji)
    have hh := ha j
    omega
  have hsum : (∑ j, a j) = a i :=
    Finset.sum_eq_single_of_mem i (Finset.mem_univ i) (fun j _ hji => hazero j hji)
  have hi_bound := ha i
  omega

theorem score_iff_packing {n : ℕ} (m : Entry n →₀ ℕ) (r s : ℕ) (hr : 0 < r) :
    s ≤ gamma r m ↔ ∃ k, s + k * (r - 1) ≤ packingDegree m k := by
  obtain ⟨hbound,hattain⟩ := gamma_eq_max_packing m r
  constructor
  · intro hs
    by_cases hs0 : s = 0
    · subst s
      exact ⟨0,by rw [packingDegree_zero]; simp⟩
    · refine ⟨(halfShape m).getD (r-1) 0,?_⟩
      omega
  · rintro ⟨k,hk⟩
    have h := hbound k
    omega

theorem MonomialObstruction.score_two {n t : ℕ} (W : MonomialObstruction n t)
    (ht : 4 ≤ t) : gamma 2 W.monomial = t := by
  apply le_antisymm
  · by_contra hn
    have hscore : t + 1 ≤ gamma 2 W.monomial := by omega
    obtain ⟨k, hk⟩ := (score_iff_packing W.monomial 2 (t + 1) (by omega)).mp hscore
    by_cases hk0 : k = 0
    · subst k
      rw [packingDegree_zero] at hk
      omega
    by_cases hk1 : k = 1
    · subst k
      rw [W.packing_one] at hk
      omega
    have hbound := W.packing_all_bound k
    simp only [Nat.reduceSub, Nat.mul_one] at hk
    omega
  · apply (score_iff_packing W.monomial 2 t (by omega)).mpr
    exact ⟨2, by rw [W.packing_two]⟩

theorem MonomialObstruction.score_threshold {n t : ℕ} (W : MonomialObstruction n t)
    (ht : 4 ≤ t) : gamma t W.monomial = 1 := by
  apply le_antisymm
  · by_contra hn
    have hscore : 2 ≤ gamma t W.monomial := by omega
    obtain ⟨k, hk⟩ := (score_iff_packing W.monomial t 2 (by omega)).mp hscore
    by_cases hk0 : k = 0
    · subst k
      rw [packingDegree_zero] at hk
      omega
    by_cases hk1 : k = 1
    · subst k
      rw [W.packing_one] at hk
      omega
    have hbound := W.packing_all_bound k
    have hmul : 2 * (t - 1) ≤ k * (t - 1) := Nat.mul_le_mul_right (t - 1) (by omega)
    omega
  · apply (score_iff_packing W.monomial t 1 (by omega)).mpr
    exact ⟨1, by rw [W.packing_one]; omega⟩

/-- The exact two single-threshold initial-ideal memberships of the witness,
over every nontrivial coefficient ring. The simultaneous intersection step is
kept in the separate algebraic development. -/
theorem MonomialObstruction.initial_memberships {n t : ℕ}
    (W : MonomialObstruction n t) (ht : 4 ≤ t)
    (K : Type*) [CommRing K] [Nontrivial K] :
    MvPolynomial.monomial W.monomial (1 : K) ∈ symbolicAntidiagonalIdeal K n 2 t ∧
    MvPolynomial.monomial W.monomial (1 : K) ∈ symbolicAntidiagonalIdeal K n t 1 := by
  constructor
  · apply (Rees.mem_symbolicAntidiagonalIdeal_iff_gamma n K 2 t (by omega) _).mpr
    intro e he
    have heq : e = W.monomial := Finset.mem_singleton.mp
      (MvPolynomial.support_monomial_subset he)
    subst e
    simpa only [W.score_two ht] using (le_rfl : t ≤ t)
  · apply (Rees.mem_symbolicAntidiagonalIdeal_iff_gamma n K t 1 (by omega) _).mpr
    intro e he
    have heq : e = W.monomial := Finset.mem_singleton.mp
      (MvPolynomial.support_monomial_subset he)
    subst e
    simpa only [W.score_threshold ht] using (le_rfl : (1 : ℕ) ≤ 1)

/-- Proposition 7.4's unrestricted combinatorial witness, in the original
exponent language, including the exact two symbolic scores and failure of
every possible proposed minor factorization. -/
theorem obstruction_all_parameters (t n : ℕ) (ht : 4 ≤ t) (hn : t + 1 ≤ n) :
    ∃ m : Entry n →₀ ℕ,
      exponentDegree m = t + 2 ∧ packingDegree m 1 = t ∧ packingDegree m 2 = t + 2 ∧
      gamma 2 m = t ∧ gamma t m = 1 ∧
      ∀ (k : ℕ) (δ : Fin k → MinorData n) (a b : Fin k → ℕ),
        (∀ i, a i ≤ (δ i).size - 1) →
        (∀ i, b i ≤ (δ i).size - (t - 1)) →
        (∑ i, (δ i).exponent) ≤ m → (∑ i, a i) = t → (∑ i, b i) = 1 → False := by
  let W := obstruction t n ht hn
  exact ⟨W.monomial, W.degree, W.packing_one, W.packing_two,
    W.score_two ht, W.score_threshold ht,
    fun k δ a b ha hb hdiv has hbs => W.no_graded_factorization ht δ a b ha hb hdiv has hbs⟩

end FourPapers.Symmetric.SagbiObstruction

