variable {σ R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

def coefficientBasis (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R)) :
    Basis (σ →₀ ℕ) S (MvPolynomial σ S) :=
  (b.baseChange S).map (MvPolynomial.algebraTensorAlgEquiv R S).toLinearEquiv

@[simp] theorem coefficientBasis_apply (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R)) (e : σ →₀ ℕ) :
