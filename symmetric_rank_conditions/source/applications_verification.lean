/-!
# The single symbolic Rees algebra and Corollary 7.1

The algebra is defined coefficient by coefficient using genuine symbolic powers.
The leading term is certified against an actual block monomial order. A SAGBI
basis means both algebra generation and generation of the initial subalgebra.
-/

namespace FourPapers.Symmetric.Rees
open MvPolynomial Finsupp
open scoped MonomialOrder Pointwise
universe u

section General
variable {K S : Type*} [CommRing K] [CommRing S] [Algebra K S]

/-- A multiplicative ideal family defines its literal polynomial subalgebra. -/
def coefficientAlgebra (I : ℕ → Ideal S) (hzero : I 0 = ⊤)
    (hmul : ∀ a b f g, f ∈ I a → g ∈ I b → f * g ∈ I (a+b)) :
    Subalgebra K (Polynomial S) where
  carrier := {f | ∀ s, f.coeff s ∈ I s}
  mul_mem' hf hg s := by
    rw [Polynomial.coeff_mul]
    apply Ideal.sum_mem
    rintro ⟨a,b⟩ hab
    simpa only [Finset.mem_antidiagonal.mp hab] using hmul a b _ _ (hf a) (hg b)
  one_mem' s := by
    by_cases hs : s = 0
    · subst s
      simp [hzero]
    · simp [Polynomial.coeff_one, hs]
  add_mem' hf hg s := by
    rw [Polynomial.coeff_add]
    exact (I s).add_mem (hf s) (hg s)
  zero_mem' s := by simp
  algebraMap_mem' c s := by
    change (Polynomial.C (algebraMap K S c)).coeff s ∈ I s
    by_cases hs : s = 0
    · subst s
      simp [hzero]
    · simp [Polynomial.coeff_C, hs]

@[simp] theorem coefficientAlgebra_monomial_mem
    (I : ℕ → Ideal S) (hzero : I 0 = ⊤)
    (hmul : ∀ a b f g, f ∈ I a → g ∈ I b → f * g ∈ I (a+b))
    (s : ℕ) (f : S) :
    Polynomial.monomial s f ∈ coefficientAlgebra (K := K) I hzero hmul ↔ f ∈ I s := by
  constructor
  · intro h
    simpa using h s
  · intro h i
    by_cases hi : s = i
    · subst i
      simpa using h
    · simp [Polynomial.coeff_monomial, hi]

/-- The symbolic Rees algebra, defined independently of all proposed generators. -/
def symbolicRees (P : Ideal S) [P.IsPrime] : Subalgebra K (Polynomial S) :=
  coefficientAlgebra (symbolicPower P) (symbolicPower_zero P)
    (fun _ _ _ _ hf hg => mul_mem_symbolicPower_add P hf hg)

@[simp] theorem symbolicRees_monomial_mem (P : Ideal S) [P.IsPrime]
    (s : ℕ) (f : S) :
    Polynomial.monomial s f ∈ symbolicRees (K := K) P ↔ f ∈ symbolicPower P s :=
  coefficientAlgebra_monomial_mem _ _ _ s f

@[simp] theorem C_mem_symbolicRees (P : Ideal S) [P.IsPrime] (f : S) :
    Polynomial.C f ∈ symbolicRees (K := K) P := by
  change Polynomial.monomial 0 f ∈ symbolicRees (K := K) P
  apply (symbolicRees_monomial_mem (K := K) P 0 f).mpr
  rw [symbolicPower_zero]
  exact Submodule.mem_top

/-- Lifting a fixed homogeneous coefficient respects generation of its ideal. -/
theorem monomial_mem_of_span (A : Subalgebra K (Polynomial S))
    (hC : ∀ c : S, Polynomial.C c ∈ A) (s : ℕ) (G : Set S)
    (hG : ∀ g ∈ G, Polynomial.monomial s g ∈ A)
    {f : S} (hf : f ∈ Ideal.span G) : Polynomial.monomial s f ∈ A := by
  induction hf using Submodule.span_induction with
  | mem g hg => exact hG g hg
  | zero => simpa using A.zero_mem
  | add f g hf hg ihf ihg =>
      simpa only [map_add] using A.add_mem ihf ihg
  | smul c f hf ih =>
      rw [smul_eq_mul, ← Polynomial.C_mul_monomial]
      exact A.mul_mem (hC c) ih

theorem polynomial_monomial_sum_prod {ι : Type*} (s : Finset ι)
    (a : ι → ℕ) (f : ι → S) :
    Polynomial.monomial (∑ i ∈ s, a i) (∏ i ∈ s, f i) =
      ∏ i ∈ s, Polynomial.monomial (a i) (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.prod_insert hi, Finset.prod_insert hi,
        ← Polynomial.monomial_mul_monomial, ih]

end General

section Leading
variable {σ K : Type*} [CommRing K]

/-- Compare the new variable's degree first, then use `m` on the old variables. -/
def tFirstOrder (m : MonomialOrder σ) : MonomialOrder (Option σ) where
  syn := ℕ ×ₗ m.syn
  isOrderedAddMonoid_syn :=
    { add_le_add_left := by
        intro a b hab c
        apply Prod.Lex.le_iff.mpr
        change (ofLex a).1 + (ofLex c).1 < (ofLex b).1 + (ofLex c).1 ∨
          ((ofLex a).1 + (ofLex c).1 = (ofLex b).1 + (ofLex c).1 ∧
            (ofLex a).2 + (ofLex c).2 ≤ (ofLex b).2 + (ofLex c).2)
        rcases Prod.Lex.le_iff.mp hab with h | ⟨h₁, h₂⟩
        · exact Or.inl (Nat.add_lt_add_right h _)
        · exact Or.inr ⟨congrArg (fun z : ℕ => z + (ofLex c).1) h₁,
            IsOrderedAddMonoid.add_le_add_left _ _ h₂ _⟩ }
  toSyn :=
    { toEquiv := (Finsupp.optionEquiv.trans
        ((Equiv.refl ℕ).prodCongr m.toSyn.toEquiv)).trans toLex
      map_add' a b := by
        change ((a+b) none, m.toSyn (a+b).some) =
          (a none + b none, m.toSyn a.some + m.toSyn b.some)
        simp only [Finsupp.add_apply, Finsupp.some_add, map_add] }
  toSyn_monotone := by
    intro a b h
    exact Prod.Lex.toLex_mono ⟨h none, m.toSyn_monotone (fun i => h (Option.some i))⟩

@[simp] theorem tFirstOrder_le_iff (m : MonomialOrder σ)
    (a b : Option σ →₀ ℕ) :
    a ≼[tFirstOrder m] b ↔
      a none < b none ∨ a none = b none ∧ a.some ≼[m] b.some :=
  Prod.Lex.toLex_le_toLex

/-- The literal leading term for the order of Corollary 7.1. -/
def tFirstLeadingTerm (m : MonomialOrder σ) (f : Polynomial (MvPolynomial σ K)) :
    Polynomial (MvPolynomial σ K) :=
  Polynomial.monomial f.natDegree (m.leadingTerm f.leadingCoeff)

@[simp] theorem tFirstLeadingTerm_zero (m : MonomialOrder σ) :
    tFirstLeadingTerm m (0 : Polynomial (MvPolynomial σ K)) = 0 := by
  simp [tFirstLeadingTerm]

@[simp] theorem tFirstLeadingTerm_monomial (m : MonomialOrder σ)
    (s : ℕ) (f : MvPolynomial σ K) :
    tFirstLeadingTerm m (Polynomial.monomial s f) =
      Polynomial.monomial s (m.leadingTerm f) := by
  by_cases hf : f = 0
  · simp [hf]
  · simp [tFirstLeadingTerm, Polynomial.natDegree_monomial_eq _ hf]

@[simp] theorem tFirstLeadingTerm_C (m : MonomialOrder σ) (f : MvPolynomial σ K) :
    tFirstLeadingTerm m (Polynomial.C f) = Polynomial.C (m.leadingTerm f) := by
  simpa only [Polynomial.monomial_zero_left] using tFirstLeadingTerm_monomial m 0 f

/-- Certification that the polynomial formula is the leading term of the actual
block monomial order, under Mathlib's variable-separation equivalence. -/
theorem tFirstLeadingTerm_eq_block (m : MonomialOrder σ)
    (p : MvPolynomial (Option σ) K) :
    optionEquivLeft K σ ((tFirstOrder m).leadingTerm p) =
      tFirstLeadingTerm m (optionEquivLeft K σ p) := by
  classical
  by_cases hp : p = 0
  · simp [hp]
  let q := optionEquivLeft K σ p
  have hq : q ≠ 0 := fun h => hp ((optionEquivLeft K σ).injective (h.trans (map_zero _).symm))
  let d := (m.degree q.leadingCoeff).optionElim q.natDegree
  have hd : d ∈ p.support := by
    apply (mem_support_coeff_optionEquivLeft K).mp
    change m.degree q.leadingCoeff ∈ (q.coeff q.natDegree).support
    rw [Polynomial.coeff_natDegree]
    exact m.degree_mem_support (Polynomial.leadingCoeff_ne_zero.mpr hq)
  have hle : (tFirstOrder m).degree p ≼[tFirstOrder m] d := by
    apply (tFirstOrder m).degree_le_iff.mpr
    intro c hc
    have hc' : c.some ∈ (q.coeff (c none)).support := by
      apply (mem_support_coeff_optionEquivLeft K).mpr
      simpa only [Finsupp.optionElim_some] using hc
    have hcn : q.coeff (c none) ≠ 0 := by
      intro hz
      simpa only [hz, MvPolynomial.support_zero, Finset.notMem_empty] using hc'
    have hcnle := Polynomial.le_natDegree_of_ne_zero hcn
    rw [tFirstOrder_le_iff]
    simp only [d, Finsupp.optionElim_apply_none, Finsupp.some_optionElim]
    rcases hcnle.eq_or_lt with heq | hlt
    · right
      refine ⟨heq, m.le_degree ?_⟩
      simpa only [heq, Polynomial.coeff_natDegree] using hc'
    · exact Or.inl hlt
  have hdeg : (tFirstOrder m).degree p = d :=
    (tFirstOrder m).toSyn.injective (le_antisymm hle ((tFirstOrder m).le_degree hd))
  have hcoeff : (tFirstOrder m).leadingCoeff p = m.leadingCoeff q.leadingCoeff := by
    unfold MonomialOrder.leadingCoeff
    rw [hdeg]
    change p.coeff ((m.degree q.leadingCoeff).optionElim q.natDegree) =
      q.leadingCoeff.coeff (m.degree q.leadingCoeff)
    rw [← optionEquivLeft_coeff_coeff]
    rfl
  rw [MonomialOrder.leadingTerm, hdeg, hcoeff, optionEquivLeft_monomial]
  simp only [d, Finsupp.optionElim_apply_none, Finsupp.some_optionElim]
  rfl

/-- The initial algebra is generated by leading terms of actual algebra elements. -/
def initialAlgebra (m : MonomialOrder σ)
    (A : Subalgebra K (Polynomial (MvPolynomial σ K))) :
    Subalgebra K (Polynomial (MvPolynomial σ K)) :=
  Algebra.adjoin K (tFirstLeadingTerm m '' (A : Set _))

/-- Both requirements in the paper's definition of a SAGBI basis. -/
def IsSagbiBasis (m : MonomialOrder σ)
    (A : Subalgebra K (Polynomial (MvPolynomial σ K)))
    (G : Set (Polynomial (MvPolynomial σ K))) : Prop :=
  Algebra.adjoin K G = A ∧
    Algebra.adjoin K (tFirstLeadingTerm m '' G) = initialAlgebra m A

/-- Once all entries occur, every degree-zero coefficient polynomial occurs. -/
theorem C_mem_of_variables (A : Subalgebra K (Polynomial (MvPolynomial σ K)))
    (hX : ∀ i, Polynomial.C (X i) ∈ A) (f : MvPolynomial σ K) : Polynomial.C f ∈ A := by
  induction f using MvPolynomial.induction_on with
  | C c => exact A.algebraMap_mem c
  | add f g hf hg => simpa only [map_add] using A.add_mem hf hg
  | mul_X f i hf => simpa only [map_mul] using A.mul_mem hf (hX i)

def coefficientInitial (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ K)) :
    Ideal (MvPolynomial σ K) := Ideal.span (m.leadingTerm '' (I : Set _))

theorem coefficientInitial_mono (m : MonomialOrder σ)
    {I J : Ideal (MvPolynomial σ K)} (h : I ≤ J) :
    coefficientInitial m I ≤ coefficientInitial m J :=
  Ideal.span_mono (Set.image_mono h)

@[simp] theorem coefficientInitial_top (m : MonomialOrder σ) :
    coefficientInitial m (⊤ : Ideal (MvPolynomial σ K)) = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  exact Ideal.subset_span ⟨1, Submodule.mem_top, by simp⟩

theorem coefficientInitial_mul_le [NoZeroDivisors K] (m : MonomialOrder σ)
    (I J : Ideal (MvPolynomial σ K)) :
    coefficientInitial m I * coefficientInitial m J ≤ coefficientInitial m (I*J) := by
  rw [coefficientInitial, coefficientInitial, Ideal.span_mul_span]
  apply Ideal.span_le.mpr
  rintro _ ⟨_, ⟨f,hf,rfl⟩, _, ⟨g,hg,rfl⟩, rfl⟩
  exact Ideal.subset_span ⟨f*g, Ideal.mul_mem_mul hf hg, m.leadingTerm_mul f g⟩

theorem coefficientInitial_symbolic_mul [NoZeroDivisors K] (m : MonomialOrder σ)
    (P : Ideal (MvPolynomial σ K)) [P.IsPrime]
    (a b : ℕ) (f g : MvPolynomial σ K)
    (hf : f ∈ coefficientInitial m (symbolicPower P a))
    (hg : g ∈ coefficientInitial m (symbolicPower P b)) :
    f*g ∈ coefficientInitial m (symbolicPower P (a+b)) := by
  apply coefficientInitial_mono m
    (Ideal.mul_le.mpr (fun _ hx _ hy => mul_mem_symbolicPower_add P hx hy))
  exact coefficientInitial_mul_le m _ _ (Ideal.mul_mem_mul hf hg)

/-- The direct sum of the coefficient initial ideals, as an actual subalgebra. -/
def initialCoefficientAlgebra [NoZeroDivisors K] (m : MonomialOrder σ)
    (P : Ideal (MvPolynomial σ K)) [P.IsPrime] :
    Subalgebra K (Polynomial (MvPolynomial σ K)) :=
  coefficientAlgebra (fun s => coefficientInitial m (symbolicPower P s))
    (by simp) (coefficientInitial_symbolic_mul m P)

/-- For the T-first order the initial algebra has exactly the initial ideals as
its homogeneous coefficient spaces. No Gröbner hypothesis is needed. -/
theorem initialAlgebra_symbolicRees_eq [NoZeroDivisors K] (m : MonomialOrder σ)
    (P : Ideal (MvPolynomial σ K)) [P.IsPrime] :
    initialAlgebra m (symbolicRees (K := K) P) = initialCoefficientAlgebra m P := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨f,hf,rfl⟩
    change Polynomial.monomial f.natDegree (m.leadingTerm f.leadingCoeff) ∈
      initialCoefficientAlgebra m P
    rw [initialCoefficientAlgebra, coefficientAlgebra_monomial_mem]
    exact Ideal.subset_span ⟨f.leadingCoeff, hf f.natDegree, rfl⟩
  · let A := initialAlgebra m (symbolicRees (K := K) P)
    have hC : ∀ c : MvPolynomial σ K, Polynomial.C c ∈ A := by
      apply C_mem_of_variables
      intro i
      apply Algebra.subset_adjoin
      refine ⟨Polynomial.C (X i), C_mem_symbolicRees P _, ?_⟩
      simp
    intro f hf
    change ∀ s, f.coeff s ∈ coefficientInitial m (symbolicPower P s) at hf
    rw [f.as_sum_support]
    apply Subalgebra.sum_mem _ _
    intro s hs
    change Polynomial.monomial s (f.coeff s) ∈ A
    have hfs : f.coeff s ∈ Ideal.span
        (m.leadingTerm '' (symbolicPower P s : Set (MvPolynomial σ K))) := hf s
    refine monomial_mem_of_span (K := K) (S := MvPolynomial σ K) A hC s
      (m.leadingTerm '' (symbolicPower P s : Set (MvPolynomial σ K))) ?_ hfs
    rintro _ ⟨g,hg,rfl⟩
    rw [← tFirstLeadingTerm_monomial]
    exact Algebra.subset_adjoin ⟨Polynomial.monomial s g,
      (symbolicRees_monomial_mem P s g).mpr hg, rfl⟩

end Leading

section Normalization
variable {σ K : Type*} [Field K]

/-- The coefficient-one leading monomial; the zero polynomial contributes zero. -/
def tFirstLeadingMonomial (m : MonomialOrder σ)
    (f : Polynomial (MvPolynomial σ K)) : Polynomial (MvPolynomial σ K) := by
  classical
  exact if f = 0 then 0 else
    Polynomial.monomial f.natDegree (monomial (m.degree f.leadingCoeff) 1)

/-- The literal leading term differs from its leading monomial only by its
nonzero coefficient. This also handles the zero polynomial explicitly. -/
theorem tFirstLeadingTerm_eq_smul_leadingMonomial (m : MonomialOrder σ)
    (f : Polynomial (MvPolynomial σ K)) :
    tFirstLeadingTerm m f = m.leadingCoeff f.leadingCoeff • tFirstLeadingMonomial m f := by
  classical
  by_cases hf : f = 0
  · simp [hf, tFirstLeadingMonomial]
  · simp [tFirstLeadingMonomial, hf, tFirstLeadingTerm, MonomialOrder.leadingTerm,
      Polynomial.smul_monomial, MvPolynomial.smul_monomial, smul_eq_mul]

/-- Over the coefficient field, either form belongs to a subalgebra exactly
when the other does; no monicity assumption on the algebra element is needed. -/
theorem tFirstLeadingTerm_mem_iff_leadingMonomial_mem (m : MonomialOrder σ)
    (A : Subalgebra K (Polynomial (MvPolynomial σ K)))
    (f : Polynomial (MvPolynomial σ K)) :
    tFirstLeadingTerm m f ∈ A ↔ tFirstLeadingMonomial m f ∈ A := by
  classical
  by_cases hf : f = 0
  · simp [hf, tFirstLeadingMonomial]
  have hc : m.leadingCoeff f.leadingCoeff ≠ 0 :=
    m.leadingCoeff_ne_zero_iff.mpr (Polynomial.leadingCoeff_ne_zero.mpr hf)
  rw [tFirstLeadingTerm_eq_smul_leadingMonomial]
  constructor
  · intro h
    simpa only [inv_smul_smul₀ hc] using A.smul_mem h (m.leadingCoeff f.leadingCoeff)⁻¹
  · intro h
    exact A.smul_mem h _

/-- The initial-algebra construction agrees literally with generation by
coefficient-one leading monomials, as used in the paper. -/
theorem adjoin_leadingTerms_eq_adjoin_leadingMonomials (m : MonomialOrder σ)
    (G : Set (Polynomial (MvPolynomial σ K))) :
    Algebra.adjoin K (tFirstLeadingTerm m '' G) =
      Algebra.adjoin K (tFirstLeadingMonomial m '' G) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨f,hf,rfl⟩
    exact (tFirstLeadingTerm_mem_iff_leadingMonomial_mem m _ f).mpr
      (Algebra.subset_adjoin ⟨f,hf,rfl⟩)
  · apply Algebra.adjoin_le
    rintro _ ⟨f,hf,rfl⟩
    exact (tFirstLeadingTerm_mem_iff_leadingMonomial_mem m _ f).mp
      (Algebra.subset_adjoin ⟨f,hf,rfl⟩)

/-- The SAGBI predicate is equivalent to the paper's coefficient-one
leading-monomial formulation. -/
theorem isSagbiBasis_iff_monomial (m : MonomialOrder σ)
    (A : Subalgebra K (Polynomial (MvPolynomial σ K)))
    (G : Set (Polynomial (MvPolynomial σ K))) :
    IsSagbiBasis m A G ↔ Algebra.adjoin K G = A ∧
      Algebra.adjoin K (tFirstLeadingMonomial m '' G) =
        Algebra.adjoin K (tFirstLeadingMonomial m '' (A : Set _)) := by
  unfold IsSagbiBasis initialAlgebra
  have hG := adjoin_leadingTerms_eq_adjoin_leadingMonomials (K := K) m G
  have hA := adjoin_leadingTerms_eq_adjoin_leadingMonomials (K := K) m
    (A : Set (Polynomial (MvPolynomial σ K)))
  constructor
  · rintro ⟨hgen, hinit⟩
    exact ⟨hgen, hG.symm.trans (hinit.trans hA)⟩
  · rintro ⟨hgen, hinit⟩
    exact ⟨hgen, hG.trans (hinit.trans hA.symm)⟩

end Normalization

section SingleScore
variable {n : ℕ} (K : Type u) [Field K] (t : ℕ)

def minorLift (δ : MinorData n) : Polynomial (CoordinateRing n K) :=
  Polynomial.monomial (δ.size-t+1) (δ.polynomial K)

/-- Exactly the finite collection displayed in Corollary 7.1. -/
def singleGenerators : Set (Polynomial (CoordinateRing n K)) :=
  Set.range (fun e : Entry n => Polynomial.C (X e)) ∪
    minorLift K t '' {δ : MinorData n | t ≤ δ.size}

theorem singleGenerators_finite : (singleGenerators (n := n) K t).Finite :=
  (Set.finite_range _).union ((Set.toFinite _).image _)

variable [(determinantalIdeal n K t).IsPrime]

/-- A fixed positive symbolic-degree Gröbner theorem supplies both SAGBI
assertions, with no generator-algebra equality as an assumption. -/
theorem single_sagbi_of_symbolicGroebner
    (hG : ∀ s, 0 < s → (foldedOrder n).IsGroebnerBasis
      (symbolicGenerators K n t s) (symbolicPower (determinantalIdeal n K t) s)) :
    IsSagbiBasis (foldedOrder n) (symbolicRees (K := K) (determinantalIdeal n K t))
      (singleGenerators K t) := by
  classical
  let P := determinantalIdeal n K t
  let G := singleGenerators (n := n) K t
  let m := foldedOrder n
  have hsub : G ⊆ symbolicRees (K := K) P := by
    rintro f (⟨e,rfl⟩ | ⟨δ,hδ,rfl⟩)
    · exact C_mem_symbolicRees P _
    · apply (symbolicRees_monomial_mem P _ _).mpr
      apply (hG (δ.size-t+1) (Nat.zero_lt_succ _)).subset
      exact ⟨1, fun _ => δ, fun _ => hδ, by simp, by simp⟩
  constructor
  · apply le_antisymm (Algebra.adjoin_le hsub)
    let A := Algebra.adjoin K G
    have hC : ∀ c : CoordinateRing n K, Polynomial.C c ∈ A :=
      C_mem_of_variables A (fun e => Algebra.subset_adjoin (Or.inl ⟨e,rfl⟩))
    intro f hf
    rw [f.as_sum_support]
    apply Subalgebra.sum_mem _ _
    intro s hs
    by_cases hs0 : s = 0
    · subst s
      simpa only [Polynomial.monomial_zero_left] using hC (f.coeff 0)
    · apply monomial_mem_of_span A hC s (symbolicGenerators K n t s)
      · rintro g ⟨k,δ,hδ,hscore,rfl⟩
        rw [← hscore, polynomial_monomial_sum_prod]
        apply Subalgebra.prod_mem
        intro j _
        exact Algebra.subset_adjoin (Or.inr ⟨δ j,hδ j,rfl⟩)
      · rw [← (hG s (Nat.pos_of_ne_zero hs0)).ideal_eq_span]
        exact hf s
  · apply le_antisymm
    · exact Algebra.adjoin_mono (Set.image_mono hsub)
    · apply Algebra.adjoin_le
      let A := Algebra.adjoin K (tFirstLeadingTerm m '' G)
      have hC : ∀ c : CoordinateRing n K, Polynomial.C c ∈ A := by
        apply C_mem_of_variables
        intro e
        exact Algebra.subset_adjoin ⟨Polynomial.C (X e), Or.inl ⟨e,rfl⟩, by simp⟩
      rintro _ ⟨f,hf,rfl⟩
      change Polynomial.monomial f.natDegree (m.leadingTerm f.leadingCoeff) ∈ A
      by_cases hs0 : f.natDegree = 0
      · rw [hs0, Polynomial.monomial_zero_left]
        exact hC _
      · apply monomial_mem_of_span A hC f.natDegree
          (m.leadingTerm '' symbolicGenerators K n t f.natDegree)
        · rintro _ ⟨g,⟨k,δ,hδ,hscore,rfl⟩,rfl⟩
          rw [← hscore, m.leadingTerm_prod_of_regular]
          · rw [polynomial_monomial_sum_prod]
            apply Subalgebra.prod_mem
            intro j _
            exact Algebra.subset_adjoin ⟨minorLift K t (δ j),
              Or.inr ⟨δ j,hδ j,rfl⟩, tFirstLeadingTerm_monomial m _ _⟩
          · intro j _
            exact ((δ j).leadingCoeff_polynomial_isUnit K).isRegular
        · apply (hG f.natDegree (Nat.pos_of_ne_zero hs0)).span_leadingTerm_image.le
          exact Ideal.subset_span ⟨f.leadingCoeff, hf f.natDegree, rfl⟩

end SingleScore

/-- The core theorem specializes to the full symbolic ideal with no northwest
constraints. This uses the actual maximal-size bound, not an assumed generator
formula. -/
theorem full_symbolic_groebner (n : ℕ) (K : Type u) [Field K]
    (t s : ℕ) (ht : 0 < t) (htn : t ≤ n) (hs : 0 < s) :
    (foldedOrder n).IsGroebnerBasis (symbolicGenerators K n t s)
      (symbolicPower (determinantalIdeal n K t) s) := by
  let r : RankArray n := fun _ _ => n
  have hE : northwestGenerators K r = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro f ⟨i,j,a,b,ha,hb,hf⟩
    have hcard := Fintype.card_le_of_injective _ a.injective
    simp only [Fintype.card_fin] at hcard
    dsimp [r] at hcard
    omega
  have hI : northwestIdeal K r = ⊥ := by rw [northwestIdeal,hE,Ideal.span_empty]
  have h := compatible_rank_and_symbolic_conditions n K r (fun _ _ => rfl) [(t,s)]
    (by
      intro ts hts
      have heq : ts = (t,s) := by simpa using hts
      subst ts
      exact ⟨ht,htn,hs⟩)
  simpa [mixedGenerators,mixedIdeal,hE,hI] using h

theorem determinantal_prime (n : ℕ) (K : Type u) [Field K] (t : ℕ) (ht : 0 < t) :
    (determinantalIdeal n K t).IsPrime :=
  determinantalIdeals_prime_of_northwestGroebner northwest_groebner n K t ht

/-- The actual single symbolic Rees algebra for a positive determinantal size. -/
def determinantalSymbolicRees (n : ℕ) (K : Type u) [Field K] (t : ℕ) (ht : 0 < t) :
    Subalgebra K (Polynomial (CoordinateRing n K)) := by
  letI := determinantal_prime n K t ht
  exact symbolicRees (determinantalIdeal n K t)

/-- Corollary 7.1: both literal SAGBI assertions and finiteness, uniformly over
all fields and all valid minor sizes. -/
theorem corollary_7_1_sagbi (n : ℕ) (K : Type u) [Field K] (t : ℕ)
    (ht : 0 < t) (htn : t ≤ n) :
    (singleGenerators (n := n) K t).Finite ∧
    IsSagbiBasis (foldedOrder n) (determinantalSymbolicRees n K t ht)
      (singleGenerators K t) := by
  letI := determinantal_prime n K t ht
  exact ⟨singleGenerators_finite K t,
    single_sagbi_of_symbolicGroebner K t (fun s hs => full_symbolic_groebner n K t s ht htn hs)⟩


/-- The exponents of exactly the proposed symbolic antidiagonal products. -/
def symbolicExponentSet (n t s : ℕ) : Set (Entry n →₀ ℕ) :=
  {e | ∃ (k : ℕ) (δ : Fin k → MinorData n),
    (∀ j, t ≤ (δ j).size) ∧ (∑ j, ((δ j).size-t+1)) = s ∧
    e = ∑ j, (δ j).exponent}

theorem symbolicAntidiagonalIdeal_eq_span_exponents (n : ℕ)
    (R : Type*) [CommRing R] (t s : ℕ) :
    symbolicAntidiagonalIdeal R n t s =
      Ideal.span ((fun e => monomial e (1 : R)) '' symbolicExponentSet n t s) := by
  unfold symbolicAntidiagonalIdeal
  apply congrArg Ideal.span
  ext f
  constructor
  · rintro ⟨k,δ,hsize,hscore,rfl⟩
    exact ⟨∑ j, (δ j).exponent, ⟨k,δ,hsize,hscore,rfl⟩, rfl⟩
  · rintro ⟨e,⟨k,δ,hsize,hscore,rfl⟩,rfl⟩
    exact ⟨k,δ,hsize,hscore,rfl⟩

/-- Membership is actual monomial divisibility, with every folded multiplicity
retained; this statement is valid over any commutative coefficient ring. -/
theorem mem_symbolicAntidiagonalIdeal_iff (n : ℕ)
    (R : Type*) [CommRing R] (t s : ℕ) (f : CoordinateRing n R) :
    f ∈ symbolicAntidiagonalIdeal R n t s ↔
      ∀ e ∈ f.support, HasSymbolicAntidiagonal t s e := by
  rw [symbolicAntidiagonalIdeal_eq_span_exponents, mem_ideal_span_monomial_image]
  constructor
  · intro h e he
    obtain ⟨d,⟨k,δ,hsize,hscore,rfl⟩,hle⟩ := h e he
    exact ⟨k,δ,hsize,hscore,hle⟩
  · intro h e he
    obtain ⟨k,δ,hsize,hscore,hle⟩ := h e he
    exact ⟨∑ j, (δ j).exponent, ⟨k,δ,hsize,hscore,rfl⟩, hle⟩

/-- The score here is the paper's actual half-shape tail from paired insertion. -/
theorem mem_symbolicAntidiagonalIdeal_iff_gamma (n : ℕ)
    (R : Type*) [CommRing R] (t s : ℕ) (ht : 0 < t) (f : CoordinateRing n R) :
    f ∈ symbolicAntidiagonalIdeal R n t s ↔ ∀ e ∈ f.support, s ≤ gamma t e := by
  rw [mem_symbolicAntidiagonalIdeal_iff]
  constructor
  · intro h e he
    exact (hasSymbolicAntidiagonal_iff_gamma e t s ht).mp (h e he)
  · intro h e he
    exact (hasSymbolicAntidiagonal_iff_gamma e t s ht).mpr (h e he)

/-- A genuine symbolic Gröbner basis identifies the coefficient initial ideal
with the literal folded antidiagonal ideal. -/
theorem coefficientInitial_symbolic_eq_of_groebner (n : ℕ)
    (K : Type u) [Field K] (t s : ℕ)
    (hG : (foldedOrder n).IsGroebnerBasis (symbolicGenerators K n t s)
      (symbolicPower (determinantalIdeal n K t) s)) :
    coefficientInitial (foldedOrder n) (symbolicPower (determinantalIdeal n K t) s) =
      symbolicAntidiagonalIdeal K n t s := by
  unfold coefficientInitial
  rw [hG.span_leadingTerm_image,
    (foldedOrder n).span_leadingTerm_eq_span_monomial_degree_of_units
      (symbolicGenerators K n t s) (by
        rintro g ⟨k,δ,hsize,hscore,rfl⟩
        exact product_minors_leadingCoeff_isUnit K δ)]
  unfold symbolicAntidiagonalIdeal
  apply congrArg Ideal.span
  ext f
  constructor
  · rintro ⟨g,⟨k,δ,hsize,hscore,rfl⟩,rfl⟩
    refine ⟨k,δ,hsize,hscore,?_⟩
    change monomial ((foldedOrder n).degree (∏ j, (δ j).polynomial K)) (1 : K) =
      monomial (∑ j, (δ j).exponent) 1
    rw [product_minors_degree K δ]
  · rintro ⟨k,δ,hsize,hscore,rfl⟩
    refine ⟨∏ j, (δ j).polynomial K, ⟨k,δ,hsize,hscore,rfl⟩, ?_⟩
    change monomial ((foldedOrder n).degree (∏ j, (δ j).polynomial K)) (1 : K) =
      monomial (∑ j, (δ j).exponent) 1
    rw [product_minors_degree K δ]

/-- Every symbolic degree, including degree zero, is described by the genuine
symbolic score. No assumed symbolic generation formula occurs in the statement. -/
theorem mem_coefficientInitial_symbolic_iff_gamma (n : ℕ)
    (K : Type u) [Field K] (t s : ℕ) (ht : 0 < t) (htn : t ≤ n)
    (f : CoordinateRing n K) :
    f ∈ coefficientInitial (foldedOrder n) (symbolicPower (determinantalIdeal n K t) s) ↔
      ∀ e ∈ f.support, s ≤ gamma t e := by
  letI := determinantal_prime n K t ht
  by_cases hs : s = 0
  · subst s
    simp
  · rw [coefficientInitial_symbolic_eq_of_groebner n K t s
      (full_symbolic_groebner n K t s ht htn (Nat.pos_of_ne_zero hs))]
    exact mem_symbolicAntidiagonalIdeal_iff_gamma n K t s ht f

/-- The full initial-algebra membership criterion in Corollary 7.1. It describes
all finite polynomial sums, not merely individual monomials or bounded degrees. -/
theorem mem_initialSymbolicRees_iff_gamma (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n) (f : Polynomial (CoordinateRing n K)) :
    f ∈ initialAlgebra (foldedOrder n) (determinantalSymbolicRees n K t ht) ↔
      ∀ s, ∀ e ∈ (f.coeff s).support, s ≤ gamma t e := by
  letI := determinantal_prime n K t ht
  change f ∈ initialAlgebra (foldedOrder n)
    (symbolicRees (K := K) (determinantalIdeal n K t)) ↔ _
  rw [initialAlgebra_symbolicRees_eq]
  change (∀ s, f.coeff s ∈ coefficientInitial (foldedOrder n)
    (symbolicPower (determinantalIdeal n K t) s)) ↔ _
  exact forall_congr' (fun s =>
    mem_coefficientInitial_symbolic_iff_gamma n K t s ht htn (f.coeff s))

/-- The exact exponent set in the displayed monomial basis. `none` is `T`;
`some e` is the symmetric matrix entry indexed by `e`. -/
def gammaExponents (n t : ℕ) : Set (Option (Entry n) →₀ ℕ) :=
  {d | d none ≤ gamma t d.some}

/-- The literal gamma-constrained support module is linearly isomorphic to the
actual initial subalgebra, through Mathlib's coordinate separation equivalence. -/
def initialSupportEquiv (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n) :
    restrictSupport K (gammaExponents n t) ≃ₗ[K]
      initialAlgebra (foldedOrder n) (determinantalSymbolicRees n K t ht) := by
  let e := optionEquivLeft K (Entry n)
  let F : restrictSupport K (gammaExponents n t) →ₗ[K]
      initialAlgebra (foldedOrder n) (determinantalSymbolicRees n K t ht) :=
    { toFun := fun p => ⟨e p, by
        apply (mem_initialSymbolicRees_iff_gamma n K t ht htn (e p)).mpr
        intro s d hd
        have hd' : d.optionElim s ∈ (p : MvPolynomial (Option (Entry n)) K).support :=
          (mem_support_coeff_optionEquivLeft K).mp hd
        have h := (mem_restrictSupport_iff K).mp p.2 hd'
        change (d.optionElim s) none ≤ gamma t (d.optionElim s).some at h
        simpa only [Finsupp.optionElim_apply_none,
          Finsupp.some_optionElim] using h⟩
      map_add' := by intro p q; apply Subtype.ext; exact e.map_add _ _
      map_smul' := by intro c p; apply Subtype.ext; exact e.toLinearEquiv.map_smul _ _ }
  apply LinearEquiv.ofBijective F
  constructor
  · intro p q hpq
    apply Subtype.ext
    exact e.injective (congrArg Subtype.val hpq)
  · intro y
    let p := e.symm (y : Polynomial (CoordinateRing n K))
    have hp : p ∈ restrictSupport K (gammaExponents n t) := by
      apply (mem_restrictSupport_iff K).mpr
      intro d hd
      change d none ≤ gamma t d.some
      have hd' : d.some ∈ ((e p).coeff (d none)).support := by
        apply (mem_support_coeff_optionEquivLeft K).mpr
        simpa only [Finset.mem_coe, Finsupp.optionElim_some] using hd
      have he : e p = (y : Polynomial (CoordinateRing n K)) := e.apply_symm_apply _
      rw [he] at hd'
      exact (mem_initialSymbolicRees_iff_gamma n K t ht htn y).mp y.2 _ _ hd'
    refine ⟨⟨p,hp⟩, ?_⟩
    apply Subtype.ext
    exact e.apply_symm_apply _

@[simp] theorem initialSupportEquiv_apply (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n)
    (p : restrictSupport K (gammaExponents n t)) :
    (initialSupportEquiv n K t ht htn p : Polynomial (CoordinateRing n K)) =
      optionEquivLeft K (Entry n) (p : MvPolynomial (Option (Entry n)) K) := by
  rfl

/-- A genuine unrestricted vector-space basis of the initial symbolic Rees algebra. -/
def initialGammaBasis (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n) :
    Module.Basis (gammaExponents n t) K
      (initialAlgebra (foldedOrder n) (determinantalSymbolicRees n K t ht)) :=
  (basisRestrictSupport K (gammaExponents n t)).map (initialSupportEquiv n K t ht htn)

/-- Every vector of the basis is exactly the stated matrix monomial times `T^s`. -/
@[simp] theorem initialGammaBasis_apply (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n) (d : gammaExponents n t) :
    (initialGammaBasis n K t ht htn d : Polynomial (CoordinateRing n K)) =
      Polynomial.monomial (d.val none) (monomial d.val.some 1) := by
  rw [initialGammaBasis, Module.Basis.map_apply, initialSupportEquiv_apply,
    basisRestrictSupport_apply_coe, optionEquivLeft_monomial]

/-- These exponents are exactly the paper's pairs `(m,s)` with `gamma_t(m) >= s`. -/
def gammaExponentPairEquiv (n t : ℕ) :
    gammaExponents n t ≃ {p : (Entry n →₀ ℕ) × ℕ // p.2 ≤ gamma t p.1} where
  toFun d := ⟨(d.val.some,d.val none),d.property⟩
  invFun p := ⟨p.val.1.optionElim p.val.2, by
    change (p.val.1.optionElim p.val.2) none ≤ gamma t (p.val.1.optionElim p.val.2).some
    simpa only [Finsupp.optionElim_apply_none,
      Finsupp.some_optionElim] using p.property⟩
  left_inv d := by
    apply Subtype.ext
    exact Finsupp.optionElim_some d.val
  right_inv p := by
    apply Subtype.ext
    simp only [Finsupp.optionElim_apply_none, Finsupp.some_optionElim]

/-- Corollary 7.1's monomial basis, indexed in the paper's literal `(m,s)` form. -/
def corollary_7_1_monomialBasis (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n) :
    Module.Basis {p : (Entry n →₀ ℕ) × ℕ // p.2 ≤ gamma t p.1} K
      (initialAlgebra (foldedOrder n) (determinantalSymbolicRees n K t ht)) :=
  (initialGammaBasis n K t ht htn).reindex (gammaExponentPairEquiv n t)

@[simp] theorem corollary_7_1_monomialBasis_apply (n : ℕ) (K : Type u) [Field K]
    (t : ℕ) (ht : 0 < t) (htn : t ≤ n)
    (p : {p : (Entry n →₀ ℕ) × ℕ // p.2 ≤ gamma t p.1}) :
    (corollary_7_1_monomialBasis n K t ht htn p : Polynomial (CoordinateRing n K)) =
      Polynomial.monomial p.val.2 (monomial p.val.1 1) := by
  rw [corollary_7_1_monomialBasis, Module.Basis.reindex_apply, initialGammaBasis_apply]
  change Polynomial.monomial ((p.val.1.optionElim p.val.2) none)
    (monomial (p.val.1.optionElim p.val.2).some (1 : K)) = _
  simp only [Finsupp.optionElim_apply_none, Finsupp.some_optionElim]

end FourPapers.Symmetric.Rees
