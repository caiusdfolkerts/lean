/-- Unit-leading Gröbner bases make initial ideals commute with arbitrary
coefficient maps, including noninjective and nonflat maps. -/
theorem initial_map_of_unit_groebner {σ R S : Type*} [CommRing R] [CommRing S]
    (m : MonomialOrder σ) (φ : R →+* S) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g)) :
    orderInitialIdeal m (I.map (MvPolynomial.map φ)) =
      (orderInitialIdeal m I).map (MvPolynomial.map φ) := by
  rcases subsingleton_or_nontrivial S with hS | hS
  · letI := hS
    exact Subsingleton.elim _ _
  · letI := hS
    have hmap := hG.map_of_unit_leading φ hu
    rw [orderInitialIdeal, orderInitialIdeal, hmap.span_leadingTerm_image,
      hG.span_leadingTerm_image, Ideal.map_span, Set.image_image, Set.image_image]
    apply congrArg Ideal.span
    apply Set.image_congr
    intro g hg
    by_cases hg0 : g = 0
    · simp only [hg0, map_zero, m.leadingTerm_zero]
    · have hn : φ (m.leadingCoeff g) ≠ 0 := ((hu g hg hg0).map φ).ne_zero
      simp only [MonomialOrder.leadingTerm, m.degree_map_of_leadingCoeff_ne_zero φ hn,
        m.leadingCoeff_map_of_leadingCoeff_ne_zero φ hn, map_monomial]

