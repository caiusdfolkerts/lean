section

set_option autoImplicit false
set_option maxHeartbeats 2000000
noncomputable section

/-!
# Adjoining the determinant: the positive joint SAGBI theorem

The algebra and its initial algebra are the actual subalgebras in
`JointSymbolicRees`. Every monomial order restricting to
the folded coefficient order on each bidegree is allowed. All symbolic and
determinant exponents are unrestricted.
-/

namespace FourPapers.Symmetric.JointSagbi
open MvPolynomial
open scoped BigOperators
universe u v

section General
variable {K : Type u} [Field K] {σ : Type v}

@[simp] theorem taggedExponent_zero :
    taggedExponent 0 0 (0 : σ →₀ ℕ) = 0 := by
  ext i
  rcases i with _ | (_ | i) <;> simp [taggedExponent]

@[simp] theorem tag_C (c : K) : tag 0 0 (C c : MvPolynomial σ K) = C c := by
  change tag 0 0 (monomial 0 c) = monomial 0 c
  rw [tag_monomial, taggedExponent_zero]

theorem tag_zero_zero_mem_of_variables (A : Subalgebra K (Ring σ K))
    (hX : ∀ i, tag 0 0 (X i : MvPolynomial σ K) ∈ A) (f : MvPolynomial σ K) :
    tag 0 0 f ∈ A := by
  induction f using MvPolynomial.induction_on with
  | C c =>
    rw [tag_C]
    simpa only [MvPolynomial.algebraMap_eq] using A.algebraMap_mem c
  | add f g hf hg => rw [tag_add]; exact A.add_mem hf hg
  | mul_X f i hf =>
    simpa only [tag_mul, zero_add] using A.mul_mem hf (hX i)

/-- Ideal generation lifts into any subalgebra containing the coefficient ring. -/
theorem tag_mem_of_span (A : Subalgebra K (Ring σ K))
    (hC : ∀ f : MvPolynomial σ K, tag 0 0 f ∈ A) (a b : ℕ)
    (G : Set (MvPolynomial σ K)) (hG : ∀ g ∈ G, tag a b g ∈ A)
    {f : MvPolynomial σ K} (hf : f ∈ Ideal.span G) : tag a b f ∈ A := by
  induction hf using Submodule.span_induction with
  | mem g hg => exact hG g hg
  | zero => simpa only [tag_zero] using A.zero_mem
  | add f g hf hg ihf ihg => rw [tag_add]; exact A.add_mem ihf ihg
  | smul c f hf ih =>
    simpa only [smul_eq_mul, tag_mul, zero_add] using A.mul_mem (hC c) ih

/-- The product identity includes zero factors and all grading allocations. -/
theorem tag_sum_prod {ι : Type*} (s : Finset ι) (a b : ι → ℕ)
    (f : ι → MvPolynomial σ K) :
    tag (∑ i ∈ s, a i) (∑ i ∈ s, b i) (∏ i ∈ s, f i) =
      ∏ i ∈ s, tag (a i) (b i) (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    simp only [Finset.sum_insert hi, Finset.prod_insert hi, ← tag_mul, ih]

/-- A polynomial is the finite sum of its actual tagged coefficient pieces. -/
theorem mem_of_coefficient_tags (A : Subalgebra K (Ring σ K)) (f : Ring σ K)
    (hf : ∀ a b, tag a b (((coordinates K σ f).coeff b).coeff a) ∈ A) : f ∈ A := by
  have h : (coordinates K σ).symm (coordinates K σ f) ∈ A := by
    rw [(coordinates K σ f).as_sum_support, map_sum]
    apply A.sum_mem
    intro b hb
    rw [((coordinates K σ f).coeff b).as_sum_support]
    simp only [map_sum]
    apply A.sum_mem
    intro a ha
    exact hf a b
  simpa only [AlgEquiv.symm_apply_apply] using h

/-- The homogeneous piece retaining one pair of literal symbolic degrees. -/
def coefficientPiece (f : Ring σ K) (a b : ℕ) : Ring σ K :=
  tag a b (((coordinates K σ f).coeff b).coeff a)

theorem coefficientPiece_coeff (f : Ring σ K) (a b : ℕ) (d : Variables σ →₀ ℕ) :
    (coefficientPiece f a b).coeff d =
      if b = d none ∧ a = d.some none then f.coeff d else 0 := by
  rw [coefficientPiece, coeff_tag]
  split_ifs with h
  · rcases h with ⟨hb, ha⟩
    rw [hb, ha]
    exact coefficient_coordinates d f
  · rfl

theorem coefficientPiece_support_subset (f : Ring σ K) (a b : ℕ) :
    (coefficientPiece f a b).support ⊆ f.support := by
  intro d hd
  rw [MvPolynomial.mem_support_iff, coefficientPiece_coeff] at hd
  apply MvPolynomial.mem_support_iff.mpr
  split_ifs at hd with h
  · exact hd
  · exact (hd rfl).elim

/-- The leading term of an arbitrary element is the leading term of its
actual homogeneous coefficient piece; no comparison between bidegrees is assumed. -/
theorem leadingTerm_coefficientPiece (ω : MonomialOrder (Variables σ))
    (f : Ring σ K) (hf : f ≠ 0) :
    ω.leadingTerm (coefficientPiece f ((ω.degree f).some none) ((ω.degree f) none)) =
      ω.leadingTerm f := by
  let d := ω.degree f
  let p := coefficientPiece f (d.some none) (d none)
  have hdc : p.coeff d = f.coeff d := by
    simp only [p, coefficientPiece_coeff, eq_self_iff_true, and_self, if_true]
  have hds : d ∈ p.support := by
    rw [MvPolynomial.mem_support_iff, hdc]
    exact MvPolynomial.mem_support_iff.mp (ω.degree_mem_support hf)
  have hd : ω.degree p = d := by
    apply ω.toSyn.injective
    apply le_antisymm
    · exact ω.degree_le_degree_of_support_subset (coefficientPiece_support_subset f _ _)
    · exact ω.le_degree hds
  change ω.leadingTerm p = ω.leadingTerm f
  simp only [MonomialOrder.leadingTerm, MonomialOrder.leadingCoeff, hd, hdc]
  rfl

/-- A finite budget realizes every permitted determinant grading exactly. -/
theorem tag_pow_mem_of_budget (A : Subalgebra K (Ring σ K)) (D : MvPolynomial σ K)
    (h : ℕ) (hD : ∀ c, c ≤ h → tag c 1 D ∈ A) (a b : ℕ) :
    tag (min a (b * h)) b (D ^ b) ∈ A := by
  classical
  obtain ⟨c, hc, hcs⟩ := exists_fin_budget_sum (fun _ : Fin b => h) (min a (b * h))
    (by simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      Nat.nsmul_eq_mul] using min_le_right a (b * h))
  have hp : tag (∑ i : Fin b, c i) (∑ _ : Fin b, (1 : ℕ)) (∏ _ : Fin b, D) ∈ A := by
    rw [tag_sum_prod]
    apply A.prod_mem
    intro i hi
    exact hD (c i) (hc i)
  simpa only [hcs, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    Nat.nsmul_eq_mul, mul_one, Finset.prod_const] using hp

theorem tag_determinant_factor_mem (A : Subalgebra K (Ring σ K)) (D : MvPolynomial σ K)
    (h : ℕ) (hD : ∀ c, c ≤ h → tag c 1 D ∈ A) (a b : ℕ)
    (g : MvPolynomial σ K) (hg : tag (a - b * h) 0 g ∈ A) :
    tag a b (D ^ b * g) ∈ A := by
  have hm := A.mul_mem (tag_pow_mem_of_budget A D h hD a b) hg
  have he : min a (b * h) + (a - b * h) = a := by omega
  simpa only [tag_mul, he, add_zero] using hm

end General

section Determinant
variable {n : ℕ} (K : Type u) [Field K] (r : ℕ)

/-- The smaller collection displayed in Proposition 7.3. -/
def determinantGenerators : Set (Ring (Entry n) K) :=
  (Set.range (fun e : Entry n => tag 0 0 (X e : CoordinateRing n K)) ∪
    ((fun δ : MinorData n => tag (δ.size - r + 1) 0 (δ.polynomial K)) ''
      {δ | r ≤ δ.size})) ∪
    Set.range (fun c : Fin (n - r + 1 + 1) => tag c.val 1 (fullDeterminant n K))

theorem determinantGenerators_finite : (determinantGenerators (n := n) K r).Finite :=
  ((Set.finite_range _).union ((Set.toFinite _).image _)).union (Set.finite_range _)

/-- Every permitted symbolic grade of a minor belongs to the genuine power. -/
theorem minor_mem_symbolicPower_of_grade (hr : 0 < r) (hrn : r ≤ n)
    (δ : MinorData n) (a : ℕ) (ha : a ≤ δ.size - (r - 1)) :
    δ.polynomial K ∈ symbolicPower (determinantalIdeal n K r) a := by
  letI := Rees.determinantal_prime n K r hr
  by_cases ha0 : a = 0
  · simp [ha0]
  · have hsize : r ≤ δ.size := by omega
    have hδ : δ.polynomial K ∈
        symbolicPower (determinantalIdeal n K r) (δ.size - r + 1) := by
      apply (Rees.full_symbolic_groebner n K r (δ.size - r + 1) hr hrn
        (Nat.zero_lt_succ _)).subset
      refine ⟨1, fun _ => δ, fun _ => hsize, ?_, ?_⟩ <;> simp
    exact symbolicPower_antitone (determinantalIdeal n K r) (by omega) hδ

/-- The full proposed collection lies in the actual two-symbolic algebra. -/
theorem minorGenerators_subset_joint (t : ℕ) (hr : 0 < r) (hrn : r ≤ n)
    (ht : 0 < t) (htn : t ≤ n) :
    minorGenerators n K r t ⊆ determinantalJointRees n K r t hr ht := by
  letI := Rees.determinantal_prime n K r hr
  letI := Rees.determinantal_prime n K t ht
  rintro f (⟨e,rfl⟩ | ⟨δ,a,b,ha,hb,rfl⟩)
  · apply (tag_mem_jointRees _ _ _ _ _).mpr
    simp
  · apply (tag_mem_jointRees _ _ _ _ _).mpr
    exact ⟨minor_mem_symbolicPower_of_grade K r hr hrn δ a ha,
      minor_mem_symbolicPower_of_grade K t ht htn δ b hb⟩

theorem determinantGenerators_subset_minorGenerators (hr : 0 < r) (hrn : r ≤ n) :
    determinantGenerators (n := n) K r ⊆ minorGenerators n K r n := by
  rintro f ((⟨e,rfl⟩ | ⟨δ,hδ,rfl⟩) | ⟨c,rfl⟩)
  · exact Or.inl ⟨e,rfl⟩
  · have hsize : r ≤ δ.size := hδ
    exact Or.inr ⟨δ,δ.size-r+1,0,by omega,Nat.zero_le _,rfl⟩
  · refine Or.inr ⟨fullMinor n,c.val,1,?_,?_,rfl⟩
    · have hc := c.isLt
      change c.val ≤ n - (r - 1)
      omega
    · change 1 ≤ n - (n - 1)
      omega

/-- Single symbolic-degree generation transported into the actual bivariate ring. -/
theorem tag_single_mem (A : Subalgebra K (Ring (Entry n) K))
    (hC : ∀ f : CoordinateRing n K, tag 0 0 f ∈ A)
    (hminor : ∀ δ : MinorData n, r ≤ δ.size → tag (δ.size-r+1) 0 (δ.polynomial K) ∈ A)
    (hr : 0 < r) (hrn : r ≤ n) (q : ℕ) (f : CoordinateRing n K)
    (hf : f ∈ symbolicPower (determinantalIdeal n K r) q) : tag q 0 f ∈ A := by
  classical
  by_cases hq : q = 0
  · simpa only [hq] using hC f
  · have hG := Rees.full_symbolic_groebner n K r q hr hrn (Nat.pos_of_ne_zero hq)
    apply tag_mem_of_span A hC q 0 (symbolicGenerators K n r q) ?_
      (hG.ideal_eq_span ▸ hf)
    rintro g ⟨k,δ,hsize,hscore,rfl⟩
    have hp : tag (∑ j, ((δ j).size-r+1)) (∑ _ : Fin k, (0 : ℕ))
        (∏ j, (δ j).polynomial K) ∈ A := by
      rw [tag_sum_prod]
      apply A.prod_mem
      intro j hj
      exact hminor (δ j) (hsize j)
    simpa only [hscore, Finset.sum_const_zero] using hp

/-- The corresponding single-score initial-generation statement. -/
theorem tag_single_leading_mem (A : Subalgebra K (Ring (Entry n) K))
    (hC : ∀ f : CoordinateRing n K, tag 0 0 f ∈ A)
    (hminor : ∀ δ : MinorData n, r ≤ δ.size →
      tag (δ.size-r+1) 0 ((foldedOrder n).leadingTerm (δ.polynomial K)) ∈ A)
    (hr : 0 < r) (hrn : r ≤ n) (q : ℕ) (f : CoordinateRing n K)
    (hf : f ∈ symbolicPower (determinantalIdeal n K r) q) :
    tag q 0 ((foldedOrder n).leadingTerm f) ∈ A := by
  classical
  by_cases hq : q = 0
  · simpa only [hq] using hC ((foldedOrder n).leadingTerm f)
  · have hG := Rees.full_symbolic_groebner n K r q hr hrn (Nat.pos_of_ne_zero hq)
    have hf' : (foldedOrder n).leadingTerm f ∈
        Ideal.span ((foldedOrder n).leadingTerm '' symbolicGenerators K n r q) := by
      apply hG.span_leadingTerm_image.le
      exact Ideal.subset_span ⟨f,hf,rfl⟩
    apply tag_mem_of_span A hC q 0
      ((foldedOrder n).leadingTerm '' symbolicGenerators K n r q) ?_ hf'
    rintro _ ⟨g,⟨k,δ,hsize,hscore,rfl⟩,rfl⟩
    rw [(foldedOrder n).leadingTerm_prod_of_regular
      (fun j _ => ((δ j).leadingCoeff_polynomial_isUnit K).isRegular)]
    have hp : tag (∑ j, ((δ j).size-r+1)) (∑ _ : Fin k, (0 : ℕ))
        (∏ j, (foldedOrder n).leadingTerm ((δ j).polynomial K)) ∈ A := by
      rw [tag_sum_prod]
      apply A.prod_mem
      intro j hj
      exact hminor (δ j) (hsize j)
    simpa only [hscore, Finset.sum_const_zero] using hp

/-- The full proposed collection is finite: every minor size and both
permitted symbolic grades are bounded by the actual matrix size. -/
theorem minorGenerators_finite (t : ℕ) : (minorGenerators n K r t).Finite := by
  let H : Set (Ring (Entry n) K) := Set.range
    (fun p : MinorData n × Fin (n+1) × Fin (n+1) =>
      tag p.2.1.val p.2.2.val (p.1.polynomial K))
  have hH : H.Finite := Set.finite_range _
  apply ((Set.finite_range (fun e : Entry n => tag 0 0 (X e : CoordinateRing n K))).union hH).subset
  rintro f (hf | ⟨δ,a,b,ha,hb,rfl⟩)
  · exact Or.inl hf
  · have hsize := minorData_size_le δ
    exact Or.inr ⟨(δ,⟨a,by omega⟩,⟨b,by omega⟩),rfl⟩

/-- Enlarging a SAGBI basis within the same algebra preserves both exact
algebra-generation assertions. -/
theorem IsSagbiBasis.mono {K' : Type*} [Field K'] {σ : Type*}
    {ω : MonomialOrder (Variables σ)}
    {S : Subalgebra K' (Ring σ K')} {G H : Set (Ring σ K')}
    (hG : IsSagbiBasis ω S G) (hGH : G ⊆ H) (hHS : H ⊆ S) : IsSagbiBasis ω S H := by
  constructor
  · apply le_antisymm (Algebra.adjoin_le hHS)
    rw [← hG.1]
    exact Algebra.adjoin_mono hGH
  · apply le_antisymm (Algebra.adjoin_mono (Set.image_mono hHS))
    change initialAlgebra ω S ≤ Algebra.adjoin K' (ω.leadingTerm '' H)
    rw [← hG.2]
    exact Algebra.adjoin_mono (Set.image_mono hGH)

/-- Proposition 7.3 for the displayed smaller generating collection, for
all fields and every order with the prescribed homogeneous restriction. -/
theorem determinantGenerators_sagbi (hr : 0 < r) (hrn : r ≤ n)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    IsSagbiBasis ω (determinantalJointRees n K r n hr (hr.trans_le hrn))
      (determinantGenerators (n := n) K r) := by
  classical
  letI := Rees.determinantal_prime n K r hr
  letI := Rees.determinantal_prime n K n (hr.trans_le hrn)
  let G := determinantGenerators (n := n) K r
  let S := jointRees (K := K) (determinantalIdeal n K r) (determinantalIdeal n K n)
  have hsub : G ⊆ S :=
    (determinantGenerators_subset_minorGenerators K r hr hrn).trans
      (minorGenerators_subset_joint K r n hr hrn (hr.trans_le hrn) le_rfl)
  change IsSagbiBasis ω S G
  constructor
  · apply le_antisymm (Algebra.adjoin_le hsub)
    let A := Algebra.adjoin K G
    have hC : ∀ f : CoordinateRing n K, tag 0 0 f ∈ A :=
      tag_zero_zero_mem_of_variables A
        (fun e => Algebra.subset_adjoin (Or.inl (Or.inl ⟨e,rfl⟩)))
    have hminor : ∀ δ : MinorData n, r ≤ δ.size →
        tag (δ.size-r+1) 0 (δ.polynomial K) ∈ A :=
      fun δ hδ => Algebra.subset_adjoin (Or.inl (Or.inr ⟨δ,hδ,rfl⟩))
    have hD : ∀ c, c ≤ n-r+1 → tag c 1 (fullDeterminant n K) ∈ A :=
      fun c hc => Algebra.subset_adjoin (Or.inr ⟨⟨c,Nat.lt_succ_of_le hc⟩,rfl⟩)
    intro f hf
    apply mem_of_coefficient_tags A f
    intro a b
    have hab : ((coordinates K (Entry n) f).coeff b).coeff a ∈
        symbolicPower (determinantalIdeal n K r) a ⊓
          symbolicPower (determinantalIdeal n K n) b := hf a b
    rw [symbolicPower_inter_fullDeterminantal n K r hr hrn a b] at hab
    obtain ⟨g,hg,hfg⟩ := Ideal.mem_span_singleton_mul.mp hab
    rw [← hfg]
    exact tag_determinant_factor_mem A (fullDeterminant n K) (n-r+1) hD a b g
      (tag_single_mem K r A hC hminor hr hrn _ g hg)
  · apply le_antisymm (Algebra.adjoin_mono (Set.image_mono hsub))
    apply Algebra.adjoin_le
    let A := Algebra.adjoin K (ω.leadingTerm '' G)
    have hC : ∀ f : CoordinateRing n K, tag 0 0 f ∈ A := by
      apply tag_zero_zero_mem_of_variables A
      intro e
      have h : ω.leadingTerm (tag 0 0 (X e : CoordinateRing n K)) ∈ A :=
        Algebra.subset_adjoin ⟨tag 0 0 (X e), Or.inl (Or.inl ⟨e,rfl⟩),rfl⟩
      simpa only [leadingTerm_tag ω (foldedOrder n) hω, MonomialOrder.leadingTerm_X] using h
    have hminor : ∀ δ : MinorData n, r ≤ δ.size →
        tag (δ.size-r+1) 0 ((foldedOrder n).leadingTerm (δ.polynomial K)) ∈ A := by
      intro δ hδ
      have h : ω.leadingTerm (tag (δ.size-r+1) 0 (δ.polynomial K)) ∈ A :=
        Algebra.subset_adjoin ⟨tag (δ.size-r+1) 0 (δ.polynomial K),
          Or.inl (Or.inr ⟨δ,hδ,rfl⟩),rfl⟩
      simpa only [leadingTerm_tag ω (foldedOrder n) hω] using h
    have hD : ∀ c, c ≤ n-r+1 →
        tag c 1 ((foldedOrder n).leadingTerm (fullDeterminant n K)) ∈ A := by
      intro c hc
      have h : ω.leadingTerm (tag c 1 (fullDeterminant n K)) ∈ A :=
        Algebra.subset_adjoin ⟨tag c 1 (fullDeterminant n K),
          Or.inr ⟨⟨c,Nat.lt_succ_of_le hc⟩,rfl⟩,rfl⟩
      simpa only [leadingTerm_tag ω (foldedOrder n) hω] using h
    rintro _ ⟨f,hf,rfl⟩
    by_cases hf0 : f = 0
    · change ω.leadingTerm f ∈ A
      rw [hf0, MonomialOrder.leadingTerm_zero]
      exact A.zero_mem
    · let d := ω.degree f
      let a := d.some none
      let b := d none
      let g₀ := ((coordinates K (Entry n) f).coeff b).coeff a
      have hpiece : ω.leadingTerm f = tag a b ((foldedOrder n).leadingTerm g₀) := by
        calc
          ω.leadingTerm f = ω.leadingTerm (coefficientPiece f a b) :=
            (leadingTerm_coefficientPiece ω f hf0).symm
          _ = tag a b ((foldedOrder n).leadingTerm g₀) :=
            leadingTerm_tag ω (foldedOrder n) hω a b g₀
      rw [hpiece]
      have hab : g₀ ∈ symbolicPower (determinantalIdeal n K r) a ⊓
          symbolicPower (determinantalIdeal n K n) b := hf a b
      rw [symbolicPower_inter_fullDeterminantal n K r hr hrn a b] at hab
      obtain ⟨g,hg,hfg⟩ := Ideal.mem_span_singleton_mul.mp hab
      rw [← hfg, (foldedOrder n).leadingTerm_mul, (foldedOrder n).leadingTerm_pow]
      exact tag_determinant_factor_mem A ((foldedOrder n).leadingTerm (fullDeterminant n K))
        (n-r+1) hD a b ((foldedOrder n).leadingTerm g)
        (tag_single_leading_mem K r A hC hminor hr hrn _ g hg)

/-- The full collection `G_(r,n)` in Proposition 7.3, under every permitted
term order. The subset assertion above is included as the stronger construction. -/
theorem proposition_7_3_sagbi (hr : 0 < r) (hrn : r ≤ n)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    IsSagbiBasis ω (determinantalJointRees n K r n hr (hr.trans_le hrn))
      (minorGenerators n K r n) :=
  (determinantGenerators_sagbi K r hr hrn ω hω).mono
    (determinantGenerators_subset_minorGenerators K r hr hrn)
    (minorGenerators_subset_joint K r n hr hrn (hr.trans_le hrn) le_rfl)

end Determinant

end FourPapers.Symmetric.JointSagbi

namespace FourPapers.Symmetric.JointSagbi
open MvPolynomial
universe u v
variable {K : Type u} [Field K] {σ : Type v}

/-- The coefficient-free leading monomial convention used in the paper. -/
def leadingMonomial (ω : MonomialOrder (Variables σ)) (f : Ring σ K) : Ring σ K := by
  classical
  exact if f = 0 then 0 else monomial (ω.degree f) 1

theorem leadingTerm_mem_iff_leadingMonomial_mem (ω : MonomialOrder (Variables σ))
    (A : Subalgebra K (Ring σ K)) (f : Ring σ K) :
    ω.leadingTerm f ∈ A ↔ leadingMonomial ω f ∈ A := by
  by_cases hf : f = 0
  · simp [hf, leadingMonomial]
  · simp only [leadingMonomial, if_neg hf]
    exact ω.leadingTerm_mem_iff A (ω.isUnit_leadingCoeff.mpr hf)

theorem adjoin_leadingTerms_eq_leadingMonomials (ω : MonomialOrder (Variables σ))
    (G : Set (Ring σ K)) :
    Algebra.adjoin K (ω.leadingTerm '' G) = Algebra.adjoin K (leadingMonomial ω '' G) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨f,hf,rfl⟩
    exact (leadingTerm_mem_iff_leadingMonomial_mem ω _ f).mpr
      (Algebra.subset_adjoin ⟨f,hf,rfl⟩)
  · apply Algebra.adjoin_le
    rintro _ ⟨f,hf,rfl⟩
    exact (leadingTerm_mem_iff_leadingMonomial_mem ω _ f).mp
      (Algebra.subset_adjoin ⟨f,hf,rfl⟩)

/-- The literal leading-term formulation is equivalent to the paper's
leading-monomial formulation, with both algebra-generation requirements retained. -/
theorem isSagbiBasis_iff_leadingMonomials (ω : MonomialOrder (Variables σ))
    (S : Subalgebra K (Ring σ K)) (G : Set (Ring σ K)) :
    IsSagbiBasis ω S G ↔
      Algebra.adjoin K G = S ∧
        Algebra.adjoin K (leadingMonomial ω '' G) =
          Algebra.adjoin K (leadingMonomial ω '' (S : Set (Ring σ K))) := by
  unfold IsSagbiBasis initialAlgebra
  rw [adjoin_leadingTerms_eq_leadingMonomials, adjoin_leadingTerms_eq_leadingMonomials]

end FourPapers.Symmetric.JointSagbi
