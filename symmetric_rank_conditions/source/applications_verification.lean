/-!
# The actual joint-SAGBI obstruction

The support argument concerns the actual subalgebra generated by the proposed
leading terms: arbitrary sums and products are reduced to finite minor
factorizations.
The final witness is lifted into an intersection of genuine symbolic powers by
the main mixed Gröbner theorem, without assuming such a lift as a hypothesis.
-/

namespace FourPapers.Symmetric.JointSagbi
open MvPolynomial
open scoped BigOperators Pointwise

universe u
variable {K : Type u} [Field K]

/-- One proposed minor generator, retaining its two allowed symbolic grades. -/
structure GradedMinor (n t : ℕ) where
  minor : MinorData n
  first : ℕ
  second : ℕ
  first_le : first ≤ minor.size - 1
  second_le : second ≤ minor.size - (t - 1)

/-- A finite minor factorization of a tagged exponent. Coefficient variables
may supply the remaining exponent; they supply neither symbolic grade. -/
def HasMinorFactorization {n : ℕ} (t : ℕ) (e : Variables (Entry n) →₀ ℕ) : Prop :=
  ∃ L : List (GradedMinor n t),
    (L.map (fun g => g.minor.exponent)).sum ≤ e.some.some ∧
    (L.map GradedMinor.first).sum = e.some none ∧
    (L.map GradedMinor.second).sum = e none

theorem hasMinorFactorization_zero (n t : ℕ) :
    HasMinorFactorization t (0 : Variables (Entry n) →₀ ℕ) := by
  refine ⟨[], ?_, ?_, ?_⟩ <;> simp

theorem HasMinorFactorization.add {n t : ℕ}
    {e f : Variables (Entry n) →₀ ℕ}
    (he : HasMinorFactorization t e) (hf : HasMinorFactorization t f) :
    HasMinorFactorization t (e + f) := by
  obtain ⟨L,hLe,hLa,hLb⟩ := he
  obtain ⟨M,hMe,hMa,hMb⟩ := hf
  refine ⟨L ++ M, ?_, ?_, ?_⟩
  · simpa only [List.map_append,List.sum_append,Finsupp.some_add] using add_le_add hLe hMe
  · simp only [List.map_append,List.sum_append,Finsupp.some_add,Finsupp.add_apply,hLa,hMa]
  · simp only [List.map_append,List.sum_append,Finsupp.add_apply,hLb,hMb]

theorem hasMinorFactorization_coefficient {n t : ℕ} (e : Entry n →₀ ℕ) :
    HasMinorFactorization t (taggedExponent 0 0 e) := by
  refine ⟨[], ?_, ?_, ?_⟩ <;> simp [taggedExponent]

theorem hasMinorFactorization_minor {n t : ℕ} (g : GradedMinor n t) :
    HasMinorFactorization t (taggedExponent g.first g.second g.minor.exponent) := by
  refine ⟨[g], ?_, ?_, ?_⟩ <;> simp [taggedExponent]

/-- All polynomials whose every supported exponent has such a finite
factorization form an actual subalgebra. This includes all cancellation and
all finite sums in the generated algebra. -/
def factorizedSupport (n t : ℕ) : Subalgebra K (Ring (Entry n) K) where
  carrier := {p | ∀ e ∈ p.support, HasMinorFactorization t e}
  zero_mem' := by intro e he; simp at he
  one_mem' := by
    intro e he
    have heq : e = 0 := by simpa only [MvPolynomial.support_one,Finset.mem_singleton] using he
    subst e
    exact hasMinorFactorization_zero n t
  add_mem' := by
    intro p q hp hq e he
    by_cases hep : e ∈ p.support
    · exact hp e hep
    · have hpc : p.coeff e = 0 := by
        by_contra hpc
        exact hep (MvPolynomial.mem_support_iff.mpr hpc)
      have heq : e ∈ q.support := by
        apply MvPolynomial.mem_support_iff.mpr
        intro hqc
        apply MvPolynomial.mem_support_iff.mp he
        rw [MvPolynomial.coeff_add, hpc, hqc, add_zero]
      exact hq e heq
  mul_mem' := by
    classical
    intro p q hp hq e he
    have hcoeff := MvPolynomial.mem_support_iff.mp he
    rw [MvPolynomial.coeff_mul] at hcoeff
    obtain ⟨⟨a,b⟩, hab, hnz⟩ := Finset.exists_ne_zero_of_sum_ne_zero hcoeff
    have hpa : p.coeff a ≠ 0 := fun ha => hnz (by rw [ha, zero_mul])
    have hqb : q.coeff b ≠ 0 := fun hb => hnz (by rw [hb, mul_zero])
    have hab' : a + b = e := Finset.mem_antidiagonal.mp hab
    rw [← hab']
    exact (hp a (MvPolynomial.mem_support_iff.mpr hpa)).add
      (hq b (MvPolynomial.mem_support_iff.mpr hqb))
  algebraMap_mem' c e he := by
    change e ∈ (MvPolynomial.monomial 0 c).support at he
    have heq : e = 0 := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset he)
    subst e
    exact hasMinorFactorization_zero n t

theorem leading_generators_mem_factorizedSupport (n t : ℕ)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    ω.leadingTerm '' minorGenerators n K 2 t ⊆
      (factorizedSupport (K := K) n t : Set (Ring (Entry n) K)) := by
  classical
  rintro _ ⟨p,hp,rfl⟩ e he
  rcases hp with ⟨v,rfl⟩ | ⟨δ,a,b,ha,hb,rfl⟩
  · rw [leadingTerm_tag ω (foldedOrder n) hω] at he
    have hX : (foldedOrder n).leadingTerm (MvPolynomial.X v : CoordinateRing n K) =
        MvPolynomial.X v := by simp [MvPolynomial.X]
    rw [hX] at he
    change e ∈ (tag 0 0 (MvPolynomial.monomial (Finsupp.single v 1) (1 : K))).support at he
    rw [tag_monomial] at he
    have heq := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset he)
    subst e
    exact hasMinorFactorization_coefficient _
  · rw [leadingTerm_tag ω (foldedOrder n) hω] at he
    simp only [MonomialOrder.leadingTerm,δ.degree_polynomial K,tag_monomial] at he
    have heq := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset he)
    subst e
    exact hasMinorFactorization_minor ⟨δ,a,b,by simpa using ha,hb⟩

theorem adjoin_leading_generators_le_factorizedSupport (n t : ℕ)
    (ω : MonomialOrder (Variables (Entry n)))
    (hω : RespectsCoefficientOrder ω (foldedOrder n)) :
    Algebra.adjoin K (ω.leadingTerm '' minorGenerators n K 2 t) ≤ factorizedSupport n t :=
  Algebra.adjoin_le (leading_generators_mem_factorizedSupport n t ω hω)

/-- Convert the genuine finite-support consequence of algebra generation to
the finite indexed factorization ruled out by the unrestricted witness. -/
theorem obstruction_not_factorization {n t : ℕ}
    (W : SagbiObstruction.MonomialObstruction n t) (ht : 4 ≤ t) :
    ¬ HasMinorFactorization t (taggedExponent t 1 W.monomial) := by
  rintro ⟨L,hLe,hLa,hLb⟩
  let δ : Fin L.length → MinorData n := fun i => (L.get i).minor
  let a : Fin L.length → ℕ := fun i => (L.get i).first
  let b : Fin L.length → ℕ := fun i => (L.get i).second
  have hsum {A : Type} [AddCommMonoid A] (f : GradedMinor n t → A) :
      (∑ i : Fin L.length, f (L.get i)) = (L.map f).sum := by
    rw [← Fin.sum_ofFn]
    congr 1
    rw [List.ofFn_comp', List.ofFn_get]
  apply W.no_graded_factorization ht δ a b
  · intro i; exact (L.get i).first_le
  · intro i; exact (L.get i).second_le
  · change (∑ i : Fin L.length, (L.get i).minor.exponent) ≤ W.monomial
    rw [hsum (fun g : GradedMinor n t => g.minor.exponent)]
    simpa only [taggedExponent, Finsupp.some_optionElim] using hLe
  · change (∑ i : Fin L.length, (L.get i).first) = t
    rw [hsum]
    simpa only [taggedExponent, Finsupp.some_optionElim,
      Finsupp.optionElim_apply_none] using hLa
  · change (∑ i : Fin L.length, (L.get i).second) = 1
    rw [hsum]
    simpa only [taggedExponent, Finsupp.optionElim_apply_none] using hLb

/-- The mixed theorem gives precisely the union basis needed for an actual
intersection lift; the rank array imposes no extra condition. -/
theorem full_symbolic_union_groebner (n : ℕ) (K : Type u) [Field K]
    (r t a b : ℕ) (hr : 0 < r) (hrn : r ≤ n) (ht : 0 < t) (htn : t ≤ n)
    (ha : 0 < a) (hb : 0 < b) :
    (foldedOrder n).IsGroebnerBasis (symbolicGenerators K n r a ∪ symbolicGenerators K n t b)
      (symbolicPower (determinantalIdeal n K r) a ⊔
        symbolicPower (determinantalIdeal n K t) b) := by
  let ρ : RankArray n := fun _ _ => n
  have hE : northwestGenerators K ρ = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro f ⟨i,j,A,B,hA,hB,hf⟩
    have hcard := Fintype.card_le_of_injective _ A.injective
    simp only [Fintype.card_fin] at hcard
    dsimp [ρ] at hcard
    omega
  have hI : northwestIdeal K ρ = ⊥ := by rw [northwestIdeal,hE,Ideal.span_empty]
  have hG : mixedGenerators K ρ [(r,a),(t,b)] =
      symbolicGenerators K n r a ∪ symbolicGenerators K n t b := by
    ext f
    simp [mixedGenerators,hE]
  have hJ : mixedIdeal K ρ [(r,a),(t,b)] =
      symbolicPower (determinantalIdeal n K r) a ⊔
        symbolicPower (determinantalIdeal n K t) b := by
    simp [mixedIdeal,hI,Ideal.add_eq_sup]
  rw [← hG,← hJ]
  apply compatible_rank_and_symbolic_conditions n K ρ (fun _ _ => rfl)
  intro ts hts
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hts
  rcases hts with rfl | rfl
  · exact ⟨hr,hrn,ha⟩
  · exact ⟨ht,htn,hb⟩

/-- The obstruction monomial is the normalized leading monomial of an
actual polynomial in the intersection of the two actual symbolic powers. -/
theorem obstruction_intersection_lift {n t : ℕ}
    (W : SagbiObstruction.MonomialObstruction n t) (ht : 4 ≤ t) (htn : t ≤ n) :
    ∃ p : CoordinateRing n K,
      p ∈ symbolicPower (determinantalIdeal n K 2) t ⊓
        symbolicPower (determinantalIdeal n K t) 1 ∧
      (foldedOrder n).leadingTerm p = MvPolynomial.monomial W.monomial 1 := by
  classical
  let I := symbolicPower (determinantalIdeal n K 2) t
  let J := symbolicPower (determinantalIdeal n K t) 1
  have hI : MvPolynomial.monomial W.monomial (1 : K) ∈
      Rees.coefficientInitial (foldedOrder n) I := by
    apply (Rees.mem_coefficientInitial_symbolic_iff_gamma n K 2 t (by omega) (by omega) _).mpr
    intro e he
    have heq := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset he)
    subst e
    simpa only [W.score_two ht] using (le_rfl : t ≤ t)
  have hJ : MvPolynomial.monomial W.monomial (1 : K) ∈
      Rees.coefficientInitial (foldedOrder n) J := by
    apply (Rees.mem_coefficientInitial_symbolic_iff_gamma n K t 1 (by omega) htn _).mpr
    intro e he
    have heq := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset he)
    subst e
    simpa only [W.score_threshold ht] using (le_rfl : (1 : ℕ) ≤ 1)
  have hmem : W.monomial ∈ (MvPolynomial.monomial W.monomial (1 : K)).support := by simp
  have hstdI : W.monomial ∉ (foldedOrder n).standardMonomials I := by
    obtain ⟨p,hp,hp0,hpe⟩ := MonomialOrder.exists_degree_le_of_mem_span_leadingTerm hI hmem
    exact fun h => h p hp hp0 hpe
  have hstdJ : W.monomial ∉ (foldedOrder n).standardMonomials J := by
    obtain ⟨p,hp,hp0,hpe⟩ := MonomialOrder.exists_degree_le_of_mem_span_leadingTerm hJ hmem
    exact fun h => h p hp hp0 hpe
  obtain ⟨p,hp,hpc,hpd⟩ := Simultaneous.normalized_intersection_lift
    (foldedOrder n) I J (symbolicGenerators K n 2 t) (symbolicGenerators K n t 1)
    (Rees.full_symbolic_groebner n K 2 t (by omega) (by omega) (by omega))
    (Rees.full_symbolic_groebner n K t 1 (by omega) htn (by omega))
    (symbolicGenerators_unit_leading K n 2 t) (symbolicGenerators_unit_leading K n t 1)
    (full_symbolic_union_groebner n K 2 t t 1 (by omega) (by omega) (by omega)
      htn (by omega) (by omega)) W.monomial hstdI hstdJ
  exact ⟨p,hp,by simp only [MonomialOrder.leadingTerm,MonomialOrder.leadingCoeff,hpd,hpc]⟩

