variable {σ R : Type*} [CommRing R] [Nontrivial R]

/-- A triangular basis has precisely its index as leading exponent. -/
theorem triangular_basis_degree (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e) (e : σ →₀ ℕ) :
    m.degree (b e) = e := by
  apply m.toSyn.injective
  apply (hb e).2.antisymm
  exact m.le_degree (MvPolynomial.mem_support_iff.mpr (by rw [(hb e).1]; exact one_ne_zero))

theorem triangular_basis_leadingCoeff (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e) (e : σ →₀ ℕ) :
    m.leadingCoeff (b e) = 1 := by
  rw [MonomialOrder.leadingCoeff, triangular_basis_degree m b hb, (hb e).1]

/-- The largest nonzero basis coordinate of a polynomial is exactly its
leading exponent. Distinct leading indices cannot cancel. -/
theorem triangular_basis_degree_repr (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e)
    (p : MvPolynomial σ R) (hp : p ≠ 0) :
    m.degree p = m.degree (AddMonoidAlgebra.ofCoeff (b.repr p) : MvPolynomial σ R) := by
  classical
  let q : MvPolynomial σ R := AddMonoidAlgebra.ofCoeff (b.repr p)
  let e := m.degree q
  have hq : q ≠ 0 := by
    intro hq
    have hc : b.repr p = 0 := congrArg AddMonoidAlgebra.coeff hq
    exact hp (b.repr.injective (by simpa only [map_zero] using hc))
  have hes : e ∈ q.support := m.degree_mem_support hq
  have hexp : p = ∑ j ∈ (b.repr p).support, b.repr p j • b j := by
    simpa only [Finsupp.linearCombination_apply, Finsupp.sum] using (b.linearCombination_repr p).symm
  have hpdegree : m.toSyn (m.degree p) ≤ m.toSyn e := by
    rw [hexp]
    apply m.degree_sum_le.trans
    apply Finset.sup_le
    intro j hj
    exact (m.degree_smul_le.trans (hb j).2).trans (m.le_degree hj)
  have hpc : p.coeff e = q.coeff e := by
    rw [hexp, coeff_sum, Finset.sum_eq_single e]
    · rw [coeff_smul, (hb e).1, smul_eq_mul, mul_one]
    · intro j hj hje
      have hjlt : m.toSyn j < m.toSyn e :=
        lt_of_le_of_ne (m.le_degree hj) (m.toSyn.injective.ne hje)
      have hbe : (b j).coeff e = 0 := by
        by_contra hne
        exact (not_le_of_gt hjlt) ((m.le_degree (MvPolynomial.mem_support_iff.mpr hne)).trans (hb j).2)
      simp only [coeff_smul, hbe, smul_zero]
    · intro he
      exact (he hes).elim
  apply m.toSyn.injective
  exact hpdegree.antisymm (m.le_degree (MvPolynomial.mem_support_iff.mpr
    (by rw [hpc]; exact MvPolynomial.mem_support_iff.mp hes)))

theorem triangular_basis_degree_mem (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e)
    (s : Set (σ →₀ ℕ)) (p : MvPolynomial σ R)
