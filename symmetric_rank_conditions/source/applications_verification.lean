attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ R κ : Type*} [Finite σ] [CommRing R]

def OrderedDegreeExponents (m : MonomialOrder σ) (d : ℕ) :=
  {e : m.syn // weight (fun _ : σ => (1 : ℕ)) (m.toSyn.symm e) = d}

def orderedDegreeExponentEquiv (m : MonomialOrder σ) (d : ℕ) :
    OrderedDegreeExponents m d ≃ {e : σ →₀ ℕ // weight (fun _ : σ => (1 : ℕ)) e = d} where
  toFun e := ⟨m.toSyn.symm e.val, e.property⟩
  invFun e := ⟨m.toSyn e.val, by simpa using e.property⟩
  left_inv e := by apply Subtype.ext; simp
  right_inv e := by apply Subtype.ext; simp

instance orderedDegreeExponentsFinite (m : MonomialOrder σ) (d : ℕ) :
    Finite (OrderedDegreeExponents m d) := by
  letI : Finite {e : σ →₀ ℕ // weight (fun _ : σ => (1 : ℕ)) e = d} :=
    (Finsupp.finite_of_nat_weight_eq (fun _ : σ => 1) (fun _ => one_ne_zero) d).to_subtype
  exact Finite.of_injective (orderedDegreeExponentEquiv m d)
    (orderedDegreeExponentEquiv m d).injective

instance orderedDegreeExponentsFintype (m : MonomialOrder σ) (d : ℕ) :
    Fintype (OrderedDegreeExponents m d) := Fintype.ofFinite _

instance orderedDegreeExponentsLinearOrder (m : MonomialOrder σ) (d : ℕ) :
    LinearOrder (OrderedDegreeExponents m d) := inferInstanceAs (LinearOrder (Subtype _))

abbrev DegreeIndex (m : MonomialOrder σ) (d : ℕ) :=
  Fin (Fintype.card (OrderedDegreeExponents m d))

def degreeEnumeration (m : MonomialOrder σ) (d : ℕ) :
    DegreeIndex m d ≃ {e : σ →₀ ℕ // weight (fun _ : σ => (1 : ℕ)) e = d} :=
  (Fintype.orderIsoFinOfCardEq (OrderedDegreeExponents m d) rfl).toEquiv.trans
    (orderedDegreeExponentEquiv m d)

theorem degreeEnumeration_le_iff (m : MonomialOrder σ) (d : ℕ)
    (i j : DegreeIndex m d) :
    m.toSyn (degreeEnumeration m d i).val ≤ m.toSyn (degreeEnumeration m d j).val ↔ i ≤ j := by
  let e := Fintype.orderIsoFinOfCardEq (OrderedDegreeExponents m d) rfl
  change m.toSyn (m.toSyn.symm (e i).val) ≤
    m.toSyn (m.toSyn.symm (e j).val) ↔ i ≤ j
  rw [AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
  exact OrderIso.le_iff_le e

abbrev DegreeSpace (R : Type*) [CommRing R] (d : ℕ) : Submodule R (MvPolynomial σ R) :=
  restrictSupport R {e | weight (fun _ : σ => (1 : ℕ)) e = d}

def degreeMonomialBasis (m : MonomialOrder σ) (d : ℕ) :
    Basis (DegreeIndex m d) R (DegreeSpace (σ := σ) R d) :=
  (basisRestrictSupport R {e | weight (fun _ : σ => (1 : ℕ)) e = d}).reindex
    (degreeEnumeration m d).symm

def degreeCoordinates (m : MonomialOrder σ) (d : ℕ) :
    (DegreeIndex m d → R) ≃ₗ[R] DegreeSpace (σ := σ) R d :=
  (degreeMonomialBasis (R := R) m d).equivFun.symm

def degreePolynomial (m : MonomialOrder σ) (d : ℕ) :
    (DegreeIndex m d → R) →ₗ[R] MvPolynomial σ R :=
  (DegreeSpace (σ := σ) R d).subtype.comp (degreeCoordinates (R := R) m d).toLinearMap

@[simp] theorem degreePolynomial_coeff (m : MonomialOrder σ) (d : ℕ)
    (x : DegreeIndex m d → R) (i : DegreeIndex m d) :
    (degreePolynomial m d x).coeff (degreeEnumeration m d i).val = x i := by
  change (((degreeMonomialBasis (R := R) m d).equivFun.symm x).val).coeff
    (degreeEnumeration m d i).val = x i
  have h := congrFun ((degreeMonomialBasis (R := R) m d).equivFun.apply_symm_apply x) i
  simpa only [Basis.equivFun_apply, degreeMonomialBasis, Basis.repr_reindex_apply,
    basisRestrictSupport_repr_apply, Equiv.symm_symm] using h

theorem degreePolynomial_injective (m : MonomialOrder σ) (d : ℕ) :
    Function.Injective (degreePolynomial (R := R) m d) := by
  intro x y h
  ext i
  have hc := congrArg (fun p : MvPolynomial σ R => p.coeff (degreeEnumeration m d i).val) h
  simpa only [degreePolynomial_coeff] using hc

theorem degreePolynomial_homogeneous (m : MonomialOrder σ) (d : ℕ)
    (x : DegreeIndex m d → R) :
    (degreePolynomial m d x).IsWeightedHomogeneous (fun _ : σ => (1 : ℕ)) d := by
  intro e he
  exact (mem_restrictSupport_iff R).mp (degreeCoordinates (R := R) m d x).property
    (MvPolynomial.mem_support_iff.mpr he)

theorem degreePolynomial_surjective (m : MonomialOrder σ) (d : ℕ)
    (p : MvPolynomial σ R)
    (hp : p.IsWeightedHomogeneous (fun _ : σ => (1 : ℕ)) d) :
    ∃ x : DegreeIndex m d → R, degreePolynomial m d x = p := by
  have hps : p ∈ DegreeSpace (σ := σ) R d := by
    apply (mem_restrictSupport_iff R).mpr
    intro e he
    exact hp (MvPolynomial.mem_support_iff.mp he)
  refine ⟨(degreeCoordinates (R := R) m d).symm ⟨p, hps⟩, ?_⟩
  exact congrArg Subtype.val ((degreeCoordinates (R := R) m d).apply_symm_apply ⟨p, hps⟩)

theorem degreePolynomial_support_index (m : MonomialOrder σ) (d : ℕ)
    (x : DegreeIndex m d → R) (e : σ →₀ ℕ)
    (he : e ∈ (degreePolynomial m d x).support) :
    ∃ i : DegreeIndex m d, (degreeEnumeration m d i).val = e ∧ x i ≠ 0 := by
  have hed := degreePolynomial_homogeneous m d x (MvPolynomial.mem_support_iff.mp he)
  obtain ⟨i, hi⟩ := (degreeEnumeration m d).surjective ⟨e, hed⟩
  refine ⟨i, congrArg Subtype.val hi, ?_⟩
  rw [← degreePolynomial_coeff m d x i, congrArg Subtype.val hi]
  exact MvPolynomial.mem_support_iff.mp he

theorem degreePolynomial_degree_le_of_below (m : MonomialOrder σ) (d : ℕ)
    (x : DegreeIndex m d → R) (i : DegreeIndex m d) (hx : Below (i.val + 1) x) :
    m.toSyn (m.degree (degreePolynomial m d x)) ≤ m.toSyn (degreeEnumeration m d i).val := by
