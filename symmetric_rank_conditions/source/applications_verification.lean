/-!
# Section 6 applications: simultaneous bases and flat degenerations

See `notes/section-six-integration.md` for the exact correspondence with
Lemma 6.2, Corollary 6.3 and Proposition 6.4. The project result inventory
records the compilation status and the accepted source identities.

The imported proofs construct the common basis, use actual finite ideal
sums/intersections, identify the field atoms with genuine symbolic powers,
and retain arbitrary commutative base change and arbitrary specialization.
-/

set_option autoImplicit false
noncomputable section

namespace FourPapers.Symmetric

universe u v w
open scoped TensorProduct

/-- Scalar extension of the actual northwest coordinate quotient is the
corresponding quotient over the new coefficient ring. No flatness or
injectivity assumption is imposed on the coefficient algebra. -/
def northwestQuotientBaseChangeEquiv {n : ℕ} (R : Type u) (S : Type v)
    [CommRing R] [CommRing S] [Algebra R S] (r : RankArray n) :
    S ⊗[R] (CoordinateRing n R ⧸ northwestIdeal R r) ≃ₐ[S]
      CoordinateRing n S ⧸ northwestIdeal S r := by
  let e := MvPolynomial.algebraTensorAlgEquiv (σ := Entry n) R S
  let ι : CoordinateRing n R →+* S ⊗[R] CoordinateRing n R :=
    (Algebra.TensorProduct.includeRight (R := R) (A := S)
      (B := CoordinateRing n R)).toRingHom
  have hcomp : e.toRingHom.comp ι = MvPolynomial.map (algebraMap R S) := by
    apply RingHom.ext
    intro p
    change e (1 ⊗ₜ[R] p) = MvPolynomial.map (algebraMap R S) p
    exact (MvPolynomial.algebraTensorAlgEquiv_tmul R S 1 p).trans (one_smul S _)
  have hmap : northwestIdeal S r = ((northwestIdeal R r).map ι).map e.toRingHom := by
    rw [Ideal.map_map, hcomp, map_northwestIdeal_coeff]
  exact (Algebra.TensorProduct.tensorQuotientEquiv (R := R)
    S (CoordinateRing n R) S (northwestIdeal R r)).trans
      (Ideal.quotientEquivAlg _ _ e hmap)

/-- A realized symmetric rank-profile quotient remains a domain after
actual scalar extension to any coefficient domain. The realizing field
and both coefficient rings have independent universes. -/
theorem symmetric_rank_baseChange_isDomain {n : ℕ} {F : Type w} [Field F]
    (w : Matrix (Fin n) (Fin n) F) (hw : w.transpose = w)
    (R : Type u) (S : Type v) [CommRing R] [CommRing S] [Algebra R S]
    [IsDomain S] :
    IsDomain (S ⊗[R] (CoordinateRing n R ⧸ northwestIdeal R (matrixRankArray w))) := by
  letI := symmetric_rank_quotient_isDomain w hw S
  exact MulEquiv.isDomain (CoordinateRing n S ⧸ northwestIdeal S (matrixRankArray w))
    (northwestQuotientBaseChangeEquiv R S (matrixRankArray w)).toRingEquiv.toMulEquiv

/-- Corollary 6.1, geometric-fiber clause in literal affine coordinate
rings: every field-valued fiber of the integral model stays a domain
under every field extension. The transparent instance bindings select
Mathlib's canonical tensor ring and left algebra; they are not hypotheses. -/
theorem symmetric_rank_geometric_fibers {n : ℕ} {F : Type u} [Field F]
    (w : Matrix (Fin n) (Fin n) F) (hw : w.transpose = w)
    (K : Type v) (L : Type w) [Field K] [Field L] [Algebra K L] :
    letI : CommRing (K ⊗[ℤ]
        (CoordinateRing n ℤ ⧸ northwestIdeal ℤ (matrixRankArray w))) :=
      Algebra.TensorProduct.instCommRing
    letI : Algebra K (K ⊗[ℤ]
        (CoordinateRing n ℤ ⧸ northwestIdeal ℤ (matrixRankArray w))) :=
      Algebra.TensorProduct.leftAlgebra
    IsDomain (L ⊗[K] (K ⊗[ℤ]
      (CoordinateRing n ℤ ⧸ northwestIdeal ℤ (matrixRankArray w)))) := by
  letI : CommRing (K ⊗[ℤ]
      (CoordinateRing n ℤ ⧸ northwestIdeal ℤ (matrixRankArray w))) :=
    Algebra.TensorProduct.instCommRing
  letI : Algebra K (K ⊗[ℤ]
      (CoordinateRing n ℤ ⧸ northwestIdeal ℤ (matrixRankArray w))) :=
    Algebra.TensorProduct.leftAlgebra
  let e : L ⊗[K] (K ⊗[ℤ]
      (CoordinateRing n ℤ ⧸ northwestIdeal ℤ (matrixRankArray w))) ≃ₐ[L]
      L ⊗[K] (CoordinateRing n K ⧸ northwestIdeal K (matrixRankArray w)) :=
    Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[L] L)
      (northwestQuotientBaseChangeEquiv ℤ K (matrixRankArray w))
  letI := symmetric_rank_baseChange_isDomain w hw K L
  exact MulEquiv.isDomain
    (L ⊗[K] (CoordinateRing n K ⧸ northwestIdeal K (matrixRankArray w)))
    e.toRingEquiv.toMulEquiv

/-- The integral model is functorial for every coefficient homomorphism,
including maps between rings with zero divisors. -/
theorem mixed_lattice_baseChange_hom {n : ℕ} {A B : Type*}
    [CommRing A] [CommRing B] (φ : A →+* B) (e : MixedLatticeExpression n) :
    (e.baseChangedIdeal A).map (MvPolynomial.map φ) = e.baseChangedIdeal B := by
  rw [mixed_lattice_baseChange A e, mixed_lattice_baseChange B e, Ideal.map_map]
  have hφ : (MvPolynomial.map φ).comp (MvPolynomial.map (Int.castRingHom A)) =
      (MvPolynomial.map (Int.castRingHom B) : CoordinateRing n ℤ →+* CoordinateRing n B) := by
    apply MvPolynomial.ringHom_ext
    · intro z
      simp
    · intro i
      simp
  rw [hφ]

/-- The precise arbitrary-base-change intersection assertion for the entire
finite compatible lattice, with no flatness hypothesis on the map. -/
theorem mixed_lattice_map_inf {n : ℕ} {A B : Type*}
    [CommRing A] [CommRing B] (φ : A →+* B) (e f : MixedLatticeExpression n) :
    (e.baseChangedIdeal A ⊓ f.baseChangedIdeal A).map (MvPolynomial.map φ) =
      (e.baseChangedIdeal A).map (MvPolynomial.map φ) ⊓
        (f.baseChangedIdeal A).map (MvPolynomial.map φ) := by
  change ((MixedLatticeExpression.inf e f).baseChangedIdeal A).map _ = _
  rw [mixed_lattice_baseChange_hom φ, mixed_lattice_baseChange_hom φ,
    mixed_lattice_baseChange_hom φ]
  rfl

namespace Deformation

/-- The unspecialized quotient itself is free over the actual parameter
ring `ℤ[τ]`, before applying any coefficient homomorphism. -/
theorem latticeDeformation_free {n : ℕ} (e : MixedLatticeExpression n) :
    Module.Free (Polynomial ℤ) (CoordinateRing n (Polynomial ℤ) ⧸ latticeDeformation e) := by
  obtain ⟨b, hb, hspan⟩ := deformed_simultaneous_basis n
  have h := Simultaneous.coordinateQuotient_free b e.monomials
  rw [← latticeDeformation_adapted b hspan e] at h
  exact h

end Deformation
