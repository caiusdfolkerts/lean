variable {σ R : Type*} [CommRing R]

def orderInitialIdeal (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R)) :
    Ideal (MvPolynomial σ R) := Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ R)))

theorem orderInitialIdeal_mono (m : MonomialOrder σ) {I J : Ideal (MvPolynomial σ R)}
    (h : I ≤ J) : orderInitialIdeal m I ≤ orderInitialIdeal m J :=
  Ideal.span_mono (Set.image_mono h)

theorem normalized_lift (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (e : σ →₀ ℕ) (he : e ∉ m.standardMonomials I) :
    ∃ p ∈ I, p.coeff e = 1 ∧ m.toSyn (m.degree p) ≤ m.toSyn e := by
  classical
  let f : MvPolynomial σ R := monomial e 1
  let r := hG.normalForm hu f
  have hrc : r.coeff e = 0 := by
    by_contra hne
    exact he ((mem_restrictSupport_iff R).mp (hG.normalForm_mem_restrictSupport hu f)
      (MvPolynomial.mem_support_iff.mpr hne))
  have hr : m.IsRemainder f G r := (hG.isRemainder_iff_eq_normalForm hu).mpr rfl
  obtain ⟨q, hq, hdegree⟩ := hr.exists_linearCombination
  have heq : f - r = ∑ g ∈ q.support, q g * g.val := by
    rw [hq, add_sub_cancel_right, Finsupp.linearCombination_apply, Finsupp.sum]
    rfl
  have hb : m.toWithBotSyn (m.withBotDegree (f - r)) ≤
      m.toWithBotSyn (m.withBotDegree f) := by
    rw [heq]
    apply m.withBotDegree_sum_le.trans
    apply Finset.sup_le
    intro g hg
    exact (m.toWithBotSyn_withBotDegree_mul_le _ _).trans
      ((add_comm _ _).trans_le (hdegree g))
  refine ⟨f - r, hG.sub_normalForm_mem hu f, ?_, ?_⟩
  · simp only [coeff_sub, f, coeff_monomial, ite_true, hrc, sub_zero]
  · exact ((m.withBotDegree_le_withBotDegree_iff _ _).mp hb).1.trans
      (m.degree_monomial_le _)

/-- A normalized leading monomial common to two ideals lifts to their
actual intersection when the union of their Gröbner bases is a basis of
their sum. The cancellation argument is over the original coefficient ring. -/
theorem normalized_intersection_lift [Nontrivial R]
    (m : MonomialOrder σ) (I J : Ideal (MvPolynomial σ R))
    (G H : Set (MvPolynomial σ R))
    (hG : m.IsGroebnerBasis G I) (hH : m.IsGroebnerBasis H J)
    (huG : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (huH : ∀ g ∈ H, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (hGH : m.IsGroebnerBasis (G ∪ H) (I ⊔ J))
    (e : σ →₀ ℕ) (heI : e ∉ m.standardMonomials I)
    (heJ : e ∉ m.standardMonomials J) :
    ∃ p ∈ I ⊓ J, p.coeff e = 1 ∧ m.degree p = e := by
  classical
  obtain ⟨p, hp, hpc, hpd⟩ := normalized_lift m I G hG huG e heI
  obtain ⟨q, hq, hqc, hqd⟩ := normalized_lift m J H hH huH e heJ
  have hp0 : p ≠ 0 := by
    intro h
    have hc := hpc
    rw [h, MvPolynomial.coeff_zero] at hc
    exact zero_ne_one hc
  have hq0 : q ≠ 0 := by
    intro h
    have hc := hqc
    rw [h, MvPolynomial.coeff_zero] at hc
    exact zero_ne_one hc
  have hpdeg : m.degree p = e := m.toSyn.injective (hpd.antisymm
    (m.le_degree (MvPolynomial.mem_support_iff.mpr (by rw [hpc]; exact one_ne_zero))))
  have hqdeg : m.degree q = e := m.toSyn.injective (hqd.antisymm
    (m.le_degree (MvPolynomial.mem_support_iff.mpr (by rw [hqc]; exact one_ne_zero))))
  have hqp : m.toWithBotSyn (m.withBotDegree q) ≤ m.toWithBotSyn (m.withBotDegree p) := by
    rw [m.withBotDegree_le_withBotDegree_iff_of_ne_zero _ hp0, hpdeg, hqdeg]
  have hdiff : m.toWithBotSyn (m.withBotDegree (p - q)) <
      m.toWithBotSyn (m.withBotDegree p) :=
    m.withBotDegree_sub_lt hp0 hqp (by simp only [MonomialOrder.leadingCoeff, hpdeg, hpc, hqc])
  have hmem : p - q ∈ I ⊔ J :=
    Submodule.mem_sup.mpr ⟨p, hp, -q, J.neg_mem hq, by rw [sub_eq_add_neg]⟩
  obtain ⟨a, ha, b, hb, hab, hda, hdb⟩ :=
    bounded_split_of_union_groebner m I J G H hG.subset hH.subset hGH hmem
  have hpi : m.toWithBotSyn (m.withBotDegree p) = (m.toSyn e : WithBot m.syn) := by
    rw [(m.withBotDegree_eq_coe_degree_iff p).mpr hp0, m.toWithBotSyn_apply_coe, hpdeg]
  have hac : a.coeff e = 0 := by
    by_contra hne
    have hlo := m.le_withBotDegree (MvPolynomial.mem_support_iff.mpr hne)
    have hhi := hda.trans_lt hdiff
    rw [hpi] at hhi
    exact (lt_irrefl (m.toSyn e : WithBot m.syn)) (hlo.trans_lt hhi)
  have hae : m.toSyn (m.degree a) ≤ m.toSyn e := by
    have h := ((m.withBotDegree_le_withBotDegree_iff _ _).mp
      (hda.trans hdiff.le)).1
    simpa only [hpdeg] using h
  have hpeq : p - a = q + b := by
    have h := sub_eq_iff_eq_add.mp hab.symm
    rw [h]
    abel
  have hpa : p - a ∈ I ⊓ J := ⟨I.sub_mem hp ha, by
    rw [hpeq]
    exact J.add_mem hq hb⟩
  have hpac : (p - a).coeff e = 1 := by rw [coeff_sub, hpc, hac, sub_zero]
  have hpad : m.toSyn (m.degree (p - a)) ≤ m.toSyn e :=
    m.degree_sub_le.trans (max_le hpd hae)
  refine ⟨p - a, hpa, hpac, m.toSyn.injective (hpad.antisymm ?_)⟩
  exact m.le_degree (MvPolynomial.mem_support_iff.mpr (by rw [hpac]; exact one_ne_zero))

/-- Exact compatibility of initial ideals with intersection, with every
input stated as the actual Gröbner-basis assertion. No Hilbert, independence,
or common-basis hypothesis is left implicit. -/
theorem initial_inf_of_union_groebner [Nontrivial R]
    (m : MonomialOrder σ) (I J : Ideal (MvPolynomial σ R))
    (G H : Set (MvPolynomial σ R))
    (hG : m.IsGroebnerBasis G I) (hH : m.IsGroebnerBasis H J)
    (huG : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (huH : ∀ g ∈ H, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (hGH : m.IsGroebnerBasis (G ∪ H) (I ⊔ J)) :
    orderInitialIdeal m (I ⊓ J) = orderInitialIdeal m I ⊓ orderInitialIdeal m J := by
  classical
  apply le_antisymm
  · exact le_inf (orderInitialIdeal_mono m inf_le_left)
      (orderInitialIdeal_mono m inf_le_right)
  · intro f hf
    rw [f.as_sum]
    apply Ideal.sum_mem
    intro e he
    have heI : e ∉ m.standardMonomials I := by
      obtain ⟨p, hp, hp0, hpe⟩ :=
        MonomialOrder.exists_degree_le_of_mem_span_leadingTerm hf.1 he
      exact fun h => h p hp hp0 hpe
    have heJ : e ∉ m.standardMonomials J := by
      obtain ⟨p, hp, hp0, hpe⟩ :=
        MonomialOrder.exists_degree_le_of_mem_span_leadingTerm hf.2 he
      exact fun h => h p hp hp0 hpe
    obtain ⟨p, hp, hpc, hpd⟩ :=
      normalized_intersection_lift m I J G H hG hH huG huH hGH e heI heJ
    have hm : monomial e (1 : R) ∈ orderInitialIdeal m (I ⊓ J) := by
      have h : m.leadingTerm p ∈ orderInitialIdeal m (I ⊓ J) :=
        Ideal.subset_span ⟨p, hp, rfl⟩
      simpa only [MonomialOrder.leadingTerm, MonomialOrder.leadingCoeff, hpd, hpc] using h
    have h := (orderInitialIdeal m (I ⊓ J)).mul_mem_left (C (f.coeff e)) hm
    simpa only [C_mul_monomial, mul_one] using h

