namespace FourPapers.Symmetric.Deformation

open MvPolynomial Finsupp

variable {n t : ℕ}

/-- The paper numbers matrix endpoints from one. -/
def entryWeight (e : Entry n) : ℕ := (e.val.1.val + 1) * (e.val.2.val + 1)

@[simp] theorem entryWeight_fold (i j : Fin n) :
    entryWeight (fold i j) = (i.val + 1) * (j.val + 1) := by
  change ((max i j).val + 1) * ((min i j).val + 1) =
    (i.val + 1) * (j.val + 1)
  by_cases h : i ≤ j
  · rw [max_eq_right h, min_eq_left h]
    exact Nat.mul_comm _ _
  · have h' : j ≤ i := le_of_not_ge h
    rw [max_eq_left h', min_eq_right h']

def termWeight (a b : Fin t ↪o Fin n) (π : Equiv.Perm (Fin t)) : ℕ :=
  ∑ p, ((a (π p)).val + 1) * ((b p).val + 1)

def minorWeight (a b : Fin t ↪o Fin n) : ℕ := termWeight a b Fin.revPerm

theorem weight_permutationExponent (a b : Fin t ↪o Fin n) (π : Equiv.Perm (Fin t)) :
    weight entryWeight (permutationExponent a b π) = termWeight a b π := by
  simp only [permutationExponent, map_sum, weight_single, one_nsmul,
    entryWeight_fold, termWeight]

theorem minorWeight_eq_paper_sum (a b : Fin t ↪o Fin n) :
    minorWeight a b = ∑ p, ((a p).val + 1) * ((b p.rev).val + 1) := by
  unfold minorWeight termWeight
  simpa only [Fin.revPerm_apply, Fin.rev_rev] using
    Equiv.sum_comp Fin.revPerm (fun p : Fin t => ((a p).val + 1) * ((b p.rev).val + 1))

/-- Strict rearrangement is an instance of the already proved all-size
strict anti-Monge assignment theorem, using the reversed order on integers. -/
theorem integer_weight_strictAntiMonge (a b : Fin t ↪o Fin n) :
    StrictAntiMonge (fun i j : Fin t =>
      (OrderDual.toDual (((a j).val + 1 : ℤ) * ((b i).val + 1 : ℤ)))) := by
  intro i j p q hij hpq
  change ((a q).val + 1 : ℤ) * ((b i).val + 1 : ℤ) +
      ((a p).val + 1 : ℤ) * ((b j).val + 1 : ℤ) <
    ((a p).val + 1 : ℤ) * ((b i).val + 1 : ℤ) +
      ((a q).val + 1 : ℤ) * ((b j).val + 1 : ℤ)
  have ha : (a p).val < (a q).val := a.strictMono hpq
  have hb : (b i).val < (b j).val := b.strictMono hij
  have ha' : (a p).val < (a q).val := ha
  have hb' : (b i).val < (b j).val := hb
  have hap : (0 : ℤ) < (a q).val - (a p).val := by omega
  have hbp : (0 : ℤ) < (b j).val - (b i).val := by omega
  nlinarith [mul_pos hap hbp]

theorem minorWeight_le_termWeight (a b : Fin t ↪o Fin n) (π : Equiv.Perm (Fin t)) :
    minorWeight a b ≤ termWeight a b π := by
  have h := assignmentScore_le_reverse (integer_weight_strictAntiMonge a b) π
  change (∑ p, (((a (Fin.revPerm p)).val + 1 : ℤ) * ((b p).val + 1 : ℤ))) ≤
    ∑ p, (((a (π p)).val + 1 : ℤ) * ((b p).val + 1 : ℤ)) at h
  exact_mod_cast h

theorem minorWeight_lt_termWeight (a b : Fin t ↪o Fin n)
    (π : Equiv.Perm (Fin t)) (hπ : π ≠ Fin.revPerm) :
    minorWeight a b < termWeight a b π := by
  have h := assignmentScore_lt_reverse (integer_weight_strictAntiMonge a b) π hπ
  change (∑ p, (((a (Fin.revPerm p)).val + 1 : ℤ) * ((b p).val + 1 : ℤ))) <
    ∑ p, (((a (π p)).val + 1 : ℤ) * ((b p).val + 1 : ℤ)) at h
  exact_mod_cast h

/-- Literal polynomial form of `τ^{-ω(A,B)} det(τ^{ab}u_ab)`.
The exponent subtraction is proved nonnegative term by term above. -/
def minorDeformation (a b : Fin t ↪o Fin n) : CoordinateRing n (Polynomial ℤ) :=
  ∑ π : Equiv.Perm (Fin t), monomial (permutationExponent a b π)
    (Polynomial.C (signCoefficient ℤ π) * Polynomial.X ^ (termWeight a b π - minorWeight a b))

def specialization (c : ℤ) : CoordinateRing n (Polynomial ℤ) →+* CoordinateRing n ℤ :=
  MvPolynomial.map (Polynomial.evalRingHom c)

/-- The fiber at one is the original determinant, with its original sign. -/
theorem minorDeformation_at_one (a b : Fin t ↪o Fin n) :
    specialization 1 (minorDeformation a b) = minor ℤ a b := by
  rw [minor_eq_sum]
  simp only [specialization, minorDeformation, map_sum, map_monomial,
    map_mul, map_pow, Polynomial.coe_evalRingHom, Polynomial.eval_C, Polynomial.eval_X,
    one_pow, mul_one]

/-- The fiber at zero is the signed folded antidiagonal. Multiplicities
caused by identifying transposed variables are retained. -/
theorem minorDeformation_at_zero (a b : Fin t ↪o Fin n) :
    specialization 0 (minorDeformation a b) =
      monomial (antidiagonalExponent a b) (signCoefficient ℤ (Fin.revPerm : Equiv.Perm (Fin t))) := by
  classical
  simp only [specialization, minorDeformation, map_sum, map_monomial,
    map_mul, map_pow, Polynomial.coe_evalRingHom, Polynomial.eval_C, Polynomial.eval_X]
  rw [Finset.sum_eq_single Fin.revPerm]
  · simp only [minorWeight, Nat.sub_self, pow_zero, mul_one, permutationExponent_reverse]
  · intro π hπ hne
    have hp : 0 < termWeight a b π - minorWeight a b :=
      Nat.sub_pos_of_lt (minorWeight_lt_termWeight a b π hne)
    simp only [zero_pow (Nat.ne_of_gt hp), mul_zero, monomial_zero]
  · simp

theorem minorDeformation_degree_le (a b : Fin t ↪o Fin n) :
    (foldedOrder n).toSyn ((foldedOrder n).degree (minorDeformation a b)) ≤
      (foldedOrder n).toSyn (antidiagonalExponent a b) := by
  unfold minorDeformation
  apply (foldedOrder n).degree_sum_le.trans
  apply Finset.sup_le
  intro π hπ
  exact ((foldedOrder n).degree_monomial_le _).trans
    (permutationExponent_le_antidiagonal a b π)

theorem minorDeformation_coeff_antidiagonal (a b : Fin t ↪o Fin n) :
    (minorDeformation a b).coeff (antidiagonalExponent a b) =
      Polynomial.C (signCoefficient ℤ (Fin.revPerm : Equiv.Perm (Fin t))) := by
  classical
  rw [minorDeformation, coeff_sum, Finset.sum_eq_single Fin.revPerm]
  · simp only [permutationExponent_reverse, coeff_monomial, ite_true,
      minorWeight, Nat.sub_self, pow_zero, mul_one]
  · intro π hπ hne
    have hne' : permutationExponent a b π ≠ antidiagonalExponent a b := by
      intro heq
      exact (permutationExponent_lt_antidiagonal a b π hne).ne
        (congrArg (foldedOrder n).toSyn heq)
    simp only [coeff_monomial, if_neg hne']
  · simp

theorem minorDeformation_degree (a b : Fin t ↪o Fin n) :
    (foldedOrder n).degree (minorDeformation a b) = antidiagonalExponent a b := by
  apply (foldedOrder n).toSyn.injective
  apply (minorDeformation_degree_le a b).antisymm
  apply (foldedOrder n).le_degree
  apply MvPolynomial.mem_support_iff.mpr
  rw [minorDeformation_coeff_antidiagonal]
  simpa only [map_zero] using
    Polynomial.C_injective.ne (signCoefficient_isUnit ℤ (Fin.revPerm : Equiv.Perm (Fin t))).ne_zero

theorem minorDeformation_leadingCoeff (a b : Fin t ↪o Fin n) :
    (foldedOrder n).leadingCoeff (minorDeformation a b) =
      Polynomial.C (signCoefficient ℤ (Fin.revPerm : Equiv.Perm (Fin t))) := by
  rw [MonomialOrder.leadingCoeff, minorDeformation_degree, minorDeformation_coeff_antidiagonal]

theorem minorDeformation_unit_leading (a b : Fin t ↪o Fin n) :
    IsUnit ((foldedOrder n).leadingCoeff (minorDeformation a b)) := by
  rw [minorDeformation_leadingCoeff]
  exact (signCoefficient_isUnit ℤ (Fin.revPerm : Equiv.Perm (Fin t))).map Polynomial.C

end FourPapers.Symmetric.Deformation
end
