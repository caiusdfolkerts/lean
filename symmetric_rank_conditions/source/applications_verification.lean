/-!
# The determinant's exact symbolic order

The result is uniform in every field, valid minor size, symbolic exponent,
determinant power, and polynomial. The proof uses the actual symbolic-power
Gröbner theorem and the unrestricted determinant antidiagonal score identity.
It does not assume a formula for an associated graded local ring.
-/

namespace FourPapers.Symmetric
open MvPolynomial
universe u

/-- The unique full ordered minor datum, including the empty matrix. -/
def fullMinor (n : ℕ) : MinorData n :=
  ⟨n, (OrderIso.refl (Fin n)).toOrderEmbedding, (OrderIso.refl (Fin n)).toOrderEmbedding⟩

/-- The actual determinant of the generic symmetric matrix. -/
def fullDeterminant (n : ℕ) (R : Type*) [CommRing R] : CoordinateRing n R :=
  (fullMinor n).polynomial R

@[simp] theorem fullDeterminant_eq_det (n : ℕ) (R : Type*) [CommRing R] :
    fullDeterminant n R = (genericMatrix n R).det := rfl

@[simp] theorem fullMinor_size (n : ℕ) : (fullMinor n).size = n := rfl

@[simp] theorem fullMinor_exponent (n : ℕ) :
    (fullMinor n).exponent = fullAntidiagonalExponent n := rfl

theorem fullDeterminant_degree (n : ℕ) (R : Type*) [CommRing R] [Nontrivial R] :
    (foldedOrder n).degree (fullDeterminant n R) = fullAntidiagonalExponent n :=
  (fullMinor n).degree_polynomial R

theorem fullDeterminant_ne_zero (n : ℕ) (R : Type*) [CommRing R] [Nontrivial R] :
    fullDeterminant n R ≠ 0 :=
  (foldedOrder n).leadingCoeff_eq_zero_iff.not.mp
    ((fullMinor n).leadingCoeff_polynomial_isUnit R).ne_zero

theorem minorData_size_le {n : ℕ} (δ : MinorData n) : δ.size ≤ n := by
  simpa only [Fintype.card_fin] using Fintype.card_le_of_injective _ δ.rows.injective

theorem minorData_polynomial_eq_full {n : ℕ} (R : Type*) [CommRing R]
    (δ : MinorData n) (hδ : δ.size = n) : δ.polynomial R = fullDeterminant n R := by
  rcases δ with ⟨t, a, b⟩
  dsimp only at hδ
  subst t
  have ha : a = (OrderIso.refl (Fin n)).toOrderEmbedding := by
    ext i
    exact congrArg Fin.val (a.strictMono.apply_eq (x := i))
  have hb : b = (OrderIso.refl (Fin n)).toOrderEmbedding := by
    ext i
    exact congrArg Fin.val (b.strictMono.apply_eq (x := i))
  subst a
  subst b
  rfl

/-- At full minor size the exact-score products are precisely determinant
powers. This equality is proved from all ordered minor data. -/
theorem symbolicGenerators_full_eq_singleton (n : ℕ) (R : Type*) [CommRing R] (b : ℕ) :
    symbolicGenerators R n n b = {fullDeterminant n R ^ b} := by
  classical
  ext f
  constructor
  · rintro ⟨k, δ, hsize, hscore, rfl⟩
    have hs : ∀ j, (δ j).size = n := fun j => (minorData_size_le (δ j)).antisymm (hsize j)
    have hk : k = b := by
      simpa only [hs, Nat.sub_self, zero_add, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, smul_eq_mul, mul_one] using hscore
    have hp : ∀ j, (δ j).polynomial R = fullDeterminant n R :=
      fun j => minorData_polynomial_eq_full R (δ j) (hs j)
    simp only [Set.mem_singleton_iff, hp, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, hk]
  · intro hf
    have hf' : f = fullDeterminant n R ^ b := Set.mem_singleton_iff.mp hf
    rw [hf']
    refine ⟨b, fun _ => fullMinor n, fun _ => le_rfl, ?_, ?_⟩
    · simp only [fullMinor_size, Nat.sub_self, zero_add, Finset.sum_const,
        Finset.card_univ, Fintype.card_fin, smul_eq_mul, mul_one]
    · simp only [fullDeterminant, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-- The full determinant prime has exactly its ordinary principal powers,
including symbolic exponent zero. -/
theorem symbolicPower_fullDeterminantal (n : ℕ) (K : Type u) [Field K]
    (hn : 0 < n) (b : ℕ) :
    symbolicPower (determinantalIdeal n K n) b = Ideal.span {fullDeterminant n K ^ b} := by
  letI := Rees.determinantal_prime n K n hn
  by_cases hb : b = 0
  · subst b
    simp
  · rw [(Rees.full_symbolic_groebner n K n b hn le_rfl
      (Nat.pos_of_ne_zero hb)).ideal_eq_span, symbolicGenerators_full_eq_singleton]

/-- A nonzero member of a genuine symbolic power has the required score in
its leading monomial. The exponent is unrestricted, including zero. -/
theorem symbolic_leading_score {n : ℕ} (K : Type u) [Field K]
    (r a : ℕ) (hr : 0 < r) (hrn : r ≤ n) {f : CoordinateRing n K}
    (hf : f ∈ symbolicPower (determinantalIdeal n K r) a) (hf0 : f ≠ 0) :
    a ≤ gamma r ((foldedOrder n).degree f) := by
  have hlt : (foldedOrder n).leadingTerm f ∈
      Rees.coefficientInitial (foldedOrder n) (symbolicPower (determinantalIdeal n K r) a) :=
    Ideal.subset_span ⟨f, hf, rfl⟩
  apply (Rees.mem_coefficientInitial_symbolic_iff_gamma n K r a hr hrn _).mp hlt
  rw [(foldedOrder n).support_leadingTerm' hf0]
  exact Finset.mem_singleton_self _

/-- Standard exponents lie strictly below the actual symbolic score threshold. -/
theorem gamma_lt_of_symbolic_standard {n : ℕ} (K : Type u) [Field K]
    (r a : ℕ) (hr : 0 < r) (hrn : r ≤ n) (e : Entry n →₀ ℕ)
    (he : e ∈ (foldedOrder n).standardMonomials
      (symbolicPower (determinantalIdeal n K r) a)) : gamma r e < a := by
  classical
  by_contra h
  have hscore : a ≤ gamma r e := le_of_not_gt h
  have hm : monomial e (1 : K) ∈ Rees.coefficientInitial (foldedOrder n)
      (symbolicPower (determinantalIdeal n K r) a) := by
    apply (Rees.mem_coefficientInitial_symbolic_iff_gamma n K r a hr hrn _).mpr
    intro d hd
    have hde : d = e := by simpa only [support_monomial, one_ne_zero, if_false,
      Finset.mem_singleton] using hd
    simpa only [hde] using hscore
  obtain ⟨p, hp, hp0, hpe⟩ :=
    MonomialOrder.exists_degree_le_of_mem_span_leadingTerm hm
      (by simp : e ∈ (monomial e (1 : K)).support)
  exact he p hp hp0 hpe

/-- The determinant's score increment in the paper's positive-size notation. -/
theorem gamma_add_determinant_antidiagonal (n r : ℕ) (hr : 0 < r) (hrn : r ≤ n)
    (e : Entry n →₀ ℕ) (b : ℕ) :
    gamma r (e + b • fullAntidiagonalExponent n) = gamma r e + b * (n - r + 1) := by
  have hsize : n - (r - 1) = n - r + 1 := by omega
  simpa only [Nat.sub_add_cancel hr, hsize] using gamma_add_fullAntidiagonal n (r - 1) e b

/-- Every determinant factor contributes its full symbolic order. -/
theorem fullDeterminant_pow_mem_symbolicPower (n : ℕ) (K : Type u) [Field K]
    (r : ℕ) (hr : 0 < r) (hrn : r ≤ n) (b : ℕ) :
    fullDeterminant n K ^ b ∈ symbolicPower (determinantalIdeal n K r) (b * (n - r + 1)) := by
  letI := Rees.determinantal_prime n K r hr
  have hD : fullDeterminant n K ∈ symbolicPower (determinantalIdeal n K r) (n - r + 1) := by
    apply (Rees.full_symbolic_groebner n K r (n - r + 1) hr hrn (Nat.zero_lt_succ _)).subset
    refine ⟨1, fun _ => fullMinor n, fun _ => hrn, ?_, ?_⟩
    · simp only [fullMinor_size, Fin.sum_univ_one]
    · simp only [Fin.prod_univ_one, fullDeterminant]
  induction b with
  | zero => simp
  | succ b ih =>
    simpa only [pow_succ, Nat.succ_mul] using
      mul_mem_symbolicPower_add (determinantalIdeal n K r) ih hD

/-- Proposition 7.3's exact symbolic cancellation formula, for every
polynomial and all natural symbolic and determinant exponents. -/
theorem fullDeterminant_pow_mul_mem_symbolicPower_iff (n : ℕ) (K : Type u) [Field K]
    (r : ℕ) (hr : 0 < r) (hrn : r ≤ n) (a b : ℕ) (f : CoordinateRing n K) :
    fullDeterminant n K ^ b * f ∈ symbolicPower (determinantalIdeal n K r) a ↔
      f ∈ symbolicPower (determinantalIdeal n K r) (a - b * (n - r + 1)) := by
  classical
  letI := Rees.determinantal_prime n K r hr
  let q := a - b * (n - r + 1)
  have hforward : ∀ g ∈ symbolicPower (determinantalIdeal n K r) q,
      fullDeterminant n K ^ b * g ∈ symbolicPower (determinantalIdeal n K r) a := by
    intro g hg
    have hprod := mul_mem_symbolicPower_add (determinantalIdeal n K r)
      (fullDeterminant_pow_mem_symbolicPower n K r hr hrn b) hg
    exact symbolicPower_antitone (determinantalIdeal n K r) (by dsimp [q]; omega) hprod
  constructor
  · intro hf
    by_cases hq : q = 0
    · change f ∈ symbolicPower (determinantalIdeal n K r) q
      rw [hq, symbolicPower_zero]
      trivial
    · have hG := Rees.full_symbolic_groebner n K r q hr hrn (Nat.pos_of_ne_zero hq)
      let hu := symbolicGenerators_unit_leading K n r q
      let u := hG.normalForm hu f
      have huI : fullDeterminant n K ^ b * u ∈ symbolicPower (determinantalIdeal n K r) a := by
        have hh := (symbolicPower (determinantalIdeal n K r) a).sub_mem hf
          (hforward (f - u) (hG.sub_normalForm_mem hu f))
        have heq : fullDeterminant n K ^ b * f -
            fullDeterminant n K ^ b * (f - u) = fullDeterminant n K ^ b * u := by ring
        rwa [heq] at hh
      have hu0 : u = 0 := by
        by_contra hu0
        have hD0 := pow_ne_zero b (fullDeterminant_ne_zero n K)
        have hs := symbolic_leading_score K r a hr hrn huI (mul_ne_zero hD0 hu0)
        rw [(foldedOrder n).degree_mul hD0 hu0, (foldedOrder n).degree_pow,
          fullDeterminant_degree, add_comm, gamma_add_determinant_antidiagonal n r hr hrn] at hs
        have hstd : (foldedOrder n).degree u ∈
            (foldedOrder n).standardMonomials (symbolicPower (determinantalIdeal n K r) q) :=
          (mem_restrictSupport_iff K).mp (hG.normalForm_mem_restrictSupport hu f)
            ((foldedOrder n).degree_mem_support hu0)
        have hsmall := gamma_lt_of_symbolic_standard K r q hr hrn _ hstd
        dsimp only [q] at hsmall
        omega
      exact (hG.normalForm_eq_zero_iff hu).mp hu0
  · exact hforward f

/-- The complete ideal equality in Proposition 7.3. Both sides use genuine
symbolic powers; the factor on the right is the literal principal ideal. -/
theorem symbolicPower_inter_fullDeterminantal (n : ℕ) (K : Type u) [Field K]
    (r : ℕ) (hr : 0 < r) (hrn : r ≤ n) (a b : ℕ) :
    symbolicPower (determinantalIdeal n K r) a ⊓
        symbolicPower (determinantalIdeal n K n) b =
      Ideal.span {fullDeterminant n K ^ b} *
        symbolicPower (determinantalIdeal n K r) (a - b * (n - r + 1)) := by
  rw [symbolicPower_fullDeterminantal n K (hr.trans_le hrn) b]
  ext f
  rw [Ideal.mem_inf, Ideal.mem_span_singleton_mul]
  constructor
  · rintro ⟨hf, hD⟩
    obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton.mp hD
    exact ⟨g, (fullDeterminant_pow_mul_mem_symbolicPower_iff n K r hr hrn a b g).mp hf, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨(fullDeterminant_pow_mul_mem_symbolicPower_iff n K r hr hrn a b g).mpr hg,
      Ideal.mem_span_singleton.mpr ⟨g, rfl⟩⟩

end FourPapers.Symmetric
end
