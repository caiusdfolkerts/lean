def specializationTo (A : Type*) [CommRing A] (c : A) :
    CoordinateRing n (Polynomial ℤ) →+* CoordinateRing n A :=
  MvPolynomial.map (Polynomial.eval₂RingHom (Int.castRingHom A) c)

theorem specializationTo_int (A : Type*) [CommRing A] (c : ℤ) :
    specializationTo (n := n) A (c : A) =
      (MvPolynomial.map (Int.castRingHom A)).comp (specialization c) := by
  have hcoeff : Polynomial.eval₂RingHom (Int.castRingHom A) (c : A) =
      (Int.castRingHom A).comp (Polynomial.evalRingHom c) := by
    apply Polynomial.ringHom_ext
    · intro z
      simp
    · simp
  apply RingHom.ext
  intro p
  simp only [specializationTo, specialization, hcoeff, RingHom.comp_apply,
    MvPolynomial.map_map]

theorem latticeDeformation_at_one_after_baseChange (A : Type*) [CommRing A]
    (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (specializationTo A (1 : A)) = e.baseChangedIdeal A := by
  rw [show (1 : A) = ((1 : ℤ) : A) from by simp,
    specializationTo_int A 1, ← Ideal.map_map, latticeDeformation_at_one,
    mixed_lattice_baseChange A e]

theorem latticeDeformation_at_zero_after_baseChange (A : Type*) [CommRing A]
    (e : MixedLatticeExpression n) :
    (latticeDeformation e).map (specializationTo A (0 : A)) =
      orderInitialIdeal (foldedOrder n) (e.baseChangedIdeal A) := by
  obtain ⟨b, hb, hspan⟩ := all_mixed_integral_simultaneous_basis n
  have hG := triangular_ideal_groebner (foldedOrder n) b
    (fun a => ⟨(hb a).1, (hb a).2.2⟩) e.ideal e.monomials (e.adapted b hspan)
  have hu : ∀ g ∈ b '' e.monomials, g ≠ 0 → IsUnit ((foldedOrder n).leadingCoeff g) := by
    rintro _ ⟨a, ha, rfl⟩ hg0
    rw [triangular_basis_leadingCoeff (foldedOrder n) b (fun a => ⟨(hb a).1, (hb a).2.2⟩)]
    exact isUnit_one
  rw [show (0 : A) = ((0 : ℤ) : A) from by simp,
    specializationTo_int A 0, ← Ideal.map_map, latticeDeformation_at_zero,
    mixed_lattice_baseChange A e,
    initial_map_of_unit_groebner (foldedOrder n) (Int.castRingHom A) e.ideal
      (b '' e.monomials) hG hu]

