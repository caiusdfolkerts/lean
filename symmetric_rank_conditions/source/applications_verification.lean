section

set_option autoImplicit false
set_option maxHeartbeats 1400000
noncomputable section

/-!
# The literal full antidiagonal in carrier coordinates

This module identifies the determinant's actual folded exponent, including
every repeated off-diagonal coordinate, with the explicit offsets in
`DeterminantCarrier`. No coefficient formula is substituted as a definition of
the determinant antidiagonal.
-/

namespace FourPapers.Symmetric

/-- The actual folded antidiagonal of the full generic symmetric determinant. -/
def fullAntidiagonalExponent (n : ℕ) : Entry n →₀ ℕ :=
  antidiagonalExponent ((OrderIso.refl (Fin n)).toOrderEmbedding) ((OrderIso.refl (Fin n)).toOrderEmbedding)

/-- The two possible positions that fold onto a given full-antidiagonal entry. -/
theorem fold_rev_eq_iff {n : ℕ} (p : Fin n) (e : Entry n) :
    fold p p.rev = e ↔
      e.val.1.val + e.val.2.val + 1 = n ∧ (p = e.val.1 ∨ p = e.val.2) := by
  have he : fold e.val.1 e.val.2 = e := by
    apply Subtype.ext
    simp only [fold,max_eq_left e.property,min_eq_right e.property]
    rfl
  constructor
  · intro h
    rcases (fold_eq_iff p p.rev e.val.1 e.val.2).mp (h.trans he.symm) with
      ⟨hu,hl⟩ | ⟨hl,hu⟩
    · refine ⟨?_,Or.inl hu⟩
      have hu' := congrArg Fin.val hu
      have hl' := congrArg Fin.val hl
      have hp := p.isLt
      simp only [Fin.val_rev] at hl'
      omega
    · refine ⟨?_,Or.inr hl⟩
      have hu' := congrArg Fin.val hu
      have hl' := congrArg Fin.val hl
      have hp := p.isLt
      simp only [Fin.val_rev] at hu'
      omega
  · rintro ⟨h,hp | hp⟩
    · have hr : p.rev = e.val.2 := by
        apply Fin.ext
        have hp' := congrArg Fin.val hp
        simp only [Fin.val_rev]
        omega
      exact ((fold_eq_iff p p.rev e.val.1 e.val.2).mpr
        (Or.inl ⟨hp,hr⟩)).trans he
    · have hr : p.rev = e.val.1 := by
        apply Fin.ext
        have hp' := congrArg Fin.val hp
        simp only [Fin.val_rev]
        omega
      exact ((fold_eq_iff p p.rev e.val.1 e.val.2).mpr
        (Or.inr ⟨hp,hr⟩)).trans he

/-- Off-diagonal coordinates occur twice and diagonal coordinates once, exactly
on the full antidiagonal; this includes the empty matrix. -/
theorem fullAntidiagonalExponent_apply {n : ℕ} (e : Entry n) :
    fullAntidiagonalExponent n e = DeterminantCarrier.antiOffset n 1 e := by
  classical
  simp only [fullAntidiagonalExponent,antidiagonalExponent,Finsupp.finsetSum_apply,
    OrderIso.coe_toOrderEmbedding,OrderIso.refl_apply,Finsupp.single_apply,fold_rev_eq_iff]
  unfold DeterminantCarrier.antiOffset
  by_cases h : e.val.1.val + e.val.2.val + 1 = n
  · have h' : e.val.2.val + e.val.1.val + 1 = n := by omega
    simp only [h,h',true_and,if_true]
    rw [Finset.sum_boole]
    have hs : (Finset.univ : Finset (Fin n)).filter
        (fun p => p = e.val.1 ∨ p = e.val.2) = {e.val.1,e.val.2} := by
      ext p
      simp
    rw [hs]
    by_cases hd : e.val.2 = e.val.1
    · simp [hd]
    · have hv : e.val.2.val ≠ e.val.1.val := fun h => hd (Fin.ext h)
      simp [hd, Ne.symm hd, hv]
  · have h' : ¬ e.val.2.val + e.val.1.val + 1 = n := by omega
    simp [h,h']

/-- Restrict the literal full antidiagonal to the nonpivot coordinates. -/
def fullAntidiagonalPivot (n : ℕ) : PivotVariables n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm
    (fun v => fullAntidiagonalExponent (n+1) (matchingPivotNonzero v))

@[simp] theorem fullAntidiagonalPivot_apply {n : ℕ} (v : PivotVariables n) :
    fullAntidiagonalPivot n v =
      fullAntidiagonalExponent (n+1) (matchingPivotNonzero v) := rfl

/-- The literal determinant contributes two pivot-row occurrences at the final
residual vertex, and the adjacent antidiagonal in the residual block. -/
theorem carrierState_fullAntidiagonalPivot (n : ℕ) :
    carrierStateOfMonomial (fullAntidiagonalPivot n) =
      DeterminantCarrier.sourceAntidiagonal n := by
  apply Prod.ext
  · funext i
    change fullAntidiagonalExponent (n+1) (matchingPivotNonzero (.inl i)) = _
    rw [fullAntidiagonalExponent_apply]
    change (if 0 + (i.val + 1) + 1 = n + 1 then
      if (0 : ℕ) = i.val + 1 then 1 else 2 else 0) =
        (if i.val + 1 = n then 2 else 0)
    simp only [zero_add]
    have he : (i.val+1+1=n+1) ↔ i.val+1=n := by omega
    have hz : ¬ (0 = i.val+1) := by omega
    simp only [he,hz,if_false]
  · funext e
    change fullAntidiagonalExponent (n+1) (matchingPivotNonzero (.inr e)) = _
    rw [fullAntidiagonalExponent_apply]
    change (if (e.val.2.val + 1) + (e.val.1.val + 1) + 1 = n + 1 then
      if e.val.2.val + 1 = e.val.1.val + 1 then 1 else 2 else 0) =
        (if e.val.2.val + e.val.1.val + 2 = n then
          if e.val.2.val = e.val.1.val then 1 else 2 else 0)
    have he : (e.val.2.val+1+(e.val.1.val+1)+1=n+1) ↔
        e.val.2.val+e.val.1.val+2=n := by omega
    simp only [he,Nat.add_right_cancel_iff]

/-- The output offset is the literal full residual determinant, with zero
carrier coordinates. -/
theorem residualAntidiagonal_eq (n : ℕ) :
    DeterminantCarrier.residualAntidiagonal n =
      (fun _ => 0,fun e => fullAntidiagonalExponent n e) := by
  apply Prod.ext
  · rfl
  · funext e
    exact (fullAntidiagonalExponent_apply e).symm

/-- The exact monomial carrier respects arbitrary powers of the full
antidiagonal. This is an identity of actual finite exponent vectors. -/
theorem monomialCarrierEquiv_add_fullAntidiagonal {n : ℕ}
    (m : PivotVariables n →₀ ℕ) (b : ℕ) :
    monomialCarrierEquiv n (m + b • fullAntidiagonalPivot n) =
      ((monomialCarrierEquiv n m).1,
        (monomialCarrierEquiv n m).2 + b • fullAntidiagonalExponent n) := by
  have hs : carrierStateOfMonomial (m + b • fullAntidiagonalPivot n) =
      DeterminantCarrier.addState (carrierStateOfMonomial m)
        (DeterminantCarrier.scaleState b (DeterminantCarrier.sourceAntidiagonal n)) := by
    rw [←carrierState_fullAntidiagonalPivot]
    apply Prod.ext <;> funext k <;>
      simp [carrierStateOfMonomial,DeterminantCarrier.addState,
        DeterminantCarrier.scaleState,nsmul_eq_mul]
  have h := DeterminantCarrier.sweep_add_antidiagonal_power n b (carrierStateOfMonomial m)
  rw [←hs,residualAntidiagonal_eq] at h
  apply Prod.ext
  · funext i
    have hi := congrArg (fun s : ExactCarrierState n => s.1 i) h
    change (exactCarrierEquiv n
      (carrierStateOfMonomial (m + b • fullAntidiagonalPivot n))).1 i =
        (exactCarrierEquiv n (carrierStateOfMonomial m)).1 i
    simpa only [DeterminantCarrier.addState,
      DeterminantCarrier.scaleState,mul_zero,add_zero] using hi
  · ext e
    have he := congrArg (fun s : ExactCarrierState n => s.2 e) h
    simp only [Finsupp.add_apply,Finsupp.smul_apply,smul_eq_mul]
    change (exactCarrierEquiv n
      (carrierStateOfMonomial (m + b • fullAntidiagonalPivot n))).2 e =
        (exactCarrierEquiv n (carrierStateOfMonomial m)).2 e +
          b * fullAntidiagonalExponent n e
    simpa only [DeterminantCarrier.addState,DeterminantCarrier.scaleState] using he

end FourPapers.Symmetric
end
end
