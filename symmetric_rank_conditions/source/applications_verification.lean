    change f ∈ Ideal.span (MvPolynomial.map (algebraMap R S) '' (I : Set (MvPolynomial σ R))) at hf
    have h := Submodule.span_induction
      (p := fun q _ => ∀ a : MvPolynomial σ S, a * q ∈ N)
      (fun q hq a => by
        obtain ⟨f, hf, rfl⟩ := hq
        exact hmul f hf a)
      (fun a => by simpa using N.zero_mem)
      (fun q q' hq hq' ihq ihq' a => by
        simpa only [mul_add] using N.add_mem (ihq a) (ihq' a))
