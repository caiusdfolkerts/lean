section

set_option autoImplicit false
set_option maxHeartbeats 1600000

noncomputable section

/-!
# Simultaneous triangular bases

This file separates the linear algebra of Lemma 6.2 from its polynomial
application. A coordinate span is an actual submodule spanned by a subset
of an actual basis. Its lattice operations and its behavior under scalar
extension are proved directly; they are not assumptions in the definition.
-/

namespace FourPapers.Symmetric.Simultaneous

open Module

section Coordinates

variable {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]

def coordinateSpan (b : Basis ι R M) (s : Set ι) : Submodule R M :=
  Submodule.span R (b '' s)

theorem mem_coordinateSpan_iff (b : Basis ι R M) (s : Set ι) (x : M) :
    x ∈ coordinateSpan b s ↔ ∀ i, i ∉ s → b.repr x i = 0 := by
  classical
  rw [coordinateSpan, b.mem_span_image]
  constructor
  · intro h i hi
    by_contra hc
    exact hi (h (Finsupp.mem_support_iff.mpr hc))
  · intro h i hi
    by_contra his
    exact (Finsupp.mem_support_iff.mp hi) (h i his)

theorem coordinateSpan_union (b : Basis ι R M) (s t : Set ι) :
    coordinateSpan b (s ∪ t) = coordinateSpan b s ⊔ coordinateSpan b t := by
  rw [coordinateSpan, Set.image_union, Submodule.span_union]
  rfl

theorem coordinateSpan_inter (b : Basis ι R M) (s t : Set ι) :
    coordinateSpan b (s ∩ t) = coordinateSpan b s ⊓ coordinateSpan b t := by
  ext x
  simp only [Submodule.mem_inf, mem_coordinateSpan_iff]
  constructor
  · intro h
    exact ⟨fun i hi => h i (fun hit => hi hit.1),
      fun i hi => h i (fun hit => hi hit.2)⟩
  · rintro ⟨hs, ht⟩ i hi
    by_cases his : i ∈ s
    · exact ht i (fun hit => hi ⟨his, hit⟩)
    · exact hs i his

theorem mem_coordinateSpan_map_iff {M' : Type*} [AddCommGroup M'] [Module R M']
    (b : Basis ι R M) (e : M ≃ₗ[R] M') (s : Set ι) (x : M') :
    x ∈ coordinateSpan (b.map e) s ↔ e.symm x ∈ coordinateSpan b s := by
  rw [mem_coordinateSpan_iff, mem_coordinateSpan_iff]
  rfl

theorem coordinateSpan_inf_sup_distrib (b : Basis ι R M) (s t u : Set ι) :
    coordinateSpan b s ⊓ (coordinateSpan b t ⊔ coordinateSpan b u) =
      (coordinateSpan b s ⊓ coordinateSpan b t) ⊔
        (coordinateSpan b s ⊓ coordinateSpan b u) := by
  rw [← coordinateSpan_union, ← coordinateSpan_inter,
    ← coordinateSpan_inter, ← coordinateSpan_inter, ← coordinateSpan_union]
  congr 1
  ext i
  simp only [Set.mem_inter_iff, Set.mem_union, and_or_left]

theorem coordinateSpan_isCompl (b : Basis ι R M) (s : Set ι) :
    IsCompl (coordinateSpan b s) (coordinateSpan b sᶜ) :=
  b.linearIndependent.isCompl_span_image b.span_eq (isCompl_compl)

def coordinateSpanBasis (b : Basis ι R M) (s : Set ι) :
    Basis s R (coordinateSpan b s) := by
  let v : s → M := fun i => b i.val
  have hs : Submodule.span R (Set.range v) = coordinateSpan b s := by
    apply congrArg (Submodule.span R)
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.val, i.property, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  exact (Basis.span (b.linearIndependent.comp Subtype.val Subtype.val_injective)).map
    (LinearEquiv.ofEq _ _ hs)

/-- The complementary basis is a genuine basis of the quotient. -/
def coordinateQuotientBasis (b : Basis ι R M) (s : Set ι) :
    Basis ↥(sᶜ) R (M ⧸ coordinateSpan b s) :=
  (coordinateSpanBasis b sᶜ).map
    (Submodule.quotientEquivOfIsCompl _ _ (coordinateSpan_isCompl b s)).symm

theorem coordinateQuotient_free (b : Basis ι R M) (s : Set ι) :
    Module.Free R (M ⧸ coordinateSpan b s) :=
  Module.Free.of_basis (coordinateQuotientBasis b s)

theorem coordinateQuotient_flat (b : Basis ι R M) (s : Set ι) :
    Module.Flat R (M ⧸ coordinateSpan b s) := by
  letI := coordinateQuotient_free b s
  infer_instance

variable (S : Type*) [CommRing S] [Algebra R S]

/-- Scalar extension of a coordinate span has the same literal index set. -/
theorem coordinateSpan_baseChange (b : Basis ι R M) (s : Set ι) :
    (coordinateSpan b s).baseChange S = coordinateSpan (b.baseChange S) s := by
  rw [coordinateSpan, Submodule.baseChange_span, coordinateSpan, Set.image_image]
  apply congrArg (Submodule.span S)
  apply Set.image_congr
  intro i hi
  exact (Basis.baseChange_apply S b i).symm

theorem coordinateSpan_inf_baseChange (b : Basis ι R M) (s t : Set ι) :
    (coordinateSpan b s ⊓ coordinateSpan b t).baseChange S =
      (coordinateSpan b s).baseChange S ⊓ (coordinateSpan b t).baseChange S := by
  rw [← coordinateSpan_inter, coordinateSpan_baseChange,
    coordinateSpan_baseChange, coordinateSpan_baseChange, coordinateSpan_inter]

theorem coordinateSpan_sup_baseChange (b : Basis ι R M) (s t : Set ι) :
    (coordinateSpan b s ⊔ coordinateSpan b t).baseChange S =
      (coordinateSpan b s).baseChange S ⊔ (coordinateSpan b t).baseChange S := by
  rw [← coordinateSpan_union, coordinateSpan_baseChange,
    coordinateSpan_baseChange, coordinateSpan_baseChange, coordinateSpan_union]

end Coordinates

section Gluing

variable {R M ι κ : Type*} [CommRing R] [AddCommGroup M] [Module R M]
variable [Fintype ι]

/-- The coefficient-gluing step in Lemma 6.2. The family may be infinite:
only the already constructed lower basis needs to be finite. -/
theorem glue_normalized_lifts
    (N : Submodule R M) (b : Basis ι R N)
    (I : κ → Submodule R M) (E : κ → Set ι) (e : M) (T : Set κ)
    (hN : ∀ c (x : N), (x : M) ∈ I c ↔ x ∈ coordinateSpan b (E c))
    (g : T → M) (hg : ∀ c, g c ∈ I c.val)
    (hlower : ∀ c, g c - e ∈ N)
    (hpair : ∀ c d : T,
      (⟨g c - g d, by
        have h := N.sub_mem (hlower c) (hlower d)
        simpa only [sub_sub_sub_cancel_right] using h⟩ : N) ∈
          coordinateSpan b (E c.val ∪ E d.val)) :
    ∃ y : M, y - e ∈ N ∧ ∀ c ∈ T, y ∈ I c := by
  classical
  let δ : T → N := fun c => ⟨g c - e, hlower c⟩
  let a : ι → R := fun i => if h : ∃ c : T, i ∉ E c.val then
    b.repr (δ (Classical.choose h)) i else 0
  let v : N := b.repr.symm (Finsupp.equivFunOnFinite.symm a)
  have hcoeff (c : T) (i : ι) (hi : i ∉ E c.val) :
      b.repr v i = b.repr (δ c) i := by
    have hex : ∃ d : T, i ∉ E d.val := ⟨c, hi⟩
    let d : T := Classical.choose hex
    have hd : i ∉ E d.val := Classical.choose_spec hex
    have hp := (mem_coordinateSpan_iff b (E d.val ∪ E c.val)
      (δ d - δ c)).mp (by
        convert hpair d c using 1
        apply Subtype.ext
        exact sub_sub_sub_cancel_right _ _ _) i
      (fun h => h.elim hd hi)
    have he : b.repr (δ d) i = b.repr (δ c) i := by
      simpa only [map_sub, Finsupp.sub_apply, sub_eq_zero] using hp
    simpa only [v, LinearEquiv.apply_symm_apply, Finsupp.coe_equivFunOnFinite_symm,
      a, dif_pos hex] using he
  refine ⟨e + v, by simpa only [add_sub_cancel_left] using v.property, ?_⟩
  intro c hc
  let c' : T := ⟨c, hc⟩
  have hdiff : v - δ c' ∈ coordinateSpan b (E c) := by
    apply (mem_coordinateSpan_iff b (E c) _).mpr
    intro i hi
    simp only [map_sub, Finsupp.sub_apply, hcoeff c' i hi, sub_self]
  have hm := (hN c (v - δ c')).mpr hdiff
  have heq : e + (v : M) = (v : M) - (g c' - e) + g c' := by
    abel
  rw [heq]
  exact (I c).add_mem hm (hg c')

end Gluing

section Extension

variable {R M κ : Type*} [CommRing R] [AddCommGroup M] [Module R M]

def appendSet {n : ℕ} (s : Set (Fin n)) (p : Prop) : Set (Fin (n + 1)) :=
  fun i => Fin.lastCases p (fun j => j ∈ s) i

@[simp] theorem mem_appendSet_castSucc {n : ℕ} (s : Set (Fin n)) (p : Prop)
    (i : Fin n) : i.castSucc ∈ appendSet s p ↔ i ∈ s := by
  change Fin.lastCases p (fun j => j ∈ s) i.castSucc ↔ i ∈ s
  rw [Fin.lastCases_castSucc]

@[simp] theorem mem_appendSet_last {n : ℕ} (s : Set (Fin n)) (p : Prop) :
    Fin.last n ∈ appendSet s p ↔ p := by
  change Fin.lastCases p (fun j => j ∈ s) (Fin.last n) ↔ p
  rw [Fin.lastCases_last]

/-- Extend a simultaneous basis by one normalized coordinate. This is the
inductive step, including both basis independence and the exact spans of
all members of the family. -/
theorem extend_simultaneous_basis {n : ℕ}
    (l : M →ₗ[R] R) (e : M) (he : l e = 1)
    (b : Basis (Fin n) R (LinearMap.ker l))
    (I : κ → Submodule R M) (E : κ → Set (Fin n)) (T : Set κ)
    (hN : ∀ c (x : LinearMap.ker l), (x : M) ∈ I c ↔
      x ∈ coordinateSpan b (E c))
    (g : T → M) (hg : ∀ c, g c ∈ I c.val) (hgl : ∀ c, l (g c) = 1)
    (hpair : ∀ c d : T,
      (⟨g c - g d, by change l (g c - g d) = 0; simp only [map_sub, hgl, sub_self]⟩ :
        LinearMap.ker l) ∈ coordinateSpan b (E c.val ∪ E d.val))
    (hzero : ∀ c, c ∉ T → ∀ x ∈ I c, l x = 0) :
    ∃ b' : Basis (Fin (n + 1)) R M,
      (∀ i, b' i.castSucc = (b i : M)) ∧
      b' (Fin.last n) - e ∈ LinearMap.ker l ∧
      l (b' (Fin.last n)) = 1 ∧
      ∀ c, I c = coordinateSpan b' (appendSet (E c) (c ∈ T)) := by
  classical
  have hlower : ∀ c, g c - e ∈ LinearMap.ker l := by
    intro c
    simp only [LinearMap.mem_ker, map_sub, hgl, he, sub_self]
  obtain ⟨y, hylower, hy⟩ := glue_normalized_lifts (LinearMap.ker l) b
    I E e T hN g hg hlower hpair
  have hly : l y = 1 := by
    have h : l y - 1 = 0 := by
      simpa only [LinearMap.mem_ker, map_sub, he] using hylower
    exact sub_eq_zero.mp h
  have hli : ∀ c : R, ∀ x ∈ LinearMap.ker l, c • y + x = 0 → c = 0 := by
    intro c x hx h
    have h' := congrArg l h
    simpa only [map_add, map_smul, hly, LinearMap.mem_ker.mp hx,
      smul_eq_mul, mul_one, add_zero, map_zero] using h'
  have hsp : ∀ z : M, ∃ c : R, z + c • y ∈ LinearMap.ker l := by
    intro z
    refine ⟨-l z, ?_⟩
    simp only [LinearMap.mem_ker, map_add, map_smul, hly, smul_eq_mul,
      mul_one, add_neg_cancel]
  let b' := b.mkFinSnoc y hli hsp
  have hb_old (i : Fin n) : b' i.castSucc = (b i : M) := by
    simp only [b', Basis.coe_mkFinSnoc, Fin.snoc_castSucc, Function.comp_apply]
  have hb_last : b' (Fin.last n) = y := by
    simp only [b', Basis.coe_mkFinSnoc, Fin.snoc_last]
  refine ⟨b', hb_old, by simpa only [hb_last] using hylower,
    by simpa only [hb_last] using hly, ?_⟩
  intro c
  let S := coordinateSpan b' (appendSet (E c) (c ∈ T))
  have hold : coordinateSpan b (E c) ≤ S.comap (LinearMap.ker l).subtype := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    change (b i : M) ∈ S
    rw [← hb_old]
    exact Submodule.subset_span ⟨i.castSucc, (mem_appendSet_castSucc _ _ _).mpr hi, rfl⟩
  apply le_antisymm
  · intro x hx
    have hr : x - l x • y ∈ LinearMap.ker l := by
      simp only [LinearMap.mem_ker, map_sub, map_smul, hly,
        smul_eq_mul, mul_one, sub_self]
    have hrI : x - l x • y ∈ I c := by
      by_cases hc : c ∈ T
      · exact (I c).sub_mem hx ((I c).smul_mem _ (hy c hc))
      · simpa only [hzero c hc x hx, zero_smul, sub_zero] using hx
    have hrlow := (hN c ⟨x - l x • y, hr⟩).mp hrI
    have hrS : x - l x • y ∈ S := hold hrlow
    have hyS : l x • y ∈ S := by
      by_cases hc : c ∈ T
      · apply S.smul_mem
        rw [← hb_last]
        exact Submodule.subset_span ⟨Fin.last n, (mem_appendSet_last _ _).mpr hc, rfl⟩
      · simp only [hzero c hc x hx, zero_smul, Submodule.zero_mem]
    simpa only [sub_add_cancel] using S.add_mem hrS hyS
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    cases i using Fin.lastCases with
    | last =>
      rw [hb_last]
      exact hy c ((mem_appendSet_last _ _).mp hi)
    | cast i =>
      rw [hb_old]
      apply (hN c (b i)).mpr
      exact Submodule.subset_span ⟨i, (mem_appendSet_castSucc _ _ _).mp hi, rfl⟩

end Extension

section FiniteFlag

variable {R κ : Type*} [CommRing R]

def Below {n : ℕ} (k : ℕ) (x : Fin n → R) : Prop :=
  ∀ i, k ≤ i.val → x i = 0

/-- The finite-degree information supplied by homogeneous monic division.
The third condition is the bounded division statement for a pairwise sum. -/
structure MonicFlagFamily {n : ℕ}
    (I : κ → Submodule R (Fin n → R)) (E : κ → Set (Fin n)) : Prop where
  monic : ∀ c i, i ∈ E c → ∃ x ∈ I c, x i = 1 ∧ Below (i.val + 1) x
  zero_head : ∀ c i (x : Fin n → R), x ∈ I c → Below (i.val + 1) x →
    i ∉ E c → x i = 0
  split_sum : ∀ c d (x : Fin n → R), x ∈ I c ⊔ I d → ∀ k, k ≤ n → Below k x →
    ∃ a ∈ I c, ∃ b ∈ I d, Below k a ∧ Below k b ∧ a + b = x

def appendZero {n : ℕ} : (Fin n → R) →ₗ[R] (Fin (n + 1) → R) where
  toFun f := Fin.snoc f 0
  map_add' f g := by ext i; cases i using Fin.lastCases <;> simp
  map_smul' c f := by ext i; cases i using Fin.lastCases <;> simp

@[simp] theorem appendZero_castSucc {n : ℕ} (x : Fin n → R) (i : Fin n) :
    appendZero x i.castSucc = x i := by
  change Fin.snoc (α := fun _ : Fin (n + 1) => R) x 0 i.castSucc = x i
  exact Fin.snoc_castSucc (α := fun _ : Fin (n + 1) => R) 0 x i

@[simp] theorem appendZero_last {n : ℕ} (x : Fin n → R) :
    appendZero x (Fin.last n) = 0 := by
  change Fin.snoc (α := fun _ : Fin (n + 1) => R) x 0 (Fin.last n) = 0
  exact Fin.snoc_last (α := fun _ : Fin (n + 1) => R) 0 x

theorem appendZero_init {n : ℕ} (x : Fin (n + 1) → R) (hx : x (Fin.last n) = 0) :
    appendZero (fun i => x i.castSucc) = x := by
  ext i
  cases i using Fin.lastCases with
  | last => simpa only [appendZero_last] using hx.symm
  | cast i => exact appendZero_castSucc _ _

def lastCoordinate (n : ℕ) : (Fin (n + 1) → R) →ₗ[R] R :=
  LinearMap.proj (Fin.last n)

def appendZeroEquiv (n : ℕ) : (Fin n → R) ≃ₗ[R] LinearMap.ker (lastCoordinate (R := R) n) where
  toFun x := ⟨appendZero x, appendZero_last x⟩
  invFun x i := x.val i.castSucc
  map_add' x y := by apply Subtype.ext; exact appendZero.map_add x y
  map_smul' c x := by apply Subtype.ext; exact appendZero.map_smul c x
  left_inv x := by ext i; exact appendZero_castSucc x i
  right_inv x := by apply Subtype.ext; exact appendZero_init x.val x.property

theorem monicFlagFamily_init {n : ℕ}
    {I : κ → Submodule R (Fin (n + 1) → R)} {E : κ → Set (Fin (n + 1))}
    (h : MonicFlagFamily I E) :
    MonicFlagFamily (fun c => (I c).comap appendZero)
      (fun c => {i : Fin n | i.castSucc ∈ E c}) := by
  constructor
  · intro c i hi
    obtain ⟨x, hx, hxi, hxb⟩ := h.monic c i.castSucc hi
    have hlast : x (Fin.last n) = 0 := hxb _ (Nat.succ_le_of_lt i.isLt)
    refine ⟨fun j => x j.castSucc, ?_, hxi, ?_⟩
    · change appendZero (fun j => x j.castSucc) ∈ I c
      rwa [appendZero_init x hlast]
    · intro j hj
      exact hxb j.castSucc hj
  · intro c i x hx hxb hi
    have hb : Below (i.val + 1) (appendZero x) := by
      intro j hj
      cases j using Fin.lastCases with
      | last => exact appendZero_last x
      | cast j => simpa only [appendZero_castSucc] using hxb j hj
    simpa only [appendZero_castSucc] using h.zero_head c i.castSucc (appendZero x) hx hb hi
  · intro c d x hx k hk hxb
    have hx' : appendZero x ∈ I c ⊔ I d := by
      rcases Submodule.mem_sup.mp hx with ⟨a, ha, b, hb, he⟩
      exact Submodule.mem_sup.mpr ⟨appendZero a, ha, appendZero b, hb,
        by rw [← map_add, he]⟩
    have hxb' : Below k (appendZero x) := by
      intro i hi
      cases i using Fin.lastCases with
      | last => exact appendZero_last x
      | cast i => simpa only [appendZero_castSucc] using hxb i hi
    obtain ⟨a, ha, b, hb, hka, hkb, hab⟩ :=
      h.split_sum c d (appendZero x) hx' k (hk.trans (Nat.le_succ n)) hxb'
    have halast : a (Fin.last n) = 0 := hka _ hk
    have hblast : b (Fin.last n) = 0 := hkb _ hk
    refine ⟨fun i => a i.castSucc, ?_, fun i => b i.castSucc, ?_, ?_, ?_, ?_⟩
    · change appendZero (fun i => a i.castSucc) ∈ I c
      rwa [appendZero_init a halast]
    · change appendZero (fun i => b i.castSucc) ∈ I d
      rwa [appendZero_init b hblast]
    · intro i hi
      exact hka i.castSucc hi
    · intro i hi
      exact hkb i.castSucc hi
    · ext i
      simpa only [Pi.add_apply, appendZero_castSucc] using
        congrArg (fun v : Fin (n + 1) → R => v i.castSucc) hab

/-- The complete finite ordered linear-algebra induction underlying Lemma
6.2. No cardinality assumption is imposed on the family of submodules. -/
theorem exists_triangular_basis_of_monicFlagFamily :
    ∀ (n : ℕ) (I : κ → Submodule R (Fin n → R)) (E : κ → Set (Fin n)),
      MonicFlagFamily I E →
      ∃ b : Basis (Fin n) R (Fin n → R),
        (∀ i, b i i = 1 ∧ Below (i.val + 1) (b i)) ∧
        ∀ c, I c = coordinateSpan b (E c) := by
  intro n
  induction n with
  | zero =>
    intro I E h
    refine ⟨Pi.basisFun R (Fin 0), (fun i => Fin.elim0 i), ?_⟩
    intro c
    apply Subsingleton.elim
  | succ n ih =>
    intro I E h
    classical
    let I₀ : κ → Submodule R (Fin n → R) := fun c => (I c).comap appendZero
    let E₀ : κ → Set (Fin n) := fun c => {i | i.castSucc ∈ E c}
    obtain ⟨b₀, hb₀, hI₀⟩ := ih I₀ E₀ (monicFlagFamily_init h)
    let l := lastCoordinate (R := R) n
    let N := LinearMap.ker l
    let b : Basis (Fin n) R N := b₀.map (appendZeroEquiv n)
    let e : Fin (n + 1) → R := Pi.single (Fin.last n) 1
    have he : l e = 1 := by simp [l, lastCoordinate, e]
    let T : Set κ := {c | Fin.last n ∈ E c}
    have hex : ∀ c : T, ∃ x ∈ I c.val, l x = 1 := by
      intro c
      obtain ⟨x, hx, hxi, hxb⟩ := h.monic c.val (Fin.last n) c.property
      exact ⟨x, hx, hxi⟩
    choose g hg hgl using hex
    have hN : ∀ c (x : N), (x : Fin (n + 1) → R) ∈ I c ↔
        x ∈ coordinateSpan b (E₀ c) := by
      intro c x
      rw [show b = b₀.map (appendZeroEquiv n) from rfl,
        mem_coordinateSpan_map_iff, ← hI₀ c]
      change x.val ∈ I c ↔ appendZero (fun i => x.val i.castSucc) ∈ I c
      rw [appendZero_init x.val x.property]
    have hpair : ∀ c d : T,
        (⟨g c - g d, by change l (g c - g d) = 0; simp only [map_sub, hgl, sub_self]⟩ : N) ∈
          coordinateSpan b (E₀ c.val ∪ E₀ d.val) := by
      intro c d
      have hmem : g c - g d ∈ I c.val ⊔ I d.val := by
        exact Submodule.mem_sup.mpr ⟨g c, hg c, -g d, (I d.val).neg_mem (hg d),
          by rw [sub_eq_add_neg]⟩
      have hbound : Below n (g c - g d) := by
        intro i hi
        have hilast : i = Fin.last n := Fin.ext (by change i.val = n; omega)
        subst i
        change l (g c) - l (g d) = 0
        rw [hgl, hgl, sub_self]
      obtain ⟨a, ha, a', ha', hab, ha'b, haa'⟩ :=
        h.split_sum c.val d.val (g c - g d) hmem n (Nat.le_succ n) hbound
      have hak : a ∈ N := hab _ le_rfl
      have ha'k : a' ∈ N := ha'b _ le_rfl
      have haN := (hN c.val ⟨a, hak⟩).mp ha
      have ha'N := (hN d.val ⟨a', ha'k⟩).mp ha'
      rw [coordinateSpan_union]
      apply Submodule.mem_sup.mpr
      refine ⟨⟨a, hak⟩, haN, ⟨a', ha'k⟩, ha'N, ?_⟩
      apply Subtype.ext
      exact haa'
    have hzero : ∀ c, c ∉ T → ∀ x ∈ I c, l x = 0 := by
      intro c hc x hx
      exact h.zero_head c (Fin.last n) x hx (by intro i hi; change n + 1 ≤ i.val at hi; omega) hc
    obtain ⟨b', hold, hlastLower, hlast, hspans⟩ :=
      extend_simultaneous_basis l e he b I E₀ T hN g hg hgl hpair hzero
    refine ⟨b', ?_, ?_⟩
    · intro i
      cases i using Fin.lastCases with
      | last =>
        exact ⟨hlast, by intro j hj; change n + 1 ≤ j.val at hj; omega⟩
      | cast i =>
        rw [hold]
        change appendZero (b₀ i) i.castSucc = 1 ∧
          Below (i.val + 1) (appendZero (b₀ i))
        refine ⟨by simpa only [appendZero_castSucc] using (hb₀ i).1, ?_⟩
        intro j hj
        cases j using Fin.lastCases with
        | last => exact appendZero_last _
        | cast j => simpa only [appendZero_castSucc] using (hb₀ i).2 j hj
    · intro c
      rw [hspans c]
      apply congrArg (coordinateSpan b')
      ext i
      cases i using Fin.lastCases <;> simp [E₀, T]

end FiniteFlag

