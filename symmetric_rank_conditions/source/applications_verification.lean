  rw [triangular_basis_degree_repr m b hb p hp0]
  have hq0 : (AddMonoidAlgebra.ofCoeff (b.repr p) : MvPolynomial σ R) ≠ 0 := by
    intro h
    have hc : b.repr p = 0 := congrArg AddMonoidAlgebra.coeff h
    exact hp0 (b.repr.injective (by simpa only [map_zero] using hc))
  have hmem := m.degree_mem_support hq0
  by_contra hnot
  exact (Finsupp.mem_support_iff.mp hmem) ((mem_coordinateSpan_iff b s p).mp hp _ hnot)

/-- Every ideal adapted to a common triangular basis has the corresponding
subset of that basis as a monic Gröbner basis. -/
theorem triangular_ideal_groebner (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e)
    (I : Ideal (MvPolynomial σ R)) (s : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s) :
    m.IsGroebnerBasis (b '' s) I := by
  have hu : ∀ p ∈ b '' s, p ≠ 0 → IsUnit (m.leadingCoeff p) := by
    rintro _ ⟨e, he, rfl⟩ hp
    rw [triangular_basis_leadingCoeff m b hb]
    exact isUnit_one
  apply (MonomialOrder.isGroebnerBasis_iff_forall_exists_degree_le_degree hu).mpr
  refine ⟨?_, ?_⟩
  · rintro _ ⟨e, he, rfl⟩
    change b e ∈ I.restrictScalars R
    rw [hI]
    exact Submodule.subset_span ⟨e, he, rfl⟩
  · intro p hp hp0
    have hps : p ∈ coordinateSpan b s := by rwa [← hI]
    have hs := triangular_basis_degree_mem m b hb s p hps hp0
    refine ⟨b (m.degree p), ⟨m.degree p, hs, rfl⟩, ?_, ?_⟩
    · intro h
      have he := (hb (m.degree p)).1
      rw [h, MvPolynomial.coeff_zero] at he
      exact zero_ne_one he
    · rw [triangular_basis_degree m b hb]

theorem triangular_ideal_initial (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e)
    (I : Ideal (MvPolynomial σ R)) (s : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s) :
    orderInitialIdeal m I = Ideal.span ((fun e => monomial e (1 : R)) '' s) := by
  rw [orderInitialIdeal, (triangular_ideal_groebner m b hb I s hI).span_leadingTerm_image,
    Set.image_image]
  congr 1
  apply Set.image_congr
  intro e he
  simp only [MonomialOrder.leadingTerm, triangular_basis_degree m b hb,
    triangular_basis_leadingCoeff m b hb]

theorem triangular_ideals_initial_sup (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e)
    (I J : Ideal (MvPolynomial σ R)) (s t : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s)
    (hJ : J.restrictScalars R = coordinateSpan b t) :
    orderInitialIdeal m (I ⊔ J) = orderInitialIdeal m I ⊔ orderInitialIdeal m J := by
  have hIJ : (I ⊔ J).restrictScalars R = coordinateSpan b (s ∪ t) := by
    rw [coordinateSpan_union, ← hI, ← hJ]
    exact Submodule.restrictScalars_sup R I J
  rw [triangular_ideal_initial m b hb (I ⊔ J) (s ∪ t) hIJ,
    triangular_ideal_initial m b hb I s hI, triangular_ideal_initial m b hb J t hJ,
    Set.image_union, Ideal.span_union]

theorem triangular_ideals_initial_inf (m : MonomialOrder σ)
    (b : Basis (σ →₀ ℕ) R (MvPolynomial σ R))
    (hb : ∀ e, (b e).coeff e = 1 ∧ m.toSyn (m.degree (b e)) ≤ m.toSyn e)
    (I J : Ideal (MvPolynomial σ R)) (s t : Set (σ →₀ ℕ))
    (hI : I.restrictScalars R = coordinateSpan b s)
    (hJ : J.restrictScalars R = coordinateSpan b t) :
    orderInitialIdeal m (I ⊓ J) = orderInitialIdeal m I ⊓ orderInitialIdeal m J := by
  have hIJ : (I ⊔ J).restrictScalars R = coordinateSpan b (s ∪ t) := by
    rw [coordinateSpan_union, ← hI, ← hJ]
    exact Submodule.restrictScalars_sup R I J
  have hG := triangular_ideal_groebner m b hb I s hI
  have hH := triangular_ideal_groebner m b hb J t hJ
  have hGH := triangular_ideal_groebner m b hb (I ⊔ J) (s ∪ t) hIJ
  rw [Set.image_union] at hGH
  apply initial_inf_of_union_groebner m I J (b '' s) (b '' t) hG hH ?_ ?_ hGH
  · rintro _ ⟨e, he, rfl⟩ hp
    rw [triangular_basis_leadingCoeff m b hb]
    exact isUnit_one
  · rintro _ ⟨e, he, rfl⟩ hp
    rw [triangular_basis_leadingCoeff m b hb]
    exact isUnit_one

end FourPapers.Symmetric.Simultaneous

