set_option maxHeartbeats 1600000
set_option maxRecDepth 4000

namespace FourPapers.Symmetric
open TauCeti HigherSpecht

/-- The second unrestricted paired Knuth relation. Together with the first, this
is the three-external-partner critical case of matching dual equivalence. -/
theorem paired_knuth_right (k : ℕ) :
    ∀ rows : List (List ℕ), (∀ row ∈ rows, row.SortedLE) →
      (∀ x ∈ rows.flatten, x < k) →
      ∀ a b c : ℕ, a ≤ b → b < c → c < k →
        dualRows k (pairedTriple k a c b rows) = pairedTriple k c a b rows := by
  intro rows
  induction rows with
  | nil =>
    intro hrows hmax a b c hab hbc hc
    have h := paired_knuth_right_empty_row [] hab hbc hc hmax
    simpa only [pairedTriple_eq,pairInsert_nil,
      pairInsert_cons_of_none [] (by rfl : (rowBump a ([] : List ℕ)).2 = none),
      pairInsert_cons_of_none [] (by rfl : (rowBump c ([] : List ℕ)).2 = none),
      rowBump_nil,List.singleton_append] using h
  | cons row rows ih =>
    intro hrows hmax a b c hab hbc hc
    have ht : ∀ row ∈ rows, row.SortedLE := fun row hr => hrows row (by simp [hr])
    have hm : ∀ x ∈ rows.flatten, x < k :=
      fun x hx => hmax x (List.mem_append_right _ hx)
    have hr : row.SortedLE := hrows row (by simp)
    have hl : ∀ x ∈ row, x < k := fun x hx => hmax x (List.mem_append_left _ hx)
    have hb : b < k := hbc.trans hc
    have ha : a < k := hab.trans_lt hb
    have hac : a < c := hab.trans_lt hbc
    clear hrows hmax
    revert hr hl
    induction row with
    | nil =>
      intro hr hl
      exact paired_knuth_right_empty_row rows hab hbc hc hm
    | cons p row ihr =>
      intro hr hl
      obtain ⟨hprow,hs⟩ := List.sortedLE_cons.mp hr
      have hlr : ∀ x ∈ row, x < k := fun x hx => hl x (by simp [hx])
      have hp : p < k := hl p (by simp)
      by_cases hpa : p ≤ a
      · rw [pairedTriple_prependFirst _ _ _ _ _ _ _ hpa (hpa.trans hac.le)
          (hpa.trans hab),pairedTriple_prependFirst _ _ _ _ _ _ _
          (hpa.trans hac.le) hpa (hpa.trans hab),dualRows_prependFirst hp]
        exact congrArg (prependFirst p) (ihr hs hlr)
      have hap : a < p := lt_of_not_ge hpa
      by_cases hpc : p ≤ c
      · obtain ⟨q,hbump,hqc⟩ := exists_rowBump_snd_eq_some_le_of_lt hbc row
        let R := (rowBump c row).1
        let S := (rowBump b R).1
        have hR : ∀ x ∈ R, x < k := rowBump_fst_lt hc hlr
        have hS : ∀ x ∈ S, x < k := rowBump_fst_lt hb hR
        have hpq : p ≤ q := rowBump_fst_lowerBound hprow hpc q
          (mem_of_rowBump_snd_eq_some hbump)
        have hq : q < k := hqc.trans_lt hc
        cases hcbump : (rowBump c row).2 with
        | none =>
          have hb1 := rowBump_append_of_snd_eq_some hbump [k+1]
          have hb0 := rowBump_append_of_snd_eq_some hbump [k]
          have hy : firstRowProcess [(a,k),(c,k+1),(b,k+2)] (p::row) =
              ((a::S)++[k+1],[(p,k),(q,k+2)]) := by
            simp only [S,R,firstRowProcess,rowBump_cons_of_lt _ hap,
              rowBump_cons_of_le _ hac.le,hcbump,List.cons_append,
              rowBump_cons_of_le _ hab,hb1]
          have hz : firstRowProcess [(c,k),(a,k+1),(b,k+2)] (p::row) =
              ((a::S)++[k],[(p,k+1),(q,k+2)]) := by
            simp only [S,R,firstRowProcess,rowBump_cons_of_le _ hpc,hcbump,
              List.cons_append,rowBump_cons_of_lt _ hap,
              rowBump_cons_of_le _ hab,hb0]
          rw [pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hy,
            pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hz]
          have htop : ∀ x ∈ a::S, x < k := by
            intro x hx
            exact (List.mem_cons.mp hx).elim (fun h => h ▸ ha) (hS x)
          have hD := dualRows_two_largest_top ht hp hq hm (a::S) htop
            (0:Fin 3) 2 1 1 (by decide) (by simp [hpq,dualSelector])
          simpa [pairInsertList_cons,pairInsertList_nil,dualLetter,
            Equiv.swap_apply_def,Nat.add_assoc] using hD
        | some r =>
          have hqr : q < r := hqc.trans_lt (lt_of_rowBump_snd_eq_some hcbump)
          have hrk : r < k := hlr r (mem_of_rowBump_snd_eq_some hcbump)
          have hy : firstRowProcess [(a,k),(c,k+1),(b,k+2)] (p::row) =
              (a::S,[(p,k),(r,k+1),(q,k+2)]) := by
            simp only [S,R,firstRowProcess,rowBump_cons_of_lt _ hap,
              rowBump_cons_of_le _ hac.le,hcbump,
              rowBump_cons_of_le _ hab,hbump]
          have hz : firstRowProcess [(c,k),(a,k+1),(b,k+2)] (p::row) =
              (a::S,[(r,k),(p,k+1),(q,k+2)]) := by
            simp only [S,R,firstRowProcess,rowBump_cons_of_le _ hpc,hcbump,
              rowBump_cons_of_lt _ hap,rowBump_cons_of_le _ hab,hbump]
          rw [pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hy,
            pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hz]
          rw [dualRows_cons_low _ _ (by
            intro x hx
            exact (List.mem_cons.mp hx).elim (fun h => h ▸ ha) (hS x))]
          exact congrArg (List.cons (a::S)) (ih ht hm p q r hpq hqr hrk)
      · have hcp : c < p := lt_of_not_ge hpc
        have hbp : b < p := hbc.trans hcp
        cases row with
        | nil =>
          have hy : firstRowProcess [(a,k),(c,k+1),(b,k+2)] [p] =
              ([a,b,k+1],[(p,k),(c,k+2)]) := by
            simp [firstRowProcess,rowBump,hap,hac,hbc,hc,hb,
              not_lt_of_ge hac.le,not_lt_of_ge hab]
          have hz : firstRowProcess [(c,k),(a,k+1),(b,k+2)] [p] =
              ([a,b,k+2],[(p,k),(c,k+1)]) := by
            simp [firstRowProcess,rowBump,hcp,hac,hbc,hc,hb,
              not_lt_of_ge hac.le,not_lt_of_ge hab]
          rw [pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hy,
            pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hz]
          have htop : ∀ x ∈ [a,b], x < k := by
            intro x hx
            simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
            rcases hx with rfl | rfl
            · exact ha
            · exact hb
          have hD := dualRows_two_largest_top ht hp hc hm [a,b] htop
            (0:Fin 3) 2 1 2 (by decide) (by simp [not_le.mpr hcp,dualSelector])
          simpa [pairInsertList_cons,pairInsertList_nil,dualLetter,
            Equiv.swap_apply_def,Nat.add_assoc] using hD
        | cons q row =>
          have hpq : p ≤ q := hprow q (by simp)
          have hcq : c < q := hcp.trans_le hpq
          have hbq : b < q := hbc.trans hcq
          have hq : q < k := hlr q (by simp)
          have hy : firstRowProcess [(a,k),(c,k+1),(b,k+2)] (p::q::row) =
              (a::b::row,[(p,k),(q,k+1),(c,k+2)]) := by
            simp only [firstRowProcess,rowBump_cons_of_lt _ hap,
              rowBump_cons_of_le _ hac.le,rowBump_cons_of_lt _ hcq,
              rowBump_cons_of_le _ hab,rowBump_cons_of_lt _ hbc]
          have hz : firstRowProcess [(c,k),(a,k+1),(b,k+2)] (p::q::row) =
              (a::b::row,[(p,k),(c,k+1),(q,k+2)]) := by
            simp only [firstRowProcess,rowBump_cons_of_lt _ hcp,
              rowBump_cons_of_lt _ hac,rowBump_cons_of_le _ hab,
              rowBump_cons_of_lt _ hbq]
          rw [pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hy,
            pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hz]
          rw [dualRows_cons_low _ _ (by
            intro x hx
            simp only [List.mem_cons] at hx
            rcases hx with rfl | rfl | hx
            · exact ha
            · exact hb
            · exact hlr x (by simp [hx]))]
          apply congrArg (List.cons (a::b::row))
          have hleft := paired_knuth_left k rows ht hm c p q hcp hpq hq
          change dualRows k (pairedTriple k p q c rows) = pairedTriple k p c q rows
          rw [←hleft,dualRows_involutive]

end FourPapers.Symmetric

