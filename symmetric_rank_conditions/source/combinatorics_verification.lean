    simp only [appendToRow_zero_cons,rowWordRows_cons,tripleFootprint_append,
      hr,ht,List.nil_append]
    simp only [tripleFootprint,List.filterMap_cons,List.filterMap_nil,tripleTag_label,
      List.singleton_append]

