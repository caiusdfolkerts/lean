    (ha : a < k) (hrows : ∀ x ∈ rows.flatten, x < k) (s : Fin 3) :
    (rowInsert a rows).map (List.map (dualLetter k s)) = rowInsert a rows := by
  calc
    (rowInsert a rows).map (List.map (dualLetter k s)) = (rowInsert a rows).map id := by
