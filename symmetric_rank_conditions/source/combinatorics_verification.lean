def pairedTriple (k a b c : ℕ) (rows : List (List ℕ)) : List (List ℕ) :=
  pairInsertList [(a,k),(b,k+1),(c,k+2)] rows

theorem pairedTriple_eq (k a b c : ℕ) (rows : List (List ℕ)) :
    pairedTriple k a b c rows = pairInsert c (k+2) (pairInsert b (k+1) (pairInsert a k rows)) := rfl

def prependFirst (p : ℕ) : List (List ℕ) → List (List ℕ)
  | [] => [[p]]
  | row::rows => (p::row)::rows

theorem dualRows_prependFirst {k p : ℕ} (hp : p < k) (rows : List (List ℕ)) :
    dualRows k (prependFirst p rows) = prependFirst p (dualRows k rows) := by
  have hp' := tripleTag_eq_none_of_lt hp
  cases rows with
  | nil => simp [prependFirst,dualRows,rowWordRows,tripleFootprint,hp',dualSelector,dualLetter]
  | cons row rows =>
    have hf : tripleFootprint k (p::row) = tripleFootprint k row := by
      simp [tripleFootprint,hp']
    simp only [prependFirst,dualRows,rowWordRows_cons,tripleFootprint_append,hf,
      List.map_cons,dualLetter_eq_self_of_none _ hp']

theorem pairInsertList_prependFirst (pairs : List (ℕ × ℕ)) (p : ℕ)
    (row : List ℕ) (rows : List (List ℕ)) (hp : ∀ q ∈ pairs, p ≤ q.1) :
    pairInsertList pairs ((p::row)::rows) =
      prependFirst p (pairInsertList pairs (row::rows)) := by
  rw [pairInsertList_firstRowProcess,pairInsertList_firstRowProcess]
  have h := firstRowProcess_passed_prefix pairs [p] row (by
    intro q hq z hz
    have hz' : z = p := List.mem_singleton.mp hz
    subst z
    exact hp q hq)
  simpa only [List.singleton_append,prependFirst] using
    congrArg (fun x : List ℕ × List (ℕ × ℕ) => x.1 :: pairInsertList x.2 rows) h

theorem pairedTriple_prependFirst (k a b c p : ℕ) (row : List ℕ)
    (rows : List (List ℕ)) (ha : p ≤ a) (hb : p ≤ b) (hc : p ≤ c) :
    pairedTriple k a b c ((p::row)::rows) =
      prependFirst p (pairedTriple k a b c (row::rows)) := by
  apply pairInsertList_prependFirst
  intro q hq
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
  rcases hq with rfl | rfl | rfl
  · exact ha
  · exact hb
  · exact hc

