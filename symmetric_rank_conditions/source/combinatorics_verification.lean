theorem pair_sublist_append {α : Type*} (a b : α) (l r : List α) :
    [a,b].Sublist (l++r) ↔
      [a,b].Sublist l ∨ (a ∈ l ∧ b ∈ r) ∨ [a,b].Sublist r := by
  constructor
  · intro h
    obtain ⟨u,v,heq,hu,hv⟩ := List.sublist_append_iff.mp h
    cases u with
    | nil =>
      have heq' : [a,b] = v := by simpa only [List.nil_append] using heq
      exact Or.inr (Or.inr (heq'.symm ▸ hv))
    | cons x u =>
      cases u with
      | nil =>
        have heq' : a = x ∧ [b] = v := by simpa only [List.cons_append,List.nil_append,List.cons.injEq] using heq
        rcases heq' with ⟨rfl,rfl⟩
        exact Or.inr (Or.inl ⟨List.singleton_sublist.mp hu,List.singleton_sublist.mp hv⟩)
      | cons y u =>
        have heq' : a = x ∧ b = y ∧ [] = u++v := by
          simpa only [List.cons_append,List.cons.injEq] using heq
        obtain ⟨rfl,rfl,huv⟩ := heq'
        obtain ⟨rfl,rfl⟩ := List.append_eq_nil_iff.mp huv.symm
        exact Or.inl hu
  · rintro (h | ⟨ha,hb⟩ | h)
    · simpa using h.append (List.nil_sublist r)
    · exact (List.singleton_sublist.mpr ha).append (List.singleton_sublist.mpr hb)
    · simpa using (List.nil_sublist l).append h

theorem rowDescends_iff_reading_pair {x y : ℕ} (hxy : x < y)
    (rows : List (List ℕ)) (hrows : ∀ row ∈ rows, row.SortedLE)
    (hn : rows.flatten.Nodup) :
    RowDescends x y rows ↔ [y,x].Sublist (rowWordRows rows) := by
  induction rows with
  | nil => simp [rowWordRows,RowDescends]
  | cons row rows ih =>
    have hr := hrows row (by simp)
    have ht : ∀ r ∈ rows, r.SortedLE := fun r h => hrows r (by simp [h])
    have hnt := (List.nodup_append.mp hn).2.1
    have hdis := (List.nodup_append.mp hn).2.2
    have hbad : ¬[y,x].Sublist row := by
      intro h
      have hyx : y ≤ x := List.pairwise_pair.mp (hr.pairwise.sublist h)
      exact (not_le_of_gt hxy) hyx
    have hno : RowDescends x y rows → x ∉ row ∧ y ∉ row := by
      intro h
      exact ⟨fun hx => hdis x hx x h.mem_left rfl,
        fun hy => hdis y hy y h.mem_right rfl⟩
    simp only [rowDescends_cons,rowWordRows_cons,pair_sublist_append,
      hbad,or_false,←ih ht hnt,mem_rowWordRows_iff]
    tauto

theorem dualSelector_zero_iff_pair_orders :
    ∀ i : Fin 16, (shortTripleWord i).Perm [0,1,2] →
      (dualSelector (shortTripleWord i) = 0 ↔
        ([1,0].Sublist (shortTripleWord i) ↔ [2,1].Sublist (shortTripleWord i))) := by
  decide +kernel

theorem dualRows_eq_self_of_descents_equal {k : ℕ} {rows : List (List ℕ)}
    (hrows : rows.IsTableauRows) (hn : rows.flatten.Nodup)
    (hm : ∀ d : Fin 3, k+d.val ∈ rowWordRows rows)
    (hd : RowDescends k (k+1) rows ↔ RowDescends (k+1) (k+2) rows) :
    dualRows k rows = rows := by
  have h10 : ([1,0] : List (Fin 3)).Sublist (tripleFootprint k (rowWordRows rows)) ↔
      RowDescends k (k+1) rows := by
    rw [rowDescends_iff_reading_pair (by omega) rows hrows.sortedLE hn]
    constructor
    · intro h
      simpa only [Fin.val_zero,Fin.val_one,Nat.add_zero] using tripleFootprint_pair_lift h
    · intro h
      simpa [tripleFootprint,tripleTag] using h.filterMap (tripleTag k)
  have h21 : ([2,1] : List (Fin 3)).Sublist (tripleFootprint k (rowWordRows rows)) ↔
      RowDescends (k+1) (k+2) rows := by
    rw [rowDescends_iff_reading_pair (by omega) rows hrows.sortedLE hn]
    constructor
    · intro h
      simpa only [Fin.val_one,Fin.val_two] using tripleFootprint_pair_lift h
    · intro h
      simpa [tripleFootprint,tripleTag,Nat.add_assoc] using h.filterMap (tripleTag k)
  obtain ⟨i,hi⟩ := exists_shortTripleWord (tripleFootprint k (rowWordRows rows))
    (tripleFootprint_nodup ((rowWordRows_nodup_iff rows).mpr hn))
  have hp := tripleFootprint_perm ((rowWordRows_nodup_iff rows).mpr hn) hm
  have hsel : dualSelector (tripleFootprint k (rowWordRows rows)) = 0 := by
    rw [←hi] at hp ⊢
    apply (dualSelector_zero_iff_pair_orders i hp).mpr
    rw [hi]
    exact h10.trans (hd.trans h21.symm)
  simp [dualRows,hsel,dualLetter]

theorem matching_dual_fixed_of_partner_comparisons {k p q r : ℕ}
    {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    (hp : Partners w k p) (hq : Partners w (k+1) q) (hr : Partners w (k+2) r)
    (hcmp : (q < p ∧ p ≠ k+1) ↔ (r < q ∧ q ≠ k+2)) :
    dualRows k (pairInsertList w) = pairInsertList w := by
  apply dualRows_eq_self_of_descents_equal hw.isTableauRows hw.output_distinct
  · intro d
    rw [mem_rowWordRows_iff,(flatten_pairInsertList_perm w []).mem_iff]
    simp only [List.flatten_nil,List.append_nil]
    fin_cases d
    · simpa using hp.mem_left
    · simpa using hq.mem_left
    · simpa only [Fin.val_two] using hr.mem_left
  · rw [hw.descent hp hq]
    have h := hw.descent hq hr
    simpa only [Nat.add_assoc] using hcmp.trans h.symm

theorem tripleFootprint_pair_sublist_iff (k : ℕ) (w : List ℕ) (a b : Fin 3) :
    [a,b].Sublist (tripleFootprint k w) ↔
      [k+a.val,k+b.val].Sublist w := by
  constructor
  · exact tripleFootprint_pair_lift
  · intro h
    have ha := (tripleTag_eq_some_iff k (k+a.val) a).mpr rfl
    have hb := (tripleTag_eq_some_iff k (k+b.val) b).mpr rfl
    simpa only [tripleFootprint,List.filterMap_cons,List.filterMap_nil,ha,hb] using
      h.filterMap (tripleTag k)

theorem dualSelector_swaps_pair_orders :
    ∀ i : Fin 16, (shortTripleWord i).Perm [0,1,2] →
      (([1,0] : List (Fin 3)).Sublist
          ((shortTripleWord i).map (dualTag (dualSelector (shortTripleWord i)))) ↔
        [2,1].Sublist (shortTripleWord i)) ∧
      (([2,1] : List (Fin 3)).Sublist
          ((shortTripleWord i).map (dualTag (dualSelector (shortTripleWord i)))) ↔
        [1,0].Sublist (shortTripleWord i)) := by
  decide +kernel

/-- Elementary dual equivalence exchanges the two adjacent descent bits. -/
theorem dualRows_exchanges_descents {k : ℕ} {rows : List (List ℕ)}
    (hrows : rows.IsTableauRows) (hn : rows.flatten.Nodup)
    (hm : ∀ d : Fin 3, k+d.val ∈ rowWordRows rows) :
    (RowDescends k (k+1) (dualRows k rows) ↔ RowDescends (k+1) (k+2) rows) ∧
    (RowDescends (k+1) (k+2) (dualRows k rows) ↔ RowDescends k (k+1) rows) := by
  have ht := dualRows_isTableau hrows hn hm
  have hnd : (dualRows k rows).flatten.Nodup := by
    simpa only [dualRows,←List.map_flatten] using
      hn.map (dualLetter k (dualSelector (tripleFootprint k (rowWordRows rows)))).injective
  rw [rowDescends_iff_reading_pair (by omega) _ ht.sortedLE hnd,
    rowDescends_iff_reading_pair (by omega) _ hrows.sortedLE hn,
    rowDescends_iff_reading_pair (by omega) _ ht.sortedLE hnd,
    rowDescends_iff_reading_pair (by omega) _ hrows.sortedLE hn,
    rowWordRows_dualRows]
  have hp10 := tripleFootprint_pair_sublist_iff k (dualWord k (rowWordRows rows)) 1 0
  have hp21 := tripleFootprint_pair_sublist_iff k (dualWord k (rowWordRows rows)) 2 1
  have ho10 := tripleFootprint_pair_sublist_iff k (rowWordRows rows) 1 0
  have ho21 := tripleFootprint_pair_sublist_iff k (rowWordRows rows) 2 1
  simp only [Fin.val_zero,Fin.val_one,Fin.val_two,Nat.add_zero] at hp10 hp21 ho10 ho21
  rw [←hp10,←hp21,←ho10,←ho21]
  simp only [dualWord,tripleFootprint_map_dualLetter]
  have hnword := (rowWordRows_nodup_iff rows).mpr hn
  obtain ⟨i,hi⟩ := exists_shortTripleWord (tripleFootprint k (rowWordRows rows))
    (tripleFootprint_nodup hnword)
  have hp := tripleFootprint_perm hnword hm
  rw [←hi] at hp ⊢
  exact dualSelector_swaps_pair_orders i hp

end FourPapers.Symmetric
