  have hbf : b ∉ endpointWord v := by
    intro h
    exact hw.last_fresh.2 ((hc.endpoint b).mp (by simpa only [hfb] using h))
  have hbound : ∀ p ∈ v, p.2 < b := by
    intro p hp
    have hpv : p.2 ∈ endpointWord v := mem_endpointWord.mpr ⟨p,hp,Or.inr rfl⟩
    have hpo : dualLetter k s p.2 ∈ endpointWord w :=
      (hc.endpoint (dualLetter k s p.2)).mp (by
        simpa only [dualLetter_involutive k s p.2] using hpv)
    have hl := dualLetter_lt_bound s (hw.before_last _ hpo) hbig
    simpa only [dualLetter_involutive k s p.2] using hl
  constructor
  · intro p hp
    rcases List.mem_append.mp hp with hp | hp
    · exact hv.lower_lt_upper p hp
    · have heq := List.mem_singleton.mp hp
      simpa [heq] using hab
  · refine List.pairwise_append.mpr ⟨hv.ordered,by simp,?_⟩
    intro p hp q hq
    have heq := List.mem_singleton.mp hq
    simpa [heq] using hbound p hp
  · rw [endpointWord_append]
    apply List.nodup_append.mpr
    refine ⟨hv.distinct,by simp [endpointWord,hab.ne],?_⟩
    intro x hx y hy hxy
    simp only [endpointWord,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil,
      List.mem_cons,List.not_mem_nil,or_false] at hy
    rcases hy with rfl | rfl
    · exact haf (hxy ▸ hx)
    · exact hbf (hxy ▸ hx)

/-- The form of the local matching statement needed for induction.  It asserts
an actual adjacent conjugation, with a valid output matching word. -/
def AdjacentDualPreimage (k : ℕ) (w : List (ℕ × ℕ)) : Prop :=
  ∃ (s : Fin 3) (v : List (ℕ × ℕ)), MatchingWord v ∧
    ConjugatesPartners (dualLetter k s) w v ∧
    pairInsertList v = dualRows k (pairInsertList w)

theorem adjacentDualPreimage_last_lower {k b : ℕ} (d : Fin 3)
    (w : List (ℕ × ℕ)) (hw : MatchingWord (w++[(k+d.val,b)]))
    (hm : ∀ e : Fin 3, k+e.val ∈ endpointWord w ++ [k+d.val])
    (hbout : tripleTag k b = none) :
    AdjacentDualPreimage k (w++[(k+d.val,b)]) := by
  let s := dualSelector (tripleFootprint k (rowWordRows (pairInsertList w) ++ [k+d.val]))
  let f := dualLetter k s
  obtain ⟨hv,heq⟩ := matching_last_label_dual_move d w hw hm hbout
  refine ⟨s,relabelPairs f w ++ [(f (k+d.val),b)],hv,?_,heq⟩
  have hfb : f b = b := dualLetter_eq_self_of_none s hbout
  have h := conjugatesPartners_relabel f (w++[(k+d.val,b)])
  simpa only [relabelPairs,List.map_append,List.map_cons,List.map_nil,hfb] using h

theorem AdjacentDualPreimage.append_outside {k a b : ℕ}
    {w : List (ℕ × ℕ)} (h : AdjacentDualPreimage k w)
    (hw : MatchingWord (w++[(a,b)]))
    (hm : ∀ d : Fin 3, k+d.val ∈ endpointWord w)
    (ha : tripleTag k a = none) (hb : tripleTag k b = none) :
    AdjacentDualPreimage k (w++[(a,b)]) := by
  obtain ⟨s,v,hv,hc,heq⟩ := h
  have htwo : k+2 ∈ endpointWord w := by simpa using hm 2
  have hv' := hw.append_conjugate_prefix hv hc htwo ha hb
  refine ⟨s,v++[(a,b)],hv',hc.append_fixed
    (dualLetter_eq_self_of_none s ha) (dualLetter_eq_self_of_none s hb),?_⟩
  have hmatch : MatchingWord w := hw.prefix
  have haf : a ∉ (pairInsertList w).flatten := by
    intro hx
    apply hw.last_fresh.1
    simpa only [List.flatten_nil,List.append_nil] using
      (flatten_pairInsertList_perm w []).mem_iff.mp hx
  have hmem : ∀ d : Fin 3, k+d.val ∈ rowWordRows (pairInsertList w) := by
    intro d
    rw [mem_rowWordRows_pairInsertList]
    exact hm d
  rw [pairInsertList_append_singleton,pairInsertList_append_singleton,heq]
  exact dualRows_pairInsert hmatch.isTableauRows hmatch.output_distinct haf hmem ha hb

theorem adjacentDualPreimage_fixed {k p q r : ℕ}
    {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    (hp : Partners w k p) (hq : Partners w (k+1) q) (hr : Partners w (k+2) r)
    (hcmp : (q < p ∧ p ≠ k+1) ↔ (r < q ∧ q ≠ k+2)) :
    AdjacentDualPreimage k w := by
  refine ⟨0,w,hw,?_,(matching_dual_fixed_of_partner_comparisons hw hp hq hr hcmp).symm⟩
  simpa only [dualLetter,show (0:Fin 3) ≠ 1 from by decide,
    show (0:Fin 3) ≠ 2 from by decide,ite_false] using conjugatesPartners_refl w

def upperTriple (k p q r : ℕ) : List (ℕ × ℕ) :=
  [(p,k),(q,k+1),(r,k+2)]

def exchangedUpperTriple (k : ℕ) (s : Fin 3) (p q r : ℕ) : List (ℕ × ℕ) :=
  if s = 1 then upperTriple k q p r
  else if s = 2 then upperTriple k p r q else upperTriple k p q r

theorem relabelPairs_low {k : ℕ} (s : Fin 3) (u : List (ℕ × ℕ))
    (hu : ∀ x ∈ endpointWord u, x < k) :
    relabelPairs (dualLetter k s) u = u := by
  calc
    relabelPairs (dualLetter k s) u = u.map id := by
      apply List.map_congr_left
      intro p hp
      exact Prod.ext
        (dualLetter_eq_self_of_none s (tripleTag_eq_none_of_lt
          (hu p.1 (mem_endpointWord.mpr ⟨p,hp,Or.inl rfl⟩))))
        (dualLetter_eq_self_of_none s (tripleTag_eq_none_of_lt
          (hu p.2 (mem_endpointWord.mpr ⟨p,hp,Or.inr rfl⟩))))
    _ = u := List.map_id _

theorem exchangedUpperTriple_perm_relabel {k p q r : ℕ} (s : Fin 3)
    (u : List (ℕ × ℕ)) (hu : ∀ x ∈ endpointWord u, x < k)
    (hp : p < k) (hq : q < k) (hr : r < k) :
    (u++exchangedUpperTriple k s p q r).Perm
      (relabelPairs (dualLetter k s) (u++upperTriple k p q r)) := by
  have hfu := relabelPairs_low s u hu
  have hfp := dualLetter_eq_self_of_none s (tripleTag_eq_none_of_lt hp)
  have hfq := dualLetter_eq_self_of_none s (tripleTag_eq_none_of_lt hq)
  have hfr := dualLetter_eq_self_of_none s (tripleTag_eq_none_of_lt hr)
  rw [relabelPairs_append]
  rw [hfu]
  apply List.Perm.append_left
  simp only [relabelPairs,upperTriple,List.map_cons,List.map_nil,hfp,hfq,hfr]
  fin_cases s
  · simp [exchangedUpperTriple,upperTriple,dualLetter]
  · simpa [exchangedUpperTriple,upperTriple,dualLetter,Equiv.swap_apply_def] using
      (List.Perm.swap (q,k) (p,k+1) [(r,k+2)]).symm
  · simpa [exchangedUpperTriple,upperTriple,dualLetter,Equiv.swap_apply_def] using
      (List.Perm.cons (p,k) (List.Perm.swap (r,k+1) (q,k+2) [])).symm

theorem matching_exchangedUpperTriple {k p q r : ℕ} (s : Fin 3)
    (u : List (ℕ × ℕ)) (hw : MatchingWord (u++upperTriple k p q r))
    (hu : ∀ x ∈ endpointWord u, x < k)
    (hp : p < k) (hq : q < k) (hr : r < k) :
    MatchingWord (u++exchangedUpperTriple k s p q r) ∧
      ConjugatesPartners (dualLetter k s) (u++upperTriple k p q r)
        (u++exchangedUpperTriple k s p q r) := by
  have hperm := exchangedUpperTriple_perm_relabel s u hu hp hq hr
  have hprefix : MatchingWord u := hw.prefix
  constructor
  · apply hw.of_relabel_perm hperm
    · intro e he
      rcases List.mem_append.mp he with he | he
      · exact hprefix.lower_lt_upper e he
      · unfold exchangedUpperTriple at he
        split_ifs at he <;>
          simp only [upperTriple,List.mem_cons,List.not_mem_nil,or_false] at he <;>
          rcases he with rfl | rfl | rfl <;> dsimp <;> omega
    · refine List.pairwise_append.mpr ⟨hprefix.ordered,?_,?_⟩
      · fin_cases s <;> simp [exchangedUpperTriple,upperTriple]
      · intro e he d hd
        have h := hu e.2 (mem_endpointWord.mpr ⟨e,he,Or.inr rfl⟩)
        unfold exchangedUpperTriple at hd
        split_ifs at hd <;>
          simp only [upperTriple,List.mem_cons,List.not_mem_nil,or_false] at hd <;>
          rcases hd with rfl | rfl | rfl <;> dsimp <;> omega
  · exact (conjugatesPartners_relabel _ _).of_perm hperm

theorem pairInsertList_upperTriple (u : List (ℕ × ℕ)) (k p q r : ℕ) :
    pairInsertList (u++upperTriple k p q r) = pairedTriple k p q r (pairInsertList u) := by
  rw [pairInsertList_append]
  rfl

/-- The three distinguished labels enter consecutively as upper endpoints.
The six strict orders of their external partners are handled by the two
unbounded paired Knuth identities and the genuine descent criterion. -/
theorem adjacentDualPreimage_three_upper {k p q r : ℕ}
    (u : List (ℕ × ℕ)) (hw : MatchingWord (u++upperTriple k p q r))
    (hu : ∀ x ∈ endpointWord u, x < k)
    (hp : p < k) (hq : q < k) (hr : r < k) :
    AdjacentDualPreimage k (u++upperTriple k p q r) := by
  have hprefix : MatchingWord u := hw.prefix
  have hrows := hprefix.isTableauRows.sortedLE
  have hmax : ∀ x ∈ (pairInsertList u).flatten, x < k := by
    intro x hx
    apply hu x
    simpa only [List.flatten_nil,List.append_nil] using
      (flatten_pairInsertList_perm u []).mem_iff.mp hx
  have hpk : Partners (u++upperTriple k p q r) k p :=
    Or.inr (List.mem_append_right _ (by simp [upperTriple]))
  have hqk : Partners (u++upperTriple k p q r) (k+1) q :=
    Or.inr (List.mem_append_right _ (by simp [upperTriple]))
  have hrk : Partners (u++upperTriple k p q r) (k+2) r :=
    Or.inr (List.mem_append_right _ (by simp [upperTriple]))
  have hpq : p ≠ q := by
    intro h
    subst q
    have hh := hw.partner_unique hpk.symm hqk.symm
    omega
  have hpr : p ≠ r := by
    intro h
    subst r
    have hh := hw.partner_unique hpk.symm hrk.symm
    omega
  have hqr : q ≠ r := by
    intro h
    subst r
    have hh := hw.partner_unique hqk.symm hrk.symm
    omega
  have finish (s : Fin 3)
      (hD : dualRows k (pairInsertList (u++upperTriple k p q r)) =
        pairInsertList (u++exchangedUpperTriple k s p q r)) :
      AdjacentDualPreimage k (u++upperTriple k p q r) := by
    obtain ⟨hv,hc⟩ := matching_exchangedUpperTriple s u hw hu hp hq hr
    exact ⟨s,u++exchangedUpperTriple k s p q r,hv,hc,hD.symm⟩
  by_cases hpqlt : p < q
  · by_cases hqrlt : q < r
    · exact adjacentDualPreimage_fixed hw hpk hqk hrk (by omega)
    · have hrq : r < q := by omega
      by_cases hprlt : p < r
      · apply finish 1
        simp only [exchangedUpperTriple,ite_true,pairInsertList_upperTriple]
        exact paired_knuth_right k (pairInsertList u) hrows hmax p r q
          hprlt.le hrq hq
      · have hrp : r < p := by omega
        apply finish 2
        simp only [exchangedUpperTriple,show (2:Fin 3) ≠ 1 from by decide,
          ite_false,ite_true,pairInsertList_upperTriple]
        have h := paired_knuth_left k (pairInsertList u) hrows hmax r p q hrp hpqlt.le hq
        rw [←h,dualRows_involutive]
  · have hqp : q < p := by omega
    by_cases hprlt : p < r
    · apply finish 2
      simp only [exchangedUpperTriple,show (2:Fin 3) ≠ 1 from by decide,
        ite_false,ite_true,pairInsertList_upperTriple]
      exact paired_knuth_left k (pairInsertList u) hrows hmax q p r hqp hprlt.le hr
    · have hrp : r < p := by omega
      by_cases hqrlt : q < r
      · apply finish 1
        simp only [exchangedUpperTriple,ite_true,pairInsertList_upperTriple]
        have h := paired_knuth_right k (pairInsertList u) hrows hmax q r p hqrlt.le hrp hp
        rw [←h,dualRows_involutive]
      · exact adjacentDualPreimage_fixed hw hpk hqk hrk (by omega)

theorem MatchingWord.two_from_relabel {f : ℕ ≃ ℕ}
    {old u : List (ℕ × ℕ)} {a b c d : ℕ}
    (hw : MatchingWord old) (hu : MatchingWord u)
    (hperm : (u++[(a,b),(c,d)]).Perm (relabelPairs f old))
    (hab : a < b) (hcd : c < d) (hbd : b < d)
    (hmax : ∀ x ∈ endpointWord u, x < b) :
    MatchingWord (u++[(a,b),(c,d)]) := by
  apply hw.of_relabel_perm hperm
  · intro p hp
    rcases List.mem_append.mp hp with hp | hp
    · exact hu.lower_lt_upper p hp
    · simp only [List.mem_cons,List.not_mem_nil,or_false] at hp
      rcases hp with rfl | rfl
      · exact hab
      · exact hcd
  · refine List.pairwise_append.mpr ⟨hu.ordered,by simpa using hbd,?_⟩
    intro p hp q hq
    have h := hmax p.2 (mem_endpointWord.mpr ⟨p,hp,Or.inr rfl⟩)
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hq
    rcases hq with rfl | rfl
    · exact h
    · exact h.trans hbd

theorem adjacentDualPreimage_internal_cross {k c : ℕ}
    (u : List (ℕ × ℕ))
    (hw : MatchingWord (u++[(c,k+1),(k,k+2)]))
    (hu : ∀ x ∈ endpointWord u, x < k) (hc : c < k) :
    AdjacentDualPreimage k (u++[(c,k+1),(k,k+2)]) := by
  have hfu := relabelPairs_low (2:Fin 3) u hu
  have hfc := dualLetter_eq_self_of_none (2:Fin 3) (tripleTag_eq_none_of_lt hc)
  have hperm : (u++[(k,k+1),(c,k+2)]).Perm
      (relabelPairs (dualLetter k 2) (u++[(c,k+1),(k,k+2)])) := by
    rw [relabelPairs_append]
    rw [hfu]
    apply List.Perm.append_left
    simp only [relabelPairs,List.map_cons,List.map_nil,hfc]
    simpa [dualLetter,Equiv.swap_apply_def] using
      (List.Perm.swap (k,k+1) (c,k+2) []).symm
  have hv := hw.two_from_relabel hw.prefix hperm (by omega) (by omega) (by omega)
    (fun x hx => (hu x hx).trans (by omega))
  refine ⟨2,u++[(k,k+1),(c,k+2)],hv,
    (conjugatesPartners_relabel _ _).of_perm hperm,?_⟩
  have hmax : ∀ x ∈ (pairInsertList u).flatten, x < k := by
    intro x hx
    apply hu x
    simpa only [List.flatten_nil,List.append_nil] using
      (flatten_pairInsertList_perm u []).mem_iff.mp hx
  simp only [pairInsertList_append,pairInsertList_cons,pairInsertList_nil]
  exact (paired_internal_dual hc hmax).symm

theorem adjacentDualPreimage_internal_adjacent {k c : ℕ}
    (u : List (ℕ × ℕ))
    (hw : MatchingWord (u++[(k,k+1),(c,k+2)]))
    (hu : ∀ x ∈ endpointWord u, x < k) (hc : c < k) :
    AdjacentDualPreimage k (u++[(k,k+1),(c,k+2)]) := by
  have hfu := relabelPairs_low (2:Fin 3) u hu
  have hfc := dualLetter_eq_self_of_none (2:Fin 3) (tripleTag_eq_none_of_lt hc)
  have hperm : (u++[(c,k+1),(k,k+2)]).Perm
      (relabelPairs (dualLetter k 2) (u++[(k,k+1),(c,k+2)])) := by
    rw [relabelPairs_append]
    rw [hfu]
    apply List.Perm.append_left
    simp only [relabelPairs,List.map_cons,List.map_nil,hfc]
    simpa [dualLetter,Equiv.swap_apply_def] using
      (List.Perm.swap (c,k+1) (k,k+2) []).symm
  have hv := hw.two_from_relabel hw.prefix hperm (by omega) (by omega) (by omega)
    (fun x hx => (hu x hx).trans (by omega))
  refine ⟨2,u++[(c,k+1),(k,k+2)],hv,
    (conjugatesPartners_relabel _ _).of_perm hperm,?_⟩
  have hmax : ∀ x ∈ (pairInsertList u).flatten, x < k := by
    intro x hx
    apply hu x
    simpa only [List.flatten_nil,List.append_nil] using
      (flatten_pairInsertList_perm u []).mem_iff.mp hx
  simp only [pairInsertList_append,pairInsertList_cons,pairInsertList_nil]
  exact (paired_internal_dual_reverse hc hmax).symm

theorem adjacentDualPreimage_internal_fixed {k c : ℕ}
    (u : List (ℕ × ℕ))
    (hw : MatchingWord (u++[(c,k),(k+1,k+2)])) (hc : c < k) :
    AdjacentDualPreimage k (u++[(c,k),(k+1,k+2)]) := by
  apply adjacentDualPreimage_fixed (p := c) (q := k+2) (r := k+1) hw
    (Or.inr (List.mem_append_right _ (by simp)))
    (Or.inl (List.mem_append_right _ (by simp)))
    (Or.inr (List.mem_append_right _ (by simp)))
  omega

theorem label_ne_of_tripleTag_none {k x : ℕ} (hx : tripleTag k x = none)
    (d : Fin 3) : k+d.val ≠ x := by
  intro h
  rw [←h,tripleTag_label] at hx
  cases hx

theorem MatchingWord.le_last {a b : ℕ} {w : List (ℕ × ℕ)}
    (hw : MatchingWord (w++[(a,b)])) :
    ∀ x ∈ endpointWord (w++[(a,b)]), x ≤ b := by
  have hab : a < b := hw.lower_lt_upper (a,b) (by simp)
  intro x hx
  rw [endpointWord_append] at hx
  rcases List.mem_append.mp hx with hx | hx
  · exact (hw.before_last x hx).le
  · simp only [endpointWord,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,List.append_nil,
      List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl | rfl
    · exact hab.le
    · exact le_rfl

/-- Every matching dual move is realized by an adjacent conjugation of the
actual matching.  This is an unrestricted induction on the edge word. -/
theorem matching_adjacent_dual_preimage (k : ℕ) :
    ∀ w : List (ℕ × ℕ), MatchingWord w →
      (∀ d : Fin 3, k+d.val ∈ endpointWord w) → AdjacentDualPreimage k w := by
  intro w
  induction w using List.reverseRecOn with
  | nil =>
    intro hw hm
    have h := hm 0
    simp [endpointWord] at h
  | append_singleton w edge ih =>
    rcases edge with ⟨a,b⟩
    intro hw hm
    have hpre : MatchingWord w := hw.prefix
    have hab : a < b := hw.lower_lt_upper (a,b) (by simp)
    have hbmax : k+2 ≤ b := hw.le_last _ (by simpa using hm 2)
    have hmem (d : Fin 3) : k+d.val ∈ endpointWord w ∨ k+d.val = a ∨ k+d.val = b := by
      simpa only [endpointWord_append,endpointWord,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,
        List.append_nil,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] using hm d
    by_cases hb : b = k+2
    · subst b
      by_cases ha1 : a = k+1
      · subst a
        have hk : k ∈ endpointWord w := by
          have h := hmem 0
          simpa only [Fin.val_zero,Nat.add_zero,show k ≠ k+1 from by omega,
            show k ≠ k+2 from by omega,or_false] using h
        obtain ⟨c,hc⟩ := (mem_endpointWord_iff_exists_partner w k).mp hk
        have hmax : ∀ x ∈ endpointWord w, x ≤ k := by
          intro x hx
          have hxlt := hw.before_last x hx
          have hxne : x ≠ k+1 := fun h => hw.last_fresh.1 (h ▸ hx)
          omega
        obtain ⟨u,rfl⟩ := hpre.eq_append_of_max hc hmax
        have hck : c < k := hpre.lower_lt_upper (c,k) (by simp)
        simpa only [List.append_assoc,List.singleton_append,List.cons_append,List.nil_append] using
          adjacentDualPreimage_internal_fixed u
            (by simpa only [List.append_assoc,List.singleton_append,List.cons_append,List.nil_append] using hw) hck
      · by_cases ha0 : a = k
        · subst a
          have hk1 : k+1 ∈ endpointWord w := by
            have h := hmem 1
            simpa only [Fin.val_one,show k+1 ≠ k from by omega,
              show k+1 ≠ k+2 from by omega,or_false] using h
          obtain ⟨c,hc⟩ := (mem_endpointWord_iff_exists_partner w (k+1)).mp hk1
          have hmax : ∀ x ∈ endpointWord w, x ≤ k+1 := by
            intro x hx
            have := hw.before_last x hx
            omega
          obtain ⟨u,rfl⟩ := hpre.eq_append_of_max hc hmax
          have hck1 : c < k+1 := hpre.lower_lt_upper (c,k+1) (by simp)
          have hck : c < k := by
            have hcne : c ≠ k := fun h => hw.last_fresh.1 (h ▸ hc.mem_right)
            omega
          have hu : ∀ x ∈ endpointWord u, x < k := by
            intro x hx
            have hxl := hpre.before_last x hx
            have hxne : x ≠ k := by
              intro h
              apply hw.last_fresh.1
              rw [endpointWord_append]
              exact List.mem_append_left _ (h ▸ hx)
            omega
          simpa only [List.append_assoc,List.singleton_append,List.cons_append,List.nil_append] using
            adjacentDualPreimage_internal_cross u
              (by simpa only [List.append_assoc,List.singleton_append,List.cons_append,List.nil_append] using hw) hu hck
        · have hak : a < k := by omega
          have hk1 : k+1 ∈ endpointWord w := by
            have h := hmem 1
            simpa only [Fin.val_one,show k+1 ≠ a from by omega,
              show k+1 ≠ k+2 from by omega,or_false] using h
          obtain ⟨c,hc⟩ := (mem_endpointWord_iff_exists_partner w (k+1)).mp hk1
          have hmax : ∀ x ∈ endpointWord w, x ≤ k+1 := by
            intro x hx
            have := hw.before_last x hx
            omega
          obtain ⟨u,rfl⟩ := hpre.eq_append_of_max hc hmax
          have hck1 : c < k+1 := hpre.lower_lt_upper (c,k+1) (by simp)
          by_cases hck : c = k
          · subst c
            have hu : ∀ x ∈ endpointWord u, x < k := by
              intro x hx
              have hxl := hpre.before_last x hx
              have hxne : x ≠ k := fun h => hpre.last_fresh.1 (h ▸ hx)
              omega
            simpa only [List.append_assoc,List.singleton_append,List.cons_append,List.nil_append] using
              adjacentDualPreimage_internal_adjacent u
