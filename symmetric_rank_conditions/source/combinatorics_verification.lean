theorem pairInsert_above {a b : ℕ} {rows : List (List ℕ)}
    (h : ∀ x ∈ rows.headD [], x ≤ a) :
    pairInsert a b rows = appendToRow b 0 (appendToRow a 0 rows) := by
  unfold pairInsert
  rw [rowInsert_of_forall_le h,rowInsertIndex_of_forall_le h]

theorem pairInsert_high {k : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ x ∈ rows.flatten, x < k) (i j : Fin 3) :
    pairInsert (k+i.val) (k+j.val) rows =
      appendToRow (k+j.val) 0 (appendToRow (k+i.val) 0 rows) := by
  apply pairInsert_above
  intro x hx
  have hx' : x ∈ rows.flatten := by
    cases rows with
    | nil => simp at hx
    | cons row rows => exact List.mem_flatten.mpr ⟨row,by simp,hx⟩
  exact (hrows x hx').le.trans (Nat.le_add_right _ _)

theorem map_dualLetter_low_rows {k : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ x ∈ rows.flatten, x < k) (s : Fin 3) :
    rows.map (List.map (dualLetter k s)) = rows := by
  calc
    rows.map (List.map (dualLetter k s)) = rows.map id := by
      apply List.map_congr_left
      intro row hr
      apply map_dualLetter_eq_self
      apply tripleFootprint_eq_nil_of_forall_lt
      intro x hx
      exact hrows x (List.mem_flatten.mpr ⟨row,hr,hx⟩)
    _ = rows := List.map_id _

theorem tripleFootprint_pairInsert_two_high {k : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ x ∈ rows.flatten, x < k) (i j : Fin 3) :
    tripleFootprint k (rowWordRows (pairInsert (k+i.val) (k+j.val) rows)) = [i,j] := by
  rw [pairInsert_high hrows]
  cases rows with
  | nil =>
    simp only [appendToRow_nil,appendToRow_zero_cons,rowWordRows_cons,rowWordRows_nil,
      List.nil_append,List.singleton_append,tripleFootprint,List.filterMap_cons,List.filterMap_nil,
      tripleTag_label]
  | cons row rows =>
    have hr : tripleFootprint k row = [] :=
      tripleFootprint_eq_nil_of_forall_lt (fun x hx => hrows x (by simp [hx]))
