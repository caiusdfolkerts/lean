def dualTag (s : Fin 3) : Fin 3 ≃ Fin 3 :=
  if s = 1 then Equiv.swap 0 1
  else if s = 2 then Equiv.swap 1 2 else Equiv.refl _

theorem dualLetter_label (k : ℕ) (s d : Fin 3) :
    dualLetter k s (k+d.val) = k+(dualTag s d).val := by
  fin_cases s <;> fin_cases d <;>
    simp [dualLetter,dualTag,Equiv.swap_apply_def,Fin.val_two,Nat.add_assoc]

theorem tripleTag_dualLetter (k x : ℕ) (s : Fin 3) :
    tripleTag k (dualLetter k s x) = (tripleTag k x).map (dualTag s) := by
  cases h : tripleTag k x with
  | none => simp only [dualLetter_eq_self_of_none s h,h,Option.map_none]
  | some d =>
    have hx := (tripleTag_eq_some_iff k x d).mp h
    rw [hx,dualLetter_label]
    simp only [(tripleTag_eq_some_iff k (k+(dualTag s d).val) (dualTag s d)).mpr rfl,
      (tripleTag_eq_some_iff k (k+d.val) d).mpr rfl,Option.map_some]

theorem tripleFootprint_map_dualLetter (k : ℕ) (s : Fin 3) (w : List ℕ) :
    tripleFootprint k (w.map (dualLetter k s)) =
      (tripleFootprint k w).map (dualTag s) := by
  simp only [tripleFootprint,List.filterMap_map,List.map_filterMap]
  apply List.filterMap_congr
  intro x hx
  exact tripleTag_dualLetter k x s

theorem dualSelector_map_dualTag (w : List (Fin 3)) :
    dualSelector (w.map (dualTag (dualSelector w))) = dualSelector w := by
  by_cases h1 : dualSelector w = 1
  · rcases (dualSelector_eq_one_iff w).mp h1 with rfl | rfl <;>
      decide
  by_cases h2 : dualSelector w = 2
  · rcases (dualSelector_eq_two_iff w).mp h2 with rfl | rfl <;>
      decide
  have h0 : dualSelector w = 0 := by
    have h := (dualSelector w).isLt
    have hn1 : (dualSelector w).val ≠ 1 := fun h => h1 (Fin.ext h)
    have hn2 : (dualSelector w).val ≠ 2 := fun h => h2 (Fin.ext h)
    apply Fin.ext
    omega
  rw [h0]
  simpa [dualTag] using h0

theorem dualLetter_involutive (k : ℕ) (s : Fin 3) :
    Function.Involutive (dualLetter k s) := by
  intro x
  unfold dualLetter
  split_ifs <;> simp

theorem dualWord_involutive (k : ℕ) : Function.Involutive (dualWord k) := by
  intro w
  unfold dualWord
  rw [tripleFootprint_map_dualLetter,dualSelector_map_dualTag]
  exact (dualLetter_involutive k _).list_map w

theorem dualRows_involutive (k : ℕ) : Function.Involutive (dualRows k) := by
  intro rows
  unfold dualRows
  have hmap (f : ℕ → ℕ) (r : List (List ℕ)) :
      rowWordRows (r.map (List.map f)) = (rowWordRows r).map f := by
    simp only [rowWordRows,List.map_reverse,List.map_flatten]
  rw [hmap,tripleFootprint_map_dualLetter,dualSelector_map_dualTag]
  exact (dualLetter_involutive k _).list_map.list_map rows

end FourPapers.Symmetric

