set_option autoImplicit false
set_option maxHeartbeats 1200000
set_option maxRecDepth 4000

namespace FourPapers.Symmetric
open TauCeti HigherSpecht

theorem tripleFootprint_knuth_step_missing (left : Bool) (k a b c : ℕ)
    (l r : List ℕ) (d : Fin 3) (hab : a < b) (hbc : b < c)
    (hm : k+d.val ∉ l ++ knuthBefore left a b c ++ r) :
    tripleFootprint k (l ++ knuthBefore left a b c ++ r) =
      tripleFootprint k (l ++ knuthAfter left a b c ++ r) := by
  by_cases ha : tripleTag k a = none
  · cases left <;>
      simp [knuthBefore,knuthAfter,tripleFootprint,List.filterMap_append,List.filterMap_cons,ha]
  by_cases hc : tripleTag k c = none
  · cases left <;>
      simp [knuthBefore,knuthAfter,tripleFootprint,List.filterMap_append,List.filterMap_cons,hc]
  obtain ⟨i,hi⟩ := Option.ne_none_iff_exists'.mp ha
  obtain ⟨j,hj⟩ := Option.ne_none_iff_exists'.mp hc
  have hi' := (tripleTag_eq_some_iff k a i).mp hi
  have hj' := (tripleTag_eq_some_iff k c j).mp hj
  have hib := i.isLt
  have hjb := j.isLt
  have hak : a = k := by omega
  have hbk : b = k+1 := by omega
  have hck : c = k+2 := by omega
  exfalso
  rw [hak,hbk,hck] at hm
  apply hm
  fin_cases d <;> cases left <;>
    simp [knuthBefore,Fin.val_two]

theorem tripleFootprint_knuthEquivalent_missing_context {k : ℕ} {d : Fin 3}
    {u v : List ℕ} (h : KnuthEquivalent u v) :
    ∀ l r : List ℕ, (l ++ u ++ r).Nodup →
      k+d.val ∉ l ++ u ++ r →
      tripleFootprint k (l ++ u ++ r) = tripleFootprint k (l ++ v ++ r) := by
  induction h with
  | refl u => intro l r hn hm; rfl
  | @symm u v h ih =>
    intro l r hn hm
    have hp := ((knuthEquivalent_perm h).append_left l).append_right r
    exact (ih l r (hp.symm.nodup hn) (fun hx => hm (hp.mem_iff.mp hx))).symm
  | @trans u v w h g ih ih' =>
    intro l r hn hm
    have hp := ((knuthEquivalent_perm h).append_left l).append_right r
    exact (ih l r hn hm).trans
      (ih' l r (hp.nodup hn) (fun hx => hm (hp.mem_iff.mpr hx)))
  | @append u v p q h ih =>
    intro l r hn hm
    have hn' : ((l ++ p) ++ u ++ (q ++ r)).Nodup := by
      simpa only [List.append_assoc] using hn
    have hm' : k+d.val ∉ (l ++ p) ++ u ++ (q ++ r) := by
      simpa only [List.append_assoc] using hm
    simpa only [List.append_assoc] using ih (l ++ p) (q ++ r) hn' hm'
  | @left a b c hab hbc =>
    intro l r hn hm
    have hn' := (List.nodup_append.mp (List.nodup_append.mp hn).1).2.1
    have hne : b ≠ c := by
      intro heq
      exact (List.nodup_cons.mp hn').1 (by simp [heq])
    exact tripleFootprint_knuth_step_missing true k a b c l r d hab
      (lt_of_le_of_ne hbc hne) hm
  | @right a b c hab hbc =>
    intro l r hn hm
    have hn' := (List.nodup_append.mp (List.nodup_append.mp hn).1).2.1
    have hne : a ≠ b := by
      intro heq
      exact (List.nodup_cons.mp hn').1 (by simp [heq])
    exact tripleFootprint_knuth_step_missing false k a b c l r d
