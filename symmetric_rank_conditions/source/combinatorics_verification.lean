theorem monomialSymbolic_shape {n : ℕ} (m : MatchingEntry n →₀ ℕ)
    (t s : ℕ) (ht : 0 < t) :
    (∃ (k : ℕ) (sizes : Fin k → ℕ) (a b : ∀ c, Fin (sizes c) ↪o Fin n),
