namespace FourPapers.Symmetric
open TauCeti HigherSpecht

variable {μ : YoungDiagram}

/-- The natural-number row representation of a standard tableau. Its labels are
the original labels `0,...,μ.card-1`, not newly chosen ranks. -/
def tableauNatRows (T : StandardYoungTableau μ) : List (List ℕ) :=
  T.toRows.map (List.map Fin.val)

theorem tableauNatRows_map {T U : StandardYoungTableau μ} {f : ℕ → ℕ}
    (h : ∀ c : ↥μ.cells, (U c).val = f (T c).val) :
    tableauNatRows U = (tableauNatRows T).map (List.map f) := by
  simp only [tableauNatRows, StandardYoungTableau.toRows_def, List.map_ofFn,
    List.map_map, Function.comp_def]
  congr 1
  funext i
  congr 1
  funext j
  exact h _

theorem rowWordRows_tableauNatRows (T : StandardYoungTableau μ) :
    rowWordRows (tableauNatRows T) = tableauValueWord T :=
  (tableauValueWord_eq_rows T).symm

theorem mem_rowWordRows_tableauNatRows (T : StandardYoungTableau μ)
    {x : ℕ} (hx : x < μ.card) : x ∈ rowWordRows (tableauNatRows T) := by
  rw [rowWordRows_tableauNatRows]
  exact mem_tableauValueWord T ⟨x,hx⟩

theorem tripleFootprint_pair_of_sublist {k : ℕ} {w : List ℕ} {d e : Fin 3}
    (h : [k + d.val,k + e.val].Sublist w) :
    [d,e].Sublist (tripleFootprint k w) := by
  simpa only [tripleFootprint, List.filterMap_cons, List.filterMap_nil,
    tripleTag_label] using h.filterMap (tripleTag k)

theorem dualSelector_one_of_between {w : List (Fin 3)} (hn : w.Nodup)
    (h : ([0,2].Sublist w ∧ [2,1].Sublist w) ∨
      ([1,2].Sublist w ∧ [2,0].Sublist w)) : dualSelector w = 1 := by
  have hf : ∀ i : Fin 16,
      (([0,2].Sublist (shortTripleWord i) ∧ [2,1].Sublist (shortTripleWord i)) ∨
       ([1,2].Sublist (shortTripleWord i) ∧ [2,0].Sublist (shortTripleWord i))) →
      dualSelector (shortTripleWord i) = 1 := by decide
  obtain ⟨i,hi⟩ := exists_shortTripleWord w hn
  simpa only [hi] using hf i (hi.symm ▸ h)

theorem dualSelector_two_of_between {w : List (Fin 3)} (hn : w.Nodup)
    (h : ([1,0].Sublist w ∧ [0,2].Sublist w) ∨
      ([2,0].Sublist w ∧ [0,1].Sublist w)) : dualSelector w = 2 := by
  have hf : ∀ i : Fin 16,
      (([1,0].Sublist (shortTripleWord i) ∧ [0,2].Sublist (shortTripleWord i)) ∨
       ([2,0].Sublist (shortTripleWord i) ∧ [0,1].Sublist (shortTripleWord i))) →
      dualSelector (shortTripleWord i) = 2 := by decide
  obtain ⟨i,hi⟩ := exists_shortTripleWord w hn
  simpa only [hi] using hf i (hi.symm ▸ h)

theorem tripleFootprint_pair_of_cells (T : StandardYoungTableau μ)
    {k : ℕ} {d e : Fin 3} (c t : ↥μ.cells)
    (hc : (T c).val = k + d.val) (ht : (T t).val = k + e.val)
    (h : RowReadBefore c.val t.val) :
    [d,e].Sublist (tripleFootprint k (tableauValueWord T)) := by
  apply tripleFootprint_pair_of_sublist
  simpa only [hc,ht] using (tableauValueWord_pair_iff_cells T c t).mpr h

theorem selector_one_of_cell_between (T : StandardYoungTableau μ)
    {k : ℕ} (a b e : ↥μ.cells)
    (ha : (T a).val = k) (hb : (T b).val = k + 1) (he : (T e).val = k + 2)
    (h : RowReadBetween a.val e.val b.val) :
    dualSelector (tripleFootprint k (tableauValueWord T)) = 1 := by
  apply dualSelector_one_of_between (tripleFootprint_nodup (tableauValueWord_nodup T))
  have ha' : (T a).val = k + (0 : Fin 3).val := by simpa using ha
  have hb' : (T b).val = k + (1 : Fin 3).val := by simpa using hb
  have he' : (T e).val = k + (2 : Fin 3).val := by simpa using he
  rcases h with h | h
  · exact Or.inl ⟨tripleFootprint_pair_of_cells T a e ha' he' h.1,
      tripleFootprint_pair_of_cells T e b he' hb' h.2⟩
  · exact Or.inr ⟨tripleFootprint_pair_of_cells T b e hb' he' h.1,
      tripleFootprint_pair_of_cells T e a he' ha' h.2⟩

theorem selector_two_of_cell_between (T : StandardYoungTableau μ)
    {k : ℕ} (a b e : ↥μ.cells)
    (ha : (T a).val = k + 1) (hb : (T b).val = k + 2) (he : (T e).val = k)
    (h : RowReadBetween a.val e.val b.val) :
    dualSelector (tripleFootprint k (tableauValueWord T)) = 2 := by
  apply dualSelector_two_of_between (tripleFootprint_nodup (tableauValueWord_nodup T))
  have ha' : (T a).val = k + (1 : Fin 3).val := by simpa using ha
  have hb' : (T b).val = k + (2 : Fin 3).val := by simpa using hb
  have he' : (T e).val = k + (0 : Fin 3).val := by simpa using he
  rcases h with h | h
  · exact Or.inl ⟨tripleFootprint_pair_of_cells T a e ha' he' h.1,
      tripleFootprint_pair_of_cells T e b he' hb' h.2⟩
  · exact Or.inr ⟨tripleFootprint_pair_of_cells T b e hb' he' h.1,
      tripleFootprint_pair_of_cells T e a he' ha' h.2⟩

/-- The geometric dual move used in the connectivity theorem is exactly the
row operation used in the matching median theorem. This closes the interface
between the two independently formalized descriptions of dual equivalence. -/
theorem dualMove_exists_dualRows_of_bounds {T U : StandardYoungTableau μ}
    {a b e : ℕ × ℕ} (ha : a ∈ μ) (hb : b ∈ μ) (he : e ∈ μ)
    (hab : tableauEntry T a + 1 = tableauEntry T b)
    (hadj : tableauEntry T e + 1 = tableauEntry T a ∨
      tableauEntry T b + 1 = tableauEntry T e)
    (hbetween : RowReadBetween a e b)
    (hswap : ∀ x ∈ μ, tableauEntry U x =
      if x = a then tableauEntry T b else if x = b then tableauEntry T a
      else tableauEntry T x)
    {q : ℕ} (hqa : tableauEntry T a < q) (hqb : tableauEntry T b < q)
    (hqe : tableauEntry T e < q) :
    ∃ k : ℕ, k + 2 < q ∧ tableauNatRows U = dualRows k (tableauNatRows T) := by
  let A : ↥μ.cells := ⟨a,ha⟩
  let B : ↥μ.cells := ⟨b,hb⟩
  let E : ↥μ.cells := ⟨e,he⟩
  have hA : (T A).val = tableauEntry T a := (tableauEntry_of_mem T ha).symm
  have hB : (T B).val = tableauEntry T b := (tableauEntry_of_mem T hb).symm
  have hE : (T E).val = tableauEntry T e := (tableauEntry_of_mem T he).symm
  have hmap : tableauNatRows U = (tableauNatRows T).map
      (List.map (Equiv.swap (tableauEntry T a) (tableauEntry T b))) := by
    apply tableauNatRows_map
    intro x
    have hx := hswap x.val x.property
    rw [tableauEntry_of_mem U x.property,tableauEntry_of_mem T x.property] at hx
    have hxa : (T x).val = tableauEntry T a ↔ x.val = a := by
      rw [tableauEntry_of_mem T ha]
      constructor
      · intro hh
        exact congrArg Subtype.val (T.injective (Fin.ext hh))
      · intro hh
        have heq : x = A := Subtype.ext hh
        exact congrArg (fun c : ↥μ.cells => (T c).val) heq
    have hxb : (T x).val = tableauEntry T b ↔ x.val = b := by
      rw [tableauEntry_of_mem T hb]
      constructor
      · intro hh
        exact congrArg Subtype.val (T.injective (Fin.ext hh))
      · intro hh
        have heq : x = B := Subtype.ext hh
        exact congrArg (fun c : ↥μ.cells => (T c).val) heq
    simpa only [Equiv.swap_apply_def,hxa,hxb] using hx
  rcases hadj with hadj | hadj
  · let k := tableauEntry T e
    have hAk : (T A).val = k + 1 := by rw [hA]; omega
    have hBk : (T B).val = k + 2 := by rw [hB]; omega
    have hEk : (T E).val = k := hE
    have hk : k + 2 < q := by omega
    have hs := selector_two_of_cell_between T A B E hAk hBk hEk hbetween
    refine ⟨k,hk,?_⟩
    rw [hmap,dualRows, rowWordRows_tableauNatRows,hs]
    simp only [dualLetter, Fin.reduceEq, if_false, if_true]
    have ha' : tableauEntry T a = k + 1 := hA.symm.trans hAk
    have hb' : tableauEntry T b = k + 2 := hB.symm.trans hBk
    rw [ha',hb']
  · let k := tableauEntry T a
    have hAk : (T A).val = k := hA
    have hBk : (T B).val = k + 1 := by rw [hB]; omega
    have hEk : (T E).val = k + 2 := by rw [hE]; omega
    have hk : k + 2 < q := by omega
    have hs := selector_one_of_cell_between T A B E hAk hBk hEk hbetween
    refine ⟨k,hk,?_⟩
    rw [hmap,dualRows,rowWordRows_tableauNatRows,hs]
    simp only [dualLetter, Fin.reduceEq, if_true]
    have hb' : tableauEntry T b = k + 1 := hB.symm.trans hBk
    rw [hb']

theorem DualMove.exists_dualRows {T U : StandardYoungTableau μ} (h : DualMove T U) :
    ∃ k : ℕ, k + 2 < μ.card ∧ tableauNatRows U = dualRows k (tableauNatRows T) := by
  obtain ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap⟩ := h
  apply dualMove_exists_dualRows_of_bounds ha hb he hab hadj hbetween hswap
  · rw [tableauEntry_of_mem T ha]; exact (T ⟨a,ha⟩).isLt
  · rw [tableauEntry_of_mem T hb]; exact (T ⟨b,hb⟩).isLt
  · rw [tableauEntry_of_mem T he]; exact (T ⟨e,he⟩).isLt

/-- Equality of all exact finite packing feasibility questions. -/
def MatchingPackingEquivalent (y z : ℕ → ℕ) : Prop :=
  ∀ (κ : Type) [Fintype κ] (q : ℕ),
    (∃ P : κ → Finset ℕ, MatchingChains.IsPacking y P ∧
      MatchingChains.packingSize P = q) ↔
    (∃ P : κ → Finset ℕ, MatchingChains.IsPacking z P ∧
      MatchingChains.packingSize P = q)

theorem MatchingPackingEquivalent.refl (y : ℕ → ℕ) : MatchingPackingEquivalent y y := by
  intro κ _ q
  exact Iff.rfl

theorem MatchingPackingEquivalent.trans {x y z : ℕ → ℕ}
    (h : MatchingPackingEquivalent x y) (h' : MatchingPackingEquivalent y z) :
    MatchingPackingEquivalent x z := by
  intro κ _ q
  exact (h κ q).trans (h' κ q)

theorem lift_matching_dualRows {T U : StandardYoungTableau μ}
    {k : ℕ} (hk : k + 2 < μ.card)
    (hTU : tableauNatRows U = dualRows k (tableauNatRows T))
    {w : List (ℕ × ℕ)} (hw : MatchingWord w) (hT : pairInsertList w = tableauNatRows T) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧ pairInsertList v = tableauNatRows U ∧
      MatchingPackingEquivalent (partnerMap w) (partnerMap v) := by
  have hm : ∀ d : Fin 3, k + d.val ∈ endpointWord w := by
    intro d
    rw [←mem_rowWordRows_pairInsertList,hT]
    apply mem_rowWordRows_tableauNatRows
    have := d.isLt
    omega
  obtain ⟨v,hv,hvT,hstat⟩ := hw.exists_dual_with_statistics k hm
  refine ⟨v,hv,?_,hstat.packing⟩
  rw [hvT,hT,←hTU]

/-- Dual-equivalence connectivity acts on genuine matching preimages and preserves
every colored packing number. The only equality of matching words used here is
the independently proved injectivity of paired insertion. -/
theorem DualEquivalent.lift_matching {T U : StandardYoungTableau μ}
    (h : DualEquivalent T U) {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) (hT : pairInsertList w = tableauNatRows T) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧ pairInsertList v = tableauNatRows U ∧
      MatchingPackingEquivalent (partnerMap w) (partnerMap v) := by
  have hp : Relation.ReflTransGen (Relation.SymmGen DualMove) T U := by
    rw [Relation.EqvGen.reflTransGen_symmGen]
    exact h
  clear h
  induction hp using Relation.ReflTransGen.trans_induction_on generalizing w with
  | refl => exact ⟨w,hw,hT,MatchingPackingEquivalent.refl _⟩
  | single h =>
    rcases h with h | h
    · obtain ⟨k,hk,hTU⟩ := h.exists_dualRows
      exact lift_matching_dualRows hk hTU hw hT
    · obtain ⟨k,hk,hUT⟩ := h.exists_dualRows
      have hTU := congrArg (dualRows k) hUT
      rw [dualRows_involutive] at hTU
      exact lift_matching_dualRows hk hTU.symm hw hT
  | trans _ _ ih₁ ih₂ =>
    obtain ⟨v,hv,hvT,hstat⟩ := ih₁ hw hT
    obtain ⟨u,hu,huT,hstat'⟩ := ih₂ hv hvT
    exact ⟨u,hu,huT,hstat.trans hstat'⟩

theorem matching_packing_equivalent_of_same_tableau_shape
    {T U : StandardYoungTableau μ} {w v : List (ℕ × ℕ)}
    (hw : MatchingWord w) (hv : MatchingWord v)
    (hT : pairInsertList w = tableauNatRows T)
    (hU : pairInsertList v = tableauNatRows U) :
    MatchingPackingEquivalent (partnerMap w) (partnerMap v) := by
  obtain ⟨v',hv',hv'T,hstat⟩ := (standardTableaux_dual_connected T U).lift_matching hw hT
  have heq : v' = v := pairInsertList_injOn_matching hv' hv (hv'T.trans hU.symm)
  simpa only [heq] using hstat

