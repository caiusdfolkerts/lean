namespace FourPapers.Symmetric

/-- The total partner map is determined by the actual matching relation, including
its identity extension outside the finite endpoint set. -/
theorem ConjugatesPartners.partnerMap_apply {f : ℕ ≃ ℕ} {w v : List (ℕ × ℕ)}
    (h : ConjugatesPartners f w v) (hv : MatchingWord v) (x : ℕ) :
    partnerMap v (f x) = f (partnerMap w x) := by
  by_cases hx : x ∈ endpointWord w
  · exact hv.partnerMap_eq ((h x (partnerMap w x)).mpr (partnerMap_spec hx))
  · have hfx : f x ∉ endpointWord v := fun hh => hx ((h.endpoint x).mp hh)
    rw [partnerMap_fixed_of_not_mem hx, partnerMap_fixed_of_not_mem hfx]

theorem ConjugatesPartners.partnerMap_eq_conjugate {f : ℕ ≃ ℕ}
    {w v : List (ℕ × ℕ)} (h : ConjugatesPartners f w v) (hv : MatchingWord v) :
    partnerMap v = MatchingChains.conjugate f (partnerMap w) := by
  funext x
  simpa only [Equiv.apply_symm_apply, MatchingChains.conjugate] using ConjugatesPartners.partnerMap_apply h hv (f.symm x)

/-- Exact equality of the two independently stated versions of the median rule:
the insertion theorem's three-valued selector and the interval/packing theorem's
explicit transformation of partner functions. -/
theorem medianTransform_eq_selector (y : ℕ → ℕ) (k : ℕ) :
    MatchingChains.medianTransform y k = MatchingChains.conjugate
      (dualLetter k (matchingMedianSelector k (y k) (y (k + 1)) (y (k + 2)))) y := by
  let a := MatchingChains.modifiedPartner y k k
  let b := MatchingChains.modifiedPartner y k (k + 1)
  let c := MatchingChains.modifiedPartner y k (k + 2)
  change (if MatchingChains.StrictMedian a b c then y
      else if MatchingChains.StrictMedian a c b then
        MatchingChains.conjugate (MatchingChains.adjacent k) y
      else MatchingChains.conjugate (MatchingChains.adjacent (k + 1)) y) =
    MatchingChains.conjugate (dualLetter k
      (if MatchingChains.StrictMedian a b c then 0
      else if MatchingChains.StrictMedian a c b then 1 else 2)) y
  by_cases h0 : MatchingChains.StrictMedian a b c
  · simp only [if_pos h0]
    funext x
    simp [dualLetter, MatchingChains.conjugate]
  · simp only [if_neg h0]
    by_cases h1 : MatchingChains.StrictMedian a c b
    · simp only [if_pos h1]
      rfl
    · simp only [if_neg h1, dualLetter, Fin.reduceEq, if_false, if_true,
        MatchingChains.adjacent, Nat.add_assoc]

/-- An explicit finite support bound, obtained from the matching's own endpoints. -/
def matchingBound (w : List (ℕ × ℕ)) : ℕ := (endpointWord w).toFinset.sup id

theorem le_matchingBound {w : List (ℕ × ℕ)} {x : ℕ} (hx : x ∈ endpointWord w) :
    x ≤ matchingBound w := by
  exact Finset.le_sup (f := id) (List.mem_toFinset.mpr hx)

theorem partnerMap_bounded (w : List (ℕ × ℕ)) :
    MatchingChains.BoundedSupport (partnerMap w) (matchingBound w) := by
  intro x hx
  apply partnerMap_fixed_of_not_mem
  intro hm
  have := le_matchingBound hm
  omega

/-- Every actual elementary dual operation on a paired-insertion tableau has a
matching preimage with exactly the same interval-chain and colored-packing
statistics. No statistical property is assumed of the preimage. -/
theorem MatchingWord.exists_dual_with_statistics {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) (k : ℕ)
    (hm : ∀ d : Fin 3, k + d.val ∈ endpointWord w) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧
      pairInsertList v = dualRows k (pairInsertList w) ∧
      MatchingChains.StatisticsInvariant k (partnerMap w) (partnerMap v) := by
  have h0 : k ∈ endpointWord w := by simpa using hm 0
  have h1 : k + 1 ∈ endpointWord w := by simpa using hm 1
  have h2 : k + 2 ∈ endpointWord w := by simpa using hm 2
  obtain ⟨v,hv,hc,hT⟩ := matching_median_rule hw
    (partnerMap_spec h0) (partnerMap_spec h1) (partnerMap_spec h2)
  refine ⟨v,hv,hT,?_⟩
  have hstat := MatchingChains.median_statistics_invariant hw.partnerMap_involutive
    (partnerMap_bounded w) k (le_matchingBound h2)
    (hw.partnerMap_ne h0) (hw.partnerMap_ne h1) (hw.partnerMap_ne h2)
  rw [medianTransform_eq_selector, ←ConjugatesPartners.partnerMap_eq_conjugate hc hv] at hstat
  exact hstat

end FourPapers.Symmetric
end
