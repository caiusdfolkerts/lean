theorem disjoint_chain_unchanged {C B : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C)
    (hB : IsChain (conjugate (adjacent a) y) B)
    (hd : Disjoint (endpoints (conjugate (adjacent a) y) C)
      (endpoints (conjugate (adjacent a) y) B)) :
    IsChain y B ∧ endpoints y B = endpoints (conjugate (adjacent a) y) B := by
  classical
  have hn : ∀ r ∈ B, r ≠ a ∧ r ≠ a + 1 ∧ r ≠ a + 2 ∧ r ≠ γ := by
    intro r hr
    have hrE : r ∈ endpoints (conjugate (adjacent a) y) B := Finset.mem_union_left _ hr
    have haE : a ∈ endpoints (conjugate (adjacent a) y) C := Finset.mem_union_left _ ha
    have hbE : a + 1 ∈ endpoints (conjugate (adjacent a) y) C := Finset.mem_union_left _ hb
    have hcE : a + 2 ∈ endpoints (conjugate (adjacent a) y) C :=
      Finset.mem_union_right _ (Finset.mem_image.mpr ⟨a + 1, hb, e.conjugate_middle⟩)
    have hγE : γ ∈ endpoints (conjugate (adjacent a) y) C :=
      Finset.mem_union_right _ (Finset.mem_image.mpr ⟨a, ha, e.conjugate_left⟩)
    exact ⟨fun h => Finset.disjoint_left.mp hd haE (h ▸ hrE),
      fun h => Finset.disjoint_left.mp hd hbE (h ▸ hrE),
      fun h => Finset.disjoint_left.mp hd hcE (h ▸ hrE),
      fun h => Finset.disjoint_left.mp hd hγE (h ▸ hrE)⟩
  have heq : ∀ r ∈ B, conjugate (adjacent a) y r = y r := by
    intro r hr
    have h := hn r hr
    apply conjugate_adjacent_fixed h.1 h.2.1
    · intro hh
      have hx := congrArg y hh
      rw [e.involution r, e.left] at hx
      exact h.2.2.1 hx
    · intro hh
      have hx := congrArg y hh
      rw [e.involution r, e.middle] at hx
      exact h.2.2.2 hx
  refine ⟨hB.congr_on heq, ?_⟩
  unfold endpoints
  congr 1
  apply Finset.image_congr
  intro r hr
  exact (heq r hr).symm

theorem packing_row_repair {κ : Type*} [Fintype κ] [DecidableEq κ]
    {P : κ → Finset ℕ} (hP : IsPacking (conjugate (adjacent a) y) P)
    (r : κ) (ha : a ∈ P r) (hb : a + 1 ∈ P r) :
    ∃ Q : κ → Finset ℕ, IsPacking y Q ∧ packingSize Q = packingSize P := by
  obtain ⟨D, hD, hcard, hends, hrect⟩ := e.row_repair (hP.chain r) ha hb
  have hothers : ∀ c, c ≠ r → IsChain y (P c) ∧
      endpoints y (P c) = endpoints (conjugate (adjacent a) y) (P c) := by
    intro c hcr
    exact e.disjoint_chain_unchanged (hP.chain r) ha hb (hP.chain c)
      (hP.disjoint r c (Ne.symm hcr))
  refine ⟨Function.update P r D, hP.replace_one r D hD hothers ?_,
    packingSize_replace_one P r D hcard⟩
  intro c hcr
  rw [hends, (hothers c hcr).2]
  exact hP.disjoint r c (Ne.symm hcr)

theorem reverse_packing {κ : Type*} [Fintype κ]
    {P : κ → Finset ℕ} (hP : IsPacking (conjugate (adjacent a) y) P) :
    ∃ Q : κ → Finset ℕ, IsPacking y Q ∧ packingSize Q = packingSize P := by
  classical
  let z := conjugate (adjacent a) y
  have hz : Function.Involutive z := conjugate_involutive e.involution (adjacent a)
  by_cases hrow : ∃ r : κ, a ∈ P r ∧ a + 1 ∈ P r
  · obtain ⟨r, ha, hb⟩ := hrow
    exact e.packing_row_repair hP r ha hb
  by_cases hcol : ∃ r : κ, a ∈ (P r).image z ∧ a + 1 ∈ (P r).image z
  · obtain ⟨r, ha, hb⟩ := hcol
    obtain ⟨Q, hQ, hsize⟩ := e.packing_row_repair (hP.transpose hz) r ha hb
    refine ⟨fun c => (Q c).image y, hQ.transpose e.involution, ?_⟩
    rw [packingSize_transpose e.involution, hsize, packingSize_transpose hz]
  · let Q := fun c => (P c).image (adjacent a)
    have hQ : IsPacking y Q := by
      constructor
      · intro c
        have hr : ¬(a ∈ P c ∧ a + 1 ∈ P c) := fun hh => hrow ⟨c, hh⟩
        have hc : ¬(a ∈ (P c).image z ∧ a + 1 ∈ (P c).image z) := fun hh => hcol ⟨c, hh⟩
        have hh := (hP.chain c).adjacent_unaffected a hr hc
        rwa [conjugate_adjacent_twice] at hh
      · intro c d hcd
        have hh := (Finset.disjoint_image (adjacent a).injective).mpr (hP.disjoint c d hcd)
        rw [← endpoints_relabel, ← endpoints_relabel, conjugate_adjacent_twice] at hh
