    unfold endpoints
    congr 1
    apply Finset.image_congr
    intro r hr
    exact hBsame r (Finset.mem_filter.mp hr).1
  have hVsame : endpoints (conjugate (adjacent a) y) V = endpoints y V := by
    unfold endpoints
    congr 1
    apply Finset.image_congr
