 theorem dualRows_cons_low {k : ℕ} (row : List ℕ) (rows : List (List ℕ))
    (hrow : ∀ x ∈ row, x < k) : dualRows k (row::rows) = row::dualRows k rows := by
  have hf : tripleFootprint k row = [] := tripleFootprint_eq_nil_of_forall_lt hrow
  unfold dualRows
  rw [rowWordRows_cons,tripleFootprint_append,hf,List.append_nil,List.map_cons,
