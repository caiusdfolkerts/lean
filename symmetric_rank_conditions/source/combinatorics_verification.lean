/-- A finite matching, extended to the natural numbers by fixing all labels
larger than its ambient alphabet. -/
def BoundedSupport (y : ℕ → ℕ) (N : ℕ) : Prop := ∀ r, N < r → y r = r

def reverseLabel (N r : ℕ) : ℕ := if r ≤ N then N - r else r

theorem reverseLabel_involutive (N : ℕ) : Function.Involutive (reverseLabel N) := by
  intro r
  by_cases hr : r ≤ N
  · have hrev : N - r ≤ N := Nat.sub_le _ _
    simp only [reverseLabel, if_pos hr, if_pos hrev]
    omega
  · simp only [reverseLabel, if_neg hr]

/-- Reverse a finite initial interval, leaving the remaining labels fixed. -/
def reverseLabels (N : ℕ) : Equiv.Perm ℕ where
  toFun := reverseLabel N
  invFun := reverseLabel N
  left_inv := reverseLabel_involutive N
  right_inv := reverseLabel_involutive N

@[simp] theorem reverseLabels_symm (N : ℕ) : (reverseLabels N).symm = reverseLabels N := rfl

@[simp] theorem reverseLabels_twice (N r : ℕ) : reverseLabels N (reverseLabels N r) = r :=
  reverseLabel_involutive N r

theorem reverseLabels_of_le {N r : ℕ} (hr : r ≤ N) : reverseLabels N r = N - r := by
  change reverseLabel N r = _
  simp only [reverseLabel, if_pos hr]

theorem reverseLabels_of_gt {N r : ℕ} (hr : N < r) : reverseLabels N r = r := by
  change reverseLabel N r = _
  simp only [reverseLabel, if_neg (by omega : ¬ r ≤ N)]

theorem reverseLabels_le {N r : ℕ} (hr : r ≤ N) : reverseLabels N r ≤ N := by
  rw [reverseLabels_of_le hr]
  exact Nat.sub_le _ _

theorem reverseLabels_lt_iff {N r s : ℕ} (hr : r ≤ N) (hs : s ≤ N) :
    reverseLabels N r < reverseLabels N s ↔ s < r := by
  rw [reverseLabels_of_le hr, reverseLabels_of_le hs]
  omega

theorem reverseLabels_le_iff {N r s : ℕ} (hr : r ≤ N) (hs : s ≤ N) :
    reverseLabels N r ≤ reverseLabels N s ↔ s ≤ r := by
  rw [reverseLabels_of_le hr, reverseLabels_of_le hs]
  omega

theorem BoundedSupport.map_le {y : ℕ → ℕ} {N r : ℕ} (h : BoundedSupport y N)
    (hy : Function.Involutive y) (hr : r ≤ N) : y r ≤ N := by
  by_contra hnot
  have hh := h (y r) (by omega)
  rw [hy r] at hh
  omega

theorem IsChain.row_le {y : ℕ → ℕ} {N : ℕ} (h : BoundedSupport y N)
    {C : Finset ℕ} (hC : IsChain y C) {r : ℕ} (hr : r ∈ C) : r ≤ N := by
  by_contra hnot
  have hh := h r (by omega)
  apply hC.oneUse r hr
  simpa only [hh] using hr

/-- Simultaneous reversal of rows and columns preserves a decreasing chain. -/
theorem IsChain.relabel_antitone {y : ℕ → ℕ} {C : Finset ℕ} (hC : IsChain y C)
    (s : Equiv.Perm ℕ)
    (hrow : ∀ a ∈ C, ∀ b ∈ C, a < b → s b < s a)
    (hcol : ∀ a ∈ C.image y, ∀ b ∈ C.image y, a < b → s b < s a) :
    IsChain (conjugate s y) (C.image s) := by
  classical
  constructor
  · intro r hr t ht hrt
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hr
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ht
    simp only [conjugate_apply_image]
    have hba : b < a := by
      by_contra hn
      by_cases heq : a = b
      · subst b; omega
      · have hab : a < b := by omega
        have := hrow a ha b hb hab
        omega
    exact hcol (y a) (Finset.mem_image_of_mem _ ha)
      (y b) (Finset.mem_image_of_mem _ hb) (hC.decreasing b hb a ha hba)
  · intro r hr hbad
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hr
    rw [conjugate_apply_image] at hbad
    obtain ⟨b, hb, hba⟩ := Finset.mem_image.mp hbad
    have hba' : b = y a := s.injective hba
    exact hC.oneUse a ha (hba' ▸ hb)

theorem IsChain.reverse {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (h : BoundedSupport y N) {C : Finset ℕ} (hC : IsChain y C) :
    IsChain (conjugate (reverseLabels N) y) (C.image (reverseLabels N)) := by
  apply hC.relabel_antitone
  · intro a ha b hb hab
    exact (reverseLabels_lt_iff (hC.row_le h hb) (hC.row_le h ha)).mpr hab
  · intro a ha b hb hab
    obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hb
    exact (reverseLabels_lt_iff (h.map_le hy (hC.row_le h hs))
      (h.map_le hy (hC.row_le h hr))).mpr hab

theorem BoundedSupport.reverse {y : ℕ → ℕ} {N : ℕ} (h : BoundedSupport y N) :
    BoundedSupport (conjugate (reverseLabels N) y) N := by
  intro r hr
  simp only [conjugate, reverseLabels_symm, reverseLabels_of_gt hr, h r hr]

@[simp] theorem conjugate_reverse_twice (N : ℕ) (y : ℕ → ℕ) :
    conjugate (reverseLabels N) (conjugate (reverseLabels N) y) = y := by
  funext r
  simp only [conjugate, reverseLabels_symm, reverseLabels_twice]

def reversedSet (N : ℕ) (L : Set ℕ) : Set ℕ := {r | r ≤ N ∧ reverseLabels N r ∈ L}

theorem IsInterval.reversedSet {L : Set ℕ} (hL : IsInterval L) (N : ℕ) :
    IsInterval (reversedSet N L) := by
  intro a ha b hb c hac hcb
  have hc : c ≤ N := hcb.trans hb.1
  refine ⟨hc, ?_⟩
  apply hL (reverseLabels N b) hb.2 (reverseLabels N a) ha.2 (reverseLabels N c)
  · exact (reverseLabels_le_iff hb.1 hc).mpr hcb
  · exact (reverseLabels_le_iff hc ha.1).mpr hac

theorem reverse_mem_reversedSet {N r : ℕ} {L : Set ℕ} (hr : r ≤ N) :
    reverseLabels N r ∈ reversedSet N L ↔ r ∈ L := by
  simp only [reversedSet, Set.mem_setOf_eq, reverseLabels_twice]
  exact and_iff_right (reverseLabels_le hr)

theorem InRectangle.reverse {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (h : BoundedSupport y N) {C : Finset ℕ} (hC : IsChain y C)
    {L M : Set ℕ} (hrect : InRectangle y C L M) :
    InRectangle (conjugate (reverseLabels N) y) (C.image (reverseLabels N))
      (reversedSet N L) (reversedSet N M) := by
  intro r hr
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
  refine ⟨(reverse_mem_reversedSet (hC.row_le h hs)).mpr (hrect s hs).1, ?_⟩
  rw [conjugate_apply_image]
  exact (reverse_mem_reversedSet (h.map_le hy (hC.row_le h hs))).mpr (hrect s hs).2

theorem InRectangle.reverse_back {y : ℕ → ℕ} {N : ℕ} {C : Finset ℕ}
    {L M : Set ℕ}
    (hrect : InRectangle (conjugate (reverseLabels N) y) C
      (reversedSet N L) (reversedSet N M)) :
    InRectangle y (C.image (reverseLabels N)) L M := by
  intro r hr
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
  refine ⟨(hrect s hs).1.2, ?_⟩
  have hh := (hrect s hs).2.2
  simpa only [conjugate, reverseLabels_symm, reverseLabels_twice] using hh

theorem chain_exists_iff_reverse {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (h : BoundedSupport y N) (L M : Set ℕ) (q : ℕ) :
    (∃ C : Finset ℕ, IsChain y C ∧ C.card = q ∧ InRectangle y C L M) ↔
      (∃ C : Finset ℕ, IsChain (conjugate (reverseLabels N) y) C ∧ C.card = q ∧
        InRectangle (conjugate (reverseLabels N) y) C (reversedSet N L) (reversedSet N M)) := by
  constructor
  · rintro ⟨C, hC, hq, hrect⟩
    exact ⟨C.image (reverseLabels N), hC.reverse hy h,
      (Finset.card_image_of_injective _ (reverseLabels N).injective).trans hq,
      hrect.reverse hy h hC⟩
  · rintro ⟨C, hC, hq, hrect⟩
    have hh := hC.reverse (conjugate_involutive hy (reverseLabels N)) h.reverse
    rw [conjugate_reverse_twice] at hh
    exact ⟨C.image (reverseLabels N), hh,
      (Finset.card_image_of_injective _ (reverseLabels N).injective).trans hq,
      hrect.reverse_back⟩

theorem IsPacking.reverse {κ : Type*} {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (h : BoundedSupport y N) {P : κ → Finset ℕ} (hP : IsPacking y P) :
    IsPacking (conjugate (reverseLabels N) y) (fun c => (P c).image (reverseLabels N)) := by
  constructor
  · intro c; exact (hP.chain c).reverse hy h
  · intro c d hcd
    rw [endpoints_relabel, endpoints_relabel]
    exact (Finset.disjoint_image (reverseLabels N).injective).mpr (hP.disjoint c d hcd)

theorem packing_exists_iff_reverse {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (h : BoundedSupport y N) (κ : Type*) [Fintype κ] (q : ℕ) :
    (∃ P : κ → Finset ℕ, IsPacking y P ∧ packingSize P = q) ↔
      (∃ P : κ → Finset ℕ, IsPacking (conjugate (reverseLabels N) y) P ∧ packingSize P = q) := by
  constructor
  · rintro ⟨P, hP, hq⟩
    exact ⟨fun c => (P c).image (reverseLabels N), hP.reverse hy h,
      (packingSize_relabel (reverseLabels N) P).trans hq⟩
  · rintro ⟨P, hP, hq⟩
    have hh := hP.reverse (conjugate_involutive hy (reverseLabels N)) h.reverse
    rw [conjugate_reverse_twice] at hh
    exact ⟨fun c => (P c).image (reverseLabels N), hh,
      (packingSize_relabel (reverseLabels N) P).trans hq⟩

end FourPapers.Symmetric.MatchingChains
