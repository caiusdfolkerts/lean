  have hz : firstRowProcess [(b,k),(c,k+1),(a,k+2)] [] =
      ([a,c],[(k,k+1),(b,k+2)]) := by
    simp [firstRowProcess,rowBump,hab,hac,hb,hc,not_lt_of_ge hbc,
      not_lt_of_ge hac.le]
  unfold pairedTriple
  rw [pairInsertList_firstRowProcess,pairInsertList_firstRowProcess,hy,hz]
  rw [dualRows_cons_low _ _ (by
    intro x hx
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl | rfl
    · exact hac.trans hc
    · exact hc)]
