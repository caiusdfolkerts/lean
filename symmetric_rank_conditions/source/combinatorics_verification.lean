  rw [pairInsert_high hrows,map_appendToRow,map_appendToRow,map_dualLetter_low_rows hrows]

/-- The internal-edge critical relation, with no restriction on the number or
lengths of the initial rows. -/
theorem paired_internal_dual {k c : ℕ} {rows : List (List ℕ)}
    (hc : c < k) (hrows : ∀ x ∈ rows.flatten, x < k) :
    dualRows k (pairInsert k (k+2) (pairInsert c (k+1) rows)) =
      pairInsert c (k+2) (pairInsert k (k+1) rows) := by
  have hc0 := tripleTag_eq_none_of_lt hc
  cases rows with
  | nil =>
    simp only [pairInsert_nil]
    have hbY : rowBump k [c,k+1] = ([c,k],some (k+1)) := by
      rw [rowBump_cons_of_le _ hc.le,rowBump_cons_of_lt _ (by omega : k < k+1)]
    have hbZ : rowBump c [k,k+1] = ([c,k+1],some k) := by
      rw [rowBump_cons_of_lt _ hc]
    rw [pairInsert_cons_of_some [] (by rw [hbY]),hbY,
      pairInsert_cons_of_some [] (by rw [hbZ]),hbZ]
    simp [pairInsert_nil,dualRows,rowWordRows_cons,rowWordRows_nil,tripleFootprint,
      List.filterMap_cons,hc0,dualSelector,dualLetter,Equiv.swap_apply_def,Nat.add_assoc,
      show c ≠ k from by omega,show c ≠ k+1 from by omega]
