set_option maxHeartbeats 800000

namespace FourPapers.Symmetric.MatchingChains

theorem isChain_empty (y : ℕ → ℕ) : IsChain y ∅ := by
  constructor <;> simp

theorem isPacking_empty (y : ℕ → ℕ) (κ : Type*) : IsPacking y (fun _ : κ => ∅) := by
  constructor
  · intro c; exact isChain_empty y
  · intro c d hcd; simp [endpoints]

/-- The largest cardinality of a one-use decreasing chain whose rows belong to
`L`. Under `BoundedSupport y N`, every such chain is included in the search. -/
noncomputable def rowChainMax (y : ℕ → ℕ) (N : ℕ) (L : Set ℕ) : ℕ := by
  classical
  exact Nat.findGreatest
    (fun q => ∃ C : Finset ℕ, IsChain y C ∧ C.card = q ∧ ∀ r ∈ C, r ∈ L) (N + 1)

theorem IsChain.card_le {y : ℕ → ℕ} {N : ℕ} (h : BoundedSupport y N)
    {C : Finset ℕ} (hC : IsChain y C) : C.card ≤ N + 1 := by
  have hsub : C ⊆ Finset.range (N + 1) := by
    intro r hr
    apply Finset.mem_range.mpr
    have := hC.row_le h hr
    omega
  simpa only [Finset.card_range] using Finset.card_le_card hsub

theorem rowChainMax_attained (y : ℕ → ℕ) (N : ℕ) (L : Set ℕ) :
    ∃ C : Finset ℕ, IsChain y C ∧ C.card = rowChainMax y N L ∧ ∀ r ∈ C, r ∈ L := by
  classical
  exact Nat.findGreatest_spec
    (P := fun q => ∃ C : Finset ℕ, IsChain y C ∧ C.card = q ∧ ∀ r ∈ C, r ∈ L)
    (m := 0) (Nat.zero_le (N + 1)) ⟨∅, isChain_empty y, rfl, by simp⟩

theorem card_le_rowChainMax {y : ℕ → ℕ} {N : ℕ} (h : BoundedSupport y N)
    (L : Set ℕ) {C : Finset ℕ} (hC : IsChain y C) (hL : ∀ r ∈ C, r ∈ L) :
    C.card ≤ rowChainMax y N L := by
  classical
  exact Nat.le_findGreatest (hC.card_le h) ⟨C, hC, rfl, hL⟩

theorem IsPacking.size_le {κ : Type*} [Fintype κ] {y : ℕ → ℕ}
    {N : ℕ} (h : BoundedSupport y N) {P : κ → Finset ℕ} (hP : IsPacking y P) :
    packingSize P ≤ N + 1 := by
  classical
  have hdis : ((Finset.univ : Finset κ) : Set κ).PairwiseDisjoint P := by
    intro c hc d hd hcd
    apply Finset.disjoint_left.mpr
    intro r hr hr'
    exact Finset.disjoint_left.mp (hP.disjoint c d hcd)
      (Finset.mem_union_left _ hr) (Finset.mem_union_left _ hr')
  have hcard := Finset.card_biUnion hdis
  have hsub : (Finset.univ : Finset κ).biUnion P ⊆ Finset.range (N + 1) := by
    intro r hr
    obtain ⟨c, hc, hr⟩ := Finset.mem_biUnion.mp hr
    apply Finset.mem_range.mpr
    have := (hP.chain c).row_le h hr
    omega
  have hle := Finset.card_le_card hsub
  rw [Finset.card_range, hcard] at hle
  exact hle

/-- The largest number of distinct matching edges covered by `k` one-use
chains. The packing definition makes the sum count each unordered edge once. -/
noncomputable def packingMax (y : ℕ → ℕ) (N k : ℕ) : ℕ := by
  classical
  exact Nat.findGreatest
    (fun q => ∃ P : Fin k → Finset ℕ, IsPacking y P ∧ packingSize P = q) (N + 1)

theorem packingMax_attained (y : ℕ → ℕ) (N k : ℕ) :
    ∃ P : Fin k → Finset ℕ, IsPacking y P ∧ packingSize P = packingMax y N k := by
  classical
  exact Nat.findGreatest_spec
    (P := fun q => ∃ P : Fin k → Finset ℕ, IsPacking y P ∧ packingSize P = q)
    (m := 0) (Nat.zero_le (N + 1))
    ⟨fun _ => ∅, isPacking_empty y (Fin k), by simp [packingSize]⟩

theorem size_le_packingMax {y : ℕ → ℕ} {N k : ℕ} (h : BoundedSupport y N)
    {P : Fin k → Finset ℕ} (hP : IsPacking y P) : packingSize P ≤ packingMax y N k := by
  classical
  exact Nat.le_findGreatest (hP.size_le h) ⟨P, hP, rfl⟩

theorem median_rowChainMax_eq {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (hsupp : BoundedSupport y N) (a : ℕ) (hN : a + 2 ≤ N)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2)
    (L : Set ℕ) (hL : IsInterval L) (haL : a ∈ L) (hbL : a + 1 ∈ L)
    (hcL : a + 2 ∈ L) :
    rowChainMax y N L = rowChainMax (medianTransform y a) N L := by
  classical
  have heq := median_row_chain_exists_iff hy hsupp a hN ha hb hc L hL haL hbL hcL
  apply Nat.le_antisymm
  · exact Nat.findGreatest_mono_left (fun q hq => (heq q).mp hq) (N + 1)
  · exact Nat.findGreatest_mono_left (fun q hq => (heq q).mpr hq) (N + 1)

theorem median_packingMax_eq {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (hsupp : BoundedSupport y N) (a : ℕ) (hN : a + 2 ≤ N)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2)
    (k : ℕ) : packingMax y N k = packingMax (medianTransform y a) N k := by
  classical
  have heq := median_packing_exists_iff hy hsupp a hN ha hb hc k
  apply Nat.le_antisymm
  · exact Nat.findGreatest_mono_left (fun q hq => (heq q).mp hq) (N + 1)
  · exact Nat.findGreatest_mono_left (fun q hq => (heq q).mpr hq) (N + 1)

end FourPapers.Symmetric.MatchingChains
end
