namespace FourPapers.Symmetric.MatchingChains

/-- Restricting a one-use chain keeps both defining properties. -/
theorem IsChain.mono {y : ℕ → ℕ} {C D : Finset ℕ}
    (hC : IsChain y C) (hDC : D ⊆ C) : IsChain y D := by
  exact ⟨fun r hr s hs hrs => hC.decreasing r (hDC hr) s (hDC hs) hrs,
    fun r hr hy => hC.oneUse r (hDC hr) (hDC hy)⟩

theorem IsChain.erase {y : ℕ → ℕ} {C : Finset ℕ}
    (hC : IsChain y C) (r : ℕ) : IsChain y (C.erase r) :=
  hC.mono (Finset.erase_subset _ _)

/-- Insert one edge in its prescribed position in a decreasing one-use chain. -/
theorem IsChain.insert {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C : Finset ℕ} (hC : IsChain y C) (v : ℕ)
    (hvv : y v ≠ v) (hv : v ∉ C) (hyv : y v ∉ C)
    (hleft : ∀ r ∈ C, r < v → y v < y r)
    (hright : ∀ r ∈ C, v < r → y r < y v) :
    IsChain y (insert v C) := by
  classical
  constructor
  · intro r hr s hs hrs
    rcases Finset.mem_insert.mp hr with rfl | hrC
    · rcases Finset.mem_insert.mp hs with rfl | hsC
      · omega
      · exact hright s hsC hrs
    · rcases Finset.mem_insert.mp hs with rfl | hsC
      · exact hleft r hrC hrs
      · exact hC.decreasing r hrC s hsC hrs
  · intro r hr hbad
    rcases Finset.mem_insert.mp hr with rfl | hr
    · rcases Finset.mem_insert.mp hbad with heq | hm
      · exact hvv heq
      · exact hyv hm
    · rcases Finset.mem_insert.mp hbad with heq | hm
      · have heq' : r = y v := by
          have hh := congrArg y heq
          rw [hy r] at hh
          exact hh
        exact hyv (heq' ▸ hr)
      · exact hC.oneUse r hr hm

/-- Flip all the points of a chain inside an isolated square. The exterior
points lie strictly northwest or southeast of the square. This is the actual
unbounded segment-transposition operation used in the local matching move. -/
theorem IsChain.flip_square {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C E : Finset ℕ} (hC : IsChain y C) (hE : E ⊆ C) (l u : ℕ)
    (hin : ∀ r ∈ E, l < r ∧ r < u ∧ l < y r ∧ y r < u)
    (hout : ∀ r ∈ C, r ∉ E →
      (r ≤ l ∧ u ≤ y r) ∨ (u ≤ r ∧ y r ≤ l)) :
    IsChain y (flip y C E) := by
  classical
  have hT := (hC.mono hE).transpose hy
  constructor
  · intro r hr s hs hrs
    rcases Finset.mem_union.mp hr with hr | hr
    · have hr' := Finset.mem_sdiff.mp hr
      rcases Finset.mem_union.mp hs with hs | hs
      · exact hC.decreasing r hr'.1 s (Finset.mem_sdiff.mp hs).1 hrs
      · obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hs
        have hti := hin t ht
        rcases hout r hr'.1 hr'.2 with hrl | hrr
        · rw [hy t]
          omega
        · omega
    · rcases Finset.mem_union.mp hs with hs | hs
      · obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hr
        have hti := hin t ht
        have hs' := Finset.mem_sdiff.mp hs
        rcases hout s hs'.1 hs'.2 with hsl | hsr
        · omega
        · rw [hy t]
          omega
      · exact hT.decreasing r hr s hs hrs
  · exact oneUse_flip hy hE hC.oneUse

/-- The only convexity property of intervals needed by the local repairs. -/
def IsInterval (L : Set ℕ) : Prop :=
  ∀ a ∈ L, ∀ b ∈ L, ∀ c, a ≤ c → c ≤ b → c ∈ L

/-- Both the selected rows and their partner columns lie in the indicated sets. -/
def InRectangle (y : ℕ → ℕ) (C : Finset ℕ) (L M : Set ℕ) : Prop :=
  ∀ r ∈ C, r ∈ L ∧ y r ∈ M

theorem InRectangle.mono {y : ℕ → ℕ} {C D : Finset ℕ} {L M : Set ℕ}
    (h : InRectangle y C L M) (hDC : D ⊆ C) : InRectangle y D L M :=
  fun r hr => h r (hDC hr)

theorem InRectangle.flip_square {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C E : Finset ℕ} {L M : Set ℕ} (h : InRectangle y C L M)
    (hE : E ⊆ C) (hL : IsInterval L) (hM : IsInterval M) (l u : ℕ)
    (hlL : l ∈ L) (huL : u ∈ L) (hlM : l ∈ M) (huM : u ∈ M)
    (hin : ∀ r ∈ E, l < r ∧ r < u ∧ l < y r ∧ y r < u) :
    InRectangle y (flip y C E) L M := by
  classical
  intro r hr
  rcases Finset.mem_union.mp hr with hr | hr
  · exact h r (Finset.mem_sdiff.mp hr).1
  · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
    have hi := hin s hs
    refine ⟨hL l hlL u huL (y s) hi.2.2.1.le hi.2.2.2.le, ?_⟩
    rw [hy s]
    exact hM l hlM u huM s hi.1.le hi.2.1.le

theorem InRectangle.insert {y : ℕ → ℕ} {C : Finset ℕ} {L M : Set ℕ}
    (h : InRectangle y C L M) {v : ℕ} (hv : v ∈ L) (hyv : y v ∈ M) :
    InRectangle y (insert v C) L M := by
  intro r hr
  rcases Finset.mem_insert.mp hr with rfl | hr
  · exact ⟨hv, hyv⟩
  · exact h r hr

theorem endpoints_insert (y : ℕ → ℕ) (C : Finset ℕ) (v : ℕ) :
    endpoints y (insert v C) = insert v (insert (y v) (endpoints y C)) := by
  classical
  ext r
  simp only [endpoints, Finset.image_insert, Finset.mem_union, Finset.mem_insert]
  tauto

theorem endpoints_erase_restore (y : ℕ → ℕ) {C : Finset ℕ} {v : ℕ}
    (hv : v ∈ C) : insert v (insert (y v) (endpoints y (C.erase v))) = endpoints y C := by
  rw [← endpoints_insert, Finset.insert_erase hv]


theorem InRectangle.transpose {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C : Finset ℕ} {L M : Set ℕ} (h : InRectangle y C L M) :
    InRectangle y (C.image y) M L := by
  intro r hr
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
  exact ⟨(h s hs).2, by simpa only [hy s] using (h s hs).1⟩

theorem adjacent_mem {a r : ℕ} {L : Set ℕ} (ha : a ∈ L)
    (hb : a + 1 ∈ L) (hr : r ∈ L) : adjacent a r ∈ L := by
  by_cases hra : r = a
  · subst r; simpa only [adjacent_self] using hb
  by_cases hrb : r = a + 1
  · subst r; simpa only [adjacent_succ] using ha
  simpa only [adjacent_apply_of_ne hra hrb] using hr

theorem InRectangle.adjacent {y : ℕ → ℕ} {C : Finset ℕ} {L M : Set ℕ}
    (h : InRectangle y C L M) (a : ℕ)
    (haL : a ∈ L) (hbL : a + 1 ∈ L) (haM : a ∈ M) (hbM : a + 1 ∈ M) :
    InRectangle (conjugate (adjacent a) y) (C.image (adjacent a)) L M := by
  intro r hr
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
  refine ⟨adjacent_mem haL hbL (h s hs).1, ?_⟩
  rw [conjugate_apply_image]
  exact adjacent_mem haM hbM (h s hs).2

/-- A repair preserves all interval rectangles containing the distinguished
triple. The column clause is retained so that transposition proves the column
case of the rank invariant without losing its row bounds. -/
def PreservesRectangles (a : ℕ) (y z : ℕ → ℕ) (C D : Finset ℕ) : Prop :=
  ∀ L M : Set ℕ, IsInterval L → IsInterval M →
    a ∈ L → a + 1 ∈ L → a + 2 ∈ L →
    a ∈ M → a + 1 ∈ M → a + 2 ∈ M →
    InRectangle z C L M → InRectangle y D L M


/-- The external local configuration (2.5) of the manuscript. All partners are
outside the three consecutive distinguished labels. -/
structure ExternalMove (y : ℕ → ℕ) (a α β γ : ℕ) : Prop where
  involution : Function.Involutive y
  left_lt : α < γ
  right_lt : γ < β
  left : y a = α
  middle : y (a + 1) = β
  right : y (a + 2) = γ
  left_external : α ≠ a ∧ α ≠ a + 1 ∧ α ≠ a + 2
  middle_external : β ≠ a ∧ β ≠ a + 1 ∧ β ≠ a + 2
  right_external : γ ≠ a ∧ γ ≠ a + 1 ∧ γ ≠ a + 2

namespace ExternalMove

variable {y : ℕ → ℕ} {a α β γ : ℕ} (e : ExternalMove y a α β γ)

include e

theorem left_partner : y α = a := by
  simpa only [e.left] using e.involution a

theorem middle_partner : y β = a + 1 := by
  simpa only [e.middle] using e.involution (a + 1)

theorem right_partner : y γ = a + 2 := by
  simpa only [e.right] using e.involution (a + 2)

theorem conjugate_left : conjugate (adjacent a) y a = β := by
  simp only [conjugate, adjacent_symm, adjacent_self, e.middle]
  exact adjacent_apply_of_ne e.middle_external.1 e.middle_external.2.1

theorem conjugate_middle : conjugate (adjacent a) y (a + 1) = α := by
  simp only [conjugate, adjacent_symm, adjacent_succ, e.left]
  exact adjacent_apply_of_ne e.left_external.1 e.left_external.2.1

theorem conjugate_right : conjugate (adjacent a) y (a + 2) = γ := by
  apply (conjugate_adjacent_fixed (by omega) (by omega) ?_ ?_).trans e.right
  · simpa only [e.right] using e.right_external.1
  · simpa only [e.right] using e.right_external.2.1

theorem conjugate_right_partner : conjugate (adjacent a) y γ = a + 2 := by
  apply (conjugate_adjacent_fixed e.right_external.1 e.right_external.2.1 ?_ ?_).trans e.right_partner
  · rw [e.right_partner]; omega
  · rw [e.right_partner]; omega

theorem excluded_partners {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) : α ∉ C ∧ β ∉ C ∧ a + 2 ∉ C := by
  have hα : α ∉ C := by simpa only [e.conjugate_middle] using hC.oneUse (a + 1) hb
  have hβ : β ∉ C := by simpa only [e.conjugate_left] using hC.oneUse a ha
  refine ⟨hα, hβ, ?_⟩
  intro hc
  have hh := hC.decreasing (a + 1) hb (a + 2) hc (by omega)
  rw [e.conjugate_right, e.conjugate_middle] at hh
  have := e.left_lt
  omega

theorem same_on_chain {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) {r : ℕ} (hr : r ∈ C)
    (hra : r ≠ a) (hrb : r ≠ a + 1) :
    conjugate (adjacent a) y r = y r := by
  have hex := e.excluded_partners hC ha hb
  apply conjugate_adjacent_fixed hra hrb
  · intro h
    have hrα : r = α := by
      have hh := congrArg y h
      rw [e.involution r, e.left] at hh
      exact hh
    exact hex.1 (hrα ▸ hr)
  · intro h
    have hrβ : r = β := by
      have hh := congrArg y h
      rw [e.involution r, e.middle] at hh
      exact hh
    exact hex.2.1 (hrβ ▸ hr)

/-- Removing the second affected row restores the chain in the old matching. -/
theorem erase_middle {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) : IsChain y (C.erase (a + 1)) := by
  classical
  have hex := e.excluded_partners hC ha hb
  constructor
  · intro r hr s hs hrs
    obtain ⟨hrb, hr⟩ := Finset.mem_erase.mp hr
    obtain ⟨hsb, hs⟩ := Finset.mem_erase.mp hs
    by_cases hra : r = a
    · subst r
      have hsa : s ≠ a := by omega
      have hh := hC.decreasing (a + 1) hb s hs (by omega)
      rw [e.conjugate_middle, e.same_on_chain hC ha hb hs hsa hsb] at hh
      simpa only [e.left] using hh
    · by_cases hsa : s = a
      · subst s
        have hh := hC.decreasing r hr a ha hrs
        rw [e.conjugate_left, e.same_on_chain hC ha hb hr hra hrb] at hh
        rw [e.left]
        have := e.left_lt; have := e.right_lt
        omega
      · have hh := hC.decreasing r hr s hs hrs
        rwa [e.same_on_chain hC ha hb hr hra hrb,
          e.same_on_chain hC ha hb hs hsa hsb] at hh
  · intro r hr hbad
    obtain ⟨hrb, hr⟩ := Finset.mem_erase.mp hr
    have hbad' := (Finset.mem_erase.mp hbad).2
    by_cases hra : r = a
    · subst r
      rw [e.left] at hbad'
      exact hex.1 hbad'
    · rw [← e.same_on_chain hC ha hb hr hra hrb] at hbad'
      exact hC.oneUse r hr hbad'

/-- Removing the first affected row restores the chain in the old matching. -/
theorem erase_left {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) : IsChain y (C.erase a) := by
  classical
  have hex := e.excluded_partners hC ha hb
  constructor
  · intro r hr s hs hrs
    obtain ⟨hra, hr⟩ := Finset.mem_erase.mp hr
    obtain ⟨hsa, hs⟩ := Finset.mem_erase.mp hs
    by_cases hrb : r = a + 1
    · subst r
      have hsb : s ≠ a + 1 := by omega
      have hh := hC.decreasing (a + 1) hb s hs hrs
      rw [e.conjugate_middle, e.same_on_chain hC ha hb hs hsa hsb] at hh
      rw [e.middle]
      have := e.left_lt; have := e.right_lt
      omega
    · by_cases hsb : s = a + 1
      · subst s
        have hh := hC.decreasing r hr a ha (by omega)
        rw [e.conjugate_left, e.same_on_chain hC ha hb hr hra hrb] at hh
        simpa only [e.middle] using hh
      · have hh := hC.decreasing r hr s hs hrs
        rwa [e.same_on_chain hC ha hb hr hra hrb,
          e.same_on_chain hC ha hb hs hsa hsb] at hh
  · intro r hr hbad
    obtain ⟨hra, hr⟩ := Finset.mem_erase.mp hr
    have hbad' := (Finset.mem_erase.mp hbad).2
    by_cases hrb : r = a + 1
    · subst r
      rw [e.middle] at hbad'
      exact hex.2.1 hbad'
    · rw [← e.same_on_chain hC ha hb hr hra hrb] at hbad'
      exact hC.oneUse r hr hbad'

theorem rectangle_erase_middle {C : Finset ℕ} {L M : Set ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C)
    (h : InRectangle (conjugate (adjacent a) y) C L M) :
    InRectangle y (C.erase (a + 1)) L M := by
  intro r hr
  obtain ⟨hrb, hr⟩ := Finset.mem_erase.mp hr
  refine ⟨(h r hr).1, ?_⟩
  by_cases hra : r = a
  · subst r
    rw [e.left]
    simpa only [e.conjugate_middle] using (h (a + 1) hb).2
  · rw [← e.same_on_chain hC ha hb hr hra hrb]
    exact (h r hr).2

theorem rectangle_erase_left {C : Finset ℕ} {L M : Set ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C)
    (h : InRectangle (conjugate (adjacent a) y) C L M) :
    InRectangle y (C.erase a) L M := by
  intro r hr
  obtain ⟨hra, hr⟩ := Finset.mem_erase.mp hr
  refine ⟨(h r hr).1, ?_⟩
  by_cases hrb : r = a + 1
  · subst r
    rw [e.middle]
    simpa only [e.conjugate_left] using (h a ha).2
  · rw [← e.same_on_chain hC ha hb hr hra hrb]
    exact (h r hr).2

theorem endpoints_erase_middle {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) :
    insert β (insert (a + 1) (endpoints y (C.erase (a + 1)))) =
      endpoints (conjugate (adjacent a) y) C := by
  classical
  ext r
  simp only [endpoints, Finset.mem_insert, Finset.mem_union, Finset.mem_image]
  constructor
  · rintro (rfl | rfl | hr | ⟨s, hs, rfl⟩)
    · exact Or.inr ⟨a, ha, e.conjugate_left⟩
    · exact Or.inl hb
    · exact Or.inl (Finset.mem_erase.mp hr).2
    · obtain ⟨hsb, hs⟩ := Finset.mem_erase.mp hs
      by_cases hsa : s = a
      · subst s
        exact Or.inr ⟨a + 1, hb, e.conjugate_middle.trans e.left.symm⟩
      · exact Or.inr ⟨s, hs, e.same_on_chain hC ha hb hs hsa hsb⟩
  · rintro (hr | ⟨s, hs, rfl⟩)
    · by_cases hrb : r = a + 1
      · exact Or.inr (Or.inl hrb)
      · exact Or.inr (Or.inr (Or.inl (Finset.mem_erase.mpr ⟨hrb, hr⟩)))
    · by_cases hsa : s = a
      · subst s
        exact Or.inl e.conjugate_left
      · by_cases hsb : s = a + 1
        · subst s
          refine Or.inr (Or.inr (Or.inr ⟨a, Finset.mem_erase.mpr ⟨by omega, ha⟩, ?_⟩))
          exact e.left.trans e.conjugate_middle.symm
        · exact Or.inr (Or.inr (Or.inr ⟨s, Finset.mem_erase.mpr ⟨hsb, hs⟩,
            (e.same_on_chain hC ha hb hs hsa hsb).symm⟩))

theorem endpoints_erase_left {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) :
    insert α (insert a (endpoints y (C.erase a))) =
      endpoints (conjugate (adjacent a) y) C := by
  classical
  ext r
  simp only [endpoints, Finset.mem_insert, Finset.mem_union, Finset.mem_image]
  constructor
  · rintro (rfl | rfl | hr | ⟨s, hs, rfl⟩)
    · exact Or.inr ⟨a + 1, hb, e.conjugate_middle⟩
    · exact Or.inl ha
    · exact Or.inl (Finset.mem_erase.mp hr).2
    · obtain ⟨hsa, hs⟩ := Finset.mem_erase.mp hs
      by_cases hsb : s = a + 1
      · subst s
        exact Or.inr ⟨a, ha, e.conjugate_left.trans e.middle.symm⟩
      · exact Or.inr ⟨s, hs, e.same_on_chain hC ha hb hs hsa hsb⟩
  · rintro (hr | ⟨s, hs, rfl⟩)
    · by_cases hra : r = a
      · exact Or.inr (Or.inl hra)
      · exact Or.inr (Or.inr (Or.inl (Finset.mem_erase.mpr ⟨hra, hr⟩)))
    · by_cases hsb : s = a + 1
      · subst s
        exact Or.inl e.conjugate_middle
      · by_cases hsa : s = a
        · subst s
          refine Or.inr (Or.inr (Or.inr ⟨a + 1, Finset.mem_erase.mpr ⟨by omega, hb⟩, ?_⟩))
          exact e.middle.trans e.conjugate_left.symm
        · exact Or.inr (Or.inr (Or.inr ⟨s, Finset.mem_erase.mpr ⟨hsa, hs⟩,
            (e.same_on_chain hC ha hb hs hsa hsb).symm⟩))


/-- If the third edge lies on the selected chain to the left of the distinguished
triple, its intervening segment is transposed inside an isolated square. -/
theorem used_low_repair {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) (hγC : γ ∈ C) (hγa : γ < a) :
    ∃ D : Finset ℕ, IsChain y D ∧ D.card = C.card ∧
      endpoints y D = endpoints (conjugate (adjacent a) y) C ∧
      (∀ L M : Set ℕ, IsInterval L → IsInterval M →
        a ∈ L → a + 1 ∈ L → a + 2 ∈ L →
        a ∈ M → a + 1 ∈ M → a + 2 ∈ M →
        InRectangle (conjugate (adjacent a) y) C L M → InRectangle y D L M) := by
  classical
  let E := C.filter (fun r => γ < r ∧ r < a)
  let C₀ := C.erase (a + 1)
  let F := flip y C₀ E
  have hex := e.excluded_partners hC ha hb
  have hβa : β < a := by
    have hh := hC.decreasing γ hγC a ha hγa
    rw [e.conjugate_left, e.conjugate_right_partner] at hh
    have := e.middle_external
    omega
  have hEC : E ⊆ C₀ := by
    intro r hr
    have hr' := Finset.mem_filter.mp hr
    exact Finset.mem_erase.mpr ⟨by omega, hr'.1⟩
  have hin : ∀ r ∈ E, γ < r ∧ r < a ∧ γ < y r ∧ y r < a := by
    intro r hr
    obtain ⟨hr, hγr, hra⟩ := Finset.mem_filter.mp hr
    have hrne : r ≠ a := by omega
    have hrneb : r ≠ a + 1 := by omega
    have hs := e.same_on_chain hC ha hb hr hrne hrneb
    have hlo := hC.decreasing r hr a ha hra
    have hhi := hC.decreasing γ hγC r hr hγr
    rw [e.conjugate_left, hs] at hlo
    rw [e.conjugate_right_partner, hs] at hhi
    have hn0 : y r ≠ a := by
      intro h
      have hh := congrArg y h
      rw [e.involution r, e.left] at hh
      exact hex.1 (hh ▸ hr)
    have hn1 : y r ≠ a + 1 := by
      intro h
      have hh := congrArg y h
      rw [e.involution r, e.middle] at hh
      exact hex.2.1 (hh ▸ hr)
    have := e.right_lt
    exact ⟨hγr, hra, by omega, by omega⟩
  have hinnerβ : ∀ r ∈ E, β < y r := by
    intro r hr
    obtain ⟨hr, hγr, hra⟩ := Finset.mem_filter.mp hr
    have hh := hC.decreasing r hr a ha hra
    rw [e.conjugate_left, e.same_on_chain hC ha hb hr (by omega) (by omega)] at hh
    exact hh
  have hout : ∀ r ∈ C₀, r ∉ E →
      (r ≤ γ ∧ a ≤ y r) ∨ (a ≤ r ∧ y r ≤ γ) := by
    intro r hr hnr
    obtain ⟨hrb, hr⟩ := Finset.mem_erase.mp hr
    have hn : ¬ (γ < r ∧ r < a) := fun hh => hnr (Finset.mem_filter.mpr ⟨hr, hh⟩)
    by_cases hrγ : r ≤ γ
    · left
      refine ⟨hrγ, ?_⟩
      by_cases heq : r = γ
      · subst r; rw [e.right_partner]; omega
      · have hh := hC.decreasing r hr γ hγC (by omega)
        rw [e.conjugate_right_partner, e.same_on_chain hC ha hb hr (by omega) hrb] at hh
        omega
    · right
      have hra : a ≤ r := by omega
      refine ⟨hra, ?_⟩
      by_cases heq : r = a
      · subst r; rw [e.left]; exact e.left_lt.le
      · have hh := hC.decreasing (a + 1) hb r hr (by omega)
        rw [e.conjugate_middle, e.same_on_chain hC ha hb hr heq hrb] at hh
        have := e.left_lt
        omega
  have hF : IsChain y F := (e.erase_middle hC ha hb).flip_square e.involution hEC γ a hin hout
  have hβF : β ∉ F := by
    intro hr
    rcases Finset.mem_union.mp hr with hr | hr
    · exact hex.2.1 (Finset.mem_erase.mp (Finset.mem_sdiff.mp hr).1).2
    · obtain ⟨r, hr, heq⟩ := Finset.mem_image.mp hr
      have := hinnerβ r hr
      omega
  have hbF : a + 1 ∉ F := by
    intro hr
    rcases Finset.mem_union.mp hr with hr | hr
    · exact (Finset.mem_erase.mp (Finset.mem_sdiff.mp hr).1).1 rfl
    · obtain ⟨r, hr, heq⟩ := Finset.mem_image.mp hr
      have := hin r hr
      omega
  have hleft : ∀ r ∈ F, r < β → y β < y r := by
    intro r hr hrβ
    rw [e.middle_partner]
    rcases Finset.mem_union.mp hr with hr | hr
    · have h := Finset.mem_sdiff.mp hr
      have ho := hout r h.1 h.2
      have hrC := (Finset.mem_erase.mp h.1).2
      have hrγ : r ≤ γ := by rcases ho with ho | ho <;> omega
      by_cases heq : r = γ
      · subst r; rw [e.right_partner]; omega
      · have hh := hC.decreasing r hrC γ hγC (by omega)
        rw [e.conjugate_right_partner,
          e.same_on_chain hC ha hb hrC (by omega) (by omega)] at hh
        omega
    · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
      have := hinnerβ s hs
      omega
  have hright : ∀ r ∈ F, β < r → y r < y β := by
    intro r hr hβr
    rw [e.middle_partner]
    rcases Finset.mem_union.mp hr with hr | hr
    · have h := Finset.mem_sdiff.mp hr
      have hγβ := e.right_lt
      rcases hout r h.1 h.2 with ho | ho <;> omega
    · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
      rw [e.involution s]
      have := hin s hs
      omega
  let D := insert β F
  have hD : IsChain y D := hF.insert e.involution β
    (by rw [e.middle_partner]; omega) hβF (by simpa only [e.middle_partner] using hbF) hleft hright
  have hcard : D.card = C.card := by
    dsimp only [D,F,C₀]
    rw [Finset.card_insert_of_notMem hβF,
      card_flip e.involution hEC (e.erase_middle hC ha hb).oneUse,
      Finset.card_erase_of_mem hb]
    have := Finset.card_pos.mpr ⟨a, ha⟩
    omega
  have hends : endpoints y D = endpoints (conjugate (adjacent a) y) C := by
    have hflip := endpoints_flip e.involution hEC
    change endpoints y F = endpoints y C₀ at hflip
    have hDends : endpoints y D = insert β (insert (y β) (endpoints y F)) := by
      ext r
      simp only [D, endpoints, Finset.image_insert, Finset.mem_union, Finset.mem_insert]
      tauto
    rw [hDends, e.middle_partner, hflip]
    exact e.endpoints_erase_middle hC ha hb
  refine ⟨D, hD, hcard, hends, ?_⟩
  intro L M hL hM haL hbL hcL haM hbM hcM hrect
  have hγL := (hrect γ hγC).1
  have hαM : α ∈ M := by simpa only [e.conjugate_middle] using (hrect (a + 1) hb).2
  have hβM : β ∈ M := by simpa only [e.conjugate_left] using (hrect a ha).2
  have hγM : γ ∈ M := hM α hαM β hβM γ e.left_lt.le e.right_lt.le
  have hFrect : InRectangle y F L M :=
    (e.rectangle_erase_middle hC ha hb hrect).flip_square e.involution hEC hL hM γ a
      hγL haL hγM haM hin
  apply hFrect.insert (hL γ hγL a haL β e.right_lt.le hβa.le)
  simpa only [e.middle_partner] using hbM


/-- The second used-third-edge repair in Lemma 2.2, with the third partner above
all three distinguished labels. -/
theorem used_high_repair {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) (hγC : γ ∈ C) (hcγ : a + 2 < γ) :
    ∃ D : Finset ℕ, IsChain y D ∧ D.card = C.card ∧
      endpoints y D = endpoints (conjugate (adjacent a) y) C ∧
      (∀ L M : Set ℕ, IsInterval L → IsInterval M →
        a ∈ L → a + 1 ∈ L → a + 2 ∈ L →
        a ∈ M → a + 1 ∈ M → a + 2 ∈ M →
        InRectangle (conjugate (adjacent a) y) C L M → InRectangle y D L M) := by
  classical
  let E := C.filter (fun r => a + 2 < r ∧ r < γ)
  let C₀ := (C.erase a).erase γ
  let F := flip y C₀ E
  have hex := e.excluded_partners hC ha hb
  have hcα : a + 2 < α := by
    have hh := hC.decreasing (a + 1) hb γ hγC (by omega)
    rwa [e.conjugate_middle, e.conjugate_right_partner] at hh
  have hEC : E ⊆ C₀ := by
    intro r hr
    have hr' := Finset.mem_filter.mp hr
    exact Finset.mem_erase.mpr ⟨by omega,
      Finset.mem_erase.mpr ⟨by omega, hr'.1⟩⟩
  have hin : ∀ r ∈ E, a + 2 < r ∧ r < γ ∧ a + 2 < y r ∧ y r < γ := by
    intro r hr
    obtain ⟨hr, hcr, hrγ⟩ := Finset.mem_filter.mp hr
    have hs := e.same_on_chain hC ha hb hr (by omega) (by omega)
    have hlo := hC.decreasing r hr γ hγC hrγ
    have hhi := hC.decreasing (a + 1) hb r hr (by omega)
    rw [e.conjugate_right_partner, hs] at hlo
    rw [e.conjugate_middle, hs] at hhi
    have := e.left_lt
    exact ⟨hcr, hrγ, hlo, by omega⟩
  have hinnerα : ∀ r ∈ E, y r < α := by
    intro r hr
    obtain ⟨hr, hcr, hrγ⟩ := Finset.mem_filter.mp hr
    have hh := hC.decreasing (a + 1) hb r hr (by omega)
    rw [e.conjugate_middle, e.same_on_chain hC ha hb hr (by omega) (by omega)] at hh
    exact hh
  have hout : ∀ r ∈ C₀, r ∉ E →
      (r ≤ a + 2 ∧ γ ≤ y r) ∨ (γ ≤ r ∧ y r ≤ a + 2) := by
    intro r hr hnr
    obtain ⟨hrγ, hr⟩ := Finset.mem_erase.mp hr
    obtain ⟨hra, hr⟩ := Finset.mem_erase.mp hr
    have hn : ¬ (a + 2 < r ∧ r < γ) := fun hh => hnr (Finset.mem_filter.mpr ⟨hr, hh⟩)
    by_cases hrc : r ≤ a + 2
    · left
      refine ⟨hrc, ?_⟩
      have hrnc : r ≠ a + 2 := fun hh => hex.2.2 (hh ▸ hr)
      by_cases hrb : r = a + 1
      · subst r; rw [e.middle]; exact e.right_lt.le
      · have hh := hC.decreasing r hr a ha (by omega)
        rw [e.conjugate_left, e.same_on_chain hC ha hb hr hra hrb] at hh
        have := e.right_lt
        omega
    · right
      have hγr : γ < r := by omega
      refine ⟨hγr.le, ?_⟩
      have hh := hC.decreasing γ hγC r hr hγr
      rw [e.conjugate_right_partner, e.same_on_chain hC ha hb hr hra (by omega)] at hh
      exact hh.le
  have hC₀ : IsChain y C₀ := (e.erase_left hC ha hb).erase γ
  have hF : IsChain y F := hC₀.flip_square e.involution hEC (a + 2) γ hin hout
  have hcF : a + 2 ∉ F := by
    intro hr
    rcases Finset.mem_union.mp hr with hr | hr
    · exact hex.2.2 (Finset.mem_erase.mp (Finset.mem_erase.mp (Finset.mem_sdiff.mp hr).1).2).2
    · obtain ⟨r, hr, heq⟩ := Finset.mem_image.mp hr
      have := hin r hr
      omega
  have hγF : γ ∉ F := by
    intro hr
    rcases Finset.mem_union.mp hr with hr | hr
    · exact (Finset.mem_erase.mp (Finset.mem_sdiff.mp hr).1).1 rfl
    · obtain ⟨r, hr, heq⟩ := Finset.mem_image.mp hr
      have := hinnerα r hr
      have := e.left_lt
      omega
  have hcLeft : ∀ r ∈ F, r < a + 2 → y (a + 2) < y r := by
    intro r hr hrc
    rw [e.right]
    rcases Finset.mem_union.mp hr with hr | hr
    · have h := Finset.mem_sdiff.mp hr
      obtain ⟨hrγ, hr⟩ := Finset.mem_erase.mp h.1
      obtain ⟨hra, hr⟩ := Finset.mem_erase.mp hr
      by_cases hrb : r = a + 1
      · subst r; rw [e.middle]; exact e.right_lt
      · have hh := hC.decreasing r hr a ha (by omega)
        rw [e.conjugate_left, e.same_on_chain hC ha hb hr hra hrb] at hh
        have := e.right_lt
        omega
    · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
      have := hin s hs
      omega
  have hcRight : ∀ r ∈ F, a + 2 < r → y r < y (a + 2) := by
    intro r hr hcr
    rw [e.right]
    rcases Finset.mem_union.mp hr with hr | hr
    · have h := Finset.mem_sdiff.mp hr
      rcases hout r h.1 h.2 with ho | ho <;> omega
    · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
      rw [e.involution s]
      exact (hin s hs).2.1
  let G := insert (a + 2) F
  have hG : IsChain y G := hF.insert e.involution (a + 2)
    (by rw [e.right]; omega) hcF (by simpa only [e.right] using hγF) hcLeft hcRight
  have hαG : α ∉ G := by
    intro hr
    rcases Finset.mem_insert.mp hr with heq | hr
    · omega
    · rcases Finset.mem_union.mp hr with hr | hr
      · exact hex.1 (Finset.mem_erase.mp (Finset.mem_erase.mp (Finset.mem_sdiff.mp hr).1).2).2
