/-- The two-tail repair is independent of the current orientation of the third
edge in its color. -/
theorem two_tail_switch_edge {C B : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (hB : IsChain (conjugate (adjacent a) y) B)
    (ha : a ∈ C) (hb : a + 1 ∈ C)
    (hc : a + 2 ∈ endpoints (conjugate (adjacent a) y) B)
    (hd : Disjoint (endpoints (conjugate (adjacent a) y) C)
      (endpoints (conjugate (adjacent a) y) B)) :
    ∃ C' B' : Finset ℕ, IsChain y C' ∧ IsChain y B' ∧
      Disjoint (endpoints y C') (endpoints y B') ∧
      C'.card + B'.card = C.card + B.card ∧
      endpoints y C' ∪ endpoints y B' =
        endpoints (conjugate (adjacent a) y) C ∪ endpoints (conjugate (adjacent a) y) B := by
  classical
  let z := conjugate (adjacent a) y
  have hz : Function.Involutive z := conjugate_involutive e.involution (adjacent a)
  rcases Finset.mem_union.mp hc with hc | hc
  · exact e.two_tail_switch hC hB ha hb hc hd
  · have hBt : endpoints (conjugate (adjacent a) y) (B.image z) =
        endpoints (conjugate (adjacent a) y) B := endpoints_transpose hz B
    obtain ⟨C', B', hC', hB', hd', hcard, hends⟩ :=
      e.two_tail_switch hC (hB.transpose hz) ha hb hc
        (by rw [hBt]; exact hd)
    refine ⟨C', B', hC', hB', hd', ?_, ?_⟩
    · simpa only [card_transpose hz] using hcard
    · simpa only [hBt] using hends


/-- Repair a colored packing when a selected color contains both affected rows.
A third edge in another color is handled by the two-tail switch; an unused
third edge is inserted directly. -/
theorem packing_row_repair {κ : Type*} [Fintype κ] [DecidableEq κ]
    {P : κ → Finset ℕ} (hP : IsPacking (conjugate (adjacent a) y) P)
    (r : κ) (ha : a ∈ P r) (hb : a + 1 ∈ P r) :
    ∃ Q : κ → Finset ℕ, IsPacking y Q ∧ packingSize Q = packingSize P := by
  classical
  let z := conjugate (adjacent a) y
  have hz : Function.Involutive z := conjugate_involutive e.involution (adjacent a)
  have hothers : ∀ c, c ≠ r → IsChain y (P c) ∧ endpoints y (P c) = endpoints z (P c) := by
    intro c hcr
    obtain ⟨h, heq, hend⟩ := e.disjoint_chain_unchanged (hP.chain r) ha hb (hP.chain c)
      (hP.disjoint r c (Ne.symm hcr))
    exact ⟨h, hend⟩
  by_cases hγ : γ ∈ P r
  · have hcases : γ < a ∨ a + 2 < γ := by have := e.right_external; omega
    have hrepair : ∃ D : Finset ℕ, IsChain y D ∧ D.card = (P r).card ∧
        endpoints y D = endpoints z (P r) := by
      rcases hcases with hlo | hhi
      · obtain ⟨D, hD, hc, he, hrect⟩ := e.used_low_repair (hP.chain r) ha hb hγ hlo
        exact ⟨D, hD, hc, he⟩
      · obtain ⟨D, hD, hc, he, hrect⟩ := e.used_high_repair (hP.chain r) ha hb hγ hhi
        exact ⟨D, hD, hc, he⟩
    obtain ⟨D, hD, hcard, hends⟩ := hrepair
    refine ⟨Function.update P r D, hP.replace_one r D hD hothers ?_,
      packingSize_replace_one P r D hcard⟩
    intro c hcr
    rw [hends, (hothers c hcr).2]
    exact hP.disjoint r c (Ne.symm hcr)
  by_cases hused : ∃ s : κ, s ≠ r ∧ a + 2 ∈ endpoints z (P s)
  · obtain ⟨s, hsr, hc⟩ := hused
    obtain ⟨C, D, hC, hD, hd, hcard, hends⟩ := e.two_tail_switch_edge
      (hP.chain r) (hP.chain s) ha hb hc (hP.disjoint r s (Ne.symm hsr))
    refine ⟨(fun c => if c = r then C else if c = s then D else P c),
      hP.replace_two r s (Ne.symm hsr) C D hC hD hd hends.le ?_,
      packingSize_replace_two P r s (Ne.symm hsr) C D hcard⟩
    intro c hcr hcs
    exact hothers c hcr
  · let D := insert (a + 2) ((P r).erase a)
    obtain ⟨hD, hcard⟩ := external_unused_row_repair e.involution e.left_lt e.right_lt
      e.left e.middle e.right e.left_external e.middle_external e.right_external
      (hP.chain r) ha hb hγ
    have hdis : ∀ c, c ≠ r → Disjoint (endpoints y D) (endpoints y (P c)) := by
      intro c hcr
      apply Finset.disjoint_left.mpr
      intro x hx hx'
      rw [(hothers c hcr).2] at hx'
      have hnone : a + 2 ∉ endpoints z (P c) := fun hh => hused ⟨c, hcr, hh⟩
      dsimp only [D] at hx
      rw [endpoints_insert, e.right] at hx
      rcases Finset.mem_insert.mp hx with rfl | hx
      · exact hnone hx'
      · rcases Finset.mem_insert.mp hx with rfl | hx
        · have hh : z (a + 2) ∈ endpoints z (P c) := by
            simpa only [z, e.conjugate_right] using hx'
          exact hnone ((mem_endpoints_partner_iff hz (P c) (a + 2)).mp hh)
        · have hold : x ∈ endpoints z (P r) := by
            rw [← e.endpoints_erase_left (hP.chain r) ha hb]
            exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hx)
          exact Finset.disjoint_left.mp (hP.disjoint r c (Ne.symm hcr)) hold hx'
    exact ⟨Function.update P r D, hP.replace_one r D hD hothers hdis,
      packingSize_replace_one P r D hcard⟩

/-- Reverse an external move for every finite number of colors. No chain,
matching, alphabet, or packing-size bound is introduced. -/
theorem reverse_packing {κ : Type*} [Fintype κ]
    {P : κ → Finset ℕ} (hP : IsPacking (conjugate (adjacent a) y) P) :
    ∃ Q : κ → Finset ℕ, IsPacking y Q ∧ packingSize Q = packingSize P := by
  classical
  let z := conjugate (adjacent a) y
  have hz : Function.Involutive z := conjugate_involutive e.involution (adjacent a)
  by_cases hrow : ∃ r : κ, a ∈ P r ∧ a + 1 ∈ P r
  · obtain ⟨r, ha, hb⟩ := hrow
    exact e.packing_row_repair hP r ha hb
  by_cases hcol : ∃ r : κ, a ∈ (P r).image z ∧ a + 1 ∈ (P r).image z
  · obtain ⟨r, ha, hb⟩ := hcol
    obtain ⟨Q, hQ, hsize⟩ := e.packing_row_repair (hP.transpose hz) r ha hb
    refine ⟨fun c => (Q c).image y, hQ.transpose e.involution, ?_⟩
    rw [packingSize_transpose e.involution, hsize, packingSize_transpose hz]
  · let Q := fun c => (P c).image (adjacent a)
    have hQ : IsPacking y Q := by
      constructor
      · intro c
        have hr : ¬(a ∈ P c ∧ a + 1 ∈ P c) := fun hh => hrow ⟨c, hh⟩
        have hc : ¬(a ∈ (P c).image z ∧ a + 1 ∈ (P c).image z) := fun hh => hcol ⟨c, hh⟩
        have hh := (hP.chain c).adjacent_unaffected a hr hc
        rwa [conjugate_adjacent_twice] at hh
      · intro c d hcd
        have hh := (Finset.disjoint_image (adjacent a).injective).mpr (hP.disjoint c d hcd)
        rw [← endpoints_relabel, ← endpoints_relabel, conjugate_adjacent_twice] at hh
        exact hh
    exact ⟨Q, hQ, packingSize_relabel (adjacent a) P⟩

theorem packing_exists_iff (κ : Type*) [Fintype κ] (q : ℕ) :
    (∃ P : κ → Finset ℕ, IsPacking y P ∧ packingSize P = q) ↔
      (∃ P : κ → Finset ℕ, IsPacking (conjugate (adjacent a) y) P ∧ packingSize P = q) := by
  constructor
  · rintro ⟨P, hP, hq⟩
    have hpartners : y a < y (a + 1) := by
      rw [e.left, e.middle]
      exact e.left_lt.trans e.right_lt
    exact ⟨fun c => (P c).image (adjacent a), hP.adjacent_forward e.involution a hpartners,
      (packingSize_relabel (adjacent a) P).trans hq⟩
  · rintro ⟨P, hP, hq⟩
    obtain ⟨Q, hQ, hsize⟩ := e.reverse_packing hP
    exact ⟨Q, hQ, hsize.trans hq⟩


end ExternalMove
