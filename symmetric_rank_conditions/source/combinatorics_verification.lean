variable {μ : YoungDiagram}

/-- A geometric elementary move whose entire distinguished triple lies below
the prefix cutoff. This includes the third, unswapped label. -/
def DualMoveBefore (q : ℕ) (T U : StandardYoungTableau μ) : Prop :=
  ∃ a b e : ℕ × ℕ, a ∈ μ ∧ b ∈ μ ∧ e ∈ μ ∧
    tableauEntry T a + 1 = tableauEntry T b ∧
    (tableauEntry T e + 1 = tableauEntry T a ∨
      tableauEntry T b + 1 = tableauEntry T e) ∧
    RowReadBetween a e b ∧
    (∀ x ∈ μ, tableauEntry U x =
      if x = a then tableauEntry T b else if x = b then tableauEntry T a
      else tableauEntry T x) ∧
    tableauEntry T a < q ∧ tableauEntry T b < q ∧ tableauEntry T e < q

def DualEquivalentBefore (q : ℕ) (T U : StandardYoungTableau μ) : Prop :=
  Relation.EqvGen (DualMoveBefore q) T U

theorem DualMoveBefore.forget {q : ℕ} {T U : StandardYoungTableau μ}
    (h : DualMoveBefore q T U) : DualMove T U := by
  obtain ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap,_⟩ := h
  exact ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap⟩

theorem DualMove.before {T U : StandardYoungTableau μ} (h : DualMove T U)
    {q : ℕ} (hq : μ.card ≤ q) : DualMoveBefore q T U := by
  obtain ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap⟩ := h
  refine ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap,?_,?_,?_⟩
  · rw [tableauEntry_of_mem T ha]
    exact (T ⟨a,ha⟩).isLt.trans_le hq
  · rw [tableauEntry_of_mem T hb]
    exact (T ⟨b,hb⟩).isLt.trans_le hq
  · rw [tableauEntry_of_mem T he]
    exact (T ⟨e,he⟩).isLt.trans_le hq

theorem DualMoveBefore.extend {q : ℕ} {c : ℕ × ℕ}
    (hc : YoungDiagram.IsCorner μ c)
    {T U : StandardYoungTableau (YoungDiagram.erase μ c)}
    (h : DualMoveBefore q T U) : DualMoveBefore q (extend hc T) (extend hc U) := by
  obtain ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap,hqa,hqb,hqe⟩ := h
  refine ⟨a,b,e,YoungDiagram.mem_of_mem_erase ha,YoungDiagram.mem_of_mem_erase hb,
    YoungDiagram.mem_of_mem_erase he,?_,?_,hbetween,?_,?_,?_,?_⟩
  · simpa only [tableauEntry_extend hc T ha,tableauEntry_extend hc T hb] using hab
  · simpa only [tableauEntry_extend hc T ha,tableauEntry_extend hc T hb,
      tableauEntry_extend hc T he] using hadj
  · intro x hx
    have hac : a ≠ c := (hc.mem_erase_iff.mp ha).2
    have hbc : b ≠ c := (hc.mem_erase_iff.mp hb).2
    by_cases hxc : x = c
    · subst x
      simp only [hac.symm,hbc.symm,if_false]
      have ht := tableauEntry_extend_corner hc T
      have hu := tableauEntry_extend_corner hc U
      omega
    · have hx' := hc.mem_erase_iff.mpr ⟨hx,hxc⟩
      simpa only [tableauEntry_extend hc T ha,tableauEntry_extend hc T hb,
        tableauEntry_extend hc T hx',tableauEntry_extend hc U hx'] using hswap x hx'
  · simpa only [tableauEntry_extend hc T ha] using hqa
  · simpa only [tableauEntry_extend hc T hb] using hqb
  · simpa only [tableauEntry_extend hc T he] using hqe

theorem DualEquivalentBefore.extend {q : ℕ} {c : ℕ × ℕ}
    (hc : YoungDiagram.IsCorner μ c)
    {T U : StandardYoungTableau (YoungDiagram.erase μ c)}
    (h : DualEquivalentBefore q T U) :
    DualEquivalentBefore q (extend hc T) (extend hc U) := by
  induction h with
  | rel T U h => exact Relation.EqvGen.rel _ _ (h.extend hc)
  | refl T => exact Relation.EqvGen.refl _
  | symm T U h ih => exact Relation.EqvGen.symm _ _ ih
  | trans T U V h₁ h₂ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

theorem standardTableaux_dual_connected_before (T U : StandardYoungTableau μ)
    {q : ℕ} (hq : μ.card ≤ q) : DualEquivalentBefore q T U := by
  have h := standardTableaux_dual_connected T U
  induction h with
  | rel T U h => exact Relation.EqvGen.rel _ _ (h.before hq)
  | refl T => exact Relation.EqvGen.refl _
  | symm T U h ih => exact Relation.EqvGen.symm _ _ ih
  | trans T U V h₁ h₂ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- A prefix shape and its extension through the original larger-label corners.
Every standard tableau of this prefix shape extends to the full shape, and every
move within the prefix extends without introducing a larger label into its triple. -/
structure PrefixExtension (T : StandardYoungTableau μ) (q : ℕ) where
  shape : YoungDiagram
  card : shape.card = q
  shape_le : shape ≤ μ
  extend : StandardYoungTableau shape → StandardYoungTableau μ
  inside : ∀ (S : StandardYoungTableau shape) (c : ℕ × ℕ), c ∈ shape →
    tableauEntry (extend S) c = tableauEntry S c
  outside : ∀ (S : StandardYoungTableau shape) (c : ℕ × ℕ), c ∈ μ → c ∉ shape →
    q ≤ tableauEntry (extend S) c
  original : ∃ S : StandardYoungTableau shape, extend S = T
  moves : ∀ (S U : StandardYoungTableau shape), DualEquivalentBefore q S U →
    DualEquivalentBefore q (extend S) (extend U)

theorem prefixExtension_of_card (n : ℕ) :
    ∀ (μ : YoungDiagram), μ.card = n → ∀ (T : StandardYoungTableau μ) (q : ℕ),
      q ≤ μ.card → Nonempty (PrefixExtension T q) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro μ hcard T q hq
    by_cases heq : q = μ.card
    · exact ⟨{
        shape := μ
        card := heq.symm
        shape_le := le_rfl
        extend := id
        inside := by intros; rfl
        outside := by intro S c hc hn; exact (hn hc).elim
        original := ⟨T,rfl⟩
        moves := by intro S U h; exact h }⟩
    · have hlt : q < μ.card := by omega
      have hpos : 0 < μ.card := by omega
      let c := maxCell hpos T
      have hc : YoungDiagram.IsCorner μ c := isCorner_maxCell hpos T
      have hTc : (T ⟨c,hc.mem⟩).val + 1 = μ.card := apply_maxCell hpos T
      let T' := restrict hc T hTc
      have hsmall : (YoungDiagram.erase μ c).card < n := by
        have := hc.card_erase
        omega
      have hq' : q ≤ (YoungDiagram.erase μ c).card := by
        have := hc.card_erase
        omega
      obtain ⟨E⟩ := ih _ hsmall (YoungDiagram.erase μ c) rfl T' q hq'
      refine ⟨{
        shape := E.shape
        card := E.card
        shape_le := E.shape_le.trans (YoungDiagram.erase_le μ c)
        extend := fun S => StandardYoungTableau.extend hc (E.extend S)
        inside := ?_
        outside := ?_
        original := ?_
        moves := ?_ }⟩
      · intro S x hx
        rw [tableauEntry_extend hc (E.extend S) (E.shape_le hx)]
        exact E.inside S x hx
      · intro S x hx hnx
        by_cases hxc : x = c
        · subst x
          have hh := tableauEntry_extend_corner hc (E.extend S)
          omega
        · have hx' := hc.mem_erase_iff.mpr ⟨hx,hxc⟩
          rw [tableauEntry_extend hc (E.extend S) hx']
          exact E.outside S x hx' hnx
      · obtain ⟨S,hS⟩ := E.original
        refine ⟨S,?_⟩
        rw [hS]
        exact extend_restrict hc T hTc
      · intro S U h
        exact (E.moves S U h).extend hc

theorem prefixExtension_exists (T : StandardYoungTableau μ) (q : ℕ)
    (hq : q ≤ μ.card) : Nonempty (PrefixExtension T q) :=
  prefixExtension_of_card μ.card μ rfl T q hq

/-- The shape in `PrefixExtension` is exactly the subdiagram occupied by the
labels below the cutoff. It is not an arbitrary auxiliary shape. -/
theorem PrefixExtension.mem_shape_iff {T : StandardYoungTableau μ} {q : ℕ}
    (E : PrefixExtension T q) (c : ℕ × ℕ) :
    c ∈ E.shape ↔ c ∈ μ ∧ tableauEntry T c < q := by
  obtain ⟨S,hS⟩ := E.original
  constructor
  · intro hc
    refine ⟨E.shape_le hc,?_⟩
    calc
      tableauEntry T c = tableauEntry (E.extend S) c :=
        congrArg (fun U => tableauEntry U c) hS.symm
      _ = tableauEntry S c := E.inside S c hc
      _ = (S ⟨c,hc⟩).val := tableauEntry_of_mem S hc
      _ < q := (S ⟨c,hc⟩).isLt.trans_eq E.card
  · rintro ⟨hc,hlt⟩
    by_contra hn
    have hh := E.outside S c hc hn
    rw [hS] at hh
    omega

theorem PrefixExtension.reaches {T : StandardYoungTableau μ} {q : ℕ}
    (E : PrefixExtension T q) (S : StandardYoungTableau E.shape) :
    DualEquivalentBefore q T (E.extend S) := by
  obtain ⟨R,hR⟩ := E.original
  exact Eq.mp (congrArg (fun U => DualEquivalentBefore q U (E.extend S)) hR)
    (E.moves R S (standardTableaux_dual_connected_before R S E.card.le))

theorem DualMoveBefore.exists_dualRows {q : ℕ} {T U : StandardYoungTableau μ}
    (h : DualMoveBefore q T U) :
    ∃ k : ℕ, k + 2 < q ∧ tableauNatRows U = dualRows k (tableauNatRows T) := by
  obtain ⟨a,b,e,ha,hb,he,hab,hadj,hbetween,hswap,hqa,hqb,hqe⟩ := h
  exact dualMove_exists_dualRows_of_bounds ha hb he hab hadj hbetween hswap hqa hqb hqe

/-- Exact feasibility of one-use chains in the first `q` rows of a matching. -/
def MatchingPrefixEquivalent (q : ℕ) (y z : ℕ → ℕ) : Prop :=
  ∀ r : ℕ,
    (∃ C : Finset ℕ, MatchingChains.IsChain y C ∧ C.card = r ∧
      ∀ i ∈ C, i < q) ↔
    (∃ C : Finset ℕ, MatchingChains.IsChain z C ∧ C.card = r ∧
      ∀ i ∈ C, i < q)

theorem MatchingPrefixEquivalent.refl (q : ℕ) (y : ℕ → ℕ) :
    MatchingPrefixEquivalent q y y := fun _ => Iff.rfl

theorem MatchingPrefixEquivalent.trans {q : ℕ} {x y z : ℕ → ℕ}
    (h : MatchingPrefixEquivalent q x y) (h' : MatchingPrefixEquivalent q y z) :
    MatchingPrefixEquivalent q x z := fun r => (h r).trans (h' r)

theorem MatchingChains.StatisticsInvariant.prefix {k q : ℕ} {y z : ℕ → ℕ}
    (h : MatchingChains.StatisticsInvariant k y z) (hk : k + 2 < q) :
    MatchingPrefixEquivalent q y z := by
  intro r
  have hL : MatchingChains.IsInterval {i : ℕ | i < q} := by
    intro a ha b hb c hac hcb
    change c < q
    change b < q at hb
    omega
  have hM : MatchingChains.IsInterval (Set.univ : Set ℕ) := by
    intro a ha b hb c hac hcb
    exact Set.mem_univ c
  simpa only [MatchingChains.InRectangle,Set.mem_setOf_eq,Set.mem_univ,and_true] using
    h.chain {i : ℕ | i < q} Set.univ hL hM
      (by change k < q; omega) (by change k + 1 < q; omega)
      (by change k + 2 < q; exact hk) (by trivial) (by trivial) (by trivial) r

theorem lift_matching_dualRows_before {T U : StandardYoungTableau μ}
    {q k : ℕ} (hq : q ≤ μ.card) (hk : k + 2 < q)
    (hTU : tableauNatRows U = dualRows k (tableauNatRows T))
    {w : List (ℕ × ℕ)} (hw : MatchingWord w) (hT : pairInsertList w = tableauNatRows T) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧ pairInsertList v = tableauNatRows U ∧
      MatchingPrefixEquivalent q (partnerMap w) (partnerMap v) ∧
      MatchingPackingEquivalent (partnerMap w) (partnerMap v) := by
  have hm : ∀ d : Fin 3, k + d.val ∈ endpointWord w := by
    intro d
    rw [←mem_rowWordRows_pairInsertList,hT]
    apply mem_rowWordRows_tableauNatRows
    have := d.isLt
    omega
  obtain ⟨v,hv,hvT,hstat⟩ := hw.exists_dual_with_statistics k hm
  refine ⟨v,hv,?_,hstat.prefix hk,hstat.packing⟩
  rw [hvT,hT,←hTU]

theorem DualEquivalentBefore.lift_matching {q : ℕ} {T U : StandardYoungTableau μ}
    (h : DualEquivalentBefore q T U) (hq : q ≤ μ.card) {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) (hT : pairInsertList w = tableauNatRows T) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧ pairInsertList v = tableauNatRows U ∧
      MatchingPrefixEquivalent q (partnerMap w) (partnerMap v) ∧
      MatchingPackingEquivalent (partnerMap w) (partnerMap v) := by
  have hp : Relation.ReflTransGen (Relation.SymmGen (DualMoveBefore q)) T U := by
    rw [Relation.EqvGen.reflTransGen_symmGen]
    exact h
  clear h
  induction hp using Relation.ReflTransGen.trans_induction_on generalizing w with
  | refl => exact ⟨w,hw,hT,MatchingPrefixEquivalent.refl _ _,MatchingPackingEquivalent.refl _⟩
  | single h =>
    rcases h with h | h
    · obtain ⟨k,hk,hTU⟩ := h.exists_dualRows
      exact lift_matching_dualRows_before hq hk hTU hw hT
    · obtain ⟨k,hk,hUT⟩ := h.exists_dualRows
      have hTU := congrArg (dualRows k) hUT
      rw [dualRows_involutive] at hTU
      exact lift_matching_dualRows_before hq hk hTU.symm hw hT
  | trans _ _ ih₁ ih₂ =>
    obtain ⟨v,hv,hvT,hprefix,hpacking⟩ := ih₁ hw hT
    obtain ⟨u,hu,huT,hprefix',hpacking'⟩ := ih₂ hv hvT
    exact ⟨u,hu,huT,hprefix.trans hprefix',hpacking.trans hpacking'⟩

/-- Every chosen standard prefix representative is attained by an actual matching
while preserving the original prefix chain profile and every packing profile. -/
theorem PrefixExtension.lift_matching {q : ℕ} {T : StandardYoungTableau μ}
    (E : PrefixExtension T q) (hq : q ≤ μ.card)
    (S : StandardYoungTableau E.shape) {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) (hT : pairInsertList w = tableauNatRows T) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧ pairInsertList v = tableauNatRows (E.extend S) ∧
      MatchingPrefixEquivalent q (partnerMap w) (partnerMap v) ∧
      MatchingPackingEquivalent (partnerMap w) (partnerMap v) :=
  (E.reaches S).lift_matching hq hw hT

end FourPapers.Symmetric
end
