variable {α β : Type*} [LinearOrder α] [LinearOrder β]

theorem rowBump_map_strictMono (f : α → β) (hf : StrictMono f)
    (a : α) (row : List α) :
    rowBump (f a) (row.map f) =
      ((rowBump a row).1.map f, (rowBump a row).2.map f) := by
  induction row with
  | nil => rfl
  | cons b row ih =>
    simp only [List.map_cons,rowBump_cons,hf.lt_iff_lt]
    split_ifs <;> simp only [List.map_cons,Option.map_some,ih]

theorem rowInsert_map_strictMono (f : α → β) (hf : StrictMono f)
    (a : α) (rows : List (List α)) :
    rowInsert (f a) (rows.map (List.map f)) = (rowInsert a rows).map (List.map f) ∧
      rowInsertIndex (f a) (rows.map (List.map f)) = rowInsertIndex a rows := by
  induction rows generalizing a with
  | nil => simp
  | cons row rows ih =>
    have hmap := rowBump_map_strictMono f hf a row
    cases hb : (rowBump a row).2 with
    | none =>
      have hbn : (rowBump (f a) (row.map f)).2 = none := by rw [hmap,hb]; rfl
      constructor <;> simp only [List.map_cons,rowInsert_cons_of_eq_none rows hb,
        rowInsert_cons_of_eq_none _ hbn,rowInsertIndex_cons_of_eq_none rows hb,
        rowInsertIndex_cons_of_eq_none _ hbn,hmap]
    | some b =>
      have hbs : (rowBump (f a) (row.map f)).2 = some (f b) := by rw [hmap,hb]; rfl
      obtain ⟨hins,hindex⟩ := ih b
      constructor <;> simp only [List.map_cons,rowInsert_cons_of_eq_some rows hb,
        rowInsert_cons_of_eq_some _ hbs,rowInsertIndex_cons_of_eq_some rows hb,
        rowInsertIndex_cons_of_eq_some _ hbs,hmap,hins,hindex]

theorem pairInsert_map_strictMono (f : α → β) (hf : StrictMono f)
    (a b : α) (rows : List (List α)) :
    pairInsert (f a) (f b) (rows.map (List.map f)) =
      (pairInsert a b rows).map (List.map f) := by
  obtain ⟨hins,hindex⟩ := rowInsert_map_strictMono f hf a rows
  unfold pairInsert
  rw [hins,hindex,map_appendToRow]

theorem pairInsertList_map_strictMono (f : α → β) (hf : StrictMono f)
    (pairs : List (α × α)) (rows : List (List α) := []) :
    pairInsertList (pairs.map fun p => (f p.1,f p.2)) (rows.map (List.map f)) =
      (pairInsertList pairs rows).map (List.map f) := by
  induction pairs generalizing rows with
  | nil => rfl
  | cons p pairs ih =>
    simpa only [List.map_cons,pairInsertList_cons,pairInsert_map_strictMono f hf] using
      ih (pairInsert p.1 p.2 rows)

theorem isRowAbove_map_iff_strictMono (f : α → β) (hf : StrictMono f)
    (upper lower : List α) :
    (upper.map f).IsRowAbove (lower.map f) ↔ upper.IsRowAbove lower := by
  constructor
  · intro h
    refine ⟨by simpa using h.length_le, ?_⟩
    intro j hu hl
    have hlt := h.getElem_lt j (by simpa using hu) (by simpa using hl)
    simpa only [List.getElem_map,hf.lt_iff_lt] using hlt
  · intro h
    refine ⟨by simpa using h.length_le, ?_⟩
    intro j hu hl
    have hlt := h.getElem_lt j (by simpa using hu) (by simpa using hl)
    simpa only [List.getElem_map] using hf hlt

theorem isTableauRows_map_iff_strictMono (f : α → β) (hf : StrictMono f)
    (rows : List (List α)) :
    (rows.map (List.map f)).IsTableauRows ↔ rows.IsTableauRows := by
  induction rows with
  | nil => simp
  | cons row rows ih =>
    rw [List.map_cons,List.isTableauRows_cons,List.isTableauRows_cons]
    have hs : (row.map f).SortedLE ↔ row.SortedLE := by
      simp only [List.sortedLE_iff_pairwise,List.pairwise_map,hf.le_iff_le]
    have hh : (rows.map (List.map f)).headD [] = (rows.headD []).map f := by
      cases rows <;> rfl
    have hn : row.map f ≠ [] ↔ row ≠ [] :=
      not_congr (List.map_eq_nil_iff (f := f) (l := row))
    rw [hn]
    simp only [hs,hh,isRowAbove_map_iff_strictMono f hf,ih]

