    (ha : a < k) (hrow : ∀ x ∈ row, x < k) :
    ∀ x ∈ (rowBump a row).1, x < k := by
  intro x hx
  have h := (rowBump_perm a row).mem_iff.mp (List.mem_append_left _ hx)
  exact (List.mem_cons.mp h).elim (fun heq => heq ▸ ha) (hrow x)

