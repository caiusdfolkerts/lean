are provided by the exact accepted `matching_foundation` import. -/

theorem relabelPairs_append (f : ℕ → ℕ) (u v : List (ℕ × ℕ)) :
    relabelPairs f (u ++ v) = relabelPairs f u ++ relabelPairs f v := by
  simp only [relabelPairs,List.map_append]

theorem endpointWord_perm {w v : List (ℕ × ℕ)} (h : w.Perm v) :
    (endpointWord w).Perm (endpointWord v) := by
  simpa only [endpointWord,List.flatMap_def] using
    (h.map (fun p => [p.1,p.2])).flatten

