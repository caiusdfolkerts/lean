    have ht : ∀ x ∈ rows.flatten, x < k := fun x hx => hrows x (List.mem_append_right _ hx)
    have hkrow := rowBump_of_forall_le k row (fun x hx => (hr x hx).le)
    have hp0 : pairInsert k (k+1) (row::rows) = (row++[k,k+1])::rows := by
      rw [pairInsert_cons_of_none rows (by rw [hkrow]),hkrow]
      simp only [List.append_assoc,List.singleton_append]
