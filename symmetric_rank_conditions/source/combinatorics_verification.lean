    (hw : MatchingWord (w++[(a,b)])) (hv : MatchingWord v)
    (hc : ConjugatesPartners (dualLetter k s) w v)
    (hm : k+2 ∈ endpointWord w)
    (ha : tripleTag k a = none) (hb : tripleTag k b = none) :
    MatchingWord (v++[(a,b)]) := by
