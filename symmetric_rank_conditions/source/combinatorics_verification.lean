/-- The partner involution, extended by the identity off the finite matching.
The matching itself, rather than a tableau statistic, determines this map. -/
noncomputable def partnerMap (w : List (ℕ × ℕ)) (x : ℕ) : ℕ := by
  classical
  exact if h : ∃ y, Partners w x y then h.choose else x

theorem partnerMap_fixed_of_not_mem {w : List (ℕ × ℕ)} {x : ℕ}
    (hx : x ∉ endpointWord w) : partnerMap w x = x := by
  classical
  have hn : ¬∃ y, Partners w x y := by
    rintro ⟨y,hy⟩
    exact hx hy.mem_left
  simp only [partnerMap, dif_neg hn]

/-- One-use chains automatically stay inside the actual finite matching. -/
theorem MatchingChains.IsChain.rows_mem_endpoints {w : List (ℕ × ℕ)}
    {C : Finset ℕ} (hC : MatchingChains.IsChain (partnerMap w) C)
    {x : ℕ} (hx : x ∈ C) : x ∈ endpointWord w := by
  by_contra hn
  have hfix := partnerMap_fixed_of_not_mem hn
  exact hC.oneUse x hx (hfix.symm ▸ hx)

theorem partnerMap_spec {w : List (ℕ × ℕ)} {x : ℕ}
    (hx : x ∈ endpointWord w) : Partners w x (partnerMap w x) := by
  classical
  have hex : ∃ y, Partners w x y := by
    obtain ⟨p,hp,rfl | rfl⟩ := mem_endpointWord.mp hx
    · exact ⟨p.2, Or.inl hp⟩
    · exact ⟨p.1, Or.inr hp⟩
  simpa only [partnerMap, dif_pos hex] using hex.choose_spec

theorem MatchingWord.partnerMap_eq {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    {x y : ℕ} (hp : Partners w x y) : partnerMap w x = y :=
  hw.partner_unique (partnerMap_spec hp.mem_left) hp

theorem MatchingWord.partnerMap_involutive {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) : Function.Involutive (partnerMap w) := by
  classical
  intro x
  by_cases hx : ∃ y, Partners w x y
  · obtain ⟨y,hy⟩ := hx
    rw [hw.partnerMap_eq hy, hw.partnerMap_eq hy.symm]
  · have hpx : partnerMap w x = x := by simp only [partnerMap, dif_neg hx]
    rw [hpx,hpx]

theorem MatchingWord.partnerMap_ne {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    {x : ℕ} (hx : x ∈ endpointWord w) : partnerMap w x ≠ x :=
  (hw.partner_ne (partnerMap_spec hx)).symm

/-- The checked insertion descent formula in the actual function representation. -/
theorem MatchingWord.descent_partnerMap {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    {k : ℕ} (hk : k ∈ endpointWord w) (hk' : k + 1 ∈ endpointWord w) :
    RowDescends k (k + 1) (pairInsertList w) ↔
      partnerMap w (k + 1) < partnerMap w k ∧ partnerMap w k ≠ k + 1 :=
  hw.descent (partnerMap_spec hk) (partnerMap_spec hk')

/-- A consecutive interval with no tableau descents contains at most one
vertex of any one-use decreasing chain. -/
theorem MatchingWord.chain_card_le_one_of_no_descents {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) {a b : ℕ}
    (hm : ∀ k, a ≤ k → k ≤ b → k ∈ endpointWord w)
    (hd : ∀ k, a ≤ k → k < b → ¬RowDescends k (k + 1) (pairInsertList w))
    {C : Finset ℕ} (hC : MatchingChains.IsChain (partnerMap w) C)
    (hsub : ∀ k ∈ C, a ≤ k ∧ k ≤ b) : C.card ≤ 1 := by
  apply MatchingChains.NoDescents.card_le_one hw.partnerMap_involutive _ hC hsub
  intro k hak hkb
  have hn := hd k hak hkb
  rw [hw.descent_partnerMap (hm k hak hkb.le)
    (hm (k + 1) (by omega) (by omega))] at hn
  by_cases hp : partnerMap w k = k + 1
  · exact Or.inr hp
  · left
    have hinj := hw.partnerMap_involutive.injective
    have hne : partnerMap w k ≠ partnerMap w (k + 1) := by
      intro he
      have := hinj he
      omega
    omega

/-- A prefix whose consecutive labels all descend in the paired tableau is
itself a one-use chain. No matching edge can be counted twice. -/
theorem MatchingWord.prefix_chain_of_descents {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) (h : ℕ)
    (hm : ∀ k < h, k ∈ endpointWord w)
    (hd : ∀ k, k + 1 < h → RowDescends k (k + 1) (pairInsertList w)) :
    MatchingChains.IsChain (partnerMap w) (Finset.range h) := by
  have hs : ∀ k, k + 1 < h →
      partnerMap w (k + 1) < partnerMap w k ∧ partnerMap w k ≠ k + 1 := by
    intro k hk
    exact (hw.descent_partnerMap (hm k (by omega)) (hm (k + 1) hk)).mp (hd k hk)
  have hdec : ∀ i < h, ∀ j < h, i < j → partnerMap w j < partnerMap w i := by
    intro i hi j hj hij
    induction j with
    | zero => omega
    | succ j ih =>
      by_cases he : i = j
      · subst j
        exact (hs i hj).1
      · have hij' : i < j := by omega
        exact ((hs j hj).1).trans (ih (by omega) hij')
  exact MatchingChains.decreasing_prefix_chain hw.partnerMap_involutive h hdec
    (fun i hi => hw.partnerMap_ne (hm i hi)) (fun i hi => (hs i hi).2)

