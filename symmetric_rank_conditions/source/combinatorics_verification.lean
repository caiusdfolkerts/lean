      exact ⟨D, hD, hc, hrect⟩
    · obtain ⟨D, hD, hc, he, hrect⟩ := e.used_high_repair hC ha hb hγC hhi
      exact ⟨D, hD, hc, hrect⟩
  · exact e.unused_repair hC ha hb hγC

/-- Reverse every external matching move on an actual one-use chain. The proof
handles row defects, column defects, and the unaffected case separately. -/
theorem reverse_chain {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C) :
    ∃ D : Finset ℕ, IsChain y D ∧ D.card = C.card ∧
      PreservesRectangles a y (conjugate (adjacent a) y) C D := by
