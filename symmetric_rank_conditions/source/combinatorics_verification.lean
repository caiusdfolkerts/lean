theorem conjugatesPartners_relabel (f : ℕ ≃ ℕ) (w : List (ℕ × ℕ)) :
    ConjugatesPartners f w (relabelPairs f w) := by
  intro x y
  have hpair (x y : ℕ) :
      (f x,f y) ∈ relabelPairs f w ↔ (x,y) ∈ w := by
    constructor
    · intro h
      obtain ⟨p,hp,hp'⟩ := List.mem_map.mp h
      have heq : p = (x,y) := Prod.ext
        (f.injective (congrArg Prod.fst hp'))
        (f.injective (congrArg Prod.snd hp'))
      simpa [heq] using hp
    · intro h
      exact List.mem_map.mpr ⟨(x,y),h,rfl⟩
  simp only [Partners,hpair]

