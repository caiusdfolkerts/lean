      ∃ (k : ℕ) (sizes : Fin k → ℕ) (a b : ∀ c, Fin (sizes c) ↪o Fin n),
        (∀ c, t ≤ sizes c) ∧ (∑ c, (sizes c-t+1)) = s ∧
