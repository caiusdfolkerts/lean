    (flatten_pairInsert_perm a (k+i.val) rows)).filterMap (tripleTag k)
  have hold := tripleFootprint_eq_nil_of_forall_lt hrows
  change rows.flatten.filterMap (tripleTag k) = [] at hold
  have ha' := tripleTag_eq_none_of_lt ha
  have hi := tripleTag_label k i
  simpa only [tripleFootprint,List.filterMap_append,List.filterMap_cons,
    List.filterMap_nil,ha',hi,List.nil_append,List.append_nil,hold,List.perm_singleton] using hp

