namespace FourPapers.Symmetric.MatchingChains

/-- A one-use decreasing chain is specified by its selected rows. Its partner
columns decrease strictly, and no matching edge is selected in both orientations. -/
structure IsChain (y : ℕ → ℕ) (C : Finset ℕ) : Prop where
  decreasing : ∀ r ∈ C, ∀ s ∈ C, r < s → y s < y r
  oneUse : ∀ r ∈ C, y r ∉ C

def conjugate (s : Equiv.Perm ℕ) (y : ℕ → ℕ) (r : ℕ) : ℕ :=
  s (y (s.symm r))

@[simp] theorem conjugate_apply_image (s : Equiv.Perm ℕ) (y : ℕ → ℕ) (r : ℕ) :
    conjugate s y (s r) = s (y r) := by
  simp [conjugate]

theorem IsChain.transpose {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C : Finset ℕ} (hC : IsChain y C) : IsChain y (C.image y) := by
  classical
  constructor
  · intro r hr s hs hrs
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hr
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hs
    rw [hy a, hy b]
    by_contra hba
    have hab : a < b := by
      by_cases hab : a = b
      · subst b; omega
      · omega
    have := hC.decreasing a ha b hb hab
    omega
  · intro r hr hbad
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hr
    obtain ⟨b, hb, hba⟩ := Finset.mem_image.mp hbad
    have hya : y a = b := by
      have hh := congrArg y hba
      rw [hy b, hy (y a)] at hh
      exact hh.symm
    exact hC.oneUse a ha (hya.symm ▸ hb)

theorem card_transpose {y : ℕ → ℕ} (hy : Function.Involutive y) (C : Finset ℕ) :
    (C.image y).card = C.card := Finset.card_image_of_injective _ hy.injective

/-- Relabeling preserves a chain whenever it preserves the order on both the
selected rows and the selected columns. -/
theorem IsChain.relabel {y : ℕ → ℕ} {C : Finset ℕ} (hC : IsChain y C)
    (s : Equiv.Perm ℕ)
    (hrow : ∀ a ∈ C, ∀ b ∈ C, a < b → s a < s b)
    (hcol : ∀ a ∈ C.image y, ∀ b ∈ C.image y, a < b → s a < s b) :
    IsChain (conjugate s y) (C.image s) := by
  classical
  constructor
  · intro r hr t ht hrt
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hr
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ht
    simp only [conjugate_apply_image]
    have hab : a < b := by
      by_contra h
      by_cases heq : a = b
      · subst b; omega
      · have hba : b < a := by omega
        have := hrow b hb a ha hba
        omega
    exact hcol (y b) (Finset.mem_image_of_mem _ hb)
      (y a) (Finset.mem_image_of_mem _ ha) (hC.decreasing a ha b hb hab)
  · intro r hr hbad
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hr
    rw [conjugate_apply_image] at hbad
    obtain ⟨b, hb, hba⟩ := Finset.mem_image.mp hbad
    have hba' : b = y a := s.injective hba
    exact hC.oneUse a ha (hba' ▸ hb)

def adjacent (a : ℕ) : Equiv.Perm ℕ := Equiv.swap a (a + 1)

@[simp] theorem adjacent_self (a : ℕ) : adjacent a a = a + 1 := by
  simp [adjacent]

@[simp] theorem adjacent_succ (a : ℕ) : adjacent a (a + 1) = a := by
  simp [adjacent]

theorem adjacent_lt_of_not_pair {a x z : ℕ} (hxz : x < z)
    (hpair : ¬(x = a ∧ z = a + 1)) : adjacent a x < adjacent a z := by
  simp only [adjacent, Equiv.swap_apply_def]
  split_ifs <;> omega

/-- The forward direction of each nonfixed move in Lemma 2.2. This statement
has no bound on the ambient matching or the length of the chain. -/
theorem IsChain.adjacent_forward {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C : Finset ℕ} (hC : IsChain y C) (a : ℕ) (hpartners : y a < y (a + 1)) :
    IsChain (conjugate (adjacent a) y) (C.image (adjacent a)) := by
  apply hC.relabel
  · intro x hx z hz hxz
    apply adjacent_lt_of_not_pair hxz
    rintro ⟨hx', hz'⟩
    subst x
    subst z
    have := hC.decreasing a hx (a + 1) hz (by omega)
    omega
  · intro x hx z hz hxz
    apply adjacent_lt_of_not_pair hxz
    rintro ⟨hx', hz'⟩
    subst x
    subst z
    have hT := hC.transpose hy
    have := hT.decreasing a hx (a + 1) hz (by omega)
    omega

@[simp] theorem adjacent_symm (a : ℕ) : (adjacent a).symm = adjacent a := by
  simp [adjacent]

@[simp] theorem adjacent_apply_twice (a r : ℕ) : adjacent a (adjacent a r) = r := by
  simp [adjacent]

theorem adjacent_apply_of_ne {a r : ℕ} (h₁ : r ≠ a) (h₂ : r ≠ a + 1) :
    adjacent a r = r := by
  simp [adjacent, Equiv.swap_apply_def, h₁, h₂]

theorem conjugate_involutive {y : ℕ → ℕ} (hy : Function.Involutive y)
    (s : Equiv.Perm ℕ) : Function.Involutive (conjugate s y) := by
  intro r
  simp only [conjugate, Equiv.symm_apply_apply]
  rw [hy (s.symm r), Equiv.apply_symm_apply]

@[simp] theorem conjugate_adjacent_twice (a : ℕ) (y : ℕ → ℕ) :
    conjugate (adjacent a) (conjugate (adjacent a) y) = y := by
  funext r
  simp [conjugate]

theorem conjugate_adjacent_fixed {y : ℕ → ℕ} {a r : ℕ}
    (hr₁ : r ≠ a) (hr₂ : r ≠ a + 1)
    (hy₁ : y r ≠ a) (hy₂ : y r ≠ a + 1) :
    conjugate (adjacent a) y r = y r := by
  simp only [conjugate, adjacent_symm]
  rw [adjacent_apply_of_ne hr₁ hr₂, adjacent_apply_of_ne hy₁ hy₂]

/-- No ordering defect remains if neither the selected rows nor selected columns
contains both labels interchanged by the adjacent transposition. -/
theorem IsChain.adjacent_unaffected {y : ℕ → ℕ} {C : Finset ℕ}
    (hC : IsChain y C) (a : ℕ)
    (hrow : ¬(a ∈ C ∧ a + 1 ∈ C))
    (hcol : ¬(a ∈ C.image y ∧ a + 1 ∈ C.image y)) :
    IsChain (conjugate (adjacent a) y) (C.image (adjacent a)) := by
  apply hC.relabel
  · intro x hx z hz hxz
    apply adjacent_lt_of_not_pair hxz
    rintro ⟨hx', hz'⟩
    subst x
    subst z
    exact hrow ⟨hx, hz⟩
  · intro x hx z hz hxz
    apply adjacent_lt_of_not_pair hxz
    rintro ⟨hx', hz'⟩
    subst x
    subst z
    exact hcol ⟨hx, hz⟩

/-- The row repair for the internal-edge move in (2.6). The three distinguished
labels are `a`, `a+1`, `a+2`; `g` is the external partner above all three. -/
theorem internal_row_repair {y : ℕ → ℕ} (hy : Function.Involutive y)
    {a g : ℕ} (hg : a + 2 < g) (ha : y a = a + 2) (hb : y (a + 1) = g)
    {C : Finset ℕ} (hC : IsChain (conjugate (adjacent a) y) C)
    (hCa : a ∈ C) (hCb : a + 1 ∈ C) :
    IsChain y (insert (a + 2) (C.erase a)) ∧
      (insert (a + 2) (C.erase a)).card = C.card := by
  classical
  let z := conjugate (adjacent a) y
  change IsChain z C at hC
  have hc : y (a + 2) = a := by simpa only [ha] using hy a
  have hγ : y g = a + 1 := by simpa only [hb] using hy (a + 1)
  have za : z a = g := by
    simp only [z, conjugate, adjacent_symm, adjacent_self, hb]
    exact adjacent_apply_of_ne (by omega) (by omega)
  have zb : z (a + 1) = a + 2 := by
    simp only [z, conjugate, adjacent_symm, adjacent_succ, ha]
    exact adjacent_apply_of_ne (by omega) (by omega)
  have hCγ : g ∉ C := by simpa only [← za] using hC.oneUse a hCa
  have hCc : a + 2 ∉ C := by simpa only [← zb] using hC.oneUse (a + 1) hCb
  have hsame : ∀ r ∈ C, r ≠ a → r ≠ a + 1 → z r = y r := by
    intro r hr hra hrb
    apply conjugate_adjacent_fixed hra hrb
    · intro h
      have : r = a + 2 := by have hh := congrArg y h; simpa only [hy r, ha] using hh
      exact hCc (this ▸ hr)
    · intro h
      have : r = g := by have hh := congrArg y h; simpa only [hy r, hb] using hh
      exact hCγ (this ▸ hr)
  constructor
  · constructor
    · intro r hr s hs hrs
      simp only [Finset.mem_insert, Finset.mem_erase] at hr hs
      rcases hr with rfl | ⟨hra, hr⟩
      · rcases hs with hsc | ⟨hsa, hs⟩
        · omega
        · have hsb : s ≠ a + 1 := by omega
          have hzs : z s < a + 2 := by
            simpa only [zb] using hC.decreasing (a + 1) hCb s hs (by omega)
          rw [hsame s hs hsa hsb] at hzs
          have hysa : y s ≠ a := by
            intro h
            have hh := congrArg y h
            have : s = a + 2 := by simpa only [hy s, ha] using hh
            omega
          have hysb : y s ≠ a + 1 := by
            intro h
            have hh := congrArg y h
            have : s = g := by simpa only [hy s, hb] using hh
            exact hCγ (this ▸ hs)
          rw [hc]
          omega
      · rcases hs with rfl | ⟨hsa, hs⟩
        · rw [hc]
          by_cases hrb : r = a + 1
          · subst r; rw [hb]; omega
          · have hrlt : r < a := by omega
            have hz : g < z r := by simpa only [za] using hC.decreasing r hr a hCa hrlt
            rw [hsame r hr hra hrb] at hz
            omega
        · by_cases hrb : r = a + 1
          · subst r
            have hsb : s ≠ a + 1 := by omega
            have hz : z s < g := by
              simpa only [za] using hC.decreasing a hCa s hs (by omega)
            simpa only [hsame s hs hsa hsb, hb] using hz
          · by_cases hsb : s = a + 1
            · subst s
              have hrlt : r < a := by omega
              have hz : g < z r := by
                simpa only [za] using hC.decreasing r hr a hCa hrlt
              simpa only [hsame r hr hra hrb, hb] using hz
            · simpa only [hsame r hr hra hrb, hsame s hs hsa hsb] using
                hC.decreasing r hr s hs hrs
    · intro r hr hbad
      simp only [Finset.mem_insert, Finset.mem_erase] at hr hbad
      rcases hr with rfl | ⟨hra, hr⟩
      · rw [hc] at hbad
        rcases hbad with hbad | ⟨hbad, _⟩ <;> omega
      · by_cases hrb : r = a + 1
        · subst r
          rw [hb] at hbad
          rcases hbad with hbad | ⟨_, hbad⟩
          · omega
          · exact hCγ hbad
        · rcases hbad with hbad | ⟨_, hbad⟩
          · have hh := congrArg y hbad
            have : r = a := by simpa only [hy r, hc] using hh
            exact hra this
          · exact hC.oneUse r hr ((hsame r hr hra hrb).symm ▸ hbad)
  · have hnew : a + 2 ∉ C.erase a := fun h => hCc (Finset.mem_erase.mp h).2
    rw [Finset.card_insert_of_notMem hnew, Finset.card_erase_of_mem hCa]
    have := Finset.card_pos.mpr ⟨a, hCa⟩
    omega

/-- Reverse the orientation of a chosen subset of selected matching edges. -/
def flip (y : ℕ → ℕ) (C E : Finset ℕ) : Finset ℕ :=
  (C \ E) ∪ E.image y

theorem oneUse_flip {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C E : Finset ℕ} (hE : E ⊆ C) (hC : ∀ r ∈ C, y r ∉ C) :
    ∀ r ∈ flip y C E, y r ∉ flip y C E := by
  classical
  intro r hr hb
  simp only [flip, Finset.mem_union, Finset.mem_sdiff, Finset.mem_image] at hr hb
  rcases hr with ⟨hrC, hrE⟩ | ⟨s, hs, rfl⟩
  · rcases hb with ⟨hbC, _⟩ | ⟨s, hs, heq⟩
    · exact hC r hrC hbC
    · have : s = r := hy.injective heq
      exact hrE (this ▸ hs)
  · rw [hy s] at hb
    rcases hb with ⟨_, hbE⟩ | ⟨t, ht, heq⟩
    · exact hbE hs
    · exact hC t (hE ht) (heq.symm ▸ hE hs)

theorem card_flip {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C E : Finset ℕ} (hE : E ⊆ C) (hC : ∀ r ∈ C, y r ∉ C) :
    (flip y C E).card = C.card := by
  classical
  have hdis : Disjoint (C \ E) (E.image y) := by
    apply Finset.disjoint_left.mpr
    intro r hr hr'
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr'
    exact hC s (hE hs) (Finset.mem_sdiff.mp hr).1
  rw [flip, Finset.card_union_of_disjoint hdis,
    Finset.card_image_of_injective _ hy.injective, Finset.card_sdiff_of_subset hE]
  have := Finset.card_le_card hE
  omega

/-- The endpoints owned by selected unoriented matching edges. -/
def endpoints (y : ℕ → ℕ) (C : Finset ℕ) : Finset ℕ := C ∪ C.image y

theorem endpoints_flip {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C E : Finset ℕ} (hE : E ⊆ C) :
    endpoints y (flip y C E) = endpoints y C := by
  classical
  ext r
  simp only [endpoints, flip, Finset.mem_union, Finset.mem_sdiff, Finset.mem_image]
  constructor
  · rintro ((⟨hr, _⟩ | ⟨s, hs, rfl⟩) | ⟨s, (⟨hs, _⟩ | ⟨t, ht, rfl⟩), rfl⟩)
    · exact Or.inl hr
    · exact Or.inr ⟨s, hE hs, rfl⟩
    · exact Or.inr ⟨s, hs, rfl⟩
    · exact Or.inl (by simpa only [hy t] using hE ht)
  · rintro (hr | ⟨s, hs, rfl⟩)
    · by_cases hrE : r ∈ E
      · exact Or.inr ⟨y r, Or.inr ⟨r, hrE, rfl⟩, hy r⟩
      · exact Or.inl (Or.inl ⟨hr, hrE⟩)
    · by_cases hsE : s ∈ E
      · exact Or.inl (Or.inr ⟨s, hsE, rfl⟩)
      · exact Or.inr ⟨s, Or.inl ⟨hs, hsE⟩, rfl⟩

/-- A finite colored packing of one-use chains. Disjoint endpoint sets express
that an unordered matching edge cannot be used in two different colors. -/
structure IsPacking {κ : Type*} (y : ℕ → ℕ) (P : κ → Finset ℕ) : Prop where
  chain : ∀ c, IsChain y (P c)
  disjoint : ∀ c d, c ≠ d → Disjoint (endpoints y (P c)) (endpoints y (P d))

/-- In the external move, the third matching edge can replace the left affected
edge when it is absent from the selected chain. -/
theorem external_unused_row_repair {y : ℕ → ℕ} (hy : Function.Involutive y)
    {a α β γ : ℕ} (hαγ : α < γ) (hγβ : γ < β)
    (ha : y a = α) (hb : y (a + 1) = β) (hc : y (a + 2) = γ)
    (hαext : α ≠ a ∧ α ≠ a + 1 ∧ α ≠ a + 2)
    (hβext : β ≠ a ∧ β ≠ a + 1 ∧ β ≠ a + 2)
    (hγext : γ ≠ a ∧ γ ≠ a + 1 ∧ γ ≠ a + 2)
    {C : Finset ℕ} (hC : IsChain (conjugate (adjacent a) y) C)
    (hCa : a ∈ C) (hCb : a + 1 ∈ C) (hCγ : γ ∉ C) :
    IsChain y (insert (a + 2) (C.erase a)) ∧
      (insert (a + 2) (C.erase a)).card = C.card := by
  classical
  let z := conjugate (adjacent a) y
  change IsChain z C at hC
  have hα : y α = a := by simpa only [ha] using hy a
  have hβ : y β = a + 1 := by simpa only [hb] using hy (a + 1)
  have hγ : y γ = a + 2 := by simpa only [hc] using hy (a + 2)
  have za : z a = β := by
    simp only [z, conjugate, adjacent_symm, adjacent_self, hb]
    exact adjacent_apply_of_ne hβext.1 hβext.2.1
  have zb : z (a + 1) = α := by
    simp only [z, conjugate, adjacent_symm, adjacent_succ, ha]
    exact adjacent_apply_of_ne hαext.1 hαext.2.1
  have zc : z (a + 2) = γ :=
    (conjugate_adjacent_fixed (by omega) (by omega)
      (by simpa only [hc] using hγext.1) (by simpa only [hc] using hγext.2.1)).trans hc
  have hCβ : β ∉ C := by simpa only [← za] using hC.oneUse a hCa
  have hCα : α ∉ C := by simpa only [← zb] using hC.oneUse (a + 1) hCb
  have hCc : a + 2 ∉ C := by
    intro h
    have hh := hC.decreasing (a + 1) hCb (a + 2) h (by omega)
    change z (a + 2) < z (a + 1) at hh
    rw [zc, zb] at hh
    omega
  have hsame : ∀ r ∈ C, r ≠ a → r ≠ a + 1 → z r = y r := by
    intro r hr hra hrb
    apply conjugate_adjacent_fixed hra hrb
    · intro h
      have : r = α := by have hh := congrArg y h; simpa only [hy r, ha] using hh
      exact hCα (this ▸ hr)
    · intro h
      have : r = β := by have hh := congrArg y h; simpa only [hy r, hb] using hh
      exact hCβ (this ▸ hr)
  constructor
  · constructor
    · intro r hr s hs hrs
      simp only [Finset.mem_insert, Finset.mem_erase] at hr hs
      rcases hr with rfl | ⟨hra, hr⟩
      · rcases hs with hsc | ⟨hsa, hs⟩
        · omega
        · have hsb : s ≠ a + 1 := by omega
          have hz : z s < α := by
            simpa only [zb] using hC.decreasing (a + 1) hCb s hs (by omega)
          rw [hsame s hs hsa hsb] at hz
          rw [hc]
          omega
      · rcases hs with rfl | ⟨hsa, hs⟩
        · rw [hc]
          by_cases hrb : r = a + 1
          · subst r; rw [hb]; exact hγβ
          · have hrlt : r < a := by omega
            have hz : β < z r := by simpa only [za] using hC.decreasing r hr a hCa hrlt
            rw [hsame r hr hra hrb] at hz
            omega
        · by_cases hrb : r = a + 1
          · subst r
            have hsb : s ≠ a + 1 := by omega
            have hz : z s < β := by
              simpa only [za] using hC.decreasing a hCa s hs (by omega)
            simpa only [hsame s hs hsa hsb, hb] using hz
          · by_cases hsb : s = a + 1
            · subst s
              have hrlt : r < a := by omega
              have hz : β < z r := by
                simpa only [za] using hC.decreasing r hr a hCa hrlt
              simpa only [hsame r hr hra hrb, hb] using hz
            · simpa only [hsame r hr hra hrb, hsame s hs hsa hsb] using
                hC.decreasing r hr s hs hrs
    · intro r hr hbad
      simp only [Finset.mem_insert, Finset.mem_erase] at hr hbad
      rcases hr with rfl | ⟨hra, hr⟩
      · rw [hc] at hbad
        rcases hbad with hbad | ⟨_, hbad⟩
        · exact hγext.2.2 hbad
        · exact hCγ hbad
      · by_cases hrb : r = a + 1
        · subst r
          rw [hb] at hbad
          rcases hbad with hbad | ⟨_, hbad⟩
          · exact hβext.2.2 hbad
          · exact hCβ hbad
        · rcases hbad with hbad | ⟨_, hbad⟩
          · have hh := congrArg y hbad
            have : r = γ := by simpa only [hy r, hc] using hh
            exact hCγ (this ▸ hr)
          · exact hC.oneUse r hr ((hsame r hr hra hrb).symm ▸ hbad)
  · have hnew : a + 2 ∉ C.erase a := fun h => hCc (Finset.mem_erase.mp h).2
    rw [Finset.card_insert_of_notMem hnew, Finset.card_erase_of_mem hCa]
    have := Finset.card_pos.mpr ⟨a, hCa⟩
    omega

end FourPapers.Symmetric.MatchingChains
