    | none =>
      have hle := (rowBump_snd_eq_none_iff c row).mp hb
      have hcb := rowBump_of_forall_le c row hle
      have hY : pairInsert k (k+2) (pairInsert c (k+1) (row::rows)) =
          (row++[c,k])::pairInsert (k+1) (k+2) rows := by
        rw [pairInsert_cons_of_none rows hb,hcb]
        simp only [List.append_assoc,List.singleton_append]
        have hb' : rowBump k (row++[c,k+1]) = (row++[c,k],some (k+1)) := by
          rw [rowBump_append k row _ (fun x hx => (hr x hx).le)]
