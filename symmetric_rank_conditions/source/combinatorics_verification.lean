    obtain ⟨q,hq,rfl⟩ := List.mem_map.mp hp
    exact hf (hS q.1 (mem_endpointWord.mpr ⟨q,hq,Or.inl rfl⟩))
      (hS q.2 (mem_endpointWord.mpr ⟨q,hq,Or.inr rfl⟩)) (hw.lower_lt_upper q hq)
  · apply List.pairwise_map.mpr
    apply hw.ordered.imp_of_mem
    intro p q hp hq hpq
    exact hf (hS p.2 (mem_endpointWord.mpr ⟨p,hp,Or.inr rfl⟩))
      (hS q.2 (mem_endpointWord.mpr ⟨q,hq,Or.inr rfl⟩)) hpq
  · rw [endpointWord_relabelPairs]
    exact hw.distinct.map f.injective

