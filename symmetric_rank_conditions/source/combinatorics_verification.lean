        rw [hp0]
        have hb' : rowBump c (row++[k,k+1]) = (row++[c,k+1],some k) := by
          rw [rowBump_append c row _ hle,rowBump_cons_of_lt _ hc]
        rw [pairInsert_cons_of_some rows (by rw [hb']),hb']
      rw [hY,hZ]
      have hf : tripleFootprint k (rowWordRows ((row++[c,k])::pairInsert (k+1) (k+2) rows)) =
          [1,2,0] := by
        rw [rowWordRows_cons,tripleFootprint_append,
