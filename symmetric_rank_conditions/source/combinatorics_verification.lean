    (hw : MatchingWord w) (hperm : v.Perm (relabelPairs f w))
    (hlt : ∀ p ∈ v, p.1 < p.2)
    (hordered : v.Pairwise (fun p q => p.2 < q.2)) : MatchingWord v := by
  refine ⟨hlt,hordered,?_⟩
  apply (endpointWord_perm hperm).nodup_iff.mpr
  rw [endpointWord_relabelPairs]
  exact hw.distinct.map f.injective

theorem ConjugatesPartners.append_fixed {f : ℕ ≃ ℕ} {w v : List (ℕ × ℕ)}
    (h : ConjugatesPartners f w v) {a b : ℕ} (ha : f a = a) (hb : f b = b) :
