    (hc : c < k) (hrows : ∀ x ∈ rows.flatten, x < k) :
    dualRows k (pairInsert c (k+2) (pairInsert k (k+1) rows)) =
      pairInsert k (k+2) (pairInsert c (k+1) rows) := by
  rw [←paired_internal_dual hc hrows,dualRows_involutive]

