            dsimp only [R] at hcbump
            have hqr : q ≤ r := rowBump_bumped_le_of_le hs hbc hbump hcbump
            have hrk : r < k := hR r (mem_of_rowBump_snd_eq_some hcbump)
            let S := (rowBump c R).1
            have hS : ∀ x ∈ S, x < k := rowBump_fst_lt hc hR
            have hy : firstRowProcess [(b,k),(a,k+1),(c,k+2)] (p::row) =
                (a::S,[(q,k),(p,k+1),(r,k+2)]) := by
              simp only [S,R,firstRowProcess,rowBump_cons_of_le _ hpb,hbump,
                rowBump_cons_of_lt _ hap,rowBump_cons_of_le _ hac.le,hcbump]
            have hz : firstRowProcess [(b,k),(c,k+1),(a,k+2)] (p::row) =
                (a::S,[(q,k),(r,k+1),(p,k+2)]) := by
              simp only [S,R,firstRowProcess,rowBump_cons_of_le _ hpb,hbump,
                rowBump_cons_of_le _ hpc,hcbump,rowBump_cons_of_lt _ hap]
            rw [pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hy,
              pairedTriple_of_firstRow _ _ _ _ _ _ _ _ hz]
            rw [dualRows_cons_low _ _ (by
              intro x hx
              exact (List.mem_cons.mp hx).elim (fun h => h ▸ ha) (hS x))]
            exact congrArg (List.cons (a::S)) (ih ht hm p q r hpq hqr hrk)
      · have hbp : b < p := lt_of_not_ge hpb
        cases hcbump : (rowBump c row).2 with
        | none =>
          let R := (rowBump c row).1
          have hR : ∀ x ∈ R, x < k := rowBump_fst_lt hc hlr
          have hy : firstRowProcess [(b,k),(a,k+1),(c,k+2)] (p::row) =
              ((a::R)++[k+2],[(p,k),(b,k+1)]) := by
            simp only [R,firstRowProcess,rowBump_cons_of_lt _ hbp,
              rowBump_cons_of_lt _ hab,rowBump_cons_of_le _ hac.le,hcbump]
          have hz : firstRowProcess [(b,k),(c,k+1),(a,k+2)] (p::row) =
              ((a::R)++[k+1],[(p,k),(b,k+2)]) := by
            simp only [R,firstRowProcess,rowBump_cons_of_lt _ hbp,
              rowBump_cons_of_le _ hbc,hcbump,List.cons_append,
