theorem tripleFootprint_appendToRow_label {k : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ x ∈ rows.flatten, x < k) (i : Fin 3) (r : ℕ) :
    tripleFootprint k (rowWordRows (appendToRow (k+i.val) r rows)) = [i] := by
  have hp := ((rowWordRows_perm_flatten _).trans
    (flatten_appendToRow_perm (k+i.val) r rows)).filterMap (tripleTag k)
  have hold := tripleFootprint_eq_nil_of_forall_lt hrows
  change rows.flatten.filterMap (tripleTag k) = [] at hold
  simpa only [tripleFootprint,List.filterMap_append,List.filterMap_cons,
    List.filterMap_nil,tripleTag_label,List.nil_append,List.append_nil,hold,
    List.perm_singleton] using hp

theorem tripleFootprint_appendToRow_two_labels {k : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ x ∈ rows.flatten, x < k) (i j : Fin 3) (r s : ℕ)
    (hr : r ≤ rows.length) (hs : s ≤ (appendToRow (k+i.val) r rows).length) :
    tripleFootprint k (rowWordRows
      (appendToRow (k+j.val) s (appendToRow (k+i.val) r rows))) =
      if s ≤ r then [i,j] else [j,i] := by
  induction rows generalizing r s with
  | nil =>
    have hr0 : r = 0 := by simpa using hr
    subst r
    have hs1 : s ≤ 1 := by simpa using hs
    rcases (show s = 0 ∨ s = 1 by omega) with rfl | rfl <;>
      simp [appendToRow_nil,appendToRow_zero_cons,appendToRow_succ_cons,
        rowWordRows_cons,rowWordRows_nil,tripleFootprint,tripleTag_label]
  | cons row rows ih =>
    have hrow : tripleFootprint k row = [] :=
      tripleFootprint_eq_nil_of_forall_lt (fun x hx => hrows x (List.mem_append_left _ hx))
    have htail : ∀ x ∈ rows.flatten, x < k :=
      fun x hx => hrows x (List.mem_append_right _ hx)
    have ht : tripleFootprint k (rowWordRows rows) = [] :=
      tripleFootprint_eq_nil_of_forall_lt (fun x hx => htail x ((mem_rowWordRows_iff x rows).mp hx))
    cases r with
    | zero =>
      cases s with
      | zero =>
        simp only [appendToRow_zero_cons,rowWordRows_cons,tripleFootprint_append,ht,hrow]
        simp [tripleFootprint,List.filterMap_cons,tripleTag_label]
      | succ s =>
        simp only [appendToRow_zero_cons,appendToRow_succ_cons,rowWordRows_cons,
          tripleFootprint_append,hrow,tripleFootprint_appendToRow_label htail]
        simp [tripleFootprint,List.filterMap_cons,tripleTag_label]
    | succ r =>
      cases s with
      | zero =>
        simp only [appendToRow_zero_cons,appendToRow_succ_cons,rowWordRows_cons,
          tripleFootprint_append,hrow,tripleFootprint_appendToRow_label htail]
        simp [tripleFootprint,List.filterMap_cons,tripleTag_label]
      | succ s =>
        simpa only [appendToRow_succ_cons,rowWordRows_cons,tripleFootprint_append,
          hrow,List.append_nil,Nat.succ_le_succ_iff] using
          ih htail r s (by simpa using hr) (by simpa using hs)

theorem rowInsert_all_lt {k a : ℕ} {rows : List (List ℕ)}
    (ha : a < k) (hrows : ∀ x ∈ rows.flatten, x < k) :
    ∀ x ∈ (rowInsert a rows).flatten, x < k := by
  intro x hx
  exact (mem_rowInsert.mp hx).elim (fun h => h ▸ ha) (hrows x)

theorem pairInsert_two_largest_eq {a c b d : ℕ} {rows : List (List ℕ)}
    (ha : a < b) (hc : c < b) (hmax : ∀ x ∈ rows.flatten, x < b) :
    let r := rowInsertIndex a rows
    let middle := rowInsert a rows
    let s := rowInsertIndex c middle
    pairInsert c d (pairInsert a b rows) =
      appendToRow d (if s = r then r+1 else s)
        (appendToRow b (if s = r then r+1 else r) (rowInsert c middle)) := by
  dsimp only
  have hr : rowInsertIndex a rows ≤ (rowInsert a rows).length :=
    (rowInsertIndex_le_length a rows).trans
      (by rw [length_rowInsert]; exact le_max_left _ _)
  unfold pairInsert
  rw [rowInsert_appendToRow hc (rowInsert_all_lt ha hmax) hr,
    rowInsertIndex_appendToRow hc (rowInsert_all_lt ha hmax) hr]

theorem map_dualLetter_two_largest {k a c : ℕ} {rows : List (List ℕ)}
    (ha : a < k) (hc : c < k) (hmax : ∀ x ∈ rows.flatten, x < k)
    (s i j : Fin 3) :
    (pairInsert c (k+j.val) (pairInsert a (k+i.val) rows)).map
      (List.map (dualLetter k s)) =
      pairInsert c (dualLetter k s (k+j.val))
        (pairInsert a (dualLetter k s (k+i.val)) rows) := by
  have ha' : a < k+i.val := ha.trans_le (Nat.le_add_right _ _)
  have hc' : c < k+i.val := hc.trans_le (Nat.le_add_right _ _)
  have hm' : ∀ x ∈ rows.flatten, x < k+i.val :=
    fun x hx => (hmax x hx).trans_le (Nat.le_add_right _ _)
  have hbound : k ≤ dualLetter k s (k+i.val) := by
    rw [dualLetter_label]
    exact Nat.le_add_right _ _
  rw [pairInsert_two_largest_eq ha' hc' hm',
    pairInsert_two_largest_eq (ha.trans_le hbound) (hc.trans_le hbound)
      (fun x hx => (hmax x hx).trans_le hbound),
    map_appendToRow,map_appendToRow,
    map_dualLetter_low_rows (rowInsert_all_lt hc (rowInsert_all_lt ha hmax))]

/-- The exact relative reading order of the two newly inserted largest endpoints.
It follows from the actual bumping-index comparison, and allows arbitrary gaps
between the endpoint labels. -/
theorem tripleFootprint_two_largest {k a c : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ row ∈ rows, row.SortedLE)
    (ha : a < k) (hc : c < k) (hmax : ∀ x ∈ rows.flatten, x < k)
    (i j : Fin 3) (hij : i < j) :
    tripleFootprint k (rowWordRows (pairInsert c (k+j.val)
      (pairInsert a (k+i.val) rows))) = if a ≤ c then [i,j] else [j,i] := by
  let middle := rowInsert a rows
  let previous := rowInsert c middle
  let r := rowInsertIndex a rows
  let s := rowInsertIndex c middle
  have hr : r ≤ middle.length := (rowInsertIndex_le_length a rows).trans
    (by dsimp [middle]; rw [length_rowInsert]; exact le_max_left _ _)
  have hm := rowInsert_all_lt ha hmax
  have hp := rowInsert_all_lt hc hm
  have hck : c < k+i.val := hc.trans_le (Nat.le_add_right _ _)
  have hmk : ∀ x ∈ middle.flatten, x < k+i.val :=
    fun x hx => (hm x hx).trans_le (Nat.le_add_right _ _)
  have hrew : pairInsert c (k+j.val) (pairInsert a (k+i.val) rows) =
      appendToRow (k+j.val) (if s = r then r+1 else s)
        (appendToRow (k+i.val) (if s = r then r+1 else r) previous) := by
    unfold pairInsert
    rw [rowInsert_appendToRow hck hmk hr,rowInsertIndex_appendToRow hck hmk hr]
  have hr' : (if s = r then r+1 else r) ≤ previous.length := le_length_rowInsert c hr
  have hs' : (if s = r then r+1 else s) ≤
      (appendToRow (k+i.val) (if s = r then r+1 else r) previous).length := by
    rw [length_appendToRow _ hr']
    have hs : s ≤ previous.length := by
      dsimp only [s,previous]
      rw [length_rowInsert]
      exact (rowInsertIndex_le_length c middle).trans (le_max_left _ _)
    split_ifs <;> omega
  rw [hrew,tripleFootprint_appendToRow_two_labels hp i j _ _ hr' hs']
  have hcmp : s ≤ r ↔ a ≤ c := rowInsertIndex_le_iff hrows a c
  by_cases hsr : s = r
  · have hac : a ≤ c := hcmp.mp hsr.le
    simp only [hsr,ite_true,le_refl,hac]
  · simp only [if_neg hsr,hcmp]

theorem dualRows_two_largest_top {k a c : ℕ} {rows : List (List ℕ)}
    (hrows : ∀ row ∈ rows, row.SortedLE)
    (ha : a < k) (hc : c < k) (hmax : ∀ x ∈ rows.flatten, x < k)
    (row : List ℕ) (hrow : ∀ x ∈ row, x < k)
    (i j h s : Fin 3) (hij : i < j)
    (hs : dualSelector ((if a ≤ c then [i,j] else [j,i]) ++ [h]) = s) :
    dualRows k ((row++[k+h.val]) ::
      pairInsert c (k+j.val) (pairInsert a (k+i.val) rows)) =
      (row++[dualLetter k s (k+h.val)]) ::
        pairInsert c (dualLetter k s (k+j.val))
          (pairInsert a (dualLetter k s (k+i.val)) rows) := by
  have hf : tripleFootprint k (rowWordRows ((row++[k+h.val]) ::
      pairInsert c (k+j.val) (pairInsert a (k+i.val) rows))) =
      (if a ≤ c then [i,j] else [j,i]) ++ [h] := by
    rw [rowWordRows_cons,tripleFootprint_append,
      tripleFootprint_two_largest hrows ha hc hmax i j hij,
      tripleFootprint_low_append row _ hrow]
    simp only [tripleFootprint,List.filterMap_cons,List.filterMap_nil,tripleTag_label]
  unfold dualRows
  rw [hf,hs,List.map_cons,List.map_append,
    map_dualLetter_eq_self (tripleFootprint_eq_nil_of_forall_lt hrow),
    map_dualLetter_two_largest ha hc hmax]
  rfl

end FourPapers.Symmetric

