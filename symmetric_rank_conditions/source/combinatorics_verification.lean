/-- The internal-edge configuration (2.6), with its external partner above the
three distinguished consecutive labels. -/
structure InternalMove (y : ℕ → ℕ) (a γ : ℕ) : Prop where
  involution : Function.Involutive y
  left : y a = a + 2
  middle : y (a + 1) = γ
  above : a + 2 < γ

namespace InternalMove

variable {y : ℕ → ℕ} {a γ : ℕ} (e : InternalMove y a γ)

include e

theorem right : y (a + 2) = a := by
  simpa only [e.left] using e.involution a

theorem partner : y γ = a + 1 := by
  simpa only [e.middle] using e.involution (a + 1)

theorem conjugate_left : conjugate (adjacent a) y a = γ := by
  simp only [conjugate, adjacent_symm, adjacent_self, e.middle]
  exact adjacent_apply_of_ne (by have := e.above; omega) (by have := e.above; omega)

theorem conjugate_middle : conjugate (adjacent a) y (a + 1) = a + 2 := by
  simp only [conjugate, adjacent_symm, adjacent_succ, e.left]
  exact adjacent_apply_of_ne (by omega) (by omega)

theorem excluded_partners {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) : γ ∉ C ∧ a + 2 ∉ C := by
  exact ⟨by simpa only [e.conjugate_left] using hC.oneUse a ha,
    by simpa only [e.conjugate_middle] using hC.oneUse (a + 1) hb⟩

theorem same_on_chain {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) {r : ℕ} (hr : r ∈ C)
    (hra : r ≠ a) (hrb : r ≠ a + 1) :
    conjugate (adjacent a) y r = y r := by
  have hex := e.excluded_partners hC ha hb
  apply conjugate_adjacent_fixed hra hrb
  · intro h
    have hh := congrArg y h
    rw [e.involution r, e.left] at hh
    exact hex.2 (hh ▸ hr)
  · intro h
    have hh := congrArg y h
    rw [e.involution r, e.middle] at hh
    exact hex.1 (hh ▸ hr)

/-- The exact repair replaces the first selected distinguished row by the third.
It preserves the represented unordered endpoint set, as well as chain length. -/
theorem row_repair {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C) :
    ∃ D : Finset ℕ, IsChain y D ∧ D.card = C.card ∧
      endpoints y D = endpoints (conjugate (adjacent a) y) C ∧
      PreservesRectangles a y (conjugate (adjacent a) y) C D := by
  let D := insert (a + 2) (C.erase a)
  obtain ⟨hD, hcard⟩ := internal_row_repair e.involution e.above e.left e.middle hC ha hb
  refine ⟨D, hD, hcard, ?_, ?_⟩
  · ext r
    simp only [D, endpoints, Finset.image_insert, Finset.mem_union, Finset.mem_insert,
      Finset.mem_image]
    constructor
    · rintro ((rfl | hr) | heq | ⟨s, hs, rfl⟩)
      · exact Or.inr ⟨a + 1, hb, e.conjugate_middle⟩
      · exact Or.inl (Finset.mem_erase.mp hr).2
      · rw [e.right] at heq
        exact Or.inl (heq ▸ ha)
      · obtain ⟨hsa, hs⟩ := Finset.mem_erase.mp hs
        by_cases hsb : s = a + 1
        · subst s
          exact Or.inr ⟨a, ha, e.conjugate_left.trans e.middle.symm⟩
        · exact Or.inr ⟨s, hs, e.same_on_chain hC ha hb hs hsa hsb⟩
    · rintro (hr | ⟨s, hs, rfl⟩)
      · by_cases hra : r = a
        · right
          left
          exact hra.trans e.right.symm
        · exact Or.inl (Or.inr (Finset.mem_erase.mpr ⟨hra, hr⟩))
      · by_cases hsa : s = a
        · subst s
          refine Or.inr (Or.inr ⟨a + 1, Finset.mem_erase.mpr ⟨by omega, hb⟩, ?_⟩)
          exact e.middle.trans e.conjugate_left.symm
        · by_cases hsb : s = a + 1
          · subst s
            exact Or.inl (Or.inl e.conjugate_middle)
          · exact Or.inr (Or.inr ⟨s, Finset.mem_erase.mpr ⟨hsa, hs⟩,
              (e.same_on_chain hC ha hb hs hsa hsb).symm⟩)
  · intro L M hL hM haL hbL hcL haM hbM hcM hrect r hr
    rcases Finset.mem_insert.mp hr with rfl | hr
    · exact ⟨hcL, by simpa only [e.right] using haM⟩
    · obtain ⟨hra, hr⟩ := Finset.mem_erase.mp hr
      refine ⟨(hrect r hr).1, ?_⟩
      by_cases hrb : r = a + 1
      · subst r
        rw [e.middle]
        simpa only [e.conjugate_left] using (hrect a ha).2
      · rw [← e.same_on_chain hC ha hb hr hra hrb]
        exact (hrect r hr).2

/-- Reverse the internal move on an arbitrary one-use chain, preserving all
interval rectangles that contain its distinguished labels. -/
theorem reverse_chain {C : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C) :
    ∃ D : Finset ℕ, IsChain y D ∧ D.card = C.card ∧
      PreservesRectangles a y (conjugate (adjacent a) y) C D := by
  classical
  let z := conjugate (adjacent a) y
  have hz : Function.Involutive z := conjugate_involutive e.involution (adjacent a)
  by_cases hrow : a ∈ C ∧ a + 1 ∈ C
  · obtain ⟨D, hD, hc, he, hrect⟩ := e.row_repair hC hrow.1 hrow.2
    exact ⟨D, hD, hc, hrect⟩
  by_cases hcol : a ∈ C.image z ∧ a + 1 ∈ C.image z
  · obtain ⟨E, hE, hcard, he, hrect⟩ := e.row_repair (hC.transpose hz) hcol.1 hcol.2
    refine ⟨E.image y, hE.transpose e.involution, ?_, ?_⟩
    · rw [card_transpose e.involution, hcard, card_transpose hz]
    · intro L M hL hM haL hbL hcL haM hbM hcM hCrect
      have hErect := hrect M L hM hL haM hbM hcM haL hbL hcL (hCrect.transpose hz)
      exact hErect.transpose e.involution
  · let D := C.image (adjacent a)
    have hD := hC.adjacent_unaffected a hrow hcol
    rw [conjugate_adjacent_twice] at hD
    refine ⟨D, hD, Finset.card_image_of_injective _ (adjacent a).injective, ?_⟩
    intro L M hL hM haL hbL hcL haM hbM hcM hrect
    have hr := hrect.adjacent a haL hbL haM hbM
    rwa [conjugate_adjacent_twice] at hr

theorem chain_exists_iff (L M : Set ℕ) (hL : IsInterval L) (hM : IsInterval M)
    (haL : a ∈ L) (hbL : a + 1 ∈ L) (hcL : a + 2 ∈ L)
    (haM : a ∈ M) (hbM : a + 1 ∈ M) (hcM : a + 2 ∈ M) (q : ℕ) :
