/-- Strict antitonicity on the selected finite row set. -/
def Decreases (y : ℕ → ℕ) (C : Finset ℕ) : Prop :=
  ∀ r ∈ C, ∀ s ∈ C, r < s → y s < y r

theorem Decreases.mono {y : ℕ → ℕ} {C D : Finset ℕ}
    (h : Decreases y C) (hDC : D ⊆ C) : Decreases y D :=
  fun r hr s hs hrs => h r (hDC hr) s (hDC hs) hrs

theorem decreases_singleton (y : ℕ → ℕ) (r : ℕ) : Decreases y {r} := by
  intro s hs t ht hst
  simp only [Finset.mem_singleton] at hs ht
  omega

theorem Decreases.union {y : ℕ → ℕ} {C D : Finset ℕ}
    (hC : Decreases y C) (hD : Decreases y D)
    (hcross : ∀ r ∈ C, ∀ s ∈ D, r < s ∧ y s < y r) : Decreases y (C ∪ D) := by
  intro r hr s hs hrs
  rcases Finset.mem_union.mp hr with hr | hr
  · rcases Finset.mem_union.mp hs with hs | hs
    · exact hC r hr s hs hrs
    · exact (hcross r hr s hs).2
  · rcases Finset.mem_union.mp hs with hs | hs
    · have := (hcross s hs r hr).1
      omega
    · exact hD r hr s hs hrs

theorem IsChain.congr_on {y z : ℕ → ℕ} {C : Finset ℕ}
    (hC : IsChain z C) (h : ∀ r ∈ C, z r = y r) : IsChain y C := by
  constructor
  · intro r hr s hs hrs
    have hh := hC.decreasing r hr s hs hrs
    rwa [h r hr, h s hs] at hh
  · intro r hr hbad
    rw [← h r hr] at hbad
    exact hC.oneUse r hr hbad

theorem oneUse_iff_endpoints_card {y : ℕ → ℕ} (hy : Function.Involutive y)
    (C : Finset ℕ) :
    (∀ r ∈ C, y r ∉ C) ↔ (endpoints y C).card = 2 * C.card := by
  classical
  have himage : (C.image y).card = C.card := Finset.card_image_of_injective _ hy.injective
  constructor
  · intro h
    have hd : Disjoint C (C.image y) := by
      apply Finset.disjoint_left.mpr
      intro r hr hr'
      obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr'
      exact h s hs hr
    rw [endpoints, Finset.card_union_of_disjoint hd, himage]
    omega
  · intro hc
    have hd : Disjoint C (C.image y) := by
      apply Finset.card_union_eq_card_add_card.mp
      rw [himage]
      change (endpoints y C).card = C.card + C.card
      omega
    intro r hr hbad
    exact Finset.disjoint_left.mp hd hbad (Finset.mem_image_of_mem _ hr)

theorem endpoints_card_le {y : ℕ → ℕ} (hy : Function.Involutive y) (C : Finset ℕ) :
    (endpoints y C).card ≤ 2 * C.card := by
  have h := Finset.card_union_le C (C.image y)
  rw [Finset.card_image_of_injective _ hy.injective] at h
  change (endpoints y C).card ≤ C.card + C.card at h
  omega

/-- Equality in the elementary endpoint-count bound proves both one-use
conditions and disjointness. This lets a two-tail switch be audited through its
exact endpoint union and total cardinality. -/
theorem chains_disjoint_of_endpoint_card {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C D : Finset ℕ} (hC : Decreases y C) (hD : Decreases y D)
    (hc : (endpoints y C ∪ endpoints y D).card = 2 * (C.card + D.card)) :
    IsChain y C ∧ IsChain y D ∧ Disjoint (endpoints y C) (endpoints y D) := by
  have hCbound := endpoints_card_le hy C
  have hDbound := endpoints_card_le hy D
  have hunion := Finset.card_union_le (endpoints y C) (endpoints y D)
  have hCe : (endpoints y C).card = 2 * C.card := by omega
  have hDe : (endpoints y D).card = 2 * D.card := by omega
  refine ⟨⟨hC, (oneUse_iff_endpoints_card hy C).mpr hCe⟩,
    ⟨hD, (oneUse_iff_endpoints_card hy D).mpr hDe⟩, ?_⟩
  apply Finset.card_union_eq_card_add_card.mp
  rw [hCe, hDe, hc]
  omega

theorem endpoints_union_card {y : ℕ → ℕ} (hy : Function.Involutive y)
    {C D : Finset ℕ} (hC : IsChain y C) (hD : IsChain y D)
    (hd : Disjoint (endpoints y C) (endpoints y D)) :
    (endpoints y C ∪ endpoints y D).card = 2 * (C.card + D.card) := by
  rw [Finset.card_union_of_disjoint hd,
    (oneUse_iff_endpoints_card hy C).mp hC.oneUse,
    (oneUse_iff_endpoints_card hy D).mp hD.oneUse]
  omega

theorem card_separated_insert (l : ℕ) {C D : Finset ℕ}
    (hC : ∀ r ∈ C, r < l) (hD : ∀ r ∈ D, l < r) :
    (C ∪ insert l D).card = C.card + D.card + 1 := by
  have hlD : l ∉ D := by intro hl; have := hD l hl; omega
  have hd : Disjoint C (insert l D) := by
    apply Finset.disjoint_left.mpr
    intro r hr hr'
    have := hC r hr
    rcases Finset.mem_insert.mp hr' with rfl | hr'
    · omega
    · have := hD r hr'; omega
  rw [Finset.card_union_of_disjoint hd, Finset.card_insert_of_notMem hlD]
  omega

theorem card_separated_two (l u : ℕ) {C D : Finset ℕ}
    (hlu : l < u) (hC : ∀ r ∈ C, r < l) (hD : ∀ r ∈ D, u < r) :
    (C ∪ insert l (insert u D)).card = C.card + D.card + 2 := by
  have hrest : ∀ r ∈ insert u D, l < r := by
    intro r hr
    rcases Finset.mem_insert.mp hr with rfl | hr
    · exact hlu
    · exact hlu.trans (hD r hr)
  rw [card_separated_insert l hC hrest,
    Finset.card_insert_of_notMem (by intro hu; have := hD u hu; omega)]
  omega

theorem Decreases.frame_one {y : ℕ → ℕ} {C D : Finset ℕ}
    (hC : Decreases y C) (hD : Decreases y D) (l : ℕ)
    (hleft : ∀ r ∈ C, r < l ∧ y l < y r)
    (hright : ∀ r ∈ D, l < r ∧ y r < y l) :
    Decreases y (C ∪ insert l D) := by
  have hr : Decreases y ({l} ∪ D) := (decreases_singleton y l).union hD (by
    intro r hr s hs
    have heq := Finset.mem_singleton.mp hr
    subst r
    exact hright s hs)
  have hh := hC.union hr (by
    intro r hr s hs
    have hl := hleft r hr
    rcases Finset.mem_union.mp hs with hs | hs
    · have heq := Finset.mem_singleton.mp hs
      subst s
      exact hl
    · have hs' := hright s hs
      exact ⟨hl.1.trans hs'.1, hs'.2.trans hl.2⟩)
  simpa only [Finset.singleton_union] using hh

theorem Decreases.frame_two {y : ℕ → ℕ} {C D : Finset ℕ}
    (hC : Decreases y C) (hD : Decreases y D) (l u : ℕ)
    (hlu : l < u) (hyul : y u < y l)
    (hleft : ∀ r ∈ C, r < l ∧ y l < y r)
    (hright : ∀ r ∈ D, u < r ∧ y r < y u) :
    Decreases y (C ∪ insert l (insert u D)) := by
  have hu : Decreases y (insert u D) := by
    have hh := (decreases_singleton y u).union hD (by
      intro r hr s hs
      have heq := Finset.mem_singleton.mp hr
      subst r
      exact hright s hs)
    simpa only [Finset.singleton_union] using hh
  apply hC.frame_one hu l hleft
  intro r hr
  rcases Finset.mem_insert.mp hr with rfl | hr
  · exact ⟨hlu, hyul⟩
  · have hh := hright r hr
    exact ⟨hlu.trans hh.1, hh.2.trans hyul⟩

theorem endpoints_union (y : ℕ → ℕ) (C D : Finset ℕ) :
    endpoints y (C ∪ D) = endpoints y C ∪ endpoints y D := by
  classical
  ext r
  simp only [endpoints, Finset.image_union, Finset.mem_union]
  tauto


/-- Transposition changes only orientations, so it preserves the exact endpoint
set represented by a one-use chain. -/
theorem endpoints_transpose {y : ℕ → ℕ} (hy : Function.Involutive y) (C : Finset ℕ) :
    endpoints y (C.image y) = endpoints y C := by
  classical
  ext r
  simp only [endpoints, Finset.mem_union, Finset.mem_image]
  constructor
  · rintro (⟨s, hs, rfl⟩ | ⟨s, ⟨t, ht, rfl⟩, rfl⟩)
    · exact Or.inr ⟨s, hs, rfl⟩
    · exact Or.inl (by simpa only [hy t] using ht)
  · rintro (hr | ⟨s, hs, rfl⟩)
    · exact Or.inr ⟨y r, ⟨r, hr, rfl⟩, hy r⟩
    · exact Or.inl ⟨s, hs, rfl⟩

theorem mem_endpoints_partner_iff {y : ℕ → ℕ} (hy : Function.Involutive y)
    (C : Finset ℕ) (r : ℕ) : y r ∈ endpoints y C ↔ r ∈ endpoints y C := by
  classical
  simp only [endpoints, Finset.mem_union, Finset.mem_image]
  constructor
  · rintro (hr | ⟨s, hs, heq⟩)
    · exact Or.inr ⟨y r, hr, hy r⟩
    · exact Or.inl (hy.injective heq ▸ hs)
  · rintro (hr | ⟨s, hs, heq⟩)
    · exact Or.inr ⟨r, hr, rfl⟩
    · have hh := congrArg y heq
      rw [hy s] at hh
      exact Or.inl (hh ▸ hs)

theorem endpoints_relabel (s : Equiv.Perm ℕ) (y : ℕ → ℕ) (C : Finset ℕ) :
    endpoints (conjugate s y) (C.image s) = (endpoints y C).image s := by
  classical
  simp only [endpoints, Finset.image_union]
  congr 1
  rw [Finset.image_image, Finset.image_image]
  apply Finset.image_congr
  intro r hr
  exact conjugate_apply_image s y r

noncomputable def packingSize {κ : Type*} [Fintype κ] (P : κ → Finset ℕ) : ℕ :=
  ∑ c, (P c).card

theorem IsPacking.transpose {κ : Type*} {y : ℕ → ℕ} (hy : Function.Involutive y)
    {P : κ → Finset ℕ} (hP : IsPacking y P) : IsPacking y (fun c => (P c).image y) := by
  constructor
  · intro c; exact (hP.chain c).transpose hy
  · intro c d hcd
    simpa only [endpoints_transpose hy] using hP.disjoint c d hcd

theorem packingSize_transpose {κ : Type*} [Fintype κ] {y : ℕ → ℕ}
    (hy : Function.Involutive y) (P : κ → Finset ℕ) :
    packingSize (fun c => (P c).image y) = packingSize P := by
  unfold packingSize
  apply Finset.sum_congr rfl
  intro c hc
  exact card_transpose hy (P c)

theorem IsPacking.adjacent_forward {κ : Type*} {y : ℕ → ℕ}
    (hy : Function.Involutive y) {P : κ → Finset ℕ} (hP : IsPacking y P)
    (a : ℕ) (hpartners : y a < y (a + 1)) :
    IsPacking (conjugate (adjacent a) y) (fun c => (P c).image (adjacent a)) := by
  constructor
  · intro c; exact (hP.chain c).adjacent_forward hy a hpartners
  · intro c d hcd
    rw [endpoints_relabel, endpoints_relabel]
    exact (Finset.disjoint_image (adjacent a).injective).mpr (hP.disjoint c d hcd)

theorem packingSize_relabel {κ : Type*} [Fintype κ]
    (s : Equiv.Perm ℕ) (P : κ → Finset ℕ) :
    packingSize (fun c => (P c).image s) = packingSize P := by
  unfold packingSize
  apply Finset.sum_congr rfl
  intro c hc
  exact Finset.card_image_of_injective _ s.injective

/-- Replacing one color, with explicit endpoint separation, preserves a packing. -/
theorem IsPacking.replace_one {κ : Type*} [DecidableEq κ] {y z : ℕ → ℕ}
    {P : κ → Finset ℕ} (hP : IsPacking z P) (r : κ) (D : Finset ℕ)
    (hD : IsChain y D)
    (hothers : ∀ c, c ≠ r → IsChain y (P c) ∧ endpoints y (P c) = endpoints z (P c))
    (hdis : ∀ c, c ≠ r → Disjoint (endpoints y D) (endpoints y (P c))) :
    IsPacking y (Function.update P r D) := by
  constructor
  · intro c
    by_cases hcr : c = r
    · subst c; simpa only [Function.update_self] using hD
    · simpa only [Function.update_of_ne hcr] using (hothers c hcr).1
  · intro c d hcd
    by_cases hcr : c = r
    · subst c
      have hdr : d ≠ r := Ne.symm hcd
      simpa only [Function.update_self, Function.update_of_ne hdr] using hdis d hdr
    · by_cases hdr : d = r
      · subst d
        simpa only [Function.update_self, Function.update_of_ne hcr] using (hdis c hcr).symm
      · simp only [Function.update_of_ne hcr, Function.update_of_ne hdr,
          (hothers c hcr).2, (hothers d hdr).2]
        exact hP.disjoint c d hcd

theorem packingSize_replace_one {κ : Type*} [Fintype κ] [DecidableEq κ]
    (P : κ → Finset ℕ) (r : κ) (D : Finset ℕ) (hc : D.card = (P r).card) :
    packingSize (Function.update P r D) = packingSize P := by
  unfold packingSize
  apply Finset.sum_congr rfl
  intro c hmem
  by_cases hcr : c = r
  · subst c; simpa only [Function.update_self] using hc
  · simp only [Function.update_of_ne hcr]

/-- A two-coordinate sum replacement needs only equality of the two affected
summands and literal equality everywhere else. -/
theorem sum_eq_of_two_coordinates {κ : Type*} [Fintype κ] [DecidableEq κ]
    (f g : κ → ℕ) (r s : κ) (hrs : r ≠ s)
    (hpair : f r + f s = g r + g s)
    (hothers : ∀ c, c ≠ r → c ≠ s → f c = g c) :
    (∑ c, f c) = ∑ c, g c := by
  have hr : r ∈ (Finset.univ : Finset κ) := Finset.mem_univ r
  have hs : s ∈ (Finset.univ : Finset κ).erase r := Finset.mem_erase.mpr ⟨Ne.symm hrs, Finset.mem_univ s⟩
  have hf₁ := Finset.sum_erase_add (Finset.univ : Finset κ) f hr
  have hg₁ := Finset.sum_erase_add (Finset.univ : Finset κ) g hr
  have hf₂ := Finset.sum_erase_add ((Finset.univ : Finset κ).erase r) f hs
  have hg₂ := Finset.sum_erase_add ((Finset.univ : Finset κ).erase r) g hs
  have hrest : (∑ c ∈ ((Finset.univ : Finset κ).erase r).erase s, f c) =
      ∑ c ∈ ((Finset.univ : Finset κ).erase r).erase s, g c := by
    apply Finset.sum_congr rfl
    intro c hc
    have hcs := Finset.mem_erase.mp hc
    exact hothers c (Finset.mem_erase.mp hcs.2).1 hcs.1
  omega


/-- A two-color replacement with an unchanged endpoint union preserves all
separations from the remaining colors. -/
theorem IsPacking.replace_two {κ : Type*} [DecidableEq κ] {y z : ℕ → ℕ}
    {P : κ → Finset ℕ} (hP : IsPacking z P) (r s : κ) (hrs : r ≠ s)
    (C D : Finset ℕ) (hC : IsChain y C) (hD : IsChain y D)
    (hCD : Disjoint (endpoints y C) (endpoints y D))
    (hends : endpoints y C ∪ endpoints y D ⊆ endpoints z (P r) ∪ endpoints z (P s))
    (hothers : ∀ c, c ≠ r → c ≠ s →
      IsChain y (P c) ∧ endpoints y (P c) = endpoints z (P c)) :
    IsPacking y (fun c => if c = r then C else if c = s then D else P c) := by
  have hseparate : ∀ c, c ≠ r → c ≠ s →
      Disjoint (endpoints y C ∪ endpoints y D) (endpoints y (P c)) := by
    intro c hcr hcs
    apply Finset.disjoint_left.mpr
    intro x hx hx'
    rw [(hothers c hcr hcs).2] at hx'
    rcases Finset.mem_union.mp (hends hx) with hxr | hxs
    · exact Finset.disjoint_left.mp (hP.disjoint r c (Ne.symm hcr)) hxr hx'
    · exact Finset.disjoint_left.mp (hP.disjoint s c (Ne.symm hcs)) hxs hx'
  have hCother : ∀ c, c ≠ r → c ≠ s → Disjoint (endpoints y C) (endpoints y (P c)) := by
    intro c hcr hcs
    apply Finset.disjoint_left.mpr
    intro x hx hx'
    exact Finset.disjoint_left.mp (hseparate c hcr hcs) (Finset.mem_union_left _ hx) hx'
  have hDother : ∀ c, c ≠ r → c ≠ s → Disjoint (endpoints y D) (endpoints y (P c)) := by
    intro c hcr hcs
    apply Finset.disjoint_left.mpr
    intro x hx hx'
    exact Finset.disjoint_left.mp (hseparate c hcr hcs) (Finset.mem_union_right _ hx) hx'
  constructor
  · intro c
    by_cases hcr : c = r
    · simpa only [hcr, if_pos rfl,ite_true] using hC
    by_cases hcs : c = s
    · simpa only [if_neg hcr, if_pos hcs] using hD
    · simpa only [if_neg hcr, if_neg hcs] using (hothers c hcr hcs).1
  · intro c d hcd
    by_cases hcr : c = r
    · subst c
      have hdr : d ≠ r := Ne.symm hcd
      by_cases hds : d = s
      · subst d
        simpa only [if_pos rfl, ite_true, if_neg (Ne.symm hrs)] using hCD
      · simpa only [if_pos rfl, ite_true, if_neg hdr, if_neg hds] using hCother d hdr hds
    by_cases hcs : c = s
    · subst c
      have hds : d ≠ s := Ne.symm hcd
      by_cases hdr : d = r
      · subst d
        simpa only [if_pos rfl, ite_true, if_neg (Ne.symm hrs)] using hCD.symm
      · simpa only [if_pos rfl, ite_true, if_neg (Ne.symm hrs), if_neg hdr, if_neg hds] using
          hDother d hdr hds
    by_cases hdr : d = r
    · subst d
      simpa only [if_pos rfl, ite_true, if_neg hcr, if_neg hcs] using (hCother c hcr hcs).symm
    by_cases hds : d = s
    · subst d
      simpa only [if_pos rfl, ite_true, if_neg (Ne.symm hrs), if_neg hcr, if_neg hcs] using
        (hDother c hcr hcs).symm
    · simpa only [if_neg hcr, if_neg hcs, if_neg hdr, if_neg hds,
        (hothers c hcr hcs).2, (hothers d hdr hds).2] using hP.disjoint c d hcd

theorem packingSize_replace_two {κ : Type*} [Fintype κ] [DecidableEq κ]
    (P : κ → Finset ℕ) (r s : κ) (hrs : r ≠ s) (C D : Finset ℕ)
    (hcard : C.card + D.card = (P r).card + (P s).card) :
    packingSize (fun c => if c = r then C else if c = s then D else P c) = packingSize P := by
  unfold packingSize
  apply sum_eq_of_two_coordinates _ _ r s hrs
  · simpa only [if_pos rfl, ite_true, if_neg (Ne.symm hrs)] using hcard
  · intro c hcr hcs
    simp only [if_neg hcr, if_neg hcs]


namespace ExternalMove

variable {y : ℕ → ℕ} {a α β γ : ℕ} (e : ExternalMove y a α β γ)
include e

theorem same_off_affected {r : ℕ} (hra : r ≠ a) (hrb : r ≠ a + 1)
    (hrα : r ≠ α) (hrβ : r ≠ β) : conjugate (adjacent a) y r = y r := by
  apply conjugate_adjacent_fixed hra hrb
  · intro h
    have hh := congrArg y h
    rw [e.involution r, e.left] at hh
    exact hrα hh
  · intro h
    have hh := congrArg y h
    rw [e.involution r, e.middle] at hh
    exact hrβ hh

/-- Every other chain in a packing is unaffected once one chain owns both
swapped matching edges. -/
theorem disjoint_chain_unchanged {C B : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (ha : a ∈ C) (hb : a + 1 ∈ C)
    (hB : IsChain (conjugate (adjacent a) y) B)
    (hd : Disjoint (endpoints (conjugate (adjacent a) y) C)
      (endpoints (conjugate (adjacent a) y) B)) :
    IsChain y B ∧
      (∀ r ∈ B, conjugate (adjacent a) y r = y r) ∧
      endpoints y B = endpoints (conjugate (adjacent a) y) B := by
  classical
  have hn : ∀ r ∈ B, r ≠ a ∧ r ≠ a + 1 ∧ r ≠ α ∧ r ≠ β := by
    intro r hr
    have hrE : r ∈ endpoints (conjugate (adjacent a) y) B := Finset.mem_union_left _ hr
    have haE : a ∈ endpoints (conjugate (adjacent a) y) C := Finset.mem_union_left _ ha
    have hbE : a + 1 ∈ endpoints (conjugate (adjacent a) y) C := Finset.mem_union_left _ hb
    have hαE : α ∈ endpoints (conjugate (adjacent a) y) C :=
      Finset.mem_union_right _ (Finset.mem_image.mpr ⟨a + 1, hb, e.conjugate_middle⟩)
    have hβE : β ∈ endpoints (conjugate (adjacent a) y) C :=
      Finset.mem_union_right _ (Finset.mem_image.mpr ⟨a, ha, e.conjugate_left⟩)
    exact ⟨fun h => Finset.disjoint_left.mp hd haE (h ▸ hrE),
      fun h => Finset.disjoint_left.mp hd hbE (h ▸ hrE),
      fun h => Finset.disjoint_left.mp hd hαE (h ▸ hrE),
      fun h => Finset.disjoint_left.mp hd hβE (h ▸ hrE)⟩
  have heq : ∀ r ∈ B, conjugate (adjacent a) y r = y r := by
    intro r hr
    have h := hn r hr
    exact e.same_off_affected h.1 h.2.1 h.2.2.1 h.2.2.2
  refine ⟨hB.congr_on heq, heq, ?_⟩
  unfold endpoints
  congr 1
  apply Finset.image_congr
  intro r hr
  exact (heq r hr).symm


/-- The colored repair in the external move is a genuine exchange of two tails.
It preserves the union of unordered endpoints and the total number of selected
edges; the endpoint-count equality then certifies one-use and disjointness. -/
theorem two_tail_switch {C B : Finset ℕ}
    (hC : IsChain (conjugate (adjacent a) y) C)
    (hB : IsChain (conjugate (adjacent a) y) B)
    (ha : a ∈ C) (hb : a + 1 ∈ C) (hc : a + 2 ∈ B)
    (hd : Disjoint (endpoints (conjugate (adjacent a) y) C)
      (endpoints (conjugate (adjacent a) y) B)) :
    ∃ C' B' : Finset ℕ, IsChain y C' ∧ IsChain y B' ∧
      Disjoint (endpoints y C') (endpoints y B') ∧
      C'.card + B'.card = C.card + B.card ∧
      endpoints y C' ∪ endpoints y B' =
        endpoints (conjugate (adjacent a) y) C ∪ endpoints (conjugate (adjacent a) y) B := by
  classical
  let L := C.filter (fun r => r < a)
  let R := C.filter (fun r => a + 1 < r)
  let U := B.filter (fun r => r < a + 2)
  let V := B.filter (fun r => a + 2 < r)
  let C' := L ∪ insert (a + 1) (insert (a + 2) V)
  let B' := U ∪ insert a R
  obtain ⟨hBy, hBsame, hBend⟩ := e.disjoint_chain_unchanged hC ha hb hB hd
  have hex := e.excluded_partners hC ha hb
  have hBnot : ∀ r ∈ B, r ≠ a ∧ r ≠ a + 1 := by
    intro r hr
    have hrE : r ∈ endpoints (conjugate (adjacent a) y) B := Finset.mem_union_left _ hr
    exact ⟨fun hh => Finset.disjoint_left.mp hd (Finset.mem_union_left _ ha) (hh ▸ hrE),
      fun hh => Finset.disjoint_left.mp hd (Finset.mem_union_left _ hb) (hh ▸ hrE)⟩
  have hL : ∀ r ∈ L, r < a ∧ β < y r := by
    intro r hr
    obtain ⟨hr, hra⟩ := Finset.mem_filter.mp hr
    have hh := hC.decreasing r hr a ha hra
    rw [e.conjugate_left, e.same_on_chain hC ha hb hr (by omega) (by omega)] at hh
    exact ⟨hra, hh⟩
  have hR : ∀ r ∈ R, a + 2 < r ∧ y r < α := by
    intro r hr
    obtain ⟨hr, hbr⟩ := Finset.mem_filter.mp hr
    have hrnc : r ≠ a + 2 := fun hh => hex.2.2 (hh ▸ hr)
    have hh := hC.decreasing (a + 1) hb r hr hbr
    rw [e.conjugate_middle, e.same_on_chain hC ha hb hr (by omega) (by omega)] at hh
    exact ⟨by omega, hh⟩
  have hU : ∀ r ∈ U, r < a ∧ γ < y r := by
    intro r hr
    obtain ⟨hr, hrc⟩ := Finset.mem_filter.mp hr
    have hnot := hBnot r hr
    have hh := hB.decreasing r hr (a + 2) hc hrc
    rw [e.conjugate_right, hBsame r hr] at hh
    exact ⟨by omega, hh⟩
  have hV : ∀ r ∈ V, a + 2 < r ∧ y r < γ := by
    intro r hr
    obtain ⟨hr, hcr⟩ := Finset.mem_filter.mp hr
    have hh := hB.decreasing (a + 2) hc r hr hcr
    rw [e.conjugate_right, hBsame r hr] at hh
    exact ⟨hcr, hh⟩
  have hLC : L ⊆ C.erase (a + 1) := by
    intro r hr
    have hh := Finset.mem_filter.mp hr
    exact Finset.mem_erase.mpr ⟨by omega, hh.1⟩
  have hRC : R ⊆ C.erase (a + 1) := by
    intro r hr
    have hh := Finset.mem_filter.mp hr
    exact Finset.mem_erase.mpr ⟨by omega, hh.1⟩
  have hLd : Decreases y L := ((e.erase_middle hC ha hb).mono hLC).decreasing
  have hRd : Decreases y R := ((e.erase_middle hC ha hb).mono hRC).decreasing
  have hUd : Decreases y U := (hBy.mono (Finset.filter_subset _ _)).decreasing
  have hVd : Decreases y V := (hBy.mono (Finset.filter_subset _ _)).decreasing
  have hC'd : Decreases y C' := hLd.frame_two hVd (a + 1) (a + 2) (by omega)
    (by simpa only [e.middle, e.right] using e.right_lt)
    (by intro r hr; have hh := hL r hr; exact ⟨by omega, by simpa only [e.middle] using hh.2⟩)
    (by intro r hr; simpa only [e.right] using hV r hr)
  have hB'd : Decreases y B' := hUd.frame_one hRd a
    (by intro r hr; have hh := hU r hr; refine ⟨hh.1, ?_⟩; rw [e.left]; exact e.left_lt.trans hh.2)
    (by intro r hr; have hh := hR r hr; exact ⟨by omega, by simpa only [e.left] using hh.2⟩)
  have hCsplit : C = L ∪ insert a (insert (a + 1) R) := by
    ext r
    simp only [L, R, Finset.mem_union, Finset.mem_insert, Finset.mem_filter]
    constructor
    · intro hr
      by_cases hra : r < a
      · exact Or.inl ⟨hr, hra⟩
      by_cases heq : r = a
      · exact Or.inr (Or.inl heq)
      by_cases heqb : r = a + 1
      · exact Or.inr (Or.inr (Or.inl heqb))
      · exact Or.inr (Or.inr (Or.inr ⟨hr, by omega⟩))
    · rintro (⟨hr, _⟩ | rfl | rfl | ⟨hr, _⟩) <;> assumption
  have hBsplit : B = U ∪ insert (a + 2) V := by
