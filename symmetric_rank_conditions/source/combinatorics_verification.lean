    simpa only [ha] using (f.injective.eq_iff : f x = f a ↔ x = a)
  have hxb : f x = b ↔ x = b := by
    simpa only [hb] using (f.injective.eq_iff : f x = f b ↔ x = b)
  have hya : f y = a ↔ y = a := by
    simpa only [ha] using (f.injective.eq_iff : f y = f a ↔ y = a)
  have hyb : f y = b ↔ y = b := by
    simpa only [hb] using (f.injective.eq_iff : f y = f b ↔ y = b)
  simp only [partners_append,partners_singleton,h x y,hxa,hxb,hya,hyb]

