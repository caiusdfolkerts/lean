  · rintro ⟨a,b,hai,hbj,hm⟩
    refine ⟨fun p => (a p).val,fun p => (b p.rev).val,?_,?_,
      fun p => hai p,fun p => hbj p.rev,(matchingAntidiagonal_le_iff m a b).mp hm⟩
