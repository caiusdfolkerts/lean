are provided by the exact accepted `matching_foundation` import. -/

theorem MatchingWord.partner_triple_facts {k p q r : ℕ}
    {w : List (ℕ × ℕ)} (hw : MatchingWord w)
    (hp : Partners w k p) (hq : Partners w (k+1) q) (hr : Partners w (k+2) r) :
    p ≠ k ∧ q ≠ k+1 ∧ r ≠ k+2 ∧ p ≠ q ∧ p ≠ r ∧ q ≠ r ∧
      (p = k+1 ↔ q = k) ∧ (p = k+2 ↔ r = k) ∧ (q = k+2 ↔ r = k+1) := by
  refine ⟨(hw.partner_ne hp).symm,(hw.partner_ne hq).symm,(hw.partner_ne hr).symm,
    ?_,?_,?_,?_,?_,?_⟩
  · intro h
    subst q
    have := hw.partner_unique hp.symm hq.symm
    omega
  · intro h
    subst r
    have := hw.partner_unique hp.symm hr.symm
    omega
  · intro h
    subst r
    have := hw.partner_unique hq.symm hr.symm
    omega
  · constructor
    · intro h
      subst p
      exact hw.partner_unique hq hp.symm
    · intro h
      subst q
      exact hw.partner_unique hp hq.symm
  · constructor
    · intro h
      subst p
      exact hw.partner_unique hr hp.symm
    · intro h
      subst r
      exact hw.partner_unique hp hr.symm
  · constructor
    · intro h
      subst q
      exact hw.partner_unique hr hq.symm
    · intro h
      subst r
      exact hw.partner_unique hq hr.symm

def conjugatedTriple (k : ℕ) (s : Fin 3) (p q r : ℕ) : ℕ × ℕ × ℕ :=
  let f := dualLetter k s
  if s = 1 then (f q,f p,f r)
  else if s = 2 then (f p,f r,f q) else (p,q,r)

theorem dualLetter_one_eq_swapFirst (k x : ℕ) :
    dualLetter k 1 x = swapFirst k x := by
  simp only [dualLetter,Fin.reduceEq,ite_true,Equiv.swap_apply_def,swapFirst]

theorem dualLetter_two_eq_swapLast (k x : ℕ) :
    dualLetter k 2 x = swapLast k x := by
  simp only [dualLetter,Fin.reduceEq,ite_false,ite_true,Equiv.swap_apply_def,swapLast]

/-- The checked three-partner classification identifies the selector from its
actual descent exchange. This avoids an exponential split of all local tests. -/
theorem matchingMedianSelector_of_flipped_descents {k p q r : ℕ} (s : Fin 3)
    (hp : p ≠ k) (hq : q ≠ k+1) (hr : r ≠ k+2)
    (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r)
    (h01 : p = k+1 ↔ q = k) (h02 : p = k+2 ↔ r = k)
    (h12 : q = k+2 ↔ r = k+1)
    (hneq : ¬((q < p ∧ p ≠ k+1) ↔ (r < q ∧ q ≠ k+2)))
    (hflip0 : ((conjugatedTriple k s p q r).2.1 < (conjugatedTriple k s p q r).1 ∧
        (conjugatedTriple k s p q r).1 ≠ k+1) ↔ (r < q ∧ q ≠ k+2))
    (hflip1 : ((conjugatedTriple k s p q r).2.2 < (conjugatedTriple k s p q r).2.1 ∧
        (conjugatedTriple k s p q r).2.1 ≠ k+2) ↔ (q < p ∧ p ≠ k+1)) :
    s = matchingMedianSelector k p q r := by
  have ht : MatchingTriple k p q r :=
    ⟨hp,hq,hr,h01,h02,h12,hpq,hpr,hqr⟩
  have hmiddle : ¬StrictMedian (modifiedPartner k k p)
      (modifiedPartner k (k+1) q) (modifiedPartner k (k+2) r) := by
    intro hm
    exact hneq ((matching_middle_median_iff ht).mp hm)
  rcases (show s = 0 ∨ s = 1 ∨ s = 2 by omega) with rfl | rfl | rfl
  · exact False.elim (hneq (by simpa [conjugatedTriple] using hflip0))
  · have htoggle :
        (swapFirst k r < swapFirst k p ∧ swapFirst k p ≠ k+2) ↔
          ¬(r < q ∧ q ≠ k+2) := by
      have hnot : (q < p ∧ p ≠ k+1) ↔ ¬(r < q ∧ q ≠ k+2) := by
        tauto
      have hh := hflip1.trans hnot
      simpa only [conjugatedTriple,Fin.reduceEq,ite_true,Prod.fst,Prod.snd,
        dualLetter_one_eq_swapFirst] using hh
    have hthird := matching_first_swap_forces_median ht htoggle
    unfold matchingMedianSelector
    rw [if_neg hmiddle,if_pos hthird]
  · have htoggle :
        (swapLast k r < swapLast k p ∧ swapLast k p ≠ k+1) ↔
          ¬(q < p ∧ p ≠ k+1) := by
      have hnot : (r < q ∧ q ≠ k+2) ↔ ¬(q < p ∧ p ≠ k+1) := by
        tauto
      have hh := hflip0.trans hnot
      simpa only [conjugatedTriple,Fin.reduceEq,ite_false,ite_true,Prod.fst,Prod.snd,
        dualLetter_two_eq_swapLast] using hh
    have hfirst := matching_last_swap_forces_median ht htoggle
    have hthird : ¬StrictMedian (modifiedPartner k k p)
        (modifiedPartner k (k+2) r) (modifiedPartner k (k+1) q) := by
      unfold StrictMedian at hfirst ⊢
      omega
    unfold matchingMedianSelector
    rw [if_neg hmiddle,if_neg hthird]

theorem ConjugatesPartners.triple {k p q r : ℕ} {s : Fin 3}
    {w v : List (ℕ × ℕ)} (hc : ConjugatesPartners (dualLetter k s) w v)
    (hp : Partners w k p) (hq : Partners w (k+1) q) (hr : Partners w (k+2) r) :
    Partners v k (conjugatedTriple k s p q r).1 ∧
      Partners v (k+1) (conjugatedTriple k s p q r).2.1 ∧
      Partners v (k+2) (conjugatedTriple k s p q r).2.2 := by
  have hp' := (hc k p).mpr hp
  have hq' := (hc (k+1) q).mpr hq
  have hr' := (hc (k+2) r).mpr hr
  fin_cases s
  · simpa [conjugatedTriple,dualLetter] using And.intro hp' (And.intro hq' hr')
  · simpa [conjugatedTriple,dualLetter,Equiv.swap_apply_def] using
      And.intro hq' (And.intro hp' hr')
  · simpa [conjugatedTriple,dualLetter,Equiv.swap_apply_def] using
      And.intro hp' (And.intro hr' hq')

/-- The matching median rule, with the median determined from actual partners.
The output matching is the conjugate prescribed in equation (2.4) of the paper,
and its actual paired-insertion tableau is the elementary dual tableau. -/
theorem matching_median_rule {k p q r : ℕ} {w : List (ℕ × ℕ)}
    (hw : MatchingWord w) (hp : Partners w k p) (hq : Partners w (k+1) q)
    (hr : Partners w (k+2) r) :
    ∃ v : List (ℕ × ℕ), MatchingWord v ∧
      ConjugatesPartners (dualLetter k (matchingMedianSelector k p q r)) w v ∧
      pairInsertList v = dualRows k (pairInsertList w) := by
  obtain ⟨hpn,hqn,hrn,hpqn,hprn,hqrn,h01,h02,h12⟩ := hw.partner_triple_facts hp hq hr
  by_cases hfixed : (q < p ∧ p ≠ k+1) ↔ (r < q ∧ q ≠ k+2)
  · have hs := matchingMedianSelector_zero_of_fixed hpn hqn hrn hpqn hprn hqrn h01 h02 h12 hfixed
    refine ⟨w,hw,?_,(matching_dual_fixed_of_partner_comparisons hw hp hq hr hfixed).symm⟩
    rw [hs]
    simpa [dualLetter] using conjugatesPartners_refl w
  · have hm : ∀ d : Fin 3, k+d.val ∈ endpointWord w := by
      intro d
      fin_cases d
      · simpa using hp.mem_left
      · simpa using hq.mem_left
      · simpa using hr.mem_left
    obtain ⟨s,v,hv,hc,hT⟩ := matching_adjacent_dual_preimage k w hw hm
    obtain ⟨hvp,hvq,hvr⟩ := hc.triple hp hq hr
    have hmword : ∀ d : Fin 3, k+d.val ∈ rowWordRows (pairInsertList w) := by
      intro d
      rw [mem_rowWordRows_pairInsertList]
      exact hm d
    have hD := dualRows_exchanges_descents hw.isTableauRows hw.output_distinct hmword
    have hflip0 : ((conjugatedTriple k s p q r).2.1 < (conjugatedTriple k s p q r).1 ∧
        (conjugatedTriple k s p q r).1 ≠ k+1) ↔ (r < q ∧ q ≠ k+2) := by
      calc
        _ ↔ RowDescends k (k+1) (pairInsertList v) := (hv.descent hvp hvq).symm
        _ ↔ RowDescends (k+1) (k+2) (pairInsertList w) := by rw [hT]; exact hD.1
        _ ↔ _ := by simpa only [Nat.add_assoc] using hw.descent hq hr
    have hflip1 : ((conjugatedTriple k s p q r).2.2 < (conjugatedTriple k s p q r).2.1 ∧
        (conjugatedTriple k s p q r).2.1 ≠ k+2) ↔ (q < p ∧ p ≠ k+1) := by
      calc
        _ ↔ RowDescends (k+1) (k+2) (pairInsertList v) := by
          simpa only [Nat.add_assoc] using (hv.descent hvq hvr).symm
        _ ↔ RowDescends k (k+1) (pairInsertList w) := by rw [hT]; exact hD.2
        _ ↔ _ := hw.descent hp hq
    have hs := matchingMedianSelector_of_flipped_descents s hpn hqn hrn hpqn hprn hqrn
      h01 h02 h12 hfixed hflip0 hflip1
    exact ⟨v,hv,hs ▸ hc,hT⟩

end FourPapers.Symmetric
