/-!
# The two extremal matching representatives

This file supplies the elementary chain bounds used in Section 2.2. The partner
map is an actual involution. A descending pair which consists of the two ends
of one edge is forbidden by `IsChain.oneUse`.
-/

namespace FourPapers.Symmetric.MatchingChains

/-- Absence of a matching descent on the integer interval `[a,b]`.
An adjacent paired transposition is the exception in equation (2.4). -/
def NoDescents (y : ℕ → ℕ) (a b : ℕ) : Prop :=
  ∀ k, a ≤ k → k < b → y k < y (k + 1) ∨ y k = k + 1

/-- In a descent-free interval, the only inversions are adjacent paired edges. -/
theorem NoDescents.inversion {y : ℕ → ℕ} (hy : Function.Involutive y)
    {a b : ℕ} (h : NoDescents y a b) {i j : ℕ}
    (hai : a ≤ i) (hjb : j ≤ b) (hij : i < j) :
    y i < y j ∨ (j = i + 1 ∧ y i = j) := by
  induction j generalizing i with
  | zero => omega
  | succ j ih =>
    by_cases heq : i = j
    · subst i
      rcases h j hai (by omega) with hs | hp
      · exact Or.inl hs
      · exact Or.inr ⟨rfl, hp⟩
    have hij' : i < j := by omega
    have hstep := h j (by omega) (by omega)
    rcases ih hai (by omega) hij' with hs | ⟨hp, hpair⟩
    · rcases hstep with ht | ht
      · exact Or.inl (hs.trans ht)
      · have hback : y (j + 1) = j := by
          simpa only [ht] using hy j
        have hne : y i ≠ j := by
          intro hi
          have := hy.injective (hi.trans hback.symm)
          omega
        left
        omega
    · have hback : y j = i := by simpa only [hpair] using hy i
      rcases hstep with ht | ht
      · have hne : y (j + 1) ≠ j := by
          intro hj
          have := hy.injective (hj.trans hpair.symm)
          omega
        left
        omega
      · omega

/-- A one-use decreasing chain meets each descent-free interval at most once. -/
theorem NoDescents.card_le_one {y : ℕ → ℕ} (hy : Function.Involutive y)
    {a b : ℕ} (h : NoDescents y a b) {C : Finset ℕ}
    (hC : IsChain y C) (hsub : ∀ x ∈ C, a ≤ x ∧ x ≤ b) : C.card ≤ 1 := by
  apply Finset.card_le_one.mpr
  intro i hi j hj
  rcases lt_trichotomy i j with hij | hij | hji
  · rcases h.inversion hy (hsub i hi).1 (hsub j hj).2 hij with hs | ⟨_, hp⟩
    · exact False.elim ((not_lt_of_ge (hC.decreasing i hi j hj hij).le) hs)
    · exact False.elim (hC.oneUse i hi (hp.symm ▸ hj))
  · exact hij
  · rcases h.inversion hy (hsub j hj).1 (hsub i hi).2 hji with hs | ⟨_, hp⟩
    · exact False.elim ((not_lt_of_ge (hC.decreasing j hj i hi hji).le) hs)
    · exact False.elim (hC.oneUse j hj (hp.symm ▸ hi))

/-- A decreasing involution on a prefix with no fixed points or adjacent paired
positions cannot pair two positions within that prefix. -/
theorem decreasing_prefix_oneUse {y : ℕ → ℕ} (hy : Function.Involutive y)
    (h : ℕ)
    (hdec : ∀ i < h, ∀ j < h, i < j → y j < y i)
    (hfix : ∀ i < h, y i ≠ i)
    (hadj : ∀ i, i + 1 < h → y i ≠ i + 1) :
    ∀ i < h, h ≤ y i := by
  classical
  let P := (Finset.range h).filter fun i => i < y i ∧ y i < h
  have hempty : P = ∅ := by
    by_contra hn
    have hp : P.Nonempty := Finset.nonempty_iff_ne_empty.mpr hn
    let a := P.max' hp
    have ha : a ∈ P := Finset.max'_mem P hp
    have hachar := Finset.mem_filter.mp ha
    have ah : a < h := Finset.mem_range.mp hachar.1
    have aya : a < y a := hachar.2.1
    have yah : y a < h := hachar.2.2
    have ane : y a ≠ a + 1 := hadj a (by omega)
    have anext : a + 1 < y a := by omega
    have ynext_lt : y (a + 1) < y a := hdec a ah (a + 1) (by omega) (by omega)
    have ynext_gt : a < y (a + 1) := by
      have hh := hdec (a + 1) (by omega) (y a) yah anext
      simpa only [hy a] using hh
    have ynext_ne : y (a + 1) ≠ a + 1 := hfix (a + 1) (by omega)
    have hnext : a + 1 ∈ P := by
      apply Finset.mem_filter.mpr
      exact ⟨Finset.mem_range.mpr (by omega), by omega⟩
    have hmax : a + 1 ≤ a := Finset.le_max' P (a + 1) hnext
    omega
  intro i hi
  by_contra hbad
  have hyih : y i < h := by omega
  have hne := hfix i hi
  by_cases hlt : i < y i
  · have hm : i ∈ P := Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hi, hlt, hyih⟩
    simpa only [hempty, Finset.notMem_empty] using hm
  · have hm : y i ∈ P := by
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_range.mpr hyih, ?_⟩
      rw [hy i]
      omega
    simpa only [hempty, Finset.notMem_empty] using hm

/-- The column-superstandard prefix itself is an admissible chain of its full
height, including the empty-prefix case. -/
theorem decreasing_prefix_chain {y : ℕ → ℕ} (hy : Function.Involutive y)
    (h : ℕ)
    (hdec : ∀ i < h, ∀ j < h, i < j → y j < y i)
    (hfix : ∀ i < h, y i ≠ i)
    (hadj : ∀ i, i + 1 < h → y i ≠ i + 1) :
    IsChain y (Finset.range h) := by
  constructor
  · intro i hi j hj hij
    exact hdec i (Finset.mem_range.mp hi) j (Finset.mem_range.mp hj) hij
  · intro i hi
    exact fun hj => (not_lt_of_ge
      (decreasing_prefix_oneUse hy h hdec hfix hadj i (Finset.mem_range.mp hi)))
        (Finset.mem_range.mp hj)

end FourPapers.Symmetric.MatchingChains
