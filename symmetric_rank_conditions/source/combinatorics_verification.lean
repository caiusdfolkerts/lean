namespace FourPapers.Symmetric.MatchingChains

/-- Preservation of every interval-chain length and every finite colored-packing
size. These are the two exact optimizations in Lemma 2.2 of the manuscript. -/
structure StatisticsInvariant (a : ℕ) (y z : ℕ → ℕ) : Prop where
  chain : ∀ (L M : Set ℕ), IsInterval L → IsInterval M →
    a ∈ L → a + 1 ∈ L → a + 2 ∈ L →
    a ∈ M → a + 1 ∈ M → a + 2 ∈ M → ∀ q : ℕ,
    (∃ C : Finset ℕ, IsChain y C ∧ C.card = q ∧ InRectangle y C L M) ↔
      (∃ C : Finset ℕ, IsChain z C ∧ C.card = q ∧ InRectangle z C L M)
  packing : ∀ (κ : Type) [Fintype κ] (q : ℕ),
    (∃ P : κ → Finset ℕ, IsPacking y P ∧ packingSize P = q) ↔
      (∃ P : κ → Finset ℕ, IsPacking z P ∧ packingSize P = q)

theorem StatisticsInvariant.refl (a : ℕ) (y : ℕ → ℕ) : StatisticsInvariant a y y := by
  constructor
  · intros; exact Iff.rfl
  · intros; exact Iff.rfl

theorem StatisticsInvariant.symm {a : ℕ} {y z : ℕ → ℕ}
    (h : StatisticsInvariant a y z) : StatisticsInvariant a z y := by
  constructor
  · intro L M hL hM haL hbL hcL haM hbM hcM q
    exact (h.chain L M hL hM haL hbL hcL haM hbM hcM q).symm
  · intro κ _ q
    exact (h.packing κ q).symm

theorem ExternalMove.statisticsInvariant {y : ℕ → ℕ} {a α β γ : ℕ}
    (e : ExternalMove y a α β γ) : StatisticsInvariant a y (conjugate (adjacent a) y) := by
  exact ⟨e.chain_exists_iff, e.packing_exists_iff⟩

theorem InternalMove.statisticsInvariant {y : ℕ → ℕ} {a γ : ℕ}
    (e : InternalMove y a γ) : StatisticsInvariant a y (conjugate (adjacent a) y) := by
  exact ⟨e.chain_exists_iff, e.packing_exists_iff⟩

def modifiedPartner (y : ℕ → ℕ) (a x : ℕ) : ℕ :=
  if y x = a ∨ y x = a + 1 ∨ y x = a + 2 then x else y x

def StrictMedian (p q r : ℕ) : Prop := (p < q ∧ q < r) ∨ (r < q ∧ q < p)

instance (p q r : ℕ) : Decidable (StrictMedian p q r) :=
  inferInstanceAs (Decidable ((p < q ∧ q < r) ∨ (r < q ∧ q < p)))

/-- The third modified partner being the median selects the first adjacent
transposition. The classification includes every internal matching edge. -/
theorem first_median_invariant {y : ℕ → ℕ} (hy : Function.Involutive y) (a : ℕ)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2)
    (hmed : StrictMedian (modifiedPartner y a a) (modifiedPartner y a (a + 2))
      (modifiedPartner y a (a + 1))) :
    StatisticsInvariant a y (conjugate (adjacent a) y) := by
  by_cases hab : y a = a + 1
  · have hba : y (a + 1) = a := by simpa only [hab] using hy a
    have hca : y (a + 2) ≠ a := by
      intro hh
      have hx := hy.injective (hh.trans hba.symm)
      omega
    have hcb : y (a + 2) ≠ a + 1 := by
      intro hh
      have hx := hy.injective (hh.trans hab.symm)
      omega
    simp only [modifiedPartner, hab, hba, hca, hcb, hc, or_false, false_or,
      or_true, true_or, if_true, if_false, StrictMedian] at hmed
    omega
  by_cases hac : y a = a + 2
  · have hca : y (a + 2) = a := by simpa only [hac] using hy a
    have hba : y (a + 1) ≠ a := by
      intro hh
      have hx := hy.injective (hh.trans hca.symm)
      omega
    have hbc : y (a + 1) ≠ a + 2 := by
      intro hh
      have hx := hy.injective (hh.trans hac.symm)
      omega
    have habove : a + 2 < y (a + 1) := by
      simp only [modifiedPartner, hac, hca, hba, hb, hbc, or_false, false_or,
        or_true, true_or, if_true, if_false, StrictMedian] at hmed
      omega
    exact (InternalMove.mk hy hac rfl habove).statisticsInvariant
  by_cases hbc : y (a + 1) = a + 2
  · have hcb : y (a + 2) = a + 1 := by simpa only [hbc] using hy (a + 1)
    have habove : a + 2 < y a := by
      simp only [modifiedPartner, ha, hab, hac, hbc, hcb, or_false, false_or,
        or_true, true_or, if_true, if_false, StrictMedian] at hmed
      omega
    let z := conjugate (adjacent a) y
    have hz : Function.Involutive z := conjugate_involutive hy (adjacent a)
    have hza : z a = a + 2 := by
      simp only [z, conjugate, adjacent_symm, adjacent_self, hbc]
      exact adjacent_apply_of_ne (by omega) (by omega)
    have hzb : z (a + 1) = y a := by
      simp only [z, conjugate, adjacent_symm, adjacent_succ]
      exact adjacent_apply_of_ne ha hab
    have he := (InternalMove.mk hz hza hzb habove).statisticsInvariant
    have he' : StatisticsInvariant a (conjugate (adjacent a) y) y := by
      simpa only [z, conjugate_adjacent_twice] using he
    exact he'.symm
  · have hba : y (a + 1) ≠ a := by
      intro hh
      have hx := congrArg y hh
      rw [hy (a + 1)] at hx
      exact hab hx.symm
    have hca : y (a + 2) ≠ a := by
      intro hh
      have hx := congrArg y hh
      rw [hy (a + 2)] at hx
      exact hac hx.symm
    have hcb : y (a + 2) ≠ a + 1 := by
      intro hh
      have hx := congrArg y hh
      rw [hy (a + 2)] at hx
      exact hbc hx.symm
    have hp : y a ≠ a ∧ y a ≠ a + 1 ∧ y a ≠ a + 2 := ⟨ha, hab, hac⟩
    have hq : y (a + 1) ≠ a ∧ y (a + 1) ≠ a + 1 ∧ y (a + 1) ≠ a + 2 := ⟨hba, hb, hbc⟩
    have hr : y (a + 2) ≠ a ∧ y (a + 2) ≠ a + 1 ∧ y (a + 2) ≠ a + 2 := ⟨hca, hcb, hc⟩
    simp only [modifiedPartner, ha, hab, hac, hba, hb, hbc, hca, hcb, hc,
      or_false, if_false, StrictMedian] at hmed
    rcases hmed with hm | hm
    · exact (ExternalMove.mk hy hm.1 hm.2 rfl rfl rfl hp hq hr).statisticsInvariant
    · let z := conjugate (adjacent a) y
      have hz : Function.Involutive z := conjugate_involutive hy (adjacent a)
      have hza : z a = y (a + 1) := by
        simp only [z, conjugate, adjacent_symm, adjacent_self]
        exact adjacent_apply_of_ne hba hb
      have hzb : z (a + 1) = y a := by
        simp only [z, conjugate, adjacent_symm, adjacent_succ]
        exact adjacent_apply_of_ne ha hab
      have hzc : z (a + 2) = y (a + 2) :=
        conjugate_adjacent_fixed (by omega) (by omega) hca hcb
      have he := (ExternalMove.mk hz hm.1 hm.2 hza hzb hzc hq hp hr).statisticsInvariant
      have he' : StatisticsInvariant a (conjugate (adjacent a) y) y := by
        simpa only [z, conjugate_adjacent_twice] using he
      exact he'.symm

theorem reverseLabels_triple {N a : ℕ} (hN : a + 2 ≤ N) :
    reverseLabels N a = (N - (a + 2)) + 2 ∧
      reverseLabels N (a + 1) = (N - (a + 2)) + 1 ∧
      reverseLabels N (a + 2) = N - (a + 2) := by
  rw [reverseLabels_of_le (by omega : a ≤ N),
    reverseLabels_of_le (by omega : a + 1 ≤ N), reverseLabels_of_le hN]
  omega

theorem reverseLabels_adjacent_last {N a : ℕ} (hN : a + 2 ≤ N) (r : ℕ) :
    reverseLabels N (adjacent (a + 1) r) =
      adjacent (N - (a + 2)) (reverseLabels N r) := by
  obtain ⟨ha, hb, hc⟩ := reverseLabels_triple hN
  by_cases hrb : r = a + 1
  · subst r
    rw [adjacent_self, show a + 1 + 1 = a + 2 by omega, hc, hb, adjacent_succ]
  by_cases hrc : r = a + 2
  · subst r
    rw [show a + 2 = (a + 1) + 1 by omega, adjacent_succ]
    rw [hb, show a + 1 + 1 = a + 2 by omega, hc, adjacent_self]
  · have hne₀ : reverseLabels N r ≠ N - (a + 2) := by
      intro hh
      have hx := (reverseLabels N).injective (hh.trans hc.symm)
      exact hrc hx
    have hne₁ : reverseLabels N r ≠ N - (a + 2) + 1 := by
      intro hh
      have hx := (reverseLabels N).injective (hh.trans hb.symm)
      exact hrb hx
    rw [adjacent_apply_of_ne hrb (by omega), adjacent_apply_of_ne hne₀ hne₁]

theorem conjugate_reverse_last {N a : ℕ} (hN : a + 2 ≤ N) (y : ℕ → ℕ) :
    conjugate (reverseLabels N) (conjugate (adjacent (a + 1)) y) =
      conjugate (adjacent (N - (a + 2))) (conjugate (reverseLabels N) y) := by
  funext r
  have hinner : adjacent (a + 1) (reverseLabels N r) =
      reverseLabels N (adjacent (N - (a + 2)) r) := by
    have hh := congrArg (reverseLabels N) (reverseLabels_adjacent_last hN (reverseLabels N r))
    simpa only [reverseLabels_twice] using hh
  simp only [conjugate, reverseLabels_symm, adjacent_symm]
  rw [reverseLabels_adjacent_last hN, hinner]

theorem BoundedSupport.adjacent {y : ℕ → ℕ} {N a : ℕ}
    (h : BoundedSupport y N) (ha : a + 1 ≤ N) :
    BoundedSupport (conjugate (adjacent a) y) N := by
  intro r hr
  have hneq₀ : r ≠ a := by omega
  have hneq₁ : r ≠ a + 1 := by omega
  simp only [conjugate, adjacent_symm, adjacent_apply_of_ne hneq₀ hneq₁, h r hr]

theorem modifiedPartner_reverse {N a : ℕ} (hN : a + 2 ≤ N)
    (y : ℕ → ℕ) (x : ℕ) :
    modifiedPartner (conjugate (reverseLabels N) y) (N - (a + 2)) (reverseLabels N x) =
      reverseLabels N (modifiedPartner y a x) := by
  obtain ⟨ha, hb, hc⟩ := reverseLabels_triple hN
  have hp₀ : reverseLabels N (y x) = N - (a + 2) ↔ y x = a + 2 := by
    rw [← hc]
    exact (reverseLabels N).injective.eq_iff
  have hp₁ : reverseLabels N (y x) = N - (a + 2) + 1 ↔ y x = a + 1 := by
    rw [← hb]
    exact (reverseLabels N).injective.eq_iff
  have hp₂ : reverseLabels N (y x) = N - (a + 2) + 2 ↔ y x = a := by
    rw [← ha]
    exact (reverseLabels N).injective.eq_iff
  unfold modifiedPartner
  rw [conjugate_apply_image]
  by_cases hin : y x = a ∨ y x = a + 1 ∨ y x = a + 2
  · have hin' : reverseLabels N (y x) = N - (a + 2) ∨
        reverseLabels N (y x) = N - (a + 2) + 1 ∨
        reverseLabels N (y x) = N - (a + 2) + 2 := by
      rw [hp₀, hp₁, hp₂]
      tauto
    rw [if_pos hin, if_pos hin']
  · have hin' : ¬(reverseLabels N (y x) = N - (a + 2) ∨
        reverseLabels N (y x) = N - (a + 2) + 1 ∨
        reverseLabels N (y x) = N - (a + 2) + 2) := by
      rw [hp₀, hp₁, hp₂]
      tauto
    rw [if_neg hin, if_neg hin']

theorem modifiedPartner_le {y : ℕ → ℕ} {N a x : ℕ}
    (hy : Function.Involutive y) (h : BoundedSupport y N) (hx : x ≤ N) :
    modifiedPartner y a x ≤ N := by
  unfold modifiedPartner
  split_ifs
  · exact hx
  · exact h.map_le hy hx

theorem StrictMedian.reverse {N p q r : ℕ}
    (h : StrictMedian p q r) (hp : p ≤ N) (hq : q ≤ N) (hr : r ≤ N) :
    StrictMedian (reverseLabels N r) (reverseLabels N q) (reverseLabels N p) := by
  rcases h with h | h
  · exact Or.inl ⟨(reverseLabels_lt_iff hr hq).mpr h.2,
      (reverseLabels_lt_iff hq hp).mpr h.1⟩
  · exact Or.inr ⟨(reverseLabels_lt_iff hp hq).mpr h.2,
      (reverseLabels_lt_iff hq hr).mpr h.1⟩

/-- Reversal reduces the last-adjacent case of the median rule to the first.
The ambient support bound is arbitrary and supplies no bound on the packing. -/
theorem last_median_invariant {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (hsupp : BoundedSupport y N) (a : ℕ) (hN : a + 2 ≤ N)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2)
    (hmed : StrictMedian (modifiedPartner y a (a + 1)) (modifiedPartner y a a)
      (modifiedPartner y a (a + 2))) :
    StatisticsInvariant a y (conjugate (adjacent (a + 1)) y) := by
  let k := N - (a + 2)
  let v := conjugate (reverseLabels N) y
  let z := conjugate (adjacent (a + 1)) y
  obtain ⟨hr₀, hr₁, hr₂⟩ := reverseLabels_triple hN
  have hv : Function.Involutive v := conjugate_involutive hy (reverseLabels N)
  have hv₀ : v k ≠ k := by
    rw [show k = reverseLabels N (a + 2) from hr₂.symm]
    rw [show v (reverseLabels N (a + 2)) = reverseLabels N (y (a + 2)) from
      conjugate_apply_image (reverseLabels N) y (a + 2)]
    exact fun hh => hc ((reverseLabels N).injective hh)
  have hv₁ : v (k + 1) ≠ k + 1 := by
    rw [show k + 1 = reverseLabels N (a + 1) from hr₁.symm]
    rw [show v (reverseLabels N (a + 1)) = reverseLabels N (y (a + 1)) from
      conjugate_apply_image (reverseLabels N) y (a + 1)]
    exact fun hh => hb ((reverseLabels N).injective hh)
  have hv₂ : v (k + 2) ≠ k + 2 := by
    rw [show k + 2 = reverseLabels N a from hr₀.symm]
    rw [show v (reverseLabels N a) = reverseLabels N (y a) from
      conjugate_apply_image (reverseLabels N) y a]
    exact fun hh => ha ((reverseLabels N).injective hh)
  have hmed' : StrictMedian (modifiedPartner v k k) (modifiedPartner v k (k + 2))
      (modifiedPartner v k (k + 1)) := by
    have hh := hmed.reverse (modifiedPartner_le hy hsupp (by omega : a + 1 ≤ N))
      (modifiedPartner_le hy hsupp (by omega : a ≤ N)) (modifiedPartner_le hy hsupp hN)
    have hm₀ := modifiedPartner_reverse hN y (a + 2)
    have hm₁ := modifiedPartner_reverse hN y (a + 1)
    have hm₂ := modifiedPartner_reverse hN y a
    rw [hr₂] at hm₀
    rw [hr₁] at hm₁
    rw [hr₀] at hm₂
    rw [← hm₀, ← hm₁, ← hm₂] at hh
    exact hh
  have hfirst := first_median_invariant hv k hv₀ hv₁ hv₂ hmed'
  have hz : Function.Involutive z := conjugate_involutive hy (adjacent (a + 1))
  have hzbound : BoundedSupport z N := hsupp.adjacent (by omega : a + 1 + 1 ≤ N)
  have hcomm : conjugate (reverseLabels N) z = conjugate (adjacent k) v :=
    conjugate_reverse_last hN y
  constructor
  · intro L M hL hM haL hbL hcL haM hbM hcM q
    have hkL : k ∈ reversedSet N L := by
      simpa only [hr₂] using (reverse_mem_reversedSet hN).mpr hcL
    have hk₁L : k + 1 ∈ reversedSet N L := by
      simpa only [hr₁] using (reverse_mem_reversedSet (by omega : a + 1 ≤ N)).mpr hbL
    have hk₂L : k + 2 ∈ reversedSet N L := by
      simpa only [hr₀] using (reverse_mem_reversedSet (by omega : a ≤ N)).mpr haL
    have hkM : k ∈ reversedSet N M := by
      simpa only [hr₂] using (reverse_mem_reversedSet hN).mpr hcM
    have hk₁M : k + 1 ∈ reversedSet N M := by
      simpa only [hr₁] using (reverse_mem_reversedSet (by omega : a + 1 ≤ N)).mpr hbM
    have hk₂M : k + 2 ∈ reversedSet N M := by
      simpa only [hr₀] using (reverse_mem_reversedSet (by omega : a ≤ N)).mpr haM
    have hh := hfirst.chain (reversedSet N L) (reversedSet N M)
      (hL.reversedSet N) (hM.reversedSet N) hkL hk₁L hk₂L hkM hk₁M hk₂M q
    rw [← hcomm] at hh
    exact (chain_exists_iff_reverse hy hsupp L M q).trans
      (hh.trans (chain_exists_iff_reverse hz hzbound L M q).symm)
  · intro κ _ q
    have hh := hfirst.packing κ q
    rw [← hcomm] at hh
    exact (packing_exists_iff_reverse hy hsupp κ q).trans
      (hh.trans (packing_exists_iff_reverse hz hzbound κ q).symm)

/-- Modified partners remain pairwise distinct even when the matching has an
edge internal to the distinguished triple. -/
theorem modifiedPartners_distinct {y : ℕ → ℕ} (hy : Function.Involutive y) (a : ℕ)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2) :
    modifiedPartner y a a ≠ modifiedPartner y a (a + 1) ∧
      modifiedPartner y a a ≠ modifiedPartner y a (a + 2) ∧
      modifiedPartner y a (a + 1) ≠ modifiedPartner y a (a + 2) := by
  by_cases hab : y a = a + 1
  · have hba : y (a + 1) = a := by simpa only [hab] using hy a
    have hca : y (a + 2) ≠ a := by
      intro hh; have hx := hy.injective (hh.trans hba.symm); omega
    have hcb : y (a + 2) ≠ a + 1 := by
      intro hh; have hx := hy.injective (hh.trans hab.symm); omega
    simp only [modifiedPartner, hab, hba, hca, hcb, hc, or_false, false_or,
      or_true, true_or, if_true, if_false]
    omega
  by_cases hac : y a = a + 2
  · have hca : y (a + 2) = a := by simpa only [hac] using hy a
    have hba : y (a + 1) ≠ a := by
      intro hh; have hx := hy.injective (hh.trans hca.symm); omega
    have hbc : y (a + 1) ≠ a + 2 := by
      intro hh; have hx := hy.injective (hh.trans hac.symm); omega
    simp only [modifiedPartner, hac, hca, hba, hb, hbc, or_false, false_or,
      or_true, true_or, if_true, if_false]
    omega
  by_cases hbc : y (a + 1) = a + 2
  · have hcb : y (a + 2) = a + 1 := by simpa only [hbc] using hy (a + 1)
    simp only [modifiedPartner, ha, hab, hac, hbc, hcb, or_false, false_or,
      or_true, true_or, if_true, if_false]
    omega
  · have hba : y (a + 1) ≠ a := by
      intro hh; have hx := congrArg y hh; rw [hy (a + 1)] at hx; exact hab hx.symm
    have hca : y (a + 2) ≠ a := by
      intro hh; have hx := congrArg y hh; rw [hy (a + 2)] at hx; exact hac hx.symm
    have hcb : y (a + 2) ≠ a + 1 := by
      intro hh; have hx := congrArg y hh; rw [hy (a + 2)] at hx; exact hbc hx.symm
    simp only [modifiedPartner, ha, hab, hac, hba, hb, hbc, hca, hcb, hc,
      or_false, if_false]
    exact ⟨fun hh => by have := hy.injective hh; omega,
      fun hh => by have := hy.injective hh; omega,
      fun hh => by have := hy.injective hh; omega⟩

/-- The matching transformation prescribed by the modified-partner median in
(2.4). The distinguished labels here are `a`, `a+1`, and `a+2`. -/
def medianTransform (y : ℕ → ℕ) (a : ℕ) : ℕ → ℕ :=
  if StrictMedian (modifiedPartner y a a) (modifiedPartner y a (a + 1))
      (modifiedPartner y a (a + 2)) then y
  else if StrictMedian (modifiedPartner y a a) (modifiedPartner y a (a + 2))
      (modifiedPartner y a (a + 1)) then conjugate (adjacent a) y
  else conjugate (adjacent (a + 1)) y

/-- Full local invariance from Lemma 2.2, with the actual modified-partner median,
actual one-use chains, arbitrary finite colored packings, and exact interval
bounds. The support parameter ranges over all finite ambient alphabets. -/
theorem median_statistics_invariant {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (hsupp : BoundedSupport y N) (a : ℕ) (hN : a + 2 ≤ N)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2) :
    StatisticsInvariant a y (medianTransform y a) := by
  classical
  by_cases hmid : StrictMedian (modifiedPartner y a a) (modifiedPartner y a (a + 1))
      (modifiedPartner y a (a + 2))
  · simpa only [medianTransform, if_pos hmid] using StatisticsInvariant.refl a y
  by_cases hfirst : StrictMedian (modifiedPartner y a a) (modifiedPartner y a (a + 2))
      (modifiedPartner y a (a + 1))
  · simpa only [medianTransform, if_neg hmid, if_pos hfirst] using
      first_median_invariant hy a ha hb hc hfirst
  · have hd := modifiedPartners_distinct hy a ha hb hc
    have hlast : StrictMedian (modifiedPartner y a (a + 1)) (modifiedPartner y a a)
        (modifiedPartner y a (a + 2)) := by
      unfold StrictMedian at *
      omega
    simpa only [medianTransform, if_neg hmid, if_neg hfirst] using
      last_median_invariant hy hsupp a hN ha hb hc hlast

theorem median_row_chain_exists_iff {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (hsupp : BoundedSupport y N) (a : ℕ) (hN : a + 2 ≤ N)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2)
    (L : Set ℕ) (hL : IsInterval L) (haL : a ∈ L) (hbL : a + 1 ∈ L)
    (hcL : a + 2 ∈ L) (q : ℕ) :
    (∃ C : Finset ℕ, IsChain y C ∧ C.card = q ∧ ∀ r ∈ C, r ∈ L) ↔
      (∃ C : Finset ℕ, IsChain (medianTransform y a) C ∧ C.card = q ∧ ∀ r ∈ C, r ∈ L) := by
  have hh := (median_statistics_invariant hy hsupp a hN ha hb hc).chain L Set.univ hL
    (by unfold IsInterval; intros; trivial) haL hbL hcL (by trivial) (by trivial) (by trivial) q
  simpa only [InRectangle, Set.mem_univ, and_true] using hh

theorem median_packing_exists_iff {y : ℕ → ℕ} (hy : Function.Involutive y)
    {N : ℕ} (hsupp : BoundedSupport y N) (a : ℕ) (hN : a + 2 ≤ N)
    (ha : y a ≠ a) (hb : y (a + 1) ≠ a + 1) (hc : y (a + 2) ≠ a + 2)
    (k q : ℕ) :
    (∃ P : Fin k → Finset ℕ, IsPacking y P ∧ packingSize P = q) ↔
      (∃ P : Fin k → Finset ℕ, IsPacking (medianTransform y a) P ∧ packingSize P = q) :=
  (median_statistics_invariant hy hsupp a hN ha hb hc).packing (Fin k) q

end FourPapers.Symmetric.MatchingChains
