      rw [hs,List.map_cons,List.map_append,map_dualLetter_eq_self (tripleFootprint_eq_nil_of_forall_lt hr)]
      have htail := map_dualLetter_pairInsert_two_high ht (1:Fin 3) 1 2
      have hhigh := pairInsert_high ht (0:Fin 3) 2
