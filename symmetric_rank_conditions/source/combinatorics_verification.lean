    · intro hr
      by_cases hrc : r < a + 2
      · exact Or.inl ⟨hr, hrc⟩
      by_cases heq : r = a + 2
      · exact Or.inr (Or.inl heq)
      · exact Or.inr (Or.inr ⟨hr, by omega⟩)
    · rintro (⟨hr, _⟩ | rfl | ⟨hr, _⟩) <;> assumption
  have hCcard : C.card = L.card + R.card + 2 := by
    rw [hCsplit]
    exact card_separated_two a (a + 1) (by omega)
