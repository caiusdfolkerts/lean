set_option maxHeartbeats 1000000

namespace FourPapers.Symmetric
open TauCeti HigherSpecht

theorem rowBump_map_on (f : ℕ → ℕ) (S : Set ℕ) (hf : StrictMonoOn f S)
    {a : ℕ} {row : List ℕ} (ha : a ∈ S) (hrow : ∀ x ∈ row, x ∈ S) :
    rowBump (f a) (row.map f) =
      ((rowBump a row).1.map f,(rowBump a row).2.map f) := by
  induction row with
  | nil => rfl
  | cons b row ih =>
    have hb : b ∈ S := hrow b (by simp)
    have ht : ∀ x ∈ row, x ∈ S := fun x hx => hrow x (by simp [hx])
    simp only [List.map_cons,rowBump_cons,hf.lt_iff_lt ha hb]
    split_ifs <;> simp only [List.map_cons,Option.map_some,ih ht]

theorem rowInsert_map_on_and_index (f : ℕ → ℕ) (S : Set ℕ)
    (hf : StrictMonoOn f S) {a : ℕ} {rows : List (List ℕ)}
    (ha : a ∈ S) (hrows : ∀ x ∈ rows.flatten, x ∈ S) :
    rowInsert (f a) (rows.map (List.map f)) = (rowInsert a rows).map (List.map f) ∧
      rowInsertIndex (f a) (rows.map (List.map f)) = rowInsertIndex a rows := by
  induction rows generalizing a with
  | nil => simp
  | cons row rows ih =>
    have hr : ∀ x ∈ row, x ∈ S := fun x hx => hrows x (List.mem_append_left _ hx)
    have ht : ∀ x ∈ rows.flatten, x ∈ S := fun x hx => hrows x (List.mem_append_right _ hx)
    have hmap := rowBump_map_on f S hf ha hr
    cases hb : (rowBump a row).2 with
    | none =>
      have hbn : (rowBump (f a) (row.map f)).2 = none := by rw [hmap,hb]; rfl
      constructor <;> simp only [List.map_cons,rowInsert_cons_of_eq_none rows hb,
        rowInsert_cons_of_eq_none _ hbn,rowInsertIndex_cons_of_eq_none rows hb,
        rowInsertIndex_cons_of_eq_none _ hbn,hmap]
    | some b =>
      have hbs : (rowBump (f a) (row.map f)).2 = some (f b) := by rw [hmap,hb]; rfl
      have hbS : b ∈ S := hr b (mem_of_rowBump_snd_eq_some hb)
      obtain ⟨hins,hindex⟩ := ih hbS ht
      constructor <;> simp only [List.map_cons,rowInsert_cons_of_eq_some rows hb,
        rowInsert_cons_of_eq_some _ hbs,rowInsertIndex_cons_of_eq_some rows hb,
        rowInsertIndex_cons_of_eq_some _ hbs,hmap,hins,hindex]

theorem pairInsert_map_on (f : ℕ → ℕ) (S : Set ℕ) (hf : StrictMonoOn f S)
    {a b : ℕ} {rows : List (List ℕ)} (ha : a ∈ S)
    (hrows : ∀ x ∈ rows.flatten, x ∈ S) :
    pairInsert (f a) (f b) (rows.map (List.map f)) =
      (pairInsert a b rows).map (List.map f) := by
  obtain ⟨hi,hj⟩ := rowInsert_map_on_and_index f S hf ha hrows
  unfold pairInsert
  rw [hi,hj,map_appendToRow]

theorem pairInsertList_map_on (f : ℕ → ℕ) (S : Set ℕ) (hf : StrictMonoOn f S)
    (pairs : List (ℕ × ℕ)) {rows : List (List ℕ)}
    (hpairs : ∀ x ∈ endpointWord pairs, x ∈ S)
    (hrows : ∀ x ∈ rows.flatten, x ∈ S) :
    pairInsertList (pairs.map fun p => (f p.1,f p.2)) (rows.map (List.map f)) =
      (pairInsertList pairs rows).map (List.map f) := by
  induction pairs generalizing rows with
  | nil => rfl
  | cons p pairs ih =>
    have ha : p.1 ∈ S := hpairs p.1 (by simp [endpointWord])
    have hb : p.2 ∈ S := hpairs p.2 (by simp [endpointWord])
    have ht : ∀ x ∈ endpointWord pairs, x ∈ S :=
      fun x hx => hpairs x (List.mem_append_right [p.1,p.2] hx)
    have hr : ∀ x ∈ (pairInsert p.1 p.2 rows).flatten, x ∈ S := by
      intro x hx
      have h := (flatten_pairInsert_perm _ _ _).mem_iff.mp hx
      simp only [List.mem_cons] at h
      rcases h with rfl | rfl | h
      · exact ha
      · exact hb
      · exact hrows x h
    simpa only [List.map_cons,pairInsertList_cons,pairInsert_map_on f S hf ha hrows] using
      ih ht hr

theorem fold_rowInsert_map_on (f : ℕ → ℕ) (S : Set ℕ) (hf : StrictMonoOn f S)
    (w : List ℕ) {rows : List (List ℕ)} (hw : ∀ x ∈ w, x ∈ S)
    (hrows : ∀ x ∈ rows.flatten, x ∈ S) :
    (w.map f).foldl (fun rows x => rowInsert x rows) (rows.map (List.map f)) =
      (w.foldl (fun rows x => rowInsert x rows) rows).map (List.map f) := by
  induction w generalizing rows with
  | nil => rfl
  | cons a w ih =>
    have ha : a ∈ S := hw a (by simp)
    have ht : ∀ x ∈ w, x ∈ S := fun x hx => hw x (by simp [hx])
    have hr : ∀ x ∈ (rowInsert a rows).flatten, x ∈ S := by
      intro x hx
      exact (mem_rowInsert.mp hx).elim (fun h => h ▸ ha) (hrows x)
    simp only [List.map_cons,List.foldl_cons,
      (rowInsert_map_on_and_index f S hf ha hrows).1,ih ht hr]

theorem swap_adjacent_strictMonoOn_compl_left (k : ℕ) :
    StrictMonoOn (Equiv.swap k (k+1)) {x : ℕ | x ≠ k} := by
  intro x hx y hy hxy
  apply swap_adjacent_lt hxy
  rintro ⟨rfl,rfl⟩
  exact hx rfl

theorem swap_adjacent_strictMonoOn_compl_right (k : ℕ) :
    StrictMonoOn (Equiv.swap k (k+1)) {x : ℕ | x ≠ k+1} := by
  intro x hx y hy hxy
  apply swap_adjacent_lt hxy
  rintro ⟨rfl,rfl⟩
  exact hy rfl

end FourPapers.Symmetric

