    have hD := hC.adjacent_unaffected a hrow hcol
    rw [conjugate_adjacent_twice] at hD
    refine ⟨D, hD, Finset.card_image_of_injective _ (adjacent a).injective, ?_⟩
    intro L M hL hM haL hbL hcL haM hbM hcM hrect
    have hr := hrect.adjacent a haL hbL haM hbM
    rwa [conjugate_adjacent_twice] at hr

/-- Both directions of the external move preserve the possible chain lengths
inside every interval rectangle containing the distinguished triple. -/
theorem chain_exists_iff (L M : Set ℕ) (hL : IsInterval L) (hM : IsInterval M)
    (haL : a ∈ L) (hbL : a + 1 ∈ L) (hcL : a + 2 ∈ L)
    (haM : a ∈ M) (hbM : a + 1 ∈ M) (hcM : a + 2 ∈ M) (q : ℕ) :
    (∃ C : Finset ℕ, IsChain y C ∧ C.card = q ∧ InRectangle y C L M) ↔
      (∃ C : Finset ℕ, IsChain (conjugate (adjacent a) y) C ∧
        C.card = q ∧ InRectangle (conjugate (adjacent a) y) C L M) := by
  constructor
  · rintro ⟨C, hC, hc, hrect⟩
    have hpartners : y a < y (a + 1) := by
      rw [e.left, e.middle]
      exact e.left_lt.trans e.right_lt
    refine ⟨C.image (adjacent a), hC.adjacent_forward e.involution a hpartners, ?_,
      hrect.adjacent a haL hbL haM hbM⟩
    rw [Finset.card_image_of_injective _ (adjacent a).injective, hc]
  · rintro ⟨C, hC, hc, hrect⟩
    obtain ⟨D, hD, hdcard, hdrect⟩ := e.reverse_chain hC
    exact ⟨D, hD, hdcard.trans hc,
      hdrect L M hL hM haL hbL hcL haM hbM hcM hrect⟩


