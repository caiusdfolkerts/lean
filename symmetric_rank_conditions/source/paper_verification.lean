@[simp] theorem schurCoordinateEquiv_symm_carrier (q : S) (i : Fin n) :
    (schurCoordinateEquiv q).symm (X (.inl i)) = X (.inl i) := by
  change triangularShift (-schurOffset q) (X (.inl i)) = _
  rw [triangularShift_X_left]

