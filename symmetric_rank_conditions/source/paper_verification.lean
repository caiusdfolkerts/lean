section

set_option autoImplicit false
set_option maxHeartbeats 800000

noncomputable section

/-!
# The literal rational-function form of pivot comparison

The main theorem below uses the monomial ideal over the original coefficient
field and the canonical inclusion `K[X] → K(X)`.  The finite-dimensional
hypothesis in `comparison_after_pivot` is supplied by a positive grading.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ D : Type*} [AddCommMonoid D] [DecidableEq D]

theorem map_weight (ρ : D →+ ℕ) (w : σ → D) (e : σ →₀ ℕ) :
    ρ (weight w e) = weight (fun i => ρ (w i)) e := by
  simp only [weight_apply, Finsupp.sum, map_sum, map_nsmul]

/-- A positive numerical coarsening of a multigrading makes every weight
fiber finite.  Endpoint gradings have this coarsening by summing coordinates. -/
theorem finite_weight_fibers_of_positive [Finite σ] (w : σ → D) (ρ : D →+ ℕ)
    (hpos : ∀ i, ρ (w i) ≠ 0) (d : D) :
    {e : σ →₀ ℕ | weight w e = d}.Finite := by
  apply (Finsupp.finite_of_nat_weight_eq (fun i => ρ (w i)) hpos (ρ d)).subset
  intro e he
  change weight (fun i => ρ (w i)) e = ρ d
  rw [← map_weight, he]

/-- For a grading by endpoint multiplicities, nonzero variable weights are
precisely the positivity needed for finite homogeneous pieces. -/
theorem finite_weight_fibers_finsupp {ι : Type*} [Finite σ]
    (w : σ → (ι →₀ ℕ)) (hpos : ∀ i, w i ≠ 0) (d : ι →₀ ℕ) :
    {e : σ →₀ ℕ | weight w e = d}.Finite := by
  classical
  exact finite_weight_fibers_of_positive w Finsupp.degree
    (fun i => (Finsupp.degree_eq_zero_iff (w i)).not.mpr (hpos i)) d

theorem endpointWeight_fibers_finite {n : ℕ} (d : Fin n →₀ ℕ) :
    {e : Entry n →₀ ℕ | weight endpointWeight e = d}.Finite := by
  apply finite_weight_fibers_finsupp endpointWeight
  intro i hi
  have h := congrArg Finsupp.degree hi
  simp only [endpointWeight, map_add, degree_single, map_zero] at h
  omega

section Field

variable {K : Type*} [Field K]

/-- Standard monomials of an ideal generated by monomials are exactly the
monomials not divisible by a specified generator. -/
theorem standardMonomials_monomial_span (m : MonomialOrder σ) (E : Set (σ →₀ ℕ)) :
    m.standardMonomials (Ideal.span ((fun e => monomial e (1 : K)) '' E)) =
      {e | ∀ a ∈ E, ¬ a ≤ e} := by
  classical
  ext e
  constructor
  · intro he a ha hae
    have hmem : monomial a (1 : K) ∈
        Ideal.span ((fun e => monomial e (1 : K)) '' E) :=
      Ideal.subset_span ⟨a, ha, rfl⟩
    have h := he (monomial a (1 : K)) hmem (by simp)
    exact h (by simpa only [m.degree_monomial, if_neg one_ne_zero] using hae)
  · intro he p hp hp0 hpe
    obtain ⟨a, ha, hap⟩ := MvPolynomial.mem_ideal_span_monomial_image.mp hp
      (m.degree p) (m.degree_mem_support hp0)
    exact he a ha (hap.trans hpe)

/-- Leading exponents after forgetting the pivot coordinate.  Zero proposed
generators are omitted, as required by the definition of a leading monomial. -/
def projectedLeadingExponents (m : MonomialOrder (Option σ))
    (G : Set (MvPolynomial (Option σ) K)) : Set (σ →₀ ℕ) :=
  (fun g => (m.degree g).some) '' (G \ {0})

/-- The paper's ideal `J ⊆ K[b,C]`, over the original coefficient field. -/
def pivotLeadingIdeal (m : MonomialOrder (Option σ))
    (G : Set (MvPolynomial (Option σ) K)) : Ideal (MvPolynomial σ K) :=
  Ideal.span ((fun e => monomial e (1 : K)) '' projectedLeadingExponents m G)

theorem standardMonomials_pivotLeadingIdeal
    (m : MonomialOrder (Option σ)) (m' : MonomialOrder σ)
    (G : Set (MvPolynomial (Option σ) K)) :
    m'.standardMonomials (pivotLeadingIdeal m G) =
      {e | ∀ g ∈ G, g ≠ 0 → ¬ (m.degree g).some ≤ e} := by
  rw [pivotLeadingIdeal, standardMonomials_monomial_span]
  ext e
  constructor
  · intro he g hg hg0
    exact he _ ⟨g, ⟨hg, by simpa using hg0⟩, rfl⟩
  · rintro he a ⟨g, ⟨hg, hg0⟩, rfl⟩
    exact he g hg (by simpa using hg0)

variable {F : Type*} [Field F]

/-- Identifies the paper's standard monomials over `K` with those excluded by
the proposed leading monomials over the generic coefficient field. -/
theorem standardMonomials_pivotLeadingIdeal_eq_normalExponents
    (φ : Polynomial K →+* F) (hφ : Function.Injective φ)
    (m : MonomialOrder (Option σ)) (m' : MonomialOrder σ)
    (G : Set (MvPolynomial (Option σ) K))
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (pivotMap φ g) = (m.degree g).some) :
    m'.standardMonomials (pivotLeadingIdeal m G) =
      normalExponents m' (pivotMap φ '' G) := by
  rw [standardMonomials_pivotLeadingIdeal]
  ext e
  constructor
  · rintro he p ⟨g, hg, rfl⟩ hp0
    have hg0 : g ≠ 0 := by intro h; apply hp0; rw [h, map_zero]
    simpa only [hdegree g hg hg0] using he g hg hg0
  · intro he g hg hg0
    have hp0 : pivotMap φ g ≠ 0 := by
      intro h
      exact hg0 ((pivotMap_injective φ hφ) (h.trans (map_zero _).symm))
    simpa only [hdegree g hg hg0] using he _ ⟨g, hg, rfl⟩ hp0

end Field

section Canonical

variable {K : Type*} [Field K] [Finite σ]

/-- The actual map from `K[x,b,C]` to `K(x)[b,C]`. -/
def genericPivotMap : MvPolynomial (Option σ) K →+* MvPolynomial σ (RatFunc K) :=
  pivotMap (algebraMap (Polynomial K) (RatFunc K))

theorem genericPivotMap_injective : Function.Injective (genericPivotMap (σ := σ) (K := K)) :=
  pivotMap_injective _ (RatFunc.algebraMap_injective K)

/-- Lemma 3.3, with the actual coefficient field `K(X)` and the actual monomial
ideal `J` over `K`.  Equality of the Hilbert-series coefficients is stated as
equality of dimensions in every degree, and positivity supplies finiteness. -/
theorem lemma_3_3
    (m : MonomialOrder (Option σ)) (m' : MonomialOrder σ)
    (H : Ideal (MvPolynomial (Option σ) K)) (G : Set (MvPolynomial (Option σ) K))
    (hGH : G ⊆ H)
    (hfree : ∀ g ∈ G, g ≠ 0 → m.degree g none = 0)
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (genericPivotMap g) = (m.degree g).some)
    (w : σ → D) (ρ : D →+ ℕ) (hpos : ∀ i, ρ (w i) ≠ 0)
    (hH : H.IsHomogeneous
      (weightedHomogeneousSubmodule K (fun o : Option σ => o.elim 0 w)))
    (hHilbert : ∀ d,
      {e : σ →₀ ℕ | e ∈ m'.standardMonomials (pivotLeadingIdeal m G) ∧
        weight w e = d}.ncard =
        Module.finrank (RatFunc K) (quotientPiece (H.map genericPivotMap) w d)) :
    m.IsGroebnerBasis G H := by
  apply comparison_after_pivot (algebraMap (Polynomial K) (RatFunc K))
    (RatFunc.algebraMap_injective K) m m' H G hGH hfree hdegree w hH
    (finite_weight_fibers_of_positive w ρ hpos)
  intro d
  rw [← standardMonomials_pivotLeadingIdeal_eq_normalExponents _
    (RatFunc.algebraMap_injective K) m m' G hdegree]
  exact hHilbert d

end Canonical


section SymmetricEndpoint

variable {n : ℕ} {K : Type*} [Field K]

/-- The diagonal pivot as a genuine nonzero element of the rational-function field. -/
def genericPivotScalar (K : Type*) [Field K] : RatFunc K :=
  algebraMap (Polynomial K) (RatFunc K) Polynomial.X

theorem genericPivotScalar_ne_zero (K : Type*) [Field K] : genericPivotScalar K ≠ 0 :=
  (map_ne_zero_iff _ (RatFunc.algebraMap_injective K)).mpr Polynomial.X_ne_zero

/-- The exact map from the original symmetric coordinate ring into the
polynomial ring over the generic pivot field. -/
def symmetricGenericPivotMap : CoordinateRing (n + 1) K →+*
    MvPolynomial (PivotVariables n) (RatFunc K) :=
  genericPivotMap.comp pivotCoordinateEquiv.toRingHom

theorem symmetricGenericPivotMap_injective :
    Function.Injective (symmetricGenericPivotMap (n := n) (K := K)) :=
  genericPivotMap_injective.comp pivotCoordinateEquiv.injective

@[simp] theorem symmetricGenericPivotMap_pivot :
    symmetricGenericPivotMap (X (fold (0 : Fin (n + 1)) 0) : CoordinateRing (n + 1) K) =
      C (genericPivotScalar K) := by
  change genericPivotMap (pivotCoordinateEquiv _) = _
  rw [pivotCoordinateEquiv_pivot]
  exact pivotMap_X_none _

@[simp] theorem symmetricGenericPivotMap_carrier (i : Fin n) :
    symmetricGenericPivotMap (X (fold 0 i.succ) : CoordinateRing (n + 1) K) =
      X (Sum.inl i) := by
  change genericPivotMap (pivotCoordinateEquiv _) = _
  rw [pivotCoordinateEquiv_carrier]
  exact pivotMap_X_some _ _

@[simp] theorem symmetricGenericPivotMap_residual (i j : Fin n) :
    symmetricGenericPivotMap (X (fold i.succ j.succ) : CoordinateRing (n + 1) K) =
      X (Sum.inr (fold i j)) := by
  change genericPivotMap (pivotCoordinateEquiv _) = _
  rw [pivotCoordinateEquiv_residual]
  exact pivotMap_X_some _ _

/-- Every nonpivot variable in the symmetric endpoint grading has positive
numerical degree.  This discharges the finiteness hypothesis of Lemma 3.3. -/
theorem pivotEndpointWeight_positive (i : PivotVariables n) :
    Finsupp.degree (pivotEndpointWeight i) ≠ 0 := by
  cases i with
  | inl i => simp [pivotEndpointWeight, Finsupp.degree_single]
  | inr e => simp [pivotEndpointWeight, endpointWeight, map_add, Finsupp.degree_single]

theorem pivotEndpointWeight_fibers_finite (d : Fin n →₀ ℕ) :
    {e : PivotVariables n →₀ ℕ | weight pivotEndpointWeight e = d}.Finite :=
  finite_weight_fibers_of_positive pivotEndpointWeight Finsupp.degree
    pivotEndpointWeight_positive d

/-- The literal symmetric-matrix instance of Lemma 3.3.  The grading is fixed
to the manuscript's `deg x = 0`, `deg bᵢ = eᵢ`, `deg Cᵢⱼ = eᵢ+eⱼ`; no
finiteness or positivity hypothesis remains to be supplied by an application. -/
theorem lemma_3_3_symmetric
    (m : MonomialOrder (Option (PivotVariables n)))
    (m' : MonomialOrder (PivotVariables n))
    (H : Ideal (MvPolynomial (Option (PivotVariables n)) K))
    (G : Set (MvPolynomial (Option (PivotVariables n)) K))
    (hGH : G ⊆ H)
    (hfree : ∀ g ∈ G, g ≠ 0 → m.degree g none = 0)
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (genericPivotMap g) = (m.degree g).some)
    (hH : H.IsHomogeneous
      (weightedHomogeneousSubmodule K (fun o => o.elim 0 pivotEndpointWeight)))
    (hHilbert : ∀ d,
      {e : PivotVariables n →₀ ℕ |
        e ∈ m'.standardMonomials (pivotLeadingIdeal m G) ∧
        weight pivotEndpointWeight e = d}.ncard =
          Module.finrank (RatFunc K)
            (quotientPiece (H.map genericPivotMap) pivotEndpointWeight d)) :
    m.IsGroebnerBasis G H :=
  lemma_3_3 m m' H G hGH hfree hdegree
    pivotEndpointWeight Finsupp.degree pivotEndpointWeight_positive hH hHilbert

end SymmetricEndpoint

end FourPapers.Symmetric.Pivot
end
