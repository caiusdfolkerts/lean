set_option maxHeartbeats 1000000

noncomputable section

/-!
# Free carriers and homogeneous quotient dimensions

Adjoining carrier variables preserves a Gröbner basis whenever the monomial
order restricts correctly on the residual variables. The proof extracts each
carrier coefficient of a remainder, using actual polynomial-ring isomorphisms.
The resulting standard monomials are exactly pairs of a free carrier monomial
and a residual standard monomial. This gives the precise degreewise Hilbert
recurrence used with first-row deletion.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp
open scoped MonomialOrder

attribute [local instance] MvPolynomial.weightedGradedAlgebra

section Splitting

variable {σ τ R : Type*} [CommRing R]

def carrierPart (a : (σ ⊕ τ) →₀ ℕ) : σ →₀ ℕ :=
  a.comapDomain Sum.inl Sum.inl_injective.injOn

def residualPart (a : (σ ⊕ τ) →₀ ℕ) : τ →₀ ℕ :=
  a.comapDomain Sum.inr Sum.inr_injective.injOn

@[simp] theorem carrierPart_apply (a : (σ ⊕ τ) →₀ ℕ) (i : σ) :
    carrierPart a i = a (Sum.inl i) := rfl

@[simp] theorem residualPart_apply (a : (σ ⊕ τ) →₀ ℕ) (i : τ) :
    residualPart a i = a (Sum.inr i) := rfl

@[simp] theorem carrierPart_sumElim (c : σ →₀ ℕ) (e : τ →₀ ℕ) :
    carrierPart (c.sumElim e) = c := Finsupp.comapDomain_inl_sumElim c e

@[simp] theorem residualPart_sumElim (c : σ →₀ ℕ) (e : τ →₀ ℕ) :
    residualPart (c.sumElim e) = e := Finsupp.comapDomain_inr_sumElim c e

@[simp] theorem sumElim_parts (a : (σ ⊕ τ) →₀ ℕ) :
    (carrierPart a).sumElim (residualPart a) = a :=
  Finsupp.comapDomain_sumElim_comapDomain a

/-- A residual monomial divides a mixed monomial precisely when it divides
its residual part. Carrier exponents impose no additional restrictions. -/
theorem mapDomain_inr_le_iff (e : τ →₀ ℕ) (a : (σ ⊕ τ) →₀ ℕ) :
    e.mapDomain Sum.inr ≤ a ↔ e ≤ residualPart a := by
  constructor
  · intro h i
    simpa only [Finsupp.mapDomain_apply_of_injective Sum.inr_injective, residualPart_apply] using h (Sum.inr i)
  · intro h i
    cases i with
    | inl i =>
      rw [Finsupp.mapDomain_of_notMem_range e (Sum.inl i) (by simp)]
      exact Nat.zero_le _
    | inr i =>
      simpa only [Finsupp.mapDomain_apply_of_injective Sum.inr_injective, residualPart_apply] using h i

/-- The coefficient in the two-stage polynomial presentation is exactly
the coefficient of the combined exponent in the original presentation. -/
theorem sumRingEquiv_coeff_coeff (p : MvPolynomial (σ ⊕ τ) R)
    (c : σ →₀ ℕ) (e : τ →₀ ℕ) :
    ((sumRingEquiv R σ τ p).coeff c).coeff e = p.coeff (c.sumElim e) := by
  change (AddMonoidAlgebra.mapDomainRingEquiv R
    Finsupp.sumFinsuppAddEquivProdFinsupp p).coeff (c, e) = _
  rw [AddMonoidAlgebra.coeff_mapDomainRingEquiv, Finsupp.equivMapDomain_apply]
  rfl

/-- The polynomial-variable split carries the residual-variable embedding
exactly to the coefficient embedding. -/
theorem sumRingEquiv_comp_rename_inr :
    (sumRingEquiv R σ τ).toRingHom.comp
        (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom =
      (C : MvPolynomial τ R →+* MvPolynomial σ (MvPolynomial τ R)) := by
  apply RingHom.ext
  intro p
  change sumRingEquiv R σ τ (rename Sum.inr p) = C p
  induction p using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp => simp only [map_mul, rename_X, sumRingEquiv_X_inr, hp]

/-- Membership in the actual extended ideal is coefficientwise membership
in the original residual ideal. -/
theorem mem_rename_inr_ideal_iff (I : Ideal (MvPolynomial τ R))
    (p : MvPolynomial (σ ⊕ τ) R) :
    p ∈ I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom ↔
      ∀ c, (sumRingEquiv R σ τ p).coeff c ∈ I := by
  have hmap : (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom).map
      (sumRingEquiv R σ τ).toRingHom = I.map C := by
    rw [Ideal.map_map, sumRingEquiv_comp_rename_inr]
  constructor
  · intro hp
    apply MvPolynomial.mem_map_C_iff.mp
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ hp
  · intro hp
    have hmem : sumRingEquiv R σ τ p ∈ I.map C :=
      MvPolynomial.mem_map_C_iff.mpr hp
    rw [← hmap] at hmem
    obtain ⟨q, hq, hqp⟩ := (Ideal.mem_map_iff_of_surjective
      (sumRingEquiv R σ τ).toRingHom (sumRingEquiv R σ τ).surjective).mp hmem
    exact (sumRingEquiv R σ τ).injective hqp ▸ hq

end Splitting

section GroebnerExtension

variable {σ τ K : Type*} [Field K]

/-- A Gröbner basis survives adjoining free variables under every order
whose generator leading exponents restrict to the original order. -/
theorem isGroebnerBasis_rename_inr
    (m : MonomialOrder τ) (m' : MonomialOrder (σ ⊕ τ))
    (I : Ideal (MvPolynomial τ K)) (G : Set (MvPolynomial τ K))
    (hG : m.IsGroebnerBasis G I)
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (rename (Sum.inr : τ → σ ⊕ τ) g) = (m.degree g).mapDomain Sum.inr) :
    m'.IsGroebnerBasis (rename (Sum.inr : τ → σ ⊕ τ) '' G)
      (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom) := by
  classical
  let J := I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom
  have hsubset : rename (Sum.inr : τ → σ ⊕ τ) '' G ⊆ J := by
    rintro _ ⟨g, hg, rfl⟩
    exact Ideal.mem_map_of_mem _ (hG.subset hg)
  apply MonomialOrder.isGroebnerBasis_iff_isRemainder_zero.mpr
  refine ⟨hsubset, ?_⟩
  intro f hf
  obtain ⟨r, hr⟩ := MonomialOrder.exists_isRemainder (m := m')
    (fun _ _ hp => m'.isUnit_leadingCoeff.mpr hp) f
  have hrJ : r ∈ J := by
    have h := J.sub_mem hf ((Ideal.span_le.mpr hsubset) hr.sub_mem_span)
    simpa only [sub_sub_cancel] using h
  have hr0 : r = 0 := by
    by_contra hne
    have hsplit : sumRingEquiv K σ τ r ≠ 0 := by
      intro hz
      exact hne ((sumRingEquiv K σ τ).injective (hz.trans (map_zero _).symm))
    obtain ⟨c, hc⟩ := MvPolynomial.exists_coeff_ne_zero hsplit
    have hcI : (sumRingEquiv K σ τ r).coeff c ∈ I :=
      (mem_rename_inr_ideal_iff I r).mp hrJ c
    obtain ⟨g, hg, hg0, hdiv⟩ := hG.exists_degree_le_degree hcI hc
    have hsupp : c.sumElim (m.degree ((sumRingEquiv K σ τ r).coeff c)) ∈ r.support := by
      rw [MvPolynomial.mem_support_iff, ← sumRingEquiv_coeff_coeff]
      exact MvPolynomial.mem_support_iff.mp (m.degree_mem_support hc)
    have hgmap : rename (Sum.inr : τ → σ ⊕ τ) g ≠ 0 := by
      intro hz
      exact hg0 ((MvPolynomial.rename_injective _ Sum.inr_injective)
        (hz.trans (map_zero _).symm))
    apply hr.not_degree_le hsupp ⟨g, hg, rfl⟩ hgmap
    rw [hdegree g hg hg0, mapDomain_inr_le_iff, residualPart_sumElim]
    exact hdiv
  simpa only [hr0] using hr

/-- Actual standard monomials of an extended ideal are exactly the monomials
whose residual parts are standard for the original ideal. -/
theorem standardMonomials_rename_inr
    (m : MonomialOrder τ) (m' : MonomialOrder (σ ⊕ τ))
    (I : Ideal (MvPolynomial τ K))
    (hdegree : ∀ p : MvPolynomial τ K,
      m'.degree (rename (Sum.inr : τ → σ ⊕ τ) p) = (m.degree p).mapDomain Sum.inr) :
    m'.standardMonomials (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom) =
      {a | residualPart a ∈ m.standardMonomials I} := by
  have hGB := isGroebnerBasis_rename_inr m m' I (I : Set _) (MonomialOrder.isGroebnerBasis_self I)
    (fun p _ _ => hdegree p)
  ext a
  change (a ∈ m'.standardMonomials _) ↔ residualPart a ∈ m.standardMonomials I
  rw [hGB.mem_standardMonomials_iff, MonomialOrder.mem_standardMonomials_iff]
  constructor
  · intro ha p hp hp0 hdiv
    apply ha (rename Sum.inr p) ⟨p, hp, rfl⟩
      (fun hz => hp0 ((MvPolynomial.rename_injective _ Sum.inr_injective)
        (hz.trans (map_zero _).symm)))
    rw [hdegree, mapDomain_inr_le_iff]
    exact hdiv
  · rintro ha _ ⟨p, hp, rfl⟩ hp0 hdiv
    have hpne : p ≠ 0 := by intro hz; apply hp0; rw [hz, map_zero]
    rw [hdegree, mapDomain_inr_le_iff] at hdiv
    exact ha p hp hpne hdiv

end GroebnerExtension

section HomogeneousPieces

variable {σ τ K D : Type*} [Field K] [AddCommMonoid D] [DecidableEq D]

theorem weight_sumElim (w : σ → D) (v : τ → D) (c : σ →₀ ℕ) (e : τ →₀ ℕ) :
    weight (Sum.elim w v) (c.sumElim e) = weight w c + weight v e := by
  simp only [weight_apply, Finsupp.sum_sumElim, Function.comp_def, Sum.elim_inl, Sum.elim_inr]

theorem rename_inr_isWeightedHomogeneous (w : σ → D) (v : τ → D)
    {p : MvPolynomial τ K} {d : D} (hp : p.IsWeightedHomogeneous v d) :
    (rename (Sum.inr : τ → σ ⊕ τ) p).IsWeightedHomogeneous (Sum.elim w v) d := by
  apply isWeightedHomogeneous_algHom (rename Sum.inr) v (Sum.elim w v) _ hp
  intro i
  rw [rename_X]
  exact isWeightedHomogeneous_X (R := K) (Sum.elim w v) (Sum.inr i)

theorem rename_inr_homogeneousIdeal (I : Ideal (MvPolynomial τ K))
    (w : σ → D) (v : τ → D)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K v)) :
    (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule K (Sum.elim w v)) := by
  classical
  obtain ⟨T, hT⟩ := (Ideal.IsHomogeneous.iff_exists _ _).mp hI
  rw [hT, Ideal.map_span]
  apply Ideal.homogeneous_span
  rintro p ⟨q, ⟨t, ht, rfl⟩, rfl⟩
  obtain ⟨d, hd⟩ := t.2
  exact ⟨d, rename_inr_isWeightedHomogeneous w v hd⟩

/-- The exact free-carrier/residual-standard set in a homogeneous degree. -/
def carrierStandardPieceSet (m : MonomialOrder τ) (I : Ideal (MvPolynomial τ K))
    (w : σ → D) (v : τ → D) (d : D) : Set ((σ →₀ ℕ) × (τ →₀ ℕ)) :=
  {p | p.2 ∈ m.standardMonomials I ∧ weight w p.1 + weight v p.2 = d}

/-- The actual standard exponents of the extended ideal are in bijection
with carrier/residual-standard pairs, preserving the exact multidegree. -/
def standardPieceCarrierEquiv
    (m : MonomialOrder τ) (m' : MonomialOrder (σ ⊕ τ))
    (I : Ideal (MvPolynomial τ K))
    (hdegree : ∀ p : MvPolynomial τ K,
      m'.degree (rename (Sum.inr : τ → σ ⊕ τ) p) = (m.degree p).mapDomain Sum.inr)
    (w : σ → D) (v : τ → D) (d : D) :
    standardPieceSet m' (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom)
      (Sum.elim w v) d ≃ carrierStandardPieceSet m I w v d where
  toFun a := ⟨(carrierPart a.val, residualPart a.val), by
    refine ⟨?_, ?_⟩
    · have ha : a.val ∈ m'.standardMonomials
          (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom) := a.2.1
      rw [standardMonomials_rename_inr m m' I hdegree] at ha
      exact ha
    · have h := weight_sumElim w v (carrierPart a.val) (residualPart a.val)
      rw [sumElim_parts] at h
      exact h.symm.trans a.2.2⟩
  invFun p := ⟨p.val.1.sumElim p.val.2, by
    refine ⟨?_, ?_⟩
    · rw [standardMonomials_rename_inr m m' I hdegree]
      simpa only [Set.mem_setOf_eq, residualPart_sumElim] using p.2.1
    · exact (weight_sumElim w v p.val.1 p.val.2).trans p.2.2⟩
  left_inv a := by
    apply Subtype.ext
    change (carrierPart a.val).sumElim (residualPart a.val) = a.val
    exact sumElim_parts a.val
  right_inv p := by
    apply Subtype.ext
    change (carrierPart (p.val.1.sumElim p.val.2),
      residualPart (p.val.1.sumElim p.val.2)) = p.val
    exact Prod.ext (carrierPart_sumElim _ _) (residualPart_sumElim _ _)

/-- Hilbert multiplicativity with free variables, stated as the exact
finite coefficient count needed by the carrier bijection. -/
theorem finrank_quotientPiece_rename_inr
    (m : MonomialOrder τ) (m' : MonomialOrder (σ ⊕ τ))
    (I : Ideal (MvPolynomial τ K))
    (hdegree : ∀ p : MvPolynomial τ K,
      m'.degree (rename (Sum.inr : τ → σ ⊕ τ) p) = (m.degree p).mapDomain Sum.inr)
    (w : σ → D) (v : τ → D)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K v))
    (hfinite : ∀ d, {a : (σ ⊕ τ) →₀ ℕ | weight (Sum.elim w v) a = d}.Finite)
    (d : D) :
    Module.finrank K (quotientPiece (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom)
      (Sum.elim w v) d) = (carrierStandardPieceSet m I w v d).ncard := by
  rw [finrank_quotientPiece m' _ _ (rename_inr_homogeneousIdeal I w v hI) d
    ((hfinite d).subset (fun _ h => h.2))]
  exact Set.ncard_congr' (standardPieceCarrierEquiv m m' I hdegree w v d)

end HomogeneousPieces

section OrderEmbedding

variable {α β : Type*} [LinearOrder α] [LinearOrder β]
  [WellFoundedGT α] [WellFoundedGT β]

/-- Grevlex restricts to every order-embedded family of variables. Exponents
outside that family are zero, so they cannot provide a differing coordinate. -/
theorem grevlex_mapDomain_lt_iff_orderEmbedding (e : α ↪o β) (a b : α →₀ ℕ) :
    a.mapDomain e ≺[TauCeti.MonomialOrder.degRevLex] b.mapDomain e ↔
      a ≺[TauCeti.MonomialOrder.degRevLex] b := by
  rw [TauCeti.MonomialOrder.degRevLex_lt_iff,
    TauCeti.MonomialOrder.degRevLex_lt_iff,
    TauCeti.DegRevLex.lt_iff_exists, TauCeti.DegRevLex.lt_iff_exists]
  simp only [TauCeti.ofDegRevLex_toDegRevLex, Finsupp.degree_mapDomain]
  apply or_congr_right
  apply and_congr_right
  intro _
  constructor
  · rintro ⟨i, htail, hvalue⟩
    by_cases hi : i ∈ Set.range e
    · obtain ⟨j, rfl⟩ := hi
      refine ⟨j, ?_, ?_⟩
      · intro k hjk
        simpa only [Finsupp.mapDomain_apply_of_injective e.injective] using
          htail (e k) (e.strictMono hjk)
      · simpa only [Finsupp.mapDomain_apply_of_injective e.injective] using hvalue
    · rw [Finsupp.mapDomain_of_notMem_range a i hi,
        Finsupp.mapDomain_of_notMem_range b i hi] at hvalue
      exact (Nat.lt_irrefl 0 hvalue).elim
  · rintro ⟨i, htail, hvalue⟩
    refine ⟨e i, ?_, ?_⟩
    · intro j hij
      by_cases hj : j ∈ Set.range e
      · obtain ⟨k, rfl⟩ := hj
        simpa only [Finsupp.mapDomain_apply_of_injective e.injective] using
          htail k (e.lt_iff_lt.mp hij)
      · rw [Finsupp.mapDomain_of_notMem_range a j hj,
          Finsupp.mapDomain_of_notMem_range b j hj]
    · simpa only [Finsupp.mapDomain_apply_of_injective e.injective] using hvalue

theorem grevlex_mapDomain_le_iff_orderEmbedding (e : α ↪o β) (a b : α →₀ ℕ) :
    a.mapDomain e ≼[TauCeti.MonomialOrder.degRevLex] b.mapDomain e ↔
      a ≼[TauCeti.MonomialOrder.degRevLex] b := by
  simpa only [not_lt] using not_congr (grevlex_mapDomain_lt_iff_orderEmbedding e b a)

theorem grevlex_degree_rename_orderEmbedding {R : Type*} [CommRing R]
    (e : α ↪o β) (p : MvPolynomial α R) :
    TauCeti.MonomialOrder.degRevLex.degree (rename e p) =
      (TauCeti.MonomialOrder.degRevLex.degree p).mapDomain e :=
  MonomialOrder.degree_rename (m := TauCeti.MonomialOrder.degRevLex)
    (m' := TauCeti.MonomialOrder.degRevLex) (fun a b => (grevlex_mapDomain_le_iff_orderEmbedding e a b).symm) p

end OrderEmbedding

section SymmetricCarriers

variable {n : ℕ}

local instance : LinearOrder (PivotVariables n) := pivotVariableLinearOrder n
local instance carrierPivotChosenLE : LE (PivotVariables n) :=
  (pivotVariableLinearOrder n).toLE
local instance carrierPivotChosenLT : LT (PivotVariables n) :=
  (pivotVariableLinearOrder n).toLT
local instance carrierPivotChosenPreorder : Preorder (PivotVariables n) :=
  (pivotVariableLinearOrder n).toPreorder
local instance carrierPivotWellFoundedGT : WellFoundedGT (PivotVariables n) :=
  (wellFounded_gt (α := Entry (n + 1))).onFun

/-- The smaller folded variable order embeds exactly into the inherited
residual order, even though carrier variables occur between residual variables. -/
def pivotResidualEntryOrderEmbedding : Entry n ↪o PivotVariables n where
  toFun := Sum.inr
  inj' := Sum.inr_injective
  map_rel_iff' := by
    intro e f
    change (toLex (e.val.1.succ, e.val.2.succ) ≤
        toLex (f.val.1.succ, f.val.2.succ)) ↔
      toLex (e.val.1, e.val.2) ≤ toLex (f.val.1, f.val.2)
    simp only [Prod.Lex.toLex_le_toLex, Fin.succ_lt_succ_iff,
      Fin.succ_le_succ_iff, Fin.succ_inj]

theorem pivotResidual_degree_rename_inr {R : Type*} [CommRing R]
    (p : CoordinateRing n R) :
    (pivotResidualOrder n).degree
      (rename (Sum.inr : Entry n → PivotVariables n) p) =
        ((foldedOrder n).degree p).mapDomain Sum.inr :=
  grevlex_degree_rename_orderEmbedding pivotResidualEntryOrderEmbedding p

/-- The carrier weight is precisely its exponent vector, not only its total degree. -/
theorem carrier_weight_eq (c : Fin n →₀ ℕ) :
    weight (fun i : Fin n => Finsupp.single i 1) c = c := by
  rw [weight_apply]
  simpa only [Finsupp.smul_single, smul_eq_mul, mul_one] using c.sum_single

variable {K : Type*} [Field K]

/-- The exact degree-`d` pairs appearing in Lemma3.2: free carrier exponents
and residual standard monomials, with their full endpoint multiplicities. -/
def symmetricCarrierStandards (I : Ideal (CoordinateRing n K))
    (d : Fin n →₀ ℕ) : Set ((Fin n →₀ ℕ) × (Entry n →₀ ℕ)) :=
  {p | p.2 ∈ (foldedOrder n).standardMonomials I ∧
    p.1 + weight endpointWeight p.2 = d}

/-- The precise standard-monomial equivalence behind the coefficient count. -/
def symmetricCarrierStandardEquiv (I : Ideal (CoordinateRing n K)) (d : Fin n →₀ ℕ) :
    standardPieceSet (pivotResidualOrder n)
      (I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom)
      pivotEndpointWeight d ≃ symmetricCarrierStandards I d := by
  simpa only [pivotEndpointWeight, carrierStandardPieceSet, symmetricCarrierStandards,
    carrier_weight_eq] using
      standardPieceCarrierEquiv (foldedOrder n) (pivotResidualOrder n) I
        pivotResidual_degree_rename_inr
        (fun i : Fin n => Finsupp.single i 1) endpointWeight d


/-- The actual generic-chart quotient has exactly the carrier/residual
standard-monomial Hilbert count. Every finite-dimensional hypothesis is proved
for the fixed positive endpoint grading. -/
theorem finrank_symmetric_carrier_quotient
    (I : Ideal (CoordinateRing n K))
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K endpointWeight))
    (d : Fin n →₀ ℕ) :
    Module.finrank K (quotientPiece
      (I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom)
      pivotEndpointWeight d) = (symmetricCarrierStandards I d).ncard := by
  have hI' : (I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule K pivotEndpointWeight) :=
    rename_inr_homogeneousIdeal I (fun i : Fin n => Finsupp.single i 1) endpointWeight hI
  rw [finrank_quotientPiece (pivotResidualOrder n) _ pivotEndpointWeight hI' d
    ((pivotEndpointWeight_fibers_finite d).subset (fun _ h => h.2))]
  exact Set.ncard_congr' (symmetricCarrierStandardEquiv I d)

/-- After an actual Schur ideal identity has been proved, the generic-fiber
quotient in Lemma3.3 has exactly the free-carrier/residual-standard count.
This is the full Hilbert-function bridge, with no formal series or dimension
identity assumed as an additional hypothesis. -/
theorem finrank_genericPivot_quotient_eq_carriers
    (H : Ideal (CoordinateRing (n + 1) K))
    (I : Ideal (CoordinateRing n (RatFunc K)))
    (hchart : H.map (genericFirstPivotChart (n := n) K) =
      I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule (RatFunc K) endpointWeight))
    (d : Fin n →₀ ℕ) :
    Module.finrank (RatFunc K)
      (quotientPiece ((H.map pivotCoordinateEquiv.toRingHom).map genericPivotMap)
        pivotEndpointWeight d) = (symmetricCarrierStandards I d).ncard := by
  let e := (schurCoordinateEquiv (n := n) (genericPivotScalar K)⁻¹).symm
  have hmap : I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom =
      ((H.map pivotCoordinateEquiv.toRingHom).map genericPivotMap).map e.toRingHom := by
    simp only [Ideal.map_map]
    change I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom =
      H.map (genericFirstPivotChart (n := n) K)
    exact hchart.symm
  have hgraded : ∀ p d, p.IsWeightedHomogeneous pivotEndpointWeight d ↔
      (e p).IsWeightedHomogeneous pivotEndpointWeight d := by
    intro p d
    have h := schurCoordinateEquiv_isWeightedHomogeneous_iff
      (genericPivotScalar K)⁻¹
      ((schurCoordinateEquiv (genericPivotScalar K)⁻¹).symm p) d
    simpa only [AlgEquiv.apply_symm_apply] using h.symm
  exact (finrank_quotientPiece_eq_of_gradedEquiv e _ _ hmap
    pivotEndpointWeight pivotEndpointWeight hgraded d).trans
      (finrank_symmetric_carrier_quotient I hI d)


/-- A concrete degree-preserving carrier bijection and a concrete Schur
ideal identity supply all Hilbert hypotheses of the original-coordinate
comparison theorem. This is the assembly point for the combinatorial
first-row deletion theorem and the algebraic rank/symbolic chart. -/
theorem groebner_of_exact_carrier_equivalences
    (H : Ideal (CoordinateRing (n + 1) K))
    (G : Set (CoordinateRing (n + 1) K)) (hGH : G ⊆ H)
    (hhom : ∀ g ∈ G, g ≠ 0 → ∃ d, g.IsHomogeneous d)
    (hfree : ∀ g ∈ G, g ≠ 0 →
      ((foldedOrder (n + 1)).degree g) (fold 0 0) = 0)
    (hH : (H.map pivotCoordinateEquiv.toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule K (fun o => o.elim 0 pivotEndpointWeight)))
    (I : Ideal (CoordinateRing n (RatFunc K)))
    (hchart : H.map (genericFirstPivotChart (n := n) K) =
      I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule (RatFunc K) endpointWeight))
    (hcounts : ∀ d,
      {e : PivotVariables n →₀ ℕ |
        e ∈ (pivotResidualOrder n).standardMonomials
          (pivotLeadingIdeal (pivotFullOrder n) (pivotCoordinateEquiv '' G)) ∧
        weight pivotEndpointWeight e = d} ≃ symmetricCarrierStandards I d) :
    (foldedOrder (n + 1)).IsGroebnerBasis G H := by
  apply comparison_original_symmetric H G hGH hhom hfree hH
  intro d
  exact (Set.ncard_congr' (hcounts d)).trans
    (finrank_genericPivot_quotient_eq_carriers H I hchart hI d).symm

end SymmetricCarriers

end FourPapers.Symmetric.Pivot
