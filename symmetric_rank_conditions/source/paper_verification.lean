section

set_option autoImplicit false
set_option maxHeartbeats 800000
noncomputable section

namespace FourPapers.Symmetric

/-- The genuine off-diagonal pivot block, with its free diagonal entry retained. -/
def offDiagonalPivotBlock {R : Type*} [Zero R] (x y : R) :
    Matrix (PUnit.{1} ⊕ PUnit.{1}) (PUnit.{1} ⊕ PUnit.{1}) R :=
  Matrix.of (fun i j => match i, j with
    | Sum.inl _, Sum.inl _ => 0
    | Sum.inl _, Sum.inr _ => x
    | Sum.inr _, Sum.inl _ => x
    | Sum.inr _, Sum.inr _ => y)

/-- The block `(0,x;x,y)` is invertible whenever `x` has an actual inverse.
The inverse formula is `(-yq²,q;q,0)`, valid in every characteristic. -/
theorem offDiagonalPivotBlock_isUnit {R : Type*} [CommRing R]
    (x y q : R) (hqx : q * x = 1) : IsUnit (offDiagonalPivotBlock x y) := by
  classical
  let B : Matrix (PUnit.{1} ⊕ PUnit.{1}) (PUnit.{1} ⊕ PUnit.{1}) R :=
    Matrix.of (fun i j => match i, j with
      | Sum.inl _, Sum.inl _ => -(y * q ^ 2)
      | Sum.inl _, Sum.inr _ => q
      | Sum.inr _, Sum.inl _ => q
      | Sum.inr _, Sum.inr _ => 0)
  have hxq : x * q = 1 := by simpa only [mul_comm] using hqx
  have hAB : offDiagonalPivotBlock x y * B = 1 := by
    ext i j
    cases i <;> cases j <;>
      simp [B, offDiagonalPivotBlock, Matrix.mul_apply, Fintype.sum_sum_type, hqx, hxq]
    all_goals linear_combination -(y * q) * hqx
  have hBA : B * offDiagonalPivotBlock x y = 1 := by
    ext i j
    cases i <;> cases j <;>
      simp [B, offDiagonalPivotBlock, Matrix.mul_apply, Fintype.sum_sum_type, hqx, hxq]
    all_goals linear_combination -(y * q) * hqx
  exact ⟨⟨offDiagonalPivotBlock x y, B, hAB, hBA⟩, rfl⟩

/-- Adjoining arbitrary zero rows to an actual matrix. -/
def zeroRowsMatrix {R m n p : Type*} [Zero R] (D : Matrix m n R) : Matrix (p ⊕ m) n R :=
  Matrix.of (fun i j => Sum.elim (fun _ => 0) (fun i => D i j) i)

/-- Adjoining arbitrary zero columns to an actual matrix. -/
def zeroColsMatrix {R m n p : Type*} [Zero R] (D : Matrix m n R) : Matrix m (p ⊕ n) R :=
  Matrix.of (fun i j => Sum.elim (fun _ => 0) (fun j => D i j) j)

theorem matrixMinorIdeal_zeroRows {R m n p : Type*} [CommRing R] [Fintype m]
    (D : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (zeroRowsMatrix (p := p) D) t = matrixMinorIdeal D t := by
  classical
  let L : Matrix (p ⊕ m) m R :=
    Matrix.of (fun i j => Sum.elim (fun _ => 0) (fun i => (1 : Matrix m m R) i j) i)
  have hL : L * D = zeroRowsMatrix D := by
    ext i j
    cases i <;> simp [L, zeroRowsMatrix, Matrix.mul_apply, Matrix.one_apply, ite_mul]
  apply le_antisymm
  · rw [← hL]
    exact matrixMinorIdeal_mul_left_le L D t
  · exact matrixMinorIdeal_submatrix_le (zeroRowsMatrix (p := p) D) Sum.inr id t

theorem matrixMinorIdeal_zeroCols {R m n p : Type*} [CommRing R] [Fintype n]
    (D : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (zeroColsMatrix (p := p) D) t = matrixMinorIdeal D t := by
  rw [← matrixMinorIdeal_transpose (zeroColsMatrix (p := p) D)]
  change matrixMinorIdeal (zeroRowsMatrix (p := p) D.transpose) t = matrixMinorIdeal D t
  rw [matrixMinorIdeal_zeroRows, matrixMinorIdeal_transpose]

theorem matrixRank_zeroRows {K m n p : Type*} [Field K] [Fintype m] [Fintype n]
    (D : Matrix m n K) : (zeroRowsMatrix (p := p) D).rank = D.rank := by
  classical
  let L : Matrix (p ⊕ m) m K :=
    Matrix.of (fun i j => Sum.elim (fun _ => 0) (fun i => (1 : Matrix m m K) i j) i)
  have hL : L * D = zeroRowsMatrix D := by
    ext i j
    cases i <;> simp [L, zeroRowsMatrix, Matrix.mul_apply, Matrix.one_apply, ite_mul]
  apply le_antisymm
  · rw [← hL]
    exact Matrix.rank_mul_le_right L D
  · exact Matrix.rank_submatrix_le (zeroRowsMatrix (p := p) D) Sum.inr id

theorem matrixRank_zeroCols {K m n p : Type*} [Field K] [Fintype m] [Fintype n] [Fintype p]
    (D : Matrix m n K) : (zeroColsMatrix (p := p) D).rank = D.rank := by
  rw [← Matrix.rank_transpose (zeroColsMatrix (p := p) D)]
  change (zeroRowsMatrix (p := p) D.transpose).rank = D.rank
  rw [matrixRank_zeroRows, Matrix.rank_transpose]

/-- The one-row part of the off-diagonal pivot seen by a prefix ending before
`k` in rows and at or beyond `k` in columns. -/
def offDiagonalHalfPivot {R : Type*} [Zero R] (x : R) :
    Matrix PUnit.{1} (PUnit.{1} ⊕ PUnit.{1}) R :=
  Matrix.of (fun _ => Sum.elim (fun _ => 0) (fun _ => x))

theorem singletonMatrix_isUnit {R : Type*} [CommRing R] (x : R) (hx : IsUnit x) :
    IsUnit (Matrix.of (fun (_ _ : PUnit.{1}) => x) : Matrix PUnit.{1} PUnit.{1} R) := by
  apply (Matrix.isUnit_iff_isUnit_det _).mpr
  simpa only [Matrix.det_unique, Matrix.of_apply] using hx

/-- A prefix seeing only one side of the isolated off-diagonal pivot has one
unit contribution. The unused zero column is retained and then rigorously deleted. -/
theorem matrixMinorIdeal_offDiagonal_half {R m n : Type*} [CommRing R]
    [Fintype m] [Fintype n] (D : Matrix m n R) (x : R) (hx : IsUnit x) (t : ℕ) :
    matrixMinorIdeal (Matrix.fromBlocks (offDiagonalHalfPivot x) 0 0 D) (t + 1) =
      matrixMinorIdeal D t := by
  classical
  let A : Matrix PUnit.{1} PUnit.{1} R := Matrix.of (fun _ _ => x)
  have he : (Matrix.fromBlocks (offDiagonalHalfPivot x) 0 0 D).submatrix
      (Equiv.refl (PUnit.{1} ⊕ m)) (Equiv.sumAssoc PUnit.{1} PUnit.{1} n).symm =
      zeroColsMatrix (p := PUnit.{1}) (Matrix.fromBlocks A 0 0 D) := by
    ext i j
    rcases i with i | i <;> rcases j with j | (j | j) <;> rfl
  rw [← matrixMinorIdeal_submatrix_equiv _ (Equiv.refl (PUnit.{1} ⊕ m))
    (Equiv.sumAssoc PUnit.{1} PUnit.{1} n).symm, he, matrixMinorIdeal_zeroCols]
  simpa only [Fintype.card_unique] using
    matrixMinorIdeal_fromBlocks_unit_first A D (singletonMatrix_isUnit x hx) t

/-- The corresponding statement for actual ranks. -/
theorem matrixRank_offDiagonal_half {K m n : Type*} [Field K]
    [Fintype m] [Fintype n] (D : Matrix m n K) (x : K) (hx : x ≠ 0) :
    (Matrix.fromBlocks (offDiagonalHalfPivot x) 0 0 D).rank = D.rank + 1 := by
  classical
  let A : Matrix PUnit.{1} PUnit.{1} K := Matrix.of (fun _ _ => x)
  have he : (Matrix.fromBlocks (offDiagonalHalfPivot x) 0 0 D).submatrix
      (Equiv.refl (PUnit.{1} ⊕ m)) (Equiv.sumAssoc PUnit.{1} PUnit.{1} n).symm =
      zeroColsMatrix (p := PUnit.{1}) (Matrix.fromBlocks A 0 0 D) := by
    ext i j
    rcases i with i | i <;> rcases j with j | (j | j) <;> rfl
  rw [← Matrix.rank_submatrix _ (Equiv.refl (PUnit.{1} ⊕ m))
    (Equiv.sumAssoc PUnit.{1} PUnit.{1} n).symm, he, matrixRank_zeroCols]
  simpa only [Fintype.card_unique] using
    matrixRank_fromBlocks_unit_first A D (singletonMatrix_isUnit x (isUnit_iff_ne_zero.mpr hx))

/-- The actual smaller symmetric Schur matrix in the off-diagonal branch. -/
def offDiagonalResidualMatrix {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (k : Fin (n + 1)) (q : R) :
    Matrix (Fin n) (Fin n) R :=
  (offDiagonalSchurMatrix w k.succ q).submatrix
    (offDiagonalResidualEmbedding k) (offDiagonalResidualEmbedding k)

theorem offDiagonalSchurMatrix_symmetric {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (q : R) :
    (offDiagonalSchurMatrix w k q).transpose = offDiagonalSchurMatrix w k q := by
  ext i j
  have hji : w j i = w i j := congrFun (congrFun hw i) j
  simp only [offDiagonalSchurMatrix, Matrix.of_apply, Matrix.transpose_apply, hji]
  ring

theorem offDiagonalResidualMatrix_symmetric {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (q : R) :
    (offDiagonalResidualMatrix w k q).transpose = offDiagonalResidualMatrix w k q := by
  unfold offDiagonalResidualMatrix
  rw [Matrix.transpose_submatrix, offDiagonalSchurMatrix_symmetric w hw]

/-- The residual submatrix in the actual eliminated matrix is the explicit
Schur matrix on precisely the undeleted indices. -/
theorem offDiagonalEliminated_residualMatrix {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (q : R) (hqx : q * w 0 k.succ = 1)
    (hzero : ∀ j < k.succ, w 0 j = 0) :
    (offDiagonalEliminator w k.succ q * w *
      (offDiagonalEliminator w k.succ q).transpose).submatrix
        (offDiagonalResidualEmbedding k) (offDiagonalResidualEmbedding k) =
      offDiagonalResidualMatrix w k q := by
  ext i j
  have hj := (offDiagonalResidualEmbedding_mem_range k
    (offDiagonalResidualEmbedding k j)).mp ⟨j, rfl⟩
  exact offDiagonalEliminated_residual w hw k.succ (Fin.succ_ne_zero k) q hqx hzero
    (offDiagonalResidualEmbedding k i) (offDiagonalResidualEmbedding k j) hj.1 hj.2

/-- After the explicit order-preserving deletion, the eliminated matrix is
literally the direct sum of the invertible pivot and the smaller symmetric matrix. -/
theorem offDiagonalEliminated_blocks {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (q : R) (hqx : q * w 0 k.succ = 1)
    (hzero : ∀ j < k.succ, w 0 j = 0) :
    (offDiagonalEliminator w k.succ q * w *
      (offDiagonalEliminator w k.succ q).transpose).submatrix
        (twoIndicesEquiv k) (twoIndicesEquiv k) =
      Matrix.fromBlocks (offDiagonalPivotBlock (w 0 k.succ) (w k.succ k.succ))
        0 0 (offDiagonalResidualMatrix w k q) := by
  let L := offDiagonalEliminator w k.succ q
  let M := L * w * L.transpose
  have hs : M.transpose = M := by
    simp only [M, Matrix.transpose_mul, Matrix.transpose_transpose, hw, Matrix.mul_assoc]
  have hs' : ∀ i j, M i j = M j i := fun i j =>
    (congrFun (congrFun hs i) j).symm
  have h0 := offDiagonalEliminated_first_row w k.succ (Fin.succ_ne_zero k) q hqx hzero
  have hk := offDiagonalEliminated_pivot_row w hw k.succ (Fin.succ_ne_zero k) q hqx hzero
  have hr := offDiagonalEliminated_residualMatrix w hw k q hqx hzero
  change M.submatrix (twoIndicesEquiv k) (twoIndicesEquiv k) = _
  ext i j
  rcases i with (i | i) | i <;> rcases j with (j | j) | j
  · simpa [Matrix.submatrix_apply, offDiagonalPivotBlock, M, L,
      Ne.symm (Fin.succ_ne_zero k)] using h0 0
  · simpa [Matrix.submatrix_apply, offDiagonalPivotBlock, M, L] using h0 k.succ
  · have hj := (offDiagonalResidualEmbedding_mem_range k
      (offDiagonalResidualEmbedding k j)).mp ⟨j, rfl⟩
    simpa [Matrix.submatrix_apply, offDiagonalPivotBlock, M, L, hj.2] using
      h0 (offDiagonalResidualEmbedding k j)
  · simpa [Matrix.submatrix_apply, offDiagonalPivotBlock, M, L] using hk 0
  · simpa [Matrix.submatrix_apply, offDiagonalPivotBlock, M, L] using hk k.succ
  · have hj := (offDiagonalResidualEmbedding_mem_range k
      (offDiagonalResidualEmbedding k j)).mp ⟨j, rfl⟩
    simpa [Matrix.submatrix_apply, offDiagonalPivotBlock, M, L, hj.1, hj.2] using
      hk (offDiagonalResidualEmbedding k j)
  · change M (offDiagonalResidualEmbedding k i) 0 = 0
    rw [hs']
    have hi := (offDiagonalResidualEmbedding_mem_range k
      (offDiagonalResidualEmbedding k i)).mp ⟨i, rfl⟩
    simpa [M, L, hi.2] using h0 (offDiagonalResidualEmbedding k i)
  · change M (offDiagonalResidualEmbedding k i) k.succ = 0
    rw [hs']
    have hi := (offDiagonalResidualEmbedding_mem_range k
      (offDiagonalResidualEmbedding k i)).mp ⟨i, rfl⟩
    simpa [M, L, hi.1, hi.2] using hk (offDiagonalResidualEmbedding k i)
  · exact congrFun (congrFun hr i) j

/-- Actual total rank drops by two under an off-diagonal first pivot, without
classifying the matrix by a partial permutation. -/
theorem matrixRank_offDiagonalResidual {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F) (hw : w.transpose = w)
    (k : Fin (n + 1)) (hx : w 0 k.succ ≠ 0)
    (hzero : ∀ j < k.succ, w 0 j = 0) :
    w.rank = (offDiagonalResidualMatrix w k (w 0 k.succ)⁻¹).rank + 2 := by
  let L := offDiagonalEliminator w k.succ (w 0 k.succ)⁻¹
  have hL : IsUnit L := by
    apply (Matrix.isUnit_iff_isUnit_det _).mpr
    rw [Matrix.det_of_isLowerTriangular L (offDiagonalEliminator_lower w k.succ _)]
    simp only [L, offDiagonalEliminator_diagonal, Finset.prod_const_one]
    exact isUnit_one
  have hLt : IsUnit L.transpose := by
    apply (Matrix.isUnit_iff_isUnit_det _).mpr
    rw [Matrix.det_transpose]
    exact (Matrix.isUnit_iff_isUnit_det _).mp hL
  rw [← matrixRank_mul_mul_of_isUnit L w L.transpose hL hLt,
    ← Matrix.rank_submatrix (L * w * L.transpose) (twoIndicesEquiv k) (twoIndicesEquiv k)]
  rw [offDiagonalEliminated_blocks w hw k _ (inv_mul_cancel₀ hx) hzero,
    matrixRank_fromBlocks_unit_first _ _
      (offDiagonalPivotBlock_isUnit _ _ _ (inv_mul_cancel₀ hx))]
  simp

end FourPapers.Symmetric
end
