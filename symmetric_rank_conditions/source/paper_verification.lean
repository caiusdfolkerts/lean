theorem matrixMinorIdeal_offDiagonal_half_transpose {R m n : Type*} [CommRing R]
    [Fintype m] [Fintype n] (D : Matrix m n R) (x : R) (hx : IsUnit x) (t : ℕ) :
    matrixMinorIdeal (Matrix.fromBlocks (offDiagonalHalfPivot x).transpose 0 0 D) (t + 1) =
      matrixMinorIdeal D t := by
  rw [← matrixMinorIdeal_transpose
    (Matrix.fromBlocks (offDiagonalHalfPivot x).transpose 0 0 D)]
  simp only [Matrix.fromBlocks_transpose, Matrix.transpose_transpose, Matrix.transpose_zero]
  rw [matrixMinorIdeal_offDiagonal_half D.transpose x hx t, matrixMinorIdeal_transpose]

theorem matrixRank_offDiagonal_half_transpose {K m n : Type*} [Field K]
    [Fintype m] [Fintype n] (D : Matrix m n K) (x : K) (hx : x ≠ 0) :
    (Matrix.fromBlocks (offDiagonalHalfPivot x).transpose 0 0 D).rank = D.rank + 1 := by
  rw [← Matrix.rank_transpose
    (Matrix.fromBlocks (offDiagonalHalfPivot x).transpose 0 0 D)]
  simp only [Matrix.fromBlocks_transpose, Matrix.transpose_transpose, Matrix.transpose_zero]
  rw [matrixRank_offDiagonal_half D.transpose x hx, Matrix.rank_transpose]

/-- An isolated off-diagonal pivot contributes zero, one, or two to each
prefix rank and lowers the corresponding minor size by exactly the same
amount. The realizing matrix and the matrix of ring elements may live over
unrelated fields or rings. -/
theorem isolatedPrefix_rank_condition {n : ℕ} {R F : Type*} [CommRing R] [Field F]
    (M : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (D : Matrix (Fin n) (Fin n) R)
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F) (v : Matrix (Fin n) (Fin n) F)
    (k : Fin (n + 1)) (x y q : R) (u z : F) (hqx : q * x = 1) (hu : u ≠ 0)
    (hM : M.submatrix (twoIndicesEquiv k) (twoIndicesEquiv k) =
      Matrix.fromBlocks (offDiagonalPivotBlock x y) 0 0 D)
    (hw : w.submatrix (twoIndicesEquiv k) (twoIndicesEquiv k) =
      Matrix.fromBlocks (offDiagonalPivotBlock u z) 0 0 v)
    (i j : Fin (n + 2)) :
    matrixMinorIdeal (northwestSubtypeMatrix M i j) (matrixRankArray w i j + 1) =
      matrixMinorIdeal (inducedPrefixMatrix D (offDiagonalResidualEmbedding k) i j)
        ((inducedPrefixMatrix v (offDiagonalResidualEmbedding k) i j).rank + 1) := by
  classical
  have hx : IsUnit x := IsUnit.of_mul_eq_one_right q hqx
  by_cases hi : i < k.succ
  · by_cases hj : j < k.succ
    · have hr : matrixRankArray w i j =
          (inducedPrefixMatrix v (offDiagonalResidualEmbedding k) i j).rank := by
        change (northwestSubtypeMatrix w i j).rank = _
        rw [← Matrix.rank_submatrix _ (offDiagonalPrefixBeforeEquiv k i hi)
          (offDiagonalPrefixBeforeEquiv k j hj),
          isolatedPrefix_before_before w v k u z hw i j hi hj, matrixRank_fromBlocks_zero]
      rw [hr, ← matrixMinorIdeal_submatrix_equiv _ (offDiagonalPrefixBeforeEquiv k i hi)
        (offDiagonalPrefixBeforeEquiv k j hj),
        isolatedPrefix_before_before M D k x y hM i j hi hj, matrixMinorIdeal_fromBlocks_zero]
    · have hj' : k.succ ≤ j := le_of_not_gt hj
      have hr : matrixRankArray w i j =
          (inducedPrefixMatrix v (offDiagonalResidualEmbedding k) i j).rank + 1 := by
        change (northwestSubtypeMatrix w i j).rank = _
        rw [← Matrix.rank_submatrix _ (offDiagonalPrefixBeforeEquiv k i hi)
          (offDiagonalPrefixAfterEquiv k j hj'),
          isolatedPrefix_before_after w v k u z hw i j hi hj', matrixRank_offDiagonal_half _ u hu]
      rw [hr, ← matrixMinorIdeal_submatrix_equiv _ (offDiagonalPrefixBeforeEquiv k i hi)
        (offDiagonalPrefixAfterEquiv k j hj'),
        isolatedPrefix_before_after M D k x y hM i j hi hj',
        matrixMinorIdeal_offDiagonal_half _ x hx]
  · have hi' : k.succ ≤ i := le_of_not_gt hi
    by_cases hj : j < k.succ
    · have hr : matrixRankArray w i j =
          (inducedPrefixMatrix v (offDiagonalResidualEmbedding k) i j).rank + 1 := by
        change (northwestSubtypeMatrix w i j).rank = _
        rw [← Matrix.rank_submatrix _ (offDiagonalPrefixAfterEquiv k i hi')
          (offDiagonalPrefixBeforeEquiv k j hj),
          isolatedPrefix_after_before w v k u z hw i j hi' hj,
          matrixRank_offDiagonal_half_transpose _ u hu]
      rw [hr, ← matrixMinorIdeal_submatrix_equiv _ (offDiagonalPrefixAfterEquiv k i hi')
        (offDiagonalPrefixBeforeEquiv k j hj),
        isolatedPrefix_after_before M D k x y hM i j hi' hj,
        matrixMinorIdeal_offDiagonal_half_transpose _ x hx]
    · have hj' : k.succ ≤ j := le_of_not_gt hj
      have hr : matrixRankArray w i j =
          (inducedPrefixMatrix v (offDiagonalResidualEmbedding k) i j).rank + 2 := by
        change (northwestSubtypeMatrix w i j).rank = _
        rw [← Matrix.rank_submatrix _ (offDiagonalPrefixAfterEquiv k i hi')
          (offDiagonalPrefixAfterEquiv k j hj'),
          isolatedPrefix_after_after w v k u z hw i j hi' hj',
          matrixRank_fromBlocks_unit_first _ _
            (offDiagonalPivotBlock_isUnit u z u⁻¹ (inv_mul_cancel₀ hu))]
        simp
      rw [hr, ← matrixMinorIdeal_submatrix_equiv _ (offDiagonalPrefixAfterEquiv k i hi')
        (offDiagonalPrefixAfterEquiv k j hj'),
        isolatedPrefix_after_after M D k x y hM i j hi' hj']
      have h := matrixMinorIdeal_fromBlocks_unit_first (offDiagonalPivotBlock x y)
        (inducedPrefixMatrix D (offDiagonalResidualEmbedding k) i j)
        (offDiagonalPivotBlock_isUnit x y q hqx)
        ((inducedPrefixMatrix v (offDiagonalResidualEmbedding k) i j).rank + 1)
      simpa only [Fintype.card_sum, Fintype.card_unique, Nat.add_assoc,
        Nat.add_comm 1 2] using h

/-- The complete rank-ideal recurrence for the isolated off-diagonal block.
All smaller prefixes occur, so the equality includes every condition in both
directions, not merely an inclusion from selected minors. -/
theorem northwestMatrixIdeal_isolated_offDiagonal {n : ℕ} {R F : Type*}
    [CommRing R] [Field F]
    (M : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (D : Matrix (Fin n) (Fin n) R)
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F) (v : Matrix (Fin n) (Fin n) F)
    (k : Fin (n + 1)) (x y q : R) (u z : F) (hqx : q * x = 1) (hu : u ≠ 0)
    (hM : M.submatrix (twoIndicesEquiv k) (twoIndicesEquiv k) =
      Matrix.fromBlocks (offDiagonalPivotBlock x y) 0 0 D)
    (hw : w.submatrix (twoIndicesEquiv k) (twoIndicesEquiv k) =
      Matrix.fromBlocks (offDiagonalPivotBlock u z) 0 0 v) :
    northwestMatrixIdeal M (matrixRankArray w) = northwestMatrixIdeal D (matrixRankArray v) := by
  rw [← iSup_inducedPrefix_minorIdeals D v (offDiagonalResidualEmbedding k)]
  unfold northwestMatrixIdeal
  congr 1
  funext i
  congr 1
  funext j
  rw [← northwestSubtype_minorIdeal]
  exact isolatedPrefix_rank_condition M D w v k x y q u z hqx hu hM hw i j

/-- Exact off-diagonal Schur recurrence for the original matrices, before
elimination. The actual realizing matrix is transformed over its own field;
the generic coordinate matrix is transformed over its own coefficient ring. -/
theorem northwestMatrixIdeal_offDiagonalSchur {n : ℕ} {R F : Type*}
    [CommRing R] [Field F]
    (M : Matrix (Fin (n + 2)) (Fin (n + 2)) R) (hM : M.transpose = M)
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F) (hw : w.transpose = w)
    (k : Fin (n + 1)) (q : R) (hqx : q * M 0 k.succ = 1)
    (hMzero : ∀ j < k.succ, M 0 j = 0)
    (hwx : w 0 k.succ ≠ 0) (hwzero : ∀ j < k.succ, w 0 j = 0) :
    northwestMatrixIdeal M (matrixRankArray w) =
      northwestMatrixIdeal (offDiagonalResidualMatrix M k q)
        (matrixRankArray (offDiagonalResidualMatrix w k (w 0 k.succ)⁻¹)) := by
  let LM := offDiagonalEliminator M k.succ q
  let Lw := offDiagonalEliminator w k.succ (w 0 k.succ)⁻¹
  have hwrank : matrixRankArray (Lw * w * Lw.transpose) = matrixRankArray w :=
    matrixRankArray_lower_congruence Lw w (offDiagonalEliminator_lower w k.succ _)
      (fun i => by
        change IsUnit (offDiagonalEliminator w k.succ (w 0 k.succ)⁻¹ i i)
        rw [offDiagonalEliminator_diagonal]
        exact isUnit_one)
  rw [← northwestMatrixIdeal_offDiagonalElimination M k.succ q, ← hwrank]
  exact northwestMatrixIdeal_isolated_offDiagonal
    (LM * M * LM.transpose) (offDiagonalResidualMatrix M k q)
    (Lw * w * Lw.transpose) (offDiagonalResidualMatrix w k (w 0 k.succ)⁻¹)
    k (M 0 k.succ) (M k.succ k.succ) q (w 0 k.succ) (w k.succ k.succ) hqx hwx
    (offDiagonalEliminated_blocks M hM k q hqx hMzero)
    (offDiagonalEliminated_blocks w hw k _ (inv_mul_cancel₀ hwx) hwzero)

end FourPapers.Symmetric
end
