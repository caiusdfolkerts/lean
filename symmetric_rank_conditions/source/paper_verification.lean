/-- Restricting rows and columns cannot enlarge the fixed-size minors ideal. -/
theorem matrixMinorIdeal_submatrix_le {R m n p q : Type*} [CommRing R]
    (M : Matrix m n R) (a : p → m) (b : q → n) (t : ℕ) :
    matrixMinorIdeal (M.submatrix a b) t ≤ matrixMinorIdeal M t := by
  apply Ideal.span_le.mpr
  rintro _ ⟨u, v, rfl⟩
  exact det_submatrix_mem_matrixMinorIdeal M t (a ∘ u) (b ∘ v)

/-- Adding zero rows and columns leaves every determinantal ideal unchanged. -/
theorem matrixMinorIdeal_fromBlocks_zero {R m n p q : Type*} [CommRing R]
    [Fintype m] [Fintype n] (D : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (Matrix.fromBlocks (0 : Matrix p q R) 0 0 D) t =
      matrixMinorIdeal D t := by
  classical
  let L : Matrix (p ⊕ m) m R :=
    fun i j => Sum.elim (fun _ => 0) (fun i => (1 : Matrix m m R) i j) i
  let Q : Matrix n (q ⊕ n) R :=
    fun i j => Sum.elim (fun _ => 0) (fun j => (1 : Matrix n n R) i j) j
  have he : L * D * Q = Matrix.fromBlocks (0 : Matrix p q R) 0 0 D := by
    ext i j
    simp only [Matrix.mul_apply]
    cases i <;> cases j <;> simp [L, Q, Matrix.one_apply, mul_ite, ite_mul]
  apply le_antisymm
  · rw [← he]
    exact matrixMinorIdeal_mul_mul_le L D Q t
  · exact matrixMinorIdeal_submatrix_le
      (Matrix.fromBlocks (0 : Matrix p q R) 0 0 D) Sum.inr Sum.inr t

/-- Adding zero rows and columns leaves actual matrix rank unchanged. -/
theorem matrixRank_fromBlocks_zero {K m n p q : Type*} [Field K]
    [Fintype m] [Fintype n] [Fintype q] (D : Matrix m n K) :
    (Matrix.fromBlocks (0 : Matrix p q K) 0 0 D).rank = D.rank := by
  classical
  let L : Matrix (p ⊕ m) m K :=
    fun i j => Sum.elim (fun _ => 0) (fun i => (1 : Matrix m m K) i j) i
  let Q : Matrix n (q ⊕ n) K :=
    fun i j => Sum.elim (fun _ => 0) (fun j => (1 : Matrix n n K) i j) j
  have he : L * D * Q = Matrix.fromBlocks (0 : Matrix p q K) 0 0 D := by
    ext i j
    simp only [Matrix.mul_apply]
    cases i <;> cases j <;> simp [L, Q, Matrix.one_apply, mul_ite, ite_mul]
  apply le_antisymm
  · rw [← he]
    exact (Matrix.rank_mul_le_left (L * D) Q).trans (Matrix.rank_mul_le_right L D)
  · exact Matrix.rank_submatrix_le
      (Matrix.fromBlocks (0 : Matrix p q K) 0 0 D) Sum.inr Sum.inr

/-- The matrix obtained by deleting the first row and column. -/
def firstDeletedMatrix {m n : ℕ} {R : Type*}
    (M : Matrix (Fin (m + 1)) (Fin (n + 1)) R) : Matrix (Fin m) (Fin n) R :=
  M.submatrix Fin.succ Fin.succ

/-- Deleting the same first row and column preserves symmetry. -/
theorem firstDeletedMatrix_symmetric {n : ℕ} {R : Type*}
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (hw : w.transpose = w) :
    (firstDeletedMatrix w).transpose = firstDeletedMatrix w := by
  change (w.submatrix Fin.succ Fin.succ).transpose = w.submatrix Fin.succ Fin.succ
  rw [Matrix.transpose_submatrix, hw]

/-- Deleting a zero first row and first column preserves all minor ideals. -/
theorem matrixMinorIdeal_first_zero {m n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin (m + 1)) (Fin (n + 1)) R)
    (hrow : ∀ j, M 0 j = 0) (hcol : ∀ i, M i 0 = 0) (t : ℕ) :
    matrixMinorIdeal M t = matrixMinorIdeal (firstDeletedMatrix M) t := by
  have hs : M.submatrix (firstIndexEquiv m) (firstIndexEquiv n) =
      Matrix.fromBlocks (0 : Matrix PUnit.{1} PUnit.{1} R) 0 0 (firstDeletedMatrix M) := by
    ext i j
    cases i <;> cases j <;>
      simp [Matrix.submatrix_apply, firstDeletedMatrix, hrow, hcol]
  rw [← matrixMinorIdeal_submatrix_equiv M (firstIndexEquiv m) (firstIndexEquiv n) t,
    hs, matrixMinorIdeal_fromBlocks_zero]

/-- Deleting a zero first row and first column preserves actual rank. -/
theorem matrixRank_first_zero {m n : ℕ} {K : Type*} [Field K]
    (M : Matrix (Fin (m + 1)) (Fin (n + 1)) K)
    (hrow : ∀ j, M 0 j = 0) (hcol : ∀ i, M i 0 = 0) :
    M.rank = (firstDeletedMatrix M).rank := by
  have hs : M.submatrix (firstIndexEquiv m) (firstIndexEquiv n) =
      Matrix.fromBlocks (0 : Matrix PUnit.{1} PUnit.{1} K) 0 0 (firstDeletedMatrix M) := by
    ext i j
    cases i <;> cases j <;>
      simp [Matrix.submatrix_apply, firstDeletedMatrix, hrow, hcol]
  rw [← Matrix.rank_submatrix M (firstIndexEquiv m) (firstIndexEquiv n),
    hs, matrixRank_fromBlocks_zero]

@[simp] theorem firstDeleted_northwestPrefix {n : ℕ} {R : Type*}
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (i j : Fin n) :
    firstDeletedMatrix (northwestPrefixMatrix w i.succ j.succ) =
      northwestPrefixMatrix (firstDeletedMatrix w) i j := by
  ext a b
  rfl

/-- The zero-row rank recurrence concerns the actual realizing matrix. -/
theorem matrixRankArray_first_zero {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) K)
    (hrow : ∀ j, w 0 j = 0) (hcol : ∀ i, w i 0 = 0) (i j : Fin n) :
    matrixRankArray w i.succ j.succ = matrixRankArray (firstDeletedMatrix w) i j := by
  rw [← northwestPrefixMatrix_rank, ← northwestPrefixMatrix_rank]
  have h := matrixRank_first_zero (northwestPrefixMatrix w i.succ j.succ)
    (fun p => hrow (northwestPrefixEmbedding j.succ p))
    (fun p => hcol (northwestPrefixEmbedding i.succ p))
  simpa only [firstDeleted_northwestPrefix] using h

/-- Every prefix of a zero first row has rank zero. -/
theorem matrixRankArray_zero_row {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) K) (hrow : ∀ j, w 0 j = 0)
    (j : Fin (n + 1)) : matrixRankArray w 0 j = 0 := by
  rw [← northwestPrefixMatrix_rank]
  have hzero : northwestPrefixMatrix w 0 j = 0 := by
    ext p q
    have hp : p = 0 := by
      apply Fin.ext
      have h := p.isLt
      simp only [Fin.val_zero] at h ⊢
      omega
    subst p
    exact hrow (northwestPrefixEmbedding j q)
  rw [hzero, Matrix.rank_zero]

/-- Every positive-size minor of the zero matrix is zero. -/
theorem matrixMinorIdeal_zero {m n : Type*} {R : Type*} [CommRing R] (t : ℕ) :
    matrixMinorIdeal (0 : Matrix m n R) (t + 1) = ⊥ := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨a, b, rfl⟩
    simp
  · exact bot_le

/-- The exact northwest ideal after deleting a first row and column whose
entries are already zero in the coefficient ring. -/
theorem northwestMatrixIdeal_first_zero {n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (hrow : ∀ j, M 0 j = 0) (hcol : ∀ i, M i 0 = 0) (r : RankArray (n + 1)) :
    northwestMatrixIdeal M r =
      northwestMatrixIdeal (firstDeletedMatrix M) (fun i j => r i.succ j.succ) := by
  have hchart (i j : Fin n) :
      matrixMinorIdeal (northwestPrefixMatrix M i.succ j.succ) (r i.succ j.succ + 1) =
      matrixMinorIdeal (northwestPrefixMatrix (firstDeletedMatrix M) i j)
        (r i.succ j.succ + 1) := by
    have h := matrixMinorIdeal_first_zero (northwestPrefixMatrix M i.succ j.succ)
      (fun p => hrow (northwestPrefixEmbedding j.succ p))
      (fun p => hcol (northwestPrefixEmbedding i.succ p)) (r i.succ j.succ + 1)
    simpa only [firstDeleted_northwestPrefix] using h
  have hrowPrefix (j : Fin (n + 1)) : northwestPrefixMatrix M 0 j = 0 := by
    ext p q
    have hp : p = 0 := by
      apply Fin.ext
      have h := p.isLt
      simp only [Fin.val_zero] at h ⊢
      omega
    subst p
    exact hrow (northwestPrefixEmbedding j q)
  have hcolPrefix (i : Fin (n + 1)) : northwestPrefixMatrix M i 0 = 0 := by
    ext p q
    have hq : q = 0 := by
      apply Fin.ext
      have h := q.isLt
      simp only [Fin.val_zero] at h ⊢
      omega
    subst q
    exact hcol (northwestPrefixEmbedding i p)
  apply le_antisymm
  · apply iSup_le
    intro i
    apply iSup_le
    intro j
    refine Fin.cases ?_ (fun i => ?_) i
    · rw [hrowPrefix, matrixMinorIdeal_zero]
      exact bot_le
    · refine Fin.cases ?_ (fun j => ?_) j
      · rw [hcolPrefix, matrixMinorIdeal_zero]
        exact bot_le
      · rw [hchart]
        exact le_iSup_of_le i (le_iSup_of_le j le_rfl)
  · apply iSup_le
    intro i
    apply iSup_le
    intro j
    rw [← hchart]
    exact le_iSup_of_le i.succ (le_iSup_of_le j.succ le_rfl)

open MvPolynomial

/-- Set the entire first row and column to zero in the split coordinates. -/
def zeroRowProjection {n : ℕ} {R : Type*} [CommRing R] :
    MvPolynomial (Option (PivotVariables n)) R →ₐ[R] CoordinateRing n R :=
  aeval (fun o => o.elim 0 (Sum.elim (fun _ => 0) X))

/-- The independent remaining symmetric coordinates embed in the split ring. -/
def zeroRowEmbedding {n : ℕ} {R : Type*} [CommRing R] :
    CoordinateRing n R →ₐ[R] MvPolynomial (Option (PivotVariables n)) R :=
  rename (fun e => some (Sum.inr e))

@[simp] theorem zeroRowProjection_embedding {n : ℕ} {R : Type*} [CommRing R]
    (f : CoordinateRing n R) : zeroRowProjection (zeroRowEmbedding f) = f := by
  have h : (zeroRowProjection (n := n) (R := R)).comp zeroRowEmbedding =
      AlgHom.id R (CoordinateRing n R) := by
    ext e
    simp [zeroRowProjection, zeroRowEmbedding]
  exact congrArg (fun φ : CoordinateRing n R →ₐ[R] CoordinateRing n R => φ f) h

/-- The kernel of deleting coordinates is contained in every ideal containing
those coordinates. This uses polynomial-ring universality, with no dimension
or radicality assumption. -/
theorem zeroRowProjection_kernel_le {n : ℕ} {R : Type*} [CommRing R]
    (I : Ideal (MvPolynomial (Option (PivotVariables n)) R))
    (hzero : X (none : Option (PivotVariables n)) ∈ I)
    (hrow : ∀ i : Fin n, X (some (Sum.inl i)) ∈ I) :
    RingHom.ker (zeroRowProjection (n := n) (R := R)).toRingHom ≤ I := by
  let q := Ideal.Quotient.mkₐ R I
  have hfactor : q = (q.comp zeroRowEmbedding).comp zeroRowProjection := by
    ext o
    cases o with
    | none =>
      simpa [q, zeroRowEmbedding, zeroRowProjection] using
        (Ideal.Quotient.eq_zero_iff_mem.mpr hzero)
    | some o =>
      cases o with
      | inl i =>
        simpa [q, zeroRowEmbedding, zeroRowProjection] using
          (Ideal.Quotient.eq_zero_iff_mem.mpr (hrow i))
      | inr e => simp [zeroRowEmbedding, zeroRowProjection]
  intro f hf
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q f = 0
  rw [hfactor]
  change q (zeroRowEmbedding (zeroRowProjection f)) = 0
  change zeroRowProjection f = 0 at hf
  rw [hf, map_zero, map_zero]

/-- The actual coordinate map deleting the first row and column. -/
def zeroFirstMap {n : ℕ} {R : Type*} [CommRing R] :
    CoordinateRing (n + 1) R →ₐ[R] CoordinateRing n R :=
  zeroRowProjection.comp Pivot.pivotCoordinateEquiv.toAlgHom

@[simp] theorem zeroFirstMap_pivot {n : ℕ} {R : Type*} [CommRing R] :
    zeroFirstMap (X (fold (0 : Fin (n + 1)) 0) : CoordinateRing (n + 1) R) = 0 := by
  change zeroRowProjection (Pivot.pivotCoordinateEquiv
    (X (fold (0 : Fin (n + 1)) 0) : CoordinateRing (n + 1) R)) = 0
  rw [Pivot.pivotCoordinateEquiv_pivot]
  simp [zeroRowProjection]

@[simp] theorem zeroFirstMap_carrier {n : ℕ} {R : Type*} [CommRing R]
    (i : Fin n) : zeroFirstMap (X (fold 0 i.succ) : CoordinateRing (n + 1) R) = 0 := by
  change zeroRowProjection (Pivot.pivotCoordinateEquiv
    (X (fold 0 i.succ) : CoordinateRing (n + 1) R)) = 0
  rw [Pivot.pivotCoordinateEquiv_carrier]
  simp [zeroRowProjection]

@[simp] theorem zeroFirstMap_residual {n : ℕ} {R : Type*} [CommRing R]
    (i j : Fin n) :
    zeroFirstMap (X (fold i.succ j.succ) : CoordinateRing (n + 1) R) = X (fold i j) := by
  change zeroRowProjection (Pivot.pivotCoordinateEquiv
    (X (fold i.succ j.succ) : CoordinateRing (n + 1) R)) = X (fold i j)
  rw [Pivot.pivotCoordinateEquiv_residual]
  simp [zeroRowProjection]

theorem zeroFirstMap_surjective {n : ℕ} {R : Type*} [CommRing R] :
    Function.Surjective (zeroFirstMap (n := n) (R := R)) := by
  intro f
  refine ⟨Pivot.pivotCoordinateEquiv.symm (zeroRowEmbedding f), ?_⟩
  change zeroRowProjection (Pivot.pivotCoordinateEquiv
    (Pivot.pivotCoordinateEquiv.symm (zeroRowEmbedding f))) = f
  rw [AlgEquiv.apply_symm_apply, zeroRowProjection_embedding]

/-- Exact image of every northwest ideal under deletion of the first row.
No hypotheses on the arbitrary rank bounds are needed for this image identity. -/
theorem map_northwestIdeal_zeroFirst {n : ℕ} (R : Type*) [CommRing R]
    (r : RankArray (n + 1)) :
    (northwestIdeal R r).map (zeroFirstMap (n := n) (R := R)).toRingHom =
      northwestIdeal R (fun i j => r i.succ j.succ) := by
  let M := (genericMatrix (n + 1) R).map (zeroFirstMap (n := n) (R := R))
  have hrow : ∀ j, M 0 j = 0 := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact zeroFirstMap_pivot (n := n) (R := R)
    · exact zeroFirstMap_carrier (R := R) j
  have hcol : ∀ i, M i 0 = 0 := by
    intro i
    change zeroFirstMap (X (fold i 0)) = 0
    rw [fold_comm]
    exact hrow i
  have hres : firstDeletedMatrix M = genericMatrix n R := by
    funext i j
    exact zeroFirstMap_residual (R := R) i j
  rw [map_northwestIdeal_eq_matrixIdeal]
  change northwestMatrixIdeal M r = _
  rw [northwestMatrixIdeal_first_zero M hrow hcol, hres]
  exact (northwestIdeal_eq_iSup_prefixMinorIdeals R _).symm

/-- The first-row coordinate kernel is forced by a zero first row of the
actual realizing matrix. The two coefficient fields remain independent. -/
theorem zeroFirstMap_kernel_le_northwestIdeal {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (hrow : ∀ j, w 0 j = 0) (R : Type*) [CommRing R] :
    RingHom.ker (zeroFirstMap (n := n) (R := R)).toRingHom ≤
      northwestIdeal R (matrixRankArray w) := by
  let I := northwestIdeal R (matrixRankArray w)
  let e := Pivot.pivotCoordinateEquiv (n := n) (R := R)
  have hvar (j : Fin (n + 1)) : X (fold 0 j) ∈ I :=
    variable_mem_northwestIdeal_of_zero_bound R (matrixRankArray w)
      (matrixRankArray_zero_row w hrow j) le_rfl le_rfl
  have hkernel : RingHom.ker (zeroRowProjection (n := n) (R := R)).toRingHom ≤
      I.map e.toRingHom := by
    apply zeroRowProjection_kernel_le
    · have h := Ideal.mem_map_of_mem e.toRingHom (hvar 0)
      change Pivot.pivotCoordinateEquiv
        (X (fold (0 : Fin (n + 1)) 0) : CoordinateRing (n + 1) R) ∈ I.map e.toRingHom at h
      rw [Pivot.pivotCoordinateEquiv_pivot] at h
      exact h
    · intro i
      have h := Ideal.mem_map_of_mem e.toRingHom (hvar i.succ)
      change Pivot.pivotCoordinateEquiv
        (X (fold 0 i.succ) : CoordinateRing (n + 1) R) ∈ I.map e.toRingHom at h
      rw [Pivot.pivotCoordinateEquiv_carrier] at h
      exact h
  intro f hf
  have he : e f ∈ I.map e.toRingHom := hkernel hf
  have hc : (I.map e.toRingHom).comap e.toRingHom = I :=
    Ideal.comap_map_of_bijective e.toRingHom e.bijective
  change f ∈ (I.map e.toRingHom).comap e.toRingHom at he
  rwa [hc] at he

/-- The exact zero-row contraction, including the actual smaller realized
rank profile. This is the zero-row branch of the primeness induction. -/
theorem northwestIdeal_zero_row_comap {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F) (hw : w.transpose = w)
    (hrow : ∀ j, w 0 j = 0) (R : Type*) [CommRing R] :
    (northwestIdeal R (matrixRankArray (firstDeletedMatrix w))).comap
      (zeroFirstMap (n := n) (R := R)).toRingHom =
      northwestIdeal R (matrixRankArray w) := by
  have hcol : ∀ i, w i 0 = 0 := by
    intro i
    have he : w i 0 = w 0 i := congrFun (congrFun hw 0) i
    exact he.trans (hrow i)
  have hr : (fun i j : Fin n => matrixRankArray w i.succ j.succ) =
      matrixRankArray (firstDeletedMatrix w) :=
    funext (fun i => funext (fun j => matrixRankArray_first_zero w hrow hcol i j))
  have hm := map_northwestIdeal_zeroFirst R (matrixRankArray w)
  rw [hr] at hm
  rw [← hm, Ideal.comap_map_of_surjective
    (zeroFirstMap (n := n) (R := R)).toRingHom
    (zeroFirstMap_surjective (n := n) (R := R))]
  apply sup_eq_left.mpr
  exact zeroFirstMap_kernel_le_northwestIdeal w hrow R

/-- Primeness in the zero-row branch follows from the smaller realized rank
ideal. The only primeness input is the explicit induction hypothesis. -/
theorem northwestIdeal_isPrime_of_zero_row {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F) (hw : w.transpose = w)
    (hrow : ∀ j, w 0 j = 0) (K : Type*) [CommRing K]
    (hsmall : (northwestIdeal K (matrixRankArray (firstDeletedMatrix w))).IsPrime) :
    (northwestIdeal K (matrixRankArray w)).IsPrime := by
  letI := hsmall
  rw [← northwestIdeal_zero_row_comap w hw hrow K]
  infer_instance

