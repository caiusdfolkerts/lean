/-- A surjective quotient by equations already in the ideal, followed by an
actual pivot localization and coordinate automorphism, detects primeness when
the pivot is regular. No saturation at any other coefficients is required. -/
theorem ideal_isPrime_of_surjective_away_chart {R A B C : Type*}
    [CommRing R] [CommRing A] [CommRing B] [CommRing C] [Algebra A B]
    (I : Ideal R) (ρ : R →+* A) (hρ : Function.Surjective ρ)
    (hker : RingHom.ker ρ ≤ I) (x : R) [IsLocalization.Away (ρ x) B]
    (d : B ≃+* C) (hreg : ∀ f, f * x ∈ I → f ∈ I)
    (hchart : (((I.map ρ).map (algebraMap A B)).map d.toRingHom).IsPrime) : I.IsPrime := by
  have hcon : (I.map ρ).comap ρ = I := by
    rw [Ideal.comap_map_of_surjective ρ hρ]
    exact sup_eq_left.mpr hker
  have hregA : ∀ f, f * ρ x ∈ I.map ρ → f ∈ I.map ρ := by
    intro f hf
    obtain ⟨a, rfl⟩ := hρ f
    have ha : a * x ∈ (I.map ρ).comap ρ := by
      change ρ (a * x) ∈ I.map ρ
      simpa only [map_mul] using hf
    rw [hcon] at ha
    exact Ideal.mem_map_of_mem ρ (hreg a ha)
  have hB : ((I.map ρ).map (algebraMap A B)).IsPrime := by
    letI := hchart
    rw [← Ideal.comap_map_of_bijective d.toRingHom d.bijective
      (I := (I.map ρ).map (algebraMap A B))]
    infer_instance
  have hA : (I.map ρ).IsPrime :=
    ideal_isPrime_of_regular_away (S := B) (I.map ρ) (ρ x) hregA hB
  letI := hA
  rw [← hcon]
  infer_instance

/-- The initial zero part of the first row has rank zero on each of its
prefixes, without requiring the rest of the row to vanish. -/
theorem matrixRankArray_firstRow_prefix_zero {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F) (j : Fin (n + 1))
    (hzero : ∀ p ≤ j, w 0 p = 0) : matrixRankArray w 0 j = 0 := by
  rw [← northwestPrefixMatrix_rank]
  have hm : northwestPrefixMatrix w 0 j = 0 := by
    ext p q
    have hp : p = 0 := by
      apply Fin.ext
      change p.val = 0
      have hpval := p.isLt
      change p.val < 0 + 1 at hpval
      omega
    subst p
    exact hzero (northwestPrefixEmbedding j q) (Nat.lt_succ_iff.mp q.isLt)
  rw [hm, Matrix.rank_zero]

def offDiagonalProjection {n : ℕ} (R : Type*) [CommRing R] (k : Fin (n + 1)) :
    CoordinateRing (n + 2) R →+* CoordinateRing n (MvPolynomial (OffDiagonalFreeCarrier k) R) :=
  residualCoefficientMap (offDiagonalResidualEmbedding k) (offDiagonalZeroMap R k)

theorem offDiagonalProjection_surjective {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) : Function.Surjective (offDiagonalProjection R k) :=
  (MvPolynomial.map_surjective (offDiagonalZeroMap R k)
    (offDiagonalZeroMap_surjective R k)).comp
    (residualCoefficientEquiv R (offDiagonalResidualEmbedding k)).surjective

@[simp] theorem offDiagonalProjection_pivot {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) :
    offDiagonalProjection R k (X (fold 0 k.succ)) = C (X (offDiagonalFreePivot k)) := by
  change residualCoefficientMap (offDiagonalResidualEmbedding k) (offDiagonalZeroMap R k)
    (X (offDiagonalFirstCarrier k k.succ).val) = _
  rw [residualCoefficientMap_carrier]
  exact congrArg C (offDiagonalZeroMap_free R k (offDiagonalFreePivot k))

theorem offDiagonalProjection_kernel_le {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F)
    (k : Fin (n + 1)) (hzero : ∀ j < k.succ, w 0 j = 0)
    (R : Type*) [CommRing R] :
    RingHom.ker (offDiagonalProjection R k) ≤ northwestIdeal R (matrixRankArray w) := by
  let I := northwestIdeal R (matrixRankArray w)
  let e := residualCoefficientEquiv R (offDiagonalResidualEmbedding k)
  have hforced (c : OffDiagonalCarrier k) (hc : OffDiagonalForced k c) : X c.val ∈ I := by
    have hr : matrixRankArray w 0 c.val.val.1 = 0 :=
      matrixRankArray_firstRow_prefix_zero w _ (fun j hj => hzero j (hj.trans_lt hc.2))
    have he : fold 0 c.val.val.1 = c.val := by
      apply Subtype.ext
      apply Prod.ext
      · change max 0 c.val.val.1 = c.val.val.1
        exact max_eq_right (Fin.zero_le _)
      · change min 0 c.val.val.1 = c.val.val.2
        rw [min_eq_left (Fin.zero_le _)]
        exact hc.1.symm
    rw [← he]
    exact variable_mem_northwestIdeal_of_zero_bound R (matrixRankArray w) hr le_rfl le_rfl
  have hk : RingHom.ker (MvPolynomial.map (σ := Entry n) (offDiagonalZeroMap R k)) ≤
      I.map e.toRingHom := by
    rw [MvPolynomial.ker_map]
    apply Ideal.map_le_iff_le_comap.mpr
    change RingHom.ker (killCompl (R := R)
      (f := (Subtype.val : OffDiagonalFreeCarrier k → OffDiagonalCarrier k))
        Subtype.val_injective).toRingHom ≤ _
    rw [kernel_killCompl]
    apply Ideal.span_le.mpr
    rintro p ⟨c, hc, rfl⟩
    have hcf : OffDiagonalForced k c :=
      not_not.mp (fun hcf => hc ⟨⟨c, hcf⟩, rfl⟩)
    change C (X c) ∈ I.map e.toRingHom
    have hm := Ideal.mem_map_of_mem e.toRingHom (hforced c hcf)
    change residualCoefficientEquiv R (offDiagonalResidualEmbedding k) (X c.val) ∈
      I.map e.toRingHom at hm
    rw [residualCoefficientEquiv_carrier] at hm
    exact hm
  intro f hf
  have he : e f ∈ I.map e.toRingHom := hk hf
  change f ∈ (I.map e.toRingHom).comap e.toRingHom at he
  rwa [Ideal.comap_map_of_bijective e.toRingHom e.bijective] at he

/-- Independent free carriers with only the actual off-diagonal pivot inverted. -/
abbrev OffDiagonalLaurentRing {n : ℕ} (R : Type*) [CommRing R] (k : Fin (n + 1)) :=
  Localization.Away (X (offDiagonalFreePivot k) : MvPolynomial (OffDiagonalFreeCarrier k) R)

def offDiagonalLaurentCoefficientMap {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) : MvPolynomial (OffDiagonalCarrier k) R →+* OffDiagonalLaurentRing R k :=
  (algebraMap (MvPolynomial (OffDiagonalFreeCarrier k) R) (OffDiagonalLaurentRing R k)).comp
    (offDiagonalZeroMap R k)

def offDiagonalLaurentInverse {n : ℕ} (R : Type*) [CommRing R] (k : Fin (n + 1)) :
    OffDiagonalLaurentRing R k :=
  IsLocalization.Away.invSelf (S := OffDiagonalLaurentRing R k)
    (X (offDiagonalFreePivot k) : MvPolynomial (OffDiagonalFreeCarrier k) R)

theorem offDiagonalLaurentInverse_mul {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) :
    offDiagonalLaurentInverse R k *
      offDiagonalCoefficientFirst k (offDiagonalLaurentCoefficientMap R k) k.succ = 1 := by
  change offDiagonalLaurentInverse R k *
    algebraMap (MvPolynomial (OffDiagonalFreeCarrier k) R) (OffDiagonalLaurentRing R k)
      (offDiagonalZeroMap R k (X (offDiagonalFreePivot k).val)) = 1
  rw [offDiagonalZeroMap_free, mul_comm]
  exact IsLocalization.Away.mul_invSelf (S := OffDiagonalLaurentRing R k)
    (X (offDiagonalFreePivot k) : MvPolynomial (OffDiagonalFreeCarrier k) R)

theorem offDiagonalLaurentCoefficient_first_zero {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) (j : Fin (n + 2)) (hj : j < k.succ) :
    offDiagonalCoefficientFirst k (offDiagonalLaurentCoefficientMap R k) j = 0 := by
  change algebraMap (MvPolynomial (OffDiagonalFreeCarrier k) R) (OffDiagonalLaurentRing R k)
    (offDiagonalZeroMap R k (X (offDiagonalFirstCarrier k j))) = 0
  rw [offDiagonalZeroMap_forced R k _ ((offDiagonalFirstCarrier_forced k j).mpr hj), map_zero]

theorem offDiagonalLaurent_isDomain {n : ℕ} (R : Type*) [CommRing R] [IsDomain R]
    (k : Fin (n + 1)) : IsDomain (OffDiagonalLaurentRing R k) :=
  Localization.Away.isDomain (MvPolynomial.X_ne_zero (offDiagonalFreePivot k))

/-- The complete off-diagonal branch of the prime induction. The smaller
realizing matrix is over `F`, while the coefficient domain is extended only
by independent carriers and the genuine Laurent pivot. -/
theorem northwestIdeal_isPrime_of_offDiagonal {n : ℕ} {F R : Type*}
    [Field F] [CommRing R] [IsDomain R]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F) (hw : w.transpose = w)
    (k : Fin (n + 1)) (hx : w 0 k.succ ≠ 0)
    (hzero : ∀ j < k.succ, w 0 j = 0)
    (hG : (foldedOrder (n + 2)).IsGroebnerBasis
      (northwestGenerators R (matrixRankArray w)) (northwestIdeal R (matrixRankArray w)))
    (hsmall : (northwestIdeal (OffDiagonalLaurentRing R k)
      (matrixRankArray (offDiagonalResidualMatrix w k (w 0 k.succ)⁻¹))).IsPrime) :
    (northwestIdeal R (matrixRankArray w)).IsPrime := by
  let T := MvPolynomial (OffDiagonalFreeCarrier k) R
  let S := OffDiagonalLaurentRing R k
  let A := CoordinateRing n T
  let B := CoordinateRing n S
  let φ := offDiagonalLaurentCoefficientMap R k
  let q := offDiagonalLaurentInverse R k
  let ρ := offDiagonalProjection R k
  let x : CoordinateRing (n + 2) R := X (fold 0 k.succ)
  let d : B ≃+* B := (constantShiftEquiv (offDiagonalChartOffset k φ q)).toRingEquiv
  letI : IsLocalization.Away (C (X (offDiagonalFreePivot k)) : A) B := by
    change IsLocalization (Submonoid.powers (C (X (offDiagonalFreePivot k)) : A)) B
    rw [← Submonoid.map_powers (C : T →+* A)]
    exact Pivot.polynomial_isLocalization (Submonoid.powers (X (offDiagonalFreePivot k) : T)) S
  letI : IsLocalization.Away (ρ x) B := by
    change IsLocalization.Away (offDiagonalProjection R k (X (fold 0 k.succ))) B
    rw [offDiagonalProjection_pivot]
    infer_instance
  apply ideal_isPrime_of_surjective_away_chart (northwestIdeal R (matrixRankArray w))
    ρ (offDiagonalProjection_surjective R k) (offDiagonalProjection_kernel_le w k hzero R) x d
  · intro f hf
    exact (northwestIdeal_mul_pivot_mem_iff_of_groebner w hw k.succ hx hzero R hG f).mp hf
  · have hfactor : d.toRingHom.comp ((algebraMap A B).comp ρ) =
        offDiagonalChartMap k φ q := by
      apply RingHom.ext
      intro f
      change constantShiftEquiv (offDiagonalChartOffset k φ q)
        (algebraMap A B (MvPolynomial.map (offDiagonalZeroMap R k)
          (residualCoefficientEquiv R (offDiagonalResidualEmbedding k) f))) = _
      rw [MvPolynomial.algebraMap_def, MvPolynomial.map_map]
      rfl
    rw [Ideal.map_map, Ideal.map_map]
    change ((northwestIdeal R (matrixRankArray w)).map
      (d.toRingHom.comp ((algebraMap A B).comp ρ))).IsPrime
    rw [hfactor, northwestIdeal_map_offDiagonalChart k φ q w hw
      (offDiagonalLaurentInverse_mul R k) (offDiagonalLaurentCoefficient_first_zero R k) hx hzero]
    exact hsmall

