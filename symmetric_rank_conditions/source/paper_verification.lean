namespace FourPapers.Symmetric
open MvPolynomial Finsupp

/-- Deleting variables has exactly the ideal generated by those variables as
its kernel. The retained variables are specified by an actual injection. -/
theorem kernel_killCompl {σ τ R : Type*} [CommRing R] {f : σ → τ}
    (hf : Function.Injective f) :
    RingHom.ker (MvPolynomial.killCompl (R := R) hf).toRingHom =
      Ideal.span (X '' (Set.range f)ᶜ : Set (MvPolynomial τ R)) := by
  classical
  apply le_antisymm
  · intro p hp
    change MvPolynomial.killCompl hf p = 0 at hp
    apply mem_ideal_span_X_image.mpr
    intro m hm
    by_contra h
    have hs : (↑m.support : Set τ) ⊆ Set.range f := by
      intro i hi
      by_contra hnot
      exact h ⟨i, hnot, Finsupp.mem_support_iff.mp hi⟩
    have hc := congrArg (fun q : MvPolynomial σ R =>
      q.coeff (m.comapDomain f hf.injOn)) hp
    rw [MvPolynomial.coeff_killCompl, m.mapDomain_comapDomain f hf hs,
      MvPolynomial.coeff_zero] at hc
    exact (MvPolynomial.mem_support_iff.mp hm) hc
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    change MvPolynomial.killCompl hf (X i) = 0
    rw [MvPolynomial.killCompl, MvPolynomial.aeval_X, dite_eq_right hi]

theorem killCompl_surjective {σ τ R : Type*} [CommRing R] {f : σ → τ}
    (hf : Function.Injective f) :
    Function.Surjective (MvPolynomial.killCompl (R := R) hf) := by
  intro p
  exact ⟨rename f p, MvPolynomial.killCompl_rename_app hf p⟩

/-- Quotienting by forced coordinates loses no further ideal equations. -/
theorem killCompl_comap_map_eq {σ τ R : Type*} [CommRing R] {f : σ → τ}
    (hf : Function.Injective f) (I : Ideal (MvPolynomial τ R))
    (hI : ∀ i ∉ Set.range f, X i ∈ I) :
    (I.map (MvPolynomial.killCompl (R := R) hf).toRingHom).comap
      (MvPolynomial.killCompl (R := R) hf).toRingHom = I := by
  rw [Ideal.comap_map_of_surjective
    (MvPolynomial.killCompl (R := R) hf).toRingHom
    (killCompl_surjective (R := R) hf) I]
  apply sup_eq_left.mpr
  change RingHom.ker (MvPolynomial.killCompl (R := R) hf).toRingHom ≤ I
  rw [kernel_killCompl]
  apply Ideal.span_le.mpr
  rintro _ ⟨i, hi, rfl⟩
  exact hI i hi

/-- Translation by coefficient-ring elements is an actual polynomial
algebra automorphism, independently in every variable. -/
def constantShift {σ R : Type*} [CommRing R] (f : σ → R) :
    MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
  aeval (fun i => X i + C (f i))

@[simp] theorem constantShift_C {σ R : Type*} [CommRing R] (f : σ → R) (r : R) :
    constantShift f (C r) = C r := by simp [constantShift]

@[simp] theorem constantShift_X {σ R : Type*} [CommRing R] (f : σ → R) (i : σ) :
    constantShift f (X i) = X i + C (f i) := by simp [constantShift]

theorem constantShift_comp {σ R : Type*} [CommRing R] (f g : σ → R) :
    (constantShift f).comp (constantShift g) = constantShift (f + g) := by
  ext i
  simp [add_assoc]

@[simp] theorem constantShift_zero {σ R : Type*} [CommRing R] :
    constantShift (0 : σ → R) = AlgHom.id R (MvPolynomial σ R) := by
  ext i
  simp

def constantShiftEquiv {σ R : Type*} [CommRing R] (f : σ → R) :
    MvPolynomial σ R ≃ₐ[R] MvPolynomial σ R :=
  AlgEquiv.ofAlgHom (constantShift f) (constantShift (-f))
    (by rw [constantShift_comp, add_neg_cancel, constantShift_zero])
    (by rw [constantShift_comp, neg_add_cancel, constantShift_zero])

@[simp] theorem constantShiftEquiv_apply {σ R : Type*} [CommRing R] (f : σ → R)
    (p : MvPolynomial σ R) : constantShiftEquiv f p = constantShift f p := rfl

end FourPapers.Symmetric
