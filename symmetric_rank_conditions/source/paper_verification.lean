namespace FourPapers.Symmetric
open MvPolynomial

/-- The increasing enumeration of the inclusive prefix ending at `i`. -/
def northwestPrefixEmbedding {n : ℕ} (i : Fin n) : Fin (i.val + 1) ↪o Fin n :=
  Fin.castLEOrderEmb (Nat.succ_le_of_lt i.isLt)

/-- The same prefix as the subtype used by `matrixRankArray`. -/
def northwestPrefixEquiv {n : ℕ} (i : Fin n) :
    Fin (i.val + 1) ≃ {p : Fin n // p ≤ i} where
  toFun p := ⟨⟨p.val, p.isLt.trans_le (Nat.succ_le_of_lt i.isLt)⟩,
    Nat.lt_succ_iff.mp p.isLt⟩
  invFun p := ⟨p.val.val, Nat.lt_succ_iff.mpr p.property⟩
  left_inv p := rfl
  right_inv p := by cases p; rfl

/-- An actual northwest prefix, with finite ordinal index types. -/
def northwestPrefixMatrix {n : ℕ} {R : Type*}
    (M : Matrix (Fin n) (Fin n) R) (i j : Fin n) :
    Matrix (Fin (i.val + 1)) (Fin (j.val + 1)) R :=
  M.submatrix (northwestPrefixEmbedding i) (northwestPrefixEmbedding j)

@[simp] theorem northwestPrefixMatrix_apply {n : ℕ} {R : Type*}
    (M : Matrix (Fin n) (Fin n) R) (i j : Fin n)
    (p : Fin (i.val + 1)) (q : Fin (j.val + 1)) :
    northwestPrefixMatrix M i j p q =
      M (northwestPrefixEmbedding i p) (northwestPrefixEmbedding j q) := rfl

/-- Reindexing the subtype prefix does not change its rank. -/
theorem northwestPrefixMatrix_rank {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin n) (Fin n) K) (i j : Fin n) :
    (northwestPrefixMatrix w i j).rank = matrixRankArray w i j := by
  exact Matrix.rank_submatrix
    (w.submatrix (fun p : {p : Fin n // p ≤ i} => p.val)
      (fun q : {q : Fin n // q ≤ j} => q.val))
    (northwestPrefixEquiv i) (northwestPrefixEquiv j)

/-- Restrict an increasing index list whose entries lie in a prefix to the
finite ordinal indexing that prefix. -/
def northwestRestrictedEmbedding {n t : ℕ} (i : Fin n) (a : Fin t ↪o Fin n)
    (ha : ∀ p, a p ≤ i) : Fin t ↪o Fin (i.val + 1) :=
  OrderEmbedding.ofStrictMono
    (fun p => ⟨(a p).val, Nat.lt_succ_iff.mpr (ha p)⟩)
    (fun _ _ h => a.strictMono h)

@[simp] theorem northwestPrefix_restricted {n t : ℕ} (i : Fin n)
    (a : Fin t ↪o Fin n) (ha : ∀ p, a p ≤ i) (p : Fin t) :
    northwestPrefixEmbedding i (northwestRestrictedEmbedding i a ha p) = a p := rfl

/-- The paper's ideal is exactly the sum of the determinantal ideals of its
actual northwest prefixes. This identity retains every prescribed rectangle
and every minor, including redundant conditions. -/
theorem northwestIdeal_eq_iSup_prefixMinorIdeals {n : ℕ}
    (R : Type*) [CommRing R] (r : RankArray n) :
    northwestIdeal R r = ⨆ i : Fin n, ⨆ j : Fin n,
      matrixMinorIdeal (northwestPrefixMatrix (genericMatrix n R) i j) (r i j + 1) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨i, j, a, b, ha, hb, rfl⟩
    have h := det_submatrix_mem_matrixMinorIdeal
      (northwestPrefixMatrix (genericMatrix n R) i j) (r i j + 1)
      (northwestRestrictedEmbedding i a ha) (northwestRestrictedEmbedding j b hb)
    exact (show matrixMinorIdeal
        (northwestPrefixMatrix (genericMatrix n R) i j) (r i j + 1) ≤
          ⨆ i : Fin n, ⨆ j : Fin n,
            matrixMinorIdeal (northwestPrefixMatrix (genericMatrix n R) i j) (r i j + 1) from
      le_iSup_of_le i (le_iSup_of_le j le_rfl)) h
  · apply iSup_le
    intro i
    apply iSup_le
    intro j
    rw [matrixMinorIdeal_eq_ordered]
    apply Ideal.span_le.mpr
    rintro f ⟨a, b, rfl⟩
    apply Ideal.subset_span
    refine ⟨i, j, a.comp (northwestPrefixEmbedding i),
      b.comp (northwestPrefixEmbedding j), ?_, ?_, rfl⟩
    · intro p
      exact Nat.lt_succ_iff.mp (a p).isLt
    · intro p
      exact Nat.lt_succ_iff.mp (b p).isLt

/-- A coefficient homomorphism acts on a rank ideal by acting on the actual
matrix entries in every prefix. This is the input to the Schur-chart identity. -/
theorem map_northwestIdeal_eq_iSup_prefixMinorIdeals {n : ℕ}
    {R S : Type*} [CommRing R] [CommRing S]
    (φ : CoordinateRing n R →+* S) (r : RankArray n) :
    (northwestIdeal R r).map φ = ⨆ i : Fin n, ⨆ j : Fin n,
      matrixMinorIdeal ((northwestPrefixMatrix (genericMatrix n R) i j).map φ)
        (r i j + 1) := by
  rw [northwestIdeal_eq_iSup_prefixMinorIdeals]
  simp only [Ideal.map_iSup, matrixMinorIdeal_map]

