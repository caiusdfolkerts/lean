/-- Full symmetric determinantal primeness follows from the ordinary northwest
Gröbner theorem by a separate diagonal induction. In particular the symbolic
power argument does not depend on the off-diagonal rank-profile branch.

The only input is the ordinary northwest Gröbner theorem over fields; the
conclusion covers every coefficient domain and every positive minor size. -/
theorem determinantalIdeals_prime_of_northwestGroebner
    (hNW : ∀ (n : ℕ) (K : Type u) [Field K] (r : RankArray n),
      (∀ i j, r i j = r j i) →
        (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r)) :
    ∀ (n : ℕ) (R : Type u) [CommRing R] [IsDomain R] (t : ℕ), 0 < t →
      (determinantalIdeal n R t).IsPrime := by
  intro n
  induction n with
  | zero =>
    intro R _ _ t ht
    rw [determinantalIdeal_eq_matrixMinorIdeal,
      matrixMinorIdeal_eq_bot_of_rows_lt _ t ht]
    infer_instance
  | succ n ih =>
    intro R _ _ t ht
    cases t with
    | zero => omega
    | succ t =>
      cases t with
      | zero =>
        rw [determinantalIdeal_one]
        exact idealOfVars_isPrime
      | succ t =>
        have hG : (foldedOrder (n + 1)).IsGroebnerBasis
            (northwestGenerators R (fun _ _ => t + 1))
            (northwestIdeal R (fun _ _ => t + 1)) :=
          northwestGroebner_of_fraction R _
            (hNW (n + 1) (FractionRing R) (fun _ _ => t + 1) (fun _ _ => rfl))
        apply ideal_isPrime_of_diagonalLaurentChart (determinantalIdeal (n + 1) R (t + 2))
        · intro f hf
          rw [determinantalIdeal_succ_eq_northwest] at hf ⊢
          exact (northwestIdeal_mul_diagonal_mem_iff_of_groebner R (fun _ _ => t + 1)
            (fun _ _ => Nat.zero_lt_succ t) hG f).mp hf
        · let S := DiagonalLaurentRing R
          letI : IsDomain S := diagonalLaurent_isDomain R
          have hs : (determinantalIdeal n S (t + 1)).IsPrime :=
            ih S (t + 1) (Nat.zero_lt_succ t)
          change ((determinantalIdeal (n + 1) R (t + 2)).map
            (Pivot.firstPivotChartMap
              (algebraMap (Polynomial R) (DiagonalLaurentRing R))
              (diagonalLaurentInverse R))).IsPrime
          rw [Pivot.determinantalIdeal_map_firstPivotChart _ _
            (diagonalLaurentInverse_mul R) (t + 1)]
          letI := hs
          exact Pivot.map_rename_inr_isPrime _

end FourPapers.Symmetric
