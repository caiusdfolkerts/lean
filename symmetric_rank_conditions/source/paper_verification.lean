section

set_option autoImplicit false
set_option maxHeartbeats 800000

noncomputable section

/-!
# Comparison after a pivot

This module proves the dimension and localization steps in Lemma 3.3.
The homogeneous quotient component is the image of the actual homogeneous
polynomials under the quotient map.  Thus its dimension is the usual
coefficient of the multigraded Hilbert series, without a formal power-series
encoding.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ R D : Type*} [CommRing R] [AddCommMonoid D] [DecidableEq D]

/-- The degree-`d` component of a polynomial quotient, as an actual submodule. -/
def quotientPiece (I : Ideal (MvPolynomial σ R)) (w : σ → D) (d : D) :
    Submodule R (MvPolynomial σ R ⧸ I) :=
  (weightedHomogeneousSubmodule R w d).map (Ideal.Quotient.mkₐ R I).toLinearMap

/-- Standard monomial exponents of a specified multidegree. -/
def standardPieceSet (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (w : σ → D) (d : D) : Set (σ →₀ ℕ) :=
  {e | e ∈ m.standardMonomials I ∧ weight w e = d}

theorem normalForm_isWeightedHomogeneous
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (w : σ → D) (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w))
    {p : MvPolynomial σ R} {d : D} (hp : p.IsWeightedHomogeneous w d) :
    (hG.normalForm hu p).IsWeightedHomogeneous w d := by
  classical
  have hs : weightedHomogeneousComponent w d (hG.normalForm hu p) ∈
      restrictSupport R (m.standardMonomials I) := by
    rw [mem_restrictSupport_iff]
    intro e he
    rw [support_weightedHomogeneousComponent] at he
    exact (mem_restrictSupport_iff R).mp (hG.normalForm_mem_restrictSupport hu p)
      (Finset.mem_filter.mp he).1
  have hd : p - weightedHomogeneousComponent w d (hG.normalForm hu p) ∈ I := by
    have h := weightedHomogeneousComponent_mem_of_mem R w hI
      (hG.sub_normalForm_mem hu p) d
    simpa only [map_sub, hp.weightedHomogeneousComponent_same] using h
  rw [(hG.normalForm_eq_iff hu).mpr ⟨hs, hd⟩]
  exact weightedHomogeneousComponent_isWeightedHomogeneous _ _

theorem mem_restrictSupport_standardPieceSet_iff
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R)) (w : σ → D) (d : D)
    (p : MvPolynomial σ R) :
    p ∈ restrictSupport R (standardPieceSet m I w d) ↔
      p ∈ restrictSupport R (m.standardMonomials I) ∧ p.IsWeightedHomogeneous w d := by
  classical
  simp only [mem_restrictSupport_iff, Set.subset_def, Finset.mem_coe,
    standardPieceSet, Set.mem_ofPred_eq, IsWeightedHomogeneous, MvPolynomial.mem_support_iff]
  constructor
  · intro h
    exact ⟨fun e he => (h e he).1, fun e he => (h e he).2⟩
  · rintro ⟨hs, hd⟩ e he
    exact ⟨hs e he, hd he⟩

/-- The degreewise standard-monomial isomorphism for a homogeneous ideal. -/
def standardPieceEquiv
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (w : σ → D) (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w)) (d : D) :
    restrictSupport R (standardPieceSet m I w d) ≃ₗ[R] quotientPiece I w d := by
  let q := (Ideal.Quotient.mkₐ R I).toLinearMap
  let f : restrictSupport R (standardPieceSet m I w d) →ₗ[R] quotientPiece I w d :=
    { toFun := fun p => ⟨q p, ⟨p,
        ((mem_restrictSupport_standardPieceSet_iff m I w d p).mp p.2).2, rfl⟩⟩
      map_add' := by intros; ext; exact q.map_add _ _
      map_smul' := by intros; ext; exact q.map_smul _ _ }
  apply LinearEquiv.ofBijective f
  constructor
  · intro p p' he
    apply Subtype.ext
    apply MonomialOrder.eq_of_sub_mem_of_mem_restrictSupport
      ((mem_restrictSupport_standardPieceSet_iff m I w d p).mp p.2).1
      ((mem_restrictSupport_standardPieceSet_iff m I w d p').mp p'.2).1
    exact Ideal.Quotient.eq.mp (congrArg Subtype.val he)
  · rintro ⟨y, hy⟩
    obtain ⟨p, hp, hpy⟩ := hy
    let r := hG.normalForm hu p
    have hr : r ∈ restrictSupport R (standardPieceSet m I w d) := by
      apply (mem_restrictSupport_standardPieceSet_iff m I w d r).mpr
      exact ⟨hG.normalForm_mem_restrictSupport hu p,
        normalForm_isWeightedHomogeneous m I G hG hu w hI hp⟩
    refine ⟨⟨r, hr⟩, ?_⟩
    apply Subtype.ext
    change Ideal.Quotient.mk I (hG.normalForm hu p) = y
    exact (hG.mk_normalForm hu p).trans hpy

/-- Standard monomials of a fixed multidegree form the corresponding quotient basis. -/
def standardPieceBasis
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (w : σ → D) (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w)) (d : D) :
    Module.Basis (standardPieceSet m I w d) R (quotientPiece I w d) :=
  (basisRestrictSupport R _).map (standardPieceEquiv m I G hG hu w hI d)

section Field

variable {K : Type*} [Field K]

/-- The usual Hilbert-function coefficient equals the number of standard
monomials of that multidegree.  Local finiteness is stated explicitly. -/
theorem finrank_quotientPiece
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ K))
    (w : σ → D) (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K w)) (d : D)
    (hf : (standardPieceSet m I w d).Finite) :
    Module.finrank K (quotientPiece I w d) = (standardPieceSet m I w d).ncard := by
  classical
  letI : Fintype (standardPieceSet m I w d) := hf.fintype
  have hb := Module.finrank_eq_card_basis
    (standardPieceBasis m I (I : Set _) (MonomialOrder.isGroebnerBasis_self I)
      (fun _ _ hg => m.isUnit_leadingCoeff.mpr hg) w hI d)
  simpa only [Set.ncard_eq_toFinset_card', Set.toFinset_card] using hb

/-- The exponents excluded by the proposed leading terms. -/
def normalExponents (m : MonomialOrder σ) (G : Set (MvPolynomial σ K)) : Set (σ →₀ ℕ) :=
  {e | ∀ g ∈ G, g ≠ 0 → ¬m.degree g ≤ e}

theorem standardMonomials_span_leadingTerm_eq
    (m : MonomialOrder σ) (G : Set (MvPolynomial σ K)) :
    m.standardMonomials (Ideal.span (m.leadingTerm '' G)) = normalExponents m G := by
  ext e
  constructor
  · intro he g hg hg0
    have hl := he (m.leadingTerm g) (Ideal.subset_span ⟨g, hg, rfl⟩)
      ((m.leadingTerm_eq_zero_iff g).not.mpr hg0)
    simpa only [m.degree_leadingTerm] using hl
  · intro he p hp hp0 hpe
    obtain ⟨g, hg, hg0, hgp⟩ := MonomialOrder.exists_degree_le_of_mem_span_leadingTerm hp
      (m.degree_mem_support hp0)
    exact he g hg hg0 (hgp.trans hpe)

theorem standardMonomials_subset_normalExponents
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ K))
    (G : Set (MvPolynomial σ K)) (hGI : G ⊆ I) :
    m.standardMonomials I ⊆ normalExponents m G :=
  fun _ he g hg hg0 => he g (hGI hg) hg0

/-- The Hilbert comparison used in Lemma 3.3, over the generic-fiber field.

The cardinality assumption is exactly equality of the multigraded Hilbert
functions: the left side counts monomials outside the proposed initial ideal,
and the right side is the dimension of the actual quotient component. -/
theorem isGroebnerBasis_of_hilbertFunction
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ K))
    (G : Set (MvPolynomial σ K)) (hGI : G ⊆ I)
    (w : σ → D) (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K w))
    (hw : ∀ d, {e : σ →₀ ℕ | weight w e = d}.Finite)
    (hHilbert : ∀ d,
      {e : σ →₀ ℕ | e ∈ normalExponents m G ∧ weight w e = d}.ncard =
        Module.finrank K (quotientPiece I w d)) :
    m.IsGroebnerBasis G I := by
  classical
  have hsets : ∀ d, standardPieceSet m I w d =
      {e : σ →₀ ℕ | e ∈ normalExponents m G ∧ weight w e = d} := by
    intro d
    have hsub : standardPieceSet m I w d ⊆
        {e : σ →₀ ℕ | e ∈ normalExponents m G ∧ weight w e = d} := by
      intro e he
      exact ⟨standardMonomials_subset_normalExponents m I G hGI he.1, he.2⟩
    have hsfin : (standardPieceSet m I w d).Finite := (hw d).subset (fun _ h => h.2)
    have htfin : {e : σ →₀ ℕ | e ∈ normalExponents m G ∧ weight w e = d}.Finite :=
      (hw d).subset (fun _ h => h.2)
    exact Set.eq_of_subset_of_ncard_le hsub
      (by rw [hHilbert d, finrank_quotientPiece m I w hI d hsfin]) htfin
  apply (MonomialOrder.isGroebnerBasis_iff_forall_exists_degree_le_degree
    (fun _ _ hg => m.isUnit_leadingCoeff.mpr hg)).mpr
  refine ⟨hGI, ?_⟩
  intro p hp hp0
  by_contra hno
  have hn : m.degree p ∈ normalExponents m G := by
    intro g hg hg0 hle
    exact hno ⟨g, hg, hg0, hle⟩
  have he : m.degree p ∈ standardPieceSet m I w (weight w (m.degree p)) := by
    rw [hsets]
    exact ⟨hn, rfl⟩
  exact he.1 p hp hp0 le_rfl

end Field

section Regroup

variable {S : Type*} [CommRing S]

/-- Move the variable `none` into the coefficient ring and then extend coefficients.
For `S = K(X)` this is precisely the generic diagonal pivot map. -/
def pivotMap (φ : Polynomial R →+* S) :
    MvPolynomial (Option σ) R →+* MvPolynomial σ S :=
  (MvPolynomial.map φ).comp (optionEquivRight R σ).toRingHom

theorem pivotMap_injective (φ : Polynomial R →+* S) (hφ : Function.Injective φ) :
    Function.Injective (pivotMap (σ := σ) φ) :=
  (MvPolynomial.map_injective φ hφ).comp (optionEquivRight R σ).injective

theorem optionEquivRight_monomial (e : Option σ →₀ ℕ) (c : R) :
    optionEquivRight R σ (monomial e c) =
      monomial e.some (Polynomial.monomial (e none) c) := by
  classical
  rw [optionEquivRight_apply, aeval_monomial, Finsupp.prod_option_index]
  · simp only [MvPolynomial.algebraMap_apply, Polynomial.algebraMap_eq,
      Option.elim_none, Option.elim_some]
    rw [MvPolynomial.monomial_eq, ← Polynomial.C_mul_X_pow_eq_monomial,
      map_mul, map_pow, mul_assoc]
  · simp
  · intros; rw [pow_add]

theorem pivotMap_monomial (φ : Polynomial R →+* S) (e : Option σ →₀ ℕ) (c : R) :
    pivotMap φ (monomial e c) = monomial e.some (φ (Polynomial.monomial (e none) c)) := by
  change MvPolynomial.map φ (optionEquivRight R σ (monomial e c)) = _
  rw [optionEquivRight_monomial, map_monomial]

@[simp] theorem pivotMap_X_none (φ : Polynomial R →+* S) :
    pivotMap (σ := σ) φ (X none) = C (φ Polynomial.X) := by
  change MvPolynomial.map φ (optionEquivRight R σ (X none)) = _
  rw [optionEquivRight_X_none, map_C]

@[simp] theorem pivotMap_X_some (φ : Polynomial R →+* S) (i : σ) :
    pivotMap φ (X (some i)) = X i := by
  change MvPolynomial.map φ (optionEquivRight R σ (X (some i))) = _
  rw [optionEquivRight_X_some, map_X]

@[simp] theorem pivotMap_C (φ : Polynomial R →+* S) (c : R) :
    pivotMap (σ := σ) φ (C c) = C (φ (Polynomial.C c)) := by
  change MvPolynomial.map φ (optionEquivRight R σ (C c)) = _
  rw [optionEquivRight_C, map_C]

/-- Regrouping may merge coefficient terms, but cannot introduce a new exponent
in the remaining variables. -/
theorem support_pivotMap (φ : Polynomial R →+* S) (p : MvPolynomial (Option σ) R) :
    (↑(pivotMap φ p).support : Set (σ →₀ ℕ)) ⊆
      Finsupp.some '' (↑p.support : Set (Option σ →₀ ℕ)) := by
  classical
  conv_lhs => rw [p.as_sum]
  rw [map_sum]
  simp only [pivotMap_monomial]
  intro e he
  obtain ⟨a, ha, he⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum he)
  have heq := Finset.mem_singleton.mp (MvPolynomial.support_monomial_subset he)
  exact ⟨a, ha, heq.symm⟩

theorem weight_pivot (w : σ → D) (e : Option σ →₀ ℕ) :
    weight (fun o : Option σ => o.elim 0 w) e = weight w e.some := by
  rw [weight_apply, Finsupp.sum_option_index_smul]
  simp only [Option.elim_none, nsmul_zero, Option.elim_some, zero_add, weight_apply]

theorem pivotMap_isWeightedHomogeneous
    (φ : Polynomial R →+* S) (w : σ → D) {p : MvPolynomial (Option σ) R} {d : D}
    (hp : p.IsWeightedHomogeneous (fun o : Option σ => o.elim 0 w) d) :
    (pivotMap φ p).IsWeightedHomogeneous w d := by
  classical
  intro e he
  obtain ⟨a, ha, rfl⟩ :=
    (support_pivotMap φ p (MvPolynomial.mem_support_iff.mpr he))
  rw [← weight_pivot]
  exact hp (MvPolynomial.mem_support_iff.mp ha)

theorem pivotMap_homogeneousIdeal
    (φ : Polynomial R →+* S) (w : σ → D) (H : Ideal (MvPolynomial (Option σ) R))
    (hH : H.IsHomogeneous
      (weightedHomogeneousSubmodule R (fun o : Option σ => o.elim 0 w))) :
    (H.map (pivotMap φ)).IsHomogeneous (weightedHomogeneousSubmodule S w) := by
  classical
  obtain ⟨T, hT⟩ := (Ideal.IsHomogeneous.iff_exists _ _).mp hH
  rw [hT, Ideal.map_span]
  apply Ideal.homogeneous_span
  rintro p ⟨q, ⟨t, ht, rfl⟩, rfl⟩
  obtain ⟨d, hd⟩ := t.2
  exact ⟨d, pivotMap_isWeightedHomogeneous φ w hd⟩

end Regroup

section Pivot

variable {K F : Type*} [Field K] [Field F]

/-- Descent from the generic pivot chart to the original monomial order.
Only the proposed generators need to retain their leading monomials. -/
theorem isGroebnerBasis_of_pivotMap
    (φ : Polynomial K →+* F) (hφ : Function.Injective φ)
    (m : MonomialOrder (Option σ)) (m' : MonomialOrder σ)
    (H : Ideal (MvPolynomial (Option σ) K)) (G : Set (MvPolynomial (Option σ) K))
    (hGH : G ⊆ H)
    (hfree : ∀ g ∈ G, g ≠ 0 → m.degree g none = 0)
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (pivotMap φ g) = (m.degree g).some)
    (hGB : m'.IsGroebnerBasis (pivotMap φ '' G) (H.map (pivotMap φ))) :
    m.IsGroebnerBasis G H := by
  classical
  apply MonomialOrder.isGroebnerBasis_iff_isRemainder_zero.mpr
  refine ⟨hGH, ?_⟩
  intro f hf
  obtain ⟨r, hr⟩ := MonomialOrder.exists_isRemainder
    (m := m) (fun _ _ hg => m.isUnit_leadingCoeff.mpr hg) f
  have hrH : r ∈ H := by
    have hh := H.sub_mem hf ((Ideal.span_le.mpr hGH) hr.sub_mem_span)
    simpa only [sub_sub_cancel] using hh
  have hr0 : r = 0 := by
    by_contra hne
    have hmap : pivotMap φ r ≠ 0 :=
      (map_ne_zero_iff _ (pivotMap_injective φ hφ)).mpr hne
    obtain ⟨_, ⟨g, hg, rfl⟩, hgmap, hle⟩ := hGB.exists_degree_le_degree
      (Ideal.mem_map_of_mem _ hrH) hmap
    have hg0 : g ≠ 0 := by intro h; apply hgmap; rw [h, map_zero]
    obtain ⟨e, he, heq⟩ :=
      (support_pivotMap φ r (m'.degree_mem_support hmap))
    have hsome : (m.degree g).some ≤ e.some := by
      simpa only [hdegree g hg hg0, heq] using hle
    have horig : m.degree g ≤ e := by
      intro i
      cases i with
      | none => rw [hfree g hg hg0]; exact Nat.zero_le _
      | some i => exact hsome i
    exact hr.not_degree_le he hg hg0 horig
  simpa only [hr0] using hr

/-- Lemma 3.3 in a degreewise formulation of equality of multigraded Hilbert series.

The coefficient homomorphism may be any injective map from `K[X]` to a field;
in particular it can be the canonical map to the rational-function field `K(X)`.
The positivity condition on the remaining-variable grading is expressed by
finite weight fibers.  No primality, generation, saturation, or independence
assumption is added to the hypotheses of the paper's comparison lemma. -/
theorem comparison_after_pivot
    (φ : Polynomial K →+* F) (hφ : Function.Injective φ)
    (m : MonomialOrder (Option σ)) (m' : MonomialOrder σ)
    (H : Ideal (MvPolynomial (Option σ) K)) (G : Set (MvPolynomial (Option σ) K))
    (hGH : G ⊆ H)
    (hfree : ∀ g ∈ G, g ≠ 0 → m.degree g none = 0)
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (pivotMap φ g) = (m.degree g).some)
    (w : σ → D)
    (hH : H.IsHomogeneous
      (weightedHomogeneousSubmodule K (fun o : Option σ => o.elim 0 w)))
    (hw : ∀ d, {e : σ →₀ ℕ | weight w e = d}.Finite)
    (hHilbert : ∀ d,
      {e : σ →₀ ℕ | e ∈ normalExponents m' (pivotMap φ '' G) ∧ weight w e = d}.ncard =
        Module.finrank F (quotientPiece (H.map (pivotMap φ)) w d)) :
    m.IsGroebnerBasis G H := by
  apply isGroebnerBasis_of_pivotMap φ hφ m m' H G hGH hfree hdegree
  apply isGroebnerBasis_of_hilbertFunction m' (H.map (pivotMap φ)) (pivotMap φ '' G)
    (by rintro _ ⟨g, hg, rfl⟩; exact Ideal.mem_map_of_mem _ (hGH hg)) w
    (pivotMap_homogeneousIdeal φ w H hH) hw hHilbert

end Pivot

end FourPapers.Symmetric.Pivot
