/-- The coordinate map from the original symmetric matrix into independent
Schur-complement coordinates. Thus the old lower block maps to `D + qbbᵀ`. -/
def firstPivotChartMap (φ : Polynomial R →+* S) (q : S) :
    CoordinateRing (n + 1) R →+* MvPolynomial (PivotVariables n) S :=
  (schurCoordinateEquiv q).symm.toRingHom.comp
    ((pivotMap φ).comp (pivotCoordinateEquiv (n := n) (R := R)).toRingHom)

