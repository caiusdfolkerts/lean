/-! ## Exact carrier interfaces, without an algebraic conclusion hidden in them -/

example : Pivot.NorthwestCarrierCorrespondence ↔
    ∀ (n : ℕ) (r : RankArray (n+1)),
      (∀ i j, r i j = r j i) → (∀ i j, 0 < r i j) →
      ∀ d : Fin n →₀ ℕ,
