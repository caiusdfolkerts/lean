namespace FourPapers.Symmetric
open MvPolynomial Finsupp

/-- An antidiagonal of size at least two cannot contain the upper-left
coordinate. Folding preserves this assertion because both endpoints are zero. -/
theorem antidiagonalExponent_diagonalPivot_zero {n t : ℕ}
    (a b : Fin t ↪o Fin (n + 1)) (ht : 1 < t) :
    antidiagonalExponent a b (fold 0 0) = 0 := by
  classical
  letI : NeZero t := ⟨by omega⟩
  apply Nat.eq_zero_of_not_pos
  intro h
  obtain ⟨p, hp⟩ := (antidiagonalExponent_pos_iff a b (fold 0 0)).mp h
  have hp' : a p = 0 ∧ b p.rev = 0 := by
    simpa only [or_self] using (fold_eq_iff _ _ _ _).mp hp
  have hfirst (c : Fin t ↪o Fin (n + 1)) (i : Fin t) (hi : c i = 0) : i.val = 0 := by
    have hh : i ≤ 0 := c.le_iff_le.mp (by rw [hi]; exact Fin.zero_le (c 0))
    exact Nat.eq_zero_of_le_zero hh
  have hpa := hfirst a p hp'.1
  have hpb := hfirst b p.rev hp'.2
  simp only [Fin.val_rev] at hpb
  omega

/-- For positive bounds every prescribed leading exponent omits the diagonal
pivot. This is the exact freeness hypothesis of the pivot comparison lemma. -/
theorem northwestGenerator_diagonalPivot_degree_zero {n : ℕ} (R : Type*)
    [CommRing R] [Nontrivial R] (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    {g : CoordinateRing (n + 1) R} (hg : g ∈ northwestGenerators R r) :
    ((foldedOrder (n + 1)).degree g) (fold 0 0) = 0 := by
  obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
  rw [minor_degree]
  apply antidiagonalExponent_diagonalPivot_zero
  have := hpos i j
  omega

/-- The diagonal pivot is regular for the monomial ideal of any positive
array, independently of whether the array is realizable by a matrix. -/
theorem northwestAntidiagonalIdeal_mul_diagonal_mem_iff {n : ℕ} (R : Type*)
    [CommRing R] (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    (f : CoordinateRing (n + 1) R) :
    f * X (fold 0 0) ∈ northwestAntidiagonalIdeal R r ↔
      f ∈ northwestAntidiagonalIdeal R r := by
  rw [northwestAntidiagonalIdeal_eq_span_exponents]
  apply monomialIdeal_mul_X_mem_iff
  rintro d ⟨i, j, a, b, ha, hb, rfl⟩ e h
  refine ⟨antidiagonalExponent a b, ⟨i, j, a, b, ha, hb, rfl⟩, ?_⟩
  apply antidiagonalExponent_le_cancel_single_of_zero (fold 0 0) _ h
  apply antidiagonalExponent_diagonalPivot_zero
  have := hpos i j
  omega

/-- A separately proved positive northwest Gröbner basis transfers diagonal
regularity to the actual ideal over any coefficient domain. -/
theorem northwestIdeal_mul_diagonal_mem_iff_of_groebner {n : ℕ} (R : Type*)
    [CommRing R] [NoZeroDivisors R] (r : RankArray (n + 1))
    (hpos : ∀ i j, 0 < r i j)
    (hG : (foldedOrder (n + 1)).IsGroebnerBasis (northwestGenerators R r) (northwestIdeal R r))
    (f : CoordinateRing (n + 1) R) :
    f * X (fold 0 0) ∈ northwestIdeal R r ↔ f ∈ northwestIdeal R r := by
  have hinit := northwest_initial_eq_of_groebner R r hG
  apply MonomialOrder.IsGroebnerBasis.mul_X_mem_iff_of_initial (foldedOrder (n + 1)) hG
  · rintro g ⟨i, j, a, b, ha, hb, rfl⟩ _
    exact minor_leadingCoeff_isUnit R a b
  · intro g hg
    change g * X (fold 0 0) ∈ initialIdeal R (northwestIdeal R r) at hg
    change g ∈ initialIdeal R (northwestIdeal R r)
    rw [hinit] at hg ⊢
    exact (northwestAntidiagonalIdeal_mul_diagonal_mem_iff R r hpos g).mp hg

end FourPapers.Symmetric
end
