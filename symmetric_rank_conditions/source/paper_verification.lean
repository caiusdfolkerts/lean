/-!
# Primeness for every realized symmetric rank profile

The induction has three literal matrix branches: a zero first row, a nonzero
diagonal pivot, and a first off-diagonal pivot. The two Schur charts use actual
coordinate-ring isomorphisms and genuine Laurent localizations, with the
off-diagonal diagonal entry retained. The witness field and coefficient domain
are independent throughout.
-/

namespace FourPapers.Symmetric
open MvPolynomial
universe u v

theorem exists_first_nonzero_firstRow {n : ℕ} {F : Type*} [Zero F]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (h : ¬∀ j, w 0 j = 0) :
    ∃ k : Fin (n + 1), w 0 k ≠ 0 ∧ ∀ j < k, w 0 j = 0 := by
  classical
  let s := Finset.univ.filter (fun k : Fin (n + 1) => w 0 k ≠ 0)
  have hs : s.Nonempty := by
    push Not at h
    obtain ⟨k, hk⟩ := h
    exact ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hk⟩⟩
  obtain ⟨k, hk, hmin⟩ := Finset.exists_min_image s id hs
  refine ⟨k, (Finset.mem_filter.mp hk).2, ?_⟩
  intro j hj
  by_contra hne
  have hkj := hmin j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hne⟩)
  exact (not_le_of_gt hj) hkj

/-- Primeness over every coefficient domain, for every symmetric matrix rank
profile over an unrelated witness field. The only external input is the
ordinary northwest Gröbner theorem, used solely for regular-pivot cancellation. -/
theorem northwestIdeals_prime_of_northwestGroebner
    (hNW : ∀ (n : ℕ) (K : Type v) [Field K] (r : RankArray n),
      (∀ i j, r i j = r j i) →
        (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r)) :
    ∀ (n : ℕ) (F : Type u) [Field F] (w : Matrix (Fin n) (Fin n) F),
      w.transpose = w → ∀ (R : Type v) [CommRing R] [IsDomain R],
        (northwestIdeal R (matrixRankArray w)).IsPrime := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro F _ w hw R _ _
    cases n with
    | zero => exact northwestIdeal_isPrime_zero_dimension R (matrixRankArray w)
    | succ n =>
      have hG : (foldedOrder (n + 1)).IsGroebnerBasis
          (northwestGenerators R (matrixRankArray w)) (northwestIdeal R (matrixRankArray w)) :=
        northwestGroebner_of_fraction R _
          (hNW (n + 1) (FractionRing R) (matrixRankArray w) (matrixRankArray_symmetric w hw))
      by_cases hrow : ∀ j, w 0 j = 0
      · apply northwestIdeal_isPrime_of_zero_row w hw hrow R
        exact ih n (Nat.lt_succ_self n) F (firstDeletedMatrix w)
          (firstDeletedMatrix_symmetric w hw) R
      · obtain ⟨k, hk, hzero⟩ := exists_first_nonzero_firstRow w hrow
        rcases Fin.eq_zero_or_eq_succ k with rfl | ⟨k, rfl⟩
        · apply northwestIdeal_isPrime_of_diagonal w hw hk hG
          letI : IsDomain (DiagonalLaurentRing R) := diagonalLaurent_isDomain R
          exact ih n (Nat.lt_succ_self n) F (firstSchurMatrix w (w 0 0)⁻¹)
            (firstSchurMatrix_symmetric w hw _) (DiagonalLaurentRing R)
        · cases n with
          | zero => exact Fin.elim0 k
          | succ n =>
            apply northwestIdeal_isPrime_of_offDiagonal w hw k hk hzero hG
            letI : IsDomain (OffDiagonalLaurentRing R k) := offDiagonalLaurent_isDomain R k
            exact ih n (by omega) F (offDiagonalResidualMatrix w k (w 0 k.succ)⁻¹)
              (offDiagonalResidualMatrix_symmetric w hw k _) (OffDiagonalLaurentRing R k)

/-- The complete algebraic assertion of Theorem 1.1, derived from the literal
carrier correspondence and the full three-branch primeness induction. -/
theorem rankLocusAssertion_of_carrierCorrespondence
    (hcarrier : Pivot.NorthwestCarrierCorrespondence) : RankLocusAssertion.{u, v} := by
  have hNW := northwestGroebner_of_carrierCorrespondence.{v} hcarrier
  have hprime : ∀ (n : ℕ) (F : Type u) [Field F] (w : Matrix (Fin n) (Fin n) F),
      w.transpose = w → ∀ (R : Type v) [CommRing R] [IsDomain R],
        (northwestIdeal R (matrixRankArray w)).IsPrime :=
    northwestIdeals_prime_of_northwestGroebner hNW
  intro n F _ w hw K _
  exact ⟨hprime n F w hw K,
    northwest_initial_eq_of_groebner K (matrixRankArray w)
      (hNW n K (matrixRankArray w) (matrixRankArray_symmetric w hw))⟩

/-- Theorem 1.1 including the defining ideal of the actual rank-bounded set
over an algebraically closed coefficient field. The Nullstellensatz step is
the separately checked theorem relating that set to the determinantal ideal. -/
theorem symmetricRankLociTheorem_of_carrierCorrespondence
    (hcarrier : Pivot.NorthwestCarrierCorrespondence) : SymmetricRankLociTheorem.{u, v} :=
  symmetricRankLociTheorem_iff_rankLocusAssertion.mpr
    (rankLocusAssertion_of_carrierCorrespondence hcarrier)

end FourPapers.Symmetric
end
