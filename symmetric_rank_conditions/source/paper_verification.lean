/- The following stock-Lean audit is copied from the canonical trust audit,
with its root list restricted to this independent algebra stage. It permits
only propext, Classical.choice and Quot.sound; records exact transitive root
axioms; rejects authored axioms and unsafe proof dependencies; and exports
the local declaration dependency graph. Its success would certify only the
explicitly conditional statements above, pending the later matching bridges. -/
#print axioms FourPapers.Symmetric.Pivot.standardPieceEquiv
#print axioms FourPapers.Symmetric.Pivot.standardPieceBasis
#print axioms FourPapers.Symmetric.Pivot.finrank_quotientPiece
#print axioms FourPapers.Symmetric.Pivot.isGroebnerBasis_of_hilbertFunction
#print axioms FourPapers.Symmetric.Pivot.lemma_3_3_symmetric
#print axioms FourPapers.Symmetric.Pivot.isGroebnerBasis_rename_inr
#print axioms FourPapers.Symmetric.Pivot.finrank_symmetric_carrier_quotient
#print axioms FourPapers.Symmetric.Pivot.finrank_genericPivot_quotient_eq_carriers
#print axioms FourPapers.Symmetric.Pivot.groebner_of_exact_carrier_equivalences
#print axioms FourPapers.Symmetric.Pivot.determinantalIdeal_map_firstPivotChart
#print axioms FourPapers.Symmetric.Pivot.northwestIdeal_map_firstPivotChart
#print axioms FourPapers.Symmetric.Pivot.symbolicPower_map_genericFirstPivotChart
#print axioms FourPapers.Symmetric.Pivot.symbolicPower_comap_genericFirstPivotChart
#print axioms FourPapers.Symmetric.Pivot.mixedIdeal_map_genericFirstPivotChart
#print axioms FourPapers.Symmetric.ideal_comap_map_away_of_regular
#print axioms FourPapers.Symmetric.ideal_isPrime_of_regular_away
#print axioms FourPapers.Symmetric.northwestIdeal_isPrime_of_zero_row
#print axioms FourPapers.Symmetric.northwestIdeal_isPrime_of_diagonal
#print axioms FourPapers.Symmetric.northwestIdeal_isPrime_of_offDiagonal
#print axioms FourPapers.Symmetric.determinantalIdeals_prime_of_northwestGroebner
#print axioms FourPapers.Symmetric.Pivot.determinantalIdeal_le_symbolicPower_of_primality
#print axioms FourPapers.Symmetric.Pivot.symbolicGenerators_subset_symbolicPower_of_primality
#print axioms FourPapers.Symmetric.northwestIdeals_prime_of_northwestGroebner
#print axioms FourPapers.Symmetric.northwestGroebner_of_carrierCorrespondence
#print axioms FourPapers.Symmetric.northwest_initial_of_carrierCorrespondence
#print axioms FourPapers.Symmetric.Pivot.northwestCarrierCorrespondence_of_mixed
#print axioms FourPapers.Symmetric.compatibleGroebner_of_carrierCorrespondences
#print axioms FourPapers.Symmetric.compatibleGroebner_of_mixedCarrier
#print axioms FourPapers.Symmetric.integralBaseChange_of_carrierCorrespondences
#print axioms FourPapers.Symmetric.integralBaseChange_of_mixedCarrier
#print axioms FourPapers.Symmetric.rankLocusAssertion_of_carrierCorrespondence
#print axioms FourPapers.Symmetric.symmetricRankLociTheorem_of_carrierCorrespondence

set_option maxHeartbeats 8000000 in
open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let constants := env.checked.get.constants.foldStage2
    (fun acc name ci => acc.push (name, ci)) (#[] : Array (Name × ConstantInfo))
  let allowed : Array Name := #["propext".toName, "Classical.choice".toName, "Quot.sound".toName]
  let roots : Array Name := #[
    "FourPapers.Symmetric.Pivot.standardPieceEquiv".toName,
    "FourPapers.Symmetric.Pivot.standardPieceBasis".toName,
    "FourPapers.Symmetric.Pivot.finrank_quotientPiece".toName,
    "FourPapers.Symmetric.Pivot.isGroebnerBasis_of_hilbertFunction".toName,
    "FourPapers.Symmetric.Pivot.lemma_3_3_symmetric".toName,
    "FourPapers.Symmetric.Pivot.isGroebnerBasis_rename_inr".toName,
    "FourPapers.Symmetric.Pivot.finrank_symmetric_carrier_quotient".toName,
    "FourPapers.Symmetric.Pivot.finrank_genericPivot_quotient_eq_carriers".toName,
    "FourPapers.Symmetric.Pivot.groebner_of_exact_carrier_equivalences".toName,
    "FourPapers.Symmetric.Pivot.determinantalIdeal_map_firstPivotChart".toName,
    "FourPapers.Symmetric.Pivot.northwestIdeal_map_firstPivotChart".toName,
    "FourPapers.Symmetric.Pivot.symbolicPower_map_genericFirstPivotChart".toName,
    "FourPapers.Symmetric.Pivot.symbolicPower_comap_genericFirstPivotChart".toName,
    "FourPapers.Symmetric.Pivot.mixedIdeal_map_genericFirstPivotChart".toName,
    "FourPapers.Symmetric.ideal_comap_map_away_of_regular".toName,
    "FourPapers.Symmetric.ideal_isPrime_of_regular_away".toName,
    "FourPapers.Symmetric.northwestIdeal_isPrime_of_zero_row".toName,
    "FourPapers.Symmetric.northwestIdeal_isPrime_of_diagonal".toName,
    "FourPapers.Symmetric.northwestIdeal_isPrime_of_offDiagonal".toName,
    "FourPapers.Symmetric.determinantalIdeals_prime_of_northwestGroebner".toName,
    "FourPapers.Symmetric.Pivot.determinantalIdeal_le_symbolicPower_of_primality".toName,
    "FourPapers.Symmetric.Pivot.symbolicGenerators_subset_symbolicPower_of_primality".toName,
    "FourPapers.Symmetric.northwestIdeals_prime_of_northwestGroebner".toName,
    "FourPapers.Symmetric.northwestGroebner_of_carrierCorrespondence".toName,
    "FourPapers.Symmetric.northwest_initial_of_carrierCorrespondence".toName,
    "FourPapers.Symmetric.Pivot.northwestCarrierCorrespondence_of_mixed".toName,
    "FourPapers.Symmetric.compatibleGroebner_of_carrierCorrespondences".toName,
    "FourPapers.Symmetric.compatibleGroebner_of_mixedCarrier".toName,
    "FourPapers.Symmetric.integralBaseChange_of_carrierCorrespondences".toName,
    "FourPapers.Symmetric.integralBaseChange_of_mixedCarrier".toName,
    "FourPapers.Symmetric.rankLocusAssertion_of_carrierCorrespondence".toName,
    "FourPapers.Symmetric.symmetricRankLociTheorem_of_carrierCorrespondence".toName]
  let mut runtimeOnly : Array Name := #[]
  let mut auditedImports : NameSet := {}
  for (name, ci) in constants do
    if ci.isAxiom then
      throwError "Unapproved local axiom: {name}"
    if ci.isUnsafe || ci.isPartial then
      unless name.getString! == "_unsafe_rec" do
        throwError "Authored or unrecognized unsafe declaration: {name}"
      match env.find? name.getPrefix with
      | some parent =>
        if parent.isUnsafe || parent.isPartial || parent.isAxiom then
          throwError "Unsafe runtime companion lacks safe defining declaration: {name}"
      | none => throwError "Unrecognized runtime companion: {name}"
      runtimeOnly := runtimeOnly.push name
    else
      for dep in ci.type.getUsedConstants ++ ((ci.value? true).map Expr.getUsedConstants |>.getD #[]) do
        if let some info := env.find? dep then
          if info.isUnsafe || info.isPartial then
            throwError "Unsafe proof dependency {dep} in safe declaration {name}"
          if info.isAxiom && !auditedImports.contains dep then
            -- Exported theorems may have axiom-shaped public declarations. Stock Lean's
            -- exportedAxiomsExt stores their checked, transitive axiom dependencies.
            -- collectAxioms uses that metadata rather than misclassifying proof stubs.
            let deps ← collectAxioms dep
            for ax in deps do
              if !allowed.contains ax then
                throwError "Unapproved imported axiom {ax}, reached through {dep} in {name}"
            auditedImports := auditedImports.insert dep
  let mut rootAxioms : Array Json := #[]
  for root in roots do
    unless env.contains root do
      throwError "Required final theorem is unavailable: {root}"
    let axioms ← collectAxioms root
    for ax in axioms do
      if !allowed.contains ax then
        throwError "Unapproved transitive axiom in {root}: {ax}"
    rootAxioms := rootAxioms.push <| Json.mkObj [
      ("theorem", toJson root.toString), ("axioms", toJson (axioms.map Name.toString))]
  let ctors (ci : ConstantInfo) : Array Name :=
    match ci with
    | .inductInfo v => v.ctors.toArray
    | _ => #[]
  let mut names : NameSet := {}
  for (name, ci) in constants do
    names := names.insert name
    for dep in ci.type.getUsedConstants do
      names := names.insert dep
    for dep in (ci.value? true).map Expr.getUsedConstants |>.getD #[] do
      names := names.insert dep
    for dep in ctors ci do
      names := names.insert dep
  for root in roots do
    names := names.insert root
  let dictionary := names.toArray.qsort Name.lt
  let mut indices : NameMap Nat := {}
  for i in [:dictionary.size] do
    indices := indices.insert dictionary[i]! i
  let index (n : Name) := (indices.find? n).getD 0
  let data := constants.map fun (name, ci) =>
    Json.arr #[toJson (index name), toJson (ci.type.getUsedConstants.map index),
      toJson (((ci.value? true).map Expr.getUsedConstants |>.getD #[]).map index),
      toJson ((ctors ci).map index), toJson ci.isAxiom, toJson ci.isUnsafe, toJson ci.isPartial]
  let graph := Json.mkObj [
    ("format", toJson "local-proof-dag-v1"),
    ("scope", toJson "independent-algebra-conditional-foundation"),
    ("columns", toJson (#["name", "type", "value", "inductiveCtors", "axiom", "unsafe", "partial"] : Array String)),
    ("names", toJson (dictionary.map Name.toString)),
    ("nodes", Json.arr data),
    ("roots", toJson (roots.map index)),
    ("root_axioms", Json.arr rootAxioms),
    ("compiler_runtime_only", toJson (runtimeOnly.map Name.toString))]
  liftIO <| IO.FS.createDirAll ".lake/reports/audit"
  liftIO <| IO.FS.writeFile ".lake/reports/audit/canonical_dependency_graph.json" (Json.compress graph)
  logInfo m!"CANONICAL_AUDIT_OK {constants.size} local declarations; {roots.size} verification roots; only propext, Classical.choice, Quot.sound; no authored axioms or unsafe proof dependencies."

