/-!
# Symbolic powers in the actual generic symmetric pivot chart

The original symmetric ring is first identified with a polynomial ring over
`K[x]`, then localized at its nonzero coefficient polynomials, then transported
through the inverse Schur change. Polynomial extension by the carrier variables
is handled by the exact checked symbolic-extension theorem. The only primality
hypotheses are the explicit ordinary determinantal ideals used in the induction.

This continues the prior `PivotDeterminantalChart` proof development using the
single coordinate equivalence of `PivotGradedTransport`.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp
variable {n : ℕ}

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- Polynomial extension of an actual localization. This is the proof of
Mathlib's `MvPolynomial.isLocalization`, repeated under a local project name
so that only its two narrow theory dependencies are needed here. -/
theorem polynomial_isLocalization {σ R : Type*} [CommRing R]
    (M : Submonoid R) (S : Type*) [CommRing S] [Algebra R S]
    [IsLocalization M S] :
    IsLocalization (M.map (MvPolynomial.C (σ := σ))) (MvPolynomial σ S) := by
  exact isLocalizedModule_iff_isLocalization.mp <|
    (isLocalizedModule_iff_isBaseChange M S _).mpr <|
      .of_equiv (MvPolynomial.algebraTensorAlgEquiv _ _).toLinearEquiv fun _ => by simp

section PolynomialExtension

variable {σ τ R : Type*} [CommRing R]

theorem sumRingEquiv_symm_comp_C :
    (sumRingEquiv R σ τ).symm.toRingHom.comp (C : MvPolynomial τ R →+*
      MvPolynomial σ (MvPolynomial τ R)) = (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom := by
  apply RingHom.ext
  intro p
  change (sumRingEquiv R σ τ).symm (C p) = rename (Sum.inr : τ → σ ⊕ τ) p
  induction p using MvPolynomial.induction_on with
  | C r => simp
  | add p q hp hq => simpa only [map_add] using congrArg₂ (· + ·) hp hq
  | mul_X p i hp =>
    simpa only [map_mul, sumRingEquiv_symm_C_X, rename_X] using
      (congrArg (fun z : MvPolynomial (σ ⊕ τ) R => z * X (Sum.inr i)) hp)

theorem map_rename_inr_eq (I : Ideal (MvPolynomial τ R)) :
    I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom =
      (I.map (C : MvPolynomial τ R →+* MvPolynomial σ (MvPolynomial τ R))).map
        (sumRingEquiv R σ τ).symm.toRingHom := by
  rw [Ideal.map_map, sumRingEquiv_symm_comp_C]

theorem map_rename_inr_isPrime (I : Ideal (MvPolynomial τ R)) [I.IsPrime] :
    (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom).IsPrime := by
  rw [map_rename_inr_eq]
  letI := mv_map_C_isPrime (σ := σ) I
  exact ideal_isPrime_map_ringEquiv (sumRingEquiv R σ τ).symm _

/-- Adjoining the free carrier variables commutes with actual symbolic
powers.  This uses the proved polynomial-extension theorem, not an assumed
description by determinant products. -/
theorem symbolicPower_map_rename_inr [Fintype σ]
    (I : Ideal (MvPolynomial τ R)) [I.IsPrime] (s : ℕ) :
    (symbolicPower I s).map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom =
      symbolicPower (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom) s := by
  rw [map_rename_inr_eq, map_rename_inr_eq]
  rw [symbolicPower_map_C]
  letI := mv_map_C_isPrime (σ := σ) I
  exact symbolicPower_map_equiv (sumRingEquiv R σ τ).symm _ s

end PolynomialExtension

section GenericSymbolicChart

open scoped nonZeroDivisors

attribute [local instance] MvPolynomial.algebraMvPolynomial

variable (K : Type*) [Field K]

/-- Regroup the actual first diagonal coordinate into the coefficient ring. -/
def firstPivotCoefficientEquiv (n : ℕ) :
    CoordinateRing (n + 1) K ≃ₐ[K] MvPolynomial (PivotVariables n) (Polynomial K) :=
  (pivotCoordinateEquiv (R := K) (n := n)).trans (optionEquivRight K (PivotVariables n))

/-- The generic-field chart on the original symmetric coordinate ring. -/
def genericFirstPivotChart :
    CoordinateRing (n + 1) K →+* MvPolynomial (PivotVariables n) (RatFunc K) :=
  firstPivotChartMap (algebraMap (Polynomial K) (RatFunc K)) (genericPivotScalar K)⁻¹

theorem genericFirstPivotChart_factor :
    (schurCoordinateEquiv (genericPivotScalar K)⁻¹).symm.toRingHom.comp
      ((algebraMap (MvPolynomial (PivotVariables n) (Polynomial K))
          (MvPolynomial (PivotVariables n) (RatFunc K))).comp
        (firstPivotCoefficientEquiv K n).toRingHom) = genericFirstPivotChart (n := n) K := by
  rw [MvPolynomial.algebraMap_def]
  rfl

theorem determinantalIdeal_map_genericFirstPivotChart (t : ℕ) :
    (determinantalIdeal (n + 1) K (t + 1)).map (genericFirstPivotChart (n := n) K) =
      (determinantalIdeal n (RatFunc K) t).map
        (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom := by
  apply determinantalIdeal_map_firstPivotChart
  exact inv_mul_cancel₀ (genericPivotScalar_ne_zero K)

/-- The actual generic-field northwest chart lowers every positive bound. -/
theorem northwestIdeal_map_genericFirstPivotChart
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j) :
    (northwestIdeal K r).map (genericFirstPivotChart (n := n) K) =
      (northwestIdeal (RatFunc K) (residualRankArray r)).map
        (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom :=
  northwestIdeal_map_firstPivotChart _ _
    (inv_mul_cancel₀ (genericPivotScalar_ne_zero K)) r hpos

/-- Exact image of every symbolic power in the generic diagonal Schur chart.
The primality assumptions are the ordinary determinantal primality results
already established in the rank part of the paper's induction. -/
theorem symbolicPower_map_genericFirstPivotChart (t s : ℕ)
    [(determinantalIdeal (n + 1) K (t + 1)).IsPrime]
    [(determinantalIdeal n (RatFunc K) t).IsPrime] :
    (symbolicPower (determinantalIdeal (n + 1) K (t + 1)) s).map
      (genericFirstPivotChart (n := n) K) =
      (symbolicPower (determinantalIdeal n (RatFunc K) t) s).map
        (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom := by
  let A := MvPolynomial (PivotVariables n) (Polynomial K)
  let B := MvPolynomial (PivotVariables n) (RatFunc K)
  let M : Submonoid A := (Polynomial K)⁰.map (C : Polynomial K →+* A)
  letI : IsLocalization M B :=
    polynomial_isLocalization (σ := PivotVariables n) (Polynomial K)⁰ (RatFunc K)
  let e := (firstPivotCoefficientEquiv K n).toRingEquiv
  let d : B ≃+* B :=
    (schurCoordinateEquiv (n := n) (genericPivotScalar K)⁻¹).symm.toRingEquiv
  let P := determinantalIdeal (n + 1) K (t + 1)
  let Q := (determinantalIdeal n (RatFunc K) t).map
    (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom
  letI : Q.IsPrime := map_rename_inr_isPrime _
  have hPQ : ((P.map e.toRingHom).map (algebraMap A B)).map d.toRingHom = Q := by
    simp only [Ideal.map_map]
    change P.map (d.toRingHom.comp ((algebraMap A B).comp e.toRingHom)) = Q
    rw [genericFirstPivotChart_factor]
    exact determinantalIdeal_map_genericFirstPivotChart K t
  have hs := symbolicPower_map_chart M e d P Q hPQ s
  rw [← symbolicPower_map_rename_inr] at hs
  have hfactor : d.toRingHom.comp ((algebraMap A B).comp e.toRingHom) =
      genericFirstPivotChart (n := n) K := genericFirstPivotChart_factor K
  simpa only [Ideal.map_map, hfactor] using hs

/-- Exact contraction from the same chart.  In particular, no generation
formula for determinantal symbolic powers is assumed by the Schur argument. -/
theorem symbolicPower_comap_genericFirstPivotChart (t s : ℕ)
    [(determinantalIdeal (n + 1) K (t + 1)).IsPrime]
    [(determinantalIdeal n (RatFunc K) t).IsPrime] :
    ((symbolicPower (determinantalIdeal n (RatFunc K) t) s).map
      (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom).comap
        (genericFirstPivotChart (n := n) K) =
      symbolicPower (determinantalIdeal (n + 1) K (t + 1)) s := by
  let A := MvPolynomial (PivotVariables n) (Polynomial K)
  let B := MvPolynomial (PivotVariables n) (RatFunc K)
  let M : Submonoid A := (Polynomial K)⁰.map (C : Polynomial K →+* A)
  letI : IsLocalization M B :=
    polynomial_isLocalization (σ := PivotVariables n) (Polynomial K)⁰ (RatFunc K)
  let e := (firstPivotCoefficientEquiv K n).toRingEquiv
  let d : B ≃+* B :=
    (schurCoordinateEquiv (n := n) (genericPivotScalar K)⁻¹).symm.toRingEquiv
  let P := determinantalIdeal (n + 1) K (t + 1)
  let Q := (determinantalIdeal n (RatFunc K) t).map
    (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom
  letI : Q.IsPrime := map_rename_inr_isPrime _
  have hPQ : ((P.map e.toRingHom).map (algebraMap A B)).map d.toRingHom = Q := by
    simp only [Ideal.map_map]
    change P.map (d.toRingHom.comp ((algebraMap A B).comp e.toRingHom)) = Q
    rw [genericFirstPivotChart_factor]
    exact determinantalIdeal_map_genericFirstPivotChart K t
  have hs := symbolicPower_comap_chart M e d P Q hPQ s
  rw [← symbolicPower_map_rename_inr] at hs
  have hfactor : d.toRingHom.comp ((algebraMap A B).comp e.toRingHom) =
      genericFirstPivotChart (n := n) K := genericFirstPivotChart_factor K
  simpa only [Ideal.comap_comap, RingHom.comp_assoc, hfactor] using hs

/-- The same genuine chart handles a northwest ideal and an arbitrary
finite list of symbolic powers simultaneously. The source thresholds are
one larger than the residual thresholds; the symbolic exponents are unchanged.
Only ordinary determinantal primality is assumed at this induction step. -/
theorem mixedIdeal_map_genericFirstPivotChart
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    (conditions : List (ℕ × ℕ))
    (hbig : ∀ ts ∈ conditions,
      (determinantalIdeal (n + 1) K (ts.1 + 1)).IsPrime)
    (hsmall : ∀ ts ∈ conditions,
      (determinantalIdeal n (RatFunc K) ts.1).IsPrime) :
    (mixedIdeal K r (conditions.map (fun ts => (ts.1 + 1, ts.2)))).map
      (genericFirstPivotChart (n := n) K) =
        (mixedIdeal (RatFunc K) (residualRankArray r) conditions).map
          (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom := by
  revert hbig hsmall
  induction conditions with
  | nil =>
    intro _ _
    simpa only [List.map_nil, mixedIdeal, List.sum_nil, add_zero] using
      northwestIdeal_map_genericFirstPivotChart K r hpos
  | cons ts conditions ih =>
    intro hbig hsmall
    letI : (determinantalIdeal (n + 1) K (ts.1 + 1)).IsPrime :=
      hbig ts (List.mem_cons_self ..)
    letI : (determinantalIdeal n (RatFunc K) ts.1).IsPrime :=
      hsmall ts (List.mem_cons_self ..)
    have hrest := ih
      (fun a ha => hbig a (List.mem_cons_of_mem _ ha))
      (fun a ha => hsmall a (List.mem_cons_of_mem _ ha))
    simp only [List.map_cons, mixedIdeal_cons, Ideal.add_eq_sup, Ideal.map_sup,
      Prod.fst, Prod.snd]
    rw [hrest, symbolicPower_map_genericFirstPivotChart K ts.1 ts.2]

end GenericSymbolicChart

end FourPapers.Symmetric.Pivot
end
