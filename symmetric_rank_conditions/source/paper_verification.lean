section

set_option autoImplicit false
set_option maxHeartbeats 1000000
noncomputable section

/-!
# The simultaneous northwest and symbolic Gröbner induction

The symbolic ideals in this file are the localization-defined symbolic powers.
Their ordinary prime ideals are supplied by the independent northwest theorem,
and containment of the prescribed products is proved by genuine Schur charts.
The combinatorial interface refers only to exact antidiagonal products and
their endpoint multiplicities. No symbolic generation assertion enters it.
-/

namespace FourPapers.Symmetric
open MvPolynomial Finsupp
open scoped MonomialOrder
universe u v

/-- Literal divisibility by one proposed symbolic antidiagonal product,
with its exact score, every number of factors, and no field parameter. -/
def HasSymbolicAntidiagonal {n : ℕ} (t s : ℕ) (e : Entry n →₀ ℕ) : Prop :=
  ∃ (k : ℕ) (δ : Fin k → MinorData n),
    (∀ j, t ≤ (δ j).size) ∧ (∑ j, ((δ j).size - t + 1)) = s ∧
    (∑ j, (δ j).exponent) ≤ e

/-- The exact union of the rank and symbolic antidiagonal obstructions. -/
def HasMixedObstruction {n : ℕ} (r : RankArray n) (conditions : List (ℕ × ℕ))
    (e : Entry n →₀ ℕ) : Prop :=
  HasForbiddenAntidiagonal r e ∨
    ∃ ts ∈ conditions, HasSymbolicAntidiagonal ts.1 ts.2 e

namespace Pivot

def mixedPivotPiece {n : ℕ} (r : RankArray (n + 1))
    (conditions : List (ℕ × ℕ)) (d : Fin n →₀ ℕ) : Set (PivotVariables n →₀ ℕ) :=
  {e | ¬HasMixedObstruction r conditions (liftPivotExponent e) ∧
    weight pivotEndpointWeight e = d}

def mixedCarrierPiece {n : ℕ} (r : RankArray n)
    (conditions : List (ℕ × ℕ)) (d : Fin n →₀ ℕ) :
    Set ((Fin n →₀ ℕ) × (Entry n →₀ ℕ)) :=
  {p | ¬HasMixedObstruction r conditions p.2 ∧
    p.1 + weight endpointWeight p.2 = d}

/-- First-row deletion with all simultaneous obstructions. This defines the
precise combinatorial proposition to be proved by matching insertion and
Greene packings; it is not an axiom or an asserted result. -/
def MixedCarrierCorrespondence : Prop :=
  ∀ (n : ℕ) (r : RankArray (n + 1)),
    (∀ i j, r i j = r j i) → (∀ i j, 0 < r i j) →
    ∀ conditions : List (ℕ × ℕ), ValidSymbolicConditions n conditions →
    ∀ d : Fin n →₀ ℕ,
      Nonempty (mixedPivotPiece r (conditions.map (fun ts => (ts.1 + 1, ts.2))) d ≃
        mixedCarrierPiece (residualRankArray r) conditions d)

/-- The empty symbolic list recovers the ordinary northwest correspondence,
so one uniform combinatorial theorem supplies both induction stages. -/
theorem northwestCarrierCorrespondence_of_mixed (h : MixedCarrierCorrespondence) :
    NorthwestCarrierCorrespondence := by
  intro n r hr hpos d
  have hc := h n r hr hpos [] (by intro ts hts; simp at hts) d
  simpa only [List.map_nil, mixedPivotPiece, mixedCarrierPiece,
    HasMixedObstruction, List.not_mem_nil, false_and, exists_false, or_false,
    northwestPivotPiece, northwestCarrierPiece] using hc

end Pivot

theorem mixed_degree_divisor_iff {n : ℕ} (K : Type*) [Field K]
    (r : RankArray n) (conditions : List (ℕ × ℕ)) (e : Entry n →₀ ℕ) :
    (∃ g ∈ mixedGenerators K r conditions,
      g ≠ 0 ∧ (foldedOrder n).degree g ≤ e) ↔ HasMixedObstruction r conditions e := by
  constructor
  · rintro ⟨g, hg, hg0, hge⟩
    rcases hg with hg | ⟨ts, hts, k, δ, hsize, hscore, rfl⟩
    · obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
      left
      apply (hasForbiddenAntidiagonal_iff_generator_le r e).mpr
      exact ⟨antidiagonalExponent a b, ⟨i, j, a, b, ha, hb, rfl⟩,
        by simpa only [minor_degree] using hge⟩
    · right
      exact ⟨ts, hts, k, δ, hsize, hscore,
        by simpa only [product_minors_degree] using hge⟩
  · rintro (h | ⟨ts, hts, k, δ, hsize, hscore, hle⟩)
    · obtain ⟨a, ⟨i, j, rows, cols, hrows, hcols, rfl⟩, hle⟩ :=
        (hasForbiddenAntidiagonal_iff_generator_le r e).mp h
      have hg : minor K rows cols ∈ mixedGenerators K r conditions :=
        Or.inl ⟨i, j, rows, cols, hrows, hcols, rfl⟩
      exact ⟨minor K rows cols, hg, mixedGenerators_nonzero K r conditions _ hg,
        by simpa only [minor_degree] using hle⟩
    · have hg : (∏ j, (δ j).polynomial K) ∈ mixedGenerators K r conditions :=
        Or.inr ⟨ts, hts, k, δ, hsize, hscore, rfl⟩
      exact ⟨_, hg, mixedGenerators_nonzero K r conditions _ hg,
        by simpa only [product_minors_degree] using hle⟩

theorem mixed_standardMonomials_iff_obstruction {n : ℕ} (K : Type*) [Field K]
    (r : RankArray n) (conditions : List (ℕ × ℕ))
    (hGB : (foldedOrder n).IsGroebnerBasis
      (mixedGenerators K r conditions) (mixedIdeal K r conditions))
    (e : Entry n →₀ ℕ) :
    e ∈ (foldedOrder n).standardMonomials (mixedIdeal K r conditions) ↔
      ¬HasMixedObstruction r conditions e := by
  rw [hGB.mem_standardMonomials_iff, ← mixed_degree_divisor_iff K r conditions e]
  constructor
  · rintro h ⟨g, hg, hg0, hge⟩
    exact h g hg hg0 hge
  · intro h g hg hg0 hge
    exact h ⟨g, hg, hg0, hge⟩

theorem mixedGenerator_diagonalPivot_degree_zero {n : ℕ} (K : Type*) [Field K]
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    (conditions : List (ℕ × ℕ)) (hsize : ∀ ts ∈ conditions, 2 ≤ ts.1)
    {g : CoordinateRing (n + 1) K} (hg : g ∈ mixedGenerators K r conditions) :
    ((foldedOrder (n + 1)).degree g) (fold 0 0) = 0 := by
  rcases hg with hg | ⟨ts, hts, k, δ, hδ, hscore, rfl⟩
  · exact northwestGenerator_diagonalPivot_degree_zero K r hpos hg
  · rw [product_minors_degree, Finset.sum_apply']
    apply Finset.sum_eq_zero
    intro j _
    exact antidiagonalExponent_diagonalPivot_zero (δ j).rows (δ j).cols
      (lt_of_lt_of_le (by have := hsize ts hts; omega) (hδ j))

namespace Pivot

theorem projectedMixed_standard_iff {n : ℕ} (K : Type*) [Field K]
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    (conditions : List (ℕ × ℕ)) (hsize : ∀ ts ∈ conditions, 2 ≤ ts.1)
    (e : PivotVariables n →₀ ℕ) :
    e ∈ (pivotResidualOrder n).standardMonomials
      (pivotLeadingIdeal (pivotFullOrder n)
        (pivotCoordinateEquiv '' mixedGenerators K r conditions)) ↔
      ¬HasMixedObstruction r conditions (liftPivotExponent e) := by
  rw [standardMonomials_pivotLeadingIdeal,
    ← mixed_degree_divisor_iff K r conditions (liftPivotExponent e)]
  constructor
  · rintro h ⟨g, hg, hg0, hge⟩
    have hg' : pivotCoordinateEquiv g ≠ 0 := by
      intro hz
      exact hg0 (pivotCoordinateEquiv.injective (hz.trans (map_zero _).symm))
    apply h _ ⟨g, hg, rfl⟩ hg'
    rw [pivotCoordinateEquiv_degree]
    exact (projected_exponent_le_iff _
      (mixedGenerator_diagonalPivot_degree_zero K r hpos conditions hsize hg) e).mpr hge
  · rintro h _ ⟨g, hg, rfl⟩ hg' hge
    have hg0 : g ≠ 0 := by intro hz; apply hg'; rw [hz, map_zero]
    apply h
    refine ⟨g, hg, hg0, ?_⟩
    rw [pivotCoordinateEquiv_degree] at hge
    exact (projected_exponent_le_iff _
      (mixedGenerator_diagonalPivot_degree_zero K r hpos conditions hsize hg) e).mp hge

def projectedMixedStandardEquiv {n : ℕ} (K : Type*) [Field K]
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    (conditions : List (ℕ × ℕ)) (hsize : ∀ ts ∈ conditions, 2 ≤ ts.1)
    (d : Fin n →₀ ℕ) :
    {e : PivotVariables n →₀ ℕ |
      e ∈ (pivotResidualOrder n).standardMonomials
        (pivotLeadingIdeal (pivotFullOrder n)
          (pivotCoordinateEquiv '' mixedGenerators K r conditions)) ∧
      weight pivotEndpointWeight e = d} ≃ mixedPivotPiece r conditions d :=
  Equiv.subtypeEquivRight (fun e =>
    and_congr (projectedMixed_standard_iff K r hpos conditions hsize e) Iff.rfl)

def mixedCarrierStandardEquiv {n : ℕ} (K : Type*) [Field K]
    (r : RankArray n) (conditions : List (ℕ × ℕ))
    (hGB : (foldedOrder n).IsGroebnerBasis
      (mixedGenerators K r conditions) (mixedIdeal K r conditions)) (d : Fin n →₀ ℕ) :
    mixedCarrierPiece r conditions d ≃ symmetricCarrierStandards (mixedIdeal K r conditions) d :=
  Equiv.subtypeEquivRight (fun p =>
    and_congr (mixed_standardMonomials_iff_obstruction K r conditions hGB p.2).symm Iff.rfl)

end Pivot

theorem symbolicPower_le_mixedIdeal {n : ℕ} (R : Type*) [CommRing R]
    (r : RankArray n) (conditions : List (ℕ × ℕ)) (ts : ℕ × ℕ)
    (hts : ts ∈ conditions) :
    symbolicPower (determinantalIdeal n R ts.1) ts.2 ≤ mixedIdeal R r conditions := by
  induction conditions with
  | nil => simp at hts
  | cons a conditions ih =>
    rw [mixedIdeal_cons]
    rcases List.mem_cons.mp hts with rfl | hts
    · exact le_sup_right
    · exact (ih hts).trans le_sup_left

theorem mixedGenerators_subset_of_primality
    (hprime : ∀ (n : ℕ) (K : Type u) [Field K] (t : ℕ),
      0 < t → (determinantalIdeal n K t).IsPrime)
    {n : ℕ} (K : Type u) [Field K] (r : RankArray n)
    (conditions : List (ℕ × ℕ)) (ht : ∀ ts ∈ conditions, 0 < ts.1) :
    mixedGenerators K r conditions ⊆ mixedIdeal K r conditions := by
  rintro g (hg | ⟨ts, hts, hg⟩)
  · exact (show northwestIdeal K r ≤ mixedIdeal K r conditions from le_sup_left)
      (Ideal.subset_span hg)
  · exact symbolicPower_le_mixedIdeal K r conditions ts hts
      (Pivot.symbolicGenerators_subset_symbolicPower_of_primality hprime n K ts.1 ts.2
        (ht ts hts) hg)

/-- The positive mixed induction step, using the actual symbolic Schur chart.
Only ordinary determinantal primeness, smaller-dimensional Gröbner bases, and
the explicitly specified carrier bijection are supplied as inputs. -/
theorem mixedGroebner_positive_step
    (hprime : ∀ (n : ℕ) (K : Type u) [Field K] (t : ℕ),
      0 < t → (determinantalIdeal n K t).IsPrime)
    (hcarrier : Pivot.MixedCarrierCorrespondence) {n : ℕ}
    (K : Type u) [Field K] (r : RankArray (n + 1))
    (hr : ∀ i j, r i j = r j i) (hpos : ∀ i j, 0 < r i j)
    (conditions : List (ℕ × ℕ)) (hvalid : ValidSymbolicConditions n conditions)
    (hsmall : (foldedOrder n).IsGroebnerBasis
      (mixedGenerators (RatFunc K) (Pivot.residualRankArray r) conditions)
      (mixedIdeal (RatFunc K) (Pivot.residualRankArray r) conditions)) :
    (foldedOrder (n + 1)).IsGroebnerBasis
      (mixedGenerators K r (conditions.map (fun ts => (ts.1 + 1, ts.2))))
      (mixedIdeal K r (conditions.map (fun ts => (ts.1 + 1, ts.2)))) := by
  let raised := conditions.map (fun ts => (ts.1 + 1, ts.2))
  have hsize : ∀ ts ∈ raised, 2 ≤ ts.1 := by
    rintro ts hts
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hts
    have := (hvalid a ha).1
    dsimp only
    omega
  have hbig : ∀ ts ∈ raised, (determinantalIdeal (n + 1) K ts.1).IsPrime :=
    fun ts hts => hprime (n + 1) K ts.1 (lt_of_lt_of_le (by omega) (hsize ts hts))
  have hsmallprime : ∀ ts ∈ conditions, (determinantalIdeal n (RatFunc K) ts.1).IsPrime :=
    fun ts hts => hprime n (RatFunc K) ts.1 (lt_of_lt_of_le Nat.zero_lt_one (hvalid ts hts).1)
  apply Pivot.groebner_of_exact_carrier_equivalences
    (I := mixedIdeal (RatFunc K) (Pivot.residualRankArray r) conditions)
    (mixedIdeal K r raised) (mixedGenerators K r raised)
    (mixedGenerators_subset_of_primality hprime K r raised
      (fun ts hts => lt_of_lt_of_le (by omega) (hsize ts hts)))
  · intro g hg _
    exact mixedGenerators_homogeneous K r raised g hg
  · intro g hg _
    exact mixedGenerator_diagonalPivot_degree_zero K r hpos raised hsize hg
  · exact Pivot.mixedIdeal_pivot_endpoint_homogeneous r raised hbig
  · apply Pivot.mixedIdeal_map_genericFirstPivotChart K r hpos conditions
    · intro ts hts
      exact hprime (n + 1) K (ts.1 + 1) (Nat.zero_lt_succ _)
    · exact hsmallprime
  · exact Pivot.mixedIdeal_endpoint_homogeneous (Pivot.residualRankArray r) conditions hsmallprime
  · intro d
    exact (Pivot.projectedMixedStandardEquiv K r hpos raised hsize d).trans
      ((Classical.choice (hcarrier n r hr hpos conditions hvalid d)).trans
        (Pivot.mixedCarrierStandardEquiv (RatFunc K) (Pivot.residualRankArray r)
          conditions hsmall d))

/-- The already verified Ferrers and degree-cutoff reductions, specialized to
one dimension so that they can be used inside the dimension induction. -/
theorem mixedGroebner_dimension_of_positiveCore (n : ℕ)
    (hcore : ∀ (K : Type u) [Field K] (r : RankArray n),
      (∀ i j, r i j = r j i) → (∀ i j, 0 < r i j) →
      ∀ conditions : List (ℕ × ℕ), ValidSymbolicConditions n conditions →
        (∀ ts ∈ conditions, 2 ≤ ts.1) →
        (foldedOrder n).IsGroebnerBasis (mixedGenerators K r conditions) (mixedIdeal K r conditions))
    (K : Type u) [Field K] (r : RankArray n) (hr : ∀ i j, r i j = r j i)
    (conditions : List (ℕ × ℕ)) (hvalid : ValidSymbolicConditions n conditions) :
    (foldedOrder n).IsGroebnerBasis (mixedGenerators K r conditions) (mixedIdeal K r conditions) := by
  apply mixedGroebner_of_positiveBounds K r hr conditions
  let ones := conditions.filter fun ts => decide (ts.1 = 1)
  let rest := conditions.filter fun ts => !decide (ts.1 = 1)
  have hrestvalid : ValidSymbolicConditions n rest := by
    intro ts hts
    exact hvalid ts (List.mem_of_mem_filter hts)
  have hrestsize : ∀ ts ∈ rest, 2 ≤ ts.1 := by
    intro ts hts
    have h := List.mem_filter.mp hts
    have h1 := (hvalid ts h.1).1
    have hne : ts.1 ≠ 1 := by simpa using h.2
    omega
  have hposSym : ∀ i j, positiveBounds r i j = positiveBounds r j i := by
    intro i j
    simp only [positiveBounds, hr i j]
  have hpos : ∀ i j, 0 < positiveBounds r i j :=
    fun i j => lt_of_lt_of_le Nat.zero_lt_one (le_max_right _ _)
  have hrest := hcore K (positiveBounds r) hposSym hpos rest hrestvalid hrestsize
  have hones : ∀ ts ∈ ones, ts.1 = 1 := by
    intro ts hts
    exact of_decide_eq_true (List.mem_filter.mp hts).2
  have h := Reduction.mixedGroebner_prepend_ones K (positiveBounds r) ones rest hones hrest
  have hp : (ones ++ rest).Perm conditions := Reduction.filter_split_perm _ conditions
  rw [Reduction.mixedGenerators_perm K (positiveBounds r) hp,
    Reduction.mixedIdeal_perm K (positiveBounds r) hp] at h
  exact h

/-- The full field statement of Theorem 1.2 from the two exact combinatorial
carrier correspondences. All ideal-theoretic inputs, including ordinary
determinantal primeness and symbolic product containment, are derived here. -/
theorem compatibleGroebner_of_carrierCorrespondences
    (hNW : Pivot.NorthwestCarrierCorrespondence)
    (hMixed : Pivot.MixedCarrierCorrespondence) : CompatibleGroebnerAssertion.{u} := by
  have hNWGB := northwestGroebner_of_carrierCorrespondence.{u} hNW
  have hP := determinantalIdeals_prime_of_northwestGroebner hNWGB
  have hprime : ∀ (n : ℕ) (K : Type u) [Field K] (t : ℕ),
      0 < t → (determinantalIdeal n K t).IsPrime := by
    intro n K _ t ht
    exact hP n K t ht
  intro n
  induction n with
  | zero =>
    intro K _ r hr conditions hvalid
    have hc : conditions = [] := by
      apply List.eq_nil_iff_forall_not_mem.mpr
      intro ts hts
      have h := hvalid ts hts
      omega
    subst conditions
    simpa [mixedGenerators, mixedIdeal] using hNWGB 0 K r hr
  | succ n ih =>
    apply mixedGroebner_dimension_of_positiveCore (n + 1)
    intro K _ r hr hpos conditions hvalid hsize
    let lower := conditions.map (fun ts => (ts.1 - 1, ts.2))
    have hlower : ValidSymbolicConditions n lower := by
      rintro ts hts
      obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hts
      have hv := hvalid a ha
      have hs := hsize a ha
      dsimp only
      omega
    have hrecover : lower.map (fun ts => (ts.1 + 1, ts.2)) = conditions := by
      dsimp only [lower]
      rw [List.map_map]
      conv_rhs => rw [← List.map_id conditions]
      apply List.map_congr_left
      intro ts hts
      have hs := hsize ts hts
      apply Prod.ext
      · change ts.1 - 1 + 1 = ts.1
        omega
      · rfl
    have hr' : ∀ i j, Pivot.residualRankArray r i j = Pivot.residualRankArray r j i := by
      intro i j
      simp only [Pivot.residualRankArray, hr i.succ j.succ]
    have hsmall := ih (RatFunc K) (Pivot.residualRankArray r) hr' lower hlower
    have h := mixedGroebner_positive_step hprime hMixed K r hr hpos lower hlower hsmall
    simpa only [hrecover] using h

/-- The complete integral/base-change assertion is obtained from the same
field theorem by the checked monic integral-division argument. -/
theorem integralBaseChange_of_carrierCorrespondences
    (hNW : Pivot.NorthwestCarrierCorrespondence)
    (hMixed : Pivot.MixedCarrierCorrespondence) : IntegralBaseChangeAssertion.{v} :=
  integralBaseChangeAssertion_of_compatible
    (compatibleGroebner_of_carrierCorrespondences.{0} hNW hMixed)

/-- One simultaneous carrier theorem establishes the complete field assertion. -/
theorem compatibleGroebner_of_mixedCarrier
    (hMixed : Pivot.MixedCarrierCorrespondence) : CompatibleGroebnerAssertion.{u} :=
  compatibleGroebner_of_carrierCorrespondences
    (Pivot.northwestCarrierCorrespondence_of_mixed hMixed) hMixed

/-- The same single combinatorial theorem also establishes the integral and
arbitrary-coefficient-ring conclusions, by monic base change. -/
theorem integralBaseChange_of_mixedCarrier
    (hMixed : Pivot.MixedCarrierCorrespondence) : IntegralBaseChangeAssertion.{v} :=
  integralBaseChange_of_carrierCorrespondences
    (Pivot.northwestCarrierCorrespondence_of_mixed hMixed) hMixed

end FourPapers.Symmetric
