namespace FourPapers.Symmetric

/-- Split off an arbitrary selected index, retaining the order of all others. -/
def selectedIndexEquiv {n : ℕ} (k : Fin (n + 1)) : PUnit.{1} ⊕ Fin n ≃ Fin (n + 1) :=
  ((Equiv.sumComm PUnit.{1} (Fin n)).trans
    (Equiv.optionEquivSumPUnit (Fin n)).symm).trans (finSuccEquiv' k).symm

@[simp] theorem selectedIndexEquiv_left {n : ℕ} (k : Fin (n + 1)) (p : PUnit.{1}) :
    selectedIndexEquiv k (.inl p) = k := by
  cases p
  simp [selectedIndexEquiv]

@[simp] theorem selectedIndexEquiv_right {n : ℕ} (k : Fin (n + 1)) (i : Fin n) :
    selectedIndexEquiv k (.inr i) = k.succAbove i := by
  simp [selectedIndexEquiv]

/-- The two pivot indices come first; all remaining indices retain their
original increasing order. -/
def twoIndicesEquiv {n : ℕ} (k : Fin (n + 1)) :
    (PUnit.{1} ⊕ PUnit.{1}) ⊕ Fin n ≃ Fin (n + 2) :=
  (Equiv.sumAssoc PUnit.{1} PUnit.{1} (Fin n)).trans
    ((Equiv.sumCongr (Equiv.refl PUnit.{1}) (selectedIndexEquiv k)).trans
      (firstIndexEquiv (n + 1)))

@[simp] theorem twoIndicesEquiv_first {n : ℕ} (k : Fin (n + 1)) (p : PUnit.{1}) :
    twoIndicesEquiv k (.inl (.inl p)) = 0 := by
  simp [twoIndicesEquiv]

@[simp] theorem twoIndicesEquiv_second {n : ℕ} (k : Fin (n + 1)) (p : PUnit.{1}) :
    twoIndicesEquiv k (.inl (.inr p)) = k.succ := by
  simp [twoIndicesEquiv]

@[simp] theorem twoIndicesEquiv_residual {n : ℕ} (k : Fin (n + 1)) (i : Fin n) :
    twoIndicesEquiv k (.inr i) = (k.succAbove i).succ := by
  simp [twoIndicesEquiv]

/-- The increasing enumeration after deleting indices zero and `k.succ`. -/
def offDiagonalResidualEmbedding {n : ℕ} (k : Fin (n + 1)) :
    Fin n ↪o Fin (n + 2) :=
  (Fin.succAboveOrderEmb k).comp (Fin.succOrderEmb (n + 1))

@[simp] theorem offDiagonalResidualEmbedding_apply {n : ℕ} (k : Fin (n + 1))
    (i : Fin n) : offDiagonalResidualEmbedding k i = (k.succAbove i).succ := rfl

/-- Exactly the two pivot indices are deleted. -/
theorem offDiagonalResidualEmbedding_mem_range {n : ℕ} (k : Fin (n + 1))
    (i : Fin (n + 2)) :
    i ∈ Set.range (offDiagonalResidualEmbedding k) ↔ i ≠ 0 ∧ i ≠ k.succ := by
  constructor
  · rintro ⟨j, rfl⟩
    refine ⟨Fin.succ_ne_zero _, ?_⟩
    intro h
    exact Fin.succAbove_ne k j (Fin.succ_injective _ h)
  · rintro ⟨hi0, hik⟩
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i, rfl⟩
    · exact (hi0 rfl).elim
    · have hi : i ≠ k := fun h => hik (congrArg Fin.succ h)
      obtain ⟨j, hj⟩ := Fin.exists_succAbove_eq hi
      refine ⟨j, ?_⟩
      change (k.succAbove j).succ = i.succ
      rw [hj]

/-- An increasing embedding of vertex indices embeds the independent
symmetric entries without folding collisions. -/
def entryEmbedding {m n : ℕ} (a : Fin m ↪o Fin n) : Entry m ↪ Entry n where
  toFun e := ⟨toLex (a e.val.1, a e.val.2), a.monotone e.property⟩
  inj' := by
    intro e f h
    apply Subtype.ext
    apply Prod.ext
    · exact a.injective (congrArg (fun e : Entry n => e.val.1) h)
    · exact a.injective (congrArg (fun e : Entry n => e.val.2) h)

@[simp] theorem entryEmbedding_fold {m n : ℕ} (a : Fin m ↪o Fin n) (i j : Fin m) :
    entryEmbedding a (fold i j) = fold (a i) (a j) := by
  apply Subtype.ext
  change toLex (a (max i j), a (min i j)) =
    toLex (max (a i) (a j), min (a i) (a j))
  by_cases h : i ≤ j
  · rw [max_eq_right h, min_eq_left h,
      max_eq_right (a.monotone h), min_eq_left (a.monotone h)]
  · have h' : j ≤ i := le_of_not_ge h
    rw [max_eq_left h', min_eq_right h',
      max_eq_left (a.monotone h'), min_eq_right (a.monotone h')]

/-- A symmetric entry survives precisely when both its endpoints survive. -/
theorem entryEmbedding_mem_range {m n : ℕ} (a : Fin m ↪o Fin n) (e : Entry n) :
    e ∈ Set.range (entryEmbedding a) ↔
      e.val.1 ∈ Set.range a ∧ e.val.2 ∈ Set.range a := by
  constructor
  · rintro ⟨f, rfl⟩
    exact ⟨⟨f.val.1, rfl⟩, ⟨f.val.2, rfl⟩⟩
  · rintro ⟨⟨i, hi⟩, ⟨j, hj⟩⟩
    have hji : j ≤ i := a.le_iff_le.mp (by rw [hi, hj]; exact e.property)
    refine ⟨⟨toLex (i, j), hji⟩, ?_⟩
    exact Subtype.ext (Prod.ext hi hj)

/-- The residual independent coordinates are exactly those touching neither
pivot index. -/
theorem offDiagonalResidualEntry_mem_range {n : ℕ} (k : Fin (n + 1))
    (e : Entry (n + 2)) :
    e ∈ Set.range (entryEmbedding (offDiagonalResidualEmbedding k)) ↔
      (e.val.1 ≠ 0 ∧ e.val.1 ≠ k.succ) ∧
        (e.val.2 ≠ 0 ∧ e.val.2 ≠ k.succ) := by
  rw [entryEmbedding_mem_range, offDiagonalResidualEmbedding_mem_range,
    offDiagonalResidualEmbedding_mem_range]

end FourPapers.Symmetric
end
