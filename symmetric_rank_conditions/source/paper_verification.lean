/-!
# The northwest Gröbner induction

This module isolates the precise, purely combinatorial carrier correspondence
and proves the entire algebraic induction from it. The correspondence concerns
actual antidiagonal divisibility and the complete endpoint multigrading; it
contains no ideal equality, dimension formula, or Gröbner hypothesis.

`northwestGroebner_of_carrierCorrespondence` includes the empty matrix and the
Ferrers reduction of zero bounds. Its conclusion is the literal prescribed
minor family for every symmetric array of nonnegative bounds.
-/

namespace FourPapers.Symmetric
open MvPolynomial Finsupp
open scoped MonomialOrder
universe u

namespace Pivot

/-- Reinsert a zero exponent at the actual upper-left symmetric coordinate. -/
def liftPivotExponent {n : ℕ} (e : PivotVariables n →₀ ℕ) : Entry (n + 1) →₀ ℕ :=
  e.mapDomain (fun v => pivotEntry (some v))

theorem pivotNonzeroEntry_injective {n : ℕ} :
    Function.Injective (fun v : PivotVariables n => pivotEntry (some v)) :=
  fun _ _ h => Option.some.inj (pivotEntry_injective h)

@[simp] theorem liftPivotExponent_apply_some {n : ℕ}
    (e : PivotVariables n →₀ ℕ) (v : PivotVariables n) :
    liftPivotExponent e (pivotEntry (some v)) = e v :=
  Finsupp.mapDomain_apply_of_injective pivotNonzeroEntry_injective e v

@[simp] theorem liftPivotExponent_apply_none {n : ℕ} (e : PivotVariables n →₀ ℕ) :
    liftPivotExponent e (pivotEntry none) = 0 := by
  apply Finsupp.mapDomain_of_notMem_range
  rintro ⟨v, hv⟩
  have h : (Option.some v : Option (PivotVariables n)) = none := pivotEntry_injective hv
  cases h

/-- Forgetting and reinserting the zero pivot exponent preserves exactly
the divisibility relation, rather than only a total-degree statistic. -/
theorem projected_exponent_le_iff {n : ℕ}
    (a : Entry (n + 1) →₀ ℕ) (ha : a (fold 0 0) = 0)
    (e : PivotVariables n →₀ ℕ) :
    (a.mapDomain pivotEntryEquiv.symm).some ≤ e ↔ a ≤ liftPivotExponent e := by
  have hcoord (v : PivotVariables n) :
      (a.mapDomain pivotEntryEquiv.symm).some v = a (pivotEntry (some v)) := by
    rw [Finsupp.some_apply, Finsupp.mapDomain_equiv_apply]
    rfl
  constructor
  · intro h z
    obtain ⟨o, rfl⟩ := pivotEntry_surjective z
    cases o with
    | none =>
      rw [pivotEntry_none, ha]
      exact Nat.zero_le _
    | some v =>
      rw [liftPivotExponent_apply_some]
      simpa only [hcoord] using h v
  · intro h v
    rw [hcoord]
    simpa only [liftPivotExponent_apply_some] using h (pivotEntry (some v))

/-- The source of first-row deletion, without any polynomial coefficient field. -/
def northwestPivotPiece {n : ℕ} (r : RankArray (n + 1)) (d : Fin n →₀ ℕ) :
    Set (PivotVariables n →₀ ℕ) :=
  {e | ¬HasForbiddenAntidiagonal r (liftPivotExponent e) ∧
    weight pivotEndpointWeight e = d}

/-- The target of first-row deletion: an unrestricted carrier and a residual
antidiagonal-standard exponent, with the same full endpoint multiplicities. -/
def northwestCarrierPiece {n : ℕ} (r : RankArray n) (d : Fin n →₀ ℕ) :
    Set ((Fin n →₀ ℕ) × (Entry n →₀ ℕ)) :=
  {p | ¬HasForbiddenAntidiagonal r p.2 ∧ p.1 + weight endpointWeight p.2 = d}

/-- The exact combinatorial input to the northwest induction. This is a
proposition defining an interface, not an axiom or an asserted theorem. -/
def NorthwestCarrierCorrespondence : Prop :=
  ∀ (n : ℕ) (r : RankArray (n + 1)),
    (∀ i j, r i j = r j i) → (∀ i j, 0 < r i j) →
    ∀ d : Fin n →₀ ℕ,
      Nonempty (northwestPivotPiece r d ≃ northwestCarrierPiece (residualRankArray r) d)

/-- The actual projected leading ideal is exactly the forbidden-antidiagonal
condition occurring in the carrier interface. -/
theorem projectedNorthwest_standard_iff {n : ℕ} (K : Type*) [Field K]
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j)
    (e : PivotVariables n →₀ ℕ) :
    e ∈ (pivotResidualOrder n).standardMonomials
      (pivotLeadingIdeal (pivotFullOrder n) (pivotCoordinateEquiv '' northwestGenerators K r)) ↔
        ¬HasForbiddenAntidiagonal r (liftPivotExponent e) := by
  rw [standardMonomials_pivotLeadingIdeal, hasForbiddenAntidiagonal_iff_generator_le]
  constructor
  · intro he hbad
    obtain ⟨a, ⟨i, j, rows, cols, hrows, hcols, rfl⟩, hle⟩ := hbad
    have hm : minor K rows cols ≠ 0 :=
      (foldedOrder (n + 1)).leadingCoeff_ne_zero_iff.mp
        (minor_leadingCoeff_isUnit K rows cols).ne_zero
    have hm' : pivotCoordinateEquiv (minor K rows cols) ≠ 0 := by
      intro hz
      exact hm (pivotCoordinateEquiv.injective (hz.trans (map_zero _).symm))
    apply he _ ⟨_, ⟨i, j, rows, cols, hrows, hcols, rfl⟩, rfl⟩ hm'
    rw [pivotCoordinateEquiv_degree, minor_degree]
    exact (projected_exponent_le_iff _
      (antidiagonalExponent_diagonalPivot_zero rows cols (by have := hpos i j; omega)) e).mpr hle
  · rintro hbad _ ⟨g, ⟨i, j, rows, cols, hrows, hcols, rfl⟩, rfl⟩ _ hle
    rw [pivotCoordinateEquiv_degree, minor_degree] at hle
    apply hbad
    refine ⟨antidiagonalExponent rows cols,
      ⟨i, j, rows, cols, hrows, hcols, rfl⟩, ?_⟩
    exact (projected_exponent_le_iff _
      (antidiagonalExponent_diagonalPivot_zero rows cols (by have := hpos i j; omega)) e).mp hle

def projectedNorthwestStandardEquiv {n : ℕ} (K : Type*) [Field K]
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j) (d : Fin n →₀ ℕ) :
    {e : PivotVariables n →₀ ℕ |
      e ∈ (pivotResidualOrder n).standardMonomials
        (pivotLeadingIdeal (pivotFullOrder n) (pivotCoordinateEquiv '' northwestGenerators K r)) ∧
      weight pivotEndpointWeight e = d} ≃ northwestPivotPiece r d :=
  Equiv.subtypeEquivRight (fun e =>
    and_congr (projectedNorthwest_standard_iff K r hpos e) Iff.rfl)

end Pivot

/-- The smaller induction hypothesis identifies actual standard monomials
with literal antidiagonal avoidance. -/
theorem northwest_standardMonomials_iff {n : ℕ} (K : Type*) [Field K]
    (r : RankArray n)
    (hGB : (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r))
    (e : Entry n →₀ ℕ) :
    e ∈ (foldedOrder n).standardMonomials (northwestIdeal K r) ↔
      ¬HasForbiddenAntidiagonal r e := by
  rw [hGB.mem_standardMonomials_iff, hasForbiddenAntidiagonal_iff_generator_le]
  constructor
  · intro he hbad
    obtain ⟨a, ⟨i, j, rows, cols, hrows, hcols, rfl⟩, hle⟩ := hbad
    apply he _ ⟨i, j, rows, cols, hrows, hcols, rfl⟩
      ((foldedOrder n).leadingCoeff_ne_zero_iff.mp
        (minor_leadingCoeff_isUnit K rows cols).ne_zero)
    simpa only [minor_degree] using hle
  · rintro hbad g ⟨i, j, rows, cols, hrows, hcols, rfl⟩ _ hle
    apply hbad
    exact ⟨antidiagonalExponent rows cols,
      ⟨i, j, rows, cols, hrows, hcols, rfl⟩, by simpa only [minor_degree] using hle⟩

def northwestCarrierStandardEquiv {n : ℕ} (K : Type*) [Field K]
    (r : RankArray n)
    (hGB : (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r))
    (d : Fin n →₀ ℕ) :
    Pivot.northwestCarrierPiece r d ≃ Pivot.symmetricCarrierStandards (northwestIdeal K r) d :=
  Equiv.subtypeEquivRight (fun p =>
    and_congr (northwest_standardMonomials_iff K r hGB p.2).symm Iff.rfl)

/-- The positive-bound induction step uses the actual Schur chart and the
actual homogeneous quotient, with only the explicit carrier bijection as
combinatorial input. -/
theorem northwestGroebner_positive_step
    (hcarrier : Pivot.NorthwestCarrierCorrespondence) {n : ℕ}
    (K : Type u) [Field K] (r : RankArray (n + 1))
    (hr : ∀ i j, r i j = r j i) (hpos : ∀ i j, 0 < r i j)
    (hsmall : (foldedOrder n).IsGroebnerBasis
      (northwestGenerators (RatFunc K) (Pivot.residualRankArray r))
      (northwestIdeal (RatFunc K) (Pivot.residualRankArray r))) :
    (foldedOrder (n + 1)).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r) := by
  apply Pivot.groebner_of_exact_carrier_equivalences
    (I := northwestIdeal (RatFunc K) (Pivot.residualRankArray r))
    (northwestIdeal K r) (northwestGenerators K r) Ideal.subset_span
  · rintro g ⟨i, j, a, b, ha, hb, rfl⟩ _
    exact ⟨r i j + 1, minor_isHomogeneous_total K a b⟩
  · intro g hg _
    exact northwestGenerator_diagonalPivot_degree_zero K r hpos hg
  · exact Pivot.northwestIdeal_pivot_endpoint_homogeneous r
  · exact Pivot.northwestIdeal_map_genericFirstPivotChart K r hpos
  · exact northwestIdeal_endpoint_homogeneous (RatFunc K) (Pivot.residualRankArray r)
  · intro d
    exact (Pivot.projectedNorthwestStandardEquiv K r hpos d).trans
      ((Classical.choice (hcarrier n r hr hpos d)).trans
        (northwestCarrierStandardEquiv (RatFunc K) (Pivot.residualRankArray r) hsmall d))

/-- The complete northwest Gröbner induction, including zero bounds and the
empty matrix. The sole combinatorial input is a literal, degree-preserving
antidiagonal carrier correspondence; no algebraic conclusion is assumed. -/
theorem northwestGroebner_of_carrierCorrespondence
    (hcarrier : Pivot.NorthwestCarrierCorrespondence) :
    ∀ (n : ℕ) (K : Type u) [Field K] (r : RankArray n),
      (∀ i j, r i j = r j i) →
      (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r) := by
  intro n
  induction n with
  | zero =>
    intro K _ r hr
    have hG : northwestGenerators K r = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      rintro g ⟨i, j, a, b, ha, hb, hg⟩
      exact Fin.elim0 i
    have hI : northwestIdeal K r = ⊥ := by rw [northwestIdeal, hG, Ideal.span_empty]
    rw [hG, hI]
    apply (MonomialOrder.isGroebnerBasis_iff_forall_exists_degree_le_degree
      (fun g hg _ => (Set.notMem_empty g hg).elim)).mpr
    refine ⟨Set.empty_subset _, ?_⟩
    intro f hf hf0
    exact (hf0 (Ideal.mem_bot.mp hf)).elim
  | succ n ih =>
    intro K _ r hr
    have hp : (foldedOrder (n + 1)).IsGroebnerBasis
        (northwestGenerators K (positiveBounds r)) (northwestIdeal K (positiveBounds r)) := by
      apply northwestGroebner_positive_step hcarrier K (positiveBounds r)
      · intro i j
        simp only [positiveBounds, hr i j]
      · intro i j
        exact lt_of_lt_of_le Nat.zero_lt_one (le_max_right _ _)
      · apply ih (RatFunc K) (Pivot.residualRankArray (positiveBounds r))
        intro i j
        simp only [Pivot.residualRankArray, positiveBounds, hr i.succ j.succ]
    have h := mixedGroebner_of_positiveBounds K r hr []
      (by simpa [mixedGenerators, mixedIdeal] using hp)
    simpa [mixedGenerators, mixedIdeal] using h

/-- Proposition 4.1 in its exact initial-ideal formulation. -/
theorem northwest_initial_of_carrierCorrespondence
    (hcarrier : Pivot.NorthwestCarrierCorrespondence)
    (n : ℕ) (K : Type u) [Field K] (r : RankArray n)
    (hr : ∀ i j, r i j = r j i) :
    initialIdeal K (northwestIdeal K r) = northwestAntidiagonalIdeal K r :=
  northwest_initial_eq_of_groebner K r
    (northwestGroebner_of_carrierCorrespondence hcarrier n K r hr)

end FourPapers.Symmetric
end
