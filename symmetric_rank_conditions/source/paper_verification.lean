noncomputable section

/-!
# Leading monomials on the generic pivot chart

For a homogeneous polynomial whose leading term omits the pivot, the graded
reverse lexicographic leading exponent is preserved when that pivot is moved
into the coefficient field.  This is the order hypothesis in Lemma 3.3 for
all prescribed minors and their products.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp
open scoped MonomialOrder

attribute [local instance] MvPolynomial.weightedGradedAlgebra

section Coefficients

variable {σ R S : Type*} [CommRing R] [CommRing S]

/-- Regrouping the pivot into the coefficient ring preserves every actual
coefficient: the two exponent coordinates are merely read in the other order. -/
theorem optionEquivRight_coeff_some_coeff_none
    (a : Option σ →₀ ℕ) (p : MvPolynomial (Option σ) R) :
    ((optionEquivRight R σ p).coeff a.some).coeff (a none) = p.coeff a := by
  induction p using MvPolynomial.induction_on' generalizing a with
  | monomial b c =>
    rw [optionEquivRight_monomial]
    classical
    simp only [MvPolynomial.coeff_monomial, Polynomial.coeff_monomial,
      apply_ite, ite_apply, Polynomial.coeff_zero]
    by_cases hba : b = a
    · simp [hba]
    · by_cases hsome : b.some = a.some
      · have hnone : b none ≠ a none := by
          intro h
          apply hba
          ext i
          cases i with
          | none => exact h
          | some i => exact congrArg (fun e : σ →₀ ℕ => e i) hsome
        simp [hsome, hnone, hba, Polynomial.coeff_monomial]
      · simp [hsome, hba]
  | add p q hp hq =>
    simp only [map_add, MvPolynomial.coeff_add, Polynomial.coeff_add, hp, hq]

/-- An injective coefficient extension cannot cancel a residual monomial:
its coefficient is a genuine nonzero polynomial in the pivot variable. -/
theorem support_pivotMap_eq (φ : Polynomial R →+* S) (hφ : Function.Injective φ)
    (p : MvPolynomial (Option σ) R) :
    (↑(pivotMap φ p).support : Set (σ →₀ ℕ)) =
      Finsupp.some '' (↑p.support : Set (Option σ →₀ ℕ)) := by
  classical
  apply Set.Subset.antisymm (support_pivotMap φ p)
  rintro _ ⟨a, ha, rfl⟩
  rw [Finset.mem_coe, MvPolynomial.mem_support_iff]
  change (MvPolynomial.map φ (optionEquivRight R σ p)).coeff a.some ≠ 0
  rw [MvPolynomial.coeff_map]
  intro hz
  have hcoeff : (optionEquivRight R σ p).coeff a.some = 0 :=
    hφ (hz.trans (map_zero φ).symm)
  have h := congrArg (fun q : Polynomial R => q.coeff (a none)) hcoeff
  rw [optionEquivRight_coeff_some_coeff_none, Polynomial.coeff_zero] at h
  exact (MvPolynomial.mem_support_iff.mp ha) h

/-- Generic order form of the leading-term comparison.  It is enough to
compare projected support exponents; the leading coefficient survives by the
preceding exact support theorem. -/
theorem degree_pivotMap_of_support_comparison
    (φ : Polynomial R →+* S) (hφ : Function.Injective φ)
    (m : MonomialOrder (Option σ)) (m' : MonomialOrder σ)
    (p : MvPolynomial (Option σ) R) (hp : p ≠ 0)
    (hcmp : ∀ a ∈ p.support, a.some ≼[m'] (m.degree p).some) :
    m'.degree (pivotMap φ p) = (m.degree p).some := by
  classical
  apply m'.toSyn.injective
  apply le_antisymm
  · apply m'.degree_le_iff.mpr
    intro e he
    obtain ⟨a, ha, rfl⟩ := support_pivotMap φ p he
    exact hcmp a ha
  · apply m'.le_degree
    rw [← Finset.mem_coe, support_pivotMap_eq φ hφ]
    exact ⟨m.degree p, m.degree_mem_support hp, rfl⟩

end Coefficients

section Grevlex

variable {σ : Type*} [LinearOrder σ] [optionOrder : LinearOrder (Option σ)]

-- Use the chosen order's relations, rather than the separate canonical
-- Option instances, including in the well-foundedness premise.
local instance optionChosenLE : LE (Option σ) := optionOrder.toLE
local instance optionChosenLT : LT (Option σ) := optionOrder.toLT
local instance optionChosenPreorder : Preorder (Option σ) := optionOrder.toPreorder

variable [WellFoundedGT σ] [WellFoundedGT (Option σ)]

/-- Total degree splits into the pivot exponent and the remaining degree. -/
theorem degree_option (a : Option σ →₀ ℕ) :
    a.degree = a none + a.some.degree := by
  change (a.sum fun _ k => k) = a none + a.some.sum (fun _ k => k)
  exact a.sum_option_index (fun _ k => k) (fun _ => rfl) (fun _ _ _ => rfl)

/-- Among terms of the same total degree, projection strictly preserves a
grevlex comparison whose larger term omits the pivot.  A positive pivot
exponent gives a strictly smaller residual degree; otherwise the largest
remaining differing coordinate gives the same comparison. -/
theorem grevlex_some_lt_of_degree_eq
    (hSome : StrictMono (Option.some : σ → Option σ))
    {a b : Option σ →₀ ℕ}
    (hdeg : a.degree = b.degree) (hb : b none = 0)
    (hlt : a ≺[TauCeti.MonomialOrder.degRevLex] b) :
    a.some ≺[TauCeti.MonomialOrder.degRevLex] b.some := by
  rw [TauCeti.MonomialOrder.degRevLex_lt_iff, TauCeti.DegRevLex.lt_iff_exists] at hlt ⊢
  simp only [TauCeti.ofDegRevLex_toDegRevLex] at hlt ⊢
  by_cases ha : a none = 0
  · have hdeg' : a.some.degree = b.some.degree := by
      have hda := degree_option a
      have hdb := degree_option b
      omega
    rcases hlt with hd | ⟨_, i, htail, hvalue⟩
    · exact (not_lt_of_ge hdeg.ge hd).elim
    · cases i with
      | none => simp [ha, hb] at hvalue
      | some i =>
        exact Or.inr ⟨hdeg', i, (fun j hij => htail (some j) (hSome hij)), hvalue⟩
  · left
    have hda := degree_option a
    have hdb := degree_option b
    omega

variable {R S : Type*} [CommRing R] [CommRing S]

/-- Leading monomials of homogeneous pivot-free polynomials survive the
actual passage from `R[x,σ]` to a coefficient extension of `R[x]`.
The orders on the remaining variables are inherited through `some`; the
location of the pivot itself in the variable order is immaterial. -/
theorem grevlex_degree_pivotMap
    (hSome : StrictMono (Option.some : σ → Option σ))
    (φ : Polynomial R →+* S) (hφ : Function.Injective φ)
    (p : MvPolynomial (Option σ) R) (hp : p ≠ 0)
    {d : ℕ} (hhom : p.IsHomogeneous d)
    (hfree : (TauCeti.MonomialOrder.degRevLex.degree p) none = 0) :
    TauCeti.MonomialOrder.degRevLex.degree (pivotMap φ p) =
      (TauCeti.MonomialOrder.degRevLex.degree p).some := by
  apply degree_pivotMap_of_support_comparison φ hφ
    TauCeti.MonomialOrder.degRevLex TauCeti.MonomialOrder.degRevLex p hp
  intro a ha
  have hdeg : a.degree = (TauCeti.MonomialOrder.degRevLex.degree p).degree := by
    rw [Finsupp.degree_eq_weight_one]
    exact (hhom (MvPolynomial.mem_support_iff.mp ha)).trans
      (hhom (MvPolynomial.mem_support_iff.mp
        (TauCeti.MonomialOrder.degRevLex.degree_mem_support hp))).symm
  rcases lt_or_eq_of_le (TauCeti.MonomialOrder.degRevLex.le_degree ha) with hlt | heq
  · exact (grevlex_some_lt_of_degree_eq hSome hdeg hfree hlt).le
  · have he : a = TauCeti.MonomialOrder.degRevLex.degree p :=
      TauCeti.MonomialOrder.degRevLex.toSyn.injective heq
    rw [he]

end Grevlex


section RelabelOrder

variable {α β : Type*} [LinearOrder α] [LinearOrder β]
  [WellFoundedGT α] [WellFoundedGT β]

theorem mapDomain_orderIso_apply (e : α ≃o β) (a : α →₀ ℕ) (j : β) :
    a.mapDomain e j = a (e.symm j) :=
  Finsupp.mapDomain_equiv_apply (f := e.toEquiv) a j

/-- Graded reverse lexicographic comparison is invariant under an order
isomorphism of the variables. -/
theorem grevlex_mapDomain_lt_iff (e : α ≃o β) (a b : α →₀ ℕ) :
    a.mapDomain e ≺[TauCeti.MonomialOrder.degRevLex] b.mapDomain e ↔
      a ≺[TauCeti.MonomialOrder.degRevLex] b := by
  rw [TauCeti.MonomialOrder.degRevLex_lt_iff,
    TauCeti.MonomialOrder.degRevLex_lt_iff,
    TauCeti.DegRevLex.lt_iff_exists, TauCeti.DegRevLex.lt_iff_exists]
  simp only [TauCeti.ofDegRevLex_toDegRevLex, Finsupp.degree_mapDomain]
  apply or_congr_right
  apply and_congr_right
  intro _
  constructor
  · rintro ⟨i, htail, hvalue⟩
    refine ⟨e.symm i, ?_, ?_⟩
    · intro j hij
      have hj : i < e j := by simpa using e.strictMono hij
      have h := htail (e j) hj
      simpa only [mapDomain_orderIso_apply, OrderIso.symm_apply_apply] using h
    · simpa only [mapDomain_orderIso_apply] using hvalue
  · rintro ⟨i, htail, hvalue⟩
    refine ⟨e i, ?_, ?_⟩
    · intro j hij
      have hj : i < e.symm j := by simpa using e.symm.strictMono hij
      simpa only [mapDomain_orderIso_apply] using htail _ hj
    · simpa only [Finsupp.mapDomain_apply_of_injective e.injective] using hvalue

theorem grevlex_mapDomain_le_iff (e : α ≃o β) (a b : α →₀ ℕ) :
    a.mapDomain e ≼[TauCeti.MonomialOrder.degRevLex] b.mapDomain e ↔
      a ≼[TauCeti.MonomialOrder.degRevLex] b := by
  simpa only [not_lt] using not_congr (grevlex_mapDomain_lt_iff e b a)

variable {R : Type*} [CommRing R]

theorem grevlex_degree_rename (e : α ≃o β) (p : MvPolynomial α R) :
    TauCeti.MonomialOrder.degRevLex.degree (rename e p) =
      (TauCeti.MonomialOrder.degRevLex.degree p).mapDomain e :=
  MonomialOrder.degree_rename (m := TauCeti.MonomialOrder.degRevLex)
    (m' := TauCeti.MonomialOrder.degRevLex) (fun a b => (grevlex_mapDomain_le_iff e a b).symm) p

end RelabelOrder

section SymmetricOrder

/-- The residual-variable order is inherited from the original folded
symmetric index. Carriers and matrix entries are interleaved exactly as in
the original variable order. -/
def pivotVariableLinearOrder (n : ℕ) : LinearOrder (PivotVariables n) :=
  LinearOrder.lift' (fun i => pivotEntry (some i))
    (fun _ _ h => Option.some.inj (pivotEntry_injective h))

/-- The full pivot presentation carries precisely the original folded
variable order. -/
def pivotFullLinearOrder (n : ℕ) : LinearOrder (Option (PivotVariables n)) :=
  LinearOrder.lift' pivotEntry pivotEntry_injective

variable {n : ℕ}

local instance : LinearOrder (PivotVariables n) := pivotVariableLinearOrder n
local instance : LinearOrder (Option (PivotVariables n)) := pivotFullLinearOrder n
local instance pivotVariableChosenLE : LE (PivotVariables n) :=
  (pivotVariableLinearOrder n).toLE
local instance pivotVariableChosenLT : LT (PivotVariables n) :=
  (pivotVariableLinearOrder n).toLT
local instance pivotVariableChosenPreorder : Preorder (PivotVariables n) :=
  (pivotVariableLinearOrder n).toPreorder
local instance pivotFullChosenLE : LE (Option (PivotVariables n)) :=
  (pivotFullLinearOrder n).toLE
local instance pivotFullChosenLT : LT (Option (PivotVariables n)) :=
  (pivotFullLinearOrder n).toLT
local instance pivotFullChosenPreorder : Preorder (Option (PivotVariables n)) :=
  (pivotFullLinearOrder n).toPreorder
local instance pivotVariableWellFoundedGT : WellFoundedGT (PivotVariables n) :=
  (wellFounded_gt (α := Entry (n + 1))).onFun
local instance pivotFullWellFoundedGT : WellFoundedGT (Option (PivotVariables n)) :=
  (wellFounded_gt (α := Entry (n + 1))).onFun

/-- This is an order isomorphism, not merely a bijection of variable sets. -/
def pivotEntryOrderIso : Option (PivotVariables n) ≃o Entry (n + 1) where
  toEquiv := pivotEntryEquiv
  map_rel_iff' := Iff.rfl

/-- The original folded grevlex order expressed in pivot coordinates. -/
def pivotFullOrder (n : ℕ) : MonomialOrder (Option (PivotVariables n)) :=
  TauCeti.MonomialOrder.degRevLex

/-- The inherited grevlex order after moving the pivot into the coefficient ring. -/
def pivotResidualOrder (n : ℕ) : MonomialOrder (PivotVariables n) :=
  TauCeti.MonomialOrder.degRevLex

theorem pivotSome_strictMono :
    StrictMono (Option.some : PivotVariables n → Option (PivotVariables n)) := by
  intro a b h
  change pivotEntry (some a) < pivotEntry (some b) at h ⊢
  exact h

variable {R : Type*} [CommRing R]

/-- The leading exponent of an actual symmetric polynomial is transported
exactly by the proved polynomial coordinate equivalence. -/
theorem pivotCoordinateEquiv_degree (p : CoordinateRing (n + 1) R) :
    (pivotFullOrder n).degree (pivotCoordinateEquiv p) =
      ((foldedOrder (n + 1)).degree p).mapDomain pivotEntryEquiv.symm := by
  exact grevlex_degree_rename pivotEntryOrderIso.symm p

theorem pivotCoordinateEquiv_isHomogeneous (p : CoordinateRing (n + 1) R)
    {d : ℕ} (hp : p.IsHomogeneous d) :
    (pivotCoordinateEquiv p).IsHomogeneous d :=
  hp.rename_isHomogeneous

/-- The leading monomial condition of Lemma 3.3 is proved for the actual
symmetric coordinate ring and the actual inherited folded grevlex orders.
The only polynomial hypotheses are homogeneity, nonzeroness, and omission of
the pivot from the original leading monomial. -/
theorem symmetric_genericPivot_degree {K : Type*} [Field K]
    (p : CoordinateRing (n + 1) K) (hp : p ≠ 0) {d : ℕ}
    (hhom : p.IsHomogeneous d)
    (hfree : ((foldedOrder (n + 1)).degree p) (fold 0 0) = 0) :
    (pivotResidualOrder n).degree (genericPivotMap (pivotCoordinateEquiv p)) =
      (((foldedOrder (n + 1)).degree p).mapDomain pivotEntryEquiv.symm).some := by
  have hren : pivotCoordinateEquiv p ≠ 0 := by
    intro h
    apply hp
    exact pivotCoordinateEquiv.injective (h.trans (map_zero _).symm)
  have hfree' : ((pivotFullOrder n).degree (pivotCoordinateEquiv p)) none = 0 := by
    rw [pivotCoordinateEquiv_degree, Finsupp.mapDomain_equiv_apply]
    simpa only [Equiv.symm_symm, pivotEntryEquiv_apply, pivotEntry, fold_self] using hfree
  have h := grevlex_degree_pivotMap pivotSome_strictMono
    (algebraMap (Polynomial K) (RatFunc K)) (RatFunc.algebraMap_injective K)
    (pivotCoordinateEquiv p) hren (pivotCoordinateEquiv_isHomogeneous p hhom) hfree'
  change (pivotResidualOrder n).degree (genericPivotMap (pivotCoordinateEquiv p)) =
    ((pivotFullOrder n).degree (pivotCoordinateEquiv p)).some at h
  rw [pivotCoordinateEquiv_degree] at h
  exact h


/-- A Gröbner basis in the proved pivot presentation descends to precisely
its original generators in the symmetric coordinate ring. Divisibility of
leading monomials is reflected by the bijection of variable indices. -/
theorem isGroebnerBasis_of_pivotCoordinates {K : Type*} [Field K]
    (H : Ideal (CoordinateRing (n + 1) K))
    (G : Set (CoordinateRing (n + 1) K)) (hGH : G ⊆ H)
    (hGB : (pivotFullOrder n).IsGroebnerBasis (pivotCoordinateEquiv '' G)
      (H.map pivotCoordinateEquiv.toRingHom)) :
    (foldedOrder (n + 1)).IsGroebnerBasis G H := by
  apply (MonomialOrder.isGroebnerBasis_iff_forall_exists_degree_le_degree
    (fun _ _ hg => (foldedOrder (n + 1)).isUnit_leadingCoeff.mpr hg)).mpr
  refine ⟨hGH, ?_⟩
  intro p hp hp0
  have hp' : pivotCoordinateEquiv p ≠ 0 := by
    intro h
    apply hp0
    exact pivotCoordinateEquiv.injective (h.trans (map_zero _).symm)
  obtain ⟨_, ⟨g, hg, rfl⟩, hg0, hle⟩ := hGB.exists_degree_le_degree
    (Ideal.mem_map_of_mem _ hp) hp'
  refine ⟨g, hg, ?_, ?_⟩
  · intro h
    apply hg0
    rw [h, map_zero]
  · change (pivotFullOrder n).degree (pivotCoordinateEquiv g) ≤
      (pivotFullOrder n).degree (pivotCoordinateEquiv p) at hle
    simp only [pivotCoordinateEquiv_degree] at hle
    exact (Finsupp.mapDomain_le_mapDomain_iff_le pivotEntryEquiv.symm.injective _ _).mp hle

/-- The complete comparison lemma applied to the original symmetric ring.
The hypotheses concern the actual ideal, actual prescribed polynomials,
and actual generic-fiber quotient. Homogeneity and pivot omission now
supply the leading-monomial preservation condition by theorem, rather than
leaving it as an extra assumption. -/
theorem comparison_original_symmetric {K : Type*} [Field K]
    (H : Ideal (CoordinateRing (n + 1) K))
    (G : Set (CoordinateRing (n + 1) K)) (hGH : G ⊆ H)
    (hhom : ∀ g ∈ G, g ≠ 0 → ∃ d, g.IsHomogeneous d)
    (hfree : ∀ g ∈ G, g ≠ 0 →
      ((foldedOrder (n + 1)).degree g) (fold 0 0) = 0)
    (hH : (H.map pivotCoordinateEquiv.toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule K (fun o => o.elim 0 pivotEndpointWeight)))
    (hHilbert : ∀ d,
      {e : PivotVariables n →₀ ℕ |
        e ∈ (pivotResidualOrder n).standardMonomials
          (pivotLeadingIdeal (pivotFullOrder n) (pivotCoordinateEquiv '' G)) ∧
        weight pivotEndpointWeight e = d}.ncard =
          Module.finrank (RatFunc K)
            (quotientPiece ((H.map pivotCoordinateEquiv.toRingHom).map genericPivotMap)
              pivotEndpointWeight d)) :
    (foldedOrder (n + 1)).IsGroebnerBasis G H := by
  apply isGroebnerBasis_of_pivotCoordinates H G hGH
  apply lemma_3_3_symmetric (pivotFullOrder n) (pivotResidualOrder n)
    (H.map pivotCoordinateEquiv.toRingHom) (pivotCoordinateEquiv '' G)
  · rintro _ ⟨g, hg, rfl⟩
    exact Ideal.mem_map_of_mem _ (hGH hg)
  · rintro _ ⟨g, hg, rfl⟩ hg0
    have hgne : g ≠ 0 := by intro h; apply hg0; rw [h, map_zero]
    rw [pivotCoordinateEquiv_degree, Finsupp.mapDomain_equiv_apply]
    simpa only [Equiv.symm_symm, pivotEntryEquiv_apply, pivotEntry_none] using
      hfree g hg hgne
  · rintro _ ⟨g, hg, rfl⟩ hg0
    have hgne : g ≠ 0 := by intro h; apply hg0; rw [h, map_zero]
    obtain ⟨d, hd⟩ := hhom g hg hgne
    rw [pivotCoordinateEquiv_degree]
    exact symmetric_genericPivot_degree g hgne hd (hfree g hg hgne)
  · exact hH
  · exact hHilbert

end SymmetricOrder

end FourPapers.Symmetric.Pivot
end
