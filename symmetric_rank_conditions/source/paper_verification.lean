namespace FourPapers.Symmetric

/-- The empty northwest ideal has no prescribed generators. -/
theorem northwestIdeal_zero_dimension (R : Type*) [CommRing R] (r : RankArray 0) :
    northwestIdeal R r = ⊥ := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨i, j, a, b, ha, hb, h⟩
    exact Fin.elim0 i
  · exact bot_le

/-- The exact base case of the primeness induction. -/
theorem northwestIdeal_isPrime_zero_dimension (R : Type*) [CommRing R] [IsDomain R]
    (r : RankArray 0) : (northwestIdeal R r).IsPrime := by
  rw [northwestIdeal_zero_dimension]
  infer_instance

/-- The northwest ideal commutes with an actual coefficient-ring map. -/
theorem map_northwestIdeal_coeff {n : ℕ} {R S : Type*} [CommRing R] [CommRing S]
    (φ : R →+* S) (r : RankArray n) :
    (northwestIdeal R r).map (MvPolynomial.map φ) = northwestIdeal S r := by
  rw [northwestIdeal, Ideal.map_span, map_northwestGenerators, northwestIdeal]

/-- The field Gröbner theorem gives the same northwest basis over a coefficient
domain by monic division and the genuine fraction-field embedding. -/
theorem northwestGroebner_of_fraction {n : ℕ} (R : Type*) [CommRing R] [IsDomain R]
    (r : RankArray n)
    (hF : (foldedOrder n).IsGroebnerBasis
      (northwestGenerators (FractionRing R) r) (northwestIdeal (FractionRing R) r)) :
    (foldedOrder n).IsGroebnerBasis (northwestGenerators R r) (northwestIdeal R r) := by
  apply (MonomialOrder.isGroebnerBasis_map_iff
    (IsFractionRing.injective R (FractionRing R))
    (fun g hg _ => by
      obtain ⟨i, j, a, b, ha, hb, rfl⟩ := hg
      exact minor_leadingCoeff_isUnit R a b)
    (show northwestGenerators R r ⊆ northwestIdeal R r from Ideal.subset_span)).mp
  simpa only [map_northwestGenerators, map_northwestIdeal_coeff] using hF

/-- If multiplication by `x` is regular on a quotient, every power of `x`
can be cancelled from ideal membership. -/
theorem ideal_cancel_pivot_power {R : Type*} [CommRing R]
    (I : Ideal R) (x : R) (hreg : ∀ f, f * x ∈ I → f ∈ I)
    (f : R) (a : ℕ) (h : x ^ a * f ∈ I) : f ∈ I := by
  induction a with
  | zero => simpa using h
  | succ a ih =>
      apply ih
      apply hreg (x ^ a * f)
      simpa only [pow_succ, mul_assoc, mul_comm f x] using h

/-- The precise contraction identity needed in the primeness induction. This
is proved from regularity, without assuming primeness of the original ideal. -/
theorem ideal_comap_map_away_of_regular {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (I : Ideal R) (x : R) [IsLocalization.Away x S]
    (hreg : ∀ f, f * x ∈ I → f ∈ I) :
    Ideal.comap (algebraMap R S) (Ideal.map (algebraMap R S) I) = I := by
  apply le_antisymm
  · intro f hf
    change algebraMap R S f ∈ I.map (algebraMap R S) at hf
    obtain ⟨s, hs, hsf⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers x) S I f).mp hf
    obtain ⟨a, rfl⟩ := hs
    exact ideal_cancel_pivot_power I x hreg f a hsf
  · exact Ideal.le_comap_map

/-- Primeness descends from the actual localization when the pivot is regular.
The chart primeness hypothesis is explicit, so this lemma cannot be confused with
an unconditional proof of the paper's rank-locus theorem. -/
theorem ideal_isPrime_of_regular_away {R S : Type*} [CommRing R] [CommRing S]
    [Algebra R S] (I : Ideal R) (x : R) [IsLocalization.Away x S]
    (hreg : ∀ f, f * x ∈ I → f ∈ I)
    (hchart : (Ideal.map (algebraMap R S) I).IsPrime) : I.IsPrime := by
  letI := hchart
  rw [← ideal_comap_map_away_of_regular (S := S) I x hreg]
  infer_instance


/-- Regularity transfers through an actual ring equivalence. -/
theorem ideal_regular_map_ringEquiv {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (I : Ideal R) (x : R)
    (hreg : ∀ f, f * x ∈ I → f ∈ I) :
    ∀ f, f * e x ∈ I.map e.toRingHom → f ∈ I.map e.toRingHom := by
  intro f hf
  obtain ⟨a, rfl⟩ := e.surjective f
  have ha : e (a * x) ∈ I.map e.toRingHom := by simpa only [map_mul] using hf
  change a * x ∈ (I.map e.toRingHom).comap e.toRingHom at ha
  rw [Ideal.comap_map_of_bijective e.toRingHom e.bijective] at ha
  exact Ideal.mem_map_of_mem e.toRingHom (hreg a ha)

/-- Primeness descends through a coordinate equivalence, an actual pivot
localization, and an actual chart equivalence. -/
theorem ideal_isPrime_of_away_chart {R A B C : Type*}
    [CommRing R] [CommRing A] [CommRing B] [CommRing C] [Algebra A B]
    (I : Ideal R) (x : R) (e : R ≃+* A) (d : B ≃+* C)
    [IsLocalization.Away (e x) B]
    (hreg : ∀ f, f * x ∈ I → f ∈ I)
    (hchart : (((I.map e.toRingHom).map (algebraMap A B)).map d.toRingHom).IsPrime) :
    I.IsPrime := by
  have hB : ((I.map e.toRingHom).map (algebraMap A B)).IsPrime := by
    letI := hchart
    rw [← Ideal.comap_map_of_bijective d.toRingHom d.bijective
      (I := (I.map e.toRingHom).map (algebraMap A B))]
    infer_instance
  have hA : (I.map e.toRingHom).IsPrime :=
    ideal_isPrime_of_regular_away (S := B) (I.map e.toRingHom) (e x)
      (ideal_regular_map_ringEquiv e I x hreg) hB
  letI := hA
  rw [← Ideal.comap_map_of_bijective e.toRingHom e.bijective (I := I)]
  infer_instance

section MatrixRankCharts

variable {K : Type*} [Field K]
variable {m n p : Type*} [Fintype m] [Fintype n] [Fintype p]

/-- Rank of a direct sum with an invertible block. The rank is the actual
Mathlib matrix rank, rather than a supplied dimension function. -/
theorem matrixRank_fromBlocks_unit (D : Matrix m n K) (A : Matrix p p K)
    [DecidableEq p] (hA : IsUnit A) :
    (Matrix.fromBlocks D 0 0 A).rank = D.rank + Fintype.card p := by
  classical
  let eout := LinearEquiv.sumArrowLequivProdArrow m p K K
  let ein := LinearEquiv.sumArrowLequivProdArrow n p K K
  have hlin : eout.toLinearMap.comp (Matrix.fromBlocks D 0 0 A).mulVecLin =
      (D.mulVecLin.prodMap A.mulVecLin).comp ein.toLinearMap := by
    apply LinearMap.ext
    intro x
    apply Prod.ext <;> funext i <;>
      simp [eout, ein, Matrix.mulVecLin_apply, Matrix.fromBlocks_mulVec,
        LinearMap.prodMap_apply, Function.comp_def, LinearEquiv.sumArrowLequivProdArrow,
        Equiv.sumArrowEquivProdArrow]
  have hAtop : LinearMap.range A.mulVecLin = ⊤ :=
    LinearMap.range_eq_top.mpr (Matrix.mulVec_surjective_iff_isUnit.mpr hA)
  have hrange : (LinearMap.range (Matrix.fromBlocks D 0 0 A).mulVecLin).map eout.toLinearMap =
      (LinearMap.range D.mulVecLin).prod ⊤ := by
    rw [← LinearMap.range_comp, hlin, LinearEquiv.range_comp,
      LinearMap.range_prodMap, hAtop]
  rw [Matrix.rank, Matrix.rank]
  calc
    Module.finrank K (LinearMap.range (Matrix.fromBlocks D 0 0 A).mulVecLin) =
        Module.finrank K ((LinearMap.range (Matrix.fromBlocks D 0 0 A).mulVecLin).map
          eout.toLinearMap) :=
      (Submodule.equivMapOfInjective eout.toLinearMap eout.injective _).finrank_eq
    _ = Module.finrank K ((LinearMap.range D.mulVecLin).prod
        (⊤ : Submodule K (p → K))) := by rw [hrange]
    _ = Module.finrank K (LinearMap.range D.mulVecLin) + Fintype.card p := by
      rw [(Submodule.prodEquiv _ _).finrank_eq, Module.finrank_prod,
        finrank_top, Module.finrank_pi]

/-- The pivot block may be placed before the residual matrix. -/
theorem matrixRank_fromBlocks_unit_first (A : Matrix p p K) (D : Matrix m n K)
    [DecidableEq p] (hA : IsUnit A) :
    (Matrix.fromBlocks A 0 0 D).rank = D.rank + Fintype.card p := by
  have h := Matrix.rank_submatrix (Matrix.fromBlocks A 0 0 D)
    (Equiv.sumComm m p) (Equiv.sumComm n p)
  change (Matrix.submatrix (Matrix.fromBlocks A 0 0 D) Sum.swap Sum.swap).rank = _ at h
  rw [Matrix.fromBlocks_submatrix_sum_swap_sum_swap] at h
  rw [← h]
  exact matrixRank_fromBlocks_unit D A hA

/-- Invertible changes of row and column coordinates preserve rank. -/
theorem matrixRank_mul_mul_of_isUnit (L : Matrix m m K) (M : Matrix m n K)
    (R : Matrix n n K) [DecidableEq m] [DecidableEq n]
    (hL : IsUnit L) (hR : IsUnit R) : (L * M * R).rank = M.rank := by
  rw [Matrix.rank_mul_eq_left_of_isUnit_det R (L * M)
    ((Matrix.isUnit_iff_isUnit_det _).mp hR)]
  exact Matrix.rank_mul_eq_right_of_isUnit_det L M
    ((Matrix.isUnit_iff_isUnit_det _).mp hL)

/-- Schur rank reduction for actual matrices. This supplies the smaller
realized rank profile without requiring a partial-permutation classification. -/
theorem matrixRank_schur [DecidableEq m] [DecidableEq n] [DecidableEq p]
    (A : Matrix p p K) (B : Matrix p n K) (C : Matrix m p K) (D : Matrix m n K)
    [Invertible A] :
    (Matrix.fromBlocks A B C D).rank =
      (D - C * ⅟A * B).rank + Fintype.card p := by
  rw [Matrix.fromBlocks_eq_of_invertible₁₁ A B C D]
  rw [matrixRank_mul_mul_of_isUnit]
  · exact matrixRank_fromBlocks_unit_first A (D - C * ⅟A * B)
      (isUnit_of_invertible A)
  · rw [Matrix.isUnit_fromBlocks_zero₁₂]
    exact ⟨isUnit_one, isUnit_one⟩
  · rw [Matrix.isUnit_fromBlocks_zero₂₁]
    exact ⟨isUnit_one, isUnit_one⟩

