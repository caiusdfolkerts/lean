def northwestSubtypeMatrix {n : ℕ} {R : Type*}
    (M : Matrix (Fin n) (Fin n) R) (i j : Fin n) :
    Matrix {p : Fin n // p ≤ i} {q : Fin n // q ≤ j} R :=
  M.submatrix Subtype.val Subtype.val

theorem northwestSubtype_minorIdeal {n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin n) (Fin n) R) (i j : Fin n) (t : ℕ) :
    matrixMinorIdeal (northwestSubtypeMatrix M i j) t =
      matrixMinorIdeal (northwestPrefixMatrix M i j) t :=
  (matrixMinorIdeal_submatrix_equiv (northwestSubtypeMatrix M i j)
    (northwestPrefixEquiv i) (northwestPrefixEquiv j) t).symm

def offDiagonalPrefixBeforeFun {n : ℕ} (k : Fin (n + 1)) (i : Fin (n + 2))
    (hi : i < k.succ) : PUnit.{1} ⊕ InducedPrefix (offDiagonalResidualEmbedding k) i →
      {p : Fin (n + 2) // p ≤ i}
  | .inl _ => ⟨0, Fin.zero_le _⟩
  | .inr p => ⟨offDiagonalResidualEmbedding k p.val, p.property⟩

theorem offDiagonalPrefixBeforeFun_bijective {n : ℕ} (k : Fin (n + 1))
    (i : Fin (n + 2)) (hi : i < k.succ) :
    Function.Bijective (offDiagonalPrefixBeforeFun k i hi) := by
  constructor
  · intro a b h
    have hv := congrArg Subtype.val h
    cases a with
    | inl a =>
      cases b with
      | inl b => exact congrArg Sum.inl (Subsingleton.elim a b)
      | inr b =>
        exact ((offDiagonalResidualEmbedding_mem_range k _).mp ⟨b.val, rfl⟩).1 hv.symm |>.elim
    | inr a =>
      cases b with
      | inl b =>
        exact ((offDiagonalResidualEmbedding_mem_range k _).mp ⟨a.val, rfl⟩).1 hv |>.elim
      | inr b =>
        congr 1
        exact Subtype.ext ((offDiagonalResidualEmbedding k).injective hv)
  · intro p
    by_cases hp0 : p.val = 0
    · exact ⟨.inl PUnit.unit, Subtype.ext hp0.symm⟩
    · have hpk : p.val ≠ k.succ := by
        intro he
        exact (not_le_of_gt hi) (he ▸ p.property)
      obtain ⟨q, hq⟩ := (offDiagonalResidualEmbedding_mem_range k p.val).mpr ⟨hp0, hpk⟩
      exact ⟨.inr ⟨q, hq.symm ▸ p.property⟩, Subtype.ext hq⟩

def offDiagonalPrefixBeforeEquiv {n : ℕ} (k : Fin (n + 1)) (i : Fin (n + 2))
    (hi : i < k.succ) : PUnit.{1} ⊕ InducedPrefix (offDiagonalResidualEmbedding k) i ≃
      {p : Fin (n + 2) // p ≤ i} :=
  Equiv.ofBijective (offDiagonalPrefixBeforeFun k i hi)
    (offDiagonalPrefixBeforeFun_bijective k i hi)

def offDiagonalPrefixAfterFun {n : ℕ} (k : Fin (n + 1)) (i : Fin (n + 2))
    (hi : k.succ ≤ i) : (PUnit.{1} ⊕ PUnit.{1}) ⊕ InducedPrefix (offDiagonalResidualEmbedding k) i →
      {p : Fin (n + 2) // p ≤ i}
  | .inl (.inl _) => ⟨0, Fin.zero_le _⟩
  | .inl (.inr _) => ⟨k.succ, hi⟩
  | .inr p => ⟨offDiagonalResidualEmbedding k p.val, p.property⟩

theorem offDiagonalPrefixAfterFun_bijective {n : ℕ} (k : Fin (n + 1))
    (i : Fin (n + 2)) (hi : k.succ ≤ i) :
    Function.Bijective (offDiagonalPrefixAfterFun k i hi) := by
  constructor
  · intro a b h
    have he (z : (PUnit.{1} ⊕ PUnit.{1}) ⊕ InducedPrefix (offDiagonalResidualEmbedding k) i) :
        (offDiagonalPrefixAfterFun k i hi z).val =
          twoIndicesEquiv k (Sum.map id Subtype.val z) := by
      rcases z with (z | z) | z
      · change (0 : Fin (n + 2)) = twoIndicesEquiv k (.inl (.inl z))
        exact (twoIndicesEquiv_first k z).symm
      · change k.succ = twoIndicesEquiv k (.inl (.inr z))
        exact (twoIndicesEquiv_second k z).symm
      · change (k.succAbove z.val).succ = twoIndicesEquiv k (.inr z.val)
        exact (twoIndicesEquiv_residual k z.val).symm
    have hv := (twoIndicesEquiv k).injective ((he a).symm.trans
      ((congrArg Subtype.val h).trans (he b)))
    exact (Sum.map_injective.mpr ⟨Function.injective_id, Subtype.val_injective⟩) hv
  · intro p
    by_cases hp0 : p.val = 0
    · exact ⟨.inl (.inl PUnit.unit), Subtype.ext hp0.symm⟩
    · by_cases hpk : p.val = k.succ
      · exact ⟨.inl (.inr PUnit.unit), Subtype.ext hpk.symm⟩
      · obtain ⟨q, hq⟩ := (offDiagonalResidualEmbedding_mem_range k p.val).mpr ⟨hp0, hpk⟩
        exact ⟨.inr ⟨q, hq.symm ▸ p.property⟩, Subtype.ext hq⟩

def offDiagonalPrefixAfterEquiv {n : ℕ} (k : Fin (n + 1)) (i : Fin (n + 2))
    (hi : k.succ ≤ i) : (PUnit.{1} ⊕ PUnit.{1}) ⊕ InducedPrefix (offDiagonalResidualEmbedding k) i ≃
      {p : Fin (n + 2) // p ≤ i} :=
