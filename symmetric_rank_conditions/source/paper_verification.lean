  logInfo "CANONICAL_DECL PivotChartMaps.symm_entry"

@[simp] theorem schurCoordinateEquiv_symm_entry (q : S) (e : Entry n) :
    (schurCoordinateEquiv q).symm (X (.inr e)) =
      X (.inr e) + C q * X (.inl e.val.1) * X (.inl e.val.2) := by
  change triangularShift (-schurOffset q) (X (.inr e)) = _
  rw [triangularShift_X_right]
  change X (.inr e) + rename (R := S) (Sum.inl : Fin n → PivotVariables n)
      (-(-(C q * X e.val.1 * X e.val.2 : MvPolynomial (Fin n) S))) =
    X (.inr e) + C q * X (.inl e.val.1) * X (.inl e.val.2)
  rw [neg_neg]
  rw [map_mul (rename (R := S) (Sum.inl : Fin n → PivotVariables n))
    (C q * X e.val.1 : MvPolynomial (Fin n) S) (X e.val.2)]
  rw [map_mul (rename (R := S) (Sum.inl : Fin n → PivotVariables n))
    (C q : MvPolynomial (Fin n) S) (X e.val.1)]
  rw [rename_C (R := S) (Sum.inl : Fin n → PivotVariables n) q,
    rename_X (R := S) (Sum.inl : Fin n → PivotVariables n) e.val.1,
    rename_X (R := S) (Sum.inl : Fin n → PivotVariables n) e.val.2]

