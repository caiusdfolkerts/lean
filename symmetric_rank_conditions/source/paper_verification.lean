section

set_option autoImplicit false
noncomputable section

namespace FourPapers.Symmetric
open MvPolynomial

/-- Coordinates involving at least one deleted vertex are treated as independent
coefficient variables. The other coordinates are the smaller symmetric matrix. -/
def ResidualCarriers {m n : ℕ} (a : Fin m ↪o Fin n) :=
  {e : Entry n // e ∉ Set.range (entryEmbedding a)}

def residualVariableJoin {m n : ℕ} (a : Fin m ↪o Fin n) :
    Entry m ⊕ ResidualCarriers a → Entry n :=
  Sum.elim (entryEmbedding a) Subtype.val

theorem residualVariableJoin_injective {m n : ℕ} (a : Fin m ↪o Fin n) :
    Function.Injective (residualVariableJoin a) := by
  intro e f h
  cases e with
  | inl e =>
    cases f with
    | inl f => exact congrArg Sum.inl ((entryEmbedding a).injective h)
    | inr f => exact (f.property ⟨e, h⟩).elim
  | inr e =>
    cases f with
    | inl f => exact (e.property ⟨f, h.symm⟩).elim
    | inr f => exact congrArg Sum.inr (Subtype.ext h)

theorem residualVariableJoin_surjective {m n : ℕ} (a : Fin m ↪o Fin n) :
    Function.Surjective (residualVariableJoin a) := by
  classical
  intro e
  by_cases h : e ∈ Set.range (entryEmbedding a)
  · obtain ⟨f, rfl⟩ := h
    exact ⟨Sum.inl f, rfl⟩
  · exact ⟨Sum.inr ⟨e, h⟩, rfl⟩

/-- The variable partition is a proved bijection, rather than a list with
possible repetitions or missing symmetric coordinates. -/
def residualVariableEquiv {m n : ℕ} (a : Fin m ↪o Fin n) :
    Entry m ⊕ ResidualCarriers a ≃ Entry n :=
  Equiv.ofBijective (residualVariableJoin a)
    ⟨residualVariableJoin_injective a, residualVariableJoin_surjective a⟩

@[simp] theorem residualVariableEquiv_residual {m n : ℕ} (a : Fin m ↪o Fin n)
    (e : Entry m) : residualVariableEquiv a (Sum.inl e) = entryEmbedding a e := rfl

@[simp] theorem residualVariableEquiv_carrier {m n : ℕ} (a : Fin m ↪o Fin n)
    (e : ResidualCarriers a) : residualVariableEquiv a (Sum.inr e) = e.val := rfl

/-- The larger coordinate ring is exactly a polynomial ring in the smaller
symmetric entries over the polynomial ring in its carrier coordinates. -/
def residualCoefficientEquiv {m n : ℕ} (R : Type*) [CommRing R]
    (a : Fin m ↪o Fin n) :
    CoordinateRing n R ≃ₐ[R] CoordinateRing m (MvPolynomial (ResidualCarriers a) R) :=
  (renameEquiv R (residualVariableEquiv a).symm).trans
    (sumAlgEquiv R (Entry m) (ResidualCarriers a))

@[simp] theorem residualCoefficientEquiv_residual {m n : ℕ} (R : Type*) [CommRing R]
    (a : Fin m ↪o Fin n) (e : Entry m) :
    residualCoefficientEquiv R a (X (entryEmbedding a e)) = X e := by
  change sumAlgEquiv R (Entry m) (ResidualCarriers a)
    (rename (residualVariableEquiv a).symm (X (residualVariableEquiv a (Sum.inl e)))) = _
  rw [rename_X, Equiv.symm_apply_apply, sumAlgEquiv_X_inl]

@[simp] theorem residualCoefficientEquiv_carrier {m n : ℕ} (R : Type*) [CommRing R]
    (a : Fin m ↪o Fin n) (e : ResidualCarriers a) :
    residualCoefficientEquiv R a (X e.val) = C (X e) := by
  change sumAlgEquiv R (Entry m) (ResidualCarriers a)
    (rename (residualVariableEquiv a).symm (X (residualVariableEquiv a (Sum.inr e)))) = _
  rw [rename_X, Equiv.symm_apply_apply, sumAlgEquiv_X_inr]

/-- An arbitrary coefficient homomorphism on carriers, applied to the genuine
larger symmetric coordinate ring. -/
def residualCoefficientMap {m n : ℕ} {R S : Type*} [CommRing R] [CommRing S]
    (a : Fin m ↪o Fin n) (φ : MvPolynomial (ResidualCarriers a) R →+* S) :
    CoordinateRing n R →+* CoordinateRing m S :=
  (MvPolynomial.map φ).comp (residualCoefficientEquiv R a).toRingHom

@[simp] theorem residualCoefficientMap_residual {m n : ℕ} {R S : Type*}
    [CommRing R] [CommRing S] (a : Fin m ↪o Fin n)
    (φ : MvPolynomial (ResidualCarriers a) R →+* S) (e : Entry m) :
    residualCoefficientMap a φ (X (entryEmbedding a e)) = X e := by
  simp [residualCoefficientMap]

@[simp] theorem residualCoefficientMap_carrier {m n : ℕ} {R S : Type*}
    [CommRing R] [CommRing S] (a : Fin m ↪o Fin n)
    (φ : MvPolynomial (ResidualCarriers a) R →+* S) (e : ResidualCarriers a) :
    residualCoefficientMap a φ (X e.val) = C (φ (X e)) := by
  simp [residualCoefficientMap]

end FourPapers.Symmetric
end
end
