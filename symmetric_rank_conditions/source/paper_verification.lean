set_option autoImplicit false
set_option maxHeartbeats 1200000

noncomputable section

/-!
# Determinant-product containment in genuine symbolic powers

Once ordinary determinantal primality is available, repeated first-diagonal
Schur charts prove the required containment of larger minors.  This proof
does not assume the symbolic generation theorem that it will help establish.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp

universe u

theorem determinantalIdeal_le_pow_idealOfVars
    (n : ℕ) (R : Type*) [CommRing R] (r : ℕ) :
    determinantalIdeal n R r ≤ idealOfVars (Entry n) R ^ r := by
  apply Ideal.span_le.mpr
  rintro f ⟨a, b, rfl⟩
  change minor R a b ∈ idealOfVars (Entry n) R ^ r
  rw [mem_pow_idealOfVars_iff]
  intro e he
  have h := minor_isHomogeneous_total R a b (MvPolynomial.mem_support_iff.mp he)
  have hd : e.degree = r := by
    simpa only [Finsupp.degree_eq_weight_one, Pi.one_def] using h
  exact hd.ge

/-- Every `r`-minor belongs to the `(r-t+1)`st symbolic power of the `t`-minor
prime.  The hypothesis is precisely the preceding ordinary primality result,
uniform over dimensions and fields, as needed when the chart replaces a
coefficient field by its rational-function field. -/
theorem determinantalIdeal_le_symbolicPower_of_primality
    (hprime : ∀ (n : ℕ) (K : Type u) [Field K] (t : ℕ),
      0 < t → (determinantalIdeal n K t).IsPrime) :
    ∀ (n : ℕ) (K : Type u) [Field K] (t r : ℕ), 0 < t → t ≤ r →
      determinantalIdeal n K r ≤ symbolicPower (determinantalIdeal n K t) (r - t + 1) := by
  intro n
  induction n with
  | zero =>
    intro K instK t r ht htr
    rw [determinantalIdeal_eq_matrixMinorIdeal,
      matrixMinorIdeal_eq_bot_of_rows_lt _ r (ht.trans_le htr)]
    exact bot_le
  | succ n ih =>
    intro K instK t r ht htr
    cases t with
    | zero => omega
    | succ t =>
      cases t with
      | zero =>
        rw [determinantalIdeal_one, symbolicPower_idealOfVars,
          Nat.sub_add_cancel htr]
        exact determinantalIdeal_le_pow_idealOfVars (n + 1) K r
      | succ t =>
        cases r with
        | zero => omega
        | succ r =>
          letI : (determinantalIdeal (n + 1) K (t + 1 + 1)).IsPrime :=
            hprime (n + 1) K (t + 1 + 1) (by omega)
          letI : (determinantalIdeal n (RatFunc K) (t + 1)).IsPrime :=
            hprime n (RatFunc K) (t + 1) (by omega)
          have hsize : t + 1 ≤ r := by omega
          have hsmall := ih (RatFunc K) (t + 1) r (by omega) hsize
          have hm : (determinantalIdeal (n + 1) K (r + 1)).map
                (genericFirstPivotChart (n := n) K) ≤
              (symbolicPower (determinantalIdeal n (RatFunc K) (t + 1))
                (r - (t + 1) + 1)).map
                  (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom := by
            rw [determinantalIdeal_map_genericFirstPivotChart]
            exact Ideal.map_mono hsmall
          have h := (Ideal.map_le_iff_le_comap).mp hm
          rw [symbolicPower_comap_genericFirstPivotChart] at h
          have hscore : r + 1 - (t + 1 + 1) + 1 = r - (t + 1) + 1 := by omega
          simpa only [hscore] using h

theorem minor_mem_symbolicPower_of_primality
    (hprime : ∀ (n : ℕ) (K : Type u) [Field K] (t : ℕ),
      0 < t → (determinantalIdeal n K t).IsPrime)
    {n t r : ℕ} (K : Type u) [Field K] (ht : 0 < t) (htr : t ≤ r)
    (a b : Fin r ↪o Fin n) :
    minor K a b ∈ symbolicPower (determinantalIdeal n K t) (r - t + 1) :=
  determinantalIdeal_le_symbolicPower_of_primality hprime n K t r ht htr
    (Ideal.subset_span ⟨a, b, rfl⟩)

/-- The literal proposed product generators lie in the actual symbolic
power, for every number of factors and every symbolic exponent. -/
theorem symbolicGenerators_subset_symbolicPower_of_primality
    (hprime : ∀ (n : ℕ) (K : Type u) [Field K] (t : ℕ),
      0 < t → (determinantalIdeal n K t).IsPrime)
    (n : ℕ) (K : Type u) [Field K] (t s : ℕ) (ht : 0 < t) :
    symbolicGenerators K n t s ⊆ symbolicPower (determinantalIdeal n K t) s := by
  classical
  rintro f ⟨k, δ, hδ, hscore, rfl⟩
  letI := hprime n K t ht
  have h := prod_mem_symbolicPower_sum (determinantalIdeal n K t) Finset.univ
    (fun j => (δ j).size - t + 1) (fun j => (δ j).polynomial K)
    (fun j _ => minor_mem_symbolicPower_of_primality hprime K ht (hδ j)
      (δ j).rows (δ j).cols)
  change (∏ j, (δ j).polynomial K) ∈ symbolicPower (determinantalIdeal n K t) s
  simpa only [hscore] using h

end FourPapers.Symmetric.Pivot
end
