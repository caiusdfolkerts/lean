section

set_option autoImplicit false
noncomputable section

namespace FourPapers.Symmetric

/-- A nonempty minor cannot select rows from an empty index type. -/
theorem matrixMinorIdeal_eq_bot_of_isEmpty_rows {R m n : Type*} [CommRing R]
    [IsEmpty m] (M : Matrix m n R) (t : ℕ) (ht : 0 < t) :
    matrixMinorIdeal M t = ⊥ := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨a, b, hf⟩
    exact isEmptyElim (a ⟨0, ht⟩)
  · exact bot_le

theorem matrixMinorIdeal_eq_bot_of_isEmpty_cols {R m n : Type*} [CommRing R]
    [IsEmpty n] (M : Matrix m n R) (t : ℕ) (ht : 0 < t) :
    matrixMinorIdeal M t = ⊥ := by
  rw [← matrixMinorIdeal_transpose]
  exact matrixMinorIdeal_eq_bot_of_isEmpty_rows M.transpose t ht

/-- The preimage of an ambient prefix under an increasing embedding. It may
be empty, and no artificial last element is introduced in that case. -/
abbrev InducedPrefix {m n : ℕ} (a : Fin m ↪o Fin n) (i : Fin n) :=
  {p : Fin m // a p ≤ i}

def inducedPrefixMatrix {m n : ℕ} {R : Type*}
    (M : Matrix (Fin m) (Fin m) R) (a : Fin m ↪o Fin n) (i j : Fin n) :
    Matrix (InducedPrefix a i) (InducedPrefix a j) R :=
  M.submatrix Subtype.val Subtype.val

/-- Every nonempty induced prefix is one of the ordinary smaller prefixes. -/
theorem exists_inducedPrefix_endpoint {m n : ℕ} (a : Fin m ↪o Fin n) (i : Fin n)
    (hne : ∃ p, a p ≤ i) : ∃ q : Fin m, ∀ p, a p ≤ i ↔ p ≤ q := by
  classical
  let s := Finset.univ.filter (fun p : Fin m => a p ≤ i)
  have hs : s.Nonempty := by
    obtain ⟨p, hp⟩ := hne
    exact ⟨p, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hp⟩⟩
  obtain ⟨q, hq, hmax⟩ := Finset.exists_max_image s id hs
  have haq : a q ≤ i := (Finset.mem_filter.mp hq).2
  refine ⟨q, fun p => ⟨?_, ?_⟩⟩
  · intro hp
    exact hmax p (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hp⟩)
  · intro hp
    exact (a.monotone hp).trans haq

/-- Exact reindexing of a nonempty induced prefix. -/
def inducedPrefixEquiv {m n : ℕ} (a : Fin m ↪o Fin n) (i : Fin n) (p : Fin m)
    (hp : ∀ q, a q ≤ i ↔ q ≤ p) : Fin (p.val + 1) ≃ InducedPrefix a i :=
  (northwestPrefixEquiv p).trans (Equiv.subtypeEquivRight (fun q => (hp q).symm))

theorem inducedPrefixMatrix_submatrix {m n : ℕ} {R : Type*}
    (M : Matrix (Fin m) (Fin m) R) (a : Fin m ↪o Fin n) (i j : Fin n)
    (p q : Fin m) (hp : ∀ z, a z ≤ i ↔ z ≤ p) (hq : ∀ z, a z ≤ j ↔ z ≤ q) :
    (inducedPrefixMatrix M a i j).submatrix
      (inducedPrefixEquiv a i p hp) (inducedPrefixEquiv a j q hq) =
        northwestPrefixMatrix M p q := rfl

theorem inducedPrefixMatrix_rank {m n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin m) (Fin m) F) (a : Fin m ↪o Fin n) (i j : Fin n)
    (p q : Fin m) (hp : ∀ z, a z ≤ i ↔ z ≤ p) (hq : ∀ z, a z ≤ j ↔ z ≤ q) :
    (inducedPrefixMatrix w a i j).rank = matrixRankArray w p q := by
  rw [← Matrix.rank_submatrix (inducedPrefixMatrix w a i j)
    (inducedPrefixEquiv a i p hp) (inducedPrefixEquiv a j q hq),
    inducedPrefixMatrix_submatrix, northwestPrefixMatrix_rank]

theorem inducedPrefixMatrix_minorIdeal {m n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin m) (Fin m) R) (a : Fin m ↪o Fin n) (i j : Fin n)
    (p q : Fin m) (hp : ∀ z, a z ≤ i ↔ z ≤ p) (hq : ∀ z, a z ≤ j ↔ z ≤ q) (t : ℕ) :
    matrixMinorIdeal (inducedPrefixMatrix M a i j) t =
      matrixMinorIdeal (northwestPrefixMatrix M p q) t := by
  rw [← matrixMinorIdeal_submatrix_equiv (inducedPrefixMatrix M a i j)
    (inducedPrefixEquiv a i p hp) (inducedPrefixEquiv a j q hq), inducedPrefixMatrix_submatrix]

/-- An induced prefix imposes a genuine smaller northwest condition, or no
condition when one of its index sets is empty. -/
theorem inducedPrefix_minorIdeal_le {m n : ℕ} {R F : Type*} [CommRing R] [Field F]
    (M : Matrix (Fin m) (Fin m) R) (w : Matrix (Fin m) (Fin m) F)
    (a : Fin m ↪o Fin n) (i j : Fin n) :
    matrixMinorIdeal (inducedPrefixMatrix M a i j)
      ((inducedPrefixMatrix w a i j).rank + 1) ≤ northwestMatrixIdeal M (matrixRankArray w) := by
  classical
  by_cases hi : ∃ p, a p ≤ i
  · by_cases hj : ∃ q, a q ≤ j
    · obtain ⟨p, hp⟩ := exists_inducedPrefix_endpoint a i hi
      obtain ⟨q, hq⟩ := exists_inducedPrefix_endpoint a j hj
      rw [inducedPrefixMatrix_rank w a i j p q hp hq,
        inducedPrefixMatrix_minorIdeal M a i j p q hp hq]
      exact le_iSup_of_le p (le_iSup_of_le q le_rfl)
    · letI : IsEmpty (InducedPrefix a j) := ⟨fun p => hj ⟨p.val, p.property⟩⟩
      rw [matrixMinorIdeal_eq_bot_of_isEmpty_cols _ _ (Nat.zero_lt_succ _)]
      exact bot_le
  · letI : IsEmpty (InducedPrefix a i) := ⟨fun p => hi ⟨p.val, p.property⟩⟩
    rw [matrixMinorIdeal_eq_bot_of_isEmpty_rows _ _ (Nat.zero_lt_succ _)]
    exact bot_le

/-- Every smaller prefix occurs among the induced ambient prefixes. Thus the
entire family, including all empty boundary cases, gives exactly the smaller
rank ideal. The realizing field is independent of the coefficient ring. -/
theorem iSup_inducedPrefix_minorIdeals {m n : ℕ} {R F : Type*} [CommRing R] [Field F]
    (M : Matrix (Fin m) (Fin m) R) (w : Matrix (Fin m) (Fin m) F)
    (a : Fin m ↪o Fin n) :
    (⨆ i : Fin n, ⨆ j : Fin n,
      matrixMinorIdeal (inducedPrefixMatrix M a i j)
        ((inducedPrefixMatrix w a i j).rank + 1)) =
      northwestMatrixIdeal M (matrixRankArray w) := by
  apply le_antisymm
  · exact iSup_le (fun i => iSup_le (fun j => inducedPrefix_minorIdeal_le M w a i j))
  · apply iSup_le
    intro p
    apply iSup_le
    intro q
    have hp : ∀ z, a z ≤ a p ↔ z ≤ p := fun z => a.le_iff_le
    have hq : ∀ z, a z ≤ a q ↔ z ≤ q := fun z => a.le_iff_le
    have hh : matrixMinorIdeal (northwestPrefixMatrix M p q) (matrixRankArray w p q + 1) =
        matrixMinorIdeal (inducedPrefixMatrix M a (a p) (a q))
          ((inducedPrefixMatrix w a (a p) (a q)).rank + 1) := by
      rw [inducedPrefixMatrix_rank w a (a p) (a q) p q hp hq,
        inducedPrefixMatrix_minorIdeal M a (a p) (a q) p q hp hq]
    rw [hh]
    exact le_iSup_of_le (a p) (le_iSup_of_le (a q) le_rfl)

end FourPapers.Symmetric
end
