namespace FourPapers.Symmetric
open Finset Finsupp MvPolynomial

/-- The exact exponents of the prescribed folded antidiagonals. -/
def northwestExponentSet {n : ℕ} (r : RankArray n) : Set (Entry n →₀ ℕ) :=
  {d | ∃ (i j : Fin n) (a b : Fin (r i j + 1) ↪o Fin n),
    (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧ d = antidiagonalExponent a b}

theorem northwestAntidiagonalIdeal_eq_span_exponents {n : ℕ}
    (R : Type*) [CommRing R] (r : RankArray n) :
    northwestAntidiagonalIdeal R r =
      Ideal.span ((fun d => monomial d (1 : R)) '' northwestExponentSet r) := by
  unfold northwestAntidiagonalIdeal
  apply congrArg Ideal.span
  ext f
  constructor
  · rintro ⟨i, j, a, b, ha, hb, rfl⟩
    exact ⟨antidiagonalExponent a b, ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩
  · rintro ⟨d, ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩
    exact ⟨i, j, a, b, ha, hb, rfl⟩

/-- Northwest ranks transpose with the matrix. -/
theorem matrixRankArray_transpose {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin n) (Fin n) K) (i j : Fin n) :
    matrixRankArray w.transpose i j = matrixRankArray w j i := by
  unfold matrixRankArray
  rw [← Matrix.transpose_submatrix, Matrix.rank_transpose]

/-- Symmetry of a matrix gives the actual symmetry hypothesis of its rank array. -/
theorem matrixRankArray_symmetric {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin n) (Fin n) K) (hw : w.transpose = w) (i j : Fin n) :
    matrixRankArray w i j = matrixRankArray w j i := by
  simpa only [hw] using matrixRankArray_transpose w i j

/-- The pivot in the first row forces strictly larger northwest rank than any
column prefix ending before it. This uses actual matrix ranks, with no rook-model
or characteristic hypothesis. -/
theorem matrixRankArray_lt_of_first_nonzero {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) K) (k : Fin (n + 1))
    (hk : w 0 k ≠ 0) (hzero : ∀ q < k, w 0 q = 0)
    (i j l : Fin (n + 1)) (hl : l < k) (hkj : k ≤ j) :
    matrixRankArray w i l < matrixRankArray w i j := by
  classical
  let Rows := {p : Fin (n + 1) // p ≤ i}
  let A : Matrix Rows {q : Fin (n + 1) // q ≤ l} K :=
    w.submatrix Subtype.val Subtype.val
  let B : Matrix Rows {q : Fin (n + 1) // q ≤ j} K :=
    w.submatrix Subtype.val Subtype.val
  change A.rank < B.rank
  rw [Matrix.rank_eq_finrank_span_cols, Matrix.rank_eq_finrank_span_cols]
  apply Submodule.finrank_lt_finrank_of_lt
  apply lt_of_le_not_ge
  · apply Submodule.span_mono
    rintro _ ⟨q, rfl⟩
    exact ⟨⟨q.val, (q.property.trans hl.le).trans hkj⟩, rfl⟩
  · intro hle
    have hcol : B.col ⟨k, hkj⟩ ∈ Submodule.span K (Set.range A.col) :=
      hle (Submodule.subset_span ⟨⟨k, hkj⟩, rfl⟩)
    have hz : ∀ v ∈ Submodule.span K (Set.range A.col),
        v (⟨0, Fin.zero_le i⟩ : Rows) = 0 := by
      intro v hv
      induction hv using Submodule.span_induction with
      | mem v hv =>
          obtain ⟨q, rfl⟩ := hv
          exact hzero q.val (q.property.trans_lt hl)
      | zero => rfl
      | add a b ha hb hza hzb => simp only [Pi.add_apply, hza, hzb, add_zero]
      | smul a b hb hzb => simp only [Pi.smul_apply, hzb, smul_zero]
    exact hk (hz _ hcol)

/-- Any northwest rectangle containing the first-row pivot has positive rank. -/
theorem matrixRankArray_pos_of_first_nonzero {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) K) (k : Fin (n + 1))
    (hk : w 0 k ≠ 0) (i j : Fin (n + 1)) (hkj : k ≤ j) :
    0 < matrixRankArray w i j := by
  classical
  let Rows := {p : Fin (n + 1) // p ≤ i}
  let B : Matrix Rows {q : Fin (n + 1) // q ≤ j} K :=
    w.submatrix Subtype.val Subtype.val
  change 0 < B.rank
  rw [Matrix.rank_eq_finrank_span_cols]
  have hs : (⊥ : Submodule K (Rows → K)) < Submodule.span K (Set.range B.col) := by
    apply bot_lt_iff_ne_bot.mpr
    intro hbot
    have hmem : B.col ⟨k, hkj⟩ ∈ Submodule.span K (Set.range B.col) :=
      Submodule.subset_span ⟨⟨k, hkj⟩, rfl⟩
    rw [hbot, Submodule.mem_bot] at hmem
    exact hk (congrFun hmem ⟨0, Fin.zero_le i⟩)
  simpa using Submodule.finrank_lt_finrank_of_lt hs

/-- A general monomial cancellation lemma. The premise is a concrete statement
about divisors of the supplied exponent family; the conclusion concerns the
ordinary ideal generated by those monomials. -/
theorem monomialIdeal_mul_X_mem_iff {σ R : Type*} [CommRing R]
    (D : Set (σ →₀ ℕ)) (v : σ)
    (hD : ∀ d ∈ D, ∀ e : σ →₀ ℕ, d ≤ e + single v 1 →
      ∃ d' ∈ D, d' ≤ e) (f : MvPolynomial σ R) :
    f * X v ∈ Ideal.span ((fun d => monomial d (1 : R)) '' D) ↔
      f ∈ Ideal.span ((fun d => monomial d (1 : R)) '' D) := by
  classical
  constructor
  · intro hf
    apply mem_ideal_span_monomial_image.mpr
    intro e he
    have he' : e + single v 1 ∈ (f * X v).support := by
      simpa only [MvPolynomial.mem_support_iff, coeff_mul_X] using he
    obtain ⟨d, hd, hde⟩ := mem_ideal_span_monomial_image.mp hf _ he'
    exact hD d hd e hde
  · exact fun hf => Ideal.mul_mem_right _ _ hf



/-- Reflect both the source and target of an increasing index embedding. -/
def reverseOrderEmbedding {s t : ℕ} (c : Fin s ↪o Fin t) : Fin s ↪o Fin t :=
  OrderEmbedding.ofStrictMono (fun p => (c p.rev).rev)
    (Fin.rev_strictAnti.comp (c.strictMono.comp_strictAnti Fin.rev_strictAnti))

@[simp] theorem reverseOrderEmbedding_apply {s t : ℕ} (c : Fin s ↪o Fin t)
    (p : Fin s) : reverseOrderEmbedding c p = (c p.rev).rev := rfl

/-- Keeping a subset of antidiagonal positions gives a genuine smaller
antidiagonal, including its folded multiplicities. -/
theorem antidiagonalExponent_subselection_le {n s t : ℕ}
    (a b : Fin t ↪o Fin n) (c : Fin s ↪o Fin t) :
    antidiagonalExponent (c.comp a) ((reverseOrderEmbedding c).comp b) ≤
      antidiagonalExponent a b := by
  classical
  intro v
  simp only [antidiagonalExponent, Finsupp.finsetSum_apply, OrderEmbedding.coe_comp,
    Function.comp_apply, reverseOrderEmbedding_apply, Fin.rev_rev]
  exact Finset.sum_le_sum_of_injOn c c.injective.injOn (Finset.subset_univ _)
    (fun _ _ => le_rfl) (fun _ _ _ => Nat.zero_le _)

/-- Transposition does not change a folded antidiagonal. -/
theorem antidiagonalExponent_swap {n t : ℕ} (a b : Fin t ↪o Fin n) :
    antidiagonalExponent b a = antidiagonalExponent a b := by
  classical
  unfold antidiagonalExponent
  rw [← Equiv.sum_comp (Fin.revPerm : Equiv.Perm (Fin t))]
  apply Finset.sum_congr rfl
  intro p _
  simp only [Fin.revPerm_apply, Fin.rev_rev, fold_comm]

/-- The antidiagonal with its first row and last column deleted. -/
theorem antidiagonalExponent_tail {n t : ℕ}
    (a b : Fin (t + 1) ↪o Fin n) :
    antidiagonalExponent a b =
      single (fold (a 0) (b (Fin.last t))) 1 +
      antidiagonalExponent ((Fin.succOrderEmb t).comp a)
        ((Fin.castLEOrderEmb (Nat.le_succ t)).comp b) := by
  classical
  unfold antidiagonalExponent
  rw [Fin.sum_univ_succ]
  congr 1
  apply Finset.sum_congr rfl
  intro p _
  congr 2
  apply congrArg b
  apply Fin.ext
  change (p.succ.rev).val = p.rev.val
  simp only [Fin.val_rev, Fin.val_succ]
  omega

/-- Existence of an antidiagonal violating a northwest bound, without fixing
its size to the least forbidden size. -/
def HasForbiddenAntidiagonal {n : ℕ} (r : RankArray n) (d : Entry n →₀ ℕ) : Prop :=
  ∃ (t : ℕ) (i j : Fin n) (a b : Fin t ↪o Fin n),
    r i j < t ∧ (∀ p, a p ≤ i) ∧ (∀ p, b p ≤ j) ∧ antidiagonalExponent a b ≤ d

theorem hasForbiddenAntidiagonal_iff_generator_le {n : ℕ}
    (r : RankArray n) (d : Entry n →₀ ℕ) :
    HasForbiddenAntidiagonal r d ↔ ∃ a ∈ northwestExponentSet r, a ≤ d := by
  constructor
  · rintro ⟨t, i, j, a, b, ht, ha, hb, hd⟩
    let c := Fin.castLEOrderEmb (Nat.succ_le_of_lt ht)
    refine ⟨antidiagonalExponent (c.comp a) ((reverseOrderEmbedding c).comp b),
      ⟨i, j, c.comp a, (reverseOrderEmbedding c).comp b, ?_, ?_, rfl⟩,
      (antidiagonalExponent_subselection_le a b c).trans hd⟩
    · exact fun p => ha (c p)
    · exact fun p => hb (reverseOrderEmbedding c p)
  · rintro ⟨a, ⟨i, j, rows, cols, hrows, hcols, rfl⟩, had⟩
    exact ⟨r i j + 1, i, j, rows, cols, Nat.lt_succ_self _, hrows, hcols, had⟩

theorem antidiagonalExponent_le_cancel_single_of_zero {n : ℕ}
    {a d : Entry n →₀ ℕ} (v : Entry n) (ha : a v = 0)
    (h : a ≤ d + single v 1) : a ≤ d := by
  classical
  intro w
  by_cases hw : w = v
  · subst w
    simp only [ha, zero_le]
  · simpa only [Finsupp.add_apply, Finsupp.single_eq_of_ne hw, add_zero] using h w

/-- In the first-row orientation, deleting a pivot occurrence leaves a
forbidden antidiagonal. The rank hypotheses are simple inequalities, not a
Gröbner or ideal-regularity assumption. -/
theorem forbidden_cancel_first_row_oriented {n t : ℕ}
    (r : RankArray (n + 1)) (k i j : Fin (n + 1))
    (hpos : ∀ i j, k ≤ j → 0 < r i j)
    (hdrop : ∀ i j l, l < k → k ≤ j → r i l < r i j)
    (a b : Fin t ↪o Fin (n + 1)) (ht : r i j < t)
    (ha : ∀ p, a p ≤ i) (hb : ∀ p, b p ≤ j)
    (p : Fin t) (hp : a p = 0) (hpk : b p.rev = k)
    (d : Entry (n + 1) →₀ ℕ)
    (hd : antidiagonalExponent a b ≤ d + single (fold 0 k) 1) :
    HasForbiddenAntidiagonal r d := by
  classical
  cases t with
  | zero => exact Fin.elim0 p
  | succ t =>
    have hp0 : p = 0 := by
      apply le_antisymm
      · apply a.le_iff_le.mp
        simpa only [hp] using (Fin.zero_le (a 0))
      · exact Fin.zero_le p
    subst p
    have hk : b (Fin.last t) = k := by simpa using hpk
    have hkj : k ≤ j := hk ▸ hb (Fin.last t)
    have htpos : 0 < t := by
      have := hpos i j hkj
      omega
    let qtop : Fin t := ⟨t - 1, by omega⟩
    let l : Fin (n + 1) := b (Fin.castLE (Nat.le_succ t) qtop)
    have hl : l < k := by
      rw [← hk]
      apply b.strictMono
      change t - 1 < t
      omega
    have hlr : r i l < t := (hdrop i j l hl hkj).trans_le (Nat.lt_succ_iff.mp ht)
    refine ⟨t, i, l, (Fin.succOrderEmb t).comp a,
      (Fin.castLEOrderEmb (Nat.le_succ t)).comp b, hlr, ?_, ?_, ?_⟩
    · exact fun q => ha q.succ
    · intro q
      apply b.monotone
      change q.val ≤ t - 1
      omega
    · rw [antidiagonalExponent_tail, hp, hk] at hd
      exact le_of_add_le_add_left
        (show single (fold 0 k) 1 +
          antidiagonalExponent ((Fin.succOrderEmb t).comp a)
            ((Fin.castLEOrderEmb (Nat.le_succ t)).comp b) ≤ single (fold 0 k) 1 + d by
          simpa only [add_comm d (single (fold 0 k) 1)] using hd)

/-- Removing a first-row pivot occurrence cannot repair a forbidden
antidiagonal, provided the rank array has the first-pivot rank inequalities. -/
theorem hasForbiddenAntidiagonal_cancel_pivot {n : ℕ}
    (r : RankArray (n + 1)) (k : Fin (n + 1))
    (hsym : ∀ i j, r i j = r j i)
    (hpos : ∀ i j, k ≤ j → 0 < r i j)
    (hdrop : ∀ i j l, l < k → k ≤ j → r i l < r i j)
    (d : Entry (n + 1) →₀ ℕ)
    (hd : HasForbiddenAntidiagonal r (d + single (fold 0 k) 1)) :
    HasForbiddenAntidiagonal r d := by
  classical
  obtain ⟨t, i, j, a, b, ht, ha, hb, hd⟩ := hd
  by_cases hz : antidiagonalExponent a b (fold 0 k) = 0
  · exact ⟨t, i, j, a, b, ht, ha, hb,
      antidiagonalExponent_le_cancel_single_of_zero (fold 0 k) hz hd⟩
  · have hpos' : 0 < antidiagonalExponent a b (fold 0 k) := Nat.pos_of_ne_zero hz
    obtain ⟨p, hp⟩ := (antidiagonalExponent_pos_iff a b (fold 0 k)).mp hpos'
    rcases ((fold_eq_iff _ _ _ _).mp hp) with ⟨hp0, hpk⟩ | ⟨hpk, hp0⟩
    · exact forbidden_cancel_first_row_oriented r k i j hpos hdrop a b ht ha hb
        p hp0 hpk d hd
    · apply forbidden_cancel_first_row_oriented r k j i hpos hdrop b a
        (by simpa only [hsym j i] using ht) hb ha p.rev hp0
        (by simpa only [Fin.rev_rev] using hpk) d
      simpa only [antidiagonalExponent_swap] using hd

/-- Lemma 4.2, monomial half: the first nonzero entry of the first row of an
actual symmetric matrix is regular modulo its folded northwest monomial ideal.
The realization field and coefficient ring are independent. -/
theorem northwestAntidiagonalIdeal_mul_pivot_mem_iff {n : ℕ}
    {F : Type*} [Field F] (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (hw : w.transpose = w) (k : Fin (n + 1))
    (hk : w 0 k ≠ 0) (hzero : ∀ q < k, w 0 q = 0)
    (R : Type*) [CommRing R] (f : CoordinateRing (n + 1) R) :
    f * X (fold 0 k) ∈ northwestAntidiagonalIdeal R (matrixRankArray w) ↔
      f ∈ northwestAntidiagonalIdeal R (matrixRankArray w) := by
  rw [northwestAntidiagonalIdeal_eq_span_exponents]
  apply monomialIdeal_mul_X_mem_iff
  intro a ha d had
  apply (hasForbiddenAntidiagonal_iff_generator_le _ d).mp
  apply hasForbiddenAntidiagonal_cancel_pivot (matrixRankArray w) k
    (matrixRankArray_symmetric w hw)
    (matrixRankArray_pos_of_first_nonzero w k hk)
    (matrixRankArray_lt_of_first_nonzero w k hk hzero)
  exact (hasForbiddenAntidiagonal_iff_generator_le _ _).mpr ⟨a, ha, had⟩

/-- The colon ideal formulation of the unconditional monomial regular-pivot
lemma. No Gröbner assertion is required for this conclusion. -/
theorem northwestAntidiagonalIdeal_colon_pivot {n : ℕ}
    {F : Type*} [Field F] (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (hw : w.transpose = w) (k : Fin (n + 1))
    (hk : w 0 k ≠ 0) (hzero : ∀ q < k, w 0 q = 0)
    (R : Type*) [CommRing R] :
    (northwestAntidiagonalIdeal R (matrixRankArray w)).colon
      (↑(Ideal.span {(X (fold 0 k) : CoordinateRing (n + 1) R)}) :
        Set (CoordinateRing (n + 1) R)) = northwestAntidiagonalIdeal R (matrixRankArray w) := by
  ext f
  rw [Ideal.mem_colon_span_singleton]
  exact northwestAntidiagonalIdeal_mul_pivot_mem_iff w hw k hk hzero R f


end FourPapers.Symmetric

namespace MonomialOrder
open MvPolynomial

/-- Regularity of a variable in the initial ideal transfers to the ideal.
The Gröbner basis is a supplied, already proved input to this general lemma. -/
theorem IsGroebnerBasis.mul_X_mem_iff_of_initial {σ R : Type*}
    [CommRing R] [NoZeroDivisors R]
    (m : MonomialOrder σ) {G : Set (MvPolynomial σ R)}
    {I : Ideal (MvPolynomial σ R)} (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g)) (v : σ)
    (hreg : ∀ f : MvPolynomial σ R,
      f * X v ∈ Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ R))) →
      f ∈ Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ R))))
    (f : MvPolynomial σ R) : f * X v ∈ I ↔ f ∈ I := by
  classical
  constructor
  · intro hf
    obtain ⟨r, hr⟩ := MonomialOrder.exists_isRemainder (m := m) hu f
    have hfr : f - r ∈ I := Ideal.span_le.mpr hG.subset hr.sub_mem_span
    have hrx : r * X v ∈ I := by
      have h := I.sub_mem hf (I.mul_mem_right (X v) hfr)
      convert h using 1 <;> ring
    have hr0 : r = 0 := by
      by_contra hne
      have hlt : m.leadingTerm r * X v ∈
          Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ R))) := by
        have h : m.leadingTerm (r * X v) ∈
            Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ R))) :=
          Ideal.subset_span ⟨r * X v, hrx, rfl⟩
        simpa only [m.leadingTerm_mul, m.leadingTerm_X] using h
      have hlt' := hreg (m.leadingTerm r) hlt
      have hs : m.degree r ∈ (m.leadingTerm r).support := by
        rw [m.support_leadingTerm' hne]
        exact Finset.mem_singleton_self _
      obtain ⟨q, hq, hq0, hqr⟩ := MonomialOrder.exists_degree_le_of_mem_span_leadingTerm (m := m) hlt' hs
      exact hG.not_degree_le_of_isRemainder hr (m.degree_mem_support hne) hq hq0 hqr
    exact (hG.remainder_eq_zero_iff_mem hr).mp hr0
  · exact fun hf => I.mul_mem_right (X v) hf

end MonomialOrder

namespace FourPapers.Symmetric
open MvPolynomial

/-- The literal initial-ideal equality associated to a proved northwest basis. -/
theorem northwest_initial_eq_of_groebner {n : ℕ} (K : Type*) [CommRing K]
    (r : RankArray n)
    (hG : (foldedOrder n).IsGroebnerBasis (northwestGenerators K r) (northwestIdeal K r)) :
    initialIdeal K (northwestIdeal K r) = northwestAntidiagonalIdeal K r := by
  apply le_antisymm
  · unfold initialIdeal
    rw [hG.span_leadingTerm_image]
    apply Ideal.span_le.mpr
    rintro _ ⟨g, ⟨i, j, a, b, ha, hb, rfl⟩, rfl⟩
    rw [minor_leadingTerm]
    change monomial (antidiagonalExponent a b)
      (signCoefficient K (Fin.revPerm : Equiv.Perm (Fin (r i j + 1)))) ∈
        northwestAntidiagonalIdeal K r
    have h := (northwestAntidiagonalIdeal K r).mul_mem_left
      (C (signCoefficient K (Fin.revPerm : Equiv.Perm (Fin (r i j + 1)))))
      (Ideal.subset_span ⟨i, j, a, b, ha, hb, rfl⟩)
    simpa only [antidiagonal, C_mul_monomial, mul_one] using h
  · exact northwestAntidiagonalIdeal_le_initial K r

/-- Lemma 4.2, ideal half, once the separately stated northwest Gröbner theorem
has been established. All matrix and pivot hypotheses retain their literal meaning. -/
theorem northwestIdeal_mul_pivot_mem_iff_of_groebner {n : ℕ}
    {F : Type*} [Field F] (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (hw : w.transpose = w) (k : Fin (n + 1))
    (hk : w 0 k ≠ 0) (hzero : ∀ q < k, w 0 q = 0)
    (K : Type*) [CommRing K] [NoZeroDivisors K]
    (hG : (foldedOrder (n + 1)).IsGroebnerBasis
      (northwestGenerators K (matrixRankArray w)) (northwestIdeal K (matrixRankArray w)))
    (f : CoordinateRing (n + 1) K) :
    f * X (fold 0 k) ∈ northwestIdeal K (matrixRankArray w) ↔
      f ∈ northwestIdeal K (matrixRankArray w) := by
  have hinit := northwest_initial_eq_of_groebner K (matrixRankArray w) hG
  apply MonomialOrder.IsGroebnerBasis.mul_X_mem_iff_of_initial (foldedOrder (n + 1)) hG
  · rintro g ⟨i, j, a, b, ha, hb, rfl⟩ _
    exact minor_leadingCoeff_isUnit K a b
  · intro g hg
    change g * X (fold 0 k) ∈ initialIdeal K (northwestIdeal K (matrixRankArray w)) at hg
    change g ∈ initialIdeal K (northwestIdeal K (matrixRankArray w))
    rw [hinit] at hg ⊢
    exact (northwestAntidiagonalIdeal_mul_pivot_mem_iff w hw k hk hzero K g).mp hg

end FourPapers.Symmetric
