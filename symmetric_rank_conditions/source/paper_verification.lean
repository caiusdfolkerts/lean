/-! ## Actual homogeneous quotient bases and the Hilbert comparison -/

example {σ : Type algebra_audit_var} {R : Type algebra_audit_coeff}
    {D : Type algebra_audit_degree} [CommRing R] [AddCommMonoid D] [DecidableEq D]
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (w : σ → D)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w)) (d : D) :
    restrictSupport R {e : σ →₀ ℕ | e ∈ m.standardMonomials I ∧ Finsupp.weight w e = d}
      ≃ₗ[R] (weightedHomogeneousSubmodule R w d).map (Ideal.Quotient.mkₐ R I).toLinearMap :=
  Pivot.standardPieceEquiv m I G hG hu w hI d

example {σ : Type algebra_audit_var} {R : Type algebra_audit_coeff}
    {D : Type algebra_audit_degree} [CommRing R] [AddCommMonoid D] [DecidableEq D]
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ R))
    (G : Set (MvPolynomial σ R)) (hG : m.IsGroebnerBasis G I)
    (hu : ∀ g ∈ G, g ≠ 0 → IsUnit (m.leadingCoeff g))
    (w : σ → D)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R w)) (d : D) :
    Module.Basis {e : σ →₀ ℕ // e ∈ m.standardMonomials I ∧ Finsupp.weight w e = d}
      R ((weightedHomogeneousSubmodule R w d).map (Ideal.Quotient.mkₐ R I).toLinearMap) :=
  Pivot.standardPieceBasis m I G hG hu w hI d

example {σ : Type algebra_audit_var} {K : Type algebra_audit_coeff}
    {D : Type algebra_audit_degree} [Field K] [AddCommMonoid D] [DecidableEq D]
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ K))
    (G : Set (MvPolynomial σ K)) (hGI : G ⊆ I) (w : σ → D)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule K w))
    (hw : ∀ d, {e : σ →₀ ℕ | Finsupp.weight w e = d}.Finite)
    (hHilbert : ∀ d,
      {e : σ →₀ ℕ | (∀ g ∈ G, g ≠ 0 → ¬m.degree g ≤ e) ∧ Finsupp.weight w e = d}.ncard =
        Module.finrank K (Pivot.quotientPiece I w d)) :
    m.IsGroebnerBasis G I :=
  Pivot.isGroebnerBasis_of_hilbertFunction m I G hGI w hI hw hHilbert

example {n : ℕ} {K : Type algebra_audit_coeff} [Field K]
    (m : MonomialOrder (Option (PivotVariables n)))
    (m' : MonomialOrder (PivotVariables n))
    (H : Ideal (MvPolynomial (Option (PivotVariables n)) K))
    (G : Set (MvPolynomial (Option (PivotVariables n)) K)) (hGH : G ⊆ H)
    (hfree : ∀ g ∈ G, g ≠ 0 → m.degree g none = 0)
    (hdegree : ∀ g ∈ G, g ≠ 0 →
      m'.degree (Pivot.genericPivotMap g) = (m.degree g).some)
    (hH : H.IsHomogeneous
      (weightedHomogeneousSubmodule K (fun o => o.elim 0 pivotEndpointWeight)))
    (hHilbert : ∀ d,
      {e : PivotVariables n →₀ ℕ |
        e ∈ m'.standardMonomials (Pivot.pivotLeadingIdeal m G) ∧
          Finsupp.weight pivotEndpointWeight e = d}.ncard =
        Module.finrank (RatFunc K)
          (Pivot.quotientPiece (H.map Pivot.genericPivotMap) pivotEndpointWeight d)) :
    m.IsGroebnerBasis G H :=
  Pivot.lemma_3_3_symmetric m m' H G hGH hfree hdegree hH hHilbert

example {n : ℕ} {K : Type algebra_audit_coeff} [Field K]
    (H : Ideal (CoordinateRing (n+1) K))
    (I : Ideal (CoordinateRing n (RatFunc K)))
    (hchart : H.map (Pivot.genericFirstPivotChart (n := n) K) =
      I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom)
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule (RatFunc K) endpointWeight))
    (d : Fin n →₀ ℕ) :
    Module.finrank (RatFunc K)
        (Pivot.quotientPiece
          ((H.map Pivot.pivotCoordinateEquiv.toRingHom).map Pivot.genericPivotMap)
          pivotEndpointWeight d) =
      {p : (Fin n →₀ ℕ) × (Entry n →₀ ℕ) |
        p.2 ∈ (foldedOrder n).standardMonomials I ∧
          p.1 + Finsupp.weight endpointWeight p.2 = d}.ncard :=
  Pivot.finrank_genericPivot_quotient_eq_carriers H I hchart hI d

