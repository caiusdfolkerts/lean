noncomputable section

namespace FourPapers.Symmetric
open Finset

/-- A lower triangular row operation on a northwest prefix uses only rows
already in that prefix. -/
theorem northwestPrefixMatrix_mul_lower {n : ℕ} {R : Type*} [CommRing R]
    (L M : Matrix (Fin n) (Fin n) R) (hL : L.IsLowerTriangular) (i j : Fin n) :
    northwestPrefixMatrix (L * M) i j =
      northwestPrefixMatrix L i i * northwestPrefixMatrix M i j := by
  classical
  ext p q
  simp only [northwestPrefixMatrix_apply, Matrix.mul_apply]
  symm
  let f : Fin n → R := fun k =>
    L (northwestPrefixEmbedding i p) k * M k (northwestPrefixEmbedding j q)
  change (∑ k : Fin (i.val + 1), f (northwestPrefixEmbedding i k)) = ∑ k : Fin n, f k
  rw [← Finset.sum_image (f := f) (northwestPrefixEmbedding i).injective.injOn]
  apply Finset.sum_subset (Finset.subset_univ _)
  intro k _ hk
  have hki : i < k := by
    by_contra h
    have hle : k ≤ i := le_of_not_gt h
    exact hk (Finset.mem_image.mpr
      ⟨⟨k.val, Nat.lt_succ_iff.mpr hle⟩, Finset.mem_univ _, rfl⟩)
  have hp : northwestPrefixEmbedding i p ≤ i := Nat.lt_succ_iff.mp p.isLt
  dsimp only [f]
  have hz : L (northwestPrefixEmbedding i p) k = 0 :=
    hL (by change northwestPrefixEmbedding i p < k; exact hp.trans_lt hki)
  rw [hz, zero_mul]

/-- A transposed lower triangular column operation uses only columns already
in the northwest prefix. -/
theorem northwestPrefixMatrix_mul_transpose_lower {n : ℕ} {R : Type*} [CommRing R]
    (M L : Matrix (Fin n) (Fin n) R) (hL : L.IsLowerTriangular) (i j : Fin n) :
    northwestPrefixMatrix (M * L.transpose) i j =
      northwestPrefixMatrix M i j * (northwestPrefixMatrix L j j).transpose := by
  have h := congrArg Matrix.transpose (northwestPrefixMatrix_mul_lower L M.transpose hL j i)
  simpa only [northwestPrefixMatrix, Matrix.transpose_submatrix, Matrix.transpose_mul,
    Matrix.transpose_transpose] using h

/-- An invertible lower triangular congruence restricts to invertible row and
column operations on each northwest rectangle. -/
theorem northwestPrefixMatrix_lower_congruence {n : ℕ} {R : Type*} [CommRing R]
    (L M : Matrix (Fin n) (Fin n) R) (hL : L.IsLowerTriangular) (i j : Fin n) :
    northwestPrefixMatrix (L * M * L.transpose) i j =
      northwestPrefixMatrix L i i * northwestPrefixMatrix M i j *
        (northwestPrefixMatrix L j j).transpose := by
  rw [northwestPrefixMatrix_mul_transpose_lower _ L hL,
    northwestPrefixMatrix_mul_lower L M hL]

/-- A principal prefix of a lower triangular matrix with unit diagonal is a
unit matrix over the same coefficient ring. -/
theorem northwestPrefix_isUnit_of_lower {n : ℕ} {R : Type*} [CommRing R]
    (L : Matrix (Fin n) (Fin n) R) (hL : L.IsLowerTriangular)
    (hdiag : ∀ i, IsUnit (L i i)) (i : Fin n) :
    IsUnit (northwestPrefixMatrix L i i) := by
  classical
  apply (Matrix.isUnit_iff_isUnit_det _).mpr
  rw [Matrix.det_of_isLowerTriangular]
  · apply IsUnit.prod_univ_iff.mpr
    intro p
    exact hdiag (northwestPrefixEmbedding i p)
  · intro p q hpq
    exact hL ((northwestPrefixEmbedding i).strictMono hpq)

/-- Every northwest minor ideal is preserved by an actual lower triangular
congruence with unit diagonal. -/
theorem northwestPrefix_minorIdeal_lower_congruence {n : ℕ} {R : Type*} [CommRing R]
    (L M : Matrix (Fin n) (Fin n) R) (hL : L.IsLowerTriangular)
    (hdiag : ∀ i, IsUnit (L i i)) (i j : Fin n) (t : ℕ) :
    matrixMinorIdeal (northwestPrefixMatrix (L * M * L.transpose) i j) t =
      matrixMinorIdeal (northwestPrefixMatrix M i j) t := by
  rw [northwestPrefixMatrix_lower_congruence L M hL]
  apply matrixMinorIdeal_mul_mul_of_isUnit
  · exact northwestPrefix_isUnit_of_lower L hL hdiag i
  · apply (Matrix.isUnit_iff_isUnit_det _).mpr
    rw [Matrix.det_transpose]
    exact (Matrix.isUnit_iff_isUnit_det _).mp
      (northwestPrefix_isUnit_of_lower L hL hdiag j)

/-- Consequently the entire northwest ideal is preserved, for every array of
bounds, including arbitrary inconsistent arrays. -/
theorem northwestMatrixIdeal_lower_congruence {n : ℕ} {R : Type*} [CommRing R]
    (L M : Matrix (Fin n) (Fin n) R) (hL : L.IsLowerTriangular)
    (hdiag : ∀ i, IsUnit (L i i)) (r : RankArray n) :
    northwestMatrixIdeal (L * M * L.transpose) r = northwestMatrixIdeal M r := by
  unfold northwestMatrixIdeal
  congr 1
  funext i
  congr 1
  funext j
  exact northwestPrefix_minorIdeal_lower_congruence L M hL hdiag i j (r i j + 1)

/-- The same congruence preserves the actual matrix rank profile. -/
theorem matrixRankArray_lower_congruence {n : ℕ} {K : Type*} [Field K]
    (L w : Matrix (Fin n) (Fin n) K) (hL : L.IsLowerTriangular)
    (hdiag : ∀ i, IsUnit (L i i)) :
    matrixRankArray (L * w * L.transpose) = matrixRankArray w := by
  funext i j
  rw [← northwestPrefixMatrix_rank, ← northwestPrefixMatrix_rank,
    northwestPrefixMatrix_lower_congruence L w hL]
  apply matrixRank_mul_mul_of_isUnit
  · exact northwestPrefix_isUnit_of_lower L hL hdiag i
  · apply (Matrix.isUnit_iff_isUnit_det _).mpr
    rw [Matrix.det_transpose]
    exact (Matrix.isUnit_iff_isUnit_det _).mp
      (northwestPrefix_isUnit_of_lower L hL hdiag j)

end FourPapers.Symmetric
end
end
