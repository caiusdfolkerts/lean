namespace FourPapers.Symmetric
open MvPolynomial

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The genuine Laurent coefficient ring in the diagonal chart. -/
abbrev DiagonalLaurentRing (R : Type*) [CommRing R] :=
  Localization.Away (Polynomial.X : Polynomial R)

def diagonalLaurentInverse (R : Type*) [CommRing R] : DiagonalLaurentRing R :=
  IsLocalization.Away.invSelf (Polynomial.X : Polynomial R)

theorem diagonalLaurentInverse_mul (R : Type*) [CommRing R] :
    diagonalLaurentInverse R *
      algebraMap (Polynomial R) (DiagonalLaurentRing R) Polynomial.X = 1 := by
  rw [mul_comm]
  exact IsLocalization.Away.mul_invSelf _

/-- The diagonal Schur map using an actual localization at the single pivot. -/
def diagonalLaurentChartMap {n : ℕ} (R : Type*) [CommRing R] :
    CoordinateRing (n + 1) R →+* MvPolynomial (PivotVariables n) (DiagonalLaurentRing R) :=
  Pivot.firstPivotChartMap (algebraMap (Polynomial R) (DiagonalLaurentRing R))
    (diagonalLaurentInverse R)

/-- Regularity and primeness of the genuine diagonal chart imply primeness of
the original ideal. This general lemma makes no determinantal assumption. -/
theorem ideal_isPrime_of_diagonalLaurentChart {n : ℕ} {R : Type*} [CommRing R]
    (I : Ideal (CoordinateRing (n + 1) R))
    (hreg : ∀ f, f * X (fold 0 0) ∈ I → f ∈ I)
    (hchart : (I.map (diagonalLaurentChartMap (n := n) R)).IsPrime) : I.IsPrime := by
  let S := DiagonalLaurentRing R
  let A := MvPolynomial (PivotVariables n) (Polynomial R)
  let B := MvPolynomial (PivotVariables n) S
  let e : CoordinateRing (n + 1) R ≃+* A :=
    (Pivot.pivotCoordinateEquiv.trans (optionEquivRight R (PivotVariables n))).toRingEquiv
  let d : B ≃+* B := (schurCoordinateEquiv (diagonalLaurentInverse R)).symm.toRingEquiv
  have he : e (X (fold 0 0)) = (C (Polynomial.X : Polynomial R) : A) := by
    change optionEquivRight R (PivotVariables n)
      (Pivot.pivotCoordinateEquiv (X (fold 0 0))) = C (Polynomial.X : Polynomial R)
    rw [Pivot.pivotCoordinateEquiv_pivot, optionEquivRight_X_none]
  letI : IsLocalization.Away (C (Polynomial.X : Polynomial R) : A) B := by
    change IsLocalization (Submonoid.powers (C (Polynomial.X : Polynomial R) : A)) B
    rw [← Submonoid.map_powers (C : Polynomial R →+* A)]
    exact Pivot.polynomial_isLocalization (Submonoid.powers (Polynomial.X : Polynomial R)) S
  letI : IsLocalization.Away (e (X (fold 0 0))) B := by rw [he]; infer_instance
  have hfactor : d.toRingHom.comp ((algebraMap A B).comp e.toRingHom) =
      diagonalLaurentChartMap (n := n) R := by
    rw [MvPolynomial.algebraMap_def]
    rfl
  have hp : (((I.map e.toRingHom).map (algebraMap A B)).map d.toRingHom).IsPrime := by
    rw [Ideal.map_map, Ideal.map_map]
    change (I.map (d.toRingHom.comp ((algebraMap A B).comp e.toRingHom))).IsPrime
    rw [hfactor]
    exact hchart
  exact ideal_isPrime_of_away_chart I (X (fold 0 0)) e d hreg hp

/-- The precise diagonal branch of the primeness induction. The smaller prime
is taken over the genuine Laurent coefficient ring; this keeps the only required
saturation equal to the already proved cancellation of powers of the pivot. -/
theorem northwestIdeal_isPrime_of_diagonal {n : ℕ} {F R : Type*}
    [Field F] [CommRing R] [IsDomain R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F) (hw : w.transpose = w)
    (hw00 : w 0 0 ≠ 0)
    (hG : (foldedOrder (n + 1)).IsGroebnerBasis
      (northwestGenerators R (matrixRankArray w)) (northwestIdeal R (matrixRankArray w)))
    (hsmall : (northwestIdeal (Localization.Away (Polynomial.X : Polynomial R))
      (matrixRankArray (firstSchurMatrix w (w 0 0)⁻¹))).IsPrime) :
    (northwestIdeal R (matrixRankArray w)).IsPrime := by
  let S := Localization.Away (Polynomial.X : Polynomial R)
  let A := MvPolynomial (PivotVariables n) (Polynomial R)
  let B := MvPolynomial (PivotVariables n) S
  let I := northwestIdeal R (matrixRankArray w)
  let x : CoordinateRing (n + 1) R := X (fold 0 0)
  let φ : Polynomial R →+* S := algebraMap (Polynomial R) S
  let q : S := IsLocalization.Away.invSelf (Polynomial.X : Polynomial R)
  let e : CoordinateRing (n + 1) R ≃+* A :=
    (Pivot.pivotCoordinateEquiv.trans (optionEquivRight R (PivotVariables n))).toRingEquiv
  let d : B ≃+* B := (schurCoordinateEquiv q).symm.toRingEquiv
  have hqx : q * φ Polynomial.X = 1 := by
    dsimp [q, φ]
    rw [mul_comm]
    exact IsLocalization.Away.mul_invSelf _
  have he : e x = (C (Polynomial.X : Polynomial R) : A) := by
    change optionEquivRight R (PivotVariables n)
      (Pivot.pivotCoordinateEquiv (X (fold 0 0))) = C (Polynomial.X : Polynomial R)
    rw [Pivot.pivotCoordinateEquiv_pivot, optionEquivRight_X_none]
  letI : IsLocalization.Away (C (Polynomial.X : Polynomial R) : A) B := by
    change IsLocalization (Submonoid.powers (C (Polynomial.X : Polynomial R) : A)) B
    rw [← Submonoid.map_powers (C : Polynomial R →+* A)]
    exact Pivot.polynomial_isLocalization (Submonoid.powers (Polynomial.X : Polynomial R)) S
  letI : IsLocalization.Away (e x) B := by rw [he]; infer_instance
  have hreg : ∀ f, f * x ∈ I → f ∈ I := by
    intro f hf
    exact (northwestIdeal_mul_pivot_mem_iff_of_groebner w hw 0 hw00
      (fun j hj => (not_lt_of_ge (Fin.zero_le j) hj).elim) R hG f).mp hf
  have hfactor : d.toRingHom.comp ((algebraMap A B).comp e.toRingHom) =
      Pivot.firstPivotChartMap (n := n) φ q := by
    rw [MvPolynomial.algebraMap_def]
    rfl
  have hpos : ∀ i j, 0 < matrixRankArray w i j := by
    intro i j
    exact matrixRankArray_pos_of_first_nonzero w 0 hw00 i j (Fin.zero_le j)
  have hr : Pivot.residualRankArray (matrixRankArray w) =
      matrixRankArray (firstSchurMatrix w (w 0 0)⁻¹) := by
    funext i j
    unfold Pivot.residualRankArray
    rw [matrixRankArray_firstSchur w hw00]
    omega
  have hchart : (((I.map e.toRingHom).map (algebraMap A B)).map d.toRingHom).IsPrime := by
    rw [Ideal.map_map, Ideal.map_map]
    change (I.map (d.toRingHom.comp ((algebraMap A B).comp e.toRingHom))).IsPrime
    rw [hfactor]
    dsimp [I]
    rw [Pivot.northwestIdeal_map_firstPivotChart φ q hqx (matrixRankArray w) hpos, hr]
    letI := hsmall
    exact Pivot.map_rename_inr_isPrime _
  exact ideal_isPrime_of_away_chart I x e d hreg hchart

/-- The Laurent coefficient ring used by the diagonal branch is an integral
domain whenever the original coefficient ring is. -/
theorem diagonalLaurent_isDomain (R : Type*) [CommRing R] [IsDomain R] :
    IsDomain (Localization.Away (Polynomial.X : Polynomial R)) :=
  Localization.Away.isDomain Polynomial.X_ne_zero

end FourPapers.Symmetric
end
