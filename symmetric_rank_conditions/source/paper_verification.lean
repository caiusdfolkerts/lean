namespace FourPapers.Symmetric

/-- Split a finite ordinal into its first index and the remaining indices. -/
def firstIndexEquiv (n : ℕ) : PUnit.{1} ⊕ Fin n ≃ Fin (n + 1) :=
  ((Equiv.sumComm PUnit.{1} (Fin n)).trans
    (Equiv.optionEquivSumPUnit (Fin n)).symm).trans (finSuccEquiv n).symm

@[simp] theorem firstIndexEquiv_left (n : ℕ) (p : PUnit.{1}) :
    firstIndexEquiv n (.inl p) = 0 := by
  cases p
  simp [firstIndexEquiv]

@[simp] theorem firstIndexEquiv_right {n : ℕ} (i : Fin n) :
    firstIndexEquiv n (.inr i) = i.succ := by
  simp [firstIndexEquiv]

/-- The literal Schur complement of the first entry of a rectangular matrix,
with an explicitly supplied inverse. -/
def firstSchurMatrix {m n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin (m + 1)) (Fin (n + 1)) R) (q : R) :
    Matrix (Fin m) (Fin n) R :=
  Matrix.of (fun i j => M i.succ j.succ - M i.succ 0 * q * M 0 j.succ)

/-- Schur rank reduction at a nonzero first entry. -/
theorem matrixRank_firstSchur {m n : ℕ} {K : Type*} [Field K]
    (M : Matrix (Fin (m + 1)) (Fin (n + 1)) K) (hM : M 0 0 ≠ 0) :
    M.rank = (firstSchurMatrix M (M 0 0)⁻¹).rank + 1 := by
  classical
  let A : Matrix PUnit.{1} PUnit.{1} K := Matrix.of (fun _ _ => M 0 0)
  let B : Matrix PUnit.{1} (Fin n) K := Matrix.of (fun _ j => M 0 j.succ)
  let C : Matrix (Fin m) PUnit.{1} K := Matrix.of (fun i _ => M i.succ 0)
  let D : Matrix (Fin m) (Fin n) K := Matrix.of (fun i j => M i.succ j.succ)
  letI : Invertible A :=
    { invOf := Matrix.of (fun _ _ => (M 0 0)⁻¹)
      invOf_mul_self := by
        ext i j
        simp [A, Matrix.mul_apply, hM]
      mul_invOf_self := by
        ext i j
        simp [A, Matrix.mul_apply, hM] }
  have hs : M.submatrix (firstIndexEquiv m) (firstIndexEquiv n) =
      Matrix.fromBlocks A B C D := by
    ext i j
    cases i <;> cases j <;> simp [Matrix.submatrix_apply, A, B, C, D]
  have hc : D - C * ⅟A * B = firstSchurMatrix M (M 0 0)⁻¹ := by
    ext i j
    simp [A, B, C, D, firstSchurMatrix, Matrix.mul_apply]
  rw [← Matrix.rank_submatrix M (firstIndexEquiv m) (firstIndexEquiv n), hs,
    matrixRank_schur, hc]
  simp

/-- The corresponding ideal identity over an arbitrary coefficient ring,
assuming only an actual multiplicative inverse of the pivot. -/
theorem matrixMinorIdeal_firstSchur {m n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin (m + 1)) (Fin (n + 1)) R) (q : R)
    (hq : q * M 0 0 = 1) (t : ℕ) :
    matrixMinorIdeal M (t + 1) = matrixMinorIdeal (firstSchurMatrix M q) t := by
  classical
  let A : Matrix PUnit.{1} PUnit.{1} R := Matrix.of (fun _ _ => M 0 0)
  let B : Matrix PUnit.{1} (Fin n) R := Matrix.of (fun _ j => M 0 j.succ)
  let C : Matrix (Fin m) PUnit.{1} R := Matrix.of (fun i _ => M i.succ 0)
  let D : Matrix (Fin m) (Fin n) R := Matrix.of (fun i j => M i.succ j.succ)
  letI : Invertible A :=
    { invOf := Matrix.of (fun _ _ => q)
      invOf_mul_self := by
        ext i j
        simp [A, Matrix.mul_apply, hq]
      mul_invOf_self := by
        ext i j
        simp [A, Matrix.mul_apply, mul_comm (M 0 0) q, hq] }
  have hs : M.submatrix (firstIndexEquiv m) (firstIndexEquiv n) =
      Matrix.fromBlocks A B C D := by
    ext i j
    cases i <;> cases j <;> simp [Matrix.submatrix_apply, A, B, C, D]
  have hc : D - C * ⅟A * B = firstSchurMatrix M q := by
    have hAinv : (⅟A : Matrix PUnit.{1} PUnit.{1} R) =
        Matrix.of (fun _ _ => q) := rfl
    rw [hAinv]
    ext i j
    simp [A, B, C, D, firstSchurMatrix, Matrix.mul_apply]
  rw [← matrixMinorIdeal_submatrix_equiv M (firstIndexEquiv m) (firstIndexEquiv n) t.succ, hs]
  simpa only [Fintype.card_unique, hc] using matrixMinorIdeal_schur A B C D t

/-- The first Schur complement of a symmetric matrix is symmetric in every
characteristic. -/
theorem firstSchurMatrix_symmetric {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (hw : w.transpose = w) (q : R) :
    (firstSchurMatrix w q).transpose = firstSchurMatrix w q := by
  have he : ∀ i j, w j i = w i j := fun i j => congrFun (congrFun hw i) j
  ext i j
  change w j.succ i.succ - w j.succ 0 * q * w 0 i.succ =
    w i.succ j.succ - w i.succ 0 * q * w 0 j.succ
  rw [he i.succ j.succ, he 0 j.succ, he i.succ 0]
  ring

/-- Prefixes commute with deleting the first row and column and taking their
Schur complement. -/
theorem firstSchur_northwestPrefix {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (q : R) (i j : Fin n) :
    firstSchurMatrix (northwestPrefixMatrix w i.succ j.succ) q =
      northwestPrefixMatrix (firstSchurMatrix w q) i j := by
  ext a b
  rfl

/-- Exact rank recurrence for every northwest rectangle containing the first
row and column, for the actual realizing matrix. -/
theorem matrixRankArray_firstSchur {n : ℕ} {K : Type*} [Field K]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) K) (hw : w 0 0 ≠ 0)
    (i j : Fin n) :
    matrixRankArray w i.succ j.succ =
      matrixRankArray (firstSchurMatrix w (w 0 0)⁻¹) i j + 1 := by
  rw [← northwestPrefixMatrix_rank, ← northwestPrefixMatrix_rank]
  have h := matrixRank_firstSchur (northwestPrefixMatrix w i.succ j.succ) hw
  have hpivot : northwestPrefixMatrix w i.succ j.succ 0 0 = w 0 0 := rfl
  simpa only [hpivot, firstSchur_northwestPrefix] using h

/-- All northwest minor conditions on a matrix over an arbitrary ring. -/
def northwestMatrixIdeal {n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin n) (Fin n) R) (r : RankArray n) : Ideal R :=
  ⨆ i : Fin n, ⨆ j : Fin n,
    matrixMinorIdeal (northwestPrefixMatrix M i j) (r i j + 1)

theorem map_northwestIdeal_eq_matrixIdeal {n : ℕ} {R S : Type*}
    [CommRing R] [CommRing S] (φ : CoordinateRing n R →+* S) (r : RankArray n) :
    (northwestIdeal R r).map φ =
      northwestMatrixIdeal ((genericMatrix n R).map φ) r := by
  rw [map_northwestIdeal_eq_iSup_prefixMinorIdeals]
  rfl

/-- A minor larger than its row index set is identically zero. -/
theorem matrixMinorIdeal_eq_bot_of_rows_lt {a b : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin a) (Fin b) R) (t : ℕ) (ht : a < t) :
    matrixMinorIdeal M t = ⊥ := by
  rw [matrixMinorIdeal_eq_ordered]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨u, v, rfl⟩
    have hu := Fintype.card_le_of_injective u u.injective
    simp only [Fintype.card_fin] at hu
    omega
  · exact bot_le

/-- The analogous statement for too few columns. -/
theorem matrixMinorIdeal_eq_bot_of_cols_lt {a b : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin a) (Fin b) R) (t : ℕ) (ht : b < t) :
    matrixMinorIdeal M t = ⊥ := by
  rw [← matrixMinorIdeal_transpose]
  exact matrixMinorIdeal_eq_bot_of_rows_lt M.transpose t ht

/-- Every positive northwest rank bound drops by one in a diagonal Schur
chart. The statement concerns the actual ideals of actual matrix entries. -/
theorem northwestMatrixIdeal_firstSchur {n : ℕ} {R : Type*} [CommRing R]
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (q : R) (hq : q * M 0 0 = 1)
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j) :
    northwestMatrixIdeal M r =
      northwestMatrixIdeal (firstSchurMatrix M q)
        (fun i j => r i.succ j.succ - 1) := by
  have hchart (i j : Fin n) :
      matrixMinorIdeal (northwestPrefixMatrix M i.succ j.succ)
        (r i.succ j.succ + 1) =
      matrixMinorIdeal (northwestPrefixMatrix (firstSchurMatrix M q) i j)
        (r i.succ j.succ - 1 + 1) := by
    have hr : r i.succ j.succ - 1 + 1 = r i.succ j.succ :=
      Nat.sub_add_cancel (hpos i.succ j.succ)
    have h := matrixMinorIdeal_firstSchur
      (northwestPrefixMatrix M i.succ j.succ) q hq (r i.succ j.succ - 1 + 1)
    simpa only [hr, firstSchur_northwestPrefix] using h
  apply le_antisymm
  · apply iSup_le
    intro i
    apply iSup_le
    intro j
    refine Fin.cases ?_ (fun i => ?_) i
    · rw [matrixMinorIdeal_eq_bot_of_rows_lt _ _ (by
        change 1 < r 0 j + 1
        have := hpos 0 j
        omega)]
      exact bot_le
    · refine Fin.cases ?_ (fun j => ?_) j
      · rw [matrixMinorIdeal_eq_bot_of_cols_lt _ _ (by
          change 1 < r i.succ 0 + 1
          have := hpos i.succ 0
          omega)]
        exact bot_le
      · rw [hchart]
        exact le_iSup_of_le i (le_iSup_of_le j le_rfl)
  · apply iSup_le
    intro i
    apply iSup_le
    intro j
    rw [← hchart]
    exact le_iSup_of_le i.succ (le_iSup_of_le j.succ le_rfl)

/-- The exact ideal identity after any genuine diagonal pivot map. In
particular this applies to the rational-function field map used in the paper. -/
theorem map_northwestIdeal_firstSchur {n : ℕ} {R S : Type*}
    [CommRing R] [CommRing S] (φ : CoordinateRing (n + 1) R →+* S)
    (q : S) (hq : q * φ (MvPolynomial.X (fold 0 0)) = 1)
    (r : RankArray (n + 1)) (hpos : ∀ i j, 0 < r i j) :
    (northwestIdeal R r).map φ =
      northwestMatrixIdeal (firstSchurMatrix ((genericMatrix (n + 1) R).map φ) q)
        (fun i j => r i.succ j.succ - 1) := by
  rw [map_northwestIdeal_eq_matrixIdeal]
  exact northwestMatrixIdeal_firstSchur _ q hq r hpos

end FourPapers.Symmetric
end
