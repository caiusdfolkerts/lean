      ∀ (K : Type algebra_audit_coeff) [Field K] [IsAlgClosed K],
        vanishingIdeal K (rankBoundLocus K (matrixRankArray w)) =
          northwestIdeal K (matrixRankArray w)) :=
  symmetricRankLociTheorem_of_carrierCorrespondence hcarrier

