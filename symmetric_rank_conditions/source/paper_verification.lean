section

set_option autoImplicit false
set_option maxHeartbeats 1000000
noncomputable section

namespace FourPapers.Symmetric
open MvPolynomial

theorem fold_mem_entryEmbedding_range_iff {m n : ℕ} (a : Fin m ↪o Fin n) (i j : Fin n) :
    fold i j ∈ Set.range (entryEmbedding a) ↔ i ∈ Set.range a ∧ j ∈ Set.range a := by
  rw [entryEmbedding_mem_range]
  change (max i j ∈ Set.range a ∧ min i j ∈ Set.range a) ↔
    i ∈ Set.range a ∧ j ∈ Set.range a
  by_cases hij : i ≤ j
  · rw [max_eq_right hij, min_eq_left hij]
    exact and_comm
  · rw [max_eq_left (le_of_not_ge hij), min_eq_right (le_of_not_ge hij)]

/-- Every entry touching a deleted vertex is one of the independent carriers. -/
def carrierOfDeletedVertex {m n : ℕ} (a : Fin m ↪o Fin n) (v : Fin n)
    (hv : v ∉ Set.range a) (i : Fin n) : ResidualCarriers a :=
  ⟨fold v i, fun h => hv ((fold_mem_entryEmbedding_range_iff a v i).mp h).1⟩

abbrev OffDiagonalCarrier {n : ℕ} (k : Fin (n + 1)) :=
  ResidualCarriers (offDiagonalResidualEmbedding k)

def offDiagonalFirstCarrier {n : ℕ} (k : Fin (n + 1)) (i : Fin (n + 2)) :
    OffDiagonalCarrier k :=
  carrierOfDeletedVertex (offDiagonalResidualEmbedding k) 0
    (by rw [offDiagonalResidualEmbedding_mem_range]; simp) i

def offDiagonalSecondCarrier {n : ℕ} (k : Fin (n + 1)) (i : Fin (n + 2)) :
    OffDiagonalCarrier k :=
  carrierOfDeletedVertex (offDiagonalResidualEmbedding k) k.succ
    (by rw [offDiagonalResidualEmbedding_mem_range]; simp) i

/-- Exactly the initial first-row coordinates are forced to vanish. -/
def OffDiagonalForced {n : ℕ} (k : Fin (n + 1)) (c : OffDiagonalCarrier k) : Prop :=
  c.val.val.2 = 0 ∧ c.val.val.1 < k.succ

abbrev OffDiagonalFreeCarrier {n : ℕ} (k : Fin (n + 1)) :=
  {c : OffDiagonalCarrier k // ¬OffDiagonalForced k c}

@[simp] theorem offDiagonalFirstCarrier_forced {n : ℕ}
    (k : Fin (n + 1)) (i : Fin (n + 2)) :
    OffDiagonalForced k (offDiagonalFirstCarrier k i) ↔ i < k.succ := by
  change (min 0 i = 0 ∧ max 0 i < k.succ) ↔ i < k.succ
  simp [min_eq_left (Fin.zero_le i), max_eq_right (Fin.zero_le i)]

def offDiagonalFreePivot {n : ℕ} (k : Fin (n + 1)) : OffDiagonalFreeCarrier k :=
  ⟨offDiagonalFirstCarrier k k.succ, by simp⟩

theorem offDiagonalFreeCarrier_mem_range {n : ℕ} (k : Fin (n + 1)) (c : OffDiagonalCarrier k) :
    c ∈ Set.range (Subtype.val : OffDiagonalFreeCarrier k → OffDiagonalCarrier k) ↔
      ¬OffDiagonalForced k c := by
  constructor
  · rintro ⟨d, rfl⟩
    exact d.property
  · exact fun h => ⟨⟨c, h⟩, rfl⟩

def offDiagonalZeroMap {n : ℕ} (R : Type*) [CommRing R] (k : Fin (n + 1)) :
    MvPolynomial (OffDiagonalCarrier k) R →+* MvPolynomial (OffDiagonalFreeCarrier k) R :=
  (killCompl (R := R) (f := Subtype.val) Subtype.val_injective).toRingHom

@[simp] theorem offDiagonalZeroMap_free {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) (c : OffDiagonalFreeCarrier k) :
    offDiagonalZeroMap R k (X c.val) = X c := by
  change killCompl (R := R) Subtype.val_injective (X c.val : MvPolynomial (OffDiagonalCarrier k) R) = _
  rw [← rename_X (Subtype.val : OffDiagonalFreeCarrier k → OffDiagonalCarrier k)]
  exact killCompl_rename_app (R := R) Subtype.val_injective (X c)

@[simp] theorem offDiagonalZeroMap_forced {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) (c : OffDiagonalCarrier k) (hc : OffDiagonalForced k c) :
    offDiagonalZeroMap R k (X c) = 0 := by
  have hnot : c ∉ Set.range (Subtype.val : OffDiagonalFreeCarrier k → OffDiagonalCarrier k) := by
    rw [offDiagonalFreeCarrier_mem_range]
    exact not_not_intro hc
  change killCompl (R := R)
    (f := (Subtype.val : OffDiagonalFreeCarrier k → OffDiagonalCarrier k))
    Subtype.val_injective (X c) = 0
  rw [killCompl, aeval_X, dif_neg hnot]

theorem offDiagonalZeroMap_surjective {n : ℕ} (R : Type*) [CommRing R]
    (k : Fin (n + 1)) : Function.Surjective (offDiagonalZeroMap R k) :=
  killCompl_surjective (R := R) Subtype.val_injective

section AbstractChart

variable {n : ℕ} {R S : Type*} [CommRing R] [CommRing S]
    (k : Fin (n + 1)) (φ : MvPolynomial (OffDiagonalCarrier k) R →+* S) (q : S)

def offDiagonalCoefficientFirst (i : Fin (n + 2)) : S :=
  φ (X (offDiagonalFirstCarrier k i))

def offDiagonalCoefficientSecond (i : Fin (n + 2)) : S :=
  φ (X (offDiagonalSecondCarrier k i))

/-- The inverse Schur translation on the independent residual variables. -/
def offDiagonalChartOffset (e : Entry n) : S :=
  let a := offDiagonalResidualEmbedding k
  let b := offDiagonalCoefficientFirst k φ
  let t := offDiagonalCoefficientSecond k φ
  q * (t (a e.val.1) * b (a e.val.2) + b (a e.val.1) * t (a e.val.2)) -
    t k.succ * q ^ 2 * b (a e.val.1) * b (a e.val.2)

theorem offDiagonalChartOffset_fold (i j : Fin n) :
    offDiagonalChartOffset k φ q (fold i j) =
      q * (offDiagonalCoefficientSecond k φ (offDiagonalResidualEmbedding k i) *
        offDiagonalCoefficientFirst k φ (offDiagonalResidualEmbedding k j) +
        offDiagonalCoefficientFirst k φ (offDiagonalResidualEmbedding k i) *
          offDiagonalCoefficientSecond k φ (offDiagonalResidualEmbedding k j)) -
      offDiagonalCoefficientSecond k φ k.succ * q ^ 2 *
        offDiagonalCoefficientFirst k φ (offDiagonalResidualEmbedding k i) *
          offDiagonalCoefficientFirst k φ (offDiagonalResidualEmbedding k j) := by
  let a := offDiagonalResidualEmbedding k
  let b := offDiagonalCoefficientFirst k φ
  let t := offDiagonalCoefficientSecond k φ
  change q * (t (a (max i j)) * b (a (min i j)) +
      b (a (max i j)) * t (a (min i j))) -
      t k.succ * q ^ 2 * b (a (max i j)) * b (a (min i j)) =
    q * (t (a i) * b (a j) + b (a i) * t (a j)) -
      t k.succ * q ^ 2 * b (a i) * b (a j)
  by_cases hij : i ≤ j
  · rw [max_eq_right hij, min_eq_left hij]
    ring
  · rw [max_eq_left (le_of_not_ge hij), min_eq_right (le_of_not_ge hij)]

def offDiagonalChartMap : CoordinateRing (n + 2) R →+* CoordinateRing n S :=
  (constantShiftEquiv (offDiagonalChartOffset k φ q)).toRingHom.comp
    (residualCoefficientMap (offDiagonalResidualEmbedding k) φ)

@[simp] theorem offDiagonalChartMap_first (i : Fin (n + 2)) :
    offDiagonalChartMap k φ q (X (fold 0 i)) = C (offDiagonalCoefficientFirst k φ i) := by
  change constantShift (offDiagonalChartOffset k φ q)
    (residualCoefficientMap (offDiagonalResidualEmbedding k) φ
      (X (offDiagonalFirstCarrier k i).val)) = _
  rw [residualCoefficientMap_carrier, constantShift_C]
  rfl

@[simp] theorem offDiagonalChartMap_second (i : Fin (n + 2)) :
    offDiagonalChartMap k φ q (X (fold k.succ i)) = C (offDiagonalCoefficientSecond k φ i) := by
  change constantShift (offDiagonalChartOffset k φ q)
    (residualCoefficientMap (offDiagonalResidualEmbedding k) φ
      (X (offDiagonalSecondCarrier k i).val)) = _
  rw [residualCoefficientMap_carrier, constantShift_C]
  rfl

@[simp] theorem offDiagonalChartMap_residual (i j : Fin n) :
    offDiagonalChartMap k φ q
      (X (fold (offDiagonalResidualEmbedding k i) (offDiagonalResidualEmbedding k j))) =
        X (fold i j) + C (offDiagonalChartOffset k φ q (fold i j)) := by
  rw [← entryEmbedding_fold]
  change constantShift (offDiagonalChartOffset k φ q)
    (residualCoefficientMap (offDiagonalResidualEmbedding k) φ
      (X (entryEmbedding (offDiagonalResidualEmbedding k) (fold i j)))) = _
  rw [residualCoefficientMap_residual, constantShift_X]

/-- The translated Schur complement is exactly the generic smaller symmetric
matrix, entry by entry. Its coordinates retain their independence. -/
theorem offDiagonalChartMap_residualMatrix :
    offDiagonalResidualMatrix ((genericMatrix (n + 2) R).map (offDiagonalChartMap k φ q))
      k (C q) = genericMatrix n S := by
  funext i j
  simp only [offDiagonalResidualMatrix, offDiagonalSchurMatrix, Matrix.of_apply, Matrix.submatrix_apply,
    Matrix.map_apply, genericMatrix, offDiagonalChartMap_residual,
    offDiagonalChartMap_first, offDiagonalChartMap_second, offDiagonalChartOffset_fold,
    map_sub, map_add, map_mul, map_pow]
  ring

theorem offDiagonalChartMap_symmetric :
    ((genericMatrix (n + 2) R).map (offDiagonalChartMap k φ q)).transpose =
      (genericMatrix (n + 2) R).map (offDiagonalChartMap k φ q) := by
  funext i j
  change offDiagonalChartMap k φ q (X (fold j i)) = offDiagonalChartMap k φ q (X (fold i j))
  rw [fold_comm]

/-- Exact image of a realized northwest ideal in the off-diagonal chart.
The witness matrix is over an arbitrary independent field. -/
theorem northwestIdeal_map_offDiagonalChart {F : Type*} [Field F]
    (w : Matrix (Fin (n + 2)) (Fin (n + 2)) F) (hw : w.transpose = w)
    (hqx : q * offDiagonalCoefficientFirst k φ k.succ = 1)
    (hzero : ∀ j < k.succ, offDiagonalCoefficientFirst k φ j = 0)
    (hwx : w 0 k.succ ≠ 0) (hwzero : ∀ j < k.succ, w 0 j = 0) :
    (northwestIdeal R (matrixRankArray w)).map (offDiagonalChartMap k φ q) =
      northwestIdeal S (matrixRankArray (offDiagonalResidualMatrix w k (w 0 k.succ)⁻¹)) := by
  rw [map_northwestIdeal_eq_matrixIdeal]
  rw [northwestMatrixIdeal_offDiagonalSchur _ (offDiagonalChartMap_symmetric k φ q)
    w hw k (C q)]
  · rw [offDiagonalChartMap_residualMatrix]
    exact (northwestIdeal_eq_iSup_prefixMinorIdeals S _).symm
  · change C q * offDiagonalChartMap k φ q (X (fold 0 k.succ)) = 1
    rw [offDiagonalChartMap_first, ← map_mul, hqx, map_one]
  · intro j hj
    change offDiagonalChartMap k φ q (X (fold 0 j)) = 0
    rw [offDiagonalChartMap_first, hzero j hj, map_zero]
  · exact hwx
  · exact hwzero

end AbstractChart

end FourPapers.Symmetric
end
