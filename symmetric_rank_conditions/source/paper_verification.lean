/-!
# Homogeneous quotient components under a coordinate change

These results transport the actual homogeneous quotient spaces through a
graded algebra isomorphism.  They are intended for the Schur coordinate
change in the applications of Lemma 3.3.
-/

namespace FourPapers.Symmetric.Pivot

open MvPolynomial Finsupp

attribute [local instance] MvPolynomial.weightedGradedAlgebra

variable {σ τ R D : Type*} [CommRing R] [AddCommMonoid D] [DecidableEq D]

/-- An algebra map is graded when its variable images have the specified
weights; the conclusion holds for every homogeneous polynomial. -/
theorem isWeightedHomogeneous_algHom
    (f : MvPolynomial σ R →ₐ[R] MvPolynomial τ R)
    (w : σ → D) (v : τ → D)
    (hX : ∀ i, (f (X i)).IsWeightedHomogeneous v (w i))
    {p : MvPolynomial σ R} {d : D} (hp : p.IsWeightedHomogeneous w d) :
    (f p).IsWeightedHomogeneous v d := by
  classical
  induction hp using IsWeightedHomogeneous.induction_on with
  | zero => simpa only [map_zero] using isWeightedHomogeneous_zero R v d
  | add p q hp hq ihp ihq => simpa only [map_add] using ihp.add ihq
  | monomial e c he =>
    have hprod : (∏ i ∈ e.support, f (X i) ^ e i).IsWeightedHomogeneous v (weight w e) := by
      change IsWeightedHomogeneous v _ (∑ i ∈ e.support, e i • w i)
      exact IsWeightedHomogeneous.prod _ _ _ (fun i _ => (hX i).pow (e i))
    simpa only [MvPolynomial.monomial_eq, map_mul, MvPolynomial.algHom_C,
      MvPolynomial.algebraMap_eq, Finsupp.prod, map_prod, map_pow, he] using hprod.C_mul c

/-- Applying an additive map to all variable weights transports actual
homogeneous polynomial degrees by that same map. -/
theorem isWeightedHomogeneous_coarsen {E : Type*} [AddCommMonoid E]
    (ρ : D →+ E) (w : σ → D) {p : MvPolynomial σ R} {d : D}
    (hp : p.IsWeightedHomogeneous w d) :
    p.IsWeightedHomogeneous (fun i => ρ (w i)) (ρ d) := by
  intro e he
  have h := congrArg ρ (hp he)
  simpa only [weight_apply, Finsupp.sum, map_sum, map_nsmul] using h

/-- Gradedness of an algebra equivalence is checked on the variables in
both directions. -/
theorem isWeightedHomogeneous_algEquiv_iff
    (e : MvPolynomial σ R ≃ₐ[R] MvPolynomial τ R)
    (w : σ → D) (v : τ → D)
    (hX : ∀ i, (e (X i)).IsWeightedHomogeneous v (w i))
    (hY : ∀ j, (e.symm (X j)).IsWeightedHomogeneous w (v j))
    (p : MvPolynomial σ R) (d : D) :
    p.IsWeightedHomogeneous w d ↔ (e p).IsWeightedHomogeneous v d := by
  constructor
  · exact isWeightedHomogeneous_algHom e.toAlgHom w v hX
  · intro hp
    simpa only [AlgEquiv.toAlgHom_apply, AlgEquiv.symm_apply_apply] using
      isWeightedHomogeneous_algHom e.symm.toAlgHom v w hY hp

/-- The homogeneous quotient component is preserved by a graded algebra
isomorphism carrying the actual source ideal to the actual target ideal. -/
def quotientPieceEquivOfAlgEquiv
    (e : MvPolynomial σ R ≃ₐ[R] MvPolynomial τ R)
    (I : Ideal (MvPolynomial σ R)) (J : Ideal (MvPolynomial τ R))
    (hIJ : J = I.map e.toRingHom)
    (w : σ → D) (v : τ → D)
    (hgraded : ∀ p d, p.IsWeightedHomogeneous w d ↔ (e p).IsWeightedHomogeneous v d)
    (d : D) : quotientPiece I w d ≃ₗ[R] quotientPiece J v d := by
  let q := (Ideal.quotientEquivAlg I J e hIJ).toLinearEquiv
  apply q.ofSubmodules
  apply le_antisymm
  · rintro y ⟨z, hz, rfl⟩
    obtain ⟨p, hp, rfl⟩ := hz
    exact ⟨e p, (hgraded p d).mp hp, rfl⟩
  · rintro y ⟨p, hp, rfl⟩
    refine ⟨Ideal.Quotient.mk I (e.symm p), ?_, ?_⟩
    · refine ⟨e.symm p, ?_, rfl⟩
      apply (hgraded (e.symm p) d).mpr
      change p.IsWeightedHomogeneous v d at hp
      simpa only [AlgEquiv.apply_symm_apply] using hp
    · change Ideal.Quotient.mk J (e (e.symm p)) = Ideal.Quotient.mk J p
      rw [AlgEquiv.apply_symm_apply]

/-- Convenient form in which gradedness is checked only on variables. -/
def quotientPieceEquivOfVariableImages
    (e : MvPolynomial σ R ≃ₐ[R] MvPolynomial τ R)
    (I : Ideal (MvPolynomial σ R)) (J : Ideal (MvPolynomial τ R))
    (hIJ : J = I.map e.toRingHom)
    (w : σ → D) (v : τ → D)
    (hX : ∀ i, (e (X i)).IsWeightedHomogeneous v (w i))
    (hY : ∀ j, (e.symm (X j)).IsWeightedHomogeneous w (v j))
    (d : D) : quotientPiece I w d ≃ₗ[R] quotientPiece J v d :=
  quotientPieceEquivOfAlgEquiv e I J hIJ w v
    (isWeightedHomogeneous_algEquiv_iff e w v hX hY) d

section Field

variable {K : Type*} [Field K]

theorem finrank_quotientPiece_eq_of_gradedEquiv
    (e : MvPolynomial σ K ≃ₐ[K] MvPolynomial τ K)
    (I : Ideal (MvPolynomial σ K)) (J : Ideal (MvPolynomial τ K))
    (hIJ : J = I.map e.toRingHom)
    (w : σ → D) (v : τ → D)
    (hgraded : ∀ p d, p.IsWeightedHomogeneous w d ↔ (e p).IsWeightedHomogeneous v d)
    (d : D) :
    Module.finrank K (quotientPiece I w d) = Module.finrank K (quotientPiece J v d) :=
  (quotientPieceEquivOfAlgEquiv e I J hIJ w v hgraded d).finrank_eq

/-- Combines a graded coordinate change with the standard-monomial basis
of the target quotient.  This is the numerical bridge used in a pivot
induction. -/
theorem finrank_quotientPiece_eq_standardCount_of_gradedEquiv
    (e : MvPolynomial σ K ≃ₐ[K] MvPolynomial τ K)
    (I : Ideal (MvPolynomial σ K)) (J : Ideal (MvPolynomial τ K))
    (hIJ : J = I.map e.toRingHom)
    (w : σ → D) (v : τ → D)
    (hgraded : ∀ p d, p.IsWeightedHomogeneous w d ↔ (e p).IsWeightedHomogeneous v d)
    (m : MonomialOrder τ)
    (hJ : J.IsHomogeneous (weightedHomogeneousSubmodule K v)) (d : D)
    (hf : (standardPieceSet m J v d).Finite) :
    Module.finrank K (quotientPiece I w d) = (standardPieceSet m J v d).ncard :=
  (finrank_quotientPiece_eq_of_gradedEquiv e I J hIJ w v hgraded d).trans
    (finrank_quotientPiece m J v hJ d hf)

end Field


section Triangular

/-- A triangular coordinate translation is graded whenever each translation
polynomial has the weight of the variable being translated. -/
theorem triangularShift_isWeightedHomogeneous
    (w : σ → D) (v : τ → D) (f : τ → MvPolynomial σ R)
    (hf : ∀ j, (f j).IsWeightedHomogeneous w (v j))
    {p : MvPolynomial (σ ⊕ τ) R} {d : D}
    (hp : p.IsWeightedHomogeneous (Sum.elim w v) d) :
    (triangularShift f p).IsWeightedHomogeneous (Sum.elim w v) d := by
  apply isWeightedHomogeneous_algHom (triangularShift f)
    (Sum.elim w v) (Sum.elim w v) _ hp
  intro i
  cases i with
  | inl i =>
    rw [triangularShift_X_left]
    exact isWeightedHomogeneous_X (R := R) (Sum.elim w v) (Sum.inl i)
  | inr j =>
    rw [triangularShift_X_right]
    apply (isWeightedHomogeneous_X (R := R) (Sum.elim w v) (Sum.inr j)).add
    apply isWeightedHomogeneous_algHom (rename Sum.inl) w (Sum.elim w v) _ (hf j)
    intro i
    rw [rename_X]
    exact isWeightedHomogeneous_X (R := R) (Sum.elim w v) (Sum.inl i)

/-- Both directions of a graded triangular coordinate change preserve each
homogeneous component; no claim about an ideal is used here. -/
theorem triangularShiftEquiv_isWeightedHomogeneous_iff
    (w : σ → D) (v : τ → D) (f : τ → MvPolynomial σ R)
    (hf : ∀ j, (f j).IsWeightedHomogeneous w (v j))
    (p : MvPolynomial (σ ⊕ τ) R) (d : D) :
    p.IsWeightedHomogeneous (Sum.elim w v) d ↔
      (triangularShiftEquiv f p).IsWeightedHomogeneous (Sum.elim w v) d := by
  constructor
  · exact triangularShift_isWeightedHomogeneous w v f hf
  · intro hp
    have h := triangularShift_isWeightedHomogeneous w v (-f)
      (fun j => (hf j).neg) hp
    change IsWeightedHomogeneous (Sum.elim w v)
      ((triangularShiftEquiv f).symm (triangularShiftEquiv f p)) d at h
    simpa only [AlgEquiv.symm_apply_apply] using h

end Triangular

section Schur

variable {n : ℕ}

/-- The independent symmetric entries split into the diagonal pivot, the
remaining first-row entries, and the smaller symmetric matrix. -/
def pivotEntry : Option (PivotVariables n) → Entry (n + 1)
  | none => ⟨toLex (0, 0), le_rfl⟩
  | Option.some (.inl i) =>
      ⟨toLex (i.succ, 0), show (0 : Fin (n + 1)) ≤ i.succ from Fin.zero_le _⟩
  | Option.some (.inr e) =>
      ⟨toLex (e.val.1.succ, e.val.2.succ),
        show e.val.2.succ ≤ e.val.1.succ from Fin.succ_le_succ_iff.mpr e.property⟩

theorem pivotEntry_injective : Function.Injective (pivotEntry (n := n)) := by
  intro a b h
  cases a with
  | none =>
    cases b with
    | none => rfl
    | some b =>
      cases b with
      | inl i =>
        have hh := congrArg (fun e : Entry (n + 1) => e.val.1) h
        change (0 : Fin (n + 1)) = i.succ at hh
        exact (Fin.succ_ne_zero i hh.symm).elim
      | inr e =>
        have hh := congrArg (fun e : Entry (n + 1) => e.val.1) h
        change (0 : Fin (n + 1)) = e.val.1.succ at hh
        exact (Fin.succ_ne_zero e.val.1 hh.symm).elim
  | some a =>
    cases b with
    | none =>
      cases a with
      | inl i =>
        have hh := congrArg (fun e : Entry (n + 1) => e.val.1) h
        change i.succ = (0 : Fin (n + 1)) at hh
        exact (Fin.succ_ne_zero i hh).elim
      | inr e =>
        have hh := congrArg (fun e : Entry (n + 1) => e.val.1) h
        change e.val.1.succ = (0 : Fin (n + 1)) at hh
        exact (Fin.succ_ne_zero e.val.1 hh).elim
    | some b =>
      cases a with
      | inl i =>
        cases b with
        | inl j =>
          have hh := congrArg (fun e : Entry (n + 1) => e.val.1) h
          change i.succ = j.succ at hh
          have hij := Fin.succ_injective n hh
          cases hij
          rfl
        | inr e =>
          have hh := congrArg (fun e : Entry (n + 1) => e.val.2) h
          change (0 : Fin (n + 1)) = e.val.2.succ at hh
          exact (Fin.succ_ne_zero e.val.2 hh.symm).elim
      | inr e =>
        cases b with
        | inl i =>
          have hh := congrArg (fun e : Entry (n + 1) => e.val.2) h
          change e.val.2.succ = (0 : Fin (n + 1)) at hh
          exact (Fin.succ_ne_zero e.val.2 hh).elim
        | inr f =>
          have h1 := congrArg (fun e : Entry (n + 1) => e.val.1) h
          have h2 := congrArg (fun e : Entry (n + 1) => e.val.2) h
          change e.val.1.succ = f.val.1.succ at h1
          change e.val.2.succ = f.val.2.succ at h2
          have hef : e = f := Subtype.ext
            (Prod.ext (Fin.succ_injective n h1) (Fin.succ_injective n h2))
          cases hef
          rfl

theorem pivotEntry_surjective : Function.Surjective (pivotEntry (n := n)) := by
  rintro ⟨⟨i, j⟩, hji⟩
  rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i, rfl⟩
  · have hj : j = 0 := le_antisymm hji (by simp)
    cases hj
    exact ⟨none, rfl⟩
  · rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j, rfl⟩
    · exact ⟨some (.inl i), rfl⟩
    · exact ⟨some (.inr ⟨toLex (i, j), show j ≤ i from Fin.succ_le_succ_iff.mp hji⟩), rfl⟩

/-- This equivalence proves that the pivot presentation has exactly the
original symmetric variables, with no coordinates lost or duplicated. -/
def pivotEntryEquiv : Option (PivotVariables n) ≃ Entry (n + 1) :=
  Equiv.ofBijective pivotEntry ⟨pivotEntry_injective, pivotEntry_surjective⟩

@[simp] theorem pivotEntryEquiv_apply (i : Option (PivotVariables n)) :
    pivotEntryEquiv i = pivotEntry i := rfl

/-- The polynomial-ring identification used to apply the literal pivot
comparison to `CoordinateRing (n+1) R`. -/
def pivotCoordinateEquiv : CoordinateRing (n + 1) R ≃ₐ[R]
    MvPolynomial (Option (PivotVariables n)) R :=
  renameEquiv R pivotEntryEquiv.symm

@[simp] theorem pivotCoordinateEquiv_variable (i : Option (PivotVariables n)) :
    pivotCoordinateEquiv (X (pivotEntry i) : CoordinateRing (n + 1) R) = X i := by
  change rename pivotEntryEquiv.symm (X (pivotEntryEquiv i)) = X i
  rw [rename_X, Equiv.symm_apply_apply]

@[simp] theorem pivotEntry_none : (pivotEntry none : Entry (n + 1)) = fold 0 0 := by
  simp [pivotEntry, fold]

@[simp] theorem pivotEntry_carrier (i : Fin n) :
    pivotEntry (some (Sum.inl i)) = fold 0 i.succ := by
  simp [pivotEntry, fold]

@[simp] theorem pivotEntry_fold (i j : Fin n) :
    pivotEntry (some (Sum.inr (fold i j))) = fold i.succ j.succ := by
  apply Subtype.ext
  change ((max i j).succ, (min i j).succ) =
    (max i.succ j.succ, min i.succ j.succ)
  by_cases h : i ≤ j
  · have hs := Fin.succ_le_succ_iff.mpr h
    simp only [max_eq_right h, min_eq_left h, max_eq_right hs, min_eq_left hs]
  · have h' : j ≤ i := le_of_not_ge h
    have hs := Fin.succ_le_succ_iff.mpr h'
    simp only [max_eq_left h', min_eq_right h', max_eq_left hs, min_eq_right hs]

@[simp] theorem pivotCoordinateEquiv_pivot :
    pivotCoordinateEquiv (X (fold (0 : Fin (n + 1)) 0) : CoordinateRing (n + 1) R) =
      X (none : Option (PivotVariables n)) := by
  simpa only [pivotEntry_none] using
    (pivotCoordinateEquiv_variable (R := R) (n := n) none)

@[simp] theorem pivotCoordinateEquiv_carrier (i : Fin n) :
    pivotCoordinateEquiv (X (fold 0 i.succ) : CoordinateRing (n + 1) R) =
      X (some (Sum.inl i)) := by
  simpa only [pivotEntry_carrier] using
    (pivotCoordinateEquiv_variable (R := R) (some (Sum.inl i)))

@[simp] theorem pivotCoordinateEquiv_residual (i j : Fin n) :
    pivotCoordinateEquiv (X (fold i.succ j.succ) : CoordinateRing (n + 1) R) =
      X (some (Sum.inr (fold i j))) := by
  simpa only [pivotEntry_fold] using
    (pivotCoordinateEquiv_variable (R := R) (some (Sum.inr (fold i j))))

/-- The precise positive grading in Lemma 3.2 after the first vertex has
weight zero: a carrier has weight `eᵢ`, and a residual entry has weight
`eᵢ + eⱼ`, with diagonal multiplicity retained. -/
def pivotEndpointWeight : PivotVariables n → Fin n →₀ ℕ :=
  Sum.elim (fun i => Finsupp.single i 1) endpointWeight

@[simp] theorem pivotEndpointWeight_carrier (i : Fin n) :
    pivotEndpointWeight (Sum.inl i) = Finsupp.single i 1 := rfl

@[simp] theorem pivotEndpointWeight_entry (e : Entry n) :
    pivotEndpointWeight (Sum.inr e) = endpointWeight e := rfl

/-- Delete the first endpoint multiplicity and shift the remaining labels
by one. This is the additive coarsening of the original endpoint grading. -/
def deleteEndpointWeight : (Fin (n + 1) →₀ ℕ) →+ (Fin n →₀ ℕ) :=
  Finsupp.comapDomain.addMonoidHom (Fin.succ_injective n)

@[simp] theorem deleteEndpointWeight_apply (d : Fin (n + 1) →₀ ℕ) (i : Fin n) :
    deleteEndpointWeight d i = d i.succ := rfl

@[simp] theorem deleteEndpointWeight_single_zero :
    deleteEndpointWeight (Finsupp.single (0 : Fin (n + 1)) 1) = 0 := by
  ext i
  simp [Finsupp.single_apply]

@[simp] theorem deleteEndpointWeight_single_succ (i : Fin n) :
    deleteEndpointWeight (Finsupp.single i.succ 1) = Finsupp.single i 1 := by
  ext j
  simp [Finsupp.single_apply]

/-- The grading in pivot coordinates is exactly the original endpoint
multigrading with the first endpoint deleted, including diagonal multiplicity. -/
theorem deleteEndpointWeight_pivotEntry (o : Option (PivotVariables n)) :
    deleteEndpointWeight (endpointWeight (pivotEntry o)) =
      o.elim 0 pivotEndpointWeight := by
  cases o with
  | none =>
    change deleteEndpointWeight (Finsupp.single (0 : Fin (n + 1)) 1 +
      Finsupp.single 0 1) = 0
    simp only [map_add, deleteEndpointWeight_single_zero, zero_add]
  | some o =>
    cases o with
    | inl i =>
      change deleteEndpointWeight (Finsupp.single i.succ 1 +
        Finsupp.single (0 : Fin (n + 1)) 1) = Finsupp.single i 1
      simp only [map_add, deleteEndpointWeight_single_succ,
        deleteEndpointWeight_single_zero, add_zero]
    | inr e =>
      change deleteEndpointWeight (Finsupp.single e.val.1.succ 1 +
        Finsupp.single e.val.2.succ 1) =
          Finsupp.single e.val.1 1 + Finsupp.single e.val.2 1
      simp only [map_add, deleteEndpointWeight_single_succ]

/-- Exact homogeneous-degree transport from symmetric entries to pivot,
carrier and residual coordinates. -/
theorem pivotCoordinateEquiv_endpoint_homogeneous
    {p : CoordinateRing (n + 1) R} {d : Fin (n + 1) →₀ ℕ}
    (hp : p.IsWeightedHomogeneous endpointWeight d) :
    (pivotCoordinateEquiv p).IsWeightedHomogeneous
      (fun o => o.elim 0 pivotEndpointWeight) (deleteEndpointWeight d) := by
  apply isWeightedHomogeneous_algHom pivotCoordinateEquiv.toAlgHom
    (fun e => deleteEndpointWeight (endpointWeight e))
    (fun o => o.elim 0 pivotEndpointWeight) _
    (isWeightedHomogeneous_coarsen deleteEndpointWeight endpointWeight hp)
  intro e
  obtain ⟨o, rfl⟩ := pivotEntry_surjective e
  change IsWeightedHomogeneous (fun o => o.elim 0 pivotEndpointWeight)
    (pivotCoordinateEquiv (X (pivotEntry o)))
    (deleteEndpointWeight (endpointWeight (pivotEntry o)))
  rw [pivotCoordinateEquiv_variable, deleteEndpointWeight_pivotEntry]
  exact isWeightedHomogeneous_X (R := R)
    (fun o : Option (PivotVariables n) => o.elim 0 pivotEndpointWeight) o

/-- Endpoint-homogeneous ideals remain homogeneous under the actual pivot
coordinate identification and deletion of the first endpoint weight. -/
theorem pivotCoordinateIdeal_endpoint_homogeneous
    (I : Ideal (CoordinateRing (n + 1) R))
    (hI : I.IsHomogeneous (weightedHomogeneousSubmodule R endpointWeight)) :
    (I.map pivotCoordinateEquiv.toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule R (fun o => o.elim 0 pivotEndpointWeight)) := by
  classical
  obtain ⟨T, hT⟩ := (Ideal.IsHomogeneous.iff_exists _ _).mp hI
  rw [hT, Ideal.map_span]
  apply Ideal.homogeneous_span
  rintro p ⟨q, ⟨t, ht, rfl⟩, rfl⟩
  obtain ⟨d, hd⟩ := t.2
  exact ⟨deleteEndpointWeight d, pivotCoordinateEquiv_endpoint_homogeneous hd⟩

/-- Every actual northwest rank ideal has the precise homogeneity needed
by Lemma 3.3 after the proved coordinate identification. The rank table is
arbitrary: no realization or Gröbner theorem is assumed. -/
theorem northwestIdeal_pivot_endpoint_homogeneous (r : RankArray (n + 1)) :
    ((northwestIdeal R r).map pivotCoordinateEquiv.toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule R (fun o => o.elim 0 pivotEndpointWeight)) :=
  pivotCoordinateIdeal_endpoint_homogeneous (northwestIdeal R r)
    (northwestIdeal_endpoint_homogeneous R r)

/-- Actual determinantal symbolic powers are endpoint homogeneous once the
ordinary determinantal prime is known; no product-generation theorem is used. -/
theorem determinantal_symbolic_endpoint_homogeneous (m t s : ℕ)
    [(determinantalIdeal m R t).IsPrime] :
    (symbolicPower (determinantalIdeal m R t) s).IsHomogeneous
      (weightedHomogeneousSubmodule R endpointWeight) := by
  intro d f hf
  change ((weightedDecomposition R endpointWeight).decompose' f d : CoordinateRing m R) ∈ _
  rw [weightedDecomposition.decompose'_apply]
  exact determinantal_symbolic_endpoint_component m R t s hf d

/-- Every finite mixed sum of northwest and actual symbolic conditions is
endpoint homogeneous. Its hypotheses concern only the ordinary primes. -/
theorem mixedIdeal_endpoint_homogeneous {m : ℕ} (r : RankArray m)
    (conditions : List (ℕ × ℕ))
    (hprime : ∀ ts ∈ conditions, (determinantalIdeal m R ts.1).IsPrime) :
    (mixedIdeal R r conditions).IsHomogeneous
      (weightedHomogeneousSubmodule R endpointWeight) := by
  revert hprime
  induction conditions with
  | nil =>
    intro _
    simpa only [mixedIdeal, List.map_nil, List.sum_nil, add_zero] using
      northwestIdeal_endpoint_homogeneous R r
  | cons ts conditions ih =>
    intro hprime
    letI : (determinantalIdeal m R ts.1).IsPrime := hprime ts (List.mem_cons_self ..)
    rw [mixedIdeal_cons, Ideal.add_eq_sup]
    exact (ih (fun a ha => hprime a (List.mem_cons_of_mem _ ha))).sup
      (determinantal_symbolic_endpoint_homogeneous m ts.1 ts.2)

/-- This discharges the grading premise of the comparison lemma for the
actual mixed ideal of Theorem 1.2, using only ordinary determinantal primality. -/
theorem mixedIdeal_pivot_endpoint_homogeneous (r : RankArray (n + 1))
    (conditions : List (ℕ × ℕ))
    (hprime : ∀ ts ∈ conditions, (determinantalIdeal (n + 1) R ts.1).IsPrime) :
    ((mixedIdeal R r conditions).map pivotCoordinateEquiv.toRingHom).IsHomogeneous
      (weightedHomogeneousSubmodule R (fun o => o.elim 0 pivotEndpointWeight)) :=
  pivotCoordinateIdeal_endpoint_homogeneous (mixedIdeal R r conditions)
    (mixedIdeal_endpoint_homogeneous r conditions hprime)

theorem schurOffset_isWeightedHomogeneous (q : R) (e : Entry n) :
    (schurOffset q e).IsWeightedHomogeneous
      (fun i : Fin n => Finsupp.single i 1) (endpointWeight e) := by
  exact (((isWeightedHomogeneous_X (R := R)
      (fun i : Fin n => Finsupp.single i 1) e.val.1).C_mul q).mul
    (isWeightedHomogeneous_X (R := R)
      (fun i : Fin n => Finsupp.single i 1) e.val.2)).neg

/-- The actual Schur substitution, in both directions, preserves the endpoint
multidegree used by the carrier comparison. -/
theorem schurCoordinateEquiv_isWeightedHomogeneous_iff
    (q : R) (p : MvPolynomial (PivotVariables n) R) (d : Fin n →₀ ℕ) :
    p.IsWeightedHomogeneous pivotEndpointWeight d ↔
      (schurCoordinateEquiv q p).IsWeightedHomogeneous pivotEndpointWeight d :=
  triangularShiftEquiv_isWeightedHomogeneous_iff
    (fun i => Finsupp.single i 1) endpointWeight (schurOffset q)
    (schurOffset_isWeightedHomogeneous q) p d

/-- The Schur chart identifies actual homogeneous quotient components with
those of the transported ideal.  Identifying that transported ideal with the
smaller rank ideal is a separate determinantal theorem. -/
def schurQuotientPieceEquiv (q : R)
    (I : Ideal (MvPolynomial (PivotVariables n) R)) (d : Fin n →₀ ℕ) :
    quotientPiece I pivotEndpointWeight d ≃ₗ[R]
      quotientPiece (I.map (schurCoordinateEquiv q).toRingHom) pivotEndpointWeight d :=
  quotientPieceEquivOfAlgEquiv (schurCoordinateEquiv q) I _ rfl
    pivotEndpointWeight pivotEndpointWeight
    (schurCoordinateEquiv_isWeightedHomogeneous_iff q) d

end Schur

