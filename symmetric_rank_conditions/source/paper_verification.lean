section

set_option autoImplicit false
noncomputable section

namespace FourPapers.Symmetric
open Finset

/-- A row operation differing from the identity only in columns zero and `k`. -/
def twoColumnUpdate {n : ℕ} {R : Type*} [CommRing R]
    (k : Fin (n + 1)) (a c : Fin (n + 1) → R) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  Matrix.of (fun i j => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) R) i j +
    (if j = 0 then a i else 0) + (if j = k then c i else 0))

theorem twoColumnUpdate_mul {n : ℕ} {R : Type*} [CommRing R]
    (k : Fin (n + 1)) (a c : Fin (n + 1) → R)
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (i j : Fin (n + 1)) :
    (twoColumnUpdate k a c * M) i j = M i j + a i * M 0 j + c i * M k j := by
  classical
  simp [Matrix.mul_apply, twoColumnUpdate, Matrix.one_apply, add_mul,
    Finset.sum_add_distrib, ite_mul]

theorem mul_twoColumnUpdate_transpose {n : ℕ} {R : Type*} [CommRing R]
    (k : Fin (n + 1)) (a c : Fin (n + 1) → R)
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (i j : Fin (n + 1)) :
    (M * (twoColumnUpdate k a c).transpose) i j =
      M i j + a j * M i 0 + c j * M i k := by
  change (M * (twoColumnUpdate k a c).transpose).transpose j i = _
  rw [Matrix.transpose_mul, Matrix.transpose_transpose, twoColumnUpdate_mul]
  rfl

/-- Coefficient of the first basis vector in off-diagonal elimination. -/
def offDiagonalFirstCoefficient {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R)
    (i : Fin (n + 1)) : R :=
  if i = 0 ∨ i = k then 0 else w k k * w 0 i * q ^ 2 - w k i * q

/-- Coefficient of the pivot basis vector in off-diagonal elimination. -/
def offDiagonalSecondCoefficient {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R)
    (i : Fin (n + 1)) : R :=
  if k < i then -(w 0 i * q) else 0

/-- The actual lower triangular congruence used for an off-diagonal first pivot. -/
def offDiagonalEliminator {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  twoColumnUpdate k (offDiagonalFirstCoefficient w k q)
    (offDiagonalSecondCoefficient w k q)

theorem offDiagonalEliminator_lower {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R) :
    (offDiagonalEliminator w k q).IsLowerTriangular := by
  classical
  intro i j hij
  change i < j at hij
  have hne : i ≠ j := ne_of_lt hij
  have hj0 : j ≠ 0 := by intro h; subst j; exact (not_lt_of_ge (Fin.zero_le i)) hij
  by_cases hjk : j = k
  · subst j
    simp [offDiagonalEliminator, twoColumnUpdate, Matrix.one_apply, hne, hj0,
      offDiagonalSecondCoefficient, not_lt_of_ge hij.le]
  · simp [offDiagonalEliminator, twoColumnUpdate, Matrix.one_apply, hne, hj0, hjk]

theorem offDiagonalEliminator_diagonal {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R)
    (i : Fin (n + 1)) : offDiagonalEliminator w k q i i = 1 := by
  classical
  by_cases hi0 : i = 0
  · subst i
    simp [offDiagonalEliminator, twoColumnUpdate, offDiagonalFirstCoefficient,
      offDiagonalSecondCoefficient]
  · by_cases hik : i = k
    · subst i
      simp [offDiagonalEliminator, twoColumnUpdate, offDiagonalFirstCoefficient,
        offDiagonalSecondCoefficient, hi0]
    · simp [offDiagonalEliminator, twoColumnUpdate, hi0, hik]

theorem offDiagonalSecondCoefficient_eq {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R)
    (hzero : ∀ j < k, w 0 j = 0) (i : Fin (n + 1)) (hi : i ≠ k) :
    offDiagonalSecondCoefficient w k q i = -(w 0 i * q) := by
  classical
  by_cases hki : k < i
  · simp [offDiagonalSecondCoefficient, hki]
  · have hik : i < k := lt_of_le_of_ne (le_of_not_gt hki) hi
    simp [offDiagonalSecondCoefficient, hki, hzero i hik]

/-- Before the left row operation, the first row has only its pivot entry. -/
theorem offDiagonalRight_row_zero {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (hk : k ≠ 0)
    (q : R) (hq : q * w 0 k = 1) (hzero : ∀ j < k, w 0 j = 0)
    (j : Fin (n + 1)) :
    (w * (offDiagonalEliminator w k q).transpose) 0 j =
      if j = k then w 0 k else 0 := by
  have hkpos : 0 < k := lt_of_le_of_ne (Fin.zero_le k) (Ne.symm hk)
  have hw00 := hzero 0 hkpos
  rw [offDiagonalEliminator, mul_twoColumnUpdate_transpose, hw00, mul_zero, add_zero]
  by_cases hjk : j = k
  · subst j
    simp [offDiagonalSecondCoefficient]
  · rw [if_neg hjk, offDiagonalSecondCoefficient_eq w k q hzero j hjk]
    calc
      w 0 j + -(w 0 j * q) * w 0 k = w 0 j * (1 - q * w 0 k) := by ring
      _ = 0 := by rw [hq, sub_self, mul_zero]

/-- Before the left row operation, the pivot row is supported at the pivot
block only. The diagonal entry `w k k` is retained. -/
theorem offDiagonalRight_row_pivot {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (hk : k ≠ 0) (q : R) (hq : q * w 0 k = 1)
    (hzero : ∀ j < k, w 0 j = 0) (j : Fin (n + 1)) :
    (w * (offDiagonalEliminator w k q).transpose) k j =
      if j = 0 then w 0 k else if j = k then w k k else 0 := by
  have hwk0 : w k 0 = w 0 k := congrFun (congrFun hw 0) k
  rw [offDiagonalEliminator, mul_twoColumnUpdate_transpose, hwk0]
  by_cases hj0 : j = 0
  · subst j
    simp [offDiagonalFirstCoefficient, offDiagonalSecondCoefficient, hwk0]
  · by_cases hjk : j = k
    · subst j
      simp [offDiagonalFirstCoefficient, offDiagonalSecondCoefficient, hj0]
    · rw [if_neg hj0, if_neg hjk,
        offDiagonalSecondCoefficient_eq w k q hzero j hjk]
      simp only [offDiagonalFirstCoefficient, hj0, hjk, or_self, if_false]
      calc
        w k j + (w k k * w 0 j * q ^ 2 - w k j * q) * w 0 k +
            -(w 0 j * q) * w k k =
            (w k j - w k k * w 0 j * q) * (1 - q * w 0 k) := by ring
        _ = 0 := by rw [hq, sub_self, mul_zero]

/-- The isolated off-diagonal block has entries `0,x;x,y`, with `y` retained. -/
theorem offDiagonalEliminated_first_row {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (hk : k ≠ 0)
    (q : R) (hq : q * w 0 k = 1) (hzero : ∀ j < k, w 0 j = 0)
    (j : Fin (n + 1)) :
    (offDiagonalEliminator w k q * w * (offDiagonalEliminator w k q).transpose) 0 j =
      if j = k then w 0 k else 0 := by
  rw [Matrix.mul_assoc]
  change (twoColumnUpdate k (offDiagonalFirstCoefficient w k q)
    (offDiagonalSecondCoefficient w k q) *
      (w * (offDiagonalEliminator w k q).transpose)) 0 j = _
  rw [twoColumnUpdate_mul]
  simp only [offDiagonalFirstCoefficient, true_or, if_true,
    offDiagonalSecondCoefficient, not_lt_zero, if_false, zero_mul, add_zero]
  exact offDiagonalRight_row_zero w k hk q hq hzero j

theorem offDiagonalEliminated_pivot_row {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (hk : k ≠ 0) (q : R) (hq : q * w 0 k = 1)
    (hzero : ∀ j < k, w 0 j = 0) (j : Fin (n + 1)) :
    (offDiagonalEliminator w k q * w * (offDiagonalEliminator w k q).transpose) k j =
      if j = 0 then w 0 k else if j = k then w k k else 0 := by
  rw [Matrix.mul_assoc]
  change (twoColumnUpdate k (offDiagonalFirstCoefficient w k q)
    (offDiagonalSecondCoefficient w k q) *
      (w * (offDiagonalEliminator w k q).transpose)) k j = _
  rw [twoColumnUpdate_mul]
  simp only [offDiagonalFirstCoefficient, or_true, if_true,
    offDiagonalSecondCoefficient, lt_self_iff_false, if_false, zero_mul, add_zero]
  exact offDiagonalRight_row_pivot w hw k hk q hq hzero j

/-- The residual entries in the off-diagonal Schur chart. The formula is
integral in the retained diagonal `y` and uses no inverse of two. -/
def offDiagonalSchurMatrix {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) R :=
  Matrix.of (fun i j => w i j - q * (w k i * w 0 j + w 0 i * w k j) +
    w k k * q ^ 2 * w 0 i * w 0 j)

theorem offDiagonalEliminated_residual {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (hw : w.transpose = w)
    (k : Fin (n + 1)) (hk : k ≠ 0) (q : R) (hq : q * w 0 k = 1)
    (hzero : ∀ j < k, w 0 j = 0) (i j : Fin (n + 1)) (hj0 : j ≠ 0) (hjk : j ≠ k) :
    (offDiagonalEliminator w k q * w * (offDiagonalEliminator w k q).transpose) i j =
      offDiagonalSchurMatrix w k q i j := by
  have hwi0 : w i 0 = w 0 i := congrFun (congrFun hw 0) i
  have hwik : w i k = w k i := congrFun (congrFun hw k) i
  rw [Matrix.mul_assoc]
  change (twoColumnUpdate k (offDiagonalFirstCoefficient w k q)
    (offDiagonalSecondCoefficient w k q) *
      (w * (offDiagonalEliminator w k q).transpose)) i j = _
  rw [twoColumnUpdate_mul, offDiagonalRight_row_zero w k hk q hq hzero j,
    offDiagonalRight_row_pivot w hw k hk q hq hzero j]
  simp only [hj0, hjk, if_false, mul_zero, add_zero]
  rw [offDiagonalEliminator, mul_twoColumnUpdate_transpose,
    offDiagonalSecondCoefficient_eq w k q hzero j hjk, hwi0, hwik]
  simp only [offDiagonalFirstCoefficient, hj0, hjk, or_self, if_false]
  dsimp [offDiagonalSchurMatrix]
  ring

/-- The eliminator preserves every northwest minor ideal over every
coefficient ring in which the first off-diagonal pivot is invertible. -/
theorem northwestMatrixIdeal_offDiagonalElimination {n : ℕ} {R : Type*} [CommRing R]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) R) (k : Fin (n + 1)) (q : R)
    (r : RankArray (n + 1)) :
    northwestMatrixIdeal
      (offDiagonalEliminator w k q * w * (offDiagonalEliminator w k q).transpose) r =
      northwestMatrixIdeal w r := by
  exact northwestMatrixIdeal_lower_congruence _ w (offDiagonalEliminator_lower w k q)
    (fun i => by rw [offDiagonalEliminator_diagonal]; exact isUnit_one) r

