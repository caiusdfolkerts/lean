module
public import verified_theorems

@[expose] public section

/-!
# The paper's principal statements

This module is a reader's entry point to the checked proof development for
*Gröbner bases for symmetric rank conditions*. It states the principal results
with their parameters and conclusions visible, then applies the existing
proofs. It adds no mathematical assumptions.

## Conventions

* `Fin n` numbers the paper's indices from `0` through `n - 1`.
* `Entry n` is a folded symmetric coordinate, stored as `(larger, smaller)`.
  `CoordinateRing n R` is the ordinary multivariate polynomial ring on these
  coordinates with coefficients in `R`.
* `minor R a b` is the determinant of the indicated submatrix of the generic
  symmetric matrix. `northwestGenerators` consists of the prescribed minors;
  `northwestAntidiagonals` consists of their folded antidiagonal monomials.
* `foldedOrder n` is the paper's graded reverse lexicographic order.
  `initialIdeal R I` is the ideal spanned by the leading terms of elements of
  `I`, not an ideal defined from the proposed Gröbner generators.
* `symbolicPower P s` is defined by clearing a denominator outside `P`.
  For prime `P`, `mem_symbolicPower_iff` and the localization results identify
  it with the contraction of `P ^ s` from localization at `P`. In particular,
  the symbolic powers below are not defined using products of minors.

All sizes are arbitrary natural numbers. There is no positive-size assumption
on `n`. The finite symbolic list may be empty. The universal coefficient-ring
statement includes rings with zero divisors and the zero ring.
-/

set_option autoImplicit false

namespace FourPapers.Symmetric.PaperStatements

universe u v

/-! ## Theorem 1.1: realized symmetric rank profiles -/

/-- Theorem 1.1, algebraic conclusions. The realization field `F` and the
coefficient field `K` are independent, including their universes and
characteristics. `matrixRankArray w` records ranks of actual northwest
submatrices of the symmetric matrix `w`. -/
theorem theorem_1_1
    (n : ℕ) (F : Type u) [Field F]
    (w : Matrix (Fin n) (Fin n) F) (hw : w.transpose = w)
    (K : Type v) [Field K] :
    (Ideal.span (northwestGenerators K (matrixRankArray w))).IsPrime ∧
      initialIdeal K (Ideal.span (northwestGenerators K (matrixRankArray w))) =
        Ideal.span (northwestAntidiagonals K (matrixRankArray w)) := by
  exact symmetric_rank_loci.1 n F w hw K

/-- Theorem 1.1, geometric conclusion. The set inside the vanishing ideal is
defined by actual matrix ranks, independently of the proposed equations.
Every symmetric matrix is represented by its folded coordinate function `x`.
-/
theorem theorem_1_1_vanishing_ideal
    (n : ℕ) (F : Type u) [Field F]
    (w : Matrix (Fin n) (Fin n) F) (hw : w.transpose = w)
    (K : Type v) [Field K] [IsAlgClosed K] :
    MvPolynomial.vanishingIdeal K
        {x : Entry n → K |
          ∀ i j, matrixRankArray (fun a b => x (fold a b)) i j ≤
            matrixRankArray w i j} =
      Ideal.span (northwestGenerators K (matrixRankArray w)) := by
  exact symmetric_rank_loci.2 n F w hw K

/-! ## Theorem 1.2: arbitrary rank bounds and symbolic powers -/

/-- Theorem 1.2 over a field. The bounds `r` need only be symmetric; no
realizing matrix is required. A pair `(t, s)` contributes the genuine symbolic
power of the ideal generated by all `t × t` minors. `symbolicGenerators` is
the paper's separate exact-score family of products of minors. -/
theorem theorem_1_2_groebner
    (n : ℕ) (K : Type u) [Field K] (r : RankArray n)
    (hr : ∀ i j, r i j = r j i) (conditions : List (ℕ × ℕ))
    (hc : ∀ ts ∈ conditions, 1 ≤ ts.1 ∧ ts.1 ≤ n ∧ 1 ≤ ts.2) :
    (foldedOrder n).IsGroebnerBasis
      (northwestGenerators K r ∪
        {f | ∃ ts ∈ conditions, f ∈ symbolicGenerators K n ts.1 ts.2})
      (Ideal.span (northwestGenerators K r) +
        (conditions.map fun ts =>
          symbolicPower (Ideal.span (fullMinorGenerators n K ts.1)) ts.2).sum) := by
  exact compatible_rank_and_symbolic_conditions n K r hr conditions hc

/-- Theorem 1.2, displayed equality of initial ideals. The left side is formed
from the actual sum of determinantal and symbolic-power ideals; the right side
is formed from the explicitly prescribed folded antidiagonal generators. -/
theorem theorem_1_2_initial_ideal
    (n : ℕ) (K : Type u) [Field K] (r : RankArray n)
    (hr : ∀ i j, r i j = r j i) (conditions : List (ℕ × ℕ))
    (hc : ∀ ts ∈ conditions, 1 ≤ ts.1 ∧ ts.1 ≤ n ∧ 1 ≤ ts.2) :
    initialIdeal K
        (Ideal.span (northwestGenerators K r) +
          (conditions.map fun ts =>
            symbolicPower (Ideal.span (fullMinorGenerators n K ts.1)) ts.2).sum) =
      Ideal.span (northwestAntidiagonals K r) ⊔
        ∑ ts ∈ conditions.toFinset,
          Ideal.span (symbolicAntidiagonals K n ts.1 ts.2) := by
  exact compatible_initial_ideal n K r hr conditions hc

/-- Theorem 1.2 over the integers and under every commutative base change.

`normalizedMixedGenerators` multiplies each displayed integral generator by
its leading sign. The first two clauses say that this family is a monic
Gröbner basis over `ℤ`. The last clause says that the same specified standard
monomials give a basis after every coefficient-ring map `ℤ → R`.

The index set is defined over the integers before `R` is chosen. The quotient
ideal is the span of the mapped integral generators, exactly the integral
model in the paper. No interpretation of symbolic powers over arbitrary
non-field coefficient rings is imposed by this base-change assertion. -/
theorem theorem_1_2_integral
    (n : ℕ) (r : RankArray n) (hr : ∀ i j, r i j = r j i)
    (conditions : List (ℕ × ℕ))
    (hc : ∀ ts ∈ conditions, 1 ≤ ts.1 ∧ ts.1 ≤ n ∧ 1 ≤ ts.2) :
    (foldedOrder n).IsGroebnerBasis (normalizedMixedGenerators r conditions)
        (Ideal.span (normalizedMixedGenerators r conditions)) ∧
      (∀ g ∈ normalizedMixedGenerators r conditions,
        (foldedOrder n).leadingCoeff g = 1) ∧
      ∀ (R : Type u) [CommRing R],
        let E := {e : Entry n →₀ ℕ //
          MvPolynomial.monomial e (1 : ℤ) ∉
            Ideal.span (northwestAntidiagonals ℤ r) ⊔
              ∑ ts ∈ conditions.toFinset,
                Ideal.span (symbolicAntidiagonals ℤ n ts.1 ts.2)}
        let I := Ideal.span
          ((MvPolynomial.map (Int.castRingHom R)) ''
            normalizedMixedGenerators r conditions)
        let b : E → CoordinateRing n R ⧸ I :=
          fun e => Ideal.Quotient.mk I (MvPolynomial.monomial e.val 1)
        LinearIndependent R b ∧ Submodule.span R (Set.range b) = ⊤ := by
  exact integral_rank_and_symbolic_conditions n r hr conditions hc

/-! ## Theorem 2.1: the actual insertion map and its statistics -/

/-- Theorem 2.1 in full. `pairedTableau` runs the specified paired row-insertion
algorithm on the ordered endpoint pairs of the input monomial. The content
clause counts both endpoints of each occurrence, including two copies of a
diagonal endpoint.

`antidiagonalRank` and `packingDegree` are independently defined maxima over
actual folded antidiagonal divisors and products of such divisors. Thus the
two statistic identities do not hold by definition of those statistics.

The second clause is existence and uniqueness for every semistandard tableau
with even row lengths, not only for tableaux already known to be in the image.
-/
theorem theorem_2_1 (n : ℕ) :
    (∀ m : Entry n →₀ ℕ,
      (pairedTableau m).IsTableauRows ∧
      EvenRows (pairedTableau m) ∧
      (pairedTableau m).flatten.Perm (endpointWord (monomialPairs m)) ∧
      (∀ i j : Fin n, i ≤ j →
        antidiagonalRank m i j =
          entryPrefixHeight (pairedPrefixTableau m j) i) ∧
      (∀ k : ℕ,
        packingDegree m k = ((halfShape m).map (min k)).sum)) ∧
    (∀ rows : List (List (Fin n)), rows.IsTableauRows → EvenRows rows →
      ∃! m : Entry n →₀ ℕ, pairedTableau m = rows) := by
  exact insertion_statistics n

/-- The conjugate-partition expression in equation (2.3). Column indices are
zero based, so the right side is `μ′₁ + ··· + μ′ₖ` in the paper's notation. -/
theorem theorem_2_1_conjugate_packing
    (n : ℕ) (m : Entry n →₀ ℕ) (k : ℕ) :
    packingDegree m k = ∑ j ∈ Finset.range k, halfShapeConjugate m j := by
  exact pairedTableau_packing_conjugate m k

/-! ## Proposition 4.1: arbitrary symmetric bounds -/

/-- Proposition 4.1. All nonnegative symmetric bounds are allowed, including
inconsistent rank profiles and bounds larger than their northwest blocks.
The ideal is the ordinary ideal generated by the displayed minors. -/
theorem proposition_4_1
    (n : ℕ) (K : Type u) [Field K] (r : RankArray n)
    (hr : ∀ i j, r i j = r j i) :
    (foldedOrder n).IsGroebnerBasis (northwestGenerators K r)
      (Ideal.span (northwestGenerators K r)) := by
  exact northwest_groebner n K r hr

/-! ## Lemma 5.2: the full symbolic Schur quotient chart -/

section SymbolicSchurChart

open MvPolynomial

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- Passing to a coefficient quotient commutes with forming a polynomial
ring. The kernel computation is coefficientwise, and the quotient coefficient
map is surjective; the algebra first-isomorphism theorem supplies the inverse.
No primeness, flatness, or finite-variable assumption is needed here. -/
noncomputable def polynomialQuotientEquiv
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (σ : Type*) (I : Ideal S) :
    (MvPolynomial σ S ⧸ I.map (C : S →+* MvPolynomial σ S)) ≃ₐ[R]
      MvPolynomial σ (S ⧸ I) := by
  let f : MvPolynomial σ S →ₐ[R] MvPolynomial σ (S ⧸ I) :=
    mapAlgHom (Ideal.Quotient.mkₐ R I)
  have hf : Function.Surjective f :=
    map_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hker : RingHom.ker f.toRingHom =
      I.map (C : S →+* MvPolynomial σ S) := by
    change RingHom.ker (MvPolynomial.map (Ideal.Quotient.mk I)) = _
    rw [MvPolynomial.ker_map, Ideal.mk_ker]
  exact (Ideal.quotientEquivAlgOfEq R hker.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective hf)

/-- Separate carrier variables from residual variables, then quotient only
the residual coefficients. This records the actual polynomial-ring structure
on the right-hand side of the paper's chart, not only an equality of Hilbert
functions. -/
noncomputable def carrierQuotientEquiv
    {R σ τ : Type*} [CommRing R] (I : Ideal (MvPolynomial τ R)) :
    (MvPolynomial (σ ⊕ τ) R ⧸
      I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom) ≃ₐ[R]
      MvPolynomial σ (MvPolynomial τ R ⧸ I) := by
  let e := sumAlgEquiv R σ τ
  have hcomp : e.toRingHom.comp (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom =
      (C : MvPolynomial τ R →+* MvPolynomial σ (MvPolynomial τ R)) := by
    exact congrArg AlgHom.toRingHom (sumAlgEquiv_comp_rename_inr R σ τ)
  have hmap : I.map (C : MvPolynomial τ R →+* MvPolynomial σ (MvPolynomial τ R)) =
      (I.map (rename (Sum.inr : τ → σ ⊕ τ)).toRingHom).map e.toRingHom := by
    rw [Ideal.map_map, hcomp]
  exact (Ideal.quotientEquivAlg _ _ e hmap).trans
    (polynomialQuotientEquiv (R := R) σ I)

/-- Lemma 5.2, equation (5.2), as an explicit algebra equivalence.

The paper's matrix size and minor threshold are `n + 1` and `t + 1`.
Consequently `0 < t` expresses precisely the paper's threshold at least two.
The source is `F[b,C]` modulo the extension of the original genuine symbolic
power, with `F = K(x)`. Its coefficient map sends the original first diagonal
entry to the rational-function indeterminate. The target is a polynomial ring
in the free carriers over the smaller symmetric symbolic-power quotient.

The inverse Schur substitution sends the original lower block to
`D + x⁻¹bbᵀ`. Both determinantal primality instances are proved from
`northwest_groebner`; none is an assumption of this statement. The rational
coefficient field is `RatFunc K`, and no carrier variable is inverted. -/
noncomputable def lemma_5_2_quotient_chart
    (n t s : ℕ) (K : Type u) [Field K] (ht : 0 < t) :
    (MvPolynomial (PivotVariables n) (RatFunc K) ⧸
      (symbolicPower (determinantalIdeal (n + 1) K (t + 1)) s).map
        (Pivot.symmetricGenericPivotMap (n := n) (K := K))) ≃ₐ[RatFunc K]
      MvPolynomial (Fin n)
        (CoordinateRing n (RatFunc K) ⧸
          symbolicPower (determinantalIdeal n (RatFunc K) t) s) := by
  letI : (determinantalIdeal (n + 1) K (t + 1)).IsPrime :=
    determinantalIdeals_prime_of_northwestGroebner northwest_groebner
      (n + 1) K (t + 1) (Nat.succ_pos t)
  letI : (determinantalIdeal n (RatFunc K) t).IsPrime :=
    determinantalIdeals_prime_of_northwestGroebner northwest_groebner
      n (RatFunc K) t ht
  let H := symbolicPower (determinantalIdeal (n + 1) K (t + 1)) s
  let I := symbolicPower (determinantalIdeal n (RatFunc K) t) s
  let e := (schurCoordinateEquiv (n := n) (Pivot.genericPivotScalar K)⁻¹).symm
  have hmap : I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom =
      (H.map (Pivot.symmetricGenericPivotMap (n := n) (K := K))).map e.toRingHom := by
    rw [Ideal.map_map]
    change I.map (rename (Sum.inr : Entry n → PivotVariables n)).toRingHom =
      H.map (Pivot.genericFirstPivotChart (n := n) K)
    exact (Pivot.symbolicPower_map_genericFirstPivotChart K t s).symm
  exact (Ideal.quotientEquivAlg _ _ e hmap).trans (carrierQuotientEquiv I)

end SymbolicSchurChart

