set_option maxHeartbeats 1400000

/-!
# The finite-field point count for the actual rank locus

Every field-valued symmetric matrix has a unique literal symmetric
partial-permutation rank profile. This gives a proved disjoint union into
the actual strata, and the all-ring product chart counts each stratum.
The conclusion is uniform in the matrix size, rank bounds, and finite field.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata

variable {n : ℕ}

/-- Actual field-valued matrices obeying every northwest rank bound. -/
def RankLocusPoints (r : RankArray n) (F : Type*) [Field F] :=
  {M : SymmetricMatrices n F // matrixRankArray M.val ≤ r}

/-- All symmetric partial permutations below the specified rank table. -/
def BoundedRooks (r : RankArray n) :=
  {w : SymmetricRook n // w.val.rankProfile ≤ r}

noncomputable instance instFintypeBoundedRooks (r : RankArray n) : Fintype (BoundedRooks r) := by
  classical
  exact inferInstanceAs (Fintype {w : SymmetricRook n // w.val.rankProfile ≤ r})

noncomputable instance instFintypeRankLocusPoints (r : RankArray n)
    (F : Type*) [Field F] [Fintype F] : Fintype (RankLocusPoints r F) := by
  classical
  exact inferInstanceAs (Fintype {M : SymmetricMatrices n F // matrixRankArray M.val ≤ r})

def stratumForget (r : RankArray n) (F : Type*) [Field F] :
    (Σ w : BoundedRooks r, StratumPoints w.val.val.rankProfile F) → RankLocusPoints r F :=
  fun p => ⟨p.2.val, by
    have hr := (stratumPoints_field_iff p.1.val.val.rankProfile p.2.val).mp p.2.property
    rw [hr]
    exact p.1.property⟩

theorem stratumForget_injective (r : RankArray n) (F : Type*) [Field F] :
    Function.Injective (stratumForget r F) := by
  rintro ⟨v, M⟩ ⟨w, N⟩ h
  have hM : M.val = N.val := congrArg Subtype.val h
  have hvr := (stratumPoints_field_iff v.val.val.rankProfile M.val).mp M.property
  have hwr := (stratumPoints_field_iff w.val.val.rankProfile N.val).mp N.property
  have hvw : v = w := by
    apply Subtype.ext
    apply Subtype.ext
    apply RookPattern.rankProfile_injective
    exact hvr.symm.trans ((congrArg (fun A : SymmetricMatrices n F =>
      matrixRankArray A.val) hM).trans hwr)
  subst w
  have hMN : M = N := Subtype.ext hM
  subst N
  rfl

theorem stratumForget_surjective (r : RankArray n) (F : Type*) [Field F] :
    Function.Surjective (stratumForget r F) := by
  intro M
  obtain ⟨w, hw, _⟩ := exists_unique_symmetric_rook M.val
  let v : BoundedRooks r := ⟨w, by rw [hw]; exact M.property⟩
  let N : StratumPoints w.val.rankProfile F :=
    ⟨M.val, (stratumPoints_field_iff w.val.rankProfile M.val).mpr hw.symm⟩
  exact ⟨⟨v, N⟩, rfl⟩

/-- A genuine disjoint-union equivalence, using no hypothetical rank
profiles and no characteristic restriction. -/
def rankLocusStrataEquiv (r : RankArray n) (F : Type*) [Field F] :
    RankLocusPoints r F ≃ Σ w : BoundedRooks r, StratumPoints w.val.val.rankProfile F :=
  (Equiv.ofBijective (stratumForget r F)
    ⟨stratumForget_injective r F, stratumForget_surjective r F⟩).symm

/-- The complete point-count formula, even for an arbitrary (possibly
unrealizable) symmetric rank bound. In particular it applies to every `X_w`
in Proposition 6.5. No finite search or bound on the matrix size is used. -/
theorem card_rankLocus (r : RankArray n) (F : Type*) [Field F] [Fintype F] :
    Nat.card (RankLocusPoints r F) =
      ∑ w : BoundedRooks r, Nat.card F ^ w.val.a * (Nat.card F - 1) ^ w.val.b := by
  classical
  rw [Nat.card_congr (rankLocusStrataEquiv r F), Nat.card_sigma]
  apply Fintype.sum_congr
  intro w
  exact w.val.card_stratum_finite_field F

theorem proposition_6_5_point_count (w : SymmetricRook n)
    (F : Type*) [Field F] [Fintype F] :
    Nat.card (RankLocusPoints w.val.rankProfile F) =
      ∑ v : BoundedRooks w.val.rankProfile,
        Nat.card F ^ v.val.a * (Nat.card F - 1) ^ v.val.b :=
  card_rankLocus w.val.rankProfile F

end FourPapers.Symmetric.Strata
end
end
