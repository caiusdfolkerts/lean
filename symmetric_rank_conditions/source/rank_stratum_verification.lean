section

set_option autoImplicit false
set_option maxHeartbeats 1800000

/-!
# Proposition 6.5: dimension, rationality, and generic smoothness

Every scheme here is the spectrum of the original northwest-minor quotient
or its independently defined exact-rank open. The product chart is an actual
scheme isomorphism compatible with the coefficient ring. The dimension is
ordinary Krull dimension, rationality is witnessed by a finite-dimensional
affine space, and smoothness is the scheme-theoretic morphism property.
-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open CategoryTheory AlgebraicGeometry Topology

universe u
variable {n : ℕ}

/-- Composing with a scheme isomorphism preserves the image.  Keeping the
isomorphism abstract avoids evaluating its construction on individual points. -/
private theorem range_iso_hom_comp {X Y Z : Scheme.{u}}
    (e : X ≅ Y) (f : Y ⟶ Z) : Set.range (e.hom ≫ f) = Set.range f := by
  change Set.range (fun x => f (e.hom x)) = Set.range f
  exact (Scheme.homeoOfIso e).surjective.range_comp f

namespace SymmetricRook

variable (w : SymmetricRook n) (R : Type u) [CommRing R]

/-- The original rank locus, with its actual coefficient-ring structure. -/
def locusStructureMap : rankLocusScheme w.val.rankProfile R ⟶ Spec (CommRingCat.of R) :=
  Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap w.val.rankProfile R))

/-- The product chart as an isomorphism in the category of schemes over
the original coefficient base. -/
def openSchemeIsoOver :
    Over.mk (AffineTorus.structureMap R w.a w.b) ≅
      Over.mk (rankStratumImmersion w.val.rankProfile R ≫ w.locusStructureMap R) :=
  Over.isoMk (w.openSchemeIso R) (by
    change (w.openSchemeIso R).hom ≫
      (rankStratumImmersion w.val.rankProfile R ≫ w.locusStructureMap R) =
        AffineTorus.structureMap R w.a w.b
    simpa only [locusStructureMap, AffineTorus.structureMap, Category.assoc]
      using w.openSchemeIso_over R)

/-- The integral product isomorphism survives every scheme base change,
including non-affine bases. This is the actual pullback functor applied to
the previously constructed isomorphism over the coefficient ring. -/
def openSchemeIso_after_baseChange {T : Scheme.{u}} (f : T ⟶ Spec (CommRingCat.of R)) :
    Limits.pullback (AffineTorus.structureMap R w.a w.b) f ≅
      Limits.pullback (rankStratumImmersion w.val.rankProfile R ≫ w.locusStructureMap R) f :=
  (Over.forget T).mapIso ((Over.pullback f).mapIso (w.openSchemeIsoOver R))

/-- The pulled-back isomorphism respects the new base scheme as well. -/
theorem openSchemeIso_after_baseChange_over {T : Scheme.{u}}
    (f : T ⟶ Spec (CommRingCat.of R)) :
    (w.openSchemeIso_after_baseChange R f).hom ≫
        Limits.pullback.snd (rankStratumImmersion w.val.rankProfile R ≫ w.locusStructureMap R) f =
      Limits.pullback.snd (AffineTorus.structureMap R w.a w.b) f :=
  Over.w (((Over.pullback f).mapIso (w.openSchemeIsoOver R)).hom)

/-- The product chart included in the original northwest rank locus. -/
def openChartImmersion :
    Spec (CommRingCat.of (AffineTorus.CoordinateRing R w.a w.b)) ⟶
      rankLocusScheme w.val.rankProfile R :=
  (w.openSchemeIso R).hom ≫ rankStratumImmersion w.val.rankProfile R

instance : IsOpenImmersion (w.openChartImmersion R) := by
  change IsOpenImmersion ((w.openSchemeIso R).hom ≫
    rankStratumImmersion w.val.rankProfile R)
  infer_instance

@[simp] theorem openChartImmersion_over :
    w.openChartImmersion R ≫ w.locusStructureMap R =
      AffineTorus.structureMap R w.a w.b :=
  w.openSchemeIso_over R

/-- Its image is exactly the prescribed rank-equality stratum. -/
theorem openChartImmersion_range :
    Set.range (w.openChartImmersion R) = rankStratumOpen w.val.rankProfile R := by
  change Set.range ((w.openSchemeIso R).hom ≫
    rankStratumImmersion w.val.rankProfile R) = _
  exact (range_iso_hom_comp (w.openSchemeIso R)
    (rankStratumImmersion w.val.rankProfile R)).trans
      (range_rankStratumImmersion w.val.rankProfile R)

/-- The entire exact-rank stratum is smooth over its arbitrary base ring. -/
theorem stratumStructureMap_smooth :
    Smooth (rankStratumImmersion w.val.rankProfile R ≫ w.locusStructureMap R) := by
  letI : Smooth (AffineTorus.structureMap R w.a w.b) :=
    AffineTorus.structureMap_smooth R w.a w.b
  have heq : rankStratumImmersion w.val.rankProfile R ≫ w.locusStructureMap R =
      (w.openSchemeIso R).inv ≫ AffineTorus.structureMap R w.a w.b := by
    have h := congrArg (fun g => (w.openSchemeIso R).inv ≫ g)
      (w.openSchemeIso_over R)
    simpa only [locusStructureMap, AffineTorus.structureMap, Category.assoc,
      CategoryTheory.Iso.inv_hom_id_assoc] using h
  rw [heq]
  infer_instance

section Field
variable (F : Type u) [Field F]

instance : IsDominant (w.openChartImmersion F) := by
  constructor
  rw [DenseRange, openChartImmersion_range]
  exact rankStratumOpen_dense w F

/-- The literal rank locus is birational over its field to its explicit
product chart. -/
theorem locus_birational_chart :
    Scheme.BirationalOver (w.locusStructureMap F)
      (AffineTorus.structureMap F w.a w.b) :=
  ((w.openChartImmersion F).birationalOver (w.locusStructureMap F)
    (AffineTorus.structureMap F w.a w.b) (w.openChartImmersion_over F)).symm

/-- Rationality with a finite-dimensional affine-space witness containing
exactly `a(w)+b(w)` variables. -/
theorem locus_birational_affineSpace :
    Scheme.BirationalOver (w.locusStructureMap F)
      (𝔸(AffineTorus.AffineIndices w.a w.b; Spec (CommRingCat.of F)) ↘
        Spec (CommRingCat.of F)) :=
  (w.locus_birational_chart F).trans
    (AffineTorus.structureMap_birational_affineSpace w.a w.b F)

/-- Rationality in Mathlib's native scheme-theoretic sense. -/
theorem locus_rational : Scheme.IsRationalOver (w.locusStructureMap F) :=
  ⟨AffineTorus.AffineIndices w.a w.b, w.locus_birational_affineSpace F⟩

/-- Dimension of the actual open rank-stratum scheme. -/
theorem stratum_dimension :
    topologicalKrullDim (rankStratumScheme w.val.rankProfile F) = w.a + w.b := by
  rw [← IsHomeomorph.topologicalKrullDim_eq _
    (Scheme.homeoOfIso (w.openSchemeIso F)).isHomeomorph]
  change topologicalKrullDim
    (PrimeSpectrum (AffineTorus.CoordinateRing F w.a w.b)) = _
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
  exact AffineTorus.coordinateRing_dimension w.a w.b F

/-- A nonempty exact-rank open has the dimension of the original affine
rank locus. The required finite-type and domain hypotheses are proved from
the literal coordinate quotient and the verified primality theorem. -/
theorem locus_dimension_eq_stratum :
    topologicalKrullDim (rankLocusScheme w.val.rankProfile F) =
      topologicalKrullDim (rankStratumScheme w.val.rankProfile F) := by
  letI := rankLocusRing_isDomain w F
  have h := DimensionTheory.topologicalKrullDim_inter_eq_of_finiteType F
    (Z := (Set.univ : Set (PrimeSpectrum (RankLocusRing w.val.rankProfile F))))
    (U := rankStratumOpen w.val.rankProfile F)
    (IrreducibleSpace.isIrreducible_univ _) isClosed_univ
    (rankStratumOpen_isOpen w.val.rankProfile F)
    (by simpa only [Set.univ_inter] using rankStratumOpen_nonempty w F)
  have hu := IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ
    (PrimeSpectrum (RankLocusRing w.val.rankProfile F))).isHomeomorph
  have hi := IsHomeomorph.topologicalKrullDim_eq _
    (Homeomorph.setCongr (Set.univ_inter (rankStratumOpen w.val.rankProfile F))).isHomeomorph
  change topologicalKrullDim (PrimeSpectrum (RankLocusRing w.val.rankProfile F)) =
    topologicalKrullDim ↥(rankStratumOpen w.val.rankProfile F)
  exact hu.symm.trans (h.symm.trans hi)

/-- The full dimension assertion in Proposition 6.5, with ordinary Krull
dimension and all northwest rank bounds retained. -/
theorem locus_dimension :
    ringKrullDim (RankLocusRing w.val.rankProfile F) = w.a + w.b := by
  rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
  exact (w.locus_dimension_eq_stratum F).trans (w.stratum_dimension F)

/-- Generic smoothness is witnessed by the original exact-rank stratum,
whose density and actual smooth structure morphism are both established. -/
theorem locus_generically_smooth :
    ∃ U : (rankLocusScheme w.val.rankProfile F).Opens,
      Dense (U : Set (rankLocusScheme w.val.rankProfile F)) ∧
        Smooth (U.ι ≫ w.locusStructureMap F) :=
  ⟨rankStratumOpens w.val.rankProfile F, rankStratumOpen_dense w F,
    w.stratumStructureMap_smooth F⟩

end Field
end SymmetricRook

/-- All geometric conclusions of Proposition 6.5 for every symmetric
partial permutation and every field. The integral product isomorphism and
the unrestricted finite-field count are provided by `openSchemeIso` and
`proposition_6_5_point_count`, respectively. -/
theorem proposition_6_5_geometry (w : SymmetricRook n) (F : Type u) [Field F] :
    Dense (rankStratumOpen w.val.rankProfile F) ∧
      ringKrullDim (RankLocusRing w.val.rankProfile F) = w.a + w.b ∧
      Scheme.IsRationalOver (w.locusStructureMap F) ∧
      ∃ U : (rankLocusScheme w.val.rankProfile F).Opens,
        Dense (U : Set (rankLocusScheme w.val.rankProfile F)) ∧
          Smooth (U.ι ≫ w.locusStructureMap F) :=
  ⟨rankStratumOpen_dense w F, w.locus_dimension F,
    w.locus_rational F, w.locus_generically_smooth F⟩

end FourPapers.Symmetric.Strata
