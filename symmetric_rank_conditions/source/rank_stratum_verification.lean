section

set_option autoImplicit false
set_option maxHeartbeats 1600000

/-!
# The actual open rank stratum on arbitrary coefficient rings

A homomorphism from the northwest-minor quotient is determined by its
coefficient homomorphism and the entries of its actual symmetric matrix.
The open image condition is exactly the independently defined condition of
exact minor ranks. This supplies the all-ring dictionary needed to identify
the open subscheme with the affine-times-torus product by naturality.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Matrix MvPolynomial Pivot

universe u v w
variable {n : ℕ} {R : Type u} {S : Type v} {T : Type w}
  [CommRing R] [CommRing S] [CommRing T]

/-- The actual coefficient map into the rank-condition quotient. -/
def rankLocusCoefficientMap (r : RankArray n) (R : Type u) [CommRing R] :
    R →+* RankLocusRing r R :=
  (Ideal.Quotient.mk (northwestIdeal R r)).comp MvPolynomial.C

@[simp] theorem fold_entry_coordinates (e : Entry n) : fold e.val.1 e.val.2 = e := by
  apply Subtype.ext
  change (max e.val.1 e.val.2, min e.val.1 e.val.2) = (e.val.1, e.val.2)
  rw [max_eq_left e.property, min_eq_right e.property]

/-- Evaluation retains an arbitrary coefficient homomorphism. -/
def matrixEvaluation₂ (φ : R →+* S) (M : SymmetricMatrices n S) :
    CoordinateRing n R →+* S :=
  MvPolynomial.eval₂Hom φ (matrixCoordinates M)

@[simp] theorem matrixEvaluation₂_C (φ : R →+* S) (M : SymmetricMatrices n S) (a : R) :
    matrixEvaluation₂ φ M (C a) = φ a := by simp [matrixEvaluation₂]

@[simp] theorem matrixEvaluation₂_X (φ : R →+* S) (M : SymmetricMatrices n S) (e : Entry n) :
    matrixEvaluation₂ φ M (X e) = M.val e.val.1 e.val.2 := by
  simp [matrixEvaluation₂, matrixCoordinates]

@[simp] theorem matrixEvaluation₂_generic (φ : R →+* S) (M : SymmetricMatrices n S) :
    (genericMatrix n R).map (matrixEvaluation₂ φ M) = M.val := by
  ext i j
  simp [matrixEvaluation₂, genericMatrix]

/-- The larger prescribed minors vanish under the actual evaluation. -/
theorem northwestIdeal_le_ker_matrixEvaluation₂ (r : RankArray n)
    (φ : R →+* S) (M : StratumPoints r S) :
    northwestIdeal R r ≤ RingHom.ker (matrixEvaluation₂ φ M.val) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, j, a, b, ha, hb, rfl⟩
  let a' : Fin (r i j + 1) → {p : Fin n // p ≤ i} := fun p => ⟨a p, ha p⟩
  let b' : Fin (r i j + 1) → {q : Fin n // q ≤ j} := fun q => ⟨b q, hb q⟩
  have hz := det_submatrix_mem_matrixMinorIdeal (prefixMatrix M.val.val i j)
    (r i j + 1) a' b'
  rw [(M.property i j).2] at hz
  have hz' := Ideal.mem_bot.mp hz
  change matrixEvaluation₂ φ M.val (((genericMatrix n R).submatrix a b).det) = 0
  rw [RingHom.map_det]
  change (((genericMatrix n R).submatrix a b).map (matrixEvaluation₂ φ M.val)).det = 0
  have hmatrix : ((genericMatrix n R).submatrix a b).map (matrixEvaluation₂ φ M.val) =
      (prefixMatrix M.val.val i j).submatrix a' b' := by
    ext p q
    simp [a', b', prefixMatrix, matrixEvaluation₂, genericMatrix]
  rw [hmatrix]
  exact hz'

def stratumEvaluation₂ (r : RankArray n) (φ : R →+* S) (M : StratumPoints r S) :
    RankLocusRing r R →+* S :=
  Ideal.Quotient.lift (northwestIdeal R r) (matrixEvaluation₂ φ M.val)
    (fun f hf => northwestIdeal_le_ker_matrixEvaluation₂ r φ M hf)

@[simp] theorem stratumEvaluation₂_coefficient (r : RankArray n)
    (φ : R →+* S) (M : StratumPoints r S) :
    (stratumEvaluation₂ r φ M).comp (rankLocusCoefficientMap r R) = φ := by
  ext a
  change matrixEvaluation₂ φ M.val (C a) = φ a
  exact matrixEvaluation₂_C φ M.val a

@[simp] theorem stratumEvaluation₂_universal (r : RankArray n)
    (φ : R →+* S) (M : StratumPoints r S) :
    (universalMatrix r R).map (stratumEvaluation₂ r φ M) = M.val.val := by
  ext i j
  simp [universalMatrix, stratumEvaluation₂, matrixEvaluation₂, genericMatrix]

/-- The actual universal matrix, specialized by a quotient-ring map. -/
def mappedUniversalMatrix (r : RankArray n) (f : RankLocusRing r R →+* S) :
    SymmetricMatrices n S :=
  ⟨(universalMatrix r R).map f, by
    intro i j
    simp only [universalMatrix, Matrix.map_apply, genericMatrix_apply, fold_comm i j]⟩

@[simp] theorem matrixCoordinates_mappedUniversalMatrix (r : RankArray n)
    (f : RankLocusRing r R →+* S) (e : Entry n) :
    matrixCoordinates (mappedUniversalMatrix r f) e =
      f (Ideal.Quotient.mk (northwestIdeal R r) (X e)) := by
  simp [matrixCoordinates, mappedUniversalMatrix, universalMatrix, genericMatrix]

/-- Maps whose actual prime-spectrum image is contained in the prescribed
open subset of the northwest rank locus. -/
abbrev RankStratumOpenPoint (r : RankArray n) (R : Type u) [CommRing R]
    (S : Type v) [CommRing S] :=
  {f : RankLocusRing r R →+* S //
    Set.range (PrimeSpectrum.comap f) ⊆ rankStratumOpen r R}

def rankStratumOpenPointData (r : RankArray n)
    (f : RankStratumOpenPoint r R S) : (R →+* S) × StratumPoints r S :=
  (f.val.comp (rankLocusCoefficientMap r R),
    ⟨mappedUniversalMatrix r f.val, (map_lands_in_rankStratumOpen_iff r R f.val).mp f.property⟩)

def rankStratumOpenPointOfData (r : RankArray n)
    (p : (R →+* S) × StratumPoints r S) : RankStratumOpenPoint r R S :=
  ⟨stratumEvaluation₂ r p.1 p.2, by
    apply (map_lands_in_rankStratumOpen_iff r R _).mpr
    rw [stratumEvaluation₂_universal]
    exact p.2.property⟩

theorem rankStratumOpenPointOfData_data (r : RankArray n)
    (f : RankStratumOpenPoint r R S) :
    rankStratumOpenPointOfData r (rankStratumOpenPointData r f) = f := by
  apply Subtype.ext
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro a
    simp [rankStratumOpenPointOfData, rankStratumOpenPointData, stratumEvaluation₂,
      rankLocusCoefficientMap]
  · intro e
    simp [rankStratumOpenPointOfData, rankStratumOpenPointData, stratumEvaluation₂,
      matrixEvaluation₂, matrixCoordinates_mappedUniversalMatrix]

theorem rankStratumOpenPointData_ofData (r : RankArray n)
    (p : (R →+* S) × StratumPoints r S) :
    rankStratumOpenPointData r (rankStratumOpenPointOfData r p) = p := by
  apply Prod.ext
  · exact stratumEvaluation₂_coefficient r p.1 p.2
  · apply Subtype.ext
    apply Subtype.ext
    exact stratumEvaluation₂_universal r p.1 p.2

/-- The literal all-ring point dictionary for the independently constructed
open rank stratum. Both its coefficient map and its matrix are retained. -/
def rankStratumOpenPointEquiv (r : RankArray n) (R : Type u) [CommRing R]
    (S : Type v) [CommRing S] :
    RankStratumOpenPoint r R S ≃ (R →+* S) × StratumPoints r S where
  toFun := rankStratumOpenPointData r
  invFun := rankStratumOpenPointOfData r
  left_inv := rankStratumOpenPointOfData_data r
  right_inv := rankStratumOpenPointData_ofData r

/-- Postcomposition is the functorial action on these actual open points. -/
def rankStratumOpenPointMap (r : RankArray n) (ψ : S →+* T)
    (f : RankStratumOpenPoint r R S) : RankStratumOpenPoint r R T :=
  ⟨ψ.comp f.val, by
    apply (map_lands_in_rankStratumOpen_iff r R _).mpr
    intro i j
    change ExactMinorRank ((prefixMatrix ((universalMatrix r R).map f.val) i j).map ψ) (r i j)
    exact ((map_lands_in_rankStratumOpen_iff r R f.val).mp f.property i j).map ψ⟩

theorem rankStratumOpenPointEquiv_natural (r : RankArray n) (ψ : S →+* T)
    (f : RankStratumOpenPoint r R S) :
    rankStratumOpenPointEquiv r R T (rankStratumOpenPointMap r ψ f) =
      (ψ.comp (rankStratumOpenPointEquiv r R S f).1,
        StratumPoints.map r ψ (rankStratumOpenPointEquiv r R S f).2) := by
  apply Prod.ext
  · rfl
  · apply Subtype.ext
    apply Subtype.ext
    rfl

theorem rankStratumOpenPointEquiv_symm_natural (r : RankArray n) (ψ : S →+* T)
    (p : (R →+* S) × StratumPoints r S) :
    (rankStratumOpenPointEquiv r R T).symm (ψ.comp p.1, StratumPoints.map r ψ p.2) =
      rankStratumOpenPointMap r ψ ((rankStratumOpenPointEquiv r R S).symm p) := by
  apply (rankStratumOpenPointEquiv r R T).injective
  rw [Equiv.apply_symm_apply, rankStratumOpenPointEquiv_natural, Equiv.apply_symm_apply]

end FourPapers.Symmetric.Strata
