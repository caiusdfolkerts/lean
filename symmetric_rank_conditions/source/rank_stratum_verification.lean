section

set_option autoImplicit false
set_option maxHeartbeats 600000

noncomputable section

/-!
# Deleting zero rows and columns from determinantal conditions

The statements use the actual ideal of all minors, with the minor size
unchanged when a zero row or column is removed. The index types are arbitrary
finite types, so the results apply after any prefix reindexing in the
off-diagonal Schur chart.
-/

namespace FourPapers.Symmetric

open scoped Matrix

namespace BlockMatrix

variable {S a a₁ a₂ b b₁ b₂ c : Type*}

/-- Concatenation of rectangular row blocks, as an actual matrix. -/
def fromRows (A : Matrix a₁ b S) (B : Matrix a₂ b S) : Matrix (a₁ ⊕ a₂) b S :=
  fun i j => Sum.elim (fun x => A x j) (fun x => B x j) i

/-- Concatenation of rectangular column blocks, as an actual matrix. -/
def fromCols (A : Matrix a b₁ S) (B : Matrix a b₂ S) : Matrix a (b₁ ⊕ b₂) S :=
  fun i => Sum.elim (A i) (B i)

@[simp] theorem fromRows_inl (A : Matrix a₁ b S) (B : Matrix a₂ b S) (i : a₁) (j : b) :
    fromRows A B (.inl i) j = A i j := rfl
@[simp] theorem fromRows_inr (A : Matrix a₁ b S) (B : Matrix a₂ b S) (i : a₂) (j : b) :
    fromRows A B (.inr i) j = B i j := rfl
@[simp] theorem fromCols_inl (A : Matrix a b₁ S) (B : Matrix a b₂ S) (i : a) (j : b₁) :
    fromCols A B i (.inl j) = A i j := rfl
@[simp] theorem fromCols_inr (A : Matrix a b₁ S) (B : Matrix a b₂ S) (i : a) (j : b₂) :
    fromCols A B i (.inr j) = B i j := rfl

theorem transpose_fromRows (A : Matrix a₁ b S) (B : Matrix a₂ b S) :
    (fromRows A B).transpose = fromCols A.transpose B.transpose := by
  ext i j
  cases j <;> rfl

variable [Semiring S]

theorem fromCols_mulVec_sumElim [Fintype b₁] [Fintype b₂]
    (A : Matrix a b₁ S) (B : Matrix a b₂ S) (v : b₁ → S) (w : b₂ → S) :
    fromCols A B *ᵥ Sum.elim v w = A *ᵥ v + B *ᵥ w := by
  ext i
  simp [Matrix.mulVec, fromCols, dotProduct]

theorem fromCols_mulVec [Fintype b₁] [Fintype b₂]
    (A : Matrix a b₁ S) (B : Matrix a b₂ S) (v : b₁ ⊕ b₂ → S) :
    fromCols A B *ᵥ v = A *ᵥ (v ∘ Sum.inl) + B *ᵥ (v ∘ Sum.inr) := by
  convert fromCols_mulVec_sumElim A B (v ∘ Sum.inl) (v ∘ Sum.inr) using 1
  congr 1
  funext j
  cases j <;> rfl

theorem fromRows_mul [Fintype b]
    (A : Matrix a₁ b S) (B : Matrix a₂ b S) (C : Matrix b c S) :
    fromRows A B * C = fromRows (A * C) (B * C) := by
  ext i j
  cases i <;> rfl

theorem fromRows_mul_fromCols [Fintype b]
    (A : Matrix a₁ b S) (B : Matrix a₂ b S)
    (C : Matrix b b₁ S) (D : Matrix b b₂ S) :
    fromRows A B * fromCols C D = Matrix.fromBlocks (A * C) (A * D) (B * C) (B * D) := by
  ext i j
  cases i <;> cases j <;> rfl

end BlockMatrix

variable {R m n p z z₁ z₂ : Type*} [CommRing R]
variable [Fintype m] [Fintype n]

theorem matrixMinorIdeal_zero_succ (t : ℕ) :
    matrixMinorIdeal (0 : Matrix m n R) (t + 1) = ⊥ := by
  apply le_antisymm ?_ bot_le
  apply Ideal.span_le.mpr
  rintro _ ⟨a, b, rfl⟩
  change (0 : Matrix (Fin (t + 1)) (Fin (t + 1)) R).det ∈ (⊥ : Ideal R)
  rw [Matrix.det_zero]
  exact Ideal.zero_mem _

theorem matrixMinorIdeal_fromCols_zero_right [Fintype z]
    (A : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (BlockMatrix.fromCols A (0 : Matrix m z R)) t = matrixMinorIdeal A t := by
  classical
  have hrange : LinearMap.range (BlockMatrix.fromCols A (0 : Matrix m z R)).mulVecLin =
      LinearMap.range A.mulVecLin := by
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      refine ⟨fun i => v (.inl i), ?_⟩
      change A *ᵥ (v ∘ Sum.inl) = BlockMatrix.fromCols A (0 : Matrix m z R) *ᵥ v
      rw [BlockMatrix.fromCols_mulVec, Matrix.zero_mulVec, add_zero]
    · rintro ⟨v, rfl⟩
      refine ⟨Sum.elim v (0 : z → R), ?_⟩
      change BlockMatrix.fromCols A (0 : Matrix m z R) *ᵥ Sum.elim v 0 = A *ᵥ v
      rw [BlockMatrix.fromCols_mulVec_sumElim, Matrix.zero_mulVec, add_zero]
  rw [matrixMinorIdeal_eq_minorsIdeal_range, hrange,
    ← matrixMinorIdeal_eq_minorsIdeal_range]

theorem matrixMinorIdeal_fromCols_zero_left [Fintype z]
    (A : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (BlockMatrix.fromCols (0 : Matrix m z R) A) t = matrixMinorIdeal A t := by
  have hm : (BlockMatrix.fromCols A (0 : Matrix m z R)).submatrix
      (Equiv.refl m) (Equiv.sumComm z n) = BlockMatrix.fromCols (0 : Matrix m z R) A := by
    ext i j
    cases j <;> rfl
  rw [← hm, matrixMinorIdeal_submatrix_equiv]
  exact matrixMinorIdeal_fromCols_zero_right A t

theorem matrixMinorIdeal_fromRows_zero_right [Fintype z]
    (A : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (BlockMatrix.fromRows A (0 : Matrix z n R)) t = matrixMinorIdeal A t := by
  rw [← matrixMinorIdeal_transpose (BlockMatrix.fromRows A (0 : Matrix z n R)),
    BlockMatrix.transpose_fromRows, Matrix.transpose_zero,
    matrixMinorIdeal_fromCols_zero_right, matrixMinorIdeal_transpose]

theorem matrixMinorIdeal_fromRows_zero_left [Fintype z]
    (A : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (BlockMatrix.fromRows (0 : Matrix z n R) A) t = matrixMinorIdeal A t := by
  rw [← matrixMinorIdeal_transpose (BlockMatrix.fromRows (0 : Matrix z n R) A),
    BlockMatrix.transpose_fromRows, Matrix.transpose_zero,
    matrixMinorIdeal_fromCols_zero_left, matrixMinorIdeal_transpose]

theorem matrixMinorIdeal_zero_border [Fintype z₁] [Fintype z₂]
    (A : Matrix m n R) (t : ℕ) :
    matrixMinorIdeal (Matrix.fromBlocks (0 : Matrix z₁ z₂ R) 0 0 A) t =
      matrixMinorIdeal A t := by
  have hm : Matrix.fromBlocks (0 : Matrix z₁ z₂ R) 0 0 A =
      BlockMatrix.fromRows (0 : Matrix z₁ (z₂ ⊕ n) R)
        (BlockMatrix.fromCols (0 : Matrix m z₂ R) A) := by
    ext i j
    cases i <;> cases j <;> rfl
  rw [hm, matrixMinorIdeal_fromRows_zero_left, matrixMinorIdeal_fromCols_zero_left]

/-- An isolated invertible block contributes its full rank, while an
additional zero column contributes nothing to the residual condition. -/
theorem matrixMinorIdeal_unit_with_zero_columns [Fintype p] [DecidableEq p] [Fintype z]
    (A : Matrix p p R) (D : Matrix m n R) (hA : IsUnit A) (t : ℕ) :
    matrixMinorIdeal
      (Matrix.fromBlocks A 0 0 (BlockMatrix.fromCols (0 : Matrix m z R) D))
        (t + Fintype.card p) = matrixMinorIdeal D t := by
  rw [matrixMinorIdeal_fromBlocks_unit_first A _ hA,
    matrixMinorIdeal_fromCols_zero_left]

theorem matrixMinorIdeal_unit_with_zero_rows [Fintype p] [DecidableEq p] [Fintype z]
    (A : Matrix p p R) (D : Matrix m n R) (hA : IsUnit A) (t : ℕ) :
    matrixMinorIdeal
      (Matrix.fromBlocks A 0 0 (BlockMatrix.fromRows (0 : Matrix z n R) D))
        (t + Fintype.card p) = matrixMinorIdeal D t := by
  rw [matrixMinorIdeal_fromBlocks_unit_first A _ hA,
    matrixMinorIdeal_fromRows_zero_left]

/-- The corresponding rank equality concerns actual field-valued matrices,
not a definition of rank through their formal determinantal ideals. -/
theorem matrix_rank_zero_border {F : Type*} [Field F] [Fintype z₁] [Fintype z₂]
    (A : Matrix m n F) :
    (Matrix.fromBlocks (0 : Matrix z₁ z₂ F) 0 0 A).rank = A.rank := by
  classical
  let L := BlockMatrix.fromRows (0 : Matrix z₁ m F) (1 : Matrix m m F)
  let Q := BlockMatrix.fromCols (0 : Matrix n z₂ F) (1 : Matrix n n F)
  have hm : L * A * Q = Matrix.fromBlocks (0 : Matrix z₁ z₂ F) 0 0 A := by
    dsimp [L, Q]
    rw [BlockMatrix.fromRows_mul, Matrix.zero_mul, Matrix.one_mul,
      BlockMatrix.fromRows_mul_fromCols]
    simp only [Matrix.zero_mul, Matrix.mul_zero, Matrix.mul_one]
  apply le_antisymm
  · rw [← hm]
    exact (Matrix.rank_mul_le_left (L * A) Q).trans (Matrix.rank_mul_le_right L A)
  · have h := Matrix.rank_submatrix_le
      (Matrix.fromBlocks (0 : Matrix z₁ z₂ F) 0 0 A)
      (Sum.inr : m → z₁ ⊕ m) (Sum.inr : n → z₂ ⊕ n)
    exact h

end FourPapers.Symmetric
end
end
