set_option maxHeartbeats 1600000

/-!
# Rational points of the original rank-locus scheme

The finite-field count applies to actual morphisms `Spec F → X_w` over
`Spec F`. The coefficient condition is retained explicitly: arbitrary ring
maps, which can also contain a field endomorphism, are not substituted for
rational points. The comparison with literal rank-bounded matrices is proved
using the original quotient and the matrix-rank criterion for vanishing minors.
-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open CategoryTheory AlgebraicGeometry Matrix MvPolynomial

universe u
variable {n : ℕ} (r : RankArray n) (F : Type u) [Field F]

/-- Actual rational points of the original affine scheme over its field. -/
def RankLocusRationalPoints :=
  {g : Spec (CommRingCat.of F) ⟶ rankLocusScheme r F //
    g ≫ Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap r F)) = 𝟙 _}

/-- The ring-map form of the same coefficient compatibility condition. -/
def RankLocusCoefficientPoints :=
  {f : RankLocusRing r F →+* F //
    f.comp (rankLocusCoefficientMap r F) = RingHom.id F}

variable {F}

theorem northwestIdeal_le_ker_of_rank_bounds (M : RankLocusPoints r F) :
    northwestIdeal F r ≤ RingHom.ker (matrixEvaluation₂ (RingHom.id F) M.val) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, j, a, b, ha, hb, rfl⟩
  let a' : Fin (r i j + 1) → {p : Fin n // p ≤ i} := fun p => ⟨a p, ha p⟩
  let b' : Fin (r i j + 1) → {q : Fin n // q ≤ j} := fun q => ⟨b q, hb q⟩
  have hzero : matrixMinorIdeal (prefixMatrix M.val.val i j) (r i j + 1) = ⊥ :=
    (matrixMinorIdeal_eq_bot_iff_rank_lt _ _).mpr (Nat.lt_succ_of_le (M.property i j))
  have hz := det_submatrix_mem_matrixMinorIdeal (prefixMatrix M.val.val i j)
    (r i j + 1) a' b'
  rw [hzero] at hz
  change matrixEvaluation₂ (RingHom.id F) M.val
    (((genericMatrix n F).submatrix a b).det) = 0
  rw [RingHom.map_det]
  change (((genericMatrix n F).submatrix a b).map
    (matrixEvaluation₂ (RingHom.id F) M.val)).det = 0
  have hm : ((genericMatrix n F).submatrix a b).map
      (matrixEvaluation₂ (RingHom.id F) M.val) =
        (prefixMatrix M.val.val i j).submatrix a' b' := by
    ext p q
    simp [a', b', prefixMatrix, matrixEvaluation₂, genericMatrix]
  rw [hm]
  exact Ideal.mem_bot.mp hz

/-- The quotient-ring evaluation of an actual rank-bounded matrix. -/
def rankLocusEvaluation (M : RankLocusPoints r F) : RankLocusRing r F →+* F :=
  Ideal.Quotient.lift (northwestIdeal F r)
    (matrixEvaluation₂ (RingHom.id F) M.val)
    (fun f hf => northwestIdeal_le_ker_of_rank_bounds r M hf)

@[simp] theorem rankLocusEvaluation_coefficient (M : RankLocusPoints r F) :
    (rankLocusEvaluation r M).comp (rankLocusCoefficientMap r F) = RingHom.id F := by
  ext a
  change matrixEvaluation₂ (RingHom.id F) M.val (C a) = a
  exact matrixEvaluation₂_C (RingHom.id F) M.val a

@[simp] theorem rankLocusEvaluation_universal (M : RankLocusPoints r F) :
    (universalMatrix r F).map (rankLocusEvaluation r M) = M.val.val := by
  ext i j
  simp [universalMatrix, rankLocusEvaluation, matrixEvaluation₂, genericMatrix]

/-- Every quotient-ring map gives a matrix satisfying every original bound. -/
def rankLocusMatrixOfCoefficientPoint (f : RankLocusCoefficientPoints r F) :
    RankLocusPoints r F :=
  ⟨mappedUniversalMatrix r f.val, by
    intro i j
    have hz : matrixMinorIdeal
        (prefixMatrix ((universalMatrix r F).map f.val) i j) (r i j + 1) = ⊥ := by
      rw [prefixMatrix_map, ← matrixMinorIdeal_map, universal_upper_minors, Ideal.map_bot]
    exact Nat.lt_succ_iff.mp ((matrixMinorIdeal_eq_bot_iff_rank_lt _ _).mp hz)⟩

/-- Coefficient-compatible quotient maps are precisely the literal matrices
with all northwest rank bounds. -/
def rankLocusCoefficientPointEquiv : RankLocusCoefficientPoints r F ≃ RankLocusPoints r F where
  toFun := rankLocusMatrixOfCoefficientPoint r
  invFun M := ⟨rankLocusEvaluation r M, rankLocusEvaluation_coefficient r M⟩
  left_inv f := by
    apply Subtype.ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      have h := congrArg (fun φ : F →+* F => φ a) f.property
      change matrixEvaluation₂ (RingHom.id F)
        (rankLocusMatrixOfCoefficientPoint r f).val (C a) =
          f.val (Ideal.Quotient.mk (northwestIdeal F r) (C a))
      rw [matrixEvaluation₂_C]
      exact h.symm
    · intro e
      simp [rankLocusEvaluation, rankLocusMatrixOfCoefficientPoint, matrixEvaluation₂,
        matrixCoordinates_mappedUniversalMatrix]
  right_inv M := by
    apply Subtype.ext
    apply Subtype.ext
    exact rankLocusEvaluation_universal r M

/-- The `Spec` correspondence retains the condition of being over the base. -/
def rankLocusRationalPointRingEquiv :
    RankLocusRationalPoints r F ≃ RankLocusCoefficientPoints r F where
  toFun g := ⟨(Spec.preimage g.val).hom, by
    have h := congrArg Spec.preimage g.property
    rw [Spec.preimage_comp, Spec.preimage_map, Spec.preimage_id] at h
    exact congrArg CommRingCat.Hom.hom h⟩
  invFun f := ⟨Spec.map (CommRingCat.ofHom f.val), by
    rw [← Spec.map_comp]
    have h : CommRingCat.ofHom (rankLocusCoefficientMap r F) ≫
        CommRingCat.ofHom f.val = 𝟙 (CommRingCat.of F) := by
      ext a
      exact congrArg (fun φ : F →+* F => φ a) f.property
    rw [h, Spec.map_id]⟩
  left_inv g := by
    apply Subtype.ext
    exact Spec.map_preimage g.val
  right_inv f := by
    apply Subtype.ext
    simp only [Spec.preimage_map, CommRingCat.hom_ofHom]

/-- A proved identification with the conventional scheme-theoretic
rational points of the actual northwest rank locus. -/
def rankLocusRationalPointEquiv : RankLocusRationalPoints r F ≃ RankLocusPoints r F :=
  (rankLocusRationalPointRingEquiv r).trans (rankLocusCoefficientPointEquiv r)

/-- Proposition 6.5's count for actual `F`-rational points over `Spec F`. -/
theorem proposition_6_5_scheme_point_count (w : SymmetricRook n) [Fintype F] :
    Nat.card (RankLocusRationalPoints w.val.rankProfile F) =
      ∑ v : BoundedRooks w.val.rankProfile,
        Nat.card F ^ v.val.a * (Nat.card F - 1) ^ v.val.b := by
  rw [Nat.card_congr (rankLocusRationalPointEquiv (F := F) w.val.rankProfile)]
  exact proposition_6_5_point_count w F

end FourPapers.Symmetric.Strata
end
end
