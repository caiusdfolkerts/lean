noncomputable section

/-!
# Every symmetric rank profile has a unique symmetric rook representative

The proof uses the actual zero, diagonal, and paired Schur charts. Rook
constructors have literal Boolean entries; their zero-one matrices are proved
to be the zero-carrier specializations of those charts. The existence theorem
therefore identifies actual matrix ranks, not a recursively stipulated rank.
-/

namespace FourPapers.Symmetric.Strata

open Matrix Pivot Pivot.OffDiagonal

namespace RookPattern

variable {ι κ ι' κ' : Type*}

def empty (ι κ : Type*) : RookPattern ι κ where
  entry _ _ := false
  row_unique _ _ _ h _ := False.elim (by simpa using h)
  col_unique _ _ _ h _ := False.elim (by simpa using h)

def graph [DecidableEq κ] (e : ι ≃ κ) : RookPattern ι κ where
  entry i j := decide (e i = j)
  row_unique _ _ _ h₁ h₂ := (of_decide_eq_true h₁).symm.trans (of_decide_eq_true h₂)
  col_unique _ _ _ h₁ h₂ := e.injective ((of_decide_eq_true h₁).trans (of_decide_eq_true h₂).symm)

/-- Disjoint diagonal blocks of actual rook positions. -/
def blockSum (v : RookPattern ι κ) (w : RookPattern ι' κ') :
    RookPattern (ι ⊕ ι') (κ ⊕ κ') where
  entry
    | .inl i, .inl j => v.entry i j
    | .inr i, .inr j => w.entry i j
    | _, _ => false
  row_unique := by
    rintro (i | i) (j | j) (k | k) hij hik <;> simp at hij hik
    · exact congrArg Sum.inl (v.row_unique i j k hij hik)
    · exact congrArg Sum.inr (w.row_unique i j k hij hik)
  col_unique := by
    rintro (i | i) (j | j) (k | k) hik hjk <;> simp at hik hjk
    · exact congrArg Sum.inl (v.col_unique i j k hik hjk)
    · exact congrArg Sum.inr (w.col_unique i j k hik hjk)

@[simp] theorem toMatrix_blockSum (v : RookPattern ι κ) (w : RookPattern ι' κ')
    (R : Type*) [Zero R] [One R] :
    (v.blockSum w).toMatrix R =
      Matrix.fromBlocks (v.toMatrix R) 0 0 (w.toMatrix R) := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> rfl

theorem blockSum_symmetric {v : RookPattern ι ι} {w : RookPattern κ κ}
    (hv : ∀ i j, v.entry i j = v.entry j i)
    (hw : ∀ i j, w.entry i j = w.entry j i) :
    ∀ i j, (v.blockSum w).entry i j = (v.blockSum w).entry j i := by
  rintro (i | i) (j | j)
  · exact hv i j
  · rfl
  · rfl
  · exact hw i j

def diagonalRook : RookPattern PUnit.{1} PUnit.{1} := graph (Equiv.refl PUnit.{1})
def pairedRooks : RookPattern Two Two := graph (Equiv.sumComm PUnit.{1} PUnit.{1})

@[simp] theorem diagonalRook_toMatrix (R : Type*) [Zero R] [One R] :
    diagonalRook.toMatrix R = fun _ _ => (1 : R) := by
  ext i j
  cases i; cases j
  rfl

@[simp] theorem pairedRooks_toMatrix (R : Type*) [CommRing R] :
    pairedRooks.toMatrix R = block (1 : R) 0 := by
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> cases i <;> cases j <;> rfl

theorem diagonalRook_symmetric : ∀ i j, diagonalRook.entry i j = diagonalRook.entry j i := by
  intro i j
  cases i; cases j
  rfl

theorem pairedRooks_symmetric : ∀ i j, pairedRooks.entry i j = pairedRooks.entry j i := by
  rintro (i | i) (j | j) <;> cases i <;> cases j <;> rfl

variable {n N : ℕ}

def zeroExtend (w : RookPattern (Fin n) (Fin n)) : RookPattern (Fin (n + 1)) (Fin (n + 1)) :=
  ((empty PUnit.{1} PUnit.{1}).blockSum w).submatrix (frontIndexEquiv n).symm
    (frontIndexEquiv n).symm (frontIndexEquiv n).symm.injective (frontIndexEquiv n).symm.injective

def diagonalExtend (w : RookPattern (Fin n) (Fin n)) :
    RookPattern (Fin (n + 1)) (Fin (n + 1)) :=
  (diagonalRook.blockSum w).submatrix (frontIndexEquiv n).symm
    (frontIndexEquiv n).symm (frontIndexEquiv n).symm.injective (frontIndexEquiv n).symm.injective

def pairedExtend (I : IndexData N n) (w : RookPattern (Fin n) (Fin n)) :
    RookPattern (Fin (N + 1)) (Fin (N + 1)) :=
  (pairedRooks.blockSum w).submatrix I.indexEquiv.symm I.indexEquiv.symm
    I.indexEquiv.symm.injective I.indexEquiv.symm.injective

theorem zeroExtend_symmetric (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    w.zeroExtend.IsSymmetric :=
  fun i j => blockSum_symmetric (fun _ _ => rfl) hw _ _

theorem diagonalExtend_symmetric (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    w.diagonalExtend.IsSymmetric :=
  fun i j => blockSum_symmetric diagonalRook_symmetric hw _ _

theorem pairedExtend_symmetric (I : IndexData N n)
    (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    (w.pairedExtend I).IsSymmetric :=
  fun i j => blockSum_symmetric pairedRooks_symmetric hw _ _

theorem zeroExtend_toMatrix (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric)
    (R : Type*) [CommRing R] :
    w.zeroExtend.toMatrix R = (zeroRowModel ⟨w.toMatrix R, w.toMatrix_symmetric hw R⟩).val := by
  ext i j
  cases i using Fin.cases <;> cases j using Fin.cases <;> rfl

theorem diagonalExtend_toMatrix (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric)
    (R : Type*) [CommRing R] :
    w.diagonalExtend.toMatrix R =
      (diagonalModel (1 : Rˣ) 0 ⟨w.toMatrix R, w.toMatrix_symmetric hw R⟩).val := by
  ext i j
  cases i using Fin.cases <;> cases j using Fin.cases <;>
    simp [diagonalExtend, submatrix, toMatrix, blockSum, diagonalRook, graph,
      frontIndexEquiv, diagonalModel] <;> rfl

theorem pairedExtend_toMatrix (I : IndexData N n)
    (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric)
    (R : Type*) [CommRing R] :
    (w.pairedExtend I).toMatrix R =
      I.offDiagonalMatrix ((1 : Rˣ), 0, ⟨w.toMatrix R, w.toMatrix_symmetric hw R⟩) := by
  ext i j
  obtain ⟨a, rfl⟩ := I.indexEquiv.surjective i
  obtain ⟨b, rfl⟩ := I.indexEquiv.surjective j
  rw [I.offDiagonalMatrix_index]
  change (pairedRooks.blockSum w).toMatrix R
    (I.indexEquiv.symm (I.indexEquiv a)) (I.indexEquiv.symm (I.indexEquiv b)) = _
  rw [Equiv.symm_apply_apply, Equiv.symm_apply_apply, toMatrix_blockSum, pairedRooks_toMatrix]
  have hz (c : IndexData.Carrier n) : I.extendOffDiagonalCarrier (0 : I.FreeCarrier → R) c = 0 := by
    classical
    by_cases hc : I.forcedCarrier c <;> simp [IndexData.extendOffDiagonalCarrier, hc]
  rcases a with (a | a) | a <;> rcases b with (b | b) | b <;>
    simp only [Matrix.of_apply, Matrix.zero_apply, model, Matrix.fromBlocks_apply₁₁,
      Matrix.fromBlocks_apply₁₂,
      Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂, Sum.elim_inl, Sum.elim_inr,
      Matrix.add_apply, hz, correction, Units.val_one, inv_one, zero_mul, mul_zero,
      zero_add, sub_zero, add_zero]

end RookPattern

section ModelRanks
variable {n : ℕ} {F : Type*} [Field F]

theorem matrix_own_exactRanks (M : SymmetricMatrices n F) :
    ∀ i j, ExactMinorRank (prefixMatrix M.val i j) (matrixRankArray M.val i j) :=
  fun i j => (exactMinorRank_iff_rank _ _).mpr rfl

theorem zeroRowModel_rankArray (D : SymmetricMatrices n F) :
    matrixRankArray (zeroRowModel D).val = zeroLiftProfile (matrixRankArray D.val) :=
  (stratumPoints_field_iff _ (zeroRowModel D)).mp
    ((zeroRowModel_stratum_iff _ D).mpr (matrix_own_exactRanks D))

theorem diagonalModel_rankArray (x : Fˣ) (b : Fin n → F) (D : SymmetricMatrices n F) :
    matrixRankArray (diagonalModel x b D).val = diagonalLiftProfile (matrixRankArray D.val) :=
  (stratumPoints_field_iff _ (diagonalModel x b D)).mp
    ((diagonalModel_stratum_iff _ x b D).mpr (matrix_own_exactRanks D))

end ModelRanks

namespace RookPattern
variable {n N : ℕ}

theorem rankProfile_zeroExtend (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    w.zeroExtend.rankProfile = zeroLiftProfile w.rankProfile := by
  rw [← matrixRankArray_toMatrix _ ℚ, zeroExtend_toMatrix w hw ℚ,
    zeroRowModel_rankArray, matrixRankArray_toMatrix]

theorem rankProfile_diagonalExtend (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    w.diagonalExtend.rankProfile = diagonalLiftProfile w.rankProfile := by
  rw [← matrixRankArray_toMatrix _ ℚ, diagonalExtend_toMatrix w hw ℚ,
    diagonalModel_rankArray, matrixRankArray_toMatrix]

theorem rankProfile_pairedExtend (I : IndexData N n)
    (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    (w.pairedExtend I).rankProfile = I.offDiagonalLiftProfile w.rankProfile := by
  rw [← matrixRankArray_toMatrix _ ℚ, pairedExtend_toMatrix I w hw ℚ,
    I.offDiagonalMatrix_rankArray, matrixRankArray_toMatrix]

end RookPattern

namespace StratumRecipe

def rook : {n : ℕ} → (r : StratumRecipe n) → RookPattern (Fin n) (Fin n)
  | _, .empty => RookPattern.empty _ _
  | _, .zero r => r.rook.zeroExtend
  | _, .diagonal r => r.rook.diagonalExtend
  | _, .paired I r => r.rook.pairedExtend I

theorem rook_symmetric : {n : ℕ} → (r : StratumRecipe n) → r.rook.IsSymmetric
  | _, .empty => fun _ _ => rfl
  | _, .zero r => r.rook.zeroExtend_symmetric r.rook_symmetric
  | _, .diagonal r => r.rook.diagonalExtend_symmetric r.rook_symmetric
  | _, .paired I r => r.rook.pairedExtend_symmetric I r.rook_symmetric

theorem rook_rankProfile : {n : ℕ} → (r : StratumRecipe n) → r.rook.rankProfile = r.profile
  | _, .empty => by funext i; exact Fin.elim0 i
  | _, .zero r => by
      change r.rook.zeroExtend.rankProfile = zeroLiftProfile r.profile
      rw [r.rook.rankProfile_zeroExtend r.rook_symmetric, r.rook_rankProfile]
  | _, .diagonal r => by
      change r.rook.diagonalExtend.rankProfile = diagonalLiftProfile r.profile
      rw [r.rook.rankProfile_diagonalExtend r.rook_symmetric, r.rook_rankProfile]
  | _, .paired I r => by
      change (r.rook.pairedExtend I).rankProfile = I.offDiagonalLiftProfile r.profile
      rw [r.rook.rankProfile_pairedExtend I r.rook_symmetric, r.rook_rankProfile]

end StratumRecipe

/-- Every actual symmetric matrix over every field has a profile built by
one of the actual integral charts. The induction is on the matrix size and
uses a genuine first nonzero entry of row zero. -/
theorem exists_recipe_of_symmetric_matrix {F : Type*} [Field F] :
    ∀ n (M : SymmetricMatrices n F), ∃ r : StratumRecipe n, r.profile = matrixRankArray M.val := by
  classical
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    cases n with
    | zero =>
      intro M
      refine ⟨.empty, ?_⟩
      funext i
      exact Fin.elim0 i
    | succ N =>
      intro M
      by_cases hrow : ∀ j, M.val 0 j = 0
      · let U : ZeroFirstRow N F := ⟨M, hrow⟩
        let D := zeroRowDelete U
        obtain ⟨r, hr⟩ := ih N (Nat.lt_succ_self N) D
        refine ⟨.zero r, ?_⟩
        change zeroLiftProfile r.profile = matrixRankArray M.val
        rw [hr, ← zeroRowModel_rankArray]
        exact congrArg (fun A : SymmetricMatrices (N + 1) F => matrixRankArray A.val)
          (congrArg Subtype.val (zeroRowPad_delete U))
      · obtain ⟨j, hj⟩ := not_forall.mp hrow
        obtain ⟨k, hk, hbefore⟩ := exists_first_row_pivot M.val ⟨j, hj⟩
        by_cases hk0 : k = 0
        · subst k
          let U : DiagonalOpen N F := ⟨M, isUnit_iff_ne_zero.mpr hk⟩
          let p := diagonalDecode U
          obtain ⟨r, hr⟩ := ih N (Nat.lt_succ_self N) p.2.2
          refine ⟨.diagonal r, ?_⟩
          change diagonalLiftProfile r.profile = matrixRankArray M.val
          rw [hr, ← diagonalModel_rankArray p.1 p.2.1]
          exact congrArg (fun A : SymmetricMatrices (N + 1) F => matrixRankArray A.val)
            (congrArg Subtype.val (diagonalEncode_decode U))
        · let I := IndexData.canonical k hk0
          let U : I.OffDiagonalPatch F := ⟨M, hbefore, isUnit_iff_ne_zero.mpr hk⟩
          let p := I.offDiagonalEncode U
          obtain ⟨r, hr⟩ := ih (Fintype.card (IndexData.Rest k))
            (IndexData.canonical_size_lt k) p.2.2
          refine ⟨.paired I r, ?_⟩
          change I.offDiagonalLiftProfile r.profile = matrixRankArray M.val
          rw [hr, ← I.offDiagonalMatrix_rankArray p]
          exact congrArg matrixRankArray
            (congrArg (fun A : I.OffDiagonalPatch F => A.val.val) (I.offDiagonalDecode_encode U))

/-- Coverage includes an explicit literal symmetric partial permutation,
with a separately proved equality of its combinatorial and actual ranks. -/
theorem exists_recipe_and_symmetric_rook {F : Type*} [Field F] {n : ℕ}
    (M : SymmetricMatrices n F) :
    ∃ r : StratumRecipe n, r.profile = matrixRankArray M.val ∧
      ∃ w : RookPattern (Fin n) (Fin n), w.IsSymmetric ∧ w.rankProfile = r.profile := by
  obtain ⟨r, hr⟩ := exists_recipe_of_symmetric_matrix n M
  exact ⟨r, hr, r.rook, r.rook_symmetric, r.rook_rankProfile⟩

/-- The unique actual symmetric partial-permutation representative of a
symmetric matrix's complete northwest rank table. -/
theorem exists_unique_symmetric_rook {F : Type*} [Field F] {n : ℕ}
    (M : SymmetricMatrices n F) :
    ∃! w : {w : RookPattern (Fin n) (Fin n) // w.IsSymmetric},
      w.val.rankProfile = matrixRankArray M.val := by
  obtain ⟨r, hr⟩ := exists_recipe_of_symmetric_matrix n M
  refine ⟨⟨r.rook, r.rook_symmetric⟩, r.rook_rankProfile.trans hr, ?_⟩
  intro w hw
  apply Subtype.ext
  exact RookPattern.rankProfile_injective (hw.trans (r.rook_rankProfile.trans hr).symm)

/-- Every symmetric partial permutation itself has one of the integral
chart recipes. This turns the recipe parametrization into coverage of all
strata named in Proposition 6.5. -/
theorem exists_recipe_of_symmetric_rook {n : ℕ}
    (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    ∃ r : StratumRecipe n, r.profile = w.rankProfile := by
  obtain ⟨r, hr⟩ := exists_recipe_of_symmetric_matrix n
    (⟨w.toMatrix ℚ, w.toMatrix_symmetric hw ℚ⟩ : SymmetricMatrices n ℚ)
  exact ⟨r, hr.trans (w.matrixRankArray_toMatrix ℚ)⟩

/-- The zero, diagonal, and paired constructors cover the literal rook
patterns themselves, not only their rank profiles. Together with the exponent
recurrences, this identifies the recursive data with the paper's deletion rule. -/
theorem exists_recipe_realizing_symmetric_rook {n : ℕ}
    (w : RookPattern (Fin n) (Fin n)) (hw : w.IsSymmetric) :
    ∃ r : StratumRecipe n, r.rook = w := by
  obtain ⟨r, hr⟩ := exists_recipe_of_symmetric_rook w hw
  exact ⟨r, RookPattern.rankProfile_injective (r.rook_rankProfile.trans hr)⟩

end FourPapers.Symmetric.Strata
end
