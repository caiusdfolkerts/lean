namespace FourPapers.Symmetric.Pivot.OffDiagonal

open MvPolynomial

/-- The actual two removed endpoints and the increasing enumeration of all
remaining original indices. The enumeration is used for every residual prefix. -/
structure IndexData (N n : ℕ) where
  pivot : Fin (N + 1)
  pivot_ne_zero : pivot ≠ 0
  rest : Fin n ↪o Fin (N + 1)
  rest_ne_zero : ∀ i, rest i ≠ 0
  rest_ne_pivot : ∀ i, rest i ≠ pivot
  exhaustive : ∀ i, i = 0 ∨ i = pivot ∨ ∃ j, rest j = i

namespace IndexData
variable {N n : ℕ} (I : IndexData N n)

abbrev Rest (k : Fin (N + 1)) := {i : Fin (N + 1) // i ≠ 0 ∧ i ≠ k}

def canonical (k : Fin (N + 1)) (hk : k ≠ 0) :
    IndexData N (Fintype.card (Rest k)) where
  pivot := k
  pivot_ne_zero := hk
  rest :=
    { toFun := fun i => (Fintype.orderIsoFinOfCardEq (Rest k) rfl i).val
      inj' := by
        intro i j h
        exact (Fintype.orderIsoFinOfCardEq (Rest k) rfl).injective (Subtype.ext h)
      map_rel_iff' := by intros; exact (Fintype.orderIsoFinOfCardEq (Rest k) rfl).le_iff_le }
  rest_ne_zero := fun i => (Fintype.orderIsoFinOfCardEq (Rest k) rfl i).property.1
  rest_ne_pivot := fun i => (Fintype.orderIsoFinOfCardEq (Rest k) rfl i).property.2
  exhaustive := by
    intro i
    by_cases hi : i = 0
    · exact Or.inl hi
    · by_cases hk : i = k
      · exact Or.inr (Or.inl hk)
      · exact Or.inr (Or.inr ⟨(Fintype.orderIsoFinOfCardEq (Rest k) rfl).symm ⟨i, hi, hk⟩,
          congrArg Subtype.val ((Fintype.orderIsoFinOfCardEq (Rest k) rfl).apply_symm_apply _)⟩)

theorem canonical_size_lt (k : Fin (N + 1)) : Fintype.card (Rest k) < N + 1 := by
  simpa only [Fintype.card_fin] using
    (Fintype.card_subtype_lt (x := (0 : Fin (N + 1)))
      (by simp : ¬ ((0 : Fin (N + 1)) ≠ 0 ∧ (0 : Fin (N + 1)) ≠ k)))

/-- The front block is merely a reindexing of the original endpoints; the
remaining indices retain their original relative order. -/
def indexEquiv : Two ⊕ Fin n ≃ Fin (N + 1) where
  toFun := Sum.elim (Sum.elim (fun _ => 0) (fun _ => I.pivot)) I.rest
  invFun i := if h0 : i = 0 then .inl (.inl PUnit.unit)
    else if hk : i = I.pivot then .inl (.inr PUnit.unit)
    else .inr (Classical.choose ((I.exhaustive i).resolve_left h0 |>.resolve_left hk))
  left_inv := by
    rintro ((i | i) | i)
    · cases i; simp
    · cases i; simp [I.pivot_ne_zero]
    · dsimp only [Sum.elim_inr]
      rw [dif_neg (I.rest_ne_zero i), dif_neg (I.rest_ne_pivot i)]
      apply congrArg Sum.inr
      exact I.rest.injective (Classical.choose_spec
        ((I.exhaustive (I.rest i)).resolve_left (I.rest_ne_zero i) |>.resolve_left (I.rest_ne_pivot i)))
  right_inv := by
    intro i
    by_cases h0 : i = 0
    · simp [h0]
    · by_cases hk : i = I.pivot
      · simp [h0, hk, I.pivot_ne_zero]
      · simp only [h0, hk, dif_neg]
        exact Classical.choose_spec ((I.exhaustive i).resolve_left h0 |>.resolve_left hk)

@[simp] theorem indexEquiv_first : I.indexEquiv (.inl (.inl PUnit.unit)) = 0 := rfl
@[simp] theorem indexEquiv_second : I.indexEquiv (.inl (.inr PUnit.unit)) = I.pivot := rfl
@[simp] theorem indexEquiv_rest (i : Fin n) : I.indexEquiv (.inr i) = I.rest i := rfl

/-- The two diagonal entries and the two actual carrier families. The
first diagonal entry will subsequently be killed by its required zero bound. -/
inductive Carrier (n : ℕ)
  | zero
  | diagonal
  | first (i : Fin n)
  | second (i : Fin n)
  deriving DecidableEq

instance carrierFintype (n : ℕ) : Fintype (Carrier n) where
  elems := insert .zero (insert .diagonal
    ((Finset.univ.image Carrier.first) ∪ (Finset.univ.image Carrier.second)))
  complete := by
    intro c
    cases c <;> simp

/-- Exactly the carrier coordinates forced to vanish before the first
nonzero entry of row zero. -/
def forcedCarrier : Carrier n → Prop
  | .zero => True
  | .diagonal => False
  | .first i => I.rest i < I.pivot
  | .second _ => False

abbrev FreeCarrier := {c : Carrier n // ¬ I.forcedCarrier c}

instance : Fintype I.FreeCarrier := Fintype.ofFinite _

/-- A residual prefix is the initial segment of remaining original labels,
not a newly chosen rank bound. -/
abbrev Prefix (i : Fin (N + 1)) := {r : Fin n // I.rest r ≤ i}

/-- Before the second pivot, the only distinguished endpoint in a prefix is
zero. Every other index is one of the literal residual prefix indices. -/
def prefixBeforeEquiv (i : Fin (N + 1)) (hik : i < I.pivot) :
    PUnit.{1} ⊕ I.Prefix i ≃ {r : Fin (N + 1) // r ≤ i} where
  toFun := Sum.elim (fun _ => ⟨0, Fin.zero_le _⟩)
    (fun r => ⟨I.rest r.val, r.property⟩)
  invFun r := if hr : r.val = 0 then .inl PUnit.unit else
    .inr ⟨Classical.choose ((I.exhaustive r.val).resolve_left hr |>.resolve_left
      (fun hk => not_le_of_gt hik (hk ▸ r.property))), by
        rw [Classical.choose_spec ((I.exhaustive r.val).resolve_left hr |>.resolve_left
          (fun hk => not_le_of_gt hik (hk ▸ r.property)))]
        exact r.property⟩
  left_inv := by
    rintro (r | r)
    · cases r; simp
    · dsimp only [Sum.elim_inr]
      rw [dif_neg (I.rest_ne_zero r.val)]
      apply congrArg Sum.inr
      apply Subtype.ext
      apply I.rest.injective
      exact Classical.choose_spec
        ((I.exhaustive (I.rest r.val)).resolve_left (I.rest_ne_zero r.val) |>.resolve_left
          (fun hk => not_le_of_gt hik (hk ▸ r.property)))
  right_inv := by
    intro r
    apply Subtype.ext
    by_cases hr : r.val = 0
    · simp [hr]
    · simp only [dif_neg hr, Sum.elim_inr]
      exact Classical.choose_spec
        ((I.exhaustive r.val).resolve_left hr |>.resolve_left
          (fun hk => not_le_of_gt hik (hk ▸ r.property)))

/-- Once the second pivot has entered a prefix, both distinguished endpoints
and precisely the same residual initial segment are present. -/
def prefixAfterEquiv (i : Fin (N + 1)) (hki : I.pivot ≤ i) :
    Two ⊕ I.Prefix i ≃ {r : Fin (N + 1) // r ≤ i} where
  toFun := Sum.elim (Sum.elim (fun _ => ⟨0, Fin.zero_le _⟩)
      (fun _ => ⟨I.pivot, hki⟩)) (fun r => ⟨I.rest r.val, r.property⟩)
  invFun r := if hr : r.val = 0 then .inl (.inl PUnit.unit)
    else if hk : r.val = I.pivot then .inl (.inr PUnit.unit)
    else .inr ⟨Classical.choose ((I.exhaustive r.val).resolve_left hr |>.resolve_left hk), by
      rw [Classical.choose_spec ((I.exhaustive r.val).resolve_left hr |>.resolve_left hk)]
      exact r.property⟩
  left_inv := by
    rintro ((r | r) | r)
    · cases r; simp
    · cases r; simp [I.pivot_ne_zero]
    · dsimp only [Sum.elim_inr]
      rw [dif_neg (I.rest_ne_zero r.val), dif_neg (I.rest_ne_pivot r.val)]
      apply congrArg Sum.inr
      apply Subtype.ext
      apply I.rest.injective
      exact Classical.choose_spec
        ((I.exhaustive (I.rest r.val)).resolve_left (I.rest_ne_zero r.val) |>.resolve_left
          (I.rest_ne_pivot r.val))
  right_inv := by
    intro r
    apply Subtype.ext
    by_cases hr : r.val = 0
    · simp [hr]
    · by_cases hk : r.val = I.pivot
      · simp [hr, hk, I.pivot_ne_zero]
      · simp only [dif_neg hr, dif_neg hk, Sum.elim_inr]
        exact Classical.choose_spec
          ((I.exhaustive r.val).resolve_left hr |>.resolve_left hk)

@[simp] theorem prefixBeforeEquiv_first (i : Fin (N + 1)) (h : i < I.pivot) :
    (I.prefixBeforeEquiv i h (.inl PUnit.unit)).val = 0 := rfl
@[simp] theorem prefixBeforeEquiv_rest (i : Fin (N + 1)) (h : i < I.pivot)
    (r : I.Prefix i) : (I.prefixBeforeEquiv i h (.inr r)).val = I.rest r.val := rfl
@[simp] theorem prefixAfterEquiv_first (i : Fin (N + 1)) (h : I.pivot ≤ i) :
    (I.prefixAfterEquiv i h (.inl (.inl PUnit.unit))).val = 0 := rfl
@[simp] theorem prefixAfterEquiv_second (i : Fin (N + 1)) (h : I.pivot ≤ i) :
    (I.prefixAfterEquiv i h (.inl (.inr PUnit.unit))).val = I.pivot := rfl
@[simp] theorem prefixAfterEquiv_rest (i : Fin (N + 1)) (h : I.pivot ≤ i)
    (r : I.Prefix i) : (I.prefixAfterEquiv i h (.inr r)).val = I.rest r.val := rfl

