set_option autoImplicit false
set_option maxHeartbeats 1200000

/-!
# Geometry of the affine-space times torus chart

The chart ring is the literal polynomial localization at the product of the
invertible coordinates. Its dimension is proved using Noether normalization
and invariance of transcendence degree under localization. Its structure map
is smooth. The localization map is a dominant open immersion, giving a
birational identification with affine space over the coefficient field.
-/

noncomputable section
namespace FourPapers.Symmetric.Strata.AffineTorus

open CategoryTheory AlgebraicGeometry

universe u
variable (R : Type u) [CommRing R] (a b : ℕ)

/-- The actual structural morphism of the affine-times-torus chart. -/
def structureMap : Spec (CommRingCat.of (CoordinateRing R a b)) ⟶
    Spec (CommRingCat.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (CoordinateRing R a b)))

/-- Inverting the torus coordinates defines an actual open immersion into
polynomial affine space. -/
def polynomialOpenImmersion : Spec (CommRingCat.of (CoordinateRing R a b)) ⟶
    Spec (CommRingCat.of (PolynomialRing R a b)) :=
  Spec.map (CommRingCat.ofHom
    (algebraMap (PolynomialRing R a b) (CoordinateRing R a b)))

instance : IsOpenImmersion (polynomialOpenImmersion R a b) := by
  dsimp [polynomialOpenImmersion, CoordinateRing]
  infer_instance

@[simp] theorem polynomialOpenImmersion_over :
    polynomialOpenImmersion R a b ≫
      Spec.map (CommRingCat.ofHom (algebraMap R (PolynomialRing R a b))) =
        structureMap R a b := by
  rw [polynomialOpenImmersion, structureMap, ← Spec.map_comp]
  congr 1

/-- The chart algebra is smooth over an arbitrary coefficient ring. -/
theorem coordinateRing_smooth : Algebra.Smooth R (CoordinateRing R a b) := by
  letI : Algebra.Smooth (PolynomialRing R a b) (CoordinateRing R a b) :=
    Algebra.Smooth.of_isLocalization_Away (denominator R a b)
  exact Algebra.Smooth.comp R (PolynomialRing R a b) (CoordinateRing R a b)

/-- Scheme-theoretic smoothness of the literal structure morphism. -/
theorem structureMap_smooth : Smooth (structureMap R a b) := by
  rw [structureMap, HasRingHomProperty.Spec_iff (P := @Smooth)]
  change (algebraMap R (CoordinateRing R a b)).Smooth
  exact RingHom.smooth_algebraMap.mpr (coordinateRing_smooth R a b)

section Field
variable (K : Type u) [Field K]

/-- The open polynomial chart is dense over every field. -/
theorem polynomialOpenImmersion_dense :
    DenseRange (polynomialOpenImmersion K a b) := by
  change Dense (Set.range
    (PrimeSpectrum.comap (algebraMap (PolynomialRing K a b) (CoordinateRing K a b))))
  rw [PrimeSpectrum.localization_away_comap_range (CoordinateRing K a b)
    (denominator K a b)]
  apply (PrimeSpectrum.basicOpen (denominator K a b)).isOpen.dense
  exact ⟨⊥, by simpa using denominator_ne_zero K a b⟩

instance : IsDominant (polynomialOpenImmersion K a b) :=
  ⟨polynomialOpenImmersion_dense a b K⟩

/-- Krull dimension of the chart, using the usual chain-of-prime-ideals
notion of dimension. -/
theorem coordinateRing_dimension : ringKrullDim (CoordinateRing K a b) = a + b := by
  rw [DimensionTheory.ringKrullDim_localization_away K
    (denominator_ne_zero K a b) (CoordinateRing K a b)]
  simp [PolynomialRing, MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite,
    ringKrullDim_eq_zero_of_field]

/-- Finite affine coordinates for the chart, lifted into the scheme universe. -/
abbrev AffineIndices := ULift.{u} (Fin a ⊕ Fin b)

@[simp] theorem card_affineIndices : Fintype.card (AffineIndices a b) = a + b := by
  simp [AffineIndices]

/-- Relabeling the polynomial variables identifies its spectrum with the
usual scheme-theoretic affine space. -/
def polynomialAffineIso : Spec (CommRingCat.of (PolynomialRing K a b)) ≅
    𝔸(AffineIndices a b; Spec (CommRingCat.of K)) :=
  let e : MvPolynomial (AffineIndices a b) K ≃ₐ[K] PolynomialRing K a b :=
    MvPolynomial.renameEquiv K Equiv.ulift
  Scheme.Spec.mapIso e.toRingEquiv.toCommRingCatIso.op ≪≫
    (AffineSpace.SpecIso (AffineIndices a b) (CommRingCat.of K)).symm

/-- The affine identification respects the coefficient field. -/
theorem polynomialAffineIso_over :
    (polynomialAffineIso a b K).hom ≫
      𝔸(AffineIndices a b; Spec (CommRingCat.of K)) ↘ Spec (CommRingCat.of K) =
        Spec.map (CommRingCat.ofHom (algebraMap K (PolynomialRing K a b))) := by
  dsimp [polynomialAffineIso]
  rw [Category.assoc, AffineSpace.SpecIso_inv_over, ← Spec.map_comp]
  congr 1
  ext r : 2
  exact (MvPolynomial.renameEquiv K
    (Equiv.ulift : AffineIndices.{u} a b ≃ _)).commutes r

/-- Explicit birationality to a finite-dimensional affine space. This
retains the finite number `a+b` of parameters, beyond the general rationality
predicate which also permits arbitrary index types. -/
theorem structureMap_birational_affineSpace :
    Scheme.BirationalOver (structureMap K a b)
      (𝔸(AffineIndices a b; Spec (CommRingCat.of K)) ↘ Spec (CommRingCat.of K)) := by
  have h₁ := (polynomialOpenImmersion K a b).birationalOver
    (Spec.map (CommRingCat.ofHom (algebraMap K (PolynomialRing K a b))))
    (structureMap K a b) (polynomialOpenImmersion_over K a b)
  have h₂ := (polynomialAffineIso a b K).hom.birationalOver
    (𝔸(AffineIndices a b; Spec (CommRingCat.of K)) ↘ Spec (CommRingCat.of K))
    (Spec.map (CommRingCat.ofHom (algebraMap K (PolynomialRing K a b))))
    (polynomialAffineIso_over a b K)
  exact h₁.trans h₂

/-- The product of affine space and a split torus is rational, with
birationality witnessed by its dense polynomial principal-open inclusion. -/
theorem structureMap_rational : Scheme.IsRationalOver (structureMap K a b) :=
  ⟨AffineIndices a b, structureMap_birational_affineSpace a b K⟩

end Field
end FourPapers.Symmetric.Strata.AffineTorus
end
end
