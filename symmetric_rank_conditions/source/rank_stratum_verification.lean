set_option maxHeartbeats 1400000

/-!
# Affine test points of the actual open rank-stratum scheme

The scheme below is the restriction of the spectrum of the original
northwest-minor quotient to its independently defined determinantal open.
The all-ring point dictionary follows from the actual open-immersion
universal property and full faithfulness of `Spec`.

-/

noncomputable section

namespace FourPapers.Symmetric.Strata

open CategoryTheory AlgebraicGeometry

universe u

section GeneralOpen

variable {A S T : Type u} [CommRing A] [CommRing S] [CommRing T]

/-- Ring maps whose induced map on spectra lands in a specified open. -/
abbrev OpenRingPoints (U : (Spec (CommRingCat.of A)).Opens) (S : Type u)
    [CommRing S] :=
  {f : A →+* S // Set.range (PrimeSpectrum.comap f) ⊆ (U : Set (Spec (CommRingCat.of A)))}

def OpenRingPoints.map (U : (Spec (CommRingCat.of A)).Opens) (φ : S →+* T)
    (f : OpenRingPoints U S) : OpenRingPoints U T :=
  ⟨φ.comp f.val, by
    rintro _ ⟨p, rfl⟩
    exact f.property ⟨PrimeSpectrum.comap φ p, rfl⟩⟩

def affineOpenToRing (U : (Spec (CommRingCat.of A)).Opens)
    (g : Spec (CommRingCat.of S) ⟶ U.toScheme) : OpenRingPoints U S :=
  ⟨(Spec.preimage (g ≫ U.ι)).hom, by
    rintro _ ⟨p, rfl⟩
    let q : Spec (CommRingCat.of S) := p
    change Spec.map (Spec.preimage (g ≫ U.ι)) q ∈ U
    rw [Spec.map_preimage, Scheme.Hom.comp_apply]
    exact (g q).property⟩

def affineOpenFromRing (U : (Spec (CommRingCat.of A)).Opens)
    (f : OpenRingPoints U S) : Spec (CommRingCat.of S) ⟶ U.toScheme :=
  IsOpenImmersion.lift U.ι (Spec.map (CommRingCat.ofHom f.val)) (by
    rw [Scheme.Opens.range_ι]
    exact f.property)

@[reassoc (attr := simp)] theorem affineOpenFromRing_comp_ι
    (U : (Spec (CommRingCat.of A)).Opens) (f : OpenRingPoints U S) :
    affineOpenFromRing U f ≫ U.ι = Spec.map (CommRingCat.ofHom f.val) :=
  IsOpenImmersion.lift_fac _ _ _

theorem affineOpenFromRing_toRing (U : (Spec (CommRingCat.of A)).Opens)
    (g : Spec (CommRingCat.of S) ⟶ U.toScheme) :
    affineOpenFromRing U (affineOpenToRing U g) = g := by
  apply (cancel_mono U.ι).mp
  rw [affineOpenFromRing_comp_ι]
  simpa only [affineOpenToRing, CommRingCat.ofHom_hom] using
    Spec.map_preimage (g ≫ U.ι)

theorem affineOpenToRing_fromRing (U : (Spec (CommRingCat.of A)).Opens)
    (f : OpenRingPoints U S) :
    affineOpenToRing U (affineOpenFromRing U f) = f := by
  apply Subtype.ext
  simp only [affineOpenToRing, affineOpenFromRing_comp_ι, Spec.preimage_map,
    CommRingCat.hom_ofHom]

/-- The actual open-scheme Hom set, not merely the set of field points. -/
def affineOpenHomEquiv (U : (Spec (CommRingCat.of A)).Opens) :
    (Spec (CommRingCat.of S) ⟶ U.toScheme) ≃ OpenRingPoints U S where
  toFun := affineOpenToRing U
  invFun := affineOpenFromRing U
  left_inv := affineOpenFromRing_toRing U
  right_inv := affineOpenToRing_fromRing U

theorem affineOpenHomEquiv_natural (U : (Spec (CommRingCat.of A)).Opens)
    (φ : S →+* T) (g : Spec (CommRingCat.of S) ⟶ U.toScheme) :
    affineOpenHomEquiv U (Spec.map (CommRingCat.ofHom φ) ≫ g) =
      OpenRingPoints.map U φ (affineOpenHomEquiv U g) := by
  apply Subtype.ext
  change (Spec.preimage ((Spec.map (CommRingCat.ofHom φ) ≫ g) ≫ U.ι)).hom =
    φ.comp (Spec.preimage (g ≫ U.ι)).hom
  rw [Category.assoc, Spec.preimage_comp, Spec.preimage_map]
  rfl

theorem affineOpenHomEquiv_symm_natural (U : (Spec (CommRingCat.of A)).Opens)
    (φ : S →+* T) (f : OpenRingPoints U S) :
    (affineOpenHomEquiv U).symm (OpenRingPoints.map U φ f) =
      Spec.map (CommRingCat.ofHom φ) ≫ (affineOpenHomEquiv U).symm f := by
  apply (affineOpenHomEquiv U).injective
  rw [Equiv.apply_symm_apply, affineOpenHomEquiv_natural, Equiv.apply_symm_apply]

end GeneralOpen

variable {n : ℕ} (r : RankArray n) (R : Type u) [CommRing R]

/-- The spectrum of the literal northwest-minor quotient. -/
abbrev rankLocusScheme : Scheme.{u} := Spec (CommRingCat.of (RankLocusRing r R))

/-- The actual determinantal open as an open of the ambient scheme. -/
def rankStratumOpens : (rankLocusScheme r R).Opens :=
  ⟨rankStratumOpen r R, rankStratumOpen_isOpen r R⟩

/-- Restriction of the original affine rank locus to the exact-rank open. -/
abbrev rankStratumScheme : Scheme.{u} := (rankStratumOpens r R).toScheme

def rankStratumImmersion : rankStratumScheme r R ⟶ rankLocusScheme r R :=
  (rankStratumOpens r R).ι

instance : IsOpenImmersion (rankStratumImmersion r R) :=
  inferInstanceAs (IsOpenImmersion (rankStratumOpens r R).ι)

@[simp] theorem range_rankStratumImmersion :
    Set.range (rankStratumImmersion r R) = rankStratumOpen r R :=
  Scheme.Opens.range_ι (rankStratumOpens r R)

/-- Every commutative test ring sees precisely the original quotient maps
whose spectra land in the original determinantal open. -/
def rankStratumHomEquiv (S : Type u) [CommRing S] :
    (Spec (CommRingCat.of S) ⟶ rankStratumScheme r R) ≃
      {f : RankLocusRing r R →+* S //
        Set.range (PrimeSpectrum.comap f) ⊆ rankStratumOpen r R} :=
  affineOpenHomEquiv (rankStratumOpens r R)

theorem rankStratumImmersion_dense (w : SymmetricRook n)
    (F : Type u) [Field F] : DenseRange (rankStratumImmersion w.val.rankProfile F) := by
  rw [DenseRange, range_rankStratumImmersion]
  exact rankStratumOpen_dense w F

end FourPapers.Symmetric.Strata
end
end
