    hm]
  have hschur := matrixMinorIdeal_schur A B C E t
  simpa only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, Fintype.card_punit, he,
    matrixMinorIdeal_fromCols_zero_left] using hschur

/-- The row-only case is the literal transpose of the rectangular column
case, so no symmetry or square-shape assumption is smuggled into the lemma. -/
theorem minors_row_only [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]
    (x y q : R) (hqx : q * x = 1)
    (b c : ι → R) (c' : κ → R) (D : Matrix ι κ R) (t : ℕ) :
    matrixMinorIdeal ((model x y q b c 0 c' D).submatrix id oneEndpoint) (t + 1) =
      matrixMinorIdeal D t := by
  rw [← matrixMinorIdeal_transpose ((model x y q b c 0 c' D).submatrix id oneEndpoint),
    Matrix.transpose_submatrix, model_transpose,
    minors_column_only x y q hqx c' b c D.transpose t,
