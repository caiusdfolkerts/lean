section

set_option autoImplicit false
set_option maxHeartbeats 1600000

/-!
# Literal partial-permutation matrices and their ranks

Rooks are Boolean positions with at most one position in each row and column.
Their matrix entries are the literal zero and one in the chosen ring. The rank
formula below is an ordinary linear-algebra theorem over every field, not a
definition of matrix rank by counting rooks.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Matrix Module Finset

structure RookPattern (ι κ : Type*) where
  entry : ι → κ → Bool
  row_unique : ∀ i j k, entry i j = true → entry i k = true → j = k
  col_unique : ∀ i j k, entry i k = true → entry j k = true → i = j

namespace RookPattern

variable {ι κ ι' κ' : Type*}

@[ext] theorem ext {v w : RookPattern ι κ}
    (h : ∀ i j, v.entry i j = w.entry i j) : v = w := by
  cases v with
  | mk v hv₁ hv₂ =>
    cases w with
    | mk w hw₁ hw₂ =>
      have he : v = w := funext fun i => funext fun j => h i j
      subst w
      rfl

noncomputable instance instFintype [Fintype ι] [Fintype κ] : Fintype (RookPattern ι κ) := by
  classical
  exact Fintype.ofInjective RookPattern.entry (fun _ _ h =>
    RookPattern.ext fun i j => congrFun (congrFun h i) j)

def toMatrix (w : RookPattern ι κ) (R : Type*) [Zero R] [One R] : Matrix ι κ R :=
  Matrix.of (fun i j => if w.entry i j = true then 1 else 0)

def submatrix (w : RookPattern ι κ) (a : ι' → ι) (b : κ' → κ)
    (ha : Function.Injective a) (hb : Function.Injective b) : RookPattern ι' κ' where
  entry i j := w.entry (a i) (b j)
  row_unique i j k h₁ h₂ := hb (w.row_unique _ _ _ h₁ h₂)
  col_unique i j k h₁ h₂ := ha (w.col_unique _ _ _ h₁ h₂)

@[simp] theorem toMatrix_submatrix (w : RookPattern ι κ) (R : Type*) [Zero R] [One R]
    (a : ι' → ι) (b : κ' → κ) (ha : Function.Injective a) (hb : Function.Injective b) :
    (w.submatrix a b ha hb).toMatrix R = (w.toMatrix R).submatrix a b := rfl

def transpose (w : RookPattern ι κ) : RookPattern κ ι where
  entry i j := w.entry j i
  row_unique i j k h₁ h₂ := w.col_unique j k i h₁ h₂
  col_unique i j k h₁ h₂ := w.row_unique k i j h₁ h₂

abbrev ActiveRows (w : RookPattern ι κ) := {i : ι // ∃ j, w.entry i j = true}
abbrev Positions (w : RookPattern ι κ) := {p : ι × κ // w.entry p.1 p.2 = true}

noncomputable instance instFintypeActiveRows [Fintype ι] [Fintype κ]
    (w : RookPattern ι κ) : Fintype w.ActiveRows := by
  classical
  exact inferInstanceAs (Fintype {i : ι // ∃ j, w.entry i j = true})

instance instFintypePositions [Fintype ι] [Fintype κ]
    (w : RookPattern ι κ) : Fintype w.Positions :=
  inferInstanceAs (Fintype {p : ι × κ // w.entry p.1 p.2 = true})

def positionsEquivActiveRows (w : RookPattern ι κ) : w.Positions ≃ w.ActiveRows where
  toFun p := ⟨p.val.1, p.val.2, p.property⟩
  invFun i := ⟨(i.val, Classical.choose i.property), Classical.choose_spec i.property⟩
  left_inv p := by
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · exact w.row_unique _ _ _ (Classical.choose_spec
        (show ∃ j, w.entry p.val.1 j = true from ⟨p.val.2, p.property⟩)) p.property
  right_inv _ := rfl

section Rank
variable [Fintype ι] [Fintype κ] [DecidableEq ι] {F : Type*} [Field F]

theorem col_eq_single (w : RookPattern ι κ) (i : ι) (j : κ)
    (hij : w.entry i j = true) : (w.toMatrix F).col j = Pi.single i (1 : F) := by
  classical
  ext k
  by_cases hki : k = i
  · subst k
    simp [toMatrix, Matrix.col_apply, hij]
  · have hkj : w.entry k j ≠ true := fun h => hki (w.col_unique k i j h hij)
    simp [toMatrix, Matrix.col_apply, hkj, Pi.single_apply, hki, Ne.symm hki]

theorem span_cols (w : RookPattern ι κ) :
    Submodule.span F (Set.range (w.toMatrix F).col) =
      Submodule.span F (Set.range (fun i : w.ActiveRows => Pi.single i.val (1 : F))) := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    by_cases hj : ∃ i, w.entry i j = true
    · obtain ⟨i, hij⟩ := hj
      rw [w.col_eq_single i j hij]
      exact Submodule.subset_span ⟨⟨i, j, hij⟩, rfl⟩
    · have hz : (w.toMatrix F).col j = 0 := by
        ext i
        simp [toMatrix, Matrix.col_apply, show w.entry i j ≠ true from fun h => hj ⟨i, h⟩]
      rw [hz]
      exact Submodule.zero_mem _
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    obtain ⟨j, hij⟩ := i.property
    change Pi.single i.val (1 : F) ∈ Submodule.span F (Set.range (w.toMatrix F).col)
    rw [← w.col_eq_single i.val j hij]
    exact Submodule.subset_span ⟨j, rfl⟩

theorem rank_eq_card_activeRows (w : RookPattern ι κ) :
    (w.toMatrix F).rank = Fintype.card w.ActiveRows := by
  classical
  rw [Matrix.rank_eq_finrank_span_cols, w.span_cols]
  exact finrank_span_eq_card
    ((Pi.linearIndependent_single_one ι F).comp Subtype.val Subtype.val_injective)

theorem rank_eq_card_positions (w : RookPattern ι κ) :
    (w.toMatrix F).rank = Fintype.card w.Positions := by
  classical
  rw [w.rank_eq_card_activeRows, Fintype.card_congr w.positionsEquivActiveRows]

end Rank

variable {n : ℕ}

def prefixRook (w : RookPattern (Fin n) (Fin n)) (i j : Fin n) :
    RookPattern {a : Fin n // a ≤ i} {b : Fin n // b ≤ j} :=
  w.submatrix Subtype.val Subtype.val Subtype.val_injective Subtype.val_injective

/-- The combinatorial northwest rank profile, counting the actual rook
positions. Its equality with matrix rank is proved separately below. -/
def rankProfile (w : RookPattern (Fin n) (Fin n)) : RankArray n :=
  fun i j => Fintype.card (w.prefixRook i j).Positions

theorem matrixRankArray_toMatrix (w : RookPattern (Fin n) (Fin n))
    (F : Type*) [Field F] : matrixRankArray (w.toMatrix F) = w.rankProfile := by
  funext i j
  exact (w.prefixRook i j).rank_eq_card_positions (F := F)

theorem card_positions_eq_sum [Fintype ι] [Fintype κ] (w : RookPattern ι κ) :
    Fintype.card w.Positions = ∑ i : ι, ∑ j : κ,
      if w.entry i j = true then 1 else 0 := by
  classical
  change Fintype.card {p : ι × κ // w.entry p.1 p.2 = true} = _
  rw [Fintype.card_subtype]
  simpa only [Fintype.sum_prod_type, Nat.cast_id] using
    (Finset.sum_boole (R := ℕ) (fun p : ι × κ => w.entry p.1 p.2 = true) univ).symm

theorem rankProfile_eq_sum (w : RookPattern (Fin n) (Fin n)) (i j : Fin n) :
    w.rankProfile i j = ∑ a ∈ Iic i, ∑ b ∈ Iic j,
      if w.entry a b = true then 1 else 0 := by
  classical
  rw [rankProfile, card_positions_eq_sum]
  change (∑ a : {a : Fin n // a ≤ i}, ∑ b : {b : Fin n // b ≤ j},
      if w.entry a.val b.val = true then 1 else 0) = _
  rw [Finset.sum_subtype (p := fun a : Fin n => a ≤ i) (Iic i) (by simp)
    (fun a => ∑ b ∈ Iic j, if w.entry a b = true then 1 else 0)]
  apply Fintype.sum_congr
  intro a
  exact (Finset.sum_subtype (p := fun b : Fin n => b ≤ j) (Iic j) (by simp)
    (fun b => if w.entry a.val b = true then (1 : ℕ) else 0)).symm

/-- Finite prefix sums determine their summands. This cancellation proof is
used twice to recover each rook from the northwest rank table. -/
theorem prefix_sum_injective {f g : Fin n → ℕ}
    (h : ∀ i, ∑ j ∈ Iic i, f j = ∑ j ∈ Iic i, g j) : f = g := by
  classical
  have aux : ∀ a : ℕ, ∀ i : Fin n, i.val = a → f i = g i := by
    intro a
    induction a using Nat.strong_induction_on with
    | h a ih =>
      intro i hi
      have hbelow : ∑ j ∈ (Iic i).erase i, f j = ∑ j ∈ (Iic i).erase i, g j := by
        apply Finset.sum_congr rfl
        intro j hj
        have hji : j < i := lt_of_le_of_ne (mem_Iic.mp (mem_erase.mp hj).2)
          (mem_erase.mp hj).1
        exact ih j.val (by have := hji; omega) j rfl
      have ht := h i
      rw [← Finset.sum_erase_add (Iic i) f (mem_Iic.mpr le_rfl),
        ← Finset.sum_erase_add (Iic i) g (mem_Iic.mpr le_rfl), hbelow] at ht
      exact Nat.add_left_cancel ht
  exact funext fun i => aux i.val i rfl

/-- A partial permutation is uniquely determined by all its northwest
ranks. This uses no field or characteristic restriction. -/
theorem rankProfile_injective :
    Function.Injective (rankProfile : RookPattern (Fin n) (Fin n) → RankArray n) := by
  classical
  intro v w h
  have hrows (j : Fin n) :
      (fun a => ∑ b ∈ Iic j, if v.entry a b = true then (1 : ℕ) else 0) =
      (fun a => ∑ b ∈ Iic j, if w.entry a b = true then (1 : ℕ) else 0) := by
    apply prefix_sum_injective
    intro i
    simpa only [← rankProfile_eq_sum] using congrFun (congrFun h i) j
  have hentry (i : Fin n) :
      (fun j => if v.entry i j = true then (1 : ℕ) else 0) =
      (fun j => if w.entry i j = true then (1 : ℕ) else 0) := by
    apply prefix_sum_injective
    intro j
    exact congrFun (hrows j) i
  apply ext
  intro i j
  have hh := congrFun (hentry i) j
  cases hv : v.entry i j <;> cases hw : w.entry i j <;> simp_all

theorem toMatrix_rankArray_injective (F : Type*) [Field F] :
    Function.Injective (fun w : RookPattern (Fin n) (Fin n) =>
      matrixRankArray (w.toMatrix F)) := by
  intro v w h
  change matrixRankArray (v.toMatrix F) = matrixRankArray (w.toMatrix F) at h
  rw [matrixRankArray_toMatrix, matrixRankArray_toMatrix] at h
  exact rankProfile_injective h

def IsSymmetric (w : RookPattern (Fin n) (Fin n)) : Prop :=
  ∀ i j, w.entry i j = w.entry j i

theorem toMatrix_symmetric (w : RookPattern (Fin n) (Fin n))
    (hw : w.IsSymmetric) (R : Type*) [Zero R] [One R] :
    ∀ i j, w.toMatrix R i j = w.toMatrix R j i := by
  intro i j
  simp only [toMatrix, Matrix.of_apply, hw i j]

end RookPattern

abbrev SymmetricRook (n : ℕ) :=
  {w : RookPattern (Fin n) (Fin n) // w.IsSymmetric}

noncomputable instance instFintypeSymmetricRook (n : ℕ) : Fintype (SymmetricRook n) := by
  classical
  exact inferInstanceAs (Fintype
    {w : RookPattern (Fin n) (Fin n) // w.IsSymmetric})

end FourPapers.Symmetric.Strata
end
