section

set_option autoImplicit false
set_option maxHeartbeats 1200000

/-!
# The coordinate algebra of affine space times a split torus

The algebra is the literal polynomial ring in `a + b` variables localized
at the product of the final `b` variables. Its homomorphisms to every
commutative `R`-algebra are naturally equivalent to `a` arbitrary elements
and `b` actual units. Both inverse identities are proved by evaluation and
the universal properties of polynomial rings and localization.

No reducedness, domain, field, or nontriviality hypothesis is used for the
universal property. The integer specialization represents the corresponding
functor on all commutative rings.
-/

noncomputable section

namespace FourPapers.Symmetric.Strata.AffineTorus

open MvPolynomial
open scoped BigOperators

universe u v w

abbrev Points (S : Type v) [CommRing S] (a b : ℕ) :=
  (Fin a → S) × (Fin b → Sˣ)

def mapPoints {S : Type v} {T : Type w} [CommRing S] [CommRing T]
    (a b : ℕ) (φ : S →+* T) (p : Points S a b) : Points T a b :=
  (φ ∘ p.1, fun j => Units.map φ.toMonoidHom (p.2 j))

variable (R : Type u) [CommRing R] (a b : ℕ)

abbrev PolynomialRing := MvPolynomial (Fin a ⊕ Fin b) R

/-- The defining element of the actual principal localization. -/
def denominator : PolynomialRing R a b := ∏ j : Fin b, X (Sum.inr j)

abbrev CoordinateRing := Localization.Away (denominator R a b)

def coordinate (i : Fin a ⊕ Fin b) : CoordinateRing R a b :=
  algebraMap (PolynomialRing R a b) (CoordinateRing R a b) (X i)

@[simp] theorem denominator_zero : denominator R a 0 = 1 := by
  simp [denominator]

/-- The torus principal open is nonempty over every nonzero coefficient
ring: evaluation of all variables at one sends the denominator to one. -/
theorem denominator_ne_zero [Nontrivial R] : denominator R a b ≠ 0 := by
  intro h
  have hh := congrArg (MvPolynomial.eval (fun _ : Fin a ⊕ Fin b => (1 : R))) h
  have hone : (1 : R) = 0 := by simpa [denominator] using hh
  exact one_ne_zero hone

theorem torusCoordinate_isUnit (j : Fin b) :
    IsUnit (coordinate R a b (Sum.inr j)) := by
  have h : IsUnit (∏ k : Fin b, coordinate R a b (Sum.inr k)) := by
    simpa only [denominator, coordinate, map_prod] using
      (IsLocalization.Away.algebraMap_isUnit (denominator R a b)
        (S := CoordinateRing R a b))
  exact IsUnit.prod_univ_iff.mp h j

/-- The actual invertible coordinate, including its inverse. -/
def torusUnit (j : Fin b) : (CoordinateRing R a b)ˣ :=
  (torusCoordinate_isUnit R a b j).unit

@[simp] theorem coe_torusUnit (j : Fin b) :
    ↑(torusUnit R a b j) = coordinate R a b (Sum.inr j) :=
  (torusCoordinate_isUnit R a b j).unit_spec

section UniversalProperty

variable {S : Type v} [CommRing S] [Algebra R S]

def polynomialEval (p : Points S a b) : PolynomialRing R a b →ₐ[R] S :=
  MvPolynomial.aeval (Sum.elim p.1 (fun j => ↑(p.2 j)))

@[simp] theorem polynomialEval_denominator (p : Points S a b) :
    polynomialEval R a b p (denominator R a b) = ∏ j : Fin b, ↑(p.2 j) := by
  simp [polynomialEval, denominator]

theorem polynomialEval_denominator_isUnit (p : Points S a b) :
    IsUnit (polynomialEval R a b p (denominator R a b)) := by
  rw [polynomialEval_denominator]
  exact IsUnit.prod_univ_iff.mpr fun j => (p.2 j).isUnit

/-- Extend the polynomial evaluation over the actual principal
localization. The supplied torus coordinates prove its denominator a unit. -/
def fromPoints (p : Points S a b) : CoordinateRing R a b →ₐ[R] S :=
  IsLocalization.Away.liftAlgHom (denominator R a b)
    (polynomialEval_denominator_isUnit R a b p)

@[simp] theorem fromPoints_algebraMap (p : Points S a b) (q : PolynomialRing R a b) :
    fromPoints R a b p
        (algebraMap (PolynomialRing R a b) (CoordinateRing R a b) q) =
      polynomialEval R a b p q :=
  IsLocalization.Away.lift_eq (denominator R a b)
    (polynomialEval_denominator_isUnit R a b p) q

@[simp] theorem fromPoints_free (p : Points S a b) (i : Fin a) :
    fromPoints R a b p (coordinate R a b (Sum.inl i)) = p.1 i := by
  simp [coordinate, polynomialEval]

@[simp] theorem fromPoints_torus (p : Points S a b) (j : Fin b) :
    fromPoints R a b p (coordinate R a b (Sum.inr j)) = ↑(p.2 j) := by
  simp [coordinate, polynomialEval]

def toPoints (φ : CoordinateRing R a b →ₐ[R] S) : Points S a b :=
  (fun i => φ (coordinate R a b (Sum.inl i)),
    fun j => Units.map φ.toRingHom.toMonoidHom (torusUnit R a b j))

@[simp] theorem toPoints_free (φ : CoordinateRing R a b →ₐ[R] S) (i : Fin a) :
    (toPoints R a b φ).1 i = φ (coordinate R a b (Sum.inl i)) := rfl

@[simp] theorem coe_toPoints_torus (φ : CoordinateRing R a b →ₐ[R] S) (j : Fin b) :
    ↑((toPoints R a b φ).2 j) = φ (coordinate R a b (Sum.inr j)) := by
  change φ ↑(torusUnit R a b j) = _
  rw [coe_torusUnit]

/-- The localized coordinate algebra is determined by the images of its
free and torus coordinates; inverses need not be checked separately. -/
theorem hom_ext {φ ψ : CoordinateRing R a b →ₐ[R] S}
    (hfree : ∀ i, φ (coordinate R a b (Sum.inl i)) =
      ψ (coordinate R a b (Sum.inl i)))
    (htorus : ∀ j, φ (coordinate R a b (Sum.inr j)) =
      ψ (coordinate R a b (Sum.inr j))) : φ = ψ := by
  apply IsLocalization.algHom_ext (Submonoid.powers (denominator R a b))
  apply MvPolynomial.algHom_ext
  rintro (i | j)
  · exact hfree i
  · exact htorus j

@[simp] theorem toPoints_fromPoints (p : Points S a b) :
    toPoints R a b (fromPoints R a b p) = p := by
  apply Prod.ext
  · funext i
    exact fromPoints_free R a b p i
  · funext j
    apply Units.ext
    simp only [coe_toPoints_torus, fromPoints_torus]

@[simp] theorem fromPoints_toPoints (φ : CoordinateRing R a b →ₐ[R] S) :
    fromPoints R a b (toPoints R a b φ) = φ := by
  apply hom_ext R a b
  · intro i
    simp only [fromPoints_free, toPoints_free]
  · intro j
    simp only [fromPoints_torus, coe_toPoints_torus]

/-- The exact representing equivalence over every commutative
`R`-algebra, including zero rings and empty coordinate sets. -/
def homEquiv : (CoordinateRing R a b →ₐ[R] S) ≃ Points S a b where
  toFun := toPoints R a b
  invFun := fromPoints R a b
  left_inv := fromPoints_toPoints R a b
  right_inv := toPoints_fromPoints R a b

variable {T : Type w} [CommRing T] [Algebra R T]

/-- Naturality for every homomorphism of coefficient algebras. -/
theorem toPoints_comp (φ : S →ₐ[R] T) (f : CoordinateRing R a b →ₐ[R] S) :
    toPoints R a b (φ.comp f) =
      mapPoints a b φ.toRingHom (toPoints R a b f) := by
  apply Prod.ext
  · rfl
  · funext j
    apply Units.ext
    rfl

theorem fromPoints_natural (φ : S →ₐ[R] T) (p : Points S a b) :
    fromPoints R a b (mapPoints a b φ.toRingHom p) = φ.comp (fromPoints R a b p) := by
  apply hom_ext R a b
  · intro i
    simp [mapPoints]
  · intro j
    simp [mapPoints]

theorem homEquiv_natural (φ : S →ₐ[R] T) (f : CoordinateRing R a b →ₐ[R] S) :
    homEquiv R a b (φ.comp f) = mapPoints a b φ.toRingHom (homEquiv R a b f) :=
  toPoints_comp R a b φ f

theorem homEquiv_symm_natural (φ : S →ₐ[R] T) (p : Points S a b) :
    (homEquiv R a b).symm (mapPoints a b φ.toRingHom p) =
      φ.comp ((homEquiv R a b).symm p) :=
  fromPoints_natural R a b φ p

end UniversalProperty

/-- With no fixed coefficient-algebra structure on the target, a ring
map records its coefficient map as well as its free and unit coordinates. -/
def unrestrictedToPoints {S : Type v} [CommRing S]
    (f : CoordinateRing R a b →+* S) : (R →+* S) × Points S a b :=
  (f.comp (algebraMap R (CoordinateRing R a b)),
    (fun i => f (coordinate R a b (.inl i)),
      fun j => Units.map f.toMonoidHom (torusUnit R a b j)))

/-- Evaluate over the coefficient map supplied by the point itself. -/
def unrestrictedFromPoints {S : Type v} [CommRing S]
    (p : (R →+* S) × Points S a b) : CoordinateRing R a b →+* S := by
  letI : Algebra R S := p.1.toAlgebra
  exact (fromPoints R a b p.2).toRingHom

theorem unrestrictedFromPoints_toPoints {S : Type v} [CommRing S]
    (f : CoordinateRing R a b →+* S) :
    unrestrictedFromPoints R a b (unrestrictedToPoints R a b f) = f := by
  let φ := f.comp (algebraMap R (CoordinateRing R a b))
  letI : Algebra R S := φ.toAlgebra
  let F : CoordinateRing R a b →ₐ[R] S :=
    { toRingHom := f, commutes' := fun _ => rfl }
  change (fromPoints R a b (toPoints R a b F)).toRingHom = F.toRingHom
  exact congrArg AlgHom.toRingHom (fromPoints_toPoints R a b F)

theorem unrestrictedToPoints_fromPoints {S : Type v} [CommRing S]
    (p : (R →+* S) × Points S a b) :
    unrestrictedToPoints R a b (unrestrictedFromPoints R a b p) = p := by
  letI : Algebra R S := p.1.toAlgebra
  apply Prod.ext
  · apply RingHom.ext
    intro r
    exact (fromPoints R a b p.2).commutes r
  · exact toPoints_fromPoints R a b p.2

/-- The ordinary-ring universal property over every base ring. Keeping
the coefficient map makes this usable with ordinary scheme morphisms. -/
def unrestrictedRingHomEquiv (S : Type v) [CommRing S] :
    (CoordinateRing R a b →+* S) ≃ (R →+* S) × Points S a b where
  toFun := unrestrictedToPoints R a b
  invFun := unrestrictedFromPoints R a b
  left_inv := unrestrictedFromPoints_toPoints R a b
  right_inv := unrestrictedToPoints_fromPoints R a b

theorem unrestrictedRingHomEquiv_natural {S : Type v} {T : Type w}
    [CommRing S] [CommRing T] (φ : S →+* T)
    (f : CoordinateRing R a b →+* S) :
    unrestrictedRingHomEquiv R a b T (φ.comp f) =
      (φ.comp (unrestrictedRingHomEquiv R a b S f).1,
        mapPoints a b φ (unrestrictedRingHomEquiv R a b S f).2) := by
  apply Prod.ext
  · rfl
  · apply Prod.ext
    · rfl
    · funext j
      apply Units.ext
      rfl

/-- Over the integers this is the representing property on all
commutative rings, with ordinary unital ring homomorphisms. -/
def ringHomEquiv (S : Type v) [CommRing S] (a b : ℕ) :
    (CoordinateRing ℤ a b →+* S) ≃ Points S a b :=
  (unrestrictedRingHomEquiv ℤ a b S).trans
    { toFun := Prod.snd
      invFun := fun p => (Int.castRingHom S, p)
      left_inv := fun p => Prod.ext (Subsingleton.elim _ _) rfl
      right_inv := fun _ => rfl }

theorem ringHomEquiv_natural {S : Type v} {T : Type w} [CommRing S] [CommRing T]
    (a b : ℕ) (φ : S →+* T) (f : CoordinateRing ℤ a b →+* S) :
    ringHomEquiv T a b (φ.comp f) =
      mapPoints a b φ (ringHomEquiv S a b f) := by
  apply Prod.ext
  · rfl
  · funext j
    apply Units.ext
    rfl

end FourPapers.Symmetric.Strata.AffineTorus
end
end
