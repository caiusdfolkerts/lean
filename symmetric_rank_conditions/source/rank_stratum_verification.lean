zero column immediately after it. -/
def moveSecondColumn : PUnit.{1} ⊕ (PUnit.{1} ⊕ κ) ≃ Two ⊕ κ where
  toFun := Sum.elim (fun i => .inl (.inr i))
    (Sum.elim (fun i => .inl (.inl i)) Sum.inr)
  invFun := Sum.elim (Sum.elim (fun i => .inr (.inl i)) Sum.inl)
    (fun j => .inr (.inr j))
  left_inv := by rintro (i | i | i) <;> rfl
  right_inv := by rintro ((i | i) | i) <;> rfl

/-- A prefix containing the second pivot only on the column side loses
exactly one from the minor size. All residual rows here have zero first
carrier, precisely the first-row zero condition before the pivot. -/
theorem minors_column_only [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]
    (x y q : R) (hqx : q * x = 1)
    (c : ι → R) (b' c' : κ → R) (D : Matrix ι κ R) (t : ℕ) :
    matrixMinorIdeal ((model x y q 0 c b' c' D).submatrix oneEndpoint id) (t + 1) =
      matrixMinorIdeal D t := by
  let A : Matrix PUnit.{1} PUnit.{1} R := Matrix.of (fun _ _ => x)
  let B : Matrix PUnit.{1} (PUnit.{1} ⊕ κ) R := Matrix.of (fun _ j => Sum.elim (fun _ => 0) b' j)
  let C : Matrix ι PUnit.{1} R := Matrix.of (fun i _ => c i)
  let E : Matrix ι (PUnit.{1} ⊕ κ) R := Matrix.of (fun i j =>
    Sum.elim (fun _ => 0) (fun j => D i j + q * c i * b' j) j)
  letI : Invertible A :=
    { invOf := Matrix.of (fun _ _ => q)
      invOf_mul_self := by ext i j; cases i; cases j; simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply, Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, A, Matrix.mul_apply] using hqx
      mul_invOf_self := by ext i j; cases i; cases j; simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply, Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, A, Matrix.mul_apply, mul_comm] using hqx }
  have hm : ((model x y q 0 c b' c' D).submatrix oneEndpoint id).submatrix
      (Equiv.refl (PUnit.{1} ⊕ ι)) moveSecondColumn = Matrix.fromBlocks A B C E := by
    ext i j
    rcases i with i | i <;> rcases j with j | j
    · rfl
    · rcases j with j | j <;> rfl
    · rfl
    · rcases j with j | j
      · rfl
      · simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
        Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, oneEndpoint, moveSecondColumn,
        Equiv.coe_fn_mk, Equiv.refl_apply, id_eq,
          Matrix.submatrix_apply, Matrix.fromBlocks_apply₂₂, correction,
          Pi.zero_apply, zero_mul, mul_zero, zero_add, sub_zero, E, Matrix.add_apply]
