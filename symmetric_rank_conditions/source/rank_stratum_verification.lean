    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, Fintype.card_sum, Fintype.card_punit, hc] using
    matrixMinorIdeal_schur (block x y)
      (Matrix.of (fun (i : Two) (j : κ) => Sum.elim (fun _ => b' j) (fun _ => c' j) i))
      (Matrix.of (fun (i : ι) (j : Two) => Sum.elim (fun _ => b i) (fun _ => c i) j))
      (D + correction q y b c b' c') t

/-- The first endpoint together with any collection of residual indices. -/
def oneEndpoint : PUnit.{1} ⊕ ι → Two ⊕ ι :=
  Sum.elim (fun i => .inl (.inl i)) Sum.inr

/-- A prefix missing the second pivot on both sides has zero first row and
column; neither the minor size nor the residual entries change. -/
theorem minors_neither [Fintype ι] [Fintype κ]
    (x y q : R) (c : ι → R) (c' : κ → R) (D : Matrix ι κ R) (t : ℕ) :
    matrixMinorIdeal ((model x y q 0 c 0 c' D).submatrix oneEndpoint oneEndpoint) t =
      matrixMinorIdeal D t := by
  have hm : (model x y q 0 c 0 c' D).submatrix oneEndpoint oneEndpoint =
      Matrix.fromBlocks (0 : Matrix PUnit.{1} PUnit.{1} R) 0 0 D := by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;>
      simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
        Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, oneEndpoint, block, correction,
        Matrix.submatrix_apply]
  rw [hm, matrixMinorIdeal_zero_border]

