section

set_option autoImplicit false
set_option maxHeartbeats 1800000

/-!
# Iterating the actual rank-stratum charts

A recipe records the literal zero, diagonal, and paired pivot operations. Its
rank array is defined by the proved northwest rank recurrences. The theorem
below parametrizes the independently defined determinantal stratum of that
array over every commutative ring. `RookProfileInduction` proves that these
recipes cover every symmetric partial permutation and reconstruct its literal
rook positions. `StratumExponentInvariance` proves independence of the recipe.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Pivot.OffDiagonal

inductive StratumRecipe : ℕ → Type
  | empty : StratumRecipe 0
  | zero {n : ℕ} : StratumRecipe n → StratumRecipe (n + 1)
  | diagonal {n : ℕ} : StratumRecipe n → StratumRecipe (n + 1)
  | paired {N n : ℕ} : IndexData N n → StratumRecipe n → StratumRecipe (N + 1)

namespace StratumRecipe

def profile : {n : ℕ} → StratumRecipe n → RankArray n
  | _, .empty => fun i => Fin.elim0 i
  | _, .zero r => zeroLiftProfile r.profile
  | _, .diagonal r => diagonalLiftProfile r.profile
  | _, .paired I r => I.offDiagonalLiftProfile r.profile

def FreeIndex : {n : ℕ} → StratumRecipe n → Type
  | _, .empty => PEmpty
  | _, .zero r => r.FreeIndex
  | _, .diagonal (n := n) r => Fin n ⊕ r.FreeIndex
  | _, .paired I r => I.FreeCarrier ⊕ r.FreeIndex

def UnitIndex : {n : ℕ} → StratumRecipe n → Type
  | _, .empty => PEmpty
  | _, .zero r => r.UnitIndex
  | _, .diagonal r => Option r.UnitIndex
  | _, .paired _ r => Option r.UnitIndex

noncomputable def freeIndexFintype : {n : ℕ} → (r : StratumRecipe n) → Fintype r.FreeIndex
  | _, .empty => inferInstanceAs (Fintype PEmpty.{1})
  | _, .zero r => freeIndexFintype r
  | _, .diagonal (n := n) r => by
    letI := freeIndexFintype r
    exact inferInstanceAs (Fintype (Fin n ⊕ r.FreeIndex))
  | _, .paired I r => by
    classical
    letI := freeIndexFintype r
    exact inferInstanceAs (Fintype (I.FreeCarrier ⊕ r.FreeIndex))

noncomputable def unitIndexFintype : {n : ℕ} → (r : StratumRecipe n) → Fintype r.UnitIndex
  | _, .empty => inferInstanceAs (Fintype PEmpty.{1})
  | _, .zero r => unitIndexFintype r
  | _, .diagonal r => by
    letI := unitIndexFintype r
    exact inferInstanceAs (Fintype (Option r.UnitIndex))
  | _, .paired _ r => by
    letI := unitIndexFintype r
    exact inferInstanceAs (Fintype (Option r.UnitIndex))

attribute [instance] freeIndexFintype unitIndexFintype

def a {n : ℕ} (r : StratumRecipe n) : ℕ := Fintype.card r.FreeIndex
def b {n : ℕ} (r : StratumRecipe n) : ℕ := Fintype.card r.UnitIndex

@[simp] theorem a_empty : a .empty = 0 := by
  change Fintype.card PEmpty.{1} = 0
  exact Fintype.card_pempty
@[simp] theorem b_empty : b .empty = 0 := by
  change Fintype.card PEmpty.{1} = 0
  exact Fintype.card_pempty
@[simp] theorem a_zero {n : ℕ} (r : StratumRecipe n) : a (.zero r) = a r := rfl
@[simp] theorem b_zero {n : ℕ} (r : StratumRecipe n) : b (.zero r) = b r := rfl
@[simp] theorem a_diagonal {n : ℕ} (r : StratumRecipe n) :
    a (.diagonal r) = n + a r := by
  change Fintype.card (Fin n ⊕ r.FreeIndex) = n + Fintype.card r.FreeIndex
  simp only [Fintype.card_sum, Fintype.card_fin]
@[simp] theorem b_diagonal {n : ℕ} (r : StratumRecipe n) :
    b (.diagonal r) = b r + 1 := by
  change Fintype.card (Option r.UnitIndex) = Fintype.card r.UnitIndex + 1
  exact Fintype.card_option
@[simp] theorem a_paired {N n : ℕ} (I : IndexData N n) (r : StratumRecipe n) :
    a (.paired I r) = (2 * (N + 1) - (I.pivot.val + 1) - 1) + a r := by
  change Fintype.card (I.FreeCarrier ⊕ r.FreeIndex) =
    (2 * (N + 1) - (I.pivot.val + 1) - 1) + Fintype.card r.FreeIndex
  rw [Fintype.card_sum, I.card_freeCarrier]
@[simp] theorem b_paired {N n : ℕ} (I : IndexData N n) (r : StratumRecipe n) :
    b (.paired I r) = b r + 1 := by
  change Fintype.card (Option r.UnitIndex) = Fintype.card r.UnitIndex + 1
  exact Fintype.card_option

abbrev Parameters {n : ℕ} (r : StratumRecipe n) (R : Type*) [CommRing R] :=
  (r.FreeIndex → R) × (r.UnitIndex → Rˣ)

def stepCoordinates {α β γ X R : Type*} [CommRing R]
    (e : X ≃ (β → R) × (γ → Rˣ)) :
    Rˣ × (α → R) × X ≃ ((α ⊕ β) → R) × (Option γ → Rˣ) where
  toFun p := (Sum.elim p.2.1 (e p.2.2).1, fun o => o.elim p.1 (e p.2.2).2)
  invFun p := (p.2 none, (fun i => p.1 (.inl i)),
    e.symm ((fun i => p.1 (.inr i)), fun i => p.2 (some i)))
  left_inv p := by
    apply Prod.ext
    · rfl
    · apply Prod.ext
      · rfl
      · exact e.symm_apply_apply p.2.2
  right_inv p := by
    have h := e.apply_symm_apply ((fun i => p.1 (.inr i)), fun i => p.2 (some i))
    apply Prod.ext
    · funext i
      cases i with
      | inl i => rfl
      | inr i => exact congrFun (congrArg Prod.fst h) i
    · funext i
      cases i with
      | none => rfl
      | some i => exact congrFun (congrArg Prod.snd h) i

def emptyChart (R : Type*) [CommRing R] :
    StratumPoints (profile .empty) R ≃ Parameters .empty R where
  toFun _ := (PEmpty.elim, PEmpty.elim)
  invFun _ := ⟨⟨0, fun i => Fin.elim0 i⟩, fun i => Fin.elim0 i⟩
  left_inv M := by
    apply Subtype.ext
    apply Subtype.ext
    ext i
    exact Fin.elim0 i
  right_inv p := by
    apply Prod.ext
    · funext i; exact PEmpty.elim i
    · funext i; exact PEmpty.elim i

/-- Every step applies a previously proved equivalence of the actual
determinantal stratum; the coordinates never define that source stratum. -/
def chart (R : Type*) [CommRing R] :
    {n : ℕ} → (r : StratumRecipe n) → StratumPoints r.profile R ≃ r.Parameters R
  | _, .empty => emptyChart R
  | _, .zero r => (zeroStratumChart r.profile).trans (chart R r)
  | _, .diagonal r => (diagonalStratumChart r.profile).trans (stepCoordinates (chart R r))
  | _, .paired I r => (I.offDiagonalStratumChart r.profile).trans (stepCoordinates (chart R r))

def parametersMap {n : ℕ} (r : StratumRecipe n) {R S : Type*}
    [CommRing R] [CommRing S] (φ : R →+* S) (p : r.Parameters R) : r.Parameters S :=
  (fun i => φ (p.1 i), fun i => Units.map φ.toMonoidHom (p.2 i))

/-- The iterated parametrization is natural for every ring homomorphism,
including nonflat base changes and changes to positive characteristic. -/
theorem chart_natural {n : ℕ} (r : StratumRecipe n) {R S : Type*}
    [CommRing R] [CommRing S] (φ : R →+* S) :
    ∀ M : StratumPoints r.profile R,
      r.chart S (StratumPoints.map r.profile φ M) = r.parametersMap φ (r.chart R M) := by
  induction r with
  | empty =>
    intro M
    apply Prod.ext
    · funext i; exact PEmpty.elim i
    · funext i; exact PEmpty.elim i
  | zero r ih =>
    intro M
    change StratumPoints (zeroLiftProfile r.profile) R at M
    change r.chart S (zeroStratumChart r.profile
      (StratumPoints.map (zeroLiftProfile r.profile) φ M)) =
        r.parametersMap φ (r.chart R (zeroStratumChart r.profile M))
    rw [zeroStratumChart_natural]
    exact ih (zeroStratumChart r.profile M)
  | diagonal r ih =>
    intro M
    change StratumPoints (diagonalLiftProfile r.profile) R at M
    change stepCoordinates (r.chart S)
      (diagonalStratumChart r.profile
        (StratumPoints.map (diagonalLiftProfile r.profile) φ M)) =
      ((fun i => φ ((stepCoordinates (r.chart R) (diagonalStratumChart r.profile M)).1 i)),
        fun i => Units.map φ.toMonoidHom
          ((stepCoordinates (r.chart R) (diagonalStratumChart r.profile M)).2 i))
    rw [diagonalStratumChart_natural]
    have h := ih (diagonalStratumChart r.profile M).2.2
    apply Prod.ext
    · funext i
      cases i with
      | inl i => rfl
      | inr i => exact congrFun (congrArg Prod.fst h) i
    · funext i
      cases i with
      | none => rfl
      | some i => exact congrFun (congrArg Prod.snd h) i
  | paired I r ih =>
    intro M
    change StratumPoints (I.offDiagonalLiftProfile r.profile) R at M
    change stepCoordinates (r.chart S)
      (I.offDiagonalStratumChart r.profile
        (StratumPoints.map (I.offDiagonalLiftProfile r.profile) φ M)) =
      ((fun i => φ ((stepCoordinates (r.chart R) (I.offDiagonalStratumChart r.profile M)).1 i)),
        fun i => Units.map φ.toMonoidHom
          ((stepCoordinates (r.chart R) (I.offDiagonalStratumChart r.profile M)).2 i))
    rw [I.offDiagonalStratumChart_natural]
    have h := ih (I.offDiagonalStratumChart r.profile M).2.2
    apply Prod.ext
    · funext i
      cases i with
      | inl i => rfl
      | inr i => exact congrFun (congrArg Prod.fst h) i
    · funext i
      cases i with
      | none => rfl
      | some i => exact congrFun (congrArg Prod.snd h) i

def parametersFinEquiv {n : ℕ} (r : StratumRecipe n) (R : Type*) [CommRing R] :
    r.Parameters R ≃ (Fin r.a → R) × (Fin r.b → Rˣ) :=
  Equiv.prodCongr
    (Equiv.arrowCongr (Fintype.equivFin r.FreeIndex) (Equiv.refl R))
    (Equiv.arrowCongr (Fintype.equivFin r.UnitIndex) (Equiv.refl Rˣ))

/-- The finite-coordinate form of the integral product parametrization. -/
def finChart {n : ℕ} (r : StratumRecipe n) (R : Type*) [CommRing R] :
    StratumPoints r.profile R ≃ (Fin r.a → R) × (Fin r.b → Rˣ) :=
  (r.chart R).trans (r.parametersFinEquiv R)

theorem nonempty_stratum {n : ℕ} (r : StratumRecipe n) (R : Type*) [CommRing R] :
    Nonempty (StratumPoints r.profile R) :=
  ⟨(r.finChart R).symm (fun _ => 0, fun _ => 1)⟩

/-- The chart counts points over every finite coefficient ring. -/
theorem card_stratum {n : ℕ} (r : StratumRecipe n)
    (R : Type*) [CommRing R] [Fintype R] :
    Nat.card (StratumPoints r.profile R) =
      Nat.card R ^ r.a * Nat.card Rˣ ^ r.b := by
  classical
  rw [Nat.card_congr (r.finChart R)]
  simp only [Nat.card_prod, Nat.card_fun, Nat.card_fin]

/-- The paper's individual-stratum point count, uniformly over all finite
fields. `RankStratumPointCount` combines this formula with the decomposition
of the complete rank-bounded matrix locus into these strata. -/
theorem card_stratum_finite_field {n : ℕ} (r : StratumRecipe n)
    (F : Type*) [Field F] [Fintype F] :
    Nat.card (StratumPoints r.profile F) =
      Nat.card F ^ r.a * (Nat.card F - 1) ^ r.b := by
  rw [card_stratum, Nat.card_units]

end StratumRecipe

end FourPapers.Symmetric.Strata
end
