/-!
# The characteristic-free off-diagonal Schur calculation

The second pivot is the literal block `[[0,x],[x,y]]`. Its inverse keeps the
independent coordinate `y` and uses only the inverse of `x`. The three prefix
identities below account for zero, one, or two included pivot endpoints.
-/

namespace FourPapers.Symmetric.Pivot.OffDiagonal

open Matrix MvPolynomial

variable {R ι κ : Type*} [CommRing R]

abbrev Two := PUnit.{1} ⊕ PUnit.{1}

def block (x y : R) : Matrix Two Two R :=
  Matrix.fromBlocks (Matrix.of (fun _ _ => 0)) (Matrix.of (fun _ _ => x))
    (Matrix.of (fun _ _ => x)) (Matrix.of (fun _ _ => y))

def blockInverse (q y : R) : Matrix Two Two R :=
  Matrix.fromBlocks (Matrix.of (fun _ _ => -(y * q * q))) (Matrix.of (fun _ _ => q))
    (Matrix.of (fun _ _ => q)) (Matrix.of (fun _ _ => 0))

/-- Only `q*x=1` is used, in every characteristic. -/
def invertibleBlock (x y q : R) (hqx : q * x = 1) : Invertible (block x y) where
  invOf := blockInverse q y
  invOf_mul_self := by
    have hxq : x * q = 1 := (mul_comm _ _).trans hqx
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> cases i <;> cases j
    · simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type, hqx]
    · simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type,
        Fintype.sum_unique, Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
        Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂, Matrix.one_apply_ne,
        Sum.inl_ne_inr]
      calc
        -(y * q * q) * x + q * y = -(y * q) * (q * x) + q * y := by ring
        _ = 0 := by rw [hqx]; ring
    · simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type]
    · simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type, hqx]
  mul_invOf_self := by
    have hxq : x * q = 1 := (mul_comm _ _).trans hqx
    ext i j
    rcases i with i | i <;> rcases j with j | j <;> cases i <;> cases j
    · simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type, hxq]
    · simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type]
    · simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type,
        Fintype.sum_unique, Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
        Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂, Matrix.one_apply_ne,
        Sum.inr_ne_inl]
      calc
        x * -(y * q * q) + y * q = -(y * q) * (x * q) + y * q := by ring
        _ = 0 := by rw [hxq]; ring
    · simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, block, blockInverse, Matrix.mul_apply,
      Fintype.sum_sum_type, hxq]

/-- The exact residual correction, with both carrier families and the
second diagonal coordinate retained. -/
def correction (q y : R) (b c : ι → R) (b' c' : κ → R) : Matrix ι κ R :=
  Matrix.of (fun i j => q * (b i * c' j + c i * b' j) - y * q * q * b i * b' j)

def model (x y q : R) (b c : ι → R) (b' c' : κ → R) (D : Matrix ι κ R) :
    Matrix (Two ⊕ ι) (Two ⊕ κ) R :=
  Matrix.fromBlocks (block x y)
    (Matrix.of (fun (i : Two) (j : κ) => Sum.elim (fun _ => b' j) (fun _ => c' j) i))
    (Matrix.of (fun (i : ι) (j : Two) => Sum.elim (fun _ => b i) (fun _ => c i) j))
    (D + correction q y b c b' c')

theorem correction_transpose (q y : R) (b c : ι → R) (b' c' : κ → R) :
    (correction q y b c b' c').transpose = correction q y b' c' b c := by
  ext i j
  simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, correction, Matrix.transpose_apply]
  ring

theorem model_transpose (x y q : R) (b c : ι → R) (b' c' : κ → R)
    (D : Matrix ι κ R) :
    (model x y q b c b' c' D).transpose = model x y q b' c' b c D.transpose := by
  ext i j
  rcases i with i | i <;> rcases j with j | j
  · rcases i with i | i <;> rcases j with j | j <;> rfl
  · rfl
  · rfl
  · simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, Matrix.transpose_apply,
    Matrix.fromBlocks_apply₂₂,
      Matrix.add_apply, Matrix.transpose_apply, correction]
    ring

/-- A prefix containing both pivot endpoints loses exactly two from every
minor size. This is an equality of actual determinantal ideals. -/
theorem minors_both [Fintype ι] [Fintype κ] [DecidableEq ι] [DecidableEq κ]
    (x y q : R) (hqx : q * x = 1)
    (b c : ι → R) (b' c' : κ → R) (D : Matrix ι κ R) (t : ℕ) :
    matrixMinorIdeal (model x y q b c b' c' D) (t + 2) = matrixMinorIdeal D t := by
  letI := invertibleBlock x y q hqx
  have hc : D + correction q y b c b' c' -
      (Matrix.of (fun (i : ι) (j : Two) => Sum.elim (fun _ => b i) (fun _ => c i) j)) *
        ⅟(block x y) *
      (Matrix.of (fun (i : Two) (j : κ) => Sum.elim (fun _ => b' j) (fun _ => c' j) i)) = D := by
    ext i j
    change D i j + correction q y b c b' c' i j -
      ((Matrix.of (fun (i : ι) (j : Two) => Sum.elim (fun _ => b i) (fun _ => c i) j)) *
