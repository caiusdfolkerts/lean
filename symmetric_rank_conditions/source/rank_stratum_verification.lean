        (Matrix.of (fun (i : Two) (j : κ) => Sum.elim (fun _ => b' j) (fun _ => c' j) i))) i j = D i j
    simp [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, Matrix.mul_apply, Fintype.sum_sum_type,
      blockInverse, correction]
