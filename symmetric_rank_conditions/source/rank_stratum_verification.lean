section

set_option autoImplicit false
set_option maxHeartbeats 1800000

/-!
# The actual open rank stratum in the prime spectrum

The ambient ring is the quotient by the literal northwest-minor ideal. The
open set excludes the vanishing locus of each prescribed rank-size minor
ideal. Its density over every field is a statement about the prime spectrum,
not about the possibly finite set of rational points.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Matrix MvPolynomial Pivot

variable {n : ℕ} {R : Type*} [CommRing R]

def matrixCoordinates (M : SymmetricMatrices n R) : Entry n → R :=
  fun e => M.val e.val.1 e.val.2

@[simp] theorem matrixCoordinates_fold (M : SymmetricMatrices n R) (i j : Fin n) :
    matrixCoordinates M (fold i j) = M.val i j := by
  change M.val (max i j) (min i j) = M.val i j
  rcases le_total i j with h | h
  · rw [max_eq_right h, min_eq_left h]
    exact M.property j i
  · rw [max_eq_left h, min_eq_right h]

def matrixEvaluation (M : SymmetricMatrices n R) : CoordinateRing n R →+* R :=
  MvPolynomial.eval (matrixCoordinates M)

@[simp] theorem matrixEvaluation_generic (M : SymmetricMatrices n R) :
    (genericMatrix n R).map (matrixEvaluation M) = M.val := by
  ext i j
  simp [matrixEvaluation, genericMatrix]

theorem northwestIdeal_le_ker_of_exactRanks (r : RankArray n) (M : StratumPoints r R) :
    northwestIdeal R r ≤ RingHom.ker (matrixEvaluation M.val) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, j, a, b, ha, hb, rfl⟩
  let a' : Fin (r i j + 1) → {p : Fin n // p ≤ i} := fun p => ⟨a p, ha p⟩
  let b' : Fin (r i j + 1) → {q : Fin n // q ≤ j} := fun q => ⟨b q, hb q⟩
  have hz := det_submatrix_mem_matrixMinorIdeal (prefixMatrix M.val.val i j)
    (r i j + 1) a' b'
  rw [(M.property i j).2] at hz
  have hz' := Ideal.mem_bot.mp hz
  change matrixEvaluation M.val (((genericMatrix n R).submatrix a b).det) = 0
  rw [RingHom.map_det]
  change (((genericMatrix n R).submatrix a b).map (matrixEvaluation M.val)).det = 0
  have hmatrix : ((genericMatrix n R).submatrix a b).map (matrixEvaluation M.val) =
      (prefixMatrix M.val.val i j).submatrix a' b' := by
    ext p q
    simp [a', b', prefixMatrix, matrixEvaluation, genericMatrix]
  rw [hmatrix]
  exact hz'

abbrev RankLocusRing (r : RankArray n) (R : Type*) [CommRing R] :=
  CoordinateRing n R ⧸ northwestIdeal R r

def universalMatrix (r : RankArray n) (R : Type*) [CommRing R] :
    Matrix (Fin n) (Fin n) (RankLocusRing r R) :=
  (genericMatrix n R).map (Ideal.Quotient.mk (northwestIdeal R r))

def lowerMinorIdeal (r : RankArray n) (R : Type*) [CommRing R] (i j : Fin n) :
    Ideal (RankLocusRing r R) :=
  matrixMinorIdeal (prefixMatrix (universalMatrix r R) i j) (r i j)

/-- Vanishing of the larger minors is built into the actual quotient, not
assumed as a property of its points. -/
theorem universal_upper_minors (r : RankArray n) (R : Type*) [CommRing R]
    (i j : Fin n) :
    matrixMinorIdeal (prefixMatrix (universalMatrix r R) i j) (r i j + 1) = ⊥ := by
  have hle : matrixMinorIdeal (prefixMatrix (genericMatrix n R) i j) (r i j + 1) ≤
      northwestIdeal R r := by
    rw [prefixMatrix_minorIdeal_eq_fin]
    change matrixMinorIdeal (northwestPrefixMatrix (genericMatrix n R) i j) (r i j + 1) ≤ _
    rw [northwestIdeal_eq_iSup_prefixMinorIdeals]
    exact le_iSup_of_le i (le_iSup_of_le j le_rfl)
  change matrixMinorIdeal
    (prefixMatrix ((genericMatrix n R).map (Ideal.Quotient.mk (northwestIdeal R r))) i j)
      (r i j + 1) = ⊥
  rw [prefixMatrix_map, ← matrixMinorIdeal_map]
  apply le_antisymm ?_ bot_le
  apply Ideal.map_le_iff_le_comap.mpr
  intro f hf
  change Ideal.Quotient.mk (northwestIdeal R r) f = 0
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (hle hf)

def rankStratumOpen (r : RankArray n) (R : Type*) [CommRing R] :
    Set (PrimeSpectrum (RankLocusRing r R)) :=
  ⋂ i : Fin n, ⋂ j : Fin n,
    (PrimeSpectrum.zeroLocus (lowerMinorIdeal r R i j : Set (RankLocusRing r R)))ᶜ

theorem rankStratumOpen_isOpen (r : RankArray n) (R : Type*) [CommRing R] :
    IsOpen (rankStratumOpen r R) :=
  isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
    (PrimeSpectrum.isClosed_zeroLocus _).isOpen_compl

/-- A morphism of affine spectra lands in the complement of an ideal's
zero locus exactly when the extended ideal is the whole target ring. -/
theorem range_comap_subset_compl_zeroLocus {A B : Type*} [CommRing A] [CommRing B]
    (f : A →+* B) (I : Ideal A) :
    Set.range (PrimeSpectrum.comap f) ⊆ (PrimeSpectrum.zeroLocus (I : Set A))ᶜ ↔
      I.map f = ⊤ := by
  constructor
  · intro h
    apply PrimeSpectrum.zeroLocus_empty_iff_eq_top.mp
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro p hp
    apply h ⟨p, rfl⟩
    apply (PrimeSpectrum.mem_zeroLocus _ _).mpr
    intro a ha
    exact (PrimeSpectrum.mem_zeroLocus p _).mp hp (Ideal.mem_map_of_mem f ha)
  · intro h q hq hz
    obtain ⟨p, rfl⟩ := hq
    have hle : I.map f ≤ p.asIdeal := Ideal.map_le_iff_le_comap.mpr
      ((PrimeSpectrum.mem_zeroLocus _ _).mp hz)
    rw [h] at hle
    exact p.isPrime.ne_top (eq_top_iff.mpr hle)

/-- This is the all-ring point dictionary for the actual open: an affine
morphism lands in it precisely when its literal universal matrix has every
prescribed exact minor rank. No field-point-only interpretation is used. -/
theorem map_lands_in_rankStratumOpen_iff {S : Type*} [CommRing S]
    (r : RankArray n) (R : Type*) [CommRing R] (f : RankLocusRing r R →+* S) :
    Set.range (PrimeSpectrum.comap f) ⊆ rankStratumOpen r R ↔
      ∀ i j, ExactMinorRank (prefixMatrix ((universalMatrix r R).map f) i j) (r i j) := by
  constructor
  · intro h i j
    constructor
    · rw [prefixMatrix_map, ← matrixMinorIdeal_map]
      apply (range_comap_subset_compl_zeroLocus f (lowerMinorIdeal r R i j)).mp
      intro p hp
      exact Set.mem_iInter.mp (Set.mem_iInter.mp (h hp) i) j
    · rw [prefixMatrix_map, ← matrixMinorIdeal_map, universal_upper_minors, Ideal.map_bot]
  · intro h p hp
    apply Set.mem_iInter.mpr
    intro i
    apply Set.mem_iInter.mpr
    intro j
    have hlow : (lowerMinorIdeal r R i j).map f = ⊤ := by
      rw [lowerMinorIdeal, matrixMinorIdeal_map, ← prefixMatrix_map]
      exact (h i j).1
    exact (range_comap_subset_compl_zeroLocus f _).mpr hlow hp

def stratumEvaluation (r : RankArray n) (M : StratumPoints r R) : RankLocusRing r R →+* R :=
  Ideal.Quotient.lift (northwestIdeal R r) (matrixEvaluation M.val)
    (fun f hf => northwestIdeal_le_ker_of_exactRanks r M hf)

@[simp] theorem stratumEvaluation_universal (r : RankArray n) (M : StratumPoints r R) :
    (universalMatrix r R).map (stratumEvaluation r M) = M.val.val := by
  ext i j
  simp [universalMatrix, stratumEvaluation, matrixEvaluation, genericMatrix]

theorem lowerMinorIdeal_map_evaluation (r : RankArray n) (M : StratumPoints r R)
    (i j : Fin n) : (lowerMinorIdeal r R i j).map (stratumEvaluation r M) = ⊤ := by
  rw [lowerMinorIdeal, matrixMinorIdeal_map, ← prefixMatrix_map,
    stratumEvaluation_universal]
  exact (M.property i j).1

theorem evaluation_kernel_mem_rankStratumOpen {F : Type*} [Field F]
    (r : RankArray n) (M : StratumPoints r F) :
    (⟨RingHom.ker (stratumEvaluation r M), RingHom.ker_isPrime _⟩ :
      PrimeSpectrum (RankLocusRing r F)) ∈ rankStratumOpen r F := by
  apply Set.mem_iInter.mpr
  intro i
  apply Set.mem_iInter.mpr
  intro j
  intro hz
  have hle : lowerMinorIdeal r F i j ≤ RingHom.ker (stratumEvaluation r M) :=
    (PrimeSpectrum.mem_zeroLocus _ _).mp hz
  have hm : (lowerMinorIdeal r F i j).map (stratumEvaluation r M) ≤ (⊥ : Ideal F) :=
    Ideal.map_le_iff_le_comap.mpr hle
  rw [lowerMinorIdeal_map_evaluation] at hm
  exact top_ne_bot (le_antisymm hm bot_le)

theorem rankStratumOpen_nonempty (w : SymmetricRook n) (F : Type*) [Field F] :
    (rankStratumOpen w.val.rankProfile F).Nonempty := by
  obtain ⟨M⟩ := w.nonempty_stratum F
  exact ⟨⟨RingHom.ker (stratumEvaluation _ M), RingHom.ker_isPrime _⟩,
    evaluation_kernel_mem_rankStratumOpen _ M⟩

theorem rankLocusRing_isDomain (w : SymmetricRook n) (F : Type*) [Field F] :
    IsDomain (RankLocusRing w.val.rankProfile F) := by
  have hw : (w.val.toMatrix ℚ).transpose = w.val.toMatrix ℚ := by
    ext i j
    exact w.val.toMatrix_symmetric w.property ℚ j i
  change IsDomain (CoordinateRing n F ⧸ northwestIdeal F w.val.rankProfile)
  rw [← w.val.matrixRankArray_toMatrix ℚ]
  exact symmetric_rank_quotient_isDomain (w.val.toMatrix ℚ) hw F

/-- The actual rank-condition open is dense in the actual prime spectrum
over every field, including finite and imperfect fields. -/
theorem rankStratumOpen_dense (w : SymmetricRook n) (F : Type*) [Field F] :
    Dense (rankStratumOpen w.val.rankProfile F) := by
  letI := rankLocusRing_isDomain w F
  exact (rankStratumOpen_isOpen w.val.rankProfile F).dense (rankStratumOpen_nonempty w F)

end FourPapers.Symmetric.Strata
end
end
