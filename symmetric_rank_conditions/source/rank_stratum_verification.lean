section

set_option autoImplicit false
set_option maxHeartbeats 1000000

/-!
# Ordered prefix infrastructure for the rank-stratum charts

These are literal reindexings and determinantal identities used by the
stratum product charts. Inherited residual prefixes retain the original
order; no replacement rank condition is imposed.
-/

noncomputable section
namespace FourPapers.Symmetric.Pivot
variable {n N : ℕ} {R : Type*} [CommRing R]

/-- A front singleton block and the remaining indices, with the actual
first index equal to zero. -/
def frontIndexEquiv (n : ℕ) : (PUnit.{1} ⊕ Fin n) ≃ Fin (n + 1) where
  toFun := Sum.elim (fun _ => 0) Fin.succ
  invFun := Fin.cases (.inl PUnit.unit) Sum.inr
  left_inv := by
    rintro (i | i)
    · cases i; rfl
    · rfl
  right_inv := by
    intro i
    cases i using Fin.cases <;> rfl

def prefixEmbedding (i : Fin n) : Fin (i.val + 1) ↪o Fin n :=
  Fin.castLEOrderEmb (Nat.succ_le_iff.mpr i.isLt)

/-- A minor with more rows than the entire matrix is zero, and hence its
whole fixed-size determinantal ideal is zero. -/
theorem matrixMinorIdeal_eq_bot_of_rows_lt {ι κ : Type*} [Fintype ι]
    (M : Matrix ι κ R) (t : ℕ) (ht : Fintype.card ι < t) :
    matrixMinorIdeal M t = ⊥ := by
  classical
  apply le_antisymm ?_ bot_le
  apply Ideal.span_le.mpr
  rintro f ⟨a, b, rfl⟩
  have ha : ¬ Function.Injective a := by
    intro ha
    have hcard : t ≤ Fintype.card ι := by
      simpa only [Fintype.card_fin] using Fintype.card_le_of_injective a ha
    exact ht.not_ge hcard
  obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp ha
  rw [Matrix.det_zero_of_row_eq hne (by ext k; simp only [Matrix.submatrix_apply, hij])]
  exact Ideal.zero_mem _

theorem matrixMinorIdeal_eq_bot_of_cols_lt {ι κ : Type*} [Fintype κ]
    (M : Matrix ι κ R) (t : ℕ) (ht : Fintype.card κ < t) :
    matrixMinorIdeal M t = ⊥ := by
  rw [← matrixMinorIdeal_transpose]
  exact matrixMinorIdeal_eq_bot_of_rows_lt M.transpose t ht

def embeddingPrefix (e : Fin n ↪o Fin (N + 1)) (i : Fin (N + 1)) :=
  {a : Fin n // e a ≤ i}

def embeddingPrefixEquiv (e : Fin n ↪o Fin (N + 1)) (i : Fin (N + 1))
    (a : Fin n) (ha : ∀ b, e b ≤ i ↔ b ≤ a) :
    embeddingPrefix e i ≃ {b : Fin n // b ≤ a} where
  toFun b := ⟨b.val, (ha b.val).mp b.property⟩
  invFun b := ⟨b.val, (ha b.val).mpr b.property⟩
  left_inv b := rfl
  right_inv b := rfl

theorem embeddingPrefix_has_last (e : Fin n ↪o Fin (N + 1)) (i : Fin (N + 1))
    (hi : ∃ b, e b ≤ i) : ∃ a : Fin n, ∀ b, e b ≤ i ↔ b ≤ a := by
  classical
  let s := Finset.univ.filter (fun b => e b ≤ i)
  have hs : s.Nonempty := by
    obtain ⟨b, hb⟩ := hi
    exact ⟨b, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hb⟩⟩
  refine ⟨s.max' hs, fun b => ⟨?_, ?_⟩⟩
  · intro hb
    exact Finset.le_max' s b (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hb⟩)
  · intro hb
    have ha : e (s.max' hs) ≤ i := (Finset.mem_filter.mp (Finset.max'_mem s hs)).2
    exact (e.monotone hb).trans ha

/-- Every nonzero first row has a first pivot. This selects an actual nonzero
entry of the realizing matrix; it does not add a condition on its rank table. -/
theorem exists_first_row_pivot
    {n : ℕ} {F : Type*} [Field F]
    (w : Matrix (Fin (n + 1)) (Fin (n + 1)) F)
    (hrow : ∃ j, w 0 j ≠ 0) :
    ∃ k, w 0 k ≠ 0 ∧ ∀ l, l < k → w 0 l = 0 := by
  classical
  let s := Finset.univ.filter (fun j => w 0 j ≠ 0)
  have hs : s.Nonempty := by
    obtain ⟨j, hj⟩ := hrow
    exact ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩⟩
  refine ⟨s.min' hs, (Finset.mem_filter.mp (Finset.min'_mem s hs)).2, ?_⟩
  intro l hl
  by_contra hne
  have hmem : l ∈ s := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hne⟩
  exact (not_le_of_gt hl) (Finset.min'_le s l hmem)


end FourPapers.Symmetric.Pivot
end
