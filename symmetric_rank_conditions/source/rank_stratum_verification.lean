section

set_option autoImplicit false
set_option maxHeartbeats 1400000

/-!
# Rank strata over arbitrary commutative rings

Rank exactly `r` means that the `(r+1)`-minor ideal vanishes and the `r`-minor
ideal is the whole coefficient ring. These are the actual determinantal
conditions representing the locally closed rank stratum. Over a field the
predicate is proved equivalent to the ordinary matrix-rank equality.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Matrix

variable {R S ι κ ι' κ' : Type*} [CommRing R] [CommRing S]

/-- The determinantal definition of constant exact rank over a ring. -/
def ExactMinorRank (M : Matrix ι κ R) (r : ℕ) : Prop :=
  matrixMinorIdeal M r = ⊤ ∧ matrixMinorIdeal M (r + 1) = ⊥

theorem matrixMinorIdeal_size_zero (M : Matrix ι κ R) : matrixMinorIdeal M 0 = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  simpa using det_submatrix_mem_matrixMinorIdeal M 0 Fin.elim0 Fin.elim0

theorem matrixMinorIdeal_size_one_eq_bot (M : Matrix ι κ R) :
    matrixMinorIdeal M 1 = ⊥ ↔ M = 0 := by
  constructor
  · intro h
    ext i j
    have hm := det_submatrix_mem_matrixMinorIdeal M 1 (fun _ => i) (fun _ => j)
    rw [h] at hm
    simpa using (Ideal.mem_bot.mp hm)
  · rintro rfl
    apply le_antisymm ?_ bot_le
    apply Ideal.span_le.mpr
    rintro _ ⟨a, b, rfl⟩
    simp

@[simp] theorem exactMinorRank_zero (M : Matrix ι κ R) :
    ExactMinorRank M 0 ↔ M = 0 := by
  simp only [ExactMinorRank, matrixMinorIdeal_size_zero, true_and, Nat.zero_add,
    matrixMinorIdeal_size_one_eq_bot]

theorem ExactMinorRank.map {M : Matrix ι κ R} {r : ℕ}
    (h : ExactMinorRank M r) (φ : R →+* S) : ExactMinorRank (M.map φ) r := by
  constructor
  · rw [← matrixMinorIdeal_map, h.1, Ideal.map_top]
  · rw [← matrixMinorIdeal_map, h.2, Ideal.map_bot]

theorem exactMinorRank_submatrix_equiv (M : Matrix ι κ R) (r : ℕ)
    (a : ι' ≃ ι) (b : κ' ≃ κ) :
    ExactMinorRank (M.submatrix a b) r ↔ ExactMinorRank M r := by
  simp only [ExactMinorRank, matrixMinorIdeal_submatrix_equiv]

/-- An exact shift of every minor ideal transports both inequalities of
the rank condition. This lemma applies in zero, one, and two-pivot charts. -/
theorem exactMinorRank_of_minor_shift (M : Matrix ι κ R) (D : Matrix ι' κ' R)
    (s : ℕ) (h : ∀ t, matrixMinorIdeal M (t + s) = matrixMinorIdeal D t) (r : ℕ) :
    ExactMinorRank M (r + s) ↔ ExactMinorRank D r := by
  simp only [ExactMinorRank, h r,
    show r + s + 1 = (r + 1) + s by omega, h (r + 1)]

/-- All minors of size `r` vanish precisely when the matrix has rank below `r`.
The reverse implication also covers repeated row or column selections. -/
theorem matrixMinorIdeal_eq_bot_iff_rank_lt {F : Type*} [Field F]
    [Fintype ι] [Fintype κ] (M : Matrix ι κ F) (r : ℕ) :
    matrixMinorIdeal M r = ⊥ ↔ M.rank < r := by
  classical
  constructor
  · intro h
    by_contra hn
    obtain ⟨a, b, hab⟩ := le_rank_iff_nonzero_minor.mp (Nat.le_of_not_gt hn)
    have hm := det_submatrix_mem_matrixMinorIdeal M r a b
    rw [h] at hm
    exact hab (Ideal.mem_bot.mp hm)
  · intro h
    apply le_antisymm ?_ bot_le
    apply Ideal.span_le.mpr
    rintro _ ⟨a, b, rfl⟩
    apply Ideal.mem_bot.mpr
    by_contra hn
    have hr := Matrix.rank_of_det_ne_zero hn
    have hle := Matrix.rank_submatrix_le M a b
    simp only [Fintype.card_fin] at hr
    omega

theorem exactMinorRank_iff_rank {F : Type*} [Field F] [Fintype ι] [Fintype κ]
    (M : Matrix ι κ F) (r : ℕ) : ExactMinorRank M r ↔ M.rank = r := by
  constructor
  · rintro ⟨htop, hbot⟩
    have hlt := (matrixMinorIdeal_eq_bot_iff_rank_lt M (r + 1)).mp hbot
    have hle : r ≤ M.rank := by
      by_contra hn
      have hz := (matrixMinorIdeal_eq_bot_iff_rank_lt M r).mpr (Nat.lt_of_not_ge hn)
      rw [htop] at hz
      exact top_ne_bot hz
    omega
  · intro hrank
    constructor
    · rcases Ideal.eq_bot_or_top (matrixMinorIdeal M r) with h | h
      · have hh := (matrixMinorIdeal_eq_bot_iff_rank_lt M r).mp h
        omega
      · exact h
    · exact (matrixMinorIdeal_eq_bot_iff_rank_lt M (r + 1)).mpr (by omega)

/-- Literal symmetric matrices, before any coordinate parametrization. -/
abbrev SymmetricMatrices (n : ℕ) (R : Type*) [CommRing R] :=
  {M : Matrix (Fin n) (Fin n) R // ∀ i j, M i j = M j i}

def SymmetricMatrices.map {n : ℕ} (φ : R →+* S)
    (M : SymmetricMatrices n R) : SymmetricMatrices n S :=
  ⟨M.val.map φ, fun i j => congrArg φ (M.property i j)⟩

/-- The original northwest prefix, with no choice of a new rank array. -/
def prefixMatrix {n : ℕ} (M : Matrix (Fin n) (Fin n) R) (i j : Fin n) :
    Matrix {p : Fin n // p ≤ i} {q : Fin n // q ≤ j} R :=
  M.submatrix Subtype.val Subtype.val

@[simp] theorem prefixMatrix_map {n : ℕ} (M : Matrix (Fin n) (Fin n) R)
    (φ : R →+* S) (i j : Fin n) :
    prefixMatrix (M.map φ) i j = (prefixMatrix M i j).map φ := rfl

/-- The rank-stratum functor on coefficient rings, using all actual
northwest rank equalities. It is not defined through its proposed chart. -/
def StratumPoints {n : ℕ} (r : RankArray n) (R : Type*) [CommRing R] :=
  {M : SymmetricMatrices n R // ∀ i j, ExactMinorRank (prefixMatrix M.val i j) (r i j)}

noncomputable instance instFintypeStratumPoints {n : ℕ} (r : RankArray n)
    [Fintype R] : Fintype (StratumPoints r R) := by
  classical
  exact inferInstanceAs (Fintype
    {M : SymmetricMatrices n R // ∀ i j, ExactMinorRank (prefixMatrix M.val i j) (r i j)})

def StratumPoints.map {n : ℕ} (r : RankArray n) (φ : R →+* S)
    (M : StratumPoints r R) : StratumPoints r S :=
  ⟨M.val.map φ, fun i j => (M.property i j).map φ⟩

@[simp] theorem StratumPoints.map_val {n : ℕ} (r : RankArray n)
    (φ : R →+* S) (M : StratumPoints r R) :
    (StratumPoints.map r φ M).val.val = M.val.val.map φ := rfl

/-- The determinantal functor has exactly the usual rank-stratum points
over a field. This supplies the comparison needed for finite-field counts. -/
theorem stratumPoints_field_iff {n : ℕ} {F : Type*} [Field F]
    (r : RankArray n) (M : SymmetricMatrices n F) :
    (∀ i j, ExactMinorRank (prefixMatrix M.val i j) (r i j)) ↔
      matrixRankArray M.val = r := by
  simp only [exactMinorRank_iff_rank]
  constructor
  · intro h
    funext i j
    exact h i j
  · intro h i j
    exact congrFun (congrFun h i) j

end FourPapers.Symmetric.Strata
end
end
