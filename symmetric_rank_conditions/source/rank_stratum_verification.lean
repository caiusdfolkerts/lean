namespace FourPapers.Symmetric

open Matrix

namespace Pivot.OffDiagonal

variable {N n : ℕ} {R : Type*} [CommRing R]

namespace IndexData
variable (I : IndexData N n)

def firstCarrier (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R) (i : Fin n) : R :=
  w 0 (I.rest i)

def secondCarrier (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R) (i : Fin n) : R :=
  w I.pivot (I.rest i)

/-- The literal symmetric residual matrix. Its entries are the old entries
minus the full two-pivot correction, including the `y*b_i*b_j/x²` term. -/
def residual (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R) (q : R) : Matrix (Fin n) (Fin n) R :=
  w.submatrix I.rest I.rest - correction q (w I.pivot I.pivot)
    (I.firstCarrier w) (I.secondCarrier w) (I.firstCarrier w) (I.secondCarrier w)

theorem residual_symmetric (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R) (q : R)
    (hw : ∀ i j, w i j = w j i) :
    ∀ i j, I.residual w q i j = I.residual w q j i := by
  intro i j
  simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, residual, Matrix.sub_apply, Matrix.submatrix_apply,
    correction]
  rw [hw (I.rest i) (I.rest j)]
  ring

theorem reindexed_eq_model (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R) (q : R)
    (hw : ∀ i j, w i j = w j i) (hzero : w 0 0 = 0) :
    w.submatrix I.indexEquiv I.indexEquiv =
      model (w 0 I.pivot) (w I.pivot I.pivot) q
        (I.firstCarrier w) (I.secondCarrier w)
        (I.firstCarrier w) (I.secondCarrier w) (I.residual w q) := by
  ext i j
  rcases i with (i | i) | i <;> rcases j with (j | j) | j
  · simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, block, indexEquiv] using hzero
  · rfl
  · rfl
  · simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, block, indexEquiv] using hw I.pivot 0
  · rfl
  · rfl
  · simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, firstCarrier, indexEquiv] using hw (I.rest i) 0
  · simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, secondCarrier,
    indexEquiv] using hw (I.rest i) I.pivot
  · simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
    Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, model, Matrix.submatrix_apply, indexEquiv_rest,
      Matrix.fromBlocks_apply₂₂, residual, Matrix.sub_apply, Matrix.add_apply,
      sub_add_cancel]

/-- Prefix matrices use exactly the original order and the literal remaining
initial segments. Empty residual prefixes are allowed. -/
def originalPrefix (I : IndexData N n) (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R)
    (i j : Fin (N + 1)) :
    Matrix {a : Fin (N + 1) // a ≤ i} {b : Fin (N + 1) // b ≤ j} R :=
  w.submatrix Subtype.val Subtype.val

def residualPrefix (D : Matrix (Fin n) (Fin n) R) (i j : Fin (N + 1)) :
    Matrix (I.Prefix i) (I.Prefix j) R :=
  D.submatrix Subtype.val Subtype.val

def prefixContribution (i j : Fin (N + 1)) : ℕ :=
  (if I.pivot ≤ i then 1 else 0) + (if I.pivot ≤ j then 1 else 0)

theorem firstCarrier_before (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R)
    (hbefore : ∀ l, l < I.pivot → w 0 l = 0)
    (i : Fin (N + 1)) (hi : i < I.pivot) :
    (fun r : I.Prefix i => I.firstCarrier w r.val) = 0 := by
  funext r
  exact hbefore (I.rest r.val) (r.property.trans_lt hi)

/-- Exact northwest minor reduction for every original rectangular prefix.
The pivot contribution is derived by whether the second endpoint has entered
each prefix, rather than stipulated as a rank-array hypothesis. -/
theorem prefix_minors (w : Matrix (Fin (N + 1)) (Fin (N + 1)) R) (q : R)
    (hw : ∀ i j, w i j = w j i)
    (hbefore : ∀ l, l < I.pivot → w 0 l = 0)
    (hqx : q * w 0 I.pivot = 1) (i j : Fin (N + 1)) (t : ℕ) :
    matrixMinorIdeal (I.originalPrefix w i j) (t + I.prefixContribution i j) =
      matrixMinorIdeal (I.residualPrefix (I.residual w q) i j) t := by
  classical
  have hzero : w 0 0 = 0 := hbefore 0 (Fin.pos_iff_ne_zero.mpr I.pivot_ne_zero)
  have hmodel := I.reindexed_eq_model w q hw hzero
  let b : I.Prefix i → R := fun r => I.firstCarrier w r.val
  let c : I.Prefix i → R := fun r => I.secondCarrier w r.val
  let b' : I.Prefix j → R := fun r => I.firstCarrier w r.val
  let c' : I.Prefix j → R := fun r => I.secondCarrier w r.val
  let D := I.residualPrefix (I.residual w q) i j
  let x := w 0 I.pivot
  let y := w I.pivot I.pivot
  by_cases hi : I.pivot ≤ i <;> by_cases hj : I.pivot ≤ j
  · have hm : (I.originalPrefix w i j).submatrix (I.prefixAfterEquiv i hi)
        (I.prefixAfterEquiv j hj) = model x y q b c b' c' D := by
      ext a d
      have hh := congrArg (fun M => M
        (Sum.map id (fun r : I.Prefix i => r.val) a)
        (Sum.map id (fun r : I.Prefix j => r.val) d)) hmodel
      rcases a with (a | a) | a <;> rcases d with (d | d) | d <;>
        simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
          Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, originalPrefix, prefixAfterEquiv, model, block,
          indexEquiv,
          residualPrefix, b, c, b', c', D, x, y, correction] using hh
    simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, prefixContribution, if_pos hi, if_pos hj]
    rw [← matrixMinorIdeal_submatrix_equiv _ (I.prefixAfterEquiv i hi)
      (I.prefixAfterEquiv j hj), hm]
    exact minors_both x y q hqx b c b' c' D t
  · have hj' : j < I.pivot := lt_of_not_ge hj
    have hb' : b' = 0 := I.firstCarrier_before w hbefore j hj'
    have hm : (I.originalPrefix w i j).submatrix (I.prefixAfterEquiv i hi)
        (I.prefixBeforeEquiv j hj') = (model x y q b c b' c' D).submatrix id oneEndpoint := by
      ext a d
      have hh := congrArg (fun M => M
        (Sum.map id (fun r : I.Prefix i => r.val) a)
        (Sum.map id (fun r : I.Prefix j => r.val) (oneEndpoint d))) hmodel
      rcases a with (a | a) | a <;> rcases d with d | d <;>
        simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
          Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, originalPrefix, prefixAfterEquiv,
          prefixBeforeEquiv, model, block,
          indexEquiv, oneEndpoint, residualPrefix, b, c, b', c', D, x, y, correction] using hh
    simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, prefixContribution, if_pos hi, if_neg hj, add_zero]
    rw [← matrixMinorIdeal_submatrix_equiv _ (I.prefixAfterEquiv i hi)
      (I.prefixBeforeEquiv j hj'), hm, hb']
    exact minors_row_only x y q hqx b c c' D t
  · have hi' : i < I.pivot := lt_of_not_ge hi
    have hb : b = 0 := I.firstCarrier_before w hbefore i hi'
    have hm : (I.originalPrefix w i j).submatrix (I.prefixBeforeEquiv i hi')
        (I.prefixAfterEquiv j hj) = (model x y q b c b' c' D).submatrix oneEndpoint id := by
      ext a d
      have hh := congrArg (fun M => M
        (Sum.map id (fun r : I.Prefix i => r.val) (oneEndpoint a))
        (Sum.map id (fun r : I.Prefix j => r.val) d)) hmodel
      rcases a with a | a <;> rcases d with (d | d) | d <;>
        simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
          Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, originalPrefix, prefixAfterEquiv,
          prefixBeforeEquiv, model, block,
          indexEquiv, oneEndpoint, residualPrefix, b, c, b', c', D, x, y, correction] using hh
    simp only [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
      Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, prefixContribution, if_neg hi, if_pos hj, zero_add]
    rw [← matrixMinorIdeal_submatrix_equiv _ (I.prefixBeforeEquiv i hi')
      (I.prefixAfterEquiv j hj), hm, hb]
    exact minors_column_only x y q hqx c b' c' D t
  · have hi' : i < I.pivot := lt_of_not_ge hi
    have hj' : j < I.pivot := lt_of_not_ge hj
    have hb : b = 0 := I.firstCarrier_before w hbefore i hi'
    have hb' : b' = 0 := I.firstCarrier_before w hbefore j hj'
    have hm : (I.originalPrefix w i j).submatrix (I.prefixBeforeEquiv i hi')
        (I.prefixBeforeEquiv j hj') = (model x y q b c b' c' D).submatrix oneEndpoint oneEndpoint := by
      ext a d
      have hh := congrArg (fun M => M
        (Sum.map id (fun r : I.Prefix i => r.val) (oneEndpoint a))
        (Sum.map id (fun r : I.Prefix j => r.val) (oneEndpoint d))) hmodel
      rcases a with a | a <;> rcases d with d | d <;>
        simpa [Matrix.fromBlocks, Matrix.of_apply, Matrix.submatrix_apply, Matrix.add_apply,
          Matrix.sub_apply, Sum.elim_inl, Sum.elim_inr, originalPrefix, prefixBeforeEquiv, model, block,
          indexEquiv,
