        E, C, B, Matrix.of_apply, BlockMatrix.fromCols, Sum.elim_inl, Sum.elim_inr,
        Matrix.zero_apply, mul_zero, sub_zero]
    | inr j =>
      simp only [Matrix.sub_apply, Matrix.mul_apply, Fintype.sum_unique,
        E, C, B, Matrix.of_apply, BlockMatrix.fromCols, Sum.elim_inl, Sum.elim_inr]
      ring
