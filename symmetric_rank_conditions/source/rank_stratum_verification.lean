section

set_option autoImplicit false
set_option maxHeartbeats 1200000

/-!
# Representing the actual rank-stratum functor

The independently defined determinantal stratum is naturally represented,
on every commutative coefficient ring, by the literal affine-times-torus
coordinate ring. This component connects the recursive matrix charts with
the polynomial-localization universal property. Geometric identification
with an open subscheme of the rank locus is a separate assertion.

-/

noncomputable section

namespace FourPapers.Symmetric.Strata.StratumRecipe

universe u v w

theorem finChart_natural {n : ℕ} (r : StratumRecipe n)
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (φ : R →+* S) (M : StratumPoints r.profile R) :
    r.finChart S (StratumPoints.map r.profile φ M) =
      AffineTorus.mapPoints r.a r.b φ (r.finChart R M) := by
  have h := r.chart_natural φ M
  apply Prod.ext
  · funext i
    exact congrFun (congrArg Prod.fst h) ((Fintype.equivFin r.FreeIndex).symm i)
  · funext j
    exact congrFun (congrArg Prod.snd h) ((Fintype.equivFin r.UnitIndex).symm j)

/-- The literal ring representing the actual matrix stratum. -/
abbrev representingRing {n : ℕ} (r : StratumRecipe n) :=
  AffineTorus.CoordinateRing ℤ r.a r.b

/-- Ring homomorphisms from the displayed polynomial localization are
exactly the actual symmetric matrices with the prescribed minor ranks. -/
def representingEquiv {n : ℕ} (r : StratumRecipe n)
    (R : Type u) [CommRing R] :
    (r.representingRing →+* R) ≃ StratumPoints r.profile R :=
  (AffineTorus.ringHomEquiv R r.a r.b).trans (r.finChart R).symm

@[simp] theorem finChart_representingEquiv {n : ℕ} (r : StratumRecipe n)
    {R : Type u} [CommRing R] (f : r.representingRing →+* R) :
    r.finChart R (r.representingEquiv R f) =
      AffineTorus.ringHomEquiv R r.a r.b f :=
  (r.finChart R).apply_symm_apply _

theorem representingEquiv_natural {n : ℕ} (r : StratumRecipe n)
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (φ : R →+* S) (f : r.representingRing →+* R) :
    r.representingEquiv S (φ.comp f) =
      StratumPoints.map r.profile φ (r.representingEquiv R f) := by
  apply (r.finChart S).injective
  rw [finChart_representingEquiv, finChart_natural, finChart_representingEquiv]
  exact AffineTorus.ringHomEquiv_natural r.a r.b φ f

theorem representingEquiv_symm_natural {n : ℕ} (r : StratumRecipe n)
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (φ : R →+* S) (M : StratumPoints r.profile R) :
    (r.representingEquiv S).symm (StratumPoints.map r.profile φ M) =
      φ.comp ((r.representingEquiv R).symm M) := by
  apply (r.representingEquiv S).injective
  rw [Equiv.apply_symm_apply, representingEquiv_natural, Equiv.apply_symm_apply]

/-- The same literal polynomial localization over an arbitrary base ring. -/
abbrev representingRingOver {n : ℕ} (r : StratumRecipe n)
    (R : Type u) [CommRing R] := AffineTorus.CoordinateRing R r.a r.b

/-- Ordinary scheme morphisms over an arbitrary base retain the chosen
coefficient map. The second coordinate is the independently defined
determinantal stratum, with its original rank array. -/
def representingRingEquiv {n : ℕ} (r : StratumRecipe n)
    (R : Type u) [CommRing R] (S : Type v) [CommRing S] :
    (r.representingRingOver R →+* S) ≃ (R →+* S) × StratumPoints r.profile S :=
  (AffineTorus.unrestrictedRingHomEquiv R r.a r.b S).trans
    (Equiv.prodCongr (Equiv.refl _) (r.finChart S).symm)

@[simp] theorem representingRingEquiv_coefficient {n : ℕ} (r : StratumRecipe n)
    {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    (f : r.representingRingOver R →+* S) :
    (r.representingRingEquiv R S f).1 =
      f.comp (algebraMap R (r.representingRingOver R)) := rfl

@[simp] theorem finChart_representingRingEquiv {n : ℕ} (r : StratumRecipe n)
    {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    (f : r.representingRingOver R →+* S) :
    r.finChart S (r.representingRingEquiv R S f).2 =
      (AffineTorus.unrestrictedRingHomEquiv R r.a r.b S f).2 :=
  (r.finChart S).apply_symm_apply _

theorem representingRingEquiv_natural {n : ℕ} (r : StratumRecipe n)
    {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    {T : Type w} [CommRing T] (φ : S →+* T)
    (f : r.representingRingOver R →+* S) :
    r.representingRingEquiv R T (φ.comp f) =
      (φ.comp (r.representingRingEquiv R S f).1,
        StratumPoints.map r.profile φ (r.representingRingEquiv R S f).2) := by
  apply Prod.ext
  · rfl
  · apply (r.finChart T).injective
    rw [finChart_representingRingEquiv, finChart_natural,
      finChart_representingRingEquiv]
    exact congrArg Prod.snd
      (AffineTorus.unrestrictedRingHomEquiv_natural R r.a r.b φ f)

end FourPapers.Symmetric.Strata.StratumRecipe
end
end
