set_option maxHeartbeats 1600000

/-!
# The actual open rank-stratum scheme is affine space times a torus

This component combines three independently proved universal properties:
the open restriction of the original northwest-minor quotient, the actual
matrix rank conditions, and the explicit polynomial localization. Naturality
on every commutative test ring produces an actual scheme isomorphism by
affine-open-cover gluing. Coefficient maps are retained, so the isomorphism
commutes with the structure maps to the chosen base ring.

-/

noncomputable section

namespace FourPapers.Symmetric.Strata

open CategoryTheory AlgebraicGeometry

universe u

variable {n : ℕ}

/-- The independently defined open scheme has exactly the original
constant-rank matrices on every commutative test ring. -/
def rankStratumSchemePointEquiv (r : RankArray n) (R S : Type u)
    [CommRing R] [CommRing S] :
    (Spec (CommRingCat.of S) ⟶ rankStratumScheme r R) ≃
      (R →+* S) × StratumPoints r S :=
  (rankStratumHomEquiv r R S).trans (rankStratumOpenPointEquiv r R S)

/-- The coefficient coordinate is the actual composite with the base-ring map. -/
@[simp] theorem rankStratumSchemePointEquiv_coefficient (r : RankArray n)
    (R S : Type u) [CommRing R] [CommRing S]
    (g : Spec (CommRingCat.of S) ⟶ rankStratumScheme r R) :
    (rankStratumSchemePointEquiv r R S g).1 =
      (Spec.preimage (g ≫ rankStratumImmersion r R)).hom.comp
        (rankLocusCoefficientMap r R) := rfl

theorem rankStratumSchemePointEquiv_natural (r : RankArray n)
    {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    (φ : S →+* T) (g : Spec (CommRingCat.of S) ⟶ rankStratumScheme r R) :
    rankStratumSchemePointEquiv r R T (Spec.map (CommRingCat.ofHom φ) ≫ g) =
      (φ.comp (rankStratumSchemePointEquiv r R S g).1,
        StratumPoints.map r φ (rankStratumSchemePointEquiv r R S g).2) := by
  have hopen : rankStratumHomEquiv r R T (Spec.map (CommRingCat.ofHom φ) ≫ g) =
      rankStratumOpenPointMap r φ (rankStratumHomEquiv r R S g) :=
    affineOpenHomEquiv_natural (rankStratumOpens r R) φ g
  change rankStratumOpenPointEquiv r R T
    (rankStratumHomEquiv r R T (Spec.map (CommRingCat.ofHom φ) ≫ g)) = _
  rw [hopen]
  exact rankStratumOpenPointEquiv_natural r φ (rankStratumHomEquiv r R S g)

namespace StratumRecipe

variable (r : StratumRecipe n) (R : Type u) [CommRing R]

/-- A natural identification of affine test points, retaining the base
coefficient homomorphism on both sides. -/
def affineChartPointEquiv (S : CommRingCat.{u}) :
    (Spec S ⟶ Spec (CommRingCat.of (r.representingRingOver R))) ≃
      (Spec S ⟶ rankStratumScheme r.profile R) :=
  (Spec.homEquivRingHom (R := r.representingRingOver R) (S := S)).trans
    ((r.representingRingEquiv R S).trans
      (rankStratumSchemePointEquiv r.profile R S).symm)

@[simp] theorem affineChartPointEquiv_data (S : CommRingCat.{u})
    (g : Spec S ⟶ Spec (CommRingCat.of (r.representingRingOver R))) :
    rankStratumSchemePointEquiv r.profile R S (r.affineChartPointEquiv R S g) =
      r.representingRingEquiv R S (Spec.preimage g).hom := by
  exact (rankStratumSchemePointEquiv r.profile R S).apply_symm_apply _

theorem affineChartPointEquiv_natural (S T : CommRingCat.{u})
    (φ : S ⟶ T)
    (g : Spec S ⟶ Spec (CommRingCat.of (r.representingRingOver R))) :
    r.affineChartPointEquiv R T (Spec.map φ ≫ g) =
      Spec.map φ ≫ r.affineChartPointEquiv R S g := by
  apply (rankStratumSchemePointEquiv r.profile R T).injective
  rw [affineChartPointEquiv_data, ← CommRingCat.ofHom_hom φ,
    rankStratumSchemePointEquiv_natural, affineChartPointEquiv_data]
  rw [Spec.preimage_comp, Spec.preimage_map]
  simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using
    r.representingRingEquiv_natural φ.hom (Spec.preimage g).hom

/-- The exact determinantal open in the original rank locus is isomorphic
to the literal affine-times-torus polynomial localization, over every ring. -/
def openSchemeIso :
    Spec (CommRingCat.of (r.representingRingOver R)) ≅ rankStratumScheme r.profile R :=
  SchemeAffineTest.iso_of_natural_affine_points
    (r.affineChartPointEquiv R) (r.affineChartPointEquiv_natural R)

@[simp] theorem openSchemeIso_hom :
    (r.openSchemeIso R).hom = r.affineChartPointEquiv R
      (CommRingCat.of (r.representingRingOver R)) (𝟙 _) := rfl

/-- The structure morphism of the original affine rank locus. -/
def rankLocusStructureMap :
    rankLocusScheme r.profile R ⟶ Spec (CommRingCat.of R) :=
  Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap r.profile R))

/-- The isomorphism respects the actual coefficient-ring structure maps.
This is stronger than an isomorphism of the underlying point sets. -/
theorem openSchemeIso_over :
    ((r.openSchemeIso R).hom ≫ rankStratumImmersion r.profile R) ≫
        r.rankLocusStructureMap R =
      Spec.map (CommRingCat.ofHom
        (algebraMap R (r.representingRingOver R))) := by
  have h := congrArg Prod.fst (r.affineChartPointEquiv_data R
    (CommRingCat.of (r.representingRingOver R)) (𝟙 _))
  have hcoeff :
      (Spec.preimage ((r.openSchemeIso R).hom ≫ rankStratumImmersion r.profile R)).hom.comp
        (rankLocusCoefficientMap r.profile R) =
          algebraMap R (r.representingRingOver R) := by
    simpa only [rankStratumSchemePointEquiv_coefficient, openSchemeIso_hom,
      representingRingEquiv_coefficient, Spec.preimage_id,
      CommRingCat.hom_id, RingHom.id_comp] using h
  apply Spec.preimage_injective
  simp only [rankLocusStructureMap, Spec.preimage_comp, Spec.preimage_map]
  ext x
  exact congrArg (fun f : R →+* r.representingRingOver R => f x) hcoeff

/-- The chart is an actual open immersion into the original affine rank
locus, not an abstract replacement of that locus. -/
def openChartImmersion :
    Spec (CommRingCat.of (r.representingRingOver R)) ⟶ rankLocusScheme r.profile R :=
  (r.openSchemeIso R).hom ≫ rankStratumImmersion r.profile R

instance : IsOpenImmersion (r.openChartImmersion R) := by
  change IsOpenImmersion
    ((r.openSchemeIso R).hom ≫ rankStratumImmersion r.profile R)
  infer_instance

/-- Its image is exactly the determinantal open fixed before the chart
was constructed. -/
theorem openChartImmersion_range :
    Set.range (r.openChartImmersion R) = rankStratumOpen r.profile R := by
  rw [← range_rankStratumImmersion r.profile R]
  ext p
  constructor
  · rintro ⟨q, rfl⟩
    exact ⟨(r.openSchemeIso R).hom q, rfl⟩
  · rintro ⟨q, rfl⟩
    refine ⟨(r.openSchemeIso R).inv q, ?_⟩
    change rankStratumImmersion r.profile R
      ((r.openSchemeIso R).hom ((r.openSchemeIso R).inv q)) =
        rankStratumImmersion r.profile R q
    congr 1
    change ((r.openSchemeIso R).inv ≫ (r.openSchemeIso R).hom) q = q
    rw [(r.openSchemeIso R).inv_hom_id]
    rfl

end StratumRecipe

/-- Equality of rank arrays changes only the named determinantal open. -/
def rankStratumSchemeCongr {r s : RankArray n} (h : r = s)
    (R : Type u) [CommRing R] : rankStratumScheme r R ≅ rankStratumScheme s R :=
  eqToIso (congrArg (fun ρ => rankStratumScheme ρ R) h)

/-- Transport of the profile respects the original structure map.  The
proof is uniform in the profiles and does not unfold any recursive chart. -/
theorem rankStratumSchemeCongr_over {r s : RankArray n} (h : r = s)
    (R : Type u) [CommRing R] :
    (rankStratumSchemeCongr h R).hom ≫
        (rankStratumImmersion s R ≫
          Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap s R))) =
      rankStratumImmersion r R ≫
        Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap r R)) := by
  cases h
  simp [rankStratumSchemeCongr]

namespace SymmetricRook

variable (w : SymmetricRook n) (R : Type u) [CommRing R]

/-- The unrestricted profile form, using the proved recipe coverage and
the paper's well-defined exponents `a(w)` and `b(w)`. -/
def openSchemeIso :
    Spec (CommRingCat.of (AffineTorus.CoordinateRing R w.a w.b)) ≅
      rankStratumScheme w.val.rankProfile R := by
  change Spec (CommRingCat.of (w.recipe.representingRingOver R)) ≅
    rankStratumScheme w.val.rankProfile R
  exact (w.recipe.openSchemeIso R).trans (rankStratumSchemeCongr w.recipe_profile R)

@[simp] theorem openSchemeIso_hom :
    (w.openSchemeIso R).hom =
      (w.recipe.openSchemeIso R).hom ≫ (rankStratumSchemeCongr w.recipe_profile R).hom := rfl

/-- The profile chart is an isomorphism over the original coefficient ring. -/
theorem openSchemeIso_over :
    ((w.openSchemeIso R).hom ≫ rankStratumImmersion w.val.rankProfile R) ≫
        Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap w.val.rankProfile R)) =
      Spec.map (CommRingCat.ofHom
        (algebraMap R (AffineTorus.CoordinateRing R w.a w.b))) := by
  change (((w.recipe.openSchemeIso R).hom ≫
      (rankStratumSchemeCongr w.recipe_profile R).hom) ≫
        rankStratumImmersion w.val.rankProfile R) ≫
          Spec.map (CommRingCat.ofHom (rankLocusCoefficientMap w.val.rankProfile R)) =
    Spec.map (CommRingCat.ofHom (algebraMap R (w.recipe.representingRingOver R)))
  simp only [Category.assoc, rankStratumSchemeCongr_over]
  change (w.recipe.openSchemeIso R).hom ≫
      (rankStratumImmersion w.recipe.profile R ≫ w.recipe.rankLocusStructureMap R) =
    Spec.map (CommRingCat.ofHom (algebraMap R (w.recipe.representingRingOver R)))
  simpa only [Category.assoc] using w.recipe.openSchemeIso_over R

end SymmetricRook

end FourPapers.Symmetric.Strata
end
end
