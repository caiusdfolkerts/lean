section

set_option autoImplicit false
set_option maxHeartbeats 1600000

/-!
# The diagonal rank-stratum chart

The source matrix and all its northwest rectangles are literal matrices. The
coordinate equivalence is defined over every commutative coefficient ring and
is natural for arbitrary ring homomorphisms.
-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Matrix Pivot

variable {n : ℕ} {R S : Type*} [CommRing R] [CommRing S]

abbrev DiagonalOpen (n : ℕ) (R : Type*) [CommRing R] :=
  {M : SymmetricMatrices (n + 1) R // IsUnit (M.val 0 0)}

abbrev DiagonalCoordinates (n : ℕ) (R : Type*) [CommRing R] :=
  Rˣ × (Fin n → R) × SymmetricMatrices n R

/-- The inverse Schur formula, using an actual unit rather than a field inverse. -/
def diagonalModel (x : Rˣ) (b : Fin n → R) (D : SymmetricMatrices n R) :
    SymmetricMatrices (n + 1) R :=
  ⟨Matrix.of (Fin.cases (Fin.cases (↑x) b)
      (fun i => Fin.cases (b i) (fun j => D.val i j + ↑(x⁻¹) * b i * b j))), by
    intro i j
    cases i using Fin.cases <;> cases j using Fin.cases
    · rfl
    · rfl
    · rfl
    · dsimp
      rw [D.property]
      ring⟩

@[simp] theorem diagonalModel_zero_zero (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) : (diagonalModel x b D).val 0 0 = ↑x := rfl

@[simp] theorem diagonalModel_zero_succ (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) (j : Fin n) :
    (diagonalModel x b D).val 0 j.succ = b j := rfl

@[simp] theorem diagonalModel_succ_zero (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) (i : Fin n) :
    (diagonalModel x b D).val i.succ 0 = b i := rfl

@[simp] theorem diagonalModel_succ_succ (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) (i j : Fin n) :
    (diagonalModel x b D).val i.succ j.succ =
      D.val i j + ↑(x⁻¹) * b i * b j := rfl

def diagonalDecode (M : DiagonalOpen n R) : DiagonalCoordinates n R :=
  (M.property.unit, (fun i => M.val.val 0 i.succ),
    ⟨Matrix.of (fun i j => M.val.val i.succ j.succ -
        ↑(M.property.unit⁻¹) * M.val.val 0 i.succ * M.val.val 0 j.succ), by
      intro i j
      change M.val.val i.succ j.succ -
          ↑(M.property.unit⁻¹) * M.val.val 0 i.succ * M.val.val 0 j.succ =
        M.val.val j.succ i.succ -
          ↑(M.property.unit⁻¹) * M.val.val 0 j.succ * M.val.val 0 i.succ
      rw [M.val.property i.succ j.succ]
      ring⟩)

def diagonalEncode (p : DiagonalCoordinates n R) : DiagonalOpen n R :=
  ⟨diagonalModel p.1 p.2.1 p.2.2, p.1.isUnit⟩

theorem diagonalEncode_decode (M : DiagonalOpen n R) :
    diagonalEncode (diagonalDecode M) = M := by
  apply Subtype.ext
  apply Subtype.ext
  ext i j
  cases i using Fin.cases with
  | zero =>
    cases j using Fin.cases with
    | zero => exact M.property.unit_spec
    | succ j => rfl
  | succ i =>
    cases j using Fin.cases with
    | zero => exact M.val.property 0 i.succ
    | succ j =>
      change (M.val.val i.succ j.succ -
        ↑(M.property.unit⁻¹) * M.val.val 0 i.succ * M.val.val 0 j.succ) +
        ↑(M.property.unit⁻¹) * M.val.val 0 i.succ * M.val.val 0 j.succ = _
      exact sub_add_cancel _ _

theorem diagonalDecode_encode (p : DiagonalCoordinates n R) :
    diagonalDecode (diagonalEncode p) = p := by
  have hu : (diagonalEncode p).property.unit = p.1 := by
    apply Units.ext
    exact (diagonalEncode p).property.unit_spec
  apply Prod.ext hu
  apply Prod.ext
  · rfl
  · apply Subtype.ext
    ext i j
    change (p.2.2.val i j + ↑(p.1⁻¹) * p.2.1 i * p.2.1 j) -
      ↑((diagonalEncode p).property.unit⁻¹) * p.2.1 i * p.2.1 j = _
    rw [hu]
    ring

/-- The actual diagonal open locus is a unit, a free row, and a smaller
symmetric matrix. The construction is valid over rings with zero divisors. -/
def diagonalChart : DiagonalOpen n R ≃ DiagonalCoordinates n R where
  toFun := diagonalDecode
  invFun := diagonalEncode
  left_inv := diagonalEncode_decode
  right_inv := diagonalDecode_encode

def diagonalOpenMap (φ : R →+* S) (M : DiagonalOpen n R) : DiagonalOpen n S :=
  ⟨M.val.map φ, M.property.map φ⟩

def diagonalCoordinatesMap (φ : R →+* S) (p : DiagonalCoordinates n R) :
    DiagonalCoordinates n S :=
  (Units.map φ.toMonoidHom p.1, φ ∘ p.2.1, p.2.2.map φ)

theorem diagonalModel_map (φ : R →+* S) (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) :
    (diagonalModel x b D).map φ =
      diagonalModel (Units.map φ.toMonoidHom x) (φ ∘ b) (D.map φ) := by
  apply Subtype.ext
  ext i j
  cases i using Fin.cases <;> cases j using Fin.cases <;>
    simp [diagonalModel, SymmetricMatrices.map, Matrix.map_apply, Matrix.of_apply, Function.comp_def]

theorem diagonalEncode_natural (φ : R →+* S) (p : DiagonalCoordinates n R) :
    diagonalOpenMap φ (diagonalEncode p) =
      diagonalEncode (diagonalCoordinatesMap φ p) := by
  apply Subtype.ext
  exact diagonalModel_map φ p.1 p.2.1 p.2.2

theorem diagonalChart_natural (φ : R →+* S) (M : DiagonalOpen n R) :
    diagonalChart (diagonalOpenMap φ M) =
      diagonalCoordinatesMap φ (diagonalChart M) := by
  apply (diagonalChart (n := n) (R := S)).symm.injective
  change diagonalEncode (diagonalDecode (diagonalOpenMap φ M)) =
    diagonalEncode (diagonalCoordinatesMap φ (diagonalDecode M))
  rw [diagonalEncode_decode, ← diagonalEncode_natural, diagonalEncode_decode]

/-- The ordered finite prefix and the literal subtype prefix have the same
minor ideals; this bridge prevents an implicit change of rank convention. -/
def prefixIndexEquiv {m : ℕ} (i : Fin m) :
    Fin (i.val + 1) ≃ {p : Fin m // p ≤ i} where
  toFun p := ⟨prefixEmbedding i p, by change p.val ≤ i.val; omega⟩
  invFun p := ⟨p.val.val, by have := p.property; omega⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem prefixMatrix_minorIdeal_eq_fin {m : ℕ}
    (M : Matrix (Fin m) (Fin m) R) (i j : Fin m) (t : ℕ) :
    matrixMinorIdeal (prefixMatrix M i j) t =
      matrixMinorIdeal (M.submatrix (prefixEmbedding i) (prefixEmbedding j)) t := by
  symm
  exact matrixMinorIdeal_submatrix_equiv (prefixMatrix M i j)
    (prefixIndexEquiv i) (prefixIndexEquiv j) t

theorem diagonalModel_prefix_minor_shift (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) (i j : Fin n) (t : ℕ) :
    matrixMinorIdeal (prefixMatrix (diagonalModel x b D).val i.succ j.succ) (t + 1) =
      matrixMinorIdeal (prefixMatrix D.val i j) t := by
  classical
  rw [prefixMatrix_minorIdeal_eq_fin, prefixMatrix_minorIdeal_eq_fin]
  let A : Matrix PUnit.{1} PUnit.{1} R := Matrix.of (fun _ _ => ↑x)
  let B : Matrix PUnit.{1} (Fin (j.val + 1)) R := Matrix.of (fun _ k => b (prefixEmbedding j k))
  let C : Matrix (Fin (i.val + 1)) PUnit.{1} R := Matrix.of (fun k _ => b (prefixEmbedding i k))
  let E : Matrix (Fin (i.val + 1)) (Fin (j.val + 1)) R :=
    Matrix.of (fun a c => D.val (prefixEmbedding i a) (prefixEmbedding j c) +
      ↑(x⁻¹) * b (prefixEmbedding i a) * b (prefixEmbedding j c))
  letI : Invertible A := {
    invOf := Matrix.of (fun _ _ => ↑(x⁻¹))
    invOf_mul_self := by
      ext a c
      cases a; cases c
      simpa only [Matrix.mul_apply, Fintype.sum_unique, A, Matrix.of_apply,
        Matrix.one_apply_eq] using Units.inv_mul x
    mul_invOf_self := by
      ext a c
      cases a; cases c
      simpa only [Matrix.mul_apply, Fintype.sum_unique, A, Matrix.of_apply,
        Matrix.one_apply_eq] using Units.mul_inv x }
  have hblock :
      ((diagonalModel x b D).val.submatrix
        (prefixEmbedding i.succ) (prefixEmbedding j.succ)).submatrix
        (frontIndexEquiv (i.val + 1)) (frontIndexEquiv (j.val + 1)) =
      Matrix.fromBlocks A B C E := by
    ext a c
    rcases a with a | a <;> rcases c with c | c <;> rfl
  have hres : E - C * ⅟A * B = D.val.submatrix (prefixEmbedding i) (prefixEmbedding j) := by
    ext a c
    change (D.val (prefixEmbedding i a) (prefixEmbedding j c) +
      ↑(x⁻¹) * b (prefixEmbedding i a) * b (prefixEmbedding j c)) -
      (C * Matrix.of (fun (_ _ : PUnit.{1}) => (↑(x⁻¹) : R)) * B) a c = _
    simp only [Matrix.mul_apply, Fintype.sum_unique, B, C, Matrix.of_apply, Matrix.submatrix_apply]
    ring
  rw [← matrixMinorIdeal_submatrix_equiv _ (frontIndexEquiv (i.val + 1))
    (frontIndexEquiv (j.val + 1)), hblock]
  simpa only [Fintype.card_punit, hres] using matrixMinorIdeal_schur A B C E t

theorem diagonalModel_prefix_exact_rank (x : Rˣ) (b : Fin n → R)
    (D : SymmetricMatrices n R) (i j : Fin n) (r : ℕ) :
    ExactMinorRank (prefixMatrix (diagonalModel x b D).val i.succ j.succ) (r + 1) ↔
      ExactMinorRank (prefixMatrix D.val i j) r :=
  exactMinorRank_of_minor_shift _ _ 1 (diagonalModel_prefix_minor_shift x b D i j) r

theorem prefix_minorIdeal_one_eq_top_of_unit
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (hx : IsUnit (M 0 0)) (i j : Fin (n + 1)) :
    matrixMinorIdeal (prefixMatrix M i j) 1 = ⊤ := by
  have hm : M 0 0 ∈ matrixMinorIdeal (prefixMatrix M i j) 1 := by
    simpa only [Matrix.det_fin_one, Matrix.submatrix_apply, prefixMatrix] using
      det_submatrix_mem_matrixMinorIdeal (prefixMatrix M i j) 1
        (fun _ => ⟨0, Fin.zero_le i⟩) (fun _ => ⟨0, Fin.zero_le j⟩)
  exact (matrixMinorIdeal (prefixMatrix M i j) 1).eq_top_of_isUnit_mem hm hx

theorem prefix_exactRank_first_row
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (hx : IsUnit (M 0 0)) (j : Fin (n + 1)) :
    ExactMinorRank (prefixMatrix M 0 j) 1 := by
  constructor
  · exact prefix_minorIdeal_one_eq_top_of_unit M hx 0 j
  · rw [prefixMatrix_minorIdeal_eq_fin]
    exact matrixMinorIdeal_eq_bot_of_rows_lt _ 2 (by simp)

theorem prefix_exactRank_first_col
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (hx : IsUnit (M 0 0)) (i : Fin (n + 1)) :
    ExactMinorRank (prefixMatrix M i 0) 1 := by
  constructor
  · exact prefix_minorIdeal_one_eq_top_of_unit M hx i 0
  · rw [prefixMatrix_minorIdeal_eq_fin]
    exact matrixMinorIdeal_eq_bot_of_cols_lt _ 2 (by simp)

theorem matrixMinorIdeal_fin_one (M : Matrix (Fin 1) (Fin 1) R) :
    matrixMinorIdeal M 1 = Ideal.span ({M 0 0} : Set R) := by
  apply congrArg Ideal.span
  ext z
  constructor
  · rintro ⟨a, b, rfl⟩
    have ha : a = fun _ => (0 : Fin 1) := funext fun _ => Subsingleton.elim _ _
    have hb : b = fun _ => (0 : Fin 1) := funext fun _ => Subsingleton.elim _ _
    simp [ha, hb]
  · intro hz
    have hz' : z = M 0 0 := Set.mem_singleton_iff.mp hz
    subst z
    exact ⟨fun _ => 0, fun _ => 0, by simp⟩

theorem unit_of_first_prefix_rank_one
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) R)
    (h : ExactMinorRank (prefixMatrix M 0 0) 1) : IsUnit (M 0 0) := by
  have hminor : matrixMinorIdeal (prefixMatrix M 0 0) 1 =
      Ideal.span ({M 0 0} : Set R) := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      rintro z ⟨a, b, rfl⟩
      rw [Matrix.det_fin_one]
      have ha : (a 0).val = 0 := le_antisymm (a 0).property (Fin.zero_le _)
      have hb : (b 0).val = 0 := le_antisymm (b 0).property (Fin.zero_le _)
      change M (a 0).val (b 0).val ∈ _
      rw [ha, hb]
      exact Ideal.subset_span (Set.mem_singleton _)
    · apply Ideal.span_le.mpr
      intro z hz
      obtain rfl := Set.mem_singleton_iff.mp hz
      change M 0 0 ∈ matrixMinorIdeal (prefixMatrix M 0 0) 1
      simpa only [Matrix.det_fin_one, Matrix.submatrix_apply, prefixMatrix] using
        det_submatrix_mem_matrixMinorIdeal (prefixMatrix M 0 0) 1
          (fun _ => ⟨0, le_rfl⟩) (fun _ => ⟨0, le_rfl⟩)
  exact Ideal.span_singleton_eq_top.mp (hminor.symm.trans h.1)

def diagonalLiftProfile (r : RankArray n) : RankArray (n + 1) :=
  Fin.cases (fun _ => 1) (fun i => Fin.cases 1 (fun j => r i j + 1))

theorem diagonalModel_stratum_iff (r : RankArray n) (x : Rˣ)
    (b : Fin n → R) (D : SymmetricMatrices n R) :
    (∀ i j, ExactMinorRank (prefixMatrix (diagonalModel x b D).val i j)
      (diagonalLiftProfile r i j)) ↔
    ∀ i j, ExactMinorRank (prefixMatrix D.val i j) (r i j) := by
  constructor
  · intro h i j
    exact (diagonalModel_prefix_exact_rank x b D i j (r i j)).mp (h i.succ j.succ)
  · intro h i j
    cases i using Fin.cases with
    | zero => exact prefix_exactRank_first_row _ x.isUnit j
    | succ i =>
      cases j using Fin.cases with
      | zero => exact prefix_exactRank_first_col _ x.isUnit i.succ
      | succ j =>
        exact (diagonalModel_prefix_exact_rank x b D i j (r i j)).mpr (h i j)

/-- The diagonal branch on the actual locally closed rank-stratum functors.
Every profile is retained, including profiles with an empty stratum. -/
def diagonalStratumChart (r : RankArray n) :
    StratumPoints (diagonalLiftProfile r) R ≃
      Rˣ × (Fin n → R) × StratumPoints r R where
  toFun M := by
    let U : DiagonalOpen n R :=
      ⟨M.val, unit_of_first_prefix_rank_one M.val.val (M.property 0 0)⟩
    let p := diagonalDecode U
    have hM : diagonalModel p.1 p.2.1 p.2.2 = M.val :=
      congrArg Subtype.val (diagonalEncode_decode U)
    exact (p.1, p.2.1, ⟨p.2.2,
      (diagonalModel_stratum_iff r p.1 p.2.1 p.2.2).mp (by rw [hM]; exact M.property)⟩)
  invFun p :=
    ⟨diagonalModel p.1 p.2.1 p.2.2.val,
      (diagonalModel_stratum_iff r p.1 p.2.1 p.2.2.val).mpr p.2.2.property⟩
  left_inv M := by
    apply Subtype.ext
    exact congrArg (fun U : DiagonalOpen n R => U.val) (diagonalEncode_decode
      ⟨M.val, unit_of_first_prefix_rank_one M.val.val (M.property 0 0)⟩)
  right_inv p := by
    have hh := diagonalDecode_encode (p.1, p.2.1, p.2.2.val)
    refine Prod.ext ?_ ?_
    · exact congrArg (fun q : DiagonalCoordinates n R => q.1) hh
    · refine Prod.ext ?_ ?_
      · exact congrArg (fun q : DiagonalCoordinates n R => q.2.1) hh
      · apply Subtype.ext
        exact congrArg (fun q : DiagonalCoordinates n R => q.2.2) hh

def diagonalStratumCoordinatesMap (r : RankArray n) (φ : R →+* S)
    (p : Rˣ × (Fin n → R) × StratumPoints r R) :
    Sˣ × (Fin n → S) × StratumPoints r S :=
  (Units.map φ.toMonoidHom p.1, φ ∘ p.2.1, StratumPoints.map r φ p.2.2)

theorem diagonalStratumChart_natural (r : RankArray n) (φ : R →+* S)
    (M : StratumPoints (diagonalLiftProfile r) R) :
    diagonalStratumChart r (StratumPoints.map (diagonalLiftProfile r) φ M) =
      diagonalStratumCoordinatesMap r φ (diagonalStratumChart r M) := by
  have h := diagonalChart_natural φ
    ⟨M.val, unit_of_first_prefix_rank_one M.val.val (M.property 0 0)⟩
  refine Prod.ext ?_ ?_
  · exact congrArg (fun q : DiagonalCoordinates n S => q.1) h
  · refine Prod.ext ?_ ?_
    · exact congrArg (fun q : DiagonalCoordinates n S => q.2.1) h
    · apply Subtype.ext
      exact congrArg (fun q : DiagonalCoordinates n S => q.2.2) h

end FourPapers.Symmetric.Strata
end
