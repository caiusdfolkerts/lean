/-!
# Independence of the chart exponents

The two exponents can be recovered from the point count over the field with
three elements. Consequently different valid pivot recipes for the same
actual rank profile give the same exponents. The point-count formula used
here has already been proved for every finite field; this argument is only
an invariant-of-presentation proof, not a finite-instance substitute for it.

-/

noncomputable section
namespace FourPapers.Symmetric.Strata
namespace StratumRecipe

theorem exponents_eq_of_three_two_powers {a b c d : ℕ}
    (h : 3 ^ a * 2 ^ b = 3 ^ c * 2 ^ d) : a = c ∧ b = d := by
  have h3 := congrArg (fun x : ℕ => x.factorization 3) h
  have h2 := congrArg (fun x : ℕ => x.factorization 2) h
  have hp3 : Nat.Prime 3 := by decide
  have hp2 : Nat.Prime 2 := by decide
  have hz3 (k : ℕ) : (3 : ℕ) ^ k ≠ 0 := pow_ne_zero k (by decide)
  have hz2 (k : ℕ) : (2 : ℕ) ^ k ≠ 0 := pow_ne_zero k (by decide)
  simp only [Nat.factorization_mul (hz3 a) (hz2 b),
    Nat.factorization_mul (hz3 c) (hz2 d), hp3.factorization_pow,
    hp2.factorization_pow, Finsupp.add_apply, Finsupp.single_apply] at h3 h2
  norm_num at h3 h2
  exact ⟨h3, h2⟩

/-- The paper's recursively computed exponents depend on the actual rank
profile, and hence on the partial permutation, rather than on index choices. -/
theorem exponents_eq_of_profile_eq {n : ℕ} (r s : StratumRecipe n)
    (h : r.profile = s.profile) : r.a = s.a ∧ r.b = s.b := by
  letI : Fact (Nat.Prime 3) := ⟨by decide⟩
  have hc : Nat.card (StratumPoints r.profile (ZMod 3)) =
      Nat.card (StratumPoints s.profile (ZMod 3)) := congrArg
        (fun ρ : RankArray n => Nat.card (StratumPoints ρ (ZMod 3))) h
  rw [card_stratum_finite_field, card_stratum_finite_field] at hc
  have hcard : Nat.card (ZMod 3) = 3 := by
    rw [Nat.card_eq_fintype_card, ZMod.card]
  simp only [hcard, show 3 - 1 = (2 : ℕ) by decide] at hc
  exact exponents_eq_of_three_two_powers hc

end StratumRecipe
end FourPapers.Symmetric.Strata
end
end
