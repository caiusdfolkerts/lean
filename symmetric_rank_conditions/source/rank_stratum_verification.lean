section

set_option autoImplicit false
set_option maxHeartbeats 1800000

noncomputable section

/-!
# The actual off-diagonal rank-stratum chart

All constructions are over an arbitrary commutative ring.  The source is a
subtype of actual symmetric matrices with the prescribed zero entries and
an invertible first-row pivot.  Both directions are explicit matrix formulas,
and rank equalities are expressed by the actual ideals of minors.
-/

namespace FourPapers.Symmetric.Pivot.OffDiagonal.IndexData

open Matrix FourPapers.Symmetric.Strata

variable {N n : ℕ} (I : IndexData N n)

/-- The literal off-diagonal pivot open set inside the prescribed linear
zero locus.  The pivot condition is invertibility over the coefficient ring. -/
def OffDiagonalPatch (R : Type*) [CommRing R] :=
  {M : SymmetricMatrices (N + 1) R //
    (∀ j, j < I.pivot → M.val 0 j = 0) ∧ IsUnit (M.val 0 I.pivot)}

abbrev OffDiagonalCoordinates (R : Type*) [CommRing R] :=
  Rˣ × (I.FreeCarrier → R) × SymmetricMatrices n R

section Ring
variable {R : Type*} [CommRing R]

/-- Fill the forced carrier coordinates with zero and retain every other
carrier as an independent coordinate. -/
def extendOffDiagonalCarrier (z : I.FreeCarrier → R) (c : IndexData.Carrier n) : R := by
  classical
  exact if h : I.forcedCarrier c then 0 else z ⟨c, h⟩

@[simp] theorem extendOffDiagonalCarrier_free (z : I.FreeCarrier → R)
    (c : I.FreeCarrier) : I.extendOffDiagonalCarrier z c.val = z c := by
  simp only [Matrix.of_apply, extendOffDiagonalCarrier, dif_neg c.property]

@[simp] theorem extendOffDiagonalCarrier_zero (z : I.FreeCarrier → R) :
    I.extendOffDiagonalCarrier z .zero = 0 := by
  simp [extendOffDiagonalCarrier, IndexData.forcedCarrier]

/-- Read the actual entries associated with the carrier partition. -/
def readOffDiagonalCarrier (M : Matrix (Fin (N + 1)) (Fin (N + 1)) R) :
    IndexData.Carrier n → R
  | .zero => M 0 0
  | .diagonal => M I.pivot I.pivot
  | .first i => M 0 (I.rest i)
  | .second i => M I.pivot (I.rest i)

def offDiagonalPivotUnit (M : I.OffDiagonalPatch R) : Rˣ := M.property.2.unit

@[simp] theorem offDiagonalPivotUnit_val (M : I.OffDiagonalPatch R) :
    (I.offDiagonalPivotUnit M : R) = M.val.val 0 I.pivot := M.property.2.unit_spec

theorem readOffDiagonalCarrier_forced (M : I.OffDiagonalPatch R)
    (c : IndexData.Carrier n) (hc : I.forcedCarrier c) :
    I.readOffDiagonalCarrier M.val.val c = 0 := by
  cases c with
  | zero => exact M.property.1 0 (Fin.pos_iff_ne_zero.mpr I.pivot_ne_zero)
  | diagonal => exact False.elim hc
  | first i => exact M.property.1 (I.rest i) hc
  | second i => exact False.elim hc

@[simp] theorem extend_readOffDiagonalCarrier (M : I.OffDiagonalPatch R)
    (c : IndexData.Carrier n) :
    I.extendOffDiagonalCarrier (fun c : I.FreeCarrier =>
      I.readOffDiagonalCarrier M.val.val c.val) c = I.readOffDiagonalCarrier M.val.val c := by
  by_cases hc : I.forcedCarrier c
  · simp only [Matrix.of_apply, extendOffDiagonalCarrier, dif_pos hc,
      I.readOffDiagonalCarrier_forced M c hc]
  · simp only [Matrix.of_apply, extendOffDiagonalCarrier, dif_neg hc]

/-- Insert the full Schur correction and restore the original index order. -/
def offDiagonalMatrix (p : I.OffDiagonalCoordinates R) :
    Matrix (Fin (N + 1)) (Fin (N + 1)) R :=
  (model (p.1 : R) (I.extendOffDiagonalCarrier p.2.1 .diagonal) (↑p.1⁻¹)
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.first i))
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.second i))
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.first i))
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.second i)) p.2.2.val).submatrix
      I.indexEquiv.symm I.indexEquiv.symm

@[simp] theorem offDiagonalMatrix_index (p : I.OffDiagonalCoordinates R)
    (i j : Two ⊕ Fin n) :
    I.offDiagonalMatrix p (I.indexEquiv i) (I.indexEquiv j) =
      model (p.1 : R) (I.extendOffDiagonalCarrier p.2.1 .diagonal) (↑p.1⁻¹)
        (fun i => I.extendOffDiagonalCarrier p.2.1 (.first i))
        (fun i => I.extendOffDiagonalCarrier p.2.1 (.second i))
        (fun i => I.extendOffDiagonalCarrier p.2.1 (.first i))
        (fun i => I.extendOffDiagonalCarrier p.2.1 (.second i)) p.2.2.val i j := by
  simp only [Matrix.of_apply, offDiagonalMatrix, Matrix.submatrix_apply, Equiv.symm_apply_apply]

@[simp] theorem offDiagonalMatrix_pivot (p : I.OffDiagonalCoordinates R) :
    I.offDiagonalMatrix p 0 I.pivot = (p.1 : R) := by
  have h := I.offDiagonalMatrix_index p (.inl (.inl PUnit.unit)) (.inl (.inr PUnit.unit))
  simpa only [Matrix.of_apply, IndexData.indexEquiv_first, IndexData.indexEquiv_second, model, block,
    Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂] using h

@[simp] theorem read_offDiagonalMatrix (p : I.OffDiagonalCoordinates R)
    (c : IndexData.Carrier n) :
    I.readOffDiagonalCarrier (I.offDiagonalMatrix p) c =
      I.extendOffDiagonalCarrier p.2.1 c := by
  cases c with
  | zero =>
    have h := I.offDiagonalMatrix_index p (.inl (.inl PUnit.unit)) (.inl (.inl PUnit.unit))
    simpa only [Matrix.of_apply, readOffDiagonalCarrier, IndexData.indexEquiv_first, model, block,
      Matrix.fromBlocks_apply₁₁, I.extendOffDiagonalCarrier_zero] using h
  | diagonal =>
    have h := I.offDiagonalMatrix_index p (.inl (.inr PUnit.unit)) (.inl (.inr PUnit.unit))
    simpa only [Matrix.of_apply, readOffDiagonalCarrier, IndexData.indexEquiv_second, model, block,
      Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₂₂] using h
  | first i =>
    have h := I.offDiagonalMatrix_index p (.inl (.inl PUnit.unit)) (.inr i)
    simpa only [Matrix.of_apply, readOffDiagonalCarrier, IndexData.indexEquiv_first,
      IndexData.indexEquiv_rest, model, Matrix.fromBlocks_apply₁₂, Sum.elim_inl] using h
  | second i =>
    have h := I.offDiagonalMatrix_index p (.inl (.inr PUnit.unit)) (.inr i)
    simpa only [Matrix.of_apply, readOffDiagonalCarrier, IndexData.indexEquiv_second,
      IndexData.indexEquiv_rest, model, Matrix.fromBlocks_apply₁₂, Sum.elim_inr] using h

@[simp] theorem offDiagonalMatrix_residual (p : I.OffDiagonalCoordinates R) :
    I.residual (I.offDiagonalMatrix p) (↑p.1⁻¹) = p.2.2.val := by
  ext i j
  have h := I.offDiagonalMatrix_index p (.inr i) (.inr j)
  have hy := I.read_offDiagonalMatrix p .diagonal
  have hb (a : Fin n) := I.read_offDiagonalMatrix p (.first a)
  have hc (a : Fin n) := I.read_offDiagonalMatrix p (.second a)
  change I.offDiagonalMatrix p (I.rest i) (I.rest j) -
    correction (↑p.1⁻¹) (I.offDiagonalMatrix p I.pivot I.pivot)
      (I.firstCarrier (I.offDiagonalMatrix p)) (I.secondCarrier (I.offDiagonalMatrix p))
      (I.firstCarrier (I.offDiagonalMatrix p)) (I.secondCarrier (I.offDiagonalMatrix p)) i j = _
  simp only [Matrix.of_apply, IndexData.indexEquiv_rest, model, Matrix.fromBlocks_apply₂₂,
    Matrix.add_apply] at h
  rw [h]
  simp only [Matrix.of_apply, readOffDiagonalCarrier] at hy hb hc
  simp only [Matrix.of_apply, correction, IndexData.firstCarrier, IndexData.secondCarrier,
    hy, hb, hc, add_sub_cancel_right]

/-- The reconstructed matrix is symmetric in every characteristic. -/
theorem offDiagonalMatrix_symmetric (p : I.OffDiagonalCoordinates R) :
    ∀ i j, I.offDiagonalMatrix p i j = I.offDiagonalMatrix p j i := by
  intro i j
  obtain ⟨a, rfl⟩ := I.indexEquiv.surjective i
  obtain ⟨b, rfl⟩ := I.indexEquiv.surjective j
  rw [I.offDiagonalMatrix_index, I.offDiagonalMatrix_index]
  have hD : p.2.2.val.transpose = p.2.2.val := by
    ext i j
    exact p.2.2.property j i
  have h := model_transpose (p.1 : R) (I.extendOffDiagonalCarrier p.2.1 .diagonal)
    (↑p.1⁻¹) (fun i => I.extendOffDiagonalCarrier p.2.1 (.first i))
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.second i))
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.first i))
    (fun i => I.extendOffDiagonalCarrier p.2.1 (.second i)) p.2.2.val
  rw [hD] at h
  exact congrArg (fun A => A b a) h

theorem offDiagonalMatrix_before (p : I.OffDiagonalCoordinates R)
    (j : Fin (N + 1)) (hj : j < I.pivot) : I.offDiagonalMatrix p 0 j = 0 := by
  rcases I.exhaustive j with rfl | rfl | ⟨i, rfl⟩
  · exact (I.read_offDiagonalMatrix p .zero).trans (I.extendOffDiagonalCarrier_zero p.2.1)
  · exact False.elim (lt_irrefl _ hj)
  · change I.readOffDiagonalCarrier (I.offDiagonalMatrix p) (.first i) = 0
    rw [I.read_offDiagonalMatrix, extendOffDiagonalCarrier]
    exact dif_pos (show I.forcedCarrier (.first i) from hj)

def offDiagonalDecode (p : I.OffDiagonalCoordinates R) : I.OffDiagonalPatch R :=
  ⟨⟨I.offDiagonalMatrix p, I.offDiagonalMatrix_symmetric p⟩, by
    constructor
    · exact I.offDiagonalMatrix_before p
    · change IsUnit (I.offDiagonalMatrix p 0 I.pivot)
      rw [I.offDiagonalMatrix_pivot]
      exact p.1.isUnit⟩

def offDiagonalEncode (M : I.OffDiagonalPatch R) : I.OffDiagonalCoordinates R :=
  (I.offDiagonalPivotUnit M,
    (fun c => I.readOffDiagonalCarrier M.val.val c.val),
    ⟨I.residual M.val.val (↑(I.offDiagonalPivotUnit M)⁻¹),
      I.residual_symmetric M.val.val _ M.val.property⟩)

theorem offDiagonalDecode_encode (M : I.OffDiagonalPatch R) :
    I.offDiagonalDecode (I.offDiagonalEncode M) = M := by
  apply Subtype.ext
  apply Subtype.ext
  ext i j
  obtain ⟨a, rfl⟩ := I.indexEquiv.surjective i
  obtain ⟨b, rfl⟩ := I.indexEquiv.surjective j
  change I.offDiagonalMatrix (I.offDiagonalEncode M) (I.indexEquiv a) (I.indexEquiv b) = _
  rw [I.offDiagonalMatrix_index]
  simp only [Matrix.of_apply, offDiagonalEncode, I.offDiagonalPivotUnit_val]
  have hcarrier : I.extendOffDiagonalCarrier
      (fun c : I.FreeCarrier => I.readOffDiagonalCarrier M.val.val c.val) =
        I.readOffDiagonalCarrier M.val.val :=
    funext (I.extend_readOffDiagonalCarrier M)
  rw [hcarrier]
  have h := I.reindexed_eq_model M.val.val (↑(I.offDiagonalPivotUnit M)⁻¹)
    M.val.property (M.property.1 0 (Fin.pos_iff_ne_zero.mpr I.pivot_ne_zero))
  change model (M.val.val 0 I.pivot) (M.val.val I.pivot I.pivot)
    (↑(I.offDiagonalPivotUnit M)⁻¹)
    (I.firstCarrier M.val.val) (I.secondCarrier M.val.val)
    (I.firstCarrier M.val.val) (I.secondCarrier M.val.val)
    (I.residual M.val.val (↑(I.offDiagonalPivotUnit M)⁻¹)) a b =
      (M.val.val.submatrix I.indexEquiv I.indexEquiv) a b
  exact (congrArg
    (fun A : Matrix (Two ⊕ Fin n) (Two ⊕ Fin n) R => A a b) h).symm

theorem offDiagonalEncode_decode (p : I.OffDiagonalCoordinates R) :
    I.offDiagonalEncode (I.offDiagonalDecode p) = p := by
  have hu : I.offDiagonalPivotUnit (I.offDiagonalDecode p) = p.1 := by
    apply Units.ext
    rw [I.offDiagonalPivotUnit_val]
    exact I.offDiagonalMatrix_pivot p
  apply Prod.ext
  · exact hu
  · apply Prod.ext
    · funext c
      change I.readOffDiagonalCarrier (I.offDiagonalMatrix p) c.val = p.2.1 c
      rw [I.read_offDiagonalMatrix, I.extendOffDiagonalCarrier_free]
    · apply Subtype.ext
      change I.residual (I.offDiagonalMatrix p)
        (↑(I.offDiagonalPivotUnit (I.offDiagonalDecode p))⁻¹) = p.2.2.val
      rw [hu, I.offDiagonalMatrix_residual]

/-- The paired-pivot chart in Proposition 6.5, as a genuine equivalence of
ring-valued matrices and independent coordinates. -/
def offDiagonalPatchEquiv : I.OffDiagonalPatch R ≃ I.OffDiagonalCoordinates R where
  toFun := I.offDiagonalEncode
  invFun := I.offDiagonalDecode
  left_inv := I.offDiagonalDecode_encode
  right_inv := I.offDiagonalEncode_decode

/-- Both halves of exact rank transfer use actual determinantal ideals.
There is no field, reducedness, or nontriviality hypothesis. -/
theorem offDiagonal_exactMinorRank_prefix (M : I.OffDiagonalPatch R)
    (i j : Fin (N + 1)) (r : ℕ) :
    ExactMinorRank (I.originalPrefix M.val.val i j) (r + I.prefixContribution i j) ↔
      ExactMinorRank (I.residualPrefix (I.offDiagonalEncode M).2.2.val i j) r := by
  have hq : (↑(I.offDiagonalPivotUnit M)⁻¹ : R) * M.val.val 0 I.pivot = 1 := by
    rw [← I.offDiagonalPivotUnit_val]
    exact Units.inv_mul _
  have h₀ := I.prefix_minors M.val.val (↑(I.offDiagonalPivotUnit M)⁻¹)
    M.val.property M.property.1 hq i j r
  have h₁ := I.prefix_minors M.val.val (↑(I.offDiagonalPivotUnit M)⁻¹)
    M.val.property M.property.1 hq i j (r + 1)
  unfold ExactMinorRank
  rw [h₀, show r + I.prefixContribution i j + 1 = (r + 1) + I.prefixContribution i j by omega,
    h₁]
  rfl

/-- Separating a predicate on the last coordinate is just reassociation of
actual subtype data; it imposes no condition on the free coordinates. -/
def offDiagonalSubtypeLastEquiv {α β γ : Type*} (p : γ → Prop) :
    {x : α × β × γ // p x.2.2} ≃ α × β × {z : γ // p z} where
  toFun x := (x.val.1, x.val.2.1, ⟨x.val.2.2, x.property⟩)
  invFun x := ⟨(x.1, x.2.1, x.2.2.val), x.2.2.property⟩
  left_inv x := by apply Subtype.ext; rfl
  right_inv x := rfl

/-- Restricting the paired chart to every prescribed northwest rank equality
leaves the unit and all free carriers unrestricted.  The residual condition
still consists of the literal residual prefix matrices. -/
def offDiagonalRankChart (ρ : RankArray (N + 1)) :
    {M : I.OffDiagonalPatch R // ∀ i j,
      ExactMinorRank (prefixMatrix M.val.val i j) (ρ i j + I.prefixContribution i j)} ≃
    Rˣ × (I.FreeCarrier → R) ×
      {D : SymmetricMatrices n R // ∀ i j,
        ExactMinorRank (I.residualPrefix D.val i j) (ρ i j)} where
  toFun M :=
    ((I.offDiagonalEncode M.val).1, (I.offDiagonalEncode M.val).2.1,
      ⟨(I.offDiagonalEncode M.val).2.2, fun i j =>
        (I.offDiagonal_exactMinorRank_prefix M.val i j (ρ i j)).mp (M.property i j)⟩)
  invFun p :=
    ⟨I.offDiagonalDecode (p.1, p.2.1, p.2.2.val), by
      intro i j
      apply (I.offDiagonal_exactMinorRank_prefix
        (I.offDiagonalDecode (p.1, p.2.1, p.2.2.val)) i j (ρ i j)).mpr
      simpa only [I.offDiagonalEncode_decode] using p.2.2.property i j⟩
  left_inv M := by
    apply Subtype.ext
    exact I.offDiagonalDecode_encode M.val
  right_inv p := by
    have h := I.offDiagonalEncode_decode (p.1, p.2.1, p.2.2.val)
    apply Prod.ext
    · exact congrArg (fun q : I.OffDiagonalCoordinates R => q.1) h
    · apply Prod.ext
      · exact congrArg (fun q : I.OffDiagonalCoordinates R => q.2.1) h
      · apply Subtype.ext
        exact congrArg (fun q : I.OffDiagonalCoordinates R => q.2.2) h

end Ring

section Naturality
variable {R S : Type*} [CommRing R] [CommRing S]

/-- Entrywise coefficient change on the actual pivot locus. -/
def offDiagonalPatchMap (f : R →+* S) (M : I.OffDiagonalPatch R) : I.OffDiagonalPatch S :=
  ⟨⟨M.val.val.map f, fun i j => congrArg f (M.val.property i j)⟩,
    (fun j hj => by simpa only [Matrix.of_apply, Matrix.map_apply, M.property.1 j hj, map_zero]),
    M.property.2.map f⟩

def offDiagonalCoordinatesMap (f : R →+* S) (p : I.OffDiagonalCoordinates R) :
    I.OffDiagonalCoordinates S :=
  (Units.map f.toMonoidHom p.1, (fun c => f (p.2.1 c)),
    ⟨p.2.2.val.map f, fun i j => congrArg f (p.2.2.property i j)⟩)

@[simp] theorem map_extendOffDiagonalCarrier (f : R →+* S)
    (z : I.FreeCarrier → R) (c : IndexData.Carrier n) :
    f (I.extendOffDiagonalCarrier z c) =
      I.extendOffDiagonalCarrier (fun c => f (z c)) c := by
  by_cases hc : I.forcedCarrier c <;> simp [extendOffDiagonalCarrier, hc]

/-- The inverse chart is polynomial in the free entries and in the pivot
and its inverse, and therefore commutes with every ring homomorphism. -/
theorem offDiagonalDecode_natural (f : R →+* S) (p : I.OffDiagonalCoordinates R) :
    I.offDiagonalPatchMap f (I.offDiagonalDecode p) =
      I.offDiagonalDecode (I.offDiagonalCoordinatesMap f p) := by
  apply Subtype.ext
  apply Subtype.ext
  ext i j
  obtain ⟨a, rfl⟩ := I.indexEquiv.surjective i
  obtain ⟨b, rfl⟩ := I.indexEquiv.surjective j
  change f (I.offDiagonalMatrix p (I.indexEquiv a) (I.indexEquiv b)) =
    I.offDiagonalMatrix (I.offDiagonalCoordinatesMap f p) (I.indexEquiv a) (I.indexEquiv b)
  rw [I.offDiagonalMatrix_index, I.offDiagonalMatrix_index]
  rcases a with (a | a) | a <;> rcases b with (b | b) | b <;>
    simp only [Matrix.of_apply, model, block, Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
      Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂, Sum.elim_inl, Sum.elim_inr,
      Matrix.add_apply, correction, offDiagonalCoordinatesMap, Matrix.map_apply,
      Units.coe_map, Units.coe_map_inv, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe,
      map_zero, map_add, map_sub, map_mul, I.map_extendOffDiagonalCarrier]

theorem offDiagonalPatchEquiv_natural (f : R →+* S) (M : I.OffDiagonalPatch R) :
    I.offDiagonalPatchEquiv (I.offDiagonalPatchMap f M) =
      I.offDiagonalCoordinatesMap f (I.offDiagonalPatchEquiv M) := by
  apply (I.offDiagonalPatchEquiv (R := S)).symm.injective
  change I.offDiagonalDecode (I.offDiagonalEncode (I.offDiagonalPatchMap f M)) =
    I.offDiagonalDecode (I.offDiagonalCoordinatesMap f (I.offDiagonalEncode M))
  rw [I.offDiagonalDecode_encode, ← I.offDiagonalDecode_natural, I.offDiagonalDecode_encode]

end Naturality

/-- The surviving first-row coordinates are precisely the original indices
strictly after the pivot; the increasing residual enumeration is respected. -/
def lateRestEquiv : {i : Fin n // I.pivot < I.rest i} ≃
    {j : Fin (N + 1) // I.pivot < j} :=
  Equiv.ofBijective (fun i => ⟨I.rest i.val, i.property⟩) (by
    constructor
    · intro i j h
      exact Subtype.ext (I.rest.injective (congrArg Subtype.val h))
    · rintro ⟨j, hj⟩
      rcases I.exhaustive j with rfl | rfl | ⟨i, rfl⟩
      · exact False.elim (not_lt_of_ge (Fin.zero_le _) hj)
      · exact False.elim (lt_irrefl _ hj)
      · exact ⟨⟨i, hj⟩, rfl⟩)

/-- The free carriers are the second diagonal, all second-row carriers,
and the first-row carriers strictly after the pivot. -/
def freeCarrierCoordinatesEquiv :
    I.FreeCarrier ≃ PUnit.{1} ⊕ (Fin n ⊕ {i : Fin n // I.pivot < I.rest i}) where
  toFun := by
    rintro ⟨c, hc⟩
    cases c with
    | zero => exact False.elim (hc trivial)
    | diagonal => exact .inl PUnit.unit
    | first i =>
      exact .inr (.inr ⟨i, lt_of_le_of_ne (not_lt.mp hc) (I.rest_ne_pivot i).symm⟩)
    | second i => exact .inr (.inl i)
  invFun := Sum.elim (fun _ => ⟨.diagonal, by simp [IndexData.forcedCarrier]⟩)
    (Sum.elim (fun i => ⟨.second i, by simp [IndexData.forcedCarrier]⟩)
      (fun i => ⟨.first i.val, not_lt_of_ge i.property.le⟩))
  left_inv := by
    rintro ⟨c, hc⟩
    cases c with
    | zero => exact False.elim (hc trivial)
    | diagonal => rfl
    | first i => rfl
    | second i => rfl
  right_inv := by
    rintro (c | c | c)
    · cases c; rfl
    · rfl
    · apply congrArg (fun a => Sum.inr (Sum.inr a))
      apply Subtype.ext
      rfl

/-- In the paper's one-based notation, this is `2m-k-1`, with matrix
size `m=N+1` and pivot column `k=I.pivot.val+1`. -/
theorem card_freeCarrier : Fintype.card I.FreeCarrier = 2 * (N + 1) - (I.pivot.val + 1) - 1 := by
  classical
  have hsize : 2 + n = N + 1 := by
    simpa only [Matrix.of_apply, Fintype.card_sum, Fintype.card_punit, Fintype.card_fin] using
      Fintype.card_congr I.indexEquiv
  have htail : Fintype.card {i : Fin n // I.pivot < I.rest i} = N - I.pivot.val := by
    rw [Fintype.card_congr I.lateRestEquiv]
    have h := Fintype.card_of_subtype (Finset.Ioi I.pivot)
      (by intro j; exact Finset.mem_Ioi)
    simpa only [Matrix.of_apply, Fin.card_Ioi, Nat.add_sub_cancel] using h
  have h := Fintype.card_congr I.freeCarrierCoordinatesEquiv
  simp only [Matrix.of_apply, Fintype.card_sum, Fintype.card_punit, Fintype.card_fin, htail] at h
  have hk := I.pivot.isLt
  omega

/-- The greatest residual label in a nonempty inherited prefix. -/
def offDiagonalLast (i : Fin (N + 1)) (hi : ∃ a, I.rest a ≤ i) : Fin n :=
  Classical.choose (Pivot.embeddingPrefix_has_last I.rest i hi)

theorem offDiagonalLast_spec (i : Fin (N + 1)) (hi : ∃ a, I.rest a ≤ i) (a : Fin n) :
    I.rest a ≤ i ↔ a ≤ I.offDiagonalLast i hi :=
  Classical.choose_spec (Pivot.embeddingPrefix_has_last I.rest i hi) a

@[simp] theorem offDiagonalLast_rest (a : Fin n) (hi : ∃ b, I.rest b ≤ I.rest a) :
    I.offDiagonalLast (I.rest a) hi = a := by
  apply le_antisymm
  · apply I.rest.le_iff_le.mp
    exact (I.offDiagonalLast_spec (I.rest a) hi _).mpr le_rfl
  · exact (I.offDiagonalLast_spec (I.rest a) hi a).mp le_rfl

/-- Extend a residual rank array to inherited original prefixes, assigning
rank zero to an empty row or column prefix. -/
def offDiagonalResidualProfile (r : RankArray n) : RankArray (N + 1) := by
  classical
  exact fun i j => if hi : ∃ a, I.rest a ≤ i then
    if hj : ∃ b, I.rest b ≤ j then r (I.offDiagonalLast i hi) (I.offDiagonalLast j hj)
    else 0 else 0

@[simp] theorem offDiagonalResidualProfile_rest (r : RankArray n) (a b : Fin n) :
    I.offDiagonalResidualProfile r (I.rest a) (I.rest b) = r a b := by
  classical
  simp only [Matrix.of_apply, offDiagonalResidualProfile, dif_pos (show ∃ c,
    I.rest c ≤ I.rest a from ⟨a, le_rfl⟩),
    dif_pos (show ∃ c, I.rest c ≤ I.rest b from ⟨b, le_rfl⟩), I.offDiagonalLast_rest]

/-- The original rank profile obtained by adjoining the paired rook. -/
def offDiagonalLiftProfile (r : RankArray n) : RankArray (N + 1) :=
  fun i j => I.offDiagonalResidualProfile r i j + I.prefixContribution i j

theorem offDiagonalResidualProfile_first (r : RankArray n) (j : Fin (N + 1)) :
    I.offDiagonalResidualProfile r 0 j = 0 := by
  have h : ¬ ∃ a, I.rest a ≤ (0 : Fin (N + 1)) := by
    rintro ⟨a, ha⟩
    exact I.rest_ne_zero a (le_antisymm ha (Fin.zero_le _))
  simp only [Matrix.of_apply, offDiagonalResidualProfile, dif_neg h]

theorem offDiagonalLiftProfile_first_before (r : RankArray n)
    (j : Fin (N + 1)) (hj : j < I.pivot) : I.offDiagonalLiftProfile r 0 j = 0 := by
  have hk : ¬ I.pivot ≤ 0 := not_le_of_gt (Fin.pos_iff_ne_zero.mpr I.pivot_ne_zero)
  simp only [Matrix.of_apply, offDiagonalLiftProfile, I.offDiagonalResidualProfile_first,
    IndexData.prefixContribution, if_neg hk, if_neg (not_le_of_gt hj), zero_add]

theorem offDiagonalLiftProfile_first_pivot (r : RankArray n) :
    I.offDiagonalLiftProfile r 0 I.pivot = 1 := by
  have hk : ¬ I.pivot ≤ 0 := not_le_of_gt (Fin.pos_iff_ne_zero.mpr I.pivot_ne_zero)
  simp only [Matrix.of_apply, offDiagonalLiftProfile, I.offDiagonalResidualProfile_first,
    IndexData.prefixContribution, if_neg hk, if_pos le_rfl, zero_add]

section ProfileRanks
variable {R : Type*} [CommRing R]

/-- Every original inherited prefix imposes exactly the corresponding
ordinary residual prefix condition. Empty prefixes impose rank zero. -/
theorem offDiagonal_residual_ranks_iff (r : RankArray n)
    (D : Matrix (Fin n) (Fin n) R) :
    (∀ i j, ExactMinorRank (I.residualPrefix D i j) (I.offDiagonalResidualProfile r i j)) ↔
      ∀ a b, ExactMinorRank (prefixMatrix D a b) (r a b) := by
  classical
  constructor
  · intro h a b
    have hh := h (I.rest a) (I.rest b)
    rw [I.offDiagonalResidualProfile_rest] at hh
    let ea := Pivot.embeddingPrefixEquiv I.rest (I.rest a) a (fun _ => I.rest.le_iff_le)
    let eb := Pivot.embeddingPrefixEquiv I.rest (I.rest b) b (fun _ => I.rest.le_iff_le)
    change ExactMinorRank ((prefixMatrix D a b).submatrix ea eb) (r a b) at hh
    exact (exactMinorRank_submatrix_equiv (prefixMatrix D a b) (r a b) ea eb).mp hh
  · intro h i j
    by_cases hi : ∃ a, I.rest a ≤ i
    · by_cases hj : ∃ b, I.rest b ≤ j
      · let a := I.offDiagonalLast i hi
        let b := I.offDiagonalLast j hj
        let ea := Pivot.embeddingPrefixEquiv I.rest i a (I.offDiagonalLast_spec i hi)
        let eb := Pivot.embeddingPrefixEquiv I.rest j b (I.offDiagonalLast_spec j hj)
        simp only [Matrix.of_apply, offDiagonalResidualProfile, dif_pos hi, dif_pos hj]
        change ExactMinorRank ((prefixMatrix D a b).submatrix ea eb) (r a b)
        exact (exactMinorRank_submatrix_equiv (prefixMatrix D a b) (r a b) ea eb).mpr (h a b)
      · simp only [Matrix.of_apply, offDiagonalResidualProfile, dif_pos hi, dif_neg hj]
        rw [exactMinorRank_zero]
        ext a b
        exact False.elim (hj ⟨b.val, b.property⟩)
    · simp only [Matrix.of_apply, offDiagonalResidualProfile, dif_neg hi]
      rw [exactMinorRank_zero]
      ext a b
      exact False.elim (hi ⟨a.val, a.property⟩)

def offDiagonalResidualStratumEquiv (r : RankArray n) :
    {D : SymmetricMatrices n R // ∀ i j,
      ExactMinorRank (I.residualPrefix D.val i j) (I.offDiagonalResidualProfile r i j)} ≃
    StratumPoints r R :=
  Equiv.subtypeEquivRight (fun D => I.offDiagonal_residual_ranks_iff r D.val)

theorem offDiagonal_stratum_before (r : RankArray n)
    (M : StratumPoints (I.offDiagonalLiftProfile r) R)
    (j : Fin (N + 1)) (hj : j < I.pivot) : M.val.val 0 j = 0 := by
  have h := M.property 0 j
  rw [I.offDiagonalLiftProfile_first_before r j hj, exactMinorRank_zero] at h
  exact congrArg (fun A => A ⟨0, le_rfl⟩ ⟨j, le_rfl⟩) h

/-- With the preceding row entries zero, the first nonzero prefix has
one-minor ideal generated by the pivot itself, over any coefficient ring. -/
theorem offDiagonal_first_prefix_minorIdeal (M : Matrix (Fin (N + 1)) (Fin (N + 1)) R)
    (hbefore : ∀ j, j < I.pivot → M 0 j = 0) :
    matrixMinorIdeal (prefixMatrix M 0 I.pivot) 1 = Ideal.span ({M 0 I.pivot} : Set R) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro z ⟨a, b, rfl⟩
    rw [Matrix.det_fin_one]
    have ha : (a 0).val = 0 := le_antisymm (a 0).property (Fin.zero_le _)
    change M (a 0).val (b 0).val ∈ _
    rw [ha]
    rcases lt_or_eq_of_le (b 0).property with hb | hb
    · rw [hbefore _ hb]
      exact Ideal.zero_mem _
    · rw [hb]
      exact Ideal.subset_span (Set.mem_singleton _)
  · apply Ideal.span_le.mpr
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    change M 0 I.pivot ∈ matrixMinorIdeal (prefixMatrix M 0 I.pivot) 1
    simpa only [Matrix.of_apply, Matrix.det_fin_one, Matrix.submatrix_apply, prefixMatrix] using
      det_submatrix_mem_matrixMinorIdeal (prefixMatrix M 0 I.pivot) 1
        (fun _ => ⟨0, le_rfl⟩) (fun _ => ⟨I.pivot, le_rfl⟩)

theorem offDiagonal_stratum_pivot_isUnit (r : RankArray n)
    (M : StratumPoints (I.offDiagonalLiftProfile r) R) : IsUnit (M.val.val 0 I.pivot) := by
  have h := (M.property 0 I.pivot).1
  rw [I.offDiagonalLiftProfile_first_pivot] at h
  rw [I.offDiagonal_first_prefix_minorIdeal M.val.val (I.offDiagonal_stratum_before r M)] at h
  exact Ideal.span_singleton_eq_top.mp h

/-- The zero and unit conditions used by the chart follow from the actual
rank-stratum equations; they are not additional hypotheses on the stratum. -/
def offDiagonalStratumPatchEquiv (r : RankArray n) :
    StratumPoints (I.offDiagonalLiftProfile r) R ≃
    {M : I.OffDiagonalPatch R // ∀ i j,
      ExactMinorRank (prefixMatrix M.val.val i j)
        (I.offDiagonalResidualProfile r i j + I.prefixContribution i j)} where
  toFun M := ⟨⟨M.val, I.offDiagonal_stratum_before r M, I.offDiagonal_stratum_pivot_isUnit r M⟩,
    M.property⟩
  invFun M := ⟨M.val.val, M.property⟩
  left_inv M := rfl
  right_inv M := by apply Subtype.ext; apply Subtype.ext; rfl

/-- The full arbitrary-ring paired-pivot stratum chart. The source and
residual target both use the independently defined literal rank-stratum
functor, and every carrier and the unit pivot remain free. -/
def offDiagonalStratumChart (r : RankArray n) :
    StratumPoints (I.offDiagonalLiftProfile r) R ≃
      Rˣ × (I.FreeCarrier → R) × StratumPoints r R :=
  (I.offDiagonalStratumPatchEquiv r).trans
    ((I.offDiagonalRankChart (I.offDiagonalResidualProfile r)).trans
      (Equiv.prodCongr (Equiv.refl Rˣ)
        (Equiv.prodCongr (Equiv.refl (I.FreeCarrier → R)) (I.offDiagonalResidualStratumEquiv r))))

end ProfileRanks

section FieldProfiles
variable {F : Type*} [Field F]

/-- The inherited-prefix rank is a function of the actual smaller northwest
rank array, including the cases of an empty row or column prefix. -/
theorem offDiagonal_residual_rank (D : Matrix (Fin n) (Fin n) F)
    (i j : Fin (N + 1)) :
    (I.residualPrefix D i j).rank = I.offDiagonalResidualProfile (matrixRankArray D) i j := by
  have h : ∀ a b, ExactMinorRank (prefixMatrix D a b) (matrixRankArray D a b) := by
    intro a b
    exact (exactMinorRank_iff_rank (prefixMatrix D a b) _).mpr rfl
  exact (exactMinorRank_iff_rank (I.residualPrefix D i j) _).mp
    ((I.offDiagonal_residual_ranks_iff (matrixRankArray D) D).mpr h i j)

theorem residualPrefix_rank_eq_of_matrixRankArray_eq
    (D E : Matrix (Fin n) (Fin n) F) (h : matrixRankArray D = matrixRankArray E)
    (i j : Fin (N + 1)) :
    (I.residualPrefix D i j).rank = (I.residualPrefix E i j).rank := by
  rw [I.offDiagonal_residual_rank D i j, I.offDiagonal_residual_rank E i j, h]

/-- The combinatorial lifted profile is exactly the rank array of every
matrix in the actual chart, independently of its free carrier values. -/
theorem offDiagonalMatrix_rankArray (p : I.OffDiagonalCoordinates F) :
    matrixRankArray (I.offDiagonalMatrix p) =
      I.offDiagonalLiftProfile (matrixRankArray p.2.2.val) := by
  funext i j
  have hD : ExactMinorRank (I.residualPrefix p.2.2.val i j)
      (I.offDiagonalResidualProfile (matrixRankArray p.2.2.val) i j) :=
    (exactMinorRank_iff_rank _ _).mpr (I.offDiagonal_residual_rank p.2.2.val i j)
  have hM := (I.offDiagonal_exactMinorRank_prefix (I.offDiagonalDecode p) i j
    (I.offDiagonalResidualProfile (matrixRankArray p.2.2.val) i j)).mpr
      (by simpa only [Matrix.of_apply, I.offDiagonalEncode_decode] using hD)
  exact (exactMinorRank_iff_rank _ _).mp hM

end FieldProfiles

section StratumNaturality
variable {R S : Type*} [CommRing R] [CommRing S]

def offDiagonalStratumCoordinatesMap (r : RankArray n) (f : R →+* S)
    (p : Rˣ × (I.FreeCarrier → R) × StratumPoints r R) :
    Sˣ × (I.FreeCarrier → S) × StratumPoints r S :=
  (Units.map f.toMonoidHom p.1, (fun c => f (p.2.1 c)), StratumPoints.map r f p.2.2)

/-- The full stratum equivalence, including all rank equalities, commutes
with every change of commutative coefficient ring. -/
theorem offDiagonalStratumChart_natural (r : RankArray n) (f : R →+* S)
    (M : StratumPoints (I.offDiagonalLiftProfile r) R) :
    I.offDiagonalStratumChart r (StratumPoints.map (I.offDiagonalLiftProfile r) f M) =
      I.offDiagonalStratumCoordinatesMap r f (I.offDiagonalStratumChart r M) := by
  have h := I.offDiagonalPatchEquiv_natural f (I.offDiagonalStratumPatchEquiv r M).val
  apply Prod.ext
  · exact congrArg (fun p : I.OffDiagonalCoordinates S => p.1) h
  · apply Prod.ext
    · exact congrArg (fun p : I.OffDiagonalCoordinates S => p.2.1) h
    · apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun p : I.OffDiagonalCoordinates S => p.2.2.val) h

end StratumNaturality

