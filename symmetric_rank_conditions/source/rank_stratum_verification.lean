set_option maxHeartbeats 1200000

/-!
# Detecting scheme isomorphisms on affine test schemes

An all-ring natural parametrization must be connected to the actual scheme,
rather than used as a replacement definition of it. The lemmas below supply
that connection. Injectivity on affine test schemes gives a monomorphism;
surjectivity then constructs its inverse by gluing over an affine open cover.

-/

noncomputable section

namespace FourPapers.Symmetric.SchemeAffineTest

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

/-- Affine open covers detect the cancellation property for scheme maps. -/
theorem mono_of_affine_test_injective {X Y : Scheme.{u}} (f : X ⟶ Y)
    (h : ∀ R : CommRingCat.{u},
      Function.Injective (fun g : Spec R ⟶ X => g ≫ f)) : Mono f where
  right_cancellation := by
    intro Z g₁ g₂ heq
    apply Z.affineOpenCover.openCover.hom_ext g₁ g₂
    intro i
    change Z.affineOpenCover.I₀ at i
    change Z.affineOpenCover.f i ≫ g₁ = Z.affineOpenCover.f i ≫ g₂
    apply h (Z.affineOpenCover.X i)
    simpa only [Category.assoc] using
      congrArg (fun g => Z.affineOpenCover.f i ≫ g) heq

/-- A scheme morphism inducing bijections on all affine test schemes is
an actual scheme isomorphism. The inverse is explicitly glued locally. -/
theorem isIso_of_affine_test_bijective {X Y : Scheme.{u}} (f : X ⟶ Y)
    (h : ∀ R : CommRingCat.{u},
      Function.Bijective (fun g : Spec R ⟶ X => g ≫ f)) : IsIso f := by
  classical
  letI : Mono f := mono_of_affine_test_injective f (fun R => (h R).1)
  let 𝒰 := Y.affineOpenCover
  choose g hg using fun i : 𝒰.I₀ => (h (𝒰.X i)).2 (𝒰.f i)
  have hcompat : ∀ i j,
      pullback.fst (𝒰.f i) (𝒰.f j) ≫ g i =
        pullback.snd (𝒰.f i) (𝒰.f j) ≫ g j := by
    intro i j
    apply (cancel_mono f).mp
    simp only [Category.assoc, hg]
    exact pullback.condition
  let g₀ : Y ⟶ X := 𝒰.openCover.glueMorphisms g hcompat
  have hlocal (i : 𝒰.I₀) : 𝒰.f i ≫ g₀ = g i :=
    𝒰.openCover.ι_glueMorphisms g hcompat i
  have hgf : g₀ ≫ f = 𝟙 Y := by
    apply 𝒰.openCover.hom_ext
    intro i
    change 𝒰.I₀ at i
    change 𝒰.f i ≫ (g₀ ≫ f) = 𝒰.f i ≫ 𝟙 Y
    rw [← Category.assoc, hlocal]
    simpa only [Category.comp_id] using hg i
  have hfg : f ≫ g₀ = 𝟙 X := by
    apply (cancel_mono f).mp
    simp only [Category.assoc, hgf, Category.comp_id, Category.id_comp]
  exact ⟨⟨g₀, hfg, hgf⟩⟩

/-- Naturality identifies the image of the universal affine point with
postcomposition by one fixed scheme morphism. -/
theorem affine_points_eq_postcomp {A : CommRingCat.{u}} {X : Scheme.{u}}
    (e : ∀ R : CommRingCat.{u}, (Spec R ⟶ Spec A) ≃ (Spec R ⟶ X))
    (hnat : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (g : Spec R ⟶ Spec A),
      e S (Spec.map φ ≫ g) = Spec.map φ ≫ e R g)
    (R : CommRingCat.{u}) (g : Spec R ⟶ Spec A) :
    e R g = g ≫ e A (𝟙 (Spec A)) := by
  simpa only [Spec.map_preimage, Category.comp_id] using
    hnat A R (Spec.preimage g) (𝟙 (Spec A))

/-- An exact natural equivalence on every coefficient ring yields an
isomorphism to the independently defined target scheme. -/
def iso_of_natural_affine_points {A : CommRingCat.{u}} {X : Scheme.{u}}
    (e : ∀ R : CommRingCat.{u}, (Spec R ⟶ Spec A) ≃ (Spec R ⟶ X))
    (hnat : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (g : Spec R ⟶ Spec A),
      e S (Spec.map φ ≫ g) = Spec.map φ ≫ e R g) : Spec A ≅ X := by
  let f : Spec A ⟶ X := e A (𝟙 (Spec A))
  have htest (R : CommRingCat.{u}) :
      Function.Bijective (fun g : Spec R ⟶ Spec A => g ≫ f) := by
    have heq : (fun g : Spec R ⟶ Spec A => g ≫ f) = e R := by
      funext g
      exact (affine_points_eq_postcomp e hnat R g).symm
    rw [heq]
    exact (e R).bijective
  letI : IsIso f := isIso_of_affine_test_bijective f htest
  exact asIso f

@[simp] theorem iso_of_natural_affine_points_hom
    {A : CommRingCat.{u}} {X : Scheme.{u}}
    (e : ∀ R : CommRingCat.{u}, (Spec R ⟶ Spec A) ≃ (Spec R ⟶ X))
    (hnat : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (g : Spec R ⟶ Spec A),
      e S (Spec.map φ ≫ g) = Spec.map φ ≫ e R g) :
    (iso_of_natural_affine_points e hnat).hom = e A (𝟙 (Spec A)) := rfl

end FourPapers.Symmetric.SchemeAffineTest
end
end
