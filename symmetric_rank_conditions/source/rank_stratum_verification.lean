section

set_option autoImplicit false
set_option maxHeartbeats 1400000

/-! The zero-first-row branch for literal symmetric rank strata.
All maps are defined over arbitrary coefficient rings. -/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Matrix Pivot

variable {n : ℕ} {R S : Type*} [CommRing R] [CommRing S]

abbrev ZeroFirstRow (n : ℕ) (R : Type*) [CommRing R] :=
  {M : SymmetricMatrices (n + 1) R // ∀ j, M.val 0 j = 0}

def zeroRowModel (D : SymmetricMatrices n R) : SymmetricMatrices (n + 1) R :=
  ⟨Matrix.of (Fin.cases (fun _ => 0) (fun i => Fin.cases 0 (D.val i))), by
    intro i j
    cases i using Fin.cases <;> cases j using Fin.cases
    · rfl
    · rfl
    · rfl
    · exact D.property _ _⟩

def zeroRowDelete (M : ZeroFirstRow n R) : SymmetricMatrices n R :=
  ⟨M.val.val.submatrix Fin.succ Fin.succ, fun i j => M.val.property i.succ j.succ⟩

def zeroRowPad (D : SymmetricMatrices n R) : ZeroFirstRow n R :=
  ⟨zeroRowModel D, fun _ => rfl⟩

theorem zeroRowPad_delete (M : ZeroFirstRow n R) :
    zeroRowPad (zeroRowDelete M) = M := by
  apply Subtype.ext
  apply Subtype.ext
  ext i j
  cases i using Fin.cases with
  | zero => exact (M.property j).symm
  | succ i =>
    cases j using Fin.cases with
    | zero => exact ((M.val.property i.succ 0).trans (M.property i.succ)).symm
    | succ j => rfl

theorem zeroRowDelete_pad (D : SymmetricMatrices n R) :
    zeroRowDelete (zeroRowPad D) = D := rfl

def zeroRowChart : ZeroFirstRow n R ≃ SymmetricMatrices n R where
  toFun := zeroRowDelete
  invFun := zeroRowPad
  left_inv := zeroRowPad_delete
  right_inv := zeroRowDelete_pad

def zeroRowMap (φ : R →+* S) (M : ZeroFirstRow n R) : ZeroFirstRow n S :=
  ⟨M.val.map φ, fun j => by change φ (M.val.val 0 j) = 0; rw [M.property j, map_zero]⟩

theorem zeroRowChart_natural (φ : R →+* S) (M : ZeroFirstRow n R) :
    zeroRowChart (zeroRowMap φ M) = (zeroRowChart M).map φ := rfl

theorem zeroRowModel_prefix_minors (D : SymmetricMatrices n R)
    (i j : Fin n) (t : ℕ) :
    matrixMinorIdeal (prefixMatrix (zeroRowModel D).val i.succ j.succ) t =
      matrixMinorIdeal (prefixMatrix D.val i j) t := by
  rw [prefixMatrix_minorIdeal_eq_fin, prefixMatrix_minorIdeal_eq_fin]
  have hm :
      ((zeroRowModel D).val.submatrix (prefixEmbedding i.succ)
        (prefixEmbedding j.succ)).submatrix
        (frontIndexEquiv (i.val + 1)) (frontIndexEquiv (j.val + 1)) =
      Matrix.fromBlocks (0 : Matrix PUnit.{1} PUnit.{1} R) 0 0
        (D.val.submatrix (prefixEmbedding i) (prefixEmbedding j)) := by
    ext a b
    rcases a with a | a <;> rcases b with b | b <;> rfl
  rw [← matrixMinorIdeal_submatrix_equiv _ (frontIndexEquiv (i.val + 1))
    (frontIndexEquiv (j.val + 1)), hm, matrixMinorIdeal_zero_border]

theorem zeroRowModel_prefix_exactRank (D : SymmetricMatrices n R)
    (i j : Fin n) (r : ℕ) :
    ExactMinorRank (prefixMatrix (zeroRowModel D).val i.succ j.succ) r ↔
      ExactMinorRank (prefixMatrix D.val i j) r := by
  simp only [ExactMinorRank, zeroRowModel_prefix_minors]

theorem zeroRowModel_first_row (D : SymmetricMatrices n R) (j : Fin (n + 1)) :
    prefixMatrix (zeroRowModel D).val 0 j = 0 := by
  ext a b
  have ha : a.val = 0 := le_antisymm a.property (Fin.zero_le _)
  simp [prefixMatrix, Matrix.submatrix_apply, ha, zeroRowModel, Matrix.of_apply]

theorem zeroRowModel_first_col (D : SymmetricMatrices n R) (i : Fin (n + 1)) :
    prefixMatrix (zeroRowModel D).val i 0 = 0 := by
  ext a b
  have hb : b.val = 0 := le_antisymm b.property (Fin.zero_le _)
  change (zeroRowModel D).val a.val b.val = 0
  rw [(zeroRowModel D).property, hb]
  rfl

def zeroLiftProfile (r : RankArray n) : RankArray (n + 1) :=
  Fin.cases (fun _ => 0) (fun i => Fin.cases 0 (r i))

theorem zeroRowModel_stratum_iff (r : RankArray n) (D : SymmetricMatrices n R) :
    (∀ i j, ExactMinorRank (prefixMatrix (zeroRowModel D).val i j)
      (zeroLiftProfile r i j)) ↔
      ∀ i j, ExactMinorRank (prefixMatrix D.val i j) (r i j) := by
  constructor
  · intro h i j
    exact (zeroRowModel_prefix_exactRank D i j (r i j)).mp (h i.succ j.succ)
  · intro h i j
    cases i using Fin.cases with
    | zero => exact (exactMinorRank_zero _).mpr (zeroRowModel_first_row D j)
    | succ i =>
      cases j using Fin.cases with
      | zero => exact (exactMinorRank_zero _).mpr (zeroRowModel_first_col D i.succ)
      | succ j => exact (zeroRowModel_prefix_exactRank D i j (r i j)).mpr (h i j)

theorem first_row_zero_of_stratum (r : RankArray n)
    (M : StratumPoints (zeroLiftProfile r) R) (j : Fin (n + 1)) :
    M.val.val 0 j = 0 := by
  have hh := (exactMinorRank_zero _).mp (M.property 0 j)
  exact congrFun (congrFun hh ⟨0, le_rfl⟩) ⟨j, le_rfl⟩

/-- Removing the zero first row and column gives an isomorphism of the
actual rank-stratum functors, with no added affine or unit parameter. -/
def zeroStratumChart (r : RankArray n) :
    StratumPoints (zeroLiftProfile r) R ≃ StratumPoints r R where
  toFun M := by
    let U : ZeroFirstRow n R := ⟨M.val, first_row_zero_of_stratum r M⟩
    let D := zeroRowDelete U
    have hM : zeroRowModel D = M.val := congrArg Subtype.val (zeroRowPad_delete U)
    exact ⟨D, (zeroRowModel_stratum_iff r D).mp (by rw [hM]; exact M.property)⟩
  invFun D := ⟨zeroRowModel D.val, (zeroRowModel_stratum_iff r D.val).mpr D.property⟩
  left_inv M := by
    apply Subtype.ext
    exact congrArg (fun U : ZeroFirstRow n R => U.val) (zeroRowPad_delete
      ⟨M.val, first_row_zero_of_stratum r M⟩)
  right_inv _ := rfl

theorem zeroStratumChart_natural (r : RankArray n) (φ : R →+* S)
    (M : StratumPoints (zeroLiftProfile r) R) :
    zeroStratumChart r (StratumPoints.map (zeroLiftProfile r) φ M) =
