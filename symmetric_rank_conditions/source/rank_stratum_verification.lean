section

set_option autoImplicit false
set_option maxHeartbeats 1800000

/-!
# Product charts for every symmetric partial-permutation stratum

The exponents are independent of the chosen pivot recipe, satisfy exactly
the paper's three recurrences, and parametrize the actual rank stratum over
every commutative ring. The natural representing-ring statement gives the
integral affine-times-torus product, not just its field-valued points.

The corresponding scheme isomorphism is constructed in `StratumSchemeIso`.
`RankStratumGeometry` establishes openness, density, dimension, rationality,
and smoothness.
-/

noncomputable section
namespace FourPapers.Symmetric.Strata

open Pivot.OffDiagonal

def changeProfile {n : ℕ} {r s : RankArray n} (h : r = s)
    (R : Type*) [CommRing R] : StratumPoints r R ≃ StratumPoints s R where
  toFun M := ⟨M.val, by simpa only [h] using M.property⟩
  invFun M := ⟨M.val, by simpa only [h] using M.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem changeProfile_natural {n : ℕ} {r s : RankArray n} (h : r = s)
    {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (M : StratumPoints r R) :
    changeProfile h S (StratumPoints.map r φ M) =
      StratumPoints.map s φ (changeProfile h R M) := rfl

namespace SymmetricRook

variable {n : ℕ}

def recipe (w : SymmetricRook n) : StratumRecipe n :=
  Classical.choose (exists_recipe_of_symmetric_rook w.val w.property)

theorem recipe_profile (w : SymmetricRook n) : w.recipe.profile = w.val.rankProfile :=
  Classical.choose_spec (exists_recipe_of_symmetric_rook w.val w.property)


/-- The chosen recursive description reconstructs the same Boolean rook
positions, a consequence of the independently proved rank-profile uniqueness. -/
theorem recipe_rook_eq (w : SymmetricRook n) : w.recipe.rook = w.val :=
  RookPattern.rankProfile_injective (w.recipe.rook_rankProfile.trans w.recipe_profile)

def a (w : SymmetricRook n) : ℕ := w.recipe.a
def b (w : SymmetricRook n) : ℕ := w.recipe.b

theorem exponents_eq_recipe (w : SymmetricRook n) (r : StratumRecipe n)
    (h : r.profile = w.val.rankProfile) : w.a = r.a ∧ w.b = r.b :=
  StratumRecipe.exponents_eq_of_profile_eq w.recipe r (w.recipe_profile.trans h.symm)

def zeroExtend (w : SymmetricRook n) : SymmetricRook (n + 1) :=
  ⟨w.val.zeroExtend, w.val.zeroExtend_symmetric w.property⟩

def diagonalExtend (w : SymmetricRook n) : SymmetricRook (n + 1) :=
  ⟨w.val.diagonalExtend, w.val.diagonalExtend_symmetric w.property⟩

def pairedExtend {N : ℕ} (I : IndexData N n) (w : SymmetricRook n) : SymmetricRook (N + 1) :=
  ⟨w.val.pairedExtend I, w.val.pairedExtend_symmetric I w.property⟩

theorem exponents_empty (w : SymmetricRook 0) : w.a = 0 ∧ w.b = 0 := by
  have h : StratumRecipe.empty.profile = w.val.rankProfile := by
    funext i
    exact Fin.elim0 i
  simpa using w.exponents_eq_recipe .empty h

theorem exponents_zeroExtend (w : SymmetricRook n) :
    w.zeroExtend.a = w.a ∧ w.zeroExtend.b = w.b := by
  have h : (StratumRecipe.zero w.recipe).profile = w.zeroExtend.val.rankProfile := by
    change zeroLiftProfile w.recipe.profile = w.val.zeroExtend.rankProfile
    rw [w.recipe_profile, w.val.rankProfile_zeroExtend w.property]
  simpa [a, b] using w.zeroExtend.exponents_eq_recipe (.zero w.recipe) h

theorem exponents_diagonalExtend (w : SymmetricRook n) :
    w.diagonalExtend.a = n + w.a ∧ w.diagonalExtend.b = w.b + 1 := by
  have h : (StratumRecipe.diagonal w.recipe).profile = w.diagonalExtend.val.rankProfile := by
    change diagonalLiftProfile w.recipe.profile = w.val.diagonalExtend.rankProfile
    rw [w.recipe_profile, w.val.rankProfile_diagonalExtend w.property]
  simpa [a, b] using w.diagonalExtend.exponents_eq_recipe (.diagonal w.recipe) h

theorem exponents_pairedExtend {N : ℕ} (I : IndexData N n) (w : SymmetricRook n) :
    (w.pairedExtend I).a = (2 * (N + 1) - (I.pivot.val + 1) - 1) + w.a ∧
      (w.pairedExtend I).b = w.b + 1 := by
  have h : (StratumRecipe.paired I w.recipe).profile = (w.pairedExtend I).val.rankProfile := by
    change I.offDiagonalLiftProfile w.recipe.profile = (w.val.pairedExtend I).rankProfile
    rw [w.recipe_profile, w.val.rankProfile_pairedExtend I w.property]
  simpa [a, b] using (w.pairedExtend I).exponents_eq_recipe (.paired I w.recipe) h

/-- The integral product parametrization for every actual symmetric
partial permutation, with no restriction on the coefficient ring. -/
def stratumChart (w : SymmetricRook n) (R : Type*) [CommRing R] :
    StratumPoints w.val.rankProfile R ≃ (Fin w.a → R) × (Fin w.b → Rˣ) :=
  (changeProfile w.recipe_profile.symm R).trans (w.recipe.finChart R)

theorem stratumChart_natural (w : SymmetricRook n)
    {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S)
    (M : StratumPoints w.val.rankProfile R) :
    w.stratumChart S (StratumPoints.map w.val.rankProfile φ M) =
      AffineTorus.mapPoints w.a w.b φ (w.stratumChart R M) := by
  change w.recipe.finChart S
    (changeProfile w.recipe_profile.symm S (StratumPoints.map w.val.rankProfile φ M)) = _
  rw [changeProfile_natural, StratumRecipe.finChart_natural]
  rfl

/-- The explicit integral coordinate ring of the stratum product. -/
abbrev coordinateRing (w : SymmetricRook n) := AffineTorus.CoordinateRing ℤ w.a w.b

def representingEquiv (w : SymmetricRook n) (R : Type*) [CommRing R] :
    (w.coordinateRing →+* R) ≃ StratumPoints w.val.rankProfile R :=
  (AffineTorus.ringHomEquiv R w.a w.b).trans (w.stratumChart R).symm

theorem representingEquiv_natural (w : SymmetricRook n)
    {R S : Type*} [CommRing R] [CommRing S] (φ : R →+* S) (f : w.coordinateRing →+* R) :
    w.representingEquiv S (φ.comp f) =
      StratumPoints.map w.val.rankProfile φ (w.representingEquiv R f) := by
  apply (w.stratumChart S).injective
  change w.stratumChart S ((w.stratumChart S).symm
    (AffineTorus.ringHomEquiv S w.a w.b (φ.comp f))) = _
  rw [Equiv.apply_symm_apply, stratumChart_natural]
  change AffineTorus.ringHomEquiv S w.a w.b (φ.comp f) =
    AffineTorus.mapPoints w.a w.b φ
      (w.stratumChart R ((w.stratumChart R).symm (AffineTorus.ringHomEquiv R w.a w.b f)))
  rw [Equiv.apply_symm_apply]
  exact AffineTorus.ringHomEquiv_natural w.a w.b φ f

theorem nonempty_stratum (w : SymmetricRook n) (R : Type*) [CommRing R] :
    Nonempty (StratumPoints w.val.rankProfile R) :=
  ⟨(w.stratumChart R).symm (fun _ => 0, fun _ => 1)⟩

theorem card_stratum_finite_field (w : SymmetricRook n)
    (F : Type*) [Field F] [Fintype F] :
    Nat.card (StratumPoints w.val.rankProfile F) =
      Nat.card F ^ w.a * (Nat.card F - 1) ^ w.b := by
  rw [Nat.card_congr (w.stratumChart F)]
  simp only [Nat.card_prod, Nat.card_fun, Nat.card_fin, Nat.card_units]

end SymmetricRook

end FourPapers.Symmetric.Strata
end
end
