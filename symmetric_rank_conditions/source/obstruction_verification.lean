/-!
# Closed statement and trust audit for the unrestricted obstruction foundation

The finite base is followed by an unrestricted extension induction and arbitrary
ambient relabeling. The examples restate the literal point/exponent dictionary
and every property needed for the actual SAGBI obstruction, outside all local
source sections. No mathematical statement is taken as an extra hypothesis.
-/
set_option autoImplicit false
noncomputable section
namespace FourPapers.Symmetric.ObstructionStatementAudit
open Inflation SagbiObstruction
open scoped BigOperators

example {n : ℕ} {S : Finset (Fin n × Fin n)} (hS : IsAntidiagonal S) :
    ∃ a b : Fin S.card ↪o Fin n, antidiagonalPoints a b = S :=
  hS.exists_embeddings

example {n t : ℕ} (a b : Fin t ↪o Fin n) :
    (antidiagonalPoints a b).card = t :=
  antidiagonalPoints_card a b

example {n t : ℕ} (a b : Fin t ↪o Fin n) :
    pointMonomial (antidiagonalPoints a b) = antidiagonalExponent a b :=
  pointMonomial_antidiagonalPoints_eq a b

example {n : ℕ} (m : Entry n →₀ ℕ) (k d : ℕ) :
    HasPackingDegree m k d ↔
      ∃ S : Fin k → Finset (Fin n × Fin n),
        (∀ c, IsAntidiagonal (S c)) ∧
        (∀ e, (∑ c, pointMonomial (S c) e) ≤ m e) ∧
        (∑ c, (S c).card) = d :=
  hasPackingDegree_iff_points m k d

example {n : ℕ} (E : Finset (Entry n)) (S : Finset (Point n)) :
    Admissible E S ↔ IsAntidiagonal S ∧ pointMonomial S ≤ graphMonomial E :=
  admissible_iff_monomial E S

example {n : ℕ} (E : Finset (Entry n)) (S : Finset (Point n)) :
    pointMonomial S ≤ graphMonomial E ↔
      (∀ p ∈ S, ∀ q ∈ S, foldedPoint p = foldedPoint q → p = q) ∧
      (∀ p ∈ S, foldedPoint p ∈ E) :=
  pointMonomial_le_graph_iff E S

example {n : ℕ} {E : Finset (Entry n)} {S : Finset (Point n)}
    (hS : Admissible E S) : pointMonomial S = graphMonomial (edges S) :=
  pointMonomial_eq_graph_edges hS

example {n : ℕ} (E : Finset (Entry n)) :
    (graphMonomial E).sum (fun _ d => d) = E.card :=
  graphMonomial_degree E

example {n : ℕ} (E D : Finset (Entry n)) :
    graphMonomial E - graphMonomial D = graphMonomial (E \ D) :=
  graphMonomial_sdiff E D

example {n : ℕ} {E D : Finset (Entry n)} (hED : Disjoint E D) :
    graphMonomial (E ∪ D) = graphMonomial E + graphMonomial D :=
  graphMonomial_union hED

example {a b : ℕ} {f : Fin a → Fin b} (hf : StrictMono f ∨ StrictAnti f)
    (E : Finset (Entry a)) (S : Finset (Point a)) :
    Admissible (E.image (edgeMap f)) (S.image (pointMap f)) ↔ Admissible E S :=
  admissible_image_iff hf E S

example : ∀ S ⊆ basePositions, Admissible baseGraph S → 4 ≤ S.card →
    S.card = 4 ∧ edges S = edges baseLargest :=
  base_large_classification

example : ∀ S ⊆ complementPositions, Admissible (baseGraph \ edges baseLargest) S →
    S.card ≤ 1 :=
  base_complement_classification

example {t : ℕ} (W : ExtremeWitness t) : ExtremeWitness (t + 1) := W.step

example (t : ℕ) (ht : 4 ≤ t) : ExtremeWitness t := witness t ht

example {a b t : ℕ} (W : GraphObstruction a t) (f : Fin a → Fin b)
    (hf : StrictMono f ∨ StrictAnti f) : GraphObstruction b t := W.map f hf

example (t n : ℕ) (ht : 4 ≤ t) (hn : t + 1 ≤ n) : GraphObstruction n t :=
  witnessIn t n ht hn

/-- All witness properties are expanded here, including the literal support
cardinality, the maximum and its unique edge set, the residual obstruction,
and the two disjoint chains covering the entire graph. -/
example (t n : ℕ) (ht : 4 ≤ t) (hn : t + 1 ≤ n) :
    ∃ (E : Finset (Entry n)) (T L R : Finset (Point n)),
      Admissible E T ∧ Admissible E L ∧ Admissible E R ∧
      E.card = t + 2 ∧ T.card = t ∧
      (∀ S, Admissible E S → S.card ≤ t) ∧
      (∀ S, Admissible E S → t ≤ S.card → S.card = t ∧ edges S = edges T) ∧
      (∀ S, Admissible (E \ edges T) S → S.card ≤ 1) ∧
      edges L ∪ edges R = E ∧ Disjoint (edges L) (edges R) := by
  let W := witnessIn t n ht hn
  exact ⟨W.graph, W.largest, W.left, W.right,
    W.largest_admissible, W.left_admissible, W.right_admissible,
    W.graph_card, W.largest_card, (fun S hS => W.card_le hS),
    W.large_unique, W.complement_bad, W.covering, W.covering_disjoint⟩

end FourPapers.Symmetric.ObstructionStatementAudit
end

