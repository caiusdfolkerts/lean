section

set_option autoImplicit false
set_option maxHeartbeats 2000000

/-!
Finite graph language for the unrestricted obstruction in Proposition 7.4.
The graph records squarefree exponents, and an admissible point set records an
actual antidiagonal without using an independent symmetric entry twice.
-/
namespace FourPapers.Symmetric.SagbiObstruction
open Inflation
open scoped BigOperators

abbrev Point (n : ℕ) := Fin n × Fin n

def edges {n : ℕ} (S : Finset (Point n)) : Finset (Entry n) :=
  S.image foldedPoint

def Admissible {n : ℕ} (E : Finset (Entry n)) (S : Finset (Point n)) : Prop :=
  IsAntidiagonal S ∧
  (∀ p ∈ S, ∀ q ∈ S, foldedPoint p = foldedPoint q → p = q) ∧
  (∀ p ∈ S, foldedPoint p ∈ E)

instance decidableIsAntidiagonal {n : ℕ} (S : Finset (Point n)) :
    Decidable (IsAntidiagonal S) :=
  by
    haveI hrows : Decidable (∀ p : Point n, p ∈ S →
        ∀ q : Point n, q ∈ S → p.1 = q.1 → p = q) :=
      @Finset.decidableDforallFinset (Point n) S
        (fun p _ => ∀ q ∈ S, p.1 = q.1 → p = q)
        (fun p _ => @Finset.decidableDforallFinset (Point n) S
          (fun q _ => p.1 = q.1 → p = q) (fun q _ => inferInstance))
    haveI hdecreasing : Decidable (∀ p : Point n, p ∈ S →
        ∀ q : Point n, q ∈ S → p.1 < q.1 → q.2 < p.2) :=
      @Finset.decidableDforallFinset (Point n) S
        (fun p _ => ∀ q ∈ S, p.1 < q.1 → q.2 < p.2)
        (fun p _ => @Finset.decidableDforallFinset (Point n) S
          (fun q _ => p.1 < q.1 → q.2 < p.2) (fun q _ => inferInstance))
    exact decidable_of_iff
      ((∀ p : Point n, p ∈ S → ∀ q : Point n, q ∈ S → p.1 = q.1 → p = q) ∧
        (∀ p : Point n, p ∈ S → ∀ q : Point n, q ∈ S → p.1 < q.1 → q.2 < p.2))
      ⟨fun h => ⟨h.1, h.2⟩, fun h => ⟨h.rows, h.decreasing⟩⟩

instance decidableAdmissible {n : ℕ} (E : Finset (Entry n)) (S : Finset (Point n)) :
    Decidable (Admissible E S) := by
  haveI honeUse : Decidable (∀ p : Point n, p ∈ S →
      ∀ q : Point n, q ∈ S → foldedPoint p = foldedPoint q → p = q) :=
    @Finset.decidableDforallFinset (Point n) S
      (fun p _ => ∀ q ∈ S, foldedPoint p = foldedPoint q → p = q)
      (fun p _ => @Finset.decidableDforallFinset (Point n) S
        (fun q _ => foldedPoint p = foldedPoint q → p = q) (fun q _ => inferInstance))
  haveI hsupport : Decidable (∀ p : Point n, p ∈ S → foldedPoint p ∈ E) :=
    @Finset.decidableDforallFinset (Point n) S
      (fun p _ => foldedPoint p ∈ E) (fun p _ => inferInstance)
  unfold Admissible
  infer_instance

theorem Admissible.anti {n : ℕ} {E : Finset (Entry n)} {S : Finset (Point n)}
    (h : Admissible E S) : IsAntidiagonal S := h.1

theorem Admissible.oneUse {n : ℕ} {E : Finset (Entry n)} {S : Finset (Point n)}
    (h : Admissible E S) : Set.InjOn foldedPoint (S : Set (Point n)) := h.2.1

theorem Admissible.support {n : ℕ} {E : Finset (Entry n)} {S : Finset (Point n)}
    (h : Admissible E S) : edges S ⊆ E := by
  intro e he
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp he
  exact h.2.2 p hp

theorem Admissible.card_edges {n : ℕ} {E : Finset (Entry n)} {S : Finset (Point n)}
    (h : Admissible E S) : (edges S).card = S.card :=
  Finset.card_image_of_injOn h.oneUse

theorem Admissible.mono {n : ℕ} {E F : Finset (Entry n)} {S : Finset (Point n)}
    (h : Admissible E S) (hEF : E ⊆ F) : Admissible F S :=
  ⟨h.1, h.2.1, fun p hp => hEF (h.2.2 p hp)⟩

theorem Admissible.subset {n : ℕ} {E : Finset (Entry n)} {S T : Finset (Point n)}
    (h : Admissible E S) (hTS : T ⊆ S) : Admissible E T :=
  ⟨⟨fun p hp q hq he => h.1.rows p (hTS hp) q (hTS hq) he,
      fun p hp q hq he => h.1.decreasing p (hTS hp) q (hTS hq) he⟩,
    fun p hp q hq he => h.2.1 p (hTS hp) q (hTS hq) he,
    fun p hp => h.2.2 p (hTS hp)⟩

def pointMap {a b : ℕ} (f : Fin a → Fin b) (p : Point a) : Point b := (f p.1, f p.2)

def edgeMap {a b : ℕ} (f : Fin a → Fin b) (e : Entry a) : Entry b :=
  fold (f e.val.1) (f e.val.2)

theorem pointMap_injective {a b : ℕ} {f : Fin a → Fin b} (hf : Function.Injective f) :
    Function.Injective (pointMap f) := by
  intro p q hpq
  exact Prod.ext (hf (congrArg Prod.fst hpq)) (hf (congrArg Prod.snd hpq))

@[simp] theorem fold_canonical {n : ℕ} (e : Entry n) : fold e.val.1 e.val.2 = e := by
  apply Subtype.ext
  simp only [fold, max_eq_left e.property, min_eq_right e.property]
  rfl

@[simp] theorem edgeMap_foldedPoint {a b : ℕ} (f : Fin a → Fin b) (p : Point a) :
    edgeMap f (foldedPoint p) = foldedPoint (pointMap f p) := by
  change fold (f (max p.1 p.2)) (f (min p.1 p.2)) = fold (f p.1) (f p.2)
  rcases le_total p.1 p.2 with h | h
  · rw [max_eq_right h, min_eq_left h, fold_comm]
  · rw [max_eq_left h, min_eq_right h]

theorem edgeMap_injective {a b : ℕ} {f : Fin a → Fin b} (hf : Function.Injective f) :
    Function.Injective (edgeMap f) := by
  intro e d h
  have hh := (fold_eq_iff _ _ _ _).mp h
  have heq : fold e.val.1 e.val.2 = fold d.val.1 d.val.2 := by
    apply (fold_eq_iff _ _ _ _).mpr
    rcases hh with h | h
    · exact Or.inl ⟨hf h.1, hf h.2⟩
    · exact Or.inr ⟨hf h.1, hf h.2⟩
  simpa only [fold_canonical] using heq

@[simp] theorem edges_image {a b : ℕ} (f : Fin a → Fin b) (S : Finset (Point a)) :
    edges (S.image (pointMap f)) = (edges S).image (edgeMap f) := by
  simp only [edges, Finset.image_image, Function.comp_def, ← edgeMap_foldedPoint]

def OrderCompatible {a b : ℕ} (f : Fin a → Fin b) : Prop := StrictMono f ∨ StrictAnti f

theorem OrderCompatible.injective {a b : ℕ} {f : Fin a → Fin b}
    (hf : OrderCompatible f) : Function.Injective f := hf.elim StrictMono.injective StrictAnti.injective

theorem anti_image_iff {a b : ℕ} {f : Fin a → Fin b} (hf : OrderCompatible f)
    (S : Finset (Point a)) : IsAntidiagonal (S.image (pointMap f)) ↔ IsAntidiagonal S := by
  constructor
  · intro h
    constructor
    · intro p hp q hq he
      apply pointMap_injective hf.injective
      exact h.rows (pointMap f p) (Finset.mem_image_of_mem _ hp)
        (pointMap f q) (Finset.mem_image_of_mem _ hq) (congrArg f he)
    · intro p hp q hq hpq
      rcases hf with hf | hf
      · exact hf.lt_iff_lt.mp (h.decreasing _ (Finset.mem_image_of_mem _ hp)
          _ (Finset.mem_image_of_mem _ hq) (hf hpq))
      · exact hf.lt_iff_gt.mp (h.decreasing _ (Finset.mem_image_of_mem _ hq)
          _ (Finset.mem_image_of_mem _ hp) (hf hpq))
  · intro h
    constructor
    · intro p hp q hq he
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hq
      exact congrArg (pointMap f) (h.rows x hx y hy (hf.injective he))
    · intro p hp q hq hpq
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hq
      rcases hf with hf | hf
      · exact hf (h.decreasing x hx y hy (hf.lt_iff_lt.mp hpq))
      · exact hf (h.decreasing y hy x hx (hf.lt_iff_gt.mp hpq))

theorem admissible_image_iff {a b : ℕ} {f : Fin a → Fin b} (hf : OrderCompatible f)
    (E : Finset (Entry a)) (S : Finset (Point a)) :
    Admissible (E.image (edgeMap f)) (S.image (pointMap f)) ↔ Admissible E S := by
  have he := edgeMap_injective hf.injective
  constructor
  · intro h
    refine ⟨(anti_image_iff hf S).mp h.1, ?_, ?_⟩
    · intro p hp q hq hpq
      apply pointMap_injective hf.injective
      apply h.2.1 _ (Finset.mem_image_of_mem _ hp) _ (Finset.mem_image_of_mem _ hq)
      simpa only [← edgeMap_foldedPoint] using congrArg (edgeMap f) hpq
    · intro p hp
      have hh := h.2.2 _ (Finset.mem_image_of_mem _ hp)
      rw [← edgeMap_foldedPoint, Finset.mem_image] at hh
      obtain ⟨e, heE, heq⟩ := hh
      exact he heq ▸ heE
  · intro h
    refine ⟨(anti_image_iff hf S).mpr h.1, ?_, ?_⟩
    · intro p hp q hq hpq
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hq
      exact congrArg (pointMap f) (h.2.1 x hx y hy
        (he (by simpa only [edgeMap_foldedPoint] using hpq)))
    · intro p hp
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hp
      rw [← edgeMap_foldedPoint]
      exact Finset.mem_image_of_mem _ (h.2.2 x hx)

def pull {a b : ℕ} (f : Fin a → Fin b) (S : Finset (Point b)) : Finset (Point a) :=
  Finset.univ.filter (fun p => pointMap f p ∈ S)

theorem image_pull {a b : ℕ} (f : Fin a → Fin b) (S : Finset (Point b))
    (h : ∀ p ∈ S, ∃ q, pointMap f q = p) : (pull f S).image (pointMap f) = S := by
  ext p
  constructor
  · rintro hp
    obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hp
    exact (Finset.mem_filter.mp hq).2
  · intro hp
    obtain ⟨q, rfl⟩ := h p hp
    exact Finset.mem_image.mpr ⟨q, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hp⟩, rfl⟩

theorem point_preimage_of_edge {a b : ℕ} (f : Fin a → Fin b) (E : Finset (Entry a))
    {p : Point b} (hp : foldedPoint p ∈ E.image (edgeMap f)) :
    ∃ q, pointMap f q = p := by
  obtain ⟨e, he, heq⟩ := Finset.mem_image.mp hp
  have h := (fold_eq_iff _ _ _ _).mp heq
  rcases h with h | h
  · exact ⟨(e.val.1, e.val.2), Prod.ext h.1 h.2⟩
  · exact ⟨(e.val.2, e.val.1), Prod.ext h.2 h.1⟩

theorem admissible_pull {a b : ℕ} {f : Fin a → Fin b} (hf : OrderCompatible f)
    {E : Finset (Entry a)} {S : Finset (Point b)}
    (h : Admissible (E.image (edgeMap f)) S) :
    Admissible E (pull f S) ∧ (pull f S).image (pointMap f) = S ∧
      (pull f S).card = S.card := by
  have himage := image_pull f S (fun p hp => point_preimage_of_edge f E (h.2.2 p hp))
  refine ⟨(admissible_image_iff hf E (pull f S)).mp (himage.symm ▸ h), himage, ?_⟩
  calc
    (pull f S).card = ((pull f S).image (pointMap f)).card :=
      (Finset.card_image_of_injective _ (pointMap_injective hf.injective)).symm
    _ = S.card := congrArg Finset.card himage

/-- The ordinary monomial whose support is the graph and whose exponents are
all one. This is an actual finitely supported exponent vector. -/
noncomputable def graphMonomial {n : ℕ} (E : Finset (Entry n)) : Entry n →₀ ℕ :=
  Finsupp.indicator E (fun _ _ => 1)

@[simp] theorem graphMonomial_apply {n : ℕ} (E : Finset (Entry n)) (e : Entry n) :
    graphMonomial E e = if e ∈ E then 1 else 0 := by simp [graphMonomial]

theorem pointMonomial_le_graph_iff {n : ℕ} (E : Finset (Entry n)) (S : Finset (Point n)) :
    pointMonomial S ≤ graphMonomial E ↔
      (∀ p ∈ S, ∀ q ∈ S, foldedPoint p = foldedPoint q → p = q) ∧
      (∀ p ∈ S, foldedPoint p ∈ E) := by
  classical
  constructor
  · intro h
    have hs : ∀ p ∈ S, foldedPoint p ∈ E := by
      intro p hp
      have hh := h (foldedPoint p)
      have hpos := pointMonomial_pos_of_mem hp
      by_contra hn
      simp only [graphMonomial_apply, if_neg hn] at hh
      omega
    refine ⟨?_, hs⟩
    intro p hp q hq he
    by_contra hpq
    have hsub : ({p, q} : Finset (Point n)) ⊆ S.filter (fun r => foldedPoint r = foldedPoint p) := by
      intro r hr
      simp only [Finset.mem_insert, Finset.mem_singleton] at hr
      rcases hr with rfl | rfl
      · exact Finset.mem_filter.mpr ⟨hp, rfl⟩
      · exact Finset.mem_filter.mpr ⟨hq, he.symm⟩
    have hc := Finset.card_le_card hsub
    have hh := h (foldedPoint p)
    rw [pointMonomial_apply, pointMultiplicity, graphMonomial_apply, if_pos (hs p hp)] at hh
    have hnot : p ∉ ({q} : Finset (Point n)) := by
      simpa only [Finset.mem_singleton] using hpq
    rw [Finset.card_insert_of_notMem hnot, Finset.card_singleton] at hc
    have hcard : (S.filter (fun r => foldedPoint r = foldedPoint p)).card =
        pointMultiplicity S (foldedPoint p) := by
      unfold pointMultiplicity
      congr
    rw [hcard] at hc
    change pointMultiplicity S (foldedPoint p) ≤ 1 at hh
    omega
  · rintro ⟨hinj, hs⟩ e
    rw [pointMonomial_apply, pointMultiplicity, graphMonomial_apply]
    by_cases he : e ∈ E
    · rw [if_pos he]
      apply Finset.card_le_one.mpr
      intro p hp q hq
      exact hinj p (Finset.mem_filter.mp hp).1 q (Finset.mem_filter.mp hq).1
        ((Finset.mem_filter.mp hp).2.trans (Finset.mem_filter.mp hq).2.symm)
    · rw [if_neg he]
      apply Nat.le_zero.mpr
      apply Finset.card_eq_zero.mpr
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro p hp
      obtain ⟨hp, hpe⟩ := Finset.mem_filter.mp hp
      exact he (hpe ▸ hs p hp)

theorem admissible_iff_monomial {n : ℕ} (E : Finset (Entry n)) (S : Finset (Point n)) :
    Admissible E S ↔ IsAntidiagonal S ∧ pointMonomial S ≤ graphMonomial E := by
  rw [pointMonomial_le_graph_iff]
  rfl

theorem pointMonomial_eq_graph_edges {n : ℕ} {E : Finset (Entry n)}
    {S : Finset (Point n)} (h : Admissible E S) : pointMonomial S = graphMonomial (edges S) := by
  classical
  apply Finsupp.ext
  intro e
  have hle := (pointMonomial_le_graph_iff (edges S) S).mpr
    ⟨h.2.1, fun p hp => Finset.mem_image_of_mem _ hp⟩ e
  by_cases he : e ∈ edges S
  · have hle' : pointMonomial S e ≤ 1 := by
      simpa only [graphMonomial_apply, if_pos he] using hle
    obtain ⟨p, hp, hpe⟩ := Finset.mem_image.mp he
    have hpos : 0 < pointMonomial S e := hpe ▸ pointMonomial_pos_of_mem hp
    rw [graphMonomial_apply, if_pos he]
    omega
  · rw [graphMonomial_apply, if_neg he] at hle ⊢
    exact Nat.le_zero.mp hle

theorem graphMonomial_degree {n : ℕ} (E : Finset (Entry n)) :
    (graphMonomial E).sum (fun _ d => d) = E.card := by
  classical
  rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
  simp only [graphMonomial_apply]
  rw [← Finset.sum_filter]
  simp

theorem graphMonomial_sdiff {n : ℕ} (E D : Finset (Entry n)) :
    graphMonomial E - graphMonomial D = graphMonomial (E \ D) := by
  apply Finsupp.ext
  intro e
  by_cases hE : e ∈ E <;> by_cases hD : e ∈ D <;>
    simp [Finsupp.tsub_apply, graphMonomial_apply, hE, hD]

theorem graphMonomial_union {n : ℕ} {E D : Finset (Entry n)} (h : Disjoint E D) :
    graphMonomial (E ∪ D) = graphMonomial E + graphMonomial D := by
  apply Finsupp.ext
  intro e
  have hn : ¬(e ∈ E ∧ e ∈ D) := fun he => Finset.disjoint_left.mp h he.1 he.2
  by_cases hE : e ∈ E <;> by_cases hD : e ∈ D <;>
    simp_all only [graphMonomial_apply, Finsupp.add_apply, Finset.mem_union,
      or_self, or_true, true_or, or_false, false_or, ite_true, ite_false,
      and_self, and_true, true_and, and_false, false_and, not_true_eq_false,
      Nat.add_zero, Nat.zero_add]

end FourPapers.Symmetric.SagbiObstruction
