def baseWitness : ExtremeWitness 4 where
  graph := baseGraph
  largest := baseLargest
  left := baseLeft
  right := baseRight
  largest_admissible := by decide
  left_admissible := by decide
  right_admissible := by decide
  graph_card := by decide
  largest_card := by decide
  large_unique := by
    intro S hS hsize
    apply base_large_classification S ?_ hS hsize
    intro p hp
    exact (base_support_dictionary p).mp (hS.2.2 p hp)
  complement_bad := by
    intro S hS
    apply base_complement_classification S ?_ hS
    intro p hp
    exact (base_complement_dictionary p).mp (hS.2.2 p hp)
  covering := by decide
  covering_disjoint := by decide
  largest_avoids := by decide
  left_avoids := by decide
  right_avoids := by decide

/-- Uniform witness family on exactly `t+1` vertices for every `t≥4`. -/
def witnessOffset : (q : ℕ) → ExtremeWitness (4 + q)
  | 0 => baseWitness
  | q + 1 => (witnessOffset q).step

def witness (t : ℕ) (ht : 4 ≤ t) : ExtremeWitness t := by
  have h : 4 + (t - 4) = t := by omega
  exact h ▸ witnessOffset (t - 4)

/-- Relabeling into a larger ordered vertex set preserves the exact maximum,
its unique edge set, the two-edge obstruction, and the two-chain covering. -/
def GraphObstruction.map {a b t : ℕ} (W : GraphObstruction a t)
    (f : Fin a → Fin b) (hf : OrderCompatible f) : GraphObstruction b t where
  graph := W.graph.image (edgeMap f)
  largest := W.largest.image (pointMap f)
  left := W.left.image (pointMap f)
  right := W.right.image (pointMap f)
  largest_admissible := (admissible_image_iff hf _ _).mpr W.largest_admissible
  left_admissible := (admissible_image_iff hf _ _).mpr W.left_admissible
  right_admissible := (admissible_image_iff hf _ _).mpr W.right_admissible
  graph_card := by
    rw [Finset.card_image_of_injective _ (edgeMap_injective hf.injective), W.graph_card]
  largest_card := by
    rw [Finset.card_image_of_injective _ (pointMap_injective hf.injective), W.largest_card]
  large_unique := by
    intro S hS hsize
    obtain ⟨hT, himage, hcard⟩ := admissible_pull hf hS
    obtain ⟨hc, he⟩ := W.large_unique (pull f S) hT (by omega)
    refine ⟨by omega, ?_⟩
    rw [← himage, edges_image, edges_image, he]
  complement_bad := by
    intro S hS
    rw [edges_image, ← Finset.image_sdiff _ _ (edgeMap_injective hf.injective)] at hS
    obtain ⟨hT, himage, hcard⟩ := admissible_pull hf hS
    rw [← hcard]
    exact W.complement_bad _ hT
  covering := by rw [edges_image, edges_image, ← Finset.image_union, W.covering]
  covering_disjoint := by
    rw [edges_image, edges_image]
    apply Finset.disjoint_left.mpr
    intro e he hd
    obtain ⟨a, ha, he⟩ := Finset.mem_image.mp he
    obtain ⟨b, hb, hd⟩ := Finset.mem_image.mp hd
    have hab := edgeMap_injective hf.injective (he.trans hd.symm)
    exact Finset.disjoint_left.mp W.covering_disjoint ha (hab.symm ▸ hb)

