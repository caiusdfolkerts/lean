/-- Ordinary finite-case assembly of the separately kernel-checked chunks. -/
theorem base_large_chunks :
    ∀ H ∈ baseHead.powerset, ∀ R ∈ baseTail.powerset,
      4 ≤ (H ∪ R).card → Admissible baseGraph (H ∪ R) →
      (H ∪ R).card = 4 ∧ edges (H ∪ R) = edges baseLargest := by
  intro H hH R hR hsize hanti
  rw [baseHead_powerset] at hH
  simp only [Finset.mem_insert, Finset.mem_singleton] at hH
  rcases hH with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact base_large_chunk_00 R hR hsize hanti
  · exact base_large_chunk_01 R hR hsize hanti
  · exact base_large_chunk_02 R hR hsize hanti
  · exact base_large_chunk_03 R hR hsize hanti
  · exact base_large_chunk_04 R hR hsize hanti
  · exact base_large_chunk_05 R hR hsize hanti
  · exact base_large_chunk_06 R hR hsize hanti
  · exact base_large_chunk_07 R hR hsize hanti
  · exact base_large_chunk_08 R hR hsize hanti
  · exact base_large_chunk_09 R hR hsize hanti
  · exact base_large_chunk_10 R hR hsize hanti
  · exact base_large_chunk_11 R hR hsize hanti
  · exact base_large_chunk_12 R hR hsize hanti
  · exact base_large_chunk_13 R hR hsize hanti
  · exact base_large_chunk_14 R hR hsize hanti
  · exact base_large_chunk_15 R hR hsize hanti

/-- This is a closed finite base lemma, checked by the kernel's reduction of
decidable propositions. The unrestricted result below is an induction, not a
bounded search over matrix sizes. -/
theorem base_large_classification :
    ∀ S ⊆ basePositions, Admissible baseGraph S → 4 ≤ S.card →
      S.card = 4 ∧ edges S = edges baseLargest := by
  intro S hS hanti hsize
  have hSU : S ⊆ baseHead ∪ baseTail := by
    rw [baseHead_union_tail]
    exact hS
  have hsplit : (S ∩ baseHead) ∪ (S ∩ baseTail) = S := by
    rw [← Finset.inter_union_distrib_left, Finset.inter_eq_left.mpr hSU]
  have h := base_large_chunks (S ∩ baseHead)
    (Finset.mem_powerset.mpr Finset.inter_subset_right)
    (S ∩ baseTail) (Finset.mem_powerset.mpr Finset.inter_subset_right)
  rw [hsplit] at h
  exact h hsize hanti

