/-!
# Finite antidiagonal point sets for the SAGBI obstruction

The finite-point dictionary relates antidiagonal position sets to the original
minor embeddings. The monomial is the literal folded exponent sum, including
all repetitions.
-/

namespace FourPapers.Symmetric.Inflation
variable {n : ℕ}

structure IsAntidiagonal (S : Finset (Fin n × Fin n)) : Prop where
  rows : ∀ p ∈ S, ∀ q ∈ S, p.1 = q.1 → p = q
  decreasing : ∀ p ∈ S, ∀ q ∈ S, p.1 < q.1 → q.2 < p.2

def foldedPoint (p : Fin n × Fin n) : MatchingEntry n :=
  ⟨toLex (max p.1 p.2, min p.1 p.2), min_le_max⟩

/-- The ordinary exponent vector of the product of folded matrix entries. -/
noncomputable def pointMonomial (S : Finset (Fin n × Fin n)) : MatchingEntry n →₀ ℕ :=
  (S.val.map foldedPoint).toFinsupp

def pointMultiplicity (S : Finset (Fin n × Fin n)) (e : MatchingEntry n) : ℕ :=
  (S.filter fun p => foldedPoint p = e).card

theorem pointMonomial_apply (S : Finset (Fin n × Fin n)) (e : MatchingEntry n) :
    pointMonomial S e = pointMultiplicity S e := by
  classical
  rw [pointMonomial, Multiset.toFinsupp_apply, Multiset.count_map]
  change (S.val.filter (fun p => e = foldedPoint p)).card =
    (S.val.filter (fun p => foldedPoint p = e)).card
  exact congrArg Multiset.card (Multiset.filter_congr (fun p _ => eq_comm))

theorem pointMonomial_degree (S : Finset (Fin n × Fin n)) :
    (pointMonomial S).sum (fun _ d => d) = S.card := by
  change (S.val.map foldedPoint).toFinsupp.sum (fun _ => id) = S.card
  rw [Multiset.toFinsupp_sum_eq, Multiset.card_map]
  rfl

end FourPapers.Symmetric.Inflation

namespace FourPapers.Symmetric.Inflation
open scoped BigOperators

variable {n t : ℕ}

/-- The actual matrix positions of an increasing-row, decreasing-column
antidiagonal. -/
def antidiagonalPoints (a b : Fin t ↪o Fin n) : Finset (Fin n × Fin n) :=
  Finset.univ.image (fun p => (a p, b p.rev))

theorem antidiagonalPoint_injective (a b : Fin t ↪o Fin n) :
    Function.Injective (fun p => (a p, b p.rev)) := by
  intro p q h
  exact a.injective (congrArg Prod.fst h)

theorem antidiagonalPoints_card (a b : Fin t ↪o Fin n) :
    (antidiagonalPoints a b).card = t := by
  rw [antidiagonalPoints, Finset.card_image_of_injective _ (antidiagonalPoint_injective a b),
    Finset.card_univ, Fintype.card_fin]

theorem antidiagonalPoints_isAntidiagonal (a b : Fin t ↪o Fin n) :
    IsAntidiagonal (antidiagonalPoints a b) := by
  constructor
  · intro p hp q hq heq
    obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hp
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hq
    have hrs : r = s := a.injective heq
    subst s
    rfl
  · intro p hp q hq hpq
    obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hp
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hq
    exact b.strictMono (Fin.rev_lt_rev.mpr (a.strictMono.lt_iff_lt.mp hpq))

/-- Enumerating an arbitrary finite antidiagonal by its row order produces the
usual two increasing embeddings, without any extra condition on its size. -/
theorem IsAntidiagonal.exists_embeddings {S : Finset (Fin n × Fin n)} (hS : IsAntidiagonal S) :
    ∃ a b : Fin S.card ↪o Fin n, antidiagonalPoints a b = S := by
  classical
  let ord : LinearOrder {p : Fin n × Fin n // p ∈ S} :=
    LinearOrder.lift' (fun p => toLex p.val) (fun p q h => Subtype.ext h)
  letI : LinearOrder {p : Fin n × Fin n // p ∈ S} := ord
  letI : LE {p : Fin n × Fin n // p ∈ S} := ord.toLE
  letI : LT {p : Fin n × Fin n // p ∈ S} := ord.toLT
  letI : Preorder {p : Fin n × Fin n // p ∈ S} := ord.toPreorder
  let e : Fin S.card ≃o {p : Fin n × Fin n // p ∈ S} :=
    Fintype.orderIsoFinOfCardEq _ (Fintype.card_coe S)
  have hrow : StrictMono (fun p => (e p).val.1) := by
    intro p q hpq
    have hh := e.strictMono hpq
    change toLex (e p).val < toLex (e q).val at hh
    rw [Prod.Lex.toLex_lt_toLex] at hh
    rcases hh with hh | ⟨heq, hcol⟩
    · exact hh
    · have hpq' : p = q := e.injective (Subtype.ext
        (hS.rows (e p).val (e p).property (e q).val (e q).property heq))
      exact False.elim ((ne_of_lt hpq) hpq')
  have hcol : StrictMono (fun p : Fin S.card => (e p.rev).val.2) := by
    intro p q hpq
    exact hS.decreasing (e q.rev).val (e q.rev).property
      (e p.rev).val (e p.rev).property (hrow (Fin.rev_lt_rev.mpr hpq))
  let a : Fin S.card ↪o Fin n := OrderEmbedding.ofStrictMono _ hrow
  let b : Fin S.card ↪o Fin n := OrderEmbedding.ofStrictMono _ hcol
  refine ⟨a, b, ?_⟩
  ext p
  constructor
  · intro hp
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hp
    change ((e i).val.1, (e i.rev.rev).val.2) ∈ S
    simpa only [Fin.rev_rev] using (e i).property
  · intro hp
    refine Finset.mem_image.mpr ⟨e.symm ⟨p, hp⟩, Finset.mem_univ _, ?_⟩
    change ((e (e.symm ⟨p, hp⟩)).val.1,
      (e (e.symm ⟨p, hp⟩).rev.rev).val.2) = p
    simp only [Fin.rev_rev, e.apply_symm_apply]

theorem pointMonomial_antidiagonalPoints (a b : Fin t ↪o Fin n) :
    pointMonomial (antidiagonalPoints a b) = antidiagonalExponent a b := by
  classical
  apply Finsupp.ext
  intro v
  rw [pointMonomial_apply, pointMultiplicity, antidiagonalPoints, Finset.filter_image,
    Finset.card_image_of_injective _ (antidiagonalPoint_injective a b), Finset.card_eq_sum_ones,
    Finset.sum_filter]
  simp only [antidiagonalExponent, Finsupp.finsetSum_apply, Finsupp.single_apply, foldedPoint, fold, eq_comm]

theorem antidiagonalPoints_rows_iff (a b : Fin t ↪o Fin n) (i : Fin n) :
    (∀ p ∈ antidiagonalPoints a b, p.1 ≤ i) ↔ ∀ r, a r ≤ i := by
  constructor
  · intro h r
    exact h (a r, b r.rev) (Finset.mem_image_of_mem _ (Finset.mem_univ r))
  · intro h p hp
    obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hp
    exact h r

theorem antidiagonalPoints_columns_iff (a b : Fin t ↪o Fin n) (j : Fin n) :
    (∀ p ∈ antidiagonalPoints a b, p.2 ≤ j) ↔ ∀ r, b r ≤ j := by
  constructor
  · intro h r
    have hh := h (a r.rev, b r.rev.rev) (Finset.mem_image_of_mem _ (Finset.mem_univ r.rev))
    simpa only [Fin.rev_rev] using hh
  · intro h p hp
    obtain ⟨r, hr, rfl⟩ := Finset.mem_image.mp hp
    exact h r.rev

end FourPapers.Symmetric.Inflation

namespace FourPapers.Symmetric
open Inflation
variable {n t : ℕ}

@[simp] theorem pointMonomial_antidiagonalPoints_eq (a b : Fin t ↪o Fin n) :
    pointMonomial (antidiagonalPoints a b) = antidiagonalExponent a b :=
  pointMonomial_antidiagonalPoints a b

def HasPointPackingDegree (m : MatchingEntry n →₀ ℕ) (k d : ℕ) : Prop :=
  ∃ S : Fin k → Finset (Fin n × Fin n), (∀ c, IsAntidiagonal (S c)) ∧
    (∀ e, (∑ c, pointMonomial (S c) e) ≤ m e) ∧ (∑ c, (S c).card) = d

theorem hasPackingDegree_iff_points (m : Entry n →₀ ℕ) (k d : ℕ) :
    HasPackingDegree m k d ↔ HasPointPackingDegree m k d := by
  classical
  constructor
  · rintro ⟨s, a, b, hd, hm⟩
    refine ⟨fun c => antidiagonalPoints (a c) (b c),
      fun c => antidiagonalPoints_isAntidiagonal (a c) (b c), ?_, ?_⟩
    · intro e
      have hh := hm e
      simpa only [Finsupp.finsetSum_apply, pointMonomial_antidiagonalPoints_eq] using hh
    · simpa only [antidiagonalPoints_card] using hd
  · rintro ⟨S, hS, hm, hd⟩
    let a : ∀ c, Fin (S c).card ↪o Fin n := fun c => Classical.choose ((hS c).exists_embeddings)
    let b : ∀ c, Fin (S c).card ↪o Fin n := fun c =>
      Classical.choose (Classical.choose_spec ((hS c).exists_embeddings))
    have hab : ∀ c, antidiagonalPoints (a c) (b c) = S c := fun c =>
      Classical.choose_spec (Classical.choose_spec ((hS c).exists_embeddings))
    refine ⟨fun c => (S c).card, a, b, hd, ?_⟩
    intro e
    simp only [Finsupp.finsetSum_apply, ← pointMonomial_antidiagonalPoints_eq, hab]
    exact hm e

theorem pointMonomial_pos_of_mem {S : Finset (Fin n × Fin n)} {p : Fin n × Fin n}
    (hp : p ∈ S) : 0 < pointMonomial S (foldedPoint p) := by
  rw [pointMonomial_apply, pointMultiplicity]
  exact Finset.card_pos.mpr ⟨p, Finset.mem_filter.mpr ⟨hp, rfl⟩⟩

end FourPapers.Symmetric
end
