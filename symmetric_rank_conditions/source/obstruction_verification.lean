/-- Reverse the old ordered vertices, then include them below the newly added
largest vertex. This normalizes the paper's alternating-extreme construction. -/
def flipEmbed (t : ℕ) (i : Fin (t + 1)) : Fin (t + 2) := i.rev.castSucc

theorem flipEmbed_strictAnti (t : ℕ) : StrictAnti (flipEmbed t) := by
  intro i j hij
  exact Fin.rev_lt_rev.mpr hij

theorem flipEmbed_order (t : ℕ) : OrderCompatible (flipEmbed t) :=
  Or.inr (flipEmbed_strictAnti t)

theorem flipEmbed_ne_last (t : ℕ) (i : Fin (t + 1)) :
    flipEmbed t i ≠ Fin.last (t + 1) := by
  intro h
  have hh := congrArg Fin.val h
  have hi := i.rev.isLt
  change i.rev.val = t + 1 at hh
  omega

theorem flipEmbed_pos {t : ℕ} {i : Fin (t + 1)} (hi : i ≠ Fin.last t) :
    0 < flipEmbed t i := by
  have hne : i.val ≠ t := fun h => hi (Fin.ext h)
  change 0 < t + 1 - (i.val + 1)
  have hit := i.isLt
  omega

def newPoint (t : ℕ) : Point (t + 2) := (0, Fin.last (t + 1))
def newEdge (t : ℕ) : Entry (t + 2) := foldedPoint (newPoint t)

theorem newEdge_not_image (t : ℕ) (E : Finset (Entry (t + 1))) :
    newEdge t ∉ E.image (edgeMap (flipEmbed t)) := by
  intro h
  obtain ⟨e, he, heq⟩ := Finset.mem_image.mp h
  have hh := (fold_eq_iff _ _ _ _).mp heq
  rcases hh with hh | hh
  · exact flipEmbed_ne_last t e.val.2 hh.2
  · exact flipEmbed_ne_last t e.val.1 hh.1

theorem newPoint_not_image (t : ℕ) (S : Finset (Point (t + 1))) :
    newPoint t ∉ S.image (pointMap (flipEmbed t)) := by
  intro h
  obtain ⟨p, hp, heq⟩ := Finset.mem_image.mp h
  exact flipEmbed_ne_last t p.2 (congrArg Prod.snd heq)

def extendGraph (t : ℕ) (E : Finset (Entry (t + 1))) : Finset (Entry (t + 2)) :=
  insert (newEdge t) (E.image (edgeMap (flipEmbed t)))

def extendPoints (t : ℕ) (S : Finset (Point (t + 1))) : Finset (Point (t + 2)) :=
  insert (newPoint t) (S.image (pointMap (flipEmbed t)))

@[simp] theorem edges_extendPoints (t : ℕ) (S : Finset (Point (t + 1))) :
    edges (extendPoints t S) = extendGraph t (edges S) := by
  rw [extendPoints, edges, Finset.image_insert]
  change insert (newEdge t) (edges (S.image (pointMap (flipEmbed t)))) = _
  rw [edges_image]
  rfl

@[simp] theorem card_extendPoints (t : ℕ) (S : Finset (Point (t + 1))) :
    (extendPoints t S).card = S.card + 1 := by
  rw [extendPoints, Finset.card_insert_of_notMem (newPoint_not_image t S),
    Finset.card_image_of_injective _ (pointMap_injective (flipEmbed_order t).injective)]

@[simp] theorem card_extendGraph (t : ℕ) (E : Finset (Entry (t + 1))) :
    (extendGraph t E).card = E.card + 1 := by
  rw [extendGraph, Finset.card_insert_of_notMem (newEdge_not_image t E),
    Finset.card_image_of_injective _ (edgeMap_injective (flipEmbed_order t).injective)]

theorem extendPoints_admissible {t : ℕ} {E : Finset (Entry (t + 1))}
    {S : Finset (Point (t + 1))} (hS : Admissible E S)
    (hrow : ∀ p ∈ S, p.1 ≠ Fin.last t) :
    Admissible (extendGraph t E) (extendPoints t S) := by
  have hi := (admissible_image_iff (flipEmbed_order t) E S).mpr hS
  refine ⟨?_, ?_, ?_⟩
  · constructor
    · intro p hp q hq hpq
      rcases Finset.mem_insert.mp hp with rfl | hp
      · rcases Finset.mem_insert.mp hq with rfl | hq
        · rfl
        · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hq
          have hh := flipEmbed_pos (hrow x hx)
          exact False.elim ((ne_of_gt hh) hpq.symm)
      · rcases Finset.mem_insert.mp hq with rfl | hq
        · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hp
          have hh := flipEmbed_pos (hrow x hx)
          exact False.elim ((ne_of_gt hh) hpq)
        · exact hi.1.rows p hp q hq hpq
    · intro p hp q hq hpq
      rcases Finset.mem_insert.mp hp with rfl | hp
      · rcases Finset.mem_insert.mp hq with rfl | hq
        · exact False.elim ((lt_irrefl _) hpq)
        · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hq
          exact q.2.rev.isLt
      · rcases Finset.mem_insert.mp hq with rfl | hq
        · exact False.elim (not_lt_of_ge (Fin.zero_le _) hpq)
        · exact hi.1.decreasing p hp q hq hpq
  · intro p hp q hq he
    rcases Finset.mem_insert.mp hp with rfl | hp
    · rcases Finset.mem_insert.mp hq with rfl | hq
      · rfl
      · apply False.elim
        apply newEdge_not_image t E
        change foldedPoint (newPoint t) ∈ E.image (edgeMap (flipEmbed t))
        rw [he]
        exact hi.2.2 q hq
    · rcases Finset.mem_insert.mp hq with rfl | hq
      · apply False.elim
        apply newEdge_not_image t E
        change foldedPoint (newPoint t) ∈ E.image (edgeMap (flipEmbed t))
        rw [← he]
        exact hi.2.2 p hp
      · exact hi.2.1 p hp q hq he
  · intro p hp
    rcases Finset.mem_insert.mp hp with rfl | hp
    · exact Finset.mem_insert_self _ _
    · exact Finset.mem_insert_of_mem (hi.2.2 p hp)

theorem extendPoints_avoid_last (t : ℕ) (S : Finset (Point (t + 1))) :
    ∀ p ∈ extendPoints t S, p.1 ≠ Fin.last (t + 1) := by
  intro p hp
  rcases Finset.mem_insert.mp hp with rfl | hp
  · intro h
    have hh := congrArg Fin.val h
    change 0 = t + 1 at hh
    omega
  · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hp
    exact flipEmbed_ne_last t p.1

/-- Deleting the only possible new edge gives an old antidiagonal and removes
at most one occurrence. This statement applies to every size, not just maximal
chains, and keeps track of the exact surviving edge set. -/
theorem strip_extension {t : ℕ} {E : Finset (Entry (t + 1))}
    {S : Finset (Point (t + 2))} (hS : Admissible (extendGraph t E) S) :
    ∃ T : Finset (Point (t + 1)), Admissible E T ∧
      S.card ≤ T.card + 1 ∧
      (T.card < S.card → edges S = extendGraph t (edges T)) := by
  classical
  let R := S.filter (fun p => foldedPoint p ≠ newEdge t)
  let B := S.filter (fun p => foldedPoint p = newEdge t)
  have hR : Admissible (E.image (edgeMap (flipEmbed t))) R := by
    have hh := hS.subset
      (Finset.filter_subset (fun p => foldedPoint p ≠ newEdge t) S)
    refine ⟨hh.1, hh.2.1, ?_⟩
    intro p hp
    have hnot := (Finset.mem_filter.mp hp).2
    exact (Finset.mem_insert.mp (hS.2.2 p (Finset.mem_filter.mp hp).1)).resolve_left hnot
  have hB : B.card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro p hp q hq
    exact hS.2.1 p (Finset.mem_filter.mp hp).1 q (Finset.mem_filter.mp hq).1
      ((Finset.mem_filter.mp hp).2.trans (Finset.mem_filter.mp hq).2.symm)
  have hpart : B.card + R.card = S.card :=
    Finset.card_filter_add_card_filter_not (s := S) (fun p => foldedPoint p = newEdge t)
  let T := pull (flipEmbed t) R
  obtain ⟨hT, himage, hcard⟩ := admissible_pull (flipEmbed_order t) hR
  change T.card = R.card at hcard
  refine ⟨T, hT, by omega, ?_⟩
  intro hlarge
  have hBpos : 0 < B.card := by omega
  obtain ⟨p, hp⟩ := Finset.card_pos.mp hBpos
  have hnew : newEdge t ∈ edges S := by
    have hpS := (Finset.mem_filter.mp hp).1
    have hpe := (Finset.mem_filter.mp hp).2
    exact hpe ▸ Finset.mem_image_of_mem foldedPoint hpS
  have heq : edges S = insert (newEdge t) (edges R) := by
    ext e
    constructor
    · intro he
      obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp he
      by_cases hn : foldedPoint p = newEdge t
      · exact Finset.mem_insert.mpr (Or.inl hn)
      · exact Finset.mem_insert_of_mem
          (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hp, hn⟩))
    · intro he
      rcases Finset.mem_insert.mp he with rfl | he
      · exact hnew
      · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp he
        exact Finset.mem_image_of_mem _ (Finset.mem_filter.mp hp).1
  have hER : edges R = (edges T).image (edgeMap (flipEmbed t)) := by
    calc
      edges R = edges (T.image (pointMap (flipEmbed t))) := congrArg edges himage.symm
      _ = _ := edges_image _ _
  rw [heq, hER]
  rfl

theorem extendGraph_sdiff {t : ℕ} (E D : Finset (Entry (t + 1))) :
    extendGraph t E \ extendGraph t D = (E \ D).image (edgeMap (flipEmbed t)) := by
  rw [Finset.image_sdiff _ _ (edgeMap_injective (flipEmbed_order t).injective)]
  unfold extendGraph
  ext e
  have hn := newEdge_not_image t E
  simp only [Finset.mem_sdiff, Finset.mem_insert]
  constructor
  · rintro ⟨he | he, hnD⟩
    · exact False.elim (hnD (Or.inl he))
    · exact ⟨he, fun hd => hnD (Or.inr hd)⟩
  · rintro ⟨he, hd⟩
    refine ⟨Or.inr he, ?_⟩
    rintro (h | h)
    · exact hn (h ▸ he)
    · exact hd h

/-- Exact combinatorial data used in the two-grading obstruction. -/
structure GraphObstruction (n t : ℕ) where
  graph : Finset (Entry n)
  largest : Finset (Point n)
  left : Finset (Point n)
  right : Finset (Point n)
  largest_admissible : Admissible graph largest
  left_admissible : Admissible graph left
  right_admissible : Admissible graph right
  graph_card : graph.card = t + 2
  largest_card : largest.card = t
  large_unique : ∀ S, Admissible graph S → t ≤ S.card →
    S.card = t ∧ edges S = edges largest
  complement_bad : ∀ S, Admissible (graph \ edges largest) S → S.card ≤ 1
  covering : edges left ∪ edges right = graph
  covering_disjoint : Disjoint (edges left) (edges right)

theorem GraphObstruction.card_le {n t : ℕ} (W : GraphObstruction n t)
    {S : Finset (Point n)} (hS : Admissible W.graph S) : S.card ≤ t := by
  by_cases h : t ≤ S.card
  · exact (W.large_unique S hS h).1.le
  · omega

structure ExtremeWitness (t : ℕ) extends GraphObstruction (t + 1) t where
  largest_avoids : ∀ p ∈ largest, p.1 ≠ Fin.last t
  left_avoids : ∀ p ∈ left, p.1 ≠ Fin.last t
  right_avoids : ∀ p ∈ right, p.1 ≠ Fin.last t

def ExtremeWitness.step {t : ℕ} (W : ExtremeWitness t) : ExtremeWitness (t + 1) where
  graph := extendGraph t W.graph
  largest := extendPoints t W.largest
  left := extendPoints t W.left
  right := W.right.image (pointMap (flipEmbed t))
  largest_admissible := extendPoints_admissible W.largest_admissible W.largest_avoids
  left_admissible := extendPoints_admissible W.left_admissible W.left_avoids
  right_admissible :=
    ((admissible_image_iff (flipEmbed_order t) W.graph W.right).mpr W.right_admissible).mono
      (Finset.subset_insert _ _)
  graph_card := by rw [card_extendGraph, W.graph_card]
  largest_card := by rw [card_extendPoints, W.largest_card]
  large_unique := by
    intro S hS hlarge
    obtain ⟨T, hT, hsize, hedges⟩ := strip_extension hS
    have hb := W.toGraphObstruction.card_le hT
    have hTcard : T.card = t := by omega
    have hScard : S.card = t + 1 := by omega
    have hTeq := (W.large_unique T hT hTcard.ge).2
    refine ⟨hScard, ?_⟩
    rw [hedges (by omega), hTeq, edges_extendPoints]
  complement_bad := by
    intro S hS
    rw [edges_extendPoints, extendGraph_sdiff] at hS
    obtain ⟨hT, himage, hcard⟩ := admissible_pull (flipEmbed_order t) hS
    rw [← hcard]
    exact W.complement_bad _ hT
  covering := by
    rw [edges_extendPoints, edges_image]
    unfold extendGraph
    rw [Finset.insert_union, ← Finset.image_union, W.covering]
  covering_disjoint := by
    rw [edges_extendPoints, edges_image]
    apply Finset.disjoint_left.mpr
    intro e he hf
    rcases Finset.mem_insert.mp he with rfl | he
    · exact newEdge_not_image t (edges W.right) hf
    · obtain ⟨a, ha, he⟩ := Finset.mem_image.mp he
      obtain ⟨b, hb, hf⟩ := Finset.mem_image.mp hf
      have hab := edgeMap_injective (flipEmbed_order t).injective (he.trans hf.symm)
      exact Finset.disjoint_left.mp W.covering_disjoint ha (hab.symm ▸ hb)
  largest_avoids := extendPoints_avoid_last t W.largest
  left_avoids := extendPoints_avoid_last t W.left
  right_avoids := by
    intro p hp
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hp
    exact flipEmbed_ne_last t p.1

