section BundlePart3
/- Source: Papers/PolytopeFourRegularTail.lean -/





@[expose] public section

/-!
# From the saturated four-cycle star to a genuine four-face

The flat containment used for the exceptional tail is derived from the
absence of a rigid four-set.  Rigidity here quantifies over all maps
parallel on the actual induced tail edges.  Thus the proof cannot assume
that the particular decomposition map is nonhomothetic on each cycle.
-/

noncomputable section
namespace Papers.PolytopeFourRegularTail

open Set Module
open Papers.PolytopeVertexCone Papers.PolytopeSimpleTailFace
open Papers.SimpleCornerFaces Papers.FourCycle
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

theorem pair_of_simple_neighbor_directions
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    {v a b : E n} (hv : v ∈ P.vertices)
    (hsimple : (actualNeighbors P v).card = n)
    (hva : GeneralVertexStep P v a) (hvb : GeneralVertexStep P v b) (hab : a ≠ b) :
    LinearIndependent ℝ ![a-v,b-v] := by
  let aa : actualNeighbors P v := ⟨a,(mem_actualNeighbors_iff P v a).mpr hva⟩
  let bb : actualNeighbors P v := ⟨b,(mem_actualNeighbors_iff P v b).mpr hvb⟩
  let q : Fin 2 → actualNeighbors P v := ![aa,bb]
  have hq : Function.Injective q := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · rfl
    · exact False.elim (hab (congrArg Subtype.val hij))
    · exact False.elim (hab (congrArg Subtype.val hij).symm)
    · rfl
  let B := actualNeighborBasis P hP hv hsimple
  have hli := B.linearIndependent.comp q hq
  change LinearIndependent ℝ (fun i : Fin 2 => B (q i)) at hli
  have hfun : (fun i : Fin 2 => B (q i)) = ![a-v,b-v] := by
    funext i
    fin_cases i <;> simp [B,q,aa,bb,actualNeighborBasis_apply]
  rwa [hfun] at hli

theorem cycle_in_plane_of_no_rigid_four
    (P : ConvexPolytope n) (T : Finset (E n))
    (hno_four : ∀ A : Finset (E n), A ⊆ T → A.card = 4 → ¬ RigidInTail P T A)
    {v a w b : E n} (hvT : v ∈ T) (haT : a ∈ T) (hwT : w ∈ T) (hbT : b ∈ T)
    (hva : GeneralVertexStep P v a) (hvb : GeneralVertexStep P v b)
    (haw : GeneralVertexStep P a w) (hbw : GeneralVertexStep P b w)
    (hvw : v ≠ w) (hab : a ≠ b)
    (hpair : LinearIndependent ℝ ![a-v,b-v]) :
    w-v ∈ Submodule.span ℝ (Set.range ![a-v,b-v]) := by
  let A : Finset (E n) := {v,a,w,b}
  have hAT : A ⊆ T := by
    intro z hz
    simp only [A,Finset.mem_insert,Finset.mem_singleton] at hz
    rcases hz with rfl | rfl | rfl | rfl <;> assumption
  have hAc : A.card = 4 := by
    have hva' := hva.2.1
    have hvb' := hvb.2.1
    have haw' := haw.2.1
    have hbw' := hbw.2.1
    simp [A,hva',hvb',hvw,hab,haw',hbw',Ne.symm hva',Ne.symm hvb',
      Ne.symm hvw,Ne.symm hab,Ne.symm haw',Ne.symm hbw']
  by_contra hwplane
  apply hno_four A hAT hAc
  intro f hf
  have hind := hpair.finCons hwplane
  have hhom := parallel_cycle_homothety f v a w b hind
    (hf v hvT a haT hva) (hf v hvT b hbT hvb)
    (hf a haT w hwT haw) (hf b hbT w hwT hbw)
  simpa only [A,Finset.mem_insert,Finset.mem_singleton,
    Set.mem_insert_iff,Set.mem_singleton_iff] using hhom

theorem flat_of_saturated_star
    (P : ConvexPolytope n) (hP : P.IsFullDim) (T : Finset (E n))
    (hTV : T ⊆ P.vertices)
    (v : E n) (hvT : v ∈ T)
    (hsimple : (actualNeighbors P v).card = n)
    (hno_four : ∀ A : Finset (E n), A ⊆ T → A.card = 4 → ¬ RigidInTail P T A)
    (hsaturated : ∀ w ∈ T, w ≠ v → ¬ GeneralVertexStep P v w →
      ∃ a ∈ T, ∃ b ∈ T, a ≠ b ∧
        GeneralVertexStep P v a ∧ GeneralVertexStep P v b ∧
        GeneralVertexStep P a w ∧ GeneralVertexStep P b w) :
    ∀ x ∈ T, x-v ∈ selectedSpan
      (actualNeighborBasis P hP (hTV hvT) hsimple) (internalIndices P T v) := by
  let B := actualNeighborBasis P hP (hTV hvT) hsimple
  let U := selectedSpan B (internalIndices P T v)
  have hneighbor {a : E n} (haT : a ∈ T) (hva : GeneralVertexStep P v a) :
      a-v ∈ U := by
    let aa : actualNeighbors P v := ⟨a,(mem_actualNeighbors_iff P v a).mpr hva⟩
    have haa : aa ∈ internalIndices P T v :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _,haT⟩
    have h : B aa ∈ U := Submodule.subset_span ⟨aa,haa,rfl⟩
    simpa only [B,actualNeighborBasis_apply,aa] using h
  intro x hxT
  by_cases hxv : x = v
  · subst x
    simpa only [sub_self] using Submodule.zero_mem U
  by_cases hvx : GeneralVertexStep P v x
  · exact hneighbor hxT hvx
  obtain ⟨a,haT,b,hbT,hab,hva,hvb,hax,hbx⟩ := hsaturated x hxT hxv hvx
  have hpair := pair_of_simple_neighbor_directions P hP (hTV hvT) hsimple hva hvb hab
  have hplane := cycle_in_plane_of_no_rigid_four P T hno_four
    hvT haT hxT hbT hva hvb hax hbx (Ne.symm hxv) hab hpair
  exact fourth_vertex_mem_larger_flat U (hneighbor haT hva) (hneighbor hbT hvb) hplane

theorem actual_four_face_of_saturated_tail
    (P : ConvexPolytope n) (hP : P.IsFullDim) (T : Finset (E n))
    (hTV : T ⊆ P.vertices)
    (hsimple : ∀ x ∈ T, (actualNeighbors P x).card = n)
    (hregular : ∀ x ∈ T, ((actualNeighbors P x).filter (· ∈ T)).card = 4)
    (v : E n) (hvT : v ∈ T)
    (hno_four : ∀ A : Finset (E n), A ⊆ T → A.card = 4 → ¬ RigidInTail P T A)
    (hsaturated : ∀ w ∈ T, w ≠ v → ¬ GeneralVertexStep P v w →
      ∃ a ∈ T, ∃ b ∈ T, a ≠ b ∧
        GeneralVertexStep P v a ∧ GeneralVertexStep P v b ∧
        GeneralVertexStep P a w ∧ GeneralVertexStep P b w) :
    ∃ F : Set (E n), ∃ hF : P.IsFace F,
      faceDim F = 4 ∧ (facePolytope P hF).vertices = T ∧
      ∀ x ∈ (facePolytope P hF).vertices,
        (actualNeighbors (facePolytope P hF) x).card = 4 := by
  apply regular_simple_tail_is_face P hP T hTV hsimple 4 hregular v hvT
    (internalIndices P T v)
  · rw [internalIndices_card,hregular v hvT]
  · exact flat_of_saturated_star P hP T hTV v hvT (hsimple v hvT) hno_four hsaturated

end Papers.PolytopeFourRegularTail

end
end
