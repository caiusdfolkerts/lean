@[expose] public section

/-!
# Rigidity gives the local tail degree bounds

The two counting hypotheses used by FourRegularTailCounts are consequences
of the absence of a rigid four-set.  They are proved using actual triangles
and actual K2,3 edge configurations, and hence require no drawing or graph
realizability certificate.
-/

noncomputable section
namespace Papers.PolytopeTailRigidity

open Set Module Finset
open Papers.PolytopeVertexCone Papers.PolytopeFourRegularTail
open Papers.PolytopeTailGraph Papers.NeighborhoodCounts Papers.ActualRigidity
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

theorem actual_four_face_of_ten_tail_without_rigid_four
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (T : Finset (E n)) (hTV : T ⊆ P.vertices) (hcard : T.card = 10)
    (hsimple : ∀ x ∈ T, (actualNeighbors P x).card = n)
    (hmin : ∀ x ∈ T, 4 ≤ ((actualNeighbors P x).filter (· ∈ T)).card)
    (hno : ∀ A : Finset (E n), A ⊆ T → A.card = 4 → ¬ RigidInTail P T A) :
    ∃ F : Set (E n), ∃ hF : P.IsFace F,
      faceDim F = 4 ∧ (facePolytope P hF).vertices = T ∧
      ∀ x ∈ (facePolytope P hF).vertices,
        (actualNeighbors (facePolytope P hF) x).card = 4 :=
  actual_four_face_of_ten_tail P hP T hTV hcard hsimple hmin hno
    (Papers.ActualRigidSeedLimits.common_neighbors_le_two_of_no_rigid_four P T hTV hno)
    (Papers.ActualRigidSeedLimits.neighbor_matchings_of_no_rigid_four P T hTV hno)

end Papers.PolytopeTailRigidity

end
end
