section BundlePart2
/- Source: Papers/FourCycleRigidity.lean -/








@[expose] public section

/-!
# Rigidity of a nonplanar four-cycle

The hypothesis is linear independence of the three affine difference
vectors.  The conclusion is a single actual homothety on all four
vertices.  Its contrapositive gives the plane containment used in the
four-regular residual graph.
-/

namespace Papers.FourCycle

open scoped BigOperators
variable {E : Type*} [AddCommGroup E] [Module ℝ E]

theorem parallel_cycle_homothety
    (value : E → E) (x a w b : E)
    (hind : LinearIndependent ℝ ![w - x, a - x, b - x])
    (ha : ∃ s : ℝ, value a - value x = s • (a - x))
    (hb : ∃ t : ℝ, value b - value x = t • (b - x))
    (hwa : ∃ u : ℝ, value w - value a = u • (w - a))
    (hwb : ∃ v : ℝ, value w - value b = v • (w - b)) :
    ∃ α : ℝ, ∃ c : E,
      ∀ z ∈ ({x, a, w, b} : Set E), value z = α • z + c := by
  obtain ⟨s, hs⟩ := ha
  obtain ⟨t, ht⟩ := hb
  obtain ⟨u, hu⟩ := hwa
  obtain ⟨v, hv⟩ := hwb
  have heq :
      (u - v) • (w - x) + (s - u) • (a - x) +
        (v - t) • (b - x) = 0 := by
    calc
      _ = s • (a - x) + u • (w - a) -
        (t • (b - x) + v • (w - b)) := by module
      _ = (value a - value x) + (value w - value a) -
        ((value b - value x) + (value w - value b)) := by
          rw [← hs, ← hu, ← ht, ← hv]
      _ = 0 := by abel
  have hc : ∀ i : Fin 3, ![u - v, s - u, v - t] i = 0 := by
    apply Fintype.linearIndependent_iff.mp hind
    simpa [Fin.sum_univ_succ, add_assoc] using heq
  have hsu : s = u := by have h := hc 1; simp at h; linarith
  have htu : t = u := by
    have h₀ := hc 0
    have h₂ := hc 2
    simp at h₀ h₂
    linarith
  subst s
  subst t
  refine ⟨u, value x - u • x, ?_⟩
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with hz | hz | hz | hz <;> subst z
  · module
  · calc
      value a = (value a - value x) + value x := by abel
      _ = u • (a - x) + value x := by rw [hs]
      _ = u • a + (value x - u • x) := by module
  · calc
      value w = (value w - value a) + (value a - value x) + value x := by abel
      _ = u • (w - a) + u • (a - x) + value x := by rw [hu, hs]
      _ = u • w + (value x - u • x) := by module
  · calc
      value b = (value b - value x) + value x := by abel
      _ = u • (b - x) + value x := by rw [ht]
      _ = u • b + (value x - u • x) := by module

theorem fourth_vertex_mem_plane_of_nonhomothetic_cycle
    (value : E → E) (x a w b : E)
    (hpair : LinearIndependent ℝ ![a - x, b - x])
    (ha : ∃ s : ℝ, value a - value x = s • (a - x))
    (hb : ∃ t : ℝ, value b - value x = t • (b - x))
    (hwa : ∃ u : ℝ, value w - value a = u • (w - a))
    (hwb : ∃ v : ℝ, value w - value b = v • (w - b))
    (hnontrivial : ¬ ∃ α : ℝ, ∃ c : E,
      ∀ z ∈ ({x, a, w, b} : Set E), value z = α • z + c) :
    w - x ∈ Submodule.span ℝ (Set.range ![a - x, b - x]) := by
  by_contra hn
  exact hnontrivial (parallel_cycle_homothety value x a w b
    (hpair.finCons hn) ha hb hwa hwb)

theorem fourth_vertex_mem_larger_flat
    (U : Submodule ℝ E) {x a w b : E}
    (ha : a - x ∈ U) (hb : b - x ∈ U)
    (hw : w - x ∈ Submodule.span ℝ (Set.range ![a - x, b - x])) :
    w - x ∈ U := by
  apply Submodule.span_le.mpr ?_ hw
  rintro y ⟨i, rfl⟩
  fin_cases i <;> simp_all

end Papers.FourCycle

end
