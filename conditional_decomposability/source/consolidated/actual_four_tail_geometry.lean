section BundlePart1
/- Source: Papers/PolytopeSimpleTailFace.lean -/





@[expose] public section

/-!
# A regular tail of simple vertices is an actual face

A finite set T of simple vertices has r neighbors inside T at each vertex.
If T lies in the flat generated by r actual incident edge directions at
one of its vertices, then T is exactly the vertex set of an actual
r-dimensional face.  The face polytope is simple in its intrinsic
dimension.  This supplies the geometric extraction in the four-regular
ten-vertex tail argument.
-/

noncomputable section
namespace Papers.PolytopeSimpleTailFace

open Set Module
open Papers.PolytopeVertexCone Papers.PolytopeSimpleCorners
open Papers.PolytopeBalinski Papers.SimpleCornerFaces
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

def internalIndices (P : ConvexPolytope n) (T : Finset (E n)) (x : E n) :
    Finset (actualNeighbors P x) :=
  Finset.univ.filter fun y => y.val ∈ T

theorem internalIndices_card (P : ConvexPolytope n) (T : Finset (E n)) (x : E n) :
    (internalIndices P T x).card = ((actualNeighbors P x).filter (· ∈ T)).card := by
  let e : internalIndices P T x ≃ ((actualNeighbors P x).filter (· ∈ T)) := {
    toFun y := ⟨y.val.val,Finset.mem_filter.mpr
      ⟨y.val.property,(Finset.mem_filter.mp y.property).2⟩⟩
    invFun y := ⟨⟨y.val,(Finset.mem_filter.mp y.property).1⟩,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _,(Finset.mem_filter.mp y.property).2⟩⟩
    left_inv y := rfl
    right_inv y := rfl }
  simpa using Fintype.card_congr e

theorem facePolytope_vertex_iff
    (P : ConvexPolytope n) {F : Set (E n)} (hF : P.IsFace F) (x : E n) :
    x ∈ (facePolytope P hF).vertices ↔ x ∈ P.vertices ∧ x ∈ F := by
  change x ∈ P.vertices.filter (· ∈ F) ↔ _
  exact Finset.mem_filter

theorem facePolytope_step
    (P : ConvexPolytope n) {F : Set (E n)} (hF : P.IsFace F)
    {x y : E n} (hxy : GeneralVertexStep (facePolytope P hF) x y) :
    GeneralVertexStep P x y := by
  obtain ⟨hy,hne,G,hG,hdim,hxG,hyG⟩ := hxy
  exact ⟨((facePolytope_vertex_iff P hF y).mp hy).1,hne,G,
    isFace_of_facePolytope P hF hG,hdim,hxG,hyG⟩

theorem intrinsic_dim_le_neighbor_card
    (P : ConvexPolytope n) {x : E n} (hx : x ∈ P.vertices) :
    P.dim ≤ (actualNeighbors P x).card := by
  have h := finrank_range_le_card (R := ℝ)
    (fun y : actualNeighbors P x => y.val - x)
  change finrank ℝ (Submodule.span ℝ
    (Set.range (fun y : actualNeighbors P x => y.val - x))) ≤
      Fintype.card (actualNeighbors P x) at h
  rw [← neighborSpan_eq_range_span P x,neighborSpan_eq_vectorSpan P hx] at h
  simpa only [Fintype.card_coe,ConvexPolytope.dim] using h

theorem regular_simple_tail_is_face
    (P : ConvexPolytope n) (hP : P.IsFullDim) (T : Finset (E n))
    (hTV : T ⊆ P.vertices)
    (hsimple : ∀ x ∈ T, (actualNeighbors P x).card = n)
    (r : ℕ) (hregular : ∀ x ∈ T, ((actualNeighbors P x).filter (· ∈ T)).card = r)
    (v : E n) (hvT : v ∈ T)
    (S : Finset (actualNeighbors P v)) (hScard : S.card = r)
    (hflat : ∀ x ∈ T,
      x - v ∈ selectedSpan (actualNeighborBasis P hP (hTV hvT) (hsimple v hvT)) S) :
    ∃ F : Set (E n), ∃ hF : P.IsFace F,
      faceDim F = r ∧ (facePolytope P hF).vertices = T ∧
      ∀ x ∈ (facePolytope P hF).vertices,
        (actualNeighbors (facePolytope P hF) x).card = r := by
  let F := simpleCorner P hP (hTV hvT) (hsimple v hvT) S
  obtain ⟨hF,hFdim,hFspan⟩ :=
    simpleCorner_spec P hP (hTV hvT) (hsimple v hvT) S
  have hFdim : faceDim F = r := hFdim.trans hScard
  let R := facePolytope P hF
  have hTF : ∀ x ∈ T, x ∈ F := by
    intro x hx
    exact ⟨subset_convexHull ℝ _ (hTV hx),hflat x hx⟩
  have hTR : T ⊆ R.vertices := by
    intro x hx
    exact (facePolytope_vertex_iff P hF x).mpr ⟨hTV hx,hTF x hx⟩
  have hclosed : ∀ x ∈ T, ∀ y,
      GeneralVertexStep R x y → y ∈ T := by
    intro x hxT y hxyR
    have hxyP := facePolytope_step P hF hxyR
    have hxP : x ∈ P.vertices := hTV hxT
    have hxsimple : (actualNeighbors P x).card = P.dim := by
      rw [hP]
      exact hsimple x hxT
    have hli := neighbor_directions_independent_of_card_eq_dim P hxP hxsimple
    have hcard : (internalIndices P T x).card =
        finrank ℝ (vectorSpan ℝ F) := by
      rw [internalIndices_card,hregular x hxT]
      exact hFdim.symm
    have hinside : ∀ i ∈ internalIndices P T x, i.val - x ∈ vectorSpan ℝ F := by
      intro i hi
      have hiT := (Finset.mem_filter.mp hi).2
      exact vsub_mem_vectorSpan ℝ (hTF i.val hiT) (hTF x hxT)
    let yy : actualNeighbors P x :=
      ⟨y,(mem_actualNeighbors_iff P x y).mpr hxyP⟩
    have hyF : y ∈ F :=
      ((facePolytope_vertex_iff P hF y).mp hxyR.1).2
    have hyspan : yy.val - x ∈ vectorSpan ℝ F :=
      vsub_mem_vectorSpan ℝ hyF (hTF x hxT)
    have hymem := Papers.FaceSaturation.index_mem_of_saturated_direction_space
      (fun i : actualNeighbors P x => i.val - x) hli (vectorSpan ℝ F)
      (internalIndices P T x) hinside hcard hyspan
    exact (Finset.mem_filter.mp hymem).2
  let U : Set R.vertices := {x | x.val ∈ T}
  have hUn : U.Nonempty := ⟨⟨v,hTR hvT⟩,hvT⟩
  have hUclosed : ∀ x ∈ U, ∀ y, (vertexGraph R).Adj x y → y ∈ U := by
    intro x hx y hxy
    exact hclosed x.val hx y.val hxy
  have hU : U = Set.univ :=
    Papers.FaceSaturation.closed_nonempty_subset_eq_univ (vertexGraph R)
      (vertexGraph_connected R) U hUn hUclosed
  have hRvertices : R.vertices = T := by
    apply Finset.Subset.antisymm
    · intro x hx
      have h : (⟨x,hx⟩ : R.vertices) ∈ U := by rw [hU]; trivial
      exact h
    · exact hTR
  have hRdim : R.dim = r := by
    change finrank ℝ (vectorSpan ℝ R.toSet) = r
    rw [facePolytope_toSet P hF]
    exact hFdim
  refine ⟨F,hF,hFdim,hRvertices,?_⟩
  intro x hxR
  have hxT : x ∈ T := by rw [← hRvertices]; exact hxR
  have hneighbors :
      actualNeighbors R x ⊆ (actualNeighbors P x).filter (· ∈ T) := by
    intro y hy
    have hxy := (mem_actualNeighbors_iff R x y).mp hy
    have hyT : y ∈ T := by rw [← hRvertices]; exact hxy.1
    exact Finset.mem_filter.mpr
      ⟨(mem_actualNeighbors_iff P x y).mpr (facePolytope_step P hF hxy),hyT⟩
  have hupper := Finset.card_le_card hneighbors
  rw [hregular x hxT] at hupper
  have hlower := intrinsic_dim_le_neighbor_card R hxR
  rw [hRdim] at hlower
  exact le_antisymm hupper hlower

end Papers.PolytopeSimpleTailFace

end
end
