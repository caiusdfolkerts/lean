section BundlePart4
/- Source: Papers/PolytopeTailGraph.lean -/




@[expose] public section

/-!
# The actual ten-vertex tail graph

This file joins the finite graph count to the geometric face extraction.
Every graph vertex is a member of the actual tail and every adjacency is
an actual edge of the original polytope.  The final face has exactly the
tail vertices and is simple in intrinsic dimension four.
-/

noncomputable section
namespace Papers.PolytopeTailGraph

open Set Module Finset
open Papers.PolytopeVertexCone Papers.PolytopeSimpleTailFace
open Papers.PolytopeFourRegularTail Papers.NeighborhoodCounts
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped BigOperators Classical

variable {n : ℕ}

def tailGraph (P : ConvexPolytope n) (T : Finset (E n)) (hTV : T ⊆ P.vertices) :
    SimpleGraph T where
  Adj x y := GeneralVertexStep P x.val y.val
  symm := ⟨by
    rintro x y ⟨hy,hxy,F,hF,hFd,hxF,hyF⟩
    exact ⟨hTV x.property,hxy.symm,F,hF,hFd,hyF,hxF⟩⟩
  loopless := ⟨by
    intro x hx
    exact hx.2.1 rfl⟩

def tailNeighborEquiv
    (P : ConvexPolytope n) (T : Finset (E n)) (hTV : T ⊆ P.vertices) (x : T) :
    (tailGraph P T hTV).neighborSet x ≃
      ((actualNeighbors P x.val).filter (· ∈ T)) where
  toFun y := ⟨y.val.val,Finset.mem_filter.mpr
    ⟨(mem_actualNeighbors_iff P x.val y.val.val).mpr y.property,y.val.property⟩⟩
  invFun y := ⟨⟨y.val,(Finset.mem_filter.mp y.property).2⟩,
    (mem_actualNeighbors_iff P x.val y.val).mp
      (Finset.mem_filter.mp y.property).1⟩
  left_inv y := rfl
  right_inv y := rfl

theorem tail_degree_eq
    (P : ConvexPolytope n) (T : Finset (E n)) (hTV : T ⊆ P.vertices) (x : T) :
    (tailGraph P T hTV).degree x =
      ((actualNeighbors P x.val).filter (· ∈ T)).card := by
  have h := Fintype.card_congr (tailNeighborEquiv P T hTV x)
  simpa only [SimpleGraph.card_neighborSet_eq_degree,Fintype.card_coe] using h

theorem saturated_common_neighbors
    (P : ConvexPolytope n) (T : Finset (E n)) (hTV : T ⊆ P.vertices)
    (v : T)
    (hstar : ∀ w ∈ outsideStar (tailGraph P T hTV) v,
      localDegree (tailGraph P T hTV)
        ((tailGraph P T hTV).neighborFinset v) w = 2) :
    ∀ w ∈ T, w ≠ v.val → ¬ GeneralVertexStep P v.val w →
      ∃ a ∈ T, ∃ b ∈ T, a ≠ b ∧
        GeneralVertexStep P v.val a ∧ GeneralVertexStep P v.val b ∧
        GeneralVertexStep P a w ∧ GeneralVertexStep P b w := by
  intro w hwT hwv hnot
  let ww : T := ⟨w,hwT⟩
  let G := tailGraph P T hTV
  have hwv' : ww ≠ v := fun h => hwv (congrArg Subtype.val h)
  have hwstar : ww ∈ outsideStar G v := by
    simp only [outsideStar,Finset.mem_sdiff,Finset.mem_univ,Finset.mem_insert,
      SimpleGraph.mem_neighborFinset,true_and,not_or]
    exact ⟨hwv',hnot⟩
  have hc : ((G.neighborFinset v).filter (G.Adj ww)).card = 2 :=
    hstar ww hwstar
  obtain ⟨a,ha,b,hb,hab⟩ := Finset.one_lt_card.mp (by omega :
    1 < ((G.neighborFinset v).filter (G.Adj ww)).card)
  obtain ⟨haN,hwa⟩ := Finset.mem_filter.mp ha
  obtain ⟨hbN,hwb⟩ := Finset.mem_filter.mp hb
  refine ⟨a.val,a.property,b.val,b.property,?_,
    (G.mem_neighborFinset _ _).mp haN,(G.mem_neighborFinset _ _).mp hbN,
    Papers.Polytopes.actualStep_symm (hTV ww.property) hwa,
    Papers.Polytopes.actualStep_symm (hTV ww.property) hwb⟩
  intro heq
  exact hab (Subtype.ext heq)

theorem actual_four_face_of_ten_tail
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (T : Finset (E n)) (hTV : T ⊆ P.vertices) (hcard : T.card = 10)
    (hsimple : ∀ x ∈ T, (actualNeighbors P x).card = n)
    (hmin : ∀ x ∈ T, 4 ≤ ((actualNeighbors P x).filter (· ∈ T)).card)
    (hno_four : ∀ A : Finset (E n), A ⊆ T → A.card = 4 → ¬ RigidInTail P T A)
    (hcap : ∀ v w : T, w ∈ outsideStar (tailGraph P T hTV) v →
      localDegree (tailGraph P T hTV)
        ((tailGraph P T hTV).neighborFinset v) w ≤ 2)
    (hmatch : ∀ v w : T, w ∈ (tailGraph P T hTV).neighborFinset v →
      localDegree (tailGraph P T hTV)
        ((tailGraph P T hTV).neighborFinset v) w ≤ 1) :
    ∃ F : Set (E n), ∃ hF : P.IsFace F,
      faceDim F = 4 ∧ (facePolytope P hF).vertices = T ∧
      ∀ x ∈ (facePolytope P hF).vertices,
        (actualNeighbors (facePolytope P hF) x).card = 4 := by
  let G := tailGraph P T hTV
  have hc : Fintype.card T = 10 := by simpa using hcard
  have hTne : T.Nonempty := Finset.card_pos.mp (by omega)
  letI : Nonempty T := ⟨⟨hTne.choose,hTne.choose_spec⟩⟩
  have hGmin : ∀ v : T, 4 ≤ G.degree v := by
    intro v
    rw [tail_degree_eq]
    exact hmin v.val v.property
  have hreg : ∀ v : T, G.degree v = 4 :=
    (Papers.FourRegularTail.regularity_and_order G (by omega) hGmin hcap hmatch).2
  obtain ⟨v,_hv,hstar⟩ :=
    Papers.FourRegularTail.ten_vertex_star_saturated G hc hreg hcap hmatch
  have hregular : ∀ x ∈ T, ((actualNeighbors P x).filter (· ∈ T)).card = 4 := by
    intro x hx
    simpa only [G,tail_degree_eq] using hreg (⟨x,hx⟩ : T)
  exact actual_four_face_of_saturated_tail P hP T hTV hsimple hregular
    v.val v.property hno_four (saturated_common_neighbors P T hTV v hstar)

end Papers.PolytopeTailGraph

end
end
end BundlePart4

section BundlePart5
