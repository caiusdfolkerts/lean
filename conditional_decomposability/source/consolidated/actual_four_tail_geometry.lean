section BundlePart0
/- Source: Papers/PolytopeSimpleCorners.lean -/



@[expose] public section

/-!
# Faces selected by incident edges at a simple vertex

Every subset of the actual incident edges at a simple vertex determines
a genuine exposed face.  Its affine dimension is the cardinality of the
selected subset.  This is the geometric step used for the four-regular
tail in the conditional-decomposability proof.
-/

noncomputable section
namespace Papers.PolytopeSimpleCorners

open Set Module
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.PolytopeVertexCone Papers.SimpleCornerFaces Papers.MinkowskiFaces
open scoped Classical

variable {n : ℕ}

def simpleCorner (P : ConvexPolytope n) (hfull : P.IsFullDim)
    {v : E n} (hv : v ∈ P.vertices)
    (hsimple : (actualNeighbors P v).card = n)
    (S : Finset (actualNeighbors P v)) : Set (E n) :=
  {x ∈ P.toSet |
    x - v ∈ selectedSpan (actualNeighborBasis P hfull hv hsimple) S}

theorem simpleCorner_spec (P : ConvexPolytope n) (hfull : P.IsFullDim)
    {v : E n} (hv : v ∈ P.vertices)
    (hsimple : (actualNeighbors P v).card = n)
    (S : Finset (actualNeighbors P v)) :
    P.IsFace (simpleCorner P hfull hv hsimple S) ∧
    faceDim (simpleCorner P hfull hv hsimple S) = S.card ∧
    vectorSpan ℝ (simpleCorner P hfull hv hsimple S) =
      selectedSpan (actualNeighborBasis P hfull hv hsimple) S := by
  let b := actualNeighborBasis P hfull hv hsimple
  have hvT : v ∈ P.toSet := subset_convexHull ℝ _ hv
  have hcone : ∀ x ∈ P.toSet, ∀ i, 0 ≤ b.repr (x-v) i :=
    fun x hx i => actualNeighborBasis_coordinates_nonnegative P hfull hv hsimple hx i
  have hneighbors : ∀ i ∈ S, v + b i ∈ P.toSet := by
    intro i hi
    have hstep := (mem_actualNeighbors_iff P v (i : E n)).mp i.2
    have hiT : (i : E n) ∈ P.toSet := subset_convexHull ℝ _ hstep.1
    change v + actualNeighborBasis P hfull hv hsimple i ∈ P.toSet
    rw [actualNeighborBasis_apply]
    convert hiT using 1 <;> abel
  obtain ⟨u, heq, hspan, hdim⟩ :=
    exposed_corner_of_basis_cone b S P.toSet v hvT hcone hneighbors
  have hface : P.IsFace (simpleCorner P hfull hv hsimple S) := by
    refine ⟨?_,⟨v,hvT,by simp⟩⟩
    intro _
    refine ⟨u.toContinuousLinearMap,?_⟩
    exact heq.symm
  refine ⟨hface,?_,?_⟩
  · change finrank ℝ (vectorSpan ℝ
      {x ∈ P.toSet | x-v ∈ selectedSpan b S}) = S.card
    rw [← heq]
    exact hdim
  · change vectorSpan ℝ {x ∈ P.toSet | x-v ∈ selectedSpan b S} =
      selectedSpan b S
    rw [← heq]
    exact hspan

theorem simpleCorner_contains_vertex (P : ConvexPolytope n) (hfull : P.IsFullDim)
    {v : E n} (hv : v ∈ P.vertices)
    (hsimple : (actualNeighbors P v).card = n)
    (S : Finset (actualNeighbors P v)) :
    v ∈ simpleCorner P hfull hv hsimple S :=
  ⟨subset_convexHull ℝ _ hv,by simp⟩

theorem simpleCorner_contains_selected_neighbor
    (P : ConvexPolytope n) (hfull : P.IsFullDim)
    {v : E n} (hv : v ∈ P.vertices)
    (hsimple : (actualNeighbors P v).card = n)
    (S : Finset (actualNeighbors P v))
    (i : actualNeighbors P v) (hi : i ∈ S) :
    (i : E n) ∈ simpleCorner P hfull hv hsimple S := by
  have hstep := (mem_actualNeighbors_iff P v (i : E n)).mp i.2
  refine ⟨subset_convexHull ℝ _ hstep.1,?_⟩
  rw [← actualNeighborBasis_apply P hfull hv hsimple i]
  exact Submodule.subset_span ⟨i,hi,rfl⟩

end Papers.PolytopeSimpleCorners

end
end
