section BundlePart11
/- Source: Papers/ParallelPerturbation.lean -/



@[expose] public section

/-!
# Small positive perturbations of parallel maps

A finite bound on all edge multipliers produces two positive parallel maps.
The supporting-functional argument then gives actual convex summands.
-/

noncomputable section
namespace Papers.Polytopes
open Set
open scoped Pointwise Classical
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope

variable {d : ℕ}

theorem exists_positive_parallel_split (P : ConvexPolytope d) (f : E d → E d)
    (hf : IsParallelMap P f) :
    ∃ ε : ℝ, 0 < ε ∧
      IsPositiveParallelMap P (fun v => (1 / 2 : ℝ) • v + ε • f v) ∧
      IsPositiveParallelMap P (fun v => (1 / 2 : ℝ) • v - ε • f v) := by
  have hex : ∀ x y : E d, ∃ c : ℝ, x ∈ P.vertices → y ∈ P.vertices →
      GeneralVertexStep P x y → f y - f x = c • (y - x) := by
    intro x y
    by_cases h : x ∈ P.vertices ∧ y ∈ P.vertices ∧ GeneralVertexStep P x y
    · obtain ⟨c, hc⟩ := hf x h.1 y h.2.1 h.2.2
      exact ⟨c, fun _ _ _ => hc⟩
    · exact ⟨0, fun hx hy hxy => (h ⟨hx, hy, hxy⟩).elim⟩
  choose c hc using hex
  let S : ℝ := ∑ x ∈ P.vertices, ∑ y ∈ P.vertices, |c x y|
  let M : ℝ := 1 + S
  have hS : 0 ≤ S := by
    exact Finset.sum_nonneg (fun x _ => Finset.sum_nonneg (fun y _ => abs_nonneg (c x y)))
  have hM : 0 < M := by dsimp [M]; linarith
  have hcBound : ∀ x ∈ P.vertices, ∀ y ∈ P.vertices, |c x y| < M := by
    intro x hx y hy
    have hrow : |c x y| ≤ ∑ z ∈ P.vertices, |c x z| :=
      Finset.single_le_sum (fun z _ => abs_nonneg (c x z)) hy
    have hall : (∑ z ∈ P.vertices, |c x z|) ≤ S := by
      exact Finset.single_le_sum
        (fun w _ => Finset.sum_nonneg (fun z _ => abs_nonneg (c w z))) hx
    dsimp [M]
    linarith
  let ε : ℝ := (2 * M)⁻¹
  have hε : 0 < ε := inv_pos.mpr (mul_pos (by norm_num) hM)
  have hεM : ε * M = (1 / 2 : ℝ) := by
    dsimp [ε]
    field_simp [hM.ne']
  have hcoeff : ∀ x ∈ P.vertices, ∀ y ∈ P.vertices,
      0 < (1 / 2 : ℝ) + ε * c x y ∧ 0 < (1 / 2 : ℝ) - ε * c x y := by
    intro x hx y hy
    have hcb := hcBound x hx y hy
    have hupper : c x y < M := lt_of_le_of_lt (le_abs_self _) hcb
    have hlower : -M < c x y := by
      have := neg_abs_le (c x y)
      linarith
    have h1 := mul_lt_mul_of_pos_left hupper hε
    have h2 := mul_lt_mul_of_pos_left hlower hε
    rw [mul_neg] at h2
    rw [hεM] at h1 h2
    constructor <;> linarith
  refine ⟨ε, hε, ?_, ?_⟩
  · intro x hx y hy hxy
    refine ⟨(1 / 2 : ℝ) + ε * c x y, (hcoeff x hx y hy).1, ?_⟩
    calc
      _ = (1 / 2 : ℝ) • (y - x) + ε • (f y - f x) := by module
      _ = _ := by rw [hc x y hx hy hxy]; module
  · intro x hx y hy hxy
    refine ⟨(1 / 2 : ℝ) - ε * c x y, (hcoeff x hx y hy).2, ?_⟩
    calc
      _ = (1 / 2 : ℝ) • (y - x) - ε • (f y - f x) := by module
      _ = _ := by rw [hc x y hx hy hxy]; module

theorem homothety_of_positive_perturbation (P : ConvexPolytope d) (f : E d → E d)
    {ε : ℝ} (hε : ε ≠ 0)
    (h : IsHomothetyOnVertices P (fun v => (1 / 2 : ℝ) • v + ε • f v)) :
    IsHomothetyOnVertices P f := by
  obtain ⟨a, b, hab⟩ := h
  refine ⟨ε⁻¹ * (a - 1 / 2), ε⁻¹ • b, ?_⟩
  intro v hv
  have heq : ε • f v = (a - 1 / 2) • v + b := by
    have h := hab v hv
    change (1 / 2 : ℝ) • v + ε • f v = a • v + b at h
    calc
      ε • f v = (a • v + b) - (1 / 2 : ℝ) • v := by rw [← h]; abel
      _ = _ := by module
  calc
    f v = ε⁻¹ • (ε • f v) := by simp [hε]
    _ = _ := by rw [heq]; module

theorem homothety_of_negative_perturbation (P : ConvexPolytope d) (f : E d → E d)
    {ε : ℝ} (hε : ε ≠ 0)
    (h : IsHomothetyOnVertices P (fun v => (1 / 2 : ℝ) • v - ε • f v)) :
    IsHomothetyOnVertices P f := by
  obtain ⟨a, b, hab⟩ := h
  refine ⟨ε⁻¹ * (1 / 2 - a), -(ε⁻¹ • b), ?_⟩
  intro v hv
  have heq : ε • f v = (1 / 2 - a) • v - b := by
    have h := hab v hv
    change (1 / 2 : ℝ) • v - ε • f v = a • v + b at h
    calc
      ε • f v = (1 / 2 : ℝ) • v - (a • v + b) := by rw [← h]; abel
      _ = _ := by module
  calc
    f v = ε⁻¹ • (ε • f v) := by simp [hε]
    _ = _ := by rw [heq]; module

/-- Kallay's parallel-map criterion, for actual convex polytopes in any
ambient dimension and with arbitrary-dimensional summands. -/
theorem minkowski_decomposable_iff_parallel_map (P : ConvexPolytope d) :
    MinkowskiDecomposable P ↔
      ∃ f : E d → E d, IsParallelMap P f ∧ ¬IsHomothetyOnVertices P f := by
  constructor
  · exact parallel_map_of_minkowski_decomposable P
  · rintro ⟨f, hf, hnontrivial⟩
    obtain ⟨ε, hε, hplus, hminus⟩ := exists_positive_parallel_split P f hf
    let q : E d → E d := fun v => (1 / 2 : ℝ) • v + ε • f v
    let r : E d → E d := fun v => (1 / 2 : ℝ) • v - ε • f v
    refine ⟨positiveMapPolytope P q hplus, positiveMapPolytope P r hminus,
      positive_parallel_sum_eq P q r hplus hminus (by intro v _; dsimp [q, r]; module),
      ?_, ?_⟩
    · intro hcopy
      apply hnontrivial
      exact homothety_of_positive_perturbation P f hε.ne'
        (positiveMap_homothetic_on_vertices P q hplus hcopy)
    · intro hcopy
      apply hnontrivial
      exact homothety_of_negative_perturbation P f hε.ne'
        (positiveMap_homothetic_on_vertices P r hminus hcopy)

end Papers.Polytopes

end
end
end BundlePart11

section BundlePart12
/- Source: Papers/DenseParallelRigidity.lean -/





@[expose] public section

/-!
# Dense geometric graphs are parallel rigid

This is the rigidity half of Lemma 2 of the conditional-decomposability paper.
The graph may be any graph on distinct actual vertices of a polytope. Its
parallel maps are arbitrary maps on the labels; extension to the ambient
space is proved by `Function.extend`, rather than assumed.
-/

noncomputable section
namespace Papers.Polytopes
open Set
open scoped Classical
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope

variable {d : ℕ} {V : Type*} [Fintype V] [DecidableEq V]

theorem dense_graph_parallel_rigid (P : ConvexPolytope d) (G : SimpleGraph V)
    (p : V → E d) (hp : Function.Injective p) (hvertices : ∀ i, p i ∈ P.vertices)
    {k : ℕ} (hdegree : ∀ v, k ≤ G.degree v) (hdense : Fintype.card V < 2 * k)
    (f : V → E d)
    (hparallel : ∀ i j, G.Adj i j → ∃ c : ℝ, f j - f i = c • (p j - p i)) :
    ∃ a : ℝ, ∃ b : E d, ∀ i, f i = a • p i + b := by
  classical
  let g : E d → E d := Function.extend p f (fun _ => 0)
  have hgf (i : V) : g (p i) = f i := hp.extend_apply f (fun _ => 0) i
  let R : Finset V → Prop := fun S => ∃ a : ℝ, ∃ b : E d,
    ∀ i ∈ S, f i = a • p i + b
  have hempty : R ∅ := ⟨0, 0, by intro i hi; simp at hi⟩
  have htriangle : ∀ u v w, G.Adj u v → G.Adj u w → G.Adj v w → R {u, v, w} := by
    intro u v w huv huw hvw
    obtain ⟨a, ha⟩ := hparallel u v huv
    let b : E d := f u - a • p u
    have hfu : f u = a • p u + b := by dsimp [b]; abel
    have hfv : f v = a • p v + b := by
      calc
        f v = (f v - f u) + f u := by abel
        _ = _ := by rw [ha]; dsimp [b]; module
    have hfw : f w = a • p w + b := by
      have h := homothety_at_two_neighbors P g (hvertices u) (hvertices w) (hvertices v)
        (hp.ne (G.ne_of_adj huv)) (hp.ne (G.ne_of_adj huw).symm)
        (hp.ne (G.ne_of_adj hvw).symm)
        (by simpa only [hgf] using hfu) (by simpa only [hgf] using hfv)
        (by simpa only [hgf] using hparallel u w huw)
        (by simpa only [hgf] using hparallel v w hvw)
