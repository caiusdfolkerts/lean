/- Source: Papers/LinearImageFibers.lean -/






@[expose] public section

/-!
# Actual vertex fibers of a linear image

The quotient is represented by an ordinary finite image polytope.
Each of its actual vertices exposes a genuine face of the original
polytope.  The exposing functional factors through the linear map,
and the fiber's actual vertex set is exactly the corresponding finite
preimage.  Full dimension gives the rank-nullity count for the number
of disjoint fibers.
-/

noncomputable section
namespace Papers.LinearImageFibers

open Set Module AffineSubspace
open Papers.FiniteHullPolytope Papers.ParallelFaceDirections
open Papers.ParallelSupportEvaluation Papers.PolytopeFourRegularTail
open Papers.FaceVertexCardinality Papers.PolytopeSimpleTailFace
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical BigOperators

variable {n : ℕ}

theorem linear_imagePolytope_toSet
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n) :
    (imagePolytope P π).toSet = π '' P.toSet := by
  rw [imagePolytope_toSet]
  exact (π.toLinearMap.image_convexHull (P.vertices : Set (E n))).symm

theorem image_vertex_has_vertex_preimage
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) :
    ∃ x ∈ P.vertices, π x = q.val := by
  have hq : q.val ∈ Set.extremePoints ℝ (imagePolytope P π).toSet := by
    change q.val ∈ Set.extremePoints ℝ (convexHull ℝ ((imagePolytope P π).vertices : Set (E n)))
    rw [← (imagePolytope P π).vertices_eq_extremePoints]
    exact q.property
  rw [imagePolytope_toSet] at hq
  have hmem : q.val ∈ π '' (P.vertices : Set (E n)) := extremePoints_convexHull_subset hq
  exact hmem

theorem vertex_fiber_exposed
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) :
    ∃ w : E n →L[ℝ] ℝ,
      (∀ z, π z = 0 → w z = 0) ∧
      Papers.MinkowskiFaces.maxFace P.toSet w.toLinearMap =
        {x ∈ P.toSet | π x = q.val} := by
  let Q := imagePolytope P π
  obtain ⟨u,hu⟩ := (vertex_isFace Q q.property).1 (Set.singleton_nonempty q.val)
  have hqmax : q.val ∈ {z ∈ Q.toSet | ∀ a ∈ Q.toSet, u a ≤ u z} := by
    rw [← hu]
    exact Set.mem_singleton q.val
  let w : E n →L[ℝ] ℝ := u.comp π
  refine ⟨w,?_,?_⟩
  · intro z hz
    change u (π z) = 0
    rw [hz,map_zero]
  · ext x
    constructor
    · intro hx
      refine ⟨hx.1,?_⟩
      have hxQ : π x ∈ Q.toSet := by
        rw [linear_imagePolytope_toSet]
        exact ⟨x,hx.1,rfl⟩
      have hxmax : ∀ z ∈ Q.toSet, u z ≤ u (π x) := by
        intro z hz
        rw [linear_imagePolytope_toSet] at hz
        obtain ⟨y,hy,rfl⟩ := hz
        exact hx.2 y hy
      have hxsingle : π x ∈ ({q.val} : Set (E n)) := by
        rw [hu]
        exact ⟨hxQ,hxmax⟩
      exact Set.mem_singleton_iff.mp hxsingle
    · rintro ⟨hx,hπx⟩
      refine ⟨hx,?_⟩
      intro y hy
      change u (π y) ≤ u (π x)
      rw [hπx]
      apply hqmax.2
      rw [linear_imagePolytope_toSet]
      exact ⟨y,hy,rfl⟩

def fiberFunctional
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) : E n →L[ℝ] ℝ :=
  (vertex_fiber_exposed P π q).choose

theorem fiberFunctional_kernel
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) :
    ∀ z, π z = 0 → fiberFunctional P π q z = 0 :=
  (vertex_fiber_exposed P π q).choose_spec.1

theorem fiberFunctional_face
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) :
    Papers.MinkowskiFaces.maxFace P.toSet (fiberFunctional P π q).toLinearMap =
      {x ∈ P.toSet | π x = q.val} :=
  (vertex_fiber_exposed P π q).choose_spec.2

def vertexFiber
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) : ConvexPolytope n :=
  facePolytope P (maxFace_isFace P (fiberFunctional P π q))

theorem vertexFiber_vertices
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n)
    (q : (imagePolytope P π).vertices) :
    (vertexFiber P π q).vertices = P.vertices.filter (fun x => π x = q.val) := by
  ext x
  rw [vertexFiber,facePolytope_vertex_iff,fiberFunctional_face]
  simp only [Set.mem_setOf_eq,Finset.mem_filter]
  constructor
  · rintro ⟨hx,hxP,hπx⟩
    exact ⟨hx,hπx⟩
  · rintro ⟨hx,hπx⟩
    exact ⟨hx,subset_convexHull ℝ _ hx,hπx⟩

theorem vertexFiber_direction_eq_kernel
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (π : E n →L[ℝ] E n)
    (himage : vectorSpan ℝ (f '' (P.vertices : Set (E n))) = π.ker)
    (hvalues : ∀ x ∈ P.vertices, π (f x) = 0)
    (q : (imagePolytope P π).vertices) :
    vectorSpan ℝ (vertexFiber P π q).toSet = π.ker := by
  rw [vertexFiber,facePolytope_toSet]
  apply annihilator_fiber_direction_eq_kernel P f hf π himage
    (fiberFunctional P π q)
    (fun x hx => fiberFunctional_kernel P π q (f x) (hvalues x hx)) q.val
  intro x hx
  rw [fiberFunctional_face] at hx
  exact hx.2

theorem vertexFiber_dim_eq
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (π : E n →L[ℝ] E n)
    (himage : vectorSpan ℝ (f '' (P.vertices : Set (E n))) = π.ker)
    (hvalues : ∀ x ∈ P.vertices, π (f x) = 0)
    (q : (imagePolytope P π).vertices) :
    (vertexFiber P π q).dim = finrank ℝ π.ker := by
  change finrank ℝ (vectorSpan ℝ (vertexFiber P π q).toSet) = _
  rw [vertexFiber_direction_eq_kernel P f hf π himage hvalues]

theorem image_dim_add_kernel_dim
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (π : E n →L[ℝ] E n) :
    (imagePolytope P π).dim + finrank ℝ π.ker = n := by
  have htop : vectorSpan ℝ P.toSet = ⊤ := by
    apply Submodule.eq_of_le_of_finrank_eq le_top
    rw [finrank_top]
    change finrank ℝ (vectorSpan ℝ P.toSet)=finrank ℝ (E n)
    simpa only [finrank_euclideanSpace_fin] using (show finrank ℝ (vectorSpan ℝ P.toSet)=n from hP)
  have hvec : vectorSpan ℝ (imagePolytope P π).toSet = π.range := by
    rw [linear_imagePolytope_toSet]
    change vectorSpan ℝ (π.toLinearMap.toAffineMap '' P.toSet)=π.range
    rw [← AffineMap.map_vectorSpan π.toLinearMap.toAffineMap,htop,Submodule.map_top]
    rfl
  have hrank := π.toLinearMap.finrank_range_add_finrank_ker
  change finrank ℝ (vectorSpan ℝ (imagePolytope P π).toSet) + finrank ℝ π.ker = _
  rw [hvec]
  simpa only [finrank_euclideanSpace_fin] using hrank

theorem dimension_add_one_le_vertices (P : ConvexPolytope n) :
    P.dim + 1 ≤ P.vertices.card := by
  have hbody : P.toSet.Nonempty := by
    obtain ⟨x,hx⟩ := P.vertices_nonempty
    exact ⟨x,subset_convexHull ℝ _ hx⟩
  exact dimension_add_one_le_card_of_subset_hull hbody P.vertices (fun _ h => h)

theorem total_vertexFiber_card_le
    (P : ConvexPolytope n) (π : E n →L[ℝ] E n) :
    (∑ q : (imagePolytope P π).vertices, (vertexFiber P π q).vertices.card) ≤
      P.vertices.card := by
  let I := (imagePolytope P π).vertices
  let fibers : I → Finset (E n) := fun q => (vertexFiber P π q).vertices
  have hdis : ∀ a ∈ (Finset.univ : Finset I), ∀ b ∈ Finset.univ, a ≠ b →
      Disjoint (fibers a) (fibers b) := by
    intro a ha b hb hab
    apply Finset.disjoint_left.mpr
    intro x hxa hxb
    dsimp only [fibers] at hxa hxb
    rw [vertexFiber_vertices] at hxa hxb
    have he : a.val = b.val :=
      (Finset.mem_filter.mp hxa).2.symm.trans (Finset.mem_filter.mp hxb).2
    exact hab (Subtype.ext he)
  have hsub : Finset.univ.biUnion fibers ⊆ P.vertices := by
    intro x hx
    obtain ⟨q,hq,hxq⟩ := Finset.mem_biUnion.mp hx
    dsimp only [fibers] at hxq
    rw [vertexFiber_vertices] at hxq
    exact (Finset.mem_filter.mp hxq).1
  have hcard := Finset.card_le_card hsub
  rw [Finset.card_biUnion hdis] at hcard
  exact hcard

end Papers.LinearImageFibers

end
end
