    have hzP : z∈P.toSet := subset_convexHull ℝ (P.vertices : Set (E n)) hz
    rw [hseg] at hzP
    exact (vertex_mem_segment_iff P hx hy hz).mp hzP
  intro f hf
  obtain ⟨α,hα⟩ := hf x hx y hy hxy
