section BundlePart0
/- Source: Papers/FiniteExposedFaces.lean -/







@[expose] public section

/-!
# Exposed faces are generated by the maximizing vertices

These lemmas concern the actual convex hull and actual maximizers of a
linear functional.  The cardinality result applies directly to any
finite vertex description of a polytope; it has no assumed face-count
certificate.
-/

namespace Papers.FiniteExposedFaces

open Set Module
open scoped BigOperators Classical
open Papers.MinkowskiFaces Papers.FaceVertexCardinality

variable {E F : Type*} [AddCommGroup E] [Module ℝ E]
  [AddCommGroup F] [Module ℝ F]

theorem convex_maxFace {S : Set E} (hS : Convex ℝ S)
    (u : E →ₗ[ℝ] ℝ) : Convex ℝ (maxFace S u) := by
  intro x hx y hy a b ha hb hab
  refine ⟨hS hx.1 hy.1 ha hb hab, ?_⟩
  intro z hz
  calc
    u z = a * u z + b * u z := by rw [← add_mul, hab, one_mul]
    _ ≤ a * u x + b * u y :=
      add_le_add (mul_le_mul_of_nonneg_left (hx.2 z hz) ha)
        (mul_le_mul_of_nonneg_left (hy.2 z hz) hb)
    _ = u (a • x + b • y) := by simp only [map_add, map_smul, smul_eq_mul]

theorem supported_slice_convexHull (X : Finset E) (u : E →ₗ[ℝ] ℝ)
    (c : ℝ) (hbound : ∀ x ∈ X, u x ≤ c) :
    {x ∈ convexHull ℝ (X : Set E) | u x = c} =
      convexHull ℝ (↑(X.filter fun x => u x = c) : Set E) := by
  classical
  let Y := X.filter fun x => u x = c
  have hYX : Y ⊆ X := by
    intro y hy
    exact (Finset.mem_filter.mp hy).1
  apply Set.Subset.antisymm
  · rintro x ⟨hx, hux⟩
    obtain ⟨w, hw, hw1, hwx⟩ := Finset.mem_convexHull'.mp hx
    have hsum : ∑ y ∈ X, w y * (c - u y) = 0 := by
      calc
        (∑ y ∈ X, w y * (c - u y)) =
            (∑ y ∈ X, w y) * c - u (∑ y ∈ X, w y • y) := by
              simp only [mul_sub, Finset.sum_sub_distrib, Finset.sum_mul,
                map_sum, map_smul, smul_eq_mul]
        _ = 0 := by rw [hw1, hwx, hux, one_mul, sub_self]
    have hzero : ∀ y ∈ X, w y * (c - u y) = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg
        (fun y hy => mul_nonneg (hw y hy) (sub_nonneg.mpr (hbound y hy)))).mp hsum
    have hout : ∀ y ∈ X, y ∉ Y → w y = 0 := by
      intro y hy hnot
      have hne : c - u y ≠ 0 := by
        intro heq
        apply hnot
        exact Finset.mem_filter.mpr ⟨hy, (sub_eq_zero.mp heq).symm⟩
      exact (mul_eq_zero.mp (hzero y hy)).resolve_right hne
    apply Finset.mem_convexHull'.mpr
    refine ⟨w, fun y hy => hw y (hYX hy), ?_, ?_⟩
    · calc
        (∑ y ∈ Y, w y) = ∑ y ∈ X, w y :=
          Finset.sum_subset hYX hout
        _ = 1 := hw1
    · calc
        (∑ y ∈ Y, w y • y) = ∑ y ∈ X, w y • y :=
          Finset.sum_subset hYX (fun y hy hnot => by rw [hout y hy hnot, zero_smul])
        _ = x := hwx
  · apply convexHull_min
    · intro x hx
      obtain ⟨hxX, hux⟩ := Finset.mem_filter.mp hx
      exact ⟨subset_convexHull ℝ (X : Set E) hxX, hux⟩
    · intro x hx y hy a b ha hb hab
      refine ⟨(convex_convexHull ℝ (X : Set E)) hx.1 hy.1 ha hb hab, ?_⟩
      simp only [map_add, map_smul, smul_eq_mul, hx.2, hy.2]
      rw [← add_mul, hab, one_mul]

theorem maxFace_convexHull (X : Finset E) (u : E →ₗ[ℝ] ℝ) :
    maxFace (convexHull ℝ (X : Set E)) u =
      convexHull ℝ
        (↑(X.filter fun x => x ∈ maxFace (convexHull ℝ (X : Set E)) u) : Set E) := by
  classical
  apply Set.Subset.antisymm
  · intro x hx
    have hbound : ∀ y ∈ X, u y ≤ u x :=
      fun y hy => hx.2 y (subset_convexHull ℝ (X : Set E) hy)
    have hx' : x ∈ {z ∈ convexHull ℝ (X : Set E) | u z = u x} :=
      ⟨hx.1, rfl⟩
    rw [supported_slice_convexHull X u (u x) hbound] at hx'
    have heq : (X.filter fun y => u y = u x) =
        (X.filter fun y => y ∈ maxFace (convexHull ℝ (X : Set E)) u) := by
      ext y
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨hy, hux⟩
        refine ⟨hy, subset_convexHull ℝ (X : Set E) hy, ?_⟩
        intro z hz
        rw [hux]
        exact hx.2 z hz
      · rintro ⟨hy, hmy⟩
        exact ⟨hy, le_antisymm (hx.2 y hmy.1) (hmy.2 x hx.1)⟩
    simpa only [heq] using hx'
  · apply convexHull_min
    · intro x hx
      exact (Finset.mem_filter.mp hx).2
    · exact convex_maxFace (convex_convexHull ℝ (X : Set E)) u


theorem maxFace_convexHull_nonempty (X : Finset E) (hX : X.Nonempty)
    (u : E →ₗ[ℝ] ℝ) :
    (maxFace (convexHull ℝ (X : Set E)) u).Nonempty := by
  obtain ⟨q,hq,hmax⟩ := Finset.exists_max_image X u hX
  refine ⟨q,subset_convexHull ℝ _ hq,?_⟩
  exact convexHull_min hmax ((convex_Iic (u q)).linear_preimage u)

variable [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]

/-- If an exposed face contains an injective affine image of an r-dimensional
set and avoids C, at least r + 1 of the generating points lie outside C. -/
theorem outside_card_of_exposed_affineImage
    (X : Finset F) (u : F →ₗ[ℝ] ℝ) (C : Set F)
    {S : Set E} (hS : S.Nonempty)
    (f : E →ᵃ[ℝ] F) (hf : Function.Injective f.linear)
    (himage : f '' S ⊆ maxFace (convexHull ℝ (X : Set F)) u)
    (hdis : Disjoint (maxFace (convexHull ℝ (X : Set F)) u) C) :
    finrank ℝ (vectorSpan ℝ S) + 1 ≤ (X.filter fun x => x ∉ C).card := by
  classical
  let Y := X.filter fun x => x ∈ maxFace (convexHull ℝ (X : Set F)) u
  have himage' : f '' S ⊆ convexHull ℝ (Y : Set F) := by
    have heq : maxFace (convexHull ℝ (X : Set F)) u =
        convexHull ℝ (Y : Set F) := maxFace_convexHull X u
    rw [← heq]
    exact himage
  have hcard := dimension_add_one_le_card_of_affineImage_subset_hull
    hS f hf Y himage'
  apply hcard.trans
  apply Finset.card_le_card
  intro x hx
  obtain ⟨hxX, hxface⟩ := Finset.mem_filter.mp hx
  refine Finset.mem_filter.mpr ⟨hxX, ?_⟩
  intro hxC
  exact Set.disjoint_left.mp hdis hxface hxC

end Papers.FiniteExposedFaces

end
end BundlePart0

section BundlePart1
/- Source: Papers/ParallelSupportEvaluation.lean -/






@[expose] public section

/-!
# Evaluation of a parallel map on exposed faces

Parallelism and actual face connectivity imply that a supporting
functional takes the same value on the images of every maximizing
vertex.  The finite upper-envelope lemma then proves invariance when
the supporting functional is translated in a direction annihilating
the image.  No normal-fan regularity or piecewise-linear gluing
certificate is assumed.
-/

noncomputable section
namespace Papers.ParallelSupportEvaluation

open Set
open Papers.MinkowskiFaces Papers.FiniteExposedFaces
open Papers.PolytopeSimpleTailFace Papers.PolytopeFourRegularTail
open Papers.PolytopeBalinski Papers.FiniteEnvelopeLabels
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

def maxVertices (P : ConvexPolytope n) (u : E n →L[ℝ] ℝ) : Finset (E n) :=
  P.vertices.filter fun x => ∀ y ∈ P.vertices, u y ≤ u x

theorem maxVertices_nonempty
    (P : ConvexPolytope n) (u : E n →L[ℝ] ℝ) :
    (maxVertices P u).Nonempty := by
  obtain ⟨x,hx,hmax⟩ := Finset.exists_max_image P.vertices u P.vertices_nonempty
  exact ⟨x,Finset.mem_filter.mpr ⟨hx,hmax⟩⟩

theorem vertex_mem_maxFace
    (P : ConvexPolytope n) (u : E n →L[ℝ] ℝ)
    {x : E n} (hx : x ∈ P.vertices)
    (hmax : ∀ y ∈ P.vertices, u y ≤ u x) :
    x ∈ maxFace P.toSet u.toLinearMap := by
  refine ⟨subset_convexHull ℝ _ hx,?_⟩
  exact convexHull_min hmax ((convex_Iic (u x)).linear_preimage u.toLinearMap)

theorem maxFace_isFace
    (P : ConvexPolytope n) (u : E n →L[ℝ] ℝ) :
    P.IsFace (maxFace P.toSet u.toLinearMap) := by
  constructor
  · intro _
    exact ⟨u,rfl⟩
  · exact maxFace_convexHull_nonempty P.vertices P.vertices_nonempty u.toLinearMap

theorem evaluation_eq_at_maximizing_vertices
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (u : E n →L[ℝ] ℝ) {x y : E n}
    (hx : x ∈ P.vertices) (hy : y ∈ P.vertices)
    (hxmax : ∀ z ∈ P.vertices, u z ≤ u x)
    (hymax : ∀ z ∈ P.vertices, u z ≤ u y) :
    u (f x) = u (f y) := by
  let F := maxFace P.toSet u.toLinearMap
  have hF := maxFace_isFace P u
  let R := facePolytope P hF
  have hxF : x ∈ F := vertex_mem_maxFace P u hx hxmax
  have hyF : y ∈ F := vertex_mem_maxFace P u hy hymax
  let xx : R.vertices := ⟨x,(facePolytope_vertex_iff P hF x).mpr ⟨hx,hxF⟩⟩
  let yy : R.vertices := ⟨y,(facePolytope_vertex_iff P hF y).mpr ⟨hy,hyF⟩⟩
  have hedge {a b : R.vertices} (hab : (vertexGraph R).Adj a b) :
      u (f a.val) = u (f b.val) := by
    have ha := (facePolytope_vertex_iff P hF a.val).mp a.property
    have hb := (facePolytope_vertex_iff P hF b.val).mp b.property
    have hstep := facePolytope_step P hF hab
    obtain ⟨μ,hμ⟩ := hf a.val ha.1 b.val hb.1 hstep
    have hueq : u b.val = u a.val :=
      le_antisymm (ha.2.2 b.val hb.2.1) (hb.2.2 a.val ha.2.1)
    have heval := congrArg u hμ
    simp only [map_sub,map_smul,smul_eq_mul,hueq,sub_self,mul_zero] at heval
    exact (sub_eq_zero.mp heval).symm
  have hwalk {a b : R.vertices} (p : (vertexGraph R).Walk a b) :
      u (f a.val) = u (f b.val) := by
    induction p with
    | nil => rfl
    | cons h p ih => exact (hedge h).trans ih
  obtain ⟨p⟩ := (vertexGraph_connected R).preconnected xx yy
  exact hwalk p

theorem evaluation_invariant_under_annihilating_shift
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (u w : E n →L[ℝ] ℝ)
    (hwf : ∀ x ∈ P.vertices, w (f x) = 0)
    (s t : ℝ) {x y : E n} (hx : x ∈ P.vertices) (hy : y ∈ P.vertices)
    (hxmax : ∀ z ∈ P.vertices, u z + s * w z ≤ u x + s * w x)
    (hymax : ∀ z ∈ P.vertices, u z + t * w z ≤ u y + t * w y) :
    u (f x) = u (f y) := by
  letI : Nonempty P.vertices := ⟨⟨P.vertices_nonempty.choose,
    P.vertices_nonempty.choose_spec⟩⟩
  refine upper_envelope_labels_eq
    (fun v : P.vertices => u v.val) (fun v : P.vertices => w v.val)
    (fun v : P.vertices => u (f v.val)) ?_ s t ⟨x,hx⟩ ⟨y,hy⟩ ?_ ?_
  · intro r a b ha hb
    have heq := evaluation_eq_at_maximizing_vertices P f hf (u + r • w)
      a.property b.property
      (fun z hz => ha ⟨z,hz⟩) (fun z hz => hb ⟨z,hz⟩)
    simpa only [ContinuousLinearMap.add_apply,ContinuousLinearMap.smul_apply,
      smul_eq_mul,hwf a.val a.property,hwf b.val b.property,mul_zero,add_zero] using heq
  · exact fun z => hxmax z.val z.property
  · exact fun z => hymax z.val z.property

end Papers.ParallelSupportEvaluation

end
end
end BundlePart1

section BundlePart2
/- Source: Papers/ParallelExposedFiber.lean -/





@[expose] public section

/-!
# An exposed fiber carries the whole parallel-map image

If a functional annihilates the values of a parallel map, every strict
ascending edge for that functional preserves the map value.  Actual
monotone edge pivots therefore carry every value into the exposed
fiber.  A positive homothety on one such fiber forces the whole map to
respect every supporting functional.  This is the convexity step in
the proper-image argument.
-/

noncomputable section
namespace Papers.ParallelExposedFiber

open Set
open Papers.PolytopeFourRegularTail Papers.PolytopeBalinski
open Papers.FiniteGraphOptimization Papers.ParallelSupportEvaluation
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

theorem value_constant_on_height_changing_edge
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (w : E n →L[ℝ] ℝ) (hwf : ∀ x ∈ P.vertices, w (f x) = 0)
    {x y : E n} (hx : x ∈ P.vertices)
    (hxy : GeneralVertexStep P x y) (hheight : w x ≠ w y) :
    f y = f x := by
  obtain ⟨μ,hμ⟩ := hf x hx y hxy.1 hxy
  have heval := congrArg w hμ
  simp only [map_sub,map_smul,smul_eq_mul,hwf x hx,hwf y hxy.1,sub_self] at heval
  have hμzero : μ = 0 :=
    (mul_eq_zero.mp heval.symm).resolve_right
      (fun h => hheight (sub_eq_zero.mp h).symm)
  rw [hμzero,zero_smul] at hμ
  exact sub_eq_zero.mp hμ

theorem exposed_fiber_carries_image
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (w : E n →L[ℝ] ℝ) (hwf : ∀ x ∈ P.vertices, w (f x) = 0)
    (x : E n) (hx : x ∈ P.vertices) :
    ∃ y ∈ maxVertices P w, f y = f x := by
  let φ : P.vertices → ℝ := fun v => -w v.val
  have h : ∀ k : ℕ, ∀ v : P.vertices, descendingRank φ v = k →
      ∃ y ∈ maxVertices P w, f y = f v.val := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
        intro v hvk
        by_cases hmax : ∀ z ∈ P.vertices, w z ≤ w v.val
        · exact ⟨v.val,Finset.mem_filter.mpr ⟨v.property,hmax⟩,rfl⟩
        · have hex : ∃ z ∈ P.vertices, w v.val < w z := by
            simpa only [not_forall,not_le,exists_prop] using hmax
          obtain ⟨z,hz,hvz⟩ := hex
          obtain ⟨y,hvy,hheight⟩ :=
            exists_improving_neighbor P w v.property hz hvz
          let yy : P.vertices := ⟨y,hvy.1⟩
          have hφ : φ yy < φ v := neg_lt_neg hheight
          have hrank : descendingRank φ yy < k := by
            rw [← hvk]
            exact descendingRank_lt hφ
          obtain ⟨q,hq,hfq⟩ := ih (descendingRank φ yy) hrank yy rfl
          have hfy : f y = f v.val :=
            value_constant_on_height_changing_edge P f hf w hwf v.property hvy
              (ne_of_lt hheight)
          exact ⟨q,hq,hfq.trans hfy⟩
  exact h _ ⟨x,hx⟩ rfl

theorem exists_lexicographic_weight {I : Type*}
    (S : Finset I) (hS : S.Nonempty) (a b : I → ℝ)
    (x : I) (hx : x ∈ S)
    (hb : ∀ y ∈ S, b y ≤ b x)
    (ha : ∀ y ∈ S, b y = b x → a y ≤ a x) :
    ∃ t : ℝ, 0 ≤ t ∧ ∀ y ∈ S, a y + t * b y ≤ a x + t * b x := by
  let ratio : I → ℝ := fun y => (a y - a x) / (b x - b y)
  obtain ⟨q,hq,hqmax⟩ := Finset.exists_max_image S ratio hS
  let t := max 0 (ratio q)
  refine ⟨t,le_max_left _ _,?_⟩
  intro y hy
  rcases lt_or_eq_of_le (hb y hy) with hlt | heq
  · have hden : 0 < b x - b y := sub_pos.mpr hlt
    have hratio : (a y - a x) / (b x - b y) ≤ t :=
      (hqmax y hy).trans (le_max_right _ _)
    have hmul := (div_le_iff₀ hden).mp hratio
    nlinarith
  · have hu := ha y hy heq
    rw [heq]
    linarith

def SupportsCompatible (P : ConvexPolytope n) (f : E n → E n) : Prop :=
  ∀ u : E n →L[ℝ] ℝ, ∀ x ∈ P.vertices,
    (∀ z ∈ P.vertices, u z ≤ u x) →
      ∀ y ∈ P.vertices, u (f y) ≤ u (f x)

theorem supportsCompatible_of_positive_homothetic_fiber
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (w : E n →L[ℝ] ℝ) (hwf : ∀ x ∈ P.vertices, w (f x) = 0)
    (α : ℝ) (b : E n) (hα : 0 < α)
    (hhom : ∀ x ∈ maxVertices P w, f x = α • x + b) :
    SupportsCompatible P f := by
  intro u x hx hxmax z hz
  obtain ⟨y,hy,hymax⟩ :=
    Finset.exists_max_image (maxVertices P w) u (maxVertices_nonempty P w)
  have hyP : y ∈ P.vertices := (Finset.mem_filter.mp hy).1
  have hyw : ∀ a ∈ P.vertices, w a ≤ w y := (Finset.mem_filter.mp hy).2
  have hyu : ∀ a ∈ P.vertices, w a = w y → u a ≤ u y := by
    intro a ha haw
    apply hymax a
    apply Finset.mem_filter.mpr
    refine ⟨ha,?_⟩
    intro c hc
    rw [haw]
    exact hyw c hc
  obtain ⟨t,_ht,htmax⟩ :=
    exists_lexicographic_weight P.vertices P.vertices_nonempty u w y hyP hyw hyu
  have heval : u (f x) = u (f y) :=
    evaluation_invariant_under_annihilating_shift P f hf u w hwf 0 t hx hyP
      (by simpa only [zero_mul,add_zero] using hxmax) htmax
  obtain ⟨a,ha,hfa⟩ := exposed_fiber_carries_image P f hf w hwf z hz
  calc
    u (f z) = u (f a) := congrArg u hfa.symm
    _ = α * u a + u b := by rw [hhom a ha,map_add,map_smul,smul_eq_mul]
    _ ≤ α * u y + u b := by
      have hmul := mul_le_mul_of_nonneg_left (hymax a ha) hα.le
      linarith
    _ = u (f y) := by rw [hhom y hy,map_add,map_smul,smul_eq_mul]
    _ = u (f x) := heval.symm

end Papers.ParallelExposedFiber

end
end
