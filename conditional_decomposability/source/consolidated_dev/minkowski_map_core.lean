@[expose] public section

/-!
# Proper images below the sharp bound are actual weak summands

This is the all-dimensional proper-image lemma, with the nonconstant
parallel map and its actual affine image dimension.  Translation puts
the image direction through the origin; an actual orthogonal quotient
supplies the disjoint vertex fibers.  The sharp count produces a
nonzero homothety on one fiber, and the support argument constructs
genuine Minkowski summand polytopes after a possible change of sign.
No fiber, fan, rigidity, or summand certificate is an input hypothesis.
-/

noncomputable section
namespace Papers.ProperImageWeakSummand

open Set Module AffineSubspace
open Papers.PolytopeFourRegularTail Papers.ParallelSupportEvaluation
open Papers.ParallelExposedFiber Papers.ParallelFaceDirections
open Papers.LinearImageFibers Papers.ProperImageFiberCount
open Papers.CompatibleMinkowskiSummands Papers.FaceVertexCardinality
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical Pointwise

variable {n : ℕ}

def shiftMap (c : E n) : E n →ᵃ[ℝ] E n where
  toFun x := x-c
  linear := LinearMap.id
  map_vadd' p v := by
    change (v+p)-c = v+(p-c)
    abel

theorem centered_image_direction
    (P : ConvexPolytope n) (f : E n → E n) (c : E n) :
    vectorSpan ℝ ((fun x => f x-c) '' (P.vertices : Set (E n))) =
      vectorSpan ℝ (f '' (P.vertices : Set (E n))) := by
  have hset : (fun x => f x-c) '' (P.vertices : Set (E n)) =
      shiftMap c '' (f '' (P.vertices : Set (E n))) := by
    rw [Set.image_image]
    rfl
  rw [hset,← AffineMap.map_vectorSpan (shiftMap c)]
  simp only [shiftMap,Submodule.map_id]

def signedShiftMap (σ : ℝ) (c : E n) : E n →ᵃ[ℝ] E n where
  toFun x := σ • (x-c)
  linear := σ • LinearMap.id
  map_vadd' p v := by
    change σ • ((v+p)-c) = σ • v + σ • (p-c)
    module

theorem signed_shift_image_dimension
    (P : ConvexPolytope n) (f : E n → E n) (σ : ℝ) (hσ : σ ≠ 0) (c : E n) :
    finrank ℝ (vectorSpan ℝ
      ((fun x => σ • (f x-c)) '' (P.vertices : Set (E n)))) =
      finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n)))) := by
  have hinj : Function.Injective (signedShiftMap σ c).linear := by
    intro x y hxy
    have h := congrArg (fun z : E n => σ⁻¹ • z) hxy
    simpa only [signedShiftMap,LinearMap.smul_apply,LinearMap.id_apply,
      smul_smul,inv_mul_cancel₀ hσ,one_smul] using h
  have hset : (fun x => σ • (f x-c)) '' (P.vertices : Set (E n)) =
      signedShiftMap σ c '' (f '' (P.vertices : Set (E n))) := by
    rw [Set.image_image]
    rfl
  rw [hset]
  exact finrank_vectorSpan_affineImage (signedShiftMap σ c) hinj _

theorem proper_image_signed_weak_summand
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (f : E n → E n) (hf : ParallelOnTail P P.vertices f)
    (hnonconstant : ¬ ∃ b : E n, ∀ x ∈ P.vertices, f x = b)
    (hproper : finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n)))) < n)
    (hN : P.vertices.card < 4*n-4) :
    ∃ σ : ℝ, (σ=1 ∨ σ=(-1)) ∧ ∃ c : E n, ∃ ε : ℝ, 0 < ε ∧
      ∃ A B : ConvexPolytope n,
        A.toSet = convexHull ℝ
          ((fun x => σ • (f x-c)) '' (P.vertices : Set (E n))) ∧
        A.dim = finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n)))) ∧
        P.toSet = ε • A.toSet + B.toSet := by
  obtain ⟨x₀,hx₀⟩ := P.vertices_nonempty
  let c := f x₀
  let g : E n → E n := fun x => f x-c
  let L := vectorSpan ℝ (f '' (P.vertices : Set (E n)))
  let π : E n →L[ℝ] E n := Lᗮ.starProjection
  have hker : π.ker = L := by
    simp only [π,Submodule.ker_starProjection,Submodule.orthogonal_orthogonal]
  have hg : ParallelOnTail P P.vertices g := by
    intro x hx y hy hxy
    obtain ⟨μ,hμ⟩ := hf x hx y hy hxy
    refine ⟨μ,?_⟩
    change (f y-c)-(f x-c) = _
    calc
      (f y-c)-(f x-c) = f y-f x := by abel
      _ = μ • (y-x) := hμ
  have hgvalues : ∀ x ∈ P.vertices, π (g x) = 0 := by
    intro x hx
    change g x ∈ π.ker
    rw [hker]
    exact vsub_mem_vectorSpan ℝ ⟨x,hx,rfl⟩ ⟨x₀,hx₀,rfl⟩
  have hgimage : vectorSpan ℝ (g '' (P.vertices : Set (E n))) = π.ker :=
    (centered_image_direction P f c).trans hker.symm
  have hg_nonconstant : ¬ ∃ b : E n, ∀ x ∈ P.vertices, g x = b := by
    rintro ⟨b,hb⟩
    apply hnonconstant
    refine ⟨b+c,?_⟩
    intro x hx
    exact (sub_eq_iff_eq_add).mp (hb x hx)
  have hrpos : 1 ≤ finrank ℝ π.ker := by
    rw [hker]
    by_contra hn
    have hz : finrank ℝ L = 0 := by omega
    have hbot : L = ⊥ := Submodule.finrank_eq_zero.mp hz
    apply hnonconstant
    refine ⟨f x₀,?_⟩
    intro x hx
    have hmem : f x-f x₀ ∈ L :=
      vsub_mem_vectorSpan ℝ ⟨x,hx,rfl⟩ ⟨x₀,hx₀,rfl⟩
    rw [hbot,Submodule.mem_bot] at hmem
    exact sub_eq_zero.mp hmem
  have hrproper : finrank ℝ π.ker < n := by rw [hker]; exact hproper
  obtain ⟨q,α,b,hα,hfiber⟩ := exists_nonzero_homothetic_vertexFiber P hP g hg π
    hgimage hgvalues hrpos hrproper hN hg_nonconstant
  let w := fiberFunctional P π q
  have hwg : ∀ x ∈ P.vertices, w (g x) = 0 :=
    fun x hx => fiberFunctional_kernel P π q (g x) (hgvalues x hx)
  have hhom : ∀ x ∈ maxVertices P w, g x = α • x+b := by
    intro x hx
    apply hfiber x
    rw [vertexFiber,maxFace_vertices]
    exact hx
  have hfinish (σ : ℝ) (hσ : σ=1 ∨ σ=(-1)) (ε : ℝ) (hε : 0 < ε)
      (A B : ConvexPolytope n)
      (hA : A.toSet = convexHull ℝ
        ((fun x => σ • (f x-c)) '' (P.vertices : Set (E n))))
      (hAB : P.toSet = ε • A.toSet + B.toSet) :
      ∃ σ : ℝ, (σ=1 ∨ σ=(-1)) ∧ ∃ c : E n, ∃ ε : ℝ, 0 < ε ∧
        ∃ A B : ConvexPolytope n,
          A.toSet = convexHull ℝ
            ((fun x => σ • (f x-c)) '' (P.vertices : Set (E n))) ∧
          A.dim = finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n)))) ∧
          P.toSet = ε • A.toSet + B.toSet := by
    refine ⟨σ,hσ,c,ε,hε,A,B,hA,?_,hAB⟩
    change finrank ℝ (vectorSpan ℝ A.toSet) = _
    rw [hA,← direction_affineSpan,affineSpan_convexHull,direction_affineSpan]
    apply signed_shift_image_dimension P f σ
    rcases hσ with rfl | rfl <;> norm_num
  rcases lt_or_gt_of_ne hα with hαneg | hαpos
  · let gneg : E n → E n := fun x => -g x
    have hgn : ParallelOnTail P P.vertices gneg := by
      intro x hx y hy hxy
      obtain ⟨μ,hμ⟩ := hg x hx y hy hxy
      refine ⟨-μ,?_⟩
      change -g y- -g x = _
      calc
        -g y- -g x = -(g y-g x) := by abel
        _ = -(μ • (y-x)) := congrArg Neg.neg hμ
        _ = (-μ) • (y-x) := by module
    have hwgn : ∀ x ∈ P.vertices, w (gneg x) = 0 := by
      intro x hx
      change w (-g x) = 0
      rw [map_neg,hwg x hx,neg_zero]
    have hhomn : ∀ x ∈ maxVertices P w, gneg x = (-α) • x + (-b) := by
      intro x hx
      change -g x = _
      rw [hhom x hx]
      module
    obtain ⟨ε,hε,A,B,hA,hAB⟩ :=
      image_weak_summand_of_positive_homothetic_fiber P gneg hgn w hwgn
        (-α) (-b) (neg_pos.mpr hαneg) hhomn
    apply hfinish (-1) (Or.inr rfl) ε hε A B
    · simpa only [neg_one_smul] using hA
    · exact hAB
  · obtain ⟨ε,hε,A,B,hA,hAB⟩ :=
      image_weak_summand_of_positive_homothetic_fiber P g hg w hwg α b hαpos hhom
    apply hfinish 1 (Or.inl rfl) ε hε A B
    · simpa only [one_smul] using hA
    · exact hAB

end Papers.ProperImageWeakSummand

