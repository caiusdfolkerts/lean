section BundlePart17
/- Source: Papers/SimpleDeletionParallelRestoration.lean -/





@[expose] public section

/-! Every nontrivial parallel map on the deletion of a simple vertex extends
across that vertex.  The map is homothetic on the actual neighbor simplex. -/
noncomputable section
namespace Papers.Polytopes

open Set Module
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {d : ℕ}

theorem parallel_map_homothetic_on_clique
    (P : ConvexPolytope d) (S : Finset (E d)) (hS : S⊆P.vertices)
    (hcard : 2≤S.card)
    (hclique : ∀x∈S,∀y∈S,x≠y→GeneralVertexStep P x y)
    (f : E d → E d) (hf : IsParallelMap P f) :
    ∃α:ℝ,∃b:E d,∀x∈S,f x=α•x+b := by
  obtain ⟨u,hu,v,hv,huv⟩ := Finset.one_lt_card.mp (by omega : 1<S.card)
  obtain ⟨α,hα⟩ := hf u (hS hu) v (hS hv) (hclique u hu v hv huv)
  let b := f u-α•u
  have hfu : f u=α•u+b := by dsimp [b]; abel
  have hfv : f v=α•v+b := by
    calc
      f v=(f v-f u)+f u := by abel
      _=α•v+b := by rw [hα]; dsimp [b]; module
  refine ⟨α,b,?_⟩
  intro x hx
  by_cases hxu : x=u
  · rwa [hxu]
  by_cases hxv : x=v
  · rwa [hxv]
  exact homothety_at_two_neighbors P f (hS hu) (hS hx) (hS hv)
    huv hxu hxv hfu hfv
    (hf u (hS hu) x (hS hx) (hclique u hu x hx (Ne.symm hxu)))
    (hf v (hS hv) x (hS hx) (hclique v hv x hx (Ne.symm hxv)))

theorem old_edge_survives_vertex_deletion
    (P : ConvexPolytope d) (v : VertexType P)
    (hne : (P.vertices.erase v.val).Nonempty)
    {x y : E d} (hx : x∈P.vertices) (hxy : GeneralVertexStep P x y)
    (hxv : x≠v.val) (hyv : y≠v.val) :
    GeneralVertexStep (deleteVertex P v.val hne) x y := by
  let D := deleteVertex P v.val hne
  have hxD : x∈D.vertices := Finset.mem_erase.mpr ⟨hxv,hx⟩
  have hyD : y∈D.vertices := Finset.mem_erase.mpr ⟨hyv,hxy.1⟩
  have hsegD : segment ℝ x y⊆D.toSet :=
    (convex_convexHull ℝ (D.vertices : Set (E d))).segment_subset
      (subset_convexHull ℝ _ hxD) (subset_convexHull ℝ _ hyD)
  have hsub : D.toSet⊆P.toSet :=
    vertexSubset_body_subset P _ hne (Finset.erase_subset _ _)
  have hface := face_inter_subpolytope P D hsub
    (segment_isFace_of_generalVertexStep P hx hxy)
    ⟨x,left_mem_segment ℝ x y,subset_convexHull ℝ _ hxD⟩
  rw [Set.inter_eq_left.mpr hsegD] at hface
  exact ⟨hyD,hxy.2.1,segment ℝ x y,hface,
    segment_faceDim_of_generalVertexStep P hx hxy,left_mem_segment ℝ x y,
    right_mem_segment ℝ x y⟩

theorem decomposable_of_simple_deletion
    (P : ConvexPolytope d) (hP : P.IsFullDim) (hd : 2≤d)
    (v : VertexType P) (hs : IsSimpleVertex P v)
    (hcard : d+1<P.vertices.card) (hne : (P.vertices.erase v.val).Nonempty)
    (hD : MinkowskiDecomposable (deleteVertex P v.val hne)) :
    MinkowskiDecomposable P := by
  let D := deleteVertex P v.val hne
  let S := neighborVertices P v
  have hS : S⊆D.vertices := by
    intro x hx
    obtain ⟨u,hu,rfl⟩ := Finset.mem_image.mp hx
    have hstep := (adj_iff_generalVertexStep P v u.val).mp u.property
    exact Finset.mem_erase.mpr ⟨hstep.2.1.symm,u.val.property⟩
  have hScard : 2≤S.card := by
    change 2≤(neighborVertices P v).card
    rw [neighborVertices_card P hP v hs]; exact hd
  have hclique : ∀x∈S,∀y∈S,x≠y→GeneralVertexStep D x y := by
    intro x hx y hy hxy
    have hface := neighbor_subset_isFace P hP v hs hcard hne {x,y}
      (Finset.insert_nonempty _ _) (by
        intro z hz
        have hzy : z=x ∨ z=y := by simpa only [Finset.mem_insert,Finset.mem_singleton] using hz
        rcases hzy with rfl | rfl <;> assumption)
    rw [Finset.coe_pair,convexHull_pair] at hface
    refine ⟨hS hy,hxy,segment ℝ x y,hface,?_,left_mem_segment ℝ x y,
      right_mem_segment ℝ x y⟩
    unfold faceDim
    rw [vectorSpan_segment]
    exact finrank_span_singleton (sub_ne_zero.mpr hxy.symm)
  obtain ⟨f,hf,hnon⟩ := (minkowski_decomposable_iff_parallel_map D).mp hD
  obtain ⟨α,b,hhom⟩ := parallel_map_homothetic_on_clique D S hS hScard hclique f hf
  let g : E d → E d := fun x => if x=v.val then α•x+b else f x
  have hgn (x : E d) (hx : x≠v.val) : g x=f x := by simp only [g,if_neg hx]
  have hgv : g v.val=α•v.val+b := by simp only [g,if_pos rfl]
  have hneighbor (x : E d) (hx : GeneralVertexStep P v.val x) : g x=α•x+b := by
    have hxS : x∈S := (mem_neighborVertices_iff_adj P v ⟨x,hx.1⟩).mpr
      ((adj_iff_generalVertexStep P v ⟨x,hx.1⟩).mpr hx)
    rw [hgn x hx.2.1.symm]
    exact hhom x hxS
  have hg : IsParallelMap P g := by
    intro x hx y hy hxy
    by_cases hxv : x=v.val
    · subst x
      exact ⟨α,by rw [hgv,hneighbor y hxy]; module⟩
    by_cases hyv : y=v.val
    · subst y
      have hyx : GeneralVertexStep P v.val x := by
        obtain ⟨_,hne,F,hF,hdim,hvF,hxF⟩ := hxy
        exact ⟨hx,hne.symm,F,hF,hdim,hxF,hvF⟩
      exact ⟨α,by rw [hgv,hneighbor x hyx]; module⟩
    · obtain ⟨μ,hμ⟩ := hf x (Finset.mem_erase.mpr ⟨hxv,hx⟩)
        y (Finset.mem_erase.mpr ⟨hyv,hy⟩)
        (old_edge_survives_vertex_deletion P v hne hx hxy hxv hyv)
      exact ⟨μ,by rw [hgn x hxv,hgn y hyv]; exact hμ⟩
  apply (minkowski_decomposable_iff_parallel_map P).mpr
  refine ⟨g,hg,?_⟩
  rintro ⟨a,c,hgall⟩
  apply hnon
  refine ⟨a,c,?_⟩
  intro x hx
  rw [← hgn x (Finset.ne_of_mem_erase hx)]
  exact hgall x (Finset.mem_of_mem_erase hx)

end Papers.Polytopes

end
end
