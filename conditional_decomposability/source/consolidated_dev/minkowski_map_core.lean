    (fun v => by rw [smallTailGraph_degree_eq]; exact hmin v.val v.property)
    (by simpa only [Fintype.card_coe] using hcard) (fun v : T => f v.val)
    (fun x y hxy => hf x.val x.property y.val y.property hxy)
  exact ⟨α,b,fun x hx => h ⟨x,hx⟩⟩
theorem rigid_vertices_of_dim_one (P : ConvexPolytope n) (hdim : P.dim=1) :
    RigidInTail P P.vertices P.vertices := by
  obtain ⟨x,hx⟩ := P.vertices_nonempty
  have hxP := subset_convexHull ℝ (P.vertices : Set (E n)) hx
  obtain ⟨y,hy,hyP,hyx,hseg⟩ := spigolo_segmento P (toSet_isFace P) hdim hx hxP
