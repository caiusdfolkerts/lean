@[expose] public section

/-! Positive rescaling turns the actual weak summand into an ordinary summand,
without changing its affine dimension. -/
noncomputable section
namespace Papers.WeakSummandScaling

open Set Module
open Papers.FiniteHullPolytope Papers.ProperImageWeakSummand
open Papers.FaceVertexCardinality Papers.PolytopeFourRegularTail
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical Pointwise

variable {n : ℕ}

def scaleAffine (ε : ℝ) : E n →ᵃ[ℝ] E n where
  toFun x := ε•x
  linear := ε•LinearMap.id
  map_vadd' p v := by change ε•(v+p)=ε•v+ε•p; exact smul_add _ _ _

def scalePolytope (A : ConvexPolytope n) (ε : ℝ) : ConvexPolytope n :=
  imagePolytope A (scaleAffine ε)

theorem scalePolytope_body (A : ConvexPolytope n) (ε : ℝ) :
    (scalePolytope A ε).toSet=ε•A.toSet := by
  rw [scalePolytope,imagePolytope_toSet,← AffineMap.image_convexHull]
  rfl

theorem scalePolytope_dim (A : ConvexPolytope n) (ε : ℝ) (hε : ε≠0) :
    (scalePolytope A ε).dim=A.dim := by
  change finrank ℝ (vectorSpan ℝ (scalePolytope A ε).toSet)=
    finrank ℝ (vectorSpan ℝ A.toSet)
  rw [scalePolytope_body]
  change finrank ℝ (vectorSpan ℝ (scaleAffine ε '' A.toSet))=_
  apply finrank_vectorSpan_affineImage
  intro x y hxy
  have hh := congrArg (fun z : E n => ε⁻¹•z) hxy
  simpa only [scaleAffine,LinearMap.smul_apply,LinearMap.id_apply,
    smul_smul,inv_mul_cancel₀ hε,one_smul] using hh

theorem nonconstant_image_dimension_pos
    (P : ConvexPolytope n) (f : E n → E n)
    (hnonconstant : ¬∃b:E n,∀x∈P.vertices,f x=b) :
    0<finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n)))) := by
  obtain ⟨x0,hx0⟩ := P.vertices_nonempty
  by_contra hn
  have hz : finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n))))=0 := by omega
  have hbot := Submodule.finrank_eq_zero.mp hz
  apply hnonconstant
  refine ⟨f x0,?_⟩
  intro x hx
  have hmem : f x-f x0∈vectorSpan ℝ (f '' (P.vertices : Set (E n))) :=
    vsub_mem_vectorSpan ℝ ⟨x,hx,rfl⟩ ⟨x0,hx0,rfl⟩
  rw [hbot,Submodule.mem_bot] at hmem
  exact sub_eq_zero.mp hmem

theorem proper_image_actual_summand
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (f : E n → E n) (hf : ParallelOnTail P P.vertices f)
    (hnonconstant : ¬∃b:E n,∀x∈P.vertices,f x=b)
    (hproper : finrank ℝ (vectorSpan ℝ (f '' (P.vertices : Set (E n))))<n)
    (hN : P.vertices.card<4*n-4) :
    ∃A B:ConvexPolytope n,0<A.dim ∧ A.dim<n ∧ P.toSet=A.toSet+B.toSet := by
  obtain ⟨σ,hσ,c,ε,hε,A,B,hA,hdim,hsum⟩ :=
    proper_image_signed_weak_summand P hP f hf hnonconstant hproper hN
  refine ⟨scalePolytope A ε,B,?_,?_,?_⟩
  · rw [scalePolytope_dim A ε hε.ne',hdim]
    exact nonconstant_image_dimension_pos P f hnonconstant
  · rwa [scalePolytope_dim A ε hε.ne',hdim]
  · rwa [scalePolytope_body]

end Papers.WeakSummandScaling

end
end
