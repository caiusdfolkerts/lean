section BundlePart7
/- Source: Papers/ParallelFaceDirections.lean -/



@[expose] public section

/-!
# Direction spaces of parallel images on actual faces

Face connectivity puts differences of parallel-map values in the
direction space of the face.  An annihilator-exposed fiber carries every
value, so its direction space contains the direction space of the whole
image.  An actual linear fiber gives the reverse containment.
-/

noncomputable section
namespace Papers.ParallelFaceDirections

open Set Module
open Papers.PolytopeFourRegularTail Papers.PolytopeSimpleTailFace
open Papers.PolytopeBalinski Papers.ParallelSupportEvaluation
open Papers.ParallelExposedFiber
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

theorem parallel_value_difference_mem_face_direction
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    {F : Set (E n)} (hF : P.IsFace F)
    {x y : E n} (hx : x ∈ (facePolytope P hF).vertices)
    (hy : y ∈ (facePolytope P hF).vertices) :
    f y - f x ∈ vectorSpan ℝ F := by
  let R := facePolytope P hF
  let xx : R.vertices := ⟨x,hx⟩
  let yy : R.vertices := ⟨y,hy⟩
  have hedge {a b : R.vertices} (hab : (vertexGraph R).Adj a b) :
      f b.val - f a.val ∈ vectorSpan ℝ F := by
    have ha := (facePolytope_vertex_iff P hF a.val).mp a.property
    have hb := (facePolytope_vertex_iff P hF b.val).mp b.property
    obtain ⟨μ,hμ⟩ := hf a.val ha.1 b.val hb.1 (facePolytope_step P hF hab)
    rw [hμ]
    exact (vectorSpan ℝ F).smul_mem μ (vsub_mem_vectorSpan ℝ hb.2 ha.2)
  have hwalk {a b : R.vertices} (p : (vertexGraph R).Walk a b) :
      f b.val - f a.val ∈ vectorSpan ℝ F := by
    induction p with
    | nil => simpa only [sub_self] using (vectorSpan ℝ F).zero_mem
    | cons hab p ih =>
        have h := (vectorSpan ℝ F).add_mem ih (hedge hab)
        simpa only [sub_add_sub_cancel] using h
  obtain ⟨p⟩ := (vertexGraph_connected R).preconnected xx yy
  exact hwalk p

theorem image_direction_le_face_direction
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    {F : Set (E n)} (hF : P.IsFace F) :
    vectorSpan ℝ (f '' ((facePolytope P hF).vertices : Set (E n))) ≤
      vectorSpan ℝ F := by
  obtain ⟨y,hy⟩ := (facePolytope P hF).vertices_nonempty
  rw [vectorSpan_eq_span_vsub_set_right ℝ (show f y ∈
    f '' ((facePolytope P hF).vertices : Set (E n)) from ⟨y,hy,rfl⟩)]
  apply Submodule.span_le.mpr
  rintro z ⟨a,⟨x,hx,rfl⟩,rfl⟩
  exact parallel_value_difference_mem_face_direction P f hf hF hy hx

theorem maxFace_vertices
    (P : ConvexPolytope n) (w : E n →L[ℝ] ℝ) :
    (facePolytope P (maxFace_isFace P w)).vertices = maxVertices P w := by
  ext x
  rw [facePolytope_vertex_iff]
  constructor
  · rintro ⟨hx,hxf⟩
    exact Finset.mem_filter.mpr ⟨hx,fun y hy =>
      hxf.2 y (subset_convexHull ℝ _ hy)⟩
  · intro hx
    obtain ⟨hx,hmax⟩ := Finset.mem_filter.mp hx
    exact ⟨hx,vertex_mem_maxFace P w hx hmax⟩

theorem annihilator_fiber_image_eq
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (w : E n →L[ℝ] ℝ) (hwf : ∀ x ∈ P.vertices, w (f x) = 0) :
    f '' ((facePolytope P (maxFace_isFace P w)).vertices : Set (E n)) =
      f '' (P.vertices : Set (E n)) := by
  rw [maxFace_vertices]
  apply Set.Subset.antisymm
  · exact Set.image_mono (Finset.filter_subset _ _)
  · rintro z ⟨x,hx,rfl⟩
    obtain ⟨y,hy,heq⟩ := exposed_fiber_carries_image P f hf w hwf x hx
    exact ⟨y,hy,heq⟩

theorem direction_le_ker_of_constant_image
    (π : E n →L[ℝ] E n) {F : Set (E n)} (hF : F.Nonempty)
    (q : E n) (hq : ∀ x ∈ F, π x = q) :
    vectorSpan ℝ F ≤ π.ker := by
  obtain ⟨x,hx⟩ := hF
  rw [vectorSpan_eq_span_vsub_set_right ℝ hx]
  apply Submodule.span_le.mpr
  rintro z ⟨y,hy,rfl⟩
  change π (y-x) = 0
  rw [map_sub,hq y hy,hq x hx,sub_self]

theorem annihilator_fiber_direction_eq_kernel
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (π : E n →L[ℝ] E n)
    (himage : vectorSpan ℝ (f '' (P.vertices : Set (E n))) = π.ker)
    (w : E n →L[ℝ] ℝ) (hwf : ∀ x ∈ P.vertices, w (f x) = 0)
    (q : E n)
    (hfiber : ∀ x ∈ Papers.MinkowskiFaces.maxFace P.toSet w.toLinearMap, π x = q) :
    vectorSpan ℝ (Papers.MinkowskiFaces.maxFace P.toSet w.toLinearMap) = π.ker := by
  apply le_antisymm
  · exact direction_le_ker_of_constant_image π (maxFace_isFace P w).2 q hfiber
  · have h := image_direction_le_face_direction P f hf (maxFace_isFace P w)
    rw [annihilator_fiber_image_eq P f hf w hwf,himage] at h
    exact h

end Papers.ParallelFaceDirections

end
end
