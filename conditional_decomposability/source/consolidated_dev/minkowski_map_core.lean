section BundlePart4
/- Source: Papers/FiniteHullPolytope.lean -/





@[expose] public section

/-!
# A finite convex hull as a genuine polytope

The listed generators may contain redundant points.  The constructor
below keeps exactly the actual extreme points, proving their finiteness,
nonemptiness, and the equality of their convex hull with the original
hull.  Thus image hulls used as summands are ordinary ConvexPolytope
objects rather than a weaker substitute.
-/

noncomputable section
namespace Papers.FiniteHullPolytope

open Set
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

theorem finite_extremePoints_hull (S : Finset (E n)) :
    (Set.extremePoints ℝ (convexHull ℝ (S : Set (E n)))).Finite :=
  S.finite_toSet.subset extremePoints_convexHull_subset

theorem hull_extremePoints_eq_hull (S : Finset (E n)) :
    convexHull ℝ (Set.extremePoints ℝ (convexHull ℝ (S : Set (E n)))) =
      convexHull ℝ (S : Set (E n)) := by
  have hclosed := (finite_extremePoints_hull S).isClosed_convexHull ℝ
  have h := closure_convexHull_extremePoints
    (S.finite_toSet.isCompact_convexHull ℝ) (convex_convexHull ℝ (S : Set (E n)))
  rwa [hclosed.closure_eq] at h

def finiteHullPolytope (S : Finset (E n)) (hS : S.Nonempty) : ConvexPolytope n where
  vertices := (finite_extremePoints_hull S).toFinset
  vertices_nonempty := by
    have hne : (convexHull ℝ (S : Set (E n))).Nonempty := by
      obtain ⟨x,hx⟩ := hS
      exact ⟨x,subset_convexHull ℝ _ hx⟩
    have hex := (S.finite_toSet.isCompact_convexHull ℝ).extremePoints_nonempty hne
    obtain ⟨x,hx⟩ := hex
    exact ⟨x,by simpa using hx⟩
  vertices_eq_extremePoints := by
    have hcoe : ((finite_extremePoints_hull S).toFinset : Set (E n)) =
        Set.extremePoints ℝ (convexHull ℝ (S : Set (E n))) := by simp
    rw [hcoe,hull_extremePoints_eq_hull]

@[simp] theorem finiteHullPolytope_toSet (S : Finset (E n)) (hS : S.Nonempty) :
    (finiteHullPolytope S hS).toSet = convexHull ℝ (S : Set (E n)) := by
  change convexHull ℝ
    (((finite_extremePoints_hull S).toFinset : Finset (E n)) : Set (E n)) = _
  simpa using hull_extremePoints_eq_hull S

def imagePolytope (P : ConvexPolytope n) (f : E n → E n) : ConvexPolytope n :=
  finiteHullPolytope (P.vertices.image f) (P.vertices_nonempty.image f)

@[simp] theorem imagePolytope_toSet (P : ConvexPolytope n) (f : E n → E n) :
    (imagePolytope P f).toSet = convexHull ℝ (f '' (P.vertices : Set (E n))) := by
  rw [imagePolytope,finiteHullPolytope_toSet]
  simp only [Finset.coe_image]

end Papers.FiniteHullPolytope

end
end
end BundlePart4

section BundlePart5
/- Source: Papers/CompatibleMinkowskiSummands.lean -/






@[expose] public section

/-!
# Actual Minkowski summands from compatible vertex maps

Supporting-maximizer compatibility proves equality of the actual convex
bodies.  Both summands are constructed as genuine finite polytopes with
exact extreme-point vertex sets.  In particular, a positive homothetic
exposed fiber produces an actual weak summand, not an assumed certificate
or merely a formal parallel-map decomposition.
-/

noncomputable section
namespace Papers.CompatibleMinkowskiSummands

open Set
open Papers.PolytopeFourRegularTail Papers.PolytopeBalinski
open Papers.ParallelSupportEvaluation Papers.ParallelExposedFiber
open Papers.NonnegativeParallelMaps Papers.FiniteHullPolytope
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical Pointwise

variable {n : ℕ}

theorem imageHull_support_bound
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : SupportsCompatible P f)
    (u : E n →L[ℝ] ℝ) {v : E n} (hv : v ∈ P.vertices)
    (hvmax : ∀ z ∈ P.vertices, u z ≤ u v) :
    ∀ a ∈ (imagePolytope P f).toSet, u a ≤ u (f v) := by
  rw [imagePolytope_toSet]
  apply convexHull_min
  · rintro a ⟨x,hx,rfl⟩
    exact hf u v hv hvmax x hx
  · exact (convex_Iic (u (f v))).linear_preimage u.toLinearMap

theorem minkowski_eq_of_compatible_maps
    (P : ConvexPolytope n) (f g : E n → E n)
    (hf : SupportsCompatible P f) (hg : SupportsCompatible P g)
    (hsum : ∀ x ∈ P.vertices, f x + g x = x) :
    P.toSet = (imagePolytope P f).toSet + (imagePolytope P g).toSet := by
  apply Set.Subset.antisymm
  · apply convexHull_min
    · intro x hx
      apply Set.mem_add.mpr
      refine ⟨f x,?_,g x,?_,hsum x hx⟩
      · rw [imagePolytope_toSet]
        exact subset_convexHull ℝ _ ⟨x,hx,rfl⟩
      · rw [imagePolytope_toSet]
        exact subset_convexHull ℝ _ ⟨x,hx,rfl⟩
    · rw [imagePolytope_toSet,imagePolytope_toSet]
      exact (convex_convexHull ℝ _).add (convex_convexHull ℝ _)
  · intro z hz
    obtain ⟨a,ha,b,hb,rfl⟩ := Set.mem_add.mp hz
    by_contra hnot
    have hclosed : IsClosed P.toSet := P.vertices.finite_toSet.isClosed_convexHull ℝ
    obtain ⟨u,c,hbelow,habove⟩ :=
      geometric_hahn_banach_closed_point (convex_convexHull ℝ _) hclosed hnot
    obtain ⟨v,hv,hvmax⟩ := Finset.exists_max_image P.vertices u P.vertices_nonempty
    have hfa := imageHull_support_bound P f hf u hv hvmax a ha
    have hgb := imageHull_support_bound P g hg u hv hvmax b hb
    have hle : u (a+b) ≤ u v := by
      calc
        u (a+b) = u a + u b := map_add u a b
        _ ≤ u (f v) + u (g v) := add_le_add hfa hgb
        _ = u (f v + g v) := (map_add u (f v) (g v)).symm
        _ = u v := congrArg u (hsum v hv)
    have hvbelow := hbelow v (subset_convexHull ℝ _ hv)
    linarith

theorem imagePolytope_smul
    (P : ConvexPolytope n) (f : E n → E n) (ε : ℝ) :
    (imagePolytope P (fun x => ε • f x)).toSet =
      ε • (imagePolytope P f).toSet := by
  rw [imagePolytope_toSet,imagePolytope_toSet,← convexHull_smul]
  congr 1
  ext y
  constructor
  · rintro ⟨x,hx,rfl⟩
    exact ⟨f x,⟨x,hx,rfl⟩,rfl⟩
  · rintro ⟨z,⟨x,hx,rfl⟩,rfl⟩
    exact ⟨x,hx,rfl⟩

theorem image_weak_summand_of_supportsCompatible
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f) (hcompatible : SupportsCompatible P f) :
    ∃ ε : ℝ, 0 < ε ∧ ∃ B : ConvexPolytope n,
      P.toSet = ε • (imagePolytope P f).toSet + B.toSet := by
  have hnonnegative := nonnegative_of_supportsCompatible P f hf hcompatible
  obtain ⟨ε,hε,hfε,hgε⟩ := exists_scaled_complement_nonnegative P f hnonnegative
  refine ⟨ε,hε,imagePolytope P (fun x => x - ε • f x),?_⟩
  have hsum : ∀ x ∈ P.vertices, ε • f x + (x - ε • f x) = x := by
    intro x hx
    abel
  have heq := minkowski_eq_of_compatible_maps P
    (fun x => ε • f x) (fun x => x - ε • f x)
    (supportsCompatible_of_nonnegative P _ hfε)
    (supportsCompatible_of_nonnegative P _ hgε) hsum
  simpa only [imagePolytope_smul] using heq

theorem image_weak_summand_of_positive_homothetic_fiber
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (w : E n →L[ℝ] ℝ) (hwf : ∀ x ∈ P.vertices, w (f x) = 0)
    (α : ℝ) (b : E n) (hα : 0 < α)
    (hhom : ∀ x ∈ maxVertices P w, f x = α • x + b) :
    ∃ ε : ℝ, 0 < ε ∧ ∃ A B : ConvexPolytope n,
      A.toSet = convexHull ℝ (f '' (P.vertices : Set (E n))) ∧
      P.toSet = ε • A.toSet + B.toSet := by
  obtain ⟨ε,hε,B,hB⟩ := image_weak_summand_of_supportsCompatible P f hf
    (supportsCompatible_of_positive_homothetic_fiber P f hf w hwf α b hα hhom)
  exact ⟨ε,hε,imagePolytope P f,B,imagePolytope_toSet P f,hB⟩

end Papers.CompatibleMinkowskiSummands

end
end
end BundlePart5

section BundlePart6
/- Source: Papers/MinkowskiVertexMap.lean -/





@[expose] public section

/-!
# The actual vertex map of a Minkowski decomposition

Every vertex of an actual Minkowski sum has unique components, and those
components are actual vertices of the two summands.  The resulting
summand map is parallel on every actual edge and reaches every vertex
of the summand.  No labelled summand map is assumed as input.
-/

noncomputable section
namespace Papers.MinkowskiVertexMap

open Set
open Papers.MinkowskiFaces Papers.FiniteHullPolytope
open Papers.CompatibleMinkowskiSummands Papers.ParallelSupportEvaluation
open Papers.ParallelExposedFiber Papers.PolytopeFourRegularTail Papers.Polytopes
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical Pointwise

variable {n : ℕ}

theorem extreme_left_of_extreme_sum
    {S T : Set (E n)} {a b : E n}
    (ha : a∈S) (hb : b∈T) (hab : a+b∈(S+T).extremePoints ℝ) :
    a∈S.extremePoints ℝ := by
  apply mem_extremePoints_iff_left.mpr
  refine ⟨ha,?_⟩
  intro x hx y hy hseg
  obtain ⟨lam,μ,hlam,hμ,hunit,hcomb⟩ := hseg
  have hs : a+b∈openSegment ℝ (x+b) (y+b) := by
    refine ⟨lam,μ,hlam,hμ,hunit,?_⟩
    calc
      lam•(x+b)+μ•(y+b) = (lam•x+μ•y)+(lam+μ)•b := by module
      _ = a+b := by rw [hcomb,hunit,one_smul]
  have hh := (mem_extremePoints_iff_left.mp hab).2
    (x+b) (Set.mem_add.mpr ⟨x,hx,b,hb,rfl⟩)
    (y+b) (Set.mem_add.mpr ⟨y,hy,b,hb,rfl⟩) hs
  exact add_right_cancel hh

theorem extreme_right_of_extreme_sum
    {S T : Set (E n)} {a b : E n}
    (ha : a∈S) (hb : b∈T) (hab : a+b∈(S+T).extremePoints ℝ) :
    b∈T.extremePoints ℝ := by
  apply extreme_left_of_extreme_sum hb ha
  simpa only [add_comm] using hab

theorem sum_components_unique
    {S T : Set (E n)} {a b c d : E n}
    (ha : a∈S) (hb : b∈T) (hc : c∈S) (hd : d∈T)
    (hab : a+b∈(S+T).extremePoints ℝ) (heq : a+b=c+d) :
    a=c ∧ b=d := by
  have hseg : a+b∈segment ℝ (a+d) (c+b) := by
    refine ⟨(1/2:ℝ),(1/2:ℝ),by norm_num,by norm_num,by norm_num,?_⟩
    have hh : (a+d)+(c+b)=(a+b)+(c+d) := by abel
    calc
      (1/2:ℝ)•(a+d)+(1/2:ℝ)•(c+b) =
          (1/2:ℝ)•((a+d)+(c+b)) := by module
      _ = (1/2:ℝ)•((a+b)+(a+b)) := by rw [hh,← heq]
      _ = a+b := by module
  have hends := (mem_extremePoints_iff_forall_segment.mp hab).2
    (a+d) (Set.mem_add.mpr ⟨a,ha,d,hd,rfl⟩)
    (c+b) (Set.mem_add.mpr ⟨c,hc,b,hb,rfl⟩) hseg
  rcases hends with hd' | hc'
  · have hbd : b=d := (add_left_cancel hd').symm
    exact ⟨add_right_cancel (by simpa only [hbd] using heq),hbd⟩
  · have hac : a=c := (add_right_cancel hc').symm
    exact ⟨hac,add_left_cancel (by simpa only [hac] using heq)⟩

theorem vertex_decomposition
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet)
    {x : E n} (hx : x∈P.vertices) :
    ∃ a∈A.vertices,∃ b∈B.vertices,a+b=x := by
  have hxP := vertex_mem_body_of_mem_vertices P hx
  rw [hP] at hxP
  obtain ⟨a,ha,b,hb,hab⟩ := Set.mem_add.mp hxP
  have hext := vertex_mem_body_extremePoints P hx
  rw [hP,← hab] at hext
  have haext := extreme_left_of_extreme_sum ha hb hext
  have hbext := extreme_right_of_extreme_sum ha hb hext
  change a ∈ (convexHull ℝ (A.vertices : Set (E n))).extremePoints ℝ at haext
  change b ∈ (convexHull ℝ (B.vertices : Set (E n))).extremePoints ℝ at hbext
  rw [← A.vertices_eq_extremePoints] at haext
  rw [← B.vertices_eq_extremePoints] at hbext
  exact ⟨a,haext,b,hbext,hab⟩

def leftVertexMap
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet) (x : E n) : E n :=
  if hx : x∈P.vertices then (vertex_decomposition P A B hP hx).choose else 0

theorem leftVertexMap_spec
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet)
    {x : E n} (hx : x∈P.vertices) :
    leftVertexMap P A B hP x∈A.vertices ∧
      x-leftVertexMap P A B hP x∈B.vertices := by
  unfold leftVertexMap
  rw [dif_pos hx]
  have h := (vertex_decomposition P A B hP hx).choose_spec
  obtain ⟨b,hb,hab⟩ := h.2
  refine ⟨h.1,?_⟩
  have heq : x-(vertex_decomposition P A B hP hx).choose=b := by
    exact sub_eq_iff_eq_add.mpr (by simpa only [add_comm] using hab.symm)
  simpa only [heq] using hb

theorem leftVertexMap_nonnegative
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet) :
    Papers.NonnegativeParallelMaps.NonnegativeParallel P (leftVertexMap P A B hP) := by
  let f := leftVertexMap P A B hP
  intro x hx y hxy
  have hy := hxy.1
  have hfx := leftVertexMap_spec P A B hP hx
  have hfy := leftVertexMap_spec P A B hP hy
  have hax : f x∈A.toSet := vertex_mem_body_of_mem_vertices A hfx.1
  have hay : f y∈A.toSet := vertex_mem_body_of_mem_vertices A hfy.1
  have hbx : x-f x∈B.toSet := vertex_mem_body_of_mem_vertices B hfx.2
  have hby : y-f y∈B.toSet := vertex_mem_body_of_mem_vertices B hfy.2
  have hedge := segment_isFace_of_generalVertexStep P hx hxy
  obtain ⟨u,hu⟩ := hedge.1 hedge.2
  change segment ℝ x y=maxFace P.toSet u.toLinearMap at hu
  have hxmax : x∈maxFace P.toSet u.toLinearMap := by
    rw [← hu]
    exact left_mem_segment ℝ x y
  have hymax : y∈maxFace P.toSet u.toLinearMap := by
    rw [← hu]
    exact right_mem_segment ℝ x y
  have hxx : f x+(x-f x)∈maxFace (A.toSet+B.toSet) u.toLinearMap := by
    rw [← hP]
    convert hxmax using 1 <;> abel
  have hyy : f y+(y-f y)∈maxFace (A.toSet+B.toSet) u.toLinearMap := by
    rw [← hP]
    convert hymax using 1 <;> abel
  have hcx := components_maximize hax hbx hxx
  have hcy := components_maximize hay hby hyy
  have hcross : f y+(x-f x)∈segment ℝ x y := by
    rw [hu,hP,maxFace_add]
    exact Set.mem_add.mpr ⟨f y,hcy.1,x-f x,hcx.2,rfl⟩
  obtain ⟨lam,μ,_hlam,hμ,hunit,hcomb⟩ := hcross
  refine ⟨μ,hμ,?_⟩
  have hlam : lam=1-μ := by linarith
  rw [hlam] at hcomb
  calc
    f y-f x = (f y+(x-f x))-x := by abel
    _ = ((1-μ)•x+μ•y)-x := by rw [← hcomb]
    _ = μ•(y-x) := by module

theorem leftVertexMap_parallel
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet) :
    ParallelOnTail P P.vertices (leftVertexMap P A B hP) :=
  (leftVertexMap_nonnegative P A B hP).parallel

theorem leftVertexMap_surjective
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet)
    {a : E n} (ha : a∈A.vertices) :
    ∃ x∈P.vertices,leftVertexMap P A B hP x=a := by
  obtain ⟨u,hu⟩ := (vertex_isFace A ha).1 (Set.singleton_nonempty a)
  change ({a} : Set (E n))=maxFace A.toSet u.toLinearMap at hu
  obtain ⟨x,hx,hmax⟩ := Finset.exists_max_image P.vertices u P.vertices_nonempty
  have hxmax := vertex_mem_maxFace P u hx hmax
  have hfx := leftVertexMap_spec P A B hP hx
  let ax := leftVertexMap P A B hP x
  have hax : ax∈A.toSet := vertex_mem_body_of_mem_vertices A hfx.1
  have hbx : x-ax∈B.toSet := vertex_mem_body_of_mem_vertices B hfx.2
  have hxx : ax+(x-ax)∈maxFace (A.toSet+B.toSet) u.toLinearMap := by
    rw [← hP]
    convert hxmax using 1 <;> abel
  have hcomp := (components_maximize hax hbx hxx).1
  have heq : ax=a := by
    have hs : ax∈({a}:Set (E n)) := by rw [hu]; exact hcomp
    exact Set.mem_singleton_iff.mp hs
  exact ⟨x,hx,heq⟩

theorem leftVertexMap_image
    (P A B : ConvexPolytope n) (hP : P.toSet=A.toSet+B.toSet) :
    leftVertexMap P A B hP '' (P.vertices : Set (E n)) = (A.vertices : Set (E n)) := by
  ext a
  constructor
  · rintro ⟨x,hx,rfl⟩
    exact (leftVertexMap_spec P A B hP hx).1
  · intro ha
    exact leftVertexMap_surjective P A B hP ha

end Papers.MinkowskiVertexMap

end
end
