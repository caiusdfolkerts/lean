  obtain ⟨a, b, hab⟩ := dense_graph_parallel_rigid P (polytopeGraph P)
    Subtype.val Subtype.val_injective (fun i => i.property) hdegree hcard
    (fun i => f i.val) (by
      intro i j hij
      exact hf i.val i.property j.val j.property ((polytopeGraph_adj_iff_step P i j).mp hij))
