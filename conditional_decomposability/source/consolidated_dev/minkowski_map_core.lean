section BundlePart3
/- Source: Papers/NonnegativeParallelMaps.lean -/




@[expose] public section

/-!
# Nonnegative edge coefficients and supporting maximizers

A parallel map respects all supporting maximizers exactly when its
actual edge coefficients are nonnegative.  A small positive scaling
then has a complementary parallel map with nonnegative coefficients.
The proof is finite and uses actual monotone pivots.
-/

noncomputable section
namespace Papers.NonnegativeParallelMaps

open Set
open Papers.PolytopeFourRegularTail Papers.PolytopeBalinski
open Papers.FiniteGraphOptimization Papers.ParallelSupportEvaluation
open Papers.ParallelExposedFiber
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical

variable {n : ℕ}

def NonnegativeParallel (P : ConvexPolytope n) (f : E n → E n) : Prop :=
  ∀ x ∈ P.vertices, ∀ y, GeneralVertexStep P x y →
    ∃ μ : ℝ, 0 ≤ μ ∧ f y - f x = μ • (y - x)

theorem NonnegativeParallel.parallel {P : ConvexPolytope n} {f : E n → E n}
    (hf : NonnegativeParallel P f) : ParallelOnTail P P.vertices f := by
  intro x hx y hy hxy
  obtain ⟨μ,hμ,hfxy⟩ := hf x hx y hxy
  exact ⟨μ,hfxy⟩

theorem nonnegative_of_supportsCompatible
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f) (hcompatible : SupportsCompatible P f) :
    NonnegativeParallel P f := by
  intro x hx y hxy
  obtain ⟨μ,hμ⟩ := hf x hx y hxy.1 hxy
  obtain ⟨u,hu⟩ := exists_strict_vertex_exposer P hx
  have humax : ∀ z ∈ P.vertices, u z ≤ u x := by
    intro z hz
    by_cases heq : z = x
    · subst z; exact le_rfl
    · exact (hu z hz heq).le
  have hneg : u y - u x < 0 := sub_neg.mpr (hu y hxy.1 hxy.2.1.symm)
  have hle := hcompatible u x hx humax y hxy.1
  have heval := congrArg u hμ
  simp only [map_sub,map_smul,smul_eq_mul] at heval
  refine ⟨μ,?_,hμ⟩
  by_contra! hμneg
  have hprod := mul_pos_of_neg_of_neg hμneg hneg
  linarith

theorem supportsCompatible_of_nonnegative
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : NonnegativeParallel P f) :
    SupportsCompatible P f := by
  intro u x hx hxmax y hy
  let φ : P.vertices → ℝ := fun v => -u v.val
  have h : ∀ k : ℕ, ∀ v : P.vertices, descendingRank φ v = k →
      u (f v.val) ≤ u (f x) := by
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
        intro v hvk
        by_cases hvmax : ∀ z ∈ P.vertices, u z ≤ u v.val
        · exact le_of_eq (evaluation_eq_at_maximizing_vertices P f hf.parallel u
            v.property hx hvmax hxmax)
        · have hex : ∃ z ∈ P.vertices, u v.val < u z := by
            simpa only [not_forall,not_le,exists_prop] using hvmax
          obtain ⟨z,hz,hvz⟩ := hex
          obtain ⟨w,hvw,hheight⟩ :=
            exists_improving_neighbor P u v.property hz hvz
          let ww : P.vertices := ⟨w,hvw.1⟩
          have hrank : descendingRank φ ww < k := by
            rw [← hvk]
            exact descendingRank_lt (show φ ww < φ v from neg_lt_neg hheight)
          have hi := ih (descendingRank φ ww) hrank ww rfl
          obtain ⟨μ,hμ,hfvw⟩ := hf v.val v.property w hvw
          have heval := congrArg u hfvw
          simp only [map_sub,map_smul,smul_eq_mul] at heval
          have hmul : 0 ≤ μ * (u w - u v.val) :=
            mul_nonneg hμ (sub_nonneg.mpr hheight.le)
          have hstep : u (f v.val) ≤ u (f w) := by linarith
          exact hstep.trans hi
  exact h _ ⟨y,hy⟩ rfl

theorem supportsCompatible_iff_nonnegative
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f) :
    SupportsCompatible P f ↔ NonnegativeParallel P f :=
  ⟨nonnegative_of_supportsCompatible P f hf,supportsCompatible_of_nonnegative P f⟩

abbrev EdgeIndex (P : ConvexPolytope n) :=
  {e : P.vertices × P.vertices // GeneralVertexStep P e.1.val e.2.val}

theorem exists_scaled_complement_nonnegative
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : NonnegativeParallel P f) :
    ∃ ε : ℝ, 0 < ε ∧
      NonnegativeParallel P (fun x => ε • f x) ∧
      NonnegativeParallel P (fun x => x - ε • f x) := by
  let μ : EdgeIndex P → ℝ := fun e =>
    (hf e.val.1.val e.val.1.property e.val.2.val e.property).choose
  have hμ (e : EdgeIndex P) :
      0 ≤ μ e ∧
        f e.val.2.val - f e.val.1.val =
          μ e • (e.val.2.val - e.val.1.val) :=
    (hf e.val.1.val e.val.1.property e.val.2.val e.property).choose_spec
  obtain ⟨ε,hε,hsmall⟩ := exists_small_positive_perturbation
    (Finset.univ : Finset (EdgeIndex P)) (fun _ => 1) (fun e => -μ e)
    (fun _ _ => zero_lt_one)
  have hbound (e : EdgeIndex P) : 0 ≤ 1 - ε * μ e := by
    have h := hsmall ε hε le_rfl e (Finset.mem_univ e)
    nlinarith
  refine ⟨ε,hε,?_,?_⟩
  · intro x hx y hxy
    let e : EdgeIndex P := ⟨(⟨x,hx⟩,⟨y,hxy.1⟩),hxy⟩
    refine ⟨ε * μ e,mul_nonneg hε.le (hμ e).1,?_⟩
    calc
      ε • f y - ε • f x = ε • (f y - f x) := by module
      _ = ε • (μ e • (y - x)) := by rw [(hμ e).2]
      _ = (ε * μ e) • (y - x) := by module
  · intro x hx y hxy
    let e : EdgeIndex P := ⟨(⟨x,hx⟩,⟨y,hxy.1⟩),hxy⟩
    refine ⟨1 - ε * μ e,hbound e,?_⟩
    calc
      (y - ε • f y) - (x - ε • f x) =
          (y - x) - ε • (f y - f x) := by module
      _ = (y - x) - ε • (μ e • (y - x)) := by rw [(hμ e).2]
      _ = (1 - ε * μ e) • (y - x) := by module

end Papers.NonnegativeParallelMaps

end
end
