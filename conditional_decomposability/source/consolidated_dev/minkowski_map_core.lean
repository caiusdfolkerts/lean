@[expose] public section

/-!
# The sharp count forces a homothetic quotient-vertex fiber

Every fiber is an actual face of intrinsic dimension rank(ker π).
If every restriction were nonhomothetic, dense actual graph rigidity
would force at least twice that dimension vertices in each disjoint
fiber.  Rank-nullity and the vertex bound contradict the resulting
count.  The one-dimensional case is supplied by the actual segment
rigidity theorem.
-/

noncomputable section
namespace Papers.ProperImageFiberCount

open Set Module
open Papers.PolytopeFourRegularTail Papers.PolytopeSimpleTailFace
open Papers.ParallelSupportEvaluation Papers.ParallelExposedFiber
open Papers.ParallelFaceDirections Papers.LinearImageFibers
open Papers.FiniteHullPolytope Papers.PolytopeVertexCone
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open scoped Classical BigOperators

variable {n : ℕ}

theorem parallel_on_vertexFiber
    (P : ConvexPolytope n) (f : E n → E n)
    (hf : ParallelOnTail P P.vertices f)
    (π : E n →L[ℝ] E n) (q : (imagePolytope P π).vertices) :
    ParallelOnTail (vertexFiber P π q) (vertexFiber P π q).vertices f := by
  intro x hx y hy hxy
  have hxP := ((facePolytope_vertex_iff P
    (maxFace_isFace P (fiberFunctional P π q)) x).mp hx).1
  have hyP := ((facePolytope_vertex_iff P
    (maxFace_isFace P (fiberFunctional P π q)) y).mp hy).1
  exact hf x hxP y hyP
    (facePolytope_step P (maxFace_isFace P (fiberFunctional P π q)) hxy)

theorem exists_homothetic_vertexFiber
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (f : E n → E n) (hf : ParallelOnTail P P.vertices f)
    (π : E n →L[ℝ] E n)
    (himage : vectorSpan ℝ (f '' (P.vertices : Set (E n))) = π.ker)
    (hvalues : ∀ x ∈ P.vertices, π (f x) = 0)
    (hrpos : 1 ≤ finrank ℝ π.ker) (hrproper : finrank ℝ π.ker < n)
    (hN : P.vertices.card < 4*n-4) :
    ∃ q : (imagePolytope P π).vertices, ∃ α : ℝ, ∃ b : E n,
      ∀ x ∈ (vertexFiber P π q).vertices, f x = α • x + b := by
  let Q := imagePolytope P π
  let r := finrank ℝ π.ker
  have hdim (q : Q.vertices) : (vertexFiber P π q).dim = r :=
    vertexFiber_dim_eq P f hf π himage hvalues q
  by_cases hr1 : r = 1
  · obtain ⟨q,hq⟩ := Q.vertices_nonempty
    let qq : Q.vertices := ⟨q,hq⟩
    have hR := rigid_vertices_of_dim_one (vertexFiber P π qq)
      ((hdim qq).trans hr1)
    obtain ⟨α,b,hh⟩ := hR f (parallel_on_vertexFiber P f hf π qq)
    exact ⟨qq,α,b,hh⟩
  have hr2 : 2 ≤ r := by omega
  have hsmall : ∃ q : Q.vertices, (vertexFiber P π q).vertices.card < 2*r := by
    by_contra hnone
    have hall : ∀ q : Q.vertices, 2*r ≤ (vertexFiber P π q).vertices.card := by
      intro q
      exact le_of_not_gt (fun h => hnone ⟨q,h⟩)
    have hcount : 2*r*Q.vertices.card ≤ P.vertices.card := by
      calc
        2*r*Q.vertices.card = ∑ _q : Q.vertices, 2*r := by simp [Nat.mul_comm]
        _ ≤ ∑ q : Q.vertices, (vertexFiber P π q).vertices.card :=
          Finset.sum_le_sum (fun q _ => hall q)
        _ ≤ P.vertices.card := total_vertexFiber_card_le P π
    have hQcard := dimension_add_one_le_vertices Q
    have hcount' : 2*r*(Q.dim+1) ≤ P.vertices.card :=
      (Nat.mul_le_mul_left (2*r) hQcard).trans hcount
    have hdimQ : Q.dim+r = n := image_dim_add_kernel_dim P hP π
    have hQpos : 1 ≤ Q.dim := by omega
    have hNz : (P.vertices.card : ℤ)+5 ≤ 4*(n : ℤ) := by omega
    have hcountz : 2*(r : ℤ)*((Q.dim : ℤ)+1) ≤ (P.vertices.card : ℤ) := by
      exact_mod_cast hcount'
    have hdimz : (Q.dim : ℤ)+(r : ℤ) = (n : ℤ) := by exact_mod_cast hdimQ
    have hproduct : 0 ≤ ((r : ℤ)-2)*((Q.dim : ℤ)-1) :=
      mul_nonneg (by omega) (by omega)
    nlinarith
  obtain ⟨q,hq⟩ := hsmall
  let R := vertexFiber P π q
  have hmin : ∀ x ∈ R.vertices, r ≤
      (R.vertices.filter (fun y => GeneralVertexStep R x y)).card := by
    intro x hx
    have h := intrinsic_dim_le_neighbor_card R hx
    rw [hdim q] at h
    exact h
  have hrigid := rigid_tail_of_min_degree_card_lt_twice R R.vertices
    (fun _ h => h) r hmin hq
  obtain ⟨α,b,hh⟩ := hrigid f (parallel_on_vertexFiber P f hf π q)
  exact ⟨q,α,b,hh⟩

theorem exists_nonzero_homothetic_vertexFiber
    (P : ConvexPolytope n) (hP : P.IsFullDim)
    (f : E n → E n) (hf : ParallelOnTail P P.vertices f)
    (π : E n →L[ℝ] E n)
    (himage : vectorSpan ℝ (f '' (P.vertices : Set (E n))) = π.ker)
    (hvalues : ∀ x ∈ P.vertices, π (f x) = 0)
    (hrpos : 1 ≤ finrank ℝ π.ker) (hrproper : finrank ℝ π.ker < n)
    (hN : P.vertices.card < 4*n-4)
    (hnonconstant : ¬ ∃ b : E n, ∀ x ∈ P.vertices, f x = b) :
    ∃ q : (imagePolytope P π).vertices, ∃ α : ℝ, ∃ b : E n,
      α ≠ 0 ∧ ∀ x ∈ (vertexFiber P π q).vertices, f x = α • x + b := by
  obtain ⟨q,α,b,hhom⟩ := exists_homothetic_vertexFiber P hP f hf π
    himage hvalues hrpos hrproper hN
  refine ⟨q,α,b,?_,hhom⟩
  intro hα
  apply hnonconstant
  refine ⟨b,?_⟩
  intro x hx
  obtain ⟨y,hy,hfy⟩ := exposed_fiber_carries_image P f hf
    (fiberFunctional P π q)
    (fun z hz => fiberFunctional_kernel P π q (f z) (hvalues z hz)) x hx
  have hyR : y ∈ (vertexFiber P π q).vertices := by
    rw [vertexFiber,maxFace_vertices]
    exact hy
  have h := hhom y hyR
  rw [hα,zero_smul,zero_add] at h
  exact hfy.symm.trans h

end Papers.ProperImageFiberCount

end
end
