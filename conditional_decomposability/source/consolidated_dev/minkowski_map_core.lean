section BundlePart9
/- Source: Papers/DenseClosure.lean -/








@[expose] public section

/-!
# The finite two-neighbor closure argument

This is the graph-theoretic counting step in the dense rigidity lemma. It
does not assume any geometric rigidity conclusion: a set of at least three
vertices closed under taking two neighbors must contain every vertex.
-/

noncomputable section
namespace Papers.DenseClosure
open Finset
open scoped BigOperators Classical

variable {V : Type*} [Fintype V] [DecidableEq V]

def TwoNeighborClosed (G : SimpleGraph V) (S : Finset V) : Prop :=
  ∀ v, v ∉ S → ∀ u ∈ S, ∀ w ∈ S, G.Adj v u → G.Adj v w → u = w

theorem dense_closed_eq_univ (G : SimpleGraph V) {k : ℕ}
    (hdegree : ∀ v, k ≤ G.degree v) (hdense : Fintype.card V < 2 * k)
    (S : Finset V) (hS : 3 ≤ S.card) (hclosed : TwoNeighborClosed G S) : S = univ := by
  classical
  by_contra hproper
  obtain ⟨v, hv⟩ : ∃ v : V, v ∉ S := by
    by_contra h
    push_neg at h
    apply hproper
    ext v
    simp [h v]
  let T : Finset V := univ \ S
  have hvT : v ∈ T := by simp [T, hv]
  have hpartition : S.card + T.card = Fintype.card V := by
    dsimp [T]
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ S), Finset.card_univ]
    have := Finset.card_le_univ S
    omega
  have hinside : (G.neighborFinset v ∩ S).card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro u hu w hw
    exact hclosed v hv u (Finset.mem_inter.mp hu).2 w (Finset.mem_inter.mp hw).2
      ((G.mem_neighborFinset _ _).mp (Finset.mem_inter.mp hu).1)
      ((G.mem_neighborFinset _ _).mp (Finset.mem_inter.mp hw).1)
  have houtside : (G.neighborFinset v \ S).card < T.card := by
    apply Finset.card_lt_card
    apply Finset.ssubset_iff_subset_ne.mpr
    refine ⟨?_, ?_⟩
    · intro w hw
      exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, (Finset.mem_sdiff.mp hw).2⟩
    · intro heq
      have hmem : v ∈ G.neighborFinset v \ S := heq.symm ▸ hvT
      exact G.notMem_neighborFinset_self v (Finset.mem_sdiff.mp hmem).1
  have hdegparts := Finset.card_sdiff_add_card_inter (G.neighborFinset v) S
  rw [G.card_neighborFinset_eq_degree] at hdegparts
  have hkT : k ≤ T.card := by have := hdegree v; omega
  have hslt : S.card < k := by omega
  let outside : V → Finset V := fun u => G.neighborFinset u \ S
  have houtsideDisjoint : (S : Set V).PairwiseDisjoint outside := by
    intro u hu w hw huw
    apply Finset.disjoint_left.mpr
    intro z hzu hzw
    have hzu' := Finset.mem_sdiff.mp hzu
    have hzw' := Finset.mem_sdiff.mp hzw
    apply huw
    exact hclosed z hzu'.2 u hu w hw
      (G.adj_symm ((G.mem_neighborFinset _ _).mp hzu'.1))
      (G.adj_symm ((G.mem_neighborFinset _ _).mp hzw'.1))
  have htotal : (∑ u ∈ S, (outside u).card) ≤ T.card := by
    rw [← Finset.card_biUnion houtsideDisjoint]
    apply Finset.card_le_card
    intro z hz
    obtain ⟨u, hu, hzu⟩ := Finset.mem_biUnion.mp hz
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, (Finset.mem_sdiff.mp hzu).2⟩
  have hneed : ∀ u ∈ S, k + 1 ≤ (outside u).card + S.card := by
    intro u hu
    have hinner : (G.neighborFinset u ∩ S).card < S.card := by
      apply Finset.card_lt_card
      apply Finset.ssubset_iff_subset_ne.mpr
      refine ⟨Finset.inter_subset_right, ?_⟩
      intro heq
      have hmem : u ∈ G.neighborFinset u ∩ S := heq.symm ▸ hu
      exact G.notMem_neighborFinset_self u (Finset.mem_inter.mp hmem).1
    have hparts := Finset.card_sdiff_add_card_inter (G.neighborFinset u) S
    rw [G.card_neighborFinset_eq_degree] at hparts
    have := hdegree u
    change k + 1 ≤ (G.neighborFinset u \ S).card + S.card
    omega
  have hsum : (∑ _u∈S,(k+1:ℕ)) ≤ ∑ u∈S,((outside u).card+S.card) :=
    Finset.sum_le_sum hneed
  have hsum' : S.card * (k + 1) ≤ (∑ u ∈ S, (outside u).card) + S.card * S.card := by
    simpa [Finset.sum_add_distrib, Nat.mul_add] using hsum
  have hcount : S.card * (k + 1) ≤ T.card + S.card * S.card :=
    hsum'.trans (Nat.add_le_add_right htotal _)
  have hS' : (3 : ℤ) ≤ S.card := by exact_mod_cast hS
  have hsk' : (S.card : ℤ) + 1 ≤ k := by exact_mod_cast (Nat.succ_le_of_lt hslt)
  have hdense' : (Fintype.card V : ℤ) < 2 * k := by exact_mod_cast hdense
  have hpartition' : (S.card : ℤ) + T.card = Fintype.card V := by exact_mod_cast hpartition
  have hcount' : (S.card : ℤ) * (k + 1) ≤ T.card + (S.card : ℤ) * S.card := by
    exact_mod_cast hcount
  have hproduct : 0 ≤ ((S.card : ℤ) - 3) * ((k : ℤ) - S.card - 1) :=
    mul_nonneg (by omega) (by omega)
  nlinarith

/-- The dense graph has a triangle whenever it has a vertex. -/
theorem exists_triangle (G : SimpleGraph V) {k : ℕ}
    (hdegree : ∀ v, k ≤ G.degree v) (hdense : Fintype.card V < 2 * k)
    (v : V) : ∃ u w, G.Adj v u ∧ G.Adj v w ∧ G.Adj u w := by
  classical
  have hk : 0 < k := by omega
  obtain ⟨u, hvu⟩ := (G.degree_pos_iff_exists_adj v).mp (hk.trans_le (hdegree v))
  have hcard : 0 < (G.neighborFinset v ∩ G.neighborFinset u).card := by
    have h := Finset.card_union_add_card_inter (G.neighborFinset v) (G.neighborFinset u)
    rw [G.card_neighborFinset_eq_degree, G.card_neighborFinset_eq_degree] at h
    have huBound := Finset.card_le_univ (G.neighborFinset v ∪ G.neighborFinset u)
    have h1 := hdegree v
    have h2 := hdegree u
    omega
  obtain ⟨w, hw⟩ := Finset.card_pos.mp hcard
  refine ⟨u, w, hvu, ?_, ?_⟩
  · exact (G.mem_neighborFinset _ _).mp (Finset.mem_inter.mp hw).1
  · exact (G.mem_neighborFinset _ _).mp (Finset.mem_inter.mp hw).2

/-- Any property true of triangles and preserved by two-neighbor absorption
holds on the whole dense graph. The empty graph is handled explicitly. -/
theorem dense_induction (G : SimpleGraph V) {k : ℕ}
    (hdegree : ∀ v, k ≤ G.degree v) (hdense : Fintype.card V < 2 * k)
    (R : Finset V → Prop) (hempty : R ∅)
    (htriangle : ∀ u v w, G.Adj u v → G.Adj u w → G.Adj v w → R {u, v, w})
    (habsorb : ∀ S, R S → ∀ v u w, u ∈ S → w ∈ S → u ≠ w →
      G.Adj v u → G.Adj v w → R (insert v S)) : R univ := by
  classical
  by_cases hV : Nonempty V
  · let v : V := Classical.choice hV
    obtain ⟨u, w, hvu, hvw, huw⟩ := exists_triangle G hdegree hdense v
    let seed : Finset V := {v, u, w}
    have hseed : R seed := htriangle v u w hvu hvw huw
    have hseedcard : seed.card = 3 := by
      simp [seed, G.ne_of_adj hvu, G.ne_of_adj hvw, G.ne_of_adj huw]
    let candidates : Finset (Finset V) := univ.powerset.filter R
    have hseedmem : seed ∈ candidates := by
      exact Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (Finset.subset_univ _), hseed⟩
    obtain ⟨S, hSc, hmax⟩ := candidates.exists_max_image Finset.card ⟨seed, hseedmem⟩
    have hRS : R S := (Finset.mem_filter.mp hSc).2
    have hS : 3 ≤ S.card := by have := hmax seed hseedmem; omega
    have hclosed : TwoNeighborClosed G S := by
      intro z hz a ha b hb hza hzb
      by_contra hab
      have hi : R (insert z S) := habsorb S hRS z a b ha hb hab hza hzb
      have himem : insert z S ∈ candidates := by
        exact Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr (Finset.subset_univ _), hi⟩
      have hc := hmax (insert z S) himem
      rw [Finset.card_insert_of_notMem hz] at hc
      omega
    exact (dense_closed_eq_univ G hdegree hdense S hS hclosed) ▸ hRS
  · have hemptyV : (univ : Finset V) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro v _
      exact hV ⟨v⟩
    rw [hemptyV]
    exact hempty

end Papers.DenseClosure

