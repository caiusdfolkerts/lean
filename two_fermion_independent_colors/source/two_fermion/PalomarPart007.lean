@[simp]
theorem range_operatorAbs (A : E →ₗ[𝕜] F) : A.operatorAbs.range = A.kerᗮ := by
  rw [operatorAbs, (isPositive_adjoint_comp_self A).range_sqrt,
    range_adjoint_comp_self, ← orthogonal_ker]

