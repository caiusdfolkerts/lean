      (MvPolynomial.eval_eq_eval_mv_eval' t s p).symm
    have hd : q.derivative.eval 0 = MvPolynomial.eval t (firstVariableCoefficient p) := by
      first
      | rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_derivative]
