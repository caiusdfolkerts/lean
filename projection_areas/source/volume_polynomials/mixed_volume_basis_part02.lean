theorem mixedArea_facet_formula {ι : Type*} [Fintype ι]
    (P : ConvexBody Plane) (l : ι → Plane →L[ℝ] ℝ)
    (hl : Function.Injective l) (hbody : HalfspacePyramids.body l = (P : Set Plane))
    (v : ι → Plane) (hv : ∀ i, l i (v i) = 1) (A : ConvexBody Plane) :
