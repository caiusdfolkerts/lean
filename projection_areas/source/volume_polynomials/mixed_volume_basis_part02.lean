    constructor
    · rintro ⟨s, hs, z, ⟨b, hb, rfl⟩, heq⟩
      have hli := congrArg (l i) heq
      simp only [map_add, map_smul, smul_eq_mul, hq.2, mul_one] at hli
      have hb' := mul_le_mul_of_nonneg_left (hmax b hb) ht0
      linarith [hs i]
