    (hK : (0 : Space 3) ∈ K) (hL : (0 : Space 3) ∈ L)
    (hdimL : finrank ℝ (linearHull L) = 2)
    (hvol : bodyVolume (K + L) = 0) : (K : Set (Space 3)) ⊆ linearHull L := by
  first
  | intro x hx
    exact linearHull_le_of_volume_zero_sum K L hK hL hdimL hvol (mem_linearHull hx)

