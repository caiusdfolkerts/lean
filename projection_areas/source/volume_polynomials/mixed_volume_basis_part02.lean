    (hq : q ∈ face l i) (hstrict : ∀ j, j ≠ i → l j q < 1)
    {A : Set E} (ha : a ∈ A) :
    ∀ᶠ t : ℝ in 𝓝 0, (1 + t * l i a) • q ∈ body l + t • A := by
  first
  | have hall : ∀ j, ∀ᶠ t : ℝ in 𝓝 0,
