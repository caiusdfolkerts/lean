    have hyn := hp (fun i => -(e i).2)
    simp only [abs_neg, Finset.sum_neg_distrib] at hxn hyn
    constructor
    · linarith [hbal.1, hvar.1]
    constructor
    · linarith [hbal.2, hvar.2]
    constructor
    · linarith [hbal.1, hvar.1]
    · linarith [hbal.2, hvar.2]

