  [NormedAddCommGroup F] [NormedSpace ℝ F]

def segmentBody (a b : E) : ConvexBody E where
  carrier := segment ℝ a b
  convex' := convex_segment a b
  isCompact' := by
    first
    | rw [segment_eq_image]
      exact isCompact_Icc.image (by fun_prop)
  nonempty' := ⟨a, left_mem_segment ℝ a b⟩

