        (↑(∑ j, t j • K j) : Set E) := by
      first
      | rw [coe_sum_body]
        exact (D.body_eq t ht).symm
    have hS : IsCompact (PolyhedralSupport.body D.normal (D.height t)) := by
      first
      | rw [hbody]
        exact (∑ j, t j • K j).isCompact
