    · by_cases hv : 0 ≤ l v
      · have hp : (1 / 2 : ℝ) • v ∈ PlanarCorner.segmentBody v :=
          ⟨1 / 2, ⟨by norm_num, le_rfl⟩, rfl⟩
        have h := SupportGeometry.le_support (PlanarCorner.segmentBody v).isCompact l hp
