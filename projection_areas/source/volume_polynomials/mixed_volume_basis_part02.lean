    (K : ι → ConvexBody E) (A : ConvexBody E) :
    mixedArea μ A (∑ i ∈ s, K i) = ∑ i ∈ s, mixedArea μ A (K i) := by
  first
  | rw [mixedArea_symm, mixedArea_sum_left]
    exact Finset.sum_congr rfl (fun i _ => mixedArea_symm μ (K i) A)

