section Source_PaperInterfaces

@[expose] public section

/-!
# Interfaces to the statements of the paper

Coordinate values and their planar measures are unchanged when a finite
coordinate space is equipped with its Euclidean norm. These lemmas connect
the geometric constructions to the common realization locus used in the
main statements. The final construction includes every dimension at most
four and every zero pattern.
-/

noncomputable section
open Set MeasureTheory Matrix
open scoped Topology

namespace ProjectionAreaPaper

open ProjectionAreaTopology ProjectionAreaMixedGeometry
open ProjectionAreaRankThree ProjectionAreaReplication VolumePolynomials

def piCoordinates (n : ℕ) : CoordinateSpace n ≃L[ℝ] V n :=
  PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin n => ℝ)

def asPiBody {n : ℕ} (K : CoordinateBody n) : ProjectionAreaMixedGeometry.Body n :=
  mapBody (piCoordinates n).toContinuousLinearMap K

def asEuclideanBody {n : ℕ} (K : ProjectionAreaMixedGeometry.Body n) : CoordinateBody n :=
  mapBody (piCoordinates n).symm.toContinuousLinearMap K

theorem coordinateAreaMatrix_asPiBody {n : ℕ} (K : CoordinateBody n) :
    coordinateAreaMatrix (asPiBody K) = coordinateAreas K := by
  ext i j
  change volume.real ((fun x : V n => ![x i,x j]) ''
    ((piCoordinates n) '' (K : Set (CoordinateSpace n)))) = _
  rw [Set.image_image]
  congr 1
  apply Set.image_congr
  intro x hx
  ext k
  fin_cases k <;> rfl

theorem coordinateAreas_asEuclideanBody {n : ℕ} (K : ProjectionAreaMixedGeometry.Body n) :
    coordinateAreas (asEuclideanBody K) = coordinateAreaMatrix K := by
  ext i j
  change volume.real (coordinateProjection i j ''
    ((piCoordinates n).symm '' (K : Set (V n)))) = _
  rw [Set.image_image]
  congr 1
  apply Set.image_congr
  intro x hx
  ext k
  fin_cases k <;> rfl

theorem mem_realization_iff_piBody {n : ℕ} (q : AreaArray n) :
    q ∈ realizationLocus n ↔
      ∃ K : ProjectionAreaMixedGeometry.Body n, coordinateAreaMatrix K = q := by
  constructor
  · rintro ⟨K,rfl⟩
    exact ⟨asPiBody K,coordinateAreaMatrix_asPiBody K⟩
  · rintro ⟨K,hK⟩
    exact ⟨asEuclideanBody K,(coordinateAreas_asEuclideanBody K).trans hK⟩

theorem mem_realization_of_compact_convex {n : ℕ} (K : Set (V n))
    (hK : IsCompact K) (hc : Convex ℝ K) (hne : K.Nonempty)
    (q : AreaArray n)
    (hareas : ∀ i j, volume.real (ProjectionAreaTransforms.projectN i j '' K) = q i j) :
    q ∈ realizationLocus n := by
  apply (mem_realization_iff_piBody q).mpr
  let B : ProjectionAreaMixedGeometry.Body n := ⟨K,hc,hK,hne⟩
  refine ⟨B,?_⟩
  ext i j
  exact hareas i j

/-- The complete recovered four-dimensional sufficiency theorem, phrased
in the common Euclidean realization locus. -/
theorem four_realizable_of_det_nonpos (Q : NonnegativeHollowMatrix 4)
    (hdet : Q.entries.det ≤ 0) : Q.entries ∈ realizationLocus 4 := by
  have hsymm : Q.entries.IsSymm := by
    ext i j
    exact Q.symmetric j i
  obtain ⟨K,hK,hc,hne,harea⟩ :=
    ProjectionAreaFourDimensional.exists_realizer_of_nonpositive_determinant
      Q.entries (Matrix.isHermitian_iff_isSymm.mpr hsymm) Q.hollow Q.nonnegative hdet
  exact mem_realization_of_compact_convex K hK hc hne Q.entries harea

theorem four_realizable_of_rank_le_three (Q : NonnegativeHollowMatrix 4)
    (hrank : Q.entries.rank ≤ 3) : Q.entries ∈ realizationLocus 4 := by
  apply four_realizable_of_det_nonpos Q
  have hz : Q.entries.det = 0 := by
    by_contra hn
    have hfull := Matrix.rank_of_det_ne_zero hn
    norm_num at hfull
    omega
  exact hz.le

def padFour {n : ℕ} (Q : NonnegativeHollowMatrix n) : NonnegativeHollowMatrix 4 where
  entries i j := if hi : i.val < n then
    if hj : j.val < n then Q.entries ⟨i.val,hi⟩ ⟨j.val,hj⟩ else 0 else 0
  hollow := by
    intro i
    by_cases hi : i.val < n <;> simp [hi,Q.hollow]
  symmetric := by
    intro i j
    by_cases hi : i.val < n <;> by_cases hj : j.val < n <;> simp [hi,hj,Q.symmetric]
  nonnegative := by
    intro i j
    split_ifs <;> first | exact Q.nonnegative _ _ | exact le_rfl

theorem padFour_principal {n : ℕ} (Q : NonnegativeHollowMatrix n) (hn : n ≤ 4) :
    (padFour Q).entries.submatrix (Fin.castLE hn) (Fin.castLE hn) = Q.entries := by
  ext i j
  simp [padFour,Matrix.submatrix,i.isLt,j.isLt]

theorem padFour_det_zero_of_lt {n : ℕ} (Q : NonnegativeHollowMatrix n) (hn : n < 4) :
    (padFour Q).entries.det = 0 := by
  apply Matrix.det_eq_zero_of_row_eq_zero (3 : Fin 4)
  intro j
  change (if hi : (3 : ℕ) < n then
    if hj : j.val < n then Q.entries ⟨3, hi⟩ ⟨j.val, hj⟩ else 0 else 0) = 0
  rw [dif_neg (show ¬ (3 : ℕ) < n by omega)]

/-- Every nonnegative hollow rank-at-most-three array on at most four
labels is realized, including dimensions zero through three. -/
theorem rank_le_three_realizable_of_dimension_le_four {n : ℕ}
    (Q : NonnegativeHollowMatrix n) (hn : n ≤ 4) (hrank : Q.entries.rank ≤ 3) :
    Q.entries ∈ realizationLocus n := by
  rcases lt_or_eq_of_le hn with hn | hn
  · have hpad := four_realizable_of_det_nonpos (padFour Q) (padFour_det_zero_of_lt Q hn).le
    have hprincipal := principal_mem_realization (Fin.castLE hn.le) hpad
    rwa [padFour_principal Q hn.le] at hprincipal
  · subst n
    exact four_realizable_of_rank_le_three Q hrank

def positiveToNonnegative {n : ℕ} (P : PositiveHollowMatrix n) :
    NonnegativeHollowMatrix n where
  entries := P.entries
  hollow := P.hollow
  symmetric := P.symmetric
  nonnegative := by
    intro i j
    by_cases hij : i=j
    · subst j
      rw [P.hollow]
    · exact (P.positive i j hij).le

theorem positive_rank_le_three_realizable_of_dimension_le_four {n : ℕ}
    (P : PositiveHollowMatrix n) (hn : n ≤ 4) (hrank : P.entries.rank ≤ 3) :
    P.entries ∈ realizationLocus n :=
  rank_le_three_realizable_of_dimension_le_four (positiveToNonnegative P) hn hrank

/-- Every four-coordinate restriction in Theorem 1.1 is realized by one
actual nonempty compact convex body. The selection need not be injective. -/
theorem four_principal_realizable_of_rank_le_three {n : ℕ}
    (Q : NonnegativeHollowMatrix n) (hrank : Q.entries.rank ≤ 3) (σ : Fin 4 → Fin n) :
    Q.entries.submatrix σ σ ∈ realizationLocus 4 := by
  let P : NonnegativeHollowMatrix 4 :=
    ⟨Q.entries.submatrix σ σ,fun i => Q.hollow (σ i),
      fun i j => Q.symmetric (σ i) (σ j),fun i j => Q.nonnegative (σ i) (σ j)⟩
  exact four_realizable_of_rank_le_three P ((Q.entries.rank_submatrix_le σ σ).trans hrank)

end ProjectionAreaPaper

end
end
end Source_PaperInterfaces

