section Source_SpectralZeroReduction

@[expose] public section

/-!
# Zero-area reduction from local spectral inequalities

This is Proposition 6.1 with its full local hypothesis. There is no
global rank bound. The quotient is the actual quotient of nonzero rows
by zero mutual entry, and every choice of one original coordinate from
each class is permitted. Exact and limiting realizability use the fixed
coordinate projection and coordinate replication maps already proved for
actual compact convex bodies.
-/

noncomputable section

open Set Matrix MeasureTheory
open scoped Topology
open ProjectionAreaRankThree ProjectionAreaTopology ProjectionAreaReplication

namespace ProjectionAreaReplication

/-- Fixed coordinate repetition and diagonal scaling cannot increase
matrix rank. Zero factors and repeated coordinates are allowed. -/
theorem rank_replicateArray_le {m n : ℕ} (σ : Fin n → Fin m)
    (r : Fin n → ℝ) (q : AreaArray m) : (replicateArray σ r q).rank ≤ q.rank := by
  have he : replicateArray σ r q =
      Matrix.diagonal r * q.submatrix σ σ * Matrix.diagonal r := by
    ext i j
    simp only [replicateArray, Matrix.mul_diagonal, Matrix.diagonal_mul,
      Matrix.submatrix, Matrix.of_apply]
    ring
  rw [he]
  exact (Matrix.rank_mul_le_left _ _).trans
    ((Matrix.rank_mul_le_right _ _).trans (Matrix.rank_submatrix_le q σ σ))

end ProjectionAreaReplication

namespace ProjectionAreaSpectralZero

variable {n : ℕ} (Q : NonnegativeHollowMatrix n)

/-- Every principal matrix on four distinct original coordinates has at
most one positive eigenvalue, counted with multiplicity in Mathlib's
actual Hermitian spectral list. -/
def LocalFourSpectral : Prop :=
  ∀ σ : Fin 4 → Fin n, Function.Injective σ →
    ∃ hM : (Q.entries.submatrix σ σ).IsHermitian,
      (Finset.univ.filter fun i => 0 < hM.eigenvalues i).card ≤ 1

/-- The local spectral condition forces the zero-edge cross-minor
identity. Repeated labels are handled directly, so this remains valid
also in ambient dimensions below four. -/
theorem cross_minor_eq_zero (hlocal : LocalFourSpectral Q)
    (i j : Fin n) (hzero : Q.entries i j = 0) (k l : Fin n) :
    Q.entries i k * Q.entries j l = Q.entries i l * Q.entries j k := by
  by_cases hij : i = j
  · subst j
    ring
  by_cases hik : i = k
  · subst k
    simp [Q.hollow, Q.symmetric j i, hzero]
  by_cases hil : i = l
  · subst l
    simp [Q.hollow, Q.symmetric j i, hzero]
  by_cases hjk : j = k
  · subst k
    simp [Q.hollow, hzero]
  by_cases hjl : j = l
  · subst l
    simp [Q.hollow, hzero]
  by_cases hkl : k = l
  · subst l
    rfl
  let σ : Fin 4 → Fin n := ![i, j, k, l]
  have hσ : Function.Injective σ := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all [σ]
  obtain ⟨hM, hcount⟩ := hlocal σ hσ
  have h := ProjectionAreaSpectralFour.zero_entry_cross_minor_of_spectral
    (Q.entries.submatrix σ σ) hM
    (fun a => by simpa only [Matrix.submatrix_apply] using Q.hollow (σ a))
    (by simpa [Matrix.submatrix_apply, σ] using hzero) hcount
  simpa [Matrix.submatrix, σ] using h

/-- Zero entries between active rows are exactly positive proportionality. -/
theorem zero_iff_positive_proportional (hlocal : LocalFourSpectral Q)
    (i j : Q.ActiveLabels) :
    Q.entries i.val j.val = 0 ↔
      ∃ r : ℝ, 0 < r ∧ ∀ k, Q.entries j.val k = r * Q.entries i.val k :=
  Q.zero_iff_positive_proportional_of_cross_minors
    (cross_minor_eq_zero Q hlocal) i.val j.val i.property j.property

/-- The exact zero-area relation on the actual nonzero original rows. -/
def zeroSetoid (hlocal : LocalFourSpectral Q) : Setoid Q.ActiveLabels where
  r i j := Q.entries i.val j.val = 0
  iseqv := {
    refl := fun i => Q.hollow i.val
    symm := by
      intro i j hij
      simpa only [Q.symmetric j.val i.val] using hij
    trans := by
      intro i j k hij hjk
      obtain ⟨r, hr, hrow⟩ := (zero_iff_positive_proportional Q hlocal i j).mp hij
      have h := hrow k.val
      rw [hjk] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hr.ne' }

abbrev Classes (hlocal : LocalFourSpectral Q) := Quotient (zeroSetoid Q hlocal)

instance classesFintype (hlocal : LocalFourSpectral Q) : Fintype (Classes Q hlocal) :=
  Fintype.ofFinite _

/-- The rank-three development and the general local-spectral development
use exactly the same equivalence relation, not merely isomorphic patterns. -/
theorem zeroSetoid_eq_rank (hlocal : LocalFourSpectral Q) (hrank : Q.entries.rank ≤ 3) :
    zeroSetoid Q hlocal = Q.zeroSetoid hrank := rfl

theorem classes_card_eq_rank (hlocal : LocalFourSpectral Q) (hrank : Q.entries.rank ≤ 3) :
    Fintype.card (Classes Q hlocal) = Fintype.card (Q.Classes hrank) := by
  let e : Classes Q hlocal ≃ Q.Classes hrank := Equiv.refl _
  exact Fintype.card_congr e

def activeClass (hlocal : LocalFourSpectral Q) (i : Q.ActiveLabels) : Classes Q hlocal :=
  Quotient.mk (zeroSetoid Q hlocal) i

/-- A completely arbitrary choice of one actual original coordinate in
each zero-area class. The defining property is precisely being a section
of the quotient map. -/
structure Representatives (hlocal : LocalFourSpectral Q) where
  label : Classes Q hlocal → Q.ActiveLabels
  class_label : ∀ c, activeClass Q hlocal (label c) = c

/-- Such representative selections always exist. -/
def canonicalRepresentatives (hlocal : LocalFourSpectral Q) : Representatives Q hlocal where
  label := Quotient.out
  class_label := Quotient.out_eq

variable (hlocal : LocalFourSpectral Q) (R : Representatives Q hlocal)

def representative (i : Fin (Fintype.card (Classes Q hlocal))) : Fin n :=
  (R.label ((Fintype.equivFin (Classes Q hlocal)).symm i)).val

theorem representative_injective : Function.Injective (representative Q hlocal R) := by
  intro i j hij
  have hlabels : R.label ((Fintype.equivFin (Classes Q hlocal)).symm i) =
      R.label ((Fintype.equivFin (Classes Q hlocal)).symm j) := Subtype.ext hij
  have hclasses := congrArg (activeClass Q hlocal) hlabels
  rw [R.class_label, R.class_label] at hclasses
  exact (Fintype.equivFin (Classes Q hlocal)).symm.injective hclasses

/-- The reduced positive matrix is literally a selected principal matrix,
with no averaging or modification of entries. -/
def quotientPositive : PositiveHollowMatrix (Fintype.card (Classes Q hlocal)) where
  entries := Q.entries.submatrix (representative Q hlocal R) (representative Q hlocal R)
  hollow := fun i => Q.hollow _
  symmetric := fun i j => Q.symmetric _ _
  positive := by
    intro i j hij
    apply lt_of_le_of_ne (Q.nonnegative _ _)
    intro hzero
    have hrel : (zeroSetoid Q hlocal).r
        (R.label ((Fintype.equivFin (Classes Q hlocal)).symm i))
        (R.label ((Fintype.equivFin (Classes Q hlocal)).symm j)) := hzero.symm
    have hclasses := Quotient.sound hrel
    change activeClass Q hlocal (R.label ((Fintype.equivFin (Classes Q hlocal)).symm i)) =
      activeClass Q hlocal (R.label ((Fintype.equivFin (Classes Q hlocal)).symm j)) at hclasses
    rw [R.class_label, R.class_label] at hclasses
    exact hij ((Fintype.equivFin (Classes Q hlocal)).symm.injective hclasses)

theorem row_factor_exists (i : Q.ActiveLabels) :
    ∃ r : ℝ, 0 < r ∧ ∀ k,
      Q.entries i.val k = r * Q.entries (R.label (activeClass Q hlocal i)).val k := by
  have hzero : Q.entries (R.label (activeClass Q hlocal i)).val i.val = 0 :=
    Quotient.exact (R.class_label (activeClass Q hlocal i))
  exact (zero_iff_positive_proportional Q hlocal (R.label (activeClass Q hlocal i)) i).mp hzero

def rowFactor (i : Q.ActiveLabels) : ℝ := Classical.choose (row_factor_exists Q hlocal R i)

theorem rowFactor_pos (i : Q.ActiveLabels) : 0 < rowFactor Q hlocal R i :=
  (Classical.choose_spec (row_factor_exists Q hlocal R i)).1

theorem rowFactor_spec (i : Q.ActiveLabels) (k : Fin n) :
    Q.entries i.val k = rowFactor Q hlocal R i *
      Q.entries (R.label (activeClass Q hlocal i)).val k :=
  (Classical.choose_spec (row_factor_exists Q hlocal R i)).2 k

/-- Representative coordinates have replication factor exactly one. -/
theorem rowFactor_representative (c : Classes Q hlocal) :
    rowFactor Q hlocal R (R.label c) = 1 := by
  have hex : ∃ k, Q.entries (R.label c).val k ≠ 0 := by
    by_contra! h
    apply (R.label c).property
    funext k
    exact h k
  obtain ⟨k, hk⟩ := hex
  have hf := rowFactor_spec Q hlocal R (R.label c) k
  rw [R.class_label] at hf
  apply mul_right_cancel₀ hk
  simpa only [one_mul] using hf.symm

theorem entries_factor (i j : Q.ActiveLabels) :
    Q.entries i.val j.val = rowFactor Q hlocal R i * rowFactor Q hlocal R j *
      Q.entries (R.label (activeClass Q hlocal i)).val
        (R.label (activeClass Q hlocal j)).val := by
  rw [rowFactor_spec Q hlocal R i j.val]
  rw [Q.symmetric (R.label (activeClass Q hlocal i)).val j.val]
  rw [rowFactor_spec Q hlocal R j (R.label (activeClass Q hlocal i)).val]
  rw [Q.symmetric (R.label (activeClass Q hlocal j)).val
    (R.label (activeClass Q hlocal i)).val]
  ring

theorem classes_nonempty (hQ : Q.entries ≠ 0) : Nonempty (Classes Q hlocal) := by
  have hex : ∃ i, Q.entries i ≠ 0 := by
    by_contra! h
    apply hQ
    funext i
    exact h i
  obtain ⟨i, hi⟩ := hex
  exact ⟨activeClass Q hlocal ⟨i, hi⟩⟩

def weights (i : Fin n) : ℝ := by
  classical
  exact if hi : Q.entries i ≠ 0 then rowFactor Q hlocal R ⟨i, hi⟩ else 0

def coordinates (hQ : Q.entries ≠ 0) (i : Fin n) :
    Fin (Fintype.card (Classes Q hlocal)) := by
  classical
  exact (Fintype.equivFin (Classes Q hlocal))
    (if hi : Q.entries i ≠ 0 then activeClass Q hlocal ⟨i, hi⟩
      else Classical.choice (classes_nonempty Q hlocal hQ))

theorem weights_nonnegative : ∀ i, 0 ≤ weights Q hlocal R i := by
  classical
  intro i
  unfold weights
  split_ifs with hi
  · exact (rowFactor_pos Q hlocal R ⟨i, hi⟩).le
  · exact le_rfl

/-- Entrywise reconstruction, including every deleted zero row. The
coordinate choices and factors are fixed once the matrix and its
representatives have been selected. -/
theorem entries_replicate_quotient (hQ : Q.entries ≠ 0) :
    Q.entries = replicateArray (coordinates Q hlocal hQ) (weights Q hlocal R)
      (quotientPositive Q hlocal R).entries := by
  classical
  ext i j
  by_cases hi : Q.entries i ≠ 0
  · by_cases hj : Q.entries j ≠ 0
    · simp only [replicateArray, coordinates, weights, dif_pos hi, dif_pos hj,
        quotientPositive, Matrix.submatrix, Matrix.of_apply, representative,
        Equiv.symm_apply_apply]
      exact entries_factor Q hlocal R ⟨i, hi⟩ ⟨j, hj⟩
    · have hz : Q.entries j = 0 := not_not.mp hj
      have he : Q.entries i j = 0 := by
        simpa only [hz, Pi.zero_apply] using Q.symmetric i j
      simp [replicateArray, weights, hj, he]
  · have hz : Q.entries i = 0 := not_not.mp hi
    simp [replicateArray, weights, hi, hz]

/-- Collapsing proportional rows preserves the full original rank,
which is unrestricted in this proposition. -/
theorem quotient_rank : (quotientPositive Q hlocal R).entries.rank = Q.entries.rank := by
  apply le_antisymm
  · exact Matrix.rank_submatrix_le Q.entries (representative Q hlocal R)
      (representative Q hlocal R)
  · by_cases hQ : Q.entries = 0
    · simp only [hQ, Matrix.rank_zero, Nat.zero_le]
    · rw [entries_replicate_quotient Q hlocal R hQ]
      exact rank_replicateArray_le _ _ _

theorem realization_iff_quotient :
    Q.entries ∈ realizationLocus n ↔
      (quotientPositive Q hlocal R).entries ∈
        realizationLocus (Fintype.card (Classes Q hlocal)) := by
  constructor
  · exact principal_mem_realization (representative Q hlocal R)
  · intro hq
    by_cases hQ : Q.entries = 0
    · simpa only [hQ] using zero_mem_realization n
    · rw [entries_replicate_quotient Q hlocal R hQ]
      exact replicate_mem_realization (coordinates Q hlocal hQ) (weights Q hlocal R)
        (weights_nonnegative Q hlocal R) hq

theorem closure_iff_quotient :
    Q.entries ∈ closure (realizationLocus n) ↔
      (quotientPositive Q hlocal R).entries ∈
        closure (realizationLocus (Fintype.card (Classes Q hlocal))) := by
  constructor
  · exact principal_mem_closure (representative Q hlocal R)
  · intro hq
    by_cases hQ : Q.entries = 0
    · simpa only [hQ] using subset_closure (zero_mem_realization n)
    · rw [entries_replicate_quotient Q hlocal R hQ]
      exact replicate_mem_closure (coordinates Q hlocal hQ) (weights Q hlocal R)
        (weights_nonnegative Q hlocal R) hq

/-- Proposition 6.1 in full, for every permitted representative choice.
The equivalence relation, proportionality criterion, positive reduced
matrix, exact rank, exact realizability, and closure equivalence are all
included. -/
theorem local_spectral_zero_reduction :
    Equivalence (fun i j : Q.ActiveLabels => Q.entries i.val j.val = 0) ∧
    (∀ i j : Q.ActiveLabels, Q.entries i.val j.val = 0 ↔
      ∃ r : ℝ, 0 < r ∧ ∀ k, Q.entries j.val k = r * Q.entries i.val k) ∧
    (∀ i j, i ≠ j → 0 < (quotientPositive Q hlocal R).entries i j) ∧
    (quotientPositive Q hlocal R).entries.rank = Q.entries.rank ∧
    (Q.entries ∈ realizationLocus n ↔ (quotientPositive Q hlocal R).entries ∈
      realizationLocus (Fintype.card (Classes Q hlocal))) ∧
    (Q.entries ∈ closure (realizationLocus n) ↔ (quotientPositive Q hlocal R).entries ∈
      closure (realizationLocus (Fintype.card (Classes Q hlocal)))) :=
  ⟨(zeroSetoid Q hlocal).iseqv, zero_iff_positive_proportional Q hlocal,
    (quotientPositive Q hlocal R).positive, quotient_rank Q hlocal R,
    realization_iff_quotient Q hlocal R, closure_iff_quotient Q hlocal R⟩

end ProjectionAreaSpectralZero

end
