section Source_MainRankResults

@[expose] public section

/-!
# The principal rank-three results

The realization locus in these statements is the image of the actual
coordinate-projection area map on nonempty compact convex Euclidean
bodies. All dimensions, all positive arrays, and all zero patterns in the
rank-at-most-three classification are quantified without restriction.
-/

noncomputable section
open Set Matrix MeasureTheory
open scoped Topology

namespace ProjectionAreaPaper

open ProjectionAreaTopology ProjectionAreaMixedGeometry ProjectionAreaEscape
open ProjectionAreaRankThree ProjectionAreaReplication

/-- The geometric five-label obstruction applies to every larger dimension
through an actual coordinate projection. -/
theorem positive_rank_le_three_not_realizable {n : ℕ}
    (P : PositiveHollowMatrix n) (hn : 5 ≤ n) (hrank : P.entries.rank ≤ 3) :
    P.entries ∉ realizationLocus n := by
  intro hreal
  let σ : Fin 5 → Fin n := Fin.castLE hn
  have hselected := principal_mem_realization σ hreal
  obtain ⟨K,hK⟩ := (mem_realization_iff_piBody (P.entries.submatrix σ σ)).mp hselected
  have hpos (i j : Fin 5) (hij : i ≠ j) : 0 < coordinateAreaMatrix K i j := by
    rw [hK]
    exact P.positive (σ i) (σ j) (fun he => hij ((Fin.castLEEmb hn).injective he))
  apply five_positive_rank_not_le_three K hpos
  rw [hK]
  exact (P.entries.rank_submatrix_le σ σ).trans hrank

/-- The weighted-triangle obstruction includes witnesses with zero weights. -/
theorem positive_rank_le_three_not_in_escapeCone {n : ℕ}
    (P : PositiveHollowMatrix n) (hn : 5 ≤ n) (hrank : P.entries.rank ≤ 3) :
    P.entries ∉ EscapeCone n := by
  rintro ⟨_,_,_,w,hw,hne,htri⟩
  apply P.weighted_triangles_obstruction hn hrank
  refine ⟨w,hw,hne,?_⟩
  intro i j k hij hik hjk
  simpa only [mul_comm] using htri i j k hij hik hjk

/-- Theorem 1.1, nonapproximation direction, in the slightly stronger
rank-at-most-three form. Bounded sequences are handled by compactness;
unbounded sequences are excluded by their genuine escape weights. -/
theorem positive_rank_le_three_not_in_closure {n : ℕ}
    (P : PositiveHollowMatrix n) (hn : 5 ≤ n) (hrank : P.entries.rank ≤ 3) :
    P.entries ∉ closure (realizationLocus n) := by
  intro hclosure
  rw [ProjectionAreaTopology.closure_realizationLocus] at hclosure
  rcases hclosure with hreal | hescape
  · exact positive_rank_le_three_not_realizable P hn hrank hreal
  · exact positive_rank_le_three_not_in_escapeCone P hn hrank
      (ProjectionAreaEscapeNormalization.divergingDiameterLimits_subset_escapeCone n hescape)

/-- Theorem 1.1 in the exact rank-three form of the paper. Each four-label
restriction is realized by one actual body, while the entire array cannot
even be approximated by projection-area arrays. -/
theorem positive_rank_three_obstruction {n : ℕ}
    (P : PositiveHollowMatrix n) (hn : 5 ≤ n) (hrank : P.entries.rank = 3) :
    P.entries ∉ closure (realizationLocus n) ∧
      ∀ σ : Fin 4 → Fin n, Function.Injective σ →
        P.entries.submatrix σ σ ∈ realizationLocus 4 := by
  refine ⟨positive_rank_le_three_not_in_closure P hn hrank.le,?_⟩
  intro σ _
  exact four_principal_realizable_of_rank_le_three (positiveToNonnegative P) hrank.le σ

namespace NonnegativeHollowMatrix

variable {n : ℕ} (Q : ProjectionAreaRankThree.NonnegativeHollowMatrix n)

/-- The class count refers to the actual quotient of nonzero rows by zero
mutual area. Its representatives, reconstruction factors, and exact/limit
equivalences were proved in `CoordinateReplication`. -/
theorem realizable_iff_at_most_four_classes (hrank : Q.entries.rank ≤ 3) :
    Q.entries ∈ realizationLocus n ↔ Fintype.card (Q.Classes hrank) ≤ 4 := by
  constructor
  · intro hreal
    by_contra hn
    have hlarge : 5 ≤ Fintype.card (Q.Classes hrank) := by omega
    have hquot := (Q.realization_iff_quotient hrank).mp hreal
    have hquotrank : (Q.quotientPositive hrank).entries.rank ≤ 3 := by
      rw [Q.quotientPositive_rank hrank]
      exact hrank
    exact positive_rank_le_three_not_realizable (Q.quotientPositive hrank) hlarge hquotrank hquot
  · intro hsmall
    apply (Q.realization_iff_quotient hrank).mpr
    apply positive_rank_le_three_realizable_of_dimension_le_four (Q.quotientPositive hrank) hsmall
    rw [Q.quotientPositive_rank hrank]
    exact hrank

theorem closure_iff_at_most_four_classes (hrank : Q.entries.rank ≤ 3) :
    Q.entries ∈ closure (realizationLocus n) ↔ Fintype.card (Q.Classes hrank) ≤ 4 := by
  constructor
  · intro hclosure
    by_contra hn
    have hlarge : 5 ≤ Fintype.card (Q.Classes hrank) := by omega
    have hquot := (Q.closure_iff_quotient hrank).mp hclosure
    have hquotrank : (Q.quotientPositive hrank).entries.rank ≤ 3 := by
      rw [Q.quotientPositive_rank hrank]
      exact hrank
    exact positive_rank_le_three_not_in_closure (Q.quotientPositive hrank) hlarge hquotrank hquot
  · intro hsmall
    exact subset_closure ((realizable_iff_at_most_four_classes Q hrank).mpr hsmall)

/-- Theorem 6.2: exact realization, limiting realization, and the stated
quotient criterion are equivalent for every nonnegative hollow symmetric
matrix of rank at most three. The all-zero case is included. -/
theorem rank_at_most_three_classification (hrank : Q.entries.rank ≤ 3) :
    (Q.entries ∈ realizationLocus n ↔ Q.entries ∈ closure (realizationLocus n)) ∧
      (Q.entries ∈ realizationLocus n ↔ Fintype.card (Q.Classes hrank) ≤ 4) := by
  have he := realizable_iff_at_most_four_classes Q hrank
  have hc := closure_iff_at_most_four_classes Q hrank
  exact ⟨he.trans hc.symm,he⟩

