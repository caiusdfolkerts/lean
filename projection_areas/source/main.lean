section Source_CoordinateReplication

@[expose] public section

/-!
# Coordinate replication and the zero-area quotient

All realization statements use the actual planar Lebesgue projection areas
of nonempty compact convex bodies in Euclidean space. Fixed coordinate
selection and nonnegative coordinate replication preserve realizability;
the induced linear maps on area arrays also preserve its closure.

Combining these geometric identities with the rank-three matrix quotient
proves that deleting zero rows and identifying proportional rows preserves
both exact and limiting realizability, including the all-zero matrix.
-/

noncomputable section

open Set MeasureTheory
open scoped Topology
open ProjectionAreaTopology

namespace ProjectionAreaReplication

/-- A fixed weighted repetition of coordinates, as an actual continuous linear map. -/
def weightedCoordinates {m n : ℕ} (σ : Fin n → Fin m) (r : Fin n → ℝ) :
    CoordinateSpace m →L[ℝ] CoordinateSpace n :=
  { toLinearMap :=
      (WithLp.linearEquiv 2 ℝ (Fin n → ℝ)).symm.toLinearMap.comp
        ((ProjectionAreaTransforms.coordinateImage σ r).comp
          (WithLp.linearEquiv 2 ℝ (Fin m → ℝ)).toLinearMap)
    cont := LinearMap.continuous_of_finiteDimensional _ }

@[simp] theorem weightedCoordinates_apply {m n : ℕ}
    (σ : Fin n → Fin m) (r : Fin n → ℝ) (x : CoordinateSpace m) (i : Fin n) :
    weightedCoordinates σ r x i = r i * x (σ i) := rfl

/-- The corresponding fixed linear map on projection-area arrays. -/
def replicateArray {m n : ℕ} (σ : Fin n → Fin m) (r : Fin n → ℝ)
    (q : AreaArray m) : AreaArray n := fun i j => r i * r j * q (σ i) (σ j)

theorem continuous_replicateArray {m n : ℕ} (σ : Fin n → Fin m) (r : Fin n → ℝ) :
    Continuous (replicateArray σ r) := by
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  exact continuous_const.mul ((continuous_apply (σ j)).comp (continuous_apply (σ i)))

theorem weighted_projection_sets {m n : ℕ}
    (σ : Fin n → Fin m) (r : Fin n → ℝ) (S : Set (CoordinateSpace m))
    (i j : Fin n) :
    coordinateProjection i j '' (weightedCoordinates σ r '' S) =
      ProjectionAreaTransforms.diagonalPlane (r i) (r j) ''
        (coordinateProjection (σ i) (σ j) '' S) := by
  simp only [Set.image_image]
  congr 1
  funext x
  ext k
  fin_cases k <;>
    simp [coordinateProjection, ProjectionAreaTransforms.diagonalPlane_apply]

/-- The exact ordinary-area formula, including repeated and zero coordinates. -/
theorem coordinateAreas_weighted {m n : ℕ}
    (σ : Fin n → Fin m) (r : Fin n → ℝ) (K : CoordinateBody m) (i j : Fin n) :
    coordinateAreas (linearImageBody (weightedCoordinates σ r) K) i j =
      |r i * r j| * coordinateAreas K (σ i) (σ j) := by
  change (volume : Measure ProjectionAreaTopology.Plane).real
    (coordinateProjection i j '' (weightedCoordinates σ r '' (K : Set (CoordinateSpace m)))) =
      |r i * r j| * (volume : Measure ProjectionAreaTopology.Plane).real
        (coordinateProjection (σ i) (σ j) '' (K : Set (CoordinateSpace m)))
  rw [weighted_projection_sets, ProjectionAreaTransforms.diagonalPlane_area]

theorem coordinateAreas_replicate {m n : ℕ}
    (σ : Fin n → Fin m) (r : Fin n → ℝ) (hr : ∀ i, 0 ≤ r i) (K : CoordinateBody m) :
    coordinateAreas (linearImageBody (weightedCoordinates σ r) K) =
      replicateArray σ r (coordinateAreas K) := by
  ext i j
  simpa only [replicateArray, abs_of_nonneg (mul_nonneg (hr i) (hr j))] using
    coordinateAreas_weighted σ r K i j

theorem replicate_mem_realization {m n : ℕ}
    (σ : Fin n → Fin m) (r : Fin n → ℝ) (hr : ∀ i, 0 ≤ r i)
    {q : AreaArray m} (hq : q ∈ realizationLocus m) :
    replicateArray σ r q ∈ realizationLocus n := by
  obtain ⟨K, rfl⟩ := hq
  exact ⟨linearImageBody (weightedCoordinates σ r) K,
    coordinateAreas_replicate σ r hr K⟩

theorem replicate_mem_closure {m n : ℕ}
    (σ : Fin n → Fin m) (r : Fin n → ℝ) (hr : ∀ i, 0 ≤ r i)
    {q : AreaArray m} (hq : q ∈ closure (realizationLocus m)) :
    replicateArray σ r q ∈ closure (realizationLocus n) := by
  have hs : realizationLocus m ⊆
      (replicateArray σ r) ⁻¹' closure (realizationLocus n) := by
    intro p hp
    exact subset_closure (replicate_mem_realization σ r hr hp)
  exact closure_minimal hs (isClosed_closure.preimage (continuous_replicateArray σ r)) hq

/-- Selection of any list of coordinates preserves exact realizability. -/
theorem principal_mem_realization {m n : ℕ} (σ : Fin m → Fin n)
    {q : AreaArray n} (hq : q ∈ realizationLocus n) :
    q.submatrix σ σ ∈ realizationLocus m := by
  have he : replicateArray σ (fun _ => 1) q = q.submatrix σ σ := by
    ext i j
    simp only [replicateArray, Matrix.submatrix_apply, one_mul]
  rw [← he]
  exact replicate_mem_realization σ (fun _ => 1) (fun _ => zero_le_one) hq

/-- The same fixed coordinate selection preserves limiting realizability. -/
theorem principal_mem_closure {m n : ℕ} (σ : Fin m → Fin n)
    {q : AreaArray n} (hq : q ∈ closure (realizationLocus n)) :
    q.submatrix σ σ ∈ closure (realizationLocus m) := by
  have he : replicateArray σ (fun _ => 1) q = q.submatrix σ σ := by
    ext i j
    simp only [replicateArray, Matrix.submatrix_apply, one_mul]
  rw [← he]
  exact replicate_mem_closure σ (fun _ => 1) (fun _ => zero_le_one) hq

theorem coordinateAreas_point {n : ℕ} (v : CoordinateSpace n) :
    coordinateAreas (pointBody v) = 0 := by
  ext i j
  simp [coordinateAreas, pointBody, measureReal_def]

/-- The zero matrix is realized by an actual singleton in every dimension. -/
theorem zero_mem_realization (n : ℕ) : (0 : AreaArray n) ∈ realizationLocus n :=
  ⟨pointBody 0, coordinateAreas_point 0⟩

end ProjectionAreaReplication

namespace ProjectionAreaRankThree.NonnegativeHollowMatrix

open ProjectionAreaReplication

variable {n : ℕ} (Q : NonnegativeHollowMatrix n)

theorem classes_nonempty (hrank : Q.entries.rank ≤ 3) (hQ : Q.entries ≠ 0) :
    Nonempty (Q.Classes hrank) := by
  have hex : ∃ i, Q.entries i ≠ 0 := by
    by_contra! h
    apply hQ
    funext i
    exact h i
  obtain ⟨i, hi⟩ := hex
  exact ⟨Q.activeClass hrank ⟨i, hi⟩⟩

/-- The nonnegative replication factors, extended by zero at deleted rows. -/
def quotientWeights (hrank : Q.entries.rank ≤ 3) (i : Fin n) : ℝ := by
  classical
  exact if hi : Q.entries i ≠ 0 then Q.rowFactor hrank ⟨i, hi⟩ else 0

/-- Coordinate classes, with an arbitrary harmless choice at zero-factor rows. -/
def quotientCoordinates (hrank : Q.entries.rank ≤ 3) (hQ : Q.entries ≠ 0)
    (i : Fin n) : Fin (Fintype.card (Q.Classes hrank)) := by
  classical
  exact (Fintype.equivFin (Q.Classes hrank))
    (if hi : Q.entries i ≠ 0 then Q.activeClass hrank ⟨i, hi⟩
      else Classical.choice (classes_nonempty Q hrank hQ))

/-- The actual selected original coordinates of the quotient matrix. -/
def quotientRepresentative (hrank : Q.entries.rank ≤ 3)
    (i : Fin (Fintype.card (Q.Classes hrank))) : Fin n :=
  Q.quotientRep hrank ((Fintype.equivFin (Q.Classes hrank)).symm i)

theorem quotientWeights_nonnegative (hrank : Q.entries.rank ≤ 3) :
    ∀ i, 0 ≤ Q.quotientWeights hrank i := by
  classical
  intro i
  unfold quotientWeights
  split_ifs with hi
  · exact (Q.rowFactor_pos hrank ⟨i, hi⟩).le
  · exact le_rfl

theorem quotient_entries_principal (hrank : Q.entries.rank ≤ 3) :
    (Q.quotientPositive hrank).entries =
      Q.entries.submatrix (Q.quotientRepresentative hrank) (Q.quotientRepresentative hrank) := rfl

/-- The algebraic factorization in the form used by the geometric replication map. -/
theorem entries_replicate_quotient (hrank : Q.entries.rank ≤ 3) (hQ : Q.entries ≠ 0) :
    Q.entries = replicateArray (Q.quotientCoordinates hrank hQ) (Q.quotientWeights hrank)
      (Q.quotientPositive hrank).entries := by
  classical
  ext i j
  by_cases hi : Q.entries i ≠ 0
  · by_cases hj : Q.entries j ≠ 0
    · simp only [replicateArray, quotientCoordinates, quotientWeights, dif_pos hi, dif_pos hj,
        quotientPositive, Matrix.submatrix, Matrix.of_apply, Equiv.symm_apply_apply]
      exact Q.entries_factor hrank ⟨i, hi⟩ ⟨j, hj⟩
    · have hz : Q.entries j = 0 := not_not.mp hj
      have he : Q.entries i j = 0 := by
        simpa only [hz, Pi.zero_apply] using Q.symmetric i j
      simp [replicateArray, quotientWeights, hj, he]
  · have hz : Q.entries i = 0 := not_not.mp hi
    simp [replicateArray, quotientWeights, hi, hz]

/-- Exact realization is unchanged by the actual positive-row quotient. -/
theorem realization_iff_quotient (hrank : Q.entries.rank ≤ 3) :
    Q.entries ∈ realizationLocus n ↔
      (Q.quotientPositive hrank).entries ∈
        realizationLocus (Fintype.card (Q.Classes hrank)) := by
  constructor
  · intro hq
    rw [Q.quotient_entries_principal hrank]
    exact principal_mem_realization (Q.quotientRepresentative hrank) hq
  · intro hq
    by_cases hQ : Q.entries = 0
    · simpa only [hQ] using zero_mem_realization n
    · rw [Q.entries_replicate_quotient hrank hQ]
      exact replicate_mem_realization (Q.quotientCoordinates hrank hQ)
        (Q.quotientWeights hrank) (Q.quotientWeights_nonnegative hrank) hq

/-- Limiting realization is unchanged by the same fixed quotient maps. -/
theorem closure_iff_quotient (hrank : Q.entries.rank ≤ 3) :
    Q.entries ∈ closure (realizationLocus n) ↔
      (Q.quotientPositive hrank).entries ∈
        closure (realizationLocus (Fintype.card (Q.Classes hrank))) := by
  constructor
  · intro hq
    rw [Q.quotient_entries_principal hrank]
    exact principal_mem_closure (Q.quotientRepresentative hrank) hq
  · intro hq
    by_cases hQ : Q.entries = 0
    · simpa only [hQ] using (subset_closure (zero_mem_realization n))
    · rw [Q.entries_replicate_quotient hrank hQ]
      exact replicate_mem_closure (Q.quotientCoordinates hrank hQ)
        (Q.quotientWeights hrank) (Q.quotientWeights_nonnegative hrank) hq

end ProjectionAreaRankThree.NonnegativeHollowMatrix

end
end
end Source_CoordinateReplication

