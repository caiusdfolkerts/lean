section Source_BoundaryCorollary

@[expose] public section

/-!
# The five-label boundary corollary

The active cuts below are selected only from actual boundary equalities of
the five coordinate deletions. Proposition 2.3 makes this sparse collection
compatible. The finite cut theorem then gives the bound of three, and the
unique global partition into blocks of sizes two and three when at least
two boundary quartets occur. The square/cube hull proves sharpness.
-/

noncomputable section

open Set Matrix
open scoped BigOperators
open ProjectionAreaRankThree ProjectionAreaBoundaryKernel ProjectionBoundaryCuts
open ProjectionAreaSharpness

namespace ProjectionAreaMixedGeometry

/-- The equality specifying a particular one of the three balanced cuts
of the increasing coordinate deletion. -/
def BoundaryAt (K : Body 5) (m : Fin 5) (k : Fin 3) : Prop :=
  let M := coordinateAreaMatrix (deleteBody m K)
  BoundaryEquality (Real.sqrt (M 0 1 * M 2 3))
    (Real.sqrt (M 0 2 * M 1 3)) (Real.sqrt (M 0 3 * M 1 2)) k

theorem exists_boundaryAt_iff (K : Body 5) (m : Fin 5) :
    (∃ k, BoundaryAt K m k) ↔
      IsBoundaryQuartet (coordinateAreaMatrix (deleteBody m K)) := by
  constructor
  · rintro ⟨k, hk⟩
    fin_cases k
    · exact Or.inl hk
    · exact Or.inr (Or.inl hk)
    · exact Or.inr (Or.inr hk)
  · rintro (h | h | h)
    · exact ⟨0, h⟩
    · exact ⟨1, h⟩
    · exact ⟨2, h⟩

/-- A positive quartet has only one largest root product, hence only one
boundary cut. -/
theorem boundaryAt_unique (K : Body 5)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (m : Fin 5) (k l : Fin 3) (hk : BoundaryAt K m k) (hl : BoundaryAt K m l) :
    k = l := by
  have hp := positive_coordinateAreaMatrix_delete K hpositive m
  have hA : 0 < Real.sqrt
      (coordinateAreaMatrix (deleteBody m K) 0 1 *
        coordinateAreaMatrix (deleteBody m K) 2 3) :=
    Real.sqrt_pos.2 (mul_pos (hp 0 1 (by decide)) (hp 2 3 (by decide)))
  have hB : 0 < Real.sqrt
      (coordinateAreaMatrix (deleteBody m K) 0 2 *
        coordinateAreaMatrix (deleteBody m K) 1 3) :=
    Real.sqrt_pos.2 (mul_pos (hp 0 2 (by decide)) (hp 1 3 (by decide)))
  have hC : 0 < Real.sqrt
      (coordinateAreaMatrix (deleteBody m K) 0 3 *
        coordinateAreaMatrix (deleteBody m K) 1 2) :=
    Real.sqrt_pos.2 (mul_pos (hp 0 3 (by decide)) (hp 1 2 (by decide)))
  fin_cases k <;> fin_cases l <;>
    simp [BoundaryAt, BoundaryEquality] at hk hl ⊢ <;> linarith

set_option maxHeartbeats 4000000 in
/-- Reordering the four labels preserves the root equality attached to
their two-block partition. This is finite index algebra, with arbitrary
real entries throughout. -/
theorem boundary_equality_of_sign_partition (M : Matrix (Fin 4) (Fin 4) ℝ)
    (hsymm : ∀ i j, M i j = M j i) (k : Fin 3)
    (hb : BoundaryEquality (Real.sqrt (M 0 1 * M 2 3))
      (Real.sqrt (M 0 2 * M 1 3)) (Real.sqrt (M 0 3 * M 1 2)) k)
    (a b c d : Fin 4)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (hsab : (0 < canonicalSign k a ↔ 0 < canonicalSign k b))
    (hscd : (0 < canonicalSign k c ↔ 0 < canonicalSign k d))
    (hsac : ¬ (0 < canonicalSign k a ↔ 0 < canonicalSign k c)) :
    Real.sqrt (M a b * M c d) =
      Real.sqrt (M a c * M b d) + Real.sqrt (M a d * M b c) := by
  fin_cases k <;> fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d
  all_goals simp_all [canonicalSign, BoundaryEquality, hsymm, mul_comm, add_comm]
  all_goals rw [hsymm 1 0]
  all_goals exact hb.trans (add_comm _ _)

/-- Read a boundary cut on any four retained labels in any order. -/
theorem boundary_root_of_cut (K : Body 5) (m : Fin 5) (k : Fin 3)
    (hb : BoundaryAt K m k) (a b c d : Fin 5)
    (ha : a ≠ m) (hb' : b ≠ m) (hc : c ≠ m) (hd : d ≠ m)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (hsab : samePart m k a b) (hscd : samePart m k c d)
    (hsac : ¬ samePart m k a c) :
    Real.sqrt (coordinateAreaMatrix K a b * coordinateAreaMatrix K c d) =
      Real.sqrt (coordinateAreaMatrix K a c * coordinateAreaMatrix K b d) +
        Real.sqrt (coordinateAreaMatrix K a d * coordinateAreaMatrix K b c) := by
  let a' := deletedIndex m a ha
  let b' := deletedIndex m b hb'
  let c' := deletedIndex m c hc
  let d' := deletedIndex m d hd
  have hs (x y : Fin 5) (hx : x ≠ m) (hy : y ≠ m) :
      samePart m k x y ↔
        (0 < canonicalSign k (deletedIndex m x hx) ↔
          0 < canonicalSign k (deletedIndex m y hy)) := by
    simpa only [deletedIndex_spec] using
      samePart_succAbove_iff_canonicalSign m k
        (deletedIndex m x hx) (deletedIndex m y hy)
  have hinj (x y : Fin 5) (hx : x ≠ m) (hy : y ≠ m) (hxy : x ≠ y) :
      deletedIndex m x hx ≠ deletedIndex m y hy := by
    intro he
    apply hxy
    simpa only [deletedIndex_spec] using congrArg m.succAbove he
  have h := boundary_equality_of_sign_partition
    (coordinateAreaMatrix (deleteBody m K)) (coordinateAreaMatrix_symmetric _) k hb
    a' b' c' d' (hinj a b ha hb' hab) (hinj a c ha hc hac)
    (hinj a d ha hd had) (hinj b c hb' hc hbc) (hinj b d hb' hd hbd)
    (hinj c d hc hd hcd) ((hs a b ha hb').mp hsab)
    ((hs c d hc hd).mp hscd) (fun he => hsac ((hs a c ha hc).mpr he))
  simpa only [coordinateAreaMatrix_deleteBody, Matrix.submatrix_apply,
    a', b', c', d', deletedIndex_spec] using h

/-- Any sparse collection of actual boundary cuts is compatible. -/
theorem actual_boundary_choices_compatible (K : Body 5)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (choice : Fin 5 → Option (Fin 3))
    (hsound : ∀ m k, choice m = some k → BoundaryAt K m k) :
    CompatibleChoices choice := by
  by_contra hbad
  obtain ⟨e, k, l, hk, hl, h01, h23, h02, h12, h04, h01'⟩ :=
    incompatible_choices_cross_configuration choice hbad
  have hne (i j : Fin 5) (hij : i ≠ j) : e i ≠ e j :=
    fun he => hij (e.injective he)
  have hfirst := boundary_root_of_cut K (e 4) k (hsound _ _ hk)
    (e 0) (e 1) (e 2) (e 3)
    (hne 0 4 (by decide)) (hne 1 4 (by decide))
    (hne 2 4 (by decide)) (hne 3 4 (by decide))
    (hne 0 1 (by decide)) (hne 0 2 (by decide)) (hne 0 3 (by decide))
    (hne 1 2 (by decide)) (hne 1 3 (by decide)) (hne 2 3 (by decide))
    h01 h23 h02
  have hsecond := boundary_root_of_cut K (e 3) l (hsound _ _ hl)
    (e 0) (e 4) (e 1) (e 2)
    (hne 0 3 (by decide)) (hne 4 3 (by decide))
    (hne 1 3 (by decide)) (hne 2 3 (by decide))
    (hne 0 4 (by decide)) (hne 0 1 (by decide)) (hne 0 2 (by decide))
    (hne 4 1 (by decide)) (hne 4 2 (by decide)) (hne 1 2 (by decide))
    h04 h12 h01'
  let L := selectBody e K
  have hLpositive (i j : Fin 5) (hij : i ≠ j) : 0 < coordinateAreaMatrix L i j := by
    rw [coordinateAreaMatrix_selectBody]
    exact hpositive _ _ (hne i j hij)
  apply incompatible_boundary_quartets_first_third L hLpositive
  · simpa only [L, coordinateAreaMatrix_selectBody, Matrix.submatrix_apply] using hfirst
  · simpa only [L, coordinateAreaMatrix_selectBody, Matrix.submatrix_apply,
      coordinateAreaMatrix_symmetric K (e 4) (e 2),
      coordinateAreaMatrix_symmetric K (e 4) (e 1)] using hsecond

def boundaryChoice (K : Body 5) (m : Fin 5) : Option (Fin 3) :=
  by
    classical
    exact if h : ∃ k, BoundaryAt K m k then some h.choose else none

theorem boundaryChoice_sound (K : Body 5) (m : Fin 5) (k : Fin 3)
    (h : boundaryChoice K m = some k) : BoundaryAt K m k := by
  unfold boundaryChoice at h
  split_ifs at h with he
  have hk := Option.some.inj h
  exact hk ▸ he.choose_spec

theorem boundaryChoice_isSome_iff (K : Body 5) (m : Fin 5) :
    (boundaryChoice K m).isSome ↔
      IsBoundaryQuartet (coordinateAreaMatrix (deleteBody m K)) := by
  rw [← exists_boundaryAt_iff]
  unfold boundaryChoice
  split_ifs with h <;> simp [h]

theorem boundaryChoice_eq_some_of_boundary (K : Body 5)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (m : Fin 5) (k : Fin 3) (hk : BoundaryAt K m k) :
    boundaryChoice K m = some k := by
  unfold boundaryChoice
  split_ifs with h
  · congr 1
    exact boundaryAt_unique K hpositive m _ k h.choose_spec hk
  · exact (h ⟨k, hk⟩).elim

/-- Corollary 2.4: among five positive coordinate labels at most three
of the five four-coordinate projections can be boundary quartets. -/
theorem boundary_quartets_card_le_three (K : Body 5)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j) :
    (Finset.univ.filter fun m : Fin 5 =>
      IsBoundaryQuartet (coordinateAreaMatrix (deleteBody m K))).card ≤ 3 := by
  classical
  have hc := actual_boundary_choices_compatible K hpositive (boundaryChoice K)
    (boundaryChoice_sound K)
  simpa only [activeCount, boundaryChoice_isSome_iff] using
    compatible_choices_card_le_three (boundaryChoice K) hc

/-- The three-element block of a partition compatible with every actual
boundary quartet; the two-element block is its complement. -/
def BoundaryPartitionExtension (K : Body 5) (larger : Finset (Fin 5)) : Prop :=
  larger.card = 3 ∧ ∀ m : Fin 5, ∀ k : Fin 3, BoundaryAt K m k →
    m ∈ larger ∧ ∀ i j : Fin 5, i ≠ m → j ≠ m →
      (samePart m k i j ↔ (i ∈ larger ↔ j ∈ larger))

theorem boundaryPartitionExtension_iff (K : Body 5)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (larger : Finset (Fin 5)) :
    ExtendsChoices (boundaryChoice K) larger ↔ BoundaryPartitionExtension K larger := by
  constructor
  · rintro ⟨hcard, h⟩
    exact ⟨hcard, fun m k hk =>
      h m k (boundaryChoice_eq_some_of_boundary K hpositive m k hk)⟩
  · rintro ⟨hcard, h⟩
    exact ⟨hcard, fun m k hk => h m k (boundaryChoice_sound K m k hk)⟩

/-- Corollary 2.4: two or more boundary quartets determine a unique
partition of the five labels into a two-element and a three-element block. -/
theorem boundary_quartets_unique_extension (K : Body 5)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (hcount : 2 ≤ (Finset.univ.filter fun m : Fin 5 =>
      IsBoundaryQuartet (coordinateAreaMatrix (deleteBody m K))).card) :
    ∃! larger : Finset (Fin 5), BoundaryPartitionExtension K larger := by
  classical
  have hc := actual_boundary_choices_compatible K hpositive (boundaryChoice K)
    (boundaryChoice_sound K)
  have hn : 2 ≤ activeCount (boundaryChoice K) := by
    simpa only [activeCount, boundaryChoice_isSome_iff] using hcount
  obtain ⟨larger, hl, huniq⟩ := compatible_choices_unique_extension (boundaryChoice K) hc hn
  refine ⟨larger, (boundaryPartitionExtension_iff K hpositive larger).mp hl, ?_⟩
  intro other ho
  exact huniq other ((boundaryPartitionExtension_iff K hpositive other).mpr ho)

/-- The upper bound is attained by one actual finite convex hull. -/
theorem boundary_quartets_bound_sharp :
    (∀ K : Body 5, (∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j) →
      (Finset.univ.filter fun m : Fin 5 =>
        IsBoundaryQuartet (coordinateAreaMatrix (deleteBody m K))).card ≤ 3) ∧
    ∃ K : Body 5, (∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j) ∧
      (Finset.univ.filter fun m : Fin 5 =>
        IsBoundaryQuartet (coordinateAreaMatrix (deleteBody m K))).card = 3 := by
  classical
  exact ⟨boundary_quartets_card_le_three, sharpBody, sharp_three_boundary_quartets⟩

end ProjectionAreaMixedGeometry

