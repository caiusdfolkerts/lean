/-- Corollary 2.4 for any five distinct coordinate labels in any ambient
dimension. The quartet matrices in the conclusion are literal principal
restrictions of the original body's actual Euclidean coordinate areas. -/
theorem selected_boundary_quartets_card_le_three {d : ℕ} (K : CoordinateBody d)
    (σ : Fin 5 → Fin d) (hσ : Function.Injective σ)
    (hpositive : ∀ i j, σ i ≠ σ j → 0 < coordinateAreas K (σ i) (σ j)) :
    (Finset.univ.filter fun m : Fin 5 => IsBoundaryQuartet
      ((coordinateAreas K).submatrix (σ ∘ m.succAbove) (σ ∘ m.succAbove))).card ≤ 3 := by
  classical
  let L := selectBody σ (asPiBody K)
  have hLpositive (i j : Fin 5) (hij : i ≠ j) : 0 < coordinateAreaMatrix L i j := by
    rw [coordinateAreaMatrix_selectBody, coordinateAreaMatrix_asPiBody]
    exact hpositive i j (fun he => hij (hσ he))
  have hM (m : Fin 5) : coordinateAreaMatrix (deleteBody m L) =
      (coordinateAreas K).submatrix (σ ∘ m.succAbove) (σ ∘ m.succAbove) := by
    rw [coordinateAreaMatrix_deleteBody, coordinateAreaMatrix_selectBody,
      coordinateAreaMatrix_asPiBody]
    rfl
  simpa only [hM] using boundary_quartets_card_le_three L hLpositive

/-- The unique two-plus-three partition in Corollary 2.4, with the selected
labels and the boundary-quartet count shown in the original ambient body.
The partition itself is indexed by the five labels of the injection `σ`. -/
theorem selected_boundary_quartets_unique_extension {d : ℕ} (K : CoordinateBody d)
    (σ : Fin 5 → Fin d) (hσ : Function.Injective σ)
    (hpositive : ∀ i j, σ i ≠ σ j → 0 < coordinateAreas K (σ i) (σ j))
    (hcount : 2 ≤ (Finset.univ.filter fun m : Fin 5 => IsBoundaryQuartet
      ((coordinateAreas K).submatrix (σ ∘ m.succAbove) (σ ∘ m.succAbove))).card) :
    ∃! larger : Finset (Fin 5),
      BoundaryPartitionExtension (selectBody σ (asPiBody K)) larger := by
  classical
  let L := selectBody σ (asPiBody K)
  have hLpositive (i j : Fin 5) (hij : i ≠ j) : 0 < coordinateAreaMatrix L i j := by
    rw [coordinateAreaMatrix_selectBody, coordinateAreaMatrix_asPiBody]
    exact hpositive i j (fun he => hij (hσ he))
  have hM (m : Fin 5) : coordinateAreaMatrix (deleteBody m L) =
      (coordinateAreas K).submatrix (σ ∘ m.succAbove) (σ ∘ m.succAbove) := by
    rw [coordinateAreaMatrix_deleteBody, coordinateAreaMatrix_selectBody,
