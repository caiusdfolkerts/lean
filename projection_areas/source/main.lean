@[expose] public section

/-!
# Open families with every four-coordinate signature equal to (1,3)

Corollary 5.3 concerns the space of arrays indexed by unordered distinct
coordinate pairs. We use its equivalent hollow symmetric matrix model,
with the induced finite-dimensional topology. Openness is relative to this
array space; it is not asserted in the larger space of arbitrary matrices.

Strict negativity on the sum-zero hyperplane is open by compactness of its
unit sphere. This supplies a neighborhood on which every four-coordinate
matrix has exactly one positive and three negative eigenvalues. The
eigenvalues below are Mathlib's spectral list, counted with multiplicity.
-/

noncomputable section

open Set Filter Matrix Finset MeasureTheory
open scoped BigOperators Topology
open ProjectionAreaTopology ProjectionAreaRankThree ProjectionAreaStrict
open ProjectionAreaEigenvalues

namespace ProjectionAreaPaper

/-- The ordinary space of off-diagonal symmetric area arrays, represented
by full matrices with their diagonal and symmetry equations enforced. -/
abbrev HollowSymmetricArray (d : ℕ) :=
  {q : AreaArray d // (∀ i, q i i = 0) ∧ ∀ i j, q i j = q j i}

def PositiveArray {d : ℕ} (q : AreaArray d) : Prop :=
  ∀ i j, i ≠ j → 0 < q i j

def quadraticValue {d : ℕ} (q : AreaArray d) (x : Fin d → ℝ) : ℝ :=
  dotProduct x (q.mulVec x)

def StrictlyNegativeOnSumZero {d : ℕ} (q : AreaArray d) : Prop :=
  ∀ x : Fin d → ℝ, x ≠ 0 → ∑ i, x i = 0 → quadraticValue q x < 0

theorem continuous_quadraticValue (d : ℕ) :
    Continuous (fun p : AreaArray d × (Fin d → ℝ) => quadraticValue p.1 p.2) := by
  unfold quadraticValue Matrix.mulVec dotProduct
  fun_prop

theorem quadraticValue_smul {d : ℕ} (q : AreaArray d) (a : ℝ) (x : Fin d → ℝ) :
    quadraticValue q (a • x) = a ^ 2 * quadraticValue q x := by
  simp only [quadraticValue, Matrix.mulVec_smul, smul_dotProduct,
    dotProduct_smul, smul_eq_mul]
  ring

/-- The strict hyperplane condition is open, including in dimension zero. -/
theorem isOpen_strictlyNegativeOnSumZero (d : ℕ) :
    IsOpen {q : AreaArray d | StrictlyNegativeOnSumZero q} := by
  rw [isOpen_iff_mem_nhds]
  intro q hq
  let H : Set (Fin d → ℝ) := Metric.sphere 0 1 ∩ {x | ∑ i, x i = 0}
  have hH : IsCompact H :=
    (isCompact_sphere (0 : Fin d → ℝ) 1).inter_right
      (isClosed_eq (by fun_prop) continuous_const)
  have hnear : ∀ᶠ q' in 𝓝 q, ∀ y ∈ H, quadraticValue q' y < 0 := by
    apply hH.eventually_forall_of_forall_eventually
    intro y hy
    have hyn : ‖y‖ = 1 := by simpa only [Metric.mem_sphere, dist_zero_right] using hy.1
    have hyne : y ≠ 0 := by intro h; simp [h] at hyn
    exact (isOpen_lt (continuous_quadraticValue d) continuous_const).mem_nhds
      (hq y hyne hy.2)
  filter_upwards [hnear] with q' hq'
  intro x hx hsum
  let y : Fin d → ℝ := ‖x‖⁻¹ • x
  have hxn : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hyn : ‖y‖ = 1 := by
    dsimp [y]
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hxn, inv_mul_cancel₀ hxn.ne']
  have hysum : ∑ i, y i = 0 := by
    simp only [y, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum, hsum, mul_zero]
  have hy : y ∈ H := ⟨by simpa only [Metric.mem_sphere, dist_zero_right] using hyn, hysum⟩
  have hnegative := hq' y hy
  change quadraticValue q' (‖x‖⁻¹ • x) < 0 at hnegative
  rw [quadraticValue_smul] at hnegative
  exact neg_of_mul_neg_right hnegative (sq_nonneg _)

theorem isOpen_positiveArray (d : ℕ) : IsOpen {q : AreaArray d | PositiveArray q} := by
  unfold PositiveArray
  simp only [setOf_forall]
  apply isOpen_iInter_of_finite
  intro i
  apply isOpen_iInter_of_finite
  intro j
  apply isOpen_iInter_of_finite
  intro _
  exact isOpen_lt continuous_const (by fun_prop)

def EveryQuartetStrict {d : ℕ} (q : AreaArray d) : Prop :=
  ∀ σ : Fin 4 → Fin d, Function.Injective σ →
    StrictlyNegativeOnSumZero (q.submatrix σ σ)

theorem isOpen_everyQuartetStrict (d : ℕ) :
    IsOpen {q : AreaArray d | EveryQuartetStrict q} := by
  unfold EveryQuartetStrict
  simp only [setOf_forall]
  apply isOpen_iInter_of_finite
  intro σ
  apply isOpen_iInter_of_finite
  intro _
  exact (isOpen_strictlyNegativeOnSumZero 4).preimage (by
    apply continuous_pi
    intro i
    apply continuous_pi
    intro j
    exact (continuous_apply (σ j)).comp (continuous_apply (σ i)))

theorem hollowSymmetric_isHermitian {d : ℕ} (q : HollowSymmetricArray d) :
    (q : AreaArray d).IsHermitian := by
  apply Matrix.isHermitian_iff_isSymm.mpr
  ext i j
  exact q.2.2 j i

/-- Signature (1,3) in terms of the actual spectral list. -/
def HasSignatureOneThree (M : AreaArray 4) : Prop :=
  ∃ hM : M.IsHermitian,
    (Finset.univ.filter fun i => 0 < hM.eigenvalues i).card = 1 ∧
    (Finset.univ.filter fun i => hM.eigenvalues i < 0).card = 3

theorem signature_one_three_of_strict_hyperplane (M : AreaArray 4)
    (hM : M.IsHermitian) (hhollow : ∀ i, M i i = 0)
    (hpositive : PositiveArray M) (hnegative : StrictlyNegativeOnSumZero M) :
    HasSignatureOneThree M := by
  have hnonpos (x : Fin 4 → ℝ) (hs : sumFunctional x = 0) :
      dotProduct x (M.mulVec x) ≤ 0 := by
    by_cases hx : x = 0
    · simp [hx]
    · exact (hnegative x hx hs).le
  have hpos : ∃ x : Fin 4 → ℝ, 0 < dotProduct x (M.mulVec x) := by
    refine ⟨Pi.single 0 1 + Pi.single 1 1, ?_⟩
    have hp := add_pos (hpositive 0 1 (by decide)) (hpositive 1 0 (by decide))
    simpa [Matrix.mulVec_add, add_dotProduct, single_dotProduct,
      Matrix.mulVec_single, hhollow, add_comm] using hp
  have hkernel : ∀ x : Fin 4 → ℝ, M.mulVec x = 0 → x = 0 :=
    fun x hx => kernel_eq_zero_of_negative_hyperplane M
      (Matrix.isHermitian_iff_isSymm.mp hM) sumFunctional hnegative hpos hx
  have hinjective : Function.Injective M.mulVec := by
    intro x y hxy
    apply sub_eq_zero.mp
    apply hkernel
    rw [Matrix.mulVec_sub, hxy, sub_self]
  have hdet : M.det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).mp
      (Matrix.mulVec_injective_iff_isUnit.mp hinjective)).ne_zero
  have hEigenNe (i : Fin 4) : hM.eigenvalues i ≠ 0 := by
    intro hz
    apply hdet
    rw [hM.det_eq_prod_eigenvalues]
    simp only [RCLike.ofReal_real_eq_id, id_eq]
    exact Finset.prod_eq_zero (Finset.mem_univ i) hz
  have htrace : M.trace = 0 := by simp [Matrix.trace, hhollow]
  have hsum : ∑ i, hM.eigenvalues i = 0 := by
    simpa only [RCLike.ofReal_real_eq_id, id_eq] using
      hM.trace_eq_sum_eigenvalues.symm.trans htrace
  have hex : ∃ i, 0 < hM.eigenvalues i := by
    by_contra h
    push_neg at h
    have hstrict (i : Fin 4) : hM.eigenvalues i < 0 := lt_of_le_of_ne (h i) (hEigenNe i)
    have hh : (∑ i, hM.eigenvalues i) < 0 := by
      calc
        (∑ i, hM.eigenvalues i) < ∑ _i : Fin 4, (0 : ℝ) :=
          Finset.sum_lt_sum (fun i _ => (hstrict i).le)
            ⟨0, Finset.mem_univ 0, hstrict 0⟩
        _ = 0 := by simp
    rw [hsum] at hh
    exact lt_irrefl 0 hh
  obtain ⟨i, hi⟩ := hex
  have hunique (j : Fin 4) (hj : 0 < hM.eigenvalues j) : j = i :=
    positive_eigenvalues_unique M hM sumFunctional hnonpos j i hj hi
  have hposset : (Finset.univ.filter fun j => 0 < hM.eigenvalues j) = {i} := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton]
    constructor
    · exact hunique j
    · rintro rfl
      exact hi
  have hnegset : (Finset.univ.filter fun j => hM.eigenvalues j < 0) =
      Finset.univ.erase i := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase, and_true]
    constructor
    · intro hj hji
      subst j
      linarith
    · intro hji
      exact lt_of_le_of_ne (le_of_not_gt (fun hj => hji (hunique j hj))) (hEigenNe j)
  refine ⟨hM, ?_, ?_⟩
  · rw [hposset]
    simp
  · rw [hnegset]
    simp

def finitePerturbedArray (d : ℕ) (ε : ℝ) : HollowSymmetricArray d :=
  ⟨finitePerturbed (fun i : Fin d => (i.val : ℝ)) ε,
    finite_diagonal _ _, by
      intro i j
      simpa only [Matrix.transpose_apply] using
        congrFun (congrFun
          (finite_symmetric (fun k : Fin d => (k.val : ℝ)) ε) j) i⟩

theorem continuous_finitePerturbedArray (d : ℕ) : Continuous (finitePerturbedArray d) := by
  apply Continuous.subtype_mk
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  by_cases hij : i = j
  · subst j
    simp only [finitePerturbedArray, finite_diagonal]
    exact continuous_const
  · simp only [finitePerturbedArray, finitePerturbed, if_neg hij]
    fun_prop

theorem finitePerturbed_zero_positive (d : ℕ) :
    PositiveArray ((finitePerturbedArray d 0 : HollowSymmetricArray d) : AreaArray d) := by
  intro i j hij
  have hne : (i.val : ℝ) ≠ (j.val : ℝ) := by
    intro he
    apply hij
    apply Fin.ext
    exact_mod_cast he
  simpa only [finitePerturbedArray, finitePerturbed, if_neg hij, add_zero, sub_zero] using
    sq_pos_of_ne_zero (sub_ne_zero.mpr hne)

theorem finitePerturbed_zero_rank_le_three (d : ℕ) :
    (((finitePerturbedArray d 0 : HollowSymmetricArray d) : AreaArray d)).rank ≤ 3 := by
  have he : ((finitePerturbedArray d 0 : HollowSymmetricArray d) : AreaArray d) =
      (ProjectionAreaUniform.areaMatrix d).submatrix Sum.inl Sum.inl := by
    ext i j
    simp [finitePerturbedArray, finitePerturbed, ProjectionAreaUniform.areaMatrix]
  rw [he]
  apply (Matrix.rank_submatrix_le _ _ _).trans
  rw [ProjectionAreaUniform.uniform_gram_factorization]
  exact (Matrix.rank_mul_le_left _ _).trans (by
    simpa using (Matrix.rank_le_card_width
      (ProjectionAreaUniform.rows d * ProjectionAreaUniform.lorentzMatrix)))

theorem finitePerturbed_everyQuartetStrict (d : ℕ) {ε : ℝ} (hε : 0 < ε) :
    EveryQuartetStrict ((finitePerturbedArray d ε : HollowSymmetricArray d) : AreaArray d) := by
  intro σ hσ
  change StrictlyNegativeOnSumZero ((finitePerturbed _ ε).submatrix σ σ)
  rw [finite_principal_restriction _ ε σ hσ]
  exact fun x hx hs => finite_negative_of_sum_zero _ hε hx hs

/-- Corollary 5.3. Every array in one nonempty relatively open set is
positive, is outside the closed realization locus, and has strict spectral
signature (1,3) on every four distinct coordinates. -/
theorem exists_open_nonrealizable_strict_quartets (d : ℕ) (hd : 5 ≤ d) :
    ∃ U : Set (HollowSymmetricArray d), IsOpen U ∧ U.Nonempty ∧
      ∀ q ∈ U,
        PositiveArray (q : AreaArray d) ∧
        (q : AreaArray d) ∉ closure (realizationLocus d) ∧
        ∀ σ : Fin 4 → Fin d, Function.Injective σ →
          HasSignatureOneThree ((q : AreaArray d).submatrix σ σ) := by
  let q₀ := finitePerturbedArray d 0
  let P : PositiveHollowMatrix d :=
    ⟨q₀, q₀.2.1, q₀.2.2, finitePerturbed_zero_positive d⟩
  have h₀ : (q₀ : AreaArray d) ∉ closure (realizationLocus d) :=
    positive_rank_le_three_not_in_closure P hd (finitePerturbed_zero_rank_le_three d)
  have hnear : ∀ᶠ ε in 𝓝 (0 : ℝ),
      (finitePerturbedArray d ε : AreaArray d) ∉ closure (realizationLocus d) := by
    have ht : Tendsto (fun ε : ℝ => (finitePerturbedArray d ε : AreaArray d))
        (𝓝 (0 : ℝ)) (𝓝 (q₀ : AreaArray d)) :=
      (continuous_subtype_val.comp (continuous_finitePerturbedArray d)).continuousAt.tendsto
    exact ht.eventually (isClosed_closure.isOpen_compl.mem_nhds h₀)
  obtain ⟨δ, hδ, hδgood⟩ := Metric.eventually_nhds_iff.mp hnear
  let ε : ℝ := δ / 2
  have hε : 0 < ε := by dsimp [ε]; positivity
  have havoid : (finitePerturbedArray d ε : AreaArray d) ∉ closure (realizationLocus d) :=
    hδgood (by simpa only [Real.dist_eq, sub_zero, abs_of_pos hε] using
      (show ε < δ by dsimp [ε]; linarith))
  let U : Set (HollowSymmetricArray d) :=
    {q | PositiveArray (q : AreaArray d) ∧
      (q : AreaArray d) ∉ closure (realizationLocus d) ∧
      EveryQuartetStrict (q : AreaArray d)}
  refine ⟨U, ?_, ?_, ?_⟩
  · change IsOpen ({q : HollowSymmetricArray d | PositiveArray (q : AreaArray d)} ∩
      ({q | (q : AreaArray d) ∉ closure (realizationLocus d)} ∩
        {q | EveryQuartetStrict (q : AreaArray d)}))
    exact ((isOpen_positiveArray d).preimage continuous_subtype_val).inter
      ((isClosed_closure.isOpen_compl.preimage continuous_subtype_val).inter
        ((isOpen_everyQuartetStrict d).preimage continuous_subtype_val))
  · refine ⟨finitePerturbedArray d ε, ?_, havoid, finitePerturbed_everyQuartetStrict d hε⟩
    intro i j hij
    change 0 < finitePerturbed (fun k : Fin d => (k.val : ℝ)) ε i j
    exact finite_off_diagonal_positive _ hε hij
  · intro q hq
    refine ⟨hq.1, hq.2.1, ?_⟩
    intro σ hσ
    exact signature_one_three_of_strict_hyperplane _
      ((hollowSymmetric_isHermitian q).submatrix σ) (fun i => q.2.1 (σ i))
      (fun i j hij => hq.1 _ _ (fun he => hij (hσ he))) (hq.2.2 σ hσ)

end ProjectionAreaPaper


