section Source_TripleProjectionInterior

@[expose] public section

/-!
# Three-dimensional projections of a positive boundary quartet

Every affine relation on a compact convex body gives inequalities between
its actual planar projection areas: fix one coordinate as longitudinal,
then use the interval-fiber area seminorm in the remaining functionals.
For a positive rank-at-most-three quartet, the algebraic boundary equalities
force the absolute coefficients of any such relation to vanish as soon as
one coefficient is zero. A proper three-coordinate affine span would give
exactly such a nonzero relation. Thus every three-coordinate projection has
nonempty interior.

No surface-area measure or equality theorem for Alexandrov--Fenchel is used
in this dimension argument.
-/

noncomputable section

open Set MeasureTheory Module Matrix
open scoped BigOperators Pointwise
open VolumePolynomials ProjectionAreaFiber ProjectionAreaRankThree
open ProjectionAreaBoundaryKernel ProjectionAreaTransforms

namespace ProjectionAreaMixedGeometry

def linearCoordinate {n : ℕ} (i : Fin n) : V n →ₗ[ℝ] ℝ := LinearMap.proj i

theorem fiberArea_coordinate {n : ℕ} (K : Body n) (i j : Fin n) :
    fiberArea (K : Set (V n)) (linearCoordinate i) (linearCoordinate j) =
      coordinateAreaMatrix K i j := by
  let S : Set (V 2) := projectN j i '' (K : Set (V n))
  have hmeasure := (volume_preserving_finTwoArrow ℝ).measure_preimage_equiv
    (MeasurableEquiv.finTwoArrow '' S)
  rw [Set.preimage_image_eq _ MeasurableEquiv.finTwoArrow.injective] at hmeasure
  have himage : planeImage (K : Set (V n)) (linearCoordinate j) (linearCoordinate i) =
      MeasurableEquiv.finTwoArrow '' S := by
    dsimp only [S]
    rw [Set.image_image]
    rfl
  rw [fiberArea, himage]
  calc
    volume.real (MeasurableEquiv.finTwoArrow '' S) = volume.real S :=
      congrArg ENNReal.toReal hmeasure.symm
    _ = coordinateAreaMatrix K j i := rfl
    _ = coordinateAreaMatrix K i j := coordinateAreaMatrix_symmetric K j i

theorem sum_four_distinct (f : Fin 4 → ℝ) (i j k l : Fin 4)
    (hij : i ≠ j) (hik : i ≠ k) (hil : i ≠ l)
    (hjk : j ≠ k) (hjl : j ≠ l) (hkl : k ≠ l) :
    ∑ r, f r = f i + f j + f k + f l := by
  have hfour : ({i, j, k, l} : Finset (Fin 4)) = Finset.univ :=
    (Finset.card_eq_iff_eq_univ _).mp (by simp [hij, hik, hil, hjk, hjl, hkl])
  rw [← hfour]
  simp [hij, hik, hil, hjk, hjl, hkl, add_assoc]

/-- The coefficients are those of an actual affine relation holding at
every point of the body. The bounds retain all four coordinate orderings. -/
theorem relationBounds_of_affine_relation (K : Body 4) (a : Fin 4 → ℝ) (c : ℝ)
    (hrel : ∀ x ∈ K, ∑ r, a r * x r = c) :
    RelationBounds (coordinateAreaMatrix K) (fun r => |a r|) := by
  intro i j k l hij hik hil hjk hjl hkl
  have h := fiberArea_relation_bound K.isCompact K.convex
    (linearCoordinate i) (linearCoordinate j) (linearCoordinate k) (linearCoordinate l)
    (a i) (a j) (a k) (a l) c (by
      intro x hx
      simpa only [linearCoordinate, LinearMap.proj_apply,
        sum_four_distinct (fun r => a r * x r) i j k l hij hik hil hjk hjl hkl] using
        hrel x hx)
  simpa only [fiberArea_coordinate, mul_comm] using h

theorem linearForm_eq_sum_coordinates {n : ℕ} (f : V n →ₗ[ℝ] ℝ) (x : V n) :
    f x = ∑ i, f (Pi.single i 1) * x i := by
  have hsingle (i : Fin n) : Pi.single i (x i) = x i • Pi.single i (1 : ℝ) := by
    ext j
    by_cases h : i = j
    · subst j
      simp
    · simp [Pi.single_apply, h, Ne.symm h]
  calc
    f x = f (∑ i, Pi.single i (x i)) := by rw [LinearMap.sum_single_apply]
    _ = ∑ i, f (Pi.single i (x i)) := map_sum f _ _
    _ = ∑ i, f (Pi.single i 1) * x i := by
      apply Finset.sum_congr rfl
      intro i _
      rw [hsingle, map_smul]
      exact mul_comm _ _

/-- A compact convex set with empty interior lies in a nontrivial affine
hyperplane. The functional is produced from the proper direction space. -/
theorem exists_affine_relation_of_empty_interior {n : ℕ} (L : Body n)
    (hint : ¬ (interior (L : Set (V n))).Nonempty) :
    ∃ f : V n →ₗ[ℝ] ℝ, f ≠ 0 ∧ ∃ c : ℝ, ∀ x ∈ L, f x = c := by
  let A : AffineSubspace ℝ (V n) := affineSpan ℝ (L : Set (V n))
  have hAne : A ≠ ⊤ := by
    intro hA
    exact hint (L.convex.interior_nonempty_iff_affineSpan_eq_top.mpr hA)
  have hAnonempty : (A : Set (V n)).Nonempty :=
    L.nonempty.mono (subset_affineSpan ℝ (L : Set (V n)))
  have hd : A.direction < ⊤ := lt_top_iff_ne_top.mpr (by
    intro hd
    exact hAne ((AffineSubspace.direction_eq_top_iff_of_nonempty hAnonempty).mp hd))
  obtain ⟨f, hf, hmap⟩ := A.direction.exists_dual_map_eq_bot_of_lt_top hd inferInstance
  obtain ⟨x₀, hx₀⟩ := L.nonempty
  refine ⟨f, hf, f x₀, ?_⟩
  intro x hx
  have hv : x - x₀ ∈ A.direction :=
    AffineSubspace.vsub_mem_direction (subset_affineSpan ℝ _ hx) (subset_affineSpan ℝ _ hx₀)
  have hzero : f (x - x₀) = 0 := by
    have hm : f (x - x₀) ∈ A.direction.map f :=
      Submodule.mem_map.mpr ⟨x - x₀, hv, rfl⟩
    simpa only [hmap, Submodule.mem_bot] using hm
  exact sub_eq_zero.mp (by simpa only [map_sub] using hzero)

/-- Every three-dimensional coordinate projection of an actual convex
realization of a positive rank-at-most-three quartet has nonempty interior.
The matrix equality states explicitly which geometric areas are used. -/
theorem triple_projection_interior_of_rank_le_three
    (K : Body 4) (P : PositiveHollowMatrix 4)
    (hP : P.entries = coordinateAreaMatrix K) (hrank : P.entries.rank ≤ 3)
    (z : Fin 4) : (interior (deleteBody z K : Set (V 3))).Nonempty := by
  by_contra hint
  obtain ⟨f, hf, c, hc⟩ := exists_affine_relation_of_empty_interior (deleteBody z K) hint
  let F : V 4 →ₗ[ℝ] ℝ := f.comp (deleteCoord z).toLinearMap
  let a : Fin 4 → ℝ := fun i => F (Pi.single i 1)
  have hdelete (x : V 3) : deleteCoord z (insertCoord z x) = x := by
    ext i
    exact insertCoord_succAbove z x i
  have hF : F ≠ 0 := by
    intro hzero
    apply hf
    apply LinearMap.ext
    intro x
    have h := congrArg (fun G : V 4 →ₗ[ℝ] ℝ => G (insertCoord z x)) hzero
    simpa only [F, LinearMap.comp_apply, ContinuousLinearMap.coe_coe,
      hdelete, LinearMap.zero_apply] using h
  have haz : a z = 0 := by
    have hsingle : deleteCoord z (Pi.single z (1 : ℝ)) = 0 := by
      ext i
      simp [deleteCoord, Fin.succAbove_ne]
    simp only [a, F, LinearMap.comp_apply, ContinuousLinearMap.coe_coe, hsingle, map_zero]
  have hrel : ∀ x ∈ K, ∑ i, a i * x i = c := by
    intro x hx
    rw [← linearForm_eq_sum_coordinates F x]
    exact hc (deleteCoord z x) (Set.mem_image_of_mem (deleteCoord z) hx)
  have hb : RelationBounds P.entries (fun i => |a i|) := by
    rw [hP]
    exact relationBounds_of_affine_relation K a c hrel
  have ha := relationBounds_zero_of_one_zero P hrank (fun i => |a i|) hb z
    (by rw [haz, abs_zero])
  apply hF
  apply LinearMap.ext
  intro x
  change F x = 0
  rw [linearForm_eq_sum_coordinates F x]
  apply Finset.sum_eq_zero
  intro i _
  have hai : a i = 0 := abs_eq_zero.mp (congrFun ha i)
  exact mul_eq_zero_of_left hai _

/-- The same geometric statement with the positivity and rank hypotheses
written directly on the actual area matrix. -/
theorem triple_projection_interior
    (K : Body 4)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (hrank : (coordinateAreaMatrix K).rank ≤ 3) (z : Fin 4) :
    (interior (deleteBody z K : Set (V 3))).Nonempty := by
  let P : PositiveHollowMatrix 4 :=
    ⟨coordinateAreaMatrix K, coordinateAreaMatrix_hollow K,
      coordinateAreaMatrix_symmetric K, hpositive⟩
  exact triple_projection_interior_of_rank_le_three K P rfl hrank z

theorem four_rank_le_three_of_det_zero (M : Matrix (Fin 4) (Fin 4) ℝ)
    (hdet : M.det = 0) : M.rank ≤ 3 := by
  by_contra hn
  have hbound : M.rank ≤ 4 := Matrix.rank_le_width M
  have hrank : M.rank = Fintype.card (Fin 4) := by simp only [Fintype.card_fin]; omega
  have hunit : IsUnit M := Matrix.mulVec_surjective_iff_isUnit.mp
    (Matrix.mulVec_surjective_iff_rank_eq_card.mpr hrank)
  exact ((Matrix.isUnit_iff_isUnit_det M).mp hunit).ne_zero hdet

/-- The boundary-quartet formulation needs only positivity and determinant
zero. The rank bound is a derived matrix fact, not an extra hypothesis. -/
theorem triple_projection_interior_of_det_zero
    (K : Body 4)
    (hpositive : ∀ i j, i ≠ j → 0 < coordinateAreaMatrix K i j)
    (hdet : (coordinateAreaMatrix K).det = 0) (z : Fin 4) :
    (interior (deleteBody z K : Set (V 3))).Nonempty :=
  triple_projection_interior K hpositive
    (four_rank_le_three_of_det_zero _ hdet) z

end ProjectionAreaMixedGeometry

end
end
end Source_TripleProjectionInterior

