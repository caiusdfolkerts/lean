section Source_RectangleObstruction

@[expose] public section

/-!
# Three rectangular coordinate shadows obstruct a boundary quartet

The result concerns actual compact convex sets and ordinary Lebesgue area.
After normalizing the four coordinate ranges, a path of three rectangular
shadows has area entries `q₀₁=q₁₂=q₂₃=1`.  The planar endpoint-fiber bound
then rules out a zero determinant of the positive hollow area matrix.
-/

noncomputable section
open Set MeasureTheory Matrix
open scoped Pointwise BigOperators

namespace ProjectionAreaRectangleObstruction

open ProjectionAreaRectangleBound ProjectionAreaRankThree
open ProjectionAreaMixedGeometry

abbrev Square : Set (ℝ × ℝ) := Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1

def coordinatePair {n : ℕ} (i j : Fin n) : V n →ₗ[ℝ] (ℝ × ℝ) :=
  (LinearMap.proj i).prod (LinearMap.proj j)

def coordinateTriple {n : ℕ} (i j k : Fin n) : V n →ₗ[ℝ] V 3 where
  toFun x := ![x i,x j,x k]
  map_add' := by intros; ext r; fin_cases r <;> simp
  map_smul' := by intros; ext r; fin_cases r <;> simp

def pairArea {n : ℕ} (K : Set (V n)) (i j : Fin n) : ℝ :=
  volume.real (coordinatePair i j '' K)

theorem square_area : volume.real Square = 1 := by
  change volume.real (Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1) = 1
  rw [Measure.volume_eq_prod, measureReal_prod_prod]
  norm_num

theorem pairArea_symm {n : ℕ} (K : Set (V n)) (i j : Fin n) :
    pairArea K i j = pairArea K j i := by
  let S := coordinatePair i j '' K
  have he : coordinatePair j i '' K = Prod.swap '' S := by
    rw [Set.image_image]
    rfl
  have hp : MeasurePreserving (Prod.swap : (ℝ × ℝ) → ℝ × ℝ) volume volume := by
    simpa only [Measure.volume_eq_prod] using
      (Measure.measurePreserving_swap (μ := (volume : Measure ℝ)) (ν := volume))
  change volume.real S = volume.real (coordinatePair j i '' K)
  rw [he, measureReal_def, measureReal_def]
  have h := hp.measure_preimage_emb MeasurableEquiv.prodComm.measurableEmbedding
    (Prod.swap '' S)
  rw [Set.preimage_image_eq S Prod.swap_injective] at h
  exact congrArg ENNReal.toReal h

theorem pairArea_of_square {n : ℕ} {K : Set (V n)} {i j : Fin n}
    (h : coordinatePair i j '' K = Square) : pairArea K i j = 1 := by
  rw [pairArea,h,square_area]

theorem pairArea_le_one_of_unit_ranges {n : ℕ} {K : Set (V n)}
    (hunit : ∀ x ∈ K, ∀ i, x i ∈ Icc (0 : ℝ) 1) (i j : Fin n) :
    pairArea K i j ≤ 1 := by
  have hsub : coordinatePair i j '' K ⊆ Square := by
    rintro p ⟨x,hx,rfl⟩
    exact ⟨hunit x hx i,hunit x hx j⟩
  calc
    pairArea K i j ≤ volume.real Square :=
      measureReal_mono hsub (isCompact_Icc.prod isCompact_Icc).measure_ne_top
    _ = 1 := square_area

/-- The endpoint-fiber inequality, transported to any selected coordinates. -/
theorem pairArea_sum_ge_one {n : ℕ} {K : Set (V n)}
    (hK : IsCompact K) (hc : Convex ℝ K) (i j k : Fin n)
    (hsquare : coordinatePair i j '' K = Square)
    (hrange : (fun x : V n => x k) '' K = Icc (0 : ℝ) 1) :
    1 ≤ pairArea K i k + pairArea K j k := by
  let L : Set (V 3) := coordinateTriple i j k '' K
  have hxy : pairProjection 0 1 '' L = Square := by
    change pairProjection 0 1 '' (coordinateTriple i j k '' K) = _
    rw [Set.image_image]
    exact hsquare
  have hz : (fun x : V 3 => x 2) '' L = Icc (0 : ℝ) 1 := by
    change (fun x : V 3 => x 2) '' (coordinateTriple i j k '' K) = _
    rw [Set.image_image]
    exact hrange
  have h := box_projection_sum_area_ge_one
    (hK.image (coordinateTriple i j k).continuous_of_finiteDimensional)
    (hc.linear_image (coordinateTriple i j k)) hxy hz
  have hxz : pairProjection 0 2 '' L = coordinatePair i k '' K := by
    change pairProjection 0 2 '' (coordinateTriple i j k '' K) = _
    rw [Set.image_image] <;> rfl
  have hyz : pairProjection 1 2 '' L = coordinatePair j k '' K := by
    change pairProjection 1 2 '' (coordinateTriple i j k '' K) = _
    rw [Set.image_image] <;> rfl
  change 1 ≤ volume.real (pairProjection 0 2 '' L) +
    volume.real (pairProjection 1 2 '' L) at h
  rw [hxz, hyz] at h
  exact h

/-- The scalar contradiction is valid for every positive entry, including
the endpoint at which one of the remaining shadows is also a rectangle. -/
theorem box_path_hollowDet_ne_zero (A B C : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hC : 0 < C)
    (hA1 : A ≤ 1) (hB1 : B ≤ 1) (hC1 : C ≤ 1)
    (hAB : 1 ≤ A+B) (hCB : 1 ≤ C+B) :
    hollowDet 1 A B 1 C 1 ≠ 0 :=
  (ProjectionAreaBoundaryKernel.box_path_hollowDet_negative
    A B C hA hB hC hA1 hB1 hC1 hAB hCB).ne

theorem unit_ranges_of_two_squares {K : Set (V 4)}
    (h01 : coordinatePair 0 1 '' K = Square)
    (h23 : coordinatePair 2 3 '' K = Square) :
    ∀ x ∈ K, ∀ i, x i ∈ Icc (0 : ℝ) 1 := by
  intro x hx i
  have ha : coordinatePair 0 1 x ∈ Square := h01 ▸ Set.mem_image_of_mem _ hx
  have hb : coordinatePair 2 3 x ∈ Square := h23 ▸ Set.mem_image_of_mem _ hx
  fin_cases i
  · exact ha.1
  · exact ha.2
  · exact hb.1
  · exact hb.2

theorem range_of_square_left {n : ℕ} {K : Set (V n)} (i j : Fin n)
    (hsquare : coordinatePair i j '' K = Square) :
    (fun x : V n => x i) '' K = Icc (0 : ℝ) 1 := by
  have he := congrArg (fun S : Set (ℝ × ℝ) => Prod.fst '' S) hsquare
  rw [Set.image_image] at he
  change (fun x : V n => x i) '' K =
    Prod.fst '' (Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1) at he
  rw [Set.fst_image_prod (Icc (0 : ℝ) 1)
    (show (Icc (0 : ℝ) 1).Nonempty from ⟨0, by norm_num⟩)] at he
  exact he

theorem range_of_square_right {n : ℕ} {K : Set (V n)} (i j : Fin n)
    (hsquare : coordinatePair i j '' K = Square) :
    (fun x : V n => x j) '' K = Icc (0 : ℝ) 1 := by
  have he := congrArg (fun S : Set (ℝ × ℝ) => Prod.snd '' S) hsquare
  rw [Set.image_image] at he
  change (fun x : V n => x j) '' K =
    Prod.snd '' (Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1) at he
  rw [Set.snd_image_prod
    (show (Icc (0 : ℝ) 1).Nonempty from ⟨0, by norm_num⟩) (Icc (0 : ℝ) 1)] at he
  exact he

/-- Three successive rectangular shadows are incompatible with positive
boundary data. No full-dimensionality assumption is needed here. -/
theorem three_square_shadows_hollowDet_ne_zero {K : Set (V 4)}
    (hK : IsCompact K) (hc : Convex ℝ K)
    (hpositive : ∀ i j : Fin 4, i ≠ j → 0 < pairArea K i j)
    (h01 : coordinatePair 0 1 '' K = Square)
    (h12 : coordinatePair 1 2 '' K = Square)
    (h23 : coordinatePair 2 3 '' K = Square) :
    hollowDet (pairArea K 0 1) (pairArea K 0 2) (pairArea K 0 3)
      (pairArea K 1 2) (pairArea K 1 3) (pairArea K 2 3) ≠ 0 := by
  rw [pairArea_of_square h01,pairArea_of_square h12,pairArea_of_square h23]
  have hunit := unit_ranges_of_two_squares h01 h23
  apply box_path_hollowDet_ne_zero
    (pairArea K 0 2) (pairArea K 0 3) (pairArea K 1 3)
    (hpositive 0 2 (by decide)) (hpositive 0 3 (by decide))
    (hpositive 1 3 (by decide))
    (pairArea_le_one_of_unit_ranges hunit 0 2)
    (pairArea_le_one_of_unit_ranges hunit 0 3)
    (pairArea_le_one_of_unit_ranges hunit 1 3)
  · have h := pairArea_sum_ge_one hK hc 2 3 0 h23 (range_of_square_left 0 1 h01)
    simpa only [pairArea_symm K 2 0,pairArea_symm K 3 0] using h
  · simpa only [add_comm] using pairArea_sum_ge_one hK hc 0 1 3 h01
      (range_of_square_right 2 3 h23)

end ProjectionAreaRectangleObstruction

end
end
