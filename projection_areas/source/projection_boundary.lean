section Source_FiveLabelObstruction

@[expose] public section

/-!
# The full five-label obstruction

Coordinate reindexing and deletion are performed on actual compact convex
bodies. Balanced complementary kernels produce fiber-product identities.
The finite cut theorem supplies two incompatible identities on the same
three-coordinate shadow; their common prism contradicts the geometric
boundary-prism obstruction.
-/

noncomputable section

open Set MeasureTheory Module Matrix
open scoped Pointwise BigOperators Topology
open VolumePolynomials ProjectionAreaRankThree ProjectionAreaBoundaryKernel
open ProjectionAreaRectangleObstruction

namespace ProjectionAreaMixedGeometry

theorem selectBody_comp {a b c : ℕ} (σ : Fin a → Fin b) (τ : Fin b → Fin c) (K : Body c) :
    selectBody σ (selectBody τ K) = selectBody (fun i => τ (σ i)) K := by
  apply ConvexBody.ext
  simp only [selectBody, coe_mapBody, Set.image_image]
  rfl

@[simp] theorem selectBody_id {n : ℕ} (K : Body n) : selectBody id K = K := by
  apply ConvexBody.ext
  change (fun x : V n => x) '' (K : Set (V n)) = (K : Set (V n))
  exact Set.image_id _

theorem mem_selectBody_equiv {n : ℕ} (e : Equiv.Perm (Fin n)) (K : Body n) (x : V n) :
    x ∈ selectBody e K ↔ selectCoordinates e.symm x ∈ K := by
  constructor
  · rintro ⟨y, hy, rfl⟩
    change (fun i => y (e (e.symm i))) ∈ (K : Set (V n))
    simpa only [Equiv.apply_symm_apply] using hy
  · intro hx
    refine ⟨selectCoordinates e.symm x, hx, ?_⟩
    ext i
    change x (e.symm (e i)) = x i
    rw [e.symm_apply_apply]

def deletedIndex {n : ℕ} (i j : Fin (n + 1)) (h : j ≠ i) : Fin n :=
  Classical.choose (Fin.exists_succAbove_eq h)

theorem deletedIndex_spec {n : ℕ} (i j : Fin (n + 1)) (h : j ≠ i) :
    i.succAbove (deletedIndex i j h) = j := Classical.choose_spec (Fin.exists_succAbove_eq h)

def deletionMap {n : ℕ} (e : Equiv.Perm (Fin (n + 1))) (i : Fin (n + 1))
    (j : Fin n) : Fin n :=
  deletedIndex (e i) (e (i.succAbove j)) (fun h => i.succAbove_ne j (e.injective h))

theorem deletionMap_spec {n : ℕ} (e : Equiv.Perm (Fin (n + 1)))
    (i : Fin (n + 1)) (j : Fin n) :
    (e i).succAbove (deletionMap e i j) = e (i.succAbove j) :=
  deletedIndex_spec _ _ _

theorem deletionMap_injective {n : ℕ} (e : Equiv.Perm (Fin (n + 1))) (i : Fin (n + 1)) :
    Function.Injective (deletionMap e i) := by
  intro j k h
  apply i.succAbove_right_injective
  apply e.injective
  rw [← deletionMap_spec e i j, ← deletionMap_spec e i k, h]

def deletePermutation {n : ℕ} (e : Equiv.Perm (Fin (n + 1))) (i : Fin (n + 1)) :
    Equiv.Perm (Fin n) :=
  Equiv.ofBijective (deletionMap e i) (Finite.injective_iff_bijective.mp (deletionMap_injective e i))

theorem deletePermutation_spec {n : ℕ} (e : Equiv.Perm (Fin (n + 1)))
    (i : Fin (n + 1)) (j : Fin n) :
    (e i).succAbove (deletePermutation e i j) = e (i.succAbove j) := deletionMap_spec e i j

/-- The diagram of an actual permutation and an actual coordinate deletion commutes. -/
theorem delete_selectBody {n : ℕ} (e : Equiv.Perm (Fin (n + 1)))
    (i : Fin (n + 1)) (K : Body (n + 1)) :
    deleteBody i (selectBody e K) =
      selectBody (deletePermutation e i) (deleteBody (e i) K) := by
  apply ConvexBody.ext
  simp only [deleteBody, selectBody, coe_mapBody, Set.image_image]
  congr 1
  funext x
  ext j
  change x (e (i.succAbove j)) = x ((e i).succAbove (deletePermutation e i j))
  rw [deletePermutation_spec]

theorem agreesExcept_select_left {n : ℕ} (e : Equiv.Perm (Fin n)) (i : Fin n) (x y : V n) :
    agreesExcept i (selectCoordinates e x) y ↔
      agreesExcept (e i) x (selectCoordinates e.symm y) := by
  constructor
  · intro h r hr
    have hri : e.symm r ≠ i := by
      intro he
      apply hr
      calc
        r = e (e.symm r) := (e.apply_symm_apply r).symm
        _ = e i := congrArg e he
    have hh := h (e.symm r) hri
    change x (e (e.symm r)) = y (e.symm r) at hh
    change x r = y (e.symm r)
    simpa only [Equiv.apply_symm_apply] using hh
  · intro h r hr
    have hri : e r ≠ e i := fun he => hr (e.injective he)
    have hh := h (e r) hri
    change x (e r) = y (e.symm (e r)) at hh
    change x (e r) = y r
    simpa only [Equiv.symm_apply_apply] using hh

theorem mem_fiberHull_iff {n : ℕ} (K : Body (n + 1))
    (j k : Fin (n + 1)) (hjk : j ≠ k) (x : V (n + 1)) :
    x ∈ fiberHull K j k hjk ↔
      (∃ y ∈ K, agreesExcept j y x) ∧ (∃ z ∈ K, agreesExcept k z x) := by
  change ((∃ y ∈ K, deleteCoord j y = deleteCoord j x) ∧
    (∃ z ∈ K, deleteCoord k z = deleteCoord k x)) ↔ _
  simp only [deleteCoord_eq_iff]

/-- Reindexing preserves the exact fiber product, including its actual carrier set. -/
theorem fiberHull_selectBody {n : ℕ} (e : Equiv.Perm (Fin (n + 1))) (K : Body (n + 1))
    (j k : Fin (n + 1)) (hjk : j ≠ k) :
    fiberHull (selectBody e K) j k hjk =
      selectBody e (fiberHull K (e j) (e k) (fun h => hjk (e.injective h))) := by
  have hejk : e j ≠ e k := fun h => hjk (e.injective h)
  change fiberHull (selectBody e K) j k hjk = selectBody e (fiberHull K (e j) (e k) hejk)
  apply ConvexBody.ext
  apply Set.ext
  intro x
  refine (mem_fiberHull_iff (selectBody e K) j k hjk x).trans ?_
  refine Iff.trans ?_ (mem_selectBody_equiv e (fiberHull K (e j) (e k) hejk) x).symm
  refine Iff.trans ?_ (mem_fiberHull_iff K (e j) (e k) hejk
    (selectCoordinates e.symm x)).symm
  constructor
  · rintro ⟨⟨y, ⟨u, hu, rfl⟩, hy⟩, ⟨z, ⟨v, hv, rfl⟩, hz⟩⟩
    exact ⟨⟨u, hu, (agreesExcept_select_left e j u x).mp hy⟩,
      ⟨v, hv, (agreesExcept_select_left e k v x).mp hz⟩⟩
  · rintro ⟨⟨u, hu, hy⟩, ⟨v, hv, hz⟩⟩
    exact ⟨⟨selectCoordinates e u, Set.mem_image_of_mem _ hu,
        (agreesExcept_select_left e j u x).mpr hy⟩,
      ⟨selectCoordinates e v, Set.mem_image_of_mem _ hv,
        (agreesExcept_select_left e k v x).mpr hz⟩⟩

theorem deleteCoord_surjective {n : ℕ} (i : Fin (n + 1)) :
    Function.Surjective (deleteCoord i) := by
  intro x
  refine ⟨insertCoord i x, ?_⟩
  ext j
  exact insertCoord_succAbove i x j

theorem deleteBody_interior_nonempty {n : ℕ} (i : Fin (n + 1)) (K : Body (n + 1))
    (hK : (interior (K : Set (V (n + 1)))).Nonempty) :
    (interior (deleteBody i K : Set (V n))).Nonempty := by
  have ho : IsOpen (deleteCoord i '' interior (K : Set (V (n + 1)))) :=
    (deleteCoord i).toLinearMap.isOpenMap_of_finiteDimensional
      (deleteCoord_surjective i) _ isOpen_interior
  have hs : deleteCoord i '' interior (K : Set (V (n + 1))) ⊆
      interior (deleteBody i K : Set (V n)) :=
    interior_maximal (Set.image_mono interior_subset) ho
  exact (hK.image _).mono hs

/-- The product-coordinate and `Fin 2` conventions measure precisely the same planar area. -/
theorem pairArea_eq_coordinateAreaMatrix {n : ℕ} (K : Body n) (i j : Fin n) :
    pairArea (K : Set (V n)) i j = coordinateAreaMatrix K i j := by
  let S : Set (V 2) := ProjectionAreaTransforms.projectN i j '' (K : Set (V n))
  have hm := (volume_preserving_finTwoArrow ℝ).measure_preimage_equiv
    (MeasurableEquiv.finTwoArrow '' S)
  rw [Set.preimage_image_eq _ MeasurableEquiv.finTwoArrow.injective] at hm
  have he : coordinatePair i j '' (K : Set (V n)) = MeasurableEquiv.finTwoArrow '' S := by
    dsimp only [S]
    rw [Set.image_image]
    rfl
  unfold pairArea
  rw [he]
  exact congrArg ENNReal.toReal hm.symm

/-- A boundary-kernel fiber-product identity can be transported through
any coordinate permutation before taking the chosen deletion. -/
theorem reindexed_deletion_fiberHull
    (K : Body 4) (P : PositiveHollowMatrix 4) (hP : P.entries = coordinateAreaMatrix K)
    (hrank : P.entries.rank ≤ 3) (c : BalancedKernel (complementary P.entries))
    (e : Equiv.Perm (Fin 4)) (i : Fin 4) (j k : Fin 3) (hjk : j ≠ k)
    (hci : 0 < c.coeff (e i))
    (hpositive : ∀ r, r ≠ e (i.succAbove j) → r ≠ e (i.succAbove k) → 0 ≤ c.coeff r) :
    fiberHull (deleteBody i (selectBody e K)) j k hjk = deleteBody i (selectBody e K) := by
  let d := deletePermutation e i
  have hdjk : d j ≠ d k := fun h => hjk (d.injective h)
  have hproduct := deletion_fiberHull_of_kernel K c.coeff (e i) (d j) (d k) hdjk hci
    (by
      intro r hrj hrk
      apply hpositive r
      · simpa only [d, deletePermutation_spec] using hrj
      · simpa only [d, deletePermutation_spec] using hrk)
    (kernel_pairing_of_complementary_kernel K P hP c)
    (triple_projection_interior_of_rank_le_three K P hP hrank (e i))
  rw [delete_selectBody, fiberHull_selectBody]
  change selectBody d (fiberHull (deleteBody (e i) K) (d j) (d k) hdjk) =
    selectBody d (deleteBody (e i) K)
  rw [hproduct]

/-- The two increasing deletions retain exactly the coordinates `0,1,2`.
This is an equality of the projected convex bodies, not just their areas. -/
theorem shared_three_deletions (K : Body 5) :
    deleteBody (3 : Fin 4) (deleteBody (4 : Fin 5) K) =
      deleteBody (3 : Fin 4) (deleteBody (3 : Fin 5) K) := by
  apply ConvexBody.ext
  simp only [deleteBody, coe_mapBody, Set.image_image]
  congr 1
  funext x
  ext i
  fin_cases i <;> rfl

private theorem orient_first_partition {M : Matrix (Fin 4) (Fin 4) ℝ}
    (c : BalancedKernel M) (e : Equiv.Perm (Fin 4))
    (h01 : 0 < c.coeff (e 0) ↔ 0 < c.coeff (e 1))
    (h23 : 0 < c.coeff (e 2) ↔ 0 < c.coeff (e 3))
    (h02 : ¬ (0 < c.coeff (e 0) ↔ 0 < c.coeff (e 2))) :
    ∃ d : BalancedKernel M, d.coeff (e 0) < 0 ∧ d.coeff (e 1) < 0 ∧
      0 < d.coeff (e 2) ∧ 0 < d.coeff (e 3) := by
  obtain ⟨d, hd3, hsame⟩ := c.exists_oriented (e 3)
  have hd2 : 0 < d.coeff (e 2) := ((hsame (e 2) (e 3)).mpr h23).mpr hd3
  have hd0n : ¬ 0 < d.coeff (e 0) := by
    intro hd0
    exact h02 ((hsame (e 0) (e 2)).mp ⟨fun _ => hd2, fun _ => hd0⟩)
  have hd1n : ¬ 0 < d.coeff (e 1) := by
    intro hd1
    exact hd0n (((hsame (e 0) (e 1)).mpr h01).mpr hd1)
  exact ⟨d, lt_of_le_of_ne (le_of_not_gt hd0n) (d.nonzero (e 0)),
    lt_of_le_of_ne (le_of_not_gt hd1n) (d.nonzero (e 1)), hd2, hd3⟩

private theorem orient_second_partition {M : Matrix (Fin 4) (Fin 4) ℝ}
    (c : BalancedKernel M) (e : Equiv.Perm (Fin 4))
    (h12 : 0 < c.coeff (e 1) ↔ 0 < c.coeff (e 2))
    (h03 : 0 < c.coeff (e 0) ↔ 0 < c.coeff (e 3))
    (h01 : ¬ (0 < c.coeff (e 0) ↔ 0 < c.coeff (e 1))) :
    ∃ d : BalancedKernel M, 0 < d.coeff (e 0) ∧ d.coeff (e 1) < 0 ∧
      d.coeff (e 2) < 0 ∧ 0 < d.coeff (e 3) := by
  obtain ⟨d, hd3, hsame⟩ := c.exists_oriented (e 3)
  have hd0 : 0 < d.coeff (e 0) := ((hsame (e 0) (e 3)).mpr h03).mpr hd3
  have hd1n : ¬ 0 < d.coeff (e 1) := by
    intro hd1
    exact h01 ((hsame (e 0) (e 1)).mp ⟨fun _ => hd1, fun _ => hd0⟩)
  have hd2n : ¬ 0 < d.coeff (e 2) := by
    intro hd2
    exact hd1n (((hsame (e 1) (e 2)).mpr h12).mpr hd2)
  exact ⟨d, hd0, lt_of_le_of_ne (le_of_not_gt hd1n) (d.nonzero (e 1)),
    lt_of_le_of_ne (le_of_not_gt hd2n) (d.nonzero (e 2)), hd3⟩

/-- The principal five-label obstruction, on actual ordinary Lebesgue
projection areas of an arbitrary nonempty compact convex body. No
full-dimensionality hypothesis is imposed on the realizing body. -/
theorem five_positive_rank_not_le_three
    (K : Body 5)
    (hpositive : ∀ i j : Fin 5, i ≠ j → 0 < coordinateAreaMatrix K i j) :
    ¬ (coordinateAreaMatrix K).rank ≤ 3 := by
  classical
  intro hrank
  let P : PositiveHollowMatrix 5 :=
    { entries := coordinateAreaMatrix K
      hollow := coordinateAreaMatrix_hollow K
      symmetric := coordinateAreaMatrix_symmetric K
      positive := hpositive }
  let D : Fin 5 → Body 4 := fun m => deleteBody m K
  have hmatrix (m : Fin 5) :
      (FiveLabels.deletedMatrix P m).entries = coordinateAreaMatrix (D m) := by
    exact (coordinateAreaMatrix_deleteBody m K).symm
  have hquartet (m : Fin 5) : (FiveLabels.deletedMatrix P m).entries.rank ≤ 3 :=
    (FiveLabels.deletedMatrix_rank P m).trans hrank
  obtain ⟨c⟩ := FiveLabels.exists_kernel_family P hrank
  obtain ⟨e, he⟩ := ProjectionBoundaryCuts.five_balanced_cuts_cross_configuration
    (FiveLabels.kernelSide c) (FiveLabels.kernelSide_card c)
    (FiveLabels.omitted_not_mem_kernelSide c)
  let f : Equiv.Perm (Fin 4) := deletePermutation e 4
  let g : Equiv.Perm (Fin 4) := deletePermutation e 3
  have hmembership (i : Fin 5) (j : Fin 4) :
      e (i.succAbove j) ∈ FiveLabels.kernelSide c (e i) ↔
        0 < (c (e i)).coeff (deletePermutation e i j) := by
    rw [← deletePermutation_spec]
    exact FiveLabels.mem_kernelSide c (e i) (deletePermutation e i j)
  have hm40 : e 0 ∈ FiveLabels.kernelSide c (e 4) ↔ 0 < (c (e 4)).coeff (f 0) :=
    hmembership 4 0
  have hm41 : e 1 ∈ FiveLabels.kernelSide c (e 4) ↔ 0 < (c (e 4)).coeff (f 1) :=
    hmembership 4 1
  have hm42 : e 2 ∈ FiveLabels.kernelSide c (e 4) ↔ 0 < (c (e 4)).coeff (f 2) :=
    hmembership 4 2
  have hm43 : e 3 ∈ FiveLabels.kernelSide c (e 4) ↔ 0 < (c (e 4)).coeff (f 3) :=
    hmembership 4 3
  have hm30 : e 0 ∈ FiveLabels.kernelSide c (e 3) ↔ 0 < (c (e 3)).coeff (g 0) :=
    hmembership 3 0
  have hm31 : e 1 ∈ FiveLabels.kernelSide c (e 3) ↔ 0 < (c (e 3)).coeff (g 1) :=
    hmembership 3 1
  have hm32 : e 2 ∈ FiveLabels.kernelSide c (e 3) ↔ 0 < (c (e 3)).coeff (g 2) :=
    hmembership 3 2
  have hm34 : e 4 ∈ FiveLabels.kernelSide c (e 3) ↔ 0 < (c (e 3)).coeff (g 3) :=
    hmembership 3 3
  rcases he with ⟨h01, h23, h02, h12, h04, h01'⟩
  rw [hm40, hm41] at h01
  rw [hm42, hm43] at h23
  rw [hm40, hm42] at h02
  rw [hm31, hm32] at h12
  rw [hm30, hm34] at h04
  rw [hm30, hm31] at h01'
  obtain ⟨a, ha0, ha1, ha2, ha3⟩ := orient_first_partition (c (e 4)) f h01 h23 h02
  obtain ⟨b, hb0, hb1, hb2, hb3⟩ := orient_second_partition (c (e 3)) g h12 h04 h01'
  let A : Body 4 := selectBody f (D (e 4))
  let B : Body 4 := selectBody g (D (e 3))
  have hleft : fiberHull (deleteBody 3 A) 0 1 (by decide) = deleteBody 3 A := by
    apply reindexed_deletion_fiberHull (D (e 4)) (FiveLabels.deletedMatrix P (e 4))
      (hmatrix (e 4)) (hquartet (e 4)) a f 3 0 1 (by decide) ha3
    intro r hr0 hr1
    obtain ⟨s, rfl⟩ := f.surjective r
    fin_cases s
    · exact (hr0 rfl).elim
    · exact (hr1 rfl).elim
    · exact ha2.le
    · exact ha3.le
  have hright : fiberHull (deleteBody 3 B) 1 2 (by decide) = deleteBody 3 B := by
    apply reindexed_deletion_fiberHull (D (e 3)) (FiveLabels.deletedMatrix P (e 3))
      (hmatrix (e 3)) (hquartet (e 3)) b g 3 1 2 (by decide) hb3
    intro r hr1 hr2
    obtain ⟨s, rfl⟩ := g.surjective r
    fin_cases s
    · exact hb0.le
    · exact (hr1 rfl).elim
    · exact (hr2 rfl).elim
    · exact hb3.le
  have hproduct : fiberHull (deleteBody 0 A) 1 2 (by decide) = deleteBody 0 A := by
    apply reindexed_deletion_fiberHull (D (e 4)) (FiveLabels.deletedMatrix P (e 4))
      (hmatrix (e 4)) (hquartet (e 4)) a.neg f 0 1 2 (by decide) (neg_pos.mpr ha0)
    intro r hr2 hr3
    obtain ⟨s, rfl⟩ := f.surjective r
    fin_cases s
    · exact (neg_pos.mpr ha0).le
    · exact (neg_pos.mpr ha1).le
    · exact (hr2 rfl).elim
    · exact (hr3 rfl).elim
  have hA : A = deleteBody 4 (selectBody e K) := (delete_selectBody e 4 K).symm
  have hB : B = deleteBody 3 (selectBody e K) := (delete_selectBody e 3 K).symm
  have hcommon : deleteBody (3 : Fin 4) A = deleteBody (3 : Fin 4) B := by
    rw [hA, hB]
    exact shared_three_deletions (selectBody e K)
  have harea : coordinateAreaMatrix A = (FiveLabels.deletedMatrix P (e 4)).entries.submatrix f f := by
    change coordinateAreaMatrix (selectBody f (D (e 4))) = _
    rw [coordinateAreaMatrix_selectBody, ← hmatrix (e 4)]
  have hApositive (i j : Fin 4) (hij : i ≠ j) : 0 < coordinateAreaMatrix A i j := by
    rw [harea]
    exact (FiveLabels.deletedMatrix P (e 4)).positive (f i) (f j)
      (fun h => hij (f.injective h))
  have hArank : (coordinateAreaMatrix A).rank ≤ 3 := by
    rw [harea]
    exact ((FiveLabels.deletedMatrix P (e 4)).entries.rank_submatrix_le f f).trans (hquartet (e 4))
  have hright' : fiberHull (deleteBody 3 A) 1 2 (by decide) = deleteBody 3 A := by
    rw [hcommon]
    exact hright
  have hprism : IndependentCoordinate (deleteBody 3 A : Set (V 3)) 1 :=
    middle_prism_independent (deleteBody 3 A) hleft hright'
      (deleteBody_interior_nonempty 1 (deleteBody 3 A)
        (triple_projection_interior A hApositive hArank 3))
  apply boundary_prism_obstruction A
    (fun i j hij => by rw [pairArea_eq_coordinateAreaMatrix]; exact hApositive i j hij)
    _ hproduct hprism
  simp only [pairArea_eq_coordinateAreaMatrix, harea, Matrix.submatrix]
  exact (FiveLabels.deletedMatrix P (e 4)).four_det_eq_zero (hquartet (e 4))
    (f 0) (f 1) (f 2) (f 3)

/-- A matrix form of the obstruction, retaining exact equality with the
ordinary coordinate-area matrix of the proposed realization. -/
theorem positive_five_matrix_not_realizable (P : PositiveHollowMatrix 5)
    (hrank : P.entries.rank ≤ 3) :
    ¬ ∃ K : Body 5, coordinateAreaMatrix K = P.entries := by
  rintro ⟨K, hK⟩
  apply five_positive_rank_not_le_three K
    (fun i j hij => by rw [hK]; exact P.positive i j hij)
  simpa only [hK] using hrank

