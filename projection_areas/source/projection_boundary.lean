section Source_PlanarRectangleBound

@[expose] public section

/-!
# A planar area bound from the two endpoint fibers

The sets and measures in this file are ordinary planar convex sets and
Lebesgue measure.  The four triangles used below have disjoint interiors.
Their areas are obtained from the already proved product-fiber pyramid
formula, including degenerate triangles.
-/

noncomputable section
open Set MeasureTheory
open scoped Pointwise BigOperators

namespace ProjectionAreaRectangleBound

open VolumePolynomials.PyramidVolume VolumePolynomials.PlanarExtrusion
open ProjectionAreaIntervals

abbrev Plane := ℝ × ℝ

/-- A filled triangle, parametrized by two closed unit intervals. -/
def filledTriangle (a b c : Plane) : Set Plane :=
  (fun p : Plane => a + frameMap (b-a) (c-b) p) ''
    unitPyramid (Icc (0 : ℝ) 1)

theorem filledTriangle_compact (a b c : Plane) : IsCompact (filledTriangle a b c) :=
  (unitPyramid_compact isCompact_Icc).image
    (continuous_const.add (frameMap (b-a) (c-b)).continuous_of_finiteDimensional)

theorem filledTriangle_subset_convex {K : Set Plane} (hK : Convex ℝ K)
    {a b c : Plane} (ha : a ∈ K) (hb : b ∈ K) (hc : c ∈ K) :
    filledTriangle a b c ⊆ K := by
  rintro x ⟨p, ⟨⟨t,s⟩, ⟨ht,hs⟩, rfl⟩, rfl⟩
  have hbc := hK hb hc (sub_nonneg.mpr hs.2) hs.1
    (show (1-s)+s=1 by ring)
  have hh := hK ha hbc (sub_nonneg.mpr ht.2) ht.1
    (show (1-t)+t=1 by ring)
  convert hh using 1 <;> ext <;>
    simp only [frameMap, LinearMap.coe_mk, AddHom.coe_mk, Prod.fst_add,
      Prod.snd_add, Prod.fst_sub, Prod.snd_sub, Prod.smul_fst, Prod.smul_snd,
      smul_eq_mul] <;> ring

theorem filledTriangle_area (a b c : Plane) :
    volume.real (filledTriangle a b c) = |determinant (b-a) (c-a)| / 2 := by
  have htrans (S : Set Plane) : volume.real ((fun x : Plane => a+x) '' S) =
      volume.real S := by
    simp only [measureReal_def, Set.image_add_left, measure_preimage_add]
  have himage : filledTriangle a b c =
      (fun x : Plane => a+x) ''
        (frameMap (b-a) (c-b) '' unitPyramid (Icc (0 : ℝ) 1)) := by
    rw [Set.image_image]
    rfl
  rw [himage, htrans, area_image_linear, frameMap_det,
    realVolume_unitPyramid isCompact_Icc]
  have hd : determinant (b-a) (c-b) = determinant (b-a) (c-a) := by
    simp only [determinant, Prod.fst_sub, Prod.snd_sub]
    ring
  rw [hd]
  norm_num <;> ring

def affineValue (α β γ : ℝ) (p : Plane) : ℝ := α*p.1 + β*p.2 + γ

theorem convex_affine_le (α β γ : ℝ) :
    Convex ℝ {p : Plane | affineValue α β γ p ≤ 0} := by
  intro x hx y hy a b ha hb hab
  change α*(a*x.1+b*y.1) + β*(a*x.2+b*y.2) + γ ≤ 0
  change α*x.1+β*x.2+γ ≤ 0 at hx
  change α*y.1+β*y.2+γ ≤ 0 at hy
  have he : α*(a*x.1+b*y.1) + β*(a*x.2+b*y.2) + γ =
      a*(α*x.1+β*x.2+γ) + b*(α*y.1+β*y.2+γ) := by
    have hγ : a*γ+b*γ=γ := by rw [← add_mul,hab,one_mul]
    nlinarith only [hγ]
  rw [he]
  exact add_nonpos (mul_nonpos_of_nonneg_of_nonpos ha hx)
    (mul_nonpos_of_nonneg_of_nonpos hb hy)

theorem triangle_affine_le (a b c : Plane) (α β γ : ℝ)
    (ha : affineValue α β γ a ≤ 0) (hb : affineValue α β γ b ≤ 0)
    (hc : affineValue α β γ c ≤ 0) :
    ∀ p ∈ filledTriangle a b c, affineValue α β γ p ≤ 0 :=
  filledTriangle_subset_convex (convex_affine_le α β γ) ha hb hc

theorem triangle_affine_ge (a b c : Plane) (α β γ : ℝ)
    (ha : 0 ≤ affineValue α β γ a) (hb : 0 ≤ affineValue α β γ b)
    (hc : 0 ≤ affineValue α β γ c) :
    ∀ p ∈ filledTriangle a b c, 0 ≤ affineValue α β γ p := by
  have h := triangle_affine_le a b c (-α) (-β) (-γ)
    (by dsimp [affineValue] at *; linarith)
    (by dsimp [affineValue] at *; linarith)
    (by dsimp [affineValue] at *; linarith)
  intro p hp
  have hh := h p hp
  dsimp [affineValue] at *
  linarith

theorem triangle_horizontal_bounds (a b c : Plane)
    (ha : a.1 ∈ Icc (0 : ℝ) 1) (hb : b.1 ∈ Icc (0 : ℝ) 1)
    (hc : c.1 ∈ Icc (0 : ℝ) 1) :
    ∀ p ∈ filledTriangle a b c, p.1 ∈ Icc (0 : ℝ) 1 := by
  intro p hp
  have hlo := triangle_affine_ge a b c 1 0 0
    (by simpa [affineValue] using ha.1)
    (by simpa [affineValue] using hb.1)
    (by simpa [affineValue] using hc.1) p hp
  have hhi := triangle_affine_le a b c 1 0 (-1)
    (by simp only [affineValue, one_mul, zero_mul, add_zero]; linarith [ha.2])
    (by simp only [affineValue, one_mul, zero_mul, add_zero]; linarith [hb.2])
    (by simp only [affineValue, one_mul, zero_mul, add_zero]; linarith [hc.2]) p hp
  simp only [affineValue, one_mul, zero_mul, add_zero] at hlo hhi
  exact ⟨hlo, by linarith⟩

/-- The signed height above the line through `(0,a)` and `(1,b)`. -/
def side (a b : ℝ) (p : Plane) : ℝ := p.2 - ((1-p.1)*a+p.1*b)

theorem side_eq_affine (a b : ℝ) (p : Plane) :
    side a b p = affineValue (a-b) 1 (-a) p := by
  dsimp [side,affineValue]
  ring

theorem triangle_side_le (a b c : Plane) (l r : ℝ)
    (ha : side l r a ≤ 0) (hb : side l r b ≤ 0) (hc : side l r c ≤ 0) :
    ∀ p ∈ filledTriangle a b c, side l r p ≤ 0 := by
  simpa only [side_eq_affine] using triangle_affine_le a b c (l-r) 1 (-l)
    (by simpa only [← side_eq_affine] using ha)
    (by simpa only [← side_eq_affine] using hb)
    (by simpa only [← side_eq_affine] using hc)

theorem triangle_side_ge (a b c : Plane) (l r : ℝ)
    (ha : 0 ≤ side l r a) (hb : 0 ≤ side l r b) (hc : 0 ≤ side l r c) :
    ∀ p ∈ filledTriangle a b c, 0 ≤ side l r p := by
  simpa only [side_eq_affine] using triangle_affine_ge a b c (l-r) 1 (-l)
    (by simpa only [← side_eq_affine] using ha)
    (by simpa only [← side_eq_affine] using hb)
    (by simpa only [← side_eq_affine] using hc)

theorem side_level_null (a b : ℝ) :
    (volume : Measure Plane) {p | side a b p = 0} = 0 := by
  let f : Plane →ₗ[ℝ] ℝ := LinearMap.snd ℝ ℝ ℝ - (b-a) • LinearMap.fst ℝ ℝ ℝ
  have hf : f ≠ 0 := by
    intro h
    have hh := congrArg (fun g : Plane →ₗ[ℝ] ℝ => g (0,1)) h
    norm_num [f] at hh
  let S : AffineSubspace ℝ Plane := ({a} : AffineSubspace ℝ ℝ).comap f.toAffineMap
  have hS : S ≠ ⊤ := by
    intro htop
    have heq (p : Plane) : f p = a := by
      have hp : p ∈ S := by rw [htop]; trivial
      simpa [S, AffineSubspace.mem_comap] using hp
    have ha : a = 0 := by simpa using (heq 0).symm
    apply hf
    exact LinearMap.ext (fun p => (heq p).trans ha)
  have hset : (S : Set Plane) = {p | side a b p = 0} := by
    ext p
    change f p = a ↔ side a b p = 0
    change p.2 - (b-a) * p.1 = a ↔ p.2 - ((1-p.1)*a + p.1*b) = 0
    constructor <;> intro h <;> nlinarith
  rw [← hset]
  exact Measure.addHaar_affineSubspace volume S hS

def piece (l₀ u₀ l₁ u₁ s t : ℝ) : Fin 4 → Set Plane :=
  ![filledTriangle (0,l₀) (1,l₁) (1,u₁),
    filledTriangle (0,l₀) (1,u₁) (0,u₀),
    filledTriangle (0,u₀) (1,u₁) (t,1),
    filledTriangle (0,l₀) (1,l₁) (s,0)]

def seam (l₀ u₀ l₁ u₁ : ℝ) : Set Plane :=
  {p | side l₀ u₁ p = 0} ∪ {p | side l₀ l₁ p = 0} ∪
    {p | side u₀ u₁ p = 0}

theorem seam_null (l₀ u₀ l₁ u₁ : ℝ) : volume (seam l₀ u₀ l₁ u₁) = 0 := by
  simp only [seam, measure_union_null_iff, side_level_null, and_self]

theorem piece_compact (l₀ u₀ l₁ u₁ s t : ℝ) (i : Fin 4) :
    IsCompact (piece l₀ u₀ l₁ u₁ s t i) := by
  fin_cases i <;> exact filledTriangle_compact _ _ _

theorem piece_horizontal (l₀ u₀ l₁ u₁ s t : ℝ)
    (hs : s ∈ Icc (0 : ℝ) 1) (ht : t ∈ Icc (0 : ℝ) 1) (i : Fin 4) :
    ∀ p ∈ piece l₀ u₀ l₁ u₁ s t i, p.1 ∈ Icc (0 : ℝ) 1 := by
  fin_cases i <;> apply triangle_horizontal_bounds <;> first | exact hs | exact ht | norm_num

def pieceRegion (l₀ u₀ l₁ u₁ : ℝ) (p : Plane) : Fin 4 → Prop :=
  ![(side l₀ u₁ p ≤ 0 ∧ 0 ≤ side l₀ l₁ p ∧ side u₀ u₁ p ≤ 0),
    (0 ≤ side l₀ u₁ p ∧ 0 ≤ side l₀ l₁ p ∧ side u₀ u₁ p ≤ 0),
    0 ≤ side u₀ u₁ p,
    side l₀ l₁ p ≤ 0]

theorem piece_region (l₀ u₀ l₁ u₁ s t : ℝ)
    (hl₀ : 0 ≤ l₀) (hlu₀ : l₀ ≤ u₀) (hu₀ : u₀ ≤ 1)
    (hl₁ : 0 ≤ l₁) (hlu₁ : l₁ ≤ u₁) (hu₁ : u₁ ≤ 1)
    (hs : s ∈ Icc (0 : ℝ) 1) (ht : t ∈ Icc (0 : ℝ) 1)
    (i : Fin 4) {p : Plane} (hp : p ∈ piece l₀ u₀ l₁ u₁ s t i) :
    pieceRegion l₀ u₀ l₁ u₁ p i := by
  have htop : 0 ≤ side u₀ u₁ (t,1) := by
    dsimp [side]
    nlinarith [mul_nonneg (sub_nonneg.mpr ht.2) (sub_nonneg.mpr hu₀),
      mul_nonneg ht.1 (sub_nonneg.mpr hu₁)]
  have hbottom : side l₀ l₁ (s,0) ≤ 0 := by
    dsimp [side]
    nlinarith [mul_nonneg (sub_nonneg.mpr hs.2) hl₀, mul_nonneg hs.1 hl₁]
  fin_cases i
  · refine ⟨triangle_side_le _ _ _ _ _ ?_ ?_ ?_ p hp,
      triangle_side_ge _ _ _ _ _ ?_ ?_ ?_ p hp,
      triangle_side_le _ _ _ _ _ ?_ ?_ ?_ p hp⟩ <;>
      norm_num [side] <;> linarith
  · refine ⟨triangle_side_ge _ _ _ _ _ ?_ ?_ ?_ p hp,
      triangle_side_ge _ _ _ _ _ ?_ ?_ ?_ p hp,
      triangle_side_le _ _ _ _ _ ?_ ?_ ?_ p hp⟩ <;>
      norm_num [side] <;> linarith
  · exact triangle_side_ge _ _ _ _ _ (by simp [side]) (by simp [side]) htop p hp
  · exact triangle_side_le _ _ _ _ _ (by simp [side]) (by simp [side]) hbottom p hp

theorem pieces_aedisjoint (l₀ u₀ l₁ u₁ s t : ℝ)
    (hl₀ : 0 ≤ l₀) (hlu₀ : l₀ ≤ u₀) (hu₀ : u₀ ≤ 1)
    (hl₁ : 0 ≤ l₁) (hlu₁ : l₁ ≤ u₁) (hu₁ : u₁ ≤ 1)
    (hs : s ∈ Icc (0 : ℝ) 1) (ht : t ∈ Icc (0 : ℝ) 1)
    (i j : Fin 4) (hij : i ≠ j) :
    AEDisjoint volume (piece l₀ u₀ l₁ u₁ s t i) (piece l₀ u₀ l₁ u₁ s t j) := by
  apply measure_mono_null (t := seam l₀ u₀ l₁ u₁) _ (seam_null _ _ _ _)
  intro p hp
  have hx := piece_horizontal l₀ u₀ l₁ u₁ s t hs ht i p hp.1
  have horder : side u₀ u₁ p ≤ side l₀ l₁ p := by
    dsimp [side]
    nlinarith [mul_nonneg (sub_nonneg.mpr hx.2) (sub_nonneg.mpr hlu₀),
      mul_nonneg hx.1 (sub_nonneg.mpr hlu₁)]
  have hi := piece_region l₀ u₀ l₁ u₁ s t hl₀ hlu₀ hu₀ hl₁ hlu₁ hu₁ hs ht i hp.1
  have hj := piece_region l₀ u₀ l₁ u₁ s t hl₀ hlu₀ hu₀ hl₁ hlu₁ hu₁ hs ht j hp.2
  by_contra hn
  simp only [seam, mem_union, mem_setOf_eq, not_or] at hn
  rcases hn with ⟨⟨hd,hl⟩,hu⟩
  fin_cases i <;> fin_cases j <;> try contradiction
  all_goals simp [pieceRegion] at hi hj
  all_goals try rcases hi with ⟨hi₁,hi₂,hi₃⟩
  all_goals try rcases hj with ⟨hj₁,hj₂,hj₃⟩
  all_goals first
  | exact hd (by linarith)
  | exact hl (by linarith)
  | exact hu (by linarith)

theorem piece_areas (l₀ u₀ l₁ u₁ s t : ℝ)
    (hl₀ : 0 ≤ l₀) (hlu₀ : l₀ ≤ u₀) (hu₀ : u₀ ≤ 1)
    (hl₁ : 0 ≤ l₁) (hlu₁ : l₁ ≤ u₁) (hu₁ : u₁ ≤ 1)
    (hs : s ∈ Icc (0 : ℝ) 1) (ht : t ∈ Icc (0 : ℝ) 1) :
    ∑ i : Fin 4, volume.real (piece l₀ u₀ l₁ u₁ s t i) =
      (1+t*u₀+(1-t)*u₁-s*l₀-(1-s)*l₁)/2 := by
  have htop : 0 ≤ 1-((1-t)*u₀+t*u₁) := by
    nlinarith [mul_nonneg (sub_nonneg.mpr ht.2) (sub_nonneg.mpr hu₀),
      mul_nonneg ht.1 (sub_nonneg.mpr hu₁)]
  have hbottom : 0 ≤ (1-s)*l₀+s*l₁ :=
    add_nonneg (mul_nonneg (sub_nonneg.mpr hs.2) hl₀) (mul_nonneg hs.1 hl₁)
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, piece,
    Matrix.cons_val_zero, Matrix.cons_val_succ, filledTriangle_area,
    determinant, Prod.fst_sub, Prod.snd_sub]
  have e₁ : (1-0)*(u₁-l₀)-(l₁-l₀)*(1-0) = u₁-l₁ := by ring
  have e₂ : (1-0)*(u₀-l₀)-(u₁-l₀)*(0-0) = u₀-l₀ := by ring
  have e₃ : (1-0)*(1-u₀)-(u₁-u₀)*(t-0) = 1-((1-t)*u₀+t*u₁) := by ring
  have e₄ : (1-0)*(0-l₀)-(l₁-l₀)*(s-0) = -((1-s)*l₀+s*l₁) := by ring
  rw [e₁,e₂,e₃,e₄,abs_of_nonneg (sub_nonneg.mpr hlu₁),
    abs_of_nonneg (sub_nonneg.mpr hlu₀),abs_of_nonneg htop,
    abs_neg,abs_of_nonneg hbottom]
  ring

/-- A completely geometric endpoint-fiber bound. The six supplied points
are points of the actual convex set, and its area is ordinary Lebesgue area. -/
theorem area_lower_bound_of_endpoint_points {K : Set Plane}
    (hK : IsCompact K) (hc : Convex ℝ K)
    (l₀ u₀ l₁ u₁ s t : ℝ)
    (hl₀ : 0 ≤ l₀) (hlu₀ : l₀ ≤ u₀) (hu₀ : u₀ ≤ 1)
    (hl₁ : 0 ≤ l₁) (hlu₁ : l₁ ≤ u₁) (hu₁ : u₁ ≤ 1)
    (hs : s ∈ Icc (0 : ℝ) 1) (ht : t ∈ Icc (0 : ℝ) 1)
    (h00 : (0,l₀) ∈ K) (h01 : (0,u₀) ∈ K)
    (h10 : (1,l₁) ∈ K) (h11 : (1,u₁) ∈ K)
    (hbot : (s,0) ∈ K) (htop : (t,1) ∈ K) :
    (1+signedOverlap l₀ u₀ l₁ u₁)/2 ≤ volume.real K := by
  have hsubset : (⋃ i : Fin 4, piece l₀ u₀ l₁ u₁ s t i) ⊆ K := by
    apply iUnion_subset
    intro i
    fin_cases i
    · exact filledTriangle_subset_convex hc h00 h10 h11
    · exact filledTriangle_subset_convex hc h00 h11 h01
    · exact filledTriangle_subset_convex hc h01 h11 htop
    · exact filledTriangle_subset_convex hc h00 h10 hbot
  have harea : volume.real (⋃ i : Fin 4, piece l₀ u₀ l₁ u₁ s t i) =
      ∑ i : Fin 4, volume.real (piece l₀ u₀ l₁ u₁ s t i) := by
    simpa using measureReal_biUnion_finset₀ (μ := (volume : Measure Plane))
      (s := Finset.univ) (f := piece l₀ u₀ l₁ u₁ s t)
      (fun i _ j _ hij => pieces_aedisjoint l₀ u₀ l₁ u₁ s t
        hl₀ hlu₀ hu₀ hl₁ hlu₁ hu₁ hs ht i j hij)
      (fun i _ => (piece_compact l₀ u₀ l₁ u₁ s t i).measurableSet.nullMeasurableSet)
      (fun i _ => (piece_compact l₀ u₀ l₁ u₁ s t i).measure_ne_top)
  rw [piece_areas l₀ u₀ l₁ u₁ s t hl₀ hlu₀ hu₀ hl₁ hlu₁ hu₁ hs ht] at harea
  have hmono := measureReal_mono hsubset
    (hK.measure_ne_top (μ := (volume : Measure Plane)))
  rw [harea] at hmono
  have hscalar := trapezoid_triangle_expression_lower_bound
    l₀ u₀ l₁ u₁ s t hs.1 hs.2 ht.1 ht.2
  linarith

def verticalFiber (K : Set Plane) (x : ℝ) : Set ℝ := {z | (x,z) ∈ K}

theorem verticalFiber_compact {K : Set Plane} (hK : IsCompact K) (x : ℝ) :
    IsCompact (verticalFiber K x) := by
  have he : verticalFiber K x = Prod.snd '' (K ∩ {p : Plane | p.1=x}) := by
    ext z
    constructor
    · intro hz
      exact ⟨(x,z), ⟨hz,rfl⟩,rfl⟩
    · rintro ⟨⟨a,b⟩,⟨hp,ha⟩,hb⟩
      change a=x at ha
      change b=z at hb
      subst a
      subst b
      exact hp
  rw [he]
  exact (hK.inter_right (isClosed_eq continuous_fst continuous_const)).image continuous_snd

def InUnitSquare (K : Set Plane) : Prop :=
  ∀ p ∈ K, p.1 ∈ Icc (0 : ℝ) 1 ∧ p.2 ∈ Icc (0 : ℝ) 1

/-- Two actual planar sets whose four pairs of vertical edge fibers meet.
This is the geometric form used for a three-dimensional body's two shadows. -/
theorem sum_area_of_cross_fibers {A B : Set Plane}
    (hA : IsCompact A) (hcA : Convex ℝ A) (hB : IsCompact B) (hcB : Convex ℝ B)
    (hAs : InUnitSquare A) (hBs : InUnitSquare B)
    (hA0 : ∃ s, (s,0) ∈ A) (hA1 : ∃ t, (t,1) ∈ A)
    (hB0 : ∃ s, (s,0) ∈ B) (hB1 : ∃ t, (t,1) ∈ B)
    (h00 : ∃ z, (0,z) ∈ A ∧ (0,z) ∈ B)
    (h01 : ∃ z, (0,z) ∈ A ∧ (1,z) ∈ B)
    (h10 : ∃ z, (1,z) ∈ A ∧ (0,z) ∈ B)
    (h11 : ∃ z, (1,z) ∈ A ∧ (1,z) ∈ B) :
    1 ≤ volume.real A + volume.real B := by
  obtain ⟨z00,hz00A,hz00B⟩ := h00
  obtain ⟨z01,hz01A,hz01B⟩ := h01
  obtain ⟨z10,hz10A,hz10B⟩ := h10
  obtain ⟨z11,hz11A,hz11B⟩ := h11
  obtain ⟨a,ha⟩ := (verticalFiber_compact hA 0).exists_isLeast ⟨z00,hz00A⟩
  obtain ⟨b,hb⟩ := (verticalFiber_compact hA 0).exists_isGreatest ⟨z00,hz00A⟩
  obtain ⟨c,hc⟩ := (verticalFiber_compact hA 1).exists_isLeast ⟨z10,hz10A⟩
  obtain ⟨d,hd⟩ := (verticalFiber_compact hA 1).exists_isGreatest ⟨z10,hz10A⟩
  obtain ⟨e,he⟩ := (verticalFiber_compact hB 0).exists_isLeast ⟨z00,hz00B⟩
  obtain ⟨f,hf⟩ := (verticalFiber_compact hB 0).exists_isGreatest ⟨z00,hz00B⟩
  obtain ⟨g,hg⟩ := (verticalFiber_compact hB 1).exists_isLeast ⟨z01,hz01B⟩
  obtain ⟨h,hh⟩ := (verticalFiber_compact hB 1).exists_isGreatest ⟨z01,hz01B⟩
  obtain ⟨sA,hsA⟩ := hA0
  obtain ⟨tA,htA⟩ := hA1
  obtain ⟨sB,hsB⟩ := hB0
  obtain ⟨tB,htB⟩ := hB1
  have haA : (0,a) ∈ A := ha.1
  have hbA : (0,b) ∈ A := hb.1
  have hcA' : (1,c) ∈ A := hc.1
  have hdA : (1,d) ∈ A := hd.1
  have heB : (0,e) ∈ B := he.1
  have hfB : (0,f) ∈ B := hf.1
  have hgB : (1,g) ∈ B := hg.1
  have hhB : (1,h) ∈ B := hh.1
  apply two_projection_lower_bound a b c d e f g h (volume.real A) (volume.real B)
  · exact ⟨z00, ⟨ha.2 hz00A,hb.2 hz00A⟩,⟨he.2 hz00B,hf.2 hz00B⟩⟩
  · exact ⟨z01, ⟨ha.2 hz01A,hb.2 hz01A⟩,⟨hg.2 hz01B,hh.2 hz01B⟩⟩
  · exact ⟨z10, ⟨hc.2 hz10A,hd.2 hz10A⟩,⟨he.2 hz10B,hf.2 hz10B⟩⟩
  · exact ⟨z11, ⟨hc.2 hz11A,hd.2 hz11A⟩,⟨hg.2 hz11B,hh.2 hz11B⟩⟩
  · exact area_lower_bound_of_endpoint_points hA hcA a b c d sA tA
      (hAs _ haA).2.1 (ha.2 hb.1) (hAs _ hbA).2.2
      (hAs _ hcA').2.1 (hc.2 hd.1) (hAs _ hdA).2.2
      (hAs _ hsA).1 (hAs _ htA).1 haA hbA hcA' hdA hsA htA
  · exact area_lower_bound_of_endpoint_points hB hcB e f g h sB tB
      (hBs _ heB).2.1 (he.2 hf.1) (hBs _ hfB).2.2
      (hBs _ hgB).2.1 (hg.2 hh.1) (hBs _ hhB).2.2
      (hBs _ hsB).1 (hBs _ htB).1 heB hfB hgB hhB hsB htB

def pairProjection (i j : Fin 3) : (Fin 3 → ℝ) →ₗ[ℝ] Plane :=
  (LinearMap.proj i).prod (LinearMap.proj j)

/-- A three-dimensional compact convex set with a full unit-square shadow
and vertical range `[0,1]` has the sum of its other two projection areas at
least one. Lower-dimensional sets are allowed. -/
theorem box_projection_sum_area_ge_one {K : Set (Fin 3 → ℝ)}
    (hK : IsCompact K) (hc : Convex ℝ K)
    (hxy : pairProjection 0 1 '' K = Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1)
    (hz : (fun x : Fin 3 → ℝ => x 2) '' K = Icc (0 : ℝ) 1) :
    1 ≤ volume.real (pairProjection 0 2 '' K) +
      volume.real (pairProjection 1 2 '' K) := by
  have hcoords (x : Fin 3 → ℝ) (hx : x ∈ K) :
      x 0 ∈ Icc (0 : ℝ) 1 ∧ x 1 ∈ Icc (0 : ℝ) 1 ∧ x 2 ∈ Icc (0 : ℝ) 1 := by
    have hxy' : pairProjection 0 1 x ∈ Icc (0 : ℝ) 1 ×ˢ Icc (0 : ℝ) 1 :=
      hxy ▸ mem_image_of_mem _ hx
    have hz' : x 2 ∈ Icc (0 : ℝ) 1 := hz ▸ mem_image_of_mem _ hx
    exact ⟨hxy'.1,hxy'.2,hz'⟩
  have hz0 : ∃ x ∈ K, x 2 = 0 := by
    have h : (0 : ℝ) ∈ (fun x : Fin 3 → ℝ => x 2) '' K := by rw [hz]; norm_num
    exact h
  have hz1 : ∃ x ∈ K, x 2 = 1 := by
    have h : (1 : ℝ) ∈ (fun x : Fin 3 → ℝ => x 2) '' K := by rw [hz]; norm_num
    exact h
  have hcorner (u v : ℝ) (hu : u ∈ Icc (0 : ℝ) 1) (hv : v ∈ Icc (0 : ℝ) 1) :
      ∃ z, (u,z) ∈ pairProjection 0 2 '' K ∧ (v,z) ∈ pairProjection 1 2 '' K := by
    have hmem : (u,v) ∈ pairProjection 0 1 '' K := by rw [hxy]; exact ⟨hu,hv⟩
    obtain ⟨x,hx,hxp⟩ := hmem
    have hx0 : x 0=u := congrArg Prod.fst hxp
    have hx1 : x 1=v := congrArg Prod.snd hxp
    refine ⟨x 2, ⟨x,hx,?_⟩,⟨x,hx,?_⟩⟩ <;> ext <;> simp_all [pairProjection]
  apply sum_area_of_cross_fibers
    (hK.image (pairProjection 0 2).continuous_of_finiteDimensional)
    (hc.linear_image (pairProjection 0 2))
    (hK.image (pairProjection 1 2).continuous_of_finiteDimensional)
    (hc.linear_image (pairProjection 1 2))
  · rintro p ⟨x,hx,rfl⟩
    exact ⟨(hcoords x hx).1,(hcoords x hx).2.2⟩
  · rintro p ⟨x,hx,rfl⟩
    exact ⟨(hcoords x hx).2.1,(hcoords x hx).2.2⟩
  · obtain ⟨x,hx,hx0⟩ := hz0
    exact ⟨x 0, x,hx, by ext <;> simp [pairProjection,hx0]⟩
  · obtain ⟨x,hx,hx1⟩ := hz1
    exact ⟨x 0, x,hx, by ext <;> simp [pairProjection,hx1]⟩
  · obtain ⟨x,hx,hx0⟩ := hz0
    exact ⟨x 1, x,hx, by ext <;> simp [pairProjection,hx0]⟩
  · obtain ⟨x,hx,hx1⟩ := hz1
    exact ⟨x 1, x,hx, by ext <;> simp [pairProjection,hx1]⟩
  · exact hcorner 0 0 (by norm_num) (by norm_num)
  · exact hcorner 0 1 (by norm_num) (by norm_num)
  · exact hcorner 1 0 (by norm_num) (by norm_num)
  · exact hcorner 1 1 (by norm_num) (by norm_num)

end ProjectionAreaRectangleBound

end
end
