section Source_CoordinateRectangles

@[expose] public section

/-!
# Coordinate rectangles and affine normalization

All rectangularity statements are equalities of actual projection sets.
The normalization is an invertible translation and positive coordinate
dilation; its area factors are the ordinary planar determinant factors.
-/

noncomputable section
open Set MeasureTheory Matrix
open scoped Pointwise BigOperators

namespace ProjectionAreaRectangleObstruction

open ProjectionAreaMixedGeometry ProjectionAreaTransforms

def coordinateRange {n : ℕ} (K : Set (V n)) (i : Fin n) : Set ℝ :=
  (fun x : V n => x i) '' K

def IsRectangularPair {n : ℕ} (K : Set (V n)) (i j : Fin n) : Prop :=
  coordinatePair i j '' K = coordinateRange K i ×ˢ coordinateRange K j

def IndependentCoordinate {n : ℕ} (K : Set (V n)) (j : Fin n) : Prop :=
  ∀ x ∈ K, ∀ y ∈ K, Function.update x j (y j) ∈ K

theorem independent_coordinate_rectangle {n : ℕ} {K : Set (V n)} {i j : Fin n}
    (h : IndependentCoordinate K j) (hij : i ≠ j) : IsRectangularPair K i j := by
  apply Set.Subset.antisymm
  · rintro p ⟨x,hx,rfl⟩
    exact ⟨⟨x,hx,rfl⟩,⟨x,hx,rfl⟩⟩
  · rintro ⟨a,b⟩ ⟨⟨x,hx,hxi⟩,⟨y,hy,hyj⟩⟩
    refine ⟨Function.update x j (y j),h x hx y hy,?_⟩
    ext <;> simp [coordinatePair,Function.update_of_ne hij,hxi,hyj]

theorem rectangularPair_symm {n : ℕ} {K : Set (V n)} {i j : Fin n}
    (h : IsRectangularPair K i j) : IsRectangularPair K j i := by
  apply Set.Subset.antisymm
  · rintro p ⟨x,hx,rfl⟩
    exact ⟨⟨x,hx,rfl⟩,⟨x,hx,rfl⟩⟩
  · rintro ⟨a,b⟩ ⟨ha,hb⟩
    have hm : (b,a) ∈ coordinatePair i j '' K := h.symm ▸ ⟨hb,ha⟩
    obtain ⟨x,hx,he⟩ := hm
    refine ⟨x,hx,?_⟩
    apply Prod.ext
    · exact congrArg Prod.snd he
    · exact congrArg Prod.fst he

theorem middle_prism_independent (K : Body 3)
    (hleft : fiberHull K 0 1 (by decide) = K)
    (hright : fiberHull K 1 2 (by decide) = K)
    (hbase : (interior (deleteBody 1 K : Set (V 2))).Nonempty) :
    IndependentCoordinate (K : Set (V 3)) 1 := by
  intro x hx y hy
  have he : Function.update x (1 : Fin 3) (y 1) =
      middleFiberPoint (deleteCoord 1 x) (y 1) := by
    ext i
    fin_cases i <;> simp [middleFiberPoint,deleteCoord]
  rw [he]
  exact middle_prism_of_two_fiber_products K hleft hright hbase hx hy

/-- A rectangular factor in one of the two defining shadows turns their
fiber product into a prism. -/
theorem independent_of_fiberHull_rectangle (K : Body 3)
    (hprod : fiberHull K 1 2 (by decide) = K)
    (hrect : IsRectangularPair (K : Set (V 3)) 0 1) :
    IndependentCoordinate (K : Set (V 3)) 1 := by
  intro x hx y hy
  rw [← hprod]
  change deleteCoord 1 (Function.update x 1 (y 1)) ∈ deleteBody 1 K ∧
    deleteCoord 2 (Function.update x 1 (y 1)) ∈ deleteBody 2 K
  constructor
  · refine ⟨x,hx,?_⟩
    ext r
    fin_cases r <;> simp [deleteCoord]
  · have hp : (x 0,y 1) ∈ coordinatePair 0 1 '' (K : Set (V 3)) := by
      rw [hrect]
      exact ⟨⟨x,hx,rfl⟩,⟨y,hy,rfl⟩⟩
    obtain ⟨z,hz,he⟩ := hp
    have hz0 : z 0=x 0 := congrArg Prod.fst he
    have hz1 : z 1=y 1 := congrArg Prod.snd he
    refine ⟨z,hz,?_⟩
    ext r
    fin_cases r <;> simp [deleteCoord,Fin.succAbove,hz0,hz1]

def affineCoordinates {n : ℕ} (a r : Fin n → ℝ) : V n →ᵃ[ℝ] V n where
  toFun x i := r i*(x i-a i)
  linear := coordinateImage id r
  map_vadd' := by
    intro p v
    ext i
    simp only [vadd_eq_add,Pi.add_apply,coordinateImage,LinearMap.coe_mk,AddHom.coe_mk,id_eq]
    ring

theorem continuous_affineCoordinates {n : ℕ} (a r : Fin n → ℝ) :
    Continuous (affineCoordinates a r) := by
  apply continuous_pi
  intro i
  exact continuous_const.mul ((continuous_apply i).sub continuous_const)

theorem affineCoordinates_pair {n : ℕ} (a r : Fin n → ℝ) (K : Set (V n))
    (i j : Fin n) :
    coordinatePair i j '' (affineCoordinates a r '' K) =
      (fun p : ℝ × ℝ => (r i*(p.1-a i),r j*(p.2-a j))) ''
        (coordinatePair i j '' K) := by
  simp only [Set.image_image]
  rfl

theorem affineCoordinates_rectangular {n : ℕ} (a r : Fin n → ℝ) {K : Set (V n)}
    {i j : Fin n} (hrect : IsRectangularPair K i j) :
    IsRectangularPair (affineCoordinates a r '' K) i j := by
  apply Set.Subset.antisymm
  · rintro p ⟨x,hx,rfl⟩
    exact ⟨⟨x,hx,rfl⟩,⟨x,hx,rfl⟩⟩
  · rintro ⟨u,v⟩ ⟨⟨x,⟨x₀,hx₀,rfl⟩,hxu⟩,⟨y,⟨y₀,hy₀,rfl⟩,hyv⟩⟩
    have hp : (x₀ i,y₀ j) ∈ coordinatePair i j '' K := by
      rw [hrect]
      exact ⟨⟨x₀,hx₀,rfl⟩,⟨y₀,hy₀,rfl⟩⟩
    obtain ⟨z,hz,he⟩ := hp
    refine ⟨affineCoordinates a r z,⟨z,hz,rfl⟩,?_⟩
    apply Prod.ext
    · change r i*(z i-a i)=u
      rw [show z i=x₀ i from congrArg Prod.fst he]
      exact hxu
    · change r j*(z j-a j)=v
      rw [show z j=y₀ j from congrArg Prod.snd he]
      exact hyv

theorem pairArea_affineCoordinates {n : ℕ} (a r : Fin n → ℝ) (K : Set (V n))
    (i j : Fin n) :
    pairArea (affineCoordinates a r '' K) i j = |r i*r j| * pairArea K i j := by
  let f : (ℝ × ℝ) →ₗ[ℝ] (ℝ × ℝ) :=
    VolumePolynomials.PlanarExtrusion.frameMap (r i,0) (0,r j)
  have he : coordinatePair i j '' (affineCoordinates a r '' K) =
      (fun p : ℝ × ℝ => (-r i*a i,-r j*a j)+p) ''
        (f '' (coordinatePair i j '' K)) := by
    simp only [Set.image_image]
    congr 1
    funext x
    apply Prod.ext
    · change r i * (x i-a i) = -r i*a i + (x i*r i + x j*0)
      ring
    · change r j * (x j-a j) = -r j*a j + (x i*0 + x j*r j)
      ring
  unfold pairArea
  rw [he]
  have ht (S : Set (ℝ × ℝ)) :
      volume.real ((fun p : ℝ × ℝ => (-r i*a i,-r j*a j)+p) '' S) = volume.real S := by
    simp only [measureReal_def,Set.image_add_left,measure_preimage_add]
  rw [ht,VolumePolynomials.PlanarExtrusion.area_image_linear]
  simp [f,VolumePolynomials.PlanarExtrusion.frameMap_det,
    VolumePolynomials.PlanarExtrusion.determinant]

theorem exists_coordinate_ranges {n : ℕ} (K : Body n) :
    ∃ a b : Fin n → ℝ, ∀ i,
      coordinateRange (K : Set (V n)) i = Icc (a i) (b i) ∧ a i ≤ b i := by
  classical
  have hlow (i : Fin n) := K.isCompact.exists_isMinOn K.nonempty
    ((continuous_apply i).continuousOn : ContinuousOn (fun x : V n => x i) K)
  have hhigh (i : Fin n) := K.isCompact.exists_isMaxOn K.nonempty
    ((continuous_apply i).continuousOn : ContinuousOn (fun x : V n => x i) K)
  choose lo hlo hlo' using hlow
  choose hi hhi hhi' using hhigh
  refine ⟨fun i => lo i i,fun i => hi i i,?_⟩
  intro i
  have hab : lo i i ≤ hi i i := (hlo' i) (hhi i)
  refine ⟨?_,hab⟩
  apply Set.Subset.antisymm
  · rintro t ⟨x,hx,rfl⟩
    exact ⟨(hlo' i) hx,(hhi' i) hx⟩
  · have hc : Convex ℝ (coordinateRange (K : Set (V n)) i) :=
      K.convex.linear_image (LinearMap.proj i)
    exact hc.ordConnected.out ⟨lo i,hlo i,rfl⟩ ⟨hi i,hhi i,rfl⟩

theorem coordinate_width_pos {K : Body 4} (a b : Fin 4 → ℝ)
    (hrange : ∀ i, coordinateRange (K : Set (V 4)) i = Icc (a i) (b i))
    (hab : ∀ i, a i ≤ b i)
    (hpositive : ∀ i j : Fin 4, i ≠ j → 0 < pairArea (K : Set (V 4)) i j) :
    ∀ i, 0 < b i-a i := by
  intro i
  by_contra hn
  have heq : b i=a i := by linarith [hab i]
  obtain ⟨j,hij⟩ := exists_ne i
  have hconst (x : V 4) (hx : x ∈ K) : x i=a i := by
    have hmem : x i ∈ Icc (a i) (b i) := hrange i ▸ Set.mem_image_of_mem _ hx
    rw [heq,Set.Icc_self] at hmem
    exact hmem
  have hsub : coordinatePair i j '' (K : Set (V 4)) ⊆
      ({a i} : Set ℝ) ×ˢ (Set.univ : Set ℝ) := by
    rintro p ⟨x,hx,rfl⟩
    exact ⟨hconst x hx,Set.mem_univ _⟩
  have hz : (volume : Measure (ℝ × ℝ))
      (coordinatePair i j '' (K : Set (V 4))) = 0 :=
    measure_mono_null hsub (by simp [Measure.volume_eq_prod])
  have hp := hpositive i j hij.symm
  simp only [pairArea,measureReal_def,hz,ENNReal.toReal_zero] at hp
  exact lt_irrefl 0 hp

theorem affineCoordinates_unit_range {n : ℕ} (a b : Fin n → ℝ) (K : Set (V n))
    (hrange : ∀ i, coordinateRange K i = Icc (a i) (b i))
    (hwidth : ∀ i, 0 < b i-a i) (i : Fin n) :
    coordinateRange (affineCoordinates a (fun j => (b j-a j)⁻¹) '' K) i =
      Icc (0 : ℝ) 1 := by
  ext t
  constructor
  · rintro ⟨x,⟨y,hy,rfl⟩,rfl⟩
    have hyi : y i ∈ Icc (a i) (b i) := hrange i ▸ Set.mem_image_of_mem _ hy
    change (b i-a i)⁻¹*(y i-a i) ∈ Icc (0 : ℝ) 1
    rw [← div_eq_inv_mul]
    exact ⟨div_nonneg (sub_nonneg.mpr hyi.1) (hwidth i).le,
      (div_le_one (hwidth i)).mpr (by linarith [hyi.2])⟩
  · intro ht
    have hs : a i+(b i-a i)*t ∈ coordinateRange K i := by
      rw [hrange i]
      constructor
      · nlinarith [mul_nonneg (hwidth i).le ht.1]
      · nlinarith [mul_nonneg (hwidth i).le (sub_nonneg.mpr ht.2)]
    obtain ⟨x,hx,he⟩ := hs
    refine ⟨affineCoordinates a (fun j => (b j-a j)⁻¹) x,⟨x,hx,rfl⟩,?_⟩
    change (b i-a i)⁻¹*(x i-a i)=t
    change x i = a i+(b i-a i)*t at he
    rw [he]
    field_simp [(hwidth i).ne']
    ring

theorem hollowDet_coordinate_factors (q : Matrix (Fin 4) (Fin 4) ℝ) (r : Fin 4 → ℝ) :
    ProjectionAreaRankThree.hollowDet (r 0*r 1*q 0 1) (r 0*r 2*q 0 2)
      (r 0*r 3*q 0 3) (r 1*r 2*q 1 2) (r 1*r 3*q 1 3) (r 2*r 3*q 2 3) =
      (r 0*r 1*r 2*r 3)^2 * ProjectionAreaRankThree.hollowDet
        (q 0 1) (q 0 2) (q 0 3) (q 1 2) (q 1 3) (q 2 3) := by
  unfold ProjectionAreaRankThree.hollowDet
  ring

/-- The box-path obstruction with arbitrary positive coordinate widths. -/
theorem three_rectangular_shadows_hollowDet_ne_zero (K : Body 4)
    (hpositive : ∀ i j : Fin 4, i ≠ j → 0 < pairArea (K : Set (V 4)) i j)
    (h01 : IsRectangularPair (K : Set (V 4)) 0 1)
    (h12 : IsRectangularPair (K : Set (V 4)) 1 2)
    (h23 : IsRectangularPair (K : Set (V 4)) 2 3) :
    ProjectionAreaRankThree.hollowDet
      (pairArea (K : Set (V 4)) 0 1) (pairArea (K : Set (V 4)) 0 2)
      (pairArea (K : Set (V 4)) 0 3) (pairArea (K : Set (V 4)) 1 2)
      (pairArea (K : Set (V 4)) 1 3) (pairArea (K : Set (V 4)) 2 3) ≠ 0 := by
  obtain ⟨a,b,hab⟩ := exists_coordinate_ranges K
  have hw := coordinate_width_pos a b (fun i => (hab i).1) (fun i => (hab i).2) hpositive
  let r : Fin 4 → ℝ := fun i => (b i-a i)⁻¹
  have hr (i : Fin 4) : 0 < r i := inv_pos.mpr (hw i)
  let L : Set (V 4) := affineCoordinates a r '' (K : Set (V 4))
  have hLcompact : IsCompact L := K.isCompact.image (continuous_affineCoordinates a r)
  have hLconvex : Convex ℝ L := K.convex.affine_image (affineCoordinates a r)
  have hLrange (i : Fin 4) : coordinateRange L i = Icc (0 : ℝ) 1 :=
    affineCoordinates_unit_range a b (K : Set (V 4)) (fun j => (hab j).1) hw i
  have hLarea (i j : Fin 4) : pairArea L i j = r i*r j*pairArea (K : Set (V 4)) i j := by
    rw [pairArea_affineCoordinates,abs_of_pos (mul_pos (hr i) (hr j))]
  have hLpositive (i j : Fin 4) (hij : i ≠ j) : 0 < pairArea L i j := by
    rw [hLarea]
    exact mul_pos (mul_pos (hr i) (hr j)) (hpositive i j hij)
  have hsquare (i j : Fin 4) (h : IsRectangularPair (K : Set (V 4)) i j) :
      coordinatePair i j '' L = Square := by
    rw [affineCoordinates_rectangular a r h,hLrange,hLrange]
  have hnonzero := three_square_shadows_hollowDet_ne_zero hLcompact hLconvex
    hLpositive (hsquare 0 1 h01) (hsquare 1 2 h12) (hsquare 2 3 h23)
  intro hzero
  apply hnonzero
  simp only [hLarea]
  rw [hollowDet_coordinate_factors (fun i j => pairArea (K : Set (V 4)) i j) r,
    hzero, mul_zero]

theorem coordinatePair_deleteBody {n : ℕ} (K : Body (n+1)) (i : Fin (n+1))
    (j k : Fin n) :
    coordinatePair j k '' (deleteBody i K : Set (V n)) =
      coordinatePair (i.succAbove j) (i.succAbove k) '' (K : Set (V (n+1))) := by
  change coordinatePair j k '' (deleteCoord i '' (K : Set (V (n+1)))) = _
  rw [Set.image_image]
  rfl

theorem coordinateRange_deleteBody {n : ℕ} (K : Body (n+1)) (i : Fin (n+1))
    (j : Fin n) :
    coordinateRange (deleteBody i K : Set (V n)) j =
      coordinateRange (K : Set (V (n+1))) (i.succAbove j) := by
  change (fun x : V n => x j) '' (deleteCoord i '' (K : Set (V (n+1)))) = _
  rw [Set.image_image]
  rfl

theorem rectangularPair_delete_iff {n : ℕ} (K : Body (n+1)) (i : Fin (n+1))
    (j k : Fin n) :
    IsRectangularPair (deleteBody i K : Set (V n)) j k ↔
      IsRectangularPair (K : Set (V (n+1))) (i.succAbove j) (i.succAbove k) := by
  unfold IsRectangularPair
  rw [coordinatePair_deleteBody,coordinateRange_deleteBody,coordinateRange_deleteBody]

/-- The exact geometric contradiction used for incompatible boundary cuts.
The first quartet has partition `01 | 23`. Its deletion at `0` is the
fiber product over coordinate `1`; a prism along `1` in its deletion at
`3` would force the three rectangular shadows excluded above. -/
theorem boundary_prism_obstruction (K : Body 4)
    (hpositive : ∀ i j : Fin 4, i ≠ j → 0 < pairArea (K : Set (V 4)) i j)
    (hdet : ProjectionAreaRankThree.hollowDet
      (pairArea (K : Set (V 4)) 0 1) (pairArea (K : Set (V 4)) 0 2)
      (pairArea (K : Set (V 4)) 0 3) (pairArea (K : Set (V 4)) 1 2)
      (pairArea (K : Set (V 4)) 1 3) (pairArea (K : Set (V 4)) 2 3) = 0)
    (hprod : fiberHull (deleteBody 0 K) 1 2 (by decide) = deleteBody 0 K)
    (hprism : IndependentCoordinate (deleteBody 3 K : Set (V 3)) 1) : False := by
  have h01' := independent_coordinate_rectangle hprism (i := 0) (by decide)
  have h21' := independent_coordinate_rectangle hprism (i := 2) (by decide)
  have h01 : IsRectangularPair (K : Set (V 4)) 0 1 := by
    simpa [Fin.succAbove] using (rectangularPair_delete_iff K 3 0 1).mp h01'
  have h12 : IsRectangularPair (K : Set (V 4)) 1 2 := by
    simpa [Fin.succAbove] using (rectangularPair_delete_iff K 3 1 2).mp (rectangularPair_symm h21')
  have h12' : IsRectangularPair (deleteBody 0 K : Set (V 3)) 0 1 := by
    apply (rectangularPair_delete_iff K 0 0 1).mpr
    simpa using h12
  have hprism' := independent_of_fiberHull_rectangle (deleteBody 0 K) hprod h12'
  have h23' := rectangularPair_symm
    (independent_coordinate_rectangle hprism' (i := 2) (by decide))
  have h23 : IsRectangularPair (K : Set (V 4)) 2 3 := by
    simpa using (rectangularPair_delete_iff K 0 1 2).mp h23'
  exact three_rectangular_shadows_hollowDet_ne_zero K hpositive h01 h12 h23 hdet

end ProjectionAreaRectangleObstruction

end
end
end Source_CoordinateRectangles

