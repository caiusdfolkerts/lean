section Source_BoundaryKernelGeometry

@[expose] public section

/-!
# Actual coordinate areas and boundary kernels

The area matrix here is ordinary planar Lebesgue measure of every literal
coordinate projection. Two applications of coordinate extrusion identify
the complementary matrix with twelve times the actual mixed-volume
pairing of coordinate segments. The balanced kernel from the algebraic
classification therefore annihilates the pairing with every comparison
body, as required for the fiber-product argument.
-/

noncomputable section

open Set MeasureTheory Module Matrix
open scoped Pointwise BigOperators
open VolumePolynomials ProjectionAreaRankThree ProjectionAreaBoundaryKernel
open ProjectionAreaTransforms

namespace ProjectionAreaMixedGeometry

/-- Ordinary Lebesgue projection areas on the literal finite product space.
In particular the diagonal entries are measured, rather than set by fiat. -/
def coordinateAreaMatrix {n : ℕ} (K : Body n) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => volume.real (projectN i j '' (K : Set (V n)))

theorem coordinateAreaMatrix_apply {n : ℕ} (K : Body n) (i j : Fin n) :
    coordinateAreaMatrix K i j =
      volume.real ((fun x : V n => ![x i, x j]) '' (K : Set (V n))) := rfl

@[simp] theorem coordinateAreaMatrix_hollow {n : ℕ} (K : Body n) (i : Fin n) :
    coordinateAreaMatrix K i i = 0 := same_coordinate_area_zero _ i

theorem coordinateAreaMatrix_symmetric {n : ℕ} (K : Body n) (i j : Fin n) :
    coordinateAreaMatrix K i j = coordinateAreaMatrix K j i :=
  ProjectionAreaNormalizedFour.projection_area_reverse _ j i

theorem coordinateAreaMatrix_nonnegative {n : ℕ} (K : Body n) (i j : Fin n) :
    0 ≤ coordinateAreaMatrix K i j := ENNReal.toReal_nonneg

def selectCoordinates {m n : ℕ} (σ : Fin m → Fin n) : V n →L[ℝ] V m where
  toFun x i := x (σ i)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  cont := by fun_prop

def selectBody {m n : ℕ} (σ : Fin m → Fin n) (K : Body n) : Body m :=
  mapBody (selectCoordinates σ) K

theorem coordinateAreaMatrix_selectBody {m n : ℕ} (σ : Fin m → Fin n) (K : Body n) :
    coordinateAreaMatrix (selectBody σ K) = (coordinateAreaMatrix K).submatrix σ σ := by
  ext i j
  simp only [coordinateAreaMatrix, selectBody, coe_mapBody, Set.image_image, Matrix.submatrix]
  rfl

theorem coordinateAreaMatrix_deleteBody {n : ℕ} (i : Fin (n + 1)) (K : Body (n + 1)) :
    coordinateAreaMatrix (deleteBody i K) =
      (coordinateAreaMatrix K).submatrix i.succAbove i.succAbove := by
  ext j k
  simp only [coordinateAreaMatrix, deleteBody, coe_mapBody, Set.image_image, Matrix.submatrix]
  rfl

private theorem double_delete_area (K : Body 4) (i : Fin 4) (j : Fin 3) (r s : Fin 4)
    (h : ∀ x : V 4, deleteCoord j (deleteCoord i x) = projectN r s x) :
    volume.real (deleteBody j (deleteBody i K) : Set (V 2)) = coordinateAreaMatrix K r s := by
  simp only [deleteBody, coe_mapBody, Set.image_image, coordinateAreaMatrix]
  congr 1
  congr 1
  funext x
  exact h x

/-- Every entry of the complementary matrix, including its zero diagonal,
is twelve times the mixed pairing of the corresponding coordinate segments. -/
theorem mixedPairing_coordinateSegments_area (K : Body 4) (i j : Fin 4) :
    12 * mixedPairing K (coordinateSegment i) (coordinateSegment j) =
      complementary (coordinateAreaMatrix K) i j := by
  have h01 : 12 * mixedPairing K (coordinateSegment 0) (coordinateSegment 1) =
      coordinateAreaMatrix K 2 3 :=
    (mixedVolume_two_coordinateSegments K 0 0).trans
      (double_delete_area K 0 0 2 3 (by intro x; ext k; fin_cases k <;> rfl))
  have h02 : 12 * mixedPairing K (coordinateSegment 0) (coordinateSegment 2) =
      coordinateAreaMatrix K 1 3 :=
    (mixedVolume_two_coordinateSegments K 0 1).trans
      (double_delete_area K 0 1 1 3 (by intro x; ext k; fin_cases k <;> rfl))
  have h03 : 12 * mixedPairing K (coordinateSegment 0) (coordinateSegment 3) =
      coordinateAreaMatrix K 1 2 :=
    (mixedVolume_two_coordinateSegments K 0 2).trans
      (double_delete_area K 0 2 1 2 (by intro x; ext k; fin_cases k <;> rfl))
  have h12 : 12 * mixedPairing K (coordinateSegment 1) (coordinateSegment 2) =
      coordinateAreaMatrix K 0 3 :=
    (mixedVolume_two_coordinateSegments K 1 1).trans
      (double_delete_area K 1 1 0 3 (by intro x; ext k; fin_cases k <;> rfl))
  have h13 : 12 * mixedPairing K (coordinateSegment 1) (coordinateSegment 3) =
      coordinateAreaMatrix K 0 2 :=
    (mixedVolume_two_coordinateSegments K 1 2).trans
      (double_delete_area K 1 2 0 2 (by intro x; ext k; fin_cases k <;> rfl))
  have h23 : 12 * mixedPairing K (coordinateSegment 2) (coordinateSegment 3) =
      coordinateAreaMatrix K 0 1 :=
    (mixedVolume_two_coordinateSegments K 2 2).trans
      (double_delete_area K 2 2 0 1 (by intro x; ext k; fin_cases k <;> rfl))
  fin_cases i <;> fin_cases j
  · simp [mixedPairing_coordinateSegment_self, complementary, hollowMatrix4]
  · exact h01
  · exact h02
  · exact h03
  · rw [mixedPairing_symm]; exact h01
  · simp [mixedPairing_coordinateSegment_self, complementary, hollowMatrix4]
  · exact h12
  · exact h13
  · rw [mixedPairing_symm]; exact h02
  · rw [mixedPairing_symm]; exact h12
  · simp [mixedPairing_coordinateSegment_self, complementary, hollowMatrix4]
  · exact h23
  · rw [mixedPairing_symm]; exact h03
  · rw [mixedPairing_symm]; exact h13
  · rw [mixedPairing_symm]; exact h23
  · simp [mixedPairing_coordinateSegment_self, complementary, hollowMatrix4]

/-- The balanced algebraic kernel now annihilates actual mixed pairings
against every compact convex comparison body. -/
theorem kernel_pairing_of_complementary_kernel (K : Body 4) (P : PositiveHollowMatrix 4)
    (hP : P.entries = coordinateAreaMatrix K) (c : BalancedKernel (complementary P.entries)) :
    ∀ T : Body 4, ∑ i, c.coeff i * sectionPairing K i T = 0 := by
  classical
  have hentry (i j : Fin 4) :
      mixedPairing K (coordinateSegment i) (coordinateSegment j) =
        complementary P.entries i j / 12 := by
    have h := mixedPairing_coordinateSegments_area K i j
    rw [← hP] at h
    linarith
  have hkernel (i : Fin 4) :
      ∑ j, c.coeff j * mixedPairing K (coordinateSegment i) (coordinateSegment j) = 0 := by
    calc
      _ = ((complementary P.entries) *ᵥ c.coeff) i / 12 := by
        simp only [hentry, Matrix.mulVec, dotProduct, Finset.sum_div]
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = 0 := by rw [c.kernel]; simp
  obtain ⟨r, hr, s, hs, hrs⟩ := Finset.one_lt_card.mp (show 1 <
      (Finset.univ.filter fun i => 0 < c.coeff i).card by rw [c.positive_card]; decide)
  have hcr : 0 < c.coeff r := (Finset.mem_filter.mp hr).2
  have hcs : 0 < c.coeff s := (Finset.mem_filter.mp hs).2
  apply kernel_pairing_of_segment_kernel K c.coeff hkernel r s hcr hcs
  rw [hentry]
  exact div_pos (complementary_positive P r s hrs) (by norm_num)

/-- The complete algebra-to-geometry endpoint for every positive rank-three
quartet, without a separate spectral or normalization assumption. -/
theorem exists_boundary_kernel_pairing (K : Body 4) (P : PositiveHollowMatrix 4)
    (hP : P.entries = coordinateAreaMatrix K) (hrank : P.entries.rank ≤ 3) :
    ∃ c : BalancedKernel (complementary P.entries),
      ∀ T : Body 4, ∑ i, c.coeff i * sectionPairing K i T = 0 := by
  obtain ⟨c⟩ := exists_complementary_kernel P hrank
  exact ⟨c, kernel_pairing_of_complementary_kernel K P hP c⟩

end ProjectionAreaMixedGeometry

end
end
end Source_BoundaryKernelGeometry

