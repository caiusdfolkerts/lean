/-! ## CoordinateMixedExtrusion -/

section CoordinateMixedExtrusionSource
/-!
# Coordinate-segment extrusion for genuine mixed volume

The factor `n + 1` is obtained by comparing actual volume-polynomial
coefficients after the interval-fiber extrusion identity.  This fixes the
normalization used by the boundary compatibility argument.
-/

noncomputable section
open Set MeasureTheory Module Filter MvPolynomial
open scoped Pointwise Topology BigOperators

namespace ProjectionAreaMixedGeometry

open VolumePolynomials

abbrev V (n : ℕ) := Fin n → ℝ
abbrev Body (n : ℕ) := ConvexBody (V n)

section ProductExtrusion

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasureSpace E] [BorelSpace E]
  [Measure.IsAddHaarMeasure (volume : Measure E)]

instance product_volume_isAddHaarMeasure :
    Measure.IsAddHaarMeasure (volume : Measure (ℝ × E)) := by
  rw [Measure.volume_eq_prod]
  infer_instance

def verticalSegment : ConvexBody (ℝ × E) where
  carrier := VolumePolynomials.PlanarExtrusion.horizontal 1
  convex' := (convex_Icc (0 : ℝ) 1).prod (convex_singleton (0 : E))
  isCompact' := VolumePolynomials.PlanarExtrusion.horizontal_compact 1
  nonempty' := ⟨0, by norm_num [VolumePolynomials.PlanarExtrusion.horizontal]⟩

theorem smul_verticalSegment {s : ℝ} (hs : 0 ≤ s) :
    ((s • verticalSegment (E := E) : ConvexBody (ℝ × E)) : Set (ℝ × E)) =
      VolumePolynomials.PlanarExtrusion.horizontal s := by
  by_cases hs0 : s = 0
  · subst s
    ext p
    simp [verticalSegment, VolumePolynomials.PlanarExtrusion.horizontal,
      Set.mem_prod, Prod.ext_iff]
  have hsp : 0 < s := lt_of_le_of_ne hs (Ne.symm hs0)
  ext p
  constructor
  · rintro ⟨q, ⟨hq, hq0⟩, rfl⟩
    refine ⟨⟨mul_nonneg hs hq.1, ?_⟩, ?_⟩
    · simpa using mul_le_mul_of_nonneg_left hq.2 hs
    · change s • q.2 = (0 : E)
      rw [show q.2 = 0 from hq0, smul_zero]
  · rintro ⟨hp, hp0⟩
    refine ⟨(p.1 / s, (0 : E)),
      ⟨⟨div_nonneg hp.1 hs, (div_le_one hsp).mpr hp.2⟩, rfl⟩, ?_⟩
    exact Prod.ext (by
      change s * (p.1 / s) = p.1
      field_simp [hs0]) (by simpa using hp0.symm)

def productBase (K : ConvexBody (ℝ × E)) : ConvexBody E :=
  mapBody (ContinuousLinearMap.snd ℝ ℝ E) K

theorem productBase_sum {n : ℕ} (K : Fin n → ConvexBody (ℝ × E)) (t : Fin n → ℝ) :
    productBase (∑ i, t i • K i) = ∑ i, t i • productBase (K i) := by
  unfold productBase
  change (mapBodyHom (ContinuousLinearMap.snd ℝ ℝ E)) (∑ i, t i • K i) = _
  rw [map_sum]
  exact Finset.sum_congr rfl fun i _ => mapBody_smul _ _ _

theorem firstVariableCoefficient_verticalSegment {n : ℕ}
    (K : Fin n → ConvexBody (ℝ × E)) :
    firstVariableCoefficient
      (volumePolynomial volume (Fin.cons (verticalSegment (E := E)) K)) =
      volumePolynomial volume (fun i => productBase (K i)) := by
  symm
  apply volumePolynomial_eq_of_eval
  intro t ht
  let S : ConvexBody (ℝ × E) := ∑ i, t i • K i
  have he (s : ℝ) (hs : 0 ≤ s) :
      volume.real ((S : Set (ℝ × E)) + s • (verticalSegment (E := E) : Set (ℝ × E))) =
        volume.real (S : Set (ℝ × E)) + s * volume.real (productBase S : Set E) := by
    rw [← ConvexBody.coe_smul, smul_verticalSegment (E := E) hs]
    exact VolumePolynomials.PlanarExtrusion.realVolume_add_horizontal S.isCompact S.convex hs
  have hd : HasDerivWithinAt
      (fun s : ℝ => volume.real
        ((S : Set (ℝ × E)) + s • (verticalSegment (E := E) : Set (ℝ × E))))
      (volume.real (productBase S : Set E)) (Ioi 0) 0 := by
    have h := ((hasDerivAt_id (0 : ℝ)).mul_const
      (volume.real (productBase S : Set E))).const_add (volume.real (S : Set (ℝ × E)))
    simpa only [one_mul] using (h.hasDerivWithinAt (s := Ioi (0 : ℝ))).congr
      (fun s hs => he s hs.le) (he 0 le_rfl)
  have h := eval_firstVariableCoefficient_eq_of_volume_derivative volume
    (verticalSegment (E := E)) K t ht hd
  simpa only [S, productBase_sum] using h

/-- Mixed-volume extrusion, with the exact factorial normalization. -/
theorem mixedVolume_verticalSegment {n : ℕ}
    (K : Fin n → ConvexBody (ℝ × E)) :
    (n + 1 : ℝ) * mixedVolume volume (Fin.cons (verticalSegment (E := E)) K) =
      mixedVolume volume (fun i => productBase (K i)) := by
  have hc := congrArg (fun p : MvPolynomial (Fin n) ℝ => p.coeff (squarefreeExponent n))
    (firstVariableCoefficient_verticalSegment K)
  rw [firstVariableCoefficient_squarefree] at hc
  unfold mixedVolume
  rw [hc, Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  have hn : (n.factorial : ℝ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hn1 : (n + 1 : ℝ) ≠ 0 := by positivity
  field_simp [hn, hn1] <;> ring

end ProductExtrusion

def deleteCoord {n : ℕ} (i : Fin (n + 1)) : V (n + 1) →L[ℝ] V n where
  toFun x j := x (i.succAbove j)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  cont := by fun_prop

def deleteBody {n : ℕ} (i : Fin (n + 1)) (K : Body (n + 1)) : Body n :=
  mapBody (deleteCoord i) K

def coordinateFrameLinear {n : ℕ} (i : Fin (n + 1)) : V (n + 1) ≃ₗ[ℝ] ℝ × V n where
  toEquiv := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i).toEquiv
  map_add' := by intros; ext <;> rfl
  map_smul' := by intros; ext <;> rfl

def coordinateFrame {n : ℕ} (i : Fin (n + 1)) : V (n + 1) ≃L[ℝ] ℝ × V n :=
  (coordinateFrameLinear i).toContinuousLinearEquiv

@[simp] theorem coordinateFrame_apply {n : ℕ} (i : Fin (n + 1)) (x : V (n + 1)) :
    coordinateFrame i x = (x i, deleteCoord i x) := rfl

theorem coordinateFrame_measurePreserving {n : ℕ} (i : Fin (n + 1)) :
    MeasurePreserving (coordinateFrame i) volume volume :=
  volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) => ℝ) i

@[simp] theorem coordinateFrame_single {n : ℕ} (i : Fin (n + 1)) (s : ℝ) :
    coordinateFrame i (Pi.single i s) = (s, 0) := by
  rw [coordinateFrame_apply]
  apply Prod.ext
  · simp
  · ext r
    simp [deleteCoord, Fin.succAbove_ne]

def coordinateSegment {n : ℕ} (i : Fin (n + 1)) : Body (n + 1) :=
  mapBody (coordinateFrame i).symm.toContinuousLinearMap (verticalSegment (E := V n))

/-- The coordinate segment is literally the segment from zero to the
standard coordinate vector, not a primitive mixed-volume argument. -/
theorem coe_coordinateSegment {n : ℕ} (i : Fin (n + 1)) :
    (coordinateSegment i : Set (V (n + 1))) =
      (fun s : ℝ => Pi.single i s) '' Icc 0 1 := by
  change (coordinateFrame i).symm '' VolumePolynomials.PlanarExtrusion.horizontal 1 = _
  ext x
  constructor
  · rintro ⟨p, ⟨hp, hp0⟩, rfl⟩
    refine ⟨p.1, hp, ?_⟩
    apply (coordinateFrame i).injective
    rw [coordinateFrame_single, ContinuousLinearEquiv.apply_symm_apply]
    exact Prod.ext rfl (show (0 : V n) = p.2 from hp0.symm)
  · rintro ⟨s, hs, rfl⟩
    refine ⟨(s, 0), ⟨hs, rfl⟩, ?_⟩
    apply (coordinateFrame i).injective
    rw [ContinuousLinearEquiv.apply_symm_apply, coordinateFrame_single]

theorem delete_coordinateSegment {n : ℕ} (i : Fin (n + 2)) (j : Fin (n + 1)) :
    deleteBody i (coordinateSegment (i.succAbove j)) = coordinateSegment j := by
  apply ConvexBody.ext
  rw [deleteBody, coe_mapBody, coe_coordinateSegment, coe_coordinateSegment, Set.image_image]
  congr 1
  funext s
  ext r
  simp [deleteCoord, Pi.single_apply, Fin.succAbove_right_inj]

@[simp] theorem delete_coordinateSegment_self {n : ℕ} (i : Fin (n + 1)) :
    deleteBody i (coordinateSegment i) = 0 := by
  apply ConvexBody.ext
  rw [deleteBody, coe_mapBody, coe_coordinateSegment, Set.image_image]
  have hf : (fun s : ℝ => deleteCoord i (Pi.single i s)) =
      fun _ => (0 : V n) := by
    funext s
    ext r
    simp [deleteCoord, Fin.succAbove_ne]
  rw [hf]
  simp [Set.singleton_zero]

theorem frame_coordinateSegment {n : ℕ} (i : Fin (n + 1)) :
    mapBody (coordinateFrame i).toContinuousLinearMap (coordinateSegment i) =
      verticalSegment (E := V n) := by
  apply ConvexBody.ext
  simp only [coordinateSegment, coe_mapBody, Set.image_image]
  simp

theorem productBase_coordinateFrame {n : ℕ} (i : Fin (n + 1)) (K : Body (n + 1)) :
    productBase (mapBody (coordinateFrame i).toContinuousLinearMap K) = deleteBody i K := by
  rw [productBase, mapBody_comp]
  rfl

/-- Deleting coordinate `i` is the exact quotient appearing in extrusion by
the coordinate segment `[0,e_i]`. -/
theorem mixedVolume_coordinateSegment {n m : ℕ} (i : Fin (n + 1))
    (K : Fin m → Body (n + 1)) :
    (m + 1 : ℝ) * mixedVolume volume (Fin.cons (coordinateSegment i) K) =
      mixedVolume volume (fun r => deleteBody i (K r)) := by
  have ht := mixedVolume_map_measurePreserving volume volume (coordinateFrame i)
    (coordinateFrame_measurePreserving i) (Fin.cons (coordinateSegment i) K)
  have he : (fun r : Fin (m + 1) => mapBody (coordinateFrame i).toContinuousLinearMap
      ((Fin.cons (coordinateSegment i) K : Fin (m + 1) → Body (n + 1)) r)) =
      (Fin.cons (verticalSegment (E := V n))
        (fun r : Fin m => mapBody (coordinateFrame i).toContinuousLinearMap (K r)) :
        Fin (m + 1) → ConvexBody (ℝ × V n)) := by
    funext r
    refine Fin.cases ?_ (fun _ => rfl) r
    exact frame_coordinateSegment i
  rw [he] at ht
  rw [← ht, mixedVolume_verticalSegment]
  congr 1
  funext r
  exact productBase_coordinateFrame i (K r)

end ProjectionAreaMixedGeometry

end
end CoordinateMixedExtrusionSource


/-! ## BoundaryFiberProducts -/

section BoundaryFiberProductsSource
/-!
# Boundary equalities force exact fiber products

This gives an elementary replacement for the use of the full equality
theorem in the paper.  The input is the actual mixed-volume kernel pairing
of a boundary quartet.  Enlarging one deletion projection to the fiber
product of two of its planar projections makes the negative kernel terms
vanish. Monotonicity makes the other terms nonnegative. Two applications of
Alexandrov--Fenchel then force equality of volumes and of the actual bodies.

No surface-area measure or characterization of extreme normals is used.
-/

noncomputable section
open Set MeasureTheory Module Filter Metric Matrix
open scoped Pointwise Topology BigOperators

namespace ProjectionAreaMixedGeometry

open VolumePolynomials

theorem equal_body_of_containment_volume
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    (μ : Measure E) [Measure.IsAddHaarMeasure μ]
    (L D : ConvexBody E) (hLD : L ≤ D) (hint : (interior (L : Set E)).Nonempty)
    (hvol : μ.real (D : Set E) ≤ μ.real (L : Set E)) : D = L := by
  have hm : μ (D : Set E) ≤ μ (L : Set E) :=
    (ENNReal.toReal_le_toReal D.isCompact.measure_ne_top L.isCompact.measure_ne_top).mp hvol
  have hnull : μ ((D : Set E) \ (L : Set E)) = 0 := by
    rw [measure_sdiff hLD L.isCompact.measurableSet.nullMeasurableSet L.isCompact.measure_ne_top]
    exact tsub_eq_zero_of_le hm
  have hnullopen : μ (interior (D : Set E) \ (L : Set E)) = 0 :=
    measure_mono_null (Set.sdiff_subset_sdiff_left interior_subset) hnull
  have hempty : interior (D : Set E) \ (L : Set E) = ∅ :=
    (isOpen_interior.sdiff L.isClosed).eq_empty_of_measure_zero hnullopen
  have hinside : interior (D : Set E) ⊆ (L : Set E) := Set.sdiff_eq_empty.mp hempty
  have hDint : (interior (D : Set E)).Nonempty := hint.mono (interior_mono hLD)
  apply le_antisymm
  · calc
      (D : Set E) = closure (interior (D : Set E)) := by
        rw [D.convex.closure_interior_eq_closure_of_nonempty_interior hDint,
          D.isClosed.closure_eq]
      _ ⊆ closure (L : Set E) := closure_mono hinside
      _ = (L : Set E) := L.isClosed.closure_eq
  · exact hLD

def mixed3 (A B C : Body 3) : ℝ := mixedVolume volume ![A, B, C]

theorem mixed3_swap_first (A B C : Body 3) : mixed3 A B C = mixed3 B A C := by
  have h := mixedVolume_reindex volume ![A, B, C] (Equiv.swap (0 : Fin 3) 1)
  have he : (fun i => (![A, B, C] : Fin 3 → Body 3) (Equiv.swap 0 1 i)) = ![B, A, C] := by
    funext i
    fin_cases i <;> simp [Equiv.swap_apply_def]
  simpa only [he, mixed3] using h.symm

theorem mixed3_swap_last (A B C : Body 3) : mixed3 A B C = mixed3 A C B := by
  have h := mixedVolume_reindex volume ![A, B, C] (Equiv.swap (1 : Fin 3) 2)
  have he : (fun i => (![A, B, C] : Fin 3 → Body 3) (Equiv.swap 1 2 i)) = ![A, C, B] := by
    funext i
    fin_cases i <;> simp [Equiv.swap_apply_def]
  simpa only [he, mixed3] using h.symm

theorem mixed3_diagonal (A : Body 3) : mixed3 A A A = volume.real (A : Set (V 3)) := by
  have he : (![A, A, A] : Fin 3 → Body 3) = fun _ => A := by
    funext i
    fin_cases i <;> rfl
  simpa only [mixed3, he] using mixedVolume_diagonal volume (finrank_fin_fun ℝ) A

theorem mixed3_af (A B C : Body 3) :
    mixed3 A A C * mixed3 B B C ≤ mixed3 A B C ^ 2 := by
  simpa only [mixed3, Matrix.vecCons] using mixedVolume_alexandrovFenchel volume
    (show finrank ℝ (V 3) = 1 + 2 by simp [V]) ![C] A B

theorem mixed3_mono_first (A B C D : Body 3) (hAB : A ≤ B) :
    mixed3 A C D ≤ mixed3 B C D := by
  simpa only [mixed3, Matrix.vecCons] using mixedVolume_mono_first_all volume ![C, D]
    (show finrank ℝ (V 3) = 2 + 1 by simp [V]) A B hAB

/-- In dimension three the required equality implication follows from two
ordinary AF inequalities; no general equality classification is required. -/
theorem equal_body_of_mixed3_first
    (L D : Body 3) (hLD : L ≤ D) (hint : (interior (L : Set (V 3))).Nonempty)
    (hmixed : mixed3 D L L = volume.real (L : Set (V 3))) : D = L := by
  let a : ℝ := volume.real (L : Set (V 3))
  let b : ℝ := mixed3 L D D
  have ha : 0 < a := by
    apply ENNReal.toReal_pos
    · exact (Measure.measure_pos_of_nonempty_interior volume hint).ne'
    · exact L.isCompact.measure_ne_top
  have hb : 0 ≤ b := mixedVolume_nonnegative volume ![L, D, D]
  have hfirst := mixed3_af L D L
  have hsecond := mixed3_af L D D
  have hAD : mixed3 L D L = a := by rw [mixed3_swap_first]; exact hmixed
  have hDA : mixed3 D D L = b := by
    rw [mixed3_swap_last, mixed3_swap_first]
  have hAAD : mixed3 L L D = a := by rw [mixed3_swap_last]; exact hAD
  rw [mixed3_diagonal, hDA, hAD] at hfirst
  rw [hAAD, mixed3_diagonal] at hsecond
  have hba : b ≤ a := le_of_mul_le_mul_left (by nlinarith [hfirst] : a * b ≤ a * a) ha
  have hbb : b ^ 2 ≤ a ^ 2 := by nlinarith
  have hvol : volume.real (D : Set (V 3)) ≤ a :=
    le_of_mul_le_mul_left
      (by nlinarith [hsecond] : a * volume.real (D : Set (V 3)) ≤ a * a) ha
  exact equal_body_of_containment_volume volume L D hLD hint hvol

def agreesExcept {n : ℕ} (i : Fin n) (x y : V n) : Prop := ∀ k, k ≠ i → x k = y k

theorem deleteCoord_eq_iff {n : ℕ} {i : Fin (n + 1)} {x y : V (n + 1)} :
    deleteCoord i x = deleteCoord i y ↔ agreesExcept i x y := by
  constructor
  · intro h k hk
    obtain ⟨r, hr⟩ := Fin.exists_succAbove_eq hk
    have hrxy := congrFun h r
    change x (i.succAbove r) = y (i.succAbove r) at hrxy
    simpa only [hr] using hrxy
  · intro h
    ext r
    exact h _ (Fin.succAbove_ne _ _)

def insertCoord {n : ℕ} (i : Fin (n + 1)) : V n →L[ℝ] V (n + 1) :=
  (coordinateFrame i).symm.toContinuousLinearMap.comp (ContinuousLinearMap.inr ℝ ℝ (V n))

def insertBody {n : ℕ} (i : Fin (n + 1)) (K : Body n) : Body (n + 1) :=
  mapBody (insertCoord i) K

@[simp] theorem insertCoord_same {n : ℕ} (i : Fin (n + 1)) (x : V n) :
    insertCoord i x i = 0 := by
  have h := congrArg Prod.fst ((coordinateFrame i).apply_symm_apply (0, x))
  simpa only [coordinateFrame_apply, insertCoord, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.inr_apply, ContinuousLinearEquiv.coe_coe] using h

@[simp] theorem insertCoord_succAbove {n : ℕ} (i : Fin (n + 1)) (x : V n) (r : Fin n) :
    insertCoord i x (i.succAbove r) = x r := by
  have h := congrArg (fun p : ℝ × V n => p.2 r) ((coordinateFrame i).apply_symm_apply (0, x))
  rw [coordinateFrame_apply] at h
  change ((coordinateFrame i).symm (0, x)) (i.succAbove r) = x r at h
  simpa only [insertCoord, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.inr_apply, ContinuousLinearEquiv.coe_coe] using h

@[simp] theorem delete_insertBody {n : ℕ} (i : Fin (n + 1)) (K : Body n) :
    deleteBody i (insertBody i K) = K := by
  apply ConvexBody.ext
  simp only [deleteBody, insertBody, coe_mapBody, Set.image_image]
  have hf : (fun x : V n => deleteCoord i (insertCoord i x)) = id := by
    funext x
    ext r
    exact insertCoord_succAbove i x r
  rw [hf, Set.image_id]

theorem insert_agreesExcept {n : ℕ} (i : Fin (n + 1)) {j : Fin n} {x y : V n}
    (h : agreesExcept j x y) : agreesExcept (i.succAbove j) (insertCoord i x) (insertCoord i y) := by
  intro r hr
  by_cases hri : r = i
  · subst r
    simp
  · obtain ⟨s, hs⟩ := Fin.exists_succAbove_eq hri
    rw [← hs, insertCoord_succAbove, insertCoord_succAbove]
    exact h s (fun hsj => hr (hs.symm.trans (congrArg i.succAbove hsj)))

theorem delete_insert_eq_of_delete_eq {n : ℕ} (i : Fin (n + 2)) (j : Fin (n + 1))
    {A B : Body (n + 1)} (h : deleteBody j A = deleteBody j B) :
    deleteBody (i.succAbove j) (insertBody i A) =
      deleteBody (i.succAbove j) (insertBody i B) := by
  apply ConvexBody.ext
  change deleteCoord (i.succAbove j) '' (insertCoord i '' (A : Set (V (n + 1)))) =
    deleteCoord (i.succAbove j) '' (insertCoord i '' (B : Set (V (n + 1))))
  have hone {A B : Body (n + 1)} (hab : deleteBody j A = deleteBody j B) :
      deleteCoord (i.succAbove j) '' (insertCoord i '' (A : Set (V (n + 1)))) ⊆
        deleteCoord (i.succAbove j) '' (insertCoord i '' (B : Set (V (n + 1)))) := by
    rintro z ⟨x, ⟨a, ha, rfl⟩, rfl⟩
    have hpa : deleteCoord j a ∈ deleteBody j B := hab ▸ Set.mem_image_of_mem (deleteCoord j) ha
    obtain ⟨b, hb, hba⟩ := hpa
    refine ⟨insertCoord i b, ⟨b, hb, rfl⟩, ?_⟩
    exact (deleteCoord_eq_iff.mpr (insert_agreesExcept i (deleteCoord_eq_iff.mp hba)))
  exact Set.Subset.antisymm (hone h) (hone h.symm)

def fiberHullSet {n : ℕ} (L : Body (n + 1)) (j k : Fin (n + 1)) : Set (V (n + 1)) :=
  (deleteCoord j) ⁻¹' (deleteBody j L : Set (V n)) ∩
    (deleteCoord k) ⁻¹' (deleteBody k L : Set (V n))

theorem subset_fiberHullSet {n : ℕ} (L : Body (n + 1)) (j k : Fin (n + 1)) :
    (L : Set (V (n + 1))) ⊆ fiberHullSet L j k := by
  intro x hx
  exact ⟨Set.mem_image_of_mem (deleteCoord j) hx, Set.mem_image_of_mem (deleteCoord k) hx⟩

theorem fiberHullSet_isCompact {n : ℕ} (L : Body (n + 1)) {j k : Fin (n + 1)} (hjk : j ≠ k) :
    IsCompact (fiberHullSet L j k) := by
  have hclosed : IsClosed (fiberHullSet L j k) :=
    ((deleteBody j L).isClosed.preimage (deleteCoord j).continuous).inter
      ((deleteBody k L).isClosed.preimage (deleteCoord k).continuous)
  obtain ⟨R, hRpos, hR⟩ := L.isBounded.exists_pos_norm_le
  apply (isCompact_closedBall (0 : V (n + 1)) R).of_isClosed_subset hclosed
  intro x hx
  rw [mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg hRpos.le).2
  intro r
  have hcoord (s : Fin (n + 1)) (hs : r ≠ s) (hxs : deleteCoord s x ∈ deleteBody s L) :
      ‖x r‖ ≤ R := by
    obtain ⟨y, hy, hye⟩ := hxs
    have he : x r = y r := (deleteCoord_eq_iff.mp hye.symm) r hs
    rw [he]
    exact (norm_le_pi_norm y r).trans (hR y hy)
  by_cases hrj : r = j
  · exact hcoord k (by simpa only [hrj] using hjk) hx.2
  · exact hcoord j hrj hx.1

def fiberHull {n : ℕ} (L : Body (n + 1)) (j k : Fin (n + 1)) (hjk : j ≠ k) :
    Body (n + 1) where
  carrier := fiberHullSet L j k
  convex' := ((deleteBody j L).convex.linear_preimage (deleteCoord j).toLinearMap).inter
    ((deleteBody k L).convex.linear_preimage (deleteCoord k).toLinearMap)
  isCompact' := fiberHullSet_isCompact L hjk
  nonempty' := L.nonempty.mono (subset_fiberHullSet L j k)

theorem le_fiberHull {n : ℕ} (L : Body (n + 1)) (j k : Fin (n + 1)) (hjk : j ≠ k) :
    L ≤ fiberHull L j k hjk := subset_fiberHullSet L j k

theorem delete_fiberHull_left {n : ℕ} (L : Body (n + 1)) (j k : Fin (n + 1)) (hjk : j ≠ k) :
    deleteBody j (fiberHull L j k hjk) = deleteBody j L := by
  apply le_antisymm
  · rintro y ⟨x, hx, rfl⟩
    exact hx.1
  · exact Set.image_mono (le_fiberHull L j k hjk)

theorem delete_fiberHull_right {n : ℕ} (L : Body (n + 1)) (j k : Fin (n + 1)) (hjk : j ≠ k) :
    deleteBody k (fiberHull L j k hjk) = deleteBody k L := by
  apply le_antisymm
  · rintro y ⟨x, hx, rfl⟩
    exact hx.2
  · exact Set.image_mono (le_fiberHull L j k hjk)

def sectionPairing (K : Body 4) (i : Fin 4) (T : Body 4) : ℝ :=
  mixed3 (deleteBody i T) (deleteBody i K) (deleteBody i K)

theorem sectionPairing_mono (K : Body 4) (i : Fin 4) {A B : Body 4} (h : A ≤ B) :
    sectionPairing K i A ≤ sectionPairing K i B :=
  mixed3_mono_first _ _ _ _ (Set.image_mono h)

theorem sectionPairing_extrusion (K T : Body 4) (i : Fin 4) :
    sectionPairing K i T = 4 * mixedVolume volume ![coordinateSegment i, T, K, K] := by
  have h := mixedVolume_coordinateSegment i ![T, K, K]
  have he : (fun r => deleteBody i ((![T, K, K] : Fin 3 → Body 4) r)) =
      ![deleteBody i T, deleteBody i K, deleteBody i K] := by
    funext r
    fin_cases r <;> rfl
  rw [he] at h
  norm_num only at h
  simpa only [sectionPairing, mixed3, Matrix.vecCons] using h.symm

theorem sectionPairing_coordinateSegment (K : Body 4) (i : Fin 4) (j : Fin 3) :
    3 * sectionPairing K i (coordinateSegment (i.succAbove j)) =
      volume.real (deleteBody j (deleteBody i K) : Set (V 2)) := by
  unfold sectionPairing mixed3
  rw [delete_coordinateSegment]
  have h := mixedVolume_coordinateSegment j ![deleteBody i K, deleteBody i K]
  have he : (fun r => deleteBody j
      ((![deleteBody i K, deleteBody i K] : Fin 2 → Body 3) r)) =
      (fun _ : Fin 2 => deleteBody j (deleteBody i K)) := by
    funext r
    fin_cases r <;> rfl
  rw [he, mixedVolume_diagonal volume (finrank_fin_fun ℝ)] at h
  norm_num only at h
  simpa only [Matrix.vecCons] using h

/-- The complementary-entry factor used in the paper's quartet matrix. -/
theorem mixedVolume_two_coordinateSegments (K : Body 4) (i : Fin 4) (j : Fin 3) :
    12 * mixedVolume volume
        ![coordinateSegment i, coordinateSegment (i.succAbove j), K, K] =
      volume.real (deleteBody j (deleteBody i K) : Set (V 2)) := by
  have h := sectionPairing_coordinateSegment K i j
  rw [sectionPairing_extrusion] at h
  nlinarith only [h]

/-- Every boundary kernel with one positive omitted coefficient forces the
deletion projection to be the exact fiber product of its two opposite-block
planar projections. The kernel hypothesis is an equality of genuine mixed
volumes for every actual comparison body. -/
theorem deletion_fiberHull_of_kernel
    (K : Body 4) (c : Fin 4 → ℝ) (i : Fin 4) (j k : Fin 3) (hjk : j ≠ k)
    (hci : 0 < c i)
    (hpositive : ∀ r, r ≠ i.succAbove j → r ≠ i.succAbove k → 0 ≤ c r)
    (hkernel : ∀ T : Body 4, ∑ r, c r * sectionPairing K r T = 0)
    (hint : (interior (deleteBody i K : Set (V 3))).Nonempty) :
    fiberHull (deleteBody i K) j k hjk = deleteBody i K := by
  let L := deleteBody i K
  let D := fiberHull L j k hjk
  let A := insertBody i L
  let B := insertBody i D
  have hLD : L ≤ D := le_fiberHull L j k hjk
  have hAB : A ≤ B := Set.image_mono hLD
  let δ : Fin 4 → ℝ := fun r => sectionPairing K r B - sectionPairing K r A
  have hδ (r : Fin 4) : 0 ≤ δ r := sub_nonneg.mpr (sectionPairing_mono K r hAB)
  have hj : δ (i.succAbove j) = 0 := by
    unfold δ sectionPairing
    rw [delete_insert_eq_of_delete_eq i j (delete_fiberHull_left L j k hjk)]
    exact sub_self _
  have hk : δ (i.succAbove k) = 0 := by
    unfold δ sectionPairing
    rw [delete_insert_eq_of_delete_eq i k (delete_fiberHull_right L j k hjk)]
    exact sub_self _
  have hsum : ∑ r, c r * δ r = 0 := by
    simp only [δ, mul_sub, Finset.sum_sub_distrib, hkernel, sub_self]
  have hterms (r : Fin 4) : 0 ≤ c r * δ r := by
    by_cases hrj : r = i.succAbove j
    · simp [hrj, hj]
    by_cases hrk : r = i.succAbove k
    · simp [hrk, hk]
    exact mul_nonneg (hpositive r hrj hrk) (hδ r)
  have hterm : c i * δ i ≤ 0 := by
    have h := Finset.single_le_sum (fun r _ => hterms r) (Finset.mem_univ i)
    simpa only [hsum] using h
  have hδi : δ i = 0 := by
    have hprod : c i * δ i = 0 := le_antisymm hterm (hterms i)
    exact (mul_eq_zero.mp hprod).resolve_left hci.ne'
  have hpair : sectionPairing K i B = sectionPairing K i A := sub_eq_zero.mp hδi
  have hmix : mixed3 D L L = volume.real (L : Set (V 3)) := by
    simp only [sectionPairing, A, B, delete_insertBody] at hpair
    change mixed3 D L L = mixed3 L L L at hpair
    simpa only [mixed3_diagonal] using hpair
  exact equal_body_of_mixed3_first L D hLD hint hmix

end ProjectionAreaMixedGeometry

end
end BoundaryFiberProductsSource


/-! ## AFKernelPairing -/

section AFKernelPairingSource
/-!
# Equality in AF gives the actual coordinate kernel pairing

The argument is a finite positive perturbation of comparison bodies, with
its coefficient inequality proved by an explicit real choice of parameter.
All mixed volumes are the normalized coefficients of actual volume
polynomials from the verified geometric foundation.
-/

noncomputable section
open Set MeasureTheory Module Matrix
open scoped Pointwise BigOperators

namespace ProjectionAreaMixedGeometry

open VolumePolynomials

def mixedPairing (K A B : Body 4) : ℝ := mixedVolume volume ![A, B, K, K]

theorem mixedPairing_coordinateSegment_self (K : Body 4) (i : Fin 4) :
    mixedPairing K (coordinateSegment i) (coordinateSegment i) = 0 := by
  have h := mixedVolume_coordinateSegment i ![coordinateSegment i, K, K]
  have he : (fun r => deleteBody i ((![coordinateSegment i, K, K] : Fin 3 → Body 4) r)) =
      ![0, deleteBody i K, deleteBody i K] := by
    funext r
    fin_cases r <;> simp
  have hz : mixedVolume volume ![0, deleteBody i K, deleteBody i K] = 0 := by
    simpa only [Matrix.vecCons, Fin.update_cons_zero] using
      mixedVolume_zero_arg volume ![deleteBody i K, deleteBody i K, deleteBody i K] 0
  rw [he, hz] at h
  have hfour : 4 * mixedVolume volume
      ![coordinateSegment i, coordinateSegment i, K, K] = 0 := by
    norm_num only at h
    simpa only [Matrix.vecCons] using h
  unfold mixedPairing
  nlinarith only [hfour]

theorem mixedPairing_symm (K A B : Body 4) : mixedPairing K A B = mixedPairing K B A := by
  have h := mixedVolume_reindex volume ![A, B, K, K] (Equiv.swap (0 : Fin 4) 1)
  have he : (fun i => (![A, B, K, K] : Fin 4 → Body 4) (Equiv.swap 0 1 i)) =
      ![B, A, K, K] := by
    funext i
    fin_cases i <;> simp [Equiv.swap_apply_def]
  simpa only [he, mixedPairing] using h.symm

theorem mixedPairing_add_first (K A B T : Body 4) :
    mixedPairing K (A + B) T = mixedPairing K A T + mixedPairing K B T := by
  simpa only [mixedPairing, Matrix.vecCons, Fin.update_cons_zero] using
    mixedVolume_add volume ![A, T, K, K] 0 A B

theorem mixedPairing_smul_first (K A T : Body 4) {s : ℝ} (hs : 0 ≤ s) :
    mixedPairing K (s • A) T = s * mixedPairing K A T := by
  simpa only [mixedPairing, Matrix.vecCons, Fin.update_cons_zero] using
    mixedVolume_smul volume ![A, T, K, K] 0 A hs

theorem mixedPairing_add_second (K A B T : Body 4) :
    mixedPairing K T (A + B) = mixedPairing K T A + mixedPairing K T B := by
  rw [mixedPairing_symm, mixedPairing_add_first, mixedPairing_symm K A,
    mixedPairing_symm K B]

theorem mixedPairing_smul_second (K A T : Body 4) {s : ℝ} (hs : 0 ≤ s) :
    mixedPairing K T (s • A) = s * mixedPairing K T A := by
  rw [mixedPairing_symm, mixedPairing_smul_first _ _ _ hs, mixedPairing_symm K A]

theorem mixedPairing_af (K A B : Body 4) :
    mixedPairing K A A * mixedPairing K B B ≤ mixedPairing K A B ^ 2 := by
  simpa only [mixedPairing, Matrix.vecCons] using mixedVolume_alexandrovFenchel volume
    (show finrank ℝ (V 4) = 2 + 2 by simp [V]) ![K, K] A B

theorem mixedPairing_perturb_self (K A T : Body 4) {s : ℝ} (hs : 0 ≤ s) :
    mixedPairing K (A + s • T) (A + s • T) =
      mixedPairing K A A + 2 * s * mixedPairing K A T + s ^ 2 * mixedPairing K T T := by
  rw [mixedPairing_add_first, mixedPairing_add_second, mixedPairing_add_second,
    mixedPairing_smul_second _ _ _ hs, mixedPairing_smul_first _ _ _ hs,
    mixedPairing_smul_first _ _ _ hs, mixedPairing_smul_second _ _ _ hs,
    mixedPairing_symm K T A]
  ring

theorem pairing_le_of_positive_perturbations
    (a p q r : ℝ) (ha : 0 < a)
    (h : ∀ s : ℝ, 0 < s → a * (a + 2 * s * p + s ^ 2 * r) ≤ (a + s * q) ^ 2) :
    p ≤ q := by
  by_contra hpq
  have hqp : q < p := lt_of_not_ge hpq
  let D := a * (p - q)
  let M := q ^ 2 + |a * r| + 1
  let s := D / M
  have hD : 0 < D := mul_pos ha (sub_pos.mpr hqp)
  have hM : 0 < M := by dsimp [M]; positivity
  have hs : 0 < s := div_pos hD hM
  have hsM : s * M = D := div_mul_cancel₀ D hM.ne'
  have hcoeff : q ^ 2 - a * r ≤ M := by
    dsimp [M]
    linarith [neg_le_abs (a * r)]
  have hbound : s * (q ^ 2 - a * r) ≤ s * M := mul_le_mul_of_nonneg_left hcoeff hs.le
  have hquad := h s hs
  have hscaled : s * (2 * D) ≤ s * (s * (q ^ 2 - a * r)) := by
    dsimp [D]
    nlinarith only [hquad]
  have hlinear : 2 * D ≤ s * (q ^ 2 - a * r) := le_of_mul_le_mul_left hscaled hs
  linarith only [hlinear, hbound, hsM, hD]

/-- The pairing conclusion of Lemma 2.2, for every actual comparison body. -/
theorem mixedPairing_equal_of_AF_equality (K P Q : Body 4) {a : ℝ}
    (ha : 0 < a) (hPP : mixedPairing K P P = a)
    (hPQ : mixedPairing K P Q = a) (hQQ : mixedPairing K Q Q = a)
    (T : Body 4) : mixedPairing K P T = mixedPairing K Q T := by
  have hle (P Q : Body 4) (hPP : mixedPairing K P P = a)
      (hPQ : mixedPairing K P Q = a) (hQQ : mixedPairing K Q Q = a) :
      mixedPairing K P T ≤ mixedPairing K Q T := by
    apply pairing_le_of_positive_perturbations a _ _ (mixedPairing K T T) ha
    intro s hs
    have h := mixedPairing_af K (P + s • T) Q
    rw [mixedPairing_perturb_self _ _ _ hs.le, mixedPairing_add_first,
      mixedPairing_smul_first _ _ _ hs.le, mixedPairing_symm K T Q,
      hPP, hPQ, hQQ] at h
    nlinarith only [h]
  exact le_antisymm (hle P Q hPP hPQ hQQ)
    (hle Q P hQQ (by rw [mixedPairing_symm]; exact hPQ) hPP)

def mixedPairingAddHom (K T : Body 4) : Body 4 →+ ℝ where
  toFun A := mixedPairing K A T
  map_zero' := by
    have h := mixedPairing_smul_first K T T (s := 0) (by norm_num)
    simpa only [body_zero_smul, zero_mul] using h
  map_add' A B := mixedPairing_add_first K A B T

def coordinateBox (s : Fin 4 → ℝ) : Body 4 := ∑ i, s i • coordinateSegment i

theorem mixedPairing_coordinateBox (K T : Body 4) (s : Fin 4 → ℝ) (hs : ∀ i, 0 ≤ s i) :
    mixedPairing K (coordinateBox s) T = ∑ i, s i * mixedPairing K (coordinateSegment i) T := by
  change mixedPairingAddHom K T (∑ i, s i • coordinateSegment i) = _
  rw [map_sum]
  exact Finset.sum_congr rfl fun i _ => mixedPairing_smul_first K _ T (hs i)

theorem mixedPairing_coordinateBoxes (K : Body 4) (s t : Fin 4 → ℝ)
    (hs : ∀ i, 0 ≤ s i) (ht : ∀ i, 0 ≤ t i) :
    mixedPairing K (coordinateBox s) (coordinateBox t) =
      ∑ i, ∑ j, s i * t j * mixedPairing K (coordinateSegment i) (coordinateSegment j) := by
  rw [mixedPairing_coordinateBox K _ s hs]
  apply Finset.sum_congr rfl
  intro i _
  rw [mixedPairing_symm, mixedPairing_coordinateBox K _ t ht, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [mixedPairing_symm K (coordinateSegment j)]
  ring

def positiveCoefficients (c : Fin 4 → ℝ) (i : Fin 4) : ℝ := max (c i) 0
def negativeCoefficients (c : Fin 4 → ℝ) (i : Fin 4) : ℝ := max (-(c i)) 0

theorem coefficients_difference (c : Fin 4 → ℝ) (i : Fin 4) :
    positiveCoefficients c i - negativeCoefficients c i = c i := by
  rcases le_total 0 (c i) with h | h
  · simp [positiveCoefficients, negativeCoefficients, max_eq_left h,
      max_eq_right (neg_nonpos.mpr h)]
  · simp [positiveCoefficients, negativeCoefficients, max_eq_right h,
      max_eq_left (neg_nonneg.mpr h)]

theorem kernel_pairing_of_AF_coordinateBoxes (K : Body 4) (c : Fin 4 → ℝ) {a : ℝ}
    (ha : 0 < a)
    (hPP : mixedPairing K (coordinateBox (positiveCoefficients c))
      (coordinateBox (positiveCoefficients c)) = a)
    (hPQ : mixedPairing K (coordinateBox (positiveCoefficients c))
      (coordinateBox (negativeCoefficients c)) = a)
    (hQQ : mixedPairing K (coordinateBox (negativeCoefficients c))
      (coordinateBox (negativeCoefficients c)) = a) :
    ∀ T : Body 4, ∑ r, c r * sectionPairing K r T = 0 := by
  intro T
  have h := mixedPairing_equal_of_AF_equality K _ _ ha hPP hPQ hQQ T
  rw [mixedPairing_coordinateBox K T (positiveCoefficients c)
      (fun i => show 0 ≤ max (c i) 0 from le_max_right _ _),
    mixedPairing_coordinateBox K T (negativeCoefficients c)
      (fun i => show 0 ≤ max (-(c i)) 0 from le_max_right _ _)] at h
  have hzero : ∑ r, c r * mixedPairing K (coordinateSegment r) T = 0 := by
    calc
      _ = ∑ r, (positiveCoefficients c r - negativeCoefficients c r) *
          mixedPairing K (coordinateSegment r) T := by simp only [coefficients_difference]
      _ = 0 := by
        rw [show (∑ r, (positiveCoefficients c r - negativeCoefficients c r) *
          mixedPairing K (coordinateSegment r) T) =
          (∑ r, positiveCoefficients c r * mixedPairing K (coordinateSegment r) T) -
            ∑ r, negativeCoefficients c r * mixedPairing K (coordinateSegment r) T by
              simp only [sub_mul, Finset.sum_sub_distrib]]
        exact sub_eq_zero.mpr h
  calc
    ∑ r, c r * sectionPairing K r T =
        4 * ∑ r, c r * mixedPairing K (coordinateSegment r) T := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro r _
      rw [sectionPairing_extrusion]
      unfold mixedPairing
      ring
    _ = 0 := by rw [hzero, mul_zero]

theorem coordinateBox_positive_self (K : Body 4) (c : Fin 4 → ℝ)
    (r s : Fin 4) (hr : 0 < c r) (hs : 0 < c s)
    (hrs : 0 < mixedPairing K (coordinateSegment r) (coordinateSegment s)) :
    0 < mixedPairing K (coordinateBox (positiveCoefficients c))
      (coordinateBox (positiveCoefficients c)) := by
  let u := positiveCoefficients c
  have hu (i : Fin 4) : 0 ≤ u i := le_max_right _ _
  rw [mixedPairing_coordinateBoxes K u u hu hu]
  have hnonneg (i j : Fin 4) :
      0 ≤ u i * u j * mixedPairing K (coordinateSegment i) (coordinateSegment j) :=
    mul_nonneg (mul_nonneg (hu i) (hu j)) (mixedVolume_nonnegative volume _)
  have hterm : 0 < u r * u s * mixedPairing K (coordinateSegment r) (coordinateSegment s) := by
    have hur : u r = c r := max_eq_left hr.le
    have hus : u s = c s := max_eq_left hs.le
    rw [hur, hus]
    exact mul_pos (mul_pos hr hs) hrs
  exact hterm.trans_le
    ((Finset.single_le_sum (fun j _ => hnonneg r j) (Finset.mem_univ s)).trans
      (Finset.single_le_sum (fun i _ => Finset.sum_nonneg fun j _ => hnonneg i j)
        (Finset.mem_univ r)))

/-- A kernel vector for the actual coordinate mixed-pairing matrix extends
to every convex comparison body. Positivity is proved by any two positive
entries of the coefficient vector with positive mutual pairing. -/
theorem kernel_pairing_of_segment_kernel
    (K : Body 4) (c : Fin 4 → ℝ)
    (hkernel : ∀ i, ∑ j, c j * mixedPairing K (coordinateSegment i) (coordinateSegment j) = 0)
    (r s : Fin 4) (hr : 0 < c r) (hs : 0 < c s)
    (hrs : 0 < mixedPairing K (coordinateSegment r) (coordinateSegment s)) :
    ∀ T : Body 4, ∑ i, c i * sectionPairing K i T = 0 := by
  let u := positiveCoefficients c
  let v := negativeCoefficients c
  let P := coordinateBox u
  let Q := coordinateBox v
  have hu (i : Fin 4) : 0 ≤ u i := le_max_right _ _
  have hv (i : Fin 4) : 0 ≤ v i := le_max_right _ _
  have hrow (i : Fin 4) : mixedPairing K (coordinateSegment i) P =
      mixedPairing K (coordinateSegment i) Q := by
    rw [mixedPairing_symm K (coordinateSegment i) P,
      mixedPairing_symm K (coordinateSegment i) Q,
      mixedPairing_coordinateBox K _ u hu, mixedPairing_coordinateBox K _ v hv]
    apply sub_eq_zero.mp
    rw [← Finset.sum_sub_distrib]
    calc
      _ = ∑ j, c j * mixedPairing K (coordinateSegment i) (coordinateSegment j) := by
        apply Finset.sum_congr rfl
        intro j _
        rw [← sub_mul, coefficients_difference, mixedPairing_symm K (coordinateSegment j)]
      _ = 0 := hkernel i
  have hPPPQ : mixedPairing K P P = mixedPairing K P Q := by
    rw [mixedPairing_coordinateBox K P u hu, mixedPairing_coordinateBox K Q u hu]
    exact Finset.sum_congr rfl fun i _ => congrArg (fun a : ℝ => u i * a) (hrow i)
  have hQQQP : mixedPairing K Q Q = mixedPairing K Q P := by
    rw [mixedPairing_coordinateBox K Q v hv, mixedPairing_coordinateBox K P v hv]
    exact Finset.sum_congr rfl fun i _ => congrArg (fun a : ℝ => v i * a) (hrow i).symm
  exact kernel_pairing_of_AF_coordinateBoxes K c
    (coordinateBox_positive_self K c r s hr hs hrs) rfl hPPPQ.symm
    (hQQQP.trans ((mixedPairing_symm K Q P).trans hPPPQ.symm))

end ProjectionAreaMixedGeometry

end
end AFKernelPairingSource


/-! ## CommonPrism -/

section CommonPrismSource
/-!
# Two incompatible fiber products force a common prism

The middle-coordinate fiber depends only on the first base coordinate and
only on the second.  On the interior of the planar base, the two fiber
product identities propagate a fiber through a small rectangle.  Convexity
and connectedness make it constant on the whole interior; closedness and
convex approximation then include all boundary fibers.
-/

noncomputable section
open Set MeasureTheory Module Metric Filter
open scoped Pointwise Topology

namespace ProjectionAreaMixedGeometry

open VolumePolynomials

theorem interior_nonempty_of_positive_volume {n : ℕ} (K : Body n)
    (hvol : 0 < volume.real (K : Set (V n))) : (interior (K : Set (V n))).Nonempty := by
  by_contra hn
  have hi : interior (K : Set (V n)) = ∅ := Set.not_nonempty_iff_eq_empty.mp hn
  have hz := K.convex.addHaar_frontier volume
  rw [frontier, K.isClosed.closure_eq, hi, Set.sdiff_empty] at hz
  rw [measureReal_def, hz, ENNReal.toReal_zero] at hvol
  exact lt_irrefl 0 hvol

def middleFiberPoint (p : V 2) (z : ℝ) : V 3 := ![p 0, z, p 1]

@[simp] theorem delete_middleFiberPoint (p : V 2) (z : ℝ) :
    deleteCoord (1 : Fin 3) (middleFiberPoint p z) = p := by
  ext i
  fin_cases i <;> simp [deleteCoord, middleFiberPoint]

@[simp] theorem middleFiberPoint_delete (x : V 3) :
    middleFiberPoint (deleteCoord (1 : Fin 3) x) (x 1) = x := by
  ext i
  fin_cases i <;> simp [deleteCoord, middleFiberPoint]

def middleFiberBase (K : Body 3) (z : ℝ) : Set (V 2) :=
  {p | middleFiberPoint p z ∈ K}

theorem isClosed_middleFiberBase (K : Body 3) (z : ℝ) : IsClosed (middleFiberBase K z) := by
  apply K.isClosed.preimage
  apply continuous_pi
  intro i
  fin_cases i
  · change Continuous (fun p : V 2 => p 0)
    exact continuous_apply 0
  · change Continuous (fun _ : V 2 => z)
    exact continuous_const
  · change Continuous (fun p : V 2 => p 1)
    exact continuous_apply 1

theorem propagate_second_base
    (K : Body 3) (hleft : fiberHull K 0 1 (by decide) = K)
    {p q : V 2} {z : ℝ} (hp : p ∈ deleteBody 1 K)
    (hq : middleFiberPoint q z ∈ K) (heq : p 1 = q 1) :
    middleFiberPoint p z ∈ K := by
  rw [← hleft]
  refine ⟨?_, ?_⟩
  · refine ⟨middleFiberPoint q z, hq, ?_⟩
    ext i
    fin_cases i <;> simp [deleteCoord, middleFiberPoint, heq]
  · change deleteCoord (1 : Fin 3) (middleFiberPoint p z) ∈ deleteBody 1 K
    simpa only [delete_middleFiberPoint] using hp

theorem propagate_first_base
    (K : Body 3) (hright : fiberHull K 1 2 (by decide) = K)
    {p q : V 2} {z : ℝ} (hp : p ∈ deleteBody 1 K)
    (hq : middleFiberPoint q z ∈ K) (heq : p 0 = q 0) :
    middleFiberPoint p z ∈ K := by
  rw [← hright]
  refine ⟨?_, ?_⟩
  · change deleteCoord (1 : Fin 3) (middleFiberPoint p z) ∈ deleteBody 1 K
    simpa only [delete_middleFiberPoint] using hp
  · refine ⟨middleFiberPoint q z, hq, ?_⟩
    ext i
    change middleFiberPoint q z ((2 : Fin 3).succAbove i) =
      middleFiberPoint p z ((2 : Fin 3).succAbove i)
    have hlast : (2 : Fin 3) = Fin.last 2 := rfl
    rw [hlast, Fin.succAbove_last_apply]
    fin_cases i <;> simp [middleFiberPoint, heq]

/-- A two-step move in a sufficiently small base rectangle preserves any
fixed middle-coordinate fiber. -/
theorem isOpen_fiber_inter_base_interior
    (K : Body 3) (hleft : fiberHull K 0 1 (by decide) = K)
    (hright : fiberHull K 1 2 (by decide) = K) (z : ℝ) :
    IsOpen (middleFiberBase K z ∩ interior (deleteBody 1 K : Set (V 2))) := by
  apply Metric.isOpen_iff.mpr
  intro p hp
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp isOpen_interior p hp.2
  refine ⟨ε, hε, ?_⟩
  intro q hq
  have hqint := hball hq
  let r : V 2 := ![q 0, p 1]
  have hqnorm : ‖q - p‖ < ε := by simpa only [Metric.mem_ball, dist_eq_norm] using hq
  have hrball : r ∈ ball p ε := by
    rw [Metric.mem_ball, dist_eq_norm]
    apply (pi_norm_lt_iff hε).mpr
    intro i
    fin_cases i
    · exact (pi_norm_lt_iff hε).mp hqnorm 0
    · simpa [r] using hε
  have hrint := hball hrball
  have hr : middleFiberPoint r z ∈ K :=
    propagate_second_base K hleft (interior_subset hrint) hp.1 rfl
  have hqmem : middleFiberPoint q z ∈ K :=
    propagate_first_base K hright (interior_subset hqint) hr rfl
  exact ⟨hqmem, hqint⟩

theorem entire_base_of_interior_fiber
    (K : Body 3) (hleft : fiberHull K 0 1 (by decide) = K)
    (hright : fiberHull K 1 2 (by decide) = K)
    {z : ℝ} {p : V 2} (hp : p ∈ interior (deleteBody 1 K : Set (V 2)))
    (hpmem : middleFiberPoint p z ∈ K) :
    (deleteBody 1 K : Set (V 2)) ⊆ middleFiberBase K z := by
  let B := deleteBody (1 : Fin 3) K
  let U := middleFiberBase K z ∩ interior (B : Set (V 2))
  have hu : IsOpen U := isOpen_fiber_inter_base_interior K hleft hright z
  have hconn : IsPreconnected (interior (B : Set (V 2))) := B.convex.interior.isPreconnected
  have hsubset : interior (B : Set (V 2)) ⊆ U := by
    apply hconn.subset_of_closure_inter_subset hu ⟨p, hp, hpmem, hp⟩
    intro q hq
    have hqfiber : q ∈ middleFiberBase K z :=
      closure_minimal Set.inter_subset_left (isClosed_middleFiberBase K z) hq.1
    exact ⟨hqfiber, hq.2⟩
  have hinside : interior (B : Set (V 2)) ⊆ middleFiberBase K z :=
    hsubset.trans Set.inter_subset_left
  calc
    (B : Set (V 2)) = closure (interior (B : Set (V 2))) := by
      rw [B.convex.closure_interior_eq_closure_of_nonempty_interior ⟨p, hp⟩,
        B.isClosed.closure_eq]
    _ ⊆ middleFiberBase K z := closure_minimal hinside (isClosed_middleFiberBase K z)

/-- Exact prism structure. Only the planar base needs interior; the theorem
therefore also covers a prism of zero height. -/
theorem middle_prism_of_two_fiber_products
    (K : Body 3) (hleft : fiberHull K 0 1 (by decide) = K)
    (hright : fiberHull K 1 2 (by decide) = K)
    (hbase : (interior (deleteBody 1 K : Set (V 2))).Nonempty)
    {x y : V 3} (hx : x ∈ K) (hy : y ∈ K) :
    middleFiberPoint (deleteCoord 1 x) (y 1) ∈ K := by
  obtain ⟨p₀, hp₀⟩ := hbase
  obtain ⟨u, hu, hup⟩ := interior_subset hp₀
  let p := deleteCoord (1 : Fin 3) x
  have hp : p ∈ deleteBody 1 K := Set.mem_image_of_mem (deleteCoord 1) hx
  have hbaseu : deleteCoord (1 : Fin 3) u ∈ interior (deleteBody 1 K : Set (V 2)) :=
    hup.symm ▸ hp₀
  have hsmall : ∀ᶠ ε : ℝ in 𝓝[>] 0, ε < 1 := by
    have hsmall₀ : ∀ᶠ ε : ℝ in 𝓝 0, ε < 1 :=
      isOpen_Iio.mem_nhds (show (0 : ℝ) ∈ Iio 1 by norm_num)
    exact Filter.Eventually.filter_mono nhdsWithin_le_nhds hsmall₀
  have heventual : ∀ᶠ ε : ℝ in 𝓝[>] 0,
      middleFiberPoint p ((1 - ε) * y 1 + ε * u 1) ∈ K := by
    filter_upwards [self_mem_nhdsWithin, hsmall] with ε hε hε1
    let q : V 3 := (1 - ε) • y + ε • u
    have hq : q ∈ K := K.convex hy hu (sub_nonneg.mpr hε1.le) hε.le (by ring)
    have hqbase : deleteCoord (1 : Fin 3) q ∈ interior (deleteBody 1 K : Set (V 2)) := by
      change deleteCoord 1 ((1 - ε) • y + ε • u) ∈ _
      rw [map_add, map_smul, map_smul]
      exact (deleteBody 1 K).convex.combo_self_interior_mem_interior
        (Set.mem_image_of_mem (deleteCoord 1) hy) hbaseu
        (sub_nonneg.mpr hε1.le) hε (by ring)
    have hqfiber : middleFiberPoint (deleteCoord 1 q) (q 1) ∈ K := by
      simpa only [middleFiberPoint_delete] using hq
    exact entire_base_of_interior_fiber K hleft hright hqbase hqfiber hp
  have hconv : Tendsto (fun ε : ℝ => middleFiberPoint p ((1 - ε) * y 1 + ε * u 1))
      (𝓝[>] 0) (𝓝 (middleFiberPoint p (y 1))) := by
    have hc : Continuous (fun ε : ℝ => middleFiberPoint p ((1 - ε) * y 1 + ε * u 1)) := by
      apply continuous_pi
      intro i
      fin_cases i
      · change Continuous (fun _ : ℝ => p 0)
        exact continuous_const
      · change Continuous (fun ε : ℝ => (1 - ε) * y 1 + ε * u 1)
        fun_prop
      · change Continuous (fun _ : ℝ => p 1)
        exact continuous_const
    simpa only [sub_zero, one_mul, zero_mul, add_zero] using
      (hc.tendsto 0).mono_left nhdsWithin_le_nhds
  exact K.isClosed.mem_of_tendsto hconv heventual

def middlePrismSet (K : Body 3) : Set (V 3) :=
  {x | deleteCoord 1 x ∈ deleteBody 1 K ∧ x 1 ∈ (fun y : V 3 => y 1) '' (K : Set (V 3))}

theorem eq_middlePrismSet_of_two_fiber_products
    (K : Body 3) (hleft : fiberHull K 0 1 (by decide) = K)
    (hright : fiberHull K 1 2 (by decide) = K)
    (hbase : (interior (deleteBody 1 K : Set (V 2))).Nonempty) :
    (K : Set (V 3)) = middlePrismSet K := by
  apply Set.Subset.antisymm
  · intro x hx
    exact ⟨Set.mem_image_of_mem (deleteCoord 1) hx, ⟨x, hx, rfl⟩⟩
  · rintro x ⟨⟨a, ha, hax⟩, b, hb, hbx⟩
    have h := middle_prism_of_two_fiber_products K hleft hright hbase ha hb
    change b 1 = x 1 at hbx
    rw [hax, hbx, middleFiberPoint_delete] at h
    exact h

end ProjectionAreaMixedGeometry

