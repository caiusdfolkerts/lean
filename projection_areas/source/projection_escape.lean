/-! ## EscapeNormalization -/

section EscapeNormalizationSource
/-!
# Fixed-coordinate normalization of long convex bodies

The sup norm is used only to select a longest coordinate chord.  Coordinate
areas are ordinary Lebesgue areas, and the final escape theorem transfers
back to the Euclidean diameter.  Every body is translated to the midpoint
of the selected chord.  An area bound then controls all transverse
coordinates after reciprocal longitudinal/transverse rescaling.
-/

noncomputable section
open Set Metric MeasureTheory Filter TopologicalSpace
open scoped Pointwise Topology

namespace ProjectionAreaEscapeNormalization

open ProjectionAreaTopology
open ProjectionAreaBoundaryAreas
open ProjectionAreaCoordinateLifts

abbrev Space (d : ℕ) := Fin d → ℝ
abbrev Plane := Fin 2 → ℝ
abbrev CylinderSpace (d : ℕ) := ℝ × Space d

def coordinateMap {d : ℕ} (i j : Fin d) : Space d →L[ℝ] Plane :=
  (ProjectionAreaTransforms.projectN i j).toContinuousLinearMap

def areas {d : ℕ} (K : ConvexBody (Space d)) : Matrix (Fin d) (Fin d) ℝ :=
  fun i j => volume.real (coordinateMap i j '' (K : Set (Space d)))

theorem continuous_linearImageBody_joint
    {E F X : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace X]
    (f : X → E →L[ℝ] F) (K : X → ConvexBody E)
    (hf : Continuous f) (hK : Continuous K) :
    Continuous (fun x => linearImageBody (f x) (K x)) := by
  apply VolumePolynomials.isometry_bodyToNonemptyCompacts.comp_continuous_iff.mp
  change Continuous (fun x =>
    (VolumePolynomials.bodyToNonemptyCompacts (K x)).map (f x) (f x).continuous)
  exact (VolumePolynomials.continuous_bodyToNonemptyCompacts.comp hK).nonemptyCompacts_map'
    (by fun_prop)

theorem continuous_linearImageBody_parametric
    {E F X : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace X]
    (f : X → E →L[ℝ] F) (K : X → ConvexBody E)
    (hf : Continuous (fun p : X × E => f p.1 p.2)) (hK : Continuous K) :
    Continuous (fun x => linearImageBody (f x) (K x)) := by
  apply VolumePolynomials.isometry_bodyToNonemptyCompacts.comp_continuous_iff.mp
  change Continuous (fun x =>
    (VolumePolynomials.bodyToNonemptyCompacts (K x)).map (f x) (f x).continuous)
  exact (VolumePolynomials.continuous_bodyToNonemptyCompacts.comp hK).nonemptyCompacts_map'
    (g := fun x y => f x y) hf

theorem continuous_areas (d : ℕ) : Continuous (areas (d := d)) := by
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  exact (VolumePolynomials.continuous_convexBody_realMeasure
    (volume : Measure Plane)).comp (continuous_linearImageBody (coordinateMap i j))

theorem areas_translate {d : ℕ} (v : Space d) (K : ConvexBody (Space d)) :
    areas (translateBody v K) = areas K := by
  ext i j
  unfold areas
  rw [coe_translateBody, Set.image_image]
  have heq : (fun x : Space d => coordinateMap i j (v + x)) '' (K : Set (Space d)) =
      (fun z => coordinateMap i j v + z) ''
        (coordinateMap i j '' (K : Set (Space d))) := by
    rw [Set.image_image]
    congr 1
    funext x
    exact map_add (coordinateMap i j) v x
  rw [heq, image_add_left, measureReal_def, measureReal_def, measure_preimage_add]

/-- Coordinate extrema, including witnesses attaining them. -/
structure CoordinateExtrema {d : ℕ} (K : ConvexBody (Space d)) where
  lower : Fin d → Space d
  upper : Fin d → Space d
  lower_mem : ∀ i, lower i ∈ K
  upper_mem : ∀ i, upper i ∈ K
  lower_le : ∀ i x, x ∈ K → lower i i ≤ x i
  le_upper : ∀ i x, x ∈ K → x i ≤ upper i i

theorem exists_coordinateExtrema {d : ℕ} (K : ConvexBody (Space d)) :
    Nonempty (CoordinateExtrema K) := by
  classical
  have hlo (i : Fin d) := K.isCompact.exists_isMinOn K.nonempty
    ((continuous_apply i).continuousOn : ContinuousOn (fun x : Space d => x i) K)
  have hhi (i : Fin d) := K.isCompact.exists_isMaxOn K.nonempty
    ((continuous_apply i).continuousOn : ContinuousOn (fun x : Space d => x i) K)
  choose lo hlo hlo' using hlo
  choose hi hhi hhi' using hhi
  exact ⟨⟨lo, hi, hlo, hhi, hlo', hhi'⟩⟩

namespace CoordinateExtrema

variable {d : ℕ} {K : ConvexBody (Space d)} (F : CoordinateExtrema K)

def width (i : Fin d) : ℝ := F.upper i i - F.lower i i

theorem width_nonneg (i : Fin d) : 0 ≤ F.width i :=
  sub_nonneg.mpr (F.lower_le i _ (F.upper_mem i))

theorem abs_sub_le_width (i : Fin d) {x y : Space d} (hx : x ∈ K) (hy : y ∈ K) :
    |x i - y i| ≤ F.width i := by
  have hxl := F.lower_le i x hx
  have hxu := F.le_upper i x hx
  have hyl := F.lower_le i y hy
  have hyu := F.le_upper i y hy
  rw [abs_le]
  dsimp [width]
  constructor <;> linarith

theorem exists_maximum [Nonempty (Fin d)] :
    ∃ a : Fin d, ∀ i, F.width i ≤ F.width a := by
  obtain ⟨a, _, ha⟩ := Finset.univ.exists_max_image F.width Finset.univ_nonempty
  exact ⟨a, fun i => ha i (Finset.mem_univ i)⟩

theorem diameter_le_width {a : Fin d} (ha : ∀ i, F.width i ≤ F.width a) :
    diam (K : Set (Space d)) ≤ F.width a := by
  apply diam_le_of_forall_dist_le (F.width_nonneg a)
  intro x hx y hy
  rw [dist_eq_norm]
  apply (pi_norm_le_iff_of_nonneg (F.width_nonneg a)).2
  intro i
  exact (F.abs_sub_le_width i hx hy).trans (ha i)

def center (a : Fin d) : Space d := (1 / 2 : ℝ) • (F.upper a + F.lower a)

def direction (a : Fin d) : Space d := (F.width a)⁻¹ • (F.upper a - F.lower a)

def centeredBody (a : Fin d) : ConvexBody (Space d) := translateBody (-F.center a) K

theorem center_mem (a : Fin d) : F.center a ∈ K := by
  change F.center a ∈ (K : Set (Space d))
  simpa only [center, midpoint_eq_smul_add, invOf_eq_inv, one_div] using
    K.convex.midpoint_mem (F.upper_mem a) (F.lower_mem a)

theorem zero_mem_centeredBody (a : Fin d) : (0 : Space d) ∈ F.centeredBody a :=
  zero_mem_translateBody_neg (F.center_mem a)

theorem areas_centeredBody (a : Fin d) : areas (F.centeredBody a) = areas K :=
  areas_translate _ _

theorem direction_coordinate {a : Fin d} (hL : 0 < F.width a) :
    F.direction a a = 1 := by
  change (F.width a)⁻¹ * F.width a = 1
  exact inv_mul_cancel₀ hL.ne'

theorem direction_bound {a : Fin d} (ha : ∀ i, F.width i ≤ F.width a)
    (hL : 0 < F.width a) (i : Fin d) : |F.direction a i| ≤ 1 := by
  have hdiff := (F.abs_sub_le_width i (F.upper_mem a) (F.lower_mem a)).trans (ha i)
  change |(F.width a)⁻¹ * (F.upper a i - F.lower a i)| ≤ 1
  rw [abs_mul, abs_inv, abs_of_pos hL]
  exact (inv_mul_le_iff₀ hL).2 (by simpa using hdiff)

theorem direction_norm {a : Fin d} (ha : ∀ i, F.width i ≤ F.width a)
    (hL : 0 < F.width a) : ‖F.direction a‖ = 1 := by
  apply le_antisymm
  · exact (pi_norm_le_iff_of_nonneg (by norm_num : (0 : ℝ) ≤ 1)).2
      (fun i => F.direction_bound ha hL i)
  · have h := norm_le_pi_norm (F.direction a) a
    simpa [F.direction_coordinate hL] using h

theorem longitudinal_bound {a : Fin d} {x : Space d} (hx : x ∈ F.centeredBody a) :
    |x a| ≤ F.width a / 2 := by
  change x ∈ (F.centeredBody a : Set (Space d)) at hx
  rw [centeredBody, coe_translateBody] at hx
  obtain ⟨z, hz, rfl⟩ := hx
  have hlo := F.lower_le a z hz
  have hhi := F.le_upper a z hz
  dsimp [center, width]
  rw [abs_le]
  constructor <;> linarith

theorem positive_endpoint_mem {a : Fin d} (hL : 0 < F.width a) :
    (F.width a / 2) • F.direction a ∈ F.centeredBody a := by
  change (F.width a / 2) • F.direction a ∈ (F.centeredBody a : Set (Space d))
  rw [centeredBody, coe_translateBody]
  refine ⟨F.upper a, F.upper_mem a, ?_⟩
  ext i
  dsimp [center, direction]
  field_simp [hL.ne']
  <;> ring

theorem negative_endpoint_mem {a : Fin d} (hL : 0 < F.width a) :
    -((F.width a / 2) • F.direction a) ∈ F.centeredBody a := by
  change -((F.width a / 2) • F.direction a) ∈ (F.centeredBody a : Set (Space d))
  rw [centeredBody, coe_translateBody]
  refine ⟨F.lower a, F.lower_mem a, ?_⟩
  ext i
  dsimp [center, direction]
  field_simp [hL.ne']
  <;> ring

end CoordinateExtrema

/-- A small parallelogram inside a triangle gives the transverse estimate.
The constant is deliberately inessential; it avoids any triangulation API. -/
theorem det_le_twice_area {S : Set Plane} (hS : IsCompact S) (hc : Convex ℝ S)
    {p z : Plane} (hp : p ∈ S) (hn : -p ∈ S) (hz : z ∈ S) :
    |det2 p z| ≤ 2 * volume.real S := by
  have h0 : (0 : Plane) ∈ S := by
    simpa [midpoint_eq_smul_add] using hc.midpoint_mem hp hn
  let r : Plane := (- (1 / 2 : ℝ)) • p
  let b : Plane := (1 / 2 : ℝ) • z
  have hr : r ∈ S := by
    convert hc.midpoint_mem hn h0 using 1
    ext k
    simp [r, midpoint_eq_smul_add]
  have hra : r + p ∈ S := by
    convert hc.midpoint_mem hp h0 using 1
    ext k
    simp [r, midpoint_eq_smul_add]
    <;> ring
  have hrb : r + b ∈ S := by
    convert hc.midpoint_mem hn hz using 1
    ext k
    simp [r, b, midpoint_eq_smul_add]
    <;> ring
  have hrab : r + p + b ∈ S := by
    convert hc.midpoint_mem hp hz using 1
    ext k
    simp [r, b, midpoint_eq_smul_add]
    <;> ring
  have hsub : convexHull ℝ ({r, r + p, r + b, r + p + b} : Set Plane) ⊆ S := by
    apply convexHull_min
    · intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl | rfl <;> assumption
    · exact hc
  have harea := measureReal_mono (μ := (volume : Measure Plane)) hsub hS.measure_ne_top
  rw [area_translated_parallelogram_hull] at harea
  have hdet : det2 p b = (1 / 2 : ℝ) * det2 p z := by
    simp [det2, b]
    ring
  rw [hdet, abs_mul] at harea
  norm_num at harea
  linarith

theorem transverse_bound {d : ℕ} {K : ConvexBody (Space d)}
    {a : Fin d} {L : ℝ} {v : Space d} (hL : 0 ≤ L) (hva : v a = 1)
    (hp : (L / 2) • v ∈ K) (hn : -((L / 2) • v) ∈ K)
    {x : Space d} (hx : x ∈ K) (i : Fin d) :
    |L * (x i - v i * x a)| ≤ 4 * areas K a i := by
  have h := det_le_twice_area
    (K.isCompact.image (coordinateMap a i).continuous)
    (K.convex.linear_image (coordinateMap a i).toLinearMap)
    (Set.mem_image_of_mem (coordinateMap a i) hp)
    (by simpa only [map_neg] using Set.mem_image_of_mem (coordinateMap a i) hn)
    (Set.mem_image_of_mem (coordinateMap a i) hx)
  have hd : det2 (coordinateMap a i ((L / 2) • v)) (coordinateMap a i x) =
      (1 / 2 : ℝ) * (L * (x i - v i * x a)) := by
    simp [coordinateMap, ProjectionAreaTransforms.projectN, det2, hva]
    ring
  rw [hd, abs_mul] at h
  norm_num at h
  change |L * (x i - v i * x a)| ≤ 4 * volume.real
    (coordinateMap a i '' (K : Set (Space d)))
  rw [abs_mul]
  linarith

def normalizeMap {d : ℕ} (a : Fin d) (L : ℝ) (v : Space d) :
    Space d →L[ℝ] CylinderSpace d :=
  { toLinearMap :=
      { toFun := fun x => (x a / L, fun i => L * (x i - v i * x a))
        map_add' := by intros; ext <;> simp [add_div, mul_add] <;> ring
        map_smul' := by intros; ext <;> simp [smul_eq_mul] <;> ring }
    cont := by fun_prop }

def normalizedBody {d : ℕ} (a : Fin d) (L : ℝ) (v : Space d)
    (K : ConvexBody (Space d)) : ConvexBody (CylinderSpace d) :=
  linearImageBody (normalizeMap a L v) K

theorem normalizedBody_zero {d : ℕ} (a : Fin d) (L : ℝ) (v : Space d)
    {K : ConvexBody (Space d)} (h0 : (0 : Space d) ∈ K) :
    (0 : CylinderSpace d) ∈ normalizedBody a L v K := by
  exact ⟨0, h0, map_zero _⟩

theorem normalizedBody_box {d : ℕ} {a : Fin d} {L B : ℝ} {v : Space d}
    {K : ConvexBody (Space d)} (hL : 0 < L) (hB : 0 ≤ B) (hva : v a = 1)
    (hp : (L / 2) • v ∈ K) (hn : -((L / 2) • v) ∈ K)
    (ht : ∀ x ∈ K, |x a| ≤ L / 2) (hA : ∀ i, areas K a i ≤ B) :
    (normalizedBody a L v K : Set (CylinderSpace d)) ⊆
      Icc (- (1 / 2 : ℝ)) (1 / 2) ×ˢ
        Icc (fun _ : Fin d => -4 * B) (fun _ => 4 * B) := by
  rintro z ⟨x, hx, rfl⟩
  constructor
  · change - (1 / 2 : ℝ) ≤ x a / L ∧ x a / L ≤ 1 / 2
    have habs : |x a / L| ≤ 1 / 2 := by
      rw [abs_div, abs_of_pos hL]
      exact (div_le_iff₀ hL).2 (by nlinarith [ht x hx])
    exact abs_le.mp habs
  · have h (i : Fin d) : |L * (x i - v i * x a)| ≤ 4 * B :=
      (transverse_bound hL.le hva hp hn hx i).trans
        (mul_le_mul_of_nonneg_left (hA i) (by norm_num))
    constructor
    · intro i
      change -4 * B ≤ L * (x i - v i * x a)
      simpa only [neg_mul] using (abs_le.mp (h i)).1
    · intro i
      change L * (x i - v i * x a) ≤ 4 * B
      exact (abs_le.mp (h i)).2

theorem normalizeMap_reconstruct {d : ℕ} {a : Fin d} {L : ℝ}
    (hL : L ≠ 0) (v x : Space d) (i : Fin d) :
    L * (normalizeMap a L v x).1 * v i +
      (normalizeMap a L v x).2 i / L = x i := by
  dsimp [normalizeMap]
  field_simp [hL]
  ring

end ProjectionAreaEscapeNormalization

end
end EscapeNormalizationSource


/-! ## EscapeLimit -/

section EscapeLimitSource
/-!
# Projection areas of rescaled long bodies

After longitudinal/transverse rescaling, the bodies lie in a fixed compact
box.  This file identifies every area limit with the fiber-area seminorm
of a limiting body.  The estimate for a pair of vanishing direction
coordinates is separate, so no division by a limiting zero is used.
-/

noncomputable section
open Set Metric MeasureTheory Filter TopologicalSpace Matrix
open scoped Pointwise Topology

namespace ProjectionAreaEscapeNormalization

open ProjectionAreaTopology ProjectionAreaCoordinateLifts

theorem areas_nonneg {d : ℕ} (K : ConvexBody (Space d)) (i j : Fin d) :
    0 ≤ areas K i j := ENNReal.toReal_nonneg

theorem areas_diagonal {d : ℕ} (K : ConvexBody (Space d)) (i : Fin d) :
    areas K i i = 0 := by
  change volume.real (ProjectionAreaTransforms.projectN i i '' (K : Set (Space d))) = 0
  exact ProjectionAreaTransforms.same_coordinate_area_zero (K : Set (Space d)) i

def swapPlane : Plane →ₗ[ℝ] Plane := Matrix.toLin' !![0, 1; 1, 0]

theorem swapPlane_apply (x : Plane) : swapPlane x = ![x 1, x 0] := by
  ext k
  fin_cases k <;> simp [swapPlane, Matrix.toLin'_apply, Matrix.mulVec,
    dotProduct, Fin.sum_univ_two]

theorem areas_symmetric {d : ℕ} (K : ConvexBody (Space d)) (i j : Fin d) :
    areas K i j = areas K j i := by
  have hset : coordinateMap j i '' (K : Set (Space d)) =
      swapPlane '' (coordinateMap i j '' (K : Set (Space d))) := by
    rw [Set.image_image]
    congr 1
    funext x
    simp [coordinateMap, ProjectionAreaTransforms.projectN, swapPlane_apply]
  unfold areas
  rw [hset, area_linear_image]
  simp [swapPlane, LinearMap.det_toLin', Matrix.det_fin_two]

def cylinderPlane {d : ℕ} (v : Space d) (ε : ℝ) (i j : Fin d) :
    CylinderSpace d →L[ℝ] Plane :=
  { toLinearMap :=
      { toFun := fun z => ![v i * z.2 j - v j * z.2 i, z.1 + ε * z.2 i]
        map_add' := by intros; ext k; fin_cases k <;> simp <;> ring
        map_smul' := by intros; ext k; fin_cases k <;> simp <;> ring }
    cont := by fun_prop }

def cylinderArea {d : ℕ} (C : ConvexBody (CylinderSpace d))
    (v : Space d) (ε : ℝ) (i j : Fin d) : ℝ :=
  volume.real (cylinderPlane v ε i j '' (C : Set (CylinderSpace d)))

theorem continuous_cylinderArea {d : ℕ} (i j : Fin d) :
    Continuous (fun p : Space d × ℝ × ConvexBody (CylinderSpace d) =>
      cylinderArea p.2.2 p.1 p.2.1 i j) := by
  change Continuous ((fun K : ConvexBody Plane => (volume : Measure Plane).real (K : Set Plane)) ∘
    (fun p : Space d × ℝ × ConvexBody (CylinderSpace d) =>
      linearImageBody (cylinderPlane p.1 p.2.1 i j) p.2.2))
  apply (VolumePolynomials.continuous_convexBody_realMeasure (volume : Measure Plane)).comp
  apply continuous_linearImageBody_parametric
  · dsimp [cylinderPlane]
    fun_prop
  · fun_prop

def longitudinal {d : ℕ} : CylinderSpace d →ₗ[ℝ] ℝ := LinearMap.fst ℝ ℝ (Space d)

def transverseCoordinate {d : ℕ} (i : Fin d) : CylinderSpace d →ₗ[ℝ] ℝ :=
  (LinearMap.proj i).comp (LinearMap.snd ℝ ℝ (Space d))

theorem area_finTwoArrow (S : Set Plane) :
    (volume : Measure (ℝ × ℝ)).real (MeasurableEquiv.finTwoArrow '' S) =
      (volume : Measure Plane).real S := by
  have h := (volume_preserving_finTwoArrow ℝ).measure_preimage_equiv
    (MeasurableEquiv.finTwoArrow '' S)
  rw [Set.preimage_image_eq _ MeasurableEquiv.finTwoArrow.injective] at h
  exact congrArg ENNReal.toReal h.symm

theorem cylinderArea_zero_fiberArea {d : ℕ} (C : ConvexBody (CylinderSpace d))
    (v : Space d) (i j : Fin d) :
    cylinderArea C v 0 i j = ProjectionAreaFiber.fiberArea (C : Set (CylinderSpace d))
      longitudinal (v i • transverseCoordinate j - v j • transverseCoordinate i) := by
  unfold cylinderArea ProjectionAreaFiber.fiberArea
  rw [← area_finTwoArrow, Set.image_image]
  congr 1
  unfold ProjectionAreaFiber.planeImage
  congr 1
  funext z
  simp [cylinderPlane, longitudinal, transverseCoordinate,
    MeasurableEquiv.finTwoArrow]

theorem cylinderArea_weighted_triangle {d : ℕ} (C : ConvexBody (CylinderSpace d))
    (v : Space d) (i j k : Fin d) :
    |v k| * cylinderArea C v 0 i j ≤
      |v j| * cylinderArea C v 0 i k + |v i| * cylinderArea C v 0 j k := by
  simp only [cylinderArea_zero_fiberArea]
  exact ProjectionAreaFiber.fiberArea_weighted_triangle C.isCompact C.convex
    longitudinal transverseCoordinate v i j k

theorem cylinderArea_zero_coordinates {d : ℕ} (C : ConvexBody (CylinderSpace d))
    {v : Space d} {i j : Fin d} (hi : v i = 0) (hj : v j = 0) :
    cylinderArea C v 0 i j = 0 := by
  rw [cylinderArea_zero_fiberArea, hi, hj, zero_smul, zero_smul, sub_self,
    ProjectionAreaFiber.fiberArea_zero]

theorem cylinderArea_symm {d : ℕ} (C : ConvexBody (CylinderSpace d))
    (v : Space d) (i j : Fin d) : cylinderArea C v 0 i j = cylinderArea C v 0 j i := by
  simp only [cylinderArea_zero_fiberArea]
  have h : v j • transverseCoordinate i - v i • transverseCoordinate j =
      -(v i • transverseCoordinate j - v j • transverseCoordinate i) := by abel
  rw [h, ProjectionAreaFiber.fiberArea_neg]

def determinantOneRescaling (L u w : ℝ) : Plane →ₗ[ℝ] Plane :=
  Matrix.toLin' !![-L * w, L * u; (L * u)⁻¹, 0]

theorem determinantOneRescaling_apply (L u w : ℝ) (x : Plane) :
    determinantOneRescaling L u w x = ![L * (u * x 1 - w * x 0), x 0 / (L * u)] := by
  ext k
  fin_cases k <;>
    simp [determinantOneRescaling, Matrix.toLin'_apply, Matrix.mulVec,
      dotProduct, Fin.sum_univ_two, div_eq_mul_inv] <;> ring

theorem determinantOneRescaling_det {L u : ℝ} (hL : L ≠ 0) (hu : u ≠ 0) (w : ℝ) :
    LinearMap.det (determinantOneRescaling L u w) = -1 := by
  simp [determinantOneRescaling, LinearMap.det_toLin', Matrix.det_fin_two, hL, hu] <;>
    field_simp [hL, hu] <;> ring

theorem cylinderArea_normalized {d : ℕ} (a : Fin d) (L : ℝ) (v : Space d)
    (K : ConvexBody (Space d)) (i j : Fin d) (hL : L ≠ 0) (hi : v i ≠ 0) :
    cylinderArea (normalizedBody a L v K) v (L⁻¹ ^ 2 / v i) i j = areas K i j := by
  have hmap : (fun x : Space d =>
      cylinderPlane v (L⁻¹ ^ 2 / v i) i j (normalizeMap a L v x)) =
      (fun x => determinantOneRescaling L (v i) (v j) (coordinateMap i j x)) := by
    funext x
    ext k
    fin_cases k
    · simp [cylinderPlane, normalizeMap, coordinateMap,
        ProjectionAreaTransforms.projectN, determinantOneRescaling_apply]
      ring
    · simp [cylinderPlane, normalizeMap, coordinateMap,
        ProjectionAreaTransforms.projectN, determinantOneRescaling_apply]
      field_simp [hL, hi]
      ring
  change volume.real (cylinderPlane v (L⁻¹ ^ 2 / v i) i j ''
    (normalizeMap a L v '' (K : Set (Space d)))) =
    volume.real (coordinateMap i j '' (K : Set (Space d)))
  rw [Set.image_image, hmap, ← Set.image_image, area_linear_image,
    determinantOneRescaling_det hL hi]
  norm_num

def shearScale (L r : ℝ) : Plane →ₗ[ℝ] Plane :=
  Matrix.toLin' !![L⁻¹, 0; -L * r, L]

theorem shearScale_apply (L r : ℝ) (x : Plane) :
    shearScale L r x = ![x 0 / L, L * (x 1 - r * x 0)] := by
  ext k
  fin_cases k <;> simp [shearScale, Matrix.toLin'_apply, Matrix.mulVec,
    dotProduct, Fin.sum_univ_two, div_eq_mul_inv] <;> ring

theorem shearScale_area {L : ℝ} (hL : L ≠ 0) (r : ℝ) (S : Set Plane) :
    volume.real (shearScale L r '' S) = volume.real S := by
  rw [area_linear_image]
  simp [shearScale, LinearMap.det_toLin', Matrix.det_fin_two, hL]

theorem abs_ratio_le_one {u w : ℝ} (hw : |w| ≤ |u|) : |w / u| ≤ 1 := by
  by_cases hu : u = 0
  · simp [hu]
  · rw [abs_div]
    exact (div_le_one (abs_pos.mpr hu)).2 hw

theorem ratio_mul_of_abs_le {u w : ℝ} (hw : |w| ≤ |u|) : (w / u) * u = w := by
  by_cases hu : u = 0
  · have hw0 : w = 0 := abs_eq_zero.mp (le_antisymm (by simpa [hu] using hw) (abs_nonneg _))
    simp [hu, hw0]
  · exact div_mul_cancel₀ w hu

theorem rectangle_area (A B : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) :
    (volume : Measure Plane).real (Icc ![-A, -B] ![A, B]) = 4 * A * B := by
  have hab : (![-A, -B] : Plane) ≤ ![A, B] := by
    intro k
    fin_cases k <;> simp <;> linarith
  rw [measureReal_def, Real.volume_Icc_pi_toReal hab, Fin.prod_univ_two]
  simp
  ring

/-- Uniform area bound when the two limiting direction coordinates vanish.
It is valid even when the dominant coordinate is exactly zero. -/
theorem area_small_direction_of_domination {d : ℕ} {a i j : Fin d} {L B : ℝ}
    {v : Space d} {K : ConvexBody (Space d)} (hL : 0 < L) (hB : 0 ≤ B)
    (hdom : |v j| ≤ |v i|)
    (ht : ∀ z ∈ normalizedBody a L v K, |z.1| ≤ 1 / 2)
    (hy : ∀ z ∈ normalizedBody a L v K, ∀ k, |z.2 k| ≤ B) :
    areas K i j ≤ (|v i| + 2 * B * L⁻¹ ^ 2) * (4 * B) := by
  let r : ℝ := v j / v i
  let A : ℝ := |v i| / 2 + B * L⁻¹ ^ 2
  have hr : |r| ≤ 1 := abs_ratio_le_one hdom
  have hrmul : r * v i = v j := ratio_mul_of_abs_le hdom
  have hA : 0 ≤ A := by positivity
  have hsub : shearScale L r '' (coordinateMap i j '' (K : Set (Space d))) ⊆
      Icc ![-A, -(2 * B)] ![A, 2 * B] := by
    rintro z ⟨p, ⟨x, hx, rfl⟩, rfl⟩
    let c := normalizeMap a L v x
    have hc : c ∈ normalizedBody a L v K := ⟨x, hx, rfl⟩
    have hci := hy c hc i
    have hcj := hy c hc j
    have hct := ht c hc
    have hfirst : x i / L = v i * c.1 + L⁻¹ ^ 2 * c.2 i := by
      dsimp [c, normalizeMap]
      field_simp [hL.ne']
      ring
    have hsecond : L * (x j - r * x i) = c.2 j - r * c.2 i := by
      dsimp [c, normalizeMap]
      rw [← hrmul]
      ring
    have hbfirst : |x i / L| ≤ A := by
      rw [hfirst]
      calc
        |v i * c.1 + L⁻¹ ^ 2 * c.2 i| ≤
            |v i * c.1| + |L⁻¹ ^ 2 * c.2 i| :=
          abs_add_le (v i * c.1) (L⁻¹ ^ 2 * c.2 i)
        _ = |v i| * |c.1| + L⁻¹ ^ 2 * |c.2 i| := by
          congr 1
          · exact abs_mul _ _
          · rw [abs_mul, abs_of_nonneg (sq_nonneg (L⁻¹))]
        _ ≤ |v i| * (1 / 2) + L⁻¹ ^ 2 * B := by gcongr
        _ = A := by dsimp [A]; ring
    have hbsecond : |L * (x j - r * x i)| ≤ 2 * B := by
      rw [hsecond]
      calc
        |c.2 j - r * c.2 i| ≤ |c.2 j| + |r| * |c.2 i| := by
          simpa [abs_mul] using abs_sub (c.2 j) (r * c.2 i)
        _ ≤ B + 1 * B := by gcongr
        _ = 2 * B := by ring
    constructor <;> intro k <;> fin_cases k <;>
      simp only [shearScale_apply, coordinateMap, ProjectionAreaTransforms.projectN,
        LinearMap.coe_mk, AddHom.coe_mk, Matrix.cons_val_zero, Matrix.cons_val_one] <;>
      first | exact (abs_le.mp hbfirst).1 | exact (abs_le.mp hbfirst).2 |
        exact (abs_le.mp hbsecond).1 | exact (abs_le.mp hbsecond).2
  have hm : (volume : Measure Plane).real
      (shearScale L r '' (coordinateMap i j '' (K : Set (Space d)))) ≤
      (volume : Measure Plane).real (Icc ![-A, -(2 * B)] ![A, 2 * B]) :=
    measureReal_mono hsub (isCompact_Icc.measure_ne_top (μ := (volume : Measure Plane)))
  rw [shearScale_area hL.ne', rectangle_area A (2 * B) hA (by positivity)] at hm
  change areas K i j ≤ 4 * A * (2 * B) at hm
  calc
    areas K i j ≤ 4 * A * (2 * B) := hm
    _ = (|v i| + 2 * B * L⁻¹ ^ 2) * (4 * B) := by dsimp [A]; ring

theorem area_small_direction {d : ℕ} {a i j : Fin d} {L B : ℝ}
    {v : Space d} {K : ConvexBody (Space d)} (hL : 0 < L) (hB : 0 ≤ B)
    (ht : ∀ z ∈ normalizedBody a L v K, |z.1| ≤ 1 / 2)
    (hy : ∀ z ∈ normalizedBody a L v K, ∀ k, |z.2 k| ≤ B) :
    areas K i j ≤ (max |v i| |v j| + 2 * B * L⁻¹ ^ 2) * (4 * B) := by
  rcases le_total |v j| |v i| with h | h
  · simpa only [max_eq_left h] using area_small_direction_of_domination hL hB h ht hy
  · rw [areas_symmetric K i j, max_eq_right h]
    exact area_small_direction_of_domination hL hB h ht hy

/-- The exact limiting areas after a compact rescaling subsequence. -/
theorem area_limit_eq_cylinderArea {d : ℕ}
    (K : ℕ → ConvexBody (Space d)) (a : ℕ → Fin d) (L : ℕ → ℝ)
    (v : ℕ → Space d) (C : ConvexBody (CylinderSpace d)) (vlim : Space d)
    (B : ℝ) (hB : 0 ≤ B) (hLpos : ∀ m, 0 < L m)
    (hL : Tendsto L atTop atTop)
    (hv : Tendsto v atTop (𝓝 vlim))
    (hC : Tendsto (fun m => normalizedBody (a m) (L m) (v m) (K m)) atTop (𝓝 C))
    (ht : ∀ m z, z ∈ normalizedBody (a m) (L m) (v m) (K m) → |z.1| ≤ 1 / 2)
    (hy : ∀ m z, z ∈ normalizedBody (a m) (L m) (v m) (K m) → ∀ k, |z.2 k| ≤ B)
    {q : Matrix (Fin d) (Fin d) ℝ} (hq : Tendsto (fun m => areas (K m)) atTop (𝓝 q)) :
    ∀ i j, q i j = cylinderArea C vlim 0 i j := by
  have hvcoord (i : Fin d) : Tendsto (fun m => v m i) atTop (𝓝 (vlim i)) :=
    (continuous_apply i).continuousAt.tendsto.comp hv
  have hqcoord (i j : Fin d) : Tendsto (fun m => areas (K m) i j) atTop (𝓝 (q i j)) := by
    have hrow : Continuous (fun p : Fin d → Fin d → ℝ => p i) := continuous_apply i
    have heval : Continuous (fun p : Fin d → Fin d → ℝ => p i j) :=
      (continuous_apply j).comp hrow
    exact heval.continuousAt.tendsto.comp hq
  have hInv : Tendsto (fun m => (L m)⁻¹ ^ 2) atTop (𝓝 0) := by
    simpa using (tendsto_inv_atTop_zero.comp hL).pow 2
  have hnonzero (i j : Fin d) (hi : vlim i ≠ 0) :
      q i j = cylinderArea C vlim 0 i j := by
    have hε : Tendsto (fun m => (L m)⁻¹ ^ 2 / v m i) atTop (𝓝 0) := by
      simpa only [Pi.div_def, zero_div] using hInv.div (hvcoord i) hi
    have hpar := hv.prodMk_nhds (hε.prodMk_nhds hC)
    have harea : Tendsto (fun m => cylinderArea
        (normalizedBody (a m) (L m) (v m) (K m)) (v m)
        ((L m)⁻¹ ^ 2 / v m i) i j) atTop (𝓝 (cylinderArea C vlim 0 i j)) := by
      simpa only [Function.comp_def] using
        ((continuous_cylinderArea i j).tendsto (vlim, 0, C)).comp hpar
    have hne : ∀ᶠ m in atTop, v m i ≠ 0 :=
      (hvcoord i).eventually (isOpen_ne.mem_nhds hi)
    have heq : (fun m => cylinderArea
          (normalizedBody (a m) (L m) (v m) (K m)) (v m)
          ((L m)⁻¹ ^ 2 / v m i) i j) =ᶠ[atTop]
        (fun m => areas (K m) i j) := by
      filter_upwards [hne] with m hm
      exact cylinderArea_normalized _ _ _ _ _ _ (hLpos m).ne' hm
    exact tendsto_nhds_unique (hqcoord i j) (harea.congr' heq)
  intro i j
  by_cases hi : vlim i ≠ 0
  · exact hnonzero i j hi
  by_cases hj : vlim j ≠ 0
  · have hs : q i j = q j i :=
      tendsto_nhds_unique (hqcoord i j)
        ((hqcoord j i).congr' (Filter.Eventually.of_forall fun m => (areas_symmetric _ i j).symm))
    rw [hs, hnonzero j i hj, cylinderArea_symm C vlim]
  · have hi0 : vlim i = 0 := not_ne_iff.mp hi
    have hj0 : vlim j = 0 := not_ne_iff.mp hj
    have hub : Tendsto (fun m =>
        (max |v m i| |v m j| + 2 * B * (L m)⁻¹ ^ 2) * (4 * B)) atTop (𝓝 0) := by
      simpa [hi0, hj0] using
        (((hvcoord i).abs.max (hvcoord j).abs).add
          (tendsto_const_nhds.mul hInv)).mul_const (4 * B)
    have hzero : Tendsto (fun m => areas (K m) i j) atTop (𝓝 0) :=
      squeeze_zero (fun m => areas_nonneg _ _ _)
        (fun m => area_small_direction (hLpos m) hB (ht m) (hy m)) hub
    rw [cylinderArea_zero_coordinates C hi0 hj0]
    exact tendsto_nhds_unique (hqcoord i j) hzero

end ProjectionAreaEscapeNormalization

end
end EscapeLimitSource


/-! ## EscapeNecessity -/

section EscapeNecessitySource
/-!
# Necessity of the weighted triangle inequalities for escaping bodies

This is the necessary direction of Theorem 1.2.  No geometric compactness
or seminorm representation is an input: extrema, reciprocal rescaling,
Hausdorff compactness, continuity of ordinary areas, and interval-fiber
subadditivity establish the witness from an arbitrary escaping sequence.
-/

noncomputable section
open Set Metric MeasureTheory Filter TopologicalSpace
open scoped Pointwise Topology

namespace ProjectionAreaEscapeNormalization

open ProjectionAreaTopology ProjectionAreaEscape

theorem eventually_uniform_area_bound {d : ℕ}
    (K : ℕ → ConvexBody (Space d)) {q : Matrix (Fin d) (Fin d) ℝ}
    (hq : Tendsto (fun m => areas (K m)) atTop (𝓝 q)) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ᶠ m in atTop, ∀ i j, areas (K m) i j ≤ B := by
  letI : NormedAddCommGroup (Matrix (Fin d) (Fin d) ℝ) :=
    inferInstanceAs (NormedAddCommGroup (Fin d → Fin d → ℝ))
  refine ⟨‖(q : Fin d → Fin d → ℝ)‖ + 1, by positivity, ?_⟩
  have hq' : Tendsto (fun m => (areas (K m) : Fin d → Fin d → ℝ)) atTop
      (𝓝 (q : Fin d → Fin d → ℝ)) := hq
  have h := hq'.norm.eventually (isOpen_Iio.mem_nhds
    (show ‖(q : Fin d → Fin d → ℝ)‖ ∈ Iio (‖(q : Fin d → Fin d → ℝ)‖ + 1) by
      change ‖(q : Fin d → Fin d → ℝ)‖ < ‖(q : Fin d → Fin d → ℝ)‖ + 1
      linarith))
  filter_upwards [h] with m hm i j
  calc
    areas (K m) i j ≤ |areas (K m) i j| := le_abs_self _
    _ ≤ ‖areas (K m) i‖ := by
      simpa only [Real.norm_eq_abs] using (norm_le_pi_norm (areas (K m) i) j)
    _ ≤ ‖(areas (K m) : Fin d → Fin d → ℝ)‖ := norm_le_pi_norm _ _
    _ ≤ ‖(q : Fin d → Fin d → ℝ)‖ + 1 := hm.le

theorem escaping_weights_of_uniform_bounds {d : ℕ} [Nonempty (Fin d)]
    (K : ℕ → ConvexBody (Space d)) {q : Matrix (Fin d) (Fin d) ℝ}
    (hq : Tendsto (fun m => areas (K m)) atTop (𝓝 q))
    (hdiam : Tendsto (fun m => diam (K m : Set (Space d))) atTop atTop)
    (hpositive : ∀ m, 1 ≤ diam (K m : Set (Space d)))
    (B : ℝ) (hB : 0 ≤ B) (hbound : ∀ m i j, areas (K m) i j ≤ B) :
    AdmitsTriangleWeights q := by
  classical
  let F (m : ℕ) : CoordinateExtrema (K m) := Classical.choice (exists_coordinateExtrema (K m))
  choose a ha using fun m => (F m).exists_maximum
  let L (m : ℕ) : ℝ := (F m).width (a m)
  let v (m : ℕ) : Space d := (F m).direction (a m)
  let J (m : ℕ) : ConvexBody (Space d) := (F m).centeredBody (a m)
  let C (m : ℕ) : ConvexBody (CylinderSpace d) := normalizedBody (a m) (L m) (v m) (J m)
  have hLpos (m : ℕ) : 0 < L m :=
    zero_lt_one.trans_le ((hpositive m).trans ((F m).diameter_le_width (ha m)))
  have hL : Tendsto L atTop atTop :=
    tendsto_atTop_mono (fun m => (F m).diameter_le_width (ha m)) hdiam
  have hvnorm (m : ℕ) : ‖v m‖ = 1 := (F m).direction_norm (ha m) (hLpos m)
  have hvbound (m : ℕ) : v m ∈ Icc (-1 : Space d) 1 := by
    have h := (F m).direction_bound (ha m) (hLpos m)
    exact ⟨fun i => (abs_le.mp (h i)).1, fun i => (abs_le.mp (h i)).2⟩
  have hJareas (m : ℕ) : areas (J m) = areas (K m) := (F m).areas_centeredBody (a m)
  have hCzero (m : ℕ) : (0 : CylinderSpace d) ∈ C m :=
    normalizedBody_zero _ _ _ ((F m).zero_mem_centeredBody (a m))
  let box : Set (CylinderSpace d) :=
    Icc (- (1 / 2 : ℝ)) (1 / 2) ×ˢ Icc (fun _ : Fin d => -4 * B) (fun _ => 4 * B)
  have hCbox (m : ℕ) : (C m : Set (CylinderSpace d)) ⊆ box := by
    apply normalizedBody_box (hLpos m) hB ((F m).direction_coordinate (hLpos m))
      ((F m).positive_endpoint_mem (hLpos m)) ((F m).negative_endpoint_mem (hLpos m))
      (fun x hx => (F m).longitudinal_bound hx)
    intro i
    rw [hJareas]
    exact hbound m (a m) i
  have hbox : IsCompact box := isCompact_Icc.prod isCompact_Icc
  have hcompact : IsCompact
      ((Icc (-1 : Space d) 1) ×ˢ
        {D : ConvexBody (CylinderSpace d) | (0 : CylinderSpace d) ∈ D ∧
          (D : Set (CylinderSpace d)) ⊆ box}) :=
    isCompact_Icc.prod (VolumePolynomials.isCompact_bodies_in_compact hbox)
  obtain ⟨p, hp, φ, hφ, hpconv⟩ := hcompact.tendsto_subseq
    (fun m => show (v m, C m) ∈ _ from ⟨hvbound m, hCzero m, hCbox m⟩)
  have hvconv : Tendsto (fun m => v (φ m)) atTop (𝓝 p.1) :=
    continuous_fst.continuousAt.tendsto.comp hpconv
  have hCconv : Tendsto (fun m => C (φ m)) atTop (𝓝 p.2) :=
    continuous_snd.continuousAt.tendsto.comp hpconv
  have hp_norm : ‖p.1‖ = 1 := by
    have hone : Tendsto (fun m => ‖v (φ m)‖) atTop (𝓝 (1 : ℝ)) := by
      simpa only [hvnorm] using (tendsto_const_nhds : Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 1))
    exact tendsto_nhds_unique hvconv.norm hone
  have hqJ : Tendsto (fun m => areas (J (φ m))) atTop (𝓝 q) := by
    simpa only [Function.comp_def, hJareas] using hq.comp hφ.tendsto_atTop
  have hrepr : ∀ i j, q i j = cylinderArea p.2 p.1 0 i j := by
    apply area_limit_eq_cylinderArea
      (fun m => J (φ m)) (fun m => a (φ m)) (fun m => L (φ m))
      (fun m => v (φ m)) p.2 p.1 (4 * B) (by positivity)
      (fun m => hLpos (φ m)) (hL.comp hφ.tendsto_atTop) hvconv hCconv
      _ _ hqJ
    · intro m z hz
      exact abs_le.mpr ((hCbox (φ m) hz).1)
    · intro m z hz i
      have hb := (hCbox (φ m) hz).2
      exact abs_le.mpr ⟨by simpa only [neg_mul] using hb.1 i, hb.2 i⟩
  refine ⟨fun i => |p.1 i|, fun i => abs_nonneg _, ?_, ?_⟩
  · intro hz
    have hvzero : p.1 = 0 := by
      ext i
      exact abs_eq_zero.mp (congrFun hz i)
    rw [hvzero, norm_zero] at hp_norm
    norm_num at hp_norm
  · intro i j k _ _ _
    simp only [hrepr]
    exact cylinderArea_weighted_triangle p.2 p.1 i j k

theorem escaping_weights {d : ℕ} [Nonempty (Fin d)]
    (K : ℕ → ConvexBody (Space d)) {q : Matrix (Fin d) (Fin d) ℝ}
    (hq : Tendsto (fun m => areas (K m)) atTop (𝓝 q))
    (hdiam : Tendsto (fun m => diam (K m : Set (Space d))) atTop atTop) :
    AdmitsTriangleWeights q := by
  obtain ⟨B, hB, hbound⟩ := eventually_uniform_area_bound K hq
  have hpositive : ∀ᶠ m in atTop, 1 ≤ diam (K m : Set (Space d)) :=
    tendsto_atTop.mp hdiam 1
  obtain ⟨φ, hφ, hgood⟩ := extraction_of_frequently_atTop (hpositive.and hbound).frequently
  exact escaping_weights_of_uniform_bounds (fun m => K (φ m))
    (hq.comp hφ.tendsto_atTop) (hdiam.comp hφ.tendsto_atTop)
    (fun m => (hgood m).1) B hB (fun m => (hgood m).2)

theorem area_limit_properties {d : ℕ} (K : ℕ → ConvexBody (Space d))
    {q : Matrix (Fin d) (Fin d) ℝ}
    (hq : Tendsto (fun m => areas (K m)) atTop (𝓝 q)) :
    (∀ i, q i i = 0) ∧ (∀ i j, q i j = q j i) ∧ (∀ i j, 0 ≤ q i j) := by
  have hentry (i j : Fin d) : Tendsto (fun m => areas (K m) i j) atTop (𝓝 (q i j)) := by
    have hrow : Continuous (fun p : Fin d → Fin d → ℝ => p i) := continuous_apply i
    have heval : Continuous (fun p : Fin d → Fin d → ℝ => p i j) :=
      (continuous_apply j).comp hrow
    exact heval.continuousAt.tendsto.comp hq
  refine ⟨?_, ?_, ?_⟩
  · intro i
    apply tendsto_nhds_unique (hentry i i)
    simpa only [areas_diagonal] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
  · intro i j
    exact tendsto_nhds_unique (hentry i j)
      ((hentry j i).congr' (Filter.Eventually.of_forall fun m => (areas_symmetric _ i j).symm))
  · intro i j
    exact ge_of_tendsto (hentry i j)
      (Filter.Eventually.of_forall fun m => areas_nonneg (K m) i j)

/-- The equivalence of coordinate models does not change any projected area. -/
def euclideanToCoordinates (d : ℕ) : CoordinateSpace d ≃L[ℝ] Space d :=
  PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin d => ℝ)

theorem areas_euclideanToCoordinates {d : ℕ} (K : CoordinateBody d) :
    areas (linearImageBody (euclideanToCoordinates d).toContinuousLinearMap K) =
      coordinateAreas K := by
  ext i j
  unfold areas coordinateAreas
  rw [coe_linearImageBody, Set.image_image]
  congr 1
  congr 1
  funext x
  ext k
  fin_cases k <;>
    simp [coordinateMap, ProjectionAreaTransforms.projectN, coordinateProjection,
      euclideanToCoordinates, PiLp.coe_continuousLinearEquiv]

theorem diameter_euclideanToCoordinates {d : ℕ} (K : CoordinateBody d) :
    diam (K : Set (CoordinateSpace d)) ≤
      (‖(euclideanToCoordinates d).symm.toContinuousLinearMap‖ + 1) *
        diam (linearImageBody (euclideanToCoordinates d).toContinuousLinearMap K : Set (Space d)) := by
  let f := (euclideanToCoordinates d).toContinuousLinearMap
  let g := (euclideanToCoordinates d).symm.toContinuousLinearMap
  have hset : g '' (linearImageBody f K : Set (Space d)) = (K : Set (CoordinateSpace d)) := by
    rw [coe_linearImageBody, Set.image_image]
    have hgf : (fun x : CoordinateSpace d => g (f x)) = id := by
      funext x
      simpa only [f, g, ContinuousLinearEquiv.coe_coe, id_eq] using
        (euclideanToCoordinates d).symm_apply_apply x
    rw [hgf, Set.image_id]
  have h := g.lipschitz.diam_image_le (linearImageBody f K : Set (Space d))
    (linearImageBody f K).isBounded
  rw [hset] at h
  exact h.trans (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right (by norm_num)) diam_nonneg)

theorem divergingDiameterLimits_subset_escapeCone (d : ℕ) :
    divergingDiameterLimits d ⊆ EscapeCone d := by
  rintro q ⟨K, hq, hdiam⟩
  by_cases hne : Nonempty (Fin d)
  · letI := hne
    let J : ℕ → ConvexBody (Space d) := fun m =>
      linearImageBody (euclideanToCoordinates d).toContinuousLinearMap (K m)
    have hJq : Tendsto (fun m => areas (J m)) atTop (𝓝 q) := by
      simpa only [J, areas_euclideanToCoordinates] using hq
    have hJdiam : Tendsto (fun m => diam (J m : Set (Space d))) atTop atTop := by
      have h := tendsto_atTop_mono (fun m => diameter_euclideanToCoordinates (K m)) hdiam
      exact (tendsto_const_mul_atTop_of_pos (by positivity :
        0 < ‖(euclideanToCoordinates d).symm.toContinuousLinearMap‖ + 1)).mp h
    obtain ⟨hh, hs, hp⟩ := area_limit_properties J hJq
    exact ⟨hh, hs, hp, escaping_weights J hJq hJdiam⟩
  · letI : IsEmpty (Fin d) := not_nonempty_iff.mp hne
    have hzero (m : ℕ) : diam (K m : Set (CoordinateSpace d)) = 0 :=
      diam_subsingleton Set.subsingleton_of_subsingleton
    have hlarge := tendsto_atTop.mp hdiam 1
    obtain ⟨m, hm⟩ := hlarge.exists
    rw [hzero] at hm
    norm_num at hm

end ProjectionAreaEscapeNormalization

