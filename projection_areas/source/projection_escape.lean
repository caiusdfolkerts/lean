@[expose] public section

/-!
# Weighted widths, strict approximation, and actual escaping realizations

The three source sections prove the finite width polytope construction, a
polynomial strict approximation covering all zero-weight cases, and the
actual-body sufficiency direction of Theorem 1.2. Public declarations and
proof bodies are preserved from the component sources.
-/

/-! ## EscapeConstruction -/

section EscapeConstructionSource

/-!
# A finite polytope with prescribed weighted widths

This proves the prescribed-width polytope assertion in Proposition 3.2. The
vertices are explicit distance potentials on the coordinates with positive
weight, together with independent endpoint choices on zero-weight coordinates.
Taking their actual convex hull gives a compact, centrally symmetric polytope.
Widths below are differences of real suprema and infima of actual linear images.
-/

open Set
open scoped Pointwise

namespace ProjectionAreaEscape

noncomputable section

variable {n : ℕ}

/-- The linear functional with coefficient vector `w i e_j - w j e_i`. -/
def pairFunctional (w : Fin n → ℝ) (i j : Fin n) : (Fin n → ℝ) →ₗ[ℝ] ℝ where
  toFun x := w i * x j - w j * x i
  map_add' x y := by simp; ring
  map_smul' c x := by simp; ring

/-- Ordinary width in the indicated coordinate-plane direction. -/
def pairWidth (B : Set (Fin n → ℝ)) (w : Fin n → ℝ) (i j : Fin n) : ℝ :=
  sSup (pairFunctional w i j '' B) - sInf (pairFunctional w i j '' B)

def choiceSign (s : Bool) : ℝ := if s then 1 else -1

private theorem abs_choiceSign (s : Bool) : |choiceSign s| = 1 := by
  cases s <;> norm_num [choiceSign]

private theorem choiceSign_not (s : Bool) : choiceSign (!s) = -choiceSign s := by
  cases s <;> norm_num [choiceSign]

abbrev WidthVertexIndex (n : ℕ) := Fin n × (Bool × (Fin n → Bool))

/-- A distance potential, with independent signs on zero-weight coordinates. -/
def widthVertex (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (a : Fin n)
    (t : WidthVertexIndex n) : Fin n → ℝ :=
  fun k => if 0 < w k then choiceSign t.2.1 * q t.1 k / (2 * w t.1)
    else choiceSign (t.2.2 k) * q a k / (2 * w a)

def widthVertices (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (a : Fin n) :
    Set (Fin n → ℝ) := Set.range (widthVertex q w a)

def widthPolytope (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (a : Fin n) :
    Set (Fin n → ℝ) := convexHull ℝ (widthVertices q w a)

def reverseWidthIndex (t : WidthVertexIndex n) : WidthVertexIndex n :=
  (t.1, !t.2.1, fun k => !(t.2.2 k))

theorem widthVertex_reverse (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) (t : WidthVertexIndex n) :
    widthVertex q w a (reverseWidthIndex t) = -widthVertex q w a t := by
  ext k
  simp only [widthVertex, reverseWidthIndex, choiceSign_not, Pi.neg_apply]
  split_ifs <;> ring

theorem widthVertices_finite (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : (widthVertices q w a).Finite := Set.finite_range _

theorem widthVertices_neg (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : -(widthVertices q w a) = widthVertices q w a := by
  ext x
  simp only [Set.mem_neg, widthVertices, Set.mem_range]
  constructor
  · rintro ⟨t, ht⟩
    refine ⟨reverseWidthIndex t, ?_⟩
    rw [widthVertex_reverse, ht, neg_neg]
  · rintro ⟨t, rfl⟩
    exact ⟨reverseWidthIndex t, widthVertex_reverse q w a t⟩

theorem widthPolytope_neg (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : -(widthPolytope q w a) = widthPolytope q w a := by
  rw [widthPolytope, ← convexHull_neg, widthVertices_neg]

theorem widthPolytope_nonempty (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : (widthPolytope q w a).Nonempty := by
  exact ⟨widthVertex q w a (a, true, fun _ => true),
    subset_convexHull ℝ _ ⟨(a, true, fun _ => true), rfl⟩⟩

theorem widthPolytope_compact (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : IsCompact (widthPolytope q w a) :=
  (widthVertices_finite q w a).isCompact_convexHull ℝ

theorem widthPolytope_convex (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : Convex ℝ (widthPolytope q w a) := convex_convexHull ℝ _

theorem zero_mem_widthPolytope (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) : (0 : Fin n → ℝ) ∈ widthPolytope q w a := by
  obtain ⟨x, hx⟩ := widthPolytope_nonempty q w a
  have hnx : -x ∈ widthPolytope q w a := by
    rw [← widthPolytope_neg q w a]
    simpa only [Set.mem_neg, neg_neg] using hx
  have h := widthPolytope_convex q w a hx hnx
    (show (0 : ℝ) ≤ 1 / 2 by norm_num) (show (0 : ℝ) ≤ 1 / 2 by norm_num)
    (by norm_num : (1 / 2 : ℝ) + 1 / 2 = 1)
  convert h using 1 <;> ext k <;> simp <;> ring

/-- The missing repeated-index cases of the paper's triangle inequalities. -/
theorem weighted_triangle_all_indices
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hsym : ∀ i j, q i j = q j i)
    (hdiag : ∀ i, q i i = 0) (hw : ∀ i, 0 ≤ w i)
    (htri : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j ≤ w j * q i k + w i * q j k) :
    ∀ i j k, w k * q i j ≤ w j * q i k + w i * q j k := by
  intro i j k
  by_cases hij : i = j
  · subst j
    rw [hdiag, mul_zero]
    exact add_nonneg (mul_nonneg (hw i) (hq i k)) (mul_nonneg (hw i) (hq i k))
  by_cases hik : i = k
  · subst k
    rw [hdiag, mul_zero, zero_add, hsym j i] <;> exact le_rfl
  by_cases hjk : j = k
  · subst k
    rw [hdiag, mul_zero, add_zero] <;> exact le_rfl
  exact htri i j k hij hik hjk

section TriangleConsequences

variable (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
variable (hq : ∀ i j, 0 ≤ q i j) (hsym : ∀ i j, q i j = q j i)
variable (hdiag : ∀ i, q i i = 0) (hw : ∀ i, 0 ≤ w i)
variable (htri : ∀ i j k, w k * q i j ≤ w j * q i k + w i * q j k)
variable (a : Fin n) (ha : 0 < w a)

include hq htri ha in
theorem zero_weight_pair (i j : Fin n) (hi : w i = 0) (hj : w j = 0) :
    q i j = 0 := by
  have h := htri i j a
  have hprod : w a * q i j ≤ 0 := by simpa [hi, hj] using h
  have hle : q i j ≤ 0 := nonpos_of_mul_nonpos_right hprod ha
  exact le_antisymm hle (hq i j)

include hsym htri in
theorem zero_weight_column (i j : Fin n) (hj : w j = 0) :
    w i * q a j = w a * q i j := by
  apply le_antisymm
  · simpa [hj, hsym j i] using htri a j i
  · simpa [hj, hsym j a] using htri i j a

include hq hsym hw htri in
theorem widthVertex_positive_pair_bound (t : WidthVertexIndex n) (i j : Fin n)
    (hi : 0 < w i) (hj : 0 < w j) :
    |pairFunctional w i j (widthVertex q w a t)| ≤ q i j / 2 := by
  by_cases ht : 0 < w t.1
  · have hp := htri t.1 j i
    have hm := htri t.1 i j
    rw [hsym j i] at hp
    have heq : pairFunctional w i j (widthVertex q w a t) =
        choiceSign t.2.1 * ((w i * q t.1 j - w j * q t.1 i) / (2 * w t.1)) := by
      simp only [pairFunctional, LinearMap.coe_mk, AddHom.coe_mk, widthVertex,
        if_pos hi, if_pos hj]
      ring
    rw [heq, abs_mul, abs_choiceSign, one_mul, abs_div,
      abs_of_pos (mul_pos (by norm_num) ht)]
    apply (div_le_iff₀ (mul_pos (by norm_num) ht)).2
    apply abs_le.mpr
    constructor <;> nlinarith
  · have ht0 : w t.1 = 0 := le_antisymm (le_of_not_gt ht) (hw t.1)
    simp only [pairFunctional, LinearMap.coe_mk, AddHom.coe_mk, widthVertex,
      if_pos hi, if_pos hj, ht0, mul_zero, div_zero, sub_zero, abs_zero]
    exact div_nonneg (hq i j) (by norm_num)

include hsym htri ha in
theorem widthVertex_positive_zero_value (t : WidthVertexIndex n) (i j : Fin n)
    (hi : 0 < w i) (hj : w j = 0) :
    pairFunctional w i j (widthVertex q w a t) = choiceSign (t.2.2 j) * q i j / 2 := by
  have hp := zero_weight_column q w hsym htri a i j hj
  have hjn : ¬0 < w j := by simp [hj]
  calc
    _ = choiceSign (t.2.2 j) * (w i * q a j) / (2 * w a) := by
      simp only [pairFunctional, LinearMap.coe_mk, AddHom.coe_mk, widthVertex,
        if_pos hi, if_neg hjn, hj, lt_self_iff_false, if_false, zero_mul, sub_zero]
      ring
    _ = choiceSign (t.2.2 j) * q i j / 2 := by
      rw [hp]
      field_simp [ha.ne'] <;> ring

include hq hsym hw htri ha in
theorem widthVertex_bound (t : WidthVertexIndex n) (i j : Fin n) :
    |pairFunctional w i j (widthVertex q w a t)| ≤ q i j / 2 := by
  by_cases hi : 0 < w i
  · by_cases hj : 0 < w j
    · exact widthVertex_positive_pair_bound q w hq hsym hw htri a t i j hi hj
    · have hj0 : w j = 0 := le_antisymm (le_of_not_gt hj) (hw j)
      rw [widthVertex_positive_zero_value q w hsym htri a ha t i j hi hj0]
      norm_num [abs_div, abs_mul, abs_choiceSign, abs_of_nonneg (hq i j)]
  · have hi0 : w i = 0 := le_antisymm (le_of_not_gt hi) (hw i)
    by_cases hj : 0 < w j
    · have heq : pairFunctional w i j (widthVertex q w a t) =
          -pairFunctional w j i (widthVertex q w a t) := by
        simp only [pairFunctional, LinearMap.coe_mk, AddHom.coe_mk]
        ring
      rw [heq, abs_neg, widthVertex_positive_zero_value q w hsym htri a ha t j i hj hi0]
      norm_num [abs_div, abs_mul, abs_choiceSign, abs_of_nonneg (hq j i), hsym i j]
    · have hj0 : w j = 0 := le_antisymm (le_of_not_gt hj) (hw j)
      rw [zero_weight_pair q w hq htri a ha i j hi0 hj0]
      simp [pairFunctional, hi0, hj0]

include hq hsym hdiag hw htri ha in
theorem widthVertex_attains (i j : Fin n) :
    ∃ t : WidthVertexIndex n, pairFunctional w i j (widthVertex q w a t) = q i j / 2 := by
  by_cases hi : 0 < w i
  · by_cases hj : 0 < w j
    · refine ⟨(i, true, fun _ => true), ?_⟩
      simp [pairFunctional, widthVertex, hi, hj, choiceSign, hdiag] <;>
        field_simp [hi.ne'] <;> ring
    · have hj0 : w j = 0 := le_antisymm (le_of_not_gt hj) (hw j)
      refine ⟨(a, true, fun _ => true), ?_⟩
      rw [widthVertex_positive_zero_value q w hsym htri a ha _ i j hi hj0]
      norm_num [choiceSign]
  · have hi0 : w i = 0 := le_antisymm (le_of_not_gt hi) (hw i)
    by_cases hj : 0 < w j
    · refine ⟨(a, false, fun _ => false), ?_⟩
      have h := widthVertex_positive_zero_value q w hsym htri a ha
        (a, false, fun _ => false) j i hj hi0
      simp [choiceSign] at h
      have heq : pairFunctional w i j (widthVertex q w a (a, false, fun _ => false)) =
          -pairFunctional w j i (widthVertex q w a (a, false, fun _ => false)) := by
        simp only [pairFunctional, LinearMap.coe_mk, AddHom.coe_mk]
        ring
      rw [heq, h, hsym j i]
      ring
    · have hj0 : w j = 0 := le_antisymm (le_of_not_gt hj) (hw j)
      refine ⟨(a, true, fun _ => true), ?_⟩
      rw [zero_weight_pair q w hq htri a ha i j hi0 hj0]
      simp [pairFunctional, hi0, hj0]

include hq hsym hw htri ha in
theorem widthPolytope_bound (i j : Fin n) {x : Fin n → ℝ}
    (hx : x ∈ widthPolytope q w a) : |pairFunctional w i j x| ≤ q i j / 2 := by
  have hsub : widthVertices q w a ⊆ pairFunctional w i j ⁻¹' Icc (-(q i j / 2)) (q i j / 2) := by
    rintro y ⟨t, rfl⟩
    exact abs_le.mp (widthVertex_bound q w hq hsym hw htri a ha t i j)
  have hh := convexHull_min hsub
    ((convex_Icc (-(q i j / 2)) (q i j / 2)).linear_preimage (pairFunctional w i j))
  exact abs_le.mpr (hh hx)

include hq hsym hdiag hw htri ha in
theorem widthPolytope_attains (i j : Fin n) :
    ∃ x ∈ widthPolytope q w a, pairFunctional w i j x = q i j / 2 := by
  obtain ⟨t, ht⟩ := widthVertex_attains q w hq hsym hdiag hw htri a ha i j
  exact ⟨widthVertex q w a t, subset_convexHull ℝ _ ⟨t, rfl⟩, ht⟩

include hq hsym hdiag hw htri ha in
theorem pairWidth_widthPolytope (i j : Fin n) :
    pairWidth (widthPolytope q w a) w i j = q i j := by
  obtain ⟨x, hx, hmax⟩ := widthPolytope_attains q w hq hsym hdiag hw htri a ha i j
  have hnx : -x ∈ widthPolytope q w a := by
    rw [← widthPolytope_neg q w a]
    simpa only [Set.mem_neg, neg_neg] using hx
  have hg : IsGreatest (pairFunctional w i j '' widthPolytope q w a) (q i j / 2) := by
    refine ⟨⟨x, hx, hmax⟩, ?_⟩
    rintro y ⟨z, hz, rfl⟩
    exact (abs_le.mp (widthPolytope_bound q w hq hsym hw htri a ha i j hz)).2
  have hl : IsLeast (pairFunctional w i j '' widthPolytope q w a) (-(q i j / 2)) := by
    refine ⟨⟨-x, hnx, ?_⟩, ?_⟩
    · rw [map_neg, hmax]
    · rintro y ⟨z, hz, rfl⟩
      exact (abs_le.mp (widthPolytope_bound q w hq hsym hw htri a ha i j hz)).1
  rw [pairWidth, hg.csSup_eq, hl.csInf_eq]
  ring

end TriangleConsequences

/-- The prescribed-width assertion of Proposition 3.2: an actual finite convex
hull with all prescribed widths.
There is no positivity restriction on the areas or on individual weights. -/
theorem exists_polytope_prescribed_widths
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hsym : ∀ i j, q i j = q j i)
    (hdiag : ∀ i, q i i = 0) (hw : ∀ i, 0 ≤ w i) (hwne : w ≠ 0)
    (htri : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j ≤ w j * q i k + w i * q j k) :
    ∃ S : Set (Fin n → ℝ), S.Finite ∧
      (convexHull ℝ S).Nonempty ∧ IsCompact (convexHull ℝ S) ∧
      Convex ℝ (convexHull ℝ S) ∧ -(convexHull ℝ S) = convexHull ℝ S ∧
      (0 : Fin n → ℝ) ∈ convexHull ℝ S ∧
      ∀ i j, pairWidth (convexHull ℝ S) w i j = q i j := by
  have hpos : ∃ a, 0 < w a := by
    by_contra! h
    apply hwne
    ext a
    exact le_antisymm (h a) (hw a)
  obtain ⟨a, ha⟩ := hpos
  have ht := weighted_triangle_all_indices q w hq hsym hdiag hw htri
  exact ⟨widthVertices q w a, widthVertices_finite q w a,
    widthPolytope_nonempty q w a, widthPolytope_compact q w a,
    widthPolytope_convex q w a, widthPolytope_neg q w a,
    zero_mem_widthPolytope q w a,
    pairWidth_widthPolytope q w hq hsym hdiag hw ht a ha⟩

end

end ProjectionAreaEscape

end EscapeConstructionSource

/-! ## EscapeMetricApproximation -/

section EscapeMetricApproximationSource

/-!
# Strict metric approximation of every weighted-triangle array

Coordinates whose weight vanishes are attached at large distance to the metric
on positive-weight coordinates. After multiplying by the new small weights,
all entries are polynomials in the perturbation parameter. Consequently the
strict realization construction applies to every point of the escape cone,
including its entire zero-weight boundary.
-/

open Set Filter
open scoped BigOperators Topology

namespace ProjectionAreaEscape

noncomputable section

variable {n : ℕ}

def baseMetric (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (i j : Fin n) : ℝ :=
  q i j / (w i * w j)

def metricCap (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) : ℝ :=
  (∑ i, ∑ j, baseMetric q w i j) + 1

def boundaryRadius (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a i : Fin n) : ℝ := if 0 < w i then 0 else q a i / w a

def positiveWeights (w : Fin n → ℝ) (ε : ℝ) (i : Fin n) : ℝ :=
  if 0 < w i then w i else ε

def extendedMetric (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) (C ε : ℝ) (i j : Fin n) : ℝ :=
  if i = j then 0 else
    if 0 < w i ∧ 0 < w j then baseMetric q w i j
    else C + (boundaryRadius q w a i + boundaryRadius q w a j) / ε

/-- The perturbation written with no singular denominator in its parameter. -/
def strictApproximation (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) (C ε : ℝ) (i j : Fin n) : ℝ :=
  if i = j then 0 else
    if 0 < w i then
      if 0 < w j then q i j + ε * w i * w j
      else w i * (q a j / w a + ε * C + ε ^ 2)
    else
      if 0 < w j then w j * (q a i / w a + ε * C + ε ^ 2)
      else ε * (q a i / w a + q a j / w a) + ε ^ 2 * C + ε ^ 3

theorem baseMetric_nonneg (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i) (i j : Fin n) :
    0 ≤ baseMetric q w i j := div_nonneg (hq i j) (mul_nonneg (hw i) (hw j))

theorem metricCap_pos (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i) : 0 < metricCap q w := by
  have hs : 0 ≤ ∑ i, ∑ j, baseMetric q w i j :=
    Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => baseMetric_nonneg q w hq hw i j
  dsimp [metricCap]
  linarith

theorem baseMetric_le_cap (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i) (i j : Fin n) :
    baseMetric q w i j ≤ metricCap q w := by
  have hrow : baseMetric q w i j ≤ ∑ k, baseMetric q w i k :=
    Finset.single_le_sum (fun k _ => baseMetric_nonneg q w hq hw i k) (Finset.mem_univ j)
  have hall : (∑ k, baseMetric q w i k) ≤ ∑ l, ∑ k, baseMetric q w l k :=
    Finset.single_le_sum
      (fun l _ => Finset.sum_nonneg fun k _ => baseMetric_nonneg q w hq hw l k)
      (Finset.mem_univ i)
  dsimp [metricCap]
  linarith

theorem baseMetric_triangle
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (htri : ∀ i j k, w k * q i j ≤ w j * q i k + w i * q j k)
    (i j k : Fin n) (hi : 0 < w i) (hj : 0 < w j) (hk : 0 < w k) :
    baseMetric q w i j ≤ baseMetric q w i k + baseMetric q w j k := by
  have hp : 0 < w i * w j * w k := mul_pos (mul_pos hi hj) hk
  have h := htri i j k
  apply (mul_le_mul_iff_right₀ hp).mp
  dsimp [baseMetric]
  field_simp [hi.ne', hj.ne', hk.ne']
  nlinarith

theorem boundaryRadius_nonneg
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (a : Fin n) (ha : 0 < w a) (i : Fin n) :
    0 ≤ boundaryRadius q w a i := by
  unfold boundaryRadius
  split_ifs
  · exact le_rfl
  · exact div_nonneg (hq a i) ha.le

theorem positiveWeights_pos (w : Fin n → ℝ) {ε : ℝ} (hε : 0 < ε) (i : Fin n) :
    0 < positiveWeights w ε i := by
  unfold positiveWeights
  split_ifs with h
  · exact h
  · exact hε

theorem extendedMetric_symm (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (a : Fin n) (C ε : ℝ) (i j : Fin n) :
    extendedMetric q w a C ε i j = extendedMetric q w a C ε j i := by
  simp only [extendedMetric, eq_comm, and_comm, baseMetric, hsym i j,
    mul_comm (w i) (w j), add_comm (boundaryRadius q w a i) (boundaryRadius q w a j)]

theorem extendedMetric_nonneg (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i) (a : Fin n) (ha : 0 < w a)
    {C ε : ℝ} (hC : 0 ≤ C) (hε : 0 < ε) (i j : Fin n) :
    0 ≤ extendedMetric q w a C ε i j := by
  unfold extendedMetric
  split_ifs
  · exact le_rfl
  · exact baseMetric_nonneg q w hq hw i j
  · exact add_nonneg hC (div_nonneg
      (add_nonneg (boundaryRadius_nonneg q w hq a ha i)
        (boundaryRadius_nonneg q w hq a ha j)) hε.le)

theorem extendedMetric_triangle
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i)
    (htri : ∀ i j k, w k * q i j ≤ w j * q i k + w i * q j k)
    (a : Fin n) (ha : 0 < w a) {C ε : ℝ}
    (hC : 0 ≤ C) (hcap : ∀ i j, baseMetric q w i j ≤ C) (hε : 0 < ε)
    (i j k : Fin n) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    extendedMetric q w a C ε i j ≤
      extendedMetric q w a C ε i k + extendedMetric q w a C ε j k := by
  have hri : 0 ≤ boundaryRadius q w a i / ε :=
    div_nonneg (boundaryRadius_nonneg q w hq a ha i) hε.le
  have hrj : 0 ≤ boundaryRadius q w a j / ε :=
    div_nonneg (boundaryRadius_nonneg q w hq a ha j) hε.le
  have hrk : 0 ≤ boundaryRadius q w a k / ε :=
    div_nonneg (boundaryRadius_nonneg q w hq a ha k) hε.le
  have hdij := baseMetric_nonneg q w hq hw i j
  have hdik := baseMetric_nonneg q w hq hw i k
  have hdjk := baseMetric_nonneg q w hq hw j k
  have hcij := hcap i j
  by_cases hi : 0 < w i <;> by_cases hj : 0 < w j <;> by_cases hk : 0 < w k
  · simpa [extendedMetric, hij, hik, hjk, hi, hj, hk] using
      baseMetric_triangle q w htri i j k hi hj hk
  all_goals
    simp only [extendedMetric, if_neg hij, if_neg hik, if_neg hjk]
    simp [hi, hj, hk, boundaryRadius, add_div] at hri hrj hrk ⊢
    linarith

/-- For positive parameters the polynomial array is exactly a diagonally
weighted strict metric. -/
theorem strictApproximation_metric_formula
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (a : Fin n) (C : ℝ) {ε : ℝ} (hε : 0 < ε)
    (i j : Fin n) (hij : i ≠ j) :
    strictApproximation q w a C ε i j =
      positiveWeights w ε i * positiveWeights w ε j *
        (extendedMetric q w a C ε i j + ε) := by
  by_cases hi : 0 < w i <;> by_cases hj : 0 < w j
  · simp [strictApproximation, extendedMetric, positiveWeights, hij, hi, hj, baseMetric] <;>
      field_simp [hi.ne', hj.ne'] <;> ring
  all_goals
    by_cases ha : w a = 0
  all_goals
    simp [strictApproximation, extendedMetric, positiveWeights, boundaryRadius,
      hij, hi, hj, ha] <;> field_simp [hε.ne', ha] <;> ring

@[simp] theorem strictApproximation_diag
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (a : Fin n) (C ε : ℝ) (i : Fin n) :
    strictApproximation q w a C ε i i = 0 := by simp [strictApproximation]

theorem strictApproximation_symm
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (a : Fin n) (C : ℝ)
    {ε : ℝ} (hε : 0 < ε) (i j : Fin n) :
    strictApproximation q w a C ε i j = strictApproximation q w a C ε j i := by
  by_cases hij : i = j
  · subst j
    rfl
  rw [strictApproximation_metric_formula q w a C hε i j hij,
    strictApproximation_metric_formula q w a C hε j i (Ne.symm hij),
    extendedMetric_symm q w hsym a C ε i j]
  ring

theorem strictApproximation_pos
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i) (a : Fin n) (ha : 0 < w a)
    {C ε : ℝ} (hC : 0 ≤ C) (hε : 0 < ε) (i j : Fin n) (hij : i ≠ j) :
    0 < strictApproximation q w a C ε i j := by
  rw [strictApproximation_metric_formula q w a C hε i j hij]
  exact mul_pos (mul_pos (positiveWeights_pos w hε i) (positiveWeights_pos w hε j))
    (add_pos_of_nonneg_of_pos (extendedMetric_nonneg q w hq hw a ha hC hε i j) hε)

theorem strictApproximation_strict
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 ≤ w i)
    (htri : ∀ i j k, w k * q i j ≤ w j * q i k + w i * q j k)
    (a : Fin n) (ha : 0 < w a) {C ε : ℝ}
    (hC : 0 ≤ C) (hcap : ∀ i j, baseMetric q w i j ≤ C) (hε : 0 < ε)
    (i j k : Fin n) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    positiveWeights w ε k * strictApproximation q w a C ε i j <
      positiveWeights w ε j * strictApproximation q w a C ε i k +
      positiveWeights w ε i * strictApproximation q w a C ε j k := by
  have ht := extendedMetric_triangle q w hq hw htri a ha hC hcap hε i j k hij hik hjk
  have hstrict : extendedMetric q w a C ε i j + ε <
      (extendedMetric q w a C ε i k + ε) + (extendedMetric q w a C ε j k + ε) := by
    linarith
  have hp : 0 < positiveWeights w ε i * positiveWeights w ε j * positiveWeights w ε k :=
    mul_pos (mul_pos (positiveWeights_pos w hε i) (positiveWeights_pos w hε j))
      (positiveWeights_pos w hε k)
  have hmul := mul_lt_mul_of_pos_left hstrict hp
  rw [strictApproximation_metric_formula q w a C hε i j hij,
    strictApproximation_metric_formula q w a C hε i k hik,
    strictApproximation_metric_formula q w a C hε j k hjk]
  convert hmul using 1 <;> ring

theorem continuous_strictApproximation
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (a : Fin n) (C : ℝ) :
    Continuous (fun ε => strictApproximation q w a C ε) := by
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  by_cases hij : i = j <;> by_cases hi : 0 < w i <;> by_cases hj : 0 < w j <;>
    simp [strictApproximation, hij, hi, hj] <;> fun_prop

theorem strictApproximation_zero
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hsym : ∀ i j, q i j = q j i)
    (hdiag : ∀ i, q i i = 0) (hw : ∀ i, 0 ≤ w i)
    (htri : ∀ i j k, w k * q i j ≤ w j * q i k + w i * q j k)
    (a : Fin n) (ha : 0 < w a) (C : ℝ) : strictApproximation q w a C 0 = q := by
  funext i j
  by_cases hij : i = j
  · subst j
    simp [hdiag]
  by_cases hi : 0 < w i
  · by_cases hj : 0 < w j
    · simp [strictApproximation, hij, hi, hj]
    · have hj0 : w j = 0 := le_antisymm (le_of_not_gt hj) (hw j)
      have hp := zero_weight_column q w hsym htri a i j hj0
      simp [strictApproximation, hij, hi, hj]
      field_simp [ha.ne']
      nlinarith [hp]
  · have hi0 : w i = 0 := le_antisymm (le_of_not_gt hi) (hw i)
    by_cases hj : 0 < w j
    · have hp := zero_weight_column q w hsym htri a j i hi0
      rw [hsym j i] at hp
      simp [strictApproximation, hij, hi, hj]
      field_simp [ha.ne']
      nlinarith [hp]
    · have hj0 : w j = 0 := le_antisymm (le_of_not_gt hj) (hw j)
      have hz := zero_weight_pair q w hq htri a ha i j hi0 hj0
      simp [strictApproximation, hij, hi, hj, hz]

/-- Every weighted-triangle array is the limit of positive strict arrays,
with positive weights. No interior assumption or positive-entry restriction
is placed on the original array. -/
theorem exists_strict_weighted_approximation
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hsym : ∀ i j, q i j = q j i)
    (hdiag : ∀ i, q i i = 0) (hw : ∀ i, 0 ≤ w i) (hwne : w ≠ 0)
    (htri : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j ≤ w j * q i k + w i * q j k) :
    ∃ Q : ℕ → Fin n → Fin n → ℝ, ∃ W : ℕ → Fin n → ℝ,
      Tendsto Q atTop (𝓝 q) ∧
      (∀ m i j, Q m i j = Q m j i) ∧ (∀ m i, Q m i i = 0) ∧
      (∀ m i j, i ≠ j → 0 < Q m i j) ∧ (∀ m i, 0 < W m i) ∧
      ∀ m i j k, i ≠ j → i ≠ k → j ≠ k →
        W m k * Q m i j < W m j * Q m i k + W m i * Q m j k := by
  have hpos : ∃ a, 0 < w a := by
    by_contra! h
    apply hwne
    ext i
    exact le_antisymm (h i) (hw i)
  obtain ⟨a, ha⟩ := hpos
  have ht := weighted_triangle_all_indices q w hq hsym hdiag hw htri
  let ε : ℕ → ℝ := fun m => 1 / ((m : ℝ) + 1)
  have hε : ∀ m, 0 < ε m := by intro m; dsimp [ε]; positivity
  let C : ℝ := metricCap q w
  have hC : 0 ≤ C := (metricCap_pos q w hq hw).le
  have hcap : ∀ i j, baseMetric q w i j ≤ C := baseMetric_le_cap q w hq hw
  refine ⟨fun m => strictApproximation q w a C (ε m), fun m => positiveWeights w (ε m),
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have hlim : Tendsto ε atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
    have hcont := (continuous_strictApproximation q w a C).continuousAt.tendsto.comp hlim
    simpa only [Function.comp_def,
      strictApproximation_zero q w hq hsym hdiag hw ht a ha C] using hcont
  · intro m i j
    exact strictApproximation_symm q w hsym a C (hε m) i j
  · intro m i
    exact strictApproximation_diag q w a C (ε m) i
  · intro m i j hij
    exact strictApproximation_pos q w hq hw a ha hC (hε m) i j hij
  · intro m i
    exact positiveWeights_pos w (hε m) i
  · intro m i j k hij hik hjk
    exact strictApproximation_strict q w hq hw ht a ha hC hcap (hε m) i j k hij hik hjk

end

end ProjectionAreaEscape

end EscapeMetricApproximationSource

/-! ## EscapeRealization -/

section EscapeRealizationSource

/-!
# Every weighted-triangle array is an actual escaping limit

The algebraic approximations converge entry by entry, including zero-weight
coordinates. The strict realization theorem gives one centrally symmetric
finite polytope for each approximation, with Euclidean diameter greater than
its sequence index. This proves the sufficiency direction in Theorem 1.2
without a limiting-prism formula or any unproved mixed-volume assertion.
-/

open Set MeasureTheory Filter
open scoped Pointwise Topology

namespace ProjectionAreaEscape

noncomputable section

open ProjectionAreaStrict ProjectionAreaTopology ProjectionAreaTransforms
open ProjectionAreaBoundaryPolytope

variable {n : ℕ}

/-- The same concrete set, transported from coordinate notation to the
Euclidean normed space used by the canonical realization map. -/
def euclideanBodyOfSet (B : Set (Fin n → ℝ)) (hc : IsCompact B)
    (hv : Convex ℝ B) (hne : B.Nonempty) : CoordinateBody n where
  carrier := asEuclidean n '' B
  convex' := hv.linear_image (asEuclidean n).toLinearMap
  isCompact' := hc.image (asEuclidean n).continuous
  nonempty' := hne.image (asEuclidean n)

theorem coordinateAreas_euclideanBodyOfSet
    (B : Set (Fin n → ℝ)) (hc : IsCompact B) (hv : Convex ℝ B) (hne : B.Nonempty) :
    coordinateAreas (euclideanBodyOfSet B hc hv hne) =
      fun i j => (volume : Measure V2).real (projectN i j '' B) := by
  funext i j
  change (volume : Measure V2).real
    (coordinateProjection i j '' (asEuclidean n '' B)) = _
  rw [Set.image_image]
  have hf : coordinateProjection i j ∘ asEuclidean n = fun x => projectN i j x := by
    funext x
    ext k
    fin_cases k <;> rfl
  change (volume : Measure V2).real
    ((coordinateProjection i j ∘ asEuclidean n) '' B) = _
  rw [hf]

theorem diameter_euclideanBodyOfSet
    (B : Set (Fin n → ℝ)) (hc : IsCompact B) (hv : Convex ℝ B) (hne : B.Nonempty) :
    Metric.diam (euclideanBodyOfSet B hc hv hne : Set (CoordinateSpace n)) =
      euclideanDiameter B := rfl

/-- A centrally symmetric polytope means an actual finite convex hull,
with symmetry about the origin. -/
def IsSymmetricPolytope (K : CoordinateBody n) : Prop :=
  -(K : Set (CoordinateSpace n)) = (K : Set (CoordinateSpace n)) ∧
    ∃ S : Set (CoordinateSpace n), S.Finite ∧
      (K : Set (CoordinateSpace n)) = convexHull ℝ S

theorem exists_symmetric_polytope_zero_interior (n : ℕ) :
    ∃ C : CoordinateBody n, IsSymmetricPolytope C ∧
      (0 : CoordinateSpace n) ∈ interior (C : Set (CoordinateSpace n)) := by
  classical
  obtain ⟨b, hb, _⟩ := exists_mem_interior_convexHull_affineBasis
    (E := CoordinateSpace n) (s := Set.univ) (x := 0) Filter.univ_mem
  let S : Set (CoordinateSpace n) := Set.range b ∪ -(Set.range b)
  have hS : S.Finite := (Set.finite_range b).union (Set.finite_range b).neg
  have hSneg : -S = S := by
    ext x
    simp [S, or_comm]
  have hzero : (0 : CoordinateSpace n) ∈ interior (convexHull ℝ S) :=
    interior_mono (convexHull_mono Set.subset_union_left) hb
  let C : CoordinateBody n :=
    ⟨convexHull ℝ S, convex_convexHull ℝ S, hS.isCompact_convexHull ℝ,
      ⟨0, interior_subset hzero⟩⟩
  refine ⟨C, ⟨?_, S, hS, rfl⟩, hzero⟩
  change -(convexHull ℝ S) = convexHull ℝ S
  rw [← convexHull_neg, hSneg]

theorem IsSymmetricPolytope.add_smul {K C : CoordinateBody n}
    (hK : IsSymmetricPolytope K) (hC : IsSymmetricPolytope C) (r : ℝ) :
    IsSymmetricPolytope (K + r • C) := by
  rcases hK with ⟨hKneg, S, hS, hKS⟩
  rcases hC with ⟨hCneg, T, hT, hCT⟩
  have hminus : ∀ x ∈ (K + r • C : Set (CoordinateSpace n)),
      -x ∈ (K + r • C : Set (CoordinateSpace n)) := by
    rintro x ⟨y, hy, z, ⟨c, hc, rfl⟩, rfl⟩
    refine ⟨-y, ?_, r • (-c), ⟨-c, ?_, rfl⟩, ?_⟩
    · rw [← hKneg]
      simpa only [Set.mem_neg, neg_neg] using hy
    · rw [← hCneg]
      simpa only [Set.mem_neg, neg_neg] using hc
    · simp only [smul_neg, neg_add]
  refine ⟨?_, S + r • T, hS.add hT.smul_set, ?_⟩
  · rw [ConvexBody.coe_add, ConvexBody.coe_smul]
    ext x
    simp only [Set.mem_neg]
    constructor
    · intro hx
      simpa only [neg_neg] using hminus (-x) hx
    · exact hminus x
  · rw [ConvexBody.coe_add, ConvexBody.coe_smul, hKS, hCT,
      convexHull_add, convexHull_smul]

theorem subset_add_smul_of_zero_mem (K C : CoordinateBody n) (r : ℝ)
    (hzero : (0 : CoordinateSpace n) ∈ C) :
    (K : Set (CoordinateSpace n)) ⊆ (K + r • C : Set (CoordinateSpace n)) := by
  intro x hx
  exact ⟨x, hx, 0, ⟨0, hzero, smul_zero r⟩, add_zero x⟩

theorem interior_add_smul_nonempty (K C : CoordinateBody n) {r : ℝ} (hr : 0 < r)
    (hzero : (0 : CoordinateSpace n) ∈ interior (C : Set (CoordinateSpace n))) :
    (interior (K + r • C : Set (CoordinateSpace n))).Nonempty := by
  obtain ⟨x, hx⟩ := K.nonempty
  have hz : (0 : CoordinateSpace n) ∈ interior (r • (C : Set (CoordinateSpace n))) := by
    rw [interior_smul₀ hr.ne']
    exact ⟨0, hzero, smul_zero r⟩
  refine ⟨x, ?_⟩
  exact subset_interior_add_right ⟨x, hx, 0, hz, add_zero x⟩

section AreaArrayMetric

-- Matrix has no default metric: use the usual finite-function sup metric
-- only for the two approximation lemmas below. Its product topology is
-- definitionally the existing topology on AreaArray, so this adds no
-- hypothesis and does not change any of the area-limit statements.
local instance areaArrayMetricSpace : MetricSpace (AreaArray n) :=
  inferInstanceAs (MetricSpace (Fin n → Fin n → ℝ))

/-- Each body can be thickened by a positive amount while changing its
actual projection-area array by less than any prescribed positive tolerance. -/
theorem exists_small_polytope_thickening (K C : CoordinateBody n) {ε : ℝ}
    (hε : 0 < ε) :
    ∃ r : ℝ, 0 < r ∧ r ≤ ε ∧
      dist (coordinateAreas (K + r • C)) (coordinateAreas K) < ε := by
  have hcontinuous : Continuous (fun r : ℝ => coordinateAreas (K + r • C)) :=
    (continuous_coordinateAreas n).comp (by fun_prop)
  obtain ⟨δ, hδ, hball⟩ := Metric.continuousAt_iff.mp
    (hcontinuous.continuousAt (x := 0)) ε hε
  have hzero : (0 : ℝ) • C = 0 := by
    apply ConvexBody.ext
    exact Set.zero_smul_set C.nonempty
  let r := min (δ / 2) (ε / 2)
  have hr : 0 < r := lt_min (half_pos hδ) (half_pos hε)
  have hrδ : r < δ := (min_le_left _ _).trans_lt (by linarith)
  have hrε : r ≤ ε := (min_le_right _ _).trans (by linarith)
  refine ⟨r, hr, hrε, ?_⟩
  have hdist : dist r (0 : ℝ) < δ := by
    simpa only [Real.dist_eq, sub_zero, abs_of_pos hr] using hrδ
  simpa only [hzero, add_zero] using hball hdist

/-- Small positive Minkowski thickenings preserve area limits and escape in
diameter, and make every polytope full dimensional. -/
theorem full_dimensional_symmetric_sequence
    (K : ℕ → CoordinateBody n) (q : AreaArray n)
    (hK : ∀ m, IsSymmetricPolytope (K m))
    (harea : Tendsto (fun m => coordinateAreas (K m)) atTop (𝓝 q))
    (hdiam : Tendsto (fun m => Metric.diam (K m : Set (CoordinateSpace n))) atTop atTop) :
    ∃ L : ℕ → CoordinateBody n,
      Tendsto (fun m => coordinateAreas (L m)) atTop (𝓝 q) ∧
      Tendsto (fun m => Metric.diam (L m : Set (CoordinateSpace n))) atTop atTop ∧
      ∀ m, IsSymmetricPolytope (L m) ∧
        (interior (L m : Set (CoordinateSpace n))).Nonempty := by
  obtain ⟨C, hC, hCzero⟩ := exists_symmetric_polytope_zero_interior n
  have hε (m : ℕ) : (0 : ℝ) < 1 / ((m : ℝ) + 1) := by positivity
  choose r hr hrbound hdist using fun m => exists_small_polytope_thickening (K m) C (hε m)
  let L : ℕ → CoordinateBody n := fun m => K m + r m • C
  refine ⟨L, ?_, ?_, fun m => ⟨(hK m).add_smul hC (r m),
    interior_add_smul_nonempty (K m) C (hr m) hCzero⟩⟩
  · apply harea.congr_dist
    apply squeeze_zero (fun _ => dist_nonneg)
      (fun m => (show dist (coordinateAreas (K m)) (coordinateAreas (L m)) <
        1 / ((m : ℝ) + 1) by simpa only [L, dist_comm] using hdist m).le)
    exact tendsto_one_div_add_atTop_nhds_zero_nat
  · apply tendsto_atTop_mono _ hdiam
    intro m
    exact Metric.diam_mono
      (subset_add_smul_of_zero_mem (K m) C (r m) (interior_subset hCzero))
      (L m).isBounded

end AreaArrayMetric

/-- Every array in the escape cone is a limit of genuine centrally symmetric
finite convex hulls whose Euclidean diameters tend to infinity. -/
theorem escapeCone_exists_symmetric_polytope_sequence (n : ℕ)
    (q : AreaArray n) (hqcone : q ∈ EscapeCone n) :
    ∃ K : ℕ → CoordinateBody n,
      Tendsto (fun m => coordinateAreas (K m)) atTop (𝓝 q) ∧
      Tendsto (fun m => Metric.diam (K m : Set (CoordinateSpace n))) atTop atTop ∧
      ∀ m, IsSymmetricPolytope (K m) := by
  rcases hqcone with ⟨hdiag, hsym, hq, w, hw, hwne, htri⟩
  have hn : 0 < n := by
    by_contra h
    have hn0 : n = 0 := Nat.eq_zero_of_not_pos h
    subst n
    apply hwne
    ext i
    exact Fin.elim0 i
  obtain ⟨Q, W, hlim, hQsym, hQdiag, hQpos, hWpos, hstrict⟩ :=
    exists_strict_weighted_approximation q w hq hsym hdiag hw hwne htri
  have hex (m : ℕ) := strict_weighted_realization hn (Q m) (W m)
    (hQsym m) (hQdiag m) (hQpos m) (hWpos m) (hstrict m) (m : ℝ)
  choose S hcard hcompact hconvex hnonempty hcentral hareas hdiam using hex
  let K : ℕ → CoordinateBody n := fun m => euclideanBodyOfSet
    (convexHull ℝ (S m : Set (Fin n → ℝ))) (hcompact m) (hconvex m) (hnonempty m)
  refine ⟨K, ?_, ?_, ?_⟩
  · have heq : (fun m => coordinateAreas (K m)) = Q := by
      funext m
      rw [show K m = euclideanBodyOfSet
        (convexHull ℝ (S m : Set (Fin n → ℝ)))
        (hcompact m) (hconvex m) (hnonempty m) from rfl,
        coordinateAreas_euclideanBodyOfSet]
      funext i j
      exact hareas m i j
    rw [heq]
    exact hlim
  · change Tendsto
      (fun m => euclideanDiameter (convexHull ℝ (S m : Set (Fin n → ℝ)))) atTop atTop
    exact tendsto_atTop_mono (fun m => (hdiam m).le) tendsto_natCast_atTop_atTop
  · intro m
    refine ⟨?_, (asEuclidean n) '' (S m : Set (Fin n → ℝ)),
      (S m).finite_toSet.image _, ?_⟩
    · have hminus : ∀ x ∈ (K m : Set (CoordinateSpace n)),
          -x ∈ (K m : Set (CoordinateSpace n)) := by
        rintro x ⟨y, hy, rfl⟩
        refine ⟨-y, ?_, (asEuclidean n).map_neg y⟩
        rw [← hcentral m]
        simpa only [Set.mem_neg, neg_neg] using hy
      ext x
      simp only [Set.mem_neg]
      constructor
      · intro hx
        simpa only [neg_neg] using hminus (-x) hx
      · exact hminus x
    · change (asEuclidean n) '' convexHull ℝ (S m : Set (Fin n → ℝ)) =
        convexHull ℝ ((asEuclidean n) '' (S m : Set (Fin n → ℝ)))
      exact (asEuclidean n).toLinearMap.image_convexHull _

/-- The complete constructive assertion in Theorem 3.3: approximating bodies
are full-dimensional centrally symmetric polytopes in every dimension. -/
theorem escapeCone_exists_full_dimensional_symmetric_sequence (n : ℕ)
    (q : AreaArray n) (hq : q ∈ EscapeCone n) :
    ∃ K : ℕ → CoordinateBody n,
      Tendsto (fun m => coordinateAreas (K m)) atTop (𝓝 q) ∧
      Tendsto (fun m => Metric.diam (K m : Set (CoordinateSpace n))) atTop atTop ∧
      ∀ m, IsSymmetricPolytope (K m) ∧
        (interior (K m : Set (CoordinateSpace n))).Nonempty := by
  obtain ⟨K, harea, hdiam, hK⟩ := escapeCone_exists_symmetric_polytope_sequence n q hq
  exact full_dimensional_symmetric_sequence K q hK harea hdiam

/-- The sufficiency direction of Theorem 1.2, for all ambient dimensions and
all nonnegative arrays, including zero entries and zero witness weights. -/
theorem escapeCone_subset_divergingDiameterLimits (n : ℕ) :
    EscapeCone n ⊆ divergingDiameterLimits n := by
  intro q hq
  obtain ⟨K, harea, hdiam, _⟩ :=
    escapeCone_exists_full_dimensional_symmetric_sequence n q hq
  exact ⟨K, harea, hdiam⟩

theorem escapeCone_subset_closure_realizationLocus (n : ℕ) :
    EscapeCone n ⊆ closure (realizationLocus n) := by
  intro q hq
  exact escapingLimits_subset_closure_range coordinateAreas
    (escapeCone_subset_divergingDiameterLimits n hq)

end

