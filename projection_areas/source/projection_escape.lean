section Source_StrictZeroExtension

@[expose] public section

/-!
# The strict sentence of Theorem 1.2, including zero entries

Theorem 4.1 explicitly assumes positive off-diagonal data. The introductory
strict assertion of Theorem 1.2 can omit that hypothesis: strict weighted
triangles force either positive off-diagonal data or the zero matrix. The
zero alternative can occur only when there are at most two labels and is
realized by an arbitrarily long centrally symmetric segment. The proof
below reuses the existing finite-hull construction with every transverse
vertex zero, retaining the same stated vertex bound.
-/

noncomputable section

open Set MeasureTheory
open scoped Pointwise
open ProjectionAreaBoundaryPolytope ProjectionAreaTransforms

namespace ProjectionAreaStrict

/-- With zero distances, all coordinate projections of the finite-hull
construction have zero ordinary planar area. -/
theorem zero_metricPolytope_areas {n : ℕ} (T : ℝ) (i j : Fin n) :
    (volume : Measure V2).real
      (projectN i j '' metricPolytope (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T) = 0 := by
  let f : (Fin n → ℝ) →ₗ[ℝ] ℝ :=
    (LinearMap.proj i : (Fin n → ℝ) →ₗ[ℝ] ℝ) -
      (LinearMap.proj j : (Fin n → ℝ) →ₗ[ℝ] ℝ)
  have hvertices :
      (metricVertices (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T : Set (Fin n → ℝ)) ⊆
        (f.ker : Set (Fin n → ℝ)) := by
    intro x hx
    change f x = 0
    change x ∈ metricVertices (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T at hx
    rw [mem_metricVertices] at hx
    rcases hx with rfl | rfl | ⟨r, rfl⟩ | ⟨r, rfl⟩ <;>
      simp [f, transverse, potential]
  have hbody :
      metricPolytope (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T ⊆
        (f.ker : Set (Fin n → ℝ)) :=
    convexHull_min hvertices f.ker.convex
  have hcoordinate : ∀ x ∈ metricPolytope (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T,
      x i = x j := by
    intro x hx
    have hzero := hbody hx
    change x i - x j = 0 at hzero
    exact sub_eq_zero.mp hzero
  have hprojection :
      projectN i j '' metricPolytope (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T =
        projectN i i '' metricPolytope (fun _ _ : Fin n => (0 : ℝ)) (fun _ => 1) T := by
    apply Set.image_congr
    intro x hx
    ext r
    fin_cases r
    · rfl
    · exact (hcoordinate x hx).symm
  rw [hprojection, same_coordinate_area_zero]

/-- The zero matrix has centrally symmetric finite-hull realizations with
the stated vertex bound and arbitrarily large Euclidean diameter. -/
theorem zero_array_long_symmetric_realization {n : ℕ} (hn : 0 < n) (R : ℝ) :
    ∃ S : Finset (Fin n → ℝ), S.card ≤ n * (n - 1) + 2 ∧
      let K := convexHull ℝ (S : Set (Fin n → ℝ))
      IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧ -K = K ∧
      (∀ i j, (volume : Measure V2).real (projectN i j '' K) = 0) ∧
      R < euclideanDiameter K := by
  let d : Fin n → Fin n → ℝ := fun _ _ => 0
  let w : Fin n → ℝ := fun _ => 1
  let T : ℝ := |R| + 1
  have hT : 0 < T := by dsimp [T]; positivity
  have hR : R < 2 * T * w ⟨0, hn⟩ := by
    dsimp [T, w]
    linarith [le_abs_self R, abs_nonneg R]
  refine ⟨metricVertices d w T, metricVertices_card d w T,
    metricPolytope_compact d w T, metricPolytope_convex d w T,
    ⟨T • w, metricPolytope_axis_pos d w T⟩,
    metricPolytope_centrally_symmetric d w T, ?_, ?_⟩
  · exact zero_metricPolytope_areas T
  · exact hR.trans_le
      (metricPolytope_diameter_ge_coordinate d w T hT.le ⟨0, hn⟩ zero_le_one)

/-- A zero off-diagonal entry in strictly feasible nonnegative data forces
the entire matrix to vanish. In dimensions at least three it cannot occur. -/
theorem positive_or_zero_of_strict_weighted_triangles {n : ℕ}
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hnonneg : ∀ i j, 0 ≤ q i j)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j < w j * q i k + w i * q j k) :
    (∀ i j, i ≠ j → 0 < q i j) ∨ q = 0 := by
  classical
  by_cases hpositive : ∀ i j, i ≠ j → 0 < q i j
  · exact Or.inl hpositive
  · right
    push_neg at hpositive
    obtain ⟨i, j, hij, hnonpos⟩ := hpositive
    have hzero : q i j = 0 := le_antisymm hnonpos (hnonneg i j)
    have hzero' : q j i = 0 := (hsym j i).trans hzero
    have hlabels (k : Fin n) : k = i ∨ k = j := by
      by_cases hki : k = i
      · exact Or.inl hki
      by_cases hkj : k = j
      · exact Or.inr hkj
      have h₁ := hstrict i k j (Ne.symm hki) hij hkj
      have h₂ := hstrict j k i (Ne.symm hkj) (Ne.symm hij) hki
      rw [hzero, mul_zero, zero_add, hsym k j] at h₁
      rw [hzero', mul_zero, zero_add, hsym k i] at h₂
      exact (lt_asymm h₁ h₂).elim
    ext k l
    rcases hlabels k with hk | hk <;> rcases hlabels l with hl | hl <;>
      simp only [hk, hl, hdiag, hzero, hzero', Pi.zero_apply]

/-- The strict assertion in Theorem 1.2 for every positive dimension,
without adding a separate positive-area hypothesis. This includes the
vacuous triangle inequalities in dimensions one and two. -/
theorem strict_nonnegative_weighted_realization {n : ℕ} (hn : 0 < n)
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hnonneg : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j < w j * q i k + w i * q j k)
    (R : ℝ) :
    ∃ S : Finset (Fin n → ℝ), S.card ≤ n * (n - 1) + 2 ∧
      let K := convexHull ℝ (S : Set (Fin n → ℝ))
      IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧ -K = K ∧
      (∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j) ∧
      R < euclideanDiameter K := by
  rcases positive_or_zero_of_strict_weighted_triangles q w hsym hdiag hnonneg hstrict with hp | hq
  · exact strict_weighted_realization hn q w hsym hdiag hp hw hstrict R
  · simpa only [hq, Pi.zero_apply] using zero_array_long_symmetric_realization hn R

/-- The complete introductory strict assertion, with the number of actual
extreme points as well as the finite generating-set bound made explicit. -/
theorem strict_nonnegative_weighted_realization_with_vertex_bound {n : ℕ} (hn : 0 < n)
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hnonneg : ∀ i j, 0 ≤ q i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j < w j * q i k + w i * q j k)
    (R : ℝ) :
    ∃ S : Finset (Fin n → ℝ), S.card ≤ n * (n - 1) + 2 ∧
      let K := convexHull ℝ (S : Set (Fin n → ℝ))
      IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧ -K = K ∧
      (∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j) ∧
      R < euclideanDiameter K ∧
      (K.extremePoints ℝ).Finite ∧ (K.extremePoints ℝ).ncard ≤ n * (n - 1) + 2 := by
  obtain ⟨S, hcard, hcompact, hconvex, hnonempty, hsymm, harea, hdiam⟩ :=
    strict_nonnegative_weighted_realization hn q w hsym hdiag hnonneg hw hstrict R
  obtain ⟨hfinite, hvertices⟩ := convexHull_vertices_card_le S
  exact ⟨S, hcard, hcompact, hconvex, hnonempty, hsymm, harea, hdiam,
    hfinite, hvertices.trans hcard⟩

