section Source_EscapePrisms

@[expose] public section

/-!
# Exact prisms for Proposition 3.2

The arbitrary-direction planar extrusion theorem from the checked mixed-volume
basis gives equation (4) of the paper, with ordinary Lebesgue area. The final
result supplies the prescribed-width polytope and its exact prism realizations
for every positive length, including zero weights and zero projection areas.
This chapter is supplementary to the independent strict-approximation proof
of the escape theorem.
-/

open Set MeasureTheory
open scoped Pointwise

namespace ProjectionAreaEscape

noncomputable section

open ProjectionAreaStrict ProjectionAreaTransforms ProjectionAreaTopology
open ProjectionAreaBoundaryPolytope

namespace ExactPrism

abbrev Plane := ℝ × ℝ

def pairProjection {n : ℕ} (i j : Fin n) : (Fin n → ℝ) →ₗ[ℝ] Plane :=
  (LinearMap.proj i).prod (LinearMap.proj j)

theorem pairProjection_area {n : ℕ} (i j : Fin n) (B : Set (Fin n → ℝ)) :
    (volume : Measure Plane).real (pairProjection i j '' B) =
      (volume : Measure V2).real (projectN i j '' B) := by
  have h := (volume_preserving_finTwoArrow ℝ).measure_preimage_equiv
    (MeasurableEquiv.finTwoArrow '' (projectN i j '' B))
  rw [Set.preimage_image_eq _ MeasurableEquiv.finTwoArrow.injective] at h
  have heq : MeasurableEquiv.finTwoArrow '' (projectN i j '' B) =
      pairProjection i j '' B := by
    rw [Set.image_image]
    rfl
  rw [heq] at h
  exact congrArg ENNReal.toReal h.symm

def lineDirection {n : ℕ} (v : Fin n → ℝ) : ℝ →ₗ[ℝ] (Fin n → ℝ) where
  toFun s := s • v
  map_add' s t := add_smul s t v
  map_smul' s t := by simp only [smul_eq_mul, mul_smul, RingHom.id_apply]

/-- A segment whose endpoints differ by exactly `v`. -/
def centeredLine {n : ℕ} (v : Fin n → ℝ) : Set (Fin n → ℝ) :=
  lineDirection v '' Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ)

theorem centeredLine_compact {n : ℕ} (v : Fin n → ℝ) :
    IsCompact (centeredLine v) :=
  isCompact_Icc.image (lineDirection v).continuous_of_finiteDimensional

theorem centeredLine_convex {n : ℕ} (v : Fin n → ℝ) :
    Convex ℝ (centeredLine v) :=
  (convex_Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ) :
    Convex ℝ (Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ))).linear_image
    (lineDirection v)

theorem zero_mem_centeredLine {n : ℕ} (v : Fin n → ℝ) :
    (0 : Fin n → ℝ) ∈ centeredLine v := by
  refine ⟨0, ?_, ?_⟩
  · norm_num
  · simp [lineDirection]

theorem pairProjection_centeredLine {n : ℕ} (i j : Fin n) (v : Fin n → ℝ) :
    pairProjection i j '' centeredLine v =
      VolumePolynomials.PlanarExtrusion.centeredSegment (pairProjection i j v) := by
  unfold centeredLine VolumePolynomials.PlanarExtrusion.centeredSegment
  rw [Set.image_image]
  congr 1

/-- The literal Minkowski sum in equation (4) of the paper. -/
def prism {n : ℕ} (B : Set (Fin n → ℝ)) (w : Fin n → ℝ) (L : ℝ) :
    Set (Fin n → ℝ) := L⁻¹ • B + centeredLine (L • w)

theorem prism_compact {n : ℕ} {B : Set (Fin n → ℝ)}
    (hB : IsCompact B) (w : Fin n → ℝ) (L : ℝ) : IsCompact (prism B w L) :=
  (IsCompact.smul L⁻¹ hB).add (centeredLine_compact (L • w))

theorem prism_convex {n : ℕ} {B : Set (Fin n → ℝ)}
    (hB : Convex ℝ B) (w : Fin n → ℝ) (L : ℝ) : Convex ℝ (prism B w L) :=
  (hB.smul L⁻¹).add (centeredLine_convex (L • w))

theorem prism_nonempty {n : ℕ} {B : Set (Fin n → ℝ)}
    (hB : B.Nonempty) (w : Fin n → ℝ) (L : ℝ) : (prism B w L).Nonempty := by
  obtain ⟨b, hb⟩ := hB
  refine ⟨L⁻¹ • b, ?_⟩
  exact ⟨L⁻¹ • b, ⟨b, hb, rfl⟩, 0, zero_mem_centeredLine (L • w), add_zero _⟩

theorem pairProjection_prism {n : ℕ} (i j : Fin n)
    (B : Set (Fin n → ℝ)) (w : Fin n → ℝ) (L : ℝ) :
    pairProjection i j '' prism B w L =
      L⁻¹ • (pairProjection i j '' B) +
        VolumePolynomials.PlanarExtrusion.centeredSegment (L • pairProjection i j w) := by
  rw [prism, Set.image_add (pairProjection i j),
    Set.image_smul_comm (pairProjection i j) L⁻¹ B (fun x => map_smul _ _ _),
    pairProjection_centeredLine, map_smul]

theorem planar_area_smul (C : Set Plane) {r : ℝ} (hr : 0 ≤ r) :
    (volume : Measure Plane).real (r • C) = r ^ 2 * (volume : Measure Plane).real C := by
  let f := VolumePolynomials.PlanarExtrusion.frameMap (r, 0) (0, r)
  have hf : (f : Plane → Plane) = fun x => r • x := by
    funext x
    ext <;> simp [f, VolumePolynomials.PlanarExtrusion.frameMap, mul_comm]
  have h := VolumePolynomials.PlanarExtrusion.area_image_linear f C
  rw [hf] at h
  simpa [f, VolumePolynomials.PlanarExtrusion.frameMap_det,
    VolumePolynomials.PlanarExtrusion.determinant, abs_of_nonneg hr,
    abs_mul, pow_two] using h

theorem pair_image_length_eq_width {n : ℕ} {B : Set (Fin n → ℝ)}
    (hB : IsCompact B) (hc : Convex ℝ B) (hne : B.Nonempty)
    (w : Fin n → ℝ) (i j : Fin n) :
    (volume : Measure ℝ).real (pairFunctional w i j '' B) = pairWidth B w i j := by
  have hf := (pairFunctional w i j).continuous_of_finiteDimensional
  have hK := hB.image hf
  have hconv := hc.linear_image (pairFunctional w i j)
  have hnonempty := hne.image (pairFunctional w i j)
  have hinterval := eq_Icc_of_connected_compact
    ⟨hnonempty, Real.convex_iff_isPreconnected.mp hconv⟩ hK
  have horder := csInf_le_csSup hnonempty hK.bddBelow hK.bddAbove
  rw [hinterval, Real.volume_real_Icc_of_le horder]
  rfl

theorem determinant_prism_image {n : ℕ} (i j : Fin n)
    (B : Set (Fin n → ℝ)) (w : Fin n → ℝ) {L : ℝ} (hL : L ≠ 0) :
    VolumePolynomials.PlanarExtrusion.determinant (L • pairProjection i j w) ''
      (L⁻¹ • (pairProjection i j '' B)) = pairFunctional w i j '' B := by
  have heq (b : Fin n → ℝ) :
      VolumePolynomials.PlanarExtrusion.determinant (L • pairProjection i j w)
        (L⁻¹ • pairProjection i j b) = pairFunctional w i j b := by
    change (L * w i) * (L⁻¹ * b j) - (L * w j) * (L⁻¹ * b i) =
      w i * b j - w j * b i
    field_simp [hL] <;> ring
  ext y
  constructor
  · rintro ⟨x, ⟨p, ⟨b, hb, rfl⟩, rfl⟩, rfl⟩
    exact ⟨b, hb, (heq b).symm⟩
  · rintro ⟨b, hb, rfl⟩
    exact ⟨L⁻¹ • pairProjection i j b,
      ⟨pairProjection i j b, ⟨b, hb, rfl⟩, rfl⟩, heq b⟩

/-- Equation (4), for all compact nonempty convex sets, including lower-dimensional ones. -/
theorem coordinate_area_prism {n : ℕ} {B : Set (Fin n → ℝ)}
    (hB : IsCompact B) (hc : Convex ℝ B) (hne : B.Nonempty)
    (w : Fin n → ℝ) {L : ℝ} (hL : 0 < L) (i j : Fin n) :
    (volume : Measure V2).real (projectN i j '' prism B w L) =
      pairWidth B w i j + (L⁻¹) ^ 2 * (volume : Measure V2).real (projectN i j '' B) := by
  have hP := hB.image (pairProjection i j).continuous_of_finiteDimensional
  have hcP := hc.linear_image (pairProjection i j)
  rw [← pairProjection_area i j (prism B w L), pairProjection_prism,
    VolumePolynomials.PlanarExtrusion.area_add_centeredSegment
      (IsCompact.smul L⁻¹ hP) (hcP.smul L⁻¹),
    planar_area_smul _ (inv_nonneg.mpr hL.le), determinant_prism_image i j B w hL.ne',
    pair_image_length_eq_width hB hc hne, pairProjection_area]
  ring

theorem euclideanDiameter_prism_ge {n : ℕ} {B : Set (Fin n → ℝ)}
    (hB : IsCompact B) (hzero : (0 : Fin n → ℝ) ∈ B)
    (w : Fin n → ℝ) {L : ℝ} (hL : 0 < L) :
    L * ‖asEuclidean n w‖ ≤ euclideanDiameter (prism B w L) := by
  have hz : (0 : Fin n → ℝ) ∈ L⁻¹ • B := ⟨0, hzero, smul_zero _⟩
  have hp : (1 / 2 : ℝ) • (L • w) ∈ prism B w L := by
    refine ⟨0, hz, (1 / 2 : ℝ) • (L • w), ?_, zero_add _⟩
    exact ⟨1 / 2, ⟨by norm_num, le_rfl⟩, rfl⟩
  have hm : (-(1 / 2 : ℝ)) • (L • w) ∈ prism B w L := by
    refine ⟨0, hz, (-(1 / 2 : ℝ)) • (L • w), ?_, zero_add _⟩
    exact ⟨-(1 / 2), ⟨le_rfl, by norm_num⟩, rfl⟩
  have hd := Metric.dist_le_diam_of_mem
    ((prism_compact hB w L).image (asEuclidean n).continuous).isBounded
    (show asEuclidean n ((1 / 2 : ℝ) • (L • w)) ∈ asEuclidean n '' prism B w L from
      ⟨_, hp, rfl⟩)
    (show asEuclidean n ((-(1 / 2 : ℝ)) • (L • w)) ∈ asEuclidean n '' prism B w L from
      ⟨_, hm, rfl⟩)
  have hsub : (1 / 2 : ℝ) • (L • w) - (-(1 / 2 : ℝ)) • (L • w) = L • w := by
    rw [← sub_smul]
    norm_num
  have hdist : dist (asEuclidean n ((1 / 2 : ℝ) • (L • w)))
      (asEuclidean n ((-(1 / 2 : ℝ)) • (L • w))) = L * ‖asEuclidean n w‖ := by
    rw [dist_eq_norm, ← map_sub, hsub, map_smul, norm_smul, Real.norm_eq_abs,
      abs_of_pos hL]
  simpa only [hdist, euclideanDiameter] using hd

end ExactPrism

/-- Proposition 3.2 in full: exact prescribed widths and an actual realization
of `q + L⁻² A(B)` for every positive `L`, with the stated Euclidean diameter bound. -/
theorem exists_prescribed_width_polytope_exact_prisms {n : ℕ}
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hq : ∀ i j, 0 ≤ q i j) (hsym : ∀ i j, q i j = q j i)
    (hdiag : ∀ i, q i i = 0) (hw : ∀ i, 0 ≤ w i) (hwne : w ≠ 0)
    (htri : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j ≤ w j * q i k + w i * q j k) :
    ∃ S : Set (Fin n → ℝ), S.Finite ∧
      (convexHull ℝ S).Nonempty ∧ IsCompact (convexHull ℝ S) ∧
      Convex ℝ (convexHull ℝ S) ∧ -(convexHull ℝ S) = convexHull ℝ S ∧
      (0 : Fin n → ℝ) ∈ convexHull ℝ S ∧
      (∀ i j, pairWidth (convexHull ℝ S) w i j = q i j) ∧
      ∀ L : ℝ, 0 < L → ∃ K : CoordinateBody n,
        (∀ i j, coordinateAreas K i j = q i j + (L⁻¹) ^ 2 *
          (volume : Measure V2).real (projectN i j '' convexHull ℝ S)) ∧
        L * ‖asEuclidean n w‖ ≤ Metric.diam (K : Set (CoordinateSpace n)) := by
  obtain ⟨S, hS, hne, hcompact, hconvex, hcentral, hzero, hwidth⟩ :=
    exists_polytope_prescribed_widths q w hq hsym hdiag hw hwne htri
  refine ⟨S, hS, hne, hcompact, hconvex, hcentral, hzero, hwidth, ?_⟩
  intro L hL
  let K := euclideanBodyOfSet (ExactPrism.prism (convexHull ℝ S) w L)
    (ExactPrism.prism_compact hcompact w L) (ExactPrism.prism_convex hconvex w L)
    (ExactPrism.prism_nonempty hne w L)
  refine ⟨K, ?_, ?_⟩
  · intro i j
    change coordinateAreas (euclideanBodyOfSet _ _ _ _) i j = _
    rw [coordinateAreas_euclideanBodyOfSet]
    change (volume : Measure V2).real
      (projectN i j '' ExactPrism.prism (convexHull ℝ S) w L) = _
    rw [ExactPrism.coordinate_area_prism hcompact hconvex hne w hL, hwidth]
  · change L * ‖asEuclidean n w‖ ≤ euclideanDiameter (ExactPrism.prism (convexHull ℝ S) w L)
    exact ExactPrism.euclideanDiameter_prism_ge hcompact hzero w hL

end

end ProjectionAreaEscape

