section Source_EscapeTheorems

@[expose] public section

/-!
# The escape cone and the closure of the realization locus

This file assembles Theorems 1.2 and 3.3 of the paper. The realization locus
uses ordinary Lebesgue areas of actual coordinate projections of compact
convex bodies in Euclidean space. Diameter is Euclidean diameter. The escape
cone uses a nonnegative, nonzero weight vector and all weighted triangle
inequalities; its entries and weights are allowed to vanish.

The two directions have independent geometric proofs. Necessity normalizes
arbitrary long bodies and passes actual projected areas to a compact limit.
Sufficiency constructs centrally symmetric finite convex hulls and thickens
them by a vanishing amount. No geometric conclusion is included as an input
to the weight predicate.
-/

noncomputable section

open Set Filter MeasureTheory Metric
open scoped Topology
open ProjectionAreaTopology ProjectionAreaEscape ProjectionAreaEscapeNormalization

namespace ProjectionAreaPaper

/-- Theorem 1.2, equivalently the escape characterization in Theorem 3.3.
This statement includes every ambient dimension and every zero pattern. -/
theorem escapeCone_eq_divergingDiameterLimits (d : ℕ) :
    EscapeCone d = divergingDiameterLimits d :=
  Set.Subset.antisymm (escapeCone_subset_divergingDiameterLimits d)
    (divergingDiameterLimits_subset_escapeCone d)

theorem mem_escapeCone_iff_exists_diverging_sequence (d : ℕ) (q : AreaArray d) :
    q ∈ EscapeCone d ↔
      ∃ K : ℕ → CoordinateBody d,
        Tendsto (fun m => coordinateAreas (K m)) atTop (𝓝 q) ∧
        Tendsto (fun m => diam (K m : Set (CoordinateSpace d))) atTop atTop := by
  rw [escapeCone_eq_divergingDiameterLimits]
  rfl

/-- The additional approximation assertion in Theorem 3.3: finite convex
hulls, central symmetry, full dimension, and diverging Euclidean diameter
hold simultaneously along the same sequence. -/
theorem mem_escapeCone_iff_exists_full_dimensional_symmetric_sequence
    (d : ℕ) (q : AreaArray d) :
    q ∈ EscapeCone d ↔
      ∃ K : ℕ → CoordinateBody d,
        Tendsto (fun m => coordinateAreas (K m)) atTop (𝓝 q) ∧
        Tendsto (fun m => diam (K m : Set (CoordinateSpace d))) atTop atTop ∧
        ∀ m, IsSymmetricPolytope (K m) ∧
          (interior (K m : Set (CoordinateSpace d))).Nonempty := by
  constructor
  · exact escapeCone_exists_full_dimensional_symmetric_sequence d q
  · rintro ⟨K, harea, hdiam, _⟩
    exact (mem_escapeCone_iff_exists_diverging_sequence d q).mpr ⟨K, harea, hdiam⟩

/-- The closedness part of Theorem 3.3. Witnesses are normalized to the
compact simplex, so no uniform positive lower bound on their coordinates
is needed. -/
theorem escapeCone_isClosed (d : ℕ) : IsClosed (EscapeCone d) :=
  isClosed_escapeCone d

theorem divergingDiameterLimits_isClosed (d : ℕ) :
    IsClosed (divergingDiameterLimits d) := by
  rw [← escapeCone_eq_divergingDiameterLimits]
  exact escapeCone_isClosed d

/-- The closure identity in both Theorems 1.2 and 3.3, with the realization
locus and the escape cone independently defined. -/
theorem closure_realizationLocus_eq_union_escapeCone (d : ℕ) :
    closure (realizationLocus d) = realizationLocus d ∪ EscapeCone d := by
  rw [ProjectionAreaTopology.closure_realizationLocus,
    ← escapeCone_eq_divergingDiameterLimits]

theorem mem_closure_realizationLocus_iff (d : ℕ) (q : AreaArray d) :
    q ∈ closure (realizationLocus d) ↔
      (∃ K : CoordinateBody d, coordinateAreas K = q) ∨ q ∈ EscapeCone d := by
  rw [closure_realizationLocus_eq_union_escapeCone]
  rfl

theorem realization_union_escape_isClosed (d : ℕ) :
    IsClosed (realizationLocus d ∪ EscapeCone d) := by
  rw [← closure_realizationLocus_eq_union_escapeCone]
  exact isClosed_closure

end ProjectionAreaPaper

end
end
end Source_EscapeTheorems

