section Source_StrictMetricRealization

@[expose] public section

/-!
# Strict weighted coordinate-area realization

Theorem 4.1 is proved in full below. Sections separate the distance-potential
algebra, uniform threshold, planar area calculation, and finite convex-hull
construction. The final theorem uses actual planar Lebesgue measure and
Euclidean diameter.
-/
section StrictMetricAlgebraSource

/-!+# Distance potentials for strict coordinate-area realizations

The lemmas in this file are the algebraic part of Theorem 4.1 of
*Compatibility and realization of coordinate projection areas*.
The hypotheses are those of a finite strict metric, with no restriction on
the number of coordinates.  The geometric construction is in
`StrictMetricRealizer`.
-/


namespace ProjectionAreaStrict

noncomputable section

variable {ι : Type*}

/-- The transverse distance potential attached to an ordered pair. -/
def potential (d : ι → ι → ℝ) (i j k : ι) : ℝ := (d k i - d k j) / 2

theorem potential_designated (d : ι → ι → ℝ)
    (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (i j : ι) : potential d i j j - potential d i j i = d i j := by
  simp only [potential, hdiag, hsym j i]
  ring

theorem triangle_of_strict (d : ι → ι → ℝ)
    (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k → d i j < d i k + d j k)
    (i j k : ι) : d i j ≤ d i k + d j k := by
  by_cases hij : i = j
  · subst j
    rw [hdiag]
    by_cases hik : i = k
    · subst k; simp [hdiag]
    · linarith [hpos i k hik]
  by_cases hik : i = k
  · subst k; simp [hdiag, hsym j i]
  by_cases hjk : j = k
  · subst k; simp [hdiag]
  exact (hstrict i j k hij hik hjk).le

theorem reverse_triangle (d : ι → ι → ℝ)
    (hsym : ∀ i j, d i j = d j i)
    (htri : ∀ i j k, d i j ≤ d i k + d j k)
    (k l i : ι) : |d l i - d k i| ≤ d k l := by
  apply abs_le.mpr
  constructor
  · have h := htri k i l
    rw [hsym i l] at h
    linarith
  · have h := htri l i k
    rw [hsym l k, hsym i k] at h
    linarith

theorem reverse_triangle_strict (d : ι → ι → ℝ)
    (hsym : ∀ i j, d i j = d j i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k → d i j < d i k + d j k)
    (k l i : ι) (hkl : k ≠ l) (hik : i ≠ k) (hil : i ≠ l) :
    |d l i - d k i| < d k l := by
  apply abs_lt.mpr
  constructor
  · have h := hstrict k i l (Ne.symm hik) hkl hil
    rw [hsym i l] at h
    linarith
  · have h := hstrict l i k (Ne.symm hil) (Ne.symm hkl) hik
    rw [hsym l k, hsym i k] at h
    linarith

/-- Every potential is strictly inside every other unordered pair's strip. -/
theorem potential_strict (d : ι → ι → ℝ)
    (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k → d i j < d i k + d j k)
    (i j k l : ι) (hij : i ≠ j) (hkl : k ≠ l)
    (hforward : ¬ (i = k ∧ j = l)) (hbackward : ¬ (i = l ∧ j = k)) :
    |potential d i j l - potential d i j k| < d k l := by
  have htri := triangle_of_strict d hsym hdiag hpos hstrict
  have hi := reverse_triangle d hsym htri k l i
  have hj := reverse_triangle d hsym htri k l j
  have hout : (i ≠ k ∧ i ≠ l) ∨ (j ≠ k ∧ j ≠ l) := by
    by_cases hik : i = k <;> by_cases hil : i = l <;>
      by_cases hjk : j = k <;> by_cases hjl : j = l <;> aesop
  have hsum : |d l i - d k i| + |d l j - d k j| < 2 * d k l := by
    rcases hout with ⟨hik, hil⟩ | ⟨hjk, hjl⟩
    · have h := reverse_triangle_strict d hsym hstrict k l i hkl hik hil
      linarith
    · have h := reverse_triangle_strict d hsym hstrict k l j hkl hjk hjl
      linarith
  have habs := abs_sub_le (d l i - d k i) 0 (d l j - d k j)
  simp only [sub_zero, zero_sub, abs_neg] at habs
  have he : potential d i j l - potential d i j k =
      ((d l i - d k i) - (d l j - d k j)) / 2 := by
    simp only [potential]; ring
  rw [he, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  exact (div_lt_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr (by linarith)

def rescaledDistance (q : ι → ι → ℝ) (w : ι → ℝ) (i j : ι) : ℝ :=
  q i j / (w i * w j)

theorem rescaledDistance_symm (q : ι → ι → ℝ) (w : ι → ℝ)
    (hsym : ∀ i j, q i j = q j i) (i j : ι) :
    rescaledDistance q w i j = rescaledDistance q w j i := by
  simp [rescaledDistance, hsym i j, mul_comm]

theorem rescaledDistance_diag (q : ι → ι → ℝ) (w : ι → ℝ)
    (hdiag : ∀ i, q i i = 0) (i : ι) : rescaledDistance q w i i = 0 := by
  simp [rescaledDistance, hdiag]

theorem rescaledDistance_pos (q : ι → ι → ℝ) (w : ι → ℝ)
    (hw : ∀ i, 0 < w i) (hpos : ∀ i j, i ≠ j → 0 < q i j)
    (i j : ι) (hij : i ≠ j) : 0 < rescaledDistance q w i j :=
  div_pos (hpos i j hij) (mul_pos (hw i) (hw j))

theorem rescaledDistance_strict (q : ι → ι → ℝ) (w : ι → ℝ)
    (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j < w j * q i k + w i * q j k)
    (i j k : ι) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    rescaledDistance q w i j < rescaledDistance q w i k +
      rescaledDistance q w j k := by
  have h := hstrict i j k hij hik hjk
  have hprod : 0 < w i * w j * w k := mul_pos (mul_pos (hw i) (hw j)) (hw k)
  have hi := (hw i).ne'
  have hj := (hw j).ne'
  have hk := (hw k).ne'
  apply (mul_lt_mul_iff_of_pos_right hprod).mp
  dsimp [rescaledDistance]
  calc
    q i j / (w i * w j) * (w i * w j * w k) = w k * q i j := by
      field_simp [hi, hj, hk] <;> ring
    _ < w j * q i k + w i * q j k := h
    _ = (q i k / (w i * w k) + q j k / (w j * w k)) *
        (w i * w j * w k) := by
      field_simp [hi, hj, hk] <;> ring

end
end ProjectionAreaStrict
end StrictMetricAlgebraSource


section StrictMetricThresholdSource

/-! # One finite threshold for all projected vertices -/

open scoped BigOperators

namespace ProjectionAreaStrict

theorem exists_frame_threshold {ι : Type*} [Fintype ι]
    (α β : ι → ι → ℝ) (hβ : ∀ p r, p ≠ r → |β p r| < 1) :
    ∃ M : ℝ, 0 < M ∧ ∀ T : ℝ, M ≤ T → ∀ p r, p ≠ r →
      |α p r| / T^2 + |β p r| ≤ 1 := by
  classical
  let c : ι → ι → ℝ := fun p r =>
    if p = r then 0 else |α p r| / (1 - |β p r|)
  have hc : ∀ p r, 0 ≤ c p r := by
    intro p r
    by_cases h : p = r
    · simp [c, h]
    · simp only [c, if_neg h]
      exact div_nonneg (abs_nonneg _) (by linarith [hβ p r h])
  let C : ℝ := ∑ p, ∑ r, c p r
  have hC : 0 ≤ C := Finset.sum_nonneg (fun p _ =>
    Finset.sum_nonneg (fun r _ => hc p r))
  have hcle (p r : ι) : c p r ≤ C := by
    exact (Finset.single_le_sum (fun s _ => hc p s) (Finset.mem_univ r)).trans
      (Finset.single_le_sum
        (fun s _ => Finset.sum_nonneg (fun t _ => hc s t)) (Finset.mem_univ p))
  refine ⟨C+1, by linarith, ?_⟩
  intro T hT p r hpr
  have hTpos : 0 < T := by linarith
  have hTsq : 0 < T^2 := sq_pos_of_pos hTpos
  have hlarge : C ≤ T^2 := by
    have hT1 : 1 ≤ T := by linarith
    have hproduct : 0 ≤ T * (T - 1) := mul_nonneg hTpos.le (sub_nonneg.mpr hT1)
    nlinarith only [hproduct, hT]
  have hgap : 0 < 1 - |β p r| := by linarith [hβ p r hpr]
  have hcoef : |α p r| / (1 - |β p r|) ≤ T^2 := by
    have hh := hcle p r
    simp only [c, if_neg hpr] at hh
    exact hh.trans hlarge
  have hmul : |α p r| ≤ (1 - |β p r|) * T^2 := by
    have hh := (div_le_iff₀ hgap).mp hcoef
    simpa [mul_comm] using hh
  have hdiv := (div_le_iff₀ hTsq).mpr hmul
  linarith

end ProjectionAreaStrict
end StrictMetricThresholdSource


section CenteredDiamondsSource

/-!+# Centered planar diamonds

These are actual convex hulls in the coordinate plane, with ordinary planar
Lebesgue area.  No area functional is supplied as a hypothesis.
-/

open Set MeasureTheory
open scoped Pointwise
open ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryAreas

namespace ProjectionAreaStrict

noncomputable section

def centeredDiamond (a b : V2) : Set V2 :=
  convexHull ℝ ({a, -a, b, -b} : Set V2)

theorem centeredDiamond_neg (a b : V2) : -centeredDiamond a b = centeredDiamond a b := by
  have hs : -({a, -a, b, -b} : Set V2) = ({a, -a, b, -b} : Set V2) := by
    ext x
    simp only [Set.mem_neg, mem_insert_iff, mem_singleton_iff]
    constructor <;> intro h
    · rcases h with h | h | h | h
      · exact Or.inr (Or.inl (by simpa using congrArg Neg.neg h))
      · exact Or.inl (by simpa using congrArg Neg.neg h)
      · exact Or.inr (Or.inr (Or.inr (by simpa using congrArg Neg.neg h)))
      · exact Or.inr (Or.inr (Or.inl (by simpa using congrArg Neg.neg h)))
    · rcases h with rfl | rfl | rfl | rfl <;> simp
  rw [centeredDiamond, ← convexHull_neg, hs]

theorem neg_mem_centeredDiamond {a b x : V2} (hx : x ∈ centeredDiamond a b) :
    -x ∈ centeredDiamond a b := by
  have hh : -x ∈ -centeredDiamond a b := by simpa using hx
  rwa [centeredDiamond_neg] at hh

theorem centeredDiamond_convex (a b : V2) : Convex ℝ (centeredDiamond a b) :=
  convex_convexHull ℝ _

theorem centeredDiamond_zero (a b : V2) : (0 : V2) ∈ centeredDiamond a b := by
  have ha : a ∈ centeredDiamond a b := subset_convexHull ℝ _ (by simp)
  have hn : -a ∈ centeredDiamond a b := subset_convexHull ℝ _ (by simp)
  have h := centeredDiamond_convex a b ha hn
    (by norm_num : (0 : ℝ) ≤ 1/2) (by norm_num : (0 : ℝ) ≤ 1/2)
    (by norm_num : (1/2 : ℝ) + 1/2 = 1)
  convert h using 1 <;> ext i <;> simp <;> ring

theorem convex_combination_le_one {E : Type*} [AddCommGroup E] [Module ℝ E]
    {S : Set E} (hS : Convex ℝ S) (h0 : (0 : E) ∈ S)
    {x y : E} (hx : x ∈ S) (hy : y ∈ S)
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b ≤ 1) :
    a • x + b • y ∈ S := by
  by_cases hzero : a + b = 0
  · have ha0 : a = 0 := by linarith
    have hb0 : b = 0 := by linarith
    simpa [ha0, hb0] using h0
  have hpos : 0 < a + b := lt_of_le_of_ne (add_nonneg ha hb) (Ne.symm hzero)
  have hs := hS hx hy (div_nonneg ha hpos.le) (div_nonneg hb hpos.le)
    (show a / (a+b) + b / (a+b) = 1 by field_simp [hzero] <;> ring)
  have ht := hS.smul_mem_of_zero_mem h0 hs ⟨hpos.le, hab⟩
  convert ht using 1 <;> simp only [smul_add, smul_smul]
  congr 1 <;> congr 1 <;> field_simp [hzero] <;> ring

theorem mem_centeredDiamond_of_abs_add_le (a b : V2) (α β : ℝ)
    (h : |α| + |β| ≤ 1) : α • a + β • b ∈ centeredDiamond a b := by
  have ha : a ∈ centeredDiamond a b := subset_convexHull ℝ _ (by simp)
  have hna : -a ∈ centeredDiamond a b := subset_convexHull ℝ _ (by simp)
  have hb : b ∈ centeredDiamond a b := subset_convexHull ℝ _ (by simp)
  have hnb : -b ∈ centeredDiamond a b := subset_convexHull ℝ _ (by simp)
  have hc := centeredDiamond_convex a b
  have hz := centeredDiamond_zero a b
  rcases le_total 0 α with hα | hα <;> rcases le_total 0 β with hβ | hβ
  · exact convex_combination_le_one hc hz ha hb hα hβ
      (by simpa [abs_of_nonneg hα, abs_of_nonneg hβ] using h)
  · have hh := convex_combination_le_one hc hz ha hnb hα (neg_nonneg.mpr hβ)
      (show α + -β ≤ 1 by simpa [abs_of_nonneg hα, abs_of_nonpos hβ] using h)
    simpa using hh
  · have hh := convex_combination_le_one hc hz hna hb (neg_nonneg.mpr hα) hβ
      (show -α + β ≤ 1 by simpa [abs_of_nonpos hα, abs_of_nonneg hβ] using h)
    simpa using hh
  · have hh := convex_combination_le_one hc hz hna hnb
      (neg_nonneg.mpr hα) (neg_nonneg.mpr hβ)
      (show -α + -β ≤ 1 by simpa [abs_of_nonpos hα, abs_of_nonpos hβ] using h)
    simpa using hh

theorem centeredDiamond_area (a b : V2) :
    (volume : Measure V2).real (centeredDiamond a b) = 2 * |det2 a b| := by
  have hset : ({a, -a, b, -b} : Set V2) =
      ({-a, -a+(a+b), -a+(a-b), -a+(a+b)+(a-b)} : Set V2) := by
    have h1 : -a+(a+b) = b := by abel
    have h2 : -a+(a-b) = -b := by abel
    have h3 : -a+(a+b)+(a-b) = a := by abel
    rw [h3, h1, h2]
    ext x
    simp only [mem_insert_iff, mem_singleton_iff]
    tauto
  rw [centeredDiamond, hset, area_translated_parallelogram_hull]
  have hdet : det2 (a+b) (a-b) = -2 * det2 a b := by
    simp [det2]; ring
  rw [hdet, abs_mul]
  norm_num

theorem planar_frame (a b x : V2) (hdet : det2 a b ≠ 0) :
    x = (det2 x b / det2 a b) • a + (det2 a x / det2 a b) • b := by
  ext i
  fin_cases i <;> simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  all_goals
    rw [div_mul_eq_mul_div₀, div_mul_eq_mul_div₀, ← add_div]
    apply (eq_div_iff hdet).mpr
    dsimp [det2]
    ring

theorem det2_smul_smul (a b : V2) (r s : ℝ) :
    det2 (r • a) (s • b) = r * s * det2 a b := by
  simp [det2]; ring

theorem scaled_frame_mem (a b x : V2) (T : ℝ) (hT : 0 < T)
    (hdet : det2 a b ≠ 0)
    (h : |det2 x b / det2 a b| / T^2 + |det2 a x / det2 a b| ≤ 1) :
    T⁻¹ • x ∈ centeredDiamond (T • a) (T⁻¹ • b) := by
  have hf := planar_frame a b x hdet
  have he : T⁻¹ • x =
      (det2 x b / det2 a b / T^2) • (T • a) +
        (det2 a x / det2 a b) • (T⁻¹ • b) := by
    calc
      T⁻¹ • x = T⁻¹ •
          ((det2 x b / det2 a b) • a + (det2 a x / det2 a b) • b) :=
        congrArg (fun z : V2 => T⁻¹ • z) hf
      _ = _ := by
        simp only [smul_add, smul_smul]
        congr 1 <;> congr 1 <;> field_simp [hT.ne'] <;> ring
  rw [he]
  apply mem_centeredDiamond_of_abs_add_le
  simpa [abs_div, abs_of_pos (sq_pos_of_pos hT)] using h

end
end ProjectionAreaStrict
end CenteredDiamondsSource


section StrictMetricRealizerSource

/-!+# Exact realization of strict weighted metrics

The construction of Theorem 4.1 uses a long common diagonal and one
transverse pair of vertices for each coordinate plane.  Every projection
is proved equal, as a set, to its prescribed diamond before area is taken.
-/

open Set MeasureTheory
open scoped BigOperators Pointwise
open ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryAreas ProjectionAreaTransforms

namespace ProjectionAreaStrict

noncomputable section

def orderedPairs (n : ℕ) : Finset (Fin n × Fin n) :=
  (Finset.univ ×ˢ Finset.univ).filter (fun p => p.1 < p.2)

@[simp] theorem mem_orderedPairs {n : ℕ} (p : Fin n × Fin n) :
    p ∈ orderedPairs n ↔ p.1 < p.2 := by simp [orderedPairs]

abbrev PairLabel (n : ℕ) := {p : Fin n × Fin n // p.1 < p.2}

def transverse {n : ℕ} (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (r : PairLabel n) : Fin n → ℝ :=
  fun k => w k * potential d r.val.1 r.val.2 k / 2

def projectedAxis {n : ℕ} (w : Fin n → ℝ) (p : PairLabel n) : V2 :=
  projectN p.val.1 p.val.2 w

def projectedTransverse {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (p r : PairLabel n) : V2 :=
  projectN p.val.1 p.val.2 (transverse d w r)

theorem det_projected_transverse {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (p r : PairLabel n) :
    det2 (projectedAxis w p) (projectedTransverse d w p r) =
      (w p.val.1 * w p.val.2 / 2) *
        (potential d r.val.1 r.val.2 p.val.2 -
         potential d r.val.1 r.val.2 p.val.1) := by
  simp [det2, projectedAxis, projectedTransverse, projectN, transverse]
  ring

theorem det_projected_designated {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (p : PairLabel n) :
    det2 (projectedAxis w p) (projectedTransverse d w p p) =
      w p.val.1 * w p.val.2 * d p.val.1 p.val.2 / 2 := by
  rw [det_projected_transverse, potential_designated d hsym hdiag]
  ring

theorem det_projected_pos {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (p : PairLabel n) :
    0 < det2 (projectedAxis w p) (projectedTransverse d w p p) := by
  rw [det_projected_designated d w hsym hdiag]
  exact div_pos (mul_pos (mul_pos (hw _) (hw _)) (hpos _ _ (ne_of_lt p.property)))
    (by norm_num)

theorem det_projected_strict {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k → d i j < d i k + d j k)
    (p r : PairLabel n) (hpr : p ≠ r) :
    |det2 (projectedAxis w p) (projectedTransverse d w p r)| <
      det2 (projectedAxis w p) (projectedTransverse d w p p) := by
  have hforward : ¬ (r.val.1 = p.val.1 ∧ r.val.2 = p.val.2) := by
    rintro ⟨h1,h2⟩
    apply hpr
    apply Subtype.ext
    exact Prod.ext h1.symm h2.symm
  have hbackward : ¬ (r.val.1 = p.val.2 ∧ r.val.2 = p.val.1) := by
    rintro ⟨h1,h2⟩
    have hp := p.property
    have hr := r.property
    rw [h1,h2] at hr
    exact (lt_asymm hp hr)
  have hh := potential_strict d hsym hdiag hpos hstrict
    r.val.1 r.val.2 p.val.1 p.val.2 (ne_of_lt r.property)
    (ne_of_lt p.property) hforward hbackward
  rw [det_projected_transverse, det_projected_designated d w hsym hdiag, abs_mul,
    abs_of_pos (div_pos (mul_pos (hw _) (hw _)) (by norm_num : (0:ℝ)<2))]
  nlinarith [mul_lt_mul_of_pos_left hh
    (div_pos (mul_pos (hw p.val.1) (hw p.val.2)) (by norm_num : (0:ℝ)<2))]

def frameAlpha {n : ℕ} (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (p r : PairLabel n) : ℝ :=
  det2 (projectedTransverse d w p r) (projectedTransverse d w p p) /
    det2 (projectedAxis w p) (projectedTransverse d w p p)

def frameBeta {n : ℕ} (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (p r : PairLabel n) : ℝ :=
  det2 (projectedAxis w p) (projectedTransverse d w p r) /
    det2 (projectedAxis w p) (projectedTransverse d w p p)

theorem frameBeta_strict {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k → d i j < d i k + d j k)
    (p r : PairLabel n) (hpr : p ≠ r) : |frameBeta d w p r| < 1 := by
  have hp := det_projected_pos d w hsym hdiag hpos hw p
  rw [frameBeta, abs_div, abs_of_pos hp]
  exact (div_lt_one hp).mpr (det_projected_strict d w hsym hdiag hpos hw hstrict p r hpr)

def metricVertices {n : ℕ} (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (T : ℝ) : Finset (Fin n → ℝ) := by
  classical
  exact {T • w, -(T • w)} ∪
    Finset.univ.image (fun r : PairLabel n => T⁻¹ • transverse d w r) ∪
    Finset.univ.image (fun r : PairLabel n => -(T⁻¹ • transverse d w r))

def metricPolytope {n : ℕ} (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (T : ℝ) : Set (Fin n → ℝ) := convexHull ℝ (metricVertices d w T : Set (Fin n → ℝ))

@[simp] theorem mem_metricVertices {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) (x : Fin n → ℝ) :
    x ∈ metricVertices d w T ↔ x = T • w ∨ x = -(T • w) ∨
      (∃ r : PairLabel n, T⁻¹ • transverse d w r = x) ∨
      (∃ r : PairLabel n, -(T⁻¹ • transverse d w r) = x) := by
  classical
  simp only [metricVertices, Finset.mem_union, Finset.mem_insert, Finset.mem_singleton,
    Finset.mem_image, Finset.mem_univ, true_and]
  tauto

theorem metricPolytope_compact {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) : IsCompact (metricPolytope d w T) :=
  (metricVertices d w T).finite_toSet.isCompact_convexHull ℝ

theorem metricPolytope_convex {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) : Convex ℝ (metricPolytope d w T) :=
  convex_convexHull ℝ _

theorem metricPolytope_axis_pos {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) : T • w ∈ metricPolytope d w T :=
  subset_convexHull ℝ _ (by simp)

theorem metricPolytope_axis_neg {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) : -(T • w) ∈ metricPolytope d w T :=
  subset_convexHull ℝ _ (by simp)

theorem metricVertices_neg {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) {x : Fin n → ℝ}
    (hx : x ∈ metricVertices d w T) : -x ∈ metricVertices d w T := by
  rw [mem_metricVertices] at hx ⊢
  rcases hx with rfl | rfl | ⟨r,rfl⟩ | ⟨r,rfl⟩
  · exact Or.inr (Or.inl rfl)
  · exact Or.inl (neg_neg _)
  · exact Or.inr (Or.inr (Or.inr ⟨r,rfl⟩))
  · exact Or.inr (Or.inr (Or.inl ⟨r, (neg_neg _).symm⟩))

theorem metricPolytope_centrally_symmetric {n : ℕ}
    (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (T : ℝ) :
    -metricPolytope d w T = metricPolytope d w T := by
  have hs : -(metricVertices d w T : Set (Fin n → ℝ)) =
      (metricVertices d w T : Set (Fin n → ℝ)) := by
    ext x
    change -x ∈ metricVertices d w T ↔ x ∈ metricVertices d w T
    exact ⟨fun h => by simpa using metricVertices_neg d w T h,
      metricVertices_neg d w T⟩
  rw [metricPolytope, ← convexHull_neg, hs]

theorem projected_vertex_mem {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (T : ℝ) (hT : 0 < T)
    (hframe : ∀ p r : PairLabel n, p ≠ r →
      |frameAlpha d w p r| / T^2 + |frameBeta d w p r| ≤ 1)
    (p : PairLabel n) {x : Fin n → ℝ} (hx : x ∈ metricVertices d w T) :
    projectN p.val.1 p.val.2 x ∈
      centeredDiamond (T • projectedAxis w p) (T⁻¹ • projectedTransverse d w p p) := by
  have ht (r : PairLabel n) :
      projectN p.val.1 p.val.2 (T⁻¹ • transverse d w r) ∈
        centeredDiamond (T • projectedAxis w p) (T⁻¹ • projectedTransverse d w p p) := by
    rw [map_smul]
    change T⁻¹ • projectedTransverse d w p r ∈ _
    by_cases hpr : p = r
    · subst r
      exact subset_convexHull ℝ _ (by simp)
    · exact scaled_frame_mem _ _ _ T hT
        (det_projected_pos d w hsym hdiag hpos hw p).ne'
        (hframe p r hpr)
  rw [mem_metricVertices] at hx
  rcases hx with rfl | rfl | ⟨r,rfl⟩ | ⟨r,rfl⟩
  · rw [map_smul]
    exact subset_convexHull ℝ _ (by simp [projectedAxis])
  · rw [map_neg, map_smul]
    exact subset_convexHull ℝ _ (by simp [projectedAxis])
  · exact ht r
  · rw [map_neg]
    exact neg_mem_centeredDiamond (ht r)

theorem metricPolytope_projection {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (T : ℝ) (hT : 0 < T)
    (hframe : ∀ p r : PairLabel n, p ≠ r →
      |frameAlpha d w p r| / T^2 + |frameBeta d w p r| ≤ 1)
    (p : PairLabel n) :
    projectN p.val.1 p.val.2 '' metricPolytope d w T =
      centeredDiamond (T • projectedAxis w p) (T⁻¹ • projectedTransverse d w p p) := by
  rw [metricPolytope, (projectN p.val.1 p.val.2).image_convexHull]
  apply Set.Subset.antisymm
  · apply convexHull_min
    · rintro x ⟨y,hy,rfl⟩
      exact projected_vertex_mem d w hsym hdiag hpos hw T hT hframe p hy
    · exact centeredDiamond_convex _ _
  · apply convexHull_mono
    intro x hx
    simp only [mem_insert_iff, mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact ⟨T • w, by simp, by simp [projectedAxis]⟩
    · exact ⟨-(T • w), by simp, by simp [projectedAxis]⟩
    · exact ⟨T⁻¹ • transverse d w p, by simp [mem_metricVertices],
        by simp [projectedTransverse]⟩
    · exact ⟨-(T⁻¹ • transverse d w p), by simp [mem_metricVertices],
        by simp [projectedTransverse]⟩

theorem metricPolytope_ordered_area {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (T : ℝ) (hT : 0 < T)
    (hframe : ∀ p r : PairLabel n, p ≠ r →
      |frameAlpha d w p r| / T^2 + |frameBeta d w p r| ≤ 1)
    (p : PairLabel n) :
    (volume : Measure V2).real (projectN p.val.1 p.val.2 '' metricPolytope d w T) =
      w p.val.1 * w p.val.2 * d p.val.1 p.val.2 := by
  rw [metricPolytope_projection d w hsym hdiag hpos hw T hT hframe p,
    centeredDiamond_area, det2_smul_smul, mul_inv_cancel₀ hT.ne', one_mul,
    abs_of_pos (det_projected_pos d w hsym hdiag hpos hw p),
    det_projected_designated d w hsym hdiag]
  ring

theorem exists_metricPolytope_threshold {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < d i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k → d i j < d i k + d j k) :
    ∃ M : ℝ, 0 < M ∧ ∀ T : ℝ, M ≤ T → ∀ p : PairLabel n,
      (volume : Measure V2).real (projectN p.val.1 p.val.2 '' metricPolytope d w T) =
        w p.val.1 * w p.val.2 * d p.val.1 p.val.2 := by
  obtain ⟨M,hM,hframe⟩ := exists_frame_threshold (frameAlpha d w) (frameBeta d w)
    (frameBeta_strict d w hsym hdiag hpos hw hstrict)
  refine ⟨M,hM,?_⟩
  intro T hT p
  exact metricPolytope_ordered_area d w hsym hdiag hpos hw T (hM.trans_le hT)
    (hframe T hT) p

theorem pairLabel_card (n : ℕ) : Fintype.card (PairLabel n) = n.choose 2 := by
  rw [Fintype.card_subtype]
  simpa only [Finset.univ_product_univ, Finset.card_univ, Fintype.card_fin] using
    (Finset.card_product_filter_lt (s := (Finset.univ : Finset (Fin n))))

theorem twice_choose_two (n : ℕ) : 2 * n.choose 2 = n * (n-1) := by
  cases n with
  | zero => simp
  | succ n =>
    simpa [Nat.choose_one_right, Nat.mul_comm] using
      (Nat.add_one_mul_choose_eq n 1).symm

theorem metricVertices_card {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (T : ℝ) :
    (metricVertices d w T).card ≤ n * (n-1) + 2 := by
  classical
  have haxis : ({T • w, -(T • w)} : Finset (Fin n → ℝ)).card ≤ 2 := by
    exact (Finset.card_insert_le _ _).trans (by simp)
  have hp : (Finset.univ.image (fun r : PairLabel n => T⁻¹ • transverse d w r)).card ≤
      Fintype.card (PairLabel n) := by
    simpa using Finset.card_image_le (s := (Finset.univ : Finset (PairLabel n)))
      (f := fun r => T⁻¹ • transverse d w r)
  have hm : (Finset.univ.image (fun r : PairLabel n => -(T⁻¹ • transverse d w r))).card ≤
      Fintype.card (PairLabel n) := by
    simpa using Finset.card_image_le (s := (Finset.univ : Finset (PairLabel n)))
      (f := fun r => -(T⁻¹ • transverse d w r))
  have h1 := Finset.card_union_le
    ({T • w, -(T • w)} : Finset (Fin n → ℝ))
    (Finset.univ.image (fun r : PairLabel n => T⁻¹ • transverse d w r))
  have h2 := Finset.card_union_le
    (({T • w, -(T • w)} : Finset (Fin n → ℝ)) ∪
      Finset.univ.image (fun r : PairLabel n => T⁻¹ • transverse d w r))
    (Finset.univ.image (fun r : PairLabel n => -(T⁻¹ • transverse d w r)))
  rw [pairLabel_card] at hp hm
  have hcount := twice_choose_two n
  unfold metricVertices
  omega

/-- The coordinates are unchanged; only their norm is made explicitly Euclidean. -/
def asEuclidean (n : ℕ) : (Fin n → ℝ) ≃L[ℝ] EuclideanSpace ℝ (Fin n) :=
  (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin n => ℝ)).symm

def euclideanDiameter {n : ℕ} (K : Set (Fin n → ℝ)) : ℝ :=
  Metric.diam (asEuclidean n '' K)

theorem metricPolytope_diameter_ge_coordinate {n : ℕ}
    (d : Fin n → Fin n → ℝ) (w : Fin n → ℝ) (T : ℝ)
    (hT : 0 ≤ T) (i : Fin n) (hwi : 0 ≤ w i) :
    2 * T * w i ≤ euclideanDiameter (metricPolytope d w T) := by
  have hc := (metricPolytope_compact d w T).image (asEuclidean n).continuous
  have hp : asEuclidean n (T • w) ∈ asEuclidean n '' metricPolytope d w T :=
    ⟨T • w, metricPolytope_axis_pos d w T, rfl⟩
  have hm : asEuclidean n (-(T • w)) ∈ asEuclidean n '' metricPolytope d w T :=
    ⟨-(T • w), metricPolytope_axis_neg d w T, rfl⟩
  have hd := Metric.dist_le_diam_of_mem hc.isBounded hp hm
  have hn := PiLp.norm_apply_le
    (asEuclidean n (T • w) - asEuclidean n (-(T • w))) i
  have hcoord : ‖(asEuclidean n (T • w) - asEuclidean n (-(T • w))) i‖ =
      2 * T * w i := by
    change |T * w i - -(T * w i)| = _
    rw [abs_of_nonneg (by nlinarith [mul_nonneg hT hwi])]
    ring
  rw [hcoord] at hn
  exact hn.trans (by simpa [dist_eq_norm, euclideanDiameter] using hd)

def planeSwap : V2 →ₗ[ℝ] V2 := Matrix.toLin' !![0,1;1,0]

theorem planeSwap_apply (x : V2) : planeSwap x = ![x 1,x 0] := by
  ext k
  fin_cases k <;> simp [planeSwap,Matrix.toLin'_apply,Matrix.mulVec,dotProduct,
    Fin.sum_univ_two]

theorem coordinate_area_reverse {n : ℕ} (B : Set (Fin n → ℝ)) (i j : Fin n) :
    (volume : Measure V2).real (projectN j i '' B) =
      (volume : Measure V2).real (projectN i j '' B) := by
  have hset : projectN j i '' B = planeSwap '' (projectN i j '' B) := by
    simp only [image_image]
    congr 1
    funext x
    simp [projectN, planeSwap_apply]
  rw [hset, ProjectionAreaCoordinateLifts.area_linear_image]
  simp [planeSwap, LinearMap.det_toLin', Matrix.det_fin_two]

theorem metricPolytope_all_areas {n : ℕ} (d : Fin n → Fin n → ℝ)
    (w : Fin n → ℝ) (hsym : ∀ i j, d i j = d j i) (hdiag : ∀ i, d i i = 0)
    (T : ℝ)
    (hordered : ∀ p : PairLabel n,
      (volume : Measure V2).real (projectN p.val.1 p.val.2 '' metricPolytope d w T) =
        w p.val.1 * w p.val.2 * d p.val.1 p.val.2)
    (i j : Fin n) :
    (volume : Measure V2).real (projectN i j '' metricPolytope d w T) =
      w i * w j * d i j := by
  rcases lt_trichotomy i j with hij | hij | hij
  · exact hordered ⟨(i,j),hij⟩
  · subst j
    simp [same_coordinate_area_zero, hdiag]
  · rw [coordinate_area_reverse, hordered ⟨(j,i),hij⟩, hsym j i]
    ring

/-- Theorem 4.1, including the stated vertex bound and arbitrarily large
Euclidean diameter. All coordinate areas are actual Lebesgue measures.
The ambient dimension is positive; in dimension one the pair conditions
are empty and the constructed polytope is a segment. -/
theorem strict_weighted_realization {n : ℕ} (hn : 0 < n)
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < q i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j < w j * q i k + w i * q j k)
    (R : ℝ) :
    ∃ S : Finset (Fin n → ℝ), S.card ≤ n * (n-1) + 2 ∧
      let K := convexHull ℝ (S : Set (Fin n → ℝ))
      IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧ -K = K ∧
      (∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j) ∧
      R < euclideanDiameter K := by
  let d := rescaledDistance q w
  have hds := rescaledDistance_symm q w hsym
  have hdd := rescaledDistance_diag q w hdiag
  have hdp := rescaledDistance_pos q w hw hpos
  have hdt := rescaledDistance_strict q w hw hstrict
  obtain ⟨M,hM,hareas⟩ := exists_metricPolytope_threshold d w hds hdd hdp hw hdt
  let i : Fin n := ⟨0,hn⟩
  let T : ℝ := M + (|R|+1)/(2*w i) + 1
  have hden : 0 < 2*w i := mul_pos (by norm_num) (hw i)
  have hT : M ≤ T := by
    have hquot : 0 < (|R|+1)/(2*w i) := div_pos (by positivity) hden
    dsimp [T]
    linarith
  have hTp : 0 < T := hM.trans_le hT
  have hR : R < 2*T*w i := by
    have hf : ((|R|+1)/(2*w i))*(2*w i) = |R|+1 :=
      div_mul_cancel₀ _ hden.ne'
    have hprod : 0 < M * (2*w i) := mul_pos hM hden
    dsimp [T]
    nlinarith [le_abs_self R]
  refine ⟨metricVertices d w T, metricVertices_card d w T,
    metricPolytope_compact d w T, metricPolytope_convex d w T,
    ⟨T • w, metricPolytope_axis_pos d w T⟩,
    metricPolytope_centrally_symmetric d w T, ?_, ?_⟩
  · intro j k
    change (volume : Measure V2).real
      (projectN j k '' metricPolytope d w T) = q j k
    rw [metricPolytope_all_areas d w hds hdd T (hareas T hT)]
    dsimp [d, rescaledDistance]
    exact mul_div_cancel₀ _ (mul_ne_zero (hw j).ne' (hw k).ne')
  · exact hR.trans_le (metricPolytope_diameter_ge_coordinate d w T hTp.le i (hw i).le)

/-- Every extreme point of a finite convex hull is one of its generators.
This bridges the explicit construction's generating-set bound to the paper's
bound on actual vertices. Finiteness is included because `Set.ncard` alone
does not assert that a set is finite. -/
theorem convexHull_vertices_card_le {n : ℕ} (S : Finset (Fin n → ℝ)) :
    ((convexHull ℝ (S : Set (Fin n → ℝ))).extremePoints ℝ).Finite ∧
      ((convexHull ℝ (S : Set (Fin n → ℝ))).extremePoints ℝ).ncard ≤ S.card := by
  have hsub : (convexHull ℝ (S : Set (Fin n → ℝ))).extremePoints ℝ ⊆
      (S : Set (Fin n → ℝ)) := extremePoints_convexHull_subset
  exact ⟨S.finite_toSet.subset hsub,
    by simpa using Set.ncard_le_ncard hsub S.finite_toSet⟩

/-- Theorem 4.1 with both the number of generators and the number of actual
vertices stated explicitly. -/
theorem strict_weighted_realization_with_vertex_bound {n : ℕ} (hn : 0 < n)
    (q : Fin n → Fin n → ℝ) (w : Fin n → ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hpos : ∀ i j, i ≠ j → 0 < q i j) (hw : ∀ i, 0 < w i)
    (hstrict : ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
      w k * q i j < w j * q i k + w i * q j k)
    (R : ℝ) :
    ∃ S : Finset (Fin n → ℝ), S.card ≤ n * (n-1) + 2 ∧
      let K := convexHull ℝ (S : Set (Fin n → ℝ))
      IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧ -K = K ∧
      (∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j) ∧
      R < euclideanDiameter K ∧
      (K.extremePoints ℝ).Finite ∧ (K.extremePoints ℝ).ncard ≤ n * (n-1) + 2 := by
  obtain ⟨S, hcard, hcompact, hconvex, hnonempty, hsymm, harea, hdiam⟩ :=
    strict_weighted_realization hn q w hsym hdiag hpos hw hstrict R
  obtain ⟨hfinite, hvertices⟩ := convexHull_vertices_card_le S
  exact ⟨S, hcard, hcompact, hconvex, hnonempty, hsymm, harea, hdiam,
    hfinite, hvertices.trans hcard⟩

end
