section Source_IntervalOverlap

@[expose] public section

/-!
# Cross-intersecting intervals

The signed overlap of two intervals is the common length when they meet,
and the negative gap between them when they do not. If each of the first
pair intersects each of the second pair, the sum of the two signed overlaps
is nonnegative. The proof is purely ordered-field algebra; no geometric
area identity is assumed.
-/

namespace ProjectionAreaIntervals

/-- Length of the overlap, with a negative value recording a separating gap. -/
def signedOverlap (a b c d : ℝ) : ℝ := min b d - max a c

/-- Endpoint form of the cross-intersection lemma. -/
theorem signedOverlap_add_nonnegative
    (a b c d e f g h : ℝ)
    (hae : a ≤ f) (hea : e ≤ b)
    (hag : a ≤ h) (hga : g ≤ b)
    (hce : c ≤ f) (hec : e ≤ d)
    (hcg : c ≤ h) (hgc : g ≤ d) :
    0 ≤ signedOverlap a b c d + signedOverlap e f g h := by
  have hfirst : max a c ≤ min f h :=
    le_min (max_le hae hce) (max_le hag hcg)
  have hsecond : max e g ≤ min b d :=
    le_min (max_le hea hga) (max_le hec hgc)
  unfold signedOverlap
  linarith

/-- The lemma stated using actual nonempty intersections of closed intervals. -/
theorem signedOverlap_add_nonnegative_of_cross_intersections
    (a b c d e f g h : ℝ)
    (hAC : (Set.Icc a b ∩ Set.Icc e f).Nonempty)
    (hAD : (Set.Icc a b ∩ Set.Icc g h).Nonempty)
    (hBC : (Set.Icc c d ∩ Set.Icc e f).Nonempty)
    (hBD : (Set.Icc c d ∩ Set.Icc g h).Nonempty) :
    0 ≤ signedOverlap a b c d + signedOverlap e f g h := by
  obtain ⟨x, hxA, hxC⟩ := hAC
  obtain ⟨y, hyA, hyD⟩ := hAD
  obtain ⟨z, hzB, hzC⟩ := hBC
  obtain ⟨w, hwB, hwD⟩ := hBD
  exact signedOverlap_add_nonnegative a b c d e f g h
    (hxA.1.trans hxC.2) (hxC.1.trans hxA.2)
    (hyA.1.trans hyD.2) (hyD.1.trans hyA.2)
    (hzB.1.trans hzC.2) (hzC.1.trans hzB.2)
    (hwB.1.trans hwD.2) (hwD.1.trans hwB.2)

/-- The scalar lower bound after summing the endpoint trapezoid and the two
extreme-point triangles in the planar argument. -/
theorem trapezoid_triangle_expression_lower_bound
    (a b c d s t : ℝ)
    (hs0 : 0 ≤ s) (hs1 : s ≤ 1) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    (1 + signedOverlap a b c d) / 2 ≤
      (1 + t*b + (1-t)*d - s*a - (1-s)*c) / 2 := by
  have hupper : min b d ≤ t*b + (1-t)*d := by
    have h1 := mul_le_mul_of_nonneg_left (min_le_left b d) ht0
    have h2 := mul_le_mul_of_nonneg_left (min_le_right b d) (sub_nonneg.mpr ht1)
    nlinarith
  have hlower : s*a + (1-s)*c ≤ max a c := by
    have h1 := mul_le_mul_of_nonneg_left (le_max_left a c) hs0
    have h2 := mul_le_mul_of_nonneg_left (le_max_right a c) (sub_nonneg.mpr hs1)
    nlinarith
  unfold signedOverlap
  linarith

/-- Once the two planar lower bounds have been established geometrically,
the cross-intersection lemma gives the three-dimensional area inequality. -/
theorem two_projection_lower_bound
    (a b c d e f g h areaXZ areaYZ : ℝ)
    (hAC : (Set.Icc a b ∩ Set.Icc e f).Nonempty)
    (hAD : (Set.Icc a b ∩ Set.Icc g h).Nonempty)
    (hBC : (Set.Icc c d ∩ Set.Icc e f).Nonempty)
    (hBD : (Set.Icc c d ∩ Set.Icc g h).Nonempty)
    (hxz : (1 + signedOverlap a b c d) / 2 ≤ areaXZ)
    (hyz : (1 + signedOverlap e f g h) / 2 ≤ areaYZ) :
    1 ≤ areaXZ + areaYZ := by
  have hsum := signedOverlap_add_nonnegative_of_cross_intersections
    a b c d e f g h hAC hAD hBC hBD
  linarith

end ProjectionAreaIntervals

end
end Source_IntervalOverlap

