/-! ## StrictZonotopeAlgebra -/
section StrictZonotopeAlgebraSource

/-!
Exact scalar and matrix algebra for the strict four-dimensional construction.
The geometric assertion that its planar shadows are parallelograms is proved
separately by an explicit table of the projected segment directions.
-/

open Matrix

namespace ProjectionAreaStrictZonotope

theorem root_product (u v w : ℝ) (hu : 0 < u) (hv : 0 < v) (hw : 0 < w) :
    Real.sqrt (u * v / w) * Real.sqrt (u * w / v) = u := by
  rw [← Real.sqrt_mul (le_of_lt (div_pos (mul_pos hu hv) hw))]
  have h : (u * v / w) * (u * w / v) = u ^ 2 := by
    field_simp
  rw [h, Real.sqrt_sq (le_of_lt hu)]

theorem three_root_products (u v w : ℝ)
    (hu : 0 < u) (hv : 0 < v) (hw : 0 < w) :
    let x := Real.sqrt (u * v / w)
    let y := Real.sqrt (u * w / v)
    let z := Real.sqrt (v * w / u)
    0 < x ∧ 0 < y ∧ 0 < z ∧ x * y = u ∧ x * z = v ∧ y * z = w := by
  dsimp only
  refine ⟨Real.sqrt_pos.mpr (div_pos (mul_pos hu hv) hw),
    Real.sqrt_pos.mpr (div_pos (mul_pos hu hw) hv),
    Real.sqrt_pos.mpr (div_pos (mul_pos hv hw) hu),
    root_product u v w hu hv hw, ?_, ?_⟩
  · simpa only [mul_comm v u] using root_product v u w hv hu hw
  · simpa only [mul_comm w u, mul_comm w v] using root_product w u v hw hu hv

theorem strict_parameters_and_areas (A B C : ℝ)
    (hA : A < B + C) (hB : B < A + C) (hC : C < A + B) :
    let u := (A + B - C) / 4
    let v := (A + C - B) / 4
    let w := (B + C - A) / 4
    0 < u ∧ 0 < v ∧ 0 < w ∧
      2 * (u + v) = A ∧ 2 * (u + w) = B ∧ 2 * (v + w) = C := by
  dsimp only
  constructor
  · linarith
  constructor
  · linarith
  constructor
  · linarith
  constructor
  · ring
  constructor <;> ring

def normalizedMatrix (A B C : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![0, A, B, C; A, 0, C, B; B, C, 0, A; C, B, A, 0]

theorem hadamard_eigenvectors (A B C : ℝ) :
    normalizedMatrix A B C *ᵥ ![1, 1, 1, 1] =
      (A + B + C) • ![1, 1, 1, 1] ∧
    normalizedMatrix A B C *ᵥ ![1, 1, -1, -1] =
      (A - B - C) • ![1, 1, -1, -1] ∧
    normalizedMatrix A B C *ᵥ ![1, -1, 1, -1] =
      (B - A - C) • ![1, -1, 1, -1] ∧
    normalizedMatrix A B C *ᵥ ![1, -1, -1, 1] =
      (C - A - B) • ![1, -1, -1, 1] := by
  repeat' constructor
  all_goals
    ext i
    fin_cases i <;> simp [normalizedMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
      <;> ring

end ProjectionAreaStrictZonotope
end StrictZonotopeAlgebraSource

/-! ## StrictZonotopeGeometry -/
section StrictZonotopeGeometrySource

/-!
Exact set geometry for the three-segment construction in dimension four.
We use its centrally translated version.  All coefficient intervals are
closed, so the lemmas include zero side lengths.
-/

open Set Matrix Module MeasureTheory
open scoped BigOperators Pointwise
open ProjectionAreaBoundaryPolytope

namespace ProjectionAreaStrictGeometry

noncomputable section

def centered {n : ℕ} {E : Type*} [AddCommGroup E] [Module ℝ E]
    (v : Fin n → E) : Set E :=
  (fun t : Fin n → ℝ => ∑ i, t i • v i) '' Icc (-1) 1

def combination {n : ℕ} {E : Type*} [AddCommGroup E] [Module ℝ E]
    (v : Fin n → E) : (Fin n → ℝ) →ₗ[ℝ] E where
  toFun t := ∑ i, t i • v i
  map_add' t u := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' r t := by simp [Finset.smul_sum, smul_smul]

theorem image_centered {n : ℕ} {E F : Type*}
    [AddCommGroup E] [Module ℝ E] [AddCommGroup F] [Module ℝ F]
    (f : E →ₗ[ℝ] F) (v : Fin n → E) :
    f '' centered v = centered (f ∘ v) := by
  simp only [centered, ← image_comp]
  congr 1
  funext t
  simp [map_sum, map_smul]

theorem convex_centered {n : ℕ} {E : Type*} [AddCommGroup E] [Module ℝ E]
    (v : Fin n → E) : Convex ℝ (centered v) := by
  exact (convex_Icc (-1 : Fin n → ℝ) 1).linear_image (combination v)

theorem isCompact_centered {n : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (v : Fin n → E) :
    IsCompact (centered v) := by
  exact isCompact_Icc.image (combination v).continuous_of_finiteDimensional

theorem centered_nonempty {n : ℕ} {E : Type*} [AddCommGroup E] [Module ℝ E]
    (v : Fin n → E) : (centered v).Nonempty := by
  refine ⟨0, ⟨0, ?_, ?_⟩⟩
  · constructor <;> intro i <;> norm_num
  · simp

theorem mem_centered_two (a b p : V2) :
    p ∈ centered ![a,b] ↔
      ∃ s t : ℝ, s ∈ Icc (-1) 1 ∧ t ∈ Icc (-1) 1 ∧ p = s • a + t • b := by
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u 0, u 1, ⟨hu.1 0, hu.2 0⟩, ⟨hu.1 1, hu.2 1⟩,
      by simp [Fin.sum_univ_two]⟩
  · rintro ⟨s,t,hs,ht,rfl⟩
    refine ⟨![s,t], ?_, ?_⟩
    · constructor <;> intro i <;> fin_cases i <;> simp_all
    · simp [Fin.sum_univ_two]

theorem mem_centered_three (a b c p : V2) :
    p ∈ centered ![a,b,c] ↔
      ∃ s t u : ℝ, s ∈ Icc (-1) 1 ∧ t ∈ Icc (-1) 1 ∧ u ∈ Icc (-1) 1 ∧
        p = s • a + t • b + u • c := by
  constructor
  · rintro ⟨v, hv, rfl⟩
    exact ⟨v 0, v 1, v 2, ⟨hv.1 0, hv.2 0⟩, ⟨hv.1 1, hv.2 1⟩,
      ⟨hv.1 2, hv.2 2⟩, by simp [Fin.sum_univ_succ, add_assoc]⟩
  · rintro ⟨s,t,u,hs,ht,hu,rfl⟩
    refine ⟨![s,t,u], ?_, ?_⟩
    · constructor <;> intro i <;> fin_cases i <;> simp_all
    · simp [Fin.sum_univ_succ, add_assoc]

theorem centered_merge (a v : V2) (b c : ℝ) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    centered ![a,b • v,c • v] = centered ![a,(b+c) • v] := by
  ext p
  rw [mem_centered_three, mem_centered_two]
  constructor
  · rintro ⟨s,t,u,hs,ht,hu,rfl⟩
    by_cases hbc : b+c = 0
    · have hb0 : b = 0 := by linarith
      have hc0 : c = 0 := by linarith
      refine ⟨s,0,hs,by norm_num,?_⟩
      simp [hb0,hc0]
    · have hpos : 0 < b+c := lt_of_le_of_ne (add_nonneg hb hc) (Ne.symm hbc)
      refine ⟨s,(t*b+u*c)/(b+c),hs,?_,?_⟩
      · constructor
        · apply (le_div_iff₀ hpos).2
          nlinarith [mul_nonneg (show 0 ≤ t+1 by linarith [ht.1]) hb,
            mul_nonneg (show 0 ≤ u+1 by linarith [hu.1]) hc]
        · apply (div_le_iff₀ hpos).2
          nlinarith [mul_nonneg (show 0 ≤ 1-t by linarith [ht.2]) hb,
            mul_nonneg (show 0 ≤ 1-u by linarith [hu.2]) hc]
      · rw [smul_smul, smul_smul, smul_smul, div_mul_cancel₀ _ hbc, add_smul]
        abel
  · rintro ⟨s,t,hs,ht,rfl⟩
    refine ⟨s,t,t,hs,ht,ht,?_⟩
    simp only [smul_smul, add_smul, smul_add, add_assoc]

theorem centered_three_neg_first (a b c : V2) :
    centered ![-a,b,c] = centered ![a,b,c] := by
  ext p
  simp only [mem_centered_three]
  constructor
  · rintro ⟨s,t,u,hs,ht,hu,hp⟩
    exact ⟨-s,t,u,by constructor <;> linarith [hs.1,hs.2],ht,hu,by simpa using hp⟩
  · rintro ⟨s,t,u,hs,ht,hu,hp⟩
    exact ⟨-s,t,u,by constructor <;> linarith [hs.1,hs.2],ht,hu,by simpa using hp⟩

theorem centered_three_neg_last (a b c : V2) :
    centered ![a,b,-c] = centered ![a,b,c] := by
  ext p
  simp only [mem_centered_three]
  constructor
  · rintro ⟨s,t,u,hs,ht,hu,hp⟩
    exact ⟨s,t,-u,hs,ht,by constructor <;> linarith [hu.1,hu.2],by simpa using hp⟩
  · rintro ⟨s,t,u,hs,ht,hu,hp⟩
    exact ⟨s,t,-u,hs,ht,by constructor <;> linarith [hu.1,hu.2],by simpa using hp⟩

theorem centered_three_swap (a b c : V2) :
    centered ![a,b,c] = centered ![b,a,c] := by
  ext p
  simp only [mem_centered_three]
  constructor <;> rintro ⟨s,t,u,hs,ht,hu,hp⟩
  · exact ⟨t,s,u,ht,hs,hu,by simpa [add_comm,add_left_comm,add_assoc] using hp⟩
  · exact ⟨t,s,u,ht,hs,hu,by simpa [add_comm,add_left_comm,add_assoc] using hp⟩

theorem centered_three_rotate (a b c : V2) :
    centered ![a,b,c] = centered ![c,a,b] := by
  ext p
  simp only [mem_centered_three]
  constructor
  · rintro ⟨s,t,u,hs,ht,hu,hp⟩
    exact ⟨u,s,t,hu,hs,ht,by simpa [add_comm,add_left_comm,add_assoc] using hp⟩
  · rintro ⟨s,t,u,hs,ht,hu,hp⟩
    exact ⟨t,u,s,ht,hu,hs,by simpa [add_comm,add_left_comm,add_assoc] using hp⟩

def firstDirection : V4 := ![1,1,-1,-1]
def secondDirection : V4 := ![1,-1,1,-1]
def thirdDirection : V4 := ![1,-1,-1,1]

def generators (x y z : ℝ) : Fin 3 → V4 :=
  ![(x/2) • firstDirection,(y/2) • secondDirection,(z/2) • thirdDirection]

def body (x y z : ℝ) : Set V4 := centered (generators x y z)

theorem body_properties (x y z : ℝ) :
    IsCompact (body x y z) ∧ Convex ℝ (body x y z) ∧ (body x y z).Nonempty :=
  ⟨isCompact_centered _, convex_centered _, centered_nonempty _⟩

def diagonalUp : V2 := ![1,1]
def diagonalDown : V2 := ![1,-1]

def shadow (a b : ℝ) : Set V2 :=
  centered ![(a/2) • diagonalUp,(b/2) • diagonalDown]

theorem six_projected_generators (x y z : ℝ) :
    (project 0 1) ∘ generators x y z =
      ![(x/2) • diagonalUp,(y/2) • diagonalDown,(z/2) • diagonalDown] ∧
    (project 2 3) ∘ generators x y z =
      ![-((x/2) • diagonalUp),(y/2) • diagonalDown,-((z/2) • diagonalDown)] ∧
    (project 0 2) ∘ generators x y z =
      ![(x/2) • diagonalDown,(y/2) • diagonalUp,(z/2) • diagonalDown] ∧
    (project 1 3) ∘ generators x y z =
      ![(x/2) • diagonalDown,-((y/2) • diagonalUp),-((z/2) • diagonalDown)] ∧
    (project 0 3) ∘ generators x y z =
      ![(x/2) • diagonalDown,(y/2) • diagonalDown,(z/2) • diagonalUp] ∧
    (project 1 2) ∘ generators x y z =
      ![(x/2) • diagonalDown,-((y/2) • diagonalDown),-((z/2) • diagonalUp)] := by
  repeat' constructor
  all_goals
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [project, generators, firstDirection,secondDirection,
        thirdDirection,diagonalUp,diagonalDown]

theorem merge_shadow (a b c : ℝ) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    centered ![(a/2) • diagonalUp,(b/2) • diagonalDown,(c/2) • diagonalDown] =
      shadow a (b+c) := by
  rw [centered_merge _ _ _ _ (by positivity) (by positivity)]
  rw [show b/2+c/2 = (b+c)/2 by ring]
  rfl

theorem six_shadows (x y z : ℝ) (hx : 0 ≤ x) (hy : 0 ≤ y) (hz : 0 ≤ z) :
    project 0 1 '' body x y z = shadow x (y+z) ∧
    project 2 3 '' body x y z = shadow x (y+z) ∧
    project 0 2 '' body x y z = shadow y (x+z) ∧
    project 1 3 '' body x y z = shadow y (x+z) ∧
    project 0 3 '' body x y z = shadow z (x+y) ∧
    project 1 2 '' body x y z = shadow z (x+y) := by
  obtain ⟨h12,h34,h13,h24,h14,h23⟩ := six_projected_generators x y z
  simp only [body, image_centered,h12,h34,h13,h24,h14,h23]
  refine ⟨merge_shadow x y z hy hz, ?_, ?_, ?_, ?_, ?_⟩
  · rw [centered_three_neg_first, centered_three_neg_last]
    exact merge_shadow x y z hy hz
  · rw [centered_three_swap]
    exact merge_shadow y x z hx hz
  · rw [centered_three_swap, centered_three_neg_first, centered_three_neg_last]
    exact merge_shadow y x z hx hz
  · rw [centered_three_rotate]
    exact merge_shadow z x y hx hy
  · rw [centered_three_rotate, centered_three_neg_first, centered_three_neg_last]
    exact merge_shadow z x y hx hy

end

end ProjectionAreaStrictGeometry
end StrictZonotopeGeometrySource

/-! ## StrictZonotopeAreas -/
section StrictZonotopeAreasSource

/-!
Actual Lebesgue projection areas for the centrally translated three-segment
construction.  The final theorem constructs one compact convex set for all
six normalized strict-triangle data simultaneously.
-/

open Set Matrix Module MeasureTheory
open scoped BigOperators Pointwise
open ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryAreas
open ProjectionAreaStrictZonotope

namespace ProjectionAreaStrictGeometry

theorem centered_two_as_translated_parallelogram (a b : V2) :
    centered ![a,b] =
      (fun x : V2 => -a-b+x) '' parallelepiped ![(2:ℝ) • a,(2:ℝ) • b] := by
  ext p
  rw [mem_centered_two]
  constructor
  · rintro ⟨s,t,hs,ht,rfl⟩
    refine ⟨(s+1) • a+(t+1) • b, ?_, ?_⟩
    · rw [mem_parallelepiped_iff]
      refine ⟨![(s+1)/2,(t+1)/2], ?_, ?_⟩
      · constructor <;> intro i <;> fin_cases i <;> simp <;> linarith [hs.1,hs.2,ht.1,ht.2]
      · ext i
        simp [Fin.sum_univ_two]
        ring
    · ext i
      simp
      ring
  · rintro ⟨q,hq,rfl⟩
    obtain ⟨r,hr,rfl⟩ := (mem_parallelepiped_iff _ _).mp hq
    change (∀ i, (0 : ℝ) ≤ r i) ∧ (∀ i, r i ≤ 1) at hr
    refine ⟨2*r 0-1,2*r 1-1,?_,?_,?_⟩
    · constructor <;> linarith [hr.1 0,hr.2 0]
    · constructor <;> linarith [hr.1 1,hr.2 1]
    · ext i
      simp [Fin.sum_univ_two]
      ring

theorem area_centered_two (a b : V2) :
    (volume : Measure V2).real (centered ![a,b]) = 4*|det2 a b| := by
  rw [centered_two_as_translated_parallelogram,
    translated_parallelogram_eq_hull,area_translated_parallelogram_hull]
  have hdet : det2 ((2:ℝ) • a) ((2:ℝ) • b) = 4*det2 a b := by
    simp [det2]
    ring
  rw [hdet,abs_mul]
  norm_num

theorem shadow_area (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    (volume : Measure V2).real (shadow a b) = 2*a*b := by
  rw [shadow,area_centered_two]
  have hdet : det2 ((a/2) • diagonalUp) ((b/2) • diagonalDown) = -(a*b)/2 := by
    simp [det2,diagonalUp,diagonalDown]
    ring
  have hnonpos : -(a*b)/2 ≤ 0 := by
    have hprod := mul_nonneg ha hb
    linarith
  rw [hdet,abs_of_nonpos hnonpos]
  ring

theorem six_actual_projection_areas (x y z : ℝ)
    (hx : 0 ≤ x) (hy : 0 ≤ y) (hz : 0 ≤ z) :
    (volume : Measure V2).real (project 0 1 '' body x y z) = 2*x*(y+z) ∧
    (volume : Measure V2).real (project 2 3 '' body x y z) = 2*x*(y+z) ∧
    (volume : Measure V2).real (project 0 2 '' body x y z) = 2*y*(x+z) ∧
    (volume : Measure V2).real (project 1 3 '' body x y z) = 2*y*(x+z) ∧
    (volume : Measure V2).real (project 0 3 '' body x y z) = 2*z*(x+y) ∧
    (volume : Measure V2).real (project 1 2 '' body x y z) = 2*z*(x+y) := by
  obtain ⟨h12,h34,h13,h24,h14,h23⟩ := six_shadows x y z hx hy hz
  rw [h12,h34,h13,h24,h14,h23,
    shadow_area x (y+z) hx (add_nonneg hy hz),
    shadow_area y (x+z) hy (add_nonneg hx hz),
    shadow_area z (x+y) hz (add_nonneg hx hy)]
  exact ⟨rfl,rfl,rfl,rfl,rfl,rfl⟩

theorem exists_strict_triangle_realizer (A B C : ℝ)
    (hA : A < B+C) (hB : B < A+C) (hC : C < A+B) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      (volume : Measure V2).real (project 0 1 '' K) = A ∧
      (volume : Measure V2).real (project 2 3 '' K) = A ∧
      (volume : Measure V2).real (project 0 2 '' K) = B ∧
      (volume : Measure V2).real (project 1 3 '' K) = B ∧
      (volume : Measure V2).real (project 0 3 '' K) = C ∧
      (volume : Measure V2).real (project 1 2 '' K) = C := by
  let u := (A+B-C)/4
  let v := (A+C-B)/4
  let w := (B+C-A)/4
  obtain ⟨hu,hv,hw,hAeq,hBeq,hCeq⟩ := strict_parameters_and_areas A B C hA hB hC
  change 0 < u at hu
  change 0 < v at hv
  change 0 < w at hw
  change 2*(u+v) = A at hAeq
  change 2*(u+w) = B at hBeq
  change 2*(v+w) = C at hCeq
  let x := Real.sqrt (u*v/w)
  let y := Real.sqrt (u*w/v)
  let z := Real.sqrt (v*w/u)
  obtain ⟨hx,hy,hz,hxy,hxz,hyz⟩ := three_root_products u v w hu hv hw
  change 0 < x at hx
  change 0 < y at hy
  change 0 < z at hz
  change x*y = u at hxy
  change x*z = v at hxz
  change y*z = w at hyz
  obtain ⟨h12,h34,h13,h24,h14,h23⟩ := six_actual_projection_areas x y z hx.le hy.le hz.le
  obtain ⟨hcompact,hconvex,hnonempty⟩ := body_properties x y z
  refine ⟨body x y z,hcompact,hconvex,hnonempty,?_,?_,?_,?_,?_,?_⟩
  · nlinarith only [h12,hxy,hxz,hAeq]
  · nlinarith only [h34,hxy,hxz,hAeq]
  · nlinarith only [h13,hxy,hyz,hBeq]
  · nlinarith only [h24,hxy,hyz,hBeq]
  · nlinarith only [h14,hxz,hyz,hCeq]
  · nlinarith only [h23,hxz,hyz,hCeq]

end ProjectionAreaStrictGeometry
end StrictZonotopeAreasSource

/-! ## BoundaryOctagonTiling -/
section BoundaryOctagonTilingSource

/-!
A six-parallelogram dissection of the boundary construction's octagon.
All inequalities are non-strict, including the two endpoint parameters.
This module contains only exact set geometry; its measure calculation is
kept in BoundaryPolygonAreas.
-/

open Set Matrix
open scoped Pointwise
open ProjectionAreaBoundaryPolytope

namespace ProjectionAreaBoundaryTiling

def tile (c : ℝ) : Fin 6 → Set V2 := ![
  {p | 0 ≤ p 1 ∧ p 1 ≤ c ∧ 0 ≤ p 0-p 1 ∧ p 0-p 1 ≤ 2*(1-c)},
  {p | c ≤ p 0 ∧ p 0 ≤ 2-c ∧ c ≤ p 1 ∧ p 1 ≤ 2-c},
  {p | 0 ≤ p 0 ∧ p 0 ≤ c ∧ 0 ≤ p 1-p 0 ∧ p 1-p 0 ≤ 2*(1-c)},
  {p | 2-c ≤ p 1 ∧ p 1 ≤ 2 ∧ 2 ≤ p 0+p 1 ∧ p 0+p 1 ≤ 4-2*c},
  {p | 2*(1-c) ≤ p 0+p 1 ∧ p 0+p 1 ≤ 2 ∧
    2*(1-c) ≤ p 1-p 0 ∧ p 1-p 0 ≤ 2},
  {p | -c ≤ p 0 ∧ p 0 ≤ 0 ∧ 0 ≤ p 0+p 1 ∧ p 0+p 1 ≤ 2*(1-c)}]

def region (c : ℝ) : Set V2 :=
  {p | -c ≤ p 0 ∧ p 0 ≤ 2-c ∧ 0 ≤ p 1 ∧ p 1 ≤ 2 ∧
    0 ≤ p 0+p 1 ∧ p 0+p 1 ≤ 4-2*c ∧ -2*(1-c) ≤ p 1-p 0 ∧ p 1-p 0 ≤ 2}

theorem union_tiles_eq_region (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    (⋃ i, tile c i) = region c := by
  ext p
  constructor
  · intro hp
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hp
    fin_cases i <;> dsimp [tile] at hi
    all_goals rcases hi with ⟨h₁,h₂,h₃,h₄⟩
    all_goals dsimp [region]
    all_goals repeat' apply And.intro
    all_goals linarith
  · rintro ⟨hx₀,hx₁,hy₀,hy₁,hs₀,hs₁,hd₀,hd₁⟩
    by_cases hx : p 0 ≤ 0
    · by_cases hs : p 0+p 1 ≤ 2*(1-c)
      · refine Set.mem_iUnion.mpr ⟨5, ?_⟩
        simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
        exact ⟨hx₀,hx,hs₀,hs⟩
      · refine Set.mem_iUnion.mpr ⟨4, ?_⟩
        simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
        exact ⟨le_of_not_ge hs, by linarith, by linarith, hd₁⟩
    · have hx' : 0 ≤ p 0 := le_of_not_ge hx
      by_cases hxc : p 0 ≤ c
      · by_cases hxy : p 1 ≤ p 0
        · refine Set.mem_iUnion.mpr ⟨0, ?_⟩
          simp only [tile, Matrix.cons_val_zero, Set.mem_ofPred_eq]
          exact ⟨hy₀,by linarith,by linarith,by linarith⟩
        · by_cases hd : p 1-p 0 ≤ 2*(1-c)
          · refine Set.mem_iUnion.mpr ⟨2, ?_⟩
            simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
            exact ⟨hx',hxc,by linarith,hd⟩
          · by_cases hs : p 0+p 1 ≤ 2
            · refine Set.mem_iUnion.mpr ⟨4, ?_⟩
              simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
              exact ⟨by linarith,hs,le_of_not_ge hd,hd₁⟩
            · refine Set.mem_iUnion.mpr ⟨3, ?_⟩
              simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
              exact ⟨by linarith,hy₁,le_of_not_ge hs,hs₁⟩
      · have hxc' : c ≤ p 0 := le_of_not_ge hxc
        by_cases hyc : p 1 ≤ c
        · refine Set.mem_iUnion.mpr ⟨0, ?_⟩
          simp only [tile, Matrix.cons_val_zero, Set.mem_ofPred_eq]
          exact ⟨hy₀,hyc,by linarith,by linarith⟩
        · by_cases hyc' : p 1 ≤ 2-c
          · refine Set.mem_iUnion.mpr ⟨1, ?_⟩
            simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
            exact ⟨hxc',hx₁,le_of_not_ge hyc,hyc'⟩
          · refine Set.mem_iUnion.mpr ⟨3, ?_⟩
            simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ, Set.mem_ofPred_eq]
            exact ⟨le_of_not_ge hyc',hy₁,by linarith,hs₁⟩

theorem convex_region (c : ℝ) : Convex ℝ (region c) := by
  let X : V2 →ₗ[ℝ] ℝ := LinearMap.proj 0
  let Y : V2 →ₗ[ℝ] ℝ := LinearMap.proj 1
  have hx := (convex_Icc (-c) (2-c)).linear_preimage X
  have hy := (convex_Icc (0 : ℝ) 2).linear_preimage Y
  have hs := (convex_Icc (0 : ℝ) (4-2*c)).linear_preimage (X+Y)
  have hd := (convex_Icc (-2*(1-c)) (2 : ℝ)).linear_preimage (Y-X)
  convert ((hx.inter hy).inter hs).inter hd using 1
  ext p
  simp [region, X, Y, and_assoc]

theorem convex_union_tiles (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    Convex ℝ (⋃ i, tile c i) := by
  rw [union_tiles_eq_region c hc₀ hc₁]
  exact convex_region c

theorem box_eq_hull (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    Set.Icc (0 : V2) ![a,b] =
      convexHull ℝ ({0,![a,0],![0,b],![a,b]} : Set V2) := by
  have hcorners : (Set.univ : Set (Fin 2)).pi (fun i => ({0, (![a,b] : V2) i} : Set ℝ)) =
      ({0,![a,0],![0,b],![a,b]} : Set V2) := by
    ext p
    simp only [Set.mem_pi, Set.mem_univ, forall_true_left, Fin.forall_fin_two,
      Set.mem_insert_iff, Set.mem_singleton_iff, Matrix.cons_val_zero,
      Matrix.cons_val_succ, Matrix.cons_val_one, Matrix.head_cons]
    constructor
    · rintro ⟨h₀,h₁⟩
      rcases h₀ with h₀|h₀ <;> rcases h₁ with h₁|h₁
      · left; ext i; fin_cases i <;> simp_all
      · right; right; left; ext i; fin_cases i <;> simp_all
      · right; left; ext i; fin_cases i <;> simp_all
      · right; right; right; ext i; fin_cases i <;> simp_all
    · rintro (rfl|rfl|rfl|rfl) <;> simp
  rw [← hcorners, convexHull_pi]
  ext p
  simp only [Set.mem_Icc, Pi.le_def, Fin.forall_fin_two, Pi.zero_apply,
    Matrix.cons_val_zero, Matrix.cons_val_succ, Matrix.cons_val_one, Matrix.head_cons, Set.mem_pi,
    Set.mem_univ, forall_true_left, convexHull_pair, segment_eq_Icc ha,
    segment_eq_Icc hb]
  tauto

def planeMap (a b c d : ℝ) : V2 →ₗ[ℝ] V2 where
  toFun p := ![a*p 0+b*p 1,c*p 0+d*p 1]
  map_add' p q := by ext i; fin_cases i <;> simp <;> ring
  map_smul' r p := by ext i; fin_cases i <;> simp <;> ring

def tileMap : Fin 6 → V2 →ₗ[ℝ] V2 := ![
  planeMap 1 1 0 1, planeMap 1 0 0 1, planeMap 1 0 1 1,
  planeMap 1 (-1) 0 1, planeMap 1 (-1) 1 1, planeMap 0 (-1) 1 1]

def tileOffset (c : ℝ) : Fin 6 → V2 :=
  ![0,![c,c],0,![c,2-c],![0,2*(1-c)],0]

def tileSize (c : ℝ) : Fin 6 → V2 :=
  ![![2*(1-c),c],![2*(1-c),2*(1-c)],![c,2*(1-c)],
    ![2*(1-c),c],![c,c],![2*(1-c),c]]

def tileAffine (c : ℝ) (i : Fin 6) : V2 →ᵃ[ℝ] V2 :=
  (AffineEquiv.constVAdd ℝ V2 (tileOffset c i)).toAffineMap.comp (tileMap i).toAffineMap

theorem tile_eq_affine_box (c : ℝ) (i : Fin 6) :
    tile c i = tileAffine c i '' Set.Icc (0 : V2) (tileSize c i) := by
  ext p
  constructor
  · intro hp
    fin_cases i
    all_goals simp only [tile, Matrix.cons_val_zero, Matrix.cons_val_succ,
      Set.mem_ofPred_eq] at hp
    all_goals rcases hp with ⟨h₁,h₂,h₃,h₄⟩
    · refine ⟨![p 0-p 1,p 1], ?_, ?_⟩
      · simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
        (repeat' apply And.intro) <;> linarith
      · ext j; fin_cases j <;> simp [tileAffine,tileOffset,tileMap,planeMap] <;> ring
    · refine ⟨![p 0-c,p 1-c], ?_, ?_⟩
      · simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
        (repeat' apply And.intro) <;> linarith
      · ext j; fin_cases j <;> simp [tileAffine,tileOffset,tileMap,planeMap] <;> ring
    · refine ⟨![p 0,p 1-p 0], ?_, ?_⟩
      · simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
        (repeat' apply And.intro) <;> linarith
      · ext j; fin_cases j <;> simp [tileAffine,tileOffset,tileMap,planeMap] <;> ring
    · refine ⟨![p 0+p 1-2,p 1-(2-c)], ?_, ?_⟩
      · simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
        (repeat' apply And.intro) <;> linarith
      · ext j; fin_cases j <;> simp [tileAffine,tileOffset,tileMap,planeMap] <;> ring
    · refine ⟨![(p 0+p 1-2*(1-c))/2,(p 1-p 0-2*(1-c))/2], ?_, ?_⟩
      · simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
        (repeat' apply And.intro) <;> linarith
      · ext j; fin_cases j <;> simp [tileAffine,tileOffset,tileMap,planeMap] <;> ring
    · refine ⟨![p 0+p 1,-p 0], ?_, ?_⟩
      · simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two]
        (repeat' apply And.intro) <;> linarith
      · ext j; fin_cases j <;> simp [tileAffine,tileOffset,tileMap,planeMap] <;> ring
  · rintro ⟨x,hx,rfl⟩
    fin_cases i
    all_goals simp [tileSize, Set.mem_Icc, Pi.le_def, Fin.forall_fin_two] at hx
    all_goals rcases hx with ⟨⟨h₁,h₂⟩,h₃,h₄⟩
    all_goals simp [tile,tileAffine,tileOffset,tileMap,planeMap]
    all_goals repeat' apply And.intro
    all_goals linarith

def tileEdgeA (c : ℝ) (i : Fin 6) : V2 := tileMap i ![(tileSize c i) 0,0]
def tileEdgeB (c : ℝ) (i : Fin 6) : V2 := tileMap i ![0,(tileSize c i) 1]

theorem tile_eq_parallelogram_hull (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1)
    (i : Fin 6) :
    tile c i = convexHull ℝ ({tileOffset c i,
      tileOffset c i+tileEdgeA c i, tileOffset c i+tileEdgeB c i,
      tileOffset c i+tileEdgeA c i+tileEdgeB c i} : Set V2) := by
  have hsize : 0 ≤ (tileSize c i) 0 ∧ 0 ≤ (tileSize c i) 1 := by
    fin_cases i <;> constructor <;> simp [tileSize] <;> linarith
  have hv : (![(tileSize c i) 0,(tileSize c i) 1] : V2) = tileSize c i := by
    ext j; fin_cases j <;> simp
  rw [tile_eq_affine_box, ← hv, box_eq_hull _ _ hsize.1 hsize.2,
    (tileAffine c i).image_convexHull]
  congr 1
  have hab : (![(tileSize c i) 0,(tileSize c i) 1] : V2) =
      ![(tileSize c i) 0,0]+![0,(tileSize c i) 1] := by
    ext j; fin_cases j <;> simp
  have hzero : tileAffine c i 0 = tileOffset c i := by simp [tileAffine]
  have ha : tileAffine c i ![(tileSize c i) 0,0] =
      tileOffset c i+tileEdgeA c i := by simp [tileAffine,tileEdgeA]
  have hb : tileAffine c i ![0,(tileSize c i) 1] =
      tileOffset c i+tileEdgeB c i := by simp [tileAffine,tileEdgeB]
  have hl : tileAffine c i ![(tileSize c i) 0,(tileSize c i) 1] =
      tileOffset c i+tileEdgeA c i+tileEdgeB c i := by
    change tileOffset c i+tileMap i ![(tileSize c i) 0,(tileSize c i) 1] =
      tileOffset c i+tileMap i ![(tileSize c i) 0,0]+tileMap i ![0,(tileSize c i) 1]
    rw [hab,map_add,add_assoc]
  simp only [Set.image_insert_eq,Set.image_singleton,hzero,ha,hb,hl]

def regionVertices (c : ℝ) : Set V2 :=
  {![-c,c],![0,0],![2-2*c,0],![2-c,c],![2-c,2-c],
    ![2-2*c,2],![0,2],![-c,2-c]}

theorem region_vertices_mem_region (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    regionVertices c ⊆ region c := by
  intro p hp
  simp only [regionVertices, Set.mem_insert_iff, Set.mem_singleton_iff] at hp
  rcases hp with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  all_goals dsimp [region]
  all_goals repeat' apply And.intro
  all_goals linarith

theorem tile_subset_vertices_hull (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1)
    (i : Fin 6) : tile c i ⊆ convexHull ℝ (regionVertices c) := by
  let H := convexHull ℝ (regionVertices c)
  have hm (x : V2) (hx : x ∈ regionVertices c) : x ∈ H := subset_convexHull ℝ _ hx
  have hv₀ : ![-c,c] ∈ H := hm _ (by simp [regionVertices])
  have hv₁ : ![0,0] ∈ H := hm _ (by simp [regionVertices])
  have hv₂ : ![2-2*c,0] ∈ H := hm _ (by simp [regionVertices])
  have hv₃ : ![2-c,c] ∈ H := hm _ (by simp [regionVertices])
  have hv₄ : ![2-c,2-c] ∈ H := hm _ (by simp [regionVertices])
  have hv₅ : ![2-2*c,2] ∈ H := hm _ (by simp [regionVertices])
  have hv₆ : ![0,2] ∈ H := hm _ (by simp [regionVertices])
  have hv₇ : ![-c,2-c] ∈ H := hm _ (by simp [regionVertices])
  have hH : Convex ℝ H := convex_convexHull ℝ _
  have hh : 0 ≤ 1-c := sub_nonneg.mpr hc₁
  have hu : ![c,c] ∈ H := by
    convert hH hv₃ hv₀ hc₀ hh (by ring) using 1
    ext j; fin_cases j <;> simp <;> ring
  have hu' : ![c,2-c] ∈ H := by
    convert hH hv₄ hv₇ hc₀ hh (by ring) using 1
    ext j; fin_cases j <;> simp <;> ring
  have hw : ![0,2-2*c] ∈ H := by
    convert hH hv₆ hv₁ hh hc₀ (by ring) using 1
    ext j; fin_cases j <;> simp <;> ring
  rw [tile_eq_parallelogram_hull c hc₀ hc₁ i]
  apply convexHull_min _ hH
  intro p hp
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
  fin_cases i <;> rcases hp with rfl|rfl|rfl|rfl
  · convert hv₁ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₂ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₃ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₃ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu' using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₄ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₁ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hw using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu' using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu' using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₄ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₆ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₅ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hw using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hu' using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₇ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₆ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₁ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hw using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₀ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring
  · convert hv₇ using 1 <;> ext j <;> fin_cases j <;>
      simp [tileOffset,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap] <;> ring

theorem region_eq_vertices_hull (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    region c = convexHull ℝ (regionVertices c) := by
  apply Set.Subset.antisymm
  · rw [← union_tiles_eq_region c hc₀ hc₁]
    exact Set.iUnion_subset (fun i => tile_subset_vertices_hull c hc₀ hc₁ i)
  · exact convexHull_min (region_vertices_mem_region c hc₀ hc₁) (convex_region c)

theorem translated_octagon_eq_region (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    (fun p : V2 => ![1-c,1]+p) '' octagon c = region c := by
  rw [region_eq_vertices_hull c hc₀ hc₁,octagon]
  change (AffineEquiv.constVAdd ℝ V2 ![1-c,1]).toAffineMap ''
    convexHull ℝ (octagonVertices c) = _
  rw [AffineMap.image_convexHull]
  congr 1
  ext p
  simp [octagonVertices,regionVertices] <;> ring_nf <;> tauto



end ProjectionAreaBoundaryTiling
end BoundaryOctagonTilingSource

/-! ## BoundaryOctagonAreas -/
section BoundaryOctagonAreasSource

/-!
Lebesgue area of the octagon in the boundary construction, using the exact
six-parallelogram dissection.  Degenerate tiles have measure zero by the
same determinant formula used for nondegenerate ones.
-/

open Set Matrix Module MeasureTheory
open scoped Pointwise ENNReal
open ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryAreas
open ProjectionAreaBoundaryTiling

namespace ProjectionAreaBoundaryOctagonAreas

theorem functional_level_null (f : V2 →ₗ[ℝ] ℝ) (hf : f ≠ 0) (r : ℝ) :
    (volume : Measure V2) {p | f p = r} = 0 := by
  let S : AffineSubspace ℝ V2 := ({r} : AffineSubspace ℝ ℝ).comap f.toAffineMap
  have hs : S ≠ ⊤ := by
    intro ht
    have heq (p : V2) : f p = r := by
      have hp : p ∈ S := by rw [ht]; trivial
      simpa [S,AffineSubspace.mem_comap] using hp
    have hr : r = 0 := by simpa using (heq 0).symm
    apply hf
    apply LinearMap.ext
    intro p
    simpa [hr] using heq p
  have hset : (S : Set V2) = {p | f p = r} := by
    ext p
    simp [S]
  rw [← hset]
  exact Measure.addHaar_affineSubspace (volume : Measure V2) S hs

def seam (c : ℝ) : Set V2 :=
  {p | p 0=0} ∪ {p | p 0=c} ∪ {p | p 1=c} ∪ {p | p 1=2-c} ∪
  {p | p 1-p 0=0} ∪ {p | p 1-p 0=2*(1-c)} ∪
  {p | p 0+p 1=2} ∪ {p | p 0+p 1=2*(1-c)}

theorem seam_null (c : ℝ) : (volume : Measure V2) (seam c) = 0 := by
  let X : V2 →ₗ[ℝ] ℝ := LinearMap.proj 0
  let Y : V2 →ₗ[ℝ] ℝ := LinearMap.proj 1
  have hx : X ≠ 0 := by
    intro h
    have he := congrArg (fun f : V2 →ₗ[ℝ] ℝ => f ![1,0]) h
    norm_num [X] at he
  have hy : Y ≠ 0 := by
    intro h
    have he := congrArg (fun f : V2 →ₗ[ℝ] ℝ => f ![0,1]) h
    norm_num [Y] at he
  have hd : Y-X ≠ 0 := by
    intro h
    have he := congrArg (fun f : V2 →ₗ[ℝ] ℝ => f ![0,1]) h
    norm_num [X,Y] at he
  have hs : X+Y ≠ 0 := by
    intro h
    have he := congrArg (fun f : V2 →ₗ[ℝ] ℝ => f ![0,1]) h
    norm_num [X,Y] at he
  have hx0 := functional_level_null X hx 0
  have hxc := functional_level_null X hx c
  have hyc := functional_level_null Y hy c
  have hyc' := functional_level_null Y hy (2-c)
  have hd0 := functional_level_null (Y-X) hd 0
  have hdc := functional_level_null (Y-X) hd (2*(1-c))
  have hs2 := functional_level_null (X+Y) hs 2
  have hsc := functional_level_null (X+Y) hs (2*(1-c))
  simp only [X,Y,LinearMap.sub_apply,LinearMap.add_apply,LinearMap.proj_apply] at *
  simp only [seam,measure_union_null_iff]
  tauto

theorem tile_inter_subset_seam (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1)
    (i j : Fin 6) (hij : i ≠ j) : tile c i ∩ tile c j ⊆ seam c := by
  intro p hp
  by_contra hn
  simp only [seam,Set.mem_union,Set.mem_ofPred_eq,not_or] at hn
  rcases hn with ⟨⟨⟨⟨⟨⟨⟨hn₁,hn₂⟩,hn₃⟩,hn₄⟩,hn₅⟩,hn₆⟩,hn₇⟩,hn₈⟩
  rcases hp with ⟨hi,hj⟩
  fin_cases i <;> fin_cases j <;> try contradiction
  all_goals dsimp [tile] at hi hj
  all_goals rcases hi with ⟨h₁,h₂,h₃,h₄⟩
  all_goals rcases hj with ⟨k₁,k₂,k₃,k₄⟩
  all_goals first
  | exact hn₁ (by linarith)
  | exact hn₂ (by linarith)
  | exact hn₃ (by linarith)
  | exact hn₄ (by linarith)
  | exact hn₅ (by linarith)
  | exact hn₆ (by linarith)
  | exact hn₇ (by linarith)
  | exact hn₈ (by linarith)

theorem tiles_aedisjoint (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1)
    (i j : Fin 6) (hij : i ≠ j) : AEDisjoint volume (tile c i) (tile c j) := by
  exact measure_mono_null (tile_inter_subset_seam c hc₀ hc₁ i j hij) (seam_null c)

theorem tile_measurable (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) (i : Fin 6) :
    MeasurableSet (tile c i) := by
  rw [tile_eq_parallelogram_hull c hc₀ hc₁ i]
  have hf : ({tileOffset c i, tileOffset c i+tileEdgeA c i,
      tileOffset c i+tileEdgeB c i,
      tileOffset c i+tileEdgeA c i+tileEdgeB c i} : Set V2).Finite := by simp
  exact (hf.isCompact_convexHull ℝ).measurableSet

theorem tile_measure_ne_top (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) (i : Fin 6) :
    (volume : Measure V2) (tile c i) ≠ ∞ := by
  rw [tile_eq_parallelogram_hull c hc₀ hc₁ i,volume_translated_parallelogram_hull]
  exact ENNReal.ofReal_ne_top

def tileArea (c : ℝ) : Fin 6 → ℝ :=
  ![2*c*(1-c),4*(1-c)^2,2*c*(1-c),2*c*(1-c),2*c^2,2*c*(1-c)]

theorem tile_determinants (c : ℝ) (i : Fin 6) :
    det2 (tileEdgeA c i) (tileEdgeB c i) = tileArea c i := by
  fin_cases i <;> simp [det2,tileEdgeA,tileEdgeB,tileMap,tileSize,planeMap,tileArea] <;> ring

theorem tile_areas (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) (i : Fin 6) :
    (volume : Measure V2).real (tile c i) = tileArea c i := by
  rw [tile_eq_parallelogram_hull c hc₀ hc₁ i,area_translated_parallelogram_hull,
    tile_determinants]
  apply abs_of_nonneg
  have hh : 0 ≤ 1-c := sub_nonneg.mpr hc₁
  fin_cases i <;> simp [tileArea] <;> positivity

theorem region_area (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    (volume : Measure V2).real (region c) = 4-2*c^2 := by
  have ha : (volume : Measure V2).real (⋃ i, tile c i) =
      ∑ i : Fin 6, (volume : Measure V2).real (tile c i) := by
    simpa using measureReal_biUnion_finset₀ (μ := (volume : Measure V2))
      (s := Finset.univ) (f := tile c)
      (fun i _ j _ hij => tiles_aedisjoint c hc₀ hc₁ i j hij)
      (fun i _ => (tile_measurable c hc₀ hc₁ i).nullMeasurableSet)
      (fun i _ => tile_measure_ne_top c hc₀ hc₁ i)
  rw [union_tiles_eq_region c hc₀ hc₁] at ha
  rw [ha]
  simp_rw [tile_areas c hc₀ hc₁]
  simp [tileArea,Fin.sum_univ_succ]
  ring

theorem octagon_area (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    (volume : Measure V2).real (octagon c) = 4-2*c^2 := by
  have harea := region_area c hc₀ hc₁
  rw [← translated_octagon_eq_region c hc₀ hc₁,measureReal_def,image_add_left,
    measure_preimage_add] at harea
  exact harea

/-- All six ordinary areas of the same compact convex set, on the entire
closed parameter interval. -/
theorem boundary_body_six_areas (c : ℝ) (hc₀ : 0 ≤ c) (hc₁ : c ≤ 1) :
    (volume : Measure V2).real (project 0 1 '' body c) = 4-2*c^2 ∧
    (volume : Measure V2).real (project 2 3 '' body c) = 4-2*c^2 ∧
    (volume : Measure V2).real (project 0 2 '' body c) = 2 ∧
    (volume : Measure V2).real (project 1 3 '' body c) = 2 ∧
    (volume : Measure V2).real (project 0 3 '' body c) = 2-2*c^2 ∧
    (volume : Measure V2).real (project 1 2 '' body c) = 2-2*c^2 := by
  obtain ⟨h₁,h₂,h₃,h₄,h₅,h₆⟩ := six_coordinate_projections c hc₀ hc₁
  rw [h₁,h₂,h₃,h₄,h₅,h₆]
  exact ⟨octagon_area c hc₀ hc₁,octagon_area c hc₀ hc₁,
    diamond_area,diamond_area,rectangle_area c hc₀ hc₁,rectangle_area c hc₀ hc₁⟩

theorem boundary_body_compact_convex_nonempty (c : ℝ) :
    IsCompact (body c) ∧ Convex ℝ (body c) ∧ (body c).Nonempty :=
  ⟨body_compact c,body_convex c,body_nonempty c⟩

end ProjectionAreaBoundaryOctagonAreas
end BoundaryOctagonAreasSource

/-! ## BoundaryScaledRealizer -/
section BoundaryScaledRealizerSource

/-!
An actual compact convex realizing body for every normalized boundary triple
(b+c,b,c), with b>0 and 0≤c≤b.  This connects the square-root parameter choice
to the six ordinary Lebesgue areas of one homothetic boundary polytope.
All area-scaling identities are proved from Mathlib's Haar-measure theorem.
-/

open Set Matrix Module MeasureTheory
open scoped Pointwise ENNReal
open ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryOctagonAreas

namespace ProjectionAreaBoundaryScaled

noncomputable section

def parameter (b c : ℝ) : ℝ := Real.sqrt (1-c/b)
def scale (b : ℝ) : ℝ := Real.sqrt (b/2)
def scaledBody (b c : ℝ) : Set V4 :=
  (fun x : V4 => scale b • x) '' body (parameter b c)

theorem planar_area_homothety (s : ℝ) (S : Set V2) :
    (volume : Measure V2).real ((fun x : V2 => s • x) '' S) =
      s^2*(volume : Measure V2).real S := by
  have hdim : Module.finrank ℝ V2 = 2 := by simp [V2]
  change (volume ((fun x : V2 => s • x) '' S)).toReal = s^2*(volume S).toReal
  rw [Set.image_smul,Measure.addHaar_smul,hdim,ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (abs_nonneg _),abs_of_nonneg (sq_nonneg s)]

theorem project_homothety (s : ℝ) (S : Set V4) (i j : Fin 4) :
    project i j '' ((fun x : V4 => s • x) '' S) =
      (fun y : V2 => s • y) '' (project i j '' S) := by
  simp only [Set.image_image,map_smul]

theorem projection_area_homothety (s : ℝ) (S : Set V4) (i j : Fin 4) :
    (volume : Measure V2).real (project i j '' ((fun x : V4 => s • x) '' S)) =
      s^2*(volume : Measure V2).real (project i j '' S) := by
  rw [project_homothety,planar_area_homothety]

theorem scaled_body_properties (b c : ℝ) :
    IsCompact (scaledBody b c) ∧ Convex ℝ (scaledBody b c) ∧
      (scaledBody b c).Nonempty := by
  unfold scaledBody
  refine ⟨(body_compact _).image ?_, ?_, (body_nonempty _).image _⟩
  · exact (continuous_const : Continuous (fun _ : V4 => scale b)).smul continuous_id
  · rw [Set.image_smul]
    exact (body_convex _).smul _

theorem parameter_bounds (b c : ℝ) (hb : 0 < b) (hc : 0 ≤ c) (hcb : c ≤ b) :
    0 ≤ parameter b c ∧ parameter b c ≤ 1 ∧ 0 < scale b ∧
      (parameter b c)^2 = 1-c/b ∧ (scale b)^2 = b/2 := by
  have hdiv : c/b ≤ 1 := (div_le_iff₀ hb).mpr (by simpa using hcb)
  have hdiv₀ : 0 ≤ c/b := div_nonneg hc hb.le
  have hrad : 0 ≤ 1-c/b := sub_nonneg.mpr hdiv
  refine ⟨Real.sqrt_nonneg _, ?_, ?_, Real.sq_sqrt hrad, Real.sq_sqrt (by positivity)⟩
  · exact Real.sqrt_le_one.mpr (by linarith)
  · exact Real.sqrt_pos.mpr (by positivity)

theorem parameter_area_identities (b c : ℝ)
    (hb : 0 < b) (hc : 0 ≤ c) (hcb : c ≤ b) :
    (scale b)^2*(4-2*(parameter b c)^2) = b+c ∧
    (scale b)^2*2 = b ∧
    (scale b)^2*(2-2*(parameter b c)^2) = c := by
  obtain ⟨_,_,_,ht,hs⟩ := parameter_bounds b c hb hc hcb
  rw [ht,hs]
  refine ⟨?_,?_,?_⟩
  · field_simp [hb.ne']
    ring
  · ring
  · field_simp [hb.ne']
    ring

theorem six_scaled_boundary_areas (b c : ℝ)
    (hb : 0 < b) (hc : 0 ≤ c) (hcb : c ≤ b) :
    (volume : Measure V2).real (project 0 1 '' scaledBody b c) = b+c ∧
    (volume : Measure V2).real (project 2 3 '' scaledBody b c) = b+c ∧
    (volume : Measure V2).real (project 0 2 '' scaledBody b c) = b ∧
    (volume : Measure V2).real (project 1 3 '' scaledBody b c) = b ∧
    (volume : Measure V2).real (project 0 3 '' scaledBody b c) = c ∧
    (volume : Measure V2).real (project 1 2 '' scaledBody b c) = c := by
  obtain ⟨ht₀,ht₁,_,_,_⟩ := parameter_bounds b c hb hc hcb
  obtain ⟨h₁,h₂,h₃,h₄,h₅,h₆⟩ := boundary_body_six_areas (parameter b c) ht₀ ht₁
  obtain ⟨ha,hb',hc'⟩ := parameter_area_identities b c hb hc hcb
  unfold scaledBody
  simp_rw [projection_area_homothety]
  rw [h₁,h₂,h₃,h₄,h₅,h₆]
  exact ⟨ha,ha,hb',hb',hc',hc'⟩

/-- A single compact convex realizing set, including the case c=0. -/
theorem exists_boundary_triangle_realizer (b c : ℝ)
    (hb : 0 < b) (hc : 0 ≤ c) (hcb : c ≤ b) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      (volume : Measure V2).real (project 0 1 '' K) = b+c ∧
      (volume : Measure V2).real (project 2 3 '' K) = b+c ∧
      (volume : Measure V2).real (project 0 2 '' K) = b ∧
      (volume : Measure V2).real (project 1 3 '' K) = b ∧
      (volume : Measure V2).real (project 0 3 '' K) = c ∧
      (volume : Measure V2).real (project 1 2 '' K) = c := by
  obtain ⟨hcompact,hconvex,hnonempty⟩ := scaled_body_properties b c
  exact ⟨scaledBody b c,hcompact,hconvex,hnonempty,
    six_scaled_boundary_areas b c hb hc hcb⟩

end
end ProjectionAreaBoundaryScaled
end BoundaryScaledRealizerSource

/-! ## NormalizedFourRealizer -/
section NormalizedFourRealizerSource

/-!
A single actual compact convex realizing body for every positive normalized
four-dimensional area triple satisfying the three weak triangle inequalities.
The proof joins the strict construction to the exact boundary construction by
coordinate permutations, whose ordinary projected areas are checked here.
-/

open Set Matrix MeasureTheory
open ProjectionAreaBoundaryPolytope ProjectionAreaCoordinateLifts
open ProjectionAreaTransforms ProjectionAreaBoundaryScaled

namespace ProjectionAreaNormalizedFour

noncomputable section

def swapPlane : V2 →ₗ[ℝ] V2 := Matrix.toLin' !![0,1;1,0]

theorem swapPlane_apply (x : V2) : swapPlane x = ![x 1,x 0] := by
  ext k
  fin_cases k <;> simp [swapPlane,Matrix.toLin'_apply,Matrix.mulVec,dotProduct,
    Fin.sum_univ_two]

theorem swapPlane_area (S : Set V2) :
    (volume : Measure V2).real (swapPlane '' S) =
      (volume : Measure V2).real S := by
  rw [area_linear_image]
  simp [swapPlane,LinearMap.det_toLin',Matrix.det_fin_two]

theorem projection_area_reverse {n : ℕ} (B : Set (Fin n → ℝ)) (i j : Fin n) :
    (volume : Measure V2).real (projectN j i '' B) =
      (volume : Measure V2).real (projectN i j '' B) := by
  have hset : projectN j i '' B = swapPlane '' (projectN i j '' B) := by
    simp only [image_image]
    congr 1
    funext x
    simp [projectN,swapPlane_apply]
  rw [hset,swapPlane_area]

theorem projection_area_reverse_four (B : Set V4) (i j : Fin 4) :
    (volume : Measure V2).real (project j i '' B) =
      (volume : Measure V2).real (project i j '' B) := by
  exact projection_area_reverse B i j

theorem permuted_projection_area (σ : Fin 4 → Fin 4) (B : Set V4)
    (i j : Fin 4) :
    (volume : Measure V2).real
        (project i j '' (coordinateImage σ (fun _ => 1) '' B)) =
      (volume : Measure V2).real (project (σ i) (σ j) '' B) := by
  change (volume : Measure V2).real
      (projectN i j '' (coordinateImage σ (fun _ => 1) '' B)) =
    (volume : Measure V2).real (projectN (σ i) (σ j) '' B)
  rw [weighted_coordinate_projection_areas]
  simp

def RealizesTriple (K : Set V4) (a b c : ℝ) : Prop :=
  IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
    (volume : Measure V2).real (project 0 1 '' K) = a ∧
    (volume : Measure V2).real (project 2 3 '' K) = a ∧
    (volume : Measure V2).real (project 0 2 '' K) = b ∧
    (volume : Measure V2).real (project 1 3 '' K) = b ∧
    (volume : Measure V2).real (project 0 3 '' K) = c ∧
    (volume : Measure V2).real (project 1 2 '' K) = c

def TripleRealizable (a b c : ℝ) : Prop := ∃ K : Set V4, RealizesTriple K a b c

theorem swap_first_two {a b c : ℝ} (h : TripleRealizable a b c) :
    TripleRealizable b a c := by
  obtain ⟨K,hcompact,hconvex,hne,h12,h34,h13,h24,h14,h23⟩ := h
  let σ : Fin 4 → Fin 4 := ![0,2,1,3]
  obtain ⟨hc,hv,hn⟩ := coordinateImage_preserves_body σ (fun _ => 1) K
    hcompact hconvex hne
  refine ⟨coordinateImage σ (fun _ => 1) '' K,hc,hv,hn,?_,?_,?_,?_,?_,?_⟩
  all_goals rw [permuted_projection_area]
  · simpa [σ] using h13
  · simpa [σ] using h24
  · simpa [σ] using h12
  · simpa [σ] using h34
  · simpa [σ] using h14
  · simpa [σ] using (projection_area_reverse_four K 1 2).trans h23

theorem swap_last_two {a b c : ℝ} (h : TripleRealizable a b c) :
    TripleRealizable a c b := by
  obtain ⟨K,hcompact,hconvex,hne,h12,h34,h13,h24,h14,h23⟩ := h
  let σ : Fin 4 → Fin 4 := ![0,1,3,2]
  obtain ⟨hc,hv,hn⟩ := coordinateImage_preserves_body σ (fun _ => 1) K
    hcompact hconvex hne
  refine ⟨coordinateImage σ (fun _ => 1) '' K,hc,hv,hn,?_,?_,?_,?_,?_,?_⟩
  all_goals rw [permuted_projection_area]
  · simpa [σ] using h12
  · simpa [σ] using (projection_area_reverse_four K 2 3).trans h34
  · simpa [σ] using h14
  · simpa [σ] using h23
  · simpa [σ] using h13
  · simpa [σ] using h24

theorem boundary_unordered (b c : ℝ) (hb : 0 < b) (hc : 0 < c) :
    TripleRealizable (b+c) b c := by
  by_cases hcb : c ≤ b
  · exact exists_boundary_triangle_realizer b c hb hc.le hcb
  · have hbc : b ≤ c := (lt_of_not_ge hcb).le
    have h : TripleRealizable (c+b) c b :=
      exists_boundary_triangle_realizer c b hc hb.le hbc
    simpa [add_comm] using swap_last_two h

theorem positive_weak_triangle_realizable (a b c : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (ha' : a ≤ b+c) (hb' : b ≤ a+c) (hc' : c ≤ a+b) :
    TripleRealizable a b c := by
  by_cases hA : a < b+c
  · by_cases hB : b < a+c
    · by_cases hC : c < a+b
      · exact ProjectionAreaStrictGeometry.exists_strict_triangle_realizer a b c hA hB hC
      · have heq : c = a+b := le_antisymm hc' (le_of_not_gt hC)
        have h : TripleRealizable c a b := by
          rw [heq]
          exact boundary_unordered a b ha hb
        exact swap_last_two (swap_first_two h)
    · have heq : b = a+c := le_antisymm hb' (le_of_not_gt hB)
      have h : TripleRealizable b a c := by
        rw [heq]
        exact boundary_unordered a c ha hc
      exact swap_first_two h
  · have heq : a = b+c := le_antisymm ha' (le_of_not_gt hA)
    rw [heq]
    exact boundary_unordered b c hb hc

/-- One actual compact convex body realizes all six normalized weak-triangle areas. -/
theorem exists_positive_weak_triangle_realizer (a b c : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (ha' : a ≤ b+c) (hb' : b ≤ a+c) (hc' : c ≤ a+b) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      (volume : Measure V2).real (project 0 1 '' K) = a ∧
      (volume : Measure V2).real (project 2 3 '' K) = a ∧
      (volume : Measure V2).real (project 0 2 '' K) = b ∧
      (volume : Measure V2).real (project 1 3 '' K) = b ∧
      (volume : Measure V2).real (project 0 3 '' K) = c ∧
      (volume : Measure V2).real (project 1 2 '' K) = c := by
  exact positive_weak_triangle_realizable a b c ha hb hc ha' hb' hc'

end
end ProjectionAreaNormalizedFour
end NormalizedFourRealizerSource

/-! ## PositiveDiagonalAlgebra -/
section PositiveDiagonalAlgebraSource

/-!
Exact positive diagonal normalization of six positive areas.  The square
roots of the three opposite products become the three repeated values.
No division by a zero quantity occurs.
-/

open Matrix

namespace ProjectionAreaPositiveDiagonal

theorem positive_diagonal_scalars
    (a b c d e f A B C : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hA : 0 < A) (hB : 0 < B) (hC : 0 < C)
    (hAsq : A^2 = a*f) (hBsq : B^2 = b*e) (hCsq : C^2 = c*d) :
    ∃ s : Fin 4 → ℝ, (∀ i, 0 < s i) ∧
      s 0*s 1*a = A ∧ s 0*s 2*b = B ∧ s 0*s 3*c = C ∧
      s 1*s 2*d = C ∧ s 1*s 3*e = B ∧ s 2*s 3*f = A := by
  let L := Real.sqrt (A*B*C/(a*b*c))
  have hfrac : 0 < A*B*C/(a*b*c) := by positivity
  have hL : 0 < L := Real.sqrt_pos.mpr hfrac
  have hLsq : L^2 = A*B*C/(a*b*c) := Real.sq_sqrt hfrac.le
  have h01 : L*(A/(a*L))*a = A := by
    field_simp [ha.ne',hL.ne']
  have h02 : L*(B/(b*L))*b = B := by
    field_simp [hb.ne',hL.ne']
  have h03 : L*(C/(c*L))*c = C := by
    field_simp [hc.ne',hL.ne']
  have h12 : (A/(a*L))*(B/(b*L))*d = C := by
    calc
      (A/(a*L))*(B/(b*L))*d = (A*B*d)/(a*b*L^2) := by ring
      _ = c*d/C := by
        rw [hLsq]
        field_simp [ha.ne',hb.ne',hc.ne',hA.ne',hB.ne',hC.ne'] <;> ring
      _ = C := by rw [← hCsq]; field_simp [hC.ne']
  have h13 : (A/(a*L))*(C/(c*L))*e = B := by
    calc
      (A/(a*L))*(C/(c*L))*e = (A*C*e)/(a*c*L^2) := by ring
      _ = b*e/B := by
        rw [hLsq]
        field_simp [ha.ne',hb.ne',hc.ne',hA.ne',hB.ne',hC.ne'] <;> ring
      _ = B := by rw [← hBsq]; field_simp [hB.ne']
  have h23 : (B/(b*L))*(C/(c*L))*f = A := by
    calc
      (B/(b*L))*(C/(c*L))*f = (B*C*f)/(b*c*L^2) := by ring
      _ = a*f/A := by
        rw [hLsq]
        field_simp [ha.ne',hb.ne',hc.ne',hA.ne',hB.ne',hC.ne'] <;> ring
      _ = A := by rw [← hAsq]; field_simp [hA.ne']
  refine ⟨![L,A/(a*L),B/(b*L),C/(c*L)],?_,h01,h02,h03,h12,h13,h23⟩
  intro i
  fin_cases i
  · exact hL
  · exact div_pos hA (mul_pos ha hL)
  · exact div_pos hB (mul_pos hb hL)
  · exact div_pos hC (mul_pos hc hL)

theorem normalize_positive_six_areas
    (a b c d e f : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hd : 0 < d) (he : 0 < e) (hf : 0 < f) :
    ∃ s : Fin 4 → ℝ, (∀ i, 0 < s i) ∧
      s 0*s 1*a = Real.sqrt (a*f) ∧
      s 0*s 2*b = Real.sqrt (b*e) ∧
      s 0*s 3*c = Real.sqrt (c*d) ∧
      s 1*s 2*d = Real.sqrt (c*d) ∧
      s 1*s 3*e = Real.sqrt (b*e) ∧
      s 2*s 3*f = Real.sqrt (a*f) := by
  exact positive_diagonal_scalars a b c d e f
    (Real.sqrt (a*f)) (Real.sqrt (b*e)) (Real.sqrt (c*d)) ha hb hc
    (Real.sqrt_pos.mpr (mul_pos ha hf))
    (Real.sqrt_pos.mpr (mul_pos hb he))
    (Real.sqrt_pos.mpr (mul_pos hc hd))
    (Real.sq_sqrt (mul_pos ha hf).le)
    (Real.sq_sqrt (mul_pos hb he).le)
    (Real.sq_sqrt (mul_pos hc hd).le)

end ProjectionAreaPositiveDiagonal
end PositiveDiagonalAlgebraSource

/-! ## PositiveFourRealizer -/
section PositiveFourRealizerSource

/-!
The complete positive-data constructive endpoint in dimension four.
The opposite-product square roots need only satisfy weak triangle
inequalities: all singular boundary cases are included.
-/

open Set MeasureTheory
open ProjectionAreaBoundaryPolytope ProjectionAreaTransforms
open ProjectionAreaNormalizedFour ProjectionAreaPositiveDiagonal

namespace ProjectionAreaPositiveFour

noncomputable section

theorem inverse_diagonal_area {n : ℕ}
    (B : Set (Fin n → ℝ)) (s : Fin n → ℝ) (hs : ∀ i, 0 < s i)
    (i j : Fin n) (q : ℝ)
    (harea : (volume : Measure V2).real (projectN i j '' B) = s i*s j*q) :
    (volume : Measure V2).real
        (projectN i j '' (coordinateImage id (fun k => 1/s k) '' B)) = q := by
  rw [weighted_coordinate_projection_areas]
  simp only [id_eq]
  rw [abs_of_nonneg (mul_nonneg (one_div_nonneg.mpr (hs i).le)
    (one_div_nonneg.mpr (hs j).le)),harea]
  field_simp [(hs i).ne',(hs j).ne']

theorem exists_positive_six_realizer_of_opposite_triangles
    (a b c d e f : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hd : 0 < d) (he : 0 < e) (hf : 0 < f)
    (hA : Real.sqrt (a*f) ≤ Real.sqrt (b*e)+Real.sqrt (c*d))
    (hB : Real.sqrt (b*e) ≤ Real.sqrt (a*f)+Real.sqrt (c*d))
    (hC : Real.sqrt (c*d) ≤ Real.sqrt (a*f)+Real.sqrt (b*e)) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      (volume : Measure V2).real (project 0 1 '' K) = a ∧
      (volume : Measure V2).real (project 0 2 '' K) = b ∧
      (volume : Measure V2).real (project 0 3 '' K) = c ∧
      (volume : Measure V2).real (project 1 2 '' K) = d ∧
      (volume : Measure V2).real (project 1 3 '' K) = e ∧
      (volume : Measure V2).real (project 2 3 '' K) = f := by
  obtain ⟨B,hcompact,hconvex,hne,h01,h23,h02,h13,h03,h12⟩ :=
    exists_positive_weak_triangle_realizer
      (Real.sqrt (a*f)) (Real.sqrt (b*e)) (Real.sqrt (c*d))
      (Real.sqrt_pos.mpr (mul_pos ha hf))
      (Real.sqrt_pos.mpr (mul_pos hb he))
      (Real.sqrt_pos.mpr (mul_pos hc hd)) hA hB hC
  obtain ⟨s,hs,hs01,hs02,hs03,hs12,hs13,hs23⟩ :=
    normalize_positive_six_areas a b c d e f ha hb hc hd he hf
  obtain ⟨hcompact',hconvex',hne'⟩ := coordinateImage_preserves_body
    id (fun i => 1/s i) B hcompact hconvex hne
  refine ⟨coordinateImage id (fun i => 1/s i) '' B,
    hcompact',hconvex',hne',?_,?_,?_,?_,?_,?_⟩
  · exact inverse_diagonal_area B s hs 0 1 a (h01.trans hs01.symm)
  · exact inverse_diagonal_area B s hs 0 2 b (h02.trans hs02.symm)
  · exact inverse_diagonal_area B s hs 0 3 c (h03.trans hs03.symm)
  · exact inverse_diagonal_area B s hs 1 2 d (h12.trans hs12.symm)
  · exact inverse_diagonal_area B s hs 1 3 e (h13.trans hs13.symm)
  · exact inverse_diagonal_area B s hs 2 3 f (h23.trans hs23.symm)

end

end ProjectionAreaPositiveFour
end PositiveFourRealizerSource

/-! ## ThreeCoordinateRealizer -/
section ThreeCoordinateRealizerSource

/-!
One actual compact convex set in R³ realizes every nonnegative triple of
coordinate two-dimensional projection areas. The witness is always the
closed parallelogram generated by two explicitly chosen vectors.

All area equalities are for actual planar Lebesgue measure of actual
coordinate images. Singular parallelograms, including all zero data, are
covered by the same determinant-area theorem. The final coordinate maps
are literal functions, definitionally identical to `project3` in
`CoordinateAreaLifts`, so this leaf has no dependency on that later module.
-/

open Set Matrix Module MeasureTheory
open scoped BigOperators Pointwise
open ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryAreas

namespace ProjectionAreaThreeRealizer

noncomputable section

abbrev V3 := Fin 3 → ℝ

def project3 (i j : Fin 3) : V3 →ₗ[ℝ] V2 where
  toFun x := ![x i, x j]
  map_add' x y := by ext k; fin_cases k <;> simp
  map_smul' r x := by ext k; fin_cases k <;> simp

def minor (p q : V3) (i j : Fin 3) : ℝ := p i * q j - p j * q i

theorem projected_parallelogram (p q : V3) (i j : Fin 3) :
    project3 i j '' parallelepiped ![p, q] =
      parallelepiped ![![p i, p j], ![q i, q j]] := by
  rw [image_parallelepiped]
  congr 1
  funext k
  fin_cases k <;> rfl

theorem projected_parallelogram_area (p q : V3) (i j : Fin 3) :
    (volume : Measure V2).real (project3 i j '' parallelepiped ![p, q]) =
      |minor p q i j| := by
  rw [projected_parallelogram, measureReal_def, volume_parallelogram,
    ENNReal.toReal_ofReal (abs_nonneg _)]
  rfl

theorem parallelogram_properties (p q : V3) :
    IsCompact (parallelepiped ![p, q]) ∧
      Convex ℝ (parallelepiped ![p, q]) ∧
      (parallelepiped ![p, q]).Nonempty := by
  refine ⟨?_, convex_parallelepiped _, ?_⟩
  · change IsCompact
      ((fun t : Fin 2 → ℝ => ∑ i, t i • (![p, q] : Fin 2 → V3) i) '' Icc 0 1)
    exact isCompact_Icc.image (by fun_prop)
  · refine ⟨0, ?_⟩
    apply (mem_parallelepiped_iff _ _).mpr
    refine ⟨0, ?_, ?_⟩
    · constructor <;> intro i <;> norm_num
    · simp

def firstGenerator (a b c : ℝ) : V3 :=
  if 0 < a then ![1, 0, -c/a]
  else if 0 < b then ![1, c/b, 0]
  else ![0, 1, 0]

def secondGenerator (a b c : ℝ) : V3 :=
  if 0 < a then ![0, a, b]
  else if 0 < b then ![0, 0, b]
  else ![0, 0, c]

def body (a b c : ℝ) : Set V3 :=
  parallelepiped ![firstGenerator a b c, secondGenerator a b c]

/-- The three explicit algebraic branches give the three signed minors
exactly. Only a and b are used to choose the branch; c can be arbitrary in
this purely algebraic statement. -/
theorem generator_minors (a b c : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    minor (firstGenerator a b c) (secondGenerator a b c) 0 1 = a ∧
    minor (firstGenerator a b c) (secondGenerator a b c) 0 2 = b ∧
    minor (firstGenerator a b c) (secondGenerator a b c) 1 2 = c := by
  by_cases haPos : 0 < a
  · have haNe : a ≠ 0 := ne_of_gt haPos
    have hcancel : (-c/a)*a = -c := div_mul_cancel₀ (-c) haNe
    simp [firstGenerator, secondGenerator, haPos, minor, hcancel]
  · have haZero : a = 0 := le_antisymm (le_of_not_gt haPos) ha
    subst a
    by_cases hbPos : 0 < b
    · have hbNe : b ≠ 0 := ne_of_gt hbPos
      have hcancel : (c/b)*b = c := div_mul_cancel₀ c hbNe
      simp [firstGenerator, secondGenerator, hbPos, minor, hcancel]
    · have hbZero : b = 0 := le_antisymm (le_of_not_gt hbPos) hb
      subst b
      simp [firstGenerator, secondGenerator, minor]

theorem body_properties (a b c : ℝ) :
    IsCompact (body a b c) ∧ Convex ℝ (body a b c) ∧ (body a b c).Nonempty :=
  parallelogram_properties _ _

theorem body_projection_areas (a b c : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    (volume : Measure V2).real (project3 0 1 '' body a b c) = a ∧
    (volume : Measure V2).real (project3 0 2 '' body a b c) = b ∧
    (volume : Measure V2).real (project3 1 2 '' body a b c) = c := by
  obtain ⟨h01, h02, h12⟩ := generator_minors a b c ha hb
  refine ⟨?_, ?_, ?_⟩
  · rw [body, projected_parallelogram_area, h01, abs_of_nonneg ha]
  · rw [body, projected_parallelogram_area, h02, abs_of_nonneg hb]
  · rw [body, projected_parallelogram_area, h12, abs_of_nonneg hc]

/-- Every nonnegative three-coordinate area array is realized by one
nonempty compact convex body. The three sets in the area statements are
the actual coordinate projections of the same witness K. -/
theorem exists_three_coordinate_realizer (a b c : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) :
    ∃ K : Set V3, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      (volume : Measure V2).real ((fun x : V3 => ![x 0, x 1]) '' K) = a ∧
      (volume : Measure V2).real ((fun x : V3 => ![x 0, x 2]) '' K) = b ∧
      (volume : Measure V2).real ((fun x : V3 => ![x 1, x 2]) '' K) = c := by
  obtain ⟨hcompact, hconvex, hne⟩ := body_properties a b c
  refine ⟨body a b c, hcompact, hconvex, hne, ?_⟩
  exact body_projection_areas a b c ha hb hc

end

end ProjectionAreaThreeRealizer
end ThreeCoordinateRealizerSource

/-! ## ZeroEntryRealizer -/
section ZeroEntryRealizerSource

/-!
Exact sufficiency for a four-coordinate array with one zero entry.
All six area equalities concern actual coordinate images of one compact
convex nonempty set. The equation a*d=b*c is the sole compatibility
condition beyond nonnegativity. The completely zero first row is included.
-/

open Set Matrix MeasureTheory
open ProjectionAreaBoundaryPolytope

namespace ProjectionAreaZeroEntry

noncomputable section

def HasZeroEntryAreas (K : Set V4) (a b c d e : ℝ) : Prop :=
  (volume : Measure V2).real (project 0 1 '' K) = 0 ∧
  (volume : Measure V2).real (project 0 2 '' K) = a ∧
  (volume : Measure V2).real (project 0 3 '' K) = b ∧
  (volume : Measure V2).real (project 1 2 '' K) = c ∧
  (volume : Measure V2).real (project 1 3 '' K) = d ∧
  (volume : Measure V2).real (project 2 3 '' K) = e

theorem exists_proportional_row_realizer (a b e r : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (he : 0 ≤ e) (hr : 0 ≤ r) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      HasZeroEntryAreas K a b (r*a) (r*b) e := by
  obtain ⟨B,hcompact,hconvex,hne,h01,h02,h12⟩ :=
    ProjectionAreaThreeRealizer.exists_three_coordinate_realizer a b e ha hb he
  obtain ⟨hc,hv,hn⟩ :=
    ProjectionAreaCoordinateLifts.duplicate_preserves_body r B hcompact hconvex hne
  refine ⟨ProjectionAreaCoordinateLifts.duplicate r '' B,hc,hv,hn,?_⟩
  have hdata := ProjectionAreaCoordinateLifts.duplicate_projection_areas r hr B
  change (volume : Measure V2).real
    (ProjectionAreaCoordinateLifts.project3 0 1 '' B) = a at h01
  change (volume : Measure V2).real
    (ProjectionAreaCoordinateLifts.project3 0 2 '' B) = b at h02
  change (volume : Measure V2).real
    (ProjectionAreaCoordinateLifts.project3 1 2 '' B) = e at h12
  simpa only [HasZeroEntryAreas,h01,h02,h12] using hdata

theorem exists_zero_first_row_realizer (c d e : ℝ)
    (hc : 0 ≤ c) (hd : 0 ≤ d) (he : 0 ≤ e) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      HasZeroEntryAreas K 0 0 c d e := by
  obtain ⟨B,hcompact,hconvex,hne,h01,h02,h12⟩ :=
    ProjectionAreaThreeRealizer.exists_three_coordinate_realizer c d e hc hd he
  let σ : Fin 4 → Fin 3 := ![0,0,1,2]
  let r : Fin 4 → ℝ := ![0,1,1,1]
  have hr : ∀ i, 0 ≤ r i := by intro i; fin_cases i <;> norm_num [r]
  obtain ⟨K,hKc,hKv,hKn,hK⟩ :=
    ProjectionAreaTransforms.one_body_realizes_weighted_coordinates σ r hr B
      hcompact hconvex hne
  refine ⟨K,hKc,hKv,hKn,?_,?_,?_,?_,?_,?_⟩
  · simpa [ProjectionAreaTransforms.projectN,project,σ,r] using hK 0 1
  · simpa [ProjectionAreaTransforms.projectN,project,σ,r] using hK 0 2
  · simpa [ProjectionAreaTransforms.projectN,project,σ,r] using hK 0 3
  · simpa [ProjectionAreaTransforms.projectN,project,σ,r,h01] using hK 1 2
  · simpa [ProjectionAreaTransforms.projectN,project,σ,r,h02] using hK 1 3
  · simpa [ProjectionAreaTransforms.projectN,project,σ,r,h12] using hK 2 3

theorem exists_zero_entry_realizer_data (a b c d e : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) (he : 0 ≤ e)
    (hcross : a*d = b*c) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      HasZeroEntryAreas K a b c d e := by
  by_cases haPos : 0 < a
  · have haNe : a ≠ 0 := ne_of_gt haPos
    have hra : (c/a)*a = c := div_mul_cancel₀ c haNe
    have hrb : (c/a)*b = d := by
      field_simp [haNe]
      nlinarith [hcross]
    obtain ⟨K,hKc,hKv,hKn,hK⟩ :=
      exists_proportional_row_realizer a b e (c/a) ha hb he (div_nonneg hc ha)
    exact ⟨K,hKc,hKv,hKn,by simpa only [hra,hrb] using hK⟩
  · have haZero : a = 0 := le_antisymm (le_of_not_gt haPos) ha
    subst a
    by_cases hbPos : 0 < b
    · have hbNe : b ≠ 0 := ne_of_gt hbPos
      have hbc : b*c = 0 := by simpa using hcross.symm
      have hcZero : c = 0 := (mul_eq_zero.mp hbc).resolve_left hbNe
      subst c
      have hrb : (d/b)*b = d := div_mul_cancel₀ d hbNe
      obtain ⟨K,hKc,hKv,hKn,hK⟩ :=
        exists_proportional_row_realizer 0 b e (d/b) (by norm_num) hb he
          (div_nonneg hd hb)
      exact ⟨K,hKc,hKv,hKn,by simpa only [mul_zero,hrb] using hK⟩
    · have hbZero : b = 0 := le_antisymm (le_of_not_gt hbPos) hb
      subst b
      exact exists_zero_first_row_realizer c d e hc hd he

/-- A complete one-body construction for nonnegative zero-entry data.
The six equalities are actual planar Lebesgue areas, in the order
(01,02,03,12,13,23). No full-dimensionality of the witness is required. -/
theorem exists_zero_entry_realizer (a b c d e : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) (he : 0 ≤ e)
    (hcross : a*d = b*c) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      (volume : Measure V2).real (project 0 1 '' K) = 0 ∧
      (volume : Measure V2).real (project 0 2 '' K) = a ∧
      (volume : Measure V2).real (project 0 3 '' K) = b ∧
      (volume : Measure V2).real (project 1 2 '' K) = c ∧
      (volume : Measure V2).real (project 1 3 '' K) = d ∧
      (volume : Measure V2).real (project 2 3 '' K) = e :=
  exists_zero_entry_realizer_data a b c d e ha hb hc hd he hcross

end

end ProjectionAreaZeroEntry
end ZeroEntryRealizerSource

/-! ## ZeroReductionAlgebra -/
section ZeroReductionAlgebraSource

open Finset Matrix
open scoped BigOperators Matrix

/-!
The elementary algebra behind the zero-entry reduction. This module checks
the determinant identity and positive proportionality of nonnegative rows.
It does not assert a formal eigenvalue-to-determinant bridge or a full
formal classification of realizable area arrays.
-/

namespace ProjectionZeroReduction

def zeroEntryMatrix (a b c d e : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![0, 0, a, b;
     0, 0, c, d;
     a, c, 0, e;
     b, d, e, 0]

theorem zero_entry_determinant (a b c d e : ℝ) :
    (zeroEntryMatrix a b c d e).det = (a * d - b * c) ^ 2 := by
  rw [Matrix.det_succ_row_zero]
  norm_num [zeroEntryMatrix, Fin.sum_univ_four, Matrix.det_fin_three, Matrix.submatrix,
    Fin.succAbove]
  ring

theorem cross_minor_eq_zero_of_det_nonpos (a b c d e : ℝ)
    (h : (zeroEntryMatrix a b c d e).det ≤ 0) : a * d = b * c := by
  rw [zero_entry_determinant] at h
  have hz : (a * d - b * c) ^ 2 = 0 := le_antisymm h (sq_nonneg _)
  exact sub_eq_zero.mp (sq_eq_zero_iff.mp hz)

theorem nonnegative_rows_positively_proportional {ι : Type*}
    (r s : ι → ℝ) (hr : ∀ i, 0 ≤ r i) (hs : ∀ i, 0 ≤ s i)
    (hrne : r ≠ 0) (hsne : s ≠ 0)
    (hminors : ∀ i j, r i * s j = r j * s i) :
    ∃ rho : ℝ, 0 < rho ∧ ∀ i, s i = rho * r i := by
  classical
  have hrex : ∃ i, r i ≠ 0 := by
    by_contra! h
    apply hrne
    funext i
    exact h i
  have hsex : ∃ i, s i ≠ 0 := by
    by_contra! h
    apply hsne
    funext i
    exact h i
  obtain ⟨k, hk⟩ := hrex
  obtain ⟨j, hj⟩ := hsex
  have hrk : 0 < r k := lt_of_le_of_ne (hr k) hk.symm
  have hsj : 0 < s j := lt_of_le_of_ne (hs j) hj.symm
  have hsk : 0 < s k := by
    by_contra! hnonpos
    have hz : s k = 0 := le_antisymm hnonpos (hs k)
    have hm := hminors k j
    rw [hz, mul_zero] at hm
    have hp := mul_pos hrk hsj
    linarith
  refine ⟨s k / r k, div_pos hsk hrk, ?_⟩
  intro i
  rw [div_mul_eq_mul_div]
  apply (eq_div_iff hk).mpr
  nlinarith [hminors k i]

theorem three_by_three_hollow_determinant (a b c : ℝ) :
    Matrix.det !![0, a, b; a, 0, c; b, c, 0] = 2 * a * b * c := by
  simp [Matrix.det_fin_three]
  ring

theorem trace_cube_nonnegative {ι : Type*} [Fintype ι]
    (Q : Matrix ι ι ℝ) (hQ : ∀ i j, 0 ≤ Q i j) :
    0 ≤ Matrix.trace (Q * Q * Q) := by
  unfold Matrix.trace
  apply Finset.sum_nonneg
  intro i _
  change 0 ≤ (Q * Q * Q) i i
  rw [Matrix.mul_apply]
  apply Finset.sum_nonneg
  intro j _
  apply mul_nonneg _ (hQ j i)
  rw [Matrix.mul_apply]
  exact Finset.sum_nonneg (fun k _ ↦ mul_nonneg (hQ i k) (hQ k j))

theorem two_positive_trace_cube_negative {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    a ^ 3 + b ^ 3 + (-a - b) ^ 3 < 0 := by
  have hid : a ^ 3 + b ^ 3 + (-a - b) ^ 3 = -3 * a * b * (a + b) := by ring
  rw [hid]
  have hprod := mul_pos (mul_pos ha hb) (add_pos ha hb)
  nlinarith

end ProjectionZeroReduction
end ZeroReductionAlgebraSource

/-! ## ZeroPairRealizer -/
section ZeroPairRealizerSource

/-!
The zero-entry construction with no preferred coordinate pair.  The final
theorem realizes all sixteen entries of a symmetric hollow nonnegative
four-by-four matrix, as actual projection areas of one compact convex set,
whenever its determinant is nonpositive and some off-diagonal entry vanishes.
Coordinate relabeling is proved using actual linear images of the same body.
-/

open Set Matrix MeasureTheory
open ProjectionAreaBoundaryPolytope ProjectionAreaTransforms
open ProjectionAreaNormalizedFour ProjectionAreaZeroEntry ProjectionZeroReduction

namespace ProjectionAreaZeroPair

noncomputable section

theorem six_areas_complete (K : Set V4) (q : Matrix (Fin 4) (Fin 4) ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (h01 : (volume : Measure V2).real (project 0 1 '' K) = q 0 1)
    (h02 : (volume : Measure V2).real (project 0 2 '' K) = q 0 2)
    (h03 : (volume : Measure V2).real (project 0 3 '' K) = q 0 3)
    (h12 : (volume : Measure V2).real (project 1 2 '' K) = q 1 2)
    (h13 : (volume : Measure V2).real (project 1 3 '' K) = q 1 3)
    (h23 : (volume : Measure V2).real (project 2 3 '' K) = q 2 3) :
    ∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j := by
  intro i j
  fin_cases i <;> fin_cases j
  · exact (same_coordinate_area_zero K 0).trans (hdiag 0).symm
  · exact h01
  · exact h02
  · exact h03
  · exact (projection_area_reverse K 0 1).trans (h01.trans (hsym 0 1))
  · exact (same_coordinate_area_zero K 1).trans (hdiag 1).symm
  · exact h12
  · exact h13
  · exact (projection_area_reverse K 0 2).trans (h02.trans (hsym 0 2))
  · exact (projection_area_reverse K 1 2).trans (h12.trans (hsym 1 2))
  · exact (same_coordinate_area_zero K 2).trans (hdiag 2).symm
  · exact h23
  · exact (projection_area_reverse K 0 3).trans (h03.trans (hsym 0 3))
  · exact (projection_area_reverse K 1 3).trans (h13.trans (hsym 1 3))
  · exact (projection_area_reverse K 2 3).trans (h23.trans (hsym 2 3))
  · exact (same_coordinate_area_zero K 3).trans (hdiag 3).symm

theorem undo_coordinate_permutation {n : ℕ} (q : Matrix (Fin n) (Fin n) ℝ)
    (σ : Equiv.Perm (Fin n)) (B : Set (Fin n → ℝ))
    (hcompact : IsCompact B) (hconvex : Convex ℝ B) (hne : B.Nonempty)
    (hareas : ∀ i j, (volume : Measure V2).real (projectN i j '' B) = q (σ i) (σ j)) :
    ∃ A : Set (Fin n → ℝ), IsCompact A ∧ Convex ℝ A ∧ A.Nonempty ∧
      ∀ i j, (volume : Measure V2).real (projectN i j '' A) = q i j := by
  obtain ⟨A,hc,hv,hn,hA⟩ := one_body_realizes_weighted_coordinates σ.symm
    (fun _ => 1) (by intro i; norm_num) B hcompact hconvex hne
  refine ⟨A,hc,hv,hn,?_⟩
  intro i j
  rw [hA i j]
  simp only [one_mul]
  rw [hareas]
  simp

theorem exists_permutation_to_pair (i j : Fin 4) (hij : i ≠ j) :
    ∃ σ : Equiv.Perm (Fin 4), σ 0 = i ∧ σ 1 = j := by
  let τ : Equiv.Perm (Fin 4) := Equiv.swap 0 i
  have hτ : τ 0 = i := by simp [τ]
  have hk : τ.symm j ≠ 0 := by
    intro heq
    have hji : j = i := by
      calc
        j = τ (τ.symm j) := (τ.apply_symm_apply j).symm
        _ = τ 0 := by rw [heq]
        _ = i := hτ
    exact hij hji.symm
  refine ⟨(Equiv.swap 1 (τ.symm j)).trans τ,?_,?_⟩
  · rw [Equiv.trans_apply,
      Equiv.swap_apply_of_ne_of_ne (by decide : (0 : Fin 4) ≠ 1) hk.symm]
    exact hτ
  · rw [Equiv.trans_apply,Equiv.swap_apply_left,τ.apply_symm_apply]

theorem zero_first_pair_matrix_form (q : Matrix (Fin 4) (Fin 4) ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hzero : q 0 1 = 0) :
    q = zeroEntryMatrix (q 0 2) (q 0 3) (q 1 2) (q 1 3) (q 2 3) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [zeroEntryMatrix,hdiag,hzero,hsym 1 0,hsym 2 0,hsym 3 0,
      hsym 2 1,hsym 3 1,hsym 3 2]

theorem exists_realizer_zero_first_pair (q : Matrix (Fin 4) (Fin 4) ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hnonneg : ∀ i j, 0 ≤ q i j) (hdet : q.det ≤ 0) (hzero : q 0 1 = 0) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      ∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j := by
  have hform := zero_first_pair_matrix_form q hsym hdiag hzero
  have hdet' :
      (zeroEntryMatrix (q 0 2) (q 0 3) (q 1 2) (q 1 3) (q 2 3)).det ≤ 0 := by
    rw [← hform]
    exact hdet
  have hcross := cross_minor_eq_zero_of_det_nonpos
    (q 0 2) (q 0 3) (q 1 2) (q 1 3) (q 2 3) hdet'
  obtain ⟨K,hc,hv,hn,h01,h02,h03,h12,h13,h23⟩ :=
    exists_zero_entry_realizer (q 0 2) (q 0 3) (q 1 2) (q 1 3) (q 2 3)
      (hnonneg 0 2) (hnonneg 0 3) (hnonneg 1 2) (hnonneg 1 3) (hnonneg 2 3) hcross
  refine ⟨K,hc,hv,hn,?_⟩
  exact six_areas_complete K q hsym hdiag (h01.trans hzero.symm) h02 h03 h12 h13 h23

/-- Exact realization of every nonnegative hollow symmetric four-coordinate
array with nonpositive determinant and any off-diagonal zero. -/
theorem exists_realizer_of_zero_pair (q : Matrix (Fin 4) (Fin 4) ℝ)
    (hsym : ∀ i j, q i j = q j i) (hdiag : ∀ i, q i i = 0)
    (hnonneg : ∀ i j, 0 ≤ q i j) (hdet : q.det ≤ 0)
    (i j : Fin 4) (hij : i ≠ j) (hzero : q i j = 0) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      ∀ i j, (volume : Measure V2).real (projectN i j '' K) = q i j := by
  obtain ⟨σ,hσ0,hσ1⟩ := exists_permutation_to_pair i j hij
  let p : Matrix (Fin 4) (Fin 4) ℝ := q.submatrix σ σ
  have hpsym : ∀ k l, p k l = p l k := fun k l => hsym (σ k) (σ l)
  have hpdiag : ∀ k, p k k = 0 := fun k => hdiag (σ k)
  have hpnonneg : ∀ k l, 0 ≤ p k l := fun k l => hnonneg (σ k) (σ l)
  have hpdet : p.det ≤ 0 := by
    simpa [p] using hdet
  have hpzero : p 0 1 = 0 := by
    simpa [p,Matrix.submatrix_apply,hσ0,hσ1] using hzero
  obtain ⟨B,hc,hv,hn,hB⟩ :=
    exists_realizer_zero_first_pair p hpsym hpdiag hpnonneg hpdet hpzero
  exact undo_coordinate_permutation q σ B hc hv hn hB

end
end ProjectionAreaZeroPair
end ZeroPairRealizerSource

/-! ## UniformProjection -/
section UniformProjectionSource

open Set Finset Matrix
open scoped BigOperators Matrix

/-!
Uniform algebra for the projection-area obstruction in dimension `d = n+1`.
The index type `Fin n ⊕ Unit` consists of `n` finite parameter values and one
distinguished final coordinate. For `n ≥ 4`, selecting parameters `0,1,2,3`
and the distinguished coordinate recovers the five-dimensional example.

The spectral certificate below is stated as the absence of a two-dimensional
positive-definite subspace. Its standard equivalence with an eigenvalue count
for real symmetric matrices is not taken as an unproved Lean theorem.
-/

namespace ProjectionAreaUniform

def lorentzMatrix : Matrix (Fin 3) (Fin 3) ℝ :=
  !![0, 0, 1; 0, -2, 0; 1, 0, 0]

def rows (n : ℕ) : Matrix (Fin n ⊕ Unit) (Fin 3) ℝ := fun i ↦
  match i with
  | Sum.inl j => ![1, (j.val : ℝ), (j.val : ℝ) ^ 2]
  | Sum.inr _ => ![0, 0, 1]

def areaMatrix (n : ℕ) : Matrix (Fin n ⊕ Unit) (Fin n ⊕ Unit) ℝ := fun i j ↦
  match i, j with
  | Sum.inl a, Sum.inl b => ((a.val : ℝ) - (b.val : ℝ)) ^ 2
  | Sum.inl _, Sum.inr _ => 1
  | Sum.inr _, Sum.inl _ => 1
  | Sum.inr _, Sum.inr _ => 0

theorem uniform_gram_factorization (n : ℕ) :
    areaMatrix n = rows n * lorentzMatrix * (rows n).transpose := by
  ext i j
  cases i <;> cases j <;>
    simp [areaMatrix, rows, lorentzMatrix, Matrix.mul_apply, Fin.sum_univ_three]; ring

theorem areaMatrix_diagonal (n : ℕ) (i : Fin n ⊕ Unit) : areaMatrix n i i = 0 := by
  cases i <;> simp [areaMatrix]

theorem areaMatrix_symmetric (n : ℕ) : (areaMatrix n).transpose = areaMatrix n := by
  ext i j
  cases i <;> cases j <;> simp [areaMatrix, Matrix.transpose]; ring

theorem areaMatrix_off_diagonal_positive (n : ℕ) {i j : Fin n ⊕ Unit} (hij : i ≠ j) :
    0 < areaMatrix n i j := by
  rcases i with i | ⟨⟩ <;> rcases j with j | ⟨⟩
  · change 0 < ((i.val : ℝ) - (j.val : ℝ)) ^ 2
    apply sq_pos_of_ne_zero
    intro h
    apply hij
    apply congrArg Sum.inl
    apply Fin.ext
    exact_mod_cast (sub_eq_zero.mp h)
  · norm_num [areaMatrix]
  · norm_num [areaMatrix]
  · exact (hij rfl).elim

theorem lorentz_quadratic_identity (y : Fin 3 → ℝ) :
    dotProduct y (lorentzMatrix.mulVec y) =
      (1 / 2 : ℝ) * (y 0 + y 2) ^ 2 -
      (1 / 2 : ℝ) * (y 0 - y 2) ^ 2 - 2 * (y 1) ^ 2 := by
  simp [dotProduct, Matrix.mulVec, lorentzMatrix, Fin.sum_univ_three]
  ring

theorem gram_quadratic_pullback {ι : Type*} [Fintype ι]
    (R : Matrix ι (Fin 3) ℝ) (x : ι → ℝ) :
    dotProduct x ((R * lorentzMatrix * R.transpose).mulVec x) =
      dotProduct (R.transpose.mulVec x)
        (lorentzMatrix.mulVec (R.transpose.mulVec x)) := by
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rw [Matrix.dotProduct_mulVec]
  rw [← Matrix.mulVec_transpose]

def timeFunctional {ι : Type*} [Fintype ι] (R : Matrix ι (Fin 3) ℝ) :
    (ι → ℝ) →ₗ[ℝ] ℝ where
  toFun x := (R.transpose.mulVec x) 0 + (R.transpose.mulVec x) 2
  map_add' x y := by simp [Matrix.mulVec_add]; ring
  map_smul' a x := by simp [Matrix.mulVec_smul, smul_eq_mul]; ring

theorem gram_nonpos_of_time_zero {ι : Type*} [Fintype ι]
    (R : Matrix ι (Fin 3) ℝ) (x : ι → ℝ) (hx : timeFunctional R x = 0) :
    dotProduct x ((R * lorentzMatrix * R.transpose).mulVec x) ≤ 0 := by
  rw [gram_quadratic_pullback, lorentz_quadratic_identity]
  change (R.transpose.mulVec x) 0 + (R.transpose.mulVec x) 2 = 0 at hx
  rw [hx]
  nlinarith [sq_nonneg ((R.transpose.mulVec x) 0 - (R.transpose.mulVec x) 2),
    sq_nonneg ((R.transpose.mulVec x) 1)]

/-- Any subspace on which the Gram quadratic form is positive definite has
dimension at most one. This is a direct finite-dimensional positive-index
certificate; no eigenvalue equivalence is assumed. -/
theorem positive_subspace_finrank_le_one {ι : Type*} [Fintype ι]
    (R : Matrix ι (Fin 3) ℝ) (U : Submodule ℝ (ι → ℝ))
    (hU : ∀ x : U, x ≠ 0 →
      0 < dotProduct (x : ι → ℝ) ((R * lorentzMatrix * R.transpose).mulVec x)) :
    Module.finrank ℝ U ≤ 1 := by
  let f : U →ₗ[ℝ] ℝ := (timeFunctional R).comp U.subtype
  have hker : ∀ x : U, f x = 0 → x = 0 := by
    intro x hx
    by_contra hne
    have hpos := hU x hne
    have hnonpos := gram_nonpos_of_time_zero R (x : ι → ℝ) hx
    linarith
  have hf : Function.Injective f := by
    intro x y hxy
    apply sub_eq_zero.mp
    apply hker
    simp only [map_sub, hxy, sub_self]
  simpa using LinearMap.finrank_le_finrank_of_injective hf

theorem uniform_positive_subspace_finrank_le_one (n : ℕ)
    (U : Submodule ℝ ((Fin n ⊕ Unit) → ℝ))
    (hU : ∀ x : U, x ≠ 0 →
      0 < dotProduct (x : (Fin n ⊕ Unit) → ℝ) ((areaMatrix n).mulVec x)) :
    Module.finrank ℝ U ≤ 1 := by
  apply positive_subspace_finrank_le_one (rows n) U
  intro x hx
  rw [← uniform_gram_factorization]
  exact hU x hx

theorem gram_principal_factor {ι κ : Type*} [Fintype ι]
    (R : Matrix ι (Fin 3) ℝ) (e : κ → ι) :
    (R * lorentzMatrix * R.transpose).submatrix e e =
      R.submatrix e id * lorentzMatrix * (R.submatrix e id).transpose := by
  ext i j
  simp [Matrix.mul_apply, Matrix.submatrix, Matrix.transpose]

theorem uniform_principal_positive_subspace_finrank_le_one
    (n : ℕ) {κ : Type*} [Fintype κ] (e : κ → Fin n ⊕ Unit)
    (U : Submodule ℝ (κ → ℝ))
    (hU : ∀ x : U, x ≠ 0 →
      0 < dotProduct (x : κ → ℝ) (((areaMatrix n).submatrix e e).mulVec x)) :
    Module.finrank ℝ U ≤ 1 := by
  apply positive_subspace_finrank_le_one ((rows n).submatrix e id) U
  intro x hx
  rw [← gram_principal_factor, ← uniform_gram_factorization]
  exact hU x hx

def selectFour {n : ℕ} (hn : 4 ≤ n) : (Fin 4 ⊕ Unit) → (Fin n ⊕ Unit)
  | Sum.inl i => Sum.inl (Fin.castLE hn i)
  | Sum.inr u => Sum.inr u

theorem selectFour_injective {n : ℕ} (hn : 4 ≤ n) : Function.Injective (selectFour hn) := by
  intro i j h
  rcases i with i | ⟨⟩ <;> rcases j with j | ⟨⟩
  · apply congrArg Sum.inl
    apply Fin.ext
    have h' : Fin.castLE hn i = Fin.castLE hn j := Sum.inl.inj h
    exact congrArg (fun k : Fin n ↦ k.val) h'
  · cases h
  · cases h
  · rfl

theorem uniform_four_parameter_restriction {n : ℕ} (hn : 4 ≤ n) :
    (areaMatrix n).submatrix (selectFour hn) (selectFour hn) = areaMatrix 4 := by
  ext i j
  cases i <;> cases j <;> rfl

def fiveLabels : Fin 5 → (Fin 4 ⊕ Unit) :=
  ![Sum.inl 0, Sum.inl 1, Sum.inl 2, Sum.inl 3, Sum.inr ()]

def referenceFiveMatrix : Matrix (Fin 5) (Fin 5) ℝ :=
  !![0, 1, 4, 9, 1;
     1, 0, 1, 4, 1;
     4, 1, 0, 1, 1;
     9, 4, 1, 0, 1;
     1, 1, 1, 1, 0]

theorem fiveLabels_injective : Function.Injective fiveLabels := by decide

theorem four_parameter_matrix_is_reference_five :
    (areaMatrix 4).submatrix fiveLabels fiveLabels = referenceFiveMatrix := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [areaMatrix, fiveLabels, referenceFiveMatrix, Matrix.submatrix]

def selectedFive {n : ℕ} (hn : 4 ≤ n) : Fin 5 → (Fin n ⊕ Unit) :=
  selectFour hn ∘ fiveLabels

theorem selectedFive_injective {n : ℕ} (hn : 4 ≤ n) :
    Function.Injective (selectedFive hn) :=
  (selectFour_injective hn).comp fiveLabels_injective

/-- The selected coordinates are precisely finite parameter values `0,1,2,3`
and the distinguished final coordinate, i.e. labels `{1,2,3,4,d}` in the
paper's one-based notation. -/
theorem uniform_five_coordinate_restriction {n : ℕ} (hn : 4 ≤ n) :
    (areaMatrix n).submatrix (selectedFive hn) (selectedFive hn) = referenceFiveMatrix := by
  calc
    (areaMatrix n).submatrix (selectedFive hn) (selectedFive hn) =
        ((areaMatrix n).submatrix (selectFour hn) (selectFour hn)).submatrix
          fiveLabels fiveLabels := rfl
    _ = (areaMatrix 4).submatrix fiveLabels fiveLabels := by
      rw [uniform_four_parameter_restriction]
    _ = referenceFiveMatrix := four_parameter_matrix_is_reference_five

end ProjectionAreaUniform
end UniformProjectionSource

/-! ## StrictPerturbation -/
section StrictPerturbationSource

open Set Finset Matrix
open scoped BigOperators Matrix

/-!
Strict positive perturbations of the uniform projection-area matrices.
The finite parameters may be arbitrary real numbers. The checked conclusions
are explicit quadratic identities, absence of positive definite subspaces of
dimension greater than one, and trivial matrix kernel. No equivalence with
an eigenvalue-count formulation is assumed as an extra axiom.
-/

namespace ProjectionAreaStrict

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def finitePerturbed (t : ι → ℝ) (ε : ℝ) : Matrix ι ι ℝ :=
  fun i j ↦ (t i - t j) ^ 2 + ε - if i = j then ε else 0

def extendedPerturbed (t : ι → ℝ) (ε : ℝ) :
    Matrix (ι ⊕ Unit) (ι ⊕ Unit) ℝ := fun i j ↦
  match i, j with
  | Sum.inl a, Sum.inl b => finitePerturbed t ε a b
  | Sum.inl _, Sum.inr _ => 1 + ε
  | Sum.inr _, Sum.inl _ => 1 + ε
  | Sum.inr _, Sum.inr _ => 0

theorem finite_mulVec (t : ι → ℝ) (ε : ℝ) (x : ι → ℝ) (i : ι) :
    (finitePerturbed t ε).mulVec x i =
      (t i) ^ 2 * (∑ j, x j) - 2 * t i * (∑ j, t j * x j) +
      (∑ j, (t j) ^ 2 * x j) + ε * ((∑ j, x j) - x i) := by
  classical
  unfold Matrix.mulVec dotProduct finitePerturbed
  calc
    ∑ j, ((t i - t j) ^ 2 + ε - if i = j then ε else 0) * x j =
        ∑ j, ((t i) ^ 2 * x j - (2 * t i) * (t j * x j) +
          (t j) ^ 2 * x j + ε * x j - (if i = j then ε else 0) * x j) := by
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = _ := by
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
        ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
      ring

theorem finite_quadratic_identity (t : ι → ℝ) (ε : ℝ) (x : ι → ℝ) :
    dotProduct x ((finitePerturbed t ε).mulVec x) =
      2 * (∑ i, x i) * (∑ i, (t i) ^ 2 * x i) -
      2 * (∑ i, t i * x i) ^ 2 +
      ε * ((∑ i, x i) ^ 2 - ∑ i, (x i) ^ 2) := by
  classical
  unfold dotProduct
  simp_rw [finite_mulVec]
  calc
    ∑ i, x i * ((t i) ^ 2 * (∑ j, x j) - 2 * t i * (∑ j, t j * x j) +
        (∑ j, (t j) ^ 2 * x j) + ε * ((∑ j, x j) - x i)) =
        ∑ i, ((t i) ^ 2 * x i * (∑ j, x j) -
          2 * (t i * x i) * (∑ j, t j * x j) +
          x i * (∑ j, (t j) ^ 2 * x j) +
          ε * (x i * (∑ j, x j)) - ε * (x i) ^ 2) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = _ := by
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib,
        ← Finset.mul_sum, ← Finset.sum_mul]
      ring

theorem extended_mulVec_infinity (t : ι → ℝ) (ε : ℝ) (x : (ι ⊕ Unit) → ℝ)
    (u : Unit) :
    (extendedPerturbed t ε).mulVec x (Sum.inr u) =
      (1 + ε) * ∑ i, x (Sum.inl i) := by
  simp [Matrix.mulVec, dotProduct, Fintype.sum_sum_type, extendedPerturbed,
    Finset.mul_sum]

theorem extended_mulVec_finite (t : ι → ℝ) (ε : ℝ) (x : (ι ⊕ Unit) → ℝ)
    (i : ι) :
    (extendedPerturbed t ε).mulVec x (Sum.inl i) =
      (finitePerturbed t ε).mulVec (fun j ↦ x (Sum.inl j)) i +
      (1 + ε) * x (Sum.inr ()) := by
  simp [Matrix.mulVec, dotProduct, Fintype.sum_sum_type, extendedPerturbed]

theorem extended_quadratic_identity (t : ι → ℝ) (ε : ℝ) (x : (ι ⊕ Unit) → ℝ) :
    dotProduct x ((extendedPerturbed t ε).mulVec x) =
      2 * (∑ i, x (Sum.inl i)) * (∑ i, (t i) ^ 2 * x (Sum.inl i)) -
      2 * (∑ i, t i * x (Sum.inl i)) ^ 2 +
      ε * ((∑ i, x (Sum.inl i)) ^ 2 - ∑ i, (x (Sum.inl i)) ^ 2) +
      2 * (1 + ε) * x (Sum.inr ()) * (∑ i, x (Sum.inl i)) := by
  have hf := finite_quadratic_identity t ε (fun i ↦ x (Sum.inl i))
  simp only [dotProduct, Fintype.sum_sum_type, Fintype.sum_unique,
    extended_mulVec_finite, extended_mulVec_infinity, mul_add,
    Finset.sum_add_distrib] at *
  rw [hf]
  simp only [← Finset.sum_mul]
  ring

omit [DecidableEq ι] in
theorem sum_squares_nonneg (x : ι → ℝ) : 0 ≤ ∑ i, (x i) ^ 2 :=
  Finset.sum_nonneg fun i _ ↦ sq_nonneg (x i)

omit [DecidableEq ι] in
theorem sum_squares_eq_zero {x : ι → ℝ} (h : ∑ i, (x i) ^ 2 = 0) : x = 0 := by
  funext i
  exact ((Finset.sum_sq_eq_zero_iff Finset.univ x).mp h) i (Finset.mem_univ i)

omit [DecidableEq ι] in
theorem sum_squares_pos {x : ι → ℝ} (hx : x ≠ 0) : 0 < ∑ i, (x i) ^ 2 := by
  have hn := sum_squares_nonneg x
  exact lt_of_le_of_ne hn (fun h ↦ hx (sum_squares_eq_zero h.symm))

theorem finite_negative_of_sum_zero (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε)
    {x : ι → ℝ} (hx : x ≠ 0) (hs : ∑ i, x i = 0) :
    dotProduct x ((finitePerturbed t ε).mulVec x) < 0 := by
  rw [finite_quadratic_identity, hs]
  have hprod := mul_pos hε (sum_squares_pos hx)
  nlinarith [sq_nonneg (∑ i, t i * x i)]

theorem finite_nonpos_of_sum_zero (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε)
    (x : ι → ℝ) (hs : ∑ i, x i = 0) :
    dotProduct x ((finitePerturbed t ε).mulVec x) ≤ 0 := by
  rw [finite_quadratic_identity, hs]
  have hprod := mul_nonneg hε (sum_squares_nonneg x)
  nlinarith [sq_nonneg (∑ i, t i * x i)]

theorem extended_nonpos_of_sum_zero (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε)
    (x : (ι ⊕ Unit) → ℝ) (hs : ∑ i, x (Sum.inl i) = 0) :
    dotProduct x ((extendedPerturbed t ε).mulVec x) ≤ 0 := by
  rw [extended_quadratic_identity, hs]
  have hprod := mul_nonneg hε (sum_squares_nonneg (fun i ↦ x (Sum.inl i)))
  nlinarith [sq_nonneg (∑ i, t i * x (Sum.inl i))]

theorem extended_kernel_eq_zero [Nonempty ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε)
    {x : (ι ⊕ Unit) → ℝ} (hx : (extendedPerturbed t ε).mulVec x = 0) : x = 0 := by
  have hinf := congrFun hx (Sum.inr ())
  rw [extended_mulVec_infinity] at hinf
  have hfactor : 1 + ε ≠ 0 := by linarith
  have hs : ∑ i, x (Sum.inl i) = 0 :=
    (mul_eq_zero.mp hinf).resolve_left hfactor
  have hquad : dotProduct x ((extendedPerturbed t ε).mulVec x) = 0 := by
    rw [hx, dotProduct_zero]
  rw [extended_quadratic_identity, hs] at hquad
  have hsq := sum_squares_nonneg (fun i ↦ x (Sum.inl i))
  have hprod : ε * (∑ i, (x (Sum.inl i)) ^ 2) = 0 := by
    apply le_antisymm
    · nlinarith [sq_nonneg (∑ i, t i * x (Sum.inl i))]
    · exact mul_nonneg hε.le hsq
  have hfinite : (fun i ↦ x (Sum.inl i)) = 0 :=
    sum_squares_eq_zero ((mul_eq_zero.mp hprod).resolve_left hε.ne')
  obtain ⟨i⟩ := ‹Nonempty ι›
  have hrow := congrFun hx (Sum.inl i)
  rw [extended_mulVec_finite, hfinite, Matrix.mulVec_zero] at hrow
  have hxinf : x (Sum.inr ()) = 0 := by
    apply (mul_eq_zero.mp ?_).resolve_left hfactor
    simpa using hrow
  funext j
  rcases j with j | ⟨⟩
  · exact congrFun hfinite j
  · exact hxinf

def sumFunctional : (ι → ℝ) →ₗ[ℝ] ℝ where
  toFun x := ∑ i, x i
  map_add' x y := by simp [Finset.sum_add_distrib]
  map_smul' a x := by simp [Finset.mul_sum]

def extendedSumFunctional : ((ι ⊕ Unit) → ℝ) →ₗ[ℝ] ℝ where
  toFun x := ∑ i, x (Sum.inl i)
  map_add' x y := by simp [Finset.sum_add_distrib]
  map_smul' a x := by simp [Finset.mul_sum]

theorem positive_subspace_finrank_le_one_of_hyperplane
    {κ : Type*} [Fintype κ] (Q : Matrix κ κ ℝ) (f : (κ → ℝ) →ₗ[ℝ] ℝ)
    (hQ : ∀ x, f x = 0 → dotProduct x (Q.mulVec x) ≤ 0)
    (U : Submodule ℝ (κ → ℝ))
    (hU : ∀ x : U, x ≠ 0 → 0 < dotProduct (x : κ → ℝ) (Q.mulVec x)) :
    Module.finrank ℝ U ≤ 1 := by
  let g : U →ₗ[ℝ] ℝ := f.comp U.subtype
  have hker : ∀ x : U, g x = 0 → x = 0 := by
    intro x hx
    by_contra hne
    have hpos := hU x hne
    have hnonpos := hQ (x : κ → ℝ) hx
    linarith
  have hg : Function.Injective g := by
    intro x y hxy
    apply sub_eq_zero.mp
    apply hker
    simp only [map_sub, hxy, sub_self]
  simpa using LinearMap.finrank_le_finrank_of_injective hg

theorem finite_positive_subspace_finrank_le_one (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε)
    (U : Submodule ℝ (ι → ℝ))
    (hU : ∀ x : U, x ≠ 0 →
      0 < dotProduct (x : ι → ℝ) ((finitePerturbed t ε).mulVec x)) :
    Module.finrank ℝ U ≤ 1 := by
  apply positive_subspace_finrank_le_one_of_hyperplane (finitePerturbed t ε)
    sumFunctional (fun x hx ↦ finite_nonpos_of_sum_zero t hε x hx) U hU

theorem extended_positive_subspace_finrank_le_one (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε)
    (U : Submodule ℝ ((ι ⊕ Unit) → ℝ))
    (hU : ∀ x : U, x ≠ 0 →
      0 < dotProduct (x : (ι ⊕ Unit) → ℝ) ((extendedPerturbed t ε).mulVec x)) :
    Module.finrank ℝ U ≤ 1 := by
  apply positive_subspace_finrank_le_one_of_hyperplane (extendedPerturbed t ε)
    extendedSumFunctional (fun x hx ↦ extended_nonpos_of_sum_zero t hε x hx) U hU

omit [Fintype ι] in
theorem finite_diagonal (t : ι → ℝ) (ε : ℝ) (i : ι) :
    finitePerturbed t ε i i = 0 := by simp [finitePerturbed]

omit [Fintype ι] in
theorem finite_symmetric (t : ι → ℝ) (ε : ℝ) :
    (finitePerturbed t ε).transpose = finitePerturbed t ε := by
  ext i j
  simp only [Matrix.transpose_apply, finitePerturbed]
  simp only [eq_comm]
  ring

omit [Fintype ι] in
theorem finite_off_diagonal_positive (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε)
    {i j : ι} (hij : i ≠ j) : 0 < finitePerturbed t ε i j := by
  simp only [finitePerturbed, ite_eq_right hij, sub_zero]
  nlinarith [sq_nonneg (t i - t j)]

theorem finite_has_positive_vector (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε)
    {i j : ι} (hij : i ≠ j) :
    ∃ x : ι → ℝ, 0 < dotProduct x ((finitePerturbed t ε).mulVec x) := by
  refine ⟨Pi.single i 1 + Pi.single j 1, ?_⟩
  have hpos := finite_off_diagonal_positive t hε hij
  have hpos' := finite_off_diagonal_positive t hε hij.symm
  simpa [Matrix.mulVec_add, add_dotProduct, single_dotProduct,
    Matrix.mulVec_single, finite_diagonal] using add_pos hpos' hpos

theorem kernel_eq_zero_of_negative_hyperplane
    {κ : Type*} [Fintype κ] (Q : Matrix κ κ ℝ) (hsym : Q.transpose = Q)
    (f : (κ → ℝ) →ₗ[ℝ] ℝ)
    (hneg : ∀ x : κ → ℝ, x ≠ 0 → f x = 0 → dotProduct x (Q.mulVec x) < 0)
    (hpos : ∃ u : κ → ℝ, 0 < dotProduct u (Q.mulVec u))
    {x : κ → ℝ} (hx : Q.mulVec x = 0) : x = 0 := by
  by_contra hxne
  have hfx : f x ≠ 0 := by
    intro hfx
    have hn := hneg x hxne hfx
    simp [hx] at hn
  obtain ⟨u, hu⟩ := hpos
  let z : κ → ℝ := f x • u - f u • x
  have hfz : f z = 0 := by
    simp only [z, map_sub, map_smul, smul_eq_mul]
    ring
  have hxu : dotProduct x (Q.mulVec u) = 0 := by
    calc
      dotProduct x (Q.mulVec u) = dotProduct x (Q.transpose.mulVec u) := by rw [hsym]
      _ = dotProduct u (Q.mulVec x) := Matrix.dotProduct_transpose_mulVec Q x u
      _ = 0 := by rw [hx, dotProduct_zero]
  have hqz : dotProduct z (Q.mulVec z) = (f x) ^ 2 * dotProduct u (Q.mulVec u) := by
    dsimp [z]
    rw [Matrix.mulVec_sub, Matrix.mulVec_smul, Matrix.mulVec_smul, hx, smul_zero,
      sub_zero]
    simp only [sub_dotProduct, smul_dotProduct, dotProduct_smul, smul_eq_mul,
      hxu, mul_zero, sub_zero]
    ring
  have hzpos : 0 < dotProduct z (Q.mulVec z) := by
    rw [hqz]
    exact mul_pos (sq_pos_of_ne_zero hfx) hu
  have hzne : z ≠ 0 := by
    intro hz
    simp [hz] at hzpos
  have hzneg := hneg z hzne hfz
  linarith

theorem finite_kernel_eq_zero [Nontrivial ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε)
    {x : ι → ℝ} (hx : (finitePerturbed t ε).mulVec x = 0) : x = 0 := by
  obtain ⟨i, j, hij⟩ := exists_pair_ne ι
  exact kernel_eq_zero_of_negative_hyperplane (finitePerturbed t ε) (finite_symmetric t ε)
    sumFunctional (fun x hx hs ↦ finite_negative_of_sum_zero t hε hx hs)
    (finite_has_positive_vector t hε hij) hx

theorem finite_mulVec_injective [Nontrivial ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε) :
    Function.Injective (finitePerturbed t ε).mulVec := by
  intro x y hxy
  apply sub_eq_zero.mp
  apply finite_kernel_eq_zero t hε
  rw [Matrix.mulVec_sub, hxy, sub_self]

theorem finite_det_ne_zero [Nontrivial ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε) :
    (finitePerturbed t ε).det ≠ 0 := by
  have hu : IsUnit (finitePerturbed t ε) :=
    Matrix.mulVec_injective_iff_isUnit.mp (finite_mulVec_injective t hε)
  exact ((Matrix.isUnit_iff_isUnit_det _).mp hu).ne_zero

omit [Fintype ι] in
theorem extended_symmetric (t : ι → ℝ) (ε : ℝ) :
    (extendedPerturbed t ε).transpose = extendedPerturbed t ε := by
  ext i j
  cases i <;> cases j <;>
    simp [Matrix.transpose_apply, extendedPerturbed, finitePerturbed, eq_comm]
  ring

omit [Fintype ι] in
theorem extended_diagonal (t : ι → ℝ) (ε : ℝ) (i : ι ⊕ Unit) :
    extendedPerturbed t ε i i = 0 := by
  cases i <;> simp [extendedPerturbed, finite_diagonal]

omit [Fintype ι] in
theorem extended_off_diagonal_positive (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε)
    {i j : ι ⊕ Unit} (hij : i ≠ j) : 0 < extendedPerturbed t ε i j := by
  rcases i with i | ⟨⟩ <;> rcases j with j | ⟨⟩
  · exact finite_off_diagonal_positive t hε (fun h ↦ hij (congrArg Sum.inl h))
  · change 0 < 1 + ε
    linarith
  · change 0 < 1 + ε
    linarith
  · exact (hij rfl).elim

theorem extended_has_positive_vector [Nonempty ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∃ x : (ι ⊕ Unit) → ℝ, 0 < dotProduct x ((extendedPerturbed t ε).mulVec x) := by
  obtain ⟨i⟩ := ‹Nonempty ι›
  refine ⟨Pi.single (Sum.inl i) 1 + Pi.single (Sum.inr ()) 1, ?_⟩
  simp [Matrix.mulVec_add, add_dotProduct, single_dotProduct,
    Matrix.mulVec_single, extendedPerturbed, finite_diagonal]
  linarith

theorem extended_mulVec_injective [Nonempty ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε) :
    Function.Injective (extendedPerturbed t ε).mulVec := by
  intro x y hxy
  apply sub_eq_zero.mp
  apply extended_kernel_eq_zero t hε
  rw [Matrix.mulVec_sub, hxy, sub_self]

theorem extended_det_ne_zero [Nonempty ι] (t : ι → ℝ) {ε : ℝ} (hε : 0 < ε) :
    (extendedPerturbed t ε).det ≠ 0 := by
  have hu : IsUnit (extendedPerturbed t ε) :=
    Matrix.mulVec_injective_iff_isUnit.mp (extended_mulVec_injective t hε)
  exact ((Matrix.isUnit_iff_isUnit_det _).mp hu).ne_zero

omit [Fintype ι] in
theorem finite_principal_restriction {κ : Type*} [DecidableEq κ]
    (t : ι → ℝ) (ε : ℝ) (e : κ → ι) (he : Function.Injective e) :
    (finitePerturbed t ε).submatrix e e = finitePerturbed (t ∘ e) ε := by
  ext i j
  simp [Matrix.submatrix, finitePerturbed, he.eq_iff]

omit [Fintype ι] in
theorem extended_principal_restriction {κ : Type*} [DecidableEq κ]
    (t : ι → ℝ) (ε : ℝ) (e : κ → ι) (he : Function.Injective e) :
    (extendedPerturbed t ε).submatrix (Sum.map e id) (Sum.map e id) =
      extendedPerturbed (t ∘ e) ε := by
  ext i j
  cases i <;> cases j <;>
    simp [Matrix.submatrix, extendedPerturbed, finitePerturbed,
      he.eq_iff]

def strictAreaMatrix (n : ℕ) (ε : ℝ) : Matrix (Fin n ⊕ Unit) (Fin n ⊕ Unit) ℝ :=
  extendedPerturbed (fun i : Fin n ↦ (i.val : ℝ)) ε

theorem strictAreaMatrix_eq (n : ℕ) (ε : ℝ) (i j : Fin n ⊕ Unit) :
    strictAreaMatrix n ε i j = ProjectionAreaUniform.areaMatrix n i j +
      if i = j then 0 else ε := by
  rcases i with i | ⟨⟩ <;> rcases j with j | ⟨⟩
  · by_cases hij : i = j
    · subst j
      simp [strictAreaMatrix, extendedPerturbed, finitePerturbed,
        ProjectionAreaUniform.areaMatrix]
    · simp [strictAreaMatrix, extendedPerturbed, finitePerturbed,
        ProjectionAreaUniform.areaMatrix, hij]
  · simp [strictAreaMatrix, extendedPerturbed, ProjectionAreaUniform.areaMatrix]
  · simp [strictAreaMatrix, extendedPerturbed, ProjectionAreaUniform.areaMatrix]
  · simp [strictAreaMatrix, extendedPerturbed, ProjectionAreaUniform.areaMatrix]

theorem uniform_strict_quadratic_identity (n : ℕ) (ε : ℝ)
    (x : (Fin n ⊕ Unit) → ℝ) :
    dotProduct x ((strictAreaMatrix n ε).mulVec x) =
      2 * (∑ i, x (Sum.inl i)) * (∑ i, (i.val : ℝ) ^ 2 * x (Sum.inl i)) -
      2 * (∑ i, (i.val : ℝ) * x (Sum.inl i)) ^ 2 +
      ε * ((∑ i, x (Sum.inl i)) ^ 2 - ∑ i, (x (Sum.inl i)) ^ 2) +
      2 * (1 + ε) * x (Sum.inr ()) * (∑ i, x (Sum.inl i)) :=
  extended_quadratic_identity _ ε x

theorem uniform_strict_kernel_eq_zero {n : ℕ} (hn : 0 < n) {ε : ℝ} (hε : 0 < ε)
    {x : (Fin n ⊕ Unit) → ℝ} (hx : (strictAreaMatrix n ε).mulVec x = 0) : x = 0 := by
  let : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  exact extended_kernel_eq_zero _ hε hx

theorem uniform_strict_det_ne_zero {n : ℕ} (hn : 0 < n) {ε : ℝ} (hε : 0 < ε) :
    (strictAreaMatrix n ε).det ≠ 0 := by
  let : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  exact extended_det_ne_zero _ hε

theorem uniform_strict_has_positive_vector {n : ℕ} (hn : 0 < n) {ε : ℝ} (hε : 0 < ε) :
    ∃ x : (Fin n ⊕ Unit) → ℝ, 0 < dotProduct x ((strictAreaMatrix n ε).mulVec x) := by
  let : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  exact extended_has_positive_vector _ hε

theorem uniform_strict_symmetric (n : ℕ) (ε : ℝ) :
    (strictAreaMatrix n ε).transpose = strictAreaMatrix n ε :=
  extended_symmetric _ ε

theorem uniform_strict_off_diagonal_positive (n : ℕ) {ε : ℝ} (hε : 0 < ε)
    {i j : Fin n ⊕ Unit} (hij : i ≠ j) : 0 < strictAreaMatrix n ε i j :=
  extended_off_diagonal_positive _ hε hij

theorem uniform_strict_positive_subspace_finrank_le_one (n : ℕ) {ε : ℝ} (hε : 0 ≤ ε)
    (U : Submodule ℝ ((Fin n ⊕ Unit) → ℝ))
    (hU : ∀ x : U, x ≠ 0 →
      0 < dotProduct (x : (Fin n ⊕ Unit) → ℝ) ((strictAreaMatrix n ε).mulVec x)) :
    Module.finrank ℝ U ≤ 1 :=
  extended_positive_subspace_finrank_le_one _ hε U hU

theorem uniform_strict_finite_principal_eq {n : ℕ} {κ : Type*} [DecidableEq κ]
    (ε : ℝ) (e : κ → Fin n) (he : Function.Injective e) :
    (strictAreaMatrix n ε).submatrix (fun i ↦ Sum.inl (e i))
        (fun i ↦ Sum.inl (e i)) =
      finitePerturbed (fun i ↦ ((e i).val : ℝ)) ε := by
  exact finite_principal_restriction (fun i : Fin n ↦ (i.val : ℝ)) ε e he

theorem uniform_strict_finite_principal_det_ne_zero {n : ℕ} {κ : Type*}
    [Fintype κ] [DecidableEq κ] [Nontrivial κ]
    {ε : ℝ} (hε : 0 < ε) (e : κ → Fin n) (he : Function.Injective e) :
    ((strictAreaMatrix n ε).submatrix (fun i ↦ Sum.inl (e i))
      (fun i ↦ Sum.inl (e i))).det ≠ 0 := by
  rw [uniform_strict_finite_principal_eq ε e he]
  exact finite_det_ne_zero _ hε

theorem uniform_strict_extended_principal_eq {n : ℕ} {κ : Type*} [DecidableEq κ]
    (ε : ℝ) (e : κ → Fin n) (he : Function.Injective e) :
    (strictAreaMatrix n ε).submatrix (Sum.map e id) (Sum.map e id) =
      extendedPerturbed (fun i ↦ ((e i).val : ℝ)) ε := by
  exact extended_principal_restriction (fun i : Fin n ↦ (i.val : ℝ)) ε e he

theorem uniform_strict_extended_principal_det_ne_zero {n : ℕ} {κ : Type*}
    [Fintype κ] [DecidableEq κ] [Nonempty κ]
    {ε : ℝ} (hε : 0 < ε) (e : κ → Fin n) (he : Function.Injective e) :
    ((strictAreaMatrix n ε).submatrix (Sum.map e id) (Sum.map e id)).det ≠ 0 := by
  rw [uniform_strict_extended_principal_eq ε e he]
  exact extended_det_ne_zero _ hε

theorem uniform_strict_five_coordinate_restriction {n : ℕ} (hn : 4 ≤ n) (ε : ℝ) :
    (strictAreaMatrix n ε).submatrix (ProjectionAreaUniform.selectedFive hn)
        (ProjectionAreaUniform.selectedFive hn) =
      fun i j ↦ ProjectionAreaUniform.referenceFiveMatrix i j +
        if i = j then 0 else ε := by
  ext i j
  simp only [Matrix.submatrix_apply, strictAreaMatrix_eq,
    (ProjectionAreaUniform.selectedFive_injective hn).eq_iff]
  have h := congrArg (fun M : Matrix (Fin 5) (Fin 5) ℝ ↦ M i j)
    (ProjectionAreaUniform.uniform_five_coordinate_restriction hn)
  change ProjectionAreaUniform.areaMatrix n (ProjectionAreaUniform.selectedFive hn i)
    (ProjectionAreaUniform.selectedFive hn j) =
    ProjectionAreaUniform.referenceFiveMatrix i j at h
  rw [h]

end ProjectionAreaStrict
end StrictPerturbationSource

/-! ## EigenvalueCount -/
section EigenvalueCountSource

/-!
The spectral bridge used in the manuscript.  The eigenvalue list is Mathlib's
orthonormal spectral list, so repeated eigenvalues are counted with their
multiplicities.  A quadratic form that is nonpositive on the kernel of one
linear functional has at most one strictly positive eigenvalue.
-/

open Matrix Finset
open scoped BigOperators Matrix

namespace ProjectionAreaEigenvalues

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem eigenbasis_dot (M : Matrix ι ι ℝ) (hM : M.IsHermitian) (i j : ι) :
    dotProduct (⇑(hM.eigenvectorBasis i)) (⇑(hM.eigenvectorBasis j)) =
      if i = j then 1 else 0 := by
  simpa [EuclideanSpace.inner_eq_star_dotProduct, eq_comm] using
    hM.eigenvectorBasis.inner_eq_ite j i

theorem positive_eigenvalues_unique
    (M : Matrix ι ι ℝ) (hM : M.IsHermitian)
    (f : (ι → ℝ) →ₗ[ℝ] ℝ)
    (hf : ∀ x, f x = 0 → dotProduct x (M.mulVec x) ≤ 0)
    (i j : ι) (hi : 0 < hM.eigenvalues i) (hj : 0 < hM.eigenvalues j) : i = j := by
  by_contra hij
  let u : ι → ℝ := ⇑(hM.eigenvectorBasis i)
  let v : ι → ℝ := ⇑(hM.eigenvectorBasis j)
  have huu : dotProduct u u = 1 := by simpa [u] using eigenbasis_dot M hM i i
  have hvv : dotProduct v v = 1 := by simpa [v] using eigenbasis_dot M hM j j
  have huv : dotProduct u v = 0 := by simpa [u, v, hij] using eigenbasis_dot M hM i j
  have hvu : dotProduct v u = 0 := by simpa [u, v, Ne.symm hij] using eigenbasis_dot M hM j i
  have hMu : M.mulVec u = hM.eigenvalues i • u := hM.mulVec_eigenvectorBasis i
  have hMv : M.mulVec v = hM.eigenvalues j • v := hM.mulVec_eigenvectorBasis j
  have hQu : dotProduct u (M.mulVec u) = hM.eigenvalues i := by
    rw [hMu, dotProduct_smul, huu]
    simp
  have hfu : f u ≠ 0 := by
    intro hzero
    have hn := hf u hzero
    rw [hQu] at hn
    exact (not_le_of_gt hi) hn
  let x : ι → ℝ := (f v) • u - (f u) • v
  have hfx : f x = 0 := by
    dsimp [x]
    simp only [map_sub, map_smul, smul_eq_mul]
    ring
  have hQx : dotProduct x (M.mulVec x) =
      (f v) ^ 2 * hM.eigenvalues i + (f u) ^ 2 * hM.eigenvalues j := by
    dsimp [x]
    simp only [Matrix.mulVec_sub, Matrix.mulVec_smul, hMu, hMv,
      sub_dotProduct, dotProduct_sub, smul_dotProduct, dotProduct_smul,
      huu, hvv, huv, hvu, smul_eq_mul]
    ring
  have hpos : 0 < (f v) ^ 2 * hM.eigenvalues i +
      (f u) ^ 2 * hM.eigenvalues j :=
    add_pos_of_nonneg_of_pos (mul_nonneg (sq_nonneg _) hi.le)
      (mul_pos (sq_pos_of_ne_zero hfu) hj)
  have hn := hf x hfx
  rw [hQx] at hn
  exact (not_le_of_gt hpos) hn

theorem positive_eigenvalue_count_le_one
    (M : Matrix ι ι ℝ) (hM : M.IsHermitian)
    (f : (ι → ℝ) →ₗ[ℝ] ℝ)
    (hf : ∀ x, f x = 0 → dotProduct x (M.mulVec x) ≤ 0) :
    (Finset.univ.filter (fun i => 0 < hM.eigenvalues i)).card ≤ 1 := by
  classical
  apply Finset.card_le_one.mpr
  intro i hi j hj
  have hi' : 0 < hM.eigenvalues i := (Finset.mem_filter.mp hi).2
  have hj' : 0 < hM.eigenvalues j := (Finset.mem_filter.mp hj).2
  exact positive_eigenvalues_unique M hM f hf i j hi' hj'

def selectRows {κ : Type*} (e : κ → ι) : Matrix κ ι ℝ :=
  fun i j => if e i = j then 1 else 0

theorem principal_factor {κ : Type*} (M : Matrix ι ι ℝ) (e : κ → ι) :
    M.submatrix e e = selectRows e * M * (selectRows e).transpose := by
  ext i j
  simp [selectRows, Matrix.mul_apply, Matrix.submatrix, Matrix.transpose_apply]

omit [DecidableEq ι] in
theorem quadratic_pullback {κ : Type*} [Fintype κ]
    (M : Matrix ι ι ℝ) (B : Matrix κ ι ℝ) (x : κ → ℝ) :
    dotProduct x ((B * M * B.transpose).mulVec x) =
      dotProduct (B.transpose.mulVec x) (M.mulVec (B.transpose.mulVec x)) := by
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose]

def pullbackMap {κ : Type*} [Fintype κ] (B : Matrix κ ι ℝ) :
    (κ → ℝ) →ₗ[ℝ] (ι → ℝ) where
  toFun x := B.transpose.mulVec x
  map_add' x y := Matrix.mulVec_add _ _ _
  map_smul' a x := by simp [Matrix.mulVec_smul]

theorem principal_positive_eigenvalue_count_le_one
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (M : Matrix ι ι ℝ) (hM : M.IsHermitian)
    (f : (ι → ℝ) →ₗ[ℝ] ℝ)
    (hf : ∀ x, f x = 0 → dotProduct x (M.mulVec x) ≤ 0)
    (e : κ → ι) :
    (Finset.univ.filter (fun i => 0 < (hM.submatrix e).eigenvalues i)).card ≤ 1 := by
  apply positive_eigenvalue_count_le_one (M.submatrix e e) (hM.submatrix e)
    (f.comp (pullbackMap (selectRows e)))
  intro x hx
  rw [principal_factor, quadratic_pullback]
  exact hf _ hx

theorem uniform_isHermitian (n : ℕ) :
    (ProjectionAreaUniform.areaMatrix n).IsHermitian := by
  exact Matrix.isHermitian_iff_isSymm.mpr (ProjectionAreaUniform.areaMatrix_symmetric n)

theorem uniform_positive_eigenvalue_count_le_one (n : ℕ) :
    (Finset.univ.filter (fun i => 0 < (uniform_isHermitian n).eigenvalues i)).card ≤ 1 := by
  apply positive_eigenvalue_count_le_one
    (ProjectionAreaUniform.areaMatrix n) (uniform_isHermitian n)
    (ProjectionAreaUniform.timeFunctional (ProjectionAreaUniform.rows n))
  intro x hx
  rw [ProjectionAreaUniform.uniform_gram_factorization]
  exact ProjectionAreaUniform.gram_nonpos_of_time_zero _ _ hx

theorem uniform_principal_positive_eigenvalue_count_le_one
    (n : ℕ) (e : ι → Fin n ⊕ Unit) :
    (Finset.univ.filter (fun i =>
      0 < ((uniform_isHermitian n).submatrix e).eigenvalues i)).card ≤ 1 := by
  apply positive_eigenvalue_count_le_one
    ((ProjectionAreaUniform.areaMatrix n).submatrix e e)
    ((uniform_isHermitian n).submatrix e)
    (ProjectionAreaUniform.timeFunctional ((ProjectionAreaUniform.rows n).submatrix e id))
  intro x hx
  rw [ProjectionAreaUniform.uniform_gram_factorization,
    ProjectionAreaUniform.gram_principal_factor]
  exact ProjectionAreaUniform.gram_nonpos_of_time_zero _ _ hx

omit [Fintype ι] in
theorem finite_perturbed_isHermitian (t : ι → ℝ) (ε : ℝ) :
    (ProjectionAreaStrict.finitePerturbed t ε).IsHermitian := by
  exact Matrix.isHermitian_iff_isSymm.mpr (ProjectionAreaStrict.finite_symmetric t ε)

omit [Fintype ι] in
theorem extended_perturbed_isHermitian (t : ι → ℝ) (ε : ℝ) :
    (ProjectionAreaStrict.extendedPerturbed t ε).IsHermitian := by
  exact Matrix.isHermitian_iff_isSymm.mpr (ProjectionAreaStrict.extended_symmetric t ε)

theorem finite_perturbed_positive_eigenvalue_count_le_one
    (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε) :
    (Finset.univ.filter (fun i =>
      0 < (finite_perturbed_isHermitian t ε).eigenvalues i)).card ≤ 1 := by
  apply positive_eigenvalue_count_le_one _ (finite_perturbed_isHermitian t ε)
    ProjectionAreaStrict.sumFunctional
  exact ProjectionAreaStrict.finite_nonpos_of_sum_zero t hε

theorem extended_perturbed_positive_eigenvalue_count_le_one
    (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε) :
    (Finset.univ.filter (fun i =>
      0 < (extended_perturbed_isHermitian t ε).eigenvalues i)).card ≤ 1 := by
  apply positive_eigenvalue_count_le_one _ (extended_perturbed_isHermitian t ε)
    ProjectionAreaStrict.extendedSumFunctional
  exact ProjectionAreaStrict.extended_nonpos_of_sum_zero t hε

theorem extended_perturbed_principal_positive_eigenvalue_count_le_one
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (t : ι → ℝ) {ε : ℝ} (hε : 0 ≤ ε) (e : κ → ι ⊕ Unit) :
    (Finset.univ.filter (fun i =>
      0 < ((extended_perturbed_isHermitian t ε).submatrix e).eigenvalues i)).card ≤ 1 := by
  apply principal_positive_eigenvalue_count_le_one _ (extended_perturbed_isHermitian t ε)
    ProjectionAreaStrict.extendedSumFunctional
  exact ProjectionAreaStrict.extended_nonpos_of_sum_zero t hε

end ProjectionAreaEigenvalues
end EigenvalueCountSource

/-! ## SpectralFourCriterion -/
section SpectralFourCriterionSource

/-!
The actual spectral-to-construction bridge in four coordinates.
Mathlib's orthonormal spectral list counts eigenvalues with multiplicity.
For a real symmetric hollow 4×4 matrix, at most one positive eigenvalue
forces det ≤ 0. The determinant then gives the zero-entry cross-minor
condition or, for strictly positive entries, the three opposite-root
triangle inequalities. No congruence-invariance theorem is assumed.
-/

open Matrix Finset
open scoped BigOperators Matrix

namespace ProjectionAreaSpectralFour

theorem one_nonnegative_three_nonpositive_product (a b c d : ℝ)
    (ha : 0 ≤ a) (hb : b ≤ 0) (hc : c ≤ 0) (hd : d ≤ 0) :
    a*b*c*d ≤ 0 := by
  have hbc : 0 ≤ b*c := mul_nonneg_of_nonpos_of_nonpos hb hc
  have habc : 0 ≤ a*(b*c) := mul_nonneg ha hbc
  have h := mul_nonpos_of_nonneg_of_nonpos habc hd
  nlinarith only [h]

theorem four_product_nonpos_of_sum_zero_unique_positive
    (v : Fin 4 → ℝ) (hsum : ∑ i, v i = 0)
    (hunique : ∀ i j, 0 < v i → 0 < v j → i = j) :
    ∏ i, v i ≤ 0 := by
  by_cases hex : ∃ i, 0 < v i
  · obtain ⟨i,hi⟩ := hex
    have hother (j : Fin 4) (hij : i ≠ j) : v j ≤ 0 := by
      by_contra! hj
      exact hij (hunique i j hi hj)
    rw [Fin.prod_univ_four]
    fin_cases i
    · exact one_nonnegative_three_nonpositive_product _ _ _ _ hi.le
        (hother 1 (by decide)) (hother 2 (by decide)) (hother 3 (by decide))
    · have h := one_nonnegative_three_nonpositive_product (v 1) (v 0) (v 2) (v 3)
        hi.le (hother 0 (by decide)) (hother 2 (by decide)) (hother 3 (by decide))
      nlinarith only [h]
    · have h := one_nonnegative_three_nonpositive_product (v 2) (v 0) (v 1) (v 3)
        hi.le (hother 0 (by decide)) (hother 1 (by decide)) (hother 3 (by decide))
      nlinarith only [h]
    · have h := one_nonnegative_three_nonpositive_product (v 3) (v 0) (v 1) (v 2)
        hi.le (hother 0 (by decide)) (hother 1 (by decide)) (hother 2 (by decide))
      nlinarith only [h]
  · push Not at hex
    rw [Fin.sum_univ_four] at hsum
    have hzero : v 0 = 0 := by linarith [hex 0,hex 1,hex 2,hex 3]
    simp [Fin.prod_univ_four,hzero]

/-- The eigenvalue count is the cardinality of the positive part of
Mathlib's actual spectral list, hence includes multiplicity. -/
theorem det_nonpos_of_trace_zero_positive_count_le_one
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (htrace : M.trace = 0)
    (hcount : (Finset.univ.filter (fun i => 0 < hM.eigenvalues i)).card ≤ 1) :
    M.det ≤ 0 := by
  rw [hM.det_eq_prod_eigenvalues]
  simp only [RCLike.ofReal_real_eq_id,id_eq]
  apply four_product_nonpos_of_sum_zero_unique_positive
  · simpa only [RCLike.ofReal_real_eq_id,id_eq] using
      hM.trace_eq_sum_eigenvalues.symm.trans htrace
  · intro i j hi hj
    apply (Finset.card_le_one.mp hcount) _ _ _ _
    · simp [hi]
    · simp [hj]

theorem hollow_four_det_nonpos
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (hdiag : ∀ i, M i i = 0)
    (hcount : (Finset.univ.filter (fun i => 0 < hM.eigenvalues i)).card ≤ 1) :
    M.det ≤ 0 := by
  apply det_nonpos_of_trace_zero_positive_count_le_one M hM _ hcount
  simp [Matrix.trace,hdiag]

def areaMatrix (a b c d e f : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![0,a,b,c; a,0,d,e; b,d,0,f; c,e,f,0]

theorem hollow_symmetric_eq_areaMatrix
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (hdiag : ∀ i, M i i = 0) :
    M = areaMatrix (M 0 1) (M 0 2) (M 0 3) (M 1 2) (M 1 3) (M 2 3) := by
  have hsymm := Matrix.isHermitian_iff_isSymm.mp hM
  ext i j
  fin_cases i <;> fin_cases j <;> simp [areaMatrix,hdiag]
  all_goals exact hsymm.apply _ _

theorem zero_entry_cross_minor_of_spectral
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (hdiag : ∀ i, M i i = 0) (hzero : M 0 1 = 0)
    (hcount : (Finset.univ.filter (fun i => 0 < hM.eigenvalues i)).card ≤ 1) :
    M 0 2 * M 1 3 = M 0 3 * M 1 2 := by
  have hdet := hollow_four_det_nonpos M hM hdiag hcount
  rw [hollow_symmetric_eq_areaMatrix M hM hdiag,hzero] at hdet
  change (ProjectionZeroReduction.zeroEntryMatrix
    (M 0 2) (M 0 3) (M 1 2) (M 1 3) (M 2 3)).det ≤ 0 at hdet
  exact ProjectionZeroReduction.cross_minor_eq_zero_of_det_nonpos _ _ _ _ _ hdet

theorem areaMatrix_determinant (a b c d e f : ℝ) :
    (areaMatrix a b c d e f).det =
      (a*f)^2 + (b*e)^2 + (c*d)^2 -
        2*(a*f)*(b*e) - 2*(a*f)*(c*d) - 2*(b*e)*(c*d) := by
  rw [Matrix.det_succ_row_zero]
  norm_num [areaMatrix,Fin.sum_univ_four,Matrix.det_fin_three,Matrix.submatrix,
    Fin.succAbove]
  ring

theorem areaMatrix_determinant_root_factor (a b c d e f A B C : ℝ)
    (hA : A^2 = a*f) (hB : B^2 = b*e) (hC : C^2 = c*d) :
    (areaMatrix a b c d e f).det =
      -(A+B+C)*(A+B-C)*(A-B+C)*(-A+B+C) := by
  have hid : -(A+B+C)*(A+B-C)*(A-B+C)*(-A+B+C) =
      (A^2)^2 + (B^2)^2 + (C^2)^2 -
        2*(A^2)*(B^2) - 2*(A^2)*(C^2) - 2*(B^2)*(C^2) := by ring
  rw [areaMatrix_determinant,hid,hA,hB,hC]

theorem first_triangle_of_nonpositive_factor (A B C : ℝ)
    (_hA : 0 < A) (hB : 0 < B) (hC : 0 < C)
    (hfactor : -(A+B+C)*(A+B-C)*(A-B+C)*(-A+B+C) ≤ 0) :
    A ≤ B+C := by
  by_contra! hbad
  have h₁ : 0 < A+B+C := by linarith
  have h₂ : 0 < A+B-C := by linarith
  have h₃ : 0 < A-B+C := by linarith
  have h₄ : -A+B+C < 0 := by linarith
  have hneg : -(A+B+C)*(A+B-C)*(A-B+C) < 0 :=
    mul_neg_of_neg_of_pos (mul_neg_of_neg_of_pos (neg_neg_of_pos h₁) h₂) h₃
  exact (not_lt_of_ge hfactor) (mul_pos_of_neg_of_neg hneg h₄)

theorem triangles_of_nonpositive_factor (A B C : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hC : 0 < C)
    (hfactor : -(A+B+C)*(A+B-C)*(A-B+C)*(-A+B+C) ≤ 0) :
    A ≤ B+C ∧ B ≤ A+C ∧ C ≤ A+B := by
  refine ⟨first_triangle_of_nonpositive_factor A B C hA hB hC hfactor,?_,?_⟩
  · apply first_triangle_of_nonpositive_factor B A C hB hA hC
    convert hfactor using 1; ring
  · apply first_triangle_of_nonpositive_factor C A B hC hA hB
    convert hfactor using 1; ring

theorem opposite_roots_triangle_of_det_nonpos (a b c d e f : ℝ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (hd : 0 < d) (he : 0 < e) (hf : 0 < f)
    (hdet : (areaMatrix a b c d e f).det ≤ 0) :
    Real.sqrt (a*f) ≤ Real.sqrt (b*e) + Real.sqrt (c*d) ∧
    Real.sqrt (b*e) ≤ Real.sqrt (a*f) + Real.sqrt (c*d) ∧
    Real.sqrt (c*d) ≤ Real.sqrt (a*f) + Real.sqrt (b*e) := by
  rw [areaMatrix_determinant_root_factor a b c d e f
    (Real.sqrt (a*f)) (Real.sqrt (b*e)) (Real.sqrt (c*d))
    (Real.sq_sqrt (mul_pos ha hf).le)
    (Real.sq_sqrt (mul_pos hb he).le)
    (Real.sq_sqrt (mul_pos hc hd).le)] at hdet
  exact triangles_of_nonpositive_factor _ _ _
    (Real.sqrt_pos.mpr (mul_pos ha hf))
    (Real.sqrt_pos.mpr (mul_pos hb he))
    (Real.sqrt_pos.mpr (mul_pos hc hd)) hdet

theorem opposite_roots_triangle_of_matrix_det_nonpos
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hsymm : M.IsSymm)
    (hdiag : ∀ i, M i i = 0) (hpos : ∀ i j, i ≠ j → 0 < M i j)
    (hdet : M.det ≤ 0) :
    Real.sqrt (M 0 1*M 2 3) ≤ Real.sqrt (M 0 2*M 1 3) + Real.sqrt (M 0 3*M 1 2) ∧
    Real.sqrt (M 0 2*M 1 3) ≤ Real.sqrt (M 0 1*M 2 3) + Real.sqrt (M 0 3*M 1 2) ∧
    Real.sqrt (M 0 3*M 1 2) ≤ Real.sqrt (M 0 1*M 2 3) + Real.sqrt (M 0 2*M 1 3) := by
  have hM : M.IsHermitian := Matrix.isHermitian_iff_isSymm.mpr hsymm
  rw [hollow_symmetric_eq_areaMatrix M hM hdiag] at hdet
  exact opposite_roots_triangle_of_det_nonpos _ _ _ _ _ _
    (hpos 0 1 (by decide)) (hpos 0 2 (by decide)) (hpos 0 3 (by decide))
    (hpos 1 2 (by decide)) (hpos 1 3 (by decide)) (hpos 2 3 (by decide)) hdet

/-- The positive-data triangle criterion follows from the actual
one-positive-eigenvalue condition, with no algebraic replacement of that
condition in the hypothesis. -/
theorem opposite_roots_triangle_of_spectral
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (hdiag : ∀ i, M i i = 0) (hpos : ∀ i j, i ≠ j → 0 < M i j)
    (hcount : (Finset.univ.filter (fun i => 0 < hM.eigenvalues i)).card ≤ 1) :
    Real.sqrt (M 0 1*M 2 3) ≤ Real.sqrt (M 0 2*M 1 3) + Real.sqrt (M 0 3*M 1 2) ∧
    Real.sqrt (M 0 2*M 1 3) ≤ Real.sqrt (M 0 1*M 2 3) + Real.sqrt (M 0 3*M 1 2) ∧
    Real.sqrt (M 0 3*M 1 2) ≤ Real.sqrt (M 0 1*M 2 3) + Real.sqrt (M 0 2*M 1 3) := by
  exact opposite_roots_triangle_of_matrix_det_nonpos M
    (Matrix.isHermitian_iff_isSymm.mp hM) hdiag hpos
    (hollow_four_det_nonpos M hM hdiag hcount)

end ProjectionAreaSpectralFour
end SpectralFourCriterionSource

/-! ## FourDimensionalRealizer -/
section FourDimensionalRealizerSource

/-!
Full four-dimensional sufficiency, with actual eigenvalues and actual
Lebesgue projection areas.  Every nonnegative hollow symmetric matrix is
covered, including every zero pattern and every singular boundary case.
One compact convex nonempty set realizes all entries simultaneously.
-/

open Set Matrix MeasureTheory
open ProjectionAreaBoundaryPolytope ProjectionAreaTransforms
open ProjectionAreaPositiveFour ProjectionAreaZeroPair ProjectionAreaSpectralFour

namespace ProjectionAreaFourDimensional

noncomputable section

theorem exists_realizer_of_nonpositive_determinant
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (hdiag : ∀ i, M i i = 0) (hnonneg : ∀ i j, 0 ≤ M i j)
    (hdet : M.det ≤ 0) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      ∀ i j, (volume : Measure V2).real (projectN i j '' K) = M i j := by
  classical
  have hsym : ∀ i j, M i j = M j i := by
    intro i j
    exact (Matrix.isHermitian_iff_isSymm.mp hM).apply j i
  by_cases hz : ∃ i j, i ≠ j ∧ M i j = 0
  · obtain ⟨i,j,hij,hzero⟩ := hz
    exact exists_realizer_of_zero_pair M hsym hdiag hnonneg hdet i j hij hzero
  · have hpos : ∀ i j, i ≠ j → 0 < M i j := by
      intro i j hij
      by_contra! hnot
      exact hz ⟨i,j,hij,le_antisymm hnot (hnonneg i j)⟩
    have hdet' : (areaMatrix (M 0 1) (M 0 2) (M 0 3)
        (M 1 2) (M 1 3) (M 2 3)).det ≤ 0 := by
      rw [← hollow_symmetric_eq_areaMatrix M hM hdiag]
      exact hdet
    obtain ⟨hA,hB,hC⟩ := opposite_roots_triangle_of_det_nonpos
      (M 0 1) (M 0 2) (M 0 3) (M 1 2) (M 1 3) (M 2 3)
      (hpos 0 1 (by decide)) (hpos 0 2 (by decide)) (hpos 0 3 (by decide))
      (hpos 1 2 (by decide)) (hpos 1 3 (by decide)) (hpos 2 3 (by decide)) hdet'
    obtain ⟨K,hc,hv,hn,h01,h02,h03,h12,h13,h23⟩ :=
      exists_positive_six_realizer_of_opposite_triangles
        (M 0 1) (M 0 2) (M 0 3) (M 1 2) (M 1 3) (M 2 3)
        (hpos 0 1 (by decide)) (hpos 0 2 (by decide)) (hpos 0 3 (by decide))
        (hpos 1 2 (by decide)) (hpos 1 3 (by decide)) (hpos 2 3 (by decide)) hA hB hC
    exact ⟨K,hc,hv,hn,six_areas_complete K M hsym hdiag h01 h02 h03 h12 h13 h23⟩

/-- The complete sufficient direction of the four-dimensional criterion.
The actual spectral list counts eigenvalues with multiplicity. -/
theorem four_dimensional_spectral_sufficiency
    (M : Matrix (Fin 4) (Fin 4) ℝ) (hM : M.IsHermitian)
    (hdiag : ∀ i, M i i = 0) (hnonneg : ∀ i j, 0 ≤ M i j)
    (hcount : (Finset.univ.filter (fun i => 0 < hM.eigenvalues i)).card ≤ 1) :
    ∃ K : Set V4, IsCompact K ∧ Convex ℝ K ∧ K.Nonempty ∧
      ∀ i j, (volume : Measure V2).real (projectN i j '' K) = M i j := by
  exact exists_realizer_of_nonpositive_determinant M hM hdiag hnonneg
    (hollow_four_det_nonpos M hM hdiag hcount)

end

end ProjectionAreaFourDimensional
end FourDimensionalRealizerSource

end
