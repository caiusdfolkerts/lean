/-! ## WeightedTriangleTopology -/

section WeightedTriangleTopologySource
/-!
# The closed cone of weighted triangle data

This is the closedness assertion for the escape set in Theorem 3.3.
The weights may vanish.  Their nonzero condition is normalized to sum one;
compactness of that actual simplex then passes witnesses to limits.
No geometric realization or compactification assertion is assumed here.
-/

noncomputable section
open Set Filter TopologicalSpace
open scoped Topology BigOperators

namespace ProjectionAreaEscape

abbrev ProjectionArray (n : ℕ) := Matrix (Fin n) (Fin n) ℝ

def WeightedTriangleInequalities {n : ℕ} (q : ProjectionArray n) (w : Fin n → ℝ) : Prop :=
  ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
    w k * q i j ≤ w j * q i k + w i * q j k

def WeightedTriangleWitness {n : ℕ} (q : ProjectionArray n) (w : Fin n → ℝ) : Prop :=
  (∀ i, 0 ≤ w i) ∧ w ≠ 0 ∧ WeightedTriangleInequalities q w

def AdmitsTriangleWeights {n : ℕ} (q : ProjectionArray n) : Prop :=
  ∃ w, WeightedTriangleWitness q w

def WeightSimplex (n : ℕ) : Set (Fin n → ℝ) :=
  {w | (∀ i, 0 ≤ w i) ∧ ∑ i, w i = 1}

def EscapeCone (n : ℕ) : Set (ProjectionArray n) :=
  {q | (∀ i, q i i = 0) ∧ (∀ i j, q i j = q j i) ∧
    (∀ i j, 0 ≤ q i j) ∧ AdmitsTriangleWeights q}

theorem sum_weights_pos {n : ℕ} {w : Fin n → ℝ}
    (hw : ∀ i, 0 ≤ w i) (hne : w ≠ 0) : 0 < ∑ i, w i := by
  classical
  have hex : ∃ i, 0 < w i := by
    by_contra h
    push_neg at h
    apply hne
    ext i
    exact le_antisymm (h i) (hw i)
  obtain ⟨i, hi⟩ := hex
  exact hi.trans_le (Finset.single_le_sum (fun j _ => hw j) (Finset.mem_univ i))

theorem normalize_weightedTriangleWitness {n : ℕ} {q : ProjectionArray n}
    {w : Fin n → ℝ} (hw : WeightedTriangleWitness q w) :
    ∃ v ∈ WeightSimplex n, WeightedTriangleInequalities q v := by
  classical
  let s : ℝ := ∑ i, w i
  have hs : 0 < s := sum_weights_pos hw.1 hw.2.1
  let v : Fin n → ℝ := fun i => s⁻¹ * w i
  refine ⟨v, ⟨fun i => mul_nonneg (inv_nonneg.mpr hs.le) (hw.1 i), ?_⟩, ?_⟩
  · change ∑ i, s⁻¹ * w i = 1
    rw [← Finset.mul_sum]
    exact inv_mul_cancel₀ hs.ne'
  · intro i j k hij hik hjk
    have h := mul_le_mul_of_nonneg_left (hw.2.2 i j k hij hik hjk)
      (inv_nonneg.mpr hs.le)
    simpa only [v, mul_add, mul_assoc] using h

theorem admitsTriangleWeights_iff_normalized {n : ℕ} {q : ProjectionArray n} :
    AdmitsTriangleWeights q ↔
      ∃ w ∈ WeightSimplex n, WeightedTriangleInequalities q w := by
  constructor
  · rintro ⟨w, hw⟩
    exact normalize_weightedTriangleWitness hw
  · rintro ⟨w, hw, hineq⟩
    refine ⟨w, hw.1, ?_, hineq⟩
    intro hz
    have hsum := hw.2
    simp [hz] at hsum

theorem isClosed_weightSimplex (n : ℕ) : IsClosed (WeightSimplex n) := by
  unfold WeightSimplex
  simp only [setOf_and, setOf_forall]
  exact (isClosed_iInter fun i => isClosed_le continuous_const (continuous_apply i)).inter
    (isClosed_eq (by fun_prop) continuous_const)

theorem weightSimplex_subset_unitCube (n : ℕ) :
    WeightSimplex n ⊆ Icc (0 : Fin n → ℝ) 1 := by
  intro w hw
  refine ⟨hw.1, ?_⟩
  intro i
  have hi := Finset.single_le_sum (s := Finset.univ)
    (fun j _ => hw.1 j) (Finset.mem_univ i)
  simpa only [hw.2, Pi.one_apply] using hi

theorem isCompact_weightSimplex (n : ℕ) : IsCompact (WeightSimplex n) :=
  isCompact_Icc.of_isClosed_subset (isClosed_weightSimplex n)
    (weightSimplex_subset_unitCube n)

/-- Feasibility of the homogeneous weighted inequalities is closed, even
before symmetry, nonnegativity and zero diagonal are imposed on the data. -/
theorem isClosed_admitsTriangleWeights (n : ℕ) :
    IsClosed {q : ProjectionArray n | AdmitsTriangleWeights q} := by
  classical
  letI : FirstCountableTopology (ProjectionArray n) :=
    inferInstanceAs (FirstCountableTopology (Fin n → Fin n → ℝ))
  apply IsSeqClosed.isClosed
  intro q qlim hq hlim
  have hw : ∀ m, ∃ w ∈ WeightSimplex n, WeightedTriangleInequalities (q m) w :=
    fun m => admitsTriangleWeights_iff_normalized.mp (hq m)
  choose w hw_simplex hw_ineq using hw
  obtain ⟨v, hv, φ, hφ, hwlim⟩ := (isCompact_weightSimplex n).tendsto_subseq hw_simplex
  apply admitsTriangleWeights_iff_normalized.mpr
  refine ⟨v, hv, ?_⟩
  intro i j k hij hik hjk
  have hqsub := hlim.comp hφ.tendsto_atTop
  have hentry (a b : Fin n) :
      Tendsto (fun m => q (φ m) a b) atTop (𝓝 (qlim a b)) := by
    have hrow : Continuous (fun p : Fin n → Fin n → ℝ => p a) := continuous_apply a
    have heval : Continuous (fun p : Fin n → Fin n → ℝ => p a b) :=
      (continuous_apply b).comp hrow
    exact heval.continuousAt.tendsto.comp hqsub
  have hweight (a : Fin n) :
      Tendsto (fun m => w (φ m) a) atTop (𝓝 (v a)) :=
    (continuous_apply a).continuousAt.tendsto.comp hwlim
  exact le_of_tendsto_of_tendsto'
    ((hweight k).mul (hentry i j))
    (((hweight j).mul (hentry i k)).add ((hweight i).mul (hentry j k)))
    (fun m => hw_ineq (φ m) i j k hij hik hjk)

theorem isClosed_escapeCone (n : ℕ) : IsClosed (EscapeCone n) := by
  unfold EscapeCone
  simp only [setOf_and, setOf_forall]
  refine (isClosed_iInter fun i => isClosed_eq (by fun_prop) continuous_const).inter ?_
  refine (isClosed_iInter fun i => isClosed_iInter fun j =>
    isClosed_eq (by fun_prop) (by fun_prop)).inter ?_
  exact (isClosed_iInter fun i => isClosed_iInter fun j =>
    isClosed_le continuous_const (by fun_prop)).inter (isClosed_admitsTriangleWeights n)

end ProjectionAreaEscape

end
end WeightedTriangleTopologySource


/-! ## ProjectionAreaTopology -/

section ProjectionAreaTopologySource
/-!
# Compactness and the actual coordinate-area map

The area of a coordinate projection is ordinary planar Lebesgue measure.
Continuity includes bodies with empty interior.  The last part proves the
compact-versus-diverging-diameter alternative for any continuous,
translation-invariant function of compact convex bodies, and specializes it
to the coordinate projection areas.  The input space is Euclidean space, so
the diameter in the final statements is the ordinary Euclidean diameter.
-/

noncomputable section

open Set Metric MeasureTheory Filter TopologicalSpace
open scoped Pointwise Topology

namespace ProjectionAreaTopology

section BodyImages

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

def linearImageBody (f : E →L[ℝ] F) (K : ConvexBody E) : ConvexBody F where
  carrier := f '' (K : Set E)
  convex' := K.convex.linear_image f.toLinearMap
  isCompact' := K.isCompact.image f.continuous
  nonempty' := K.nonempty.image f

@[simp] theorem coe_linearImageBody (f : E →L[ℝ] F) (K : ConvexBody E) :
    (linearImageBody f K : Set F) = f '' (K : Set E) := rfl

theorem continuous_linearImageBody (f : E →L[ℝ] F) :
    Continuous (linearImageBody f) := by
  apply VolumePolynomials.isometry_bodyToNonemptyCompacts.comp_continuous_iff.mp
  change Continuous (fun K : ConvexBody E =>
    (VolumePolynomials.bodyToNonemptyCompacts K).map f f.continuous)
  exact (Continuous.nonemptyCompacts_map f.continuous).comp
    VolumePolynomials.continuous_bodyToNonemptyCompacts

def pointBody (v : E) : ConvexBody E where
  carrier := {v}
  convex' := convex_singleton v
  isCompact' := isCompact_singleton
  nonempty' := singleton_nonempty v

def translateBody (v : E) (K : ConvexBody E) : ConvexBody E := pointBody v + K

@[simp] theorem coe_translateBody (v : E) (K : ConvexBody E) :
    (translateBody v K : Set E) = (fun x => v + x) '' (K : Set E) := by
  change ({v} : Set E) + (K : Set E) = _
  ext z
  constructor
  · rintro ⟨a, ha, b, hb, rfl⟩
    have hav : a = v := ha
    exact ⟨b, hb, by rw [hav]⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨v, rfl, x, hx, rfl⟩

theorem diameter_translateBody (v : E) (K : ConvexBody E) :
    diam (translateBody v K : Set E) = diam (K : Set E) := by
  rw [coe_translateBody]
  have h : Isometry (fun x : E => v + x) :=
    Isometry.of_dist_eq fun x y => by simp [dist_eq_norm]
  exact h.diam_image _

theorem zero_mem_translateBody_neg {K : ConvexBody E} {x : E} (hx : x ∈ K) :
    (0 : E) ∈ translateBody (-x) K := by
  change (0 : E) ∈ (translateBody (-x) K : Set E)
  rw [coe_translateBody]
  exact ⟨x, hx, neg_add_cancel x⟩

theorem subset_diameter_closedBall {K : ConvexBody E} (h0 : (0 : E) ∈ K) :
    (K : Set E) ⊆ closedBall 0 (diam (K : Set E)) := by
  intro x hx
  exact dist_le_diam_of_mem K.isBounded hx h0

end BodyImages

section CompactnessAlternative

variable {E Y : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [TopologicalSpace Y] [T2Space Y]

/-- For a convergent sequence of translation-invariant data, either the
limit is attained by a convex body or the original diameters tend to infinity.
If the diameters fail to tend to infinity, infinitely many translated bodies
lie in one compact Hausdorff family. -/
theorem realized_or_diameter_tendsto_atTop
    (f : ConvexBody E → Y) (hf : Continuous f)
    (htrans : ∀ v K, f (translateBody v K) = f K)
    (K : ℕ → ConvexBody E) {y : Y}
    (hy : Tendsto (fun n => f (K n)) atTop (𝓝 y)) :
    (∃ L : ConvexBody E, f L = y) ∨
      Tendsto (fun n => diam (K n : Set E)) atTop atTop := by
  classical
  by_cases hescape : Tendsto (fun n => diam (K n : Set E)) atTop atTop
  · exact Or.inr hescape
  · left
    have hnot : ¬ ∀ R : ℝ, ∀ᶠ n in atTop, R ≤ diam (K n : Set E) := by
      intro h
      exact hescape (tendsto_atTop.mpr h)
    obtain ⟨R, hR⟩ := not_forall.mp hnot
    have hfrequent : ∃ᶠ n in atTop, diam (K n : Set E) < R := by
      simpa only [Filter.Frequently, not_lt] using hR
    choose x hx using fun n => (K n).nonempty
    let L : ℕ → ConvexBody E := fun n => translateBody (-(x n)) (K n)
    have hL0 (n : ℕ) : (0 : E) ∈ L n := zero_mem_translateBody_neg (hx n)
    have hLdiam (n : ℕ) : diam (L n : Set E) = diam (K n : Set E) :=
      diameter_translateBody _ _
    have hLdata (n : ℕ) : f (L n) = f (K n) := htrans _ _
    have hbounded : ∃ᶠ n in atTop,
        (0 : E) ∈ L n ∧ (L n : Set E) ⊆ closedBall 0 R := by
      apply hfrequent.mono
      intro n hn
      refine ⟨hL0 n, ?_⟩
      exact (subset_diameter_closedBall (hL0 n)).trans
        (closedBall_subset_closedBall (by simpa only [hLdiam] using hn.le))
    obtain ⟨B, _hB, φ, hφ, hconv⟩ :=
      (VolumePolynomials.isCompact_bodies_in_compact
        (isCompact_closedBall (0 : E) R)).tendsto_subseq' hbounded
    refine ⟨B, ?_⟩
    have hdata : Tendsto (fun n => f (L n)) atTop (𝓝 y) := by
      simpa only [hLdata] using hy
    exact tendsto_nhds_unique (hf.continuousAt.tendsto.comp hconv)
      (hdata.comp hφ.tendsto_atTop)

def escapingLimits (f : ConvexBody E → Y) : Set Y :=
  {y | ∃ K : ℕ → ConvexBody E,
    Tendsto (fun n => f (K n)) atTop (𝓝 y) ∧
    Tendsto (fun n => diam (K n : Set E)) atTop atTop}

theorem escapingLimits_subset_closure_range (f : ConvexBody E → Y) :
    escapingLimits f ⊆ closure (Set.range f) := by
  rintro y ⟨K, hy, _hdiam⟩
  apply isClosed_closure.mem_of_tendsto hy
  exact Filter.Eventually.of_forall fun n => subset_closure ⟨K n, rfl⟩

/-- The only possible failure of closedness of continuous, translation-invariant
convex-body data comes from bodies of diverging diameter. -/
theorem closure_range_eq_range_union_escapingLimits [FirstCountableTopology Y]
    (f : ConvexBody E → Y) (hf : Continuous f)
    (htrans : ∀ v K, f (translateBody v K) = f K) :
    closure (Set.range f) = Set.range f ∪ escapingLimits f := by
  classical
  apply Set.Subset.antisymm
  · intro y hy
    obtain ⟨u, hu, huy⟩ := mem_closure_iff_seq_limit.mp hy
    choose K hK using hu
    have hconv : Tendsto (fun n => f (K n)) atTop (𝓝 y) := by
      simpa only [hK] using huy
    rcases realized_or_diameter_tendsto_atTop f hf htrans K hconv with hreal | hescape
    · exact Or.inl hreal
    · exact Or.inr ⟨K, hconv, hescape⟩
  · exact Set.union_subset subset_closure (escapingLimits_subset_closure_range f)

end CompactnessAlternative

abbrev CoordinateSpace (d : ℕ) := EuclideanSpace ℝ (Fin d)
abbrev AreaArray (d : ℕ) := Matrix (Fin d) (Fin d) ℝ
abbrev CoordinateBody (d : ℕ) := ConvexBody (CoordinateSpace d)
abbrev Plane := Fin 2 → ℝ

def coordinateProjection {d : ℕ} (i j : Fin d) : CoordinateSpace d →L[ℝ] Plane :=
  { toLinearMap :=
      { toFun := fun x k => if k = 0 then x i else x j
        map_add' := by
          intro x y
          ext k
          by_cases hk : k = 0 <;> simp [hk, Pi.add_apply, PiLp.add_apply]
        map_smul' := by
          intro r x
          ext k
          by_cases hk : k = 0 <;> simp [hk, Pi.smul_apply, PiLp.smul_apply] }
    cont := by
      apply continuous_pi
      intro k
      split <;> fun_prop }

def coordinateAreas {d : ℕ} (K : CoordinateBody d) : AreaArray d :=
  fun i j => (volume : Measure Plane).real
    (coordinateProjection i j '' (K : Set (CoordinateSpace d)))

theorem continuous_coordinateAreas (d : ℕ) :
    Continuous (coordinateAreas (d := d)) := by
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  exact (VolumePolynomials.continuous_convexBody_realMeasure
    (volume : Measure Plane)).comp (continuous_linearImageBody (coordinateProjection i j))

theorem coordinateAreas_translate {d : ℕ} (v : CoordinateSpace d) (K : CoordinateBody d) :
    coordinateAreas (translateBody v K) = coordinateAreas K := by
  ext i j
  unfold coordinateAreas
  rw [coe_translateBody, Set.image_image]
  have heq : (fun x => coordinateProjection i j (v + x)) '' (K : Set (CoordinateSpace d)) =
      (fun z => coordinateProjection i j v + z) ''
        (coordinateProjection i j '' (K : Set (CoordinateSpace d))) := by
    rw [Set.image_image]
    congr 1
    funext x
    exact map_add (coordinateProjection i j) v x
  rw [heq, measureReal_def, measureReal_def]
  congr 1
  let a := coordinateProjection i j v
  have himage (S : Set Plane) :
      (fun z => a + z) '' S = (fun z => -a + z) ⁻¹' S := by
    ext z
    constructor
    · rintro ⟨x, hx, rfl⟩
      simpa using hx
    · intro hz
      exact ⟨-a + z, hz, by simp⟩
  rw [himage, measure_preimage_add]

def realizationLocus (d : ℕ) : Set (AreaArray d) := Set.range (coordinateAreas (d := d))

def divergingDiameterLimits (d : ℕ) : Set (AreaArray d) :=
  escapingLimits (coordinateAreas (d := d))

/-- The compactness part of Theorem 3.3, with actual Lebesgue areas and
ordinary Euclidean diameter. Identification of the escape set with weighted
triangle inequalities is a separate geometric statement. -/
theorem closure_realizationLocus (d : ℕ) :
    closure (realizationLocus d) = realizationLocus d ∪ divergingDiameterLimits d := by
  letI : FirstCountableTopology (AreaArray d) :=
    inferInstanceAs (FirstCountableTopology (Fin d → Fin d → ℝ))
  exact closure_range_eq_range_union_escapingLimits coordinateAreas
    (continuous_coordinateAreas d) coordinateAreas_translate

end ProjectionAreaTopology

end
end ProjectionAreaTopologySource


/-! ## FiberArea -/

section FiberAreaSource
/-!
# A planar area seminorm from parallel fibers

Fix a longitudinal linear functional `t` and a compact convex set `C`.
The ordinary area of the image `(f x, t x)` is subadditive and absolutely
homogeneous in the transverse functional `f`.  The proof uses actual interval
fibers and Tonelli, and permits empty or lower-dimensional `C`.

This supplies the analytic inequality in the escaping-body argument without
introducing an abstract seminorm as an unproved geometric hypothesis.
-/

noncomputable section
open Set MeasureTheory
open scoped Pointwise ENNReal

namespace ProjectionAreaFiber

abbrev Plane := ℝ × ℝ

theorem volume_add_real_intervals {A B : Set ℝ}
    (hA : IsCompact A) (hAc : Convex ℝ A) (hAn : A.Nonempty)
    (hB : IsCompact B) (hBc : Convex ℝ B) (hBn : B.Nonempty) :
    volume (A + B) = volume A + volume B := by
  have hAI : A = Icc (sInf A) (sSup A) :=
    eq_Icc_of_connected_compact ⟨hAn, Real.convex_iff_isPreconnected.mp hAc⟩ hA
  have hBI : B = Icc (sInf B) (sSup B) :=
    eq_Icc_of_connected_compact ⟨hBn, Real.convex_iff_isPreconnected.mp hBc⟩ hB
  have hAle : sInf A ≤ sSup A := csInf_le_csSup hAn hA.bddBelow hA.bddAbove
  have hBle : sInf B ≤ sSup B := csInf_le_csSup hBn hB.bddBelow hB.bddAbove
  rw [hAI, hBI, Icc_add_Icc hAle hBle, Real.volume_Icc, Real.volume_Icc,
    Real.volume_Icc]
  rw [show sSup A + sSup B - (sInf A + sInf B) =
      (sSup A - sInf A) + (sSup B - sInf B) by ring,
    ENNReal.ofReal_add (sub_nonneg.mpr hAle) (sub_nonneg.mpr hBle)]

section LinearImages

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E]

def planeImage (C : Set E) (f t : E →ₗ[ℝ] ℝ) : Set Plane :=
  (fun x => (f x, t x)) '' C

def slice (C : Set E) (t : E →ₗ[ℝ] ℝ) (y : ℝ) : Set E :=
  C ∩ t ⁻¹' {y}

theorem planeImage_compact {C : Set E} (hC : IsCompact C) (f t : E →ₗ[ℝ] ℝ) :
    IsCompact (planeImage C f t) :=
  hC.image (f.continuous_of_finiteDimensional.prodMk t.continuous_of_finiteDimensional)

theorem planeImage_convex {C : Set E} (hC : Convex ℝ C) (f t : E →ₗ[ℝ] ℝ) :
    Convex ℝ (planeImage C f t) := hC.linear_image (f.prod t)

theorem slice_compact {C : Set E} (hC : IsCompact C) (t : E →ₗ[ℝ] ℝ) (y : ℝ) :
    IsCompact (slice C t y) :=
  hC.inter_right (isClosed_singleton.preimage t.continuous_of_finiteDimensional)

theorem slice_convex {C : Set E} (hC : Convex ℝ C) (t : E →ₗ[ℝ] ℝ) (y : ℝ) :
    Convex ℝ (slice C t y) := hC.inter ((convex_singleton y).linear_preimage t)

theorem fiber_planeImage (C : Set E) (f t : E →ₗ[ℝ] ℝ) (y : ℝ) :
    VolumePolynomials.PlanarExtrusion.fiber (planeImage C f t) y = f '' slice C t y := by
  ext z
  constructor
  · rintro ⟨x, hx, hxy⟩
    exact ⟨x, ⟨hx, congrArg Prod.snd hxy⟩, congrArg Prod.fst hxy⟩
  · rintro ⟨x, ⟨hx, htx⟩, hfx⟩
    exact ⟨x, hx, Prod.ext hfx htx⟩

theorem sum_image_subset (A : Set E) (f g : E →ₗ[ℝ] ℝ) :
    (f + g) '' A ⊆ f '' A + g '' A := by
  rintro z ⟨x, hx, rfl⟩
  exact ⟨f x, ⟨x, hx, rfl⟩, g x, ⟨x, hx, rfl⟩, rfl⟩

theorem fiber_volume_add_le {C : Set E} (hC : IsCompact C) (hc : Convex ℝ C)
    (f g t : E →ₗ[ℝ] ℝ) (y : ℝ) :
    volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C (f + g) t) y) ≤
      volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C f t) y) +
      volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C g t) y) := by
  rw [fiber_planeImage, fiber_planeImage, fiber_planeImage]
  by_cases hn : (slice C t y).Nonempty
  · have hsum := volume_add_real_intervals
      ((slice_compact hC t y).image f.continuous_of_finiteDimensional)
      ((slice_convex hc t y).linear_image f) (hn.image f)
      ((slice_compact hC t y).image g.continuous_of_finiteDimensional)
      ((slice_convex hc t y).linear_image g) (hn.image g)
    exact (measure_mono (sum_image_subset _ f g)).trans_eq hsum
  · have he : slice C t y = ∅ := Set.not_nonempty_iff_eq_empty.mp hn
    simp [he]

theorem planeImage_volume_add_le {C : Set E} (hC : IsCompact C) (hc : Convex ℝ C)
    (f g t : E →ₗ[ℝ] ℝ) :
    volume (planeImage C (f + g) t) ≤ volume (planeImage C f t) + volume (planeImage C g t) := by
  have hf := planeImage_compact hC f t
  have hg := planeImage_compact hC g t
  calc
    volume (planeImage C (f + g) t) =
        ∫⁻ y, volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C (f + g) t) y) :=
      Measure.prod_apply_symm (planeImage_compact hC (f + g) t).measurableSet
    _ ≤ ∫⁻ y, volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C f t) y) +
        volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C g t) y) :=
      lintegral_mono (fiber_volume_add_le hC hc f g t)
    _ = (∫⁻ y, volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C f t) y)) +
        ∫⁻ y, volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C g t) y) :=
      lintegral_add_left (measurable_measure_prodMk_right hf.measurableSet) _
    _ = volume (planeImage C f t) + volume (planeImage C g t) := by
      exact congrArg₂ (fun a b : ℝ≥0∞ => a + b)
        (Measure.prod_apply_symm (μ := (volume : Measure ℝ))
          (ν := (volume : Measure ℝ)) hf.measurableSet).symm
        (Measure.prod_apply_symm (μ := (volume : Measure ℝ))
          (ν := (volume : Measure ℝ)) hg.measurableSet).symm

def fiberArea (C : Set E) (t f : E →ₗ[ℝ] ℝ) : ℝ :=
  volume.real (planeImage C f t)

theorem fiberArea_nonneg (C : Set E) (t f : E →ₗ[ℝ] ℝ) : 0 ≤ fiberArea C t f :=
  ENNReal.toReal_nonneg

theorem fiberArea_add_le {C : Set E} (hC : IsCompact C) (hc : Convex ℝ C)
    (f g t : E →ₗ[ℝ] ℝ) : fiberArea C t (f + g) ≤ fiberArea C t f + fiberArea C t g := by
  have hf := (planeImage_compact hC f t).measure_ne_top (μ := (volume : Measure Plane))
  have hg := (planeImage_compact hC g t).measure_ne_top (μ := (volume : Measure Plane))
  have h := ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨hf, hg⟩)
    (planeImage_volume_add_le hC hc f g t)
  simpa only [fiberArea, measureReal_def, ENNReal.toReal_add hf hg] using h

def firstScale (r : ℝ) : Plane →ₗ[ℝ] Plane where
  toFun p := (r * p.1, p.2)
  map_add' := by intros; ext <;> simp [mul_add]
  map_smul' := by intros; ext <;> simp [mul_assoc, mul_comm, mul_left_comm]

theorem firstScale_det (r : ℝ) : LinearMap.det (firstScale r) = r := by
  rw [← LinearMap.det_toMatrix (Module.Basis.finTwoProd ℝ), Matrix.det_fin_two]
  simp [LinearMap.toMatrix_apply, Module.Basis.coe_finTwoProd_repr, firstScale]

theorem planeImage_smul (C : Set E) (t f : E →ₗ[ℝ] ℝ) (r : ℝ) :
    planeImage C (r • f) t = firstScale r '' planeImage C f t := by
  rw [planeImage, planeImage, Set.image_image]
  congr 1

theorem fiberArea_smul (C : Set E) (t f : E →ₗ[ℝ] ℝ) (r : ℝ) :
    fiberArea C t (r • f) = |r| * fiberArea C t f := by
  letI : Measure.IsAddHaarMeasure (volume : Measure Plane) := by
    rw [Measure.volume_eq_prod]
    infer_instance
  unfold fiberArea
  rw [planeImage_smul]
  simp only [measureReal_def]
  rw [Measure.addHaar_image_linearMap volume (firstScale r), ENNReal.toReal_mul,
    firstScale_det, ENNReal.toReal_ofReal (abs_nonneg _)]

theorem fiberArea_zero (C : Set E) (t : E →ₗ[ℝ] ℝ) : fiberArea C t 0 = 0 := by
  simpa only [zero_smul, abs_zero, zero_mul] using
    fiberArea_smul C t (0 : E →ₗ[ℝ] ℝ) 0

theorem fiberArea_neg (C : Set E) (t f : E →ₗ[ℝ] ℝ) :
    fiberArea C t (-f) = fiberArea C t f := by
  have hneg : (-1 : ℝ) • f = -f := by
    ext x
    change (-1 : ℝ) * f x = -(f x)
    ring
  calc
    fiberArea C t (-f) = fiberArea C t ((-1 : ℝ) • f) :=
      congrArg (fiberArea C t) hneg.symm
    _ = |(-1 : ℝ)| * fiberArea C t f := fiberArea_smul C t f (-1)
    _ = fiberArea C t f := by norm_num

theorem fiberArea_sub_le {C : Set E} (hC : IsCompact C) (hc : Convex ℝ C)
    (f g t : E →ₗ[ℝ] ℝ) : fiberArea C t (f - g) ≤ fiberArea C t f + fiberArea C t g := by
  simpa only [sub_eq_add_neg, fiberArea_neg] using fiberArea_add_le hC hc f (-g) t

/-- A constant change in the transverse coordinate translates the planar
image, including when the equality only holds on the original body. -/
theorem fiberArea_eq_of_eqOn_add_const (C : Set E) (t f g : E →ₗ[ℝ] ℝ)
    (c : ℝ) (h : ∀ x ∈ C, f x = g x + c) :
    fiberArea C t f = fiberArea C t g := by
  have himage : planeImage C f t =
      (fun p : Plane => (c, 0) + p) '' planeImage C g t := by
    rw [planeImage, planeImage, Set.image_image]
    apply Set.image_congr
    intro x hx
    exact Prod.ext (by simpa [add_comm] using h x hx) (by simp)
  unfold fiberArea
  rw [himage, image_add_left, measureReal_def, measureReal_def, measure_preimage_add]

theorem fiberArea_eq_of_eqOn (C : Set E) (t f g : E →ₗ[ℝ] ℝ)
    (h : ∀ x ∈ C, f x = g x) : fiberArea C t f = fiberArea C t g :=
  fiberArea_eq_of_eqOn_add_const C t f g 0 (by simpa using h)

/-- The longitudinal functional itself has zero transverse area. This is
proved from its singleton fibers, without a dimensional assumption on `C`. -/
theorem fiberArea_self {C : Set E} (hC : IsCompact C) (t : E →ₗ[ℝ] ℝ) :
    fiberArea C t t = 0 := by
  have hf (y : ℝ) :
      volume (VolumePolynomials.PlanarExtrusion.fiber (planeImage C t t) y) = 0 := by
    apply measure_mono_null (t := ({y} : Set ℝ))
    · rw [fiber_planeImage]
      rintro z ⟨x, ⟨_, hx⟩, rfl⟩
      exact hx
    · simp
  unfold fiberArea
  rw [measureReal_def, Measure.volume_eq_prod,
    Measure.prod_apply_symm (planeImage_compact hC t t).measurableSet]
  change (∫⁻ y, volume (VolumePolynomials.PlanarExtrusion.fiber
    (planeImage C t t) y)).toReal = 0
  simp [hf]

/-- Affine linear relations among coordinate functionals therefore imply
the planar area inequalities used in the dimension argument. -/
theorem fiberArea_relation_bound {C : Set E} (hC : IsCompact C) (hc : Convex ℝ C)
    (t f g h : E →ₗ[ℝ] ℝ) (a b c d e : ℝ)
    (hrel : ∀ x ∈ C, a * t x + b * f x + c * g x + d * h x = e) :
    |b| * fiberArea C t f ≤ |c| * fiberArea C t g + |d| * fiberArea C t h := by
  have heq : fiberArea C t (b • f) =
      fiberArea C t (-(a • t + (c • g + d • h))) := by
    apply fiberArea_eq_of_eqOn_add_const C t _ _ e
    intro x hx
    simp only [LinearMap.smul_apply, LinearMap.neg_apply, LinearMap.add_apply,
      smul_eq_mul]
    linarith [hrel x hx]
  have ht : fiberArea C t (a • t) = 0 := by
    rw [fiberArea_smul, fiberArea_self hC, mul_zero]
  rw [← fiberArea_smul, heq, fiberArea_neg]
  calc
    fiberArea C t (a • t + (c • g + d • h)) ≤
        fiberArea C t (a • t) + fiberArea C t (c • g + d • h) :=
      fiberArea_add_le hC hc _ _ t
    _ = fiberArea C t (c • g + d • h) := by rw [ht, zero_add]
    _ ≤ fiberArea C t (c • g) + fiberArea C t (d • h) :=
      fiberArea_add_le hC hc _ _ t
    _ = _ := by rw [fiberArea_smul, fiberArea_smul]

/-- The exact weighted inequalities for all transverse wedge functionals.
This is the algebraic consequence used after the compact rescaling limit. -/
theorem fiberArea_weighted_triangle {ι : Type*} {C : Set E}
    (hC : IsCompact C) (hc : Convex ℝ C) (t : E →ₗ[ℝ] ℝ)
    (coordinate : ι → E →ₗ[ℝ] ℝ) (v : ι → ℝ) (i j k : ι) :
    |v k| * fiberArea C t (v i • coordinate j - v j • coordinate i) ≤
      |v j| * fiberArea C t (v i • coordinate k - v k • coordinate i) +
      |v i| * fiberArea C t (v j • coordinate k - v k • coordinate j) := by
  have hlinear : v k • (v i • coordinate j - v j • coordinate i) =
      v j • (v i • coordinate k - v k • coordinate i) -
      v i • (v j • coordinate k - v k • coordinate j) := by
    ext x
    simp only [LinearMap.smul_apply, LinearMap.sub_apply, smul_eq_mul]
    ring
  rw [← fiberArea_smul, hlinear]
  exact (fiberArea_sub_le hC hc _ _ t).trans_eq (by rw [fiberArea_smul, fiberArea_smul])

end LinearImages
end ProjectionAreaFiber

