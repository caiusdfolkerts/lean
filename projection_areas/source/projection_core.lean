section Source_BoundaryCuts

@[expose] public section

open Finset

/-!
The finite combinatorial part of the boundary-quartet obstruction.
There are three unordered balanced cuts of each four-label subset of five
labels. Compatibility means equality of the induced equivalence relations
on the three common labels. All finite enumeration proofs below use `decide`,
whose proof term is checked by Lean's kernel; `native_decide` is not used.
The geometric theorem producing compatible cuts is not assumed or proved
by this finite module.
-/

namespace ProjectionBoundaryCuts

def cutSide : Fin 5 → Fin 3 → Finset (Fin 5) :=
  ![![{1, 2}, {1, 3}, {1, 4}],
    ![{0, 2}, {0, 3}, {0, 4}],
    ![{0, 1}, {0, 3}, {0, 4}],
    ![{0, 1}, {0, 2}, {0, 4}],
    ![{0, 1}, {0, 2}, {0, 3}]]

def samePart (m : Fin 5) (k : Fin 3) (i j : Fin 5) : Prop :=
  i ∈ cutSide m k ↔ j ∈ cutSide m k

instance (m : Fin 5) (k : Fin 3) (i j : Fin 5) : Decidable (samePart m k i j) := by
  unfold samePart
  infer_instance

def CutsAgree (m : Fin 5) (k : Fin 3) (n : Fin 5) (l : Fin 3) : Prop :=
  ∀ i j : Fin 5, i ≠ m → i ≠ n → j ≠ m → j ≠ n →
    (samePart m k i j ↔ samePart n l i j)

instance (m : Fin 5) (k : Fin 3) (n : Fin 5) (l : Fin 3) :
    Decidable (CutsAgree m k n l) := by
  unfold CutsAgree samePart
  infer_instance

def OptionalCutsAgree (m n : Fin 5) : Option (Fin 3) → Option (Fin 3) → Prop
  | some k, some l => CutsAgree m k n l
  | _, _ => True

instance (m n : Fin 5) (a b : Option (Fin 3)) : Decidable (OptionalCutsAgree m n a b) := by
  cases a <;> cases b <;> unfold OptionalCutsAgree <;> infer_instance

def CompatibleChoices (choice : Fin 5 → Option (Fin 3)) : Prop :=
  ∀ m n : Fin 5, m ≠ n → OptionalCutsAgree m n (choice m) (choice n)

instance (choice : Fin 5 → Option (Fin 3)) : Decidable (CompatibleChoices choice) := by
  unfold CompatibleChoices
  infer_instance

def activeCount (choice : Fin 5 → Option (Fin 3)) : ℕ :=
  (Finset.univ.filter fun m ↦ (choice m).isSome).card

theorem cutSide_balanced : ∀ m : Fin 5, ∀ k : Fin 3,
    (cutSide m k).card = 2 ∧ m ∉ cutSide m k := by decide

/-- The three-label block of a global `2 + 3` partition. Every active
quartet omits a member of this block and induces the same partition on
its four retained labels. -/
def ExtendsChoices (choice : Fin 5 → Option (Fin 3)) (larger : Finset (Fin 5)) : Prop :=
  larger.card = 3 ∧ ∀ m : Fin 5, ∀ k : Fin 3, choice m = some k →
    m ∈ larger ∧ ∀ i j : Fin 5, i ≠ m → j ≠ m →
      (samePart m k i j ↔ (i ∈ larger ↔ j ∈ larger))

instance (choice : Fin 5 → Option (Fin 3)) (larger : Finset (Fin 5)) :
    Decidable (ExtendsChoices choice larger) := by
  unfold ExtendsChoices
  infer_instance

namespace Local

/-- Add the omitted label to the block of the first quartet containing
the second omitted label. This is the forced three-element global block. -/
def pairBlock (m : Fin 5) (k : Fin 3) (n : Fin 5) : Finset (Fin 5) :=
  if n ∈ cutSide m k then insert m (cutSide m k) else Finset.univ \ cutSide m k

def ExtendsCut (m : Fin 5) (k : Fin 3) (larger : Finset (Fin 5)) : Prop :=
  larger.card = 3 ∧ m ∈ larger ∧ ∀ i j : Fin 5, i ≠ m → j ≠ m →
    (samePart m k i j ↔ (i ∈ larger ↔ j ∈ larger))

instance (m : Fin 5) (k : Fin 3) (larger : Finset (Fin 5)) :
    Decidable (ExtendsCut m k larger) := by
  unfold ExtendsCut
  infer_instance

theorem mem_pairBlock (m : Fin 5) (k : Fin 3) (n i : Fin 5) :
    i ∈ pairBlock m k n ↔ i = m ∨ samePart m k i n := by
  by_cases hn : n ∈ cutSide m k
  · simp [pairBlock, hn, samePart]
  · by_cases hi : i = m
    · subst i
      simp [pairBlock, hn, samePart, (cutSide_balanced m k).2]
    · simp [pairBlock, hn, samePart, hi]

/-- A second omitted label in a global three-block determines that block
uniquely. This is a symbolic proof for an arbitrary finite set. -/
theorem extension_unique (m n : Fin 5) (k : Fin 3) (larger : Finset (Fin 5))
    (hmn : m ≠ n) (hL : ExtendsCut m k larger) (hn : n ∈ larger) :
    larger = pairBlock m k n := by
  ext i
  by_cases him : i = m
  · subst i
    exact iff_of_true hL.2.1 ((mem_pairBlock m k n m).mpr (Or.inl rfl))
  · have hpart := hL.2.2 i n him hmn.symm
    have hp : samePart m k i n ↔ i ∈ larger := by
      simpa only [hn, iff_true] using hpart
    simpa only [mem_pairBlock, him, false_or] using hp.symm

set_option maxRecDepth 100000 in
set_option maxHeartbeats 10000000 in
/-- There are only 225 input quadruples before the distinctness condition.
For every compatible pair the explicit block extends both quartets. -/
theorem compatible_pair_extends :
    ∀ m n : Fin 5, ∀ k l : Fin 3, m ≠ n → CutsAgree m k n l →
      ExtendsCut m k (pairBlock m k n) ∧ ExtendsCut n l (pairBlock m k n) := by
  decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
/-- The only further local certificate: a third quartet agreeing with
both members of a compatible pair extends their same global block. -/
theorem compatible_triple_extends :
    ∀ m n r : Fin 5, ∀ k l t : Fin 3,
      m ≠ n → m ≠ r → n ≠ r →
      CutsAgree m k n l → CutsAgree m k r t → CutsAgree n l r t →
      ExtendsCut r t (pairBlock m k n) := by
  decide

theorem two_active_labels (choice : Fin 5 → Option (Fin 3))
    (hcount : 2 ≤ activeCount choice) :
    ∃ m n : Fin 5, ∃ k l : Fin 3,
      m ≠ n ∧ choice m = some k ∧ choice n = some l := by
  have hcard : 1 < (Finset.univ.filter fun m => (choice m).isSome).card := by
    change 2 ≤ (Finset.univ.filter fun m => (choice m).isSome).card at hcount
    exact lt_of_lt_of_le (by decide : 1 < 2) hcount
  obtain ⟨m, hm, n, hn, hmn⟩ := Finset.one_lt_card.mp hcard
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.mp (Finset.mem_filter.mp hm).2
  obtain ⟨l, hl⟩ := Option.isSome_iff_exists.mp (Finset.mem_filter.mp hn).2
  exact ⟨m, n, k, l, hmn, hk, hl⟩

/-- A compatible active pair extends every cut in the full collection.
The proof treats the two chosen labels directly and applies the local
triple certificate to each remaining active label. -/
theorem pairBlock_extends_choices (choice : Fin 5 → Option (Fin 3))
    (hchoice : CompatibleChoices choice) (m n : Fin 5) (k l : Fin 3)
    (hmn : m ≠ n) (hm : choice m = some k) (hn : choice n = some l) :
    ExtendsChoices choice (pairBlock m k n) := by
  have hmnAgree : CutsAgree m k n l := by
    simpa only [hm, hn, OptionalCutsAgree] using hchoice m n hmn
  obtain ⟨hmExt, hnExt⟩ := compatible_pair_extends m n k l hmn hmnAgree
  refine ⟨hmExt.1, ?_⟩
  intro r t hrt
  by_cases hrm : r = m
  · subst r
    have htk : t = k := Option.some.inj (hrt.symm.trans hm)
    subst t
    exact hmExt.2
  by_cases hrn : r = n
  · subst r
    have htl : t = l := Option.some.inj (hrt.symm.trans hn)
    subst t
    exact hnExt.2
  have hmrAgree : CutsAgree m k r t := by
    simpa only [hm, hrt, OptionalCutsAgree] using hchoice m r (Ne.symm hrm)
  have hnrAgree : CutsAgree n l r t := by
    simpa only [hn, hrt, OptionalCutsAgree] using hchoice n r (Ne.symm hrn)
  exact (compatible_triple_extends m n r k l t hmn (Ne.symm hrm) (Ne.symm hrn)
    hmnAgree hmrAgree hnrAgree).2

/-- The full unique-extension theorem, with no enumeration over choice
functions or over possible extensions. -/
theorem compatible_choices_unique_extension_from_local
    (choice : Fin 5 → Option (Fin 3)) (hchoice : CompatibleChoices choice)
    (hcount : 2 ≤ activeCount choice) :
    ∃! larger : Finset (Fin 5), ExtendsChoices choice larger := by
  obtain ⟨m, n, k, l, hmn, hm, hn⟩ := two_active_labels choice hcount
  refine ⟨pairBlock m k n, pairBlock_extends_choices choice hchoice m n k l hmn hm hn, ?_⟩
  intro larger hL
  exact extension_unique m n k larger hmn ⟨hL.1, hL.2 m k hm⟩ (hL.2 n l hn).1

/-- The full cardinal bound follows because all active omitted labels
belong to the single three-element block forced by any active pair. -/
theorem compatible_choices_card_le_three_from_local
    (choice : Fin 5 → Option (Fin 3)) (hchoice : CompatibleChoices choice) :
    activeCount choice ≤ 3 := by
  by_cases hcount : 2 ≤ activeCount choice
  · obtain ⟨larger, hL, _⟩ :=
      compatible_choices_unique_extension_from_local choice hchoice hcount
    have hsub : (Finset.univ.filter fun m => (choice m).isSome) ⊆ larger := by
      intro m hm
      obtain ⟨k, hk⟩ := Option.isSome_iff_exists.mp (Finset.mem_filter.mp hm).2
      exact (hL.2 m k hk).1
    have hcard := Finset.card_le_card hsub
    simpa only [activeCount, hL.1] using hcard
  · exact (le_of_lt (lt_of_not_ge hcount)).trans (by decide : 2 ≤ 3)

end Local

set_option maxRecDepth 10000 in
set_option maxHeartbeats 10000000 in
theorem compatible_choices_card_le_three :
    ∀ choice : Fin 5 → Option (Fin 3), CompatibleChoices choice → activeCount choice ≤ 3 := by
  intro choice hchoice
  exact Local.compatible_choices_card_le_three_from_local choice hchoice

set_option maxRecDepth 10000 in
set_option maxHeartbeats 10000000 in
theorem every_balanced_side_is_canonical :
    ∀ m : Fin 5, ∀ side : Finset (Fin 5), side.card = 2 → m ∉ side →
      ∃ k : Fin 3, ∀ i j : Fin 5, i ≠ m → j ≠ m →
        ((i ∈ side ↔ j ∈ side) ↔ samePart m k i j) := by
  decide

theorem compatible_balanced_cuts_card_le_three
    (active : Finset (Fin 5)) (side : Fin 5 → Finset (Fin 5))
    (hsize : ∀ m ∈ active, (side m).card = 2)
    (homit : ∀ m ∈ active, m ∉ side m)
    (hagree : ∀ m ∈ active, ∀ n ∈ active, m ≠ n →
      ∀ i j : Fin 5, i ≠ m → i ≠ n → j ≠ m → j ≠ n →
        ((i ∈ side m ↔ j ∈ side m) ↔ (i ∈ side n ↔ j ∈ side n))) :
    active.card ≤ 3 := by
  classical
  have hrep : ∀ m : Fin 5, ∃ k : Fin 3, m ∈ active →
      ∀ i j : Fin 5, i ≠ m → j ≠ m →
        ((i ∈ side m ↔ j ∈ side m) ↔ samePart m k i j) := by
    intro m
    by_cases hm : m ∈ active
    · obtain ⟨k, hk⟩ := every_balanced_side_is_canonical m (side m) (hsize m hm) (homit m hm)
      exact ⟨k, fun _ ↦ hk⟩
    · exact ⟨0, fun h ↦ (hm h).elim⟩
  choose k hk using hrep
  let choice : Fin 5 → Option (Fin 3) := fun m ↦ if m ∈ active then some (k m) else none
  have hc : CompatibleChoices choice := by
    intro m n hmn
    by_cases hm : m ∈ active <;> by_cases hn : n ∈ active
    · simp only [choice, hm, hn, ite_true, OptionalCutsAgree]
      intro i j him hin hjm hjn
      exact (hk m hm i j him hjm).symm.trans
        ((hagree m hm n hn hmn i j him hin hjm hjn).trans (hk n hn i j hin hjn))
    · simp [choice, hm, hn, OptionalCutsAgree]
    · simp [choice, hm, hn, OptionalCutsAgree]
    · simp [choice, hm, hn, OptionalCutsAgree]
  have hcount := compatible_choices_card_le_three choice hc
  have hs : (Finset.univ.filter fun m ↦ (choice m).isSome) = active := by
    ext m
    simp [choice]
  simpa only [activeCount, hs] using hcount

def sharpChoices : Fin 5 → Option (Fin 3) :=
  ![some 1, none, some 2, none, some 1]

theorem sharp_choices_compatible : CompatibleChoices sharpChoices := by decide

theorem sharp_choices_count : activeCount sharpChoices = 3 := by decide

set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
/-- Two compatible boundary quartets determine a unique partition of
the five labels into blocks of sizes two and three. The quantified
condition includes every additional active quartet. -/
theorem compatible_choices_unique_extension :
    ∀ choice : Fin 5 → Option (Fin 3), CompatibleChoices choice →
      2 ≤ activeCount choice → ∃! larger : Finset (Fin 5), ExtendsChoices choice larger := by
  intro choice hchoice hcount
  exact Local.compatible_choices_unique_extension_from_local choice hchoice hcount

/-- The canonical crossing pattern for two specified, distinct omitted
labels. The equalities retain the identities of both original quartets. -/
def PairCrossConfiguration (m : Fin 5) (k : Fin 3) (n : Fin 5) (l : Fin 3)
    (e : Equiv.Perm (Fin 5)) : Prop :=
  e 4 = m ∧ e 3 = n ∧
  samePart m k (e 0) (e 1) ∧
  samePart m k (e 2) (e 3) ∧
  ¬ samePart m k (e 0) (e 2) ∧
  samePart n l (e 1) (e 2) ∧
  samePart n l (e 0) (e 4) ∧
  ¬ samePart n l (e 0) (e 1)

instance (m : Fin 5) (k : Fin 3) (n : Fin 5) (l : Fin 3)
    (e : Equiv.Perm (Fin 5)) : Decidable (PairCrossConfiguration m k n l e) := by
  unfold PairCrossConfiguration
  infer_instance

namespace Local

/-- The label in the common triple paired with the other omitted label.
The default is used only outside the hypotheses of the certificate below. -/
def sharedMate (m n : Fin 5) (k : Fin 3) : Fin 5 :=
  ((List.finRange 5).find? (fun x =>
    decide (x ≠ m ∧ x ≠ n ∧ samePart m k x n))).getD 0

/-- The explicit relabeling for an incompatible pair. The singleton of
the second induced cut comes first, and that of the first cut comes third. -/
def crossingTuple (m n : Fin 5) (k l : Fin 3) : Fin 5 → Fin 5 :=
  let a := sharedMate m n k
  let b := sharedMate n m l
  let c := ((List.finRange 5).find? (fun x =>
    decide (x ≠ m ∧ x ≠ n ∧ x ≠ a ∧ x ≠ b))).getD 0
  ![b, c, a, n, m]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
/-- A certificate over the 225 local inputs: the explicit tuple is a
bijection and has the literal crossing pattern. No permutations are searched. -/
theorem incompatible_pair_tuple_certificate :
    ∀ m n : Fin 5, ∀ k l : Fin 3, m ≠ n → ¬ CutsAgree m k n l →
      let e := crossingTuple m n k l
      Function.Bijective e ∧
        e 4 = m ∧ e 3 = n ∧
        samePart m k (e 0) (e 1) ∧
        samePart m k (e 2) (e 3) ∧
        ¬ samePart m k (e 0) (e 2) ∧
        samePart n l (e 1) (e 2) ∧
        samePart n l (e 0) (e 4) ∧
        ¬ samePart n l (e 0) (e 1) := by
  decide

end Local

theorem incompatible_pair_cross_configuration :
    ∀ m n : Fin 5, ∀ k l : Fin 3, m ≠ n → ¬ CutsAgree m k n l →
      ∃ e : Equiv.Perm (Fin 5), PairCrossConfiguration m k n l e := by
  intro m n k l hmn hbad
  obtain ⟨hbijective, hcross⟩ := Local.incompatible_pair_tuple_certificate m n k l hmn hbad
  exact ⟨Equiv.ofBijective (Local.crossingTuple m n k l) hbijective, hcross⟩

/-- A crossing pair selected from a possibly sparse collection of
boundary quartets. No cut is assigned to an inactive quartet. -/
def ActiveCrossConfiguration (choice : Fin 5 → Option (Fin 3))
    (e : Equiv.Perm (Fin 5)) : Prop :=
  ∃ k l : Fin 3, choice (e 4) = some k ∧ choice (e 3) = some l ∧
    samePart (e 4) k (e 0) (e 1) ∧
    samePart (e 4) k (e 2) (e 3) ∧
    ¬ samePart (e 4) k (e 0) (e 2) ∧
    samePart (e 3) l (e 1) (e 2) ∧
    samePart (e 3) l (e 0) (e 4) ∧
    ¬ samePart (e 3) l (e 0) (e 1)

instance (choice : Fin 5 → Option (Fin 3)) (e : Equiv.Perm (Fin 5)) :
    Decidable (ActiveCrossConfiguration choice e) := by
  unfold ActiveCrossConfiguration
  infer_instance

/-- Any particular failure of compatibility can be moved to the canonical
crossing pair, while retaining the two specified omitted labels. -/
theorem incompatible_optional_cuts_cross_configuration
    (choice : Fin 5 → Option (Fin 3)) (m n : Fin 5) (hmn : m ≠ n)
    (hbad : ¬ OptionalCutsAgree m n (choice m) (choice n)) :
    ∃ e : Equiv.Perm (Fin 5), e 4 = m ∧ e 3 = n ∧ ActiveCrossConfiguration choice e := by
  cases hm : choice m with
  | none => simp [hm, OptionalCutsAgree] at hbad
  | some k =>
    cases hn : choice n with
    | none => simp [hm, hn, OptionalCutsAgree] at hbad
    | some l =>
      have hcuts : ¬ CutsAgree m k n l := by
        simpa only [hm, hn, OptionalCutsAgree] using hbad
      obtain ⟨e, h4, h3, h01, h23, h02, h12, h04, h01'⟩ :=
        incompatible_pair_cross_configuration m n k l hmn hcuts
      refine ⟨e, h4, h3, k, l, ?_, ?_, ?_⟩
      · rw [h4]
        exact hm
      · rw [h3]
        exact hn
      · simpa only [h4, h3] using And.intro h01
          (And.intro h23 (And.intro h02 (And.intro h12 (And.intro h04 h01'))))

/-- Every incompatible sparse collection contains an active crossing
pair. This is the finite implication used by the geometric compatibility
proof, without assuming that all five quartets are boundary quartets. -/
theorem incompatible_choices_cross_configuration
    (choice : Fin 5 → Option (Fin 3)) (hbad : ¬ CompatibleChoices choice) :
    ∃ e : Equiv.Perm (Fin 5), ActiveCrossConfiguration choice e := by
  classical
  by_contra hn
  apply hbad
  intro m n hmn
  by_contra hpair
  obtain ⟨e, _, _, he⟩ := incompatible_optional_cuts_cross_configuration choice m n hmn hpair
  exact hn ⟨e, he⟩

/-- A canonical pair of incompatible quartet partitions. The first
quartet is `0123` with partition `01|23`; the second is `0124` with
partition `12|04`, after applying the displayed permutation. -/
def CrossConfiguration (side : Fin 5 → Finset (Fin 5)) (e : Equiv.Perm (Fin 5)) : Prop :=
  (e 0 ∈ side (e 4) ↔ e 1 ∈ side (e 4)) ∧
  (e 2 ∈ side (e 4) ↔ e 3 ∈ side (e 4)) ∧
  ¬ (e 0 ∈ side (e 4) ↔ e 2 ∈ side (e 4)) ∧
  (e 1 ∈ side (e 3) ↔ e 2 ∈ side (e 3)) ∧
  (e 0 ∈ side (e 3) ↔ e 4 ∈ side (e 3)) ∧
  ¬ (e 0 ∈ side (e 3) ↔ e 1 ∈ side (e 3))

instance (side : Fin 5 → Finset (Fin 5)) (e : Equiv.Perm (Fin 5)) :
    Decidable (CrossConfiguration side e) := by
  unfold CrossConfiguration
  infer_instance

theorem five_canonical_cuts_cross_configuration :
    ∀ choice : Fin 5 → Fin 3,
      ∃ e : Equiv.Perm (Fin 5), CrossConfiguration (fun m => cutSide m (choice m)) e := by
  intro choice
  let full : Fin 5 → Option (Fin 3) := fun m => some (choice m)
  have hcount : activeCount full = 5 := by simp [activeCount, full]
  have hbad : ¬ CompatibleChoices full := by
    intro hcompatible
    have hbound := compatible_choices_card_le_three full hcompatible
    exact (by decide : ¬ (5 ≤ 3)) (hcount ▸ hbound)
  obtain ⟨e, k, l, hk, hl, h01, h23, h02, h12, h04, h01'⟩ :=
    incompatible_choices_cross_configuration full hbad
  have hk' : choice (e 4) = k := Option.some.inj hk
  have hl' : choice (e 3) = l := Option.some.inj hl
  refine ⟨e, ?_⟩
  simpa only [CrossConfiguration, samePart, hk', hl'] using
    And.intro h01 (And.intro h23 (And.intro h02
      (And.intro h12 (And.intro h04 h01'))))

/-- Every five balanced cuts contain the canonical incompatible pair.
Only finite combinatorics is involved; the side sets may be arbitrary. -/
theorem five_balanced_cuts_cross_configuration
    (side : Fin 5 → Finset (Fin 5))
    (hsize : ∀ m, (side m).card = 2) (homit : ∀ m, m ∉ side m) :
    ∃ e : Equiv.Perm (Fin 5), CrossConfiguration side e := by
  classical
  have hrep : ∀ m : Fin 5, ∃ k : Fin 3, ∀ i j : Fin 5, i ≠ m → j ≠ m →
      ((i ∈ side m ↔ j ∈ side m) ↔ samePart m k i j) := by
    intro m
    exact every_balanced_side_is_canonical m (side m) (hsize m) (homit m)
  choose choice hchoice using hrep
  obtain ⟨e, he⟩ := five_canonical_cuts_cross_configuration choice
  have hdistinct (i j : Fin 5) (hij : i ≠ j) : e i ≠ e j := fun h => hij (e.injective h)
  rcases he with ⟨h01, h23, h02, h12, h04, h01'⟩
  refine ⟨e, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hchoice (e 4) (e 0) (e 1)
      (hdistinct 0 4 (by decide)) (hdistinct 1 4 (by decide))).mpr h01
  · exact (hchoice (e 4) (e 2) (e 3)
      (hdistinct 2 4 (by decide)) (hdistinct 3 4 (by decide))).mpr h23
  · intro h
    exact h02 ((hchoice (e 4) (e 0) (e 2)
      (hdistinct 0 4 (by decide)) (hdistinct 2 4 (by decide))).mp h)
  · exact (hchoice (e 3) (e 1) (e 2)
      (hdistinct 1 3 (by decide)) (hdistinct 2 3 (by decide))).mpr h12
  · exact (hchoice (e 3) (e 0) (e 4)
      (hdistinct 0 3 (by decide)) (hdistinct 4 3 (by decide))).mpr h04
  · intro h
    exact h01' ((hchoice (e 3) (e 0) (e 1)
      (hdistinct 0 3 (by decide)) (hdistinct 1 3 (by decide))).mp h)

end ProjectionBoundaryCuts

