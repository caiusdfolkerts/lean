    let kind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | .opaqueInfo _ => "opaque"
      | .axiomInfo _ => "axiom"
      | .inductInfo _ => "inductive"
      | .ctorInfo _ => "constructor"
      | .recInfo _ => "recursor"
      | .quotInfo _ => "quotient primitive"
    let value := info.value? (allowOpaque := true)
    if kind == "axiom" then
      failures := failures.push s!"Authored axiom declaration: {name}"
    if kind == "theorem" || kind == "definition" || kind == "opaque" then
      unless value.isSome do
        failures := failures.push s!"Authored declaration has no actual body: {name}"
    let axioms ← collectAxioms name
    for ax in axioms do
      if ax != ``propext && ax != ``Classical.choice && ax != ``Quot.sound then
        failures := failures.push s!"Unapproved transitive axiom: {name}: {ax}"
    let some index := env.getModuleIdxFor? name
      | throwError "Authored declaration has no module owner: {name}"
    let owner := env.header.moduleNames[index.toNat]!
    let mut fields := [
      ("name", toJson name.toString),
      ("module", toJson owner.toString),
      ("kind", toJson kind),
      ("actual_body_available", toJson value.isSome),
      ("universe_parameters", toJson (info.levelParams.map Name.toString)),
      ("type_dependencies", toJson (info.type.getUsedConstants.map Name.toString)),
      ("body_dependencies", toJson ((value.map Expr.getUsedConstants).getD #[] |>.map Name.toString)),
      ("transitive_axioms", toJson (axioms.map Name.toString))]
    fields := fields ++ [("is_required_endpoint",
      toJson (required.any (fun item => item.1 == name)))]
    rows := rows.push (Json.mkObj fields)
  IO.FS.createDirAll ".lake/reports"
  let reportPath := ".lake/reports/" ++ (← getEnv).mainModule.toString ++ ".json"
  let nonce := "local-source-build"
  let report := Json.mkObj [
    ("format_version", toJson (1 : Nat)),
    ("endpoint_types_rendered", toJson false),
    ("endpoint_type_sources", toJson "Exact Lean sources, ENDPOINTS.json, and immutable component audits"),
    ("verification_nonce", toJson nonce),
    ("accepted", toJson (failures.isEmpty && omissions.isEmpty)),
    ("kernel_trust_level", toJson env.header.trustLevel.toNat),
    ("kernel_type_checking_enabled", toJson (!Lean.debug.skipKernelTC.get opts)),
    ("server_mode", toJson (Lean.Elab.inServer.get opts)),
    ("declarations_read_from_checked_environment", toJson true),
    ("all_local_modules_imported_with_bodies", toJson true),
    ("project_modules", toJson (projectModules.map Name.toString)),
    ("required_endpoints", toJson (required.map fun item => Json.mkObj [
      ("name", toJson item.1.toString), ("kind", toJson item.2)])),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("declaration_count", toJson rows.size),
    ("failures", toJson failures),
    ("type_omissions", toJson omissions),
    ("declarations", toJson rows)]
  IO.FS.writeFile reportPath report.compress
  unless failures.isEmpty do
    throwError "Kernel audit rejected {failures.size} declaration/dependency problems."
  unless omissions.isEmpty do
    throwError "Endpoint types contain pretty-printer omissions: {omissions}"
  logInfo m!"TWO_ALTERNATING_FORMS_EDITABLE_AUDIT_COMPLETE:{nonce}"
