  let projectSet : NameSet := projectModules.foldl (fun s n => s.insert n) {}
  for moduleName in projectModules do
    unless env.header.moduleNames.contains moduleName do
      throwError "Expected freshly compiled module is absent: {moduleName}"
  for (name, expectedKind) in required do
    let some info := env.checked.get.find? name
      | throwError "Required endpoint is absent from the checked environment: {name}"
    let actualKind := match info with
      | .thmInfo _ => "theorem"
      | .defnInfo _ => "definition"
      | .opaqueInfo _ => "opaque"
      | .inductInfo _ => "inductive"
      | .ctorInfo _ => "constructor"
      | .recInfo _ => "recursor"
      | _ => "other"
    unless actualKind == expectedKind do
      throwError "Required endpoint {name}: expected {expectedKind}, got {actualKind}"
    if actualKind == "theorem" || actualKind == "definition" || actualKind == "opaque" then
      let some _ := info.value? (allowOpaque := true)
        | throwError "Required endpoint has no actual inspectable body: {name}"
  let nameInventoryPath := "verification/expected_declarations.json"
  let nameInventoryText ← IO.FS.readFile nameInventoryPath
  let .ok nameInventoryJson := Json.parse nameInventoryText
    | throwError "Invalid audited declaration-name inventory JSON"
  let .ok nameInventoryEntries := nameInventoryJson.getArr?
    | throwError "Audited declaration-name inventory must be an array"
  let observedNameStrings ← nameInventoryEntries.mapM fun entry => do
    let .ok name := entry.getStr?
      | throwError "Audited declaration-name inventory contains a non-string"
    pure name
  let observedNameSet : Std.HashSet String := observedNameStrings.foldl (fun s n => s.insert n) {}
  let names ← env.constants.foldM (init := #[]) fun names name _ => do
    let some index := env.getModuleIdxFor? name | return names
    let owner := env.header.moduleNames[index.toNat]!
    return if projectSet.contains owner || observedNameSet.contains name.toString then names.push name else names
  let nameSet : NameSet := names.foldl (fun s n => s.insert n) {}
  let names := nameSet.toArray.qsort Name.quickLt
  let coveredNameSet : Std.HashSet String := names.foldl (fun s n => s.insert n.toString) {}
  for observed in observedNameStrings do
    unless coveredNameSet.contains observed do
      throwError "Observed component declaration is absent: {observed}"
  if names.isEmpty then
    throwError "No authored declarations were imported; an empty audit cannot pass."
