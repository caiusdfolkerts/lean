/- Original module: PaperVerification.AlternatingFormsEvenDegreeBlocks -/


/-!
# All homogeneous exterior components as singleton blocks

The block indices carry the exact equation `number of singletons + 2q = s`.
Consequently this decomposition includes all parities, zero-degree blocks,
and degrees beyond the ambient dimension without truncated-subtraction
conventions.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical

namespace PaperVerification.AlternatingForms.EvenSingletons

open scoped BigOperators

section Indices

variable {ι : Type*} [DecidableEq ι]

abbrev DegreeBlock (ι : Type*) [DecidableEq ι] (s : ℕ) :=
  {Sq : SingletonState ι × Fin (s + 1) // singletonDegree Sq.1 + 2 * Sq.2.val = s}

instance [Fintype ι] (s : ℕ) : Fintype (DegreeBlock ι s) := Fintype.ofFinite _

abbrev BlockSubsets {s : ℕ} (J : DegreeBlock ι s) :=
  FixedSubsets (Available J.val.1) J.val.2.val

def blockStateEquiv (s : ℕ) : ((J : DegreeBlock ι s) × BlockSubsets J) ≃ DegreeState ι s where
  toFun x := ⟨⟨x.1.val.1, x.2.val⟩, by
    change singletonDegree x.1.val.1 + 2 * x.2.val.card = s
    rw [x.2.property]
    exact x.1.property⟩
  invFun T :=
    ⟨⟨(T.val.1, ⟨T.val.2.card, by
        have h := T.property
        change singletonDegree T.val.1 + 2 * T.val.2.card = s at h
        omega⟩), T.property⟩, ⟨T.val.2, rfl⟩⟩
  left_inv := by
    rintro ⟨⟨⟨S, ⟨q, hq⟩⟩, hdeg⟩, ⟨P, hP⟩⟩
    dsimp only at P hP hdeg
    subst q
    rfl
  right_inv := by
    rintro ⟨⟨S, P⟩, hP⟩
    rfl

end Indices

variable {K M ι : Type*} [Field K] [AddCommGroup M] [Module K M]
  [LinearOrder ι] [Fintype ι]
local notation "E" => ExteriorAlgebra K M

def groupedDegreeBasis (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ) :
    Module.Basis ((J : DegreeBlock ι s) × BlockSubsets J) K (⋀[K]^s M) :=
  (stateDegreeBasis b s).reindex (blockStateEquiv s).symm

@[simp] theorem groupedDegreeBasis_coe (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ)
    (J : DegreeBlock ι s) (P : BlockSubsets J) :
    (groupedDegreeBasis b s ⟨J, P⟩ : E) = stateMonomial b ⟨J.val.1, P.val⟩ := by
  simp only [groupedDegreeBasis, Module.Basis.reindex_apply, Equiv.symm_symm,
    stateDegreeBasis_coe, blockStateEquiv]
  rfl

def blockIntoDegree (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ) (J : DegreeBlock ι s) :
    (BlockSubsets J → K) →ₗ[K] (⋀[K]^s M) :=
  (blockEvaluation b J.val.1 J.val.2.val).codRestrict _ (fun v => by
    have h := blockEvaluation_homogeneous b J.val.1 J.val.2.val v
    rwa [J.property] at h)

theorem blockIntoDegree_eq_sum (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ)
    (J : DegreeBlock ι s) (v : BlockSubsets J → K) :
    blockIntoDegree b s J v =
      ∑ P : BlockSubsets J, v P • groupedDegreeBasis b s ⟨J, P⟩ := by
  apply Subtype.ext
  change blockEvaluation b J.val.1 J.val.2.val v = _
  rw [blockEvaluation_apply]
  simp only [AddSubmonoidClass.coe_finsetSum, Submodule.coe_smul, groupedDegreeBasis_coe]

/-- The explicit finite product decomposition of the genuine s-th exterior power. -/
def degreeCoordinates (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ) :
    (⋀[K]^s M) ≃ₗ[K] ((J : DegreeBlock ι s) → BlockSubsets J → K) :=
  (groupedDegreeBasis b s).equivFun.trans
    (LinearEquiv.piCurry K (fun (J : DegreeBlock ι s) (_ : BlockSubsets J) => K))

theorem degreeCoordinates_symm (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ)
    (v : (J : DegreeBlock ι s) → BlockSubsets J → K) :
    (degreeCoordinates b s).symm v = ∑ J, blockIntoDegree b s J (v J) := by
  change (groupedDegreeBasis b s).equivFun.symm (fun x => v x.1 x.2) = _
  rw [Module.Basis.equivFun_symm_apply, Fintype.sum_sigma]
  apply Finset.sum_congr rfl
  intro J hJ
  exact (blockIntoDegree_eq_sum b s J (v J)).symm

theorem degreeCoordinates_symm_single (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ)
    (J : DegreeBlock ι s) (v : BlockSubsets J → K) :
    (degreeCoordinates b s).symm (Pi.single J v) = blockIntoDegree b s J v := by
  rw [degreeCoordinates_symm]
  rw [Finset.sum_eq_single J]
  · simp only [Pi.single_eq_same]
  · intro L hL hne
    simp [hne, Ne.symm hne]
  · simp

@[simp] theorem degreeCoordinates_block (b : Module.Basis (ι ⊕ ι) K M) (s : ℕ)
    (J : DegreeBlock ι s) (v : BlockSubsets J → K) :
    degreeCoordinates b s (blockIntoDegree b s J v) = Pi.single J v := by
  apply (degreeCoordinates b s).symm.injective
  rw [LinearEquiv.symm_apply_apply, degreeCoordinates_symm_single]

theorem blockEvaluation_single (b : Module.Basis (ι ⊕ ι) K M) (S : SingletonState ι)
    (q : ℕ) (P : FixedSubsets (Available S) q) :
    blockEvaluation b S q (Pi.single P 1) = stateMonomial b ⟨S, P.val⟩ := by
  rw [blockEvaluation_apply]
  simp [Pi.single_apply]

end PaperVerification.AlternatingForms.EvenSingletons
end
end
end TAF_LiteralSource_0060

section TAF_LiteralSource_0061
/- Original module: PaperVerification.AlternatingFormsBooleanRenaming -/


/-!
# Honest variable renaming for Boolean quotient pieces

Renaming transports the actual square ideal and the two linear equations,
then restricts the induced algebra equivalence to the literal homogeneous
pieces.  Parameter polynomials also pull back injectively along an inclusion
of a selected variable set into a larger set.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanQuotient

open scoped BigOperators
open MvPolynomial

variable {K ι κ : Type*} [Field K] [Fintype ι] [Fintype κ]
  [DecidableEq ι] [DecidableEq κ]

theorem rename_linearForm (e : ι ≃ κ) (b : ι → K) :
    renameEquiv K e (linearForm b) = linearForm (fun j => b (e.symm j)) := by
  simp only [linearForm, map_sum, map_smul, renameEquiv_apply, rename_X]
  apply Fintype.sum_equiv e
  intro i
  simp only [Equiv.symm_apply_apply]

theorem map_squareIdeal_rename (e : ι ≃ κ) :
    (squareIdeal (K := K) (ι := ι)).map (renameEquiv K e).toRingHom =
      squareIdeal (K := K) (ι := κ) := by
  change Ideal.map (renameEquiv K e).toRingHom (Ideal.span
    (Set.range fun i : ι => (X i : MvPolynomial ι K) ^ 2)) =
      Ideal.span (Set.range fun j : κ => (X j : MvPolynomial κ K) ^ 2)
  rw [Ideal.map_span]
  congr 1
  ext p
  constructor
  · rintro ⟨u, ⟨i, rfl⟩, rfl⟩
    exact ⟨e i, by simp [renameEquiv_apply]⟩
  · rintro ⟨j, rfl⟩
    exact ⟨(X (e.symm j) : MvPolynomial ι K) ^ 2, ⟨e.symm j, rfl⟩,
      by simp [renameEquiv_apply]⟩

theorem map_quotientIdeal_rename (e : ι ≃ κ) (b c : ι → K) :
    (quotientIdeal b c).map (renameEquiv K e).toRingHom =
      quotientIdeal (fun j => b (e.symm j)) (fun j => c (e.symm j)) := by
  rw [quotientIdeal, Ideal.map_sup, map_squareIdeal_rename, Ideal.map_span]
  simp only [Set.image_insert_eq, Set.image_singleton]
  change squareIdeal ⊔ Ideal.span ({renameEquiv K e (linearForm b),
    renameEquiv K e (linearForm c)} : Set (MvPolynomial κ K)) = _
  rw [rename_linearForm, rename_linearForm]
  rfl

def quotientRenameEquiv (e : ι ≃ κ) (b c : ι → K) :
    QuotientRing b c ≃ₐ[K]
      QuotientRing (fun j => b (e.symm j)) (fun j => c (e.symm j)) :=
  Ideal.quotientEquivAlg _ _ (renameEquiv K e) (map_quotientIdeal_rename e b c).symm

@[simp] theorem quotientRenameEquiv_mk (e : ι ≃ κ) (b c : ι → K)
    (p : MvPolynomial ι K) :
    quotientRenameEquiv e b c (Ideal.Quotient.mk (quotientIdeal b c) p) =
      Ideal.Quotient.mk (quotientIdeal (fun j => b (e.symm j)) (fun j => c (e.symm j)))
        (renameEquiv K e p) := rfl

theorem map_piece_rename (e : ι ≃ κ) (b c : ι → K) (q : ℕ) :
    (piece b c q).map (quotientRenameEquiv e b c).toLinearMap =
      piece (fun j => b (e.symm j)) (fun j => c (e.symm j)) q := by
  ext z
  constructor
  · rintro ⟨x, ⟨p, hp, rfl⟩, rfl⟩
    refine ⟨renameEquiv K e p, hp.rename_isHomogeneous, ?_⟩
    exact (quotientRenameEquiv_mk e b c p).symm
  · rintro ⟨p, hp, rfl⟩
    refine ⟨Ideal.Quotient.mk (quotientIdeal b c) (renameEquiv K e.symm p),
      ⟨renameEquiv K e.symm p, hp.rename_isHomogeneous, rfl⟩, ?_⟩
    change quotientRenameEquiv e b c
      (Ideal.Quotient.mk (quotientIdeal b c) (renameEquiv K e.symm p)) =
      Ideal.Quotient.mk (quotientIdeal (fun j => b (e.symm j)) (fun j => c (e.symm j))) p
    rw [quotientRenameEquiv_mk, ← renameEquiv_symm, AlgEquiv.apply_symm_apply]

def pieceRenameEquiv (e : ι ≃ κ) (b c : ι → K) (q : ℕ) :
    piece b c q ≃ₗ[K] piece (fun j => b (e.symm j)) (fun j => c (e.symm j)) q :=
  (quotientRenameEquiv e b c).toLinearEquiv.ofSubmodules _ _ (map_piece_rename e b c q)

theorem finrank_piece_rename (e : ι ≃ κ) (b c : ι → K) (q : ℕ) :
    Module.finrank K (piece b c q) =
      Module.finrank K (piece (fun j => b (e.symm j)) (fun j => c (e.symm j)) q) :=
  (pieceRenameEquiv e b c q).finrank_eq

def pairVariableEmbedding (e : ι ↪ κ) : (Bool × ι) ↪ (Bool × κ) where
  toFun z := (z.1, e z.2)
  inj' := by
    intro x y h
    apply Prod.ext
    · exact congrArg (fun z : Bool × κ => z.1) h
    · exact e.injective (congrArg (fun z : Bool × κ => z.2) h)

theorem pairParameterRename_injective (e : ι ↪ κ) :
    Function.Injective (MvPolynomial.rename (pairVariableEmbedding e) :
      MvPolynomial (Bool × ι) K → MvPolynomial (Bool × κ) K) :=
  MvPolynomial.rename_injective _ (pairVariableEmbedding e).injective

theorem pairParameterRename_ne_zero (e : ι ↪ κ)
    {p : MvPolynomial (Bool × ι) K} (hp : p ≠ 0) :
    MvPolynomial.rename (pairVariableEmbedding e) p ≠ 0 := by
  intro hz
  apply hp
  apply pairParameterRename_injective e
  simpa only [map_zero] using hz

def pairParameterEvaluation (b c : ι → K) : MvPolynomial (Bool × ι) K →+* K :=
  MvPolynomial.eval₂Hom (RingHom.id K) (fun z => if z.1 then c z.2 else b z.2)

theorem pairParameterEvaluation_rename (e : ι ↪ κ) (b c : κ → K)
    (p : MvPolynomial (Bool × ι) K) :
    pairParameterEvaluation b c (MvPolynomial.rename (pairVariableEmbedding e) p) =
      pairParameterEvaluation (fun i => b (e i)) (fun i => c (e i)) p := by
  have he : (pairParameterEvaluation b c).comp
      (MvPolynomial.rename (pairVariableEmbedding e)).toRingHom =
        pairParameterEvaluation (fun i => b (e i)) (fun i => c (e i)) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [pairParameterEvaluation]
    · intro i
      simp [pairParameterEvaluation, pairVariableEmbedding]
  exact RingHom.congr_fun he p

end PaperVerification.AlternatingForms.BooleanQuotient
end
end
end TAF_LiteralSource_0061

section TAF_LiteralSource_0062
/- Original module: PaperVerification.AlternatingFormsEvenWalkPartition -/


/-!
# Odd edge fibers of a walk in a closed strip

The fiber at height a consists of the actual times at which the walk crosses
the edge from a to a+1. Crossings alternate up and down. A walk from zero to
the top of its strip crosses every edge an odd number of times, and its
down-steps are precisely the odd positions within these ordered fibers.

The statements use arbitrary length and width; width zero is not excluded.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms.EvenWalkPartition

open scoped BigOperators

/-- A literal unit step, retaining both orientations. -/
def UnitStep (h : ℕ → ℕ) (i : ℕ) : Prop :=
  h (i + 1) = h i + 1 ∨ h i = h (i + 1) + 1

/-- Crossing the edge with lower endpoint a. -/
def Crosses (h : ℕ → ℕ) (a i : ℕ) : Prop :=
  min (h i) (h (i + 1)) = a

instance crosses_decidable (h : ℕ → ℕ) (a i : ℕ) :
    Decidable (Crosses h a i) := inferInstanceAs (Decidable (_ = _))

/-- The actual set of crossing times before a specified time. -/
def crossingTimes (h : ℕ → ℕ) (a t : ℕ) : Finset ℕ :=
  (Finset.range t).filter (Crosses h a)

def crossingCount (h : ℕ → ℕ) (a t : ℕ) : ℕ :=
  (crossingTimes h a t).card

@[simp] theorem mem_crossingTimes (h : ℕ → ℕ) (a t i : ℕ) :
    i ∈ crossingTimes h a t ↔ i < t ∧ Crosses h a i := by
  simp [crossingTimes]

@[simp] theorem crossingCount_zero (h : ℕ → ℕ) (a : ℕ) :
    crossingCount h a 0 = 0 := by
  simp [crossingCount, crossingTimes]

theorem crossingCount_succ (h : ℕ → ℕ) (a t : ℕ) :
    crossingCount h a (t + 1) =
      crossingCount h a t + if Crosses h a t then 1 else 0 := by
  classical
  unfold crossingCount crossingTimes
  rw [Finset.range_add_one, Finset.filter_insert]
  by_cases hc : Crosses h a t
  · simp only [hc, if_true]
    rw [Finset.card_insert_of_notMem]
    simp
  · simp [hc]

/-- The parity of the number of crossings records the side of an edge. -/
theorem crossingCount_parity (h : ℕ → ℕ) (a n : ℕ) (hzero : h 0 = 0)
    (hstep : ∀ i < n, UnitStep h i) :
    crossingCount h a n % 2 = if a < h n then 1 else 0 := by
  induction n with
  | zero => simp [hzero]
  | succ n ih =>
    have hn := ih (fun i hi => hstep i (by omega))
    have hs := hstep n (by omega)
    rw [crossingCount_succ]
    rcases hs with hs | hs
    · have hmin : min (h n) (h (n + 1)) = h n := min_eq_left (by omega)
      by_cases he : h n = a
      · have hc : Crosses h a n := hmin.trans he
        have hlo : ¬ a < h n := by omega
        have hhi : a < h (n + 1) := by omega
        rw [if_pos hc, if_pos hhi]
        have hpar : crossingCount h a n % 2 = 0 := by
          simpa only [if_neg hlo] using hn
        omega
      · have hc : ¬ Crosses h a n := fun hc => he (hmin.symm.trans hc)
        rw [if_neg hc, Nat.add_zero]
        have hi : a < h (n + 1) ↔ a < h n := by omega
        simpa only [hi] using hn
    · have hmin : min (h n) (h (n + 1)) = h (n + 1) := min_eq_right (by omega)
      by_cases he : h (n + 1) = a
      · have hc : Crosses h a n := hmin.trans he
        have hlo : a < h n := by omega
        have hhi : ¬ a < h (n + 1) := by omega
        rw [if_pos hc, if_neg hhi]
        have hpar : crossingCount h a n % 2 = 1 := by
          simpa only [if_pos hlo] using hn
        omega
      · have hc : ¬ Crosses h a n := fun hc => he (hmin.symm.trans hc)
        rw [if_neg hc, Nat.add_zero]
        have hi : a < h (n + 1) ↔ a < h n := by omega
        simpa only [hi] using hn

/-- Every edge of the strip is crossed an odd number of times. -/
theorem crossingTimes_odd (h : ℕ → ℕ) (n L a : ℕ) (hzero : h 0 = 0)
    (hfinal : h n = L) (hstep : ∀ i < n, UnitStep h i) (ha : a < L) :
    Odd (crossingTimes h a n).card := by
  apply Nat.odd_iff.mpr
  simpa only [crossingCount, hfinal, ha, if_true] using
    crossingCount_parity h a n hzero hstep

/-- The actual increasing enumeration of a crossing fiber. -/
def crossingEnumeration (h : ℕ → ℕ) (a n : ℕ) :
    Fin (crossingTimes h a n).card ↪o ℕ :=
  (crossingTimes h a n).orderEmbOfFin rfl

@[simp] theorem crossingEnumeration_mem (h : ℕ → ℕ) (a n : ℕ)
    (j : Fin (crossingTimes h a n).card) :
    crossingEnumeration h a n j ∈ crossingTimes h a n :=
  Finset.orderEmbOfFin_mem _ _ _

/-- Exactly j crossings occur before the j-th crossing. -/
theorem crossingCount_at_enumeration (h : ℕ → ℕ) (a n : ℕ)
    (j : Fin (crossingTimes h a n).card) :
    crossingCount h a (crossingEnumeration h a n j) = j.val := by
  classical
  let s := crossingTimes h a n
  let e := s.orderEmbOfFin rfl
  have hej : e j < n := (mem_crossingTimes h a n (e j)).mp
    (Finset.orderEmbOfFin_mem _ _ _) |>.1
  have himage : crossingTimes h a (e j) = (Finset.Iio j).image e := by
    ext x
    constructor
    · intro hx
      obtain ⟨hxj, hxc⟩ := (mem_crossingTimes h a (e j) x).mp hx
      have hxs : x ∈ s := (mem_crossingTimes h a n x).mpr ⟨lt_trans hxj hej, hxc⟩
      obtain ⟨i, hi⟩ := (s.orderIsoOfFin rfl).surjective ⟨x, hxs⟩
      have he : e i = x := congrArg Subtype.val hi
      apply Finset.mem_image.mpr
      refine ⟨i, Finset.mem_Iio.mpr ?_, he⟩
      apply e.lt_iff_lt.mp
      simpa only [he] using hxj
    · intro hx
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      have his : e i ∈ s := Finset.orderEmbOfFin_mem _ _ _
      have hic := ((mem_crossingTimes h a n (e i)).mp his).2
      exact (mem_crossingTimes h a (e j) (e i)).mpr
        ⟨e.strictMono (Finset.mem_Iio.mp hi), hic⟩
  change (crossingTimes h a (e j)).card = j.val
  rw [himage, Finset.card_image_of_injective _ e.injective, Fin.card_Iio]

theorem downward_iff_above (h : ℕ → ℕ) (a i : ℕ)
    (hstep : UnitStep h i) (hcross : Crosses h a i) :
    h (i + 1) + 1 = h i ↔ a < h i := by
  unfold UnitStep at hstep
  unfold Crosses at hcross
  rcases hstep with hup | hdown
  · have hmin : min (h i) (h (i + 1)) = h i := min_eq_left (by omega)
    rw [hmin] at hcross
    omega
  · have hmin : min (h i) (h (i + 1)) = h (i + 1) := min_eq_right (by omega)
    rw [hmin] at hcross
    omega

/-- Odd ordinal positions in each edge fiber are precisely the down-steps. -/
theorem enumeration_downward_iff_odd (h : ℕ → ℕ) (a n : ℕ) (hzero : h 0 = 0)
    (hstep : ∀ i < n, UnitStep h i)
    (j : Fin (crossingTimes h a n).card) :
    h (crossingEnumeration h a n j + 1) + 1 =
        h (crossingEnumeration h a n j) ↔ Odd j.val := by
  let t := crossingEnumeration h a n j
  have ht : t < n ∧ Crosses h a t :=
    (mem_crossingTimes h a n t).mp (crossingEnumeration_mem h a n j)
  have hpar := crossingCount_parity h a t hzero
    (fun i hi => hstep i (lt_trans hi ht.1))
  rw [crossingCount_at_enumeration] at hpar
  have hpar' : j.val % 2 = if a < h t then 1 else 0 := hpar
  change h (t+1)+1=h t ↔ Odd j.val
  rw [downward_iff_above h a t (hstep t ht.1) ht.2, Nat.odd_iff]
  by_cases ha : a < h t
  · exact ⟨fun _ => by simpa only [ha, if_true] using hpar', fun _ => ha⟩
  · constructor
    · intro h
      exact (ha h).elim
    · intro hj
      have hz : j.val % 2 = 0 := by simpa only [ha, if_false] using hpar'
      omega

/-- The actual edge crossed by any step lies below the strip's top. -/
theorem crossed_edge_lt (h : ℕ → ℕ) (n L i : ℕ)
    (hbound : ∀ j ≤ n, h j ≤ L) (hstep : ∀ j < n, UnitStep h j) (hi : i < n) :
    min (h i) (h (i + 1)) < L := by
  have h₁ := hbound i (by omega)
  have h₂ := hbound (i + 1) (by omega)
  have hs := hstep i hi
  unfold UnitStep at hs
  rcases hs with hs | hs
  · rw [min_eq_left (by omega : h i ≤ h (i + 1))]
    omega
  · rw [min_eq_right (by omega : h (i + 1) ≤ h i)]
    omega

/-- The edge fibers partition all time positions, with their actual cardinalities. -/
theorem sum_crossingTimes_card (h : ℕ → ℕ) (n L : ℕ)
    (hbound : ∀ j ≤ n, h j ≤ L) (hstep : ∀ j < n, UnitStep h j) :
    (∑ a ∈ Finset.range L, (crossingTimes h a n).card) = n := by
  have hs := Finset.card_eq_sum_card_fiberwise
    (s := Finset.range n) (t := Finset.range L)
    (f := fun i => min (h i) (h (i + 1)))
    (fun i hi => Finset.mem_range.mpr
      (crossed_edge_lt h n L i hbound hstep (Finset.mem_range.mp hi)))
  have hset (a : ℕ) : crossingTimes h a n =
      (Finset.range n).filter (fun i => min (h i) (h (i + 1)) = a) := by
    ext i
    simp only [mem_crossingTimes, Finset.mem_filter, Finset.mem_range, Crosses]
  calc
    (∑ a ∈ Finset.range L, (crossingTimes h a n).card) =
        ∑ a ∈ Finset.range L,
          ((Finset.range n).filter (fun i => min (h i) (h (i + 1)) = a)).card := by
      apply Finset.sum_congr rfl
      intro a ha
      exact congrArg Finset.card (hset a)
    _ = n := by simpa only [Finset.card_range] using hs.symm

/-- The sum of the determinant degrees of the odd edge fibers is the number
of down-steps prescribed by the length and endpoint. -/
theorem sum_fiber_half_card (h : ℕ → ℕ) (n L q : ℕ) (hzero : h 0 = 0)
    (hfinal : h n = L) (hbound : ∀ j ≤ n, h j ≤ L)
    (hstep : ∀ i < n, UnitStep h i) (hsize : n = 2 * q + L) :
    (∑ a ∈ Finset.range L, (crossingTimes h a n).card / 2) = q := by
  have hodd (a : ℕ) (ha : a ∈ Finset.range L) :
      (crossingTimes h a n).card =
        2 * ((crossingTimes h a n).card / 2) + 1 := by
    have hm := Nat.odd_iff.mp
      (crossingTimes_odd h n L a hzero hfinal hstep (Finset.mem_range.mp ha))
    omega
  have hc := sum_crossingTimes_card h n L hbound hstep
  have hsum :
      (∑ a ∈ Finset.range L, (crossingTimes h a n).card) =
        2 * (∑ a ∈ Finset.range L, (crossingTimes h a n).card / 2) + L := by
    simp_rw [Finset.sum_congr rfl hodd]
    simp only [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
      Finset.card_range, smul_eq_mul, mul_one]
  omega

end PaperVerification.AlternatingForms.EvenWalkPartition

