  · intro s hs
    rw [h y hy s, EvenSingletons.blockWalkCount_eq_paperWalkCount k s hs]
  · intro s hs
    rw [h y hy s, EvenSingletons.blockWalkCount_eq_zero (by simpa using hs)]

