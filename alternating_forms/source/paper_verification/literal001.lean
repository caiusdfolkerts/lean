section TAF_LiteralSource_0092
/- Original module: PaperVerification.AlternatingFormsPluckerBigCell -/


/-!
# The actual affine big cell in the maximal-minor presentation

Fixing a nonzero Plücker coordinate to one gives the polynomial ring in the
nonpivot entries of the unique row-reduced matrix. Both algebra maps are
explicit: maximal minors in one direction, signed replacement minors in the
other. The inverse identity follows from the universal Cramer identities.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open scoped BigOperators
open MvPolynomial Matrix

namespace PaperVerification.AlternatingForms

variable {K : Type*} [Field K] {s n : ℕ}

abbrev PluckerChartVariable (p : PluckerIndex s n) :=
  Fin s × {j : Fin n // j ∉ Set.range p.val}

/-- The literal row-reduced matrix in a Plücker chart. -/
def pluckerChartMatrix (p : PluckerIndex s n) :
    Matrix (Fin s) (Fin n) (MvPolynomial (PluckerChartVariable p) K) :=
  Matrix.of fun i j => if j=p.val i then 1 else if h : j ∈ Set.range p.val then 0
    else X (i,⟨j,h⟩)

theorem pluckerChartMatrix_pivot (p : PluckerIndex s n) :
    Matrix.of (fun i j : Fin s => pluckerChartMatrix (K := K) p i (p.val j)) =
      (1 : Matrix (Fin s) (Fin s) (MvPolynomial (PluckerChartVariable p) K)) := by
  classical
  apply Matrix.ext
  intro i j
  by_cases hij : i = j
  · subst j
    simp [pluckerChartMatrix,Matrix.of_apply,Matrix.one_apply]
  · have hji : p.val j ≠ p.val i := fun h => hij (p.property.injective h).symm
    have hj : p.val j ∈ Set.range p.val := ⟨j,rfl⟩
    simp [pluckerChartMatrix,Matrix.of_apply,Matrix.one_apply,hij,hji,hj]

theorem pluckerChartMatrix_nonpivot (p : PluckerIndex s n)
    (i : Fin s) (j : {j : Fin n // j ∉ Set.range p.val}) :
    pluckerChartMatrix (K := K) p i j.val = X (i,j) := by
  classical
  have hne : j.val≠p.val i := fun h => j.property ⟨i,h.symm⟩
  simp only [pluckerChartMatrix, Matrix.of_apply, if_neg hne, dif_neg j.property]

def pluckerBigCellIdeal (p : PluckerIndex s n) :
    Ideal (MvPolynomial (PluckerIndex s n) K) :=
  matrixPluckerIdeal ⊔ Ideal.span {X p-1}

abbrev PluckerBigCell (p : PluckerIndex s n) :=
  MvPolynomial (PluckerIndex s n) K ⧸ pluckerBigCellIdeal p

def pluckerBigCellClass (p : PluckerIndex s n) :
    MvPolynomial (PluckerIndex s n) K →ₐ[K] PluckerBigCell (K := K) p :=
  Ideal.Quotient.mkₐ K _

theorem pluckerBigCellClass_pivot (p : PluckerIndex s n) :
    pluckerBigCellClass (K := K) p (X p)=1 := by
  have hincl : Ideal.span ({X p-1} : Set (MvPolynomial (PluckerIndex s n) K)) ≤
      pluckerBigCellIdeal (K := K) p := le_sup_right
  have h : X p-1 ∈ pluckerBigCellIdeal (K := K) p :=
    hincl (Ideal.subset_span (Set.mem_singleton _))
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem (X p) 1).mpr h

theorem pluckerBigCellClass_cramer_pivot (p : PluckerIndex s n) (i j : Fin s) :
    pluckerBigCellClass (K := K) p (cramerPluckerCoordinate p i (p.val j)) =
      (1 : Matrix (Fin s) (Fin s) (PluckerBigCell (K := K) p)) i j := by
  have h := (Ideal.Quotient.mk_eq_mk_iff_sub_mem
    (cramerPluckerCoordinate (K := K) p i (p.val j)) (if i=j then X p else 0)).mpr
      ((show matrixPluckerIdeal (K := K) ≤ pluckerBigCellIdeal p from le_sup_left)
        (cramerPlucker_pivot_relation (K := K) p i j))
  change pluckerBigCellClass p (cramerPluckerCoordinate p i (p.val j)) =
    pluckerBigCellClass p (if i=j then X p else 0) at h
  simpa only [apply_ite,map_zero,pluckerBigCellClass_pivot,Matrix.one_apply] using h

theorem pluckerBigCellClass_cramer_minor (p I : PluckerIndex s n) :
    Matrix.det (Matrix.of fun i j : Fin s =>
      pluckerBigCellClass (K := K) p (cramerPluckerCoordinate p i (I.val j))) =
      pluckerBigCellClass p (X I) := by
  have h := (Ideal.Quotient.mk_eq_mk_iff_sub_mem
    (Matrix.det (Matrix.of fun i j : Fin s => cramerPluckerCoordinate (K := K) p i (I.val j)))
    ((X p)^(s-1)*X I)).mpr
      ((show matrixPluckerIdeal (K := K) ≤ pluckerBigCellIdeal p from le_sup_left)
        (cramerPlucker_minor_relation (K := K) p I))
  change pluckerBigCellClass p _ = pluckerBigCellClass p _ at h
  rw [AlgHom.map_det,map_mul,map_pow,pluckerBigCellClass_pivot,one_pow,one_mul] at h
  have hm : (pluckerBigCellClass (K := K) p).mapMatrix
      (Matrix.of fun i j : Fin s => cramerPluckerCoordinate p i (I.val j)) =
      Matrix.of (fun i j : Fin s =>
        pluckerBigCellClass p (cramerPluckerCoordinate p i (I.val j))) := by
    apply Matrix.ext
    intro i j
    rfl
  rw [hm] at h
  exact h

theorem pluckerBigCellIdeal_le_chartKernel (p : PluckerIndex s n) :
    pluckerBigCellIdeal (K := K) p ≤
      RingHom.ker (matrixMinorEvaluation (K := K) (pluckerChartMatrix (K := K) p)).toRingHom := by
  apply sup_le
  · exact matrixPluckerIdeal_le_matrixMinorKernel _
  · apply Ideal.span_le.mpr
    intro q hq
    obtain rfl := Set.mem_singleton_iff.mp hq
    change matrixMinorEvaluation (K := K) (pluckerChartMatrix (K := K) p) (X p-1)=0
    simp only [map_sub,map_one,matrixMinorEvaluation,aeval_X,pluckerChartMatrix_pivot,
      Matrix.det_one,sub_self]

/-- The forward chart map sends each actual Plücker coordinate to its minor. -/
def pluckerBigCellToMatrix (p : PluckerIndex s n) :
    PluckerBigCell (K := K) p →ₐ[K] MvPolynomial (PluckerChartVariable p) K :=
  Ideal.Quotient.liftₐ _ (matrixMinorEvaluation (pluckerChartMatrix p))
    (fun q hq => pluckerBigCellIdeal_le_chartKernel p hq)

/-- The inverse chart map uses the actual signed replacement minors. -/
def pluckerMatrixToBigCell (p : PluckerIndex s n) :
    MvPolynomial (PluckerChartVariable p) K →ₐ[K] PluckerBigCell (K := K) p :=
  aeval fun a => pluckerBigCellClass p (cramerPluckerCoordinate p a.1 a.2.val)

theorem pluckerBigCellToMatrix_class (p : PluckerIndex s n)
    (q : MvPolynomial (PluckerIndex s n) K) :
    pluckerBigCellToMatrix p (pluckerBigCellClass p q) =
      matrixMinorEvaluation (pluckerChartMatrix p) q := rfl

theorem pluckerMatrixToBigCell_entry (p : PluckerIndex s n) (i : Fin s) (j : Fin n) :
    pluckerMatrixToBigCell (K := K) p (pluckerChartMatrix p i j) =
      pluckerBigCellClass p (cramerPluckerCoordinate p i j) := by
  classical
  by_cases hj : j∈Set.range p.val
  · obtain ⟨k,rfl⟩ := hj
    have he := congrArg
      (fun M : Matrix (Fin s) (Fin s) (MvPolynomial (PluckerChartVariable p) K) => M i k)
      (pluckerChartMatrix_pivot (K := K) p)
    change pluckerChartMatrix (K := K) p i (p.val k) =
      (1 : Matrix (Fin s) (Fin s) (MvPolynomial (PluckerChartVariable p) K)) i k at he
    rw [he,pluckerBigCellClass_cramer_pivot]
    simp only [Matrix.one_apply,apply_ite,map_one,map_zero]
    split_ifs <;> rfl
  · rw [pluckerChartMatrix_nonpivot p i ⟨j,hj⟩]
    simp only [pluckerMatrixToBigCell,aeval_X]

theorem pluckerBigCellToMatrix_leftInverse (p : PluckerIndex s n) :
    (pluckerMatrixToBigCell (K := K) p).comp (pluckerBigCellToMatrix p) =
      AlgHom.id K (PluckerBigCell (K := K) p) := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro I
  change pluckerMatrixToBigCell p
    (pluckerBigCellToMatrix p (pluckerBigCellClass p (X I))) =
      pluckerBigCellClass p (X I)
  rw [pluckerBigCellToMatrix_class,matrixMinorEvaluation,aeval_X,AlgHom.map_det]
  have he : (pluckerMatrixToBigCell p).mapMatrix
      (Matrix.of fun i j : Fin s => pluckerChartMatrix (K := K) p i (I.val j)) =
      Matrix.of (fun i j : Fin s => pluckerBigCellClass p
        (cramerPluckerCoordinate p i (I.val j))) := by
    ext i j
    exact pluckerMatrixToBigCell_entry p i (I.val j)
  rw [he]
  exact pluckerBigCellClass_cramer_minor p I

theorem pluckerBigCellToMatrix_rightInverse (p : PluckerIndex s n) :
    (pluckerBigCellToMatrix (K := K) p).comp (pluckerMatrixToBigCell p) =
      AlgHom.id K (MvPolynomial (PluckerChartVariable p) K) := by
  apply MvPolynomial.algHom_ext
  intro a
  change pluckerBigCellToMatrix p (pluckerMatrixToBigCell p (X a))=X a
  rw [pluckerMatrixToBigCell,aeval_X,pluckerBigCellToMatrix_class,
    matrixMinorEvaluation_cramer,pluckerChartMatrix_pivot,Matrix.cramer_one]
  change pluckerChartMatrix p a.1 a.2.val = X a
  exact pluckerChartMatrix_nonpivot p a.1 a.2

/-- A literal affine-coordinate-ring isomorphism for every maximal-minor big
cell, over the original field and with all sizes retained. -/
def pluckerBigCellEquiv (p : PluckerIndex s n) :
    PluckerBigCell (K := K) p ≃ₐ[K] MvPolynomial (PluckerChartVariable p) K :=
  AlgEquiv.ofAlgHom (pluckerBigCellToMatrix p) (pluckerMatrixToBigCell p)
    (pluckerBigCellToMatrix_rightInverse p) (pluckerBigCellToMatrix_leftInverse p)

theorem pluckerBigCellEquiv_coordinate (p I : PluckerIndex s n) :
    pluckerBigCellEquiv (K := K) p (pluckerBigCellClass p (X I)) =
      Matrix.det (Matrix.of fun i j : Fin s => pluckerChartMatrix p i (I.val j)) := by
  change matrixMinorEvaluation (pluckerChartMatrix p) (X I)=_
  simp only [matrixMinorEvaluation,aeval_X]

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0092

section TAF_LiteralSource_0093
/- Original module: PaperVerification.AlternatingFormsChart -/


/-!
# The linear kernel in the odd common-isotropic chart

Section 4.4 of the source paper identifies the chart map from `Hom(B,A)` to a
pair of alternating forms on `B`.  Its kernel is described by a rectangular
array, padded by zero rows, which is symmetric in two consecutive ways.  The
following theorem proves, for every size, that this kernel is zero.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

/-- The complete boundary-propagation argument for the kernel in Section 4.4.
It does not use division and is valid over every coefficient type with zero. -/
theorem chart_kernel_zero {K : Type*} [Zero K] (k : ℕ) (T : ℕ → ℕ → K)
    (hfirst : ∀ j ≤ k, T 0 j = 0)
    (hlast : ∀ j ≤ k, T (k + 1) j = 0)
    (hsymmetric : ∀ i ≤ k, ∀ j ≤ k, T i j = T j i)
    (hshifted : ∀ i ≤ k, ∀ j ≤ k, T (i + 1) j = T (j + 1) i) :
    ∀ i ≤ k + 1, ∀ j ≤ k, T i j = 0 := by
  intro i
  induction i with
  | zero =>
      intro _ j hj
      exact hfirst j hj
  | succ i ih =>
      intro hi j hj
      have hik : i ≤ k := by omega
      by_cases hjk : j < k
      · calc
          T (i + 1) j = T (j + 1) i := hshifted i hik j hj
          _ = T i (j + 1) := hsymmetric (j + 1) (by omega) i hik
          _ = 0 := ih (by omega) (j + 1) (by omega)
      · have hjeq : j = k := by omega
        subst j
        exact (hshifted i hik k le_rfl).trans (hlast i hik)

/-- Independent coordinates of an alternating form on `K^m`. -/
abbrev StrictPairs (m : ℕ) := {p : Fin m × Fin m // p.1 < p.2}

/-- Pad a `k` by `k+1` matrix by its two zero boundary rows. -/
def chartPad {K : Type*} [Zero K] {k : ℕ}
    (T : Fin k → Fin (k + 1) → K) (i j : ℕ) : K :=
  if h : 0 < i ∧ i ≤ k ∧ j ≤ k then
    T ⟨i - 1, by omega⟩ ⟨j, by omega⟩
  else 0

@[simp] theorem chartPad_first {K : Type*} [Zero K] {k : ℕ}
    (T : Fin k → Fin (k + 1) → K) (j : ℕ) : chartPad T 0 j = 0 := by
  simp [chartPad]

@[simp] theorem chartPad_last {K : Type*} [Zero K] {k : ℕ}
    (T : Fin k → Fin (k + 1) → K) (j : ℕ) : chartPad T (k + 1) j = 0 := by
  simp [chartPad]

@[simp] theorem chartPad_entry {K : Type*} [Zero K] {k : ℕ}
    (T : Fin k → Fin (k + 1) → K) (i : Fin k) (j : Fin (k + 1)) :
    chartPad T (i.val + 1) j.val = T i j := by
  have h : 0 < i.val + 1 ∧ i.val + 1 ≤ k ∧ j.val ≤ k := by
    have := i.isLt
    have := j.isLt
    omega
  simp [chartPad, h]

section LinearChart

variable {K : Type*} [Field K] {k : ℕ}

theorem chartPad_add (T U : Fin k → Fin (k + 1) → K) (i j : ℕ) :
    chartPad (T + U) i j = chartPad T i j + chartPad U i j := by
  simp only [chartPad]
  split_ifs <;> simp

theorem chartPad_smul (c : K) (T : Fin k → Fin (k + 1) → K) (i j : ℕ) :
    chartPad (c • T) i j = c • chartPad T i j := by
  simp only [chartPad]
  split_ifs <;> simp

/-- The explicit full-space chart map, in the independent upper-triangular
coordinates of its two alternating-form targets. -/
def chartMap (k : ℕ) : (Fin k → Fin (k + 1) → K) →ₗ[K]
    ((StrictPairs (k + 1) → K) × (StrictPairs (k + 1) → K)) where
  toFun T :=
    (fun p => chartPad T p.1.1.val p.1.2.val - chartPad T p.1.2.val p.1.1.val,
     fun p => chartPad T (p.1.1.val + 1) p.1.2.val -
       chartPad T (p.1.2.val + 1) p.1.1.val)
  map_add' T U := by
    apply Prod.ext <;> funext p <;> dsimp <;> rw [chartPad_add, chartPad_add] <;> abel
  map_smul' c T := by
    apply Prod.ext <;> funext p <;> dsimp <;> rw [chartPad_smul, chartPad_smul] <;>
      simp only [smul_eq_mul, mul_sub]

private theorem symmetric_of_strict_coordinates (m : ℕ) (A : Fin m → Fin m → K)
    (h : ∀ p : StrictPairs m, A p.1.1 p.1.2 - A p.1.2 p.1.1 = 0) :
    ∀ i j, A i j = A j i := by
  intro i j
  rcases lt_trichotomy i j with hij | hij | hij
  · exact sub_eq_zero.mp (h ⟨(i, j), hij⟩)
  · subst j
    rfl
  · exact (sub_eq_zero.mp (h ⟨(j, i), hij⟩)).symm

theorem chartMap_eq_zero (T : Fin k → Fin (k + 1) → K)
    (hT : chartMap k T = 0) : T = 0 := by
  have hfirst : ∀ i j : Fin (k + 1),
      chartPad T i.val j.val = chartPad T j.val i.val := by
    apply symmetric_of_strict_coordinates
    intro p
    exact congrArg (fun Z => Z.1 p) hT
  have hsecond : ∀ i j : Fin (k + 1),
      chartPad T (i.val + 1) j.val = chartPad T (j.val + 1) i.val := by
    apply symmetric_of_strict_coordinates
    intro p
    exact congrArg (fun Z => Z.2 p) hT
  have hz := chart_kernel_zero k (chartPad T)
    (fun j _ => chartPad_first T j) (fun j _ => chartPad_last T j)
    (fun i hi j hj => hfirst ⟨i, by omega⟩ ⟨j, by omega⟩)
    (fun i hi j hj => hsecond ⟨i, by omega⟩ ⟨j, by omega⟩)
  funext i j
  have h := hz (i.val + 1) (by have := i.isLt; omega) j.val
    (by have := j.isLt; omega)
  simpa only [chartPad_entry, Pi.zero_apply] using h

theorem chartMap_injective (k : ℕ) : Function.Injective (chartMap (K := K) k) := by
  intro T U hTU
  apply sub_eq_zero.mp
  apply chartMap_eq_zero
  rw [map_sub, hTU, sub_self]

theorem card_strictPairs (m : ℕ) : Fintype.card (StrictPairs m) = m.choose 2 := by
  classical
  simpa [StrictPairs, Fintype.subtype_card] using
    (Finset.card_product_filter_lt (s := (Finset.univ : Finset (Fin m))))

theorem chartMap_dimensions (k : ℕ) :
    Module.finrank K (Fin k → Fin (k + 1) → K) =
      Module.finrank K ((StrictPairs (k + 1) → K) × (StrictPairs (k + 1) → K)) := by
  classical
  rw [Module.finrank_pi_fintype, Module.finrank_prod]
  simp only [Module.finrank_pi, Fintype.card_fin, Finset.sum_const,
    Finset.card_univ, nsmul_eq_mul, card_strictPairs]
  simpa [Nat.choose_one_right, Nat.mul_comm, two_mul] using
    (Nat.add_one_mul_choose_eq k 1)

/-- The coordinate map of Section 4.4 is an isomorphism in every size, over an
arbitrary field.  In particular, the characteristic-zero statement is proved
without an assumption of full rank. -/
theorem chartMap_bijective (k : ℕ) : Function.Bijective (chartMap (K := K) k) :=
  ⟨chartMap_injective k,
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
      (chartMap_dimensions (K := K) k)).mp (chartMap_injective k)⟩

noncomputable def chartEquiv (k : ℕ) :
    (Fin k → Fin (k + 1) → K) ≃ₗ[K]
      ((StrictPairs (k + 1) → K) × (StrictPairs (k + 1) → K)) :=
  LinearEquiv.ofBijective (chartMap k) (chartMap_bijective k)

end LinearChart

end PaperVerification.AlternatingForms
end
end TAF_LiteralSource_0093

section TAF_LiteralSource_0094
/- Original module: PaperVerification.AlternatingFormsDeterminantPairExpansion -/


/-!
# Pairing determinant permutations without dividing by two

Pair a permutation with its right composition by the transposition of the
first two columns.  The representative whose first two row indices are
increasing contributes one alternating row-pair expression.  This is a
literal determinant identity over every commutative ring, including
characteristic two.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open scoped BigOperators

namespace PaperVerification.AlternatingForms

variable {R : Type*} [CommRing R] {t : ℕ}

def firstPairSwapPermutation (σ : Equiv.Perm (Fin (t+2))) :
    Equiv.Perm (Fin (t+2)) := σ * Equiv.swap 0 (Fin.succ 0)

@[simp] theorem firstPairSwapPermutation_zero (σ : Equiv.Perm (Fin (t+2))) :
    firstPairSwapPermutation σ 0 = σ (Fin.succ 0) := by
  simp only [firstPairSwapPermutation, Equiv.Perm.mul_apply, Equiv.swap_apply_left]

@[simp] theorem firstPairSwapPermutation_one (σ : Equiv.Perm (Fin (t+2))) :
    firstPairSwapPermutation σ (Fin.succ 0) = σ 0 := by
  simp only [firstPairSwapPermutation, Equiv.Perm.mul_apply, Equiv.swap_apply_right]

@[simp] theorem firstPairSwapPermutation_tail (σ : Equiv.Perm (Fin (t+2)))
    (i : Fin t) : firstPairSwapPermutation σ i.succ.succ = σ i.succ.succ := by
  have hzero : i.succ.succ ≠ (0 : Fin (t+2)) := Fin.succ_ne_zero _
  have hone : i.succ.succ ≠ (Fin.succ 0 : Fin (t+2)) := by
    intro h
    exact Fin.succ_ne_zero i (Fin.succ_injective _ h)
  simp only [firstPairSwapPermutation, Equiv.Perm.mul_apply,
    Equiv.swap_apply_of_ne_of_ne hzero hone]

@[simp] theorem firstPairSwapPermutation_twice (σ : Equiv.Perm (Fin (t+2))) :
    firstPairSwapPermutation (firstPairSwapPermutation σ)=σ := by
  apply Equiv.ext
  intro i
  simp only [firstPairSwapPermutation, Equiv.Perm.mul_apply, Equiv.swap_apply_self]

theorem firstPairSwapPermutation_sign (σ : Equiv.Perm (Fin (t+2))) :
    Equiv.Perm.sign (firstPairSwapPermutation σ) = -Equiv.Perm.sign σ := by
  have hne : (0 : Fin (t+2)) ≠ Fin.succ 0 := (Fin.succ_ne_zero 0).symm
  rw [firstPairSwapPermutation, Equiv.Perm.sign_mul, Equiv.Perm.sign_swap hne]
  simp only [mul_neg, mul_one]

/-- The exact two-column Laplace expansion with one representative from
each transposition pair. No cancellation of the scalar 2 is used. -/
theorem determinant_pair_expansion (M : Matrix (Fin (t+2)) (Fin (t+2)) R) :
    M.det =
      ∑ σ ∈ (Finset.univ.filter fun σ : Equiv.Perm (Fin (t+2)) =>
          σ 0 < σ (Fin.succ 0)),
        Equiv.Perm.sign σ •
          ((M (σ 0) 0 * M (σ (Fin.succ 0)) (Fin.succ 0) -
              M (σ 0) (Fin.succ 0) * M (σ (Fin.succ 0)) 0) *
            ∏ i : Fin t, M (σ i.succ.succ) i.succ.succ) := by
  classical
  let H : Equiv.Perm (Fin (t+2)) → Prop := fun σ => σ 0 < σ (Fin.succ 0)
  let term : Equiv.Perm (Fin (t+2)) → R :=
    fun σ => Equiv.Perm.sign σ • ∏ i, M (σ i) i
  have hreverse :
      (∑ σ ∈ Finset.univ.filter (fun σ => ¬H σ), term σ) =
        ∑ σ ∈ Finset.univ.filter H, term (firstPairSwapPermutation σ) := by
    symm
    apply Finset.sum_bij (fun σ _ => firstPairSwapPermutation σ)
    · intro σ hσ
      refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
      have hσ' := (Finset.mem_filter.mp hσ).2
      change ¬ firstPairSwapPermutation σ 0 <
        firstPairSwapPermutation σ (Fin.succ 0)
      rw [firstPairSwapPermutation_zero, firstPairSwapPermutation_one]
      exact not_lt_of_ge (le_of_lt hσ')
    · intro σ hσ τ hτ h
      have hh := congrArg firstPairSwapPermutation h
      simpa only [firstPairSwapPermutation_twice] using hh
    · intro σ hσ
      refine ⟨firstPairSwapPermutation σ, ?_, firstPairSwapPermutation_twice σ⟩
      refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
      have hσ' := (Finset.mem_filter.mp hσ).2
      have hne : σ 0 ≠ σ (Fin.succ 0) :=
        σ.injective.ne (Fin.succ_ne_zero 0).symm
      change firstPairSwapPermutation σ 0 < firstPairSwapPermutation σ (Fin.succ 0)
      rw [firstPairSwapPermutation_zero, firstPairSwapPermutation_one]
      exact lt_of_le_of_ne (le_of_not_gt hσ') hne.symm
    · intro σ hσ
      rfl
  have hterm (σ : Equiv.Perm (Fin (t+2))) :
      term σ + term (firstPairSwapPermutation σ) =
        Equiv.Perm.sign σ •
          ((M (σ 0) 0 * M (σ (Fin.succ 0)) (Fin.succ 0) -
              M (σ 0) (Fin.succ 0) * M (σ (Fin.succ 0)) 0) *
            ∏ i : Fin t, M (σ i.succ.succ) i.succ.succ) := by
    simp only [term, Fin.prod_univ_succ, firstPairSwapPermutation_zero,
      firstPairSwapPermutation_one, firstPairSwapPermutation_tail,
      firstPairSwapPermutation_sign, Units.smul_def, Units.val_neg, neg_smul]
