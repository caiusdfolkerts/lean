section TAF_LiteralSource_0057
/- Original module: PaperVerification.AlternatingFormsBooleanWeighted -/


/-!
# Weighted Boolean inclusion maps

Diagonal scaling transports the explicit central Boolean inverse to every
choice of nonzero coefficients.  These are the actual coefficient maps for
multiplication by a weighted linear form in the square-zero polynomial algebra.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms

open scoped BigOperators

variable {K ι : Type*} [Fintype ι] [DecidableEq ι]

def subsetWeight [CommRing K] (a : ι → K) (S : Finset ι) : K := ∏ i ∈ S, a i

theorem subsetWeight_ne_zero [Field K] (a : ι → K) (ha : ∀ i, a i ≠ 0) (S : Finset ι) :
    subsetWeight a S ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr (fun i hi ↦ ha i)

theorem subsetWeight_erase [Field K] (a : ι → K) (S : Finset ι) (i : S) :
    a i.val * subsetWeight a (S.erase i.val) = subsetWeight a S := by
  exact Finset.mul_prod_erase S a i.property

def weightedInclusionOperator [CommRing K] (a : ι → K) (n : ℕ) :
    (FixedSubsets ι n → K) →ₗ[K] (FixedSubsets ι (n+1) → K) where
  toFun v U := ∑ i : U.val, a i.val * v (eraseSubset U i)
  map_add' v w := by ext U; simp [mul_add, Finset.sum_add_distrib]
  map_smul' c v := by ext U; simp [Finset.mul_sum, mul_left_comm]

def subsetWeightEquiv [Field K] (a : ι → K) (ha : ∀ i, a i ≠ 0) (n : ℕ) :
    (FixedSubsets ι n → K) ≃ₗ[K] (FixedSubsets ι n → K) where
  toFun v U := subsetWeight a U.val * v U
  invFun v U := (subsetWeight a U.val)⁻¹ * v U
  left_inv v := by
    ext U
    change (subsetWeight a U.val)⁻¹ * (subsetWeight a U.val * v U) = v U
    rw [← mul_assoc, inv_mul_cancel₀ (subsetWeight_ne_zero a ha U.val), one_mul]
  right_inv v := by
    ext U
    change subsetWeight a U.val * ((subsetWeight a U.val)⁻¹ * v U) = v U
    rw [← mul_assoc, mul_inv_cancel₀ (subsetWeight_ne_zero a ha U.val), one_mul]
  map_add' v w := by ext U; exact mul_add _ _ _
  map_smul' c v := by ext U; exact mul_left_comm _ _ _

theorem weightedInclusion_conjugate [Field K] (a : ι → K) (ha : ∀ i, a i ≠ 0)
    (n : ℕ) (v : FixedSubsets ι n → K) :
    weightedInclusionOperator a n (subsetWeightEquiv a ha n v) =
      subsetWeightEquiv a ha (n+1) (inclusionOperator n v) := by
  ext U
  change (∑ i : U.val, a i.val * (subsetWeight a (U.val.erase i.val) *
    v (eraseSubset U i))) = subsetWeight a U.val *
      ∑ i : U.val, v (eraseSubset U i)
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [← mul_assoc, subsetWeight_erase]

theorem weightedInclusion_surjective [Field K] [CharZero K] (a : ι → K)
    (ha : ∀ i, a i ≠ 0) (n : ℕ) (hι : Fintype.card ι = 2*n+1) :
    Function.Surjective (weightedInclusionOperator a n) := by
  intro v
  obtain ⟨u, hu⟩ := inclusionOperator_surjective (K := K) n hι
    ((subsetWeightEquiv a ha (n+1)).symm v)
  refine ⟨subsetWeightEquiv a ha n u, ?_⟩
  rw [weightedInclusion_conjugate, hu, LinearEquiv.apply_symm_apply]

theorem weightedInclusion_injective [Field K] [CharZero K] (a : ι → K)
    (ha : ∀ i, a i ≠ 0) (n : ℕ) (hι : Fintype.card ι = 2*n+1) :
    Function.Injective (weightedInclusionOperator a n) := by
  intro u v huv
  obtain ⟨u', rfl⟩ := (subsetWeightEquiv a ha n).surjective u
  obtain ⟨v', rfl⟩ := (subsetWeightEquiv a ha n).surjective v
  rw [weightedInclusion_conjugate, weightedInclusion_conjugate] at huv
  have he := inclusionOperator_injective (K := K) n hι
    ((subsetWeightEquiv a ha (n+1)).injective huv)
  exact congrArg (subsetWeightEquiv a ha n) he

/-- The explicit weighted inverse in every commutative square-zero algebra.
The coefficient is `b_T / b_P`, which is the orientation needed for the
superincreasing-parameter argument. -/
theorem weighted_local_pair_division [Field K] [CharZero K]
    {A : Type*} [CommRing A] [Algebra K A]
    (a : ι → K) (ha : ∀ i, a i ≠ 0) (y : ι → A)
    (hy : ∀ i, y i * y i = 0) (n : ℕ)
    (hι : Fintype.card ι = 2*n+1) (P : FixedSubsets ι (n+1)) :
    (∑ i, a i • y i) *
        (∑ T : FixedSubsets ι n,
          (inverseCoefficient (K := K) n (T.val ∩ P.val).card *
            (subsetWeight a T.val / subsetWeight a P.val)) •
              ∏ i ∈ T.val, y i) = ∏ i ∈ P.val, y i := by
  have hz (i : ι) : (a i • y i) * (a i • y i) = 0 := by
    rw [smul_mul_assoc, mul_smul_comm, hy, smul_zero, smul_zero]
  have hprod (S : Finset ι) :
      (∏ i ∈ S, a i • y i) = subsetWeight a S • ∏ i ∈ S, y i :=
    Finset.prod_smul S a y
  have h := local_pair_division (K := K) (fun i ↦ a i • y i) hz n hι P
  simp_rw [hprod] at h
  have hh := congrArg (fun z : A ↦ (subsetWeight a P.val)⁻¹ • z) h
  rw [← mul_smul_comm, smul_smul,
    inv_mul_cancel₀ (subsetWeight_ne_zero a ha P.val), one_smul] at hh
  rw [← hh]
  congr 1
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro T hT
  simp only [smul_smul, div_eq_mul_inv]
  congr 1
  ring

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0057

section TAF_LiteralSource_0058
/- Original module: PaperVerification.AlternatingFormsBooleanMultiplication -/


/-!
# The actual Boolean relation matrices

For positive degree the relation maps of the ordinary square-zero quotient
are exactly the weighted subset-incidence matrices.  In degree zero the
relation space is zero.  Thus the polynomial presentation and the finite
matrices agree without a positivity restriction hidden in the definition.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanQuotient

open scoped BigOperators
open MvPolynomial BooleanCoefficients

variable {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
local notation "P" => MvPolynomial ι K

theorem subsetExponent_sub_single (S : Finset ι) (i : ι) :
    subsetExponent S - Finsupp.single i 1 = subsetExponent (S.erase i) := by
  ext j
  by_cases hji : j = i
  · subst j
    by_cases hi : i ∈ S <;> simp [subsetExponent_apply, hi]
  · simp [subsetExponent_apply, Finsupp.single_apply, hji, eq_comm]

theorem relationMap_succ (b : ι → K) (n : ℕ) (p : P) :
    relationMap b (n + 1) p = weightedInclusionOperator b n (coefficients n p) := by
  ext U
  change (linearForm b * p).coeff (subsetExponent U.val) =
    ∑ i : U.val, b i.val * p.coeff (subsetExponent (U.val.erase i.val))
  simp only [linearForm, Finset.sum_mul, smul_mul_assoc, coeff_sum, coeff_smul,
    coeff_X_mul', subsetExponent_support, subsetExponent_sub_single, smul_eq_mul,
    mul_ite, mul_zero]
  rw [Finset.sum_ite_mem_eq]
  exact (Finset.sum_coe_sort U.val (fun i => b i * p.coeff (subsetExponent (U.val.erase i)))).symm

theorem relationMap_succ_eq (b : ι → K) (n : ℕ) :
    relationMap b (n + 1) = (weightedInclusionOperator b n).comp (coefficients n) := by
  apply LinearMap.ext
  intro p
  ext U
  exact congrFun (relationMap_succ b n p) U

theorem relationMap_range_succ (b : ι → K) (n : ℕ) :
    (relationMap b (n + 1)).range = (weightedInclusionOperator b n).range := by
  ext w
  constructor
  · rintro ⟨p, rfl⟩
    exact ⟨coefficients n p, (relationMap_succ b n p).symm⟩
  · rintro ⟨v, rfl⟩
    refine ⟨evaluation n v, ?_⟩
    rw [relationMap_succ, coefficients_evaluation]

theorem relations_succ (b c : ι → K) (n : ℕ) :
    relations b c (n + 1) =
      (weightedInclusionOperator b n).range ⊔ (weightedInclusionOperator c n).range := by
  rw [relations, relationMap_range_succ, relationMap_range_succ]

theorem relationMap_zero (b : ι → K) : relationMap b 0 = 0 := by
  apply LinearMap.ext
  intro p
  ext U
  have hU : U.val = ∅ := Finset.card_eq_zero.mp U.property
  change (linearForm b * p).coeff (subsetExponent U.val) = 0
  simp only [linearForm, Finset.sum_mul, smul_mul_assoc, coeff_sum, coeff_smul,
    coeff_X_mul', subsetExponent_support, hU, Finset.notMem_empty, if_false,
    smul_zero, Finset.sum_const_zero]

theorem relations_zero (b c : ι → K) : relations b c 0 = ⊥ := by
  simp only [relations, relationMap_zero, LinearMap.range_zero, sup_idem]

/-- Degree n+1 of the original quotient, expressed using the two finite matrices. -/
def weightedCokernelEquivPiece (b c : ι → K) (n : ℕ) :
    ((FixedSubsets ι (n + 1) → K) ⧸
      ((weightedInclusionOperator b n).range ⊔ (weightedInclusionOperator c n).range)) ≃ₗ[K]
      piece b c (n + 1) :=
  (Submodule.quotEquivOfEq _ _ (relations_succ b c n).symm).trans
    (cokernelEquivPiece b c (n + 1))

section Evaluation

variable {A : Type*} [CommRing A] [Algebra K A]

theorem aeval_evaluation (y : ι → A) (q : ℕ) (v : FixedSubsets ι q → K) :
    MvPolynomial.aeval y (evaluation q v) = squarefreeEvaluation y q v := by
  change MvPolynomial.aeval y (∑ U : FixedSubsets ι q, v U • subsetMonomial U.val) = _
  rw [map_sum]
  simp only [map_smul, subsetMonomial_eq_prod, map_prod, MvPolynomial.aeval_X,
    squarefreeEvaluation, LinearMap.coe_mk, AddHom.coe_mk]

theorem aeval_squareIdeal_eq_zero (y : ι → A) (hy : ∀ i, y i * y i = 0)
    {p : P} (hp : p ∈ squareIdeal) : MvPolynomial.aeval y p = 0 := by
  have hle : squareIdeal (K := K) (ι := ι) ≤ RingHom.ker (MvPolynomial.aeval y).toRingHom := by
    apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    change MvPolynomial.aeval y ((X i : P) ^ 2) = 0
    rw [map_pow, MvPolynomial.aeval_X, pow_two]
    exact hy i
  exact hle hp

/-- The weighted incidence matrix acts by actual multiplication in every
commutative algebra of square-zero elements, including zero weights. -/
theorem squarefreeEvaluation_weighted_inclusion (y : ι → A)
    (hy : ∀ i, y i * y i = 0) (b : ι → K) (n : ℕ) (v : FixedSubsets ι n → K) :
    (∑ i, b i • y i) * squarefreeEvaluation y n v =
      squarefreeEvaluation y (n + 1) (weightedInclusionOperator b n v) := by
  have hh : (linearForm b * evaluation n v).IsHomogeneous (n + 1) := by
    simpa only [Nat.add_comm 1 n] using
      (linearForm_isHomogeneous b).mul (evaluation_isHomogeneous n v)
  have hr := homogeneous_reduction_mem (n + 1) (linearForm b * evaluation n v) hh
  have hz := aeval_squareIdeal_eq_zero y hy hr
  rw [map_sub, sub_eq_zero] at hz
  have hcoeff : coefficients (n + 1) (linearForm b * evaluation n v) =
      weightedInclusionOperator b n v := by
    change relationMap b (n + 1) (evaluation n v) = _
    rw [relationMap_succ, coefficients_evaluation]
  rw [hcoeff, aeval_evaluation, map_mul, aeval_evaluation] at hz
  have hl : MvPolynomial.aeval y (linearForm b) = ∑ i, b i • y i := by
    simp only [linearForm, map_sum, map_smul, MvPolynomial.aeval_X]
  simpa only [hl] using hz.symm

end Evaluation

end PaperVerification.AlternatingForms.BooleanQuotient
end
end
end TAF_LiteralSource_0058

section TAF_LiteralSource_0059
/- Original module: PaperVerification.AlternatingFormsEvenSingletonAction -/


/-!
# Boolean multiplication on actual exterior singleton blocks

The matching two-form acts on each fixed singleton block by the weighted
Boolean inclusion matrix.  Both the block embedding and the two-form are
literal exterior-algebra constructions, and the embedding is proved injective.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical

namespace PaperVerification.AlternatingForms.EvenSingletons

open scoped BigOperators

variable {K M ι : Type*} [Field K] [AddCommGroup M] [Module K M]
  [LinearOrder ι] [Fintype ι]
local notation "E" => ExteriorAlgebra K M

def matchingForm (b : Module.Basis (ι ⊕ ι) K M) (a : ι → K) : ⋀[K]^2 M :=
  ∑ i, a i • exteriorPair (K := K) (b (Sum.inl i)) (b (Sum.inr i))

@[simp] theorem matchingForm_coe (b : Module.Basis (ι ⊕ ι) K M) (a : ι → K) :
    (matchingForm b a : E) =
      ∑ i, a i • (exteriorPair (K := K) (b (Sum.inl i)) (b (Sum.inr i)) : E) := by
  simp only [matchingForm, AddSubmonoidClass.coe_finsetSum, Submodule.coe_smul]

def pairVariables (b : Module.Basis (ι ⊕ ι) K M) (S : SingletonState ι) :
    Available S → Subalgebra.center K E :=
  fun i => exteriorPairCentral (K := K) (b (Sum.inl i.val)) (b (Sum.inr i.val))

theorem pairedMonomial_available (b : Module.Basis (ι ⊕ ι) K M)
    (S : SingletonState ι) (P : Finset (Available S)) :
    pairedMonomial (K := K) (fun i : Available S => b (Sum.inl i.val))
      (fun i : Available S => b (Sum.inr i.val)) P =
    pairedMonomial (K := K) (fun i => b (Sum.inl i)) (fun i => b (Sum.inr i)) (pairSupport S P) := by
  simp only [pairedMonomial, pairSupport, Finset.prod_map, Function.Embedding.coe_subtype]

def blockEvaluation (b : Module.Basis (ι ⊕ ι) K M) (S : SingletonState ι) (q : ℕ) :
    (FixedSubsets (Available S) q → K) →ₗ[K] E where
  toFun v := singletonMonomial b S * (squarefreeEvaluation (pairVariables b S) q v : E)
  map_add' v w := by simp only [map_add, Subalgebra.coe_add, mul_add]
  map_smul' a v := by simp only [map_smul, Subalgebra.coe_smul, mul_smul_comm, RingHom.id_apply]

theorem blockEvaluation_apply (b : Module.Basis (ι ⊕ ι) K M) (S : SingletonState ι)
    (q : ℕ) (v : FixedSubsets (Available S) q → K) :
    blockEvaluation b S q v =
      ∑ P : FixedSubsets (Available S) q, v P • stateMonomial b ⟨S, P.val⟩ := by
  change singletonMonomial b S *
      ((∑ P : FixedSubsets (Available S) q,
        v P • ∏ i ∈ P.val, pairVariables b S i : Subalgebra.center K E) : E) = _
  simp only [AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_smul, Finset.mul_sum,
    mul_smul_comm]
  apply Finset.sum_congr rfl
  intro P hP
  congr 1
  change singletonMonomial b S * pairedMonomial
    (fun i : Available S => b (Sum.inl i.val)) (fun i : Available S => b (Sum.inr i.val)) P.val = _
  rw [pairedMonomial_available]
  rfl

theorem blockEvaluation_coordinate (b : Module.Basis (ι ⊕ ι) K M) (S : SingletonState ι)
    (q : ℕ) (v : FixedSubsets (Available S) q → K) (P : FixedSubsets (Available S) q) :
    (stateBasis b).repr (blockEvaluation b S q v) ⟨S, P.val⟩ = v P := by
  rw [blockEvaluation_apply]
  simp only [← stateBasis_apply, map_sum, map_smul, Finset.sum_apply', Finsupp.smul_apply,
    Module.Basis.repr_self, Finsupp.single_apply, smul_eq_mul]
  have hinj : Function.Injective
      (fun Q : FixedSubsets (Available S) q => (⟨S, Q.val⟩ : PairedState ι)) := by
    intro Q R hQR
    apply Subtype.ext
    exact sigma_mk_injective (β := fun T : SingletonState ι => Finset (Available T))
      (i := S) hQR
  simp only [hinj.eq_iff, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
    Finset.mem_univ, if_true]

theorem blockEvaluation_injective (b : Module.Basis (ι ⊕ ι) K M)
    (S : SingletonState ι) (q : ℕ) : Function.Injective (blockEvaluation b S q) := by
  intro v w h
  ext P
  have hc := congrArg (fun x : E => (stateBasis b).repr x ⟨S, P.val⟩) h
  simpa only [blockEvaluation_coordinate] using hc

theorem blockEvaluation_homogeneous (b : Module.Basis (ι ⊕ ι) K M)
    (S : SingletonState ι) (q : ℕ) (v : FixedSubsets (Available S) q → K) :
    blockEvaluation b S q v ∈ ⋀[K]^(singletonDegree S + 2 * q) M := by
  rw [blockEvaluation_apply]
  apply Submodule.sum_mem
  intro P hP
  apply Submodule.smul_mem
  simpa only [degree, P.property] using stateMonomial_homogeneous b ⟨S, P.val⟩

def blockEvaluationDegree (b : Module.Basis (ι ⊕ ι) K M)
    (S : SingletonState ι) (q : ℕ) :
    (FixedSubsets (Available S) q → K) →ₗ[K] (⋀[K]^(singletonDegree S + 2 * q) M) :=
  (blockEvaluation b S q).codRestrict _ (blockEvaluation_homogeneous b S q)

theorem pair_mul_singleton_eq_zero (b : Module.Basis (ι ⊕ ι) K M)
    (S : SingletonState ι) (i : ι) (hi : i ∈ S.val.1 ∪ S.val.2) :
    (exteriorPair (K := K) (b (Sum.inl i)) (b (Sum.inr i)) : E) * singletonMonomial b S = 0 := by
  rcases Finset.mem_union.mp hi with hA | hB
  · apply twoForm_mul_word_eq_zero_of_mem _ (b (Sum.inl i))
      (exteriorPair_mul_left_generator _ _)
    exact List.mem_map.mpr ⟨Sum.inl i, by simp [singletonWord, selectionWord, hA], rfl⟩
  · apply twoForm_mul_word_eq_zero_of_mem _ (b (Sum.inr i))
      (exteriorPair_mul_right_generator _ _)
    exact List.mem_map.mpr ⟨Sum.inr i, by simp [singletonWord, selectionWord, hB], rfl⟩

theorem matching_mul_singleton (b : Module.Basis (ι ⊕ ι) K M) (a : ι → K)
    (S : SingletonState ι) :
    (matchingForm b a : E) * singletonMonomial b S =
      singletonMonomial b S *
        ((∑ i : Available S, a i.val • pairVariables b S i : Subalgebra.center K E) : E) := by
  let z := singletonMonomial b S
  let y (i : ι) : E := exteriorPair (K := K) (b (Sum.inl i)) (b (Sum.inr i))
  have hrestrict : (∑ i : ι, a i • (y i * z)) =
      ∑ i : Available S, a i.val • (y i.val * z) := by
    calc
      _ = ∑ i ∈ Finset.univ.filter (fun i : ι => i ∉ S.val.1 ∪ S.val.2),
          a i • (y i * z) := by
        symm
        apply Finset.sum_subset (Finset.filter_subset _ _)
        intro i hi hn
        have hmem : i ∈ S.val.1 ∪ S.val.2 := by
          simpa only [Finset.mem_filter, Finset.mem_univ, true_and, not_not] using hn
        rw [show y i * z = 0 from pair_mul_singleton_eq_zero b S i hmem, smul_zero]
      _ = _ := Finset.sum_subtype _ (fun i => by simp) _
  rw [matchingForm_coe, Finset.sum_mul]
  simp only [smul_mul_assoc]
  change (∑ i, a i • (y i * z)) = _
  rw [hrestrict]
  simp only [AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_smul, Finset.mul_sum,
    mul_smul_comm]
  apply Finset.sum_congr rfl
  intro i hi
  congr 1
  exact (twoForm_commute (exteriorPair (K := K) (b (Sum.inl i.val)) (b (Sum.inr i.val))) z).eq

/-- On every fixed singleton block, the original matching form is exactly
the weighted incidence map.  No pair coefficient is required to be nonzero. -/
theorem matching_mul_blockEvaluation (b : Module.Basis (ι ⊕ ι) K M) (a : ι → K)
    (S : SingletonState ι) (q : ℕ) (v : FixedSubsets (Available S) q → K) :
    (matchingForm b a : E) * blockEvaluation b S q v =
      blockEvaluation b S (q + 1)
        (weightedInclusionOperator (fun i : Available S => a i.val) q v) := by
  change (matchingForm b a : E) *
      (singletonMonomial b S * (squarefreeEvaluation (pairVariables b S) q v : E)) = _
  rw [← mul_assoc, matching_mul_singleton, mul_assoc]
  have h := BooleanQuotient.squarefreeEvaluation_weighted_inclusion
    (pairVariables b S)
    (fun i => exteriorPairCentral_square_zero (b (Sum.inl i.val)) (b (Sum.inr i.val)))
    (fun i : Available S => a i.val) q v
  exact congrArg (fun x : Subalgebra.center K E => singletonMonomial b S * (x : E)) h

end PaperVerification.AlternatingForms.EvenSingletons
