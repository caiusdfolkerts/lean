section TAF_LiteralSource_0056
/- Original module: PaperVerification.AlternatingFormsBooleanQuotient -/


/-!
# The ordinary Boolean quotient and its derivative dual

The Boolean algebra in the even-pencil argument is the ordinary polynomial
quotient by the coordinate squares.  Its degree pieces are compared with the
finite square-free coefficient spaces, and adjoining two linear forms is
compared with the corresponding coefficient cokernel.  The latter comparison
is proved for every degree, including degree zero.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanQuotient

open scoped BigOperators
open MvPolynomial BooleanCoefficients EvenDeterminants

variable {K ι : Type*} [Field K] [Fintype ι] [DecidableEq ι]
local notation "P" => MvPolynomial ι K
attribute [local instance] MvPolynomial.gradedAlgebra

/-- The actual ideal generated by the squares of the polynomial variables. -/
def squareIdeal : Ideal P := coordinatePowerIdeal (fun _ : ι => 2)

/-- The two linear equations are ordinary polynomials. -/
def linearForm (b : ι → K) : P := ∑ i, b i • X i

/-- The actual quotient ideal, with no matrix presentation built into its definition. -/
def quotientIdeal (b c : ι → K) : Ideal P :=
  squareIdeal ⊔ Ideal.span ({linearForm b, linearForm c} : Set P)

abbrev QuotientRing (b c : ι → K) := P ⧸ quotientIdeal b c

/-- Extraction of the square-free coefficients of a specified degree. -/
def coefficients (q : ℕ) : P →ₗ[K] (FixedSubsets ι q → K) where
  toFun p U := p.coeff (subsetExponent U.val)
  map_add' p r := by ext U; exact MvPolynomial.coeff_add _ _ _
  map_smul' a p := by ext U; exact coeff_smul _ _ _

@[simp] theorem coefficients_evaluation (q : ℕ) (v : FixedSubsets ι q → K) :
    coefficients q (evaluation q v) = v := by
  ext U
  exact evaluation_coeff q v U

theorem evaluation_isHomogeneous (q : ℕ) (v : FixedSubsets ι q → K) :
    (evaluation q v).IsHomogeneous q := by
  apply (homogeneousSubmodule ι K q).sum_mem
  intro U hU
  apply (homogeneousSubmodule ι K q).smul_mem
  exact isHomogeneous_monomial 1 ((subsetExponent_degree U.val).trans U.property)

theorem evaluation_multiaffine (q : ℕ) (v : FixedSubsets ι q → K) (i : ι) :
    (evaluation q v).degreeOf i ≤ 1 := by
  apply degreeOf_le_iff.mpr
  intro d hd
  by_contra hn
  have hz : (evaluation q v).coeff d = 0 := by
    change (∑ U : FixedSubsets ι q, v U • subsetMonomial U.val).coeff d = 0
    rw [coeff_sum]
    apply Finset.sum_eq_zero
    intro U hU
    have hne : subsetExponent U.val ≠ d := by
      intro he
      have hh := congrArg (fun m : ι →₀ ℕ => m i) he
      have hle : subsetExponent U.val i ≤ 1 := by simp only [subsetExponent_apply]; split <;> omega
      exact hn (hh ▸ hle)
    simp only [coeff_smul, subsetMonomial, coeff_monomial, if_neg hne, smul_zero]
  exact (MvPolynomial.mem_support_iff.mp hd) hz

theorem monomial_mem_squareIdeal (d : ι →₀ ℕ) (a : K)
    (hd : ∃ i, 2 ≤ d i) : monomial d a ∈ squareIdeal (K := K) := by
  obtain ⟨i, hi⟩ := hd
  have hs : Finsupp.single i 2 ≤ d := Finsupp.single_le_iff.mpr hi
  have he : Finsupp.single i 2 + (d - Finsupp.single i 2) = d :=
    add_tsub_cancel_of_le hs
  rw [← he, monomial_single_add]
  exact (squareIdeal (K := K)).mul_mem_right _
    (coordinatePowerIdeal_generator (R := K) (fun _ : ι => 2) i)

/-- Coefficients are a faithful test for membership in the coordinate-square ideal. -/
theorem mem_squareIdeal_iff (p : P) :
    p ∈ squareIdeal ↔ ∀ S : Finset ι, p.coeff (subsetExponent S) = 0 := by
  constructor
  · intro hp S
    apply coefficient_zero_of_mem_coordinatePowerIdeal _ hp
    intro i
    simp only [subsetExponent_apply]
    split <;> omega
  · intro hp
    rw [p.as_sum]
    apply Ideal.sum_mem
    intro d hd
    by_cases he : ∃ i, 2 ≤ d i
    · exact monomial_mem_squareIdeal d _ he
    · have hbound (i : ι) : d i ≤ 1 := by
        have := not_exists.mp he i
        omega
      have hsub : subsetExponent d.support = d := by
        ext i
        by_cases hi : i ∈ d.support
        · have hn : d i ≠ 0 := Finsupp.mem_support_iff.mp hi
          simp only [subsetExponent_apply, hi, if_true]
          have := hbound i
          omega
        · simp only [subsetExponent_apply, hi, if_false, Finsupp.notMem_support_iff.mp hi]
      have hz : p.coeff d = 0 := hsub ▸ hp d.support
      rw [hz, monomial_zero]
      exact Ideal.zero_mem _

theorem coefficients_squareIdeal (q : ℕ) {p : P} (hp : p ∈ squareIdeal) :
    coefficients q p = 0 := by
  ext U
  exact (mem_squareIdeal_iff p).mp hp U.val

/-- Homogeneous reduction modulo the actual squares keeps exactly the subset coefficients. -/
theorem homogeneous_reduction_mem (q : ℕ) (p : P) (hp : p.IsHomogeneous q) :
    evaluation q (coefficients q p) - p ∈ squareIdeal := by
  apply (mem_squareIdeal_iff _).mpr
  intro S
  rw [coeff_sub]
  by_cases hS : S.card = q
  · exact sub_eq_zero.mpr (evaluation_coeff q _ ⟨S, hS⟩)
  · have hdeg : (subsetExponent S).degree ≠ q := by simpa using hS
    rw [(evaluation_isHomogeneous q _).coeff_eq_zero hdeg, hp.coeff_eq_zero hdeg, sub_self]

theorem linearForm_isHomogeneous (b : ι → K) : (linearForm b).IsHomogeneous 1 := by
  apply (homogeneousSubmodule ι K 1).sum_mem
  intro i hi
  exact (homogeneousSubmodule ι K 1).smul_mem _ (isHomogeneous_X K i)

theorem squareIdeal_isHomogeneous :
    (squareIdeal (K := K) (ι := ι)).IsHomogeneous (homogeneousSubmodule ι K) := by
  apply Ideal.homogeneous_span
  rintro p ⟨i, rfl⟩
  refine ⟨2, ?_⟩
  change (X i : P) ^ 2 ∈ homogeneousSubmodule ι K 2
  rw [X_pow_eq_monomial]
  exact isHomogeneous_monomial 1 (by simp)

theorem quotientIdeal_isHomogeneous (b c : ι → K) :
    (quotientIdeal b c).IsHomogeneous (homogeneousSubmodule ι K) := by
  apply squareIdeal_isHomogeneous.sup
  apply Ideal.homogeneous_span
  intro p hp
  rcases hp with rfl | hp
  · exact ⟨1, linearForm_isHomogeneous b⟩
  · rcases hp with rfl | hp
    · exact ⟨1, linearForm_isHomogeneous c⟩

@[simp] theorem coefficients_homogeneousComponent (q : ℕ) (p : P) :
    coefficients q (homogeneousComponent q p) = coefficients q p := by
  ext U
  change (homogeneousComponent q p).coeff (subsetExponent U.val) = p.coeff (subsetExponent U.val)
  rw [coeff_homogeneousComponent]
  simp only [subsetExponent_degree, U.property, if_true]

theorem evaluation_coefficients_mem_of_mem (b c : ι → K) (q : ℕ) {p : P}
    (hp : p ∈ quotientIdeal b c) :
    evaluation q (coefficients q p) ∈ quotientIdeal b c := by
  have hhom : homogeneousComponent q p ∈ quotientIdeal b c :=
    homogeneousComponent_mem_of_mem (quotientIdeal_isHomogeneous b c) hp q
  have hred := homogeneous_reduction_mem q (homogeneousComponent q p)
    (homogeneousComponent_mem q p)
  rw [coefficients_homogeneousComponent] at hred
  have hh : evaluation q (coefficients q p) - homogeneousComponent q p ∈ quotientIdeal b c :=
    (show squareIdeal ≤ quotientIdeal b c from le_sup_left) hred
  simpa only [sub_add_cancel] using (quotientIdeal b c).add_mem hh hhom

/-- Multiplication by a linear form, followed by actual degree-q square-free coefficients. -/
def relationMap (b : ι → K) (q : ℕ) : P →ₗ[K] (FixedSubsets ι q → K) :=
  (coefficients q).comp (LinearMap.mulLeft K (linearForm b))

/-- The two relation images.  The comparison with the ordinary ideal quotient is proved below. -/
def relations (b c : ι → K) (q : ℕ) : Submodule K (FixedSubsets ι q → K) :=
  (relationMap b q).range ⊔ (relationMap c q).range

theorem coefficients_ideal_mem_relations (b c : ι → K) (q : ℕ) {p : P}
    (hp : p ∈ quotientIdeal b c) : coefficients q p ∈ relations b c q := by
  obtain ⟨j, hj, r, hr, rfl⟩ := Submodule.mem_sup.mp hp
  obtain ⟨a, d, rfl⟩ := Ideal.mem_span_pair.mp hr
  rw [map_add, coefficients_squareIdeal q hj, zero_add, map_add]
  apply Submodule.add_mem
  · apply (show (relationMap b q).range ≤ relations b c q from le_sup_left)
    exact ⟨a, by simp only [relationMap, LinearMap.comp_apply, LinearMap.mulLeft_apply, mul_comm]⟩
  · apply (show (relationMap c q).range ≤ relations b c q from le_sup_right)
    exact ⟨d, by simp only [relationMap, LinearMap.comp_apply, LinearMap.mulLeft_apply, mul_comm]⟩

theorem coefficients_mem_relations_of_mem_quotientIdeal (b c : ι → K) (q : ℕ) {p : P}
    (hp : p ∈ quotientIdeal b c) : coefficients q p ∈ relations b c q :=
  coefficients_ideal_mem_relations b c q hp

theorem evaluation_mem_ideal_iff (b c : ι → K) (q : ℕ) (v : FixedSubsets ι q → K) :
    evaluation q v ∈ quotientIdeal b c ↔ v ∈ relations b c q := by
  constructor
  · intro hv
    simpa only [coefficients_evaluation] using coefficients_ideal_mem_relations b c q hv
  · intro hv
    obtain ⟨x, hx, y, hy, rfl⟩ := Submodule.mem_sup.mp hv
    obtain ⟨p, rfl⟩ := hx
    obtain ⟨r, rfl⟩ := hy
    rw [map_add]
    apply Ideal.add_mem
    · apply evaluation_coefficients_mem_of_mem
      apply (quotientIdeal b c).mul_mem_right
      exact (show Ideal.span ({linearForm b, linearForm c} : Set P) ≤ quotientIdeal b c
        from le_sup_right) (Ideal.subset_span (by simp))
    · apply evaluation_coefficients_mem_of_mem
      apply (quotientIdeal b c).mul_mem_right
      exact (show Ideal.span ({linearForm b, linearForm c} : Set P) ≤ quotientIdeal b c
        from le_sup_right) (Ideal.subset_span (by simp))

/-- Literal image of homogeneous polynomials in the ordinary polynomial ideal quotient. -/
abbrev piece (b c : ι → K) (q : ℕ) :=
  HomogeneousIdealPieces.piece (quotientIdeal b c) q

def toPiece (b c : ι → K) (q : ℕ) : (FixedSubsets ι q → K) →ₗ[K] piece b c q :=
  (((Ideal.Quotient.mkₐ K (quotientIdeal b c)).toLinearMap).comp (evaluation q)).codRestrict
    (piece b c q) (fun v => ⟨evaluation q v, evaluation_isHomogeneous q v, rfl⟩)

theorem toPiece_surjective (b c : ι → K) (q : ℕ) :
    Function.Surjective (toPiece b c q) := by
  intro z
  obtain ⟨p, hp, hz⟩ := z.property
  refine ⟨coefficients q p, ?_⟩
  apply Subtype.ext
  change Ideal.Quotient.mk (quotientIdeal b c) (evaluation q (coefficients q p)) = z.val
  rw [← hz]
  apply Ideal.Quotient.eq.mpr
  exact (show squareIdeal ≤ quotientIdeal b c from le_sup_left)
    (homogeneous_reduction_mem q p hp)

theorem toPiece_ker (b c : ι → K) (q : ℕ) :
    (toPiece b c q).ker = relations b c q := by
  ext v
  rw [LinearMap.mem_ker]
  change (⟨Ideal.Quotient.mk (quotientIdeal b c) (evaluation q v), _⟩ : piece b c q) = 0 ↔ _
  rw [Subtype.ext_iff]
  change Ideal.Quotient.mk (quotientIdeal b c) (evaluation q v) = 0 ↔ _
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact evaluation_mem_ideal_iff b c q v

/-- The actual homogeneous quotient piece is precisely the coefficient cokernel. -/
def cokernelEquivPiece (b c : ι → K) (q : ℕ) :
    ((FixedSubsets ι q → K) ⧸ relations b c q) ≃ₗ[K] piece b c q :=
  (Submodule.quotEquivOfEq _ _ (toPiece_ker b c q).symm).trans
    ((toPiece b c q).quotKerEquivOfSurjective (toPiece_surjective b c q))

end PaperVerification.AlternatingForms.BooleanQuotient
end
end
