  ext u v
  rcases u with ⟨b, i⟩
  rcases v with ⟨c, j⟩
  fin_cases b <;> fin_cases c <;> by_cases hij : i = j <;>
    simp [EvenSingletons.matchingForm, orbitExteriorCoefficientMatrix,
