variable [CharZero K]

def evenOrbitMatchingOpen (k : ℕ) : MvPolynomial (EvenOrbitParameter k) K :=
  evenOrbitDeterminant k * rename Sum.inr
    (EvenSingletons.matchingGenericPolynomial (K := K) (ι := Fin k))

