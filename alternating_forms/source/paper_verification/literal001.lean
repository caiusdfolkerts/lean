/- Original module: PaperVerification.AlternatingFormsEvenExteriorBoolean -/


/-!
# The actual even exterior quotient as a product of Boolean quotient pieces

This is a decomposition of the genuine degree quotient by the ideal generated
by the two given matching forms.  Every summand is a homogeneous piece of an
ordinary polynomial quotient by squares and the two restricted linear forms.
The index equation retains the original degree exactly.  Both inclusions of
the relation spaces are proved from literal exterior multiplication.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical

namespace PaperVerification.AlternatingForms.EvenSingletons

open scoped BigOperators

variable {K M ι : Type*} [Field K] [AddCommGroup M] [Module K M]
  [LinearOrder ι] [Fintype ι]
local notation "E" => ExteriorAlgebra K M

def blockRelations (a c : ι → K) (s : ℕ) (J : DegreeBlock ι s) :
    Submodule K (BlockSubsets J → K) :=
  BooleanQuotient.relations (fun i : Available J.val.1 => a i.val)
    (fun i : Available J.val.1 => c i.val) J.val.2.val

def coordinateRelations (a c : ι → K) (s : ℕ) :
    Submodule K ((J : DegreeBlock ι s) → BlockSubsets J → K) :=
  Submodule.pi Set.univ (blockRelations a c s)

theorem blockEvaluation_mem_relationIdeal (b : Module.Basis (ι ⊕ ι) K M)
    (a c : ι → K) (S : SingletonState ι) (q : ℕ)
    (v : FixedSubsets (Available S) q → K)
    (hv : v ∈ BooleanQuotient.relations (fun i : Available S => a i.val)
      (fun i : Available S => c i.val) q) :
    blockEvaluation b S q v ∈ exteriorRelationIdeal (matchingForm b a) (matchingForm b c) := by
  cases q with
  | zero =>
      have hz : v = 0 := by
        simpa only [BooleanQuotient.relations_zero, Submodule.mem_bot] using hv
      rw [hz, map_zero]
      exact Ideal.zero_mem _
  | succ q =>
      rw [BooleanQuotient.relations_succ] at hv
      obtain ⟨x, ⟨u, rfl⟩, y, ⟨w, rfl⟩, rfl⟩ := Submodule.mem_sup.mp hv
      rw [map_add, ← matching_mul_blockEvaluation b a S q u,
        ← matching_mul_blockEvaluation b c S q w]
      apply Ideal.add_mem
      · apply Ideal.mul_mem_right
        exact Ideal.subset_span (by simp)
      · apply Ideal.mul_mem_right
        exact Ideal.subset_span (by simp)

theorem degreeCoordinates_symm_mem_relations (b : Module.Basis (ι ⊕ ι) K M)
    (a c : ι → K) (s : ℕ)
    (v : (J : DegreeBlock ι s) → BlockSubsets J → K)
    (hv : v ∈ coordinateRelations a c s) :
    (degreeCoordinates b s).symm v ∈
      exteriorDegreeRelations (matchingForm b a) (matchingForm b c) s := by
  rw [degreeCoordinates_symm]
  apply Submodule.sum_mem
  intro J hJ
  change blockEvaluation b J.val.1 J.val.2.val (v J) ∈
    exteriorRelationIdeal (matchingForm b a) (matchingForm b c)
  exact blockEvaluation_mem_relationIdeal b a c J.val.1 J.val.2.val (v J) (hv J trivial)

def successorBlock (t : ℕ) (T : DegreeState ι t) : DegreeBlock ι (2 + t) :=
  ⟨(T.val.1, ⟨T.val.2.card + 1, by
      have h := T.property
      change singletonDegree T.val.1 + 2 * T.val.2.card = t at h
      omega⟩), by
    have h := T.property
    change singletonDegree T.val.1 + 2 * T.val.2.card = t at h
    change singletonDegree T.val.1 + 2 * (T.val.2.card + 1) = 2 + t
    omega⟩

theorem matching_wedge_basis_eq_block (b : Module.Basis (ι ⊕ ι) K M)
    (a : ι → K) (t : ℕ) (T : DegreeState ι t) :
    exteriorPower.wedge K M 2 t (matchingForm b a) (stateDegreeBasis b t T) =
      blockIntoDegree b (2 + t) (successorBlock t T)
        (weightedInclusionOperator (fun i : Available T.val.1 => a i.val) T.val.2.card
          (Pi.single (⟨T.val.2, rfl⟩ : FixedSubsets (Available T.val.1) T.val.2.card) 1)) := by
  apply Subtype.ext
  change (matchingForm b a : E) * (stateDegreeBasis b t T : E) =
    blockEvaluation b T.val.1 (T.val.2.card + 1) _
  rw [stateDegreeBasis_coe,
    ← blockEvaluation_single b T.val.1 T.val.2.card ⟨T.val.2, rfl⟩,
    matching_mul_blockEvaluation]

def coordinateImageRelations (a : ι → K) (s : ℕ) :
    Submodule K ((J : DegreeBlock ι s) → BlockSubsets J → K) :=
  Submodule.pi Set.univ (fun J =>
    (BooleanQuotient.relationMap (fun i : Available J.val.1 => a i.val) J.val.2.val).range)

theorem matching_wedge_coordinates_mem (b : Module.Basis (ι ⊕ ι) K M)
    (a : ι → K) (t : ℕ) (x : ⋀[K]^t M) :
    degreeCoordinates b (2 + t) (exteriorPower.wedge K M 2 t (matchingForm b a) x) ∈
      coordinateImageRelations a (2 + t) := by
  rw [← (stateDegreeBasis b t).sum_repr x]
  simp only [map_sum, map_smul]
  apply Submodule.sum_mem
  intro T hT
  apply Submodule.smul_mem
  rw [matching_wedge_basis_eq_block]
  erw [degreeCoordinates_block]
  apply Submodule.le_comap_single_pi
  change weightedInclusionOperator (fun i : Available T.val.1 => a i.val) T.val.2.card
      (Pi.single (⟨T.val.2, rfl⟩ : FixedSubsets (Available T.val.1) T.val.2.card) 1) ∈
    (BooleanQuotient.relationMap (fun i : Available T.val.1 => a i.val)
      (T.val.2.card + 1)).range
  rw [BooleanQuotient.relationMap_range_succ]
  exact LinearMap.mem_range_self _ _

theorem coordinateImageRelations_le_left (a c : ι → K) (s : ℕ) :
    coordinateImageRelations a s ≤ coordinateRelations a c s := by
  intro v hv J hJ
  exact (show (BooleanQuotient.relationMap (fun i : Available J.val.1 => a i.val)
    J.val.2.val).range ≤ blockRelations a c s J from le_sup_left) (hv J hJ)

theorem coordinateImageRelations_le_right (a c : ι → K) (s : ℕ) :
    coordinateImageRelations c s ≤ coordinateRelations a c s := by
  intro v hv J hJ
  exact (show (BooleanQuotient.relationMap (fun i : Available J.val.1 => c i.val)
    J.val.2.val).range ≤ blockRelations a c s J from le_sup_right) (hv J hJ)

theorem degreeCoordinates_mem_relations (b : Module.Basis (ι ⊕ ι) K M)
    (a c : ι → K) (s : ℕ) (x : ⋀[K]^s M)
    (hx : x ∈ exteriorDegreeRelations (matchingForm b a) (matchingForm b c) s) :
    degreeCoordinates b s x ∈ coordinateRelations a c s := by
  by_cases hs : s < 2
  · rw [exteriorDegreeRelations_eq_bot _ _ hs] at hx
    have hz : x = 0 := (Submodule.mem_bot K).mp hx
    rw [hz, map_zero]
    exact Submodule.zero_mem _
  · obtain ⟨t, rfl⟩ : ∃ t, s = 2 + t := ⟨s - 2, by omega⟩
    rw [exteriorDegreeRelations_eq_images] at hx
    obtain ⟨u, ⟨y, rfl⟩, v, ⟨z, rfl⟩, rfl⟩ := Submodule.mem_sup.mp hx
    rw [map_add]
    apply Submodule.add_mem
    · exact coordinateImageRelations_le_left a c (2 + t)
        (matching_wedge_coordinates_mem b a t y)
    · exact coordinateImageRelations_le_right a c (2 + t)
        (matching_wedge_coordinates_mem b c t z)

/-- Exact equality of the transported actual generated-ideal relations and
the product of the ordinary Boolean relation spaces. -/
theorem degreeCoordinates_map_relations (b : Module.Basis (ι ⊕ ι) K M)
    (a c : ι → K) (s : ℕ) :
    (exteriorDegreeRelations (matchingForm b a) (matchingForm b c) s).map
      (degreeCoordinates b s).toLinearMap = coordinateRelations a c s := by
  ext v
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact degreeCoordinates_mem_relations b a c s x hx
  · intro hv
    exact ⟨(degreeCoordinates b s).symm v,
      degreeCoordinates_symm_mem_relations b a c s v hv,
      (degreeCoordinates b s).apply_symm_apply v⟩

/-- The full even matching quotient decomposition, in every exterior degree. -/
def exteriorQuotientEquivBooleanPieces (b : Module.Basis (ι ⊕ ι) K M)
    (a c : ι → K) (s : ℕ) :
    ExteriorQuotientDegree (matchingForm b a) (matchingForm b c) s ≃ₗ[K]
      ((J : DegreeBlock ι s) → BooleanQuotient.piece
        (fun i : Available J.val.1 => a i.val) (fun i : Available J.val.1 => c i.val)
        J.val.2.val) :=
  (Submodule.Quotient.equiv _ _ (degreeCoordinates b s)
    (degreeCoordinates_map_relations b a c s)).trans
      ((Submodule.quotientPi (blockRelations a c s)).trans
        (LinearEquiv.piCongrRight (fun J => BooleanQuotient.cokernelEquivPiece
          (fun i : Available J.val.1 => a i.val) (fun i : Available J.val.1 => c i.val)
          J.val.2.val)))

theorem finrank_exteriorQuotient_eq_sum_booleanPieces (b : Module.Basis (ι ⊕ ι) K M)
    (a c : ι → K) (s : ℕ) :
    Module.finrank K (ExteriorQuotientDegree (matchingForm b a) (matchingForm b c) s) =
      ∑ J : DegreeBlock ι s, Module.finrank K (BooleanQuotient.piece
        (fun i : Available J.val.1 => a i.val) (fun i : Available J.val.1 => c i.val)
        J.val.2.val) := by
  letI : ∀ J : DegreeBlock ι s, Module.Free K (BooleanQuotient.piece
      (fun i : Available J.val.1 => a i.val) (fun i : Available J.val.1 => c i.val)
      J.val.2.val) := fun J => Module.Free.of_divisionRing K _
  letI : ∀ J : DegreeBlock ι s, Module.Finite K (BooleanQuotient.piece
      (fun i : Available J.val.1 => a i.val) (fun i : Available J.val.1 => c i.val)
      J.val.2.val) := fun J => BooleanQuotient.finiteDimensional_piece _ _ _
  rw [(exteriorQuotientEquivBooleanPieces b a c s).finrank_eq,
    Module.finrank_pi_fintype]

end PaperVerification.AlternatingForms.EvenSingletons
end
end
end TAF_LiteralSource_0069

section TAF_LiteralSource_0070
/- Original module: PaperVerification.AlternatingFormsBooleanPolynomialRelations -/


/-!
# Polynomial relations with monomial constant term

The local inverse may use negative parameter powers.  After multiplication
by the full linear form, every correction exponent is positive.  This file
constructs the resulting polynomial relation explicitly and proves its
specialization identity in every commutative square-zero algebra.  The
constant term is the original monomial, not a separately defined normal form.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanPolynomialRelations

open scoped BigOperators
open MvPolynomial

variable {K L A ι : Type*} [Field K] [Field L] [CharZero K] [CharZero L]
  [CommRing A] [Algebra L A] [Fintype ι] [DecidableEq ι]

theorem map_inverseCoefficient (φ : K →+* L) (h j : ℕ) :
    φ (inverseCoefficient (K := K) h j) = inverseCoefficient (K := L) h j := by
  simp [inverseCoefficient]

def cost (w : ι → ℕ) (J : Finset ι) (T : Finset J) : ℕ :=
  ∑ i ∈ T, w i.val

def correctionExponent (w : ι → ℕ) (J : Finset ι)
    (P T : Finset J) (j : ι) : ℕ := w j + cost w J T - cost w J P

def normalizedRelation (w : ι → ℕ) (J : Finset ι) (h : ℕ)
    (P : FixedSubsets J (h+1)) (tail : Finset ι) :
    MvPolynomial ι (Polynomial K) :=
  ((∏ i ∈ P.val, X i.val) * ∏ i ∈ tail, X i) +
    ∑ j : {i : ι // i ∉ J}, ∑ T : FixedSubsets J h,
      C (Polynomial.C (inverseCoefficient (K := K) h (T.val ∩ P.val).card) *
        Polynomial.X ^ correctionExponent w J P.val T.val j.val) *
          (X j.val * ∏ i ∈ T.val, X i.val) * ∏ i ∈ tail, X i

/-- Strict positivity is sufficient for the literal constant-coefficient
specialization to retain only the desired original monomial. -/
theorem normalizedRelation_at_zero (w : ι → ℕ) (J : Finset ι) (h : ℕ)
    (P : FixedSubsets J (h+1)) (tail : Finset ι)
    (hpos : ∀ j : {i : ι // i ∉ J}, ∀ T : FixedSubsets J h,
      0 < correctionExponent w J P.val T.val j.val) :
    MvPolynomial.map (Polynomial.evalRingHom (0 : K))
        (normalizedRelation w J h P tail) =
      ((∏ i ∈ P.val, (X i.val : MvPolynomial ι K)) * ∏ i ∈ tail, X i) := by
  unfold normalizedRelation
  simp only [map_add, map_mul, map_sum, map_prod, MvPolynomial.map_X,
    MvPolynomial.map_C, Polynomial.coe_evalRingHom, Polynomial.eval_mul,
    Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
  have hz (j : {i : ι // i ∉ J}) (T : FixedSubsets J h) :
      (0 : K)^correctionExponent w J P.val T.val j.val = 0 :=
    zero_pow (ne_of_gt (hpos j T))
  simp only [hz, mul_zero, map_zero, zero_mul, Finset.sum_const_zero, add_zero]

theorem power_div_normalize (t : L) (ht : t ≠ 0) (a b : ℕ) (hab : b ≤ a) :
    t^a / t^b = t^(a-b) := by
  apply (div_eq_iff (pow_ne_zero _ ht)).mpr
  rw [← pow_add, Nat.sub_add_cancel hab]

theorem scalar_normalize (φ : K →+* L) (t : L) (ht : t ≠ 0)
    (w : ι → ℕ) (J : Finset ι) (h : ℕ)
    (P : FixedSubsets J (h+1)) (T : FixedSubsets J h) (j : ι)
    (hle : cost w J P.val ≤ w j + cost w J T.val) :
    φ (inverseCoefficient (K := K) h (T.val ∩ P.val).card) *
        t^correctionExponent w J P.val T.val j =
      t^(w j) * (inverseCoefficient (K := L) h (T.val ∩ P.val).card *
        (subsetWeight (fun i : J ↦ t^(w i.val)) T.val /
          subsetWeight (fun i : J ↦ t^(w i.val)) P.val)) := by
  rw [map_inverseCoefficient]
  simp only [subsetWeight, Finset.prod_pow_eq_pow_sum]
  change inverseCoefficient (K := L) h (T.val ∩ P.val).card *
      t^(w j + cost w J T.val - cost w J P.val) =
    t^(w j) * (inverseCoefficient (K := L) h (T.val ∩ P.val).card *
      (t^(cost w J T.val) / t^(cost w J P.val)))
  rw [← power_div_normalize t ht _ _ hle, pow_add]
  ring

/-- Evaluation of the displayed polynomial expression after removing its
parameter denominator.  The right-hand side is a multiple of the original
full linear form; local relations have not been substituted for that form. -/
theorem normalized_relation_identity (φ : K →+* L) (t : L) (ht : t ≠ 0)
    (w : ι → ℕ) (J : Finset ι) (h : ℕ) (hJ : J.card = 2*h+1)
    (P : FixedSubsets J (h+1)) (y : ι → A) (hy : ∀ i, y i*y i=0) (tail : A)
    (hle : ∀ j : {i : ι // i ∉ J}, ∀ T : FixedSubsets J h,
      cost w J P.val ≤ w j.val + cost w J T.val) :
    (∏ i ∈ P.val, y i.val) * tail +
        (∑ j : {i : ι // i ∉ J}, ∑ T : FixedSubsets J h,
          (φ (inverseCoefficient (K := K) h (T.val ∩ P.val).card) *
            t^correctionExponent w J P.val T.val j.val) •
              (y j.val * ∏ i ∈ T.val, y i.val)) * tail =
      (∑ i, t^(w i) • y i) *
        ((∑ T : FixedSubsets J h,
          (inverseCoefficient (K := L) h (T.val ∩ P.val).card *
            (subsetWeight (fun i : J ↦ t^(w i.val)) T.val /
              subsetWeight (fun i : J ↦ t^(w i.val)) P.val)) •
                ∏ i ∈ T.val, y i.val) * tail) := by
  let η : A := ∑ T : FixedSubsets J h,
    (inverseCoefficient (K := L) h (T.val ∩ P.val).card *
      (subsetWeight (fun i : J ↦ t^(w i.val)) T.val /
        subsetWeight (fun i : J ↦ t^(w i.val)) P.val)) •
          ∏ i ∈ T.val, y i.val
  have hlocal : (∑ i : J, t^(w i.val) • y i.val) * η =
      ∏ i ∈ P.val, y i.val := by
    apply weighted_local_pair_division
    · exact fun i ↦ pow_ne_zero _ ht
    · exact fun i ↦ hy i.val
    · simpa only [Fintype.card_coe] using hJ
  have hsplit : (∑ i, t^(w i) • y i) =
      (∑ i : J, t^(w i.val) • y i.val) +
        ∑ j : {i : ι // i ∉ J}, t^(w j.val) • y j.val := by
    have hJsum : (∑ i ∈ J, t^(w i) • y i) =
        ∑ i : J, t^(w i.val) • y i.val :=
      Finset.sum_subtype J (fun i ↦ Iff.rfl) (fun i ↦ t^(w i) • y i)
    have hCsum : (∑ i ∈ Jᶜ, t^(w i) • y i) =
        ∑ i : {i : ι // i ∉ J}, t^(w i.val) • y i.val :=
      Finset.sum_subtype Jᶜ (fun i ↦ by simp) (fun i ↦ t^(w i) • y i)
    rw [← hJsum, ← hCsum]
    exact (Finset.sum_add_sum_compl J (fun i ↦ t^(w i) • y i)).symm
  have hcorrection :
      (∑ j : {i : ι // i ∉ J}, ∑ T : FixedSubsets J h,
        (φ (inverseCoefficient (K := K) h (T.val ∩ P.val).card) *
          t^correctionExponent w J P.val T.val j.val) •
            (y j.val * ∏ i ∈ T.val, y i.val)) =
        (∑ j : {i : ι // i ∉ J}, t^(w j.val) • y j.val) * η := by
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro j hj
    dsimp only [η]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro T hT
    rw [scalar_normalize φ t ht w J h P T j.val (hle j T)]
    simp only [smul_mul_assoc, mul_smul_comm, smul_smul]
    congr 1 <;> ring
  change _ = (∑ i, t^(w i) • y i) * (η * tail)
  rw [hsplit, ← mul_assoc, add_mul, hlocal, hcorrection, add_mul]

/-- Ordinary coefficient specialization, before passing to an ideal quotient. -/
theorem normalizedRelation_specialize (φ : K →+* L) (t : L)
    (w : ι → ℕ) (J : Finset ι) (h : ℕ)
    (P : FixedSubsets J (h+1)) (tail : Finset ι) :
    MvPolynomial.map (Polynomial.eval₂RingHom φ t)
        (normalizedRelation w J h P tail) =
      ((∏ i ∈ P.val, (X i.val : MvPolynomial ι L)) * ∏ i ∈ tail, X i) +
        (∑ j : {i : ι // i ∉ J}, ∑ T : FixedSubsets J h,
          (φ (inverseCoefficient (K := K) h (T.val ∩ P.val).card) *
            t^correctionExponent w J P.val T.val j.val) •
              (X j.val * ∏ i ∈ T.val, X i.val)) * ∏ i ∈ tail, X i := by
  simp only [normalizedRelation, map_add, map_mul, map_sum, map_prod,
    MvPolynomial.map_X, MvPolynomial.map_C, Polynomial.coe_eval₂RingHom,
    Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_pow,
    Polynomial.eval₂_X, Finset.sum_mul, MvPolynomial.smul_eq_C_mul]

/-- The specialized polynomial lies in the actual ideal generated by the
coordinate squares and the two original linear forms.  The second form is
arbitrary: a lower-wall relation uses the first form alone. -/
theorem normalizedRelation_mem_quotientIdeal (φ : K →+* L) (t : L) (ht : t ≠ 0)
    (w : ι → ℕ) (J : Finset ι) (h : ℕ) (hJ : J.card = 2*h+1)
    (P : FixedSubsets J (h+1)) (tail : Finset ι) (c : ι → L)
    (hle : ∀ j : {i : ι // i ∉ J}, ∀ T : FixedSubsets J h,
      cost w J P.val ≤ w j.val + cost w J T.val) :
    MvPolynomial.map (Polynomial.eval₂RingHom φ t)
        (normalizedRelation w J h P tail) ∈
      BooleanQuotient.quotientIdeal (fun i ↦ t^(w i)) c := by
  let I := BooleanQuotient.quotientIdeal (fun i ↦ t^(w i)) c
  let π := Ideal.Quotient.mkₐ L I
  let y (i : ι) : MvPolynomial ι L ⧸ I := π (X i)
  have hy (i : ι) : y i * y i = 0 := by
    change π (X i) * π (X i) = 0
    rw [← map_mul]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply (show BooleanQuotient.squareIdeal (K := L) (ι := ι) ≤ I from le_sup_left)
    rw [← pow_two]
    exact coordinatePowerIdeal_generator (R := L) (fun _ : ι ↦ 2) i
  have hlinear : (∑ i, t^(w i) • y i) = 0 := by
    have hspan : Ideal.span
        ({BooleanQuotient.linearForm (fun i ↦ t^(w i)),
          BooleanQuotient.linearForm c} : Set (MvPolynomial ι L)) ≤ I := le_sup_right
    have hmem : BooleanQuotient.linearForm (fun i ↦ t^(w i)) ∈ I :=
      hspan (Ideal.subset_span (by simp))
    have hz : π (BooleanQuotient.linearForm (fun i ↦ t^(w i))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    simpa only [BooleanQuotient.linearForm, map_sum, map_smul, y] using hz
  have hid := normalized_relation_identity φ t ht w J h hJ P y hy
    (∏ i ∈ tail, y i) hle
