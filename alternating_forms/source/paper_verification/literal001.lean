section TAF_LiteralSource_0081
/- Original module: PaperVerification.AlternatingFormsEvenGoodDeterminants -/


/-!
# The independent universal kernel family indexed by good subsets

The indexing set is the actual set of Boolean monomials whose associated
walk stays in the strip.  No ordering or distinctness assumption is imposed
on a proposed family: both follow here from the crossing fibers of those
walks.  The resulting nonzero coefficient minor is a polynomial in the two
original universal coefficient vectors.
-/

@[expose] public section
noncomputable section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms.EvenDeterminants

open scoped BigOperators Classical
open BooleanWalks EvenWalkDeterminants PolynomialMinors

variable {K : Type*} [CommRing K] {m q : ℕ}

def goodFiberDegree (S : GoodSubset m q) (a : Fin (m - 2 * q)) : ℕ :=
  fiberDegree (height S) m a

def goodFiberColumns (S : GoodSubset m q) (a : Fin (m - 2 * q)) :
    Fin (2 * goodFiberDegree S a + 1) → Fin m :=
  fiberColumns (height S) m (m - 2 * q) (height_zero S) (height_final S)
    (height_step S) a

theorem goodFiberColumns_strictMono (S : GoodSubset m q) (a : Fin (m - 2 * q)) :
    StrictMono (goodFiberColumns S a) :=
  fiberColumns_strictMono (height S) m (m - 2 * q) (height_zero S) (height_final S)
    (height_step S) a

theorem goodFiberColumns_disjoint (S : GoodSubset m q) :
    Function.Injective (fun p : (a : Fin (m - 2 * q)) × Fin (2 * goodFiberDegree S a + 1) =>
      goodFiberColumns S p.1 p.2) :=
  fiberColumns_disjoint (height S) m (m - 2 * q) (height_zero S) (height_final S)
    (height_step S)

theorem goodFiberDegree_sum (S : GoodSubset m q) :
    (∑ a, goodFiberDegree S a) = q := by
  have hq := good_degree_bound S
  exact sum_fiberDegree (height S) m (m - 2 * q) q (height_zero S) (height_final S)
    (height_bound S) (height_step S) (by omega)

theorem goodLeadingExponent_apply (S : GoodSubset m q) (i : Fin m) :
    productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S) i =
      if i ∈ S.val.val then 1 else 0 := by
  change productLeadingExponent m (fun a : Fin (m - 2 * q) => fiberDegree (height S) m a)
    (fiberColumns (height S) m (m - 2 * q) (height_zero S) (height_final S)
      (height_step S)) i = if i ∈ S.val.val then 1 else 0
  rw [EvenWalkDeterminants.productLeadingExponent_apply
    (height S) m (m - 2 * q) (height_zero S) (height_final S)
    (height_bound S) (height_step S) i]
  simp only [height_downward_iff]

/-- Distinct actual monomials index distinct actual leading exponent vectors. -/
theorem goodLeadingExponent_injective (m q : ℕ) :
    Function.Injective (fun S : GoodSubset m q =>
      productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S)) := by
  intro S T h
  apply Subtype.ext
  apply Subtype.ext
  ext i
  have hi := congrArg (fun e : Fin m →₀ ℕ => e i) h
  rw [goodLeadingExponent_apply, goodLeadingExponent_apply] at hi
  by_cases hS : i ∈ S.val.val <;> by_cases hT : i ∈ T.val.val <;>
    simp_all only [if_true, if_false, Nat.one_ne_zero, Nat.zero_ne_one]

def goodDeterminantProduct (b c : Fin m → K) (S : GoodSubset m q) :
    MvPolynomial (Fin m) K :=
  determinantProduct m (goodFiberDegree S) (goodFiberColumns S) b c

theorem goodDeterminantProduct_joint_kernel (b c : Fin m → K) (S : GoodSubset m q) :
    directionalDerivative b (goodDeterminantProduct b c S) = 0 ∧
    directionalDerivative c (goodDeterminantProduct b c S) = 0 :=
  determinantProduct_joint_kernel m (goodFiberDegree S) (goodFiberColumns S) b c

theorem goodDeterminantProduct_homogeneous (b c : Fin m → K) (S : GoodSubset m q) :
    (goodDeterminantProduct b c S).IsHomogeneous q := by
  have h := determinantProduct_homogeneous m (goodFiberDegree S) (goodFiberColumns S) b c
  rw [goodFiberDegree_sum] at h
  exact h

theorem goodDeterminantProduct_degreeOf_le_one [Nontrivial K]
    (b c : Fin m → K) (S : GoodSubset m q) (i : Fin m) :
    (goodDeterminantProduct b c S).degreeOf i ≤ 1 :=
  determinantProduct_degreeOf_le_one m (goodFiberDegree S) (goodFiberColumns S)
    (goodFiberColumns_disjoint S) b c i

/-- The good-by-good coefficient minor is nonzero in the universal parameter
ring.  This includes empty indexing sets and all boundary parameter values. -/
theorem goodUniversalProduct_coefficient_det_ne_zero [IsDomain K] (m q : ℕ) :
    (coefficientMatrix
      (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
      (fun S : GoodSubset m q => universalProduct (K := K) m
        (goodFiberDegree S) (goodFiberColumns S))).det ≠ 0 := by
  classical
  exact universalProduct_coefficient_det_ne_zero m goodFiberDegree goodFiberColumns
    goodFiberColumns_strictMono (goodLeadingExponent_injective m q)

theorem goodUniversalProduct_linearIndependent [IsDomain K] (m q : ℕ) :
    LinearIndependent (UniversalParameters K m)
      (fun S : GoodSubset m q => universalProduct (K := K) m
        (goodFiberDegree S) (goodFiberColumns S)) := by
  classical
  exact universalProduct_linearIndependent m goodFiberDegree goodFiberColumns
    goodFiberColumns_strictMono (goodLeadingExponent_injective m q)

end PaperVerification.AlternatingForms.EvenDeterminants
end
end
end TAF_LiteralSource_0081

section TAF_LiteralSource_0082
/- Original module: PaperVerification.AlternatingFormsEvenGoodBooleanLowerBound -/


/-!
# The generic lower bound for the ordinary Boolean quotient

The indexing set is the paper's actual set of good Boolean subsets.  Its
determinant products supply one explicit nonzero polynomial minor in the
original two coefficient vectors.  Wherever this minor is nonzero, the
ordinary Boolean quotient has dimension at least the number of good subsets.
The same bound is established at the generic point of parameter space.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.EvenDeterminants

open scoped BigOperators
open BooleanQuotient BooleanWalks PolynomialMinors

variable {K F : Type*} [Field K] [CommRing F]

def goodCoefficientMinor (m q : ℕ) : UniversalParameters K m :=
  (coefficientMatrix
    (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
    (fun S : GoodSubset m q => universalProduct (K := K) m
      (goodFiberDegree S) (goodFiberColumns S))).det

theorem goodCoefficientMinor_ne_zero (m q : ℕ) : goodCoefficientMinor (K := K) m q ≠ 0 :=
  goodUniversalProduct_coefficient_det_ne_zero m q

/-- The same minor after any honest coefficient-ring specialization. -/
theorem map_goodCoefficientMinor (m q : ℕ) (φ : UniversalParameters K m →+* F) :
    φ (goodCoefficientMinor m q) =
      (coefficientMatrix
        (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
        (fun S : GoodSubset m q => goodDeterminantProduct
          (fun i => φ (universalFirst m i)) (fun i => φ (universalSecond m i)) S)).det := by
  rw [goodCoefficientMinor, φ.map_det, coefficientMatrix_map]
  simp only [universalProduct, determinantProduct_map, goodDeterminantProduct]

def evaluateParameters {m : ℕ} (b c : Fin m → K) : UniversalParameters K m →+* K :=
  MvPolynomial.eval₂Hom (RingHom.id K) (fun z => if z.1 then c z.2 else b z.2)

@[simp] theorem evaluateParameters_first {m : ℕ} (b c : Fin m → K) (i : Fin m) :
    evaluateParameters b c (universalFirst m i) = b i := by
  rw [evaluateParameters, universalFirst, MvPolynomial.eval₂Hom_X']
  rfl

@[simp] theorem evaluateParameters_second {m : ℕ} (b c : Fin m → K) (i : Fin m) :
    evaluateParameters b c (universalSecond m i) = c i := by
  rw [evaluateParameters, universalSecond, MvPolynomial.eval₂Hom_X']
  rfl

theorem evaluate_goodCoefficientMinor {m : ℕ} (q : ℕ) (b c : Fin m → K) :
    evaluateParameters b c (goodCoefficientMinor m q) =
      (coefficientMatrix
        (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
        (fun S : GoodSubset m q => goodDeterminantProduct b c S)).det := by
  simpa only [evaluateParameters_first, evaluateParameters_second] using
    map_goodCoefficientMinor m q (evaluateParameters b c)

theorem good_boolean_lower_bound_of_minor {m : ℕ} (q : ℕ) (b c : Fin m → K)
    (hminor : evaluateParameters b c (goodCoefficientMinor m q) ≠ 0) :
    Fintype.card (GoodSubset m q) ≤ Module.finrank K (piece b c q) := by
  apply card_le_finrank_booleanPiece_of_coefficient_det_ne_zero m q
    goodFiberDegree goodFiberColumns goodFiberDegree_sum goodFiberColumns_disjoint b c
    (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
  simpa only [evaluate_goodCoefficientMinor, goodDeterminantProduct] using hminor

abbrev GenericBooleanField (m : ℕ) := FractionRing (UniversalParameters K m)

def genericFirst (m : ℕ) (i : Fin m) : GenericBooleanField (K := K) m :=
  algebraMap (UniversalParameters K m) (GenericBooleanField m) (universalFirst m i)

def genericSecond (m : ℕ) (i : Fin m) : GenericBooleanField (K := K) m :=
  algebraMap (UniversalParameters K m) (GenericBooleanField m) (universalSecond m i)

theorem generic_goodCoefficientMinor_ne_zero (m q : ℕ) :
    (coefficientMatrix
      (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
      (fun S : GoodSubset m q => goodDeterminantProduct
        (genericFirst (K := K) m) (genericSecond (K := K) m) S)).det ≠ 0 := by
  intro hz
  apply goodCoefficientMinor_ne_zero (K := K) m q
  apply IsFractionRing.injective (UniversalParameters K m) (GenericBooleanField (K := K) m)
  rw [map_zero, map_goodCoefficientMinor]
  exact hz

/-- The generic point has the lower dimension bound, for every degree and
every finite number of variables. -/
theorem good_boolean_generic_lower_bound (m q : ℕ) :
    Fintype.card (GoodSubset m q) ≤
      Module.finrank (GenericBooleanField (K := K) m)
        (piece (genericFirst (K := K) m) (genericSecond (K := K) m) q) := by
  apply card_le_finrank_booleanPiece_of_coefficient_det_ne_zero m q
    goodFiberDegree goodFiberColumns goodFiberDegree_sum goodFiberColumns_disjoint
    (genericFirst m) (genericSecond m)
    (fun S : GoodSubset m q => productLeadingExponent m (goodFiberDegree S) (goodFiberColumns S))
  exact generic_goodCoefficientMinor_ne_zero m q

end PaperVerification.AlternatingForms.EvenDeterminants
end
end
end TAF_LiteralSource_0082

section TAF_LiteralSource_0083
/- Original module: PaperVerification.AlternatingFormsBooleanRelationMatrix -/


/-!
# Finite matrices of the ordinary Boolean relation spaces

These are the matrices of multiplication by the original two linear forms,
in the genuine square-free coefficient bases.  Their coefficients are
polynomial in the two coefficient vectors.  The relation-range theorem and
rank-nullity identify their cokernels with the actual graded quotient pieces.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanRelationMatrix

open scoped BigOperators Classical
open BooleanQuotient BooleanWalks

variable {R S K : Type*} [CommRing R] [CommRing S] [Field K]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

abbrev Column (ι : Type*) (r : ℕ) [DecidableEq ι] :=
  FixedSubsets ι r ⊕ FixedSubsets ι r

def relationLinear (b c : ι → R) (r : ℕ) :
    ((FixedSubsets ι r → R) × (FixedSubsets ι r → R)) →ₗ[R]
      (FixedSubsets ι (r+1) → R) :=
  (weightedInclusionOperator b r).coprod (weightedInclusionOperator c r)

def relationMatrix (b c : ι → R) (r : ℕ) :
    Matrix (FixedSubsets ι (r+1)) (Column ι r) R :=
  LinearMap.toMatrix ((Pi.basisFun R (FixedSubsets ι r)).prod
      (Pi.basisFun R (FixedSubsets ι r)))
    (Pi.basisFun R (FixedSubsets ι (r+1))) (relationLinear b c r)

theorem relationMatrix_inl (b c : ι → R) (r : ℕ)
    (U : FixedSubsets ι (r+1)) (T : FixedSubsets ι r) :
    relationMatrix b c r U (Sum.inl T) =
      ∑ i : U.val, if eraseSubset U i = T then b i.val else 0 := by
  simp only [relationMatrix, LinearMap.toMatrix_apply, Pi.basisFun_repr,
    relationLinear, LinearMap.coprod_apply, Module.Basis.prod_apply_inl_fst,
    Module.Basis.prod_apply_inl_snd, map_zero, add_zero, Pi.basisFun_apply,
    weightedInclusionOperator, LinearMap.coe_mk, AddHom.coe_mk, Pi.single_apply,
    mul_ite, mul_one, mul_zero]

theorem relationMatrix_inr (b c : ι → R) (r : ℕ)
    (U : FixedSubsets ι (r+1)) (T : FixedSubsets ι r) :
    relationMatrix b c r U (Sum.inr T) =
      ∑ i : U.val, if eraseSubset U i = T then c i.val else 0 := by
  simp only [relationMatrix, LinearMap.toMatrix_apply, Pi.basisFun_repr,
    relationLinear, LinearMap.coprod_apply, Module.Basis.prod_apply_inr_fst,
    Module.Basis.prod_apply_inr_snd, map_zero, zero_add, Pi.basisFun_apply,
    weightedInclusionOperator, LinearMap.coe_mk, AddHom.coe_mk, Pi.single_apply,
    mul_ite, mul_one, mul_zero]

/-- Every ring specialization acts on the two coefficient arrays, exactly. -/
theorem relationMatrix_map (φ : R →+* S) (b c : ι → R) (r : ℕ) :
    (relationMatrix b c r).map φ =
      relationMatrix (fun i ↦ φ (b i)) (fun i ↦ φ (c i)) r := by
  ext U T
  cases T with
  | inl T => simp only [Matrix.map_apply, relationMatrix_inl, map_sum, apply_ite, map_zero]
  | inr T => simp only [Matrix.map_apply, relationMatrix_inr, map_sum, apply_ite, map_zero]

theorem relationLinear_range (b c : ι → K) (r : ℕ) :
    (relationLinear b c r).range = relations b c (r+1) := by
  rw [relationLinear, LinearMap.range_coprod, relations_succ]

theorem relationMatrix_rank (b c : ι → K) (r : ℕ) :
    (relationMatrix b c r).rank = Module.finrank K (relations b c (r+1)) := by
  rw [relationMatrix, LinearMap.rank_toMatrix, relationLinear_range]

/-- This equation concerns the actual homogeneous piece of the polynomial
ideal quotient.  No matrix cokernel is substituted for the quotient by definition. -/
theorem piece_finrank_add_matrix_rank (b c : ι → K) (r : ℕ) :
    Module.finrank K (piece b c (r+1)) + (relationMatrix b c r).rank =
      Fintype.card (FixedSubsets ι (r+1)) := by
  have h := (relations b c (r+1)).finrank_quotient_add_finrank
  rw [(cokernelEquivPiece b c (r+1)).finrank_eq] at h
  rw [relationMatrix_rank]
  simpa only [Module.finrank_pi] using h

def universalMatrix (K : Type*) [CommRing K] (m r : ℕ) :
    Matrix (FixedSubsets (Fin m) (r+1)) (Column (Fin m) r)
      (EvenDeterminants.UniversalParameters K m) :=
  relationMatrix (EvenDeterminants.universalFirst m) (EvenDeterminants.universalSecond m) r

theorem universalMatrix_specialize (m r : ℕ)
    (φ : EvenDeterminants.UniversalParameters R m →+* S) :
    (universalMatrix R m r).map φ =
      relationMatrix (fun i ↦ φ (EvenDeterminants.universalFirst m i))
        (fun i ↦ φ (EvenDeterminants.universalSecond m i)) r :=
  relationMatrix_map φ _ _ r

theorem universalMatrix_evaluate (m r : ℕ) (b c : Fin m → K) :
    (universalMatrix K m r).map (EvenDeterminants.evaluateParameters b c) =
      relationMatrix b c r := by
  simp only [universalMatrix_specialize, EvenDeterminants.evaluateParameters_first,
    EvenDeterminants.evaluateParameters_second]

end PaperVerification.AlternatingForms.BooleanRelationMatrix
end
end
end TAF_LiteralSource_0083

section TAF_LiteralSource_0084
/- Original module: PaperVerification.AlternatingFormsBooleanGenericHilbert -/


/-!
# The exact generic Hilbert function of two Boolean linear equations

The lower certificate is the universal determinant-kernel minor.  The upper
certificate is an actual minor of the two multiplication matrices, detected
at the one-parameter pencil.  Their product is nonzero in the original
coefficient polynomial ring.  Its nonvanishing proves equality for the
ordinary homogeneous quotient piece, in every degree and every dimension.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanGenericHilbert

open scoped BigOperators Classical
open BooleanWalks BooleanBadRelations BooleanQuotient BooleanRelationMatrix EvenDeterminants

variable {K : Type*} [Field K] [CharZero K]

def upperParameterEvaluation (m : ℕ) :
    UniversalParameters K m →+* BooleanUpperBound.ParameterField K :=
  MvPolynomial.eval₂Hom BooleanUpperBound.constants
    (fun z ↦ if z.1 then BooleanUpperBound.second m z.2 else BooleanUpperBound.first m z.2)

@[simp] theorem upperParameterEvaluation_first (m : ℕ) (i : Fin m) :
    upperParameterEvaluation (K := K) m (universalFirst m i) = BooleanUpperBound.first m i := by
  simp [upperParameterEvaluation, universalFirst]

@[simp] theorem upperParameterEvaluation_second (m : ℕ) (i : Fin m) :
    upperParameterEvaluation (K := K) m (universalSecond m i) = BooleanUpperBound.second m i := by
  simp [upperParameterEvaluation, universalSecond]

/-- The upper certificate is a minor of the original finite relation matrix,
not a polynomial defined through an asserted generic rank. -/
theorem exists_upper_minor (m r : ℕ) :
    ∃ p : UniversalParameters K m, p ≠ 0 ∧
      ∀ b c : Fin m → K, evaluateParameters b c p ≠ 0 →
        Module.finrank K (piece b c (r+1)) ≤ Fintype.card (GoodSubset m (r+1)) := by
  let φ := upperParameterEvaluation (K := K) m
  have hmap : (universalMatrix K m r).map φ =
      relationMatrix (BooleanUpperBound.first (K := K) m) (BooleanUpperBound.second m) r := by
    simp only [φ, universalMatrix_specialize, upperParameterEvaluation_first,
      upperParameterEvaluation_second]
  have hrank : Fintype.card (BadSubset m (r+1)) ≤
      ((universalMatrix K m r).map φ).rank := by
    rw [hmap, relationMatrix_rank]
    exact BooleanUpperBound.bad_card_le_finrank_relations m (r+1)
  obtain ⟨rows, cols, hminor⟩ := Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mp hrank
