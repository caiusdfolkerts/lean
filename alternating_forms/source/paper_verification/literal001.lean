            (orbitFormsFromCoordinates (evenOrbitExteriorBasis (K := K) k) y).2 s) = 0) := by
  obtain ⟨Q, hQ, h⟩ := even_actual_generic_hilbert (K := K) k
  refine ⟨Q, hQ, ?_⟩
