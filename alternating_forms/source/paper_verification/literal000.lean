section TAF_LiteralSource_0030
/- Original module: PaperVerification.AlternatingFormsExteriorTransport -/


/-!
# Coordinate invariance of the actual exterior quotient

The quotient is transported along a linear equivalence by the usual exterior
power map.  The relation ideal remains the ideal generated by the two mapped
quadratic forms.  In particular, a coordinate-space basis theorem can be
transported to any module equipped with the corresponding basis without
changing either its relations or its displayed exterior words.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms

variable {K M N : Type*} [CommRing K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

def exteriorPowerLinearEquiv (e : M ≃ₗ[K] N) (d : ℕ) :
    (⋀[K]^d M) ≃ₗ[K] (⋀[K]^d N) where
  toLinearMap := exteriorPower.map d e.toLinearMap
  invFun := exteriorPower.map d e.symm.toLinearMap
  left_inv x := by
    change ((exteriorPower.map d e.symm.toLinearMap).comp
      (exteriorPower.map d e.toLinearMap)) x = x
    rw [← exteriorPower.map_comp]
    have h : e.symm.toLinearMap.comp e.toLinearMap = LinearMap.id := by
      ext y
      exact e.symm_apply_apply y
    rw [h, exteriorPower.map_id]
    rfl
  right_inv x := by
    change ((exteriorPower.map d e.toLinearMap).comp
      (exteriorPower.map d e.symm.toLinearMap)) x = x
    rw [← exteriorPower.map_comp]
    have h : e.toLinearMap.comp e.symm.toLinearMap = LinearMap.id := by
      ext y
      exact e.apply_symm_apply y
    rw [h, exteriorPower.map_id]
    rfl

@[simp] theorem exteriorPowerLinearEquiv_apply (e : M ≃ₗ[K] N) (d : ℕ)
    (x : ⋀[K]^d M) :
    exteriorPowerLinearEquiv e d x = exteriorPower.map d e.toLinearMap x := rfl

theorem exteriorRelationIdeal_map_mem_iff (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (x : ExteriorAlgebra K M) :
    ExteriorAlgebra.map e.toLinearMap x ∈
      exteriorRelationIdeal (exteriorPower.map 2 e.toLinearMap f)
        (exteriorPower.map 2 e.toLinearMap g) ↔
      x ∈ exteriorRelationIdeal f g := by
  have hinj : Function.Injective (ExteriorAlgebra.map e.toLinearMap) := by
    apply ExteriorAlgebra.map_injective
    refine ⟨e.symm.toLinearMap, ?_⟩
    ext y
    exact e.symm_apply_apply y
  have hsurj : Function.Surjective (ExteriorAlgebra.map e.toLinearMap) :=
    ExteriorAlgebra.map_surjective_iff.mpr e.surjective
  simp only [exteriorRelationIdeal, exteriorPower.coe_map, Ideal.mem_span_pair]
  constructor
  · rintro ⟨a, b, hab⟩
    obtain ⟨a', rfl⟩ := hsurj a
    obtain ⟨b', rfl⟩ := hsurj b
    refine ⟨a', b', hinj ?_⟩
    simpa only [map_add, map_mul] using hab
  · rintro ⟨a, b, rfl⟩
    refine ⟨ExteriorAlgebra.map e.toLinearMap a,
      ExteriorAlgebra.map e.toLinearMap b, ?_⟩
    simp only [map_add, map_mul]

theorem exteriorDegreeRelations_map (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (d : ℕ) :
    (exteriorDegreeRelations f g d).map (exteriorPower.map d e.toLinearMap) =
      exteriorDegreeRelations (exteriorPower.map 2 e.toLinearMap f)
        (exteriorPower.map 2 e.toLinearMap g) d := by
  ext y
  rw [Submodule.mem_map]
  constructor
  · rintro ⟨x, hx, rfl⟩
    change (exteriorPower.map d e.toLinearMap x : ExteriorAlgebra K N) ∈
      exteriorRelationIdeal (exteriorPower.map 2 e.toLinearMap f)
        (exteriorPower.map 2 e.toLinearMap g)
    rw [exteriorPower.coe_map]
    exact (exteriorRelationIdeal_map_mem_iff e f g x.val).mpr hx
  · intro hy
    obtain ⟨x, rfl⟩ := (exteriorPowerLinearEquiv e d).surjective y
    refine ⟨x, ?_, rfl⟩
    apply (exteriorRelationIdeal_map_mem_iff e f g x.val).mp
    change (exteriorPower.map d e.toLinearMap x : ExteriorAlgebra K N) ∈
      exteriorRelationIdeal (exteriorPower.map 2 e.toLinearMap f)
        (exteriorPower.map 2 e.toLinearMap g) at hy
    simpa only [exteriorPower.coe_map] using hy

def exteriorQuotientDegreeMapEquiv (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (d : ℕ) :
    ExteriorQuotientDegree f g d ≃ₗ[K]
      ExteriorQuotientDegree (exteriorPower.map 2 e.toLinearMap f)
        (exteriorPower.map 2 e.toLinearMap g) d :=
  Submodule.Quotient.equiv _ _ (exteriorPowerLinearEquiv e d)
    (exteriorDegreeRelations_map e f g d)

@[simp] theorem exteriorQuotientDegreeMapEquiv_mk (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (d : ℕ) (x : ⋀[K]^d M) :
    exteriorQuotientDegreeMapEquiv e f g d (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (exteriorPower.map d e.toLinearMap x) := rfl

theorem exteriorBasis_map_words {I : Type*} (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (d : ℕ)
    (B : Module.Basis I K (ExteriorQuotientDegree f g d))
    (v : I → Fin d → M)
    (hB : ∀ i, B i = Submodule.Quotient.mk (exteriorPower.ιMulti K d (v i)))
    (i : I) :
    B.map (exteriorQuotientDegreeMapEquiv e f g d) i =
      Submodule.Quotient.mk (exteriorPower.ιMulti K d (e ∘ v i)) := by
  rw [Module.Basis.map_apply, hB, exteriorQuotientDegreeMapEquiv_mk,
    exteriorPower.map_apply_ιMulti]
  rfl

theorem quadraticSpan_le_exteriorDegreeRelations (f g : ⋀[K]^2 M) :
    Submodule.span K ({f, g} : Set (⋀[K]^2 M)) ≤
      exteriorDegreeRelations f g 2 := by
  apply Submodule.span_le.mpr
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with hx | hx
  · rw [hx]
    change (f : ExteriorAlgebra K M) ∈ exteriorRelationIdeal f g
    exact Ideal.subset_span (by simp)
  · rw [hx]
    change (g : ExteriorAlgebra K M) ∈ exteriorRelationIdeal f g
    exact Ideal.subset_span (by simp)

theorem exteriorRelationIdeal_le_of_quadraticSpan_le (f g f' g' : ⋀[K]^2 M)
    (h : Submodule.span K ({f, g} : Set (⋀[K]^2 M)) ≤
      Submodule.span K ({f', g'} : Set (⋀[K]^2 M))) :
    exteriorRelationIdeal f g ≤ exteriorRelationIdeal f' g' := by
  apply Ideal.span_le.mpr
  rintro x (rfl | rfl)
  · exact quadraticSpan_le_exteriorDegreeRelations f' g'
      (h (Submodule.subset_span (by simp : f ∈ ({f, g} : Set (⋀[K]^2 M)))))
  · exact quadraticSpan_le_exteriorDegreeRelations f' g'
      (h (Submodule.subset_span (by simp : g ∈ ({f, g} : Set (⋀[K]^2 M)))))

/-- An invertible change of the two quadratic generators preserves their
actual ideal, because it preserves their coefficient-ring linear span. -/
theorem exteriorRelationIdeal_eq_of_quadraticSpan_eq (f g f' g' : ⋀[K]^2 M)
    (h : Submodule.span K ({f, g} : Set (⋀[K]^2 M)) =
      Submodule.span K ({f', g'} : Set (⋀[K]^2 M))) :
    exteriorRelationIdeal f g = exteriorRelationIdeal f' g' :=
  le_antisymm (exteriorRelationIdeal_le_of_quadraticSpan_le f g f' g' h.le)
    (exteriorRelationIdeal_le_of_quadraticSpan_le f' g' f g h.symm.le)

def exteriorQuotientDegreeGeneratorsEquiv (f g f' g' : ⋀[K]^2 M)
    (h : Submodule.span K ({f, g} : Set (⋀[K]^2 M)) =
      Submodule.span K ({f', g'} : Set (⋀[K]^2 M))) (d : ℕ) :
    ExteriorQuotientDegree f g d ≃ₗ[K] ExteriorQuotientDegree f' g' d :=
  Submodule.quotEquivOfEq _ _ (by
    rw [exteriorDegreeRelations, exteriorDegreeRelations,
      exteriorRelationIdeal_eq_of_quadraticSpan_eq f g f' g' h])

@[simp] theorem exteriorQuotientDegreeGeneratorsEquiv_mk (f g f' g' : ⋀[K]^2 M)
    (h : Submodule.span K ({f, g} : Set (⋀[K]^2 M)) =
      Submodule.span K ({f', g'} : Set (⋀[K]^2 M))) (d : ℕ) (x : ⋀[K]^d M) :
    exteriorQuotientDegreeGeneratorsEquiv f g f' g' h d (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk x := by
  simp only [exteriorQuotientDegreeGeneratorsEquiv, Submodule.quotEquivOfEq_mk]

/-- Simultaneous coordinate change and change of generators, with no
additional relation or dimension assumption. -/
def exteriorQuotientDegreePencilEquiv (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (f' g' : ⋀[K]^2 N)
    (h : Submodule.span K
      ({exteriorPower.map 2 e.toLinearMap f, exteriorPower.map 2 e.toLinearMap g} :
        Set (⋀[K]^2 N)) = Submodule.span K ({f', g'} : Set (⋀[K]^2 N))) (d : ℕ) :
    ExteriorQuotientDegree f g d ≃ₗ[K] ExteriorQuotientDegree f' g' d :=
  (exteriorQuotientDegreeMapEquiv e f g d).trans
    (exteriorQuotientDegreeGeneratorsEquiv _ _ f' g' h d)

@[simp] theorem exteriorQuotientDegreePencilEquiv_mk (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (f' g' : ⋀[K]^2 N)
    (h : Submodule.span K
      ({exteriorPower.map 2 e.toLinearMap f, exteriorPower.map 2 e.toLinearMap g} :
        Set (⋀[K]^2 N)) = Submodule.span K ({f', g'} : Set (⋀[K]^2 N)))
    (d : ℕ) (x : ⋀[K]^d M) :
    exteriorQuotientDegreePencilEquiv e f g f' g' h d (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (exteriorPower.map d e.toLinearMap x) := by
  rw [exteriorQuotientDegreePencilEquiv, LinearEquiv.trans_apply,
    exteriorQuotientDegreeMapEquiv_mk, exteriorQuotientDegreeGeneratorsEquiv_mk]

theorem exteriorQuotientDegree_finrank_eq_of_pencilEquiv (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (f' g' : ⋀[K]^2 N)
    (h : Submodule.span K
      ({exteriorPower.map 2 e.toLinearMap f, exteriorPower.map 2 e.toLinearMap g} :
        Set (⋀[K]^2 N)) = Submodule.span K ({f', g'} : Set (⋀[K]^2 N))) (d : ℕ) :
    Module.finrank K (ExteriorQuotientDegree f g d) =
      Module.finrank K (ExteriorQuotientDegree f' g' d) :=
  (exteriorQuotientDegreePencilEquiv e f g f' g' h d).finrank_eq

end PaperVerification.AlternatingForms
end
