section TAF_LiteralSource_0039
/- Original module: PaperVerification.AlternatingFormsCharacteristicDivision -/


/-!
# Exterior division with its exact factorial denominator

These statements generalize the literal local inverse to arbitrary fields.
Every use of characteristic zero is replaced by the nonvanishing of the one
factorial that occurs in that inverse. The identities remain identities in
the genuine exterior algebra, with their homogeneous degrees retained.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

open scoped BigOperators

variable {K : Type*} [Field K]

section SquareZero

variable {A ι : Type*} [CommRing A] [Algebra K A] [Fintype ι] [DecidableEq ι]

/-- The exact local inverse needs only `(n+1)!` to be invertible. -/
theorem local_pair_division_of_factorial
    (y : ι → A) (hy : ∀ i, y i * y i = 0)
    (n : ℕ) (hfac : ((n + 1).factorial : K) ≠ 0)
    (hι : Fintype.card ι = 2 * n + 1)
    (P : FixedSubsets ι (n + 1)) :
    (∑ i, y i) *
        (∑ T : FixedSubsets ι n,
          inverseCoefficient (K := K) n (T.1 ∩ P.1).card • ∏ i ∈ T.1, y i) =
      ∏ i ∈ P.1, y i := by
  have h := squarefreeEvaluation_inclusion y hy n
    (inclusionInverse n (Pi.single P (1 : K)))
  rw [inclusionOperator_inclusionInverse_of_factorial n hfac hι] at h
  simpa [squarefreeEvaluation, inclusionInverse, Pi.single_apply] using h

end SquareZero

section Exterior

variable {M ι : Type*} [AddCommGroup M] [Module K M] [Fintype ι] [DecidableEq ι]

/-- The complete local inverse identity for actual exterior pair variables,
with arbitrary universe size and arbitrary vectors in an arbitrary module. -/
theorem local_exterior_pair_division_of_factorial
    (u v : ι → M) (n : ℕ) (hfac : ((n + 1).factorial : K) ≠ 0) (hι : Fintype.card ι = 2 * n + 1)
    (P : FixedSubsets ι (n + 1)) :
    (∑ i, ExteriorAlgebra.ι K (u i) * ExteriorAlgebra.ι K (v i)) *
        (∑ T : FixedSubsets ι n,
          inverseCoefficient (K := K) n (T.1 ∩ P.1).card • pairedMonomial u v T.1) =
      pairedMonomial u v P.1 := by
  have h := local_pair_division_of_factorial (K := K)
    (fun i => exteriorPairCentral (K := K) (u i) (v i))
    (fun i => exteriorPairCentral_square_zero (u i) (v i)) n hfac hι P
  have hcoe := congrArg
    (fun x : Subalgebra.center K (ExteriorAlgebra K M) =>
      (x : ExteriorAlgebra K M)) h
  simpa only [Subalgebra.coe_mul, Subalgebra.coe_smul, map_sum,
    AddSubmonoidClass.coe_finsetSum,
    exteriorPairCentral_coe, pairedMonomial] using hcoe

/-- The local inverse preserves an arbitrary prescribed singleton word.
Pairs occupied by that word annihilate it; every term in the inverse changes
only unoccupied pairs.  This is the support information used in the paper's
straightening weights, beyond mere existence of a prefix inverse. -/
theorem local_exterior_pair_division_with_singletons_of_factorial
    (u v : ι → M) (S : Finset ι) (L : List M)
    (hL : ∀ i ∈ S, u i ∈ L ∨ v i ∈ L)
    (n : ℕ) (hfac : ((n + 1).factorial : K) ≠ 0) (hι : Fintype.card {i : ι // i ∉ S} = 2 * n + 1)
    (P : FixedSubsets {i : ι // i ∉ S} (n + 1)) :
    let z := (L.map (ExteriorAlgebra.ι K)).prod
    (∑ i, ExteriorAlgebra.ι K (u i) * ExteriorAlgebra.ι K (v i)) *
        (z * ∑ T : FixedSubsets {i : ι // i ∉ S} n,
          inverseCoefficient (K := K) n (T.1 ∩ P.1).card •
            pairedMonomial (fun i : {i : ι // i ∉ S} => u i.val)
              (fun i : {i : ι // i ∉ S} => v i.val) T.1) =
      z * pairedMonomial (fun i : {i : ι // i ∉ S} => u i.val)
        (fun i : {i : ι // i ∉ S} => v i.val) P.1 := by
  classical
  dsimp only
  let z := (L.map (ExteriorAlgebra.ι K)).prod
  let y : ι → ExteriorAlgebra K M :=
    fun i => ExteriorAlgebra.ι K (u i) * ExteriorAlgebra.ι K (v i)
  have hkill (i : ι) (hi : i ∈ S) : y i * z = 0 := by
    rcases hL i hi with hu | hv
    · simpa only [y, z, exteriorPair_coe] using
        twoForm_mul_word_eq_zero_of_mem (exteriorPair (u i) (v i)) (u i)
          (exteriorPair_mul_left_generator (u i) (v i)) L hu
    · simpa only [y, z, exteriorPair_coe] using
        twoForm_mul_word_eq_zero_of_mem (exteriorPair (u i) (v i)) (v i)
          (exteriorPair_mul_right_generator (u i) (v i)) L hv
  have hsum : (∑ i, y i) * z = (∑ i : {i : ι // i ∉ S}, y i.val) * z := by
    letI : Fintype {i : ι // i ∈ S} := Subtype.fintype (fun i => i ∈ S)
    rw [Finset.sum_mul, Finset.sum_mul]
    have hz : (∑ i : {i : ι // i ∈ S}, y i.val * z) = 0 :=
      Finset.sum_eq_zero fun i _ => hkill i.val i.property
    calc
      _ = (∑ i : {i : ι // i ∈ S}, y i.val * z) +
          (∑ i : {i : ι // i ∉ S}, y i.val * z) :=
        (Fintype.sum_subtype_add_sum_subtype (fun i => i ∈ S) (fun i => y i * z)).symm
      _ = _ := by rw [hz, zero_add]
  have hcomm : (∑ i : {i : ι // i ∉ S}, y i.val) * z =
      z * (∑ i : {i : ι // i ∉ S}, y i.val) := by
    rw [Finset.sum_mul, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    simpa only [y, exteriorPair_coe] using
      (twoForm_commute (exteriorPair (u i.val) (v i.val)) z).eq
  have hdiv := local_exterior_pair_division_of_factorial (K := K)
    (fun i : {i : ι // i ∉ S} => u i.val)
    (fun i : {i : ι // i ∉ S} => v i.val) n hfac hι P
  change (∑ i, y i) * (z * _) = z * _
  rw [← mul_assoc, hsum, hcomm, mul_assoc]
  exact congrArg (fun a : ExteriorAlgebra K M => z * a) hdiv

/-- The singleton-preserving inverse has precisely the required homogeneous
degree.  Its formula uses the same singleton word and only unoccupied pairs. -/
theorem singleton_state_division_exists_of_factorial
    (u v : ι → M) (S : Finset ι) (L : List M)
    (hL : ∀ i ∈ S, u i ∈ L ∨ v i ∈ L)
    (n : ℕ) (hfac : ((n + 1).factorial : K) ≠ 0) (hι : Fintype.card {i : ι // i ∉ S} = 2 * n + 1)
    (P : FixedSubsets {i : ι // i ∉ S} (n + 1)) :
    ∃ η : ⋀[K]^(L.length + 2 * n) M,
      (∑ i, ExteriorAlgebra.ι K (u i) * ExteriorAlgebra.ι K (v i)) *
          (η : ExteriorAlgebra K M) =
        (L.map (ExteriorAlgebra.ι K)).prod *
          pairedMonomial (fun i : {i : ι // i ∉ S} => u i.val)
            (fun i : {i : ι // i ∉ S} => v i.val) P.1 := by
  classical
  let ηpairs : ExteriorAlgebra K M :=
    ∑ T : FixedSubsets {i : ι // i ∉ S} n,
      inverseCoefficient (K := K) n (T.1 ∩ P.1).card •
        pairedMonomial (fun i : {i : ι // i ∉ S} => u i.val)
          (fun i : {i : ι // i ∉ S} => v i.val) T.1
  have hηpairs : ηpairs ∈ ⋀[K]^(2 * n) M := by
    apply Submodule.sum_mem
    intro T _
    apply Submodule.smul_mem
    simpa only [T.2] using pairedMonomial_mem
      (fun i : {i : ι // i ∉ S} => u i.val)
      (fun i : {i : ι // i ∉ S} => v i.val) T.1
  refine ⟨⟨(L.map (ExteriorAlgebra.ι K)).prod * ηpairs,
    SetLike.mul_mem_graded (exteriorWord_mem L) hηpairs⟩, ?_⟩
  exact local_exterior_pair_division_with_singletons_of_factorial u v S L hL n hfac hι P


/-- In prime characteristic the exact denominator is nonzero below `p`. -/
theorem factorial_cast_ne_zero_of_lt_char (p n : ℕ) [Fact p.Prime] [CharP K p]
    (hn : n < p) : (n.factorial : K) ≠ 0 := by
  intro hz
  exact (not_le_of_gt hn) ((Fact.out : p.Prime).dvd_factorial.mp
    ((CharP.cast_eq_zero_iff K p n.factorial).mp hz))

end Exterior

end PaperVerification.AlternatingForms
end
end TAF_LiteralSource_0039

section TAF_LiteralSource_0040
/- Original module: PaperVerification.AlternatingFormsFrobenius -/


/-!
# Frobenius relations for actual exterior matching forms

The factorial expansion is proved from Boolean incidence, over an arbitrary
field. In characteristic `p` it proves that the actual matching form has
`p`th power zero. It also retains the exact factorial coefficient used by the
sparse-coordinate certificates in Theorem 7.2.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.AlternatingForms

open scoped BigOperators

variable {K : Type*} [Field K]

section SquareZero

variable {A ι : Type*} [CommRing A] [Algebra K A] [Fintype ι] [DecidableEq ι]

theorem squarefreeEvaluation_one_zero (y : ι → A) :
    squarefreeEvaluation (K := K) y 0 (fun _ => 1) = 1 := by
  classical
  let T₀ : FixedSubsets ι 0 := ⟨∅, rfl⟩
  have hT (T : FixedSubsets ι 0) : T = T₀ := by
    apply Subtype.ext
    exact Finset.card_eq_zero.mp T.property
  letI : Unique (FixedSubsets ι 0) := ⟨⟨T₀⟩, hT⟩
  have hd : (default : FixedSubsets ι 0) = T₀ := hT _
  simp [squarefreeEvaluation, hd, T₀]

theorem inclusionOperator_one (n : ℕ) :
    inclusionOperator (K := K) (ι := ι) n (fun _ => 1) =
      fun _ => (n + 1 : K) := by
  funext U
  change (∑ _a : U.val, (1 : K)) = n + 1
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_coe, U.property,
    nsmul_eq_mul, mul_one, Nat.cast_add, Nat.cast_one]

/-- The full squarefree factorial expansion, before imposing a
characteristic. In particular, no Frobenius relation is assumed. -/
theorem squareZero_sum_pow_factorial (y : ι → A)
    (hy : ∀ i, y i * y i = 0) (n : ℕ) :
    (∑ i, y i) ^ n =
      (n.factorial : K) • squarefreeEvaluation (K := K) y n (fun _ => 1) := by
  induction n with
  | zero => simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, one_smul,
      squarefreeEvaluation_one_zero (K := K) y]
  | succ n ih =>
    rw [pow_succ', ih, mul_smul_comm, squarefreeEvaluation_inclusion (K := K) y hy,
      inclusionOperator_one (K := K) (ι := ι)]
    have hconst : squarefreeEvaluation (K := K) y (n + 1)
        (fun _ => (n + 1 : K)) =
        (n + 1 : K) • squarefreeEvaluation (K := K) y (n + 1) (fun _ => 1) := by
      have hc : (fun _ : FixedSubsets ι (n + 1) => (n + 1 : K)) =
          (n + 1 : K) • (fun _ : FixedSubsets ι (n + 1) => (1 : K)) := by
        funext T
        simp only [Pi.smul_apply, smul_eq_mul, mul_one]
      rw [hc]
      exact (squarefreeEvaluation (K := K) y (n + 1)).map_smul
        (n + 1 : K) (fun _ => 1)
    rw [hconst, smul_smul, Nat.factorial_succ, Nat.cast_mul,
      Nat.cast_add, Nat.cast_one]
    congr 1
    exact mul_comm _ _

/-- At the top squarefree degree the expansion has a single retained
product, with the coefficient `card(ι)!`. -/
theorem squareZero_sum_pow_card (y : ι → A)
    (hy : ∀ i, y i * y i = 0) :
    (∑ i, y i) ^ Fintype.card ι =
      ((Fintype.card ι).factorial : K) • ∏ i, y i := by
  classical
  let T₀ : FixedSubsets ι (Fintype.card ι) := ⟨Finset.univ, Finset.card_univ⟩
  have hT (T : FixedSubsets ι (Fintype.card ι)) : T = T₀ := by
    apply Subtype.ext
    exact Finset.eq_of_subset_of_card_le T.val.subset_univ
      (by rw [Finset.card_univ, T.property])
  letI : Unique (FixedSubsets ι (Fintype.card ι)) := ⟨⟨T₀⟩, hT⟩
  rw [squareZero_sum_pow_factorial (K := K) y hy]
  have hd : (default : FixedSubsets ι (Fintype.card ι)) = T₀ := hT _
  simp [squarefreeEvaluation, hd, T₀]

/-- Frobenius vanishing follows from the zero factorial coefficient. -/
theorem squareZero_sum_pow_char (y : ι → A)
    (hy : ∀ i, y i * y i = 0) (p : ℕ) [Fact p.Prime] [CharP K p] :
    (∑ i, y i) ^ p = 0 := by
  rw [squareZero_sum_pow_factorial (K := K) y hy]
  have hfac : (p.factorial : K) = 0 := by
    exact (CharP.cast_eq_zero_iff K p p.factorial).mpr
      ((Fact.out : p.Prime).dvd_factorial.mpr le_rfl)
  rw [hfac, zero_smul]

end SquareZero

section Exterior

variable {M ι : Type*} [AddCommGroup M] [Module K M] [Fintype ι] [DecidableEq ι]

/-- The central sum is the actual sum of exterior pair monomials. -/
theorem exterior_matching_pow_char (u v : ι → M)
    (p : ℕ) [Fact p.Prime] [CharP K p] :
    (∑ i, ExteriorAlgebra.ι K (u i) * ExteriorAlgebra.ι K (v i)) ^ p = 0 := by
  have h := squareZero_sum_pow_char (K := K)
    (fun i => exteriorPairCentral (K := K) (u i) (v i))
    (fun i => exteriorPairCentral_square_zero (u i) (v i)) p
  have hc := congrArg
    (fun a : Subalgebra.center K (ExteriorAlgebra K M) =>
      (a : ExteriorAlgebra K M)) h
  simpa only [Subalgebra.coe_pow, AddSubmonoidClass.coe_finsetSum,
    exteriorPairCentral_coe, ZeroMemClass.coe_zero] using hc

/-- The exact sparse projection coefficient in the genuine exterior
algebra. Nonvanishing is supplied separately by the retained exterior word. -/
theorem exterior_matching_pow_card (u v : ι → M) :
    (∑ i, ExteriorAlgebra.ι K (u i) * ExteriorAlgebra.ι K (v i)) ^ Fintype.card ι =
      ((Fintype.card ι).factorial : K) • pairedMonomial u v Finset.univ := by
  have h := squareZero_sum_pow_card (K := K)
    (fun i => exteriorPairCentral (K := K) (u i) (v i))
    (fun i => exteriorPairCentral_square_zero (u i) (v i))
  have hc := congrArg
    (fun a : Subalgebra.center K (ExteriorAlgebra K M) =>
      (a : ExteriorAlgebra K M)) h
  simpa only [Subalgebra.coe_pow, AddSubmonoidClass.coe_finsetSum,
    exteriorPairCentral_coe, Subalgebra.coe_smul, pairedMonomial] using hc

end Exterior

section BasisWords

variable {M I : Type*} [AddCommGroup M] [Module K M] [LinearOrder I]

/-- Any repetition-free word in basis generators is a nonzero scalar
multiple of the canonical exterior basis vector with exactly its support. -/
theorem exterior_basis_word_unit (b : Module.Basis I K M)
    (L : List I) (hL : L.Nodup) :
    ∃ ε : K, ε ≠ 0 ∧
      ((L.map b).map (ExteriorAlgebra.ι K)).prod =
        ε • b.ExteriorAlgebra L.toFinset := by
  classical
  let S : Finset I := L.toFinset
  let c : Fin S.card ↪o I := S.orderEmbOfFin rfl
  have hc : (List.ofFn c).Nodup := List.nodup_ofFn_ofInjective c.injective
  have hperm : L.Perm (List.ofFn c) := by
    apply (List.perm_ext_iff_of_nodup hL hc).mpr
    intro i
    rw [List.mem_ofFn]
    change i ∈ L ↔ i ∈ Set.range c
    rw [show Set.range c = (S : Set I) from Finset.range_orderEmbOfFin S rfl]
    simp only [S, Finset.mem_coe, List.mem_toFinset]
  obtain ⟨ε, hε, heq⟩ := exterior_word_permutation (K := K) (hperm.map b)
  refine ⟨ε, hε, ?_⟩
  rw [heq]
  congr 1
  rw [ExteriorAlgebra.basis_apply_ofCard b (s_card := rfl)]
  simp only [ExteriorAlgebra.ιMulti_family, ExteriorAlgebra.ιMulti_apply,
    Set.powersetCard.ofFinEmbEquiv_symm_apply, List.map_ofFn, Function.comp_def,
    Set.powersetCard.ofCard, S, c]

/-- A word with distinct basis generators is genuinely nonzero. -/
theorem exterior_basis_word_ne_zero (b : Module.Basis I K M)
    (L : List I) (hL : L.Nodup) :
    ((L.map b).map (ExteriorAlgebra.ι K)).prod ≠ 0 := by
  obtain ⟨ε, hε, heq⟩ := exterior_basis_word_unit b L hL
  rw [heq]
  exact smul_ne_zero hε (b.ExteriorAlgebra.ne_zero L.toFinset)

end BasisWords

end PaperVerification.AlternatingForms
