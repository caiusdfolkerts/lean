section TAF_LiteralSource_0031
/- Original module: PaperVerification.AlternatingFormsExteriorGenericHilbert -/


/-!
# One principal open certificate for the complete exterior Hilbert function

The relation matrices used here are matrices of the actual wedge maps.
Their ranges are identified with the degree pieces of the actual generated
ideal.  The finite collection of rank certificates is then combined into a
single polynomial.  Degrees zero and one and degrees above the ambient
dimension are included explicitly, so the conclusion quantifies over every
natural degree.
-/

@[expose] public section
noncomputable section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

open MvPolynomial Module
open scoped BigOperators Classical

variable {K M : Type*} [Field K] [AddCommGroup M] [Module K M]
  [FiniteDimensional K M]

theorem exteriorDegreeRelations_eq_orbitRange (f g : ⋀[K]^2 M) (q : ℕ) :
    exteriorDegreeRelations f g (2 + q) = (orbitExteriorRelationMap f g q).range := by
  rw [exteriorDegreeRelations_eq_images, orbitExteriorRelationMap, LinearMap.range_coprod]

theorem exteriorQuotientDegree_finrank_add_orbitRange (f g : ⋀[K]^2 M) (q : ℕ) :
    Module.finrank K (ExteriorQuotientDegree f g (2 + q)) +
      Module.finrank K (orbitExteriorRelationMap f g q).range =
        Module.finrank K (⋀[K]^(2 + q) M) := by
  have he := (Submodule.quotEquivOfEq
    (exteriorDegreeRelations f g (2+q)) (orbitExteriorRelationMap f g q).range
    (exteriorDegreeRelations_eq_orbitRange f g q)).finrank_eq
  change Module.finrank K (ExteriorQuotientDegree f g (2+q)) = _ at he
  rw [he]
  exact Submodule.finrank_quotient_add_finrank (orbitExteriorRelationMap f g q).range

theorem exteriorQuotientDegree_finrank_eq_iff_orbitRange_finrank_eq
    (f g f' g' : ⋀[K]^2 M) (q : ℕ) :
    Module.finrank K (ExteriorQuotientDegree f g (2 + q)) =
        Module.finrank K (ExteriorQuotientDegree f' g' (2 + q)) ↔
      Module.finrank K (orbitExteriorRelationMap f g q).range =
        Module.finrank K (orbitExteriorRelationMap f' g' q).range := by
  have h := exteriorQuotientDegree_finrank_add_orbitRange f g q
  have h' := exteriorQuotientDegree_finrank_add_orbitRange f' g' q
  omega

theorem exteriorQuotientDegree_finrank_eq_low (f g f' g' : ⋀[K]^2 M)
    (d : ℕ) (hd : d < 2) :
    Module.finrank K (ExteriorQuotientDegree f g d) =
      Module.finrank K (ExteriorQuotientDegree f' g' d) := by
  exact ((exteriorDegreeRelations f g d).quotEquivOfEqBot
    (exteriorDegreeRelations_eq_bot f g hd)).finrank_eq.trans
      ((exteriorDegreeRelations f' g' d).quotEquivOfEqBot
        (exteriorDegreeRelations_eq_bot f' g' hd)).finrank_eq.symm

theorem exteriorQuotientDegree_finrank_eq_zero_high (f g : ⋀[K]^2 M)
    (d : ℕ) (hd : Module.finrank K M < d) :
    Module.finrank K (ExteriorQuotientDegree f g d) = 0 := by
  have h := Submodule.finrank_quotient_add_finrank (exteriorDegreeRelations f g d)
  rw [exteriorPower.finrank_eq, Nat.choose_eq_zero_of_lt hd] at h
  change Module.finrank K (ExteriorQuotientDegree f g d) + _ = 0 at h
  omega

section Certificates

variable {I σ : Type*} [Fintype I] [Fintype σ] [Infinite K]
    (b₂ : Basis I K (⋀[K]^2 M))

/-- A constant complete Hilbert function on a nonempty principal part of a
dominant polynomial parametrization gives one nonempty principal open in the
full coefficient space with that same complete Hilbert function. -/
theorem exteriorHilbert_principal_certificate_of_dominant
    (p : (I ⊕ I) → MvPolynomial σ K) (v : σ → K)
    (hJ : (TauCeti.jacobiMatrixAt p v).mulVec.Surjective)
    (g : MvPolynomial σ K) (hg : g ≠ 0) (base : (I ⊕ I) → K)
    (hparam : ∀ x : σ → K, eval x g ≠ 0 → ∀ d : ℕ,
      Module.finrank K (ExteriorQuotientDegree
        (orbitFormsFromCoordinates b₂ (fun i => eval x (p i))).1
        (orbitFormsFromCoordinates b₂ (fun i => eval x (p i))).2 d) =
      Module.finrank K (ExteriorQuotientDegree
        (orbitFormsFromCoordinates b₂ base).1 (orbitFormsFromCoordinates b₂ base).2 d)) :
    ∃ Q : MvPolynomial (I ⊕ I) K, eval base Q ≠ 0 ∧
      ∀ y : (I ⊕ I) → K, eval y Q ≠ 0 → ∀ d : ℕ,
        Module.finrank K (ExteriorQuotientDegree
          (orbitFormsFromCoordinates b₂ y).1 (orbitFormsFromCoordinates b₂ y).2 d) =
        Module.finrank K (ExteriorQuotientDegree
          (orbitFormsFromCoordinates b₂ base).1 (orbitFormsFromCoordinates b₂ base).2 d) := by
  let n := Module.finrank K M
  let P (d : Fin (n + 1)) (y : (I ⊕ I) → K) : Prop :=
    Module.finrank K (ExteriorQuotientDegree
      (orbitFormsFromCoordinates b₂ y).1 (orbitFormsFromCoordinates b₂ y).2 (2 + d.val)) =
    Module.finrank K (ExteriorQuotientDegree
      (orbitFormsFromCoordinates b₂ base).1 (orbitFormsFromCoordinates b₂ base).2 (2 + d.val))
  have hdegree (d : Fin (n + 1)) :
      ∃ Q : MvPolynomial (I ⊕ I) K, eval base Q ≠ 0 ∧
        ∀ y : (I ⊕ I) → K, eval y Q ≠ 0 → P d y := by
    let A := orbitRelationPolynomialMatrix d.val b₂
      (Module.finBasis K (⋀[K]^d.val M)) (Module.finBasis K (⋀[K]^(2 + d.val) M))
    have hrank (x : σ → K) (hx : eval x g ≠ 0) :
        (A.map (eval (fun i => eval x (p i)))).rank = (A.map (eval base)).rank := by
      simp only [A, orbitRelationPolynomialMatrix_eval, LinearMap.rank_toMatrix]
      exact (exteriorQuotientDegree_finrank_eq_iff_orbitRange_finrank_eq _ _ _ _ d.val).mp
        (hparam x hx (2 + d.val))
    obtain ⟨Q, hbase, hQ⟩ :=
      polynomialMatrix_generic_rank_from_orbit A hJ hg base hrank
    refine ⟨Q, hbase, ?_⟩
    intro y hy
    apply (exteriorQuotientDegree_finrank_eq_iff_orbitRange_finrank_eq _ _ _ _ d.val).mpr
    have h := hQ y hy
    simpa only [A, orbitRelationPolynomialMatrix_eval, LinearMap.rank_toMatrix] using h
  obtain ⟨Q, hbase, hQ⟩ := exists_simultaneous_principal_certificate base P hdegree
  refine ⟨Q, hbase, ?_⟩
  intro y hy d
  by_cases hlow : d < 2
  · exact exteriorQuotientDegree_finrank_eq_low _ _ _ _ d hlow
  · by_cases hhigh : n < d
    · rw [exteriorQuotientDegree_finrank_eq_zero_high _ _ d hhigh,
        exteriorQuotientDegree_finrank_eq_zero_high _ _ d hhigh]
    · let i : Fin (n + 1) := ⟨d - 2, by omega⟩
      have h := hQ y hy i
      change Module.finrank K (ExteriorQuotientDegree
        (orbitFormsFromCoordinates b₂ y).1 (orbitFormsFromCoordinates b₂ y).2 (2 + (d - 2))) =
        Module.finrank K (ExteriorQuotientDegree
          (orbitFormsFromCoordinates b₂ base).1 (orbitFormsFromCoordinates b₂ base).2
            (2 + (d - 2))) at h
      have hd : 2 + (d - 2) = d := by omega
      exact (congrArg (fun r => Module.finrank K (ExteriorQuotientDegree
        (orbitFormsFromCoordinates b₂ y).1 (orbitFormsFromCoordinates b₂ y).2 r)) hd).symm.trans
          (h.trans (congrArg (fun r => Module.finrank K (ExteriorQuotientDegree
            (orbitFormsFromCoordinates b₂ base).1 (orbitFormsFromCoordinates b₂ base).2 r)) hd))

/-- In the single-orbit case, actual exterior transport supplies the Hilbert
function hypothesis in the preceding theorem.  An invertible change of the
two generators is allowed through equality of their quadratic spans. -/
theorem exteriorHilbert_principal_certificate_of_dominant_orbit
    (p : (I ⊕ I) → MvPolynomial σ K) (v : σ → K)
    (hJ : (TauCeti.jacobiMatrixAt p v).mulVec.Surjective)
    (g : MvPolynomial σ K) (hg : g ≠ 0) (base : (I ⊕ I) → K)
    (horbit : ∀ x : σ → K, eval x g ≠ 0 → ∃ e : M ≃ₗ[K] M,
      Submodule.span K
        ({exteriorPower.map 2 e.toLinearMap (orbitFormsFromCoordinates b₂ base).1,
          exteriorPower.map 2 e.toLinearMap (orbitFormsFromCoordinates b₂ base).2} :
            Set (⋀[K]^2 M)) =
      Submodule.span K
        ({(orbitFormsFromCoordinates b₂ (fun i => eval x (p i))).1,
          (orbitFormsFromCoordinates b₂ (fun i => eval x (p i))).2} : Set (⋀[K]^2 M))) :
    ∃ Q : MvPolynomial (I ⊕ I) K, eval base Q ≠ 0 ∧
      ∀ y : (I ⊕ I) → K, eval y Q ≠ 0 → ∀ d : ℕ,
        Module.finrank K (ExteriorQuotientDegree
          (orbitFormsFromCoordinates b₂ y).1 (orbitFormsFromCoordinates b₂ y).2 d) =
        Module.finrank K (ExteriorQuotientDegree
          (orbitFormsFromCoordinates b₂ base).1 (orbitFormsFromCoordinates b₂ base).2 d) := by
  apply exteriorHilbert_principal_certificate_of_dominant b₂ p v hJ g hg base
  intro x hx d
  obtain ⟨e, he⟩ := horbit x hx
  exact (exteriorQuotientDegree_finrank_eq_of_pencilEquiv e _ _ _ _ he d).symm

end Certificates

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0031

section TAF_LiteralSource_0032
/- Original module: PaperVerification.AlternatingFormsOrbitCoefficientTransport -/


/-!
# From literal matrix orbit coordinates to actual exterior Hilbert certificates

The blockwise coefficient slots are converted into a genuine basis of the
second exterior power.  The congruence polynomials are then proved to
parametrize the actual exterior images under an invertible linear map.
Consequently their surjective Jacobian supplies a principal open certificate
for the complete Hilbert function of the actual generated-ideal quotient.
-/

@[expose] public section
noncomputable section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

open MvPolynomial Matrix
open scoped BigOperators Classical

variable {K ν I σ κ : Type*} [Field K]

/-- The orbit calculations group the two coefficient vectors by a Boolean
tag; the relation matrices group them by a sum type. -/
def orbitPairCoefficientPoint (x : Bool × I → K) : (I ⊕ I) → K :=
  x ∘ (Equiv.boolProdEquivSum I).symm

def orbitPairPolynomialCoordinates (p : Bool × I → MvPolynomial σ K) :
    (I ⊕ I) → MvPolynomial σ K :=
  p ∘ (Equiv.boolProdEquivSum I).symm

theorem jacobian_surjective_reindex [Fintype σ] {J : Type*}
    (p : I → MvPolynomial σ K) (v : σ → K) (e : J ≃ I)
    (hJ : (TauCeti.jacobiMatrixAt p v).mulVec.Surjective) :
    (TauCeti.jacobiMatrixAt (p ∘ e) v).mulVec.Surjective := by
  intro y
  obtain ⟨w, hw⟩ := hJ (fun i => y (e.symm i))
  refine ⟨w, ?_⟩
  funext j
  have h := congrFun hw (e j)
  simpa only [TauCeti.jacobiMatrixAt, Matrix.mulVec, dotProduct,
    Matrix.of_apply, Function.comp_apply, Equiv.symm_apply_apply] using h

section CoordinateTransport

variable [Fintype ν] [DecidableEq ν] [Fintype I] [DecidableEq I]
    {row col : I → ν} (hslots : OrbitPairSlots row col)

theorem orbitFormsFromCoordinates_pair_slots (x : Bool × I → K) :
    orbitFormsFromCoordinates (orbitSlotBasis (K := K) hslots)
      (orbitPairCoefficientPoint x) =
      (orbitTwoFormOfSlots row col (fun i => x (false, i)),
        orbitTwoFormOfSlots row col (fun i => x (true, i))) := by
  apply Prod.ext <;>
    simp only [orbitFormsFromCoordinates, orbitPairCoefficientPoint,
      Function.comp_apply, Equiv.boolProdEquivSum, Equiv.coe_fn_symm_mk,
      Sum.elim_inl, Sum.elim_inr, orbitSlotBasis_apply, orbitTwoFormOfSlots]

include hslots in
theorem orbitSlotCoordinates_congruence (X : Matrix ν ν K)
    (f : ⋀[K]^2 (ν → K)) :
    orbitTwoFormOfSlots row col
      (fun i => (X.transpose * orbitExteriorCoefficientMatrix f * X) (row i) (col i)) =
      exteriorPower.map 2 (Matrix.toLin' X.transpose) f := by
  rw [← orbitExteriorCoefficientMatrix_map]
  exact orbitTwoFormOfSlots_reconstruct hslots _

def actualOrbitPolynomials (f g : ⋀[K]^2 (ν → K)) :
    Bool × I → MvPolynomial (ν × ν) K :=
  orbitCongruenceFamily
    (fun z => if z.1 then orbitExteriorCoefficientMatrix g else orbitExteriorCoefficientMatrix f)
    (fun z => row z.2) (fun z => col z.2)

def actualOrbitBasePoint (f g : ⋀[K]^2 (ν → K)) : Bool × I → K :=
  fun z => if z.1 then orbitExteriorCoefficientMatrix g (row z.2) (col z.2)
    else orbitExteriorCoefficientMatrix f (row z.2) (col z.2)

theorem actualOrbitBasePoint_forms (f g : ⋀[K]^2 (ν → K)) :
    orbitFormsFromCoordinates (orbitSlotBasis hslots)
      (orbitPairCoefficientPoint (actualOrbitBasePoint (row := row) (col := col) f g)) =
      (f, g) := by
  rw [orbitFormsFromCoordinates_pair_slots]
  simp only [actualOrbitBasePoint, Bool.false_eq_true, if_false, if_true,
    orbitTwoFormOfSlots_reconstruct hslots]

theorem actualOrbitPolynomials_forms_eval (f g : ⋀[K]^2 (ν → K))
    (x : (ν × ν) → K) :
    orbitFormsFromCoordinates (orbitSlotBasis hslots)
      (fun i => eval x (orbitPairPolynomialCoordinates
        (actualOrbitPolynomials (row := row) (col := col) f g) i)) =
      (exteriorPower.map 2 (Matrix.toLin' (Matrix.of fun i j => x (i, j)).transpose) f,
       exteriorPower.map 2 (Matrix.toLin' (Matrix.of fun i j => x (i, j)).transpose) g) := by
  change orbitFormsFromCoordinates (orbitSlotBasis hslots)
    (orbitPairCoefficientPoint (fun z => eval x
      (actualOrbitPolynomials (row := row) (col := col) f g z))) = _
  rw [orbitFormsFromCoordinates_pair_slots]
  apply Prod.ext <;>
    simp only [actualOrbitPolynomials, orbitCongruenceFamily,
      Bool.false_eq_true, if_false, if_true, orbitCongruenceCoordinate_eval] <;>
    exact orbitSlotCoordinates_congruence hslots _ _

end CoordinateTransport

section InvertibleTransport

variable [Fintype ν] [DecidableEq ν]

def orbitTransposeEquiv (X : Matrix ν ν K) (hX : X.det ≠ 0) :
    (ν → K) ≃ₗ[K] (ν → K) :=
  LinearEquiv.ofBijective (Matrix.toLin' X.transpose) (by
    have hu : IsUnit X.transpose :=
      (Matrix.isUnit_iff_isUnit_det _).mpr
        (isUnit_iff_ne_zero.mpr (by rwa [Matrix.det_transpose]))
    exact ⟨Matrix.mulVec_injective_of_isUnit hu, Matrix.mulVec_surjective_iff_isUnit.mpr hu⟩)

@[simp] theorem orbitTransposeEquiv_toLinearMap (X : Matrix ν ν K) (hX : X.det ≠ 0) :
    (orbitTransposeEquiv X hX).toLinearMap = Matrix.toLin' X.transpose := rfl

end InvertibleTransport

section ActualOrbitCertificate

variable [Fintype ν] [DecidableEq ν] [Fintype I] [DecidableEq I] [Infinite K]
    {row col : I → ν} (hslots : OrbitPairSlots row col)

/-- The Jacobian hypothesis is about the explicitly defined orbit of these
actual exterior elements.  No dimension or orbit-classification hypothesis
is present.  Concrete odd-pencil Jacobian calculations instantiate it. -/
theorem actualOrbit_principal_hilbert_certificate (f g : ⋀[K]^2 (ν → K))
    (hJ : (TauCeti.jacobiMatrixAt
      (actualOrbitPolynomials (row := row) (col := col) f g)
      (orbitIdentityPoint (K := K) (ν := ν))).mulVec.Surjective) :
    ∃ Q : MvPolynomial (I ⊕ I) K,
      eval (orbitPairCoefficientPoint (actualOrbitBasePoint (row := row) (col := col) f g)) Q ≠ 0 ∧
      ∀ y : (I ⊕ I) → K, eval y Q ≠ 0 → ∀ d : ℕ,
        Module.finrank K (ExteriorQuotientDegree
          (orbitFormsFromCoordinates (orbitSlotBasis hslots) y).1
          (orbitFormsFromCoordinates (orbitSlotBasis hslots) y).2 d) =
        Module.finrank K (ExteriorQuotientDegree f g d) := by
  let p := actualOrbitPolynomials (row := row) (col := col) f g
  let base := orbitPairCoefficientPoint (actualOrbitBasePoint (row := row) (col := col) f g)
  have hJ' := jacobian_surjective_reindex p orbitIdentityPoint
    (Equiv.boolProdEquivSum I).symm hJ
  have horbit (x : (ν × ν) → K) (hx : eval x (orbitDeterminant (K := K) (ν := ν)) ≠ 0) :
      ∃ e : (ν → K) ≃ₗ[K] (ν → K),
      Submodule.span K
        ({exteriorPower.map 2 e.toLinearMap
            (orbitFormsFromCoordinates (orbitSlotBasis hslots) base).1,
          exteriorPower.map 2 e.toLinearMap
            (orbitFormsFromCoordinates (orbitSlotBasis hslots) base).2} :
              Set (⋀[K]^2 (ν → K))) =
      Submodule.span K
        ({(orbitFormsFromCoordinates (orbitSlotBasis hslots)
            (fun i => eval x (orbitPairPolynomialCoordinates p i))).1,
          (orbitFormsFromCoordinates (orbitSlotBasis hslots)
            (fun i => eval x (orbitPairPolynomialCoordinates p i))).2} :
              Set (⋀[K]^2 (ν → K))) := by
    let X : Matrix ν ν K := Matrix.of fun i j => x (i, j)
    have hX : X.det ≠ 0 := by simpa only [orbitDeterminant_eval] using hx
    refine ⟨orbitTransposeEquiv X hX, ?_⟩
    rw [show orbitFormsFromCoordinates (orbitSlotBasis hslots) base = (f, g) from
      actualOrbitBasePoint_forms hslots f g]
    rw [actualOrbitPolynomials_forms_eval hslots f g x]
    rfl
  obtain ⟨Q, hbase, hQ⟩ :=
    exteriorHilbert_principal_certificate_of_dominant_orbit (orbitSlotBasis hslots)
      (orbitPairPolynomialCoordinates p) orbitIdentityPoint hJ' orbitDeterminant
      orbitDeterminant_ne_zero base horbit
  refine ⟨Q, hbase, ?_⟩
  intro y hy d
  have h := hQ y hy d
  rw [show orbitFormsFromCoordinates (orbitSlotBasis hslots) base = (f, g) from
    actualOrbitBasePoint_forms hslots f g] at h
  exact h

end ActualOrbitCertificate

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0032

section TAF_LiteralSource_0033
/- Original module: PaperVerification.AlternatingFormsEvenSingletonIndex -/


/-!
# The exact indexing of singleton and pair states

A selected exterior monomial records two subsets, one in each half of the
paired basis.  Its singly occupied pairs form two disjoint sets; the doubly
occupied pairs form a subset of their complement.  The equivalence below
retains every monomial, and its degree identity retains the original exterior
degree.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.EvenSingletons

variable {ι : Type*} [DecidableEq ι]

abbrev SingletonState (ι : Type*) :=
  {AB : Finset ι × Finset ι // Disjoint AB.1 AB.2}

abbrev Available (S : SingletonState ι) := {i : ι // i ∉ S.val.1 ∪ S.val.2}

abbrev PairedState (ι : Type*) [DecidableEq ι] :=
  (S : SingletonState ι) × Finset (Available S)

instance [Fintype ι] : Fintype (SingletonState ι) := Fintype.ofFinite _
instance [Fintype ι] : Fintype (PairedState ι) := Fintype.ofFinite _

def pairSupport (S : SingletonState ι) (P : Finset (Available S)) : Finset ι :=
  P.map (Function.Embedding.subtype _)

theorem pairSupport_not_mem (S : SingletonState ι) (P : Finset (Available S))
    {i : ι} (hi : i ∈ pairSupport S P) : i ∉ S.val.1 ∪ S.val.2 :=
  P.property_of_mem_map_subtype hi

theorem pairSupport_disjoint_left (S : SingletonState ι) (P : Finset (Available S)) :
    Disjoint S.val.1 (pairSupport S P) := by
  apply Finset.disjoint_left.mpr
  intro i hi hP
  exact pairSupport_not_mem S P hP (Finset.mem_union_left _ hi)

theorem pairSupport_disjoint_right (S : SingletonState ι) (P : Finset (Available S)) :
    Disjoint S.val.2 (pairSupport S P) := by
  apply Finset.disjoint_left.mpr
  intro i hi hP
  exact pairSupport_not_mem S P hP (Finset.mem_union_right _ hi)

def selection (T : PairedState ι) : Finset ι × Finset ι :=
  (T.1.val.1 ∪ pairSupport T.1 T.2, T.1.val.2 ∪ pairSupport T.1 T.2)

theorem selection_sdiff_left (T : PairedState ι) :
    (selection T).1 \ (selection T).2 = T.1.val.1 := by
  ext i
  simp only [selection, Finset.mem_sdiff, Finset.mem_union]
  constructor
  · rintro ⟨hA | hP, hn⟩
    · exact hA
    · exact False.elim (hn (Or.inr hP))
  · intro hA
    refine ⟨Or.inl hA, ?_⟩
    rintro (hB | hP)
    · exact Finset.disjoint_left.mp T.1.property hA hB
    · exact Finset.disjoint_left.mp (pairSupport_disjoint_left T.1 T.2) hA hP

theorem selection_sdiff_right (T : PairedState ι) :
    (selection T).2 \ (selection T).1 = T.1.val.2 := by
  ext i
  simp only [selection, Finset.mem_sdiff, Finset.mem_union]
  constructor
  · rintro ⟨hB | hP, hn⟩
    · exact hB
    · exact False.elim (hn (Or.inr hP))
  · intro hB
    refine ⟨Or.inl hB, ?_⟩
    rintro (hA | hP)
    · exact Finset.disjoint_left.mp T.1.property hA hB
    · exact Finset.disjoint_left.mp (pairSupport_disjoint_right T.1 T.2) hB hP

theorem selection_inter (T : PairedState ι) :
    (selection T).1 ∩ (selection T).2 = pairSupport T.1 T.2 := by
  ext i
  simp only [selection, Finset.mem_inter, Finset.mem_union]
  constructor
  · rintro ⟨hA | hP, hB | hP'⟩
    · exact False.elim (Finset.disjoint_left.mp T.1.property hA hB)
    · exact hP'
    · exact hP
    · exact hP
  · intro hP
    exact ⟨Or.inr hP, Or.inr hP⟩

theorem selection_injective : Function.Injective (selection (ι := ι)) := by
  rintro ⟨S, P⟩ ⟨T, Q⟩ h
  have hS : S = T := by
    apply Subtype.ext
    apply Prod.ext
    · simpa only [selection_sdiff_left] using
        congrArg (fun AB : Finset ι × Finset ι => AB.1 \ AB.2) h
    · simpa only [selection_sdiff_right] using
        congrArg (fun AB : Finset ι × Finset ι => AB.2 \ AB.1) h
  subst T
  have hP : pairSupport S P = pairSupport S Q := by
    simpa only [selection_inter] using
      congrArg (fun AB : Finset ι × Finset ι => AB.1 ∩ AB.2) h
  have he : P = Q := Finset.map_injective (Function.Embedding.subtype _) hP
  subst Q
  rfl

theorem selection_surjective : Function.Surjective (selection (ι := ι)) := by
  rintro ⟨A, B⟩
  have hdisjoint : Disjoint (A \ B) (B \ A) := by
    apply Finset.disjoint_left.mpr
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_sdiff.mp hj).1
  let S : SingletonState ι := ⟨(A \ B, B \ A), hdisjoint⟩
  have hAvail : ∀ i ∈ A ∩ B, i ∉ S.val.1 ∪ S.val.2 := by
    intro i hi hs
    obtain ⟨hA, hB⟩ := Finset.mem_inter.mp hi
    rcases Finset.mem_union.mp hs with hs | hs
    · exact (Finset.mem_sdiff.mp hs).2 hB
    · exact (Finset.mem_sdiff.mp hs).2 hA
  let P : Finset (Available S) := (A ∩ B).subtype (fun i => i ∉ S.val.1 ∪ S.val.2)
  have hP : pairSupport S P = A ∩ B := Finset.subtype_map_of_mem hAvail
  refine ⟨⟨S, P⟩, ?_⟩
  apply Prod.ext
  · change (A \ B) ∪ pairSupport S P = A
    rw [hP]
    ext i
    by_cases hA : i ∈ A <;> by_cases hB : i ∈ B <;> simp [hA, hB]
  · change (B \ A) ∪ pairSupport S P = B
    rw [hP]
    ext i
    by_cases hA : i ∈ A <;> by_cases hB : i ∈ B <;> simp [hA, hB]

def selectionEquiv : PairedState ι ≃ Finset ι × Finset ι :=
  Equiv.ofBijective selection ⟨selection_injective, selection_surjective⟩

def supportEquiv : PairedState ι ≃ Finset (ι ⊕ ι) :=
  selectionEquiv.trans Finset.sumEquiv.toEquiv.symm

@[simp] theorem supportEquiv_apply (T : PairedState ι) :
    supportEquiv T = (selection T).1.disjSum (selection T).2 := rfl

def singletonDegree (S : SingletonState ι) : ℕ := S.val.1.card + S.val.2.card

def degree (T : PairedState ι) : ℕ := singletonDegree T.1 + 2 * T.2.card

theorem support_card (T : PairedState ι) : (supportEquiv T).card = degree T := by
  rw [supportEquiv_apply, Finset.card_disjSum]
  change (T.1.val.1 ∪ pairSupport T.1 T.2).card +
    (T.1.val.2 ∪ pairSupport T.1 T.2).card = _
  rw [Finset.card_union_of_disjoint (pairSupport_disjoint_left T.1 T.2),
    Finset.card_union_of_disjoint (pairSupport_disjoint_right T.1 T.2)]
  simp only [pairSupport, Finset.card_map, degree, singletonDegree]
  omega

abbrev DegreeState (ι : Type*) [DecidableEq ι] (s : ℕ) :=
  {T : PairedState ι // degree T = s}

instance [Fintype ι] (s : ℕ) : Fintype (DegreeState ι s) := Fintype.ofFinite _

def degreeSupportEquiv (s : ℕ) : DegreeState ι s ≃ Set.powersetCard (ι ⊕ ι) s where
  toFun T := ⟨supportEquiv T.val, (support_card T.val).trans T.property⟩
  invFun S := ⟨supportEquiv.symm S.val, by
    rw [← support_card, Equiv.apply_symm_apply]
    exact S.property⟩
  left_inv T := by apply Subtype.ext; exact Equiv.symm_apply_apply _ _
  right_inv S := by apply Subtype.ext; exact Equiv.apply_symm_apply _ _

end PaperVerification.AlternatingForms.EvenSingletons
end
