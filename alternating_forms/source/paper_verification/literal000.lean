/-!
# Polynomial rank certificates from a dominant parametrization

This file contains general algebraic lemmas used to pass from an explicit pencil orbit
to a nonempty principal open set on which all relevant relation matrices have constant rank.
The orbit Jacobian and rank invariance must be proved by the application.
-/

@[expose] public section
noncomputable section

open scoped BigOperators

namespace PaperVerification.AlternatingForms

open MvPolynomial Matrix

variable {K σ ι : Type*}

/-- A polynomial over an infinite domain that vanishes where a fixed nonzero polynomial
does not vanish is zero. -/
theorem polynomial_eq_zero_of_principal_open_vanish
    [CommRing K] [IsDomain K] [Infinite K]
    {g q : MvPolynomial σ K} (hg : g ≠ 0)
    (hq : ∀ x : σ → K, eval x g ≠ 0 → eval x q = 0) : q = 0 := by
  have hmul : g * q = 0 := by
    apply MvPolynomial.funext
    intro x
    simp only [map_mul, map_zero]
    by_cases hx : eval x g = 0
    · rw [hx, zero_mul]
    · rw [hq x hx, mul_zero]
  exact (mul_eq_zero.mp hmul).resolve_left hg

/-- A polynomial vanishing on a principal open subset of a parametrized image is zero,
provided the parametrization has a surjective Jacobian at one point. -/
theorem polynomial_eq_zero_of_dominant_open_vanish
    [CommRing K] [IsDomain K] [Infinite K] [Fintype σ] [Finite ι]
    {p : ι → MvPolynomial σ K} {v : σ → K}
    (hJ : (TauCeti.jacobiMatrixAt p v).mulVec.Surjective)
    {g : MvPolynomial σ K} (hg : g ≠ 0)
    {q : MvPolynomial ι K}
    (hq : ∀ x : σ → K, eval x g ≠ 0 →
      eval (fun i ↦ eval x (p i)) q = 0) : q = 0 := by
  apply AlgebraicIndependent.eq_zero_of_aeval_eq_zero
    (TauCeti.algebraicIndependent_of_mulVec_surjective_jacobiMatrixAt hJ) q
  apply polynomial_eq_zero_of_principal_open_vanish hg
  intro x hx
  rw [aeval_eq_bind₁, ← hq x hx]
  simpa only [aeval_eq_eval] using aeval_bind₁ x p q

section Matrices

variable [Field K] {m n : Type*} [Finite m] [Fintype n]

/-- Evaluating the polynomial minor is the minor of the evaluated matrix. -/
theorem polynomialMatrix_eval_minor
    (M : Matrix m n (MvPolynomial ι K)) (x : ι → K)
    {d : ℕ} (r : Fin d ↪ m) (c : Fin d ↪ n) :
    eval x (M.submatrix r c).det = ((M.map (eval x)).submatrix r c).det := by
  simpa only [Matrix.submatrix_map, RingHom.mapMatrix_apply] using
    RingHom.map_det (eval x) (M.submatrix r c)

/-- A rank upper bound on the image of a dominant parametrization, away from the
zero locus of a nonzero parameter polynomial, holds for every coefficient point. -/
theorem polynomialMatrix_rank_le_of_dominant_open
    [Infinite K] [Fintype σ] [Finite ι]
    (M : Matrix m n (MvPolynomial ι K))
    {p : ι → MvPolynomial σ K} {v : σ → K}
    (hJ : (TauCeti.jacobiMatrixAt p v).mulVec.Surjective)
    {g : MvPolynomial σ K} (hg : g ≠ 0) {r : ℕ}
    (hbound : ∀ x : σ → K, eval x g ≠ 0 →
      (M.map (eval (fun i ↦ eval x (p i)))).rank ≤ r) :
    ∀ y : ι → K, (M.map (eval y)).rank ≤ r := by
  intro y
  apply Matrix.rank_le_iff_forall_det_submatrix_eq_zero.mpr
  intro rows cols
  have hminor : (M.submatrix rows cols).det = 0 := by
    apply polynomial_eq_zero_of_dominant_open_vanish hJ hg
    intro x hx
    rw [polynomialMatrix_eval_minor]
    exact Matrix.rank_le_iff_forall_det_submatrix_eq_zero.mp (hbound x hx) rows cols
  rw [← polynomialMatrix_eval_minor, hminor, map_zero]

/-- A maximal minor at a specified point gives an explicit principal open set
on which the rank is at least its value at that point. -/
theorem polynomialMatrix_exists_rank_lower_certificate
    (M : Matrix m n (MvPolynomial ι K)) (base : ι → K) :
    ∃ q : MvPolynomial ι K, eval base q ≠ 0 ∧
      ∀ y : ι → K, eval y q ≠ 0 →
        (M.map (eval base)).rank ≤ (M.map (eval y)).rank := by
  obtain ⟨rows, cols, hminor⟩ :=
    Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mp
      (le_refl (M.map (eval base)).rank)
  refine ⟨(M.submatrix rows cols).det, ?_, ?_⟩
  · rw [polynomialMatrix_eval_minor]
    exact hminor
  · intro y hy
    apply Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mpr
    refine ⟨rows, cols, ?_⟩
    rwa [← polynomialMatrix_eval_minor]

/-- Constant rank on a principal open subset of a dominant parametrized image yields
a nonempty principal open subset of the full coefficient space with that exact rank.
The witness polynomial is a maximal minor at the specified base point. -/
theorem polynomialMatrix_generic_rank_from_orbit
    [Infinite K] [Fintype σ] [Finite ι]
    (M : Matrix m n (MvPolynomial ι K))
    {p : ι → MvPolynomial σ K} {v : σ → K}
    (hJ : (TauCeti.jacobiMatrixAt p v).mulVec.Surjective)
    {g : MvPolynomial σ K} (hg : g ≠ 0) (base : ι → K)
    (horbit : ∀ x : σ → K, eval x g ≠ 0 →
      (M.map (eval (fun i ↦ eval x (p i)))).rank = (M.map (eval base)).rank) :
    ∃ q : MvPolynomial ι K, eval base q ≠ 0 ∧
      ∀ y : ι → K, eval y q ≠ 0 →
        (M.map (eval y)).rank = (M.map (eval base)).rank := by
  obtain ⟨q, hbase, hlower⟩ := polynomialMatrix_exists_rank_lower_certificate M base
  refine ⟨q, hbase, fun y hy ↦ le_antisymm ?_ (hlower y hy)⟩
  exact polynomialMatrix_rank_le_of_dominant_open M hJ hg
    (fun x hx ↦ (horbit x hx).le) y

end Matrices

/-- A finite list of principal open certificates can be made simultaneous by
multiplying their witness polynomials. Nonemptiness is retained at the given point. -/
theorem exists_simultaneous_principal_certificate
    [CommRing K] [IsDomain K] {δ : Type*} [Fintype δ]
    (base : ι → K) (P : δ → (ι → K) → Prop)
    (h : ∀ d : δ, ∃ q : MvPolynomial ι K, eval base q ≠ 0 ∧
      ∀ y : ι → K, eval y q ≠ 0 → P d y) :
    ∃ q : MvPolynomial ι K, eval base q ≠ 0 ∧
      ∀ y : ι → K, eval y q ≠ 0 → ∀ d : δ, P d y := by
  classical
  choose q hbase hcert using h
  refine ⟨∏ d, q d, ?_, ?_⟩
  · simpa only [map_prod, Finset.prod_ne_zero_iff, Finset.mem_univ,
      true_implies] using hbase
  · intro y hy d
    apply hcert d y
    have hy' : ∀ d : δ, eval y (q d) ≠ 0 := by
      simpa only [map_prod, Finset.prod_ne_zero_iff, Finset.mem_univ,
        true_implies] using hy
    exact hy' d

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0021

section TAF_LiteralSource_0022
/- Original module: PaperVerification.AlternatingFormsOrbitPolynomial -/


/-!
# Polynomial coordinates of simultaneous congruence

The variables are all entries of a change-of-basis matrix. Each polynomial below is
a literal entry of Xᵀ A X. The Jacobian at the identity is computed using dual-number
evaluation, with no appeal to an orbit classification theorem.
-/

@[expose] public section
noncomputable section

open scoped BigOperators

namespace PaperVerification.AlternatingForms

open MvPolynomial Matrix

variable {K ν ι : Type*} [CommRing K] [Fintype ν] [DecidableEq ν]

/-- Independent variables arranged as a square matrix. -/
def orbitUniversalMatrix : Matrix ν ν (MvPolynomial (ν × ν) K) :=
  Matrix.of fun i j ↦ X (i, j)

/-- The coefficient point corresponding to the identity matrix. -/
def orbitIdentityPoint : (ν × ν) → K :=
  fun z ↦ (1 : Matrix ν ν K) z.1 z.2

/-- A literal entry of the simultaneous congruence action. -/
def orbitCongruenceCoordinate (A : Matrix ν ν K) (u v : ν) :
    MvPolynomial (ν × ν) K :=
  ∑ i, ∑ j, C (A i j) * X (i, u) * X (j, v)

/-- A selected family of entries of one or more congruence transforms.
The matrix and selected row and column may depend on the output coordinate. -/
def orbitCongruenceFamily (A : ι → Matrix ν ν K) (row col : ι → ν) :
    ι → MvPolynomial (ν × ν) K :=
  fun i ↦ orbitCongruenceCoordinate (A i) (row i) (col i)

theorem orbitCongruenceCoordinate_eval (A : Matrix ν ν K) (u v : ν)
    (x : (ν × ν) → K) :
    eval x (orbitCongruenceCoordinate A u v) =
      ((Matrix.of fun i j ↦ x (i, j)).transpose * A *
        (Matrix.of fun i j ↦ x (i, j))) u v := by
  simp only [orbitCongruenceCoordinate, map_sum, map_mul, eval_C, eval_X,
    Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro i _
  ring

@[simp]
theorem orbitCongruenceCoordinate_identity (A : Matrix ν ν K) (u v : ν) :
    eval (orbitIdentityPoint (K := K) (ν := ν))
      (orbitCongruenceCoordinate A u v) = A u v := by
  rw [orbitCongruenceCoordinate_eval]
  have h : (Matrix.of fun i j ↦ orbitIdentityPoint (K := K) (ν := ν) (i, j)) =
      (1 : Matrix ν ν K) := rfl
  rw [h, Matrix.transpose_one, one_mul, mul_one]

/-- The differential of simultaneous congruence at the identity, in selected entries. -/
def orbitCongruenceDifferential (A : ι → Matrix ν ν K) (row col : ι → ν) :
    ((ν × ν) → K) →ₗ[K] (ι → K) where
  toFun H := fun i ↦
    ((Matrix.of fun r c ↦ H (r, c)).transpose * A i +
      A i * (Matrix.of fun r c ↦ H (r, c))) (row i) (col i)
  map_add' H G := by
    funext i
    simp only [Pi.add_apply, Matrix.of_apply, Matrix.add_apply, Matrix.mul_apply,
      Matrix.transpose_apply, add_mul, mul_add, Finset.sum_add_distrib]
    ring
  map_smul' a H := by
    funext i
    simp only [Pi.smul_apply, smul_eq_mul, Matrix.of_apply, Matrix.add_apply,
      Matrix.mul_apply, Matrix.transpose_apply, RingHom.id_apply]
    rw [mul_add, Finset.mul_sum, Finset.mul_sum]
    congr 1
    · apply Finset.sum_congr rfl
      intro j _
      ring
    · apply Finset.sum_congr rfl
      intro j _
      ring

/-- The Jacobian of the actual polynomial congruence family at the identity equals
the usual differential H ↦ Hᵀ A + A H. -/
theorem orbitCongruenceFamily_jacobian (A : ι → Matrix ν ν K) (row col : ι → ν)
    (H : (ν × ν) → K) :
    TauCeti.jacobiMatrixAt (orbitCongruenceFamily A row col)
        (orbitIdentityPoint (K := K) (ν := ν)) *ᵥ H =
      orbitCongruenceDifferential A row col H := by
  funext z
  rw [TauCeti.jacobiMatrixAt_mulVec_apply_eq_snd_aeval]
  simp only [orbitCongruenceFamily, orbitCongruenceCoordinate, map_sum, map_mul,
    aeval_C, aeval_X, TrivSqZeroExt.algebraMap_eq_inl,
    TrivSqZeroExt.snd_sum, DualNumber.snd_mul, TrivSqZeroExt.fst_mul,
    TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add, TrivSqZeroExt.fst_inl,
    TrivSqZeroExt.snd_inl, TrivSqZeroExt.fst_inr, TrivSqZeroExt.snd_inr,
    add_zero, zero_add, zero_mul, mul_zero]
  simp only [orbitIdentityPoint, Matrix.one_apply, mul_ite, ite_mul,
    mul_one, one_mul, mul_zero, zero_mul, Finset.sum_add_distrib,
    Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.sum_ite_eq,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  simp [orbitCongruenceDifferential, Matrix.mul_apply, Matrix.transpose_apply,
    Matrix.add_apply, Matrix.of_apply, mul_comm, add_comm]

theorem orbitCongruenceFamily_jacobian_surjective
    (A : ι → Matrix ν ν K) (row col : ι → ν)
    (h : Function.Surjective (orbitCongruenceDifferential A row col)) :
    (TauCeti.jacobiMatrixAt (orbitCongruenceFamily A row col)
      (orbitIdentityPoint (K := K) (ν := ν))).mulVec.Surjective := by
  intro y
  obtain ⟨H, hH⟩ := h y
  refine ⟨H, ?_⟩
  rw [orbitCongruenceFamily_jacobian, hH]

/-- The polynomial whose nonvanishing says that the parameter matrix is invertible. -/
def orbitDeterminant : MvPolynomial (ν × ν) K :=
  (orbitUniversalMatrix (K := K) (ν := ν)).det

theorem orbitDeterminant_eval (x : (ν × ν) → K) :
    eval x (orbitDeterminant (K := K) (ν := ν)) =
      (Matrix.of fun i j ↦ x (i, j)).det := by
  rw [orbitDeterminant, RingHom.map_det]
  congr 1
  ext i j
  simp [orbitUniversalMatrix]

@[simp]
theorem orbitDeterminant_identity :
    eval (orbitIdentityPoint (K := K) (ν := ν))
      (orbitDeterminant (K := K) (ν := ν)) = 1 := by
  rw [orbitDeterminant_eval]
  change (1 : Matrix ν ν K).det = 1
  exact Matrix.det_one

theorem orbitDeterminant_ne_zero [Nontrivial K] :
    orbitDeterminant (K := K) (ν := ν) ≠ 0 := by
  intro h
  have h' := orbitDeterminant_identity (K := K) (ν := ν)
  rw [h, map_zero] at h'
  exact zero_ne_one h'

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0022

section TAF_LiteralSource_0023
/- Original module: PaperVerification.AlternatingFormsOrbitCanonical -/


/-!
# Dominance of the canonical odd alternating pencil

For V = K^(t+1) ⊕ K^(t+2), the two canonical alternating matrices have off-diagonal
incidence blocks for the embeddings i ↦ i+1 and i ↦ i. Their simultaneous congruence
map has a surjective Jacobian at the identity. The proof uses the explicit block
solutions, not a classification theorem.
-/

@[expose] public section
noncomputable section

namespace PaperVerification.AlternatingForms

open Matrix MvPolynomial
open scoped BigOperators Matrix

variable {K : Type*} [Field K]

abbrev OddOrbitMode (t : ℕ) := Fin (t + 1) ⊕ Fin (t + 2)
abbrev OddOrbitSlot (t : ℕ) :=
  Orbit.StrictPair (t + 1) ⊕
    (Orbit.StrictPair (t + 2) ⊕ (Fin (t + 1) × Fin (t + 2)))
abbrev OddOrbitPairSlot (t : ℕ) := Bool × OddOrbitSlot t

def oddOrbitSlotRow (t : ℕ) : OddOrbitSlot t → OddOrbitMode t
  | Sum.inl p => Sum.inl p.val.1
  | Sum.inr (Sum.inl p) => Sum.inr p.val.1
  | Sum.inr (Sum.inr p) => Sum.inl p.1

def oddOrbitSlotCol (t : ℕ) : OddOrbitSlot t → OddOrbitMode t
  | Sum.inl p => Sum.inl p.val.2
  | Sum.inr (Sum.inl p) => Sum.inr p.val.2
  | Sum.inr (Sum.inr p) => Sum.inr p.2

def orbitIncidence {a b : ℕ} (e : Fin a → Fin b) : Matrix (Fin a) (Fin b) K :=
  Matrix.of fun i j ↦ if j = e i then 1 else 0

def orbitSkewIncidence {a b : ℕ} (e : Fin a → Fin b) :
    Matrix (Fin a ⊕ Fin b) (Fin a ⊕ Fin b) K :=
  Matrix.fromBlocks 0 (orbitIncidence e) (-(orbitIncidence e).transpose) 0

def oddOrbitMatrices (t : ℕ) (z : OddOrbitPairSlot t) :
    Matrix (OddOrbitMode t) (OddOrbitMode t) K :=
  if z.1 then orbitSkewIncidence (K := K) Fin.castSucc else orbitSkewIncidence (K := K) Fin.succ

def oddOrbitPolynomials (t : ℕ) :
    OddOrbitPairSlot t → MvPolynomial (OddOrbitMode t × OddOrbitMode t) K :=
  orbitCongruenceFamily (oddOrbitMatrices t)
    (fun z ↦ oddOrbitSlotRow t z.2) (fun z ↦ oddOrbitSlotCol t z.2)

/-- Rearrange the independent coefficients of the two alternating matrices into
the AA, BB and AB blocks. -/
def oddOrbitCoefficientBlocks (t : ℕ) (y : OddOrbitPairSlot t → K) :
    OddOrbitBlockOutput K t :=
  (Sum.elim (fun p ↦ y (false, Sum.inl p)) (fun p ↦ y (true, Sum.inl p)),
   (Sum.elim (fun p ↦ y (false, Sum.inr (Sum.inl p)))
      (fun p ↦ y (true, Sum.inr (Sum.inl p))),
    (Matrix.of fun i j ↦ y (false, Sum.inr (Sum.inr (i, j))),
     Matrix.of fun i j ↦ y (true, Sum.inr (Sum.inr (i, j))))))

theorem oddOrbitCoefficientBlocks_injective (t : ℕ) :
    Function.Injective (oddOrbitCoefficientBlocks (K := K) t) := by
  intro y z h
  funext w
  rcases w with ⟨b, p⟩
  cases p with
  | inl p =>
    cases b
    · exact congrFun (congrArg Prod.fst h) (Sum.inl p)
    · exact congrFun (congrArg Prod.fst h) (Sum.inr p)
  | inr p =>
    cases p with
    | inl p =>
      cases b
      · exact congrFun (congrArg (fun a ↦ a.2.1) h) (Sum.inl p)
      · exact congrFun (congrArg (fun a ↦ a.2.1) h) (Sum.inr p)
    | inr p =>
      cases b
      · exact congrFun (congrFun (congrArg (fun a ↦ a.2.2.1) h) p.1) p.2
      · exact congrFun (congrFun (congrArg (fun a ↦ a.2.2.2) h) p.1) p.2

section BlockCalculation

variable {a b : ℕ}
  (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin a) (Fin b) K)
  (R : Matrix (Fin b) (Fin a) K) (S : Matrix (Fin b) (Fin b) K)
  (e : Fin a → Fin b)

theorem orbitSkewIncidence_differential_AA (i j : Fin a) :
    ((Matrix.fromBlocks P Q R S).transpose * orbitSkewIncidence (K := K) e +
      orbitSkewIncidence (K := K) e * Matrix.fromBlocks P Q R S) (Sum.inl i) (Sum.inl j) =
      R (e i) j - R (e j) i := by
  simp [orbitSkewIncidence, orbitIncidence, Matrix.mul_apply, Matrix.transpose_apply,
    Fintype.sum_sum_type, mul_ite, ite_mul, sub_eq_add_neg, add_comm]

theorem orbitSkewIncidence_differential_BB (i j : Fin b) :
    ((Matrix.fromBlocks P Q R S).transpose * orbitSkewIncidence (K := K) e +
      orbitSkewIncidence (K := K) e * Matrix.fromBlocks P Q R S) (Sum.inr i) (Sum.inr j) =
      (∑ a, if j = e a then Q a i else 0) -
        (∑ a, if i = e a then Q a j else 0) := by
  simp [orbitSkewIncidence, orbitIncidence, Matrix.mul_apply, Matrix.transpose_apply,
    Fintype.sum_sum_type, mul_ite, ite_mul, Finset.sum_neg_distrib, sub_eq_add_neg]

theorem orbitSkewIncidence_differential_AB (i : Fin a) (j : Fin b) :
    ((Matrix.fromBlocks P Q R S).transpose * orbitSkewIncidence (K := K) e +
      orbitSkewIncidence (K := K) e * Matrix.fromBlocks P Q R S) (Sum.inl i) (Sum.inr j) =
      (∑ a, if j = e a then P a i else 0) + S (e i) j := by
  simp [orbitSkewIncidence, orbitIncidence, Matrix.mul_apply, Matrix.transpose_apply,
    Fintype.sum_sum_type, mul_ite, ite_mul]

end BlockCalculation

theorem sum_succ_eq_rectPad {k : ℕ}
    (Q : Matrix (Fin k) (Fin (k + 1)) K) (i j : Fin (k + 1)) :
    (∑ a, if i = a.succ then Q a j else 0) = Orbit.rectPad Q i.val j := by
  refine Fin.cases ?_ (fun a ↦ ?_) i
  · simp [eq_comm, Fin.succ_ne_zero]
  · simp [Fin.succ_inj]

theorem sum_castSucc_eq_rectPad {k : ℕ}
    (Q : Matrix (Fin k) (Fin (k + 1)) K) (i j : Fin (k + 1)) :
    (∑ a, if i = a.castSucc then Q a j else 0) = Orbit.rectPad Q (i.val + 1) j := by
  refine Fin.lastCases ?_ (fun a ↦ ?_) i
  · have hne (a : Fin k) : (Fin.last k : Fin (k + 1)) ≠ a.castSucc := by
      intro h
      have hv := congrArg Fin.val h
      have ha := a.isLt
      simp only [Fin.val_last, Fin.val_castSucc] at hv
      omega
    simp [hne]
  · simp [Fin.castSucc_inj]

theorem orbitSquarePad_succ_fin {t : ℕ}
    (P : Matrix (Fin (t + 1)) (Fin (t + 1)) K) (i j : Fin (t + 1)) :
    orbitSquarePad P (i.val + 1) j.val = P i j := by
  have hi : 0 < i.val + 1 := by omega
  have hi' : i.val + 1 ≤ t + 1 := by have := i.isLt; omega
  have hj : j.val ≤ t := by have := j.isLt; omega
  simp [orbitSquarePad, hi, hi', hj]

theorem sum_succ_eq_squarePad {t : ℕ}
    (P : Matrix (Fin (t + 1)) (Fin (t + 1)) K)
    (i : Fin (t + 2)) (j : Fin (t + 1)) :
    (∑ a, if i = a.succ then P a j else 0) = orbitSquarePad P i.val j.val := by
  refine Fin.cases ?_ (fun a ↦ ?_) i
  · simp [orbitSquarePad, eq_comm, Fin.succ_ne_zero]
  · simp [Fin.succ_inj, orbitSquarePad_succ_fin]

theorem sum_castSucc_eq_squarePad {t : ℕ}
    (P : Matrix (Fin (t + 1)) (Fin (t + 1)) K)
    (i : Fin (t + 2)) (j : Fin (t + 1)) :
    (∑ a, if i = a.castSucc then P a j else 0) =
      orbitSquarePad P (i.val + 1) j.val := by
  refine Fin.lastCases ?_ (fun a ↦ ?_) i
  · have hne (a : Fin (t + 1)) :
        (Fin.last (t + 1) : Fin (t + 2)) ≠ a.castSucc := by
      intro h
      have hv := congrArg Fin.val h
      have ha := a.isLt
      simp only [Fin.val_last, Fin.val_castSucc] at hv
      omega
    simp [hne, orbitSquarePad]
  · simp [Fin.castSucc_inj, orbitSquarePad_succ_fin]

/-- The previously solved blocks are the blocks of the actual congruence differential. -/
theorem oddOrbitDifferential_blocks (t : ℕ) (H : OddOrbitBlockInput K t) :
    oddOrbitCoefficientBlocks t
      (orbitCongruenceDifferential (oddOrbitMatrices t)
        (fun z ↦ oddOrbitSlotRow t z.2) (fun z ↦ oddOrbitSlotCol t z.2)
        (fun z ↦ oddOrbitBlockMatrix t H z.1 z.2)) =
      oddOrbitBlockMap t H := by
  apply Prod.ext
  · funext z
    cases z with
    | inl p =>
      change ((oddOrbitBlockMatrix t H).transpose * orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.succ +
        orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.succ * oddOrbitBlockMatrix t H)
          (Sum.inl p.val.1) (Sum.inl p.val.2) = _
      exact orbitSkewIncidence_differential_AA H.1.1 H.2.1 H.2.2 H.1.2
        Fin.succ p.val.1 p.val.2
    | inr p =>
      change ((oddOrbitBlockMatrix t H).transpose * orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.castSucc +
        orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.castSucc * oddOrbitBlockMatrix t H)
          (Sum.inl p.val.1) (Sum.inl p.val.2) = _
      exact orbitSkewIncidence_differential_AA H.1.1 H.2.1 H.2.2 H.1.2
        Fin.castSucc p.val.1 p.val.2
  · apply Prod.ext
    · funext z
      cases z with
      | inl p =>
        change ((oddOrbitBlockMatrix t H).transpose * orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.succ +
          orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.succ * oddOrbitBlockMatrix t H)
            (Sum.inr p.val.1) (Sum.inr p.val.2) =
          -(Orbit.rectPad H.2.1 p.val.1.val p.val.2 -
            Orbit.rectPad H.2.1 p.val.2.val p.val.1)
        rw [oddOrbitBlockMatrix, orbitSkewIncidence_differential_BB,
          sum_succ_eq_rectPad, sum_succ_eq_rectPad]
        ring
      | inr p =>
        change ((oddOrbitBlockMatrix t H).transpose * orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.castSucc +
          orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.castSucc * oddOrbitBlockMatrix t H)
            (Sum.inr p.val.1) (Sum.inr p.val.2) =
          -(Orbit.rectPad H.2.1 (p.val.1.val + 1) p.val.2 -
            Orbit.rectPad H.2.1 (p.val.2.val + 1) p.val.1)
        rw [oddOrbitBlockMatrix, orbitSkewIncidence_differential_BB,
          sum_castSucc_eq_rectPad, sum_castSucc_eq_rectPad]
        ring
    · apply Prod.ext
      · ext i j
        change ((oddOrbitBlockMatrix t H).transpose * orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.succ +
          orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.succ * oddOrbitBlockMatrix t H)
            (Sum.inl i) (Sum.inr j) =
          orbitSquarePad H.1.1 j.val i.val + H.1.2 i.succ j
        rw [oddOrbitBlockMatrix, orbitSkewIncidence_differential_AB,
          sum_succ_eq_squarePad]
      · ext i j
        change ((oddOrbitBlockMatrix t H).transpose * orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.castSucc +
          orbitSkewIncidence (K := K) (a := t+1) (b := t+2) Fin.castSucc * oddOrbitBlockMatrix t H)
            (Sum.inl i) (Sum.inr j) =
          orbitSquarePad H.1.1 (j.val + 1) i.val + H.1.2 i.castSucc j
        rw [oddOrbitBlockMatrix, orbitSkewIncidence_differential_AB,
          sum_castSucc_eq_squarePad]

/-- The canonical odd pencil has a surjective differential at the identity. -/
theorem oddOrbit_jacobian_surjective (t : ℕ) :
    (TauCeti.jacobiMatrixAt (oddOrbitPolynomials (K := K) t)
      (orbitIdentityPoint (K := K) (ν := OddOrbitMode t))).mulVec.Surjective := by
  intro y
  obtain ⟨H, hH⟩ := oddOrbitBlockMap_surjective (K := K) t (oddOrbitCoefficientBlocks t y)
  refine ⟨fun z ↦ oddOrbitBlockMatrix t H z.1 z.2, ?_⟩
  change TauCeti.jacobiMatrixAt
    (orbitCongruenceFamily (oddOrbitMatrices t)
      (fun z ↦ oddOrbitSlotRow t z.2) (fun z ↦ oddOrbitSlotCol t z.2))
    (orbitIdentityPoint (K := K) (ν := OddOrbitMode t)) *ᵥ
      (fun z ↦ oddOrbitBlockMatrix t H z.1 z.2) = y
  rw [orbitCongruenceFamily_jacobian]
  apply oddOrbitCoefficientBlocks_injective t
  rw [oddOrbitDifferential_blocks, hH]

theorem oddOrbit_algebraicIndependent (t : ℕ) :
    AlgebraicIndependent K (oddOrbitPolynomials (K := K) t) :=
  TauCeti.algebraicIndependent_of_mulVec_surjective_jacobiMatrixAt
    (oddOrbit_jacobian_surjective t)

/-- The invertible changes of basis already have polynomially dense image. -/
theorem oddOrbit_polynomial_eq_zero_of_vanish [Infinite K] (t : ℕ)
    {q : MvPolynomial (OddOrbitPairSlot t) K}
    (hq : ∀ X : (OddOrbitMode t × OddOrbitMode t) → K,
      eval X (orbitDeterminant (K := K) (ν := OddOrbitMode t)) ≠ 0 →
        eval (fun i ↦ eval X (oddOrbitPolynomials (K := K) t i)) q = 0) :
    q = 0 :=
  polynomial_eq_zero_of_dominant_open_vanish
    (oddOrbit_jacobian_surjective t) (orbitDeterminant_ne_zero (K := K)) hq

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0023

section TAF_LiteralSource_0024
/- Original module: PaperVerification.AlternatingFormsEvenOrbitBlocks -/


/-!
# Solving the differential of a generic even alternating pencil

The canonical pair consists of symplectic 2 by 2 blocks with coefficients 1 and λᵢ.
Changing both the basis and the λᵢ gives a surjective differential when the λᵢ are
pairwise distinct. The off-diagonal blocks are solved by a two-equation linear system.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

namespace PaperVerification.AlternatingForms

open Matrix
open scoped BigOperators

variable {K : Type*} [Field K]

def evenOrbitJ : Matrix (Fin 2) (Fin 2) K := !![0, 1; -1, 0]

theorem evenOrbitJ_transpose : (evenOrbitJ (K := K)).transpose = -evenOrbitJ := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [evenOrbitJ]

theorem evenOrbitJ_square : evenOrbitJ (K := K) * evenOrbitJ = -1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [evenOrbitJ, Matrix.mul_apply, Fin.sum_univ_two]

theorem evenOrbitJ_upper_cancel (V : Matrix (Fin 2) (Fin 2) K) :
    evenOrbitJ * (-evenOrbitJ * V) = V := by
  rw [← mul_assoc, mul_neg, evenOrbitJ_square, neg_neg, one_mul]

theorem evenOrbitJ_lower_cancel (U : Matrix (Fin 2) (Fin 2) K) :
    (evenOrbitJ * U.transpose).transpose * evenOrbitJ = U := by
  rw [Matrix.transpose_mul, Matrix.transpose_transpose, evenOrbitJ_transpose,
    mul_assoc, neg_mul, evenOrbitJ_square, neg_neg, mul_one]

def evenOrbitSolveU (a b : K) (C D : Matrix (Fin 2) (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K :=
  (b - a)⁻¹ • (D - a • C)

def evenOrbitSolveV (a b : K) (C D : Matrix (Fin 2) (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K :=
  (b - a)⁻¹ • (b • C - D)

theorem evenOrbitSolve_add (a b : K) (h : b - a ≠ 0)
    (C D : Matrix (Fin 2) (Fin 2) K) :
    evenOrbitSolveU a b C D + evenOrbitSolveV a b C D = C := by
  ext i j
  simp only [evenOrbitSolveU, evenOrbitSolveV, Matrix.add_apply, Matrix.sub_apply,
    Matrix.smul_apply, smul_eq_mul]
  field_simp [h] <;> ring

theorem evenOrbitSolve_weighted (a b : K) (h : b - a ≠ 0)
    (C D : Matrix (Fin 2) (Fin 2) K) :
    b • evenOrbitSolveU a b C D + a • evenOrbitSolveV a b C D = D := by
  ext i j
  simp only [evenOrbitSolveU, evenOrbitSolveV, Matrix.add_apply, Matrix.sub_apply,
    Matrix.smul_apply, smul_eq_mul]
  field_simp [h] <;> ring

def evenOrbitUpper (a b : K) (C D : Matrix (Fin 2) (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K :=
  -evenOrbitJ * evenOrbitSolveV a b C D

def evenOrbitLower (a b : K) (C D : Matrix (Fin 2) (Fin 2) K) :
    Matrix (Fin 2) (Fin 2) K :=
  evenOrbitJ * (evenOrbitSolveU a b C D).transpose

theorem evenOrbit_offDiagonal_first (a b : K) (h : b - a ≠ 0)
    (C D : Matrix (Fin 2) (Fin 2) K) :
    (evenOrbitLower a b C D).transpose * evenOrbitJ +
      evenOrbitJ * evenOrbitUpper a b C D = C := by
  rw [evenOrbitLower, evenOrbitUpper, evenOrbitJ_lower_cancel, evenOrbitJ_upper_cancel]
  exact evenOrbitSolve_add a b h C D

theorem evenOrbit_offDiagonal_second (a b : K) (h : b - a ≠ 0)
    (C D : Matrix (Fin 2) (Fin 2) K) :
    b • ((evenOrbitLower a b C D).transpose * evenOrbitJ) +
      a • (evenOrbitJ * evenOrbitUpper a b C D) = D := by
  rw [evenOrbitLower, evenOrbitUpper, evenOrbitJ_lower_cancel, evenOrbitJ_upper_cancel]
  exact evenOrbitSolve_weighted a b h C D

def evenOrbitDiagonal (c : K) : Matrix (Fin 2) (Fin 2) K := !![c, 0; 0, 0]

theorem evenOrbit_diagonal_first (c : K) :
    (evenOrbitDiagonal c).transpose * evenOrbitJ + evenOrbitJ * evenOrbitDiagonal c =
      c • evenOrbitJ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [evenOrbitDiagonal, evenOrbitJ, Matrix.mul_apply, Fin.sum_univ_two]

abbrev EvenOrbitMode (k : ℕ) := Fin 2 × Fin k
abbrev EvenOrbitSlot (k : ℕ) := Fin k ⊕ (Orbit.StrictPair k × (Fin 2 × Fin 2))
abbrev EvenOrbitPairSlot (k : ℕ) := Bool × EvenOrbitSlot k

def evenOrbitSlotRow (k : ℕ) : EvenOrbitSlot k → EvenOrbitMode k
  | Sum.inl i => (0, i)
  | Sum.inr p => (p.2.1, p.1.val.1)

def evenOrbitSlotCol (k : ℕ) : EvenOrbitSlot k → EvenOrbitMode k
  | Sum.inl i => (1, i)
  | Sum.inr p => (p.2.2, p.1.val.2)

def evenOrbitBlock {k : ℕ} (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K)
    (i j : Fin k) : Matrix (Fin 2) (Fin 2) K :=
  H.submatrix (fun a ↦ (a, i)) (fun b ↦ (b, j))

theorem evenOrbitBlock_add {k : ℕ}
    (H G : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (i j : Fin k) :
    evenOrbitBlock (H + G) i j = evenOrbitBlock H i j + evenOrbitBlock G i j := rfl

theorem evenOrbitBlock_transpose {k : ℕ}
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (i j : Fin k) :
    evenOrbitBlock H.transpose i j = (evenOrbitBlock H j i).transpose := rfl

theorem evenOrbitBlock_mul_diagonal {k : ℕ}
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K)
    (B : Fin k → Matrix (Fin 2) (Fin 2) K) (i j : Fin k) :
    evenOrbitBlock (H * Matrix.blockDiagonal B) i j = evenOrbitBlock H i j * B j := by
  ext a b
  simp [evenOrbitBlock, Matrix.mul_apply, Fintype.sum_prod_type,
    Matrix.blockDiagonal_apply, mul_ite]

theorem evenOrbitBlock_diagonal_mul {k : ℕ}
    (B : Fin k → Matrix (Fin 2) (Fin 2) K)
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (i j : Fin k) :
    evenOrbitBlock (Matrix.blockDiagonal B * H) i j = B i * evenOrbitBlock H i j := by
  ext a b
  simp [evenOrbitBlock, Matrix.mul_apply, Fintype.sum_prod_type,
    Matrix.blockDiagonal_apply, ite_mul]

def evenOrbitFirst (k : ℕ) : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K :=
  Matrix.blockDiagonal fun _ ↦ evenOrbitJ

def evenOrbitSecond {k : ℕ} (lam : Fin k → K) :
    Matrix (EvenOrbitMode k) (EvenOrbitMode k) K :=
  Matrix.blockDiagonal fun i ↦ lam i • evenOrbitJ

def evenOrbitDifferential {k : ℕ} (lam : Fin k → K)
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (μ : Fin k → K) :
    EvenOrbitPairSlot k → K :=
  fun z ↦ if z.1 then
      (H.transpose * evenOrbitSecond lam + evenOrbitSecond lam * H + evenOrbitSecond μ)
        (evenOrbitSlotRow k z.2) (evenOrbitSlotCol k z.2)
    else
      (H.transpose * evenOrbitFirst (K := K) k + evenOrbitFirst (K := K) k * H)
        (evenOrbitSlotRow k z.2) (evenOrbitSlotCol k z.2)

/-- Assemble the diagonal and off-diagonal solutions into a single infinitesimal matrix. -/
def evenOrbitSolutionMatrix {k : ℕ} (lam c : Fin k → K)
    (C D : Orbit.StrictPair k → Matrix (Fin 2) (Fin 2) K) :
    Matrix (EvenOrbitMode k) (EvenOrbitMode k) K :=
  Matrix.of fun u v ↦
    if h : u.2 < v.2 then
      evenOrbitUpper (lam u.2) (lam v.2) (C ⟨(u.2, v.2), h⟩) (D ⟨(u.2, v.2), h⟩) u.1 v.1
    else if h' : v.2 < u.2 then
      evenOrbitLower (lam v.2) (lam u.2) (C ⟨(v.2, u.2), h'⟩) (D ⟨(v.2, u.2), h'⟩) u.1 v.1
    else evenOrbitDiagonal (c u.2) u.1 v.1

theorem evenOrbitSolutionMatrix_diagonal {k : ℕ} (lam c : Fin k → K)
    (C D : Orbit.StrictPair k → Matrix (Fin 2) (Fin 2) K) (i : Fin k) :
    evenOrbitBlock (evenOrbitSolutionMatrix lam c C D) i i = evenOrbitDiagonal (c i) := by
  ext a b
  simp [evenOrbitBlock, evenOrbitSolutionMatrix]

theorem evenOrbitSolutionMatrix_upper {k : ℕ} (lam c : Fin k → K)
    (C D : Orbit.StrictPair k → Matrix (Fin 2) (Fin 2) K) (p : Orbit.StrictPair k) :
    evenOrbitBlock (evenOrbitSolutionMatrix lam c C D) p.val.1 p.val.2 =
      evenOrbitUpper (lam p.val.1) (lam p.val.2) (C p) (D p) := by
  ext a b
  simp [evenOrbitBlock, evenOrbitSolutionMatrix, p.property]

theorem evenOrbitSolutionMatrix_lower {k : ℕ} (lam c : Fin k → K)
    (C D : Orbit.StrictPair k → Matrix (Fin 2) (Fin 2) K) (p : Orbit.StrictPair k) :
    evenOrbitBlock (evenOrbitSolutionMatrix lam c C D) p.val.2 p.val.1 =
      evenOrbitLower (lam p.val.1) (lam p.val.2) (C p) (D p) := by
  ext a b
  simp [evenOrbitBlock, evenOrbitSolutionMatrix, p.property, not_lt_of_ge p.property.le]

/-- The actual even-pencil differential, including eigenvalue variation, is onto. -/
theorem evenOrbitDifferential_surjective {k : ℕ} (lam : Fin k → K)
    (hlam : Function.Injective lam) :
    Function.Surjective (fun Hμ :
      Matrix (EvenOrbitMode k) (EvenOrbitMode k) K × (Fin k → K) ↦
        evenOrbitDifferential lam Hμ.1 Hμ.2) := by
  intro y
  let c : Fin k → K := fun i ↦ y (false, Sum.inl i)
  let d : Fin k → K := fun i ↦ y (true, Sum.inl i)
  let C : Orbit.StrictPair k → Matrix (Fin 2) (Fin 2) K :=
    fun p ↦ Matrix.of fun a b ↦ y (false, Sum.inr (p, (a, b)))
  let D : Orbit.StrictPair k → Matrix (Fin 2) (Fin 2) K :=
    fun p ↦ Matrix.of fun a b ↦ y (true, Sum.inr (p, (a, b)))
  let H := evenOrbitSolutionMatrix lam c C D
  let μ : Fin k → K := fun i ↦ d i - lam i * c i
  have hne (p : Orbit.StrictPair k) : lam p.val.2 - lam p.val.1 ≠ 0 := by
    apply sub_ne_zero.mpr
    intro h
    exact p.property.ne (hlam h).symm
  have hfirst (i j : Fin k) :
      evenOrbitBlock (H.transpose * evenOrbitFirst (K := K) k + evenOrbitFirst (K := K) k * H) i j =
        (evenOrbitBlock H j i).transpose * evenOrbitJ +
          evenOrbitJ * evenOrbitBlock H i j := by
    rw [evenOrbitBlock_add, evenOrbitFirst, evenOrbitBlock_mul_diagonal,
      evenOrbitBlock_diagonal_mul, evenOrbitBlock_transpose]
  have hsecond (i j : Fin k) :
      evenOrbitBlock (H.transpose * evenOrbitSecond lam + evenOrbitSecond lam * H) i j =
        lam j • ((evenOrbitBlock H j i).transpose * evenOrbitJ) +
          lam i • (evenOrbitJ * evenOrbitBlock H i j) := by
    rw [evenOrbitBlock_add, evenOrbitSecond, evenOrbitBlock_mul_diagonal,
      evenOrbitBlock_diagonal_mul, evenOrbitBlock_transpose,
      mul_smul_comm, smul_mul_assoc]
  refine ⟨(H, μ), ?_⟩
  funext z
  rcases z with ⟨flag, slot⟩
  cases slot with
  | inl i =>
    have hdiag := evenOrbitSolutionMatrix_diagonal lam c C D i
    cases flag
    · change evenOrbitBlock
        (H.transpose * evenOrbitFirst (K := K) k + evenOrbitFirst (K := K) k * H) i i 0 1 = c i
      rw [hfirst, hdiag, evenOrbit_diagonal_first]
      simp [evenOrbitJ]
    · change (evenOrbitBlock
        (H.transpose * evenOrbitSecond lam + evenOrbitSecond lam * H) i i +
        evenOrbitBlock (evenOrbitSecond μ) i i) 0 1 = d i
      rw [hsecond, hdiag]
      rw [← smul_add, evenOrbit_diagonal_first]
      simp [evenOrbitBlock, evenOrbitSecond, evenOrbitJ, μ, smul_eq_mul, mul_assoc] <;> ring
  | inr p =>
    rcases p with ⟨p, u, v⟩
    have hu := evenOrbitSolutionMatrix_upper lam c C D p
    have hl := evenOrbitSolutionMatrix_lower lam c C D p
    cases flag
    · change evenOrbitBlock
        (H.transpose * evenOrbitFirst (K := K) k + evenOrbitFirst (K := K) k * H)
          p.val.1 p.val.2 u v = C p u v
      rw [hfirst, hl, hu, evenOrbit_offDiagonal_first _ _ (hne p)]
    · change (evenOrbitBlock
        (H.transpose * evenOrbitSecond lam + evenOrbitSecond lam * H)
          p.val.1 p.val.2 +
        evenOrbitBlock (evenOrbitSecond μ) p.val.1 p.val.2) u v = D p u v
      rw [hsecond, hl, hu, evenOrbit_offDiagonal_second _ _ (hne p)]
      have hzero : evenOrbitBlock (evenOrbitSecond μ) p.val.1 p.val.2 = 0 := by
        ext a b
        simp [evenOrbitBlock, evenOrbitSecond, Matrix.blockDiagonal_apply,
          p.property.ne]
      rw [hzero, add_zero]

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0024

section TAF_LiteralSource_0025
/- Original module: PaperVerification.AlternatingFormsEvenOrbitPolynomial -/


/-!
# The dominant polynomial family of even alternating pencils

Both block coefficient vectors remain independent parameters.  The remaining
parameters are the entries of the change-of-basis matrix.  The polynomial
coordinates are the literal selected entries of the two congruence transforms.
At the identity and at block coefficients (1, lam), the restriction of its
Jacobian to matrix variation and second-vector variation is the already solved
even-pencil differential.  Distinct lam therefore give a surjective Jacobian.
-/

@[expose] public section
noncomputable section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

open Matrix MvPolynomial
open scoped BigOperators Classical Matrix

section DualCongruence

variable {K ν : Type*} [CommRing K] [Fintype ν] [DecidableEq ν]

theorem orbitCongruenceCoordinate_dual (A H : Matrix ν ν K) (u v : ν) :
    aeval (fun z : ν × ν =>
      TrivSqZeroExt.inl (orbitIdentityPoint (K := K) z) +
        TrivSqZeroExt.inr (H z.1 z.2) : (ν × ν) → TrivSqZeroExt K K)
      (orbitCongruenceCoordinate A u v) =
      TrivSqZeroExt.inl (A u v) +
        TrivSqZeroExt.inr ((H.transpose * A + A * H) u v) := by
  apply TrivSqZeroExt.ext
  · rw [MvPolynomial.aeval_inl_add_inr]
    simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl,
      TrivSqZeroExt.fst_inr, add_zero, orbitCongruenceCoordinate_identity]
  · have h := congrFun (orbitCongruenceFamily_jacobian
      (fun _ : Unit => A) (fun _ => u) (fun _ => v)
      (fun z => H z.1 z.2)) ()
    rw [TauCeti.jacobiMatrixAt_mulVec_apply_eq_snd_aeval] at h
    change (aeval (fun z : ν × ν =>
      TrivSqZeroExt.inl (orbitIdentityPoint (K := K) z) +
        TrivSqZeroExt.inr (H z.1 z.2))
      (orbitCongruenceCoordinate A u v)).snd =
        ((H.transpose * A + A * H) u v) at h
    simpa only [TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl,
      TrivSqZeroExt.snd_inr, zero_add] using h

end DualCongruence

variable {K : Type*} [Field K]

abbrev EvenOrbitParameter (k : ℕ) :=
  (EvenOrbitMode k × EvenOrbitMode k) ⊕ (Bool × Fin k)

def evenOrbitSingleBlock (k : ℕ) (i : Fin k) :
    Matrix (EvenOrbitMode k) (EvenOrbitMode k) K :=
  evenOrbitSecond (Pi.single i 1)

theorem evenOrbitSecond_sum_single (k : ℕ) (lam : Fin k → K) :
    (∑ i, lam i • evenOrbitSingleBlock (K := K) k i) = evenOrbitSecond lam := by
  ext u v
  simp only [Matrix.sum_apply, Matrix.smul_apply]
  rcases u with ⟨a, i⟩
  rcases v with ⟨b, j⟩
  by_cases hij : i = j
  · subst j
    simp [evenOrbitSingleBlock, evenOrbitSecond, Matrix.blockDiagonal_apply,
      Pi.single_apply, smul_eq_mul, mul_ite, ite_mul, apply_ite]
    rw [Finset.sum_eq_single i]
    · simp
    · intro j hj hji
      simp only [if_neg (Ne.symm hji), Matrix.zero_apply, mul_zero]
    · simp
  · simp [evenOrbitSingleBlock, evenOrbitSecond, Matrix.blockDiagonal_apply, hij]

theorem evenOrbitSecond_one (k : ℕ) :
    evenOrbitSecond (fun _ : Fin k => (1 : K)) = evenOrbitFirst (K := K) k := by
  simp only [evenOrbitSecond, evenOrbitFirst, one_smul]

theorem evenOrbitSingleBlock_congruence_sum (k : ℕ) (lam : Fin k → K)
    (X : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (u v : EvenOrbitMode k) :
    (∑ i, lam i * (X.transpose * evenOrbitSingleBlock (K := K) k i * X) u v) =
      (X.transpose * evenOrbitSecond lam * X) u v := by
  rw [← evenOrbitSecond_sum_single (K := K) k lam, Matrix.mul_sum, Matrix.sum_mul]
  simp only [Matrix.mul_smul, Matrix.smul_mul, Matrix.sum_apply,
    Matrix.smul_apply, smul_eq_mul]

theorem evenOrbitSingleBlock_differential_sum (k : ℕ) (lam : Fin k → K)
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (u v : EvenOrbitMode k) :
    (∑ i, lam i * (H.transpose * evenOrbitSingleBlock (K := K) k i +
      evenOrbitSingleBlock (K := K) k i * H) u v) =
      (H.transpose * evenOrbitSecond lam + evenOrbitSecond lam * H) u v := by
  rw [← evenOrbitSecond_sum_single (K := K) k lam, Matrix.mul_sum, Matrix.sum_mul]
  simp only [Matrix.mul_smul, Matrix.smul_mul, Matrix.sum_apply,
    Matrix.smul_apply, smul_eq_mul, Matrix.add_apply, mul_add,
    Finset.sum_add_distrib]

def evenOrbitLiftedCongruence (k : ℕ)
    (A : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (u v : EvenOrbitMode k) :
    MvPolynomial (EvenOrbitParameter k) K :=
  rename Sum.inl (orbitCongruenceCoordinate A u v)

def evenOrbitPolynomials (k : ℕ) (z : EvenOrbitPairSlot k) :
    MvPolynomial (EvenOrbitParameter k) K :=
  ∑ i, X (Sum.inr (z.1, i)) *
    evenOrbitLiftedCongruence k (evenOrbitSingleBlock (K := K) k i)
      (evenOrbitSlotRow k z.2) (evenOrbitSlotCol k z.2)

/-- This evaluation identity pins the polynomial map to the actual matrix
congruence action and both independent block coefficient vectors. -/
theorem evenOrbitPolynomials_eval (k : ℕ) (x : EvenOrbitParameter k → K)
    (z : EvenOrbitPairSlot k) :
    eval x (evenOrbitPolynomials k z) =
      ((Matrix.of fun i j => x (Sum.inl (i, j))).transpose *
        evenOrbitSecond (fun i => x (Sum.inr (z.1, i))) *
        (Matrix.of fun i j => x (Sum.inl (i, j))))
          (evenOrbitSlotRow k z.2) (evenOrbitSlotCol k z.2) := by
  simp only [evenOrbitPolynomials, map_sum, map_mul, eval_X,
    evenOrbitLiftedCongruence, eval_rename, orbitCongruenceCoordinate_eval,
    Function.comp_apply]
  exact evenOrbitSingleBlock_congruence_sum (K := K) k _ _ _ _

def evenOrbitBasePoint {k : ℕ} (lam : Fin k → K) : EvenOrbitParameter k → K :=
  Sum.elim orbitIdentityPoint (fun z => if z.1 then lam z.2 else 1)

def evenOrbitTangent {k : ℕ}
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (μ : Fin k → K) :
    EvenOrbitParameter k → K :=
  Sum.elim (fun z => H z.1 z.2) (fun z => if z.1 then μ z.2 else 0)

theorem evenOrbitLiftedCongruence_dual {k : ℕ} (lam μ : Fin k → K)
    (A H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) (u v : EvenOrbitMode k) :
    aeval (fun z => TrivSqZeroExt.inl (evenOrbitBasePoint lam z) +
      TrivSqZeroExt.inr (evenOrbitTangent H μ z) :
        EvenOrbitParameter k → TrivSqZeroExt K K)
      (evenOrbitLiftedCongruence k A u v) =
      TrivSqZeroExt.inl (A u v) +
        TrivSqZeroExt.inr ((H.transpose * A + A * H) u v) := by
  rw [evenOrbitLiftedCongruence, aeval_rename]
  exact orbitCongruenceCoordinate_dual A H u v

theorem evenOrbitPolynomials_jacobian {k : ℕ} (lam μ : Fin k → K)
    (H : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K) :
    TauCeti.jacobiMatrixAt (evenOrbitPolynomials (K := K) k) (evenOrbitBasePoint lam) *ᵥ
        evenOrbitTangent H μ = evenOrbitDifferential lam H μ := by
  funext z
  rw [TauCeti.jacobiMatrixAt_mulVec_apply_eq_snd_aeval]
  simp only [evenOrbitPolynomials, map_sum, map_mul, aeval_X,
    evenOrbitLiftedCongruence_dual, TrivSqZeroExt.snd_sum,
    DualNumber.snd_mul, TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add,
    TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_inr,
    TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_inr, add_zero, zero_add]
  rcases z with ⟨b, s⟩
  cases b
  · simp only [evenOrbitBasePoint, evenOrbitTangent, Sum.elim_inr,
      Bool.false_eq_true, if_false, one_mul, zero_mul, add_zero,
      evenOrbitDifferential]
    simpa only [one_mul, evenOrbitSecond_one] using
      evenOrbitSingleBlock_differential_sum (K := K) k (fun _ => (1 : K)) H
        (evenOrbitSlotRow k s) (evenOrbitSlotCol k s)
  · simp only [evenOrbitBasePoint, evenOrbitTangent, Sum.elim_inr,
      if_true, Finset.sum_add_distrib, evenOrbitDifferential]
    rw [evenOrbitSingleBlock_differential_sum]
    have hμ := congrArg
      (fun A : Matrix (EvenOrbitMode k) (EvenOrbitMode k) K =>
        A (evenOrbitSlotRow k s) (evenOrbitSlotCol k s))
      (evenOrbitSecond_sum_single (K := K) k μ)
    simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul] at hμ
    rw [hμ]
    rfl

/-- Matrix variation and variation of the second block vector already cover
all coefficients.  The first-vector parameters introduce no extra premise. -/
theorem evenOrbit_jacobian_surjective {k : ℕ} (lam : Fin k → K)
    (hlam : Function.Injective lam) :
    (TauCeti.jacobiMatrixAt (evenOrbitPolynomials (K := K) k)
      (evenOrbitBasePoint lam)).mulVec.Surjective := by
  intro y
  obtain ⟨⟨H, μ⟩, hy⟩ := evenOrbitDifferential_surjective lam hlam y
  refine ⟨evenOrbitTangent H μ, ?_⟩
  rw [evenOrbitPolynomials_jacobian]
  exact hy

theorem evenOrbit_natPoint_injective [CharZero K] (k : ℕ) :
    Function.Injective (fun i : Fin k => (i.val : K)) := by
  intro i j hij
  exact Fin.ext (Nat.cast_injective hij)

theorem evenOrbit_algebraicIndependent [CharZero K] (k : ℕ) :
    AlgebraicIndependent K (evenOrbitPolynomials (K := K) k) :=
  TauCeti.algebraicIndependent_of_mulVec_surjective_jacobiMatrixAt
    (evenOrbit_jacobian_surjective (fun i => (i.val : K)) (evenOrbit_natPoint_injective k))

def evenOrbitDeterminant (k : ℕ) : MvPolynomial (EvenOrbitParameter k) K :=
  rename Sum.inl (orbitDeterminant (K := K) (ν := EvenOrbitMode k))

theorem evenOrbitDeterminant_eval (k : ℕ) (x : EvenOrbitParameter k → K) :
    eval x (evenOrbitDeterminant (K := K) k) =
      (Matrix.of fun i j => x (Sum.inl (i, j))).det := by
  rw [evenOrbitDeterminant, eval_rename, orbitDeterminant_eval]
  rfl

theorem evenOrbitDeterminant_basePoint {k : ℕ} (lam : Fin k → K) :
    eval (evenOrbitBasePoint lam) (evenOrbitDeterminant (K := K) k) = 1 := by
  rw [evenOrbitDeterminant, eval_rename]
  exact orbitDeterminant_identity

theorem evenOrbitDeterminant_ne_zero (k : ℕ) :
    evenOrbitDeterminant (K := K) k ≠ 0 := by
