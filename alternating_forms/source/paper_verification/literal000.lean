/- Original module: PaperVerification.AlternatingFormsOrbitExterior -/


/-!
# Exterior relation matrices and invariance under a change of basis

The relation map is the actual map (x,y) ↦ f ∧ x + g ∧ y between exterior powers.
Its coefficient matrix is polynomial in the coordinates of f and g. An invertible
linear change of variables gives isomorphic relation spaces, hence preserves their ranks.
-/

@[expose] public section
noncomputable section

open scoped BigOperators

namespace PaperVerification.AlternatingForms

open Module MvPolynomial

variable {K M N : Type*} [Field K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

/-- An invertible linear map induces an equivalence on each actual exterior power. -/
def orbitExteriorPowerEquiv (e : M ≃ₗ[K] N) (q : ℕ) :
    (⋀[K]^q M) ≃ₗ[K] (⋀[K]^q N) :=
  LinearEquiv.ofBijective (exteriorPower.map q e.toLinearMap)
    ⟨exteriorPower.map_injective_field (n := q) e.injective,
      exteriorPower.map_surjective (n := q) e.surjective⟩

@[simp]
theorem orbitExteriorPowerEquiv_apply (e : M ≃ₗ[K] N) (q : ℕ) (x : ⋀[K]^q M) :
    orbitExteriorPowerEquiv e q x = exteriorPower.map q e.toLinearMap x := rfl

/-- Naturality of the actual exterior multiplication. -/
theorem orbitExteriorPower_map_wedge (e : M ≃ₗ[K] N) (a b : ℕ)
    (x : ⋀[K]^a M) (y : ⋀[K]^b M) :
    exteriorPower.map (a + b) e.toLinearMap (exteriorPower.wedge K M a b x y) =
      exteriorPower.wedge K N a b
        (exteriorPower.map a e.toLinearMap x) (exteriorPower.map b e.toLinearMap y) := by
  apply Subtype.ext
  simp only [exteriorPower.coe_map, exteriorPower.wedge,
    DirectSum.gMulLHom_apply_apply, SetLike.coe_gMul, map_mul]

/-- The two-form relation map into degree 2+q. -/
def orbitExteriorRelationMap (f g : ⋀[K]^2 M) (q : ℕ) :
    ((⋀[K]^q M) × (⋀[K]^q M)) →ₗ[K] (⋀[K]^(2 + q) M) :=
  (exteriorPower.wedge K M 2 q f).coprod (exteriorPower.wedge K M 2 q g)

theorem orbitExteriorRelationMap_natural (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (q : ℕ) (x y : ⋀[K]^q M) :
    orbitExteriorPowerEquiv e (2 + q) (orbitExteriorRelationMap f g q (x, y)) =
      orbitExteriorRelationMap (orbitExteriorPowerEquiv e 2 f)
        (orbitExteriorPowerEquiv e 2 g) q
        (orbitExteriorPowerEquiv e q x, orbitExteriorPowerEquiv e q y) := by
  simp only [orbitExteriorRelationMap, LinearMap.coprod_apply, map_add,
    orbitExteriorPowerEquiv_apply, orbitExteriorPower_map_wedge]

theorem orbitExteriorRelationMap_intertwines (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (q : ℕ) :
    (orbitExteriorPowerEquiv e (2 + q)).toLinearMap.comp (orbitExteriorRelationMap f g q) =
      (orbitExteriorRelationMap (orbitExteriorPowerEquiv e 2 f)
        (orbitExteriorPowerEquiv e 2 g) q).comp
        ((orbitExteriorPowerEquiv e q).prodCongr (orbitExteriorPowerEquiv e q)).toLinearMap := by
  apply LinearMap.ext
  rintro ⟨x, y⟩
  exact orbitExteriorRelationMap_natural e f g q x y

theorem orbitExteriorRelationRange_map (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (q : ℕ) :
    (orbitExteriorRelationMap f g q).range.map
        (orbitExteriorPowerEquiv e (2 + q)).toLinearMap =
      (orbitExteriorRelationMap (orbitExteriorPowerEquiv e 2 f)
        (orbitExteriorPowerEquiv e 2 g) q).range := by
  have hsurj :
      ((orbitExteriorPowerEquiv e q).prodCongr
        (orbitExteriorPowerEquiv e q)).toLinearMap.range = ⊤ :=
    LinearMap.range_eq_top.mpr
      ((orbitExteriorPowerEquiv e q).prodCongr (orbitExteriorPowerEquiv e q)).surjective
  rw [← LinearMap.range_comp, orbitExteriorRelationMap_intertwines,
    LinearMap.range_comp, hsurj, Submodule.map_top]

/-- The actual spaces of exterior relations are equivalent under a change of basis. -/
def orbitExteriorRelationRangeEquiv (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (q : ℕ) :
    (orbitExteriorRelationMap f g q).range ≃ₗ[K]
      (orbitExteriorRelationMap (orbitExteriorPowerEquiv e 2 f)
        (orbitExteriorPowerEquiv e 2 g) q).range :=
  (orbitExteriorPowerEquiv e (2 + q)).ofSubmodules _ _
    (orbitExteriorRelationRange_map e f g q)

theorem orbitExteriorRelation_finrank_invariant (e : M ≃ₗ[K] N)
    (f g : ⋀[K]^2 M) (q : ℕ) :
    Module.finrank K (orbitExteriorRelationMap f g q).range =
      Module.finrank K (orbitExteriorRelationMap (orbitExteriorPowerEquiv e 2 f)
        (orbitExteriorPowerEquiv e 2 g) q).range :=
  (orbitExteriorRelationRangeEquiv e f g q).finrank_eq

section Coordinates

variable {I J B : Type*} [Fintype I] [Fintype J] [Fintype B]
  [DecidableEq I] [DecidableEq J] [DecidableEq B]
  (q : ℕ) (b₂ : Basis I K (⋀[K]^2 M))
  (bq : Basis J K (⋀[K]^q M)) (bout : Basis B K (⋀[K]^(2 + q) M))

/-- Two actual exterior two-forms with the specified coefficients. -/
def orbitFormsFromCoordinates (x : (I ⊕ I) → K) : (⋀[K]^2 M) × (⋀[K]^2 M) :=
  (∑ i, x (Sum.inl i) • b₂ i, ∑ i, x (Sum.inr i) • b₂ i)

/-- The actual exterior relation matrix, written as a polynomial in all two-form
coefficients. Its entries use the structure constants of exterior multiplication. -/
def orbitRelationPolynomialMatrix :
    Matrix B (J ⊕ J) (MvPolynomial (I ⊕ I) K) :=
  Matrix.of fun r c ↦ match c with
    | Sum.inl j =>
      ∑ i, C (bout.coord r (exteriorPower.wedge K M 2 q (b₂ i) (bq j))) * X (Sum.inl i)
    | Sum.inr j =>
      ∑ i, C (bout.coord r (exteriorPower.wedge K M 2 q (b₂ i) (bq j))) * X (Sum.inr i)

/-- Evaluation gives the matrix of multiplication by the two actual forms,
not a surrogate matrix with an expected rank built into its definition. -/
theorem orbitRelationPolynomialMatrix_eval (x : (I ⊕ I) → K) :
    (orbitRelationPolynomialMatrix q b₂ bq bout).map (eval x) =
      LinearMap.toMatrix (bq.prod bq) bout
        (orbitExteriorRelationMap (orbitFormsFromCoordinates b₂ x).1
          (orbitFormsFromCoordinates b₂ x).2 q) := by
  have hzero (z : ⋀[K]^2 M) :
      (GradedMonoid.GMul.mul (A := fun r : ℕ => ↥(⋀[K]^r M))
        z (0 : ⋀[K]^q M) : ⋀[K]^(2+q) M) = 0 := by
    apply Subtype.ext
    change (z : ExteriorAlgebra K M) * 0 = 0
    exact mul_zero _
  ext r c
  cases c with
  | inl j =>
    simp [orbitRelationPolynomialMatrix, orbitFormsFromCoordinates,
      LinearMap.toMatrix_apply, ← Basis.coord_apply, orbitExteriorRelationMap,
      Basis.prod_apply, LinearMap.coprod_apply, LinearMap.sum_apply,
      LinearMap.smul_apply, map_sum, map_smul, mul_comm, hzero]
  | inr j =>
    simp [orbitRelationPolynomialMatrix, orbitFormsFromCoordinates,
      LinearMap.toMatrix_apply, ← Basis.coord_apply, orbitExteriorRelationMap,
      Basis.prod_apply, LinearMap.coprod_apply, LinearMap.sum_apply,
      LinearMap.smul_apply, map_sum, map_smul, mul_comm, hzero]

theorem orbitRelationMatrix_rank_invariant (e : M ≃ₗ[K] M) (f g : ⋀[K]^2 M) :
    (LinearMap.toMatrix (bq.prod bq) bout (orbitExteriorRelationMap f g q)).rank =
      (LinearMap.toMatrix (bq.prod bq) bout
        (orbitExteriorRelationMap (orbitExteriorPowerEquiv e 2 f)
          (orbitExteriorPowerEquiv e 2 g) q)).rank := by
  rw [LinearMap.rank_toMatrix, LinearMap.rank_toMatrix]
  exact orbitExteriorRelation_finrank_invariant e f g q

end Coordinates

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0027

section TAF_LiteralSource_0028
/- Original module: PaperVerification.AlternatingFormsExteriorCentrality -/


/-!
# Centrality of actual exterior two-forms

The alternating relation in the exterior algebra implies that every homogeneous
two-form commutes with every exterior element, over an arbitrary commutative ring.
This is a direct prerequisite of the main straightening argument, independent of
the later complementary-degree duality development.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

section ExteriorCentrality

variable {K M : Type*} [CommRing K] [AddCommGroup M] [Module K M]

/-- Every exterior two-form is central in the full exterior algebra.  The
proof uses the actual exterior multiplication and its alternating relations. -/
theorem twoForm_commute (f : ⋀[K]^2 M) (x : ExteriorAlgebra K M) :
    Commute (f : ExteriorAlgebra K M) x := by
  have hgenerator (v : M) : Commute (f : ExteriorAlgebra K M) (ExteriorAlgebra.ι K v) := by
    have hf : (f : ExteriorAlgebra K M) ∈
        Submodule.span K (Set.range (ExteriorAlgebra.ιMulti K 2)) := by
      rw [ExteriorAlgebra.ιMulti_span_fixedDegree]
      exact f.property
    refine Submodule.span_induction
      (p := fun y _ => Commute y (ExteriorAlgebra.ι K v)) ?_ ?_ ?_ ?_ hf
    · intro y hy
      rcases hy with ⟨a, rfl⟩
      exact (show Commute (ExteriorAlgebra.ι K v) (ExteriorAlgebra.ιMulti K 2 a) from by
        change ExteriorAlgebra.ι K v * ExteriorAlgebra.ιMulti K 2 a =
          ExteriorAlgebra.ιMulti K 2 a * ExteriorAlgebra.ι K v
        simpa only [pow_two, neg_mul_neg, one_mul, one_smul] using
          (ExteriorAlgebra.ι_mul_ιMulti_anticomm K v a)).symm
    · exact Commute.zero_left _
    · intro a b ha hb iha ihb
      exact iha.add_left ihb
    · intro c a ha iha
      exact iha.smul_left c
  induction x using ExteriorAlgebra.induction with
  | algebraMap r => exact (Algebra.commutes r (f : ExteriorAlgebra K M)).symm
  | ι v => exact hgenerator v
  | mul a b ha hb => exact ha.mul_right hb
  | add a b ha hb => exact ha.add_right hb

end ExteriorCentrality

end PaperVerification.AlternatingForms
end
end TAF_LiteralSource_0028

section TAF_LiteralSource_0029
/- Original module: PaperVerification.AlternatingFormsDuality -/


/-!
# Exterior duality for two quadratic relations

This file develops the exact complementary-degree duality underlying
Proposition 5.4.  The linear-algebra lemma is kept separate from its exterior
application so that the necessary adjoint identities cannot be hidden inside
a definition of the desired quotient.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace PaperVerification.AlternatingForms

section PerfectPairing

variable {K A B C D : Type*} [Field K]
  [AddCommGroup A] [Module K A] [FiniteDimensional K A]
  [AddCommGroup B] [Module K B] [FiniteDimensional K B]
  [AddCommGroup C] [Module K C] [AddCommGroup D] [Module K D]

/-- The annihilator of two images is exactly the common kernel of the two
adjoints.  Both perfect pairings and both adjoint identities are explicit. -/
theorem pair_annihilator_eq_common_kernel
    (P : A →ₗ[K] B →ₗ[K] K) [P.IsPerfPair]
    (Q : D →ₗ[K] C →ₗ[K] K) [Q.IsPerfPair]
    (f g : C →ₗ[K] B) (f' g' : A →ₗ[K] D)
    (hf : ∀ a c, P a (f c) = Q (f' a) c)
    (hg : ∀ a c, P a (g c) = Q (g' a) c) :
    (LinearMap.range f ⊔ LinearMap.range g).dualAnnihilator.comap P =
      LinearMap.ker f' ⊓ LinearMap.ker g' := by
  ext a
  simp only [Submodule.mem_comap, Submodule.mem_dualAnnihilator,
    Submodule.mem_inf, LinearMap.mem_ker]
  constructor
  · intro ha
    constructor
    · apply Q.toPerfPair.injective
      ext c
      simpa only [LinearMap.toPerfPair_apply, map_zero, LinearMap.zero_apply] using
        (hf a c).symm.trans (ha (f c) (Submodule.mem_sup_left (LinearMap.mem_range_self f c)))
    · apply Q.toPerfPair.injective
      ext c
      simpa only [LinearMap.toPerfPair_apply, map_zero, LinearMap.zero_apply] using
        (hg a c).symm.trans (ha (g c) (Submodule.mem_sup_right (LinearMap.mem_range_self g c)))
  · rintro ⟨hfa, hga⟩ b hb
    rcases Submodule.mem_sup.mp hb with ⟨u, hu, v, hv, rfl⟩
    rcases hu with ⟨c, rfl⟩
    rcases hv with ⟨d, rfl⟩
    rw [map_add, hf, hg, hfa, hga]
    simp

/-- Dimension form of the same exact duality. -/
theorem finrank_common_kernel_eq_quotient
    (P : A →ₗ[K] B →ₗ[K] K) [P.IsPerfPair]
    (Q : D →ₗ[K] C →ₗ[K] K) [Q.IsPerfPair]
    (f g : C →ₗ[K] B) (f' g' : A →ₗ[K] D)
    (hf : ∀ a c, P a (f c) = Q (f' a) c)
    (hg : ∀ a c, P a (g c) = Q (g' a) c) :
    Module.finrank K (LinearMap.ker f' ⊓ LinearMap.ker g' : Submodule K A) =
      Module.finrank K (B ⧸ (LinearMap.range f ⊔ LinearMap.range g)) := by
  let I := LinearMap.range f ⊔ LinearMap.range g
  have hpre : I.dualAnnihilator.comap P.toPerfPair.toLinearMap =
      LinearMap.ker f' ⊓ LinearMap.ker g' := by
    exact pair_annihilator_eq_common_kernel P Q f g f' g' hf hg
  have he := (P.toPerfPair.ofSubmodule' I.dualAnnihilator).finrank_eq
  rw [hpre] at he
  exact he.trans (Subspace.quotEquivAnnihilator I).finrank_eq.symm

end PerfectPairing


section ExteriorIdeal

variable {K M : Type*} [CommRing K] [AddCommGroup M] [Module K M]

/-- The ideal generated by the two quadratic relations in the actual
exterior algebra.  Centrality below proves that this left ideal is two-sided. -/
def exteriorRelationIdeal (f g : ⋀[K]^2 M) : Ideal (ExteriorAlgebra K M) :=
  Ideal.span {(f : ExteriorAlgebra K M), (g : ExteriorAlgebra K M)}

instance exteriorRelationIdeal_isTwoSided (f g : ⋀[K]^2 M) :
    (exteriorRelationIdeal f g).IsTwoSided where
  mul_mem_of_left r hx := by
    rcases Ideal.mem_span_pair.mp hx with ⟨a, b, rfl⟩
    apply Ideal.mem_span_pair.mpr
    refine ⟨a * r, b * r, ?_⟩
    rw [add_mul]
    congr 1 <;> simp only [mul_assoc]
    · rw [(twoForm_commute f r).eq]
    · rw [(twoForm_commute g r).eq]

theorem exteriorRelationIdeal_homogeneous (f g : ⋀[K]^2 M) :
    (exteriorRelationIdeal f g).IsHomogeneous (fun i : ℕ => ⋀[K]^i M) := by
  apply Ideal.homogeneous_span
  intro x hx
  rcases hx with rfl | rfl
  · exact ⟨2, f.property⟩
  · exact ⟨2, g.property⟩

/-- Relations of degree `d`: the inverse image of the generated ideal under
the inclusion of the genuine degree-`d` exterior power. -/
def exteriorDegreeRelations (f g : ⋀[K]^2 M) (d : ℕ) :
    Submodule K (⋀[K]^d M) :=
  ((exteriorRelationIdeal f g).restrictScalars K).comap
    (Submodule.subtype (⋀[K]^d M))

/-- The common annihilator in a genuine homogeneous exterior power. -/
def exteriorCommonAnnihilator (f g : ⋀[K]^2 M) (p : ℕ) :
    Submodule K (⋀[K]^p M) :=
  LinearMap.ker ((exteriorPower.wedge K M p 2).flip f) ⊓
    LinearMap.ker ((exteriorPower.wedge K M p 2).flip g)

theorem mem_exteriorCommonAnnihilator (f g : ⋀[K]^2 M) {p : ℕ} (a : ⋀[K]^p M) :
    a ∈ exteriorCommonAnnihilator f g p ↔
      (f : ExteriorAlgebra K M) * a = 0 ∧ (g : ExteriorAlgebra K M) * a = 0 := by
  simp only [exteriorCommonAnnihilator, Submodule.mem_inf, LinearMap.mem_ker]
  constructor
  · rintro ⟨ha, hb⟩
    constructor
    · apply (twoForm_commute f a).eq.trans
      simpa only [LinearMap.flip_apply, DirectSum.gMulLHom_apply_apply,
        SetLike.coe_gMul, ZeroMemClass.coe_zero] using congrArg Subtype.val ha
    · apply (twoForm_commute g a).eq.trans
      simpa only [LinearMap.flip_apply, DirectSum.gMulLHom_apply_apply,
        SetLike.coe_gMul, ZeroMemClass.coe_zero] using congrArg Subtype.val hb
  · rintro ⟨ha, hb⟩
    constructor
    · apply Subtype.ext
      simpa only [LinearMap.flip_apply, DirectSum.gMulLHom_apply_apply,
        SetLike.coe_gMul, ZeroMemClass.coe_zero] using (twoForm_commute f a).eq.symm.trans ha
    · apply Subtype.ext
      simpa only [LinearMap.flip_apply, DirectSum.gMulLHom_apply_apply,
        SetLike.coe_gMul, ZeroMemClass.coe_zero] using (twoForm_commute g a).eq.symm.trans hb

/-- The actual homogeneous degree quotient, defined using the generated
ideal, rather than using a formula for its anticipated dimension. -/
abbrev ExteriorQuotientDegree (f g : ⋀[K]^2 M) (d : ℕ) :=
  (⋀[K]^d M) ⧸ exteriorDegreeRelations f g d

/-- Include a homogeneous exterior power and then pass to the whole
exterior-algebra quotient by the generated relation ideal. -/
def exteriorDegreeProjection (f g : ⋀[K]^2 M) (d : ℕ) :
    (⋀[K]^d M) →ₗ[K]
      (ExteriorAlgebra K M ⧸ (exteriorRelationIdeal f g).restrictScalars K) :=
  ((exteriorRelationIdeal f g).restrictScalars K).mkQ.comp
    (Submodule.subtype (⋀[K]^d M))

theorem exteriorDegreeProjection_ker (f g : ⋀[K]^2 M) (d : ℕ) :
    LinearMap.ker (exteriorDegreeProjection f g d) = exteriorDegreeRelations f g d := by
  simp only [exteriorDegreeProjection, exteriorDegreeRelations,
    LinearMap.ker_comp, Submodule.ker_mkQ]

/-- The chosen homogeneous quotient is rigorously identified with the
image of that degree in the actual full quotient. -/
noncomputable def exteriorQuotientDegreeEquivImage (f g : ⋀[K]^2 M) (d : ℕ) :
    ExteriorQuotientDegree f g d ≃ₗ[K]
      LinearMap.range (exteriorDegreeProjection f g d) :=
  (Submodule.quotEquivOfEq _ _ (exteriorDegreeProjection_ker f g d).symm).trans
    (exteriorDegreeProjection f g d).quotKerEquivRange

/-- Every homogeneous relation is the sum of the two wedge images in the
appropriate degree.  The nontrivial direction projects arbitrary ideal
coefficients to their degree-`q` homogeneous parts. -/
theorem exteriorDegreeRelations_eq_images (f g : ⋀[K]^2 M) (q : ℕ) :
    exteriorDegreeRelations f g (2 + q) =
      LinearMap.range (exteriorPower.wedge K M 2 q f) ⊔
        LinearMap.range (exteriorPower.wedge K M 2 q g) := by
  classical
  let 𝒜 := fun i : ℕ => ⋀[K]^i M
  ext x
  constructor
  · intro hx
    change (x : ExteriorAlgebra K M) ∈ exteriorRelationIdeal f g at hx
    rcases Ideal.mem_span_pair.mp hx with ⟨a, b, hab⟩
    rw [← (twoForm_commute f a).eq, ← (twoForm_commute g b).eq] at hab
    have hproj := congrArg (GradedRing.proj 𝒜 (2 + q)) hab
    simp only [map_add, GradedRing.proj_apply,
      DirectSum.coe_decompose_mul_add_of_left_mem 𝒜 f.property,
      DirectSum.coe_decompose_mul_add_of_left_mem 𝒜 g.property,
      DirectSum.decompose_of_mem_same 𝒜 x.property] at hproj
    apply Submodule.mem_sup.mpr
    refine ⟨exteriorPower.wedge K M 2 q f (DirectSum.decompose 𝒜 a q),
      LinearMap.mem_range_self _ _,
      exteriorPower.wedge K M 2 q g (DirectSum.decompose 𝒜 b q),
      LinearMap.mem_range_self _ _, ?_⟩
    apply Subtype.ext
    simpa only [AddMemClass.coe_add, DirectSum.gMulLHom_apply_apply, SetLike.coe_gMul]
      using hproj
  · intro hx
    rcases Submodule.mem_sup.mp hx with ⟨u, ⟨a, rfl⟩, v, ⟨b, rfl⟩, rfl⟩
    change ((exteriorPower.wedge K M 2 q f a + exteriorPower.wedge K M 2 q g b :
      ⋀[K]^(2 + q) M) : ExteriorAlgebra K M) ∈ exteriorRelationIdeal f g
    apply Ideal.mem_span_pair.mpr
    refine ⟨(a : ExteriorAlgebra K M), (b : ExteriorAlgebra K M), ?_⟩
    simp only [AddMemClass.coe_add, DirectSum.gMulLHom_apply_apply, SetLike.coe_gMul]
    rw [(twoForm_commute f a).eq, (twoForm_commute g b).eq]

/-- A quadratic-generated ideal has no components below degree two. -/
theorem exteriorDegreeRelations_eq_bot (f g : ⋀[K]^2 M) {d : ℕ} (hd : d < 2) :
    exteriorDegreeRelations f g d = ⊥ := by
  classical
  let 𝒜 := fun i : ℕ => ⋀[K]^i M
  apply eq_bot_iff.mpr
  intro x hx
  apply (Submodule.mem_bot K).mpr
  change (x : ExteriorAlgebra K M) ∈ exteriorRelationIdeal f g at hx
  rcases Ideal.mem_span_pair.mp hx with ⟨a, b, hab⟩
  have hproj := congrArg (GradedRing.proj 𝒜 d) hab
  simp only [map_add, GradedRing.proj_apply,
    DirectSum.coe_decompose_mul_of_right_mem_of_not_le 𝒜 f.property (by omega : ¬2 ≤ d),
    DirectSum.coe_decompose_mul_of_right_mem_of_not_le 𝒜 g.property (by omega : ¬2 ≤ d),
    DirectSum.decompose_of_mem_same 𝒜 x.property, zero_add] at hproj
  exact Subtype.ext hproj.symm

end ExteriorIdeal

section ExteriorAdjoints

variable {K M : Type*} [Field K] [AddCommGroup M] [Module K M]
  [FiniteDimensional K M]

/-- Every finite-dimensional vector space has a one-dimensional top
exterior power, so choosing a volume introduces no additional hypothesis. -/
noncomputable def chooseExteriorVolume :
    ⋀[K]^(Module.finrank K M) M ≃ₗ[K] K :=
  LinearEquiv.ofFinrankEq _ _ (by simp)

private lemma exterior_cast_coe {i j : ℕ} (h : i = j) (x : ⋀[K]^i M) :
    ((h ▸ x : ⋀[K]^j M) : ExteriorAlgebra K M) = x := by
  subst h
  rfl

private lemma exterior_cast_apply {i j : ℕ} (h : i = j)
    (f : ⋀[K]^j M →ₗ[K] K) (x : ⋀[K]^i M) (y : ⋀[K]^j M)
    (hxy : (x : ExteriorAlgebra K M) = y) :
    (h ▸ f) x = f y := by
  subst h
  exact congrArg f (Subtype.ext hxy)

/-- Wedge pairings in any complementary degrees agree whenever their
products in the actual exterior algebra agree. -/
theorem wedgePairing_eq_of_mul_eq
    (vol : ⋀[K]^(Module.finrank K M) M ≃ₗ[K] K)
    {p q r u : ℕ} (hpq : p + q = Module.finrank K M)
    (hru : r + u = Module.finrank K M)
    (a : ⋀[K]^p M) (b : ⋀[K]^q M) (c : ⋀[K]^r M) (d : ⋀[K]^u M)
    (hmul : (a : ExteriorAlgebra K M) * b = (c : ExteriorAlgebra K M) * d) :
    exteriorPower.wedgePairing vol hpq a b =
      exteriorPower.wedgePairing vol hru c d := by
  let z : ⋀[K]^(Module.finrank K M) M :=
    ⟨(a : ExteriorAlgebra K M) * b, by
      rw [← hpq]
      exact SetLike.mul_mem_graded a.property b.property⟩
  have hleft : exteriorPower.wedgePairing vol hpq a b = vol z := by
    change (hpq ▸ vol.toLinearMap) (exteriorPower.wedge K M p q a b) = vol z
    apply exterior_cast_apply hpq vol.toLinearMap
    simp only [DirectSum.gMulLHom_apply_apply, SetLike.coe_gMul, z]
  have hright : exteriorPower.wedgePairing vol hru c d = vol z := by
    change (hru ▸ vol.toLinearMap) (exteriorPower.wedge K M r u c d) = vol z
    apply exterior_cast_apply hru vol.toLinearMap
    simpa only [DirectSum.gMulLHom_apply_apply, SetLike.coe_gMul, z] using hmul.symm
  exact hleft.trans hright.symm

/-- Wedge multiplication on the left is adjoint to wedge multiplication on
the right.  This is associativity in the exterior algebra, with all degree
transports checked. -/
theorem wedgeMultiplication_adjoint
    (vol : ⋀[K]^(Module.finrank K M) M ≃ₗ[K] K)
    {p q : ℕ} (h : p + 2 + q = Module.finrank K M)
    (f : ⋀[K]^2 M) (a : ⋀[K]^p M) (b : ⋀[K]^q M) :
    exteriorPower.wedgePairing vol (show p + (2 + q) = Module.finrank K M by omega)
        a (exteriorPower.wedge K M 2 q f b) =
      exteriorPower.wedgePairing vol h (exteriorPower.wedge K M p 2 a f) b := by
  apply wedgePairing_eq_of_mul_eq
  simp only [DirectSum.gMulLHom_apply_apply, SetLike.coe_gMul]
  exact (mul_assoc _ _ _).symm

/-- The complementary-degree annihilator identity for two genuine exterior
two-forms.  The quotient on the right is by their two homogeneous image
spaces, with no rank or nondegeneracy assumption on either form. -/
theorem exterior_common_kernel_finrank
    (vol : ⋀[K]^(Module.finrank K M) M ≃ₗ[K] K)
    {p q : ℕ} (h : p + 2 + q = Module.finrank K M)
    (f g : ⋀[K]^2 M) :
    Module.finrank K
      (LinearMap.ker ((exteriorPower.wedge K M p 2).flip f) ⊓
        LinearMap.ker ((exteriorPower.wedge K M p 2).flip g) :
          Submodule K (⋀[K]^p M)) =
      Module.finrank K
        ((⋀[K]^(2 + q) M) ⧸
          (LinearMap.range (exteriorPower.wedge K M 2 q f) ⊔
            LinearMap.range (exteriorPower.wedge K M 2 q g))) := by
  exact finrank_common_kernel_eq_quotient
    (exteriorPower.wedgePairing vol
      (show p + (2 + q) = Module.finrank K M by omega))
    (exteriorPower.wedgePairing vol h)
    (exteriorPower.wedge K M 2 q f) (exteriorPower.wedge K M 2 q g)
    ((exteriorPower.wedge K M p 2).flip f) ((exteriorPower.wedge K M p 2).flip g)
    (wedgeMultiplication_adjoint vol h f) (wedgeMultiplication_adjoint vol h g)

/-- Complementary-degree duality expressed with the ideal quotient itself.
This is the unshifted second Koszul homology dimension in Proposition 5.4. -/
theorem exterior_annihilator_quotient_finrank
    (vol : ⋀[K]^(Module.finrank K M) M ≃ₗ[K] K)
    {p q : ℕ} (h : p + 2 + q = Module.finrank K M)
    (f g : ⋀[K]^2 M) :
    Module.finrank K
      (LinearMap.ker ((exteriorPower.wedge K M p 2).flip f) ⊓
        LinearMap.ker ((exteriorPower.wedge K M p 2).flip g) :
          Submodule K (⋀[K]^p M)) =
      Module.finrank K (ExteriorQuotientDegree f g (2 + q)) := by
  have he := (Submodule.quotEquivOfEq _ _
    (exteriorDegreeRelations_eq_images f g q)).finrank_eq
  exact (exterior_common_kernel_finrank vol h f g).trans he.symm

/-- The complementary-degree duality includes both boundary degrees: no
restriction to degrees at least two is imposed on the quotient. -/
theorem exterior_annihilator_quotient_finrank_all
    (vol : ⋀[K]^(Module.finrank K M) M ≃ₗ[K] K)
    {p s : ℕ} (h : p + s = Module.finrank K M)
    (f g : ⋀[K]^2 M) :
    Module.finrank K
      (LinearMap.ker ((exteriorPower.wedge K M p 2).flip f) ⊓
        LinearMap.ker ((exteriorPower.wedge K M p 2).flip g) :
          Submodule K (⋀[K]^p M)) =
      Module.finrank K (ExteriorQuotientDegree f g s) := by
  by_cases hs : 2 ≤ s
  · obtain ⟨q, rfl⟩ := Nat.exists_eq_add_of_le hs
    exact exterior_annihilator_quotient_finrank vol (by omega : p + 2 + q =
      Module.finrank K M) f g
  · have hdim : Module.finrank K (⋀[K]^(p + 2) M) = 0 := by
      rw [exteriorPower.finrank_eq, Nat.choose_eq_zero_of_lt (by omega)]
    haveI : Subsingleton (⋀[K]^(p + 2) M) := Module.finrank_zero_iff.mp hdim
    have hf : (exteriorPower.wedge K M p 2).flip f = 0 := Subsingleton.elim _ _
    have hg : (exteriorPower.wedge K M p 2).flip g = 0 := Subsingleton.elim _ _
    rw [hf, hg, LinearMap.ker_zero, inf_idem, finrank_top]
    have he := ((exteriorDegreeRelations f g s).quotEquivOfEqBot
      (exteriorDegreeRelations_eq_bot f g (by omega))).finrank_eq
    change Module.finrank K (⋀[K]^p M) =
      Module.finrank K ((⋀[K]^s M) ⧸ exteriorDegreeRelations f g s)
    rw [he, exteriorPower.finrank_eq, exteriorPower.finrank_eq]
    have hsub : Module.finrank K M - s = p := by omega
    rw [← hsub, Nat.choose_symm (by omega : s ≤ Module.finrank K M)]

/-- Volume-independent dimension statement: every pair of quadratic
relations has the complementary-degree common-annihilator duality. -/
theorem exterior_annihilator_quotient_duality
    {p s : ℕ} (h : p + s = Module.finrank K M) (f g : ⋀[K]^2 M) :
    Module.finrank K (exteriorCommonAnnihilator f g p) =
      Module.finrank K (ExteriorQuotientDegree f g s) :=
  exterior_annihilator_quotient_finrank_all chooseExteriorVolume h f g

end ExteriorAdjoints

end PaperVerification.AlternatingForms
end
