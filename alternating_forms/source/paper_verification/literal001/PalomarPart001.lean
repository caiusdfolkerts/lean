section TAF_LiteralSource_0113
/- Original module: PaperVerification.AlternatingFormsColoredEdges -/


/-!
# The colored-edge estimate used in the cohomology gap

Weights of an exterior power of a direct sum of alternating two-form
representations are represented by distinct colored edges.  This file proves
the complete counting estimate for such edge sets.  The final theorem is the
numerical implication used after Borel--Weil--Bott in Lemma 2.1; this file
does not assert that the Borel--Weil--Bott identification has been formalized.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms

open scoped BigOperators

section Incidence

variable {ι C : Type*} [LinearOrder ι] [Fintype C]

/-- An edge is stored with its color and its two endpoints.  Distinctness
is the `Finset` condition; the theorem below requires strictly ordered
endpoints, so there are neither loops nor two orientations of one edge. -/
abbrev ColoredEdge (C ι : Type*) := C × (ι × ι)

/-- The vertex weight of a set of colored edges. -/
def coloredVertexWeight (E : Finset (ColoredEdge C ι)) (v : ι) : ℕ :=
  ∑ e ∈ E, ((if e.2.1 = v then 1 else 0) + (if e.2.2 = v then 1 else 0))

/-- Double counting vertex incidences in an arbitrary vertex subset. -/
theorem sum_coloredVertexWeight (E : Finset (ColoredEdge C ι)) (P : Finset ι) :
    ∑ v ∈ P, coloredVertexWeight E v =
      ∑ e ∈ E, ((if e.2.1 ∈ P then 1 else 0) + (if e.2.2 ∈ P then 1 else 0)) := by
  classical
  unfold coloredVertexWeight
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro e he
  rw [Finset.sum_add_distrib]
  simp [eq_comm]

/-- There are at most `m * choose(ℓ,2)` selected edges internal to a set
of `ℓ` vertices, where `m` is the total number of available colors. -/
theorem card_internal_coloredEdges_le (E : Finset (ColoredEdge C ι))
    (hE : ∀ e ∈ E, e.2.1 < e.2.2) (P : Finset ι) :
    (E.filter (fun e => e.2.1 ∈ P ∧ e.2.2 ∈ P)).card ≤
      Fintype.card C * P.card.choose 2 := by
  classical
  have hsub : E.filter (fun e => e.2.1 ∈ P ∧ e.2.2 ∈ P) ⊆
      Finset.univ ×ˢ ((P ×ˢ P).filter (fun e => e.1 < e.2)) := by
    intro e he
    obtain ⟨he, hfirst, hsecond⟩ := Finset.mem_filter.mp he
    exact Finset.mem_product.mpr ⟨Finset.mem_univ _,
      Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨hfirst, hsecond⟩, hE e he⟩⟩
  calc
    _ ≤ (Finset.univ ×ˢ ((P ×ˢ P).filter (fun e => e.1 < e.2))).card :=
      Finset.card_le_card hsub
    _ = _ := by rw [Finset.card_product, Finset.card_univ, Finset.card_product_filter_lt]

/-- The colored-edge weight estimate, with no restriction on the number
of vertices, colors, selected edges, or the chosen vertex subset. -/
theorem coloredEdge_weight_bound (E : Finset (ColoredEdge C ι))
    (hE : ∀ e ∈ E, e.2.1 < e.2.2) (P : Finset ι) :
    ∑ v ∈ P, coloredVertexWeight E v ≤
      E.card + Fintype.card C * P.card.choose 2 := by
  classical
  rw [sum_coloredVertexWeight]
  calc
    _ ≤ ∑ e ∈ E, (1 + if e.2.1 ∈ P ∧ e.2.2 ∈ P then 1 else 0) := by
      apply Finset.sum_le_sum
      intro e he
      by_cases hfirst : e.2.1 ∈ P <;>
        by_cases hsecond : e.2.2 ∈ P <;> simp [hfirst, hsecond]
    _ = E.card + (E.filter (fun e => e.2.1 ∈ P ∧ e.2.2 ∈ P)).card := by
      simp [Finset.sum_add_distrib, Finset.sum_boole]
    _ ≤ E.card + Fintype.card C * P.card.choose 2 :=
      Nat.add_le_add_left (card_internal_coloredEdges_le E hE P) _

end Incidence

/-- The triangle-number identity in the division-free form used to cancel
the two copies of the internal-edge bound. -/
theorem two_mul_choose_two_add (ℓ : ℕ) : 2 * ℓ.choose 2 + ℓ = ℓ * ℓ := by
  cases ℓ with
  | zero => simp
  | succ ℓ =>
    have h := Nat.add_one_mul_choose_eq ℓ 1
    simp only [Nat.choose_one_right] at h
    nlinarith

/-- The full numerical conclusion of the colored-edge argument in Lemma
2.1.  The hypotheses state the actual selected-edge realization and the
lower bound supplied by the crossed Bott entries; no rank inequality or
desired cohomology vanishing is assumed. -/
theorem twoColoredEdges_cohomology_gap
    {ι : Type*} [LinearOrder ι] (E : Finset (ColoredEdge (Fin 2) ι))
    (hE : ∀ e ∈ E, e.2.1 < e.2.2) (P : Finset ι)
    (d r : ℕ)
    (hlower : ∀ v ∈ P, d + P.card + r ≤ coloredVertexWeight E v) :
    P.card * d + (r + 1) * P.card ≤ E.card := by
  have hsum : P.card * (d + P.card + r) ≤ ∑ v ∈ P, coloredVertexWeight E v := by
    simpa using Finset.sum_le_sum hlower
  have hupper := coloredEdge_weight_bound E hE P
  simp only [Fintype.card_fin] at hupper
  have hchoose := two_mul_choose_two_add P.card
  nlinarith

end PaperVerification.AlternatingForms
end
end TAF_LiteralSource_0113

section TAF_LiteralSource_0114
/- Original module: PaperVerification.AlternatingFormsOddPluckerDimension -/


/-!
# The odd pencil has the expected Plücker-cone dimension lower bound

The forms below are the two literal path matchings. Their identification with
the existing exterior quadratic forms is proved coefficient by coefficient.
The coordinate plane on the first s odd vertices is common isotropic, giving
the lower dimension bound required by the paper's odd degeneration argument.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open MvPolynomial Matrix
open scoped BigOperators

namespace PaperVerification.AlternatingForms

variable {K : Type*} [Field K] {k t : ℕ}

def oddPluckerEdge (k : ℕ) (l : Fin 2) (i : Fin k) : StrictPairs (2*k+1) :=
  ⟨(⟨2*i.val+l.val,by have := i.isLt; have := l.isLt; omega⟩,
    ⟨2*i.val+l.val+1,by have := i.isLt; have := l.isLt; omega⟩),by
      change 2*i.val+l.val < 2*i.val+l.val+1
      omega⟩

def oddPluckerForms (k : ℕ) (l : Fin 2) (a : StrictPairs (2*k+1)) : K :=
  ∑ i : Fin k, if a=oddPluckerEdge k l i then 1 else 0

def twoFormOfCoefficients {M : Type*} [AddCommGroup M] [Module K M]
    {n : ℕ} (f : StrictPairs n → K) (z : Fin n → M) : ⋀[K]^2 M :=
  ∑ a : StrictPairs n, f a • exteriorPair (z a.val.1) (z a.val.2)

theorem oddPluckerForms_twoForm {M : Type*} [AddCommGroup M] [Module K M]
    (k : ℕ) (l : Fin 2) (z : Fin (2*k+1) → M) :
    twoFormOfCoefficients (oddPluckerForms (K := K) k l) z =
      ∑ i : Fin k, exteriorPair (z (oddPluckerEdge k l i).val.1)
        (z (oddPluckerEdge k l i).val.2) := by
  classical
  simp only [twoFormOfCoefficients,oddPluckerForms,Finset.sum_smul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [ite_smul,one_smul,zero_smul,Finset.sum_ite_eq',Finset.mem_univ,ite_true]

theorem oddPluckerForms_first
    {M : Type*} [AddCommGroup M] [Module K M] (k : ℕ) (z : Fin (2*k+1) → M) :
    twoFormOfCoefficients (oddPluckerForms (K := K) k 0) z = oddPathFirstQuadratic z := by
  rw [oddPluckerForms_twoForm]
  rfl

theorem oddPluckerForms_second
    {M : Type*} [AddCommGroup M] [Module K M] (k : ℕ) (z : Fin (2*k+1) → M) :
    twoFormOfCoefficients (oddPluckerForms (K := K) k 1) z = oddPathSecondQuadratic z := by
  rw [oddPluckerForms_twoForm]
  rfl

def oddCoordinatePivot (k t : ℕ) (h : t+2≤k+1) : PluckerIndex (t+2) (2*k+1) :=
  ⟨fun i => ⟨2*i.val,by have := i.isLt; omega⟩,by
    intro i j hij
    change 2*i.val<2*j.val
    exact Nat.mul_lt_mul_of_pos_left hij (by decide)⟩

theorem oddCoordinatePlane_isotropic (k t : ℕ) (h : t+2≤k+1)
    (l : Fin 2) (i j : Fin (t+2)) :
    alternatingRowPair (oddPluckerForms (K := K) k l)
      (pluckerCoordinatePlane (K := K) (oddCoordinatePivot k t h)) i j=0 := by
  classical
  simp only [alternatingRowPair,oddPluckerForms,Finset.sum_smul]
  rw [Finset.sum_comm]
  apply Finset.sum_eq_zero
  intro e he
  simp only [ite_smul,one_smul,zero_smul,Finset.sum_ite_eq',Finset.mem_univ,ite_true]
  have h₁ : ¬ ((oddPluckerEdge k l e).val.1 = (oddCoordinatePivot k t h).val i ∧
      (oddPluckerEdge k l e).val.2 = (oddCoordinatePivot k t h).val j) := by
    rintro ⟨ha,hb⟩
    have ha' := congrArg Fin.val ha
    have hb' := congrArg Fin.val hb
    dsimp [oddPluckerEdge,oddCoordinatePivot] at ha' hb'
    omega
  have h₂ : ¬ ((oddPluckerEdge k l e).val.2 = (oddCoordinatePivot k t h).val i ∧
      (oddPluckerEdge k l e).val.1 = (oddCoordinatePivot k t h).val j) := by
    rintro ⟨ha,hb⟩
    have ha' := congrArg Fin.val ha
    have hb' := congrArg Fin.val hb
    dsimp [oddPluckerEdge,oddCoordinatePivot] at ha' hb'
    omega
  simp only [pluckerCoordinatePlane]
  split_ifs <;> simp_all

/-- The complete expected cone lower bound, with the actual canonical pair,
all odd dimensions, and the entire nonempty isotropic-plane range. -/
theorem odd_isotropic_Plucker_cone_dimension_ge
    (k t : ℕ) (h : t+2≤k+1) :
    ((((t+2)*(2*k+2-2*(t+2))+1) : ℕ) : WithBot ℕ∞) ≤
      ringKrullDim (MvPolynomial (PluckerIndex (t+2) (2*k+1)) K ⧸
        isotropicPluckerIdeal (t := t) (oddPluckerForms (K := K) k)) := by
  have hd := isotropic_cone_dimension_bound (oddCoordinatePivot k t h)
    (oddPluckerForms (K := K) k) (oddCoordinatePlane_isotropic k t h)
  have hchoose := two_mul_choose_two_add (t+2)
  have h₁ : (2*k+1-(t+2))+(t+2)=2*k+1 := by omega
  have h₂ : (2*k+2-2*(t+2))+2*(t+2)=2*k+2 := by omega
  have hnum : (t+2)*(2*k+1-(t+2))+1 =
      ((t+2)*(2*k+2-2*(t+2))+1)+2*(t+2).choose 2 := by nlinarith
  rw [hnum,Nat.cast_add] at hd
  exact ENat.WithBot.add_le_add_natCast_right_iff.mp hd

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0114

section TAF_LiteralSource_0115
/- Original module: PaperVerification.AlternatingFormsExteriorCoordinates -/


/-!
# Actual exterior coordinates of the linear Plücker relations

The increasing exterior basis is sent to the literal degree-one Plücker
variables.  Every ordered exterior word is sent to the signed ordered
coordinate already used in the determinant charts.  In particular, the
polynomials defining isotropy are exactly the coordinates of multiplication
by the given two-forms on the entire lower exterior power.
-/

@[expose] public section
set_option autoImplicit false

noncomputable section

namespace PaperVerification.AlternatingForms

open MvPolynomial
open scoped BigOperators

variable {K : Type*} [Field K] {s n t m : ℕ}

@[expose]
def pluckerOrderEmbeddingEquiv (s n : ℕ) :
    PluckerIndex s n ≃ (Fin s ↪o Fin n) where
  toFun I := OrderEmbedding.ofStrictMono I.val I.property
  invFun f := ⟨f,f.strictMono⟩
  left_inv I := rfl
  right_inv f := by ext i; rfl

@[expose]
def pluckerSubsetEquiv (s n : ℕ) :
    PluckerIndex s n ≃ Set.powersetCard (Fin n) s :=
  (pluckerOrderEmbeddingEquiv s n).trans Set.powersetCard.ofFinEmbEquiv

/-- The genuine increasing exterior basis indexed in exactly the same way
as the Plücker polynomial variables. -/
@[expose]
def exteriorPluckerBasis (s n : ℕ) :
    Module.Basis (PluckerIndex s n) K (⋀[K]^s (Fin n → K)) :=
  ((Pi.basisFun K (Fin n)).exteriorPower s).reindex (pluckerSubsetEquiv s n).symm

theorem exteriorPluckerBasis_apply (I : PluckerIndex s n) :
    exteriorPluckerBasis (K := K) s n I =
      exteriorPower.ιMulti K s (fun i => Pi.basisFun K (Fin n) (I.val i)) := by
  simp only [exteriorPluckerBasis,Module.Basis.reindex_apply,Equiv.symm_symm,
    exteriorPower.basis_apply,exteriorPower.ιMulti_family,
    pluckerSubsetEquiv,Equiv.trans_apply,Equiv.symm_apply_apply]
  rfl

/-- The coordinate inclusion into the literal degree-one polynomial space.
Its injectivity below prevents identification of different exterior vectors. -/
def exteriorPluckerCoordinates (s n : ℕ) :
    (⋀[K]^s (Fin n → K)) →ₗ[K] MvPolynomial (PluckerIndex s n) K :=
  (exteriorPluckerBasis s n).constr K MvPolynomial.X

@[simp] theorem exteriorPluckerCoordinates_basis (I : PluckerIndex s n) :
    exteriorPluckerCoordinates (K := K) s n (exteriorPluckerBasis s n I)=X I :=
  Module.Basis.constr_basis _ _ _ _

theorem exteriorPluckerCoordinates_injective (s n : ℕ) :
    Function.Injective (exteriorPluckerCoordinates (K := K) s n) :=
  (exteriorPluckerBasis s n).injective_constr_of_linearIndependent
    (MvPolynomial.linearIndependent_X (PluckerIndex s n) K)

/-- Ordered words, including repeated coordinates, have the very same
sorting sign as the universal determinant coordinate. -/
theorem exteriorPluckerCoordinates_word (I : Fin s → Fin n) :
    exteriorPluckerCoordinates (K := K) s n
      (exteriorPower.ιMulti K s (fun i => Pi.basisFun K (Fin n) (I i))) =
        orderedPluckerCoordinate I := by
  classical
  by_cases hI : Function.Injective I
  · have hword :
        exteriorPower.ιMulti K s (fun i => Pi.basisFun K (Fin n) (I i)) =
          Equiv.Perm.sign (Tuple.sort I).symm •
            exteriorPluckerBasis (K := K) s n (sortedPluckerIndex I hI) := by
      rw [exteriorPluckerBasis_apply]
      have h := (exteriorPower.ιMulti K s (M := Fin n → K)).map_perm
        (fun i => Pi.basisFun K (Fin n) (I (Tuple.sort I i))) (Tuple.sort I).symm
      simpa only [Function.comp_def,Equiv.apply_symm_apply,sortedPluckerIndex] using h
    rw [hword,map_zsmul_unit,exteriorPluckerCoordinates_basis]
    simp only [orderedPluckerCoordinate,dif_pos hI,Units.smul_def,
      Int.cast_smul_eq_zsmul]
  · have hword : ¬Function.Injective
        (fun i => Pi.basisFun K (Fin n) (I i)) := by
      intro h
      exact hI (fun i j hij => h (congrArg (Pi.basisFun K (Fin n)) hij))
    rw [(exteriorPower.ιMulti K s).map_eq_zero_of_not_injective _ hword,map_zero]
    simp only [orderedPluckerCoordinate,dif_neg hI]

/-- Multiplication by the literal two-form, on the entire degree `t` exterior
power and with the target degree written as `t+2`. -/
def coefficientWedge (f : StrictPairs n → K) :
    (⋀[K]^t (Fin n → K)) →ₗ[K] (⋀[K]^(t+2) (Fin n → K)) where
  toFun x := ⟨(twoFormOfCoefficients f (Pi.basisFun K (Fin n)) :
      ExteriorAlgebra K (Fin n → K)) * x,
    by
      simpa only [Nat.add_comm 2 t] using
        (SetLike.mul_mem_graded
          (twoFormOfCoefficients f (Pi.basisFun K (Fin n))).property x.property)⟩
  map_add' x y := Subtype.ext (mul_add _ _ _)
  map_smul' c x := Subtype.ext (mul_smul_comm _ _ _)

theorem coefficientWedge_word (f : StrictPairs n → K) (J : Fin t → Fin n) :
    coefficientWedge (t := t) f
      (exteriorPower.ιMulti K t (fun i => Pi.basisFun K (Fin n) (J i))) =
      ∑ a : StrictPairs n, f a • exteriorPower.ιMulti K (t+2)
        (fun i => Pi.basisFun K (Fin n)
          (Fin.cons (α := fun _ => Fin n) a.val.1
            (Fin.cons (α := fun _ => Fin n) a.val.2 J) i)) := by
  apply Subtype.ext
  simp only [coefficientWedge,twoFormOfCoefficients,Submodule.coe_smul,
    AddSubmonoidClass.coe_finsetSum,exteriorPair_coe,exteriorPower.ιMulti_apply_coe,
    Finset.sum_mul,smul_mul_assoc]
  apply Finset.sum_congr rfl
  intro a ha
  congr 1
  simp only [ExteriorAlgebra.ιMulti_succ_apply,Fin.cons_zero,Fin.cons_succ,
    Matrix.vecTail,mul_assoc,Function.comp_def,exteriorPower.ιMulti_apply_coe]

/-- Each displayed linear isotropy equation is precisely the coordinate
image of the actual wedge product, without a presentation assumption. -/
theorem exteriorPluckerCoordinates_wedge_word
    (f : StrictPairs n → K) (J : Fin t → Fin n) :
    exteriorPluckerCoordinates (K := K) (t+2) n
      (coefficientWedge f
        (exteriorPower.ιMulti K t (fun i => Pi.basisFun K (Fin n) (J i)))) =
      pluckerIsotropyEquation f J := by
  rw [coefficientWedge_word,map_sum]
  simp only [map_smul,exteriorPluckerCoordinates_word,pluckerIsotropyEquation]

theorem exteriorPluckerCoordinates_wedge_mem
    (f : StrictPairs n → K) (η : ⋀[K]^t (Fin n → K)) :
    exteriorPluckerCoordinates (K := K) (t+2) n (coefficientWedge f η) ∈
      Ideal.span (Set.range (pluckerIsotropyEquation (t := t) f)) := by
  classical
  rw [←(exteriorPluckerBasis (K := K) t n).sum_repr η]
  simp only [map_sum,map_smul]
  apply (Ideal.span (Set.range (pluckerIsotropyEquation (t := t) f))).sum_mem
  intro I hI
  rw [Algebra.smul_def]
  apply Ideal.mul_mem_left
  rw [exteriorPluckerBasis_apply,exteriorPluckerCoordinates_wedge_word]
  exact Ideal.subset_span ⟨I.val,rfl⟩

/-- Equality of the complete generated ideals, so arbitrary lower-degree
exterior vectors introduce neither more nor fewer linear relations. -/
theorem wedgeCoordinates_span_eq (f : StrictPairs n → K) :
    Ideal.span (Set.range fun η : ⋀[K]^t (Fin n → K) =>
      exteriorPluckerCoordinates (K := K) (t+2) n (coefficientWedge f η)) =
        Ideal.span (Set.range (pluckerIsotropyEquation (t := t) f)) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨η,rfl⟩
    exact exteriorPluckerCoordinates_wedge_mem f η
  · apply Ideal.span_le.mpr
    rintro _ ⟨J,rfl⟩
    apply Ideal.subset_span
    refine ⟨exteriorPower.ιMulti K t (fun i => Pi.basisFun K (Fin n) (J i)),?_⟩
    exact exteriorPluckerCoordinates_wedge_word f J

/-- The actual ideal used by the determinant charts is exactly the
Grassmannian identity ideal plus the coordinate image of all genuine
two-form wedge relations. All forms and all exterior degrees are retained. -/
theorem isotropicPluckerIdeal_eq_wedgeCoordinates
    (forms : Fin m → StrictPairs n → K) :
    isotropicPluckerIdeal (t := t) forms = matrixPluckerIdeal ⊔
      Ideal.span (Set.range fun a : Fin m × (⋀[K]^t (Fin n → K)) =>
        exteriorPluckerCoordinates (K := K) (t+2) n
          (coefficientWedge (forms a.1) a.2)) := by
  unfold isotropicPluckerIdeal
  congr 1
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨l,J⟩,rfl⟩
    apply Ideal.subset_span
    refine ⟨(l,exteriorPower.ιMulti K t (fun i => Pi.basisFun K (Fin n) (J i))),?_⟩
    exact exteriorPluckerCoordinates_wedge_word (forms l) J
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨l,η⟩,rfl⟩
    apply Ideal.span_mono ?_ (exteriorPluckerCoordinates_wedge_mem (forms l) η)
    rintro _ ⟨J,rfl⟩
    exact ⟨(l,J),rfl⟩

end PaperVerification.AlternatingForms
end
end
end TAF_LiteralSource_0115

section TAF_LiteralSource_0116
/- Original module: PaperVerification.AlternatingFormsPrefixSupport -/


/-!
# The actual prefix inverse with its complete singleton-preserving support

The strict weight argument requires more than existence of an inverse in
the prefix exterior power. This file retains the actual finite Boolean
inverse formula and proves that its support changes only the unoccupied
matching pairs. The fixed singleton word is the original one throughout.
-/

@[expose] public section
set_option autoImplicit false

noncomputable section

namespace PaperVerification.AlternatingForms

open scoped BigOperators

variable {K M ι : Type*} [Field K] [AddCommGroup M] [Module K M]
  [DecidableEq ι] [Fintype ι]

def prefixSingletons (A B : Finset ι) : Finset ι := (A \ B) ∪ (B \ A)

def prefixSingletonWord (u v : ι → M) (A B : Finset ι) : List M :=
  (A \ B).toList.map u ++ (B \ A).toList.map v

abbrev PrefixFreePair (A B : Finset ι) := {i : ι // i ∉ prefixSingletons A B}

def prefixInverseState (u v : ι → M) (A B : Finset ι)
    (T : FixedSubsets (PrefixFreePair A B) ((A ∩ B).card-1)) : ExteriorAlgebra K M :=
  ((prefixSingletonWord u v A B).map (ExteriorAlgebra.ι K)).prod *
    pairedMonomial (fun i : PrefixFreePair A B => u i.val)
      (fun i : PrefixFreePair A B => v i.val) T.val

def prefixInverseSpace (u v : ι → M) (A B : Finset ι) :
    Submodule K (ExteriorAlgebra K M) :=
  Submodule.span K (Set.range (prefixInverseState (K := K) u v A B))

theorem prefixInverseState_mem_degree (u v : ι → M) (A B : Finset ι)
    (hdegree : A.card+B.card=Fintype.card ι+1)
    (T : FixedSubsets (PrefixFreePair A B) ((A ∩ B).card-1)) :
    prefixInverseState (K := K) u v A B T ∈ ⋀[K]^(Fintype.card ι-1) M := by
  have hc := (prefix_occupancy_counts A B hdegree).2.2
  have hlen : (prefixSingletonWord u v A B).length+2*T.val.card=Fintype.card ι-1 := by
    simpa only [prefixSingletonWord,List.length_append,List.length_map,
      Finset.length_toList,T.property] using hc
  rw [prefixInverseState,←hlen]
  exact SetLike.mul_mem_graded (exteriorWord_mem _)
    (pairedMonomial_mem (fun i : PrefixFreePair A B => u i.val)
      (fun i : PrefixFreePair A B => v i.val) T.val)

theorem prefixInverseSpace_le_degree (u v : ι → M) (A B : Finset ι)
    (hdegree : A.card+B.card=Fintype.card ι+1) :
    prefixInverseSpace (K := K) u v A B ≤ ⋀[K]^(Fintype.card ι-1) M := by
  apply Submodule.span_le.mpr
  rintro _ ⟨T,rfl⟩
  exact prefixInverseState_mem_degree u v A B hdegree T

/-- The prefix inverse in full generality, with its actual finite support.
The support statement is derived from the same inverse formula as the
identity; it is not an added assumption on a chosen preimage. -/
theorem prefix_selection_division_with_support [CharZero K] (u v : ι → M) (A B : Finset ι)
    (hdegree : A.card+B.card=Fintype.card ι+1) :
    ∃ η : ⋀[K]^(Fintype.card ι-1) M,
      (∑ i, ExteriorAlgebra.ι K (u i)*ExteriorAlgebra.ι K (v i))*η =
        ((A.toList.map u++B.toList.map v).map (ExteriorAlgebra.ι K)).prod ∧
      (η : ExteriorAlgebra K M) ∈ prefixInverseSpace u v A B := by
  classical
  let S := prefixSingletons A B
  let L := prefixSingletonWord u v A B
  let n := (A ∩ B).card-1
  have hcounts := prefix_occupancy_counts A B hdegree
  have hP := doublePairs_disjoint_singletons A B
  have hPS : ∀ i ∈ A ∩ B,i ∉ S := hP
  let P : FixedSubsets (PrefixFreePair A B) (n+1) :=
    ⟨(A ∩ B).subtype (fun i => i ∉ S),by
      rw [Finset.card_subtype,Finset.filter_eq_self.mpr hPS]
      dsimp [n]
      omega⟩
  let z : ExteriorAlgebra K M := (L.map (ExteriorAlgebra.ι K)).prod
  let η₀ : ExteriorAlgebra K M := z *
    ∑ T : FixedSubsets (PrefixFreePair A B) n,
      inverseCoefficient (K := K) n (T.val ∩ P.val).card •
        pairedMonomial (fun i : PrefixFreePair A B => u i.val)
          (fun i : PrefixFreePair A B => v i.val) T.val
  have hηmem : η₀ ∈ prefixInverseSpace (K := K) u v A B := by
    dsimp only [η₀]
    rw [Finset.mul_sum]
    apply Submodule.sum_mem
    intro T hT
    rw [mul_smul_comm]
    apply Submodule.smul_mem
    exact Submodule.subset_span ⟨T,rfl⟩
  have hL : ∀ i ∈ S,u i∈L ∨ v i∈L := by
    intro i hi
    rcases Finset.mem_union.mp hi with hi | hi
    · exact Or.inl (List.mem_append_left _
        (List.mem_map.mpr ⟨i,Finset.mem_toList.mpr hi,rfl⟩))
    · exact Or.inr (List.mem_append_right _
        (List.mem_map.mpr ⟨i,Finset.mem_toList.mpr hi,rfl⟩))
  have hη := local_exterior_pair_division_with_singletons (K := K)
    u v S L hL n hcounts.2.1 P
  obtain ⟨ε,hε,heq⟩ := exterior_monomial_singleton_pair_factorization (K := K) u v A B
  have hηscaled : ε • η₀ ∈ prefixInverseSpace (K := K) u v A B :=
    Submodule.smul_mem _ _ hηmem
  refine ⟨⟨ε • η₀,prefixInverseSpace_le_degree u v A B hdegree hηscaled⟩,?_,hηscaled⟩
  change (∑ i, ExteriorAlgebra.ι K (u i)*ExteriorAlgebra.ι K (v i))*(ε • η₀)=_
  rw [mul_smul_comm]
  change ε • ((∑ i, ExteriorAlgebra.ι K (u i)*ExteriorAlgebra.ι K (v i))*η₀)=_
  rw [show (∑ i, ExteriorAlgebra.ι K (u i)*ExteriorAlgebra.ι K (v i))*η₀ =
    z * pairedMonomial (fun i : PrefixFreePair A B => u i.val)
      (fun i : PrefixFreePair A B => v i.val) P.val from hη]
  have hpair : pairedMonomial (K := K) (fun i : PrefixFreePair A B => u i.val)
      (fun i : PrefixFreePair A B => v i.val) P.val = pairedMonomial (K := K) u v (A ∩ B) := by
    exact pairedMonomial_subtype (K := K) (S := S) hPS u v
