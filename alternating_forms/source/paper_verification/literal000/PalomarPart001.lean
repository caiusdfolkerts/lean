/- Original module: PaperVerification.AlternatingFormsEvenDeterminants -/


/-!
# Universal determinant vectors for two Boolean derivatives

For an odd set of columns of size 2r+1, the determinant has r variable rows
and r+1 constant rows. Both directional derivatives replace a variable row
by one of its adjacent constant rows. The determinant therefore lies in the
joint kernel over every commutative coefficient ring.

These are explicit vectors, not generators assumed from an invariant-ring
presentation. Their independence and comparison with the actual Boolean
quotient are separate obligations.
-/

@[expose] public section
noncomputable section

set_option autoImplicit false

namespace PaperVerification.AlternatingForms.EvenDeterminants

open scoped BigOperators
open MvPolynomial

variable {K α : Type*} [CommRing K]

/-- The constant rows are indexed by the left summand and the variable rows
by the right summand. Their interleaved order is used only for leading terms. -/
abbrev OddRows (r : ℕ) := Fin (r + 1) ⊕ Fin r

/-- The actual derivation taking each variable y_i to the specified scalar. -/
def directionalDerivative (b : α → K) :
    Derivation K (MvPolynomial α K) (MvPolynomial α K) :=
  MvPolynomial.mkDerivation K (fun i => C (b i))

@[simp] theorem directionalDerivative_X (b : α → K) (i : α) :
    directionalDerivative b (X i) = C (b i) :=
  MvPolynomial.mkDerivation_X _ _ i

/-- The odd-subset determinant matrix after setting all auxiliary x_i to one. -/
def oddSubsetMatrix (r : ℕ) (b c : α → K) (a : OddRows r → α) :
    Matrix (OddRows r) (OddRows r) (MvPolynomial α K) :=
  Matrix.of fun row col =>
    match row with
    | Sum.inl i => C (b (a col) ^ (r - i.val) * c (a col) ^ i.val)
    | Sum.inr i => C (b (a col) ^ (r - 1 - i.val) * c (a col) ^ i.val) * X (a col)

@[simp] theorem oddSubsetMatrix_even (r : ℕ) (b c : α → K)
    (a : OddRows r → α) (i : Fin (r + 1)) (j : OddRows r) :
    oddSubsetMatrix r b c a (Sum.inl i) j =
      C (b (a j) ^ (r - i.val) * c (a j) ^ i.val) := rfl

@[simp] theorem oddSubsetMatrix_odd (r : ℕ) (b c : α → K)
    (a : OddRows r → α) (i : Fin r) (j : OddRows r) :
    oddSubsetMatrix r b c a (Sum.inr i) j =
      C (b (a j) ^ (r - 1 - i.val) * c (a j) ^ i.val) * X (a j) := rfl

/-- The universal multiaffine determinant vector attached to the selected columns. -/
def oddSubsetDeterminant (r : ℕ) (b c : α → K) (a : OddRows r → α) :
    MvPolynomial α K :=
  (oddSubsetMatrix r b c a).det

@[simp] theorem derivative_first_even (r : ℕ) (b c : α → K)
    (a : OddRows r → α) (i : Fin (r + 1)) (j : OddRows r) :
    directionalDerivative b (oddSubsetMatrix r b c a (Sum.inl i) j) = 0 := by
  simp

@[simp] theorem derivative_second_even (r : ℕ) (b c : α → K)
    (a : OddRows r → α) (i : Fin (r + 1)) (j : OddRows r) :
    directionalDerivative c (oddSubsetMatrix r b c a (Sum.inl i) j) = 0 := by
  simp

theorem derivative_first_odd (r : ℕ) (b c : α → K)
    (a : OddRows r → α) (i : Fin r) (j : OddRows r) :
    directionalDerivative b (oddSubsetMatrix r b c a (Sum.inr i) j) =
      oddSubsetMatrix r b c a (Sum.inl i.castSucc) j := by
  have hexp : r - i.val = (r - 1 - i.val) + 1 := by omega
  simp only [oddSubsetMatrix_odd, oddSubsetMatrix_even, Derivation.leibniz,
    MvPolynomial.derivation_C, directionalDerivative_X, smul_zero, add_zero,
    smul_eq_mul, ← MvPolynomial.C_mul, Fin.val_castSucc]
  congr 1
  rw [hexp, pow_succ]
  ring

theorem derivative_second_odd (r : ℕ) (b c : α → K)
    (a : OddRows r → α) (i : Fin r) (j : OddRows r) :
    directionalDerivative c (oddSubsetMatrix r b c a (Sum.inr i) j) =
      oddSubsetMatrix r b c a (Sum.inl i.succ) j := by
  have hexp : r - 1 - i.val = r - (i.val + 1) := by omega
  simp only [oddSubsetMatrix_odd, oddSubsetMatrix_even, Derivation.leibniz,
    MvPolynomial.derivation_C, directionalDerivative_X, smul_zero, add_zero,
    smul_eq_mul, ← MvPolynomial.C_mul, Fin.val_succ]
  congr 1
  rw [hexp, pow_succ]
  ring

/-- The first literal Boolean directional derivative kills the determinant. -/
theorem oddSubsetDeterminant_first_kernel (r : ℕ) (b c : α → K)
    (a : OddRows r → α) :
    directionalDerivative b (oddSubsetDeterminant r b c a) = 0 := by
  classical
  rw [oddSubsetDeterminant,
    PaperVerification.DeterminantDerivation.derivation_det_rows]
  apply Finset.sum_eq_zero
  intro row hrow
  cases row with
  | inl i =>
    apply Matrix.det_eq_zero_of_row_eq_zero (Sum.inl i)
    intro j
    rw [Matrix.updateRow_self, derivative_first_even]
  | inr i =>
    have hrow :
        (fun j => directionalDerivative b (oddSubsetMatrix r b c a (Sum.inr i) j)) =
          oddSubsetMatrix r b c a (Sum.inl i.castSucc) :=
      funext (derivative_first_odd r b c a i)
    rw [hrow]
    exact Matrix.det_updateRow_eq_zero (Sum.inl_ne_inr)

/-- The second literal Boolean directional derivative kills the determinant. -/
theorem oddSubsetDeterminant_second_kernel (r : ℕ) (b c : α → K)
    (a : OddRows r → α) :
    directionalDerivative c (oddSubsetDeterminant r b c a) = 0 := by
  classical
  rw [oddSubsetDeterminant,
    PaperVerification.DeterminantDerivation.derivation_det_rows]
  apply Finset.sum_eq_zero
  intro row hrow
  cases row with
  | inl i =>
    apply Matrix.det_eq_zero_of_row_eq_zero (Sum.inl i)
    intro j
    rw [Matrix.updateRow_self, derivative_second_even]
  | inr i =>
    have hrow :
        (fun j => directionalDerivative c (oddSubsetMatrix r b c a (Sum.inr i) j)) =
          oddSubsetMatrix r b c a (Sum.inl i.succ) :=
      funext (derivative_second_odd r b c a i)
    rw [hrow]
    exact Matrix.det_updateRow_eq_zero (Sum.inl_ne_inr)

/-- Products of these explicit determinants remain in the same joint kernel. -/
theorem determinant_product_joint_kernel {ι : Type*} (s : Finset ι)
    (r : ι → ℕ) (b c : α → K) (a : (i : ι) → OddRows (r i) → α) :
    directionalDerivative b (∏ i ∈ s, oddSubsetDeterminant (r i) b c (a i)) = 0 ∧
    directionalDerivative c (∏ i ∈ s, oddSubsetDeterminant (r i) b c (a i)) = 0 := by
  classical
  constructor
  · rw [PaperVerification.DeterminantDerivation.derivation_finset_prod]
    simp only [oddSubsetDeterminant_first_kernel, zero_mul, Finset.sum_const_zero]
  · rw [PaperVerification.DeterminantDerivation.derivation_finset_prod]
    simp only [oddSubsetDeterminant_second_kernel, zero_mul, Finset.sum_const_zero]

end PaperVerification.AlternatingForms.EvenDeterminants

end
end
end TAF_LiteralSource_0043

section TAF_LiteralSource_0044
/- Original module: PaperVerification.AlternatingFormsBooleanCoefficients -/


/-!
# Actual square-free polynomial coefficient spaces

The finite coordinate model is proved equivalent to the concrete homogeneous
multiaffine subspace of the ordinary polynomial ring. Directional derivatives
are computed on the original polynomial, including the vanishing of possible
repeated-variable terms. These are the coefficient spaces dual to the actual
Boolean multiplication matrices used in the even-pencil decomposition.
-/

@[expose] public section

set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms.BooleanCoefficients

open scoped BigOperators
open MvPolynomial
open EvenDeterminants

variable {K ι : Type*} [CommRing K] [Fintype ι] [DecidableEq ι]

/-- The ordinary square-free exponent attached to a finite subset. -/
def subsetExponent (s : Finset ι) : ι →₀ ℕ :=
  Finsupp.indicator s (fun _ _ => 1)

@[simp] theorem subsetExponent_apply (s : Finset ι) (i : ι) :
    subsetExponent s i = if i ∈ s then 1 else 0 := by
  simp [subsetExponent, Finsupp.indicator_apply]

@[simp] theorem subsetExponent_support (s : Finset ι) :
    (subsetExponent s).support = s := by
  ext i
  simp [Finsupp.mem_support_iff, subsetExponent_apply]

theorem subsetExponent_injective : Function.Injective (subsetExponent (ι := ι)) := by
  intro s t h
  simpa only [subsetExponent_support] using congrArg Finsupp.support h

@[simp] theorem subsetExponent_degree (s : Finset ι) :
    (subsetExponent s).degree = s.card := by
  rw [Finsupp.degree_apply, subsetExponent_support]
  simp only [subsetExponent_apply, Finset.mem_of_mem_filter]
  simp

def subsetMonomial (s : Finset ι) : MvPolynomial ι K :=
  monomial (subsetExponent s) 1

theorem subsetMonomial_eq_prod (s : Finset ι) :
    subsetMonomial (K := K) s = ∏ i ∈ s, (X i : MvPolynomial ι K) := by
  simpa only [subsetMonomial, subsetExponent, pow_one] using
    (MvPolynomial.prod_X_pow (R := K) (fun _ : ι => 1) s).symm

@[simp] theorem subsetMonomial_coeff (s t : Finset ι) :
    (subsetMonomial (K := K) s).coeff (subsetExponent t) =
      if s = t then 1 else 0 := by
  simp only [subsetMonomial, coeff_monomial, subsetExponent_injective.eq_iff]

/-- Actual expansion in the square-free monomials of degree q. -/
def evaluation (q : ℕ) :
    (FixedSubsets ι q → K) →ₗ[K] MvPolynomial ι K where
  toFun c := ∑ U, c U • subsetMonomial U.val
  map_add' c d := by simp [Pi.add_apply, add_smul, Finset.sum_add_distrib]
  map_smul' a c := by simp [Pi.smul_apply, smul_smul, Finset.smul_sum]

theorem evaluation_coeff (q : ℕ) (c : FixedSubsets ι q → K)
    (U : FixedSubsets ι q) :
    (evaluation q c).coeff (subsetExponent U.val) = c U := by
  classical
  simp only [evaluation, LinearMap.coe_mk, AddHom.coe_mk, coeff_sum, coeff_smul,
    subsetMonomial_coeff, smul_eq_mul]
  have he (V : FixedSubsets ι q) : V.val = U.val ↔ V = U := Subtype.val_inj
  simp only [he, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]

theorem evaluation_injective (q : ℕ) : Function.Injective (evaluation (K := K) (ι := ι) q) := by
  intro c d h
  funext U
  have hc := congrArg (fun f : MvPolynomial ι K => f.coeff (subsetExponent U.val)) h
  simpa only [evaluation_coeff] using hc

/-- A supported exponent of a multiaffine homogeneous polynomial is an actual q-subset. -/
theorem support_exponent_subset (q : ℕ) (f : MvPolynomial ι K)
    (hhom : f.IsHomogeneous q) (hmulti : ∀ i, f.degreeOf i ≤ 1)
    (d : ι →₀ ℕ) (hd : d ∈ f.support) :
    ∃ U : FixedSubsets ι q, subsetExponent U.val = d := by
  have hbound (i : ι) : d i ≤ 1 :=
    (MvPolynomial.monomial_le_degreeOf i hd).trans (hmulti i)
  have hdegree : d.degree = q := by
    by_contra h
    exact (MvPolynomial.mem_support_iff.mp hd) (hhom.coeff_eq_zero h)
  have he : subsetExponent d.support = d := by
    ext i
    by_cases hi : i ∈ d.support
    · have hn : d i ≠ 0 := Finsupp.mem_support_iff.mp hi
      have hiBound := hbound i
      simp only [subsetExponent_apply, hi, if_true]
      omega
    · simp only [subsetExponent_apply, hi, if_false,
        Finsupp.notMem_support_iff.mp hi]
  refine ⟨⟨d.support, ?_⟩, he⟩
  have hh := congrArg Finsupp.degree he
  simpa only [subsetExponent_degree, hdegree] using hh

/-- The concrete finite coefficient expansion recovers every homogeneous
multiaffine polynomial; no basis-size assertion is assumed. -/
theorem evaluation_coefficients_eq (q : ℕ) (f : MvPolynomial ι K)
    (hhom : f.IsHomogeneous q) (hmulti : ∀ i, f.degreeOf i ≤ 1) :
    evaluation q (fun U => f.coeff (subsetExponent U.val)) = f := by
  apply MvPolynomial.ext
  intro d
  by_cases hd : ∃ U : FixedSubsets ι q, subsetExponent U.val = d
  · obtain ⟨U, rfl⟩ := hd
    exact evaluation_coeff q _ U
  · have hz : f.coeff d = 0 := by
      apply MvPolynomial.notMem_support_iff.mp
      intro hs
      exact hd (support_exponent_subset q f hhom hmulti d hs)
    rw [hz]
    change (∑ U : FixedSubsets ι q,
      f.coeff (subsetExponent U.val) • subsetMonomial U.val).coeff d = 0
    rw [coeff_sum]
    apply Finset.sum_eq_zero
    intro U hU
    have hne : subsetExponent U.val ≠ d := fun h => hd ⟨U, h⟩
    simp only [coeff_smul, subsetMonomial, coeff_monomial, if_neg hne, smul_zero]

theorem directionalDerivative_eq_sum (b : ι → K) :
    directionalDerivative b =
      ∑ i, (MvPolynomial.C (b i) : MvPolynomial ι K) • MvPolynomial.pderiv i := by
  apply MvPolynomial.derivation_ext
  intro j
  rw [directionalDerivative_X]
  simp [sum_apply, Derivation.smul_apply, MvPolynomial.pderiv_X,
    smul_eq_mul, Pi.single_apply, mul_ite]

/-- The exact coefficient formula for the original derivation. -/
theorem directionalDerivative_coeff (b : ι → K) (f : MvPolynomial ι K)
    (d : ι →₀ ℕ) :
    (directionalDerivative b f).coeff d =
      ∑ i, b i * (f.coeff (d + Finsupp.single i 1) * (d i + 1)) := by
  rw [directionalDerivative_eq_sum]
  simp only [sum_apply, Derivation.smul_apply, smul_eq_mul,
    coeff_sum, coeff_C_mul, MvPolynomial.coeff_pderiv]

theorem subsetExponent_insert {s : Finset ι} {i : ι} (hi : i ∉ s) :
    subsetExponent s + Finsupp.single i 1 = subsetExponent (insert i s) := by
  ext j
  simp only [Finsupp.add_apply, Finsupp.single_apply, subsetExponent_apply,
    Finset.mem_insert]
  by_cases hji : j = i
  · subst j
    simp [hi]
  · simp [hji, Ne.symm hji]

/-- On a genuine multiaffine polynomial, the square-free derivative matrix has
only the expected insertion coefficients; repeated-variable terms vanish. -/
theorem directionalDerivative_subset_coeff (b : ι → K) (f : MvPolynomial ι K)
    (hmulti : ∀ i, f.degreeOf i ≤ 1) (T : Finset ι) :
    (directionalDerivative b f).coeff (subsetExponent T) =
      ∑ i ∈ Finset.univ.filter (fun i => i ∉ T),
        b i * f.coeff (subsetExponent (insert i T)) := by
  rw [directionalDerivative_coeff, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro i hi
  by_cases hm : i ∈ T
  · have hz : f.coeff (subsetExponent T + Finsupp.single i 1) = 0 := by
      apply MvPolynomial.notMem_support_iff.mp
      apply MvPolynomial.notMem_support_of_degreeOf_lt i
      simp only [Finsupp.add_apply, subsetExponent_apply, hm, if_true,
        Finsupp.single_eq_same]
      exact lt_of_le_of_lt (hmulti i) (by decide)
    simp only [hm, not_true_eq_false, if_false, hz, zero_mul, mul_zero]
  · rw [subsetExponent_insert hm]
    simp [subsetExponent_apply, hm]

end PaperVerification.AlternatingForms.BooleanCoefficients

end
end
end TAF_LiteralSource_0044

section TAF_LiteralSource_0045
/- Original module: PaperVerification.AlternatingFormsPowerIdeal -/


/-!
# Coordinate-power ideals and the logarithmic partial derivatives

These are the polynomial-ideal facts used in the integration-annihilator
calculation.  They concern actual ideals and actual polynomial coefficients.
The operator `X i * pderiv i` preserves every coordinate-power ideal.  This
avoids taking rational partial fractions in the odd annihilator calculation.
-/

@[expose] public section

set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms

open MvPolynomial

variable {R σ : Type*} [CommRing R]

/-- The ideal generated by the specified powers of the coordinate variables. -/
def coordinatePowerIdeal (e : σ → ℕ) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun i => (X i : MvPolynomial σ R) ^ e i)

theorem coordinatePowerIdeal_generator (e : σ → ℕ) (i : σ) :
    (X i : MvPolynomial σ R) ^ e i ∈ coordinatePowerIdeal e :=
  Ideal.subset_span ⟨i, rfl⟩

/-- A coefficient strictly below every generating exponent vanishes on the
whole ideal, including after arbitrary polynomial multiplication. -/
theorem coefficient_zero_of_mem_coordinatePowerIdeal [DecidableEq σ]
    (e : σ → ℕ) {p : MvPolynomial σ R} (hp : p ∈ coordinatePowerIdeal e)
    (m : σ →₀ ℕ) (hm : ∀ i, m i < e i) : p.coeff m = 0 := by
  have hall : ∀ p : MvPolynomial σ R, p ∈ coordinatePowerIdeal e →
      ∀ m : σ →₀ ℕ, (∀ i, m i < e i) → p.coeff m = 0 := by
    intro p hp
    induction hp using Submodule.span_induction with
    | mem p hp =>
      obtain ⟨i, rfl⟩ := hp
      intro m hm
      have hne : Finsupp.single i (e i) ≠ m := by
        intro heq
        have hi := hm i
        rw [← heq, Finsupp.single_eq_same] at hi
        exact (Nat.lt_irrefl _) hi
      simp only [X_pow_eq_monomial, coeff_monomial, if_neg hne]
    | zero => intro m hm; simp
    | add p q hp hq ihp ihq =>
      intro m hm
      rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, ihp m hm, ihq m hm, add_zero]
    | smul r p hp ih =>
      intro m hm
      change (r * p).coeff m = 0
      rw [coeff_mul]
      apply Finset.sum_eq_zero
      rintro ⟨a, b⟩ hab
      have hab' : a + b = m := Finset.mem_antidiagonal.mp hab
      have hb : ∀ i, b i < e i := by
        intro i
        have hi := congrArg (fun d : σ →₀ ℕ => d i) hab'
        simp only [Finsupp.add_apply] at hi
        have hmi := hm i
        omega
      rw [ih b hb, mul_zero]
  exact hall p hp m hm

/-- The logarithmic partial derivative preserves each coordinate-power ideal. -/
theorem logarithmic_pderiv_mem_coordinatePowerIdeal
    (e : σ → ℕ) (j : σ) {p : MvPolynomial σ R}
    (hp : p ∈ coordinatePowerIdeal e) :
    X j * pderiv j p ∈ coordinatePowerIdeal e := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
    obtain ⟨i, rfl⟩ := hp
    change X j * pderiv j (X i ^ e i) ∈ coordinatePowerIdeal e
    rw [X_pow_eq_monomial, X_mul_pderiv_monomial]
    have hmon : monomial (Finsupp.single i (e i)) (1 : R) ∈ coordinatePowerIdeal e := by
      simpa only [X_pow_eq_monomial] using coordinatePowerIdeal_generator (R := R) e i
    simpa only [nsmul_eq_mul] using (coordinatePowerIdeal e).mul_mem_left
      ((Finsupp.single i (e i)) j : MvPolynomial σ R) hmon
  | zero => simp
  | add p q hp hq ihp ihq =>
    rw [map_add, mul_add]
    exact (coordinatePowerIdeal e).add_mem ihp ihq
  | smul r p hp ih =>
    change X j * pderiv j (r * p) ∈ coordinatePowerIdeal e
    rw [pderiv_mul, mul_add]
    apply (coordinatePowerIdeal e).add_mem
    · rw [← mul_assoc]
      exact (coordinatePowerIdeal e).mul_mem_left _ hp
    · simpa only [mul_assoc, mul_comm, mul_left_comm] using
        (coordinatePowerIdeal e).mul_mem_left r ih

/-- Substituting uniform powers multiplies every generating exponent. -/
theorem expand_mem_coordinatePowerIdeal (e : σ → ℕ) (r : ℕ)
    {p : MvPolynomial σ R} (hp : p ∈ coordinatePowerIdeal e) :
    expand r p ∈ coordinatePowerIdeal (fun i => r * e i) := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
    obtain ⟨i, rfl⟩ := hp
    simpa only [map_pow, expand_X, ← pow_mul] using
      coordinatePowerIdeal_generator (R := R) (fun i => r * e i) i
  | zero => simp
  | add p q hp hq ihp ihq =>
    rw [map_add]
    exact (coordinatePowerIdeal (fun i => r * e i)).add_mem ihp ihq
  | smul a p hp ih =>
    change expand r (a * p) ∈ _
    rw [map_mul]
    exact (coordinatePowerIdeal (fun i => r * e i)).mul_mem_left _ ih

/-- The derivative annihilator follows from the single-alternant annihilator.
All operations occur in the polynomial ring, without division. -/
theorem squared_factor_logarithmic_derivative_mem
    (e : σ → ℕ) (D h : MvPolynomial σ R)
    (hDh : D * h ∈ coordinatePowerIdeal e) (j : σ) :
    D ^ 2 * X j * pderiv j h ∈ coordinatePowerIdeal e := by
  have hder := logarithmic_pderiv_mem_coordinatePowerIdeal e j hDh
  have hfirst := (coordinatePowerIdeal e).mul_mem_left D hder
  have hsecond := (coordinatePowerIdeal e).mul_mem_left (X j * pderiv j D) hDh
  have hsub := (coordinatePowerIdeal e).sub_mem hfirst hsecond
  have hid : D ^ 2 * X j * pderiv j h =
      D * (X j * pderiv j (D * h)) - (X j * pderiv j D) * (D * h) := by
    rw [pderiv_mul]
    ring
  rw [hid]
  exact hsub

/-- Multiplying by a variable shifts a coefficient by exactly one.  Hence
an ideal containment after that multiplication still annihilates every
coefficient whose shifted exponent remains below the generators. -/
theorem coefficient_zero_of_variable_mul_mem [DecidableEq σ]
    (e : σ → ℕ) (j : σ) {p : MvPolynomial σ R}
    (hp : X j * p ∈ coordinatePowerIdeal e) (m : σ →₀ ℕ)
    (hm : ∀ i, (Finsupp.single j 1 + m : σ →₀ ℕ) i < e i) : p.coeff m = 0 := by
  have hz := coefficient_zero_of_mem_coordinatePowerIdeal e hp
    (Finsupp.single j 1 + m) hm
  simpa only [coeff_X_mul] using hz

end PaperVerification.AlternatingForms
