def orbitRelQuotientMap (φ : X →ₑ[σ] Y) :
    MulAction.orbitRel.Quotient G X → MulAction.orbitRel.Quotient H Y :=
  MulAction.orbitRelQuotientLift (fun x ↦ Quotient.mk (MulAction.orbitRel H Y) (φ x))
    fun g x ↦ by
