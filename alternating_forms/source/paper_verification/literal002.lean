    ∃ ε : K,ε≠0 ∧
      totalExteriorPluckerCoordinates (K := K) s (2*k+1)
        (indexExteriorWord (reflectedPrefixWord I hk))=ε • X I := by
  obtain ⟨ε,hε,he⟩ := exterior_word_permutation (K := K)
    ((reflectedPrefixWord_perm I hk).map (Pi.basisFun K (Fin (2*k+1))))
