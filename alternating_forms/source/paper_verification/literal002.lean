theorem coeff_mul_mapDomainRingEquiv_inv_one (x : MonoidAlgebra R G) :
    (x * mapDomainRingEquiv R (MulEquiv.inv G) x).coeff 1 =
      ∑ g ∈ x.coeff.support, x.coeff g * x.coeff g := by
  simp [coeff_mul_apply_left, Finsupp.sum]

