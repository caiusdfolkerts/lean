module

public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Logic.Equiv.Fintype
public import Mathlib.Data.Fin.SuccPred

/-!
# Rank-condition ideals on normalized Grassmannian charts

The generators are genuine minors of the restricted matrix.  Completing
selected rows by complementary pivot columns compares these determinantal
ideals with full Plücker minors.  The comparison is integral and keeps the
entire ideal, including its scheme structure.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

open Matrix
open scoped BigOperators

namespace PaperVerification.SchubertRankIdeals

variable {R : Type*} [CommRing R] {s n : ℕ}

/-- The ideal of all `q`-row minors in a specified collection of columns. -/
def restrictedMinorIdeal (A : Matrix (Fin s) (Fin n) R) (q : ℕ)
    (C : Set (Fin n)) : Ideal R :=
  Ideal.span {z | ∃ (rows : Fin q → Fin s) (cols : Fin q → Fin n),
    (∀ i, cols i ∈ C) ∧ z = (A.submatrix rows cols).det}

/-- Laplace expansion retains membership in the ideal generated by the
minors of any initial collection of columns. -/
theorem determinant_mem_of_initial_columns
    (A : Matrix (Fin s) (Fin n) R) (q k : ℕ) (C : Set (Fin n))
    (rows : Fin (q + k) → Fin s) (cols : Fin (q + k) → Fin n)
    (hcols : ∀ i : Fin q, cols (Fin.castAdd k i) ∈ C) :
    (A.submatrix rows cols).det ∈ restrictedMinorIdeal A q C := by
  classical
  induction k with
  | zero =>
      apply Ideal.subset_span
      exact ⟨rows, cols, hcols, rfl⟩
  | succ k ih =>
      rw [Matrix.det_succ_column _ (Fin.last (q + k))]
      apply Submodule.sum_mem
      intro i hi
      apply Ideal.mul_mem_left
      simpa only [Matrix.submatrix_submatrix, Fin.succAbove_last] using
        ih (rows ∘ i.succAbove) (cols ∘ Fin.castSucc)
          (fun j ↦ hcols j)

/-- Full minors containing `q` different column positions in the indicated
collection.  Columns themselves may repeat; such determinants vanish. -/
def fullRestrictedMinorIdeal (A : Matrix (Fin s) (Fin n) R) (q : ℕ)
    (C : Set (Fin n)) : Ideal R :=
  Ideal.span {z | ∃ (cols : Fin s → Fin n) (e : Fin q ↪ Fin s),
    (∀ i, cols (e i) ∈ C) ∧ z = (A.submatrix id cols).det}

/-- Reordering columns places any selected collection first; this proves
that the corresponding full determinant lies in the rank-condition ideal. -/
theorem determinant_mem_of_selected_columns
    (A : Matrix (Fin s) (Fin n) R) (q k : ℕ) (C : Set (Fin n))
    (rows : Fin (q + k) → Fin s) (cols : Fin (q + k) → Fin n)
    (e : Fin q ↪ Fin (q + k)) (hcols : ∀ i, cols (e i) ∈ C) :
    (A.submatrix rows cols).det ∈ restrictedMinorIdeal A q C := by
  classical
  obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair
    (fun i : Fin q ↦ Fin.castAdd k i) e
    (Fin.castAdd_injective _ _) e.injective
  have hm : ((A.submatrix rows cols).submatrix id σ).det ∈
      restrictedMinorIdeal A q C := by
    apply determinant_mem_of_initial_columns A q k C rows (cols ∘ σ)
    intro i
    simpa only [Function.comp_apply, hσ] using hcols i
  have he := Matrix.det_permute' σ.symm ((A.submatrix rows cols).submatrix id σ)
  have he' : (A.submatrix rows cols).det =
      (Equiv.Perm.sign σ.symm : R) *
        ((A.submatrix rows cols).submatrix id σ).det := by
    simpa only [Matrix.submatrix_submatrix, Function.comp_def,
      Equiv.apply_symm_apply, id_eq] using he
  rw [he']
  exact Ideal.mul_mem_left _ _ hm

/-- Complete selected columns with pivot columns for the complementary rows. -/
def completedColumns {q k : ℕ} (p : Fin (q + k) → Fin n)
    (σ : Equiv.Perm (Fin (q + k))) (cols : Fin q → Fin n) :
    Fin (q + k) → Fin n :=
  fun j ↦ Sum.elim cols (fun i ↦ p (σ (finSumFinEquiv (Sum.inr i))))
    (finSumFinEquiv.symm j)

/-- Complementary pivots identify a partial determinant with a full
Plücker determinant, with the exact row-permutation sign. -/
theorem determinant_complementary_pivots {q k : ℕ}
    (A : Matrix (Fin (q + k)) (Fin n) R) (p : Fin (q + k) → Fin n)
    (hp : A.submatrix id p = 1) (σ : Equiv.Perm (Fin (q + k)))
    (cols : Fin q → Fin n) :
    (Equiv.Perm.sign σ : R) *
        (A.submatrix id (completedColumns p σ cols)).det =
      (A.submatrix (fun i ↦ σ (finSumFinEquiv (Sum.inl i))) cols).det := by
  classical
  let e : Fin q ⊕ Fin k ≃ Fin (q + k) := finSumFinEquiv
  let M := A.submatrix id (completedColumns p σ cols)
  let U := A.submatrix (fun i ↦ σ (e (Sum.inl i))) cols
  let L := A.submatrix (fun i ↦ σ (e (Sum.inr i))) cols
  have hp' (i j : Fin (q + k)) : A i (p j) = if i = j then 1 else 0 := by
    exact congrFun (congrFun hp i) j
  have hdis (i : Fin q) (j : Fin k) : Fin.castAdd k i ≠ Fin.natAdd q j := by
    intro h
    have hv : i.val = q + j.val := congrArg Fin.val h
    exact Nat.not_lt.mpr (Nat.le_add_right q j.val) (hv ▸ i.isLt)
  have hblock : (M.submatrix σ id).submatrix e e = Matrix.fromBlocks U 0 L 1 := by
    ext i j
    cases i <;> cases j <;>
      simp [M, U, L, completedColumns, e, Matrix.submatrix_apply,
        hp', σ.injective.eq_iff, e.injective.eq_iff, Matrix.one_apply, hdis]
  calc
    (Equiv.Perm.sign σ : R) * M.det = (M.submatrix σ id).det :=
      (Matrix.det_permute σ M).symm
    _ = ((M.submatrix σ id).submatrix e e).det :=
      (Matrix.det_submatrix_equiv_self e _).symm
    _ = U.det := by rw [hblock, Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, mul_one]

/-- On a normalized Grassmannian chart, the determinantal rank-condition
ideal is exactly the ideal generated by the corresponding full minors. -/
theorem restrictedMinorIdeal_eq_fullRestrictedMinorIdeal {q k : ℕ}
    (A : Matrix (Fin (q + k)) (Fin n) R) (p : Fin (q + k) → Fin n)
    (hp : A.submatrix id p = 1) (C : Set (Fin n)) :
    restrictedMinorIdeal A q C = fullRestrictedMinorIdeal A q C := by
  classical
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro z ⟨rows, cols, hcols, rfl⟩
    by_cases hrows : Function.Injective rows
    · obtain ⟨σ, hσ⟩ := Equiv.Perm.exists_extending_pair
        (fun i : Fin q ↦ (finSumFinEquiv (Sum.inl i) : Fin (q + k))) rows
        (finSumFinEquiv.injective.comp Sum.inl_injective) hrows
      have hm : (A.submatrix id (completedColumns p σ cols)).det ∈
          fullRestrictedMinorIdeal A q C := by
        apply Ideal.subset_span
        refine ⟨completedColumns p σ cols,
          ⟨fun i ↦ finSumFinEquiv (Sum.inl i),
            finSumFinEquiv.injective.comp Sum.inl_injective⟩, ?_, rfl⟩
        intro i
        simpa [completedColumns] using hcols i
      have he := determinant_complementary_pivots A p hp σ cols
      have hrows' : (fun i ↦ σ (finSumFinEquiv (Sum.inl i))) = rows := funext hσ
      rw [hrows'] at he
      rw [← he]
      exact Ideal.mul_mem_left _ _ hm
    · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp hrows
      have hz : (A.submatrix rows cols).det = 0 :=
        Matrix.det_zero_of_row_eq hne (by ext c; simp [Matrix.submatrix_apply, hij])
      rw [hz]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro z ⟨cols, e, hcols, rfl⟩
    exact determinant_mem_of_selected_columns A q k C id cols e hcols

/-- The same comparison with an arbitrary permissible minor size. -/
theorem restrictedMinorIdeal_eq_fullRestrictedMinorIdeal_of_le
    (A : Matrix (Fin s) (Fin n) R) (p : Fin s → Fin n)
    (hp : A.submatrix id p = 1) (q : ℕ) (hq : q ≤ s) (C : Set (Fin n)) :
    restrictedMinorIdeal A q C = fullRestrictedMinorIdeal A q C := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hq
  exact restrictedMinorIdeal_eq_fullRestrictedMinorIdeal A p hp C

end PaperVerification.SchubertRankIdeals
