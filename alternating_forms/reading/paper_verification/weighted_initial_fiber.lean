module

public import TauCeti.RingTheory.MvPolynomial.WeightedHomogeneous
public import Mathlib.Algebra.Polynomial.AlgebraMap
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise
public import Lean.Elab.Tactic.Omega

/-!
# The actual special fiber for a weighted initial ideal

For `P = K[x_i]`, the algebra used here is the literal image of
`P[Y] → (P/Q)[t]`, with `Y ↦ t` and `x_i ↦ x̄_i t^(w i)`.
The kernel of its special-fiber map is proved to be the ideal generated by
the greatest-weight parts of the elements of `Q`.

The proof is coefficientwise.  The coefficient of `t^d` in the image of
`∑ Y^j g_j` is the residue class of `∑_{j≤d} (g_j)_(d-j)`.  Its greatest
weight part is `(g_0)_d`.  Conversely, actual weighted homogenization gives
a relation in the displayed map for every element of `Q`.

This module supplies no flatness or dimension hypothesis and assumes no
identity between an initial ideal and a special-fiber kernel.
-/

@[expose] public section
set_option autoImplicit false

noncomputable section

namespace PaperVerification.WeightedInitialFiber

open scoped BigOperators
open MvPolynomial

variable {K σ : Type*} [Field K]
local notation "P" => MvPolynomial σ K

/-- Every nonzero monomial coefficient has weight at most `d`. -/
def WeightBound (w : σ → ℕ) (d : ℕ) (p : P) : Prop :=
  ∀ a : σ →₀ ℕ, p.coeff a ≠ 0 → Finsupp.weight w a ≤ d

theorem weightBound_zero (w : σ → ℕ) (d : ℕ) : WeightBound w d (0 : P) := by
  intro a ha
  exact (ha (by simp)).elim

theorem weightBound_add (w : σ → ℕ) (d : ℕ) {p q : P}
    (hp : WeightBound w d p) (hq : WeightBound w d q) : WeightBound w d (p+q) := by
  intro a ha
  by_cases hpa : p.coeff a=0
  · apply hq a
    intro hqa
    exact ha (by simp only [AddMonoidAlgebra.coeff_add,Finsupp.add_apply,hpa,hqa,add_zero])
  · exact hp a hpa

theorem weightBound_sum {ι : Type*} (w : σ → ℕ) (d : ℕ)
    (s : Finset ι) (f : ι → P) (hf : ∀ i ∈ s, WeightBound w d (f i)) :
    WeightBound w d (∑ i ∈ s, f i) := by
  classical
  revert hf
  induction s using Finset.induction_on with
  | empty =>
      intro hf
      simpa using weightBound_zero (K := K) w d
  | @insert i s hi ih =>
      intro hf
      rw [Finset.sum_insert hi]
      exact weightBound_add w d (hf i (Finset.mem_insert_self i s))
        (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))

theorem weightBound_component (w : σ → ℕ) (p : P) (d e : ℕ) (he : e≤d) :
    WeightBound w d (weightedHomogeneousComponent w e p) := by
  intro a ha
  exact (weightedHomogeneousComponent_isWeightedHomogeneous e p ha).le.trans he

theorem weightBound_total (w : σ → ℕ) (p : P) :
    WeightBound w (weightedTotalDegree w p) p := by
  intro a ha
  exact le_weightedTotalDegree w (mem_support_iff.mpr ha)

theorem total_le_of_weightBound (w : σ → ℕ) (p : P) (d : ℕ)
    (hp : WeightBound w d p) : weightedTotalDegree w p ≤ d := by
  classical
  apply Finset.sup_le
  intro a ha
  exact hp a (mem_support_iff.mp ha)

/-- A finite, bounded version of the actual homogeneous decomposition. -/
theorem sum_components_of_bound (w : σ → ℕ) (p : P) (d : ℕ)
    (hp : WeightBound w d p) :
    (∑ j ∈ Finset.range (d+1), weightedHomogeneousComponent w j p) = p := by
  classical
  ext a
  simp only [coeff_sum,coeff_weightedHomogeneousComponent,Finset.sum_ite_eq]
  by_cases ha : p.coeff a=0
  · simp only [ha,ite_self]
  · rw [if_pos]
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (hp a ha))

/-- The conventional greatest-weight part, with zero mapping to zero. -/
def initialForm (w : σ → ℕ) (p : P) : P :=
  weightedHomogeneousComponent w (weightedTotalDegree w p) p

/-- The ideal generated by greatest-weight parts of all elements of `Q`. -/
def initialIdeal (Q : Ideal P) (w : σ → ℕ) : Ideal P :=
  Ideal.span (initialForm w '' (Q : Set P))

theorem initialIdeal_mono (w : σ → ℕ) {Q J : Ideal P} (h : Q≤J) :
    initialIdeal Q w ≤ initialIdeal J w := by
  apply Ideal.span_mono
  exact Set.image_mono h

theorem component_mem_initialIdeal (Q : Ideal P) (w : σ → ℕ)
    (p : P) (hp : p∈Q) (d : ℕ) (hb : WeightBound w d p) :
    weightedHomogeneousComponent w d p ∈ initialIdeal Q w := by
  by_cases hd : d=weightedTotalDegree w p
  · subst d
    exact Ideal.subset_span ⟨p,hp,rfl⟩
  · have hlt : weightedTotalDegree w p<d := by
      have hle := total_le_of_weightBound w p d hb
      omega
    rw [weightedHomogeneousComponent_eq_zero d p hlt]
    exact Ideal.zero_mem _

/-- Actual weighted substitution before taking the coefficient quotient. -/
def scaledPolynomial (w : σ → ℕ) : P →ₐ[K] Polynomial P :=
  MvPolynomial.aeval (fun i => Polynomial.C (MvPolynomial.X i) * Polynomial.X ^ w i)

def scaledQuotient (Q : Ideal P) (w : σ → ℕ) : P →ₐ[K] Polynomial (P ⧸ Q) :=
  (Polynomial.mapAlgHom (Ideal.Quotient.mkₐ K Q)).comp (scaledPolynomial w)

@[simp] theorem scaledQuotient_coeff (Q : Ideal P) (w : σ → ℕ) (p : P) (d : ℕ) :
    (scaledQuotient Q w p).coeff d =
      Ideal.Quotient.mkₐ K Q (weightedHomogeneousComponent w d p) := by
  simp only [scaledQuotient,AlgHom.comp_apply,Polynomial.coe_mapAlgHom,
    Polynomial.coeff_map,scaledPolynomial,coeff_aeval_C_X_mul_X_pow]
  rfl

theorem scaledQuotient_of_homogeneous (Q : Ideal P) (w : σ → ℕ)
    (p : P) (d : ℕ) (hp : p.IsWeightedHomogeneous w d) :
    scaledQuotient Q w p = Polynomial.C (Ideal.Quotient.mkₐ K Q p) * Polynomial.X ^ d := by
  classical
  ext j
  rw [scaledQuotient_coeff,weightedHomogeneousComponent_of_mem hp,
    Polynomial.coeff_C_mul_X_pow]
  by_cases hj : j=d <;> simp [hj,eq_comm]

/-- The concrete map `P[Y] → (P/Q)[t]`. -/
def reesMap (Q : Ideal P) (w : σ → ℕ) :
    Polynomial P →ₐ[K] Polynomial (P ⧸ Q) :=
  Polynomial.aevalTower (scaledQuotient Q w) (Polynomial.X : Polynomial (P ⧸ Q))

@[simp] theorem reesMap_C (Q : Ideal P) (w : σ → ℕ) (p : P) :
    reesMap Q w (Polynomial.C p) = scaledQuotient Q w p := by
  simp [reesMap]

@[simp] theorem reesMap_X (Q : Ideal P) (w : σ → ℕ) :
    reesMap Q w Polynomial.X = Polynomial.X := by
  simp [reesMap]

theorem reesMap_monomial (Q : Ideal P) (w : σ → ℕ) (j : ℕ) (p : P) :
    reesMap Q w (Polynomial.monomial j p) = scaledQuotient Q w p * Polynomial.X ^ j := by
  rw [←Polynomial.C_mul_X_pow_eq_monomial,map_mul,map_pow,reesMap_C,reesMap_X]

/-- The coefficient in the original polynomial ring whose class is the
coefficient of `t^d` after applying `reesMap`. -/
def coefficientLift (w : σ → ℕ) (g : Polynomial P) (d : ℕ) : P :=
  ∑ j ∈ Finset.range (d+1), weightedHomogeneousComponent w (d-j) (g.coeff j)

@[simp] theorem coefficientLift_add (w : σ → ℕ) (g h : Polynomial P) (d : ℕ) :
    coefficientLift w (g+h) d = coefficientLift w g d + coefficientLift w h d := by
  simp only [coefficientLift,Polynomial.coeff_add,map_add,Finset.sum_add_distrib]

theorem coefficientLift_monomial (w : σ → ℕ) (j : ℕ) (p : P) (d : ℕ) :
    coefficientLift w (Polynomial.monomial j p) d =
      if j≤d then weightedHomogeneousComponent w (d-j) p else 0 := by
  classical
  simp only [coefficientLift,Polynomial.coeff_monomial,Finsupp.single_apply,apply_ite,map_zero,
    Finset.sum_ite_eq,Finset.mem_range,Nat.lt_succ_iff]
  split_ifs <;> rfl

/-- The coefficient identity behind the special-fiber kernel calculation. -/
theorem reesMap_coeff (Q : Ideal P) (w : σ → ℕ) (g : Polynomial P) (d : ℕ) :
    (reesMap Q w g).coeff d = Ideal.Quotient.mkₐ K Q (coefficientLift w g d) := by
  classical
  induction g using Polynomial.induction_on' with
  | add g h hg hh =>
      simp only [map_add,Polynomial.coeff_add,coefficientLift_add,hg,hh]
  | monomial j p =>
      rw [reesMap_monomial,Polynomial.coeff_mul_X_pow',scaledQuotient_coeff,
        coefficientLift_monomial]
      split_ifs <;> simp

theorem coefficientLift_bound (w : σ → ℕ) (g : Polynomial P) (d : ℕ) :
    WeightBound w d (coefficientLift w g d) := by
  apply weightBound_sum
  intro j hj
  exact weightBound_component w (g.coeff j) d (d-j) (Nat.sub_le d j)

/-- All terms with positive `Y` exponent have strictly smaller x-weight. -/
theorem coefficientLift_top (w : σ → ℕ) (g : Polynomial P) (d : ℕ) :
    weightedHomogeneousComponent w d (coefficientLift w g d) =
      weightedHomogeneousComponent w d (g.coeff 0) := by
  classical
  rw [coefficientLift,map_sum,Finset.sum_eq_single 0]
  · simp only [Nat.sub_zero,weightedHomogeneousComponent_eq_self
      (weightedHomogeneousComponent_isWeightedHomogeneous d (g.coeff 0))]
  · intro j hj hj0
    rw [weightedHomogeneousComponent_of_mem
      (weightedHomogeneousComponent_isWeightedHomogeneous (d-j) (g.coeff j)),if_neg]
    have hjd := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    omega
  · intro h
    exact (h (Finset.mem_range.mpr (Nat.zero_lt_succ d))).elim

theorem coefficientLift_mem_of_reesMap_zero (Q : Ideal P) (w : σ → ℕ)
    (g : Polynomial P) (hg : reesMap Q w g=0) (d : ℕ) :
    coefficientLift w g d ∈ Q := by
  have h := congrArg (fun f : Polynomial (P ⧸ Q) => f.coeff d) hg
  rw [reesMap_coeff,Polynomial.coeff_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.mp h

/-- The actual image subalgebra, not an abstract flat-deformation assumption. -/
def reesAlgebra (Q : Ideal P) (w : σ → ℕ) : Subalgebra K (Polynomial (P ⧸ Q)) :=
  (reesMap Q w).range

/-- The standard commutative-ring structure on the actual image subalgebra. -/
instance reesAlgebraCommRing (Q : Ideal P) (w : σ → ℕ) :
    CommRing (reesAlgebra Q w) := by
  let ringInst : Ring (reesAlgebra Q w) := inferInstance
  exact { ringInst with
    mul_comm := fun a b ↦ by
      apply Subtype.ext
      change (a : Polynomial (P ⧸ Q)) * (b : Polynomial (P ⧸ Q)) =
        (b : Polynomial (P ⧸ Q)) * (a : Polynomial (P ⧸ Q))
      exact mul_comm (a : Polynomial (P ⧸ Q)) (b : Polynomial (P ⧸ Q)) }

def reesCover (Q : Ideal P) (w : σ → ℕ) : Polynomial P →ₐ[K] reesAlgebra Q w :=
  (reesMap Q w).rangeRestrict

theorem reesCover_surjective (Q : Ideal P) (w : σ → ℕ) :
    Function.Surjective (reesCover Q w) := (reesMap Q w).rangeRestrict_surjective

def reesParameter (Q : Ideal P) (w : σ → ℕ) : reesAlgebra Q w :=
  reesCover Q w Polynomial.X

abbrev ZeroFiber (Q : Ideal P) (w : σ → ℕ) :=
  reesAlgebra Q w ⧸ Ideal.span ({reesParameter Q w} : Set (reesAlgebra Q w))

def fiberMap (Q : Ideal P) (w : σ → ℕ) : reesAlgebra Q w →ₐ[K] ZeroFiber Q w :=
  Ideal.Quotient.mkₐ K (Ideal.span {reesParameter Q w})

def specialMap (Q : Ideal P) (w : σ → ℕ) : P →ₐ[K] ZeroFiber Q w :=
  (fiberMap Q w).comp ((reesCover Q w).comp (Polynomial.CAlgHom (R := K)))

@[simp] theorem fiberMap_parameter (Q : Ideal P) (w : σ → ℕ) :
    fiberMap Q w (reesParameter Q w)=0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)

/-- Modulo the actual parameter, only the constant coefficient in `Y` remains. -/
theorem fiberMap_cover (Q : Ideal P) (w : σ → ℕ) (g : Polynomial P) :
    fiberMap Q w (reesCover Q w g) = specialMap Q w (g.coeff 0) := by
  classical
  induction g using Polynomial.induction_on' with
  | add g h hg hh => simp only [map_add,Polynomial.coeff_add,hg,hh]
  | monomial j p =>
      rw [←Polynomial.C_mul_X_pow_eq_monomial,map_mul,map_pow,map_mul,map_pow]
      change specialMap Q w p * fiberMap Q w (reesParameter Q w) ^ j = _
      rw [fiberMap_parameter]
      cases j with
      | zero => simp
      | succ j => simp

theorem specialMap_surjective (Q : Ideal P) (w : σ → ℕ) :
    Function.Surjective (specialMap Q w) := by
  intro x
  obtain ⟨a,ha⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨g,hg⟩ := reesCover_surjective Q w a
  refine ⟨g.coeff 0,?_⟩
  rw [←fiberMap_cover,hg]
  exact ha

/-- Padding each actual weight component by the complementary power of `Y`. -/
def homogenize (w : σ → ℕ) (p : P) (d : ℕ) : Polynomial P :=
  ∑ j ∈ Finset.range (d+1),
    Polynomial.monomial (d-j) (weightedHomogeneousComponent w j p)

theorem homogenize_coeff_zero (w : σ → ℕ) (p : P) (d : ℕ) :
    (homogenize w p d).coeff 0 = weightedHomogeneousComponent w d p := by
  classical
  rw [homogenize,Polynomial.finsetSum_coeff,Finset.sum_eq_single d]
  · simp only [Nat.sub_self,Polynomial.coeff_monomial,Finsupp.single_apply,ite_true]
  · intro j hj hjd
    simp only [Polynomial.coeff_monomial,Finsupp.single_apply]
    rw [if_neg]
    have hle := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    omega
  · intro h
    exact (h (Finset.mem_range.mpr (Nat.lt_succ_self d))).elim

theorem reesMap_homogenize (Q : Ideal P) (w : σ → ℕ) (p : P) (d : ℕ)
    (hp : WeightBound w d p) :
    reesMap Q w (homogenize w p d) =
      Polynomial.C (Ideal.Quotient.mkₐ K Q p) * Polynomial.X ^ d := by
  classical
  rw [homogenize,map_sum]
  calc
    _ = ∑ j ∈ Finset.range (d+1),
        Polynomial.C (Ideal.Quotient.mkₐ K Q (weightedHomogeneousComponent w j p)) *
          Polynomial.X ^ d := by
      apply Finset.sum_congr rfl
      intro j hj
      rw [reesMap_monomial,scaledQuotient_of_homogeneous Q w _ j
        (weightedHomogeneousComponent_isWeightedHomogeneous j p),mul_assoc,←pow_add]
      have he : j+(d-j)=d := by
        have hle := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        omega
      rw [he]
    _ = _ := by
      rw [←Finset.sum_mul,←map_sum,←map_sum,sum_components_of_bound w p d hp]

theorem initialIdeal_le_specialKernel (Q : Ideal P) (w : σ → ℕ) :
    initialIdeal Q w ≤ RingHom.ker (specialMap Q w).toRingHom := by
  apply Ideal.span_le.mpr
  rintro _ ⟨p,hp,rfl⟩
  let d := weightedTotalDegree w p
  let H := homogenize w p d
  have hH : reesMap Q w H=0 := by
    rw [reesMap_homogenize Q w p d (weightBound_total w p)]
    rw [show Ideal.Quotient.mkₐ K Q p=0 from Ideal.Quotient.eq_zero_iff_mem.mpr hp]
    simp
  have hcover : reesCover Q w H=0 := by
    apply Subtype.ext
    exact hH
  have he := fiberMap_cover Q w H
  rw [hcover,map_zero] at he
  change specialMap Q w (initialForm w p)=0
  simpa only [H,homogenize_coeff_zero,d,initialForm] using he.symm

theorem specialKernel_le_initialIdeal (Q : Ideal P) (w : σ → ℕ) :
    RingHom.ker (specialMap Q w).toRingHom ≤ initialIdeal Q w := by
  intro f hf
  change specialMap Q w f=0 at hf
  change fiberMap Q w (reesCover Q w (Polynomial.C f))=0 at hf
  have hspan : reesCover Q w (Polynomial.C f) ∈
      Ideal.span ({reesParameter Q w} : Set (reesAlgebra Q w)) :=
    Ideal.Quotient.eq_zero_iff_mem.mp hf
  obtain ⟨a,ha⟩ := Ideal.mem_span_singleton'.mp hspan
  obtain ⟨g,hg⟩ := reesCover_surjective Q w a
  let H : Polynomial P := Polynomial.C f-Polynomial.X*g
  have hcover : reesCover Q w H=0 := by
    change reesCover Q w (Polynomial.C f-Polynomial.X*g)=0
    rw [map_sub,map_mul]
    change reesCover Q w (Polynomial.C f)-reesParameter Q w*reesCover Q w g=0
    rw [hg,mul_comm (reesParameter Q w) a,ha,sub_self]
  have hH : reesMap Q w H=0 := congrArg Subtype.val hcover
  have hconstant : H.coeff 0=f := by
    simp only [H,Polynomial.coeff_sub,Polynomial.coeff_C_zero,
      Polynomial.coeff_X_mul_zero,sub_zero]
  have hcomponent (d : ℕ) : weightedHomogeneousComponent w d f ∈ initialIdeal Q w := by
    have hmem := component_mem_initialIdeal Q w (coefficientLift w H d)
      (coefficientLift_mem_of_reesMap_zero Q w H hH d) d (coefficientLift_bound w H d)
    rw [coefficientLift_top,hconstant] at hmem
    exact hmem
  rw [←sum_components_of_bound w f (weightedTotalDegree w f) (weightBound_total w f)]
  exact (initialIdeal Q w).sum_mem (fun d hd => hcomponent d)

/-- The special fiber has precisely the conventional weighted initial ideal
as kernel, for every ideal and every choice of nonnegative integer weights. -/
theorem specialMap_ker (Q : Ideal P) (w : σ → ℕ) :
    RingHom.ker (specialMap Q w).toRingHom = initialIdeal Q w :=
  le_antisymm (specialKernel_le_initialIdeal Q w) (initialIdeal_le_specialKernel Q w)

/-- The special fiber is the actual weighted-initial quotient. -/
def initialQuotientEquiv (Q : Ideal P) (w : σ → ℕ) :
    (P ⧸ initialIdeal Q w) ≃ₐ[K] ZeroFiber Q w :=
  (Ideal.quotientEquivAlgOfEq K (specialMap_ker Q w).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (specialMap_surjective Q w))

end PaperVerification.WeightedInitialFiber
