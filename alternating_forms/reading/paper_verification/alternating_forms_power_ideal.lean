module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.Algebra.MvPolynomial.Expand
public import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic.Ring
import Lean.Elab.Tactic.Omega

/-!
# Coordinate-power ideals and the logarithmic partial derivatives

These are the polynomial-ideal facts used in the integration-annihilator
calculation.  They concern actual ideals and actual polynomial coefficients.
The operator `X i * pderiv i` preserves every coordinate-power ideal.  This
avoids taking rational partial fractions in the odd annihilator calculation.
-/

@[expose] public section

set_option autoImplicit false
noncomputable section

namespace PaperVerification.AlternatingForms

open MvPolynomial

variable {R σ : Type*} [CommRing R]

/-- The ideal generated by the specified powers of the coordinate variables. -/
def coordinatePowerIdeal (e : σ → ℕ) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun i => (X i : MvPolynomial σ R) ^ e i)

theorem coordinatePowerIdeal_generator (e : σ → ℕ) (i : σ) :
    (X i : MvPolynomial σ R) ^ e i ∈ coordinatePowerIdeal e :=
  Ideal.subset_span ⟨i, rfl⟩

/-- A coefficient strictly below every generating exponent vanishes on the
whole ideal, including after arbitrary polynomial multiplication. -/
theorem coefficient_zero_of_mem_coordinatePowerIdeal [DecidableEq σ]
    (e : σ → ℕ) {p : MvPolynomial σ R} (hp : p ∈ coordinatePowerIdeal e)
    (m : σ →₀ ℕ) (hm : ∀ i, m i < e i) : p.coeff m = 0 := by
  have hall : ∀ p : MvPolynomial σ R, p ∈ coordinatePowerIdeal e →
      ∀ m : σ →₀ ℕ, (∀ i, m i < e i) → p.coeff m = 0 := by
    intro p hp
    induction hp using Submodule.span_induction with
    | mem p hp =>
      obtain ⟨i, rfl⟩ := hp
      intro m hm
      have hne : Finsupp.single i (e i) ≠ m := by
        intro heq
        have hi := hm i
        rw [← heq, Finsupp.single_eq_same] at hi
        exact (Nat.lt_irrefl _) hi
      simp only [X_pow_eq_monomial, coeff_monomial, if_neg hne]
    | zero => intro m hm; simp
    | add p q hp hq ihp ihq =>
      intro m hm
      rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, ihp m hm, ihq m hm, add_zero]
    | smul r p hp ih =>
      intro m hm
      change (r * p).coeff m = 0
      rw [coeff_mul]
      apply Finset.sum_eq_zero
      rintro ⟨a, b⟩ hab
      have hab' : a + b = m := Finset.mem_antidiagonal.mp hab
      have hb : ∀ i, b i < e i := by
        intro i
        have hi := congrArg (fun d : σ →₀ ℕ => d i) hab'
        simp only [Finsupp.add_apply] at hi
        have hmi := hm i
        omega
      rw [ih b hb, mul_zero]
  exact hall p hp m hm

/-- The logarithmic partial derivative preserves each coordinate-power ideal. -/
theorem logarithmic_pderiv_mem_coordinatePowerIdeal
    (e : σ → ℕ) (j : σ) {p : MvPolynomial σ R}
    (hp : p ∈ coordinatePowerIdeal e) :
    X j * pderiv j p ∈ coordinatePowerIdeal e := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
    obtain ⟨i, rfl⟩ := hp
    change X j * pderiv j (X i ^ e i) ∈ coordinatePowerIdeal e
    rw [X_pow_eq_monomial, X_mul_pderiv_monomial]
    have hmon : monomial (Finsupp.single i (e i)) (1 : R) ∈ coordinatePowerIdeal e := by
      simpa only [X_pow_eq_monomial] using coordinatePowerIdeal_generator (R := R) e i
    simpa only [nsmul_eq_mul] using (coordinatePowerIdeal e).mul_mem_left
      ((Finsupp.single i (e i)) j : MvPolynomial σ R) hmon
  | zero => simp
  | add p q hp hq ihp ihq =>
    rw [map_add, mul_add]
    exact (coordinatePowerIdeal e).add_mem ihp ihq
  | smul r p hp ih =>
    change X j * pderiv j (r * p) ∈ coordinatePowerIdeal e
    rw [pderiv_mul, mul_add]
    apply (coordinatePowerIdeal e).add_mem
    · rw [← mul_assoc]
      exact (coordinatePowerIdeal e).mul_mem_left _ hp
    · simpa only [mul_assoc, mul_comm, mul_left_comm] using
        (coordinatePowerIdeal e).mul_mem_left r ih

/-- Substituting uniform powers multiplies every generating exponent. -/
theorem expand_mem_coordinatePowerIdeal (e : σ → ℕ) (r : ℕ)
    {p : MvPolynomial σ R} (hp : p ∈ coordinatePowerIdeal e) :
    expand r p ∈ coordinatePowerIdeal (fun i => r * e i) := by
  induction hp using Submodule.span_induction with
  | mem p hp =>
    obtain ⟨i, rfl⟩ := hp
    simpa only [map_pow, expand_X, ← pow_mul] using
      coordinatePowerIdeal_generator (R := R) (fun i => r * e i) i
  | zero => simp
  | add p q hp hq ihp ihq =>
    rw [map_add]
    exact (coordinatePowerIdeal (fun i => r * e i)).add_mem ihp ihq
  | smul a p hp ih =>
    change expand r (a * p) ∈ _
    rw [map_mul]
    exact (coordinatePowerIdeal (fun i => r * e i)).mul_mem_left _ ih

/-- The derivative annihilator follows from the single-alternant annihilator.
All operations occur in the polynomial ring, without division. -/
theorem squared_factor_logarithmic_derivative_mem
    (e : σ → ℕ) (D h : MvPolynomial σ R)
    (hDh : D * h ∈ coordinatePowerIdeal e) (j : σ) :
    D ^ 2 * X j * pderiv j h ∈ coordinatePowerIdeal e := by
  have hder := logarithmic_pderiv_mem_coordinatePowerIdeal e j hDh
  have hfirst := (coordinatePowerIdeal e).mul_mem_left D hder
  have hsecond := (coordinatePowerIdeal e).mul_mem_left (X j * pderiv j D) hDh
  have hsub := (coordinatePowerIdeal e).sub_mem hfirst hsecond
  have hid : D ^ 2 * X j * pderiv j h =
      D * (X j * pderiv j (D * h)) - (X j * pderiv j D) * (D * h) := by
    rw [pderiv_mul]
    ring
  rw [hid]
  exact hsub

/-- Multiplying by a variable shifts a coefficient by exactly one.  Hence
an ideal containment after that multiplication still annihilates every
coefficient whose shifted exponent remains below the generators. -/
theorem coefficient_zero_of_variable_mul_mem [DecidableEq σ]
    (e : σ → ℕ) (j : σ) {p : MvPolynomial σ R}
    (hp : X j * p ∈ coordinatePowerIdeal e) (m : σ →₀ ℕ)
    (hm : ∀ i, (Finsupp.single j 1 + m : σ →₀ ℕ) i < e i) : p.coeff m = 0 := by
  have hz := coefficient_zero_of_mem_coordinatePowerIdeal e hp
    (Finsupp.single j 1 + m) hm
  simpa only [coeff_X_mul] using hz

end PaperVerification.AlternatingForms
