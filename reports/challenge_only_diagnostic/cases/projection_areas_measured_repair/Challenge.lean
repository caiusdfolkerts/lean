/-! # Compatibility and realization of coordinate projection areas
The claims retain actual compact convex Euclidean sets and planar Lebesgue
areas. They cover the principal nonapproximation theorem, the escape and
closure characterization, strict polytopal realization with the actual vertex
bound, the boundary-quartet corollaries, weighted and open-family obstructions,
and the complete rank-at-most-three nonnegative classification.
-/

@[expose] public section
noncomputable section
open Set MeasureTheory Matrix Filter Metric
open scoped BigOperators Pointwise Topology
namespace VolumePolynomials
section
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F]
/-- Image of the literal compact convex set by a continuous linear map. -/
def mapBody (f : E →L[ℝ] F) (K : ConvexBody E) : ConvexBody F where
  carrier := f '' (K : Set E)
  convex' := K.convex.linear_image f.toLinearMap
  isCompact' := K.isCompact.image f.continuous
  nonempty' := K.nonempty.image f
end
end VolumePolynomials

namespace ProjectionAreaRankThree
/-- A hollow symmetric real matrix with all off-diagonal entries strictly positive. -/
structure PositiveHollowMatrix (n : ℕ) where
  entries : Matrix (Fin n) (Fin n) ℝ
  hollow : ∀ i, entries i i = 0
  symmetric : ∀ i j, entries i j = entries j i
  positive : ∀ i j, i ≠ j → 0 < entries i j

/-- A hollow symmetric real matrix with all entries nonnegative. -/
structure NonnegativeHollowMatrix (n : ℕ) where
  entries : Matrix (Fin n) (Fin n) ℝ
  hollow : ∀ i, entries i i = 0
  symmetric : ∀ i j, entries i j = entries j i
  nonnegative : ∀ i j, 0 ≤ entries i j

namespace PositiveHollowMatrix
variable {n : ℕ} (P : PositiveHollowMatrix n)
/-- Weighted triangle inequalities on exactly three pairwise distinct labels. -/
def WeightedTriangles (x : Fin n → ℝ) : Prop :=
  ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
    P.entries i j * x k ≤ P.entries i k * x j + P.entries j k * x i
end PositiveHollowMatrix

end ProjectionAreaRankThree

namespace ProjectionAreaEscape
/-- Real n by n projection-area arrays. -/
abbrev ProjectionArray (n : ℕ) := Matrix (Fin n) (Fin n) ℝ

/-- The weighted triangle inequalities, allowing zero weights. -/
def WeightedTriangleInequalities {n : ℕ} (q : ProjectionArray n) (w : Fin n → ℝ) : Prop :=
  ∀ i j k, i ≠ j → i ≠ k → j ≠ k →
    w k * q i j ≤ w j * q i k + w i * q j k

/-- A nonzero nonnegative weight vector satisfying every weighted triangle inequality. -/
def WeightedTriangleWitness {n : ℕ} (q : ProjectionArray n) (w : Fin n → ℝ) : Prop :=
  (∀ i, 0 ≤ w i) ∧ w ≠ 0 ∧ WeightedTriangleInequalities q w

/-- Existence of such a weight vector. -/
def AdmitsTriangleWeights {n : ℕ} (q : ProjectionArray n) : Prop :=
  ∃ w, WeightedTriangleWitness q w

/-- Nonnegative symmetric hollow arrays admitting nonzero nonnegative triangle weights. -/
def EscapeCone (n : ℕ) : Set (ProjectionArray n) :=
  {q | (∀ i, q i i = 0) ∧ (∀ i j, q i j = q j i) ∧
    (∀ i j, 0 ≤ q i j) ∧ AdmitsTriangleWeights q}
end ProjectionAreaEscape

namespace PalomarProjectionAreas.NumericProofs
/-- The measured nonzero dimension proof for two coordinate positions. -/
theorem twoNeZero : NeZero (1 + 1 : ℕ) := by infer_instance
/-- The measured lower bound used by the literal exponent two. -/
theorem twoAtLeastTwo : Nat.AtLeastTwo (1 + 1 : ℕ) := by infer_instance
/-- The measured nonzero dimension proof for four coordinate positions. -/
theorem fourNeZero : NeZero (3 + 1 : ℕ) := by infer_instance
end PalomarProjectionAreas.NumericProofs

namespace ProjectionAreaTopology
/-- Canonical Euclidean coordinate space. -/
abbrev CoordinateSpace (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- The ordinary matrix space of area arrays. -/
abbrev AreaArray (d : ℕ) := Matrix (Fin d) (Fin d) ℝ

/-- An actual nonempty compact convex Euclidean set, of arbitrary affine dimension. -/
abbrev CoordinateBody (d : ℕ) := ConvexBody (CoordinateSpace d)

/-- The planar coordinate space with its ordinary Lebesgue measure. -/
abbrev Plane := Fin 2 → ℝ

/-- The actual two-coordinate continuous linear projection. -/
def coordinateProjection {d : ℕ} (i j : Fin d) : CoordinateSpace d →L[ℝ] Plane :=
  letI : NeZero (1 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.twoNeZero
  { toLinearMap :=
      { toFun := fun x k => if k = 0 then x i else x j
        map_add' := by
          intro x y
          ext k
          by_cases hk : k = 0 <;> simp [hk, Pi.add_apply, PiLp.add_apply]
        map_smul' := by
          intro r x
          ext k
          by_cases hk : k = 0 <;> simp [hk, Pi.smul_apply, PiLp.smul_apply] }
    cont := by
      apply continuous_pi
      intro k
      split <;> fun_prop }

/-- Actual planar Lebesgue measures of every coordinate projection. -/
def coordinateAreas {d : ℕ} (K : CoordinateBody d) : AreaArray d :=
  fun i j => (volume : Measure Plane).real
    (coordinateProjection i j '' (K : Set (CoordinateSpace d)))

/-- The range of actual coordinate-area arrays. -/
def realizationLocus (d : ℕ) : Set (AreaArray d) := Set.range (coordinateAreas (d := d))

section
variable {E Y : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [TopologicalSpace Y] [T2Space Y]
/-- Data limits along a sequence whose actual Euclidean diameters tend to infinity. -/
def escapingLimits (f : ConvexBody E → Y) : Set Y :=
  {y | ∃ K : ℕ → ConvexBody E,
    Tendsto (fun n => f (K n)) atTop (𝓝 y) ∧
    Tendsto (fun n => diam (K n : Set E)) atTop atTop}
end
/-- Limits of area arrays along sequences whose Euclidean diameters tend to infinity. -/
def divergingDiameterLimits (d : ℕ) : Set (AreaArray d) :=
  escapingLimits (coordinateAreas (d := d))
end ProjectionAreaTopology

namespace ProjectionAreaBoundaryPolytope
/-- The literal planar product space. -/
abbrev V2 := Fin 2 → ℝ
end ProjectionAreaBoundaryPolytope
namespace ProjectionAreaTransforms
open ProjectionAreaBoundaryPolytope

/-- The linear map retaining the two selected coordinates. -/
def projectN {n : ℕ} (i j : Fin n) : (Fin n → ℝ) →ₗ[ℝ] V2 where
  toFun x := ![x i,x j]
  map_add' x y := by ext k; fin_cases k <;> simp
  map_smul' a x := by ext k; fin_cases k <;> simp
end ProjectionAreaTransforms

namespace ProjectionAreaStrict
open ProjectionAreaTransforms ProjectionAreaBoundaryPolytope
/-- The identity on coordinates with the Euclidean norm on its codomain. -/
def asEuclidean (n : ℕ) : (Fin n → ℝ) ≃L[ℝ] EuclideanSpace ℝ (Fin n) :=
  letI : Nat.AtLeastTwo (1 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.twoAtLeastTwo
  letI : NeZero (1 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.twoNeZero
  (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin n => ℝ)).symm

/-- The diameter after passing to the canonical Euclidean norm. -/
def euclideanDiameter {n : ℕ} (K : Set (Fin n → ℝ)) : ℝ :=
  Metric.diam (asEuclidean n '' K)
end ProjectionAreaStrict

namespace ProjectionAreaEscape
open ProjectionAreaTopology
variable {n : ℕ}
/-- An actual finite convex hull symmetric about the origin. -/
def IsSymmetricPolytope (K : CoordinateBody n) : Prop :=
  -(K : Set (CoordinateSpace n)) = (K : Set (CoordinateSpace n)) ∧
    ∃ S : Set (CoordinateSpace n), S.Finite ∧
      (K : Set (CoordinateSpace n)) = convexHull ℝ S
end ProjectionAreaEscape

namespace ProjectionAreaBoundaryKernel
/-- The specified one of the three root-product boundary equalities. -/
def BoundaryEquality (A B C : ℝ) (k : Fin 3) : Prop :=
  ![A = B + C, B = A + C, C = A + B] k
end ProjectionAreaBoundaryKernel

namespace ProjectionBoundaryCuts
/-- The explicit two-element side of each balanced cut on four of five labels. -/
def cutSide : Fin 5 → Fin 3 → Finset (Fin 5) :=
  ![![{1, 2}, {1, 3}, {1, 4}],
    ![{0, 2}, {0, 3}, {0, 4}],
    ![{0, 1}, {0, 3}, {0, 4}],
    ![{0, 1}, {0, 2}, {0, 4}],
    ![{0, 1}, {0, 2}, {0, 3}]]

/-- The two labels belong to the same side of the specified cut. -/
def samePart (m : Fin 5) (k : Fin 3) (i j : Fin 5) : Prop :=
  i ∈ cutSide m k ↔ j ∈ cutSide m k
end ProjectionBoundaryCuts

namespace ProjectionAreaMixedGeometry
open VolumePolynomials ProjectionAreaTransforms ProjectionAreaBoundaryPolytope ProjectionAreaBoundaryKernel ProjectionBoundaryCuts
/-- Literal finite product coordinate space. -/
abbrev V (n : ℕ) := Fin n → ℝ

/-- An actual nonempty compact convex set in the product space. -/
abbrev Body (n : ℕ) := ConvexBody (V n)

/-- The actual coordinate-deletion map. -/
def deleteCoord {n : ℕ} (i : Fin (n + 1)) : V (n + 1) →L[ℝ] V n where
  toFun x j := x (i.succAbove j)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  cont := by fun_prop

/-- Image of the body after deleting one coordinate. -/
def deleteBody {n : ℕ} (i : Fin (n + 1)) (K : Body (n + 1)) : Body n :=
  mapBody (deleteCoord i) K

/-- Actual Lebesgue areas of all two-coordinate projections. -/
def coordinateAreaMatrix {n : ℕ} (K : Body n) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => volume.real (projectN i j '' (K : Set (V n)))

/-- The actual coordinate-selection map. -/
def selectCoordinates {m n : ℕ} (σ : Fin m → Fin n) : V n →L[ℝ] V m where
  toFun x i := x (σ i)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  cont := by fun_prop

/-- The image body under coordinate selection. -/
def selectBody {m n : ℕ} (σ : Fin m → Fin n) (K : Body n) : Body m :=
  mapBody (selectCoordinates σ) K

/-- The specified root-product equality on the deleted four-coordinate area matrix. -/
def BoundaryAt (K : Body 5) (m : Fin 5) (k : Fin 3) : Prop :=
  letI : NeZero (3 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.fourNeZero
  let M := coordinateAreaMatrix (deleteBody m K)
  BoundaryEquality (Real.sqrt (M 0 1 * M 2 3))
    (Real.sqrt (M 0 2 * M 1 3)) (Real.sqrt (M 0 3 * M 1 2)) k

/-- A three-element block whose complementary two-element block agrees with all boundary quartets. -/
def BoundaryPartitionExtension (K : Body 5) (larger : Finset (Fin 5)) : Prop :=
  larger.card = 3 ∧ ∀ m : Fin 5, ∀ k : Fin 3, BoundaryAt K m k →
    m ∈ larger ∧ ∀ i j : Fin 5, i ≠ m → j ≠ m →
      (samePart m k i j ↔ (i ∈ larger ↔ j ∈ larger))
end ProjectionAreaMixedGeometry

namespace ProjectionAreaSharpness
/-- At least one of the three root-product inequalities is an equality. -/
def IsBoundaryQuartet (M : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  letI : NeZero (3 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.fourNeZero
  Real.sqrt (M 0 1 * M 2 3) = Real.sqrt (M 0 2 * M 1 3) + Real.sqrt (M 0 3 * M 1 2) ∨
  Real.sqrt (M 0 2 * M 1 3) = Real.sqrt (M 0 1 * M 2 3) + Real.sqrt (M 0 3 * M 1 2) ∨
  Real.sqrt (M 0 3 * M 1 2) = Real.sqrt (M 0 1 * M 2 3) + Real.sqrt (M 0 2 * M 1 3)
instance (M : Matrix (Fin 4) (Fin 4) ℝ) : Decidable (IsBoundaryQuartet M) := by
  unfold IsBoundaryQuartet
  infer_instance
end ProjectionAreaSharpness

namespace ProjectionAreaPaper
open VolumePolynomials ProjectionAreaTopology ProjectionAreaMixedGeometry
/-- The identity on coordinates from Euclidean space to the finite product norm. -/
def piCoordinates (n : ℕ) : CoordinateSpace n ≃L[ℝ] V n :=
  letI : Nat.AtLeastTwo (1 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.twoAtLeastTwo
  letI : NeZero (1 + 1 : ℕ) := PalomarProjectionAreas.NumericProofs.twoNeZero
  PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin n => ℝ)

/-- The same actual body in finite product coordinates. -/
def asPiBody {n : ℕ} (K : CoordinateBody n) : ProjectionAreaMixedGeometry.Body n :=
  mapBody (piCoordinates n).toContinuousLinearMap K

/-- The subtype of symmetric hollow area arrays. -/
abbrev HollowSymmetricArray (d : ℕ) :=
  {q : AreaArray d // (∀ i, q i i = 0) ∧ ∀ i j, q i j = q j i}

/-- Strict positivity of all off-diagonal area entries. -/
def PositiveArray {d : ℕ} (q : AreaArray d) : Prop :=
  ∀ i j, i ≠ j → 0 < q i j

/-- Exactly one positive and three negative actual matrix eigenvalues. -/
def HasSignatureOneThree (M : AreaArray 4) : Prop :=
  ∃ hM : M.IsHermitian,
    (Finset.univ.filter fun i => 0 < hM.eigenvalues i).card = 1 ∧
    (Finset.univ.filter fun i => hM.eigenvalues i < 0).card = 3
end ProjectionAreaPaper

