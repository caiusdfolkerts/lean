/-! # Undecidability of mixed-volume realization
Every coefficient is an ordinary homogeneous polynomial coefficient of actual
Lebesgue volume, including repeated-index terms and lower-dimensional bodies.
Exact rational inputs are represented surjectively by finite natural triples.
Theorems retain the actual nonnegative input restriction, the uniform program
quantifier order, and all parameters in the fixed and scalar sections.
Two algorithm values are supplied through Comparator definition_names; all
geometric, automaton, representation and rational-decoding semantics are literal.
-/

@[expose] public section
noncomputable section
open Set MeasureTheory Matrix Filter Metric
open scoped BigOperators Pointwise Topology
namespace TauCeti
open MvPolynomial
variable {σ τ R : Type*} [CommRing R] [LinearOrder R]
/-- The finite Boolean algebra generated by real polynomial zero sets and
strict positivity sets; this is the exact canonical Tau Ceti definition. -/
def IsSemialgebraic (s : Set (σ → R)) : Prop :=
  s ∈ generateSetAlgebra
    (range (fun p : MvPolynomial σ R => {x | eval x p = 0}) ∪
      range (fun p : MvPolynomial σ R => {x | 0 < eval x p}))
end TauCeti

namespace VolumePolynomials
/-- Literal real coordinate space. -/
abbrev Space (d : ℕ) := Fin d → ℝ
/-- An actual nonempty compact convex subset, with lower affine dimensions allowed. -/
abbrev Body (d : ℕ) := ConvexBody (Space d)
/-- Every ordinary monomial of total degree d. -/
abbrev MultiIndex (n d : ℕ) :=
  {α : Fin n → Fin (d + 1) // ∑ i, (α i : ℕ) = d}
/-- The complete array of ordinary homogeneous polynomial coefficients. -/
abbrev Coefficients (n d : ℕ) := MultiIndex n d → ℝ
/-- The finitely supported exponent vector of a monomial. -/
def exponent {n d : ℕ} (α : MultiIndex n d) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun i => (α.1 i : ℕ))
/-- The homogeneous polynomial evaluated at real Minkowski weights. -/
def evaluate {n d : ℕ} (c : Coefficients n d) (t : Fin n → ℝ) : ℝ :=
  ∑ α, c α * ∏ i, t i ^ (α.1 i : ℕ)
/-- Actual weighted Minkowski sum of the tuple. -/
def weightedSum {n d : ℕ} (K : Fin n → Body d) (t : Fin n → ℝ) : Body d :=
  ∑ i, t i • K i
/-- Actual Lebesgue volume of the literal compact convex set. -/
def bodyVolume {d : ℕ} (K : Body d) : ℝ := volume.real (K : Set (Space d))
/-- Actual volume of the weighted Minkowski sum. -/
def volumeFunction {n d : ℕ} (K : Fin n → Body d) (t : Fin n → ℝ) : ℝ :=
  bodyVolume (weightedSum K t)
/-- Equality with actual volume for every nonnegative real weight. -/
def Realizes {n d : ℕ} (K : Fin n → Body d) (c : Coefficients n d) : Prop :=
  ∀ t : Fin n → ℝ, (∀ i, 0 ≤ t i) → evaluate c t = volumeFunction K t
/-- Existence of a tuple of actual compact convex bodies realizing all coefficients. -/
def VolumeLocus (n d : ℕ) : Set (Coefficients n d) := {c | ∃ K, Realizes K c}
end VolumePolynomials

namespace MixedVolume.RationalCode
/-- Three natural numbers denoting a rational, with positive denominator. -/
abbrev Code := ℕ × ℕ × ℕ
/-- The positive denominator c_3+1. -/
def denominator (c : Code) : ℕ := c.2.2 + 1
/-- The exact rational value (c_1-c_2)/(c_3+1). -/
def eval (c : Code) : ℚ := ((c.1 : ℚ) - c.2.1) / denominator c
theorem eval_surjective : Function.Surjective eval := by
  intro q
  have hd : q.den - 1 + 1 = q.den := Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr q.den_nz)
  cases hn : q.num with
  | ofNat n =>
    refine ⟨(n, 0, q.den - 1), ?_⟩
    simpa only [eval, denominator, hd, Nat.cast_zero, sub_zero, hn, Int.ofNat_eq_natCast, Int.cast_natCast]
      using q.num_div_den
  | negSucc n =>
    refine ⟨(0, n + 1, q.den - 1), ?_⟩
    simpa only [eval, denominator, hd, Nat.cast_zero, zero_sub, hn,
      Int.cast_negSucc, Nat.cast_add, Nat.cast_one] using q.num_div_den
end MixedVolume.RationalCode

namespace MixedVolume.EffectiveSigns
open RationalCode
/-- The exact integer sign test on rational codes. -/
def Nonnegative (c : Code) : Prop := c.2.1 ≤ c.1
instance (c : Code) : Decidable (Nonnegative c) := inferInstanceAs (Decidable (c.2.1 ≤ c.1))
/-- The finite conjunction that every represented coefficient is nonnegative. -/
def AllNonnegative {n : ℕ} (c : Fin n → Code) : Prop := ∀ i, Nonnegative (c i)
instance {n : ℕ} (c : Fin n → Code) : Decidable (AllNonnegative c) :=
  inferInstanceAs (Decidable (∀ i, Nonnegative (c i)))
theorem nonnegative_primrec : PrimrecPred Nonnegative :=
  Primrec.nat_le.comp (Primrec.fst.comp Primrec.snd) Primrec.fst
theorem allNonnegative_primrec (n : ℕ) :
    PrimrecPred (AllNonnegative (n := n)) := by
  have hlist : Primrec (fun c : Fin n → Code => List.ofFn c) :=
    Primrec.list_ofFn (fun i => Primrec.fin_app.comp Primrec.id (Primrec.const i))
  have h := (PrimrecPred.forall_mem_list nonnegative_primrec).comp hlist
  exact h.of_eq (fun c => by simp [AllNonnegative])
end MixedVolume.EffectiveSigns

namespace MixedVolume.CoefficientCoding
open VolumePolynomials RationalCode
/-- The number of all ordinary degree-d coefficients. -/
def coordinateCount (n d : ℕ) : ℕ := Fintype.card (MultiIndex n d)
/-- The fixed complete finite enumeration of those coefficients. -/
def coordinateEquiv (n d : ℕ) : MultiIndex n d ≃ Fin (coordinateCount n d) :=
  Fintype.equivFin _
/-- A finite vector of exact rational codes, with every coefficient present. -/
abbrev ArrayCode (n d : ℕ) := Fin (coordinateCount n d) → RationalCode.Code
/-- The complete rational coefficient vector. -/
abbrev RationalArray (n d : ℕ) := MultiIndex n d → ℚ
/-- Exact rational decoding at every coefficient. -/
def rationalDecode {n d : ℕ} (c : ArrayCode n d) : RationalArray n d :=
  fun a => RationalCode.eval (c (coordinateEquiv n d a))
/-- The same complete decoded vector viewed over the reals. -/
def realDecode {n d : ℕ} (c : ArrayCode n d) : Coefficients n d :=
  fun a => (rationalDecode c a : ℝ)
/-- Membership of the decoded rational array in the literal convex-body coefficient locus. -/
def Realizable {n d : ℕ} (c : ArrayCode n d) : Prop :=
  realDecode c ∈ VolumeLocus n d
/-- The exact finite sign restriction on the input domain. -/
def Nonnegative {n d : ℕ} (c : ArrayCode n d) : Prop :=
  EffectiveSigns.AllNonnegative c
/-- The actual restricted type of inputs with no negative coefficient. -/
abbrev NonnegativeArray (n d : ℕ) := {c : ArrayCode n d // Nonnegative c}
instance {n d : ℕ} : DecidablePred (Nonnegative (n := n) (d := d)) :=
  fun c => inferInstanceAs (Decidable (EffectiveSigns.AllNonnegative c))
theorem nonnegative_primrec (n d : ℕ) :
    PrimrecPred (Nonnegative (n := n) (d := d)) :=
  EffectiveSigns.allNonnegative_primrec (coordinateCount n d)
instance (n d : ℕ) : Primcodable (NonnegativeArray n d) :=
  Primcodable.subtype (nonnegative_primrec n d)
end MixedVolume.CoefficientCoding

namespace MixedVolume.Completeness
variable {α β : Type*} [Primcodable α] [Primcodable β]
/-- Co-recursive enumerability and hardness under every computable many-one reduction. -/
def CoREComplete (q : β → Prop) : Prop :=
  REPred (fun b => ¬q b) ∧
    ∀ (p : ℕ → Prop), REPred (fun n => ¬p n) → p ≤₀ q
end MixedVolume.Completeness

namespace MixedVolume.AutomatonWords
/-- All finite words on the s-letter alphabet. -/
abbrev Word (s : ℕ) := List (Fin s)
/-- A literal nonnegative real vector whose entries sum to one. -/
def ProbabilityRow {m : ℕ} (p : Fin m → ℝ) : Prop :=
  (∀ j, 0 ≤ p j) ∧ ∑ j, p j = 1
/-- A finite stochastic automaton, accepting values in [0,1], and a common stationary probability row. -/
structure Data (s m : ℕ) where
  P : Fin s → Matrix (Fin m) (Fin m) ℝ
  P_nonneg : ∀ a j k, 0 ≤ P a j k
  P_sum : ∀ a j, ∑ k, P a j k = 1
  f : Fin m → ℝ
  f_nonneg : ∀ j, 0 ≤ f j
  f_le_one : ∀ j, f j ≤ 1
  stationary : Fin m → ℝ
  stationary_probability : ProbabilityRow stationary
  stationary_fixed : ∀ a, stationary ᵥ* P a = stationary
namespace Data
variable {s m : ℕ} (A : Data s m)
/-- The ordered product of transition matrices along a finite word. -/
def wordMatrix (A : Data s m) : Word s → Matrix (Fin m) (Fin m) ℝ :=
  List.rec 1 (fun a _ product => A.P a * product)
/-- The vector of accepting values after the word. -/
def value (w : Word s) (j : Fin m) : ℝ := (A.wordMatrix w *ᵥ A.f) j
/-- The actual acceptance value of the input probability row. -/
def acceptance (p : Fin m → ℝ) (w : Word s) : ℝ := p ⬝ᵥ A.value w
/-- Every finite word has acceptance value at most theta. -/
def UniversalCutpoint (p : Fin m → ℝ) (theta : ℝ) : Prop :=
  ∀ w : Word s, A.acceptance p w ≤ theta
end Data
end MixedVolume.AutomatonWords

namespace MixedVolume.AutomatonMoments
open AutomatonWords
/-- The complete rational stochastic automaton data, with all positivity and stationarity hypotheses. -/
structure RationalData (s m : ℕ) where
  P : Fin s → Matrix (Fin m) (Fin m) ℚ
  P_nonneg : ∀ a j k, 0 ≤ P a j k
  P_sum : ∀ a j, ∑ k, P a j k = 1
  f : Fin m → ℚ
  f_nonneg : ∀ j, 0 ≤ f j
  f_le_one : ∀ j, f j ≤ 1
  stationary : Fin m → ℚ
  stationary_nonneg : ∀ j, 0 ≤ stationary j
  stationary_sum : ∑ j, stationary j = 1
  stationary_fixed : ∀ a, stationary ᵥ* P a = stationary
/-- Coordinatewise inclusion of the exact rational automaton into real stochastic data. -/
def RationalData.toReal (A : RationalData s m) : Data s m where
  P a j k := A.P a j k
  P_nonneg a j k := by exact_mod_cast A.P_nonneg a j k
  P_sum a j := by exact_mod_cast A.P_sum a j
  f j := A.f j
  f_nonneg j := by exact_mod_cast A.f_nonneg j
  f_le_one j := by exact_mod_cast A.f_le_one j
  stationary j := A.stationary j
  stationary_probability := by
    constructor
    · intro j
      change 0 ≤ (A.stationary j : ℝ)
      exact_mod_cast A.stationary_nonneg j
    · change (∑ j, (A.stationary j : ℝ)) = 1
      exact_mod_cast A.stationary_sum
  stationary_fixed a := by
    funext j
    have h := congrFun (A.stationary_fixed a) j
    change (∑ k, (A.stationary k : ℝ) * (A.P a k j : ℝ)) = (A.stationary j : ℝ)
    change (∑ k, A.stationary k * A.P a k j) = A.stationary j at h
    exact_mod_cast h
end MixedVolume.AutomatonMoments

namespace MixedVolume.Represented
/-- An exact surjective data representation by a type with Mathlib primitive-recursive coding. -/
class Representation (α : Type) where
  Code : Type
  instPrimcodable : Primcodable Code
  decode : Code → α
  onto : Function.Surjective decode
attribute [instance_reducible, instance] Representation.instPrimcodable
/-- The concrete code type of a represented datum. -/
abbrev Code (α : Type) [Representation α] := Representation.Code α
/-- The exact semantic decoder. -/
abbrev decode {α : Type} [Representation α] : Code α → α := Representation.decode

@[reducible] instance (priority := 10) identityRepresentation (α : Type) [Primcodable α] :
    Representation α where
  Code := α
  instPrimcodable := inferInstance
  decode := id
  onto := Function.surjective_id

@[reducible] instance (priority := 2000) rationalRepresentation : Representation ℚ where
  Code := RationalCode.Code
  instPrimcodable := inferInstance
  decode := RationalCode.eval
  onto := RationalCode.eval_surjective

@[reducible] instance (priority := 1000) pairRepresentation (α β : Type)
    [Representation α] [Representation β] : Representation (α × β) where
  Code := Code α × Code β
  instPrimcodable := inferInstance
  decode x := (decode x.1, decode x.2)
  onto := by
    rintro ⟨a,b⟩
    obtain ⟨c,hc⟩ := Representation.onto a
    obtain ⟨d,hd⟩ := Representation.onto b
    exact ⟨(c,d),by simp [hc,hd]⟩

@[reducible] instance (priority := 1000) listRepresentation (α : Type) [Representation α] :
    Representation (List α) where
  Code := List (Code α)
  instPrimcodable := inferInstance
  decode x := x.map decode
  onto := by
    intro l
    induction l with
    | nil => exact ⟨[],rfl⟩
    | cons a l ih =>
      obtain ⟨c,hc⟩ := Representation.onto a
      obtain ⟨d,hd⟩ := ih
      exact ⟨c::d,by simp [hc,hd]⟩

@[reducible] instance (priority := 1000) functionRepresentation (n : ℕ) (α : Type)
    [Representation α] : Representation (Fin n → α) where
  Code := Fin n → Code α
  instPrimcodable := inferInstance
  decode x i := decode (x i)
  onto := by
    intro f
    classical
    choose c hc using fun i => Representation.onto (f i)
    exact ⟨c,funext hc⟩

end MixedVolume.Represented

namespace MixedVolume.GeneralLocus
/-- The exact body count (s+1)m+s+5. -/
def numberOfBodies (s m : ℕ) : ℕ := (s+1)*m+s+5
end MixedVolume.GeneralLocus
namespace MixedVolume.RationalExtraction
open VolumePolynomials
/-- The explicit base-(d+2) index of an ordinary monomial in the dense table. -/
def coefficientCode {n d : ℕ} (α : MultiIndex n d) : ℕ :=
  Nat.ofDigits (d + 2) (List.ofFn fun i => (α.1 i : ℕ))
/-- The exact dense interpolation-table size (d+2)^n. -/
def interpolationSize (n d : ℕ) : ℕ := (d + 2) ^ n
end MixedVolume.RationalExtraction

namespace MixedVolume.RationalReduction
variable {m : ℕ}
/-- The m probability coordinates and one threshold coordinate. -/
abbrev Parameter (m : ℕ) := Fin m ⊕ Unit
/-- Literal substitution of the initial row and threshold. -/
def assignment {R : Type*} (p : Fin m → R) (theta : R) : Parameter m → R
  | .inl j => p j
  | .inr _ => theta
end MixedVolume.RationalReduction

namespace MixedVolume.UniformMoments
/-- Alphabet/state dimensions and ordinary lists of rational transition and accepting data. -/
abbrev RawAutomaton := ℕ × (ℕ × (List (List (List ℚ)) × List ℚ))
/-- The explicit list encoding of every rational finite automaton. -/
def encode {s m : ℕ} (A : AutomatonMoments.RationalData s m) : RawAutomaton :=
  (s,(m,(List.ofFn (fun a => List.ofFn (fun j => List.ofFn (A.P a j))),List.ofFn A.f)))
end MixedVolume.UniformMoments

namespace MixedVolume.UniformEncoding
open Represented UniformMoments AutomatonMoments VolumePolynomials
/-- Dimensions, rational automaton, stationary row, initial row and threshold. -/
abbrev Input := RawAutomaton × (List ℚ × (List ℚ × ℚ))
/-- The body-count header followed by the full rational coefficient table. -/
abbrev Output := ℕ × List ℚ
/-- The exact semantic encoding of a valid rational input. -/
def encodeInput {s m : ℕ} (A : RationalData s m) (p : Fin m → ℚ) (theta : ℚ) : Input :=
  (UniformMoments.encode A,(List.ofFn A.stationary,(List.ofFn p,theta)))
/-- Supplied algorithm value: the source single partial-recursive program.
The compared Theorem 4.3 constrains it before all dimensions and all rational
inputs, proves totality on every valid representation, fixes every output
coefficient and table size, and links its result to the literal volume locus. -/
def program (c : Code Input) : Part (Code Output) := by sorry
/-- The complete ordinary coefficient array decoded from the dense output table. -/
def decodedArray (n : ℕ) (result : Code Output) : Coefficients n 3 :=
  fun a => ((decode result).2.getD (RationalExtraction.coefficientCode a) 0 : ℝ)
end MixedVolume.UniformEncoding

namespace PalomarMixedVolume.LiteralEvaluation
universe uEval
/-- A named genuine characteristic-zero witness fixes the measured implicit proof argument. -/
theorem realCharZero : CharZero ℝ := by infer_instance
/-- Literal evaluation of every ordinary coefficient of a supplied rational
polynomial family. The family is an explicit argument, not a hidden data value. -/
def evaluate {σ : Type uEval} {n d : ℕ}
    (family : VolumePolynomials.MultiIndex n d → MvPolynomial σ ℚ)
    (a : σ → ℝ) : VolumePolynomials.Coefficients n d :=
  letI : CharZero ℝ := realCharZero
  fun α => MvPolynomial.eval₂ (algebraMap ℚ ℝ) a (family α)
end PalomarMixedVolume.LiteralEvaluation

namespace MixedVolume.UniformQuadratic
open AutomatonMoments GeneralLocus RationalReduction VolumePolynomials
variable {s m : ℕ}
/-- Supplied rational coefficient-family value from the source uniform
construction. Theorem 4.3 constrains every coefficient to degree at most two,
the exact computed output, and equivalence with universal cutpoint acceptance
for all stochastic initial rows and thresholds in (0,1). -/
def coefficientSymbol (A : RationalData s m) (a : MultiIndex (numberOfBodies s m) 3) :
    MvPolynomial (Parameter m) ℚ := by sorry
end MixedVolume.UniformQuadratic

namespace MixedVolume.FixedSection
open VolumePolynomials
/-- Every ordinary cubic index for the ninety-one-body fixed section. -/
abbrev Index := MultiIndex 91 3
end MixedVolume.FixedSection

namespace MixedVolume.ScalarPolynomial
/-- The twelve actual body labels. -/
abbrev Label := Fin 12
/-- Three real scalar parameters. -/
abbrev Parameter := Fin 3
/-- Exact state-label constructor bound. -/
theorem stateLabel_bound (i : Parameter) : 5 + i.val < 12 := by omega
/-- The three state-body labels. -/
def stateLabel (i : Parameter) : Label := ⟨5 + i.val, stateLabel_bound i⟩
/-- Exact image-label constructor bound. -/
theorem imageLabel_bound (i : Parameter) : 8 + i.val < 12 := by omega
/-- The three image-body labels. -/
def imageLabel (i : Parameter) : Label := ⟨8 + i.val, imageLabel_bound i⟩
/-- The final deficit-body label. -/
def deficitLabel : Label := 11
/-- The literal three dyadic rates 1, 1/2 and 1/4. -/
def rate (i : Parameter) : ℚ :=
  if i = 0 then 1 else if i = 1 then 1 / 2 else 1 / 4
/-- The exact rational height constants. -/
def heightRat (i : Parameter) : ℚ := 1 / (1 - rate i / 4)
/-- The exact rational width constants. -/
def widthRat (i : Parameter) : ℚ :=
  heightRat i - 1 / (1 - rate i / 8)
/-- The exact rational area constants. -/
def areaRat (i : Parameter) : ℚ :=
  widthRat i / (1 - rate i ^ 2 / 32)
/-- The exact rational mixed-area constants. -/
def mixedRat (i j : Parameter) : ℚ :=
  (widthRat i + widthRat j) / (1 - rate i * rate j / 32)
section
variable {R : Type*} [CommRing R] [Algebra ℚ R]
/-- The rational scalar inclusion. -/
def rat (q : ℚ) : R := algebraMap ℚ R q
/-- The exact linear height form. -/
def height (b : Parameter → R) : R :=
  rat (heightRat 0) * b 0 +
  rat (heightRat 1) * b 1 +
  rat (heightRat 2) * b 2
/-- The exact linear width form. -/
def width (b : Parameter → R) : R :=
  rat (widthRat 0) * b 0 +
  rat (widthRat 1) * b 1 +
  rat (widthRat 2) * b 2
/-- The exact rational quadratic area form. -/
def quadratic (b : Parameter → R) : R :=
  rat (areaRat 0) * b 0 ^ 2 +
  rat (areaRat 1) * b 1 ^ 2 +
  rat (areaRat 2) * b 2 ^ 2 +
  rat (mixedRat 0 1) * b 0 * b 1 +
  rat (mixedRat 0 2) * b 0 * b 2 +
  rat (mixedRat 1 2) * b 1 * b 2
/-- The associated polar bilinear area form. -/
def bilinear (b c : Parameter → R) : R :=
  2 * rat (areaRat 0) * b 0 * c 0 +
  2 * rat (areaRat 1) * b 1 * c 1 +
  2 * rat (areaRat 2) * b 2 * c 2 +
  rat (mixedRat 0 1) * (b 0 * c 1 + b 1 * c 0) +
  rat (mixedRat 0 2) * (b 0 * c 2 + b 2 * c 0) +
  rat (mixedRat 1 2) * (b 1 * c 2 + b 2 * c 1)
/-- The coordinatewise inverse-rate scaling. -/
def divideRates (c : Parameter → R) : Parameter → R :=
  fun i => rat (1 / rate i) * c i
/-- The sum of the three components. -/
def componentSum (b : Parameter → R) : R := b 0 + b 1 + b 2
/-- The complete reference-body cubic. -/
def referenceCubic (e₁ e₂ e₃ s ι : R) : R :=
  e₁ * e₂ * e₃ + e₁ * e₂ * s + e₁ * e₂ * ι +
  2 * e₁ * e₃ * s + e₁ * e₃ * ι + e₁ * s * ι +
  e₂ * e₃ * s + e₂ * s * ι + e₃ * s * ι
/-- The complete twelve-body cubic, with every repeated-index contribution. -/
def canonicalFormula (e₁ e₂ e₃ s ι : R)
    (b c : Parameter → R) : R :=
  quadratic b * (rat (1 / 4) * height c) +
  rat (1 / 32) * quadratic c * height b +
  e₁ * height b * (rat (1 / 4) * height c) +
  e₂ * (quadratic b + width (divideRates c) * height b) +
  e₃ * (rat (1 / 32) * quadratic c +
    width b * (rat (1 / 4) * height c)) +
  s * rat (1 / 32) * quadratic (fun i => 8 * b i + c i) +
  ι * (quadratic (fun i => b i + divideRates c i) -
    componentSum (divideRates c) * width (fun i => b i + divideRates c i)) +
  e₁ * e₂ * height b +
  e₁ * e₃ * (rat (1 / 4) * height c) +
  e₁ * s * (2 * height b + rat (1 / 4) * height c) +
  e₁ * ι * (height b + rat (1 / 4) * height c) +
  e₂ * e₃ * (width b + width (divideRates c)) +
  e₂ * s * (width b + height b + width (divideRates c)) +
  e₂ * ι * (width b + width (divideRates c)) +
  e₃ * s * (2 * width b + rat (1 / 4) * width c) +
  e₃ * ι * (width b + width (divideRates c)) +
  s * ι * (height b - width b +
    rat (1 / 4) * height c - width (divideRates c)) +
  referenceCubic e₁ e₂ e₃ s ι
/-- The exact coefficient of quadratic state dependence. -/
def kappa (e₂ s ι : R) (c : Parameter → R) : R :=
  rat (1 / 4) * height c + e₂ + 64 * rat (1 / 32) * s + ι
/-- The exact linear-height coefficient. -/
def linearHeight (e₁ e₂ s ι : R) (c : Parameter → R) : R :=
  rat (1 / 32) * quadratic c +
  rat (1 / 4) * e₁ * height c +
  e₂ * width (divideRates c) +
  e₁ * e₂ + 2 * e₁ * s + e₁ * ι + e₂ * s + s * ι
/-- The exact linear-width coefficient. -/
def linearWidth (e₂ e₃ s ι : R) (c : Parameter → R) : R :=
  rat (1 / 4) * e₃ * height c -
  ι * componentSum (divideRates c) +
  e₂ * e₃ + e₂ * s + e₂ * ι +
  2 * e₃ * s + e₃ * ι - s * ι
/-- The exact state-linear part of the cubic. -/
def linearStatePart (e₁ e₂ e₃ s ι : R)
    (a c : Parameter → R) : R :=
  linearHeight e₁ e₂ s ι c * height a +
  linearWidth e₂ e₃ s ι c * width a +
  8 * rat (1 / 32) * s * bilinear a c +
  ι * bilinear a (divideRates c)
end
/-- The complete cubic over the rational polynomial ring. -/
def canonicalRationalPolynomial : MvPolynomial Label ℚ :=
  canonicalFormula (MvPolynomial.X 0) (MvPolynomial.X 1)
    (MvPolynomial.X 2) (MvPolynomial.X 3) (MvPolynomial.X 4)
    (fun i => MvPolynomial.X (stateLabel i))
    (fun i => MvPolynomial.X (imageLabel i))
end MixedVolume.ScalarPolynomial

namespace MixedVolume.ScalarSection
open VolumePolynomials ScalarPolynomial MvPolynomial
/-- The three literal state polynomial variables. -/
def stateVariables : Parameter → MvPolynomial Label ℚ := fun i => X (stateLabel i)
/-- The three literal image polynomial variables. -/
def imageVariables : Parameter → MvPolynomial Label ℚ := fun i => X (imageLabel i)
/-- The exact linear parameter contribution to the full cubic. -/
def rationalLinearBody (i : Parameter) : MvPolynomial Label ℚ :=
  X deficitLabel *
    (kappa (X 1) (X 3) (X 4) imageVariables * bilinear stateVariables (Pi.single i 1) +
      linearStatePart (X 0) (X 1) (X 2) (X 3) (X 4) (Pi.single i 1) imageVariables)
/-- The exact quadratic parameter contribution to the full cubic. -/
def rationalQuadraticBody : MvPolynomial Label ℚ :=
  X deficitLabel ^ 2 * kappa (X 1) (X 3) (X 4) imageVariables
/-- The explicit rational polynomial for every ordinary cubic coefficient. -/
def rationalCoefficient (α : MultiIndex 12 3) : MvPolynomial Parameter ℚ :=
  C (canonicalRationalPolynomial.coeff (exponent α)) -
    C ((rationalLinearBody 0).coeff (exponent α)) * X 0 -
    C ((rationalLinearBody 1).coeff (exponent α)) * X 1 -
    C ((rationalLinearBody 2).coeff (exponent α)) * X 2 +
    C (rationalQuadraticBody.coeff (exponent α)) * quadratic (fun i => X i)
end MixedVolume.ScalarSection

namespace MixedVolume.DyadicCone
/-- The dyadic value 2 to the power -n. -/
def t (n : ℕ) : ℝ := (1 / 2 : ℝ) ^ n
/-- The actual supporting linear functional with coefficients (1,2^-n,4^-n). -/
def normal (n : ℕ) : (Fin 3 → ℝ) →L[ℝ] ℝ where
  toFun a := a 0 + t n * a 1 + t n ^ 2 * a 2
  map_add' a b := by simp only [Pi.add_apply]; ring
  map_smul' r a := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring
  cont := by fun_prop
/-- The intersection of all the displayed supporting halfspaces. -/
def cone : Set (Fin 3 → ℝ) := {a | ∀ n, normal n a ≤ 0}
/-- The zero plane of the n-th displayed linear functional. -/
def plane (n : ℕ) : Set (Fin 3 → ℝ) := {a | normal n a = 0}
end MixedVolume.DyadicCone

