/-- Literal SymmetricPower.tprodOfSym_ofFn; precise source and scope recorded in the extraction map. -/
theorem tprodOfSym_ofFn (v : κ → M) (f : Fin n → κ) :
    tprodOfSym R v (TauCeti.Sym.ofFn f) = ⨂ₛ[R] i, v (f i) := by sorry
