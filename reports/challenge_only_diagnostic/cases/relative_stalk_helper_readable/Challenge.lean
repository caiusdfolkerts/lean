/-- Literal retained-source def; original position theorem94.lean:11619. -/
def finsetOrderCongr (e : V ≃ W) : Finset V ≃o Finset W :=
  { e.finsetCongr with map_rel_iff' := by intro s t; exact Finset.map_subset_map }
/-- Literal retained-source theorem; original position theorem94.lean:11656. -/
theorem simplex_isSimplicialPoset : IsSimplicialPoset (Finset V) := by sorry
/-- Literal retained-source theorem; original position theorem94.lean:11697. -/
theorem simplexOrderAction_one : finsetOrderCongr (1 : Equiv.Perm V) = OrderIso.refl _ := by sorry
/-- Literal retained-source theorem; original position theorem94.lean:11700. -/
theorem simplexOrderAction_mul (e f : Equiv.Perm V) :
    finsetOrderCongr (e * f) = (finsetOrderCongr f).trans (finsetOrderCongr e) := by sorry
end
end FourPapers.Universal

