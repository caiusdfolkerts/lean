      "source_body": "def compatibilityOperator (J : PairPinGraph B E) (p : E \u2192 Vec3) :\n    (B \u2192 Twist) \u2192\u2097[\u211d] (E \u2192 Vec3) :=\n  LinearMap.pi fun e =>\n    (evaluateTwist (p e)).comp\n      (LinearMap.proj (R := \u211d) (\u03c6 := fun _ : B => Twist) (J.left e) -\n        LinearMap.proj (R := \u211d) (\u03c6 := fun _ : B => Twist) (J.right e))",
      "challenge_body": "def compatibilityOperator (J : PairPinGraph B E) (p : E \u2192 Vec3) :\n    (B \u2192 Twist) \u2192\u2097[\u211d] (E \u2192 Vec3) :=\n  LinearMap.pi fun e =>\n    (evaluateTwist (p e)).comp\n      (LinearMap.proj (R := \u211d) (\u03c6 := fun _ : B => Twist) (J.left e) -\n        LinearMap.proj (R := \u211d) (\u03c6 := fun _ : B => Twist) (J.right e))"
    },
    {
      "short_name": "pinRow",
