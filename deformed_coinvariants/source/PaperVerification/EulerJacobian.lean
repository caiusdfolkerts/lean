module

public import Mathlib.RingTheory.MvPolynomial.EulerIdentity
public import Mathlib.LinearAlgebra.Span.Defs
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.FieldSimp

/-!
# Weighted Euler reduction for Jacobian operator images

Definitions use the genuine multivariate-polynomial derivations and vector-space sums
of operator images. The nonresonant equality is Theorem 6.2 of the attached
`The Hivert–Thiéry conjecture and differential normal forms`.
-/

@[expose] public section

noncomputable section

set_option autoImplicit false

open MvPolynomial
open scoped BigOperators

namespace PaperVerification.EulerJacobian

variable {K ι : Type*} [Field K] [Fintype ι]

abbrev Poly := MvPolynomial ι K

/-- The actual first-order operator, with multiplication on the displayed side. -/
def operator (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι)) (t : K)
    (i : ι) (g : Poly (K := K) (ι := ι)) : Poly (K := K) (ι := ι) :=
  A i * g + t • (F * pderiv i g)

/-- A vector-space sum of images; it is deliberately not defined as an ideal. -/
def hit (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι)) (t : K) :
    Submodule K (Poly (K := K) (ι := ι)) :=
  Submodule.span K {f | ∃ i g, f = operator A F t i g}

/-- The ordinary polynomial ideal generated by the multiplication coefficients. -/
def coefficientIdeal (A : ι → Poly (K := K) (ι := ι)) : Ideal (Poly (K := K) (ι := ι)) :=
  Ideal.span (Set.range A)

theorem operator_mem_hit (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι)) (t : K)
    (i : ι) (g : Poly (K := K) (ι := ι)) : operator A F t i g ∈ hit A F t :=
  Submodule.subset_span ⟨i, g, rfl⟩

theorem coefficient_mem_ideal (A : ι → Poly (K := K) (ι := ι)) (i : ι) :
    A i ∈ coefficientIdeal A := Ideal.subset_span ⟨i, rfl⟩

/-- The Euler identity for the multiplication part is the only structural input. -/
def EulerRelation (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (w : ι → ℕ) (h : K) : Prop :=
  ∑ i, w i • (X i * A i) = h • F

/-- The degree of a monomial in the specified natural-number weights. -/
def monomialWeight (w : ι → ℕ) (a : ι →₀ ℕ) : ℕ := ∑ i, w i * a i

/-- Euler's sum of the operator values, before imposing homogeneity on the input. -/
theorem weighted_operator_sum (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (t : K) (w : ι → ℕ) (h : K) (hF : EulerRelation A F w h)
    (g : Poly (K := K) (ι := ι)) :
    ∑ i, w i • operator A F t i (X i * g) =
      h • (F * g) + t • (F * ((∑ i, w i) • g + ∑ i, w i • (X i * pderiv i g))) := by
  classical
  have hterm (i : ι) : w i • operator A F t i (X i * g) =
      (w i • (X i * A i)) * g +
      t • (F * (w i • g + w i • (X i * pderiv i g))) := by
    simp only [operator, pderiv_mul, pderiv_X_self, one_mul]
    simp [nsmul_eq_mul, Algebra.smul_def]
    <;> ring
  simp_rw [hterm, Finset.sum_add_distrib]
  rw [← Finset.sum_mul, hF, smul_mul_assoc, ← Finset.smul_sum, ← Finset.mul_sum]
  rw [Finset.sum_add_distrib, ← Finset.sum_smul]

/-- On a monomial the weighted Euler operator is diagonal. -/
theorem weighted_euler_monomial (w : ι → ℕ) (a : ι →₀ ℕ) (c : K) :
    (∑ i, w i • (X i * pderiv i (monomial a c))) =
      monomialWeight w a • (monomial a c : Poly (K := K) (ι := ι)) := by
  simp only [X_mul_pderiv_monomial, smul_smul, monomialWeight, Finset.sum_smul]

/-- Every monomial multiple of `F` is hit when its Euler eigenvalue is nonzero. -/
theorem mul_monomial_mem_hit (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (t : K) (w : ι → ℕ) (h : K) (hF : EulerRelation A F w h)
    (a : ι →₀ ℕ) (c : K)
    (hne : h + t * ((∑ i, w i : ℕ) + monomialWeight w a : K) ≠ 0) :
    F * monomial a c ∈ hit A F t := by
  classical
  have hsum : (∑ i, w i • operator A F t i (X i * monomial a c)) ∈ hit A F t :=
    (hit A F t).sum_mem fun i _ => (hit A F t).nsmul_mem
      (operator_mem_hit A F t i (X i * monomial a c)) (w i)
  rw [weighted_operator_sum A F t w h hF, weighted_euler_monomial] at hsum
  have heq : h • (F * monomial a c) +
      t • (F * ((∑ i, w i) • monomial a c + monomialWeight w a • monomial a c)) =
      (h + t * ((∑ i, w i : ℕ) + monomialWeight w a : K)) • (F * monomial a c) := by
    simp [nsmul_eq_mul, Algebra.smul_def]
    <;> ring
  rw [heq] at hsum
  have := (hit A F t).smul_mem (h + t * ((∑ i, w i : ℕ) + monomialWeight w a : K))⁻¹ hsum
  simpa only [smul_smul, inv_mul_cancel₀ hne, one_smul] using this

/-- The nonresonance condition controls all polynomial inputs, without a degree cutoff. -/
theorem mul_mem_hit (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (t : K) (w : ι → ℕ) (h : K) (hF : EulerRelation A F w h)
    (hnr : ∀ a : ι →₀ ℕ, h + t * ((∑ i, w i : ℕ) + monomialWeight w a : K) ≠ 0)
    (g : Poly (K := K) (ι := ι)) : F * g ∈ hit A F t := by
  induction g using MvPolynomial.induction_on' with
  | monomial a c => exact mul_monomial_mem_hit A F t w h hF a c (hnr a)
  | add p q hp hq => simpa only [mul_add] using (hit A F t).add_mem hp hq

/-- Ordinary coefficient multiples become hit after applying the Euler reduction. -/
theorem coefficient_mul_mem_hit (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (t : K) (w : ι → ℕ) (h : K) (hF : EulerRelation A F w h)
    (hnr : ∀ a : ι →₀ ℕ, h + t * ((∑ i, w i : ℕ) + monomialWeight w a : K) ≠ 0)
    (i : ι) (g : Poly (K := K) (ι := ι)) : A i * g ∈ hit A F t := by
  have hh := (hit A F t).sub_mem (operator_mem_hit A F t i g)
    ((hit A F t).smul_mem t (mul_mem_hit A F t w h hF hnr (pderiv i g)))
  simpa only [operator, add_sub_cancel_right] using hh

/-- Every hit polynomial lies in the coefficient ideal when the perturbing
polynomial belongs to that ideal. -/
theorem hit_le_coefficientIdeal (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (t : K) (hF : F ∈ coefficientIdeal A) :
    hit A F t ≤ (coefficientIdeal A).restrictScalars K := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i, g, rfl⟩
  exact ((coefficientIdeal A).restrictScalars K).add_mem
    ((coefficientIdeal A).mul_mem_right g (coefficient_mem_ideal A i))
    (((coefficientIdeal A).restrictScalars K).smul_mem t
      ((coefficientIdeal A).mul_mem_right (pderiv i g) hF))

/-- Nonzero Euler degree puts the perturbing polynomial in the coefficient ideal. -/
theorem perturbation_mem_ideal (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (w : ι → ℕ) (h : K) (hF : EulerRelation A F w h) (hh : h ≠ 0) :
    F ∈ coefficientIdeal A := by
  change F ∈ (coefficientIdeal A).restrictScalars K
  have hsum : (∑ i, w i • (X i * A i)) ∈ (coefficientIdeal A).restrictScalars K :=
    ((coefficientIdeal A).restrictScalars K).sum_mem fun i _ =>
      ((coefficientIdeal A).restrictScalars K).nsmul_mem
        ((coefficientIdeal A).mul_mem_left (X i) (coefficient_mem_ideal A i)) (w i)
  rw [hF] at hsum
  have := ((coefficientIdeal A).restrictScalars K).smul_mem h⁻¹ hsum
  simpa only [smul_smul, inv_mul_cancel₀ hh, one_smul] using this

/-- The full, untruncated Euler reduction: equality of actual vector subspaces. -/
theorem hit_eq_coefficientIdeal (A : ι → Poly (K := K) (ι := ι)) (F : Poly (K := K) (ι := ι))
    (t : K) (w : ι → ℕ) (h : K) (hF : EulerRelation A F w h) (hh : h ≠ 0)
    (hnr : ∀ a : ι →₀ ℕ, h + t * ((∑ i, w i : ℕ) + monomialWeight w a : K) ≠ 0) :
    hit A F t = (coefficientIdeal A).restrictScalars K := by
  apply le_antisymm
  · exact hit_le_coefficientIdeal A F t (perturbation_mem_ideal A F w h hF hh)
  · intro f hf
    change f ∈ Submodule.span (Poly (K := K) (ι := ι)) (Set.range A) at hf
    have aux : ∀ g : Poly (K := K) (ι := ι), g * f ∈ hit A F t := by
      induction hf using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        intro g
        simpa only [mul_comm] using coefficient_mul_mem_hit A F t w h hF hnr i g
      | zero => intro g; simpa only [mul_zero] using (hit A F t).zero_mem
      | add x y hx hy ihx ihy =>
        intro g
        simpa only [mul_add] using (hit A F t).add_mem (ihx g) (ihy g)
      | smul a x hx ih =>
        intro g
        simpa only [smul_eq_mul, mul_assoc] using ih (g * a)
    simpa only [one_mul] using aux 1

/-- Theorem 6.2 in an equivalent eigenvalue formulation, over every characteristic-zero
field and with no isolated-singularity assumption. -/
theorem jacobian_hit_eq (F : Poly (K := K) (ι := ι)) (t : K) (w : ι → ℕ) (h : ℕ)
    [CharZero K] (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h)
    (hnr : ∀ a : ι →₀ ℕ,
      (h : K) + t * ((∑ i, w i : ℕ) + monomialWeight w a : K) ≠ 0) :
    hit (fun i => pderiv i F) F t =
      (coefficientIdeal (fun i => pderiv i F)).restrictScalars K := by
  apply hit_eq_coefficientIdeal (fun i => pderiv i F) F t w (h : K)
  · simpa only [EulerRelation, Nat.cast_smul_eq_nsmul] using hF.sum_weight_X_mul_pderiv
  · exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hh)
  · exact hnr

end PaperVerification.EulerJacobian
