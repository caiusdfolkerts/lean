module

public import PaperVerification.HomogeneousKoszulMatrices

/-!
# Equivariant presentations of homogeneous complete intersections

The quotient is the literal polynomial ring modulo the ideal generated by the
given family. When every generator is invariant, variable renaming induces the
actual quotient representation. The first two finite Koszul matrices commute
with that action and the first matrix presents each actual quotient degree.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open MvPolynomial Matrix Representation
open scoped BigOperators

namespace PaperVerification.PowerOperators

section Ring

variable {R : Type*} [CommRing R] {n : ℕ}
local notation "P" => MvPolynomial (Fin n) R

def ordinaryFamilyIdeal (f : Fin n → P) : Ideal P := Ideal.span (Set.range f)

theorem range_ordinaryCoefficient (f : Fin n → P) :
    LinearMap.range ((KoszulSyzygies.coefficient f).restrictScalars R) =
      (ordinaryFamilyIdeal f).restrictScalars R := by
  rw [LinearMap.range_restrictScalars,KoszulSyzygies.coefficient,Fintype.range_linearCombination]
  rfl

theorem rename_ordinaryCoefficient (e : Equiv.Perm (Fin n)) (f v : Fin n → P)
    (hf : ∀ i, MvPolynomial.rename e (f i) = f i) :
    MvPolynomial.rename e (KoszulSyzygies.coefficient f v) =
      KoszulSyzygies.coefficient f (fun i => MvPolynomial.rename e (v i)) := by
  simp only [KoszulSyzygies.coefficient_apply,map_sum,map_mul,hf]

theorem rename_ordinaryBoundary (e : Equiv.Perm (Fin n)) (f : Fin n → P)
    (A : Fin n → Fin n → P) (hf : ∀ i, MvPolynomial.rename e (f i) = f i) (i : Fin n) :
    MvPolynomial.rename e (KoszulSyzygies.boundary f A i) =
      KoszulSyzygies.boundary f (fun j k => MvPolynomial.rename e (A j k)) i := by
  simp only [KoszulSyzygies.boundary_apply,map_sum,map_mul,map_sub,hf]

theorem rename_mem_ordinaryFamilyIdeal (e : Equiv.Perm (Fin n)) (f : Fin n → P)
    (hf : ∀ i, MvPolynomial.rename e (f i) = f i) {p : P} (hp : p ∈ ordinaryFamilyIdeal f) :
    MvPolynomial.rename e p ∈ ordinaryFamilyIdeal f := by
  have hp' : p ∈ LinearMap.range ((KoszulSyzygies.coefficient f).restrictScalars R) := by
    rw [range_ordinaryCoefficient]
    exact hp
  obtain ⟨v,rfl⟩ := hp'
  change MvPolynomial.rename e (KoszulSyzygies.coefficient f v) ∈ ordinaryFamilyIdeal f
  rw [rename_ordinaryCoefficient e f v hf]
  exact (range_ordinaryCoefficient f).le (LinearMap.mem_range_self _ _)

theorem ordinaryFirstMatrix_intertwines (G : Subgroup (Equiv.Perm (Fin n)))
    (f : Fin n → P) (m d : ℕ) (hf : ∀ i, (f i).IsHomogeneous (m+i.val))
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i) (g : G) :
    (ordinaryFirstMatrix f m d).mulVecLin.comp (tailDegreeAction G m d g) =
      (shiftedDegreeAction G 0 d g).comp (ordinaryFirstMatrix f m d).mulVecLin := by
  apply LinearMap.ext
  intro v
  apply shiftedDecode_injective 0 d
  change shiftedDecode 0 d
      (ordinaryFirstMatrix f m d *ᵥ (tailDegreeAction G m d g v)) =
    shiftedDecode 0 d (shiftedRename (g : Equiv.Perm (Fin n)) 0 d
      (ordinaryFirstMatrix f m d *ᵥ v))
  rw [shiftedDecode_ordinaryFirst f m d hf, shiftedDecode_shiftedRename,
    shiftedDecode_ordinaryFirst f m d hf, rename_ordinaryCoefficient _ f _ (hinv g)]
  apply congrArg (KoszulSyzygies.coefficient f)
  funext i
  exact tailDegreeDecode_action G m d g v i

theorem ordinarySecondMatrix_intertwines (G : Subgroup (Equiv.Perm (Fin n)))
    (f : Fin n → P) (m d : ℕ) (hf : ∀ i, (f i).IsHomogeneous (m+i.val))
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i) (g : G) :
    (ordinarySecondMatrix f m d).mulVecLin.comp (syzygyDegreeAction G m d g) =
      (tailDegreeAction G m d g).comp (ordinarySecondMatrix f m d).mulVecLin := by
  apply LinearMap.ext
  intro v
  apply tailDegreeDecode_injective m d
  funext i
  simp only [LinearMap.comp_apply,Matrix.mulVecLin_apply,
    tailDegreeDecode_ordinarySecond f m d hf,tailDegreeDecode_action]
  rw [rename_ordinaryBoundary _ f _ (hinv g)]
  apply congrArg (fun A => KoszulSyzygies.boundary f A i)
  funext j k
  exact syzygyDegreeDecode_action G m d g v j k

end Ring

section Field

variable {K : Type*} [Field K] {n : ℕ}
local notation "P" => MvPolynomial (Fin n) K

def ordinaryQuotientDegree (f : Fin n → P) (d : ℕ) : Submodule K (P ⧸ ordinaryFamilyIdeal f) :=
  (homogeneousSubmodule (Fin n) K d).map ((ordinaryFamilyIdeal f).mkQ.restrictScalars K)

theorem ordinaryQuotientDegree_eq_shifted (f : Fin n → P) (d : ℕ) :
    ordinaryQuotientDegree f d =
      (shiftedPiece K n 0 d).map ((ordinaryFamilyIdeal f).mkQ.restrictScalars K) := by
  rw [shiftedPiece_eq_homogeneous (Nat.zero_le d),Nat.sub_zero]
  rfl

instance ordinaryQuotientDegree_finite (f : Fin n → P) (d : ℕ) :
    Module.Finite K (ordinaryQuotientDegree f d) := by
  rw [ordinaryQuotientDegree_eq_shifted]
  infer_instance

def ordinaryDegreeQuotientMap (f : Fin n → P) (d : ℕ) :
    (ShiftedExponent n 0 d → K) →ₗ[K] ordinaryQuotientDegree f d :=
  (((ordinaryFamilyIdeal f).mkQ.restrictScalars K).comp (shiftedDecode 0 d)).codRestrict _ (by
    intro v
    rw [ordinaryQuotientDegree_eq_shifted]
    exact ⟨shiftedDecode 0 d v,shiftedDecode_mem 0 d v,rfl⟩)

@[simp] theorem ordinaryDegreeQuotientMap_apply (f : Fin n → P) (d : ℕ)
    (v : ShiftedExponent n 0 d → K) :
    (ordinaryDegreeQuotientMap f d v : P ⧸ ordinaryFamilyIdeal f) =
      (ordinaryFamilyIdeal f).mkQ (shiftedDecode 0 d v) := rfl

theorem ordinaryDegreeQuotientMap_surjective (f : Fin n → P) (d : ℕ) :
    Function.Surjective (ordinaryDegreeQuotientMap f d) := by
  intro z
  have hz := (ordinaryQuotientDegree_eq_shifted f d).le z.property
  obtain ⟨p,hp,hpz⟩ := hz
  refine ⟨fun a => p.coeff a.val, ?_⟩
  apply Subtype.ext
  rw [ordinaryDegreeQuotientMap_apply,shiftedDecode_coeffs 0 d p hp]
  exact hpz

set_option maxHeartbeats 800000 in
theorem ordinaryDegreeQuotientMap_kernel (f : Fin n → P) (m d : ℕ)
    (hf : ∀ i, (f i).IsHomogeneous (m+i.val)) :
    LinearMap.range (ordinaryFirstMatrix f m d).mulVecLin =
      LinearMap.ker (ordinaryDegreeQuotientMap f d) := by
  apply le_antisymm
  · rintro v ⟨u,rfl⟩
    apply Subtype.ext
    change (ordinaryFamilyIdeal f).mkQ
      (shiftedDecode 0 d (ordinaryFirstMatrix f m d *ᵥ u)) = 0
    rw [shiftedDecode_ordinaryFirst f m d hf]
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact (range_ordinaryCoefficient f).le (LinearMap.mem_range_self _ _)
  · intro v hv
    change ordinaryDegreeQuotientMap f d v = 0 at hv
    have hmem : shiftedDecode 0 d v ∈ ordinaryFamilyIdeal f :=
      (Submodule.Quotient.mk_eq_zero _).mp (congrArg Subtype.val hv)
    obtain ⟨a,ha⟩ := (range_ordinaryCoefficient f).ge hmem
    change KoszulSyzygies.coefficient f a = shiftedDecode 0 d v at ha
    let z : TailDegreeIndex n m d → K :=
      fun b => (shiftedProjection (m+b.1.val) d (a b.1)).coeff b.2.val
    have hz : tailDegreeDecode m d z = fun i => shiftedProjection (m+i.val) d (a i) := by
      funext i
      change shiftedDecode (m+i.val) d
        (fun b => (shiftedProjection (m+i.val) d (a i)).coeff b.val) =
          shiftedProjection (m+i.val) d (a i)
      exact shiftedDecode_coeffs _ _ _ (shiftedProjection_mem _ _ (a i))
    refine ⟨z, ?_⟩
    apply shiftedDecode_injective 0 d
    rw [Matrix.mulVecLin_apply,shiftedDecode_ordinaryFirst f m d hf,hz,
      ← shiftedProjection_coefficient f m d hf,ha]
    exact shiftedProjection_of_mem (shiftedDecode_mem _ _ _)

set_option maxHeartbeats 800000 in
def ordinaryQuotientAction (G : Subgroup (Equiv.Perm (Fin n))) (f : Fin n → P)
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i) :
    Representation K G (P ⧸ ordinaryFamilyIdeal f) := by
  refine QuotientLinearAction.action (polynomialPermutationAction K G)
    ((ordinaryFamilyIdeal f).restrictScalars K) ?_
  intro g p hp
  change MvPolynomial.rename (g : Equiv.Perm (Fin n)) p ∈ ordinaryFamilyIdeal f
  exact rename_mem_ordinaryFamilyIdeal (g : Equiv.Perm (Fin n)) f (hinv g) hp

@[simp] theorem ordinaryQuotientAction_mkQ (G : Subgroup (Equiv.Perm (Fin n))) (f : Fin n → P)
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i)
    (g : G) (p : P) :
    ordinaryQuotientAction G f hinv g ((ordinaryFamilyIdeal f).mkQ p) =
      (ordinaryFamilyIdeal f).mkQ (MvPolynomial.rename (g : Equiv.Perm (Fin n)) p) := rfl

set_option maxHeartbeats 800000 in
theorem ordinaryQuotientAction_preserves_degree
    (G : Subgroup (Equiv.Perm (Fin n))) (f : Fin n → P)
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i)
    (g : G) (d : ℕ) {z : P ⧸ ordinaryFamilyIdeal f} (hz : z ∈ ordinaryQuotientDegree f d) :
    ordinaryQuotientAction G f hinv g z ∈ ordinaryQuotientDegree f d := by
  rcases Submodule.mem_map.mp hz with ⟨p, hp, hpz⟩
  refine Submodule.mem_map.mpr ⟨MvPolynomial.rename (g : Equiv.Perm (Fin n)) p,
    rename_mem_homogeneousSubmodule (g : Equiv.Perm (Fin n)) d hp, ?_⟩
  change (ordinaryFamilyIdeal f).mkQ (MvPolynomial.rename (g : Equiv.Perm (Fin n)) p) =
    ordinaryQuotientAction G f hinv g z
  change (ordinaryFamilyIdeal f).mkQ p = z at hpz
  rw [← hpz, ordinaryQuotientAction_mkQ]

def ordinaryQuotientDegreeRepresentation (G : Subgroup (Equiv.Perm (Fin n))) (f : Fin n → P)
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i) (d : ℕ) :
    Representation K G (ordinaryQuotientDegree f d) :=
  Representation.subrepresentation (ordinaryQuotientAction G f hinv) (ordinaryQuotientDegree f d)
    (fun g _ hz => ordinaryQuotientAction_preserves_degree G f hinv g d hz)

def ordinaryDegreeQuotientIntertwiner (G : Subgroup (Equiv.Perm (Fin n))) (f : Fin n → P)
    (hinv : ∀ g : G, ∀ i, MvPolynomial.rename (g : Equiv.Perm (Fin n)) (f i) = f i) (d : ℕ) :
    IntertwiningMap (shiftedDegreeAction (R := K) G 0 d)
      (ordinaryQuotientDegreeRepresentation G f hinv d) where
  toLinearMap := ordinaryDegreeQuotientMap f d
  isIntertwining' g := by
    apply LinearMap.ext
    intro v
    apply Subtype.ext
    change (ordinaryFamilyIdeal f).mkQ
      (shiftedDecode 0 d (shiftedRename (g : Equiv.Perm (Fin n)) 0 d v)) =
      ordinaryQuotientAction G f hinv g ((ordinaryFamilyIdeal f).mkQ (shiftedDecode 0 d v))
    rw [shiftedDecode_shiftedRename,ordinaryQuotientAction_mkQ]

end Field

end PaperVerification.PowerOperators
