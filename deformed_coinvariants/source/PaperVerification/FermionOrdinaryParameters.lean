module

public import PaperVerification.FermionRadical
public import PaperVerification.HomogeneousRegularSequence
public import Mathlib.Tactic.Ring

/-!
# Ordinary power moments: support, regularity and finite quotient

This leaf module connects the support theorem to homogeneous regularity. It concerns precisely the ordinary quotient used in
Section 4: the generators are `Σ βᵢ xᵢ^(rᵢ(s+k))`, for `0 ≤ k < n`.
All positive covering degrees and all field characteristics are retained.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion

open scoped BigOperators
open MvPolynomial

variable {K : Type*} [Field K] {n : ℕ}

/-- Evaluation at the origin as an algebra homomorphism. -/
def polynomialOrigin : MvPolynomial (Fin n) K →ₐ[K] K :=
  MvPolynomial.aeval (fun _ ↦ (0 : K))

@[simp]
theorem polynomialOrigin_apply (p : MvPolynomial (Fin n) K) :
    polynomialOrigin p = constantCoeff p := by
  simp only [polynomialOrigin, MvPolynomial.aeval_zero', Algebra.algebraMap_self_apply]

/-- The origin ideal is literally generated by the polynomial variables. -/
theorem span_variables_eq_origin :
    Ideal.span (Set.range (MvPolynomial.X : Fin n → MvPolynomial (Fin n) K)) =
      RingHom.ker (polynomialOrigin (K := K) (n := n)).toRingHom := by
  let m : Ideal (MvPolynomial (Fin n) K) := Ideal.span (Set.range MvPolynomial.X)
  have hremove (p : MvPolynomial (Fin n) K) : p - C (constantCoeff p) ∈ m := by
    induction p using MvPolynomial.induction_on with
    | C a => simp only [constantCoeff_C, sub_self, Submodule.zero_mem]
    | add p q hp hq =>
        have h := m.add_mem hp hq
        simpa only [map_add, add_sub_add_comm] using h
    | mul_X p i _ =>
        simpa only [map_mul, constantCoeff_X, mul_zero, map_zero, sub_zero] using
          m.mul_mem_left p (Ideal.subset_span ⟨i, rfl⟩)
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change polynomialOrigin (X i : MvPolynomial (Fin n) K) = 0
    rw [polynomialOrigin_apply, constantCoeff_X]
  · intro p hp
    have hp0 : constantCoeff p = 0 := by
      change polynomialOrigin p = 0 at hp
      rwa [polynomialOrigin_apply] at hp
    simpa only [hp0, map_zero, sub_zero] using hremove p

theorem originIdeal_eq_polynomialOrigin_ker :
    HomogeneousLocalization.originIdeal (K := K) (ι := Fin n) =
      RingHom.ker (polynomialOrigin (K := K) (n := n)).toRingHom := by
  ext p
  change constantCoeff p = 0 ↔ polynomialOrigin p = 0
  rw [polynomialOrigin_apply]

/-- Integer weights proportional to the rational weights `1/rᵢ`. -/
def coveringWeight (r : Fin n → ℕ) (i : Fin n) : ℕ :=
  ∏ j ∈ Finset.univ.erase i, r j

theorem coveringWeight_positive (r : Fin n → ℕ) (hr : ∀ i, 0 < r i) (i : Fin n) :
    0 < coveringWeight r i := by
  apply Finset.prod_pos
  intro j _
  exact hr j

theorem coveringWeight_mul (r : Fin n → ℕ) (i : Fin n) :
    r i * coveringWeight r i = ∏ j, r j :=
  Finset.mul_prod_erase Finset.univ r (Finset.mem_univ i)

/-- The ordinary homogeneous moment in the covered polynomial variables. -/
def powerMoment (r : Fin n → ℕ) (β : Fin n → K) (s k : ℕ) :
    MvPolynomial (Fin n) K :=
  ∑ i, C (β i) * X i ^ (r i * (s + k))

/-- The ideal uses precisely the first `n` ordinary moments. -/
def powerMomentIdeal (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ) :
    Ideal (MvPolynomial (Fin n) K) :=
  Ideal.span (Set.range fun k : Fin n ↦ powerMoment r β s k)

theorem powerMoment_eq_moment (r : Fin n → ℕ) (β : Fin n → K) (s k : ℕ) :
    powerMoment r β s k = moment (fun i ↦ (X i : MvPolynomial (Fin n) K) ^ r i)
      (fun i ↦ (C (β i) : MvPolynomial (Fin n) K) *
        Polynomial.aeval ((X i : MvPolynomial (Fin n) K) ^ r i)
          ((Polynomial.X : Polynomial K) ^ s)) k := by
  simp only [powerMoment, moment, smul_eq_mul, map_pow, Polynomial.aeval_X]
  apply Finset.sum_congr rfl
  intro i _
  rw [Nat.mul_add, pow_add, pow_mul, pow_mul]
  ring

theorem powerMomentIdeal_eq_ordinary (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ) :
    powerMomentIdeal r β s = ordinaryMomentIdeal
      (fun i ↦ (X i : MvPolynomial (Fin n) K) ^ r i) β (Polynomial.X ^ s) := by
  simp only [powerMomentIdeal, ordinaryMomentIdeal, powerMoment_eq_moment,
    MvPolynomial.algebraMap_eq]

theorem powerMoment_homogeneous (r : Fin n → ℕ) (β : Fin n → K) (s k : ℕ) :
    (powerMoment r β s k).IsWeightedHomogeneous (coveringWeight r)
      ((∏ j, r j) * (s + k)) := by
  apply IsWeightedHomogeneous.sum
  intro i _
  have h := ((isWeightedHomogeneous_X K (coveringWeight r) i).pow
    (r i * (s + k))).C_mul (β i)
  have hdegree : (r i * (s + k)) • coveringWeight r i = (∏ j, r j) * (s + k) := by
    simp only [nsmul_eq_mul, Nat.cast_id]
    calc
      (r i * (s + k)) * coveringWeight r i = (r i * coveringWeight r i) * (s + k) := by ring
      _ = _ := by rw [coveringWeight_mul]
  simpa only [hdegree] using h

theorem powerMoment_constantCoeff (r : Fin n → ℕ) (β : Fin n → K) (s k : ℕ)
    (hr : ∀ i, 0 < r i) (hs : 0 < s) : constantCoeff (powerMoment r β s k) = 0 := by
  simp only [powerMoment, map_sum, map_mul, constantCoeff_C, map_pow, constantCoeff_X]
  apply Finset.sum_eq_zero
  intro i _
  rw [zero_pow (Nat.mul_pos (hr i) (Nat.add_pos_left hs k)).ne', mul_zero]

/-- Every covering variable is in the radical of the actual ordinary ideal. -/
theorem variable_mem_powerMoment_radical
    (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i))
    (i : Fin n) : X i ∈ (powerMomentIdeal r β s).radical := by
  rw [powerMomentIdeal_eq_ordinary]
  have h := common_polynomial_mem_radical
    (ordinaryMomentIdeal (fun j ↦ (X j : MvPolynomial (Fin n) K) ^ r j) β (Polynomial.X ^ s))
    (fun j ↦ (X j : MvPolynomial (Fin n) K) ^ r j) β (Polynomial.X ^ s) hβ
    (fun k ↦ ordinaryMoment_mem _ _ _ k) i
  simp only [map_pow, Polynomial.aeval_X, ← pow_mul] at h
  exact Ideal.mem_radical_of_pow_mem h

/-- The power-moment scheme is supported exactly at the origin. -/
theorem powerMoment_radical_eq_origin
    (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ)
    (hr : ∀ i, 0 < r i) (hs : 0 < s)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    (powerMomentIdeal r β s).radical =
      HomogeneousLocalization.originIdeal (K := K) (ι := Fin n) := by
  apply le_antisymm
  · apply (Ideal.IsPrime.isRadical inferInstance).radical_le_iff.mpr
    apply Ideal.span_le.mpr
    rintro _ ⟨k, rfl⟩
    exact powerMoment_constantCoeff r β s k hr hs
  · rw [originIdeal_eq_polynomialOrigin_ker, ← span_variables_eq_origin]
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact variable_mem_powerMoment_radical r β s hβ i

/-- The complete ordinary moment sequence is regular in the polynomial ring,
with no restriction on positive covering degrees. -/
theorem powerMoments_isWeaklyRegular
    (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ)
    (hr : ∀ i, 0 < r i) (hs : 0 < s)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    RingTheory.Sequence.IsWeaklyRegular (MvPolynomial (Fin n) K)
      (List.ofFn fun k : Fin n ↦ powerMoment r β s k) := by
  apply HomogeneousLocalization.homogeneous_family_regular (coveringWeight r)
    (fun i ↦ (coveringWeight_positive r hr i).ne')
  · intro k
    exact ⟨_, powerMoment_homogeneous r β s k⟩
  · intro k
    exact powerMoment_constantCoeff r β s k hr hs
  · exact (powerMoment_radical_eq_origin r β s hr hs hβ).ge

/-- The actual ordinary quotient is finite over the field. -/
theorem powerMoment_quotient_finite
    (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    Module.Finite K (MvPolynomial (Fin n) K ⧸ powerMomentIdeal r β s) := by
  apply finite_quotient_of_univariate_radical _ (fun _ ↦ Polynomial.X)
    (fun _ ↦ Polynomial.monic_X)
  intro i
  simpa only [Polynomial.aeval_X] using variable_mem_powerMoment_radical r β s hβ i

/-- The actual moment nodes in the ordinary homogeneous quotient have a common
nilpotence exponent. This supplies the finite inverses in the polynomial Gauss
argument; it is derived from the moment relations and the subset-sum hypothesis. -/
theorem powerMoment_nodes_uniformly_nilpotent
    (r : Fin n → ℕ) (β : Fin n → K) (s : ℕ) (hr : ∀ i, 0 < r i)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    ∃ N : ℕ, ∀ i : Fin n,
      (Ideal.Quotient.mk (powerMomentIdeal r β s) (X i ^ r i)) ^ N = 0 := by
  classical
  have hpow : ∀ i : Fin n, ∃ m : ℕ, (X i : MvPolynomial (Fin n) K) ^ m ∈
      powerMomentIdeal r β s := fun i ↦
    Ideal.mem_radical_iff.mp (variable_mem_powerMoment_radical r β s hβ i)
  choose e he using hpow
  let N : ℕ := Finset.univ.sup e
  refine ⟨N, fun i ↦ ?_⟩
  have hi : (Ideal.Quotient.mk (powerMomentIdeal r β s) (X i)) ^ e i = 0 := by
    rw [← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (he i)
  have hN : (Ideal.Quotient.mk (powerMomentIdeal r β s) (X i)) ^ N = 0 :=
    pow_eq_zero_of_le (Finset.le_sup (Finset.mem_univ i)) hi
  rw [map_pow, ← pow_mul, Nat.mul_comm, pow_mul, hN, zero_pow (hr i).ne']

end PaperVerification.Fermion
