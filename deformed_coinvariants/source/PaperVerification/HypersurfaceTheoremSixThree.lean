module

public import PaperVerification.HypersurfaceFreeness
public import PaperVerification.JacobianEquivariantFormula
public import PaperVerification.JacobianEquivariantExactSequence

/-!
# The complete isolated-hypersurface statement

These declarations collect the scalar and equivariant clauses of Theorem6.3.
The number of variables is at least two. Isolation at the origin supplies
gradient regularity internally. The relation space is the literal sum of the
ordered Hamiltonian images; the defect has its actual target-degree shift.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open MvPolynomial Module
open scoped BigOperators DirectSum

namespace PaperVerification.JacobianDivergence

variable {n : ℕ}
local notation "P" => MvPolynomial (Fin n) ℂ

/-- The canonical defect identification, stated with the exact ordered
Hamiltonian denominator printed in the paper. -/
def paperHamiltonianDefectEquiv (hn : 2 ≤ n) (F : P) (w : Fin n → ℕ) (h d : ℕ)
    (hw : ∀ i, 0 < w i) (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h)
    (hiso : IsolatedCriticalPointAtOrigin F) :
    DefectQuotient F (-(h : ℂ)/((∑ i, w i : ℕ)+d : ℂ)) ≃ₗ[ℂ]
      EulerResonance.quotientComponent w d (orderedHamiltonianSpace F) := by
  have hreg := gradient_regular_of_isolated F w h hw hF hiso
  have hrel := divergenceSpace_eq_paper_relations F hreg
  letI : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  have hres := (EulerJacobian.eigenvalue_zero_iff w hw h d
    (-(h : ℂ)/((∑ i, w i : ℕ)+d : ℂ))).mpr rfl
  rw [← hrel]
  exact exceptionalDefectQuotientEquiv F w h d _ hh hF hres

/-- All scalar clauses, with the full nonresonant range and every resonant
degree. The graded freeness assertion is supplemented by the arbitrary-basis
lifting theorem below. -/
theorem paper_theorem_6_3_scalar (hn : 2 ≤ n) (F : P)
    (w : Fin n → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hw : ∀ i, 0 < w i) (hh : 0 < h)
    (hF : F.IsWeightedHomogeneous w h) (hiso : IsolatedCriticalPointAtOrigin F) :
    (∀ t : ℂ,
      (∀ d ∈ EulerJacobian.occurringDegrees (K := ℂ) w,
        t ≠ -(h : ℂ)/((∑ i, w i : ℕ)+d : ℂ)) →
      EulerJacobian.hit (gradient F) F t = jacobianSubmodule F) ∧
    divergenceSpace F = orderedHamiltonianSpace F ∧
    (letI := potentialSubalgebraModule F w h hne hh hF
     Module.Free (Algebra.adjoin ℂ {F}) (BrieskornModule F)) ∧
    (∀ d ∈ EulerJacobian.occurringDegrees (K := ℂ) w,
      let t := -(h : ℂ)/((∑ i, w i : ℕ)+d : ℂ)
      defectImage F t ≤ EulerResonance.quotientComponent w (h+d)
          (EulerJacobian.hit (gradient F) F t) ∧
      Nonempty (DefectQuotient F t ≃ₗ[ℂ]
        EulerResonance.quotientComponent w d (orderedHamiltonianSpace F)) ∧
      integerHilbertSeries w (EulerJacobian.hit (gradient F) F t) =
        integerHilbertSeries w (jacobianSubmodule F) +
          PowerSeries.monomial (h+d)
            (PowerSeries.coeff d (integerHilbertSeries w (jacobianSubmodule F) *
              HilbertTowerCount.geometricInverse h))) := by
  letI : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
  refine ⟨?_, divergenceSpace_eq_paper_relations F
    (gradient_regular_of_isolated F w h hw hF hiso),
    hypersurface_free hn F w h hne hw hh hF hiso, ?_⟩
  · intro t ht
    exact EulerJacobian.paper_theorem_6_2 n F t w h hne hw hh hF ht
  · intro d hd
    have hres := (EulerJacobian.eigenvalue_zero_iff w hw h d
      (-(h : ℂ)/((∑ i, w i : ℕ)+d : ℂ))).mpr rfl
    exact ⟨exceptional_defect_concentrated F w h d _ hh hF hres,
      ⟨paperHamiltonianDefectEquiv hn F w h d hw hh hF hiso⟩,
      paper_formula_6_1 hn F w h d hne hw hh hF hiso hd⟩

/-- Every chosen homogeneous lift of every homogeneous Milnor basis is a
basis over the actual subalgebra generated by `F`. -/
theorem paper_theorem_6_3_basis_lifts {I : Type*} (hn : 2 ≤ n) (F : P)
    (w : Fin n → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hw : ∀ i, 0 < w i) (hh : 0 < h)
    (hF : F.IsWeightedHomogeneous w h) (hiso : IsolatedCriticalPointAtOrigin F)
    (b : I → P) (hbhom : ∀ i, ∃ d : ℕ, (b i).IsWeightedHomogeneous w d)
    (B : Basis I ℂ (MilnorQuotient F))
    (hB : ∀ i, (jacobianSubmodule F).mkQ (b i) = B i) :
    letI := potentialSubalgebraModule F w h hne hh hF
    ∃ basis : Basis I (Algebra.adjoin ℂ {F}) (BrieskornModule F),
      ∀ i, basis i = classOf F (b i) :=
  (hypersurface_homogeneous_basis_lifts hn F w h hne hw hh hF hiso b hbhom B hB).2

/-- The full group-module clause and the natural exact sequence with an
actual homogeneous equivariant section. Negative tower degrees are the zero
pieces of the proved integer grading. -/
theorem paper_theorem_6_3_equivariant {G : Type*} [Group G] [Fintype G]
    (hn : 2 ≤ n) (F : P) (w : Fin n → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hw : ∀ i, 0 < w i) (hh : 0 < h)
    (hF : F.IsWeightedHomogeneous w h) (hiso : IsolatedCriticalPointAtOrigin F)
    (ρ : G →* (Matrix (Fin n) (Fin n) ℂ)ˣ)
    (hFix : ∀ g, linearSubst (ρ g : Matrix (Fin n) (Fin n) ℂ) F = F)
    (hW : ∀ g, JacobianLinearAction.RespectsWeights w (ρ g : Matrix (Fin n) (Fin n) ℂ)) :
    (∀ d ∈ EulerJacobian.occurringDegrees (K := ℂ) w,
      let t := -(h : ℂ)/((∑ i, w i : ℕ)+d : ℂ)
      ∃ e : DefectQuotient F t ≃ₗ[ℂ]
          (⨁ j : ℕ, (milnorNegativeGrading F w h hF).piece (-(d : ℤ)+(j : ℤ)*h)),
        ∀ g x, e (JacobianLinearAction.defectQuotientRepresentation ρ F t hFix g x) =
          milnorTowerRepresentation ρ F w h d hF hFix hW g (e x)) ∧
    (∀ t : ℂ,
      Function.Injective (JacobianLinearAction.defectInjection F t) ∧
      Function.Exact (JacobianLinearAction.defectInjection F t)
        (JacobianLinearAction.hitToMilnor F w h t hh hF) ∧
      Function.Surjective (JacobianLinearAction.hitToMilnor F w h t hh hF)) ∧
    (∀ t : ℂ, ∃ s : MilnorQuotient F →ₗ[ℂ]
        (P ⧸ EulerJacobian.hit (gradient F) F t),
      (∀ x, JacobianLinearAction.hitToMilnor F w h t hh hF (s x) = x) ∧
      (∀ g x, s (JacobianLinearAction.milnorRepresentation ρ F hFix g x) =
        JacobianLinearAction.hitQuotientRepresentation ρ F t hFix g (s x)) ∧
      ∀ d x, x ∈ EulerResonance.quotientComponent w d (jacobianSubmodule F) →
        s x ∈ EulerResonance.quotientComponent w d (EulerJacobian.hit (gradient F) F t)) := by
  exact ⟨fun d hd => paper_formula_6_2 hn F w h d hne hw hh hF hiso hd ρ hFix hW,
    fun t => JacobianLinearAction.natural_short_exact F w h t hh hF,
    fun t => JacobianLinearAction.exists_equivariant_homogeneous_hit_section
      ρ F w h t hh hF hFix hW⟩

end PaperVerification.JacobianDivergence
