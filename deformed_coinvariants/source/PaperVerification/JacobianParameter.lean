module

public import PaperVerification.JacobianFreeness
public import Mathlib.FieldTheory.IsAlgClosed.Basic
public import Mathlib.RingTheory.Algebraic.Integral
public import Mathlib.RingTheory.Adjoin.Polynomial.Transcendental

/-!
# The parameter ring is the actual subalgebra generated by the potential

This file checks that the polynomial parameter used in the basis-lifting proof
is faithfully represented by the given nonzero positive-degree polynomial.
It also identifies its action on every quotient class with multiplication by
the evaluated polynomial. Thus the parameter is not an unrelated formal action.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open MvPolynomial Polynomial Module

namespace PaperVerification.JacobianDivergence

variable {K ι : Type*} [Field K] [Fintype ι]
local notation "P" => MvPolynomial ι K

theorem positive_homogeneous_constantCoeff_zero (F : P) (w : ι → ℕ) (h : ℕ)
    (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h) : constantCoeff F = 0 := by
  change F.coeff 0 = 0
  by_contra hc
  have he : Finsupp.weight w (0 : ι →₀ ℕ) = h := hF hc
  have hz : Finsupp.weight w (0 : ι →₀ ℕ) = 0 := by simp [Finsupp.weight_eq_sum]
  rw [hz] at he
  exact (Nat.ne_of_gt hh) he.symm

theorem potential_transcendental [IsAlgClosed K]
    (F : P) (w : ι → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h) : Transcendental K F := by
  intro halg
  have hi : IsIntegral K F := halg.isIntegral
  have hm : (minpoly K F).leadingCoeff = 1 := minpoly.monic hi
  have hd : (minpoly K F).degree = 1 :=
    IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible hi)
  have he := minpoly.aeval K F
  rw [Polynomial.eq_X_add_C_of_degree_eq_one hd, hm, Polynomial.C_1, one_mul,
    Polynomial.aeval_add, Polynomial.aeval_X, Polynomial.aeval_C] at he
  have hc := congrArg (constantCoeff : P →+* K) he
  have hF0 := positive_homogeneous_constantCoeff_zero F w h hh hF
  have hc0 : (minpoly K F).coeff 0 = 0 := by
    simpa only [map_add, hF0, MvPolynomial.algebraMap_eq, constantCoeff_C,
      zero_add, map_zero] using hc
  rw [hc0, map_zero, add_zero] at he
  exact hne he

def potentialParameterEquiv [IsAlgClosed K]
    (F : P) (w : ι → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h) :
    K[X] ≃ₐ[K] Algebra.adjoin K {F} :=
  Polynomial.algEquivOfTranscendental K F (potential_transcendental F w h hne hh hF)

theorem X_pow_smul_classOf (F u : P) (k : ℕ) :
    (Polynomial.X ^ k : K[X]) • classOf F u = classOf F (F ^ k * u) := by
  induction k with
  | zero => simp only [pow_zero, one_smul, one_mul]
  | succ k ih =>
    rw [pow_succ', mul_smul, ih, X_smul_classOf, pow_succ', mul_assoc]

theorem polynomial_smul_classOf (F u : P) (p : K[X]) :
    p • classOf F u = classOf F (Polynomial.aeval F p * u) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    simp only [add_smul, map_add, add_mul, hp, hq]
  | monomial k c =>
    rw [← Polynomial.C_mul_X_pow_eq_monomial, mul_smul, X_pow_smul_classOf,
      Module.AEval.C_smul]
    rw [← map_smul]
    congr 1
    simp only [map_mul, Polynomial.aeval_C, map_pow,
      Polynomial.aeval_X, Algebra.smul_def, mul_assoc]

def potentialSubalgebraModule [IsAlgClosed K]
    (F : P) (w : ι → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h) :
    Module (Algebra.adjoin K {F}) (BrieskornModule F) :=
  Module.compHom (BrieskornModule F)
    (potentialParameterEquiv F w h hne hh hF).symm.toRingHom

/-- The transported action is literal multiplication by the represented element
of the polynomial subalgebra, on every representative of the quotient. -/
theorem subalgebra_smul_classOf [IsAlgClosed K]
    (F u : P) (w : ι → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h)
    (r : Algebra.adjoin K {F}) :
    letI := potentialSubalgebraModule F w h hne hh hF
    r • classOf F u = classOf F ((r : P) * u) := by
  let e := potentialParameterEquiv F w h hne hh hF
  change e.symm r • classOf F u = classOf F ((r : P) * u)
  rw [polynomial_smul_classOf]
  congr 2
  have he := congrArg (fun z : Algebra.adjoin K {F} => (z : P)) (e.apply_symm_apply r)
  simpa only [e, potentialParameterEquiv, Polynomial.algEquivOfTranscendental_apply,
    ← Subalgebra.aeval_coe] using he

/-- A basis over the polynomial parameter is a basis over the actual subalgebra,
with exactly the same vectors. -/
theorem basis_over_potentialSubalgebra [IsAlgClosed K] {I : Type*}
    (F : P) (w : ι → ℕ) (h : ℕ) (hne : F ≠ 0)
    (hh : 0 < h) (hF : F.IsWeightedHomogeneous w h)
    (B : Basis I K[X] (BrieskornModule F)) :
    letI := potentialSubalgebraModule F w h hne hh hF
    ∃ B' : Basis I (Algebra.adjoin K {F}) (BrieskornModule F), ∀ i, B' i = B i := by
  letI := potentialSubalgebraModule F w h hne hh hF
  let e := potentialParameterEquiv F w h hne hh hF
  have he : ∀ (p : K[X]) (x : BrieskornModule F), e p • x = p • x := by
    intro p x
    change e.symm (e p) • x = p • x
    rw [e.symm_apply_apply]
  exact ⟨B.mapCoeffs e.toRingEquiv he, fun i => B.mapCoeffs_apply e.toRingEquiv he i⟩

end PaperVerification.JacobianDivergence
