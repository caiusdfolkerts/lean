module

public import PaperVerification.HomogeneousFiniteParameters
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.Finiteness.Basic

/-!
# Finiteness over the actual homogeneous parameter subalgebra

Coordinate powers in the parameter ideal give an explicit finite cutoff for
the weighted quotient pieces. Above that cutoff a homogeneous polynomial is a
sum of the parameters times strictly lower-degree polynomials. Degree induction
therefore shows that finitely many low homogeneous pieces generate the whole
polynomial ring over the actual subalgebra generated by the parameters.

No finite-module premise is assumed in the final regular-sequence theorem.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

open MvPolynomial RingTheory.Sequence
open scoped BigOperators

namespace PaperVerification.HomogeneousLocalization

variable {K : Type*} [Field K] {n m : ℕ}
local notation "P" => MvPolynomial (Fin n) K
attribute [local instance] MvPolynomial.weightedGradedAlgebra

/-- Actual coordinate-power relations kill every sufficiently high weighted
homogeneous piece. The cutoff is deliberately not assumed to be optimal. -/
theorem homogeneous_mem_ideal_of_coordinate_powers
    (w : Fin n → ℕ) (I : Ideal P) (e : Fin n → ℕ)
    (he : ∀ i, X i ^ e i ∈ I) (d : ℕ)
    (hd : (∑ i, e i * w i) < d) (p : P)
    (hp : p.IsWeightedHomogeneous w d) : p ∈ I := by
  classical
  induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => exact I.zero_mem
  | add p q hp hq ihp ihq => exact I.add_mem ihp ihq
  | monomial a c ha =>
    have hex : ∃ i, e i ≤ a i := by
      by_contra h
      push_neg at h
      have hle : Finsupp.weight w a ≤ ∑ i, e i * w i := by
        rw [Finsupp.weight_eq_sum]
        simp only [smul_eq_mul]
        apply Finset.sum_le_sum
        intro i _
        exact Nat.mul_le_mul_right (w i) (h i).le
      rw [ha] at hle
      exact hd.not_ge hle
    obtain ⟨i, hi⟩ := hex
    have hs : Finsupp.single i (e i) ≤ a := Finsupp.single_le_iff.mpr hi
    have hsplit : a = (a - Finsupp.single i (e i)) + Finsupp.single i (e i) :=
      (tsub_add_cancel_of_le hs).symm
    rw [hsplit, monomial_add_single]
    exact I.mul_mem_left _ (he i)

/-- Weighted projection of a product with a homogeneous right factor. In the
too-small-degree case the component is zero, so natural subtraction creates no
spurious degree-zero term. -/
theorem component_mul_right_homogeneous
    (w : Fin n → ℕ) (p f : P) (d e : ℕ)
    (hf : f.IsWeightedHomogeneous w e) :
    weightedHomogeneousComponent w d (p * f) =
      if e ≤ d then weightedHomogeneousComponent w (d - e) p * f else 0 := by
  simpa only [coe_decompose_eq_component] using
    (DirectSum.coe_decompose_mul_of_right_mem
      (weightedHomogeneousSubmodule K w) d (a := p) hf)

/-- A homogeneous parameter ideal containing a power of each coordinate makes
the polynomial ring finite over its actual parameter subalgebra. This is a
graded generation argument; no algebraic independence is assumed. -/
theorem finite_over_adjoin_of_homogeneous_radical
    (w : Fin n → ℕ) (hw : ∀ i, 0 < w i)
    (f : Fin m → P) (degree : Fin m → ℕ)
    (hd : ∀ j, 0 < degree j)
    (hf : ∀ j, (f j).IsWeightedHomogeneous w (degree j))
    (hrad : ∀ i : Fin n, X i ∈ (Ideal.span (Set.range f)).radical) :
    Module.Finite (Algebra.adjoin K (Set.range f)) P := by
  classical
  let I : Ideal P := Ideal.span (Set.range f)
  choose e he using fun i => Ideal.mem_radical_iff.mp (hrad i)
  let N : ℕ := ∑ i, e i * w i
  let S : Subalgebra K P := Algebra.adjoin K (Set.range f)
  let U : Submodule K P := ⨆ i : Fin (N + 1), weightedHomogeneousSubmodule K w i.val
  let M : Submodule S P := Submodule.span S (U : Set P)
  have hU : U.FG := by
    apply Submodule.fg_iSup
    intro i
    exact weightedHomogeneousSubmodule_fg K w (fun j => (hw j).ne') i.val
  have hpiece : ∀ d : ℕ, ∀ p : P, p.IsWeightedHomogeneous w d → p ∈ M := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro p hp
      by_cases hsmall : d ≤ N
      · apply Submodule.subset_span
        exact (le_iSup (fun i : Fin (N + 1) => weightedHomogeneousSubmodule K w i.val)
          ⟨d, by omega⟩) hp
      · have hmem : p ∈ I :=
          homogeneous_mem_ideal_of_coordinate_powers w I e he d (by omega) p hp
        obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
        have hproj := congrArg (weightedHomogeneousComponent w d) hc
        rw [map_sum, hp.weightedHomogeneousComponent_same] at hproj
        rw [← hproj]
        apply M.sum_mem
        intro j _
        rw [component_mul_right_homogeneous w (c j) (f j) d (degree j) (hf j)]
        split_ifs with hj
        · have hlow : d - degree j < d := by
            have hpos := hd j
            omega
          have hcoeff : weightedHomogeneousComponent w (d - degree j) (c j) ∈ M :=
            ih (d - degree j) hlow _
              (weightedHomogeneousComponent_isWeightedHomogeneous _ _)
          rw [mul_comm]
          exact M.smul_mem (⟨f j, Algebra.subset_adjoin ⟨j, rfl⟩⟩ : S) hcoeff
        · exact M.zero_mem
  have htop : M = ⊤ := by
    apply top_unique
    intro p _
    rw [← DirectSum.sum_support_decompose (weightedHomogeneousSubmodule K w) p]
    apply M.sum_mem
    intro d _
    exact hpiece d _ ((DirectSum.decompose (weightedHomogeneousSubmodule K w) p d).property)
  apply Module.Finite.of_fg_top
  rw [← htop]
  exact hU.span

/-- Full positive-weight homogeneous regular sequences make the polynomial
ring finite over `K[f₁,…,fₙ]`, defined as the literal generated subalgebra.
All algebraic finiteness and coordinate-power relations are conclusions. -/
theorem homogeneous_regular_finite_over_adjoin
    (w : Fin n → ℕ) (hw : ∀ i, 0 < w i)
    (f : Fin n → P) (degree : Fin n → ℕ)
    (hd : ∀ i, 0 < degree i)
    (hf : ∀ i, (f i).IsWeightedHomogeneous w (degree i))
    (hreg : IsWeaklyRegular P (List.ofFn f)) :
    Module.Finite (Algebra.adjoin K (Set.range f)) P :=
  finite_over_adjoin_of_homogeneous_radical w hw f degree hd hf
    (variable_mem_radical_of_homogeneous_regular w hw f degree hd hf hreg)

/-- The two finiteness conclusions used in Proposition 6.5, with the exact
polynomial quotient and exact parameter subalgebra. -/
theorem homogeneous_regular_finiteness
    (w : Fin n → ℕ) (hw : ∀ i, 0 < w i)
    (f : Fin n → P) (degree : Fin n → ℕ)
    (hd : ∀ i, 0 < degree i)
    (hf : ∀ i, (f i).IsWeightedHomogeneous w (degree i))
    (hreg : IsWeaklyRegular P (List.ofFn f)) :
    Module.Finite K (P ⧸ Ideal.span (Set.range f)) ∧
      Module.Finite (Algebra.adjoin K (Set.range f)) P :=
  ⟨homogeneous_regular_quotient_finite w hw f degree hd hf hreg,
    homogeneous_regular_finite_over_adjoin w hw f degree hd hf hreg⟩

end PaperVerification.HomogeneousLocalization
