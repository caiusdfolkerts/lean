module

public import PaperVerification.DerivationFiniteConstants
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.LinearAlgebra.Pi

/-!
# The Jacobian kernel of a finite polynomial map in characteristic zero

This uses the actual polynomial partial derivatives. Finiteness over the
subalgebra generated by the coordinates forces every polynomial vector field
tangent to all coordinate level sets to vanish. The criterion is applied to
the full regular sequence in Proposition 6.5, with no independent Jacobian
determinant or algebraic-independence hypothesis.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open scoped BigOperators
open MvPolynomial

namespace PaperVerification.VectorJacobian

variable {K ι κ : Type*} [Field K] [CharZero K] [Fintype ι]
local notation "P" => MvPolynomial ι K

/-- The derivation represented by the actual polynomial vector field `g`. -/
def fieldDerivation (g : ι → P) : Derivation K P P :=
  ∑ i, g i • pderiv i

theorem fieldDerivation_apply (g : ι → P) (f : P) :
    fieldDerivation g f = ∑ i, g i * pderiv i f := by
  change (Derivation.coeFnAddMonoidHom (∑ i, g i • pderiv i)) f = _
  rw [map_sum]
  simp only [Finset.sum_apply, Derivation.coeFnAddMonoidHom_apply,
    Derivation.smul_apply, smul_eq_mul]

@[simp] theorem fieldDerivation_X (g : ι → P) (i : ι) :
    fieldDerivation g (X i) = g i := by
  classical
  simp [fieldDerivation_apply, pderiv_X, Pi.single_apply]

/-- Contraction with every row of the ordinary polynomial Jacobian. -/
def jacobianMap (F : κ → P) : (ι → P) →ₗ[K] (κ → P) where
  toFun g a := ∑ i, pderiv i (F a) * g i
  map_add' g h := by
    funext a
    simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' c g := by
    funext a
    simp only [Pi.smul_apply, RingHom.id_apply, mul_smul_comm, Finset.smul_sum]

@[simp] theorem jacobianMap_apply (F : κ → P) (g : ι → P) (a : κ) :
    jacobianMap F g a = ∑ i, pderiv i (F a) * g i := rfl

theorem jacobianMap_eq_fieldDerivation (F : κ → P) (g : ι → P) (a : κ) :
    jacobianMap F g a = fieldDerivation g (F a) := by
  simp only [jacobianMap, fieldDerivation_apply]
  apply Finset.sum_congr rfl
  intro i _
  exact mul_comm _ _

/-- A finite polynomial map in characteristic zero has zero polynomial
Jacobian kernel. All tangent fields and all polynomial degrees are included. -/
theorem jacobianMap_ker_eq_bot (F : κ → P)
    [Module.Finite (Algebra.adjoin K (Set.range F)) P] :
    LinearMap.ker (jacobianMap F) = ⊥ := by
  apply eq_bot_iff.mpr
  intro g hg
  have hF : ∀ a, fieldDerivation g (F a) = 0 := by
    intro a
    rw [← jacobianMap_eq_fieldDerivation]
    exact congrFun (LinearMap.mem_ker.mp hg) a
  have hD : fieldDerivation g = 0 :=
    DerivationFiniteConstants.eq_zero_of_finite_adjoin F (fieldDerivation g) hF
  change g = 0
  funext i
  change g i = 0
  have hx := congrArg (fun D : Derivation K P P => D (X i)) hD
  simpa only [fieldDerivation_X, Derivation.zero_apply] using hx

theorem jacobianMap_injective (F : κ → P)
    [Module.Finite (Algebra.adjoin K (Set.range F)) P] :
    Function.Injective (jacobianMap F) :=
  LinearMap.ker_eq_bot.mp (jacobianMap_ker_eq_bot F)

/-- The paper's normalized rows; scaling by nonzero degrees preserves the
actual kernel. -/
def normalizedJacobianMap (F : κ → P) (h : κ → ℕ) :
    (ι → P) →ₗ[K] (κ → P) where
  toFun g a := (h a : K)⁻¹ • jacobianMap F g a
  map_add' g g' := by
    funext a
    simp only [map_add, Pi.add_apply, smul_add]
  map_smul' c g := by
    funext a
    simp only [map_smul, Pi.smul_apply, RingHom.id_apply, smul_comm c]

@[simp] theorem normalizedJacobianMap_apply (F : κ → P) (h : κ → ℕ)
    (g : ι → P) (a : κ) :
    normalizedJacobianMap F h g a = (h a : K)⁻¹ • jacobianMap F g a := rfl

theorem normalizedJacobianMap_injective (F : κ → P) (h : κ → ℕ)
    (hh : ∀ a, 0 < h a)
    [Module.Finite (Algebra.adjoin K (Set.range F)) P] :
    Function.Injective (normalizedJacobianMap F h) := by
  intro g g' he
  apply jacobianMap_injective F
  funext a
  have ha := congrFun he a
  change (h a : K)⁻¹ • jacobianMap F g a =
    (h a : K)⁻¹ • jacobianMap F g' a at ha
  exact (smul_right_injective P
    (inv_ne_zero (Nat.cast_ne_zero.mpr (Nat.ne_of_gt (hh a))))) ha

end PaperVerification.VectorJacobian
