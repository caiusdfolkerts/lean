module

public import PaperVerification.DivergenceAffineFamily
public import Mathlib.RingTheory.Ideal.Span

/-!
# The actual graded quotient behind the divergence matrices

The degree piece is the image of the genuine weighted polynomial component
in the quotient by the actual joint image of the differential operators.
The matrix presentation is proved surjective with exactly its claimed
kernel. Its zero fiber is identified with the ordinary ideal generated by
the one-form values. Thus the specialized dimension bound is a statement
about the actual quotient, not an abstract matrix cokernel.

This source has not yet been compiled. The rational-function base change
and equivariant identification remain separate obligations.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

namespace PaperVerification.DivergenceDegrees

open MvPolynomial Module Matrix DivergenceCocycle
open WeightedPolynomialPieces
open scoped BigOperators

variable {K ι : Type*} [Field K] [Fintype ι]
local notation "P" => MvPolynomial ι K
local notation "Der" => Derivation K P P

variable (L : LieRinehartSubalgebra P Der)
variable {r : ℕ} (b : Basis (Fin r) P L) (ω : L →ₗ[P] P)

def hit (t : K) : Submodule K P := (first L b ω t).range

def valueIdeal : Ideal P := Ideal.span (Set.range fun i : Fin r => ω (b i))

/-- The comparison fiber is precisely the ordinary complete-intersection
ideal; this identification requires no extra exactness assumption. -/
theorem hit_zero_eq_valueIdeal : hit L b ω 0=(valueIdeal L b ω).restrictScalars K := by
  ext p
  constructor
  · rintro ⟨v,rfl⟩
    rw [first_zero,KoszulSyzygies.coefficient_apply]
    apply Ideal.sum_mem
    intro i hi
    exact (valueIdeal L b ω).mul_mem_left (v i) (Ideal.subset_span ⟨i,rfl⟩)
  · intro hp
    obtain ⟨v,hv⟩ := Ideal.mem_span_range_iff_exists_fun.mp hp
    refine ⟨v,?_⟩
    rw [first_zero,KoszulSyzygies.coefficient_apply]
    exact hv

def zeroQuotientEquiv : (P ⧸ hit L b ω 0) ≃ₗ[K]
    P ⧸ (valueIdeal L b ω).restrictScalars K :=
  Submodule.quotEquivOfEq _ _ (hit_zero_eq_valueIdeal L b ω)

@[simp] theorem zeroQuotientEquiv_mk (p : P) :
    zeroQuotientEquiv L b ω ((hit L b ω 0).mkQ p)=
      ((valueIdeal L b ω).restrictScalars K).mkQ p :=
  Submodule.quotEquivOfEq_mk _ _ _ p

variable (w : ι → ℕ) [∀ i, NeZero (w i)] (δ : Fin r → ℕ)

def quotientDegree (t : K) (d : ℕ) : Submodule K (P ⧸ hit L b ω t) :=
  (piece (K := K) w 0 d).map (hit L b ω t).mkQ

def quotientDegreeMap (t : K) (d : ℕ) :
    (Index w 0 d → K) →ₗ[K] quotientDegree L b ω w t d :=
  (((hit L b ω t).mkQ).comp (decode w 0 d)).codRestrict _ (by
    intro v
    exact ⟨decode w 0 d v,decode_mem w 0 d v,rfl⟩)

@[simp] theorem quotientDegreeMap_apply (t : K) (d : ℕ) (v : Index w 0 d → K) :
    (quotientDegreeMap L b ω w t d v : P ⧸ hit L b ω t)=
      (hit L b ω t).mkQ (decode w 0 d v) := rfl

theorem quotientDegreeMap_surjective (t : K) (d : ℕ) :
    Function.Surjective (quotientDegreeMap L b ω w t d) := by
  intro z
  obtain ⟨p,hp,hpz⟩ := z.property
  refine ⟨fun a => p.coeff a.val,?_⟩
  apply Subtype.ext
  rw [quotientDegreeMap_apply,decode_coeffs w 0 d p hp]
  exact hpz

instance quotientDegree_finite (t : K) (d : ℕ) :
    Module.Finite K (quotientDegree L b ω w t d) :=
  Module.Finite.of_surjective (quotientDegreeMap L b ω w t d)
    (quotientDegreeMap_surjective L b ω w t d)

/-- Homogeneous projection proves that the finite matrix captures every
actual relation in the degree piece, including relations with initially
inhomogeneous coefficients. -/
theorem quotientDegreeMap_kernel
    (hfields : HomogeneousFields L b w δ)
    (hvalues : HomogeneousValues L b w δ ω) (t : K) (d : ℕ) :
    LinearMap.range (firstMatrix w L b δ ω t d).mulVecLin=
      LinearMap.ker (quotientDegreeMap L b ω w t d) := by
  apply le_antisymm
  · rintro v ⟨u,rfl⟩
    apply Subtype.ext
    change (hit L b ω t).mkQ
      (decode w 0 d (firstMatrix w L b δ ω t d *ᵥ u))=0
    rw [decode_firstMatrix w L b δ ω hfields hvalues]
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact ⟨firstDecode w δ d u,rfl⟩
  · intro v hv
    have hmem : decode w 0 d v ∈ hit L b ω t := by
      apply (Submodule.Quotient.mk_eq_zero _).mp
      exact congrArg Subtype.val (LinearMap.mem_ker.mp hv)
    obtain ⟨u,hu⟩ := hmem
    let z : Fin r → P := projectCoefficients w δ d u
    have hz : first L b ω t z=decode w 0 d v := by
      rw [←project_first L b w δ ω hfields hvalues,hu]
      exact project_of_mem w 0 d (decode_mem w 0 d v)
    let c : FirstIndex w δ d → K := fun a => (z a.1).coeff a.2.val
    have hc : firstDecode w δ d c=z := by
      funext i
      exact decode_coeffs w (δ i) d _ (project_mem w (δ i) d (u i))
    refine ⟨c,?_⟩
    funext a
    change (firstMatrix w L b δ ω t d *ᵥ c) a=v a
    rw [firstMatrix_mulVec,hc,hz]
    exact decode_coeff w 0 d v a

theorem quotientDegree_finrank_add_matrix_rank
    (hfields : HomogeneousFields L b w δ)
    (hvalues : HomogeneousValues L b w δ ω) (t : K) (d : ℕ) :
    Module.finrank K (quotientDegree L b ω w t d)+
      (firstMatrix w L b δ ω t d).rank=Fintype.card (Index w 0 d) := by
  have h := (quotientDegreeMap L b ω w t d).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr (quotientDegreeMap_surjective L b ω w t d),
    finrank_top,←quotientDegreeMap_kernel L b ω w δ hfields hvalues,
    Module.finrank_fintype_fun_eq_card] at h
  exact h

/-- The complete specialized lower bound on actual quotient pieces, for
every degree and every scalar parameter. The comparison piece at zero is
the complete-intersection quotient by `hit_zero_eq_valueIdeal`. -/
theorem quotientDegree_finrank_ge_zero [Infinite K]
    (hfields : HomogeneousFields L b w δ)
    (hvalues : HomogeneousValues L b w δ ω) (hω : IsClosed L ω)
    (hregular : RingTheory.Sequence.IsWeaklyRegular P
      (List.ofFn fun i : Fin r => ω (b i))) (t : K) (d : ℕ) :
    Module.finrank K (quotientDegree L b ω w 0 d) ≤
      Module.finrank K (quotientDegree L b ω w t d) := by
  have ht := quotientDegree_finrank_add_matrix_rank L b ω w δ hfields hvalues t d
  have hzero := quotientDegree_finrank_add_matrix_rank L b ω w δ hfields hvalues 0 d
  have hr := rank_firstMatrix_le_zero L b ω w δ hfields hvalues hω hregular t d
  omega

end PaperVerification.DivergenceDegrees
