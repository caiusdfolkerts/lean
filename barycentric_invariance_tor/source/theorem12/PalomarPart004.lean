section

/-! # The relative rank-colored strands are the actual barycentric strands

The coefficient map is the quotient-presentation equivalence on each exterior
coordinate.  It identifies the genuine relative kernel with the literal
restriction ideal, and its basis-coordinate formula proves that the two
independently defined internal and weight conditions agree.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def rankColoredRelativeCoefficientEquiv :
    (rankColoredSubcomplex hs d hrank Q).relativeParameterKernel K ≃ₗ[K]
      (barycentricRestrictionIdeal K Q).restrictScalars K :=
  ((rankColoredSubcomplex hs d hrank Q).relativeParameterEquiv K).trans
    (rankColoredRelativeEquiv K hs d hrank Q hQ)

/-- This is the actual ideal-valued coefficient equivalence, followed by the
identity identification of ideal-valued functions with ambient functions. -/
def rankColoredRelativeKoszulTermEquiv (i : ℕ) :
    ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i ≃ₗ[K]
      barycentricRelativeKoszulTerm (P := P) K d Q i :=
  (Finsupp.mapRange.linearEquiv
    (rankColoredRelativeCoefficientEquiv K hs d hrank Q hQ)).trans
      (idealCoefficientEquiv (K := K) (Set.powersetCard (Fin d) i)
        (barycentricRestrictionIdeal K Q))

@[simp] theorem rankColoredRelativeKoszulTermEquiv_apply (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i)
    (s : Set.powersetCard (Fin d) i) :
    (show Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K from
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val) s =
      rankColoredRingEquiv K hs d hrank
        ((show Set.powersetCard (Fin d) i →₀
          (rankColoredSubcomplex hs d hrank Q).relativeParameterKernel K from x) s).val := rfl

theorem rankColoredRelativeKoszulTermEquiv_val (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i) :
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val =
      Finsupp.mapRange.linearMap (rankColoredRingEquiv K hs d hrank).toLinearMap
        ((rankColoredSubcomplex hs d hrank Q).relativeCoefficientInclusion K i x) := by
  apply Finsupp.ext
  intro s
  rfl

def rankColoredRelativeKoszulIndex (i : ℕ)
    (t : (rankColoredSubcomplex hs d hrank Q).RelativeKoszulIndex i) :
    OriginalKoszulIndex P d i := ⟨t.1, t.2.val⟩

theorem rankColoredRelativeKoszulIndex_injective (i : ℕ) :
    Function.Injective (rankColoredRelativeKoszulIndex hs d hrank Q i) := by
  rintro ⟨s, a⟩ ⟨t, b⟩ h
  have hst : s = t := congrArg Sigma.fst h
  subst t
  have hab : a.val = b.val := by
    exact congrArg (fun z : OriginalKoszulIndex P d i => z.2) h
  have hab' : a = b := Subtype.ext hab
  subst b
  rfl

theorem rankColoredRelativeKoszulTermEquiv_basis (i : ℕ)
    (t : (rankColoredSubcomplex hs d hrank Q).RelativeKoszulIndex i) :
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i t)).val =
      barycentricKoszulBasis (P := P) K d i
        (rankColoredRelativeKoszulIndex hs d hrank Q i t) := by
  rw [(rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis_apply (K := K)]
  simp only [barycentricKoszulBasis, Finsupp.coe_basis]
  change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
    (Finsupp.single t.1 ((rankColoredSubcomplex hs d hrank Q).relativeRingBasis K t.2))).val =
      Finsupp.single t.1 (barycentricGlobalStandardBasis K t.2.val)
  apply Finsupp.ext
  intro s
  rw [rankColoredRelativeKoszulTermEquiv_apply]
  simp only [Finsupp.single_apply]
  split_ifs with h
  · rw [(rankColoredSubcomplex hs d hrank Q).relativeRingBasis_val (K := K)]
    exact rankColored_monomial_basis K hs d hrank t.2.val
  · exact map_zero (rankColoredRingEquiv K hs d hrank)

/-- Coordinates are literally extended by zero from the surviving relative
monomial indices.  This also covers the zero coefficient ring. -/
theorem rankColoredRelativeKoszulTermEquiv_repr (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i) :
    (barycentricKoszulBasis (P := P) K d i).repr
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val =
      Finsupp.mapDomain (rankColoredRelativeKoszulIndex hs d hrank Q i)
        (((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i).repr x) := by
  let L := (barycentricKoszulBasis (P := P) K d i).repr.toLinearMap.comp
    ((barycentricRelativeKoszulTerm (P := P) K d Q i).subtype.comp
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).toLinearMap)
  let R := (Finsupp.lmapDomain K K (rankColoredRelativeKoszulIndex hs d hrank Q i)).comp
    ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i).repr.toLinearMap
  have he : L = R := by
    apply ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i).ext
    intro t
    change (barycentricKoszulBasis (P := P) K d i).repr
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
        ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i t)).val = _
    rw [rankColoredRelativeKoszulTermEquiv_basis]
    simp only [R, LinearMap.comp_apply, LinearEquiv.coe_coe,
      Module.Basis.repr_self, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
  exact LinearMap.congr_fun he x

theorem rankColoredRelativeKoszulTermEquiv_coarse (j n i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i) :
    x ∈ (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
        (rankColorCoarsening d) (j, n) i ↔
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val ∈
          barycentricKoszulDegreePiece (P := P) K d i j ∧
        (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val ∈
          FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
            (fun a => (originalKoszulWeight d a).toNat) n := by
  change x ∈ Grading.Piece _ _ (j, n) ↔
    _ ∈ FourPapers.BasisGrading.Piece _ _ j ∧
      _ ∈ FourPapers.BasisGrading.Piece _ _ n
  rw [Grading.mem_piece, FourPapers.BasisGrading.mem_piece,
    FourPapers.BasisGrading.mem_piece]
  constructor
  · intro hx
    have hindex (a : OriginalKoszulIndex P d i)
        (ha : (barycentricKoszulBasis (P := P) K d i).repr
          (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val a ≠ 0) :
        originalKoszulDegree a = j ∧ (originalKoszulWeight d a).toNat = n := by
      rw [rankColoredRelativeKoszulTermEquiv_repr] at ha
      obtain ⟨t, rfl⟩ := Finsupp.mem_range_of_mapDomain_ne_zero ha
      rw [Finsupp.mapDomain_apply_of_injective
        (rankColoredRelativeKoszulIndex_injective hs d hrank Q i)] at ha
      have ht := hx t ha
      change rankColorCoarsening d
        ((rankColoredSubcomplex hs d hrank Q).relativeKoszulColorDegree t) = (j, n) at ht
      rw [rankColorCoarsening_relative] at ht
      exact ⟨congrArg Prod.fst ht, congrArg Prod.snd ht⟩
    exact ⟨fun a ha => (hindex a ha).1, fun a ha => (hindex a ha).2⟩
  · rintro ⟨hj, hn⟩ t ht
    have hnonzero : (barycentricKoszulBasis (P := P) K d i).repr
        (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val
          (rankColoredRelativeKoszulIndex hs d hrank Q i t) ≠ 0 := by
      rw [rankColoredRelativeKoszulTermEquiv_repr,
        Finsupp.mapDomain_apply_of_injective
          (rankColoredRelativeKoszulIndex_injective hs d hrank Q i)]
      exact ht
    change rankColorCoarsening d
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulColorDegree t) = (j, n)
    rw [rankColorCoarsening_relative]
    exact Prod.ext (hj _ hnonzero) (hn _ hnonzero)

def rankColoredCoarseTermEquiv (j n i : ℕ) :
    (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
        (rankColorCoarsening d) (j, n) i ≃ₗ[K]
      barycentricRelativeBigradedTerm (P := P) K d Q j n i where
  toFun x :=
    ⟨⟨(rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).val,
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).property,
      ((rankColoredRelativeKoszulTermEquiv_coarse K hs d hrank Q hQ j n i x.val).mp
        x.property).1⟩,
      ((rankColoredRelativeKoszulTermEquiv_coarse K hs d hrank Q hQ j n i x.val).mp
        x.property).2⟩
  invFun y :=
    ⟨(rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).symm
      ⟨y.val.val, y.val.property.1⟩,
      (rankColoredRelativeKoszulTermEquiv_coarse K hs d hrank Q hQ j n i _).mpr (by
        simpa only [LinearEquiv.apply_symm_apply] using
          (show y.val.val ∈ barycentricKoszulDegreePiece (P := P) K d i j ∧
            y.val.val ∈ FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
              (fun a => (originalKoszulWeight d a).toNat) n from
            ⟨y.val.property.2, y.property⟩))⟩
  left_inv x := Subtype.ext
    ((rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).symm_apply_apply x.val)
  right_inv y := by
    apply Subtype.ext
    apply Subtype.ext
    change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).symm
        ⟨y.val.val, y.val.property.1⟩)).val = y.val.val
    exact congrArg Subtype.val
      ((rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).apply_symm_apply
        ⟨y.val.val, y.val.property.1⟩)
  map_add' x y := by
    apply Subtype.ext
    apply Subtype.ext
    change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i (x.val + y.val)).val =
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).val +
        (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i y.val).val
    exact congrArg Subtype.val (map_add
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i) x.val y.val)
  map_smul' c x := by
    apply Subtype.ext
    apply Subtype.ext
    change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i (c • x.val)).val =
      c • (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).val
    exact congrArg Subtype.val (map_smul
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i) c x.val)

@[simp] theorem rankColoredCoarseTermEquiv_apply (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) i) (s : Set.powersetCard (Fin d) i) :
    (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i x).val.val s =
      rankColoredRingEquiv K hs d hrank (x.val s).val := rfl

theorem rankColoredRelativeKoszulTermEquiv_differential (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X (i + 1)) :
    complexIncoming (barycentricRelativeKoszulComplex (P := P) K d Q) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x) =
      rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
        ((rankColoredSubcomplex hs d hrank Q).relativeKoszulDifferential K i x) := by
  apply Subtype.ext
  simp only [complexIncoming, barycentricRelativeKoszulComplex, submoduleComplex_d,
    parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change parameterKoszulDifferential (K := K) (fun c : Fin d =>
      barycentricRankParameter (P := P) K (c.val + 1)) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x).val = _
  rw [rankColoredRelativeKoszulTermEquiv_val, rankColoredRelativeKoszulTermEquiv_val]
  have hinc := LinearMap.congr_fun
    ((rankColoredSubcomplex hs d hrank Q).relativeCoefficientInclusion_differential K i) x
  simp only [LinearMap.comp_apply] at hinc
  rw [hinc]
  have hd : (rankColoredOrderComplex hs d hrank).koszulDifferential K i =
      parameterKoszulDifferential (K := K)
        ((rankColoredOrderComplex hs d hrank).colorParameter K) i := by
    simpa only [ProperlyColoredComplex.koszulDifferential,
      ProperlyColoredComplex.parameterAction, MvPolynomial.aeval_X] using
      parameterRestriction_differential ((rankColoredOrderComplex hs d hrank).parameterAction K) i
  rw [hd]
  exact (LinearMap.congr_fun
    (parameterKoszul_map_commutes
      ((rankColoredOrderComplex hs d hrank).colorParameter K)
      (fun c : Fin d => barycentricRankParameter (P := P) K (c.val + 1))
      (rankColoredRingEquiv K hs d hrank).toLinearMap
      (fun c z => by
        change rankColoredRingEquiv K hs d hrank
          ((rankColoredOrderComplex hs d hrank).colorParameter K c * z) = _
        rw [map_mul, rankColored_parameter]
        rfl) i)
    ((rankColoredSubcomplex hs d hrank Q).relativeCoefficientInclusion K (i + 1) x)).symm

theorem rankColoredCoarseTermEquiv_incoming (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) (i + 1)) :
    barycentricRelativeBigradedIncoming (P := P) K d Q j n i
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i + 1) x) =
      rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i
        (complexIncoming ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
          (rankColorCoarsening d) (j, n)) i x) := by
  apply Subtype.ext
  apply Subtype.ext
  simp only [complexIncoming,
    (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex_d (K := K),
    ModuleCat.hom_ofHom]
  change complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x.val).val =
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulDifferential K i x.val)).val
  have h := congrArg Subtype.val
    (rankColoredRelativeKoszulTermEquiv_differential K hs d hrank Q hQ i x.val)
  simp only [complexIncoming, barycentricRelativeKoszulComplex, submoduleComplex_d,
    ModuleCat.hom_ofHom] at h
  change complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x.val).val =
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulDifferential K i x.val)).val at h
  exact h

theorem rankColoredCoarseTermEquiv_outgoing (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) i) :
    barycentricRelativeBigradedOutgoing (P := P) K d Q j n i
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i x) =
      rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i - 1)
        (complexOutgoing ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
          (rankColorCoarsening d) (j, n)) i x) := by
  cases i with
  | zero =>
      have hz := ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
        (rankColorCoarsening d) (j, n)).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero,
        LinearMap.zero_apply, map_zero]
      apply Subtype.ext
      apply Subtype.ext
      change (barycentricKoszulComplex (P := P) K d).d 0 0
        (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n 0 x).val.val = 0
      rw [(barycentricKoszulComplex (P := P) K d).shape 0 0 (by decide)]
      rfl
  | succ i =>
      simpa only [barycentricRelativeBigradedOutgoing, barycentricRelativeBigradedIncoming,
        complexOutgoing, complexIncoming, Nat.succ_sub_one, Nat.add_sub_cancel] using
        rankColoredCoarseTermEquiv_incoming K hs d hrank Q hQ j n i x

def rankColoredCoarseKernelHomologyEquiv (j n i : ℕ) :
    complexKernelHomology
    ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)) i ≃ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
    chainHomologyEquiv _ _ _ _ _ _
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i + 1))
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i)
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i - 1))
      (rankColoredCoarseTermEquiv_incoming K hs d hrank Q hQ j n i)
      (rankColoredCoarseTermEquiv_outgoing K hs d hrank Q hQ j n i)

/-- The ordinary categorical homology of the coarse color strand is the
literal kernel/image quotient used by the intrinsic filtration theorem. -/
def rankColoredCoarseHomologyEquiv (j n i : ℕ) :
    ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)).homology i ≃ₗ[K]
        barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
  (complexKernelHomologyIso
    ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)) i).toLinearEquiv |>.trans
    (rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i)

section Naturality
variable (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

theorem rankColoredCoarseTermEquiv_natural (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) i) :
    rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i
      ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseTermMap (D := rankColoredOrderComplex hs d hrank) K
        (rankColorCoarsening d) (j, n) i x) =
      barycentricRelativeBigradedOrderMap K d e Q hstable j n i
        (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i x) := by
  apply Subtype.ext
  apply Subtype.ext
  apply Finsupp.ext
  intro s
  exact rankColoredKoszulTerm_natural K hs d hrank Q e hstable i x.val s

theorem rankColoredCoarseKernelHomologyEquiv_natural (j n i : ℕ)
    (x : complexKernelHomology
      ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
        (rankColorCoarsening d) (j, n)) i) :
    rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i
      (complexKernelHomologyMap
        ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
          (rankColorCoarsening d) (j, n)) i x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i x) :=
  chainHomologyEquiv_intertwines _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    (rankColoredCoarseTermEquiv_natural K hs d hrank Q hQ e hstable j n i) x

theorem rankColoredCoarseHomologyEquiv_natural (j n i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)).homology i) :
    rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i
      (HomologicalComplex.homologyMap
        ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
          (rankColorCoarsening d) (j, n)) i x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i x) := by
  have hx := congrArg (fun f => f x)
    (complexKernelHomologyIso_natural
      ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
        (rankColorCoarsening d) (j, n)) i)
  simp only [ModuleCat.comp_apply, ModuleCat.ofHom_apply] at hx
  exact (congrArg (rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i) hx).trans
    (rankColoredCoarseKernelHomologyEquiv_natural K hs d hrank Q hQ e hstable j n i _)

end Naturality

/-- Ordinary reduced relative cohomology of the actual rank-selected order
complex pair, with the void-subcomplex convention for the empty lower ideal. -/
abbrev rankSelectedRelativeCohomology (S : Finset (Fin d)) (i : ℕ) :=
  letI : LinearOrder (NonzeroFace P) :=
    (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  reducedRelativeCohomology (K := K)
    (rankSelection (rankColoredOrderComplex hs d hrank) S)
    (rankSelection (rankColoredSubcomplex hs d hrank Q).toColoredComplex S)
    (rankSelection_downward (rankColoredOrderComplex hs d hrank) S)
    (rankSelection_downward (rankColoredSubcomplex hs d hrank Q).toColoredComplex S)
    ((S.card : ℤ) - i - 1)

def rankColoredCoarseCohomologyReindex (j n i : ℕ) :
    (∀ S : {S : Finset (Fin d) // rankColorCoarsening d (Koszul.faceExponent S) = (j, n)},
      rankSelectedRelativeCohomology K hs d hrank Q S.val i) ≃ₗ[K]
    (∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
      rankSelectedRelativeCohomology K hs d hrank Q S.val i) where
  toFun x S := x ⟨S.val, by
    rw [rankColorCoarsening_squarefree]
    exact Prod.ext S.property.1 S.property.2⟩
  invFun x S := x ⟨S.val, by
    have h := S.property
    rw [rankColorCoarsening_squarefree] at h
    exact ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The exact cohomology formula for every genuine relative barycentric
bigraded homology term.  All coefficient rings and all degrees are retained. -/
def barycentricRelativeBigradedCohomologyEquiv (j n i : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d Q j n i ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i :=
  (rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i).symm.trans
    (((rankColoredSubcomplex hs d hrank Q).relativeCoarseCohomologyEquiv (D := rankColoredOrderComplex hs d hrank) K
      (rankColorCoarsening d) (j, n) i).trans
        (rankColoredCoarseCohomologyReindex K hs d hrank Q j n i))

theorem barycentricRelativeBigradedCohomologyEquiv_natural
    (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q) (j n i : ℕ)
    (x : barycentricRelativeBigradedHomology (P := P) K d Q j n i)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n}) :
    barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i
      (barycentricRelativeBigradedHomologyAction K d e Q hstable j n i x) S =
      (rankColoredPairOrderAut hs d hrank Q e hstable).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i x S) := by
  let E := rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i
  have hinv : E.symm (barycentricRelativeBigradedHomologyAction K d e Q hstable j n i x) =
      HomologicalComplex.homologyMap
        ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
          (rankColorCoarsening d) (j, n)) i (E.symm x) := by
    apply E.injective
    rw [LinearEquiv.apply_symm_apply]
    simpa only [E, LinearEquiv.apply_symm_apply] using
      (rankColoredCoarseHomologyEquiv_natural K hs d hrank Q hQ e hstable j n i
        (E.symm x)).symm
  change (rankColoredSubcomplex hs d hrank Q).relativeCoarseCohomologyEquiv (D := rankColoredOrderComplex hs d hrank) K
    (rankColorCoarsening d) (j, n) i
      (E.symm (barycentricRelativeBigradedHomologyAction K d e Q hstable j n i x))
      ⟨S.val, _⟩ = _
  rw [hinv]
  exact (rankColoredPairOrderAut hs d hrank Q e hstable).relativeCoarseCohomologyEquiv_natural
    (D := rankColoredOrderComplex hs d hrank) K (rankColorCoarsening d) (j, n) i (E.symm x) ⟨S.val, _⟩

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.PaperTorFormula -/
section

/-! # Theorem 1.2: the actual Tor filtration and rank-selected cohomology

The weight-by-weight comparison is assembled over all weights, and the
weight index is then eliminated. The surviving condition is precisely that
the sum of the selected ranks equals the internal degree. The group maps
on the two sides are the ordinary Tor functor maps and ordinary simplicial
cohomology maps, respectively.
-/
noncomputable section
open scoped DirectSum
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def relativeTorRankSelectedGradeEquiv (j i n : ℕ) :
    Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i :=
  (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n).trans
    (barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i)

/-- Every filtration grade is included. The second index on the right is
exactly the sum of the selected ranks, with no restriction on weight. -/
def relativeTorRankSelectedEquiv (j i : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i :=
  gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank Q S i)
    (fun n => Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n)
    (relativeTorRankSelectedGradeEquiv K hs d hrank Q hQ j i)

/-- The relative formula, written as the direct sum occurring in the paper. -/
def theorem_1_2_relative (j i : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i) :=
  (relativeTorRankSelectedEquiv K hs d hrank Q hQ j i).trans
    (DirectSum.linearEquivFunOnFintype K _ _).symm

theorem relativeTorRankSelectedGradeEquiv_natural
    (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q) (j i n : ℕ)
    (x : Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n}) :
    relativeTorRankSelectedGradeEquiv K hs d hrank Q hQ j i n
      (gradeMap _ _ (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i)
        (originalRelativeTorDegreeAction_filtered K hs d Q e hstable hrank hQ j i) n x) S =
      (rankColoredPairOrderAut hs d hrank Q e hstable).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (relativeTorRankSelectedGradeEquiv K hs d hrank Q hQ j i n x S) := by
  change barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i
    (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n _) S = _
  rw [originalRelativeTorAssociatedBigraded_equivariant]
  exact barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank Q hQ
    e hstable j n i _ S

variable {G : Type v} [Group G] (a : PosetGroupAction G P)
variable (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)

theorem relativeTorRankSelectedEquiv_equivariant (j i : ℕ) (g : G)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j}) :
    relativeTorRankSelectedEquiv K hs d hrank Q hQ j i
      (originalRelativeTorAssociatedRepresentation K hs d hrank Q hQ a hstable j i g x) S =
      (rankColoredPairOrderAut hs d hrank Q (a.orderIso g) (hstable g)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (relativeTorRankSelectedEquiv K hs d hrank Q hQ j i x S) := by
  simp only [relativeTorRankSelectedEquiv, gradedSumConditionEquiv_apply]
  exact relativeTorRankSelectedGradeEquiv_natural K hs d hrank Q hQ
    (a.orderIso g) (hstable g) j i (rankSubsetWeight d S.val)
      (x (rankSubsetWeight d S.val)) ⟨S.val, S.property, rfl⟩

/-- The direct-sum formulation intertwines the actual induced maps. -/
theorem theorem_1_2_relative_equivariant (j i : ℕ) (g : G)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i) :
    theorem_1_2_relative K hs d hrank Q hQ j i
      (originalRelativeTorAssociatedRepresentation K hs d hrank Q hQ a hstable j i g x) =
      DirectSum.lmap (fun S : {S : Finset (Fin d) // rankSubsetDegree S = j} =>
        ((rankColoredPairOrderAut hs d hrank Q (a.orderIso g) (hstable g)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
          ((S.val.card : ℤ) - i - 1)).hom)
        (theorem_1_2_relative K hs d hrank Q hQ j i x) := by
  apply DFinsupp.ext
  intro S
  exact relativeTorRankSelectedEquiv_equivariant K hs d hrank Q hQ a hstable j i g x S

/-- The relative formula uses this finite filtration, stable under the
actual derived Tor action for every stable downward subset, including empty. -/
theorem theorem_1_2_relative_finite_stable (j i : ℕ) :
    (originalRelativeTorFiltration K hs d hrank Q hQ j i).level (2 * d * j + 1) = ⊤ ∧
      ∀ g, Preserves (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorDegreeRepresentation K hs d hrank Q a hstable hQ j i g) :=
  ⟨originalRelativeTorFiltration_finite K hs d hrank Q hQ j i,
    fun g => originalRelativeTorDegreeRepresentation_filtered K hs d hrank Q a hstable hQ j i g⟩

section Absolute
omit Q hQ a hstable in
def originalTorRankSelectedEquiv (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S.val i :=
  gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i)
    (fun n => Grade (originalTorFiltration K hs d hrank j i) n)
    (fun n => (originalTorAssociatedBigraded K hs d hrank j i n).trans
      (barycentricRelativeBigradedCohomologyEquiv K hs d hrank (∅ : Set P) (by simp) j n i))

omit Q hQ a hstable in
def originalTorRankSelectedDirectSumEquiv (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S.val i) :=
  (originalTorRankSelectedEquiv K hs d hrank j i).trans
    (DirectSum.linearEquivFunOnFintype K _ _).symm

omit Q hQ hstable in
theorem originalTorRankSelectedEquiv_equivariant (j i : ℕ) (g : G)
    (x : originalTorAssociatedGraded K hs d hrank j i)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j}) :
    originalTorRankSelectedEquiv K hs d hrank j i
      (originalTorAssociatedRepresentation K hs d hrank a j i g x) S =
      (rankColoredPairOrderAut hs d hrank (∅ : Set P) (a.orderIso g) (by simp)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (originalTorRankSelectedEquiv K hs d hrank j i x S) := by
  simp only [originalTorRankSelectedEquiv, gradedSumConditionEquiv_apply, LinearEquiv.trans_apply]
  have h₁ := congrArg (fun z => barycentricRelativeBigradedCohomologyEquiv K hs d hrank
      (∅ : Set P) (by simp) j (rankSubsetWeight d S.val) i z ⟨S.val, S.property, rfl⟩)
    (originalTorAssociatedBigraded_equivariant K hs d hrank (a.orderIso g)
      j i (rankSubsetWeight d S.val) (x (rankSubsetWeight d S.val)))
  have h₂ := barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank (∅ : Set P)
    (by simp) (a.orderIso g) (by simp) j (rankSubsetWeight d S.val) i
      (originalTorAssociatedBigraded K hs d hrank j i (rankSubsetWeight d S.val)
        (x (rankSubsetWeight d S.val))) ⟨S.val, S.property, rfl⟩
  exact h₁.trans h₂
end Absolute

section RepresentationDescent
variable {M N : Type*} [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

/-- Actual prescribed maps descend along a surjection; the group laws are
proved from the source representation and the intertwining equations. -/
def representationOfSurjectiveIntertwining (ρ : Representation K G M)
    (f : M →ₗ[K] N) (hf : Function.Surjective f) (σ : G → Module.End K N)
    (h : ∀ g x, f (ρ g x) = σ g (f x)) : Representation K G N where
  toFun := σ
  map_one' := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := hf x
    rw [← h, map_one]
    rfl
  map_mul' g k := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := hf x
    change σ (g * k) (f y) = σ g (σ k (f y))
    rw [← h, ← h, ← h, map_mul]
    rfl
end RepresentationDescent

/-- The representation uses the independently defined cochain action. -/
def rankSelectedRelativeRepresentation (S : Finset (Fin d)) (i : ℕ) :
    Representation K G (rankSelectedRelativeCohomology K hs d hrank Q S i) := by
  let E := barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ
    (rankSubsetDegree S) (rankSubsetWeight d S) i
  let π : (∀ T : {T : Finset (Fin d) //
      rankSubsetDegree T = rankSubsetDegree S ∧ rankSubsetWeight d T = rankSubsetWeight d S},
      rankSelectedRelativeCohomology K hs d hrank Q T.val i) →ₗ[K]
      rankSelectedRelativeCohomology K hs d hrank Q S i :=
    LinearMap.proj (⟨S, rfl, rfl⟩ : {T : Finset (Fin d) //
      rankSubsetDegree T = rankSubsetDegree S ∧ rankSubsetWeight d T = rankSubsetWeight d S})
  have hπ : Function.Surjective π := LinearMap.proj_surjective
    (⟨S, rfl, rfl⟩ : {T : Finset (Fin d) //
      rankSubsetDegree T = rankSubsetDegree S ∧ rankSubsetWeight d T = rankSubsetWeight d S})
  exact representationOfSurjectiveIntertwining K
    (barycentricRelativeBigradedRepresentationAllRings K hs d hrank Q hQ a hstable
      (rankSubsetDegree S) (rankSubsetWeight d S) i)
    (π.comp E.toLinearMap) (hπ.comp E.surjective)
    (fun g => ((rankColoredPairOrderAut hs d hrank Q (a.orderIso g) (hstable g)).reducedCohomologyMap
      (D := rankColoredOrderComplex hs d hrank) K S ((S.card : ℤ) - i - 1)).hom)
    (fun g x => barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank Q hQ
      (a.orderIso g) (hstable g) (rankSubsetDegree S) (rankSubsetWeight d S) i x ⟨S, rfl, rfl⟩)

end FourPapers.Universal

namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology FourPapers.RepresentationGrothendieck
universe u v
variable {P K : Type u} {G : Type v} [PartialOrder P] [OrderBot P] [Fintype P] [Field K] [Group G]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (a : PosetGroupAction G P) (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)

def rankSelectedRelativeFiniteRepresentation (S : Finset (Fin d)) (i : ℕ) :
    FiniteRepresentation K G := by
  let j := rankSubsetDegree S
  let n := rankSubsetWeight d S
  let V := barycentricRelativeBigradedFiniteRepresentation K hs d hrank Q a hstable hQ j n i
  letI : Module.Finite K (barycentricRelativeBigradedHomology (P := P) K d Q j n i) := V.finite
  let E := barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i
  letI := Module.Finite.equiv E
  let π : (∀ T : {T : Finset (Fin d) // rankSubsetDegree T = j ∧ rankSubsetWeight d T = n},
      rankSelectedRelativeCohomology K hs d hrank Q T.val i) →ₗ[K]
      rankSelectedRelativeCohomology K hs d hrank Q S i :=
    LinearMap.proj (⟨S, rfl, rfl⟩ :
      {T : Finset (Fin d) // rankSubsetDegree T = j ∧ rankSubsetWeight d T = n})
  have hπ : Function.Surjective π := LinearMap.proj_surjective
    (⟨S, rfl, rfl⟩ :
      {T : Finset (Fin d) // rankSubsetDegree T = j ∧ rankSubsetWeight d T = n})
  letI : Module.Finite K (rankSelectedRelativeCohomology K hs d hrank Q S i) :=
    Module.Finite.of_surjective π hπ
  exact FiniteRepresentation.of (rankSelectedRelativeCohomology K hs d hrank Q S i)
    (rankSelectedRelativeRepresentation K hs d hrank Q hQ a hstable S i)

theorem barycentricRelativeBigraded_class_cohomology (j n i : ℕ) :
    classOf K G (barycentricRelativeBigradedFiniteRepresentation K hs d hrank Q a hstable hQ j n i) =
      ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
        classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S.val i) := by
  calc
    _ = classOf K G (FiniteRepresentation.pi (fun S :
        {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n} =>
          rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S.val i)) := by
      apply class_equiv (barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i)
      intro g x
      funext S
      exact barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank Q hQ
        (a.orderIso g) (hstable g) j n i x S
    _ = _ := class_pi _ _

/-- The representation-ring conclusion, including modular characteristic,
has precisely the rank-selected reduced relative cohomology summands. -/
theorem theorem_1_2_relative_grothendieck (j i : ℕ) :
    classOf K G (originalRelativeTorFiniteRepresentation K hs d hrank Q a hstable hQ j i) =
      ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S.val i) := by
  rw [originalRelativeTor_class_bigraded]
  simp_rw [barycentricRelativeBigraded_class_cohomology K hs d hrank Q hQ a hstable]
  have h := sum_finite_weight_fibers (fun S : Finset (Fin d) => rankSubsetDegree S = j)
    (rankSubsetWeight d)
    (fun S => classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S i))
    (2 * d * j + 1) (rankSubsetWeight_lt_cutoff d j)
  -- The abstract fiber lemma chooses a classical decision procedure for its
  -- predicate.  Its finite sets are extensionally the same actual fibers.
  refine Eq.trans ?_ (Eq.trans h ?_)
  · apply Finset.sum_congr rfl
    intro n hn
    apply Finset.sum_congr
    · ext S
      simp only [Finset.mem_univ]
    · intro S hS
      rfl
  · apply Finset.sum_congr
    · ext S
      simp only [Finset.mem_univ]
    · intro S hS
      rfl

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.AbsoluteCochains -/
section

/-! # Ordinary absolute cochains and the void relative complex

Absolute cochains are defined directly as the duals of the augmented face
chain modules.  The comparison with a void relative subcomplex is the dual
of the canonical quotient-by-zero equivalence.  It preserves the ordinary
inverse-permutation pullback, including the reduced augmentation degree.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg
universe u v
variable {K : Type u} {V : Type v} [CommRing K] [Fintype V] [LinearOrder V]

theorem augmentedChains_eq_bot_of_void (Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) : Simplicial.Chains (k := K) Λ₀ i = ⊥ := by
  have hempty : {F : Finset V | Λ₀ F ∧ F.card = i} = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro F hF
    exact hvoid F hF.1
  rw [Simplicial.Chains, hempty, Set.image_empty, Submodule.span_empty]

theorem relativeFaceSubmodule_eq_bot_of_void (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) : relativeFaceSubmodule (K := K) Λ Λ₀ i = ⊥ := by
  rw [relativeFaceSubmodule, augmentedChains_eq_bot_of_void Λ₀ hvoid,
    Submodule.comap_bot, Submodule.ker_subtype]

def relativeVoidChainsEquiv (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) :
    RelativeAugmentedChains (K := K) Λ Λ₀ i ≃ₗ[K] Simplicial.Chains (k := K) Λ i :=
  (relativeFaceSubmodule (K := K) Λ Λ₀ i).quotEquivOfEqBot
    (relativeFaceSubmodule_eq_bot_of_void Λ Λ₀ hvoid i)

@[simp] theorem relativeVoidChainsEquiv_mk (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) (x : Simplicial.Chains (k := K) Λ i) :
    relativeVoidChainsEquiv Λ Λ₀ hvoid i (Submodule.Quotient.mk x) = x := rfl

@[simp] theorem relativeVoidChainsEquiv_symm (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) (x : Simplicial.Chains (k := K) Λ i) :
    (relativeVoidChainsEquiv Λ Λ₀ hvoid i).symm x = Submodule.Quotient.mk x := rfl

def augmentedCoboundary (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    Module.Dual K (Simplicial.Chains (k := K) Λ i) →ₗ[K]
      Module.Dual K (Simplicial.Chains (k := K) Λ (i + 1)) :=
  (augmentedFaceBoundary Λ hΛ i).dualMap

theorem augmentedCoboundary_square (Λ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    (augmentedCoboundary (K := K) Λ hΛ (i + 1)).comp
      (augmentedCoboundary (K := K) Λ hΛ i) = 0 := by
  apply LinearMap.ext
  intro f
  apply LinearMap.ext
  intro x
  change f (augmentedFaceBoundary Λ hΛ i (augmentedFaceBoundary Λ hΛ (i + 1) x)) = 0
  have hz : augmentedFaceBoundary (K := K) Λ hΛ i
      (augmentedFaceBoundary Λ hΛ (i + 1) x) = 0 :=
    Subtype.ext (Simplicial.boundary_boundary x.val)
  rw [hz, map_zero]

def augmentedCochainComplex (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) :
    HomologicalComplex (ModuleCat.{max u v} K) PalomarBarycentricTor.naturalUp :=
  CochainComplex.of
    (fun i => ModuleCat.of K (Module.Dual K (Simplicial.Chains (k := K) Λ i)))
    (fun i => ModuleCat.ofHom (augmentedCoboundary Λ hΛ i))
    (fun i => ModuleCat.hom_ext (augmentedCoboundary_square Λ hΛ i))

@[simp] theorem augmentedCochainComplex_d (Λ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    (augmentedCochainComplex (K := K) Λ hΛ).d i (i + 1) =
      ModuleCat.ofHom (augmentedCoboundary Λ hΛ i) := by
  simp [augmentedCochainComplex]

/-- Reduced cohomology directly from the ordinary augmented chain modules. -/
def reducedCohomology (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) (q : ℤ) :
    ModuleCat.{max u v} K :=
  if -1 ≤ q then (augmentedCochainComplex (K := K) Λ hΛ).homology (q + 1).toNat
  else ModuleCat.of K (ULift.{v} (Fin 0 → K))

def relativeVoidCochainsEquiv (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) :
    Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i) ≃ₗ[K]
      Module.Dual K (Simplicial.Chains (k := K) Λ i) :=
  (relativeVoidChainsEquiv Λ Λ₀ hvoid i).symm.dualMap

@[simp] theorem relativeVoidCochainsEquiv_apply (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ)
    (f : Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i))
    (x : Simplicial.Chains (k := K) Λ i) :
    relativeVoidCochainsEquiv Λ Λ₀ hvoid i f x = f (Submodule.Quotient.mk x) := rfl

theorem relativeVoidCochainsEquiv_differential (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ)
    (f : Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i)) :
    augmentedCoboundary Λ hΛ i (relativeVoidCochainsEquiv Λ Λ₀ hvoid i f) =
      relativeVoidCochainsEquiv Λ Λ₀ hvoid (i + 1)
        (relativeAugmentedCoboundary Λ Λ₀ hΛ hΛ₀ i f) := by
  ext x
  rfl

def relativeVoidCochainComplexIso (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀)
    (hvoid : ∀ F, ¬ Λ₀ F) :
    relativeAugmentedCochainComplex (K := K) Λ Λ₀ hΛ hΛ₀ ≅ augmentedCochainComplex Λ hΛ :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (relativeVoidCochainsEquiv Λ Λ₀ hvoid i).toModuleIso) (by
      intro i j hij
      obtain rfl : j = i + 1 := hij.symm
      simp only [relativeAugmentedCochainComplex, CochainComplex.of_d,
        augmentedCochainComplex_d]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      exact relativeVoidCochainsEquiv_differential Λ Λ₀ hΛ hΛ₀ hvoid i)

def relativeVoidReducedCohomologyIso (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀)
    (hvoid : ∀ F, ¬ Λ₀ F) (q : ℤ) :
    reducedRelativeCohomology (K := K) Λ Λ₀ hΛ hΛ₀ q ≅ reducedCohomology Λ hΛ q := by
  by_cases hq : -1 ≤ q
  · simpa only [reducedRelativeCohomology, reducedCohomology, if_pos hq] using
      HomologicalComplex.homologyMapIso
        (relativeVoidCochainComplexIso (K := K) Λ Λ₀ hΛ hΛ₀ hvoid) (q + 1).toNat
  · simp only [reducedRelativeCohomology, reducedCohomology, if_neg hq]
    exact Iso.refl _

end FourPapers.Universal

namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] {Q : D.Subcomplex}
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance absoluteCochainsVertexOrder : LinearOrder V := D.colorLinearOrder
local instance : DecidableEq V := Classical.decEq V

theorem rankSelection_void (hvoid : ∀ F, ¬ Q.face F) (S : Finset C) (F : Finset V) :
    ¬ rankSelection Q.toColoredComplex S F := fun h => hvoid F h.1

namespace ColorPairAutomorphism
variable (e : Q.ColorPairAutomorphism) (K)

def absoluteInverseFace (S : Finset C) (i : ℕ)
    (F : AugmentedFaceIndex (rankSelection D S) i) :
    AugmentedFaceIndex (rankSelection D S) i :=
  ⟨F.val.image e.vertex.symm, by
    simpa only [ColorPairAutomorphism.symm] using
      (e.symm.rankSelection_iff S F.val).mpr F.property.1,
    (Finset.card_image_of_injective F.val e.vertex.symm.injective).trans F.property.2⟩

/-- The ordinary inverse-permutation map on oriented faces.  Proper coloring
orders a face by its distinct colors, so its orientation is preserved. -/
def absoluteChainPullback (S : Finset C) (i : ℕ) :
    Module.End K (Simplicial.Chains (k := K) (rankSelection D S) i) :=
  (augmentedChainBasis (K := K) (rankSelection D S) i).constr K
    (fun F => augmentedChainBasis (rankSelection D S) i (e.absoluteInverseFace S i F))

/-- Absolute cochains act by ordinary pullback along the inverse face map. -/
def absoluteCochainTermMap (S : Finset C) (i : ℕ) :
    Module.End K (Module.Dual K (Simplicial.Chains (k := K) (rankSelection D S) i)) :=
  (e.absoluteChainPullback K S i).dualMap

@[simp] theorem absoluteCochainTermMap_basis (S : Finset C) (i : ℕ)
    (f : Module.Dual K (Simplicial.Chains (k := K) (rankSelection D S) i))
    (F : AugmentedFaceIndex (rankSelection D S) i) :
    e.absoluteCochainTermMap K S i f (augmentedChainBasis (rankSelection D S) i F) =
      f (augmentedChainBasis (rankSelection D S) i (e.absoluteInverseFace S i F)) := by
  change f ((augmentedChainBasis (K := K) (rankSelection D S) i).constr K _
    (augmentedChainBasis (rankSelection D S) i F)) = _
  rw [Module.Basis.constr_basis]

variable (hvoid : ∀ F, ¬ Q.face F)

theorem relativeVoidCochainsEquiv_natural (S : Finset C) (i : ℕ)
    (f : (Q.rankCochainComplex K S).X i) :
    relativeVoidCochainsEquiv (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_void hvoid S) i (e.cochainEquiv K S i f) =
    e.absoluteCochainTermMap K S i
      (relativeVoidCochainsEquiv (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_void hvoid S) i f) := by
  apply (augmentedChainBasis (K := K) (rankSelection D S) i).ext
  intro F
  rw [relativeVoidCochainsEquiv_apply (K := K), e.absoluteCochainTermMap_basis K S i,
    relativeVoidCochainsEquiv_apply (K := K)]
  exact e.cochainEquiv_coordinate K S i f
    ⟨F.val, F.property.1, F.property.2, rankSelection_void hvoid S F.val⟩

include hvoid in
theorem absoluteCochainTermMap_differential (S : Finset C) (i : ℕ)
    (f : Module.Dual K (Simplicial.Chains (k := K) (rankSelection D S) i)) :
    augmentedCoboundary (rankSelection D S) (rankSelection_downward D S) i
      (e.absoluteCochainTermMap K S i f) =
    e.absoluteCochainTermMap K S (i + 1)
      (augmentedCoboundary (rankSelection D S) (rankSelection_downward D S) i f) := by
  obtain ⟨f, rfl⟩ := (relativeVoidCochainsEquiv (K := K)
    (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_void hvoid S) i).surjective f
  rw [← e.relativeVoidCochainsEquiv_natural K hvoid S i,
    relativeVoidCochainsEquiv_differential (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
      (rankSelection_void hvoid S) i]
  have hd := e.cochainEquiv_differential K S i f
  change ((Q.rankCochainComplex K S).d i (i + 1)).hom
      (e.cochainEquiv K S i f) =
    e.cochainEquiv K S (i + 1) (((Q.rankCochainComplex K S).d i (i + 1)).hom f) at hd
  rw [Q.rankCochainComplex_d K S i] at hd
  change relativeAugmentedCoboundary (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) i
      (e.cochainEquiv K S i f) =
    e.cochainEquiv K S (i + 1)
      (relativeAugmentedCoboundary (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) i f) at hd
  rw [hd, e.relativeVoidCochainsEquiv_natural K hvoid S (i + 1),
    ← relativeVoidCochainsEquiv_differential (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
      (rankSelection_void hvoid S) i]

def absoluteCochainMap (S : Finset C) :
    augmentedCochainComplex (K := K) (rankSelection D S) (rankSelection_downward D S) ⟶
      augmentedCochainComplex (K := K) (rankSelection D S) (rankSelection_downward D S) where
  f i := ModuleCat.ofHom (e.absoluteCochainTermMap K S i)
  comm' i j hij := by
    obtain rfl : j = i + 1 := hij.symm
    simp only [augmentedCochainComplex_d (K := K)]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    exact e.absoluteCochainTermMap_differential K hvoid S i

theorem relativeVoidCochainComplexIso_natural (S : Finset C) :
    e.cochainMap K S ≫
      (relativeVoidCochainComplexIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S)).hom =
      (relativeVoidCochainComplexIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S)).hom ≫ e.absoluteCochainMap K hvoid S := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  exact e.relativeVoidCochainsEquiv_natural K hvoid S i

def absoluteReducedCohomologyMap (S : Finset C) (q : ℤ) :
    reducedCohomology (K := K) (rankSelection D S) (rankSelection_downward D S) q ⟶
      reducedCohomology (K := K) (rankSelection D S) (rankSelection_downward D S) q :=
  if hq : -1 ≤ q then by
    simp only [reducedCohomology, if_pos hq]
    exact HomologicalComplex.homologyMap (e.absoluteCochainMap K hvoid S) (q + 1).toNat
  else by
    simp only [reducedCohomology, if_neg hq]
    exact 𝟙 _

theorem relativeVoidReducedCohomologyIso_natural (S : Finset C) (q : ℤ) :
    e.reducedCohomologyMap K S q ≫
      (relativeVoidReducedCohomologyIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S) q).hom =
      (relativeVoidReducedCohomologyIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S) q).hom ≫ e.absoluteReducedCohomologyMap K hvoid S q := by
  by_cases hq : -1 ≤ q
  · have h := congrArg (fun f => HomologicalComplex.homologyMap f (q + 1).toNat)
      (e.relativeVoidCochainComplexIso_natural K hvoid S)
    rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp] at h
    let ER := relativeVoidCochainComplexIso (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
      (rankSelection_void hvoid S)
    have hR : reducedRelativeCohomology (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) q =
        (Q.rankCochainComplex K S).homology (q + 1).toNat := by
      simpa only [reducedRelativeCohomology, if_pos hq]
    have hA : reducedCohomology (K := K)
        (rankSelection D S) (rankSelection_downward D S) q =
        (augmentedCochainComplex (K := K) (rankSelection D S)
          (rankSelection_downward D S)).homology (q + 1).toNat := by
      simp only [reducedCohomology, if_pos hq]
    have hleft : HEq (e.reducedCohomologyMap K S q)
        (HomologicalComplex.homologyMap (e.cochainMap K S) (q + 1).toNat) := by
      simp only [reducedCohomologyMap, dif_pos hq, eq_mpr_eq_cast]
      exact cast_heq _ _
    have hright : HEq (e.absoluteReducedCohomologyMap K hvoid S q)
        (HomologicalComplex.homologyMap (e.absoluteCochainMap K hvoid S) (q + 1).toNat) := by
      simp only [absoluteReducedCohomologyMap, dif_pos hq, eq_mpr_eq_cast]
      exact cast_heq _ _
    have he : HEq (relativeVoidReducedCohomologyIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S) q)
        (HomologicalComplex.homologyMapIso ER (q + 1).toNat) := by
      simp only [relativeVoidReducedCohomologyIso, dif_pos hq, eq_mpr_eq_cast]
      exact cast_heq _ _
    have hom_heq {X Y X' Y' : ModuleCat.{u} K} (hX : X = X') (hY : Y = Y')
        {E : X ≅ Y} {E' : X' ≅ Y'} (hE : HEq E E') : HEq E.hom E'.hom := by
      cases hX
      cases hY
      cases hE
      rfl
    have hehom := hom_heq hR hA he
    apply eq_of_heq
    exact (CategoryTheory.heq_comp hR hR hA hleft hehom).trans
      ((heq_of_eq h).trans (CategoryTheory.heq_comp hR hA hA hehom hright).symm)
  · apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    haveI : Subsingleton (reducedCohomology (K := K)
        (rankSelection D S) (rankSelection_downward D S) q) := by
      simp only [reducedCohomology, if_neg hq]
      infer_instance
    exact Subsingleton.elim _ _

end ColorPairAutomorphism
end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.PaperTorAbsolute -/
section

/-! # The absolute form of Theorem 1.2

Both sides are the ordinary absolute objects: actual derived Tor of the
original face ring, and cohomology defined directly from augmented chains.
The intervening empty relative ideal is removed by explicit isomorphisms.
-/
noncomputable section
open scoped DirectSum
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
abbrev rankSelectedCohomology (S : Finset (Fin d)) (i : ℕ) :=
  letI : LinearOrder (NonzeroFace P) := (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  reducedCohomology (K := K) (rankSelection (rankColoredOrderComplex hs d hrank) S)
    (rankSelection_downward (rankColoredOrderComplex hs d hrank) S)
    ((S.card : ℤ) - i - 1)

def rankSelectedEmptyRelativeIso (S : Finset (Fin d)) (i : ℕ) :
    rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i ≅
      rankSelectedCohomology K hs d hrank S i := by
  letI : LinearOrder (NonzeroFace P) := (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  exact relativeVoidReducedCohomologyIso (K := K)
    (rankSelection (rankColoredOrderComplex hs d hrank) S)
    (rankSelection (rankColoredSubcomplex hs d hrank (∅ : Set P)).toColoredComplex S)
    (rankSelection_downward (rankColoredOrderComplex hs d hrank) S)
    (rankSelection_downward (rankColoredSubcomplex hs d hrank (∅ : Set P)).toColoredComplex S)
    (ProperlyColoredComplex.Subcomplex.rankSelection_void
      (D := rankColoredOrderComplex hs d hrank)
      (Q := rankColoredSubcomplex hs d hrank (∅ : Set P))
      (rankColoredSubcomplex_empty_face hs d hrank) S) ((S.card : ℤ) - i - 1)

def rankSelectedCohomologyAction (e : P ≃o P) (S : Finset (Fin d)) (i : ℕ) :
    rankSelectedCohomology K hs d hrank S i ⟶ rankSelectedCohomology K hs d hrank S i :=
  (rankColoredPairOrderAut hs d hrank (∅ : Set P) e (by simp)).absoluteReducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K
    (rankColoredSubcomplex_empty_face hs d hrank) S ((S.card : ℤ) - i - 1)

theorem rankSelectedEmptyRelativeIso_natural (e : P ≃o P) (S : Finset (Fin d)) (i : ℕ)
    (x : rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i) :
    (rankSelectedEmptyRelativeIso K hs d hrank S i).hom
      ((rankColoredPairOrderAut hs d hrank (∅ : Set P) e (by simp)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S
        ((S.card : ℤ) - i - 1) x) =
      rankSelectedCohomologyAction K hs d hrank e S i
        ((rankSelectedEmptyRelativeIso K hs d hrank S i).hom x) := by
  letI : LinearOrder (NonzeroFace P) := (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  exact congrArg (fun f => f x)
    ((rankColoredPairOrderAut hs d hrank (∅ : Set P) e (by simp)).relativeVoidReducedCohomologyIso_natural (D := rankColoredOrderComplex hs d hrank) K
      (rankColoredSubcomplex_empty_face hs d hrank) S ((S.card : ℤ) - i - 1))

/-- **Theorem 1.2.** The entire associated graded of the actual internal Tor
piece is the direct sum of ordinary rank-selected reduced cohomology. -/
def theorem_1_2 (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedCohomology K hs d hrank S.val i) :=
  (originalTorRankSelectedDirectSumEquiv K hs d hrank j i).trans
    (DirectSum.congrLinearEquiv (fun S =>
      (rankSelectedEmptyRelativeIso K hs d hrank S.val i).toLinearEquiv))

variable {G : Type v} [Group G] (a : PosetGroupAction G P)

theorem theorem_1_2_equivariant (j i : ℕ) (g : G)
    (x : originalTorAssociatedGraded K hs d hrank j i) :
    theorem_1_2 K hs d hrank j i
      (originalTorAssociatedRepresentation K hs d hrank a j i g x) =
      DirectSum.lmap (fun S : {S : Finset (Fin d) // rankSubsetDegree S = j} =>
        (rankSelectedCohomologyAction K hs d hrank (a.orderIso g) S.val i).hom)
        (theorem_1_2 K hs d hrank j i x) := by
  apply DFinsupp.ext
  intro S
  change (rankSelectedEmptyRelativeIso K hs d hrank S.val i).hom
      (originalTorRankSelectedEquiv K hs d hrank j i
        (originalTorAssociatedRepresentation K hs d hrank a j i g x) S) = _
  rw [originalTorRankSelectedEquiv_equivariant]
  exact rankSelectedEmptyRelativeIso_natural K hs d hrank (a.orderIso g) S.val i _

/-- The exact finite, stable filtration used in the displayed isomorphism. -/
theorem theorem_1_2_finite_stable (j i : ℕ) :
    (originalTorFiltration K hs d hrank j i).level (2 * d * j + 1) = ⊤ ∧
      ∀ g, Preserves (originalTorFiltration K hs d hrank j i)
        (originalTorFiltration K hs d hrank j i)
        (originalTorDegreeRepresentation K hs d hrank a j i g) :=
  ⟨originalTorFiltration_finite K hs d hrank j i,
    fun g => originalTorDegreeAction_filtered K hs d hrank (a.orderIso g) j i⟩

end FourPapers.Universal

namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology FourPapers.RepresentationGrothendieck
universe u v
variable {P K : Type u} {G : Type v} [PartialOrder P] [OrderBot P] [Fintype P] [Field K] [Group G]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (a : PosetGroupAction G P)

def originalTorFiniteRepresentation (j i : ℕ) : FiniteRepresentation K G := by
  letI := originalRelativeTorDegreePiece_finiteDimensional K hs d hrank (∅ : Set P) (by simp) j i
  letI := Module.Finite.equiv (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
  exact FiniteRepresentation.of (originalTorDegreePiece K hs d hrank j i)
    (originalTorDegreeRepresentation K hs d hrank a j i)

def rankSelectedFiniteRepresentation (S : Finset (Fin d)) (i : ℕ) : FiniteRepresentation K G := by
  let V := rankSelectedRelativeFiniteRepresentation K hs d hrank (∅ : Set P) (by simp) a (by simp) S i
  letI : Module.Finite K (rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i) := V.finite
  let E := (rankSelectedEmptyRelativeIso K hs d hrank S i).toLinearEquiv
  letI := Module.Finite.equiv E
  exact FiniteRepresentation.of (rankSelectedCohomology K hs d hrank S i)
    (representationOfIntertwiningEquiv K V.action E
      (fun g => (rankSelectedCohomologyAction K hs d hrank (a.orderIso g) S i).hom)
      (fun g x => rankSelectedEmptyRelativeIso_natural K hs d hrank (a.orderIso g) S i x))

/-- **Theorem 1.2, representation-ring consequence.** The ordinary Tor
representation and ordinary cohomology representations have the stated
classes over every field, including modular characteristic. -/
theorem theorem_1_2_grothendieck (j i : ℕ) :
    classOf K G (originalTorFiniteRepresentation K hs d hrank a j i) =
      ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        classOf K G (rankSelectedFiniteRepresentation K hs d hrank a S.val i) := by
  calc
    _ = classOf K G (originalRelativeTorFiniteRepresentation K hs d hrank
        (∅ : Set P) a (by simp) (by simp) j i) := by
      symm
      exact class_equiv (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
        (fun g x => originalEmptyRelativeTorDegreeEquiv_equivariant K hs d hrank (a.orderIso g) j i x)
    _ = ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank (∅ : Set P)
          (by simp) a (by simp) S.val i) :=
      theorem_1_2_relative_grothendieck K hs d hrank (∅ : Set P) (by simp) a (by simp) j i
    _ = _ := by
      apply Finset.sum_congr rfl
      intro S hS
      exact class_equiv (rankSelectedEmptyRelativeIso K hs d hrank S.val i).toLinearEquiv
        (fun g x => rankSelectedEmptyRelativeIso_natural K hs d hrank (a.orderIso g) S.val i x)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.TorMultiplication -/
section

/-! # The resolution product on ordinary Tor and its internal filtration

The product is induced from the literal coefficient exterior Koszul DGA via
the proved resolution isomorphism.  The empty-relative coefficient identity
is used so that the internal submodules agree with the ones in the Tor
formula.  Their products are restrictions of this same ordinary Tor product.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

def originalCoefficientHomologyEquiv (i : ℕ) :
    CoefficientKoszulHomology (K := K)
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i ≃ₗ[K]
      originalKoszulHomology K hs d i :=
  parameterHomologyNormalization K (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i

def originalKoszulHomologyProduct (i l : ℕ) :
    originalKoszulHomology K hs d i →ₗ[K] originalKoszulHomology K hs d l →ₗ[K]
      originalKoszulHomology K hs d (i + l) :=
  ((coefficientKoszulHomologyProduct (K := K)
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l).compl₁₂
    (originalCoefficientHomologyEquiv K hs d i).symm.toLinearMap
    (originalCoefficientHomologyEquiv K hs d l).symm.toLinearMap).compr₂
      (originalCoefficientHomologyEquiv K hs d (i + l)).toLinearMap

@[simp] theorem originalKoszulHomologyProduct_class (i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalKoszulComplex K hs d) i))
    (y : LinearMap.ker (complexOutgoing (originalKoszulComplex K hs d) l)) :
    originalKoszulHomologyProduct K hs d i l (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _
        ⟨coefficientKoszulProduct (K := K) i l x.val y.val,
          coefficientKoszulProduct_cycle
            (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l
              x.val y.val x.property y.property⟩ := by
  rfl

def originalKoszulHomologyToTotal (i : ℕ) :
    originalKoszulHomology K hs d i →ₗ[K]
      CoefficientExteriorHomology (K := K) (fun c : Fin d => faceRankParameter K hs (c.val + 1)) :=
  (coefficientKoszulHomologyToTotal (K := K)
    (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i).comp
      (originalCoefficientHomologyEquiv K hs d i).symm.toLinearMap

theorem originalKoszulHomologyToTotal_product (i l : ℕ)
    (x : originalKoszulHomology K hs d i) (y : originalKoszulHomology K hs d l) :
    originalKoszulHomologyToTotal K hs d (i + l) (originalKoszulHomologyProduct K hs d i l x y) =
      originalKoszulHomologyToTotal K hs d i x * originalKoszulHomologyToTotal K hs d l y := by
  simp only [originalKoszulHomologyToTotal, originalKoszulHomologyProduct,
    LinearMap.comp_apply, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  exact coefficientKoszulHomologyProduct_toTotal
    (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l _ _

def originalEmptyRelativeTotalTermEquiv (i : ℕ) :
    originalRelativeKoszulTerm K hs d (∅ : Set P) i ≃ₗ[K] (originalKoszulComplex K hs d).X i where
  toFun := Subtype.val
  invFun x := ⟨x, by rw [originalRelativeKoszulTerm_empty]; trivial⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def originalEmptyRelativeTotalComplexIso :
    originalRelativeKoszulComplex K hs d (∅ : Set P) ≅ originalKoszulComplex K hs d :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (originalEmptyRelativeTotalTermEquiv K hs d i).toModuleIso) (by
      intro i j hij
      obtain rfl : i = j + 1 := hij.symm
      rw [parameterKoszulComplex_d]
      simp only [originalRelativeKoszulComplex, submoduleComplex_d]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      change parameterKoszulDifferential (K := K)
          (fun c : Fin d => faceRankParameter K hs (c.val + 1)) j x.val =
        complexIncoming (originalKoszulComplex K hs d) j x.val
      exact (LinearMap.congr_fun (parameterKoszulComplex_incoming_eq K
        (fun c : Fin d => faceRankParameter K hs (c.val + 1)) j) x.val).symm)

/-- An actual derived-functor resolution isomorphism; its final chain map is
the identity on every coefficient of the ordinary Koszul resolution. -/
def originalTorProductResolutionIso (i : ℕ) :
    originalParameterTor K hs d i ≅ ModuleCat.of K (originalKoszulHomology K hs d i) :=
  (originalEmptyRelativeTorIso K hs d i).symm ≪≫
    originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i ≪≫
      (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i).toModuleIso

/-- The ordinary Tor product computed by the genuine coefficient Koszul
resolution, independently of the colorful cohomology description. -/
def originalTorProduct (i l : ℕ) :
    originalParameterTor K hs d i →ₗ[K] originalParameterTor K hs d l →ₗ[K]
      originalParameterTor K hs d (i + l) :=
  ((originalKoszulHomologyProduct K hs d i l).compl₁₂
    (originalTorProductResolutionIso K hs d i).toLinearEquiv.toLinearMap
    (originalTorProductResolutionIso K hs d l).toLinearEquiv.toLinearMap).compr₂
      (originalTorProductResolutionIso K hs d (i + l)).symm.toLinearEquiv.toLinearMap

@[simp] theorem originalTorProduct_resolution (i l : ℕ)
    (x : originalParameterTor K hs d i) (y : originalParameterTor K hs d l) :
    (originalTorProductResolutionIso K hs d (i + l)).hom (originalTorProduct K hs d i l x y) =
      originalKoszulHomologyProduct K hs d i l
        ((originalTorProductResolutionIso K hs d i).hom x)
        ((originalTorProductResolutionIso K hs d l).hom y) := by
  exact (originalTorProductResolutionIso K hs d (i + l)).toLinearEquiv.apply_symm_apply _

theorem originalTorProduct_exterior (i l : ℕ)
    (x : originalParameterTor K hs d i) (y : originalParameterTor K hs d l) :
    originalKoszulHomologyToTotal K hs d (i + l)
      ((originalTorProductResolutionIso K hs d (i + l)).hom (originalTorProduct K hs d i l x y)) =
      originalKoszulHomologyToTotal K hs d i ((originalTorProductResolutionIso K hs d i).hom x) *
        originalKoszulHomologyToTotal K hs d l ((originalTorProductResolutionIso K hs d l).hom y) := by
  rw [originalTorProduct_resolution, originalKoszulHomologyToTotal_product]

variable (hrank : ∀ p : P, faceRank p ≤ d)

theorem originalKoszulDegreeOutgoing_val (j i : ℕ)
    (x : originalKoszulDegreePiece K hs d i j) :
    (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i x).val =
      complexOutgoing (originalKoszulComplex K hs d) i x.val :=
  (congrArg (fun f : (originalKoszulDegreeComplex K hs d hrank j).X i ⟶
      (originalKoszulComplex K hs d).X (i - 1) => f x)
    ((originalKoszulDegreeInclusion K hs d hrank j).comm i (i - 1))).symm

def originalInternalHomologyInclusion (j i : ℕ) :
    originalInternalKoszulHomology K hs d hrank j i →ₗ[K] originalKoszulHomology K hs d i :=
  complexKernelHomologyMap (originalKoszulDegreeInclusion K hs d hrank j) i

def originalInternalHomologyRetraction (j i : ℕ) :
    originalKoszulHomology K hs d i →ₗ[K] originalInternalKoszulHomology K hs d hrank j i :=
  complexKernelHomologyMap (originalKoszulDegreeRetraction K hs d hrank j) i

theorem originalInternalHomology_retract_include (j i : ℕ) :
    (originalInternalHomologyRetraction K hs d hrank j i).comp
      (originalInternalHomologyInclusion K hs d hrank j i) = LinearMap.id := by
  rw [originalInternalHomologyRetraction, originalInternalHomologyInclusion,
    ← complexKernelHomologyMap_comp, originalKoszulDegreeInclusion_retraction,
    complexKernelHomologyMap_id]

theorem originalInternalHomologyInclusion_injective (j i : ℕ) :
    Function.Injective (originalInternalHomologyInclusion K hs d hrank j i) := by
  intro x y h
  have hh := congrArg (originalInternalHomologyRetraction K hs d hrank j i) h
  simpa only [← LinearMap.comp_apply, originalInternalHomology_retract_include,
    LinearMap.id_apply] using hh

theorem originalInternalHomologyInclusion_filtered (j i : ℕ) :
    Preserves (originalInternalHomologyFiltration K hs d hrank j i)
      (originalKoszulHomologyFiltration K hs d i)
      (originalInternalHomologyInclusion K hs d hrank j i) :=
  complexKernelHomologyMap_preserves (originalKoszulDegreeInclusion K hs d hrank j)
    (originalDegreeTermFiltration K hs d j) (originalKoszulFiltration K hs d)
    (fun _ _ _ hx => hx) i

theorem originalInternalHomologyRetraction_filtered (j i : ℕ) :
    Preserves (originalKoszulHomologyFiltration K hs d i)
      (originalInternalHomologyFiltration K hs d hrank j i)
      (originalInternalHomologyRetraction K hs d hrank j i) :=
  complexKernelHomologyMap_preserves (originalKoszulDegreeRetraction K hs d hrank j)
    (originalKoszulFiltration K hs d) (originalDegreeTermFiltration K hs d j)
    (fun k => basisProjection_preserves_other (originalKoszulBasis K hs d k)
      originalKoszulDegree j (fun a => (originalKoszulWeight d a).toNat)) i

include hrank in
theorem originalKoszulHomologyProduct_filtered (i l : ℕ) :
    PreservesPair (originalKoszulHomologyFiltration K hs d i)
      (originalKoszulHomologyFiltration K hs d l)
      (originalKoszulHomologyFiltration K hs d (i + l))
      (originalKoszulHomologyProduct K hs d i l) := by
  intro r s x y hx hy
  obtain ⟨x, rfl⟩ := (originalCoefficientHomologyEquiv K hs d i).surjective x
  obtain ⟨y, rfl⟩ := (originalCoefficientHomologyEquiv K hs d l).surjective y
  simp only [originalKoszulHomologyProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  apply (parameterHomologyNormalization_filtered K
    (fun c : Fin d => faceRankParameter K hs (c.val + 1))
    (originalKoszulFiltration K hs d) (i + l) (r + s + 1) _).mpr
  apply coefficientKoszulHomologyProduct_filtered
    (fun c : Fin d => faceRankParameter K hs (c.val + 1))
    (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i l
  · exact (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) i (r + 1) x).mp hx
  · exact (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) l (s + 1) y).mp hy

/-- The identity normalization of cycles induces the same associated product
as filtering the actual categorical Koszul homology product. -/
theorem originalAssociatedHomologyProduct_eq_gradeProduct (i l r s : ℕ)
    (x : Grade (originalKoszulHomologyFiltration K hs d i) r)
    (y : Grade (originalKoszulHomologyFiltration K hs d l) s) :
    originalAssociatedHomologyProduct K hs d hrank i l r s x y =
      gradeBilinearProduct (originalKoszulHomologyFiltration K hs d i)
        (originalKoszulHomologyFiltration K hs d l)
        (originalKoszulHomologyFiltration K hs d (i + l))
        (originalKoszulHomologyProduct K hs d i l)
        (originalKoszulHomologyProduct_filtered K hs d hrank i l) r s x y := by
  obtain ⟨x, rfl⟩ := (originalCoefficientHomologyGradeEquiv K hs d i r).surjective x
  obtain ⟨y, rfl⟩ := (originalCoefficientHomologyGradeEquiv K hs d l s).surjective y
  simp only [originalAssociatedHomologyProduct, LinearMap.compr₂_apply,
    LinearMap.compl₁₂_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  change (originalCoefficientHomologyGradeEquiv K hs d (i + l) (r + s)).toLinearMap
      (coefficientHomologyGradeProduct
        (fun c : Fin d => faceRankParameter K hs (c.val + 1))
        (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i l r s x y) =
    gradeBilinearProduct (originalKoszulHomologyFiltration K hs d i)
      (originalKoszulHomologyFiltration K hs d l)
      (originalKoszulHomologyFiltration K hs d (i + l))
      (originalKoszulHomologyProduct K hs d i l)
      (originalKoszulHomologyProduct_filtered K hs d hrank i l) r s
      ((originalCoefficientHomologyGradeEquiv K hs d i r).toLinearMap x)
      ((originalCoefficientHomologyGradeEquiv K hs d l s).toLinearMap y)
  simp only [originalCoefficientHomologyGradeEquiv, parameterHomologyGradeNormalization,
    gradeEquiv_eq_gradeMap]
  exact gradeBilinearProduct_natural_of_lower_defect
    (coefficientHomologyFiltration (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) i)
    (coefficientHomologyFiltration (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) l)
    (coefficientHomologyFiltration (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) (i + l))
    (coefficientKoszulHomologyProduct (K := K)
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l)
    (coefficientKoszulHomologyProduct_filtered
      (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i l)
    (originalKoszulHomologyFiltration K hs d i) (originalKoszulHomologyFiltration K hs d l)
    (originalKoszulHomologyFiltration K hs d (i + l))
    (originalKoszulHomologyProduct K hs d i l)
    (originalKoszulHomologyProduct_filtered K hs d hrank i l)
    (originalCoefficientHomologyEquiv K hs d i).toLinearMap
    (originalCoefficientHomologyEquiv K hs d l).toLinearMap
    (originalCoefficientHomologyEquiv K hs d (i + l)).toLinearMap
    (fun n z => (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (originalKoszulFiltration K hs d) i n z).mpr)
    (fun n z => (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (originalKoszulFiltration K hs d) l n z).mpr)
    (fun n z => (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (originalKoszulFiltration K hs d) (i + l) n z).mpr)
    (by
      intro r s z w hz hw
      simp only [originalKoszulHomologyProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
        LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply, sub_self]
      exact Submodule.zero_mem _) r s x y

/-- Restrict the actual product by the actual internal-degree projection.
The following inclusion formula proves that no product term is discarded. -/
def originalInternalHomologyProduct (j k i l : ℕ) :
    originalInternalKoszulHomology K hs d hrank j i →ₗ[K]
      originalInternalKoszulHomology K hs d hrank k l →ₗ[K]
        originalInternalKoszulHomology K hs d hrank (j + k) (i + l) :=
  ((originalKoszulHomologyProduct K hs d i l).compl₁₂
    (originalInternalHomologyInclusion K hs d hrank j i)
    (originalInternalHomologyInclusion K hs d hrank k l)).compr₂
      (originalInternalHomologyRetraction K hs d hrank (j + k) (i + l))

def originalInternalCycleProduct (j k i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i))
    (y : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank k) l)) :
    LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank (j + k)) (i + l)) :=
  ⟨⟨coefficientKoszulProduct (K := K) i l x.val.val y.val.val,
    originalKoszulProduct_internalDegree K hs d i l j k x.val.val y.val.val
      x.val.property y.val.property⟩, by
    apply Subtype.ext
    rw [originalKoszulDegreeOutgoing_val]
    exact coefficientKoszulProduct_cycle
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l x.val.val y.val.val
      (by rw [← originalKoszulDegreeOutgoing_val K hs d hrank j i x.val, x.property]; rfl)
      (by rw [← originalKoszulDegreeOutgoing_val K hs d hrank k l y.val, y.property]; rfl)⟩

@[simp] theorem originalInternalHomologyProduct_class (j k i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i))
    (y : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank k) l)) :
    originalInternalHomologyProduct K hs d hrank j k i l
      (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _ (originalInternalCycleProduct K hs d hrank j k i l x y) := by
  change complexKernelHomologyMap (originalKoszulDegreeRetraction K hs d hrank (j + k)) (i + l)
    (originalKoszulHomologyProduct K hs d i l
      (complexKernelHomologyMap (originalKoszulDegreeInclusion K hs d hrank j) i
        (homologyClass _ _ _ x))
      (complexKernelHomologyMap (originalKoszulDegreeInclusion K hs d hrank k) l
        (homologyClass _ _ _ y))) = _
  rw [complexKernelHomologyMap_class, complexKernelHomologyMap_class,
    originalKoszulHomologyProduct_class]
  apply congrArg (homologyClass _ _ _)
  apply Subtype.ext
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self
    (originalKoszulProduct_internalDegree K hs d i l j k x.val.val y.val.val
      x.val.property y.val.property)

theorem originalInternalHomologyProduct_inclusion (j k i l : ℕ)
    (x : originalInternalKoszulHomology K hs d hrank j i)
    (y : originalInternalKoszulHomology K hs d hrank k l) :
    originalInternalHomologyInclusion K hs d hrank (j + k) (i + l)
      (originalInternalHomologyProduct K hs d hrank j k i l x y) =
      originalKoszulHomologyProduct K hs d i l
        (originalInternalHomologyInclusion K hs d hrank j i x)
        (originalInternalHomologyInclusion K hs d hrank k l y) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  change originalInternalHomologyInclusion K hs d hrank (j + k) (i + l)
      (originalInternalHomologyProduct K hs d hrank j k i l
        (homologyClass _ _ _ x) (homologyClass _ _ _ y)) =
    originalKoszulHomologyProduct K hs d i l
      (originalInternalHomologyInclusion K hs d hrank j i (homologyClass _ _ _ x))
      (originalInternalHomologyInclusion K hs d hrank k l (homologyClass _ _ _ y))
  rw [originalInternalHomologyProduct_class]
  change complexKernelHomologyMap _ _ (homologyClass _ _ _ _) =
    originalKoszulHomologyProduct K hs d i l
      (complexKernelHomologyMap _ _ (homologyClass _ _ _ x))
      (complexKernelHomologyMap _ _ (homologyClass _ _ _ y))
  rw [complexKernelHomologyMap_class, complexKernelHomologyMap_class,
    complexKernelHomologyMap_class, originalKoszulHomologyProduct_class]
  rfl

theorem originalInternalHomologyProduct_filtered (j k i l : ℕ) :
    PreservesPair (originalInternalHomologyFiltration K hs d hrank j i)
      (originalInternalHomologyFiltration K hs d hrank k l)
      (originalInternalHomologyFiltration K hs d hrank (j + k) (i + l))
      (originalInternalHomologyProduct K hs d hrank j k i l) := by
  intro r s x y hx hy
  apply originalInternalHomologyRetraction_filtered K hs d hrank (j + k) (i + l)
  apply originalKoszulHomologyProduct_filtered K hs d hrank i l
  · exact originalInternalHomologyInclusion_filtered K hs d hrank j i (r + 1) x hx
  · exact originalInternalHomologyInclusion_filtered K hs d hrank k l (s + 1) y hy

def originalInternalTorEquiv (j i : ℕ) :
    originalInternalKoszulHomology K hs d hrank j i ≃ₗ[K] originalTorDegreePiece K hs d hrank j i :=
  (originalEmptyRelativeHomologyEquiv K hs d hrank j i).symm.trans
    ((originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i).trans
      (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i))

theorem originalInternalTorEquiv_filtered (j i n : ℕ)
    (x : originalInternalKoszulHomology K hs d hrank j i) :
    originalInternalTorEquiv K hs d hrank j i x ∈ (originalTorFiltration K hs d hrank j i).level n ↔
      x ∈ (originalInternalHomologyFiltration K hs d hrank j i).level n := by
  rw [originalInternalTorEquiv, LinearEquiv.trans_apply, LinearEquiv.trans_apply,
    originalEmptyRelativeTorDegreeEquiv_filtered]
  rw [originalRelativeTorFiltration, equivalenceFiltration_apply]
  have h := originalEmptyRelativeHomologyEquiv_filtered K hs d hrank j i n
    ((originalEmptyRelativeHomologyEquiv K hs d hrank j i).symm x)
  simpa only [LinearEquiv.apply_symm_apply] using h.symm

theorem originalEmptyRelative_inclusion_square (j : ℕ) :
    originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j ≫
      (originalEmptyRelativeTotalComplexIso K hs d).hom =
    (originalEmptyRelativeComplexIso K hs d hrank j).hom ≫
      originalKoszulDegreeInclusion K hs d hrank j := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change x.val = (originalEmptyRelativeTermEquiv K hs d j i x).val
  exact (LinearEquiv.coe_ofEq_apply
    (originalRelativeDegreeTerm_empty K hs d j i) x).symm

/-- The homogeneous-submodule equivalence really is the homogeneous
inclusion under the same resolution map that defines multiplication. -/
theorem originalInternalTorEquiv_resolution (j i : ℕ)
    (x : originalInternalKoszulHomology K hs d hrank j i) :
    (originalTorProductResolutionIso K hs d i).hom (originalInternalTorEquiv K hs d hrank j i x).val =
      originalInternalHomologyInclusion K hs d hrank j i x := by
  let y := (originalEmptyRelativeHomologyEquiv K hs d hrank j i).symm x
  have hc := congrArg (fun f => complexKernelHomologyMap f i)
    (originalEmptyRelative_inclusion_square K hs d hrank j)
  rw [complexKernelHomologyMap_comp, complexKernelHomologyMap_comp] at hc
  have hx := LinearMap.congr_fun hc y
  change complexKernelHomologyMap (originalEmptyRelativeTotalComplexIso K hs d).hom i
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y) =
    originalInternalHomologyInclusion K hs d hrank j i
      (originalEmptyRelativeHomologyEquiv K hs d hrank j i y) at hx
  rw [LinearEquiv.apply_symm_apply] at hx
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
    ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).hom
      ((originalEmptyRelativeTorIso K hs d i).inv
        ((originalEmptyRelativeTorIso K hs d i).hom
          ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).inv
            (complexKernelHomologyMap
              (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y))))) = _
  simp only [← ModuleCat.comp_apply, Iso.hom_inv_id, Iso.inv_hom_id, ModuleCat.id_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
      ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv.symm
          (complexKernelHomologyMap
            (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y))) = _
  rw [LinearEquiv.apply_symm_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i).toLinearMap
      (complexKernelHomologyMap
        (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y) = _
  rw [complexKernelHomologyEquiv_toLinearMap]
  exact hx

def originalTorInternalProduct (j k i l : ℕ) :
    originalTorDegreePiece K hs d hrank j i →ₗ[K]
      originalTorDegreePiece K hs d hrank k l →ₗ[K]
        originalTorDegreePiece K hs d hrank (j + k) (i + l) :=
  ((originalInternalHomologyProduct K hs d hrank j k i l).compl₁₂
    (originalInternalTorEquiv K hs d hrank j i).symm.toLinearMap
    (originalInternalTorEquiv K hs d hrank k l).symm.toLinearMap).compr₂
      (originalInternalTorEquiv K hs d hrank (j + k) (i + l)).toLinearMap

theorem originalTorInternalProduct_val (j k i l : ℕ)
    (x : originalTorDegreePiece K hs d hrank j i) (y : originalTorDegreePiece K hs d hrank k l) :
    (originalTorInternalProduct K hs d hrank j k i l x y).val =
      originalTorProduct K hs d i l x.val y.val := by
  obtain ⟨x, rfl⟩ := (originalInternalTorEquiv K hs d hrank j i).surjective x
  obtain ⟨y, rfl⟩ := (originalInternalTorEquiv K hs d hrank k l).surjective y
  apply (originalTorProductResolutionIso K hs d (i + l)).toLinearEquiv.injective
  simp only [originalTorInternalProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  change (originalTorProductResolutionIso K hs d (i + l)).hom
      (originalInternalTorEquiv K hs d hrank (j + k) (i + l)
        (originalInternalHomologyProduct K hs d hrank j k i l x y)).val =
    (originalTorProductResolutionIso K hs d (i + l)).hom
      (originalTorProduct K hs d i l
        (originalInternalTorEquiv K hs d hrank j i x).val
        (originalInternalTorEquiv K hs d hrank k l y).val)
  rw [originalInternalTorEquiv_resolution, originalTorProduct_resolution,
    originalInternalTorEquiv_resolution, originalInternalTorEquiv_resolution]
  exact originalInternalHomologyProduct_inclusion K hs d hrank j k i l x y

theorem originalTorInternalProduct_filtered (j k i l : ℕ) :
    PreservesPair (originalTorFiltration K hs d hrank j i)
      (originalTorFiltration K hs d hrank k l)
      (originalTorFiltration K hs d hrank (j + k) (i + l))
      (originalTorInternalProduct K hs d hrank j k i l) := by
  intro r s x y hx hy
  obtain ⟨x, rfl⟩ := (originalInternalTorEquiv K hs d hrank j i).surjective x
  obtain ⟨y, rfl⟩ := (originalInternalTorEquiv K hs d hrank k l).surjective y
  simp only [originalTorInternalProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  apply (originalInternalTorEquiv_filtered K hs d hrank (j + k) (i + l) (r + s + 1) _).mpr
  apply originalInternalHomologyProduct_filtered K hs d hrank j k i l
  · exact (originalInternalTorEquiv_filtered K hs d hrank j i (r + 1) x).mp hx
  · exact (originalInternalTorEquiv_filtered K hs d hrank k l (s + 1) y).mp hy

def originalTorAssociatedProduct (j k i l r s : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) r →ₗ[K]
      Grade (originalTorFiltration K hs d hrank k l) s →ₗ[K]
        Grade (originalTorFiltration K hs d hrank (j + k) (i + l)) (r + s) :=
  gradeBilinearProduct _ _ _ (originalTorInternalProduct K hs d hrank j k i l)
    (originalTorInternalProduct_filtered K hs d hrank j k i l) r s

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.TorMultiplicativeComparison -/
section

/-! # Multiplicativity of the actual internal Tor comparison

The barycentric product is obtained from its own coefficient exterior DGA.
The homogeneous inclusion has an actual coefficient projection as a
retraction.  The canonical comparison commutes with these inclusions; this
proves compatibility with multiplication in every internal and weight
degree, for the very filtration used in Theorem 1.2.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def originalEmptyDegreeInclusion (j : ℕ) :
    originalRelativeDegreeComplex K hs d (∅ : Set P) hrank j ⟶ originalKoszulComplex K hs d :=
  submoduleComplexInclusion _ _ (originalRelativeDegreeTerm_preserved K hs d (∅ : Set P) hrank j)

def barycentricEmptyDegreeInclusion (j : ℕ) :
    barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j ⟶ barycentricKoszulComplex (P := P) K d :=
  submoduleComplexInclusion _ _ (barycentricRelativeDegreeTerm_preserved K d (∅ : Set P) j)

def barycentricEmptyDegreeRetraction (j : ℕ) :
    barycentricKoszulComplex (P := P) K d ⟶ barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j where
  f i := ModuleCat.ofHom
    ((FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
      originalKoszulDegree j).codRestrict _ (by
        intro x
        rw [barycentricRelativeDegreeTerm_empty]
        exact FourPapers.BasisGrading.projection_mem _ _ _ x))
  comm' i l hil := by
    obtain rfl : i = l + 1 := hil.symm
    simp only [barycentricRelativeDegreeComplex, submoduleComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
      (barycentricIncoming_degree K d l) j) x

theorem barycentricEmptyDegreeInclusion_retraction (j : ℕ) :
    barycentricEmptyDegreeInclusion (P := P) K d j ≫ barycentricEmptyDegreeRetraction (P := P) K d j = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self x.property.2

def originalEmptyGradedHomologyInclusion (j i n : ℕ) :
    complexGradedHomology (originalRelativeDegreeComplex K hs d (∅ : Set P) hrank j)
      (originalRelativeDegreeFiltration K hs d (∅ : Set P) j)
      (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j) i n →ₗ[K]
        originalGradedKoszulHomology K hs d hrank i n :=
  complexGradedHomologyMap (originalEmptyDegreeInclusion K hs d hrank j)
    (originalRelativeDegreeFiltration K hs d (∅ : Set P) j) (originalKoszulFiltration K hs d)
    (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j)
    (originalIncoming_preserves K hs d hrank) (fun _ _ _ hx => hx) i n

def barycentricEmptyGradedHomologyInclusion (j i n : ℕ) :
    complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n →ₗ[K]
        barycentricGradedKoszulHomology (P := P) K d i n :=
  complexGradedHomologyMap (barycentricEmptyDegreeInclusion (P := P) K d j)
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
    (barycentricKoszulFiltration (P := P) K d)
    (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j)
    (barycentricIncoming_preserves K d) (fun _ _ _ hx => hx) i n

def barycentricEmptyGradedHomologyRetraction (j i n : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i n →ₗ[K]
      complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
        (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
        (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n :=
  complexGradedHomologyMap (barycentricEmptyDegreeRetraction (P := P) K d j)
    (barycentricKoszulFiltration (P := P) K d)
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
    (barycentricIncoming_preserves K d)
    (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j)
    (fun i => basisProjection_preserves_other (barycentricKoszulBasis (P := P) K d i)
      originalKoszulDegree j (fun a => (originalKoszulWeight d a).toNat)) i n

theorem barycentricEmptyGradedHomology_retract_include (j i n : ℕ)
    (x : complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n) :
    barycentricEmptyGradedHomologyRetraction (P := P) K d j i n
      (barycentricEmptyGradedHomologyInclusion (P := P) K d j i n x) = x := by
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  apply congrArg (homologyClass _ _ _)
  apply Subtype.ext
  obtain ⟨w, hw⟩ := (lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j i) n).mkQ_surjective z.val
  change gradeMap _ _ _ _ n (gradeMap _ _ _ _ n z.val) = z.val
  rw [← hw]
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j i) n))
  apply Subtype.ext
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self w.val.property.2

def originalEmptyAssociatedHomologyInclusion (j i n : ℕ) :
    Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n →ₗ[K]
      Grade (originalKoszulHomologyFiltration K hs d i) n :=
  gradeMap _ _ (complexKernelHomologyMap (originalEmptyDegreeInclusion K hs d hrank j) i)
    (complexKernelHomologyMap_preserves (originalEmptyDegreeInclusion K hs d hrank j)
      (originalRelativeDegreeFiltration K hs d (∅ : Set P) j)
      (originalKoszulFiltration K hs d) (fun _ _ _ hx => hx) i) n

theorem relativeKoszulGradedComparison_inclusion (j i n : ℕ)
    (x : complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n) :
    koszulGradedHomologyComparison K hs d hrank i n
      (barycentricEmptyGradedHomologyInclusion (P := P) K d j i n x) =
    originalEmptyGradedHomologyInclusion K hs d hrank j i n
      (complexGradedHomologyEquiv _ _
        (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j)
        (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j)
        (relativeInternalKoszulComparison K hs d (∅ : Set P) (by simp) hrank j)
        (relativeInternalCoefficientEquiv_filtered K hs d (∅ : Set P) (by simp) hrank j) i n x) := by
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  apply congrArg (homologyClass _ _ _)
  apply Subtype.ext
  obtain ⟨w, hw⟩ := (lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j i) n).mkQ_surjective z.val
  change koszulGradeComparison K hs d hrank i n (gradeMap _ _ _ _ n z.val) =
    gradeMap _ _ _ _ n
      (gradeEquiv _ _ (complexIsoLinearEquiv
        (relativeInternalKoszulComparison K hs d (∅ : Set P) (by simp) hrank j) i) _ n z.val)
  rw [← hw]
  rfl

theorem relativeAssociatedComparison_inclusion (j i n : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n) :
    barycentricEmptyGradedHomologyInclusion (P := P) K d j i n
      (relativeInternalAssociatedGradedComparison K hs d (∅ : Set P) (by simp) hrank j i n x) =
      originalAssociatedBarycentricHomology K hs d hrank i n
        (originalEmptyAssociatedHomologyInclusion K hs d hrank j i n x) := by
  apply (koszulGradedHomologyComparison K hs d hrank i n).injective
  rw [relativeKoszulGradedComparison_inclusion]
  simp only [relativeInternalAssociatedGradedComparison, originalAssociatedBarycentricHomology,
    LinearEquiv.trans_apply, LinearEquiv.apply_symm_apply]
  exact (complexAssociatedHomologyEquiv_natural
    (originalEmptyDegreeInclusion K hs d hrank j)
    (originalRelativeDegreeFiltration K hs d (∅ : Set P) j) (originalKoszulFiltration K hs d)
    (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j)
    (originalIncoming_preserves K hs d hrank) (fun _ _ _ hx => hx)
    (originalRelativeDegreeIncoming_liftsCycles K hs d (∅ : Set P) (by simp) hrank j)
    (originalIncoming_liftsCycles K hs d hrank) i n x).symm

def originalTorHomologyInclusion (j i : ℕ) :
    originalTorDegreePiece K hs d hrank j i →ₗ[K] originalKoszulHomology K hs d i :=
  (originalTorProductResolutionIso K hs d i).toLinearEquiv.toLinearMap.comp
    (originalTorDegreePiece K hs d hrank j i).subtype

theorem originalTorHomologyInclusion_filtered (j i : ℕ) :
    Preserves (originalTorFiltration K hs d hrank j i)
      (originalKoszulHomologyFiltration K hs d i)
      (originalTorHomologyInclusion K hs d hrank j i) := by
  intro n x hx
  obtain ⟨x, rfl⟩ := (originalInternalTorEquiv K hs d hrank j i).surjective x
  change (originalTorProductResolutionIso K hs d i).hom
    (originalInternalTorEquiv K hs d hrank j i x).val ∈ _
  rw [originalInternalTorEquiv_resolution]
  exact originalInternalHomologyInclusion_filtered K hs d hrank j i n x
    ((originalInternalTorEquiv_filtered K hs d hrank j i n x).mp hx)

def originalTorGradeInclusion (j i n : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) n →ₗ[K]
      Grade (originalKoszulHomologyFiltration K hs d i) n :=
  gradeMap _ _ (originalTorHomologyInclusion K hs d hrank j i)
    (originalTorHomologyInclusion_filtered K hs d hrank j i) n

theorem originalTorHomologyInclusion_product (j k i l : ℕ)
    (x : originalTorDegreePiece K hs d hrank j i)
    (y : originalTorDegreePiece K hs d hrank k l) :
    originalTorHomologyInclusion K hs d hrank (j + k) (i + l)
        (originalTorInternalProduct K hs d hrank j k i l x y) =
      originalKoszulHomologyProduct K hs d i l
        (originalTorHomologyInclusion K hs d hrank j i x)
        (originalTorHomologyInclusion K hs d hrank k l y) := by
  change (originalTorProductResolutionIso K hs d (i + l)).hom
      (originalTorInternalProduct K hs d hrank j k i l x y).val = _
  rw [originalTorInternalProduct_val, originalTorProduct_resolution]
  rfl

theorem originalTorGradeInclusion_product (j k i l r s : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) r)
    (y : Grade (originalTorFiltration K hs d hrank k l) s) :
    originalTorGradeInclusion K hs d hrank (j + k) (i + l) (r + s)
        (originalTorAssociatedProduct K hs d hrank j k i l r s x y) =
      originalAssociatedHomologyProduct K hs d hrank i l r s
        (originalTorGradeInclusion K hs d hrank j i r x)
        (originalTorGradeInclusion K hs d hrank k l s y) := by
  have h := gradeBilinearProduct_natural_of_lower_defect
    (originalTorFiltration K hs d hrank j i)
    (originalTorFiltration K hs d hrank k l)
    (originalTorFiltration K hs d hrank (j + k) (i + l))
    (originalTorInternalProduct K hs d hrank j k i l)
    (originalTorInternalProduct_filtered K hs d hrank j k i l)
    (originalKoszulHomologyFiltration K hs d i)
    (originalKoszulHomologyFiltration K hs d l)
    (originalKoszulHomologyFiltration K hs d (i + l))
    (originalKoszulHomologyProduct K hs d i l)
    (originalKoszulHomologyProduct_filtered K hs d hrank i l)
    (originalTorHomologyInclusion K hs d hrank j i)
    (originalTorHomologyInclusion K hs d hrank k l)
    (originalTorHomologyInclusion K hs d hrank (j + k) (i + l))
    (originalTorHomologyInclusion_filtered K hs d hrank j i)
    (originalTorHomologyInclusion_filtered K hs d hrank k l)
    (originalTorHomologyInclusion_filtered K hs d hrank (j + k) (i + l))
    (by
      intro r s x y hx hy
      rw [originalTorHomologyInclusion_product, sub_self]
      exact Submodule.zero_mem _) r s x y
  rw [originalAssociatedHomologyProduct_eq_gradeProduct]
  exact h

def originalTorRelativeHomologyGradeEquiv (j i n : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) n ≃ₗ[K]
      Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n :=
  (gradeEquiv _ _ (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i) n).symm.trans
      (gradeEquiv _ _ (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i)
        (equivalenceFiltration_apply K _ _) n).symm

theorem originalTorHomologyInclusion_relative (j i : ℕ)
    (x : originalRelativeInternalHomology K hs d (∅ : Set P) hrank j i) :
    originalTorHomologyInclusion K hs d hrank j i
      (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i
        (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i x)) =
      complexKernelHomologyMap (originalEmptyDegreeInclusion K hs d hrank j) i x := by
  have hc : originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j ≫
      (originalEmptyRelativeTotalComplexIso K hs d).hom =
      originalEmptyDegreeInclusion K hs d hrank j := by
    apply HomologicalComplex.Hom.ext
    funext k
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    change (show Set.powersetCard (Fin d) k →₀ FaceRing K hs from z.val) = z.val
    rfl
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
    ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).hom
      ((originalEmptyRelativeTorIso K hs d i).inv
        ((originalEmptyRelativeTorIso K hs d i).hom
          ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).inv
            (complexKernelHomologyMap
              (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i x))))) = _
  simp only [← ModuleCat.comp_apply, Iso.hom_inv_id, Iso.inv_hom_id, ModuleCat.id_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
      ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv.symm
          (complexKernelHomologyMap
            (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i x))) = _
  rw [LinearEquiv.apply_symm_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i).toLinearMap
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i x) = _
  rw [complexKernelHomologyEquiv_toLinearMap, ← LinearMap.comp_apply,
    ← complexKernelHomologyMap_comp, hc]

theorem originalTorGradeInclusion_relative (j i n : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) n) :
    originalTorGradeInclusion K hs d hrank j i n x =
      originalEmptyAssociatedHomologyInclusion K hs d hrank j i n
        (originalTorRelativeHomologyGradeEquiv K hs d hrank j i n x) := by
  let E := gradeEquiv
    (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
    (originalTorFiltration K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i) n
  let D := gradeEquiv
    (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i)
    (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
    (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i)
    (equivalenceFiltration_apply K
      (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i)
      (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i)) n
  obtain ⟨x, rfl⟩ := E.surjective x
  obtain ⟨x, rfl⟩ := D.surjective x
  change originalTorGradeInclusion K hs d hrank j i n (E (D x)) =
    originalEmptyAssociatedHomologyInclusion K hs d hrank j i n (D.symm (E.symm (E (D x))))
  rw [LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply]
  obtain ⟨z, rfl⟩ := (lowerInLevel
    (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n).mkQ_surjective x
  change Submodule.Quotient.mk
      (p := lowerInLevel (originalKoszulHomologyFiltration K hs d i) n)
      ⟨originalTorHomologyInclusion K hs d hrank j i
        (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i
          (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i z.val)), _⟩ =
    Submodule.Quotient.mk
      (p := lowerInLevel (originalKoszulHomologyFiltration K hs d i) n)
      ⟨complexKernelHomologyMap (originalEmptyDegreeInclusion K hs d hrank j) i z.val, _⟩
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel (originalKoszulHomologyFiltration K hs d i) n))
  exact Subtype.ext (originalTorHomologyInclusion_relative K hs d hrank j i z.val)

/-- This map is the literal homogeneous inclusion on the barycentric side,
after undoing its top-weight coordinate isomorphism. -/
def barycentricBigradedHomologyInclusion (j n i : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i →ₗ[K]
      barycentricGradedKoszulHomology (P := P) K d i n :=
  (barycentricEmptyGradedHomologyInclusion (P := P) K d j i n).comp
    (barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n).symm.toLinearMap

def barycentricBigradedHomologyRetraction (j n i : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i n →ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i :=
  (barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n).toLinearMap.comp
    (barycentricEmptyGradedHomologyRetraction (P := P) K d j i n)

theorem barycentricBigradedHomology_retract_include (j n i : ℕ)
    (x : barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) :
    barycentricBigradedHomologyRetraction K hs d j n i
      (barycentricBigradedHomologyInclusion K hs d j n i x) = x := by
  simp only [barycentricBigradedHomologyRetraction, barycentricBigradedHomologyInclusion,
    LinearMap.comp_apply, LinearEquiv.coe_coe, barycentricEmptyGradedHomology_retract_include,
    LinearEquiv.apply_symm_apply]

theorem barycentricBigradedHomologyInclusion_injective (j n i : ℕ) :
    Function.Injective (barycentricBigradedHomologyInclusion K hs d j n i) := by
  intro x y h
  have h' := congrArg (barycentricBigradedHomologyRetraction K hs d j n i) h
  simpa only [barycentricBigradedHomology_retract_include] using h'

theorem originalTorAssociatedBigraded_inclusion (j i n : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) n) :
    barycentricBigradedHomologyInclusion K hs d j n i
      (originalTorAssociatedBigraded K hs d hrank j i n x) =
      originalAssociatedBarycentricHomology K hs d hrank i n
        (originalTorGradeInclusion K hs d hrank j i n x) := by
  rw [originalTorGradeInclusion_relative]
  change barycentricEmptyGradedHomologyInclusion (P := P) K d j i n
    ((barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n).symm
      ((barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n)
        (relativeInternalAssociatedGradedComparison K hs d (∅ : Set P) (by simp) hrank j i n
          (originalTorRelativeHomologyGradeEquiv K hs d hrank j i n x)))) = _
  rw [LinearEquiv.symm_apply_apply]
  exact relativeAssociatedComparison_inclusion K hs d hrank j i n _

/-- The independent barycentric DGA product, restricted by its actual
internal-degree projection.  The inclusion theorem below verifies that
this projection removes no product term. -/
def barycentricBigradedHomologyProduct (j k i l r s : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j r i →ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) k s l →ₗ[K]
        barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) (j + k) (r + s) (i + l) :=
  ((barycentricGradedKoszulHomologyProduct K d hrank i l r s).compl₁₂
    (barycentricBigradedHomologyInclusion K hs d j r i)
    (barycentricBigradedHomologyInclusion K hs d k s l)).compr₂
      (barycentricBigradedHomologyRetraction K hs d (j + k) (r + s) (i + l))

/-- Multiplicativity for the exact filtration and comparison appearing in
the absolute Theorem 1.2, in every internal, homological, and weight degree. -/
theorem originalTorAssociatedBigraded_multiplicative (j k i l r s : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) r)
    (y : Grade (originalTorFiltration K hs d hrank k l) s) :
    originalTorAssociatedBigraded K hs d hrank (j + k) (i + l) (r + s)
        (originalTorAssociatedProduct K hs d hrank j k i l r s x y) =
      barycentricBigradedHomologyProduct K hs d hrank j k i l r s
        (originalTorAssociatedBigraded K hs d hrank j i r x)
        (originalTorAssociatedBigraded K hs d hrank k l s y) := by
  have h₁ := originalTorAssociatedBigraded_inclusion K hs d hrank (j + k) (i + l) (r + s)
    (originalTorAssociatedProduct K hs d hrank j k i l r s x y)
  have h₂ := congrArg (fun z => originalAssociatedBarycentricHomology K hs d hrank
      (i + l) (r + s) z)
    (originalTorGradeInclusion_product K hs d hrank j k i l r s x y)
  have h₃ := originalAssociatedBarycentricHomology_multiplicative K hs d hrank i l r s
    (originalTorGradeInclusion K hs d hrank j i r x)
    (originalTorGradeInclusion K hs d hrank k l s y)
  have hxy := h₁.trans (h₂.trans h₃)
  have hx := originalTorAssociatedBigraded_inclusion K hs d hrank j i r x
  have hy := originalTorAssociatedBigraded_inclusion K hs d hrank k l s y
  rw [← hx, ← hy] at hxy
  have h := congrArg (barycentricBigradedHomologyRetraction K hs d
    (j + k) (r + s) (i + l)) hxy
  rw [barycentricBigradedHomology_retract_include] at h
  exact h

/-- Faithfulness of the homogeneous barycentric product: its image is the
actual product on the exterior Koszul associated homology. -/
theorem barycentricBigradedHomologyProduct_inclusion (j k i l r s : ℕ)
    (x : barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j r i)
    (y : barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) k s l) :
    barycentricBigradedHomologyInclusion K hs d (j + k) (r + s) (i + l)
        (barycentricBigradedHomologyProduct K hs d hrank j k i l r s x y) =
      barycentricGradedKoszulHomologyProduct K d hrank i l r s
        (barycentricBigradedHomologyInclusion K hs d j r i x)
        (barycentricBigradedHomologyInclusion K hs d k s l y) := by
  let x' := (originalTorAssociatedBigraded K hs d hrank j i r).symm x
  let y' := (originalTorAssociatedBigraded K hs d hrank k l s).symm y
  have hm := originalTorAssociatedBigraded_multiplicative K hs d hrank j k i l r s x' y'
  have h₀ := congrArg (barycentricBigradedHomologyInclusion K hs d
    (j + k) (r + s) (i + l)) hm.symm
  have h₁ := originalTorAssociatedBigraded_inclusion K hs d hrank (j + k) (i + l) (r + s)
    (originalTorAssociatedProduct K hs d hrank j k i l r s x' y')
  have h₂ := congrArg (fun z => originalAssociatedBarycentricHomology K hs d hrank
      (i + l) (r + s) z)
    (originalTorGradeInclusion_product K hs d hrank j k i l r s x' y')
  have h₃ := originalAssociatedBarycentricHomology_multiplicative K hs d hrank i l r s
    (originalTorGradeInclusion K hs d hrank j i r x')
    (originalTorGradeInclusion K hs d hrank k l s y')
  have hxy := h₀.trans (h₁.trans (h₂.trans h₃))
  have hx := originalTorAssociatedBigraded_inclusion K hs d hrank j i r x'
  have hy := originalTorAssociatedBigraded_inclusion K hs d hrank k l s y'
  have h₄ := congrArg₂ (fun z w => barycentricGradedKoszulHomologyProduct K d hrank i l r s z w)
    hx.symm hy.symm
  have hrep := hxy.trans h₄
  have hx' : originalTorAssociatedBigraded K hs d hrank j i r x' = x :=
    (originalTorAssociatedBigraded K hs d hrank j i r).apply_symm_apply x
  have hy' : originalTorAssociatedBigraded K hs d hrank k l s y' = y :=
    (originalTorAssociatedBigraded K hs d hrank k l s).apply_symm_apply y
  have hin := congrArg₂ (fun z w => barycentricBigradedHomologyInclusion K hs d
      (j + k) (r + s) (i + l) (barycentricBigradedHomologyProduct K hs d hrank j k i l r s z w))
    hx' hy'
  have hout := congrArg₂ (fun z w => barycentricGradedKoszulHomologyProduct K d hrank i l r s
      (barycentricBigradedHomologyInclusion K hs d j r i z)
      (barycentricBigradedHomologyInclusion K hs d k s l w)) hx' hy'
  exact hin.symm.trans (hrep.trans hout)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.PaperTorMultiplication -/
section

open scoped DirectSum
/-! # The multiplicative clause of Theorem 1.2

The product on the cohomology direct sum is the one induced by the
barycentric coefficient Koszul DGA under the signed colorful cochain
comparison.  This is the product relevant to the paper's associated-Tor
claim.  Both products below are constructed before invoking the original
face-ring comparison, and their equality is proved for all finite sums.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology

section GradedProducts
variable {K : Type*} [CommRing K]
variable {A B C : ℕ → Type*} [∀ n, AddCommGroup (A n)] [∀ n, Module K (A n)]
  [∀ n, AddCommGroup (B n)] [∀ n, Module K (B n)]
  [∀ n, AddCommGroup (C n)] [∀ n, Module K (C n)]

/-- Extend homogeneous bilinear products by the universal property of the
direct sum.  Its value is a finite sum of the original products. -/
def gradedDirectSumProduct (p : ∀ r s, A r →ₗ[K] B s →ₗ[K] C (r + s)) :
    (⨁ r, A r) →ₗ[K] (⨁ s, B s) →ₗ[K] (⨁ n, C n) :=
  DirectSum.toModule K ℕ ((⨁ s, B s) →ₗ[K] (⨁ n, C n)) (fun r =>
    (DirectSum.toModule K ℕ (A r →ₗ[K] (⨁ n, C n)) (fun s =>
      ((p r s).compr₂ (DirectSum.lof K ℕ C (r + s))).flip)).flip)

@[simp] theorem gradedDirectSumProduct_lof
    (p : ∀ r s, A r →ₗ[K] B s →ₗ[K] C (r + s)) (r s : ℕ) (x : A r) (y : B s) :
    gradedDirectSumProduct p (DirectSum.lof K ℕ A r x) (DirectSum.lof K ℕ B s y) =
      DirectSum.lof K ℕ C (r + s) (p r s x y) := by
  simp only [gradedDirectSumProduct, DirectSum.toModule_lof, LinearMap.flip_apply,
    LinearMap.compr₂_apply]

variable {A' B' C' : ℕ → Type*} [∀ n, AddCommGroup (A' n)] [∀ n, Module K (A' n)]
  [∀ n, AddCommGroup (B' n)] [∀ n, Module K (B' n)]
  [∀ n, AddCommGroup (C' n)] [∀ n, Module K (C' n)]

theorem gradedDirectSumProduct_natural
    (p : ∀ r s, A r →ₗ[K] B s →ₗ[K] C (r + s))
    (q : ∀ r s, A' r →ₗ[K] B' s →ₗ[K] C' (r + s))
    (a : ∀ r, A r →ₗ[K] A' r) (b : ∀ s, B s →ₗ[K] B' s) (c : ∀ n, C n →ₗ[K] C' n)
    (h : ∀ r s x y, c (r + s) (p r s x y) = q r s (a r x) (b s y))
    (x : ⨁ r, A r) (y : ⨁ s, B s) :
    DirectSum.lmap c (gradedDirectSumProduct p x y) =
      gradedDirectSumProduct q (DirectSum.lmap a x) (DirectSum.lmap b y) := by
  have heq : (gradedDirectSumProduct p).compr₂ (DirectSum.lmap c) =
      (gradedDirectSumProduct q).compl₁₂ (DirectSum.lmap a) (DirectSum.lmap b) := by
    apply DirectSum.linearMap_ext
    intro r
    apply LinearMap.ext
    intro xr
    apply DirectSum.linearMap_ext
    intro s
    apply LinearMap.ext
    intro ys
    simpa only [LinearMap.comp_apply, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
      gradedDirectSumProduct_lof, DirectSum.lmap_lof] using
      congrArg (DirectSum.lof K ℕ C' (r + s)) (h r s xr ys)
  exact LinearMap.congr_fun (LinearMap.congr_fun heq x) y
end GradedProducts

universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def originalTorAssociatedGradedProduct (j k i l : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i →ₗ[K]
      originalTorAssociatedGraded K hs d hrank k l →ₗ[K]
        originalTorAssociatedGraded K hs d hrank (j + k) (i + l) :=
  gradedDirectSumProduct (originalTorAssociatedProduct K hs d hrank j k i l)

def barycentricBigradedSumProduct (j k i l : ℕ) :
    (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) →ₗ[K]
      (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) k n l) →ₗ[K]
        (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) (j + k) n (i + l)) :=
  gradedDirectSumProduct (barycentricBigradedHomologyProduct K hs d hrank j k i l)

theorem originalTorAssociatedBigradedSum_multiplicative (j k i l : ℕ)
    (x : originalTorAssociatedGraded K hs d hrank j i)
    (y : originalTorAssociatedGraded K hs d hrank k l) :
    originalTorAssociatedBigradedSum K hs d hrank (j + k) (i + l)
        (originalTorAssociatedGradedProduct K hs d hrank j k i l x y) =
      barycentricBigradedSumProduct K hs d hrank j k i l
        (originalTorAssociatedBigradedSum K hs d hrank j i x)
        (originalTorAssociatedBigradedSum K hs d hrank k l y) := by
  simpa only [originalTorAssociatedBigradedSum, DirectSum.coe_congrLinearEquiv,
    originalTorAssociatedGradedProduct, barycentricBigradedSumProduct] using
    gradedDirectSumProduct_natural
      (originalTorAssociatedProduct K hs d hrank j k i l)
      (barycentricBigradedHomologyProduct K hs d hrank j k i l)
      (fun n => (originalTorAssociatedBigraded K hs d hrank j i n).toLinearMap)
      (fun n => (originalTorAssociatedBigraded K hs d hrank k l n).toLinearMap)
      (fun n => (originalTorAssociatedBigraded K hs d hrank (j + k) (i + l) n).toLinearMap)
      (originalTorAssociatedBigraded_multiplicative K hs d hrank j k i l) x y

/-- The colorful cochain comparison, including the passage to ordinary
absolute augmented cohomology and the elimination of the weight index.
This is defined on the barycentric side, independently of original Tor. -/
def barycentricBigradedCohomologySumEquiv (j i : ℕ) :
    (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedCohomology K hs d hrank S.val i) :=
  (gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i)
    (fun n => barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i)
    (fun n => barycentricRelativeBigradedCohomologyEquiv K hs d hrank (∅ : Set P) (by simp) j n i)).trans
      ((DirectSum.linearEquivFunOnFintype K _ _).symm.trans
        (DirectSum.congrLinearEquiv (fun S =>
          (rankSelectedEmptyRelativeIso K hs d hrank S.val i).toLinearEquiv)))

theorem theorem_1_2_factor (j i : ℕ) (x : originalTorAssociatedGraded K hs d hrank j i) :
    theorem_1_2 K hs d hrank j i x =
      barycentricBigradedCohomologySumEquiv K hs d hrank j i
        (originalTorAssociatedBigradedSum K hs d hrank j i x) := by
  apply DFinsupp.ext
  intro S
  change (rankSelectedEmptyRelativeIso K hs d hrank S.val i).hom
      (originalTorRankSelectedEquiv K hs d hrank j i x S) =
    (rankSelectedEmptyRelativeIso K hs d hrank S.val i).hom
      (gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
        (fun S => rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i)
        (fun n => barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i)
        (fun n => barycentricRelativeBigradedCohomologyEquiv K hs d hrank
          (∅ : Set P) (by simp) j n i)
        (originalTorAssociatedBigradedSum K hs d hrank j i x) S)
  simp only [originalTorRankSelectedEquiv, gradedSumConditionEquiv_apply,
    LinearEquiv.trans_apply]
  rfl

/-- The cohomology product induced by the barycentric Koszul DGA and the
explicit colorful cochain isomorphism.  No map from original Tor is used
to define it. -/
def rankSelectedCohomologyProduct (j k i l : ℕ) :
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
      rankSelectedCohomology K hs d hrank S.val i) →ₗ[K]
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = k},
      rankSelectedCohomology K hs d hrank S.val l) →ₗ[K]
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j + k},
      rankSelectedCohomology K hs d hrank S.val (i + l)) :=
  ((barycentricBigradedSumProduct K hs d hrank j k i l).compl₁₂
    (barycentricBigradedCohomologySumEquiv K hs d hrank j i).symm.toLinearMap
    (barycentricBigradedCohomologySumEquiv K hs d hrank k l).symm.toLinearMap).compr₂
      (barycentricBigradedCohomologySumEquiv K hs d hrank (j + k) (i + l)).toLinearMap

/-- **Theorem 1.2, multiplicativity.** The same displayed isomorphism,
on the complete associated graded of ordinary Tor, preserves the products
induced by the actual exterior Koszul DGA. -/
theorem theorem_1_2_multiplicative (j k i l : ℕ)
    (x : originalTorAssociatedGraded K hs d hrank j i)
    (y : originalTorAssociatedGraded K hs d hrank k l) :
    theorem_1_2 K hs d hrank (j + k) (i + l)
        (originalTorAssociatedGradedProduct K hs d hrank j k i l x y) =
      rankSelectedCohomologyProduct K hs d hrank j k i l
        (theorem_1_2 K hs d hrank j i x)
        (theorem_1_2 K hs d hrank k l y) := by
  have h₁ := theorem_1_2_factor K hs d hrank (j + k) (i + l)
    (originalTorAssociatedGradedProduct K hs d hrank j k i l x y)
  have h₂ := congrArg (fun z => barycentricBigradedCohomologySumEquiv K hs d hrank
      (j + k) (i + l) z)
    (originalTorAssociatedBigradedSum_multiplicative K hs d hrank j k i l x y)
  have hx₀ := congrArg (fun z => (barycentricBigradedCohomologySumEquiv K hs d hrank j i).symm z)
    (theorem_1_2_factor K hs d hrank j i x)
  have hx := hx₀.trans ((barycentricBigradedCohomologySumEquiv K hs d hrank j i).symm_apply_apply
    (originalTorAssociatedBigradedSum K hs d hrank j i x))
  have hy₀ := congrArg (fun z => (barycentricBigradedCohomologySumEquiv K hs d hrank k l).symm z)
    (theorem_1_2_factor K hs d hrank k l y)
  have hy := hy₀.trans ((barycentricBigradedCohomologySumEquiv K hs d hrank k l).symm_apply_apply
    (originalTorAssociatedBigradedSum K hs d hrank k l y))
  have hp := congrArg₂ (fun z w => barycentricBigradedSumProduct K hs d hrank j k i l z w) hx hy
  have h₃ := congrArg (fun z => barycentricBigradedCohomologySumEquiv K hs d hrank
    (j + k) (i + l) z) hp
  exact (h₁.trans h₂).trans h₃.symm

end FourPapers.Universal

end
end

