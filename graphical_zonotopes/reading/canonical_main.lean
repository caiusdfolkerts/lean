        -(eta s*((-1 : ℝ)^(C.1.card-3)))= -1 := by
      rcases eta_sign s with h1 | h1 <;>
        rcases neg_one_pow_eq_or ℝ (C.1.card-3) with h2 | h2 <;> simp [h1,h2]
