def edgeFinsetFamilyEquiv (G : SimpleGraph V) : ↥G.edgeFinset ≃ ↥(edgeFamily G) :=
  Equiv.ofBijective (fun e => ⟨e.1.toFinset,by
    rw [edgeFamily_eq_image_edgeFinset]
    exact mem_image.mpr ⟨e.1,e.2,rfl⟩⟩) (by
    constructor
