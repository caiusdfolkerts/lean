    intro x
    have hp := (SimpleGraph.reachable_iff_reflTransGen (G:=G) a x).mp (hG a x)
    induction hp with
    | refl => exact Or.inl rfl
    | @tail y z hp hyz ih =>
      rcases ih with hy | hy
