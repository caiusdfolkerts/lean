  unfold boundary assembled
  have hz : IntegerValued (pair (0 : ℝ) 0 1) := by simpa using pair_integer 0 0 1
  apply (boundaryLift_integerValued hz).add
  apply IntegerValued.finset_sum
  intro i hi
