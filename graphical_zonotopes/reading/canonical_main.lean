theorem six_vertex_obstruction_graph (G : SimpleGraph (Fin 6)) [DecidableRel G.Adj]
    (h₃ : G.IsClique ({0,1,2,3} : Finset (Fin 6)))
    (h₄ : G.IsClique ({0,1,2,4} : Finset (Fin 6)))
