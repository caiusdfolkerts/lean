  rw [graphFunction, delta_sum]
  have hrow : ∀ C ∈ edgeFamily G,
      delta (setMonomial C) u v S = if C = {u,v} then 1 else 0 := by
    intro C hC
    rw [delta_setMonomial huv hu hv]
    by_cases he : C = {u,v}
    · subst C
      simp
    · have hpair : ¬(u ∈ C ∧ v ∈ C) := by
        rintro ⟨huC,hvC⟩
        apply he
        apply Eq.symm
        apply Finset.eq_of_subset_of_card_le
        · intro w hw
