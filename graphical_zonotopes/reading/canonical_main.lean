  simp only [Pi.add_apply, Pi.sub_apply]
  rw [sum_single_window hT0 (by simp) hT (by
    intro j k hk; simp only [mem_insert, mem_singleton] at hk; omega)]
  rw [sum_single_window hT0 (by simp) hT (by
    intro j k hk; simp only [mem_insert, mem_singleton] at hk; omega)]
  rw [sum_single_window hT0 (by simp) hT (by
    intro j k hk; simp only [mem_insert, mem_singleton] at hk; omega)]

