      (subtree T U).maxDegree≤3 := by
  rw [←map_induced]
  constructor
  · intro h
    exact (admissible_iff_maxDegree (hT.induce _)).mp (Admissible.of_map (inclusion U) h)
  · intro h
    exact ((admissible_iff_maxDegree (hT.induce _)).mpr h).map (inclusion U)

