  simpa only [Pi.smul_apply,smul_eq_mul,mul_one] using hc j

theorem unit_integral_lift {blocks : Finset (Finset H)}
    (hb : ComplementFamily (univ : Finset H) blocks) (hs : 3≤ Fintype.card H)
