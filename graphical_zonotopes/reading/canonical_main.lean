including every subset of size at least two. -/
def centralCoefficientSlack : (CliqueIndex (⊤ : SimpleGraph H) → ℝ) →ₗ[ℝ]
    (HubResponseRow H → ℝ) :=
  centralSlack ∘ₗ (graphicalCoordinatesEquiv ⊤).toLinearMap

