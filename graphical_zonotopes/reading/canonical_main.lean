  univ.image (block p hsize)

theorem blocks_nonempty {s : ℕ} (hsize : (∑ i,p i)≤ s) (hpos : ∀ i,0< p i) :
    ∀ B∈blocks p hsize,B.Nonempty := by
  intro B hB
  obtain ⟨i,_,rfl⟩:=mem_image.mp hB
  exact block_nonempty p hsize hpos i

