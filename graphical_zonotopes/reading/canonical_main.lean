    have h := total_update a i (a i-1)
    dsimp only [b]
    omega
  have hbi : b i=a i-1 := by simp [b]
  have hb : Balanced b := by
    constructor
    · intro j
      by_cases hji : j=i
      · subst j;rw [hbi];omega
      · simpa [b,update_of_ne hji] using ha.1 j
    · intro j
      by_cases hji : j=i
