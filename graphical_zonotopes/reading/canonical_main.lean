    have hv := congrFun hc d.1
    rw [Fintype.sum_sum_type] at hv
    simp only [Pi.add_apply,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,
      hbase,zero_mul,sum_const_zero,zero_add,pivotColumns,Pi.zero_apply] at hv
