    intro i
    rw [window_card _ (by intro k hk; simp only [mem_insert, mem_singleton] at hk; omega)]
    norm_num
  have hc023 : ∀ i : Fin (n-3), (window n i.val {0,2,3}).card = 3 := by
    intro i
    rw [window_card _ (by intro k hk; simp only [mem_insert, mem_singleton] at hk; omega)]
    norm_num
  have hc0123 : ∀ i : Fin (n-3), (window n i.val {0,1,2,3}).card = 4 := by
    intro i
    rw [window_card _ (by intro k hk; simp only [mem_insert, mem_singleton] at hk; omega)]
    norm_num
