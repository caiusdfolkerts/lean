  intro i
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← delta_row013, zeta_mobius]
    apply hz _ _ (by simp [vertex, Fin.ext_iff]) _
      (by simp [vertex, Fin.ext_iff]) (by simp [vertex, Fin.ext_iff])
    rw [setFunction, delta_row013, he]
