  obtain ⟨f,hn,hi,he,hG,hd,hb⟩ := h
  exact ⟨f,hn,hi,he,hG,hd,fun u v huv S hu hv =>
    (hb u v huv S hu hv).trans (by exact_mod_cast hMN)⟩

