  · rintro ⟨v,huv⟩
    obtain ⟨i,j,hij,hu,hv⟩ := (product_unionGraph_adj_iff hne hdis hprod u v).mp huv
    exact mem_biUnion.mpr ⟨i,mem_univ _,hu⟩
