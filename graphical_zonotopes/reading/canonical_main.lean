        apply subset_antisymm hc
        intro x hx
        simp only [mem_insert, mem_singleton] at hx
        rcases hx with rfl | rfl | rfl | rfl <;> assumption
      · right; left
        apply subset_antisymm
        · intro x hx
          have hm := hc hx
