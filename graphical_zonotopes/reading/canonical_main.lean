    (i j : Fin 4) (hij : i≠ j) : a i+a j+2≤ total a := by
  have h0 := ha 0
  have h1 := ha 1
  have h2 := ha 2
  have h3 := ha 3
  fin_cases i <;> fin_cases j <;> simp [total,Fin.sum_univ_succ] at hij ⊢ <;> omega

theorem eq_one_of_total_four {a : Fin 4 → ℕ} (ha : ∀ i,0< a i)
