  rcases vertex_cases x with rfl|rfl|⟨u,rfl⟩ <;>
    rcases vertex_cases y with rfl|rfl|⟨v,rfl⟩ <;>
    simp [graph,SingleVertexGraph.graph,inclusion,old,a,b,subtree]

