    simp only [refine,mem_insert,mem_erase] at hD
    rcases hD with h|h|h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr ⟨h.2,h.1⟩)
  obtain ⟨D,hD,huniq⟩:=hF Y
