    simp [Ne.symm hac, Ne.symm hbc] at hc
  have hacd : ({a,b,c} : Finset V) ≠ {a,b,d} := by
    intro h; have hc : c ∈ ({a,b,d} : Finset V) := by rw [← h]; simp
    simp [Ne.symm hac, Ne.symm hbc, hcd] at hc
