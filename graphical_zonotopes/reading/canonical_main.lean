    have hy : y s=x s-(∑ T∈(univ : Finset (SubsetIndex B)).erase s,
        if T.1⊆S then y T else 0) := by linarith
    rw [hy]
    exact K.sub_mem (hx s) hsum
  intro S
  exact hmem S.1 (mem_powerset.mp S.2)

