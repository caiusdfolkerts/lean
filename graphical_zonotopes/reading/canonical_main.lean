triangles intersect inside the middle four-element set. -/
theorem tetrahedra_path_shared_pair {A B C : Finset V} (hB : B.card=4)
    (hAB : 3≤(A∩B).card) (hBC : 3≤(B∩C).card) :
    ∃ e : Finset V,e.card=2 ∧ e⊆A ∧ e⊆B ∧ e⊆C := by
