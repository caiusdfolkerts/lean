    simp [junctionStar,hi,Ne.symm hi]

theorem junctionStar_negativeResponse (hs : 2≤ Fintype.card H) (a : H)
    {u v : H} (huv : u≠ v) (S : Finset H) (hu : u∉S) (hv : v∉S) :
