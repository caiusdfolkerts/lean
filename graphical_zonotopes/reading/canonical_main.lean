          · exact Or.inr (Or.inl hxb)
          · exact Or.inr (Or.inr hxc)
          · exact False.elim (hdc (hxd ▸ hx))
        · intro x hx
          simp only [mem_insert, mem_singleton] at hx
          rcases hx with rfl | rfl | rfl <;> assumption
