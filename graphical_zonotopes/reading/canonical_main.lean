theorem generalizedPermutahedron_exposed_edge_is_root
    {V : Type*} [Fintype V] [DecidableEq V] {Q : Set (V → ℝ)}
    (hQ : IsGeneralizedPermutahedron Q) {p q : V → ℝ}
    (hex : IsExposedSegment Q p q) :
