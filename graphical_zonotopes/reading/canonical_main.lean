    intro r t hrt
    have hc := congrArg (fun C : CliqueIndex (⊤ : SimpleGraph H) => C.1.card) hrt
    have hr := rowClique_card_eq_context_add_two r
    have ht := rowClique_card_eq_context_add_two t
