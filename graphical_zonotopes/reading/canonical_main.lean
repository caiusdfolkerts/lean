    apply h.meet (e i) (e j) (e k) (e l)
      (fun h' => hij (e.injective h')) (fun h' => hkl (e.injective h'))
    · intro he
      exact hne (Prod.ext (e.injective (congrArg Prod.fst he))
        (e.injective (congrArg Prod.snd he)))
