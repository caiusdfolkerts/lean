    have hxy:=hS.1 x.2 y.2 (fun h => hne (Subtype.ext h))
    exact hxy he
  have hc:=Fintype.card_le_of_injective (fun v : S => v.1.1) hinj
  simp only [Fintype.card_coe,Fintype.card_fin] at hc
  rw [hS.2] at hc
  omega

