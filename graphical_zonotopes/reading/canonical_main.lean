theorem assembled_actual_summand {s k : ℕ} {z : SetFunction (Fin s)}
    (hz : TranslationNormalized z) {F : Fin k → SetFunction (Fin s)}
    (hF : ∀ j,IsMonotoneBoolean (F j)) {w : Fin k → ℝ}
