      ext x
      constructor
      · rintro ⟨⟨y,hy,rfl⟩,he⟩
        refine ⟨y,⟨hy,?_⟩,rfl⟩
        change ℓ (t+y)=ℓ t+a at he
        rw [map_add] at he
        exact add_left_cancel he
      · rintro ⟨y,⟨hy,he⟩,rfl⟩
        refine ⟨⟨y,hy,rfl⟩,?_⟩
        change ℓ (t+y)=ℓ t+a
