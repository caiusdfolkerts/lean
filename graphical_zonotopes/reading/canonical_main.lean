  induction n with
  | zero => norm_num
  | succ n ih =>
    have hc : (n+1).choose 2=n.choose 2+n := by
      simpa only [Nat.choose_one_right, Nat.add_comm] using Nat.choose_succ_succ' n 1
    rw [hc]
