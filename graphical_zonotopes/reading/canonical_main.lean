    {C : Finset (I×Fin 2)} (hC : (graph I).IsClique C) :
    (fun uv => delta (setMonomial C) u v
      (edgeContext u v (coordinateChange.symm uv)))∈tensorSpace := by
  by_cases hu : u∈C
  · by_cases hv : v∈C
