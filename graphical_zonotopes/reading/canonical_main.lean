@[simp] theorem restrict_add (e : W ↪ V) (f g : SetFunction V) :
    restrict e (f+g)=restrict e f+restrict e g := rfl

@[simp] theorem restrict_sub (e : W ↪ V) (f g : SetFunction V) :
