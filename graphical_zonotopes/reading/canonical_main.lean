theorem anchorWeights_positive (hs : 3≤ s) (a : BookAnchor hs) : 0< anchorWeights hs a := by
  have h := (mem_erase.mp a.2).1
  have hv : a.1.val≠0 := fun he => h (Fin.ext he)
