    apply Subtype.ext
    apply Prod.ext
    · rfl
    · ext j k
      simp [assemble,add_smul]
  map_smul' a x := by
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · ext j k
      simp [assemble,smul_smul,mul_assoc]

theorem activeCapacityEmbedding_injective :
