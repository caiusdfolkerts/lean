      ∑ C : {C : BookBlock (Fin s) // C≠ fullBlock hs},f C.1 := by
  have h := (Equiv.optionSubtypeNe (fullBlock hs)).sum_comp f
  rw [Fintype.sum_option] at h
  exact h.symm

