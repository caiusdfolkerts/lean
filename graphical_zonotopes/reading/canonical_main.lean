    have he : r.1=e.1 ↔ r.1.1.1=e.1.1.1 ∧ r.1.1.2=e.1.1.2 := by
      constructor
      · intro h
        exact ⟨congrArg (fun q : OrientedEdge (⊤ : SimpleGraph H) => q.1.1) h,
