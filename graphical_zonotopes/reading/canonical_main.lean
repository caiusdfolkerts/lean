def remainingEmbedding (u v : I×Fin 2) : Remaining u v × Fin 2 ↪ I×Fin 2 where
  toFun w := (w.1.1,w.2)
  inj' := by
    rintro ⟨i,a⟩ ⟨j,b⟩ h
    apply Prod.ext
    · exact Subtype.ext (congrArg Prod.fst h)
    · exact congrArg (fun z : I × Fin 2 => z.2) h

