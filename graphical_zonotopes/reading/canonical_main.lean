theorem junctionStar_response_class (hs : 2≤ Fintype.card H) (a : H) :
    responseClass (junctionStar a)= -responseClass (thresholdStar a) := by
  let x : HubResponseRow H → ℝ := fun r => exactlyOneCoefficient r.2.1.card
