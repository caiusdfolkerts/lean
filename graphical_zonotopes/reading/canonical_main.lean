  intro Q hQ hi hd hw
  obtain ⟨hsub,hh,hsp⟩ := actual_hub_spoke_lower hs hQ hi hd hw
  exact ⟨direction_lower hs hQ hi hd hw,fun _ => hh,hsp⟩

