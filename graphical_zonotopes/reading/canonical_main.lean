    (hC : IsPartialTransversal C) : IsPartialTransversal (remainingPart u v C) := by
  intro i hi
  exact hC i.1 ⟨(mem_remainingPart _ _ _ _).mp hi.1,(mem_remainingPart _ _ _ _).mp hi.2⟩

