  intro r hr
  have h4 : 4≤ Fintype.card (Fin r) := by simpa using hr
  have h3 : 3≤ Fintype.card (Fin r) := by simpa using (show 3≤ r by omega)
  have hgraph : graph (Fin r)=doubledPartGraph r := rfl
