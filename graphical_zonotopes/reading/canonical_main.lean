    (mem_quotientRelation_ker_iff _ _).mpr (unit_integrable hb hs hproper)
  simpa only [Int.cast_one] using integral_compatible_lift
    (modules blocks) (modules_boolean hb hs) (fun _ => (1 : ℤ))
