    let t : SubsetIndex B:=⟨T,mem_powerset.mpr
      ((mem_powerset.mp hT).trans (mem_powerset.mp S.2))⟩
    exact ⟨t,mem_filter.mpr ⟨mem_univ t,mem_powerset.mp hT⟩,rfl⟩
