  by_cases h : eta s=1
  · simp only [h,ite_true,one_smul]
  · have he : eta s= -1 := (eta_sign s).resolve_left h
    rw [if_neg h,junctionStar_response_class (by simpa using (show 2≤ s by omega)),he,neg_one_smul]

