    apply mem_filter.mpr
    refine ⟨mem_univ _,by simp,?_,?_⟩
    · exact singleton_subset_iff.mpr hC₀
    · simp [hfour C₀ hC₀]
  obtain ⟨A,hA,hmax⟩ := candidates.exists_max_image Finset.card ⟨{C₀},hbase⟩
  obtain ⟨hC₀A,hAF,hcard⟩ := (mem_filter.mp hA).2
