  rw [card_union_of_disjoint hd,
    card_image_of_injective _ (fun _ _ h => congrArg Prod.fst h),
    card_image_of_injective _ (fun _ _ h => congrArg Prod.fst h)]

/-- Pairs internal to one doubled part. -/
def internalPairFunction : SetFunction (I×Fin 2) :=
  ∑ i : I,setMonomial {(i,0),(i,1)}

