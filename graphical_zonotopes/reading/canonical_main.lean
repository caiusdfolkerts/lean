    IsExposedSegment (t+ᵥQ) (t+p) (t+q) := by
  obtain ⟨hpq,ℓ,a,hbound,hface⟩ := h
  refine ⟨fun he => hpq (add_left_cancel he),ℓ,ℓ t+a,?_,?_⟩
  · rintro x ⟨y,hy,rfl⟩
    change ℓ t+a ≤ ℓ (t+y)
