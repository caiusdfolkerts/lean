  constructor
  · intro h
    exact ⟨fun i hi => (mem_subsetOfBits_zero s i).mp (h hi),
      fun i hi => (mem_subsetOfBits_one s i).mp (h hi)⟩
  · rintro ⟨h0,h1⟩ ⟨i,b⟩ hi
    fin_cases b
    · exact (mem_subsetOfBits_zero s i).mpr (h0 i hi)
    · exact (mem_subsetOfBits_one s i).mpr (h1 i hi)

