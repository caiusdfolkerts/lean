  refine ⟨integerCoefficient n s,?_⟩
  rcases s with u | ⟨r,i⟩ | ⟨r,j⟩
  · change (((n+2)/2 : ℕ) : ℝ)=((((n+2)/2 : ℕ) : ℤ) : ℝ)
    rw [Int.cast_natCast]
  · dsimp only [coefficient,integerCoefficient]
    split_ifs <;> norm_num
  · dsimp only [coefficient,integerCoefficient]
    split_ifs <;> norm_num

