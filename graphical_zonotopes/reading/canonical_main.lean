theorem conjunction_boolean {H : Type*} [Fintype H] [DecidableEq H] [Nonempty H] :
    IsMonotoneBoolean (setMonomial (univ : Finset H)) := by
  refine ⟨?_,?_,?_,?_⟩
  · intro A B hAB
