  have h := integerData_count_identity (univ : Finset (I×Fin 2))
  simp only [firstSet_univ,secondSet_univ,inter_self,card_univ,Fintype.card_prod,
    Fintype.card_fin] at h
  have hc := two_choose_two_int (Fintype.card I*2)
