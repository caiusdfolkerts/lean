      · exact book_lattice_four_bridge (by omega) hcap'
    by_cases hsEq5 : s=5
    · subst s
      have hcap' : k≤55 := by simpa [cliqueCapacity,Nat.choose] using hcap
      have hk11 : 11≤ k := by norm_num [Nat.choose] at hsmall; omega
      by_cases hkEq11 : k=11
