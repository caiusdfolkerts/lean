  · rintro ⟨u,v,huv,rfl,rfl⟩
    exact ⟨(inclusion_adj T U u v).mp huv,inclusion_mem_core U u,inclusion_mem_core U v⟩
  · rintro ⟨hxy,hx,hy⟩
    obtain ⟨u,rfl⟩ := mem_core_range U hx
    obtain ⟨v,rfl⟩ := mem_core_range U hy
