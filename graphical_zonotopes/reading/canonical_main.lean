    ∀ k,1≤ k → k≤ A.card →
      ∃ Q : Finpartition A,Q.parts.card=k ∧ ∀ B∈Q.parts,P B := by
  intro k
  induction k with
  | zero => intro hk; omega
  | succ k ih =>
    intro hk hkA
    by_cases hk0 : k=0
    · subst k
      refine ⟨Finpartition.indiscrete hA.ne_empty,?_,?_⟩
      · rfl
