    (hPΩ : P 0 2 \ {x 0, x 2} ⊆ Ω) (hx4 : x 4 ∈ Ω) : False := by
  have hR := h.two_arc (i := 1) (j := 4) (k := 3) (by decide) (by decide) (by decide)
