    letI : LinearOrder W := Separator.finiteVertexOrder W;
    ∀ G : SimpleGraph W,HasPlaneDrawing G →
      (sSup {d : ℕ | ∃ Q : Set (W → ℝ),IsFinitePolytope Q ∧
