theorem maximum_dimension_upper_symmetric (p b : ℕ) :
    maximumIndecomposableDimension (twoSingletonGraph p b)≤
      min (p+b+1) (2^(min p b)+2*min p b+1) := by
  by_cases hpb : p≤ b
