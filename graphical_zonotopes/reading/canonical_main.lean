    (inducedOn (graph n) (vertexPrefix n k)).IsClique (attachmentTriangle n k hk) := by
  intro u hu v hv huv
  refine ⟨?_,attachmentTriangle_subset hk0 hk hu,attachmentTriangle_subset hk0 hk hv⟩
