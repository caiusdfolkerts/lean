/-!
# Cycles in a finite signed tensor product

The tensor homotopy identities work over every commutative ring when actual
odd generalized inverses are supplied.  The final field specialization
constructs such inverses. No Künneth isomorphism or assertion about
tensor-product homology is assumed.
-/

noncomputable section
namespace FourPapers.TensorCycleSpanning
open scoped TensorProduct
open Classical

section FieldInverse
variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

theorem exists_generalizedInverse (d : Module.End K V) :
    ∃ h : Module.End K V, d * h * d = d := by
  obtain ⟨g, hg⟩ := d.rangeRestrict.exists_rightInverse_of_surjective
    d.range_rangeRestrict
  obtain ⟨h, hh⟩ := g.exists_extend
  refine ⟨h, ?_⟩
  apply LinearMap.ext
  intro x
  change d (h (d x)) = d x
  have he := LinearMap.congr_fun hh (d.rangeRestrict x)
  have hs := LinearMap.congr_fun hg (d.rangeRestrict x)
  exact (congrArg d he).trans (congrArg Subtype.val hs)

/-- An odd generalized inverse exists also in characteristic two. In that
characteristic the parity involution of an actual graded vector space is the
identity; this genuine condition is stated explicitly. -/
theorem exists_odd_generalizedInverse (d s : Module.End K V)
    (hs : s * s = 1) (hds : d * s = -(s * d))
    (hchar : (2 : K) = 0 → s = 1) :
    ∃ h : Module.End K V, d * h * d = d ∧ s * h + h * s = 0 := by
  obtain ⟨h₀, hh₀⟩ := exists_generalizedInverse d
  by_cases htwo : (2 : K) = 0
  · refine ⟨h₀, hh₀, ?_⟩
    rw [hchar htwo, one_mul, mul_one]
    calc h₀ + h₀ = (2 : K) • h₀ := (two_smul K h₀).symm
      _ = 0 := by rw [htwo, zero_smul]
  · have hsd : s * d = -(d * s) := by rw [hds]; simp
    have hsds : s * d * s = -d := by
      calc s * d * s = s * (d * s) := mul_assoc _ _ _
        _ = s * (-(s * d)) := congrArg (s * ·) hds
        _ = -(s * s) * d := by noncomm_ring
        _ = -d := by rw [hs]; simp
    have hconj : (d * s) * h₀ * (s * d) = s * (d * h₀ * d) * s := by
      calc (d * s) * h₀ * (s * d) = (-(s * d)) * h₀ * (s * d) :=
          congrArg (fun z => z * h₀ * (s * d)) hds
        _ = -(s * (d * h₀) * (s * d)) := by noncomm_ring
        _ = -(s * (d * h₀) * (-(d * s))) :=
          congrArg (fun z => -(s * (d * h₀) * z)) hsd
        _ = s * (d * h₀ * d) * s := by noncomm_ring
    have hdodd : d * (h₀ - s * h₀ * s) * d = (2 : K) • d := by
      calc d * (h₀ - s * h₀ * s) * d = d * h₀ * d - (d * s) * h₀ * (s * d) :=
          by noncomm_ring
        _ = d - s * d * s := by rw [hconj, hh₀]
        _ = (2 : K) • d := by rw [hsds]; simp [two_smul]
    have hodd : s * (h₀ - s * h₀ * s) + (h₀ - s * h₀ * s) * s = 0 := by
      calc s * (h₀ - s * h₀ * s) + (h₀ - s * h₀ * s) * s =
          s * h₀ - (s * s) * h₀ * s + h₀ * s - s * h₀ * (s * s) := by noncomm_ring
        _ = 0 := by rw [hs]; simp only [one_mul, mul_one]; abel
    refine ⟨(2 : K)⁻¹ • (h₀ - s * h₀ * s), ?_, ?_⟩
    · rw [mul_smul_comm, smul_mul_assoc, hdodd, smul_smul,
        inv_mul_cancel₀ htwo, one_smul]
    · rw [mul_smul_comm, smul_mul_assoc, ← smul_add, hodd, smul_zero]

end FieldInverse

section Ring
variable {K V : Type*} [CommRing K] [AddCommGroup V] [Module K V]

section FiniteTensor
variable {m : ℕ} {M : Fin m → Type*}
  [∀ p, AddCommGroup (M p)] [∀ p, Module K (M p)]

def factor (d s : ∀ p, Module.End K (M p)) (p q : Fin m) : Module.End K (M q) :=
  if q < p then s q else if q = p then d q else 1

def differential (d s : ∀ p, Module.End K (M p)) : Module.End K (⨂[K] p, M p) :=
  ∑ p, PiTensorProduct.map (factor d s p)

def slot (p : Fin m) (a : Module.End K (M p)) : Module.End K (⨂[K] p, M p) :=
  PiTensorProduct.map (Function.update (fun q => (1 : Module.End K (M q))) p a)

@[simp] theorem slot_one (p : Fin m) : slot p (1 : Module.End K (M p)) = 1 := by
  simp [slot]

theorem slot_add (p : Fin m) (a b : Module.End K (M p)) :
    slot p (a + b) = slot p a + slot p b :=
  PiTensorProduct.map_update_add _ _ _ _

theorem slot_neg (p : Fin m) (a : Module.End K (M p)) : slot p (-a) = -slot p a := by
  exact (PiTensorProduct.mapMultilinear K M M).map_update_neg _ p a

theorem slot_sub (p : Fin m) (a b : Module.End K (M p)) :
    slot p (a - b) = slot p a - slot p b := by
  rw [sub_eq_add_neg, slot_add, slot_neg, sub_eq_add_neg]

theorem tensorMap_neg_of_coordinate (f g : ∀ p, Module.End K (M p)) (p : Fin m)
    (hp : f p = -g p) (hrest : ∀ q, q ≠ p → f q = g q) :
    PiTensorProduct.map f = -PiTensorProduct.map g := by
  have hf : f = Function.update g p (-g p) := by
    funext q
    by_cases hq : q = p
    · subst q; simpa using hp
    · simpa [hq] using hrest q hq
  rw [hf]
  change (PiTensorProduct.mapMultilinear K M M) (Function.update g p (-g p)) = _
  rw [MultilinearMap.map_update_neg, Function.update_eq_self]
  rfl

theorem tensor_cross_anticommute (d s h : ∀ p, Module.End K (M p))
    (hds : ∀ p, d p * s p = -(s p * d p))
    (hsh : ∀ p, s p * h p + h p * s p = 0)
    (p q : Fin m) (hne : q ≠ p) :
    PiTensorProduct.map (factor d s q) * PiTensorProduct.map (factor h s p) +
      PiTensorProduct.map (factor h s p) * PiTensorProduct.map (factor d s q) = 0 := by
  rw [← PiTensorProduct.map_mul, ← PiTensorProduct.map_mul]
  apply add_eq_zero_iff_eq_neg.mpr
  rcases lt_or_gt_of_ne hne with hqp | hpq
  · apply tensorMap_neg_of_coordinate _ _ q
    · simpa [factor, hqp] using hds q
    · intro r hrq
      by_cases hrp : r = p
      · subst r
        simp [factor, ne_of_gt hqp, not_lt_of_ge (le_of_lt hqp)]
      · simp only [factor]
        split_ifs <;> simp_all
  · apply tensorMap_neg_of_coordinate _ _ p
    · simpa [factor, hpq] using (add_eq_zero_iff_eq_neg.mp (hsh p))
    · intro r hrp
      by_cases hrq : r = q
      · subst r
        simp [factor, ne_of_gt hpq, not_lt_of_ge (le_of_lt hpq)]
      · simp only [factor]
        split_ifs <;> simp_all

theorem tensor_same_coordinate (d s h : ∀ p, Module.End K (M p))
    (hs : ∀ p, s p * s p = 1) (p : Fin m) :
    PiTensorProduct.map (factor d s p) * PiTensorProduct.map (factor h s p) +
      PiTensorProduct.map (factor h s p) * PiTensorProduct.map (factor d s p) =
        slot p (d p * h p + h p * d p) := by
  rw [← PiTensorProduct.map_mul, ← PiTensorProduct.map_mul, slot_add]
  congr 1 <;> apply congrArg PiTensorProduct.map <;> funext q
  all_goals
    by_cases hq : q = p
    · subst q; simp [factor]
    · by_cases hqp : q < p
      · simp [factor, hqp, Function.update_of_ne hq, hs]
      · simp [factor, hqp, hq, Function.update_of_ne hq]

private theorem square_sum_zero {A I : Type*} [Ring A] [DecidableEq I]
    (f : I → A) (hzero : ∀ i, f i * f i = 0)
    (hanti : ∀ i j, i ≠ j → f i * f j + f j * f i = 0) (T : Finset I) :
    (∑ i ∈ T, f i) * (∑ i ∈ T, f i) = 0 := by
  induction T using Finset.induction_on with
  | empty => simp
  | @insert a T ha ih =>
    simp only [Finset.sum_insert ha]
    have hc : f a * (∑ i ∈ T, f i) + (∑ i ∈ T, f i) * f a = 0 := by
      rw [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_add_distrib]
      exact Finset.sum_eq_zero fun i hi => hanti a i (fun h => ha (h.symm ▸ hi))
    calc (f a + ∑ i ∈ T, f i) * (f a + ∑ i ∈ T, f i) =
        f a * f a + (f a * (∑ i ∈ T, f i) + (∑ i ∈ T, f i) * f a) +
          (∑ i ∈ T, f i) * (∑ i ∈ T, f i) := by noncomm_ring
      _ = 0 := by rw [hzero, hc, ih]; simp

/-- Square-zero of the signed differential follows from the factor identities,
including in characteristic two. -/
theorem differential_square_zero (d s : ∀ p, Module.End K (M p))
    (hdd : ∀ p, d p * d p = 0)
    (hds : ∀ p, d p * s p = -(s p * d p)) :
    differential d s * differential d s = 0 := by
  apply square_sum_zero
  · intro p
    rw [← PiTensorProduct.map_mul]
    change (PiTensorProduct.mapMultilinear K M M)
      (fun q => factor d s p q * factor d s p q) = 0
    apply MultilinearMap.map_coord_zero (i := p)
    simpa [factor] using hdd p
  · intro p q hpq
    apply tensor_cross_anticommute d s d hds _ q p hpq
    intro r
    rw [hds]
    simp

/-- A one-factor correction is an actual homotopy for the full signed tensor differential. -/
theorem tensor_slot_homotopy (d s h : ∀ p, Module.End K (M p))
    (hs : ∀ p, s p * s p = 1)
    (hds : ∀ p, d p * s p = -(s p * d p))
    (hsh : ∀ p, s p * h p + h p * s p = 0) (p : Fin m) :
    differential d s * PiTensorProduct.map (factor h s p) +
      PiTensorProduct.map (factor h s p) * differential d s =
        1 - slot p (1 - d p * h p - h p * d p) := by
  rw [differential, Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
  rw [Finset.sum_eq_single p]
  · rw [tensor_same_coordinate d s h hs p, slot_sub, slot_sub, slot_one, slot_add]
    abel
  · intro q _ hqp
    exact tensor_cross_anticommute d s h hds hsh p q hqp
  · simp

def prefixMap (P : ∀ p, Module.End K (M p)) (j : ℕ) : Module.End K (⨂[K] p, M p) :=
  PiTensorProduct.map (fun p => if p.val < j then P p else 1)

@[simp] theorem prefixMap_zero (P : ∀ p, Module.End K (M p)) : prefixMap P 0 = 1 := by
  simp [prefixMap]

theorem prefixMap_succ (P : ∀ p, Module.End K (M p)) (p : Fin m) :
    prefixMap P (p.val + 1) = slot p (P p) * prefixMap P p.val := by
  rw [slot, prefixMap, prefixMap, ← PiTensorProduct.map_mul]
  apply congrArg PiTensorProduct.map
  funext q
  by_cases hq : q = p
  · subst q; simp
  · have hval : q.val ≠ p.val := fun h => hq (Fin.ext h)
    simp only [Function.update_of_ne hq, one_mul]
    by_cases hlt : q.val < p.val
    · simp [hlt, Nat.lt_succ_of_lt hlt]
    · have hnext : ¬q.val < p.val + 1 := by omega
      simp [hlt, hnext]

theorem prefixMap_full (P : ∀ p, Module.End K (M p)) :
    prefixMap P m = PiTensorProduct.map P := by
  unfold prefixMap
  congr 1
  funext p
  exact if_pos p.isLt

theorem projection_kills_differential (d h : Module.End K V)
    (hdd : d * d = 0) (hdhd : d * h * d = d) :
    d * (1 - d * h - h * d) = 0 := by
  calc d * (1 - d * h - h * d) = d - (d * d) * h - d * h * d := by noncomm_ring
    _ = 0 := by rw [hdd, hdhd]; simp

/-- For every cycle, the tensor of the one-factor projections is a cycle
congruent to it modulo an actual boundary. -/
theorem tensor_projection_mod_boundary (d s h : ∀ p, Module.End K (M p))
    (hs : ∀ p, s p * s p = 1)
    (hds : ∀ p, d p * s p = -(s p * d p))
    (hsh : ∀ p, s p * h p + h p * s p = 0)
    (hDD : differential d s * differential d s = 0)
    {x : ⨂[K] p, M p} (hx : differential d s x = 0) :
    x - PiTensorProduct.map (fun p => 1 - d p * h p - h p * d p) x ∈
      LinearMap.range (differential d s) := by
  let D := differential d s
  let P := fun p => 1 - d p * h p - h p * d p
  have one_step (p : Fin m) {y : ⨂[K] p, M p} (hy : D y = 0) :
      D (slot p (P p) y) = 0 ∧ y - slot p (P p) y ∈ LinearMap.range D := by
    let H := PiTensorProduct.map (factor h s p)
    have hid : D * H + H * D = 1 - slot p (P p) :=
      tensor_slot_homotopy d s h hs hds hsh p
    have hcor : D (H y) = y - slot p (P p) y := by
      have hz := LinearMap.congr_fun hid y
      change D (H y) + H (D y) = y - slot p (P p) y at hz
      simpa [hy] using hz
    have hsq (z : ⨂[K] p, M p) : D (D z) = 0 := by
      exact LinearMap.congr_fun hDD z
    refine ⟨?_, ⟨H y, hcor⟩⟩
    have hh := congrArg D hcor
    simpa [hsq, map_sub, hy] using hh.symm
  have hprefix : ∀ j ≤ m, D (prefixMap P j x) = 0 ∧
      x - prefixMap P j x ∈ LinearMap.range D := by
    intro j
    induction j with
    | zero => intro _; simpa using And.intro hx (Submodule.zero_mem (LinearMap.range D))
    | succ j ih =>
      intro hj
      obtain ⟨hc, hb⟩ := ih (by omega)
      let p : Fin m := ⟨j, by omega⟩
      obtain ⟨hc', hb'⟩ := one_step p hc
      have hnext : prefixMap P (j + 1) x = slot p (P p) (prefixMap P j x) := by
        exact LinearMap.congr_fun (prefixMap_succ P p) x
      rw [hnext]
      refine ⟨hc', ?_⟩
      convert (LinearMap.range D).add_mem hb hb' using 1 <;> abel
  simpa only [prefixMap_full] using (hprefix m le_rfl).2

/-- Integral cycle spanning from actual odd generalized inverses. The right
side uses literal pure tensors of factor cycles and the actual image of the
signed differential. A degree-raising homotopy supplies these hypotheses
without any division, including over `ℤ[z]`. -/
theorem ker_differential_eq_span_cycles_sup_range_of_homotopies
    (d s h : ∀ p, Module.End K (M p))
    (hdd : ∀ p, d p * d p = 0)
    (hs : ∀ p, s p * s p = 1)
    (hds : ∀ p, d p * s p = -(s p * d p))
    (hdhd : ∀ p, d p * h p * d p = d p)
    (hsh : ∀ p, s p * h p + h p * s p = 0) :
    LinearMap.ker (differential d s) =
      Submodule.span K {z | ∃ x : ∀ p, M p,
        (∀ p, d p (x p) = 0) ∧ PiTensorProduct.tprod K x = z} ⊔
      LinearMap.range (differential d s) := by
  have hDD := differential_square_zero d s hdd hds
  let P := fun p => 1 - d p * h p - h p * d p
  have hP (p : Fin m) (x : M p) : d p (P p x) = 0 :=
    LinearMap.congr_fun (projection_kills_differential (d p) (h p) (hdd p) (hdhd p)) x
  apply le_antisymm
  · intro x hx
    have hboundary := tensor_projection_mod_boundary d s h hs hds hsh hDD hx
    have hprojected : PiTensorProduct.map P x ∈
        Submodule.span K {z | ∃ y : ∀ p, M p,
          (∀ p, d p (y p) = 0) ∧ PiTensorProduct.tprod K y = z} := by
      have hrange : LinearMap.range (PiTensorProduct.map P) ≤
          Submodule.span K {z | ∃ y : ∀ p, M p,
            (∀ p, d p (y p) = 0) ∧ PiTensorProduct.tprod K y = z} := by
        rw [PiTensorProduct.map_range_eq_span_tprod]
        apply Submodule.span_mono
        rintro z ⟨y, rfl⟩
        exact ⟨fun p => P p (y p), fun p => hP p (y p), rfl⟩
      exact hrange ⟨x, rfl⟩
    have hm := Submodule.add_mem_sup hprojected hboundary
    convert hm using 1 <;> abel
  · apply sup_le
    · apply Submodule.span_le.mpr
      rintro z ⟨x, hx, rfl⟩
      change differential d s (PiTensorProduct.tprod K x) = 0
      simp only [differential, LinearMap.sum_apply, PiTensorProduct.map_tprod]
      apply Finset.sum_eq_zero
      intro p _
      apply MultilinearMap.map_coord_zero (i := p)
      simpa [factor] using hx p
    · intro z hz
      obtain ⟨x, rfl⟩ := hz
      exact LinearMap.congr_fun hDD x

end FiniteTensor
