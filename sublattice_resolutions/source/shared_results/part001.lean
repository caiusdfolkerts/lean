/- BEGIN EXACT BODY: FourPapers.Sublattice.ClosedGraphIntervals -/
section

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 300000
noncomputable section
namespace FourPapers.Sublattice
open Classical SimpleGraph
variable {V : Type*} [LinearOrder V] {G : SimpleGraph V}

/-- Closedness for the specified labeling: neighbors above a common vertex,
and neighbors below a common vertex, form cliques. -/
def ClosedLabeling (G : SimpleGraph V) : Prop :=
  (∀ {a b c}, a<b → a<c → b≠c → G.Adj a b → G.Adj a c → G.Adj b c) ∧
  (∀ {a b c}, a<c → b<c → a≠b → G.Adj a c → G.Adj b c → G.Adj a b)

lemma walk_support_chain_cons_iff (R : V → V → Prop)
    {a b c : V} (hab : G.Adj a b) (p : G.Walk b c) :
    (Walk.cons hab p).support.IsChain R ↔ R a b ∧ p.support.IsChain R := by
  cases p <;> simp [Walk.support,List.isChain_cons_cons]

/-- A shortest walk in a closed labeled graph cannot turn: a local maximum
or minimum would supply a shorter walk by closedness. -/
theorem shortest_walk_monotone (hG : ClosedLabeling G)
    {a b : V} (p : G.Walk a b) (hmin : ∀q : G.Walk a b, p.length≤q.length) :
    p.support.IsChain (·<·) ∨ p.support.IsChain (·>·) := by
  induction p with
  | nil => exact Or.inl (by simp [Walk.support])
  | @cons a b c hab p ih =>
    have ht : ∀q : G.Walk b c, p.length≤q.length := by
      intro q
      have h := hmin (Walk.cons hab q)
      simpa only [Walk.length_cons,Nat.add_le_add_iff_right] using h
    rcases ih ht with hi | hd
    · by_cases hab' : a<b
      · exact Or.inl ((walk_support_chain_cons_iff _ hab p).mpr ⟨hab',hi⟩)
      · cases p with
        | nil =>
          exact Or.inr ((walk_support_chain_cons_iff _ hab Walk.nil).mpr
            ⟨lt_of_le_of_ne (le_of_not_gt hab') hab.ne.symm,by simp [Walk.support]⟩)
        | @cons b e c hbe q =>
          have hbe' := ((walk_support_chain_cons_iff _ hbe q).mp hi).1
          have hba : b<a := lt_of_le_of_ne (le_of_not_gt hab') hab.ne.symm
          have hae : a≠e := by
            intro h
            subst e
            have h := hmin q
            simp only [Walk.length_cons] at h
            omega
          have haeG := hG.1 hba hbe' hae hab.symm hbe
          have h := hmin (Walk.cons haeG q)
          simp only [Walk.length_cons] at h
          omega
    · by_cases hba : b<a
      · exact Or.inr ((walk_support_chain_cons_iff _ hab p).mpr ⟨hba,hd⟩)
      · cases p with
        | nil =>
          exact Or.inl ((walk_support_chain_cons_iff _ hab Walk.nil).mpr
            ⟨lt_of_le_of_ne (le_of_not_gt hba) hab.ne,by simp [Walk.support]⟩)
        | @cons b e c hbe q =>
          have heb := ((walk_support_chain_cons_iff _ hbe q).mp hd).1
          have hab' : a<b := lt_of_le_of_ne (le_of_not_gt hba) hab.ne
          have hae : a≠e := by
            intro h
            subst e
            have h := hmin q
            simp only [Walk.length_cons] at h
            omega
          have haeG := hG.2 hab' heb hae hab hbe.symm
          have h := hmin (Walk.cons haeG q)
          simp only [Walk.length_cons] at h
          omega

lemma increasing_walk_end_le {a b : V} (p : G.Walk a b)
    (h : p.support.IsChain (·<·)) : a≤b := by
  induction p with
  | nil => exact le_rfl
  | cons hab p ih =>
    rcases (walk_support_chain_cons_iff _ hab p).mp h with ⟨hab',ht⟩
    exact hab'.le.trans (ih ht)

lemma decreasing_walk_end_le {a b : V} (p : G.Walk a b)
    (h : p.support.IsChain (·>·)) : b≤a := by
  induction p with
  | nil => exact le_rfl
  | cons hab p ih =>
    rcases (walk_support_chain_cons_iff _ hab p).mp h with ⟨hab',ht⟩
    exact (ih ht).trans hab'.le

/-- Every connected ordered pair admits an increasing walk; neither global
connectedness nor consecutiveness of the original labels is assumed. -/
theorem closed_reachable_increasing_walk (hG : ClosedLabeling G)
    {a b : V} (hab : a<b) (hr : G.Reachable a b) :
    ∃p : G.Walk a b, p.support.IsChain (·<·) := by
  obtain ⟨p,hp⟩ := hr.exists_walk_length_eq_dist
  have hm : ∀q : G.Walk a b, p.length≤q.length := by
    intro q
    rw [hp]
    exact SimpleGraph.dist_le q
  rcases shortest_walk_monotone hG p hm with hi | hd
  · exact ⟨p,hi⟩
  · exact (not_le_of_gt hab (decreasing_walk_end_le p hd)).elim

lemma closed_increasing_walk_propagates_upper_edge (hG : ClosedLabeling G)
    {a b c : V} (p : G.Walk a b) (hp : p.support.IsChain (·<·))
    (hbc : b<c) (hac : G.Adj a c) : G.Adj b c := by
  induction p with
  | nil => exact hac
  | @cons a u b hau p ih =>
    rcases (walk_support_chain_cons_iff _ hau p).mp hp with ⟨hau',hp⟩
    have hub := increasing_walk_end_le p hp
    have huc := hub.trans_lt hbc
    have hac' := hau'.trans huc
    exact ih hp hbc (hG.1 hau' hac' huc.ne hau hac)

/-- Within each connected component, an edge spans its entire interval in the
inherited order. This is the precise premise needed before block relabeling. -/
theorem closed_interval_inside_component (hG : ClosedLabeling G)
    {a b c : V} (hab : a<b) (hbc : b<c) (hac : G.Adj a c)
    (hr : G.Reachable a b) : G.Adj a b ∧ G.Adj b c := by
  obtain ⟨p,hp⟩ := closed_reachable_increasing_walk hG hab hr
  have hbcG := closed_increasing_walk_propagates_upper_edge hG p hp hbc hac
  exact ⟨hG.2 (hab.trans hbc) hbc hab.ne hac hbcG,hbcG⟩

end FourPapers.Sublattice

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.CycleLiftSubmodule -/
section

section
set_option autoImplicit false
noncomputable section
namespace FourPapers
variable {k M N : Type*} [CommRing k] [AddCommGroup M] [Module k M]
  [AddCommGroup N] [Module k N]

/-- Vectors whose specified image agrees with a genuine cycle modulo a
specified lower submodule. This uses the actual differential kernel. -/
def cycleLiftSubmodule (D : Module.End k M) (f : N →ₗ[k] M) (lower : Submodule k M) :
    Submodule k N := ((LinearMap.ker D)⊔lower).comap f

theorem mem_cycleLiftSubmodule_iff (D : Module.End k M) (f : N →ₗ[k] M)
    (lower : Submodule k M) (x : N) :
    x∈cycleLiftSubmodule D f lower ↔ ∃y : M,D y=0 ∧ f x-y∈lower := by
  change f x∈(LinearMap.ker D)⊔lower ↔ _
  rw [Submodule.mem_sup]
  constructor
  · rintro ⟨y,hy,z,hz,he⟩
    refine ⟨y,hy,?_⟩
    have hz' : f x-y=z := by rw [←he]; abel
    simpa only [hz'] using hz
  · rintro ⟨y,hy,hz⟩
    exact ⟨y,hy,f x-y,hz,by abel⟩

theorem boundary_mem_cycleLiftSubmodule (D : Module.End k M) (d : Module.End k N)
    (f : N →ₗ[k] M) (lower : Submodule k M) (hD : D.comp D=0)
    (x : N) (hdrop : f (d x)-D (f x)∈lower) :
    d x∈cycleLiftSubmodule D f lower := by
  apply (mem_cycleLiftSubmodule_iff D f lower (d x)).mpr
  refine ⟨D (f x),?_,hdrop⟩
  exact LinearMap.congr_fun hD (f x)

/-- Generation modulo actual boundaries reduces cycle lifting to the stated
generators and the actual differential correction on arbitrary inputs. -/
theorem cycles_lift_of_span_and_boundary (D : Module.End k M) (d : Module.End k N)
    (f : N →ₗ[k] M) (lower : Submodule k M) (S : Set N)
    (hgen : LinearMap.ker d≤Submodule.span k S⊔LinearMap.range d)
    (hD : D.comp D=0)
    (hS : ∀x∈S,x∈cycleLiftSubmodule D f lower)
    (hdrop : ∀x : N,f (d x)-D (f x)∈lower)
    (x : N) (hx : d x=0) : ∃y : M,D y=0 ∧ f x-y∈lower := by
  apply (mem_cycleLiftSubmodule_iff D f lower x).mp
  apply (sup_le (Submodule.span_le.mpr hS) ?_) (hgen hx)
  rintro z ⟨v,rfl⟩
  exact boundary_mem_cycleLiftSubmodule D d f lower hD v (hdrop v)

end FourPapers
end

end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.ClosedGraphRelabeling -/
section

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 300000
noncomputable section
namespace FourPapers.Sublattice
open Classical SimpleGraph
variable {N : ℕ} (G : SimpleGraph (Fin N))

local instance : Fintype G.ConnectedComponent := Fintype.ofFinite _

/-- Number the connected components, preserving the original order inside
each component. The numbering itself makes no mathematical choice of labels. -/
def graphComponentNumber (v : Fin N) : Fin (Fintype.card G.ConnectedComponent) :=
  Fintype.equivFin G.ConnectedComponent (G.connectedComponentMk v)

lemma graphComponentNumber_eq_iff (v w : Fin N) :
    graphComponentNumber G v = graphComponentNumber G w ↔ G.Reachable v w := by
  simp only [graphComponentNumber,Equiv.apply_eq_iff_eq,ConnectedComponent.eq]

def graphComponentKey (v : Fin N) :
    Lex (Fin (Fintype.card G.ConnectedComponent) × Fin N) :=
  toLex (graphComponentNumber G v,v)

lemma graphComponentKey_injective : Function.Injective (graphComponentKey G) := by
  intro v w h
  exact congrArg (fun x => (ofLex x).2) h

local instance : Fintype (Set.range (graphComponentKey G)) := Fintype.ofFinite _

def graphComponentRangeEquiv : Fin N ≃ Set.range (graphComponentKey G) :=
  Equiv.ofInjective _ (graphComponentKey_injective G)

lemma graphComponentRange_card : Fintype.card (Set.range (graphComponentKey G)) = N := by
  rw [←Fintype.card_congr (graphComponentRangeEquiv G),Fintype.card_fin]

/-- Sort the component keys. This is a permutation of all vertices, including
isolated vertices and empty graphs. -/
def graphComponentRelabeling : Fin N ≃ Fin N :=
  (graphComponentRangeEquiv G).trans
    (Fintype.orderIsoFinOfCardEq (Set.range (graphComponentKey G))
      (graphComponentRange_card G)).symm.toEquiv

lemma graphComponentRelabeling_lt_iff (v w : Fin N) :
    graphComponentRelabeling G v < graphComponentRelabeling G w ↔
      graphComponentKey G v < graphComponentKey G w := by
  unfold graphComponentRelabeling
  change (Fintype.orderIsoFinOfCardEq _ _).symm (graphComponentRangeEquiv G v) <
      (Fintype.orderIsoFinOfCardEq _ _).symm (graphComponentRangeEquiv G w) ↔ _
  rw [OrderIso.lt_iff_lt]
  rfl

lemma graphComponentKey_interval {a b c : Fin N}
    (hab : graphComponentKey G a < graphComponentKey G b)
    (hbc : graphComponentKey G b < graphComponentKey G c)
    (hac : G.Reachable a c) : a<b ∧ b<c ∧ G.Reachable a b := by
  have he : graphComponentNumber G a=graphComponentNumber G c :=
    (graphComponentNumber_eq_iff G a c).mpr hac
  have hab' : graphComponentNumber G a≤graphComponentNumber G b ∧
      (graphComponentNumber G a=graphComponentNumber G b → a<b) := by
    exact Prod.Lex.toLex_lt_toLex'.mp hab
  have hbc' : graphComponentNumber G b≤graphComponentNumber G c ∧
      (graphComponentNumber G b=graphComponentNumber G c → b<c) := by
    exact Prod.Lex.toLex_lt_toLex'.mp hbc
  have habnum : graphComponentNumber G a=graphComponentNumber G b :=
    le_antisymm hab'.1 (he.symm ▸ hbc'.1)
  have hbcnum : graphComponentNumber G b=graphComponentNumber G c := habnum.symm.trans he
  exact ⟨hab'.2 habnum,hbc'.2 hbcnum,(graphComponentNumber_eq_iff G a b).mp habnum⟩

/-- Every closed labeled graph becomes interval labeled after putting its
connected components in consecutive blocks and retaining each internal order.
The graph itself is transported by an actual permutation of its vertices. -/
theorem closedGraph_relabeling_interval (hG : ClosedLabeling G) :
    ∀ a b c : Fin N, a<b → b<c →
      G.Adj ((graphComponentRelabeling G).symm a)
        ((graphComponentRelabeling G).symm c) →
      G.Adj ((graphComponentRelabeling G).symm a)
        ((graphComponentRelabeling G).symm b) ∧
      G.Adj ((graphComponentRelabeling G).symm b)
        ((graphComponentRelabeling G).symm c) := by
  intro a b c hab hbc hac
  have habkey := (graphComponentRelabeling_lt_iff G
    ((graphComponentRelabeling G).symm a) ((graphComponentRelabeling G).symm b)).mp
      (by simpa only [Equiv.apply_symm_apply] using hab)
  have hbckey := (graphComponentRelabeling_lt_iff G
    ((graphComponentRelabeling G).symm b) ((graphComponentRelabeling G).symm c)).mp
      (by simpa only [Equiv.apply_symm_apply] using hbc)
  obtain ⟨habold,hbcold,hr⟩ := graphComponentKey_interval G habkey hbckey hac.reachable
  exact closed_interval_inside_component hG habold hbcold hac hr

end FourPapers.Sublattice

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.MultichainCounting -/
section

/-!
# Counting repetitions in a fixed strict support

Deleting one occurrence of each value identifies positive multiplicities with
an ordinary symmetric power. This gives the binomial coefficient that counts
all weak chains with a fixed nonempty strict support.
-/

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 100000
noncomputable section
open Classical

namespace FourPapers.MultichainCounting

variable {α : Type*} [Fintype α]

/-- A multiset of fixed size in which every value occurs. -/
abbrev PositiveSym (α : Type*) (m : ℕ) :=
  {s : Sym α m // ∀ a : α, a ∈ s}

lemma univ_le_positiveSym {m : ℕ} (s : PositiveSym α m) :
    (Finset.univ : Finset α).val ≤ s.val.val := by
  classical
  apply Multiset.le_iff_count.mpr
  intro a
  rw [Multiset.count_eq_one_of_mem (Finset.univ : Finset α).nodup
    (Finset.mem_univ a)]
  exact Multiset.one_le_count_iff_mem.mpr (s.property a)

lemma card_le_of_positiveSym {m : ℕ} (s : PositiveSym α m) :
    Fintype.card α ≤ m := by
  simpa only [Finset.card_val, Finset.card_univ, s.val.property] using
    Multiset.card_le_card (univ_le_positiveSym s)

/-- Remove the mandatory first occurrence of each element. -/
def positiveSymEquivResidual (m : ℕ) (hm : Fintype.card α ≤ m) :
    PositiveSym α m ≃ Sym α (m - Fintype.card α) where
  toFun s := ⟨s.val.val - (Finset.univ : Finset α).val, by
    rw [Multiset.card_sub (univ_le_positiveSym s), s.val.property]
    rfl⟩
  invFun s := ⟨⟨s.val + (Finset.univ : Finset α).val, by
    rw [Multiset.card_add, s.property]
    simpa only [Finset.card_val, Finset.card_univ] using Nat.sub_add_cancel hm⟩,
    fun a => Multiset.mem_add.mpr (Or.inr (Finset.mem_univ a))⟩
  left_inv s := by
    apply Subtype.ext
    apply Subtype.ext
    exact tsub_add_cancel_of_le (univ_le_positiveSym s)
  right_inv s := by
    apply Subtype.ext
    exact add_tsub_cancel_right s.val (Finset.univ : Finset α).val

/-- Stars and bars with every multiplicity positive. -/
theorem card_positiveSym [Nonempty α] (m : ℕ) (hm : 0 < m) :
    Nat.card (PositiveSym α m) = (m - 1).choose (Fintype.card α - 1) := by
  classical
  have hr : 0 < Fintype.card α := Fintype.card_pos
  by_cases h : Fintype.card α ≤ m
  · rw [Nat.card_congr (positiveSymEquivResidual (α := α) m h), Nat.card_eq_fintype_card,
      Sym.card_sym_eq_choose]
    have he : Fintype.card α + (m - Fintype.card α) - 1 = m - 1 := by omega
    rw [he]
    exact Nat.choose_symm_of_eq_add (by omega)
  · letI : IsEmpty (PositiveSym α m) :=
      ⟨fun s => h (card_le_of_positiveSym s)⟩
    rw [Nat.card_eq_fintype_card, Fintype.card_eq_zero]
    symm
    apply Nat.choose_eq_zero_of_lt
    omega

section LinearOrder

variable [LinearOrder α]

abbrev MonotoneTuple (α : Type*) [Preorder α] (m : ℕ) :=
  {f : Fin m → α // Monotone f}

def tupleSym {m : ℕ} (w : MonotoneTuple α m) : Sym α m :=
  ⟨(List.ofFn w.val : Multiset α), by simp⟩

lemma tupleSym_injective (m : ℕ) :
    Function.Injective (tupleSym (α := α) (m := m)) := by
  intro x y h
  apply Subtype.ext
  apply List.ofFn_injective
  have hp : (List.ofFn x.val).Perm (List.ofFn y.val) :=
    Quotient.exact (congrArg Subtype.val h)
  exact hp.eq_of_pairwise' x.property.sortedLE_ofFn.pairwise
    y.property.sortedLE_ofFn.pairwise

lemma tupleSym_surjective (m : ℕ) :
    Function.Surjective (tupleSym (α := α) (m := m)) := by
  intro s
  let l := s.val.sort (· ≤ ·)
  have hl : l.length = m := by simpa only [l, Multiset.length_sort] using s.property
  let f : Fin m → α := fun i => l.get (Fin.cast hl.symm i)
  have hf : Monotone f := by
    intro i j hij
    have hs : l.Pairwise (· ≤ ·) := Multiset.pairwise_sort s.val (· ≤ ·)
    exact hs.rel_get_of_le (show Fin.cast hl.symm i ≤ Fin.cast hl.symm j from hij)
  have hfl : List.ofFn f = l := by
    exact (List.ofFn_congr hl l.get).symm.trans (List.ofFn_get l)
  refine ⟨⟨f,hf⟩, ?_⟩
  apply Subtype.ext
  change (List.ofFn f : Multiset α) = s.val
  rw [hfl]
  exact Multiset.sort_eq _ _

/-- A weakly increasing tuple is determined by its multiplicities. -/
def monotoneTupleEquivSym (m : ℕ) : MonotoneTuple α m ≃ Sym α m :=
  Equiv.ofBijective tupleSym ⟨tupleSym_injective m, tupleSym_surjective m⟩

lemma tupleSym_full_iff {m : ℕ} (w : MonotoneTuple α m) :
    (∀ a : α, a ∈ tupleSym w) ↔ Function.Surjective w.val := by
  simp only [tupleSym, Sym.mem_mk, Multiset.mem_coe, List.mem_ofFn,
    Function.Surjective]

/-- Restrict the multiplicity correspondence to tuples using every value. -/
def surjectiveMonotoneEquiv (m : ℕ) :
    {w : MonotoneTuple α m // Function.Surjective w.val} ≃ PositiveSym α m :=
  (monotoneTupleEquivSym (α := α) m).subtypeEquiv
    (fun w => (tupleSym_full_iff w).symm)

theorem card_surjectiveMonotone [Nonempty α] (m : ℕ) (hm : 0 < m) :
    Nat.card {w : MonotoneTuple α m // Function.Surjective w.val} =
      (m - 1).choose (Fintype.card α - 1) := by
  exact (Nat.card_congr (surjectiveMonotoneEquiv (α := α) m)).trans
    (card_positiveSym (α := α) m hm)

end LinearOrder

section PartialOrder

variable [PartialOrder α]

/-- A nonempty set of comparable values, with the induced strict order. -/
def StrictSupport (α : Type*) [PartialOrder α] :=
  {s : Finset α // s.Nonempty ∧ IsChain (· < ·) (s : Set α)}

instance strictSupportFintype : Fintype (StrictSupport α) := by
  classical
  unfold StrictSupport
  infer_instance

def tupleSupport {m : ℕ} (hm : 0 < m) (w : MonotoneTuple α m) : StrictSupport α := by
  classical
  refine ⟨Finset.univ.image w.val, ?_, ?_⟩
  · exact ⟨w.val ⟨0,hm⟩, Finset.mem_image.mpr ⟨⟨0,hm⟩, Finset.mem_univ _, rfl⟩⟩
  · intro a ha b hb hab
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hb
    rcases le_total i j with hij | hji
    · exact Or.inl (lt_of_le_of_ne (w.property hij) hab)
    · exact Or.inr (lt_of_le_of_ne (w.property hji) hab.symm)

lemma tupleSupport_mem {m : ℕ} (hm : 0 < m) (w : MonotoneTuple α m) (a : α) :
    a ∈ (tupleSupport hm w).val ↔ ∃ i, w.val i = a := by
  classical
  simp only [tupleSupport, Finset.mem_image, Finset.mem_univ, true_and]

/-- Relabel the values of a tuple by its fixed support. -/
def supportFiberEquiv {m : ℕ} (hm : 0 < m) (s : StrictSupport α) :
    {w : MonotoneTuple α m // tupleSupport hm w = s} ≃
      {w : MonotoneTuple s.val m // Function.Surjective w.val} where
  toFun w := by
    have hs : (tupleSupport hm w.val).val = s.val := congrArg Subtype.val w.property
    let f : Fin m → s.val := fun i => ⟨w.val.val i, by
      rw [← hs]
      exact (tupleSupport_mem hm w.val _).mpr ⟨i,rfl⟩⟩
    refine ⟨⟨f, fun i j hij => w.val.property hij⟩, ?_⟩
    intro a
    have ha : a.val ∈ (tupleSupport hm w.val).val := hs.symm ▸ a.property
    obtain ⟨i,hi⟩ := (tupleSupport_mem hm w.val a.val).mp ha
    exact ⟨i, Subtype.ext hi⟩
  invFun w := by
    refine ⟨⟨fun i => (w.val.val i).val, fun i j hij => w.val.property hij⟩, ?_⟩
    apply Subtype.ext
    ext a
    rw [tupleSupport_mem]
    constructor
    · rintro ⟨i,rfl⟩
      exact (w.val.val i).property
    · intro ha
      obtain ⟨i,hi⟩ := w.property ⟨a,ha⟩
      exact ⟨i, congrArg Subtype.val hi⟩
  left_inv w := by
    apply Subtype.ext
    apply Subtype.ext
    rfl
  right_inv w := by
    apply Subtype.ext
    apply Subtype.ext
    funext i
    apply Subtype.ext
    rfl

theorem card_supportFiber {m : ℕ} (hm : 0 < m) (s : StrictSupport α) :
    Nat.card {w : MonotoneTuple α m // tupleSupport hm w = s} =
      (m - 1).choose (s.val.card - 1) := by
  classical
  letI : LinearOrder s.val := s.property.2.linearOrder
  letI : Nonempty s.val := s.property.1.to_subtype
  rw [Nat.card_congr (supportFiberEquiv hm s)]
  simpa only [Fintype.card_coe] using card_surjectiveMonotone (α := s.val) m hm

/-- Group any support-dependent sum by the strict support. -/
theorem sum_by_strict_support {m : ℕ} (hm : 0 < m) (f : StrictSupport α → ℕ) :
    (∑ w : MonotoneTuple α m, f (tupleSupport hm w)) =
      ∑ s : StrictSupport α, (m - 1).choose (s.val.card - 1) * f s := by
  classical
  have hgroup : (∑ w : MonotoneTuple α m, f (tupleSupport hm w)) =
      ∑ s : StrictSupport α, ∑ w : {w : MonotoneTuple α m // tupleSupport hm w = s}, f s := by
    symm
    rw [← Fintype.sum_sigma (f := fun x :
      Σ s : StrictSupport α, {w : MonotoneTuple α m // tupleSupport hm w = s} => f x.1)]
    apply Fintype.sum_equiv (Equiv.sigmaFiberEquiv (tupleSupport (α := α) hm))
    intro w
    exact congrArg f w.2.property.symm
  rw [hgroup]
  apply Finset.sum_congr rfl
  intro s _
  rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
    card_supportFiber hm s]
  simp only [nsmul_eq_mul, Nat.cast_id]

end PartialOrder
end FourPapers.MultichainCounting

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.PositiveBinomialPolynomial -/
section

/-!
# Positive binomial expansions

A finite nonnegative combination of binomial coefficients is represented by
an actual rational polynomial. Every iterated forward difference is
nonnegative. Differences take values in the integers, so no truncation in
natural-number subtraction can conceal a negative value.
-/

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 150000
noncomputable section
namespace FourPapers.PositiveBinomialPolynomial
open Polynomial

def binomialPolynomial (r : ℕ) : Polynomial ℚ :=
  C ((r.factorial : ℚ)⁻¹) * descPochhammer ℚ r

theorem binomialPolynomial_eval (r m : ℕ) :
    (binomialPolynomial r).eval (m : ℚ) = m.choose r := by
  rw [binomialPolynomial, eval_mul, eval_C,
    Nat.cast_choose_eq_descPochhammer_div ℚ]
  exact mul_comm _ _

variable {ι : Type*} [Fintype ι]

def sequence (c r : ι → ℕ) (m : ℕ) : ℕ :=
  ∑ a, c a * m.choose (r a)

def polynomial (c r : ι → ℕ) : Polynomial ℚ :=
  ∑ a, C (c a : ℚ) * binomialPolynomial (r a)

theorem polynomial_eval (c r : ι → ℕ) (m : ℕ) :
    (polynomial c r).eval (m : ℚ) = (sequence c r m : ℚ) := by
  simp [polynomial, sequence, Polynomial.eval_finset_sum, binomialPolynomial_eval]

/-- The shift from `m-1` gives a single polynomial at every positive power. -/
theorem shifted_polynomial_eval (c r : ι → ℕ) (m : ℕ) (hm : 0 < m) :
    ((polynomial c r).comp (X-C 1)).eval (m : ℚ) = (sequence c r (m-1) : ℚ) := by
  rw [eval_comp, eval_sub, eval_X, eval_C,
    ← Nat.cast_one (R := ℚ), ← Nat.cast_sub (by omega : 1 ≤ m)]
  exact polynomial_eval c r (m-1)

theorem choose_forward_differences_nonnegative (r j m : ℕ) :
    0 ≤ ((fwdDiff (1 : ℕ))^[j] (fun x : ℕ => (x.choose r : ℤ))) m := by
  by_cases h : j ≤ r
  · obtain ⟨s,rfl⟩ := Nat.exists_eq_add_of_le h
    rw [fwdDiff_iter_choose]
    exact Int.natCast_nonneg _
  · have hj : r < j := Nat.lt_of_not_ge h
    obtain ⟨s,rfl⟩ := Nat.exists_eq_add_of_lt hj
    have hr : ((fwdDiff (1 : ℕ))^[r] (fun x : ℕ => (x.choose r : ℤ))) =
        fun _ => 1 := by
      simpa using (fwdDiff_iter_choose (R := ℤ) 0 r)
    rw [show r+s+1=(s+1)+r by omega, Function.iterate_add_apply, hr,
      Function.iterate_succ_apply, fwdDiff_const]
    simp [fwdDiff_iter_eq_sum_shift]

/-- All forward differences are genuinely nonnegative integer differences. -/
theorem sequence_forward_differences_nonnegative (c r : ι → ℕ) (j m : ℕ) :
    0 ≤ ((fwdDiff (1 : ℕ))^[j] (fun x => (sequence c r x : ℤ))) m := by
  have he : (fun x => (sequence c r x : ℤ)) =
      ∑ a, (c a : ℤ) • (fun x : ℕ => (x.choose (r a) : ℤ)) := by
    funext x
    simp [sequence]
  rw [he, fwdDiff_iter_finsetSum]
  simp only [Finset.sum_apply, fwdDiff_iter_const_smul, Pi.smul_apply, smul_eq_mul]
  apply Finset.sum_nonneg
  intro a _
  exact mul_nonneg (Int.natCast_nonneg _) (choose_forward_differences_nonnegative _ _ _)

end FourPapers.PositiveBinomialPolynomial
end

#print axioms FourPapers.PositiveBinomialPolynomial.sequence_forward_differences_nonnegative

end
end

/- BEGIN EXACT BODY: FourPapers.Common.ProjectiveComplexSplitting -/
section

/-!
# Splitting a nonnegative complex with projective homology

The cycles and boundaries in this file are the literal kernel and image of
the differential. Projectivity of boundaries is proved by induction; it is
not an extra hypothesis. The resulting sections are the input to a graded
contraction onto homology. This works over arbitrary commutative rings.
-/

section
set_option autoImplicit false
noncomputable section

namespace FourPapers.ProjectiveComplexSplitting

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- A surjection onto a projective module has a projective kernel when its
source is projective. The projection is explicitly `x ↦ x - s(f x)`. -/
theorem projective_kernel_of_surjective [Module.Projective R M]
    [Module.Projective R N] (f : M →ₗ[R] N) (hf : Function.Surjective f) :
    Module.Projective R (LinearMap.ker f) := by
  obtain ⟨s, hs⟩ := Module.projective_lifting_property f
    (LinearMap.id : N →ₗ[R] N) hf
  have hfs (y : N) : f (s y) = y := LinearMap.congr_fun hs y
  let r : M →ₗ[R] LinearMap.ker f :=
    (LinearMap.id - s.comp f).codRestrict (LinearMap.ker f) (by
      intro x
      apply LinearMap.mem_ker.mpr
      change f (x - s (f x)) = 0
      rw [map_sub, hfs, sub_self])
  apply Module.Projective.of_split (LinearMap.ker f).subtype r
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change x.val - s (f x.val) = x.val
  rw [LinearMap.mem_ker.mp x.property, map_zero, sub_zero]

theorem projective_kernel_of_projective_range [Module.Projective R M]
    (f : M →ₗ[R] N) [Module.Projective R (LinearMap.range f)] :
    Module.Projective R (LinearMap.ker f) := by
  letI : Module.Projective R (LinearMap.ker f.rangeRestrict) :=
    projective_kernel_of_surjective f.rangeRestrict f.surjective_rangeRestrict
  exact Module.Projective.of_equiv
    (LinearEquiv.ofEq _ _ (LinearMap.ker_rangeRestrict f))

theorem projective_submodule_of_projective_quotient [Module.Projective R M]
    (S : Submodule R M) [Module.Projective R (M ⧸ S)] :
    Module.Projective R S := by
  letI : Module.Projective R (LinearMap.ker S.mkQ) :=
    projective_kernel_of_surjective S.mkQ S.mkQ_surjective
  exact Module.Projective.of_equiv (LinearEquiv.ofEq _ _ S.ker_mkQ)

section Complex

variable (C : ℕ → Type*) [∀ n, AddCommGroup (C n)] [∀ n, Module R (C n)]
  (d : ∀ n, C (n + 1) →ₗ[R] C n)
  (dd : ∀ n, (d n).comp (d (n + 1)) = 0)

/-- Degree zero is retained in full, as required for an unaugmented
nonnegative complex. -/
def cycles : (n : ℕ) → Submodule R (C n)
  | 0 => ⊤
  | n + 1 => LinearMap.ker (d n)

def toCycles (n : ℕ) : C (n + 1) →ₗ[R] cycles C d n :=
  (d n).codRestrict (cycles C d n) (by
    intro x
    cases n with
    | zero => trivial
    | succ n =>
      exact LinearMap.congr_fun (dd n) x)

@[simp] theorem toCycles_val (n : ℕ) (x : C (n + 1)) :
    (toCycles C d dd n x).val = d n x := rfl

abbrev boundaries (n : ℕ) : Submodule R (cycles C d n) :=
  LinearMap.range (toCycles C d dd n)

abbrev Homology (n : ℕ) := cycles C d n ⧸ boundaries C d dd n

theorem toCycles_ker (n : ℕ) :
    LinearMap.ker (toCycles C d dd n) = cycles C d (n + 1) := by
  ext x
  change (toCycles C d dd n x = 0) ↔ d n x = 0
  constructor
  · intro h
    exact congrArg Subtype.val h
  · intro h
    exact Subtype.ext h

variable (hC : ∀ n, Module.Projective R (C n))
  (hH : ∀ n, Module.Projective R (Homology C d dd n))

include hC hH in
/-- Projectivity of every cycle module is derived from projectivity of the
terms and the actual homology quotients. No boundedness is needed for this
bottom-up construction. -/
theorem projective_cycles (n : ℕ) : Module.Projective R (cycles C d n) := by
  induction n with
  | zero =>
      letI : Module.Projective R (C 0) := hC 0
      exact Module.Projective.of_equiv
        (Submodule.topEquiv : (⊤ : Submodule R (C 0)) ≃ₗ[R] C 0).symm
  | succ n ih =>
      letI : Module.Projective R (cycles C d n) := ih
      letI : Module.Projective R (Homology C d dd n) := hH n
      letI : Module.Projective R (boundaries C d dd n) :=
        projective_submodule_of_projective_quotient (boundaries C d dd n)
      letI : Module.Projective R (C (n + 1)) := hC (n + 1)
      letI : Module.Projective R (LinearMap.ker (toCycles C d dd n)) :=
        projective_kernel_of_projective_range (toCycles C d dd n)
      exact Module.Projective.of_equiv (LinearEquiv.ofEq _ _ (toCycles_ker C d dd n))

include hC hH in
theorem projective_boundaries (n : ℕ) :
    Module.Projective R (boundaries C d dd n) := by
  letI : Module.Projective R (cycles C d n) := projective_cycles C d dd hC hH n
  letI : Module.Projective R (Homology C d dd n) := hH n
  exact projective_submodule_of_projective_quotient (boundaries C d dd n)

def homologySection (n : ℕ) : Homology C d dd n →ₗ[R] cycles C d n := by
  letI : Module.Projective R (Homology C d dd n) := hH n
  exact Classical.choose (Module.projective_lifting_property
    (boundaries C d dd n).mkQ LinearMap.id (boundaries C d dd n).mkQ_surjective)

theorem homologySection_rightInverse (n : ℕ) :
    (boundaries C d dd n).mkQ.comp (homologySection C d dd hH n) = LinearMap.id := by
  letI : Module.Projective R (Homology C d dd n) := hH n
  exact Classical.choose_spec (Module.projective_lifting_property
    (boundaries C d dd n).mkQ LinearMap.id (boundaries C d dd n).mkQ_surjective)

@[simp] theorem homologySection_mkQ (n : ℕ) (x : Homology C d dd n) :
    (boundaries C d dd n).mkQ (homologySection C d dd hH n x) = x :=
  LinearMap.congr_fun (homologySection_rightInverse C d dd hH n) x

def boundarySection (n : ℕ) : boundaries C d dd n →ₗ[R] C (n + 1) := by
  letI : Module.Projective R (boundaries C d dd n) :=
    projective_boundaries C d dd hC hH n
  exact Classical.choose (Module.projective_lifting_property
    (toCycles C d dd n).rangeRestrict LinearMap.id
    (toCycles C d dd n).surjective_rangeRestrict)

theorem boundarySection_rightInverse (n : ℕ) :
    (toCycles C d dd n).rangeRestrict.comp (boundarySection C d dd hC hH n) =
      LinearMap.id := by
  letI : Module.Projective R (boundaries C d dd n) :=
    projective_boundaries C d dd hC hH n
  exact Classical.choose_spec (Module.projective_lifting_property
    (toCycles C d dd n).rangeRestrict LinearMap.id
    (toCycles C d dd n).surjective_rangeRestrict)

@[simp] theorem boundarySection_rangeRestrict (n : ℕ) (b : boundaries C d dd n) :
    (toCycles C d dd n).rangeRestrict (boundarySection C d dd hC hH n b) = b :=
  LinearMap.congr_fun (boundarySection_rightInverse C d dd hC hH n) b

@[simp] theorem toCycles_boundarySection (n : ℕ) (b : boundaries C d dd n) :
    toCycles C d dd n (boundarySection C d dd hC hH n b) = b.val := by
  exact congrArg Subtype.val
    (LinearMap.congr_fun (boundarySection_rightInverse C d dd hC hH n) b)

/-- Projection of cycles onto boundaries along the chosen homology
representatives. Both the quotient and its chosen section are explicit. -/
def boundaryProjection (n : ℕ) : cycles C d n →ₗ[R] boundaries C d dd n :=
  (LinearMap.id - (homologySection C d dd hH n).comp
    (boundaries C d dd n).mkQ).codRestrict (boundaries C d dd n) (by
      intro x
      apply (Submodule.Quotient.mk_eq_zero (boundaries C d dd n)).mp
      change (boundaries C d dd n).mkQ
        (x - homologySection C d dd hH n ((boundaries C d dd n).mkQ x)) = 0
      rw [map_sub]
      rw [homologySection_mkQ, sub_self])

@[simp] theorem boundaryProjection_val (n : ℕ) (x : cycles C d n) :
    (boundaryProjection C d dd hH n x).val =
      x - homologySection C d dd hH n ((boundaries C d dd n).mkQ x) := rfl

@[simp] theorem boundaryProjection_on_boundary (n : ℕ) (b : boundaries C d dd n) :
    boundaryProjection C d dd hH n b.val = b := by
  apply Subtype.ext
  rw [boundaryProjection_val]
  have hb : (boundaries C d dd n).mkQ b.val = 0 :=
    (Submodule.Quotient.mk_eq_zero (boundaries C d dd n)).mpr b.property
  rw [hb, map_zero, sub_zero]

@[simp] theorem boundaryProjection_on_homology (n : ℕ) (y : Homology C d dd n) :
    boundaryProjection C d dd hH n (homologySection C d dd hH n y) = 0 := by
  apply Subtype.ext
  rw [boundaryProjection_val]
  rw [homologySection_mkQ, sub_self]
  rfl

/-- Remove the chosen lift of the outgoing boundary. The result lies in
the actual cycle module in the same homological degree. -/
def cycleProjection : (n : ℕ) → C n →ₗ[R] cycles C d n
  | 0 => (Submodule.topEquiv : (⊤ : Submodule R (C 0)) ≃ₗ[R] C 0).symm.toLinearMap
  | n + 1 =>
      (LinearMap.id - (boundarySection C d dd hC hH n).comp
        (toCycles C d dd n).rangeRestrict).codRestrict (cycles C d (n + 1)) (by
          intro x
          change d n (x - boundarySection C d dd hC hH n
            ((toCycles C d dd n).rangeRestrict x)) = 0
          have hs : d n (boundarySection C d dd hC hH n
              ((toCycles C d dd n).rangeRestrict x)) = d n x :=
            congrArg Subtype.val (toCycles_boundarySection C d dd hC hH n
              ((toCycles C d dd n).rangeRestrict x))
          rw [map_sub, hs, sub_self])

@[simp] theorem cycleProjection_zero_val (x : C 0) :
    (cycleProjection C d dd hC hH 0 x).val = x := rfl

@[simp] theorem cycleProjection_succ_val (n : ℕ) (x : C (n + 1)) :
    (cycleProjection C d dd hC hH (n + 1) x).val =
      x - boundarySection C d dd hC hH n ((toCycles C d dd n).rangeRestrict x) := rfl

@[simp] theorem cycleProjection_on_cycle (n : ℕ) (x : cycles C d n) :
    cycleProjection C d dd hC hH n x.val = x := by
  cases n with
  | zero => apply Subtype.ext; rfl
  | succ n =>
      apply Subtype.ext
      rw [cycleProjection_succ_val]
      have hx : (toCycles C d dd n).rangeRestrict x.val = 0 := by
        apply Subtype.ext
        apply Subtype.ext
        exact LinearMap.mem_ker.mp x.property
      rw [hx, map_zero, sub_zero]

@[simp] theorem cycleProjection_on_boundarySection (n : ℕ)
    (b : boundaries C d dd n) :
    cycleProjection C d dd hC hH (n + 1) (boundarySection C d dd hC hH n b) = 0 := by
  apply Subtype.ext
  rw [cycleProjection_succ_val]
  rw [boundarySection_rangeRestrict, sub_self]
  rfl

def homologyProjection (n : ℕ) : C n →ₗ[R] Homology C d dd n :=
  (boundaries C d dd n).mkQ.comp (cycleProjection C d dd hC hH n)

def homologyInclusion (n : ℕ) : Homology C d dd n →ₗ[R] C n :=
  (cycles C d n).subtype.comp (homologySection C d dd hH n)

def homotopy (n : ℕ) : C n →ₗ[R] C (n + 1) :=
  (boundarySection C d dd hC hH n).comp
    ((boundaryProjection C d dd hH n).comp (cycleProjection C d dd hC hH n))

@[simp] theorem homologyProjection_homologyInclusion (n : ℕ)
    (x : Homology C d dd n) :
    homologyProjection C d dd hC hH n (homologyInclusion C d dd hH n x) = x := by
  change (boundaries C d dd n).mkQ
    (cycleProjection C d dd hC hH n (homologySection C d dd hH n x).val) = x
  rw [cycleProjection_on_cycle]
  exact LinearMap.congr_fun (homologySection_rightInverse C d dd hH n) x

theorem homologyInclusion_is_cycle (n : ℕ) (x : Homology C d dd (n + 1)) :
    d n (homologyInclusion C d dd hH (n + 1) x) = 0 :=
  LinearMap.mem_ker.mp (homologySection C d dd hH (n + 1) x).property

theorem homologyProjection_kills_boundaries (n : ℕ) (x : C (n + 1)) :
    homologyProjection C d dd hC hH n (d n x) = 0 := by
  change (boundaries C d dd n).mkQ
    (cycleProjection C d dd hC hH n (toCycles C d dd n x).val) = 0
  rw [cycleProjection_on_cycle]
  exact (Submodule.Quotient.mk_eq_zero (boundaries C d dd n)).mpr ⟨x, rfl⟩

theorem differential_homotopy (n : ℕ) (x : C n) :
    d n (homotopy C d dd hC hH n x) =
      (cycleProjection C d dd hC hH n x).val -
        homologyInclusion C d dd hH n (homologyProjection C d dd hC hH n x) := by
  exact congrArg Subtype.val (toCycles_boundarySection C d dd hC hH n
    (boundaryProjection C d dd hH n (cycleProjection C d dd hC hH n x)))

theorem homotopy_differential (n : ℕ) (x : C (n + 1)) :
    homotopy C d dd hC hH n (d n x) =
      x - (cycleProjection C d dd hC hH (n + 1) x).val := by
  have he : homotopy C d dd hC hH n (d n x) =
      boundarySection C d dd hC hH n ((toCycles C d dd n).rangeRestrict x) := by
    change boundarySection C d dd hC hH n
      (boundaryProjection C d dd hH n
        (cycleProjection C d dd hC hH n (toCycles C d dd n x).val)) = _
    rw [cycleProjection_on_cycle]
    exact congrArg (boundarySection C d dd hC hH n)
      (boundaryProjection_on_boundary C d dd hH n
        ((toCycles C d dd n).rangeRestrict x))
  rw [he, cycleProjection_succ_val]
  abel

/-- The actual deformation-retract identity in positive degree. -/
theorem contraction_succ (n : ℕ) (x : C (n + 1)) :
    d (n + 1) (homotopy C d dd hC hH (n + 1) x) +
      homotopy C d dd hC hH n (d n x) =
      x - homologyInclusion C d dd hH (n + 1)
        (homologyProjection C d dd hC hH (n + 1) x) := by
  rw [differential_homotopy, homotopy_differential]
  abel

/-- The degree-zero identity has no omitted outgoing differential. -/
theorem contraction_zero (x : C 0) :
    d 0 (homotopy C d dd hC hH 0 x) =
      x - homologyInclusion C d dd hH 0 (homologyProjection C d dd hC hH 0 x) := by
  simpa only [cycleProjection_zero_val] using differential_homotopy C d dd hC hH 0 x

@[simp] theorem homotopy_homologyInclusion (n : ℕ) (x : Homology C d dd n) :
    homotopy C d dd hC hH n (homologyInclusion C d dd hH n x) = 0 := by
  change boundarySection C d dd hC hH n
    (boundaryProjection C d dd hH n
      (cycleProjection C d dd hC hH n (homologySection C d dd hH n x).val)) = 0
  rw [cycleProjection_on_cycle, boundaryProjection_on_homology, map_zero]

@[simp] theorem homologyProjection_homotopy (n : ℕ) (x : C n) :
    homologyProjection C d dd hC hH (n + 1) (homotopy C d dd hC hH n x) = 0 := by
  change (boundaries C d dd (n + 1)).mkQ
    (cycleProjection C d dd hC hH (n + 1)
      (boundarySection C d dd hC hH n
        (boundaryProjection C d dd hH n (cycleProjection C d dd hC hH n x)))) = 0
  rw [cycleProjection_on_boundarySection, map_zero]

@[simp] theorem homotopy_square (n : ℕ) (x : C n) :
    homotopy C d dd hC hH (n + 1) (homotopy C d dd hC hH n x) = 0 := by
  change boundarySection C d dd hC hH (n + 1)
    (boundaryProjection C d dd hH (n + 1)
      (cycleProjection C d dd hC hH (n + 1)
        (boundarySection C d dd hC hH n
          (boundaryProjection C d dd hH n (cycleProjection C d dd hC hH n x))))) = 0
  rw [cycleProjection_on_boundarySection, map_zero, map_zero]

end Complex
end FourPapers.ProjectiveComplexSplitting

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.HomologicalPerturbation -/
section

/-!
# Algebraic identities for homological perturbation

This file proves the perturbation identities in an arbitrary, possibly
noncommutative ring. Applied to a ring of module endomorphisms, `p` is the
projection onto chosen homology representatives and `h` is a contraction of
its complementary acyclic summand. Invertibility of `1 + δ * h` and
`1 + h * δ` is explicit; applications must prove it, for example by a
strictly decreasing nonnegative degree. No inverse is assumed to exist by
definition and no homology or exactness assertion is built into the target.
-/

section
set_option autoImplicit false
noncomputable section

namespace FourPapers.HomologicalPerturbation

variable {A : Type*} [Ring A]

/-- A contraction onto a summand with zero differential, in endomorphism-ring
notation. The side conditions give a strong deformation retract. -/
structure Contraction (d h p : A) : Prop where
  differential : d * d = 0
  projection : p * p = p
  cycles : d * p = 0
  killsBoundaries : p * d = 0
  homotopy : d * h + h * d = 1 - p
  squareHomotopy : h * h = 0
  homotopyProjection : h * p = 0
  projectionHomotopy : p * h = 0

/-- The finite geometric inverse in applications is packaged as a genuine
unit. This definition uses the unit's checked inverse, not a totalized
inverse on an arbitrary ring. -/
def correction (u : Aˣ) (δ : A) : A := (↑(u⁻¹) : A) * δ

lemma correction_left (u : Aˣ) (δ : A) :
    (u : A) * correction u δ = δ := by
  simp [correction, ← mul_assoc]

lemma correction_right (u v : Aˣ) (δ h : A)
    (hu : (u : A) = 1 + δ * h) (hv : (v : A) = 1 + h * δ) :
    correction u δ * (v : A) = δ := by
  apply u.isUnit.mul_left_cancel
  rw [← mul_assoc, correction_left, hu, hv]
  noncomm_ring

lemma correction_left_equation (u : Aˣ) (δ h : A)
    (hu : (u : A) = 1 + δ * h) :
    correction u δ + δ * h * correction u δ = δ := by
  calc
    _ = (1 + δ * h) * correction u δ := by noncomm_ring
    _ = δ := by rw [← hu, correction_left]

lemma correction_right_equation (u v : Aˣ) (δ h : A)
    (hu : (u : A) = 1 + δ * h) (hv : (v : A) = 1 + h * δ) :
    correction u δ + correction u δ * h * δ = δ := by
  calc
    _ = correction u δ * (1 + h * δ) := by noncomm_ring
    _ = δ := by rw [← hv, correction_right u v δ h hu hv]

/-- The transferred perturbation obeys its Maurer--Cartan equation. The
proof multiplies by the two units and reduces to `(d + δ)^2 = 0`. -/
theorem correction_twisting (d h p δ : A) (C : Contraction d h p)
    (u v : Aˣ) (hu : (u : A) = 1 + δ * h)
    (hv : (v : A) = 1 + h * δ)
    (hD : (d + δ) * (d + δ) = 0) :
    d * correction u δ + correction u δ * d +
      correction u δ * p * correction u δ = 0 := by
  have hmc : d * δ + δ * d + δ * δ = 0 := by
    calc
      _ = (d + δ) * (d + δ) - d * d := by noncomm_ring
      _ = 0 := by rw [hD, C.differential, sub_self]
  have hc : h * d + d * h + p = 1 := by
    rw [add_comm (h * d) (d * h), C.homotopy]
    noncomm_ring
  apply v.isUnit.mul_right_cancel
  apply u.isUnit.mul_left_cancel
  rw [zero_mul, mul_zero]
  calc
    (u : A) *
        ((d * correction u δ + correction u δ * d +
          correction u δ * p * correction u δ) * (v : A)) =
        (u : A) * d * (correction u δ * (v : A)) +
        ((u : A) * correction u δ) * d * (v : A) +
        ((u : A) * correction u δ) * p * (correction u δ * (v : A)) := by
          noncomm_ring
    _ = (u : A) * d * δ + δ * d * (v : A) + δ * p * δ := by
      simp only [correction_left, correction_right u v δ h hu hv]
    _ = d * δ + δ * d + δ * (h * d + d * h + p) * δ := by
      rw [hu, hv]
      noncomm_ring
    _ = 0 := by rw [hc, mul_one, hmc]

section Transfer

variable (d h p δ a : A) (C : Contraction d h p)
  (haL : a + δ * h * a = δ) (haR : a + a * h * δ = δ)
  (haD : d * a + a * d + a * p * a = 0)

include haL in
lemma correction_cancel_left : δ - a - δ * h * a = 0 := by
  calc
    _ = δ - (a + δ * h * a) := by noncomm_ring
    _ = 0 := by rw [haL, sub_self]

include haR in
lemma correction_cancel_right : δ - a - a * h * δ = 0 := by
  calc
    _ = δ - (a + a * h * δ) := by noncomm_ring
    _ = 0 := by rw [haR, sub_self]

include haD in
lemma differential_correction : d * a = -(a * d) - a * p * a := by
  calc
    _ = (d * a + a * d + a * p * a) - (a * d + a * p * a) := by
      noncomm_ring
    _ = _ := by rw [haD]; noncomm_ring

include haD in
lemma correction_differential : a * d = -(d * a) - a * p * a := by
  calc
    _ = (d * a + a * d + a * p * a) - (d * a + a * p * a) := by
      noncomm_ring
    _ = _ := by rw [haD]; noncomm_ring

include C in
lemma differential_homotopy : d * h = 1 - p - h * d := by
  calc
    _ = (d * h + h * d) - h * d := by noncomm_ring
    _ = _ := by rw [C.homotopy]

include C in
lemma homotopy_differential : h * d = 1 - p - d * h := by
  calc
    _ = (d * h + h * d) - d * h := by noncomm_ring
    _ = _ := by rw [C.homotopy]

include C haL haD in
/-- The corrected inclusion is a chain map to the perturbed complex. -/
theorem inclusion_chain :
    (d + δ) * (1 - h * a) * p = (1 - h * a) * p * a * p := by
  calc
    _ = d * p + δ * p - (d * h) * a * p - δ * h * a * p := by
      noncomm_ring
    _ = δ * p - (1 - p - h * d) * a * p - δ * h * a * p := by
      rw [C.cycles, zero_add, differential_homotopy d h p C]
    _ = (δ - a - δ * h * a) * p + p * a * p + h * (d * a) * p := by
      noncomm_ring
    _ = p * a * p + h * (-(a * d) - a * p * a) * p := by
      rw [correction_cancel_left h δ a haL, zero_mul, zero_add,
        differential_correction d p a haD]
    _ = (1 - h * a) * p * a * p - h * a * (d * p) := by noncomm_ring
    _ = _ := by rw [C.cycles, mul_zero, sub_zero]

include C haR haD in
/-- The corrected projection is a chain map from the perturbed complex. -/
theorem projection_chain :
    p * (1 - a * h) * (d + δ) = p * a * p * (1 - a * h) := by
  calc
    _ = p * d + p * δ - p * a * (h * d) - p * a * h * δ := by
      noncomm_ring
    _ = p * δ - p * a * (1 - p - d * h) - p * a * h * δ := by
      rw [C.killsBoundaries, zero_add, homotopy_differential d h p C]
    _ = p * (δ - a - a * h * δ) + p * a * p + p * (a * d) * h := by
      noncomm_ring
    _ = p * a * p + p * (-(d * a) - a * p * a) * h := by
      rw [correction_cancel_right h δ a haR, mul_zero, zero_add,
        correction_differential d p a haD]
    _ = p * a * p * (1 - a * h) - (p * d) * a * h := by noncomm_ring
    _ = _ := by rw [C.killsBoundaries, zero_mul, zero_mul, sub_zero]

include C in
/-- The projection followed by inclusion is exactly the original summand's
identity. This is stronger than equality on homology. -/
theorem projection_inclusion :
    p * (1 - a * h) * (1 - h * a) * p = p := by
  calc
    _ = p * p - (p * a) * (h * p) - (p * h) * (a * p) +
        (p * a) * (h * h) * (a * p) := by noncomm_ring
    _ = p := by
      rw [C.projection, C.homotopyProjection, C.projectionHomotopy,
        C.squareHomotopy]
      simp

include C haD in
/-- The transferred differential is genuinely square zero. -/
theorem transferred_square_zero : (p * a * p) * (p * a * p) = 0 := by
  have haa : a * p * a = -(d * a) - a * d := by
    calc
      _ = (d * a + a * d + a * p * a) - (d * a + a * d) := by noncomm_ring
      _ = _ := by rw [haD]; noncomm_ring
  calc
    _ = p * a * (p * p) * a * p := by noncomm_ring
    _ = p * (a * p * a) * p := by rw [C.projection]; noncomm_ring
    _ = -(p * d) * a * p - p * a * (d * p) := by rw [haa]; noncomm_ring
    _ = 0 := by rw [C.killsBoundaries, C.cycles]; simp

include C haL haR haD in
/-- The corrected homotopy witnesses an actual deformation retract. -/
theorem transferred_homotopy :
    (d + δ) * (h - h * a * h) + (h - h * a * h) * (d + δ) =
      1 - (1 - h * a) * p * (1 - a * h) := by
  have hl : δ * h - δ * h * a * h = a * h := by
    calc
      _ = (δ - a - δ * h * a) * h + a * h := by noncomm_ring
      _ = _ := by rw [correction_cancel_left h δ a haL]; simp
  have hr : h * δ - h * a * h * δ = h * a := by
    calc
      _ = h * (δ - a - a * h * δ) + h * a := by noncomm_ring
      _ = _ := by rw [correction_cancel_right h δ a haR]; simp
  have htw : d * a + a * d = -(a * p * a) := by
    calc
      _ = (d * a + a * d + a * p * a) - a * p * a := by noncomm_ring
      _ = _ := by rw [haD]; simp
  calc
    _ = (d * h + h * d) + (δ * h - δ * h * a * h) +
        (h * δ - h * a * h * δ) - (d * h) * a * h - h * a * (h * d) := by
          noncomm_ring
    _ = (1 - p) + a * h + h * a - (1 - p - h * d) * a * h -
        h * a * (1 - p - d * h) := by
      linear_combination (norm := noncomm_ring)
        C.homotopy + hl + hr - (differential_homotopy d h p C) * a * h -
          h * a * (homotopy_differential d h p C)
    _ = 1 - p + p * a * h + h * a * p + h * (d * a + a * d) * h := by
      noncomm_ring
    _ = _ := by rw [htw]; noncomm_ring

end Transfer
end FourPapers.HomologicalPerturbation

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.LinearPerturbation -/
section

/-!
# Perturbing a linear contraction onto an actual module

Unlike a rank comparison, the output consists of a differential, two chain
maps, and an explicit chain homotopy. The target can therefore be an actual
homology module with its previously established basis. In the polynomial
application, strict decrease of internal degree constructs the two required
units, and the transferred differential has entries in the variable ideal.
-/

section
set_option autoImplicit false
noncomputable section

namespace FourPapers.HomologicalPerturbation

variable {R M H : Type*} [CommRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup H] [Module R H]

structure LinearContraction where
  d : Module.End R M
  h : Module.End R M
  inclusion : H →ₗ[R] M
  projection : M →ₗ[R] H
  differential : d * d = 0
  retract : projection.comp inclusion = LinearMap.id
  inclusion_cycle : d.comp inclusion = 0
  projection_boundary : projection.comp d = 0
  homotopy : d * h + h * d = 1 - inclusion.comp projection
  squareHomotopy : h * h = 0
  homotopyInclusion : h.comp inclusion = 0
  projectionHomotopy : projection.comp h = 0

namespace LinearContraction

variable (C : LinearContraction (R := R) (M := M) (H := H))

@[simp] theorem projection_inclusion_apply (x : H) :
    C.projection (C.inclusion x) = x := LinearMap.congr_fun C.retract x

@[simp] theorem differential_inclusion_apply (x : H) :
    C.d (C.inclusion x) = 0 := LinearMap.congr_fun C.inclusion_cycle x

@[simp] theorem projection_differential_apply (x : M) :
    C.projection (C.d x) = 0 := LinearMap.congr_fun C.projection_boundary x

@[simp] theorem homotopy_inclusion_apply (x : H) :
    C.h (C.inclusion x) = 0 := LinearMap.congr_fun C.homotopyInclusion x

@[simp] theorem projection_homotopy_apply (x : M) :
    C.projection (C.h x) = 0 := LinearMap.congr_fun C.projectionHomotopy x

@[simp] theorem homotopy_square_apply (x : M) : C.h (C.h x) = 0 :=
  LinearMap.congr_fun C.squareHomotopy x

theorem inclusion_injective : Function.Injective C.inclusion := by
  intro x y h
  have he := congrArg C.projection h
  simpa only [C.projection_inclusion_apply] using he

def summandProjection : Module.End R M := C.inclusion.comp C.projection

@[simp] theorem summandProjection_apply (x : M) :
    C.summandProjection x = C.inclusion (C.projection x) := rfl

def ringContraction : Contraction C.d C.h C.summandProjection where
  differential := C.differential
  projection := by
    ext x
    change C.inclusion (C.projection (C.inclusion (C.projection x))) =
      C.inclusion (C.projection x)
    rw [C.projection_inclusion_apply]
  cycles := by
    ext x
    exact C.differential_inclusion_apply (C.projection x)
  killsBoundaries := by
    ext x
    change C.inclusion (C.projection (C.d x)) = 0
    rw [C.projection_differential_apply, map_zero]
  homotopy := C.homotopy
  squareHomotopy := C.squareHomotopy
  homotopyProjection := by
    ext x
    exact C.homotopy_inclusion_apply (C.projection x)
  projectionHomotopy := by
    ext x
    change C.inclusion (C.projection (C.h x)) = 0
    rw [C.projection_homotopy_apply, map_zero]

variable (δ : Module.End R M) (u v : (Module.End R M)ˣ)
  (hu : (u : Module.End R M) = 1 + δ * C.h)
  (hv : (v : Module.End R M) = 1 + C.h * δ)
  (hD : (C.d + δ) * (C.d + δ) = 0)

def transferredDifferential : Module.End R H :=
  C.projection.comp ((correction u δ).comp C.inclusion)

def transferredInclusion : H →ₗ[R] M :=
  (1 - C.h * correction u δ).comp C.inclusion

def transferredProjection : M →ₗ[R] H :=
  C.projection.comp (1 - correction u δ * C.h)

def transferredHomotopy : Module.End R M := C.h - C.h * correction u δ * C.h

theorem transferred_retract :
    (C.transferredProjection δ u).comp (C.transferredInclusion δ u) = LinearMap.id := by
  ext x
  let a := correction u δ
  have hh : C.h ((1 - C.h * a) (C.inclusion x)) = 0 := by
    change C.h (C.inclusion x - C.h (a (C.inclusion x))) = 0
    rw [map_sub, C.homotopy_inclusion_apply, C.homotopy_square_apply, sub_self]
  change C.projection ((1 - C.h * a) (C.inclusion x) -
    a (C.h ((1 - C.h * a) (C.inclusion x)))) = x
  rw [hh, map_zero, sub_zero]
  change C.projection (C.inclusion x - C.h (a (C.inclusion x))) = x
  rw [map_sub, C.projection_inclusion_apply, C.projection_homotopy_apply, sub_zero]

theorem transferredInclusion_injective : Function.Injective (C.transferredInclusion δ u) := by
  intro x y he
  have hf := congrArg (C.transferredProjection δ u) he
  simpa only [← LinearMap.comp_apply, C.transferred_retract δ u, LinearMap.id_apply] using hf

include v hu hv hD in
theorem transferred_inclusion_chain :
    (C.d + δ).comp (C.transferredInclusion δ u) =
      (C.transferredInclusion δ u).comp (C.transferredDifferential δ u) := by
  ext x
  have ht := correction_twisting C.d C.h C.summandProjection δ C.ringContraction
    u v hu hv hD
  have he := LinearMap.congr_fun
    (inclusion_chain C.d C.h C.summandProjection δ (correction u δ) C.ringContraction
      (correction_left_equation u δ C.h hu) ht) (C.inclusion x)
  change (C.d + δ) ((1 - C.h * correction u δ)
      (C.summandProjection (C.inclusion x))) =
    (1 - C.h * correction u δ)
      (C.summandProjection (correction u δ (C.summandProjection (C.inclusion x)))) at he
  simpa only [C.summandProjection_apply, C.projection_inclusion_apply,
    transferredInclusion, transferredDifferential, LinearMap.comp_apply] using he

include v hu hv hD in
theorem transferred_projection_chain :
    (C.transferredProjection δ u).comp (C.d + δ) =
      (C.transferredDifferential δ u).comp (C.transferredProjection δ u) := by
  ext x
  apply C.inclusion_injective
  have ht := correction_twisting C.d C.h C.summandProjection δ C.ringContraction
    u v hu hv hD
  have he := LinearMap.congr_fun
    (projection_chain C.d C.h C.summandProjection δ (correction u δ) C.ringContraction
      (correction_right_equation u v δ C.h hu hv) ht) x
  exact he

include v hu hv hD in
theorem transferredDifferential_square :
    C.transferredDifferential δ u * C.transferredDifferential δ u = 0 := by
  ext x
  apply C.transferredInclusion_injective δ u
  have hc (y : H) : (C.d + δ) (C.transferredInclusion δ u y) =
      C.transferredInclusion δ u (C.transferredDifferential δ u y) :=
    LinearMap.congr_fun (C.transferred_inclusion_chain δ u v hu hv hD) y
  change C.transferredInclusion δ u
    (C.transferredDifferential δ u (C.transferredDifferential δ u x)) =
      C.transferredInclusion δ u 0
  rw [← hc, ← hc]
  have hz : (C.d + δ) ((C.d + δ) (C.transferredInclusion δ u x)) = 0 :=
    LinearMap.congr_fun hD (C.transferredInclusion δ u x)
  rw [hz, map_zero]

include v hu hv hD in
theorem transferred_homotopy_identity :
    (C.d + δ) * C.transferredHomotopy δ u +
      C.transferredHomotopy δ u * (C.d + δ) =
      1 - (C.transferredInclusion δ u).comp (C.transferredProjection δ u) := by
  have ht := correction_twisting C.d C.h C.summandProjection δ C.ringContraction
    u v hu hv hD
  exact transferred_homotopy C.d C.h C.summandProjection δ (correction u δ)
    C.ringContraction (correction_left_equation u δ C.h hu)
    (correction_right_equation u v δ C.h hu hv) ht

end LinearContraction
end FourPapers.HomologicalPerturbation

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.TotalComplexContraction -/
section

/-!
# A total contraction obtained from the actual degreewise homology

The direct sum retains every homological degree. Its differential is the
given differential, its projection uses the actual kernel/image quotient,
and its homotopy comes from the projective splittings constructed in
`ProjectiveComplexSplitting`. No assertion that a complex is formal is
assumed: the strong deformation-retract identities are proved here.
-/

section
set_option autoImplicit false
noncomputable section

namespace FourPapers.ProjectiveComplexSplitting

open DirectSum

variable {R : Type*} [CommRing R]
  (C : ℕ → Type*) [∀ n, AddCommGroup (C n)] [∀ n, Module R (C n)]
  (d : ∀ n, C (n + 1) →ₗ[R] C n)
  (dd : ∀ n, (d n).comp (d (n + 1)) = 0)
  (hC : ∀ n, Module.Projective R (C n))
  (hH : ∀ n, Module.Projective R (Homology C d dd n))

def totalDifferential : Module.End R (⨁ n, C n) :=
  DirectSum.toModule R ℕ _ (fun n =>
    match n with
    | 0 => 0
    | n + 1 => (DirectSum.lof R ℕ C n).comp (d n))

def totalHomotopy : Module.End R (⨁ n, C n) :=
  DirectSum.toModule R ℕ _ (fun n =>
    (DirectSum.lof R ℕ C (n + 1)).comp (homotopy C d dd hC hH n))

def totalProjection : Module.End R (⨁ n, C n) :=
  DirectSum.toModule R ℕ _ (fun n =>
    (DirectSum.lof R ℕ C n).comp ((homologyInclusion C d dd hH n).comp
      (homologyProjection C d dd hC hH n)))

@[simp] theorem totalDifferential_lof_zero (x : C 0) :
    totalDifferential C d (DirectSum.lof R ℕ C 0 x) = 0 := by
  simp only [totalDifferential, DirectSum.toModule_lof, LinearMap.zero_apply]

@[simp] theorem totalDifferential_lof_succ (n : ℕ) (x : C (n + 1)) :
    totalDifferential C d (DirectSum.lof R ℕ C (n + 1) x) =
      DirectSum.lof R ℕ C n (d n x) := by
  simp only [totalDifferential, DirectSum.toModule_lof, LinearMap.comp_apply]

@[simp] theorem totalHomotopy_lof (n : ℕ) (x : C n) :
    totalHomotopy C d dd hC hH (DirectSum.lof R ℕ C n x) =
      DirectSum.lof R ℕ C (n + 1) (homotopy C d dd hC hH n x) := by
  simp only [totalHomotopy, DirectSum.toModule_lof, LinearMap.comp_apply]

@[simp] theorem totalProjection_lof (n : ℕ) (x : C n) :
    totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x) =
      DirectSum.lof R ℕ C n (homologyInclusion C d dd hH n
        (homologyProjection C d dd hC hH n x)) := by
  simp only [totalProjection, DirectSum.toModule_lof, LinearMap.comp_apply]

include dd in
theorem totalDifferential_square : totalDifferential C d * totalDifferential C d = 0 := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalDifferential C d (totalDifferential C d (DirectSum.lof R ℕ C n x)) = 0
  cases n with
  | zero => rw [totalDifferential_lof_zero, map_zero]
  | succ n =>
      rw [totalDifferential_lof_succ]
      cases n with
      | zero => rw [totalDifferential_lof_zero]
      | succ n =>
          rw [totalDifferential_lof_succ]
          have hdd : d n (d (n + 1) x) = 0 := LinearMap.congr_fun (dd n) x
          rw [hdd, map_zero]

theorem totalProjection_square :
    totalProjection C d dd hC hH * totalProjection C d dd hC hH =
      totalProjection C d dd hC hH := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalProjection C d dd hC hH
      (totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x)) =
    totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x)
  simp only [totalProjection_lof, homologyProjection_homologyInclusion]

theorem totalProjection_cycles :
    totalDifferential C d * totalProjection C d dd hC hH = 0 := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalDifferential C d
    (totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x)) = 0
  rw [totalProjection_lof]
  cases n with
  | zero => rw [totalDifferential_lof_zero]
  | succ n => rw [totalDifferential_lof_succ, homologyInclusion_is_cycle, map_zero]

theorem totalProjection_kills_boundaries :
    totalProjection C d dd hC hH * totalDifferential C d = 0 := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalProjection C d dd hC hH
    (totalDifferential C d (DirectSum.lof R ℕ C n x)) = 0
  cases n with
  | zero => rw [totalDifferential_lof_zero, map_zero]
  | succ n =>
      rw [totalDifferential_lof_succ, totalProjection_lof,
        homologyProjection_kills_boundaries, map_zero, map_zero]

theorem total_homotopy_identity :
    totalDifferential C d * totalHomotopy C d dd hC hH +
      totalHomotopy C d dd hC hH * totalDifferential C d =
      1 - totalProjection C d dd hC hH := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalDifferential C d
        (totalHomotopy C d dd hC hH (DirectSum.lof R ℕ C n x)) +
      totalHomotopy C d dd hC hH
        (totalDifferential C d (DirectSum.lof R ℕ C n x)) =
    DirectSum.lof R ℕ C n x - totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x)
  rw [totalHomotopy_lof, totalDifferential_lof_succ, totalProjection_lof]
  cases n with
  | zero =>
      rw [totalDifferential_lof_zero, map_zero, add_zero,
        contraction_zero, map_sub]
  | succ n =>
      rw [totalDifferential_lof_succ, totalHomotopy_lof, ← map_add,
        contraction_succ, map_sub]

theorem totalHomotopy_square :
    totalHomotopy C d dd hC hH * totalHomotopy C d dd hC hH = 0 := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalHomotopy C d dd hC hH
    (totalHomotopy C d dd hC hH (DirectSum.lof R ℕ C n x)) = 0
  rw [totalHomotopy_lof, totalHomotopy_lof, homotopy_square, map_zero]

theorem totalHomotopy_projection :
    totalHomotopy C d dd hC hH * totalProjection C d dd hC hH = 0 := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalHomotopy C d dd hC hH
    (totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x)) = 0
  rw [totalProjection_lof, totalHomotopy_lof, homotopy_homologyInclusion, map_zero]

theorem totalProjection_homotopy :
    totalProjection C d dd hC hH * totalHomotopy C d dd hC hH = 0 := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalProjection C d dd hC hH
    (totalHomotopy C d dd hC hH (DirectSum.lof R ℕ C n x)) = 0
  rw [totalHomotopy_lof, totalProjection_lof, homologyProjection_homotopy,
    map_zero, map_zero]

/-- The full strong deformation retract, with all eight identities proved
from projectivity of the complex terms and their actual homology. -/
theorem totalContraction : HomologicalPerturbation.Contraction
    (totalDifferential C d) (totalHomotopy C d dd hC hH) (totalProjection C d dd hC hH) where
  differential := totalDifferential_square C d dd
  projection := totalProjection_square C d dd hC hH
  cycles := totalProjection_cycles C d dd hC hH
  killsBoundaries := totalProjection_kills_boundaries C d dd hC hH
  homotopy := total_homotopy_identity C d dd hC hH
  squareHomotopy := totalHomotopy_square C d dd hC hH
  homotopyProjection := totalHomotopy_projection C d dd hC hH
  projectionHomotopy := totalProjection_homotopy C d dd hC hH

/-- The target of the contraction retains the literal homology quotient in
every degree. It is not a new module defined by a chosen rank. -/
abbrev TotalHomology := ⨁ n, Homology C d dd n

def totalHomologyInclusion : TotalHomology C d dd →ₗ[R] (⨁ n, C n) :=
  DirectSum.toModule R ℕ _ (fun n =>
    (DirectSum.lof R ℕ C n).comp (homologyInclusion C d dd hH n))

def totalHomologyProjection : (⨁ n, C n) →ₗ[R] TotalHomology C d dd :=
  DirectSum.toModule R ℕ _ (fun n =>
    (DirectSum.lof R ℕ (Homology C d dd) n).comp
      (homologyProjection C d dd hC hH n))

@[simp] theorem totalHomologyInclusion_lof (n : ℕ) (x : Homology C d dd n) :
    totalHomologyInclusion C d dd hH
      (DirectSum.lof R ℕ (Homology C d dd) n x) =
        DirectSum.lof R ℕ C n (homologyInclusion C d dd hH n x) := by
  simp only [totalHomologyInclusion, DirectSum.toModule_lof, LinearMap.comp_apply]

@[simp] theorem totalHomologyProjection_lof (n : ℕ) (x : C n) :
    totalHomologyProjection C d dd hC hH (DirectSum.lof R ℕ C n x) =
      DirectSum.lof R ℕ (Homology C d dd) n
        (homologyProjection C d dd hC hH n x) := by
  simp only [totalHomologyProjection, DirectSum.toModule_lof, LinearMap.comp_apply]

theorem totalHomology_retract :
    (totalHomologyProjection C d dd hC hH).comp
      (totalHomologyInclusion C d dd hH) = LinearMap.id := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalHomologyProjection C d dd hC hH
    (totalHomologyInclusion C d dd hH
      (DirectSum.lof R ℕ (Homology C d dd) n x)) =
        DirectSum.lof R ℕ (Homology C d dd) n x
  rw [totalHomologyInclusion_lof, totalHomologyProjection_lof,
    homologyProjection_homologyInclusion]

theorem totalHomology_projection :
    (totalHomologyInclusion C d dd hH).comp
      (totalHomologyProjection C d dd hC hH) =
        totalProjection C d dd hC hH := by
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro x
  change totalHomologyInclusion C d dd hH
    (totalHomologyProjection C d dd hC hH (DirectSum.lof R ℕ C n x)) =
      totalProjection C d dd hC hH (DirectSum.lof R ℕ C n x)
  rw [totalHomologyProjection_lof, totalHomologyInclusion_lof, totalProjection_lof]

/-- A linear strong deformation retract onto the actual direct sum of
homology, ready for scalar extension and the perturbation construction. -/
def totalLinearContraction : HomologicalPerturbation.LinearContraction
    (R := R) (M := ⨁ n, C n) (H := TotalHomology C d dd) where
  d := totalDifferential C d
  h := totalHomotopy C d dd hC hH
  inclusion := totalHomologyInclusion C d dd hH
  projection := totalHomologyProjection C d dd hC hH
  differential := totalDifferential_square C d dd
  retract := totalHomology_retract C d dd hC hH
  inclusion_cycle := by
    apply DirectSum.linearMap_ext
    intro n
    apply LinearMap.ext
    intro x
    change totalDifferential C d
      (totalHomologyInclusion C d dd hH
        (DirectSum.lof R ℕ (Homology C d dd) n x)) = 0
    rw [totalHomologyInclusion_lof]
    cases n with
    | zero => rw [totalDifferential_lof_zero]
    | succ n => rw [totalDifferential_lof_succ, homologyInclusion_is_cycle, map_zero]
  projection_boundary := by
    apply DirectSum.linearMap_ext
    intro n
    apply LinearMap.ext
    intro x
    change totalHomologyProjection C d dd hC hH
      (totalDifferential C d (DirectSum.lof R ℕ C n x)) = 0
    cases n with
    | zero => rw [totalDifferential_lof_zero, map_zero]
    | succ n =>
        rw [totalDifferential_lof_succ, totalHomologyProjection_lof,
          homologyProjection_kills_boundaries, map_zero]
  homotopy := by
    rw [totalHomology_projection]
    exact total_homotopy_identity C d dd hC hH
  squareHomotopy := totalHomotopy_square C d dd hC hH
  homotopyInclusion := by
    apply DirectSum.linearMap_ext
    intro n
    apply LinearMap.ext
    intro x
    change totalHomotopy C d dd hC hH
      (totalHomologyInclusion C d dd hH
        (DirectSum.lof R ℕ (Homology C d dd) n x)) = 0
    rw [totalHomologyInclusion_lof, totalHomotopy_lof,
      homotopy_homologyInclusion, map_zero]
  projectionHomotopy := by
    apply DirectSum.linearMap_ext
    intro n
    apply LinearMap.ext
    intro x
    change totalHomologyProjection C d dd hC hH
      (totalHomotopy C d dd hC hH (DirectSum.lof R ℕ C n x)) = 0
    rw [totalHomotopy_lof, totalHomologyProjection_lof,
      homologyProjection_homotopy, map_zero]

end FourPapers.ProjectiveComplexSplitting

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.DirectSumContraction -/
section

/-! # Direct sums of actual strong contractions, without a finiteness restriction -/

section
set_option autoImplicit false
noncomputable section

namespace FourPapers.HomologicalPerturbation.LinearContraction

open DirectSum

variable {R I : Type*} [CommRing R] [DecidableEq I]
  {M H : I → Type*}
  [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
  [∀ i, AddCommGroup (H i)] [∀ i, Module R (H i)]
  (C : ∀ i, LinearContraction (R := R) (M := M i) (H := H i))

/-- Every map acts componentwise on a finite-support direct sum. -/
def directSum : LinearContraction (R := R) (M := ⨁ i, M i) (H := ⨁ i, H i) where
  d := DirectSum.lmap (fun i => (C i).d)
  h := DirectSum.lmap (fun i => (C i).h)
  inclusion := DirectSum.lmap (fun i => (C i).inclusion)
  projection := DirectSum.lmap (fun i => (C i).projection)
  differential := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact LinearMap.congr_fun (C i).differential (x i)
  retract := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact (C i).projection_inclusion_apply (x i)
  inclusion_cycle := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact (C i).differential_inclusion_apply (x i)
  projection_boundary := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact (C i).projection_differential_apply (x i)
  homotopy := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact LinearMap.congr_fun (C i).homotopy (x i)
  squareHomotopy := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact (C i).homotopy_square_apply (x i)
  homotopyInclusion := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact (C i).homotopy_inclusion_apply (x i)
  projectionHomotopy := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    exact (C i).projection_homotopy_apply (x i)

@[simp] theorem directSum_d_lof (i : I) (x : M i) :
    (directSum C).d (DirectSum.lof R I M i x) =
      DirectSum.lof R I M i ((C i).d x) :=
  DirectSum.lmap_lof _ _ _

@[simp] theorem directSum_h_lof (i : I) (x : M i) :
    (directSum C).h (DirectSum.lof R I M i x) =
      DirectSum.lof R I M i ((C i).h x) :=
  DirectSum.lmap_lof _ _ _

@[simp] theorem directSum_inclusion_lof (i : I) (x : H i) :
    (directSum C).inclusion (DirectSum.lof R I H i x) =
      DirectSum.lof R I M i ((C i).inclusion x) :=
  DirectSum.lmap_lof _ _ _

@[simp] theorem directSum_projection_lof (i : I) (x : M i) :
    (directSum C).projection (DirectSum.lof R I M i x) =
      DirectSum.lof R I H i ((C i).projection x) :=
  DirectSum.lmap_lof _ _ _

end FourPapers.HomologicalPerturbation.LinearContraction

namespace FourPapers

open DirectSum

variable {R I : Type*} [CommRing R] [DecidableEq I] {M J : I → Type*}
  [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]

theorem directSum_basis_repr (b : ∀ i, Module.Basis (J i) R (M i))
    (x : ⨁ i, M i) (a : Σ i, J i) :
    (DFinsupp.basis b).repr x a = (b a.1).repr (x a.1) a.2 := rfl

theorem directSum_basis_apply (b : ∀ i, Module.Basis (J i) R (M i))
    (i : I) (j : J i) :
    DFinsupp.basis b ⟨i,j⟩ = DirectSum.lof R I M i (b i j) := by
  classical
  apply (DFinsupp.basis b).repr.injective
  ext a
  rcases a with ⟨k,l⟩
  rw [Module.Basis.repr_self, directSum_basis_repr]
  by_cases h : i = k
  · subst k
    simp only [DirectSum.lof_eq_of, DirectSum.of_eq_same,
      Module.Basis.repr_self, Finsupp.single_apply]
    simp only [Sigma.mk.inj_iff, heq_eq_eq, true_and]
  · have he : (⟨i,j⟩ : Σ i, J i) ≠ ⟨k,l⟩ := fun hh => h (congrArg Sigma.fst hh)
    rw [Finsupp.single_eq_of_ne he.symm, DirectSum.lof_eq_of,
      DirectSum.of_eq_of_ne i k _ (Ne.symm h), map_zero, Finsupp.zero_apply]


section NestedBasis

variable {Q P : Type*} [DecidableEq Q] [DecidableEq P]
  {H : Q → P → Type*} [∀ q p, AddCommGroup (H q p)] [∀ q p, Module R (H q p)]
  {T : Q → P → Type*}

/-- The ordinary basis of a twice-indexed direct sum, exposed through a
named constructor so downstream homology quotients need not be expanded. -/
def nestedDirectSumBasis (b : ∀ q p, Module.Basis (T q p) R (H q p)) :
    Module.Basis (Σ q, Σ p, T q p) R (⨁ q, ⨁ p, H q p) :=
  DFinsupp.basis (fun q => DFinsupp.basis (b q))

@[simp] theorem nestedDirectSumBasis_apply
    (b : ∀ q p, Module.Basis (T q p) R (H q p)) (a : Σ q, Σ p, T q p) :
    nestedDirectSumBasis b a =
      DirectSum.lof R Q (fun q => ⨁ p, H q p) a.1
        (DirectSum.lof R P (H a.1) a.2.1 (b a.1 a.2.1 a.2.2)) := by
  rcases a with ⟨q,p,i⟩
  change DFinsupp.basis (fun q => DFinsupp.basis (b q)) ⟨q,p,i⟩ =
    DirectSum.lof R Q (fun q => ⨁ p, H q p) q
      (DirectSum.lof R P (H q) p (b q p i))
  have h₁ := directSum_basis_apply (R := R)
    (M := fun q => ⨁ p, H q p) (J := fun q => Σ p, T q p)
    (fun q => DFinsupp.basis (b q)) q ⟨p,i⟩
  have h₂ := directSum_basis_apply (R := R) (M := H q) (J := T q) (b q) p i
  exact h₁.trans (congrArg (DirectSum.lof R Q (fun q => ⨁ p, H q p) q) h₂)

attribute [irreducible] nestedDirectSumBasis

end NestedBasis

end FourPapers

end
end
end


end
