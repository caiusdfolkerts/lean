section

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 400000

noncomputable section
namespace FourPapers.TensorCycleSpanning
open Classical

section Grading
variable {K M I : Type*} [CommRing K] [AddCommGroup M] [Module K M] [Fintype I]

def degreePiece (b : Module.Basis I K M) (degree : I → ℕ) (j : ℕ) : Submodule K M :=
  Submodule.span K (b '' {i | degree i = j})

def degreeProjection (b : Module.Basis I K M) (degree : I → ℕ) (j : ℕ) : Module.End K M :=
  b.constr K (fun i => if degree i = j then b i else 0)

@[simp] theorem degreeProjection_basis (b : Module.Basis I K M) (degree : I → ℕ)
    (j : ℕ) (i : I) : degreeProjection b degree j (b i) =
      if degree i = j then b i else 0 := b.constr_basis _ _ _

theorem basis_mem_degreePiece (b : Module.Basis I K M) (degree : I → ℕ) (i : I) :
    b i ∈ degreePiece b degree (degree i) :=
  Submodule.subset_span ⟨i, rfl, rfl⟩

theorem degreeProjection_of_mem (b : Module.Basis I K M) (degree : I → ℕ)
    (i j : ℕ) {x : M} (hx : x ∈ degreePiece b degree j) :
    degreeProjection b degree i x = if j = i then x else 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    change degree a = j at ha
    simpa only [degreeProjection_basis, ha]
  | zero => simp
  | add x y hx hy ihx ihy => rw [map_add, ihx, ihy]; split_ifs <;> simp
  | smul c x hx ih => rw [map_smul, ih]; split_ifs <;> simp

theorem degreeProjection_mem (b : Module.Basis I K M) (degree : I → ℕ)
    (i : ℕ) (x : M) : degreeProjection b degree i x ∈ degreePiece b degree i := by
  rw [← b.sum_repr x, map_sum]
  apply Submodule.sum_mem
  intro a _
  rw [map_smul, degreeProjection_basis]
  split_ifs with h
  · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, h, rfl⟩)
  · simp

theorem sum_degreeProjection (b : Module.Basis I K M) (degree : I → ℕ) (x : M) :
    (∑ i ∈ Finset.univ.image degree, degreeProjection b degree i x) = x := by
  have hm : (∑ i ∈ Finset.univ.image degree, degreeProjection b degree i) =
      (1 : Module.End K M) := by
    apply b.ext
    intro a
    simp only [LinearMap.sum_apply, degreeProjection_basis, Module.End.one_apply]
    rw [Finset.sum_eq_single (degree a)]
    · simp
    · intro j _ hj
      exact if_neg (Ne.symm hj)
    · intro h
      exact (h (Finset.mem_image.mpr ⟨a, Finset.mem_univ a, rfl⟩)).elim
  simpa only [LinearMap.sum_apply, Module.End.one_apply] using LinearMap.congr_fun hm x

theorem degreeProjection_differential (b : Module.Basis I K M) (degree : I → ℕ)
    (d : Module.End K M)
    (hzero : ∀ x, x ∈ degreePiece b degree 0 → d x = 0)
    (hlowers : ∀ j x, x ∈ degreePiece b degree (j + 1) →
      d x ∈ degreePiece b degree j) (j : ℕ) :
    d * degreeProjection b degree (j + 1) = degreeProjection b degree j * d := by
  apply b.ext
  intro a
  simp only [Module.End.mul_apply, degreeProjection_basis]
  have ha := basis_mem_degreePiece b degree a
  cases hj : degree a with
  | zero =>
    have hd : d (b a) = 0 := hzero _ (hj ▸ ha)
    simp [hj, hd]
  | succ i =>
    have hd : d (b a) ∈ degreePiece b degree i := hlowers i _ (hj ▸ ha)
    rw [degreeProjection_of_mem b degree j i hd]
    by_cases hi : i = j <;> simp [hj, hi]

/-- Every total cycle of a finite graded based complex is a sum of genuine
homogeneous cycles. No choice of a homogeneous contraction is required. -/
theorem cycle_mem_span_homogeneous (b : Module.Basis I K M) (degree : I → ℕ)
    (d : Module.End K M)
    (hzero : ∀ x, x ∈ degreePiece b degree 0 → d x = 0)
    (hlowers : ∀ j x, x ∈ degreePiece b degree (j + 1) →
      d x ∈ degreePiece b degree j) {x : M} (hx : d x = 0) :
    x ∈ Submodule.span K {z | d z = 0 ∧ ∃ j, z ∈ degreePiece b degree j} := by
  rw [← sum_degreeProjection b degree x]
  apply Submodule.sum_mem
  intro j _
  apply Submodule.subset_span
  refine ⟨?_, j, degreeProjection_mem b degree j x⟩
  cases j with
  | zero => exact hzero _ (degreeProjection_mem b degree 0 x)
  | succ j =>
    have h := LinearMap.congr_fun (degreeProjection_differential b degree d hzero hlowers j) x
    simpa [Module.End.mul_apply, hx] using h

end Grading

section MultilinearSpan
variable {K I N : Type*} {M : I → Type*} [CommRing K] [Fintype I]
  [∀ i, AddCommGroup (M i)] [∀ i, Module K (M i)] [AddCommGroup N] [Module K N]

theorem multilinear_mem_span (f : MultilinearMap K M N) (S : ∀ i, Set (M i))
    (x : ∀ i, M i) (hx : ∀ i, x i ∈ Submodule.span K (S i)) :
    f x ∈ Submodule.span K {z | ∃ y : ∀ i, M i, (∀ i, y i ∈ S i) ∧ f y = z} := by
  suffices h : ∀ T : Finset I, ∀ x : ∀ i, M i,
      (∀ i, x i ∈ Submodule.span K (S i)) →
      (∀ i ∉ T, x i ∈ S i) →
      f x ∈ Submodule.span K {z | ∃ y : ∀ i, M i, (∀ i, y i ∈ S i) ∧ f y = z} from
    h Finset.univ x hx (by simp)
  intro T
  induction T using Finset.induction_on with
  | empty => intro x _ h; exact Submodule.subset_span ⟨x, fun i => h i (by simp), rfl⟩
  | @insert a T ha ih =>
    intro x hx h
    have hu : ∀ y ∈ Submodule.span K (S a),
        f (Function.update x a y) ∈
          Submodule.span K {z | ∃ y : ∀ i, M i, (∀ i, y i ∈ S i) ∧ f y = z} := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
        apply ih
        · intro i
          by_cases hi : i = a
          · subst i; simpa using Submodule.subset_span hy
          · simpa [hi] using hx i
        · intro i hi
          by_cases hia : i = a
          · subst i; simpa using hy
          · simpa [hia] using h i (by simp [hia, hi])
      | zero => simp
      | add y z hy hz ihy ihz => rw [f.map_update_add]; exact Submodule.add_mem _ ihy ihz
      | smul c y hy ihy => rw [f.map_update_smul]; exact Submodule.smul_mem _ _ ihy
    simpa using hu (x a) (hx a)

end MultilinearSpan

section GradedTensor
open scoped TensorProduct
variable {K : Type*} [Field K] {m : ℕ} {M : Fin m → Type*} {I : Fin m → Type*}
  [∀ p, AddCommGroup (M p)] [∀ p, Module K (M p)] [∀ p, Fintype (I p)]

theorem ker_differential_eq_span_homogeneous_cycles_sup_range
    (b : ∀ p, Module.Basis (I p) K (M p)) (degree : ∀ p, I p → ℕ)
    (d s : ∀ p, Module.End K (M p))
    (hdd : ∀ p, d p * d p = 0) (hs : ∀ p, s p * s p = 1)
    (hds : ∀ p, d p * s p = -(s p * d p))
    (hchar : (2 : K) = 0 → ∀ p, s p = 1)
    (hzero : ∀ p x, x ∈ degreePiece (b p) (degree p) 0 → d p x = 0)
    (hlowers : ∀ p j x, x ∈ degreePiece (b p) (degree p) (j + 1) →
      d p x ∈ degreePiece (b p) (degree p) j) :
    LinearMap.ker (differential d s) =
      Submodule.span K {z | ∃ x : ∀ p, M p,
        (∀ p, d p (x p) = 0 ∧ ∃ j, x p ∈ degreePiece (b p) (degree p) j) ∧
          PiTensorProduct.tprod K x = z} ⊔ LinearMap.range (differential d s) := by
  rw [ker_differential_eq_span_cycles_sup_range d s hdd hs hds hchar]
  congr 1
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro z ⟨x, hx, rfl⟩
    exact multilinear_mem_span (PiTensorProduct.tprod K)
      (fun p => {z | d p z = 0 ∧ ∃ j, z ∈ degreePiece (b p) (degree p) j}) x
      (fun p => cycle_mem_span_homogeneous (b p) (degree p) (d p)
        (hzero p) (hlowers p) (hx p))
  · apply Submodule.span_mono
    rintro z ⟨x, hx, rfl⟩
    exact ⟨x, fun p => (hx p).1, rfl⟩

end GradedTensor
end FourPapers.TensorCycleSpanning

#print axioms FourPapers.TensorCycleSpanning.ker_differential_eq_span_homogeneous_cycles_sup_range


end
