section Field
variable {K : Type*} [Field K] {m : ℕ} {M : Fin m → Type*}
  [∀ p, AddCommGroup (M p)] [∀ p, Module K (M p)]

/-- The field specialization constructs the required odd generalized
inverses, including the characteristic-two case. -/
theorem ker_differential_eq_span_cycles_sup_range
    (d s : ∀ p, Module.End K (M p))
    (hdd : ∀ p, d p * d p = 0)
    (hs : ∀ p, s p * s p = 1)
    (hds : ∀ p, d p * s p = -(s p * d p))
    (hchar : (2 : K) = 0 → ∀ p, s p = 1) :
    LinearMap.ker (differential d s) =
      Submodule.span K {z | ∃ x : ∀ p, M p,
        (∀ p, d p (x p) = 0) ∧ PiTensorProduct.tprod K x = z} ⊔
      LinearMap.range (differential d s) := by
  choose h hdhd hsh using fun p => exists_odd_generalizedInverse (d p) (s p)
    (hs p) (hds p) (fun hc => hchar hc p)
  exact ker_differential_eq_span_cycles_sup_range_of_homotopies d s h hdd hs hds hdhd hsh

end Field
end FourPapers.TensorCycleSpanning

