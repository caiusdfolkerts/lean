/-!
# The standalone monomial generation assertion of Theorem 5.5

The selected submodule consists of the actual multi-Rees coefficient
components of coordinate-unit degree, with the entire exterior factor.
The statement has no deformed ideals, monomial order, or initial-ideal
hypotheses. Nonnegative degree one is proved equivalent to a coordinate
unit before applying the minimum-color diagonal theorem.
-/

section
set_option autoImplicit false
noncomputable section
namespace FourPapers.Sublattice
open Classical
open IntegerFiltered.MultiplicativeFiltration
universe u
variable {d r : ℕ} {n : Fin d → ℕ} {E : Fin r → Finset (FiniteTuple n)}
  {k : Type u} [Field k]

def actualMixedUnitColorPiece :
    Submodule k (MixedTransfer.IdealReesKoszul (coloredIdeals (k := k) n E)) :=
  Submodule.span k (mixedTensorBasis ''
    {a : MixedTensorIndex.{u} E |
      a.1.1 ∈ Set.range (fun c : ULift.{u} (Fin r) => Finsupp.single c 1)})

theorem actualMixedFirstPiece_eq_unitColorPiece :
    actualMixedFirstPiece (E := E) (k := k) = actualMixedUnitColorPiece (E := E) (k := k) := by
  have hs : {a : MixedTensorIndex.{u} E | a.1.1.degree = 1} =
      {a : MixedTensorIndex.{u} E |
        a.1.1 ∈ Set.range (fun c : ULift.{u} (Fin r) => Finsupp.single c 1)} := by
    apply Set.ext
    intro a
    change a.1.1.degree = 1 ↔ _
    constructor
    · intro ha
      obtain ⟨c,hc⟩ := color_degree_one_eq_unit a.1.1 ha
      exact ⟨c,hc.symm⟩
    · rintro ⟨c,hc⟩
      rw [← hc, Finsupp.degree_single]
  change Submodule.span k (mixedTensorBasis '' _) =
    Submodule.span k (mixedTensorBasis '' _)
  rw [hs]

/-- **Theorem 5.5, standalone monomial assertion.** The genuine Koszul
homology algebra of the literal multi-Rees algebra is generated by its
coordinate-unit coefficient degrees and the algebra unit. -/
theorem theorem55_monomial_generation (hE : ColoredLatticeClosed n E) :
    Algebra.adjoin k (selectedHomologyClasses
      (MixedTransfer.idealReesKoszulDGA (coloredIdeals (k := k) n E))
      (actualMixedUnitColorPiece (E := E) (k := k))) = ⊤ := by
  rw [← actualMixedFirstPiece_eq_unitColorPiece]
  exact mixedReesHomology_generated_in_total_color_one hE

end FourPapers.Sublattice

#print axioms FourPapers.Sublattice.theorem55_monomial_generation

