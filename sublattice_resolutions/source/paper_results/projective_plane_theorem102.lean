section

/-! # Proposition 10.2 in actual ordinary and fine derived Tor

Squarefree support isolates the full product in ordinary degree ninety.
The actual ideal is generated by the printed 1087-element sublattice,
and the field characteristic is expressed by its genuine ringChar.
-/

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 1200000
set_option maxRecDepth 4096
set_option backward.isDefEq.respectTransparency true
noncomputable section
namespace FourPapers.Sublattice.RP2
open Classical CommAlg CommAlg.Koszul CommAlg.Polymatroid
universe u

attribute [local irreducible] projectivePlaneSublattice

theorem variable_card : Fintype.card (FiniteVariable.{u} (IncidenceRows 30))=90 := by
  norm_num [FiniteVariable,IncidenceRows,Fintype.card_sigma]

theorem realizationDegree_one : incidenceRealizationDegree (M := 30) 1=
    faceExponent (Finset.univ : Finset (FiniteVariable.{u} (IncidenceRows 30))) := by
  ext v
  simp only [incidenceRealizationDegree_apply,faceExponent_apply,Finset.mem_univ,if_true,ite_self]

theorem power_one {V : Type*} [DecidableEq V] (B : Family V) :
    exponentPowerFamily B 1=B := by
  ext a
  simp [exponentPowerFamily]

theorem two_eq_zero_iff_ringChar {K : Type u} [Field K] :
    (2:K)=0 ↔ ringChar K=2 := by
  constructor
  · exact CharP.ringChar_of_prime_eq_zero Nat.prime_two
  · intro h
    letI : CharP K 2 := ringChar.of_eq h
    exact CharP.cast_eq_zero K 2

section Field
variable {K : Type u} [Field K]

/-- The complete ordinary Betti column of degree ninety. -/
theorem theorem102_ordinary_column (p : ℕ) :
    ordinaryMonomialBettiNumber (k := K)
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice) 90 p=
      if ringChar K=2 ∧ (p=13 ∨ p=14) then 1 else 0 := by
  have h := squarefreeTopOrdinaryBetti_eq (K := K)
    (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice)
    (fun b hb v => finiteRowFamily_coordinate_le_one projectivePlaneSublattice b hb v) p
  rw [variable_card] at h
  rw [h,← realizationDegree_one]
  have hFine := fine_betti (K := K) 1 (by decide) p
  rw [power_one,two_eq_zero_iff_ringChar] at hFine
  by_cases hc : ringChar K = 2 ∧ (p = 13 ∨ p = 14)
  · simpa only [hc, ite_true] using hFine
  · simpa only [hc, ite_false] using hFine

/-- Proposition 10.2, with the ordinary numbers defined as dimensions
of actual homogeneous submodules of the genuine derived Tor. -/
theorem theorem102_betti (o : MonomialOrder (FiniteVariable.{u} (IncidenceRows 30))) :
    (monomialTorBettiNumber (k := K) o
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice) 13 90=
        if ringChar K=2 then 1 else 0) ∧
    (monomialTorBettiNumber (k := K) o
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice) 14 90=
        if ringChar K=2 then 1 else 0) := by
  constructor <;> rw [monomialTorBettiNumber_eq,theorem102_ordinary_column] <;> simp

end Field

/-- Transport the complete Tor carrier before taking its integer-linear
structure; rewriting inside a dependent subtype is unnecessary. -/
def integerTorReindex {W : Type} [Fintype W] [LinearOrder W]
    (B C : Family W) (a b : Exponent W) (p q : ℕ)
    (hB : B = C) (ha : a = b) (hp : p = q) :
    gradedTor (k := ℤ) B a p ≃ₗ[ℤ] gradedTor (k := ℤ) C b q := by
  cases hB
  cases ha
  cases hp
  exact LinearEquiv.refl ℤ _

/-- The paper's integral fine statement, on the literal full product. -/
def theorem102_integral :
    gradedTor (k := ℤ)
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice)
      (faceExponent (Finset.univ : Finset (FiniteVariable (IncidenceRows 30)))) 13 ≃ₗ[ℤ] ZMod 2 := by
  let B := finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice
  let e := integerTorReindex B (exponentPowerFamily B 1)
    (faceExponent (Finset.univ : Finset (FiniteVariable (IncidenceRows 30))))
    (incidenceRealizationDegree (M := 30) 1) 13 13
    (power_one B).symm realizationDegree_one.symm rfl
  exact e.trans (integral_degree13 1 (by decide))

theorem theorem102_integral_other (p : ℕ) (hp : p≠13) :
    Subsingleton (gradedTor (k := ℤ)
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice)
      (faceExponent (Finset.univ : Finset (FiniteVariable (IncidenceRows 30)))) p) := by
  letI := integral_other_degrees 1 (by decide) p hp
  let B := finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice
  let e := integerTorReindex B (exponentPowerFamily B 1)
    (faceExponent (Finset.univ : Finset (FiniteVariable (IncidenceRows 30))))
    (incidenceRealizationDegree (M := 30) 1) p p
    (power_one B).symm realizationDegree_one.symm rfl
  exact e.injective.subsingleton

/-- The construction and both numerical assertions are assembled with
the exact lattice closure and cardinality, not a chosen replacement. -/
theorem theorem102 {K : Type u} [Field K]
    (o : MonomialOrder (FiniteVariable.{u} (IncidenceRows 30))) :
    finiteLatticeClosed (IncidenceRows 30) projectivePlaneSublattice ∧
    projectivePlaneSublattice.card=1087 ∧
    (monomialTorBettiNumber (k := K) o
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice) 13 90=
        if ringChar K=2 then 1 else 0) ∧
    (monomialTorBettiNumber (k := K) o
      (finiteRowFamily (IncidenceRows 30) projectivePlaneSublattice) 14 90=
        if ringChar K=2 then 1 else 0) :=
  ⟨projectivePlaneSublattice_closed,projectivePlaneSublattice_card,theorem102_betti o⟩

end FourPapers.Sublattice.RP2
