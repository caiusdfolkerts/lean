/- BEGIN EXACT BODY: FourPapers.Sublattice.RatioIdeals -/
section
set_option autoImplicit false

/-!
# Polynomial ideal form of crossing blocks

The ideals in this file are actual ideals in an `MvPolynomial` ring. The generator
of a support `g` is the product of the variables in `g`, not an abstract label.
The support-level crossing theorem yields an equality of ideals and disjoint
variable sets over every commutative semiring of coefficients.
-/

noncomputable section

namespace FourPapers.Sublattice

open Finset

variable {V R k : Type*} [DecidableEq V] [Fintype R] [DecidableEq R] [CommSemiring k]

/-- The squarefree monomial with exactly the specified support. -/
def squareMonomial (g : Finset V) : MvPolynomial V k :=
  ∏ x ∈ g, MvPolynomial.X x

/-- The genuine polynomial ideal generated by squarefree monomials with these supports. -/
def supportIdeal (G : Set (Finset V)) : Ideal (MvPolynomial V k) :=
  Ideal.span ((squareMonomial (k := k)) '' G)

lemma squareMonomial_mem_supportIdeal {G : Set (Finset V)} {g : Finset V}
    (hg : g ∈ G) : squareMonomial (k := k) g ∈ supportIdeal G :=
  Ideal.subset_span ⟨g,hg,rfl⟩

lemma supportIdeal_le {G : Set (Finset V)} {I : Ideal (MvPolynomial V k)}
    (h : ∀ g ∈ G, squareMonomial (k := k) g ∈ I) : supportIdeal G ≤ I := by
  apply Ideal.span_le.mpr
  rintro _ ⟨g,hg,rfl⟩
  exact h g hg

lemma squareMonomial_mem_of_subset {I : Ideal (MvPolynomial V k)}
    {h g : Finset V} (hhg : h ⊆ g) (hh : squareMonomial (k := k) h ∈ I) :
    squareMonomial (k := k) g ∈ I := by
  have he : squareMonomial (k := k) (g \ h) * squareMonomial h = squareMonomial g :=
    prod_sdiff hhg
  rw [← he]
  exact Ideal.mul_mem_left I _ hh

/-- The predecessor ideal generated by coordinatewise predecessor ratios. -/
def predecessorIdeal (E : Finset (R → ℕ)) (a : R → ℕ) :
    Ideal (MvPolynomial (R × ℕ) k) :=
  supportIdeal {g | ∃ b, b ∈ E ∧ b ≤ a ∧ b ≠ a ∧ g = ratio b a}

/-- The sum of predecessor ideals along the specified multichain. -/
def chainIdeal {m : ℕ} (E : Finset (R → ℕ)) (w : Fin m → R → ℕ) :
    Ideal (MvPolynomial (R × ℕ) k) :=
  ⨆ s, predecessorIdeal E (w s)

lemma chainIdeal_eq_supportIdeal {m : ℕ} (E : Finset (R → ℕ))
    (w : Fin m → R → ℕ) :
    chainIdeal (k := k) E w = supportIdeal {g | Occurs E w g} := by
  apply le_antisymm
  · apply iSup_le
    intro s
    apply supportIdeal_le
    rintro g ⟨b,hbE,hba,hne,hg⟩
    exact squareMonomial_mem_supportIdeal ⟨s,b,hbE,hba,hne,hg⟩
  · apply supportIdeal_le
    rintro g ⟨s,b,hbE,hba,hne,hg⟩
    exact (le_iSup (fun s => predecessorIdeal (k := k) E (w s)) s)
      (squareMonomial_mem_supportIdeal ⟨b,hbE,hba,hne,hg⟩)

/-- A minimal generator assigned to its first crossing. -/
def BlockRatio {m : ℕ} (E : Finset (R → ℕ)) (w : Fin m → R → ℕ)
    (p : Fin m) (g : Finset (R × ℕ)) : Prop :=
  MinimalRatio E w g ∧
  (∃ b, b ∈ E ∧ b ≤ w p ∧ b ≠ w p ∧ g = ratio b (w p)) ∧
  ∀ x ∈ g, Crosses w p x

/-- The polynomial ideal of the minimal ratios in one crossing block. -/
def blockIdeal {m : ℕ} (E : Finset (R → ℕ)) (w : Fin m → R → ℕ)
    (p : Fin m) : Ideal (MvPolynomial (R × ℕ) k) :=
  supportIdeal {g | BlockRatio E w p g}

lemma blockIdeal_le_predecessor {m : ℕ} (E : Finset (R → ℕ))
    (w : Fin m → R → ℕ) (p : Fin m) :
    blockIdeal (k := k) E w p ≤ predecessorIdeal E (w p) := by
  apply supportIdeal_le
  intro g hg
  exact squareMonomial_mem_supportIdeal hg.2.1

lemma blockRatio_variables {m : ℕ} {E : Finset (R → ℕ)} {w : Fin m → R → ℕ}
    {p : Fin m} {g : Finset (R × ℕ)} (hg : BlockRatio E w p g) :
    ∀ x ∈ g, Crosses w p x := hg.2.2

lemma crossingBlocks_disjoint {m : ℕ} (w : Fin m → R → ℕ)
    {p q : Fin m} (hpq : p ≠ q) :
    Disjoint {x | Crosses w p x} {x | Crosses w q x} := by
  apply Set.disjoint_left.mpr
  intro x hxp hxq
  exact hpq (crosses_unique hxp hxq)

/-- The exact polynomial-ideal decomposition of Lemma 2.4. Every block is already
contained in the predecessor ideal at its own chain member, and its generators use
only variables from the corresponding, pairwise disjoint, crossing set. -/
theorem chainIdeal_eq_iSup_blockIdeal {m : ℕ} {E : Finset (R → ℕ)}
    (hE : MeetClosed E) {w : Fin m → R → ℕ} (hw : ∀ s, w s ∈ E)
    (hmono : Monotone w) :
    chainIdeal (k := k) E w = ⨆ p, blockIdeal E w p := by
  apply le_antisymm
  · rw [chainIdeal_eq_supportIdeal]
    apply supportIdeal_le
    intro g hg
    obtain ⟨h,hhg,hh⟩ := exists_minimal_le_of_wellFoundedLT (Occurs E w) g hg
    have hmin : MinimalRatio E w h := hh
    obtain ⟨p,c,hcE,hcp,hcne,heq,hcross⟩ :=
      minimalRatio_single_crossing hE hw hmono hmin
    have hblock : BlockRatio E w p h :=
      ⟨hmin,⟨c,hcE,hcp,hcne,heq⟩,hcross⟩
    apply squareMonomial_mem_of_subset hhg
    exact (le_iSup (fun p => blockIdeal (k := k) E w p) p)
      (squareMonomial_mem_supportIdeal hblock)
  · apply iSup_le
    intro p
    exact (blockIdeal_le_predecessor E w p).trans
      (le_iSup (fun p => predecessorIdeal (k := k) E (w p)) p)

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.Predecessor -/
section
set_option autoImplicit false

/-!
# Lexicographic and coordinatewise predecessor ideals

The predecessor ideal is originally a colon by the row generator. Its generators
are monomial gcd quotients; meet closure reduces all lexicographic predecessors to
coordinatewise predecessors. In particular, every variable in a minimal ratio lies
strictly below the current coordinate in its row.
-/

noncomputable section

namespace FourPapers.Sublattice
open Finset MvPolynomial

variable {R k : Type*} [Fintype R] [LinearOrder R] [CommSemiring k]

/-- Strict lexicographic precedence in the increasing order of the rows. -/
def LexBefore (b a : R → ℕ) : Prop :=
  ∃ r, b r < a r ∧ ∀ s < r, b s = a s

/-- The support of `u_b/gcd(u_b,u_a)` without a coordinatewise comparability assumption. -/
def generalRatio (b a : R → ℕ) : Finset (R × ℕ) :=
  (univ.filter fun r => b r ≠ a r).image fun r => (r,b r)

@[simp] lemma mem_generalRatio {b a : R → ℕ} {r : R} {j : ℕ} :
    (r,j) ∈ generalRatio b a ↔ j = b r ∧ b r ≠ a r := by
  simp only [generalRatio,mem_image,mem_filter,mem_univ,true_and,Prod.mk.injEq]
  constructor
  · rintro ⟨s,hs,rfl,hj⟩
    exact ⟨hj.symm,hs⟩
  · rintro ⟨rfl,h⟩
    exact ⟨r,h,rfl,rfl⟩

lemma generalRatio_eq_ratio {b a : R → ℕ} (hba : b ≤ a) :
    generalRatio b a = ratio b a := by
  ext x
  rcases x with ⟨r,j⟩
  rw [mem_generalRatio,mem_ratio]
  exact and_congr_right (fun _ => ⟨fun h => lt_of_le_of_ne (hba r) h,
    fun h => ne_of_lt h⟩)

lemma lexBefore_of_le_of_ne {b a : R → ℕ} (hba : b ≤ a) (hne : b ≠ a) :
    LexBefore b a := by
  classical
  let T := univ.filter fun r => b r < a r
  have hT : T.Nonempty := by
    by_contra h
    have ht : ∀ r, a r ≤ b r := by
      intro r
      by_contra hn
      have hr : b r < a r := lt_of_not_ge hn
      exact h ⟨r,mem_filter.mpr ⟨mem_univ _,hr⟩⟩
    exact hne (le_antisymm hba ht)
  let r := T.min' hT
  refine ⟨r,(mem_filter.mp (min'_mem T hT)).2,?_⟩
  intro s hsr
  apply le_antisymm (hba s)
  by_contra hs
  have hsT : s ∈ T := mem_filter.mpr ⟨mem_univ _,lt_of_not_ge hs⟩
  exact (not_le_of_gt hsr) (min'_le T s hsT)

lemma meet_ne_of_lexBefore {b a : R → ℕ} (h : LexBefore b a) : b ⊓ a ≠ a := by
  rcases h with ⟨r,hr,_⟩
  intro he
  have he' := congrFun he r
  have hb : (b ⊓ a) r = b r := min_eq_left (le_of_lt hr)
  exact (ne_of_lt hr) (hb.symm.trans he')

lemma meet_ratio_subset_generalRatio (b a : R → ℕ) :
    ratio (b ⊓ a) a ⊆ generalRatio b a := by
  rintro ⟨r,j⟩ hx
  rcases mem_ratio.mp hx with ⟨hj,hlt⟩
  have hbr : b r < a r := by simpa [Pi.inf_apply,min_lt_iff] using hlt
  exact mem_generalRatio.mpr ⟨hj.trans (min_eq_left (le_of_lt hbr)),ne_of_lt hbr⟩

/-- The ideal generated by all lexicographic gcd quotients. -/
def lexRatioIdeal (E : Finset (R → ℕ)) (a : R → ℕ) :
    Ideal (MvPolynomial (R × ℕ) k) :=
  supportIdeal {g | ∃ b, b ∈ E ∧ LexBefore b a ∧ g = generalRatio b a}

/-- The meet operation removes every extra variable caused by an upward coordinate
of a lexicographic predecessor. This is the ideal equality in Lemma 2.1. -/
theorem lexRatioIdeal_eq_predecessorIdeal {E : Finset (R → ℕ)} (hE : MeetClosed E)
    {a : R → ℕ} (ha : a ∈ E) :
    lexRatioIdeal (k := k) E a = predecessorIdeal E a := by
  apply le_antisymm
  · apply supportIdeal_le
    rintro g ⟨b,hbE,hlex,rfl⟩
    apply squareMonomial_mem_of_subset (meet_ratio_subset_generalRatio b a)
    exact squareMonomial_mem_supportIdeal
      ⟨b ⊓ a,hE b hbE a ha,inf_le_right,meet_ne_of_lexBefore hlex,rfl⟩
  · apply supportIdeal_le
    rintro g ⟨b,hbE,hba,hne,rfl⟩
    rw [← generalRatio_eq_ratio hba]
    exact squareMonomial_mem_supportIdeal
      ⟨b,hbE,lexBefore_of_le_of_ne hba hne,rfl⟩

/-- Every variable in a coordinatewise predecessor ratio is strictly earlier in its
row; the assertion is independent of the coefficient ring. -/
theorem predecessor_ratio_earlier {b a : R → ℕ} {x : R × ℕ}
    (hx : x ∈ ratio b a) : x.2 < a x.1 := by
  rcases x with ⟨r,j⟩
  rcases mem_ratio.mp hx with ⟨rfl,h⟩
  exact h

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.ColonBridge -/
section
set_option autoImplicit false

/-!
# The predecessor colon is the ratio ideal

The original predecessor ideals from the paper are colons of actual monomial ideals.
This file proves their equality with the coordinatewise ratio presentation, eliminating
any possibility that the crossing-block result applies only to a differently defined ideal.
-/

noncomputable section

namespace FourPapers.Sublattice
open Finset MvPolynomial

variable {V R k : Type*} [DecidableEq V] [Fintype R] [LinearOrder R] [CommSemiring k]

/-- Squarefree exponent vector of a support. -/
def squareExponent (g : Finset V) : V →₀ ℕ := ∑ x ∈ g, Finsupp.single x 1

@[simp] lemma squareExponent_apply (g : Finset V) (x : V) :
    squareExponent g x = if x ∈ g then 1 else 0 := by
  classical
  simp [squareExponent,Finsupp.single_apply]

lemma squareMonomial_eq_monomial (g : Finset V) :
    squareMonomial (k := k) g = monomial (squareExponent g) 1 := by
  simp [squareMonomial,squareExponent,monomial_sum_one,X]

/-- Exponent vector of a generator selecting one variable from each row. -/
def rowExponent (a : R → ℕ) : (R × ℕ) →₀ ℕ :=
  ∑ r, Finsupp.single (r,a r) 1

@[simp] lemma rowExponent_apply (a : R → ℕ) (r : R) (j : ℕ) :
    rowExponent a (r,j) = if a r = j then 1 else 0 := by
  classical
  simp only [rowExponent,Finsupp.finset_sum_apply]
  rw [sum_eq_single r]
  · simp [Finsupp.single_apply]
  · intro s _ hsr
    simp [Finsupp.single_apply,Prod.mk.injEq,hsr]
  · simp

/-- The row monomial `∏ᵣ x_{r,aᵣ}`. -/
def rowMonomial (a : R → ℕ) : MvPolynomial (R × ℕ) k :=
  ∏ r, X (r,a r)

lemma rowMonomial_eq_monomial (a : R → ℕ) :
    rowMonomial (k := k) a = monomial (rowExponent a) 1 := by
  simp [rowMonomial,rowExponent,monomial_sum_one,X]

lemma generalRatio_exponent (b a : R → ℕ) :
    squareExponent (generalRatio b a) = rowExponent b - rowExponent a := by
  classical
  ext x
  rcases x with ⟨r,j⟩
  simp only [squareExponent_apply,mem_generalRatio,Finsupp.tsub_apply,rowExponent_apply]
  by_cases hb : b r = j <;> by_cases ha : a r = j <;> simp_all [eq_comm]

lemma generalRatio_monomial (b a : R → ℕ) :
    squareMonomial (k := k) (generalRatio b a) = monomial (rowExponent b - rowExponent a) 1 := by
  rw [squareMonomial_eq_monomial,generalRatio_exponent]

/-- The actual row-generated monomial ideal. -/
def rowIdeal (D : Set (R → ℕ)) : Ideal (MvPolynomial (R × ℕ) k) :=
  Ideal.span ((rowMonomial (k := k)) '' D)

lemma rowIdeal_eq_exponentIdeal (D : Set (R → ℕ)) :
    rowIdeal (k := k) D = exponentIdeal (rowExponent '' D) := by
  unfold rowIdeal exponentIdeal
  congr 1
  ext f
  constructor
  · rintro ⟨a,ha,rfl⟩
    exact ⟨rowExponent a,⟨a,ha,rfl⟩,(rowMonomial_eq_monomial a).symm⟩
  · rintro ⟨e,⟨a,ha,rfl⟩,rfl⟩
    exact ⟨a,ha,rowMonomial_eq_monomial a⟩

/-- The lexicographic prefix used in the paper. -/
def lexPrefix (E : Finset (R → ℕ)) (a : R → ℕ) : Set (R → ℕ) :=
  {b | b ∈ E ∧ LexBefore b a}

/-- The paper's predecessor ideal, with its original colon definition. -/
def predecessorColon (E : Finset (R → ℕ)) (a : R → ℕ) :
    Ideal (MvPolynomial (R × ℕ) k) :=
  (rowIdeal (lexPrefix E a)).colon {rowMonomial a}

lemma predecessorColon_eq_lexRatioIdeal (E : Finset (R → ℕ)) (a : R → ℕ) :
    predecessorColon (k := k) E a = lexRatioIdeal E a := by
  unfold predecessorColon
  rw [rowIdeal_eq_exponentIdeal,rowMonomial_eq_monomial,exponentIdeal_colon_monomial]
  unfold exponentIdeal lexRatioIdeal supportIdeal
  congr 1
  ext f
  constructor
  · rintro ⟨e,⟨e',⟨b,hb,rfl⟩,rfl⟩,rfl⟩
    exact ⟨generalRatio b a,⟨b,hb.1,hb.2,rfl⟩,generalRatio_monomial b a⟩
  · rintro ⟨g,⟨b,hbE,hblex,rfl⟩,rfl⟩
    exact ⟨rowExponent b - rowExponent a,
      ⟨rowExponent b,⟨b,⟨hbE,hblex⟩,rfl⟩,rfl⟩,(generalRatio_monomial b a).symm⟩

/-- Full algebraic version of Lemma 2.1: the original lexicographic colon equals
an ideal generated entirely by coordinatewise predecessor ratios. -/
theorem predecessorColon_eq_predecessorIdeal {E : Finset (R → ℕ)}
    (hE : MeetClosed E) {a : R → ℕ} (ha : a ∈ E) :
    predecessorColon (k := k) E a = predecessorIdeal E a := by
  rw [predecessorColon_eq_lexRatioIdeal,lexRatioIdeal_eq_predecessorIdeal hE ha]

/-- Full crossing-block equality for the paper's actual predecessor colons. -/
theorem predecessorColon_chain_blocks {m : ℕ} {E : Finset (R → ℕ)}
    (hE : MeetClosed E) {w : Fin m → R → ℕ} (hw : ∀ s, w s ∈ E)
    (hmono : Monotone w) :
    (⨆ s, predecessorColon (k := k) E (w s)) = ⨆ p, blockIdeal E w p := by
  calc
    (⨆ s, predecessorColon (k := k) E (w s)) = ⨆ s, predecessorIdeal E (w s) :=
      iSup_congr fun s => predecessorColon_eq_predecessorIdeal hE (hw s)
    _ = _ := chainIdeal_eq_iSup_blockIdeal hE hw hmono

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.NormalForm -/
section
set_option autoImplicit false

/-!
# Injectivity of the standard Rees monomials

A polynomial coefficient is represented by its exponent function. The image of a
chain normal form records this function plus the exponents of its row generators.
No bound on the number of rows, the column indices, or the Rees degree is imposed.
-/

namespace FourPapers.Sublattice

variable {R : Type*} [Fintype R] [DecidableEq R]

/-- The exponent of one row generator in one variable. -/
def generatorExponent (a : R → ℕ) (x : R × ℕ) : ℕ :=
  if a x.1 = x.2 then 1 else 0

/-- The exponent of a product of row generators. -/
def chainExponent (w : List (R → ℕ)) (x : R × ℕ) : ℕ :=
  (w.map fun a => generatorExponent a x).sum

@[simp] lemma chainExponent_nil (x : R × ℕ) :
    chainExponent ([] : List (R → ℕ)) x = 0 := rfl

@[simp] lemma chainExponent_cons (a : R → ℕ) (w : List (R → ℕ)) (x : R × ℕ) :
    chainExponent (a :: w) x = generatorExponent a x + chainExponent w x := rfl

lemma chainExponent_eq_zero {w : List (R → ℕ)} {r : R} {j : ℕ}
    (h : ∀ a ∈ w, a r ≠ j) : chainExponent w (r,j) = 0 := by
  induction w with
  | nil => rfl
  | cons a w ih =>
    rw [chainExponent_cons]
    have ha : a r ≠ j := h a (by simp)
    have ht : chainExponent w (r,j) = 0 := ih (fun b hb => h b (by simp [hb]))
    simp [generatorExponent,ha,ht]

/-- The exponent function of the image in the actual Rees algebra. -/
def imageExponent (w : List (R → ℕ)) (v : (R × ℕ) → ℕ) : (R × ℕ) → ℕ :=
  fun x => v x + chainExponent w x

/-- A standard coefficient is divisible by none of the predecessor ratios. -/
def StandardCoefficient (E : Finset (R → ℕ)) (w : List (R → ℕ))
    (v : (R × ℕ) → ℕ) : Prop :=
  ∀ a ∈ w, ∀ b ∈ E, b ≤ a → b ≠ a →
    ¬ ∀ x ∈ ratio b a, 0 < v x

/-- Exact standardness conditions for the monomial initial ideal in Proposition 2.2. -/
def StandardForm (E : Finset (R → ℕ)) (w : List (R → ℕ))
    (v : (R × ℕ) → ℕ) : Prop :=
  (∀ a ∈ w, a ∈ E) ∧ w.Pairwise (· ≤ ·) ∧ StandardCoefficient E w v

lemma StandardForm.tail {E : Finset (R → ℕ)} {a : R → ℕ}
    {w : List (R → ℕ)} {v : (R × ℕ) → ℕ}
    (h : StandardForm E (a :: w) v) : StandardForm E w v := by
  refine ⟨fun b hb => h.1 b (by simp [hb]),(List.pairwise_cons.mp h.2.1).2,?_⟩
  intro b hb c hc hcb hne
  exact h.2.2 b (by simp [hb]) c hc hcb hne

/-- The first factor of a standard form is the coordinatewise least generator
which divides its image. This strengthens the lexicographic assertion used in the paper. -/
theorem first_factor_le_of_divides {E : Finset (R → ℕ)} (hE : MeetClosed E)
    {a b : R → ℕ} {w : List (R → ℕ)} {v : (R × ℕ) → ℕ}
    (hstd : StandardForm E (a :: w) v) (hbE : b ∈ E)
    (hdiv : ∀ r, 0 < imageExponent (a :: w) v (r,b r)) : a ≤ b := by
  by_contra hn
  have hne : b ⊓ a ≠ a := by
    intro he
    apply hn
    intro r
    have hr := congrFun he r
    exact hr ▸ (show (b ⊓ a) r ≤ b r from min_le_left _ _)
  have hcE : b ⊓ a ∈ E := hE b hbE a (hstd.1 a (by simp))
  apply hstd.2.2 a (by simp) (b ⊓ a) hcE inf_le_right hne
  rintro ⟨r,j⟩ hx
  rcases mem_ratio.mp hx with ⟨hj,hlt⟩
  have hbr : b r < a r := by simpa [Pi.inf_apply,min_lt_iff] using hlt
  have hjb : j = b r := hj.trans (min_eq_left (le_of_lt hbr))
  have hcount : chainExponent (a :: w) (r,b r) = 0 := by
    apply chainExponent_eq_zero
    intro c hc
    rcases List.mem_cons.mp hc with rfl | hc
    · exact ne_of_gt hbr
    · have hac : a ≤ c := (List.pairwise_cons.mp hstd.2.1).1 c hc
      exact ne_of_gt (hbr.trans_le (hac r))
  have hd := hdiv r
  simpa [imageExponent,hcount,hjb] using hd

/-- Distinct standard monomials of a fixed Rees degree have distinct monomial
images. This is the normal-form injectivity used in Proposition 2.2. -/
theorem standardForm_image_injective {E : Finset (R → ℕ)} (hE : MeetClosed E)
    {w w' : List (R → ℕ)} {v v' : (R × ℕ) → ℕ}
    (hw : StandardForm E w v) (hw' : StandardForm E w' v')
    (hlen : w.length = w'.length) (him : imageExponent w v = imageExponent w' v') :
    w = w' ∧ v = v' := by
  induction w generalizing w' v v' with
  | nil =>
    have hw'0 : w' = [] := List.length_eq_zero_iff.mp hlen.symm
    subst w'
    refine ⟨rfl,?_⟩
    funext x
    simpa [imageExponent] using congrFun him x
  | cons a w ih =>
    cases w' with
    | nil => simp at hlen
    | cons b w' =>
      have htail : w.length = w'.length := by simpa using hlen
      have haE : a ∈ E := hw.1 a (by simp)
      have hbE : b ∈ E := hw'.1 b (by simp)
      have hab : a ≤ b := by
        apply first_factor_le_of_divides hE hw hbE
        intro r
        rw [him]
        simp [imageExponent,generatorExponent] <;> omega
      have hba : b ≤ a := by
        apply first_factor_le_of_divides hE hw' haE
        intro r
        rw [← him]
        simp [imageExponent,generatorExponent] <;> omega
      have heq : a = b := le_antisymm hab hba
      subst b
      have himtail : imageExponent w v = imageExponent w' v' := by
        funext x
        have hx := congrFun him x
        simp only [imageExponent,chainExponent_cons] at hx ⊢
        omega
      obtain ⟨hww,hvv⟩ := ih hw.tail hw'.tail htail himtail
      exact ⟨congrArg (List.cons a) hww,hvv⟩

end FourPapers.Sublattice

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.Sorting -/
section
set_option autoImplicit false

/-!
# Sorting arbitrary products in a finite sublattice

The insertion operation below is the repeated quadratic replacement
`(a,b) ↦ (a ⊓ b,a ⊔ b)`.  Its output is a multichain, has the same length,
and preserves the exponent of every row variable.  These facts hold for arbitrary
length, not just for a bounded enumeration of products.
-/

namespace FourPapers.Sublattice

variable {R : Type*} [Fintype R] [DecidableEq R]

/-- Closure under both coordinatewise lattice operations. -/
def LatticeClosed (E : Finset (R → ℕ)) : Prop :=
  MeetClosed E ∧ ∀ a ∈ E, ∀ b ∈ E, a ⊔ b ∈ E

/-- Insert a row tuple into a multichain by meet-and-join sorting. -/
def sortInsert (a : R → ℕ) : List (R → ℕ) → List (R → ℕ)
  | [] => [a]
  | b :: w => (a ⊓ b) :: sortInsert (a ⊔ b) w

@[simp] lemma length_sortInsert (a : R → ℕ) (w : List (R → ℕ)) :
    (sortInsert a w).length = w.length + 1 := by
  induction w generalizing a with
  | nil => rfl
  | cons b w ih => simp [sortInsert, ih]

lemma le_of_mem_sortInsert {a c : R → ℕ} {w : List (R → ℕ)}
    (hca : c ≤ a) (hcw : ∀ b ∈ w, c ≤ b) :
    ∀ b ∈ sortInsert a w, c ≤ b := by
  induction w generalizing a with
  | nil => simpa [sortInsert] using hca
  | cons b w ih =>
    have hcb : c ≤ b := hcw b (by simp)
    have hct : ∀ b' ∈ w, c ≤ b' := fun b' hb' => hcw b' (by simp [hb'])
    intro d hd
    rcases List.mem_cons.mp hd with rfl | hd
    · exact le_inf hca hcb
    · exact ih (hca.trans le_sup_left) hct d hd

lemma pairwise_sortInsert (a : R → ℕ) {w : List (R → ℕ)}
    (hw : w.Pairwise (· ≤ ·)) : (sortInsert a w).Pairwise (· ≤ ·) := by
  induction w generalizing a with
  | nil => simp [sortInsert]
  | cons b w ih =>
    obtain ⟨hbw, hwt⟩ := List.pairwise_cons.mp hw
    apply List.pairwise_cons.mpr
    refine ⟨?_, ih (a ⊔ b) hwt⟩
    apply le_of_mem_sortInsert
    · exact inf_le_left.trans le_sup_left
    · intro c hc
      exact inf_le_right.trans (hbw c hc)

lemma mem_lattice_of_mem_sortInsert {E : Finset (R → ℕ)}
    (hE : LatticeClosed E) {a : R → ℕ} {w : List (R → ℕ)}
    (ha : a ∈ E) (hw : ∀ b ∈ w, b ∈ E) :
    ∀ b ∈ sortInsert a w, b ∈ E := by
  induction w generalizing a with
  | nil => simpa [sortInsert] using ha
  | cons b w ih =>
    have hb : b ∈ E := hw b (by simp)
    intro c hc
    rcases List.mem_cons.mp hc with rfl | hc
    · exact hE.1 a ha b hb
    · exact ih (hE.2 a ha b hb) (fun d hd => hw d (by simp [hd])) c hc

lemma generatorExponent_inf_add_sup (a b : R → ℕ) (x : R × ℕ) :
    generatorExponent (a ⊓ b) x + generatorExponent (a ⊔ b) x =
      generatorExponent a x + generatorExponent b x := by
  by_cases h : a x.1 ≤ b x.1
  · simp [generatorExponent, Pi.inf_apply, Pi.sup_apply, min_eq_left h, max_eq_right h]
  · have h' : b x.1 ≤ a x.1 := le_of_not_ge h
    simp [generatorExponent, Pi.inf_apply, Pi.sup_apply, min_eq_right h',
      max_eq_left h', Nat.add_comm]

lemma chainExponent_sortInsert (a : R → ℕ) (w : List (R → ℕ)) (x : R × ℕ) :
    chainExponent (sortInsert a w) x = generatorExponent a x + chainExponent w x := by
  induction w generalizing a with
  | nil => simp [sortInsert]
  | cons b w ih =>
    simp only [sortInsert, chainExponent_cons, ih]
    rw [← Nat.add_assoc, generatorExponent_inf_add_sup, Nat.add_assoc]

/-- Sort a product of any number of row generators. -/
def sortChain : List (R → ℕ) → List (R → ℕ)
  | [] => []
  | a :: w => sortInsert a (sortChain w)

@[simp] lemma length_sortChain (w : List (R → ℕ)) :
    (sortChain w).length = w.length := by
  induction w with
  | nil => rfl
  | cons a w ih => simp [sortChain, ih]

lemma pairwise_sortChain (w : List (R → ℕ)) : (sortChain w).Pairwise (· ≤ ·) := by
  induction w with
  | nil => simp [sortChain]
  | cons a w ih => exact pairwise_sortInsert a ih

lemma mem_lattice_of_mem_sortChain {E : Finset (R → ℕ)}
    (hE : LatticeClosed E) {w : List (R → ℕ)} (hw : ∀ a ∈ w, a ∈ E) :
    ∀ a ∈ sortChain w, a ∈ E := by
  induction w with
  | nil => simp [sortChain]
  | cons a w ih =>
    exact mem_lattice_of_mem_sortInsert hE (hw a (by simp))
      (ih (fun b hb => hw b (by simp [hb])))

lemma chainExponent_sortChain (w : List (R → ℕ)) (x : R × ℕ) :
    chainExponent (sortChain w) x = chainExponent w x := by
  induction w with
  | nil => rfl
  | cons a w ih => simp only [sortChain, chainExponent_sortInsert, chainExponent_cons, ih]

/-- Every product of row generators can be sorted inside the same sublattice,
without changing its exponent or its number of factors. -/
theorem exists_sorted_product {E : Finset (R → ℕ)} (hE : LatticeClosed E)
    (w : List (R → ℕ)) (hw : ∀ a ∈ w, a ∈ E) :
    ∃ w', (∀ a ∈ w', a ∈ E) ∧ w'.Pairwise (· ≤ ·) ∧ w'.length = w.length ∧
      chainExponent w' = chainExponent w := by
  exact ⟨sortChain w, mem_lattice_of_mem_sortChain hE hw, pairwise_sortChain w,
    length_sortChain w, funext (chainExponent_sortChain w)⟩

end FourPapers.Sublattice

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.FiniteEmbedding -/
section
set_option autoImplicit false

/-! # Exact embeddings of the finite row variables into natural column indices -/

noncomputable section

namespace FourPapers.Sublattice

open Classical Finset CommAlg.Polymatroid

universe u

variable {d : ℕ} {n : Fin d → ℕ}

def finiteTupleToNat (a : FiniteTuple n) : Fin d → ℕ := fun r => (a r).val

lemma finiteTupleToNat_injective : Function.Injective (finiteTupleToNat (n := n)) := by
  intro a b h
  funext r
  exact Fin.ext (congrFun h r)

@[simp] lemma finiteTupleToNat_le {a b : FiniteTuple n} :
    finiteTupleToNat a ≤ finiteTupleToNat b ↔ a ≤ b := Iff.rfl

@[simp] lemma finiteTupleToNat_inf (a b : FiniteTuple n) :
    finiteTupleToNat (a ⊓ b) = finiteTupleToNat a ⊓ finiteTupleToNat b := by
  funext r
  rfl

lemma finiteLexBefore_iff (b a : FiniteTuple n) :
    finiteLexBefore n b a ↔ LexBefore (finiteTupleToNat b) (finiteTupleToNat a) := by
  constructor
  · rintro ⟨r,hr,hprev⟩
    exact ⟨r,hr,fun s hs => congrArg Fin.val (hprev s hs)⟩
  · rintro ⟨r,hr,hprev⟩
    exact ⟨r,hr,fun s hs => Fin.ext (hprev s hs)⟩

lemma finiteLexBefore_of_le_ne {b a : FiniteTuple n} (hba : b ≤ a) (hne : b ≠ a) :
    finiteLexBefore n b a := by
  apply (finiteLexBefore_iff b a).mpr
  exact lexBefore_of_le_of_ne hba
    (fun h => hne (finiteTupleToNat_injective h))

lemma finiteMeet_ne_of_lexBefore {b a : FiniteTuple n} (h : finiteLexBefore n b a) :
    b ⊓ a ≠ a := by
  intro heq
  apply meet_ne_of_lexBefore ((finiteLexBefore_iff b a).mp h)
  simpa only [finiteTupleToNat_inf] using congrArg finiteTupleToNat heq

@[simp] lemma finiteRowExponent_apply (a : FiniteTuple n) (r : Fin d) (j : Fin (n r)) :
    finiteRowExponent.{u} n a ⟨r,ULift.up j⟩ = if a r = j then 1 else 0 := by
  unfold finiteRowExponent
  rw [Finsupp.finsetSum_apply,Finset.sum_eq_single r]
  · simp [Finsupp.single_apply]
  · intro s _ hsr
    have hne : (⟨s,ULift.up (a s)⟩ : FiniteVariable.{u} n) ≠ ⟨r,ULift.up j⟩ :=
      fun hh => hsr (congrArg Sigma.fst hh)
    simp [hne]
  · simp

@[simp] lemma finiteTupleToNat_sup (a b : FiniteTuple n) :
    finiteTupleToNat (a ⊔ b) = finiteTupleToNat a ⊔ finiteTupleToNat b := by
  funext r
  rfl

def finiteTupleEmbedding : FiniteTuple n ↪ (Fin d → ℕ) :=
  ⟨finiteTupleToNat,finiteTupleToNat_injective⟩

def finiteTupleImage (E : Finset (FiniteTuple n)) : Finset (Fin d → ℕ) :=
  E.map finiteTupleEmbedding

def finiteTupleImageEquiv (E : Finset (FiniteTuple n)) : E ≃ finiteTupleImage E :=
  Finset.equivMap finiteTupleEmbedding E

@[simp] lemma finiteTupleImageEquiv_val (E : Finset (FiniteTuple n)) (a : E) :
    (finiteTupleImageEquiv E a).val = finiteTupleToNat a.val := rfl

lemma finiteTupleImage_closed {E : Finset (FiniteTuple n)} (hE : finiteLatticeClosed n E) :
    LatticeClosed (finiteTupleImage E) := by
  constructor
  · intro a ha b hb
    obtain ⟨a',ha',rfl⟩ := Finset.mem_map.mp ha
    obtain ⟨b',hb',rfl⟩ := Finset.mem_map.mp hb
    exact Finset.mem_map.mpr ⟨a' ⊓ b',hE.1 a' ha' b' hb',finiteTupleToNat_inf a' b'⟩
  · intro a ha b hb
    obtain ⟨a',ha',rfl⟩ := Finset.mem_map.mp ha
    obtain ⟨b',hb',rfl⟩ := Finset.mem_map.mp hb
    exact Finset.mem_map.mpr ⟨a' ⊔ b',hE.2 a' ha' b' hb',finiteTupleToNat_sup a' b'⟩

/-- The exact finite variables embed by forgetting only their upper-bound proof. -/
def finiteVariableEmbedding : FiniteVariable.{u} n ↪ (Fin d × ℕ) where
  toFun x := ⟨x.1,x.2.down.val⟩
  inj' := by
    rintro ⟨r,⟨i⟩⟩ ⟨s,⟨j⟩⟩ h
    have hrs : r = s := congrArg Prod.fst h
    subst s
    have hij : i = j := Fin.ext (congrArg Prod.snd h)
    subst j
    rfl

@[simp] lemma finiteVariableEmbedding_apply (r : Fin d) (j : Fin (n r)) :
    finiteVariableEmbedding (n := n) ⟨r,ULift.up j⟩ = (r,j.val) := rfl

lemma finiteVariableEmbedding_range (x : Fin d × ℕ) :
    x ∈ Set.range (finiteVariableEmbedding (n := n)) ↔ x.2 < n x.1 := by
  constructor
  · rintro ⟨⟨r,⟨j⟩⟩,rfl⟩
    exact j.isLt
  · intro hx
    exact ⟨⟨x.1,ULift.up ⟨x.2,hx⟩⟩,rfl⟩

lemma finiteRowExponent_embedding (a : FiniteTuple n) :
    (finiteRowExponent n a).embDomain finiteVariableEmbedding = rowExponent (finiteTupleToNat a) := by
  unfold finiteRowExponent rowExponent
  rw [Finsupp.embDomain_eq_mapDomain,Finsupp.mapDomain_finsetSum]
  apply Finset.sum_congr rfl
  intro r _
  rw [Finsupp.mapDomain_single]
  rfl

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.Weights -/
section
set_option autoImplicit false

/-!
# One explicit positive weight for the presentation relations

This supplies a direct finite weight construction for Proposition 2.2.  Give every
row variable weight one.  If `r(a)` is the sum of the coordinates and `M` bounds
these sums, give `T_a` weight `r(a) * (2*M + 1 - r(a)) + 1`.  The weight is positive,
strictly increases on comparable tuples, and is strictly concave under uncrossing.
Consequently both families of displayed relations have the asserted leading terms.
-/

namespace FourPapers.Sublattice

open Finset

variable {R : Type*} [Fintype R] [DecidableEq R]

def tupleRank (a : R → ℕ) : ℕ := ∑ r, a r

lemma tupleRank_mono {a b : R → ℕ} (h : a ≤ b) : tupleRank a ≤ tupleRank b :=
  sum_le_sum fun r _ => h r

lemma tupleRank_strict {a b : R → ℕ} (hab : a ≤ b) (hne : a ≠ b) :
    tupleRank a < tupleRank b := by
  obtain ⟨⟨r,j⟩, hr⟩ := ratio_nonempty hab hne
  have hlt : a r < b r := (mem_ratio.mp hr).2
  exact sum_lt_sum (fun s _ => hab s) ⟨r, mem_univ r, hlt⟩

lemma tupleRank_inf_add_sup (a b : R → ℕ) :
    tupleRank (a ⊓ b) + tupleRank (a ⊔ b) = tupleRank a + tupleRank b := by
  unfold tupleRank
  rw [← sum_add_distrib, ← sum_add_distrib]
  apply sum_congr rfl
  intro r _
  exact min_add_max (a r) (b r)

/-- A positive, strictly concave function on the integer interval `[0,M]`. -/
def concaveWeight (M s : ℕ) : ℕ := s * (2 * M + 1 - s) + 1

lemma concaveWeight_pos (M s : ℕ) : 0 < concaveWeight M s := by
  unfold concaveWeight
  omega

lemma concaveWeight_equation {M s : ℕ} (hs : s ≤ M) :
    concaveWeight M s + s * s = (2 * M + 1) * s + 1 := by
  have he : (2 * M + 1 - s) + s = 2 * M + 1 := Nat.sub_add_cancel (by omega)
  calc
    _ = s * ((2 * M + 1 - s) + s) + 1 := by unfold concaveWeight; ring
    _ = _ := by rw [he]; ring

lemma concaveWeight_strict {M s t : ℕ} (hst : s < t) (ht : t ≤ M) :
    concaveWeight M s < concaveWeight M t := by
  have hs : s ≤ M := (le_of_lt hst).trans ht
  have es := concaveWeight_equation hs
  have et := concaveWeight_equation ht
  have hsum : s + t < 2 * M + 1 := by omega
  have hprod : 0 < (t - s) * (2 * M + 1 - (s + t)) :=
    Nat.mul_pos (Nat.sub_pos_of_lt hst) (Nat.sub_pos_of_lt hsum)
  have hts : t - s + s = t := Nat.sub_add_cancel (le_of_lt hst)
  have hrem : (2 * M + 1 - (s + t)) + (s + t) = 2 * M + 1 :=
    Nat.sub_add_cancel (le_of_lt hsum)
  nlinarith

lemma concaveWeight_uncross {M r s t u : ℕ}
    (hr : r ≤ M) (hs : s ≤ M) (ht : t ≤ M) (hu : u ≤ M)
    (hrs : r < s) (hrt : r < t) (heq : r + u = s + t) :
    concaveWeight M r + concaveWeight M u <
      concaveWeight M s + concaveWeight M t := by
  obtain ⟨x, rfl⟩ := Nat.exists_eq_add_of_le (le_of_lt hrs)
  obtain ⟨y, rfl⟩ := Nat.exists_eq_add_of_le (le_of_lt hrt)
  have hu' : u = r + x + y := by omega
  subst u
  have er := concaveWeight_equation hr
  have es := concaveWeight_equation hs
  have et := concaveWeight_equation ht
  have eu := concaveWeight_equation hu
  have hprod : 0 < x * y := Nat.mul_pos (by omega) (by omega)
  nlinarith only [er, es, et, eu, hprod]

/-- The common finite rank bound, and hence the weight, depends only on `E`. -/
def rankBound (E : Finset (R → ℕ)) : ℕ := E.sup tupleRank

lemma tupleRank_le_rankBound {E : Finset (R → ℕ)} {a : R → ℕ} (ha : a ∈ E) :
    tupleRank a ≤ rankBound E := le_sup ha

def reesVariableWeight (E : Finset (R → ℕ)) (a : R → ℕ) : ℕ :=
  concaveWeight (rankBound E) (tupleRank a)

lemma reesVariableWeight_pos (E : Finset (R → ℕ)) (a : R → ℕ) :
    0 < reesVariableWeight E a := concaveWeight_pos _ _

/-- The `T_a` term of a predecessor relation is strictly heavier.  The row
coefficient monomials have equal degree, so assigning row variables weight one
does not change this inequality. -/
theorem predecessor_weight_strict {E : Finset (R → ℕ)} {a b : R → ℕ}
    (ha : a ∈ E) (hba : b ≤ a) (hne : b ≠ a) :
    reesVariableWeight E b < reesVariableWeight E a :=
  concaveWeight_strict (tupleRank_strict hba hne) (tupleRank_le_rankBound ha)

/-- The unsorted term of every nontrivial sorting relation is strictly heavier. -/
theorem sorting_weight_strict {E : Finset (R → ℕ)} (hE : LatticeClosed E)
    {a b : R → ℕ} (ha : a ∈ E) (hb : b ∈ E)
    (hab : ¬ a ≤ b) (hba : ¬ b ≤ a) :
    reesVariableWeight E (a ⊓ b) + reesVariableWeight E (a ⊔ b) <
      reesVariableWeight E a + reesVariableWeight E b := by
  have hmeetA : a ⊓ b ≠ a := fun h => hab (inf_eq_left.mp h)
  have hmeetB : a ⊓ b ≠ b := fun h => hba (inf_eq_right.mp h)
  exact concaveWeight_uncross
    (tupleRank_le_rankBound (hE.1 a ha b hb)) (tupleRank_le_rankBound ha)
    (tupleRank_le_rankBound hb) (tupleRank_le_rankBound (hE.2 a ha b hb))
    (tupleRank_strict inf_le_left hmeetA) (tupleRank_strict inf_le_right hmeetB)
    (tupleRank_inf_add_sup a b)

end FourPapers.Sublattice

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.WeightedOrder -/
section
set_option autoImplicit false

/-!
# Refining a nonnegative integer weight to a monomial order

The graph of the weight map, with a given monomial order as tie breaker, is an
ordered additive submonoid of a lexicographic product.  This construction keeps
well-foundedness explicit; no informal term-order realization is assumed.
-/

noncomputable section

namespace FourPapers.Sublattice

open scoped MonomialOrder

variable {σ : Type*}

def weightedGraph (m : MonomialOrder σ) (w : σ → ℕ) :
    (σ →₀ ℕ) →+ (ℕ ×ₗ m.syn) where
  toFun a := toLex (Finsupp.weight w a, m.toSyn a)
  map_zero' := by simp
  map_add' a b := by simp [← toLex_add]

lemma weightedGraph_leftInverse (m : MonomialOrder σ) (w : σ → ℕ) :
    Function.LeftInverse (fun p : ℕ ×ₗ m.syn => m.toSyn.symm (ofLex p).2)
      (weightedGraph m w) := by
  intro a
  exact m.toSyn.symm_apply_apply a

lemma nat_weight_monotone (w : σ → ℕ) : Monotone (Finsupp.weight w : (σ →₀ ℕ) →+ ℕ) := by
  intro a b hab
  have he : a + (b - a) = b := add_tsub_cancel_of_le hab
  calc
    Finsupp.weight w a ≤ Finsupp.weight w a + Finsupp.weight w (b - a) :=
      Nat.le_add_right _ _
    _ = Finsupp.weight w b := by rw [← map_add, he]

/-- A genuine monomial order comparing `w`-weight first. -/
def weightedOrder (m : MonomialOrder σ) (w : σ → ℕ) : MonomialOrder σ where
  syn := AddMonoidHom.mrange (weightedGraph m w)
  toSyn := AddEquiv.ofLeftInverse' (weightedGraph m w)
    (weightedGraph_leftInverse m w)
  toSyn_monotone := by
    intro a b hab
    change toLex (Finsupp.weight w a, m.toSyn a) ≤
      toLex (Finsupp.weight w b, m.toSyn b)
    rw [Prod.Lex.toLex_le_toLex]
    rcases (nat_weight_monotone w hab).lt_or_eq with hlt | heq
    · exact Or.inl hlt
    · exact Or.inr ⟨heq,m.toSyn_monotone hab⟩

theorem weightedOrder_lt_iff (m : MonomialOrder σ) (w : σ → ℕ)
    (a b : σ →₀ ℕ) :
    a ≺[weightedOrder m w] b ↔
      Finsupp.weight w a < Finsupp.weight w b ∨
        Finsupp.weight w a = Finsupp.weight w b ∧ a ≺[m] b := by
  change toLex (Finsupp.weight w a, m.toSyn a) <
    toLex (Finsupp.weight w b, m.toSyn b) ↔ _
  exact Prod.Lex.toLex_lt_toLex

theorem weightedOrder_lt_of_weight_lt (m : MonomialOrder σ) (w : σ → ℕ)
    {a b : σ →₀ ℕ} (h : Finsupp.weight w a < Finsupp.weight w b) :
    a ≺[weightedOrder m w] b :=
  (weightedOrder_lt_iff m w a b).mpr (Or.inl h)

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.ReesRelations -/
section
set_option autoImplicit false

/-!
# The actual polynomial relations of the sublattice Rees algebra

The presentation map takes a row variable to itself and `T_a` to `u_a t` in a
polynomial ring with one additional variable.  Relations below are polynomials,
and their vanishing is proved by equality of their exponent vectors.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical MvPolynomial Finset
open scoped MonomialOrder

variable {R k : Type*} [Fintype R] [LinearOrder R] [CommRing k]

abbrev ReesVariable (E : Finset (R → ℕ)) := (R × ℕ) ⊕ E

@[simp] lemma rowEmbedding_none (e : (R × ℕ) →₀ ℕ) :
    e.embDomain Function.Embedding.some none = 0 :=
  Finsupp.embDomain_of_notMem_range _ _ _ (by simp)

/-- Exponents of the images of the presentation variables; `none` is `t`. -/
def reesVariableExponent (E : Finset (R → ℕ)) :
    ReesVariable E → Option (R × ℕ) →₀ ℕ
  | Sum.inl x => Finsupp.single (some x) 1
  | Sum.inr a => (rowExponent a.val).embDomain Function.Embedding.some +
      Finsupp.single none 1

def reesExponentMap (E : Finset (R → ℕ)) :
    (ReesVariable E →₀ ℕ) →+ (Option (R × ℕ) →₀ ℕ) :=
  Finsupp.weight (reesVariableExponent E)

/-- The map `S[T_a] → S[t]`, with target written as multivariate polynomials. -/
def reesPresentationMap (E : Finset (R → ℕ)) :
    MvPolynomial (ReesVariable E) k →ₐ[k] MvPolynomial (Option (R × ℕ)) k :=
  AddMonoidAlgebra.mapDomainAlgHom k k (reesExponentMap E)

@[simp] lemma reesPresentationMap_monomial (E : Finset (R → ℕ))
    (e : ReesVariable E →₀ ℕ) (c : k) :
    reesPresentationMap E (monomial e c) = monomial (reesExponentMap E e) c := by
  exact AddMonoidAlgebra.mapDomain_single

@[simp] lemma reesExponentMap_single (E : Finset (R → ℕ))
    (x : ReesVariable E) (n : ℕ) :
    reesExponentMap E (Finsupp.single x n) = n • reesVariableExponent E x :=
  Finsupp.weight_single _ _ _

@[simp] lemma reesPresentationMap_X_row (E : Finset (R → ℕ)) (x : R × ℕ) :
    reesPresentationMap (k := k) E (X (Sum.inl x)) = X (some x) := by
  simp [X,reesVariableExponent]

@[simp] lemma reesPresentationMap_X_factor (E : Finset (R → ℕ)) (a : E) :
    reesPresentationMap (k := k) E (X (Sum.inr a)) =
      rename some (rowMonomial a.val) * X none := by
  simp [X,reesVariableExponent,rowMonomial_eq_monomial,rename_monomial,
    Finsupp.embDomain_eq_mapDomain,monomial_mul]

/-- The row exponent of a product is preserved by lattice sorting. -/
lemma rowExponent_inf_add_sup (a b : R → ℕ) :
    rowExponent (a ⊓ b) + rowExponent (a ⊔ b) = rowExponent a + rowExponent b := by
  ext x
  rcases x with ⟨r,j⟩
  simpa only [Finsupp.add_apply,rowExponent_apply,generatorExponent] using
    generatorExponent_inf_add_sup a b (r,j)

def sortingHeadExponent {E : Finset (R → ℕ)} (a b : E) : ReesVariable E →₀ ℕ :=
  Finsupp.single (Sum.inr a) 1 + Finsupp.single (Sum.inr b) 1

def sortingTailExponent {E : Finset (R → ℕ)} (hE : LatticeClosed E) (a b : E) :
    ReesVariable E →₀ ℕ :=
  Finsupp.single (Sum.inr ⟨a.val ⊓ b.val,hE.1 a.val a.property b.val b.property⟩) 1 +
    Finsupp.single (Sum.inr ⟨a.val ⊔ b.val,hE.2 a.val a.property b.val b.property⟩) 1

def sortingRelation {E : Finset (R → ℕ)} (hE : LatticeClosed E) (a b : E) :
    MvPolynomial (ReesVariable E) k :=
  monomial (sortingHeadExponent a b) 1 - monomial (sortingTailExponent hE a b) 1

lemma sorting_exponent_images {E : Finset (R → ℕ)} (hE : LatticeClosed E) (a b : E) :
    reesExponentMap E (sortingHeadExponent a b) =
      reesExponentMap E (sortingTailExponent hE a b) := by
  simp only [sortingHeadExponent,sortingTailExponent,map_add,reesExponentMap_single,
    one_nsmul,reesVariableExponent]
  have hrow :
      (rowExponent a.val).embDomain Function.Embedding.some +
        (rowExponent b.val).embDomain Function.Embedding.some =
      (rowExponent (a.val ⊓ b.val)).embDomain Function.Embedding.some +
        (rowExponent (a.val ⊔ b.val)).embDomain Function.Embedding.some := by
    rw [← Finsupp.embDomain_add,← Finsupp.embDomain_add,rowExponent_inf_add_sup]
  calc
    _ = ((rowExponent a.val).embDomain Function.Embedding.some +
        (rowExponent b.val).embDomain Function.Embedding.some) +
        (Finsupp.single none 1 + Finsupp.single none 1) := by abel
    _ = ((rowExponent (a.val ⊓ b.val)).embDomain Function.Embedding.some +
        (rowExponent (a.val ⊔ b.val)).embDomain Function.Embedding.some) +
        (Finsupp.single none 1 + Finsupp.single none 1) := by rw [hrow]
    _ = _ := by abel

@[simp] theorem sortingRelation_vanishes {E : Finset (R → ℕ)}
    (hE : LatticeClosed E) (a b : E) :
    reesPresentationMap E (sortingRelation (k := k) hE a b) = 0 := by
  simp [sortingRelation,sorting_exponent_images hE a b]

/-- The head of a coefficient relation uses the earlier row tuple's ratio. -/
def coefficientHeadExponent {E : Finset (R → ℕ)} (b a : E) :
    ReesVariable E →₀ ℕ :=
  (rowExponent b.val - rowExponent a.val).embDomain Function.Embedding.inl +
    Finsupp.single (Sum.inr a) 1

def coefficientRelation {E : Finset (R → ℕ)} (b a : E) :
    MvPolynomial (ReesVariable E) k :=
  monomial (coefficientHeadExponent b a) 1 - monomial (coefficientHeadExponent a b) 1

lemma reesExponentMap_embDomain_row (E : Finset (R → ℕ)) (e : (R × ℕ) →₀ ℕ) :
    reesExponentMap E (e.embDomain Function.Embedding.inl) =
      e.embDomain Function.Embedding.some := by
  refine e.induction ?_ ?_
  · simp
  · intro a n e _ _ ih
    simp only [Finsupp.embDomain_add,map_add,ih,Finsupp.embDomain_single,
      reesExponentMap_single]
    change n • Finsupp.single (some a) 1 + e.embDomain Function.Embedding.some =
      Finsupp.single (some a) n + e.embDomain Function.Embedding.some
    simp only [Finsupp.smul_single,smul_eq_mul,mul_one]

lemma coefficient_exponent_images {E : Finset (R → ℕ)} (b a : E) :
    reesExponentMap E (coefficientHeadExponent b a) =
      reesExponentMap E (coefficientHeadExponent a b) := by
  simp only [coefficientHeadExponent,map_add,reesExponentMap_embDomain_row,
    reesExponentMap_single,one_nsmul,reesVariableExponent]
  rw [← add_assoc,← add_assoc,← Finsupp.embDomain_add,← Finsupp.embDomain_add]
  congr 2
  ext x
  simp only [Finsupp.add_apply,Finsupp.tsub_apply]
  omega

@[simp] theorem coefficientRelation_vanishes {E : Finset (R → ℕ)} (b a : E) :
    reesPresentationMap E (coefficientRelation (k := k) b a) = 0 := by
  simp [coefficientRelation,coefficient_exponent_images b a]

/-- The weight of every row variable is one. -/
def presentationWeight (E : Finset (R → ℕ)) : ReesVariable E → ℕ
  | Sum.inl _ => 1
  | Sum.inr a => reesVariableWeight E a.val

lemma presentationWeight_pos (E : Finset (R → ℕ)) (x : ReesVariable E) :
    0 < presentationWeight E x := by
  cases x with
  | inl x => exact Nat.zero_lt_one
  | inr a => exact reesVariableWeight_pos _ _

lemma presentationWeight_squareExponent (E : Finset (R → ℕ)) (g : Finset (R × ℕ)) :
    Finsupp.weight (presentationWeight E)
      ((squareExponent g).embDomain Function.Embedding.inl) = g.card := by
  change Finsupp.linearCombination ℕ (presentationWeight E)
    ((squareExponent g).embDomain Function.Embedding.inl) = _
  rw [Finsupp.linearCombination_embDomain]
  simp [squareExponent,map_sum,Finsupp.linearCombination_single,presentationWeight,
    Function.comp_def]

lemma generalRatio_card_swap (b a : R → ℕ) :
    (generalRatio b a).card = (generalRatio a b).card := by
  rw [generalRatio,generalRatio,
    card_image_of_injective _ (fun r s h => congrArg Prod.fst h),
    card_image_of_injective _ (fun r s h => congrArg Prod.fst h)]
  congr 1
  ext r
  simp [ne_comm]

lemma coefficientHeadExponent_weight {E : Finset (R → ℕ)} (b a : E) :
    Finsupp.weight (presentationWeight E) (coefficientHeadExponent b a) =
      (generalRatio b.val a.val).card + reesVariableWeight E a.val := by
  rw [coefficientHeadExponent,map_add,← generalRatio_exponent,
    presentationWeight_squareExponent,Finsupp.weight_single]
  simp [presentationWeight]

lemma coefficient_weight_order {E : Finset (R → ℕ)}
    (m : MonomialOrder (ReesVariable E)) (b a : E)
    (hba : b.val ≤ a.val) (hne : b.val ≠ a.val) :
    coefficientHeadExponent a b ≺[weightedOrder m (presentationWeight E)]
      coefficientHeadExponent b a := by
  apply weightedOrder_lt_of_weight_lt
  rw [coefficientHeadExponent_weight,coefficientHeadExponent_weight,
    generalRatio_card_swap a.val b.val]
  exact Nat.add_lt_add_left (predecessor_weight_strict a.property hba hne) _

lemma sorting_weight_order {E : Finset (R → ℕ)} (hE : LatticeClosed E)
    (m : MonomialOrder (ReesVariable E)) (a b : E)
    (hab : ¬ a.val ≤ b.val) (hba : ¬ b.val ≤ a.val) :
    sortingTailExponent hE a b ≺[weightedOrder m (presentationWeight E)]
      sortingHeadExponent a b := by
  apply weightedOrder_lt_of_weight_lt
  simpa only [sortingHeadExponent,sortingTailExponent,map_add,Finsupp.weight_single,
    one_nsmul,presentationWeight] using sorting_weight_strict hE a.property b.property hab hba

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.StandardExponent -/
section
set_option autoImplicit false

/-!
# Standard exponent vectors and ordered factors

The normal-form uniqueness lemma is stated for lists. Here the multiplicity
function of the Rees variables is converted to such a list, with a proof that no
exponent or multiplicity changes. This gives injectivity for polynomial exponent
vectors, rather than merely for already chosen lists of factors.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical

variable {R : Type*} [Fintype R] [DecidableEq R]
variable {E : Finset (R → ℕ)}

/-- The product factors arranged by a fixed linear extension of the partial order. -/
def orderedFactors (t : E →₀ ℕ) : List E :=
  ((t.toMultiset.map (toLinearExtension : E → LinearExtension E)).sort (· ≤ ·)).map
    (fun a : LinearExtension E => (show E from a))

lemma orderedFactors_multiset (t : E →₀ ℕ) :
    (orderedFactors t : Multiset E) = t.toMultiset := by
  unfold orderedFactors
  rw [← Multiset.map_coe,Multiset.sort_eq,Multiset.map_map]
  exact Multiset.map_id _

lemma mem_orderedFactors (t : E →₀ ℕ) (a : E) :
    a ∈ orderedFactors t ↔ t a ≠ 0 := by
  rw [← Multiset.mem_coe, orderedFactors_multiset, Finsupp.mem_toMultiset,
    Finsupp.mem_support_iff]

lemma orderedFactors_length (t : E →₀ ℕ) :
    (orderedFactors t).length = t.toMultiset.card := by
  rw [← Multiset.coe_card, orderedFactors_multiset]

lemma orderedFactors_injective : Function.Injective (orderedFactors (E := E)) := by
  intro t u h
  have hm := congrArg (fun w : List E => (w : Multiset E)) h
  rw [orderedFactors_multiset, orderedFactors_multiset] at hm
  exact (Finsupp.toMultiset_eq_iff.mp hm).trans (Finsupp.toMultiset_toFinsupp u)

lemma orderedFactors_pairwise (t : E →₀ ℕ)
    (hcomp : ∀ a b : E, t a ≠ 0 → t b ≠ 0 → a.val ≤ b.val ∨ b.val ≤ a.val) :
    ((orderedFactors t).map Subtype.val).Pairwise (· ≤ ·) := by
  let l := (t.toMultiset.map (toLinearExtension : E → LinearExtension E)).sort (· ≤ ·)
  have hsort : l.Pairwise (· ≤ ·) := Multiset.pairwise_sort _ _
  have hmem (a : LinearExtension E) (ha : a ∈ l) : t (show E from a) ≠ 0 := by
    have hh : (show E from a) ∈ orderedFactors t :=
      List.mem_map.mpr ⟨a,ha,rfl⟩
    exact (mem_orderedFactors t _).mp hh
  have hpair : l.Pairwise (fun a b : LinearExtension E =>
      (show E from a).val ≤ (show E from b).val) := by
    apply hsort.imp_of_mem
    intro a b ha hb hab
    rcases hcomp (show E from a) (show E from b) (hmem a ha) (hmem b hb) with h | h
    · exact h
    · have hba : b ≤ a := (toLinearExtension (α := E)).monotone
        (show (show E from b) ≤ (show E from a) from h)
      have he : a = b := le_antisymm hab hba
      exact he ▸ le_rfl
  unfold orderedFactors
  rw [List.pairwise_map,List.pairwise_map]
  exact hpair

/-- Precisely the two forbidden-divisor conditions in the proposed initial ideal. -/
def StandardExponent (E : Finset (R → ℕ)) (t : E →₀ ℕ)
    (v : (R × ℕ) → ℕ) : Prop :=
  (∀ a b : E, t a ≠ 0 → t b ≠ 0 → a.val ≤ b.val ∨ b.val ≤ a.val) ∧
  (∀ a : E, t a ≠ 0 → ∀ b ∈ E, b ≤ a.val → b ≠ a.val →
    ¬ ∀ x ∈ ratio b a.val, 0 < v x)

lemma orderedFactors_standardForm {t : E →₀ ℕ} {v : (R × ℕ) → ℕ}
    (h : StandardExponent E t v) :
    StandardForm E ((orderedFactors t).map Subtype.val) v := by
  refine ⟨?_,orderedFactors_pairwise t h.1,?_⟩
  · intro a ha
    obtain ⟨b,_,rfl⟩ := List.mem_map.mp ha
    exact b.property
  · intro a ha b hb hba hne
    obtain ⟨c,hc,rfl⟩ := List.mem_map.mp ha
    exact h.2 c ((mem_orderedFactors t c).mp hc) b hb hba hne

/-- Fine exponent of the image of a polynomial monomial in the Rees algebra. -/
def standardImageExponent (t : E →₀ ℕ) (v : (R × ℕ) → ℕ) (x : R × ℕ) : ℕ :=
  v x + (t.toMultiset.map (fun a : E => generatorExponent a.val x)).sum

lemma orderedFactors_imageExponent (t : E →₀ ℕ) (v : (R × ℕ) → ℕ) :
    imageExponent ((orderedFactors t).map Subtype.val) v = standardImageExponent t v := by
  funext x
  unfold imageExponent chainExponent standardImageExponent
  rw [List.map_map]
  have hh := congrArg (fun s : Multiset E =>
    (s.map fun a => generatorExponent a.val x).sum) (orderedFactors_multiset t)
  simpa only [Multiset.map_coe, Multiset.sum_coe, Function.comp_def] using congrArg (v x + ·) hh

/-- Polynomial standard exponents are recovered from their fine image and Rees
degree. There are no restrictions on the field, exponent range, or power. -/
theorem standardExponent_image_injective (hE : MeetClosed E)
    {t u : E →₀ ℕ} {v v' : (R × ℕ) → ℕ}
    (ht : StandardExponent E t v) (hu : StandardExponent E u v')
    (hdeg : t.toMultiset.card = u.toMultiset.card)
    (him : standardImageExponent t v = standardImageExponent u v') :
    t = u ∧ v = v' := by
  have hlen : ((orderedFactors t).map Subtype.val).length =
      ((orderedFactors u).map Subtype.val).length := by
    simpa only [List.length_map, orderedFactors_length] using hdeg
  have hime : imageExponent ((orderedFactors t).map Subtype.val) v =
      imageExponent ((orderedFactors u).map Subtype.val) v' := by
    simpa only [orderedFactors_imageExponent] using him
  obtain ⟨hw,hv⟩ := standardForm_image_injective hE
    (orderedFactors_standardForm ht) (orderedFactors_standardForm hu) hlen hime
  refine ⟨orderedFactors_injective ?_,hv⟩
  exact List.map_injective_iff.mpr Subtype.val_injective hw

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.ReesCoordinates -/
section
set_option autoImplicit false

/-! # Exact standard exponent coordinates for the Rees algebra -/

noncomputable section

namespace FourPapers.Sublattice

open Classical MvPolynomial Finset

variable {R : Type*} [Fintype R] [LinearOrder R]
variable {E : Finset (R → ℕ)}

def coefficientPart (c : ReesVariable E →₀ ℕ) : (R × ℕ) →₀ ℕ :=
  c.comapDomain Sum.inl Sum.inl_injective.injOn

def factorPart (c : ReesVariable E →₀ ℕ) : E →₀ ℕ :=
  c.comapDomain Sum.inr Sum.inr_injective.injOn

@[simp] lemma coefficientPart_apply (c : ReesVariable E →₀ ℕ) (x : R × ℕ) :
    coefficientPart c x = c (Sum.inl x) := rfl

@[simp] lemma factorPart_apply (c : ReesVariable E →₀ ℕ) (a : E) :
    factorPart c a = c (Sum.inr a) := rfl

lemma exponent_eq_of_parts {c d : ReesVariable E →₀ ℕ}
    (hv : coefficientPart c = coefficientPart d) (ht : factorPart c = factorPart d) : c = d := by
  ext x
  cases x with
  | inl x => exact congrFun (congrArg DFunLike.coe hv) x
  | inr a => exact congrFun (congrArg DFunLike.coe ht) a

lemma sortingHeadExponent_le_iff {a b : E} (hne : a ≠ b) (c : ReesVariable E →₀ ℕ) :
    sortingHeadExponent a b ≤ c ↔ factorPart c a ≠ 0 ∧ factorPart c b ≠ 0 := by
  constructor
  · intro h
    constructor
    · have hh := h (Sum.inr a)
      simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,sortingHeadExponent,Finsupp.single_apply,hne] using hh
    · have hh := h (Sum.inr b)
      simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,sortingHeadExponent,Finsupp.single_apply,hne.symm] using hh
  · rintro ⟨ha,hb⟩ x
    cases x with
    | inl x => simp [sortingHeadExponent]
    | inr d =>
      by_cases hda : d = a
      · subst d
        simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,sortingHeadExponent,Finsupp.single_apply,hne] using Nat.pos_of_ne_zero ha
      · by_cases hdb : d = b
        · subst d
          simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,sortingHeadExponent,Finsupp.single_apply,hne.symm] using Nat.pos_of_ne_zero hb
        · simp [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,sortingHeadExponent,Finsupp.single_apply,Ne.symm hda,Ne.symm hdb]

lemma coefficientHeadExponent_le_iff {b a : E} (hba : b.val ≤ a.val)
    (c : ReesVariable E →₀ ℕ) :
    coefficientHeadExponent b a ≤ c ↔ factorPart c a ≠ 0 ∧
      ∀ x ∈ ratio b.val a.val, 0 < coefficientPart c x := by
  have he : rowExponent b.val - rowExponent a.val = squareExponent (ratio b.val a.val) := by
    rw [← generalRatio_exponent,generalRatio_eq_ratio hba]
  constructor
  · intro h
    refine ⟨?_,?_⟩
    · have hh := h (Sum.inr a)
      simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,coefficientHeadExponent,he,Finsupp.embDomain_inl,Finsupp.sumElim_apply] using hh
    · intro x hx
      have hh := h (Sum.inl x)
      simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,coefficientHeadExponent,he,Finsupp.embDomain_inl,Finsupp.sumElim_apply,hx] using hh
  · rintro ⟨ha,hv⟩ x
    cases x with
    | inl x =>
      by_cases hx : x ∈ ratio b.val a.val
      · simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,coefficientHeadExponent,he,Finsupp.embDomain_inl,Finsupp.sumElim_apply,hx]
          using hv x hx
      · simp [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,coefficientHeadExponent,he,Finsupp.embDomain_inl,Finsupp.sumElim_apply,hx]
    | inr b =>
      by_cases h : a = b
      · subst b
        simpa [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,coefficientHeadExponent,Finsupp.embDomain_inl,Finsupp.sumElim_apply]
          using Nat.pos_of_ne_zero ha
      · simp [Nat.one_le_iff_ne_zero,Nat.pos_iff_ne_zero,coefficientHeadExponent,Finsupp.embDomain_inl,Finsupp.sumElim_apply,
          Finsupp.single_apply,h]

lemma weight_eq_sum_toMultiset {σ M : Type*} [AddCommMonoid M]
    (f : σ → M) (t : σ →₀ ℕ) :
    Finsupp.weight f t = (t.toMultiset.map f).sum := by
  refine t.induction ?_ ?_
  · simp
  · intro a n t _ _ ih
    rw [map_add,Finsupp.toMultiset_add,Multiset.map_add,Multiset.sum_add,ih]
    congr 1
    rw [Finsupp.weight_single,Finsupp.toMultiset_single]
    change n • f a = (Multiset.mapAddMonoidHom f (n • ({a} : Multiset σ))).sum
    rw [map_nsmul,Multiset.sum_nsmul]
    simp

lemma exponent_parts_decomposition (c : ReesVariable E →₀ ℕ) :
    (coefficientPart c).embDomain Function.Embedding.inl +
      (factorPart c).embDomain Function.Embedding.inr = c := by
  ext x
  cases x <;> simp [Finsupp.embDomain_inl,Finsupp.embDomain_inr,Finsupp.sumElim_apply]

lemma reesExponentMap_embDomain_factor (t : E →₀ ℕ) :
    reesExponentMap E (t.embDomain Function.Embedding.inr) =
      Finsupp.weight (fun a : E => reesVariableExponent E (Sum.inr a)) t := by
  change Finsupp.linearCombination ℕ (reesVariableExponent E)
    (t.embDomain Function.Embedding.inr) = _
  rw [Finsupp.linearCombination_embDomain]
  rfl

lemma reesExponentMap_none (c : ReesVariable E →₀ ℕ) :
    reesExponentMap E c none = (factorPart c).toMultiset.card := by
  conv_lhs => rw [← exponent_parts_decomposition c]
  rw [map_add,reesExponentMap_embDomain_row,reesExponentMap_embDomain_factor]
  simp only [Finsupp.add_apply,Finsupp.weight_eq_sum,Finsupp.finset_sum_apply,
    Finsupp.smul_apply,reesVariableExponent]
  simp only [rowEmbedding_none,Finsupp.single_eq_same,
    Finsupp.add_apply,zero_add,smul_eq_mul,mul_one]
  rw [Finsupp.card_toMultiset]
  exact ((factorPart c).sum_fintype (fun _ n => n) (fun _ => rfl)).symm

lemma reesExponentMap_some (c : ReesVariable E →₀ ℕ) (x : R × ℕ) :
    reesExponentMap E c (some x) =
      standardImageExponent (factorPart c) (coefficientPart c) x := by
  conv_lhs => rw [← exponent_parts_decomposition c]
  rw [map_add,reesExponentMap_embDomain_row,reesExponentMap_embDomain_factor]
  rw [standardImageExponent,← weight_eq_sum_toMultiset]
  simp only [Finsupp.add_apply,Finsupp.weight_eq_sum,Finsupp.finset_sum_apply,
    Finsupp.smul_apply,reesVariableExponent]
  have hsome (e : (R × ℕ) →₀ ℕ) : e.embDomain Function.Embedding.some (some x) = e x :=
    Finsupp.embDomain_apply_self _ _ _
  have hnone : (none : Option (R × ℕ)) ≠ some x := by simp
  simp only [hsome,Finsupp.single_apply,hnone,ite_false,add_zero,smul_eq_mul]
  congr 1
  apply sum_congr rfl
  intro a _
  rcases x with ⟨r,j⟩
  simp only [rowExponent_apply,generatorExponent]


/-- The standardness condition as a predicate on the whole presentation exponent. -/
def ReesStandard (c : ReesVariable E →₀ ℕ) : Prop :=
  StandardExponent E (factorPart c) (coefficientPart c)

/-- Distinct standard monomials have distinct actual monomial images. -/
theorem reesStandard_image_injective (hE : LatticeClosed E)
    {c d : ReesVariable E →₀ ℕ} (hc : ReesStandard c) (hd : ReesStandard d)
    (h : reesExponentMap E c = reesExponentMap E d) : c = d := by
  have hdeg : (factorPart c).toMultiset.card = (factorPart d).toMultiset.card := by
    simpa only [reesExponentMap_none] using congrArg (fun e => e none) h
  have him : standardImageExponent (factorPart c) (coefficientPart c) =
      standardImageExponent (factorPart d) (coefficientPart d) := by
    funext x
    simpa only [reesExponentMap_some] using congrArg (fun e => e (some x)) h
  obtain ⟨ht,hv⟩ := standardExponent_image_injective hE.1 hc hd hdeg him
  apply exponent_eq_of_parts
  · exact DFunLike.coe_injective hv
  · exact ht

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.ReesReduction -/
section
set_option autoImplicit false

/-!
# Terminating exact monomial reduction in every Rees degree

A reduction replaces one displayed relation head by its tail. The explicit
positive integer weight decreases strictly, while the actual monomial image in
`S[t]` remains unchanged. This proves existence of standard normal forms in all
powers without assuming a Gröbner basis or a division algorithm.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical Finset

variable {R : Type*} [Fintype R] [LinearOrder R]
variable {E : Finset (R → ℕ)}

abbrev reesWeight (E : Finset (R → ℕ)) : (ReesVariable E →₀ ℕ) →+ ℕ :=
  Finsupp.weight (presentationWeight E)

lemma coefficient_weight_decreases (b a : E) (hba : b.val ≤ a.val) (hne : b.val ≠ a.val) :
    reesWeight E (coefficientHeadExponent a b) < reesWeight E (coefficientHeadExponent b a) := by
  rw [coefficientHeadExponent_weight,coefficientHeadExponent_weight,
    generalRatio_card_swap a.val b.val]
  exact Nat.add_lt_add_left (predecessor_weight_strict a.property hba hne) _

lemma sorting_weight_decreases (hE : LatticeClosed E) (a b : E)
    (hab : ¬ a.val ≤ b.val) (hba : ¬ b.val ≤ a.val) :
    reesWeight E (sortingTailExponent hE a b) < reesWeight E (sortingHeadExponent a b) := by
  simpa only [sortingHeadExponent,sortingTailExponent,map_add,Finsupp.weight_single,
    one_nsmul,presentationWeight] using sorting_weight_strict hE a.property b.property hab hba

inductive ReesReductionStep (hE : LatticeClosed E)
    (c : ReesVariable E →₀ ℕ) : (ReesVariable E →₀ ℕ) → Prop
  | sorting (a b : E) (hab : ¬ a.val ≤ b.val) (hba : ¬ b.val ≤ a.val)
      (hdiv : sortingHeadExponent a b ≤ c) :
      ReesReductionStep hE c (c - sortingHeadExponent a b + sortingTailExponent hE a b)
  | coefficient (b a : E) (hba : b.val ≤ a.val) (hne : b.val ≠ a.val)
      (hdiv : coefficientHeadExponent b a ≤ c) :
      ReesReductionStep hE c (c - coefficientHeadExponent b a + coefficientHeadExponent a b)

lemma weight_replace_lt {σ : Type*} (w : σ → ℕ) {c head tail : σ →₀ ℕ}
    (hhead : head ≤ c) (hwt : Finsupp.weight w tail < Finsupp.weight w head) :
    Finsupp.weight w (c - head + tail) < Finsupp.weight w c := by
  calc
    Finsupp.weight w (c - head + tail) =
        Finsupp.weight w (c - head) + Finsupp.weight w tail := map_add _ _ _
    _ < Finsupp.weight w (c - head) + Finsupp.weight w head := Nat.add_lt_add_left hwt _
    _ = Finsupp.weight w c := by rw [← map_add,tsub_add_cancel_of_le hhead]

lemma reesReduction_weight_lt {hE : LatticeClosed E} {c d : ReesVariable E →₀ ℕ}
    (h : ReesReductionStep hE c d) : reesWeight E d < reesWeight E c := by
  cases h with
  | sorting a b hab hba hdiv =>
      exact weight_replace_lt _ hdiv (sorting_weight_decreases hE a b hab hba)
  | coefficient b a hba hne hdiv =>
      exact weight_replace_lt _ hdiv (coefficient_weight_decreases b a hba hne)

lemma image_replace_eq {σ M : Type*} [AddCommMonoid M] (f : (σ →₀ ℕ) →+ M)
    {c head tail : σ →₀ ℕ} (hhead : head ≤ c) (heq : f head = f tail) :
    f (c - head + tail) = f c := by
  rw [map_add,← heq,← map_add,tsub_add_cancel_of_le hhead]

lemma reesReduction_image_eq {hE : LatticeClosed E} {c d : ReesVariable E →₀ ℕ}
    (h : ReesReductionStep hE c d) : reesExponentMap E d = reesExponentMap E c := by
  cases h with
  | sorting a b hab hba hdiv =>
      exact image_replace_eq _ hdiv (sorting_exponent_images hE a b)
  | coefficient b a hba hne hdiv =>
      exact image_replace_eq _ hdiv (coefficient_exponent_images b a)

lemma exists_reesReduction_of_not_standard (hE : LatticeClosed E)
    (c : ReesVariable E →₀ ℕ) (hc : ¬ ReesStandard c) :
    ∃ d, ReesReductionStep hE c d := by
  unfold ReesStandard StandardExponent at hc
  rcases not_and_or.mp hc with hcomp | hcoeff
  · push_neg at hcomp
    obtain ⟨a,b,ha,hb,hab,hba⟩ := hcomp
    have hne : a ≠ b := fun h => hab (h ▸ le_rfl)
    exact ⟨_,ReesReductionStep.sorting a b hab hba
      ((sortingHeadExponent_le_iff hne c).mpr ⟨ha,hb⟩)⟩
  · push_neg at hcoeff
    obtain ⟨a,ha,b,hb,hba,hne,hdiv⟩ := hcoeff
    let b' : E := ⟨b,hb⟩
    exact ⟨_,ReesReductionStep.coefficient b' a hba hne
      ((coefficientHeadExponent_le_iff hba c).mpr ⟨ha,hdiv⟩)⟩

/-- Exact existence of standard images in every finite or unbounded exponent range. -/
theorem exists_reesNormalForm (hE : LatticeClosed E) (c : ReesVariable E →₀ ℕ) :
    ∃ d, ReesStandard d ∧ reesExponentMap E d = reesExponentMap E c ∧
      reesWeight E d ≤ reesWeight E c := by
  suffices h : ∀ n : ℕ, ∀ c : ReesVariable E →₀ ℕ, reesWeight E c = n →
      ∃ d, ReesStandard d ∧ reesExponentMap E d = reesExponentMap E c ∧
        reesWeight E d ≤ reesWeight E c from h _ c rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro c hc
      by_cases hstd : ReesStandard c
      · exact ⟨c,hstd,rfl,le_rfl⟩
      · obtain ⟨e,he⟩ := exists_reesReduction_of_not_standard hE c hstd
        have hlt : reesWeight E e < n := (reesReduction_weight_lt he).trans_eq hc
        obtain ⟨f,hf,hfe,hw⟩ := ih _ hlt e rfl
        exact ⟨f,hf,hfe.trans (reesReduction_image_eq he),
          hw.trans (reesReduction_weight_lt he).le⟩

def reesNormalForm (hE : LatticeClosed E) (c : ReesVariable E →₀ ℕ) :
    ReesVariable E →₀ ℕ := Classical.choose (exists_reesNormalForm hE c)

lemma reesNormalForm_standard (hE : LatticeClosed E) (c : ReesVariable E →₀ ℕ) :
    ReesStandard (reesNormalForm hE c) := (Classical.choose_spec (exists_reesNormalForm hE c)).1

@[simp] lemma reesNormalForm_image (hE : LatticeClosed E) (c : ReesVariable E →₀ ℕ) :
    reesExponentMap E (reesNormalForm hE c) = reesExponentMap E c :=
  (Classical.choose_spec (exists_reesNormalForm hE c)).2.1

lemma reesNormalForm_weight_le (hE : LatticeClosed E) (c : ReesVariable E →₀ ℕ) :
    reesWeight E (reesNormalForm hE c) ≤ reesWeight E c :=
  (Classical.choose_spec (exists_reesNormalForm hE c)).2.2

lemma reesNormalForm_eq_of_image_eq (hE : LatticeClosed E)
    {c d : ReesVariable E →₀ ℕ} (h : reesExponentMap E c = reesExponentMap E d) :
    reesNormalForm hE c = reesNormalForm hE d := by
  apply reesStandard_image_injective hE (reesNormalForm_standard hE c) (reesNormalForm_standard hE d)
  simpa only [reesNormalForm_image] using h

@[simp] lemma reesNormalForm_of_standard (hE : LatticeClosed E)
    {c : ReesVariable E →₀ ℕ} (hc : ReesStandard c) : reesNormalForm hE c = c :=
  reesStandard_image_injective hE (reesNormalForm_standard hE c) hc (reesNormalForm_image hE c)

lemma reesNormalForm_weight_lt (hE : LatticeClosed E)
    {c : ReesVariable E →₀ ℕ} (hc : ¬ ReesStandard c) :
    reesWeight E (reesNormalForm hE c) < reesWeight E c := by
  obtain ⟨d,hd⟩ := exists_reesReduction_of_not_standard hE c hc
  rw [reesNormalForm_eq_of_image_eq hE (reesReduction_image_eq hd).symm]
  exact (reesNormalForm_weight_le hE d).trans_lt (reesReduction_weight_lt hd)

@[simp] lemma reesStandard_zero : ReesStandard (0 : ReesVariable E →₀ ℕ) := by
  constructor <;> simp [factorPart]

@[simp] lemma reesNormalForm_zero (hE : LatticeClosed E) :
    reesNormalForm hE 0 = 0 := reesNormalForm_of_standard hE reesStandard_zero

lemma reesNormalForm_add_left (hE : LatticeClosed E) (c d : ReesVariable E →₀ ℕ) :
    reesNormalForm hE (reesNormalForm hE c + d) = reesNormalForm hE (c + d) := by
  apply reesNormalForm_eq_of_image_eq
  simp

lemma reesNormalForm_add_right (hE : LatticeClosed E) (c d : ReesVariable E →₀ ℕ) :
    reesNormalForm hE (c + reesNormalForm hE d) = reesNormalForm hE (c + d) := by
  apply reesNormalForm_eq_of_image_eq
  simp

lemma reesNormalForm_add_both (hE : LatticeClosed E) (c d : ReesVariable E →₀ ℕ) :
    reesNormalForm hE (reesNormalForm hE c + reesNormalForm hE d) = reesNormalForm hE (c + d) := by
  rw [reesNormalForm_add_left,reesNormalForm_add_right]

/-- Multiplying by a row variable either stays standard or strictly lowers its
expected weight. This is the exact associated-graded Koszul differential criterion. -/
theorem reesNormalForm_row_weight (hE : LatticeClosed E)
    (c : ReesVariable E →₀ ℕ) (x : R × ℕ) :
    reesWeight E (reesNormalForm hE (c + Finsupp.single (Sum.inl x) 1)) ≤ reesWeight E c + 1 ∧
    (¬ ReesStandard (c + Finsupp.single (Sum.inl x) 1) →
      reesWeight E (reesNormalForm hE (c + Finsupp.single (Sum.inl x) 1)) < reesWeight E c + 1) := by
  have hw : reesWeight E (c + Finsupp.single (Sum.inl x) 1)=reesWeight E c+1 := by
    rw [map_add]
    congr 1
    change Finsupp.weight (presentationWeight E) (Finsupp.single (Sum.inl x) 1)=1
    rw [Finsupp.weight_single]
    rfl
  constructor
  · exact (reesNormalForm_weight_le hE (c + Finsupp.single (Sum.inl x) 1)).trans_eq hw
  · intro hn
    exact (reesNormalForm_weight_lt hE hn).trans_eq hw

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.NormalMonoid -/
section
set_option autoImplicit false

/-!
# The actual Rees exponent monoid and its subadditive standard weight

The carrier is the range of the monomial presentation map in the genuine
exponent monoid of `S[t]`. Normal forms supply a weight on that range; they do not
replace it by a freely generated or artificially constrained object.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical

variable {R : Type*} [Fintype R] [LinearOrder R]
variable {E : Finset (R → ℕ)}

def reesExponentMonoid (E : Finset (R → ℕ)) : AddSubmonoid (Option (R × ℕ) →₀ ℕ) :=
  AddMonoidHom.mrange (reesExponentMap E)

def presentedExponent (E : Finset (R → ℕ)) (c : ReesVariable E →₀ ℕ) :
    reesExponentMonoid E := ⟨reesExponentMap E c,⟨c,rfl⟩⟩

@[simp] lemma presentedExponent_val (c : ReesVariable E →₀ ℕ) :
    (presentedExponent E c).val = reesExponentMap E c := rfl

@[simp] lemma presentedExponent_add (c d : ReesVariable E →₀ ℕ) :
    presentedExponent E (c + d) = presentedExponent E c + presentedExponent E d :=
  Subtype.ext (map_add _ _ _)

@[simp] lemma presentedExponent_zero : presentedExponent E 0 = 0 := Subtype.ext (map_zero _)

def canonicalExponent (hE : LatticeClosed E) (a : reesExponentMonoid E) : ReesVariable E →₀ ℕ :=
  reesNormalForm hE (Classical.choose a.property)

lemma canonicalExponent_standard (hE : LatticeClosed E) (a : reesExponentMonoid E) :
    ReesStandard (canonicalExponent hE a) := reesNormalForm_standard _ _

@[simp] lemma canonicalExponent_image (hE : LatticeClosed E) (a : reesExponentMonoid E) :
    reesExponentMap E (canonicalExponent hE a) = a.val :=
  (reesNormalForm_image _ _).trans (Classical.choose_spec a.property)

@[simp] lemma canonicalExponent_presented (hE : LatticeClosed E) (c : ReesVariable E →₀ ℕ) :
    canonicalExponent hE (presentedExponent E c) = reesNormalForm hE c := by
  apply reesStandard_image_injective hE (canonicalExponent_standard _ _) (reesNormalForm_standard _ _)
  simp

@[simp] lemma canonicalExponent_zero (hE : LatticeClosed E) : canonicalExponent hE 0 = 0 := by
  rw [← presentedExponent_zero,canonicalExponent_presented,reesNormalForm_zero]

lemma canonicalExponent_add (hE : LatticeClosed E) (a b : reesExponentMonoid E) :
    canonicalExponent hE (a + b) =
      reesNormalForm hE (canonicalExponent hE a + canonicalExponent hE b) := by
  apply reesStandard_image_injective hE (canonicalExponent_standard _ _) (reesNormalForm_standard _ _)
  simp

def standardWeight (hE : LatticeClosed E) (a : reesExponentMonoid E) : ℕ :=
  reesWeight E (canonicalExponent hE a)

@[simp] lemma standardWeight_zero (hE : LatticeClosed E) : standardWeight hE 0 = 0 := by
  simp [standardWeight]

/-- Subadditivity is proved from strictly decreasing exact reduction, not assumed. -/
theorem standardWeight_subadd (hE : LatticeClosed E) (a b : reesExponentMonoid E) :
    standardWeight hE (a + b) ≤ standardWeight hE a + standardWeight hE b := by
  unfold standardWeight
  rw [canonicalExponent_add]
  simpa only [map_add] using reesNormalForm_weight_le hE
    (canonicalExponent hE a + canonicalExponent hE b)

/-- The normal coordinates are in actual bijection with the presentation image. -/
def normalExponentEquiv (hE : LatticeClosed E) :
    {c : ReesVariable E →₀ ℕ // ReesStandard c} ≃ reesExponentMonoid E where
  toFun c := presentedExponent E c.val
  invFun a := ⟨canonicalExponent hE a,canonicalExponent_standard hE a⟩
  left_inv c := Subtype.ext (by
    change canonicalExponent hE (presentedExponent E c.val)=c.val
    rw [canonicalExponent_presented,reesNormalForm_of_standard hE c.property])
  right_inv a := Subtype.ext (canonicalExponent_image hE a)

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.WeightedMonoidAlgebra -/
section
set_option autoImplicit false

/-!
# A free polynomial-parameter algebra from a subadditive monoid weight

This is an actual subalgebra of the monoid algebra over `k[τ]`. Its basis element
at `a` is the ambient monomial `τ ^ w(a) [a]`. Subadditivity gives closure under
multiplication, with the explicitly computed nonnegative parameter exponent.
No quotient-flatness, Gröbner assertion, or torsion-freeness assumption is used.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical Polynomial

variable {k M : Type*} [CommRing k] [AddCommMonoid M]

def weightedMonomial (w : M → ℕ) (a : M) : AddMonoidAlgebra k[X] M :=
  AddMonoidAlgebra.single a (X ^ w a)

@[simp] lemma weightedMonomial_coefficient (w : M → ℕ) (a b : M) :
    (weightedMonomial (k := k) w a).coeff b = if a = b then X ^ w a else 0 := by
  simp [weightedMonomial,Finsupp.single_apply]

lemma weightedMonomial_linearIndependent (w : M → ℕ) :
    LinearIndependent k[X] (weightedMonomial (k := k) w) := by
  rw [linearIndependent_iff]
  intro l hl
  apply Finsupp.ext
  intro a
  change l a = 0
  by_cases ha : l a = 0
  · exact ha
  apply Polynomial.mul_X_pow_eq_zero (n := w a)
  have hc := congrArg (fun f : AddMonoidAlgebra k[X] M => f.coeff a) hl
  simpa [Finsupp.linearCombination_apply,Finsupp.sum,weightedMonomial,
    AddMonoidAlgebra.coeff_sum,AddMonoidAlgebra.coeff_smul,
    AddMonoidAlgebra.coeff_single,Finsupp.finset_sum_apply,Finsupp.smul_apply,
    Finsupp.single_apply,ha] using hc

lemma weightedMonomial_mul (w : M → ℕ)
    (hsub : ∀ a b, w (a + b) ≤ w a + w b) (a b : M) :
    weightedMonomial (k := k) w a * weightedMonomial w b =
      (X ^ (w a + w b - w (a + b)) : k[X]) • weightedMonomial w (a + b) := by
  unfold weightedMonomial
  rw [AddMonoidAlgebra.single_mul_single]
  rw [AddMonoidAlgebra.smul_single]
  congr 1
  simp only [smul_eq_mul,← pow_add,tsub_add_cancel_of_le (hsub a b)]

def weightedSpan (w : M → ℕ) : Submodule k[X] (AddMonoidAlgebra k[X] M) :=
  Submodule.span k[X] (Set.range (weightedMonomial w))

lemma weightedMonomial_mem (w : M → ℕ) (a : M) :
    weightedMonomial (k := k) w a ∈ weightedSpan w :=
  Submodule.subset_span ⟨a,rfl⟩

lemma weightedSpan_one (w : M → ℕ) (hzero : w 0 = 0) :
    (1 : AddMonoidAlgebra k[X] M) ∈ weightedSpan w := by
  have h := weightedMonomial_mem (k := k) w 0
  simpa only [weightedMonomial,hzero,pow_zero,← AddMonoidAlgebra.one_def] using h

lemma weightedSpan_mul (w : M → ℕ) (hsub : ∀ a b, w (a + b) ≤ w a + w b)
    {x y : AddMonoidAlgebra k[X] M} (hx : x ∈ weightedSpan w) (hy : y ∈ weightedSpan w) :
    x * y ∈ weightedSpan w := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨a,rfl⟩ := hx
      induction hy using Submodule.span_induction with
      | mem y hy =>
          obtain ⟨b,rfl⟩ := hy
          rw [weightedMonomial_mul w hsub]
          exact Submodule.smul_mem _ _ (weightedMonomial_mem w _)
      | zero => simpa using (Submodule.zero_mem (weightedSpan (k := k) w))
      | add y z hy hz ihy ihz =>
          simpa only [mul_add] using Submodule.add_mem (weightedSpan w) ihy ihz
      | smul c y hy ih =>
          simpa only [mul_smul_comm] using Submodule.smul_mem (weightedSpan w) c ih
  | zero => simpa using (Submodule.zero_mem (weightedSpan (k := k) w))
  | add x z hx hz ihx ihz =>
      simpa only [add_mul] using Submodule.add_mem (weightedSpan w) ihx ihz
  | smul c x hx ih =>
      simpa only [smul_mul_assoc] using Submodule.smul_mem (weightedSpan w) c ih

/-- The family is an actual subalgebra with a proved multiplication-closed carrier. -/
def weightedMonoidAlgebra (w : M → ℕ) (hzero : w 0 = 0)
    (hsub : ∀ a b, w (a + b) ≤ w a + w b) : Subalgebra k[X] (AddMonoidAlgebra k[X] M) :=
  (weightedSpan w).toSubalgebra (weightedSpan_one w hzero)
    (fun _ _ => weightedSpan_mul w hsub)

def weightedSpanEquiv (w : M → ℕ) (hzero : w 0 = 0)
    (hsub : ∀ a b, w (a + b) ≤ w a + w b) :
    weightedSpan (k := k) w ≃ₗ[k[X]] weightedMonoidAlgebra (k := k) w hzero hsub where
  toFun x := ⟨x.val,x.property⟩
  invFun x := ⟨x.val,x.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- A genuine `k[τ]`-basis, valid also when `k` has zero divisors. -/
def weightedMonoidBasis (w : M → ℕ) (hzero : w 0 = 0)
    (hsub : ∀ a b, w (a + b) ≤ w a + w b) :
    Module.Basis M k[X] (weightedMonoidAlgebra (k := k) w hzero hsub) :=
  (Module.Basis.span (weightedMonomial_linearIndependent (k := k) w)).map
    (weightedSpanEquiv w hzero hsub)

@[simp] lemma weightedMonoidBasis_val (w : M → ℕ) (hzero : w 0 = 0)
    (hsub : ∀ a b, w (a + b) ≤ w a + w b) (a : M) :
    (weightedMonoidBasis (k := k) w hzero hsub a).val = weightedMonomial w a := by
  change ((weightedSpanEquiv w hzero hsub)
    (Module.Basis.span (weightedMonomial_linearIndependent (k := k) w) a)).val = _
  change (Module.Basis.span (weightedMonomial_linearIndependent (k := k) w) a).val = _
  exact Module.Basis.coe_span_apply _ a

lemma weightedMonoidBasis_mul (w : M → ℕ) (hzero : w 0 = 0)
    (hsub : ∀ a b, w (a + b) ≤ w a + w b) (a b : M) :
    weightedMonoidBasis (k := k) w hzero hsub a * weightedMonoidBasis w hzero hsub b =
      (X ^ (w a + w b - w (a + b)) : k[X]) • weightedMonoidBasis w hzero hsub (a + b) := by
  apply Subtype.ext
  simpa only [Subalgebra.coe_mul,Subalgebra.coe_smul,weightedMonoidBasis_val]
    using weightedMonomial_mul (k := k) w hsub a b

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.FiniteMonoid -/
section
set_option autoImplicit false

/-!
# The finite Rees monoid and its actual polynomial-parameter algebra

The presentation uses exactly the finite row variables in the paper. Its embedding
into natural column indices is injective and commutes with the monomial map.
Consequently the canonical reduction weight restricts to this genuine finite Rees
monoid, without adjoining unused variables to the polynomial ring whose Tor is used.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical MvPolynomial
open scoped Polynomial

universe u v

variable {d : ℕ} {n : Fin d → ℕ}

abbrev FiniteReesVariable (E : Finset (FiniteTuple n)) := FiniteVariable.{u} n ⊕ E

def finiteReesVariableExponent (E : Finset (FiniteTuple n)) :
    FiniteReesVariable.{u} E → Option (FiniteVariable.{u} n) →₀ ℕ
  | Sum.inl x => Finsupp.single (some x) 1
  | Sum.inr a => (finiteRowExponent n a.val).embDomain Function.Embedding.some +
      Finsupp.single none 1

def finiteReesExponentMap (E : Finset (FiniteTuple n)) :
    (FiniteReesVariable.{u} E →₀ ℕ) →+ (Option (FiniteVariable.{u} n) →₀ ℕ) :=
  Finsupp.weight (finiteReesVariableExponent E)

def finiteReesVariableEmbedding (E : Finset (FiniteTuple n)) :
    FiniteReesVariable.{u} E ↪ ReesVariable (finiteTupleImage E) :=
  Function.Embedding.sumMap finiteVariableEmbedding (finiteTupleImageEquiv E).toEmbedding

def finiteReesTargetEmbedding :
    Option (FiniteVariable.{u} n) ↪ Option (Fin d × ℕ) :=
  Function.Embedding.optionMap finiteVariableEmbedding

lemma finiteReesVariableExponent_embedding (E : Finset (FiniteTuple n))
    (x : FiniteReesVariable.{u} E) :
    (finiteReesVariableExponent E x).embDomain finiteReesTargetEmbedding =
      reesVariableExponent (finiteTupleImage E) (finiteReesVariableEmbedding E x) := by
  cases x with
  | inl x => simp [finiteReesVariableExponent,finiteReesTargetEmbedding,
      finiteReesVariableEmbedding,reesVariableExponent,Finsupp.embDomain_single]
  | inr a =>
      simp only [finiteReesVariableExponent,Finsupp.embDomain_add,
        Finsupp.embDomain_single,reesVariableExponent,finiteReesVariableEmbedding,
        Function.Embedding.sumMap,Equiv.toEmbedding,Sum.map_inr,
        finiteTupleImageEquiv_val]
      congr 1
      change ((finiteRowExponent n a.val).embDomain Function.Embedding.some).embDomain
        finiteReesTargetEmbedding=(rowExponent (finiteTupleToNat a.val)).embDomain Function.Embedding.some
      rw [← Finsupp.embDomain_trans_apply]
      rw [← finiteRowExponent_embedding a.val,← Finsupp.embDomain_trans_apply]
      rfl

/-- The exponent maps commute on every presentation monomial. -/
theorem finiteReesExponentMap_embedding (E : Finset (FiniteTuple n))
    (c : FiniteReesVariable.{u} E →₀ ℕ) :
    (finiteReesExponentMap E c).embDomain finiteReesTargetEmbedding =
      reesExponentMap (finiteTupleImage E) (c.embDomain (finiteReesVariableEmbedding E)) := by
  refine c.induction ?_ ?_
  · simp [finiteReesExponentMap,reesExponentMap]
  · intro x m c _ _ ih
    simp only [map_add,Finsupp.embDomain_add,ih,Finsupp.embDomain_single,
      finiteReesExponentMap,reesExponentMap,Finsupp.weight_single]
    have hsmul : ∀ (e : Option (FiniteVariable.{u} n) →₀ ℕ),
        (m • e).embDomain finiteReesTargetEmbedding = m • e.embDomain finiteReesTargetEmbedding := by
      intro e
      simp only [Finsupp.embDomain_eq_mapDomain,Finsupp.mapDomain_smul]
    rw [hsmul,finiteReesVariableExponent_embedding]
    congr 1

def finiteReesExponentMonoid (E : Finset (FiniteTuple n)) :
    AddSubmonoid (Option (FiniteVariable.{u} n) →₀ ℕ) :=
  AddMonoidHom.mrange (finiteReesExponentMap E)

/-- This homomorphism embeds the actual finite presentation image into the
presentation image used by the canonical normal-form algorithm. -/
def finiteReesMonoidEmbedding (E : Finset (FiniteTuple n)) :
    finiteReesExponentMonoid.{u} E →+ reesExponentMonoid (finiteTupleImage E) where
  toFun a := ⟨a.val.embDomain finiteReesTargetEmbedding,by
    obtain ⟨c,hc⟩ := a.property
    refine ⟨c.embDomain (finiteReesVariableEmbedding E),?_⟩
    rw [← finiteReesExponentMap_embedding,hc]⟩
  map_zero' := Subtype.ext (by simp)
  map_add' a b := Subtype.ext (by simp [Finsupp.embDomain_add])

lemma finiteReesMonoidEmbedding_injective (E : Finset (FiniteTuple n)) :
    Function.Injective (finiteReesMonoidEmbedding.{u} E) := by
  intro a b h
  apply Subtype.ext
  apply Finsupp.embDomain_injective finiteReesTargetEmbedding
  exact congrArg Subtype.val h

def finiteStandardWeight {E : Finset (FiniteTuple n)} (hE : finiteLatticeClosed n E)
    (a : finiteReesExponentMonoid.{u} E) : ℕ :=
  standardWeight (finiteTupleImage_closed hE) (finiteReesMonoidEmbedding E a)

@[simp] lemma finiteStandardWeight_zero {E : Finset (FiniteTuple n)}
    (hE : finiteLatticeClosed n E) : finiteStandardWeight.{u} hE 0 = 0 := by
  simp [finiteStandardWeight]

lemma finiteStandardWeight_subadd {E : Finset (FiniteTuple n)}
    (hE : finiteLatticeClosed n E) (a b : finiteReesExponentMonoid.{u} E) :
    finiteStandardWeight hE (a + b) ≤ finiteStandardWeight hE a + finiteStandardWeight hE b := by
  unfold finiteStandardWeight
  rw [map_add]
  exact standardWeight_subadd _ _ _

/-- The finite-row integral deformation, an actual free `k[τ]`-subalgebra. -/
def finiteReesFamily (k : Type v) [CommRing k] {E : Finset (FiniteTuple n)}
    (hE : finiteLatticeClosed n E) :
    Subalgebra k[X] (AddMonoidAlgebra k[X] (finiteReesExponentMonoid.{u} E)) :=
  weightedMonoidAlgebra (finiteStandardWeight hE) (finiteStandardWeight_zero hE)
    (finiteStandardWeight_subadd hE)

def finiteReesFamilyBasis (k : Type v) [CommRing k] {E : Finset (FiniteTuple n)}
    (hE : finiteLatticeClosed n E) :
    Module.Basis (finiteReesExponentMonoid.{u} E) k[X] (finiteReesFamily k hE) :=
  weightedMonoidBasis (finiteStandardWeight hE) (finiteStandardWeight_zero hE)
    (finiteStandardWeight_subadd hE)

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.FiniteNormalForm -/
section
set_option autoImplicit false

/-!
# Canonical normal forms in exactly the finite polynomial presentation

The general reduction algorithm cannot introduce a row variable outside the finite
ring: that variable's exponent in the actual monomial image is zero. Restricting
normal forms therefore gives an exact standard-monomial parametrization of the
finite Rees image, with no polynomial-extension or Tor-invariance assumption.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical Finset

universe u
variable {d : ℕ} {n : Fin d → ℕ} {E : Finset (FiniteTuple n)}

lemma coefficientPart_le_image {R : Type*} [Fintype R] [LinearOrder R]
    {E : Finset (R → ℕ)} (c : ReesVariable E →₀ ℕ) (x : R × ℕ) :
    coefficientPart c x ≤ reesExponentMap E c (some x) := by
  rw [reesExponentMap_some]
  exact Nat.le_add_right _ _

lemma finiteReesTargetEmbedding_some_range (x : Fin d × ℕ) :
    some x ∈ Set.range (finiteReesTargetEmbedding.{u} (n := n)) ↔
      x ∈ Set.range (finiteVariableEmbedding.{u} (n := n)) := by
  constructor
  · rintro ⟨y,hy⟩
    cases y with
    | none => cases hy
    | some y => exact ⟨y,Option.some.inj hy⟩
  · rintro ⟨y,rfl⟩
    exact ⟨some y,rfl⟩

/-- The canonical full normal form is supported on the exact finite presentation variables. -/
lemma reesNormalForm_finite_support (hE : finiteLatticeClosed n E)
    (c : FiniteReesVariable.{u} E →₀ ℕ) :
    ↑(reesNormalForm (finiteTupleImage_closed hE)
      (c.embDomain (finiteReesVariableEmbedding E))).support ⊆
        Set.range (finiteReesVariableEmbedding.{u} E) := by
  let c' := reesNormalForm (finiteTupleImage_closed hE)
    (c.embDomain (finiteReesVariableEmbedding E))
  intro x hx
  cases x with
  | inr a =>
      obtain ⟨b,rfl⟩ := (finiteTupleImageEquiv E).surjective a
      exact ⟨Sum.inr b,rfl⟩
  | inl x =>
      by_cases hxrange : x ∈ Set.range (finiteVariableEmbedding.{u} (n := n))
      · obtain ⟨y,rfl⟩ := hxrange
        exact ⟨Sum.inl y,rfl⟩
      · have himzero : reesExponentMap (finiteTupleImage E) c' (some x) = 0 := by
          dsimp only [c']
          rw [reesNormalForm_image,← finiteReesExponentMap_embedding]
          exact Finsupp.embDomain_of_notMem_range _ _ _
            (fun h => hxrange ((finiteReesTargetEmbedding_some_range x).mp h))
        have hc0 : coefficientPart c' x = 0 :=
          Nat.eq_zero_of_le_zero (himzero ▸ coefficientPart_le_image c' x)
        exact False.elim ((Finsupp.mem_support_iff.mp hx) hc0)

def finiteReesNormalForm (hE : finiteLatticeClosed n E)
    (c : FiniteReesVariable.{u} E →₀ ℕ) : FiniteReesVariable.{u} E →₀ ℕ :=
  (reesNormalForm (finiteTupleImage_closed hE)
    (c.embDomain (finiteReesVariableEmbedding E))).comapDomain
      (finiteReesVariableEmbedding E) (finiteReesVariableEmbedding E).injective.injOn

@[simp] lemma finiteReesNormalForm_embedding (hE : finiteLatticeClosed n E)
    (c : FiniteReesVariable.{u} E →₀ ℕ) :
    (finiteReesNormalForm hE c).embDomain (finiteReesVariableEmbedding E) =
      reesNormalForm (finiteTupleImage_closed hE)
        (c.embDomain (finiteReesVariableEmbedding E)) :=
  Finsupp.embDomain_comapDomain (reesNormalForm_finite_support hE c)

/-- Standardness is transported along an injective embedding of the exact variables. -/
def FiniteReesStandard (c : FiniteReesVariable.{u} E →₀ ℕ) : Prop :=
  ReesStandard (c.embDomain (finiteReesVariableEmbedding E))

lemma finiteReesNormalForm_standard (hE : finiteLatticeClosed n E)
    (c : FiniteReesVariable.{u} E →₀ ℕ) : FiniteReesStandard (finiteReesNormalForm hE c) := by
  unfold FiniteReesStandard
  rw [finiteReesNormalForm_embedding]
  exact reesNormalForm_standard _ _

@[simp] lemma finiteReesNormalForm_image (hE : finiteLatticeClosed n E)
    (c : FiniteReesVariable.{u} E →₀ ℕ) :
    finiteReesExponentMap E (finiteReesNormalForm hE c) = finiteReesExponentMap E c := by
  apply Finsupp.embDomain_injective finiteReesTargetEmbedding
  rw [finiteReesExponentMap_embedding,finiteReesNormalForm_embedding,reesNormalForm_image,
    finiteReesExponentMap_embedding]

lemma finiteReesStandard_image_injective (hE : finiteLatticeClosed n E)
    {c e : FiniteReesVariable.{u} E →₀ ℕ} (hc : FiniteReesStandard c)
    (he : FiniteReesStandard e) (him : finiteReesExponentMap E c = finiteReesExponentMap E e) :
    c = e := by
  apply Finsupp.embDomain_injective (finiteReesVariableEmbedding E)
  apply reesStandard_image_injective (finiteTupleImage_closed hE) hc he
  rw [← finiteReesExponentMap_embedding,← finiteReesExponentMap_embedding,him]

@[simp] lemma finiteReesNormalForm_of_standard (hE : finiteLatticeClosed n E)
    {c : FiniteReesVariable.{u} E →₀ ℕ} (hc : FiniteReesStandard c) :
    finiteReesNormalForm hE c = c :=
  finiteReesStandard_image_injective hE (finiteReesNormalForm_standard hE c) hc
    (finiteReesNormalForm_image hE c)

def finiteCanonicalExponent (hE : finiteLatticeClosed n E)
    (a : finiteReesExponentMonoid.{u} E) : FiniteReesVariable.{u} E →₀ ℕ :=
  finiteReesNormalForm hE (Classical.choose a.property)

lemma finiteCanonicalExponent_standard (hE : finiteLatticeClosed n E)
    (a : finiteReesExponentMonoid.{u} E) : FiniteReesStandard (finiteCanonicalExponent hE a) :=
  finiteReesNormalForm_standard _ _

@[simp] lemma finiteCanonicalExponent_image (hE : finiteLatticeClosed n E)
    (a : finiteReesExponentMonoid.{u} E) :
    finiteReesExponentMap E (finiteCanonicalExponent hE a) = a.val :=
  (finiteReesNormalForm_image _ _).trans (Classical.choose_spec a.property)

/-- The finite standard monomials are in genuine bijection with monomials of the
actual finite Rees image. -/
def finiteNormalExponentEquiv (hE : finiteLatticeClosed n E) :
    {c : FiniteReesVariable.{u} E →₀ ℕ // FiniteReesStandard c} ≃ finiteReesExponentMonoid.{u} E where
  toFun c := ⟨finiteReesExponentMap E c.val,⟨c.val,rfl⟩⟩
  invFun a := ⟨finiteCanonicalExponent hE a,finiteCanonicalExponent_standard hE a⟩
  left_inv c := Subtype.ext (finiteReesStandard_image_injective hE
    (finiteCanonicalExponent_standard hE _) c.property (finiteCanonicalExponent_image hE _))
  right_inv a := Subtype.ext (finiteCanonicalExponent_image hE a)

lemma finiteCanonicalExponent_embedding (hE : finiteLatticeClosed n E)
    (a : finiteReesExponentMonoid.{u} E) :
    (finiteCanonicalExponent hE a).embDomain (finiteReesVariableEmbedding E) =
      canonicalExponent (finiteTupleImage_closed hE) (finiteReesMonoidEmbedding E a) := by
  apply reesStandard_image_injective (finiteTupleImage_closed hE)
    (finiteCanonicalExponent_standard hE a) (canonicalExponent_standard _ _)
  rw [← finiteReesExponentMap_embedding,finiteCanonicalExponent_image,canonicalExponent_image]
  rfl

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.PowerGenerators -/
section
set_option autoImplicit false

/-!
# Exact monomial generators of all ordinary powers

The recursively computed exponent family is proved to consist precisely of sums
of arbitrary lists of generators. Thus subsequent Rees-degree constructions refer
to the genuine ordinary ideal powers, for every natural exponent.
-/

noncomputable section

namespace FourPapers.Sublattice

open Classical Finset CommAlg.Polymatroid

variable {V A : Type*} [DecidableEq V]

def generatorListExponent (g : A → V →₀ ℕ) (w : List A) : V →₀ ℕ := (w.map g).sum

@[simp] lemma generatorListExponent_nil (g : A → V →₀ ℕ) :
    generatorListExponent g [] = 0 := rfl

@[simp] lemma generatorListExponent_cons (g : A → V →₀ ℕ) (a : A) (w : List A) :
    generatorListExponent g (a :: w) = g a + generatorListExponent g w := rfl

lemma generatorListExponent_append (g : A → V →₀ ℕ) (w z : List A) :
    generatorListExponent g (w ++ z) = generatorListExponent g w + generatorListExponent g z := by
  simp [generatorListExponent,List.map_append,List.sum_append]

lemma exponentPowerFamily_list {B : Finset (V →₀ ℕ)} (m : ℕ) (a : V →₀ ℕ) :
    a ∈ exponentPowerFamily B m ↔
      ∃ w : List (V →₀ ℕ), (∀ b ∈ w, b ∈ B) ∧ w.length = m ∧ w.sum = a := by
  induction m generalizing a with
  | zero =>
      constructor
      · intro ha
        have ha0 : a = 0 := by simpa [exponentPowerFamily] using ha
        exact ⟨[],by simp,by simp,by simpa using ha0.symm⟩
      · rintro ⟨w,_,hw,hs⟩
        have he : w = [] := List.length_eq_zero_iff.mp hw
        subst w
        simpa [exponentPowerFamily] using hs.symm
  | succ m ih =>
      constructor
      · intro ha
        obtain ⟨⟨b,c⟩,hbc,h⟩ := mem_image.mp ha
        obtain ⟨hb,hc⟩ := mem_product.mp hbc
        obtain ⟨w,hw,hlen,hsum⟩ := (ih b).mp hb
        refine ⟨c :: w,?_,by simp [hlen],?_⟩
        · intro z hz
          rcases List.mem_cons.mp hz with rfl | hz
          · exact hc
          · exact hw z hz
        · simpa [hsum,add_comm] using h
      · rintro ⟨w,hw,hlen,hsum⟩
        cases w with
        | nil => simp at hlen
        | cons c w =>
            have hc : c ∈ B := hw c (by simp)
            have hwm : w.length = m := by simpa using hlen
            have hws : w.sum ∈ exponentPowerFamily B m :=
              (ih _).mpr ⟨w,fun b hb => hw b (by simp [hb]),hwm,rfl⟩
            exact mem_image.mpr ⟨(w.sum,c),mem_product.mpr ⟨hws,hc⟩,by
              simpa [add_comm] using hsum⟩

/-- Lists may be indexed by the actual generator labels, even when the labeling
has repeated images. No independence or injectivity of labels is assumed. -/
lemma exponentPowerFamily_image_list [DecidableEq A] (E : Finset A) (g : A → V →₀ ℕ)
    (m : ℕ) (a : V →₀ ℕ) :
    a ∈ exponentPowerFamily (E.image g) m ↔
      ∃ w : List E, w.length = m ∧ generatorListExponent (fun b : E => g b.val) w = a := by
  constructor
  · intro ha
    obtain ⟨w,hw,hlen,hsum⟩ := (exponentPowerFamily_list m a).mp ha
    have hex : ∀ b : {b : V →₀ ℕ // b ∈ w}, ∃ e : E, g e.val = b.val := by
      intro b
      obtain ⟨e,he,hg⟩ := mem_image.mp (hw b.val b.property)
      exact ⟨⟨e,he⟩,hg⟩
    let chooseLabel : {b : V →₀ ℕ // b ∈ w} → E := fun b => Classical.choose (hex b)
    refine ⟨w.attach.map chooseLabel,by simpa using hlen,?_⟩
    unfold generatorListExponent
    rw [List.map_map]
    have he : (w.attach.map fun b => g (chooseLabel b).val) = w := by
      calc
        (w.attach.map fun b => g (chooseLabel b).val) = w.attach.map Subtype.val := by
          apply List.map_congr_left
          intro b _
          exact Classical.choose_spec (hex b)
        _ = w := by simpa only [List.map_id,id_eq] using (List.attach_map_val (l := w) (f := id))
    change (w.attach.map (fun b => g (chooseLabel b).val)).sum=a
    rw [he]
    exact hsum
  · rintro ⟨w,hlen,hsum⟩
    apply (exponentPowerFamily_list m a).mpr
    refine ⟨w.map (fun b : E => g b.val),?_,by simpa using hlen,hsum⟩
    intro b hb
    obtain ⟨e,_,rfl⟩ := List.mem_map.mp hb
    exact mem_image.mpr ⟨e.val,e.property,rfl⟩

lemma contains_exponentPowerFamily_image_iff [DecidableEq A] [Fintype V]
    (E : Finset A) (g : A → V →₀ ℕ) (m : ℕ) (a : V →₀ ℕ) :
    Contains (exponentPowerFamily (E.image g) m) a ↔
      ∃ w : List E, w.length = m ∧ generatorListExponent (fun b : E => g b.val) w ≤ a := by
  constructor
  · rintro ⟨b,hb,hba⟩
    obtain ⟨w,hlen,rfl⟩ := (exponentPowerFamily_image_list E g m b).mp hb
    exact ⟨w,hlen,hba⟩
  · rintro ⟨w,hlen,hwa⟩
    exact ⟨_,(exponentPowerFamily_image_list E g m _).mpr ⟨w,hlen,rfl⟩,hwa⟩

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.FinitePowerCoordinates -/
section
set_option autoImplicit false

/-!
# Rees monomials are exactly the monomials of the ordinary powers

This file connects the actual finite presentation image to the ideal powers used
in derived Tor. Both the fine exponent and the power are recovered from the
actual target exponent vector, rather than assigned by a surrogate grading.
-/

noncomputable section
namespace FourPapers.Sublattice

open Classical CommAlg.Polymatroid

universe u
variable {d : ℕ} {n : Fin d → ℕ} {E : Finset (FiniteTuple n)}

def finiteCoefficientPart (c : FiniteReesVariable.{u} E →₀ ℕ) : Exponent (FiniteVariable.{u} n) :=
  c.comapDomain Sum.inl Sum.inl_injective.injOn

def finiteFactorPart (c : FiniteReesVariable.{u} E →₀ ℕ) : E →₀ ℕ :=
  c.comapDomain Sum.inr Sum.inr_injective.injOn

def finiteFactorList (c : FiniteReesVariable.{u} E →₀ ℕ) : List E :=
  (finiteFactorPart c).toMultiset.toList

def finiteTargetExponent (a : Exponent (FiniteVariable.{u} n)) (m : ℕ) :
    Option (FiniteVariable.{u} n) →₀ ℕ :=
  a.embDomain Function.Embedding.some + Finsupp.single none m

@[simp] lemma finiteTargetExponent_none (a : Exponent (FiniteVariable.{u} n)) (m : ℕ) :
    finiteTargetExponent a m none = m := by
  simp [finiteTargetExponent,rowEmbedding_none,Finsupp.embDomain_of_notMem_range]

@[simp] lemma finiteTargetExponent_some (a : Exponent (FiniteVariable.{u} n)) (m : ℕ)
    (x : FiniteVariable.{u} n) : finiteTargetExponent a m (some x) = a x := by
  simp [finiteTargetExponent,Finsupp.embDomain_apply_self]

lemma finiteTargetExponent_injective {a b : Exponent (FiniteVariable.{u} n)} {m r : ℕ}
    (h : finiteTargetExponent a m = finiteTargetExponent b r) : a = b ∧ m = r := by
  constructor
  · ext x
    simpa using congrArg (fun e => e (some x)) h
  · simpa using congrArg (fun e => e none) h

lemma finite_exponent_parts (c : FiniteReesVariable.{u} E →₀ ℕ) :
    (finiteCoefficientPart c).embDomain Function.Embedding.inl +
      (finiteFactorPart c).embDomain Function.Embedding.inr = c := by
  ext x
  cases x <;> simp [finiteCoefficientPart,finiteFactorPart,
    Finsupp.embDomain_inl,Finsupp.embDomain_inr,Finsupp.sumElim_apply]

lemma finiteReesExponentMap_row (v : Exponent (FiniteVariable.{u} n)) :
    finiteReesExponentMap E (v.embDomain Function.Embedding.inl) =
      v.embDomain Function.Embedding.some := by
  refine v.induction ?_ ?_
  · simp
  · intro x r v _ _ ih
    simp only [Finsupp.embDomain_add,Finsupp.embDomain_single,map_add]
    rw [ih]
    change Finsupp.weight (finiteReesVariableExponent E) (Finsupp.single (Sum.inl x) r)+
      v.embDomain Function.Embedding.some=_
    rw [Finsupp.weight_single]
    change r • Finsupp.single (some x) 1 + v.embDomain Function.Embedding.some =
      Finsupp.single (some x) r + v.embDomain Function.Embedding.some
    simp only [Finsupp.smul_single,smul_eq_mul,mul_one]

lemma finiteReesExponentMap_factor (t : E →₀ ℕ) :
    finiteReesExponentMap E (t.embDomain Function.Embedding.inr) =
      Finsupp.weight (fun a : E => finiteReesVariableExponent E (Sum.inr a)) t := by
  change Finsupp.linearCombination ℕ (finiteReesVariableExponent E)
    (t.embDomain Function.Embedding.inr) = _
  rw [Finsupp.linearCombination_embDomain]
  rfl

lemma finiteFactorList_image (c : FiniteReesVariable.{u} E →₀ ℕ) :
    Finsupp.weight (fun a : E => finiteReesVariableExponent E (Sum.inr a)) (finiteFactorPart c) =
      ((finiteFactorList c).map fun a => finiteReesVariableExponent E (Sum.inr a)).sum := by
  rw [weight_eq_sum_toMultiset]
  rw [← Multiset.sum_coe,← Multiset.map_coe]
  simp only [finiteFactorList,Multiset.coe_toList]

lemma finiteGeneratorList_image (w : List E) :
    (w.map fun a => finiteReesVariableExponent.{u} E (Sum.inr a)).sum =
      finiteTargetExponent (generatorListExponent (fun a : E => finiteRowExponent n a.val) w) w.length := by
  induction w with
  | nil => simp [finiteTargetExponent,generatorListExponent]
  | cons a w ih =>
      rw [List.map_cons,List.sum_cons,ih]
      simp only [finiteReesVariableExponent,
        generatorListExponent_cons,List.length_cons,finiteTargetExponent,
        Finsupp.embDomain_add,Finsupp.single_add]
      abel

/-- Fine degree and Rees degree of every presentation monomial. -/
theorem finiteReesExponentMap_coordinates (c : FiniteReesVariable.{u} E →₀ ℕ) :
    finiteReesExponentMap E c = finiteTargetExponent
      (finiteCoefficientPart c + generatorListExponent (fun a : E => finiteRowExponent n a.val)
        (finiteFactorList c)) (finiteFactorList c).length := by
  conv_lhs => rw [← finite_exponent_parts c]
  rw [map_add,finiteReesExponentMap_row,finiteReesExponentMap_factor,
    finiteFactorList_image,finiteGeneratorList_image]
  simp only [finiteTargetExponent,Finsupp.embDomain_add]
  abel

def finiteListPresentation (v : Exponent (FiniteVariable.{u} n)) (w : List E) :
    FiniteReesVariable.{u} E →₀ ℕ :=
  v.embDomain Function.Embedding.inl + (w.map fun a => Finsupp.single (Sum.inr a) 1).sum

lemma finiteListPresentation_image (v : Exponent (FiniteVariable.{u} n)) (w : List E) :
    finiteReesExponentMap E (finiteListPresentation v w) =
      finiteTargetExponent (v + generatorListExponent (fun a : E => finiteRowExponent n a.val) w)
        w.length := by
  unfold finiteListPresentation
  rw [map_add,finiteReesExponentMap_row,map_list_sum]
  simp only [List.map_map,Function.comp_def,finiteReesExponentMap,Finsupp.weight_single,one_nsmul,one_smul]
  rw [finiteGeneratorList_image]
  simp only [finiteTargetExponent,Finsupp.embDomain_add]
  abel

/-- Membership in the actual finite Rees image at degree `m` is exactly divisibility
by the actual generators of the ordinary power `I_E ^ m`. -/
theorem finiteTarget_mem_rees_iff (a : Exponent (FiniteVariable.{u} n)) (m : ℕ) :
    finiteTargetExponent a m ∈ finiteReesExponentMonoid E ↔
      Contains (exponentPowerFamily (finiteRowFamily n E) m) a := by
  constructor
  · rintro ⟨c,hc⟩
    rw [finiteReesExponentMap_coordinates] at hc
    obtain ⟨ha,hm⟩ := finiteTargetExponent_injective hc
    apply (contains_exponentPowerFamily_image_iff E (finiteRowExponent n) m a).mpr
    refine ⟨finiteFactorList c,hm,?_⟩
    rw [← ha]
    exact le_add_of_nonneg_left zero_le
  · intro ha
    obtain ⟨w,hlen,hwa⟩ :=
      (contains_exponentPowerFamily_image_iff E (finiteRowExponent n) m a).mp ha
    refine ⟨finiteListPresentation (a - generatorListExponent
      (fun b : E => finiteRowExponent n b.val) w) w,?_⟩
    rw [finiteListPresentation_image,tsub_add_cancel_of_le hwa,hlen]

end FourPapers.Sublattice
end

end

/- BEGIN EXACT BODY: FourPapers.Sublattice.FiniteColons -/
section
set_option autoImplicit false

/-! # The genuine finite predecessor colons from coordinatewise ratios -/

noncomputable section
namespace FourPapers.Sublattice

open Classical Finset CommAlg.Polymatroid
universe u
variable {d : ℕ} {n : Fin d → ℕ}

lemma finiteMeet_ratio_le (b a : FiniteTuple n) :
    finiteRowExponent n (b ⊓ a) - finiteRowExponent n a ≤
      finiteRowExponent n b - finiteRowExponent n a := by
  rintro ⟨r,⟨j⟩⟩
  simp only [Finsupp.tsub_apply,finiteRowExponent_apply,Pi.inf_apply]
  by_cases hba : b r ≤ a r
  · simp only [inf_eq_left.mpr hba]
    exact le_rfl
  · simp only [inf_eq_right.mpr (le_of_not_ge hba),tsub_self,Nat.zero_le]

def finiteCoordinatePredecessorFamily (E : Finset (FiniteTuple n)) (a : FiniteTuple n) :
    Family (FiniteVariable.{u} n) :=
  (E.filter fun b => b ≤ a ∧ b ≠ a).image
    (fun b => finiteRowExponent n b - finiteRowExponent n a)

/-- Equality of divisibility predicates, before any coefficient ring is chosen. -/
theorem finiteCoordinatePredecessor_contains_iff {E : Finset (FiniteTuple n)}
    (hE : finiteLatticeClosed n E) {a : FiniteTuple n} (ha : a ∈ E)
    (v : Exponent (FiniteVariable.{u} n)) :
    Contains (finiteCoordinatePredecessorFamily E a) v ↔
      Contains (finitePredecessorFamily n E a) v := by
  constructor
  · rintro ⟨c,hc,hcv⟩
    obtain ⟨b,hb,rfl⟩ := mem_image.mp hc
    obtain ⟨hbE,hba,hne⟩ := mem_filter.mp hb
    refine ⟨finiteRowExponent n b - finiteRowExponent n a,?_,hcv⟩
    exact mem_image.mpr ⟨b,mem_filter.mpr ⟨hbE,finiteLexBefore_of_le_ne hba hne⟩,rfl⟩
  · rintro ⟨c,hc,hcv⟩
    obtain ⟨b,hb,rfl⟩ := mem_image.mp hc
    obtain ⟨hbE,hlex⟩ := mem_filter.mp hb
    refine ⟨finiteRowExponent n (b ⊓ a) - finiteRowExponent n a,?_,
      (finiteMeet_ratio_le b a).trans hcv⟩
    exact mem_image.mpr ⟨b ⊓ a,mem_filter.mpr
      ⟨hE.1 b hbE a ha,inf_le_right,finiteMeet_ne_of_lexBefore hlex⟩,rfl⟩

theorem finiteCoordinatePredecessor_ideal {k : Type*} [CommSemiring k]
    {E : Finset (FiniteTuple n)} (hE : finiteLatticeClosed n E)
    {a : FiniteTuple n} (ha : a ∈ E) :
    monomialIdeal k (finiteCoordinatePredecessorFamily E a) =
      finitePredecessorColon n (k := k) E a := by
  rw [finitePredecessorColon_eq]
  ext f
  simp_rw [mem_monomialIdeal_iff,finiteCoordinatePredecessor_contains_iff hE ha]

end FourPapers.Sublattice
