/-! # Homology of an exhaustive filtered complex with actual cycle lifts

All quotients in this file are literal submodule quotients.  The comparison
identifies the associated graded of `ker g / range f` with the homology of
the associated graded differential.  Its hypothesis is the ability to lift
each leading cycle to an actual cycle with the same leading term.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.FilteredHomology
open Classical
variable {K : Type*} [CommRing K]

structure Filtration (M : Type*) [AddCommGroup M] [Module K M] where
  level : ℕ → Submodule K M
  zero : level 0 = ⊥
  mono : Monotone level
  exhaustive : ∀ x : M, ∃ n, x ∈ level n

variable {X Y Z : Type*} [AddCommGroup X] [Module K X]
  [AddCommGroup Y] [Module K Y] [AddCommGroup Z] [Module K Z]

def Preserves (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) : Prop := ∀ n x, x ∈ F.level n → f x ∈ G.level n

def LiftsCycles (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) : Prop :=
  ∀ n x, x ∈ F.level (n + 1) → f x ∈ G.level n →
    ∃ z, z ∈ F.level (n + 1) ∧ f z = 0 ∧ x - z ∈ F.level n

/-- Leading cycle lifts make the differential strict, by finite downward
correction of an arbitrary preimage. -/
theorem strict_of_liftsCycles (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (lift : LiftsCycles F G f) (n : ℕ) (x : X)
    (hx : f x ∈ G.level n) : ∃ y, y ∈ F.level n ∧ f y = f x := by
  obtain ⟨m, hm⟩ := F.exhaustive x
  induction m generalizing x with
  | zero =>
      have hz : x = 0 := by simpa only [F.zero, Submodule.mem_bot] using hm
      exact ⟨0, (F.level n).zero_mem, by simp [hz]⟩
  | succ m ih =>
      by_cases hmn : m + 1 ≤ n
      · exact ⟨x, F.mono hmn hm, rfl⟩
      · have hnm : n ≤ m := Nat.le_of_lt_succ (Nat.lt_of_not_ge hmn)
        obtain ⟨z, hz, hfz, hxz⟩ := lift m x hm (G.mono hnm hx)
        have he : f (x - z) = f x := by rw [map_sub, hfz, sub_zero]
        obtain ⟨y, hy, hey⟩ := ih (x - z) (by rwa [he]) hxz
        exact ⟨y, hy, hey.trans he⟩

def lowerInLevel (F : Filtration (K := K) X) (n : ℕ) : Submodule K (F.level (n + 1)) :=
  (F.level n).comap (F.level (n + 1)).subtype

abbrev Grade (F : Filtration (K := K) X) (n : ℕ) :=
  F.level (n + 1) ⧸ lowerInLevel F n

def levelMap (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (n : ℕ) : F.level n →ₗ[K] G.level n :=
  (f.domRestrict _).codRestrict _ (fun x => hf n x.val x.property)

def gradeMap (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (n : ℕ) : Grade F n →ₗ[K] Grade G n :=
  Submodule.mapQ _ _ (levelMap F G f hf (n + 1)) (fun x hx => hf n x.val hx)

@[simp] theorem gradeMap_mk (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (n : ℕ) (x : F.level (n + 1)) :
    gradeMap F G f hf n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (levelMap F G f hf (n + 1) x) := rfl

theorem gradeMap_comp (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (H : Filtration (K := K) Z) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hf : Preserves F G f) (hg : Preserves G H g) (hfg : g.comp f = 0) (n : ℕ) :
    (gradeMap G H g hg n).comp (gradeMap F G f hf n) = 0 := by
  apply LinearMap.ext
  intro x
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  change Submodule.Quotient.mk
    (levelMap G H g hg (n + 1) (levelMap F G f hf (n + 1) x)) = 0
  have he : levelMap G H g hg (n + 1) (levelMap F G f hf (n + 1) x) = 0 :=
    Subtype.ext (LinearMap.congr_fun hfg x.val)
  rw [he]
  exact Submodule.Quotient.mk_zero _

def boundaryMap (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0) :
    X →ₗ[K] LinearMap.ker g :=
  f.codRestrict _ (fun x => LinearMap.congr_fun hfg x)

abbrev Homology (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0) :=
  LinearMap.ker g ⧸ LinearMap.range (boundaryMap f g hfg)

def homologyClass (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0) :
    LinearMap.ker g →ₗ[K] Homology f g hfg := (LinearMap.range (boundaryMap f g hfg)).mkQ

theorem homologyClass_eq_iff (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
    (z w : LinearMap.ker g) : homologyClass f g hfg z = homologyClass f g hfg w ↔
      ∃ x, f x = z.val - w.val := by
  rw [homologyClass, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨x, congrArg Subtype.val hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨x, Subtype.ext hx⟩

def cycleLevel (F : Filtration (K := K) Y) (g : Y →ₗ[K] Z) (n : ℕ) :
    Submodule K (LinearMap.ker g) := (F.level n).comap (LinearMap.ker g).subtype

def homologyLevel (F : Filtration (K := K) Y) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) (n : ℕ) : Submodule K (Homology f g hfg) :=
  (cycleLevel F g n).map (homologyClass f g hfg)

def homologyFiltration (F : Filtration (K := K) Y) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) : Filtration (K := K) (Homology f g hfg) where
  level := homologyLevel F f g hfg
  zero := by simp [homologyLevel, cycleLevel, F.zero]
  mono := fun _ _ h => Submodule.map_mono (Submodule.comap_mono (F.mono h))
  exhaustive x := by
    obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap f g hfg)).mkQ_surjective x
    obtain ⟨n, hn⟩ := F.exhaustive z.val
    exact ⟨n, z, hn, rfl⟩

section Comparison
variable (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
  (H : Filtration (K := K) Z) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
  (hf : Preserves F G f) (hg : Preserves G H g) (hfg : g.comp f = 0) (n : ℕ)

abbrev GradedHomology := Homology (gradeMap F G f hf n) (gradeMap G H g hg n)
  (gradeMap_comp F G H f g hf hg hfg n)

def cycleToLevel : cycleLevel G g (n + 1) →ₗ[K] G.level (n + 1) :=
  (((LinearMap.ker g).subtype).comp (cycleLevel G g (n + 1)).subtype).codRestrict _
    (fun z => z.property)

def cycleToGradeCycle : cycleLevel G g (n + 1) →ₗ[K] LinearMap.ker (gradeMap G H g hg n) :=
  (((lowerInLevel G n).mkQ).comp (cycleToLevel G g n)).codRestrict _ (by
    intro z
    change Submodule.Quotient.mk (levelMap G H g hg (n + 1) (cycleToLevel G g n z)) = 0
    have he : levelMap G H g hg (n + 1) (cycleToLevel G g n z) = 0 :=
      Subtype.ext z.val.property
    rw [he]
    exact Submodule.Quotient.mk_zero _)

def leadingHomologyClass : cycleLevel G g (n + 1) →ₗ[K] GradedHomology F G H f g hf hg hfg n :=
  (homologyClass _ _ (gradeMap_comp F G H f g hf hg hfg n)).comp (cycleToGradeCycle G H g hg n)

def filteredHomologyClass : cycleLevel G g (n + 1) →ₗ[K]
    Grade (homologyFiltration G f g hfg) n :=
  (lowerInLevel (homologyFiltration G f g hfg) n).mkQ.comp
    (((homologyClass f g hfg).comp (cycleLevel G g (n + 1)).subtype).codRestrict _
      (fun z => ⟨z.val, z.property, rfl⟩))

theorem leadingHomologyClass_surjective (lift : LiftsCycles G H g) :
    Function.Surjective (leadingHomologyClass F G H f g hf hg hfg n) := by
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _
    (gradeMap_comp F G H f g hf hg hfg n))).mkQ_surjective x
  obtain ⟨y, hy⟩ := (lowerInLevel G n).mkQ_surjective z.val
  have hgy : g y.val ∈ H.level n := by
    have hh := z.property
    rw [← hy] at hh
    change (Submodule.Quotient.mk (levelMap G H g hg (n + 1) y) : Grade H n) = 0 at hh
    exact (Submodule.Quotient.mk_eq_zero (lowerInLevel H n)).mp hh
  obtain ⟨w, hw, hgw, hyw⟩ := lift n y.val y.property hgy
  refine ⟨⟨⟨w, hgw⟩, hw⟩, ?_⟩
  apply congrArg (homologyClass _ _ (gradeMap_comp F G H f g hf hg hfg n))
  apply Subtype.ext
  change Submodule.Quotient.mk (⟨w, hw⟩ : G.level (n + 1)) = z.val
  rw [← hy]
  apply (Submodule.Quotient.eq _).mpr
  change w - y.val ∈ G.level n
  simpa only [neg_sub] using (G.level n).neg_mem hyw

theorem filteredHomologyClass_surjective :
    Function.Surjective (filteredHomologyClass G f g hfg n) := by
  intro x
  obtain ⟨y, rfl⟩ := (lowerInLevel (homologyFiltration G f g hfg) n).mkQ_surjective x
  obtain ⟨z, hz, he⟩ := y.property
  refine ⟨⟨z, hz⟩, ?_⟩
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel (homologyFiltration G f g hfg) n))
  exact Subtype.ext he

theorem leadingHomologyClass_eq_zero_iff (z : cycleLevel G g (n + 1)) :
    leadingHomologyClass F G H f g hf hg hfg n z = 0 ↔
      ∃ x, x ∈ F.level (n + 1) ∧ z.val.val - f x ∈ G.level n := by
  change Submodule.Quotient.mk (cycleToGradeCycle G H g hg n z) = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  constructor
  · rintro ⟨x, hx⟩
    obtain ⟨y, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
    refine ⟨y.val, y.property, ?_⟩
    have he := congrArg Subtype.val hx
    have hh := (Submodule.Quotient.eq _).mp he.symm
    exact hh
  · rintro ⟨x, hx, hz⟩
    refine ⟨Submodule.Quotient.mk (⟨x, hx⟩ : F.level (n + 1)), ?_⟩
    apply Subtype.ext
    apply Eq.symm
    exact (Submodule.Quotient.eq _).mpr hz

theorem filteredHomologyClass_eq_zero_iff (z : cycleLevel G g (n + 1)) :
    filteredHomologyClass G f g hfg n z = 0 ↔
      ∃ x, z.val.val - f x ∈ G.level n := by
  change Submodule.Quotient.mk _ = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  change (homologyClass f g hfg z.val) ∈ homologyLevel G f g hfg n ↔ _
  constructor
  · rintro ⟨w, hw, he⟩
    obtain ⟨x, hx⟩ := (homologyClass_eq_iff f g hfg z.val w).mp he.symm
    refine ⟨x, ?_⟩
    have he' : z.val.val - f x = w.val := by rw [hx]; abel
    rwa [he']
  · rintro ⟨x, hx⟩
    have hcycle : g (z.val.val - f x) = 0 := by
      have hgf : g (f x) = 0 := LinearMap.congr_fun hfg x
      rw [map_sub, z.val.property, hgf, sub_self]
    refine ⟨⟨z.val.val - f x, hcycle⟩, hx, ?_⟩
    apply (homologyClass_eq_iff f g hfg _ _).mpr
    refine ⟨-x, ?_⟩
    rw [map_neg]
    exact (sub_sub_cancel_left z.val.val (f x)).symm

theorem leading_filtered_kernel_eq (lift : LiftsCycles F G f) :
    LinearMap.ker (leadingHomologyClass F G H f g hf hg hfg n) =
      LinearMap.ker (filteredHomologyClass G f g hfg n) := by
  ext z
  rw [LinearMap.mem_ker, LinearMap.mem_ker,
    leadingHomologyClass_eq_zero_iff, filteredHomologyClass_eq_zero_iff]
  constructor
  · rintro ⟨x, hx, hz⟩
    exact ⟨x, hz⟩
  · rintro ⟨x, hx⟩
    have hfx : f x ∈ G.level (n + 1) := by
      have hh := (G.level (n + 1)).sub_mem z.property (G.mono (Nat.le_succ n) hx)
      change z.val.val - (z.val.val - f x) ∈ G.level (n + 1) at hh
      have he : z.val.val - (z.val.val - f x) = f x := by abel
      rwa [he] at hh
    obtain ⟨y, hy, he⟩ := strict_of_liftsCycles F G f lift (n + 1) x hfx
    exact ⟨y, hy, by simpa only [he] using hx⟩

/-- The canonical comparison, independent of any choice of cycle lifts. -/
def associatedHomologyEquiv (liftf : LiftsCycles F G f) (liftg : LiftsCycles G H g) :
    Grade (homologyFiltration G f g hfg) n ≃ₗ[K] GradedHomology F G H f g hf hg hfg n :=
  ((filteredHomologyClass G f g hfg n).quotKerEquivOfSurjective
    (filteredHomologyClass_surjective G f g hfg n)).symm |>.trans
    ((Submodule.quotEquivOfEq _ _ (leading_filtered_kernel_eq F G H f g hf hg hfg n liftf).symm).trans
      ((leadingHomologyClass F G H f g hf hg hfg n).quotKerEquivOfSurjective
        (leadingHomologyClass_surjective F G H f g hf hg hfg n liftg)))

@[simp] theorem associatedHomologyEquiv_class
    (liftf : LiftsCycles F G f) (liftg : LiftsCycles G H g)
    (z : cycleLevel G g (n + 1)) :
    associatedHomologyEquiv F G H f g hf hg hfg n liftf liftg
      (filteredHomologyClass G f g hfg n z) =
      leadingHomologyClass F G H f g hf hg hfg n z := by
  simp [associatedHomologyEquiv]

end Comparison

section Categorical
open CategoryTheory
universe u v
variable {R : Type u} [CommRing R]
  {M N L : Type v} [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] [AddCommGroup L] [Module R L]

def linearShortComplex (f : M →ₗ[R] N) (g : N →ₗ[R] L) (hfg : g.comp f = 0) :
    ShortComplex (ModuleCat.{v} R) :=
  ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g) (ModuleCat.hom_ext hfg)

/-- The quotient used above is precisely the standard categorical homology. -/
def categoricalHomologyIso (f : M →ₗ[R] N) (g : N →ₗ[R] L) (hfg : g.comp f = 0) :
    (linearShortComplex f g hfg).homology ≅ ModuleCat.of R (Homology f g hfg) :=
  (linearShortComplex f g hfg).moduleCatHomologyIso

end Categorical
end FourPapers.FilteredHomology

