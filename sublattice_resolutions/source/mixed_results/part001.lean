/- BEGIN EXACT BODY: FourPapers.Common.RegularFamilyKoszul -/
section

/-!
# Regularity of an indexed sequence and its literal tensor Koszul complex

The finite enumeration is explicit. Regularity is used only through the
proved ordinary Koszul exactness theorem, then transported through actual
chain isomorphisms and restriction of scalars.
-/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace FourPapers.RegularFamilyKoszul
open Classical CategoryTheory CategoryTheory.MonoidalCategory CommAlg CommAlg.Koszul
universe u
variable {R V : Type u} [CommRing R] [Fintype V] [LinearOrder V]

/-- The sequence in the canonical finite enumeration of its variables. -/
def familyList (f : V → R) : List R :=
  List.ofFn (fun i : Fin (Fintype.card V) => f ((Fintype.equivFin V).symm i))

def familyIndex (f : V → R) : Fin (familyList f).length ≃ V :=
  (finCongr (by simp [familyList])).trans (Fintype.equivFin V).symm

@[simp] theorem familyList_get (f : V → R) (i : Fin (familyList f).length) :
    (familyList f).get i = f (familyIndex f i) :=
  List.get_ofFn (fun j : Fin (Fintype.card V) => f ((Fintype.equivFin V).symm j)) i

def familyLinearEquiv (f : V → R) : (Fin (familyList f).length → R) ≃ₗ[R] (V → R) :=
  LinearEquiv.funCongrLeft R R (familyIndex f).symm

theorem familyLinearEquiv_single (f : V → R) (i : Fin (familyList f).length) :
    familyLinearEquiv f (Pi.single i (1 : R)) = Pi.single (familyIndex f i) 1 := by
  funext v
  change (Pi.single (M := fun _ => R) i 1) ((familyIndex f).symm v) =
    (Pi.single (M := fun _ => R) (familyIndex f i) 1) v
  by_cases h : familyIndex f i = v
  · subst v
    simp
  · have h' : (familyIndex f).symm v ≠ i := by
      intro he
      exact h (by rw [← he, Equiv.apply_symm_apply])
    simp [Pi.single_apply, h, h', Ne.symm h']

theorem familyLinearEquiv_comp (f : V → R) :
    (Fintype.linearCombination R f).comp (familyLinearEquiv f).toLinearMap =
      Fintype.linearCombination R (familyList f).get := by
  apply (Pi.basisFun R (Fin (familyList f).length)).ext
  intro i
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Pi.basisFun_apply]
  rw [familyLinearEquiv_single]
  simpa [Fintype.linearCombination_apply, Pi.single_apply, ite_mul] using
    (familyList_get f i).symm

def familyKoszulIso (f : V → R) :
    koszulComplex.ofList (familyList f) ≅ koszulComplex (Fintype.linearCombination R f) :=
  koszulComplex.isoOfEquiv _ (familyLinearEquiv f) _ (familyLinearEquiv_comp f)

/-- Tensoring with the coefficient ring itself is removed by its actual
right unitor, degree by degree and compatibly with the differential. -/
def coefficientSelfIso (f : V → R) :
    familyCoefficientComplex f (ModuleCat.of R R) ≅
      koszulComplex (Fintype.linearCombination R f) :=
  (NatIso.mapHomologicalComplex (rightUnitorNatIso (ModuleCat R))
      (ComplexShape.down ℕ)).app _ ≪≫
    (Functor.mapHomologicalComplexIdIso (ModuleCat R) (ComplexShape.down ℕ)).app _

theorem coefficientSelf_exact_positive (f : V → R)
    (hf : RingTheory.Sequence.IsRegular R (familyList f)) (p : ℕ) (hp : p ≠ 0) :
    (familyCoefficientComplex f (ModuleCat.of R R)).ExactAt p :=
  ((koszulComplex.exactAt_of_isRegular _ hf p hp).of_iso (familyKoszulIso f)).of_iso
    (coefficientSelfIso f).symm

variable {K : Type u} [CommRing K] [Algebra K R]

/-- The total exterior coordinates used in perturbation have the exactness
of the actual regular-sequence Koszul complex, over the coefficient ring K. -/
theorem tensor_exact_positive (f : V → R)
    (hf : RingTheory.Sequence.IsRegular R (familyList f)) (p : ℕ) (hp : p ≠ 0) :
    (TensorExteriorKoszul.complex (K := K) (M := R) f).ExactAt p := by
  have h := coefficientSelf_exact_positive f hf p hp
  have h' : (((ModuleCat.restrictScalars (algebraMap K R)).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj (familyCoefficientComplex f (ModuleCat.of R R))).ExactAt p := by
    change (((familyCoefficientComplex f (ModuleCat.of R R)).sc p).map
      (ModuleCat.restrictScalars (algebraMap K R))).Exact
    exact ModuleCat.restrictScalars_map_exact (algebraMap K R) _ h
  exact h'.of_iso (TensorExteriorKoszul.tensorKoszulIso (K := K) (M := R) f)

/-- An indexed regular sequence includes its actual ordering. This
avoids adding an unproved permutation-invariance hypothesis. -/
def IsRegularFamily (f : V → R) : Prop :=
  ∃ (l : List R) (e : Fin l.length ≃ V),
    (∀ i, l.get i = f (e i)) ∧ RingTheory.Sequence.IsRegular R l

def indexedLinearEquiv (l : List R) (e : Fin l.length ≃ V) :
    (Fin l.length → R) ≃ₗ[R] (V → R) := LinearEquiv.funCongrLeft R R e.symm

theorem indexedLinearEquiv_single (l : List R) (e : Fin l.length ≃ V) (i : Fin l.length) :
    indexedLinearEquiv l e (Pi.single i (1 : R)) = Pi.single (e i) 1 := by
  funext v
  change (Pi.single (M := fun _ => R) i 1) (e.symm v) =
    (Pi.single (M := fun _ => R) (e i) 1) v
  by_cases h : e i = v
  · subst v
    simp
  · have h' : e.symm v ≠ i := by
      intro he
      exact h (by rw [← he, Equiv.apply_symm_apply])
    simp [Pi.single_apply, h, h', Ne.symm h']

def indexedKoszulIso (f : V → R) (l : List R) (e : Fin l.length ≃ V)
    (he : ∀ i, l.get i = f (e i)) :
    koszulComplex.ofList l ≅ koszulComplex (Fintype.linearCombination R f) := by
  apply koszulComplex.isoOfEquiv _ (indexedLinearEquiv l e)
  apply (Pi.basisFun R (Fin l.length)).ext
  intro i
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Pi.basisFun_apply]
  rw [indexedLinearEquiv_single]
  simpa [Fintype.linearCombination_apply, Pi.single_apply, ite_mul] using (he i).symm

/-- Positive exactness for every ordering in the definition of a regular
sequence, transferred to the original variable indices. -/
theorem tensor_exact_positive_of_family (f : V → R) (hf : IsRegularFamily f)
    (p : ℕ) (hp : p ≠ 0) :
    (TensorExteriorKoszul.complex (K := K) (M := R) f).ExactAt p := by
  obtain ⟨l,e,he,hr⟩ := hf
  have h : (familyCoefficientComplex f (ModuleCat.of R R)).ExactAt p :=
    ((koszulComplex.exactAt_of_isRegular _ hr p hp).of_iso
      (indexedKoszulIso f l e he)).of_iso (coefficientSelfIso f).symm
  have h' : (((ModuleCat.restrictScalars (algebraMap K R)).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj (familyCoefficientComplex f (ModuleCat.of R R))).ExactAt p := by
    change (((familyCoefficientComplex f (ModuleCat.of R R)).sc p).map
      (ModuleCat.restrictScalars (algebraMap K R))).Exact
    exact ModuleCat.restrictScalars_map_exact (algebraMap K R) _ h
  exact h'.of_iso (TensorExteriorKoszul.tensorKoszulIso (K := K) (M := R) f)

end FourPapers.RegularFamilyKoszul

#print axioms FourPapers.RegularFamilyKoszul.tensor_exact_positive_of_family
#print axioms FourPapers.RegularFamilyKoszul.tensor_exact_positive

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.TensorHomologicalBasis -/
section

/-! # Exterior degree as the literal degree of a tensor-product basis -/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 700000
noncomputable section
namespace FourPapers.TensorHomologicalBasis
open Classical CommAlg CategoryTheory
open scoped TensorProduct
universe u
variable {K M V : Type u} [CommRing K] [AddCommGroup M] [Module K M]
  [Fintype V] [LinearOrder V] {I : Type*}

abbrev tensorBasis (b : Module.Basis I K M) :
    Module.Basis (I × Finset V) K (M ⊗[K] Simplicial.Ambient V K) :=
  b.tensorProduct Simplicial.basis

/-- The tensor complex's intrinsic exterior-coordinate piece is exactly
the span of tensor basis vectors with the specified exterior cardinality. -/
theorem piece_eq_basis_piece (b : Module.Basis I K M) (p : ℕ) :
    TensorExteriorKoszul.piece (K := K) (V := V) (M := M) p =
      Grading.Piece (tensorBasis (V := V) b) (fun a => a.2.card) p := by
  let L := Grading.Piece (tensorBasis (V := V) b) (fun a => a.2.card) p
  have htmul (F : Finset V) (hF : F.card = p) (m : M) :
      m ⊗ₜ[K] Simplicial.basis F ∈ L := by
    have hm : m ∈ Submodule.span K (Set.range b) := by
      rw [b.span_eq]
      exact Submodule.mem_top
    induction hm using Submodule.span_induction with
    | mem m hm =>
        obtain ⟨i,rfl⟩ := hm
        exact Submodule.subset_span ⟨(i,F),hF,by
          simp only [tensorBasis,Module.Basis.tensorProduct_apply]⟩
    | zero =>
        rw [TensorProduct.zero_tmul]
        exact Submodule.zero_mem _
    | add a b ha hb iha ihb =>
        rw [TensorProduct.add_tmul]
        exact Submodule.add_mem _ iha ihb
    | smul c a ha ih =>
        rw [← TensorProduct.smul_tmul']
        exact Submodule.smul_mem _ c ih
  apply le_antisymm
  · intro x hx
    let z := TensorExteriorKoszul.pieceCoordinates (K := K) (V := V) (M := M) p ⟨x,hx⟩
    have hz : TensorExteriorKoszul.lift (K := K) p z = x := by
      change ((TensorExteriorKoszul.pieceCoordinates (K := K) (V := V) (M := M) p).symm
        (TensorExteriorKoszul.pieceCoordinates (K := K) (V := V) (M := M) p ⟨x,hx⟩)).val = x
      rw [LinearEquiv.symm_apply_apply]
    rw [← hz]
    induction z using Finsupp.induction_linear with
    | zero =>
        rw [map_zero]
        exact Submodule.zero_mem _
    | add a b ha hb =>
        rw [map_add]
        exact Submodule.add_mem _ ha hb
    | single F m =>
        rw [TensorExteriorKoszul.lift_single]
        exact htmul F.val F.property m
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨i,F⟩,hF,rfl⟩
    have h := ((TensorExteriorKoszul.pieceCoordinates (K := K) (V := V) (M := M) p).symm
      (Finsupp.single ⟨F,hF⟩ (b i))).property
    change TensorExteriorKoszul.lift (K := K) p (Finsupp.single ⟨F,hF⟩ (b i)) ∈ _ at h
    rw [TensorExteriorKoszul.lift_single] at h
    change tensorBasis (V := V) b (i,F) ∈
      TensorExteriorKoszul.piece (K := K) (V := V) (M := M) p
    simpa only [tensorBasis, Module.Basis.tensorProduct_apply] using h

variable {R : Type u} [CommRing R] [Algebra K R]
  [Module R M] [IsScalarTower K R M]

/-- Exactness gives an actual boundary preimage in the next exterior
piece, with the equality stated in the total tensor module. -/
theorem boundary_of_exact (f : V → R) (p : ℕ)
    (hex : (TensorExteriorKoszul.complex (K := K) (M := M) f).ExactAt (p+1))
    (x : M ⊗[K] Simplicial.Ambient V K)
    (hx : x ∈ TensorExteriorKoszul.piece (K := K) (V := V) (M := M) (p+1))
    (hdx : TensorExteriorKoszul.differential (K := K) (M := M) f x = 0) :
    ∃ y, y ∈ TensorExteriorKoszul.piece (K := K) (V := V) (M := M) (p+2) ∧
      TensorExteriorKoszul.differential (K := K) (M := M) f y = x := by
  have h := ((TensorExteriorKoszul.complex (K := K) (M := M) f).exactAt_iff'
    (p+2) (p+1) p (by simp) (by simp)).mp hex
  rw [ShortComplex.moduleCat_exact_iff] at h
  have hz : (TensorExteriorKoszul.complex (K := K) (M := M) f).d (p+1) p ⟨x,hx⟩ = 0 := by
    simp only [TensorExteriorKoszul.complex, ChainComplex.of_d]
    change TensorExteriorKoszul.pieceDifferential (K := K) f p ⟨x,hx⟩ = 0
    apply Subtype.ext
    exact (TensorExteriorKoszul.pieceDifferential_val (K := K) f p ⟨x,hx⟩).trans hdx
  obtain ⟨y,hy⟩ := h ⟨x,hx⟩ hz
  refine ⟨y.val,y.property,?_⟩
  have hy' : TensorExteriorKoszul.pieceDifferential (K := K) f (p+1) y = ⟨x,hx⟩ := by
    change (TensorExteriorKoszul.complex (K := K) (M := M) f).d
      ((p+1)+1) (p+1) y = ⟨x,hx⟩ at hy
    simpa only [TensorExteriorKoszul.complex, ChainComplex.of_d, ModuleCat.ofHom,
      ConcreteCategory.hom_ofHom] using! hy
  exact (TensorExteriorKoszul.pieceDifferential_val (K := K) f (p+1) y).symm.trans
    (congrArg Subtype.val hy')

/-- The same exactness statement in the actual tensor basis grading. -/
theorem basis_boundary_of_exact (b : Module.Basis I K M) (f : V → R) (p : ℕ)
    (hex : (TensorExteriorKoszul.complex (K := K) (M := M) f).ExactAt (p+1))
    (x : M ⊗[K] Simplicial.Ambient V K)
    (hx : x ∈ Grading.Piece (tensorBasis (V := V) b) (fun a => a.2.card) (p+1))
    (hdx : TensorExteriorKoszul.differential (K := K) (M := M) f x = 0) :
    ∃ y, y ∈ Grading.Piece (tensorBasis (V := V) b) (fun a => a.2.card) (p+2) ∧
      TensorExteriorKoszul.differential (K := K) (M := M) f y = x := by
  rw [← piece_eq_basis_piece] at hx
  obtain ⟨y,hy,hd⟩ := boundary_of_exact f p hex x hx hdx
  exact ⟨y,by rwa [piece_eq_basis_piece] at hy,hd⟩

end FourPapers.TensorHomologicalBasis

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.BasisMultigradedContraction -/
section

/-!
# A contraction preserving arbitrary fine degrees

The fine-degree labels may belong to any type. The differential preserves
that label and lowers the natural homological degree. Splitting each literal
kernel/image quotient constructs a contraction preserving every fine degree
and raising homological degree. The basis and direct sums may be infinite.
Applying any natural height to the fine degree gives the nonincrease needed
for polynomial perturbation; no order on the fine-degree labels is assumed.
-/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 800000
noncomputable section

namespace FourPapers.BasisMultigradedContraction

open Classical CommAlg HomologicalPerturbation DirectSum

attribute [local instance] Classical.propDecidable

variable {R M I Γ : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  (b : Module.Basis I R M) (degree : I → Γ) (homological : I → ℕ)
  (D : Module.End R M) (hD : D.comp D = 0)

def piece (q : Γ) (p : ℕ) : Submodule R M :=
  Grading.Piece b (fun i => (degree i,homological i)) (q,p)

def pieceBasis (q : Γ) (p : ℕ) :
    Module.Basis {i : I // (degree i,homological i) = (q,p)} R
      (piece b degree homological q p) :=
  Grading.restrictedBasis b (fun i => (degree i,homological i) = (q,p))

@[simp] theorem pieceBasis_val (q : Γ) (p : ℕ)
    (i : {i : I // (degree i,homological i) = (q,p)}) :
    (pieceBasis b degree homological q p i).val = b i.val :=
  Grading.restrictedBasis_val b _ i

variable
  (hlower : ∀ q p x, x ∈ piece b degree homological q (p+1) →
    D x ∈ piece b degree homological q p)
  (hzero : ∀ q x, x ∈ piece b degree homological q 0 → D x = 0)

def differential (q : Γ) (p : ℕ) :
    piece b degree homological q (p+1) →ₗ[R] piece b degree homological q p :=
  (D.domRestrict (piece b degree homological q (p+1))).codRestrict
    (piece b degree homological q p) (fun x => hlower q p x.val x.property)

include hD in
theorem differential_square (q : Γ) (p : ℕ) :
    (differential b degree homological D hlower q p).comp
      (differential b degree homological D hlower q (p+1)) = 0 := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact LinearMap.congr_fun hD x.val

abbrev StrandHomology (q : Γ) (p : ℕ) :=
  ProjectiveComplexSplitting.Homology (fun p => ↥(piece b degree homological q p))
    (differential b degree homological D hlower q)
    (differential_square b degree homological D hD hlower q) p

theorem piece_projective (q : Γ) (p : ℕ) : Module.Projective R (piece b degree homological q p) := by
  letI := Module.Free.of_basis (pieceBasis b degree homological q p)
  infer_instance

variable (hH : ∀ q p, Module.Projective R (StrandHomology b degree homological D hD hlower q p))

abbrev GradedTotal := ⨁ q : Γ, ⨁ p : ℕ, ↥(piece b degree homological q p)
abbrev GradedHomology := ⨁ q : Γ, ⨁ p : ℕ, StrandHomology b degree homological D hD hlower q p

abbrev gradedHomologyAddCommGroup :
    AddCommGroup (GradedHomology b degree homological D hD hlower) :=
  DFinsupp.addCommGroup
    (β := fun q : Γ => ⨁ p : ℕ, StrandHomology b degree homological D hD hlower q p)

abbrev gradedHomologyModule :
    Module R (GradedHomology b degree homological D hD hlower) :=
  DFinsupp.module (γ := R)
    (β := fun q : Γ => ⨁ p : ℕ, StrandHomology b degree homological D hD hlower q p)

attribute [instance 100] gradedHomologyAddCommGroup gradedHomologyModule

def strandContraction (q : Γ) :
    LinearContraction (R := R) (M := ⨁ p, ↥(piece b degree homological q p))
      (H := ⨁ p, StrandHomology b degree homological D hD hlower q p) :=
  ProjectiveComplexSplitting.totalLinearContraction (fun p => ↥(piece b degree homological q p))
    (differential b degree homological D hlower q)
    (differential_square b degree homological D hD hlower q)
    (piece_projective b degree homological q) (hH q)

def gradedContraction :
    LinearContraction (R := R) (M := GradedTotal b degree homological)
      (H := GradedHomology b degree homological D hD hlower) :=
  LinearContraction.directSum (strandContraction b degree homological D hD hlower hH)

abbrev GradedIndex := Σ q : Γ, Σ p : ℕ,
  {i : I // (degree i,homological i) = (q,p)}

def indexEquiv : GradedIndex degree homological ≃ I where
  toFun a := a.2.2.val
  invFun i := ⟨degree i,homological i,⟨i,rfl⟩⟩
  left_inv a := by
    rcases a with ⟨q,p,⟨i,hi⟩⟩
    have hq := congrArg Prod.fst hi
    have hp := congrArg Prod.snd hi
    dsimp at hq hp
    subst q
    subst p
    rfl
  right_inv _ := rfl

def gradedBasis : Module.Basis (GradedIndex degree homological) R
    (GradedTotal b degree homological) :=
  DFinsupp.basis (fun q => DFinsupp.basis (pieceBasis b degree homological q))

def coordinates : GradedTotal b degree homological ≃ₗ[R] M :=
  (gradedBasis b degree homological).equiv b (indexEquiv degree homological)

@[simp] theorem gradedBasis_apply (q : Γ) (p : ℕ)
    (i : {i : I // (degree i,homological i) = (q,p)}) :
    gradedBasis b degree homological ⟨q,p,i⟩ =
      DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
        (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p
          (pieceBasis b degree homological q p i)) := by
  change DFinsupp.basis (fun q => DFinsupp.basis (pieceBasis b degree homological q))
    ⟨q, ⟨p, i⟩⟩ = _
  calc
    _ = DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
        (DFinsupp.basis (pieceBasis b degree homological q) ⟨p, i⟩) :=
      FourPapers.directSum_basis_apply
        (fun q => DFinsupp.basis (pieceBasis b degree homological q)) q ⟨p, i⟩
    _ = _ := congrArg (DirectSum.lof R Γ
      (fun q => ⨁ p, ↥(piece b degree homological q p)) q)
      (FourPapers.directSum_basis_apply (pieceBasis b degree homological q) p i)

theorem coordinates_lof (q : Γ) (p : ℕ) (x : piece b degree homological q p) :
    coordinates b degree homological
      (DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
        (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p x)) = x.val := by
  have he : (coordinates b degree homological).toLinearMap.comp
      ((DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q).comp
        (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p)) =
      (piece b degree homological q p).subtype := by
    apply (pieceBasis b degree homological q p).ext
    intro i
    rw [LinearMap.comp_apply, LinearMap.comp_apply, ← gradedBasis_apply]
    change (gradedBasis b degree homological).equiv b (indexEquiv degree homological)
      (gradedBasis b degree homological ⟨q, p, i⟩) =
      (pieceBasis b degree homological q p i).val
    exact (Module.Basis.equiv_apply (b := gradedBasis b degree homological)
      (b' := b) (e := indexEquiv degree homological) (i := ⟨q, p, i⟩)).trans
      (pieceBasis_val b degree homological q p i).symm
  exact LinearMap.congr_fun he x

def contraction : LinearContraction (R := R) (M := M)
    (H := GradedHomology b degree homological D hD hlower) :=
  (gradedContraction b degree homological D hD hlower hH).changeSource
    (coordinates b degree homological)

include hzero in
theorem coordinates_d (x : GradedTotal b degree homological) :
    coordinates b degree homological
      ((gradedContraction b degree homological D hD hlower hH).d x) =
      D (coordinates b degree homological x) := by
  have he : (coordinates b degree homological).toLinearMap.comp
      (gradedContraction b degree homological D hD hlower hH).d =
      D.comp (coordinates b degree homological).toLinearMap := by
    apply DirectSum.linearMap_ext
    intro q
    apply DirectSum.linearMap_ext
    intro p
    apply LinearMap.ext
    intro z
    change coordinates b degree homological
      ((gradedContraction b degree homological D hD hlower hH).d
        (DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
          (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p z))) =
      D (coordinates b degree homological
        (DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
          (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p z)))
    rw [gradedContraction, LinearContraction.directSum_d_lof, coordinates_lof]
    change coordinates b degree homological
      (DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
        (ProjectiveComplexSplitting.totalDifferential (fun p => ↥(piece b degree homological q p))
          (differential b degree homological D hlower q)
          (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p z))) = _
    cases p with
    | zero =>
        rw [ProjectiveComplexSplitting.totalDifferential_lof_zero, map_zero, map_zero,
          hzero q z.val z.property]
    | succ p =>
        rw [ProjectiveComplexSplitting.totalDifferential_lof_succ, coordinates_lof]
        rfl

  exact LinearMap.congr_fun he x

include hzero in
theorem contraction_d : (contraction b degree homological D hD hlower hH).d = D := by
  apply LinearMap.ext
  intro x
  change coordinates b degree homological
    ((gradedContraction b degree homological D hD hlower hH).d
      ((coordinates b degree homological).symm x)) = _
  rw [coordinates_d b degree homological D hD hlower hzero hH,
    LinearEquiv.apply_symm_apply]

theorem contraction_h_mem (q : Γ) (p : ℕ) (x : piece b degree homological q p) :
    (contraction b degree homological D hD hlower hH).h x.val ∈
      piece b degree homological q (p+1) := by
  rw [← coordinates_lof b degree homological q p x]
  change coordinates b degree homological
    ((gradedContraction b degree homological D hD hlower hH).h
      ((coordinates b degree homological).symm
        (coordinates b degree homological _))) ∈ _
  rw [LinearEquiv.symm_apply_apply, gradedContraction,
    LinearContraction.directSum_h_lof]
  change coordinates b degree homological
    (DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
      (ProjectiveComplexSplitting.totalHomotopy (fun p => ↥(piece b degree homological q p))
        (differential b degree homological D hlower q)
        (differential_square b degree homological D hD hlower q)
        (piece_projective b degree homological q) (hH q)
        (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p x))) ∈ _
  rw [ProjectiveComplexSplitting.totalHomotopy_lof, coordinates_lof]
  exact (ProjectiveComplexSplitting.homotopy (fun p => ↥(piece b degree homological q p))
    (differential b degree homological D hlower q)
    (differential_square b degree homological D hD hlower q)
    (piece_projective b degree homological q) (hH q) p x).property

theorem contraction_h_nonincreasing (height : Γ → ℕ) :
    DegreeNonincreasing b (fun i => height (degree i)) (contraction b degree homological D hD hlower hH).h := by
  intro i j hij
  have hi : b i ∈ piece b degree homological (degree i) (homological i) :=
    Grading.basis_mem_piece b _ i
  have hh := contraction_h_mem b degree homological D hD hlower hH
    (degree i) (homological i) ⟨b i,hi⟩
  by_contra hne
  have he := (Grading.mem_piece b (fun i => (degree i,homological i))
    (degree i,homological i+1) _).mp hh j hne
  have he' := congrArg Prod.fst he
  exact Nat.ne_of_lt hij (congrArg height he').symm

/-- Inclusion preserves both literal degrees before scalar extension. -/
theorem contraction_inclusion_lof (q : Γ) (p : ℕ)
    (x : StrandHomology b degree homological D hD hlower q p) :
    (contraction b degree homological D hD hlower hH).inclusion
      (DirectSum.lof R Γ (fun q => ⨁ p, StrandHomology b degree homological D hD hlower q p) q
        (DirectSum.lof R ℕ (StrandHomology b degree homological D hD hlower q) p x)) =
      (ProjectiveComplexSplitting.homologyInclusion (fun p => ↥(piece b degree homological q p))
        (differential b degree homological D hlower q)
        (differential_square b degree homological D hD hlower q) (hH q) p x).val := by
  change coordinates b degree homological
    ((gradedContraction b degree homological D hD hlower hH).inclusion _) = _
  rw [gradedContraction, LinearContraction.directSum_inclusion_lof]
  change coordinates b degree homological
    (DirectSum.lof R Γ (fun q => ⨁ p, ↥(piece b degree homological q p)) q
      (ProjectiveComplexSplitting.totalHomologyInclusion (fun p => ↥(piece b degree homological q p))
        (differential b degree homological D hlower q)
        (differential_square b degree homological D hD hlower q) (hH q)
        (DirectSum.lof R ℕ (StrandHomology b degree homological D hD hlower q) p x))) = _
  rw [ProjectiveComplexSplitting.totalHomologyInclusion_lof, coordinates_lof]

/-- Every homogeneous homology class is represented in its exact fine and
homological degrees. This is stronger than preservation of a weighted sum. -/
theorem contraction_inclusion_mem (q : Γ) (p : ℕ)
    (x : StrandHomology b degree homological D hD hlower q p) :
    (contraction b degree homological D hD hlower hH).inclusion
      (DirectSum.lof R Γ (fun q => ⨁ p, StrandHomology b degree homological D hD hlower q p) q
        (DirectSum.lof R ℕ (StrandHomology b degree homological D hD hlower q) p x)) ∈
      piece b degree homological q p := by
  rw [contraction_inclusion_lof]
  exact (ProjectiveComplexSplitting.homologyInclusion (fun p => ↥(piece b degree homological q p))
    (differential b degree homological D hlower q)
    (differential_square b degree homological D hD hlower q) (hH q) p x).property

/-- The projection of a homogeneous chain is supported in precisely the
same fine and homological summand of the actual homology direct sum. -/
theorem contraction_projection_piece (q : Γ) (p : ℕ)
    (x : piece b degree homological q p) :
    (contraction b degree homological D hD hlower hH).projection x.val =
      DirectSum.lof R Γ (fun q => ⨁ p, StrandHomology b degree homological D hD hlower q p) q
        (DirectSum.lof R ℕ (StrandHomology b degree homological D hD hlower q) p
          (ProjectiveComplexSplitting.homologyProjection (fun p => ↥(piece b degree homological q p))
            (differential b degree homological D hlower q)
            (differential_square b degree homological D hD hlower q)
            (piece_projective b degree homological q) (hH q) p x)) := by
  rw [← coordinates_lof b degree homological q p x]
  change (gradedContraction b degree homological D hD hlower hH).projection
    ((coordinates b degree homological).symm (coordinates b degree homological _)) = _
  rw [LinearEquiv.symm_apply_apply, gradedContraction,
    LinearContraction.directSum_projection_lof]
  change DirectSum.lof R Γ
    (fun q => ⨁ p, StrandHomology b degree homological D hD hlower q p) q
      (ProjectiveComplexSplitting.totalHomologyProjection (fun p => ↥(piece b degree homological q p))
        (differential b degree homological D hlower q)
        (differential_square b degree homological D hD hlower q)
        (piece_projective b degree homological q) (hH q)
        (DirectSum.lof R ℕ (fun p => ↥(piece b degree homological q p)) p x)) = _
  rw [ProjectiveComplexSplitting.totalHomologyProjection_lof]

/-- Exactness in positive homological degrees makes every chosen homology
representative lie in the original degree-zero submodule. -/
theorem contraction_inclusion_mem_zero
    (hpos : ∀ q p, Subsingleton (StrandHomology b degree homological D hD hlower q (p+1)))
    (x : GradedHomology b degree homological D hD hlower) :
    (contraction b degree homological D hD hlower hH).inclusion x ∈
      Grading.Piece b homological 0 := by
  induction x using DirectSum.induction_on with
  | zero =>
      rw [map_zero]
      exact Submodule.zero_mem _
  | add x y hx hy =>
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  | of q y =>
      induction y using DirectSum.induction_on with
      | zero =>
          simp only [map_zero]
          exact Submodule.zero_mem _
      | add x y hx hy =>
          simp only [map_add]
          exact Submodule.add_mem _ hx hy
      | of p y =>
          change (contraction b degree homological D hD hlower hH).inclusion
            (DirectSum.lof R Γ (fun q => ⨁ p, StrandHomology b degree homological D hD hlower q p) q
              (DirectSum.lof R ℕ (StrandHomology b degree homological D hD hlower q) p y)) ∈ _
          cases p with
          | zero =>
              rw [contraction_inclusion_lof]
              have hle : piece b degree homological q 0 ≤ Grading.Piece b homological 0 := by
                apply Submodule.span_le.mpr
                rintro _ ⟨i,hi,rfl⟩
                exact Submodule.subset_span ⟨i,congrArg Prod.snd hi,rfl⟩
              exact hle (ProjectiveComplexSplitting.homologyInclusion
                (fun p => ↥(piece b degree homological q p)) (differential b degree homological D hlower q)
                (differential_square b degree homological D hD hlower q) (hH q) 0 y).property
          | succ p =>
              have hy : y = 0 := @Subsingleton.elim _ (hpos q p) y 0
              rw [hy, map_zero, map_zero, map_zero]
              exact Submodule.zero_mem _

end FourPapers.BasisMultigradedContraction

#print axioms FourPapers.BasisMultigradedContraction.contraction_d
#print axioms FourPapers.BasisMultigradedContraction.contraction_h_mem
#print axioms FourPapers.BasisMultigradedContraction.contraction_h_nonincreasing
#print axioms FourPapers.BasisMultigradedContraction.contraction_inclusion_mem
#print axioms FourPapers.BasisMultigradedContraction.contraction_projection_piece

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.BasisBigradedContraction -/
section

/-!
# Natural-number specialization of the homogeneous contraction

All splitting and coordinate constructions are the same verified objects
as in `BasisMultigradedContraction`, specialized by the degree function to
natural-number labels. This compatibility namespace retains the original
API without duplicating the projective splitting proof. The sole wrapper
below specializes its numerical height to the identity function.
-/

section
set_option autoImplicit false
noncomputable section
namespace FourPapers.BasisBigradedContraction
open CommAlg HomologicalPerturbation

export BasisMultigradedContraction
  (piece pieceBasis pieceBasis_val differential differential_square
    StrandHomology piece_projective GradedTotal GradedHomology
    strandContraction gradedContraction GradedIndex indexEquiv gradedBasis
    coordinates gradedBasis_apply coordinates_lof contraction coordinates_d
    contraction_d contraction_h_mem contraction_inclusion_lof
    contraction_inclusion_mem contraction_projection_piece
    contraction_inclusion_mem_zero)

variable {R M I : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  (b : Module.Basis I R M) (degree homological : I → ℕ)
  (D : Module.End R M) (hD : D.comp D = 0)
  (hlower : ∀ q p x, x ∈ piece b degree homological q (p+1) →
    D x ∈ piece b degree homological q p)
  (hH : ∀ q p, Module.Projective R (StrandHomology b degree homological D hD hlower q p))

/-- The original numerical rank assertion, with no change to its degree. -/
theorem contraction_h_nonincreasing :
    DegreeNonincreasing b degree (contraction b degree homological D hD hlower hH).h := by
  simpa only [Function.comp_def, id_eq] using
    BasisMultigradedContraction.contraction_h_nonincreasing
      b degree homological D hD hlower hH (id : ℕ → ℕ)

end FourPapers.BasisBigradedContraction

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.BasisBigradedExactness -/
section

/-! # Exactness of the actual internal-degree strands of a homogeneous complex -/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 700000
noncomputable section
namespace FourPapers.BasisBigradedContraction
open Classical CommAlg
variable {R M I : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  (b : Module.Basis I R M) (degree homological : I → ℕ)
  (D : Module.End R M) (hD : D.comp D = 0)
  (hlower : ∀ q p x, x ∈ piece b degree homological q (p+1) →
    D x ∈ piece b degree homological q p)
  (hzero : ∀ q x, x ∈ piece b degree homological q 0 → D x = 0)

include hlower hzero in
theorem differential_internal_degree (i : I) :
    D (b i) ∈ Grading.Piece b degree (degree i) := by
  have hi := Grading.basis_mem_piece b (fun i => (degree i,homological i)) i
  cases hp : homological i with
  | zero =>
      have hz := hzero (degree i) (b i) (by simpa only [piece, hp] using hi)
      rw [hz]
      exact Submodule.zero_mem _
  | succ p =>
      have h := hlower (degree i) p (b i) (by simpa only [piece, hp] using hi)
      exact piece_regrade b (fun i => (degree i,homological i)) (degree i,p) Prod.fst h

include hlower hzero in
theorem internal_projection_commutes (q : ℕ) :
    D.comp (Grading.projection b degree q) = (Grading.projection b degree q).comp D :=
  shiftedProjection_commutes b b degree degree id Function.injective_id D
    (differential_internal_degree b degree homological D hlower hzero) q

/-- An internal projection retains a separate homological degree. -/
theorem internal_projection_mem_piece (q p : ℕ) (x : M)
    (hx : x ∈ Grading.Piece b homological p) :
    Grading.projection b degree q x ∈ piece b degree homological q p := by
  have hq := Grading.projection_mem b degree q x
  have hp := projection_preserves_basisSpan b degree q {i | homological i = p} x hx
  apply (Grading.mem_piece b (fun i => (degree i,homological i)) (q,p) _).mpr
  intro i hi
  exact Prod.ext ((Grading.mem_piece b degree q _).mp hq i hi)
    ((Grading.mem_piece b homological p _).mp hp i hi)

include hlower hzero in
/-- A positive cycle in an actual joint degree has a preimage in the next
joint degree whenever the underlying homological complex is exact. -/
theorem homogeneous_boundary_of_exact
    (hex : ∀ p x, x ∈ Grading.Piece b homological (p+1) → D x = 0 →
      ∃ y, y ∈ Grading.Piece b homological (p+2) ∧ D y = x)
    (q p : ℕ) (x : piece b degree homological q (p+1)) (hx : D x.val = 0) :
    ∃ y : piece b degree homological q (p+2), D y.val = x.val := by
  have hxp : x.val ∈ Grading.Piece b homological (p+1) :=
    piece_regrade b (fun i => (degree i,homological i)) (q,p+1) Prod.snd x.property
  obtain ⟨y,hyp,hy⟩ := hex p x.val hxp hx
  refine ⟨⟨Grading.projection b degree q y,
    internal_projection_mem_piece b degree homological q (p+2) y hyp⟩,?_⟩
  have he := LinearMap.congr_fun
    (internal_projection_commutes b degree homological D hlower hzero q) y
  change D (Grading.projection b degree q y) = Grading.projection b degree q (D y) at he
  rw [he,hy]
  apply Grading.projection_eq_self
  exact piece_regrade b (fun i => (degree i,homological i)) (q,p+1) Prod.fst x.property

include hzero in
/-- The homology here is the literal kernel modulo image; positive
acyclicity therefore makes it a zero module, without a rank assumption. -/
theorem positive_homology_subsingleton
    (hex : ∀ p x, x ∈ Grading.Piece b homological (p+1) → D x = 0 →
      ∃ y, y ∈ Grading.Piece b homological (p+2) ∧ D y = x)
    (q p : ℕ) : Subsingleton (StrandHomology b degree homological D hD hlower q (p+1)) := by
  have htop : ProjectiveComplexSplitting.boundaries (fun p => ↥(piece b degree homological q p))
      (differential b degree homological D hlower q)
      (differential_square b degree homological D hD hlower q) (p+1) = ⊤ := by
    apply top_unique
    intro x _
    have hx : D x.val.val = 0 := by
      have h := x.property
      change differential b degree homological D hlower q p x.val = 0 at h
      exact congrArg Subtype.val h
    obtain ⟨y,hy⟩ := homogeneous_boundary_of_exact b degree homological D hlower hzero hex q p x.val hx
    refine ⟨y,?_⟩
    apply Subtype.ext
    apply Subtype.ext
    exact hy
  change Subsingleton (_ ⧸ ProjectiveComplexSplitting.boundaries
    (fun p => ↥(piece b degree homological q p)) (differential b degree homological D hlower q)
    (differential_square b degree homological D hD hlower q) (p+1))
  rw [htop]
  infer_instance

end FourPapers.BasisBigradedContraction

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.WeightedPolynomialPerturbation -/
section

/-!
# Positive weighted polynomial perturbation

The polynomial variables may have different positive degrees. The decreasing
rank is the coefficient degree plus the sum of the exterior-variable weights.
Consequently a homogeneous Koszul contraction can mix exterior faces while
still preserving the rank needed for the finite geometric-series inverse.

This file imposes no finiteness condition on the coefficient module or on its
homology. In particular it applies to a regular sequence whose quotient has
an infinite homogeneous basis over the coefficient field.
-/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 800000
noncomputable section

namespace FourPapers.WeightedPolynomialPerturbation

open Classical CommAlg MvPolynomial HomologicalPerturbation
open scoped TensorProduct
open PolynomialModuleResolution

universe u
variable {R V : Type u} [CommRing R] [Fintype V] [LinearOrder V]
  (M : Type u) [AddCommGroup M] [Module (MvPolynomial V R) M]
  [Module R M] [IsScalarTower R (MvPolynomial V R) M]

local notation "S" => MvPolynomial V R

def internalDegree {I : Type*} (degree : I → ℕ) (weight : V → ℕ)
    (a : I × Finset V) : ℕ :=
  degree a.1 + ∑ v ∈ a.2, weight v

theorem internalDegree_erase_lt {I : Type*} (degree : I → ℕ)
    (weight : V → ℕ) (hweight : ∀ v, 0 < weight v)
    (i : I) (F : Finset V) (v : V) (hv : v ∈ F) :
    internalDegree degree weight (i,F.erase v) < internalDegree degree weight (i,F) := by
  have hs := Finset.sum_erase_add F weight hv
  have hvpos := hweight v
  dsimp [internalDegree]
  omega

/-- Removing an exterior generator decreases its actual positive weight. -/
theorem externalDifferential_decreases {I : Type*} (b : Module.Basis I R M)
    (degree : I → ℕ) (weight : V → ℕ) (hweight : ∀ v, 0 < weight v) :
    DegreeDecreasing ((PolynomialPerturbation.tensorBasis M b).baseChange S)
      (internalDegree degree weight) (externalDifferential (R := R) (V := V) M) := by
  apply degreeDecreasing_of_mem_span
  rintro ⟨i,F⟩
  let B := (PolynomialPerturbation.tensorBasis (R := R) (V := V) M b).baseChange S
  let L := Submodule.span S
    (B '' {a | internalDegree degree weight a < internalDegree degree weight (i,F)})
  change externalDifferential M (B (i,F)) ∈ L
  rw [show B (i,F) = 1 ⊗ₜ[R] (b i ⊗ₜ[R] Simplicial.basis F) by
    simp only [B, Module.Basis.baseChange_apply, PolynomialPerturbation.tensorBasis,
      Module.Basis.tensorProduct_apply], externalDifferential_tmul]
  apply L.sum_mem
  intro v _
  rw [mul_one, Simplicial.contraction_basis]
  by_cases hv : v ∈ F
  · rw [if_pos hv, TensorProduct.tmul_smul, TensorProduct.tmul_smul]
    have hb : B (i,F.erase v) ∈ L := Submodule.subset_span
      ⟨(i,F.erase v),internalDegree_erase_lt degree weight hweight i F v hv,rfl⟩
    have hs : (X v : S) ⊗ₜ[R] (b i ⊗ₜ[R] Simplicial.basis (F.erase v)) ∈ L := by
      have he : (X v : S) ⊗ₜ[R] (b i ⊗ₜ[R] Simplicial.basis (F.erase v)) =
          (X v : S) • B (i,F.erase v) := by
        simp only [B, Module.Basis.baseChange_apply, PolynomialPerturbation.tensorBasis,
          Module.Basis.tensorProduct_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [he]
      exact L.smul_mem _ hb
    rw [Units.smul_def, ← Int.cast_smul_eq_zsmul S]
    exact L.smul_mem _ hs
  · rw [if_neg hv, TensorProduct.tmul_zero, TensorProduct.tmul_zero]
    exact L.zero_mem

variable {H : Type u} [AddCommGroup H] [Module R H]
variable (C : LinearContraction (R := R)
  (M := CoefficientKoszul (R := R) (V := V) M) (H := H))
variable (hCd : C.d = TensorExteriorKoszul.differential (K := R) (M := M)
  (X : V → MvPolynomial V R))
variable {I : Type*} (b : Module.Basis I R M) (degree : I → ℕ)
  (weight : V → ℕ) (hweight : ∀ v, 0 < weight v)
  (hh : DegreeNonincreasing (PolynomialPerturbation.tensorBasis M b)
    (internalDegree degree weight) C.h)

/-- Exterior contraction kills the literal exterior-degree-zero span. -/
theorem removeExterior_zero (v : V) (z : CoefficientKoszul (R := R) (V := V) M)
    (hz : z ∈ Grading.Piece (PolynomialPerturbation.tensorBasis M b)
      (fun a => a.2.card) 0) : removeExterior M v z = 0 := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨⟨i,F⟩,hF,rfl⟩ := hz
      have hF' : F = ∅ := Finset.card_eq_zero.mp hF
      simp only [PolynomialPerturbation.tensorBasis, Module.Basis.tensorProduct_apply,
        removeExterior, TensorProduct.map_tmul, LinearMap.id_apply, hF',
        Simplicial.contraction_basis, Finset.notMem_empty, if_false, TensorProduct.tmul_zero]
  | zero => exact map_zero _
  | add x y hx hy ihx ihy => rw [map_add,ihx,ihy,add_zero]
  | smul r x hx ih => rw [map_smul,ih,smul_zero]

/-- Concentration of representatives in degree zero is the concrete
criterion forcing the entire transferred differential to vanish. -/
theorem externalDifferential_inclusion_zero
    (hinc : ∀ x, C.inclusion x ∈ Grading.Piece (PolynomialPerturbation.tensorBasis M b)
      (fun a => a.2.card) 0) :
    (externalDifferential (R := R) (V := V) M).comp (C.inclusion.baseChange S) = 0 := by
  apply LinearMap.restrictScalars_injective R
  apply TensorProduct.ext'
  intro s x
  change externalDifferential M (s ⊗ₜ[R] C.inclusion x) = 0
  simp only [externalDifferential, LinearMap.sum_apply, LinearMap.smul_apply,
    LinearMap.baseChange_tmul]
  apply Finset.sum_eq_zero
  intro v _
  rw [removeExterior_zero M b v (C.inclusion x) (hinc x), TensorProduct.tmul_zero, smul_zero]

def transferred : LinearDeformationRetract
    (R := S) (M := Bar (R := R) (V := V) M) (H := S ⊗[R] H) :=
  (PolynomialPerturbation.extendedContraction M C).perturbByDegree
    ((PolynomialPerturbation.tensorBasis M b).baseChange S) (internalDegree degree weight)
    (externalDifferential M) (externalDifferential_decreases M b degree weight hweight)
    ((hh.baseChange S).neg)
    (by rw [PolynomialPerturbation.extended_differential M C hCd]
        exact differential_square M)

theorem transferred_sourceD :
    (transferred M C hCd b degree weight hweight hh).sourceD = differential M :=
  PolynomialPerturbation.extended_differential M C hCd

def augmentation : (S ⊗[R] H) →ₗ[S] M :=
  (PolynomialModuleResolution.augmentation M).comp
    (transferred M C hCd b degree weight hweight hh).inclusion

def splitAugmentation :
    LinearDeformationRetract (R := R) (M := S ⊗[R] H) (H := M) :=
  ((transferred M C hCd b degree weight hweight hh).restrictScalars R).descendZeroContraction
    (barContraction M) (by
      change ((transferred M C hCd b degree weight hweight hh).sourceD).restrictScalars R = _
      rw [transferred_sourceD, barContraction_d])

theorem splitAugmentation_projection :
    (splitAugmentation M C hCd b degree weight hweight hh).projection =
      (augmentation M C hCd b degree weight hweight hh).restrictScalars R := by
  apply LinearMap.ext
  intro x
  change (barContraction M).projection
    ((transferred M C hCd b degree weight hweight hh).inclusion x) = _
  rw [barContraction_projection]
  rfl

theorem transferred_targetD_zero
    (hi : (externalDifferential (R := R) (V := V) M).comp (C.inclusion.baseChange S) = 0) :
    (transferred M C hCd b degree weight hweight hh).targetD = 0 := by
  apply LinearMap.ext
  intro x
  change (C.projection.baseChange S)
    ((Units.val (α := Module.End S (Bar (R := R) (V := V) M))
      (((PolynomialPerturbation.extendedContraction M C).leftPerturbationUnit
        ((PolynomialPerturbation.tensorBasis M b).baseChange S) (internalDegree degree weight)
        (externalDifferential M) (externalDifferential_decreases M b degree weight hweight)
        ((hh.baseChange S).neg))⁻¹))
      (externalDifferential M ((C.inclusion.baseChange S) x))) = 0
  have hix : externalDifferential M ((C.inclusion.baseChange S) x) = 0 :=
    LinearMap.congr_fun hi x
  rw [hix, map_zero, map_zero]

/-- If homology is concentrated in exterior degree zero, the transferred
augmentation is an actual polynomial-linear isomorphism. Its construction
does not assume that the polynomial action is flat or free. -/
def augmentationEquiv
    (hi : (externalDifferential (R := R) (V := V) M).comp (C.inclusion.baseChange S) = 0) :
    (S ⊗[R] H) ≃ₗ[S] M := by
  let A := splitAugmentation M C hCd b degree weight hweight hh
  have hp : A.projection =
      (augmentation M C hCd b degree weight hweight hh).restrictScalars R :=
    splitAugmentation_projection M C hCd b degree weight hweight hh
  have hd : A.sourceD = 0 := by
    change ((transferred M C hCd b degree weight hweight hh).targetD).restrictScalars R = 0
    rw [transferred_targetD_zero M C hCd b degree weight hweight hh hi]
    rfl
  apply LinearEquiv.ofBijective (augmentation M C hCd b degree weight hweight hh)
  constructor
  · intro x y he
    have hx := LinearMap.congr_fun A.deformation x
    have hy := LinearMap.congr_fun A.deformation y
    rw [hd] at hx hy
    have hx' : x = A.inclusion (A.projection x) := by
      apply sub_eq_zero.mp
      simpa only [zero_mul, mul_zero, zero_add, LinearMap.zero_apply,
        LinearMap.sub_apply, Module.End.one_apply, LinearMap.comp_apply] using hx.symm
    have hy' : y = A.inclusion (A.projection y) := by
      apply sub_eq_zero.mp
      simpa only [zero_mul, mul_zero, zero_add, LinearMap.zero_apply,
        LinearMap.sub_apply, Module.End.one_apply, LinearMap.comp_apply] using hy.symm
    rw [hx', hy', hp]
    exact congrArg A.inclusion he
  · intro x
    refine ⟨A.inclusion x, ?_⟩
    have he := A.projection_inclusion x
    rw [hp] at he
    exact he

end FourPapers.WeightedPolynomialPerturbation

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.PolynomialRegularSubstitution -/
section

/-!
# A polynomial ring is free over a positive homogeneous regular sequence

The polynomial action is the literal evaluation map X_v ↦ f_v. The proof
constructs a homogeneous contraction of its regular-sequence Koszul
complex and applies the finite geometric-series perturbation. The quotient
by the sequence may have an infinite homogeneous basis; no module-finiteness
hypothesis is imposed.
-/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace FourPapers.PolynomialRegularSubstitution
open Classical CommAlg MvPolynomial HomologicalPerturbation
open scoped TensorProduct
universe u
variable {K Y V : Type u} [Field K] [Fintype V] [LinearOrder V]
local notation "S" => MvPolynomial V K
local notation "R" => MvPolynomial Y K
variable (f : V → MvPolynomial Y K)

/-- The coefficient action is exactly polynomial substitution. -/
def substitutionAlgebra : Algebra S R := (MvPolynomial.aeval («R» := K) f).toRingHom.toAlgebra

def basis : Module.Basis ((Y →₀ ℕ) × Finset V) K (R ⊗[K] Simplicial.Ambient V K) :=
  (MvPolynomial.basisMonomials Y K).tensorProduct Simplicial.basis

def rank (w : V → ℕ) (a : (Y →₀ ℕ) × Finset V) : ℕ :=
  a.1.degree + ∑ v ∈ a.2, w v

def homological (a : (Y →₀ ℕ) × Finset V) : ℕ := a.2.card

def differential : Module.End K (R ⊗[K] Simplicial.Ambient V K) :=
  TensorExteriorKoszul.differential (K := K) («R» := R) (M := R) f

@[simp] theorem basis_apply (a : Y →₀ ℕ) (F : Finset V) :
    basis (K := K) (Y := Y) (V := V) (a,F) = monomial a 1 ⊗ₜ[K] Simplicial.basis F := by
  simp only [basis, Module.Basis.tensorProduct_apply, MvPolynomial.coe_basisMonomials]

variable (w : V → ℕ)

/-- The degree of a homogeneous coefficient together with its actual
exterior weights determines the joint tensor degree. -/
theorem homogeneous_tmul_mem (g : R) (q : ℕ) (hg : g.IsHomogeneous q) (F : Finset V) :
    g ⊗ₜ[K] Simplicial.basis F ∈
      BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V)) (rank w) homological
        (q + ∑ v ∈ F, w v) F.card := by
  rw [g.as_sum, TensorProduct.sum_tmul]
  apply Submodule.sum_mem
  intro a ha
  have hd : a.degree = q := by
    by_contra hn
    exact (MvPolynomial.mem_support_iff.mp ha)
      (MvPolynomial.IsHomogeneous.coeff_eq_zero hg hn)
  have hb : basis (K := K) (Y := Y) (V := V) (a,F) ∈
      BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V)) (rank w) homological
        (q + ∑ v ∈ F, w v) F.card :=
    Submodule.subset_span ⟨(a,F), by simp only [Set.mem_setOf_eq,rank,homological,hd], rfl⟩
  have he : monomial a (g.coeff a) ⊗ₜ[K] Simplicial.basis F =
      (g.coeff a) • basis (K := K) (Y := Y) (V := V) (a,F) := by
    rw [basis_apply, TensorProduct.smul_tmul']
    congr 1
    simp only [smul_monomial, smul_eq_mul, mul_one]
  rw [he]
  exact Submodule.smul_mem _ _ hb

variable (hhom : ∀ v, (f v).IsHomogeneous (w v))

include hhom in
theorem differential_basis_mem (a : Y →₀ ℕ) (F : Finset V) (p : ℕ) (hF : F.card = p+1) :
    differential f (basis (K := K) (Y := Y) (V := V) (a,F)) ∈
      BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V)) (rank w) homological
        (rank w (a,F)) p := by
  rw [basis_apply,differential,TensorExteriorKoszul.differential_tmul]
  apply Submodule.sum_mem
  intro v _
  rw [Simplicial.contraction_basis]
  by_cases hv : v ∈ F
  · rw [if_pos hv, TensorProduct.tmul_smul]
    refine (Submodule.toAddSubgroup («R» := K) (M := R ⊗[K] Simplicial.Ambient V K)
      (BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K)
        (basis (K := K) (Y := Y) (V := V)) (rank w) homological
        (rank w (a,F)) p)).zsmul_mem ?_ (TauCeti.ExteriorAlgebra.basisEraseSign v F : ℤ)
    change ((f v * monomial a 1) ⊗ₜ[K] Simplicial.basis (F.erase v)) ∈ _
    have h := homogeneous_tmul_mem (K := K) w (f v * monomial a 1)
      (w v + a.degree) ((hhom v).mul (isHomogeneous_monomial (1 : K) rfl)) (F.erase v)
    have hdegree : w v + a.degree + ∑ j ∈ F.erase v, w j = rank w (a,F) := by
      have he := Finset.sum_erase_add F w hv
      dsimp [rank]
      omega
    have hcard : (F.erase v).card = p := by rw [Finset.card_erase_of_mem hv,hF]; omega
    simpa only [Submodule.mem_toAddSubgroup,hdegree,hcard] using h
  · rw [if_neg hv, TensorProduct.tmul_zero]
    exact Submodule.zero_mem _

include hhom in
theorem differential_lowers (q p : ℕ) (x : R ⊗[K] Simplicial.Ambient V K)
    (hx : x ∈ BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
      (rank w) homological q (p+1)) :
    differential f x ∈ BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K)
      (basis (K := K) (Y := Y) (V := V)) (rank w) homological q p := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨⟨a,F⟩,h,rfl⟩ := hx
      have hq := congrArg Prod.fst h
      have hp := congrArg Prod.snd h
      change rank w (a,F) = q at hq
      change F.card = p+1 at hp
      simpa only [hq] using differential_basis_mem f w hhom a F p hp
  | zero => simpa only [map_zero] using Submodule.zero_mem _
  | add x y hx hy ihx ihy => simpa only [map_add] using Submodule.add_mem _ ihx ihy
  | smul c x hx ih => simpa only [map_smul] using Submodule.smul_mem _ c ih

theorem differential_zero (q : ℕ) (x : R ⊗[K] Simplicial.Ambient V K)
    (hx : x ∈ BasisBigradedContraction.piece («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
      (rank w) homological q 0) : differential f x = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨⟨a,F⟩,h,rfl⟩ := hx
      have hp := congrArg Prod.snd h
      have hF : F = ∅ := Finset.card_eq_zero.mp hp
      rw [basis_apply,differential,TensorExteriorKoszul.differential_tmul]
      simp only [hF,Simplicial.contraction_basis,Finset.notMem_empty,if_false,
        TensorProduct.tmul_zero,Finset.sum_const_zero]
  | zero => exact map_zero _
  | add x y hx hy ihx ihy => rw [map_add,ihx,ihy,add_zero]
  | smul c x hx ih => rw [map_smul,ih,smul_zero]

theorem differential_square : (differential f).comp (differential f) = 0 :=
  TensorExteriorKoszul.differential_comp f

abbrev Homology := BasisBigradedContraction.GradedHomology («R» := K) (M := R ⊗[K] Simplicial.Ambient V K)
  (basis (K := K) (Y := Y) (V := V)) (rank w) homological (differential f)
  (differential_square f) (differential_lowers f w hhom)

/-- Every actual homology quotient is a projective K-vector space. -/
theorem strandProjective (q p : ℕ) : Module.Projective K
    (BasisBigradedContraction.StrandHomology («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
      (rank w) homological (differential f) (differential_square f)
      (differential_lowers f w hhom) q p) := by infer_instance

def contraction :=
  BasisBigradedContraction.contraction («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
    (rank w) homological (differential f) (differential_square f)
    (differential_lowers f w hhom) (strandProjective f w hhom)

theorem contraction_d : (contraction f w hhom).d = differential f := by
  have h := BasisBigradedContraction.contraction_d («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
    (rank w) homological (differential f) (differential_square f)
    (differential_lowers f w hhom) (differential_zero f w) (strandProjective f w hhom)
  exact h

theorem contraction_h_nonincreasing : DegreeNonincreasing
    (basis (K := K) (Y := Y) (V := V)) (rank w) (contraction f w hhom).h := by
  have h := BasisBigradedContraction.contraction_h_nonincreasing («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
    (rank w) homological (differential f) (differential_square f)
    (differential_lowers f w hhom) (strandProjective f w hhom)
  exact h

variable (hreg : RegularFamilyKoszul.IsRegularFamily f)

include hreg in
theorem positive_homology_zero (q p : ℕ) : Subsingleton
    (BasisBigradedContraction.StrandHomology («R» := K) (M := R ⊗[K] Simplicial.Ambient V K) (basis (K := K) (Y := Y) (V := V))
      (rank w) homological (differential f) (differential_square f)
      (differential_lowers f w hhom) q (p+1)) := by
  apply BasisBigradedContraction.positive_homology_subsingleton («R» := K) (M := R ⊗[K] Simplicial.Ambient V K)
    (basis (K := K) (Y := Y) (V := V)) (rank w) homological
    (differential f) (differential_square f) (differential_lowers f w hhom)
    (differential_zero f w)
  intro p x hx hdx
  exact TensorHomologicalBasis.basis_boundary_of_exact (MvPolynomial.basisMonomials Y K) f p
    (RegularFamilyKoszul.tensor_exact_positive_of_family (K := K) f hreg (p+1) (by omega))
    x hx hdx

include hreg in
theorem contraction_inclusion_mem_zero (x : Homology f w hhom) :
    (contraction f w hhom).inclusion x ∈ Grading.Piece
      (basis (K := K) (Y := Y) (V := V)) homological 0 := by
  have h := BasisBigradedContraction.contraction_inclusion_mem_zero («R» := K) (M := R ⊗[K] Simplicial.Ambient V K)
    (basis (K := K) (Y := Y) (V := V)) (rank w) homological
    (differential f) (differential_square f) (differential_lowers f w hhom)
    (strandProjective f w hhom) (positive_homology_zero f w hhom hreg) x
  exact h

variable [Algebra (MvPolynomial V K) (MvPolynomial Y K)]
  [IsScalarTower K (MvPolynomial V K) (MvPolynomial Y K)]

/-- An inferable algebra action with the stated variable values is the
literal substitution map. -/
theorem algebraMap_eq_aeval (hvars : ∀ v, algebraMap S R (X v)=f v) :
    algebraMap S R=(MvPolynomial.aeval f).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro c
    simpa only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq] using
      (IsScalarTower.algebraMap_apply K S R c).symm
  · intro v
    simpa only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      MvPolynomial.aeval_X] using hvars v

/-- Substitution action and coefficient multiplication give the same
literal differential, before applying any homological construction. -/
theorem substitution_differential (hvars : ∀ v, algebraMap S R (X v)=f v) :
    TensorExteriorKoszul.differential (K := K) («R» := S) (M := R) (X : V → S) = differential f := by
  rw [TensorExteriorKoszul.differential_algebraMap]
  congr 1
  funext v
  exact hvars v

theorem contraction_substitution_d (hvars : ∀ v, algebraMap S R (X v)=f v) : (contraction f w hhom).d =
    TensorExteriorKoszul.differential (K := K) («R» := S) (M := R) (X : V → S) := by
  rw [contraction_d,substitution_differential f hvars]

variable (hw : ∀ v, 0 < w v)

/-- The actual polynomial-linear isomorphism proving freeness; no
flatness, rank equality or Hilbert-series identity is a premise. -/
def freeModuleEquiv (hvars : ∀ v, algebraMap S R (X v)=f v) : (S ⊗[K] Homology f w hhom) ≃ₗ[S] R :=
  WeightedPolynomialPerturbation.augmentationEquiv R (contraction f w hhom)
    (contraction_substitution_d f w hhom hvars) (MvPolynomial.basisMonomials Y K)
    Finsupp.degree w hw (contraction_h_nonincreasing f w hhom)
    (WeightedPolynomialPerturbation.externalDifferential_inclusion_zero R
      (contraction f w hhom) (MvPolynomial.basisMonomials Y K)
      (contraction_inclusion_mem_zero f w hhom hreg))

include w hhom hreg hw in
/-- Graded regular-sequence substitution is genuinely free as a module
over the source polynomial ring, allowing an infinite coefficient basis. -/
theorem substitution_free (hvars : ∀ v, algebraMap S R (X v)=f v) : Module.Free S R :=
  Module.Free.of_basis (((Module.Free.chooseBasis K (Homology f w hhom)).baseChange S).map
    (freeModuleEquiv f w hhom hreg hw hvars))

include w hhom hreg hw in
/-- Literal substitution version, with no algebra-action premise. -/
theorem literalSubstitution_free :
    letI := substitutionAlgebra f
    Module.Free S R := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K S R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  exact substitution_free f w hhom hreg hw (fun v => MvPolynomial.aeval_X f v)

end FourPapers.PolynomialRegularSubstitution

#print axioms FourPapers.PolynomialRegularSubstitution.substitution_free

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.FlatIdealBaseChange -/
section

/-! # Flat scalar extension of an ideal is its literal extended ideal -/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 400000
noncomputable section
namespace FourPapers.FlatIdealBaseChange
open Classical
open scoped TensorProduct
variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Multiplication identifies the image of the tensor inclusion with the
ideal generated by the actual algebra-map images. -/
theorem image_eq (I : Ideal R) :
    (I.baseChange A).map (TensorProduct.AlgebraTensorModule.rid R A A).toLinearMap =
      (I.map (algebraMap R A) : Submodule A A) := by
  rw [Submodule.baseChange_eq_span,Submodule.map_span]
  change Submodule.span A
      ((TensorProduct.AlgebraTensorModule.rid R A A) ''
        ((Submodule.map (TensorProduct.mk R A R 1) (I : Submodule R R) : Submodule R (A ⊗[R] R)) : Set (A ⊗[R] R))) =
    Submodule.span A ((algebraMap R A) '' (I : Set R))
  apply congrArg (Submodule.span A)
  ext a
  constructor
  · rintro ⟨z,⟨r,hr,rfl⟩,rfl⟩
    exact ⟨r,hr,by simp only [TensorProduct.mk_apply,TensorProduct.AlgebraTensorModule.rid_tmul,
      Algebra.smul_def,mul_one]⟩
  · rintro ⟨r,hr,rfl⟩
    refine ⟨1 ⊗ₜ[R] r,⟨r,hr,rfl⟩,?_⟩
    simp only [TensorProduct.AlgebraTensorModule.rid_tmul,Algebra.smul_def,mul_one]

/-- A flat extension yields the canonical linear equivalence onto the
actual extended ideal; injectivity is the flatness theorem applied to its inclusion. -/
def equiv [Module.Flat R A] (I : Ideal R) :
    (A ⊗[R] I) ≃ₗ[A] I.map (algebraMap R A) :=
  (Submodule.toBaseChange.toLinearEquiv A I).trans
    ((TensorProduct.AlgebraTensorModule.rid R A A).ofSubmodules _ _ (image_eq I))

@[simp] theorem equiv_tmul [Module.Flat R A] (I : Ideal R) (a : A) (r : I) :
    (equiv I (a ⊗ₜ[R] r)).val = a * algebraMap R A r.val := by
  change TensorProduct.AlgebraTensorModule.rid R A A (a ⊗ₜ[R] r.val) = _
  simp only [TensorProduct.AlgebraTensorModule.rid_tmul,Algebra.smul_def,mul_comm]

end FourPapers.FlatIdealBaseChange

end
end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.RegularSubstitutionIdeals -/
section

/-!
# Literal ideals, grading and minimal entries under regular substitution

Every map in this file is polynomial evaluation at the given sequence.
The power identity holds without regularity. Regularity and positive
homogeneous degrees supply the free extension needed for exact base change;
positivity also sends the source variable ideal into the target variable ideal.
-/

section
set_option autoImplicit false
set_option maxRecDepth 4096
set_option maxHeartbeats 700000
noncomputable section
namespace FourPapers.Sublattice
open Classical CommAlg MvPolynomial
universe u
variable {K Y : Type u} [Field K] {d : ℕ} {n : Fin d → ℕ}
  (f : FiniteVariable.{u} n → MvPolynomial Y K)

def substitutedRowMonomial (a : FiniteTuple n) : MvPolynomial Y K :=
  ∏ r : Fin d, f ⟨r,ULift.up (a r)⟩

def substitutedSublatticeIdeal (E : Finset (FiniteTuple n)) : Ideal (MvPolynomial Y K) :=
  Ideal.span ((substitutedRowMonomial f) '' (E : Set (FiniteTuple n)))

@[simp] theorem aeval_finiteRowMonomial (a : FiniteTuple n) :
    MvPolynomial.aeval f (finiteRowMonomial n (k := K) a) = substitutedRowMonomial f a := by
  simp only [finiteRowMonomial,substitutedRowMonomial,map_prod,aeval_X]

/-- The substituted ideal is the actual extension of the original ideal. -/
theorem substitutedSublatticeIdeal_eq_map (E : Finset (FiniteTuple n)) :
    substitutedSublatticeIdeal f E =
      (finiteSublatticeIdeal n (k := K) E).map (MvPolynomial.aeval f).toRingHom := by
  rw [substitutedSublatticeIdeal,finiteSublatticeIdeal,Ideal.map_span,Set.image_image]
  congr 1
  apply Set.image_congr
  intro a _
  exact (aeval_finiteRowMonomial f a).symm

/-- All powers, including the zeroth, are preserved as literal ideals. -/
theorem substitutedSublatticeIdeal_pow (E : Finset (FiniteTuple n)) (m : ℕ) :
    substitutedSublatticeIdeal f E ^ m =
      (finiteSublatticeIdeal n (k := K) E ^ m).map (MvPolynomial.aeval f).toRingHom := by
  rw [Ideal.map_pow,substitutedSublatticeIdeal_eq_map]

end FourPapers.Sublattice

namespace FourPapers.PolynomialRegularSubstitution
open Classical CommAlg MvPolynomial
open scoped TensorProduct
universe u
variable {K Y V : Type u} [Field K] [Fintype V] [LinearOrder V]
  (f : V → MvPolynomial Y K) (w : V → ℕ)
  (hhom : ∀ v, (f v).IsHomogeneous (w v))
local notation "S" => MvPolynomial V K
local notation "R" => MvPolynomial Y K
variable [Algebra (MvPolynomial V K) (MvPolynomial Y K)] [IsScalarTower K (MvPolynomial V K) (MvPolynomial Y K)]

include hhom in
/-- Ordinary degree after evaluation is precisely the weighted source degree. -/
theorem aeval_weightedHomogeneous (p : S) (q : ℕ)
    (hp : p.IsWeightedHomogeneous w q) : (MvPolynomial.aeval f p).IsHomogeneous q := by
  rw [p.as_sum,map_sum]
  apply MvPolynomial.IsHomogeneous.sum
  intro a ha
  rw [MvPolynomial.aeval_monomial]
  have hprod := MvPolynomial.IsHomogeneous.prod a.support
    (fun v => f v ^ a v) (fun v => w v * a v)
    (fun v _ => (hhom v).pow (a v))
  have hdegree : ∑ v ∈ a.support, w v * a v = q := by
    have h := hp (MvPolynomial.mem_support_iff.mp ha)
    simpa only [Finsupp.weight_apply,Finsupp.sum,smul_eq_mul,mul_comm] using h
  have h := hprod.C_mul (p.coeff a)
  simpa only [Finsupp.prod,hdegree,MvPolynomial.algebraMap_eq] using h

include hhom in
theorem variable_mem_maximal (hw : ∀ v, 0 < w v) (v : V) :
    f v ∈ MvPolynomial.idealOfVars Y K := by
  rw [← CommAlg.Koszul.ker_constantCoeff,RingHom.mem_ker,MvPolynomial.constantCoeff_eq]
  by_contra h
  have he := hhom v h
  have hp := hw v
  simp only [map_zero] at he
  omega

include hhom in
/-- Positive degree preserves every minimal matrix entry. -/
theorem aeval_mem_maximal (hw : ∀ v, 0 < w v) (p : S)
    (hp : p ∈ MvPolynomial.idealOfVars V K) :
    MvPolynomial.aeval f p ∈ MvPolynomial.idealOfVars Y K := by
  have hle : MvPolynomial.idealOfVars V K ≤
      (MvPolynomial.idealOfVars Y K).comap (MvPolynomial.aeval f).toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨v,rfl⟩
    change (MvPolynomial.aeval («R» := K) f).toRingHom (X v : S) ∈
      MvPolynomial.idealOfVars Y K
    simpa only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, aeval_X] using
      variable_mem_maximal f w hhom hw v
  exact hle hp

variable (hreg : RegularFamilyKoszul.IsRegularFamily f) (hw : ∀ v, 0 < w v)
  (hvars : ∀ v, algebraMap (MvPolynomial V K) (MvPolynomial Y K) (X v) = f v)

include w hhom hreg hw hvars in
/-- Exactness of an arbitrary source complex survives this substitution. -/
theorem substitution_baseChange_exact
    {M N P : Type*} [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
    [Module S M] [Module S N] [Module S P]
    (a : M →ₗ[S] N) (b : N →ₗ[S] P) (hab : Function.Exact a b) :
    Function.Exact (a.baseChange R) (b.baseChange R) := by
  letI := substitution_free f w hhom hreg hw hvars
  exact Module.Flat.lTensor_exact R hab

/-- Each tensor-extended ideal is the literal image ideal under evaluation. -/
def substitutionIdealEquiv (I : Ideal S) :
    (R ⊗[S] I) ≃ₗ[R] I.map (MvPolynomial.aeval f).toRingHom := by
  letI := substitution_free f w hhom hreg hw hvars
  have he : I.map (algebraMap S R)=I.map (MvPolynomial.aeval f).toRingHom :=
    congrArg (fun g => I.map g) (algebraMap_eq_aeval f hvars)
  exact (FlatIdealBaseChange.equiv I).trans (LinearEquiv.ofEq _ _ he)

@[simp] theorem substitutionIdealEquiv_tmul (I : Ideal S) (r : R) (x : I) :
    (substitutionIdealEquiv f w hhom hreg hw hvars I (r ⊗ₜ[S] x)).val =
      r * MvPolynomial.aeval f x.val := by
  letI := substitution_free f w hhom hreg hw hvars
  change (FlatIdealBaseChange.equiv I (r ⊗ₜ[S] x)).val = _
  rw [FlatIdealBaseChange.equiv_tmul, algebraMap_eq_aeval f hvars]
  simp only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]

end FourPapers.PolynomialRegularSubstitution

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.NativeScalarExtension -/
section

/-! # Scalar extension with the given algebra action

Mathlib's ring-homomorphism functor installs the coefficient action by
restriction of scalars. This equivalent presentation uses the existing
`Algebra A B` structure, so its objects and maps are literally the native
tensor products and their linear base changes. The equality of functors
is proved from equality of algebra structures; it is not an additional
compatibility hypothesis.
-/

section
set_option autoImplicit false
set_option maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace FourPapers.NativeScalarExtension
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped TensorProduct
universe u
variable (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]

/-- Scalar extension using the given coefficient action on `B`. -/
def functor : ModuleCat.{u} A ⥤ ModuleCat.{u} B where
  obj M := ModuleCat.of B (B ⊗[A] M)
  map f := ModuleCat.ofHom (f.hom.baseChange B)
  map_id M := by
    apply ModuleCat.hom_ext
    change (LinearMap.id : M →ₗ[A] M).baseChange B = LinearMap.id
    exact LinearMap.baseChange_id
  map_comp f g := by
    apply ModuleCat.hom_ext
    change (g.hom.comp f.hom).baseChange B =
      (g.hom.baseChange B).comp (f.hom.baseChange B)
    exact LinearMap.baseChange_comp f.hom g.hom

/-- The native tensor presentation is the standard scalar extension
functor along the given algebra map. -/
theorem functor_eq_extendScalars :
    functor A B = ModuleCat.extendScalars (algebraMap A B) := by
  calc
    functor A B = @functor A B _ _ (algebraMap A B).toAlgebra :=
      congrArg (fun a : Algebra A B => @functor A B _ _ a)
        (toAlgebra_algebraMap (R := A) (S := B)).symm
    _ = ModuleCat.extendScalars (algebraMap A B) := by rfl

instance functor_additive : (functor A B).Additive where
  map_add := by
    intro M N f g
    apply ModuleCat.hom_ext
    change (f.hom + g.hom).baseChange B = f.hom.baseChange B + g.hom.baseChange B
    exact LinearMap.baseChange_add f.hom g.hom

instance functor_isLeftAdjoint : (functor A B).IsLeftAdjoint := by
  rw [functor_eq_extendScalars]
  infer_instance

/-- Forgetting the new coefficient action recovers the usual tensor-left
functor on the original module category. -/
theorem functor_comp_restrictScalars :
    functor A B ⋙ ModuleCat.restrictScalars (algebraMap A B) =
      tensorLeft (ModuleCat.of A B) := by
  rw [← toAlgebra_algebraMap (R := A) (S := B)]
  rfl

/-- Scalar extension preserves projectivity without a flatness premise. -/
instance functor_preservesProjectives : (functor A B).PreservesProjectiveObjects := by
  rw [functor_eq_extendScalars]
  exact Functor.preservesProjectiveObjects_of_adjunction_of_preservesEpimorphisms
    (ModuleCat.extendRestrictScalarsAdj (algebraMap A B))

/-- The native scalar-extension functor is exact whenever its coefficient
module is flat. This is proved through the actual tensor-left functor. -/
instance functor_preservesFiniteLimits [Module.Flat A B] :
    PreservesFiniteLimits (functor A B) := by
  have : PreservesFiniteLimits
      (functor A B ⋙ ModuleCat.restrictScalars (algebraMap A B)) := by
    rw [functor_comp_restrictScalars]
    infer_instance
  exact preservesFiniteLimits_of_reflects_of_preserves
    (functor A B) (ModuleCat.restrictScalars (algebraMap A B))

end FourPapers.NativeScalarExtension
end

end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.RegularSubstitutionResolutions -/
section

/-! # Actual free resolutions under regular substitution

An arbitrary source projective resolution is extended by the actual scalar
extension functor. The proved freeness of the substitution makes this an
exact functor. Chosen free bases extend by tensoring, and every differential
entry is literally evaluated at the regular sequence. Positive degrees
therefore retain minimality and implement the stated weighted regrading.
-/

section
set_option autoImplicit false
set_option maxHeartbeats 600000
noncomputable section
namespace FourPapers.PolynomialRegularSubstitution
open Classical CategoryTheory CategoryTheory.Limits MvPolynomial
open scoped TensorProduct
universe u
variable {K Y V : Type u} [Field K] [Fintype V] [LinearOrder V]
local notation "S" => MvPolynomial V K
local notation "R" => MvPolynomial Y K
variable (f : V → (MvPolynomial Y K)) (w : V → ℕ) (hhom : ∀ v, (f v).IsHomogeneous (w v))
  (hreg : RegularFamilyKoszul.IsRegularFamily f) (hw : ∀ v, 0 < w v)
variable [Algebra (MvPolynomial V K) (MvPolynomial Y K)] [IsScalarTower K (MvPolynomial V K) (MvPolynomial Y K)]
  (hvars : ∀ v, algebraMap (MvPolynomial V K) (MvPolynomial Y K) (X v)=f v)

def resolutionFunctor : ModuleCat.{u} S ⥤ ModuleCat.{u} R :=
  NativeScalarExtension.functor S R

instance resolutionFunctor_preservesProjectives :
    (resolutionFunctor (K := K) (V := V) (Y := Y)).PreservesProjectiveObjects :=
  NativeScalarExtension.functor_preservesProjectives S R

include w hhom hreg hw hvars in
theorem resolutionFunctor_exact : PreservesFiniteLimits (resolutionFunctor (K := K) (V := V) (Y := Y)) := by
  letI := substitution_free f w hhom hreg hw hvars
  exact NativeScalarExtension.functor_preservesFiniteLimits S R

/-- The entire scalar-extended complex remains an actual projective
resolution, with no additional exactness premise. -/
def baseChangedResolution {M : ModuleCat.{u} S} (P : ProjectiveResolution M) :
    ProjectiveResolution ((resolutionFunctor (K := K) (V := V) (Y := Y)).obj M) := by
  letI := resolutionFunctor_exact f w hhom hreg hw hvars
  letI : (resolutionFunctor (K := K) (V := V) (Y := Y)).IsLeftAdjoint :=
    NativeScalarExtension.functor_isLeftAdjoint S R
  letI : (resolutionFunctor (K := K) (V := V) (Y := Y)).Additive :=
    NativeScalarExtension.functor_additive S R
  exact (resolutionFunctor (K := K) (V := V) (Y := Y)).mapProjectiveResolution P

/-- The augmentation lands in the literal extended ideal. -/
def idealResolution (I : Ideal S) (P : ProjectiveResolution (ModuleCat.of S I)) :
    ProjectiveResolution (ModuleCat.of R (I.map (MvPolynomial.aeval f).toRingHom)) := by
  let Q := baseChangedResolution f w hhom hreg hw hvars P
  let e := (substitutionIdealEquiv f w hhom hreg hw hvars I).toModuleIso
  exact
    { complex := Q.complex
      projective := Q.projective
      π := Q.π ≫ (ChainComplex.single₀ (ModuleCat R)).map e.hom
      quasiIso := by infer_instance }

/-- A chosen basis in each source degree gives a basis in each extended
degree, with exactly the same index set and shifts. -/
def baseChangedResolutionBasis {M : ModuleCat.{u} S} (P : ProjectiveResolution M)
    {ι : ℕ → Type u} (b : ∀ p,Module.Basis (ι p) S (P.complex.X p)) (p : ℕ) :
    Module.Basis (ι p) R ((baseChangedResolution f w hhom hreg hw hvars P).complex.X p) :=
  (b p).baseChange R

/-- The actual scalar-extended resolution augmentation is the tensor
extension of the original augmentation. -/
theorem baseChangedResolution_augmentation_tmul {M : ModuleCat.{u} S}
    (P : ProjectiveResolution M) (r : R) (x : P.complex.X 0) :
    (baseChangedResolution f w hhom hreg hw hvars P).π.f 0 (r ⊗ₜ[S] x) =
      r ⊗ₜ[S] P.π.f 0 x := by
  change (P.π.f 0).hom.baseChange R (r ⊗ₜ[S] x) = _
  rw [LinearMap.baseChange_tmul]

/-- Evaluation describes the augmentation into the literal extended
ideal, not only the differential matrices. -/
theorem idealResolution_augmentation_tmul (I : Ideal S)
    (P : ProjectiveResolution (ModuleCat.of S I)) (r : R) (x : P.complex.X 0) :
    ((idealResolution f w hhom hreg hw hvars I P).π.f 0 (r ⊗ₜ[S] x)).val =
      r * MvPolynomial.aeval f (P.π.f 0 x).val := by
  change (substitutionIdealEquiv f w hhom hreg hw hvars I
    ((baseChangedResolution f w hhom hreg hw hvars P).π.f 0 (r ⊗ₜ[S] x))).val = _
  rw [baseChangedResolution_augmentation_tmul, substitutionIdealEquiv_tmul]

theorem baseChangedResolution_free {M : ModuleCat.{u} S} (P : ProjectiveResolution M)
    (hfree : ∀ p,Module.Free S (P.complex.X p)) (p : ℕ) :
    Module.Free R ((baseChangedResolution f w hhom hreg hw hvars P).complex.X p) := by
  letI := hfree p
  change Module.Free R (R ⊗[S] (P.complex.X p))
  infer_instance

theorem baseChangedResolution_finite {M : ModuleCat.{u} S} (P : ProjectiveResolution M)
    (hfin : ∀ p,Module.Finite S (P.complex.X p)) (p : ℕ) :
    Module.Finite R ((baseChangedResolution f w hhom hreg hw hvars P).complex.X p) := by
  letI := hfin p
  change Module.Finite R (R ⊗[S] (P.complex.X p))
  infer_instance

section Entries
variable {M N I J : Type u} [AddCommGroup M] [Module (MvPolynomial V K) M]
  [AddCommGroup N] [Module (MvPolynomial V K) N]
  (b : Module.Basis I (MvPolynomial V K) M) (c : Module.Basis J (MvPolynomial V K) N) (a : M →ₗ[MvPolynomial V K] N)

include hvars in
/-- No matrix is supplied independently: these are the coefficients of
the actual base-changed differential in its actual tensor-extended bases. -/
theorem baseChange_entry (i : I) (j : J) :
    (c.baseChange R).repr (a.baseChange R ((b.baseChange R) i)) j=
      MvPolynomial.aeval f (c.repr (a (b i)) j) := by
  rw [Module.Basis.baseChange_apply,LinearMap.baseChange_tmul,
    Module.Basis.baseChange_repr_tmul]
  change (c.repr (a (b i)) j) • (1 : R)=_
  rw [Algebra.smul_def,mul_one,algebraMap_eq_aeval f hvars]
  simp only [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]

include hhom hw hvars in
/-- Positive degrees preserve every minimal differential entry. -/
theorem baseChange_minimal_entry
    (hmin : ∀ i j,c.repr (a (b i)) j∈MvPolynomial.idealOfVars V K) (i : I) (j : J) :
    (c.baseChange R).repr (a.baseChange R ((b.baseChange R) i)) j∈
      MvPolynomial.idealOfVars Y K := by
  rw [baseChange_entry f hvars]
  exact aeval_mem_maximal f w hhom hw _ (hmin i j)

include hhom hvars in
/-- The same coefficient has precisely the regraded weight degree. -/
theorem baseChange_homogeneous_entry (q : ℕ) (i : I) (j : J)
    (hq : (c.repr (a (b i)) j).IsWeightedHomogeneous w q) :
    ((c.baseChange R).repr (a.baseChange R ((b.baseChange R) i)) j).IsHomogeneous q := by
  rw [baseChange_entry f hvars]
  exact aeval_weightedHomogeneous f w hhom _ q hq

end Entries

/-- Minimality is tested on the actual adjacent differentials in the
specified free bases, with respect to the homogeneous maximal ideal. -/
def minimalResolutionEntries {M : ModuleCat.{u} S} (P : ProjectiveResolution M)
    {ι : ℕ → Type u} (b : ∀ p,Module.Basis (ι p) S (P.complex.X p)) : Prop :=
  ∀ p (i : ι (p+1)) (j : ι p),
    (b p).repr (P.complex.d (p+1) p ((b (p+1)) i)) j∈MvPolynomial.idealOfVars V K

include hhom hw hvars in
/-- A minimal free resolution stays minimal in its actual extended
bases. The coefficient is obtained from the literal functor-mapped
differential; no separate matrix is taken as an input. -/
theorem baseChangedResolution_minimal {M : ModuleCat.{u} S} (P : ProjectiveResolution M)
    {ι : ℕ → Type u} (b : ∀ p,Module.Basis (ι p) S (P.complex.X p))
    (hmin : minimalResolutionEntries P b) (p : ℕ) (i : ι (p+1)) (j : ι p) :
    (baseChangedResolutionBasis f w hhom hreg hw hvars P b p).repr
      ((baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p
        (baseChangedResolutionBasis f w hhom hreg hw hvars P b (p+1) i)) j∈
          MvPolynomial.idealOfVars Y K := by
  change ((b p).baseChange R).repr
    ((P.complex.d (p+1) p).hom.baseChange R ((b (p+1)).baseChange R i)) j∈_
  exact baseChange_minimal_entry f w hhom hw hvars (b (p+1)) (b p)
    (P.complex.d (p+1) p).hom (hmin p) i j

include hhom hvars in
/-- Each fine-homogeneous source coefficient acquires exactly the
weighted ordinary degree dictated by the substitution. -/
theorem baseChangedResolution_regraded_entry {M : ModuleCat.{u} S}
    (P : ProjectiveResolution M) {ι : ℕ → Type u}
    (b : ∀ p,Module.Basis (ι p) S (P.complex.X p))
    (p q : ℕ) (i : ι (p+1)) (j : ι p)
    (hq : ((b p).repr (P.complex.d (p+1) p ((b (p+1)) i)) j).IsWeightedHomogeneous w q) :
    ((baseChangedResolutionBasis f w hhom hreg hw hvars P b p).repr
      ((baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p
        (baseChangedResolutionBasis f w hhom hreg hw hvars P b (p+1) i)) j).IsHomogeneous q := by
  change (((b p).baseChange R).repr
    ((P.complex.d (p+1) p).hom.baseChange R ((b (p+1)).baseChange R i)) j).IsHomogeneous q
  exact baseChange_homogeneous_entry f w hhom hvars (b (p+1)) (b p)
    (P.complex.d (p+1) p).hom q i j hq

end FourPapers.PolynomialRegularSubstitution

namespace FourPapers.Sublattice
open Classical CategoryTheory
universe u
variable {K Y : Type u} [Field K] {d : ℕ} {n : Fin d → ℕ}
  (f : FiniteVariable.{u} n → MvPolynomial Y K)
  (w : FiniteVariable.{u} n → ℕ)
  (hhom : ∀ v,(f v).IsHomogeneous (w v))
  (hreg : RegularFamilyKoszul.IsRegularFamily f) (hw : ∀ v,0<w v)

/-- The resolution clause of Corollary 5.8 for every original power and
every chosen source resolution. The target is the literal substituted power. -/
def substitutedPowerResolution (E : Finset (FiniteTuple n)) (m : ℕ)
    (P : ProjectiveResolution (ModuleCat.of (MvPolynomial (FiniteVariable.{u} n) K)
      ↥(finiteSublatticeIdeal n (k := K) E ^ m))) :
    ProjectiveResolution (ModuleCat.of (MvPolynomial Y K) ↥(substitutedSublatticeIdeal f E ^ m)) := by
  letI := PolynomialRegularSubstitution.substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) (MvPolynomial Y K) :=
    IsScalarTower.of_algHom (MvPolynomial.aeval f)
  let Q := PolynomialRegularSubstitution.idealResolution f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) (finiteSublatticeIdeal n (k := K) E ^ m) P
  let e := (LinearEquiv.ofEq _ _ (substitutedSublatticeIdeal_pow f E m).symm).toModuleIso
  exact
    { complex := Q.complex
      projective := Q.projective
      π := Q.π ≫ (ChainComplex.single₀ (ModuleCat (MvPolynomial Y K))).map e.hom
      quasiIso := by infer_instance }

end FourPapers.Sublattice

end
end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.RegularSubstitutionRegrading -/
section

/-!
# Every minimal multigraded resolution under regular substitution

This is the universal preservation statement in Corollary 5.8. The input is
an actual source resolution, with its actual free bases and fine shifts.
Fine homogeneity is the coefficient support equation, including the
augmentation. The scalar-extended maps preserve the genuine homogeneous
submodules of the regraded free terms. No independently specified matrix,
unproved exactness assertion, or existence of a source resolution is used.
-/

section
set_option autoImplicit false
set_option maxHeartbeats 600000
noncomputable section

namespace FourPapers.PolynomialRegularSubstitution
open Classical CategoryTheory CommAlg MvPolynomial
open scoped TensorProduct ModuleCat.Algebra
universe u

section ActualTermGrading
variable {K A I J : Type u} [Field K]
  {M N : ModuleCat.{u} (MvPolynomial A K)}
  (b : Module.Basis I (MvPolynomial A K) M)
  (c : Module.Basis J (MvPolynomial A K) N)

/-- Monomials times the displayed free generators form the coefficient
basis of the actual module, transported through its basis representation. -/
def shiftedTermBasis : Module.Basis (Σ _ : I, A →₀ ℕ) K M :=
  (ShiftedPolynomialFree.expandedBasis (R := K) (V := A)).map
    (b.repr.restrictScalars K).symm

@[simp] theorem shiftedTermBasis_apply (i : I) (a : A →₀ ℕ) :
    shiftedTermBasis b ⟨i,a⟩ = (monomial a (1 : K)) • b i := by
  rw [shiftedTermBasis, Module.Basis.map_apply, ShiftedPolynomialFree.expandedBasis_apply]
  exact Module.Basis.repr_symm_single b i (monomial a 1)

/-- The source fine piece retains the entire exponent vector. -/
def fineTermPiece (shift : I → A →₀ ℕ) (q : A →₀ ℕ) : Submodule K M :=
  Grading.Piece (shiftedTermBasis b) (fun a => a.2 + shift a.1) q

def fineTermDecomposition (shift : I → A →₀ ℕ) :
    DirectSum.Decomposition (fineTermPiece b shift) :=
  basisGradingDecomposition (shiftedTermBasis b) (fun a => a.2 + shift a.1)

theorem mem_fineTermPiece (shift : I → A →₀ ℕ) (q : A →₀ ℕ) (x : M) :
    x ∈ fineTermPiece b shift q ↔
      ∀ i a, ((b.repr x) i).coeff a ≠ 0 → a + shift i = q := by
  rw [fineTermPiece, Grading.mem_piece]
  change (∀ a : Σ _ : I, A →₀ ℕ,
    ((b.repr x) a.1).coeff a.2 ≠ 0 → a.2 + shift a.1 = q) ↔ _
  constructor
  · intro h i a ha
    exact h ⟨i,a⟩ ha
  · intro h a ha
    exact h a.1 a.2 ha

theorem basis_mem_fineTermPiece (shift : I → A →₀ ℕ) (i : I) :
    b i ∈ fineTermPiece b shift (shift i) := by
  have h := Grading.basis_mem_piece (R := K) (shiftedTermBasis b)
    (fun a => a.2 + shift a.1) (⟨i,0⟩ : Σ _ : I, A →₀ ℕ)
  simpa only [fineTermPiece, shiftedTermBasis_apply, ← MvPolynomial.one_def,
    one_smul, zero_add] using h

/-- The coefficient equation is equivalent to genuine fine homogeneity
of the whole linear map on the actual source and target modules. -/
theorem map_fineTermPiece_iff (shift : I → A →₀ ℕ) (shift' : J → A →₀ ℕ)
    (a : M →ₗ[MvPolynomial A K] N) :
    (∀ q x, x ∈ fineTermPiece b shift q → a x ∈ fineTermPiece c shift' q) ↔
      ∀ i j e, ((c.repr (a (b i))) j).coeff e ≠ 0 → e + shift' j = shift i := by
  constructor
  · intro h i j e he
    exact (mem_fineTermPiece c shift' (shift i) (a (b i))).mp
      (h (shift i) (b i) (basis_mem_fineTermPiece b shift i)) j e he
  · intro h q x hx
    apply map_mem_piece_of_basis (R := K) (shiftedTermBasis b) (shiftedTermBasis c)
      (fun v => v.2 + shift v.1) (fun v => v.2 + shift' v.1)
      (a.restrictScalars K) (fun v => ?_) q hx
    rw [LinearMap.restrictScalars_apply, shiftedTermBasis_apply, map_smul]
    apply (mem_fineTermPiece c shift' (v.2 + shift v.1) _).mpr
    intro j e he
    rw [map_smul, Finsupp.smul_apply, smul_eq_mul, MvPolynomial.coeff_monomial_mul'] at he
    by_cases hve : v.2 ≤ e
    · rw [if_pos hve, one_mul] at he
      have hf := h v.1 j (e-v.2) he
      calc
        e + shift' j = ((e-v.2) + v.2) + shift' j := by rw [tsub_add_cancel_of_le hve]
        _ = v.2 + ((e-v.2) + shift' j) := by ac_rfl
        _ = v.2 + shift v.1 := by rw [hf]
    · rw [if_neg hve] at he
      exact (he rfl).elim

def fineIdealPiece (L : Ideal (MvPolynomial A K)) (q : A →₀ ℕ) : Submodule K L :=
  (Grading.Piece (MvPolynomial.basisMonomials A K) id q).comap
    (L.subtype.restrictScalars K)

theorem mem_fineIdealPiece (L : Ideal (MvPolynomial A K)) (q : A →₀ ℕ) (x : L) :
    x ∈ fineIdealPiece L q ↔ ∀ a, x.val.coeff a ≠ 0 → a = q := by
  change x.val ∈ Grading.Piece (MvPolynomial.basisMonomials A K) id q ↔ _
  rw [Grading.mem_piece]
  rfl

theorem augmentation_fineTermPiece_iff (shift : I → A →₀ ℕ)
    (L : Ideal (MvPolynomial A K)) (ε : M →ₗ[MvPolynomial A K] L) :
    (∀ q x, x ∈ fineTermPiece b shift q → ε x ∈ fineIdealPiece L q) ↔
      ∀ i a, (ε (b i)).val.coeff a ≠ 0 → a = shift i := by
  constructor
  · intro h i a ha
    exact (mem_fineIdealPiece L (shift i) (ε (b i))).mp
      (h (shift i) (b i) (basis_mem_fineTermPiece b shift i)) a ha
  · intro h q x hx
    have hle : fineTermPiece b shift q ≤
        (fineIdealPiece L q).comap (ε.restrictScalars K) := by
      apply Submodule.span_le.mpr
      rintro y ⟨v,hv,rfl⟩
      change ε (shiftedTermBasis b v) ∈ fineIdealPiece L q
      apply (mem_fineIdealPiece L q _).mpr
      intro a ha
      rw [shiftedTermBasis_apply, map_smul] at ha
      change ((monomial v.2 1) * (ε (b v.1)).val).coeff a ≠ 0 at ha
      rw [MvPolynomial.coeff_monomial_mul'] at ha
      by_cases hva : v.2 ≤ a
      · rw [if_pos hva, one_mul] at ha
        have he := h v.1 (a-v.2) ha
        calc
          a = (a-v.2) + v.2 := (tsub_add_cancel_of_le hva).symm
          _ = v.2 + shift v.1 := by rw [he, add_comm]
          _ = q := hv
      · rw [if_neg hva] at ha
        exact (ha rfl).elim
    exact hle hx

/-- A genuine homogeneous submodule of the original free term. -/
def shiftedTermPiece (shift : I → ℕ) (q : ℕ) : Submodule K M :=
  Grading.Piece (shiftedTermBasis b) (ShiftedPolynomialFree.expandedDegree shift) q

/-- The displayed pieces form an actual direct-sum decomposition. -/
def shiftedTermDecomposition (shift : I → ℕ) :
    DirectSum.Decomposition (shiftedTermPiece b shift) :=
  basisGradingDecomposition (shiftedTermBasis b)
    (ShiftedPolynomialFree.expandedDegree shift)

theorem mem_shiftedTermPiece (shift : I → ℕ) (q : ℕ) (x : M) :
    x ∈ shiftedTermPiece b shift q ↔
      ∀ i a, ((b.repr x) i).coeff a ≠ 0 → a.degree + shift i = q := by
  rw [shiftedTermPiece, Grading.mem_piece]
  change (∀ a : Σ _ : I, A →₀ ℕ,
    ((b.repr x) a.1).coeff a.2 ≠ 0 → a.2.degree + shift a.1 = q) ↔ _
  constructor
  · intro h i a ha
    exact h ⟨i,a⟩ ha
  · intro h a ha
    exact h a.1 a.2 ha

theorem shiftedTermPiece_coordinates (shift : I → ℕ) (q : ℕ) (x : M) :
    x ∈ shiftedTermPiece b shift q ↔
      b.repr x ∈ ShiftedPolynomialFree.piece shift q := by
  rw [mem_shiftedTermPiece, ShiftedPolynomialFree.mem_piece]

/-- The literal matrix support equation implies preservation of all
homogeneous vectors, not merely the displayed generators. -/
theorem map_shiftedTermPiece (shift : I → ℕ) (shift' : J → ℕ)
    (a : M →ₗ[MvPolynomial A K] N)
    (ha : ∀ i j e, ((c.repr (a (b i))) j).coeff e ≠ 0 →
      e.degree + shift' j = shift i)
    (q : ℕ) {x : M} (hx : x ∈ shiftedTermPiece b shift q) :
    a x ∈ shiftedTermPiece c shift' q := by
  let F := c.repr.toLinearMap.comp (a.comp b.repr.symm.toLinearMap)
  have hF : ∀ i j e, ((F (Finsupp.single i 1)) j).coeff e ≠ 0 →
      e.degree + shift' j = shift i := by
    intro i j e he
    apply ha i j e
    simpa only [F, LinearMap.comp_apply, LinearEquiv.coe_coe,
      Module.Basis.repr_symm_single_one] using he
  have hh := ShiftedPolynomialFree.map_piece shift shift' F hF q
    ((shiftedTermPiece_coordinates b shift q x).mp hx)
  apply (shiftedTermPiece_coordinates c shift' q (a x)).mpr
  simpa only [F, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.symm_apply_apply] using hh

theorem augmentation_shiftedTermPiece (shift : I → ℕ)
    (L : Ideal (MvPolynomial A K)) (ε : M →ₗ[MvPolynomial A K] L)
    (hε : ∀ i, (ε (b i)).val.IsHomogeneous (shift i))
    (q : ℕ) {x : M} (hx : x ∈ shiftedTermPiece b shift q) :
    (ε x).val.IsHomogeneous q := by
  let F := ε.comp b.repr.symm.toLinearMap
  have hF : ∀ i, (F (Finsupp.single i 1)).val.IsHomogeneous (shift i) := by
    intro i
    simpa only [F, LinearMap.comp_apply, LinearEquiv.coe_coe,
      Module.Basis.repr_symm_single_one] using hε i
  have hh := ShiftedPolynomialFree.augmentation_piece shift L F hF q
    ((shiftedTermPiece_coordinates b shift q x).mp hx)
  simpa only [MvPolynomial.IsHomogeneous, Pi.one_def, F, LinearMap.comp_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] using hh

end ActualTermGrading

variable {K Y V : Type u} [Field K] [Fintype V] [LinearOrder V]
local notation "S" => MvPolynomial V K
local notation "R" => MvPolynomial Y K

section FineSource
variable {M : ModuleCat.{u} (MvPolynomial V K)} (P : ProjectiveResolution M)
  {ι : ℕ → Type u} (b : ∀ p, Module.Basis (ι p) (MvPolynomial V K) (P.complex.X p))
  (shift : ∀ p, ι p → V →₀ ℕ)

/-- Fine homogeneity of each actual adjacent differential, expressed
without truncated subtraction. These are the ordinary exponent-vector
shifts of a multigraded resolution of a monomial ideal. -/
def FineResolutionEntries : Prop :=
  ∀ p (i : ι (p+1)) (j : ι p) a,
    (((b p).repr (P.complex.d (p+1) p (b (p+1) i))) j).coeff a ≠ 0 →
      a + shift p j = shift (p+1) i

/-- The source hypothesis is exactly preservation of all actual fine
pieces by the actual source differentials. -/
theorem fineResolutionEntries_iff_graded :
    FineResolutionEntries P b shift ↔
      ∀ p q x, x ∈ fineTermPiece (b (p+1)) (shift (p+1)) q →
        P.complex.d (p+1) p x ∈ fineTermPiece (b p) (shift p) q := by
  constructor
  · intro h p
    exact (map_fineTermPiece_iff (b (p+1)) (b p) (shift (p+1)) (shift p)
      (P.complex.d (p+1) p).hom).mpr (h p)
  · intro h p
    exact (map_fineTermPiece_iff (b (p+1)) (b p) (shift (p+1)) (shift p)
      (P.complex.d (p+1) p).hom).mp (h p)

theorem fineResolution_entry_zero_of_not_le (h : FineResolutionEntries P b shift)
    (p : ℕ) (i : ι (p+1)) (j : ι p) (hij : ¬ shift p j ≤ shift (p+1) i) :
    ((b p).repr (P.complex.d (p+1) p (b (p+1) i))) j = 0 := by
  ext a
  simp only [AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  by_contra hn
  have he := h p i j a hn
  apply hij
  rw [← he]
  exact le_add_of_nonneg_left (show (0 : V →₀ ℕ) ≤ a from zero_le)

theorem fineResolution_entry_weighted (h : FineResolutionEntries P b shift)
    (w : V → ℕ) (p : ℕ) (i : ι (p+1)) (j : ι p) :
    (((b p).repr (P.complex.d (p+1) p (b (p+1) i))) j).IsWeightedHomogeneous w
      (Finsupp.weight w (shift (p+1) i) - Finsupp.weight w (shift p j)) := by
  intro a ha
  have he := congrArg (Finsupp.weight w) (h p i j a ha)
  rw [map_add] at he
  omega

end FineSource

variable (f : V → (MvPolynomial Y K)) (w : V → ℕ) (hhom : ∀ v, (f v).IsHomogeneous (w v))
  (hreg : RegularFamilyKoszul.IsRegularFamily f) (hw : ∀ v, 0 < w v)
  [Algebra (MvPolynomial V K) (MvPolynomial Y K)] [IsScalarTower K (MvPolynomial V K) (MvPolynomial Y K)]
  (hvars : ∀ v, algebraMap (MvPolynomial V K) (MvPolynomial Y K) (X v) = f v)

section UniversalResolution
variable {M : ModuleCat.{u} (MvPolynomial V K)} (P : ProjectiveResolution M)
  {ι : ℕ → Type u} (b : ∀ p, Module.Basis (ι p) (MvPolynomial V K) (P.complex.X p))
  (shift : ∀ p, ι p → V →₀ ℕ)

abbrev regradedShift (p : ℕ) (i : ι p) : ℕ := Finsupp.weight w (shift p i)

theorem baseChangedResolution_entry (p : ℕ) (i : ι (p+1)) (j : ι p) :
    (baseChangedResolutionBasis f w hhom hreg hw hvars P b p).repr
      ((baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p
        (baseChangedResolutionBasis f w hhom hreg hw hvars P b (p+1) i)) j =
      MvPolynomial.aeval f
        (((b p).repr (P.complex.d (p+1) p (b (p+1) i))) j) := by
  change ((b p).baseChange R).repr
    ((P.complex.d (p+1) p).hom.baseChange R ((b (p+1)).baseChange R i)) j = _
  exact baseChange_entry f hvars (b (p+1)) (b p) (P.complex.d (p+1) p).hom i j

theorem baseChangedResolution_fine_entry_zero (h : FineResolutionEntries P b shift)
    (p : ℕ) (i : ι (p+1)) (j : ι p) (hij : ¬ shift p j ≤ shift (p+1) i) :
    (baseChangedResolutionBasis f w hhom hreg hw hvars P b p).repr
      ((baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p
        (baseChangedResolutionBasis f w hhom hreg hw hvars P b (p+1) i)) j = 0 := by
  rw [baseChangedResolution_entry,
    fineResolution_entry_zero_of_not_le P b shift h p i j hij, map_zero]

/-- Every nonzero coefficient satisfies the additive shift identity.
This is stronger than an assertion using a truncated degree difference. -/
theorem baseChangedResolution_shift_degree (h : FineResolutionEntries P b shift)
    (p : ℕ) (i : ι (p+1)) (j : ι p) (a : Y →₀ ℕ)
    (ha : ((baseChangedResolutionBasis f w hhom hreg hw hvars P b p).repr
      ((baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p
        (baseChangedResolutionBasis f w hhom hreg hw hvars P b (p+1) i)) j).coeff a ≠ 0) :
    a.degree + regradedShift w shift p j = regradedShift w shift (p+1) i := by
  have hij : shift p j ≤ shift (p+1) i := by
    by_contra hn
    rw [baseChangedResolution_fine_entry_zero f w hhom hreg hw hvars P b shift h p i j hn] at ha
    exact ha rfl
  have he := congrArg (Finsupp.weight w) (tsub_add_cancel_of_le hij)
  rw [map_add] at he
  have hd := baseChangedResolution_regraded_entry f w hhom hreg hw hvars P b p
    (Finsupp.weight w (shift (p+1) i) - Finsupp.weight w (shift p j)) i j
    (fineResolution_entry_weighted P b shift h w p i j) ha
  change Finsupp.weight (fun _ : Y => (1 : ℕ)) a = _ at hd
  rw [← Finsupp.degree_eq_weight_one] at hd
  change a.degree + Finsupp.weight w (shift p j) = Finsupp.weight w (shift (p+1) i)
  omega

def baseChangedResolutionTermPiece (p q : ℕ) :
    Submodule K ((baseChangedResolution f w hhom hreg hw hvars P).complex.X p) :=
  shiftedTermPiece (baseChangedResolutionBasis f w hhom hreg hw hvars P b p)
    (regradedShift w shift p) q

def baseChangedResolutionTermDecomposition (p : ℕ) :
    DirectSum.Decomposition (baseChangedResolutionTermPiece f w hhom hreg hw hvars P b shift p) :=
  shiftedTermDecomposition (baseChangedResolutionBasis f w hhom hreg hw hvars P b p)
    (regradedShift w shift p)

/-- The actual differential preserves every homogeneous term, with the
specified weighted shifts. Exactness and minimality are the independently
proved universal scalar-extension statements in RegularSubstitutionResolutions. -/
theorem baseChangedResolution_differential_graded
    (h : FineResolutionEntries P b shift) (p q : ℕ)
    {x : (baseChangedResolution f w hhom hreg hw hvars P).complex.X (p+1)}
    (hx : x ∈ baseChangedResolutionTermPiece f w hhom hreg hw hvars P b shift (p+1) q) :
    (baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p x ∈
      baseChangedResolutionTermPiece f w hhom hreg hw hvars P b shift p q :=
  map_shiftedTermPiece
    (baseChangedResolutionBasis f w hhom hreg hw hvars P b (p+1))
    (baseChangedResolutionBasis f w hhom hreg hw hvars P b p)
    (regradedShift w shift (p+1)) (regradedShift w shift p)
    ((baseChangedResolution f w hhom hreg hw hvars P).complex.d (p+1) p).hom
    (baseChangedResolution_shift_degree f w hhom hreg hw hvars P b shift h p) q hx

end UniversalResolution

section Augmentation
variable (I : Ideal (MvPolynomial V K)) (P : ProjectiveResolution (ModuleCat.of (MvPolynomial V K) I))
  {ι : ℕ → Type u} (b : ∀ p, Module.Basis (ι p) (MvPolynomial V K) (P.complex.X p))
  (shift : ∀ p, ι p → V →₀ ℕ)

def FineAugmentationEntries : Prop :=
  ∀ (i : ι 0) a, ((P.π.f 0 (b 0 i)).val).coeff a ≠ 0 → a = shift 0 i

theorem fineAugmentationEntries_iff_graded :
    FineAugmentationEntries I P b shift ↔
      ∀ q x, x ∈ fineTermPiece (b 0) (shift 0) q →
        P.π.f 0 x ∈ fineIdealPiece I q :=
  (augmentation_fineTermPiece_iff (b 0) (shift 0) I (P.π.f 0).hom).symm

theorem idealResolution_augmentation_basis (i : ι 0) :
    ((idealResolution f w hhom hreg hw hvars I P).π.f 0
      (baseChangedResolutionBasis f w hhom hreg hw hvars P b 0 i)).val =
      MvPolynomial.aeval f (P.π.f 0 (b 0 i)).val := by
  have hb : baseChangedResolutionBasis f w hhom hreg hw hvars P b 0 i =
      (1 : R) ⊗ₜ[S] (b 0 i) :=
    Module.Basis.baseChange_apply R (b 0) i
  rw [hb, idealResolution_augmentation_tmul, one_mul]

theorem idealResolution_augmentation_regraded
    (h : FineAugmentationEntries I P b shift) (i : ι 0) :
    (((idealResolution f w hhom hreg hw hvars I P).π.f 0
      (baseChangedResolutionBasis f w hhom hreg hw hvars P b 0 i)).val).IsHomogeneous
        (regradedShift w shift 0 i) := by
  rw [idealResolution_augmentation_basis]
  apply aeval_weightedHomogeneous f w hhom
  intro a ha
  rw [h i a ha]

/-- Homogeneity holds through the actual augmentation into the literal
substituted ideal, so the whole augmented complex is graded. -/
theorem idealResolution_augmentation_graded
    (h : FineAugmentationEntries I P b shift) (q : ℕ)
    {x : (idealResolution f w hhom hreg hw hvars I P).complex.X 0}
    (hx : x ∈ baseChangedResolutionTermPiece f w hhom hreg hw hvars P b shift 0 q) :
    ((idealResolution f w hhom hreg hw hvars I P).π.f 0 x).val.IsHomogeneous q :=
  augmentation_shiftedTermPiece
    (baseChangedResolutionBasis f w hhom hreg hw hvars P b 0)
    (regradedShift w shift 0) (I.map (MvPolynomial.aeval f).toRingHom)
    ((idealResolution f w hhom hreg hw hvars I P).π.f 0).hom
    (idealResolution_augmentation_regraded f w hhom hreg hw hvars I P b shift h) q hx

end Augmentation
end FourPapers.PolynomialRegularSubstitution

end
end
end

/- BEGIN EXACT BODY: FourPapers.Common.DisjointMonomialRegularity -/
section

/-!
# Positive monomials with disjoint supports form a regular sequence

Multiplication by a monomial is injective modulo a monomial ideal whose
generators use disjoint variables. The proof uses the literal coefficient
criterion for monomial-ideal membership. Applying it to every preceding
segment gives Mathlib's `Sequence.IsRegular`, including an empty family.
The ambient variable type need not be finite, and every positive exponent
is allowed.
-/

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 500000
noncomputable section

namespace FourPapers.DisjointMonomialRegularity

open Classical MvPolynomial

universe u
variable {K Y : Type u} [CommRing K]

def exponentIdeal (B : Set (Y →₀ ℕ)) : Ideal (MvPolynomial Y K) :=
  Ideal.span ((fun a : Y →₀ ℕ => monomial a (1 : K)) '' B)

/-- Disjoint supports permit cancellation of the new monomial from an
actual ideal membership statement, even when the coefficient ring has torsion. -/
theorem monomial_regular_mod (B : Set (Y →₀ ℕ)) (a : Y →₀ ℕ)
    (hB : ∀ b ∈ B, Disjoint b.support a.support) :
    IsSMulRegular (MvPolynomial Y K ⧸ exponentIdeal (K := K) B)
      (monomial a (1 : K)) := by
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem
    (exponentIdeal (K := K) B) (monomial a (1 : K))).mpr
  intro p hp
  change monomial a (1 : K) * p ∈ exponentIdeal B at hp
  rw [exponentIdeal, mem_ideal_span_monomial_image] at hp ⊢
  intro c hc
  have hac : a + c ∈ (monomial a (1 : K) * p).support := by
    apply mem_support_iff.mpr
    simpa only [coeff_monomial_mul, one_mul] using mem_support_iff.mp hc
  obtain ⟨b, hb, hba⟩ := hp (a + c) hac
  refine ⟨b, hb, ?_⟩
  intro y
  by_cases hby : b y = 0
  · simp only [hby, zero_le]
  · have hay : a y = 0 := by
      by_contra hay
      exact Finset.disjoint_left.mp (hB b hb)
        (Finsupp.mem_support_iff.mpr hby) (Finsupp.mem_support_iff.mpr hay)
    simpa only [Finsupp.add_apply, hay, zero_add] using hba y

theorem one_not_mem_exponentIdeal [Nontrivial K]
    (B : Set (Y →₀ ℕ)) (hB : ∀ b ∈ B, b ≠ 0) :
    (1 : MvPolynomial Y K) ∉ exponentIdeal (K := K) B := by
  intro h
  rw [exponentIdeal, mem_ideal_span_monomial_image] at h
  obtain ⟨b, hb, hb0⟩ := h 0 (by simp)
  apply hB b hb
  ext y
  exact Nat.eq_zero_of_le_zero (hb0 y)

/-- The exponent set of the actual preceding segment of a list. -/
def prefixExponents (l : List (MvPolynomial Y K))
    (a : Fin l.length → Y →₀ ℕ) (i : ℕ) : Set (Y →₀ ℕ) :=
  {b | ∃ j : Fin l.length, j.val < i ∧ a j = b}

theorem ofList_take_eq_exponentIdeal (l : List (MvPolynomial Y K))
    (a : Fin l.length → Y →₀ ℕ)
    (ha : ∀ j, l.get j = monomial (a j) (1 : K)) (i : ℕ) :
    Ideal.ofList (l.take i) = exponentIdeal (K := K) (prefixExponents l a i) := by
  unfold exponentIdeal
  apply congrArg Ideal.span
  ext p
  change p ∈ l.take i ↔
    ∃ b, (∃ j : Fin l.length, j.val < i ∧ a j = b) ∧ monomial b (1 : K) = p
  constructor
  · intro hp
    obtain ⟨j, hj, hjp⟩ := List.mem_iff_getElem.mp hp
    have hjmin : j < min i l.length := by
      simpa only [List.length_take] using hj
    have hji : j < i := (Nat.lt_min.mp hjmin).1
    have hjl : j < l.length := (Nat.lt_min.mp hjmin).2
    have he : l.get ⟨j, hjl⟩ = p := by
      simpa only [List.get_eq_getElem, List.getElem_take] using hjp
    exact ⟨a ⟨j, hjl⟩, ⟨⟨j, hjl⟩, hji, rfl⟩, (ha ⟨j, hjl⟩).symm.trans he⟩
  · rintro ⟨b, ⟨j, hji, rfl⟩, rfl⟩
    apply List.mem_iff_getElem.mpr
    refine ⟨j.val, ?_, ?_⟩
    · simpa only [List.length_take] using Nat.lt_min.mpr ⟨hji, j.isLt⟩
    · simpa only [List.get_eq_getElem, List.getElem_take] using ha j

/-- Every ordering of pairwise disjoint positive monomials is an actual
regular sequence, with a nonzero final quotient. -/
theorem indexed_monomials_regular [Nontrivial K]
    (l : List (MvPolynomial Y K)) (a : Fin l.length → Y →₀ ℕ)
    (ha : ∀ j, l.get j = monomial (a j) (1 : K))
    (hpos : ∀ j, a j ≠ 0)
    (hdis : Pairwise (fun i j => Disjoint (a i).support (a j).support)) :
    RingTheory.Sequence.IsRegular (MvPolynomial Y K) l := by
  refine { regular_mod_prev := ?_, top_ne_smul := ?_ }
  · intro i hi
    rw [Ideal.smul_eq_mul, Ideal.mul_top, ofList_take_eq_exponentIdeal l a ha i]
    change IsSMulRegular
      (MvPolynomial Y K ⧸ exponentIdeal (K := K) (prefixExponents l a i))
      (l.get ⟨i, hi⟩)
    rw [ha ⟨i, hi⟩]
    apply monomial_regular_mod
    rintro b ⟨j, hji, rfl⟩
    apply hdis
    intro he
    have hv : j.val = i := congrArg Fin.val he
    omega
  · rw [Ideal.smul_eq_mul, Ideal.mul_top]
    intro htop
    have hone : (1 : MvPolynomial Y K) ∈ Ideal.ofList l :=
      htop ▸ (show (1 : MvPolynomial Y K) ∈ (⊤ : Ideal (MvPolynomial Y K)) from trivial)
    have hI := ofList_take_eq_exponentIdeal l a ha l.length
    rw [List.take_length] at hI
    rw [hI] at hone
    exact one_not_mem_exponentIdeal (prefixExponents l a l.length)
      (by rintro b ⟨j, hj, rfl⟩; exact hpos j) hone

variable {V : Type u} [Fintype V] [LinearOrder V] [Nontrivial K]

/-- The canonical enumeration itself satisfies Mathlib's regular-sequence
predicate; no order-independence theorem is assumed. -/
theorem disjoint_monomials_familyList_regular (a : V → Y →₀ ℕ)
    (hpos : ∀ v, a v ≠ 0)
    (hdis : Pairwise (fun v w => Disjoint (a v).support (a w).support)) :
    RingTheory.Sequence.IsRegular (MvPolynomial Y K)
      (RegularFamilyKoszul.familyList (fun v => monomial (a v) (1 : K))) := by
  let f : V → MvPolynomial Y K := fun v => monomial (a v) (1 : K)
  apply indexed_monomials_regular (RegularFamilyKoszul.familyList f)
    (fun i => a (RegularFamilyKoszul.familyIndex f i))
  · exact RegularFamilyKoszul.familyList_get f
  · intro i
    exact hpos _
  · intro i j hij
    apply hdis
    intro he
    exact hij ((RegularFamilyKoszul.familyIndex f).injective he)

/-- The precise regularity premise of the substitution theorems follows
for all finite families of positive disjoint-support monomials. -/
theorem disjoint_monomials_regular (a : V → Y →₀ ℕ)
    (hpos : ∀ v, a v ≠ 0)
    (hdis : Pairwise (fun v w => Disjoint (a v).support (a w).support)) :
    RegularFamilyKoszul.IsRegularFamily (fun v => monomial (a v) (1 : K)) :=
  ⟨RegularFamilyKoszul.familyList _, RegularFamilyKoszul.familyIndex _,
    RegularFamilyKoszul.familyList_get _,
    disjoint_monomials_familyList_regular a hpos hdis⟩

theorem disjoint_monomials_homogeneous (a : V → Y →₀ ℕ) (v : V) :
    (monomial (a v) (1 : K)).IsHomogeneous (a v).degree :=
  isHomogeneous_monomial 1 rfl

theorem monomial_degrees_positive (a : V → Y →₀ ℕ) (hpos : ∀ v, a v ≠ 0) (v : V) :
    0 < (a v).degree := by
  apply Nat.pos_of_ne_zero
  intro h
  exact hpos v ((Finsupp.degree_eq_zero_iff _).mp h)

end FourPapers.DisjointMonomialRegularity

#print axioms FourPapers.DisjointMonomialRegularity.indexed_monomials_regular
#print axioms FourPapers.DisjointMonomialRegularity.disjoint_monomials_regular

end
end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.RegularSubstitutionPowerRegrading -/
section

/-!
# Universal preservation for every power and for disjoint monomials

The source resolution is universally quantified. Its exact scalar extension
resolves the literal substituted power. Minimality, the full regrading and
the augmentation are properties of that actual extended complex.
-/

section
set_option autoImplicit false
set_option maxHeartbeats 600000
noncomputable section
namespace FourPapers.Sublattice
open Classical CategoryTheory CommAlg MvPolynomial PolynomialRegularSubstitution
open scoped TensorProduct ModuleCat.Algebra
universe u
variable {K Y : Type u} [Field K] {d : ℕ} {n : Fin d → ℕ}
  (f : FiniteVariable.{u} n → MvPolynomial Y K)
  (w : FiniteVariable.{u} n → ℕ)
  (hhom : ∀ v, (f v).IsHomogeneous (w v))
  (hreg : RegularFamilyKoszul.IsRegularFamily f) (hw : ∀ v, 0 < w v)
  (E : Finset (FiniteTuple n)) (m : ℕ)
local notation "R" => MvPolynomial Y K
variable (P : ProjectiveResolution (ModuleCat.of (MvPolynomial (FiniteVariable.{u} n) K) ↥(finiteSublatticeIdeal n (k := K) E ^ m)))
  {ι : ℕ → Type u} (b : ∀ p, Module.Basis (ι p) (MvPolynomial (FiniteVariable.{u} n) K) (P.complex.X p))
  (shift : ∀ p, ι p → FiniteVariable.{u} n →₀ ℕ)

/-- The actual tensor-extended basis has the same index set in every degree. -/
def substitutedPowerBasis (p : ℕ) : Module.Basis (ι p) R
    ((substitutedPowerResolution f w hhom hreg hw E m P).complex.X p) := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  exact baseChangedResolutionBasis f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) P b p

include b in
theorem substitutedPower_free (p : ℕ) : Module.Free R
    ((substitutedPowerResolution f w hhom hreg hw E m P).complex.X p) :=
  Module.Free.of_basis (substitutedPowerBasis f w hhom hreg hw E m P b p)

theorem substitutedPower_finite (hfin : ∀ p, Module.Finite (MvPolynomial (FiniteVariable.{u} n) K) (P.complex.X p)) (p : ℕ) :
    Module.Finite R ((substitutedPowerResolution f w hhom hreg hw E m P).complex.X p) := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  exact baseChangedResolution_finite f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) P hfin p

theorem substitutedPower_minimal (hmin : minimalResolutionEntries P b)
    (p : ℕ) (i : ι (p+1)) (j : ι p) :
    (substitutedPowerBasis f w hhom hreg hw E m P b p).repr
      ((substitutedPowerResolution f w hhom hreg hw E m P).complex.d (p+1) p
        (substitutedPowerBasis f w hhom hreg hw E m P b (p+1) i)) j ∈
          MvPolynomial.idealOfVars Y K := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  exact baseChangedResolution_minimal f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) P b hmin p i j

theorem substitutedPower_entry (p : ℕ) (i : ι (p+1)) (j : ι p) :
    (substitutedPowerBasis f w hhom hreg hw E m P b p).repr
      ((substitutedPowerResolution f w hhom hreg hw E m P).complex.d (p+1) p
        (substitutedPowerBasis f w hhom hreg hw E m P b (p+1) i)) j =
      MvPolynomial.aeval f (((b p).repr (P.complex.d (p+1) p (b (p+1) i))) j) := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  exact baseChangedResolution_entry f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) P b p i j

theorem substitutedPower_entry_zero_of_not_le (h : FineResolutionEntries P b shift)
    (p : ℕ) (i : ι (p+1)) (j : ι p) (hij : ¬ shift p j ≤ shift (p+1) i) :
    (substitutedPowerBasis f w hhom hreg hw E m P b p).repr
      ((substitutedPowerResolution f w hhom hreg hw E m P).complex.d (p+1) p
        (substitutedPowerBasis f w hhom hreg hw E m P b (p+1) i)) j = 0 := by
  rw [substitutedPower_entry,
    fineResolution_entry_zero_of_not_le P b shift h p i j hij, map_zero]

theorem substitutedPower_shift_degree (h : FineResolutionEntries P b shift)
    (p : ℕ) (i : ι (p+1)) (j : ι p) (a : Y →₀ ℕ)
    (ha : ((substitutedPowerBasis f w hhom hreg hw E m P b p).repr
      ((substitutedPowerResolution f w hhom hreg hw E m P).complex.d (p+1) p
        (substitutedPowerBasis f w hhom hreg hw E m P b (p+1) i)) j).coeff a ≠ 0) :
    a.degree + Finsupp.weight w (shift p j) = Finsupp.weight w (shift (p+1) i) := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  exact baseChangedResolution_shift_degree f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) P b shift h p i j a ha

def substitutedPowerTermPiece (p q : ℕ) : Submodule K
    ((substitutedPowerResolution f w hhom hreg hw E m P).complex.X p) :=
  shiftedTermPiece (substitutedPowerBasis f w hhom hreg hw E m P b p)
    (fun i => Finsupp.weight w (shift p i)) q

def substitutedPowerTermDecomposition (p : ℕ) : DirectSum.Decomposition
    (substitutedPowerTermPiece f w hhom hreg hw E m P b shift p) :=
  shiftedTermDecomposition (substitutedPowerBasis f w hhom hreg hw E m P b p)
    (fun i => Finsupp.weight w (shift p i))

theorem substitutedPower_differential_graded (h : FineResolutionEntries P b shift)
    (p q : ℕ) {x : (substitutedPowerResolution f w hhom hreg hw E m P).complex.X (p+1)}
    (hx : x ∈ substitutedPowerTermPiece f w hhom hreg hw E m P b shift (p+1) q) :
    (substitutedPowerResolution f w hhom hreg hw E m P).complex.d (p+1) p x ∈
      substitutedPowerTermPiece f w hhom hreg hw E m P b shift p q :=
  map_shiftedTermPiece
    (substitutedPowerBasis f w hhom hreg hw E m P b (p+1))
    (substitutedPowerBasis f w hhom hreg hw E m P b p)
    (fun i => Finsupp.weight w (shift (p+1) i)) (fun j => Finsupp.weight w (shift p j))
    ((substitutedPowerResolution f w hhom hreg hw E m P).complex.d (p+1) p).hom
    (substitutedPower_shift_degree f w hhom hreg hw E m P b shift h p) q hx

theorem substitutedPower_augmentation_basis (i : ι 0) :
    ((substitutedPowerResolution f w hhom hreg hw E m P).π.f 0
      (substitutedPowerBasis f w hhom hreg hw E m P b 0 i)).val =
      MvPolynomial.aeval f (P.π.f 0 (b 0 i)).val := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  change ((LinearEquiv.ofEq _ _ (substitutedSublatticeIdeal_pow f E m).symm)
    ((idealResolution f w hhom hreg hw (fun v => MvPolynomial.aeval_X f v)
      (finiteSublatticeIdeal n (k := K) E ^ m) P).π.f 0
      (baseChangedResolutionBasis f w hhom hreg hw (fun v => MvPolynomial.aeval_X f v)
        P b 0 i))).val = _
  rw [LinearEquiv.coe_ofEq_apply]
  exact idealResolution_augmentation_basis f w hhom hreg hw
    (fun v => MvPolynomial.aeval_X f v) (finiteSublatticeIdeal n (k := K) E ^ m) P b i

theorem substitutedPower_augmentation_regraded
    (h : FineAugmentationEntries (finiteSublatticeIdeal n (k := K) E ^ m) P b shift)
    (i : ι 0) :
    (((substitutedPowerResolution f w hhom hreg hw E m P).π.f 0
      (substitutedPowerBasis f w hhom hreg hw E m P b 0 i)).val).IsHomogeneous
        (Finsupp.weight w (shift 0 i)) := by
  letI := substitutionAlgebra f
  letI : IsScalarTower K (MvPolynomial (FiniteVariable.{u} n) K) R := IsScalarTower.of_algHom (MvPolynomial.aeval f)
  rw [substitutedPower_augmentation_basis]
  apply aeval_weightedHomogeneous f w hhom
  intro a ha
  rw [h i a ha]

theorem substitutedPower_augmentation_graded
    (h : FineAugmentationEntries (finiteSublatticeIdeal n (k := K) E ^ m) P b shift)
    (q : ℕ) {x : (substitutedPowerResolution f w hhom hreg hw E m P).complex.X 0}
    (hx : x ∈ substitutedPowerTermPiece f w hhom hreg hw E m P b shift 0 q) :
    ((substitutedPowerResolution f w hhom hreg hw E m P).π.f 0 x).val.IsHomogeneous q :=
  augmentation_shiftedTermPiece (substitutedPowerBasis f w hhom hreg hw E m P b 0)
    (fun i => Finsupp.weight w (shift 0 i)) (substitutedSublatticeIdeal f E ^ m)
    ((substitutedPowerResolution f w hhom hreg hw E m P).π.f 0).hom
    (substitutedPower_augmentation_regraded f w hhom hreg hw E m P b shift h) q hx

end FourPapers.Sublattice

namespace FourPapers.Sublattice
open Classical CategoryTheory CommAlg MvPolynomial PolynomialRegularSubstitution DisjointMonomialRegularity
universe u
variable {K Y : Type u} [Field K] {d : ℕ} {n : Fin d → ℕ}
  (a : FiniteVariable.{u} n → Y →₀ ℕ) (hpos : ∀ v, a v ≠ 0)
  (hdis : Pairwise (fun v w => Disjoint (a v).support (a w).support))

/-- Arbitrary source resolutions and every power specialize to the
disjoint positive monomial case, with regularity proved from the supports. -/
def disjointMonomialBaseChangedResolution (E : Finset (FiniteTuple n)) (m : ℕ)
    (P : ProjectiveResolution (ModuleCat.of (MvPolynomial (FiniteVariable.{u} n) K)
      ↥(finiteSublatticeIdeal n (k := K) E ^ m))) :=
  substitutedPowerResolution (fun v => monomial (a v) (1 : K))
    (fun v => (a v).degree) (disjoint_monomials_homogeneous a)
    (disjoint_monomials_regular a hpos hdis) (monomial_degrees_positive a hpos) E m P

/-- The complete universal minimality conclusion for disjoint monomials. -/
def disjointMonomialBaseChangedResolution_minimal :=
  substitutedPower_minimal (fun v => monomial (a v) (1 : K))
    (fun v => (a v).degree) (disjoint_monomials_homogeneous a)
    (disjoint_monomials_regular a hpos hdis) (monomial_degrees_positive a hpos)

def disjointMonomialBaseChangedResolution_shift_degree :=
  substitutedPower_shift_degree (fun v => monomial (a v) (1 : K))
    (fun v => (a v).degree) (disjoint_monomials_homogeneous a)
    (disjoint_monomials_regular a hpos hdis) (monomial_degrees_positive a hpos)

def disjointMonomialBaseChangedResolution_augmentation_graded :=
  substitutedPower_augmentation_graded (fun v => monomial (a v) (1 : K))
    (fun v => (a v).degree) (disjoint_monomials_homogeneous a)
    (disjoint_monomials_regular a hpos hdis) (monomial_degrees_positive a hpos)

end FourPapers.Sublattice

