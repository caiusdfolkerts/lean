section

/-! # Homogeneous generators in the standalone mixed theorem

Each coefficient basis vector is supported at its displayed multi-Rees
degree. Tensoring with the full exterior basis gives the literal auxiliary
component. The Koszul differential preserves that component. Thus the
selected-span formulation of Theorem 5.5 is exactly generation by classes
represented by individual homogeneous cycles of coordinate-unit degree.
-/

section
set_option autoImplicit false
set_option maxHeartbeats 900000
noncomputable section

namespace FourPapers.Sublattice
open Classical CommAlg CommAlg.Koszul
open FourPapers.IntegerFiltered.MultiplicativeFiltration
open scoped TensorProduct

universe u
variable {k : Type u} [Field k] {d r : ℕ} {n : Fin d → ℕ}
  {E : Fin r → Finset (FiniteTuple n)}

/-- The actual coefficient color, with the entire exterior factor. -/
def actualMixedColorPiece (a : ULift.{u} (Fin r) →₀ ℕ) :
    Submodule k (MixedTransfer.IdealReesKoszul (coloredIdeals (k := k) n E)) :=
  Grading.Piece (mixedTensorBasis (E := E) (k := k)) (fun b => b.1.1) a

theorem mixedTensorBasis_d_auxiliary (a : MixedTensorIndex.{u} E) :
    (MixedTransfer.idealReesKoszulDGA (coloredIdeals (k := k) n E)).d
      (mixedTensorBasis a) ∈ actualMixedColorPiece (E := E) (k := k) a.1.1 := by
  letI := coloredBaseOrder (r := r) (n := n)
  letI : DecidableEq (FiniteVariable.{u} n) :=
    (coloredBaseOrder (r := r) (n := n)).toDecidableEq
  rcases a with ⟨a, F⟩
  rw [show mixedTensorBasis (k := k) (a, F) =
      mixedCoefficientBasis a ⊗ₜ[k] mixedExteriorBasis r F from
    Module.Basis.tensorProduct_apply _ _ a F]
  change TensorExteriorKoszul.differential (K := k)
    (R := MixedTransfer.coefficientRees (coloredIdeals (k := k) n E))
    (M := MixedTransfer.coefficientRees (coloredIdeals (k := k) n E))
    (MixedTransfer.idealReesBaseVariable (coloredIdeals (k := k) n E))
    (mixedCoefficientBasis a ⊗ₜ[k] mixedExteriorBasis r F) ∈ _
  rw [TensorExteriorKoszul.differential_tmul]
  apply Submodule.sum_mem
  intro v _
  change (MixedTransfer.idealReesBaseVariable (coloredIdeals (k := k) n E) v *
    mixedCoefficientBasis a) ⊗ₜ[k] Simplicial.contraction v (mixedExteriorBasis r F) ∈ _
  rw [mixedCoefficientBaseVariable_basis, mixedCoefficientBasis_mul,
    Simplicial.contraction_basis]
  by_cases hv : v ∈ F
  · rw [if_pos hv, TensorProduct.tmul_smul, Units.smul_def]
    apply (actualMixedColorPiece (E := E) (k := k) a.1).toAddSubgroup.zsmul_mem
    rw [← Module.Basis.tensorProduct_apply]
    apply Submodule.subset_span
    refine ⟨(mixedCoefficientIndexAdd (mixedCoefficientBaseIndex v) a, F.erase v), ?_, rfl⟩
    simp only [mixedCoefficientIndexAdd, mixedCoefficientBaseIndex, zero_add,
      Set.mem_setOf_eq]
  · rw [if_neg hv, TensorProduct.tmul_zero]
    exact Submodule.zero_mem _

/-- **Theorem 5.5, homogeneous form.** The actual multi-Rees Koszul
homology algebra is generated by classes of cycles individually
homogeneous in one coordinate-unit auxiliary degree. -/
theorem theorem55_monomial_homogeneous_generation (hE : ColoredLatticeClosed n E) :
    Algebra.adjoin k {z | ∃ c : ULift.{u} (Fin r),
      z ∈ selectedHomologyClasses
        (MixedTransfer.idealReesKoszulDGA (coloredIdeals (k := k) n E))
        (actualMixedColorPiece (E := E) (k := k) (Finsupp.single c 1))} = ⊤ := by
  let D := MixedTransfer.idealReesKoszulDGA (coloredIdeals (k := k) n E)
  let U : Set (ULift.{u} (Fin r) →₀ ℕ) :=
    Set.range (fun c => Finsupp.single c 1)
  have he := MixedTransfer.selectedHomology_adjoin_eq_homogeneous D
    (mixedTensorBasis (E := E) (k := k)) (fun a => a.1.1) U
    (mixedTensorBasis_d_auxiliary (E := E) (k := k))
  have hs : {z | ∃ a ∈ U, z ∈ selectedHomologyClasses D
        (Grading.Piece (mixedTensorBasis (E := E) (k := k)) (fun b => b.1.1) a)} =
      {z | ∃ c : ULift.{u} (Fin r), z ∈ selectedHomologyClasses D
        (actualMixedColorPiece (E := E) (k := k) (Finsupp.single c 1))} := by
    ext z
    constructor
    · rintro ⟨a, ⟨c, rfl⟩, hz⟩
      exact ⟨c, hz⟩
    · rintro ⟨c, hz⟩
      exact ⟨Finsupp.single c 1, ⟨c, rfl⟩, hz⟩
  have ht := theorem55_monomial_generation (k := k) hE
  change Algebra.adjoin k (selectedHomologyClasses D
    (Submodule.span k (mixedTensorBasis '' {a : MixedTensorIndex.{u} E | a.1.1 ∈ U}))) = ⊤ at ht
  rw [he, hs] at ht
  exact ht

end FourPapers.Sublattice

