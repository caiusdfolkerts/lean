/- BEGIN EXACT BODY: FourPapers.Sublattice.UnitIntervalHomogeneous -/
section

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false

noncomputable section
namespace FourPapers.Sublattice
open Classical MvPolynomial CommAlg.Polymatroid
attribute [local instance] MvPolynomial.weightedGradedAlgebra
universe u
variable {d N : ℕ} {k : Type u} [CommRing k]

/-- Every term of the actual determinant has one variable from each row.
No increasing-column hypothesis is needed for homogeneity. -/
theorem facetMinor_ordinary_homogeneous (a : (Fin (d+1) → Fin N)) :
    IsWeightedHomogeneous (fun _ : FiniteVariable.{u} (UnitIntervalRows d N) => (1 : ℕ))
      (facetMinor (k := k) a) (d+1) := by
  rw [facetMinor_expansion]
  apply IsWeightedHomogeneous.sum
  intro σ _
  apply isWeightedHomogeneous_monomial
  rw [← Finsupp.degree_eq_weight_one, facetMinorTermExponent_eq_row,
    finiteRowExponent_degree]

/-- The determinantal ideal carries its actual ordinary polynomial grading. -/
theorem facetMinorIdeal_ordinary_homogeneous
    (E : Finset ((Fin (d+1) → Fin N))) :
    (facetMinorIdeal (k := k) E).IsHomogeneous
      (weightedHomogeneousSubmodule k
        (fun _ : FiniteVariable.{u} (UnitIntervalRows d N) => (1 : ℕ))) := by
  apply Ideal.homogeneous_span
  rintro f ⟨a, _, rfl⟩
  exact ⟨d+1, facetMinor_ordinary_homogeneous a⟩

/-- Every literal ideal power remains homogeneous, including the zeroth power. -/
theorem facetMinorPower_ordinary_homogeneous
    (E : Finset ((Fin (d+1) → Fin N))) (s : ℕ) :
    (facetMinorIdeal (k := k) E ^ s).IsHomogeneous
      (weightedHomogeneousSubmodule k
        (fun _ : FiniteVariable.{u} (UnitIntervalRows d N) => (1 : ℕ))) := by
  induction s with
  | zero =>
      simpa only [pow_zero, Ideal.one_eq_top] using
        (Ideal.IsHomogeneous.top (weightedHomogeneousSubmodule k
          (fun _ : FiniteVariable.{u} (UnitIntervalRows d N) => (1 : ℕ))))
  | succ s ih =>
      rw [pow_succ]
      exact ih.mul (facetMinorIdeal_ordinary_homogeneous E)

end FourPapers.Sublattice
end

#print axioms FourPapers.Sublattice.facetMinorPower_ordinary_homogeneous

end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.UnitIntervalPowers -/
section

/-!
# Every power of the actual unit-interval determinantal ideal

The first-power determinant calculation is combined with the proved symbolic
power theorem for sublattice ideals. The initial-ideal equality below concerns
the literal power of the ideal generated by the matrix determinants. Its
right-hand side is also identified with the exponent family used by the
Koszul and derived-Tor constructions.
-/

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace FourPapers.Sublattice
open Classical MvPolynomial CommAlg.Polymatroid
open scoped Pointwise
universe u
variable {d N : ℕ} {k : Type u} [Field k]

/-- The diagonal initial ideal commutes with every literal ideal power,
including power zero. No power-commutation hypothesis is assumed. -/
theorem unitInterval_power_initialIdeal
    {E : Finset ((Fin (d+1) → Fin N))}
    (hE : UnitIntervalFacetFamily E) (s : ℕ) :
    FourPapers.initialIdeal facetLexOrder (facetMinorIdeal (k := k) E ^ s) =
      finiteSublatticeIdeal (UnitIntervalRows d N) (k := k) E ^ s := by
  apply finite_initialIdeal_power_eq (UnitIntervalRows d N) facetLexOrder
    (facetMinorIdeal E) E hE.latticeClosed
  exact unitInterval_initialIdeal hE

/-- The products of the displayed determinants form an actual Gröbner basis
of each power; this is the pointwise set power of the same determinant set. -/
theorem unitInterval_power_isGroebnerBasis
    {E : Finset ((Fin (d+1) → Fin N))}
    (hE : UnitIntervalFacetFamily E) (s : ℕ) :
    facetLexOrder.IsGroebnerBasis (facetMinorGenerators (k := k) E ^ s)
      (facetMinorIdeal E ^ s) := by
  apply FourPapers.products_isGroebnerBasis_of_initial_power facetLexOrder
    (facetMinorGenerators E) (facetMinorIdeal E)
    (unitInterval_minors_isGroebnerBasis hE) s
  rw [unitInterval_power_initialIdeal hE s]
  congr 1
  exact (unitInterval_initialIdeal hE).symm

/-- The actual initial ideal of the determinantal power equals the exact
monomial ideal appearing in the all-power chain decomposition. -/
theorem unitInterval_power_initialIdeal_monomialFamily
    {E : Finset ((Fin (d+1) → Fin N))}
    (hE : UnitIntervalFacetFamily E) (s : ℕ) :
    FourPapers.initialIdeal facetLexOrder (facetMinorIdeal (k := k) E ^ s) =
      monomialIdeal k
        (exponentPowerFamily (finiteRowFamily (UnitIntervalRows d N) E) s) := by
  rw [unitInterval_power_initialIdeal hE s, finitePowerFamily_ideal]

end FourPapers.Sublattice
end

#print axioms FourPapers.Sublattice.unitInterval_power_initialIdeal
#print axioms FourPapers.Sublattice.unitInterval_power_isGroebnerBasis

end
end

/- BEGIN EXACT BODY: FourPapers.Sublattice.UnitIntervalIdealData -/
section

/-!
# The literal unit-interval determinantal powers and their graded homology

All fields of the Gröbner data are supplied by the determinant and symbolic
power proofs. In particular the standard-monomial equality and the actual
initial ideal are conclusions, not hypotheses added to Theorem 6.5.
-/

section
set_option autoImplicit false
set_option Elab.async false
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace FourPapers.Sublattice
open Classical MvPolynomial CommAlg.Polymatroid
open scoped Pointwise
universe u
variable {d N : ℕ} {k : Type u} [Field k]

theorem unitInterval_power_unitLeading
    (E : Finset ((Fin (d+1) → Fin N))) (s : ℕ) :
    ∀ g ∈ facetMinorGenerators (k := k) E ^ s, g ≠ 0 →
      IsUnit (facetLexOrder.leadingCoeff g) := by
  intro g _ hg
  exact facetLexOrder.isUnit_leadingCoeff.mpr hg

theorem unitInterval_power_standardMonomials
    {E : Finset ((Fin (d+1) → Fin N))}
    (hE : UnitIntervalFacetFamily E) (s : ℕ)
    (a : Exponent (FiniteVariable.{u} (UnitIntervalRows d N))) :
    a ∈ facetLexOrder.standardMonomials (facetMinorIdeal (k := k) E ^ s) ↔
      QuotientAllowed (exponentPowerFamily
        (finiteRowFamily (UnitIntervalRows d N) E) s) a := by
  have h := monomial_mem_initial_iff_not_standard facetLexOrder
    (facetMinorIdeal (k := k) E ^ s) (facetMinorGenerators E ^ s)
    (unitInterval_power_isGroebnerBasis hE s) (unitInterval_power_unitLeading E s) a
  change monomial a (1 : k) ∈
    FourPapers.initialIdeal facetLexOrder (facetMinorIdeal E ^ s) ↔ _ at h
  rw [unitInterval_power_initialIdeal_monomialFamily hE s, monomial_mem_iff] at h
  simpa only [QuotientAllowed, not_not] using (not_congr h).symm

def unitIntervalPowerQuotientData
    {E : Finset ((Fin (d+1) → Fin N))}
    (hE : UnitIntervalFacetFamily E) (s : ℕ) :
    QuotientGroebnerData (FiniteVariable.{u} (UnitIntervalRows d N)) k where
  order := facetLexOrder
  ideal := facetMinorIdeal E ^ s
  generators := facetMinorGenerators E ^ s
  groebner := unitInterval_power_isGroebnerBasis hE s
  unitLeading := unitInterval_power_unitLeading E s
  family := exponentPowerFamily (finiteRowFamily (UnitIntervalRows d N) E) s
  standard := unitInterval_power_standardMonomials hE s

/-- The ordinary graded Betti number of the actual determinant-ideal power,
computed from its genuine ordinary Koszul subcomplex. -/
def unitIntervalBettiNumber
    {E : Finset ((Fin (d+1) → Fin N))}
    (hE : UnitIntervalFacetFamily E) (s q p : ℕ) : ℕ :=
  Module.finrank k (actualIdealOrdinaryHomology
    (unitIntervalPowerQuotientData (k := k) hE s)
    (facetMinorPower_ordinary_homogeneous E s) q p)

end FourPapers.Sublattice
end

#print axioms FourPapers.Sublattice.unitInterval_power_standardMonomials

end
end


