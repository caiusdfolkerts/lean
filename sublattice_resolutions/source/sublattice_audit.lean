    `FourPapers.PolynomialRegularSubstitution.monomialResolution_finite,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_zero_above,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_minimal,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_regraded,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_entry,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_entry_zero_of_not_le,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_regraded_degree,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_augmentation_entry,
    `FourPapers.PolynomialRegularSubstitution.monomialResolution_augmentation_regraded,
    `FourPapers.Sublattice.corollary58_powerFreeResolution,
    `FourPapers.Sublattice.substitutedPowerResolutionBasis,
    `FourPapers.Sublattice.substitutedPowerResolution_free,
    `FourPapers.Sublattice.substitutedPowerResolution_finite,
    `FourPapers.Sublattice.corollary58_powerFreeResolution_minimal,
    `FourPapers.Sublattice.corollary58_powerFreeResolution_regraded,
    `FourPapers.Sublattice.corollary58_powerFreeResolution_degree,
    `FourPapers.Sublattice.corollary58_powerFreeResolution_bounded,
    `FourPapers.Sublattice.corollary58_powerFreeResolution_augmentation_regraded,
    `FourPapers.Sublattice.corollary58_powerFreeResolution_shift_multiplicity,
    `FourPapers.Sublattice.mixedBetti_admissible,
    `FourPapers.Sublattice.sameColorChainCoefficientFamily_ideal,
    `FourPapers.Sublattice.finiteReesPresentationWeight_admissible,
    `FourPapers.Sublattice.finiteSortingRelation_leading,
    `FourPapers.Sublattice.finiteCoefficientRelation_leading,
    `FourPapers.Sublattice.finiteRelationStandard_iff,
    `FourPapers.Sublattice.finite_sublattice_rees_groebnerBasis,
    `FourPapers.Sublattice.finite_sublattice_rees_kernel,
    `FourPapers.Sublattice.finite_sublattice_rees_initialIdeal,
    `FourPapers.Sublattice.finiteReesRelations_homogeneous,
    `FourPapers.Sublattice.proposition22]
  for name in roots do
    unless projectInfo.contains name do
      throwError "Requested root is missing from the selected checked project modules: {name}"
  -- Compiler-generated runtime implementations can be unsafe even when their
  -- associated theorem has a safe kernel term. They are permitted only when
  -- unreachable through the types and values of the requested kernel roots.
  let mut pending := roots
  let mut reachable : NameSet := {}
  while !pending.isEmpty do
    let name := pending.back!
    pending := pending.pop
    unless reachable.contains name do
      reachable := reachable.insert name
      if let some ci := projectInfo.find? name then
        if ci.isUnsafe || ci.isPartial then
          throwError "Unsafe or partial project kernel dependency: {name}"
        for dependency in ci.getUsedConstantsAsSet.toArray do
          pending := pending.push dependency
  let runtimeOnly := constants.filterMap fun (name, ci) =>
    if ci.isUnsafe || ci.isPartial then some name.toString else none
  let mut rootInfo : Array Json := #[]
  for name in roots do
    let some ci := env.checked.get.find? name | throwError "Missing checked root: {name}"
    let axioms ← collectAxioms name
    for ax in axioms do
      unless allowed.contains ax do
        throwError "Unapproved transitive axiom {ax} in {name}"
    if ci.type.hasMVar || ci.type.hasFVar then
      throwError "Requested root has an open kernel type: {name}"
    liftIO <| IO.eprintln s!"KERNEL_AUDIT_PHASE: root {rootInfo.size + 1}/{roots.size}: {name}"
    liftIO do
      (← IO.getStderr).flush
    let ty ← liftTermElabM <| PrettyPrinter.ppExpr ci.type
    -- Export the exact checked kernel expression with sharing. The helper
    -- serializes and reparses JSON, reconstructs Expr, and checks structural
    -- equality before it can return a complete representation.
    let exactType ← match AuditTypeDag.encodeCheckedType ci.name ci.levelParams ci.type with
      | .ok data => pure data
      | .error message => throwError "Exact checked-type export failed for {name}: {message}"
    let explicitType := exactType.pretty
    rootInfo := rootInfo.push <| Json.mkObj [
      ("name", toJson name.toString),
      ("module", toJson (moduleOf name).toString),
      ("type", toJson ty.pretty),
      ("type_explicit", toJson explicitType),
      ("type_explicit_format", toJson AuditTypeDag.formatVersion),
      ("type_explicit_complete", toJson true),
      ("universe_parameters", toJson (ci.levelParams.map Name.toString)),
      ("axioms", toJson (axioms.qsort Name.lt |>.map Name.toString))]
  liftIO <| IO.eprintln "KERNEL_AUDIT_PHASE: boundary-leaf audit"
  liftIO do
    (← IO.getStderr).flush
  let mut leafInfo : Array Json := #[]
  for name in leaves.toArray.qsort Name.lt do
    unless (env.checked.get.find? name).isSome do
      throwError "Boundary dependency absent from checked environment: {name}"
    let axioms ← collectAxioms name
    for ax in axioms do
      unless allowed.contains ax do
        throwError "Unapproved transitive axiom {ax} in boundary dependency {name}"
    leafInfo := leafInfo.push <| Json.mkObj [
      ("name", toJson name.toString),
      ("module", toJson (moduleOf name).toString),
      ("axioms", toJson (axioms.qsort Name.lt |>.map Name.toString))]
  let repeatedEntries := constants.filterMap fun (name, _) =>
    let entries := (moduleEntries.find? name).getD #[]
    if entries.size > 1 then some <| Json.mkObj [
      ("name", toJson name.toString),
      ("indexed_module", toJson (moduleOf name).toString),
      ("indexed_modules", toJson (entries.map Name.toString)),
      ("matching_checked_body_modules", toJson
        (((matchingBodyModules.find? name).getD #[]).map Name.toString))]
    else none
  let graph := Json.mkObj [
    ("format", toJson "Import-aware checked project dependencies, version 4"),
    ("explicit_type_format", toJson AuditTypeDag.formatVersion),
    ("audit_module", toJson env.mainModule.toString),
    ("selected_module_prefixes", toJson modulePrefixes),
    ("loaded_project_modules", toJson (loadedProjectModules.qsort Name.lt |>.map Name.toString)),
    ("project_modules", toJson (projectModules.toArray.qsort Name.lt |>.map Name.toString)),
    ("repeated_module_entries", Json.arr repeatedEntries),
    ("roots", Json.arr rootInfo),
    ("runtime_only_implementations", toJson runtimeOnly),
    ("nodes", Json.arr nodes),
    ("imported_boundary_leaves", Json.arr leafInfo)]
  liftIO <| IO.FS.createDirAll ".lake/reports/audit"
  liftIO <| IO.eprintln "KERNEL_AUDIT_PHASE: final serialization"
  liftIO do
    (← IO.getStderr).flush
  liftIO <| IO.FS.writeFile ".lake/reports/audit/kernel-dependencies.json" (graph.pretty ++ "\n")
  logInfo m!"KERNEL_AUDIT_OK {constants.size} project declarations; {roots.size} roots; {projectModules.size} project modules"
