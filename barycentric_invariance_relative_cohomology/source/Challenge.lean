variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
/-- Literal FourPapers.Universal.IsSimplicialPoset; source theorem12.lean:5908. -/
def IsSimplicialPoset (P : Type*) [PartialOrder P] [OrderBot P] : Prop :=
  ∀ p : P, ∃ n : ℕ, Nonempty (Set.Iic p ≃o Finset (Fin n))
/-- Literal FourPapers.Universal.faceVertices; source theorem12.lean:5912. -/
def faceVertices (p : P) : Finset P :=
  univ.filter fun a => IsAtom a ∧ a ≤ p
/-- Literal FourPapers.Universal.faceRank; source theorem12.lean:6024. -/
def faceRank (p : P) : ℕ := (faceVertices p).card
/-- Literal FourPapers.Universal.faceRank_bot; source theorem12.lean:6026. -/
@[simp] theorem faceRank_bot : faceRank (⊥ : P) = 0 := by sorry
/-- Literal FourPapers.Universal.faceRank_strictMono; source theorem12.lean:6028. -/
theorem faceRank_strictMono (hs : IsSimplicialPoset P) :
    StrictMono (faceRank : P → ℕ) := by sorry
end
