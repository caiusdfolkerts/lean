module

public import higher_specht.verified.remaining04_geometry_complete

@[expose] public section
noncomputable section

open TauCeti MvPolynomial
open scoped BigOperators

namespace HigherSpecht

/-- The Specht representation of this shape, presented as the left ideal
generated by the row symmetrizer times the column antisymmetrizer. -/
abbrev paperYoungIdealRepresentation {n : ℕ} (part : n.Partition)
    (T : YoungTableau (YoungDiagram.ofPartition part)) :=
  Representation.ofModule' (k := ℂ) (G := Equiv.Perm (Fin n))
    (Ideal.span {(MonoidAlgebra.domCongr ℂ ℂ
        (finCongr (YoungDiagram.card_ofPartition part)).permCongrHom
        (TauCeti.YoungTableau.youngSymmetrizerOver ℂ T))} :
      Ideal (MonoidAlgebra ℂ (Equiv.Perm (Fin n))))

/-- The ordinary apolar pairing written in monomial coefficients. -/
def apolarCoefficientPairing {n : ℕ} (f p : PolynomialRing n ℂ) : ℂ :=
  ∑ a ∈ f.support, f.coeff a * (p.coeff a * ((∏ j, (a j).factorial : ℕ) : ℂ))

private theorem apolarCoefficientPairing_eq {n : ℕ} (f p : PolynomialRing n ℂ) :
    apolarCoefficientPairing f p = ordinaryApolarFunctional p f := by
  unfold apolarCoefficientPairing
  conv_rhs => rw [MvPolynomial.as_sum f]
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro a ha
  have hm : MvPolynomial.monomial a (f.coeff a) =
      f.coeff a • MvPolynomial.monomial a (1 : ℂ) := by
    rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  rw [hm, map_smul, ordinaryApolar_monomial] <;> rfl

theorem springer_literal_column_witness {n : ℕ} (hn : 0 < n)
    (z : SpringerCommonIndex n) (T : YoungTableau (YoungDiagram.ofPartition z.1)) :
    springerCommonHarmonicVectorWithTableau hn z T =
      MvPolynomial.rename (finCongr (YoungDiagram.card_ofPartition z.1))
        (adjointYoungApply T
          (normalizedOrdinaryDerivative (insertionRejectionExponent z.2 T)
            (columnWitness (insertionFilling z.2 T).toEmbedding 1))) := by
  rw [springerCommonHarmonicVectorWithTableau_literal_formula,
    higherSpechtWitness_eq_columnWitness]

/-- The same irreducible Springer witnesses decompose the entire coinvariant
harmonic space and give each Springer harmonic space by its admissible indices. -/
theorem springer_harmonics_full_decomposition (n : ℕ) (hn : 0 < n)
    (T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part)) :
    ∃ S : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part),
    ∃ W : SpringerCommonIndex n → Subrepresentation (polynomialRepresentation ℂ n),
      (∀ z, (W z).toSubmodule =
          cyclicPolynomialCopy (springerCommonHarmonicVectorWithTableau hn z (T z.1)) ∧
        Nonempty (Representation.Equiv (paperYoungIdealRepresentation z.1 (S z.1))
          (W z).toRepresentation) ∧
        (W z).toRepresentation.IsIrreducible ∧
        (W z).toSubmodule ≤ homogeneousSubmodule (Fin n) ℂ (cochargeDegree z.2)) ∧
      iSupIndep (fun z => (W z).toSubmodule) ∧
      (∀ p : PolynomialRing n ℂ,
        (∀ f ∈ untruncatedIdeal ℂ n (columnPartition n), apolarCoefficientPairing f p = 0) ↔
        p ∈ ⨆ z : SpringerCommonIndex n, (W z).toSubmodule) ∧
      ∀ (mu : YoungDiagram) (hmu : mu.card = n) (p : PolynomialRing n ℂ),
        (∀ f ∈ untruncatedIdeal ℂ n mu, apolarCoefficientPairing f p = 0) ↔
        p ∈ ⨆ z : {z : SpringerCommonIndex n // CatDominates z.2 mu}, (W z.val).toSubmodule := by
  classical
  let S : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part) :=
    fun part => (StandardYoungTableau.rowSuperstandard _).toTableau
  obtain ⟨hcopy, hind, hmaster, hdecomp⟩ := corollary_5_5_any_right_tableaux n hn T
  let W : SpringerCommonIndex n → Subrepresentation (polynomialRepresentation ℂ n) :=
    fun z => (Classical.choose (hcopy z).1).range
  have hW (z) : (W z).toSubmodule = springerCommonHarmonicCopyWithTableau hn z (T z.1) :=
    (Classical.choose_spec (hcopy z).1).2
  refine ⟨S, W, ?_, ?_, ?_, ?_⟩
  · intro z
    let f := Classical.choose (hcopy z).1
    let E := f.equivOfRange (Classical.choose_spec (hcopy z).1).1 (P := W z) rfl
    letI := complexYoungIdealRepresentation_isIrreducible z.1
    exact ⟨hW z, ⟨E⟩, irreducible_of_representation_equiv E,
      by simpa only [hW] using (hcopy z).2⟩
  · simpa only [hW] using hind
  · intro p
    simpa only [apolarCoefficientPairing_eq, ← mem_ordinaryHarmonics_iff_apolar, hW] using
      (show p ∈ ordinaryHarmonics (untruncatedIdeal ℂ n (columnPartition n)) ↔
        p ∈ ⨆ z : SpringerCommonIndex n, springerCommonHarmonicCopyWithTableau hn z (T z.1)
        from by rw [hmaster])
  · intro mu hmu p
    simpa only [apolarCoefficientPairing_eq, ← mem_ordinaryHarmonics_iff_apolar, hW] using
      (show p ∈ ordinaryHarmonics (untruncatedIdeal ℂ n mu) ↔
        p ∈ ⨆ z : {z : SpringerCommonIndex n // CatDominates z.2 mu},
          springerCommonHarmonicCopyWithTableau hn z.val (T z.val.1)
        from by rw [hdecomp mu hmu])

end HigherSpecht
