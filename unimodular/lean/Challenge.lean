module
public import Mathlib

/-!
# Complete fans as degree-one nonnegative cycles

Theorem1.1 / Theorem3.1 of Caius Folkerts, *Unimodular configurations and
complete fans*: the exact full allowed-block facet equations, automatic
zero-one coefficients, and connectivity by Graver-primitive relations.
The statement uses actual finite rational salient fans; no fan condition or
conclusion is placed inside a substitute predicate. All custom mathematical
definitions are inlined from the substantive source, with original names.
The source's choices of facet normals and interior points are retained.
This group does not yet cover the paper's deeply monotone classification,
extremal ray theorem, section rings, or explicit exceptional examples.
-/

@[expose] public noncomputable section
open scoped Pointwise Topology BigOperators
open Set
namespace PalomarFans.Toric
section Lattices
variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
/-- The lattice map exhibits a finite free integral module and its real scalar extension. -/
structure IsIntegralLattice (i : N →+ V) : Prop where
  /-- The module of integral vectors is free. -/
  free : Module.Free ℤ N
  /-- The module of integral vectors is finitely generated. -/
  finite : Module.Finite ℤ N
  /-- Extending scalars from `ℤ` to `ℝ` along `i` gives the ambient real vector space. -/
  isBaseChange : IsBaseChange ℝ i.toIntLinearMap
end Lattices
section Rational
variable {N V : Type*} [AddZeroClass N] [AddCommMonoid V] [Module ℝ V]
/-- A cone generated by the images of finitely many integral vectors. -/
def IsLatticeRational (i : N →+ V) (σ : PointedCone ℝ V) : Prop :=
  ∃ s : Finset N, σ = PointedCone.hull ℝ (i '' (s : Set N))
theorem isLatticeRational_iff {N V : Type*} [AddZeroClass N] [AddCommMonoid V]
    [Module ℝ V] {i : N →+ V} {σ : PointedCone ℝ V} :
    IsLatticeRational i σ ↔ ∃ s : Finset N, σ = PointedCone.hull ℝ (i '' (s : Set N)) := Iff.rfl
theorem IsLatticeRational.fg {i : N →+ V} {σ : PointedCone ℝ V}
    (h : IsLatticeRational i σ) : σ.FG := by
  obtain ⟨s, rfl⟩ := h
  exact Submodule.fg_span ((s : Set N).toFinite.image i)
end Rational
section Toric
variable {N V : Type*} [AddZeroClass N] [AddCommGroup V] [Module ℝ V]
/-- A finitely generated lattice-rational cone containing no line. -/
structure IsToricCone (i : N →+ V) (σ : PointedCone ℝ V) : Prop where
  /-- A toric cone is generated by the images of finitely many lattice vectors. -/
  rational : IsLatticeRational i σ
  /-- A toric cone contains no line. -/
  salient : (σ : ConvexCone ℝ V).Salient
end Toric
section Fans
variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
/-- A finite rational salient fan, closed under faces, with pairwise face intersections. -/
structure Fan (i : N →+ V) where
  /-- The ambient map of integral vectors is an integral lattice. -/
  lattice : IsIntegralLattice i
  /-- The cones of the fan. -/
  cones : Set (PointedCone ℝ V)
  /-- A fan has finitely many cones. -/
  finite_cones : cones.Finite
  /-- Every cone of a fan is a toric cone. -/
  isToricCone : ∀ ⦃σ⦄, σ ∈ cones → IsToricCone i σ
  /-- The cones of a fan are closed under passing to faces. -/
  mem_of_isFaceOf : ∀ ⦃σ τ⦄, σ ∈ cones → τ.IsFaceOf σ → τ ∈ cones
  /-- The intersection of two cones of a fan is a face of the first one. Exchanging the two cones
  gives the same statement for the second one, so only this half is a field. -/
  inf_isFaceOf_left : ∀ ⦃σ τ⦄, σ ∈ cones → τ ∈ cones → (σ ⊓ τ).IsFaceOf σ
namespace Fan
variable {i : N →+ V} (Φ : Fan i)
/-- The union of the actual cones of the fan. -/
def support : Set V := ⋃ σ ∈ Φ.cones, (σ : Set V)
/-- The actual cone union fills the ambient real vector space. -/
def IsComplete : Prop := Φ.support = Set.univ
end Fan
end Fans
end PalomarFans.Toric
namespace PalomarFans.ConeInterior
variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
theorem interior_nonempty_of_span_eq_top {C : PointedCone ℝ V}
    (hC : Submodule.span ℝ (C : Set V) = ⊤) : (interior (C : Set V)).Nonempty := by
  apply (C : ConvexCone ℝ V).convex.interior_nonempty_iff_affineSpan_eq_top.2
  change affineSpan ℝ (C : Set V) = ⊤
  rw [affineSpan_eq_span_of_zero_mem (subset_affineSpan ℝ (C : Set V) C.zero_mem), hC]
  rfl
theorem exists_normal (L : Submodule ℝ V)
    (hL : Module.finrank ℝ L + 1 = Module.finrank ℝ V) :
    ∃ f : V →ₗ[ℝ] ℝ, f ≠ 0 ∧ LinearMap.ker f = L := by
  have hne : L ≠ ⊤ := by
    intro he
    rw [he, finrank_top] at hL
    omega
  obtain ⟨f, hf, hLf⟩ := L.exists_le_ker_of_lt_top (lt_top_iff_ne_top.2 hne)
  refine ⟨f, hf, (Submodule.eq_of_le_of_finrank_eq hLf ?_).symm⟩
  have hk := Module.Dual.finrank_ker_add_one_of_ne_zero hf
  omega
end PalomarFans.ConeInterior
namespace PalomarFans.FacetLine
/-- The integer-valued sign of a real scalar. -/
noncomputable def signZ (a : ℝ) : ℤ := if 0 < a then 1 else if a < 0 then -1 else 0
end PalomarFans.FacetLine
namespace PalomarFans.CycleDegree
variable {I V : Type*} [Fintype I] [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
/-- An indexed family of full-dimensional finitely generated pointed cones. -/
structure FullCones (I V : Type*) [NormedAddCommGroup V] [NormedSpace ℝ V] where
  cone : I → PointedCone ℝ V
  fg : ∀ i, (cone i).FG
  full : ∀ i, Submodule.span ℝ (cone i : Set V) = ⊤
namespace FullCones
variable (S : FullCones I V)
/-- A face of some cone of the family. -/
def IsFace (F : PointedCone ℝ V) : Prop := ∃ i, F.IsFaceOf (S.cone i)
/-- A codimension-one face of some cone of the family. -/
def Facet := {F : PointedCone ℝ V // S.IsFace F ∧
  Module.finrank ℝ (Submodule.span ℝ (F : Set V)) + 1 = Module.finrank ℝ V}
/-- The original chosen interior point of each full-dimensional cone. -/
noncomputable def center (i : I) : V :=
  (ConeInterior.interior_nonempty_of_span_eq_top (S.full i)).choose
/-- The original chosen nonzero normal to the span of a facet. -/
noncomputable def normal (F : S.Facet) : V →ₗ[ℝ] ℝ :=
  (ConeInterior.exists_normal (Submodule.span ℝ (F.1 : Set V)) F.2.2).choose
/-- The signed side of each facet at the original interior point, zero off its cofaces. -/
noncomputable def boundary (F : S.Facet) (i : I) : ℤ := by
  classical
  exact if F.1.IsFaceOf (S.cone i) then FacetLine.signZ (S.normal F (S.center i)) else 0
end FullCones
end PalomarFans.CycleDegree
namespace PalomarFans.AllowedBlocks
open PalomarFans.Toric
attribute [local instance] Classical.propDecidable
attribute [local instance] Classical.propDecidable
variable {E N V : Type*} [Fintype E] [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] (ι : N →+ V) (u : E → N)
/-- The nonnegative ray through a vector. -/
abbrev ray (v : V) : PointedCone ℝ V := PointedCone.hull ℝ {v}
/-- The actual nonnegative cone generated by a finite block of prescribed rays. -/
noncomputable def blockCone (s : Finset E) : PointedCone ℝ V :=
  PointedCone.hull ℝ ((fun e => ι (u e)) '' (s : Set E))
/-- Salience, exactly the displayed extreme rays, and no other prescribed ray in the cone. -/
def Allowed (s : Finset E) : Prop :=
  (blockCone ι u s : ConvexCone ℝ V).Salient ∧
  (∀ R : PointedCone ℝ V,
    (R.IsFaceOf (blockCone ι u s) ∧ Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1) ↔
      ∃ e ∈ s, R = ray (ι (u e))) ∧
  (∀ e, ι (u e) ∈ blockCone ι u s ↔ e ∈ s)
/-- The allowed blocks spanning the full ambient vector space. -/
def FullBlock := {s : Finset E // Allowed ι u s ∧
  Submodule.span ℝ (blockCone ι u s : Set V) = ⊤}
/-- Finite allowed blocks inject into the actual finite power set; separately compared. -/
theorem fullBlock_finite : Finite (FullBlock ι u) :=
  Finite.of_injective (fun s : FullBlock ι u => s.val) Subtype.val_injective
noncomputable instance : Fintype (FullBlock ι u) :=
  @Fintype.ofFinite _ (fullBlock_finite ι u)
theorem blockCone_isLatticeRational (s : Finset E) : IsLatticeRational ι (blockCone ι u s) := by
  classical
  rw [isLatticeRational_iff]
  refine ⟨s.image u, ?_⟩
  simp [blockCone, Set.image_image]
/-- The actual full block cones and their finite generation/spanning proofs. -/
noncomputable def family : CycleDegree.FullCones (FullBlock ι u) V where
  cone s := blockCone ι u s.1
  fg s := (blockCone_isLatticeRational ι u s.1).fg
  full s := s.2.2
/-- Exactly the displayed rays are one-dimensional cones of the actual fan. -/
def HasRays (Φ : Fan ι) : Prop := ∀ R : PointedCone ℝ V,
  (R ∈ Φ.cones ∧ Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1) ↔
    ∃ e, R = ray (ι (u e))
/-- All allowed codimension-one blocks, including rows with no full coface. -/
def FacetBlock := {s : Finset E // Allowed ι u s ∧
  Module.finrank ℝ (Submodule.span ℝ (blockCone ι u s : Set V)) + 1 = Module.finrank ℝ V}
/-- Finite allowed blocks inject into the actual finite power set; separately compared. -/
theorem facetBlock_finite : Finite (FacetBlock ι u) :=
  Finite.of_injective (fun s : FacetBlock ι u => s.val) Subtype.val_injective
noncomputable instance : Fintype (FacetBlock ι u) :=
  @Fintype.ofFinite _ (facetBlock_finite ι u)
/-- The allowed facet block bounds some full allowed cone. -/
def HasFullCoface (b : FacetBlock ι u) : Prop :=
  ∃ s : FullBlock ι u, (blockCone ι u b.1).IsFaceOf (blockCone ι u s.1)
/-- The same actual geometric facet indexed in the full-cone family. -/
noncomputable def facetIndex (b : FacetBlock ι u) (h : HasFullCoface ι u b) : (family ι u).Facet :=
  ⟨blockCone ι u b.1, h, b.2.2⟩
/-- The full allowed-facet matrix, retaining zero rows without full cofaces. -/
noncomputable def boundary (b : FacetBlock ι u) (s : FullBlock ι u) : ℤ :=
  if h : HasFullCoface ι u b then (family ι u).boundary (facetIndex ι u b h) s else 0
/-- The integer kernel equations for every row of the actual facet matrix. -/
def BoundaryCycle (c : FullBlock ι u → ℤ) : Prop :=
  ∀ b : FacetBlock ι u, ∑ s, boundary ι u b s * c s = 0
/-- The interior indicator at the displayed generic direction. -/
noncomputable def degreeRow (w : V) (s : FullBlock ι u) : ℤ :=
  if w ∈ interior (blockCone ι u s.1 : Set V) then 1 else 0
/-- The full facet-equation coordinates and generic-direction degree coordinate. -/
noncomputable def equationFn (w : V) (c : FullBlock ι u → ℤ) :
    (FacetBlock ι u → ℤ) × ℤ :=
  (fun b => ∑ s, boundary ι u b s * c s, ∑ s, degreeRow ι u w s * c s)
/-- The full displayed equation function preserves zero; separately compared. -/
theorem equationFn_zero (w : V) : equationFn ι u w 0 = 0 := by
  apply Prod.ext
  · funext b
    simp [equationFn]
  · simp [equationFn]
/-- The full displayed equation function preserves addition; separately compared. -/
theorem equationFn_add (w : V) (c d : FullBlock ι u → ℤ) :
    equationFn ι u w (c + d) = equationFn ι u w c + equationFn ι u w d := by
  apply Prod.ext
  · funext b
    simp [equationFn, mul_add, Finset.sum_add_distrib]
  · simp [equationFn, mul_add, Finset.sum_add_distrib]
/-- The actual full allowed-facet equations with their generic-direction degree row. -/
noncomputable def equationMap (w : V) :
    (FullBlock ι u → ℤ) →+ ((FacetBlock ι u → ℤ) × ℤ) where
  toFun := equationFn ι u w
  map_zero' := equationFn_zero ι u w
  map_add' := equationFn_add ι u w
/-- Actual complete fans with exactly the prescribed rays. -/
def FanOnRays := {Φ : Fan ι // Φ.IsComplete ∧ HasRays ι u Φ}
/-- The zero-one indicator of each full block cone in the actual fan. -/
noncomputable def indicator (Φ : FanOnRays ι u) : FullBlock ι u → ℤ :=
  fun s => if blockCone ι u s.1 ∈ Φ.1.cones then 1 else 0
/-- Every intermediate full cone occurs in one of the two endpoint fans. -/
def UsesEndpointCones (Φ Ψ Θ : FanOnRays ι u) : Prop :=
  ∀ C ∈ Θ.1.cones, Submodule.span ℝ (C : Set V) = ⊤ → C ∈ Φ.1.cones ∨ C ∈ Ψ.1.cones
end PalomarFans.AllowedBlocks
namespace PalomarFans.RayHyperplanes
variable {E V : Type*} [Fintype E] [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
/-- The real linear span of a finite prescribed ray subconfiguration. -/
def raySpan (v : E → V) (s : Finset E) : Submodule ℝ V :=
  Submodule.span ℝ (v '' (s : Set E))
/-- Avoid every hyperplane spanned by a prescribed ray subconfiguration. -/
def GenericDirection (v : E → V) (w : V) : Prop := ∀ s : Finset E,
  Module.finrank ℝ (raySpan v s) + 1 = Module.finrank ℝ V → w ∉ raySpan v s
end PalomarFans.RayHyperplanes
namespace PalomarFans.Graver
variable {ι : Type*} [Fintype ι]
/-- Coordinatewise domination with matching signs, expressed by positive and negative parts. -/
def ConformalLE (g h : ι → ℤ) : Prop :=
  ∀ i, (g i).toNat ≤ (h i).toNat ∧ (-g i).toNat ≤ (-h i).toNat
/-- A nonzero subgroup vector with no distinct nonzero conformally smaller subgroup vector. -/
def Primitive (L : AddSubgroup (ι → ℤ)) (g : ι → ℤ) : Prop :=
  g ∈ L ∧ g ≠ 0 ∧
    ∀ h ∈ L, h ≠ 0 → ConformalLE h g → h = g
end PalomarFans.Graver
namespace PalomarFans.AllowedBlocks
open PalomarFans.Toric
attribute [local instance] Classical.propDecidable
variable {E N V : Type*} [Fintype E] [AddCommGroup N] [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V] (ι : N →+ V) (u : E → N)
/-- The exact complete-fan classification or its signed-degree/primitive-connectivity consequence. -/
theorem theorem_3_1 (hι : IsIntegralLattice ι) (hnz : ∀ e, ι (u e) ≠ 0)
    (hpos : PointedCone.hull ℝ (Set.range (fun e => ι (u e))) = ⊤)
    (c : FullBlock ι u → ℤ) {w : V}
    (hw : RayHyperplanes.GenericDirection (fun e => ι (u e)) w) :
    ((∀ s, 0 ≤ c s) ∧ BoundaryCycle ι u c ∧ (∑ s, degreeRow ι u w s * c s) = 1) ↔
      ∃ Φ : Fan ι, Φ.IsComplete ∧ HasRays ι u Φ ∧
        (∀ s, c s = if blockCone ι u s.1 ∈ Φ.cones then 1 else 0) := by sorry
/-- The exact complete-fan classification or its signed-degree/primitive-connectivity consequence. -/
theorem theorem_3_1_zero_one (hnz : ∀ e, ι (u e) ≠ 0)
    (hpos : PointedCone.hull ℝ (Set.range (fun e => ι (u e))) = ⊤)
    (c : FullBlock ι u → ℤ) {w : V}
    (hw : RayHyperplanes.GenericDirection (fun e => ι (u e)) w)
    (hc0 : ∀ s, 0 ≤ c s) (hc : BoundaryCycle ι u c)
    (hd : (∑ s, degreeRow ι u w s * c s) = 1) :
    ∀ s, c s = 0 ∨ c s = 1 := by sorry
/-- The exact complete-fan classification or its signed-degree/primitive-connectivity consequence. -/
theorem signed_degree_independent (hnz : ∀ e, ι (u e) ≠ 0)
    (hpos : PointedCone.hull ℝ (Set.range (fun e => ι (u e))) = ⊤)
    (c : FullBlock ι u → ℤ) (hc : BoundaryCycle ι u c) {w z : V}
    (hw : RayHyperplanes.GenericDirection (fun e => ι (u e)) w)
    (hz : RayHyperplanes.GenericDirection (fun e => ι (u e)) z) :
    (∑ s, degreeRow ι u w s * c s) = ∑ s, degreeRow ι u z s * c s := by sorry
/-- The exact complete-fan classification or its signed-degree/primitive-connectivity consequence. -/
theorem theorem_1_1_connectivity (hι : IsIntegralLattice ι) (hnz : ∀ e, ι (u e) ≠ 0)
    (hpos : PointedCone.hull ℝ (Set.range (fun e => ι (u e))) = ⊤)
    {w : V} (hw : RayHyperplanes.GenericDirection (fun e => ι (u e)) w)
    (Φ Ψ : FanOnRays ι u) :
    ∃ G : Finset (FullBlock ι u → ℤ),
      (∀ g, g ∈ G ↔ Graver.Primitive (equationMap ι u w).ker g) ∧
      Relation.ReflTransGen
        (fun A B : FanOnRays ι u =>
          indicator ι u B - indicator ι u A ∈ G ∧
          UsesEndpointCones ι u Φ Ψ A ∧ UsesEndpointCones ι u Φ Ψ B) Φ Ψ := by sorry
end PalomarFans.AllowedBlocks
