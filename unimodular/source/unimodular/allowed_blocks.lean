module

public import Unimodular.FanCycle

@[expose] public section

open scoped Pointwise Topology BigOperators
open Set TauCeti.Toric

namespace Unimodular.AllowedBlocks

attribute [local instance] Classical.propDecidable

variable {E N V : Type*} [Fintype E] [AddCommGroup N]
  [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
  (ι : N →+ V) (u : E → N)

abbrev ray (v : V) : PointedCone ℝ V := PointedCone.hull ℝ {v}

noncomputable def blockCone (s : Finset E) : PointedCone ℝ V :=
  PointedCone.hull ℝ ((fun e => ι (u e)) '' (s : Set E))

/-- Exactly the three allowed-block conditions in §3.1: pointedness, the complete set of
extreme rays, and absence of any further prescribed ray in the cone. -/
def Allowed (s : Finset E) : Prop :=
  (blockCone ι u s : ConvexCone ℝ V).Salient ∧
  (∀ R : PointedCone ℝ V,
    (R.IsFaceOf (blockCone ι u s) ∧ Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1) ↔
      ∃ e ∈ s, R = ray (ι (u e))) ∧
  (∀ e, ι (u e) ∈ blockCone ι u s ↔ e ∈ s)

def FullBlock := {s : Finset E // Allowed ι u s ∧
  Submodule.span ℝ (blockCone ι u s : Set V) = ⊤}

noncomputable instance : Fintype (FullBlock ι u) := by
  unfold FullBlock
  exact Fintype.ofFinite _

theorem blockCone_isLatticeRational (s : Finset E) : IsLatticeRational ι (blockCone ι u s) := by
  classical
  rw [isLatticeRational_iff]
  refine ⟨s.image u, ?_⟩
  simp [blockCone, Set.image_image]

noncomputable def family : CycleDegree.FullCones (FullBlock ι u) V where
  cone s := blockCone ι u s.1
  fg s := (blockCone_isLatticeRational ι u s.1).fg
  full s := s.2.2

theorem family_isToric (s : FullBlock ι u) : IsToricCone ι ((family ι u).cone s) :=
  ⟨blockCone_isLatticeRational ι u s.1, s.2.1.1⟩

theorem family_injective : Function.Injective (family ι u).cone := by
  intro a b hab
  apply Subtype.ext
  apply Finset.ext
  intro e
  rw [← a.2.1.2.2 e, ← b.2.1.2.2 e]
  change blockCone ι u a.1 = blockCone ι u b.1 at hab
  rw [hab]

noncomputable def blockOfCone (C : PointedCone ℝ V) : Finset E :=
  Finset.univ.filter (fun e => ι (u e) ∈ C)

@[simp] theorem mem_blockOfCone (C : PointedCone ℝ V) (e : E) :
    e ∈ blockOfCone ι u C ↔ ι (u e) ∈ C := by simp [blockOfCone]

/-- A salient finitely generated cone whose extreme rays belong to the prescribed system
is generated by the prescribed vectors it contains. -/
theorem cone_eq_blockOfCone {C : PointedCone ℝ V} (hfg : C.FG)
    (hsal : (C : ConvexCone ℝ V).Salient)
    (hrays : ∀ R : PointedCone ℝ V, R.IsFaceOf C →
      Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1 → ∃ e, R = ray (ι (u e))) :
    C = blockCone ι u (blockOfCone ι u C) := by
  apply le_antisymm
  · conv_lhs => rw [← ToricRay.iSup_toPointedCone hfg hsal]
    apply iSup_le
    intro ρ
    obtain ⟨e, he⟩ := hrays ρ.toPointedCone ρ.1.isFaceOf ρ.2
    have hve : ι (u e) ∈ C := by
      apply ρ.1.isFaceOf.le
      change ι (u e) ∈ ρ.toPointedCone
      rw [he]
      exact PointedCone.subset_hull (by simp)
    rw [he]
    apply Submodule.span_le.2
    intro v hv
    have hv' : v = ι (u e) := Set.mem_singleton_iff.1 hv
    rw [hv']
    exact PointedCone.subset_hull ⟨e, (mem_blockOfCone ι u C e).2 hve, rfl⟩
  · apply Submodule.span_le.2
    rintro v ⟨e, he, rfl⟩
    exact (mem_blockOfCone ι u C e).1 he

theorem allowed_blockOfCone (hnz : ∀ e, ι (u e) ≠ 0)
    {C : PointedCone ℝ V} (hfg : C.FG) (hsal : (C : ConvexCone ℝ V).Salient)
    (hrays : ∀ R : PointedCone ℝ V, R.IsFaceOf C →
      Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1 → ∃ e, R = ray (ι (u e)))
    (hmem : ∀ e, ι (u e) ∈ C → (ray (ι (u e))).IsFaceOf C) :
    Allowed ι u (blockOfCone ι u C) := by
  have he := cone_eq_blockOfCone ι u hfg hsal hrays
  refine ⟨?_, ?_, ?_⟩
  · rw [← he]; exact hsal
  · intro R
    rw [← he]
    constructor
    · rintro ⟨hR, hd⟩
      obtain ⟨e, hre⟩ := hrays R hR hd
      refine ⟨e, ?_, hre⟩
      apply (mem_blockOfCone ι u C e).2
      apply hR.le
      rw [hre]
      exact PointedCone.subset_hull (by simp)
    · rintro ⟨e, heC, rfl⟩
      exact ⟨hmem e ((mem_blockOfCone ι u C e).1 heC),
        PointedCone.finrank_span_coe_hull_singleton (hnz e)⟩
  · intro e
    rw [← he, mem_blockOfCone]

theorem fg_of_isFaceOf {C F : PointedCone ℝ V} (hC : C.FG) (hF : F.IsFaceOf C) : F.FG := by
  classical
  obtain ⟨s, hs⟩ := hC
  have he := PointedCone.Face.eq_hull_inter_of_eq_hull ⟨F, hF⟩ (s : Set V) hs.symm
  change F = PointedCone.hull ℝ ((s : Set V) ∩ (F : Set V)) at he
  refine ⟨s.filter (fun x => x ∈ F), ?_⟩
  simpa [Finset.coe_filter, Set.inter_def] using he.symm

/-- Allowed blocks are closed under taking actual geometric faces, with all prescribed-ray
saturation conditions retained. -/
theorem face_allowed (hnz : ∀ e, ι (u e) ≠ 0) {s : Finset E} (hs : Allowed ι u s)
    {F : PointedCone ℝ V} (hF : F.IsFaceOf (blockCone ι u s)) :
    Allowed ι u (blockOfCone ι u F) ∧ blockCone ι u (blockOfCone ι u F) = F := by
  have hfg := fg_of_isFaceOf (blockCone_isLatticeRational ι u s).fg hF
  have hsal : (F : ConvexCone ℝ V).Salient := hs.1.anti (fun _ hx => hF.le hx)
  have hrays : ∀ R : PointedCone ℝ V, R.IsFaceOf F →
      Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1 → ∃ e, R = ray (ι (u e)) := by
    intro R hR hd
    obtain ⟨e, _, he⟩ := (hs.2.1 R).1 ⟨hR.trans hF, hd⟩
    exact ⟨e, he⟩
  have hmem : ∀ e, ι (u e) ∈ F → (ray (ι (u e))).IsFaceOf F := by
    intro e he
    have hes := (hs.2.2 e).1 (hF.le he)
    have hr := ((hs.2.1 (ray (ι (u e)))).2 ⟨e, hes, rfl⟩).1
    apply (PointedCone.IsFaceOf.isFaceOf_iff_le hr hF).2
    exact Submodule.span_le.2 (fun _ h => by simpa using h ▸ he)
  exact ⟨allowed_blockOfCone ι u hnz hfg hsal hrays hmem,
    (cone_eq_blockOfCone ι u hfg hsal hrays).symm⟩

/-- The rays of a genuine fan are exactly the nonzero one-dimensional cones listed by `u`. -/
def HasRays (Φ : Fan ι) : Prop := ∀ R : PointedCone ℝ V,
  (R ∈ Φ.cones ∧ Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1) ↔
    ∃ e, R = ray (ι (u e))

theorem fan_cone_allowed (hnz : ∀ e, ι (u e) ≠ 0) {Φ : Fan ι} (hr : HasRays ι u Φ)
    {C : PointedCone ℝ V} (hC : C ∈ Φ.cones) :
    Allowed ι u (blockOfCone ι u C) ∧ blockCone ι u (blockOfCone ι u C) = C := by
  have hT := Φ.isToricCone hC
  have hrays : ∀ R : PointedCone ℝ V, R.IsFaceOf C →
      Module.finrank ℝ (Submodule.span ℝ (R : Set V)) = 1 → ∃ e, R = ray (ι (u e)) := by
    intro R hR hd
    exact (hr R).1 ⟨Φ.mem_of_isFaceOf hC hR, hd⟩
  have hmem : ∀ e, ι (u e) ∈ C → (ray (ι (u e))).IsFaceOf C := by
    intro e he
    have hrmem := ((hr (ray (ι (u e)))).2 ⟨e, rfl⟩).1
    apply Φ.isFaceOf_of_le hC hrmem
    exact Submodule.span_le.2 (fun _ h => by simpa using h ▸ he)
  exact ⟨allowed_blockOfCone ι u hnz hT.fg hT.salient hrays hmem,
    (cone_eq_blockOfCone ι u hT.fg hT.salient hrays).symm⟩

theorem full_fan_cone_eq_block (hnz : ∀ e, ι (u e) ≠ 0) {Φ : Fan ι}
    (hr : HasRays ι u Φ) {C : PointedCone ℝ V} (hC : C ∈ Φ.cones)
    (hfull : Submodule.span ℝ (C : Set V) = ⊤) :
    ∃ s : FullBlock ι u, (family ι u).cone s = C := by
  obtain ⟨hs, he⟩ := fan_cone_allowed ι u hnz hr hC
  refine ⟨⟨blockOfCone ι u C, hs, ?_⟩, he⟩
  rw [he]
  exact hfull

end Unimodular.AllowedBlocks
