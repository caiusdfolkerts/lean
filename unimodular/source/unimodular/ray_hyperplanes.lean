module

public import Unimodular.AllowedBlocks
public import Mathlib.Data.Finset.Max

@[expose] public section

open scoped Pointwise Topology
open Set

namespace Unimodular.RayHyperplanes

attribute [local instance] Classical.propDecidable

variable {E V : Type*} [Fintype E] [NormedAddCommGroup V] [NormedSpace ℝ V]
  [FiniteDimensional ℝ V]

def raySpan (v : E → V) (s : Finset E) : Submodule ℝ V :=
  Submodule.span ℝ (v '' (s : Set E))

/-- The paper's generic-direction condition: avoid every ray-generated hyperplane. -/
def GenericDirection (v : E → V) (w : V) : Prop := ∀ s : Finset E,
  Module.finrank ℝ (raySpan v s) + 1 = Module.finrank ℝ V → w ∉ raySpan v s

theorem span_hull_eq (s : Set V) :
    Submodule.span ℝ (PointedCone.hull ℝ s : Set V) = Submodule.span ℝ s := by
  apply le_antisymm
  · exact Submodule.span_le.2 (fun _ h => PointedCone.hull_le_span ℝ s h)
  · exact Submodule.span_mono PointedCone.subset_hull

theorem span_range_eq_top_of_positive (v : E → V)
    (hv : PointedCone.hull ℝ (Set.range v) = ⊤) : Submodule.span ℝ (Set.range v) = ⊤ := by
  apply top_le_iff.1
  intro x _
  apply PointedCone.hull_le_span ℝ (Set.range v)
  rw [hv]
  trivial

/-- Every proper span generated by prescribed vectors extends to a hyperplane generated
by those same vectors. This justifies the exact hyperplane condition used in the paper. -/
theorem exists_hyperplane_extension (v : E → V)
    (hv : Submodule.span ℝ (Set.range v) = ⊤) (s : Finset E)
    (hs : raySpan v s ≠ ⊤) :
    ∃ t : Finset E, s ⊆ t ∧
      Module.finrank ℝ (raySpan v t) + 1 = Module.finrank ℝ V := by
  classical
  let K : Finset (Finset E) := Finset.univ.filter (fun t => s ⊆ t ∧ raySpan v t ≠ ⊤)
  have hsK : s ∈ K := by simp [K, hs]
  obtain ⟨t, htK, hmax⟩ := Finset.exists_max_image K Finset.card ⟨s, hsK⟩
  have ht : s ⊆ t ∧ raySpan v t ≠ ⊤ := by simpa [K] using htK
  have hex : ∃ e, v e ∉ raySpan v t := by
    by_contra hn
    push_neg at hn
    have hle : Submodule.span ℝ (Set.range v) ≤ raySpan v t := by
      apply Submodule.span_le.2
      rintro _ ⟨e, rfl⟩
      exact hn e
    exact ht.2 (top_le_iff.1 (hv ▸ hle))
  obtain ⟨e, he⟩ := hex
  have het : e ∉ t := by
    intro het
    exact he (Submodule.subset_span ⟨e, het, rfl⟩)
  have hins : raySpan v (insert e t) = ⊤ := by
    by_contra hn
    have hiK : insert e t ∈ K := by
      simp only [K, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨ht.1.trans (Finset.subset_insert _ _), hn⟩
    have hcard := hmax (insert e t) hiK
    rw [Finset.card_insert_of_notMem het] at hcard
    omega
  have hinseq : raySpan v (insert e t) = (ℝ ∙ v e) ⊔ raySpan v t := by
    simp only [raySpan, Finset.coe_insert, Set.image_insert_eq, Submodule.span_insert]
  have hve : v e ≠ 0 := by
    intro hz
    exact he (by rw [hz]; exact (raySpan v t).zero_mem)
  have hdim := Submodule.finrank_add_le_finrank_add_finrank (ℝ ∙ v e) (raySpan v t)
  rw [← hinseq, hins, finrank_top, finrank_span_singleton hve] at hdim
  have hlt := Submodule.finrank_lt_finrank_of_lt (lt_top_iff_ne_top.2 ht.2)
  rw [finrank_top] at hlt
  exact ⟨t, ht.1, by omega⟩

theorem avoids_proper_raySpan (v : E → V) (hv : Submodule.span ℝ (Set.range v) = ⊤)
    {w : V} (hw : GenericDirection v w) (s : Finset E) (hs : raySpan v s ≠ ⊤) :
    w ∉ raySpan v s := by
  obtain ⟨t, hst, ht⟩ := exists_hyperplane_extension v hv s hs
  intro hm
  exact hw t ht ((Submodule.span_mono (Set.image_mono hst)) hm)

theorem genericDirection_dense (v : E → V) : Dense {w | GenericDirection v w} := by
  classical
  let H := {s : Finset E // Module.finrank ℝ (raySpan v s) + 1 = Module.finrank ℝ V}
  letI : Fintype H := Fintype.ofFinite _
  have hproper : ∀ s : H, raySpan v s.1 ≠ ⊤ := by
    intro s hs
    have hd := s.2
    rw [hs, finrank_top] at hd
    omega
  have hd := FiniteSubspacePaths.dense_complement (fun s : H => raySpan v s.1) hproper
  convert hd using 1
  ext w
  simp [GenericDirection, H]

variable {N : Type*} [AddCommGroup N] (ι : N →+ V) (u : E → N)

/-- A direction outside the paper's ray-generated hyperplanes is generic for the actual
allowed-cone face arrangement. No extra genericity is imposed by the formalization. -/
theorem generic_for_allowed (hnz : ∀ e, ι (u e) ≠ 0)
    (hspan : Submodule.span ℝ (Set.range (fun e => ι (u e))) = ⊤)
    {w : V} (hw : GenericDirection (fun e => ι (u e)) w) :
    (AllowedBlocks.family ι u).Generic w := by
  intro F
  obtain ⟨a, hFa⟩ := F.2.1
  obtain ⟨_, he⟩ := AllowedBlocks.face_allowed ι u hnz a.2.1 hFa
  let b := AllowedBlocks.blockOfCone ι u F.1
  have hsp : Submodule.span ℝ (F.1 : Set V) = raySpan (fun e => ι (u e)) b := by
    conv_lhs => rw [← he]
    exact span_hull_eq _
  rw [hsp]
  apply avoids_proper_raySpan _ hspan hw b
  intro ht
  exact F.2.2 (hsp.trans ht)

end Unimodular.RayHyperplanes
