module

public import Unimodular.Quotients

@[expose] public section

/-!
# Integral pivots for the series--parallel contraction argument

The coordinate transformation below is an actual unimodular linear
equivalence. Its inverse is displayed and checked; no rational saturation or
replacement of the quotient lattice is implicit.
-/

namespace Unimodular.SeriesParallel

noncomputable section

variable {I : Type*} [DecidableEq I]

/-- Elementary integral coordinate exchange at a unit coefficient. -/
def coordinatePivot (v : I → ℤ) (i : I) (hi : v i = 1 ∨ v i = -1) :
    (I → ℤ) ≃ₗ[ℤ] (I → ℤ) where
  toFun y j := if j = i then v i * y i else y j - v j * v i * y i
  invFun z j := if j = i then v i * z i else z j + v j * z i
  left_inv := by
    intro y
    funext j
    by_cases hji : j = i
    · subst j
      rcases hi with hi | hi <;> simp [hi]
    · rcases hi with hi | hi <;> simp [hji, hi] <;> ring
  right_inv := by
    intro z
    funext j
    by_cases hji : j = i
    · subst j
      rcases hi with hi | hi <;> simp [hi]
    · rcases hi with hi | hi <;> simp [hji, hi] <;> ring
  map_add' := by
    intro y z
    funext j
    by_cases hji : j = i <;> simp [hji] <;> ring
  map_smul' := by
    intro a y
    funext j
    by_cases hji : j = i <;> simp [hji] <;> ring

@[simp] theorem coordinatePivot_apply (v : I → ℤ) (i : I)
    (hi : v i = 1 ∨ v i = -1) (y : I → ℤ) (j : I) :
    coordinatePivot v i hi y j =
      if j = i then v i * y i else y j - v j * v i * y i := rfl

@[simp] theorem coordinatePivot_symm_apply (v : I → ℤ) (i : I)
    (hi : v i = 1 ∨ v i = -1) (z : I → ℤ) (j : I) :
    (coordinatePivot v i hi).symm z j =
      if j = i then v i * z i else z j + v j * z i := rfl

section Basis

variable [Fintype I] {M : Type*} [AddCommGroup M] [Module ℤ M]

/-- Replace one basis vector by an integral vector with coefficient ±1 there.
All other basis vectors remain exactly the same. -/
def pivotBasis (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) : Module.Basis I ℤ M :=
  Module.Basis.ofEquivFun
    (b.equivFun.trans (coordinatePivot (fun j => b.repr x j) i hi))

@[simp] theorem pivotBasis_repr (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) (y : M) (j : I) :
    (pivotBasis b x i hi).repr y j =
      if j = i then b.repr x i * b.repr y i
      else b.repr y j - b.repr x j * b.repr x i * b.repr y i := rfl

@[simp] theorem pivotBasis_self (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) : pivotBasis b x i hi i = x := by
  apply (pivotBasis b x i hi).repr.injective
  ext j
  rw [Module.Basis.repr_self_apply, pivotBasis_repr]
  by_cases hji : j = i
  · subst j
    rcases hi with hi | hi <;> simp [hi]
  · rcases hi with hi | hi <;> simp [hji, Ne.symm hji, hi] <;> ring

@[simp] theorem pivotBasis_other (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) {j : I} (hj : j ≠ i) :
    pivotBasis b x i hi j = b j := by
  apply (pivotBasis b x i hi).repr.injective
  ext k
  rw [Module.Basis.repr_self_apply, pivotBasis_repr]
  simp only [Module.Basis.repr_self_apply, hj, if_false, mul_zero, sub_zero]
  by_cases hki : k = i
  · subst k
    simp [hj]
  · simp [hki]

/-- The exact contraction map after the pivot, in integral quotient coordinates. -/
def pivotProjection (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) :
    M →ₗ[ℤ] ({j : I // j ∉ ({i} : Finset I)} → ℤ) :=
  CoordinateQuotients.projection (pivotBasis b x i hi) {i}

@[simp] theorem pivotProjection_apply (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) (y : M)
    (j : {j : I // j ∉ ({i} : Finset I)}) :
    pivotProjection b x i hi y j =
      b.repr y j.val - b.repr x j.val * b.repr x i * b.repr y i := by
  change (pivotBasis b x i hi).repr y j.val = _
  rw [pivotBasis_repr, if_neg]
  simpa using j.property

/-- This is the saturated rank-one kernel generated by the actual contracted
ray, with no index change in the integral lattice. -/
theorem ker_pivotProjection (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) :
    LinearMap.ker (pivotProjection b x i hi) = Submodule.span ℤ ({x} : Set M) := by
  rw [pivotProjection, CoordinateQuotients.ker_projection]
  simp

lemma pivotProjection_surjective (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) :
    Function.Surjective (pivotProjection b x i hi) :=
  CoordinateQuotients.projection_surjective _ _

@[simp] theorem pivotProjection_self (b : Module.Basis I ℤ M) (x : M) (i : I)
    (hi : b.repr x i = 1 ∨ b.repr x i = -1) : pivotProjection b x i hi x = 0 := by
  rw [← LinearMap.mem_ker, ker_pivotProjection]
  exact Submodule.subset_span (Set.mem_singleton x)

end Basis
end

#print axioms Unimodular.SeriesParallel.coordinatePivot
#print axioms Unimodular.SeriesParallel.ker_pivotProjection

end Unimodular.SeriesParallel
