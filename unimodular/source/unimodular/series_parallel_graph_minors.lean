module

public import Unimodular.SeriesParallelK4
public import Unimodular.PolytopeFans

@[expose] public section

/-!
# Literal graph minors and the integral graphic conclusion

The graph minor relation below is generated by ordinary edge deletion and
contraction of a nonloop edge. Contracting `a--b` merges `a` into `b`; the old
vertex `a` is retained only as an isolated ambient label. Isolated ambient
vertices do not contribute an edge or a column. This fixed-label presentation
allows comparison with Mathlib's ordinary matroid minors on the same edge type.
-/

open Set
open scoped BigOperators Matroid

namespace Unimodular.SeriesParallel

noncomputable section

attribute [local instance] Classical.propDecidable

/-- A directed multigraph with an explicitly specified set of active edges.
Directions orient incidence columns; they do not restrict graph contraction. -/
structure IncidenceGraph (V E : Type*) where
  source : E → V
  target : E → V
  edges : Set E

namespace IncidenceGraph

variable {V E : Type*}

/-- The coordinate vector of a genuine graph vertex. -/
def vertex (v : V) : V → ℝ := Pi.single v 1

/-- Full vertex-edge incidence, retaining the redundant total-sum coordinate. -/
def column (G : IncidenceGraph V E) (e : E) : V → ℝ :=
  vertex (G.source e) - vertex (G.target e)

/-- The ordinary vector/cycle matroid with precisely the active edge labels. -/
def cycleMatroid (G : IncidenceGraph V E) : Matroid E :=
  VectorMatroid.onSet (K := ℝ) G.column G.edges

/-- Ordinary edge deletion. Vertex deletion is implemented by deleting all its
incident edges, after which its unused ambient label is immaterial. -/
def delete (G : IncidenceGraph V E) (D : Set E) : IncidenceGraph V E :=
  { G with edges := G.edges \ D }

/-- Merge the first endpoint into the second endpoint. -/
def merge (a b v : V) : V := if v = a then b else v

/-- Ordinary contraction: merge the two endpoints and remove the selected edge. -/
def contract (G : IncidenceGraph V E) (e : E) : IncidenceGraph V E where
  source := merge (G.source e) (G.target e) ∘ G.source
  target := merge (G.source e) (G.target e) ∘ G.target
  edges := G.edges \ {e}

/-- The exact linear quotient implementing endpoint identification. -/
def contractionMap (a b : V) : (V → ℝ) →ₗ[ℝ] (V → ℝ) :=
  LinearMap.id + (LinearMap.proj a).smulRight (vertex b - vertex a)

@[simp] theorem contractionMap_apply (a b : V) (x : V → ℝ) :
    contractionMap a b x = x + x a • (vertex b - vertex a) := rfl

@[simp] theorem contractionMap_vertex (a b v : V) :
    contractionMap a b (vertex v) = vertex (merge a b v) := by
  classical
  by_cases hv : v = a
  · subst v
    simp [contractionMap_apply, vertex, merge]
  · simp [contractionMap_apply, vertex, merge, hv, Ne.symm hv]

/-- This is the actual one-edge quotient kernel, not an assumed contraction rule. -/
theorem contractionMap_ker (a b : V) (hab : a ≠ b) :
    LinearMap.ker (contractionMap a b) =
      Submodule.span ℝ ({vertex a - vertex b} : Set (V → ℝ)) := by
  classical
  apply le_antisymm
  · intro x hx
    have heq : x = x a • (vertex a - vertex b) := by
      have hzero : x + x a • (vertex b - vertex a) = 0 := hx
      calc
        x = -(x a • (vertex b - vertex a)) := eq_neg_of_add_eq_zero_left hzero
        _ = x a • (vertex a - vertex b) := by rw [← smul_neg, neg_sub]
    rw [heq]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
  · apply Submodule.span_le.mpr
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    change contractionMap a b (vertex a - vertex b) = 0
    rw [map_sub, contractionMap_vertex, contractionMap_vertex]
    simp [merge, hab, Ne.symm hab]

@[simp] theorem column_contract (G : IncidenceGraph V E) (e j : E) :
    (G.contract e).column j = contractionMap (G.source e) (G.target e) (G.column j) := by
  simp only [column, map_sub, contractionMap_vertex]
  rfl

@[simp] theorem cycleMatroid_delete (G : IncidenceGraph V E) (D : Set E) :
    (G.delete D).cycleMatroid = G.cycleMatroid ＼ D :=
  (VectorMatroid.delete_onSet G.column G.edges D).symm

/-- Literal graph-edge contraction equals ordinary Mathlib matroid contraction. -/
theorem cycleMatroid_contract (G : IncidenceGraph V E) (e : E)
    (he : e ∈ G.edges) (hne : G.source e ≠ G.target e) :
    (G.contract e).cycleMatroid = G.cycleMatroid ／ {e} := by
  have hk : LinearMap.ker (contractionMap (G.source e) (G.target e)) =
      Submodule.span ℝ (G.column '' ({e} : Set E)) := by
    simpa only [Set.image_singleton, column] using
      contractionMap_ker (G.source e) (G.target e) hne
  have h := VectorMatroid.contract_onSet G.column (Set.singleton_subset_iff.mpr he)
    (contractionMap (G.source e) (G.target e)) hk
  change VectorMatroid.onSet (G.contract e).column (G.edges \ {e}) =
    VectorMatroid.onSet G.column G.edges ／ {e}
  rw [h]
  congr 1
  funext j
  exact column_contract G e j

/-- Ordinary finite sequences of edge deletions and nonloop contractions.
Deleting loops is allowed; loop contraction has the same graph effect. -/
inductive IsMinor : IncidenceGraph V E → IncidenceGraph V E → Prop
  | refl (G) : IsMinor G G
  | delete {G H} : IsMinor H G → (D : Set E) → IsMinor (H.delete D) G
  | contract {G H} : IsMinor H G → (e : E) → e ∈ H.edges →
      H.source e ≠ H.target e → IsMinor (H.contract e) G

/-- Every literal graph minor is a literal ordinary cycle-matroid minor. -/
theorem IsMinor.cycleMatroid {G H : IncidenceGraph V E} (h : H.IsMinor G) :
    H.cycleMatroid ≤m G.cycleMatroid := by
  induction h with
  | refl G => exact Matroid.IsMinor.refl
  | @delete G H h D ih =>
    rw [cycleMatroid_delete]
    exact (show H.cycleMatroid ＼ D ≤m H.cycleMatroid from
      ⟨∅, D, by simp⟩).trans ih
  | @contract G H h e he hne ih =>
    rw [cycleMatroid_contract H e he hne]
    exact (show H.cycleMatroid ／ {e} ≤m H.cycleMatroid from
      ⟨{e}, ∅, by simp⟩).trans ih

/-- A literal complete graph on four distinct vertices, with six distinct
edge labels and arbitrary orientations; extra ambient vertices are isolated. -/
def IsK4 (G : IncidenceGraph V E) : Prop :=
  ∃ (v : Option (Fin 3) ↪ V) (f : Fin 6 ↪ E), G.edges = Set.range f ∧
    ∀ i, (G.source (f i) = v (K4Network.source i) ∧
      G.target (f i) = v (K4Network.target i)) ∨
      (G.source (f i) = v (K4Network.target i) ∧
      G.target (f i) = v (K4Network.source i))

/-- Ordinary graph K4-minor semantics, independently of matroid terminology. -/
def HasK4Minor (G : IncidenceGraph V E) : Prop :=
  ∃ H : IncidenceGraph V E, H.IsMinor G ∧ H.IsK4

/-- Coordinates relative to the distinguished root, with its vector set to zero. -/
def rootVector {n : ℕ} : Option (Fin n) → (Fin n → ℝ)
  | none => 0
  | some i => Pi.single i 1

/-- Embed root-reduced coordinates in full vertex incidence coordinates. -/
def rootMap {n : ℕ} (v : Option (Fin n) ↪ V) : (Fin n → ℝ) →ₗ[ℝ] (V → ℝ) :=
  (Pi.basisFun ℝ (Fin n)).constr ℝ
    (fun i => vertex (v (some i)) - vertex (v none))

@[simp] theorem rootMap_basis {n : ℕ} (v : Option (Fin n) ↪ V) (i : Fin n) :
    rootMap v (Pi.single i 1) = vertex (v (some i)) - vertex (v none) := by
  simpa only [rootMap, Pi.basisFun_apply] using
    (Pi.basisFun ℝ (Fin n)).constr_basis ℝ
      (fun j => vertex (v (some j)) - vertex (v none)) i

@[simp] theorem rootMap_rootVector {n : ℕ} (v : Option (Fin n) ↪ V)
    (p : Option (Fin n)) : rootMap v (rootVector p) = vertex (v p) - vertex (v none) := by
  cases p <;> simp [rootVector]

/-- No information is lost by retaining the redundant full incidence coordinate. -/
theorem rootMap_injective {n : ℕ} (v : Option (Fin n) ↪ V) :
    Function.Injective (rootMap v) := by
  classical
  have happ : ∀ (x : Fin n → ℝ) (j : Fin n), rootMap v x (v (some j)) = x j := by
    intro x j
    rw [← (Pi.basisFun ℝ (Fin n)).sum_repr x, map_sum]
    simp [vertex, Pi.single_apply, v.injective.eq_iff]
  intro x y h
  ext j
  simpa only [happ] using congrArg (fun z => z (v (some j))) h

private theorem k4_rootVector (i : Fin 6) :
    embed (RankThree.baseRoot i) =
      rootVector (K4Network.source i) - rootVector (K4Network.target i) := by
  fin_cases i <;> ext j <;> fin_cases j <;>
    simp [RankThree.baseRoot, K4Network, rootVector, embed, Pi.single_apply]

/-- Arbitrarily reversing directed edges preserves the actual cycle matroid. -/
theorem ofFamily_eq_of_eq_or_neg {α W : Type*} [AddCommGroup W] [Module ℝ W]
    (v w : α → W) (h : ∀ i, w i = v i ∨ w i = -v i) :
    VectorMatroid.ofFamily (K := ℝ) w = VectorMatroid.ofFamily (K := ℝ) v := by
  classical
  let s : α → ℝˣ := fun i => if w i = v i then 1 else -1
  have hs : ∀ i, w i = s i • v i := by
    intro i
    rcases h i with hi | hi
    · simp [s, hi]
    · by_cases he : w i = v i
      · simp [s, he]
      · simp [s, he, hi]
  apply (VectorMatroid.ofFamily_eq_iff _ _).mpr
  intro S
  change LinearIndependent ℝ (fun i : S => w i.val) ↔
    LinearIndependent ℝ (fun i : S => v i.val)
  simp_rw [hs]
  exact LinearIndependent.units_smul_iff (fun i : S => v i.val) (fun i : S => s i.val)

/-- The literal K4 graph has exactly the independently defined ordinary K4
cycle matroid, under its injective edge labeling. -/
theorem IsK4.cycleMatroid {G : IncidenceGraph V E} (h : G.IsK4) :
    ∃ f : Fin 6 ↪ E, G.cycleMatroid = K4Matroid.mapEmbedding f := by
  obtain ⟨v, f, hE, he⟩ := h
  let w : Fin 6 → V → ℝ := fun i => rootMap v (embed (RankThree.baseRoot i))
  have hsign : ∀ i, G.column (f i) = w i ∨ G.column (f i) = -w i := by
    intro i
    have hw : w i = vertex (v (K4Network.source i)) - vertex (v (K4Network.target i)) := by
      dsimp [w]
      rw [k4_rootVector, map_sub, rootMap_rootVector, rootMap_rootVector]
      abel
    rw [hw]
    rcases he i with ⟨hs, ht⟩ | ⟨hs, ht⟩
    · exact Or.inl (by simp [column, hs, ht])
    · exact Or.inr (by simp [column, hs, ht, neg_sub])
  have hfamily : VectorMatroid.ofFamily (K := ℝ) (fun i => G.column (f i)) = K4Matroid := by
    rw [ofFamily_eq_of_eq_or_neg w (fun i => G.column (f i)) hsign]
    exact VectorMatroid.ofFamily_comp_injective
      (fun i => embed (RankThree.baseRoot i)) (rootMap v) (rootMap_injective v)
  refine ⟨f, ?_⟩
  rw [← hfamily]
  change VectorMatroid.onSet (K := ℝ) G.column G.edges =
    (VectorMatroid.ofFamily (K := ℝ) (fun i => G.column (f i))).mapEmbedding f
  rw [hE]
  exact (VectorMatroid.ofFamily_mapEmbedding_eq_onSet (K := ℝ)
    (fun i => G.column (f i)) G.column f (fun _ => rfl)).symm

/-- A literal graph K4 minor induces the standard ordinary M(K4) minor. -/
theorem HasK4Minor.matroid {G : IncidenceGraph V E} (h : G.HasK4Minor) :
    Unimodular.SeriesParallel.HasK4Minor G.cycleMatroid := by
  obtain ⟨H, hHG, hK⟩ := h
  obtain ⟨f, hf⟩ := hK.cycleMatroid
  refine ⟨f, ?_⟩
  rw [← hf]
  exact hHG.cycleMatroid

/-- The proved ordinary matroid exclusion therefore excludes genuine graph minors. -/
theorem no_K4_minor_of_seriesParallel (G : IncidenceGraph V E)
    (h : GroundSeriesParallel G.cycleMatroid) : ¬G.HasK4Minor :=
  fun hK => h.no_K4_minor hK.matroid

/-- The full-edge graph associated with actual root-reduced incidence data. -/
def ofIncidence {n : ℕ} (s t : E → Option (Fin n)) : IncidenceGraph (Option (Fin n)) E :=
  ⟨s, t, Set.univ⟩

/-- Integral incidence in a genuine lattice basis agrees exactly with the
cycle matroid of the displayed graph, with all edge labels retained. -/
theorem cycleMatroid_of_integral_incidence {n : ℕ} {N W : Type*}
    [AddCommGroup N] [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]
    {ι : N →+ W} (Φ : TauCeti.Toric.Fan ι) (b : Module.Basis (Fin n) ℤ N)
    (U : E → N) (s t : E → Option (Fin n))
    (hU : ∀ e, U e = basisVertex b (s e) - basisVertex b (t e)) :
    (ofIncidence s t).cycleMatroid =
      VectorMatroid.ofFamily (K := ℝ) (fun e => ι (U e)) := by
  classical
  let c := CoordinateQuotients.realBasis ι Φ.lattice b
  let q := (rootMap (Function.Embedding.refl (Option (Fin n)))).comp c.equivFun.toLinearMap
  have hq : Function.Injective q :=
    (rootMap_injective (Function.Embedding.refl _)).comp c.equivFun.injective
  have hv : ∀ p, c.equivFun (ι (basisVertex b p)) = rootVector p := by
    intro p
    cases p with
    | none => simp [basisVertex, rootVector]
    | some i =>
      ext j
      simp [c, basisVertex, rootVector, Module.Basis.equivFun_apply,
        CoordinateQuotients.realBasis_repr, Module.Basis.repr_self_apply,
        Finsupp.single_apply, Pi.single_apply, eq_comm]
  have hcol : (ofIncidence s t).column = q ∘ (fun e => ι (U e)) := by
    funext e
    change (ofIncidence s t).column e =
      rootMap (Function.Embedding.refl (Option (Fin n))) (c.equivFun (ι (U e)))
    rw [hU, map_sub, map_sub, hv, hv, map_sub, rootMap_rootVector, rootMap_rootVector]
    simp only [column, ofIncidence, Function.Embedding.refl]
    abel
  change VectorMatroid.ofFamily (K := ℝ) (ofIncidence s t).column = _
  rw [hcol]
  exact VectorMatroid.ofFamily_comp_injective _ q hq

end IncidenceGraph

/-- The complete integral graphic conclusion for a complete regular positive
fan: an actual lattice basis, the exact original primitive ray vectors as
incidence columns, and a literal graph with no K4 graph minor. -/
theorem fan_integrally_graphic_no_K4 {N W : Type*} [AddCommGroup N]
    [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]
    {ι : N →+ W} (Φ : TauCeti.Toric.Fan ι) (hc : Φ.IsComplete) (hr : Φ.IsRegular)
    (hp : ConeBases.PositiveCriterion Φ) :
    ∃ (n : ℕ) (b : Module.Basis (Fin n) ℤ N)
      (s t : {u : N // ConeBases.IsRay Φ u} → Option (Fin n)),
      (∀ u, u.val = basisVertex b (s u) - basisVertex b (t u)) ∧
        ¬(IncidenceGraph.ofIncidence s t).HasK4Minor := by
  obtain ⟨n, b, s, t, h⟩ := fan_ray_configuration_integral_incidence Φ hc hr hp
  refine ⟨n, b, s, t, h, ?_⟩
  apply IncidenceGraph.no_K4_minor_of_seriesParallel
  rw [IncidenceGraph.cycleMatroid_of_integral_incidence Φ b
    (fun u : {u : N // ConeBases.IsRay Φ u} => u.val) s t h]
  exact (fan_rayMatroid_seriesParallel Φ hc hr hp).groundConstruction

