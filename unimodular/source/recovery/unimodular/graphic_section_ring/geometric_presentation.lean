module

public import Recovery.Unimodular.GraphicSectionRing.GeometricKoszul

/-!
# The actual geometric section-ring polynomial presentation

The polynomial homomorphism takes each genuine degree-one lattice character
to its actual global section, including the explicit normalization factor for
an arbitrary input Cartier divisor. Its kernel is proved equal to the genuine
lattice-point toric ideal. The squarefree quadratic initial ideal therefore
belongs to this actual section-ring presentation.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section

universe u
namespace PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

open PaperVerification.ToricSchemes
open Unimodular.GraphicSectionRing

variable {n : ℕ} {F : SmoothCompleteFan n} (G : F.GraphicCoordinates)
  (k : Type u) [Field k]

/-- The genuine degree-one polynomial presentation of the original Cartier
section ring. Its variable set is bijective with the original lattice points. -/
def cartierPolynomialMap (D : CartierData (F.fanScheme k)) :
    MvPolynomial (Point (G.constraints (F.cartierCoefficients k F.isPure D))) k →ₐ[k]
      ActualSections.sectionRing k D.localCocycle :=
  (G.arbitraryGraphicSectionRingEquiv k D).toAlgHom.comp
    (sectionMap (G.constraints (F.cartierCoefficients k F.isPure D)) k)

@[simp] theorem cartierPolynomialMap_X (D : CartierData (F.fanScheme k))
    (a : Point (G.constraints (F.cartierCoefficients k F.isPure D))) :
    G.cartierPolynomialMap k D (MvPolynomial.X a) =
      G.arbitraryGraphicSectionRingEquiv k D
        (AddMonoidAlgebra.single (degreeOnePoint a) 1) := by
  change G.arbitraryGraphicSectionRingEquiv k D (sectionMap _ k (MvPolynomial.X a)) = _
  rw [sectionMap_X]

/-- The entire actual section ring is generated by its true degree-one sections. -/
theorem cartierPolynomialMap_surjective (D : CartierData (F.fanScheme k)) :
    Function.Surjective (G.cartierPolynomialMap k D) :=
  (G.arbitraryGraphicSectionRingEquiv k D).surjective.comp (sectionMap_surjective _ k)

/-- The relation ideal is exactly the lattice-point toric ideal. -/
theorem cartierPolynomialMap_ker (D : CartierData (F.fanScheme k)) :
    RingHom.ker (G.cartierPolynomialMap k D).toRingHom =
      toricIdeal (Subtype.val : Point (G.constraints (F.cartierCoefficients k F.isPure D)) →
        Unimodular.GraphicSectionRing.Lattice n) k := by
  rw [← sectionMap_ker]
  ext f
  change G.arbitraryGraphicSectionRingEquiv k D (sectionMap _ k f) = 0 ↔ sectionMap _ k f = 0
  constructor
  · intro h
    exact (G.arbitraryGraphicSectionRingEquiv k D).injective
      (h.trans (map_zero (G.arbitraryGraphicSectionRingEquiv k D)).symm)
  · intro h
    rw [h, map_zero]

/-- The proved ordinary quotient is the actual section ring of D. -/
def cartierQuotientEquiv (D : CartierData (F.fanScheme k)) :
    (MvPolynomial (Point (G.constraints (F.cartierCoefficients k F.isPure D))) k ⧸
      toricIdeal (Subtype.val : Point (G.constraints (F.cartierCoefficients k F.isPure D)) →
        Unimodular.GraphicSectionRing.Lattice n) k) ≃ₐ[k]
      ActualSections.sectionRing k D.localCocycle :=
  (quotientEquivSectionAlgebra _ k).trans (G.arbitraryGraphicSectionRingEquiv k D)

/-- A genuine squarefree quadratic initial ideal for the actual section-ring
presentation, including empty and lower-dimensional section polytopes. -/
theorem cartierPolynomialMap_squarefree_initial (D : CartierData (F.fanScheme k)) :
    ∃ m : MonomialOrder.{0,0} (Point (G.constraints (F.cartierCoefficients k F.isPure D))),
      initialIdeal m (RingHom.ker (G.cartierPolynomialMap k D).toRingHom) =
        quadraticMonomialIdeal (Subtype.val : Point
          (G.constraints (F.cartierCoefficients k F.isPure D)) →
            Unimodular.GraphicSectionRing.Lattice n) k ∧
      ∀ v ∈ forbiddenExponents (Subtype.val : Point
          (G.constraints (F.cartierCoefficients k F.isPure D)) →
            Unimodular.GraphicSectionRing.Lattice n),
        v.degree = 2 ∧ ∀ i, v i ≤ 1 := by
  letI := G.points_finite (F.cartierCoefficients k F.isPure D)
  obtain ⟨m, hm⟩ := exists_squarefree_quadratic_initial_ideal
    (C := G.constraints (F.cartierCoefficients k F.isPure D)) k
  refine ⟨m, ?_, ?_⟩
  · rw [G.cartierPolynomialMap_ker k D]
    exact hm
  · exact fun v hv => forbiddenExponents_squarefree_quadratic _ hv

/-- The actual presentation of the ring of an arbitrary ordinary invertible sheaf. -/
def invertiblePolynomialMap (M : (F.fanScheme k).Modules) (hM : IsInvertibleModule M) :
    MvPolynomial (Point (G.constraints
      (F.cartierCoefficients k F.isPure (invertibleFractionalPresentation M hM)))) k →ₐ[k]
      F.invertibleSectionRing k M hM :=
  G.cartierPolynomialMap k (invertibleFractionalPresentation M hM)

/-- The full geometric conclusion of Proposition 6.10 under the explicit
integral coordinate/difference ray presentation. Every actual invertible sheaf
is admitted, so in particular every nef line bundle is admitted. -/
theorem theorem_6_10_coordinate_fan (M : (F.fanScheme k).Modules)
    (hM : IsInvertibleModule M) :
    let C := G.constraints
      (F.cartierCoefficients k F.isPure (invertibleFractionalPresentation M hM))
    let e := G.invertibleGraphicSectionRingEquiv k M hM
    Function.Surjective (G.invertiblePolynomialMap k M hM) ∧
    (∃ m : MonomialOrder.{0,0} (Point C),
      initialIdeal m (RingHom.ker (G.invertiblePolynomialMap k M hM).toRingHom) =
        quadraticMonomialIdeal (Subtype.val : Point C → Unimodular.GraphicSectionRing.Lattice n) k ∧
      ∀ v ∈ forbiddenExponents (Subtype.val : Point C → Unimodular.GraphicSectionRing.Lattice n),
        v.degree = 2 ∧ ∀ i, v i ≤ 1) ∧
    PaperVerification.WeightedBar.HasDiagonalTor
      (GeometricKoszul.augmentation C k e) (GeometricKoszul.basis C k e)
      (GeometricKoszul.basis_none C k e) (GeometricKoszul.augmentation_basis C k e)
      (GeometricKoszul.degree C) (GeometricKoszul.product_degree C k e) :=
  ⟨G.cartierPolynomialMap_surjective k (invertibleFractionalPresentation M hM),
    G.cartierPolynomialMap_squarefree_initial k (invertibleFractionalPresentation M hM),
    G.invertible_hasDiagonalTor k M hM⟩

#print axioms cartierPolynomialMap_ker
#print axioms cartierPolynomialMap_surjective
#print axioms cartierQuotientEquiv
#print axioms cartierPolynomialMap_squarefree_initial
#print axioms theorem_6_10_coordinate_fan

end PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

#check PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates.theorem_6_10_coordinate_fan
