module

public import Recovery.Unimodular.GraphicSectionRing.ToricFiber
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Data.Fintype.EquivFin

/-!
# The squarefree quadratic initial ideal of a graphic lattice configuration

This computes the initial ideal of the actual toric kernel.  Its generators
are exactly the quadratic monomials on incompatible pairs of lattice points.
The pairs are distinct, and hence each exponent is zero or one.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped BigOperators MonomialOrder

namespace Unimodular.GraphicSectionRing

variable {n : ℕ} {σ : Type*}

def pairExponent (a b : σ) : σ →₀ ℕ := Finsupp.single a 1 + Finsupp.single b 1

def forbiddenExponents (p : σ → Lattice n) : Set (σ →₀ ℕ) :=
  {u | ∃ a b, ¬ Compatible (p a) (p b) ∧ u = pairExponent a b}

def quadraticMonomialIdeal (p : σ → Lattice n) (K : Type*) [CommSemiring K] :
    Ideal (MvPolynomial σ K) :=
  Ideal.span ((fun u => MvPolynomial.monomial u (1 : K)) '' forbiddenExponents p)

/-- The actual initial ideal generated by leading terms of all kernel elements. -/
def initialIdeal {K : Type*} [CommSemiring K] (m : MonomialOrder σ)
    (I : Ideal (MvPolynomial σ K)) : Ideal (MvPolynomial σ K) :=
  Ideal.span (m.leadingTerm '' (I : Set (MvPolynomial σ K)))

theorem forbidden_pair_distinct {p : σ → Lattice n} {a b : σ}
    (h : ¬ Compatible (p a) (p b)) : a ≠ b := by
  rintro rfl
  exact h (compatible_refl (p a))

theorem pairExponent_squarefree {a b : σ} (hab : a ≠ b) (i : σ) :
    pairExponent a b i ≤ 1 := by
  classical
  by_cases hia : i = a
  · subst i
    simp [pairExponent, Finsupp.single_apply, hab, Ne.symm hab]
  · by_cases hib : i = b
    · subst i
      simp [pairExponent, Finsupp.single_apply, hab, Ne.symm hab]
    · simp [pairExponent, Finsupp.single_apply, hia, hib, Ne.symm hia, Ne.symm hib]

theorem pairExponent_degree (a b : σ) : (pairExponent a b).degree = 2 := by
  simp [pairExponent]

theorem forbiddenExponents_squarefree_quadratic (p : σ → Lattice n)
    {u : σ →₀ ℕ} (hu : u ∈ forbiddenExponents p) :
    u.degree = 2 ∧ ∀ i, u i ≤ 1 := by
  obtain ⟨a, b, hab, rfl⟩ := hu
  exact ⟨pairExponent_degree a b, pairExponent_squarefree (forbidden_pair_distinct hab)⟩

theorem pairExponent_le {u : σ →₀ ℕ} {a b : σ} (hab : a ≠ b)
    (ha : a ∈ u.toMultiset) (hb : b ∈ u.toMultiset) : pairExponent a b ≤ u := by
  classical
  have ha' : 1 ≤ u a := Nat.one_le_iff_ne_zero.mpr
    (Finsupp.mem_support_iff.mp ((Finsupp.mem_toMultiset u a).mp ha))
  have hb' : 1 ≤ u b := Nat.one_le_iff_ne_zero.mpr
    (Finsupp.mem_support_iff.mp ((Finsupp.mem_toMultiset u b).mp hb))
  intro i
  by_cases hia : i = a
  · subst i
    simpa [pairExponent, Finsupp.single_apply, hab, Ne.symm hab] using ha'
  · by_cases hib : i = b
    · subst i
      simpa [pairExponent, Finsupp.single_apply, hab, Ne.symm hab] using hb'
    · simp [pairExponent, Finsupp.single_apply, hia, hib, Ne.symm hia, Ne.symm hib]

theorem exists_forbidden_le {p : σ → Lattice n} {u : σ →₀ ℕ}
    (hu : ¬ StandardExponent p u) : ∃ v ∈ forbiddenExponents p, v ≤ u := by
  classical
  change ¬ Standard (u.toMultiset.map p) at hu
  unfold Standard at hu
  push_neg at hu
  obtain ⟨x, hx, y, hy, hxy⟩ := hu
  obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hx
  obtain ⟨b, hb, rfl⟩ := Multiset.mem_map.mp hy
  exact ⟨pairExponent a b, ⟨a, b, hxy, rfl⟩,
    pairExponent_le (forbidden_pair_distinct hxy) ha hb⟩

theorem monomial_mem_quadratic_ideal {p : σ → Lattice n} (K : Type*) [CommSemiring K]
    {u : σ →₀ ℕ} (hu : ¬ StandardExponent p u) (c : K) :
    MvPolynomial.monomial u c ∈ quadraticMonomialIdeal p K := by
  obtain ⟨v, hv, hvu⟩ := exists_forbidden_le hu
  have hv' : MvPolynomial.monomial v (1 : K) ∈ quadraticMonomialIdeal p K :=
    Ideal.subset_span ⟨v, hv, rfl⟩
  have hm := Ideal.mul_mem_left (quadraticMonomialIdeal p K)
    (MvPolynomial.monomial (u - v) c) hv'
  simpa only [MvPolynomial.monomial_mul, mul_one, tsub_add_cancel_of_le hvu] using hm

theorem initialIdeal_le_quadratic {p : σ → Lattice n} (hp : Function.Injective p)
    (K : Type*) [CommSemiring K] (base : MonomialOrder σ) :
    initialIdeal (WeightedOrder.refine (monomialWeight p) base) (toricIdeal p K) ≤
      quadraticMonomialIdeal p K := by
  apply Ideal.span_le.mpr
  rintro _ ⟨f, hf, rfl⟩
  by_cases hzero : f = 0
  · subst f
    simpa using (quadraticMonomialIdeal p K).zero_mem
  · exact monomial_mem_quadratic_ideal K (not_standard_leading_exponent hp K base hf hzero) _

abbrev Point (C : Set (Constraint n)) := {x : Lattice n // Satisfies C x}

def pointLower {C : Set (Constraint n)} (a b : Point C) : Point C :=
  ⟨lower a.1 b.1, lower_satisfies a.2 b.2⟩

def pointUpper {C : Set (Constraint n)} (a b : Point C) : Point C :=
  ⟨upper a.1 b.1, upper_satisfies a.2 b.2⟩

def quadraticRelation {C : Set (Constraint n)} (K : Type*) [CommRing K] (a b : Point C) :
    MvPolynomial (Point C) K :=
  MvPolynomial.monomial (pairExponent a b) 1 -
    MvPolynomial.monomial (pairExponent (pointLower a b) (pointUpper a b)) 1

theorem balanced_pair_toricDegree {C : Set (Constraint n)} (a b : Point C) :
    toricDegree Subtype.val (pairExponent (pointLower a b) (pointUpper a b)) =
      toricDegree Subtype.val (pairExponent a b) := by
  simp only [pairExponent, map_add, toricDegree_single]
  apply Prod.ext
  · rfl
  · exact lower_add_upper a.1 b.1

theorem quadraticRelation_mem {C : Set (Constraint n)} (K : Type*) [CommRing K]
    (a b : Point C) : quadraticRelation K a b ∈ toricIdeal Subtype.val K := by
  change toricMap Subtype.val K (quadraticRelation K a b) = 0
  simp only [quadraticRelation, map_sub, toricMap_monomial, balanced_pair_toricDegree, sub_self]

theorem balanced_pair_weight_lt {C : Set (Constraint n)} {a b : Point C}
    (h : ¬ Compatible a.1 b.1) :
    monomialWeight Subtype.val (pairExponent (pointLower a b) (pointUpper a b)) <
      monomialWeight Subtype.val (pairExponent a b) := by
  have hi := height_balance_lt a.1 b.1 h
  apply (Nat.cast_lt (α := ℤ)).mp
  simpa only [pairExponent, map_add, monomialWeight_single, Nat.cast_add,
    Int.toNat_of_nonneg (height_nonneg _), pointLower, pointUpper] using hi

theorem leadingTerm_quadraticRelation {C : Set (Constraint n)} (K : Type*)
    [CommRing K] [Nontrivial K] (base : MonomialOrder (Point C))
    {a b : Point C} (h : ¬ Compatible a.1 b.1) :
    (WeightedOrder.refine (monomialWeight Subtype.val) base).leadingTerm (quadraticRelation K a b) =
      MvPolynomial.monomial (pairExponent a b) 1 := by
  classical
  let m := WeightedOrder.refine (monomialWeight (Subtype.val : Point C → Lattice n)) base
  change m.leadingTerm (_ - _) = _
  have hlow : m.degree (MvPolynomial.monomial
      (pairExponent (pointLower a b) (pointUpper a b)) (1 : K)) =
      pairExponent (pointLower a b) (pointUpper a b) := by
    rw [m.degree_monomial (1 : K), if_neg one_ne_zero]
  have hhigh : m.degree (MvPolynomial.monomial (pairExponent a b) (1 : K)) =
      pairExponent a b := by
    rw [m.degree_monomial (1 : K), if_neg one_ne_zero]
  have hlt : m.degree (MvPolynomial.monomial
      (pairExponent (pointLower a b) (pointUpper a b)) (1 : K)) ≺[m]
      m.degree (MvPolynomial.monomial (pairExponent a b) (1 : K)) := by
    rw [hlow, hhigh]
    exact WeightedOrder.lt_of_weight_lt _ base (balanced_pair_weight_lt h)
  exact (m.leadingTerm_sub_of_lt hlt).trans (m.leadingTerm_monomial _ _)

/-- Full equality of the actual initial ideal, in every dimension and with no
assumption that the difference polytope has nonempty interior. -/
theorem initialIdeal_eq_squarefree_quadratics {C : Set (Constraint n)} (K : Type*)
    [CommRing K] [Nontrivial K] (base : MonomialOrder (Point C)) :
    initialIdeal (WeightedOrder.refine (monomialWeight Subtype.val) base)
        (toricIdeal (Subtype.val : Point C → Lattice n) K) =
      quadraticMonomialIdeal Subtype.val K := by
  apply le_antisymm (initialIdeal_le_quadratic Subtype.val_injective K base)
  apply Ideal.span_le.mpr
  rintro _ ⟨u, ⟨a, b, hab, rfl⟩, rfl⟩
  exact Ideal.subset_span ⟨quadraticRelation K a b, quadraticRelation_mem K a b,
    leadingTerm_quadraticRelation K base hab⟩

set_option maxHeartbeats 800000 in
/-- Finite lattice configurations admit the required genuine monomial order. -/
theorem exists_squarefree_quadratic_initial_ideal {C : Set (Constraint n)} [Finite (Point C)]
    (K : Type*) [CommRing K] [Nontrivial K] :
    ∃ m : MonomialOrder.{0,0} (Point C),
      initialIdeal m (toricIdeal (Subtype.val : Point C → Lattice n) K) =
        quadraticMonomialIdeal Subtype.val K := by
  classical
  letI := Fintype.ofFinite (Point C)
  let ord : LinearOrder (Point C) := LinearOrder.lift' (Fintype.equivFin (Point C))
    (Fintype.equivFin (Point C)).injective
  have wf : @WellFoundedGT (Point C) ord.toLT :=
    InvImage.wf (Fintype.equivFin (Point C))
      (inferInstance : WellFoundedGT (Fin (Fintype.card (Point C))))
  let base : MonomialOrder.{0,0} (Point C) := @MonomialOrder.lex (Point C) ord wf
  refine ⟨WeightedOrder.refine (monomialWeight (Subtype.val : Point C → Lattice n)) base, ?_⟩
  exact initialIdeal_eq_squarefree_quadratics (C := C) K base

#print axioms initialIdeal_eq_squarefree_quadratics
#print axioms exists_squarefree_quadratic_initial_ideal
#print axioms forbiddenExponents_squarefree_quadratic

end Unimodular.GraphicSectionRing
