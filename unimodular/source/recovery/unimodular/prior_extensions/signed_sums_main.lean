/- Proposition 2.2: actual lattice quotients from uniformly unimodular
configurations. TU is derived from maximal minors, never assumed here. -/
module
public import Recovery.Unimodular.PriorExtensions.SignedSumsTransport
public import Recovery.Unimodular.PriorExtensions.SignedSumsRegular
public import Recovery.Unimodular.PriorExtensions.SignedSumsBinary
@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped BigOperators
namespace Unimodular.SignedSums

/-- The integral map with the actual selected port columns. -/
def portMap {r n : ℕ} (u : Fin r → Lattice n) : (Fin r → ℤ) →ₗ[ℤ] Lattice n :=
  (Pi.basisFun ℤ (Fin r)).constr ℤ u

@[simp] theorem portMap_basis {r n : ℕ} (u : Fin r → Lattice n) (i : Fin r) :
    portMap u (Pi.single i 1) = u i := by
  simpa only [portMap, Pi.basisFun_apply] using (Pi.basisFun ℤ (Fin r)).constr_basis ℤ u i

theorem normalized_portMap {n r : ℕ} {E : Type*} (U : E → Lattice n)
    (a : Fin r → E) (N : PortNormalization U a) (p : Fin r → ℤ) :
    N.equiv (portMap (U ∘ a) p) = (p, 0) := by
  have he : N.equiv.toLinearMap.comp (portMap (U ∘ a)) =
      LinearMap.inl ℤ (Fin r → ℤ) (N.Complement → ℤ) := by
    apply (Pi.basisFun ℤ (Fin r)).ext
    intro i
    simpa only [LinearMap.comp_apply, LinearEquiv.coe_coe, Pi.basisFun_apply,
      portMap_basis, Function.comp_apply, LinearMap.inl_apply] using N.port_eq i
  exact congrArg (fun f : (Fin r → ℤ) →ₗ[ℤ] (Fin r → ℤ) × (N.Complement → ℤ) => f p) he

/-- In a full uniform system, real spanning already implies integral spanning. -/
theorem integral_spanning_of_uniform {n : ℕ} {E : Type*} (U : E → Lattice n)
    (hU : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n)) U)
    (hspan : Submodule.span ℝ (Set.range (fun e => embed (U e))) = ⊤) :
    Submodule.span ℤ (Set.range U) = ⊤ := by
  classical
  let S := Set.range U
  have hS : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n)) (fun u : S => u.val) := by
    intro f
    choose g hg using (fun i => (f i).property)
    have he : (fun u : S => u.val) ∘ f = U ∘ g := by funext i; exact (hg i).symm
    rw [he]
    exact hU g
  have hspanS : Submodule.span ℝ (embed '' S) = ⊤ := by
    have he : embed '' S = Set.range (fun e => embed (U e)) := by
      ext x
      simp [S, Set.mem_range]
    rw [he]
    exact hspan
  obtain ⟨b, hb, _⟩ := LatticeHull.exists_lattice_basis_extension S hS hspanS
    (fun i : Fin 0 => Fin.elim0 i) (linearIndependent_empty_type)
  apply top_unique
  rw [← b.span_eq]
  apply Submodule.span_mono
  rintro x ⟨i, rfl⟩
  exact hb i

def PortQuotient {n₁ n₂ r : ℕ} {T L R : Type*} (τ : Fin r → T)
    (U : T ⊕ L → Lattice n₁) (V : T ⊕ R → Lattice n₂) :=
  OriginalQuotient (portMap (fun i => U (.inl (τ i))))
    (portMap (fun i => V (.inl (τ i))))

instance portQuotient_addCommGroup {n₁ n₂ r : ℕ} {T L R : Type*} (τ : Fin r → T)
    (U : T ⊕ L → Lattice n₁) (V : T ⊕ R → Lattice n₂) :
    AddCommGroup (PortQuotient τ U V) := inferInstanceAs (AddCommGroup (OriginalQuotient _ _))

instance portQuotient_module {n₁ n₂ r : ℕ} {T L R : Type*} (τ : Fin r → T)
    (U : T ⊕ L → Lattice n₁) (V : T ⊕ R → Lattice n₂) :
    Module ℤ (PortQuotient τ U V) := inferInstanceAs (Module ℤ (OriginalQuotient _ _))

def PortOutput {n₁ n₂ r : ℕ} {T L R : Type*} (τ : Fin r → T)
    (U : T ⊕ L → Lattice n₁) (V : T ⊕ R → Lattice n₂) : L ⊕ R → PortQuotient τ U V :=
  originalFamily (portMap (fun i => U (.inl (τ i))))
    (portMap (fun i => V (.inl (τ i)))) (U ∘ Sum.inr) (V ∘ Sum.inr)

/-- The quotient uses precisely the subgroup generated by the displayed
identified port pairs, with no saturation or finite-index replacement. -/
theorem port_relation_range {n₁ n₂ r : ℕ}
    (u : Fin r → Lattice n₁) (v : Fin r → Lattice n₂) :
    LinearMap.range (originalRelation (portMap u) (portMap v)) =
      Submodule.span ℤ (Set.range (fun i => (u i, -v i))) := by
  have he : originalRelation (portMap u) (portMap v) =
      Fintype.linearCombination ℤ (fun i => (u i, -v i)) := by
    apply (Pi.basisFun ℤ (Fin r)).ext
    intro i
    simp [originalRelation, Pi.basisFun_apply, portMap_basis]
  rw [he, Fintype.range_linearCombination]

/-- Generic signed port gluing. The operation-specific port condition is
proved for zero, one, and triangle ports, and the TU side hypotheses are
consequences of the original uniform determinant bounds. -/
theorem signed_port_sum {n₁ n₂ r : ℕ} {T L R : Type*}
    (C : Matrix (Fin r) T ℤ) (hC : PortCompatible C L R) (τ : Fin r → T)
    (U : T ⊕ L → Lattice n₁) (V : T ⊕ R → Lattice n₂)
    (hU : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n₁)) U)
    (hV : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n₂)) V)
    (hspanU : Submodule.span ℝ (Set.range (fun l => embed (U (.inr l)))) = ⊤)
    (hspanV : Submodule.span ℝ (Set.range (fun l => embed (V (.inr l)))) = ⊤)
    (haU : LinearIndependent ℝ (fun i => embed (U (.inl (τ i)))))
    (haV : LinearIndependent ℝ (fun i => embed (V (.inl (τ i)))))
    (hportU : ∀ t, U (.inl t) = portMap (fun i => U (.inl (τ i))) (fun i => C i t))
    (hportV : ∀ t, V (.inl t) = portMap (fun i => V (.inl (τ i))) (fun i => C i t)) :
    ∃ k : ℕ, ∃ b : Module.Basis (Fin k) ℤ (PortQuotient τ U V),
      k + r = n₁ + n₂ ∧
      IntegralRigidity.Uniform b (PortOutput τ U V) ∧
      Submodule.span ℤ (Set.range (PortOutput τ U V)) = ⊤ ∧
      Matrix.IsTotallyUnimodular (fun i j => b.repr (PortOutput τ U V j) i) := by
  classical
  have hsU : Submodule.span ℝ (Set.range (fun e => embed (U e))) = ⊤ := by
    apply top_unique
    rw [← hspanU]
    apply Submodule.span_mono
    rintro _ ⟨l, rfl⟩
    exact ⟨Sum.inr l, rfl⟩
  have hsV : Submodule.span ℝ (Set.range (fun e => embed (V e))) = ⊤ := by
    apply top_unique
    rw [← hspanV]
    apply Submodule.span_mono
    rintro _ ⟨l, rfl⟩
    exact ⟨Sum.inr l, rfl⟩
  obtain ⟨N₁⟩ := exists_portNormalization U hU hsU (fun i => Sum.inl (τ i)) haU
  obtain ⟨N₂⟩ := exists_portNormalization V hV hsV (fun i => Sum.inl (τ i)) haV
  let a₁ := portMap (fun i => U (.inl (τ i)))
  let a₂ := portMap (fun i => V (.inl (τ i)))
  have he₁ (p : Fin r → ℤ) : N₁.equiv (a₁ p) = (p, 0) := normalized_portMap U _ N₁ p
  have he₂ (p : Fin r → ℤ) : N₂.equiv (a₂ p) = (p, 0) := normalized_portMap V _ N₂ p
  let eQ : PortQuotient τ U V ≃ₗ[ℤ]
      (Fin r → ℤ) × ((N₁.Complement → ℤ) × (N₂.Complement → ℤ)) :=
    originalQuotientEquiv a₁ a₂ N₁.equiv N₂.equiv he₁ he₂
  have hq (x : Lattice n₁ × Lattice n₂) : eQ (Submodule.Quotient.mk x) =
      ((N₁.equiv x.1).1 + (N₂.equiv x.2).1,
        ((N₁.equiv x.1).2, (N₂.equiv x.2).2)) := by
    change originalQuotientEquiv a₁ a₂ N₁.equiv N₂.equiv he₁ he₂
      (Submodule.Quotient.mk x) = _
    rw [originalQuotientEquiv_mk]
    rfl
  let U' := productCoordinates N₁.equiv (U ∘ Sum.inr)
  let V' := productCoordinates N₂.equiv (V ∘ Sum.inr)
  have hU' : (augment C U').IsTotallyUnimodular := by
    convert N₁.totallyUnimodular using 1
    ext i j
    cases j with
    | inr l => rfl
    | inl t =>
        have ht : N₁.equiv (U (.inl t)) = (fun i => C i t, 0) := by rw [hportU]; exact he₁ _
        cases i <;> simp [augment, productCoordinates, ht]
  have hV' : (augment C V').IsTotallyUnimodular := by
    convert N₂.totallyUnimodular using 1
    ext i j
    cases j with
    | inr l => rfl
    | inl t =>
        have ht : N₂.equiv (V (.inl t)) = (fun i => C i t, 0) := by rw [hportV]; exact he₂ _
        cases i <;> simp [augment, productCoordinates, ht]
  let b₀ := (Pi.basisFun ℤ (Fin r)).prod
    ((Pi.basisFun ℤ N₁.Complement).prod (Pi.basisFun ℤ N₂.Complement))
  let b := b₀.map eQ.symm
  have hcoords : (fun i j => b.repr (PortOutput τ U V j) i) = joined U' V' := by
    funext i j
    cases i with
    | inl p =>
        cases j <;> simp [b, b₀, Module.Basis.map, PortOutput, originalFamily, hq,
          joined, U', V', productCoordinates]
    | inr q =>
        cases q <;> cases j <;> simp [b, b₀, Module.Basis.map, PortOutput, originalFamily, hq,
          joined, U', V', productCoordinates]
  have ht : Matrix.IsTotallyUnimodular (fun i j => b.repr (PortOutput τ U V j) i) := by
    rw [hcoords]
    exact joined_totallyUnimodular C hC U' V' hU' hV'
  let I := Fin r ⊕ (N₁.Complement ⊕ N₂.Complement)
  let ef : I ≃ Fin (Fintype.card I) := Fintype.equivFin I
  let bf := b.reindex ef
  have htf : Matrix.IsTotallyUnimodular (fun i j => bf.repr (PortOutput τ U V j) i) := by
    convert ht.submatrix ef.symm id using 1
    ext i j
    simp only [bf, Module.Basis.repr_reindex_apply, Matrix.submatrix_apply, id_eq] <;> rfl
  refine ⟨Fintype.card I, bf, ?_, uniform_of_coordinate_tu bf _ htf, ?_, htf⟩
  · have h₁ := N₁.equiv.finrank_eq
    have h₂ := N₂.equiv.finrank_eq
    simp only [Module.finrank_prod, Module.finrank_pi, Fintype.card_fin] at h₁ h₂
    simp only [I, Fintype.card_sum, Fintype.card_fin]
    omega
  · apply originalFamily_spans
    · apply integral_spanning_of_uniform (U ∘ Sum.inr) _ hspanU
      intro f
      exact hU (Sum.inr ∘ f)
    · apply integral_spanning_of_uniform (V ∘ Sum.inr) _ hspanV
      intro f
      exact hV (Sum.inr ∘ f)

end Unimodular.SignedSums
#print axioms Unimodular.SignedSums.port_relation_range
#print axioms Unimodular.SignedSums.signed_port_sum
