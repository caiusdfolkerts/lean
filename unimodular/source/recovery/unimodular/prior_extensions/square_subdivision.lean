/-- Every actual convex face of a convex hull is generated by the original
points lying in that face. This does not assume that the face is exposed. -/
theorem face_eq_convexHull_inter {V : Type*} [AddCommGroup V] [Module ℝ V]
    (A F : Set V) (hF : Convex ℝ F) (hAF : IsExtreme ℝ (convexHull ℝ A) F) :
    F = convexHull ℝ (A ∩ F) := by
  have haux : convexHull ℝ A ⊆
      {x | x ∈ convexHull ℝ A ∧ (x ∈ F → x ∈ convexHull ℝ (A ∩ F))} := by
    apply convexHull_min
    · intro x hx
      exact ⟨subset_convexHull ℝ A hx,
        fun h => subset_convexHull ℝ (A ∩ F) ⟨hx,h⟩⟩
    · intro x hx y hy a b ha hb hab
      refine ⟨(convex_convexHull ℝ A) hx.1 hy.1 ha hb hab,?_⟩
      intro hz
      by_cases ha0 : a = 0
      · have hb1 : b = 1 := by linarith
        simpa only [ha0,hb1,zero_smul,one_smul,zero_add] using
          hy.2 (by simpa only [ha0,hb1,zero_smul,one_smul,zero_add] using hz)
      by_cases hb0 : b = 0
      · have ha1 : a = 1 := by linarith
        simpa only [hb0,ha1,zero_smul,one_smul,add_zero] using
          hx.2 (by simpa only [hb0,ha1,zero_smul,one_smul,add_zero] using hz)
      have hseg : a • x + b • y ∈ openSegment ℝ x y :=
        ⟨a,b,lt_of_le_of_ne ha (Ne.symm ha0),lt_of_le_of_ne hb (Ne.symm hb0),hab,rfl⟩
      exact (convex_convexHull ℝ (A ∩ F))
        (hx.2 (hAF.left_mem_of_mem_openSegment hx.1 hy.1 hz hseg))
        (hy.2 (hAF.right_mem_of_mem_openSegment hx.1 hy.1 hz hseg)) ha hb hab
  exact Set.Subset.antisymm
    (fun x hx => (haux (hAF.subset hx)).2 hx)
    (convexHull_min (fun _ h => h.2) hF)

abbrev Plane := Fin 2 → ℝ
abbrev Key := Finset (Fin 4)

def vertex : Fin 4 → Plane := ![![0,0],![1,0],![1,1],![0,1]]
def vertexZ : Fin 4 → Fin 2 → ℤ := ![![0,0],![1,0],![1,1],![0,1]]

theorem vertex_injective : Function.Injective vertex := by
  intro i j h
  fin_cases i <;> fin_cases j <;> simp_all [vertex, funext_iff]

@[simp] theorem vertex_cast (i : Fin 4) (j : Fin 2) :
    (vertexZ i j : ℝ) = vertex i j := by
  fin_cases i <;> fin_cases j <;> norm_num [vertexZ,vertex]

def hull (s : Key) : Set Plane := convexHull ℝ (vertex '' (s : Set (Fin 4)))
def square : Set Plane := hull Finset.univ

/-- Barycentric coordinates retain every original square label. -/
theorem mem_hull_iff {s : Key} {x : Plane} :
    x ∈ hull s ↔ ∃ a : Fin 4 → ℝ,
      (∀ i, 0 ≤ a i) ∧ (∀ i, i ∉ s → a i = 0) ∧
      (∑ i, a i = 1) ∧ (∑ i, a i • vertex i = x) := by
  classical
  constructor
  · intro hx
    have hx' : x ∈ convexHull ℝ ((s.image vertex : Finset Plane) : Set Plane) := by
      simpa only [hull,Finset.coe_image] using hx
    obtain ⟨w,hw,hsum,hpoint⟩ := Finset.mem_convexHull'.mp hx'
    let a : Fin 4 → ℝ := fun i => if i ∈ s then w (vertex i) else 0
    have hsum' : ∑ i ∈ s, w (vertex i) = 1 := by
      rw [Finset.sum_image] at hsum
      · exact hsum
      · exact fun i _ j _ h => vertex_injective h
    have hpoint' : ∑ i ∈ s, w (vertex i) • vertex i = x := by
      rw [Finset.sum_image] at hpoint
      · exact hpoint
      · exact fun i _ j _ h => vertex_injective h
    have ha_sum : ∑ i, a i = ∑ i ∈ s, w (vertex i) := by
      calc
        ∑ i, a i = ∑ i ∈ s, a i :=
          (Finset.sum_subset (Finset.subset_univ s)
            (fun i _ hi => by simp [a,hi])).symm
        _ = ∑ i ∈ s, w (vertex i) := Finset.sum_congr rfl (fun i hi => by simp [a,hi])
    have ha_point : ∑ i, a i • vertex i = ∑ i ∈ s, w (vertex i) • vertex i := by
      calc
        ∑ i, a i • vertex i = ∑ i ∈ s, a i • vertex i :=
          (Finset.sum_subset (Finset.subset_univ s)
            (fun i _ hi => by simp [a,hi])).symm
        _ = ∑ i ∈ s, w (vertex i) • vertex i :=
          Finset.sum_congr rfl (fun i hi => by simp [a,hi])
    refine ⟨a,?_,?_,ha_sum.trans hsum',ha_point.trans hpoint'⟩
    · intro i
      by_cases hi : i ∈ s
      · simpa [a,hi] using hw (vertex i) (Finset.mem_image.mpr ⟨i,hi,rfl⟩)
      · simp [a,hi]
    · intro i hi
      simp [a,hi]
  · rintro ⟨a,ha,hzero,hsum,hpoint⟩
    have hsum' : ∑ i ∈ s, a i = 1 :=
      (Finset.sum_subset (Finset.subset_univ s) (fun i _ hi => hzero i hi)).trans hsum
    have hpoint' : ∑ i ∈ s, a i • vertex i = x :=
      (Finset.sum_subset (Finset.subset_univ s)
        (fun i _ hi => by rw [hzero i hi,zero_smul])).trans hpoint
    rw [← hpoint']
    exact (convex_convexHull ℝ _).sum_mem (fun i _ => ha i) hsum'
      (fun i hi => subset_convexHull ℝ _ ⟨i,hi,rfl⟩)

theorem weights_coordinates (a : Fin 4 → ℝ) :
    (∑ i, a i • vertex i) 0 = a 1 + a 2 ∧
    (∑ i, a i • vertex i) 1 = a 2 + a 3 := by
  simp [Fin.sum_univ_succ,vertex,Finset.sum_apply,Pi.smul_apply]

theorem weights_sum (a : Fin 4 → ℝ) :
    ∑ i, a i = a 0 + a 1 + a 2 + a 3 := by
  simp [Fin.sum_univ_succ]
  ring

@[simp] theorem vertex_mem_hull {s : Key} (i : Fin 4) :
    vertex i ∈ hull s ↔ i ∈ s := by
  constructor
  · intro hi
    obtain ⟨a,ha,hz,hs,hpoint⟩ := mem_hull_iff.mp hi
    obtain ⟨h0,h1⟩ := weights_coordinates a
    rw [hpoint] at h0 h1
    rw [weights_sum] at hs
    by_contra hn
    have hzi := hz i hn
    have ha0 := ha 0
    have ha1 := ha 1
    have ha2 := ha 2
    have ha3 := ha 3
    fin_cases i <;> norm_num [vertex] at h0 h1 hzi <;> linarith
  · intro hi
    exact subset_convexHull ℝ _ ⟨i,hi,rfl⟩

theorem hull_injective : Function.Injective hull := by
  intro s t h
  ext i
  rw [← vertex_mem_hull i,← vertex_mem_hull i,h]

theorem hull_mono {s t : Key} (hst : s ⊆ t) : hull s ⊆ hull t :=
  convexHull_mono (Set.image_mono (fun _ h => hst h))

theorem hull_subset_iff {s t : Key} : hull s ⊆ hull t ↔ s ⊆ t := by
  constructor
  · intro h i hi
    exact (vertex_mem_hull i).mp (h ((vertex_mem_hull i).mpr hi))
  · exact hull_mono

@[simp] theorem hull_empty : hull ∅ = ∅ := by simp [hull]

theorem square_coordinate_bounds {x : Plane} (hx : x ∈ square) (j : Fin 2) :
    0 ≤ x j ∧ x j ≤ 1 := by
  obtain ⟨a,ha,hz,hs,hpoint⟩ := mem_hull_iff.mp hx
  obtain ⟨h0,h1⟩ := weights_coordinates a
  rw [hpoint] at h0 h1
  rw [weights_sum] at hs
  have ha0 := ha 0
  have ha1 := ha 1
  have ha2 := ha 2
  have ha3 := ha 3
  fin_cases j
  · change 0 ≤ x 0 ∧ x 0 ≤ 1
    constructor <;> linarith
  · change 0 ≤ x 1 ∧ x 1 ≤ 1
    constructor <;> linarith

/-- The geometric extreme points of the square are exactly its four corners. -/
theorem square_extremePoints : square.extremePoints ℝ = Set.range vertex := by
  apply Set.Subset.antisymm
  · intro x hx
    obtain ⟨i,hi,hix⟩ := extremePoints_convexHull_subset hx
    exact ⟨i,hix⟩
  · rintro x ⟨i,rfl⟩
    refine ⟨(vertex_mem_hull i).mpr (Finset.mem_univ _),?_⟩
    intro x hx y hy hseg
    obtain ⟨a,b,ha,hb,hab,he⟩ := hseg
    have hx0 := square_coordinate_bounds hx 0
    have hx1 := square_coordinate_bounds hx 1
    have hy0 := square_coordinate_bounds hy 0
    have hy1 := square_coordinate_bounds hy 1
    have he0 := congrFun he 0
    have he1 := congrFun he 1
    simp only [Pi.add_apply,Pi.smul_apply,smul_eq_mul] at he0 he1
    ext j
    fin_cases i <;> fin_cases j <;> norm_num [vertex] at he0 he1 ⊢ <;> nlinarith

/-- The proper faces of the four-corner square, with every face of a proper
vertex subset retained. This is a finite predicate, not a geometric definition. -/
def FaceKey (s t : Key) : Prop :=
  t ⊆ s ∧ (s ≠ Finset.univ ∨ t = Finset.univ ∨ t.card ≤ 1 ∨
    t = {0,1} ∨ t = {1,2} ∨ t = {2,3} ∨ t = {0,3})

instance (s t : Key) : Decidable (FaceKey s t) := inferInstanceAs
  (Decidable (t ⊆ s ∧ (s ≠ Finset.univ ∨ t = Finset.univ ∨ t.card ≤ 1 ∨
    t = {0,1} ∨ t = {1,2} ∨ t = {2,3} ∨ t = {0,3})))

abbrev SupportData := Fin 3 × Fin 3 × Fin 5

def supportValue (d : SupportData) (i : Fin 4) : ℤ :=
  ((d.1.val : ℤ) - 1) * vertexZ i 0 + ((d.2.1.val : ℤ) - 1) * vertexZ i 1

def supportLevel (d : SupportData) : ℤ := (d.2.2.val : ℤ) - 2

def SupportCertificate (s t : Key) (d : SupportData) : Prop :=
  t ⊆ s ∧ ∀ i ∈ s,
    supportValue d i ≤ supportLevel d ∧
      (i ∈ t ↔ supportValue d i = supportLevel d)

instance (s t : Key) (d : SupportData) : Decidable (SupportCertificate s t d) := by
  unfold SupportCertificate
  infer_instance

/-- Finite exact integer certificates for every genuine polygon face.
`decide` is evaluated by the Lean kernel; no native oracle is used. -/
theorem faceKey_support : ∀ s t : Key, FaceKey s t →
    ∃ d : SupportData, SupportCertificate s t d := by
  decide

def functional (d : SupportData) (x : Plane) : ℝ :=
  (((d.1.val : ℤ) - 1 : ℤ) : ℝ) * x 0 +
    (((d.2.1.val : ℤ) - 1 : ℤ) : ℝ) * x 1

@[simp] theorem functional_vertex (d : SupportData) (i : Fin 4) :
    functional d (vertex i) = (supportValue d i : ℝ) := by
  simp [functional,supportValue]

theorem functional_convex_combination (d : SupportData) (x y : Plane) (a b : ℝ) :
    functional d (a • x + b • y) = a * functional d x + b * functional d y := by
  simp only [functional,Pi.add_apply,Pi.smul_apply,smul_eq_mul]
  ring

/-- A certified integer supporting functional bounds the actual convex hull. -/
theorem support_bound {s t : Key} {d : SupportData}
    (h : SupportCertificate s t d) {x : Plane} (hx : x ∈ hull s) :
    functional d x ≤ (supportLevel d : ℝ) := by
  apply convexHull_min (t := {x | functional d x ≤ (supportLevel d : ℝ)}) ?_ ?_ hx
  · rintro x ⟨i,hi,rfl⟩
    change functional d (vertex i) ≤ (supportLevel d : ℝ)
    rw [functional_vertex]
    exact_mod_cast (h.2 i hi).1
  · intro x hx y hy a b ha hb hab
    change functional d x ≤ (supportLevel d : ℝ) at hx
    change functional d y ≤ (supportLevel d : ℝ) at hy
    change functional d (a • x + b • y) ≤ (supportLevel d : ℝ)
    calc
      _ = a * functional d x + b * functional d y :=
        functional_convex_combination d x y a b
      _ ≤ a * (supportLevel d : ℝ) + b * (supportLevel d : ℝ) :=
        add_le_add (mul_le_mul_of_nonneg_left hx ha) (mul_le_mul_of_nonneg_left hy hb)
      _ = (supportLevel d : ℝ) := by rw [← add_mul,hab,one_mul]

/-- Every certified face is an actual convex extreme subset. -/
theorem support_isExtreme {s t : Key} {d : SupportData}
    (h : SupportCertificate s t d) : IsExtreme ℝ (hull s) (hull t) := by
  let F : Set Plane := {x | x ∈ hull s ∧ functional d x = (supportLevel d : ℝ)}
  have hFc : Convex ℝ F := by
    intro x hx y hy a b ha hb hab
    refine ⟨(convex_convexHull ℝ _) hx.1 hy.1 ha hb hab,?_⟩
    rw [functional_convex_combination,hx.2,hy.2,← add_mul,hab,one_mul]
  have hFe : IsExtreme ℝ (hull s) F := by
    refine ⟨fun _ hx => hx.1,?_⟩
    intro x hx y hy z hz hseg
    obtain ⟨a,b,ha,hb,hab,he⟩ := hseg
    refine ⟨hx,?_⟩
    have hbndx := support_bound h hx
    have hbndy := support_bound h hy
    have heq := congrArg (functional d) he
    rw [functional_convex_combination,hz.2] at heq
    have hsum : a * ((supportLevel d : ℝ) - functional d x) +
        b * ((supportLevel d : ℝ) - functional d y) = 0 := by
      calc
        _ = (a+b) * (supportLevel d : ℝ) -
            (a * functional d x + b * functional d y) := by ring
        _ = 0 := by rw [hab,one_mul,heq,sub_self]
    have hnonnegx := mul_nonneg ha.le (sub_nonneg.mpr hbndx)
    have hnonnegy := mul_nonneg hb.le (sub_nonneg.mpr hbndy)
    have hzero : a * ((supportLevel d : ℝ) - functional d x) = 0 := by linarith
    exact (sub_eq_zero.mp ((mul_eq_zero.mp hzero).resolve_left ha.ne')).symm
  have hF : F = hull t := by
    rw [face_eq_convexHull_inter (vertex '' (s : Set (Fin 4))) F hFc hFe]
    congr 1
    apply Set.Subset.antisymm
    · rintro x ⟨⟨i,hi,rfl⟩,hF⟩
      refine ⟨i,(h.2 i hi).2.mpr ?_,rfl⟩
      exact_mod_cast (show (supportValue d i : ℝ) = (supportLevel d : ℝ) by
        simpa only [functional_vertex] using hF.2)
    · rintro x ⟨i,hi,rfl⟩
      have his := h.1 hi
      refine ⟨⟨i,his,rfl⟩,(vertex_mem_hull i).mpr his,?_⟩
      rw [functional_vertex,(h.2 i his).2.mp hi]
  rwa [hF] at hFe

theorem faceKey_isExtreme {s t : Key} (h : FaceKey s t) :
    IsExtreme ℝ (hull s) (hull t) := by
  obtain ⟨d,hd⟩ := faceKey_support s t h
  exact support_isExtreme hd

def center : Plane := ![(1/2 : ℝ),(1/2 : ℝ)]

theorem center_diag02 : center = (1/2 : ℝ) • vertex 0 + (1/2 : ℝ) • vertex 2 := by
  ext j
  fin_cases j <;> norm_num [center,vertex]

theorem center_diag13 : center = (1/2 : ℝ) • vertex 1 + (1/2 : ℝ) • vertex 3 := by
  ext j
  fin_cases j <;> norm_num [center,vertex]

theorem bad_face_diagonal : ∀ t : Key, ¬FaceKey Finset.univ t →
    (0 ∈ t ∧ 2 ∈ t ∧ (1 ∉ t ∨ 3 ∉ t)) ∨
    (1 ∈ t ∧ 3 ∈ t ∧ (0 ∉ t ∨ 2 ∉ t)) := by
  decide

/-- The finite face predicate is equivalent to the actual geometric one. -/
theorem isExtreme_iff_faceKey {s t : Key} :
    IsExtreme ℝ (hull s) (hull t) ↔ FaceKey s t := by
  refine ⟨?_,faceKey_isExtreme⟩
  intro h
  have hts : t ⊆ s := hull_subset_iff.mp h.subset
  by_cases hs : s ≠ Finset.univ
  · exact ⟨hts,Or.inl hs⟩
  have hs' : s = Finset.univ := not_ne_iff.mp hs
  subst s
  by_contra hbad
  rcases bad_face_diagonal t hbad with ⟨h0,h2,h1|h3⟩ | ⟨h1,h3,h0|h2⟩
  · have hc : center ∈ hull t := by
      rw [center_diag02]
      exact (convex_convexHull ℝ _) ((vertex_mem_hull 0).mpr h0)
        ((vertex_mem_hull 2).mpr h2) (by norm_num) (by norm_num) (by norm_num)
    apply h1
    apply (vertex_mem_hull 1).mp
    exact h.left_mem_of_mem_openSegment
      ((vertex_mem_hull 1).mpr (Finset.mem_univ _))
      ((vertex_mem_hull 3).mpr (Finset.mem_univ _)) hc
      ⟨1/2,1/2,by norm_num,by norm_num,by norm_num,center_diag13.symm⟩
  · have hc : center ∈ hull t := by
      rw [center_diag02]
      exact (convex_convexHull ℝ _) ((vertex_mem_hull 0).mpr h0)
        ((vertex_mem_hull 2).mpr h2) (by norm_num) (by norm_num) (by norm_num)
    apply h3
    apply (vertex_mem_hull 3).mp
    exact h.right_mem_of_mem_openSegment
      ((vertex_mem_hull 1).mpr (Finset.mem_univ _))
      ((vertex_mem_hull 3).mpr (Finset.mem_univ _)) hc
      ⟨1/2,1/2,by norm_num,by norm_num,by norm_num,center_diag13.symm⟩
  · have hc : center ∈ hull t := by
      rw [center_diag13]
      exact (convex_convexHull ℝ _) ((vertex_mem_hull 1).mpr h1)
        ((vertex_mem_hull 3).mpr h3) (by norm_num) (by norm_num) (by norm_num)
    apply h0
    apply (vertex_mem_hull 0).mp
    exact h.left_mem_of_mem_openSegment
      ((vertex_mem_hull 0).mpr (Finset.mem_univ _))
      ((vertex_mem_hull 2).mpr (Finset.mem_univ _)) hc
      ⟨1/2,1/2,by norm_num,by norm_num,by norm_num,center_diag02.symm⟩
  · have hc : center ∈ hull t := by
      rw [center_diag13]
      exact (convex_convexHull ℝ _) ((vertex_mem_hull 1).mpr h1)
        ((vertex_mem_hull 3).mpr h3) (by norm_num) (by norm_num) (by norm_num)
    apply h2
    apply (vertex_mem_hull 2).mp
    exact h.right_mem_of_mem_openSegment
      ((vertex_mem_hull 0).mpr (Finset.mem_univ _))
      ((vertex_mem_hull 2).mpr (Finset.mem_univ _)) hc
      ⟨1/2,1/2,by norm_num,by norm_num,by norm_num,center_diag02.symm⟩

