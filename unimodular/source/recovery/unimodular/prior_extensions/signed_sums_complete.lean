/- Full signed 2- and 3-sum endpoints: original lattice quotient, freeness,
exact rank, integral spanning, uniformity, and ordinary binary matroid sum. -/
module
public import Recovery.Unimodular.PriorExtensions.SignedSumsProposition
public import Recovery.Unimodular.PriorExtensions.SignedSumsRealization
public import Recovery.Unimodular.PriorExtensions.SignedSumsSupport
@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
namespace Unimodular.SignedSums

/-- The one-port binary matrix is the standard single nonzero port. -/
theorem single_binary_span : Submodule.span Binary.F
    (Set.range (fun t p => ((1 : Matrix (Fin 1) (Fin 1) ℤ) p t : Binary.F))) = ⊤ := by
  have he : (fun t p => ((1 : Matrix (Fin 1) (Fin 1) ℤ) p t : Binary.F)) =
      Binary.singlePort := by
    funext t p
    fin_cases t
    fin_cases p
    simp [Binary.singlePort, Matrix.one_apply]
  rw [he]
  exact Binary.single_ports_span

/-- Reduction of the aligned integral triangle gives exactly the three
nonzero binary vectors in its two-dimensional port plane. -/
theorem triangle_binary_span : Submodule.span Binary.F
    (Set.range (fun t p => (triangle p t : Binary.F))) = ⊤ := by
  have he : (fun t p => (triangle p t : Binary.F)) = Binary.trianglePort := by
    funext t p
    fin_cases t <;> fin_cases p <;> simp [triangle, Binary.trianglePort]
  rw [he]
  exact Binary.triangle_ports_span

theorem single_port_independent {n : ℕ} {L : Type*}
    (U : Fin 1 ⊕ L → Lattice n) (hp : U (.inl 0) ≠ 0) :
    LinearIndependent ℝ (fun i : Fin 1 => embed (U (.inl i))) := by
  apply linearIndependent_unique_iff.mpr
  intro hz
  apply hp
  apply LatticeHull.embed_injective
  exact hz.trans (by ext i; norm_num [embed])

theorem single_port_formula {n : ℕ} {L : Type*}
    (U : Fin 1 ⊕ L → Lattice n) (t : Fin 1) :
    U (.inl t) = portMap (fun i => U (.inl i))
      (fun i => (1 : Matrix (Fin 1) (Fin 1) ℤ) i t) := by
  have he : (fun i : Fin 1 => (1 : Matrix (Fin 1) (Fin 1) ℤ) i t) = Pi.single t 1 := by
    ext i
    simp [Matrix.one_apply, Pi.single_apply]
  rw [he, portMap_basis]

/-- Proposition 2.2 for the full literal signed 2-sum. The second conjunct
identifies the actual quotient's ordinary matroid with the unique matched
binary-cycle sum. All matroids are ordinary Mathlib Matroid objects. -/
theorem proposition_2_2_two_sum_complete {n₁ n₂ : ℕ} {L R : Type*}
    [Fintype L] [Fintype R]
    (U : Fin 1 ⊕ L → Lattice n₁) (V : Fin 1 ⊕ R → Lattice n₂)
    (hU : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n₁)) U)
    (hV : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n₂)) V)
    (hspanU : Submodule.span ℝ (Set.range (fun l => embed (U (.inr l)))) = ⊤)
    (hspanV : Submodule.span ℝ (Set.range (fun l => embed (V (.inr l)))) = ⊤)
    (hpU : U (.inl 0) ≠ 0) (hpV : V (.inl 0) ≠ 0) :
    SumConclusion id U V ∧ MatroidConclusion (1 : Matrix (Fin 1) (Fin 1) ℤ) id U V := by
  refine ⟨proposition_2_2_two_sum U V hU hV hspanU hspanV hpU hpV, ?_⟩
  exact signed_port_sum_matroid _ (one_port_compatible _) single_binary_span id U V
    hU hV hspanU hspanV (single_port_independent U hpU) (single_port_independent V hpV)
    (single_port_formula U) (single_port_formula V)

/-- Proposition 2.2 for the full literal signed 3-sum in arbitrary ranks.
No extra TU, saturation, representability, or hidden quotient assumption is
present. The triangle is aligned exactly as required by the paper's operation. -/
theorem proposition_2_2_three_sum_complete {n₁ n₂ : ℕ} {L R : Type*}
    [Fintype L] [Fintype R]
    (U : Fin 3 ⊕ L → Lattice n₁) (V : Fin 3 ⊕ R → Lattice n₂)
    (hU : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n₁)) U)
    (hV : IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin n₂)) V)
    (hspanU : Submodule.span ℝ (Set.range (fun l => embed (U (.inr l)))) = ⊤)
    (hspanV : Submodule.span ℝ (Set.range (fun l => embed (V (.inr l)))) = ⊤)
    (haU : LinearIndependent ℝ (fun i => embed (U (.inl (triangleBasisLabels i)))))
    (haV : LinearIndependent ℝ (fun i => embed (V (.inl (triangleBasisLabels i)))))
    (htriU : U (.inl 2) = U (.inl 0) + U (.inl 1))
    (htriV : V (.inl 2) = V (.inl 0) + V (.inl 1)) :
    SumConclusion triangleBasisLabels U V ∧ MatroidConclusion triangle triangleBasisLabels U V := by
  refine ⟨proposition_2_2_three_sum U V hU hV hspanU hspanV haU haV htriU htriV, ?_⟩
  exact signed_port_sum_matroid triangle triangle_compatible triangle_binary_span triangleBasisLabels
    U V hU hV hspanU hspanV haU haV (triangle_port_formula U htriU) (triangle_port_formula V htriV)

/-- In a two-sum the relation subgroup is literally generated by `(p₁,-p₂)`. -/
theorem two_port_relation_span {n₁ n₂ : ℕ}
    (u : Fin 1 → Lattice n₁) (v : Fin 1 → Lattice n₂) :
    LinearMap.range (originalRelation (portMap u) (portMap v)) =
      Submodule.span ℤ {(u 0, -v 0)} := by
  rw [port_relation_range]
  congr 1
  ext x
  simp [Set.range_unique]

/-- In a three-sum the relation subgroup is literally the span of the two
identified independent port pairs, without any extra generator or saturation. -/
theorem three_port_relation_span {n₁ n₂ : ℕ}
    (u : Fin 2 → Lattice n₁) (v : Fin 2 → Lattice n₂) :
    LinearMap.range (originalRelation (portMap u) (portMap v)) =
      Submodule.span ℤ {(u 0, -v 0), (u 1, -v 1)} := by
  rw [port_relation_range]
  congr 1
  ext x
  simp [Set.mem_range, Fin.exists_fin_two, eq_comm]

end Unimodular.SignedSums
#print axioms Unimodular.SignedSums.proposition_2_2_two_sum_complete
#print axioms Unimodular.SignedSums.proposition_2_2_three_sum_complete
#print axioms Unimodular.SignedSums.two_port_relation_span
#print axioms Unimodular.SignedSums.three_port_relation_span
