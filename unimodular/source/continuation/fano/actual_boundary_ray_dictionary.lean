module

public import Continuation.Divisor.IntrinsicBoundaryFoundations
public import Continuation.Divisor.FanoClosure

/-!
# Actual fan-boundary prime divisors and primitive ray valuations

Source candidate; not yet compiled. Full smooth charts are the actual
polynomial affine schemes. Their codimension-one torus-boundary points are
exactly the prime ideals generated by one coordinate variable. The actual
DVR orders therefore recover the original primitive rays, and the actual
Weil coefficients of the Cartier sheaf recover the original ray coefficients.

The argument covers arbitrary fields and dimension zero. No supplied
classification of boundary divisors, valuation formula, or Cartier
compatibility is an input hypothesis.
-/

@[expose] public section
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u

namespace PaperVerification.ToricGeometry.SmoothCompleteFan

open AlgebraicGeometry CategoryTheory
open PaperVerification.ToricSchemes PaperVerification.ToricCharacters
open Unimodular.NefBig
open scoped BigOperators Classical

variable {n : ℕ} (F : PaperVerification.ToricGeometry.SmoothCompleteFan n) (k : Type u) [Field k]

local instance fanBoundary_integral : IsIntegral (F.fanSchemeOver k).left := by
  change IsIntegral (F.fanScheme k)
  infer_instance

local instance fanBoundary_locallyNoetherian :
    IsLocallyNoetherian (F.fanSchemeOver k).left := by
  change IsLocallyNoetherian (F.fanScheme k)
  infer_instance


/-- The already proved full-chart polynomial presentation, in the direction
needed to take its actual Spec map. The variables are exactly `Fin n`. -/
def fullBoundaryPolynomialEquiv (s : F.fullCones) :
    monoidChartAlgebra k (dualConeMonoid s.val) ≃ₐ[k] MvPolynomial (Fin n) k :=
  (F.fullChartPolynomialPresentation k s).symm

theorem fullBoundaryDualBasis_mem (s : F.fullCones) (i : Fin n) :
    integralDualBasis (F.fullConeBasis s) i ∈ dualConeMonoid s.val := by
  rw [F.fullChart_semigroup_eq]
  exact basis_mem_fullCoordinateCone (F.fullCharacterBasis s) i

theorem fullBoundaryPolynomialEquiv_character (s : F.fullCones) (i : Fin n) :
    F.fullBoundaryPolynomialEquiv k s
      (chartCharacter k (dualConeMonoid s.val)
        (integralDualBasis (F.fullConeBasis s) i) (F.fullBoundaryDualBasis_mem s i)) =
      MvPolynomial.X i := by
  apply (F.fullChartPolynomialPresentation k s).injective
  rw [fullBoundaryPolynomialEquiv, AlgEquiv.apply_symm_apply,
    F.fullChartPolynomialPresentation_X]
  rfl

local instance fullConeTorusFace_isOpenImmersion (s : F.fullCones) :
    IsOpenImmersion (coneChartFaceMap k (Finset.empty_subset s.val)) :=
  F.coneChartFaceMap_isOpenImmersion k s.val ∅ (F.fullCones_mem s)
    (Finset.empty_subset s.val)

def fullPolynomialChart (s : F.fullCones) :
    Spec (CommRingCat.of (MvPolynomial (Fin n) k)) ⟶ F.fanScheme k :=
  Spec.map (F.fullBoundaryPolynomialEquiv k s).toRingEquiv.toCommRingCatIso.hom ≫
    F.fanChartMap k (F.fullConeIndex s)

instance fullPolynomialChart_isOpenImmersion (s : F.fullCones) :
    IsOpenImmersion (F.fullPolynomialChart k s) := by
  unfold fullPolynomialChart
  infer_instance

theorem fullPolynomialChart_cover (x : F.fanScheme k) :
    ∃ (s : F.fullCones) (p : PrimeSpectrum (MvPolynomial (Fin n) k)),
      F.fullPolynomialChart k s p = x := by
  obtain ⟨s, y, hy⟩ := F.fullChartOpen_cover k F.isPure x
  let j := Spec.map (F.fullBoundaryPolynomialEquiv k s).toRingEquiv.toCommRingCatIso.hom
  obtain ⟨p, hp⟩ := j.homeomorph.surjective y
  exact ⟨s, p, (congrArg (F.fanChartMap k (F.fullConeIndex s)) hp).trans hy⟩

theorem intrinsicCharacter_fan (m : Lattice n) :
    (F.intrinsicToricEmbedding k).intrinsicCharacter m =
      (F.rationalCharacter k m : (F.fanScheme k).functionField) := by
  exact (F.torusRationalMap_eq_openImmersion k (AddMonoidAlgebra.single m 1)).symm

theorem fullPolynomialChart_coordinate (s : F.fullCones) (i : Fin n) :
    affineOpenCoordinateMap (.of (MvPolynomial (Fin n) k))
      (F.fullPolynomialChart k s) (MvPolynomial.X i) =
      (F.rationalCharacter k (integralDualBasis (F.fullConeBasis s) i) :
        (F.fanScheme k).functionField) := by
  let R := CommRingCat.of (monoidChartAlgebra k (dualConeMonoid s.val))
  let S := CommRingCat.of (MvPolynomial (Fin n) k)
  let j := F.fanChartMap k (F.fullConeIndex s)
  let φ : R ⟶ S := (F.fullBoundaryPolynomialEquiv k s).toRingEquiv.toCommRingCatIso.hom
  letI : IsOpenImmersion (Spec.map φ) := by dsimp [φ]; infer_instance
  let r := chartCharacter k (dualConeMonoid s.val)
    (integralDualBasis (F.fullConeBasis s) i) (F.fullBoundaryDualBasis_mem s i)
  rw [← F.fullBoundaryPolynomialEquiv_character k s i]
  exact (affineOpenCoordinateMap_comp R S j φ r).trans
    (F.chartRationalMap_character k (F.fullConeIndex s) _ _)

def coordinateBoundaryPrime (i : Fin n) : PrimeSpectrum (MvPolynomial (Fin n) k) :=
  ⟨coordinatePrime k i, inferInstance⟩

instance coordinateBoundaryPrime_localDVR (i : Fin n) :
    IsDiscreteValuationRing (Localization.AtPrime (coordinateBoundaryPrime k i).asIdeal) := by
  change IsDiscreteValuationRing (coordinateBoundaryLocalRing k i)
  infer_instance

def fullBoundaryPoint (s : F.fullCones) (i : Fin n) : F.fanScheme k :=
  F.fullPolynomialChart k s (coordinateBoundaryPrime k i)

theorem fullBoundaryPoint_coheight (s : F.fullCones) (i : Fin n) :
    Order.coheight (F.fullBoundaryPoint k s i) = 1 :=
  affineOpen_coheight_eq_one (.of (MvPolynomial (Fin n) k))
    (F.fullPolynomialChart k s) (coordinateBoundaryPrime k i)

theorem fullBoundaryPoint_coordinate_order (s : F.fullCones) (i j : Fin n) :
    (F.intrinsicToricEmbedding k).characterOrder (F.fullBoundaryPoint k s i)
      (integralDualBasis (F.fullConeBasis s) j) = if i = j then 1 else 0 := by
  change (F.fanScheme k).ord
    ((F.intrinsicToricEmbedding k).intrinsicCharacter
      (integralDualBasis (F.fullConeBasis s) j)) (F.fullBoundaryPoint k s i) = _
  rw [F.intrinsicCharacter_fan k, ← F.fullPolynomialChart_coordinate k s j]
  by_cases hij : i = j
  · subst j
    rw [if_pos rfl]
    exact affineOpen_order_principalPrime (.of (MvPolynomial (Fin n) k))
      (F.fullPolynomialChart k s) (coordinateBoundaryPrime k i)
      (MvPolynomial.X i) (MvPolynomial.X_ne_zero i) rfl
  · rw [if_neg hij]
    apply affineOpen_order_zero_of_not_mem (.of (MvPolynomial (Fin n) k))
      (F.fullPolynomialChart k s) (coordinateBoundaryPrime k i) (MvPolynomial.X j)
    change MvPolynomial.X j ∉ Ideal.span {MvPolynomial.X i}
    rw [Ideal.mem_span_singleton, MvPolynomial.X_dvd_X]
    exact hij

/-- Every integral character has precisely its primitive ray pairing as
its actual order at this genuine scheme point. -/
theorem fullBoundaryPoint_character_order (s : F.fullCones) (i : Fin n)
    (m : Lattice n) :
    (F.intrinsicToricEmbedding k).characterOrder (F.fullBoundaryPoint k s i) m =
      integerPairing (F.fullConeBasis s i) m := by
  let b := integralDualBasis (F.fullConeBasis s)
  let f := (F.intrinsicToricEmbedding k).characterOrder (F.fullBoundaryPoint k s i)
  calc
    f m = f (∑ j : Fin n, b.repr m j • b j) := congrArg f (b.sum_repr m).symm
    _ = ∑ j : Fin n, b.repr m j * f (b j) := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro j _
      change f (b.repr m j • b j) = b.repr m j * f (b j)
      exact (f.map_zsmul _ _).trans (zsmul_eq_mul _ _)
    _ = b.repr m i := by
      simp only [f, b, F.fullBoundaryPoint_coordinate_order k s i]
      simp
    _ = integerPairing (F.fullConeBasis s i) m := by
      simp only [b, integralDualBasis_repr, integerPairing, mul_comm]

theorem fullBoundaryPoint_valuationVector (s : F.fullCones) (i : Fin n) :
    (F.intrinsicToricEmbedding k).valuationVector (F.fullBoundaryPoint k s i) =
      F.fullConeBasis s i := by
  ext j
  change (F.intrinsicToricEmbedding k).characterOrder (F.fullBoundaryPoint k s i)
    (Pi.single j 1) = _
  rw [F.fullBoundaryPoint_character_order]
  simp [integerPairing, Pi.single_apply]

theorem fullBoundaryPoint_mem_boundary (s : F.fullCones) (i : Fin n) :
    F.fullBoundaryPoint k s i ∈ (F.intrinsicToricEmbedding k).boundary := by
  rintro ⟨z, hz⟩
  have ho := (F.intrinsicToricEmbedding k).characterOrder_torus z
    (integralDualBasis (F.fullConeBasis s) i)
  rw [hz, F.fullBoundaryPoint_coordinate_order, if_pos rfl] at ho
  exact one_ne_zero ho

def fullBoundaryPrime (s : F.fullCones) (i : Fin n) :
    (F.intrinsicToricEmbedding k).BoundaryPrime :=
  ⟨F.fullBoundaryPoint k s i, F.fullBoundaryPoint_coheight k s i,
    F.fullBoundaryPoint_mem_boundary k s i⟩

/-- The full-chart open torus is the actual localization obtained by
inverting the product of its dual-basis coordinate characters. -/
theorem fullChart_torus_denominator (s : F.fullCones) :
    ∃ (v : Lattice n) (hv : v ∈ dualConeMonoid s.val),
      (coneChartFaceMap k (Finset.empty_subset s.val)).opensRange =
        PrimeSpectrum.basicOpen (chartCharacter k (dualConeMonoid s.val) v hv) ∧
      F.fullBoundaryPolynomialEquiv k s
        (chartCharacter k (dualConeMonoid s.val) v hv) =
          ∏ i : Fin n, MvPolynomial.X i := by
  let b := integralDualBasis (F.fullConeBasis s)
  let v := faceDenominatorExponent b ∅ Finset.univ
  have hcone : dualConeMonoid s.val = coordinateConeMonoid b Finset.univ := by
    rw [F.fullConeBasis_ray_set s, dualConeMonoid_basis_eq]
  have hv : v ∈ dualConeMonoid s.val := by
    rw [hcone]
    exact faceDenominatorExponent_mem b ∅ Finset.univ
  have hneg : -v ∈ dualConeMonoid (∅ : Finset (Lattice n)) := by
    intro u hu
    exact (Finset.notMem_empty u hu).elim
  have hclear (m : Lattice n) (_hm : m ∈ dualConeMonoid (∅ : Finset (Lattice n))) :
      ∃ N : ℕ, m + N • v ∈ dualConeMonoid s.val := by
    rw [hcone]
    exact faceDenominatorExponent_clears b (Finset.empty_subset Finset.univ) m
      (by intro i hi; exact (Finset.notMem_empty i hi).elim)
  letI := F.coneChartFaceMap_isOpenImmersion k s.val ∅ (F.fullCones_mem s)
    (Finset.empty_subset s.val)
  letI : IsOpenImmersion (monoidChartSpecMap k
      (dualConeMonoid_antitone (Finset.empty_subset s.val))) := by
    change IsOpenImmersion (coneChartFaceMap k (Finset.empty_subset s.val))
    infer_instance
  have hloc := monoidChartInclusion_isLocalizationMap k
    (dualConeMonoid_antitone (Finset.empty_subset s.val)) v hv hneg hclear
  refine ⟨v, hv,
    monoidChartSpecMap_opensRange_of_isLocalizationMap k
      (dualConeMonoid_antitone (Finset.empty_subset s.val)) v hv hloc, ?_⟩
  have hprod : chartCharacter k (dualConeMonoid s.val) v hv =
      ∏ i : Fin n, chartCharacter k (dualConeMonoid s.val) (b i)
        (F.fullBoundaryDualBasis_mem s i) := by
    apply Subtype.ext
    simp [v, faceDenominatorExponent, chartCharacter, AddMonoidAlgebra.prod_single]
  rw [hprod, map_prod]
  apply Finset.prod_congr rfl
  intro i hi
  exact F.fullBoundaryPolynomialEquiv_character k s i

theorem fullChart_mem_torus_iff (s : F.fullCones)
    (p : coneChart k (F.fullConeIndex s).val) :
    F.fanChartMap k (F.fullConeIndex s) p ∈
        (F.intrinsicToricEmbedding k).torusOpen ↔
      p ∈ (coneChartFaceMap k (Finset.empty_subset (F.fullConeIndex s).val)).opensRange := by
  have hcompat (z : coneChart k ∅) :
      F.fanChartMap k (F.fullConeIndex s)
          (coneChartFaceMap k (Finset.empty_subset (F.fullConeIndex s).val) z) =
        F.torusOpenMap k z := by
    exact congrArg (fun f => f z) (F.torusOpenMap_chart k (F.fullConeIndex s))
  constructor
  · rintro ⟨z, hz⟩
    refine ⟨(zeroConeChartIso k n).inv z, ?_⟩
    apply (F.fanChartMap k (F.fullConeIndex s)).isOpenEmbedding.injective
    exact (hcompat ((zeroConeChartIso k n).inv z)).trans hz
  · rintro ⟨z, rfl⟩
    refine ⟨(zeroConeChartIso k n).hom z, ?_⟩
    change F.torusOpenMap k ((zeroConeChartIso k n).inv
      ((zeroConeChartIso k n).hom z)) = _
    have hz := congrArg (fun f => f z) (zeroConeChartIso k n).hom_inv_id
    change (zeroConeChartIso k n).inv ((zeroConeChartIso k n).hom z) = z at hz
    rw [hz]
    exact (hcompat z).symm

theorem fullPolynomialChart_mem_torus_iff (s : F.fullCones)
    (p : PrimeSpectrum (MvPolynomial (Fin n) k)) :
    F.fullPolynomialChart k s p ∈ (F.intrinsicToricEmbedding k).torusOpen ↔
      ∀ i : Fin n, MvPolynomial.X i ∉ p.asIdeal := by
  obtain ⟨v, hv, hrange, hproduct⟩ := F.fullChart_torus_denominator k s
  change F.fanChartMap k (F.fullConeIndex s)
      ((Spec.map (F.fullBoundaryPolynomialEquiv k s).toRingEquiv.toCommRingCatIso.hom) p) ∈
      (F.intrinsicToricEmbedding k).torusOpen ↔ _
  apply (F.fullChart_mem_torus_iff k s _).trans
  have hrange' :
      (coneChartFaceMap k (Finset.empty_subset (F.fullConeIndex s).val)).opensRange =
        PrimeSpectrum.basicOpen (chartCharacter k (dualConeMonoid s.val) v hv) := hrange
  rw [hrange']
  change F.fullBoundaryPolynomialEquiv k s
    (chartCharacter k (dualConeMonoid s.val) v hv) ∉ p.asIdeal ↔ _
  rw [hproduct]
  simpa only [Ideal.IsPrime.prod_mem_iff, Finset.mem_univ, true_and, not_exists] using
    (Iff.rfl : (∏ i : Fin n, MvPolynomial.X i) ∉ p.asIdeal ↔
      (∏ i : Fin n, MvPolynomial.X i) ∉ p.asIdeal)

/-- Every intrinsic boundary prime is one of the genuine coordinate
boundary primes of a full chart. This is derived from its actual height. -/
theorem boundaryPrime_eq_fullBoundaryPoint
    (q : (F.intrinsicToricEmbedding k).BoundaryPrime) :
    ∃ (s : F.fullCones) (i : Fin n), F.fullBoundaryPoint k s i = q.val := by
  obtain ⟨s, p, hp⟩ := F.fullPolynomialChart_cover k q.val
  have hnot : ¬∀ i : Fin n, MvPolynomial.X i ∉ p.asIdeal := by
    intro h
    apply q.property.2
    rw [← hp]
    exact (F.fullPolynomialChart_mem_torus_iff k s p).mpr h
  push_neg at hnot
  obtain ⟨i, hi⟩ := hnot
  have hheight : p.asIdeal.height = 1 :=
    (idealHeight_eq_coheight (.of (MvPolynomial (Fin n) k)) p).trans
      ((coheight_eq_of_isOpenImmersion (F.fullPolynomialChart k s)).symm.trans
        (hp.symm ▸ q.property.1))
  have heq : p = coordinateBoundaryPrime k i := by
    apply PrimeSpectrum.ext
    exact Ideal.eq_span_singleton_of_height_eq_one hheight hi
      (MvPolynomial.prime_X (R := k) (i := i))
  refine ⟨s, i, ?_⟩
  change F.fullPolynomialChart k s (coordinateBoundaryPrime k i) = q.val
  rw [← heq]
  exact hp

theorem boundaryValuation_mem_rays
    (q : (F.intrinsicToricEmbedding k).BoundaryPrime) :
    (F.intrinsicToricEmbedding k).boundaryValuation q ∈ F.rays := by
  obtain ⟨s, i, hq⟩ := F.boundaryPrime_eq_fullBoundaryPoint k q
  change (F.intrinsicToricEmbedding k).valuationVector q.val ∈ F.rays
  rw [← hq, F.fullBoundaryPoint_valuationVector]
  exact (F.activeRay s i).property

theorem exists_boundaryPrime_valuation (u : Lattice n) (hu : u ∈ F.rays) :
    ∃ q : (F.intrinsicToricEmbedding k).BoundaryPrime,
      (F.intrinsicToricEmbedding k).boundaryValuation q = u := by
  obtain ⟨t, ht, hut⟩ := (F.mem_rays_iff u).mp hu
  obtain ⟨s, hs, hts, hcard⟩ := F.isPure t ht
  let s' : F.fullCones := ⟨s, Finset.mem_filter.mpr ⟨hs, hcard⟩⟩
  have hus : u ∈ s'.val := hts hut
  rw [F.fullConeBasis_ray_set s'] at hus
  obtain ⟨i, _, hi⟩ := Finset.mem_image.mp hus
  refine ⟨F.fullBoundaryPrime k s' i, ?_⟩
  change (F.intrinsicToricEmbedding k).valuationVector (F.fullBoundaryPoint k s' i) = u
  rw [F.fullBoundaryPoint_valuationVector]
  exact hi

/-- Equality of the actual valuation-image set with all original primitive
rays, without deleting labels or introducing extra rays. -/
theorem boundaryValuation_range :
    Set.range (F.intrinsicToricEmbedding k).boundaryValuation = (F.rays : Set (Lattice n)) := by
  ext u
  constructor
  · rintro ⟨q, rfl⟩
    exact F.boundaryValuation_mem_rays k q
  · exact F.exists_boundaryPrime_valuation k u

#print axioms intrinsicCharacter_fan
#print axioms fullBoundaryPoint_character_order
#print axioms boundaryPrime_eq_fullBoundaryPoint
#print axioms boundaryValuation_range

end PaperVerification.ToricGeometry.SmoothCompleteFan

end
