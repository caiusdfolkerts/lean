module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.Algebra.Field.Subfield.Basic
public import Mathlib.Algebra.Algebra.Subalgebra.Basic

/-!
# The fraction field of a lattice-generating monomial algebra

If the characters in a subalgebra generate the ambient exponent group,
the subalgebra and the ambient group algebra have the same fraction field.
The proof forms the actual subfield generated by the subalgebra. Its
characters form a subgroup, so they include every lattice character; sums
then include the whole group algebra and fractions include the whole field.
No normality, pointedness, finite-generation or dimension assumption is
needed for this step.
-/

@[expose] public noncomputable section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace PaperVerification.ToricCharacters

variable {k M : Type*} [CommRing k] [AddCommGroup M]
    (A : Subalgebra k (AddMonoidAlgebra k M))
    (K : Type*) [Field K] [Algebra (AddMonoidAlgebra k M) K]
    [IsFractionRing (AddMonoidAlgebra k M) K] [Algebra A K]

local instance monomialFractionAlgebraSMul : SMul A K :=
  (inferInstance : Algebra A K).toSMul

variable [IsScalarTower A (AddMonoidAlgebra k M) K]

/-- The literal Laurent characters in the given subalgebra determine its
actual fraction field whenever they generate the full exponent group. -/
theorem subalgebra_isFractionRing_of_character_groupClosure
    (hgroup : AddSubgroup.closure
      {m : M | AddMonoidAlgebra.single m (1 : k) ∈ A} = ⊤) :
    IsFractionRing A K := by
  classical
  let L := AddMonoidAlgebra k M
  let ρ := algebraMap L K
  let F : Subfield K := Subfield.closure ((algebraMap A K).range : Set K)
  have hinj : Function.Injective (algebraMap A K) := by
    intro a b hab
    apply Subtype.ext
    apply IsFractionRing.injective L K
    calc
      ρ (a : L) = algebraMap A K a :=
        (IsScalarTower.algebraMap_apply A L K a).symm
      _ = algebraMap A K b := hab
      _ = ρ (b : L) := IsScalarTower.algebraMap_apply A L K b
  letI : FaithfulSMul A K := (faithfulSMul_iff_algebraMap_injective A K).mpr hinj
  have hA (a : A) : ρ (a : L) ∈ F := by
    change (algebraMap L K) (algebraMap A L a) ∈ F
    rw [← IsScalarTower.algebraMap_apply A L K a]
    exact Subfield.subset_closure ⟨a, rfl⟩
  let G : AddSubgroup M :=
    { carrier := {m | ρ (AddMonoidAlgebra.single m (1 : k)) ∈ F}
      zero_mem' := by
        change ρ (1 : L) ∈ F
        rw [map_one]
        exact F.one_mem
      add_mem' := by
        intro m q hm hq
        change ρ (AddMonoidAlgebra.single (m + q) (1 : k)) ∈ F
        have h := F.mul_mem hm hq
        rw [← map_mul] at h
        rw [AddMonoidAlgebra.single_mul_single, one_mul] at h
        exact h
      neg_mem' := by
        intro m hm
        have hmul : ρ (AddMonoidAlgebra.single (-m) (1 : k)) *
            ρ (AddMonoidAlgebra.single m (1 : k)) = 1 := by
          rw [← map_mul, AddMonoidAlgebra.single_mul_single, neg_add_cancel, one_mul,
            ← AddMonoidAlgebra.one_def, map_one]
        have hinv := eq_inv_of_mul_eq_one_left hmul
        change ρ (AddMonoidAlgebra.single (-m) (1 : k)) ∈ F
        rw [hinv]
        exact F.inv_mem hm }
  have hcl : AddSubgroup.closure
      {m : M | AddMonoidAlgebra.single m (1 : k) ∈ A} ≤ G := by
    apply (AddSubgroup.closure_le G).mpr
    intro m hm
    exact hA ⟨AddMonoidAlgebra.single m (1 : k), hm⟩
  rw [hgroup] at hcl
  have hchar (m : M) : ρ (AddMonoidAlgebra.single m (1 : k)) ∈ F := hcl (by trivial)
  have hscalar (c : k) : ρ (AddMonoidAlgebra.single (0 : M) c) ∈ F := by
    exact hA (algebraMap k A c)
  have hLaurent (f : L) : ρ f ∈ F := by
    rw [← AddMonoidAlgebra.sum_coeff_single f]
    change ρ (∑ m ∈ f.coeff.support, AddMonoidAlgebra.single m (f.coeff m)) ∈ F
    rw [map_sum]
    apply F.sum_mem
    intro m hm
    have hsingle : AddMonoidAlgebra.single m (f.coeff m) =
        AddMonoidAlgebra.single (0 : M) (f.coeff m) *
          AddMonoidAlgebra.single m (1 : k) := by
      simp only [AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
    rw [hsingle, map_mul]
    exact F.mul_mem (hscalar _) (hchar m)
  have hF : F = ⊤ := by
    apply top_unique
    intro z _
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective L z
    exact F.div_mem (hLaurent a) (hLaurent b)
  apply IsFractionRing.of_field
  intro z
  have hz : z ∈ F := hF.symm ▸ (show z ∈ (⊤ : Subfield K) from trivial)
  obtain ⟨a, ha, b, hb, hab⟩ := Subfield.mem_closure_iff.mp hz
  rw [Subring.closure_eq] at ha hb
  obtain ⟨a, rfl⟩ := ha
  obtain ⟨b, rfl⟩ := hb
  exact ⟨a, b, hab.symm⟩

end PaperVerification.ToricCharacters

#print axioms PaperVerification.ToricCharacters.subalgebra_isFractionRing_of_character_groupClosure
