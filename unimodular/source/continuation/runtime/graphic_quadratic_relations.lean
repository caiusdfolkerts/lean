module

public import Recovery.Unimodular.GraphicSectionRing.GeometricPresentation
public import Mathlib.RingTheory.MvPolynomial.Groebner

/-!
# Explicit quadratic generators of the actual graphic relation ideal

The already proved forbidden-leading-exponent theorem and the ordinary
multivariate division algorithm show that the balancing binomials generate
the entire kernel. This establishes quadratic generation of the genuine
polynomial section-ring map, independently of any terminology for an
embedding. The later geometric comparison must still identify this map
with the coordinate map of the actual closed immersion.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

open scoped Classical MonomialOrder

namespace Unimodular.GraphicSectionRing

variable {n : ℕ} {C : Set (Constraint n)}

/-- Precisely the pairs on which the balancing relation is nontrivial. -/
abbrev IncompatiblePair (C : Set (Constraint n)) :=
  {a : Point C × Point C // ¬ Compatible a.1.val a.2.val}

def quadraticRelationFamily (K : Type*) [CommRing K] (a : IncompatiblePair C) :
    MvPolynomial (Point C) K :=
  quadraticRelation K a.val.1 a.val.2

def quadraticRelationIdeal (C : Set (Constraint n)) (K : Type*) [CommRing K] :
    Ideal (MvPolynomial (Point C) K) :=
  Ideal.span (Set.range (quadraticRelationFamily (C := C) K))

theorem quadraticRelationFamily_homogeneous (K : Type*) [CommRing K]
    (a : IncompatiblePair C) : (quadraticRelationFamily K a).IsHomogeneous 2 := by
  unfold quadraticRelationFamily quadraticRelation
  exact (MvPolynomial.isHomogeneous_monomial (1 : K)
    (pairExponent_degree a.val.1 a.val.2)).sub
      (MvPolynomial.isHomogeneous_monomial (1 : K)
        (pairExponent_degree (pointLower a.val.1 a.val.2) (pointUpper a.val.1 a.val.2)))

/-- The actual toric kernel is generated by the explicit homogeneous
quadratic balancing relations. The division remainder must vanish because
every nonzero kernel polynomial has a forbidden leading pair. -/
theorem toricIdeal_eq_quadraticRelationIdeal (K : Type*) [CommRing K] [Nontrivial K]
    (base : MonomialOrder (Point C)) :
    toricIdeal (Subtype.val : Point C → Lattice n) K = quadraticRelationIdeal C K := by
  let m := WeightedOrder.refine
    (monomialWeight (Subtype.val : Point C → Lattice n)) base
  let b : IncompatiblePair C → MvPolynomial (Point C) K := quadraticRelationFamily K
  let I := quadraticRelationIdeal C K
  have hlead (a : IncompatiblePair C) : m.leadingTerm (b a) =
      MvPolynomial.monomial (pairExponent a.val.1 a.val.2) (1 : K) :=
    leadingTerm_quadraticRelation K base a.property
  have hcoeff (a : IncompatiblePair C) : m.leadingCoeff (b a) = 1 := by
    rw [← m.leadingCoeff_leadingTerm (b a), hlead a, m.leadingCoeff_monomial]
  have hdegree (a : IncompatiblePair C) : m.degree (b a) =
      pairExponent a.val.1 a.val.2 := by
    rw [← m.degree_leadingTerm (b a), hlead a, m.degree_monomial, if_neg one_ne_zero]
  have hle : I ≤ toricIdeal (Subtype.val : Point C → Lattice n) K := by
    apply Ideal.span_le.mpr
    rintro f ⟨a, rfl⟩
    exact quadraticRelation_mem K a.val.1 a.val.2
  apply le_antisymm ?_ hle
  intro f hf
  obtain ⟨g, r, he, _, hr⟩ := m.div (b := b)
    (fun a => (hcoeff a).symm ▸ isUnit_one) f
  have hg : Finsupp.linearCombination (MvPolynomial (Point C) K) b g ∈ I := by
    change _ ∈ Submodule.span (MvPolynomial (Point C) K) (Set.range b)
    rw [← Finsupp.range_linearCombination]
    exact ⟨g, rfl⟩
  have hrker : r ∈ toricIdeal (Subtype.val : Point C → Lattice n) K := by
    have hsub := (toricIdeal (Subtype.val : Point C → Lattice n) K).sub_mem hf (hle hg)
    simpa only [he, add_sub_cancel_left] using hsub
  have hz : r = 0 := by
    by_contra hne
    have hn := not_standard_leading_exponent Subtype.val_injective K base hrker hne
    obtain ⟨v, ⟨a, c, hac, rfl⟩, hv⟩ := exists_forbidden_le hn
    have h := hr (m.degree r) (m.degree_mem_support hne) ⟨(a, c), hac⟩
    rw [hdegree] at h
    exact h hv
  rw [he, hz, add_zero]
  exact hg

end Unimodular.GraphicSectionRing

namespace PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

open PaperVerification.ToricSchemes
open Unimodular.GraphicSectionRing

universe u
variable {n : ℕ} {F : SmoothCompleteFan n} (G : F.GraphicCoordinates)
  (k : Type u) [Field k]

/-- The kernel of the actual Cartier section-ring presentation is generated
by the displayed quadratic polynomials in its original degree-one variables. -/
theorem cartierPolynomialMap_quadratic_generators (D : CartierData (F.fanScheme k)) :
    RingHom.ker (G.cartierPolynomialMap k D).toRingHom =
      quadraticRelationIdeal (G.constraints (F.cartierCoefficients k F.isPure D)) k := by
  letI := G.points_finite (F.cartierCoefficients k F.isPure D)
  obtain ⟨base, _⟩ := exists_squarefree_quadratic_initial_ideal
    (C := G.constraints (F.cartierCoefficients k F.isPure D)) k
  rw [G.cartierPolynomialMap_ker k D]
  exact toricIdeal_eq_quadraticRelationIdeal k base

/-- The input may be any ordinary invertible sheaf; the required Cartier
presentation is constructed internally. -/
theorem invertiblePolynomialMap_quadratic_generators
    (M : (F.fanScheme k).Modules) (hM : IsInvertibleModule M) :
    RingHom.ker (G.invertiblePolynomialMap k M hM).toRingHom =
      quadraticRelationIdeal (G.constraints (F.cartierCoefficients k F.isPure
        (invertibleFractionalPresentation M hM))) k :=
  G.cartierPolynomialMap_quadratic_generators k (invertibleFractionalPresentation M hM)

end PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

#print axioms Unimodular.GraphicSectionRing.toricIdeal_eq_quadraticRelationIdeal
#print axioms PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates.invertiblePolynomialMap_quadratic_generators

end
