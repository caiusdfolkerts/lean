/-!
# An ample Cartier representative obtained from actual projectivity

The twisting sheaf on the actual projective spectrum of a finite symmetric
algebra is pulled back along the actual closed immersion supplied by
`Scheme.IsProjectiveOver`. Its degree-one sections have precisely the usual
standard affine charts as nonvanishing loci. Closed immersion pullback
therefore gives an affine nonvanishing cover on the original scheme.

The invertible sheaf is then represented by genuine fractional Cartier data
using the existing generic-frame presentation. The final theorem assumes
neither an ample divisor nor smoothness. Every field and every dimension,
including zero, are retained. All scheme morphisms and structure morphisms
are the original ones.

The ordinary ampleness predicate here is the actual positive-tensor-power,
stalk-generation and affine-open definition `IsAmpleModule`; it is compared
with the rational Cartier criterion by a proved equivalence. Compilation and
source provenance are recorded separately.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

open CategoryTheory MonoidalCategory AlgebraicGeometry Opposite TopologicalSpace
open PaperVerification.ToricSchemes
open TauCeti.AlgebraicGeometry (InvertibleSheaf)

universe u

namespace Unimodular.NefBig

section DegreeOneCharts

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A]
  [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜]

/-- The ordinary global section `f/1` of the first twisting sheaf. -/
def twistingOneSection (f : A) (hf : f ∈ 𝒜 1) :
    Γ(Proj.twistingSheaf 𝒜 1, ⊤) :=
  Proj.toTwistingSheaf 𝒜 (n := 1) (j := 1) rfl ⊤ ⟨f, hf⟩

/-- The ordinary rank-one trivialization whose generator on `D₊(g)` is `g`. -/
def twistingOneTrivialization (g : A) (hg : g ∈ 𝒜 1) :
    SheafOfModules.free
        (R := (Proj 𝒜).ringCatSheaf.over (Proj.basicOpen 𝒜 g)) PUnit ≅
      (Proj.twistingSheaf 𝒜 1).over (Proj.basicOpen 𝒜 g) :=
  TauCeti.SheafOfModules.freePUnitIsoUnit
      ((Proj 𝒜).ringCatSheaf.over (Proj.basicOpen 𝒜 g)) ≪≫
    Proj.twistingSheaf.chartIso 1 g hg

/-- In the chart generated by `g`, the coordinate of the genuine global
section `f` has its usual localization value `f/g`. -/
theorem twistingOne_coordinate_value (f g : A) (hf : f ∈ 𝒜 1)
    (hg : g ∈ 𝒜 1) (x : Proj.basicOpen 𝒜 g) :
    ((Scheme.Modules.trivializationCoordinate (Proj.twistingSheaf 𝒜 1)
        (twistingOneTrivialization 𝒜 g hg) (𝟙 _)
        ((Proj.twistingSheaf 𝒜 1).presheaf.map (Proj.basicOpen 𝒜 g).leTop.op
          (twistingOneSection 𝒜 f hf))).1 x).val =
      Localization.mk f ⟨g, x.2⟩ := by
  have ht : Scheme.Modules.trivializationCoordinateIso (Proj.twistingSheaf 𝒜 1)
        (twistingOneTrivialization 𝒜 g hg) =
      (Proj.twistingSheaf.chartIso 1 g hg).symm := by
    exact Scheme.Modules.trivializationCoordinateIso_of_unitIso
      (Proj.twistingSheaf 𝒜 1) (Proj.twistingSheaf.chartIso 1 g hg).symm
  rw [Scheme.Modules.trivializationCoordinate_apply, ht]
  simp [twistingOneSection, Proj.twistingSheaf.chartIso_inv_app_apply_val,
    Proj.twistingSheaf.chartGenerator_apply, Localization.mk_mul]

variable [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible
  (Proj 𝒜) (Proj.twistingSheaf 𝒜 1)]

/-- On every degree-one chart, the ordinary stalk-generation locus of the
section `f` is the intersection with the usual basic open `D₊(f)`. -/
theorem twistingOne_nonvanishing_inter_chart (f g : A) (hf : f ∈ 𝒜 1)
    (hg : g ∈ 𝒜 1) :
    Proj.basicOpen 𝒜 g ⊓
        (Proj.twistingSheaf 𝒜 1).nonvanishingLocus (twistingOneSection 𝒜 f hf) =
      Proj.basicOpen 𝒜 g ⊓ Proj.basicOpen 𝒜 f := by
  rw [← Scheme.Modules.nonvanishingLocus_map
      (M := Proj.twistingSheaf 𝒜 1) (Proj.basicOpen 𝒜 g).leTop,
    Scheme.Modules.nonvanishingLocus_eq_basicOpen
      (twistingOneTrivialization 𝒜 g hg) (𝟙 _)]
  let c : Γ(Proj 𝒜, Proj.basicOpen 𝒜 g) :=
    Scheme.Modules.trivializationCoordinate (Proj.twistingSheaf 𝒜 1)
      (twistingOneTrivialization 𝒜 g hg) (𝟙 _)
      ((Proj.twistingSheaf 𝒜 1).presheaf.map (Proj.basicOpen 𝒜 g).leTop.op
        (twistingOneSection 𝒜 f hf))
  change (Proj 𝒜).basicOpen c = Proj.basicOpen 𝒜 g ⊓ Proj.basicOpen 𝒜 f
  ext x
  by_cases hxg : x ∈ Proj.basicOpen 𝒜 g
  · change x ∈ (Proj 𝒜).basicOpen c ↔ x ∈ Proj.basicOpen 𝒜 g ⊓ Proj.basicOpen 𝒜 f
    rw [(Proj 𝒜).mem_basicOpen c x hxg]
    change IsUnit ((Proj 𝒜).presheaf.germ _ x hxg c) ↔
      x ∈ Proj.basicOpen 𝒜 g ∧ x ∈ Proj.basicOpen 𝒜 f
    rw [and_iff_right hxg]
    letI : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
    have he : IsUnit ((Proj 𝒜).presheaf.germ _ x hxg c) ↔
        IsUnit (c.1 ⟨x, hxg⟩) := by
      constructor
      · intro h
        have hh := h.map (Proj.stalkIso' 𝒜 x).toMonoidHom
        change IsUnit ((Proj.stalkIso' 𝒜 x) ((Proj 𝒜).presheaf.germ _ x hxg c)) at hh
        erw [Proj.stalkIso'_germ] at hh
        exact hh
      · intro h
        have hh := h.map (Proj.stalkIso' 𝒜 x).symm.toMonoidHom
        change IsUnit ((Proj.stalkIso' 𝒜 x).symm (c.1 ⟨x,hxg⟩)) at hh
        erw [← Proj.stalkIso'_germ 𝒜 _ x hxg c, RingEquiv.symm_apply_apply] at hh
        exact hh
    rw [he, ← HomogeneousLocalization.isUnit_iff_isUnit_val,
      twistingOne_coordinate_value 𝒜 f g hf hg ⟨x, hxg⟩,
      Localization.mk_eq_mk', IsLocalization.AtPrime.isUnit_mk'_iff]
    rfl
  · exact iff_of_false
      (fun h ↦ hxg ((Proj 𝒜).basicOpen_le c h))
      (fun h ↦ hxg h.1)

/-- When degree-one standard charts cover, the ordinary nonvanishing locus
of `f/1` is exactly `D₊(f)`. The equality concerns actual stalk generation. -/
theorem twistingOne_nonvanishing_eq_basicOpen {ι : Type*} (a : ι → A)
    (ha : ∀ i, a i ∈ 𝒜 1) (hcover : ⨆ i, Proj.basicOpen 𝒜 (a i) = ⊤)
    (f : A) (hf : f ∈ 𝒜 1) :
    (Proj.twistingSheaf 𝒜 1).nonvanishingLocus (twistingOneSection 𝒜 f hf) =
      Proj.basicOpen 𝒜 f := by
  ext x
  have hx : x ∈ ⨆ i, Proj.basicOpen 𝒜 (a i) := by
    rw [hcover]
    trivial
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp hx
  have h := congrArg (fun U : (Proj 𝒜).Opens ↦ x ∈ U)
    (twistingOne_nonvanishing_inter_chart 𝒜 f (a i) hf (ha i))
  change x ∈ (Proj.twistingSheaf 𝒜 1).nonvanishingLocus (twistingOneSection 𝒜 f hf) ↔ x ∈ Proj.basicOpen 𝒜 f
  simpa only [Opens.mem_inf, hi, true_and] using Iff.of_eq h

end DegreeOneCharts

section OrdinaryAmpleSheaf

variable {X : Scheme.{u}} [IsIntegral X]

local instance : MonoidalCategory X.Modules :=
  TauCeti.SheafOfModules.monoidalCategory X.sheaf

/-- Actual projectivity supplies an ordinary ample invertible sheaf. The
sheaf is the pullback of the actual first twist along the actual closed
immersion; no ample-sheaf premise is present. -/
theorem exists_isAmpleModule_of_isProjectiveOver (k : Type u) [Field k]
    [X.Over (Spec (.of k))] [X.IsProjectiveOver k] :
    ∃ L : InvertibleSheaf X, IsAmpleModule L.obj := by
  classical
  obtain ⟨M, _, _, _, f, hf, hfk⟩ :=
    Scheme.IsProjectiveOver.exists_isClosedImmersion (R := k) (X := X)
  letI : IsClosedImmersion f := hf
  letI : f.IsOver (Spec (.of k)) := hfk
  let 𝒜 := TauCeti.SymmetricAlgebra.homogeneousSubmodule k M
  let O1 : InvertibleSheaf (Proj 𝒜) := ⟨Proj.twistingSheaf 𝒜 1, inferInstance⟩
  let L : InvertibleSheaf X := (InvertibleSheaf.pullback f).obj O1
  refine ⟨L, isAmpleModule_of_affine_nonvanishing_cover L
    (QuasiCompact.compactSpace_of_compactSpace (X ↘ Spec (.of k))) ?_⟩
  intro x
  have hcover : ⨆ m : M, Proj.basicOpen 𝒜 (SymmetricAlgebra.ι k M m) = ⊤ :=
    TauCeti.SymmetricAlgebra.iSup_basicOpen_ι_eq_top k M id (by simp)
  have hx : f x ∈ ⨆ m : M, Proj.basicOpen 𝒜 (SymmetricAlgebra.ι k M m) := by
    rw [hcover]
    trivial
  obtain ⟨m, hm⟩ := Opens.mem_iSup.mp hx
  let s := twistingOneSection 𝒜 (SymmetricAlgebra.ι k M m)
    (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule k M m)
  let t : Γ(L.obj, ⊤) := f.pullbackSectionsLE O1.obj ⊤ ⊤ (by simp) s
  have ht : L.obj.nonvanishingLocus t =
      f ⁻¹ᵁ Proj.basicOpen 𝒜 (SymmetricAlgebra.ι k M m) := by
    change ((Scheme.Modules.pullback f).obj O1.obj).nonvanishingLocus
      (f.pullbackSectionsLE O1.obj ⊤ ⊤ (by simp) s) = _
    rw [nonvanishingLocus_pullbackSectionsLE]
    simp only [top_inf_eq]
    congr 1
    exact twistingOne_nonvanishing_eq_basicOpen 𝒜 (SymmetricAlgebra.ι k M)
      (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule k M) hcover
      (SymmetricAlgebra.ι k M m)
      (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule k M m)
  refine ⟨t, ?_, ?_⟩
  · rw [ht]
    exact hm
  · rw [ht]
    exact (Proj.isAffineOpen_basicOpen 𝒜 (SymmetricAlgebra.ι k M m)
      (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule k M m) Nat.zero_lt_one).preimage f

end OrdinaryAmpleSheaf

end Unimodular.NefBig

namespace PaperVerification.ToricSchemes

/-- Every integral scheme that is actually projective over the original
field has an ample genuine Cartier representative. This is derived from
the pulled-back twisting sheaf, without an ample divisor input. -/
theorem exists_ampleCartier_of_isProjectiveOver (k : Type u) [Field k]
    {X : Scheme.{u}} [IsIntegral X] [X.Over (Spec (.of k))]
    [X.IsProjectiveOver k] : ∃ D : CartierData X, D.IsAmple := by
  obtain ⟨L, hL⟩ :=
    Unimodular.NefBig.exists_isAmpleModule_of_isProjectiveOver (X := X) k
  let D := invertibleFractionalPresentation L.obj
    ((Unimodular.NefBig.isInvertibleModule_iff_standard L.obj).mpr L.property)
  refine ⟨D, ?_⟩
  exact Unimodular.NefBig.isAmple_cocycle_of_isAmpleModule D.localCocycle
    (Unimodular.NefBig.isAmpleModule_of_iso D.presentationIso hL)


end PaperVerification.ToricSchemes

