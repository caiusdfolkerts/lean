module

public import Continuation.Runtime.IntrinsicDeeplyMonotone

/-!
# The ample embedding clause on the independently specified toric scheme

The original scheme, torus, ordinary ample line bundle and intrinsic
anticanonical polytope are inputs. Reconstruction and integral graphicity
are proved internally. The output is one actual closed embedding, its
coordinate-compatible pullback of O(1), and its geometric homogeneous ideal.
The polynomial vanishing ideal is defined using actual tensor-power sections;
its equality with the normal, quadratically generated kernel is proved.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicGeometry CategoryTheory TopologicalSpace
open PaperVerification.ToricSchemes PaperVerification.ToricGeometry
open Unimodular.GraphicSectionRing Unimodular.GraphicSectionRing.ActualSections
open Unimodular.NefBig Unimodular.ActualVeryAmple
open scoped Classical BaseSections

namespace PaperVerification.ToricSchemes.SplitToricEmbedding

variable {k : Type} [Field k] {n : ℕ}
    {X : Over (Spec (CommRingCat.of k))}
    [ModObj (splitTorusOver k (Fin n → ℤ)) X]
    [IsIntegral X.left] [Smooth X.hom] [IsProper X.hom]
    {T : SplitToricEmbedding k n X}

namespace IntegralGraphicBoundaryPresentation

variable {V : Type} [Fintype V] {H : SimpleGraph V}
    (P : T.IntegralGraphicBoundaryPresentation H)

/-- Each original variable is an actual degree-one section, as checked
coefficientwise in the genuine function-field polynomial ring. -/
theorem polynomialMap_homogeneous (D : CartierData X.left)
    (i : Point (P.sectionConstraints D)) (d : ℕ) (hd : d ≠ 1) :
    (P.polynomialMap D (MvPolynomial.X i)).val.coeff d = 0 := by
  rw [P.polynomialMap_X]
  exact P.graphicSectionRingEquiv_homogeneous D (degreeOnePoint i) 1 d hd

/-- The full ideal of relations among the original section coordinates is
generated by the actual homogeneous quadratic balancing relations. -/
theorem polynomialMap_quadratic_generators (D : CartierData X.left) :
    RingHom.ker (P.polynomialMap D).toRingHom =
      quadraticRelationIdeal (P.sectionConstraints D) k := by
  letI : Finite (Point (P.sectionConstraints D)) :=
    P.points_finite (torusNormalizedCartier k n X.left T.torus.left D)
  obtain ⟨base, _⟩ := exists_squarefree_quadratic_initial_ideal
    (C := P.sectionConstraints D) k
  rw [P.polynomialMap_ker]
  exact toricIdeal_eq_quadraticRelationIdeal k base

include P in
/-- An ordinary ample line bundle on the actual original scheme has a
normal quadratic section embedding. The ring and every pulled projective
coordinate are attached to the same original line bundle and morphism. -/
theorem ordinary_ample_normalQuadraticEmbedding
    (M : X.left.Modules) (hM : IsInvertibleModule M) (hample : IsAmpleModule M) :
    Nonempty (NormalQuadraticSectionEmbedding k X.left M) := by
  letI : IsProper (X.left ↘ Spec (CommRingCat.of k)) := by
    change IsProper X.hom
    infer_instance
  let D := invertibleFractionalPresentation M hM
  let C := D.localCocycle
  let I := Point (P.sectionConstraints D)
  letI : Finite I := P.points_finite (torusNormalizedCartier k n X.left T.torus.left D)
  letI : Fintype I := Fintype.ofFinite I
  let Φ := P.polynomialMap D
  let s : I → Γ(C.sheaf, ⊤) := polynomialDegreeOneSection k C Φ
  have hX : ∀ (i : I) (d : ℕ), d ≠ 1 → (Φ (MvPolynomial.X i)).val.coeff d = 0 :=
    P.polynomialMap_homogeneous D
  have hmap : degreeOneSectionMap k C s = Φ := degreeOneSectionMap_eq k C Φ hX
  have hsurj : Function.Surjective (degreeOneSectionMap k C s) := by
    rw [hmap]
    exact P.polynomialMap_surjective D
  have hC : IsAmpleModule C.sheaf := isAmpleModule_of_iso D.presentationIso hample
  have hgen : ∀ (N : ℕ) (t : Γ((C.pow N).sheaf, ⊤)),
      ∃ p : MvPolynomial I k, p.IsHomogeneous N ∧
        C.sectionProjectiveFieldMap k s p = (C.pow N).toCartierData.sectionValue ⊤ t :=
    homogeneous_generation_of_surjective k C Φ (P.polynomialMap_surjective D) hX
  let cover := C.nonvanishing_cover_of_homogeneous_generation k s hC hgen
  let f := C.degreeOneSectionMorphism k s hC hgen
  let iso := C.sectionProjectiveMap_pullback_degreeOneIso k s cover
  letI : IsIntegrallyClosed (sectionRing k C) :=
    sectionRing_isIntegrallyClosed k C (smooth_stalk_isIntegrallyClosed X.hom)
  let ringIso := Ideal.quotientKerAlgEquivOfSurjective hsurj
  refine ⟨{
    index := I
    finite := inferInstance
    cocycle := C
    original := D.presentationIso.symm
    sections := s
    morphism := f
    closed := C.degreeOneSectionMorphism_isClosedImmersion k s hC hgen
    over := C.sectionProjectiveMap_toSpec k s cover
    pullbackIso := iso ≪≫ D.presentationIso.symm
    coordinate := ?_
    generated := hsurj
    domain := Function.Injective.isDomain ringIso.toRingHom ringIso.injective
    normal := IsIntegrallyClosed.of_equiv ringIso.symm.toRingEquiv
    quadrics := ?_
  }⟩
  · intro i
    change BondalThomsen.polynomialProjDegreeOnePullbackCoordinateHom k I
        (C.sectionProjectiveMap k s cover) i ≫
        (iso.hom ≫ D.presentationIso.symm.hom) = _
    rw [← Category.assoc]
    exact congrArg (fun g => g ≫ D.presentationIso.symm.hom)
      (C.sectionProjectiveMap_pullback_degreeOneIso_coordinate k s cover i)
  · refine ⟨Set.range (quadraticRelationFamily (C := P.sectionConstraints D) k), ?_, ?_⟩
    · rw [hmap]
      exact P.polynomialMap_quadratic_generators D
    · rintro p ⟨a, rfl⟩
      exact quadraticRelationFamily_homogeneous k a

end IntegralGraphicBoundaryPresentation

/-- The complete ample-embedding clause on the independently specified
original smooth proper toric scheme. The ordinary ample input supplies its
fan reconstruction; deep monotonicity supplies graphicity. No fan, graphic
presentation, chosen sections or canonical-comparison witness is assumed. -/
theorem corollary_6_11_original_ample_embedding (T : SplitToricEmbedding k n X)
    (Q : Unimodular.SmoothReflexivePresentation n) (hQ : Q.DeeplyMonotone)
    (hanti : Q.carrier = T.unitBoundaryDivisorPolytope)
    (L : TauCeti.AlgebraicGeometry.InvertibleSheaf X.left)
    (hample : IsAmpleModule L.obj) :
    ∃ E : NormalQuadraticSectionEmbedding k X.left L.obj,
      VeryAmpleOverField k X.left L.obj ∧
      IsDomain (E.geometricCoordinateRing k X.left L.obj) ∧
      IsIntegrallyClosed (E.geometricCoordinateRing k X.left L.obj) ∧
      ∃ S : Set (MvPolynomial E.index k),
        E.geometricCoordinateIdeal k X.left L.obj = Ideal.span S ∧
          ∀ p ∈ S, p.IsHomogeneous 2 := by
  have hL : IsInvertibleModule L.obj := (isInvertibleModule_iff_standard L.obj).mpr L.property
  obtain ⟨H, ⟨P⟩⟩ := T.exists_graphicBoundary_of_deeplyMonotone
    L.obj hL hample Q hQ hanti
  obtain ⟨E⟩ := P.ordinary_ample_normalQuadraticEmbedding L.obj hL hample
  exact ⟨E, E.veryAmple k X.left L.obj,
    (E.geometricCoordinateRing_normal_domain k X.left L.obj).1,
    (E.geometricCoordinateRing_normal_domain k X.left L.obj).2,
    E.geometricCoordinateIdeal_quadrics k X.left L.obj⟩

end PaperVerification.ToricSchemes.SplitToricEmbedding

#print axioms PaperVerification.ToricSchemes.SplitToricEmbedding.IntegralGraphicBoundaryPresentation.ordinary_ample_normalQuadraticEmbedding
#print axioms PaperVerification.ToricSchemes.SplitToricEmbedding.corollary_6_11_original_ample_embedding

end
