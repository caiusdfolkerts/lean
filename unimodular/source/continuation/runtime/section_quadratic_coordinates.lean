module

public import Continuation.Runtime.SectionCoordinateRing
public import Continuation.Runtime.GraphicQuadraticRelations

/-!
# Quadrics in the actual degree-one projective coordinates

The universe lift of variable labels is an explicit polynomial algebra
equivalence. It transports the entire kernel and each displayed quadratic
generator. The resulting ideal is the kernel of the independently defined
evaluation by the same actual sections used in the section morphism.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
open AlgebraicGeometry
open PaperVerification.ToricSchemes
open scoped BaseSections

namespace PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

open Unimodular.GraphicSectionRing
open Unimodular.GraphicSectionRing.ActualSections

variable {n : ℕ} {F : SmoothCompleteFan n} (G : F.GraphicCoordinates)
  (k : Type u) [Field k] (D : CartierData (F.fanScheme k))

def liftedQuadraticRelationFamily
    (a : IncompatiblePair (G.constraints (F.cartierCoefficients k F.isPure D))) :
    MvPolynomial (ULift.{u} (Point (G.constraints
      (F.cartierCoefficients k F.isPure D)))) k :=
  MvPolynomial.rename ULift.up (quadraticRelationFamily k a)

theorem liftedQuadraticRelationFamily_homogeneous
    (a : IncompatiblePair (G.constraints (F.cartierCoefficients k F.isPure D))) :
    (G.liftedQuadraticRelationFamily k D a).IsHomogeneous 2 :=
  (quadraticRelationFamily_homogeneous k a).rename_isHomogeneous

/-- The full kernel, not only its initial ideal, is transported through the
literal bijective change of variable labels. -/
theorem liftedCartierPolynomialMap_quadratic_generators :
    RingHom.ker (G.liftedCartierPolynomialMap k D).toRingHom =
      Ideal.span (Set.range (G.liftedQuadraticRelationFamily k D)) := by
  let C := G.constraints (F.cartierCoefficients k F.isPure D)
  let e : MvPolynomial (ULift.{u} (Point C)) k ≃ₐ[k] MvPolynomial (Point C) k :=
    MvPolynomial.renameEquiv k Equiv.ulift
  have he : RingHom.ker (G.liftedCartierPolynomialMap k D).toRingHom =
      (RingHom.ker (G.cartierPolynomialMap k D).toRingHom).comap e.toRingHom := by
    ext p
    rfl
  rw [he, G.cartierPolynomialMap_quadratic_generators k D]
  change Ideal.comap e.toRingEquiv (quadraticRelationIdeal C k) = _
  rw [← Ideal.map_symm e.toRingEquiv, quadraticRelationIdeal, Ideal.map_span]
  apply congrArg Ideal.span
  ext p
  constructor
  · rintro ⟨q, ⟨a, rfl⟩, rfl⟩
    exact ⟨a, rfl⟩
  · rintro ⟨a, rfl⟩
    exact ⟨quadraticRelationFamily k a, ⟨a, rfl⟩, rfl⟩

/-- The ordinary ideal of relations among the actual embedding sections
is generated by homogeneous quadrics. -/
theorem actualCoordinateMap_kernel_quadratic :
    ∃ S : Set (MvPolynomial (ULift.{u} (Point (G.constraints
      (F.cartierCoefficients k F.isPure D)))) k),
      RingHom.ker (degreeOneSectionMap k D.localCocycle
        (polynomialDegreeOneSection k D.localCocycle
          (G.liftedCartierPolynomialMap k D))).toRingHom = Ideal.span S ∧
      ∀ p ∈ S, p.IsHomogeneous 2 := by
  refine ⟨Set.range (G.liftedQuadraticRelationFamily k D), ?_, ?_⟩
  · rw [G.liftedCartierPolynomialMap_eq_actualCoordinateMap k D]
    exact G.liftedCartierPolynomialMap_quadratic_generators k D
  · rintro p ⟨a, rfl⟩
    exact G.liftedQuadraticRelationFamily_homogeneous k D a

#print axioms liftedCartierPolynomialMap_quadratic_generators
#print axioms actualCoordinateMap_kernel_quadratic

end PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

end
