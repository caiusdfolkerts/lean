module

public import Continuation.Runtime.GraphicVeryAmple
public import Continuation.Runtime.SectionQuadraticCoordinates

/-!
# The ample clause: one actual embedding, its coordinate ring, and its quadrics

The data below record an actual finite projective closed immersion and identify
its pulled-back polynomial O(1) with the original ordinary line bundle. Each
pulled-back coordinate is compared with the same genuine section used in the
independently defined section-ring evaluation. Consequently the normal-domain
and quadratic-kernel conclusions concern this embedding's homogeneous
coordinate ring.

The statement retains the paper's projectivity hypothesis. It does not assert
the separate higher-syzygy bound or Property N_p.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicGeometry CategoryTheory TopologicalSpace
open PaperVerification.ToricSchemes
open Unimodular.GraphicSectionRing.ActualSections
open scoped Classical BaseSections

namespace Unimodular.ActualVeryAmple

variable (k : Type) [Field k] (X : Scheme) [IsIntegral X]
  [X.Over (Spec (CommRingCat.of k))] (M : X.Modules)

/-- Explicit ordinary projectively normal embedding data, with a quadratic
ideal. The Cartier cocycle is a proved presentation of the original M, not an
additional hypothesis on it. The coordinate compatibility makes the displayed
evaluation the restriction of the actual homogeneous projective coordinates.
-/
structure NormalQuadraticSectionEmbedding where
  index : Type
  finite : Fintype index
  cocycle : RationalCartierCocycle X
  original : cocycle.sheaf ≅ M
  sections : index → Γ(cocycle.sheaf, ⊤)
  morphism : X ⟶ BondalThomsen.polynomialDegreeOneProj k index
  closed : IsClosedImmersion morphism
  over : morphism ≫ PaperVerification.ToricSchemes.polynomialProjectiveToSpec k index =
    (X ↘ Spec (CommRingCat.of k))
  pullbackIso : (Scheme.Modules.pullback morphism).obj
    (BondalThomsen.polynomialProjDegreeOneSheaf k index) ≅ M
  coordinate : ∀ i,
    BondalThomsen.polynomialProjDegreeOnePullbackCoordinateHom k index morphism i ≫
      pullbackIso.hom =
        BondalThomsen.moduleGlobalSectionHom cocycle.sheaf (sections i) ≫ original.hom
  generated : Function.Surjective (degreeOneSectionMap k cocycle sections)
  domain : IsDomain (sectionCoordinateRing k cocycle sections)
  normal : IsIntegrallyClosed (sectionCoordinateRing k cocycle sections)
  quadrics : ∃ S : Set (MvPolynomial index k),
    RingHom.ker (degreeOneSectionMap k cocycle sections).toRingHom = Ideal.span S ∧
      ∀ p ∈ S, p.IsHomogeneous 2

/-- Forgetting the homogeneous coordinate-ring assertions recovers literal
very ampleness of the same original ordinary line bundle. -/
theorem NormalQuadraticSectionEmbedding.veryAmple
    (E : NormalQuadraticSectionEmbedding k X M) : VeryAmpleOverField k X M :=
  ⟨E.index, E.finite, E.morphism, E.closed, E.over, ⟨E.pullbackIso⟩⟩

end Unimodular.ActualVeryAmple

namespace PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

open Unimodular.GraphicSectionRing
open Unimodular.ActualVeryAmple

variable {n : ℕ} {F : SmoothCompleteFan n} (G : F.GraphicCoordinates)
  (k : Type) [Field k]

include G in
/-- Every ordinary ample invertible sheaf yields one actual closed
embedding, with its original O(1), a normal homogeneous coordinate domain,
and a complete ideal generated by homogeneous quadrics. -/
theorem ordinary_ample_normalQuadraticEmbedding
    (hprojective : HasFiniteProjectiveEmbedding k (F.fanScheme k))
    (M : (F.fanScheme k).Modules) (hM : IsInvertibleModule M)
    (hample : Unimodular.NefBig.IsAmpleModule M) :
    Nonempty (NormalQuadraticSectionEmbedding k (F.fanScheme k) M) := by
  letI : IsProper ((F.fanScheme k) ↘ Spec (CommRingCat.of k)) :=
    isProper_of_projective k (F.fanScheme k) hprojective
  let D := invertibleFractionalPresentation M hM
  let C := D.localCocycle
  let I := ULift (Point (G.constraints (F.cartierCoefficients k F.isPure D)))
  letI : Finite (Point (G.constraints (F.cartierCoefficients k F.isPure D))) :=
    G.points_finite _
  letI : Fintype I := Fintype.ofFinite I
  let Φ := G.liftedCartierPolynomialMap k D
  let s : I → Γ(C.sheaf, ⊤) := polynomialDegreeOneSection k C Φ
  have hC : Unimodular.NefBig.IsAmpleModule C.sheaf :=
    Unimodular.NefBig.isAmpleModule_of_iso D.presentationIso hample
  have hgen : ∀ (N : ℕ) (t : Γ((C.pow N).sheaf, ⊤)),
      ∃ p : MvPolynomial I k, p.IsHomogeneous N ∧
        C.sectionProjectiveFieldMap k s p =
          (C.pow N).toCartierData.sectionValue ⊤ t :=
    G.cartier_homogeneous_generation k D
  let cover := C.nonvanishing_cover_of_homogeneous_generation k s hC hgen
  let f := C.degreeOneSectionMorphism k s hC hgen
  let e := C.sectionProjectiveMap_pullback_degreeOneIso k s cover
  refine ⟨{
    index := I
    finite := inferInstance
    cocycle := C
    original := D.presentationIso.symm
    sections := s
    morphism := f
    closed := C.degreeOneSectionMorphism_isClosedImmersion k s hC hgen
    over := C.sectionProjectiveMap_toSpec k s cover
    pullbackIso := e ≪≫ D.presentationIso.symm
    coordinate := ?_
    generated := ?_
    domain := G.actualCoordinateRing_isDomain k D
    normal := G.actualCoordinateRing_isIntegrallyClosed k D
    quadrics := G.actualCoordinateMap_kernel_quadratic k D
  }⟩
  · intro i
    change BondalThomsen.polynomialProjDegreeOnePullbackCoordinateHom k I
        (C.sectionProjectiveMap k s cover) i ≫
        (e.hom ≫ D.presentationIso.symm.hom) = _
    rw [← Category.assoc]
    exact congrArg (fun g => g ≫ D.presentationIso.symm.hom)
      (C.sectionProjectiveMap_pullback_degreeOneIso_coordinate k s cover i)
  · change Function.Surjective (degreeOneSectionMap k D.localCocycle
      (polynomialDegreeOneSection k D.localCocycle
        (G.liftedCartierPolynomialMap k D)))
    rw [G.liftedCartierPolynomialMap_eq_actualCoordinateMap k D]
    exact G.liftedCartierPolynomialMap_surjective k D

end PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates

namespace PaperVerification.ToricGeometry.SmoothCompleteFan

open Unimodular.ActualVeryAmple

variable {n : ℕ} (F : SmoothCompleteFan n) (k : Type) [Field k]

/-- Corollary 6.11, the complete ample-embedding clause, with the literal
unreflected anticanonical polytope and an arbitrary ordinary ample line bundle.
The separate Property N_p assertion is not part of this theorem. -/
theorem corollary_6_11_ample_embedding_actual
    (hprojective : HasFiniteProjectiveEmbedding k (F.fanScheme k))
    (Q : Unimodular.SmoothReflexivePresentation n) (hQ : Q.DeeplyMonotone)
    (hanti : Q.carrier = F.fanPolytope (fun _ => (1 : ℝ)))
    (L : TauCeti.AlgebraicGeometry.InvertibleSheaf (F.fanScheme k))
    (hample : Unimodular.NefBig.IsAmpleModule L.obj) :
    VeryAmpleOverField k (F.fanScheme k) L.obj ∧
      Nonempty (NormalQuadraticSectionEmbedding k (F.fanScheme k) L.obj) := by
  obtain ⟨G⟩ := F.exists_graphicCoordinates_of_actual_deeplyMonotone_anticanonical
    Q hQ hanti
  have h := G.ordinary_ample_normalQuadraticEmbedding k hprojective L.obj
    ((Unimodular.NefBig.isInvertibleModule_iff_standard L.obj).mpr L.property) hample
  exact ⟨h.elim (fun E => E.veryAmple k (F.fanScheme k) L.obj), h⟩

end PaperVerification.ToricGeometry.SmoothCompleteFan

#print axioms Unimodular.ActualVeryAmple.NormalQuadraticSectionEmbedding.veryAmple
#print axioms PaperVerification.ToricGeometry.SmoothCompleteFan.GraphicCoordinates.ordinary_ample_normalQuadraticEmbedding
#print axioms PaperVerification.ToricGeometry.SmoothCompleteFan.corollary_6_11_ample_embedding_actual

end
