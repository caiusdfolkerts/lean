module

public import Recovery.Unimodular.GraphicSectionRing.GraphicIncidenceLattice

/-!
# From all signed integral columns to the literal graph incidence lattice

The graph retains every supplied column. Its undirected edges identify
opposite orientations and parallel copies only at the graph level; the
original labels and their signed vectors remain in the final equality.
The range equality is an equality of integer submodules, without saturation.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open scoped Classical

namespace Unimodular.IntegralBoundaryGraph
open GraphicRootedLattice

variable {V E : Type*} [Fintype V]

/-- The actual finite graph generated by a loopless labelled edge family. -/
def familyGraph (s t : E → V) (hne : ∀ e, s e ≠ t e) : SimpleGraph V where
  Adj a b := ∃ e, (s e = a ∧ t e = b) ∨ (s e = b ∧ t e = a)
  symm.symm := by
    rintro a b ⟨e, h | h⟩
    · exact ⟨e, Or.inr h⟩
    · exact ⟨e, Or.inl h⟩
  loopless.irrefl := by
    rintro a ⟨e, h | h⟩
    · exact hne e (h.1.trans h.2.symm)
    · exact hne e (h.1.trans h.2.symm)

/-- Every original signed column is an actual edge of the generated graph. -/
theorem familyGraph_adj (s t : E → V) (hne : ∀ e, s e ≠ t e) (e : E) :
    (familyGraph s t hne).Adj (s e) (t e) :=
  ⟨e, Or.inl ⟨rfl, rfl⟩⟩

/-- Reversing and repeating columns leaves their full integral span unchanged. -/
theorem incidenceSpan_eq_span_family (s t : E → V) (hne : ∀ e, s e ≠ t e) :
    incidenceSpan (familyGraph s t hne) =
      Submodule.span ℤ (Set.range (fun e => edge (s e) (t e))) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro x ⟨a, b, ⟨e, h | h⟩, rfl⟩
    · rcases h with ⟨rfl, rfl⟩
      exact Submodule.subset_span ⟨e, rfl⟩
    · rcases h with ⟨rfl, rfl⟩
      have he : edge (t e) (s e) = -edge (s e) (t e) := by
        simp only [edge, neg_sub]
      rw [he]
      exact Submodule.neg_mem _ (Submodule.subset_span ⟨e, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro x ⟨e, rfl⟩
    exact edge_mem_incidenceSpan (familyGraph s t hne) (familyGraph_adj s t hne e)

variable {W : Type*} [AddCommGroup W] [Module ℤ W]

/-- A spanning original lattice family identifies the actual integer range
with the whole graph incidence lattice, including disconnected graphs. -/
theorem range_eq_incidenceSpan (v : E → W)
    (hspan : Submodule.span ℤ (Set.range v) = ⊤)
    (δ : W →ₗ[ℤ] (V → ℤ)) (s t : E → V)
    (hne : ∀ e, s e ≠ t e)
    (hδ : ∀ e, δ (v e) = edge (s e) (t e)) :
    δ.range = incidenceSpan (familyGraph s t hne) := by
  calc
    δ.range = (⊤ : Submodule ℤ W).map δ := (Submodule.map_top δ).symm
    _ = (Submodule.span ℤ (Set.range v)).map δ := by rw [hspan]
    _ = Submodule.span ℤ (δ '' Set.range v) := Submodule.map_span δ _
    _ = Submodule.span ℤ (Set.range (fun e => edge (s e) (t e))) := by
      rw [← Set.range_comp]
      exact congrArg (Submodule.span ℤ) (congrArg Set.range (funext hδ))
    _ = incidenceSpan (familyGraph s t hne) :=
      (incidenceSpan_eq_span_family s t hne).symm

/-- The resulting integral equivalence uses every original vector; no
additional finite-index or saturation hypothesis is introduced. -/
def incidenceEquiv (v : E → W)
    (hspan : Submodule.span ℤ (Set.range v) = ⊤)
    (δ : W →ₗ[ℤ] (V → ℤ)) (hinj : Function.Injective δ)
    (s t : E → V) (hne : ∀ e, s e ≠ t e)
    (hδ : ∀ e, δ (v e) = edge (s e) (t e)) :
    W ≃ₗ[ℤ] incidenceSpan (familyGraph s t hne) :=
  (LinearEquiv.ofInjective δ hinj).trans
    (LinearEquiv.ofEq _ _ (range_eq_incidenceSpan v hspan δ s t hne hδ))

theorem incidenceEquiv_apply (v : E → W)
    (hspan : Submodule.span ℤ (Set.range v) = ⊤)
    (δ : W →ₗ[ℤ] (V → ℤ)) (hinj : Function.Injective δ)
    (s t : E → V) (hne : ∀ e, s e ≠ t e)
    (hδ : ∀ e, δ (v e) = edge (s e) (t e)) (e : E) :
    (incidenceEquiv v hspan δ hinj s t hne hδ (v e)).val = edge (s e) (t e) := by
  simpa only [incidenceEquiv, LinearEquiv.trans_apply,
    LinearEquiv.coe_ofEq_apply, LinearEquiv.ofInjective_apply] using hδ e

end Unimodular.IntegralBoundaryGraph

#print axioms Unimodular.IntegralBoundaryGraph.range_eq_incidenceSpan
#print axioms Unimodular.IntegralBoundaryGraph.incidenceEquiv_apply
