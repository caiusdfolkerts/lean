module

public import Continuation.R10.D5Model
public import Continuation.Runtime.R10Closure

@[expose] public section

/-!
# Proposition 5.1: the complete exceptional smooth Fano example

The conclusion concerns the actual convex hull and its actual extreme points,
every geometric facet, the ordinary matroid on the distinct lattice vertices,
and the intrinsic construction class generated by graphic and cographic
matroids. The construction class is defined independently of R₁₀. Its closure
under relabelling also accounts for all matroid-preserving elementary operations.
-/

noncomputable section
open scoped Matroid

namespace Unimodular.ExplicitR10

/-- The final obstruction clause of Proposition 5.1, for the actual vertex matroid. -/
theorem vertexMatroid_not_constructible :
    ¬R10Maximality.GraphicCographicConstructible vertexMatroid :=
  R10Maximality.not_graphicCographicConstructible_of_r10_minor
    canonicalVertexEmbedding r10_minor_vertices

/-- All assertions of Proposition 5.1 for the completely specified example. -/
theorem proposition_5_1 :
    normalSet.card = 13 ∧
      affineSpan ℝ polytope = ⊤ ∧
      (0 : Ambient 8) ∈ interior polytope ∧
      polytope.extremePoints ℝ = embed '' (normalSet : Set (Lattice 8)) ∧
      IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin 8))
        (fun u : (normalSet : Set (Lattice 8)) ↦ u.val) ∧
      (∀ F, IsFacet polytope F → ∃ b : Module.Basis (Fin 8) ℤ (Lattice 8),
        F.extremePoints ℝ = Set.range (fun i ↦ embed (b i))) ∧
      R10Maximality.r10Matroid.mapEmbedding canonicalVertexEmbedding ≤m vertexMatroid ∧
      ¬R10Maximality.GraphicCographicConstructible vertexMatroid := by
  obtain ⟨hcard, hdim, hzero, hvertices, huniform, hsmooth⟩ := proposition_5_1_geometry
  exact ⟨hcard, hdim, hzero, hvertices, huniform, hsmooth,
    r10_minor_vertices, vertexMatroid_not_constructible⟩

/-- The existential form of Proposition 5.1, without reliance on the chosen
names of the example's lattice vectors, convex hull, or vertex matroid. -/
theorem exists_exceptional_smooth_fano :
    ∃ U : Finset (Lattice 8), U.card = 13 ∧
      let P := convexHull ℝ (embed '' (U : Set (Lattice 8)))
      let M := VectorMatroid.ofFamily (K := ℝ)
        (fun u : (U : Set (Lattice 8)) ↦ embed u.val)
      affineSpan ℝ P = ⊤ ∧
        (0 : Ambient 8) ∈ interior P ∧
        P.extremePoints ℝ = embed '' (U : Set (Lattice 8)) ∧
        IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin 8))
          (fun u : (U : Set (Lattice 8)) ↦ u.val) ∧
        (∀ F, IsFacet P F → ∃ b : Module.Basis (Fin 8) ℤ (Lattice 8),
          F.extremePoints ℝ = Set.range (fun i ↦ embed (b i))) ∧
        (∃ f : Fin 10 ↪ (U : Set (Lattice 8)),
          R10Maximality.r10Matroid.mapEmbedding f ≤m M) ∧
        ¬R10Maximality.GraphicCographicConstructible M := by
  refine ⟨normalSet, normalSet_card, ?_⟩
  change affineSpan ℝ polytope = ⊤ ∧
    (0 : Ambient 8) ∈ interior polytope ∧
    polytope.extremePoints ℝ = embed '' (normalSet : Set (Lattice 8)) ∧
    IntegralRigidity.Uniform (Pi.basisFun ℤ (Fin 8))
      (fun u : (normalSet : Set (Lattice 8)) ↦ u.val) ∧
    (∀ F, IsFacet polytope F → ∃ b : Module.Basis (Fin 8) ℤ (Lattice 8),
      F.extremePoints ℝ = Set.range (fun i ↦ embed (b i))) ∧
    (∃ f : Fin 10 ↪ (normalSet : Set (Lattice 8)),
      R10Maximality.r10Matroid.mapEmbedding f ≤m vertexMatroid) ∧
    ¬R10Maximality.GraphicCographicConstructible vertexMatroid
  obtain ⟨_, hdim, hzero, hvertices, huniform, hsmooth, hminor, hnc⟩ := proposition_5_1
  exact ⟨hdim, hzero, hvertices, huniform, hsmooth, ⟨canonicalVertexEmbedding, hminor⟩, hnc⟩

#print axioms proposition_5_1
#print axioms exists_exceptional_smooth_fano
end Unimodular.ExplicitR10
