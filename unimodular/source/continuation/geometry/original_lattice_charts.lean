module

public import Recovery.Unimodular.GraphicSectionRing.ToricDictionary.Part11
public import Mathlib.LinearAlgebra.Dual.Basis
public import TauCeti.Geometry.Toric.Algebraic.DualSemigroup.Basic

@[expose] public section

/-!
# The actual affine charts in an arbitrary integral lattice

An integral basis identifies integral characters with integer coordinate
vectors.  This file restricts that identification to the literal dual
semigroup of a cone, applies it to semigroup algebras, and then applies
`Spec`.  The resulting isomorphism lands in the existing `coneChart`.
It commutes with the actual character inclusions for every face inclusion.

The lattice and coefficient ring share a universe so the two affine
schemes are objects of the same category.  The ambient real vector space
can live in an independent universe.
-/

noncomputable section

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Opposite
open PaperVerification.ToricCharacters PaperVerification.ToricGeometry
open TauCeti.Toric
open scoped Classical BigOperators

universe u v

namespace PaperVerification.OriginalLatticeCharts

variable {N : Type u} [AddCommGroup N]
    {V : Type v} [AddCommGroup V] [Module ℝ V]
    {n : ℕ} (b : Module.Basis (Fin n) ℤ N)
    {ι : N →+ V} (hi : IsIntegralLattice ι)

/-- Integral characters, with their actual values on the chosen basis. -/
def characterCoordinates : (N →+ ℤ) ≃ₗ[ℤ] Lattice n :=
  (addMonoidHomLequivInt ℤ).trans b.dualBasis.equivFun

@[simp] theorem characterCoordinates_apply (m : N →+ ℤ) (j : Fin n) :
    characterCoordinates b m j = m (b j) := by
  change b.dualBasis.equivFun m.toIntLinearMap j = m (b j)
  rw [Module.Basis.dualBasis_equivFun]
  rfl

/-- The coordinate pairing is evaluation of the original character. -/
theorem integerPairing_characterCoordinates (m : N →+ ℤ) (v : N) :
    PaperVerification.ToricGeometry.integerPairing
      (b.equivFun v) (characterCoordinates b m) = m v := by
  have h := congrArg (fun x => m.toIntLinearMap x) (b.sum_repr v)
  simpa only [PaperVerification.ToricGeometry.integerPairing,
    Module.Basis.equivFun_apply, characterCoordinates_apply,
    map_sum, map_smul, smul_eq_mul, AddMonoidHom.coe_toIntLinearMap] using h

/-- The actual real cone generated by the indicated original lattice vectors. -/
abbrev latticeCone (s : Finset N) : PointedCone ℝ V :=
  PointedCone.hull ℝ (ι '' (s : Set N))

theorem latticeCone_mono {s t : Finset N} (hst : s ⊆ t) :
    latticeCone (ι := ι) s ≤ latticeCone (ι := ι) t :=
  Submodule.span_mono (Set.image_mono (Finset.coe_subset.mpr hst))

/-- No rationality or smoothness hypothesis is needed for this exact
description of the literal integral dual semigroup. -/
theorem mem_dualSemigroup_latticeCone (s : Finset N) (m : N →+ ℤ) :
    m ∈ dualSemigroup hi (latticeCone (ι := ι) s) ↔
      ∀ v ∈ s, 0 ≤ m v :=
  mem_dualSemigroup_hull_image hi (s : Set N) m

/-- Restriction of the integral dual-basis equivalence to the actual
dual semigroups of a cone and its coordinate image. -/
def dualSemigroupCoordinates (s : Finset N) :
    dualSemigroup hi (latticeCone (ι := ι) s) ≃+
      dualConeMonoid (s.image b.equivFun) where
  toFun m := ⟨characterCoordinates b m, by
    intro v hv
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hv
    rw [integerPairing_characterCoordinates]
    exact (mem_dualSemigroup_latticeCone hi s m).mp m.property w hw⟩
  invFun m := ⟨(characterCoordinates b).symm m, by
    apply (mem_dualSemigroup_latticeCone hi s _).mpr
    intro v hv
    have h := m.property (b.equivFun v) (Finset.mem_image.mpr ⟨v, hv, rfl⟩)
    rw [← (characterCoordinates b).apply_symm_apply (m : Lattice n),
      integerPairing_characterCoordinates] at h
    exact h⟩
  left_inv m := Subtype.ext ((characterCoordinates b).symm_apply_apply m)
  right_inv m := Subtype.ext ((characterCoordinates b).apply_symm_apply m)
  map_add' m m' := Subtype.ext
    (map_add (characterCoordinates b) (m : N →+ ℤ) (m' : N →+ ℤ))

@[simp] theorem dualSemigroupCoordinates_coe (s : Finset N)
    (m : dualSemigroup hi (latticeCone (ι := ι) s)) :
    (dualSemigroupCoordinates b hi s m : Lattice n) = characterCoordinates b m := rfl

/-- Literal inclusion of characters from a cone into a face. -/
def dualFaceInclusion {s t : Finset N} (hst : s ⊆ t) :
    dualSemigroup hi (latticeCone (ι := ι) t) →+
      dualSemigroup hi (latticeCone (ι := ι) s) :=
  AddSubmonoid.inclusion (dualSemigroup_anti hi (latticeCone_mono hst))

@[simp] theorem dualFaceInclusion_coe {s t : Finset N} (hst : s ⊆ t)
    (m : dualSemigroup hi (latticeCone (ι := ι) t)) :
    (dualFaceInclusion hi hst m : N →+ ℤ) = m := rfl

variable (k : Type u) [CommRing k]

/-- The ordinary semigroup algebra of the literal original-lattice dual cone. -/
abbrev coordinateRing (s : Finset N) :=
  AddMonoidAlgebra k (dualSemigroup hi (latticeCone (ι := ι) s))

/-- The isomorphism is induced by the actual character map.  Its target
is the chart subalgebra used by the existing glued toric scheme. -/
def coordinateRingEquiv (s : Finset N) :
    coordinateRing hi k s ≃ₐ[k]
      monoidChartAlgebra k (dualConeMonoid (s.image b.equivFun)) :=
  (AddMonoidAlgebra.domCongr k k (dualSemigroupCoordinates b hi s)).trans
    (monoidChartAlgebraEquiv k (dualConeMonoid (s.image b.equivFun)))

/-- The chart isomorphism preserves the character, not merely its index. -/
@[simp] theorem coordinateRingEquiv_single_coe (s : Finset N)
    (m : dualSemigroup hi (latticeCone (ι := ι) s)) (c : k) :
    (coordinateRingEquiv b hi k s (AddMonoidAlgebra.single m c) :
      AddMonoidAlgebra k (Lattice n)) =
        AddMonoidAlgebra.single (characterCoordinates b m) c := by
  change monoidChartMap k _
    (AddMonoidAlgebra.domCongr k k (dualSemigroupCoordinates b hi s)
      (AddMonoidAlgebra.single m c)) = _
  rw [AddMonoidAlgebra.domCongr_single, monoidChartMap_single]
  rfl

/-- The usual semigroup-algebra map associated to a cone inclusion. -/
def coordinateRingFaceMap {s t : Finset N} (hst : s ⊆ t) :
    coordinateRing hi k t →ₐ[k] coordinateRing hi k s :=
  AddMonoidAlgebra.mapDomainAlgHom k k (dualFaceInclusion hi hst)

/-- The square of actual character-algebra inclusions commutes. -/
theorem coordinateRingEquiv_naturality {s t : Finset N} (hst : s ⊆ t) :
    (coordinateRingEquiv b hi k s).toAlgHom.comp (coordinateRingFaceMap hi k hst) =
      (monoidChartInclusion k
        (dualConeMonoid_antitone (Finset.image_subset_image hst))).comp
          (coordinateRingEquiv b hi k t).toAlgHom := by
  apply AlgHom.ext
  intro f
  induction f using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add f g hf hg => simp only [map_add, hf, hg]
  | single m c =>
    apply Subtype.ext
    simp [coordinateRingFaceMap, coordinateRingEquiv_single_coe,
      monoidChartInclusion_coe]

/-- The actual affine scheme `Spec k[σ∨ ∩ Hom(N,ℤ)]`. -/
def affineChart (s : Finset N) : Scheme.{u} :=
  Spec (CommRingCat.of (coordinateRing hi k s))

/-- `Spec` of the literal inclusion of characters along a cone inclusion. -/
def affineFaceMap {s t : Finset N} (hst : s ⊆ t) :
    affineChart hi k s ⟶ affineChart hi k t :=
  Spec.map (CommRingCat.ofHom (coordinateRingFaceMap hi k hst).toRingHom)

/-- Actual affine chart comparison with the existing coordinate chart. -/
def affineChartIso (s : Finset N) :
    affineChart hi k s ≅ coneChart k (s.image b.equivFun) :=
  (Scheme.Spec.mapIso (coordinateRingEquiv b hi k s).toRingEquiv.toCommRingCatIso.op).symm

@[simp] theorem affineChartIso_inv (s : Finset N) :
    (affineChartIso b hi k s).inv =
      Spec.map (CommRingCat.ofHom (coordinateRingEquiv b hi k s).toRingHom) := rfl

/-- The actual affine transition maps agree under the chart isomorphisms. -/
theorem affineChartIso_naturality {s t : Finset N} (hst : s ⊆ t) :
    affineFaceMap hi k hst ≫ (affineChartIso b hi k t).hom =
      (affineChartIso b hi k s).hom ≫
        coneChartFaceMap k (Finset.image_subset_image hst) := by
  apply (cancel_epi (affineChartIso b hi k s).inv).mp
  apply (cancel_mono (affineChartIso b hi k t).inv).mp
  simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id,
    Iso.inv_hom_id_assoc]
  change Spec.map (CommRingCat.ofHom (coordinateRingEquiv b hi k s).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (coordinateRingFaceMap hi k hst).toRingHom) =
    Spec.map (CommRingCat.ofHom
      (monoidChartInclusion k
        (dualConeMonoid_antitone (Finset.image_subset_image hst))).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (coordinateRingEquiv b hi k t).toRingHom)
  rw [← Spec.map_comp, ← Spec.map_comp]
  congr 1
  apply CommRingCat.hom_ext
  exact congrArg AlgHom.toRingHom (coordinateRingEquiv_naturality b hi k hst)

end PaperVerification.OriginalLatticeCharts

#print axioms PaperVerification.OriginalLatticeCharts.affineChartIso_naturality
