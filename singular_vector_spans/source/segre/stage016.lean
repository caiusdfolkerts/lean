section ProbeLayer311



/-!
# Exterior contraction with an existing line coefficient

The terms of the geometric resolution are `Λ^r M ⊗ P_r`. A coefficient
map `φ : M → L` and a bilinear multiplication `L ⊗ P_(r+1) → P_r`
give the actual differential. Consecutive differentials square to zero
when the two coefficient actions commute. Trivializing the three line
modules turns this differential into the ordinary scalar Koszul map.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical TensorProduct BigOperators

namespace PaperVerification.Segre.WeightedContraction

open CoefficientContraction

universe u v w z t
variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable {L : Type w} [AddCommGroup L] [Module R L]
variable {Q : Type z} [AddCommGroup Q] [Module R Q]
variable {P : Type t} [AddCommGroup P] [Module R P]

def coefficientMap (φ : M →ₗ[R] L) (μ : L →ₗ[R] Q →ₗ[R] P) :
    Q →ₗ[R] (M →ₗ[R] P) where
  toFun q := (μ.flip q).comp φ
  map_add' q q' := by
    ext m
    exact (μ (φ m)).map_add q q'
  map_smul' r q := by
    ext m
    exact (μ (φ m)).map_smul r q

@[simp] theorem coefficientMap_apply (φ : M →ₗ[R] L)
    (μ : L →ₗ[R] Q →ₗ[R] P) (q : Q) (m : M) :
    coefficientMap φ μ q m = μ (φ m) q := rfl

/-- The differential retains the actual existing coefficient module. -/
def differential (φ : M →ₗ[R] L) (μ : L →ₗ[R] Q →ₗ[R] P) (n : ℕ) :
    ((⋀[R]^(n+1) M) ⊗[R] Q) →ₗ[R] (⋀[R]^n M) ⊗[R] P :=
  TensorProduct.lift ((contractionLinear n ∘ₗ coefficientMap φ μ).flip)

@[simp] theorem differential_tmul (φ : M →ₗ[R] L)
    (μ : L →ₗ[R] Q →ₗ[R] P) (n : ℕ) (w : ⋀[R]^(n+1) M) (q : Q) :
    differential φ μ n (w ⊗ₜ q) = contraction (coefficientMap φ μ q) n w := rfl

theorem differential_ιMulti_tmul (φ : M →ₗ[R] L)
    (μ : L →ₗ[R] Q →ₗ[R] P) (n : ℕ) (v : Fin (n+1) → M) (q : Q) :
    differential φ μ n (exteriorPower.ιMulti R (n+1) v ⊗ₜ q) =
      ∑ i : Fin (n+1), (-1 : ℤ) ^ (i : ℕ) •
        (exteriorPower.ιMulti R n (i.removeNth v) ⊗ₜ μ (φ (v i)) q) := by
  rw [differential_tmul,contraction_ιMulti]
  rfl

section Square

variable {S : Type*} [AddCommGroup S] [Module R S]

/-- Over a genuine rank-one coefficient module, any two consecutive
bilinear actions commute in their two line arguments. No compatibility
between the remaining coefficient modules is needed for square-zero. -/
theorem actions_commute_of_line_frame (e : L ≃ₗ[R] R)
    (μ : L →ₗ[R] Q →ₗ[R] P) (ν : L →ₗ[R] P →ₗ[R] S)
    (a b : L) (q : Q) : ν a (μ b q) = ν b (μ a q) := by
  let g := e.symm 1
  have hline (l : L) : l = e l • g := by
    apply e.injective
    simp only [map_smul,g,LinearEquiv.apply_symm_apply,smul_eq_mul,mul_one]
  rw [hline a,hline b]
  simp only [map_smul,LinearMap.smul_apply,smul_smul]
  rw [mul_comm (e a) (e b)]

/-- The two coefficient actions, with the original coefficient fixed. -/
def composedPairing (μ : L →ₗ[R] Q →ₗ[R] P)
    (ν : L →ₗ[R] P →ₗ[R] S) (q : Q) : L →ₗ[R] L →ₗ[R] S where
  toFun l := (ν l).comp (μ.flip q)
  map_add' a b := by ext l; exact congrArg (fun f : P →ₗ[R] S => f (μ l q)) (ν.map_add a b)
  map_smul' r a := by ext l; exact congrArg (fun f : P →ₗ[R] S => f (μ l q)) (ν.map_smul r a)

@[simp] theorem composedPairing_apply (μ : L →ₗ[R] Q →ₗ[R] P)
    (ν : L →ₗ[R] P →ₗ[R] S) (q : Q) (a b : L) :
    composedPairing μ ν q a b = ν a (μ b q) := rfl

/-- On actual wedges, the two weighted deletions are the ordinary paired
deletion with the composed coefficient pairing. -/
theorem twice_on_wedge (φ : M →ₗ[R] L) (μ : L →ₗ[R] Q →ₗ[R] P)
    (ν : L →ₗ[R] P →ₗ[R] S) (n : ℕ) (v : Fin (n+2) → M) (q : Q) :
    differential φ ν n
        (differential φ μ (n+1) (exteriorPower.ιMulti R (n+2) v ⊗ₜ q)) =
      CoefficientContraction.pairedContraction φ (composedPairing μ ν q) n
        (contraction φ (n+1) (exteriorPower.ιMulti R (n+2) v)) := by
  simp only [differential_ιMulti_tmul,contraction_ιMulti,map_sum,map_zsmul,
    CoefficientContraction.pairedContraction_tmul,
    CoefficientContraction.pairedCoefficient_apply,composedPairing_apply]

/-- The complete weighted square-zero law. The hypothesis is the actual
commutation of the two bilinear coefficient multiplications. -/
theorem differential_squared (φ : M →ₗ[R] L) (μ : L →ₗ[R] Q →ₗ[R] P)
    (ν : L →ₗ[R] P →ₗ[R] S)
    (hcomm : ∀ a b q, ν a (μ b q) = ν b (μ a q)) (n : ℕ) :
    differential φ ν n ∘ₗ differential φ μ (n+1) = 0 := by
  apply TensorProduct.ext'
  intro w q
  have h : differential φ ν n ∘ₗ differential φ μ (n+1) ∘ₗ
        (TensorProduct.mk R _ Q).flip q =
      CoefficientContraction.pairedContraction φ (composedPairing μ ν q) n ∘ₗ
        contraction φ (n+1) := by
    apply exteriorPower.linearMap_ext
      (R := R) (M := M) (N := (⋀[R]^n M) ⊗[R] S) (n := n + 2)
    apply AlternatingMap.ext
    intro v
    exact twice_on_wedge φ μ ν n v q
  change differential φ ν n (differential φ μ (n+1) (w ⊗ₜ q)) = 0
  have hw : differential φ ν n (differential φ μ (n+1) (w ⊗ₜ q)) =
      CoefficientContraction.pairedContraction φ (composedPairing μ ν q) n
        (contraction φ (n+1) w) := LinearMap.congr_fun h w
  rw [hw]
  have hz := CoefficientContraction.pairedContraction_comp_contraction_eq_zero
    φ (composedPairing μ ν q) (fun a b => hcomm a b q) n
  exact LinearMap.congr_fun hz w

end Square

/-- The actual linear identification after a coefficient line is
trivialized. Its action is scalar multiplication of the exterior vector. -/
def scalarize (e : Q ≃ₗ[R] R) (n : ℕ) :
    ((⋀[R]^n M) ⊗[R] Q) ≃ₗ[R] ⋀[R]^n M :=
  TensorProduct.congr (LinearEquiv.refl R _) e ≪≫ₗ TensorProduct.rid R _

@[simp] theorem scalarize_tmul (e : Q ≃ₗ[R] R) (n : ℕ)
    (w : ⋀[R]^n M) (q : Q) : scalarize (M := M) e n (w ⊗ₜ q) = e q • w := by
  simp only [scalarize,LinearEquiv.trans_apply,TensorProduct.congr_tmul,
    LinearEquiv.refl_apply,TensorProduct.rid_tmul]

/-- Under actual compatible line frames the weighted differential is
exactly the scalar Koszul differential, including all signs. -/
theorem scalarize_differential (φ : M →ₗ[R] L) (μ : L →ₗ[R] Q →ₗ[R] P)
    (eL : L ≃ₗ[R] R) (eQ : Q ≃ₗ[R] R) (eP : P ≃ₗ[R] R)
    (hμ : ∀ l q, eP (μ l q) = eL l * eQ q) (n : ℕ) :
    (scalarize (M := M) eP n).toLinearMap ∘ₗ differential φ μ n =
      TauCeti.koszulDifferential (eL.toLinearMap.comp φ) n ∘ₗ
        (scalarize (M := M) eQ (n+1)).toLinearMap := by
  apply TensorProduct.ext'
  intro w q
  have h : ((scalarize (M := M) eP n).toLinearMap ∘ₗ
      differential φ μ n ∘ₗ (TensorProduct.mk R _ Q).flip q) =
      TauCeti.koszulDifferential (eL.toLinearMap.comp φ) n ∘ₗ
        (scalarize (M := M) eQ (n+1)).toLinearMap ∘ₗ
          (TensorProduct.mk R _ Q).flip q := by
    apply exteriorPower.linearMap_ext
    apply AlternatingMap.ext
    intro v
    simp only [LinearMap.compAlternatingMap_apply,LinearMap.comp_apply,
      TensorProduct.mk_apply,LinearMap.flip_apply,differential_ιMulti_tmul,
      map_sum,map_zsmul,LinearEquiv.coe_coe,scalarize_tmul,hμ,
      TauCeti.koszulDifferential_ιMulti,map_smul,Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [←Int.cast_smul_eq_zsmul R,Int.cast_pow,Int.cast_neg,Int.cast_one,
      smul_smul,smul_smul]
    congr 1
    ring
  exact LinearMap.congr_fun h w

end PaperVerification.Segre.WeightedContraction
end
end
end ProbeLayer311

