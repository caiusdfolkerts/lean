/-!
# The affine external-tensor algebra identity

Two different base changes occur on a fibre-product rectangle.  This lemma
combines their actual universal properties and proves the canonical
pure-tensor formula.  It is the algebraic comparison used for the sections of
an external tensor product; no freeness or flatness is needed.
-/

@[expose] public section

noncomputable section
open scoped TensorProduct

namespace PaperVerification.Segre.ExternalTensorAlgebra

universe u
variable {R A S : Type u} [CommRing R] [CommRing A] [CommRing S]
  [Algebra R A] [Algebra A S] [Algebra R S] [IsScalarTower R A S]
  {M N P Q : Type u}
  [AddCommGroup M] [Module A M] [Module R M] [IsScalarTower R A M]
  [AddCommGroup N] [Module R N]
  [AddCommGroup P] [Module S P] [Module A P] [Module R P]
  [IsScalarTower A S P] [IsScalarTower R S P] [IsScalarTower R A P]
  [AddCommGroup Q] [Module S Q] [Module A Q] [Module R Q]
  [IsScalarTower A S Q] [IsScalarTower R S Q] [IsScalarTower R A Q]
  (f : M →ₗ[A] P) (g : N →ₗ[R] Q)
  (hf : IsBaseChange S f) (hg : IsBaseChange A g)

/-- The actual module on the fibre-product rectangle is the tensor product
over the original base. -/
def mixedBaseChangeTensorEquiv : P ⊗[S] Q ≃ₗ[R] M ⊗[R] N :=
  (TensorProduct.comm S P Q).restrictScalars R ≪≫ₗ
    (hf.tensorEquiv Q).restrictScalars R ≪≫ₗ
    (TensorProduct.comm A Q M).restrictScalars R ≪≫ₗ
    (LinearEquiv.lTensor M hg.equiv.symm).restrictScalars R ≪≫ₗ
    (TensorProduct.AlgebraTensorModule.cancelBaseChange R A A M N).restrictScalars R

/-- The forward comparison recovers the original pure tensor. -/
@[simp]
theorem mixedBaseChangeTensorEquiv_tmul (m : M) (n : N) :
    mixedBaseChangeTensorEquiv f g hf hg (f m ⊗ₜ[S] g n) = m ⊗ₜ[R] n := by
  simp [mixedBaseChangeTensorEquiv, IsBaseChange.tensorEquiv,
    IsBaseChange.equiv_symm_apply]

/-- The inverse comparison is precisely the tensor of the two actual
pullback-of-sections maps. -/
@[simp]
theorem mixedBaseChangeTensorEquiv_symm_tmul (m : M) (n : N) :
    (mixedBaseChangeTensorEquiv f g hf hg).symm (m ⊗ₜ[R] n) =
      f m ⊗ₜ[S] g n := by
  apply (mixedBaseChangeTensorEquiv f g hf hg).injective
  simp

/-- The canonical external-tensor map is bijective. -/
theorem mixedBaseChangeTensorMap_bijective :
    Function.Bijective ((mixedBaseChangeTensorEquiv f g hf hg).symm :
      M ⊗[R] N → P ⊗[S] Q) :=
  (mixedBaseChangeTensorEquiv f g hf hg).symm.bijective

section Naturality

variable {M' N' P' Q' : Type u}
  [AddCommGroup M'] [Module A M'] [Module R M'] [IsScalarTower R A M']
  [AddCommGroup N'] [Module R N']
  [AddCommGroup P'] [Module S P'] [Module A P'] [Module R P']
  [IsScalarTower A S P'] [IsScalarTower R S P'] [IsScalarTower R A P']
  [AddCommGroup Q'] [Module S Q'] [Module A Q'] [Module R Q']
  [IsScalarTower A S Q'] [IsScalarTower R S Q'] [IsScalarTower R A Q']
  (f' : M' →ₗ[A] P') (g' : N' →ₗ[R] Q')
  (hf' : IsBaseChange S f') (hg' : IsBaseChange A g')
  (a : M →ₗ[A] M') (b : N →ₗ[R] N')
  (c : P →ₗ[S] P') (d : Q →ₗ[S] Q')
  (hcf : ∀ m, c (f m) = f' (a m))
  (hdg : ∀ n, d (g n) = g' (b n))

include hcf hdg in
/-- Naturality follows on pure tensors from the actual two commuting
pullback squares, with no independent compatibility hypothesis. -/
theorem mixedBaseChangeTensorEquiv_natural :
    (TensorProduct.map c d).restrictScalars R ∘ₗ
        (mixedBaseChangeTensorEquiv f g hf hg).symm.toLinearMap =
      (mixedBaseChangeTensorEquiv f' g' hf' hg').symm.toLinearMap ∘ₗ
        TensorProduct.map (a.restrictScalars R) b := by
  ext m n
  simp [hcf, hdg]

end Naturality
end PaperVerification.Segre.ExternalTensorAlgebra
end
end
