section ProbeLayer237



/-!
# Tensor products and actual affine sections

The tensor comparison here is the genuine lax monoidal comparison of global
sections of the sheaf tensor product.  Its invertibility for quasicoherent
sheaves is proved from the tilde equivalence, including the pure-tensor
identity.  It is not supplied as an extra geometric hypothesis.
-/

@[expose] public section

noncomputable section
open CategoryTheory CategoryTheory.Limits MonoidalCategory
open CategoryTheory.Functor.LaxMonoidal CategoryTheory.Functor.Monoidal
open AlgebraicGeometry AlgebraicGeometry.Scheme.Modules

namespace PaperVerification.Segre.AffineTensorSections

universe u
variable {R : CommRingCat.{u}}

/-- The actual underlying presheaf-of-modules functor. -/
def forgetSpec :
    (Spec R).Modules ⥤ PresheafOfModulesOfCommRing.{u} (Spec R).presheaf :=
  _root_.SheafOfModules.forget _

instance : (forgetSpec (R := R)).LaxMonoidal :=
  TauCeti.SheafOfModules.forgetLaxMonoidal (Spec R).sheaf

/-- Actual global sections, with scalars transported along the canonical
coordinate-ring isomorphism of an affine spectrum. -/
def globalSections : (Spec R).Modules ⥤ ModuleCat.{u} R :=
  forgetSpec ⋙ TauCeti.PresheafOfModulesOfCommRing.evaluation (Opposite.op ⊤) ⋙
    ModuleCat.restrictScalars (Scheme.ΓSpecIso R).inv.hom

instance : (globalSections (R := R)).LaxMonoidal := by
  unfold globalSections
  infer_instance

/-- The existing tilde-adjunction sections functor has exactly these sections. -/
def specΓIso : moduleSpecΓFunctor (R := R) ≅ globalSections :=
  NatIso.ofComponents (fun M ↦
    let e : moduleSpecΓFunctor.obj M ≃ₗ[R] globalSections.obj M :=
      { AddEquiv.refl _ with
        map_smul' := fun r x ↦ by
          have h : ((Spec R).ringCatSheaf.obj.map
              ((initialOpOfTerminal isTerminalTop).to (.op ⊤))).hom = RingHom.id _ := by
            rw [IsInitial.to_self, CategoryTheory.Functor.map_id]
            rfl
          exact congrArg (fun f : _ →+* _ ↦ f ((Scheme.ΓSpecIso R).inv.hom r) •
            (show M.val.obj (.op ⊤) from x)) h }
    e.toModuleIso)
    (fun _ ↦ by ext; rfl)

/-- The actual global-section unit for a sheaf associated with a module. -/
def tildeSectionIso (M : ModuleCat.{u} R) :
    M ≅ globalSections.obj (tilde M) :=
  (tilde.toTildeΓNatIso (R := R)).app M ≪≫ (specΓIso (R := R)).app (tilde M)

/-- On pure tensors, the genuine global-section tensor map is the underlying
sheaf tensor map on global sections. -/
theorem globalSections_μ_apply (M N : (Spec R).Modules)
    (m : globalSections.obj M) (n : globalSections.obj N) :
    μ globalSections M N (m ⊗ₜ n) =
      (μ forgetSpec M N).app' (.op ⊤)
        ((show M.val.obj (.op ⊤) from m) ⊗ₜ
          (show N.val.obj (.op ⊤) from n)) := by
  exact congrArg (fun x ↦
    (μ forgetSpec M N).app' (.op ⊤) x)
      (ModuleCat.restrictScalars_μ_tmul (Scheme.ΓSpecIso R).inv.hom _ _ m n)

/-- Compatibility with the proved monoidal tilde comparison. -/
theorem tilde_sections_tensor (M N : ModuleCat.{u} R) :
    ((tildeSectionIso M).hom ⊗ₘ (tildeSectionIso N).hom) ≫
        μ globalSections (tilde M) (tilde N) ≫
        globalSections.map (μ (tilde.functor R) M N) =
      (tildeSectionIso (M ⊗ N)).hom := by
  apply ModuleCat.MonoidalCategory.tensor_ext
  intro m n
  simp only [ConcreteCategory.comp_apply, ModuleCat.MonoidalCategory.tensorHom_tmul]
  rw [globalSections_μ_apply]
  exact TauCeti.AlgebraicGeometry.tilde_μ_app_top_toOpen M N m n

/-- The genuine global-section tensor comparison is invertible on associated
sheaves, proved using the actual pure-tensor identity. -/
instance isIso_μ_tilde (M N : ModuleCat.{u} R) :
    IsIso (μ globalSections (tilde M) (tilde N)) := by
  have h : IsIso (((tildeSectionIso M).hom ⊗ₘ (tildeSectionIso N).hom) ≫
      μ globalSections (tilde M) (tilde N) ≫
      globalSections.map (μ (tilde.functor R) M N)) := by
    rw [tilde_sections_tensor]
    exact (tildeSectionIso (M ⊗ N)).isIso_hom
  have hcomp : IsIso (μ globalSections (tilde M) (tilde N) ≫
      globalSections.map (μ (tilde.functor R) M N)) :=
    IsIso.of_isIso_comp_left
      ((tildeSectionIso M).hom ⊗ₘ (tildeSectionIso N).hom) _
  letI : IsIso (μ (tilde.functor R) M N) :=
    (Functor.Monoidal.μIso (tilde.functor R) M N).isIso_hom
  have hmap : IsIso (globalSections.map (μ (tilde.functor R) M N)) :=
    Functor.map_isIso globalSections _
  exact @IsIso.of_isIso_comp_right (ModuleCat R) _ _ _ _
    (μ globalSections (tilde M) (tilde N))
    (globalSections.map (μ (tilde.functor R) M N)) hmap hcomp

/-- Actual global sections commute with tensor products of arbitrary
quasicoherent sheaves on an affine spectrum. -/
instance isIso_μ_of_quasicoherent (M N : (Spec R).Modules)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    IsIso (μ globalSections M N) := by
  let eM := asIso M.fromTildeΓ
  let eN := asIso N.fromTildeΓ
  have h : IsIso ((globalSections.map eM.hom ⊗ₘ globalSections.map eN.hom) ≫
      μ globalSections M N) := by
    rw [Functor.LaxMonoidal.μ_natural]
    infer_instance
  exact IsIso.of_isIso_comp_left
    (globalSections.map eM.hom ⊗ₘ globalSections.map eN.hom)
    (μ globalSections M N)

/-- The canonical tensor isomorphism of actual global sections. -/
def tensorSectionsIso (M N : (Spec R).Modules)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    globalSections.obj M ⊗ globalSections.obj N ≅ globalSections.obj (M ⊗ N) :=
  asIso (μ globalSections M N)

@[reassoc]
theorem tensorSectionsIso_natural
    {M M' N N' : (Spec R).Modules}
    [M.IsQuasicoherent] [M'.IsQuasicoherent]
    [N.IsQuasicoherent] [N'.IsQuasicoherent]
    (f : M ⟶ M') (g : N ⟶ N') :
    (globalSections.map f ⊗ₘ globalSections.map g) ≫
        (tensorSectionsIso M' N').hom =
      (tensorSectionsIso M N).hom ≫ globalSections.map (f ⊗ₘ g) :=
  Functor.LaxMonoidal.μ_natural globalSections f g


section AffineOpen

variable {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)

/-- The actual affine chart identification, natural in the module sheaf. -/
def chartSectionsIso :
    Scheme.Modules.sectionsFunctor U ≅
      Scheme.Modules.restrictFunctor hU.fromSpec ⋙
        (globalSections (R := Γ(X, U))) :=
  NatIso.ofComponents
    (fun M ↦ (M.fromSpecSectionsEquiv hU).toModuleIso ≪≫
      (specΓIso (R := Γ(X, U))).app (M.restrict hU.fromSpec))
    (fun f ↦ by
      ext x
      exact (Scheme.Modules.Hom.fromSpecSectionsEquiv_naturality _ f hU x).symm)

/-- Sections on an arbitrary affine open of the actual tensor sheaf are the
tensor product of the two section modules.  The construction uses only the
genuine affine chart and the proved restriction/tensor comparison. -/
def affineTensorSectionsIso (M N : X.Modules)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    (Scheme.Modules.sectionsFunctor U).obj M ⊗
        (Scheme.Modules.sectionsFunctor U).obj N ≅
      (Scheme.Modules.sectionsFunctor U).obj (M ⊗ N) :=
  tensorIso ((chartSectionsIso hU).app M) ((chartSectionsIso hU).app N) ≪≫
    tensorSectionsIso (M.restrict hU.fromSpec) (N.restrict hU.fromSpec) ≪≫
    globalSections.mapIso
      (asIso (μ (Scheme.Modules.restrictFunctor hU.fromSpec) M N)) ≪≫
    ((chartSectionsIso hU).app (M ⊗ N)).symm

/-- The affine tensor comparison retains its naturality in both actual sheaves. -/
@[reassoc]
theorem affineTensorSectionsIso_natural
    {M M' N N' : X.Modules}
    [M.IsQuasicoherent] [M'.IsQuasicoherent]
    [N.IsQuasicoherent] [N'.IsQuasicoherent]
    (f : M ⟶ M') (g : N ⟶ N') :
    ((Scheme.Modules.sectionsFunctor U).map f ⊗ₘ
      (Scheme.Modules.sectionsFunctor U).map g) ≫
        (affineTensorSectionsIso hU M' N').hom =
      (affineTensorSectionsIso hU M N).hom ≫
        (Scheme.Modules.sectionsFunctor U).map (f ⊗ₘ g) := by
  dsimp only [affineTensorSectionsIso, Iso.trans_hom, tensorIso_hom, Iso.symm_hom,
    Functor.mapIso_hom, asIso_hom, Iso.app_hom, Iso.app_inv]
  rw [tensorHom_comp_tensorHom_assoc,
    (chartSectionsIso hU).hom.naturality f,
    (chartSectionsIso hU).hom.naturality g,
    ← tensorHom_comp_tensorHom_assoc]
  simp only [Functor.comp_map]
  rw [tensorSectionsIso_natural_assoc]
  rw [← Functor.map_comp_assoc, Functor.LaxMonoidal.μ_natural,
    Functor.map_comp]
  have hn := (chartSectionsIso hU).inv.naturality (f ⊗ₘ g)
  dsimp only [Functor.comp_map] at hn
  simp only [Category.assoc]
  rw [hn]

end AffineOpen

end PaperVerification.Segre.AffineTensorSections
end
end
end ProbeLayer237

section ProbeLayer238



/-!
# Pullback sections on any contained affine source open

This extends the affine pullback comparison to U and V with V contained
in f inverse-image U, rather than requiring equality.  It is proved by
the same actual chart and adjunction-unit comparison as TauCeti's
Pullback/BaseChange.lean (Apache 2.0, pinned commit 06d5bb4), with the containment
carried through every map.  The pure-tensor identity identifies the
canonical section pullback, which is needed on product rectangles.
-/

@[expose] public section

noncomputable section
open CategoryTheory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open scoped ChangeOfRings TensorProduct

namespace PaperVerification.Segre.AffinePullbackSections

universe u
variable {X : Scheme.{u}} (M : X.Modules) {U : X.Opens} (hU : IsAffineOpen U)

/-- The affine chart equivalence and restriction/pullback comparison carry
a local section to its actual pulled-back section. -/
theorem chartPullback_unit (s : Γ(M,U)) :
    ((restrictFunctorIsoPullback hU.fromSpec).hom.app M).app ⊤
      (M.fromSpecSectionsEquiv hU s) =
    Scheme.Hom.pullbackSectionsLE hU.fromSpec M U ⊤
      (hU.fromSpec_preimage_self.ge) s := by
  have h : (restrictAdjunction hU.fromSpec).unit.app M ≫
      (pushforward hU.fromSpec).map ((restrictFunctorIsoPullback hU.fromSpec).hom.app M) =
      (pullbackPushforwardAdjunction hU.fromSpec).unit.app M :=
    Adjunction.unit_leftAdjointUniq_hom_app (restrictAdjunction hU.fromSpec)
      (pullbackPushforwardAdjunction hU.fromSpec) M
  have he := congrArg (fun a ↦ a.app U s) h
  simp only [Hom.comp_app,pushforward_map_app,restrictAdjunction_unit_app_app] at he
  have he' : ((restrictFunctorIsoPullback hU.fromSpec).hom.app M).app
      (hU.fromSpec ⁻¹ᵁ U)
      (M.presheaf.map (homOfLE (hU.fromSpec.image_preimage_le U)).op s) =
      hU.fromSpec.pullbackSections M U s := by
    rw [Scheme.Hom.pullbackSections_apply]
    exact he
  have hn := PresheafOfModules.naturality_apply
    ((restrictFunctorIsoPullback hU.fromSpec).hom.app M).val
    (homOfLE hU.fromSpec_preimage_self.ge).op
    (M.presheaf.map (homOfLE (hU.fromSpec.image_preimage_le U)).op s)
  have hs : M.fromSpecSectionsEquiv hU s =
      (M.restrict hU.fromSpec).presheaf.map (homOfLE hU.fromSpec_preimage_self.ge).op
      (M.presheaf.map (homOfLE (hU.fromSpec.image_preimage_le U)).op s) := by
    rw [fromSpecSectionsEquiv_apply]
    apply (ConcreteCategory.bijective_of_isIso
      (M.restrictAppIso hU.fromSpec ⊤).hom).injective
    rw [← ConcreteCategory.comp_apply,Iso.inv_hom_id,ConcreteCategory.id_apply]
    change M.presheaf.map _ s = M.presheaf.map _ (M.presheaf.map _ s)
    rw [← M.presheaf.map_comp_apply]
    rfl
  rw [hs,Scheme.Hom.pullbackSectionsLE_apply]
  exact hn.trans (congrArg
    (((pullback hU.fromSpec).obj M).presheaf.map
      (homOfLE hU.fromSpec_preimage_self.ge).op) he')

theorem chartPullback_unit_inv (s : Γ(M,U)) :
    ((restrictFunctorIsoPullback hU.fromSpec).inv.app M).app ⊤
      (hU.fromSpec.pullbackSectionsLE M U ⊤ hU.fromSpec_preimage_self.ge s) =
      M.fromSpecSectionsEquiv hU s := by
  rw [← chartPullback_unit M hU]
  exact congrArg (fun a ↦ a.app ⊤ (M.fromSpecSectionsEquiv hU s))
    ((restrictFunctorIsoPullback hU.fromSpec).app M).hom_inv_id

section Source
variable {Y : Scheme.{u}} (f : Y ⟶ X)
  {V : Y.Opens} (hV : IsAffineOpen V) (h : V ≤ f ⁻¹ᵁ U)

/-- The actual pullback restricted to the affine chart of V is the
pullback of the restricted sheaf along the induced coordinate-ring map. -/
def chartPullbackIso :
    ((pullback f).obj M).restrict hV.fromSpec ≅
      (pullback (Spec.map (f.appLE U V h))).obj (M.restrict hU.fromSpec) :=
  (restrictFunctorIsoPullback hV.fromSpec).app _ ≪≫
    (pullbackComp hV.fromSpec f).app M ≪≫
    (pullbackCongr (IsAffineOpen.SpecMap_appLE_fromSpec f hU hV h).symm).app M ≪≫
    ((pullbackComp (Spec.map (f.appLE U V h)) hU.fromSpec).app M).symm ≪≫
    (pullback (Spec.map (f.appLE U V h))).mapIso
      ((restrictFunctorIsoPullback hU.fromSpec).app M).symm

/-- The chart isomorphism retains the actual pullback of each section. -/
theorem chartPullbackIso_unit (s : Γ(M,U)) :
    (chartPullbackIso M hU f hV h).hom.app ⊤
      (((pullback f).obj M).fromSpecSectionsEquiv hV
        (f.pullbackSectionsLE M U V h s)) =
      (Spec.map (f.appLE U V h)).pullbackSectionsLE
        (M.restrict hU.fromSpec) ⊤ ⊤ (by simp)
        (M.fromSpecSectionsEquiv hU s) := by
  simp only [chartPullbackIso,Iso.trans_hom,Iso.symm_hom,Hom.comp_app,
    ConcreteCategory.comp_apply,Functor.mapIso_hom,Iso.app_hom,Iso.app_inv]
  rw [chartPullback_unit]
  rw [Scheme.Hom.pullbackSectionsLE_comp_hom]
  rw [Scheme.Hom.pullbackSectionsLE_congr]
  rw [Scheme.Hom.pullbackSectionsLE_comp]
  · rw [Scheme.Hom.pullbackSectionsLE_naturality,chartPullback_unit_inv]
  · exact hU.fromSpec_preimage_self.ge

/-- Sections of a quasi-coherent pullback over an arbitrary contained
affine source open are extension of scalars along the actual local ring map. -/
def pullbackSectionsLEEquiv [M.IsQuasicoherent] :
    (ModuleCat.extendScalars (f.appLE U V h).hom).obj
      (.of Γ(X,U) Γ(M,U)) ≃ₗ[Γ(Y,V)] Γ((pullback f).obj M,V) := by
  let eM := M.fromSpecSectionsEquiv hU
  let eP := ((pullback f).obj M).fromSpecSectionsEquiv hV
  let eQ := ((moduleSpecΓFunctor (R := Γ(Y,V))).mapIso
    (chartPullbackIso M hU f hV h)).toLinearEquiv
  let e := (f.appLE U V h).moduleSpecΓPullbackIso (M.restrict hU.fromSpec)
  letI := (f.appLE U V h).hom.toAlgebra
  exact (eM.baseChange Γ(X,U) Γ(Y,V)).trans
    (e.toLinearEquiv.trans (eQ.symm.trans eP.symm))

/-- The affine comparison sends 1 tensor a section to its actual pullback
and restriction on V. -/
theorem pullbackSectionsLEEquiv_one_tmul [M.IsQuasicoherent] (s : Γ(M,U)) :
    pullbackSectionsLEEquiv M hU f hV h
      ((1 : Γ(Y,V)) ⊗ₜ[Γ(X,U),(f.appLE U V h).hom] s) =
      f.pullbackSectionsLE M U V h s := by
  letI := (f.appLE U V h).hom.toAlgebra
  let eM := M.fromSpecSectionsEquiv hU
  let eP := ((pullback f).obj M).fromSpecSectionsEquiv hV
  let eQ := ((moduleSpecΓFunctor (R := Γ(Y,V))).mapIso
    (chartPullbackIso M hU f hV h)).toLinearEquiv
  let e := (f.appLE U V h).moduleSpecΓPullbackIso (M.restrict hU.fromSpec)
  apply eP.injective
  apply eQ.injective
  have hc : eQ (eP (pullbackSectionsLEEquiv M hU f hV h
      ((1 : Γ(Y,V)) ⊗ₜ[Γ(X,U),(f.appLE U V h).hom] s))) =
      e.toLinearEquiv ((1 : Γ(Y,V)) ⊗ₜ[Γ(X,U),(f.appLE U V h).hom] eM s) := by
    let z := e.toLinearEquiv
      ((eM.baseChange Γ(X,U) Γ(Y,V))
        ((1 : Γ(Y,V)) ⊗ₜ[Γ(X,U),(f.appLE U V h).hom] s))
    change eQ (eP (eP.symm (eQ.symm z))) = _
    exact (congrArg eQ (eP.apply_symm_apply (eQ.symm z))).trans
      ((eQ.apply_symm_apply z).trans (by rfl))
  have hu := (f.appLE U V h).moduleSpecΓPullback_app_one_tmul
    (M.restrict hU.fromSpec) (eM s)
  rw [← CommRingCat.Hom.moduleSpecΓPullbackIso_hom] at hu
  have hu' := (Iso.toLinearEquiv_apply e
    ((1 : Γ(Y,V)) ⊗ₜ[Γ(X,U),(f.appLE U V h).hom] eM s)).trans hu
  refine hc.trans (hu'.trans ?_)
  change ((pullbackPushforwardAdjunction (Spec.map (f.appLE U V h))).unit.app
      (M.restrict hU.fromSpec)).app ⊤ (M.fromSpecSectionsEquiv hU s) =
    (chartPullbackIso M hU f hV h).hom.app ⊤
      (((pullback f).obj M).fromSpecSectionsEquiv hV
        (f.pullbackSectionsLE M U V h s))
  have htop :
      (Spec.map (f.appLE U V h)).pullbackSectionsLE
        (M.restrict hU.fromSpec) ⊤ ⊤ (by simp) (M.fromSpecSectionsEquiv hU s) =
      ((pullbackPushforwardAdjunction (Spec.map (f.appLE U V h))).unit.app
        (M.restrict hU.fromSpec)).app ⊤ (M.fromSpecSectionsEquiv hU s) := by
    erw [Scheme.Hom.pullbackSectionsLE_apply,Scheme.Hom.pullbackSections_apply]
    change ((pullback (Spec.map (f.appLE U V h))).obj
      (M.restrict hU.fromSpec)).presheaf.map (𝟙 (op ⊤)) _ = _
    erw [CategoryTheory.Functor.map_id] <;> rfl
  exact htop.symm.trans (chartPullbackIso_unit M hU f hV h s).symm

end Source
