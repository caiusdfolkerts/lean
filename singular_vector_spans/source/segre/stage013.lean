/-!
# The vanishing criterion for an actual acyclic sheaf resolution

This supplies the converse to the existing exactness-of-sections theorem.
Both sides use the genuine sheaf cohomology and the genuine section complex.
-/

@[expose] public section

noncomputable section
open CategoryTheory CategoryTheory.Limits Opposite

namespace PaperVerification.Segre.AcyclicResolution

universe w v u

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [HasSheafify J AddCommGrpCat.{v}]
  [HasExt.{w} (Sheaf J AddCommGrpCat.{v})]
  {F : Sheaf J AddCommGrpCat.{v}}
  {K : CochainComplex (Sheaf J AddCommGrpCat.{v}) ℕ}
  (ι : F ⟶ K.X 0) [Mono ι] (hι : ι ≫ K.d 0 1 = 0)
  (hι' : (ShortComplex.mk ι (K.d 0 1) hι).Exact)
  (hK : ∀ j, K.ExactAt (j + 1)) (V : C)
  (hKV : ∀ j k, Subsingleton ((K.X j).H' (k + 1) V))

include hι' hK hKV in
/-- Backward dimension shifting along the actual cycles of the resolution. -/
theorem subsingleton_of_cycles (j k : ℕ)
    (h : Subsingleton ((K.cycles (j + 1)).H' (k + 1) V)) :
    Subsingleton (F.H' (j + k + 2) V) := by
  induction j generalizing k with
  | zero =>
    simpa only [zero_add] using
      Sheaf.H'.subsingleton_X₁
        (K.shortExact_toCycles ι hι hι' (by simp) (hK 0)) V (k + 1) h
        (hKV 0 (k + 1))
  | succ j ih =>
    have hS := K.cyclesShortComplex_shortExact (j + 1) (j + 2)
      (by simp) (hK (j + 1))
    rw [HomologicalComplex.cyclesShortComplex_def] at hS
    have hprev : Subsingleton ((K.cycles (j + 1)).H' (k + 2) V) :=
      Sheaf.H'.subsingleton_X₁ hS V (k + 1) h (hKV (j + 1) (k + 1))
    simpa only [show j + (k + 1) + 2 = j + 1 + k + 2 by omega] using
      ih (k + 1) hprev

/-- Exactness at a section degree makes the preceding differential onto the
sections of the actual cycle sheaf. -/
theorem toCycles_sections_surjective (n : ℕ)
    (hex : ∀ s : (K.X (n + 1)).obj.obj (op V),
      (K.d (n + 1) (n + 2)).hom.app (op V) s = 0 →
        ∃ t : (K.X n).obj.obj (op V),
          (K.d n (n + 1)).hom.app (op V) t = s) :
    Function.Surjective ((K.toCycles n (n + 1)).hom.app (op V)) := by
  intro z
  let ev := sheafToPresheaf J AddCommGrpCat.{v} ⋙
    (evaluation Cᵒᵖ AddCommGrpCat.{v}).obj (op V)
  haveI : Mono ((K.iCycles (n + 1)).hom.app (op V)) := by
    change Mono (ev.map (K.iCycles (n + 1)))
    infer_instance
  have hz : (K.d (n + 1) (n + 2)).hom.app (op V)
      ((K.iCycles (n + 1)).hom.app (op V) z) = 0 := by
    change ((K.iCycles (n + 1) ≫ K.d (n + 1) (n + 2)).hom.app (op V)) z = 0
    rw [K.iCycles_d]
    rfl
  obtain ⟨t, ht⟩ := hex ((K.iCycles (n + 1)).hom.app (op V) z) hz
  refine ⟨t, ?_⟩
  apply (AddCommGrpCat.mono_iff_injective
    ((K.iCycles (n + 1)).hom.app (op V))).mp inferInstance
  change ((K.toCycles n (n + 1) ≫ K.iCycles (n + 1)).hom.app (op V)) t =
    (K.iCycles (n + 1)).hom.app (op V) z
  rw [K.toCycles_i]
  exact ht

include hι' hK hKV in
/-- Exactness of the section complex in degree `n + 1` forces the actual
cohomology `Hⁿ⁺¹(V,F)` to vanish. -/
theorem subsingleton_of_exact_sections (n : ℕ)
    (hex : ∀ s : (K.X (n + 1)).obj.obj (op V),
      (K.d (n + 1) (n + 2)).hom.app (op V) s = 0 →
        ∃ t : (K.X n).obj.obj (op V),
          (K.d n (n + 1)).hom.app (op V) t = s) :
    Subsingleton (F.H' (n + 1) V) := by
  have hsurj := toCycles_sections_surjective (K := K) V n hex
  cases n with
  | zero =>
    exact Sheaf.H'.subsingleton_X₁_one
      (K.shortExact_toCycles ι hι hι' (by simp) (hK 0)) V hsurj (hKV 0 0)
  | succ n =>
    have hS := K.cyclesShortComplex_shortExact (n + 1) (n + 2)
      (by simp) (hK (n + 1))
    rw [HomologicalComplex.cyclesShortComplex_def] at hS
    have hcycles : Subsingleton ((K.cycles (n + 1)).H' 1 V) :=
      Sheaf.H'.subsingleton_X₁_one hS V hsurj (hKV (n + 1) 0)
    simpa using subsingleton_of_cycles ι hι hι' hK V hKV n 0 hcycles

include hι' hK hKV in
/-- The complete positive-degree vanishing criterion for an acyclic resolution. -/
theorem subsingleton_iff_exact_sections (n : ℕ) :
    Subsingleton (F.H' (n + 1) V) ↔
      ∀ s : (K.X (n + 1)).obj.obj (op V),
        (K.d (n + 1) (n + 2)).hom.app (op V) s = 0 →
          ∃ t : (K.X n).obj.obj (op V),
            (K.d n (n + 1)).hom.app (op V) t = s :=
  ⟨fun h ↦ Sheaf.H'.exists_d_hom_app_eq_of_resolution
      ι hι hι' hK V hKV n h,
    fun h ↦ subsingleton_of_exact_sections ι hι hι' hK V hKV n h⟩

end PaperVerification.Segre.AcyclicResolution
end
end
