section SegreProjectiveChartSections

/-!
# Actual structure-sheaf sections on standard projective charts

The polynomial chart equivalence is transported through Mathlib's genuine
Proj standard-open structure-sheaf isomorphism. The coefficient algebra is
the one induced by the project's fixed structure morphism to Spec K.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ProjectiveChartSections

open CategoryTheory AlgebraicGeometry Opposite MvPolynomial
open PolynomialChartRing PaperVerification.HomogeneousChartDehomogenization

universe u

/-- Functions on an actual open acquire their scalar algebra from the
specified scheme structure map to the coefficient spectrum. -/
scoped instance sectionAlgebra (R : Type u) [CommRing R] (X : Scheme.{u})
    [X.Over (Spec (.of R))] (U : X.Opens) : Algebra R Γ(X,U) :=
  ((X.baseRingToStructurePresheaf R).app (op U)).hom.toAlgebra

variable {K I : Type u} [Field K] [Fintype I] [DecidableEq I]

local notation "𝒜" => homogeneousSubmodule I K

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The standard-open map takes a constant homogeneous fraction to the
actual function pulled back from the coefficient field. -/
theorem awayToSection_algebraMap (p : I) (c : K) :
    Proj.awayToSection 𝒜 (X p)
      (algebraMap K (HomogeneousLocalization.Away 𝒜 (X p)) c)=
        algebraMap K Γ(Proj 𝒜,ProjectiveCech.coordinateOpen p) c := by
  change _ = ((Proj 𝒜).baseRingToStructurePresheaf K).app
    (op (ProjectiveCech.coordinateOpen p)) c
  erw [Scheme.baseRingToStructurePresheaf_app, CommRingCat.comp_apply,
    CommRingCat.ofHom_apply]
  apply Subtype.ext
  funext x
  apply HomogeneousLocalization.val_injective
  erw [ProjectiveSpectrum.Proj.awayToSection_apply]
  rw [HomogeneousLocalization.val_algebraMap]
  change IsLocalization.map (M := Submonoid.powers (X p))
    (T := x.val.asHomogeneousIdeal.toIdeal.primeCompl) _ (RingHom.id _)
    (Submonoid.powers_le.mpr x.property)
    (algebraMap K (Localization.Away (X p : MvPolynomial I K)) c)=
      ((Scheme.Modules.baseRingToGlobalSections K (Proj 𝒜) c).val
        ⟨x.val,by trivial⟩).val
  rw [ProjectiveGlobalSections.val_baseRingToGlobalSections_apply,
    IsScalarTower.algebraMap_apply K (MvPolynomial I K),IsLocalization.map_eq]
  simp only [RingHom.id_apply,MvPolynomial.algebraMap_eq,Localization.mk_one_eq_algebraMap]

/-- Mathlib's full Proj chart section isomorphism, with its actual K-algebra
structure rather than merely its underlying ring structure. -/
def awaySectionEquiv (p : I) :
    HomogeneousLocalization.Away 𝒜 (X p) ≃ₐ[K]
      Γ(Proj 𝒜,ProjectiveCech.coordinateOpen p) where
  __ := (Proj.basicOpenIsoAway 𝒜 (X p) (isHomogeneous_X K p) one_pos).commRingCatIsoToRingEquiv
  commutes' c := awayToSection_algebraMap p c

/-- Every actual structure-sheaf section on the standard projective chart
is a unique polynomial in the nonpivot coordinate ratios. -/
def chartSectionsEquiv (p : I) :
    Γ(Proj 𝒜,ProjectiveCech.coordinateOpen p) ≃ₐ[K]
      MvPolynomial (FreeCoordinate p) K :=
  (awaySectionEquiv p).symm.trans (awayEquivPolynomial p)

/-- The literal function Xᵢ/Xₚ on the genuine affine open. -/
def coordinateSection (p i : I) : Γ(Proj 𝒜,ProjectiveCech.coordinateOpen p) :=
  Proj.awayToSection 𝒜 (X p)
    (fraction 𝒜 (isHomogeneous_X K p) 1 ⟨X i,isHomogeneous_X K i⟩)

@[simp] theorem chartSectionsEquiv_coordinate (p i : I) :
    chartSectionsEquiv (K := K) p (coordinateSection p i)=normalizedVariable p i := by
  change awayEquivPolynomial p
    ((awaySectionEquiv p).symm ((awaySectionEquiv p)
      (fraction 𝒜 (isHomogeneous_X K p) 1 ⟨X i,isHomogeneous_X K i⟩)))=_
  rw [AlgEquiv.symm_apply_apply,awayEquivPolynomial_coordinate]

@[simp] theorem coordinateSection_pivot (p : I) : coordinateSection (K := K) p p=1 := by
  apply (chartSectionsEquiv p).injective
  simp

/-- The inverse equivalence realizes each ordinary polynomial variable as
the corresponding actual projective coordinate ratio. -/
@[simp] theorem chartSectionsEquiv_symm_X (p : I) (i : FreeCoordinate p) :
    (chartSectionsEquiv (K := K) p).symm (X i)=coordinateSection p i.val := by
  apply (chartSectionsEquiv p).injective
  simp

end PaperVerification.Segre.ProjectiveChartSections

end SegreProjectiveChartSections

section SegreProductChartSections

/-!
# The actual coordinate rings of all standard product charts

The ring of an affine rectangle in the fixed iterated scheme fibre product is
the algebra tensor product of the two factor rings, by the actual coordinate
pushout. Iterating this equivalence identifies the complete structure-sheaf
section algebra with the polynomial algebra on all free factor coordinates.
No reducedness or pointwise equivalence substitutes for the ring isomorphism.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ProductChartSections

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite MvPolynomial
open FixedProductCohomology ProjectiveChartSections PolynomialChartRing
open scoped TensorProduct ProjectiveChartSections

universe u

section Rectangle

variable (R : Type u) [CommRing R]
  {X Y P : Scheme.{u}}
  [X.Over (Spec (.of R))] [Y.Over (Spec (.of R))] [P.Over (Spec (.of R))]
  (f : P ⟶ X) (g : P ⟶ Y)
  [f.IsOver (Spec (.of R))] [g.IsOver (Spec (.of R))]
  (H : IsPullback f g (X ↘ Spec (.of R)) (Y ↘ Spec (.of R)))
  (U : X.Opens) (V : Y.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V)

/-- The actual full ring of functions on an affine rectangle is the tensor
product of its two actual factor rings over the original coefficient ring. -/
def rectangleSectionsEquiv :
    Γ(P,ExternalSections.rectangle f g U V) ≃ₐ[R] Γ(X,U) ⊗[R] Γ(Y,V) := by
  let A := Γ(X,U)
  let B := Γ(Y,V)
  let W := ExternalSections.rectangle f g U V
  let S := Γ(P,W)
  letI : Algebra A S := (f.appLE U W inf_le_left).hom.toAlgebra
  letI : Algebra B S := (g.appLE V W inf_le_right).hom.toAlgebra
  letI : IsScalarTower R A S :=
    IsScalarTower.of_algebraMap_eq fun r =>
      (AffineRectangleTensor.appLE_baseRing R f U W inf_le_left r).symm
  letI : IsScalarTower R B S :=
    IsScalarTower.of_algebraMap_eq fun r =>
      (AffineRectangleTensor.appLE_baseRing R g V W inf_le_right r).symm
  letI : Algebra.IsPushout R A B S :=
    CommRingCat.isPushout_iff_isPushout.mp
      (AffineRectangleTensor.rectangle_coordinate_pushout R f g H U V hU hV)
  exact ((Algebra.IsPushout.equiv R A B S).restrictScalars R).symm

/-- The equivalence is the literal product of the two pullbacks of functions. -/
@[simp] theorem rectangleSectionsEquiv_symm_tmul (a : Γ(X,U)) (b : Γ(Y,V)) :
    (rectangleSectionsEquiv R f g H U V hU hV).symm (a ⊗ₜ[R] b)=
      f.appLE U (ExternalSections.rectangle f g U V) inf_le_left a *
        g.appLE V (ExternalSections.rectangle f g U V) inf_le_right b := by
  let A := Γ(X,U)
  let B := Γ(Y,V)
  let W := ExternalSections.rectangle f g U V
  let S := Γ(P,W)
  letI : Algebra A S := (f.appLE U W inf_le_left).hom.toAlgebra
  letI : Algebra B S := (g.appLE V W inf_le_right).hom.toAlgebra
  letI : IsScalarTower R A S :=
    IsScalarTower.of_algebraMap_eq fun r =>
      (AffineRectangleTensor.appLE_baseRing R f U W inf_le_left r).symm
  letI : IsScalarTower R B S :=
    IsScalarTower.of_algebraMap_eq fun r =>
      (AffineRectangleTensor.appLE_baseRing R g V W inf_le_right r).symm
  letI : Algebra.IsPushout R A B S :=
    CommRingCat.isPushout_iff_isPushout.mp
      (AffineRectangleTensor.rectangle_coordinate_pushout R f g H U V hU hV)
  exact Algebra.IsPushout.equiv_tmul R A B S a b

@[simp] theorem rectangleSectionsEquiv_left (a : Γ(X,U)) :
    rectangleSectionsEquiv R f g H U V hU hV
      (f.appLE U (ExternalSections.rectangle f g U V) inf_le_left a)=a ⊗ₜ[R] 1 := by
  apply (rectangleSectionsEquiv R f g H U V hU hV).symm.injective
  rw [AlgEquiv.symm_apply_apply,rectangleSectionsEquiv_symm_tmul,map_one,mul_one]

@[simp] theorem rectangleSectionsEquiv_right (b : Γ(Y,V)) :
    rectangleSectionsEquiv R f g H U V hU hV
      (g.appLE V (ExternalSections.rectangle f g U V) inf_le_right b)=1 ⊗ₜ[R] b := by
  apply (rectangleSectionsEquiv R f g H U V hU hV).symm.injective
  rw [AlgEquiv.symm_apply_apply,rectangleSectionsEquiv_symm_tmul,map_one,one_mul]

end Rectangle

variable {K : Type u} [Field K]

scoped instance coveredOver (A : CoveredScheme K) : A.scheme.Over (Spec (.of K)) :=
  ⟨A.toBase⟩

/-- The actual index of a rectangle in the recursively constructed cover. -/
def finiteChartIndex : {k : ℕ} → (A : Fin (k+1) → CoveredScheme K) →
    (∀ i,(A i).index) → (CoveredScheme.finiteProduct A).index
  | 0,A,p => p 0
  | k+1,A,p => (p 0,finiteChartIndex (fun i : Fin (k+1) => A i.succ) (fun i => p i.succ))

/-- The standard chart belonging to one pivot in each actual factor. -/
def finiteChart {k : ℕ} (A : Fin (k+1) → CoveredScheme K)
    (p : ∀ i,(A i).index) : (CoveredScheme.finiteProduct A).scheme.Opens :=
  (CoveredScheme.finiteProduct A).opens (finiteChartIndex A p)

/-- The finite product's displayed charts are actual affine opens. -/
theorem finiteChart_affine {k : ℕ} (A : Fin (k+1) → CoveredScheme K)
    (p : ∀ i,(A i).index) : IsAffineOpen (finiteChart A p) :=
  (CoveredScheme.finiteProduct A).affine (finiteChartIndex A p)

/-- Every index of the recursive cover comes from a full tuple of factor
indices; this ensures that no standard charts are omitted. -/
theorem finiteChartIndex_surjective {k : ℕ} (A : Fin (k+1) → CoveredScheme K) :
    Function.Surjective (finiteChartIndex A) := by
  induction k with
  | zero =>
      intro a
      refine ⟨Fin.cases a (fun i => Fin.elim0 i),rfl⟩
  | succ k ih =>
      rintro ⟨a,b⟩
      obtain ⟨p,hp⟩ := ih (fun i : Fin (k+1) => A i.succ) b
      refine ⟨Fin.cases a p,?_⟩
      exact Prod.ext rfl hp

/-- All the actual standard product charts cover the fixed product scheme. -/
theorem finiteChart_cover {k : ℕ} (A : Fin (k+1) → CoveredScheme K) :
    (⨆ p : ∀ i,(A i).index,finiteChart A p)=⊤ := by
  change (⨆ p : ∀ i,(A i).index,
    (CoveredScheme.finiteProduct A).opens (finiteChartIndex A p)) = ⊤
  rw [(finiteChartIndex_surjective A).iSup_comp]
  exact (CoveredScheme.finiteProduct A).covers

/-- Split a family of free coordinates into its first factor and its tail. -/
def sigmaFinSucc {k : ℕ} (σ : Fin (k+2) → Type u) :
    (Σ i,σ i) ≃ σ 0 ⊕ (Σ i : Fin (k+1),σ i.succ) where
  toFun q := Fin.cases (fun a => Sum.inl a)
    (fun i a => Sum.inr ⟨i,a⟩) q.1 q.2
  invFun := Sum.elim (fun a => ⟨0,a⟩) (fun q => ⟨q.1.succ,q.2⟩)
  left_inv q := by
    rcases q with ⟨i,a⟩
    induction i using Fin.cases with
    | zero => rfl
    | succ i => rfl
  right_inv q := by cases q <;> rfl

/-- Coordinate-ring equivalences for every factor induce an equivalence
for the complete actual standard chart in their fixed scheme product. -/
def finiteChartSectionsEquiv : {k : ℕ} → (A : Fin (k+1) → CoveredScheme K) →
    (p : ∀ i,(A i).index) → (σ : Fin (k+1) → Type u) →
    (∀ i,Γ((A i).scheme,(A i).opens (p i)) ≃ₐ[K] MvPolynomial (σ i) K) →
    (Γ((CoveredScheme.finiteProduct A).scheme,finiteChart A p) ≃ₐ[K]
      MvPolynomial (Σ i,σ i) K)
  | 0,A,p,σ,e => by
      letI : Unique (Fin (0+1)) := { default := 0, uniq := Fin.eq_zero }
      exact (e 0).trans (MvPolynomial.renameEquiv K (Equiv.uniqueSigma σ).symm)
  | k+1,A,p,σ,e => by
      let B := CoveredScheme.finiteProduct (fun i : Fin (k+1) => A i.succ)
      let f : (CoveredScheme.finiteProduct A).scheme ⟶ (A 0).scheme :=
        pullback.fst (A 0).toBase B.toBase
      let g : (CoveredScheme.finiteProduct A).scheme ⟶ B.scheme :=
        pullback.snd (A 0).toBase B.toBase
      letI : f.IsOver (Spec (.of K)) := ⟨rfl⟩
      letI : g.IsOver (Spec (.of K)) := ⟨(pullback.condition (f := (A 0).toBase) (g := B.toBase)).symm⟩
      let H : IsPullback f g (A 0).toBase B.toBase :=
        IsPullback.of_hasPullback _ _
      let tailChart := finiteChart (fun i : Fin (k+1) => A i.succ) (fun i => p i.succ)
      let etail := finiteChartSectionsEquiv (fun i : Fin (k+1) => A i.succ)
        (fun i => p i.succ) (fun i => σ i.succ) (fun i => e i.succ)
      change Γ((CoveredScheme.finiteProduct A).scheme,
        ExternalSections.rectangle f g ((A 0).opens (p 0)) tailChart) ≃ₐ[K] _
      exact (rectangleSectionsEquiv K f g H ((A 0).opens (p 0)) tailChart
        ((A 0).affine (p 0)) (finiteChart_affine _ _)).trans
          ((Algebra.TensorProduct.congr (e 0) etail).trans
            ((MvPolynomial.tensorEquivSum K (σ 0) (Σ i : Fin (k+1),σ i.succ) K).trans
              (MvPolynomial.renameEquiv K (sigmaFinSucc σ).symm)))

/-- The complete actual ring on each standard product of projective charts. -/
def projectiveProductChartSectionsEquiv {k : ℕ}
    (I : Fin (k+1) → Type u) [∀ i,Fintype (I i)] [∀ i,DecidableEq (I i)]
    (p : ∀ i,I i) :
    Γ((CoveredScheme.finiteProduct (fun i => ProductKoszulVanishing.projectiveScheme K (I i))).scheme,
      finiteChart (fun i => ProductKoszulVanishing.projectiveScheme K (I i)) p) ≃ₐ[K]
      MvPolynomial (Σ i,FreeCoordinate (p i)) K :=
  finiteChartSectionsEquiv (K := K)
    (fun i => ProductKoszulVanishing.projectiveScheme K (I i)) p
    (fun i => FreeCoordinate (p i)) (fun i => chartSectionsEquiv (K := K) (p i))

/-- For the numerical tensor format, the variables are precisely the free
coordinate subtype used by the literal critical polynomial ideals. -/
def numericalProductChartSectionsEquiv {K : Type} [Field K] {k : ℕ} (n : Fin (k+1) → ℕ)
    (p : Staircase.Cell n) :
    Γ((CoveredScheme.finiteProduct
        (fun i => ProductKoszulVanishing.projectiveScheme K (Fin (n i+1)))).scheme,
      finiteChart (fun i => ProductKoszulVanishing.projectiveScheme K (Fin (n i+1))) p) ≃ₐ[K]
      MvPolynomial (ProjectiveCharts.ChartVar p) K :=
  (projectiveProductChartSectionsEquiv (fun i => Fin (n i+1)) p).trans
    (MvPolynomial.renameEquiv K (ProjectiveCharts.chartVarEquiv p).symm)

end PaperVerification.Segre.ProductChartSections

end SegreProductChartSections

section SegreFixedProductProjections

/-!
# Fixed product projections and the actual tensor comparison

The projections are constructed from the literal iterated scheme fibre
product. The external tensor sheaf used by the product-cohomology argument
is identified with the finite tensor of pullbacks along precisely these
projections. The latter is the construction used by the actual critical
functional. Every comparison is made from the canonical pullback tensor
map, composition isomorphism, and unit isomorphism.

The comparison is proved for every nonempty finite family of covered schemes
and quasicoherent sheaves. It assumes no product-cohomology comparison.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.FixedProductProjections

open CategoryTheory Limits MonoidalCategory AlgebraicGeometry
open AlgebraicGeometry.Scheme.Modules
open TauCeti.AlgebraicGeometry.Scheme.Modules
open FixedProductCohomology
open scoped BigOperators

universe u v w

/-- The genuine finite tensor of a family of isomorphisms, including the unit
at length zero. -/
def tensorFamilyIso {C : Type v} [Category.{w} C] [MonoidalCategory C] :
    {k : ℕ} → {M N : Fin k → C} →
      ((i : Fin k) → M i ≅ N i) → (FiniteTensor.tensorObj M ≅ FiniteTensor.tensorObj N)
  | 0, _, _, _ => Iso.refl _
  | k + 1, _, _, e =>
      e 0 ⊗ᵢ tensorFamilyIso (fun i : Fin k => e i.succ)

/-- Every full finite tensor of quasicoherent sheaves is quasicoherent,
including the terminal tensor unit. -/
theorem finiteTensor_quasicoherent {X : Scheme.{u}} :
    {k : ℕ} → (M : Fin k → X.Modules) → (∀ i, (M i).IsQuasicoherent) →
      (FiniteTensor.tensorObj M).IsQuasicoherent
  | 0, _, _ => by change (𝟙_ X.Modules).IsQuasicoherent; infer_instance
  | k + 1, M, hM => by
      letI := hM 0
      letI := finiteTensor_quasicoherent (fun i : Fin k => M i.succ)
        (fun i => hM i.succ)
      change (M 0 ⊗ FiniteTensor.tensorObj (fun i : Fin k => M i.succ)).IsQuasicoherent
      infer_instance

/-- Actual pullback commutes with the entire finite tensor of quasicoherent
sheaves, including its final tensor unit. -/
def pullbackFiniteTensorIso {X Y : Scheme.{u}} (f : X ⟶ Y) :
    {k : ℕ} → (M : Fin k → Y.Modules) → (∀ i, (M i).IsQuasicoherent) →
      ((Scheme.Modules.pullback f).obj (FiniteTensor.tensorObj M) ≅
        FiniteTensor.tensorObj (fun i => (Scheme.Modules.pullback f).obj (M i)))
  | 0, _, _ => pullbackObjUnitIso f
  | k + 1, M, hM => by
      letI : (M 0).IsQuasicoherent := hM 0
      letI := finiteTensor_quasicoherent (fun i : Fin k => M i.succ)
        (fun i => hM i.succ)
      letI : IsIso (Functor.OplaxMonoidal.δ (Scheme.Modules.pullback f) (M 0)
          (FiniteTensor.tensorObj (fun i : Fin k => M i.succ))) :=
        Scheme.Modules.isIso_pullback_δ_of_isQuasicoherent f (M 0)
          (FiniteTensor.tensorObj (fun i : Fin k => M i.succ))
      exact asIso (Functor.OplaxMonoidal.δ (Scheme.Modules.pullback f) (M 0)
        (FiniteTensor.tensorObj (fun i : Fin k => M i.succ))) ≪≫
          (Iso.refl _ ⊗ᵢ pullbackFiniteTensorIso f
            (fun i : Fin k => M i.succ) (fun i => hM i.succ))

variable {K : Type u} [Field K]

/-- The actual projection to each factor of the fixed iterated fibre product. -/
def projection : {k : ℕ} → (A : Fin (k + 1) → CoveredScheme K) →
    (i : Fin (k + 1)) → (CoveredScheme.finiteProduct A).scheme ⟶ (A i).scheme
  | 0, A, i => Fin.cases (𝟙 (A 0).scheme) (fun j => Fin.elim0 j) i
  | k + 1, A, i =>
      let B := CoveredScheme.finiteProduct (fun j : Fin (k + 1) => A j.succ)
      Fin.cases
        (pullback.fst (A 0).toBase B.toBase)
        (fun j => pullback.snd (A 0).toBase B.toBase ≫
          projection (fun l : Fin (k + 1) => A l.succ) j) i

/-- All actual projections commute with the common coefficient-field map. -/
theorem projection_toBase {k : ℕ} (A : Fin (k + 1) → CoveredScheme K)
    (i : Fin (k + 1)) :
    projection A i ≫ (A i).toBase = (CoveredScheme.finiteProduct A).toBase := by
  induction k with
  | zero =>
      induction i using Fin.cases with
      | zero => exact Category.id_comp _
      | succ i => exact Fin.elim0 i
  | succ k ih =>
      induction i using Fin.cases with
      | zero => rfl
      | succ i =>
          change (pullback.snd (A 0).toBase
              (CoveredScheme.finiteProduct (fun j : Fin (k + 1) => A j.succ)).toBase ≫
                projection (fun j : Fin (k + 1) => A j.succ) i) ≫ (A i.succ).toBase =
            pullback.fst (A 0).toBase
              (CoveredScheme.finiteProduct (fun j : Fin (k + 1) => A j.succ)).toBase ≫
                (A 0).toBase
          rw [Category.assoc, ih]
          exact pullback.condition.symm

/-- The actual recursively defined external tensor sheaf is the finite tensor
of the actual pullbacks along the fixed product projections. -/
def finiteExternalTensorIso :
    {k : ℕ} → (A : Fin (k + 1) → CoveredScheme K) →
      (M : ∀ i, (A i).scheme.Modules) → (∀ i, (M i).IsQuasicoherent) →
        (CoveredScheme.finiteExternalTensor A M ≅
          FiniteTensor.tensorObj (fun i => (Scheme.Modules.pullback (projection A i)).obj (M i)))
  | 0, A, M, _ => by
      change M 0 ≅ (Scheme.Modules.pullback (𝟙 (A 0).scheme)).obj (M 0) ⊗ 𝟙_ (A 0).scheme.Modules
      exact ((pullbackId (A 0).scheme).app (M 0)).symm ≪≫ (ρ_ _).symm
  | k + 1, A, M, hM => by
      let B := CoveredScheme.finiteProduct (fun j : Fin (k + 1) => A j.succ)
      let N := CoveredScheme.finiteExternalTensor
        (fun j : Fin (k + 1) => A j.succ) (fun j => M j.succ)
      let p : (CoveredScheme.finiteProduct A).scheme ⟶ (A 0).scheme :=
        pullback.fst (A 0).toBase B.toBase
      let q : (CoveredScheme.finiteProduct A).scheme ⟶ B.scheme :=
        pullback.snd (A 0).toBase B.toBase
      let tailM : Fin (k + 1) → B.scheme.Modules :=
        fun j => (Scheme.Modules.pullback (projection (fun l : Fin (k + 1) => A l.succ) j)).obj
          (M j.succ)
      have htailM : ∀ j, (tailM j).IsQuasicoherent := by
        intro j
        letI : (M j.succ).IsQuasicoherent := hM j.succ
        change ((Scheme.Modules.pullback (projection (fun l : Fin (k + 1) => A l.succ) j)).obj
          (M j.succ)).IsQuasicoherent
        infer_instance
      let e : (Scheme.Modules.pullback q).obj N ≅
          FiniteTensor.tensorObj
            (fun j : Fin (k + 1) =>
              (Scheme.Modules.pullback (q ≫ projection (fun l : Fin (k + 1) => A l.succ) j)).obj
                (M j.succ)) :=
        (Scheme.Modules.pullback q).mapIso
          (finiteExternalTensorIso (fun j : Fin (k + 1) => A j.succ)
            (fun j => M j.succ) (fun j => hM j.succ)) ≪≫
          pullbackFiniteTensorIso q tailM htailM ≪≫
          tensorFamilyIso (fun j : Fin (k + 1) =>
            (pullbackComp q (projection (fun l : Fin (k + 1) => A l.succ) j)).app
              (M j.succ))
      change (Scheme.Modules.pullback p).obj (M 0) ⊗ (Scheme.Modules.pullback q).obj N ≅
        (Scheme.Modules.pullback p).obj (M 0) ⊗
          FiniteTensor.tensorObj
            (fun j : Fin (k + 1) =>
              (Scheme.Modules.pullback (q ≫ projection (fun l : Fin (k + 1) => A l.succ) j)).obj
                (M j.succ))
      exact Iso.refl _ ⊗ᵢ e

/-- Product cohomology vanishing now applies to the literal finite tensor of
pullbacks used by the critical map, without a sheaf-comparison premise. -/
theorem tensorPullback_cohomology_vanishes {k : ℕ}
    (A : Fin (k + 1) → CoveredScheme K) (M : ∀ i, (A i).scheme.Modules)
    (hM : ∀ i, (M i).IsQuasicoherent) (n : ℕ)
    (h : ∀ d : Fin (k + 1) → ℕ, (∑ i, d i) = n →
      ∃ i, Subsingleton (Cohomology (M i) (d i))) :
    Subsingleton (Cohomology
      (FiniteTensor.tensorObj (fun i => (Scheme.Modules.pullback (projection A i)).obj (M i))) n) := by
  let X := (CoveredScheme.finiteProduct A).scheme
  let H := cohomologyFunctor X n
  have hv := CoveredScheme.finiteExternalTensor_cohomology_vanishes A M hM n h
  letI : Subsingleton ↑(H.obj (CoveredScheme.finiteExternalTensor A M)) := hv
  have hz : IsZero (H.obj (CoveredScheme.finiteExternalTensor A M)) :=
    AddCommGrpCat.isZero_of_subsingleton _
  exact AddCommGrpCat.subsingleton_of_isZero
    (hz.of_iso (H.mapIso (finiteExternalTensorIso A M hM)).symm)

