section SegreProductCoordinatePullback

/-!
# Literal factor pullbacks on the actual product charts

The standard product chart is contained in the inverse image of every
factor chart along the fixed scheme projections. Thus the pullback of each
factor function is an actual structure-sheaf map over K. The comparison
lemmas retain those maps, rather than defining coordinates through an
abstract ring equivalence.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ProductCoordinatePullback

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite MvPolynomial
open FixedProductCohomology FixedProductProjections ProductChartSections
open scoped TensorProduct ProjectiveChartSections ProductChartSections

universe u
variable {K : Type u} [Field K]

/-- The full standard chart lies in the indicated chart of every factor,
along the actual projection from the fixed iterated scheme product. -/
theorem finiteChart_le_preimage {k : ℕ} (A : Fin (k+1) → CoveredScheme K)
    (p : ∀ i,(A i).index) (i : Fin (k+1)) :
    finiteChart A p ≤ projection A i ⁻¹ᵁ (A i).opens (p i) := by
  induction k with
  | zero =>
      induction i using Fin.cases with
      | zero => exact le_rfl
      | succ i => exact Fin.elim0 i
  | succ k ih =>
      induction i using Fin.cases with
      | zero => exact inf_le_left
      | succ i =>
          let B := CoveredScheme.finiteProduct (fun j : Fin (k+1) => A j.succ)
          change finiteChart A p ≤
            (pullback.snd (A 0).toBase B.toBase ≫
              projection (fun j : Fin (k+1) => A j.succ) i) ⁻¹ᵁ
                (A i.succ).opens (p i.succ)
          rw [Scheme.Hom.comp_preimage]
          exact inf_le_right.trans
            ((pullback.snd (A 0).toBase B.toBase).preimage_mono
              (ih (fun j : Fin (k+1) => A j.succ) (fun j => p j.succ) i))

/-- The actual pullback of a factor's chart functions, with coefficient
compatibility proved from its fixed structure morphism. -/
def factorRestriction {k : ℕ} (A : Fin (k+1) → CoveredScheme K)
    (p : ∀ i,(A i).index) (i : Fin (k+1)) :
    Γ((A i).scheme,(A i).opens (p i)) →ₐ[K]
      Γ((CoveredScheme.finiteProduct A).scheme,finiteChart A p) := by
  letI : (projection A i).IsOver (Spec (.of K)) := ⟨projection_toBase A i⟩
  exact
    { toRingHom := ((projection A i).appLE ((A i).opens (p i))
        (finiteChart A p) (finiteChart_le_preimage A p i)).hom
      commutes' c := AffineRectangleTensor.appLE_baseRing K (projection A i)
        ((A i).opens (p i)) (finiteChart A p) (finiteChart_le_preimage A p i) c }

@[simp] theorem factorRestriction_apply {k : ℕ} (A : Fin (k+1) → CoveredScheme K)
    (p : ∀ i,(A i).index) (i : Fin (k+1))
    (a : Γ((A i).scheme,(A i).opens (p i))) :
    factorRestriction A p i a=(projection A i).appLE ((A i).opens (p i))
      (finiteChart A p) (finiteChart_le_preimage A p i) a := rfl

/-- The sigma polynomial algebra retains the complete first factor algebra. -/
theorem tensorEquivSum_left {σ τ : Type u} (f : MvPolynomial σ K) :
    MvPolynomial.tensorEquivSum K σ τ K (f ⊗ₜ[K] 1)=
      MvPolynomial.rename Sum.inl f := by
  have h : (MvPolynomial.tensorEquivSum K σ τ K).toAlgHom.comp
      (Algebra.TensorProduct.includeLeft : MvPolynomial σ K →ₐ[K]
        MvPolynomial σ K ⊗[K] MvPolynomial τ K)=MvPolynomial.rename Sum.inl := by
    ext i
    simp
  exact AlgHom.congr_fun h f

/-- The sigma polynomial algebra retains the complete second factor algebra. -/
theorem tensorEquivSum_right {σ τ : Type u} (f : MvPolynomial τ K) :
    MvPolynomial.tensorEquivSum K σ τ K (1 ⊗ₜ[K] f)=
      MvPolynomial.rename Sum.inr f := by
  have h : (MvPolynomial.tensorEquivSum K σ τ K).toAlgHom.comp
      (Algebra.TensorProduct.includeRight : MvPolynomial τ K →ₐ[K]
        MvPolynomial σ K ⊗[K] MvPolynomial τ K)=MvPolynomial.rename Sum.inr := by
    ext i
    simp
  exact AlgHom.congr_fun h f

/-- The recursive chart equivalence sends every actual factor pullback to
the inclusion of precisely that factor's polynomial variables. -/
theorem finiteChartSectionsEquiv_factorRestriction {k : ℕ}
    (A : Fin (k+1) → CoveredScheme K) (p : ∀ i,(A i).index)
    (σ : Fin (k+1) → Type u)
    (e : ∀ i,Γ((A i).scheme,(A i).opens (p i)) ≃ₐ[K] MvPolynomial (σ i) K)
    (i : Fin (k+1)) (a : Γ((A i).scheme,(A i).opens (p i))) :
    finiteChartSectionsEquiv A p σ e (factorRestriction A p i a)=
      MvPolynomial.rename (Sigma.mk i) (e i a) := by
  induction k with
  | zero =>
      induction i using Fin.cases with
      | zero =>
          letI : Unique (Fin (0+1)) := { default := 0, uniq := Fin.eq_zero }
          change MvPolynomial.rename (Equiv.uniqueSigma σ).symm
            (e 0 (Scheme.Hom.appLE (𝟙 (A 0).scheme) ((A 0).opens (p 0))
              ((A 0).opens (p 0)) _ a))=_
          have hid : Scheme.Hom.appLE (𝟙 (A 0).scheme) ((A 0).opens (p 0))
              ((A 0).opens (p 0)) le_rfl a=a := by
            change (A 0).scheme.presheaf.map (𝟙 (op ((A 0).opens (p 0)))) a = a
            simp
          rw [hid]
          rfl
      | succ i => exact Fin.elim0 i
  | succ k ih =>
      let Atail := fun j : Fin (k+1) => A j.succ
      let ptail := fun j : Fin (k+1) => p j.succ
      let σtail := fun j : Fin (k+1) => σ j.succ
      let etail := fun j : Fin (k+1) => e j.succ
      let B := CoveredScheme.finiteProduct Atail
      let f : (CoveredScheme.finiteProduct A).scheme ⟶ (A 0).scheme :=
        pullback.fst (A 0).toBase B.toBase
      let g : (CoveredScheme.finiteProduct A).scheme ⟶ B.scheme :=
        pullback.snd (A 0).toBase B.toBase
      letI : f.IsOver (Spec (.of K)) := ⟨rfl⟩
      letI : g.IsOver (Spec (.of K)) :=
        ⟨(pullback.condition (f := (A 0).toBase) (g := B.toBase)).symm⟩
      let H : IsPullback f g (A 0).toBase B.toBase := IsPullback.of_hasPullback _ _
      let U := (A 0).opens (p 0)
      let V := finiteChart Atail ptail
      let W := finiteChart A p
      let E := finiteChartSectionsEquiv Atail ptail σtail etail
      induction i using Fin.cases with
      | zero =>
          change MvPolynomial.rename (sigmaFinSucc σ).symm
            (MvPolynomial.tensorEquivSum K (σ 0) (Σ j,σtail j) K
              ((Algebra.TensorProduct.congr (e 0) E)
                (rectangleSectionsEquiv K f g H U V ((A 0).affine (p 0))
                  (finiteChart_affine Atail ptail) (f.appLE U W inf_le_left a))))=_
          erw [rectangleSectionsEquiv_left]
          simp only [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul,
            AlgEquiv.coe_toAlgHom, map_one, tensorEquivSum_left,
            MvPolynomial.rename_rename]
          erw [MvPolynomial.rename_rename]
          rfl
      | succ i =>
          have hcomp : factorRestriction A p i.succ a=
              g.appLE V W inf_le_right (factorRestriction Atail ptail i a) := by
            change (g ≫ projection Atail i).appLE ((A i.succ).opens (p i.succ)) W _ a=
              g.appLE V W inf_le_right
                ((projection Atail i).appLE ((A i.succ).opens (p i.succ)) V _ a)
            symm
            simpa only [CommRingCat.comp_apply] using congrArg
              (fun h => h a)
              (Scheme.Hom.appLE_comp_appLE g (projection Atail i)
                ((A i.succ).opens (p i.succ)) V W
                (finiteChart_le_preimage Atail ptail i) inf_le_right)
          rw [hcomp]
          change MvPolynomial.rename (sigmaFinSucc σ).symm
            (MvPolynomial.tensorEquivSum K (σ 0) (Σ j,σtail j) K
              ((Algebra.TensorProduct.congr (e 0) E)
                (rectangleSectionsEquiv K f g H U V ((A 0).affine (p 0))
                  (finiteChart_affine Atail ptail)
                  (g.appLE V W inf_le_right (factorRestriction Atail ptail i a)))))=_
          erw [rectangleSectionsEquiv_right]
          simp only [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul,
            AlgEquiv.coe_toAlgHom, map_one, tensorEquivSum_right]
          rw [show E (factorRestriction Atail ptail i a)=
              MvPolynomial.rename (Sigma.mk i) (e i.succ a) from
            ih Atail ptail σtail etail i a]
          simp only [MvPolynomial.rename_rename]
          erw [MvPolynomial.rename_rename]
          rfl

/-- The image of an actual homogeneous coordinate ratio on the full product
chart is exactly its free variable, or one when it is the pivot. -/
theorem projectiveProductChartSectionsEquiv_coordinate {k : ℕ}
    (I : Fin (k+1) → Type u) [∀ i,Fintype (I i)] [∀ i,DecidableEq (I i)]
    (p : ∀ i,I i) (i : Fin (k+1)) (a : I i) :
    projectiveProductChartSectionsEquiv (K := K) I p
      (factorRestriction (fun j => ProductKoszulVanishing.projectiveScheme K (I j)) p i
        (ProjectiveChartSections.coordinateSection (K := K) (p i) a))=
      MvPolynomial.rename (Sigma.mk i) (PolynomialChartRing.normalizedVariable (p i) a) := by
  rw [projectiveProductChartSectionsEquiv, finiteChartSectionsEquiv_factorRestriction]
  erw [ProjectiveChartSections.chartSectionsEquiv_coordinate]

/-- The numerical format uses exactly the polynomial substitution in the
literal singular-span chart ideals, with no change of factor indices. -/
theorem numericalProductChartSectionsEquiv_coordinate {K : Type} [Field K] {k : ℕ}
    (n : Fin (k+1) → ℕ) (p : Staircase.Cell n) (i : Fin (k+1))
    (a : Fin (n i+1)) :
    numericalProductChartSectionsEquiv (K := K) n p
      (factorRestriction
        (fun j => ProductKoszulVanishing.projectiveScheme K (Fin (n j+1))) p i
        (ProjectiveChartSections.coordinateSection (K := K) (p i) a))=
      ProjectivePointSpan.chartPolynomial p ⟨i,a⟩ := by
  change MvPolynomial.rename (ProjectiveCharts.chartVarEquiv p).symm
    (projectiveProductChartSectionsEquiv (fun i => Fin (n i+1)) p
      (factorRestriction
        (fun j => ProductKoszulVanishing.projectiveScheme K (Fin (n j+1))) p i
        (ProjectiveChartSections.coordinateSection (K := K) (p i) a)))=_
  rw [projectiveProductChartSectionsEquiv_coordinate]
  by_cases ha : a=p i
  · simp [PolynomialChartRing.normalizedVariable,ProjectivePointSpan.chartPolynomial,ha]
  · simp [PolynomialChartRing.normalizedVariable,ProjectivePointSpan.chartPolynomial,ha,
      ProjectiveCharts.chartVarEquiv]

end PaperVerification.Segre.ProductCoordinatePullback

