section SegreEulerTwistComparison

/-!
# Twisting the actual Euler kernel agrees with the actual twisted Euler map

The comparison is proved on pure local tensor sections. It identifies the
whole kernel of the coordinate map after twisting; it does not merely identify
dimensions or introduce an abstract sheaf with prescribed cohomology.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option maxHeartbeats 600000



attribute [local instance] MvPolynomial.gradedAlgebra

namespace PaperVerification.Segre.EulerTwistComparison

open AlgebraicGeometry CategoryTheory Limits MonoidalCategory Opposite
open EulerSheaf EulerSections ExteriorEuler TwistedExteriorEuler
open scoped BigOperators TensorProduct

universe u

variable {I K : Type u} [Fintype I] [DecidableEq I] [Field K]

local notation "𝒜" => MvPolynomial.homogeneousSubmodule I K
local notation "X" => Proj 𝒜

/-- The canonical pure-section tensor map on an arbitrary scheme. Keeping the
scheme as a parameter lets its naturality and extensionality be proved once. -/
def tensorSectionOn {Y : Scheme.{u}} {M N : Y.Modules}
    (U : Y.Opens) (s : Γ(M,U)) (r : Γ(N,U)) : Γ(M ⊗ N,U) :=
  (Functor.LaxMonoidal.μ (SheafOfModules.forget Y.ringCatSheaf) M N).app
    (op U) (s ⊗ₜ[Γ(Y,U)] r)

/-- A pure tensor of actual local sections, mapped into the actual sheaf tensor
product through the canonical lax-monoidal comparison. -/
def tensorSection {M N : (X).Modules} (U : (X).Opens) (s : Γ(M,U)) (r : Γ(N,U)) :
    Γ(M ⊗ N,U) :=
  tensorSectionOn (Y := X) U s r

section GeneralSheafTensor

open TauCeti.SheafOfModules (ringCatSheaf)

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

/-- The two presentations of the sheafification adjunction agree because
both have the same counit. This proof uses their public comparison lemmas. -/
theorem tensorSheafificationAdjunction_eq :
    TauCeti.SheafOfModules.sheafificationForgetAdjunction R =
      (show PresheafOfModules.sheafification (𝟙 (ringCatSheaf R).obj) ⊣
          SheafOfModules.forget (ringCatSheaf R) from
        PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf R).obj)) := by
  apply Adjunction.ext_counit
  apply NatTrans.ext
  funext M
  exact (TauCeti.SheafOfModules.sheafificationForgetAdjunction_counit_app R M).trans
    (TauCeti.SheafOfModules.sheafificationIso_hom (ringCatSheaf R) M)

/-- In particular, the actual sheafification units agree in both presentations. -/
theorem tensorSheafification_unit (P : PresheafOfModules.{u} (ringCatSheaf R).obj) :
    (TauCeti.SheafOfModules.sheafificationForgetAdjunction R).unit.app P =
      (PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf R).obj)).unit.app P :=
  congrArg (fun A : PresheafOfModules.sheafification (𝟙 (ringCatSheaf R).obj) ⊣
      SheafOfModules.forget (ringCatSheaf R) => A.unit.app P)
    (tensorSheafificationAdjunction_eq R)

/-- The monoidal tensor comparison followed by its defining sheafification
isomorphism is the ordinary sheafification unit. No isomorphism is unfolded. -/
theorem tensorForget_μ_comp (M N : SheafOfModules.{u} (ringCatSheaf R)) :
    Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) M N ≫
      (SheafOfModules.forget (ringCatSheaf R)).map
        (SheafOfModules.tensorUnderlyingIso (R := R) M N).hom =
      (PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf R).obj)).unit.app
        (M.val ⊗ N.val) := by
  rw [TauCeti.SheafOfModules.forget_μ, Category.assoc,
    ← CategoryTheory.Functor.map_comp, Iso.inv_hom_id,
    CategoryTheory.Functor.map_id]
  erw [Category.comp_id]
  exact tensorSheafification_unit R (M.val ⊗ N.val)

/-- The same comparison evaluated on an actual pure tensor of local sections. -/
theorem tensorUnderlyingIso_hom_tensor (M N : SheafOfModules.{u} (ringCatSheaf R))
    (U : Cᵒᵖ) (x : M.val.obj U) (y : N.val.obj U) :
    (SheafOfModules.tensorUnderlyingIso (R := R) M N).hom.val.app U
      ((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) M N).app U
        (x ⊗ₜ[R.obj.obj U] y)) =
      ((PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf R).obj)).unit.app
        (M.val ⊗ N.val)).app U (x ⊗ₜ[R.obj.obj U] y) := by
  exact congrArg
    (fun f : M.val ⊗ N.val ⟶
        ((PresheafOfModules.sheafification (𝟙 (ringCatSheaf R).obj)).obj
          (M.val ⊗ N.val)).val =>
      (f.app' U).hom (x ⊗ₜ[R.obj.obj U] y))
    (tensorForget_μ_comp R M N)

end GeneralSheafTensor

/-- The canonical tensor-sheafification comparison on an arbitrary scheme,
evaluated through the shared pure-section map. -/
theorem tensorUnderlyingIso_hom_tensorSectionOn {Y : Scheme.{u}}
    (M N : Y.Modules) (U : Y.Opens) (s : Γ(M,U)) (r : Γ(N,U)) :
    Scheme.Modules.Hom.app (SheafOfModules.tensorUnderlyingIso (R := Y.sheaf) M N).hom U
        (tensorSectionOn U s r) =
      ((PresheafOfModules.sheafificationAdjunction (𝟙 Y.ringCatSheaf.obj)).unit.app
        (M.val ⊗ N.val)).app (op U) (s ⊗ₜ[Γ(Y,U)] r) :=
  tensorUnderlyingIso_hom_tensor Y.sheaf M N (op U) s r

/-- Naturality of the canonical pure-section map on an arbitrary scheme. -/
theorem tensorSectionOn_map {Y : Scheme.{u}} {M M' N N' : Y.Modules}
    (f : M ⟶ M') (g : N ⟶ N') (U : Y.Opens) (s : Γ(M,U)) (r : Γ(N,U)) :
    Scheme.Modules.Hom.app (f ⊗ₘ g) U (tensorSectionOn U s r) =
      tensorSectionOn U (Scheme.Modules.Hom.app f U s) (Scheme.Modules.Hom.app g U r) := by
  have h := congrArg
    (fun η : M.val ⊗ N.val ⟶ (M' ⊗ N').val =>
      (η.app' (op U)).hom (s ⊗ₜ[Γ(Y,U)] r))
    (Functor.LaxMonoidal.μ_natural (SheafOfModules.forget Y.ringCatSheaf) f g)
  change (Functor.LaxMonoidal.μ (SheafOfModules.forget Y.ringCatSheaf) M' N').app
      (op U) (TensorProduct.map (f.val.app' (op U)).hom (g.val.app' (op U)).hom
        (s ⊗ₜ[Γ(Y,U)] r)) =
    (f ⊗ₘ g).val.app (op U) (tensorSectionOn U s r) at h
  erw [TensorProduct.map_tmul] at h
  exact h.symm

/-- Pure-section extensionality for an arbitrary scheme. Keeping the scheme
abstract avoids normalizing any concrete projective presentation in the proof. -/
theorem tensor_hom_ext_scheme {Y : Scheme.{u}} {M N P : Y.Modules}
    {f g : M ⊗ N ⟶ P}
    (h : ∀ (U : Y.Opens) (s : Γ(M,U)) (r : Γ(N,U)),
      Scheme.Modules.Hom.app f U (tensorSectionOn U s r) =
        Scheme.Modules.Hom.app g U (tensorSectionOn U s r)) : f = g := by
  apply TauCeti.SheafOfModules.tensor_hom_ext (R := Y.sheaf)
  ext U : 1
  apply ModuleCat.MonoidalCategory.tensor_ext
  intro s r
  exact h U.unop s r

/-- Naturality of the actual pure-section tensor map. -/
theorem tensorSection_map {M M' N N' : (X).Modules} (f : M ⟶ M') (g : N ⟶ N')
    (U : (X).Opens) (s : Γ(M,U)) (r : Γ(N,U)) :
    (f ⊗ₘ g).app U (tensorSection U s r)=tensorSection U (f.app U s) (g.app U r) :=
  tensorSectionOn_map (Y := X) (M := M) (M' := M') (N := N) (N' := N') f g U s r

/-- Maps out of an actual tensor product are determined on all pure local sections. -/
theorem tensor_hom_ext_sections {M N P : (X).Modules} {f g : M ⊗ N ⟶ P}
    (h : ∀ (U : (X).Opens) (s : Γ(M,U)) (r : Γ(N,U)),
      f.app U (tensorSection U s r)=g.app U (tensorSection U s r)) : f=g :=
  tensor_hom_ext_scheme (Y := X) (f := f) (g := g) h

/-- The actual twisting-sheaf tensor isomorphism is literal local multiplication. -/
theorem twistingTensorIso_tensorSection (m n : ℤ) (U : (X).Opens)
    (s : Γ(Proj.twistingSheaf 𝒜 m,U)) (r : Γ(Proj.twistingSheaf 𝒜 n,U)) :
    Scheme.Modules.Hom.app (twistingTensorIso (I := I) (K := K) m n).hom U (tensorSection U s r)=
      Proj.twistingSheaf.mul 𝒜 U m n s r := by
  let M := Proj.twistingSheaf 𝒜 m
  let N := Proj.twistingSheaf 𝒜 n
  let e := SheafOfModules.tensorUnderlyingIso (R := (X).sheaf) M N
  let g := (TauCeti.SheafOfModules.tensorProductIso (X).sheaf M N).inv ≫
    (Proj.twistingSheaf.tensorProductIso (MvPolynomial.X : I → MvPolynomial I K)
      (fun i => MvPolynomial.isHomogeneous_X (R := K) i)
      ProjectiveCech.coordinate_cover m n).hom
  have hunit := tensorUnderlyingIso_hom_tensorSectionOn (Y := X) M N U s r
  have hmul := Proj.twistingSheaf.tensorProductIso_hom_tmul
    (MvPolynomial.X : I → MvPolynomial I K)
    (fun i => MvPolynomial.isHomogeneous_X (R := K) i)
    ProjectiveCech.coordinate_cover m n U s r
  change Scheme.Modules.Hom.app (e.hom ≫ g) U (tensorSection U s r) = _
  rw [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
  exact (congrArg (fun z => Scheme.Modules.Hom.app g U z) hunit).trans hmul

/-- The cast between equal integer twists changes no actual local section value. -/
def castTwistIso {m n : ℤ} (h : m=n) : Proj.twistingSheaf 𝒜 m ≅ Proj.twistingSheaf 𝒜 n :=
  eqToIso (congrArg (Proj.twistingSheaf 𝒜) h)

@[simp] theorem castTwistIso_value {m n : ℤ} (h : m=n) (U : (X).Opens)
    (s : Γ(Proj.twistingSheaf 𝒜 m,U)) (x : U) :
    (Scheme.Modules.Hom.app (castTwistIso (I := I) (K := K) h).hom U s).val x=s.val x := by
  subst n
  rfl

def zeroTwistIso (t : ℤ) :
    Proj.twistingSheaf 𝒜 0 ⊗ Proj.twistingSheaf 𝒜 t ≅ Proj.twistingSheaf 𝒜 t :=
  twistingTensorIso 0 t ≪≫ castTwistIso (by omega)

def minusOneTwistIso (t : ℤ) :
    Proj.twistingSheaf 𝒜 (-1) ⊗ Proj.twistingSheaf 𝒜 t ≅ Proj.twistingSheaf 𝒜 (t-1) :=
  twistingTensorIso (-1) t ≪≫ castTwistIso (by omega)

@[simp] theorem zeroTwistIso_value (t : ℤ) (U : (X).Opens)
    (s : Γ(Proj.twistingSheaf 𝒜 0,U)) (r : Γ(Proj.twistingSheaf 𝒜 t,U)) (x : U) :
    (Scheme.Modules.Hom.app (zeroTwistIso (I := I) (K := K) t).hom U (tensorSection U s r)).val x=s.val x*r.val x := by
  simp only [zeroTwistIso,Iso.trans_hom,Scheme.Modules.Hom.comp_app,
    ConcreteCategory.comp_apply,castTwistIso_value,twistingTensorIso_tensorSection]
  rfl

@[simp] theorem minusOneTwistIso_value (t : ℤ) (U : (X).Opens)
    (s : Γ(Proj.twistingSheaf 𝒜 (-1),U)) (r : Γ(Proj.twistingSheaf 𝒜 t,U)) (x : U) :
    (Scheme.Modules.Hom.app (minusOneTwistIso (I := I) (K := K) t).hom U (tensorSection U s r)).val x=s.val x*r.val x := by
  simp only [minusOneTwistIso,Iso.trans_hom,Scheme.Modules.Hom.comp_app,
    ConcreteCategory.comp_apply,castTwistIso_value,twistingTensorIso_tensorSection]
  rfl

/-- Coordinate multiplication commutes with the actual tensor isomorphisms. -/
theorem coordinateMul_twist (i : I) (t : ℤ) :
    (twistFunctor (I := I) (K := K) t).map (coordinateMul (I := I) (K := K) i 0) ≫
      (zeroTwistIso (I := I) (K := K) t).hom=
      (minusOneTwistIso (I := I) (K := K) t).hom ≫ coordinateMul (I := I) (K := K) i t := by
  rw [show (twistFunctor (I := I) (K := K) t).map (coordinateMul (I := I) (K := K) i 0) =
    coordinateMul (I := I) (K := K) i 0 ⊗ₘ 𝟙 (Proj.twistingSheaf 𝒜 t) from
      (MonoidalCategory.tensorHom_id _ _).symm]
  apply tensor_hom_ext_sections (I := I) (K := K)
    (M := Proj.twistingSheaf 𝒜 (0 - 1))
    (N := Proj.twistingSheaf 𝒜 t) (P := Proj.twistingSheaf 𝒜 t)
  intro U s r
  simp only [Scheme.Modules.Hom.comp_app,ConcreteCategory.comp_apply]
  erw [tensorSection_map (I := I) (K := K)
    (coordinateMul (I := I) (K := K) i 0) (𝟙 (Proj.twistingSheaf 𝒜 t)) U s r]
  apply Proj.twistingSheaf.ext
  intro x
  simp only [Scheme.Modules.Hom.id_app,ConcreteCategory.id_apply]
  have hcoordinate (q : ℤ) (v : Γ(Proj.twistingSheaf 𝒜 (q - 1),U)) :
      (Scheme.Modules.Hom.app (coordinateMul (I := I) (K := K) i q) U v).val x =
        (coordinateSection (I := I) (K := K) i U).val x * v.val x := rfl
  erw [zeroTwistIso_value (I := I) (K := K) t U
      (Scheme.Modules.Hom.app (coordinateMul (I := I) (K := K) i 0) U s) r x,
    hcoordinate 0 s,
    hcoordinate t (Scheme.Modules.Hom.app (minusOneTwistIso (I := I) (K := K) t).hom U
      (tensorSection U s r)),
    minusOneTwistIso_value (I := I) (K := K) t U s r x]
  exact mul_assoc ((coordinateSection (I := I) (K := K) i U).val x) (s.val x) (r.val x)

/-- The full tensor of the original Euler source is the actual source at twist t. -/
def eulerSourceTwistIso (t : ℤ) :
    (twistFunctor t).obj (eulerSource (I := I) (K := K)) ≅
      ∏ᶜ fun _ : I => Proj.twistingSheaf 𝒜 (t-1) :=
  PreservesProduct.iso (twistFunctor t) (fun _ : I => Proj.twistingSheaf 𝒜 (-1)) ≪≫
    Pi.mapIso (fun _ => minusOneTwistIso t)

@[reassoc] theorem eulerSourceTwistIso_hom_π (t : ℤ) (i : I) :
    (eulerSourceTwistIso (I := I) (K := K) t).hom ≫ Pi.π _ i=
      (twistFunctor t).map (Pi.π (fun _ : I => Proj.twistingSheaf 𝒜 (-1)) i) ≫
        (minusOneTwistIso t).hom := by
  simp only [eulerSourceTwistIso,Iso.trans_hom,Category.assoc,
    Pi.mapIso_hom_π,PreservesProduct.iso_hom,piComparison_comp_π_assoc]

/-- The entire actual Euler map, not only its separate columns, commutes with
twisting and the proved source/target isomorphisms. -/
theorem eulerMap_twist (t : ℤ) :
    (twistFunctor (I := I) (K := K) t).map (eulerMap (I := I) (K := K) 0) ≫
      (zeroTwistIso (I := I) (K := K) t).hom=
      (eulerSourceTwistIso (I := I) (K := K) t).hom ≫ eulerMap (I := I) (K := K) t := by
  -- Unfold the already typed Euler maps, then use the proved equality of each column.
  letI : (twistFunctor (I := I) (K := K) t).Additive :=
    CategoryTheory.Functor.additive_of_preserves_binary_products
      (twistFunctor (I := I) (K := K) t)
  dsimp only [eulerMap]
  erw [CategoryTheory.Functor.map_sum]
  simp only [Preadditive.sum_comp,Preadditive.comp_sum,
    CategoryTheory.Functor.map_comp,Category.assoc,coordinateMul_twist (I := I) (K := K),
    eulerSourceTwistIso_hom_π_assoc (I := I) (K := K)]
  rfl

/-- Twisting the entire actual Euler kernel is canonically the kernel of the
actual twisted Euler map. -/
def eulerKernelTwistIso (t : ℤ) :
    (twistFunctor t).obj (eulerKernel (I := I) (K := K) 0) ≅
      eulerKernel (I := I) (K := K) t :=
  PreservesKernel.iso (twistFunctor t) (eulerMap (I := I) (K := K) 0) ≪≫
    kernel.mapIso ((twistFunctor t).map (eulerMap (I := I) (K := K) 0)) (eulerMap (I := I) (K := K) t)
      (eulerSourceTwistIso t) (zeroTwistIso t) (eulerMap_twist t)

/-- The exterior-degree-one convention is equivalent to the independently
constructed actual twisted Euler kernel. -/
def exteriorKernelTwistOneEulerIso (t : ℤ) :
    exteriorKernelTwist (I := I) (K := K) 1 t ≅ eulerKernel (I := I) (K := K) t :=
  exteriorKernelTwistOneIso t ≪≫ eulerKernelTwistIso t

end PaperVerification.Segre.EulerTwistComparison

end SegreEulerTwistComparison

