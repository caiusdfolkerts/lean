/-!
# Negative-twist exterior Euler cohomology below projective dimension

For the triangle-inequality format range one needs the stronger negative-twist
vanishing in every degree below the projective dimension, not only below the
exterior degree. It follows directly from the actual Euler sequences and the
literal line-bundle calculation; Serre duality is not needed for this range.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option maxHeartbeats 600000



attribute [local instance] MvPolynomial.gradedAlgebra

namespace PaperVerification.Segre.NegativeExteriorCohomology

open AlgebraicGeometry CategoryTheory Limits
open EulerSheaf EulerCohomology ProjectiveCech TwistedExteriorEuler
open ExteriorCohomology EulerTwistComparison
open TauCeti.AlgebraicGeometry.Scheme.Modules

universe u

variable {I K : Type u} [Fintype I] [DecidableEq I] [Field K]

local notation "𝒜" => MvPolynomial.homogeneousSubmodule I K
local notation "X" => Proj 𝒜

/-- Negative actual twisting sheaves have no cohomology below the projective
dimension, including degree zero. -/
theorem twisting_negative_below_dimension (hI : 1<Fintype.card I) (t : ℤ) (ht : t<0)
    (q : ℕ) (hq : q+1<Fintype.card I) :
    Subsingleton (Cohomology (Proj.twistingSheaf 𝒜 t) q) := by
  cases q with
  | zero => exact twisting_cohomology_zero_of_negative hI t ht
  | succ q => exact twisting_cohomology_vanishes_below_dimension t q hq

/-- The actual first Euler kernel has the same negative-twist vanishing range. -/
theorem eulerKernel_negative_below_dimension (hI : 1<Fintype.card I)
    (t : ℤ) (ht : t<0) (q : ℕ) (hq : q+1<Fintype.card I) :
    Subsingleton (Cohomology (eulerKernel (I := I) (K := K) t) q) := by
  cases q with
  | zero => exact eulerKernel_cohomology_zero hI t ht.le
  | succ q =>
    exact subsingleton_cohomology_X₁ (euler_shortExact (I := I) (K := K) t) q (q+1) rfl
      (twisting_negative_below_dimension hI t ht q (by omega))
      (cohomology_product_subsingleton _ (q+1) (fun _ =>
        twisting_negative_below_dimension hI (t-1) (by omega) (q+1) hq))

/-- The complete negative-twist vanishing used in the paper, stated for actual
exterior powers of the actual Euler kernel. The projective dimension is card I−1. -/
theorem exteriorKernel_negative_below_dimension (hI : 1<Fintype.card I)
    (p q : ℕ) (hq : q+1<Fintype.card I) (t : ℤ) (ht : t<0) :
    Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) p t) q) := by
  induction p using Nat.strong_induction_on generalizing q with
  | ind p ih =>
    by_cases hp : Fintype.card I≤p
    · exact cohomology_subsingleton_of_isZero
        (exteriorKernelTwist_isZero (by omega) p hp t) q
    cases p with
    | zero =>
      exact cohomology_subsingleton_of_iso (exteriorKernelTwistZeroIso t) q
        (twisting_negative_below_dimension hI t ht q hq)
    | succ p =>
      cases p with
      | zero =>
        exact cohomology_subsingleton_of_iso (exteriorKernelTwistOneEulerIso t) q
          (eulerKernel_negative_below_dimension hI t ht q hq)
      | succ p =>
        cases q with
        | zero => exact exteriorKernel_cohomology_zero hI (p+1) t (by omega)
        | succ q =>
          exact subsingleton_cohomology_X₁ (twistedExteriorEuler_shortExact p t)
            q (q+1) rfl (ih (p+1) (by omega) q (by omega))
            (cohomology_subsingleton_of_iso (twistedExteriorSourceIso (p+2) t) (q+1)
              (cohomology_product_subsingleton _ (q+1) (fun _ =>
                twisting_negative_below_dimension hI (t-((p+2 : ℕ) : ℤ))
                  (by omega) (q+1) hq)))

end PaperVerification.Segre.NegativeExteriorCohomology

end SegreNegativeExteriorCohomology

section SegreProductKoszulVanishing

run_cmd do
  let out ← IO.getStderr
  out.putStrLn "SEGRE_STAGE SegreProductKoszulVanishing"
  out.flush

/-!
# The complete graph-format product Koszul cohomology gap

This file supplies a connected geometric vanishing theorem for every
nonempty finite tuple of nonnegative projective dimensions. The sheaf is the
actual iterated external tensor product of the actual Ω^p(t) sheaves, with
literal twists `2p_i - 2r + 2`. Every exterior-degree decomposition of r is
allowed, and every cohomological degree strictly below r vanishes.

The proof uses the actual affine coordinate covers, the proved-source
single-projective-space Euler/Koszul cohomology, and the actual finite
product Cech comparison. Bott support data and a Kunneth isomorphism are
not hypotheses. Identifying these external products with the summands of
the singular section's full twisted Koszul complex is a separate obligation.

-/

set_option autoImplicit false

attribute [local instance] MvPolynomial.gradedAlgebra

namespace PaperVerification.Segre.ProductKoszulVanishing

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open TauCeti.AlgebraicGeometry.Scheme.Modules
open FixedProductCohomology TwistedExteriorEuler ExteriorCohomology
open scoped BigOperators

universe u
variable (K : Type u) [Field K]

/-- The literal nonempty finite external product of the actual exterior Euler sheaves. -/
def exteriorProduct {k : ℕ} (I : Fin (k + 1) → Type u)
    [∀ i, Fintype (I i)] [∀ i, DecidableEq (I i)]
    (p : Fin (k + 1) → ℕ) (t : Fin (k + 1) → ℤ) :
    (CoveredScheme.finiteProduct (fun i => projectiveScheme K (I i))).scheme.Modules :=
  CoveredScheme.finiteExternalTensor (fun i => projectiveScheme K (I i))
    (fun i => exteriorKernelTwist (I := I i) (K := K) (p i) (t i))

/-- For every full graph-format Koszul summand, all actual cohomology
strictly below its exterior degree vanishes. The nonemptiness
hypothesis is exactly `card I_i >= 1`; there is no upper bound on any
exterior degree and no restriction on the field characteristic. -/
theorem graph_format_cohomology_vanishes {k : ℕ}
    (I : Fin (k + 1) → Type u) [∀ i, Fintype (I i)] [∀ i, DecidableEq (I i)]
    (hI : ∀ i, 0 < Fintype.card (I i))
    (p : Fin (k + 1) → ℕ) (r q : ℕ) (hr : 2 ≤ r)
    (hp : (∑ i, p i) = r) (hq : q < r) :
    Subsingleton (Cohomology
      (exteriorProduct K I p (fun i => 2 * (p i : ℤ) - 2 * (r : ℤ) + 2)) q) := by
  apply CoveredScheme.finiteExternalTensor_cohomology_vanishes
  · intro i
    exact EulerQuasicoherent.exteriorKernelTwist_quasicoherent _ _
  intro d hd
  obtain ⟨i, hi⟩ : ∃ i, d i < p i := by
    by_contra hn
    have hle : ∀ i, p i ≤ d i := fun i => Nat.le_of_not_gt (fun h => hn ⟨i, h⟩)
    have hs := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hle i)
    omega
  refine ⟨i, ?_⟩
  change Subsingleton (Cohomology
    (exteriorKernelTwist (I := I i) (K := K) (p i)
      (2 * (p i : ℤ) - 2 * (r : ℤ) + 2)) (d i))
  by_cases hdim : 1 < Fintype.card (I i)
  swap
  · exact cohomology_subsingleton_of_isZero
      (exteriorKernelTwist_isZero (hI i) (p i) (by omega) _) (d i)
  have hpi : p i ≤ r := by
    rw [← hp]
    exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
  by_cases he : p i = r
  · have ht : 2 * (p i : ℤ) - 2 * (r : ℤ) + 2 = 2 := by omega
    rw [ht]
    exact exteriorKernel_acyclic_of_positive_twist_le_degree
      hdim (p i) (d i) 2 (by norm_num) (by omega)
  · exact exteriorKernel_cohomology_below_degree hdim (p i) (d i) hi _ (by omega)


/-- The actual projective dimensions obey every balanced-format triangle inequality. -/
def TriangleDimensions {k : ℕ} (I : Fin (k + 1) → Type u) [∀ i, Fintype (I i)] : Prop :=
  ∀ i, Fintype.card (I i) - 1 ≤
    ∑ j ∈ Finset.univ.erase i, (Fintype.card (I j) - 1)

/-- The balanced-format Koszul gap for the actual sheaf on the same fixed
product scheme. It holds over every field, with all exterior-degree
partitions included, and with precisely the full triangle inequalities on
the projective dimensions. -/
theorem balanced_format_cohomology_vanishes {k : ℕ}
    (I : Fin (k + 1) → Type u) [∀ i, Fintype (I i)] [∀ i, DecidableEq (I i)]
    (hI : ∀ i, 0 < Fintype.card (I i)) (htriangle : TriangleDimensions I)
    (p : Fin (k + 1) → ℕ) (r q : ℕ) (hr : 2 ≤ r)
    (hp : (∑ i, p i) = r) (hq : q < r) :
    Subsingleton (Cohomology
      (exteriorProduct K I p (fun i => 1 + 2 * (p i : ℤ) - (r : ℤ))) q) := by
  apply CoveredScheme.finiteExternalTensor_cohomology_vanishes
  · intro i
    exact EulerQuasicoherent.exteriorKernelTwist_quasicoherent _ _
  intro d hd
  let n : Fin (k + 1) → ℕ := fun i => Fintype.card (I i) - 1
  have hcard (i : Fin (k + 1)) : Fintype.card (I i) = n i + 1 := by
    have hi := hI i
    dsimp only [n]
    omega
  by_cases hlarge : ∃ j, n j < p j
  · obtain ⟨j, hj⟩ := hlarge
    refine ⟨j, cohomology_subsingleton_of_isZero
      (exteriorKernelTwist_isZero (by have hh := hI j; omega) (p j)
        (by rw [hcard]; omega) _) (d j)⟩
  have hpn (j : Fin (k + 1)) : p j ≤ n j :=
    Nat.le_of_not_gt (fun h => hlarge ⟨j, h⟩)
  obtain ⟨i, hi⟩ : ∃ i, d i < p i := by
    by_contra hn
    have hle : ∀ i, p i ≤ d i := fun i =>
      Nat.le_of_not_gt (fun h => hn ⟨i, h⟩)
    have hs := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hle i)
    omega
  have hdim : 1 < Fintype.card (I i) := by
    have hni := hpn i
    rw [hcard]
    omega
  by_cases hti : 1 + 2 * (p i : ℤ) - (r : ℤ) ≤ 0
  · exact ⟨i, exteriorKernel_cohomology_below_degree
      hdim (p i) (d i) hi _ hti⟩
  have hti0 : 0 < 1 + 2 * (p i : ℤ) - (r : ℤ) := by omega
  by_cases hdi : d i = 0
  · by_cases htpi : 1 + 2 * (p i : ℤ) - (r : ℤ) ≤ (p i : ℤ)
    · exact ⟨i, exteriorKernel_acyclic_of_positive_twist_le_degree
        hdim (p i) (d i) _ hti0 htpi⟩
    have hpi_le : p i ≤ r := by
      rw [← hp]
      exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    have hpi : p i = r := by omega
    have hpsum : ∑ j ∈ Finset.univ.erase i, p j = 0 := by
      have he := Finset.sum_erase_add Finset.univ p (Finset.mem_univ i)
      rw [hp, hpi] at he
      omega
    have hdother : (∑ j ∈ Finset.univ.erase i, d j) <
        ∑ j ∈ Finset.univ.erase i, n j := by
      have hle : (∑ j ∈ Finset.univ.erase i, d j) ≤ ∑ j, d j :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.erase_subset _ _)
          (fun _ _ _ => Nat.zero_le _)
      have hni := hpn i
      have htri : n i ≤ ∑ j ∈ Finset.univ.erase i, n j := htriangle i
      omega
    obtain ⟨j, hj, hdj⟩ : ∃ j ∈ Finset.univ.erase i, d j < n j := by
      by_contra he
      have hle : ∀ j ∈ Finset.univ.erase i, n j ≤ d j := by
        intro j hj
        exact Nat.le_of_not_gt (fun h => he ⟨j, hj, h⟩)
      exact (not_le_of_gt hdother) (Finset.sum_le_sum hle)
    have hpj : p j = 0 := by
      have hle := Finset.single_le_sum (f := p) (fun _ _ => Nat.zero_le _) hj
      rw [hpsum] at hle
