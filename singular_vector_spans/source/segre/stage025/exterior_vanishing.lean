section SegreExteriorCohomology

/-!
# Cohomology vanishing for actual exterior Euler kernels

The statements below concern derived cohomology of the actual exterior powers
and tensor products of sheaves. Positive twists have no higher cohomology. At
nonpositive twist, cohomology below the exterior degree vanishes. The proof uses
the actual twisted exterior Euler sequences and the full line-bundle Čech
calculation. Exterior degrees beyond the projective dimension are proved zero
as sheaves, before they are used as the starting point of descending induction.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option maxHeartbeats 600000



attribute [local instance] MvPolynomial.gradedAlgebra

namespace PaperVerification.Segre.ExteriorCohomology

open AlgebraicGeometry CategoryTheory Limits MonoidalCategory
open EulerSheaf EulerSections ExteriorEuler ExteriorTwist TwistedExteriorEuler
open ProjectiveCech EulerCohomology
open TauCeti.AlgebraicGeometry.Scheme.Modules

universe u

variable {I K : Type u} [Fintype I] [DecidableEq I] [Field K]

local notation "𝒜" => MvPolynomial.homogeneousSubmodule I K
local notation "X" => Proj 𝒜

/-- Vanishing transports through an isomorphism of the actual sheaves. -/
theorem cohomology_subsingleton_of_iso {M N : (X).Modules} (e : M ≅ N) (q : ℕ)
    (h : Subsingleton (Cohomology N q)) : Subsingleton (Cohomology M q) := by
  let f := (cohomologyFunctor X q).mapIso e
  exact ⟨fun x y => (ConcreteCategory.bijective_of_isIso f.hom).1 (h.elim _ _)⟩

/-- A zero sheaf has zero derived cohomology in every degree. -/
theorem cohomology_subsingleton_of_isZero {M : (X).Modules} (h : IsZero M) (q : ℕ) :
    Subsingleton (Cohomology M q) :=
  AddCommGrpCat.subsingleton_of_isZero ((cohomologyFunctor X q).map_isZero h)

/-- The entire exterior source vanishes once its exterior index exceeds the
number of homogeneous coordinates. -/
theorem exteriorSourceTwist_isZero (p : ℕ) (hp : Fintype.card I<p) (t : ℤ) :
    IsZero (exteriorSourceTwist (I := I) (K := K) p t) := by
  letI : IsEmpty (Set.powersetCard I p) := ⟨fun s =>
    (not_le_of_gt hp) (Set.powersetCard.nonempty_iff.mp ⟨s⟩)⟩
  have hz : IsZero (∏ᶜ fun _ : Set.powersetCard I p =>
      Proj.twistingSheaf 𝒜 (t-(p : ℤ))) := by
    apply (IsZero.iff_id_eq_zero _).mpr
    apply Pi.hom_ext
    intro s
    exact isEmptyElim s
  exact hz.of_iso (twistedExteriorSourceIso p t)

/-- The exterior powers of the actual Euler kernel vanish above the projective
dimension. This follows from the epimorphism in the next exterior Euler sequence. -/
theorem exteriorKernelTwist_isZero (hI : 0<Fintype.card I) (p : ℕ)
    (hp : Fintype.card I≤p) (t : ℤ) :
    IsZero (exteriorKernelTwist (I := I) (K := K) p t) := by
  obtain ⟨r,rfl⟩ : ∃ r,p=r+1 := ⟨p-1,by omega⟩
  let S := twistedExteriorEulerSequence (I := I) (K := K) r t
  have hS : S.ShortExact := twistedExteriorEuler_shortExact r t
  letI : Epi S.g := hS.epi_g
  exact IsZero.of_epi S.g (exteriorSourceTwist_isZero (r+2) (by omega) t)

/-- The canonical inclusion into the corresponding exterior source, also in
exterior degree one where it is the original Euler-kernel inclusion. -/
def positiveKernelInclusion : (p : ℕ) → (t : ℤ) →
    exteriorKernelTwist (I := I) (K := K) (p+1) t ⟶ exteriorSourceTwist (p+1) t
  | 0,t => (exteriorKernelTwistOneIso t).hom ≫
      (twistFunctor t).map (kernel.ι (eulerMap (I := I) (K := K) 0)) ≫
      ((twistFunctor t).mapIso
        ((SheafOfModules.exteriorPowerOneIso (X).sheaf).app (eulerSource (I := I) (K := K)))).inv
  | p+1,t => (twistedExteriorEulerSequence p t).f

instance positiveKernelInclusion_mono (p : ℕ) (t : ℤ) :
    Mono (positiveKernelInclusion (I := I) (K := K) p t) := by
  cases p with
  | zero =>
      haveI : Mono ((twistFunctor (I := I) (K := K) t).map
          (kernel.ι (eulerMap (I := I) (K := K) 0))) :=
        Functor.map_mono (twistFunctor (I := I) (K := K) t)
          (kernel.ι (eulerMap (I := I) (K := K) 0))
      change Mono ((exteriorKernelTwistOneIso (I := I) (K := K) t).hom ≫
        (twistFunctor (I := I) (K := K) t).map
          (kernel.ι (eulerMap (I := I) (K := K) 0)) ≫
        ((twistFunctor (I := I) (K := K) t).mapIso
          ((SheafOfModules.exteriorPowerOneIso (X).sheaf).app
            (eulerSource (I := I) (K := K)))).inv)
      infer_instance
  | succ p => exact (twistedExteriorEuler_shortExact p t).mono_f

/-- All exterior-kernel global sections vanish whenever the twist is smaller
than the positive exterior degree. -/
theorem exteriorKernel_cohomology_zero (hI : 1<Fintype.card I) (p : ℕ) (t : ℤ)
    (ht : t<(p+1 : ℕ)) :
    Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) (p+1) t) 0) := by
  have hm : Subsingleton (Cohomology (exteriorSourceTwist (I := I) (K := K) (p+1) t) 0) :=
    cohomology_subsingleton_of_iso (twistedExteriorSourceIso (p+1) t) 0
      (cohomology_product_subsingleton _ 0 (fun _ =>
        twisting_cohomology_zero_of_negative hI (t-((p+1 : ℕ) : ℤ)) (by omega)))
  exact ⟨fun x y => (cohomologyMap_injective (positiveKernelInclusion p t)) (hm.elim _ _)⟩

/-- At nonpositive twist, every cohomology group below the exterior degree is
zero. The degree and all quantifiers are unrestricted. -/
theorem exteriorKernel_cohomology_below_degree (hI : 1<Fintype.card I)
    (p q : ℕ) (hq : q<p) (t : ℤ) (ht : t≤0) :
    Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) p t) q) := by
  induction p using Nat.strong_induction_on generalizing q with
  | ind p ih =>
    by_cases hp : Fintype.card I≤p
    · exact cohomology_subsingleton_of_isZero (exteriorKernelTwist_isZero (by omega) p hp t) q
    have hp' : p<Fintype.card I := Nat.lt_of_not_ge hp
    obtain ⟨r,rfl⟩ : ∃ r,p=r+1 := ⟨p-1,by omega⟩
    cases q with
    | zero => exact exteriorKernel_cohomology_zero hI r t (by omega)
    | succ q =>
      obtain ⟨s,rfl⟩ : ∃ s,r=s+1 := ⟨r-1,by omega⟩
      have hprev := ih (s+1) (by omega) q (by omega)
      have hmiddle : Subsingleton (Cohomology
          (exteriorSourceTwist (I := I) (K := K) (s+2) t) (q+1)) :=
        cohomology_subsingleton_of_iso (twistedExteriorSourceIso (s+2) t) (q+1)
          (cohomology_product_subsingleton _ (q+1) (fun _ =>
            twisting_cohomology_vanishes_below_dimension (t-((s+2 : ℕ) : ℤ)) q (by omega)))
      exact subsingleton_cohomology_X₁ (twistedExteriorEuler_shortExact s t)
        q (q+1) rfl hprev hmiddle

/-- At positive twist, every positive-degree cohomology group of every exterior
Euler kernel vanishes. Descending exterior-degree induction starts with the
proved zero sheaf, and uses the actual long exact cohomology sequence. -/
theorem exteriorKernel_cohomology_positive_twist (hI : 1<Fintype.card I)
    (p q : ℕ) (t : ℤ) (ht : 0<t) :
    Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) p t) (q+1)) := by
  suffices h : ∀ d p : ℕ, Fintype.card I-p=d → ∀ q : ℕ,
      Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) p t) (q+1)) from
    h _ p rfl q
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro p hd q
    by_cases hp : Fintype.card I≤p
    · exact cohomology_subsingleton_of_isZero
        (exteriorKernelTwist_isZero (by omega) p hp t) (q+1)
    have hp' : p<Fintype.card I := Nat.lt_of_not_ge hp
    cases p with
    | zero =>
      exact cohomology_subsingleton_of_iso (exteriorKernelTwistZeroIso t) (q+1)
        (twisting_cohomology_vanishes_of_twist t (by omega) q)
    | succ p =>
      have hnext := ih (Fintype.card I-(p+2)) (by omega) (p+2) rfl (q+1)
      have hmiddle : Subsingleton (Cohomology
          (exteriorSourceTwist (I := I) (K := K) (p+2) t) (q+1)) :=
        cohomology_subsingleton_of_iso (twistedExteriorSourceIso (p+2) t) (q+1)
          (cohomology_product_subsingleton _ (q+1) (fun _ =>
            twisting_cohomology_vanishes_of_twist (t-((p+2 : ℕ) : ℤ)) (by omega) q))
      exact subsingleton_cohomology_X₃ (twistedExteriorEuler_shortExact p t)
        (q+1) (q+2) rfl hmiddle hnext

/-- The full degree-zero Bott vanishing range, including the equality case
`t = p+1`. The next exterior Euler sequence has negative-twist middle term;
its positive-twist left term has zero first cohomology by the preceding
unrestricted descending argument. No dimension formula or division is used. -/
theorem exteriorKernel_cohomology_zero_of_twist_le_degree
    (hI : 1<Fintype.card I) (p : ℕ) (t : ℤ) (ht : t≤(p+1 : ℕ)) :
    Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) (p+1) t) 0) := by
  by_cases ht0 : t≤0
  · exact exteriorKernel_cohomology_zero hI p t (by omega)
  have hmiddle : Subsingleton (Cohomology
      (exteriorSourceTwist (I := I) (K := K) (p+2) t) 0) :=
    cohomology_subsingleton_of_iso (twistedExteriorSourceIso (p+2) t) 0
      (cohomology_product_subsingleton _ 0 (fun _ =>
        twisting_cohomology_zero_of_negative hI (t-((p+2 : ℕ) : ℤ)) (by omega)))
  have hnext : Subsingleton (Cohomology
      (exteriorKernelTwist (I := I) (K := K) (p+2) t) 1) :=
    exteriorKernel_cohomology_positive_twist hI (p+2) 0 t (by omega)
  exact subsingleton_cohomology_X₃ (twistedExteriorEuler_shortExact p t)
    0 1 rfl hmiddle hnext

/-- Every exterior Euler kernel at a positive twist at most its exterior
index is acyclic in all cohomological degrees. This is the complete
positive-twist vanishing range used in the triangular-format argument. -/
theorem exteriorKernel_acyclic_of_positive_twist_le_degree
    (hI : 1<Fintype.card I) (p q : ℕ) (t : ℤ) (ht0 : 0<t) (ht : t≤(p : ℤ)) :
    Subsingleton (Cohomology (exteriorKernelTwist (I := I) (K := K) p t) q) := by
  cases q with
  | succ q => exact exteriorKernel_cohomology_positive_twist hI p q t ht0
  | zero =>
    obtain ⟨r,rfl⟩ : ∃ r,p=r+1 := ⟨p-1,by omega⟩
    exact exteriorKernel_cohomology_zero_of_twist_le_degree hI r t ht

end PaperVerification.Segre.ExteriorCohomology

end SegreExteriorCohomology

