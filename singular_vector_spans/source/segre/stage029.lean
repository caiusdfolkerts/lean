section SegreBooleanIntervals

/-!
# Literal Boolean intervals and their full comparability graphs

For `a ⊆ b`, adjoining `a` identifies the Boolean lattice on `b \ a`
with the actual interval `[a,b]`. Both inclusion and graph adjacency are
preserved. The unrestricted Boolean rigidity theorem therefore applies to
every interval whose block has at least four elements.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.BooleanIntervals

open GenericRigidity Staircase RankParameters Comparability ChainInduction

variable {K V : Type*} [Field K] [Infinite K] [Fintype V] [DecidableEq V]

/-- The actual Boolean interval, not an abstract graph with copied adjacency. -/
noncomputable def intervalEquiv (a b : Finset V) (hab : a ⊆ b) :
    Finset ↥(b \ a) ≃ ↥(Set.Icc a b) := by
  classical
  refine
    { toFun := fun s =>
        ⟨a ∪ s.map (Function.Embedding.subtype _),
          Finset.subset_union_left,
          Finset.union_subset hab (fun x hx =>
            (Finset.mem_sdiff.mp (s.property_of_mem_map_subtype hx)).1)⟩
      invFun := fun s => s.val.subtype (fun x => x ∈ b \ a)
      left_inv := ?_
      right_inv := ?_ }
  · intro s
    ext x
    have hx := (Finset.mem_sdiff.mp x.property).2
    simp only [Finset.mem_subtype, Finset.mem_union, hx, false_or]
    exact Finset.mem_map' _
  · intro s
    apply Subtype.ext
    ext x
    by_cases hxa : x ∈ a
    · have hxs : x ∈ s.val := s.property.1 hxa
      simp only [Finset.mem_union, hxa, true_or, hxs]
    · constructor
      · intro hx
        rcases Finset.mem_union.mp hx with ha | hm
        · exact False.elim (hxa ha)
        · obtain ⟨y, hy, hxy⟩ := Finset.mem_map.mp hm
          exact hxy ▸ Finset.mem_subtype.mp hy
      · intro hx
        have hxb : x ∈ b := s.property.2 hx
        exact Finset.mem_union.mpr (Or.inr (Finset.mem_map.mpr
          ⟨⟨x, Finset.mem_sdiff.mpr ⟨hxb, hxa⟩⟩,
            Finset.mem_subtype.mpr hx, rfl⟩))

theorem intervalEquiv_subset_iff (a b : Finset V) (hab : a ⊆ b)
    (s t : Finset ↥(b \ a)) :
    (intervalEquiv a b hab s).val ⊆ (intervalEquiv a b hab t).val ↔ s ⊆ t := by
  constructor
  · intro h x hx
    have hx' : x.val ∈ (intervalEquiv a b hab s).val :=
      Finset.mem_union.mpr (Or.inr (Finset.mem_map.mpr ⟨x, hx, rfl⟩))
    have ht := h hx'
    rcases Finset.mem_union.mp ht with ha | hm
    · exact False.elim ((Finset.mem_sdiff.mp x.property).2 ha)
    · exact (Finset.mem_map' _).mp hm
  · intro h
    exact Finset.union_subset_union Finset.Subset.rfl (Finset.map_subset_map.mpr h)

theorem full_boolean_rigid (hV : 4 ≤ Fintype.card V) :
    GenericallyRigid K (Fin (Fintype.card V + 1)) (Comparability.graph (Finset V)) := by
  classical
  let e : Fin (Fintype.card V) ≃ V := (Fintype.equivFin V).symm
  let E : Cell (fun _ : Fin (Fintype.card V) => 1) ≃ Finset V :=
    (booleanCellEquiv (V := Fin (Fintype.card V))).trans e.finsetCongr
  have hr := positive_four_or_more (K := K) (Fintype.card V) hV
    (fun _ => 1) (fun _ => le_rfl)
  have hr' : GenericallyRigid K (Fin (Fintype.card V + 1))
      (chainGraph (fun _ : Fin (Fintype.card V) => 1)) := by
    apply genericallyRigid_fin _ _ ?_ hr
    simp [sideSum]
  apply ThreeChainCores.rigid_of_le_comap_equiv _ _ E _ hr'
  intro s t h
  change E s ≠ E t ∧ (E s ⊆ E t ∨ E t ⊆ E s)
  refine ⟨fun he => h.1 (E.injective he), ?_⟩
  change (booleanCellEquiv s).map e.toEmbedding ⊆ (booleanCellEquiv t).map e.toEmbedding ∨
    (booleanCellEquiv t).map e.toEmbedding ⊆ (booleanCellEquiv s).map e.toEmbedding
  simp only [Finset.map_subset_map, ← booleanCell_le_iff]
  exact h.2

/-- A block of any size at least four supplies its full `block size + 1`
rigidity dimension, over every infinite field and in every characteristic. -/
theorem interval_rigid (a b : Finset V) (hab : a ⊆ b)
    (hsize : 4 ≤ b.card - a.card) :
    GenericallyRigid K (Fin (b.card - a.card + 1))
      ((Comparability.graph (Finset V)).induce (Set.Icc a b)) := by
  classical
  have hc : Fintype.card ↥(b \ a) = b.card - a.card := by
    rw [Fintype.card_coe, Finset.card_sdiff_of_subset hab]
  have hr := full_boolean_rigid (K := K) (V := ↥(b \ a)) (by rwa [hc])
  rw [hc] at hr
  apply ThreeChainCores.rigid_of_le_comap_equiv _ _ (intervalEquiv a b hab) _ hr
  intro s t h
  change (intervalEquiv a b hab s).val ≠ (intervalEquiv a b hab t).val ∧
    ((intervalEquiv a b hab s).val ⊆ (intervalEquiv a b hab t).val ∨
      (intervalEquiv a b hab t).val ⊆ (intervalEquiv a b hab s).val)
  refine ⟨fun he => h.1 ((intervalEquiv a b hab).injective (Subtype.ext he)), ?_⟩
  rw [intervalEquiv_subset_iff, intervalEquiv_subset_iff]
  exact h.2

end PaperVerification.Segre.BooleanIntervals

end SegreBooleanIntervals

section SegreIntervalCore

/-!
# The full core of consecutive Boolean intervals

The core is the literal union of intervals between consecutive prefix sets.
Consecutive intervals have exactly one common prefix, and every earlier vertex
is comparable with every later one. The amalgamated-join theorem adds their
full rigidity dimensions. For `t` blocks partitioning a `k`-element ground set,
this gives dimension `k+t`, with both global endpoints retained.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.IntervalCore

open GenericRigidity BooleanIntervals

variable {V : Type*} [Fintype V] [DecidableEq V]

def core (a : Finset V) : List (Finset V) → Set (Finset V)
  | [] => {a}
  | b :: l => Set.Icc a b ∪ core b l

def nested (a : Finset V) : List (Finset V) → Prop
  | [] => True
  | b :: l => a ⊆ b ∧ nested b l

def largeBlocks (a : Finset V) : List (Finset V) → Prop
  | [] => True
  | b :: l => 4 ≤ b.card - a.card ∧ largeBlocks b l

def dimension (a : Finset V) : List (Finset V) → ℕ
  | [] => 0
  | b :: l => (b.card - a.card + 1) + dimension b l

def endpoint (a : Finset V) : List (Finset V) → Finset V
  | [] => a
  | b :: l => endpoint b l

theorem start_mem (a : Finset V) (l : List (Finset V)) (h : nested a l) :
    a ∈ core a l := by
  cases l with
  | nil => rfl
  | cons b l => exact Or.inl ⟨le_rfl, h.1⟩

theorem endpoint_mem (a : Finset V) (l : List (Finset V)) :
    endpoint a l ∈ core a l := by
  induction l generalizing a with
  | nil => rfl
  | cons b l ih => exact Or.inr (ih b)

theorem start_le (a : Finset V) (l : List (Finset V)) (h : nested a l)
    {s : Finset V} (hs : s ∈ core a l) : a ⊆ s := by
  induction l generalizing a with
  | nil => exact le_of_eq hs.symm
  | cons b l ih =>
    rcases hs with hs | hs
    · exact hs.1
    · exact h.1.trans (ih b h.2 hs)

theorem le_endpoint (a : Finset V) (l : List (Finset V)) (h : nested a l)
    {s : Finset V} (hs : s ∈ core a l) : s ⊆ endpoint a l := by
  induction l generalizing a with
  | nil => exact le_of_eq hs
  | cons b l ih =>
    rcases hs with hs | hs
    · exact hs.2.trans (start_le b l h.2 (endpoint_mem b l))
    · exact ih b h.2 hs

noncomputable def tailBase (b : Finset V) (l : List (Finset V)) (h : nested b l) :
    ↥(core b l) := ⟨b, start_mem b l h⟩

noncomputable def stepEquiv (a b : Finset V) (l : List (Finset V))
    (hab : a ⊆ b) (hl : nested b l) :
    (↥(Set.Icc a b) ⊕ {s : ↥(core b l) // s ≠ tailBase b l hl}) ≃
      ↥(core a (b :: l)) := by
  classical
  let F : (↥(Set.Icc a b) ⊕ {s : ↥(core b l) // s ≠ tailBase b l hl}) →
      ↥(core a (b :: l)) := fun v => match v with
    | .inl s => ⟨s.val, Or.inl s.property⟩
    | .inr s => ⟨s.val.val, Or.inr s.val.property⟩
  apply Equiv.ofBijective F
  constructor
  · intro s t hst
    have he := congrArg Subtype.val hst
    cases s with
    | inl s =>
      cases t with
      | inl t => exact congrArg Sum.inl (Subtype.ext he)
      | inr t =>
        change s.val = t.val.val at he
        have hb : t.val.val = b := le_antisymm (he ▸ s.property.2)
          (start_le b l hl t.val.property)
        exact False.elim (t.property (Subtype.ext hb))
    | inr s =>
      cases t with
      | inl t =>
        change s.val.val = t.val at he
        have hb : s.val.val = b := le_antisymm (he.symm ▸ t.property.2)
          (start_le b l hl s.val.property)
        exact False.elim (s.property (Subtype.ext hb))
      | inr t => exact congrArg Sum.inr (Subtype.ext (Subtype.ext he))
  · intro s
    rcases s.property with hs | hs
    · exact ⟨.inl ⟨s.val, hs⟩, rfl⟩
    · let s' : ↥(core b l) := ⟨s.val, hs⟩
      by_cases hb : s' = tailBase b l hl
      · refine ⟨.inl ⟨b, hab, le_rfl⟩, Subtype.ext ?_⟩
        exact (congrArg Subtype.val hb).symm
      · exact ⟨.inr ⟨s', hb⟩, rfl⟩

theorem step_graph_le (a b : Finset V) (l : List (Finset V))
    (hab : a ⊆ b) (hl : nested b l) :
    AmalgamatedJoin.graph
      ((Comparability.graph (Finset V)).induce (Set.Icc a b))
      ((Comparability.graph (Finset V)).induce (core b l)) (tailBase b l hl) ≤
    ((Comparability.graph (Finset V)).induce (core a (b :: l))).comap
      (stepEquiv a b l hab hl) := by
  intro s t h
  cases s with
  | inl s =>
    cases t with
    | inl t => exact h
    | inr t =>
      change s.val ≠ t.val.val ∧ (s.val ⊆ t.val.val ∨ t.val.val ⊆ s.val)
      refine ⟨?_, Or.inl (s.property.2.trans (start_le b l hl t.val.property))⟩
      intro he
      have hb : t.val.val = b := le_antisymm (he ▸ s.property.2)
        (start_le b l hl t.val.property)
      exact t.property (Subtype.ext hb)
  | inr s =>
    cases t with
    | inl t =>
      change s.val.val ≠ t.val ∧ (s.val.val ⊆ t.val ∨ t.val ⊆ s.val.val)
      refine ⟨?_, Or.inr (t.property.2.trans (start_le b l hl s.val.property))⟩
      intro he
      have hb : s.val.val = b := le_antisymm (he.symm ▸ t.property.2)
        (start_le b l hl s.val.property)
      exact s.property (Subtype.ext hb)
    | inr t => exact h

theorem dimension_telescope (a : Finset V) (l : List (Finset V))
    (h : nested a l) :
    a.card + dimension a l = (endpoint a l).card + l.length := by
  induction l generalizing a with
  | nil => simp [dimension, endpoint]
  | cons b l ih =>
    have hc := Finset.card_le_card h.1
    have ht := ih b h.2
    simp only [dimension, endpoint, List.length_cons]
    omega

/-- Every literal prefix core with blocks of size at least four is rigid in
the sum of the full interval dimensions. No partition or overlap assumption
is silently supplied as a hypothesis to a principal theorem. -/
theorem core_rigid {K : Type*} [Field K] [Infinite K]
    (a : Finset V) (l : List (Finset V)) (hn : nested a l) (hb : largeBlocks a l) :
    GenericallyRigid K (Fin (dimension a l))
      ((Comparability.graph (Finset V)).induce (core a l)) := by
  classical
  induction l generalizing a with
  | nil =>
    let T := ↥(core a [])
    have ht : Nonempty T := ⟨⟨a, rfl⟩⟩
    have hg : (⊤ : SimpleGraph T) =
        ((Comparability.graph (Finset V)).induce (core a [])) := by
      ext s t
      have he : s = t := Subtype.ext (s.property.trans t.property.symm)
      subst t
      constructor <;> intro h <;> exact False.elim (h.ne rfl)
    have hc : Fintype.card (Fin 0) + 1 ≤ Fintype.card T := by
      simp only [Fintype.card_fin, zero_add]
      exact Fintype.card_pos_iff.mpr ht
    have hr : GenericallyRigid K (Fin 0)
        ((Comparability.graph (Finset V)).induce (core a [])) := by
      simpa only [hg] using
        (complete_genericallyRigid (K := K) (I := Fin 0) (V := T) hc)
    apply genericallyRigid_fin _ _ ?_ hr
    simp [dimension]
  | cons b l ih =>
    have hfirst := interval_rigid (K := K) a b hn.1 hb.1
    have htail := ih b hn.2 hb.2
    have hj := AmalgamatedJoin.genericallyRigid_amalgamated _ _
      (⟨b, hn.1, le_rfl⟩ : ↥(Set.Icc a b)) (tailBase b l hn.2) hfirst htail
    have hs := ThreeChainCores.rigid_of_le_comap_equiv _ _
      (stepEquiv a b l hn.1 hn.2) (step_graph_le a b l hn.1 hn.2) hj
    apply genericallyRigid_fin _ _ ?_ hs
    simp only [Fintype.card_sum, Fintype.card_fin, dimension]

/-- In particular, a partition of the full ground set into `t` blocks gives
the exact full-graph dimension `k+t`, as used in Theorem 6.1(i). -/
theorem partition_core_rigid {K : Type*} [Field K] [Infinite K]
    (l : List (Finset V)) (hn : nested ∅ l) (hb : largeBlocks ∅ l)
    (hend : endpoint ∅ l = Finset.univ) :
    GenericallyRigid K (Fin (Fintype.card V + l.length))
      ((Comparability.graph (Finset V)).induce (core ∅ l)) := by
  classical
  have hd := dimension_telescope (∅ : Finset V) l hn
  simp only [Finset.card_empty, zero_add, hend, Finset.card_univ] at hd
  apply genericallyRigid_fin _ _ ?_ (core_rigid (K := K) ∅ l hn hb)
  simpa only [Fintype.card_fin] using hd

end PaperVerification.Segre.IntervalCore

end SegreIntervalCore

section SegreConnectedCover

/-!
# Rigidity of a connected cover

The indexing relation only records overlaps containing an affine basis.
A finite product of the actual nonzero minor certificates selects one
placement for every core and overlap. Rigid motions then agree along paths.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.GenericRigidity

open Matrix RigidityRank
open scoped Matrix

variable {K I V J : Type*} [Field K] [Infinite K]
  [Fintype I] [DecidableEq I] [Fintype V] [Fintype J]

theorem genericallyRigid_connected_cover (G : SimpleGraph V)
    (S : J → Set V) (j₀ : J) (E : J → J → Prop)
    (hcover : ∀ v, ∃ j, v ∈ S j)
    (hS : ∀ j, GenericallyRigid K I (G.induce (S j)))
    (hcard : ∀ j l, E j l → Fintype.card I + 1 ≤ Nat.card ↥(S j ∩ S l))
    (hconnected : ∀ j, Relation.ReflTransGen E j₀ j) :
    GenericallyRigid K I G := by
  classical
  let Edges := {p : J × J // E p.1 p.2}
  choose f hf hwf using fun j => rigidity_certificate (G.induce (S j))
    (Function.Embedding.subtype (fun v => v ∈ S j)) (hS j)
  have hc (p : Edges) : Fintype.card I + 1 ≤ Fintype.card ↥(S p.val.1 ∩ S p.val.2) := by
    simpa only [Nat.card_eq_fintype_card] using hcard p.val.1 p.val.2 p.property
  choose g hg hwg using fun p : Edges => affineSpan_certificate (K := K) (I := I)
    (Function.Embedding.subtype (fun v => v ∈ S p.val.1 ∩ S p.val.2)) (hc p)
  have hfprod : (∏ j, f j) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun j _ => hf j)
  have hgprod : (∏ p : Edges, g p) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun p _ => hg p)
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero
    ((∏ j, f j) * ∏ p : Edges, g p) (mul_ne_zero hfprod hgprod)
  rw [map_mul, mul_ne_zero_iff, map_prod, map_prod] at hz
  have hzf (j : J) : MvPolynomial.eval z (f j) ≠ 0 :=
    Finset.prod_ne_zero_iff.mp hz.1 j (Finset.mem_univ _)
  have hzg (p : Edges) : MvPolynomial.eval z (g p) ≠ 0 :=
    Finset.prod_ne_zero_iff.mp hz.2 p (Finset.mem_univ _)
  let p : Matrix V I K := Matrix.of (flattenVelocity.symm z)
  have hpz : flattenVelocity p = z := rfl
  have hrigid (j : J) : InfinitesimallyRigidOn G p (S j) := by
    apply (rigidOn_induce_iff G p (S j)).mp
    exact (hwf j p (by rw [hpz]; exact hzf j)).2
  have hspan (j l : J) (hjl : E j l) : affineSpan K (p '' (S j ∩ S l)) = ⊤ := by
    have h := hwg (⟨(j,l),hjl⟩ : Edges) p (by rw [hpz]; exact hzg _)
    change affineSpan K (Set.range (Matrix.of
      (fun w : ↥(S j ∩ S l) => p w.val))) = ⊤ at h
    rwa [range_restricted] at h
  refine ⟨p, ?_, ?_⟩
  · have h := (hwf j₀ p (by rw [hpz]; exact hzf j₀)).1
    change affineSpan K (Set.range (Matrix.of (fun w : ↥(S j₀) => p w.val))) = ⊤ at h
    rw [range_restricted] at h
    apply top_unique
    rw [← h]
    exact affineSpan_mono K (Set.image_subset_range _ _)
  · intro u hu
    have hconstraint (j : J) : ∀ v ∈ S j, ∀ w ∈ S j, G.Adj v w →
        (p v - p w) ⬝ᵥ (u v - u w) = 0 := by
      intro v _ w _ hvw
      exact hu v (Set.mem_univ _) w (Set.mem_univ _) hvw
    choose M t hMt hMd hmotion using fun j => hrigid j u (hconstraint j)
    have hedge (j l : J) (hjl : E j l) :
        motionAffineMap (M j) (t j) = motionAffineMap (M l) (t l) := by
      apply AffineMap.ext_on (hspan j l hjl)
      rintro x ⟨w, hw, rfl⟩
      change M j *ᵥ p w + t j = M l *ᵥ p w + t l
      exact (hmotion j w hw.1).symm.trans (hmotion l w hw.2)
    have hmotion_eq (j : J) :
        motionAffineMap (M j₀) (t j₀) = motionAffineMap (M j) (t j) := by
      induction hconnected j with
      | refl => rfl
      | @tail j l _ hjl ih => exact ih.trans (hedge j l hjl)
    refine ⟨M j₀,t j₀,hMt j₀,hMd j₀,?_⟩
    intro v _
    obtain ⟨j,hvj⟩ := hcover v
    rw [hmotion j v hvj]
    exact (congrArg (fun a : (I → K) →ᵃ[K] (I → K) => a (p v)) (hmotion_eq j)).symm

end PaperVerification.Segre.GenericRigidity

end SegreConnectedCover

section SegreBooleanCoreCover

/-!
# A cover of the Boolean lattice by two-interval cores

The cores are indexed by four-element subsets. They cover every subset;
exchanging one element gives an overlap containing a lower Boolean interval
of size eight and an upper interval of size `2^(k-5)`. The graph of exchanges
is connected, by strict descent of the symmetric difference.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.BooleanCoreCover

open GenericRigidity BooleanIntervals

variable {V : Type*} [Fintype V] [DecidableEq V]

abbrev Block (V : Type*) (q : ℕ) := {A : Finset V // A.card = q}

def Adjacent {q : ℕ} (A B : Block V q) : Prop := (A.val ∩ B.val).card + 1 = q

theorem same_size_paths {q : ℕ} (A B : Block V q) :
    Relation.ReflTransGen Adjacent A B := by
  classical
  suffices h : ∀ d, ∀ A : Block V q, (A.val \ B.val).card = d →
      Relation.ReflTransGen Adjacent A B from h _ A rfl
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro A hd
    by_cases hAB : A = B
    · subst A
      exact .refl
    have hnot : ¬A.val ⊆ B.val := by
      intro h
      exact hAB (Subtype.ext (Finset.eq_of_subset_of_card_le h (by rw [A.property,B.property])))
    have hnot' : ¬B.val ⊆ A.val := by
      intro h
      exact hAB (Subtype.ext (Finset.eq_of_subset_of_card_le h
        (by rw [A.property,B.property])).symm)
    obtain ⟨a,ha⟩ := Finset.sdiff_nonempty.mpr hnot
    obtain ⟨b,hb⟩ := Finset.sdiff_nonempty.mpr hnot'
    have haA := (Finset.mem_sdiff.mp ha).1
    have hbB := (Finset.mem_sdiff.mp hb).1
    have hbA := (Finset.mem_sdiff.mp hb).2
    have hbErase : b ∉ A.val.erase a := fun h => hbA (Finset.mem_of_mem_erase h)
    have hCcard : (insert b (A.val.erase a)).card = q := by
      rw [Finset.card_insert_of_notMem hbErase]
      exact (Finset.card_erase_add_one haA).trans A.property
    let C : Block V q := ⟨insert b (A.val.erase a),hCcard⟩
    have hinter : A.val ∩ C.val = A.val.erase a := by
      ext x
      constructor
      · intro hx
        obtain ⟨hxA,hxC⟩ := Finset.mem_inter.mp hx
        rcases Finset.mem_insert.mp hxC with hxb | hx
        · subst x
          exact False.elim (hbA hxA)
        · exact hx
      · intro hx
        exact Finset.mem_inter.mpr ⟨Finset.mem_of_mem_erase hx,
          Finset.mem_insert_of_mem hx⟩
    have hAC : Adjacent A C := by
      unfold Adjacent
      rw [hinter]
      exact (Finset.card_erase_add_one haA).trans A.property
    have hdiff : C.val \ B.val = (A.val \ B.val).erase a := by
      change insert b (A.val.erase a) \ B.val = _
      rw [Finset.insert_sdiff_of_mem _ hbB,Finset.erase_sdiff_comm]
    have hlt : (C.val \ B.val).card < d := by
      rw [hdiff,←hd]
      exact Finset.card_erase_lt_of_mem ha
    exact (Relation.ReflTransGen.single hAC).trans (ih _ hlt C rfl)

/-- The literal lower-plus-upper interval core. -/
def core (A : Finset V) : Set (Finset V) := {s | s ⊆ A ∨ A ⊆ s}

theorem core_eq_intervalCore (A : Finset V) :
    core A = IntervalCore.core ∅ [A,Finset.univ] := by
  ext s
  constructor
  · rintro (hs | hs)
    · exact Or.inl ⟨Finset.empty_subset _,hs⟩
    · exact Or.inr (Or.inl ⟨hs,Finset.subset_univ _⟩)
  · rintro (hs | hs | hs)
    · exact Or.inl hs.2
    · exact Or.inr hs.1
    · have he : s = Finset.univ := hs
      rw [he]
      exact Or.inr (Finset.subset_univ _)

theorem core_cover (hV : 4 ≤ Fintype.card V) (s : Finset V) :
    ∃ A : Block V 4, s ∈ core A.val := by
  by_cases hs : 4 ≤ s.card
  · obtain ⟨A,hAs,hA⟩ := Finset.exists_subset_card_eq hs
    exact ⟨⟨A,hA⟩,Or.inr hAs⟩
  · obtain ⟨A,hsA,_,hA⟩ := Finset.exists_subsuperset_card_eq
      (Finset.subset_univ s) (by omega : s.card ≤ 4)
      (by simpa only [Finset.card_univ] using hV)
    exact ⟨⟨A,hA⟩,Or.inl hsA⟩

theorem adjacent_inter_card (A B : Block V 4) (h : Adjacent A B) :
    (A.val ∩ B.val).card = 3 := by
  unfold Adjacent at h
  omega

theorem adjacent_union_card (A B : Block V 4) (h : Adjacent A B) :
    (A.val ∪ B.val).card = 5 := by
  have ht := Finset.card_union_add_card_inter A.val B.val
  rw [A.property,B.property,adjacent_inter_card A B h] at ht
  omega

theorem overlap_lower_bound (A B : Block V 4) (hAB : Adjacent A B) :
    8 + 2 ^ (Fintype.card V - 5) ≤ Nat.card ↥(core A.val ∩ core B.val) := by
  classical
  let lower : Finset (Finset V) := Finset.Iic (A.val ∩ B.val)
  let upper : Finset (Finset V) := Finset.Icc (A.val ∪ B.val) Finset.univ
  have hdisj : Disjoint lower upper := by
    apply Finset.disjoint_left.mpr
    intro s hs ht
    have hs' : s ⊆ A.val ∩ B.val := Finset.mem_Iic.mp hs
    have ht' : A.val ∪ B.val ⊆ s := (Finset.mem_Icc.mp ht).1
    have hc := Finset.card_le_card (ht'.trans hs')
    rw [adjacent_union_card A B hAB,adjacent_inter_card A B hAB] at hc
    omega
  have hsub : lower ∪ upper ⊆ (core A.val ∩ core B.val).toFinset := by
    intro s hs
    apply Set.mem_toFinset.mpr
    rcases Finset.mem_union.mp hs with hl | hu
    · have h : s ⊆ A.val ∩ B.val := Finset.mem_Iic.mp hl
      exact ⟨Or.inl (h.trans Finset.inter_subset_left),
        Or.inl (h.trans Finset.inter_subset_right)⟩
    · have h : A.val ∪ B.val ⊆ s := (Finset.mem_Icc.mp hu).1
      exact ⟨Or.inr (Finset.subset_union_left.trans h),
        Or.inr (Finset.subset_union_right.trans h)⟩
  have hcard := Finset.card_le_card hsub
  rw [Finset.card_union_of_disjoint hdisj,Set.toFinset_card] at hcard
  have hl : lower.card = 8 := by
    simp only [lower,Finset.card_Iic_finset,adjacent_inter_card A B hAB]
    norm_num
  have hu : upper.card = 2 ^ (Fintype.card V - 5) := by
    rw [Finset.card_Icc_finset (Finset.subset_univ _),Finset.card_univ,
      adjacent_union_card A B hAB]
  simpa only [hl,hu,Nat.card_eq_fintype_card] using hcard

theorem overlap_numeric (k e : ℕ) (hk : 8 ≤ k) (he : e + 2 ≤ k) :
    k + e + 1 ≤ 8 + 2 ^ (k - 5) := by
  obtain ⟨t,rfl⟩ := Nat.exists_eq_add_of_le hk
  have hp : ∀ t : ℕ, 2 * t + 7 ≤ 2 ^ (t + 3) := by
    intro t
    induction t with
    | zero => norm_num
    | succ t ih =>
      rw [show t + 1 + 3 = (t+3)+1 by omega,pow_succ]
      nlinarith
  have h := hp t
  have hs : 8 + t - 5 = t + 3 := by omega
  rw [hs]
  omega

end PaperVerification.Segre.BooleanCoreCover

end SegreBooleanCoreCover

section SegreHigherExcessRank

/-!
# The full-slice algebraic conclusion in arbitrary excess

A rigid comparability graph gives a nonzero polynomial open on the complete
array of slice coefficients. On this open the slices are independent and the
entire degree-two multiplication kernel consists precisely of the ordinary
alternating Koszul relations. Independent slice and multiplication witnesses
are combined by multiplying their nonzero minor certificates.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.HigherExcessRank

open Staircase Monomials Degeneration GenericRigidity KoszulDimension Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

noncomputable def coefficientMatrix :
    Matrix (Cell n) D (MvPolynomial (Cell n × D) K) :=
  fun u d => MvPolynomial.X (u,d)

noncomputable def productMatrix :
    Matrix (SortedPair n) (D × Cell n) (MvPolynomial (Cell n × D) K) :=
  multiplicationMatrix 1 coefficientMatrix

theorem eval_coefficientMatrix (A : Matrix (Cell n) D K) :
    (coefficientMatrix (K := K) (n := n) (D := D)).map
      (MvPolynomial.eval (fun j => A j.1 j.2)) = A := by
  ext u d
  simp only [Matrix.map_apply,coefficientMatrix,MvPolynomial.eval_X]

theorem eval_productMatrix (A : Matrix (Cell n) D K) :
    (productMatrix (K := K) (n := n) (D := D)).map
      (MvPolynomial.eval (fun j => A j.1 j.2)) = multiplicationMatrix 1 A := by
  ext q dv
  simp only [Matrix.map_apply,productMatrix,multiplicationMatrix,coefficientMatrix,map_sum]
  apply Finset.sum_congr rfl
  intro u _
  split_ifs <;> simp

/-- A nonempty principal open of full slice arrays has independent slices,
the exact Koszul multiplication rank, and no additional degree-two syzygies.
The coordinate dimension `D` is arbitrary and no characteristic is excluded. -/
theorem exactness_certificate_of_rigid [Infinite K]
    (hG : GenericallyRigid K D (RankParameters.chainGraph n)) :
    ∃ f : MvPolynomial (Cell n × Option D) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option D) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective A.vecMul ∧
          (multiplicationMatrix 1 A).rank =
            Fintype.card (Cell n) * Fintype.card (Option D) -
              (Fintype.card (Option D)).choose 2 ∧
          LinearMap.ker (KoszulRank.multiplication A) = LinearMap.range (koszulMatrix A) := by
  classical
  obtain ⟨p,hp,hr⟩ := hG
  let r := Fintype.card (Cell n) * Fintype.card (Option D) -
    (Fintype.card (Option D)).choose 2
  have hz : r ≤ (multiplicationMatrix 0 (augmentedPlacement p)).rank := by
    simpa only [r,Fintype.card_option] using
      (RigidityMultiplication.rank_zero_of_rigid p hp hr).ge
  obtain ⟨A₀,hA₀⟩ := rank_transfer_from_zero (augmentedPlacement p) r hz
  have hM : r ≤ ((productMatrix (K := K) (n := n) (D := Option D)).map
      (MvPolynomial.eval (fun j => A₀ j.1 j.2))).rank := by
    rw [eval_productMatrix]
    exact hA₀
  obtain ⟨f,hf,hwf⟩ := GenericRank.minor_witness
    (productMatrix (K := K) (n := n) (D := Option D)) (fun j => A₀ j.1 j.2) r hM
  have hC : Fintype.card (Option D) ≤
      ((coefficientMatrix (K := K) (n := n) (D := Option D)).map
        (MvPolynomial.eval (fun j => augmentedPlacement p j.1 j.2))).rank := by
    rw [eval_coefficientMatrix]
    exact (Matrix.vecMul_surjective_iff_rank_eq_card.mp
      (augmented_surjective_of_affineSpan p hp)).ge
  obtain ⟨g,hg,hwg⟩ := GenericRank.minor_witness
    (coefficientMatrix (K := K) (n := n) (D := Option D))
    (fun j => augmentedPlacement p j.1 j.2) (Fintype.card (Option D)) hC
  refine ⟨f * g,mul_ne_zero hf hg,?_⟩
  intro A hA
  rw [map_mul,mul_ne_zero_iff] at hA
  have hprod := hwf (fun j => A j.1 j.2) hA.1
  have hcols := hwg (fun j => A j.1 j.2) hA.2
  rw [eval_productMatrix] at hprod
  rw [eval_coefficientMatrix] at hcols
  have hsurj : Function.Surjective A.vecMul :=
    Matrix.vecMul_surjective_iff_rank_eq_card.mpr
      (le_antisymm (Matrix.rank_le_card_width A) hcols)
  refine ⟨hsurj,le_antisymm (KoszulRank.rank_upper_bound A hsurj) hprod,?_⟩
  exact KoszulRank.kernel_eq_koszul_range_of_rank_bound A hsurj hprod

end PaperVerification.Segre.HigherExcessRank

end SegreHigherExcessRank

section SegreExcessSixOne

/-!
# The first full-range bound in Theorem 6.1

An induction on excess uses a four-element lower interval and an arbitrary
upper interval, glued along their common vertex. The family of such cores
is connected by single exchanges. This supplies the same `k ≥ 4e` bound as
the paper with a two-interval induction instead of simultaneous partitions.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ExcessSixOne

open GenericRigidity BooleanIntervals BooleanCoreCover
open Staircase RankParameters Comparability ChainInduction ExcessPropagation

variable {K : Type*} [Field K] [Infinite K]

universe u

theorem boolean_rigid_of_four_excess : ∀ e : ℕ, 1 ≤ e →
    ∀ (V : Type u) [Fintype V] [DecidableEq V],
      4 * e ≤ Fintype.card V →
      GenericallyRigid K (Fin (Fintype.card V + e)) (Comparability.graph (Finset V)) := by
  intro e
  induction e with
  | zero =>
    intro he
    omega
  | succ e ih =>
    intro he V instF instD hk
    classical
    by_cases he0 : e = 0
    · subst e
      exact full_boolean_rigid (by simpa using hk)
    have he1 : 1 ≤ e := by omega
    have hk8 : 8 ≤ Fintype.card V := by omega
    let G := Comparability.graph (Finset V)
    have hcores (A : Block V 4) :
        GenericallyRigid K (Fin (Fintype.card V + (e+1))) (G.induce (core A.val)) := by
      let W := ↥(Finset.univ \ A.val)
      have hc : Fintype.card W = Fintype.card V - 4 := by
        rw [Fintype.card_coe,Finset.card_sdiff_of_subset (Finset.subset_univ _),
          Finset.card_univ,A.property]
      have hupper := ih he1 W (by rw [hc]; omega)
      have hr : GenericallyRigid K (Fin (Fintype.card V - 4 + e))
          (G.induce (Set.Icc A.val Finset.univ)) := by
        rw [hc] at hupper
        apply ThreeChainCores.rigid_of_le_comap_equiv _ _
          (intervalEquiv A.val Finset.univ (Finset.subset_univ _)) _ hupper
        intro s t h
        change (intervalEquiv A.val Finset.univ (Finset.subset_univ _) s).val ≠
            (intervalEquiv A.val Finset.univ (Finset.subset_univ _) t).val ∧
          ((intervalEquiv A.val Finset.univ (Finset.subset_univ _) s).val ⊆
              (intervalEquiv A.val Finset.univ (Finset.subset_univ _) t).val ∨
            (intervalEquiv A.val Finset.univ (Finset.subset_univ _) t).val ⊆
              (intervalEquiv A.val Finset.univ (Finset.subset_univ _) s).val)
        refine ⟨fun heq => h.1 ((intervalEquiv A.val Finset.univ
          (Finset.subset_univ _)).injective (Subtype.ext heq)),?_⟩
        rw [intervalEquiv_subset_iff,intervalEquiv_subset_iff]
        exact h.2
      have hleft : GenericallyRigid K (Fin 5) (G.induce (Set.Icc ∅ A.val)) := by
        have h := interval_rigid (K := K) ∅ A.val (Finset.empty_subset _) (by
          simpa only [Finset.card_empty,Nat.sub_zero,A.property] using (le_refl 4))
        have hdim : Fintype.card (Fin (A.val.card - (∅ : Finset V).card + 1)) = 5 := by
          rw [Fintype.card_fin, Finset.card_empty, Nat.sub_zero, A.property]
        exact genericallyRigid_fin
          (I := Fin (A.val.card - (∅ : Finset V).card + 1)) _ 5 hdim h
      have htailset : IntervalCore.core A.val [Finset.univ] = Set.Icc A.val Finset.univ := by
        ext s
        constructor
        · rintro (hs | hs)
          · exact hs
          · have heq : s = Finset.univ := hs
            rw [heq]
            exact ⟨Finset.subset_univ _,le_rfl⟩
        · exact Or.inl
      have htail : GenericallyRigid K (Fin (Fintype.card V - 4 + e))
          (G.induce (IntervalCore.core A.val [Finset.univ])) := by
        rwa [htailset]
      have hnest : IntervalCore.nested A.val [Finset.univ] := ⟨Finset.subset_univ _,True.intro⟩
      have hj := AmalgamatedJoin.genericallyRigid_amalgamated _ _
        (⟨A.val,Finset.empty_subset _,le_rfl⟩ : ↥(Set.Icc ∅ A.val))
        (IntervalCore.tailBase A.val [Finset.univ] hnest) hleft htail
      have hs := ThreeChainCores.rigid_of_le_comap_equiv _ _
        (IntervalCore.stepEquiv ∅ A.val [Finset.univ] (Finset.empty_subset _) hnest)
        (IntervalCore.step_graph_le ∅ A.val [Finset.univ] (Finset.empty_subset _) hnest) hj
      rw [core_eq_intervalCore]
      apply genericallyRigid_fin _ _ ?_ hs
      simp only [Fintype.card_sum,Fintype.card_fin]
      omega
    obtain ⟨A₀,_,hA₀⟩ := Finset.exists_subset_card_eq
      (s := (Finset.univ : Finset V)) (n := 4) (by
        simpa only [Finset.card_univ] using (by omega : 4 ≤ Fintype.card V))
    apply genericallyRigid_connected_cover G (fun A : Block V 4 => core A.val)
      ⟨A₀,hA₀⟩ Adjacent (core_cover (by omega)) hcores
    · intro A B hAB
      simp only [Fintype.card_fin]
      exact (overlap_numeric (Fintype.card V) (e+1) hk8 (by omega)).trans
        (overlap_lower_bound A B hAB)
    · intro A
      exact same_size_paths _ A

theorem many_factor_boolean_surplus (k e : ℕ) (he : 1 ≤ e) (hk : 4*e ≤ k) :
    e + k ≤ 2 ^ (k - 1) := by
  have hk4 : 4 ≤ k := by omega
  obtain ⟨t,rfl⟩ := Nat.exists_eq_add_of_le hk4
  have hp : ∀ t : ℕ, 2 * (4+t) ≤ 2 ^ (t+3) := by
    intro t
    induction t with
    | zero => norm_num
    | succ t ih =>
      rw [show t+1+3 = (t+3)+1 by omega,pow_succ]
      nlinarith
  have h := hp t
  rw [show 4+t-1 = t+3 by omega]
  omega

/-- Every positive tuple in the complete first range of Theorem 6.1. -/
theorem section_6_1_first_graph_rigidity (k e : ℕ) (he : 1 ≤ e) (hk : 4*e ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  have hb := boolean_rigid_of_four_excess (K := K) e he (Fin k) (by simpa using hk)
  have hcell := BooleanBase.genericallyRigid_comap_equiv
    (Comparability.graph (Finset (Fin k))) (booleanCellEquiv (V := Fin k)) hb
  rw [booleanCell_graph] at hcell
  have hbase : GenericallyRigid K (Fin (sideSum (fun _ : Fin k => 1) + e))
      (chainGraph (fun _ : Fin k => 1)) := by
    apply genericallyRigid_fin _ _ ?_ hcell
    simp [sideSum]
  exact propagate_many_factors (fun _ : Fin k => 1) n e (fun _ => le_rfl)
    hpos (by simpa only [Fintype.card_fin] using many_factor_boolean_surplus k e he hk) hbase

/-- The full-slice multiplication kernel is exactly the Koszul subspace on
a nonempty polynomial open, throughout `k ≥ 4e`. -/
theorem section_6_1_first_exactness_certificate (k e : ℕ) (he : 1 ≤ e) (hk : 4*e ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    ∃ f : MvPolynomial (Cell n × Option (Fin (sideSum n + e))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Fin (sideSum n + e))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective A.vecMul ∧
          (Degeneration.multiplicationMatrix 1 A).rank =
            Fintype.card (Cell n) * (sideSum n + e + 1) - (sideSum n + e + 1).choose 2 ∧
          LinearMap.ker (KoszulRank.multiplication A) =
            LinearMap.range (KoszulDimension.koszulMatrix A) := by
  have h := HigherExcessRank.exactness_certificate_of_rigid
    (section_6_1_first_graph_rigidity (K := K) k e he hk n hpos)
  simpa only [Fintype.card_option,Fintype.card_fin] using h

end PaperVerification.Segre.ExcessSixOne

end SegreExcessSixOne

section SegreTripartiteGraph

/-!
# The complete tripartite rigidity theorem as a graph statement

The proof uses the actual all-characteristic infinitesimal-motion theorem of
Lemma 6.2, with separate affine-spanning placements in the three parts.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.TripartiteGraph

open GenericRigidity Matrix
open scoped Matrix

variable {K I A B C : Type*} [Field K] [Fintype I] [DecidableEq I]

def graph (A B C : Type*) : SimpleGraph (A ⊕ (B ⊕ C)) where
  Adj
    | .inl _, .inl _ => False
    | .inr (.inl _), .inr (.inl _) => False
    | .inr (.inr _), .inr (.inr _) => False
    | _, _ => True
  symm.symm := by
    intro x y
    cases x with
    | inl x => cases y <;> simp_all
    | inr x =>
      cases x <;> cases y with
      | inl y => simp_all
      | inr y => cases y <;> simp_all
  loopless.irrefl := by
    intro x
    cases x with
    | inl x => intro h; exact h
    | inr x => cases x <;> intro h <;> exact h

def position (pA : Matrix A I K) (pB : Matrix B I K) (pC : Matrix C I K) :
    Matrix (A ⊕ (B ⊕ C)) I K := Sum.elim pA (Sum.elim pB pC)

theorem rigid_position [Fintype A] [Fintype B] [Fintype C]
    (pA : Matrix A I K) (pB : Matrix B I K) (pC : Matrix C I K)
    (hA : affineSpan K (Set.range pA) = ⊤)
    (hB : affineSpan K (Set.range pB) = ⊤)
    (hC : affineSpan K (Set.range pC) = ⊤) :
    InfinitesimallyRigidOn (graph A B C) (position pA pB pC) Set.univ := by
  intro u hu
  obtain ⟨M,t,hMt,hMd,hmA,hmB,hmC⟩ := complete_tripartite_infinitesimal_rigidity
    pA (fun a => u (.inl a)) pB (fun b => u (.inr (.inl b)))
    pC (fun c => u (.inr (.inr c))) hA hB hC
    (fun a b => hu (.inl a) (Set.mem_univ _) (.inr (.inl b)) (Set.mem_univ _) (by trivial))
    (fun a c => hu (.inl a) (Set.mem_univ _) (.inr (.inr c)) (Set.mem_univ _) (by trivial))
    (fun b c => hu (.inr (.inl b)) (Set.mem_univ _) (.inr (.inr c)) (Set.mem_univ _) (by trivial))
  refine ⟨M,t,hMt,hMd,?_⟩
  intro v _
  cases v with
  | inl a => exact hmA a
  | inr v =>
    cases v with
    | inl b => exact hmB b
    | inr c => exact hmC c

theorem genericallyRigid [Fintype A] [Fintype B] [Fintype C]
    (hA : Fintype.card I + 1 ≤ Fintype.card A)
    (hB : Fintype.card I + 1 ≤ Fintype.card B)
    (hC : Fintype.card I + 1 ≤ Fintype.card C) :
    GenericallyRigid K I (graph A B C) := by
  obtain ⟨pA,hpA⟩ := exists_affineSpan_of_card (K := K) hA
  obtain ⟨pB,hpB⟩ := exists_affineSpan_of_card (K := K) hB
  obtain ⟨pC,hpC⟩ := exists_affineSpan_of_card (K := K) hC
  refine ⟨position pA pB pC,?_,rigid_position pA pB pC hpA hpB hpC⟩
  apply top_unique
  rw [←hpA]
  apply affineSpan_mono K
  rintro x ⟨a,rfl⟩
  exact ⟨.inl a,rfl⟩

end PaperVerification.Segre.TripartiteGraph

end SegreTripartiteGraph

section SegreFlagPaths

/-!
# Connected three-block flags

Flags `A ⊆ B`, with `|A|=b` and `|B|=2b`, are connected by exchanging
one element of one set while holding the other set fixed. The proof first
chooses a common upper set containing both lower sets and then uses three
paths of fixed-size subsets between fixed lower and upper bounds.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.FlagPaths

open BooleanCoreCover

variable {V : Type*} [Fintype V] [DecidableEq V]

abbrev BoundedBlock (L U : Finset V) (q : ℕ) :=
  {A : Finset V // L ⊆ A ∧ A ⊆ U ∧ A.card = q}

def BoundedAdjacent {L U : Finset V} {q : ℕ} (A B : BoundedBlock L U q) : Prop :=
  (A.val ∩ B.val).card + 1 = q

theorem bounded_paths {L U : Finset V} {q : ℕ} (A B : BoundedBlock L U q) :
    Relation.ReflTransGen BoundedAdjacent A B := by
  classical
  suffices h : ∀ d, ∀ A : BoundedBlock L U q, (A.val \ B.val).card = d →
      Relation.ReflTransGen BoundedAdjacent A B from h _ A rfl
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro A hd
    by_cases hAB : A = B
    · subst A
      exact .refl
    have hnot : ¬A.val ⊆ B.val := by
      intro h
      exact hAB (Subtype.ext (Finset.eq_of_subset_of_card_le h
        (by rw [A.property.2.2,B.property.2.2])))
    have hnot' : ¬B.val ⊆ A.val := by
      intro h
      exact hAB (Subtype.ext (Finset.eq_of_subset_of_card_le h
        (by rw [A.property.2.2,B.property.2.2])).symm)
    obtain ⟨a,ha⟩ := Finset.sdiff_nonempty.mpr hnot
    obtain ⟨b,hb⟩ := Finset.sdiff_nonempty.mpr hnot'
    have haA := (Finset.mem_sdiff.mp ha).1
    have haB := (Finset.mem_sdiff.mp ha).2
    have hbB := (Finset.mem_sdiff.mp hb).1
    have hbA := (Finset.mem_sdiff.mp hb).2
    have hbErase : b ∉ A.val.erase a := fun h => hbA (Finset.mem_of_mem_erase h)
    have hCcard : (insert b (A.val.erase a)).card = q := by
      rw [Finset.card_insert_of_notMem hbErase]
      exact (Finset.card_erase_add_one haA).trans A.property.2.2
    have hLC : L ⊆ insert b (A.val.erase a) := by
      intro x hx
      apply Finset.mem_insert_of_mem
      exact Finset.mem_erase.mpr ⟨fun h => haB (h ▸ B.property.1 hx),A.property.1 hx⟩
    have hCU : insert b (A.val.erase a) ⊆ U := by
      intro x hx
      rcases Finset.mem_insert.mp hx with hxb | hx
      · subst x
        exact B.property.2.1 hbB
      · exact A.property.2.1 (Finset.mem_of_mem_erase hx)
    let C : BoundedBlock L U q := ⟨insert b (A.val.erase a),hLC,hCU,hCcard⟩
    have hinter : A.val ∩ C.val = A.val.erase a := by
      ext x
      constructor
      · intro hx
        obtain ⟨hxA,hxC⟩ := Finset.mem_inter.mp hx
        rcases Finset.mem_insert.mp hxC with hxb | hx
        · subst x
          exact False.elim (hbA hxA)
        · exact hx
      · intro hx
        exact Finset.mem_inter.mpr ⟨Finset.mem_of_mem_erase hx,
          Finset.mem_insert_of_mem hx⟩
    have hAC : BoundedAdjacent A C := by
      unfold BoundedAdjacent
      rw [hinter]
      exact (Finset.card_erase_add_one haA).trans A.property.2.2
    have hdiff : C.val \ B.val = (A.val \ B.val).erase a := by
      change insert b (A.val.erase a) \ B.val = _
      rw [Finset.insert_sdiff_of_mem _ hbB,Finset.erase_sdiff_comm]
    have hlt : (C.val \ B.val).card < d := by
      rw [hdiff,←hd]
      exact Finset.card_erase_lt_of_mem ha
    exact (Relation.ReflTransGen.single hAC).trans (ih _ hlt C rfl)

abbrev Flag (V : Type*) [DecidableEq V] (b : ℕ) :=
  {p : Finset V × Finset V // p.1 ⊆ p.2 ∧ p.1.card = b ∧ p.2.card = 2*b}

abbrev lower {b : ℕ} (F : Flag V b) : Finset V := F.val.1
abbrev upper {b : ℕ} (F : Flag V b) : Finset V := F.val.2

def Adjacent {b : ℕ} (F G : Flag V b) : Prop :=
  (upper F = upper G ∧ (lower F ∩ lower G).card + 1 = b) ∨
  (lower F = lower G ∧ (upper F ∩ upper G).card + 1 = 2*b)

theorem fixed_upper_path {b : ℕ} (F G : Flag V b) (h : upper F = upper G) :
    Relation.ReflTransGen Adjacent F G := by
  classical
  let B := upper F
  let f : BoundedBlock (∅ : Finset V) B b → Flag V b := fun A =>
    ⟨(A.val,B),A.property.2.1,A.property.2.2,F.property.2.2⟩
  let A₁ : BoundedBlock (∅ : Finset V) B b :=
    ⟨lower F,Finset.empty_subset _,F.property.1,F.property.2.1⟩
  let A₂ : BoundedBlock (∅ : Finset V) B b :=
    ⟨lower G,Finset.empty_subset _,by simpa only [B,h] using G.property.1,G.property.2.1⟩
  have hm : ∀ A C, BoundedAdjacent A C → Adjacent (f A) (f C) := by
    intro A C hAC
    exact Or.inl ⟨rfl,hAC⟩
  have hp := Relation.ReflTransGen.lift f hm A₁ A₂ (bounded_paths A₁ A₂)
  have h₁ : f A₁ = F := Subtype.ext (Prod.ext rfl rfl)
  have h₂ : f A₂ = G := Subtype.ext (Prod.ext rfl h)
  change Relation.ReflTransGen Adjacent (f A₁) (f A₂) at hp
  simpa only [h₁,h₂] using hp

theorem fixed_lower_path {b : ℕ} (F G : Flag V b) (h : lower F = lower G) :
    Relation.ReflTransGen Adjacent F G := by
  classical
  let A := lower F
  let f : BoundedBlock A (Finset.univ : Finset V) (2*b) → Flag V b := fun B =>
    ⟨(A,B.val),B.property.1,F.property.2.1,B.property.2.2⟩
  let B₁ : BoundedBlock A (Finset.univ : Finset V) (2*b) :=
    ⟨upper F,F.property.1,Finset.subset_univ _,F.property.2.2⟩
  let B₂ : BoundedBlock A (Finset.univ : Finset V) (2*b) :=
    ⟨upper G,by simpa only [A,h] using G.property.1,Finset.subset_univ _,G.property.2.2⟩
  have hm : ∀ B C, BoundedAdjacent B C → Adjacent (f B) (f C) := by
    intro B C hBC
    exact Or.inr ⟨rfl,hBC⟩
  have hp := Relation.ReflTransGen.lift f hm B₁ B₂ (bounded_paths B₁ B₂)
  have h₁ : f B₁ = F := Subtype.ext (Prod.ext rfl rfl)
  have h₂ : f B₂ = G := Subtype.ext (Prod.ext h rfl)
  change Relation.ReflTransGen Adjacent (f B₁) (f B₂) at hp
  simpa only [h₁,h₂] using hp

theorem flag_paths {b : ℕ} (hk : 2*b ≤ Fintype.card V) (F G : Flag V b) :
    Relation.ReflTransGen Adjacent F G := by
  classical
  have hs : (lower F ∪ lower G).card ≤ 2*b := by
    have h := Finset.card_union_le (lower F) (lower G)
    have hF : (lower F).card = b := F.property.2.1
    have hG : (lower G).card = b := G.property.2.1
    rw [hF,hG] at h
    omega
  obtain ⟨B,hsub,_,hB⟩ := Finset.exists_subsuperset_card_eq
    (Finset.subset_univ (lower F ∪ lower G)) hs
    (by simpa only [Finset.card_univ] using hk)
  let F' : Flag V b :=
    ⟨(lower F,B),Finset.subset_union_left.trans hsub,F.property.2.1,hB⟩
  let G' : Flag V b :=
    ⟨(lower G,B),Finset.subset_union_right.trans hsub,G.property.2.1,hB⟩
  exact (fixed_lower_path F F' rfl).trans
    ((fixed_upper_path F' G' rfl).trans (fixed_lower_path G' G rfl))

end PaperVerification.Segre.FlagPaths

end SegreFlagPaths

section SegreThreeBlockCore

/-!
# The proper three-block core

For a flag `A ⊆ B` with block sizes `b,b,b`, the three open intervals
`(∅,A)`, `(A,B)`, `(B,univ)` form a complete tripartite subgraph. The two
prefixes `A,B` are genuine universal vertices. Thus Lemma 6.2, followed by
two cones, proves rigidity of the induced core in the exact dimension
`3*b + e - 2` whenever `e ≤ 2^b - 3*b + 1`.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ThreeBlockCore

open GenericRigidity BooleanStars FlagPaths

variable {K V : Type*} [Field K] [Fintype V] [DecidableEq V]
variable {b : ℕ} (F : Flag V b)

def core : Set (ProperSet V) :=
  {s | s.val ⊆ lower F ∨ (lower F ⊆ s.val ∧ s.val ⊆ upper F) ∨ upper F ⊆ s.val}

abbrev Low := ↥(Set.Ioo (∅ : Finset V) (lower F))
abbrev Middle := ↥(Set.Ioo (lower F) (upper F))
abbrev High := ↥(Set.Ioo (upper F) (Finset.univ : Finset V))
abbrev Interior := Low F ⊕ (Middle F ⊕ High F)
abbrev Vertices := Option (Option (Interior F))

def vertexVal : Vertices F → Finset V
  | none => lower F
  | some none => upper F
  | some (some (.inl x)) => x.val
  | some (some (.inr (.inl x))) => x.val
  | some (some (.inr (.inr x))) => x.val

theorem low_card (x : Low F) : 0 < x.val.card ∧ x.val.card < b := by
  have h₀ := Finset.card_lt_card x.property.1
  have h₁ := Finset.card_lt_card x.property.2
  simpa only [Finset.card_empty, F.property.2.1] using And.intro h₀ h₁

theorem middle_card (x : Middle F) : b < x.val.card ∧ x.val.card < 2*b := by
  have h₀ := Finset.card_lt_card x.property.1
  have h₁ := Finset.card_lt_card x.property.2
  simpa only [F.property.2.1, F.property.2.2] using And.intro h₀ h₁

theorem high_card (hk : Fintype.card V = 3*b) (x : High F) :
    2*b < x.val.card ∧ x.val.card < 3*b := by
  have h₀ := Finset.card_lt_card x.property.1
  have h₁ := Finset.card_lt_card x.property.2
  simpa only [F.property.2.2, Finset.card_univ, hk] using And.intro h₀ h₁

theorem vertexVal_injective (hb : 0 < b) (hk : Fintype.card V = 3*b) :
    Function.Injective (vertexVal F) := by
  intro x y h
  have hA : (lower F).card = b := F.property.2.1
  have hB : (upper F).card = 2*b := F.property.2.2
  rcases x with _ | (_ | (x | (x | x))) <;>
    rcases y with _ | (_ | (y | (y | y)))
  all_goals dsimp only [vertexVal] at h
  all_goals try rfl
  all_goals try {
    simp only [Option.some.injEq, Sum.inl.injEq, Sum.inr.injEq]
    exact Subtype.ext h }
  all_goals have hc := congrArg Finset.card h
  all_goals try have hx := low_card F x
  all_goals try have hx := middle_card F x
  all_goals try have hx := high_card F hk x
  all_goals try have hy := low_card F y
  all_goals try have hy := middle_card F y
  all_goals try have hy := high_card F hk y
  all_goals try dsimp only [lower, upper] at *
  all_goals omega

theorem vertexVal_proper (hb : 0 < b) (hk : Fintype.card V = 3*b)
    (x : Vertices F) : (vertexVal F x).Nonempty ∧ vertexVal F x ≠ Finset.univ := by
  have hA : (lower F).card = b := F.property.2.1
  have hB : (upper F).card = 2*b := F.property.2.2
  have hcard : 0 < (vertexVal F x).card ∧ (vertexVal F x).card < Fintype.card V := by
    rcases x with _ | (_ | (x | (x | x)))
    · dsimp only [vertexVal]
      omega
    · dsimp only [vertexVal]
      omega
    · have h := low_card F x
      dsimp only [vertexVal]
      omega
    · have h := middle_card F x
      dsimp only [vertexVal]
      omega
    · have h := high_card F hk x
      dsimp only [vertexVal]
      omega
  refine ⟨Finset.card_pos.mp hcard.1,?_⟩
  intro h
  rw [h,Finset.card_univ] at hcard
  omega

theorem vertexVal_mem_core (hb : 0 < b) (hk : Fintype.card V = 3*b)
    (x : Vertices F) :
    (⟨vertexVal F x,vertexVal_proper F hb hk x⟩ : ProperSet V) ∈ core F := by
  rcases x with _ | (_ | (x | (x | x)))
  · exact Or.inl Finset.Subset.rfl
  · exact Or.inr (Or.inr Finset.Subset.rfl)
  · exact Or.inl (le_of_lt x.property.2)
  · exact Or.inr (Or.inl ⟨le_of_lt x.property.1,le_of_lt x.property.2⟩)
  · exact Or.inr (Or.inr (le_of_lt x.property.1))

noncomputable def vertexEquiv (hb : 0 < b) (hk : Fintype.card V = 3*b) :
    Vertices F ≃ ↥(core F) := Equiv.ofBijective
  (fun x => ⟨⟨vertexVal F x,vertexVal_proper F hb hk x⟩,
    vertexVal_mem_core F hb hk x⟩) (by
    constructor
    · intro x y h
      exact vertexVal_injective F hb hk (congrArg (fun z => z.val.val) h)
    · intro s
      by_cases hA : s.val.val = lower F
      · refine ⟨none,?_⟩
        exact Subtype.ext (Subtype.ext hA.symm)
      by_cases hB : s.val.val = upper F
      · refine ⟨some none,?_⟩
        exact Subtype.ext (Subtype.ext hB.symm)
      rcases s.property with h | h | h
      · let x : Low F := ⟨s.val.val,
          Finset.empty_ssubset.mpr s.val.property.1,lt_of_le_of_ne h hA⟩
        exact ⟨some (some (.inl x)),rfl⟩
      · let x : Middle F := ⟨s.val.val,
          lt_of_le_of_ne h.1 (fun he => hA he.symm),lt_of_le_of_ne h.2 hB⟩
        exact ⟨some (some (.inr (.inl x))),rfl⟩
      · let x : High F := ⟨s.val.val,
          lt_of_le_of_ne h (fun he => hB he.symm),
          lt_of_le_of_ne (Finset.subset_univ _) s.val.property.2⟩
        exact ⟨some (some (.inr (.inr x))),rfl⟩)

theorem vertex_graph_le (hb : 0 < b) (hk : Fintype.card V = 3*b) :
    coneGraph (coneGraph (TripartiteGraph.graph (Low F) (Middle F) (High F))) ≤
      ((BooleanStars.properGraph V).induce (core F)).comap (vertexEquiv F hb hk) := by
  intro x y h
  have hne : x ≠ y := (SimpleGraph.ne_of_adj _ h)
  change (vertexEquiv F hb hk x).val ≠ (vertexEquiv F hb hk y).val ∧ _
  refine ⟨fun he => hne ((vertexEquiv F hb hk).injective (Subtype.ext he)),?_⟩
  change vertexVal F x ⊆ vertexVal F y ∨ vertexVal F y ⊆ vertexVal F x
  rcases x with _ | (_ | (x | (x | x))) <;>
    rcases y with _ | (_ | (y | (y | y)))
  all_goals dsimp only [vertexVal]
  all_goals try exact False.elim h
  all_goals first
    | exact Or.inl F.property.1
    | exact Or.inr F.property.1
    | exact Or.inl (le_of_lt x.property.1)
    | exact Or.inr (le_of_lt y.property.1)
    | exact Or.inl (le_of_lt x.property.2)
    | exact Or.inr (le_of_lt y.property.2)
    | exact Or.inl (le_of_lt y.property.1)
    | exact Or.inr (le_of_lt x.property.1)
    | exact Or.inl (le_of_lt y.property.2)
    | exact Or.inr (le_of_lt x.property.2)
    | exact Or.inl ((le_of_lt x.property.2).trans F.property.1)
    | exact Or.inr ((le_of_lt y.property.2).trans F.property.1)
    | exact Or.inl (F.property.1.trans (le_of_lt y.property.1))
    | exact Or.inr (F.property.1.trans (le_of_lt x.property.1))
    | exact Or.inl ((le_of_lt x.property.2).trans (le_of_lt y.property.1))
    | exact Or.inr ((le_of_lt y.property.2).trans (le_of_lt x.property.1))
    | exact Or.inl ((le_of_lt x.property.2).trans
        (F.property.1.trans (le_of_lt y.property.1)))
    | exact Or.inr ((le_of_lt y.property.2).trans
        (F.property.1.trans (le_of_lt x.property.1)))

theorem card_low : Fintype.card (Low F) = 2^b - 2 := by
  classical
  rw [Fintype.card_Ioo,Finset.card_Ioo_finset (Finset.empty_subset _)]
  simp only [Finset.card_empty,Nat.sub_zero,F.property.2.1]

theorem card_middle : Fintype.card (Middle F) = 2^b - 2 := by
  classical
  rw [Fintype.card_Ioo,Finset.card_Ioo_finset F.property.1]
  have h : (upper F).card - (lower F).card = b := by
    rw [F.property.2.1,F.property.2.2]
    omega
  rw [h]

theorem card_high (hk : Fintype.card V = 3*b) : Fintype.card (High F) = 2^b - 2 := by
  classical
  rw [Fintype.card_Ioo,Finset.card_Ioo_finset (Finset.subset_univ _)]
  have h : (Finset.univ : Finset V).card - (upper F).card = b := by
    rw [Finset.card_univ,hk,F.property.2.2]
    omega
  rw [h]

theorem rigid (hb : 4 ≤ b) (hk : Fintype.card V = 3*b) (e : ℕ)
    (he : 1 ≤ e) (hbound : 3*b + e - 1 ≤ 2^b) :
    GenericallyRigid K (Fin (3*b + e - 2))
      ((BooleanStars.properGraph V).induce (core F)) := by
  classical
  let r := 3*b + e - 4
  have hr : r + 1 ≤ 2^b - 2 := by dsimp [r]; omega
  have htri : GenericallyRigid K (Fin r)
      (TripartiteGraph.graph (Low F) (Middle F) (High F)) := by
    apply TripartiteGraph.genericallyRigid
    · simpa only [Fintype.card_fin,card_low] using hr
    · simpa only [Fintype.card_fin,card_middle] using hr
    · simpa only [Fintype.card_fin,card_high F hk] using hr
  have hcone := genericallyRigid_cone _ (genericallyRigid_cone _ htri)
  have hcore := ThreeChainCores.rigid_of_le_comap_equiv _ _
    (vertexEquiv F (by omega) hk) (vertex_graph_le F (by omega) hk) hcone
  apply genericallyRigid_fin _ (3*b + e - 2) _ hcore
  simp only [Fintype.card_option,Fintype.card_fin]
  dsimp [r]
  omega

end PaperVerification.Segre.ThreeBlockCore

end SegreThreeBlockCore

section SegreThreeBlockCover

/-!
# Coverage and overlap of the literal three-block cores

The cores cover all proper nonempty subsets. For either permitted flag
exchange the intersection contains at least `2^b` actual vertices, which
already suffices for the sharp three-block excess bound.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ThreeBlockCover

open GenericRigidity BooleanStars FlagPaths ThreeBlockCore

variable {K V : Type*} [Field K] [Fintype V] [DecidableEq V]
variable {b : ℕ}

theorem core_cover (hk : 2*b ≤ Fintype.card V) (s : ProperSet V) :
    ∃ F : Flag V b, s ∈ core F := by
  classical
  by_cases hs : s.val.card ≤ b
  · obtain ⟨A,hsA,hAU,hA⟩ := Finset.exists_subsuperset_card_eq
      (Finset.subset_univ s.val) hs (by simpa only [Finset.card_univ] using
        (show b ≤ Fintype.card V by omega))
    obtain ⟨B,hAB,_,hB⟩ := Finset.exists_subsuperset_card_eq hAU
      (show A.card ≤ 2*b by omega) (by simpa only [Finset.card_univ] using hk)
    exact ⟨⟨(A,B),hAB,hA,hB⟩,Or.inl hsA⟩
  by_cases hs' : s.val.card ≤ 2*b
  · obtain ⟨A,hAs,hA⟩ := Finset.exists_subset_card_eq (show b ≤ s.val.card by omega)
    obtain ⟨B,hsB,_,hB⟩ := Finset.exists_subsuperset_card_eq
      (Finset.subset_univ s.val) hs' (by simpa only [Finset.card_univ] using hk)
    exact ⟨⟨(A,B),hAs.trans hsB,hA,hB⟩,Or.inr (Or.inl ⟨hAs,hsB⟩)⟩
  · obtain ⟨B,hBs,hB⟩ := Finset.exists_subset_card_eq
      (show 2*b ≤ s.val.card by omega)
    obtain ⟨A,hAB,hA⟩ := Finset.exists_subset_card_eq (show b ≤ B.card by omega)
    exact ⟨⟨(A,B),hAB,hA,hB⟩,Or.inr (Or.inr hBs)⟩

theorem flag_nonempty (hk : 2*b ≤ Fintype.card V) : Nonempty (Flag V b) := by
  classical
  obtain ⟨B,_,hB⟩ := Finset.exists_subset_card_eq
    (show 2*b ≤ (Finset.univ : Finset V).card by simpa only [Finset.card_univ] using hk)
  obtain ⟨A,hAB,hA⟩ := Finset.exists_subset_card_eq (show b ≤ B.card by omega)
  exact ⟨⟨(A,B),hAB,hA,hB⟩⟩

theorem overlap_fixed_upper (hb : 4 ≤ b) (hk : Fintype.card V = 3*b)
    (F G : Flag V b) (hB : upper F = upper G)
    (hA : (lower F ∩ lower G).card + 1 = b) :
    2^b ≤ Nat.card ↥(core F ∩ core G) := by
  classical
  obtain ⟨a,ha⟩ := Finset.card_pos.mp
    (show 0 < (lower F ∩ lower G).card by omega)
  have haF : a ∈ lower F := (Finset.mem_inter.mp ha).1
  have haG : a ∈ lower G := (Finset.mem_inter.mp ha).2
  let z : ProperSet V := ⟨{a},Finset.singleton_nonempty _,by
    intro h
    have hc := congrArg Finset.card h
    simp only [Finset.card_singleton,Finset.card_univ,hk] at hc
    omega⟩
  let T := ↥(Set.Ico (upper F) (Finset.univ : Finset V))
  have ht (t : T) : t.val.Nonempty ∧ t.val ≠ Finset.univ := by
    refine ⟨?_,ne_of_lt t.property.2⟩
    apply Finset.card_pos.mp
    have h := Finset.card_le_card t.property.1
    have hF : (upper F).card = 2*b := F.property.2.2
    omega
  let f : Option T → ↥(core F ∩ core G) := fun o => match o with
    | none => ⟨z,Or.inl (Finset.singleton_subset_iff.mpr haF),
        Or.inl (Finset.singleton_subset_iff.mpr haG)⟩
    | some t => ⟨⟨t.val,ht t⟩,Or.inr (Or.inr t.property.1),
        Or.inr (Or.inr (by simpa only [←hB] using t.property.1))⟩
  have hf : Function.Injective f := by
    intro s t h
    have hv := congrArg (fun x => x.val.val) h
    cases s with
    | none =>
      cases t with
      | none => rfl
      | some t =>
        have hc := congrArg Finset.card hv
        have hle := Finset.card_le_card t.property.1
        have hF : (upper F).card = 2*b := F.property.2.2
        change ({a} : Finset V).card = t.val.card at hc
        simp only [Finset.card_singleton] at hc
        omega
    | some s =>
      cases t with
      | none =>
        have hc := congrArg Finset.card hv
        have hle := Finset.card_le_card s.property.1
        have hF : (upper F).card = 2*b := F.property.2.2
        change s.val.card = ({a} : Finset V).card at hc
        simp only [Finset.card_singleton] at hc
        omega
      | some t => exact congrArg some (Subtype.ext hv)
  have hcard := Fintype.card_le_of_injective f hf
  have hT : Fintype.card T = 2^b - 1 := by
    dsimp [T]
    rw [Fintype.card_Ico,Finset.card_Ico_finset (Finset.subset_univ _)]
    have he : (Finset.univ : Finset V).card - (upper F).card = b := by
      rw [Finset.card_univ,hk,F.property.2.2]
      omega
    rw [he]
  rw [Fintype.card_option,hT,←Nat.card_eq_fintype_card] at hcard
  have hp : 0 < 2^b := pow_pos (by decide) _
  omega

theorem overlap_fixed_lower (hb : 4 ≤ b) (hk : Fintype.card V = 3*b)
    (F G : Flag V b) (hA : lower F = lower G)
    (hB : (upper F ∩ upper G).card + 1 = 2*b) :
    2^b ≤ Nat.card ↥(core F ∩ core G) := by
  classical
  have hU : (upper F ∪ upper G).card = 2*b + 1 := by
    have h := Finset.card_union_add_card_inter (upper F) (upper G)
    rw [F.property.2.2,G.property.2.2] at h
    omega
  have hne : upper F ∪ upper G ≠ (Finset.univ : Finset V) := by
    intro h
    rw [h,Finset.card_univ,hk] at hU
    omega
  obtain ⟨c,hc⟩ :=
    (show (Finset.univ \ (upper F ∪ upper G)).Nonempty by
      apply Finset.sdiff_nonempty.mpr
      intro h
      exact hne (Finset.Subset.antisymm (Finset.subset_univ _) h))
  have hcU : c ∈ (Finset.univ : Finset V) := Finset.mem_univ _
  have hcF : c ∉ upper F := fun h => (Finset.mem_sdiff.mp hc).2
    (Finset.mem_union.mpr (Or.inl h))
  have hcG : c ∉ upper G := fun h => (Finset.mem_sdiff.mp hc).2
    (Finset.mem_union.mpr (Or.inr h))
  have hzcard : ((Finset.univ : Finset V).erase c).card + 1 = 3*b := by
    simpa only [Finset.card_univ,hk] using Finset.card_erase_add_one hcU
  let z : ProperSet V := ⟨Finset.univ.erase c,
    Finset.card_pos.mp (by omega),by
      intro h
      have hc' := congrArg Finset.card h
      rw [Finset.card_univ,hk] at hc'
      omega⟩
  let T := ↥(Set.Ioc (∅ : Finset V) (lower F))
  have ht (t : T) : t.val.Nonempty ∧ t.val ≠ Finset.univ := by
    refine ⟨Finset.empty_ssubset.mp t.property.1,?_⟩
    intro h
    have hle := Finset.card_le_card t.property.2
    have hF : (lower F).card = b := F.property.2.1
    rw [h,Finset.card_univ,hk] at hle
    omega
  let f : Option T → ↥(core F ∩ core G) := fun o => match o with
    | none => ⟨z,Or.inr (Or.inr (fun x hx =>
        Finset.mem_erase.mpr ⟨fun h => hcF (h ▸ hx),Finset.mem_univ _⟩)),
        Or.inr (Or.inr (fun x hx =>
        Finset.mem_erase.mpr ⟨fun h => hcG (h ▸ hx),Finset.mem_univ _⟩))⟩
    | some t => ⟨⟨t.val,ht t⟩,Or.inl t.property.2,
        Or.inl (by simpa only [←hA] using t.property.2)⟩
  have hf : Function.Injective f := by
    intro s t h
    have hv := congrArg (fun x => x.val.val) h
    cases s with
    | none =>
      cases t with
      | none => rfl
      | some t =>
        have hc := congrArg Finset.card hv
        have hle := Finset.card_le_card t.property.2
        have hF : (lower F).card = b := F.property.2.1
        change (Finset.univ.erase c).card = t.val.card at hc
        omega
    | some s =>
      cases t with
      | none =>
        have hc := congrArg Finset.card hv
        have hle := Finset.card_le_card s.property.2
        have hF : (lower F).card = b := F.property.2.1
        change s.val.card = (Finset.univ.erase c).card at hc
        omega
      | some t => exact congrArg some (Subtype.ext hv)
  have hcard := Fintype.card_le_of_injective f hf
  have hT : Fintype.card T = 2^b - 1 := by
    dsimp [T]
    rw [Fintype.card_Ioc,Finset.card_Ioc_finset (Finset.empty_subset _)]
    simp only [Finset.card_empty,Nat.sub_zero,F.property.2.1]
  rw [Fintype.card_option,hT,←Nat.card_eq_fintype_card] at hcard
  have hp : 0 < 2^b := pow_pos (by decide) _
  omega

theorem overlap (hb : 4 ≤ b) (hk : Fintype.card V = 3*b)
    (F G : Flag V b) (hFG : FlagPaths.Adjacent F G) :
    2^b ≤ Nat.card ↥(core F ∩ core G) := by
  rcases hFG with ⟨hB,hA⟩ | ⟨hA,hB⟩
  · exact overlap_fixed_upper hb hk F G hB hA
  · exact overlap_fixed_lower hb hk F G hA hB

theorem proper_base_rigid [Infinite K] (hb : 4 ≤ b) (hk : Fintype.card V = 3*b)
    (e : ℕ) (he : 1 ≤ e) (hbound : 3*b + e - 1 ≤ 2^b) :
    GenericallyRigid K (Fin (3*b + e - 2)) (BooleanStars.properGraph V) := by
  classical
  letI : Nonempty (Flag V b) := flag_nonempty (by omega)
  let F₀ : Flag V b := Classical.choice inferInstance
  apply genericallyRigid_connected_cover (BooleanStars.properGraph V)
    (core (b := b)) F₀ FlagPaths.Adjacent
  · exact core_cover (by omega)
  · intro F
    exact ThreeBlockCore.rigid F hb hk e he hbound
  · intro F G hFG
    have h := overlap hb hk F G hFG
    simp only [Fintype.card_fin]
    omega
  · exact flag_paths (by omega) F₀

end PaperVerification.Segre.ThreeBlockCover

end SegreThreeBlockCover

section SegreExcessThreeBlock

/-!
# The sharp three-block range of Theorem 6.1

The proper Boolean core is glued at `k=3b`. Star cones then add arbitrarily
many Boolean factors. Restoring the two extremal vertices and applying the
verified chain-coordinate induction gives all positive tuples.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ExcessThreeBlock

open GenericRigidity BooleanBase BooleanStars BooleanInduction Comparability
open Staircase RankParameters ChainInduction ExcessPropagation

variable {K : Type*} [Field K] [Infinite K]

theorem boolean_room (b e k : ℕ) (hb : 4 ≤ b) (he : 1 ≤ e)
    (hbound : 3*b + e - 1 ≤ 2^b) (hk : 3*b ≤ k) :
    k + e ≤ 2^(k-1) - 1 := by
  obtain ⟨t,rfl⟩ := Nat.exists_eq_add_of_le hk
  clear hk
  induction t with
  | zero =>
    simp only [Nat.add_zero]
    have hp : 2 ≤ 2^b := by
      simpa only [pow_one] using
        Nat.pow_le_pow_right (by decide : 0 < 2) (show 1 ≤ b by omega)
    have hpow : 2^(b+1) ≤ 2^(3*b-1) :=
      Nat.pow_le_pow_right (by decide) (by omega)
    rw [pow_succ] at hpow
    omega
  | succ t ih =>
    have hk0 : 0 < 3*b+t := by omega
    have heq : 3*b+(t+1)-1 = (3*b+t-1)+1 := by omega
    rw [heq,pow_succ]
    omega

theorem proper_step (k e : ℕ) (hk : 2 ≤ k) (he : 1 ≤ e)
    (hroom : k+e ≤ 2^(k-1)-1)
    (h : GenericallyRigid K (Fin (k+e-2)) (properBooleanGraph k)) :
    GenericallyRigid K (Fin ((k+1)+e-2)) (properBooleanGraph (k+1)) := by
  classical
  have hnext : GenericallyRigid K (Option (Fin (k+e-2)))
      (BooleanStars.properGraph (Fin (k+1))) := by
    apply genericallyRigid_cover (BooleanStars.properGraph (Fin (k+1)))
      (fun i : Fin (k+1) => star i) ⟨0,by omega⟩
    · intro s
      exact s.property.1
    · intro i
      exact fin_star_rigid (by omega) i h
    · intro i
      simp only [Fintype.card_option,Fintype.card_fin]
      by_cases hi : (⟨0,by omega⟩ : Fin (k+1)) = i
      · subst i
        rw [Set.inter_self,card_star]
        simp only [Fintype.card_fin,Nat.add_sub_cancel]
        have hp : 2^(k-1) ≤ 2^k :=
          Nat.pow_le_pow_right (by decide) (Nat.sub_le k 1)
        omega
      · rw [card_star_inter_distinct _ _ hi]
        omega
  apply genericallyRigid_fin _ ((k+1)+e-2) _ hnext
  simp only [Fintype.card_option,Fintype.card_fin]
  omega

theorem proper_rigid (b e k : ℕ) (hb : 4 ≤ b) (he : 1 ≤ e)
    (hbound : 3*b + e - 1 ≤ 2^b) (hk : 3*b ≤ k) :
    GenericallyRigid K (Fin (k+e-2)) (properBooleanGraph k) := by
  obtain ⟨t,rfl⟩ := Nat.exists_eq_add_of_le hk
  clear hk
  induction t with
  | zero =>
    have h := ThreeBlockCover.proper_base_rigid
      (K := K) (V := Fin (3*b)) hb (Fintype.card_fin _) e he hbound
    exact Eq.mp (congrArg (fun j : ℕ =>
      GenericallyRigid K (Fin (j+e-2)) (properBooleanGraph j))
      (Nat.add_zero (3*b)).symm) h
  | succ t ih =>
    have h := proper_step (K := K) (3*b+t) e (by omega) he
      (boolean_room b e (3*b+t) hb he hbound (by omega)) ih
    exact Eq.mp (congrArg (fun j : ℕ =>
      GenericallyRigid K (Fin (j+e-2)) (properBooleanGraph j))
      (Nat.add_assoc (3*b) t 1)) h

theorem full_boolean_rigid (b e k : ℕ) (hb : 4 ≤ b) (he : 1 ≤ e)
    (hbound : 3*b + e - 1 ≤ 2^b) (hk : 3*b ≤ k) :
    GenericallyRigid K (Fin (k+e)) (chainGraph (fun _ : Fin k => 1)) := by
  classical
  letI : Nonempty (Fin k) := ⟨⟨0,by omega⟩⟩
  have hp := proper_rigid (K := K) b e k hb he hbound hk
  have hproper : GenericallyRigid K (Fin (k+e-2))
      (Comparability.properGraph (Finset (Fin k))) := by
    have h := genericallyRigid_comap_equiv (BooleanStars.properGraph (Fin k))
      (properSubsetEquiv (V := Fin k)).symm hp
    have heq : (BooleanStars.properGraph (Fin k)).comap
        (properSubsetEquiv (V := Fin k)).symm =
          Comparability.properGraph (Finset (Fin k)) := by
      rw [←properSubset_graph]
      ext s t
      simp only [SimpleGraph.comap_adj,Equiv.apply_symm_apply]
    simpa only [heq] using h
  have hf := full_rigid_of_proper hproper
  have hf' : GenericallyRigid K (Fin (k+e))
      (Comparability.graph (Finset (Fin k))) := by
    apply genericallyRigid_fin _ (k+e) _ hf
    simp only [Fintype.card_option,Fintype.card_fin]
    omega
  have h := genericallyRigid_comap_equiv (Comparability.graph (Finset (Fin k)))
    (booleanCellEquiv (V := Fin k)) hf'
  simpa only [booleanCell_graph] using h

/-- The complete second parameter range of Theorem 6.1, with no bound on the
number of factors or their positive dimensions. -/
theorem section_6_1_second_graph_rigidity (b e k : ℕ) (hb : 4 ≤ b) (he : 1 ≤ e)
    (hbound : 3*b + e - 1 ≤ 2^b) (hk : 3*b ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  have h := full_boolean_rigid (K := K) b e k hb he hbound hk
  have hbase : GenericallyRigid K (Fin (sideSum (fun _ : Fin k => 1) + e))
      (chainGraph (fun _ : Fin k => 1)) := by
    apply genericallyRigid_fin _ _ ?_ h
    simp [sideSum]
  apply propagate_many_factors (fun _ : Fin k => 1) n e (fun _ => le_rfl)
    hpos _ hbase
  simp only [Fintype.card_fin]
  have hroom := boolean_room b e k hb he hbound hk
  omega

theorem section_6_1_second_exactness_certificate (b e k : ℕ)
    (hb : 4 ≤ b) (he : 1 ≤ e) (hbound : 3*b + e - 1 ≤ 2^b) (hk : 3*b ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    ∃ f : MvPolynomial (Cell n × Option (Fin (sideSum n + e))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Fin (sideSum n + e))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective A.vecMul ∧
          (Degeneration.multiplicationMatrix 1 A).rank =
            Fintype.card (Cell n) * (sideSum n + e + 1) - (sideSum n + e + 1).choose 2 ∧
          LinearMap.ker (KoszulRank.multiplication A) =
            LinearMap.range (KoszulDimension.koszulMatrix A) := by
  have h := HigherExcessRank.exactness_certificate_of_rigid
    (section_6_1_second_graph_rigidity (K := K) b e k hb he hbound hk n hpos)
  simpa only [Fintype.card_option,Fintype.card_fin] using h

end PaperVerification.Segre.ExcessThreeBlock

end SegreExcessThreeBlock

section SegreExcessLogarithmic

/-!
# The actual logarithmic threshold in Theorem 6.1

Mathlib's theorem identifying the natural ceiling of the real logarithm
with `Nat.clog` is used explicitly. The graph theorem therefore has the
paper's literal bound `k ≥ 3⌈log₂(4e)⌉`, not a substituted integer threshold.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ExcessLogarithmic

open GenericRigidity Staircase RankParameters ExcessThreeBlock

variable {K : Type*} [Field K] [Infinite K]

theorem block_linear_le_pow (b : ℕ) (hb : 4 ≤ b) : b ≤ 2^(b-2) := by
  obtain ⟨t,rfl⟩ := Nat.exists_eq_add_of_le hb
  clear hb
  induction t with
  | zero => norm_num
  | succ t ih =>
    have heq : 4+(t+1)-2 = (4+t-2)+1 := by omega
    rw [heq,pow_succ]
    omega

theorem block_pow_room (b : ℕ) (hb : 4 ≤ b) : 3*b ≤ 2^b := by
  have h := block_linear_le_pow b hb
  have hp : 2^b = 4*2^(b-2) := by
    calc
      2^b = 2^(b-2) * 2^2 := by
        rw [← pow_add, Nat.sub_add_cancel (by omega : 2 ≤ b)]
      _ = 4*2^(b-2) := by ring
  omega

/-- The arithmetic form used in the proof is equivalent to the paper's
subtracted natural-number bound throughout its stated range. -/
theorem block_bound_iff (b e : ℕ) (hb : 4 ≤ b) :
    e ≤ 2^b - 3*b + 1 ↔ 3*b + e - 1 ≤ 2^b := by
  have h := block_pow_room b hb
  omega

def logarithmicBlock (e : ℕ) : ℕ := ⌈Real.logb 2 (4*(e : ℝ))⌉₊

theorem logarithmicBlock_eq_clog (e : ℕ) :
    logarithmicBlock e = Nat.clog 2 (4*e) := by
  simpa only [logarithmicBlock,Nat.cast_mul,Nat.cast_ofNat] using
    Real.natCeil_logb_natCast 2 (4*e)

theorem logarithmicBlock_cast (e : ℕ) (he : 1 ≤ e) :
    (logarithmicBlock e : ℤ) = ⌈Real.logb 2 (4*(e : ℝ))⌉ := by
  apply Int.natCast_ceil_eq_ceil
  apply Real.logb_nonneg (by norm_num)
  exact_mod_cast (show 1 ≤ 4*e by omega)

theorem logarithmic_bound_iff (k e : ℕ) (he : 1 ≤ e) :
    3*⌈Real.logb 2 (4*(e : ℝ))⌉ ≤ (k : ℤ) ↔ 3*logarithmicBlock e ≤ k := by
  rw [←logarithmicBlock_cast e he]
  exact_mod_cast (Iff.rfl : 3*logarithmicBlock e ≤ k ↔ 3*logarithmicBlock e ≤ k)

theorem logarithmic_parameters (e : ℕ) (he : 3 ≤ e) :
    4 ≤ logarithmicBlock e ∧ 3*logarithmicBlock e + e - 1 ≤ 2^(logarithmicBlock e) := by
  let b := logarithmicBlock e
  change 4 ≤ b ∧ 3*b + e - 1 ≤ 2^b
  have hpower : 4*e ≤ 2^b := by
    dsimp [b]
    rw [logarithmicBlock_eq_clog]
    exact Nat.le_pow_clog (by decide) (4*e)
  have hb : 4 ≤ b := by
    by_contra hn
    have hb3 : b ≤ 3 := by omega
    have hp : 2^b ≤ 2^3 := Nat.pow_le_pow_right (by decide) hb3
    norm_num at hp
    omega
  have hexp : 2^b = 4*2^(b-2) := by
    calc
      2^b = 2^(b-2) * 2^2 := by
        rw [← pow_add, Nat.sub_add_cancel (by omega : 2 ≤ b)]
      _ = 4*2^(b-2) := by ring
  have hepow : e ≤ 2^(b-2) := by omega
  have hlinear := block_linear_le_pow b hb
  refine ⟨hb,?_⟩
  rw [hexp]
  omega

/-- Exact real-logarithmic parameter bound, over every infinite field and
for every positive tuple of factor dimensions. -/
theorem section_6_1_logarithmic_graph_rigidity (k e : ℕ) (he : 3 ≤ e)
    (hk : 3*⌈Real.logb 2 (4*(e : ℝ))⌉₊ ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  obtain ⟨hb,hbound⟩ := logarithmic_parameters e he
  exact section_6_1_second_graph_rigidity (logarithmicBlock e) e k hb
    (by omega) hbound hk n hpos

theorem section_6_1_logarithmic_exactness_certificate (k e : ℕ) (he : 3 ≤ e)
    (hk : 3*⌈Real.logb 2 (4*(e : ℝ))⌉₊ ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    ∃ f : MvPolynomial (Cell n × Option (Fin (sideSum n + e))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Fin (sideSum n + e))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective A.vecMul ∧
          (Degeneration.multiplicationMatrix 1 A).rank =
            Fintype.card (Cell n) * (sideSum n + e + 1) - (sideSum n + e + 1).choose 2 ∧
          LinearMap.ker (KoszulRank.multiplication A) =
            LinearMap.range (KoszulDimension.koszulMatrix A) := by
  obtain ⟨hb,hbound⟩ := logarithmic_parameters e he
  exact section_6_1_second_exactness_certificate (logarithmicBlock e) e k hb
    (by omega) hbound hk n hpos

/-- The three-block graph assertion in precisely the paper's natural-number
arithmetic convention, with equivalence to the internal bound proved above. -/
theorem section_6_1_second_paper_bound (b e k : ℕ) (hb : 4 ≤ b) (he : 1 ≤ e)
    (hbound : e ≤ 2^b - 3*b + 1) (hk : 3*b ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) :=
  section_6_1_second_graph_rigidity b e k hb he
    ((block_bound_iff b e hb).mp hbound) hk n hpos

/-- The logarithmic graph assertion also accepts the usual integer ceiling
without a change in its mathematical content. -/
theorem section_6_1_integer_ceil_graph_rigidity (k e : ℕ) (he : 3 ≤ e)
    (hk : 3*⌈Real.logb 2 (4*(e : ℝ))⌉ ≤ (k : ℤ))
    (n : Fin k → ℕ) (hpos : ∀ i,1 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  apply section_6_1_logarithmic_graph_rigidity k e he _ n hpos
  exact (logarithmic_bound_iff k e (by omega)).mp hk

end PaperVerification.Segre.ExcessLogarithmic

end SegreExcessLogarithmic

section SegreExcessSixThree

/-!
# The unrestricted algebraic and graph assertions behind Theorem 6.3

The threshold and numerical inequality are exactly those printed in the paper.
All larger tuples are included. This file proves the complete rigidity and
degree-two Koszul-exactness chain; the geometric conclusion about the span of
the singular-tuple scheme still requires the separate graph-span proposition.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ExcessSixThree

open Staircase Monomials RankParameters GenericRigidity DiagonalCore
open DiagonalBoxNeighbors CoreAttachment ExcessPropagation Degeneration KoszulDimension
open scoped Matrix

def threshold (k e L : ℕ) : ℕ := 2 * L + minimumSide k * (e - 2)

def blockLengths (k e L : ℕ) : List ℕ :=
  L :: (List.replicate (e - 2) (minimumSide k) ++ [L])

theorem blockLengths_length (k e L : ℕ) (he : 2 ≤ e) :
    (blockLengths k e L).length = e := by
  simp only [blockLengths,List.length_cons,List.length_append,List.length_replicate,
    List.length_nil]
  omega

theorem blockLengths_sum (k e L : ℕ) : (blockLengths k e L).sum = threshold k e L := by
  simp only [blockLengths,List.sum_cons,List.sum_append,List.sum_replicate,
    List.sum_nil,nsmul_eq_mul,Nat.cast_id,threshold]
  ring

theorem blockLengths_minimum (k e L : ℕ) (hL : minimumSide k ≤ L) :
    ∀ a ∈ blockLengths k e L, minimumSide k ≤ a := by
  intro a ha
  rcases List.mem_cons.mp ha with ha | ha
  · subst a
    exact hL
  · rcases List.mem_append.mp ha with ha | ha
    · have he := List.eq_of_mem_replicate ha
      subst a
      exact le_rfl
    · have he := List.mem_singleton.mp ha
      subst a
      exact hL

theorem excess_le_threshold (k e L : ℕ) (he : 2 ≤ e) (hL : minimumSide k ≤ L) :
    e ≤ threshold k e L := by
  have hL1 := (minimumSide_pos k).trans hL
  have hm := Nat.mul_le_mul_right (e - 2) (minimumSide_pos k)
  have hsub : e - 2 + 2 = e := Nat.sub_add_cancel he
  unfold threshold
  nlinarith

variable {K : Type*} [Field K] [Infinite K]

/-- The actual uniform threshold box is rigid in precisely dimension `kN+e`.
The complete diagonal core and every outside vertex are included. -/
theorem threshold_cube_rigid (k e L : ℕ) (hk : 3 ≤ k) (he : 2 ≤ e)
    (hL : minimumSide k ≤ L)
    (hbound : k * threshold k e L + e ≤
      (L + 1) ^ (k / 2) + (L + 1) ^ ((k + 1) / 2)) :
    GenericallyRigid K (Fin (k * threshold k e L + e))
      (chainGraph (fun _ : Fin k => threshold k e L)) := by
  classical
  let s := blockLengths k e L
  have hsum : s.sum = threshold k e L := blockLengths_sum k e L
  have hlen : s.length = e := blockLengths_length k e L he
  have hcore := diagonalCore_rigid (K := K) k hk s (blockLengths_minimum k e L hL)
  have hcore' : GenericallyRigid K (Fin (Fintype.card (Fin k) * s.sum + e))
      ((chainGraph (fun _ : Fin k => s.sum)).induce (diagonalCore s)) := by
    apply genericallyRigid_fin _ _ ?_ hcore
    simp only [Fintype.card_fin,hlen]
  have hN : 2 * L ≤ s.sum := by
    rw [hsum]
    unfold threshold
    omega
  have hfirst : firstBox (J := Fin k) s.sum L ⊆ diagonalCore s :=
    firstBox_subset_core_cons L (List.replicate (e - 2) (minimumSide k) ++ [L])
  have hlast : lastBox (J := Fin k) s.sum L ⊆ diagonalCore s :=
    lastBox_subset_core_append (L :: List.replicate (e - 2) (minimumSide k)) L
  have hb : Fintype.card (Fin k) * s.sum + e ≤
      (L + 1) ^ (Fintype.card (Fin k) / 2) +
        (L + 1) ^ ((Fintype.card (Fin k) + 1) / 2) := by
    simpa only [Fintype.card_fin,hsum] using hbound
  have h := cube_rigid_of_end_boxes s.sum L e (diagonalCore (J := Fin k) s)
    hN hfirst hlast hb hcore'
  have h' : GenericallyRigid K (Fin (k * s.sum + e))
      (chainGraph (fun _ : Fin k => s.sum)) := by
    apply genericallyRigid_fin _ _ ?_ h
    simp only [Fintype.card_fin]
  exact Eq.mp (congrArg (fun N : ℕ => GenericallyRigid K (Fin (k * N + e))
    (chainGraph (fun _ : Fin k => N))) hsum) h'

/-- The full graph-theoretic assertion of Theorem 6.3, with every chain length
at least the stated threshold and no upper bounds on the tuple. -/
theorem section_6_3_graph_rigidity (k e L : ℕ) (hk : 3 ≤ k) (he : 2 ≤ e)
    (hL : minimumSide k ≤ L)
    (hbound : k * threshold k e L + e ≤
      (L + 1) ^ (k / 2) + (L + 1) ^ ((k + 1) / 2))
    (n : Fin k → ℕ) (hn : ∀ i, threshold k e L ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  let m : Fin k → ℕ := fun _ => threshold k e L
  have hN := excess_le_threshold k e L he hL
  have hN1 : 1 ≤ threshold k e L := by omega
  have hbase := threshold_cube_rigid (K := K) k e L hk he hL hbound
  have hbase' : GenericallyRigid K (Fin (sideSum m + e)) (chainGraph m) := by
    apply genericallyRigid_fin _ _ ?_ hbase
    simp [m,sideSum,Fintype.card_fin,Nat.mul_comm]
  exact propagate_large_lengths m n e (by simpa only [Fintype.card_fin] using hk)
    (fun _ => hN1) (fun _ => hN) hn hbase'

/-- The exact full-slice algebraic conclusion at the Section 6.3 threshold:
on a nonempty polynomial open, the entire multiplication kernel consists of
ordinary Koszul boundaries. The remaining geometric span identification is
not assumed or encoded in the statement. -/
theorem section_6_3_exactness_certificate (k e L : ℕ) (hk : 3 ≤ k) (he : 2 ≤ e)
    (hL : minimumSide k ≤ L)
    (hbound : k * threshold k e L + e ≤
      (L + 1) ^ (k / 2) + (L + 1) ^ ((k + 1) / 2))
    (n : Fin k → ℕ) (hn : ∀ i, threshold k e L ≤ n i) :
    ∃ f : MvPolynomial (Cell n × Option (Fin (sideSum n + e))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Fin (sideSum n + e))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective A.vecMul ∧
          (multiplicationMatrix 1 A).rank =
            Fintype.card (Cell n) * (sideSum n + e + 1) -
              (sideSum n + e + 1).choose 2 ∧
          LinearMap.ker (KoszulRank.multiplication A) = LinearMap.range (koszulMatrix A) := by
  have h := HigherExcessRank.exactness_certificate_of_rigid
    (section_6_3_graph_rigidity (K := K) k e L hk he hL hbound n hn)
  simpa only [Fintype.card_option,Fintype.card_fin] using h

end PaperVerification.Segre.ExcessSixThree

end SegreExcessSixThree

section SegreExcessArithmetic

/-!
# Uniform numerical consequences of the diagonal-box criterion

The balanced-power inequality propagates from dimensions three and four to
every higher dimension. This proves the paper's uniform thresholds `3e²`, and
the improved threshold six for excess two, with no bounded computation.
-/

set_option autoImplicit false


namespace PaperVerification.Segre.ExcessArithmetic

open Staircase RankParameters GenericRigidity DiagonalCore ExcessSixThree

/-- Increasing the number of factors by two multiplies both power terms by
`L+1`, and therefore preserves the exact numerical attachment criterion. -/
theorem power_criterion_step (N L e k : ℕ) (hL : 1 ≤ L) (hk : 2 ≤ k)
    (hbound : k * N + e ≤ (L + 1) ^ (k / 2) + (L + 1) ^ ((k + 1) / 2)) :
    (k + 2) * N + e ≤
      (L + 1) ^ ((k + 2) / 2) + (L + 1) ^ ((k + 2 + 1) / 2) := by
  let P := (L + 1) ^ (k / 2) + (L + 1) ^ ((k + 1) / 2)
  have hP : k * N + e ≤ P := hbound
  have h2N : 2 * N ≤ k * N + e := by
    have h := Nat.mul_le_mul_right N hk
    omega
  have h2P := h2N.trans hP
  have hfloor : (k + 2) / 2 = k / 2 + 1 := by omega
  have hceil : (k + 2 + 1) / 2 = (k + 1) / 2 + 1 := by omega
  calc
    _ ≤ P + P := by rw [add_mul]; omega
    _ = P * 2 := by omega
    _ ≤ P * (L + 1) := Nat.mul_le_mul_left P (by omega)
    _ = _ := by
      dsimp only [P]
      rw [hfloor,hceil,pow_succ,pow_succ]
      ring

/-- Two base inequalities suffice for all dimensions, including both parities. -/
theorem power_criterion_all_dimensions (N L e : ℕ) (hL : 1 ≤ L)
    (h3 : 3 * N + e ≤ (L + 1) ^ (3 / 2) + (L + 1) ^ ((3 + 1) / 2))
    (h4 : 4 * N + e ≤ (L + 1) ^ (4 / 2) + (L + 1) ^ ((4 + 1) / 2))
    (k : ℕ) (hk : 3 ≤ k) :
    k * N + e ≤ (L + 1) ^ (k / 2) + (L + 1) ^ ((k + 1) / 2) := by
  induction k using Nat.strong_induction_on with
  | ind k ih =>
    by_cases h₃ : k = 3
    · subst k
      exact h3
    by_cases h₄ : k = 4
    · subst k
      exact h4
    have hprev := ih (k - 2) (by omega) (by omega)
    have hstep := power_criterion_step N L e (k - 2) hL (by omega) hprev
    simpa only [show k - 2 + 2 = k by omega] using hstep

theorem minimumSide_le_two (k : ℕ) : minimumSide k ≤ 2 := by
  unfold minimumSide
  split_ifs <;> omega

/-- Taking `L=3e` satisfies equation (8) for every `e≥2` and every `k≥3`. -/
theorem uniform_power_criterion (k e : ℕ) (hk : 3 ≤ k) (he : 2 ≤ e) :
    k * threshold k e (3 * e) + e ≤
      (3 * e + 1) ^ (k / 2) + (3 * e + 1) ^ ((k + 1) / 2) := by
  obtain ⟨p,hp⟩ := Nat.exists_eq_add_of_le he
  have heq : e = p + 2 := by omega
  clear hp
  subst e
  by_cases h₃ : k = 3
  · subst k
    norm_num [threshold,minimumSide,pow_two] <;> nlinarith [Nat.zero_le (p * p)]
  · let N := 2 * (3 * (p + 2)) + p
    have h3 : 3 * N + (p + 2) ≤
        (3 * (p + 2) + 1) ^ (3 / 2) + (3 * (p + 2) + 1) ^ ((3 + 1) / 2) := by
      norm_num [N,pow_two] <;> nlinarith [Nat.zero_le (p * p)]
    have h4 : 4 * N + (p + 2) ≤
        (3 * (p + 2) + 1) ^ (4 / 2) + (3 * (p + 2) + 1) ^ ((4 + 1) / 2) := by
      norm_num [N,pow_two] <;> nlinarith [Nat.zero_le (p * p)]
    have h := power_criterion_all_dimensions N (3 * (p + 2)) (p + 2)
      (by omega) h3 h4 k hk
    simpa only [threshold,minimumSide,if_neg h₃,one_mul,Nat.add_sub_cancel,N] using h

/-- The resulting actual box threshold lies below the paper's stated `3e²`. -/
theorem threshold_le_three_mul_square (k e : ℕ) (he : 2 ≤ e) :
    threshold k e (3 * e) ≤ 3 * e ^ 2 := by
  obtain ⟨p,hp⟩ := Nat.exists_eq_add_of_le he
  have heq : e = p + 2 := by omega
  clear hp
  subst e
  have h := Nat.mul_le_mul_right p (minimumSide_le_two k)
  simp only [threshold,Nat.add_sub_cancel]
  nlinarith [Nat.zero_le (p * p)]

/-- The improved excess-two choice `L=3` satisfies the criterion in every
dimension; its threshold is exactly six. -/
theorem excess_two_power_criterion (k : ℕ) (hk : 3 ≤ k) :
    k * threshold k 2 3 + 2 ≤ 4 ^ (k / 2) + 4 ^ ((k + 1) / 2) := by
  have h := power_criterion_all_dimensions 6 3 2 (by omega) (by norm_num) (by norm_num) k hk
  simpa only [threshold,Nat.sub_self,mul_zero,add_zero] using h

variable {K : Type*} [Field K] [Infinite K]

/-- The paper's unrestricted uniform `nᵢ≥3e²` rigidity consequence. The
geometric conclusion remains dependent on the separate graph-span theorem. -/
theorem uniform_large_factors_rigid (k e : ℕ) (hk : 3 ≤ k) (he : 2 ≤ e)
    (n : Fin k → ℕ) (hn : ∀ i, 3 * e ^ 2 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  refine section_6_3_graph_rigidity k e (3 * e) hk he ?_
    (uniform_power_criterion k e hk he) n ?_
  · have h := minimumSide_le_two k
    omega
  · exact fun i => (threshold_le_three_mul_square k e he).trans (hn i)

/-- The paper's improved `nᵢ≥6` rigidity consequence for excess two, in every
number of factors at least three. -/
theorem excess_two_six_rigid (k : ℕ) (hk : 3 ≤ k)
    (n : Fin k → ℕ) (hn : ∀ i, 6 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + 2)) (chainGraph n) := by
  refine section_6_3_graph_rigidity k 2 3 hk (by omega) ?_
    (excess_two_power_criterion k hk) n ?_
  · exact (minimumSide_le_two k).trans (by omega)
  · simpa only [threshold,Nat.sub_self,mul_zero,add_zero] using hn

end PaperVerification.Segre.ExcessArithmetic

end SegreExcessArithmetic

end SegreExcessTheorems

end
end
end ProbeLayer391

section ProbeLayer391



/-!
# Singular-vector geometry and all-format spanning theorems

The named sections preserve the original proof stages and local scopes.
-/

@[expose] public section

-- Emit compilation progress immediately while checking this large unit.
set_option stderrAsMessages false
-- Style linting is separate from elaboration, kernel checking, and the axiom audit.
set_option linter.all false
noncomputable section
set_option autoImplicit false


section SegreResolutionInjectivity

run_cmd do
  let out ← IO.getStderr
  out.putStrLn "SEGRE_STAGE SegreResolutionInjectivity"
  out.flush

/-!
# Injectivity of the actual first global differential

The cohomological image-factor bijection and the monicity of the actual
image inclusion prove injectivity of the entire first global differential.
An actual augmentation arrow isomorphism transfers this statement to the
original coefficient functional, retaining its entire source.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.ResolutionInjectivity

open CategoryTheory Limits AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open TauCeti.AlgebraicGeometry.Scheme.Modules

universe u
variable {X : Scheme.{u}}

/-- Injectivity of the actual image factor implies injectivity of the
original map on sections, since the actual image inclusion is monic. -/
theorem app_injective_of_factorThruImage {M N : X.Modules} (f : M ⟶ N)
    (h : Function.Injective ((factorThruImage f).app ⊤)) :
    Function.Injective (f.app ⊤) := by
  intro s t hst
  apply h
  apply ImageChartMembership.app_injective (image.ι f) ⊤
  have hcomp (z : Γ(M,⊤)) :
      (image.ι f).app ⊤ ((factorThruImage f).app ⊤ z)=f.app ⊤ z :=
    congrArg (fun a : M ⟶ N => a.app ⊤ z) (image.fac f)
  simpa only [hcomp] using hst

/-- The complete first differential is injective on all global sections
under the actual finite-resolution cohomology gap. -/
theorem first_differential_injective
    (T : ℕ → X.Modules) (d : ∀ r,T (r+1) ⟶ T r)
    (w : ∀ r,d (r+1) ≫ d r=0)
    (hex : ∀ r,(ShortComplex.mk (d (r+1)) (d r) (w r)).Exact)
    (B : ℕ) (hB : 1 ≤ B) (hzero : IsZero (T (B+1)))
    (hgap : ∀ r,2 ≤ r → r ≤ B → ∀ q,q<r → Subsingleton (Cohomology (T r) q)) :
    Function.Injective ((d 0).app ⊤) :=
  app_injective_of_factorThruImage (d 0)
    (ResolutionSections.first_image_sections_bijective T d w hex B hB hzero hgap).injective

/-- Global section injectivity is invariant under the actual augmentation
arrow isomorphism, without replacing the original source or target. -/
theorem app_injective_of_arrow_iso {M N M' N' : X.Modules}
    (f : M ⟶ N) (g : M' ⟶ N') (eM : M ≅ M') (eN : N ≅ N')
    (h : f ≫ eN.hom=eM.hom ≫ g) (hf : Function.Injective (f.app ⊤)) :
    Function.Injective (g.app ⊤) := by
  have hconj : eM.inv ≫ f ≫ eN.hom=g := by
    calc
      eM.inv ≫ f ≫ eN.hom=eM.inv ≫ (eM.hom ≫ g) := by rw [h]
      _=(eM.inv ≫ eM.hom) ≫ g := (Category.assoc _ _ _).symm
      _=g := by rw [Iso.inv_hom_id,Category.id_comp]
  have hs (z : Γ(M',⊤)) :
      eN.hom.app ⊤ (f.app ⊤ (eM.inv.app ⊤ z))=g.app ⊤ z :=
    congrArg (fun a : M' ⟶ N' => a.app ⊤ z) hconj
  intro s t hst
  apply ImageChartMembership.app_injective eM.inv ⊤
  apply hf
  apply ImageChartMembership.app_injective eN.hom ⊤
  simpa only [hs] using hst

/-- The whole original global functional is injective once its actual
weighted resolution and its actual cohomology gap have been established. -/
theorem global_functional_injective_of_resolution
    (T : ℕ → X.Modules) (d : ∀ r,T (r+1) ⟶ T r)
    (w : ∀ r,d (r+1) ≫ d r=0)
    (hex : ∀ r,(ShortComplex.mk (d (r+1)) (d r) (w r)).Exact)
    (B : ℕ) (hB : 1 ≤ B) (hzero : IsZero (T (B+1)))
    (hgap : ∀ r,2 ≤ r → r ≤ B → ∀ q,q<r → Subsingleton (Cohomology (T r) q))
    {M N : X.Modules} (φ : M ⟶ N) (e₁ : T 1 ≅ M) (e₀ : T 0 ≅ N)
    (haug : d 0 ≫ e₀.hom=e₁.hom ≫ φ) :
    Function.Injective (φ.app ⊤) :=
  app_injective_of_arrow_iso (d 0) φ e₁ e₀ haug
    (first_differential_injective T d w hex B hB hzero hgap)

end PaperVerification.Segre.ResolutionInjectivity

end SegreResolutionInjectivity

end
end
