/-!
# Bifunctors on homological complexes preserve homotopy equivalences

Let `F : C₁ ⥤ C₂ ⥤ D` be a bifunctor which is additive in each variable, and let
`mapBifunctor K₁ K₂ F c` be the induced total complex of homological complexes `K₁` and `K₂`
(for `F` the tensor product this is the tensor product of complexes).  Mathlib's
`HomologicalComplex.mapBifunctorMapHomotopy₁` and `HomologicalComplex.mapBifunctorMapHomotopy₂`
show that `mapBifunctorMap f₁ f₂ F c` only depends on the homotopy classes of `f₁` and `f₂`.
The functoriality of `mapBifunctorMap` in the pair `(f₁, f₂)` comes from
`TauCeti.Algebra.Homology.Bifunctor.Basic`. This file deduces that
homotopy equivalences `K₁ ≃ L₁` and `K₂ ≃ L₂` induce a homotopy equivalence
`mapBifunctor K₁ K₂ F c ≃ mapBifunctor L₁ L₂ F c`.  In particular the homology of a tensor
product of complexes only depends on the homotopy types of the factors, which is how the Künneth
theorem reduces to complexes with zero differential.

## Main definitions and results

* `HomologicalComplex.mapBifunctorMap_id` and `HomologicalComplex.mapBifunctorMap_comp`:
  functoriality of `mapBifunctorMap` in both variables simultaneously.
* `HomotopyEquiv.mapBifunctor`: the homotopy equivalence of total complexes induced by
  homotopy equivalences of the two factors.
-/

public section

noncomputable section

open CategoryTheory Limits

variable {C₁ C₂ D I₁ I₂ J : Type*} [Category* C₁] [Category* C₂] [Category* D]
  {c₁ : ComplexShape I₁} {c₂ : ComplexShape I₂}



namespace HomotopyEquiv

open HomologicalComplex

variable [Preadditive C₁] [Preadditive C₂] [Preadditive D]
  {F : C₁ ⥤ C₂ ⥤ D} [F.Additive] [∀ X₁, (F.obj X₁).Additive]
  {c : ComplexShape J} [DecidableEq J] [TotalComplexShape c₁ c₂ c]
  {K₁ L₁ : HomologicalComplex C₁ c₁} {K₂ L₂ : HomologicalComplex C₂ c₂}
  [HasMapBifunctor K₁ K₂ F c] [HasMapBifunctor L₁ L₂ F c]

/-- A homotopy between `f₁ ≫ g₁` and `𝟙` and a homotopy between `f₂ ≫ g₂` and `𝟙` induce a
homotopy between `mapBifunctorMap f₁ f₂ F c ≫ mapBifunctorMap g₁ g₂ F c` and `𝟙`. -/
private def mapBifunctorHomotopyId (f₁ : K₁ ⟶ L₁) (g₁ : L₁ ⟶ K₁) (f₂ : K₂ ⟶ L₂)
    (g₂ : L₂ ⟶ K₂) (h₁ : Homotopy (f₁ ≫ g₁) (𝟙 K₁)) (h₂ : Homotopy (f₂ ≫ g₂) (𝟙 K₂)) :
    Homotopy (mapBifunctorMap f₁ f₂ F c ≫ mapBifunctorMap g₁ g₂ F c) (𝟙 _) :=
  (Homotopy.ofEq (mapBifunctorMap_comp F c f₁ g₁ f₂ g₂).symm).trans
    (((mapBifunctorMapHomotopy₁ h₁ (f₂ ≫ g₂) F c).trans
      (mapBifunctorMapHomotopy₂ (𝟙 K₁) h₂ F c)).trans
        (Homotopy.ofEq (mapBifunctorMap_id F c K₁ K₂)))

variable (F c) in
/-- Homotopy equivalences `K₁ ≃ L₁` and `K₂ ≃ L₂` induce a homotopy equivalence
`mapBifunctor K₁ K₂ F c ≃ mapBifunctor L₁ L₂ F c`, given by `mapBifunctorMap` of the two
homotopy equivalences and of their inverses. -/
def mapBifunctor (e₁ : HomotopyEquiv K₁ L₁) (e₂ : HomotopyEquiv K₂ L₂) :
    HomotopyEquiv (HomologicalComplex.mapBifunctor K₁ K₂ F c)
      (HomologicalComplex.mapBifunctor L₁ L₂ F c) where
  hom := mapBifunctorMap e₁.hom e₂.hom F c
  inv := mapBifunctorMap e₁.inv e₂.inv F c
  homotopyHomInvId :=
    mapBifunctorHomotopyId _ _ _ _ e₁.homotopyHomInvId e₂.homotopyHomInvId
  homotopyInvHomId :=
    mapBifunctorHomotopyId _ _ _ _ e₁.homotopyInvHomId e₂.homotopyInvHomId

/-- The forward map of `HomotopyEquiv.mapBifunctor`. -/
@[simp]
lemma mapBifunctor_hom (e₁ : HomotopyEquiv K₁ L₁) (e₂ : HomotopyEquiv K₂ L₂) :
    (mapBifunctor F c e₁ e₂).hom = mapBifunctorMap e₁.hom e₂.hom F c :=
  (rfl)

/-- The backward map of `HomotopyEquiv.mapBifunctor`. -/
@[simp]
lemma mapBifunctor_inv (e₁ : HomotopyEquiv K₁ L₁) (e₂ : HomotopyEquiv K₂ L₂) :
    (mapBifunctor F c e₁ e₂).inv = mapBifunctorMap e₁.inv e₂.inv F c :=
  (rfl)

end HomotopyEquiv
end
end
end ProbeLayer289

section ProbeLayer290



/-!
# Vanishing for the actual product tensor total

The sheaf resolution uses finite products on antidiagonals.  This file proves
vanishing for that same total construction directly, by splitting complexes of
vector spaces.  No identification of a product-cover Čech complex with a tensor
complex is assumed.  The two differentials and their signs are preserved by the
opposite construction.
-/

@[expose] public section

noncomputable section
open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite HomologicalComplex

namespace PaperVerification.Segre.ProductTensorTotal

universe v u

section Opposite

variable {C : Type u} [Category.{v} C] [Preadditive C] [MonoidalCategory C]
  [MonoidalPreadditive C]

/-- Tensoring in the opposite category remains additive. -/
instance monoidalPreadditiveOpposite : MonoidalPreadditive Cᵒᵖ where
  whiskerLeft_zero := by
    intros
    apply Quiver.Hom.unop_inj
    simp
  zero_whiskerRight := by
    intros
    apply Quiver.Hom.unop_inj
    simp
  whiskerLeft_add := by
    intros
    apply Quiver.Hom.unop_inj
    simp
  add_whiskerRight := by
    intros
    apply Quiver.Hom.unop_inj
    simp

variable {I : Type*} {c : ComplexShape I}

/-- A homotopy equivalence of actual complexes gives one between their
opposite complexes, with the arrows reversed. -/
def oppositeHomotopyEquiv {A B : HomologicalComplex C c}
    (e : HomotopyEquiv A B) : HomotopyEquiv A.op B.op where
  hom := (HomologicalComplex.opFunctor C c).map e.inv.op
  inv := (HomologicalComplex.opFunctor C c).map e.hom.op
  homotopyHomInvId := by
    simpa using e.homotopyHomInvId.op
  homotopyInvHomId := by
    simpa using e.homotopyInvHomId.op

end Opposite

variable {K : Type u} [Field K]

/-- For a zero-differential complex, its actual degree term is its homology.
This is composed from the public cycles and quotient isomorphisms. -/
def zeroDifferentialTermIso (A : CochainComplex (ModuleCat.{u} K) ℕ)
    (hA : ∀ i j, A.d i j = 0) (p : ℕ) : A.X p ≅ A.homology p :=
  (A.iCyclesIso p _ rfl (hA _ _)).symm ≪≫ A.isoHomologyπ _ p rfl (hA _ _)

/-- The genuine tensor bicomplex, before totalization. -/
def tensorBicomplex (A B : CochainComplex (ModuleCat.{u} K) ℕ) :
    CochainTotal.Bicomplex (C := ModuleCat.{u} K) :=
  (((curriedTensor (ModuleCat.{u} K)).mapBifunctorHomologicalComplex
    (ComplexShape.up ℕ) (ComplexShape.up ℕ)).obj A).obj B

/-- Tensoring the opposite complexes and then taking the opposite back uses
products in each total degree. -/
def productTensor (A B : CochainComplex (ModuleCat.{u} K) ℕ) :
    CochainComplex (ModuleCat.{u} K) ℕ :=
  (HomologicalComplex.tensorObj
    (show ChainComplex ((ModuleCat.{u} K)ᵒᵖ) ℕ from A.op)
    (show ChainComplex ((ModuleCat.{u} K)ᵒᵖ) ℕ from B.op)).unop

/-- This is the exact totalization used in the actual double Čech resolution. -/
theorem productTensor_eq_total
    (A B : CochainComplex (ModuleCat.{u} K) ℕ) :
    productTensor A B = CochainTotal.total (tensorBicomplex A B) := rfl

/-- The product total is exact if every possible distribution of the total
degree has an actually vanishing factor cohomology group. -/
theorem productTensor_exact_of_factor_vanishing
    (A B : CochainComplex (ModuleCat.{u} K) ℕ) (n : ℕ)
    (h : ∀ p q : ℕ, p + q = n →
      IsZero (A.homology p) ∨ IsZero (B.homology q)) :
    (productTensor A B).ExactAt n := by
  obtain ⟨A', hA', ⟨eA⟩⟩ := A.exists_homotopyEquiv_d_eq_zero
  obtain ⟨B', hB', ⟨eB⟩⟩ := B.exists_homotopyEquiv_d_eq_zero
  let Aop : ChainComplex ((ModuleCat.{u} K)ᵒᵖ) ℕ := A.op
  let Bop : ChainComplex ((ModuleCat.{u} K)ᵒᵖ) ℕ := B.op
  let Aop' : ChainComplex ((ModuleCat.{u} K)ᵒᵖ) ℕ := A'.op
  let Bop' : ChainComplex ((ModuleCat.{u} K)ᵒᵖ) ℕ := B'.op
  let eAop : HomotopyEquiv Aop Aop' := oppositeHomotopyEquiv eA
  let eBop : HomotopyEquiv Bop Bop' := oppositeHomotopyEquiv eB
  let e := HomotopyEquiv.mapBifunctor
    (curriedTensor ((ModuleCat.{u} K)ᵒᵖ)) (ComplexShape.down ℕ) eAop eBop
  have hz : IsZero ((HomologicalComplex.tensorObj Aop' Bop').X n) := by
    rw [IsZero.iff_id_eq_zero]
    apply HomologicalComplex.mapBifunctor.hom_ext
    intro p q hpq
    rcases h p q hpq with hp | hq
    · have hp' : IsZero (A'.X p) :=
        hp.of_iso ((zeroDifferentialTermIso A' hA' p) ≪≫
          (eA.toHomologyIso p).symm)
      exact ((tensorRight (B'.op.X q)).map_isZero hp'.op).eq_of_src _ _
    · have hq' : IsZero (B'.X q) :=
        hq.of_iso ((zeroDifferentialTermIso B' hB' q) ≪≫
          (eB.toHomologyIso q).symm)
      exact ((tensorLeft (A'.op.X p)).map_isZero hq'.op).eq_of_src _ _
  have he : (HomologicalComplex.tensorObj Aop' Bop').ExactAt n :=
    HomologicalComplex.ExactAt.of_isZero hz
  have hA : (HomologicalComplex.tensorObj Aop Bop).ExactAt n := by
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    exact he.isZero_homology.of_iso (e.toHomologyIso n)
  exact hA.unop

/-- Actual tensor-product lower cohomological bounds add. -/
theorem productTensor_exact_below
    (A B : CochainComplex (ModuleCat.{u} K) ℕ) (a b n : ℕ)
    (hA : ∀ p < a, A.ExactAt p) (hB : ∀ q < b, B.ExactAt q)
    (hn : n < a + b) :
    (productTensor A B).ExactAt n :=
  productTensor_exact_of_factor_vanishing A B n fun p q hpq ↦ by
    by_cases hp : p < a
    · exact Or.inl (hA p hp).isZero_homology
    · exact Or.inr (hB q (by omega)).isZero_homology

end PaperVerification.Segre.ProductTensorTotal
end
end
end ProbeLayer290

