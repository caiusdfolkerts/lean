/-! # The usual tensor signs for nonnegative cochain complexes -/
@[expose] public section

noncomputable section

namespace PaperVerification.Segre.CochainSigns

instance tensorSignsUpNat : ComplexShape.TensorSigns (ComplexShape.up ℕ) where
  ε' := MonoidHom.mk' (fun i : Multiplicative ℕ ↦ (-1 : ℤˣ) ^ i.toAdd)
    (fun i j ↦ pow_add (-1 : ℤˣ) i.toAdd j.toAdd)
  rel_add p q r (hpq : p + 1 = q) := by
    change p + r + 1 = q + r
    omega
  add_rel p q r (hpq : p + 1 = q) := by
    change r + p + 1 = r + q
    omega
  ε'_succ := by
    rintro p _ rfl
    change (-1 : ℤˣ) ^ (p + 1) = -((-1 : ℤˣ) ^ p)
    rw [pow_succ, mul_neg, mul_one]

@[simp]
theorem epsilon_up_nat (n : ℕ) : (ComplexShape.up ℕ).ε n = (-1 : ℤˣ) ^ n := rfl

instance totalComplexShapeSymmetryUpNat :
    TotalComplexShapeSymmetry (ComplexShape.up ℕ) (ComplexShape.up ℕ)
      (ComplexShape.up ℕ) where
  symm p q := Nat.add_comm q p
  σ p q := (-1 : ℤˣ) ^ (p * q)
  σ_ε₁ := by
    rintro p _ rfl q
    dsimp
    rw [mul_one, Nat.add_mul, one_mul, pow_add, mul_left_comm, Int.units_mul_self, mul_one]
  σ_ε₂ := by
    rintro p q _ rfl
    dsimp
    rw [one_mul, Nat.mul_add, Nat.mul_one, pow_add]

instance hasTotalUpNat {C : Type*} [CategoryTheory.Category C]
    [CategoryTheory.Preadditive C] [CategoryTheory.Limits.HasFiniteCoproducts C]
    (K : HomologicalComplex₂ C (ComplexShape.up ℕ) (ComplexShape.up ℕ)) :
    K.HasTotal (ComplexShape.up ℕ) := fun n ↦
  have : Finite (ComplexShape.π (ComplexShape.up ℕ) (ComplexShape.up ℕ)
      (ComplexShape.up ℕ) ⁻¹' {n}) :=
    inferInstanceAs (Finite ((fun i : ℕ × ℕ ↦ i.1 + i.2) ⁻¹' {n}))
  inferInstance

end PaperVerification.Segre.CochainSigns
