/-!
# Additive coefficient functors and actual total complexes

The comparison is constructed from the genuine inclusions of the summands.
Its chain-map identity preserves both signed differentials. Passing to opposite
categories gives the product-total comparison needed for global sections of
the actual double Čech sheaf resolution.
-/

@[expose] public section

noncomputable section

-- The actual opposite and total objects agree by their transparent definitions.
-- This elaboration option changes no theorem statement or kernel trust setting.
set_option backward.isDefEq.respectTransparency false
open CategoryTheory CategoryTheory.Limits Opposite HomologicalComplex

namespace PaperVerification.Segre.TotalCoefficientFunctor

universe v₁ v₂ u₁ u₂
variable {C : Type u₁} {D : Type u₂}
  [Category.{v₁} C] [Category.{v₂} D] [Abelian C] [Abelian D]

abbrev ChainBi (C : Type u₁) [Category.{v₁} C] [Abelian C] :=
  HomologicalComplex₂ C (ComplexShape.down ℕ) (ComplexShape.down ℕ)

variable (F : C ⥤ D) [F.Additive]

/-- Apply the coefficient functor to both levels of a bicomplex. -/
def mapChainBi (K : ChainBi C) : ChainBi D :=
  ((F.mapHomologicalComplex (ComplexShape.down ℕ)).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj K

/-- The canonical coproduct comparison in total degree n. -/
def comparisonDegree (K : ChainBi C) (n : ℕ) :
    ((mapChainBi F K).total (ComplexShape.down ℕ)).X n ⟶
      F.obj ((K.total (ComplexShape.down ℕ)).X n) :=
  (mapChainBi F K).totalDesc fun p q h ↦
    F.map (K.ιTotal (ComplexShape.down ℕ) p q n h)

@[reassoc (attr := simp)]
theorem inclusion_comparison (K : ChainBi C) (p q n : ℕ) (h : p + q = n) :
    (mapChainBi F K).ιTotal (ComplexShape.down ℕ) p q n h ≫ comparisonDegree F K n =
      F.map (K.ιTotal (ComplexShape.down ℕ) p q n h) := by
  exact HomologicalComplex₂.ι_totalDesc _ _ _ _ _

@[reassoc (attr := simp)]
theorem inclusionOrZero_comparison (K : ChainBi C) (p q n : ℕ) :
    (mapChainBi F K).ιTotalOrZero (ComplexShape.down ℕ) p q n ≫
      comparisonDegree F K n =
      F.map (K.ιTotalOrZero (ComplexShape.down ℕ) p q n) := by
  by_cases h : p + q = n
  · rw [HomologicalComplex₂.ιTotalOrZero_eq _ _ _ _ _ h,
      HomologicalComplex₂.ιTotalOrZero_eq _ _ _ _ _ h]
    exact inclusion_comparison F K p q n h
  · rw [HomologicalComplex₂.ιTotalOrZero_eq_zero _ _ _ _ _ h,
      HomologicalComplex₂.ιTotalOrZero_eq_zero _ _ _ _ _ h]
    simp <;> rfl

@[reassoc]
theorem firstDifferential_comparison (K : ChainBi C) (p q n : ℕ) :
    (mapChainBi F K).d₁ (ComplexShape.down ℕ) p q n ≫ comparisonDegree F K n =
      F.map (K.d₁ (ComplexShape.down ℕ) p q n) := by
  change (_ • (F.map ((K.d p ((ComplexShape.down ℕ).next p)).f q) ≫
    (mapChainBi F K).ιTotalOrZero (ComplexShape.down ℕ)
      ((ComplexShape.down ℕ).next p) q n)) ≫ comparisonDegree F K n = _
  erw [Linear.units_smul_comp, Category.assoc, inclusionOrZero_comparison]
  simp only [HomologicalComplex₂.d₁, Functor.map_units_smul, Functor.map_comp]
  rfl

@[reassoc]
theorem secondDifferential_comparison (K : ChainBi C) (p q n : ℕ) :
    (mapChainBi F K).d₂ (ComplexShape.down ℕ) p q n ≫ comparisonDegree F K n =
      F.map (K.d₂ (ComplexShape.down ℕ) p q n) := by
  change (_ • (F.map ((K.X p).d q ((ComplexShape.down ℕ).next q)) ≫
    (mapChainBi F K).ιTotalOrZero (ComplexShape.down ℕ)
      p ((ComplexShape.down ℕ).next q) n)) ≫ comparisonDegree F K n = _
  erw [Linear.units_smul_comp, Category.assoc, inclusionOrZero_comparison]
  simp only [HomologicalComplex₂.d₂, Functor.map_units_smul, Functor.map_comp]
  rfl

/-- The canonical comparison is a map of the actual signed total complexes. -/
def comparison (K : ChainBi C) :
    (mapChainBi F K).total (ComplexShape.down ℕ) ⟶
      (F.mapHomologicalComplex (ComplexShape.down ℕ)).obj
        (K.total (ComplexShape.down ℕ)) where
  f n := comparisonDegree F K n
  comm' n m _ := by
    symm
    apply HomologicalComplex₂.total.hom_ext
    intro p q h
    change (mapChainBi F K).ιTotal (ComplexShape.down ℕ) p q n h ≫
      ((mapChainBi F K).D₁ (ComplexShape.down ℕ) n m +
        (mapChainBi F K).D₂ (ComplexShape.down ℕ) n m) ≫
          comparisonDegree F K m =
      (mapChainBi F K).ιTotal (ComplexShape.down ℕ) p q n h ≫
        comparisonDegree F K n ≫
          F.map (K.D₁ (ComplexShape.down ℕ) n m + K.D₂ (ComplexShape.down ℕ) n m)
    erw [← Category.assoc, Preadditive.comp_add, Preadditive.add_comp,
      HomologicalComplex₂.ι_D₁, HomologicalComplex₂.ι_D₂,
      firstDifferential_comparison, secondDifferential_comparison,
      ← Category.assoc, inclusion_comparison, ← F.map_comp,
      Preadditive.comp_add, HomologicalComplex₂.ι_D₁, HomologicalComplex₂.ι_D₂,
      F.map_add]

/-- The degree comparison is precisely the standard coproduct comparison. -/
theorem comparisonDegree_eq_sigmaComparison (K : ChainBi C) (n : ℕ) :
    comparisonDegree F K n =
      sigmaComparison F
        (fun a : (fun pq : ℕ × ℕ ↦ pq.1 + pq.2) ⁻¹' {n} ↦
          (K.X a.1.1).X a.1.2) := rfl

instance comparison_isIso [PreservesColimits F] (K : ChainBi C) :
    IsIso (comparison F K) := by
  letI : PreservesColimitsOfSize.{0,0} F := preservesColimitsOfSize_shrink F
  letI (n : ℕ) : IsIso ((comparison F K).f n) := by
    change IsIso (comparisonDegree F K n)
    rw [comparisonDegree_eq_sigmaComparison]
    infer_instance
  exact HomologicalComplex.Hom.isIso_of_components _

/-- An additive coefficient functor preserving coproducts commutes with the
actual chain total, including its differential. -/
def comparisonIso [PreservesColimits F] (K : ChainBi C) :
    (mapChainBi F K).total (ComplexShape.down ℕ) ≅
      (F.mapHomologicalComplex (ComplexShape.down ℕ)).obj
        (K.total (ComplexShape.down ℕ)) :=
  asIso (comparison F K)

/-- Apply a coefficient functor to a genuine cochain bicomplex. -/
def mapCochainBi (K : CochainTotal.Bicomplex (C := C)) :
    CochainTotal.Bicomplex (C := D) :=
  ((F.mapHomologicalComplex (ComplexShape.up ℕ)).mapHomologicalComplex
    (ComplexShape.up ℕ)).obj K

/-- Taking global sections, or any additive limit-preserving coefficient
functor, commutes with the actual product total of the bicomplex. -/
def productComparisonIso [PreservesLimits F] (K : CochainTotal.Bicomplex (C := C)) :
    (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj (CochainTotal.total K) ≅
      CochainTotal.total (mapCochainBi F K) := by
  letI : PreservesColimits F.op := preservesColimits_op F
  exact (HomologicalComplex.unopFunctor D (ComplexShape.down ℕ)).mapIso
    (comparisonIso F.op (CochainTotal.oppositeBicomplex K)).op

end PaperVerification.Segre.TotalCoefficientFunctor
end
end
