section SegreTangentKernel
set_option autoImplicit false


/-!
# The kernel of the Segre tangent insertion map

The maps in this file are the actual coefficient maps in the tensor product
coordinate space.  On a projective chart each factor vector has one coordinate
equal to one.  The kernel consists exactly of rescalings of the individual
factors whose coefficients sum to zero.

Restricting the inserted vectors to their coordinate-orthogonal hyperplanes
identifies the kernel with scalar relations supported on isotropic factors.
No division by two, polarization identity, or differentiation of the isotropic
quadratic is used.

-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.TangentKernel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} {R : Type*} [CommRing R]

/-- The coefficient array of the actual pure tensor. -/
def pureTensor (v : ∀ i, σ i → R) : (∀ i, σ i) → R :=
  fun a => ∏ i, v i (a i)

/-- The product of all coefficients except the insertion slot. -/
def otherProduct (v : ∀ i, σ i → R) (i : ι) (a : ∀ i, σ i) : R :=
  ∏ j ∈ Finset.univ.erase i, v j (a j)

/-- The differential of the pure-tensor map, written in its coefficient basis. -/
def tangentMap (v : ∀ i, σ i → R) :
    (∀ i, σ i → R) →ₗ[R] ((∀ i, σ i) → R) where
  toFun w a := ∑ i, w i (a i) * otherProduct v i a
  map_add' w z := by
    funext a
    change (∑ i, (w i (a i) + z i (a i)) * otherProduct v i a) =
      (∑ i, w i (a i) * otherProduct v i a) +
        ∑ i, z i (a i) * otherProduct v i a
    simp only [add_mul, Finset.sum_add_distrib]
  map_smul' c w := by
    funext a
    change (∑ i, (c * w i (a i)) * otherProduct v i a) =
      c * ∑ i, w i (a i) * otherProduct v i a
    simp only [Finset.mul_sum, mul_assoc]

@[simp] theorem tangentMap_apply (v w : ∀ i, σ i → R) (a : ∀ i, σ i) :
    tangentMap v w a = ∑ i, w i (a i) * otherProduct v i a := rfl

theorem coefficient_mul_otherProduct (v : ∀ i, σ i → R)
    (i : ι) (a : ∀ i, σ i) :
    v i (a i) * otherProduct v i a = pureTensor v a := by
  exact Finset.mul_prod_erase Finset.univ (fun j => v j (a j))
    (Finset.mem_univ i)

section Chart

variable (v : ∀ i, σ i → R) (p : ∀ i, σ i)
variable (hp : ∀ i, v i (p i) = 1)

include hp

theorem otherProduct_at_pivot (i : ι) :
    otherProduct v i p = 1 := by
  apply Finset.prod_eq_one
  intro j _
  exact hp j

theorem otherProduct_update_self (i : ι) (x : σ i) :
    otherProduct v i (Function.update p i x) = 1 := by
  apply Finset.prod_eq_one
  intro j hj
  have hji : j ≠ i := (Finset.mem_erase.mp hj).1
  rw [Function.update_of_ne hji]
  exact hp j

theorem otherProduct_update_ne {i j : ι} (hij : i ≠ j) (x : σ i) :
    otherProduct v j (Function.update p i x) = v i x := by
  simpa only [otherProduct, Function.update_self] using
    (Finset.prod_eq_single_of_mem
      (f := fun k => v k (Function.update p i x k)) i
      (Finset.mem_erase.mpr ⟨hij, Finset.mem_univ i⟩)
      (fun k _ hki => by
        rw [Function.update_of_ne hki]
        exact hp k))

theorem tangent_at_pivot (w : ∀ i, σ i → R) :
    tangentMap v w p = ∑ i, w i (p i) := by
  simp only [tangentMap_apply, otherProduct_at_pivot v p hp, mul_one]

theorem tangent_at_update (w : ∀ i, σ i → R) (i : ι) (x : σ i) :
    tangentMap v w (Function.update p i x) =
      w i x + (∑ j ∈ Finset.univ.erase i, w j (p j)) * v i x := by
  calc
    tangentMap v w (Function.update p i x) =
        w i x + ∑ j ∈ Finset.univ.erase i, w j (p j) * v i x := by
      rw [tangentMap_apply,
        ← Finset.add_sum_erase Finset.univ
          (fun j => w j (Function.update p i x j) *
            otherProduct v j (Function.update p i x))
          (Finset.mem_univ i)]
      apply congrArg₂ (· + ·)
      · simp only [Function.update_self,
          otherProduct_update_self v p hp, mul_one]
      · apply Finset.sum_congr rfl
        intro j hj
        have hji : j ≠ i := (Finset.mem_erase.mp hj).1
        rw [Function.update_of_ne hji,
          otherProduct_update_ne v p hp hji.symm]
    _ = w i x + (∑ j ∈ Finset.univ.erase i, w j (p j)) * v i x := by
      rw [Finset.sum_mul]

/-- The full tangent kernel on a chart, with no genericity premise. -/
theorem tangent_eq_zero_iff (w : ∀ i, σ i → R) :
    tangentMap v w = 0 ↔
      ∃ a : ι → R, (∑ i, a i) = 0 ∧
        ∀ i x, w i x = a i * v i x := by
  constructor
  · intro h
    have hs : (∑ i, w i (p i)) = 0 := by
      simpa only [tangent_at_pivot v p hp, Pi.zero_apply] using congrFun h p
    refine ⟨fun i => w i (p i), hs, ?_⟩
    intro i x
    have hx :
        w i x + (∑ j ∈ Finset.univ.erase i, w j (p j)) * v i x = 0 := by
      simpa only [tangent_at_update v p hp, Pi.zero_apply] using
        congrFun h (Function.update p i x)
    have he : (∑ j ∈ Finset.univ.erase i, w j (p j)) = -w i (p i) := by
      apply eq_neg_iff_add_eq_zero.mpr
      rw [Finset.sum_erase_add _ _ (Finset.mem_univ i)]
      exact hs
    rw [he, neg_mul] at hx
    exact sub_eq_zero.mp (by simpa only [sub_eq_add_neg] using hx)
  · rintro ⟨a, ha, hw⟩
    funext b
    change (∑ i, w i (b i) * otherProduct v i b) = 0
    calc
      (∑ i, w i (b i) * otherProduct v i b) =
          ∑ i, a i * pureTensor v b := by
        apply Finset.sum_congr rfl
        intro i _
        rw [hw, mul_assoc, coefficient_mul_otherProduct]
      _ = (∑ i, a i) * pureTensor v b := by rw [Finset.sum_mul]
      _ = 0 := by rw [ha, zero_mul]

theorem tangent_kernel_pointwise (w : ∀ i, σ i → R)
    (hw : tangentMap v w = 0) (i : ι) (x : σ i) :
    w i x = w i (p i) * v i x := by
  obtain ⟨a, _, ha⟩ := (tangent_eq_zero_iff v p hp w).mp hw
  rw [ha i x, ha i (p i), hp i, mul_one]

end Chart

section Orthogonal

variable [∀ i, Fintype (σ i)]

/-- The coordinate bilinear form as a linear functional in its second argument. -/
def pairing {S : Type*} [Fintype S] (v : S → R) : (S → R) →ₗ[R] R where
  toFun w := ∑ a, v a * w a
  map_add' w z := by simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
  map_smul' c w := by
    simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro a _
    exact mul_left_comm _ _ _

def quadraticNorm {S : Type*} [Fintype S] (v : S → R) : R :=
  pairing v v

theorem pairing_smul_self {S : Type*} [Fintype S] (v : S → R) (c : R) :
    pairing v (c • v) = c * quadraticNorm v := by
  exact (pairing v).map_smul c v

/-- Restrict the actual tangent insertion to the orthogonal hyperplanes. -/
def orthogonalTangentMap (v : ∀ i, σ i → R) :
    (∀ i, (pairing (v i)).ker) →ₗ[R] ((∀ i, σ i) → R) :=
  (tangentMap v).comp (LinearMap.piMap fun i => (pairing (v i)).ker.subtype)

@[simp] theorem orthogonalTangentMap_apply (v : ∀ i, σ i → R)
    (w : ∀ i, (pairing (v i)).ker) :
    orthogonalTangentMap v w = tangentMap v (fun i => (w i : σ i → R)) := rfl

/-- Scalar rescalings compatible with both orthogonality and zero total rescaling. -/
def scalarRelations (v : ∀ i, σ i → R) : Submodule R (ι → R) where
  carrier := {a | (∑ i, a i) = 0 ∧ ∀ i, a i * quadraticNorm (v i) = 0}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    constructor
    · simpa only [Pi.add_apply, Finset.sum_add_distrib, ha.1, hb.1, add_zero]
    · intro i
      simp only [Pi.add_apply, add_mul, ha.2 i, hb.2 i, add_zero]
  smul_mem' := by
    intro c a ha
    constructor
    · simp only [Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum, ha.1, mul_zero]
    · intro i
      simp only [Pi.smul_apply, smul_eq_mul, mul_assoc, ha.2 i, mul_zero]

/-- An explicit linear equivalence for the full orthogonal tangent kernel.
This remains valid in characteristic two and on every isotropic stratum. -/
def orthogonalKernelEquiv (v : ∀ i, σ i → R)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) = 1) :
    (orthogonalTangentMap v).ker ≃ₗ[R] scalarRelations v where
  toFun w := ⟨fun i => (w.1 i : σ i → R) (p i), by
    constructor
    · have hw : tangentMap v (fun i => (w.1 i : σ i → R)) = 0 := w.2
      simpa only [tangent_at_pivot v p hp, Pi.zero_apply] using congrFun hw p
    · intro i
      have hw : tangentMap v (fun i => (w.1 i : σ i → R)) = 0 := w.2
      have he : (w.1 i : σ i → R) =
          (w.1 i : σ i → R) (p i) • v i := by
        funext x
        exact tangent_kernel_pointwise v p hp _ hw i x
      have hm : pairing (v i) (w.1 i : σ i → R) = 0 := (w.1 i).2
      rw [he, pairing_smul_self] at hm
      exact hm⟩
  invFun a := ⟨fun i => ⟨a.1 i • v i, by
      change pairing (v i) (a.1 i • v i) = 0
      rw [pairing_smul_self]
      exact a.2.2 i⟩, by
    change tangentMap v (fun i => a.1 i • v i) = 0
    exact (tangent_eq_zero_iff v p hp _).mpr
      ⟨a.1, a.2.1, fun _ _ => rfl⟩⟩
  left_inv w := by
    apply Subtype.ext
    funext i
    apply Subtype.ext
    funext x
    exact (tangent_kernel_pointwise v p hp
      (fun j => (w.1 j : σ j → R)) w.2 i x).symm
  right_inv a := by
    apply Subtype.ext
    funext i
    change a.1 i * v i (p i) = a.1 i
    rw [hp i, mul_one]
  map_add' a b := by
    apply Subtype.ext
    funext i
    rfl
  map_smul' c a := by
    apply Subtype.ext
    funext i
    rfl

end Orthogonal

end PaperVerification.Segre.TangentKernel
end SegreTangentKernel

section SegreIsotropicRank
set_option autoImplicit false


/-!
# Dimensions of the Segre incidence kernels on isotropic strata

The kernel description is transferred to the kernel of the ordinary summation
map on the set of isotropic factors.  Thus a nonempty isotropic set of size a
contributes exactly a - 1 relations, in every characteristic.

-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.TangentKernel

variable {K : Type*} [Field K]

def summation (J : Type*) [Fintype J] : (J → K) →ₗ[K] K where
  toFun a := ∑ j, a j
  map_add' a b := by simp only [Pi.add_apply, Finset.sum_add_distrib]
  map_smul' c a := by simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum, RingHom.id_apply]

theorem finrank_ker_summation (J : Type*) [Fintype J] :
    Module.finrank K (summation (K := K) J).ker = Fintype.card J - 1 := by
  classical
  by_cases h : Nonempty J
  · obtain ⟨j⟩ := h
    have hs : Function.Surjective (summation (K := K) J) := by
      intro c
      refine ⟨Pi.single j c, ?_⟩
      simp [summation]
    have hr := (summation (K := K) J).finrank_range_add_finrank_ker
    rw [LinearMap.range_eq_top.mpr hs, finrank_top,
      Module.finrank_self, Module.finrank_pi] at hr
    omega
  · letI : IsEmpty J := not_nonempty_iff.mp h
    have hl := (summation (K := K) J).ker.finrank_le
    have hz : Module.finrank K (J → K) = 0 := by
      rw [Module.finrank_pi, Fintype.card_eq_zero]
    rw [hz] at hl
    have hk := Nat.eq_zero_of_le_zero hl
    simp only [hk, Fintype.card_eq_zero, Nat.zero_sub]

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]

abbrev IsotropicFactor (v : ∀ i, σ i → K) :=
  {i : ι // quadraticNorm (v i) = 0}

instance (v : ∀ i, σ i → K) : Fintype (IsotropicFactor v) := by
  classical
  exact Subtype.fintype _

def extendIsotropic (v : ∀ i, σ i → K) (a : IsotropicFactor v → K) : ι → K := by
  classical
  exact fun i => if h : quadraticNorm (v i) = 0 then a ⟨i, h⟩ else 0

@[simp] theorem extendIsotropic_on (v : ∀ i, σ i → K)
    (a : IsotropicFactor v → K) (i : IsotropicFactor v) :
    extendIsotropic v a i = a i := by
  classical
  simp only [extendIsotropic, dif_pos i.2]

@[simp] theorem extendIsotropic_off (v : ∀ i, σ i → K)
    (a : IsotropicFactor v → K) (i : ι) (hi : quadraticNorm (v i) ≠ 0) :
    extendIsotropic v a i = 0 := by
  classical
  simp only [extendIsotropic, dif_neg hi]

theorem sum_extendIsotropic (v : ∀ i, σ i → K)
    (a : IsotropicFactor v → K) :
    (∑ i, extendIsotropic v a i) = ∑ i, a i := by
  classical
  apply Finset.sum_congr_set {i | quadraticNorm (v i) = 0}
  · intro i hi
    exact extendIsotropic_on v a ⟨i, hi⟩
  · intro i hi
    exact extendIsotropic_off v a i hi

theorem scalar_relation_off (v : ∀ i, σ i → K) (a : scalarRelations v)
    (i : ι) (hi : quadraticNorm (v i) ≠ 0) : a.1 i = 0 :=
  (mul_eq_zero.mp (a.2.2 i)).resolve_right hi

theorem sum_restrict_scalarRelation (v : ∀ i, σ i → K)
    (a : scalarRelations v) :
    (∑ i : IsotropicFactor v, a.1 i) = 0 := by
  classical
  have he : (∑ i, a.1 i) = ∑ i : IsotropicFactor v, a.1 i := by
    apply Finset.sum_congr_set {i | quadraticNorm (v i) = 0}
    · intro _ _
      rfl
    · intro i hi
      exact scalar_relation_off v a i hi
  exact he.symm.trans a.2.1

/-- Scalar relations are exactly zero-sum functions on the isotropic factors. -/
def scalarRelationsEquivSumKernel (v : ∀ i, σ i → K) :
    scalarRelations v ≃ₗ[K] (summation (K := K) (IsotropicFactor v)).ker := by
  classical
  exact
    { toFun := fun a => ⟨fun i => a.1 i, by
        change (∑ i : IsotropicFactor v, a.1 i) = 0
        exact sum_restrict_scalarRelation v a⟩
      invFun := fun a => ⟨extendIsotropic v a.1, by
        constructor
        · rw [sum_extendIsotropic]
          exact a.2
        · intro i
          by_cases hi : quadraticNorm (v i) = 0
          · rw [hi, mul_zero]
          · rw [extendIsotropic_off v a.1 i hi, zero_mul]⟩
      left_inv := by
        intro a
        apply Subtype.ext
        funext i
        change extendIsotropic v (fun i => a.1 i) i = a.1 i
        by_cases hi : quadraticNorm (v i) = 0
        · exact extendIsotropic_on v (fun i => a.1 i) ⟨i, hi⟩
        · rw [extendIsotropic_off v _ i hi, scalar_relation_off v a i hi]
      right_inv := by
        intro a
        apply Subtype.ext
        funext i
        exact extendIsotropic_on v a.1 i
      map_add' := by
        intro a b
        apply Subtype.ext
        funext i
        rfl
      map_smul' := by
        intro c a
        apply Subtype.ext
        funext i
        rfl }

theorem finrank_scalarRelations (v : ∀ i, σ i → K) :
    Module.finrank K (scalarRelations v) = Fintype.card (IsotropicFactor v) - 1 := by
  rw [(scalarRelationsEquivSumKernel v).finrank_eq]
  exact finrank_ker_summation (IsotropicFactor v)

/-- The exact kernel dimension, including both the nonisotropic and isotropic strata. -/
theorem finrank_orthogonalTangent_kernel
    (v : ∀ i, σ i → K) (p : ∀ i, σ i)
    (hp : ∀ i, v i (p i) = 1) :
    Module.finrank K (orthogonalTangentMap v).ker =
      Fintype.card (IsotropicFactor v) - 1 := by
  rw [(orthogonalKernelEquiv v p hp).finrank_eq, finrank_scalarRelations]

/-- Rank-nullity for the actual insertion operator, with its exact isotropic correction. -/
theorem finrank_orthogonalTangent_range
    (v : ∀ i, σ i → K) (p : ∀ i, σ i)
    (hp : ∀ i, v i (p i) = 1) :
    Module.finrank K (orthogonalTangentMap v).range =
      (∑ i, Module.finrank K (pairing (v i)).ker) -
        (Fintype.card (IsotropicFactor v) - 1) := by
  have h := (orthogonalTangentMap v).finrank_range_add_finrank_ker
  rw [Module.finrank_pi_fintype,
    finrank_orthogonalTangent_kernel v p hp] at h
  omega

end PaperVerification.Segre.TangentKernel
end SegreIsotropicRank

section SegreSingularIncidenceRank
set_option autoImplicit false


/-!
# The actual singular-vector incidence operator

The incidence operator is the transpose of the orthogonal insertion map under
the coordinate pairing.  Its kernel is proved to be exactly the tensors whose
contraction in every factor is proportional to that factor vector.  This
identification is proved on ordinary projective charts, including isotropic
points, and does not use division by two.

-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.TangentKernel

section Pairing

variable {R : Type*} [CommRing R]
variable {S : Type*} [Fintype S]

def testVector (v : S → R) (p a : S) : S → R := by
  classical
  exact Pi.single a 1 - v a • Pi.single p 1

theorem pairing_testVector (c v : S → R) (p a : S) :
    pairing c (testVector v p a) = c a - v a * c p := by
  classical
  simp [pairing, testVector, mul_sub, Finset.sum_sub_distrib,
    Finset.mul_sum, Pi.single_apply, mul_comm, mul_left_comm, mul_assoc]

theorem testVector_mem (v : S → R) (p : S) (hp : v p = 1) (a : S) :
    testVector v p a ∈ (pairing v).ker := by
  change pairing v (testVector v p a) = 0
  rw [pairing_testVector, hp, mul_one, sub_self]

theorem pairing_smul_left (v w : S → R) (c : R) :
    pairing (c • v) w = c * pairing v w := by
  change (∑ a, (c * v a) * w a) = c * ∑ a, v a * w a
  simp only [Finset.mul_sum, mul_assoc]

/-- The double orthogonality statement with an explicit scalar, over any ring
on the normalized chart. -/
theorem annihilates_perpendicular_iff (v c : S → R)
    (p : S) (hp : v p = 1) :
    (∀ w : (pairing v).ker, pairing c w = 0) ↔ ∃ a : R, c = a • v := by
  constructor
  · intro h
    refine ⟨c p, ?_⟩
    funext a
    have ha := h ⟨testVector v p a, testVector_mem v p hp a⟩
    rw [pairing_testVector] at ha
    exact (sub_eq_zero.mp ha).trans (mul_comm _ _)
  · rintro ⟨a, rfl⟩ w
    rw [pairing_smul_left]
    have hw : pairing v (w : S → R) = 0 := w.2
    rw [hw, mul_zero]

end Pairing

section Incidence

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]
variable {R : Type*} [CommRing R]

/-- The ordinary contraction, with its coordinates written as a fibre sum. -/
def contraction (v : ∀ i, σ i → R) (T : (∀ i, σ i) → R)
    (i : ι) (x : σ i) : R := by
  classical
  exact ∑ a : (∀ i, σ i),
    if a i = x then T a * otherProduct v i a else 0

theorem pairing_contraction (v : ∀ i, σ i → R) (T : (∀ i, σ i) → R)
    (i : ι) (w : σ i → R) :
    pairing (contraction v T i) w =
      ∑ a : (∀ i, σ i), w (a i) * T a * otherProduct v i a := by
  classical
  change (∑ x, (∑ a, if a i = x then T a * otherProduct v i a else 0) * w x) =
    ∑ a, w (a i) * T a * otherProduct v i a
  simp_rw [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  simp [ite_mul, mul_comm, mul_left_comm, mul_assoc]

/-- The exact coordinate identification with the algebraic dual. -/
def coordinateDualEquiv (S : Type*) [Fintype S] :
    (S → R) ≃ₗ[R] Module.Dual R (S → R) := by
  classical
  exact (LinearEquiv.piRing R R S R).symm

@[simp] theorem coordinateDualEquiv_apply (S : Type*) [Fintype S]
    (T w : S → R) :
    coordinateDualEquiv (R := R) S T w = ∑ a, w a * T a := by
  classical
  simp only [coordinateDualEquiv, LinearEquiv.piRing_symm_apply, smul_eq_mul]

/-- The actual linear constraints defining singular-vector incidence at v.
The target is the dual of the product of the orthogonal hyperplanes. -/
def singularIncidenceMap (v : ∀ i, σ i → R) :
    ((∀ i, σ i) → R) →ₗ[R]
      Module.Dual R (∀ i, (pairing (v i)).ker) :=
  (orthogonalTangentMap v).dualMap.comp
    (coordinateDualEquiv (R := R) (∀ i, σ i)).toLinearMap

theorem singularIncidenceMap_apply (v : ∀ i, σ i → R)
    (T : (∀ i, σ i) → R) (w : ∀ i, (pairing (v i)).ker) :
    singularIncidenceMap v T w = ∑ i, pairing (contraction v T i) (w i) := by
  change coordinateDualEquiv (R := R) (∀ i, σ i) T
      (orthogonalTangentMap v w) = _
  rw [coordinateDualEquiv_apply, orthogonalTangentMap_apply]
  simp only [tangentMap_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  rw [pairing_contraction]
  apply Finset.sum_congr rfl
  intro a _
  exact (mul_right_comm _ _ _)

theorem singularIncidenceMap_apply_single (v : ∀ i, σ i → R)
    (T : (∀ i, σ i) → R) (i : ι) (w : (pairing (v i)).ker) :
    singularIncidenceMap v T (Pi.single i w) =
      pairing (contraction v T i) w := by
  classical
  rw [singularIncidenceMap_apply]
  calc
    (∑ j, pairing (contraction v T j)
        ((Pi.single i w : ∀ j, (pairing (v j)).ker) j)) =
        pairing (contraction v T i)
          ((Pi.single i w : ∀ j, (pairing (v j)).ker) i) := by
      apply Finset.sum_eq_single i
      · intro j _ hji
        simp only [Pi.single_eq_of_ne hji, Submodule.coe_zero, map_zero]
      · intro hi
        exact (hi (Finset.mem_univ i)).elim
    _ = pairing (contraction v T i) w := by rw [Pi.single_eq_same]

/-- Faithfulness: the kernel is the paper's contraction-proportionality condition,
with the original tensor and all its factor contractions. -/
theorem singularIncidenceMap_eq_zero_iff
    (v : ∀ i, σ i → R) (T : (∀ i, σ i) → R)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) = 1) :
    singularIncidenceMap v T = 0 ↔
      ∀ i, ∃ a : R, contraction v T i = a • v i := by
  classical
  constructor
  · intro h i
    apply (annihilates_perpendicular_iff (v i) (contraction v T i) (p i) (hp i)).mp
    intro w
    have hh := congrArg (fun f : Module.Dual R (∀ i, (pairing (v i)).ker) =>
      f (Pi.single i w)) h
    simpa only [singularIncidenceMap_apply_single, LinearMap.zero_apply] using hh
  · intro h
    apply LinearMap.ext
    intro w
    rw [singularIncidenceMap_apply, LinearMap.zero_apply]
    apply Finset.sum_eq_zero
    intro i _
    exact (annihilates_perpendicular_iff
      (v i) (contraction v T i) (p i) (hp i)).mpr (h i) (w i)

end Incidence

section Dimensions

variable {K : Type*} [Field K]
variable {S : Type*} [Fintype S]

theorem finrank_pairing_kernel (v : S → K) (p : S) (hp : v p = 1) :
    Module.finrank K (pairing v).ker = Fintype.card S - 1 := by
  classical
  have hs : Function.Surjective (pairing v) := by
    intro c
    refine ⟨Pi.single p c, ?_⟩
    simp [pairing, Pi.single_apply, hp]
  have h := (pairing v).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hs, finrank_top,
    Module.finrank_self, Module.finrank_pi] at h
  omega

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]

theorem finrank_singularIncidence_range (v : ∀ i, σ i → K)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) = 1) :
    Module.finrank K (singularIncidenceMap v).range =
      (∑ i, (Fintype.card (σ i) - 1)) -
        (Fintype.card (IsotropicFactor v) - 1) := by
  unfold singularIncidenceMap
  rw [LinearMap.range_comp_of_range_eq_top _
    (coordinateDualEquiv (R := K) (∀ i, σ i)).range]
  rw [LinearMap.finrank_range_dualMap_eq_finrank_range,
    finrank_orthogonalTangent_range v p hp]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  exact finrank_pairing_kernel (v i) (p i) (hp i)

/-- The dimension of the tensor solution space, not merely a bound on a
hypothetical family of equations. -/
theorem finrank_singularIncidence_kernel (v : ∀ i, σ i → K)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) = 1) :
    Module.finrank K (singularIncidenceMap v).ker =
      (∏ i, Fintype.card (σ i)) -
        ((∑ i, (Fintype.card (σ i) - 1)) -
          (Fintype.card (IsotropicFactor v) - 1)) := by
  have h := (singularIncidenceMap v).finrank_range_add_finrank_ker
  rw [finrank_singularIncidence_range v p hp,
    Module.finrank_pi, Fintype.card_pi] at h
  omega

end Dimensions

end PaperVerification.Segre.TangentKernel
end SegreSingularIncidenceRank

section SegreTangentNormalization
set_option autoImplicit false


/-!
# Removing normalized-coordinate assumptions from the incidence calculation

Every nonzero factor vector admits a pivot with nonzero coefficient.  Scaling
by that coefficient transfers the tangent-kernel calculation to a normalized
chart.  The final statements quantify over arbitrary nonzero factor vectors.

-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.TangentKernel

variable {K : Type*} [Field K]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*}

def normalizeFamily (v : ∀ i, σ i → K) (p : ∀ i, σ i)
    (w : ∀ i, σ i → K) : ∀ i, σ i → K :=
  fun i x => (v i (p i))⁻¹ * w i x

def normalizationFactor (v : ∀ i, σ i → K) (p : ∀ i, σ i) : K :=
  ∏ i, (v i (p i))⁻¹

theorem normalizeFamily_pivot (v : ∀ i, σ i → K) (p : ∀ i, σ i)
    (hp : ∀ i, v i (p i) ≠ 0) (i : ι) :
    normalizeFamily v p v i (p i) = 1 := by
  exact inv_mul_cancel₀ (hp i)

theorem tangentMap_normalizeFamily (v w : ∀ i, σ i → K) (p : ∀ i, σ i) :
    tangentMap (normalizeFamily v p v) (normalizeFamily v p w) =
      normalizationFactor v p • tangentMap v w := by
  funext a
  change (∑ i, normalizeFamily v p w i (a i) *
      otherProduct (normalizeFamily v p v) i a) =
    normalizationFactor v p * ∑ i, w i (a i) * otherProduct v i a
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  have hd := Finset.mul_prod_erase Finset.univ
    (fun j => (v j (p j))⁻¹) (Finset.mem_univ i)
  simp only [normalizeFamily, otherProduct, Finset.prod_mul_distrib]
  change ((v i (p i))⁻¹ * w i (a i)) *
      ((∏ j ∈ Finset.univ.erase i, (v j (p j))⁻¹) *
        ∏ j ∈ Finset.univ.erase i, v j (a j)) =
    normalizationFactor v p *
      (w i (a i) * ∏ j ∈ Finset.univ.erase i, v j (a j))
  rw [← show (v i (p i))⁻¹ *
      (∏ j ∈ Finset.univ.erase i, (v j (p j))⁻¹) =
        normalizationFactor v p from hd]
  ring

/-- The full tangent-kernel theorem for arbitrary nonzero pivots. -/
theorem tangent_eq_zero_iff_of_ne_zero (v w : ∀ i, σ i → K)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) ≠ 0) :
    tangentMap v w = 0 ↔
      ∃ a : ι → K, (∑ i, a i) = 0 ∧ ∀ i x, w i x = a i * v i x := by
  constructor
  · intro h
    have hn : tangentMap (normalizeFamily v p v) (normalizeFamily v p w) = 0 := by
      rw [tangentMap_normalizeFamily, h, smul_zero]
    obtain ⟨a, ha, hw⟩ :=
      (tangent_eq_zero_iff (normalizeFamily v p v) p
        (normalizeFamily_pivot v p hp) (normalizeFamily v p w)).mp hn
    refine ⟨a, ha, ?_⟩
    intro i x
    apply mul_left_cancel₀ (inv_ne_zero (hp i))
    calc
      (v i (p i))⁻¹ * w i x = a i * ((v i (p i))⁻¹ * v i x) := hw i x
      _ = (v i (p i))⁻¹ * (a i * v i x) := by ring
  · rintro ⟨a, ha, hw⟩
    funext b
    change (∑ i, w i (b i) * otherProduct v i b) = 0
    calc
      (∑ i, w i (b i) * otherProduct v i b) =
          ∑ i, a i * pureTensor v b := by
        apply Finset.sum_congr rfl
        intro i _
        rw [hw, mul_assoc, coefficient_mul_otherProduct]
      _ = (∑ i, a i) * pureTensor v b := by rw [Finset.sum_mul]
      _ = 0 := by rw [ha, zero_mul]

theorem tangent_kernel_pointwise_of_ne_zero (v w : ∀ i, σ i → K)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) ≠ 0)
    (hw : tangentMap v w = 0) (i : ι) (x : σ i) :
    w i x = ((v i (p i))⁻¹ * w i (p i)) * v i x := by
  obtain ⟨a, _, ha⟩ := (tangent_eq_zero_iff_of_ne_zero v w p hp).mp hw
  rw [ha i x, ha i (p i)]
  have hc : (v i (p i))⁻¹ * (a i * v i (p i)) = a i := by
    rw [mul_left_comm, inv_mul_cancel₀ (hp i), mul_one]
  rw [hc]

theorem exists_nonzero_pivots (v : ∀ i, σ i → K)
    (hv : ∀ i, v i ≠ 0) :
    ∃ p : ∀ i, σ i, ∀ i, v i (p i) ≠ 0 := by
  classical
  have h : ∀ i, ∃ x, v i x ≠ 0 := by
    intro i
    by_contra hn
    apply hv i
    funext x
    exact not_ne_iff.mp ((not_exists.mp hn) x)
  choose p hp using h
  exact ⟨p, hp⟩

section Orthogonal

variable [∀ i, Fintype (σ i)]

def orthogonalKernelEquivOfNeZero (v : ∀ i, σ i → K)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) ≠ 0) :
    (orthogonalTangentMap v).ker ≃ₗ[K] scalarRelations v where
  toFun w := ⟨fun i => (v i (p i))⁻¹ * (w.1 i : σ i → K) (p i), by
    have hw : tangentMap v (fun i => (w.1 i : σ i → K)) = 0 := w.2
    obtain ⟨a, ha, he⟩ :=
      (tangent_eq_zero_iff_of_ne_zero v _ p hp).mp hw
    have hc (i : ι) :
        (v i (p i))⁻¹ * (w.1 i : σ i → K) (p i) = a i := by
      rw [he i (p i), mul_left_comm, inv_mul_cancel₀ (hp i), mul_one]
    constructor
    · simpa only [hc] using ha
    · intro i
      have hi : (w.1 i : σ i → K) = a i • v i := by
        funext x
        exact he i x
      have hm : pairing (v i) (w.1 i : σ i → K) = 0 := (w.1 i).2
      rw [hi, pairing_smul_self] at hm
      simpa only [hc] using hm⟩
  invFun a := ⟨fun i => ⟨a.1 i • v i, by
      change pairing (v i) (a.1 i • v i) = 0
      rw [pairing_smul_self]
      exact a.2.2 i⟩, by
    change tangentMap v (fun i => a.1 i • v i) = 0
    exact (tangent_eq_zero_iff_of_ne_zero v _ p hp).mpr
      ⟨a.1, a.2.1, fun _ _ => rfl⟩⟩
  left_inv w := by
    apply Subtype.ext
    funext i
    apply Subtype.ext
    funext x
    exact (tangent_kernel_pointwise_of_ne_zero v
      (fun j => (w.1 j : σ j → K)) p hp w.2 i x).symm
  right_inv a := by
    apply Subtype.ext
    funext i
    change (v i (p i))⁻¹ * (a.1 i * v i (p i)) = a.1 i
    rw [mul_left_comm, inv_mul_cancel₀ (hp i), mul_one]
  map_add' a b := by
    apply Subtype.ext
    funext i
    exact mul_add _ _ _
  map_smul' c a := by
    apply Subtype.ext
    funext i
    exact mul_left_comm _ _ _

theorem finrank_orthogonalTangent_kernel_of_nonzero
    (v : ∀ i, σ i → K) (hv : ∀ i, v i ≠ 0) :
    Module.finrank K (orthogonalTangentMap v).ker =
      Fintype.card (IsotropicFactor v) - 1 := by
  obtain ⟨p, hp⟩ := exists_nonzero_pivots v hv
  rw [(orthogonalKernelEquivOfNeZero v p hp).finrank_eq, finrank_scalarRelations]

end Orthogonal

section SingleFactor

variable {S : Type*} [Fintype S]

def scaledTestVector (v : S → K) (p a : S) : S → K := by
  classical
  exact v p • Pi.single a 1 - v a • Pi.single p 1

theorem pairing_scaledTestVector (c v : S → K) (p a : S) :
    pairing c (scaledTestVector v p a) = v p * c a - v a * c p := by
  classical
  simp [pairing, scaledTestVector, mul_sub, Finset.sum_sub_distrib,
    Finset.mul_sum, Pi.single_apply, mul_comm, mul_left_comm, mul_assoc]

theorem scaledTestVector_mem (v : S → K) (p a : S) :
    scaledTestVector v p a ∈ (pairing v).ker := by
  change pairing v (scaledTestVector v p a) = 0
  rw [pairing_scaledTestVector, mul_comm (v p), sub_self]

theorem annihilates_perpendicular_iff_of_ne_zero (v c : S → K)
    (p : S) (hp : v p ≠ 0) :
    (∀ w : (pairing v).ker, pairing c w = 0) ↔ ∃ a : K, c = a • v := by
  constructor
  · intro h
    refine ⟨(v p)⁻¹ * c p, ?_⟩
    funext a
    have ha := h ⟨scaledTestVector v p a, scaledTestVector_mem v p a⟩
    rw [pairing_scaledTestVector] at ha
    apply mul_left_cancel₀ hp
    change v p * c a = v p * (((v p)⁻¹ * c p) * v a)
    rw [sub_eq_zero] at ha
    calc
      v p * c a = v a * c p := ha
      _ = v p * (((v p)⁻¹ * c p) * v a) := by
        rw [← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hp, one_mul, mul_comm]
  · rintro ⟨a, rfl⟩ w
    rw [pairing_smul_left]
    have hw : pairing v (w : S → K) = 0 := w.2
    rw [hw, mul_zero]

theorem finrank_pairing_kernel_of_ne_zero (v : S → K) (p : S) (hp : v p ≠ 0) :
    Module.finrank K (pairing v).ker = Fintype.card S - 1 := by
  classical
  have hs : Function.Surjective (pairing v) := by
    intro c
    refine ⟨Pi.single p ((v p)⁻¹ * c), ?_⟩
    simp [pairing, Pi.single_apply, ← mul_assoc, hp]
  have h := (pairing v).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hs, finrank_top,
    Module.finrank_self, Module.finrank_pi] at h
  omega

end SingleFactor

section Global

variable [∀ i, Fintype (σ i)]

theorem singularIncidenceMap_eq_zero_iff_of_nonzero
    (v : ∀ i, σ i → K) (T : (∀ i, σ i) → K)
    (hv : ∀ i, v i ≠ 0) :
    singularIncidenceMap v T = 0 ↔
      ∀ i, ∃ a : K, contraction v T i = a • v i := by
  classical
  obtain ⟨p, hp⟩ := exists_nonzero_pivots v hv
  constructor
  · intro h i
    apply (annihilates_perpendicular_iff_of_ne_zero
      (v i) (contraction v T i) (p i) (hp i)).mp
    intro w
    have hh := congrArg (fun f : Module.Dual K (∀ i, (pairing (v i)).ker) =>
      f (Pi.single i w)) h
    simpa only [singularIncidenceMap_apply_single, LinearMap.zero_apply] using hh
  · intro h
    apply LinearMap.ext
    intro w
    rw [singularIncidenceMap_apply, LinearMap.zero_apply]
    apply Finset.sum_eq_zero
    intro i _
    exact (annihilates_perpendicular_iff_of_ne_zero
      (v i) (contraction v T i) (p i) (hp i)).mpr (h i) (w i)

theorem finrank_singularIncidence_range_of_nonzero
    (v : ∀ i, σ i → K) (hv : ∀ i, v i ≠ 0) :
    Module.finrank K (singularIncidenceMap v).range =
      (∑ i, (Fintype.card (σ i) - 1)) -
        (Fintype.card (IsotropicFactor v) - 1) := by
  obtain ⟨p, hp⟩ := exists_nonzero_pivots v hv
  have h := (orthogonalTangentMap v).finrank_range_add_finrank_ker
  rw [finrank_orthogonalTangent_kernel_of_nonzero v hv,
    Module.finrank_pi_fintype] at h
  have hdim : (∑ i, Module.finrank K (pairing (v i)).ker) =
      ∑ i, (Fintype.card (σ i) - 1) := by
    apply Finset.sum_congr rfl
    intro i _
    exact finrank_pairing_kernel_of_ne_zero (v i) (p i) (hp i)
  rw [hdim] at h
  unfold singularIncidenceMap
  rw [LinearMap.range_comp_of_range_eq_top _
    (coordinateDualEquiv (R := K) (∀ i, σ i)).range,
    LinearMap.finrank_range_dualMap_eq_finrank_range]
  omega

theorem finrank_singularIncidence_kernel_of_nonzero
    (v : ∀ i, σ i → K) (hv : ∀ i, v i ≠ 0) :
    Module.finrank K (singularIncidenceMap v).ker =
      (∏ i, Fintype.card (σ i)) -
        ((∑ i, (Fintype.card (σ i) - 1)) -
          (Fintype.card (IsotropicFactor v) - 1)) := by
  have h := (singularIncidenceMap v).finrank_range_add_finrank_ker
  rw [finrank_singularIncidence_range_of_nonzero v hv,
    Module.finrank_pi, Fintype.card_pi] at h
  omega

end Global

end PaperVerification.Segre.TangentKernel
end SegreTangentNormalization

section SegreCriticalChart
set_option autoImplicit false


/-!
# Literal critical equations and a separable point in every tensor format

The variables are affine coordinates on a product of projective charts. The
polynomial equations below are exactly the contraction-proportionality equations,
not an abstract replacement for the singular-vector scheme. At the coordinate
pure tensor they are the negatives of the chart coordinates. Thus their full
Jacobian is minus the identity in every characteristic, including two.

-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.CriticalChart

open TangentKernel MvPolynomial

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]
variable {R : Type*} [CommRing R]

abbrev Coordinate := Sigma σ
abbrev TensorCell := ∀ i, Option (σ i)

/-- Normalized affine coordinates, with the distinguished coordinate equal to one. -/
def chartVector (i : ι) : Option (σ i) → MvPolynomial (Coordinate (σ := σ)) R
  | none => 1
  | some a => X ⟨i, a⟩

def pointVector (x : Coordinate (σ := σ) → R) (i : ι) : Option (σ i) → R
  | none => 1
  | some a => x ⟨i, a⟩

@[simp] theorem eval_chartVector (x : Coordinate (σ := σ) → R)
    (i : ι) (a : Option (σ i)) :
    eval x (chartVector (R := R) i a) = pointVector x i a := by
  cases a <;> simp [chartVector, pointVector]

/-- The actual contraction as a polynomial in the projective chart coordinates. -/
def chartContraction (T : TensorCell (σ := σ) → R) (i : ι) (a : Option (σ i)) :
    MvPolynomial (Coordinate (σ := σ)) R :=
  contraction (chartVector (R := R)) (fun b => C (T b)) i a

theorem eval_chartContraction (T : TensorCell (σ := σ) → R)
    (x : Coordinate (σ := σ) → R) (i : ι) (a : Option (σ i)) :
    eval x (chartContraction T i a) = contraction (pointVector x) T i a := by
  classical
  unfold chartContraction contraction
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro b _
  by_cases hb : b i=a
  · simp only [if_pos hb,map_mul,eval_C,otherProduct,map_prod,eval_chartVector]
  · simp only [if_neg hb,map_zero]

/-- The pivot coordinate has been used to eliminate the proportionality scalar. -/
def criticalEquation (T : TensorCell (σ := σ) → R) (q : Coordinate (σ := σ)) :
    MvPolynomial (Coordinate (σ := σ)) R :=
  chartContraction T q.1 (some q.2) - X q * chartContraction T q.1 none

theorem eval_criticalEquation (T : TensorCell (σ := σ) → R)
    (x : Coordinate (σ := σ) → R) (q : Coordinate (σ := σ)) :
    eval x (criticalEquation T q) =
      contraction (pointVector x) T q.1 (some q.2) -
        x q * contraction (pointVector x) T q.1 none := by
  simp [criticalEquation, eval_chartContraction]

/-- Exact equivalence with the tensor incidence operator, over every commutative ring. -/
theorem criticalEquations_iff_incidence (T : TensorCell (σ := σ) → R)
    (x : Coordinate (σ := σ) → R) :
    (∀ q, eval x (criticalEquation T q) = 0) ↔
      singularIncidenceMap (pointVector x) T = 0 := by
  classical
  rw [singularIncidenceMap_eq_zero_iff (pointVector x) T (fun _ => none)
    (fun _ => rfl)]
  constructor
  · intro h i
    refine ⟨contraction (pointVector x) T i none, ?_⟩
    funext a
    cases a with
    | none => simp [pointVector]
    | some a =>
        have ha := h ⟨i, a⟩
        rw [eval_criticalEquation] at ha
        have he := sub_eq_zero.mp ha
        simpa only [Pi.smul_apply, smul_eq_mul, pointVector, mul_comm] using he
  · intro h q
    obtain ⟨c, hc⟩ := h q.1
    have hnone := congrFun hc none
    have hsome := congrFun hc (some q.2)
    simp only [Pi.smul_apply, smul_eq_mul, pointVector, mul_one] at hnone hsome
    rw [eval_criticalEquation, hnone, hsome, mul_comm, sub_self]

def originCell : TensorCell (σ := σ) := fun _ => none

def originTensor : TensorCell (σ := σ) → R := by
  classical
  exact Pi.single originCell 1

/-- Computing the complete contraction, not just its value at one chart point. -/
theorem chartContraction_originTensor (i : ι) (a : Option (σ i)) :
    chartContraction (originTensor (R := R) (σ := σ)) i a =
      if a = none then 1 else 0 := by
  classical
  unfold chartContraction contraction
  rw [Finset.sum_eq_single (originCell (σ := σ))]
  · cases a <;> simp [originCell, originTensor, otherProduct, chartVector]
  · intro b _ hb
    simp [originTensor, Pi.single_eq_of_ne hb]
  · intro h
    exact (h (Finset.mem_univ _)).elim

@[simp] theorem criticalEquation_originTensor (q : Coordinate (σ := σ)) :
    criticalEquation (originTensor (R := R) (σ := σ)) q = -X q := by
  simp [criticalEquation, chartContraction_originTensor]

/-- The actual Jacobian in all chart directions. -/
def chartJacobian (T : TensorCell (σ := σ) → R) (x : Coordinate (σ := σ) → R) :
    Matrix (Coordinate (σ := σ)) (Coordinate (σ := σ)) R :=
  fun q r => eval x (pderiv r (criticalEquation T q))

theorem chartJacobian_originTensor (x : Coordinate (σ := σ) → R) :
    chartJacobian (originTensor (R := R) (σ := σ)) x = -1 := by
  classical
  ext q r
  by_cases h : q = r
  · subst r
    simp [chartJacobian, Matrix.one_apply]
  · simp [chartJacobian, Matrix.one_apply, h, Ne.symm h]

theorem isUnit_chartJacobian_originTensor (x : Coordinate (σ := σ) → R) :
    IsUnit (chartJacobian (originTensor (R := R) (σ := σ)) x).det := by
  classical
  rw [chartJacobian_originTensor, Matrix.det_neg, Matrix.det_one, mul_one]
  exact isUnit_neg_one.pow _

theorem chartJacobian_originTensor_ne_zero [Nontrivial R]
    (x : Coordinate (σ := σ) → R) :
    (chartJacobian (originTensor (R := R) (σ := σ)) x).det ≠ 0 :=
  (isUnit_chartJacobian_originTensor x).ne_zero

/-- Every finite tensor format has a literal critical point with invertible full
Jacobian. No characteristic or parity restriction is imposed. -/
theorem exists_critical_point_isUnit_jacobian :
    ∃ (T : TensorCell (σ := σ) → R) (x : Coordinate (σ := σ) → R),
      (∀ q, eval x (criticalEquation T q) = 0) ∧ IsUnit (chartJacobian T x).det := by
  refine ⟨originTensor, 0, ?_, isUnit_chartJacobian_originTensor 0⟩
  intro q
  simp

end PaperVerification.Segre.CriticalChart
end SegreCriticalChart

section SegreJacobianReduced
set_option autoImplicit false


/-!
# Actual square Jacobian presentations give finite reduced fibers

For a literal square family of polynomials, the determinant is taken from
the actual matrix of partial derivatives. If its image is a unit in the
actual polynomial quotient, the canonical presentation is standard smooth
of relative dimension zero, hence etale. Over every field this makes the
quotient finite dimensional and reduced. Over an algebraically closed field
it is canonically a product of copies of the field indexed by its actual
prime spectrum.

There is no regularity, reducedness, finiteness, or genericity premise.
The determinant-unit hypothesis is explicit and must be established for the
critical fibers before these results apply.
-/

set_option autoImplicit false
open scoped Classical

namespace PaperVerification.Segre.JacobianReduced

open Algebra MvPolynomial

universe u v
variable {R : Type u} [CommRing R] {σ : Type v} [Fintype σ] [DecidableEq σ]

/-- The actual ideal of the whole square polynomial system. -/
def equationIdeal (f : σ → MvPolynomial σ R) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range f)

/-- The actual coordinate ring, retaining all nilpotents until reducedness
is proved. -/
abbrev CoordinateRing (f : σ → MvPolynomial σ R) :=
  MvPolynomial σ R ⧸ equationIdeal f

/-- The literal square Jacobian. Rows index variables, columns equations. -/
def jacobianMatrix (f : σ → MvPolynomial σ R) : Matrix σ σ (MvPolynomial σ R) :=
  fun i j => MvPolynomial.pderiv i (f j)

/-- Its actual determinant, before passing to the coordinate ring. -/
def jacobianDet (f : σ → MvPolynomial σ R) : MvPolynomial σ R :=
  (jacobianMatrix f).det

/-- The canonical quotient presentation with each equation paired with the
same indexed variable. -/
def squarePresentation (f : σ → MvPolynomial σ R) :
    Algebra.PreSubmersivePresentation R (CoordinateRing f) σ σ :=
  Algebra.PreSubmersivePresentation.naive (v := f) id Function.injective_id

theorem squarePresentation_jacobiMatrix (f : σ → MvPolynomial σ R) :
    (squarePresentation f).jacobiMatrix = jacobianMatrix f := by
  funext i j
  exact Algebra.PreSubmersivePresentation.jacobiMatrix_naive
    (R := R) (v := f) id Function.injective_id _ _ i j

/-- The library presentation's Jacobian equals the class of the literal
polynomial determinant; there is no substitute matrix or rank premise. -/
theorem squarePresentation_jacobian (f : σ → MvPolynomial σ R) :
    (squarePresentation f).jacobian =
      Ideal.Quotient.mk (equationIdeal f) (jacobianDet f) := by
  rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
    squarePresentation_jacobiMatrix]
  rfl

/-- The actual determinant-unit condition bundles the genuine polynomial
presentation as a submersive presentation. -/
def submersivePresentation (f : σ → MvPolynomial σ R)
    (hJ : IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f))) :
    Algebra.SubmersivePresentation R (CoordinateRing f) σ σ where
  toPreSubmersivePresentation := squarePresentation f
  jacobian_isUnit := (squarePresentation_jacobian f).symm ▸ hJ

/-- No relative variables remain in the actual square presentation. -/
theorem standardSmooth_dimension_zero (f : σ → MvPolynomial σ R)
    (hJ : IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f))) :
    Algebra.IsStandardSmoothOfRelativeDimension 0 R (CoordinateRing f) :=
  (submersivePresentation f hJ).isStandardSmoothOfRelativeDimension
    (by simp only [Algebra.Presentation.dimension, Nat.sub_self])

/-- The whole literal quotient is etale over the coefficient ring. -/
theorem coordinateRing_etale (f : σ → MvPolynomial σ R)
    (hJ : IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f))) :
    Algebra.Etale R (CoordinateRing f) := by
  letI := standardSmooth_dimension_zero f hJ
  infer_instance

section Field

variable {K : Type u} [Field K]

/-- Over any field the actual square-Jacobian quotient is finite dimensional. -/
theorem coordinateRing_finite (f : σ → MvPolynomial σ K)
    (hJ : IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f))) :
    Module.Finite K (CoordinateRing f) := by
  letI := coordinateRing_etale f hJ
  exact Algebra.FormallyUnramified.finite_of_free K (CoordinateRing f)

/-- The actual quotient is reduced, including characteristic two. -/
theorem coordinateRing_reduced (f : σ → MvPolynomial σ K)
    (hJ : IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f))) :
    IsReduced (CoordinateRing f) := by
  letI := coordinateRing_etale f hJ
  exact Algebra.FormallyUnramified.isReduced_of_field K (CoordinateRing f)

/-- Over an algebraically closed field, the literal quotient splits as the
product indexed by its actual prime spectrum. This preserves the ring and
its coefficient-field structure, not merely a numerical dimension. -/
def coordinateRingEquivPoints [IsAlgClosed K] (f : σ → MvPolynomial σ K)
    (hJ : IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f))) :
    CoordinateRing f ≃ₐ[K] (PrimeSpectrum (CoordinateRing f) → K) := by
  letI := coordinateRing_etale f hJ
  exact Algebra.FormallyEtale.equivPiOfIsSepClosed K (CoordinateRing f)

end Field
end PaperVerification.Segre.JacobianReduced
end SegreJacobianReduced

section SegreJacobianPointCriterion
set_option autoImplicit false


/-!
# Nonsingular closed points imply an actual finite reduced coordinate algebra

The determinant criterion here concerns every actual zero of the literal
polynomial system. Hilbert's Nullstellensatz proves that the determinant is
a unit in the original quotient, without first reducing that quotient.
The actual square-presentation theorem then gives finite dimensionality and
reducedness in every characteristic.

This criterion converts an all-points Jacobian condition to a finite reduced
coordinate algebra. The generic incidence argument below supplies that condition.
-/

set_option autoImplicit false
open scoped Classical

namespace PaperVerification.Segre.JacobianPointCriterion

open MvPolynomial JacobianReduced

universe u v
variable {K : Type u} [Field K] [IsAlgClosed K]
variable {σ : Type v} [Finite σ]

/-- A polynomial with no zero on the literal zero set is a unit in the
original coordinate ring, even when that ring has not been proved reduced. -/
theorem quotient_unit_of_nonvanishing
    (I : Ideal (MvPolynomial σ K)) (g : MvPolynomial σ K)
    (h : ∀ x ∈ MvPolynomial.zeroLocus K I, MvPolynomial.aeval x g ≠ 0) :
    IsUnit (Ideal.Quotient.mk I g) := by
  let J : Ideal (MvPolynomial σ K) := I ⊔ Ideal.span {g}
  have hrad : (1 : MvPolynomial σ K) ∈ J.radical := by
    rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := K) J]
    apply MvPolynomial.mem_vanishingIdeal_iff.mpr
    intro x hx
    have hxI : x ∈ MvPolynomial.zeroLocus K I :=
      MvPolynomial.zeroLocus_anti_mono (show I ≤ J from le_sup_left) hx
    have hgJ : g ∈ J :=
      (show Ideal.span {g} ≤ J from le_sup_right)
        (Ideal.subset_span (Set.mem_singleton g))
    exact False.elim (h x hxI ((MvPolynomial.mem_zeroLocus_iff.mp hx) g hgJ))
  obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hrad
  have hone : (1 : MvPolynomial σ K) ∈ J := by
    simpa only [one_pow] using hn
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hone
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hb
  have hinv : Ideal.Quotient.mk I g * Ideal.Quotient.mk I c = 1 := by
    have he := congrArg (Ideal.Quotient.mk I) hab
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add,
      hc, map_mul, map_one] at he
    exact he
  refine ⟨{ val := Ideal.Quotient.mk I g
            inv := Ideal.Quotient.mk I c
            val_inv := hinv
            inv_val := ?_ }, rfl⟩
  rw [mul_comm]
  exact hinv

variable [Fintype σ] [DecidableEq σ]

/-- The zero set is the literal common zero set of all equations. -/
theorem mem_zeroLocus_equationIdeal_iff
    (f : σ → MvPolynomial σ K) (x : σ → K) :
    x ∈ MvPolynomial.zeroLocus K (equationIdeal f) ↔
      ∀ i, MvPolynomial.aeval x (f i) = 0 := by
  constructor
  · intro hx i
    exact (MvPolynomial.mem_zeroLocus_iff.mp hx) (f i)
      (Ideal.subset_span ⟨i, rfl⟩)
  · intro hx
    apply MvPolynomial.mem_zeroLocus_iff.mpr
    have hker : equationIdeal f ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact hx i
    intro p hp
    exact hker hp

/-- An invertible literal Jacobian at every zero yields a unit determinant
in the actual unreduced coordinate algebra. -/
theorem jacobian_unit_of_nonsingular_zeros
    (f : σ → MvPolynomial σ K)
    (h : ∀ x : σ → K, (∀ i, MvPolynomial.aeval x (f i) = 0) →
      MvPolynomial.aeval x (jacobianDet f) ≠ 0) :
    IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f)) := by
  apply quotient_unit_of_nonvanishing
  intro x hx
  exact h x ((mem_zeroLocus_equationIdeal_iff f x).mp hx)

/-- The actual coordinate algebra is finite dimensional and reduced if
every actual zero has nonzero square Jacobian determinant. -/
theorem finite_and_reduced_of_nonsingular_zeros
    (f : σ → MvPolynomial σ K)
    (h : ∀ x : σ → K, (∀ i, MvPolynomial.aeval x (f i) = 0) →
      MvPolynomial.aeval x (jacobianDet f) ≠ 0) :
    Module.Finite K (CoordinateRing f) ∧ IsReduced (CoordinateRing f) := by
  have hJ := jacobian_unit_of_nonsingular_zeros f h
  exact ⟨coordinateRing_finite f hJ, coordinateRing_reduced f hJ⟩

end PaperVerification.Segre.JacobianPointCriterion
end SegreJacobianPointCriterion

section SegreGenericJacobian
set_option autoImplicit false


/-!
# Clearing the generic Jacobian certificate

This file works with the actual polynomial equations and their actual Jacobian.
A unit Jacobian in the fraction-field fiber supplies a nonzero element of the
parameter ring whose nonvanishing makes every specialized fiber finite and
reduced. The generic-fiber premise is explicit here; the tensor incidence
argument must establish it before this result can be used for Lemma 2.2.
-/

open scoped Classical
set_option autoImplicit false

namespace PaperVerification.Segre.GenericJacobian

open MvPolynomial JacobianReduced

universe u v w
variable {R : Type u} [CommRing R]
variable {S : Type v} [CommRing S]
variable {σ : Type w} [Fintype σ] [DecidableEq σ]

/-- Changing the coefficient ring preserves the literal equation ideal. -/
theorem equationIdeal_map (h : R →+* S) (f : σ → MvPolynomial σ R) :
    (equationIdeal f).map (MvPolynomial.map h) =
      equationIdeal (fun i => MvPolynomial.map h (f i)) := by
  rw [equationIdeal, Ideal.map_span]
  congr 1
  exact (Set.range_comp _ _).symm

/-- Partial derivatives, hence the actual square Jacobian, commute with
coefficient specialization in every characteristic. -/
theorem jacobianDet_map (h : R →+* S) (f : σ → MvPolynomial σ R) :
    jacobianDet (fun i => MvPolynomial.map h (f i)) =
      MvPolynomial.map h (jacobianDet f) := by
  unfold jacobianDet jacobianMatrix
  simp only [MvPolynomial.pderiv_map]
  exact (RingHom.map_det (MvPolynomial.map h) _).symm

/-- Invertibility modulo an ideal is the elementary Bezout condition. -/
theorem unit_quotient_iff_sup (I : Ideal R) (g : R) :
    IsUnit (Ideal.Quotient.mk I g) ↔ I ⊔ Ideal.span {g} = ⊤ := by
  constructor
  · intro h
    obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.mp h
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective b
    have hm : g * c - 1 ∈ I := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      rw [map_sub, map_mul, map_one, hb, sub_self]
    apply (Ideal.eq_top_iff_one _).mpr
    have hg : g * c ∈ I ⊔ Ideal.span {g} :=
      Ideal.mem_sup_right ((Ideal.span {g}).mul_mem_right c
        (Ideal.subset_span (Set.mem_singleton g)))
    have hgc : g * c - 1 ∈ I ⊔ Ideal.span {g} := Ideal.mem_sup_left hm
    simpa only [sub_sub_cancel] using (I ⊔ Ideal.span {g}).sub_mem hg hgc
  · intro h
    have hone : (1 : R) ∈ I ⊔ Ideal.span {g} := by rw [h]; trivial
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hone
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hb
    apply isUnit_iff_exists_inv.mpr
    refine ⟨Ideal.Quotient.mk I c, ?_⟩
    have he := congrArg (Ideal.Quotient.mk I) hab
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add, hc,
      map_mul, map_one] at he
    exact he

/-- A coefficient belonging to the equation-plus-Jacobian ideal gives a
unit Jacobian under every specialization where that coefficient is a unit. -/
theorem specialized_jacobian_unit
    (f : σ → MvPolynomial σ R) (r : R)
    (hr : C r ∈ equationIdeal f ⊔ Ideal.span {jacobianDet f})
    (h : R →+* S) (hunit : IsUnit (h r)) :
    IsUnit (Ideal.Quotient.mk
      (equationIdeal (fun i => MvPolynomial.map h (f i)))
      (jacobianDet (fun i => MvPolynomial.map h (f i)))) := by
  apply (unit_quotient_iff_sup _ _).mpr
  have hm := Ideal.mem_map_of_mem (MvPolynomial.map h) hr
  rw [Ideal.map_sup, equationIdeal_map, Ideal.map_span, Set.image_singleton,
    ← jacobianDet_map, MvPolynomial.map_C] at hm
  exact Ideal.eq_top_of_isUnit_mem _ hm (hunit.map C)

section FractionField

variable [IsDomain R]
variable (F : Type v) [Field F] [Algebra R F] [IsFractionRing R F]

/-- A genuine generic-fiber Jacobian condition has a genuine nonzero
parameter certificate; the conclusion is an ideal membership in the
original polynomial ring. -/
theorem exists_nonzero_coefficient_of_generic_unit
    (f : σ → MvPolynomial σ R)
    (hgeneric : IsUnit (Ideal.Quotient.mk
      (equationIdeal (fun i => MvPolynomial.map (algebraMap R F) (f i)))
      (jacobianDet (fun i => MvPolynomial.map (algebraMap R F) (f i))))) :
    ∃ r : R, r ≠ 0 ∧ C r ∈ equationIdeal f ⊔ Ideal.span {jacobianDet f} := by
  letI : Algebra (MvPolynomial σ R) (MvPolynomial σ F) :=
    MvPolynomial.algebraMvPolynomial
  let M : Submonoid (MvPolynomial σ R) :=
    (nonZeroDivisors R).map (C (σ := σ))
  let I : Ideal (MvPolynomial σ R) := equationIdeal f ⊔ Ideal.span {jacobianDet f}
  have htop : I.map (algebraMap (MvPolynomial σ R) (MvPolynomial σ F)) = ⊤ := by
    change I.map (MvPolynomial.map (algebraMap R F)) = ⊤
    dsimp only [I]
    rw [Ideal.map_sup, equationIdeal_map, Ideal.map_span, Set.image_singleton,
      ← jacobianDet_map]
    exact (unit_quotient_iff_sup _ _).mp hgeneric
  have hone : algebraMap (MvPolynomial σ R) (MvPolynomial σ F) 1 ∈
      I.map (algebraMap (MvPolynomial σ R) (MvPolynomial σ F)) := by
    rw [htop]; trivial
  obtain ⟨m, hm, hmem⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff M
      (MvPolynomial σ F) I 1).mp hone
  obtain ⟨r, hr, rfl⟩ := hm
  refine ⟨r, mem_nonZeroDivisors_iff_ne_zero.mp hr, ?_⟩
  simpa only [mul_one] using hmem

/-- On the resulting nonempty principal open, all actual specialized
coordinate rings are finite dimensional and reduced, over any target field. -/
theorem generic_finite_reduced_certificate
    (f : σ → MvPolynomial σ R)
    (hgeneric : IsUnit (Ideal.Quotient.mk
      (equationIdeal (fun i => MvPolynomial.map (algebraMap R F) (f i)))
      (jacobianDet (fun i => MvPolynomial.map (algebraMap R F) (f i))))) :
    ∃ r : R, r ≠ 0 ∧ ∀ (K : Type u) [Field K] (h : R →+* K),
      h r ≠ 0 →
      Module.Finite K (CoordinateRing (fun i => MvPolynomial.map h (f i))) ∧
        IsReduced (CoordinateRing (fun i => MvPolynomial.map h (f i))) := by
  obtain ⟨r, hr, hmem⟩ := exists_nonzero_coefficient_of_generic_unit F f hgeneric
  refine ⟨r, hr, ?_⟩
  intro K _ h hne
  have hJ := specialized_jacobian_unit f r hmem h (isUnit_iff_ne_zero.mpr hne)
  exact ⟨coordinateRing_finite _ hJ, coordinateRing_reduced _ hJ⟩

end FractionField
end PaperVerification.Segre.GenericJacobian
end SegreGenericJacobian

section SegreParameterDependence
set_option autoImplicit false


/-!
# Polynomial certificates from a strict parameter bound

The exceptional incidence strata must be shown to have fewer parameters
than the ambient tensor space.  This file isolates the algebraic step of
that argument: a family with more entries than an algebraic generating
family satisfies a nonzero polynomial relation.  The relation is an actual
polynomial over the original coefficient field, not a dimension predicate.
-/

open scoped Classical

namespace PaperVerification.Segre.ParameterDependence

open Algebra MvPolynomial

universe u v
variable {K : Type u} [Field K]
variable {A : Type v} [CommRing A] [IsDomain A] [Algebra K A]

/-- A finite algebraic generating family bounds every algebraically
independent family. The index types share the ambient universe only for
the convenient unlifted cardinal statement. -/
theorem independent_card_le_generators
    {σ τ : Type v} [Fintype σ] [Fintype τ]
    (y : τ → A) [Algebra.IsAlgebraic (Algebra.adjoin K (Set.range y)) A]
    (x : σ → A) (hx : AlgebraicIndependent K x) :
    Fintype.card σ ≤ Fintype.card τ := by
  have h1 := hx.cardinalMk_le_trdeg
  have h2 := Algebra.IsAlgebraic.trdeg_le_cardinalMk K (Set.range y)
  have h3 : Cardinal.mk (Set.range y) ≤ Cardinal.mk τ := Cardinal.mk_range_le
  have h4 := h1.trans (h2.trans h3)
  simpa only [Cardinal.mk_fintype, Nat.cast_le] using h4

/-- The strict bound yields a literal, nonzero polynomial equation. -/
theorem exists_polynomial_relation
    {σ τ : Type v} [Fintype σ] [Fintype τ]
    (y : τ → A) [Algebra.IsAlgebraic (Algebra.adjoin K (Set.range y)) A]
    (x : σ → A) (hcard : Fintype.card τ < Fintype.card σ) :
    ∃ p : MvPolynomial σ K, p ≠ 0 ∧ MvPolynomial.aeval x p = 0 := by
  have hn : ¬ AlgebraicIndependent K x := by
    intro hx
    exact (Nat.not_le_of_gt hcard) (independent_card_le_generators y x hx)
  rw [algebraicIndependent_iff] at hn
  push_neg at hn
  obtain ⟨p, hp, hp0⟩ := hn
  exact ⟨p, hp0, hp⟩

/-- Every specialization of the actual parametrization satisfies the
same polynomial certificate. This is the exclusion step for a principal
open in tensor-parameter space. -/
theorem relation_specializes
    {σ : Type v} (x : σ → A) (p : MvPolynomial σ K)
    (hp : MvPolynomial.aeval x p = 0)
    {B : Type*} [CommRing B] [Algebra K B] (h : A →ₐ[K] B) :
    MvPolynomial.aeval (fun i => h (x i)) p = 0 := by
  have he : MvPolynomial.aeval (fun i => h (x i)) =
      h.comp (MvPolynomial.aeval x) := by
    ext i
    simp
  rw [he, AlgHom.comp_apply, hp, map_zero]

end PaperVerification.Segre.ParameterDependence
end SegreParameterDependence

section SegreAlgebraicGenerators
set_option autoImplicit false


/-!
# Changing an algebraic generating family

This is the field-theoretic step in the incidence parameter count.  If an
ambient domain is algebraic over one finite generating family, and those
generators are algebraic over an intermediate coefficient ring, then the
ambient domain is algebraic over that intermediate ring as well.
-/

open scoped Classical

namespace PaperVerification.Segre.AlgebraicGenerators

open Algebra

variable {R S A : Type*} [CommRing R] [CommRing S] [CommRing A]
variable [Algebra R S] [Algebra R A] [Algebra S A] [IsScalarTower R S A]
variable [Nontrivial R] [IsDomain S] [NoZeroDivisors A]
variable {ι : Type*}

/-- Algebraicity of all original generators proves algebraicity of the
whole ambient extension. There is no independence hypothesis on them. -/
theorem of_generators (x : ι → A)
    [Algebra.IsAlgebraic (Algebra.adjoin R (Set.range x)) A]
    (h : ∀ i, IsAlgebraic S (x i)) : Algebra.IsAlgebraic S A := by
  let Rx := Algebra.adjoin R (Set.range x)
  let Sx := Algebra.adjoin S (Set.range x)
  have : Algebra.IsAlgebraic S Sx := by
    simpa [Sx, ← Subalgebra.isAlgebraic_iff, isAlgebraic_adjoin_iff]
  have hle : Rx ≤ Sx.restrictScalars R := by
    rw [Subalgebra.restrictScalars_adjoin]
    exact le_sup_right
  letI : Algebra Rx Sx := (Subalgebra.inclusion hle).toAlgebra
  haveI : IsScalarTower Rx Sx A := .of_algebraMap_eq fun a => rfl
  haveI : Algebra.IsAlgebraic Rx A := inferInstance
  haveI : Algebra.IsAlgebraic Sx A :=
    Algebra.IsAlgebraic.extendScalars (Subalgebra.inclusion_injective hle)
  exact Algebra.IsAlgebraic.trans S Sx A

section Field

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {σ : Type v} [Fintype σ]

/-- A nonzero equation makes the parameter count strictly smaller than the
number of coordinates, provided those coordinates generate algebraically. -/
theorem trdeg_lt_of_polynomial_relation (x : σ → L)
    [Algebra.IsAlgebraic (Algebra.adjoin K (Set.range x)) L]
    (p : MvPolynomial σ K) (hp : p ≠ 0) (hx : MvPolynomial.aeval x p = 0) :
    Algebra.trdeg K L < (Fintype.card σ : Cardinal) := by
  by_contra h
  have hle : Cardinal.mk σ ≤ Algebra.trdeg K L := by
    simpa only [Cardinal.mk_fintype] using (not_lt.mp h)
  have hb := Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite K x hle
  exact hp (hb.1.eq_zero_of_aeval_eq_zero p hx)

/-- An element whose positive power belongs to an intermediate subalgebra
is integral over that subalgebra. This works even in inseparable
characteristic and is the input for the isotropic quadratic equations. -/
theorem integral_of_power_mem (B : Subalgebra K L) (x : L) (n : ℕ)
    (hn : 0 < n) (hx : x ^ n ∈ B) : IsIntegral B x := by
  apply IsIntegral.of_pow hn
  exact (isIntegral_algebraMap : IsIntegral B (algebraMap B L ⟨x ^ n, hx⟩))

end Field
end PaperVerification.Segre.AlgebraicGenerators
end SegreAlgebraicGenerators

section SegreCoordinateField
set_option autoImplicit false


/-!
# The field generated by the actual point coordinates

This file identifies the field used in the incidence parameter count. It
is the intermediate field generated by the evaluated projective chart
coordinates. Its extension of their polynomial algebra is algebraic;
this follows by induction under the field operations, including inversion.
-/

open scoped Classical

namespace PaperVerification.Segre.CoordinateField

open Algebra

universe u v w
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {σ : Type w}

abbrev field (x : σ → L) : IntermediateField K L :=
  IntermediateField.adjoin K (Set.range x)

def coordinate (x : σ → L) (i : σ) : field (K := K) x :=
  ⟨x i, IntermediateField.subset_adjoin K _ ⟨i,rfl⟩⟩

@[simp] theorem coe_coordinate (x : σ → L) (i : σ) :
    (coordinate (K := K) x i : L) = x i := rfl

/-- The field generated by the coordinates is algebraic over their
ordinary polynomial algebra, with both rings inside that same field. -/
theorem isAlgebraic_adjoin_coordinates (x : σ → L) :
    Algebra.IsAlgebraic (Algebra.adjoin K (Set.range (coordinate (K := K) x))) (field (K := K) x) := by
  let B := Algebra.adjoin K (Set.range (coordinate (K := K) x))
  constructor
  rintro ⟨a,ha⟩
  refine IntermediateField.adjoin_induction (F := K)
    (motive := fun a ha => IsAlgebraic B (⟨a,ha⟩ : field (K := K) x)) ?_ ?_ ?_ ?_ ?_ ha
  · rintro a ⟨i,rfl⟩
    exact isAlgebraic_algebraMap
      (⟨coordinate (K := K) x i, Algebra.subset_adjoin ⟨i,rfl⟩⟩ : B)
  · intro c
    exact isAlgebraic_algebraMap (algebraMap K B c)
  · intro a b ha hb h₁ h₂
    exact h₁.add h₂
  · intro a ha h
    exact h.inv
  · intro a b ha hb h₁ h₂
    exact h₁.mul h₂

theorem trdeg_le_card {τ : Type v} (x : τ → L) [Fintype τ] :
    Algebra.trdeg K (field (K := K) x) ≤ (Fintype.card τ : Cardinal) := by
  letI := isAlgebraic_adjoin_coordinates (K := K) x
  have h₁ := Algebra.IsAlgebraic.trdeg_le_cardinalMk K
    (Set.range (coordinate (K := K) x))
  have h₂ : Cardinal.mk (Set.range (coordinate (K := K) x)) ≤ Cardinal.mk τ :=
    Cardinal.mk_range_le
  simpa only [Cardinal.mk_fintype] using h₁.trans h₂

end PaperVerification.Segre.CoordinateField
end SegreCoordinateField

section SegreIsotropicCoordinates
set_option autoImplicit false


/-!
# The parameter loss of each isotropic projective factor

On a normalized projective chart the pivot equals one. Isotropy gives
`1 + ∑ x_a² = 0`. Removing one nonpivot coordinate from each isotropic
factor leaves a family over which every removed coordinate is integral:
its square is already in the retained-coordinate algebra. This argument
is valid in characteristic two and does not assume separability.
-/

set_option autoImplicit false
open scoped Classical

namespace PaperVerification.Segre.IsotropicCoordinates

open Algebra CriticalChart TangentKernel
open scoped BigOperators

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {ι : Type v} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type v} [∀ i, Fintype (σ i)] [∀ i, DecidableEq (σ i)]

variable (S : Set ι) [DecidablePred (· ∈ S)]

/-- One selected nonpivot coordinate in each designated isotropic factor. -/
def selectedEmbedding (p : ∀ i : S, σ i.val) : S ↪ Coordinate (σ := σ) where
  toFun i := ⟨i.val,p i⟩
  inj' := by
    intro i j h
    exact Subtype.ext (congrArg Sigma.fst h)

def omitted (p : ∀ i : S, σ i.val) : Finset (Coordinate (σ := σ)) :=
  Finset.univ.map (selectedEmbedding S p)

abbrev Retained (p : ∀ i : S, σ i.val) :=
  {q : Coordinate (σ := σ) // q ∉ omitted S p}

theorem card_omitted (p : ∀ i : S, σ i.val) :
    (omitted S p).card = Fintype.card S := by
  simp only [omitted,Finset.card_map,Finset.card_univ]

theorem card_retained (p : ∀ i : S, σ i.val) :
    Fintype.card (Retained S p) = Fintype.card (Coordinate (σ := σ)) - Fintype.card S := by
  rw [Fintype.card_subtype_compl]
  change Fintype.card (Coordinate (σ := σ)) - Fintype.card ↥(omitted S p) = _
  rw [Fintype.card_coe,card_omitted]

theorem retained_of_ne (p : ∀ i : S, σ i.val) (i : S) (a : σ i.val)
    (ha : a ≠ p i) : (⟨i.val,a⟩ : Coordinate (σ := σ)) ∉ omitted S p := by
  intro h
  obtain ⟨j,_,hj⟩ := Finset.mem_map.mp h
  have hji : j = i := Subtype.ext (congrArg Sigma.fst hj)
  subst j
  have hpa : p i = a := by simpa only [selectedEmbedding,Function.Embedding.coeFn_mk,
    Sigma.mk.inj_iff,heq_eq_eq,true_and] using hj
  exact ha hpa.symm

def retainedAlgebra (x : Coordinate (σ := σ) → L) (p : ∀ i : S, σ i.val) :
    Subalgebra K L := Algebra.adjoin K (Set.range (fun q : Retained S p => x q.val))

theorem retained_mem (x : Coordinate (σ := σ) → L) (p : ∀ i : S, σ i.val)
    (q : Coordinate (σ := σ)) (hq : q ∉ omitted S p) :
    x q ∈ retainedAlgebra (K := K) S x p :=
  Algebra.subset_adjoin ⟨⟨q,hq⟩,rfl⟩

theorem quadraticNorm_pointVector (x : Coordinate (σ := σ) → L) (i : ι) :
    quadraticNorm (pointVector x i) = 1 + ∑ a : σ i, x ⟨i,a⟩ ^ 2 := by
  change (∑ a : Option (σ i), pointVector x i a * pointVector x i a) = _
  simp only [Fintype.sum_option, pointVector, one_mul, pow_two]

/-- The exact square relation in the actual normalized coordinates. -/
theorem selected_square_mem (x : Coordinate (σ := σ) → L)
    (p : ∀ i : S, σ i.val)
    (hiso : ∀ i : S, quadraticNorm (pointVector x i.val) = 0) (i : S) :
    x ⟨i.val,p i⟩ ^ 2 ∈ retainedAlgebra (K := K) S x p := by
  let B := retainedAlgebra (K := K) S x p
  have hsum : (∑ a ∈ Finset.univ.erase (p i), x ⟨i.val,a⟩ ^ 2) ∈ B := by
    apply B.sum_mem
    intro a ha
    apply B.pow_mem
    exact retained_mem S x p _ (retained_of_ne S p i a (Finset.mem_erase.mp ha).1)
  have hs := Finset.add_sum_erase Finset.univ
    (fun a : σ i.val => x ⟨i.val,a⟩ ^ 2) (Finset.mem_univ (p i))
  have hi := hiso i
  rw [quadraticNorm_pointVector,←hs] at hi
  have he : x ⟨i.val,p i⟩ ^ 2 =
      -1 - ∑ a ∈ Finset.univ.erase (p i), x ⟨i.val,a⟩ ^ 2 := by
    apply eq_of_sub_eq_zero
    calc
      x ⟨i.val,p i⟩ ^ 2 -
          (-1 - ∑ a ∈ Finset.univ.erase (p i), x ⟨i.val,a⟩ ^ 2) =
          1 + (x ⟨i.val,p i⟩ ^ 2 +
            ∑ a ∈ Finset.univ.erase (p i), x ⟨i.val,a⟩ ^ 2) := by ring
      _ = 0 := hi
  rw [he]
  exact B.sub_mem (B.neg_mem B.one_mem) hsum

/-- Every original chart coordinate is integral over the retained family. -/
theorem coordinate_integral (x : Coordinate (σ := σ) → L)
    (p : ∀ i : S, σ i.val)
    (hiso : ∀ i : S, quadraticNorm (pointVector x i.val) = 0)
    (q : Coordinate (σ := σ)) : IsIntegral (retainedAlgebra (K := K) S x p) (x q) := by
  by_cases hq : q ∈ omitted S p
  · obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hq
    apply AlgebraicGenerators.integral_of_power_mem _ _ 2 (by decide)
    exact selected_square_mem S x p hiso i
  · exact (isIntegral_algebraMap : IsIntegral (retainedAlgebra (K := K) S x p)
      (algebraMap (retainedAlgebra (K := K) S x p) L ⟨x q,retained_mem S x p q hq⟩))

/-- If the original coordinates generate algebraically, the retained ones
also generate algebraically; the removed quadratic coordinates add no
transcendence degree. -/
theorem isAlgebraic_retained (x : Coordinate (σ := σ) → L)
    [Algebra.IsAlgebraic (Algebra.adjoin K (Set.range x)) L]
    (p : ∀ i : S, σ i.val)
    (hiso : ∀ i : S, quadraticNorm (pointVector x i.val) = 0) :
    Algebra.IsAlgebraic (retainedAlgebra (K := K) S x p) L :=
  AlgebraicGenerators.of_generators (R := K) (S := retainedAlgebra (K := K) S x p) x
    (fun q => (coordinate_integral S x p hiso q).isAlgebraic)

theorem trdeg_le_card_retained (x : Coordinate (σ := σ) → L)
    [Algebra.IsAlgebraic (Algebra.adjoin K (Set.range x)) L]
    (p : ∀ i : S, σ i.val)
    (hiso : ∀ i : S, quadraticNorm (pointVector x i.val) = 0) :
    Algebra.trdeg K L ≤
      (Fintype.card (Coordinate (σ := σ)) - Fintype.card S : ℕ) := by
  letI : Algebra.IsAlgebraic
      (Algebra.adjoin K (Set.range (fun q : Retained S p => x q.val))) L :=
    isAlgebraic_retained (K := K) S x p hiso
  have h₁ := Algebra.IsAlgebraic.trdeg_le_cardinalMk K
    (Set.range (fun q : Retained S p => x q.val))
  have h₂ : Cardinal.mk (Set.range (fun q : Retained S p => x q.val)) ≤
      Cardinal.mk (Retained S p) := Cardinal.mk_range_le
  have h := h₁.trans h₂
  simpa only [Cardinal.mk_fintype,card_retained] using h

/-- An isotropic normalized factor has a nonpivot coordinate even when
some original factors have vector-space dimension one. -/
theorem nonempty_coordinate_of_isotropic (x : Coordinate (σ := σ) → L) (i : ι)
    (hi : quadraticNorm (pointVector x i) = 0) : Nonempty (σ i) := by
  by_contra hn
  letI : IsEmpty (σ i) := not_nonempty_iff.mp hn
  rw [quadraticNorm_pointVector] at hi
  simpa using hi

/-- The projective isotropic stratum loses one parameter per isotropic
factor. All pivots are normalized to one and the count is exact at the
level of the actual coordinate index types. -/
theorem trdeg_le_of_isotropic (x : Coordinate (σ := σ) → L)
    [Algebra.IsAlgebraic (Algebra.adjoin K (Set.range x)) L]
    (hiso : ∀ i : S, quadraticNorm (pointVector x i.val) = 0) :
    Algebra.trdeg K L ≤
      (Fintype.card (Coordinate (σ := σ)) - Fintype.card S : ℕ) := by
  let p : ∀ i : S, σ i.val := fun i =>
    Classical.choice (nonempty_coordinate_of_isotropic x i.val (hiso i))
  exact trdeg_le_card_retained S x p hiso

end PaperVerification.Segre.IsotropicCoordinates
end SegreIsotropicCoordinates

section SegreIncidenceTranscendence
set_option autoImplicit false


/-!
# Parameter bounds for literal linear incidence relations

The relations among tensor coordinates are linear over the field generated
by the projective point.  Their rank therefore bounds the transcendence
degree available to the tensor.  This file proves that step for arbitrary
finite families, using the actual subspace of coefficient relations.
-/

open scoped Classical

namespace PaperVerification.Segre.IncidenceTranscendence

open Algebra
open scoped BigOperators

universe u v w
variable {E : Type u} [Field E] {L : Type v} [Field L] [Algebra E L]
variable {β : Type w} [Fintype β]

/-- A coefficient relation is evaluated by the ordinary finite linear
combination of the given elements. -/
def relations (y : β → L) : Submodule E (β → E) :=
  (Fintype.linearCombination E y).ker

theorem mem_relations_iff (y : β → L) (c : β → E) :
    c ∈ relations (E := E) y ↔ (∑ i, c i • y i) = 0 := Iff.rfl

theorem span_finrank_add_relations (y : β → L) :
    Module.finrank E (Submodule.span E (Set.range y)) +
      Module.finrank E (relations (E := E) y) = Fintype.card β := by
  have h := (Fintype.linearCombination E y).finrank_range_add_finrank_ker
  have he : (Fintype.linearCombination E y).range = Submodule.span E (Set.range y) :=
    Fintype.range_linearCombination E y
  rw [he] at h
  simp only [Module.finrank_pi] at h
  unfold relations
  convert h using 1 <;> congr!

/-- Every independently proved subspace of coefficient relations reduces
the number of linearly independent coordinate values by its dimension. -/
theorem span_finrank_le_of_relations (y : β → L)
    (U : Submodule E (β → E))
    (hU : ∀ c ∈ U, (∑ i, c i • y i) = 0) :
    Module.finrank E (Submodule.span E (Set.range y)) ≤
      Fintype.card β - Module.finrank E U := by
  have hle : U ≤ relations (E := E) y := hU
  have hdim := span_finrank_add_relations (E := E) y
  have hmono := Submodule.finrank_mono hle
  omega

/-- Algebraic generators can be replaced by a basis of their actual linear
span; the resulting field-theoretic parameter count is at most that rank. -/
theorem trdeg_le_span_finrank (y : β → L)
    [Algebra.IsAlgebraic (Algebra.adjoin E (Set.range y)) L] :
    Algebra.trdeg E L ≤
      (Module.finrank E (Submodule.span E (Set.range y)) : Cardinal) := by
  classical
  let S := Submodule.span E (Set.range y)
  letI : FiniteDimensional E S := FiniteDimensional.span_of_finite E (Set.finite_range y)
  let b := Module.Basis.ofVectorSpace E S
  letI := Fintype.ofFinite (Module.Basis.ofVectorSpaceIndex E S)
  let z : Module.Basis.ofVectorSpaceIndex E S → L := fun i => (b i : L)
  have hb : Submodule.span E (Set.range z) = S := by
    change Submodule.span E (Set.range (S.subtype ∘ b)) = S
    rw [Set.range_comp, Submodule.span_image, b.span_eq,
      Submodule.map_top, Submodule.range_subtype]
  have hadjoin : Algebra.adjoin E (Set.range z) =
      Algebra.adjoin E (Set.range y) := by
    calc
      Algebra.adjoin E (Set.range z) =
          Algebra.adjoin E (Submodule.span E (Set.range z) : Set L) :=
        (Algebra.adjoin_span E).symm
      _ = Algebra.adjoin E (Set.range y) := by
        rw [hb]
        exact Algebra.adjoin_span E
  letI : Algebra.IsAlgebraic (Algebra.adjoin E (Set.range z)) L := by
    rw [hadjoin]
    infer_instance
  have h1 := Algebra.IsAlgebraic.trdeg_le_cardinalMk E (Set.range z)
  have h2 : Cardinal.mk (Set.range z) ≤
      Cardinal.mk (Module.Basis.ofVectorSpaceIndex E S) := Cardinal.mk_range_le
  have h := h1.trans h2
  simpa only [Cardinal.mk_fintype, ← Module.finrank_eq_card_basis b] using h

/-- The complete linear-incidence parameter bound. The algebraicity
hypothesis identifies the ambient extension; the relation hypothesis is
the literal evaluation of all vectors in `U`. -/
theorem trdeg_le_of_relations (y : β → L)
    [Algebra.IsAlgebraic (Algebra.adjoin E (Set.range y)) L]
    (U : Submodule E (β → E))
    (hU : ∀ c ∈ U, (∑ i, c i • y i) = 0) :
    Algebra.trdeg E L ≤
      (Fintype.card β - Module.finrank E U : ℕ) := by
  exact (trdeg_le_span_finrank y).trans
    (by exact_mod_cast span_finrank_le_of_relations (E := E) y U hU)

end PaperVerification.Segre.IncidenceTranscendence
end SegreIncidenceTranscendence

section SegreIncidenceBaseChange
set_option autoImplicit false


/-!
# Literal incidence relations over an intermediate coordinate field

Every orthogonal tangent vector over the field of projective coordinates
gives a linear relation among the original tensor coefficients in the
ambient field. This is the scalar-extension comparison required before
using the incidence rank in a transcendence-degree count.
-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.TangentKernel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]
variable {R S : Type*} [CommRing R] [CommRing S]

theorem map_otherProduct (f : R →+* S) (v : ∀ i, σ i → R)
    (i : ι) (a : ∀ i, σ i) :
    f (otherProduct v i a) = otherProduct (fun j b => f (v j b)) i a := by
  simp only [otherProduct,map_prod]

theorem map_tangentMap (f : R →+* S) (v w : ∀ i, σ i → R)
    (a : ∀ i, σ i) :
    f (tangentMap v w a) =
      tangentMap (fun i b => f (v i b)) (fun i b => f (w i b)) a := by
  simp only [tangentMap_apply,map_sum,map_mul,map_otherProduct]

theorem map_pairing {α : Type*} [Fintype α] (f : R →+* S) (v w : α → R) :
    f (pairing v w) = pairing (f ∘ v) (f ∘ w) := by
  simp only [pairing,map_sum,map_mul,Function.comp_apply,LinearMap.coe_mk,
    AddHom.coe_mk]

theorem map_quadraticNorm {α : Type*} [Fintype α]
    (f : R →+* S) (v : α → R) :
    f (quadraticNorm v) = quadraticNorm (f ∘ v) := map_pairing f v v

/-- Extending scalars preserves the literal orthogonality equation. -/
def mapOrthogonalVector {α : Type*} [Fintype α] (f : R →+* S)
    (v : α → R) (w : (pairing v).ker) : (pairing (f ∘ v)).ker :=
  ⟨f ∘ w, by
    change pairing (f ∘ v) (f ∘ w) = 0
    rw [←map_pairing]
    have hw : pairing v w = 0 := w.property
    rw [hw,map_zero]⟩

theorem map_orthogonalTangentMap (f : R →+* S)
    (v : ∀ i, σ i → R) (w : ∀ i, (pairing (v i)).ker) (a : ∀ i, σ i) :
    f (orthogonalTangentMap v w a) =
      orthogonalTangentMap (fun i => f ∘ v i)
        (fun i => mapOrthogonalVector f (v i) (w i)) a :=
  map_tangentMap f v (fun i => w i) a

end PaperVerification.Segre.TangentKernel

namespace PaperVerification.Segre.IncidenceTranscendence

open TangentKernel

variable {E L : Type*} [Field E] [Field L] [Algebra E L]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]

/-- The actual incidence equation supplies every coefficient relation in
the orthogonal tangent image over the smaller field. -/
theorem orthogonalTangent_relation (v : ∀ i, σ i → E)
    (T : (∀ i, σ i) → L)
    (hT : singularIncidenceMap (fun i a => algebraMap E L (v i a)) T = 0)
    (c : (∀ i, σ i) → E) (hc : c ∈ (orthogonalTangentMap v).range) :
    (∑ b, c b • T b) = 0 := by
  classical
  obtain ⟨w,rfl⟩ := hc
  let wL := fun i => mapOrthogonalVector (algebraMap E L) (v i) (w i)
  have h := congrArg
    (fun z : Module.Dual L (∀ i, (pairing (fun a => algebraMap E L (v i a))).ker) =>
      z wL) hT
  change coordinateDualEquiv (R := L) (∀ i, σ i) T
    (orthogonalTangentMap (fun i a => algebraMap E L (v i a)) wL) = 0 at h
  rw [coordinateDualEquiv_apply] at h
  simpa only [Algebra.smul_def,map_orthogonalTangentMap,wL,Function.comp_def] using h

/-- The geometric incidence rank bounds transcendence degree in the
ambient tensor field, with its complete isotropic correction. -/
theorem trdeg_le_incidence_fiber (v : ∀ i, σ i → E)
    (p : ∀ i, σ i) (hp : ∀ i, v i (p i) = 1)
    (T : (∀ i, σ i) → L)
    [Algebra.IsAlgebraic (Algebra.adjoin E (Set.range T)) L]
    (hT : singularIncidenceMap (fun i a => algebraMap E L (v i a)) T = 0) :
    Algebra.trdeg E L ≤
      (Fintype.card (∀ i, σ i) -
        ((∑ i, (Fintype.card (σ i) - 1)) -
          (Fintype.card (IsotropicFactor v) - 1)) : ℕ) := by
  have h := trdeg_le_of_relations T (orthogonalTangentMap v).range
    (orthogonalTangent_relation v T hT)
  rw [finrank_orthogonalTangent_range v p hp] at h
  have hs : (∑ i, Module.finrank E (pairing (v i)).ker) =
      ∑ i, (Fintype.card (σ i) - 1) := by
    apply Finset.sum_congr rfl
    intro i _
    exact finrank_pairing_kernel (v i) (p i) (hp i)
  rwa [hs] at h

end PaperVerification.Segre.IncidenceTranscendence
end SegreIncidenceBaseChange

section SegreJacobianDescent
set_option autoImplicit false


/-!
# Descent from algebraically closed generic points

The generic tensor argument is most naturally made over an algebraic
closure of the rational function field of its coefficients. The square
Jacobian criterion must then descend to the rational function field before
denominators can be cleared. Integral extension and lying over prove that
descent for the actual equation-plus-Jacobian ideal.
-/

open scoped Classical

namespace PaperVerification.Segre.JacobianDescent

open MvPolynomial JacobianReduced GenericJacobian JacobianPointCriterion

universe u v w
variable {F : Type u} [Field F] {L : Type v} [Field L] [Algebra F L]
variable [Algebra.IsAlgebraic F L]
variable {σ : Type w} [Fintype σ] [DecidableEq σ]

/-- The Jacobian unit condition descends along every algebraic extension
of the coefficient field. The ideal is extended by the literal coefficient
map, and its being the unit ideal descends by lying over. -/
theorem jacobian_unit_descends (f : σ → MvPolynomial σ F)
    (h : IsUnit (Ideal.Quotient.mk
      (equationIdeal (fun i => MvPolynomial.map (algebraMap F L) (f i)))
      (jacobianDet (fun i => MvPolynomial.map (algebraMap F L) (f i))))) :
    IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f)) := by
  letI : Algebra (MvPolynomial σ F) (MvPolynomial σ L) :=
    MvPolynomial.algebraMvPolynomial
  let I : Ideal (MvPolynomial σ F) := equationIdeal f ⊔ Ideal.span {jacobianDet f}
  have hmap : I.map (algebraMap (MvPolynomial σ F) (MvPolynomial σ L)) = ⊤ := by
    change I.map (MvPolynomial.map (algebraMap F L)) = ⊤
    dsimp only [I]
    rw [Ideal.map_sup, equationIdeal_map, Ideal.map_span,
      Set.image_singleton, ← jacobianDet_map]
    exact (unit_quotient_iff_sup _ _).mp h
  have hinj : Function.Injective
      (algebraMap (MvPolynomial σ F) (MvPolynomial σ L)) :=
    MvPolynomial.map_injective (algebraMap F L) (algebraMap F L).injective
  have hint : (algebraMap (MvPolynomial σ F) (MvPolynomial σ L)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  exact (unit_quotient_iff_sup _ _).mpr
    ((Ideal.map_eq_top_iff _ hinj hint).mp hmap)

/-- Nonsingularity of every point over an algebraic closure proves the
unit condition over the original field, without assuming its quotient
reduced, finite, or even a domain. -/
theorem jacobian_unit_of_algebraic_closed_points [IsAlgClosed L]
    (f : σ → MvPolynomial σ F)
    (h : ∀ x : σ → L,
      (∀ i, MvPolynomial.aeval x (MvPolynomial.map (algebraMap F L) (f i)) = 0) →
      MvPolynomial.aeval x
        (jacobianDet (fun i => MvPolynomial.map (algebraMap F L) (f i))) ≠ 0) :
    IsUnit (Ideal.Quotient.mk (equationIdeal f) (jacobianDet f)) :=
  jacobian_unit_descends f
    (jacobian_unit_of_nonsingular_zeros (fun i => MvPolynomial.map (algebraMap F L) (f i)) h)

end PaperVerification.Segre.JacobianDescent
end SegreJacobianDescent

section SegreLocalizedParameters
set_option autoImplicit false


/-!
# Algebraic independence of rational incidence parameters

Every image of a polynomial localization is algebraic over the subalgebra
generated by the specialized polynomial variables. Thus, if the image
contains an entire transcendence basis of the same cardinality, those
variables themselves are a transcendence basis. This gives the precise
algebraic independence needed for the incidence parametrization.
-/

open scoped Classical

namespace PaperVerification.Segre.LocalizedParameters

open Algebra MvPolynomial

universe u v w
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {σ : Type v}
variable (M : Submonoid (MvPolynomial σ K))
variable {A : Type w} [CommRing A] [Algebra (MvPolynomial σ K) A]
variable [IsLocalization M A]
include M

/-- Literal images of localized polynomials are algebraic over the actual
subalgebra generated by the specialized coordinates. -/
theorem image_isAlgebraic (z : σ → L) (f : A →+* L)
    (hf : ∀ p : MvPolynomial σ K,
      f (algebraMap (MvPolynomial σ K) A p) = MvPolynomial.aeval z p) (a : A) :
    IsAlgebraic (Algebra.adjoin K (Set.range z)) (f a) := by
  let B := Algebra.adjoin K (Set.range z)
  have hpoly (p : MvPolynomial σ K) : IsAlgebraic B (MvPolynomial.aeval z p) := by
    have hp : MvPolynomial.aeval z p ∈ B := by
      change MvPolynomial.aeval z p ∈ Algebra.adjoin K (Set.range z)
      rw [← MvPolynomial.aeval_range]
      exact ⟨p, rfl⟩
    exact isAlgebraic_algebraMap (⟨MvPolynomial.aeval z p, hp⟩ : B)
  obtain ⟨⟨p, s⟩, hs⟩ := IsLocalization.surj M a
  have hu : IsUnit (MvPolynomial.aeval z (s : MvPolynomial σ K)) := by
    rw [← hf]
    exact (IsLocalization.map_units A s).map f
  have he : f a = MvPolynomial.aeval z p /
      MvPolynomial.aeval z (s : MvPolynomial σ K) := by
    apply (eq_div_iff hu.ne_zero).mpr
    have h := congrArg f hs
    simpa only [map_mul, hf] using h
  rw [he, div_eq_mul_inv]
  exact (hpoly p).mul (hpoly s).inv

/-- A full transcendence basis represented by rational functions of an
equally large parameter family forces that family to be algebraically
independent. The representation is through an actual localization map. -/
theorem independent_of_represents_basis [Fintype σ]
    {β : Type v} [Fintype β] (z : σ → L) (T : β → L)
    (hT : IsTranscendenceBasis K T) (hcard : Fintype.card σ = Fintype.card β)
    (f : A →+* L)
    (hf : ∀ p : MvPolynomial σ K,
      f (algebraMap (MvPolynomial σ K) A p) = MvPolynomial.aeval z p)
    (hrep : ∀ b, ∃ a : A, f a = T b) : AlgebraicIndependent K z := by
  let B := Algebra.adjoin K (Set.range z)
  letI : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range T)) L := hT.isAlgebraic
  have hgen (b : β) : IsAlgebraic B (T b) := by
    obtain ⟨a, ha⟩ := hrep b
    rw [← ha]
    exact image_isAlgebraic M z f hf a
  letI : Algebra.IsAlgebraic B L :=
    AlgebraicGenerators.of_generators (R := K) (S := B) T hgen
  have hle : Cardinal.mk σ ≤ Algebra.trdeg K L := by
    rw [← hT.cardinalMk_eq_trdeg]
    simpa only [Cardinal.mk_fintype, hcard] using (le_refl (Fintype.card β : Cardinal))
  exact (Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite K z hle).1

end PaperVerification.Segre.LocalizedParameters
end SegreLocalizedParameters

section SegreLinearIncidenceParametrization
set_option autoImplicit false


/-!
# Explicit parametrization of a full-rank linear incidence chart

The tensor critical equations are linear in the tensor coefficients. On a
chart where a selected square coefficient matrix is invertible, those
coefficients are uniquely determined by the projective coordinates and the
remaining tensor coefficients. This file constructs the parametrization
over the actual localization of a polynomial ring and proves that every
solution specializes it.
-/

open scoped Classical

namespace PaperVerification.Segre.LinearIncidenceParametrization

open Matrix MvPolynomial
open scoped BigOperators

universe u v w
variable {α : Type v} [Fintype α] [DecidableEq α]
variable {γ : Type w} [Fintype γ]

section LinearSystem

variable {R S : Type*} [CommRing R] [CommRing S]

def solve (M : Matrix α α R) (N : Matrix α γ R) (z : γ → R) : α → R :=
  -(M⁻¹ *ᵥ (N *ᵥ z))

theorem mulVec_injective_of_unit_det (M : Matrix α α R) (hM : IsUnit M.det) :
    Function.Injective (fun u => M *ᵥ u) := by
  intro u v huv
  have h := congrArg (fun w => M⁻¹ *ᵥ w) huv
  simpa only [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul M hM,
    Matrix.one_mulVec] using h

theorem solve_spec (M : Matrix α α R) (N : Matrix α γ R)
    (hM : IsUnit M.det) (z : γ → R) : M *ᵥ solve M N z + N *ᵥ z = 0 := by
  rw [solve, Matrix.mulVec_neg, Matrix.mulVec_mulVec,
    Matrix.mul_nonsing_inv M hM, Matrix.one_mulVec, neg_add_cancel]

theorem solve_unique (M : Matrix α α R) (N : Matrix α γ R)
    (hM : IsUnit M.det) (u : α → R) (z : γ → R)
    (hu : M *ᵥ u + N *ᵥ z = 0) : u = solve M N z := by
  apply mulVec_injective_of_unit_det M hM
  have hs := solve_spec M N hM z
  exact add_right_cancel (hu.trans hs.symm)

theorem map_solution (f : R →+* S) (M : Matrix α α R) (N : Matrix α γ R)
    (u : α → R) (z : γ → R) (h : M *ᵥ u + N *ᵥ z = 0) :
    M.map f *ᵥ (f ∘ u) + N.map f *ᵥ (f ∘ z) = 0 := by
  funext i
  have hi := congrArg f (congrFun h i)
  simpa only [Pi.add_apply, Pi.zero_apply, map_add, map_zero,
    RingHom.map_mulVec] using hi

end LinearSystem

section PolynomialChart

variable {K : Type u} [Field K]

abbrev Parameters := MvPolynomial (α ⊕ γ) K

def liftedMatrix (M : Matrix α α (MvPolynomial α K)) :
    Matrix α α (Parameters (K := K) (α := α) (γ := γ)) :=
  M.map (MvPolynomial.rename Sum.inl)

def liftedRemainder (N : Matrix α γ (MvPolynomial α K)) :
    Matrix α γ (Parameters (K := K) (α := α) (γ := γ)) :=
  N.map (MvPolynomial.rename Sum.inl)

def denominator (M : Matrix α α (MvPolynomial α K)) :
    Parameters (K := K) (α := α) (γ := γ) := (liftedMatrix (γ := γ) M).det

abbrev ChartRing (M : Matrix α α (MvPolynomial α K)) :=
  Localization.Away (denominator (γ := γ) M)

def localMatrix (M : Matrix α α (MvPolynomial α K)) :
    Matrix α α (ChartRing (γ := γ) M) :=
  (liftedMatrix (γ := γ) M).map
    (algebraMap (Parameters (K := K) (α := α) (γ := γ)) (ChartRing (γ := γ) M))

def localRemainder (M : Matrix α α (MvPolynomial α K))
    (N : Matrix α γ (MvPolynomial α K)) : Matrix α γ (ChartRing (γ := γ) M) :=
  (liftedRemainder N).map
    (algebraMap (Parameters (K := K) (α := α) (γ := γ)) (ChartRing (γ := γ) M))

def localParameter (M : Matrix α α (MvPolynomial α K)) (j : α ⊕ γ) :
    ChartRing (γ := γ) M :=
  algebraMap (Parameters (K := K) (α := α) (γ := γ)) (ChartRing (γ := γ) M) (X j)

theorem localMatrix_det_unit (M : Matrix α α (MvPolynomial α K)) :
    IsUnit (localMatrix (γ := γ) M).det := by
  have hd := (RingHom.map_det
    (algebraMap (Parameters (K := K) (α := α) (γ := γ)) (ChartRing (γ := γ) M))
    (liftedMatrix (γ := γ) M)).symm
  change IsUnit ((liftedMatrix (γ := γ) M).map
    (algebraMap (Parameters (K := K) (α := α) (γ := γ)) (ChartRing (γ := γ) M))).det
  change IsUnit ((algebraMap (Parameters (K := K) (α := α) (γ := γ))
    (ChartRing (γ := γ) M)).mapMatrix (liftedMatrix (γ := γ) M)).det
  rw [hd]
  exact IsLocalization.Away.algebraMap_isUnit (denominator (γ := γ) M)

def localTensor (M : Matrix α α (MvPolynomial α K))
    (N : Matrix α γ (MvPolynomial α K)) : α ⊕ γ → ChartRing (γ := γ) M :=
  Sum.elim
    (solve (localMatrix (γ := γ) M) (localRemainder M N)
      (fun j => localParameter M (Sum.inr j)))
    (fun j => localParameter M (Sum.inr j))

theorem localTensor_satisfies (M : Matrix α α (MvPolynomial α K))
    (N : Matrix α γ (MvPolynomial α K)) :
    localMatrix (γ := γ) M *ᵥ (fun i => localTensor M N (Sum.inl i)) +
      localRemainder M N *ᵥ (fun j => localTensor M N (Sum.inr j)) = 0 :=
  solve_spec _ _ (localMatrix_det_unit M) _

variable {L : Type*} [Field L]

theorem eval_liftedMatrix (h : K →+* L) (x : α → L) (z : γ → L)
    (M : Matrix α α (MvPolynomial α K)) :
    (liftedMatrix (γ := γ) M).map (eval₂Hom h (Sum.elim x z)) =
      M.map (eval₂Hom h x) := by
  ext i j
  simp [liftedMatrix, MvPolynomial.eval₂_rename]

theorem eval_liftedRemainder (h : K →+* L) (x : α → L) (z : γ → L)
    (N : Matrix α γ (MvPolynomial α K)) :
    (liftedRemainder N).map (eval₂Hom h (Sum.elim x z)) =
      N.map (eval₂Hom h x) := by
  ext i j
  simp [liftedRemainder, MvPolynomial.eval₂_rename]

theorem eval_denominator (h : K →+* L) (x : α → L) (z : γ → L)
    (M : Matrix α α (MvPolynomial α K)) :
    eval₂Hom h (Sum.elim x z) (denominator (γ := γ) M) =
      (M.map (eval₂Hom h x)).det := by
  rw [denominator, RingHom.map_det]
  exact congrArg Matrix.det (eval_liftedMatrix h x z M)

/-- The specialization exists exactly where the chosen actual minor is a
unit. It is a homomorphism from the genuine polynomial localization. -/
def specialize (h : K →+* L) (M : Matrix α α (MvPolynomial α K))
    (x : α → L) (z : γ → L)
    (hM : IsUnit (M.map (eval₂Hom h x)).det) : ChartRing (γ := γ) M →+* L :=
  IsLocalization.Away.lift (denominator (γ := γ) M)
    (g := eval₂Hom h (Sum.elim x z)) ((eval_denominator h x z M).symm ▸ hM)

@[simp] theorem specialize_algebraMap (h : K →+* L)
    (M : Matrix α α (MvPolynomial α K)) (x : α → L) (z : γ → L)
    (hM : IsUnit (M.map (eval₂Hom h x)).det) (p : Parameters (K := K) (α := α) (γ := γ)) :
    specialize h M x z hM (algebraMap (Parameters (K := K) (α := α) (γ := γ))
      (ChartRing (γ := γ) M) p) = eval₂Hom h (Sum.elim x z) p :=
  IsLocalization.Away.lift_eq _ _ _

@[simp] theorem specialize_parameter (h : K →+* L)
    (M : Matrix α α (MvPolynomial α K)) (x : α → L) (z : γ → L)
    (hM : IsUnit (M.map (eval₂Hom h x)).det) (j : α ⊕ γ) :
    specialize h M x z hM (localParameter M j) = Sum.elim x z j := by
  simp [localParameter]

theorem specialize_localMatrix (h : K →+* L)
    (M : Matrix α α (MvPolynomial α K)) (x : α → L) (z : γ → L)
    (hM : IsUnit (M.map (eval₂Hom h x)).det) :
    (localMatrix (γ := γ) M).map (specialize h M x z hM) =
      M.map (eval₂Hom h x) := by
  ext i j
  simpa [localMatrix, liftedMatrix, MvPolynomial.eval₂_rename]

theorem specialize_localRemainder (h : K →+* L)
    (M : Matrix α α (MvPolynomial α K)) (N : Matrix α γ (MvPolynomial α K))
    (x : α → L) (z : γ → L) (hM : IsUnit (M.map (eval₂Hom h x)).det) :
    (localRemainder M N).map (specialize h M x z hM) = N.map (eval₂Hom h x) := by
  ext i j
  simpa [localRemainder, liftedRemainder, MvPolynomial.eval₂_rename]

/-- Every solution on the selected minor chart is the specialization of
the explicitly constructed universal tensor. -/
theorem specialize_tensor (h : K →+* L)
    (M : Matrix α α (MvPolynomial α K)) (N : Matrix α γ (MvPolynomial α K))
    (x u : α → L) (z : γ → L) (hM : IsUnit (M.map (eval₂Hom h x)).det)
    (hu : M.map (eval₂Hom h x) *ᵥ u + N.map (eval₂Hom h x) *ᵥ z = 0) :
    (fun j => specialize h M x z hM (localTensor M N j)) = Sum.elim u z := by
  let f := specialize h M x z hM
  have hsol := map_solution f (localMatrix (γ := γ) M) (localRemainder M N)
    (fun i => localTensor M N (Sum.inl i))
    (fun j => localTensor M N (Sum.inr j)) (localTensor_satisfies M N)
  rw [specialize_localMatrix, specialize_localRemainder] at hsol
  have hz : (f ∘ fun j => localTensor M N (Sum.inr j)) = z := by
    funext j
    simp [f, localTensor]
  rw [hz] at hsol
  have hs := (solve_unique _ _ hM _ z hsol).trans (solve_unique _ _ hM u z hu).symm
  funext j
  cases j with
  | inl i => exact congrFun hs i
  | inr j => simp [localTensor]

/-- Algebraically independent parameters make the genuine specialization
injective. Nonzero functions on this incidence chart therefore remain
nonzero at every such parameter tuple. -/
theorem specialize_injective [Algebra K L]
    (M : Matrix α α (MvPolynomial α K)) (x : α → L) (z : γ → L)
    (hM : IsUnit (M.map (eval₂Hom (algebraMap K L) x)).det)
    (h : AlgebraicIndependent K (Sum.elim x z)) :
    Function.Injective (specialize (algebraMap K L) M x z hM) := by
  apply (IsLocalization.lift_injective_iff _).mpr
  intro a b
  constructor
  · intro hab
    have he := congrArg (specialize (algebraMap K L) M x z hM) hab
    simpa only [specialize_algebraMap] using he
  · intro hab
    exact congrArg _ (h hab)

theorem nonvanishing_at_independent_parameters [Algebra K L]
    (M : Matrix α α (MvPolynomial α K)) (x : α → L) (z : γ → L)
    (hM : IsUnit (M.map (eval₂Hom (algebraMap K L) x)).det)
    (h : AlgebraicIndependent K (Sum.elim x z))
    (a : ChartRing (γ := γ) M) (ha : a ≠ 0) :
    specialize (algebraMap K L) M x z hM a ≠ 0 := by
  intro he
  apply ha
  exact specialize_injective M x z hM h (he.trans (map_zero _).symm)

/-- For a generic tensor, the positions and the nonpivot tensor entries are
automatically algebraically independent. No independent-parameter premise
is added to the critical-point problem. -/
theorem solution_parameters_independent
    {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
    {α γ : Type v} [Fintype α] [DecidableEq α] [Fintype γ]
    (M : Matrix α α (MvPolynomial α K)) (N : Matrix α γ (MvPolynomial α K))
    (x u : α → L) (z : γ → L)
    (hT : IsTranscendenceBasis K (Sum.elim u z))
    (hM : IsUnit (M.map (eval₂Hom (algebraMap K L) x)).det)
    (hu : M.map (eval₂Hom (algebraMap K L) x) *ᵥ u +
      N.map (eval₂Hom (algebraMap K L) x) *ᵥ z = 0) :
    AlgebraicIndependent K (Sum.elim x z) := by
  apply LocalizedParameters.independent_of_represents_basis
    (Submonoid.powers (denominator (γ := γ) M)) (Sum.elim x z) (Sum.elim u z)
    hT rfl (specialize (algebraMap K L) M x z hM)
  · intro p
    exact specialize_algebraMap _ _ _ _ _ p
  · intro j
    refine ⟨localTensor M N j, ?_⟩
    exact congrFun (specialize_tensor (algebraMap K L) M N x u z hM hu) j

end PolynomialChart
end PaperVerification.Segre.LinearIncidenceParametrization
end SegreLinearIncidenceParametrization

section SegreCriticalChartParameters
set_option autoImplicit false


/-!
# The tensor parameter block of the literal critical equations

Each chart equation is linear in the tensor coefficients. The coefficients
whose cells differ from the distinguished cell in exactly one factor form
a square parameter block. Its value at the chart origin is the identity.
All identities hold over arbitrary commutative rings, in every characteristic.

-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.CriticalChart

open TangentKernel MvPolynomial

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]
variable {R : Type*} [CommRing R]

theorem chartContraction_add (T U : TensorCell (σ := σ) → R)
    (i : ι) (a : Option (σ i)) :
    chartContraction (T + U) i a =
      chartContraction T i a + chartContraction U i a := by
  classical
  unfold chartContraction contraction
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro b _
  by_cases hb : b i = a <;> simp [hb, Pi.add_apply, add_mul]

theorem chartContraction_smul (c : R) (T : TensorCell (σ := σ) → R)
    (i : ι) (a : Option (σ i)) :
    chartContraction (c • T) i a = c • chartContraction T i a := by
  classical
  unfold chartContraction contraction
  rw [MvPolynomial.smul_eq_C_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro b _
  by_cases hb : b i = a <;> simp [hb, Pi.smul_apply, smul_eq_mul, mul_assoc]

/-- The actual equation as a linear map in the full tensor parameter space. -/
def criticalEquationLinear (q : Coordinate (σ := σ)) :
    (TensorCell (σ := σ) → R) →ₗ[R] MvPolynomial (Coordinate (σ := σ)) R where
  toFun T := criticalEquation T q
  map_add' T U := by
    simp only [criticalEquation, chartContraction_add, mul_add]
    ring
  map_smul' c T := by
    simp only [criticalEquation, chartContraction_smul, RingHom.id_apply,
      MvPolynomial.smul_eq_C_mul]
    ring

@[simp] theorem criticalEquationLinear_apply (q : Coordinate (σ := σ))
    (T : TensorCell (σ := σ) → R) : criticalEquationLinear q T = criticalEquation T q := rfl

/-- Full coefficient expansion, with no tensor entries omitted. -/
theorem criticalEquation_eq_sum (T : TensorCell (σ := σ) → R)
    (q : Coordinate (σ := σ)) :
    criticalEquation T q = ∑ b : TensorCell (σ := σ),
      C (T b) * criticalEquation (Pi.single b 1) q := by
  classical
  change criticalEquationLinear q T = _
  conv_lhs => rw [pi_eq_sum_univ' T, map_sum]
  simp only [map_smul, criticalEquationLinear_apply, MvPolynomial.smul_eq_C_mul]

/-- The tensor cell with precisely the specified free factor coordinate. -/
def starCell (q : Coordinate (σ := σ)) : TensorCell (σ := σ) :=
  Function.update originCell q.1 (some q.2)

theorem starCell_injective : Function.Injective (starCell (σ := σ)) := by
  classical
  rintro ⟨i, a⟩ ⟨j, b⟩ h
  have hij : i = j := by
    by_contra hij
    have he := congrFun h i
    simp [starCell, Function.update_of_ne hij, originCell] at he
  subst j
  have hab : a = b := Option.some.inj (by
    simpa only [starCell, Function.update_self] using congrFun h i)
  subst b
  rfl

/-- At the chart origin the contraction extracts exactly one tensor entry. -/
theorem eval_chartContraction_zero (T : TensorCell (σ := σ) → R)
    (i : ι) (a : Option (σ i)) :
    eval 0 (chartContraction T i a) = T (Function.update originCell i a) := by
  classical
  rw [eval_chartContraction]
  unfold contraction
  rw [Finset.sum_eq_single (Function.update originCell i a)]
  · rw [Function.update_self, if_pos rfl,
      otherProduct_update_self (pointVector (R := R) 0) originCell (fun _ => rfl)]
    exact mul_one _
  · intro b _ hb
    by_cases hbi : b i = a
    · have hrest : ∃ j, j ≠ i ∧ b j ≠ none := by
        by_contra hrest
        push_neg at hrest
        apply hb
        funext j
        by_cases hji : j = i
        · subst j
          simpa only [Function.update_self] using hbi
        · rw [Function.update_of_ne hji]
          exact hrest j hji
      obtain ⟨j, hji, hj⟩ := hrest
      have hz : otherProduct (pointVector (R := R) 0) i b = 0 := by
        apply Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩)
        cases hbj : b j with
        | none => exact (hj hbj).elim
        | some c => rfl
      simp only [hbi, if_pos, hz, mul_zero]
    · simp only [hbi, if_false]
  · intro h
    exact (h (Finset.mem_univ _)).elim

@[simp] theorem eval_criticalEquation_zero (T : TensorCell (σ := σ) → R)
    (q : Coordinate (σ := σ)) :
    eval 0 (criticalEquation T q) = T (starCell q) := by
  rw [criticalEquation,map_sub,map_mul,eval_X,Pi.zero_apply,zero_mul,sub_zero,
    eval_chartContraction_zero]
  rfl

/-- The exact square coefficient block on the star tensor entries. -/
def starCoefficientMatrix :
    Matrix (Coordinate (σ := σ)) (Coordinate (σ := σ))
      (MvPolynomial (Coordinate (σ := σ)) R) := by
  classical
  exact fun q r => criticalEquation (Pi.single (starCell r) 1) q

/-- The coefficient block is the identity at the normalized origin. -/
theorem starCoefficientMatrix_zero :
    (starCoefficientMatrix (R := R) (σ := σ)).map (eval 0) = 1 := by
  classical
  ext q r
  change eval 0 (criticalEquation (Pi.single (starCell r) 1) q)=
    (1 : Matrix (Coordinate (σ := σ)) (Coordinate (σ := σ)) R) q r
  rw [eval_criticalEquation_zero,Matrix.one_apply]
  simp only [Pi.single_apply,starCell_injective.eq_iff]

@[simp] theorem eval_starCoefficientMatrix_det_zero :
    eval 0 (starCoefficientMatrix (R := R) (σ := σ)).det = 1 := by
  classical
  rw [RingHom.map_det]
  change ((starCoefficientMatrix (R := R) (σ := σ)).map (eval 0)).det=1
  rw [starCoefficientMatrix_zero,Matrix.det_one]

theorem starCoefficientMatrix_det_ne_zero [Nontrivial R] :
    (starCoefficientMatrix (R := R) (σ := σ)).det ≠ 0 := by
  intro h
  have he := eval_starCoefficientMatrix_det_zero (R := R) (σ := σ)
  rw [h, map_zero] at he
  exact zero_ne_one he

end PaperVerification.Segre.CriticalChart
end SegreCriticalChartParameters

section SegreGenericNonisotropic
set_option autoImplicit false


/-!
# Generic critical points have no isotropic factor

The tensor coefficients are a transcendence basis of the ambient field.
The field generated by a critical point's projective coordinates has at
most `q-a` parameters on the stratum with `a` isotropic factors. The
orthogonal tangent image gives `q-(a-1)` independent linear relations
among the tensor coefficients. Transcendence degree in the field tower
then excludes every nonempty isotropic stratum.

All coordinate fields, maps, and subspaces below are the literal ones;
there is no dimension or generic-smoothness assumption in the conclusion.
-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.GenericNonisotropic

open Algebra TangentKernel CriticalChart

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {ι : Type v} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type v} [∀ i, Fintype (σ i)]

/-- An algebraic generating family remains one after enlarging the
coefficient field inside the same ambient field. -/
theorem algebraic_over_intermediate_generators
    {E : Type*} [Field E] [Algebra K E] [Algebra E L] [IsScalarTower K E L]
    {β : Type*} (T : β → L) (hT : IsTranscendenceBasis K T) :
    Algebra.IsAlgebraic (Algebra.adjoin E (Set.range T)) L := by
  let B := Algebra.adjoin E (Set.range T)
  letI := hT.isAlgebraic
  exact AlgebraicGenerators.of_generators (R := K) (S := B) T
    (fun b => isAlgebraic_algebraMap (⟨T b, Algebra.subset_adjoin ⟨b,rfl⟩⟩ : B))

theorem finrank_point_orthogonalTangent (x : Coordinate (σ := σ) → L) :
    Module.finrank L (orthogonalTangentMap (pointVector x)).range =
      Fintype.card (Coordinate (σ := σ)) -
        (Fintype.card (IsotropicFactor (pointVector x)) - 1) := by
  classical
  rw [finrank_orthogonalTangent_range (pointVector x) (fun _ => none)
    (fun _ => rfl)]
  have hs : (∑ i, Module.finrank L (pairing (pointVector x i)).ker) =
      Fintype.card (Coordinate (σ := σ)) := by
    rw [Fintype.card_sigma]
    apply Finset.sum_congr rfl
    intro i _
    rw [finrank_pairing_kernel _ none (by rfl), Fintype.card_option]
    omega
  rw [hs]

theorem isotropic_card_le_coordinates (x : Coordinate (σ := σ) → L) :
    Fintype.card (IsotropicFactor (pointVector x)) ≤
      Fintype.card (Coordinate (σ := σ)) := by
  classical
  let S : Set ι := {i | quadraticNorm (pointVector x i) = 0}
  let p : ∀ i : S, σ i.val := fun i => Classical.choice
    (IsotropicCoordinates.nonempty_coordinate_of_isotropic x i.val i.property)
  exact Fintype.card_le_of_injective (IsotropicCoordinates.selectedEmbedding S p)
    (IsotropicCoordinates.selectedEmbedding S p).injective

/-- A generic tensor, interpreted over any algebraic extension of its
coefficient field, has no critical point on an isotropic stratum. -/
theorem critical_point_nonisotropic
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, MvPolynomial.eval x (criticalEquation T q) = 0) :
    ∀ i, quadraticNorm (pointVector x i) ≠ 0 := by
  classical
  let E := CoordinateField.field (K := K) x
  let xE : Coordinate (σ := σ) → E := CoordinateField.coordinate (K := K) x
  let vE := pointVector xE
  let a := Fintype.card (IsotropicFactor vE)
  let q := Fintype.card (Coordinate (σ := σ))
  let D := Fintype.card (TensorCell (σ := σ))
  letI : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range xE)) E :=
    CoordinateField.isAlgebraic_adjoin_coordinates (K := K) x
  letI : Algebra.IsAlgebraic (Algebra.adjoin E (Set.range T)) L :=
    algebraic_over_intermediate_generators T hT
  have hmap : (fun i b => algebraMap E L (vE i b)) = pointVector x := by
    funext i b
    cases b <;> rfl
  have hinc : singularIncidenceMap (fun i b => algebraMap E L (vE i b)) T = 0 := by
    exact Eq.mpr (congrArg (fun v => singularIncidenceMap v T = 0) hmap)
      ((criticalEquations_iff_incidence T x).mp hx)
  have hE : Algebra.trdeg K E ≤ (q - a : ℕ) := by
    let S : Set ι := {i | quadraticNorm (vE i) = 0}
    have hcard : Fintype.card S = a :=
      Fintype.card_congr (show S ≃ IsotropicFactor vE from Equiv.refl _)
    have h := IsotropicCoordinates.trdeg_le_of_isotropic
      (K := K) S xE (fun i => i.property)
    rw [hcard] at h
    exact h
  have hL : Algebra.trdeg E L ≤ (D - (q - (a - 1)) : ℕ) := by
    have h := IncidenceTranscendence.trdeg_le_incidence_fiber
      vE (fun _ => none) (fun _ => rfl) T hinc
    simpa only [Fintype.card_option, Nat.add_sub_cancel, ←Fintype.card_sigma] using h
  have hD : Algebra.trdeg K L = (D : Cardinal) := by
    simpa only [D,Cardinal.mk_fintype] using hT.cardinalMk_eq_trdeg.symm
  have htotal : D ≤ (q - a) + (D - (q - (a - 1))) := by
    have h : (D : Cardinal) ≤ ((q - a) + (D - (q - (a - 1))) : ℕ) := by
      rw [←hD,←trdeg_add_eq K E (A := L)]
      simpa only [Nat.cast_add] using add_le_add hE hL
    exact_mod_cast h
  have haq : a ≤ q := isotropic_card_le_coordinates xE
  have hrank : q - (a - 1) ≤ D := by
    have h := (orthogonalTangentMap vE).range.finrank_le
    rw [finrank_point_orthogonalTangent xE,Module.finrank_pi] at h
    exact h
  have ha : a = 0 := by omega
  intro i hi
  have hiE : quadraticNorm (vE i) = 0 := by
    apply (algebraMap E L).injective
    rw [map_zero,map_quadraticNorm]
    simpa only [Function.comp_def, congrFun hmap i] using hi
  have ha' : 0 < a := Fintype.card_pos_iff.mpr ⟨⟨i,hiE⟩⟩
  omega

end PaperVerification.Segre.GenericNonisotropic
end SegreGenericNonisotropic

section SegreGenericPointCoordinates
set_option autoImplicit false


/-!
# Generic critical points avoid every proper fixed chart hypersurface

Once isotropic factors have been excluded, the incidence constraints
have the full chart rank. A field-tower count then proves algebraic
independence of the critical point's actual chart coordinates. In
particular the explicit star coefficient block is invertible there.
-/

open scoped Classical

namespace PaperVerification.Segre.GenericPointCoordinates

open Algebra TangentKernel CriticalChart GenericNonisotropic

universe u v
variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {ι : Type v} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type v} [∀ i, Fintype (σ i)]

/-- For a generic tensor, every critical point is itself a generic point
of the projective product over the original coefficient field. -/
theorem critical_coordinates_independent
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, MvPolynomial.eval x (criticalEquation T q) = 0) :
    AlgebraicIndependent K x := by
  classical
  let E := CoordinateField.field (K := K) x
  let xE : Coordinate (σ := σ) → E := CoordinateField.coordinate (K := K) x
  let vE := pointVector xE
  let q := Fintype.card (Coordinate (σ := σ))
  let D := Fintype.card (TensorCell (σ := σ))
  letI : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range xE)) E :=
    CoordinateField.isAlgebraic_adjoin_coordinates (K := K) x
  letI : Algebra.IsAlgebraic (Algebra.adjoin E (Set.range T)) L :=
    algebraic_over_intermediate_generators T hT
  have hmap : (fun i b => algebraMap E L (vE i b)) = pointVector x := by
    funext i b
    cases b <;> rfl
  have hnoniso := critical_point_nonisotropic T hT x hx
  have hnonisoE : ∀ i, quadraticNorm (vE i) ≠ 0 := by
    intro i hi
    apply hnoniso i
    have h := congrArg (algebraMap E L) hi
    rw [map_zero,map_quadraticNorm] at h
    exact (congrArg quadraticNorm (congrFun hmap i)).symm.trans h
  letI : IsEmpty (IsotropicFactor vE) := ⟨fun i => hnonisoE i.val i.property⟩
  have hinc : singularIncidenceMap (fun i b => algebraMap E L (vE i b)) T = 0 := by
    exact Eq.mpr (congrArg (fun v => singularIncidenceMap v T = 0) hmap)
      ((criticalEquations_iff_incidence T x).mp hx)
  have hL : Algebra.trdeg E L ≤ (D - q : ℕ) := by
    have h := IncidenceTranscendence.trdeg_le_incidence_fiber
      vE (fun _ => none) (fun _ => rfl) T hinc
    simpa only [Fintype.card_option,Nat.add_sub_cancel,←Fintype.card_sigma,
      Fintype.card_eq_zero,Nat.zero_sub,Nat.sub_zero] using h
  have hD : Algebra.trdeg K L = (D : Cardinal) := by
    simpa only [D,Cardinal.mk_fintype] using hT.cardinalMk_eq_trdeg.symm
  have hqD : q ≤ D := by
    have h := (orthogonalTangentMap vE).range.finrank_le
    rw [finrank_point_orthogonalTangent xE,Module.finrank_pi] at h
    simpa only [Fintype.card_eq_zero,Nat.zero_sub,Nat.sub_zero] using h
  have hle : (q : Cardinal) ≤ Algebra.trdeg K E := by
    apply (Cardinal.add_nat_le_add_nat_iff (D-q)).mp
    have hsum : (q : Cardinal) + (D-q : ℕ) = (D : Cardinal) := by
      have hnat : q + (D-q) = D := by omega
      exact_mod_cast hnat
    rw [hsum,←hD,←trdeg_add_eq K E (A := L)]
    exact add_le_add le_rfl hL
  have hb := Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite
    K xE (by simpa only [Cardinal.mk_fintype] using hle)
  have hi := hb.1.map (f := IsScalarTower.toAlgHom K E L)
    (FaithfulSMul.algebraMap_injective E L).injOn
  have he : (IsScalarTower.toAlgHom K E L) ∘ xE = x := by
    funext i
    rfl
  rwa [he] at hi

/-- Every nonzero polynomial in the point coordinates stays nonzero at a
critical point of the generic tensor. -/
theorem polynomial_ne_zero_at_critical
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, MvPolynomial.eval x (criticalEquation T q) = 0)
    (p : MvPolynomial (Coordinate (σ := σ)) K) (hp : p ≠ 0) :
    MvPolynomial.aeval x p ≠ 0 := by
  intro h
  exact hp ((critical_coordinates_independent T hT x hx).eq_zero_of_aeval_eq_zero p h)

/-- The explicitly exhibited square tensor-coefficient block is
invertible at every generic critical point. -/
theorem star_determinant_ne_zero
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, MvPolynomial.eval x (criticalEquation T q) = 0) :
    MvPolynomial.aeval x (starCoefficientMatrix (R := K) (σ := σ)).det ≠ 0 :=
  polynomial_ne_zero_at_critical T hT x hx _ starCoefficientMatrix_det_ne_zero

end PaperVerification.Segre.GenericPointCoordinates
end SegreGenericPointCoordinates

section SegreCriticalChartFunctoriality
set_option autoImplicit false


/-!
# Scalar extension of the literal critical equations and Jacobian

These are coefficient-by-coefficient identities for the polynomials used
throughout the singular-vector incidence argument. They let polynomial
localization and specialization retain the original tensor equations.
-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.CriticalChart

open TangentKernel MvPolynomial

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type*} [∀ i, Fintype (σ i)]
variable {R S : Type*} [CommRing R] [CommRing S]

@[simp] theorem map_chartVector (f : R →+* S) (i : ι) (a : Option (σ i)) :
    MvPolynomial.map f (chartVector (R := R) i a) = chartVector (R := S) i a := by
  cases a <;> simp [chartVector]

theorem map_chartContraction (f : R →+* S)
    (T : TensorCell (σ := σ) → R) (i : ι) (a : Option (σ i)) :
    MvPolynomial.map f (chartContraction T i a) = chartContraction (f ∘ T) i a := by
  classical
  unfold chartContraction contraction
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro b _
  by_cases hb : b i=a
  · simp only [if_pos hb,map_mul,map_C,otherProduct,map_prod,map_chartVector,
      Function.comp_apply]
  · simp only [if_neg hb,map_zero]

theorem map_criticalEquation (f : R →+* S)
    (T : TensorCell (σ := σ) → R) (q : Coordinate (σ := σ)) :
    MvPolynomial.map f (criticalEquation T q) = criticalEquation (f ∘ T) q := by
  simp only [criticalEquation,map_sub,map_mul,map_X,map_chartContraction]

theorem map_chartJacobian (f : R →+* S) (T : TensorCell (σ := σ) → R)
    (x : Coordinate (σ := σ) → R) :
    (chartJacobian T x).map f = chartJacobian (f ∘ T) (f ∘ x) := by
  ext q r
  change f (eval x (pderiv r (criticalEquation T q))) =
    eval (f ∘ x) (pderiv r (criticalEquation (f ∘ T) q))
  rw [MvPolynomial.map_eval,←pderiv_map,map_criticalEquation]

theorem map_chartJacobian_det (f : R →+* S) (T : TensorCell (σ := σ) → R)
    (x : Coordinate (σ := σ) → R) :
    f (chartJacobian T x).det = (chartJacobian (f ∘ T) (f ∘ x)).det := by
  rw [RingHom.map_det]
  change ((chartJacobian T x).map f).det=(chartJacobian (f ∘ T) (f ∘ x)).det
  rw [map_chartJacobian]

theorem map_single_tensor (f : R →+* S) (b : TensorCell (σ := σ)) :
    f ∘ (Pi.single b 1 : TensorCell (σ := σ) → R) = Pi.single b 1 := by
  classical
  funext c
  by_cases h : c = b <;> simp [Pi.single_apply,h]

/-- The tensor coefficients over a larger ring are evaluated against the
same universal coefficient polynomials over the smaller ring. -/
theorem eval_criticalEquation_eq_sum (f : R →+* S)
    (T : TensorCell (σ := σ) → S) (x : Coordinate (σ := σ) → S)
    (q : Coordinate (σ := σ)) :
    eval x (criticalEquation T q) = ∑ b : TensorCell (σ := σ),
      T b * eval₂Hom f x (criticalEquation (R := R) (Pi.single b 1) q) := by
  classical
  rw [criticalEquation_eq_sum,map_sum]
  apply Finset.sum_congr rfl
  intro b _
  rw [map_mul,eval_C]
  congr 1
  change eval x (criticalEquation (R := S) (Pi.single b 1) q)=
    eval₂ f x (criticalEquation (R := R) (Pi.single b 1) q)
  rw [←eval_map,map_criticalEquation,map_single_tensor]

end PaperVerification.Segre.CriticalChart
end SegreCriticalChartFunctoriality

section SegreGenericCriticalJacobian
set_option autoImplicit false


/-!
# The full Jacobian is nonzero at every generic critical point

The tensor entries indexed by the star cells form the square block of
the linear incidence system. On its nonvanishing locus, all tensor
entries are explicit rational functions of the projective coordinates
and the remaining tensor entries. For a generic tensor those parameters
are algebraically independent. The actual critical Jacobian is a function
on this rational chart, and it is nonzero because its value at the
coordinate pure tensor is the determinant of minus the identity.
-/

open scoped Classical

open scoped BigOperators

namespace PaperVerification.Segre.GenericCriticalJacobian

open Algebra MvPolynomial Matrix CriticalChart
open LinearIncidenceParametrization

universe u v
variable {ι : Type v} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type v} [∀ i, Fintype (σ i)]

abbrev FreeCell := {b : TensorCell (σ := σ) // b ∉ Set.range (starCell (σ := σ))}

instance : Fintype (FreeCell (σ := σ)) := by classical exact Subtype.fintype _

/-- The complete tensor coefficient set, partitioned by the explicit
injective star map. Every remaining coefficient is retained. -/
def cellEquiv : Coordinate (σ := σ) ⊕ FreeCell (σ := σ) ≃ TensorCell (σ := σ) := by
  classical
  exact (Equiv.sumCongr (Equiv.ofInjective starCell starCell_injective)
    (Equiv.refl _)).trans (Equiv.sumCompl (· ∈ Set.range (starCell (σ := σ))))

@[simp] theorem cellEquiv_inl (q : Coordinate (σ := σ)) :
    cellEquiv (Sum.inl q) = starCell q := rfl

@[simp] theorem cellEquiv_inr (b : FreeCell (σ := σ)) :
    cellEquiv (Sum.inr b) = b.val := rfl

variable {K : Type u} [Field K]

def remainingMatrix :
    Matrix (Coordinate (σ := σ)) (FreeCell (σ := σ))
      (MvPolynomial (Coordinate (σ := σ)) K) := by
  classical
  exact fun q b => criticalEquation (Pi.single b.val 1) q

def starPart {S : Type*} (T : TensorCell (σ := σ) → S) : Coordinate (σ := σ) → S :=
  fun q => T (starCell q)

def freePart {S : Type*} (T : TensorCell (σ := σ) → S) : FreeCell (σ := σ) → S :=
  fun b => T b.val

theorem parts_eq_reindex {S : Type*} (T : TensorCell (σ := σ) → S) :
    Sum.elim (starPart T) (freePart T) = T ∘ cellEquiv := by
  funext b
  cases b <;> rfl

/-- The actual evaluated critical equations are precisely the displayed
block matrix system in the original tensor entries. -/
theorem critical_system_eq {S : Type*} [CommRing S] [Algebra K S]
    (T : TensorCell (σ := σ) → S) (x : Coordinate (σ := σ) → S) :
    (starCoefficientMatrix (R := K)).map (eval₂Hom (algebraMap K S) x) *ᵥ starPart T +
      (remainingMatrix (K := K)).map (eval₂Hom (algebraMap K S) x) *ᵥ freePart T =
        fun q => eval x (criticalEquation T q) := by
  classical
  funext q
  rw [eval_criticalEquation_eq_sum (algebraMap K S)]
  rw [←cellEquiv.sum_comp (fun b : TensorCell (σ := σ) =>
    T b * eval₂Hom (algebraMap K S) x (criticalEquation (R := K) (Pi.single b 1) q)),
    Fintype.sum_sum_type]
  simp only [Pi.add_apply,Matrix.mulVec,dotProduct,Matrix.map_apply,
    starCoefficientMatrix,remainingMatrix,starPart,freePart,cellEquiv_inl,
    cellEquiv_inr,mul_comm]

theorem critical_system_of_zero {S : Type*} [CommRing S] [Algebra K S]
    (T : TensorCell (σ := σ) → S) (x : Coordinate (σ := σ) → S)
    (hx : ∀ q, eval x (criticalEquation T q) = 0) :
    (starCoefficientMatrix (R := K)).map (eval₂Hom (algebraMap K S) x) *ᵥ starPart T +
      (remainingMatrix (K := K)).map (eval₂Hom (algebraMap K S) x) *ᵥ freePart T = 0 := by
  rw [critical_system_eq]
  funext q
  exact hx q

abbrev IncidenceChart := ChartRing (γ := FreeCell (σ := σ))
  (starCoefficientMatrix (R := K) (σ := σ))

def universalPoint : Coordinate (σ := σ) → IncidenceChart (K := K) (σ := σ) :=
  fun q => localParameter (starCoefficientMatrix (R := K)) (Sum.inl q)

def universalTensor : TensorCell (σ := σ) → IncidenceChart (K := K) (σ := σ) :=
  fun b => localTensor (starCoefficientMatrix (R := K)) (remainingMatrix (K := K))
    (cellEquiv.symm b)

/-- This is the fiber Jacobian, with the tensor coefficients held fixed
when the point-coordinate derivatives are formed. -/
def universalJacobian : IncidenceChart (K := K) (σ := σ) :=
  (chartJacobian (universalTensor (K := K)) (universalPoint (K := K))).det

section Specialization

variable {L : Type*} [Field L] [Algebra K L]

def specialization (T : TensorCell (σ := σ) → L)
    (x : Coordinate (σ := σ) → L)
    (hM : IsUnit ((starCoefficientMatrix (R := K)).map
      (eval₂Hom (algebraMap K L) x)).det) : IncidenceChart (K := K) (σ := σ) →+* L :=
  specialize (algebraMap K L) (starCoefficientMatrix (R := K)) x (freePart T) hM

theorem specialization_point (T : TensorCell (σ := σ) → L)
    (x : Coordinate (σ := σ) → L)
    (hM : IsUnit ((starCoefficientMatrix (R := K)).map
      (eval₂Hom (algebraMap K L) x)).det) :
    specialization T x hM ∘ universalPoint = x := by
  funext q
  simp only [Function.comp_apply,specialization,universalPoint,specialize_parameter,
    Sum.elim_inl]

theorem specialization_tensor (T : TensorCell (σ := σ) → L)
    (x : Coordinate (σ := σ) → L)
    (hM : IsUnit ((starCoefficientMatrix (R := K)).map
      (eval₂Hom (algebraMap K L) x)).det)
    (hx : ∀ q, eval x (criticalEquation T q) = 0) :
    specialization T x hM ∘ universalTensor = T := by
  have h := specialize_tensor (algebraMap K L) (starCoefficientMatrix (R := K))
    (remainingMatrix (K := K)) x (starPart T) (freePart T) hM
    (critical_system_of_zero T x hx)
  rw [parts_eq_reindex] at h
  funext b
  have hb := congrFun h (cellEquiv.symm b)
  simpa only [Function.comp_apply,Equiv.apply_symm_apply, specialization, universalTensor] using hb

theorem specialization_jacobian (T : TensorCell (σ := σ) → L)
    (x : Coordinate (σ := σ) → L)
    (hM : IsUnit ((starCoefficientMatrix (R := K)).map
      (eval₂Hom (algebraMap K L) x)).det)
    (hx : ∀ q, eval x (criticalEquation T q) = 0) :
    specialization T x hM (universalJacobian (K := K)) = (chartJacobian T x).det := by
  rw [universalJacobian,map_chartJacobian_det,specialization_tensor T x hM hx,
    specialization_point T x hM]

end Specialization

theorem origin_minor_unit :
    IsUnit ((starCoefficientMatrix (R := K) (σ := σ)).map
      (eval₂Hom (algebraMap K K) 0)).det := by
  change IsUnit ((starCoefficientMatrix (R := K) (σ := σ)).map (eval 0)).det
  rw [starCoefficientMatrix_zero,Matrix.det_one]
  exact isUnit_one

theorem universalJacobian_ne_zero : universalJacobian (K := K) (σ := σ) ≠ 0 := by
  intro h
  have hspec := specialization_jacobian (originTensor (R := K) (σ := σ))
    0 origin_minor_unit (fun q => by simp)
  rw [h,map_zero] at hspec
  exact chartJacobian_originTensor_ne_zero (R := K) (σ := σ) 0 hspec.symm

section Generic

variable {L : Type v} [Field L] [Algebra K L]

theorem generic_minor_unit
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, eval x (criticalEquation T q) = 0) :
    IsUnit ((starCoefficientMatrix (R := K)).map
      (eval₂Hom (algebraMap K L) x)).det := by
  have hd := (RingHom.map_det (eval₂Hom (algebraMap K L) x)
    (starCoefficientMatrix (R := K) (σ := σ))).symm
  change IsUnit ((eval₂Hom (algebraMap K L) x).mapMatrix
    (starCoefficientMatrix (R := K) (σ := σ))).det
  rw [hd]
  exact isUnit_iff_ne_zero.mpr
    (GenericPointCoordinates.star_determinant_ne_zero T hT x hx)

theorem generic_parameters_independent
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, eval x (criticalEquation T q) = 0) :
    AlgebraicIndependent K (Sum.elim x (freePart T)) := by
  classical
  apply solution_parameters_independent (starCoefficientMatrix (R := K))
    (remainingMatrix (K := K)) x (starPart T) (freePart T)
  · rw [parts_eq_reindex]
    exact hT.comp_equiv cellEquiv
  · exact generic_minor_unit T hT x hx
  · exact critical_system_of_zero T x hx

/-- Nonsingularity of every critical point of the genuinely generic
tensor, over any algebraic extension of its rational coefficient field.
No finiteness, reducedness, or smoothness premise is assumed. -/
theorem generic_critical_jacobian_ne_zero
    (T : TensorCell (σ := σ) → L) (hT : IsTranscendenceBasis K T)
    (x : Coordinate (σ := σ) → L)
    (hx : ∀ q, eval x (criticalEquation T q) = 0) :
    (chartJacobian T x).det ≠ 0 := by
  classical
  let hM := generic_minor_unit T hT x hx
  have h := nonvanishing_at_independent_parameters
    (starCoefficientMatrix (R := K)) x (freePart T) hM
    (generic_parameters_independent T hT x hx)
    (universalJacobian (K := K)) universalJacobian_ne_zero
  rwa [←specialization,specialization_jacobian T x hM hx] at h

end Generic
end PaperVerification.Segre.GenericCriticalJacobian
end SegreGenericCriticalJacobian

section SegreGenericChartCertificate
set_option autoImplicit false


/-!
# One polynomial certificate for all finite reduced critical chart fibers

The generic tensor has algebraically independent entries in the algebraic
closure of their rational function field. The preceding incidence proof
shows that every zero of its literal critical equations has nonzero
Jacobian. The Nullstellensatz, integral descent, and denominator clearing
then produce one nonzero polynomial in the original tensor coefficients.
Every specialization away from that polynomial has a finite reduced
critical coordinate ring. The polynomial does not depend on a chosen
critical point or on its residue field.
-/

open scoped Classical

namespace PaperVerification.Segre.GenericChartCertificate

open Algebra MvPolynomial CriticalChart JacobianReduced
open GenericCriticalJacobian GenericJacobian JacobianDescent

universe u
variable {K : Type u} [Field K]
variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable {σ : ι → Type u} [∀ i, Fintype (σ i)]

/-- The Jacobian conventions in the square-presentation library and the
critical-chart computation differ only by transposition. -/
theorem eval_jacobianDet (T : TensorCell (σ := σ) → K)
    (x : Coordinate (σ := σ) → K) :
    eval x (jacobianDet (criticalEquation T)) = (chartJacobian T x).det := by
  classical
  rw [jacobianDet,RingHom.map_det]
  have h : (jacobianMatrix (criticalEquation T)).map (eval x) =
      (chartJacobian T x).transpose := rfl
  change ((jacobianMatrix (criticalEquation T)).map (eval x)).det = _
  rw [h,Matrix.det_transpose]

/-- A coefficient-independent choice of open set on which every literal
affine critical scheme is finite and reduced, in every characteristic. -/
theorem exists_finite_reduced_certificate :
    ∃ r : MvPolynomial (TensorCell (σ := σ)) K, r ≠ 0 ∧
      ∀ T : TensorCell (σ := σ) → K, aeval T r ≠ 0 →
        Module.Finite K (CoordinateRing (criticalEquation T)) ∧
          IsReduced (CoordinateRing (criticalEquation T)) := by
  classical
  let R := MvPolynomial (TensorCell (σ := σ)) K
  let F := FractionRing R
  let L := AlgebraicClosure F
  letI : IsScalarTower K R F := inferInstance
  letI : Algebra.IsAlgebraic R F := IsLocalization.isAlgebraic F (nonZeroDivisors R)
  let U : TensorCell (σ := σ) → R := X
  let TF : TensorCell (σ := σ) → F := algebraMap R F ∘ U
  let TL : TensorCell (σ := σ) → L := algebraMap F L ∘ TF
  let f : Coordinate (σ := σ) → MvPolynomial (Coordinate (σ := σ)) R :=
    criticalEquation U
  have hTF : IsTranscendenceBasis K TF :=
    (IsTranscendenceBasis.mvPolynomial (TensorCell (σ := σ)) K).algebraMap_comp
  have hTL : IsTranscendenceBasis K TL := hTF.algebraMap_comp
  have hgeneric : IsUnit (Ideal.Quotient.mk
      (equationIdeal (fun q => MvPolynomial.map (algebraMap R F) (f q)))
      (jacobianDet (fun q => MvPolynomial.map (algebraMap R F) (f q)))) := by
    apply jacobian_unit_of_algebraic_closed_points (L := L)
    intro x hx
    have hmap : (fun q => MvPolynomial.map (algebraMap F L)
        (MvPolynomial.map (algebraMap R F) (f q))) = criticalEquation TL := by
      funext q
      simp only [f,map_criticalEquation,TF,TL]
    have hx' : ∀ q, eval x (criticalEquation TL q) = 0 := by
      intro q
      have he := congrFun hmap q
      have hq := hx q
      rw [he] at hq
      simpa only [aeval_eq_eval] using hq
    rw [hmap]
    change eval x (jacobianDet (criticalEquation TL)) ≠ 0
    rw [eval_jacobianDet]
    exact generic_critical_jacobian_ne_zero TL hTL x hx'
  obtain ⟨r,hr,hmem⟩ := exists_nonzero_coefficient_of_generic_unit F f hgeneric
  refine ⟨r,hr,?_⟩
  intro T hTr
  let h : R →+* K := (aeval T).toRingHom
  have hJ := specialized_jacobian_unit f r hmem h (isUnit_iff_ne_zero.mpr hTr)
  have hmap : (fun q => MvPolynomial.map h (f q)) = criticalEquation T := by
    funext q
    change MvPolynomial.map h (criticalEquation U q) = criticalEquation T q
    rw [map_criticalEquation]
    congr 1
    funext b
    change eval T (X b) = T b
    exact eval_X b
  rw [hmap] at hJ
  exact ⟨coordinateRing_finite _ hJ,coordinateRing_reduced _ hJ⟩

/-- Over an infinite field the certified principal open contains an
actual tensor, so the generic statement cannot be vacuous. -/
theorem exists_nonempty_finite_reduced_certificate [Infinite K] :
    ∃ r : MvPolynomial (TensorCell (σ := σ)) K, r ≠ 0 ∧
      (∃ T : TensorCell (σ := σ) → K, aeval T r ≠ 0) ∧
      ∀ T : TensorCell (σ := σ) → K, aeval T r ≠ 0 →
        Module.Finite K (CoordinateRing (criticalEquation T)) ∧
          IsReduced (CoordinateRing (criticalEquation T)) := by
  obtain ⟨r,hr,hcert⟩ := exists_finite_reduced_certificate (K := K) (σ := σ)
  refine ⟨r,hr,?_,hcert⟩
  by_contra h
  push_neg at h
  apply hr
  apply MvPolynomial.funext
  intro T
  change eval T r = eval T 0
  simpa only [map_zero, aeval_eq_eval] using h T

end PaperVerification.Segre.GenericChartCertificate
end SegreGenericChartCertificate

end SegreIncidence

end
