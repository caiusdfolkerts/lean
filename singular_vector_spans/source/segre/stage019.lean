/-!
# Tensor products of twisting sheaves

Multiplication of sections `Γ(U, 𝒪(m)) × Γ(U, 𝒪(n)) → Γ(U, 𝒪(m + n))` induces a morphism
`𝒪(m) ⊗ 𝒪(n) ⟶ 𝒪(m + n)` of sheaves of modules on `Proj A`. When the standard opens `D₊(f)` of
homogeneous elements `f` of degree one cover `Proj A`, for instance when `A` is generated by `A₁`
as an `A₀`-algebra, this morphism is an isomorphism: on an open of `D₊(f)` all three section
modules are free of rank one, generated by powers of `f`, and multiplication matches the
generators. Hence the classes of the invertible sheaves `𝒪(n)` in the Picard group satisfy
`[𝒪(n)] = [𝒪(1)] ^ n` for every `n ∈ ℤ`, that is `𝒪(n) ≅ 𝒪(1)^{⊗ n}`.

The passage from local bijectivity of sectionwise multiplication to an isomorphism of the
sheafified tensor product follows the Cartier divisor construction in
`TauCeti/AlgebraicGeometry/CartierDivisor/TensorProduct.lean`.

## Main declarations

* `AlgebraicGeometry.Proj.twistingSheaf.tensorPresheafHom`: multiplication of sections, as a
  morphism from the sectionwise tensor product of `𝒪(m)` and `𝒪(n)` to `𝒪(m + n)`.
* `AlgebraicGeometry.Proj.twistingSheaf.tensorProductIso`: the isomorphism
  `𝒪(m) ⊗ 𝒪(n) ≅ 𝒪(m + n)` when the degree-one standard opens cover `Proj A`, with
  `AlgebraicGeometry.Proj.twistingSheaf.tensorProductIso_hom_tmul` describing it on pure tensors.
* `AlgebraicGeometry.Proj.lineBundleClass_twistingSheaf_eq_zpow`: `[𝒪(n)] = [𝒪(1)] ^ n` in the
  group of line-bundle classes.

## References

* R. Hartshorne, *Algebraic Geometry*, Proposition II.5.12.
-/

public section

noncomputable section

open CategoryTheory TopologicalSpace Opposite TensorProduct

namespace AlgebraicGeometry.Proj

universe u

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
variable {𝒜 : ℕ → σ} [GradedRing 𝒜]

namespace twistingSheaf

section Chart

variable (m n : ℤ) {f : A} {U : (Proj 𝒜).Opens}

/-- On an open contained in a degree-one chart `D₊(f)`, the chart trivializations identify
multiplication `Γ(U, 𝒪(m)) ⊗ Γ(U, 𝒪(n)) → Γ(U, 𝒪(m + n))` with multiplication of regular
functions. -/
private def chartTensorLinearEquiv (hf : f ∈ 𝒜 1) (hU : U ≤ basicOpen 𝒜 f) :
    Γ(twistingSheaf 𝒜 m, U) ⊗[Γ(Proj 𝒜, U)] Γ(twistingSheaf 𝒜 n, U) ≃ₗ[Γ(Proj 𝒜, U)]
      Γ(twistingSheaf 𝒜 (m + n), U) :=
  TensorProduct.congr (chartSectionsLinearEquiv m f hf U hU).symm
      (chartSectionsLinearEquiv n f hf U hU).symm ≪≫ₗ
    TensorProduct.lid Γ(Proj 𝒜, U) Γ(Proj 𝒜, U) ≪≫ₗ chartSectionsLinearEquiv (m + n) f hf U hU

private theorem chartTensorLinearEquiv_tmul (hf : f ∈ 𝒜 1) (hU : U ≤ basicOpen 𝒜 f)
    (s : Γ(twistingSheaf 𝒜 m, U)) (t : Γ(twistingSheaf 𝒜 n, U)) :
    chartTensorLinearEquiv m n hf hU (s ⊗ₜ t) = mul 𝒜 U m n s t := by
  set a := (chartSectionsLinearEquiv m f hf U hU).symm s
  set b := (chartSectionsLinearEquiv n f hf U hU).symm t
  have hs : s = a • chartGenerator m f hf U hU :=
    ((chartSectionsLinearEquiv m f hf U hU).apply_symm_apply s).symm.trans
      (chartSectionsLinearEquiv_apply ..)
  have ht : t = b • chartGenerator n f hf U hU :=
    ((chartSectionsLinearEquiv n f hf U hU).apply_symm_apply t).symm.trans
      (chartSectionsLinearEquiv_apply ..)
  calc chartTensorLinearEquiv m n hf hU (s ⊗ₜ t)
      = (a * b) • chartGenerator (m + n) f hf U hU := by
        simp only [chartTensorLinearEquiv, LinearEquiv.trans_apply, TensorProduct.congr_tmul,
          TensorProduct.lid_tmul, smul_eq_mul, chartSectionsLinearEquiv_apply, a, b]
    _ = mul 𝒜 U m n s t := by
      rw [hs, ht, LinearMap.map_smul₂, LinearMap.map_smul, mul_chartGenerator, mul_smul]

/-- On an open contained in the standard open `D₊(f)` of a degree-one element `f`, multiplication
of sections induces a bijection `Γ(U, 𝒪(m)) ⊗ Γ(U, 𝒪(n)) → Γ(U, 𝒪(m + n))`. -/
theorem bijective_lift_mul_of_le_basicOpen (hf : f ∈ 𝒜 1) (hU : U ≤ basicOpen 𝒜 f) :
    Function.Bijective (TensorProduct.lift (mul 𝒜 U m n)) := by
  have : TensorProduct.lift (mul 𝒜 U m n) = (chartTensorLinearEquiv m n hf hU).toLinearMap :=
    TensorProduct.ext' fun s t ↦ (chartTensorLinearEquiv_tmul m n hf hU s t).symm
  rw [this]
  exact (chartTensorLinearEquiv m n hf hU).bijective

end Chart

variable (𝒜) in
/-- Multiplication of sections, as a morphism of presheaves of modules from the sectionwise tensor
product of `𝒪(m)` and `𝒪(n)` to `𝒪(m + n)`. -/
def tensorPresheafHom (m n : ℤ) :
    PresheafOfModulesOfCommRing.Monoidal.tensorObj (R := (Proj 𝒜).sheaf.obj)
      (twistingSheaf 𝒜 m).val (twistingSheaf 𝒜 n).val ⟶ (twistingSheaf 𝒜 (m + n)).val where
  app U := ModuleCat.MonoidalCategory.tensorLift (fun s t ↦ mul 𝒜 U.unop m n s t)
    (fun s s' t ↦ (mul 𝒜 U.unop m n).map_add₂ s s' t)
    (fun r s t ↦ (mul 𝒜 U.unop m n).map_smul₂ r s t)
    (fun s t t' ↦ (mul 𝒜 U.unop m n s).map_add t t')
    (fun r s t ↦ (mul 𝒜 U.unop m n s).map_smul r t)
  naturality i := ModuleCat.MonoidalCategory.tensor_ext fun s t ↦ (res_mul i.unop s t).symm

/-- Over an open `U`, the multiplication morphism is the linear map
`Γ(U, 𝒪(m)) ⊗ Γ(U, 𝒪(n)) → Γ(U, 𝒪(m + n))` induced by multiplication of sections. -/
@[simp]
theorem tensorPresheafHom_app (m n : ℤ) (U : (Proj 𝒜).Opens) :
    ModuleCat.Hom.hom (R := (Proj 𝒜).sheaf.obj.obj (op U))
        ((tensorPresheafHom 𝒜 m n).app (op U)) =
      TensorProduct.lift (mul 𝒜 U m n) :=
  TensorProduct.ext' fun _ _ ↦ rfl

/-- Over an open `U`, the multiplication morphism sends an element of
`Γ(U, 𝒪(m)) ⊗ Γ(U, 𝒪(n))` to its image under the map induced by multiplication of sections. -/
theorem tensorPresheafHom_app_apply (m n : ℤ) (U : (Proj 𝒜).Opens)
    (w : Γ(twistingSheaf 𝒜 m, U) ⊗[Γ(Proj 𝒜, U)] Γ(twistingSheaf 𝒜 n, U)) :
    (tensorPresheafHom 𝒜 m n).app (op U) w = TensorProduct.lift (mul 𝒜 U m n) w :=
  congrArg (fun φ ↦ φ w) (tensorPresheafHom_app m n U)

section Cover

variable {ι : Type*} (f : ι → A) (hf : ∀ i, f i ∈ 𝒜 1)
  (hcover : ⨆ i, basicOpen 𝒜 (f i) = ⊤) (m n : ℤ)

include hcover in
/-- If the standard opens `D₊(f i)` cover `Proj A`, every point of an open `U` lies in one of the
opens `U ⊓ D₊(f i)`. -/
private theorem exists_mem_inf_basicOpen {U : (Proj 𝒜).Opens} {x : Proj 𝒜} (hx : x ∈ U) :
    ∃ i, x ∈ U ⊓ basicOpen 𝒜 (f i) := by
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hcover.ge (Set.mem_univ x))
  exact ⟨i, hx, hi⟩

include hf hcover

/-- Multiplication of sections is locally surjective on tensor products of sections. -/
private theorem isLocallySurjective_tensorPresheafHom :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology (Proj 𝒜))
      ((PresheafOfModules.toPresheaf (Proj 𝒜).ringCatSheaf.obj).map
        (tensorPresheafHom 𝒜 m n)) where
  imageSieve_mem {U} s x hx := by
    obtain ⟨i, hxV⟩ := exists_mem_inf_basicOpen f hcover hx
    obtain ⟨w, hw⟩ := (bijective_lift_mul_of_le_basicOpen m n (hf i)
      (inf_le_right : U ⊓ basicOpen 𝒜 (f i) ≤ _)).2
      ((twistingSheaf 𝒜 (m + n)).presheaf.map (homOfLE inf_le_left).op s)
    exact ⟨_, homOfLE inf_le_left, ⟨w, (tensorPresheafHom_app_apply m n _ w).trans hw⟩, hxV⟩

/-- Multiplication of sections is locally injective on tensor products of sections. -/
private theorem isLocallyInjective_tensorPresheafHom :
    Presheaf.IsLocallyInjective (Opens.grothendieckTopology (Proj 𝒜))
      ((PresheafOfModules.toPresheaf (Proj 𝒜).ringCatSheaf.obj).map
        (tensorPresheafHom 𝒜 m n)) where
  equalizerSieve_mem {U} z z' h x hx := by
    obtain ⟨i, hxV⟩ := exists_mem_inf_basicOpen f hcover hx
    refine ⟨_, homOfLE inf_le_left, (bijective_lift_mul_of_le_basicOpen m n (hf i)
      (inf_le_right : U.unop ⊓ basicOpen 𝒜 (f i) ≤ _)).1 ?_, hxV⟩
    refine (tensorPresheafHom_app_apply m n _ _).symm.trans
      (Eq.trans ?_ (tensorPresheafHom_app_apply m n _ _))
    exact (PresheafOfModules.naturality_apply (tensorPresheafHom 𝒜 m n)
        (homOfLE inf_le_left).op z).trans
      ((congrArg ((twistingSheaf 𝒜 (m + n)).val.map (homOfLE inf_le_left).op) h).trans
        (PresheafOfModules.naturality_apply (tensorPresheafHom 𝒜 m n)
          (homOfLE inf_le_left).op z').symm)

/-- Sheafification of multiplication is an isomorphism, since multiplication is locally
bijective. -/
private theorem isIso_sheafification_map_tensorPresheafHom :
    IsIso ((PresheafOfModules.sheafification (R := (Proj 𝒜).ringCatSheaf)
      (𝟙 (Proj 𝒜).ringCatSheaf.obj)).map (tensorPresheafHom 𝒜 m n)) := by
  have := isLocallySurjective_tensorPresheafHom f hf hcover m n
  have := isLocallyInjective_tensorPresheafHom f hf hcover m n
  -- Mathlib identifies local bijectivity with the inverse image of isomorphisms under
  -- sheafification; the two sides have different categorical wrappers.
  change ((MorphismProperty.isomorphisms _).inverseImage
    (PresheafOfModules.sheafification (R := (Proj 𝒜).ringCatSheaf)
      (𝟙 (Proj 𝒜).ringCatSheaf.obj))) (tensorPresheafHom 𝒜 m n)
  rw [← PresheafOfModules.inverseImage_W_toPresheaf_eq_inverseImage_isomorphisms]
  exact (Opens.grothendieckTopology (Proj 𝒜)).W_of_isLocallyBijective _

/-- **Multiplication identifies `𝒪(m) ⊗ 𝒪(n)` with `𝒪(m + n)`** when the standard opens of
degree-one elements cover `Proj A`. -/
def tensorProductIso :
    TauCeti.SheafOfModules.tensorProduct (Proj 𝒜).sheaf (twistingSheaf 𝒜 m)
      (twistingSheaf 𝒜 n) ≅ twistingSheaf 𝒜 (m + n) :=
  TauCeti.SheafOfModules.tensorProductIso (Proj 𝒜).sheaf _ _ ≪≫
    @asIso _ _ _ _ _ (isIso_sheafification_map_tensorPresheafHom f hf hcover m n) ≪≫
    TauCeti.SheafOfModules.sheafificationIso (Proj 𝒜).ringCatSheaf _

/-- The forward isomorphism is sheafified multiplication of sections. -/
private theorem tensorProductIso_hom :
    (tensorProductIso f hf hcover m n).hom =
      (TauCeti.SheafOfModules.tensorProductIso (Proj 𝒜).sheaf _ _).hom ≫
        (PresheafOfModules.sheafification (R := (Proj 𝒜).ringCatSheaf)
          (𝟙 (Proj 𝒜).ringCatSheaf.obj)).map (tensorPresheafHom 𝒜 m n) ≫
        (TauCeti.SheafOfModules.sheafificationIso (Proj 𝒜).ringCatSheaf _).hom :=
  (rfl)

/-- On a pure tensor `s ⊗ t` of sections over `U`, sent into `𝒪(m) ⊗ 𝒪(n)` by the unit of
sheafification, the isomorphism `𝒪(m) ⊗ 𝒪(n) ≅ 𝒪(m + n)` is multiplication of sections. -/
@[simp]
theorem tensorProductIso_hom_tmul (U : (Proj 𝒜).Opens) (s : Γ(twistingSheaf 𝒜 m, U))
    (t : Γ(twistingSheaf 𝒜 n, U)) :
    Scheme.Modules.Hom.app
      ((TauCeti.SheafOfModules.tensorProductIso (Proj 𝒜).sheaf (twistingSheaf 𝒜 m)
        (twistingSheaf 𝒜 n)).inv ≫ (tensorProductIso f hf hcover m n).hom) U
      (((PresheafOfModules.sheafificationAdjunction (𝟙 (Proj 𝒜).ringCatSheaf.obj)).unit.app
        (PresheafOfModulesOfCommRing.Monoidal.tensorObj (R := (Proj 𝒜).sheaf.obj)
          (twistingSheaf 𝒜 m).val (twistingSheaf 𝒜 n).val)).app (op U) (s ⊗ₜ t)) =
      mul 𝒜 U m n s t := by
  let P := PresheafOfModulesOfCommRing.Monoidal.tensorObj (R := (Proj 𝒜).sheaf.obj)
    (twistingSheaf 𝒜 m).val (twistingSheaf 𝒜 n).val
  let F := PresheafOfModules.sheafification (R := (Proj 𝒜).ringCatSheaf)
    (𝟙 (Proj 𝒜).ringCatSheaf.obj)
  let adj := PresheafOfModules.sheafificationAdjunction (𝟙 (Proj 𝒜).ringCatSheaf.obj)
  let G := _root_.SheafOfModules.forget (Proj 𝒜).ringCatSheaf ⋙
    PresheafOfModules.restrictScalars (𝟙 (Proj 𝒜).ringCatSheaf.obj)
  have h : adj.unit.app P ≫ G.map (F.map (tensorPresheafHom 𝒜 m n) ≫
      (TauCeti.SheafOfModules.sheafificationIso (Proj 𝒜).ringCatSheaf _).hom) =
      tensorPresheafHom 𝒜 m n := by
    apply (adj.unit_comp_map_eq_iff _ _).2
    exact congrArg (fun g ↦ F.map (tensorPresheafHom 𝒜 m n) ≫ g)
      (TauCeti.SheafOfModules.sheafificationIso_hom (Proj 𝒜).ringCatSheaf _)
  have hmap :
      (TauCeti.SheafOfModules.tensorProductIso (Proj 𝒜).sheaf _ _).inv ≫
        (tensorProductIso f hf hcover m n).hom =
      F.map (tensorPresheafHom 𝒜 m n) ≫
        (TauCeti.SheafOfModules.sheafificationIso (Proj 𝒜).ringCatSheaf _).hom := by
    exact (congrArg (fun g ↦ (TauCeti.SheafOfModules.tensorProductIso (Proj 𝒜).sheaf _ _).inv ≫ g)
      (tensorProductIso_hom f hf hcover m n)).trans (Iso.inv_hom_id_assoc _ _)
  have hU := congrArg (fun g ↦ g.app (op U) (s ⊗ₜ t))
    ((congrArg (fun g ↦ adj.unit.app P ≫ G.map g) hmap).trans h)
  -- Unfold the forgetful functor and the sheafification unit in `hU`, to express their action
  -- as `Hom.app` on the sectionwise pure tensor.
  change Scheme.Modules.Hom.app
      ((TauCeti.SheafOfModules.tensorProductIso (Proj 𝒜).sheaf (twistingSheaf 𝒜 m)
        (twistingSheaf 𝒜 n)).inv ≫ (tensorProductIso f hf hcover m n).hom) U
      ((adj.unit.app P).app (op U) (s ⊗ₜ t)) = mul 𝒜 U m n s t at hU
  exact hU

end Cover

end twistingSheaf

variable {ι : Type u} (f : ι → A) (hf : ∀ i, f i ∈ 𝒜 1)
  (hcover : ⨆ i, basicOpen 𝒜 (f i) = ⊤)

/-- **`𝒪(n) ≅ 𝒪(1)^{⊗ n}`.** If the standard opens of degree-one elements cover `Proj A`, then
all twisting sheaves are invertible, and the class of `𝒪(n)` in the group of line-bundle classes
is the `n`-th power of the class of `𝒪(1)`, for every `n ∈ ℤ`. -/
theorem lineBundleClass_twistingSheaf_eq_zpow (n : ℤ) :
    TauCeti.AlgebraicGeometry.LineBundleClass.mk
        ⟨twistingSheaf 𝒜 n, isInvertible_twistingSheaf_of_iSup_eq_top f hf hcover n⟩ =
      TauCeti.AlgebraicGeometry.LineBundleClass.mk
        ⟨twistingSheaf 𝒜 1, isInvertible_twistingSheaf_of_iSup_eq_top f hf hcover 1⟩ ^ n := by
  let φ : Multiplicative ℤ →* TauCeti.AlgebraicGeometry.LineBundleClass (Proj 𝒜) :=
    MonoidHom.mk' (fun a ↦ TauCeti.AlgebraicGeometry.LineBundleClass.mk
      ⟨twistingSheaf 𝒜 a.toAdd, isInvertible_twistingSheaf_of_iSup_eq_top f hf hcover a.toAdd⟩)
      fun a b ↦ by
        rw [← TauCeti.AlgebraicGeometry.LineBundleClass.mk_tensorProduct,
          TauCeti.AlgebraicGeometry.LineBundleClass.mk_eq_mk_iff,
          TauCeti.AlgebraicGeometry.InvertibleSheaf.tensorProduct_obj, toAdd_mul]
        exact ⟨(twistingSheaf.tensorProductIso f hf hcover a.toAdd b.toAdd).symm⟩
  have := φ.map_zpow (Multiplicative.ofAdd 1) n
  rwa [← ofAdd_zsmul, zsmul_one] at this

end AlgebraicGeometry.Proj
end
end
