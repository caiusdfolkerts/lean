/-!
# Actual finite tensor sections and insertion morphisms

This constructs the right-associated tensor of an arbitrary finite family
in a monoidal category. A family of actual maps from the tensor unit gives
an actual tensor section. Insertion leaves one factor as an input and
uses the specified sections in every other factor. Naturality and the
coordinate-replacement formula are proved from the monoidal unit laws.

The construction is intended for the actual category of sheaves of modules
on a product of projective spaces. It assumes neither a cohomology comparison
nor a singular-span conclusion. This new source is uncompiled until a
separate recorded Lean check succeeds.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.Segre.FiniteTensor

open CategoryTheory MonoidalCategory

universe u v
variable {C : Type u} [Category.{v} C] [MonoidalCategory C]

/-- The literal right-associated tensor, with the unit in length zero. -/
def tensorObj : {k : ℕ} → (Fin k → C) → C
  | 0, _ => 𝟙_ C
  | k + 1, M => M 0 ⊗ tensorObj (fun i : Fin k => M i.succ)

/-- The tensor product of actual maps from the unit. -/
def sectionMap : {k : ℕ} → (M : Fin k → C) →
    ((i : Fin k) → (𝟙_ C ⟶ M i)) → (𝟙_ C ⟶ tensorObj M)
  | 0, _, _ => 𝟙 (𝟙_ C)
  | k + 1, M, s =>
      (λ_ (𝟙_ C)).inv ≫
        (s 0 ⊗ₘ sectionMap (fun i : Fin k => M i.succ) (fun i => s i.succ))

/-- Insert an actual factor morphism, using the actual sections elsewhere. -/
def insertMap : {k : ℕ} → (M : Fin k → C) →
    ((i : Fin k) → (𝟙_ C ⟶ M i)) → (i : Fin k) →
    {A : C} → (A ⟶ M i) → (A ⟶ tensorObj M)
  | 0, _, _, i, _, _ => Fin.elim0 i
  | k + 1, M, s, i, A, f =>
      Fin.cases
        (fun g : A ⟶ M 0 =>
          (ρ_ A).inv ≫
            (g ⊗ₘ sectionMap (fun j : Fin k => M j.succ) (fun j => s j.succ)))
        (fun j (g : A ⟶ M j.succ) =>
          (λ_ A).inv ≫
            (s 0 ⊗ₘ insertMap (fun l : Fin k => M l.succ)
              (fun l => s l.succ) j g)) i f

@[simp]
theorem sectionMap_succ {k : ℕ} (M : Fin (k + 1) → C)
    (s : (i : Fin (k + 1)) → (𝟙_ C ⟶ M i)) :
    sectionMap M s = (λ_ (𝟙_ C)).inv ≫
      (s 0 ⊗ₘ sectionMap (fun i : Fin k => M i.succ) (fun i => s i.succ)) := rfl

@[simp]
theorem insertMap_zero {k : ℕ} (M : Fin (k + 1) → C)
    (s : (i : Fin (k + 1)) → (𝟙_ C ⟶ M i)) {A : C} (f : A ⟶ M 0) :
    insertMap M s 0 f = (ρ_ A).inv ≫
      (f ⊗ₘ sectionMap (fun i : Fin k => M i.succ) (fun i => s i.succ)) := rfl

@[simp]
theorem insertMap_succ {k : ℕ} (M : Fin (k + 1) → C)
    (s : (i : Fin (k + 1)) → (𝟙_ C ⟶ M i)) (i : Fin k)
    {A : C} (f : A ⟶ M i.succ) :
    insertMap M s i.succ f = (λ_ A).inv ≫
      (s 0 ⊗ₘ insertMap (fun j : Fin k => M j.succ) (fun j => s j.succ) i f) := rfl

/-- The insertion morphism is natural in its actual input object. -/
theorem comp_insertMap {k : ℕ} (M : Fin k → C)
    (s : (i : Fin k) → (𝟙_ C ⟶ M i)) (i : Fin k)
    {A B : C} (g : B ⟶ A) (f : A ⟶ M i) :
    g ≫ insertMap M s i f = insertMap M s i (g ≫ f) := by
  induction k generalizing A B with
  | zero => exact Fin.elim0 i
  | succ k ih =>
      induction i using Fin.cases with
      | zero =>
          change g ≫ ((ρ_ A).inv ≫
              (f ⊗ₘ sectionMap (fun j : Fin k => M j.succ) (fun j => s j.succ))) =
            (ρ_ B).inv ≫ ((g ≫ f) ⊗ₘ
              sectionMap (fun j : Fin k => M j.succ) (fun j => s j.succ))
          rw [← Category.assoc, rightUnitor_inv_naturality, Category.assoc,
            whiskerRight_comp_tensorHom]
      | succ i =>
          change g ≫ ((λ_ A).inv ≫
              (s 0 ⊗ₘ insertMap (fun j : Fin k => M j.succ)
                (fun j => s j.succ) i f)) =
            (λ_ B).inv ≫ (s 0 ⊗ₘ insertMap (fun j : Fin k => M j.succ)
              (fun j => s j.succ) i (g ≫ f))
          rw [← Category.assoc, leftUnitor_inv_naturality, Category.assoc,
            whiskerLeft_comp_tensorHom, ih]

/-- Inserting the chosen section recovers the full tensor section. -/
theorem insertMap_section {k : ℕ} (M : Fin k → C)
    (s : (i : Fin k) → (𝟙_ C ⟶ M i)) (i : Fin k) :
    insertMap M s i (s i) = sectionMap M s := by
  induction k with
  | zero => exact Fin.elim0 i
  | succ k ih =>
      induction i using Fin.cases with
      | zero =>
          simp only [insertMap_zero, sectionMap_succ, unitors_inv_equal]
          rfl
      | succ i =>
          simp only [insertMap_succ, sectionMap_succ]
          rw [ih]

/-- The section of the input factor is not used by insertion. -/
theorem insertMap_congr_except {k : ℕ} (M : Fin k → C)
    (s t : (i : Fin k) → (𝟙_ C ⟶ M i)) (i : Fin k)
    {A : C} (f : A ⟶ M i)
    (h : ∀ j : Fin k, j ≠ i → s j = t j) :
    insertMap M s i f = insertMap M t i f := by
  induction k generalizing A with
  | zero => exact Fin.elim0 i
  | succ k ih =>
      induction i using Fin.cases with
      | zero =>
          have ht : (fun j : Fin k => s j.succ) = (fun j : Fin k => t j.succ) := by
            funext j
            exact h j.succ (Fin.succ_ne_zero j)
          simp only [insertMap_zero, ht]
          rfl
      | succ i =>
          have hzero : s 0 = t 0 := h 0 (Ne.symm (Fin.succ_ne_zero i))
          have htail : ∀ j : Fin k, j ≠ i → s j.succ = t j.succ := by
            intro j hji
            apply h j.succ
            intro he
            exact hji (Fin.succ_inj.mp he)
          simp only [insertMap_succ, hzero]
          rw [ih (fun j : Fin k => M j.succ) (fun j => s j.succ)
            (fun j => t j.succ) i f htail]

/-- Replacing precisely the unused section leaves insertion unchanged. -/
theorem insertMap_update {k : ℕ} (M : Fin k → C)
    (s : (i : Fin k) → (𝟙_ C ⟶ M i)) (i : Fin k)
    (t : 𝟙_ C ⟶ M i) {A : C} (f : A ⟶ M i) :
    insertMap M (Function.update s i t) i f = insertMap M s i f := by
  apply insertMap_congr_except
  intro j hji
  exact Function.update_of_ne hji t s

/-- The tensor section with one coordinate changed is the corresponding
actual insertion morphism applied to that coordinate section. -/
theorem sectionMap_update {k : ℕ} (M : Fin k → C)
    (s : (i : Fin k) → (𝟙_ C ⟶ M i)) (i : Fin k) (t : 𝟙_ C ⟶ M i) :
    sectionMap M (Function.update s i t) = insertMap M s i t := by
  have h := insertMap_section M (Function.update s i t) i
  rw [Function.update_self, insertMap_update] at h
  exact h.symm

/-- Evaluation on a section is exactly the full tensor coordinate replacement. -/
theorem section_comp_insertMap {k : ℕ} (M : Fin k → C)
    (s : (i : Fin k) → (𝟙_ C ⟶ M i)) (i : Fin k)
    {A : C} (g : 𝟙_ C ⟶ A) (f : A ⟶ M i) :
    g ≫ insertMap M s i f = sectionMap M (Function.update s i (g ≫ f)) := by
  rw [comp_insertMap, sectionMap_update]

end PaperVerification.Segre.FiniteTensor
end
end
