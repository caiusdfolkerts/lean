section ProbeLayer44



/-!
# The degree-two Koszul quotient and the first Lefschetz kernel

This file proves the elementary degree-two algebra behind equations (4) and (5)
of the Segre paper. Multiplication is an arbitrary symmetric bilinear map from
degree one to degree two. The degree-one parameter ideal is the actual span of
the parameters, and its degree-two part is the actual multiplication image.

The one exactness hypothesis is stated explicitly: the multiplication relations
among the parameters are generated by their ordinary pairwise Koszul relations.
For a regular parameter sequence this is the degree-two assertion supplied by
the Koszul exactness theorem. No regularity or exactness assertion is built into
any definition here.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.LefschetzBridge

variable {K D V Q : Type*} [Field K] [Fintype D] [DecidableEq D]
  [AddCommGroup V] [Module K V] [AddCommGroup Q] [Module K Q]

/-- Multiplication by a family of degree-one parameters. -/
def multiply (b : V →ₗ[K] V →ₗ[K] Q) (θ : D → V) : (D → V) →ₗ[K] Q where
  toFun g := ∑ i, b (θ i) (g i)
  map_add' g h := by simp [map_add, Finset.sum_add_distrib]
  map_smul' a g := by simp [map_smul, Finset.smul_sum]

/-- The coefficient vector of `θᵢ eⱼ - θⱼ eᵢ`. -/
def pairRelation (θ : D → V) (i j : D) : D → V :=
  Pi.single j (θ i) - Pi.single i (θ j)

/-- The ordinary degree-two Koszul relation space. -/
def pairRelations (θ : D → V) : Submodule K (D → V) :=
  Submodule.span K (Set.range (fun ij : D × D => pairRelation θ ij.1 ij.2))

theorem multiply_single (b : V →ₗ[K] V →ₗ[K] Q) (θ : D → V) (i : D) (v : V) :
    multiply b θ (Pi.single i v) = b (θ i) v := by
  simp [multiply, Pi.single_apply, apply_ite]

theorem multiply_pairRelation (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (i j : D) :
    multiply b θ (pairRelation θ i j) = 0 := by
  rw [pairRelation, map_sub, multiply_single, multiply_single, hb (θ j) (θ i), sub_self]

theorem pairRelations_le_kernel (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) :
    pairRelations (K := K) θ ≤ LinearMap.ker (multiply b θ) := by
  apply Submodule.span_le.mpr
  rintro g ⟨⟨i, j⟩, rfl⟩
  exact multiply_pairRelation b hb θ i j

/-- Multiplication by the enlarged family `(ℓ, θ₁, …, θ_d)`. -/
def wideMultiply (b : V →ₗ[K] V →ₗ[K] Q) (θ : D → V) (ℓ : V) :
    V × (D → V) →ₗ[K] Q :=
  (b ℓ).comp (LinearMap.fst K V (D → V)) +
    (multiply b θ).comp (LinearMap.snd K V (D → V))

/-- The relations `θᵢ e_ℓ - ℓ eᵢ`, with arbitrary scalar coefficients. -/
def crossRelations (θ : D → V) (ℓ : V) : (D → K) →ₗ[K] V × (D → V) where
  toFun c := (∑ i, c i • θ i, fun i => -(c i • ℓ))
  map_add' c d := by
    apply Prod.ext
    · simp [add_smul, Finset.sum_add_distrib]
    · funext i
      simp [add_smul, add_comm]
  map_smul' a c := by
    apply Prod.ext
    · simp [Finset.smul_sum, smul_smul]
    · funext i
      simp [smul_smul]

/-- Old pair relations and the pairs involving the new form. -/
def widePairRelations (θ : D → V) (ℓ : V) : Submodule K (V × (D → V)) :=
  (pairRelations (K := K) θ).map (LinearMap.inr K V (D → V)) ⊔
    LinearMap.range (crossRelations θ ℓ)

/-- Separate the coefficient of the new form from the old coefficients. -/
def splitOption : (Option D → V) ≃ₗ[K] V × (D → V) :=
  LinearEquiv.piOptionEquivProd K

@[simp] theorem splitOption_apply (g : Option D → V) :
    splitOption (K := K) g = (g none, fun i => g (some i)) := rfl

theorem multiply_splitOption (b : V →ₗ[K] V →ₗ[K] Q)
    (θ : D → V) (ℓ : V) (g : Option D → V) :
    multiply b (fun o : Option D => o.elim ℓ θ) g = wideMultiply b θ ℓ (splitOption (K := K) g) := by
  simp [multiply, wideMultiply, Fintype.sum_option]

/-- Splitting off one index is an actual linear equivalence of multiplication
cycle spaces. -/
def kernelSplitOption (b : V →ₗ[K] V →ₗ[K] Q) (θ : D → V) (ℓ : V) :
    LinearMap.ker (multiply b (fun o : Option D => o.elim ℓ θ)) ≃ₗ[K]
      LinearMap.ker (wideMultiply b θ ℓ) where
  toFun z := ⟨splitOption (K := K) z.val, by
    change wideMultiply b θ ℓ (splitOption (K := K) z.val) = 0
    rw [← multiply_splitOption]
    exact z.property⟩
  invFun z := ⟨(splitOption (K := K)).symm z.val, by
    change multiply b (fun o : Option D => o.elim ℓ θ)
      ((splitOption (K := K)).symm z.val) = 0
    rw [multiply_splitOption, LinearEquiv.apply_symm_apply]
    exact z.property⟩
  left_inv z := by
    apply Subtype.ext
    exact (splitOption (K := K)).symm_apply_apply z.val
  right_inv z := by
    apply Subtype.ext
    exact (splitOption (K := K)).apply_symm_apply z.val
  map_add' z w := by
    apply Subtype.ext
    exact (splitOption (K := K)).map_add _ _
  map_smul' a z := by
    apply Subtype.ext
    exact (splitOption (K := K)).map_smul a _

theorem splitOption_pair_some_some (θ : D → V) (ℓ : V) (i j : D) :
    splitOption (K := K) (pairRelation (fun o : Option D => o.elim ℓ θ) (some i) (some j)) =
      LinearMap.inr K V (D → V) (pairRelation θ i j) := by
  apply Prod.ext
  · simp [pairRelation, Pi.single_apply]
  · funext k
    simp [pairRelation, Pi.single_apply]

theorem splitOption_pair_some_none (θ : D → V) (ℓ : V) (i : D) :
    splitOption (K := K) (pairRelation (fun o : Option D => o.elim ℓ θ) (some i) none) =
      crossRelations θ ℓ (Pi.single i (1 : K)) := by
  apply Prod.ext
  · simp [pairRelation, crossRelations, Pi.single_apply]
  · funext k
    simp [pairRelation, crossRelations, Pi.single_apply]

theorem pairRelation_swap (θ : D → V) (i j : D) :
    pairRelation θ i j = -pairRelation θ j i := by
  simp only [pairRelation, neg_sub]

/-- The old-plus-new description is exactly the pairwise Koszul relation space
of the full indexed family. This identifies the preceding convenient split
coordinates with the ordinary definition of all Koszul boundaries. -/
theorem widePairRelations_eq_pairRelations (θ : D → V) (ℓ : V) :
    (pairRelations (K := K) (fun o : Option D => o.elim ℓ θ)).map (splitOption (K := K)).toLinearMap =
      widePairRelations (K := K) θ ℓ := by
  apply le_antisymm
  · apply Submodule.map_le_iff_le_comap.mpr
    apply Submodule.span_le.mpr
    rintro g ⟨⟨i, j⟩, rfl⟩
    change splitOption (K := K) (pairRelation (fun o : Option D => o.elim ℓ θ) i j) ∈ widePairRelations (K := K) θ ℓ
    cases i with
    | none =>
      cases j with
      | none =>
        simpa only [pairRelation, sub_self, map_zero] using
          (widePairRelations (K := K) θ ℓ).zero_mem
      | some j =>
        rw [pairRelation_swap, map_neg, splitOption_pair_some_none]
        apply Submodule.neg_mem
        exact Submodule.mem_sup_right ⟨Pi.single j 1, rfl⟩
    | some i =>
      cases j with
      | none =>
        rw [splitOption_pair_some_none]
        exact Submodule.mem_sup_right ⟨Pi.single i 1, rfl⟩
      | some j =>
        rw [splitOption_pair_some_some]
        apply Submodule.mem_sup_left
        exact ⟨pairRelation θ i j, Submodule.subset_span ⟨(i, j), rfl⟩, rfl⟩
  · apply sup_le
    · apply Submodule.map_le_iff_le_comap.mpr
      apply Submodule.span_le.mpr
      rintro g ⟨⟨i, j⟩, rfl⟩
      refine ⟨pairRelation (fun o : Option D => o.elim ℓ θ) (some i) (some j),
        Submodule.subset_span ⟨(some i, some j), rfl⟩, ?_⟩
      exact splitOption_pair_some_some θ ℓ i j
    · rintro z ⟨c, rfl⟩
      have hc : c = ∑ i, c i • Pi.single i (1 : K) := by
        funext j
        simp [Pi.single_apply]
      have he : crossRelations θ ℓ c =
          ∑ i, c i • crossRelations θ ℓ (Pi.single i (1 : K)) := by
        conv_lhs => rw [hc]
        simp only [map_sum, map_smul]
      rw [he]
      apply Submodule.sum_mem
      intro i _
      apply Submodule.smul_mem
      refine ⟨pairRelation (fun o : Option D => o.elim ℓ θ) (some i) none,
        Submodule.subset_span ⟨(some i, none), rfl⟩, ?_⟩
      exact splitOption_pair_some_none θ ℓ i

theorem multiply_scalar_form (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) (c : D → K) :
    multiply b θ (fun i => c i • ℓ) = b ℓ (∑ i, c i • θ i) := by
  simp only [multiply, LinearMap.coe_mk, AddHom.coe_mk, map_sum, map_smul]
  exact Finset.sum_congr rfl fun i _ => congrArg (c i • ·) (hb (θ i) ℓ)

theorem wideMultiply_crossRelations (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) (c : D → K) :
    wideMultiply b θ ℓ (crossRelations θ ℓ c) = 0 := by
  change b ℓ (∑ i, c i • θ i) + multiply b θ (-(fun i => c i • ℓ)) = 0
  rw [map_neg, multiply_scalar_form b hb, add_neg_cancel]

theorem widePairRelations_le_kernel (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) :
    widePairRelations (K := K) θ ℓ ≤ LinearMap.ker (wideMultiply b θ ℓ) := by
  apply sup_le
  · rintro z ⟨g, hg, rfl⟩
    change b ℓ 0 + multiply b θ g = 0
    rw [map_zero, zero_add]
    exact pairRelations_le_kernel b hb θ hg
  · rintro z ⟨c, rfl⟩
    exact wideMultiply_crossRelations b hb θ ℓ c

/-- The degree-one part of the parameter ideal. -/
def parameterSpan (θ : D → V) : Submodule K V := Submodule.span K (Set.range θ)

theorem parameterSpan_maps_to_parameterProducts (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) :
    parameterSpan (K := K) θ ≤ (LinearMap.range (multiply b θ)).comap (b ℓ) := by
  apply Submodule.span_le.mpr
  rintro v ⟨i, rfl⟩
  refine ⟨Pi.single i ℓ, ?_⟩
  rw [multiply_single, hb]

/-- The first Lefschetz map on the quotient by the chosen linear parameters. -/
def quotientMultiply (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) :
    (V ⧸ parameterSpan (K := K) θ) →ₗ[K] (Q ⧸ LinearMap.range (multiply b θ)) :=
  (parameterSpan (K := K) θ).mapQ (LinearMap.range (multiply b θ)) (b ℓ)
    (parameterSpan_maps_to_parameterProducts b hb θ ℓ)

/-- Project an enlarged multiplication relation onto the coefficient of the new
form, modulo the old parameters. -/
def cycleProjection (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) :
    LinearMap.ker (wideMultiply b θ ℓ) →ₗ[K]
      LinearMap.ker (quotientMultiply b hb θ ℓ) where
  toFun z := ⟨Submodule.Quotient.mk z.val.1, by
    change (LinearMap.range (multiply b θ)).mkQ (b ℓ z.val.1) = 0
    apply (Submodule.Quotient.mk_eq_zero (LinearMap.range (multiply b θ))).mpr
    refine ⟨-z.val.2, ?_⟩
    rw [map_neg]
    have hz : b ℓ z.val.1 + multiply b θ z.val.2 = 0 := z.property
    exact (eq_neg_of_add_eq_zero_left hz).symm⟩
  map_add' z w := by
    apply Subtype.ext
    exact (parameterSpan (K := K) θ).mkQ.map_add _ _
  map_smul' a z := by
    apply Subtype.ext
    exact (parameterSpan (K := K) θ).mkQ.map_smul a _

/-- Every quotient-kernel class lifts to an enlarged multiplication relation. -/
theorem cycleProjection_surjective (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V) :
    Function.Surjective (cycleProjection b hb θ ℓ) := by
  intro z
  obtain ⟨v, hv⟩ := (parameterSpan (K := K) θ).mkQ_surjective z.val
  have hz : (LinearMap.range (multiply b θ)).mkQ (b ℓ v) = 0 := by
    change quotientMultiply b hb θ ℓ ((parameterSpan (K := K) θ).mkQ v) = 0
    rw [hv]
    exact z.property
  obtain ⟨g, hg⟩ := (Submodule.Quotient.mk_eq_zero (LinearMap.range (multiply b θ))).mp hz
  refine ⟨⟨(v, -g), ?_⟩, ?_⟩
  · change b ℓ v + multiply b θ (-g) = 0
    rw [map_neg, hg, add_neg_cancel]
  · apply Subtype.ext
    exact hv

/-- The ordinary enlarged-family Koszul boundaries, regarded as a subspace of
the multiplication cycles. -/
def cycleBoundaries (b : V →ₗ[K] V →ₗ[K] Q) (θ : D → V) (ℓ : V) :
    Submodule K (LinearMap.ker (wideMultiply b θ ℓ)) :=
  (widePairRelations (K := K) θ ℓ).comap (LinearMap.ker (wideMultiply b θ ℓ)).subtype

theorem boundary_first_mem_parameterSpan (θ : D → V) (ℓ : V)
    {z : V × (D → V)} (hz : z ∈ widePairRelations (K := K) θ ℓ) :
    z.1 ∈ parameterSpan (K := K) θ := by
  have hle : widePairRelations (K := K) θ ℓ ≤
      (parameterSpan (K := K) θ).comap (LinearMap.fst K V (D → V)) := by
    apply sup_le
    · rintro z ⟨g, hg, rfl⟩
      exact (parameterSpan (K := K) θ).zero_mem
    · rintro z ⟨c, rfl⟩
      change (∑ i, c i • θ i) ∈ parameterSpan (K := K) θ
      apply Submodule.sum_mem
      intro i _
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  exact hle hz

/-- Exactness for the old parameters implies that the kernel of the projection
is exactly the enlarged Koszul boundary space. -/
theorem kernel_cycleProjection (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V)
    (hexact : LinearMap.ker (multiply b θ) = pairRelations (K := K) θ) :
    LinearMap.ker (cycleProjection b hb θ ℓ) = cycleBoundaries b θ ℓ := by
  ext z
  constructor
  · intro hz
    have hzero : (parameterSpan (K := K) θ).mkQ z.val.1 = 0 :=
      congrArg Subtype.val hz
    have hspan := (Submodule.Quotient.mk_eq_zero (parameterSpan (K := K) θ)).mp hzero
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hspan
    let g : D → V := z.val.2 + fun i => c i • ℓ
    have hg : g ∈ pairRelations (K := K) θ := by
      rw [← hexact]
      change multiply b θ g = 0
      dsimp [g]
      rw [map_add, multiply_scalar_form b hb θ ℓ c, hc]
      have h : b ℓ z.val.1 + multiply b θ z.val.2 = 0 := z.property
      simpa only [add_comm] using h
    have heq : z.val = LinearMap.inr K V (D → V) g + crossRelations θ ℓ c := by
      apply Prod.ext
      · change z.val.1 = 0 + ∑ i, c i • θ i
        simpa only [zero_add] using hc.symm
      · funext i
        change z.val.2 i = (z.val.2 i + c i • ℓ) + -(c i • ℓ)
        simp
    change z.val ∈ widePairRelations (K := K) θ ℓ
    rw [heq]
    apply Submodule.add_mem_sup
    · exact ⟨g, hg, rfl⟩
    · exact ⟨c, rfl⟩
  · intro hz
    apply Subtype.ext
    exact (Submodule.Quotient.mk_eq_zero (parameterSpan (K := K) θ)).mpr
      (boundary_first_mem_parameterSpan (K := K) θ ℓ hz)

/-- The complete degree-two Koszul quotient is linearly equivalent to the first
Lefschetz kernel, assuming precisely the old-family degree-two exactness. -/
noncomputable def degreeTwoHomologyEquiv (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V)
    (hexact : LinearMap.ker (multiply b θ) = pairRelations (K := K) θ) :
    ((LinearMap.ker (wideMultiply b θ ℓ)) ⧸ cycleBoundaries b θ ℓ) ≃ₗ[K]
      LinearMap.ker (quotientMultiply b hb θ ℓ) := by
  rw [← kernel_cycleProjection b hb θ ℓ hexact]
  exact (cycleProjection b hb θ ℓ).quotKerEquivOfSurjective
    (cycleProjection_surjective b hb θ ℓ)

theorem finrank_degreeTwoHomology (b : V →ₗ[K] V →ₗ[K] Q)
    (hb : ∀ x y, b x y = b y x) (θ : D → V) (ℓ : V)
    (hexact : LinearMap.ker (multiply b θ) = pairRelations (K := K) θ) :
    Module.finrank K
      ((LinearMap.ker (wideMultiply b θ ℓ)) ⧸ cycleBoundaries b θ ℓ) =
      Module.finrank K (LinearMap.ker (quotientMultiply b hb θ ℓ)) :=
  (degreeTwoHomologyEquiv b hb θ ℓ hexact).finrank_eq

end PaperVerification.Segre.LefschetzBridge
end
