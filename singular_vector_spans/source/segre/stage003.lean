section ProbeLayer45



/-!
# The degree-two Lefschetz bridge for actual Segre polynomials

The degree-one space is the span of the literal Segre monomials in the
polynomial ring on the factor coordinates. Multiplication is actual polynomial
multiplication. The coefficient-matrix calculation is transported through the
proved monomial basis, and the fixed rank-sum exactness theorem discharges the
old-family exactness hypothesis in the abstract degree-two Koszul bridge.

This file concerns the degree-one and degree-two multiplication spaces. It does
not identify them with homogeneous pieces of a whole-ring quotient by assuming
Artinianness or regularity.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ActualLefschetz

open Staircase Monomials Degeneration KoszulDimension RankParameters
open LefschetzBridge ParameterProducts Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

/-- The proved Segre monomial basis, used as a linear equivalence. -/
noncomputable def coordinates : (Cell n → K) ≃ₗ[K] degreeOne (K := K) (n := n) :=
  (degreeOneBasis (K := K) (n := n)).equivFun.symm

theorem coordinates_value (a : Cell n → K) :
    (coordinates a).val = ∑ u, a u • cellPolynomial u := by
  unfold coordinates
  rw [Module.Basis.equivFun_symm_apply]
  change (degreeOne (K := K) (n := n)).subtype
    (∑ u, a u • degreeOneBasis (K := K) u) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro u _
  rw [map_smul]
  congr 1
  change (degreeOneBasis (K := K) (n := n) u).val = cellPolynomial u
  exact Module.Basis.coe_span_apply _ _

/-- Actual multiplication of two degree-one polynomials, with values in the
ambient polynomial ring. -/
noncomputable def polynomialProduct :
    degreeOne (K := K) (n := n) →ₗ[K]
      degreeOne (K := K) (n := n) →ₗ[K] MvPolynomial (Variables n) K where
  toFun f :=
    { toFun := fun g => f.val * g.val
      map_add' := fun g h => mul_add _ _ _
      map_smul' := fun a g => mul_smul_comm _ _ _ }
  map_add' f g := by
    apply LinearMap.ext
    intro h
    change (f.val + g.val) * h.val = f.val * h.val + g.val * h.val
    exact add_mul _ _ _
  map_smul' a f := by
    apply LinearMap.ext
    intro g
    change (a • f.val) * g.val = a • (f.val * g.val)
    exact smul_mul_assoc a f.val g.val

theorem polynomialProduct_comm (f g : degreeOne (K := K) (n := n)) :
    polynomialProduct f g = polynomialProduct g f := mul_comm _ _

/-- The chosen forms, as actual elements of the actual degree-one subspace. -/
noncomputable def forms (A : Matrix (Cell n) D K) (j : D) :
    degreeOne (K := K) (n := n) := coordinates (fun u => A u j)

@[simp] theorem forms_value (A : Matrix (Cell n) D K) (j : D) :
    (forms A j).val = segreForm A j := coordinates_value _

/-- A coefficient matrix is equivalent to a family of actual degree-one
multiplier polynomials. -/
noncomputable def multiplierCoordinates : Matrix (Cell n) D K ≃ₗ[K]
    (D → degreeOne (K := K) (n := n)) where
  toFun U j := coordinates (fun u => U u j)
  invFun g u j := coordinates.symm (g j) u
  left_inv U := by
    ext u j
    exact congrFun (coordinates.symm_apply_apply (fun v => U v j)) u
  right_inv g := by
    funext j
    exact coordinates.apply_symm_apply (g j)
  map_add' U T := by
    funext j
    exact coordinates.map_add _ _
  map_smul' a U := by
    funext j
    exact coordinates.map_smul a _

/-- The coefficient-matrix multiplication is exactly actual polynomial
multiplication after the two independently proved coordinate identifications. -/
theorem multiply_coordinates (A : Matrix (Cell n) D K) (U : Matrix (Cell n) D K) :
    multiply polynomialProduct (forms A) (multiplierCoordinates U) =
      evaluateTwo (KoszulRank.multiplication A U) := by
  change (∑ j, (forms A j).val * (multiplierCoordinates U j).val) =
    evaluatedMultiplication A (KoszulRank.flatten U)
  rw [evaluatedMultiplication_eq]
  change (∑ j, (forms A j).val * (coordinates (fun u => U u j)).val) =
    ∑ rv : D × Cell n, U rv.2 rv.1 • (segreForm A rv.1 * cellPolynomial rv.2)
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro j _
  rw [forms_value, coordinates_value, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro u _
  exact mul_smul_comm _ _ _

/-- The coordinate image of a matrix-unit Koszul relation is precisely the
ordinary polynomial relation, with the original indices and signs. -/
theorem multiplierCoordinates_pair (A : Matrix (Cell n) D K) (i j : D) :
    multiplierCoordinates (koszulMatrix A (pairAlternating i j)) =
      pairRelation (forms A) i j := by
  funext k
  change coordinates (fun u => koszulMatrix A (pairAlternating i j) u k) = _
  simp only [koszulMatrix_pair_apply, pairRelation, Pi.sub_apply, Pi.single_apply]
  change coordinates (fun u => (if k = j then A u i else 0) -
      (if k = i then A u j else 0)) =
    (if k = j then forms A i else 0) - (if k = i then forms A j else 0)
  have he : (fun u => (if k = j then A u i else 0) -
      (if k = i then A u j else 0)) =
      (if k = j then (fun u => A u i) else 0) -
        (if k = i then (fun u => A u j) else 0) := by
    funext u
    split_ifs <;> rfl
  rw [he, map_sub]
  congr 1 <;> split_ifs <;> simp only [forms, map_zero]

/-- Every coefficient-matrix boundary is an ordinary Koszul boundary among the
actual polynomial forms. -/
theorem multiplierCoordinates_koszul_mem (A : Matrix (Cell n) D K)
    (Q : alternatingMatrices K D) :
    multiplierCoordinates (koszulMatrix A Q) ∈ pairRelations (K := K) (forms A) := by
  classical
  let decD : DecidableEq D := inferInstance
  let orderD : LinearOrder D := LinearOrder.lift' (Fintype.equivFin D)
    (Fintype.equivFin D).injective
  letI : LinearOrder D := { orderD with
    toDecidableEq := decD
    compare := fun a b => @compareOfLessAndEq D a b orderD.toLT
      (orderD.toDecidableLT a b) decD
    compare_eq_compareOfLessAndEq := fun _ _ => rfl }
  obtain ⟨c, hQ⟩ := exists_sum_pairAlternating Q
  rw [hQ, map_sum, map_sum]
  apply Submodule.sum_mem
  intro ij _
  rw [map_smul, map_smul, multiplierCoordinates_pair]
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨(ij.val.1, ij.val.2), rfl⟩

/-- Complete matrix exactness transports to complete exactness for actual
polynomial multiplication; it is not used to redefine the relation space. -/
theorem actual_exactness_of_matrix_exactness (A : Matrix (Cell n) D K)
    (hA : LinearMap.ker (KoszulRank.multiplication A) =
      LinearMap.range (koszulMatrix A)) :
    LinearMap.ker (multiply polynomialProduct (forms A)) = pairRelations (K := K) (forms A) := by
  apply le_antisymm
  · intro g hg
    let U := multiplierCoordinates.symm g
    have hU : U ∈ LinearMap.ker (KoszulRank.multiplication A) := by
      apply evaluateTwo_injective
      rw [map_zero, ← multiply_coordinates]
      have hgz : multiply polynomialProduct (forms A) g = 0 := hg
      simpa only [U, LinearEquiv.apply_symm_apply] using hgz
    rw [hA] at hU
    obtain ⟨Q, hQ⟩ := hU
    have hge : multiplierCoordinates (koszulMatrix A Q) = g := by
      rw [hQ]
      exact multiplierCoordinates.apply_symm_apply g
    rw [← hge]
    exact multiplierCoordinates_koszul_mem A Q
  · exact pairRelations_le_kernel polynomialProduct polynomialProduct_comm (forms A)

/-- The multiplication image is exactly the previously defined literal
parameter-product subspace. -/
theorem range_actual_multiply (A : Matrix (Cell n) D K) :
    LinearMap.range (multiply polynomialProduct (forms A)) = productSpan A := by
  rw [← range_evaluatedMultiplication]
  ext y
  constructor
  · rintro ⟨g, rfl⟩
    let U := multiplierCoordinates.symm g
    refine ⟨KoszulRank.flatten U, ?_⟩
    change evaluateTwo (KoszulRank.multiplication A U) = _
    rw [← multiply_coordinates]
    simp only [U, LinearEquiv.apply_symm_apply]
  · rintro ⟨z, rfl⟩
    refine ⟨multiplierCoordinates (KoszulRank.flatten.symm z), ?_⟩
    rw [multiply_coordinates]
    change evaluatedMultiplication A (KoszulRank.flatten (KoszulRank.flatten.symm z)) = _
    rw [LinearEquiv.apply_symm_apply]

/-- The actual rank-sum forms have no extra degree-two syzygies, over every
infinite field and for every finite product of finite chains. -/
theorem fixed_actual_exactness [Infinite K] :
    LinearMap.ker (multiply polynomialProduct (forms (rankForms (K := K) (n := n)))) =
      pairRelations (K := K) (forms (rankForms (K := K) (n := n))) :=
  actual_exactness_of_matrix_exactness _ FixedRankParameters.fixed_rank_parameter_exactness

/-- The paper's degree-two Koszul-to-Lefschetz comparison for the actual
rank-sum parameters. Its former old-family exactness hypothesis is discharged.
The domain and target use actual polynomial multiplication and ordinary pair
relations, with no dimension or regularity assumption in their definitions. -/
noncomputable def fixed_degreeTwoHomologyEquiv [Infinite K]
    (ℓ : degreeOne (K := K) (n := n)) :=
  degreeTwoHomologyEquiv (polynomialProduct (K := K) (n := n))
    polynomialProduct_comm (forms (rankForms (K := K) (n := n))) ℓ
    (fixed_actual_exactness (K := K) (n := n))

end PaperVerification.Segre.ActualLefschetz
end
end ProbeLayer45

section ProbeLayer46



/-!
# Literal variable parameters and finite Artinian quotients

Parameters are arbitrary linear combinations of the original Segre coordinate
monomials. Multiplication between actual higher homogeneous pieces is encoded
in a finite matrix. Surjectivity in one positive degree makes every residue
coordinate nilpotent, and hence makes the literal quotient finite and Artinian.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GeneralParameters

open Staircase Monomials Balanced Artinian HigherPieces Degeneration Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

noncomputable def parameter (A : Matrix (Cell n) D K) (d : D) :
    segreAlgebra (K := K) (n := n) := ∑ u, A u d • coordinate u

theorem parameter_value (A : Matrix (Cell n) D K) (d : D) :
    (parameter A d).val = segreForm A d := by
  change (segreAlgebra (K := K) (n := n)).val (∑ u, A u d • coordinate u) = _
  simp only [map_sum, map_smul, coordinate, segreForm, Subalgebra.val_apply]

theorem parameter_homogeneous (A : Matrix (Cell n) D K) (d : D) :
    (parameter A d).val.IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree 1) := by
  rw [parameter_value]
  apply (MvPolynomial.weightedHomogeneousSubmodule K (factorWeight (n := n))
    (diagonalDegree 1)).sum_mem
  intro u _
  exact Submodule.smul_mem _ _ (cellPolynomial_homogeneous u)

abbrev Reduction (A : Matrix (Cell n) D K) :=
  segreAlgebra (K := K) (n := n) ⧸ parameterIdeal (parameter A)

noncomputable def residueCoordinate (A : Matrix (Cell n) D K) (u : Cell n) : Reduction A :=
  Ideal.Quotient.mk _ (coordinate u)

abbrev PieceIndex (K : Type*) [Field K] (n : I → ℕ) (q : ℕ) :=
  Fin (Module.finrank K (piece (K := K) (n := n) q))

noncomputable def multiplyCell (q : ℕ) (u : Cell n) :
    piece (K := K) (n := n) q →ₗ[K] piece (K := K) (n := n) (q + 1) where
  toFun f := ⟨cellPolynomial u * f.val, cell_mul_mem_piece q u f.property⟩
  map_add' f g := by apply Subtype.ext; exact mul_add _ _ _
  map_smul' c f := by apply Subtype.ext; exact mul_smul_comm _ _ _

noncomputable def column (q : ℕ) (A : Matrix (Cell n) D K)
    (j : D × PieceIndex K n q) : piece (K := K) (n := n) (q + 1) :=
  ∑ u, A u j.1 • multiplyCell q u (pieceBasis q j.2)

theorem column_value (q : ℕ) (A : Matrix (Cell n) D K) (j : D × PieceIndex K n q) :
    (column q A j).val = segreForm A j.1 * (pieceBasis (K := K) q j.2).val := by
  change (piece (K := K) (n := n) (q + 1)).subtype
    (∑ u, A u j.1 • multiplyCell q u (pieceBasis q j.2)) = _
  rw [map_sum]
  simp only [map_smul, Submodule.subtype_apply]
  change (∑ u, A u j.1 • (cellPolynomial u * (pieceBasis q j.2).val)) = _
  simp only [segreForm, Finset.sum_mul, smul_mul_assoc]

/-- The full multiplication map from all parameter multiples of degree-q
polynomials, expressed in a chosen finite basis of that actual degree. -/
noncomputable def multiplication (q : ℕ) (A : Matrix (Cell n) D K) :
    (D × PieceIndex K n q → K) →ₗ[K] piece (K := K) (n := n) (q + 1) :=
  Fintype.linearCombination K (column q A)

noncomputable def multiplicationMatrix (q : ℕ) (A : Matrix (Cell n) D K) :
    Matrix (PieceIndex K n (q + 1)) (D × PieceIndex K n q) K :=
  fun i j => (pieceBasis (q + 1)).repr (column q A j) i

theorem multiplicationMatrix_mulVec (q : ℕ) (A : Matrix (Cell n) D K)
    (z : D × PieceIndex K n q → K) :
    multiplicationMatrix q A *ᵥ z = (pieceBasis (q + 1)).repr (multiplication q A z) := by
  funext i
  simp only [Matrix.mulVec, dotProduct, multiplicationMatrix, multiplication,
    Fintype.linearCombination_apply, map_sum, map_smul, Finset.sum_apply',
    Finsupp.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro j _
  exact mul_comm _ _

theorem multiplication_surjective_iff_rank (q : ℕ) (A : Matrix (Cell n) D K) :
    Function.Surjective (multiplication q A) ↔
      (multiplicationMatrix q A).rank = Module.finrank K (piece (K := K) (n := n) (q + 1)) := by
  rw [← show Fintype.card (PieceIndex K n (q + 1)) =
    Module.finrank K (piece (K := K) (n := n) (q + 1)) from Fintype.card_fin _,
    ← Matrix.mulVec_surjective_iff_rank_eq_card]
  constructor
  · intro h z
    obtain ⟨f,hf⟩ := (pieceBasis (K := K) (n := n) (q + 1)).repr.surjective
      (Finsupp.equivFunOnFinite.symm z)
    obtain ⟨c,hc⟩ := h f
    refine ⟨c, ?_⟩
    rw [multiplicationMatrix_mulVec, hc, hf]
    exact Finsupp.equivFunOnFinite.apply_symm_apply z
  · intro h f
    obtain ⟨c,hc⟩ := h (fun i => (pieceBasis (K := K) (n := n) (q + 1)).repr f i)
    refine ⟨c, (pieceBasis (q + 1)).repr.injective ?_⟩
    ext i
    exact congrFun ((multiplicationMatrix_mulVec q A c).symm.trans hc) i

/-- Every parameter product really belongs to the ambient parameter ideal. -/
theorem column_mem_ambientIdeal (q : ℕ) (A : Matrix (Cell n) D K)
    (j : D × PieceIndex K n q) :
    (column q A j).val ∈ ambientParameterIdeal (parameter A) := by
  rw [column_value, ← parameter_value]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_range_self j.1))

theorem multiplication_mem_ambientIdeal (q : ℕ) (A : Matrix (Cell n) D K)
    (z : D × PieceIndex K n q → K) :
    (multiplication q A z).val ∈ ambientParameterIdeal (parameter A) := by
  change (piece (K := K) (n := n) (q + 1)).subtype
    (∑ j, z j • column q A j) ∈ _
  rw [map_sum]
  apply Ideal.sum_mem
  intro j _
  rw [map_smul]
  rw [MvPolynomial.smul_eq_C_mul]
  exact Ideal.mul_mem_left _ _ (column_mem_ambientIdeal q A j)

/-- Surjectivity in degree q+1 forces every literal coordinate's (q+1)-st
power into the actual internal parameter ideal. -/
theorem coordinate_power_mem_of_surjective (q : ℕ) (A : Matrix (Cell n) D K)
    (h : Function.Surjective (multiplication q A)) (u : Cell n) :
    coordinate (K := K) u ^ (q + 1) ∈ parameterIdeal (parameter A) := by
  have hw : cellPolynomial (K := K) u ^ (q + 1) ∈ piece (K := K) (n := n) (q + 1) := by
    have hword : wordPolynomial (K := K) (q + 1) (fun _ => u) ∈
        piece (K := K) (n := n) (q + 1) :=
      Submodule.subset_span (Set.mem_range_self _)
    simpa only [wordPolynomial, Fin.prod_const] using hword
  obtain ⟨z,hz⟩ := h ⟨cellPolynomial u ^ (q + 1),hw⟩
  have hamb := multiplication_mem_ambientIdeal q A z
  rw [hz] at hamb
  apply homogeneous_mem_parameterIdeal (parameter A) (parameter_homogeneous A)
    q (coordinate u ^ (q + 1))
  · change (cellPolynomial (K := K) u ^ (q + 1)).IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree (q + 1))
    have hd : (q + 1) • diagonalDegree (I := I) 1 = diagonalDegree (q + 1) := by
      funext i
      simp [diagonalDegree, Pi.smul_apply, nsmul_eq_mul]
    simpa only [hd] using
      (cellPolynomial_homogeneous (K := K) u).pow (q + 1)
  · exact hamb

/-- The generic quotient is generated by the actual residue coordinates. -/
theorem residueCoordinates_generate (A : Matrix (Cell n) D K) :
    Algebra.adjoin K (Set.range (residueCoordinate A)) = ⊤ := by
  let π := Ideal.Quotient.mkₐ K (parameterIdeal (parameter A))
  let B := Algebra.adjoin K (Set.range (residueCoordinate A))
  have hgen : ∀ (f : MvPolynomial (Variables n) K) (hf : f ∈ segreAlgebra),
      π ⟨f,hf⟩ ∈ B := by
    intro f hf
    induction hf using Algebra.adjoin_induction with
    | mem f hf =>
        obtain ⟨u,rfl⟩ := hf
        exact Algebra.subset_adjoin (Set.mem_range_self u)
    | algebraMap c =>
        change π (algebraMap K (segreAlgebra (K := K) (n := n)) c) ∈ B
        rw [AlgHom.commutes]
        exact B.algebraMap_mem c
    | add f g hf hg ihf ihg =>
        change π (⟨f,hf⟩ + ⟨g,hg⟩) ∈ B
        rw [map_add]
        exact B.add_mem ihf ihg
    | mul f g hf hg ihf ihg =>
        change π (⟨f,hf⟩ * ⟨g,hg⟩) ∈ B
        rw [map_mul]
        exact B.mul_mem ihf ihg
  apply top_unique
  intro z _
  obtain ⟨f,rfl⟩ := Ideal.Quotient.mkₐ_surjective K (parameterIdeal (parameter A)) z
  exact hgen f.val f.property

/-- A surjective positive-degree multiplication map proves that the actual
parameter quotient is finite dimensional. -/
theorem reduction_finite_of_surjective (q : ℕ) (A : Matrix (Cell n) D K)
    (h : Function.Surjective (multiplication q A)) : Module.Finite K (Reduction A) := by
  have hnil : ∀ u, IsNilpotent (residueCoordinate A u) := by
    intro u
    refine ⟨q + 1, ?_⟩
    rw [residueCoordinate, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact coordinate_power_mem_of_surjective q A h u
  let B := Algebra.adjoin K (Set.range (residueCoordinate A))
  have hint (u : Cell n) : IsIntegral K (residueCoordinate A u) := by
    obtain ⟨r,hr⟩ := hnil u
    refine ⟨(Polynomial.X ^ r : Polynomial K), Polynomial.monic_X_pow r, ?_⟩
    change Polynomial.eval₂ (algebraMap K (Reduction A)) (residueCoordinate A u)
      (Polynomial.X ^ r) = 0
    rw [Polynomial.eval₂_X_pow]
    exact hr
  haveI : Module.Finite K B := Algebra.finite_adjoin_of_finite_of_isIntegral
    (R := K) (A := Reduction A) (s := Set.range (residueCoordinate A))
    (Set.finite_range _) (by rintro x ⟨u,rfl⟩; exact hint u)
  apply Module.Finite.of_surjective B.val.toLinearMap
  intro x
  refine ⟨⟨x, ?_⟩, rfl⟩
  change x ∈ Algebra.adjoin K (Set.range (residueCoordinate A))
  rw [residueCoordinates_generate]
  trivial

theorem reduction_artinian_of_surjective (q : ℕ) (A : Matrix (Cell n) D K)
    (h : Function.Surjective (multiplication q A)) : IsArtinianRing (Reduction A) := by
  letI := reduction_finite_of_surjective q A h
  exact IsArtinianRing.of_finite K _

end PaperVerification.Segre.GeneralParameters
end
end ProbeLayer46

section ProbeLayer47



/-!
# The actual first two homogeneous pieces of the Artinian Segre quotient

The spaces below are images of the full balanced homogeneous components in the
literal Artinian ring. Their kernels are proved to be exactly the parameter
span in degree one and the actual parameter-product span in degree two. Thus the
coordinate quotients used for multiplication ranks are linearly equivalent to
the actual quotient-ring components.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ActualQuotient

open Staircase Monomials Balanced RankParameters ParameterProducts
open scoped Matrix

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

theorem one_homogeneous (f : degreeOne (K := K) (n := n)) :
    f.val.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree 1) := by
  exact (le_of_eq (degreeOne_eq_balanced (K := K) (n := n))) f.property

theorem two_homogeneous (f : degreeTwo (K := K) (n := n)) :
    f.val.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree 2) := by
  exact (le_of_eq (degreeTwo_eq_balanced (K := K) (n := n))) f.property

noncomputable def liftOne : degreeOne (K := K) (n := n) →ₗ[K]
    segreAlgebra (K := K) (n := n) where
  toFun f := ⟨f.val, balancedComponent_le_segreAlgebra 1 (one_homogeneous f)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

noncomputable def liftTwo : degreeTwo (K := K) (n := n) →ₗ[K]
    segreAlgebra (K := K) (n := n) where
  toFun f := ⟨f.val, balancedComponent_le_segreAlgebra 2 (two_homogeneous f)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem liftOne_forms (r : Ranks n) :
    liftOne (ActualLefschetz.forms (rankForms (K := K) (n := n)) r) =
      Artinian.rankParameter r := by
  apply Subtype.ext
  change (ActualLefschetz.forms (rankForms (K := K) (n := n)) r).val = _
  rw [ActualLefschetz.forms_value, Artinian.rankParameter_value]
  apply Finset.sum_congr rfl
  intro u _
  simp [rankForms, rankIndex, Fin.ext_iff, ite_smul]

theorem forms_value_rankParameter (r : Ranks n) :
    (ActualLefschetz.forms (rankForms (K := K) (n := n)) r).val =
      (Artinian.rankParameter r).val :=
  congrArg Subtype.val (liftOne_forms r)

noncomputable def oneToReduction : degreeOne (K := K) (n := n) →ₗ[K]
    Artinian.Reduction (K := K) (n := n) :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (Artinian.rankParameter (K := K) (n := n)))).toLinearMap.comp liftOne

noncomputable def twoToReduction : degreeTwo (K := K) (n := n) →ₗ[K]
    Artinian.Reduction (K := K) (n := n) :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (Artinian.rankParameter (K := K) (n := n)))).toLinearMap.comp liftTwo

/-- The actual degree-one component, as a subspace of the actual Artinian ring. -/
noncomputable def actualDegreeOne : Submodule K (Artinian.Reduction (K := K) (n := n)) :=
  LinearMap.range (oneToReduction (K := K) (n := n))

/-- The actual degree-two component, as a subspace of the actual Artinian ring. -/
noncomputable def actualDegreeTwo : Submodule K (Artinian.Reduction (K := K) (n := n)) :=
  LinearMap.range (twoToReduction (K := K) (n := n))

/-- There are precisely the specified linear parameter relations in degree one. -/
theorem kernel_oneToReduction : LinearMap.ker (oneToReduction (K := K) (n := n)) =
    LefschetzBridge.parameterSpan (ActualLefschetz.forms (rankForms (K := K) (n := n))) := by
  apply le_antisymm
  · intro f hf
    have hmem : liftOne f ∈ parameterIdeal (Artinian.rankParameter (K := K) (n := n)) := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      exact hf
    have ha := mem_ambient_of_mem_parameterIdeal _ hmem
    obtain ⟨c, hc, he⟩ := homogeneous_ideal_representation
      (fun r : Ranks n => (Artinian.rankParameter (K := K) r).val)
      Artinian.rankParameter_homogeneous 0 f.val (one_homogeneous f) ha
    apply (Submodule.mem_span_range_iff_exists_fun K).mpr
    refine ⟨fun r => (c r).coeff 0, ?_⟩
    apply Subtype.ext
    change (degreeOne (K := K) (n := n)).subtype
      (∑ r, (c r).coeff 0 • ActualLefschetz.forms (rankForms (K := K) (n := n)) r) = f.val
    rw [map_sum]
    simp only [map_smul]
    calc
      _ = ∑ r, c r * (Artinian.rankParameter (K := K) r).val := by
        apply Finset.sum_congr rfl
        intro r _
        change (c r).coeff 0 • (ActualLefschetz.forms
          (rankForms (K := K) (n := n)) r).val =
            c r * (Artinian.rankParameter (K := K) r).val
        rw [forms_value_rankParameter]
        exact (MvPolynomial.smul_eq_C_mul _ _).trans
          (congrArg (fun x => x * (Artinian.rankParameter (K := K) r).val)
            (balanced_zero_polynomial (c r) (hc r)).symm)
      _ = f.val := he
  · apply Submodule.span_le.mpr
    rintro f ⟨r, rfl⟩
    change Ideal.Quotient.mk _ (liftOne (ActualLefschetz.forms (rankForms (K := K) (n := n)) r)) = 0
    rw [liftOne_forms, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_range_self r)

/-- Actual parameter products lie in the extended ideal, with their literal
polynomial interpretation unchanged. -/
theorem productSpan_le_ambientIdeal : productSpan (rankForms (K := K) (n := n)) ≤
    (ambientParameterIdeal (Artinian.rankParameter (K := K) (n := n))).restrictScalars K := by
  apply Submodule.span_le.mpr
  rintro f ⟨⟨r,u⟩, rfl⟩
  change Degeneration.segreForm rankForms r * cellPolynomial u ∈ ambientParameterIdeal _
  have he : Degeneration.segreForm (rankForms (K := K) (n := n)) r =
      (Artinian.rankParameter r).val := by
    rw [← ActualLefschetz.forms_value, forms_value_rankParameter]
  rw [he]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_range_self r))

/-- In degree two, the actual quotient-ring kernel is exactly the proved
parameter-product subspace; no higher-degree relation creates an extra kernel. -/
theorem kernel_twoToReduction : LinearMap.ker (twoToReduction (K := K) (n := n)) =
    productsInDegreeTwo (rankForms (K := K) (n := n)) := by
  ext f
  constructor
  · intro hf
    have hmem : liftTwo f ∈ parameterIdeal (Artinian.rankParameter (K := K) (n := n)) := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      exact hf
    have ha := mem_ambient_of_mem_parameterIdeal _ hmem
    obtain ⟨c, hc, he⟩ := homogeneous_ideal_representation
      (fun r : Ranks n => (Artinian.rankParameter (K := K) r).val)
      Artinian.rankParameter_homogeneous 1 f.val (two_homogeneous f) ha
    let g : Ranks n → degreeOne (K := K) (n := n) := fun r =>
      ⟨c r, by rw [degreeOne_eq_balanced]; exact hc r⟩
    change f.val ∈ productSpan (rankForms (K := K) (n := n))
    rw [← ActualLefschetz.range_actual_multiply]
    refine ⟨g, ?_⟩
    unfold LefschetzBridge.multiply ActualLefschetz.polynomialProduct
    change (∑ r, (ActualLefschetz.forms (rankForms (K := K) (n := n)) r).val *
      (g r).val) = f.val
    calc
      _ = ∑ r, c r * (Artinian.rankParameter (K := K) r).val := by
        apply Finset.sum_congr rfl
        intro r _
        change (ActualLefschetz.forms (rankForms (K := K) (n := n)) r).val * c r = _
        rw [forms_value_rankParameter, mul_comm]
      _ = f.val := he
  · intro hf
    change Ideal.Quotient.mk _ (liftTwo f) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply homogeneous_mem_parameterIdeal (Artinian.rankParameter (K := K) (n := n))
      Artinian.rankParameter_homogeneous 1 (liftTwo f) (two_homogeneous f)
    exact productSpan_le_ambientIdeal hf

/-- The source quotient used in the Lefschetz calculation is the actual first
homogeneous component of the Artinian ring. -/
noncomputable def degreeOneQuotientEquiv :
    (degreeOne (K := K) (n := n) ⧸ LefschetzBridge.parameterSpan (K := K)
      (ActualLefschetz.forms (rankForms (K := K) (n := n)))) ≃ₗ[K]
      actualDegreeOne (K := K) (n := n) :=
  (Submodule.quotEquivOfEq _ _ (kernel_oneToReduction (K := K) (n := n)).symm).trans
    (oneToReduction (K := K) (n := n)).quotKerEquivRange

/-- The target quotient used in the matrix calculation is the actual second
homogeneous component of the Artinian ring. -/
noncomputable def degreeTwoQuotientEquiv :
    (degreeTwo (K := K) (n := n) ⧸ productsInDegreeTwo (rankForms (K := K) (n := n))) ≃ₗ[K]
      actualDegreeTwo (K := K) (n := n) :=
  (Submodule.quotEquivOfEq _ _ (kernel_twoToReduction (K := K) (n := n)).symm).trans
    (twoToReduction (K := K) (n := n)).quotKerEquivRange

/-- The actual Artinian quotient has the degree-two dimension established by
the unrestricted rank-sum exactness proof. -/
theorem finrank_actualDegreeTwo [Infinite K] :
    Module.finrank K (actualDegreeTwo (K := K) (n := n)) =
      Fintype.card (SortedPair n) -
        (Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2) :=
  (degreeTwoQuotientEquiv (K := K) (n := n)).finrank_eq.symm.trans
    (finrank_fixed_degreeTwo_quotient (K := K) (n := n))


/-- The product of two actual degree-one polynomials lies in the full actual
second homogeneous component. -/
noncomputable def degreeOneProduct (f g : degreeOne (K := K) (n := n)) :
    degreeTwo (K := K) (n := n) :=
  ⟨f.val * g.val, by
    rw [degreeTwo_eq_balanced]
    change (f.val * g.val).IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree 2)
    have h := (one_homogeneous f).mul (one_homogeneous g)
    have hd : diagonalDegree (I := I) 1 + diagonalDegree 1 = diagonalDegree 2 := by
      funext i
      rfl
    rw [hd] at h
    exact h⟩

/-- Multiplication survives both homogeneous inclusions and the actual ring
quotient. This is a literal ring identity, not a chosen coordinate operation. -/
theorem twoToReduction_product (f g : degreeOne (K := K) (n := n)) :
    twoToReduction (K := K) (n := n) (degreeOneProduct f g) =
      oneToReduction (K := K) (n := n) f * oneToReduction (K := K) (n := n) g := by
  let π := Ideal.Quotient.mkₐ K (parameterIdeal (Artinian.rankParameter (K := K) (n := n)))
  have he : liftTwo (degreeOneProduct f g) = liftOne f * liftOne g := Subtype.ext rfl
  change π (liftTwo (degreeOneProduct f g)) = π (liftOne f) * π (liftOne g)
  rw [he, map_mul]

/-- The actual degree-one residue of a homogeneous polynomial. -/
noncomputable def homogeneousResidue (f : degreeOne (K := K) (n := n)) :
    actualDegreeOne (K := K) (n := n) := ⟨oneToReduction (K := K) (n := n) f, ⟨f, rfl⟩⟩

/-- The first Lefschetz map is multiplication in the actual Artinian ring,
with its domain and codomain the actual homogeneous subspaces. -/
noncomputable def firstLefschetz (ℓ : degreeOne (K := K) (n := n)) :
    actualDegreeOne (K := K) (n := n) →ₗ[K] actualDegreeTwo (K := K) (n := n) where
  toFun x := ⟨oneToReduction (K := K) (n := n) ℓ * x.val, by
    obtain ⟨f, hf⟩ := x.property
    refine ⟨degreeOneProduct ℓ f, ?_⟩
    rw [twoToReduction_product, hf]⟩
  map_add' x y := by
    apply Subtype.ext
    exact mul_add _ _ _
  map_smul' a x := by
    apply Subtype.ext
    exact mul_smul_comm _ _ _

/-- The kernel test for the actual first Lefschetz map agrees exactly with the
parameter-product test in the original factor-polynomial ring. -/
theorem firstLefschetz_zero_iff (ℓ f : degreeOne (K := K) (n := n)) :
    firstLefschetz ℓ (homogeneousResidue f) = 0 ↔
      ℓ.val * f.val ∈ productSpan (rankForms (K := K) (n := n)) := by
  have he : firstLefschetz ℓ (homogeneousResidue f) = 0 ↔
      degreeOneProduct ℓ f ∈ LinearMap.ker (twoToReduction (K := K) (n := n)) := by
    constructor
    · intro h
      change twoToReduction (K := K) (n := n) (degreeOneProduct ℓ f) = 0
      rw [twoToReduction_product]
      have hh := congrArg Subtype.val h
      change oneToReduction (K := K) (n := n) ℓ *
        oneToReduction (K := K) (n := n) f = 0 at hh
      exact hh
    · intro h
      apply Subtype.ext
      change oneToReduction (K := K) (n := n) ℓ * oneToReduction (K := K) (n := n) f = 0
      rw [← twoToReduction_product]
      exact LinearMap.mem_ker.mp h
  rw [he, kernel_twoToReduction]
  rfl

/-- The coordinate kernel criterion is equivalent to injectivity of the map
in the literal Artinian quotient. Thus proving the criterion loses no
hypotheses or mathematical content at the ring-to-matrix bridge. -/
theorem firstLefschetz_injective_iff (ℓ : degreeOne (K := K) (n := n)) :
    Function.Injective (firstLefschetz ℓ) ↔
      ∀ f : degreeOne (K := K) (n := n),
        ℓ.val * f.val ∈ productSpan (rankForms (K := K) (n := n)) →
          f ∈ LefschetzBridge.parameterSpan (K := K)
            (ActualLefschetz.forms (rankForms (K := K) (n := n))) := by
  constructor
  · intro hinj f hf
    have hmapzero : firstLefschetz ℓ (0 : actualDegreeOne (K := K) (n := n)) = 0 := by
      apply Subtype.ext
      exact mul_zero _
    have hz : homogeneousResidue f = 0 :=
      hinj (((firstLefschetz_zero_iff ℓ f).mpr hf).trans hmapzero.symm)
    rw [← kernel_oneToReduction, LinearMap.mem_ker]
    have hz' := congrArg Subtype.val hz
    change oneToReduction (K := K) (n := n) f = 0 at hz'
    exact hz'
  · intro h x y hxy
    obtain ⟨f, hf⟩ := (x - y).property
    have he : homogeneousResidue f = x - y := by
      apply Subtype.ext
      change oneToReduction (K := K) (n := n) f = (x - y).val
      exact hf
    have hz : firstLefschetz ℓ (homogeneousResidue f) = 0 := by
      rw [he]
      apply Subtype.ext
      change oneToReduction (K := K) (n := n) ℓ * (x.val-y.val)=0
      rw [mul_sub]
      exact sub_eq_zero.mpr (congrArg Subtype.val hxy)
    have hp := h f ((firstLefschetz_zero_iff ℓ f).mp hz)
    rw [← kernel_oneToReduction] at hp
    have hzero : homogeneousResidue f = 0 := by
      apply Subtype.ext
      change oneToReduction (K := K) (n := n) f = 0
      exact LinearMap.mem_ker.mp hp
    exact sub_eq_zero.mp (he.symm.trans hzero)

/-- The rank sums are linearly independent in the actual degree-one space:
reading the coefficient at one representative of each rank recovers it. -/
theorem rankForms_linearIndependent : LinearIndependent K
    (ActualLefschetz.forms (rankForms (K := K) (n := n))) := by
  classical
  apply linearIndependent_iff_injective_fintypeLinearCombination.mpr
  intro a b hab
  funext r
  have h := congrArg (fun f : degreeOne (K := K) (n := n) =>
    (ActualLefschetz.coordinates.symm f) (representative r)) hab
  simpa [Fintype.linearCombination_apply, ActualLefschetz.forms,
    rankForms, rankIndex_representative, Pi.smul_apply, smul_eq_mul,
    Finset.sum_apply] using h

/-- The first homogeneous component has the stated Hilbert-function value,
with no characteristic or genericity assumption. -/
theorem finrank_actualDegreeOne :
    Module.finrank K (actualDegreeOne (K := K) (n := n)) =
      Fintype.card (Cell n) - (sideSum n + 1) := by
  letI : Module.Finite K (degreeOne (K := K) (n := n)) :=
    Module.Finite.of_basis (degreeOneBasis (K := K) (n := n))
  calc
    _ = Module.finrank K (degreeOne (K := K) (n := n) ⧸
        LefschetzBridge.parameterSpan (K := K) (ActualLefschetz.forms (rankForms (K := K) (n := n)))) :=
      (degreeOneQuotientEquiv (K := K) (n := n)).finrank_eq.symm
    _ = Module.finrank K (degreeOne (K := K) (n := n)) -
        Module.finrank K (LefschetzBridge.parameterSpan (K := K)
          (ActualLefschetz.forms (rankForms (K := K) (n := n)))) :=
      Submodule.finrank_quotient _
    _ = _ := by
      rw [Module.finrank_eq_card_basis (degreeOneBasis (K := K) (n := n)),
        LefschetzBridge.parameterSpan, finrank_span_eq_card rankForms_linearIndependent]
      simp only [Ranks, Fintype.card_fin]


/-- A basis generator maps to its literal residue coordinate. -/
@[simp] theorem oneToReduction_basis (u : Cell n) :
    oneToReduction (K := K) (n := n) (degreeOneBasis (K := K) u) =
      Artinian.residueCoordinate (K := K) (n := n) u := by
  change Ideal.Quotient.mk _ (liftOne (degreeOneBasis (K := K) u)) =
    Ideal.Quotient.mk _ (Artinian.coordinate u)
  congr 1
  apply Subtype.ext
  change (degreeOneBasis (K := K) (n := n) u).val = cellPolynomial u
  exact Module.Basis.coe_span_apply _ _

/-- The sorted second-degree basis maps to its literal coordinate product. -/
@[simp] theorem twoToReduction_basis (q : SortedPair n) :
    twoToReduction (K := K) (n := n) (degreeTwoBasis (K := K) q) =
      Artinian.residueCoordinate (K := K) (n := n) q.val.1 *
        Artinian.residueCoordinate (K := K) (n := n) q.val.2 := by
  have h : liftTwo (degreeTwoBasis (K := K) q) =
      Artinian.coordinate q.val.1 * Artinian.coordinate q.val.2 := by
    apply Subtype.ext
    simp [liftTwo, degreeTwoBasis, Module.Basis.map_apply,
      LinearEquiv.coe_ofEq_apply, Module.Basis.coe_span_apply,
      Artinian.coordinate, sortedMonomial_eq_mul]
  change Ideal.Quotient.mk _ (liftTwo (degreeTwoBasis (K := K) q)) = _
  rw [h, map_mul]
  rfl

/-- The actual first homogeneous component is generated by all literal residue
coordinates, with no choice of a smaller printed source list. -/
theorem actualDegreeOne_eq_coordinateSpan : actualDegreeOne (K := K) (n := n) =
    Submodule.span K (Set.range (Artinian.residueCoordinate (K := K) (n := n))) := by
  have h : actualDegreeOne (K := K) (n := n) = Submodule.span K
      (Set.range fun u => oneToReduction (K := K) (n := n) (degreeOneBasis (K := K) (n := n) u)) := by
    rw [actualDegreeOne, LinearMap.range_eq_map,
      ← (degreeOneBasis (K := K) (n := n)).span_eq, Submodule.map_span, ← Set.range_comp]
    rfl
  simpa only [oneToReduction_basis] using h

/-- The actual second homogeneous component is generated by all products of
literal residue coordinates. -/
theorem actualDegreeTwo_eq_coordinateProductSpan : actualDegreeTwo (K := K) (n := n) =
    Submodule.span K (Set.range fun uv : Cell n × Cell n =>
      Artinian.residueCoordinate (K := K) uv.1 * Artinian.residueCoordinate (K := K) (n := n) uv.2) := by
  apply le_antisymm
  · rw [actualDegreeTwo, LinearMap.range_eq_map,
      ← (degreeTwoBasis (K := K) (n := n)).span_eq, Submodule.map_span, ← Set.range_comp]
    apply Submodule.span_le.mpr
    rintro _ ⟨q, rfl⟩
    change twoToReduction (K := K) (n := n) (degreeTwoBasis (K := K) (n := n) q) ∈ _
    rw [twoToReduction_basis]
    exact Submodule.subset_span ⟨q.val, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨u,v⟩, rfl⟩
    refine ⟨degreeOneProduct (K := K) (n := n)
      (degreeOneBasis (K := K) (n := n) u)
      (degreeOneBasis (K := K) (n := n) v), ?_⟩
    rw [twoToReduction_product, oneToReduction_basis, oneToReduction_basis]

/-- Every prescribed rank sum is zero in the actual Artinian quotient. -/
theorem residue_rankSum (r : Ranks n) :
    (∑ u : Cell n, rankForms (K := K) (n := n) u r • Artinian.residueCoordinate (K := K) u) = 0 := by
  let π := Ideal.Quotient.mkₐ K (parameterIdeal (Artinian.rankParameter (K := K) (n := n)))
  have h : π (Artinian.rankParameter r) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self r))
  change (∑ u : Cell n, rankForms (K := K) (n := n) u r • π (Artinian.coordinate u)) = 0
  simpa only [Artinian.rankParameter, map_sum, map_smul] using h

end PaperVerification.Segre.ActualQuotient
end
end ProbeLayer47

section ProbeLayer48



/-!
# The first two pieces for arbitrary actual linear parameters

These are subspaces of the literal quotient of the Segre subalgebra. Balanced
homogeneous projection proves the exact kernels of the degree-one and degree-two
quotient maps, for every coefficient matrix, independently of Artinianness.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GeneralQuotient

open Staircase Monomials Balanced ParameterProducts GeneralParameters ActualLefschetz
open ActualQuotient (liftOne liftTwo one_homogeneous two_homogeneous degreeOneProduct)
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

variable (A : Matrix (Cell n) D K)

theorem liftOne_forms (d : D) : liftOne (forms A d) = parameter A d := by
  apply Subtype.ext
  exact (forms_value A d).trans (parameter_value A d).symm

theorem forms_value_parameter (d : D) : (forms A d).val = (parameter A d).val :=
  congrArg Subtype.val (liftOne_forms A d)

noncomputable def oneToReduction : degreeOne (K := K) (n := n) →ₗ[K] Reduction A :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (parameter A))).toLinearMap.comp liftOne

noncomputable def twoToReduction : degreeTwo (K := K) (n := n) →ₗ[K] Reduction A :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (parameter A))).toLinearMap.comp liftTwo

noncomputable def actualDegreeOne : Submodule K (Reduction A) := LinearMap.range (oneToReduction A)
noncomputable def actualDegreeTwo : Submodule K (Reduction A) := LinearMap.range (twoToReduction A)

/-- No extra linear relation is introduced by the full ideal. -/
theorem kernel_oneToReduction : LinearMap.ker (oneToReduction A) =
    LefschetzBridge.parameterSpan (K := K) (forms A) := by
  apply le_antisymm
  · intro f hf
    have hmem : liftOne f ∈ parameterIdeal (parameter A) := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      exact hf
    have ha := mem_ambient_of_mem_parameterIdeal _ hmem
    obtain ⟨c,hc,he⟩ := homogeneous_ideal_representation
      (fun d => (parameter A d).val) (parameter_homogeneous A) 0 f.val
      (one_homogeneous f) ha
    apply (Submodule.mem_span_range_iff_exists_fun K).mpr
    refine ⟨fun d => (c d).coeff 0, ?_⟩
    apply Subtype.ext
    change (degreeOne (K := K) (n := n)).subtype
      (∑ d, (c d).coeff 0 • forms A d) = f.val
    rw [map_sum]
    simp only [map_smul]
    calc
      _ = ∑ d, c d * (parameter A d).val := by
        apply Finset.sum_congr rfl
        intro d _
        change (c d).coeff 0 • (forms A d).val = c d * (parameter A d).val
        rw [forms_value_parameter]
        exact (MvPolynomial.smul_eq_C_mul _ _).trans
          (congrArg (fun x => x * (parameter A d).val)
            (balanced_zero_polynomial (c d) (hc d)).symm)
      _ = f.val := he
  · apply Submodule.span_le.mpr
    rintro f ⟨d,rfl⟩
    change Ideal.Quotient.mk _ (liftOne (forms A d)) = 0
    rw [liftOne_forms, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_range_self d)

theorem productSpan_le_ambientIdeal : productSpan A ≤
    (ambientParameterIdeal (parameter A)).restrictScalars K := by
  apply Submodule.span_le.mpr
  rintro f ⟨⟨d,u⟩,rfl⟩
  change Degeneration.segreForm A d * cellPolynomial u ∈ ambientParameterIdeal _
  rw [← parameter_value]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_range_self d))

/-- Homogeneous projection discharges all possible higher-degree ideal
representations and identifies the literal degree-two kernel exactly. -/
theorem kernel_twoToReduction : LinearMap.ker (twoToReduction A) = productsInDegreeTwo A := by
  ext f
  constructor
  · intro hf
    have hmem : liftTwo f ∈ parameterIdeal (parameter A) := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      exact hf
    have ha := mem_ambient_of_mem_parameterIdeal _ hmem
    obtain ⟨c,hc,he⟩ := homogeneous_ideal_representation
      (fun d => (parameter A d).val) (parameter_homogeneous A) 1 f.val
      (two_homogeneous f) ha
    let g : D → degreeOne (K := K) (n := n) := fun d =>
      ⟨c d, by rw [degreeOne_eq_balanced]; exact hc d⟩
    change f.val ∈ productSpan A
    rw [← range_actual_multiply]
    refine ⟨g, ?_⟩
    change (∑ d, (forms A d).val * (g d).val) = f.val
    calc
      _ = ∑ d, c d * (parameter A d).val := by
        apply Finset.sum_congr rfl
        intro d _
        change (forms A d).val * c d = _
        rw [forms_value_parameter,mul_comm]
      _ = f.val := he
  · intro hf
    change Ideal.Quotient.mk _ (liftTwo f) = 0
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply homogeneous_mem_parameterIdeal (parameter A) (parameter_homogeneous A)
      1 (liftTwo f) (two_homogeneous f)
    exact productSpan_le_ambientIdeal A hf

noncomputable def degreeOneQuotientEquiv :
    (degreeOne (K := K) (n := n) ⧸ LefschetzBridge.parameterSpan (K := K) (forms A)) ≃ₗ[K]
      actualDegreeOne A :=
  (Submodule.quotEquivOfEq _ _ (kernel_oneToReduction A).symm).trans
    (oneToReduction A).quotKerEquivRange

noncomputable def degreeTwoQuotientEquiv :
    (degreeTwo (K := K) (n := n) ⧸ productsInDegreeTwo A) ≃ₗ[K] actualDegreeTwo A :=
  (Submodule.quotEquivOfEq _ _ (kernel_twoToReduction A).symm).trans
    (twoToReduction A).quotKerEquivRange

theorem finrank_actualDegreeTwo : Module.finrank K (actualDegreeTwo A) =
    Fintype.card (SortedPair n) - (Degeneration.multiplicationMatrix 1 A).rank :=
  (degreeTwoQuotientEquiv A).finrank_eq.symm.trans (finrank_degreeTwo_mod_products A)

theorem twoToReduction_product (f g : degreeOne (K := K) (n := n)) :
    twoToReduction A (degreeOneProduct f g) = oneToReduction A f * oneToReduction A g := by
  let π := Ideal.Quotient.mkₐ K (parameterIdeal (parameter A))
  have he : liftTwo (degreeOneProduct f g) = liftOne f * liftOne g := Subtype.ext rfl
  change π (liftTwo (degreeOneProduct f g)) = π (liftOne f) * π (liftOne g)
  rw [he,map_mul]

noncomputable def homogeneousResidue (f : degreeOne (K := K) (n := n)) : actualDegreeOne A :=
  ⟨oneToReduction A f, ⟨f,rfl⟩⟩

/-- Multiplication in the actual quotient ring, restricted to its full first
and second homogeneous components. -/
noncomputable def firstLefschetz (ℓ : degreeOne (K := K) (n := n)) :
    actualDegreeOne A →ₗ[K] actualDegreeTwo A where
  toFun x := ⟨oneToReduction A ℓ * x.val, by
    obtain ⟨f,hf⟩ := x.property
    refine ⟨degreeOneProduct ℓ f, ?_⟩
    rw [twoToReduction_product,hf]⟩
  map_add' x y := Subtype.ext (mul_add _ _ _)
  map_smul' c x := Subtype.ext (mul_smul_comm _ _ _)

theorem firstLefschetz_zero_iff (ℓ f : degreeOne (K := K) (n := n)) :
    firstLefschetz A ℓ (homogeneousResidue A f) = 0 ↔ ℓ.val * f.val ∈ productSpan A := by
  have he : firstLefschetz A ℓ (homogeneousResidue A f) = 0 ↔
      degreeOneProduct ℓ f ∈ LinearMap.ker (twoToReduction A) := by
    constructor
    · intro h
      change twoToReduction A (degreeOneProduct ℓ f) = 0
      rw [twoToReduction_product]
      exact congrArg Subtype.val h
    · intro h
      apply Subtype.ext
      change oneToReduction A ℓ * oneToReduction A f = 0
      rw [← twoToReduction_product]
      exact h
  rw [he,kernel_twoToReduction]
  rfl

theorem firstLefschetz_injective_iff (ℓ : degreeOne (K := K) (n := n)) :
    Function.Injective (firstLefschetz A ℓ) ↔
      ∀ f : degreeOne (K := K) (n := n), ℓ.val * f.val ∈ productSpan A →
        f ∈ LefschetzBridge.parameterSpan (K := K) (forms A) := by
  constructor
  · intro hinj f hf
    have hmapzero : firstLefschetz A ℓ (0 : actualDegreeOne A) = 0 := by
      apply Subtype.ext
      exact mul_zero _
    have hz : homogeneousResidue A f = 0 :=
      hinj (((firstLefschetz_zero_iff A ℓ f).mpr hf).trans hmapzero.symm)
    rw [← kernel_oneToReduction]
    exact congrArg Subtype.val hz
  · intro h x y hxy
    obtain ⟨f,hf⟩ := (x - y).property
    have he : homogeneousResidue A f = x - y := Subtype.ext hf
    have hz : firstLefschetz A ℓ (homogeneousResidue A f) = 0 := by
      rw [he]
      apply Subtype.ext
      change oneToReduction A ℓ * (x.val-y.val)=0
      rw [mul_sub]
      exact sub_eq_zero.mpr (congrArg Subtype.val hxy)
    have hp := h f ((firstLefschetz_zero_iff A ℓ f).mp hz)
    rw [← kernel_oneToReduction] at hp
    have hzero : homogeneousResidue A f = 0 := Subtype.ext hp
    exact sub_eq_zero.mp (he.symm.trans hzero)

theorem forms_linearIndependent (hA : Function.Surjective A.vecMul) :
    LinearIndependent K (forms A) := by
  classical
  obtain ⟨L,hL⟩ := Matrix.vecMul_surjective_iff_exists_left_inverse.mp hA
  have hcol : LinearIndependent K A.col := Matrix.mulVec_injective_iff.mp (by
    intro a b hab
    have h := congrArg (fun v => L *ᵥ v) hab
    simpa only [Matrix.mulVec_mulVec,hL,Matrix.one_mulVec] using h)
  exact hcol.map' (coordinates (K := K) (n := n)).toLinearMap
    (LinearMap.ker_eq_bot.mpr (coordinates (K := K) (n := n)).injective)

theorem finrank_actualDegreeOne (hA : Function.Surjective A.vecMul) :
    Module.finrank K (actualDegreeOne A) = Fintype.card (Cell n) - Fintype.card D := by
  letI : Module.Finite K (degreeOne (K := K) (n := n)) :=
    Module.Finite.of_basis (degreeOneBasis (K := K) (n := n))
  calc
    _ = Module.finrank K (degreeOne (K := K) (n := n) ⧸
        LefschetzBridge.parameterSpan (K := K) (forms A)) :=
      (degreeOneQuotientEquiv A).finrank_eq.symm
    _ = Module.finrank K (degreeOne (K := K) (n := n)) -
        Module.finrank K (LefschetzBridge.parameterSpan (K := K) (forms A)) :=
      Submodule.finrank_quotient _
    _ = _ := by
      rw [Module.finrank_eq_card_basis (degreeOneBasis (K := K) (n := n)),
        LefschetzBridge.parameterSpan,finrank_span_eq_card (forms_linearIndependent A hA)]

end PaperVerification.Segre.GeneralQuotient
end
end ProbeLayer48

section ProbeLayer49



/-!
# Parameters and Artinian reductions under the symmetric-power comparison

The coordinates are actual pure symmetric tensors of degree one. Their image
under the canonical Segre isomorphism is the original coordinate monomial.
Every coefficient matrix therefore gives matching parameter ideals and an
algebra isomorphism of the complete quotients. The first two homogeneous
images are identified explicitly below.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
set_option synthInstance.maxHeartbeats 100000

@[expose] public section

namespace PaperVerification.Segre.SymmetricRealization

open Staircase Monomials Balanced HigherPieces Artinian
open scoped TensorProduct DirectSum

variable {I D : Type*} [Fintype I] [DecidableEq I] [Nonempty I]
  [Fintype D] [DecidableEq D] {n : I → ℕ}
variable {F : Type} [Field F]

/-- Cache the canonical graded direct-sum ring before concrete parameter ideals
are elaborated. No operations or algebra structure are transported anew. -/
noncomputable instance symmetricSegreCommRing :
    CommRing (SymmetricSegre (F := F) (n := n)) := by
  letI : DirectSum.GCommRing (SymmetricTensor (F := F) (n := n)) :=
    tensorGCommRing (F := F) (n := n)
  exact DirectSum.commRing (A := SymmetricTensor (F := F) (n := n))

noncomputable instance symmetricSegreAlgebra :
    Algebra F (SymmetricSegre (F := F) (n := n)) := inferInstance

noncomputable instance symmetricSegreModule :
    Module F (SymmetricSegre (F := F) (n := n)) := inferInstance

/-- A tensor of the coordinate vectors, each regarded in its actual first
symmetric power. -/
noncomputable def coordinateTensor (u : Cell n) : SymmetricTensor (F := F) (n := n) 1 :=
  PiTensorProduct.tprod F (fun i => SymmetricPower.tprod F
    (fun _ : Fin 1 => Pi.basisFun F (Fin (n i+1)) (u i)))

@[simp] theorem factorSymmetricEquiv_coordinate (i : I) (j : Fin (n i+1)) :
    (factorSymmetricEquiv (F := F) 1 i (SymmetricPower.tprod F
      (fun _ : Fin 1 => Pi.basisFun F (Fin (n i+1)) j))).val = MvPolynomial.X j := by
  rw [factorSymmetricEquiv_value,TauCeti.SymmetricPower.toSymmetricAlgebra_tprod,
    Fin.prod_univ_one,SymmetricAlgebra.equivMvPolynomial_ι_apply]

@[simp] theorem symmetricTensorEquiv_coordinateTensor (u : Cell n) :
    (symmetricTensorEquiv (F := F) 1 (coordinateTensor u)).val=cellPolynomial u := by
  rw [coordinateTensor,symmetricTensorEquiv_tprod,cellPolynomial_eq_prod]
  simp only [factorSymmetricEquiv_coordinate,MvPolynomial.rename_X]

noncomputable def symmetricCoordinate (u : Cell n) : SymmetricSegre (F := F) (n := n) :=
  DirectSum.of _ 1 (coordinateTensor u)

@[simp] theorem symmetricSegreEquiv_coordinate (u : Cell n) :
    symmetricSegreEquiv (symmetricCoordinate (F := F) u)=coordinate (K := F) u := by
  apply Subtype.ext
  rw [symmetricCoordinate,symmetricSegreEquiv_of,symmetricTensorEquiv_coordinateTensor]
  rfl

/-- An arbitrary linear parameter, with exactly the paper's coordinate coefficients. -/
noncomputable def symmetricParameter (A : Matrix (Cell n) D F) (d : D) :
    SymmetricSegre (F := F) (n := n) := ∑ u, A u d • symmetricCoordinate u

@[simp] theorem symmetricSegreEquiv_parameter (A : Matrix (Cell n) D F) (d : D) :
    symmetricSegreEquiv (symmetricParameter A d)=GeneralParameters.parameter A d := by
  simp only [symmetricParameter,GeneralParameters.parameter,map_sum,map_smul,
    symmetricSegreEquiv_coordinate]

noncomputable def symmetricParameterIdeal (A : Matrix (Cell n) D F) :
    Ideal (SymmetricSegre (F := F) (n := n)) := Ideal.span (Set.range (symmetricParameter A))

theorem map_symmetricParameterIdeal (A : Matrix (Cell n) D F) :
    (symmetricParameterIdeal A).map (symmetricSegreEquiv (F := F) (n := n)).toRingHom =
      parameterIdeal (GeneralParameters.parameter A) := by
  rw [symmetricParameterIdeal,parameterIdeal,Ideal.map_span,← Set.range_comp]
  apply congrArg (fun S : Set (segreAlgebra (K := F) (n := n)) => Ideal.span S)
  apply congrArg Set.range
  funext d
  exact symmetricSegreEquiv_parameter A d

abbrev SymmetricReduction (A : Matrix (Cell n) D F) :=
  SymmetricSegre (F := F) (n := n) ⧸ symmetricParameterIdeal A

/-- These are the standard ideal-quotient instances on the literal reduction. -/
noncomputable instance symmetricReductionCommRing (A : Matrix (Cell n) D F) :
    CommRing (SymmetricReduction A) := Ideal.Quotient.commRing _

noncomputable instance symmetricReductionAlgebra (A : Matrix (Cell n) D F) :
    Algebra F (SymmetricReduction A) := inferInstance

noncomputable instance symmetricReductionModule (A : Matrix (Cell n) D F) :
    Module F (SymmetricReduction A) := inferInstance

/-- The complete quotient rings, with the same parameter coefficient matrix,
are canonically isomorphic as algebras. -/
noncomputable def symmetricReductionEquiv (A : Matrix (Cell n) D F) :
    SymmetricReduction A ≃ₐ[F] GeneralParameters.Reduction A :=
  Ideal.quotientEquivAlg _ _ symmetricSegreEquiv (map_symmetricParameterIdeal A).symm

@[simp] theorem symmetricReductionEquiv_mk (A : Matrix (Cell n) D F)
    (x : SymmetricSegre (F := F) (n := n)) :
    symmetricReductionEquiv A (Ideal.Quotient.mk _ x) =
      Ideal.Quotient.mk _ (symmetricSegreEquiv x) := rfl

noncomputable def symmetricPieceToReduction (A : Matrix (Cell n) D F) (q : ℕ) :
    SymmetricTensor (F := F) (n := n) q →ₗ[F] SymmetricReduction A :=
  (Ideal.Quotient.mkₐ F (symmetricParameterIdeal A)).toLinearMap.comp
    (DirectSum.lof F ℕ (SymmetricTensor (F := F) (n := n)) q)

noncomputable def symmetricActualPiece (A : Matrix (Cell n) D F) (q : ℕ) :
    Submodule F (SymmetricReduction A) := LinearMap.range (symmetricPieceToReduction A q)

noncomputable def symmetricDegreeOneEquiv :
    SymmetricTensor (F := F) (n := n) 1 ≃ₗ[F] degreeOne (K := F) (n := n) :=
  (symmetricTensorEquiv 1).trans (LinearEquiv.ofEq _ _ (by
    rw [piece_eq_balanced,degreeOne_eq_balanced]))

noncomputable def symmetricDegreeTwoEquiv :
    SymmetricTensor (F := F) (n := n) 2 ≃ₗ[F] degreeTwo (K := F) (n := n) :=
  (symmetricTensorEquiv 2).trans (LinearEquiv.ofEq _ _ (by
    rw [piece_eq_balanced,degreeTwo_eq_balanced]))

theorem symmetricPieceToReduction_one (A : Matrix (Cell n) D F)
    (x : SymmetricTensor (F := F) (n := n) 1) :
    symmetricReductionEquiv A (symmetricPieceToReduction A 1 x)=
      GeneralQuotient.oneToReduction A (symmetricDegreeOneEquiv x) := by
  change Ideal.Quotient.mk _ (symmetricSegreEquiv (DirectSum.of _ 1 x)) =
    Ideal.Quotient.mk _ (ActualQuotient.liftOne (symmetricDegreeOneEquiv x))
  congr 1
  apply Subtype.ext
  rw [symmetricSegreEquiv_of]
  rfl

theorem symmetricPieceToReduction_two (A : Matrix (Cell n) D F)
    (x : SymmetricTensor (F := F) (n := n) 2) :
    symmetricReductionEquiv A (symmetricPieceToReduction A 2 x)=
      GeneralQuotient.twoToReduction A (symmetricDegreeTwoEquiv x) := by
  change Ideal.Quotient.mk _ (symmetricSegreEquiv (DirectSum.of _ 2 x)) =
    Ideal.Quotient.mk _ (ActualQuotient.liftTwo (symmetricDegreeTwoEquiv x))
  congr 1
  apply Subtype.ext
  rw [symmetricSegreEquiv_of]
  rfl

/-- Identification of the full first homogeneous image in the quotient. -/
theorem map_symmetricActualPiece_one (A : Matrix (Cell n) D F) :
    (symmetricActualPiece A 1).map (symmetricReductionEquiv A).toLinearMap =
      GeneralQuotient.actualDegreeOne A := by
  rw [symmetricActualPiece,← LinearMap.range_comp]
  have he : (symmetricReductionEquiv A).toLinearMap.comp (symmetricPieceToReduction A 1) =
      (GeneralQuotient.oneToReduction A).comp symmetricDegreeOneEquiv.toLinearMap := by
    apply LinearMap.ext
    exact symmetricPieceToReduction_one A
  rw [he,LinearMap.range_comp_of_range_eq_top _ symmetricDegreeOneEquiv.range]
  rfl

/-- Identification of the full second homogeneous image in the quotient. -/
theorem map_symmetricActualPiece_two (A : Matrix (Cell n) D F) :
    (symmetricActualPiece A 2).map (symmetricReductionEquiv A).toLinearMap =
      GeneralQuotient.actualDegreeTwo A := by
  rw [symmetricActualPiece,← LinearMap.range_comp]
  have he : (symmetricReductionEquiv A).toLinearMap.comp (symmetricPieceToReduction A 2) =
      (GeneralQuotient.twoToReduction A).comp symmetricDegreeTwoEquiv.toLinearMap := by
    apply LinearMap.ext
    exact symmetricPieceToReduction_two A
  rw [he,LinearMap.range_comp_of_range_eq_top _ symmetricDegreeTwoEquiv.range]
  rfl

noncomputable def symmetricActualOneEquiv (A : Matrix (Cell n) D F) :
    symmetricActualPiece A 1 ≃ₗ[F] GeneralQuotient.actualDegreeOne A :=
  (symmetricReductionEquiv A).toLinearEquiv.ofSubmodules _ _ (map_symmetricActualPiece_one A)

noncomputable def symmetricActualTwoEquiv (A : Matrix (Cell n) D F) :
    symmetricActualPiece A 2 ≃ₗ[F] GeneralQuotient.actualDegreeTwo A :=
  (symmetricReductionEquiv A).toLinearEquiv.ofSubmodules _ _ (map_symmetricActualPiece_two A)

end PaperVerification.Segre.SymmetricRealization
end
end ProbeLayer49

section ProbeLayer50



/-!
# A polynomial certificate for actual Artinian Segre parameters

The fixed rank sums yield surjectivity in some higher homogeneous degree. A
nonzero full-row minor of the universal multiplication matrix therefore cuts
out a principal open set of parameter families whose literal quotients are
finite dimensional and Artinian. All spaces and maps are actual polynomial
pieces, and the nonempty-open assertion is accompanied by its polynomial.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ArtinianOpen

open Staircase Monomials Balanced HigherPieces RankParameters GeneralParameters Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

/-- Membership of the full next homogeneous piece in the actual ambient ideal
is equivalent to a surjective finite multiplication map. The proof projects
all coefficients to the relevant balanced degree before using a basis. -/
theorem multiplication_surjective_of_piece_le (q : ℕ) (A : Matrix (Cell n) D K)
    (h : piece (K := K) (n := n) (q + 1) ≤
      (ambientParameterIdeal (parameter A)).restrictScalars K) :
    Function.Surjective (multiplication q A) := by
  intro f
  have hf : f.val.IsWeightedHomogeneous (factorWeight (n := n))
      (diagonalDegree (q + 1)) := by
    exact (le_of_eq (piece_eq_balanced (K := K) (n := n) (q + 1))) f.property
  obtain ⟨c,hc,he⟩ := homogeneous_ideal_representation
    (fun d => (parameter A d).val) (parameter_homogeneous A) q f.val hf (h f.property)
  let g : D → piece (K := K) (n := n) q := fun d =>
    ⟨c d, (le_of_eq (piece_eq_balanced (K := K) (n := n) q).symm) (hc d)⟩
  let z : D × PieceIndex K n q → K := fun j =>
    (pieceBasis (K := K) (n := n) q).repr (g j.1) j.2
  have hg : ∀ d, (∑ b, z (d,b) • (pieceBasis (K := K) (n := n) q b).val) = c d := by
    intro d
    have hb := congrArg Subtype.val ((pieceBasis (K := K) (n := n) q).sum_repr (g d))
    change (piece (K := K) (n := n) q).subtype
      (∑ b, (pieceBasis (K := K) (n := n) q).repr (g d) b •
        pieceBasis (K := K) (n := n) q b) = c d at hb
    rw [map_sum] at hb
    simpa only [map_smul, Submodule.subtype_apply, z] using hb
  refine ⟨z, ?_⟩
  apply Subtype.ext
  change (piece (K := K) (n := n) (q + 1)).subtype
    (∑ j, z j • column q A j) = f.val
  rw [map_sum, Fintype.sum_prod_type]
  simp only [map_smul, Submodule.subtype_apply, column_value]
  calc
    _ = ∑ d, Degeneration.segreForm A d *
        (∑ b, z (d,b) • (pieceBasis (K := K) (n := n) q b).val) := by
      apply Finset.sum_congr rfl
      intro d _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro b _
      exact (mul_smul_comm (z (d,b)) (Degeneration.segreForm A d)
        (pieceBasis (K := K) (n := n) q b).val).symm
    _ = ∑ d, (parameter A d).val * c d := by
      simp only [hg, parameter_value]
    _ = f.val := by simpa only [mul_comm] using he

@[simp]
theorem parameter_rankForms (r : Ranks n) :
    parameter (rankForms (K := K) (n := n)) r = Artinian.rankParameter r := rfl

/-- Some honest homogeneous multiplication map is surjective at the fixed
rank sums, with the entire high-degree input discharged. -/
theorem exists_fixed_surjective : ∃ q : ℕ,
    Function.Surjective (multiplication q (rankForms (K := K) (n := n))) := by
  obtain ⟨q,hq⟩ := exists_irrelevant_power_le_rankIdeal (K := K) (n := n)
  refine ⟨q,multiplication_surjective_of_piece_le q
    (rankForms (K := K) (n := n)) ?_⟩
  have hp : parameter (rankForms (K := K) (n := n)) =
      Artinian.rankParameter (K := K) (n := n) := by
    funext r
    exact parameter_rankForms r
  rw [hp]
  exact piece_le_rankIdeal q hq

/-- The polynomial entries of the universal higher-degree multiplication map. -/
noncomputable def universalHigherMatrix (q : ℕ) :
    Matrix (PieceIndex K n (q + 1)) (D × PieceIndex K n q)
      (MvPolynomial (Cell n × D) K) := fun i j =>
  ∑ u, MvPolynomial.X (u,j.1) * MvPolynomial.C
    ((pieceBasis (q + 1)).repr (multiplyCell q u (pieceBasis q j.2)) i)

theorem eval_universalHigherMatrix (q : ℕ) (A : Matrix (Cell n) D K) :
    (universalHigherMatrix (K := K) (n := n) (D := D) q).map
      (MvPolynomial.eval (fun j => A j.1 j.2)) = multiplicationMatrix q A := by
  ext i j
  simp only [Matrix.map_apply, universalHigherMatrix, map_sum, map_mul,
    MvPolynomial.eval_X, MvPolynomial.eval_C, multiplicationMatrix, column,
    map_smul, Finset.sum_apply', Finsupp.smul_apply, smul_eq_mul]

/-- A concrete nonzero polynomial certificate for finiteness and Artinianness
of the actual quotient by arbitrary rank-many linear Segre parameters. -/
theorem artinian_certificate :
    ∃ f : MvPolynomial (Cell n × Ranks n) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (Reduction A) ∧ IsArtinianRing (Reduction A) := by
  classical
  obtain ⟨q,hq⟩ := exists_fixed_surjective (K := K) (n := n)
  have hr : Module.finrank K (piece (K := K) (n := n) (q + 1)) ≤
      ((universalHigherMatrix (K := K) (n := n) (D := Ranks n) q).map
        (MvPolynomial.eval (fun j => rankForms (K := K) (n := n) j.1 j.2))).rank := by
    rw [eval_universalHigherMatrix]
    exact ((multiplication_surjective_iff_rank q _).mp hq).ge
  obtain ⟨f,hf,hw⟩ := GenericRank.minor_witness
    (universalHigherMatrix (K := K) (n := n) (D := Ranks n) q)
    (fun j => rankForms (K := K) (n := n) j.1 j.2)
    (Module.finrank K (piece (K := K) (n := n) (q + 1))) hr
  refine ⟨f,hf, ?_⟩
  intro A hA
  have hbound := hw (fun j => A j.1 j.2) hA
  rw [eval_universalHigherMatrix] at hbound
  have hfull : (multiplicationMatrix q A).rank =
      Module.finrank K (piece (K := K) (n := n) (q + 1)) := by
    apply le_antisymm
    · simpa only [PieceIndex, Fintype.card_fin] using
        Matrix.rank_le_card_height (multiplicationMatrix q A)
    · exact hbound
  have hs := (multiplication_surjective_iff_rank q A).mpr hfull
  exact ⟨reduction_finite_of_surjective q A hs, reduction_artinian_of_surjective q A hs⟩

/-- Over an infinite field, the certificate can be intersected with any further
nonempty principal open condition on the same literal parameter family. -/
theorem exists_artinian_avoiding [Infinite K]
    (g : MvPolynomial (Cell n × Ranks n) K) (hg : g ≠ 0) :
    ∃ A : Matrix (Cell n) (Ranks n) K,
      MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 ∧
      Module.Finite K (Reduction A) ∧ IsArtinianRing (Reduction A) := by
  obtain ⟨f,hf,hw⟩ := artinian_certificate (K := K) (n := n)
  obtain ⟨a,ha⟩ := GenericMatrixRank.exists_eval_ne_zero (f * g) (mul_ne_zero hf hg)
  rw [map_mul] at ha
  obtain ⟨hfa,hga⟩ := mul_ne_zero_iff.mp ha
  let A : Matrix (Cell n) (Ranks n) K := fun u d => a (u,d)
  have he : (fun j : Cell n × Ranks n => A j.1 j.2) = a := by funext j; cases j; rfl
  refine ⟨A, ?_, ?_⟩
  · rwa [he]
  · exact hw A (by rwa [he])

end PaperVerification.Segre.ArtinianOpen
end
end ProbeLayer50

section ProbeLayer51



/-!
# Coning infinitesimally rigid frameworks in every characteristic

The apex is placed at zero and every base point `p` is placed at `(1,p)`.
After subtracting the apex velocity, the cone edges determine the extra velocity
coordinate. The old rigidity equations remain unchanged. The resulting ambient
motion is given explicitly by a block alternating matrix.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre

open Matrix
open scoped Matrix

variable {K I V : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- Add one universal apex to a graph. -/
def coneGraph (G : SimpleGraph V) : SimpleGraph (Option V) where
  Adj
    | none, none => False
    | none, some _ => True
    | some _, none => True
    | some v, some w => G.Adj v w
  symm.symm
    | none, none => id
    | none, some _ => id
    | some _, none => id
    | some _, some _ => G.adj_symm
  loopless.irrefl
    | none => not_false
    | some _ => G.irrefl

/-- Standard cone placement in one extra coordinate. -/
def conePosition (p : V → I → K) : Option V → Option I → K
  | none => 0
  | some v => augmentedPosition (p v)

/-- Block matrix combining an old alternating motion and its translation. -/
def coneMotionMatrix (M : Matrix I I K) (b : I → K) :
    Matrix (Option I) (Option I) K
  | none, none => 0
  | none, some j => -b j
  | some i, none => b i
  | some i, some j => M i j

theorem coneMotionMatrix_transpose (M : Matrix I I K) (b : I → K)
    (hM : Mᵀ = -M) :
    (coneMotionMatrix M b)ᵀ = -(coneMotionMatrix M b) := by
  ext i j
  cases i <;> cases j
  · simp [coneMotionMatrix]
  · simp [coneMotionMatrix]
  · simp [coneMotionMatrix]
  · exact congrFun (congrFun hM _ ) _

theorem coneMotionMatrix_diag (M : Matrix I I K) (b : I → K)
    (hM : ∀ i, M i i = 0) : ∀ i, coneMotionMatrix M b i i = 0 := by
  intro i
  cases i with
  | none => rfl
  | some i => exact hM i

@[simp] theorem coneMotionMatrix_mulVec_none (M : Matrix I I K) (b p : I → K) :
    (coneMotionMatrix M b *ᵥ augmentedPosition p) none = -(b ⬝ᵥ p) := by
  simp [Matrix.mulVec, dotProduct, Fintype.sum_option, coneMotionMatrix,
    augmentedPosition, Finset.sum_neg_distrib]

@[simp] theorem coneMotionMatrix_mulVec_some (M : Matrix I I K) (b p : I → K) (i : I) :
    (coneMotionMatrix M b *ᵥ augmentedPosition p) (some i) = (M *ᵥ p) i + b i := by
  simp [Matrix.mulVec, dotProduct, Fintype.sum_option, coneMotionMatrix,
    augmentedPosition, add_comm]

/-- Coning preserves infinitesimal rigidity at the standard cone placement. This
proves the characteristic-free forward cone assertion of Lemma 4.2(i). -/
theorem rigidOn_cone (G : SimpleGraph V) (p : V → I → K)
    (hp : InfinitesimallyRigidOn G p Set.univ) :
    InfinitesimallyRigidOn (coneGraph G) (conePosition p) Set.univ := by
  intro u hu
  let velocity : V → I → K := fun v i => u (some v) (some i) - u none (some i)
  have hbase : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, G.Adj v w →
      (p v - p w) ⬝ᵥ (velocity v - velocity w) = 0 := by
    intro v _ w _ hvw
    have h := hu (some v) (Set.mem_univ _) (some w) (Set.mem_univ _) hvw
    simpa [conePosition, dotProduct, Fintype.sum_option, augmentedPosition,
      velocity, sub_sub_sub_cancel_right] using h
  obtain ⟨M, b, hMt, hMd, hmotion⟩ := hp velocity hbase
  have hscalar : ∀ v, u (some v) none - u none none = -(b ⬝ᵥ p v) := by
    intro v
    have hedge := hu (some v) (Set.mem_univ _) none (Set.mem_univ _) (by trivial)
    have hv : velocity v = M *ᵥ p v + b := hmotion v (Set.mem_univ _)
    have horth := dot_alternating_mulVec_zero M hMt hMd (p v)
    have he : (u (some v) none - u none none) + p v ⬝ᵥ velocity v = 0 := by
      simpa [conePosition, dotProduct, Fintype.sum_option, augmentedPosition,
        velocity] using hedge
    rw [hv, dotProduct_add, horth, zero_add, dotProduct_comm (p v) b] at he
    exact eq_neg_of_add_eq_zero_left he
  refine ⟨coneMotionMatrix M b, u none,
    coneMotionMatrix_transpose M b hMt, coneMotionMatrix_diag M b hMd, ?_⟩
  intro v _
  cases v with
  | none => simp [conePosition]
  | some v =>
      funext i
      cases i with
      | none =>
          change u (some v) none =
            (coneMotionMatrix M b *ᵥ augmentedPosition (p v)) none + u none none
          rw [coneMotionMatrix_mulVec_none]
          have h := hscalar v
          linear_combination h
      | some i =>
          change u (some v) (some i) =
            (coneMotionMatrix M b *ᵥ augmentedPosition (p v)) (some i) + u none (some i)
          rw [coneMotionMatrix_mulVec_some]
          have h := congrFun (hmotion v (Set.mem_univ _)) i
          change u (some v) (some i) - u none (some i) = (M *ᵥ p v) i + b i at h
          linear_combination h

/-- Coning an affinely spanning placement gives an affinely spanning placement
in the space with one additional coordinate. -/
theorem conePosition_affineSpan [Fintype V] (p : V → I → K)
    (hp : affineSpan K (Set.range p) = ⊤) :
    affineSpan K (Set.range (conePosition p)) = ⊤ := by
  apply affineSpan_of_augmented_surjective (Matrix.of (conePosition p))
  intro y
  obtain ⟨c, hc⟩ := augmented_surjective_of_affineSpan (Matrix.of p) hp (fun i => y (some i))
  let d : Option V → K
    | none => y none - ∑ v, c v
    | some v => c v
  refine ⟨d, ?_⟩
  funext i
  cases i with
  | none =>
      change (d ᵥ* augmentedPlacement (Matrix.of (conePosition p))) none = y none
      rw [augmented_vecMul_none]
      simp [d, Fintype.sum_option]
  | some i =>
      have hi := congrFun hc i
      simpa [Matrix.vecMul, dotProduct, Fintype.sum_option, augmentedPlacement,
        augmentedPosition, conePosition, d] using hi

end PaperVerification.Segre
end
end ProbeLayer51

section ProbeLayer52



/-!
# Rigidity as the exact multiplication-rank condition

The alternating homogeneous boundary matrices are exactly ordinary translations
plus alternating infinitesimal linear motions. Consequently, at an affinely
spanning placement, infinitesimal rigidity is equivalent to the maximal rigidity
rank `r N - choose (r+1) 2`, including in characteristic two.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.RigidityRank

open Matrix GraphKernel KoszulDimension
open scoped Matrix

variable {K V I E : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- An ordinary alternating motion written as a homogeneous Koszul matrix. -/
def homogeneousMotion (M : Matrix I I K) (t : I → K)
    (hM : Mᵀ = -M) (hd : ∀ i, M i i = 0) :
    alternatingMatrices K (Option I) :=
  ⟨-(coneMotionMatrix M t), by
    simp only [Matrix.transpose_neg, coneMotionMatrix_transpose M t hM], by
    intro i
    simp only [Matrix.neg_apply, coneMotionMatrix_diag M t hd, neg_zero]⟩

/-- A homogeneous boundary gives an ordinary affine alternating motion. -/
theorem boundary_spatial_motion (p : Matrix V I K)
    (Q : alternatingMatrices K (Option I)) (v : V) :
    (coefficientBoundary p Q).2 v =
      (Matrix.of fun i j => Q.val (some j) (some i)) *ᵥ p v +
        (fun i => Q.val none (some i)) := by
  funext i
  simp [coefficientBoundary, coefficientsEquiv, koszulMatrix,
    augmentedPlacement, augmentedPosition, Matrix.mul_apply, Matrix.mulVec,
    dotProduct, Fintype.sum_option, mul_comm, add_comm]

/-- Conversely, the complete coefficient vector of every trivial motion is the
image of its explicit homogeneous Koszul matrix. -/
theorem boundary_homogeneousMotion (p : Matrix V I K)
    (M : Matrix I I K) (t : I → K)
    (hM : Mᵀ = -M) (hd : ∀ i, M i i = 0) :
    coefficientBoundary p (homogeneousMotion M t hM hd) =
      completeCoefficients p (fun v => M *ᵥ p v + t) := by
  apply Prod.ext
  · funext v
    have horth := dot_alternating_mulVec_zero M hM hd (p v)
    simp only [completeCoefficients, dotProduct_add, horth, zero_add]
    simp [coefficientBoundary, coefficientsEquiv, koszulMatrix, homogeneousMotion,
      augmentedPlacement, augmentedPosition, Matrix.mul_apply, coneMotionMatrix,
      dotProduct, Fintype.sum_option, Finset.sum_neg_distrib]
  · funext v
    rw [boundary_spatial_motion]
    have hmat : (Matrix.of fun i j =>
        (homogeneousMotion M t hM hd).val (some j) (some i)) = M := by
      ext i j
      have hij := congrFun (congrFun hM i) j
      change -M j i = M i j
      rw [show M j i = -M i j from hij, neg_neg]
    rw [hmat]
    simp only [homogeneousMotion, coneMotionMatrix, Matrix.neg_apply, neg_neg,
      completeCoefficients]

/-- Use oriented edges to give a finite index type without choosing an
orientation. Repeated opposite rows have the same kernel and rank. -/
abbrev Edges (G : SimpleGraph V) := {vw : V × V // G.Adj vw.1 vw.2}

def endpoints (G : SimpleGraph V) : Edges G → V × V := Subtype.val

/-- Rigidity is exactly surjectivity of the homogeneous boundary map onto the
square-and-edge multiplication kernel. -/
theorem rigid_iff_boundary_surjective (G : SimpleGraph V) (p : Matrix V I K) :
    InfinitesimallyRigidOn G p Set.univ ↔
      Function.Surjective (boundaryToKernel p (endpoints G)) := by
  constructor
  · intro hr z
    have hkernel := (coefficientMap_eq_zero_iff p (endpoints G) z.val).mp z.property
    have hu : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, G.Adj v w →
        (p v - p w) ⬝ᵥ (z.val.2 v - z.val.2 w) = 0 := by
      intro v _ w _ hvw
      exact congrFun hkernel.2 ⟨(v, w), hvw⟩
    obtain ⟨M, t, hM, hd, hm⟩ := hr z.val.2 hu
    refine ⟨homogeneousMotion M t hM hd, ?_⟩
    apply Subtype.ext
    change coefficientBoundary p (homogeneousMotion M t hM hd) = z.val
    rw [boundary_homogeneousMotion, hkernel.1]
    congr 1
    funext v
    exact (hm v (Set.mem_univ _)).symm
  · intro hs u hu
    have hk : rigidityMap p (endpoints G) u = 0 := by
      funext e
      exact hu e.val.1 (Set.mem_univ _) e.val.2 (Set.mem_univ _) e.property
    let z : LinearMap.ker (coefficientMap p (endpoints G)) :=
      ⟨completeCoefficients p u,
        (coefficientMap_eq_zero_iff p (endpoints G) _).mpr ⟨rfl, hk⟩⟩
    obtain ⟨Q, hQ⟩ := hs z
    refine ⟨(Matrix.of fun i j => Q.val (some j) (some i)),
      (fun i => Q.val none (some i)), ?_, ?_, ?_⟩
    · ext i j
      exact congrFun (congrFun Q.property.1 (some j)) (some i)
    · intro i
      exact Q.property.2 (some i)
    · intro v _
      have hc := congrArg (fun x : LinearMap.ker (coefficientMap p (endpoints G)) =>
        x.val.2 v) hQ
      change (coefficientBoundary p Q).2 v = u v at hc
      rw [← hc]
      exact boundary_spatial_motion p Q v

variable [Fintype V]

/-- At a spanning placement, rigidity forces precisely the usual number of
trivial motions. -/
theorem rigidity_rank_of_rigid (G : SimpleGraph V) [DecidableRel G.Adj]
    (p : Matrix V I K)
    (hp : affineSpan K (Set.range p) = ⊤)
    (hr : InfinitesimallyRigidOn G p Set.univ) :
    Module.finrank K (LinearMap.range (rigidityMap p (endpoints G))) =
      Fintype.card V * Fintype.card I - (Fintype.card I + 1).choose 2 := by
  have hs := (rigid_iff_boundary_surjective G p).mp hr
  have hi := boundaryToKernel_injective p (endpoints G)
    (augmented_surjective_of_affineSpan p hp)
  let e := LinearEquiv.ofBijective (boundaryToKernel p (endpoints G)) ⟨hi, hs⟩
  have hc : Module.finrank K (LinearMap.ker (coefficientMap p (endpoints G))) =
      (Fintype.card I + 1).choose 2 := by
    rw [← e.finrank_eq, finrank_alternatingMatrices, Fintype.card_option]
  have hk := (kernelEquiv p (endpoints G)).finrank_eq
  have hn := (rigidityMap p (endpoints G)).finrank_range_add_finrank_ker
  have hd : Module.finrank K (V → I → K) = Fintype.card V * Fintype.card I := by
    simp [Module.finrank_pi_fintype, Module.finrank_pi]
  rw [← hk, hc, hd] at hn
  exact Nat.eq_sub_of_add_eq hn

/-- The maximal rank bound implies rigidity. This direction is what allows
nonzero minors to impose rigidity simultaneously with affine-span conditions. -/
theorem rigid_of_rigidity_rank_bound (G : SimpleGraph V) [DecidableRel G.Adj]
    (p : Matrix V I K) (hp : affineSpan K (Set.range p) = ⊤)
    (hr : Fintype.card V * Fintype.card I - (Fintype.card I + 1).choose 2 ≤
      Module.finrank K (LinearMap.range (rigidityMap p (endpoints G)))) :
    InfinitesimallyRigidOn G p Set.univ := by
  apply (rigid_iff_boundary_surjective G p).mpr
  have hi := boundaryToKernel_injective p (endpoints G)
    (augmented_surjective_of_affineSpan p hp)
  have hle := LinearMap.finrank_le_finrank_of_injective hi
  have hd : Module.finrank K (alternatingMatrices K (Option I)) =
      (Fintype.card I + 1).choose 2 := by
    rw [finrank_alternatingMatrices, Fintype.card_option]
  have hc := finrank_multiplication_kernel p (endpoints G)
  have heq : Module.finrank K (alternatingMatrices K (Option I)) =
      Module.finrank K (LinearMap.ker (coefficientMap p (endpoints G))) := by
    omega
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank heq).mp hi

/-- The literal rigidity matrix, with one column for each vertex-coordinate
pair. The formula is polynomial and is valid over any coefficient ring. -/
noncomputable def rigidityMatrix {R : Type*} [CommRing R]
    (p : Matrix V I R) (edges : E → V × V) : Matrix E (V × I) R := by
  classical
  exact fun e vi =>
    (if vi.1 = (edges e).1 then p (edges e).1 vi.2 - p (edges e).2 vi.2 else 0) -
      (if vi.1 = (edges e).2 then p (edges e).1 vi.2 - p (edges e).2 vi.2 else 0)

/-- Flatten the vertex-indexed velocity coordinates into matrix-column
coordinates. -/
def flattenVelocity : (V → I → K) ≃ₗ[K] (V × I → K) where
  toFun u vi := u vi.1 vi.2
  invFun u v i := u (v, i)
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem rigidityMatrix_mulVec (p : Matrix V I K) (edges : E → V × V)
    (u : V → I → K) :
    rigidityMatrix p edges *ᵥ flattenVelocity u = rigidityMap p edges u := by
  classical
  funext e
  simp [rigidityMatrix, Matrix.mulVec, dotProduct, Fintype.sum_prod_type,
    flattenVelocity, rigidityMap, sub_mul, mul_sub, Finset.sum_sub_distrib]

/-- The displayed rigidity matrix and the earlier rigidity linear map have
exactly the same rank. -/
theorem rigidityMatrix_rank (p : Matrix V I K) (edges : E → V × V) :
    (rigidityMatrix p edges).rank =
      Module.finrank K (LinearMap.range (rigidityMap p edges)) := by
  have he : (rigidityMatrix p edges).mulVecLin.comp flattenVelocity.toLinearMap =
      rigidityMap p edges := by
    ext u e
    exact congrFun (rigidityMatrix_mulVec p edges u) e
  rw [← he, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top]
  rfl

/-- Universal placement coordinates; specialization gives every concrete
placement over the ground field. -/
noncomputable def universalPosition : Matrix V I (MvPolynomial (V × I) K) :=
  fun v i => MvPolynomial.X (v, i)

noncomputable def universalRigidity (edges : E → V × V) :
    Matrix E (V × I) (MvPolynomial (V × I) K) :=
  rigidityMatrix universalPosition edges

theorem eval_universalRigidity (edges : E → V × V) (p : Matrix V I K) :
    (universalRigidity (K := K) edges).map
        (MvPolynomial.eval (flattenVelocity p)) = rigidityMatrix p edges := by
  classical
  ext e vi
  simp only [universalRigidity,rigidityMatrix,Matrix.map_apply]
  split_ifs <;> simp only [map_sub,map_zero,universalPosition,MvPolynomial.eval_X,
    flattenVelocity,LinearEquiv.coe_mk,LinearMap.coe_mk,AddHom.coe_mk]

/-- Universal homogeneous rows, for imposing affine spanning by a nonzero
maximal minor. -/
noncomputable def universalAugmented : Matrix V (Option I) (MvPolynomial (V × I) K) :=
  fun v i => match i with
    | none => 1
    | some i => MvPolynomial.X (v, i)

theorem eval_universalAugmented (p : Matrix V I K) :
    (universalAugmented (K := K) (V := V) (I := I)).map
        (MvPolynomial.eval (flattenVelocity p)) = augmentedPlacement p := by
  ext v i
  cases i <;> simp [universalAugmented, Matrix.map_apply, flattenVelocity,
    augmentedPlacement, augmentedPosition]

end PaperVerification.Segre.RigidityRank
end
end ProbeLayer52

section ProbeLayer53



/-!
# Generic rigidity as a witnessed nonzero-minor condition

This file connects concrete framework rigidity to the generic rigidity used by
the paper. A rigid spanning placement gives a nonzero polynomial certificate;
every placement avoiding its zero locus is again spanning and rigid. The same
construction works after embedding the vertices into an arbitrary larger finite
vertex set, so generic conditions on several overlapping subgraphs can be
imposed simultaneously.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericRigidity

open Matrix RigidityRank
open scoped Matrix

variable {K I V W : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- A graph has a spanning infinitesimally rigid placement. The certificate
theorem below proves that these placements contain a nonempty polynomial open
locus over every infinite field. -/
def GenericallyRigid (K I : Type*) [Field K] [Fintype I] [DecidableEq I]
    {V : Type*} (G : SimpleGraph V) : Prop :=
  ∃ p : Matrix V I K, affineSpan K (Set.range p) = ⊤ ∧
    InfinitesimallyRigidOn G p Set.univ

/-- The standard affine simplex, indexed by one zero vertex and one vertex for
each coordinate direction. -/
def simplexPosition : Matrix (Option I) I K
  | none => 0
  | some i => Pi.single i 1

def simplexLeftInverse : Matrix (Option I) (Option I) K
  | none, none => 1
  | none, some _ => 0
  | some _, none => -1
  | some i, some j => if i = j then 1 else 0

theorem simplex_left_inverse :
    simplexLeftInverse (K := K) (I := I) * augmentedPlacement simplexPosition = 1 := by
  ext i j
  cases i <;> cases j <;>
    simp [Matrix.mul_apply, simplexLeftInverse, simplexPosition,
      augmentedPlacement, augmentedPosition, Fintype.sum_option,
      Pi.single_apply, Matrix.one_apply]

theorem simplex_affineSpan :
    affineSpan K (Set.range (simplexPosition (K := K) (I := I))) = ⊤ := by
  apply affineSpan_of_augmented_surjective
  apply Matrix.vecMul_surjective_iff_exists_left_inverse.mpr
  exact ⟨simplexLeftInverse, simplex_left_inverse⟩

/-- Any vertex set containing an affine-simplex-sized subset admits an affinely
spanning placement. -/
theorem exists_affineSpan_of_embedding (e : Option I ↪ V) :
    ∃ p : Matrix V I K, affineSpan K (Set.range p) = ⊤ := by
  classical
  let p : Matrix V I K := Matrix.of (Function.extend e simplexPosition 0)
  have he (i : Option I) : p (e i) = simplexPosition i :=
    e.injective.extend_apply simplexPosition 0 i
  refine ⟨p, top_unique ?_⟩
  rw [← simplex_affineSpan (K := K) (I := I)]
  apply affineSpan_mono K
  rintro x ⟨i, rfl⟩
  exact ⟨e i, he i⟩

theorem exists_affineSpan_of_card [Fintype V]
    (hcard : Fintype.card I + 1 ≤ Fintype.card V) :
    ∃ p : Matrix V I K, affineSpan K (Set.range p) = ⊤ := by
  obtain ⟨e : Option I ↪ V⟩ := Function.Embedding.nonempty_of_card_le (α := Option I) (β := V)
    (by simpa only [Fintype.card_option] using hcard)
  exact exists_affineSpan_of_embedding e

theorem complete_genericallyRigid [Fintype V]
    (hcard : Fintype.card I + 1 ≤ Fintype.card V) :
    GenericallyRigid K I (⊤ : SimpleGraph V) := by
  obtain ⟨p, hp⟩ := exists_affineSpan_of_card (K := K) hcard
  exact ⟨p, hp, complete_graph_rigid p hp⟩

/-- The universal placement of a smaller vertex set, read from the coordinates
of its images in a larger vertex set. -/
noncomputable def restrictedUniversal (f : W → V) : Matrix W I (MvPolynomial (V × I) K) :=
  fun w i => MvPolynomial.X (f w, i)

noncomputable def restrictedAugmented (f : W → V) :
    Matrix W (Option I) (MvPolynomial (V × I) K) :=
  fun w i => match i with
    | none => 1
    | some i => MvPolynomial.X (f w, i)

theorem eval_restrictedAugmented (f : W → V) (p : Matrix V I K) :
    (restrictedAugmented (K := K) (I := I) f).map
        (MvPolynomial.eval (flattenVelocity p)) =
      augmentedPlacement (Matrix.of fun w => p (f w)) := by
  ext w i
  cases i <;> simp [restrictedAugmented, Matrix.map_apply, flattenVelocity,
    augmentedPlacement, augmentedPosition]

theorem eval_restrictedRigidity [Fintype W]
    {E : Type*} (f : W → V) (edges : E → W × W) (p : Matrix V I K) :
    (rigidityMatrix (restrictedUniversal (K := K) (I := I) f) edges).map
        (MvPolynomial.eval (flattenVelocity p)) =
      rigidityMatrix (Matrix.of fun w => p (f w)) edges := by
  classical
  ext e wi
  simp only [rigidityMatrix, Matrix.map_apply]
  split_ifs <;> simp only [map_sub,map_zero,restrictedUniversal,MvPolynomial.eval_X,
    flattenVelocity,Matrix.of_apply,LinearEquiv.coe_mk,LinearMap.coe_mk,AddHom.coe_mk]

/-- A rigid smaller graph gives a nonzero polynomial in the coordinates of any
larger vertex set into which it embeds. Avoiding that polynomial guarantees both
affine spanning and rigidity of the restricted framework. -/
theorem rigidity_certificate [Fintype W]
    (G : SimpleGraph W) (f : W ↪ V) (hG : GenericallyRigid K I G) :
    ∃ g : MvPolynomial (V × I) K, g ≠ 0 ∧
      ∀ p : Matrix V I K, MvPolynomial.eval (flattenVelocity p) g ≠ 0 →
        affineSpan K (Set.range (Matrix.of fun w => p (f w))) = ⊤ ∧
          InfinitesimallyRigidOn G (Matrix.of fun w => p (f w)) Set.univ := by
  classical
  obtain ⟨p₀, hp₀, hr₀⟩ := hG
  let p : Matrix V I K := Matrix.of (Function.extend f p₀ 0)
  have hp : (Matrix.of fun w => p (f w)) = p₀ := by
    funext w
    exact f.injective.extend_apply p₀ 0 w
  let R := rigidityMatrix (restrictedUniversal (K := K) (I := I) f) (endpoints G)
  let A := restrictedAugmented (K := K) (I := I) f
  let ρ := Fintype.card W * Fintype.card I - (Fintype.card I + 1).choose 2
  have hR : ρ ≤ (R.map (MvPolynomial.eval (flattenVelocity p))).rank := by
    rw [show R = rigidityMatrix (restrictedUniversal (K := K) (I := I) f)
      (endpoints G) from rfl, eval_restrictedRigidity, hp, rigidityMatrix_rank,
      rigidity_rank_of_rigid G p₀ hp₀ hr₀] <;> exact le_rfl
  have hA : Fintype.card (Option I) ≤ (A.map (MvPolynomial.eval (flattenVelocity p))).rank := by
    rw [show A = restrictedAugmented (K := K) (I := I) f from rfl,
      eval_restrictedAugmented, hp,
      Matrix.vecMul_surjective_iff_rank_eq_card.mp
        (augmented_surjective_of_affineSpan p₀ hp₀)] <;> exact le_rfl
  obtain ⟨r, hr, hwr⟩ := GenericRank.minor_witness R (flattenVelocity p) ρ hR
  obtain ⟨a, ha, hwa⟩ := GenericRank.minor_witness A (flattenVelocity p)
    (Fintype.card (Option I)) hA
  refine ⟨r * a, mul_ne_zero hr ha, ?_⟩
  intro q hq
  rw [map_mul] at hq
  have hqr := hwr (flattenVelocity q) (mul_ne_zero_iff.mp hq).1
  have hqa := hwa (flattenVelocity q) (mul_ne_zero_iff.mp hq).2
  rw [show R = rigidityMatrix (restrictedUniversal (K := K) (I := I) f)
    (endpoints G) from rfl, eval_restrictedRigidity, rigidityMatrix_rank] at hqr
  rw [show A = restrictedAugmented (K := K) (I := I) f from rfl,
    eval_restrictedAugmented] at hqa
  have hspan : affineSpan K (Set.range (Matrix.of fun w => q (f w))) = ⊤ := by
    apply affineSpan_of_augmented_surjective
    apply Matrix.vecMul_surjective_iff_rank_eq_card.mpr
    exact le_antisymm (Matrix.rank_le_card_width _) hqa
  exact ⟨hspan, rigid_of_rigidity_rank_bound G _ hspan hqr⟩

/-- The spanning condition alone also has a nonzero polynomial certificate on
any embedded vertex set of sufficient size. -/
theorem affineSpan_certificate [Fintype W]
    (f : W ↪ V) (hcard : Fintype.card I + 1 ≤ Fintype.card W) :
    ∃ g : MvPolynomial (V × I) K, g ≠ 0 ∧
      ∀ p : Matrix V I K, MvPolynomial.eval (flattenVelocity p) g ≠ 0 →
        affineSpan K (Set.range (Matrix.of fun w => p (f w))) = ⊤ := by
  classical
  obtain ⟨g, hg, hgg⟩ := rigidity_certificate (⊤ : SimpleGraph W) f
    (complete_genericallyRigid (K := K) (I := I) hcard)
  exact ⟨g, hg, fun p hp => (hgg p hp).1⟩

/-- A generically rigid graph remains rigid after imposing any additional
nonempty polynomial open condition. -/
theorem exists_rigid_avoiding [Fintype V] [Infinite K]
    (G : SimpleGraph V) (hG : GenericallyRigid K I G)
    (g : MvPolynomial (V × I) K) (hg : g ≠ 0) :
    ∃ p : Matrix V I K, affineSpan K (Set.range p) = ⊤ ∧
      InfinitesimallyRigidOn G p Set.univ ∧
        MvPolynomial.eval (flattenVelocity p) g ≠ 0 := by
  classical
  obtain ⟨f, hf, hw⟩ := rigidity_certificate G (Function.Embedding.refl V) hG
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero (f * g) (mul_ne_zero hf hg)
  rw [map_mul] at hz
  let p : Matrix V I K := Matrix.of (flattenVelocity.symm z)
  have hp : flattenVelocity p = z := rfl
  have hr := hw p (by rw [hp]; exact (mul_ne_zero_iff.mp hz).1)
  refine ⟨p, hr.1, hr.2, ?_⟩
  rw [hp]
  exact (mul_ne_zero_iff.mp hz).2

end PaperVerification.Segre.GenericRigidity
end
end ProbeLayer53

section ProbeLayer54



/-!
# Joining rigid frameworks in skew affine subspaces

Internal rigidity implies all pairwise constraints within each part. Together
with the cross edges, this yields all constraints of a complete graph. The two
separate affine spanning hypotheses imply that the skew union affinely spans an
ambient space of dimension `card I + card J + 1`.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre

open Matrix
open scoped Matrix

variable {K I J V W : Type*} [Field K]
variable [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
variable [Fintype V] [Fintype W]

/-- The graph join: retain both internal graphs and insert every cross edge. -/
def joinGraph (G : SimpleGraph V) (H : SimpleGraph W) : SimpleGraph (V ⊕ W) where
  Adj
    | .inl v, .inl v' => G.Adj v v'
    | .inr w, .inr w' => H.Adj w w'
    | .inl _, .inr _ => True
    | .inr _, .inl _ => True
  symm.symm
    | .inl _, .inl _ => G.adj_symm
    | .inr _, .inr _ => H.adj_symm
    | .inl _, .inr _ => id
    | .inr _, .inl _ => id
  loopless.irrefl
    | .inl _ => G.irrefl
    | .inr _ => H.irrefl

/-- Place the parts as `(0,p,0)` and `(1,0,q)` in skew affine subspaces. -/
def joinedPosition (p : V → I → K) (q : W → J → K) : (V ⊕ W) → Option (I ⊕ J) → K
  | .inl _, none => 0
  | .inl v, some (.inl i) => p v i
  | .inl _, some (.inr _) => 0
  | .inr _, none => 1
  | .inr _, some (.inl _) => 0
  | .inr w, some (.inr j) => q w j

/-- The skew union of two affine spanning placements affinely spans the entire
joined ambient space. -/
theorem joinedPosition_affineSpan (p : V → I → K) (q : W → J → K)
    (hp : affineSpan K (Set.range p) = ⊤)
    (hq : affineSpan K (Set.range q) = ⊤) :
    affineSpan K (Set.range (joinedPosition p q)) = ⊤ := by
  apply affineSpan_of_augmented_surjective (Matrix.of (joinedPosition p q))
  intro y
  let ya : Option I → K
    | none => y none - y (some none)
    | some i => y (some (some (.inl i)))
  let yb : Option J → K
    | none => y (some none)
    | some j => y (some (some (.inr j)))
  obtain ⟨a, ha⟩ := augmented_surjective_of_affineSpan (Matrix.of p) hp ya
  obtain ⟨b, hb⟩ := augmented_surjective_of_affineSpan (Matrix.of q) hq yb
  have ha0 : ∑ v, a v = y none - y (some none) := by
    simpa only [augmented_vecMul_none, ya] using congrFun ha none
  have hb0 : ∑ w, b w = y (some none) := by
    simpa only [augmented_vecMul_none, yb] using congrFun hb none
  refine ⟨Sum.elim a b, ?_⟩
  funext z
  cases z with
  | none =>
      change ((Sum.elim a b) ᵥ* augmentedPlacement (Matrix.of (joinedPosition p q))) none = y none
      simp only [augmented_vecMul_none, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr,
        ha0, hb0]
      ring
  | some z => cases z with
    | none =>
        change ((Sum.elim a b) ᵥ* augmentedPlacement (Matrix.of (joinedPosition p q))) (some none) =
          y (some none)
        simp [Matrix.vecMul, dotProduct, Fintype.sum_sum_type, augmentedPlacement,
          augmentedPosition, joinedPosition, hb0]
    | some z => cases z with
      | inl i =>
          have hi := congrFun ha (some i)
          simpa [Matrix.vecMul, dotProduct, Fintype.sum_sum_type, augmentedPlacement,
            augmentedPosition, joinedPosition, ya] using hi
      | inr j =>
          have hj := congrFun hb (some j)
          simpa [Matrix.vecMul, dotProduct, Fintype.sum_sum_type, augmentedPlacement,
            augmentedPosition, joinedPosition, yb] using hj

/-- Joining an `I`-dimensional rigid framework and a `J`-dimensional rigid
framework gives rigidity in `Option (I ⊕ J)`, of dimension `card I + card J + 1`.
This is the precise placement construction in Lemma 4.2(i). -/
theorem rigidOn_join (G : SimpleGraph V) (H : SimpleGraph W)
    (p : V → I → K) (q : W → J → K)
    (hp : affineSpan K (Set.range p) = ⊤)
    (hq : affineSpan K (Set.range q) = ⊤)
    (hG : InfinitesimallyRigidOn G p Set.univ)
    (hH : InfinitesimallyRigidOn H q Set.univ) :
    InfinitesimallyRigidOn (joinGraph G H) (joinedPosition p q) Set.univ := by
  intro u hu
  let uA : V → I → K := fun v i => u (.inl v) (some (.inl i))
  let uB : W → J → K := fun w j => u (.inr w) (some (.inr j))
  have hA : ∀ v ∈ Set.univ, ∀ v' ∈ Set.univ, G.Adj v v' →
      (p v - p v') ⬝ᵥ (uA v - uA v') = 0 := by
    intro v _ v' _ hvv'
    have h := hu (.inl v) (Set.mem_univ _) (.inl v') (Set.mem_univ _) hvv'
    simpa [joinedPosition, dotProduct, Fintype.sum_option, Fintype.sum_sum_type, uA] using h
  have hB : ∀ w ∈ Set.univ, ∀ w' ∈ Set.univ, H.Adj w w' →
      (q w - q w') ⬝ᵥ (uB w - uB w') = 0 := by
    intro w _ w' _ hww'
    have h := hu (.inr w) (Set.mem_univ _) (.inr w') (Set.mem_univ _) hww'
    simpa [joinedPosition, dotProduct, Fintype.sum_option, Fintype.sum_sum_type, uB] using h
  obtain ⟨MA, tA, hMAt, hMAd, hmA⟩ := hG uA hA
  obtain ⟨MB, tB, hMBt, hMBd, hmB⟩ := hH uB hB
  have hall : ∀ v w,
      (joinedPosition p q v - joinedPosition p q w) ⬝ᵥ (u v - u w) = 0 := by
    intro v w
    cases v with
    | inl v => cases w with
      | inl w =>
          have hs : (p v - p w) ⬝ᵥ (uA v - uA w) = 0 := by
            rw [hmA v (Set.mem_univ _), hmA w (Set.mem_univ _)]
            exact trivial_motion_edge MA tA (p v) (p w) hMAt hMAd
          simpa [joinedPosition, dotProduct, Fintype.sum_option, Fintype.sum_sum_type, uA] using hs
      | inr w => exact hu (.inl v) (Set.mem_univ _) (.inr w) (Set.mem_univ _) (by trivial)
    | inr v => cases w with
      | inl w => exact hu (.inr v) (Set.mem_univ _) (.inl w) (Set.mem_univ _) (by trivial)
      | inr w =>
          have hs : (q v - q w) ⬝ᵥ (uB v - uB w) = 0 := by
            rw [hmB v (Set.mem_univ _), hmB w (Set.mem_univ _)]
            exact trivial_motion_edge MB tB (q v) (q w) hMBt hMBd
          simpa [joinedPosition, dotProduct, Fintype.sum_option, Fintype.sum_sum_type, uB] using hs
  exact complete_graph_rigid (Matrix.of (joinedPosition p q))
    (joinedPosition_affineSpan p q hp hq) u (fun v _ w _ _ => hall v w)

end PaperVerification.Segre
end
end ProbeLayer54

section ProbeLayer55



/-!
# Generic gluing and joins of rigid graphs

Nonzero-minor certificates place overlapping generically rigid subgraphs at one
common placement with a spanning intersection. The exact-placement gluing lemma
then gives the generic graph operation used for products of chains.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericRigidity

open Matrix RigidityRank
open scoped Matrix

variable {K I J V W : Type*} [Field K] [Fintype I] [DecidableEq I]

theorem range_restricted (p : Matrix V I K) (S : Set V) :
    Set.range (Matrix.of fun v : S => p v.val) = p '' S := by
  ext x
  constructor
  · rintro ⟨v, rfl⟩
    exact ⟨v.val, v.property, rfl⟩
  · rintro ⟨v, hv, rfl⟩
    exact ⟨⟨v, hv⟩, rfl⟩

/-- The induced-graph formulation agrees with the placement-level restriction
used by the gluing theorem. Extension of arbitrary velocities is proved here. -/
theorem rigidOn_induce_iff (G : SimpleGraph V) (p : Matrix V I K) (S : Set V) :
    InfinitesimallyRigidOn (G.induce S) (Matrix.of fun v : S => p v.val) Set.univ ↔
      InfinitesimallyRigidOn G p S := by
  classical
  constructor
  · intro h u hu
    obtain ⟨M, t, hM, hd, hm⟩ := h (fun v : S => u v.val) (by
      intro v _ w _ hvw
      exact hu v.val v.property w.val w.property hvw)
    exact ⟨M, t, hM, hd, fun v hv => hm ⟨v, hv⟩ (Set.mem_univ _)⟩
  · intro h u hu
    let u' : V → I → K := Function.extend Subtype.val u 0
    have he (v : S) : u' v.val = u v :=
      Subtype.val_injective.extend_apply u 0 v
    have hu' : ∀ v ∈ S, ∀ w ∈ S, G.Adj v w →
        (p v - p w) ⬝ᵥ (u' v - u' w) = 0 := by
      intro v hv w hw hvw
      rw [he ⟨v, hv⟩, he ⟨w, hw⟩]
      exact hu ⟨v, hv⟩ (Set.mem_univ _) ⟨w, hw⟩ (Set.mem_univ _) hvw
    obtain ⟨M, t, hM, hd, hm⟩ := h u' hu'
    refine ⟨M, t, hM, hd, ?_⟩
    intro v _
    rw [← he v]
    exact hm v.val v.property

/-- Two generically rigid induced subgraphs with at least `r+1` common vertices
have generically rigid union over every infinite field. -/
theorem genericallyRigid_union [Fintype V] [Infinite K]
    (G : SimpleGraph V) (S T : Set V)
    [Fintype S] [Fintype T] [Fintype ↥(S ∩ T)]
    (hS : GenericallyRigid K I (G.induce S))
    (hT : GenericallyRigid K I (G.induce T))
    (hcard : Fintype.card I + 1 ≤ Fintype.card ↥(S ∩ T)) :
    GenericallyRigid K I (G.induce (S ∪ T)) := by
  classical
  obtain ⟨gS, hgS, hwS⟩ := rigidity_certificate (G.induce S)
    (Function.Embedding.subtype (fun v => v ∈ S)) hS
  obtain ⟨gT, hgT, hwT⟩ := rigidity_certificate (G.induce T)
    (Function.Embedding.subtype (fun v => v ∈ T)) hT
  obtain ⟨gI, hgI, hwI⟩ := affineSpan_certificate (K := K) (I := I)
    (Function.Embedding.subtype (fun v => v ∈ S ∩ T)) hcard
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero ((gS * gT) * gI)
    (mul_ne_zero (mul_ne_zero hgS hgT) hgI)
  simp only [map_mul, mul_ne_zero_iff] at hz
  let p : Matrix V I K := Matrix.of (flattenVelocity.symm z)
  have hp : flattenVelocity p = z := rfl
  have hs := hwS p (by rw [hp]; exact hz.1.1)
  have ht := hwT p (by rw [hp]; exact hz.1.2)
  have hi := hwI p (by rw [hp]; exact hz.2)
  have hs' : InfinitesimallyRigidOn G p S := (rigidOn_induce_iff G p S).mp hs.2
  have ht' : InfinitesimallyRigidOn G p T := (rigidOn_induce_iff G p T).mp ht.2
  have hi' : affineSpan K (p '' (S ∩ T)) = ⊤ := by
    change affineSpan K (Set.range (Matrix.of
      (fun w : ↥(S ∩ T) => p w.val))) = ⊤ at hi
    rwa [range_restricted] at hi
  have hu := rigidOn_union G p S T hs' ht' hi'
  refine ⟨Matrix.of (fun v : ↥(S ∪ T) => p v.val), ?_,
    (rigidOn_induce_iff G p (S ∪ T)).mpr hu⟩
  rw [range_restricted]
  apply top_unique
  have hsp : affineSpan K (p '' S) = ⊤ := by
    have hspan := hs.1
    change affineSpan K (Set.range (Matrix.of (fun w : S => p w.val))) = ⊤ at hspan
    rwa [range_restricted] at hspan
  rw [← hsp]
  apply affineSpan_mono K
  exact Set.image_mono Set.subset_union_left

/-- The generic join theorem has the exact dimension `r+s+1`, represented by
the coordinate type `Option (I ⊕ J)`. -/
theorem genericallyRigid_join [Fintype J] [DecidableEq J] [Fintype V] [Fintype W]
    (G : SimpleGraph V) (H : SimpleGraph W)
    (hG : GenericallyRigid K I G) (hH : GenericallyRigid K J H) :
    GenericallyRigid K (Option (I ⊕ J)) (joinGraph G H) := by
  obtain ⟨p, hp, hr⟩ := hG
  obtain ⟨q, hq, hs⟩ := hH
  exact ⟨joinedPosition p q, joinedPosition_affineSpan p q hp hq,
    rigidOn_join G H p q hp hq hr hs⟩

/-- A cone is generically rigid in one additional dimension. -/
theorem genericallyRigid_cone [Fintype V]
    (G : SimpleGraph V) (hG : GenericallyRigid K I G) :
    GenericallyRigid K (Option I) (coneGraph G) := by
  obtain ⟨p, hp, hr⟩ := hG
  exact ⟨conePosition p, conePosition_affineSpan p hp, rigidOn_cone G p hr⟩

end PaperVerification.Segre.GenericRigidity
end
end ProbeLayer55

section ProbeLayer56



/-!
# The characteristic-free rigidity part of one-extension

A new vertex is placed on the removed edge, away from its endpoints. The two
collinear constraints recover the old edge constraint. Once the remaining
incident directions span, the new vertex follows the old rigid motion.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre

open Matrix
open scoped Matrix

variable {K I V : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- The two new collinear edge equations imply the deleted edge equation. -/
theorem recover_edge_on_line (p q x u v w : I → K) (t : K)
    (ht : t ≠ 0) (h1t : 1 - t ≠ 0)
    (hx : x = (1 - t) • p + t • q)
    (hp : (x - p) ⬝ᵥ (w - u) = 0)
    (hq : (x - q) ⬝ᵥ (w - v) = 0) :
    (p - q) ⬝ᵥ (u - v) = 0 := by
  have hxp : x - p = (-t) • (p - q) := by
    rw [hx]
    funext i
    simp only [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hxq : x - q = (1 - t) • (p - q) := by
    rw [hx]
    funext i
    simp only [Pi.sub_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have hpu : (p - q) ⬝ᵥ (w - u) = 0 := by
    rw [hxp, smul_dotProduct, smul_eq_mul] at hp
    exact (mul_eq_zero.mp hp).resolve_left (neg_ne_zero.mpr ht)
  have hqv : (p - q) ⬝ᵥ (w - v) = 0 := by
    rw [hxq, smul_dotProduct, smul_eq_mul] at hq
    exact (mul_eq_zero.mp hq).resolve_left h1t
  simp only [dotProduct_sub] at hpu hqv ⊢
  linear_combination hqv - hpu

/-- The pair of endpoints of the deleted edge, in either order. -/
def removedPair (a b v w : V) : Prop :=
  (v = a ∧ w = b) ∨ (v = b ∧ w = a)

theorem removedPair_symm {a b v w : V} (h : removedPair a b v w) :
    removedPair a b w v := by
  rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact Or.inr ⟨rfl, rfl⟩
  · exact Or.inl ⟨rfl, rfl⟩

/-- Delete `ab` and attach a new vertex to the specified old vertices. -/
def oneExtensionGraph (G : SimpleGraph V) (a b : V) (S : Set V) :
    SimpleGraph (Option V) where
  Adj
    | none, none => False
    | none, some v => v ∈ S
    | some v, none => v ∈ S
    | some v, some w => G.Adj v w ∧ ¬ removedPair a b v w
  symm.symm
    | none, none => id
    | none, some _ => id
    | some _, none => id
    | some _, some _ => fun h => ⟨h.1.symm, fun hr => h.2 (removedPair_symm hr)⟩
  loopless.irrefl
    | none => not_false
    | some _ => fun h => G.irrefl h.1

/-- Place the new vertex at `x` and retain every old point. -/
def extensionPosition (p : V → I → K) (x : I → K) : Option V → I → K
  | none => x
  | some v => p v

/-- A one-extension preserves rigidity under its precise placement-level
hypotheses. The neighbor set may have additional vertices; they do not weaken
any constraint. The generic `r+1`-neighbor construction is an application once
its independent-direction placement has been supplied. -/
theorem rigidOn_oneExtension (G : SimpleGraph V) (p : V → I → K)
    (a b : V) (S : Set V) (x : I → K) (t : K)
    (hab : G.Adj a b) (ha : a ∈ S) (hb : b ∈ S)
    (ht : t ≠ 0) (h1t : 1 - t ≠ 0)
    (hx : x = (1 - t) • p a + t • p b)
    (hp : InfinitesimallyRigidOn G p Set.univ)
    (hspan : Submodule.span K (Set.range (fun v : S => x - p v)) = ⊤) :
    InfinitesimallyRigidOn (oneExtensionGraph G a b S) (extensionPosition p x) Set.univ := by
  intro u hu
  have hnew : ∀ v ∈ S, (x - p v) ⬝ᵥ (u none - u (some v)) = 0 := by
    intro v hv
    exact hu none (Set.mem_univ _) (some v) (Set.mem_univ _) hv
  have holdedge : (p a - p b) ⬝ᵥ (u (some a) - u (some b)) = 0 :=
    recover_edge_on_line (p a) (p b) x (u (some a)) (u (some b)) (u none)
      t ht h1t hx (hnew a ha) (hnew b hb)
  have hbase : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, G.Adj v w →
      (p v - p w) ⬝ᵥ (u (some v) - u (some w)) = 0 := by
    intro v _ w _ hvw
    by_cases hr : removedPair a b v w
    · rcases hr with ⟨hva,hwb⟩ | ⟨hvb,hwa⟩
      · simpa only [hva,hwb] using holdedge
      · rw [hvb,hwa]
        have hneg : p b - p a = -(p a - p b) := by simp
        have huneg : u (some b) - u (some a) = -(u (some a) - u (some b)) := by simp
        rw [hneg,huneg,neg_dotProduct,dotProduct_neg,neg_neg]
        exact holdedge
    · exact hu (some v) (Set.mem_univ _) (some w) (Set.mem_univ _) ⟨hvw, hr⟩
  obtain ⟨M, b₀, hMt, hMd, hmotion⟩ := hp (fun v => u (some v)) hbase
  have hxmotion : u none = M *ᵥ x + b₀ := by
    apply motion_at_new_vertex (fun v : S => p v) (fun v : S => u (some v))
      x (u none) M b₀ hMt hMd
    · exact fun v => hmotion v (Set.mem_univ _)
    · exact hspan
    · exact fun v => hnew v v.property
  refine ⟨M, b₀, hMt, hMd, ?_⟩
  intro v _
  cases v with
  | none => exact hxmotion
  | some v => exact hmotion v (Set.mem_univ _)

end PaperVerification.Segre
end
end ProbeLayer56

section ProbeLayer57



/-!
# Generic vertex additions and one-extensions in every characteristic

The polynomial certificates proved earlier put a rigid old graph and an affine
simplex of neighbors at one common placement. The placement-level one-extension
theorem then applies with the new point on the removed edge. No real-field
rigidity theorem or division by two is used.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericRigidity

open Matrix
open scoped Matrix

variable {K I V W : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- Differences from any point to an affinely spanning set span the full
vector space, even when the chosen point is outside the indexed set. -/
theorem span_differences_of_affineSpan (p : W → I → K)
    (hp : affineSpan K (Set.range p) = ⊤) (x : I → K) :
    Submodule.span K (Set.range fun w => x - p w) = ⊤ := by
  have hv : vectorSpan K (Set.range p) = ⊤ := by
    rw [← direction_affineSpan, hp, AffineSubspace.direction_top]
  apply top_unique
  rw [← hv, vectorSpan_def]
  apply Submodule.span_le.mpr
  rintro _ ⟨_, ⟨v, rfl⟩, _, ⟨w, rfl⟩, rfl⟩
  change p v - p w ∈ Submodule.span K (Set.range fun w => x - p w)
  have h := Submodule.sub_mem (Submodule.span K (Set.range fun w => x - p w))
    (Submodule.subset_span (Set.mem_range_self w))
    (Submodule.subset_span (Set.mem_range_self v))
  convert h using 1
  funext i
  simp only [Pi.sub_apply]
  ring

/-- A placement extending an affinely spanning placement still spans. -/
theorem extensionPosition_affineSpan (p : V → I → K)
    (hp : affineSpan K (Set.range p) = ⊤) (x : I → K) :
    affineSpan K (Set.range (extensionPosition p x)) = ⊤ := by
  apply top_unique
  rw [← hp]
  apply affineSpan_mono K
  rintro _ ⟨v, rfl⟩
  exact ⟨some v, rfl⟩

/-- Generic one-extension: delete an edge and attach a new vertex to at least
`r+1` old vertices, including both deleted-edge endpoints. The new graph is
generically rigid in the same dimension over every infinite field. -/
theorem genericallyRigid_oneExtension [Fintype V] [Infinite K]
    (G : SimpleGraph V) (a b : V) (S : Set V) [Fintype S]
    (hG : GenericallyRigid K I G) (hab : G.Adj a b)
    (ha : a ∈ S) (hb : b ∈ S)
    (hcard : Fintype.card I + 1 ≤ Fintype.card S) :
    GenericallyRigid K I (oneExtensionGraph G a b S) := by
  classical
  obtain ⟨g, hg, hw⟩ := affineSpan_certificate (K := K) (I := I)
    (Function.Embedding.subtype (fun v => v ∈ S)) hcard
  obtain ⟨p, hp, hr, heval⟩ := exists_rigid_avoiding G hG g hg
  have hS := hw p heval
  obtain ⟨t, ht⟩ := Infinite.exists_notMem_finset ({0, 1} : Finset K)
  have htt : t ≠ 0 ∧ t ≠ 1 := by
    simpa only [Finset.mem_insert, Finset.mem_singleton, not_or] using ht
  have ht0 : t ≠ 0 := htt.1
  have ht1 : 1 - t ≠ 0 := sub_ne_zero.mpr (Ne.symm htt.2)
  let x := (1 - t) • p a + t • p b
  refine ⟨Matrix.of (extensionPosition (fun v i => p v i) x),
    extensionPosition_affineSpan (fun v i => p v i) hp x, ?_⟩
  apply rigidOn_oneExtension G (fun v i => p v i) a b S x t hab ha hb ht0 ht1 rfl hr
  exact span_differences_of_affineSpan (fun v : S => p v.val) hS x

/-- Attach one new vertex to the chosen old neighbor set. -/
def addVertexGraph (G : SimpleGraph V) (S : Set V) : SimpleGraph (Option V) where
  Adj
    | none, none => False
    | none, some v => v ∈ S
    | some v, none => v ∈ S
    | some v, some w => G.Adj v w
  symm.symm
    | none, none => id
    | none, some _ => id
    | some _, none => id
    | some _, some _ => fun h => h.symm
  loopless.irrefl
    | none => not_false
    | some _ => G.irrefl

/-- The sharp generic vertex-addition theorem: `r` neighbors suffice in
dimension `r`. The generic affine-simplex condition includes the new vertex,
so no extra neighbor is silently required. -/
theorem genericallyRigid_addVertex [Fintype V] [Infinite K]
    (G : SimpleGraph V) (S : Set V) [Fintype S]
    (hG : GenericallyRigid K I G) (hcard : Fintype.card I ≤ Fintype.card S) :
    GenericallyRigid K I (addVertexGraph G S) := by
  classical
  let old : V ↪ Option V := ⟨some, fun _ _ h => Option.some.inj h⟩
  let neighbors : Option S ↪ Option V :=
    (Function.Embedding.subtype (fun v => v ∈ S)).optionMap
  obtain ⟨g, hg, hwg⟩ := rigidity_certificate G old hG
  obtain ⟨f, hf, hwf⟩ := affineSpan_certificate (K := K) (I := I) neighbors
    (by simpa only [Fintype.card_option] using Nat.add_le_add_right hcard 1)
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero (g * f) (mul_ne_zero hg hf)
  rw [map_mul] at hz
  let p : Matrix (Option V) I K := Matrix.of (RigidityRank.flattenVelocity.symm z)
  have hp : RigidityRank.flattenVelocity p = z := rfl
  have hR := hwg p (by rw [hp]; exact (mul_ne_zero_iff.mp hz).1)
  have hS := hwf p (by rw [hp]; exact (mul_ne_zero_iff.mp hz).2)
  have hdirections : Submodule.span K
      (Set.range fun v : S => p none - p (some v.val)) = ⊤ := by
    have hfull := span_differences_of_affineSpan
      (fun v : Option S => p (neighbors v)) hS (p none)
    apply top_unique
    rw [← hfull]
    apply Submodule.span_le.mpr
    rintro _ ⟨v, rfl⟩
    cases v with
    | none => simp [neighbors, Function.Embedding.optionMap]
    | some v => exact Submodule.subset_span ⟨v, rfl⟩
  refine ⟨p, ?_, ?_⟩
  · apply top_unique
    rw [← hR.1]
    apply affineSpan_mono K
    rintro _ ⟨v, rfl⟩
    exact ⟨old v, rfl⟩
  · intro u hu
    have hold : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, G.Adj v w →
        (p (some v) - p (some w)) ⬝ᵥ (u (some v) - u (some w)) = 0 := by
      intro v _ w _ hvw
      exact hu (some v) (Set.mem_univ _) (some w) (Set.mem_univ _) hvw
    obtain ⟨M, t, hMt, hMd, hmotion⟩ := hR.2 (fun v => u (some v)) hold
    have hnew : u none = M *ᵥ p none + t := by
      apply motion_at_new_vertex (fun v : S => p (some v.val))
        (fun v : S => u (some v.val)) (p none) (u none) M t hMt hMd
      · exact fun v => hmotion v.val (Set.mem_univ _)
      · exact hdirections
      · exact fun v => hu none (Set.mem_univ _) (some v.val) (Set.mem_univ _) v.property
    refine ⟨M, t, hMt, hMd, ?_⟩
    intro v _
    cases v with
    | none => exact hnew
    | some v => exact hmotion v (Set.mem_univ _)

end PaperVerification.Segre.GenericRigidity
end
end ProbeLayer57

section ProbeLayer58



/-!
# The tetrahedral Boolean rigidity core

The proper Boolean graph on four elements is built by four vertex additions and
six one-extensions from a tetrahedron. The resulting adjacency relation is
checked against literal inclusion of nonempty proper subsets. This supplies the
base of the unrestricted Boolean induction without using an unformalized
stellar-subdivision or sphere theorem.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.BooleanBase

open GenericRigidity Matrix
open scoped Matrix

variable {K I V W : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- Reindexing a graph does not change its rigidity. -/
theorem genericallyRigid_comap_equiv (G : SimpleGraph V) (e : W ≃ V)
    (hG : GenericallyRigid K I G) : GenericallyRigid K I (G.comap e) := by
  obtain ⟨p, hp, hr⟩ := hG
  refine ⟨Matrix.of (fun w i => p (e w) i), ?_, ?_⟩
  · have he : Set.range (Matrix.of fun w i => p (e w) i) = Set.range p := by
      ext x
      constructor
      · rintro ⟨w, rfl⟩
        exact ⟨e w, rfl⟩
      · rintro ⟨v, rfl⟩
        refine ⟨e.symm v, ?_⟩
        funext i
        simp only [Matrix.of_apply,Equiv.apply_symm_apply]
    simpa only [he] using hp
  · intro u hu
    obtain ⟨M, t, hMt, hMd, hm⟩ := hr (fun v => u (e.symm v)) (by
      intro v _ w _ hvw
      have h := hu (e.symm v) (Set.mem_univ _) (e.symm w) (Set.mem_univ _)
        (by simpa only [SimpleGraph.comap_adj, Equiv.apply_symm_apply] using hvw)
      change (p (e (e.symm v)) - p (e (e.symm w))) ⬝ᵥ
        (u (e.symm v) - u (e.symm w)) = 0 at h
      simpa only [Equiv.apply_symm_apply] using h)
    refine ⟨M, t, hMt, hMd, ?_⟩
    intro w _
    change u w = M *ᵥ p (e w) + t
    simpa only [Equiv.symm_apply_apply] using hm (e w) (Set.mem_univ _)

/-- Adding edges preserves rigidity, with the same verified placement. -/
theorem genericallyRigid_mono {G H : SimpleGraph V} (hGH : G ≤ H)
    (hG : GenericallyRigid K I G) : GenericallyRigid K I H := by
  obtain ⟨p, hp, hr⟩ := hG
  refine ⟨p, hp, ?_⟩
  intro u hu
  apply hr u
  intro v hv w hw hvw
  exact hu v hv w hw (hGH hvw)

/-- Append the new vertex at the final index, retaining every old index. -/
def addLast {m : ℕ} (G : SimpleGraph (Fin m)) (S : Finset (Fin m)) :
    SimpleGraph (Fin (m + 1)) :=
  (addVertexGraph G (S : Set (Fin m))).comap (finSuccEquiv' (Fin.last m))

def oneExtendLast {m : ℕ} (G : SimpleGraph (Fin m)) (a b : Fin m)
    (S : Finset (Fin m)) : SimpleGraph (Fin (m + 1)) :=
  (oneExtensionGraph G a b (S : Set (Fin m))).comap (finSuccEquiv' (Fin.last m))

theorem addLast_rigid [Infinite K] {m : ℕ} (G : SimpleGraph (Fin m))
    (S : Finset (Fin m)) (hG : GenericallyRigid K I G)
    (hS : Fintype.card I ≤ S.card) : GenericallyRigid K I (addLast G S) := by
  apply genericallyRigid_comap_equiv
  apply genericallyRigid_addVertex G (S : Set (Fin m)) hG
  rw [Fintype.card_of_finset' S (fun _ => Iff.rfl)]
  exact hS

theorem oneExtendLast_rigid [Infinite K] {m : ℕ} (G : SimpleGraph (Fin m))
    (a b : Fin m) (S : Finset (Fin m)) (hG : GenericallyRigid K I G)
    (hab : G.Adj a b) (ha : a ∈ S) (hb : b ∈ S)
    (hS : Fintype.card I + 1 ≤ S.card) :
    GenericallyRigid K I (oneExtendLast G a b S) := by
  apply genericallyRigid_comap_equiv
  apply genericallyRigid_oneExtension G a b (S : Set (Fin m)) hG hab ha hb
  rw [Fintype.card_of_finset' S (fun _ => Iff.rfl)]
  exact hS

def tetrahedron : SimpleGraph (Fin 4) := ⊤
def faces1 : SimpleGraph (Fin 5) := addLast tetrahedron {1,2,3}
def faces2 : SimpleGraph (Fin 6) := addLast faces1 {0,2,3}
def faces3 : SimpleGraph (Fin 7) := addLast faces2 {0,1,3}
def faces4 : SimpleGraph (Fin 8) := addLast faces3 {0,1,2}
def edges1 : SimpleGraph (Fin 9) := oneExtendLast faces4 0 1 {0,1,6,7}
def edges2 : SimpleGraph (Fin 10) := oneExtendLast edges1 0 2 {0,2,5,7}
def edges3 : SimpleGraph (Fin 11) := oneExtendLast edges2 0 3 {0,3,5,6}
def edges4 : SimpleGraph (Fin 12) := oneExtendLast edges3 1 2 {1,2,4,7}
def edges5 : SimpleGraph (Fin 13) := oneExtendLast edges4 1 3 {1,3,4,6}
def edges6 : SimpleGraph (Fin 14) := oneExtendLast edges5 2 3 {2,3,4,5}

instance addVertexGraph_decidable (G : SimpleGraph V) (S : Set V)
    [DecidableRel G.Adj] [DecidablePred (fun v => v ∈ S)] :
    DecidableRel (addVertexGraph G S).Adj := by
  intro v w
  cases v <;> cases w <;> dsimp [addVertexGraph] <;> infer_instance

instance oneExtensionGraph_decidable [DecidableEq V] (G : SimpleGraph V) (a b : V)
    (S : Set V) [DecidableRel G.Adj] [DecidablePred (fun v => v ∈ S)] :
    DecidableRel (oneExtensionGraph G a b S).Adj := by
  intro v w
  cases v <;> cases w <;> dsimp [oneExtensionGraph, removedPair] <;> infer_instance

instance addLast_decidable {m : ℕ} (G : SimpleGraph (Fin m)) (S : Finset (Fin m))
    [DecidableRel G.Adj] : DecidableRel (addLast G S).Adj := by
  dsimp [addLast]
  infer_instance

instance oneExtendLast_decidable {m : ℕ} (G : SimpleGraph (Fin m)) (a b : Fin m)
    (S : Finset (Fin m)) [DecidableRel G.Adj] :
    DecidableRel (oneExtendLast G a b S).Adj := by
  dsimp [oneExtendLast]
  infer_instance

instance : DecidableRel tetrahedron.Adj := inferInstanceAs (DecidableRel (⊤ : SimpleGraph (Fin 4)).Adj)
instance : DecidableRel faces1.Adj := inferInstanceAs (DecidableRel (addLast tetrahedron {1,2,3}).Adj)
instance : DecidableRel faces2.Adj := inferInstanceAs (DecidableRel (addLast faces1 {0,2,3}).Adj)
instance : DecidableRel faces3.Adj := inferInstanceAs (DecidableRel (addLast faces2 {0,1,3}).Adj)
instance : DecidableRel faces4.Adj := inferInstanceAs (DecidableRel (addLast faces3 {0,1,2}).Adj)
instance : DecidableRel edges1.Adj := inferInstanceAs (DecidableRel (oneExtendLast faces4 0 1 {0,1,6,7}).Adj)
instance : DecidableRel edges2.Adj := inferInstanceAs (DecidableRel (oneExtendLast edges1 0 2 {0,2,5,7}).Adj)
instance : DecidableRel edges3.Adj := inferInstanceAs (DecidableRel (oneExtendLast edges2 0 3 {0,3,5,6}).Adj)
instance : DecidableRel edges4.Adj := inferInstanceAs (DecidableRel (oneExtendLast edges3 1 2 {1,2,4,7}).Adj)
instance : DecidableRel edges5.Adj := inferInstanceAs (DecidableRel (oneExtendLast edges4 1 3 {1,3,4,6}).Adj)
instance : DecidableRel edges6.Adj := inferInstanceAs (DecidableRel (oneExtendLast edges5 2 3 {2,3,4,5}).Adj)

theorem tetrahedral_construction_rigid [Infinite K] :
    GenericallyRigid K (Fin 3) edges6 := by
  have h0 : GenericallyRigid K (Fin 3) tetrahedron :=
    complete_genericallyRigid (by decide)
  have h1 : GenericallyRigid K (Fin 3) faces1 := addLast_rigid _ _ h0 (by decide)
  have h2 : GenericallyRigid K (Fin 3) faces2 := addLast_rigid _ _ h1 (by decide)
  have h3 : GenericallyRigid K (Fin 3) faces3 := addLast_rigid _ _ h2 (by decide)
  have h4 : GenericallyRigid K (Fin 3) faces4 := addLast_rigid _ _ h3 (by decide)
  have h5 : GenericallyRigid K (Fin 3) edges1 :=
    oneExtendLast_rigid _ _ _ _ h4 (by decide) (by decide) (by decide) (by decide)
  have h6 : GenericallyRigid K (Fin 3) edges2 :=
    oneExtendLast_rigid _ _ _ _ h5 (by decide) (by decide) (by decide) (by decide)
  have h7 : GenericallyRigid K (Fin 3) edges3 :=
    oneExtendLast_rigid _ _ _ _ h6 (by decide) (by decide) (by decide) (by decide)
  have h8 : GenericallyRigid K (Fin 3) edges4 :=
    oneExtendLast_rigid _ _ _ _ h7 (by decide) (by decide) (by decide) (by decide)
  have h9 : GenericallyRigid K (Fin 3) edges5 :=
    oneExtendLast_rigid _ _ _ _ h8 (by decide) (by decide) (by decide) (by decide)
  exact oneExtendLast_rigid _ _ _ _ h9 (by decide) (by decide) (by decide) (by decide)

abbrev ProperSubsets (k : ℕ) :=
  {s : Finset (Fin k) // s.Nonempty ∧ s ≠ Finset.univ}

/-- The actual graph of distinct comparable nonempty proper subsets. -/
def properBooleanGraph (k : ℕ) : SimpleGraph (ProperSubsets k) where
  Adj a b := a ≠ b ∧ (a.val ⊆ b.val ∨ b.val ⊆ a.val)
  symm.symm := fun _ _ h => ⟨h.1.symm, h.2.symm⟩
  loopless.irrefl := fun _ h => h.1 rfl

instance properBooleanGraph_decidable (k : ℕ) : DecidableRel (properBooleanGraph k).Adj :=
  fun _ _ => inferInstanceAs (Decidable (_ ∧ (_ ∨ _)))

def labels4 : Fin 14 → Finset (Fin 4) :=
  ![{0},{1},{2},{3},{1,2,3},{0,2,3},{0,1,3},{0,1,2},
    {0,1},{0,2},{0,3},{1,2},{1,3},{2,3}]

def properLabels4 (i : Fin 14) : ProperSubsets 4 :=
  ⟨labels4 i, by fin_cases i <;> decide⟩

noncomputable def labels4Equiv : Fin 14 ≃ ProperSubsets 4 :=
  Equiv.ofBijective properLabels4 (by decide)

/-- The finite construction has exactly the Boolean comparability edges. This
is a kernel proof of adjacency equivalence on all fourteen labeled vertices. -/
theorem tetrahedral_graph_eq :
    (properBooleanGraph 4).comap labels4Equiv = edges6 := by
  ext i j
  exact (by decide : ∀ i j : Fin 14,
    ((properBooleanGraph 4).comap labels4Equiv).Adj i j ↔ edges6.Adj i j) i j

/-- The full proper Boolean graph on four elements is generically 3-rigid over
every infinite field, with the characteristic-free operation proofs above. -/
theorem properBoolean_four_rigid [Infinite K] :
    GenericallyRigid K (Fin 3) (properBooleanGraph 4) := by
  have h := genericallyRigid_comap_equiv edges6 labels4Equiv.symm
    (tetrahedral_construction_rigid (K := K))
  have he : edges6.comap labels4Equiv.symm = properBooleanGraph 4 := by
    rw [← tetrahedral_graph_eq]
    ext i j
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using h

end PaperVerification.Segre.BooleanBase
end
end ProbeLayer58

section ProbeLayer59



/-!
# Simultaneous generic rigidity for finite covers

The cover consists of literal induced subgraphs. Each meets one fixed member
in at least an affine-simplex-sized set. A finite product of nonzero minor
certificates gives one placement where every member is rigid and every required
intersection spans. Agreement of affine motion maps then gives rigidity of the
whole graph. No recursive gluing hypothesis or unstated generic choice is used.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericRigidity

open Matrix RigidityRank
open scoped Matrix

variable {K I V J : Type*} [Field K] [Infinite K] [Fintype I] [DecidableEq I]
  [Fintype V] [Fintype J]

/-- A finite rigid cover with sufficiently large intersections with one member
is generically rigid, over every infinite field. -/
theorem genericallyRigid_cover (G : SimpleGraph V) (S : J → Set V) (j₀ : J)
    (hcover : ∀ v, ∃ j, v ∈ S j)
    (hS : ∀ j, GenericallyRigid K I (G.induce (S j)))
    (hcard : ∀ j, Fintype.card I + 1 ≤ Nat.card ↥(S j₀ ∩ S j)) :
    GenericallyRigid K I G := by
  classical
  choose f hf hwf using fun j => rigidity_certificate (G.induce (S j))
    (Function.Embedding.subtype (fun v => v ∈ S j)) (hS j)
  have hc (j : J) : Fintype.card I + 1 ≤ Fintype.card ↥(S j₀ ∩ S j) := by
    simpa only [Nat.card_eq_fintype_card] using hcard j
  choose g hg hwg using fun j => affineSpan_certificate (K := K) (I := I)
    (Function.Embedding.subtype (fun v => v ∈ S j₀ ∩ S j)) (hc j)
  have hp : (∏ j, f j * g j) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun j _ => mul_ne_zero (hf j) (hg j))
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero (∏ j, f j * g j) hp
  rw [map_prod] at hz
  have hzj (j : J) : MvPolynomial.eval z (f j) ≠ 0 ∧ MvPolynomial.eval z (g j) ≠ 0 := by
    have h := Finset.prod_ne_zero_iff.mp hz j (Finset.mem_univ _)
    rwa [map_mul, mul_ne_zero_iff] at h
  let p : Matrix V I K := Matrix.of (flattenVelocity.symm z)
  have hpz : flattenVelocity p = z := rfl
  have hrigid (j : J) : InfinitesimallyRigidOn G p (S j) := by
    apply (rigidOn_induce_iff G p (S j)).mp
    exact (hwf j p (by rw [hpz]; exact (hzj j).1)).2
  have hspan (j : J) : affineSpan K (p '' (S j₀ ∩ S j)) = ⊤ := by
    have h := hwg j p (by rw [hpz]; exact (hzj j).2)
    change affineSpan K (Set.range (Matrix.of
      (fun w : ↥(S j₀ ∩ S j) => p w.val))) = ⊤ at h
    rwa [range_restricted] at h
  refine ⟨p, ?_, ?_⟩
  · apply top_unique
    rw [← hspan j₀]
    apply affineSpan_mono K
    exact Set.image_subset_range _ _
  · intro u hu
    have hconstraint (j : J) : ∀ v ∈ S j, ∀ w ∈ S j, G.Adj v w →
        (p v - p w) ⬝ᵥ (u v - u w) = 0 := by
      intro v _ w _ hvw
      exact hu v (Set.mem_univ _) w (Set.mem_univ _) hvw
    obtain ⟨M, t, hMt, hMd, hmotion⟩ := hrigid j₀ u (hconstraint j₀)
    refine ⟨M, t, hMt, hMd, ?_⟩
    intro v _
    obtain ⟨j, hvj⟩ := hcover v
    obtain ⟨M', t', hM't, hM'd, hmotion'⟩ := hrigid j u (hconstraint j)
    have he : motionAffineMap M t = motionAffineMap M' t' := by
      apply AffineMap.ext_on (hspan j)
      rintro x ⟨w, hw, rfl⟩
      change M *ᵥ p w + t = M' *ᵥ p w + t'
      exact (hmotion w hw.1).symm.trans (hmotion' w hw.2)
    rw [hmotion' v hvj]
    exact (congrArg (fun a : (I → K) →ᵃ[K] (I → K) => a (p v)) he).symm

end PaperVerification.Segre.GenericRigidity
end
end ProbeLayer59

section ProbeLayer60



/-!
# Literal cone stars in the proper Boolean comparability graph

Removing one fixed element identifies the subsets containing it with a cone on
the proper Boolean graph of the remaining elements. The constructions below
are explicit equivalences of finite subset types, and adjacency is checked
against literal inclusion. This supplies the combinatorial induction step
without importing a topological sphere or stellar-subdivision assertion.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.BooleanStars

open GenericRigidity BooleanBase

variable {K I V W : Type*} [Field K] [Fintype I] [DecidableEq I]
  [Fintype V] [Fintype W]

abbrev ProperSet (V : Type*) [Fintype V] :=
  {s : Finset V // s.Nonempty ∧ s ≠ Finset.univ}

abbrev StrictSubset (V : Type*) [Fintype V] := {s : Finset V // s ≠ Finset.univ}

def properGraph (V : Type*) [Fintype V] : SimpleGraph (ProperSet V) where
  Adj s t := s ≠ t ∧ (s.val ⊆ t.val ∨ t.val ⊆ s.val)
  symm.symm := fun _ _ h => ⟨h.1.symm, h.2.symm⟩
  loopless.irrefl := fun _ h => h.1 rfl

/-- The star consists of all nonempty proper subsets containing the fixed
original element; it is a set of actual vertices of the comparability graph. -/
def star (v : V) : Set (ProperSet V) := {s | v ∈ s.val}

/-- Relabeling the underlying finite set relabels its nonempty proper subsets. -/
noncomputable def properSetEquiv (e : V ≃ W) : ProperSet V ≃ ProperSet W :=
  e.finsetCongr.subtypeEquiv (fun s => by
    simp only [Equiv.finsetCongr_apply, Finset.map_nonempty]
    have h : s.map e.toEmbedding = Finset.univ ↔ s = Finset.univ := by
      rw [← Finset.map_univ_equiv e, Finset.map_inj]
    exact and_congr_right fun _ => not_congr h.symm)

@[simp] theorem properSetEquiv_val (e : V ≃ W) (s : ProperSet V) :
    (properSetEquiv e s).val = s.val.map e.toEmbedding := rfl

/-- Inclusion, and hence comparability adjacency, is preserved exactly. -/
theorem properGraph_comap (e : V ≃ W) :
    (properGraph W).comap (properSetEquiv e) = properGraph V := by
  ext s t
  change (properSetEquiv e s ≠ properSetEquiv e t ∧
    ((s.val.map e.toEmbedding) ⊆ (t.val.map e.toEmbedding) ∨
      (t.val.map e.toEmbedding) ⊆ (s.val.map e.toEmbedding))) ↔
    (s ≠ t ∧ (s.val ⊆ t.val ∨ t.val ⊆ s.val))
  simp only [(properSetEquiv e).injective.ne_iff, Finset.map_subset_map]

/-- The same relabeling restricts to the stars of corresponding elements. -/
noncomputable def starEquiv (e : V ≃ W) (v : V) : star v ≃ star (e v) :=
  (properSetEquiv e).subtypeEquiv (fun s => by
    change v ∈ s.val ↔ e v ∈ s.val.map e.toEmbedding
    simp)

/-- The induced star graphs agree under the restricted equivalence. -/
theorem starGraph_comap (e : V ≃ W) (v : V) :
    ((properGraph W).induce (star (e v))).comap (starEquiv e v) =
      (properGraph V).induce (star v) := by
  ext s t
  change (properGraph W).Adj (properSetEquiv e s.val) (properSetEquiv e t.val) ↔
    (properGraph V).Adj s.val t.val
  exact Iff.of_eq (congrArg (fun G : SimpleGraph (ProperSet V) => G.Adj s.val t.val)
    (properGraph_comap e))

/-- Inserting `none` identifies all proper subsets with the star at `none`. -/
noncomputable def insertNoneEquiv : StrictSubset V ≃ star (none : Option V) := by
  classical
  exact
    { toFun := fun s => ⟨⟨Finset.insertNone s.val, Finset.insertNone_nonempty, by
        intro h
        apply s.property
        apply Finset.insertNone.injective
        simpa only [univ_option] using h⟩, by
        change none ∈ Finset.insertNone s.val
        exact Finset.none_mem_insertNone⟩
      invFun := fun s => ⟨Finset.eraseNone s.val.val, by
        intro h
        apply s.val.property.2
        calc
          s.val.val = Finset.insertNone (Finset.eraseNone s.val.val) := by
            rw [Finset.insertNone_eraseNone, Finset.insert_eq_of_mem s.property]
          _ = Finset.univ := by rw [h, ← univ_option]⟩
      left_inv := fun s => Subtype.ext (Finset.eraseNone_insertNone s.val)
      right_inv := fun s => by
        apply Subtype.ext
        apply Subtype.ext
        change Finset.insertNone (Finset.eraseNone s.val.val) = s.val.val
        rw [Finset.insertNone_eraseNone, Finset.insert_eq_of_mem s.property] }

/-- The empty subset is the cone apex; every other proper subset is a vertex
of the smaller proper Boolean graph. -/
noncomputable def optionProperEquiv [Nonempty V] : Option (ProperSet V) ≃ StrictSubset V := by
  classical
  exact
    { toFun := fun o => match o with
        | none => ⟨∅, Finset.univ_nonempty.ne_empty.symm⟩
        | some s => ⟨s.val, s.property.2⟩
      invFun := fun s => if h : s.val = ∅ then none else
        some ⟨s.val, Finset.nonempty_iff_ne_empty.mpr h, s.property⟩
      left_inv := fun o => by
        cases o with
        | none => simp
        | some s => simp [s.property.1.ne_empty]
      right_inv := fun s => by
        by_cases h : s.val = ∅
        · simp only [dif_pos h]
          exact Subtype.ext h.symm
        · simp only [dif_neg h] }

/-- The concrete cone vertex equivalence for a Boolean star. -/
noncomputable def starConeEquiv [Nonempty V] :
    Option (ProperSet V) ≃ star (none : Option V) :=
  (optionProperEquiv (V := V)).trans insertNoneEquiv

@[simp] theorem starConeEquiv_none [Nonempty V] :
    (starConeEquiv (V := V) none).val.val = Finset.insertNone ∅ := rfl

@[simp] theorem starConeEquiv_some [Nonempty V] (s : ProperSet V) :
    (starConeEquiv (some s)).val.val = Finset.insertNone s.val := rfl

/-- The induced graph is exactly the cone, including every vertex and edge. -/
theorem starCone_graph [Nonempty V] :
    ((properGraph (Option V)).induce (star none)).comap starConeEquiv =
      coneGraph (properGraph V) := by
  ext x y
  cases x with
  | none =>
    cases y with
    | none => simp
    | some y =>
      change ((starConeEquiv none).val ≠ (starConeEquiv (some y)).val ∧
        (Finset.insertNone ∅ ⊆ Finset.insertNone y.val ∨
          Finset.insertNone y.val ⊆ Finset.insertNone ∅)) ↔ True
      apply iff_true_intro
      refine ⟨?_, Or.inl (Finset.insertNone.monotone (Finset.empty_subset _))⟩
      intro h
      have he : starConeEquiv none = starConeEquiv (some y) := Subtype.ext h
      have hh := starConeEquiv.injective he
      cases hh
  | some x =>
    cases y with
    | none =>
      change ((starConeEquiv (some x)).val ≠ (starConeEquiv none).val ∧
        (Finset.insertNone x.val ⊆ Finset.insertNone ∅ ∨
          Finset.insertNone ∅ ⊆ Finset.insertNone x.val)) ↔ True
      apply iff_true_intro
      refine ⟨?_, Or.inr (Finset.insertNone.monotone (Finset.empty_subset _))⟩
      intro h
      have he : starConeEquiv (some x) = starConeEquiv none := Subtype.ext h
      have hh := starConeEquiv.injective he
      cases hh
    | some y =>
      change ((starConeEquiv (some x)).val ≠ (starConeEquiv (some y)).val ∧
        (Finset.insertNone x.val ⊆ Finset.insertNone y.val ∨
          Finset.insertNone y.val ⊆ Finset.insertNone x.val)) ↔
        (x ≠ y ∧ (x.val ⊆ y.val ∨ y.val ⊆ x.val))
      have hne : (starConeEquiv (some x)).val ≠ (starConeEquiv (some y)).val ↔ x ≠ y := by
        constructor
        · intro h he
          subst y
          exact h rfl
        · intro h he
          exact h (Option.some.inj (starConeEquiv.injective (Subtype.ext he)))
      rw [hne, Finset.insertNone.le_iff_le, Finset.insertNone.le_iff_le]

/-- A rigid proper Boolean graph gives a rigid star in one higher dimension. -/
theorem star_none_rigid [Nonempty V]
    (h : GenericallyRigid K I (properGraph V)) :
    GenericallyRigid K (Option I) ((properGraph (Option V)).induce (star none)) := by
  classical
  have hc := genericallyRigid_cone (properGraph V) h
  have ht := genericallyRigid_comap_equiv (coneGraph (properGraph V))
    (starConeEquiv (V := V)).symm hc
  have he : (coneGraph (properGraph V)).comap (starConeEquiv (V := V)).symm =
      (properGraph (Option V)).induce (star none) := by
    rw [← starCone_graph]
    ext s t
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using ht

/-- There are exactly `2^|V|-1` proper subsets, including the empty one. -/
theorem card_strictSubset : Nat.card (StrictSubset V) = 2 ^ Fintype.card V - 1 := by
  classical
  rw [Nat.card_eq_fintype_card]
  change Fintype.card {s : Finset V // ¬s = Finset.univ} = _
  rw [Fintype.card_subtype_compl, Fintype.card_finset, Fintype.card_subtype_eq]

/-- The star at `none` has the exact number of proper subsets of the remaining
finite set. This also counts intersections in the Boolean induction. -/
theorem card_star_none : Nat.card ↥(star (none : Option V)) = 2 ^ Fintype.card V - 1 :=
  (Nat.card_congr (insertNoneEquiv (V := V)).symm).trans card_strictSubset

end PaperVerification.Segre.BooleanStars
end
end ProbeLayer60

section ProbeLayer61



/-!
# Unrestricted Boolean rigidity from explicit cone stars

For every `k ≥ 4`, the proper Boolean graph is generically `(k-1)`-rigid over
an arbitrary infinite field. The induction covers the next Boolean graph by
the stars of its original elements. Each star is the cone on the previous
Boolean graph. The intersection of two distinct stars has exactly
`2^(k-2)-1` vertices, and the verified finite-cover gluing theorem applies.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.BooleanInduction

open GenericRigidity BooleanBase BooleanStars

variable {K I V W : Type*} [Field K] [Fintype I] [DecidableEq I]
  [Fintype V] [Fintype W]

/-- Relabeling the underlying set also preserves induced-star rigidity. -/
theorem star_rigid_transport (e : V ≃ W) (v : V)
    (h : GenericallyRigid K I ((properGraph V).induce (star v))) :
    GenericallyRigid K I ((properGraph W).induce (star (e v))) := by
  have hr := genericallyRigid_comap_equiv ((properGraph V).induce (star v))
    (starEquiv e v).symm h
  have he : ((properGraph V).induce (star v)).comap (starEquiv e v).symm =
      (properGraph W).induce (star (e v)) := by
    rw [← starGraph_comap e v]
    ext s t
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using hr

/-- Every star of the next Boolean graph is a cone on the preceding graph. -/
theorem fin_star_rigid {k : ℕ} (hk : 0 < k) (i : Fin (k + 1))
    (h : GenericallyRigid K I (properBooleanGraph k)) :
    GenericallyRigid K (Option I) ((properGraph (Fin (k + 1))).induce (star i)) := by
  letI : Nonempty (Fin k) := ⟨⟨0, hk⟩⟩
  have hc := star_none_rigid (V := Fin k) h
  simpa only [finSuccEquiv'_symm_none] using
    star_rigid_transport (finSuccEquiv' i).symm none hc

/-- The exact star cardinality, valid for any finite underlying set. -/
theorem card_star (v : V) :
    Nat.card ↥(star v) = 2 ^ (Fintype.card V - 1) - 1 := by
  classical
  let e : Option {w : V // w ≠ v} ≃ V := Equiv.optionSubtypeNe v
  have he : e none = v := rfl
  have hc : Fintype.card {w : V // w ≠ v} = Fintype.card V - 1 := by
    rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
  calc
    _ = Nat.card ↥(star (none : Option {w : V // w ≠ v})) := by
      rw [← he]
      exact Nat.card_congr (starEquiv e none).symm
    _ = 2 ^ Fintype.card {w : V // w ≠ v} - 1 := card_star_none
    _ = _ := by rw [hc]

/-- Relabeling preserves the literal intersection of two stars. -/
noncomputable def starPairEquiv (e : V ≃ W) (v w : V) :
    ↥(star v ∩ star w) ≃ ↥(star (e v) ∩ star (e w)) :=
  (properSetEquiv e).subtypeEquiv (fun s => by
    change (v ∈ s.val ∧ w ∈ s.val) ↔
      (e v ∈ s.val.map e.toEmbedding ∧ e w ∈ s.val.map e.toEmbedding)
    simp)

/-- Removing `none` identifies the intersection of its star and the star of
`some v` with the star of `v` in the smaller proper Boolean graph. -/
noncomputable def interNoneSomeEquiv (v : V) :
    ↥(star (none : Option V) ∩ star (some v)) ≃ star v := by
  classical
  exact
    { toFun := fun s =>
        ⟨⟨Finset.eraseNone s.val.val,
          ⟨v, Finset.mem_eraseNone.mpr s.property.2⟩,
          by
            intro h
            apply s.val.property.2
            calc
              s.val.val = Finset.insertNone (Finset.eraseNone s.val.val) := by
                rw [Finset.insertNone_eraseNone,Finset.insert_eq_of_mem s.property.1]
              _ = Finset.univ := by rw [h,← univ_option]⟩,
          Finset.mem_eraseNone.mpr s.property.2⟩
      invFun := fun s =>
        let t : star (none : Option V) := insertNoneEquiv ⟨s.val.val, s.val.property.2⟩
        ⟨t.val, t.property, by
          change some v ∈ Finset.insertNone s.val.val
          exact Finset.some_mem_insertNone.mpr s.property⟩
      left_inv := fun s => by
        apply Subtype.ext
        apply Subtype.ext
        change Finset.insertNone (Finset.eraseNone s.val.val) = s.val.val
        rw [Finset.insertNone_eraseNone, Finset.insert_eq_of_mem s.property.1]
      right_inv := fun s => by
        apply Subtype.ext
        apply Subtype.ext
        exact Finset.eraseNone_insertNone s.val.val }

/-- The exact intersection cardinality used in the induction. -/
theorem card_star_inter_distinct {k : ℕ} (i j : Fin (k + 1)) (hij : i ≠ j) :
    Nat.card ↥(star i ∩ star j) = 2 ^ (k - 1) - 1 := by
  let e := finSuccEquiv' i
  have hi : e i = none := finSuccEquiv'_at i
  obtain ⟨a, ha⟩ : ∃ a : Fin k, e j = some a := by
    cases h : e j with
    | none =>
        have he : i = j := e.injective (hi.trans h.symm)
        exact False.elim (hij he)
    | some a => exact ⟨a, rfl⟩
  calc
    _ = Nat.card ↥(star (e i) ∩ star (e j)) := Nat.card_congr (starPairEquiv e i j)
    _ = Nat.card ↥(star (none : Option (Fin k)) ∩ star (some a)) := by rw [hi, ha]
    _ = Nat.card ↥(star a) := Nat.card_congr (interNoneSomeEquiv a)
    _ = 2 ^ (k - 1) - 1 := by simpa only [Fintype.card_fin] using card_star a

/-- The elementary numerical room in every Boolean induction step. -/
theorem two_pow_room (q : ℕ) : q + 5 ≤ 2 ^ (q + 3) - 1 := by
  induction q with
  | zero => decide
  | succ q ih =>
      have hp : 0 < 2 ^ (q + 3) := pow_pos (by decide) _
      have he : (q + 1) + 3 = (q + 3) + 1 := by omega
      change (q + 1) + 5 ≤ 2 ^ ((q + 1) + 3) - 1
      rw [he, pow_succ]
      omega

/-- The intersection bound includes equal stars, so the cover theorem needs no
exceptional case for its fixed member. -/
theorem star_inter_room (q : ℕ) (i j : Fin ((q + 4) + 1)) :
    q + 5 ≤ Nat.card ↥(star i ∩ star j) := by
  classical
  by_cases h : i = j
  · subst j
    rw [Set.inter_self, card_star]
    simp only [Fintype.card_fin, Nat.add_sub_cancel]
    have h := two_pow_room (q + 1)
    have he : (q + 1) + 3 = q + 4 := by omega
    rw [he] at h
    omega
  · rw [card_star_inter_distinct i j h]
    have he : q + 4 - 1 = q + 3 := by omega
    rw [he]
    exact two_pow_room q

/-- Coordinates are increased by one at each cone step. Their cardinality is
proved below, so this representation has the exact stated dimension. -/
def RigidityCoordinates : ℕ → Type
  | 0 => Fin 3
  | q + 1 => Option (RigidityCoordinates q)

instance rigidityCoordinatesFintype (q : ℕ) : Fintype (RigidityCoordinates q) := by
  induction q with
  | zero => exact inferInstanceAs (Fintype (Fin 3))
  | succ q ih =>
      letI : Fintype (RigidityCoordinates q) := ih
      exact inferInstanceAs (Fintype (Option (RigidityCoordinates q)))

instance rigidityCoordinatesDecidableEq (q : ℕ) : DecidableEq (RigidityCoordinates q) := by
  induction q with
  | zero => exact inferInstanceAs (DecidableEq (Fin 3))
  | succ q ih =>
      letI : DecidableEq (RigidityCoordinates q) := ih
      exact inferInstanceAs (DecidableEq (Option (RigidityCoordinates q)))

@[simp] theorem card_rigidityCoordinates (q : ℕ) :
    Fintype.card (RigidityCoordinates q) = q + 3 := by
  induction q with
  | zero => rfl
  | succ q ih =>
      change Fintype.card (Option (RigidityCoordinates q)) = (q + 1) + 3
      rw [Fintype.card_option, ih]

/-- The unrestricted Boolean rigidity theorem, with every cone and overlap
proved using literal finite subsets. It applies in every characteristic. -/
theorem properBoolean_rigid [Infinite K] (q : ℕ) :
    GenericallyRigid K (RigidityCoordinates q) (properBooleanGraph (q + 4)) := by
  classical
  induction q with
  | zero => exact properBoolean_four_rigid
  | succ q ih =>
      change GenericallyRigid K (Option (RigidityCoordinates q))
        (properGraph (Fin ((q + 4) + 1)))
      apply genericallyRigid_cover (properGraph (Fin ((q + 4) + 1)))
        (fun i : Fin ((q + 4) + 1) => star i) ⟨0, by omega⟩
      · intro s
        exact s.property.1
      · intro i
        exact fin_star_rigid (by omega) i ih
      · intro i
        simpa only [Fintype.card_option, card_rigidityCoordinates] using
          star_inter_room q (⟨0, by omega⟩ : Fin ((q + 4) + 1)) i

/-- Equivalent indexing of the unrestricted result for every `k ≥ 4`. -/
theorem properBoolean_rigid_of_ge [Infinite K] (k : ℕ) (hk : 4 ≤ k) :
    GenericallyRigid K (RigidityCoordinates (k - 4)) (properBooleanGraph k) := by
  obtain ⟨q,hq⟩ := Nat.exists_eq_add_of_le hk
  have he : k = q + 4 := by omega
  clear hq
  subst k
  have hindex : q + 4 - 4 = q := Nat.add_sub_cancel q 4
  have htransport := congrArg (fun r : ℕ =>
    GenericallyRigid K (RigidityCoordinates r) (properBooleanGraph (q + 4))) hindex
  exact Eq.mpr htransport (properBoolean_rigid (K := K) q)

theorem dimension_properBoolean (k : ℕ) (hk : 4 ≤ k) :
    Fintype.card (RigidityCoordinates (k - 4)) = k - 1 := by
  rw [card_rigidityCoordinates]
  omega

end PaperVerification.Segre.BooleanInduction
end
end ProbeLayer61

section ProbeLayer62



/-!
# Full bounded comparability graphs and Boolean chain boxes

The minimum and maximum of a nontrivial bounded poset are two universal graph
vertices. Removing them and restoring them is proved to be exactly a double
cone. Boolean cells are explicitly identified with subsets, with their order
and graph adjacency preserved. Thus unrestricted proper Boolean rigidity gives
the full Boolean product-of-chains starting graphs in the exact dimensions.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.Comparability

open GenericRigidity BooleanBase BooleanStars BooleanInduction Staircase RankParameters

variable {K I V : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- Distinct comparable elements are joined by an edge. -/
def graph (V : Type*) [PartialOrder V] : SimpleGraph V where
  Adj v w := v ≠ w ∧ (v ≤ w ∨ w ≤ v)
  symm.symm := fun _ _ h => ⟨h.1.symm, h.2.symm⟩
  loopless.irrefl := fun _ h => h.1 rfl

abbrev ProperVertex (V : Type*) [Bot V] [Top V] := {v : V // v ≠ ⊥ ∧ v ≠ ⊤}

def properGraph (V : Type*) [PartialOrder V] [BoundedOrder V] :
    SimpleGraph (ProperVertex V) := (graph V).induce {v | v ≠ ⊥ ∧ v ≠ ⊤}

section Bounded

variable [PartialOrder V] [BoundedOrder V] [Nontrivial V]

@[simp] theorem proper_ne_bot (v : ProperVertex V) : v.val ≠ ⊥ := v.property.1
@[simp] theorem proper_ne_top (v : ProperVertex V) : v.val ≠ ⊤ := v.property.2
@[simp] theorem bot_ne_proper (v : ProperVertex V) : (⊥ : V) ≠ v.val := v.property.1.symm
@[simp] theorem top_ne_proper (v : ProperVertex V) : (⊤ : V) ≠ v.val := v.property.2.symm

/-- Restore the two genuine extremal vertices of the original bounded poset. -/
noncomputable def doubleConeEquiv : Option (Option (ProperVertex V)) ≃ V := by
  classical
  exact
    { toFun := fun o => match o with
        | none => ⊥
        | some none => ⊤
        | some (some v) => v.val
      invFun := fun v => if h₀ : v = ⊥ then none else
        if h₁ : v = ⊤ then some none else some (some ⟨v,h₀,h₁⟩)
      left_inv := fun o => by
        rcases o with _ | (_ | v) <;> simp [bot_ne_top, top_ne_bot]
      right_inv := fun v => by
        by_cases h₀ : v = ⊥
        · simp [h₀]
        · by_cases h₁ : v = ⊤ <;> simp [h₀, h₁] }

/-- The full comparability graph is literally the double cone on its proper part. -/
theorem doubleCone_graph : (graph V).comap (doubleConeEquiv (V := V)) =
    coneGraph (coneGraph (properGraph V)) := by
  ext v w
  rcases v with _ | (_ | v) <;> rcases w with _ | (_ | w) <;>
    simp [SimpleGraph.comap_adj, doubleConeEquiv, graph, coneGraph, properGraph,
      bot_ne_top, top_ne_bot, Subtype.coe_inj]

/-- Rigidity of the proper part gives rigidity of the actual full graph in two
additional dimensions. -/
theorem full_rigid_of_proper [Fintype V]
    (h : GenericallyRigid K I (properGraph V)) :
    GenericallyRigid K (Option (Option I)) (graph V) := by
  classical
  have hc := genericallyRigid_cone (coneGraph (properGraph V))
    (genericallyRigid_cone (properGraph V) h)
  have hr := genericallyRigid_comap_equiv (coneGraph (coneGraph (properGraph V)))
    (doubleConeEquiv (V := V)).symm hc
  have he : (coneGraph (coneGraph (properGraph V))).comap
      (doubleConeEquiv (V := V)).symm = graph V := by
    rw [← doubleCone_graph]
    ext v w
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using hr

end Bounded

section Boolean

variable [Fintype V] [DecidableEq V]

/-- A Boolean cell is its literal support subset of coordinates equal to one. -/
noncomputable def booleanCellEquiv : Cell (fun _ : V => 1) ≃ Finset V where
  toFun u := Finset.univ.filter (fun i => u i = 1)
  invFun s i := if i ∈ s then 1 else 0
  left_inv u := by
    funext i
    have h : u i = 0 ∨ u i = 1 := by
      have hi : (u i).val < 2 := (u i).isLt
      have hv : (u i).val = 0 ∨ (u i).val = 1 := by omega
      rcases hv with hv | hv
      · exact Or.inl (Fin.ext hv)
      · exact Or.inr (Fin.ext hv)
    rcases h with h | h <;> simp [h]
  right_inv s := by
    ext i
    simp

theorem booleanCell_le_iff (u v : Cell (fun _ : V => 1)) :
    u ≤ v ↔ booleanCellEquiv u ⊆ booleanCellEquiv v := by
  constructor
  · intro h i hi
    have hu : u i = 1 := by simpa [booleanCellEquiv] using hi
    have hv : v i = 1 := by
      have hl := h i
      have hb : (v i).val < 2 := (v i).isLt
      rw [hu] at hl
      have hval : 1 ≤ (v i).val := hl
      apply Fin.ext
      change (v i).val = 1
      omega
    simpa [booleanCellEquiv] using hv
  · intro h i
    by_cases hu : u i = 1
    · have hi : i ∈ booleanCellEquiv u := by simp [booleanCellEquiv, hu]
      have hv : v i = 1 := by simpa [booleanCellEquiv] using h hi
      simp [hu, hv]
    · have hz : u i = 0 := by
        have hb : (u i).val < 2 := (u i).isLt
        have hn : (u i).val ≠ 1 := fun he => hu (Fin.ext he)
        apply Fin.ext
        change (u i).val = 0
        omega
      simp [hz]

/-- The graph isomorphism uses the original product order and literal subset
inclusion, with no graph relation substituted by definition. -/
theorem booleanCell_graph :
    (graph (Finset V)).comap (booleanCellEquiv (V := V)) =
      chainGraph (fun _ : V => 1) := by
  ext u v
  change (booleanCellEquiv u ≠ booleanCellEquiv v ∧
    (booleanCellEquiv u ⊆ booleanCellEquiv v ∨ booleanCellEquiv v ⊆ booleanCellEquiv u)) ↔
    (u ≠ v ∧ (u ≤ v ∨ v ≤ u))
  rw [booleanCellEquiv.injective.ne_iff, ← booleanCell_le_iff, ← booleanCell_le_iff]

noncomputable def properSubsetEquiv : BooleanStars.ProperSet V ≃ ProperVertex (Finset V) :=
  Equiv.subtypeEquivRight (fun s => and_congr Finset.nonempty_iff_ne_empty Iff.rfl)

theorem properSubset_graph : (properGraph (Finset V)).comap (properSubsetEquiv (V := V)) =
    BooleanStars.properGraph V := by
  ext s t
  change (s.val ≠ t.val ∧ (s.val ⊆ t.val ∨ t.val ⊆ s.val)) ↔
    (s ≠ t ∧ (s.val ⊆ t.val ∨ t.val ⊆ s.val))
  constructor
  · intro h
    exact ⟨fun he => h.1 (congrArg Subtype.val he),h.2⟩
  · intro h
    exact ⟨fun he => h.1 (Subtype.ext he),h.2⟩

end Boolean

/-- Every full Boolean product with at least four factors is rigid in dimension
`k+1`, with no restriction on the field characteristic. -/
theorem fullBoolean_rigid [Infinite K] (q : ℕ) :
    GenericallyRigid K (Option (Option (RigidityCoordinates q)))
      (chainGraph (fun _ : Fin (q + 4) => 1)) := by
  classical
  letI : Nonempty (Fin (q + 4)) := ⟨⟨0, by omega⟩⟩
  have hproper : GenericallyRigid K (RigidityCoordinates q)
      (properGraph (Finset (Fin (q + 4)))) := by
    have h := genericallyRigid_comap_equiv (BooleanStars.properGraph (Fin (q + 4)))
      (properSubsetEquiv (V := Fin (q + 4))).symm (properBoolean_rigid (K := K) q)
    have he : (BooleanStars.properGraph (Fin (q + 4))).comap
        (properSubsetEquiv (V := Fin (q + 4))).symm =
          properGraph (Finset (Fin (q + 4))) := by
      rw [← properSubset_graph]
      ext s t
      simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
    simpa only [he] using h
  have hfull := full_rigid_of_proper hproper
  have h := genericallyRigid_comap_equiv (graph (Finset (Fin (q + 4))))
    (booleanCellEquiv (V := Fin (q + 4))) hfull
  simpa only [booleanCell_graph] using h

@[simp] theorem dimension_fullBoolean (q : ℕ) :
    Fintype.card (Option (Option (RigidityCoordinates q))) = (q + 4) + 1 := by
  rw [Fintype.card_option, Fintype.card_option, card_rigidityCoordinates]

end PaperVerification.Segre.Comparability
end
end ProbeLayer62

section ProbeLayer63



/-!
# Increasing one chain length

The lower old box coned by the new maximum and the translated upper old box
coned by the global minimum are literal induced subgraphs of the enlarged
product. Their vertex intersection is explicitly equivalent to two endpoints
plus `a` copies of the other factor. The exact overlap condition is therefore
`a (|Q|-1) ≥ s+e`, as in equation (6) of the paper.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ChainPropagation

open GenericRigidity BooleanBase Comparability

variable {K I V W Q : Type*} [Field K] [Fintype I] [DecidableEq I]

section EmbeddedCone

variable [PartialOrder V] [PartialOrder W]

/-- Add one comparable vertex to the image of an actual order embedding. -/
noncomputable def embeddedConeEquiv (f : W ↪o V) (a : V) (ha : a ∉ Set.range f) :
    Option W ≃ ↥(insert a (Set.range f)) := by
  classical
  let F : Option W → ↥(insert a (Set.range f)) := fun o => match o with
    | none => ⟨a, Set.mem_insert _ _⟩
    | some w => ⟨f w, Set.mem_insert_of_mem _ (Set.mem_range_self w)⟩
  apply Equiv.ofBijective F
  constructor
  · intro x y h
    cases x with
    | none =>
      cases y with
      | none => rfl
      | some y => exact False.elim (ha ⟨y, (congrArg Subtype.val h).symm⟩)
    | some x =>
      cases y with
      | none => exact False.elim (ha ⟨x, congrArg Subtype.val h⟩)
      | some y => exact congrArg some (f.injective (congrArg Subtype.val h))
  · intro v
    rcases v.property with h | ⟨w, h⟩
    · exact ⟨none, Subtype.ext h.symm⟩
    · exact ⟨some w, Subtype.ext h⟩

theorem embeddedCone_graph (f : W ↪o V) (a : V) (ha : a ∉ Set.range f)
    (hc : ∀ w, a ≤ f w ∨ f w ≤ a) :
    ((graph V).induce (insert a (Set.range f))).comap (embeddedConeEquiv f a ha) =
      coneGraph (graph W) := by
  ext v w
  cases v with
  | none =>
    cases w with
    | none => simp
    | some w =>
      change (a ≠ f w ∧ (a ≤ f w ∨ f w ≤ a)) ↔ True
      exact iff_true_intro ⟨fun h => ha ⟨w,h.symm⟩, hc w⟩
  | some v =>
    cases w with
    | none =>
      change (f v ≠ a ∧ (f v ≤ a ∨ a ≤ f v)) ↔ True
      exact iff_true_intro ⟨fun h => ha ⟨v,h⟩, (hc v).symm⟩
    | some w =>
      change (f v ≠ f w ∧ (f v ≤ f w ∨ f w ≤ f v)) ↔
        (v ≠ w ∧ (v ≤ w ∨ w ≤ v))
      rw [f.injective.ne_iff, f.le_iff_le, f.le_iff_le]

theorem embeddedCone_rigid [Fintype W] (f : W ↪o V) (a : V)
    (ha : a ∉ Set.range f) (hc : ∀ w, a ≤ f w ∨ f w ≤ a)
    (h : GenericallyRigid K I (graph W)) :
    GenericallyRigid K (Option I) ((graph V).induce (insert a (Set.range f))) := by
  have hcone := genericallyRigid_cone (graph W) h
  have ht := genericallyRigid_comap_equiv (coneGraph (graph W))
    (embeddedConeEquiv f a ha).symm hcone
  have he : (coneGraph (graph W)).comap (embeddedConeEquiv f a ha).symm =
      (graph V).induce (insert a (Set.range f)) := by
    rw [← embeddedCone_graph f a ha hc]
    ext v w
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using ht

end EmbeddedCone

section Product

variable [PartialOrder Q] [BoundedOrder Q] [Fintype Q]

/-- The unshifted old box inside the larger product. -/
def lowerEmbedding (a : ℕ) : Fin (a + 1) × Q ↪o Fin (a + 2) × Q where
  toFun v := (v.1.castSucc, v.2)
  inj' v w h := by
    apply Prod.ext
    · apply Fin.ext
      exact congrArg (fun x : Fin (a + 2) × Q => x.1.val) h
    · exact congrArg (fun x : Fin (a + 2) × Q => x.2) h
  map_rel_iff' := by intro v w; exact and_congr (Fin.castSuccOrderEmb (n := a + 1)).le_iff_le Iff.rfl

/-- The old box translated one unit upwards in the enlarged chain. -/
def upperEmbedding (a : ℕ) : Fin (a + 1) × Q ↪o Fin (a + 2) × Q where
  toFun v := (v.1.succ, v.2)
  inj' v w h := by
    apply Prod.ext
    · apply Fin.ext
      have hv : v.1.val + 1 = w.1.val + 1 :=
        congrArg (fun x : Fin (a + 2) × Q => x.1.val) h
      exact Nat.add_right_cancel hv
    · exact congrArg (fun x : Fin (a + 2) × Q => x.2) h
  map_rel_iff' := by intro v w; exact and_congr (Fin.succOrderEmb (a + 1)).le_iff_le Iff.rfl

def lowerCone (a : ℕ) : Set (Fin (a + 2) × Q) := insert ⊤ (Set.range (lowerEmbedding (Q := Q) a))
def upperCone (a : ℕ) : Set (Fin (a + 2) × Q) := insert ⊥ (Set.range (upperEmbedding (Q := Q) a))

theorem top_not_lower (a : ℕ) : (⊤ : Fin (a + 2) × Q) ∉ Set.range (lowerEmbedding a) := by
  rintro ⟨v, h⟩
  have he := congrArg (fun x : Fin (a + 2) × Q => x.1.val) h
  change v.1.val = a + 1 at he
  have hv := v.1.isLt
  omega

theorem bot_not_upper (a : ℕ) : (⊥ : Fin (a + 2) × Q) ∉ Set.range (upperEmbedding a) := by
  rintro ⟨v, h⟩
  have he := congrArg (fun x : Fin (a + 2) × Q => x.1.val) h
  change v.1.val + 1 = 0 at he
  omega

/-- The two literal old-box cones cover every vertex of the enlarged product. -/
theorem cones_cover (a : ℕ) (v : Fin (a + 2) × Q) :
    v ∈ lowerCone (Q := Q) a ∪ upperCone (Q := Q) a := by
  by_cases h : v.1.val < a + 1
  · apply Or.inl
    apply Set.mem_insert_of_mem
    refine ⟨(⟨v.1.val,h⟩,v.2), ?_⟩
    exact Prod.ext (Fin.ext rfl) rfl
  · apply Or.inr
    apply Set.mem_insert_of_mem
    have hv := v.1.isLt
    refine ⟨(⟨v.1.val - 1,by omega⟩,v.2), ?_⟩
    apply Prod.ext
    · apply Fin.ext
      change v.1.val - 1 + 1 = v.1.val
      omega
    · rfl

/-- Parametrize the entire overlap by the two extrema and the `a` middle
layers, retaining every vertex of the other factor. -/
noncomputable def intersectionEquiv (a : ℕ) :
    Option (Option (Fin a × Q)) ≃ ↥(lowerCone (Q := Q) a ∩ upperCone (Q := Q) a) := by
  classical
  let F : Option (Option (Fin a × Q)) → ↥(lowerCone (Q := Q) a ∩ upperCone (Q := Q) a) := fun o =>
    match o with
    | none => ⟨⊥, by
        constructor
        · exact Set.mem_insert_of_mem _ ⟨(0,⊥), rfl⟩
        · exact Set.mem_insert _ _⟩
    | some none => ⟨⊤, by
        constructor
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ ⟨(Fin.last a,⊤), rfl⟩⟩
    | some (some v) => ⟨(⟨v.1.val + 1,by have hv := v.1.isLt; omega⟩,v.2), by
        constructor
        · apply Set.mem_insert_of_mem
          refine ⟨(⟨v.1.val + 1,by have hv := v.1.isLt; omega⟩,v.2), rfl⟩
        · apply Set.mem_insert_of_mem
          refine ⟨(⟨v.1.val,by have hv := v.1.isLt; omega⟩,v.2), rfl⟩⟩
  apply Equiv.ofBijective F
  constructor
  · intro x y h
    have hv := congrArg (fun v : ↥(lowerCone (Q := Q) a ∩ upperCone (Q := Q) a) => v.val.1.val) h
    rcases x with _ | (_ | x) <;> rcases y with _ | (_ | y)
    all_goals try rfl
    all_goals dsimp [F] at hv
    all_goals try simp only [bot_eq_zero, Fin.val_zero] at hv
    all_goals try have hx := x.1.isLt
    all_goals try have hy := y.1.isLt
    all_goals try omega
    congr 1
    congr 1
    apply Prod.ext
    · exact Fin.ext (by omega)
    · exact congrArg (fun v : ↥(lowerCone (Q := Q) a ∩ upperCone (Q := Q) a) => v.val.2) h
  · intro v
    by_cases h₀ : v.val = ⊥
    · exact ⟨none, Subtype.ext h₀.symm⟩
    by_cases h₁ : v.val = ⊤
    · exact ⟨some none, Subtype.ext h₁.symm⟩
    obtain ⟨x,hx⟩ : v.val ∈ Set.range (lowerEmbedding (Q := Q) a) := by
      rcases v.property.1 with h | h
      · exact False.elim (h₁ h)
      · exact h
    obtain ⟨y,hy⟩ : v.val ∈ Set.range (upperEmbedding (Q := Q) a) := by
      rcases v.property.2 with h | h
      · exact False.elim (h₀ h)
      · exact h
    have hxv := congrArg (fun z : Fin (a + 2) × Q => z.1.val) hx
    have hyv := congrArg (fun z : Fin (a + 2) × Q => z.1.val) hy
    change x.1.val = v.val.1.val at hxv
    change y.1.val + 1 = v.val.1.val at hyv
    have hxb := x.1.isLt
    have hm : v.val.1.val - 1 < a := by omega
    refine ⟨some (some (⟨v.val.1.val - 1,hm⟩,v.val.2)), ?_⟩
    apply Subtype.ext
    apply Prod.ext
    · exact Fin.ext (by dsimp [F]; omega)
    · rfl

/-- The overlap count is exact, including the two extremal vertices. -/
theorem card_intersection (a : ℕ) :
    Nat.card ↥(lowerCone (Q := Q) a ∩ upperCone (Q := Q) a) = a * Fintype.card Q + 2 := by
  calc
    _ = Nat.card (Option (Option (Fin a × Q))) :=
      Nat.card_congr (intersectionEquiv (Q := Q) a).symm
    _ = a * Fintype.card Q + 2 := by
      simp only [Nat.card_eq_fintype_card,Fintype.card_option,Fintype.card_prod,Fintype.card_fin]

/-- Increasing the first chain length raises the rigidity dimension by one as
soon as the exact old-box overlap has affine-simplex size. -/
theorem increase_chain [Infinite K] (a : ℕ)
    (h : GenericallyRigid K I (graph (Fin (a + 1) × Q)))
    (hcard : Fintype.card I ≤ a * Fintype.card Q) :
    GenericallyRigid K (Option I) (graph (Fin (a + 2) × Q)) := by
  classical
  have hL : GenericallyRigid K (Option I)
      ((graph (Fin (a + 2) × Q)).induce (lowerCone (Q := Q) a)) :=
    embeddedCone_rigid (lowerEmbedding a) ⊤ (top_not_lower a)
      (fun _ => Or.inr le_top) h
  have hU : GenericallyRigid K (Option I)
      ((graph (Fin (a + 2) × Q)).induce (upperCone (Q := Q) a)) :=
    embeddedCone_rigid (upperEmbedding a) ⊥ (bot_not_upper a)
      (fun _ => Or.inl bot_le) h
  have hc : Fintype.card (Option I) + 1 ≤
      Fintype.card ↥(lowerCone (Q := Q) a ∩ upperCone (Q := Q) a) := by
    have he := card_intersection (Q := Q) a
    rw [Nat.card_eq_fintype_card] at he
    rw [he, Fintype.card_option]
    omega
  have hG := genericallyRigid_union (graph (Fin (a + 2) × Q))
    (lowerCone (Q := Q) a) (upperCone (Q := Q) a) hL hU hc
  let e : (Fin (a + 2) × Q) ≃ ↥(lowerCone (Q := Q) a ∪ upperCone (Q := Q) a) :=
    { toFun := fun v => ⟨v,cones_cover a v⟩
      invFun := Subtype.val
      left_inv := fun _ => rfl
      right_inv := fun _ => Subtype.ext rfl }
  have ht := genericallyRigid_comap_equiv
    ((graph (Fin (a + 2) × Q)).induce (lowerCone (Q := Q) a ∪ upperCone (Q := Q) a)) e hG
  have he : ((graph (Fin (a + 2) × Q)).induce (lowerCone (Q := Q) a ∪ upperCone (Q := Q) a)).comap e =
      graph (Fin (a + 2) × Q) := by ext v w; rfl
  simpa only [he] using ht

/-- Equation (6), with exactly the parameters and inequality printed in the
paper. The positivity of `|Q|` follows from the bounded order. -/
theorem increase_chain_of_paper_bound [Infinite K] (a s e : ℕ)
    (h : GenericallyRigid K I (graph (Fin (a + 1) × Q)))
    (hdim : Fintype.card I = a + s + e)
    (hoverlap : a * (Fintype.card Q - 1) ≥ s + e) :
    GenericallyRigid K (Option I) (graph (Fin (a + 2) × Q)) := by
  apply increase_chain a h
  have hq : 1 ≤ Fintype.card Q := Fintype.card_pos_iff.mpr ⟨⊥⟩
  have he : a * Fintype.card Q = a * (Fintype.card Q - 1) + a := by
    calc
      _ = a * ((Fintype.card Q - 1) + 1) := by rw [Nat.sub_add_cancel hq]
      _ = _ := by ring
  rw [hdim, he]
  omega

end Product

end PaperVerification.Segre.ChainPropagation
end
end ProbeLayer63

section ProbeLayer64



/-!
# Rigidity is invariant under permutation of spatial coordinates

This file transports placements, velocities, translations and alternating
matrices through an explicit coordinate equivalence. It allows the cone-based
constructions to be stated in the usual spaces `K^r` indexed by `Fin r`.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericRigidity

open Matrix
open scoped Matrix

variable {K I J V : Type*} [Field K] [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Fintype V]

/-- Spatial coordinate relabeling preserves spanning and infinitesimal rigidity. -/
theorem genericallyRigid_coordinates (G : SimpleGraph V) (e : I ≃ J)
    (hG : GenericallyRigid K I G) : GenericallyRigid K J G := by
  obtain ⟨p,hp,hr⟩ := hG
  let q : Matrix V J K := Matrix.of (fun v j => p v (e.symm j))
  have hq : affineSpan K (Set.range q) = ⊤ := by
    apply affineSpan_of_augmented_surjective q
    intro y
    obtain ⟨c,hc⟩ := augmented_surjective_of_affineSpan p hp (fun o => y (o.map e))
    refine ⟨c, ?_⟩
    funext j
    cases j with
    | none => exact congrFun hc none
    | some j =>
      have h := congrFun hc (some (e.symm j))
      simpa only [Matrix.vecMul, dotProduct, augmentedPlacement, augmentedPosition,
        Option.map_some, Equiv.apply_symm_apply, q, Matrix.of_apply] using h
  refine ⟨q,hq,?_⟩
  intro u hu
  let u' : V → I → K := fun v i => u v (e i)
  have hbase : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, G.Adj v w →
      (p v - p w) ⬝ᵥ (u' v - u' w) = 0 := by
    intro v _ w _ hvw
    have h := hu v (Set.mem_univ _) w (Set.mem_univ _) hvw
    have he : (q v - q w) ∘ e = p v - p w := by
      funext i
      simp only [Function.comp_apply, Pi.sub_apply, q, Matrix.of_apply,
        Equiv.symm_apply_apply]
    have hre := comp_equiv_dotProduct_comp_equiv (q v - q w) (u v - u w) e
    rw [he] at hre
    exact hre.trans h
  obtain ⟨M,t,hMt,hMd,hm⟩ := hr u' hbase
  let M' : Matrix J J K := Matrix.of (fun i j => M (e.symm i) (e.symm j))
  refine ⟨M', (fun j => t (e.symm j)), ?_, ?_, ?_⟩
  · ext i j
    exact congrFun (congrFun hMt (e.symm i)) (e.symm j)
  · intro j
    exact hMd (e.symm j)
  · intro v _
    funext j
    have he : (M' *ᵥ q v) j = (M *ᵥ p v) (e.symm j) := by
      change (∑ i : J, M (e.symm j) (e.symm i) * p v (e.symm i)) =
        ∑ i : I, M (e.symm j) i * p v i
      exact Equiv.sum_comp e.symm (fun i : I => M (e.symm j) i * p v i)
    have h := congrFun (hm v (Set.mem_univ _)) (e.symm j)
    change u v (e (e.symm j)) = (M *ᵥ p v) (e.symm j) + t (e.symm j) at h
    rw [Equiv.apply_symm_apply, ← he] at h
    exact h

/-- Any verified finite coordinate model of dimension `r` gives the usual
`Fin r`-indexed formulation of generic rigidity. -/
theorem genericallyRigid_fin (G : SimpleGraph V) (r : ℕ)
    (hcard : Fintype.card I = r) (hG : GenericallyRigid K I G) :
    GenericallyRigid K (Fin r) G := by
  classical
  let e : I ≃ Fin r := Fintype.equivOfCardEq (by simpa only [Fintype.card_fin] using hcard)
  exact genericallyRigid_coordinates G e hG

end PaperVerification.Segre.GenericRigidity
end
end ProbeLayer64


/-! Future-only kernel audit for one exported mathematical stage.

Append to the stage being checked, with Lean.Util.CollectAxioms available through
both `public import Lean.Util.CollectAxioms` and `import all Lean.Util.CollectAxioms`
in that stage's header, as required by the reviewed FullFlattenedAudit.

Every new declaration in the checked kernel environment is included: public,
private, generated and vendored declarations receive the same direct-sorry and
transitive-axiom checks. This is evidence for this stage only. Later principal
theorems need not exist yet, and the final full principal audit remains required.

This preparation does not execute the audit, export a module or alter a proof.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The stage kernel audit requires kernel trust level zero"
  let names := (env.checked.get.constants.foldStage2
    (fun (names : Array Name) name _ => names.push name) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The stage mathematical module is empty"
  let privateEnv := env.setExporting false
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut theoremCount : Nat := 0
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if let .thmInfo _ := info then
      theoremCount := theoremCount + 1
  let report := Json.mkObj [
    ("main_module", toJson env.header.mainModule.toString),
    ("declaration_count", toJson names.size),
    ("theorem_count", toJson theoremCount),
    ("trust_level", toJson env.header.trustLevel.toNat),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("audit_scope", toJson "current_stage_new_declarations")]
  logInfo m!"SEGRE_STAGE_KERNEL_AUDIT_PASS {report.compress}"
