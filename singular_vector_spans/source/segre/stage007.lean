open CategoryTheory CategoryTheory.Limits Opposite
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.FiniteCohomologyProducts

universe w v u
variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [HasSheafify J AddCommGrpCat.{v}]
  [HasExt.{w} (Sheaf J AddCommGrpCat.{v})]

theorem subsingleton_H'_of_iso {F G : Sheaf J AddCommGrpCat.{v}}
    (e : F ≅ G) (n : ℕ) (V : C) (hG : Subsingleton (G.H'.{w} n V)) :
    Subsingleton (F.H'.{w} n V) := by
  haveI := hG
  exact AddCommGrpCat.subsingleton_of_isZero
    (IsZero.of_iso (AddCommGrpCat.isZero_of_subsingleton (G.H'.{w} n V))
      (((Sheaf.cohomologyPresheafFunctor J n).mapIso e).app (op V)))

/-- A finite product has vanishing cohomology when each factor does. -/
theorem subsingleton_H'_pi {ι : Type v} [Finite ι]
    (F : ι → Sheaf J AddCommGrpCat.{v}) (n : ℕ) (V : C)
    (hF : ∀ i, Subsingleton ((F i).H'.{w} n V)) :
    Subsingleton ((∏ᶜ F).H'.{w} n V) := by
  simp only [sheafH'_eq] at hF ⊢
  let H : Sheaf J AddCommGrpCat.{v} ⥤ AddCommGrpCat.{w} :=
    Abelian.extFunctorObj ((freeYonedaSheafFunctor J).obj V) n
  have hfactor (i : ι) : IsZero (H.obj (F i)) := by
    letI : Subsingleton (H.obj (F i)) := by
      change Subsingleton (Abelian.Ext.{w} ((freeYonedaSheafFunctor J).obj V) (F i) n)
      exact hF i
    exact AddCommGrpCat.isZero_of_subsingleton _
  have hproduct : IsZero (∏ᶜ fun i ↦ H.obj (F i)) := by
    rw [IsZero.iff_id_eq_zero]
    apply Pi.hom_ext
    intro i
    simpa only [Category.id_comp, zero_comp] using
      (hfactor i).eq_of_tgt (Pi.π (fun i ↦ H.obj (F i)) i) 0
  exact AddCommGrpCat.subsingleton_of_isZero
    (IsZero.of_iso hproduct (PreservesProduct.iso H F))

end PaperVerification.Segre.FiniteCohomologyProducts
