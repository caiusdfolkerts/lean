theorem h1Completion_rigid [Infinite K] : GenericallyRigid K Dim2 h1Completion := by
  have h0 : GenericallyRigid K Dim2 triangle := complete_genericallyRigid (by decide)
  have h1 : GenericallyRigid K Dim2 h1B := addLast_rigid _ _ h0 (by decide)
  have h2 : GenericallyRigid K Dim2 h1D := addLast_rigid _ _ h1 (by decide)
  exact addLast_rigid _ _ h2 (by decide)

theorem h2Completion_rigid [Infinite K] : GenericallyRigid K Dim3 h2Completion := by
  have h0 : GenericallyRigid K Dim3 h2D := coneLast_rigid _ h1Completion_rigid
  have h1 : GenericallyRigid K Dim3 h2C :=
    oneExtendLast_rigid _ _ _ _ h0 (by decide) (by decide) (by decide) (by decide)
  have h2 : GenericallyRigid K Dim3 h2B := addLast_rigid _ _ h1 (by decide)
  exact oneExtendLast_rigid _ _ _ _ h2 (by decide) (by decide) (by decide) (by decide)

theorem h3Completion_rigid [Infinite K] : GenericallyRigid K Dim4 h3Completion := by
  have h0 : GenericallyRigid K Dim4 h3D := coneLast_rigid _ h2Completion_rigid
  have h1 : GenericallyRigid K Dim4 h3B :=
    oneExtendLast_rigid _ _ _ _ h0 (by decide) (by decide) (by decide) (by decide)
  have h2 : GenericallyRigid K Dim4 h3C :=
    oneExtendLast_rigid _ _ _ _ h1 (by decide) (by decide) (by decide) (by decide)
  exact addLast_rigid _ _ h2 (by decide)

theorem h4Core_rigid [Infinite K] : GenericallyRigid K Dim5 h4Core := by
  have h0 : GenericallyRigid K Dim5 h4D := coneLast_rigid _ h3Completion_rigid
  have h1 : GenericallyRigid K Dim5 h4B :=
    oneExtendLast_rigid _ _ _ _ h0 (by decide) (by decide) (by decide) (by decide)
  have h2 : GenericallyRigid K Dim5 h4C := addLast_rigid _ _ h1 (by decide)
  exact addLast_rigid _ _ h2 (by decide)

theorem h122Core_rigid [Infinite K] : GenericallyRigid K Dim4 h122Core := by
  have h0 : GenericallyRigid K Dim4 h3D := coneLast_rigid _ h2Completion_rigid
  have h1 : GenericallyRigid K Dim4 h122F1 :=
    oneExtendLast_rigid _ _ _ _ h0 (by decide) (by decide) (by decide) (by decide)
  have h2 : GenericallyRigid K Dim4 h122E2 :=
    oneExtendLast_rigid _ _ _ _ h1 (by decide) (by decide) (by decide) (by decide)
  have h3 : GenericallyRigid K Dim4 h122E1 :=
    oneExtendLast_rigid _ _ _ _ h2 (by decide) (by decide) (by decide) (by decide)
  have h4 : GenericallyRigid K Dim4 h122F0 := addLast_rigid _ _ h3 (by decide)
  exact addLast_rigid _ _ h4 (by decide)

/-- The actual proper part of a finite product of chains. -/
abbrev ProperCell {J : Type*} (n : J → ℕ) := {u : Cell n // u ≠ ⊥ ∧ u ≠ ⊤}

def properChainGraph {J : Type*} [Fintype J] (n : J → ℕ) : SimpleGraph (ProperCell n) :=
  (chainGraph n).induce {u | u ≠ ⊥ ∧ u ≠ ⊤}

instance properChainGraph_decidable {J : Type*} [Fintype J] [DecidableEq J] (n : J → ℕ) :
    DecidableRel (properChainGraph n).Adj :=
  fun _ _ => inferInstanceAs (Decidable (_ ∧ (_ ∨ _)))

/-- Construct a three-coordinate cell with the actual dependent bounds. -/
def tripleCell {n : Fin 3 → ℕ} (x : Fin (n 0 + 1)) (y : Fin (n 1 + 1))
    (z : Fin (n 2 + 1)) : Cell n :=
  Fin.cases x (Fin.cases y (Fin.cases z (fun i => Fin.elim0 i)))

