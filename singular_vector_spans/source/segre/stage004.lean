section ProbeLayer68



/-!
# Coordinate invariance of generic stress-freeness

The rigidity matrix changes only by an explicit permutation of its columns.
Its rank and the affine-spanning condition are therefore preserved in every
characteristic.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.StressFree

open Matrix RigidityRank GraphKernel GenericRigidity
open scoped Matrix

variable {K I J V : Type*} [Field K] [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Fintype V]

theorem genericallyStressFree_coordinates (G : SimpleGraph V) [DecidableRel G.Adj]
    (e : I ≃ J) (hG : GenericallyStressFree K I G) : GenericallyStressFree K J G := by
  classical
  obtain ⟨p,hp,hr⟩ := hG
  let q : Matrix V J K := Matrix.of (fun v j => p v (e.symm j))
  have hq : affineSpan K (Set.range q) = ⊤ := by
    apply affineSpan_of_augmented_surjective q
    intro y
    obtain ⟨c,hc⟩ := augmented_surjective_of_affineSpan p hp (fun o => y (o.map e))
    refine ⟨c, ?_⟩
    funext j
    cases j with
    | none => exact congrFun hc none
    | some j =>
      have h := congrFun hc (some (e.symm j))
      simpa only [Matrix.vecMul, dotProduct, augmentedPlacement, augmentedPosition,
        Option.map_some, Equiv.apply_symm_apply, q, Matrix.of_apply] using h
  refine ⟨q,hq,?_⟩
  have hm : rigidityMatrix q (endpoints G) =
      (rigidityMatrix p (endpoints G)).submatrix (Equiv.refl (Edges G))
        ((Equiv.refl V).prodCongr e.symm) := by
    ext a vi
    change
      ((if vi.1 = a.val.1 then p a.val.1 (e.symm vi.2) - p a.val.2 (e.symm vi.2) else 0) -
        (if vi.1 = a.val.2 then p a.val.1 (e.symm vi.2) - p a.val.2 (e.symm vi.2) else 0)) =
      ((if vi.1 = a.val.1 then p a.val.1 (e.symm vi.2) - p a.val.2 (e.symm vi.2) else 0) -
        (if vi.1 = a.val.2 then p a.val.1 (e.symm vi.2) - p a.val.2 (e.symm vi.2) else 0))
    rfl
  rw [hm, Matrix.rank_submatrix]
  exact hr

theorem genericallyStressFree_fin (G : SimpleGraph V) [DecidableRel G.Adj]
    (r : ℕ) (hcard : Fintype.card I = r) (hG : GenericallyStressFree K I G) :
    GenericallyStressFree K (Fin r) G := by
  classical
  let e : I ≃ Fin r := Fintype.equivOfCardEq (by simpa only [Fintype.card_fin] using hcard)
  exact genericallyStressFree_coordinates G e hG

end PaperVerification.Segre.StressFree
end
