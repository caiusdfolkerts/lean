/-!
# The exact three-chain rigidity cores

These are the literal finite constructions on pages 12--13. All intermediate
edges, including the temporary completion edges, are tracked explicitly. The
final coordinate labels are bijections with the proper parts of the specified
products of chains, and every retained edge is checked against comparability.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ThreeChainCores

open GenericRigidity BooleanBase Staircase RankParameters StressFree

variable {K I : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- Append a universal cone vertex at the final index. -/
def coneLast {m : ℕ} (G : SimpleGraph (Fin m)) : SimpleGraph (Fin (m + 1)) :=
  (coneGraph G).comap (finSuccEquiv' (Fin.last m))

instance coneGraph_decidable {V : Type*} (G : SimpleGraph V) [DecidableRel G.Adj] :
    DecidableRel (coneGraph G).Adj := by
  intro v w
  cases v <;> cases w <;> dsimp [coneGraph] <;> infer_instance

instance coneLast_decidable {m : ℕ} (G : SimpleGraph (Fin m)) [DecidableRel G.Adj] :
    DecidableRel (coneLast G).Adj := by
  dsimp [coneLast]
  infer_instance

theorem coneLast_rigid {m : ℕ} (G : SimpleGraph (Fin m))
    (hG : GenericallyRigid K I G) : GenericallyRigid K (Option I) (coneLast G) :=
  genericallyRigid_comap_equiv (coneGraph G) (finSuccEquiv' (Fin.last m))
    (genericallyRigid_cone G hG)

def triangle : SimpleGraph (Fin 3) := ⊤
instance : DecidableRel triangle.Adj := inferInstanceAs (DecidableRel ((⊤ : SimpleGraph (Fin 3))).Adj)
def h1B : SimpleGraph (Fin 4) := addLast triangle {0,1}
instance : DecidableRel h1B.Adj := inferInstanceAs (DecidableRel (addLast triangle {0,1}).Adj)
def h1D : SimpleGraph (Fin 5) := addLast h1B {1,2}
instance : DecidableRel h1D.Adj := inferInstanceAs (DecidableRel (addLast h1B {1,2}).Adj)
def h1Completion : SimpleGraph (Fin 6) := addLast h1D {0,2}
instance : DecidableRel h1Completion.Adj := inferInstanceAs (DecidableRel (addLast h1D {0,2}).Adj)

def h2D : SimpleGraph (Fin 7) := coneLast h1Completion
instance : DecidableRel h2D.Adj := inferInstanceAs (DecidableRel (coneLast h1Completion).Adj)
def h2C : SimpleGraph (Fin 8) := oneExtendLast h2D 1 2 {0,1,2,5}
instance : DecidableRel h2C.Adj := inferInstanceAs (DecidableRel (oneExtendLast h2D 1 2 {0,1,2,5}).Adj)
def h2B : SimpleGraph (Fin 9) := addLast h2C {0,1,3}
instance : DecidableRel h2B.Adj := inferInstanceAs (DecidableRel (addLast h2C {0,1,3}).Adj)
