/-- Move the stress-free assertion from an explicit coordinate labeling to the
literal graph, using the proved graph-equivalence invariance. -/
theorem stressFree_of_comap_equiv {V W : Type*} [Fintype V] [Fintype W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (e : V ≃ W)
    (h : GenericallyStressFree K I (G.comap e)) : GenericallyStressFree K I G := by
  have hr := genericallyStressFree_comap_equiv (G.comap e) e.symm h
  have he : (G.comap e).comap e.symm = G := by
    ext v w
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using hr

