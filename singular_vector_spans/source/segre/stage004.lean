instance : DecidableRel h2Completion.Adj := inferInstanceAs (DecidableRel (oneExtendLast h2B 1 7 {0,1,8,7}).Adj)

def h3D : SimpleGraph (Fin 11) := coneLast h2Completion
instance : DecidableRel h3D.Adj := inferInstanceAs (DecidableRel (coneLast h2Completion).Adj)
