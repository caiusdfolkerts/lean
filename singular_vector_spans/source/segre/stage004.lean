section ProbeLayer65



/-!
# Coordinate increments and unrestricted positive products of chains

A product is split at any chosen coordinate by an explicit order isomorphism.
The exact cone-overlap construction therefore applies to every coordinate.
For at least three positive chains, the required overlap follows from the
unrestricted inequality `∏(nᵢ+1) ≥ ∑nᵢ+2` for the other two or more factors.
Strong induction then propagates every positive starting box to every larger
box, with the rigidity dimension stated as exactly `1 + ∑nᵢ`.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ChainInduction

open GenericRigidity Comparability ChainPropagation Staircase RankParameters

variable {K D J V W : Type*} [Field K] [Fintype D] [DecidableEq D]
  [Fintype J] [DecidableEq J]

/-- Comparability graphs respect an actual order isomorphism. -/
theorem orderIso_graph [PartialOrder V] [PartialOrder W] (e : V ≃o W) :
    (graph W).comap e.toEquiv = graph V := by
  ext v w
  change (e v ≠ e w ∧ (e v ≤ e w ∨ e w ≤ e v)) ↔
    (v ≠ w ∧ (v ≤ w ∨ w ≤ v))
  rw [e.injective.ne_iff, e.le_iff_le, e.le_iff_le]

theorem orderIso_rigid [PartialOrder V] [PartialOrder W] (e : V ≃o W)
    (h : GenericallyRigid K D (graph V)) : GenericallyRigid K D (graph W) := by
  have hr := BooleanBase.genericallyRigid_comap_equiv (graph V) e.symm.toEquiv h
  simpa only [orderIso_graph] using hr

/-- Order-isomorphic factors give an order isomorphism of their dependent products. -/
def piOrderCongr {L : Type*} {α β : L → Type*}
    [∀ i, PartialOrder (α i)] [∀ i, PartialOrder (β i)]
    (e : ∀ i, α i ≃o β i) : (∀ i, α i) ≃o (∀ i, β i) where
  toEquiv := Equiv.piCongrRight (fun i => (e i).toEquiv)
  map_rel_iff' := by
    intro u v
    constructor
    · intro h i
      exact (e i).le_iff_le.mp (h i)
    · intro h i
      exact (e i).le_iff_le.mpr (h i)

def prodOrderCongr {A B C E : Type*} [PartialOrder A] [PartialOrder B]
    [PartialOrder C] [PartialOrder E] (e : A ≃o B) (f : C ≃o E) :
    A × C ≃o B × E where
  toEquiv := e.toEquiv.prodCongr f.toEquiv
  map_rel_iff' := by intro u v; exact and_congr e.le_iff_le f.le_iff_le

/-- Split the chosen coordinate from the actual dependent product of chains. -/
noncomputable def splitCell (n : J → ℕ) (i : J) :
    Cell n ≃o Fin (n i + 1) × Cell (fun j : {j : J // j ≠ i} => n j.val) where
  toEquiv := Equiv.piSplitAt i (fun j => Fin (n j + 1))
  map_rel_iff' := by
    intro u v
    change (u i ≤ v i ∧ (∀ j : {j : J // j ≠ i}, u j.val ≤ v j.val)) ↔ u ≤ v
    constructor
    · rintro ⟨hi,hrest⟩ j
      by_cases h : j = i
      · subst j
        exact hi
      · exact hrest ⟨j,h⟩
    · intro h
      exact ⟨h i, fun j => h j.val⟩

/-- Split the enlarged chain while identifying every untouched factor with its
original factor, using the explicit equality supplied by `Function.update`. -/
noncomputable def splitUpdatedCell (n : J → ℕ) (i : J) :
    Cell (Function.update n i (n i + 1)) ≃o
      Fin (n i + 2) × Cell (fun j : {j : J // j ≠ i} => n j.val) := by
  let e : Fin (Function.update n i (n i + 1) i + 1) ≃o Fin (n i + 2) :=
    Fin.castOrderIso (by simp)
  let f := piOrderCongr (fun j : {j : J // j ≠ i} =>
    Fin.castOrderIso (show Function.update n i (n i + 1) j.val + 1 = n j.val + 1 by
      rw [Function.update_of_ne j.property]))
  exact (splitCell (Function.update n i (n i + 1)) i).trans (prodOrderCongr e f)

/-- The exact propagation construction applies to any chosen factor. -/
theorem increase_cell [Infinite K] (n : J → ℕ) (i : J)
    (h : GenericallyRigid K D (chainGraph n))
    (hcard : Fintype.card D ≤ n i *
      Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val))) :
    GenericallyRigid K (Option D) (chainGraph (Function.update n i (n i + 1))) := by
  classical
  have hp := orderIso_rigid (splitCell n i) h
  have hn := increase_chain (Q := Cell (fun j : {j : J // j ≠ i} => n j.val))
    (n i) hp hcard
  exact orderIso_rigid (splitUpdatedCell n i).symm hn

/-- The elementary product bound without a positivity assumption. -/
theorem sum_add_one_le_product {L : Type*} (s : Finset L) (n : L → ℕ) :
    (∑ i ∈ s, n i) + 1 ≤ ∏ i ∈ s, (n i + 1) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.prod_insert hi]
      have hm := Nat.mul_le_mul_left (n i + 1) ih
      have hcross : 0 ≤ n i * (∑ j ∈ s, n j) := Nat.zero_le _
      nlinarith

/-- At least two positive factors give the one extra vertex needed for gluing. -/
theorem sum_add_two_le_product {L : Type*} (s : Finset L) (n : L → ℕ)
    (hcard : 2 ≤ s.card) (hpos : ∀ i ∈ s, 1 ≤ n i) :
    (∑ i ∈ s, n i) + 2 ≤ ∏ i ∈ s, (n i + 1) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp at hcard
  | @insert i s hi ih =>
      have hs : s.Nonempty := Finset.card_pos.mp (by
        rw [Finset.card_insert_of_notMem hi] at hcard
        omega)
      obtain ⟨j,hj⟩ := hs
      have hn : 1 ≤ n i := hpos i (Finset.mem_insert_self _ _)
      have hsum : 1 ≤ ∑ j ∈ s, n j := le_trans
        (hpos j (Finset.mem_insert_of_mem hj))
        (Finset.single_le_sum (fun j _ => Nat.zero_le (n j)) hj)
      have hp := sum_add_one_le_product s n
      have hm := Nat.mul_le_mul_left (n i + 1) hp
      have hcross := Nat.mul_le_mul hn hsum
      rw [Finset.sum_insert hi, Finset.prod_insert hi]
      nlinarith

/-- Exact sum decomposition into one distinguished length and all other lengths. -/
theorem sideSum_split (n : J → ℕ) (i : J) :
    sideSum n = n i + sideSum (fun j : {j : J // j ≠ i} => n j.val) :=
  Fintype.sum_eq_add_sum_subtype_ne n i

/-- The exact overlap lower bound for every positive tuple with three or more
factors. This proves the stated propagation hypothesis instead of assuming it. -/
theorem firstLefschetz_overlap (n : J → ℕ) (hpos : ∀ j, 1 ≤ n j)
    (hcard : 3 ≤ Fintype.card J) (i : J) :
    sideSum n + 1 ≤ n i * Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val)) := by
  classical
  have hc : Fintype.card {j : J // j ≠ i} = Fintype.card J - 1 := by
    rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
  have hQ : sideSum (fun j : {j : J // j ≠ i} => n j.val) + 2 ≤
      Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val)) := by
    simp only [Fintype.card_pi, Fintype.card_fin]
    apply sum_add_two_le_product Finset.univ
    · simp only [Finset.card_univ, hc]
      omega
    · intro j _
      exact hpos j.val
  have hn := hpos i
  have hm := Nat.mul_le_mul_left (n i) hQ
  have hs := Nat.mul_le_mul_right
    (sideSum (fun j : {j : J // j ≠ i} => n j.val)) hn
  rw [sideSum_split n i]
  nlinarith

theorem sideSum_update (n : J → ℕ) (i : J) (a : ℕ) :
    sideSum (Function.update n i a) + n i = sideSum n + a := by
  have h₁ := Finset.sum_update_of_mem (Finset.mem_univ i) n a
  have h₂ := Finset.sum_update_of_mem (Finset.mem_univ i) n (n i)
  simp only [Function.update_eq_self] at h₂
  unfold sideSum
  rw [h₁,h₂]
  omega

/-- Every larger positive box inherits first-Lefschetz-dimension rigidity from
one positive starting box, without any bound on the final chain lengths. -/
theorem propagate_positive [Infinite K] (m n : J → ℕ)
    (hcard : 3 ≤ Fintype.card J) (hpos : ∀ j, 1 ≤ m j) (hmn : m ≤ n)
    (hbase : GenericallyRigid K (Fin (sideSum m + 1)) (chainGraph m)) :
    GenericallyRigid K (Fin (sideSum n + 1)) (chainGraph n) := by
  classical
  suffices h : ∀ d, ∀ n : J → ℕ, sideSum n = d → m ≤ n →
      GenericallyRigid K (Fin (sideSum n + 1)) (chainGraph n) from h _ n rfl hmn
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro n hd hmn
    by_cases he : n = m
    · subst n
      exact hbase
    have hne : ¬∀ j, m j = n j := fun h => he (funext h).symm
    obtain ⟨i,hi⟩ := not_forall.mp hne
    have hlt : m i < n i := lt_of_le_of_ne (hmn i) hi
    let p := Function.update n i (n i - 1)
    have hmp : m ≤ p := by
      intro j
      by_cases hj : j = i
      · subst j
        simp only [p, Function.update_self]
        omega
      · simpa only [p, Function.update_of_ne hj] using hmn j
    have hppos : ∀ j, 1 ≤ p j := fun j => (hpos j).trans (hmp j)
    have hside : sideSum p + 1 = sideSum n := by
      have h := sideSum_update n i (n i - 1)
      change sideSum p + n i = sideSum n + (n i - 1) at h
      omega
    have hp := ih (sideSum p) (by omega) p rfl hmp
    have hinc := increase_cell p i hp (by
      simpa only [Fintype.card_fin] using firstLefschetz_overlap p hppos hcard i)
    have hupdate : Function.update p i (p i + 1) = n := by
      funext j
      by_cases hj : j = i
      · subst j
        simp only [p, Function.update_self]
        omega
      · simp only [p, Function.update_of_ne hj]
    rw [hupdate] at hinc
    apply genericallyRigid_fin (chainGraph n) (sideSum n + 1) _ hinc
    simp only [Fintype.card_option, Fintype.card_fin]
    omega

/-- All positive products with at least four factors are rigid in the exact
first Lefschetz dimension, over every infinite field. -/
theorem positive_four_or_more [Infinite K] (k : ℕ) (hk : 4 ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i) :
    GenericallyRigid K (Fin (sideSum n + 1)) (chainGraph n) := by
  classical
  obtain ⟨q,hq⟩ := Nat.exists_eq_add_of_le hk
  have he : k = q + 4 := by omega
  clear hq
  subst k
  let m : Fin (q + 4) → ℕ := fun _ => 1
  have hm : sideSum m = q + 4 := by simp [sideSum, m]
  have hbase : GenericallyRigid K (Fin (sideSum m + 1)) (chainGraph m) := by
    apply genericallyRigid_fin (chainGraph m) (sideSum m + 1) _ (fullBoolean_rigid (K := K) q)
    rw [dimension_fullBoolean, hm]
  apply propagate_positive m n (by simp only [Fintype.card_fin]; omega)
    (fun _ => le_rfl) hpos hbase

end PaperVerification.Segre.ChainInduction
end
end ProbeLayer65

section ProbeLayer66



/-!
# Stress-freeness from exact rigidity rank

Every unoriented edge is represented once by ordering its endpoints. The map
from the two orientations to this one-row-per-edge matrix has the same kernel.
Consequently twice its rank equals the number of oriented edges exactly when
those edge rows are linearly independent. This gives a characteristic-free
stress-freeness criterion and allows restriction to arbitrary subgraphs.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.StressFree

open Matrix RigidityRank GraphKernel GenericRigidity
open scoped Matrix

variable {K I V W : Type*} [Field K] [Fintype I] [DecidableEq I] [Fintype V]

/-- The usual generic stress-free property, expressed without choosing an edge
orientation. The equivalence with independent single edge rows is proved below. -/
def GenericallyStressFree (K I : Type*) [Field K] [Fintype I] [DecidableEq I]
    {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=
  ∃ p : Matrix V I K, affineSpan K (Set.range p) = ⊤ ∧
    2 * (rigidityMatrix p (endpoints G)).rank = Fintype.card (Edges G)

section Ordered

variable [LinearOrder V]

abbrev EdgesOnce (G : SimpleGraph V) := {vw : V × V // vw.1 < vw.2 ∧ G.Adj vw.1 vw.2}

def endpointsOnce (G : SimpleGraph V) : EdgesOnce G → V × V := Subtype.val

/-- The two orientations are exactly two copies of the single-edge index type. -/
noncomputable def orientationEquiv (G : SimpleGraph V) : Edges G ≃ EdgesOnce G ⊕ EdgesOnce G := by
  classical
  exact
    { toFun := fun e => if h : e.val.1 < e.val.2 then
          Sum.inl ⟨e.val, h, e.property⟩ else
          Sum.inr ⟨(e.val.2, e.val.1),
            lt_of_le_of_ne (le_of_not_gt h) (Ne.symm (G.ne_of_adj e.property)), e.property.symm⟩
      invFun := fun e => match e with
        | Sum.inl e => ⟨e.val, e.property.2⟩
        | Sum.inr e => ⟨(e.val.2, e.val.1), e.property.2.symm⟩
      left_inv := fun e => by
        by_cases h : e.val.1 < e.val.2 <;> simp only [h, dif_pos, dif_neg] <;> rfl
      right_inv := fun e => by
        cases e with
        | inl e => simp only [dif_pos e.property.1]
        | inr e => simp only [dif_neg (not_lt_of_gt e.property.1)] }

theorem card_oriented_edges (G : SimpleGraph V) [DecidableRel G.Adj] :
    Fintype.card (Edges G) = 2 * Fintype.card (EdgesOnce G) := by
  rw [Fintype.card_congr (orientationEquiv G), Fintype.card_sum]
  omega

/-- Forgetting the duplicate reverse-edge rows does not change the velocity
kernel. The edge equation is unchanged when both differences are negated. -/
theorem kernel_edgesOnce (G : SimpleGraph V) (p : Matrix V I K) :
    LinearMap.ker (rigidityMap p (endpointsOnce G)) =
      LinearMap.ker (rigidityMap p (endpoints G)) := by
  ext u
  constructor
  · intro hu
    funext e
    have hne : e.val.1 ≠ e.val.2 := G.ne_of_adj e.property
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · exact congrFun hu ⟨e.val, hlt, e.property⟩
    · have h := congrFun hu ⟨(e.val.2,e.val.1), hgt, e.property.symm⟩
      change (p e.val.1 - p e.val.2) ⬝ᵥ (u e.val.1 - u e.val.2) = 0
      change (p e.val.2 - p e.val.1) ⬝ᵥ (u e.val.2 - u e.val.1) = 0 at h
      simpa only [← neg_sub (p e.val.1) (p e.val.2),
        ← neg_sub (u e.val.1) (u e.val.2), neg_dotProduct, dotProduct_neg, neg_neg] using h
  · intro hu
    funext e
    exact congrFun hu ⟨e.val, e.property.2⟩

theorem rank_edgesOnce (G : SimpleGraph V) [DecidableRel G.Adj] (p : Matrix V I K) :
    (rigidityMatrix p (endpointsOnce G)).rank = (rigidityMatrix p (endpoints G)).rank := by
  rw [rigidityMatrix_rank, rigidityMatrix_rank]
  have h₁ := (rigidityMap p (endpointsOnce G)).finrank_range_add_finrank_ker
  have h₂ := (rigidityMap p (endpoints G)).finrank_range_add_finrank_ker
  rw [kernel_edgesOnce] at h₁
  omega

/-- The orientation-free rank condition is precisely independence of one
literal rigidity row for each edge. -/
theorem stressFree_iff_rows_independent (G : SimpleGraph V) [DecidableRel G.Adj]
    (p : Matrix V I K) :
    2 * (rigidityMatrix p (endpoints G)).rank = Fintype.card (Edges G) ↔
      LinearIndependent K (rigidityMatrix p (endpointsOnce G)).row := by
  rw [card_oriented_edges, ← rank_edgesOnce]
  constructor
  · intro h
    have hr : (rigidityMatrix p (endpointsOnce G)).rank = Fintype.card (EdgesOnce G) := by omega
    apply linearIndependent_iff_card_eq_finrank_span.mpr
    change Fintype.card (EdgesOnce G) =
      Module.finrank K (Submodule.span K (Set.range (rigidityMatrix p (endpointsOnce G)).row))
    rw [← Matrix.rank_eq_finrank_span_row, hr]
  · intro h
    rw [h.rank_matrix]

end Ordered

/-- A generically rigid graph with the exact Maxwell edge count is stress-free.
This is an implication of checked rank-nullity, not a sparsity criterion. -/
theorem genericallyStressFree_of_rigid (G : SimpleGraph V) [DecidableRel G.Adj]
    (hG : GenericallyRigid K I G)
    (hcard : Fintype.card (Edges G) =
      2 * (Fintype.card V * Fintype.card I - (Fintype.card I + 1).choose 2)) :
    GenericallyStressFree K I G := by
  obtain ⟨p, hp, hr⟩ := hG
  refine ⟨p, hp, ?_⟩
  rw [rigidityMatrix_rank, rigidity_rank_of_rigid G p hp hr, hcard]

/-- Deleting any set of edges preserves stress-freeness at the same placement. -/
theorem genericallyStressFree_mono {G H : SimpleGraph V}
    [DecidableRel G.Adj] [DecidableRel H.Adj] (hGH : G ≤ H)
    (hH : GenericallyStressFree K I H) : GenericallyStressFree K I G := by
  classical
  letI : LinearOrder V := LinearOrder.lift' (Fintype.equivFin V) (Fintype.equivFin V).injective
  obtain ⟨p, hp, hr⟩ := hH
  have hLI := (stressFree_iff_rows_independent H p).mp hr
  let e : EdgesOnce G ↪ EdgesOnce H :=
    ⟨fun e => ⟨e.val, e.property.1, hGH e.property.2⟩,
      fun a b h => Subtype.ext (congrArg (fun x : EdgesOnce H => x.val) h)⟩
  have hsub : LinearIndependent K (fun a : EdgesOnce G =>
      (rigidityMatrix p (endpointsOnce H)).row (e a)) := hLI.comp e e.injective
  refine ⟨p, hp, (stressFree_iff_rows_independent G p).mpr ?_⟩
  exact hsub

/-- Ordered endpoints relabel bijectively under a vertex equivalence. -/
noncomputable def edgesComapEquiv (G : SimpleGraph W) (e : V ≃ W) :
    Edges (G.comap e) ≃ Edges G where
  toFun a := ⟨(e a.val.1, e a.val.2), a.property⟩
  invFun a := ⟨(e.symm a.val.1, e.symm a.val.2), by
    simpa only [SimpleGraph.comap_adj, Equiv.apply_symm_apply] using a.property⟩
  left_inv a := by apply Subtype.ext; simp
  right_inv a := by apply Subtype.ext; simp

/-- Stress-freeness is invariant under explicit vertex relabeling. -/
theorem genericallyStressFree_comap_equiv [Fintype W]
    (G : SimpleGraph W) [DecidableRel G.Adj] (e : V ≃ W)
    (hG : GenericallyStressFree K I G) : GenericallyStressFree K I (G.comap e) := by
  obtain ⟨p, hp, hr⟩ := hG
  let q : Matrix V I K := Matrix.of (fun v => p (e v))
  have he : Set.range q = Set.range p := by
    ext x
    constructor
    · rintro ⟨v, rfl⟩
      exact ⟨e v, rfl⟩
    · rintro ⟨w, rfl⟩
      refine ⟨e.symm w, ?_⟩
      change p (e (e.symm w)) = p w
      rw [Equiv.apply_symm_apply]
  refine ⟨q, by simpa only [he] using hp, ?_⟩
  have hm : rigidityMatrix q (endpoints (G.comap e)) =
      (rigidityMatrix p (endpoints G)).submatrix (edgesComapEquiv G e)
        (e.prodCongr (Equiv.refl I)) := by
    classical
    ext a vi
    change
      ((if vi.1 = a.val.1 then p (e a.val.1) vi.2 - p (e a.val.2) vi.2 else 0) -
        (if vi.1 = a.val.2 then p (e a.val.1) vi.2 - p (e a.val.2) vi.2 else 0)) =
      ((if e vi.1 = e a.val.1 then p (e a.val.1) vi.2 - p (e a.val.2) vi.2 else 0) -
        (if e vi.1 = e a.val.2 then p (e a.val.1) vi.2 - p (e a.val.2) vi.2 else 0))
    by_cases h₁ : vi.1 = a.val.1 <;> by_cases h₂ : vi.1 = a.val.2 <;>
      simp only [e.injective.eq_iff, h₁, h₂, if_true, if_false]
  rw [hm, Matrix.rank_submatrix, Fintype.card_congr (edgesComapEquiv G e)]
  exact hr

end PaperVerification.Segre.StressFree
end
