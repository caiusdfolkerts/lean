/-- Reindexing after adding edges gives a rigid graph on its literal vertices. -/
theorem rigid_of_le_comap_equiv {V W : Type*} (G : SimpleGraph V) (H : SimpleGraph W)
    (e : V ≃ W) (hGH : G ≤ H.comap e) (hG : GenericallyRigid K I G) :
    GenericallyRigid K I H := by
  have h := genericallyRigid_comap_equiv (H.comap e) e.symm
    (genericallyRigid_mono hGH hG)
  have he : (H.comap e).comap e.symm = H := by
    ext v w
    simp only [SimpleGraph.comap_adj, Equiv.apply_symm_apply]
  simpa only [he] using h

/-- Every edge retained by the exact `(1,1,4)` construction is an actual
comparability edge. The previously temporary edges have all been consumed. -/
