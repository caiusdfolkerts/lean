section ProbeLayer69



/-!
# The unrestricted first-Lefschetz rigidity classification

The three exceptional triples are specified up to an actual permutation of the
factors. Every other positive triple dominates one of the two verified cores
`(1,1,4)` or `(1,2,2)` after sorting. Coordinate propagation then proves the
unrestricted result, with no upper bound on the chain lengths.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ChainClassification

open Staircase RankParameters GenericRigidity ChainInduction ThreeChainCores

variable {K : Type*} [Field K]

/-- Relabeling the factors is an order isomorphism of the actual dependent
products of chains, including the dependent finite coordinate bounds. -/
noncomputable def reindexCell {J L : Type*} (n : J → ℕ) (e : L ≃ J) :
    Cell (fun i => n (e i)) ≃o Cell n where
  toEquiv := Equiv.piCongrLeft (fun i => Fin (n i + 1)) e
  map_rel_iff' := by
    intro u v
    constructor
    · intro h i
      have hi := h (e i)
      simpa only [Equiv.piCongrLeft_apply_apply] using hi
    · intro h j
      obtain ⟨i,rfl⟩ := e.surjective j
      simpa only [Equiv.piCongrLeft_apply_apply] using h i

@[simp]
theorem sideSum_reindex {J L : Type*} [Fintype J] [Fintype L]
    (n : J → ℕ) (e : L ≃ J) : sideSum (fun i => n (e i)) = sideSum n :=
  Equiv.sum_comp e n

/-- The exact three exceptions, including all permutations of the factors. -/
def ExceptionalTriple (n : Fin 3 → ℕ) : Prop :=
  ∃ e : Equiv.Perm (Fin 3),
    (fun i => n (e i)) = shape111 ∨
    (fun i => n (e i)) = shape112 ∨
    (fun i => n (e i)) = shape113

/-- Every triple admits a sorting permutation. The six cases exhaust the weak
orders, so equal lengths introduce no hidden distinctness condition. -/
theorem sort_three (n : Fin 3 → ℕ) :
    ∃ e : Equiv.Perm (Fin 3), n (e 0) ≤ n (e 1) ∧ n (e 1) ≤ n (e 2) := by
  by_cases h01 : n 0 ≤ n 1
  · by_cases h12 : n 1 ≤ n 2
    · exact ⟨Equiv.refl _,h01,h12⟩
    · by_cases h02 : n 0 ≤ n 2
      · refine ⟨Equiv.swap 1 2, ?_⟩
        simpa [Equiv.swap_apply_def] using And.intro h02 (le_of_not_ge h12)
      · refine ⟨(Equiv.swap 0 2).trans (Equiv.swap 0 1), ?_⟩
        simpa [Equiv.trans_apply, Equiv.swap_apply_def] using
          And.intro (le_of_not_ge h02) h01
  · by_cases h02 : n 0 ≤ n 2
    · refine ⟨Equiv.swap 0 1, ?_⟩
      simpa [Equiv.swap_apply_def] using And.intro (le_of_not_ge h01) h02
    · by_cases h12 : n 1 ≤ n 2
      · refine ⟨(Equiv.swap 0 1).trans (Equiv.swap 0 2), ?_⟩
        simpa [Equiv.trans_apply, Equiv.swap_apply_def] using
          And.intro h12 (le_of_not_ge h02)
      · refine ⟨Equiv.swap 0 2, ?_⟩
        simpa [Equiv.swap_apply_def] using
          And.intro (le_of_not_ge h12) (le_of_not_ge h01)

/-- The exact full `(1,1,4)` core in the conventional coordinate space. -/
theorem base114_rigid [Infinite K] :
    GenericallyRigid K (Fin (sideSum shape114 + 1)) (chainGraph shape114) :=
  genericallyRigid_fin _ _ (by decide) full114_rigid

/-- The exact full `(1,2,2)` core in the conventional coordinate space. -/
theorem base122_rigid [Infinite K] :
    GenericallyRigid K (Fin (sideSum shape122 + 1)) (chainGraph shape122) :=
  genericallyRigid_fin _ _ (by decide) full122_rigid

/-- Every positive nonexceptional three-factor box is rigid in the exact
first Lefschetz dimension. No chain length is bounded. -/
theorem positive_three_nonexceptional [Infinite K]
    (n : Fin 3 → ℕ) (hpos : ∀ i, 1 ≤ n i) (hex : ¬ ExceptionalTriple n) :
    GenericallyRigid K (Fin (sideSum n + 1)) (chainGraph n) := by
  obtain ⟨e,hs01,hs12⟩ := sort_three n
  let m : Fin 3 → ℕ := fun i => n (e i)
  have hmpos : ∀ i, 1 ≤ m i := fun i => hpos (e i)
  have hsorted01 : m 0 ≤ m 1 := hs01
  have hsorted12 : m 1 ≤ m 2 := hs12
  have hm : GenericallyRigid K (Fin (sideSum m + 1)) (chainGraph m) := by
    by_cases hmid : 2 ≤ m 1
    · have hdom : shape122 ≤ m := by
        intro i
        fin_cases i
        · exact hmpos 0
        · exact hmid
        · exact hmid.trans hsorted12
      exact propagate_positive shape122 m (by decide) (by decide) hdom base122_rigid
    · have h0 : m 0 = 1 := by have h := hmpos 0; omega
      have h1 : m 1 = 1 := by have h := hmpos 1; omega
      have h2 : 4 ≤ m 2 := by
        by_contra h
        have h2pos := hmpos 2
        have hcases : m 2 = 1 ∨ m 2 = 2 ∨ m 2 = 3 := by omega
        apply hex
        refine ⟨e, ?_⟩
        rcases hcases with h2 | h2 | h2
        · left
          change m = shape111
          funext i
          fin_cases i
          · exact h0
          · exact h1
          · exact h2
        · right; left
          change m = shape112
          funext i
          fin_cases i
          · exact h0
          · exact h1
          · exact h2
        · right; right
          change m = shape113
          funext i
          fin_cases i
          · exact h0
          · exact h1
          · exact h2
      have hdom : shape114 ≤ m := by
        intro i
        fin_cases i
        · exact hmpos 0
        · exact hmpos 1
        · exact h2
      exact propagate_positive shape114 m (by decide) (by decide) hdom base114_rigid
  have hr := orderIso_rigid (reindexCell n e) hm
  change GenericallyRigid K (Fin (sideSum m + 1)) (chainGraph n) at hr
  apply genericallyRigid_fin (chainGraph n) (sideSum n + 1) ?_ hr
  rw [Fintype.card_fin]
  change sideSum (fun i => n (e i)) + 1 = sideSum n + 1
  exact congrArg (fun r : ℕ => r + 1) (sideSum_reindex n e)

/-- The nonexceptional rigidity conclusion for every positive number of
factors at least three, with the only exception test located at `k = 3`. -/
theorem positive_nonexceptional [Infinite K] (k : ℕ) (hk : 3 ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i)
    (hex : ∀ h : k = 3, ¬ ExceptionalTriple (fun i => n (Fin.cast h.symm i))) :
    GenericallyRigid K (Fin (sideSum n + 1)) (chainGraph n) := by
  by_cases h : k = 3
  · subst k
    exact positive_three_nonexceptional n hpos (by simpa using hex rfl)
  · exact positive_four_or_more k (by omega) n hpos

open StressFree

/-- The literal exceptional cubes in the conventional coordinate dimensions. -/
theorem base111_stressFree [Infinite K] :
    GenericallyStressFree K (Fin (sideSum shape111 + 1)) (chainGraph shape111) :=
  genericallyStressFree_fin _ _ (by decide) full111_stressFree

theorem base112_stressFree [Infinite K] :
    GenericallyStressFree K (Fin (sideSum shape112 + 1)) (chainGraph shape112) :=
  genericallyStressFree_fin _ _ (by decide) full112_stressFree

theorem base113_stressFree [Infinite K] :
    GenericallyStressFree K (Fin (sideSum shape113 + 1)) (chainGraph shape113) :=
  genericallyStressFree_fin _ _ (by decide) full113_stressFree

/-- Every permutation of each exceptional triple is genuinely stress-free in
its stated dimension; the assertion uses the actual graph's edge rows. -/
theorem exceptional_stressFree [Infinite K] (n : Fin 3 → ℕ)
    (hex : ExceptionalTriple n) :
    GenericallyStressFree K (Fin (sideSum n + 1)) (chainGraph n) := by
  classical
  obtain ⟨e,he⟩ := hex
  have hm : GenericallyStressFree K
      (Fin (sideSum (fun i => n (e i)) + 1))
      (chainGraph (fun i => n (e i))) := by
    rcases he with he | he | he
    · rw [he]
      exact base111_stressFree
    · rw [he]
      exact base112_stressFree
    · rw [he]
      exact base113_stressFree
  have hg : (chainGraph n).comap (reindexCell n e).toEquiv =
      chainGraph (fun i => n (e i)) := orderIso_graph (reindexCell n e)
  have hcomp : GenericallyStressFree K
      (Fin (sideSum (fun i => n (e i)) + 1))
      ((chainGraph n).comap (reindexCell n e).toEquiv) := by
    simpa only [hg] using hm
  have hr := stressFree_of_comap_equiv (chainGraph n) (reindexCell n e).toEquiv hcomp
  apply genericallyStressFree_fin (chainGraph n) (sideSum n + 1) ?_ hr
  rw [Fintype.card_fin]
  change sideSum (fun i => n (e i)) + 1 = sideSum n + 1
  exact congrArg (fun r : ℕ => r + 1) (sideSum_reindex n e)

end PaperVerification.Segre.ChainClassification
end
end ProbeLayer69

section ProbeLayer70



/-!
# Product-of-chains rigidity and the actual Segre multiplication rank

The zero-fiber multiplication matrix has exactly the square and comparable-edge
equations of the graph kernel. An explicit kernel equivalence yields its rank
as the number of vertices plus the rigidity rank. Rigidity gives the Koszul
bound; stress-freeness gives full row rank. Polynomial degeneration then attains
those same bounds for actual Segre multiplication.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.RigidityMultiplication

open Staircase Monomials Degeneration GraphKernel RigidityRank KoszulDimension
open GenericRigidity StressFree Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

def splitCoefficients : Matrix (Cell n) (Option D) K ≃ₗ[K]
    Coefficients K (Cell n) D where
  toFun U := (fun v => U v none, fun v d => U v (some d))
  invFun z v o := o.elim (z.1 v) (z.2 v)
  left_inv U := by ext v o; cases o <;> rfl
  right_inv z := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

noncomputable def zeroMap (p : Matrix (Cell n) D K) :
    Matrix (Cell n) (Option D) K →ₗ[K] (SortedPair n → K) :=
  (multiplicationMatrix 0 (augmentedPlacement p)).mulVecLin.comp KoszulRank.flatten.toLinearMap

theorem zeroMap_square (p : Matrix (Cell n) D K)
    (U : Matrix (Cell n) (Option D) K) (u : Cell n) :
    zeroMap p U ⟨(u,u),le_rfl⟩ =
      (coefficientMap (fun v d => p v d) (endpoints (RankParameters.chainGraph n))
        (splitCoefficients U)).1 u := by
  classical
  change (∑ ov : Option D × Cell n,
    multiplicationMatrix 0 (augmentedPlacement p) ⟨(u,u),le_rfl⟩ ov * U ov.2 ov.1) =
      U u none + p u ⬝ᵥ (fun d => U u (some d))
  rw [Fintype.sum_prod_type]
  simp only [fiber_zero_square, ite_mul, zero_mul, Finset.sum_ite_eq, Finset.sum_ite_eq',
    Finset.mem_univ, if_true, Fintype.sum_option, augmentedPlacement,
    augmentedPosition, one_mul, coefficientMap, splitCoefficients,
    LinearEquiv.coe_mk, LinearMap.coe_mk, AddHom.coe_mk, dotProduct]

theorem zeroMap_edge (p : Matrix (Cell n) D K)
    (U : Matrix (Cell n) (Option D) K) (q : SortedPair n) (hne : q.val.1 ≠ q.val.2) :
    zeroMap p U q =
      U q.val.1 none + U q.val.2 none +
        p q.val.1 ⬝ᵥ (fun d => U q.val.2 (some d)) +
        p q.val.2 ⬝ᵥ (fun d => U q.val.1 (some d)) := by
  classical
  change (∑ ov : Option D × Cell n,
    multiplicationMatrix 0 (augmentedPlacement p) q ov * U ov.2 ov.1) = _
  rw [Fintype.sum_prod_type]
  simp only [fiber_zero_edge _ _ q hne, add_mul, ite_mul, zero_mul,
    Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true,
    Fintype.sum_option, augmentedPlacement, augmentedPosition, one_mul, dotProduct]
  ring

/-- No equation is lost: diagonal pairs are the square equations and each
strict comparable pair is the corresponding graph edge equation. -/
theorem zeroMap_eq_zero_iff (p : Matrix (Cell n) D K)
    (U : Matrix (Cell n) (Option D) K) : zeroMap p U = 0 ↔
      coefficientMap (fun v d => p v d) (endpoints (RankParameters.chainGraph n))
        (splitCoefficients U) = 0 := by
  constructor
  · intro h
    apply Prod.ext
    · funext u
      exact (zeroMap_square p U u).symm.trans (congrFun h _)
    · funext e
      rcases e with ⟨⟨u,v⟩,hne,hcomp⟩
      rcases hcomp with huv | hvu
      · have he := congrFun h (⟨(u,v),huv⟩ : SortedPair n)
        rw [zeroMap_edge p U _ hne] at he
        exact he
      · have he := congrFun h (⟨(v,u),hvu⟩ : SortedPair n)
        rw [zeroMap_edge p U _ hne.symm] at he
        simp only [Pi.zero_apply] at he
        change U u none + U v none +
          p u ⬝ᵥ (fun d => U v (some d)) + p v ⬝ᵥ (fun d => U u (some d)) = 0
        linear_combination he
  · intro h
    funext q
    rcases q with ⟨⟨u,v⟩,huv⟩
    by_cases he : u = v
    · subst v
      rw [zeroMap_square]
      exact congrArg (fun z : QuadraticCoordinates K (Cell n)
        (Edges (RankParameters.chainGraph n)) => z.1 u) h
    · rw [zeroMap_edge p U _ he]
      exact congrArg (fun z : QuadraticCoordinates K (Cell n)
        (Edges (RankParameters.chainGraph n)) => z.2 ⟨(u,v),he,Or.inl huv⟩) h

noncomputable def zeroKernelEquiv (p : Matrix (Cell n) D K) :
    LinearMap.ker (zeroMap p) ≃ₗ[K]
      LinearMap.ker (coefficientMap (fun v d => p v d)
        (endpoints (RankParameters.chainGraph n))) where
  toFun U := ⟨splitCoefficients U.val, (zeroMap_eq_zero_iff p U.val).mp U.property⟩
  invFun z := ⟨splitCoefficients.symm z.val, (zeroMap_eq_zero_iff p _).mpr (by
    rw [LinearEquiv.apply_symm_apply]; exact z.property)⟩
  left_inv U := Subtype.ext (splitCoefficients.symm_apply_apply U.val)
  right_inv z := Subtype.ext (splitCoefficients.apply_symm_apply z.val)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem zeroMap_matrix_rank (p : Matrix (Cell n) D K) :
    (multiplicationMatrix 0 (augmentedPlacement p)).rank =
      Module.finrank K (LinearMap.range (zeroMap p)) := by
  rw [zeroMap, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top]
  rfl

/-- Exact rank relation for every placement, before any generic or rigidity
hypothesis. This is the full degree-two graph-multiplication rank bridge. -/
theorem rank_zero_eq_vertex_add_rigidity (p : Matrix (Cell n) D K) :
    (multiplicationMatrix 0 (augmentedPlacement p)).rank =
      Fintype.card (Cell n) +
        (rigidityMatrix p (endpoints (RankParameters.chainGraph n))).rank := by
  have hzero := (zeroMap p).finrank_range_add_finrank_ker
  have hrig := (rigidityMap (fun v d => p v d)
    (endpoints (RankParameters.chainGraph n))).finrank_range_add_finrank_ker
  have hk := ((zeroKernelEquiv p).trans
    (kernelEquiv (fun v d => p v d) (endpoints (RankParameters.chainGraph n)))).finrank_eq
  rw [hk] at hzero
  have hd₀ : Module.finrank K (Matrix (Cell n) (Option D) K) =
      Fintype.card (Cell n) * (Fintype.card D + 1) := by simp [Module.finrank_matrix]
  have hdr : Module.finrank K (Cell n → D → K) =
      Fintype.card (Cell n) * Fintype.card D := by
    simp [Module.finrank_pi_fintype, Module.finrank_pi]
  rw [hd₀] at hzero
  rw [hdr] at hrig
  rw [zeroMap_matrix_rank, rigidityMatrix_rank]
  nlinarith

/-- A rigid placement gives the exact maximal Koszul rank at the zero fiber. -/
theorem rank_zero_of_rigid (p : Matrix (Cell n) D K)
    (hp : affineSpan K (Set.range p) = ⊤)
    (hr : InfinitesimallyRigidOn (RankParameters.chainGraph n) p Set.univ) :
    (multiplicationMatrix 0 (augmentedPlacement p)).rank =
      Fintype.card (Cell n) * (Fintype.card D + 1) - (Fintype.card D + 1).choose 2 := by
  have hs := (rigid_iff_boundary_surjective (RankParameters.chainGraph n) p).mp hr
  have hi := boundaryToKernel_injective p (endpoints (RankParameters.chainGraph n))
    (augmented_surjective_of_affineSpan p hp)
  let e := LinearEquiv.ofBijective (boundaryToKernel p
    (endpoints (RankParameters.chainGraph n))) ⟨hi,hs⟩
  have hk : Module.finrank K (LinearMap.ker (zeroMap p)) =
      (Fintype.card D + 1).choose 2 := by
    rw [(zeroKernelEquiv p).finrank_eq, ← e.finrank_eq,
      finrank_alternatingMatrices, Fintype.card_option]
  have hn := (zeroMap p).finrank_range_add_finrank_ker
  have hd : Module.finrank K (Matrix (Cell n) (Option D) K) =
      Fintype.card (Cell n) * (Fintype.card D + 1) := by simp [Module.finrank_matrix]
  rw [hk,hd] at hn
  rw [zeroMap_matrix_rank]
  omega

/-- The generic graph conclusion transfers to actual Segre multiplication
for a full unrestricted family of linear forms. -/
theorem exists_actual_rank_of_rigid [Infinite K]
    (h : GenericallyRigid K D (RankParameters.chainGraph n)) :
    ∃ A : Matrix (Cell n) (Option D) K,
      Fintype.card (Cell n) * (Fintype.card D + 1) - (Fintype.card D + 1).choose 2 ≤
        (multiplicationMatrix 1 A).rank := by
  obtain ⟨p,hp,hr⟩ := h
  exact rank_transfer_from_zero (augmentedPlacement p) _
    ((rank_zero_of_rigid p hp hr).ge)

/-- All positive nonexceptional boxes with at least three factors attain the
full first-Lefschetz Koszul bound in actual Segre degree-two multiplication. -/
theorem exists_actual_rank_nonexceptional [Infinite K] (k : ℕ) (hk : 3 ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i)
    (hex : ∀ h : k = 3, ¬ ChainClassification.ExceptionalTriple
      (fun i => n (Fin.cast h.symm i))) :
    ∃ A : Matrix (Cell n) (Option (RankParameters.Ranks n)) K,
      Fintype.card (Cell n) * (sideSum n + 2) -
        (sideSum n + 2).choose 2 ≤ (multiplicationMatrix 1 A).rank := by
  have h := exists_actual_rank_of_rigid
    (ChainClassification.positive_nonexceptional (K := K) k hk n hpos hex)
  simpa only [Fintype.card_fin, Nat.add_assoc] using h

end PaperVerification.Segre.RigidityMultiplication
end
end ProbeLayer70

section ProbeLayer71



/-!
# Generic injectivity in the actual Artinian Segre quotient

A single explicit nonzero polynomial imposes full column rank, the maximal
Koszul multiplication rank, and Artinianness of the old parameter family.
Its nonvanishing proves injectivity of multiplication in the literal quotient.
The graph classification supplies the rank witness for every positive
nonexceptional product with at least three factors.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericFirstLefschetz

open Staircase Monomials RankParameters Degeneration ParameterProducts ActualLefschetz
open LefschetzBridge GeneralParameters GeneralQuotient GenericRigidity Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

/-- Separate the old parameters from the additional Lefschetz form. -/
def oldForms (A : Matrix (Cell n) (Option D) K) : Matrix (Cell n) D K :=
  fun u d => A u (some d)

noncomputable def lefschetzForm (A : Matrix (Cell n) (Option D) K) :
    degreeOne (K := K) (n := n) := forms A none

@[simp]
theorem enlarged_forms (A : Matrix (Cell n) (Option D) K) :
    forms A = fun o : Option D => o.elim (lefschetzForm A) (forms (oldForms A)) := by
  funext o
  cases o <;> rfl

theorem oldForms_surjective (A : Matrix (Cell n) (Option D) K)
    (hA : Function.Surjective A.vecMul) : Function.Surjective (oldForms A).vecMul := by
  intro y
  obtain ⟨c,hc⟩ := hA (fun o : Option D => o.elim 0 y)
  refine ⟨c, ?_⟩
  funext d
  exact congrFun hc (some d)

/-- An attained full Koszul rank proves actual first Lefschetz injectivity.
The old family's exactness is not assumed: the enlarged family accounts for
all relations and its boundary projection lies in the old parameter span. -/
theorem firstLefschetz_injective_of_rank (A : Matrix (Cell n) (Option D) K)
    (hA : Function.Surjective A.vecMul)
    (hr : Fintype.card (Cell n) * Fintype.card (Option D) -
      (Fintype.card (Option D)).choose 2 ≤ (Degeneration.multiplicationMatrix 1 A).rank) :
    Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) := by
  have hexact := actual_exactness_of_matrix_exactness A
    (KoszulRank.kernel_eq_koszul_range_of_rank_bound A hA hr)
  rw [enlarged_forms] at hexact
  apply (GeneralQuotient.firstLefschetz_injective_iff (oldForms A) (lefschetzForm A)).mpr
  intro f hf
  rw [← range_actual_multiply] at hf
  obtain ⟨g,hg⟩ := hf
  let z : Option D → degreeOne (K := K) (n := n) :=
    fun o => o.elim f (fun d => -g d)
  have hz : z ∈ LinearMap.ker (multiply polynomialProduct
      (fun o : Option D => o.elim (lefschetzForm A) (forms (oldForms A)))) := by
    change multiply polynomialProduct _ z = 0
    rw [multiply_splitOption]
    change (lefschetzForm A).val * f.val +
      multiply polynomialProduct (forms (oldForms A)) (-g) = 0
    rw [map_neg,hg,add_neg_cancel]
  rw [hexact] at hz
  have hsplit : splitOption (K := K) z ∈
      widePairRelations (K := K) (forms (oldForms A)) (lefschetzForm A) := by
    rw [← widePairRelations_eq_pairRelations]
    exact Submodule.mem_map.mpr ⟨z,hz,rfl⟩
  exact boundary_first_mem_parameterSpan (forms (oldForms A)) (lefschetzForm A) hsplit

noncomputable def universalCoefficients :
    Matrix (Cell n) D (MvPolynomial (Cell n × D) K) := fun u d => MvPolynomial.X (u,d)

noncomputable def universalMultiplication :
    Matrix (SortedPair n) (D × Cell n) (MvPolynomial (Cell n × D) K) :=
  Degeneration.multiplicationMatrix 1 universalCoefficients

theorem eval_universalCoefficients (A : Matrix (Cell n) D K) :
    (universalCoefficients (K := K) (n := n) (D := D)).map
      (MvPolynomial.eval (fun j => A j.1 j.2)) = A := by
  ext u d
  simp only [Matrix.map_apply,universalCoefficients,MvPolynomial.eval_X]

theorem eval_universalMultiplication (A : Matrix (Cell n) D K) :
    (universalMultiplication (K := K) (n := n) (D := D)).map
      (MvPolynomial.eval (fun j => A j.1 j.2)) = Degeneration.multiplicationMatrix 1 A := by
  ext q dv
  simp only [Matrix.map_apply,universalMultiplication,Degeneration.multiplicationMatrix,
    universalCoefficients,map_sum]
  apply Finset.sum_congr rfl
  intro u _
  split_ifs <;> simp

/-- Embedding the old-parameter coordinates leaves the new form unconstrained. -/
def oldVariable : Cell n × D ↪ Cell n × Option D where
  toFun j := (j.1,some j.2)
  inj' := by intro a b h; cases a; cases b; simpa using h

/-- The exact principal-open certificate needed by the theorem: the quotient
is finite and Artinian, the old forms are independent, and the actual first
Lefschetz map is injective at every point where this polynomial is nonzero. -/
theorem injective_certificate_of_rank_witnesses
    (hcol : ∃ A : Matrix (Cell n) (Option (Ranks n)) K, Function.Surjective A.vecMul)
    (hmul : ∃ A : Matrix (Cell n) (Option (Ranks n)) K,
      Fintype.card (Cell n) * Fintype.card (Option (Ranks n)) -
        (Fintype.card (Option (Ranks n))).choose 2 ≤
          (Degeneration.multiplicationMatrix 1 A).rank) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) := by
  classical
  obtain ⟨A₀,hA₀⟩ := hcol
  obtain ⟨A₁,hA₁⟩ := hmul
  have hc : Fintype.card (Option (Ranks n)) ≤
      ((universalCoefficients (K := K) (n := n) (D := Option (Ranks n))).map
        (MvPolynomial.eval (fun j => A₀ j.1 j.2))).rank := by
    rw [eval_universalCoefficients]
    exact (Matrix.vecMul_surjective_iff_rank_eq_card.mp hA₀).ge
  obtain ⟨fc,hfc,hwc⟩ := GenericRank.minor_witness
    (universalCoefficients (K := K) (n := n) (D := Option (Ranks n)))
    (fun j => A₀ j.1 j.2) (Fintype.card (Option (Ranks n))) hc
  have hm : Fintype.card (Cell n) * Fintype.card (Option (Ranks n)) -
      (Fintype.card (Option (Ranks n))).choose 2 ≤
      ((universalMultiplication (K := K) (n := n) (D := Option (Ranks n))).map
        (MvPolynomial.eval (fun j => A₁ j.1 j.2))).rank := by
    rw [eval_universalMultiplication]
    exact hA₁
  obtain ⟨fm,hfm,hwm⟩ := GenericRank.minor_witness
    (universalMultiplication (K := K) (n := n) (D := Option (Ranks n)))
    (fun j => A₁ j.1 j.2) _ hm
  obtain ⟨fa,hfa,hwa⟩ := ArtinianOpen.artinian_certificate (K := K) (n := n)
  let fr : MvPolynomial (Cell n × Option (Ranks n)) K :=
    MvPolynomial.rename (oldVariable (n := n) (D := Ranks n)) fa
  have hfr : fr ≠ 0 := by
    exact fun h => hfa ((MvPolynomial.rename_eq_zero_iff_of_injective fa
      (oldVariable (n := n) (D := Ranks n)).injective).mp h)
  refine ⟨fc * fm * fr,mul_ne_zero (mul_ne_zero hfc hfm) hfr, ?_⟩
  intro A hA
  rw [map_mul,map_mul] at hA
  obtain ⟨hcfm,hfrA⟩ := mul_ne_zero_iff.mp hA
  obtain ⟨hfcA,hfmA⟩ := mul_ne_zero_iff.mp hcfm
  have hcrank := hwc (fun j => A j.1 j.2) hfcA
  rw [eval_universalCoefficients] at hcrank
  have hsurj : Function.Surjective A.vecMul := Matrix.vecMul_surjective_iff_rank_eq_card.mpr
    (le_antisymm (Matrix.rank_le_card_width A) hcrank)
  have hmrank := hwm (fun j => A j.1 j.2) hfmA
  rw [eval_universalMultiplication] at hmrank
  have hart := hwa (oldForms A) (by
    simpa only [fr,MvPolynomial.eval_rename,Function.comp_def,oldVariable,
      Function.Embedding.coeFn_mk,oldForms]
      using hfrA)
  exact ⟨hart.1,hart.2,oldForms_surjective A hsurj,
    firstLefschetz_injective_of_rank A hsurj hmrank⟩

/-- A proved product-of-chains rigidity theorem gives a genuine nonempty-open
actual Artinian first-Lefschetz assertion. -/
theorem injective_certificate_of_rigid [Infinite K]
    (hG : GenericallyRigid K (Ranks n) (chainGraph n)) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) := by
  apply injective_certificate_of_rank_witnesses
  · obtain ⟨p,hp,_⟩ := hG
    exact ⟨augmentedPlacement p,augmented_surjective_of_affineSpan p hp⟩
  · obtain ⟨A,hA⟩ := RigidityMultiplication.exists_actual_rank_of_rigid hG
    exact ⟨A,by simpa only [Fintype.card_option] using hA⟩

/-- The unrestricted nonexceptional k≥3 branch of Theorem 1.1, expressed by a
nonzero polynomial open certificate on the actual parameter and form space.
The actual quotient and multiplication retain their original ring meanings. -/
theorem positive_nonexceptional_injective_certificate [Infinite K]
    (k : ℕ) (hk : 3 ≤ k) (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i)
    (hex : ∀ h : k = 3, ¬ ChainClassification.ExceptionalTriple
      (fun i => n (Fin.cast h.symm i))) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) :=
  injective_certificate_of_rigid
    (ChainClassification.positive_nonexceptional (K := K) k hk n hpos hex)

end PaperVerification.Segre.GenericFirstLefschetz
end
end ProbeLayer71

section ProbeLayer72



/-!
# Genericity descends from coefficient lifts to the actual quotient space

A property constant on the fibers of a surjective linear map is generic on
the target whenever a nonzero polynomial certifies it on the source. An affine
linear section through a known good source point supplies a nonzero polynomial
in a basis of the actual target. This justifies the paper's quantifier "general
ℓ in A1", rather than only a quantifier on redundant polynomial lifts.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.QuotientGenericity

open Module

variable {K U Q : Type*} [Field K] [AddCommGroup Q] [Module K Q] [Module.Finite K Q]

noncomputable def basisPoint (a : Fin (finrank K Q) → K) : Q :=
  ∑ i, a i • finBasis K Q i

theorem basisPoint_repr (q : Q) : basisPoint (fun i => (finBasis K Q).repr q i)=q :=
  (finBasis K Q).sum_repr q

noncomputable def affinePullback (s : Q →ₗ[K] (U → K)) (c : U → K)
    (f : MvPolynomial U K) : MvPolynomial (Fin (finrank K Q)) K :=
  MvPolynomial.eval₂Hom MvPolynomial.C (fun u => MvPolynomial.C (c u) +
    ∑ i, MvPolynomial.X i * MvPolynomial.C (s (finBasis K Q i) u)) f

theorem eval_affinePullback (s : Q →ₗ[K] (U → K)) (c : U → K)
    (f : MvPolynomial U K) (a : Fin (finrank K Q) → K) :
    MvPolynomial.eval a (affinePullback s c f) =
      MvPolynomial.eval (c+s (basisPoint a)) f := by
  have he : (MvPolynomial.eval a).comp
      (MvPolynomial.eval₂Hom MvPolynomial.C (fun u => MvPolynomial.C (c u) +
        ∑ i, MvPolynomial.X i * MvPolynomial.C (s (finBasis K Q i) u))) =
      MvPolynomial.eval (c+s (basisPoint a)) := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply,MvPolynomial.eval₂Hom_C,MvPolynomial.eval_C]
    · intro u
      simp only [RingHom.comp_apply,MvPolynomial.eval₂Hom_X',map_add,map_sum,map_mul,
        MvPolynomial.eval_C,MvPolynomial.eval_X,Pi.add_apply,basisPoint,map_smul,
        Finset.sum_apply,Pi.smul_apply,smul_eq_mul]
  exact congrArg (fun φ : MvPolynomial U K →+* K => φ f) he

/-- A certificate on arbitrary lifts induces a nonzero-polynomial certificate
on every coordinate of the actual quotient vector space. -/
theorem certificate_descends [Infinite K] (π : (U → K) →ₗ[K] Q)
    (hπ : Function.Surjective π) (P : Q → Prop)
    (f : MvPolynomial U K) (hf : f ≠ 0)
    (hP : ∀ c : U → K, MvPolynomial.eval c f ≠ 0 → P (π c)) :
    ∃ g : MvPolynomial (Fin (finrank K Q)) K, g ≠ 0 ∧
      ∀ a : Fin (finrank K Q) → K, MvPolynomial.eval a g ≠ 0 → P (basisPoint a) := by
  classical
  obtain ⟨s,hs⟩ := π.exists_rightInverse_of_surjective (LinearMap.range_eq_top.mpr hπ)
  have hsection (q : Q) : π (s q)=q := LinearMap.congr_fun hs q
  obtain ⟨c₀,hc₀⟩ := GenericMatrixRank.exists_eval_ne_zero f hf
  let k : U → K := c₀-s (π c₀)
  have hk : π k=0 := by dsimp [k]; rw [map_sub,hsection,sub_self]
  let g := affinePullback s k f
  have hgval : MvPolynomial.eval (fun i => (finBasis K Q).repr (π c₀) i) g =
      MvPolynomial.eval c₀ f := by
    rw [eval_affinePullback,basisPoint_repr]
    dsimp only [k]
    rw [sub_add_cancel]
  have hg : g ≠ 0 := by
    intro hz
    rw [hz,map_zero] at hgval
    exact hc₀ hgval.symm
  refine ⟨g,hg,?_⟩
  intro a ha
  have he : MvPolynomial.eval (k+s (basisPoint a)) f ≠ 0 := by
    simpa only [g,eval_affinePullback] using ha
  have hp := hP (k+s (basisPoint a)) he
  rw [map_add,hk,zero_add,hsection] at hp
  exact hp

end PaperVerification.Segre.QuotientGenericity
end
end ProbeLayer72

section ProbeLayer73



/-!
# The literal iterated generic quantifiers

Joint coefficient certificates imply general old parameter choices followed
by general forms in the actual quotient A1. The latter forms are parameterized
by a basis of A1 itself. This file also defines first Lefschetz multiplication
directly from an element of A1 and proves agreement with polynomial lifts.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ActualGenericity

open Staircase Monomials ActualLefschetz GeneralParameters GeneralQuotient
open GenericFirstLefschetz RankParameters

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

/-- Actual multiplication by an actual degree-one quotient element. -/
noncomputable def firstLefschetz (A : Matrix (Cell n) D K) (ℓ : actualDegreeOne A) :
    actualDegreeOne A →ₗ[K] actualDegreeTwo A where
  toFun x := ⟨ℓ.val*x.val,by
    obtain ⟨f,hf⟩ := ℓ.property
    obtain ⟨g,hg⟩ := x.property
    refine ⟨ActualQuotient.degreeOneProduct f g,?_⟩
    rw [twoToReduction_product,hf,hg]⟩
  map_add' x y := Subtype.ext (mul_add _ _ _)
  map_smul' c x := Subtype.ext (mul_smul_comm _ _ _)

@[simp] theorem firstLefschetz_lift (A : Matrix (Cell n) D K)
    (f : degreeOne (K := K) (n := n)) :
    firstLefschetz A (homogeneousResidue A f)=GeneralQuotient.firstLefschetz A f := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  rfl

noncomputable def coefficientToOne (A : Matrix (Cell n) D K) :
    (Cell n → K) →ₗ[K] actualDegreeOne A :=
  (oneToReduction A).rangeRestrict.comp coordinates.toLinearMap

@[simp] theorem coefficientToOne_apply (A : Matrix (Cell n) D K) (c : Cell n → K) :
    coefficientToOne A c=homogeneousResidue A (coordinates c) := rfl

theorem coefficientToOne_surjective (A : Matrix (Cell n) D K) :
    Function.Surjective (coefficientToOne A) := by
  intro x
  obtain ⟨f,hf⟩ := x.property
  refine ⟨coordinates.symm f,?_⟩
  apply Subtype.ext
  change oneToReduction A (coordinates (coordinates.symm f))=x.val
  rw [LinearEquiv.apply_symm_apply]
  exact hf

def joinMatrix (A : Matrix (Cell n) D K) (c : Cell n → K) :
    Matrix (Cell n) (Option D) K := fun u o => o.elim (c u) (A u)

/-- A nonempty principal open in a basis of the actual quotient vector space.
The basis is part of the certificate, so no finite-dimensionality instance is
assumed implicitly in the statement. -/
def GenericActualForms (A : Matrix (Cell n) D K) (P : actualDegreeOne A → Prop) : Prop :=
  ∃ b : Module.Basis (Fin (Module.finrank K (actualDegreeOne A))) K (actualDegreeOne A),
    ∃ h : MvPolynomial (Fin (Module.finrank K (actualDegreeOne A))) K, h ≠ 0 ∧
      ∀ c : Fin (Module.finrank K (actualDegreeOne A)) → K,
        MvPolynomial.eval c h ≠ 0 → P (∑ i, c i • b i)

/-- General old parameters followed by general actual quotient forms. The
proof explicitly descends through the full surjective coefficient map. -/
theorem iterated_certificate [Infinite K]
    (P : ∀ A : Matrix (Cell n) D K, actualDegreeOne A → Prop)
    (h : ∃ f : MvPolynomial (Cell n × Option D) K, f ≠ 0 ∧
      ∀ B : Matrix (Cell n) (Option D) K,
        MvPolynomial.eval (fun j => B j.1 j.2) f ≠ 0 →
          Module.Finite K (Reduction (oldForms B)) ∧ IsArtinianRing (Reduction (oldForms B)) ∧
          P (oldForms B) (homogeneousResidue (oldForms B) (lefschetzForm B))) :
    ∃ g : MvPolynomial (Cell n × D) K, g ≠ 0 ∧
      ∀ A : Matrix (Cell n) D K,
        MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 →
          Module.Finite K (Reduction A) ∧ IsArtinianRing (Reduction A) ∧
          GenericActualForms A (P A) := by
  classical
  obtain ⟨f,hf,hw⟩ := h
  obtain ⟨g,hg,hfib⟩ := GenericRank.joint_certificate_has_generic_fibers f hf
  refine ⟨g,hg,?_⟩
  intro A hA
  obtain ⟨hform,hhform,hform_spec⟩ := hfib A hA
  obtain ⟨c₀,hc₀⟩ := GenericMatrixRank.exists_eval_ne_zero hform hhform
  have hpoint := hw (joinMatrix A c₀) (hform_spec c₀ hc₀)
  change Module.Finite K (Reduction A) ∧ IsArtinianRing (Reduction A) ∧
    P A (coefficientToOne A c₀) at hpoint
  letI := hpoint.1
  have hP : ∀ c : Cell n → K, MvPolynomial.eval c hform ≠ 0 → P A (coefficientToOne A c) := by
    intro c hc
    exact (hw (joinMatrix A c) (hform_spec c hc)).2.2
  obtain ⟨q,hq,hqspec⟩ := QuotientGenericity.certificate_descends
    (coefficientToOne A) (coefficientToOne_surjective A) (P A) hform hhform hP
  exact ⟨hpoint.1,hpoint.2.1,Module.finBasis K (actualDegreeOne A),q,hq,hqspec⟩

/-- Over an infinite field the certified polynomial open contains an actual
quotient form, including when the first homogeneous piece is zero. -/
theorem GenericActualForms.exists [Infinite K]
    {A : Matrix (Cell n) D K} {P : actualDegreeOne A → Prop}
    (hP : GenericActualForms A P) : ∃ ℓ, P ℓ := by
  classical
  obtain ⟨b,h,hh,hw⟩ := hP
  obtain ⟨c,hc⟩ := GenericMatrixRank.exists_eval_ne_zero h hh
  exact ⟨∑ i,c i • b i,hw c hc⟩

end PaperVerification.Segre.ActualGenericity
end
end ProbeLayer73

section ProbeLayer74



/-!
# The first Lefschetz map in the actual tensor-symmetric-power quotient

The full quotient isomorphism preserves the entire first and second
homogeneous pieces and intertwines their multiplication maps. Injectivity,
surjectivity and the exact kernel dimension are therefore preserved. These
are the mathematical equivalences required to read the polynomial-realization
principal theorem as the statement for the ring displayed in the paper.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000

@[expose] public section

namespace PaperVerification.Segre.SymmetricRealization

open Staircase Monomials
open scoped TensorProduct DirectSum

variable {I D : Type*} [Fintype I] [DecidableEq I] [Nonempty I]
  [Fintype D] [DecidableEq D] {n : I → ℕ}
variable {F : Type} [Field F]

/-- The whole-quotient residue map respects componentwise symmetric-power multiplication. -/
theorem symmetricPieceToReduction_product (A : Matrix (Cell n) D F) (p q : ℕ)
    (x : SymmetricTensor (F := F) (n := n) p)
    (y : SymmetricTensor (F := F) (n := n) q) :
    symmetricPieceToReduction A (p+q) (tensorMul p q x y)=
      symmetricPieceToReduction A p x * symmetricPieceToReduction A q y := by
  change Ideal.Quotient.mk _ (DirectSum.of _ (p+q) (tensorMul p q x y)) =
    Ideal.Quotient.mk _ (DirectSum.of _ p x) * Ideal.Quotient.mk _ (DirectSum.of _ q y)
  rw [← map_mul,DirectSum.of_mul_of]
  rfl

/-- Actual multiplication by an actual degree-one element of the paper's quotient. -/
noncomputable def symmetricFirstLefschetz (A : Matrix (Cell n) D F)
    (ℓ : symmetricActualPiece A 1) :
    symmetricActualPiece A 1 →ₗ[F] symmetricActualPiece A 2 where
  toFun x := ⟨ℓ.val*x.val,by
    obtain ⟨f,hf⟩ := ℓ.property
    obtain ⟨g,hg⟩ := x.property
    refine ⟨tensorMul 1 1 f g,?_⟩
    rw [symmetricPieceToReduction_product A 1 1 f g,hf,hg]⟩
  map_add' x y := Subtype.ext (mul_add _ _ _)
  map_smul' c x := Subtype.ext (mul_smul_comm _ _ _)

@[simp] theorem symmetricFirstLefschetz_val (A : Matrix (Cell n) D F)
    (ℓ x : symmetricActualPiece A 1) :
    (symmetricFirstLefschetz A ℓ x).val = ℓ.val * x.val := rfl

@[simp] theorem symmetricActualOneEquiv_val (A : Matrix (Cell n) D F)
    (x : symmetricActualPiece A 1) :
    (symmetricActualOneEquiv A x).val = symmetricReductionEquiv A x.val := rfl

@[simp] theorem symmetricActualTwoEquiv_val (A : Matrix (Cell n) D F)
    (x : symmetricActualPiece A 2) :
    (symmetricActualTwoEquiv A x).val = symmetricReductionEquiv A x.val := rfl

/-- The first Lefschetz square commutes for every parameter matrix and every
actual form; this is not merely a generic comparison of matrix ranks. -/
theorem firstLefschetz_intertwining (A : Matrix (Cell n) D F)
    (ℓ x : symmetricActualPiece A 1) :
    symmetricActualTwoEquiv A (symmetricFirstLefschetz A ℓ x)=
      ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ)
        (symmetricActualOneEquiv A x) := by
  apply Subtype.ext
  rw [symmetricActualTwoEquiv_val, symmetricFirstLefschetz_val]
  change symmetricReductionEquiv A (ℓ.val*x.val) =
    (symmetricActualOneEquiv A ℓ).val * (symmetricActualOneEquiv A x).val
  rw [symmetricActualOneEquiv_val, symmetricActualOneEquiv_val]
  exact map_mul _ _ _

/-- Injectivity of the complete first Lefschetz map is invariant under the
canonical Segre realization. -/
theorem firstLefschetz_injective_iff (A : Matrix (Cell n) D F)
    (ℓ : symmetricActualPiece A 1) :
    Function.Injective (symmetricFirstLefschetz A ℓ) ↔
      Function.Injective (ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ)) := by
  constructor
  · intro hi x y hxy
    obtain ⟨x',rfl⟩ := (symmetricActualOneEquiv A).surjective x
    obtain ⟨y',rfl⟩ := (symmetricActualOneEquiv A).surjective y
    have he : symmetricFirstLefschetz A ℓ x'=symmetricFirstLefschetz A ℓ y' := by
      apply (symmetricActualTwoEquiv A).injective
      simpa only [firstLefschetz_intertwining] using hxy
    exact congrArg (symmetricActualOneEquiv A) (hi he)
  · intro hi x y hxy
    apply (symmetricActualOneEquiv A).injective
    apply hi
    have h := congrArg (symmetricActualTwoEquiv A) hxy
    simpa only [firstLefschetz_intertwining] using h

/-- Surjectivity onto the entire second homogeneous component is also preserved. -/
theorem firstLefschetz_surjective_iff (A : Matrix (Cell n) D F)
    (ℓ : symmetricActualPiece A 1) :
    Function.Surjective (symmetricFirstLefschetz A ℓ) ↔
      Function.Surjective (ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ)) := by
  constructor
  · intro hs y
    obtain ⟨y',rfl⟩ := (symmetricActualTwoEquiv A).surjective y
    obtain ⟨x,hx⟩ := hs y'
    refine ⟨symmetricActualOneEquiv A x,?_⟩
    rw [← firstLefschetz_intertwining,hx]
  · intro hs y
    obtain ⟨x,hx⟩ := hs (symmetricActualTwoEquiv A y)
    obtain ⟨x',rfl⟩ := (symmetricActualOneEquiv A).surjective x
    refine ⟨x',?_⟩
    apply (symmetricActualTwoEquiv A).injective
    rw [firstLefschetz_intertwining]
    exact hx

theorem map_firstLefschetz_kernel (A : Matrix (Cell n) D F)
    (ℓ : symmetricActualPiece A 1) :
    (LinearMap.ker (symmetricFirstLefschetz A ℓ)).map (symmetricActualOneEquiv A).toLinearMap =
      LinearMap.ker (ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ)) := by
  ext y
  constructor
  · rintro ⟨x,hx,rfl⟩
    change ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ)
      (symmetricActualOneEquiv A x)=0
    rw [← firstLefschetz_intertwining,LinearMap.mem_ker.mp hx]
    exact LinearEquiv.map_zero (symmetricActualTwoEquiv A)
  · intro hy
    refine ⟨(symmetricActualOneEquiv A).symm y,?_,LinearEquiv.apply_symm_apply _ _⟩
    change symmetricFirstLefschetz A ℓ ((symmetricActualOneEquiv A).symm y)=0
    apply (symmetricActualTwoEquiv A).injective
    rw [firstLefschetz_intertwining,LinearEquiv.apply_symm_apply,
      LinearMap.mem_ker.mp hy]
    exact (LinearEquiv.map_zero (symmetricActualTwoEquiv A)).symm

/-- The full kernel spaces are linearly equivalent. -/
noncomputable def firstLefschetzKernelEquiv (A : Matrix (Cell n) D F)
    (ℓ : symmetricActualPiece A 1) :
    LinearMap.ker (symmetricFirstLefschetz A ℓ) ≃ₗ[F]
      LinearMap.ker (ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ)) :=
  (symmetricActualOneEquiv A).ofSubmodules _ _ (map_firstLefschetz_kernel A ℓ)

/-- Exact kernel dimensions, not just maximal-rank inequalities, agree. -/
theorem finrank_firstLefschetz_kernel (A : Matrix (Cell n) D F)
    (ℓ : symmetricActualPiece A 1) :
    Module.finrank F (LinearMap.ker (symmetricFirstLefschetz A ℓ)) =
      Module.finrank F (LinearMap.ker
        (ActualGenericity.firstLefschetz A (symmetricActualOneEquiv A ℓ))) :=
  (firstLefschetzKernelEquiv A ℓ).finrank_eq

end PaperVerification.Segre.SymmetricRealization
end
end ProbeLayer74

section ProbeLayer75



/-!
# Uniform counts of the actual first and second Segre monomial bases

A comparable pair in a product of chains is independently a weakly ordered
pair in each factor. The standard symmetric-square equivalence therefore
counts every quadratic basis monomial, with no finite-instance computation.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.HilbertCounts

open Staircase Monomials

variable {I : Type*} [Fintype I] [DecidableEq I] (n : I → ℕ)

def sortedPairEquiv : SortedPair n ≃
    ((i : I) → {p : Fin (n i+1) × Fin (n i+1) // p.1 ≤ p.2}) where
  toFun q i := ⟨(q.val.1 i,q.val.2 i),q.property i⟩
  invFun p := ⟨((fun i => (p i).val.1),(fun i => (p i).val.2)),fun i => (p i).property⟩
  left_inv q := rfl
  right_inv p := by funext i; rfl

theorem card_cells : Fintype.card (Cell n)=∏ i, (n i+1) := by
  simp only [Cell,Fintype.card_pi,Fintype.card_fin]

theorem card_sortedPairs : Fintype.card (SortedPair n)=∏ i, (n i+2).choose 2 := by
  rw [Fintype.card_congr (sortedPairEquiv n),Fintype.card_pi]
  apply Finset.prod_congr rfl
  intro i _
  rw [← Fintype.card_congr (Sym2.sortEquiv (α := Fin (n i+1))),Sym2.card,Fintype.card_fin]

end PaperVerification.Segre.HilbertCounts
end
end ProbeLayer75

section ProbeLayer76



/-!
# One-factor reductions are the ground field

When the linear parameters span every Segre coordinate, the literal quotient
is isomorphic to K. An augmentation proves that constants survive, rather
than silently assuming that the quotient is nonzero. For one factor a full
parameter family has this property on a witnessed nonempty principal open.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.OneFactor

open Staircase Monomials Balanced Artinian GeneralParameters RankParameters
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Nonempty I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

noncomputable def augmentationAlgebra : segreAlgebra (K := K) (n := n) →ₐ[K] K :=
  (MvPolynomial.aeval (fun _ : Variables n => (0 : K))).comp (segreAlgebra (K := K) (n := n)).val

theorem augmentation_coordinate (u : Cell n) : augmentationAlgebra (coordinate (K := K) u)=0 := by
  classical
  let i : I := Classical.choice (inferInstance : Nonempty I)
  change MvPolynomial.aeval (fun _ : Variables n => (0 : K)) (cellPolynomial u)=0
  rw [cellPolynomial_eq_prod,map_prod]
  apply Finset.prod_eq_zero (Finset.mem_univ i)
  exact MvPolynomial.aeval_X _ _

theorem augmentation_parameter (A : Matrix (Cell n) D K) (d : D) :
    augmentationAlgebra (parameter A d)=0 := by
  simp only [parameter,map_sum,map_smul,augmentation_coordinate,smul_zero,Finset.sum_const_zero]

noncomputable def augmentation (A : Matrix (Cell n) D K) : GeneralParameters.Reduction A →ₐ[K] K :=
  Ideal.Quotient.liftₐ _ augmentationAlgebra (by
    have hI : parameterIdeal (parameter A) ≤
        RingHom.ker (augmentationAlgebra (K := K) (n := n)).toRingHom := by
      apply Ideal.span_le.mpr
      rintro z ⟨d,rfl⟩
      exact augmentation_parameter A d
    exact fun z hz => hI hz)

theorem coordinate_parameter_combination (A : Matrix (Cell n) D K)
    (u : Cell n) (c : D → K) (hc : A *ᵥ c=Pi.single u 1) :
    (∑ d, c d • parameter A d)=coordinate (K := K) u := by
  classical
  simp only [parameter,Finset.smul_sum,smul_smul]
  rw [Finset.sum_comm]
  calc
    (∑ v, ∑ d, (c d * A v d) • coordinate v) =
        ∑ v, (A *ᵥ c) v • coordinate v := by
      apply Finset.sum_congr rfl
      intro v _
      rw [Matrix.mulVec,dotProduct,Finset.sum_smul]
      apply Finset.sum_congr rfl
      intro d _
      rw [mul_comm]
    _ = coordinate (K := K) u := by
      rw [hc]
      simp [Pi.single_apply]

theorem residueCoordinate_zero_of_full_rows (A : Matrix (Cell n) D K)
    (hA : Function.Surjective A.mulVec) (u : Cell n) :
    GeneralParameters.residueCoordinate A u=0 := by
  obtain ⟨c,hc⟩ := hA (Pi.single u 1)
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [← coordinate_parameter_combination A u c hc]
  apply Ideal.sum_mem
  intro d _
  rw [Algebra.smul_def]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_range_self d))

/-- Full row span of the parameter coefficients gives an actual algebra
isomorphism of the entire quotient with K, not only a dimension count. -/
noncomputable def reductionEquivField (A : Matrix (Cell n) D K)
    (hA : Function.Surjective A.mulVec) : GeneralParameters.Reduction A ≃ₐ[K] K :=
  (AlgEquiv.ofBijective (Algebra.ofId K (GeneralParameters.Reduction A)) (by
    constructor
    · intro x y hxy
      have h := congrArg (augmentation A) hxy
      simpa only [Algebra.ofId_apply,AlgHom.commutes,Algebra.algebraMap_self_apply] using h
    · apply (AlgHom.range_eq_top _).mp
      have hle : Algebra.adjoin K (Set.range (GeneralParameters.residueCoordinate A)) ≤
          (Algebra.ofId K (GeneralParameters.Reduction A)).range := by
        apply Algebra.adjoin_le
        rintro x ⟨u,rfl⟩
        rw [residueCoordinate_zero_of_full_rows A hA]
        exact Subalgebra.zero_mem _
      rw [GeneralParameters.residueCoordinates_generate] at hle
      exact top_unique hle)).symm

section SingleFactor

variable (n : Fin 1 → ℕ)

theorem card_cells_eq_ranks : Fintype.card (Cell n)=Fintype.card (Ranks n) := by
  change Fintype.card (Cell n)=Fintype.card (Fin (sideSum n+1))
  rw [HilbertCounts.card_cells,Fintype.card_fin]
  simp [sideSum,Fin.prod_univ_succ,Fin.sum_univ_succ]

noncomputable def universalParameters :
    Matrix (Cell n) (Ranks n) (MvPolynomial (Cell n × Ranks n) K) :=
  fun u r => MvPolynomial.X (u,r)

theorem eval_universalParameters (A : Matrix (Cell n) (Ranks n) K) :
    (universalParameters (K := K) n).map (MvPolynomial.eval (fun j => A j.1 j.2))=A := by
  ext u r
  simp only [universalParameters,Matrix.map_apply,MvPolynomial.eval_X]

/-- A nonzero minor certifies that every one-factor coordinate lies in the
span of the complete parameter family. -/
theorem one_factor_rank_certificate :
    ∃ f : MvPolynomial (Cell n × Ranks n) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective A.mulVec := by
  have hfixed : ((universalParameters (K := K) n).map
      (MvPolynomial.eval (fun j => rankForms (K := K) (n := n) j.1 j.2))).rank =
        Fintype.card (Cell n) := by
    rw [eval_universalParameters]
    rw [Matrix.vecMul_surjective_iff_rank_eq_card.mp (rankForms_surjective (K := K) (n := n))]
    exact (card_cells_eq_ranks n).symm
  obtain ⟨f,hf,hw⟩ := GenericRank.minor_witness (universalParameters (K := K) n)
    (fun j => rankForms (K := K) (n := n) j.1 j.2) (Fintype.card (Cell n)) hfixed.ge
  refine ⟨f,hf,?_⟩
  intro A hA
  have hr := hw (fun j => A j.1 j.2) hA
  rw [eval_universalParameters] at hr
  exact Matrix.mulVec_surjective_iff_rank_eq_card.mpr
    (le_antisymm (Matrix.rank_le_card_height A) hr)

/-- The k=1 clause of Theorem1.1, at every point of an explicit nonempty
principal open of all linear parameter families. -/
theorem one_factor_certificate :
    ∃ f : MvPolynomial (Cell n × Ranks n) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Nonempty (GeneralParameters.Reduction A ≃ₐ[K] K) := by
  obtain ⟨f,hf,hw⟩ := one_factor_rank_certificate (K := K) n
  exact ⟨f,hf,fun A hA => ⟨reductionEquivField A (hw A hA)⟩⟩

end SingleFactor

end PaperVerification.Segre.OneFactor
end
end ProbeLayer76

section ProbeLayer77



/-!
# The homogeneous one-factor conclusion

The entire degree-one image vanishes when the parameters span all coordinates.
This gives every first Lefschetz map injective and supplies the one-factor leaf
in the uniform principal theorem, together with the full algebra isomorphism.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.OneFactorActual

open Staircase Monomials Balanced RankParameters GeneralParameters GeneralQuotient
open GenericFirstLefschetz

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Nonempty I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

theorem oneToReduction_basis (A : Matrix (Cell n) D K) (u : Cell n) :
    oneToReduction A (degreeOneBasis (K := K) u)=residueCoordinate A u := by
  change Ideal.Quotient.mk _ (ActualQuotient.liftOne (degreeOneBasis (K := K) u)) =
    Ideal.Quotient.mk _ (Artinian.coordinate u)
  congr 1
  apply Subtype.ext
  change (degreeOneBasis (K := K) (n := n) u).val = cellPolynomial u
  exact Module.Basis.coe_span_apply _ _

theorem actualDegreeOne_eq_bot_of_full_rows (A : Matrix (Cell n) D K)
    (hA : Function.Surjective A.mulVec) : actualDegreeOne A=⊥ := by
  have hmap : oneToReduction A=0 := by
    apply (degreeOneBasis (K := K) (n := n)).ext
    intro u
    rw [oneToReduction_basis]
    exact OneFactor.residueCoordinate_zero_of_full_rows A hA u
  rw [actualDegreeOne,hmap,LinearMap.range_zero]

theorem firstLefschetz_injective_of_full_rows (A : Matrix (Cell n) D K)
    (hA : Function.Surjective A.mulVec) (ℓ : degreeOne (K := K) (n := n)) :
    Function.Injective (firstLefschetz A ℓ) := by
  intro x y _
  have hx : (x.val : Reduction A) ∈ (⊥ : Submodule K (Reduction A)) := by
    simpa only [actualDegreeOne_eq_bot_of_full_rows A hA] using x.property
  have hy : (y.val : Reduction A) ∈ (⊥ : Submodule K (Reduction A)) := by
    simpa only [actualDegreeOne_eq_bot_of_full_rows A hA] using y.property
  apply Subtype.ext
  exact ((Submodule.mem_bot K).mp hx).trans ((Submodule.mem_bot K).mp hy).symm

theorem one_factor_joint_certificate (n : Fin 1 → ℕ) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (Reduction (oldForms A)) ∧ IsArtinianRing (Reduction (oldForms A)) ∧
          (Function.Injective (firstLefschetz (oldForms A) (lefschetzForm A)) ∨
            Function.Surjective (firstLefschetz (oldForms A) (lefschetzForm A))) ∧
          Module.finrank K (LinearMap.ker (firstLefschetz (oldForms A) (lefschetzForm A)))=0 := by
  obtain ⟨f,hf,hw⟩ := OneFactor.one_factor_rank_certificate (K := K) n
  let g := MvPolynomial.rename (oldVariable (n := n) (D := Ranks n)) f
  have hg : g ≠ 0 := by
    exact fun h => hf ((MvPolynomial.rename_eq_zero_iff_of_injective f
      (oldVariable (n := n) (D := Ranks n)).injective).mp h)
  refine ⟨g,hg,?_⟩
  intro A hA
  have hold : Function.Surjective (oldForms A).mulVec := hw (oldForms A) (by
    simpa only [g,MvPolynomial.eval_rename,Function.comp_def,oldVariable,
      Function.Embedding.coeFn_mk,oldForms] using hA)
  let e := OneFactor.reductionEquivField (oldForms A) hold
  have hfin : Module.Finite K (Reduction (oldForms A)) :=
    Module.Finite.of_surjective e.symm.toLinearMap e.symm.surjective
  letI := hfin
  have hart : IsArtinianRing (Reduction (oldForms A)) := IsArtinianRing.of_finite K _
  have hi := firstLefschetz_injective_of_full_rows (oldForms A) hold (lefschetzForm A)
  refine ⟨hfin,hart,Or.inl hi,?_⟩
  rw [LinearMap.ker_eq_bot.mpr hi]
  exact finrank_bot K _

end PaperVerification.Segre.OneFactorActual
end
end ProbeLayer77

section ProbeLayer78



/-!
# Literal rectangular coordinates in the actual Segre quotient

The coordinate definitions and minor identities need only the actual Segre
subalgebra and its rank-parameter ideal. Degree-two exactness and rigidity are
separate later results, and are not prerequisites of these definitions.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorActual

open Staircase Monomials Balanced RankParameters

variable {K : Type*} [Field K]

/-- Cache the canonical quotient structures at a symbolic two-factor shape.
This avoids repeatedly expanding the parameter ideal while typeclass search
normalizes a concrete shape such as `(a,b+1)`. These are the original quotient
instances, with no additional algebraic hypotheses. -/
noncomputable instance reductionCommRing (n : Fin 2 → ℕ) :
    CommRing (Artinian.Reduction (K := K) (n := n)) := inferInstance

noncomputable instance reductionAlgebra (n : Fin 2 → ℕ) :
    Algebra K (Artinian.Reduction (K := K) (n := n)) := inferInstance

noncomputable instance reductionModule (n : Fin 2 → ℕ) :
    Module K (Artinian.Reduction (K := K) (n := n)) := inferInstance

def shape (a b : ℕ) : Fin 2 → ℕ := ![a,b]

def cell (a b : ℕ) (i : Fin (a + 1)) (j : Fin (b + 1)) : Cell (shape a b) :=
  Fin.cases i (Fin.cases j (fun q => Fin.elim0 q))

noncomputable def cellEquiv (a b : ℕ) :
    (Fin (a + 1) × Fin (b + 1)) ≃ Cell (shape a b) where
  toFun ij := cell a b ij.1 ij.2
  invFun u := (u 0,u 1)
  left_inv _ := rfl
  right_inv u := by
    funext i
    fin_cases i <;> rfl

@[simp] theorem cellEquiv_apply (a b : ℕ) (ij : Fin (a + 1) × Fin (b + 1)) :
    (cellEquiv a b) ij = cell a b ij.1 ij.2 := rfl

@[simp] theorem sideSum_shape (a b : ℕ) : sideSum (shape a b) = a + b := by
  simp [sideSum, shape, Fin.sum_univ_succ]

@[simp] theorem rank_cell (a b : ℕ) (i : Fin (a + 1)) (j : Fin (b + 1)) :
    rank (cell a b i j) = i.val + j.val := by
  rw [rank, Fin.sum_univ_two]
  rfl

noncomputable def «variable» (a b : ℕ) (i : Fin (a + 1)) (j : Fin (b + 1)) :
    Artinian.Reduction (K := K) (n := shape a b) :=
  Artinian.residueCoordinate (cell a b i j)

theorem cellPolynomial_value (a b : ℕ) (i : Fin (a + 1)) (j : Fin (b + 1)) :
    cellPolynomial (K := K) (cell a b i j) =
      MvPolynomial.X ⟨0,i⟩ * MvPolynomial.X ⟨1,j⟩ := by
  rw [cellPolynomial_eq_prod, Fin.prod_univ_two]
  rfl

/-- Every two-by-two minor vanishes because the generators are the actual
products of one coordinate from each original factor. -/
theorem variable_minor (a b : ℕ) (i k : Fin (a + 1)) (j l : Fin (b + 1)) :
    «variable» (K := K) a b i j * «variable» a b k l =
      «variable» a b i l * «variable» a b k j := by
  have h : Artinian.coordinate (K := K) (cell a b i j) * Artinian.coordinate (cell a b k l) =
      Artinian.coordinate (cell a b i l) * Artinian.coordinate (cell a b k j) := by
    apply Subtype.ext
    change cellPolynomial (cell a b i j) * cellPolynomial (cell a b k l) =
      cellPolynomial (cell a b i l) * cellPolynomial (cell a b k j)
    rw [cellPolynomial_value, cellPolynomial_value, cellPolynomial_value, cellPolynomial_value]
    ring
  have hq := congrArg (Ideal.Quotient.mk
    (parameterIdeal (Artinian.rankParameter (K := K) (n := shape a b)))) h
  simpa only [map_mul, «variable», Artinian.residueCoordinate] using hq

end PaperVerification.Segre.TwoFactorActual
end
end ProbeLayer78

section ProbeLayer79



/-!
# Two-factor coordinates in the literal Artinian Segre algebra

All variables below are the actual residue monomials in the previously defined
Segre subalgebra. Their minors and rank sums are proved from actual polynomial
multiplication and the internal parameter ideal. The full variable spans are
identified with the actual first two homogeneous components.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorActual

open Staircase Monomials Balanced RankParameters ActualQuotient

variable {K : Type*} [Field K]

/-- All rank sums vanish in the actual quotient, expressed in the original
rectangular row-column indices. -/
theorem rank_sums_zero (a b : ℕ) (r : Fin (a + b + 1)) :
    (∑ i : Fin (a + 1), ∑ j : Fin (b + 1),
      if i.val + j.val = r.val then «variable» (K := K) a b i j else 0) = 0 := by
  let r' : Ranks (shape a b) := ⟨r.val, by simpa only [sideSum_shape] using r.isLt⟩
  have h := residue_rankSum (K := K) r'
  rw [← Equiv.sum_comp (cellEquiv a b)] at h
  rw [Fintype.sum_prod_type] at h
  simpa only [cellEquiv_apply, rankForms, rankIndex, Fin.ext_iff, rank_cell,
    r', ite_smul, one_smul, zero_smul, «variable»] using h

noncomputable def linearCoordinateSpan (a b : ℕ) :
    Submodule K (Artinian.Reduction (K := K) (n := shape a b)) :=
  Submodule.span K (Set.range fun ij : Fin (a + 1) × Fin (b + 1) =>
    «variable» a b ij.1 ij.2)

noncomputable def quadraticCoordinateSpan (a b : ℕ) :
    Submodule K (Artinian.Reduction (K := K) (n := shape a b)) :=
  Submodule.span K (Set.range fun ij :
    (Fin (a + 1) × Fin (b + 1)) × (Fin (a + 1) × Fin (b + 1)) =>
      «variable» a b ij.1.1 ij.1.2 * «variable» a b ij.2.1 ij.2.2)

theorem actualDegreeOne_eq_linearSpan (a b : ℕ) :
    actualDegreeOne (K := K) (n := shape a b) = linearCoordinateSpan a b := by
  rw [actualDegreeOne_eq_coordinateSpan, linearCoordinateSpan]
  congr 1
  ext z
  constructor
  · rintro ⟨u, rfl⟩
    refine ⟨(cellEquiv a b).symm u, ?_⟩
    change Artinian.residueCoordinate ((cellEquiv a b) ((cellEquiv a b).symm u)) = _
    rw [Equiv.apply_symm_apply]
  · rintro ⟨ij, rfl⟩
    exact ⟨cell a b ij.1 ij.2, rfl⟩

theorem actualDegreeTwo_eq_quadraticSpan (a b : ℕ) :
    actualDegreeTwo (K := K) (n := shape a b) = quadraticCoordinateSpan a b := by
  rw [actualDegreeTwo_eq_coordinateProductSpan, quadraticCoordinateSpan]
  congr 1
  ext z
  constructor
  · rintro ⟨⟨u,v⟩, rfl⟩
    refine ⟨((cellEquiv a b).symm u,(cellEquiv a b).symm v), ?_⟩
    change Artinian.residueCoordinate ((cellEquiv a b) ((cellEquiv a b).symm u)) *
      Artinian.residueCoordinate ((cellEquiv a b) ((cellEquiv a b).symm v)) = _
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  · rintro ⟨⟨ij,kl⟩, rfl⟩
    exact ⟨(cell a b ij.1 ij.2, cell a b kl.1 kl.2), rfl⟩

end PaperVerification.Segre.TwoFactorActual
end
end ProbeLayer79

section ProbeLayer80



/-!
# The literal last-column quotient map

The map deletes the final coordinate in the second factor's ambient polynomial
ring. It restricts to the actual Segre subalgebra and annihilates every large
rank parameter modulo the smaller rank parameters. The resulting surjection
is therefore a homomorphism of the literal Artinian quotient rings.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorTruncation

open Staircase Monomials Balanced RankParameters Artinian TwoFactorActual

variable {K : Type*} [Field K]

noncomputable def variableTruncation (a b : ℕ) : Variables (shape a (b+1)) →
    MvPolynomial (Variables (shape a b)) K :=
  fun v => Fin.cases
    (fun j : Fin (a+1) => MvPolynomial.X ⟨0,j⟩)
    (Fin.cases
      (fun j : Fin (b+1+1) =>
        if h : j.val < b+1 then MvPolynomial.X ⟨1,⟨j.val,h⟩⟩ else 0)
      (fun q => Fin.elim0 q)) v.1 v.2

noncomputable def ambientTruncation (a b : ℕ) :
    MvPolynomial (Variables (shape a (b+1))) K →ₐ[K]
      MvPolynomial (Variables (shape a b)) K := MvPolynomial.aeval (variableTruncation a b)

@[simp] theorem variableTruncation_left (a b : ℕ) (i : Fin (a+1)) :
    variableTruncation (K := K) a b ⟨0,i⟩ = MvPolynomial.X ⟨0,i⟩ := by
  rfl

@[simp] theorem variableTruncation_right (a b : ℕ) (j : Fin (b+1)) :
    variableTruncation (K := K) a b ⟨1,j.castSucc⟩ = MvPolynomial.X ⟨1,j⟩ := by
  change (if h : j.val < b+1 then MvPolynomial.X (R := K) (⟨1,⟨j.val,h⟩⟩ : Variables (shape a b)) else 0) = _
  rw [dif_pos j.isLt]
  exact congrArg (MvPolynomial.X (R := K))
    (Sigma.ext rfl (heq_of_eq (Fin.ext rfl)))

@[simp] theorem variableTruncation_last (a b : ℕ) :
    variableTruncation (K := K) a b ⟨1,Fin.last (b+1)⟩ = 0 := by
  change (if h : b+1 < b+1 then MvPolynomial.X (R := K) (⟨1,⟨b+1,h⟩⟩ : Variables (shape a b)) else 0) = _
  rw [dif_neg (Nat.lt_irrefl _)]

@[simp] theorem ambientTruncation_cell (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    ambientTruncation (K := K) a b (cellPolynomial (cell a (b+1) i j.castSucc)) =
      cellPolynomial (cell a b i j) := by
  rw [cellPolynomial_value,map_mul]
  simp only [ambientTruncation,MvPolynomial.aeval_X,variableTruncation_left,
    variableTruncation_right,cellPolynomial_value]

@[simp] theorem ambientTruncation_cell_last (a b : ℕ) (i : Fin (a+1)) :
    ambientTruncation (K := K) a b (cellPolynomial (cell a (b+1) i (Fin.last (b+1)))) = 0 := by
  rw [cellPolynomial_value,map_mul]
  simp only [ambientTruncation,MvPolynomial.aeval_X,variableTruncation_left,
    variableTruncation_last,mul_zero]

theorem ambientTruncation_mem (a b : ℕ)
    (f : segreAlgebra (K := K) (n := shape a (b+1))) :
    ambientTruncation a b f.val ∈ segreAlgebra (K := K) (n := shape a b) := by
  rcases f with ⟨f,hf⟩
  change ambientTruncation a b f ∈ _
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
      obtain ⟨u,rfl⟩ := hf
      obtain ⟨⟨i,j⟩,rfl⟩ := (cellEquiv a (b+1)).surjective u
      change ambientTruncation a b (cellPolynomial (cell a (b+1) i j)) ∈ _
      refine Fin.lastCases ?_ (fun j => ?_) j
      · rw [ambientTruncation_cell_last]
        exact Subalgebra.zero_mem _
      · rw [ambientTruncation_cell]
        exact Algebra.subset_adjoin (Set.mem_range_self _)
  | algebraMap c =>
      rw [AlgHom.commutes]
      exact Subalgebra.algebraMap_mem _ _
  | add f g hf hg ihf ihg =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihf ihg
  | mul f g hf hg ihf ihg =>
      rw [map_mul]
      exact Subalgebra.mul_mem _ ihf ihg

noncomputable def truncationAlgebra (a b : ℕ) :
    segreAlgebra (K := K) (n := shape a (b+1)) →ₐ[K]
      segreAlgebra (K := K) (n := shape a b) :=
  ((ambientTruncation a b).comp (segreAlgebra (K := K) (n := shape a (b+1))).val).codRestrict
    (segreAlgebra (K := K) (n := shape a b)) (ambientTruncation_mem a b)

@[simp] theorem truncationAlgebra_coordinate (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    truncationAlgebra (K := K) a b (coordinate (cell a (b+1) i j.castSucc)) =
      coordinate (cell a b i j) := by
  apply Subtype.ext
  exact ambientTruncation_cell a b i j

@[simp] theorem truncationAlgebra_coordinate_last (a b : ℕ) (i : Fin (a+1)) :
    truncationAlgebra (K := K) a b (coordinate (cell a (b+1) i (Fin.last (b+1)))) = 0 := by
  apply Subtype.ext
  exact ambientTruncation_cell_last a b i

noncomputable def toSmallReduction (a b : ℕ) :
    segreAlgebra (K := K) (n := shape a (b+1)) →ₐ[K]
      Artinian.Reduction (K := K) (n := shape a b) :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (rankParameter (K := K) (n := shape a b)))).comp
    (truncationAlgebra a b)

@[simp] theorem toSmallReduction_coordinate (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    toSmallReduction (K := K) a b (coordinate (cell a (b+1) i j.castSucc)) =
      «variable» a b i j := by
  simp only [toSmallReduction,AlgHom.comp_apply,truncationAlgebra_coordinate]
  rfl

@[simp] theorem toSmallReduction_coordinate_last (a b : ℕ) (i : Fin (a+1)) :
    toSmallReduction (K := K) a b (coordinate (cell a (b+1) i (Fin.last (b+1)))) = 0 := by
  simp only [toSmallReduction,AlgHom.comp_apply,truncationAlgebra_coordinate_last,map_zero]

theorem toSmallReduction_rankParameter (a b : ℕ) (r : Ranks (shape a (b+1))) :
    toSmallReduction (K := K) a b (rankParameter r) = 0 := by
  have hsum : toSmallReduction (K := K) a b (rankParameter r) =
      ∑ i : Fin (a+1), ∑ j : Fin (b+1),
        if i.val+j.val=r.val then «variable» (K := K) a b i j else 0 := by
    rw [rankParameter,map_sum]
    simp only [map_smul]
    rw [← Equiv.sum_comp (cellEquiv a (b+1)),Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro i _
    rw [Fin.sum_univ_castSucc]
    simp only [cellEquiv_apply,toSmallReduction_coordinate,toSmallReduction_coordinate_last,
      smul_zero,add_zero,rankForms,rankIndex,Fin.ext_iff,rank_cell,ite_smul,one_smul,zero_smul,
      Fin.val_castSucc]
  rw [hsum]
  by_cases hr : r.val < a+b+1
  · exact rank_sums_zero a b ⟨r.val,hr⟩
  · apply Finset.sum_eq_zero
    intro i _
    apply Finset.sum_eq_zero
    intro j _
    have hi := i.isLt
    have hj := j.isLt
    rw [if_neg (by omega)]

theorem parameterIdeal_le_kernel (a b : ℕ) :
    parameterIdeal (rankParameter (K := K) (n := shape a (b+1))) ≤
      RingHom.ker (toSmallReduction (K := K) a b).toRingHom := by
  apply Ideal.span_le.mpr
  rintro f ⟨r,rfl⟩
  exact toSmallReduction_rankParameter a b r

/-- Setting the final column to zero is an actual algebra homomorphism of the
specified rank-sum Artinian reductions. -/
noncomputable def truncation (a b : ℕ) :
    Artinian.Reduction (K := K) (n := shape a (b+1)) →ₐ[K]
      Artinian.Reduction (K := K) (n := shape a b) :=
  Ideal.Quotient.liftₐ _ (toSmallReduction a b) (fun _ h => parameterIdeal_le_kernel a b h)

@[simp] theorem truncation_variable (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    truncation (K := K) a b («variable» a (b+1) i j.castSucc) = «variable» a b i j :=
  toSmallReduction_coordinate a b i j

@[simp] theorem truncation_variable_last (a b : ℕ) (i : Fin (a+1)) :
    truncation (K := K) a b («variable» a (b+1) i (Fin.last (b+1))) = 0 :=
  toSmallReduction_coordinate_last a b i

/-- The quotient is surjective on the entire ring, as asserted in Lemma3.2. -/
theorem truncation_surjective (a b : ℕ) : Function.Surjective (truncation (K := K) a b) := by
  have hr : Algebra.adjoin K (Set.range (residueCoordinate (K := K) (n := shape a b))) ≤
      (truncation (K := K) a b).range := by
    apply Algebra.adjoin_le
    rintro z ⟨u,rfl⟩
    obtain ⟨⟨i,j⟩,rfl⟩ := (cellEquiv a b).surjective u
    exact ⟨«variable» a (b+1) i j.castSucc,truncation_variable a b i j⟩
  rw [residueCoordinates_generate] at hr
  exact (AlgHom.range_eq_top _).mp (top_unique hr)

end PaperVerification.Segre.TwoFactorTruncation
end
end ProbeLayer80

section ProbeLayer81



/-!
# The complete rectangular degree-one basis and truncation kernel

Every antidiagonal has exactly one coordinate outside the descent rectangle.
Its rank sum eliminates that coordinate with coefficient one. The independently
proved actual degree-one dimension then gives a basis over every field. This
identifies the entire degree-one kernel of last-column truncation, for arbitrary
row and column counts, without assuming the degree-two descent basis.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000

@[expose] public section

namespace PaperVerification.Segre.TwoFactorDegreeOne

open Staircase Monomials Balanced RankParameters ActualQuotient TwoFactorActual TwoFactorTruncation

variable {K : Type*} [Field K]

noncomputable def descent (a b : ℕ) (ij : Fin a × Fin b) :
    Artinian.Reduction (K := K) (n := shape a b) := «variable» (K := K) a b ij.1.castSucc ij.2.succ

noncomputable def descentSpan (a b : ℕ) :
    Submodule K (Artinian.Reduction (K := K) (n := shape a b)) :=
  Submodule.span K (Set.range (descent (K := K) a b))

theorem boundary_same_rank (a b : ℕ) (u v : Fin (a+1) × Fin (b+1))
    (hu : ¬ (u.1.val<a ∧ 0<u.2.val)) (hv : ¬ (v.1.val<a ∧ 0<v.2.val))
    (hr : u.1.val+u.2.val=v.1.val+v.2.val) : u=v := by
  have hui := u.1.isLt
  have hvi := v.1.isLt
  apply Prod.ext <;> apply Fin.ext <;> omega

/-- Eliminate precisely the one boundary coordinate on each antidiagonal. -/
theorem variable_mem_descentSpan (a b : ℕ) (u : Fin (a+1) × Fin (b+1)) :
    «variable» (K := K) a b u.1 u.2 ∈ descentSpan (K := K) a b := by
  classical
  have hinterior (v : Fin (a+1) × Fin (b+1)) (hv : v.1.val<a ∧ 0<v.2.val) :
      «variable» (K := K) a b v.1 v.2 ∈ descentSpan (K := K) a b := by
    let i : Fin a := ⟨v.1.val,hv.1⟩
    let j : Fin b := ⟨v.2.val-1,by have hj := v.2.isLt; omega⟩
    have hi : i.castSucc=v.1 := Fin.ext rfl
    have hj : j.succ=v.2 := Fin.ext (by dsimp [j]; omega)
    have h := Submodule.subset_span (R := K) (Set.mem_range_self (f := descent (K := K) a b) (i,j))
    change descent (K := K) a b (i,j) ∈ descentSpan (K := K) a b at h
    simpa only [descent,hi,hj] using h
  by_cases hu : u.1.val<a ∧ 0<u.2.val
  · exact hinterior u hu
  · let r : Fin (a+b+1) := ⟨u.1.val+u.2.val,by
      have hi := u.1.isLt
      have hj := u.2.isLt
      omega⟩
    let f : (Fin (a+1) × Fin (b+1)) → Artinian.Reduction (K := K) (n := shape a b) :=
      fun v => if v.1.val+v.2.val=r.val then «variable» (K := K) a b v.1 v.2 else 0
    have hsum : ∑ v, f v = 0 := by
      rw [Fintype.sum_prod_type]
      exact rank_sums_zero a b r
    rw [← Finset.add_sum_erase Finset.univ f (Finset.mem_univ u)] at hsum
    have hfu : f u = «variable» (K := K) a b u.1 u.2 := by simp only [f,r,if_pos rfl]
    rw [hfu] at hsum
    rw [eq_neg_of_add_eq_zero_left hsum]
    apply Submodule.neg_mem
    apply Submodule.sum_mem
    intro v hv
    have hne : v≠u := (Finset.mem_erase.mp hv).1
    dsimp [f]
    split_ifs with hr
    · apply hinterior
      by_contra hvi
      exact hne (boundary_same_rank a b v u hvi hu hr)
    · exact Submodule.zero_mem _

theorem actualDegreeOne_eq_descentSpan (a b : ℕ) :
    actualDegreeOne (K := K) (n := shape a b) = descentSpan (K := K) a b := by
  rw [actualDegreeOne_eq_linearSpan]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro z ⟨u,rfl⟩
    exact variable_mem_descentSpan a b u
  · apply Submodule.span_le.mpr
    rintro z ⟨ij,rfl⟩
    exact Submodule.subset_span (Set.mem_range_self (ij.1.castSucc,ij.2.succ))

theorem finrank_actualDegreeOne_shape (a b : ℕ) :
    Module.finrank K (actualDegreeOne (K := K) (n := shape a b)) = a*b := by
  rw [finrank_actualDegreeOne,sideSum_shape,← Fintype.card_congr (cellEquiv a b)]
  simp only [Fintype.card_prod,Fintype.card_fin]
  have h : (a+1)*(b+1)=a*b+(a+b+1) := by ring
  rw [h,Nat.add_sub_cancel]

/-- The full degree-one descent basis, without an infinite-field hypothesis. -/
theorem descent_linearIndependent (a b : ℕ) : LinearIndependent K (descent (K := K) a b) := by
  apply linearIndependent_iff_card_eq_finrank_span.mpr
  change Fintype.card (Fin a × Fin b) = Module.finrank K (descentSpan (K := K) a b)
  rw [← actualDegreeOne_eq_descentSpan,finrank_actualDegreeOne_shape]
  simp only [Fintype.card_prod,Fintype.card_fin]

@[simp] theorem truncation_descent (a b : ℕ) (i : Fin a) (j : Fin b) :
    truncation (K := K) a b (descent a (b+1) (i,j.castSucc)) = descent a b (i,j) := by
  change truncation (K := K) a b («variable» (K := K) a (b+1) i.castSucc j.castSucc.succ) = _
  have h : j.castSucc.succ=j.succ.castSucc := Fin.ext rfl
  rw [h,truncation_variable]
  rfl

@[simp] theorem truncation_descent_last (a b : ℕ) (i : Fin a) :
    truncation (K := K) a b (descent a (b+1) (i,Fin.last b)) = 0 := by
  change truncation (K := K) a b («variable» (K := K) a (b+1) i.castSucc (Fin.last b).succ) = 0
  have h : (Fin.last b).succ=Fin.last (b+1) := Fin.ext rfl
  rw [h,truncation_variable_last]

set_option maxHeartbeats 1000000 in
/-- Truncation removes precisely the last column from an arbitrary finite
linear combination of the actual descent generators. -/
theorem truncation_descent_sum (a b : ℕ) (c : Fin a × Fin (b+1) → K) :
    truncation (K := K) a b
      (∑ ij, c ij • descent (K := K) a (b+1) ij) =
      ∑ ij : Fin a × Fin b, c (ij.1,ij.2.castSucc) • descent (K := K) a b ij := by
  rw [map_sum]
  simp only [map_smul,Fintype.sum_prod_type]
  simp only [Fin.sum_univ_castSucc,truncation_descent,truncation_descent_last,
    smul_zero,add_zero]

set_option maxHeartbeats 1000000 in
/-- Vanishing after truncation forces all coefficients outside the last
column to vanish, by the proved independence in the smaller actual quotient. -/
theorem descent_sum_eq_last_of_truncation_zero (a b : ℕ)
    (c : Fin a × Fin (b+1) → K)
    (hz : truncation (K := K) a b
      (∑ ij, c ij • descent (K := K) a (b+1) ij) = 0) :
    (∑ ij, c ij • descent (K := K) a (b+1) ij) =
      ∑ i, c (i,Fin.last b) • «variable» (K := K) a (b+1)
        i.castSucc (Fin.last (b+1)) := by
  classical
  have hsmall : (∑ ij : Fin a × Fin b,
      c (ij.1,ij.2.castSucc) • descent (K := K) a b ij) = 0 :=
    (truncation_descent_sum (K := K) a b c).symm.trans hz
  have hzold : ∀ ij : Fin a × Fin b, c (ij.1,ij.2.castSucc)=0 :=
    Fintype.linearIndependent_iff.mp (descent_linearIndependent (K := K) a b) _ hsmall
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro i _
  rw [Fin.sum_univ_castSucc]
  have hzero : (∑ j : Fin b,
      c (i,j.castSucc) • descent (K := K) a (b+1) (i,j.castSucc))=0 := by
    apply Finset.sum_eq_zero
    intro j _
    rw [hzold (i,j),zero_smul]
  rw [hzero,zero_add] <;> rfl

set_option maxHeartbeats 1000000 in
/-- The entire degree-one kernel consists precisely of linear combinations of
all a last-column generators; this is the J1 statement in Lemma3.2. -/
theorem degreeOne_kernel (a b : ℕ)
    (z : actualDegreeOne (K := K) (n := shape a (b+1)))
    (hz : truncation (K := K) a b z.val=0) :
    ∃ c : Fin a → K, z.val=∑ i, c i • «variable» (K := K) a (b+1) i.castSucc (Fin.last (b+1)) := by
  classical
  have hmem : z.val ∈ descentSpan (K := K) a (b+1) := by
    rw [← actualDegreeOne_eq_descentSpan]
    exact z.property
  change z.val ∈ Submodule.span K (Set.range (descent (K := K) a (b+1))) at hmem
  obtain ⟨c,hc⟩ :=
    (Submodule.mem_span_range_iff_exists_fun K
      (v := descent (K := K) a (b+1)) (x := z.val)).mp hmem
  refine ⟨fun i => c (i,Fin.last b), ?_⟩
  rw [← hc]
  apply descent_sum_eq_last_of_truncation_zero
  rw [hc]
  exact hz

/-- Conversely every displayed last-column combination is killed by truncation. -/
theorem lastColumn_sum_truncation (a b : ℕ) (c : Fin a → K) :
    truncation (K := K) a b
      (∑ i, c i • «variable» (K := K) a (b+1) i.castSucc (Fin.last (b+1))) = 0 := by
  simp only [map_sum,map_smul,truncation_variable_last,smul_zero,Finset.sum_const_zero]

/-- Truncation preserves the entire first homogeneous component. -/
theorem truncation_one_mem (a b : ℕ)
    (z : Artinian.Reduction (K := K) (n := shape a (b+1)))
    (hz : z ∈ actualDegreeOne (K := K) (n := shape a (b+1))) :
    truncation (K := K) a b z ∈ actualDegreeOne (K := K) (n := shape a b) := by
  rw [actualDegreeOne_eq_linearSpan (K := K) a (b+1)] at hz
  rw [actualDegreeOne_eq_linearSpan (K := K) a b]
  induction hz using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨⟨i,j⟩,rfl⟩ := hz
      refine Fin.lastCases ?_ (fun j => ?_) j
      · rw [truncation_variable_last]
        exact Submodule.zero_mem _
      · rw [truncation_variable]
        exact Submodule.subset_span (Set.mem_range_self (i,j))
  | zero => simpa only [map_zero] using (Submodule.zero_mem (linearCoordinateSpan (K := K) a b))
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
  | smul c x hx ih =>
      rw [map_smul]
      exact Submodule.smul_mem _ c ih

/-- Every actual degree-one element downstairs has an actual degree-one lift. -/
theorem truncation_one_surjective (a b : ℕ)
    (y : Artinian.Reduction (K := K) (n := shape a b))
    (hy : y ∈ actualDegreeOne (K := K) (n := shape a b)) :
    ∃ x : Artinian.Reduction (K := K) (n := shape a (b+1)),
      x ∈ actualDegreeOne (K := K) (n := shape a (b+1)) ∧ truncation (K := K) a b x=y := by
  rw [actualDegreeOne_eq_linearSpan] at hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨⟨i,j⟩,rfl⟩ := hy
      refine ⟨«variable» (K := K) a (b+1) i j.castSucc, ?_, truncation_variable a b i j⟩
      rw [actualDegreeOne_eq_linearSpan]
      exact Submodule.subset_span (Set.mem_range_self (i,j.castSucc))
  | zero => exact ⟨0,Submodule.zero_mem _,map_zero _⟩
  | add x y hx hy ihx ihy =>
      obtain ⟨x',hx',he₁⟩ := ihx
      obtain ⟨y',hy',he₂⟩ := ihy
      exact ⟨x'+y',Submodule.add_mem _ hx' hy',by rw [map_add,he₁,he₂]⟩
  | smul c x hx ih =>
      obtain ⟨x',hx',he⟩ := ih
      exact ⟨c • x',Submodule.smul_mem _ c hx',by rw [map_smul,he]⟩

/-- Truncation preserves the full second homogeneous component. -/
theorem truncation_two_mem (a b : ℕ)
    (z : Artinian.Reduction (K := K) (n := shape a (b+1)))
    (hz : z ∈ actualDegreeTwo (K := K) (n := shape a (b+1))) :
    truncation (K := K) a b z ∈ actualDegreeTwo (K := K) (n := shape a b) := by
  rw [actualDegreeTwo_eq_quadraticSpan (K := K) a (b+1)] at hz
  rw [actualDegreeTwo_eq_quadraticSpan (K := K) a b]
  induction hz using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨⟨⟨i,j⟩,⟨k,l⟩⟩,rfl⟩ := hz
      rw [map_mul]
      refine Fin.lastCases ?_ (fun j => ?_) j
      · rw [truncation_variable_last,zero_mul]
        exact Submodule.zero_mem _
      · rw [truncation_variable]
        refine Fin.lastCases ?_ (fun l => ?_) l
        · rw [truncation_variable_last,mul_zero]
          exact Submodule.zero_mem _
        · rw [truncation_variable]
          exact Submodule.subset_span (Set.mem_range_self ((i,j),(k,l)))
  | zero => simpa only [map_zero] using (Submodule.zero_mem (quadraticCoordinateSpan (K := K) a b))
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
  | smul c x hx ih =>
      rw [map_smul]
      exact Submodule.smul_mem _ c ih

/-- Truncation is onto the full second homogeneous component. -/
theorem truncation_two_surjective (a b : ℕ)
    (y : Artinian.Reduction (K := K) (n := shape a b))
    (hy : y ∈ actualDegreeTwo (K := K) (n := shape a b)) :
    ∃ x : Artinian.Reduction (K := K) (n := shape a (b+1)),
      x ∈ actualDegreeTwo (K := K) (n := shape a (b+1)) ∧ truncation (K := K) a b x=y := by
  rw [actualDegreeTwo_eq_quadraticSpan] at hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨⟨⟨i,j⟩,⟨k,l⟩⟩,rfl⟩ := hy
      refine ⟨«variable» (K := K) a (b+1) i j.castSucc * «variable» (K := K) a (b+1) k l.castSucc, ?_, ?_⟩
      · rw [actualDegreeTwo_eq_quadraticSpan]
        exact Submodule.subset_span (Set.mem_range_self ((i,j.castSucc),(k,l.castSucc)))
      · rw [map_mul,truncation_variable,truncation_variable]
  | zero => exact ⟨0,Submodule.zero_mem _,map_zero _⟩
  | add x y hx hy ihx ihy =>
      obtain ⟨x',hx',he₁⟩ := ihx
      obtain ⟨y',hy',he₂⟩ := ihy
      exact ⟨x'+y',Submodule.add_mem _ hx' hy',by rw [map_add,he₁,he₂]⟩
  | smul c x hx ih =>
      obtain ⟨x',hx',he⟩ := ih
      exact ⟨c • x',Submodule.smul_mem _ c hx',by rw [map_smul,he]⟩

end PaperVerification.Segre.TwoFactorDegreeOne
end
end ProbeLayer81

section ProbeLayer82



/-!
# Characteristic-free dual polynomials for the last-column induction

The four variables record the two row indices and the two column indices of a
quadratic Segre monomial. Separately symmetric coefficients define a functional
on that monomial space. Identifying the first row variable with the first column
variable turns the antidiagonal parameter equations into coefficient equations.
The factor `(S-U)(S-V)(T-U)(T-V)` forces those equations integrally.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace PaperVerification.Segre.TwoFactorDualPolynomial

open MvPolynomial

variable {K : Type*} [CommRing K]

/-- Row-pair and column-pair exponents, with no divided-power normalization. -/
def index4 (i k j l : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 0 i + Finsupp.single 1 k + Finsupp.single 2 j + Finsupp.single 3 l

def index3 (s k l : ℕ) : Fin 3 →₀ ℕ :=
  Finsupp.single 0 s + Finsupp.single 1 k + Finsupp.single 2 l

@[simp] theorem index4_zero (i k j l : ℕ) : index4 i k j l 0 = i := by simp [index4]
@[simp] theorem index4_one (i k j l : ℕ) : index4 i k j l 1 = k := by simp [index4]
@[simp] theorem index4_two (i k j l : ℕ) : index4 i k j l 2 = j := by simp [index4]
@[simp] theorem index4_three (i k j l : ℕ) : index4 i k j l 3 = l := by simp [index4]

@[simp] theorem index4_eq_iff (i k j l i' k' j' l' : ℕ) :
    index4 i k j l = index4 i' k' j' l' ↔ i = i' ∧ k = k' ∧ j = j' ∧ l = l' := by
  constructor
  · intro h
    exact ⟨by simpa using congrArg (fun m => m 0) h,
      by simpa using congrArg (fun m => m 1) h,
      by simpa using congrArg (fun m => m 2) h,
      by simpa using congrArg (fun m => m 3) h⟩
  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl

@[simp] theorem index3_eq_iff (s k l s' k' l' : ℕ) :
    index3 s k l = index3 s' k' l' ↔ s = s' ∧ k = k' ∧ l = l' := by
  constructor
  · intro h
    exact ⟨by simpa [index3] using congrArg (fun m => m 0) h,
      by simpa [index3] using congrArg (fun m => m 1) h,
      by simpa [index3] using congrArg (fun m => m 2) h⟩
  · rintro ⟨rfl,rfl,rfl⟩
    rfl

theorem index4_add (i k j l i' k' j' l' : ℕ) :
    index4 i k j l + index4 i' k' j' l' =
      index4 (i+i') (k+k') (j+j') (l+l') := by
  ext v
  fin_cases v <;> simp [index4]

theorem index4_recover (m : Fin 4 →₀ ℕ) : index4 (m 0) (m 1) (m 2) (m 3) = m := by
  ext v
  fin_cases v <;> simp

/-- The literal coefficient at the indicated four exponents. -/
def coefficient (F : MvPolynomial (Fin 4) K) (i k j l : ℕ) : K :=
  F.coeff (index4 i k j l)

abbrev Grid (a b : ℕ) := Fin (a+1) × Fin (b+1)

def boxExponent (a b : ℕ) (uv : Grid a b × Grid a b) : Fin 4 →₀ ℕ :=
  index4 uv.1.1.val uv.2.1.val uv.1.2.val uv.2.2.val

theorem boxExponent_injective (a b : ℕ) : Function.Injective (boxExponent a b) := by
  rintro ⟨⟨i,j⟩,⟨k,l⟩⟩ ⟨⟨i',j'⟩,⟨k',l'⟩⟩ h
  obtain ⟨hi,hk,hj,hl⟩ := (index4_eq_iff _ _ _ _ _ _ _ _).mp h
  exact Prod.ext (Prod.ext (Fin.ext hi) (Fin.ext hj)) (Prod.ext (Fin.ext hk) (Fin.ext hl))

/-- Separate degree bounds for the two row variables and two column variables. -/
def Bounded (a b : ℕ) (F : MvPolynomial (Fin 4) K) : Prop :=
  ∀ m ∈ F.support, m 0 ≤ a ∧ m 1 ≤ a ∧ m 2 ≤ b ∧ m 3 ≤ b

/-- Every bounded polynomial expands over the entire finite rectangular box;
terms outside its actual support have coefficient zero. -/
theorem bounded_expansion (a b : ℕ) (F : MvPolynomial (Fin 4) K) (hF : Bounded a b F) :
    F = ∑ uv : Grid a b × Grid a b,
      monomial (boxExponent a b uv) (F.coeff (boxExponent a b uv)) := by
  classical
  let s : Finset (Fin 4 →₀ ℕ) := Finset.univ.image (boxExponent a b)
  have hs : F.support ⊆ s := by
    intro m hm
    obtain ⟨h0,h1,h2,h3⟩ := hF m hm
    apply Finset.mem_image.mpr
    refine ⟨((⟨m 0,Nat.lt_succ_of_le h0⟩,⟨m 2,Nat.lt_succ_of_le h2⟩),
      (⟨m 1,Nat.lt_succ_of_le h1⟩,⟨m 3,Nat.lt_succ_of_le h3⟩)),Finset.mem_univ _,?_⟩
    exact index4_recover m
  calc
    F = ∑ m ∈ F.support, monomial m (F.coeff m) := MvPolynomial.as_sum F
    _ = ∑ m ∈ s, monomial m (F.coeff m) := by
      apply Finset.sum_subset hs
      intro m _ hm
      rw [MvPolynomial.notMem_support_iff.mp hm,monomial_zero]
    _ = _ := by
      exact Finset.sum_image (fun x _ y _ h => boxExponent_injective a b h)

/-- Set S=U while retaining T and V. -/
def mergeVariables : Fin 4 → Fin 3 := ![0,1,0,2]

theorem merge_index4 (i k j l : ℕ) :
    (index4 i k j l).mapDomain mergeVariables = index3 (i+j) k l := by
  simp only [index4,Finsupp.mapDomain_add,Finsupp.mapDomain_single,mergeVariables,
    Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_two,Matrix.cons_val_three,
    index3,Finsupp.single_add]
  change Finsupp.single 0 i + Finsupp.single 1 k + Finsupp.single 0 j +
    Finsupp.single 2 l =
    Finsupp.single 0 i + Finsupp.single 0 j + Finsupp.single 1 k + Finsupp.single 2 l
  ac_rfl

/-- Exact coefficient interpretation of every antidiagonal parameter product. -/
theorem merge_coefficient (a b : ℕ) (F : MvPolynomial (Fin 4) K) (hF : Bounded a b F)
    (s : ℕ) (v : Grid a b) :
    (rename mergeVariables F).coeff (index3 s v.1.val v.2.val) =
      ∑ u : Grid a b, if u.1.val + u.2.val = s then
        coefficient F u.1.val v.1.val u.2.val v.2.val else 0 := by
  classical
  conv_lhs => rw [bounded_expansion a b F hF]
  rw [map_sum,coeff_sum,Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro u _
  have hterm (w : Grid a b) :
      (rename mergeVariables
        (monomial (boxExponent a b (u,w)) (F.coeff (boxExponent a b (u,w))))).coeff
          (index3 s v.1.val v.2.val) =
        if w = v then (if u.1.val + u.2.val = s then
          coefficient F u.1.val v.1.val u.2.val v.2.val else 0) else 0 := by
    simp only [rename_monomial,boxExponent,merge_index4,coeff_monomial,index3_eq_iff]
    by_cases hw : w = v
    · subst w
      simp [coefficient]
    · have hne : ¬ (w.1.val = v.1.val ∧ w.2.val = v.2.val) := by
        rintro ⟨h1,h2⟩
        exact hw (Prod.ext (Fin.ext h1) (Fin.ext h2))
      simp only [if_neg hw]
      rw [if_neg (fun h => hne h.2)]
  simp only [hterm,Finset.sum_ite_eq',Finset.mem_univ,if_true]

/-- Consequently every separately symmetric bounded dual polynomial divisible
by S-U annihilates the complete rank-parameter product space. -/
theorem antidiagonal_sum_zero (a b : ℕ) (F : MvPolynomial (Fin 4) K)
    (hF : Bounded a b F) (hz : rename mergeVariables F = 0) (s : ℕ) (v : Grid a b) :
    (∑ u : Grid a b, if u.1.val + u.2.val = s then
      coefficient F u.1.val v.1.val u.2.val v.2.val else 0) = 0 := by
  rw [← merge_coefficient a b F hF s v,hz]
  rfl

/-- The universal separately symmetric factor forcing all rank-sum equations. -/
noncomputable def resultantFactor : MvPolynomial (Fin 4) K :=
  (X 0-X 2) * (X 0-X 3) * (X 1-X 2) * (X 1-X 3)

@[simp] theorem merge_resultantFactor : rename mergeVariables (resultantFactor (K := K)) = 0 := by
  simp [resultantFactor,mergeVariables]

/-- Orbit sum of one monomial under transposition, counted once on the diagonal.
The diagonal convention is essential in characteristic two. -/
noncomputable def symmetricMonomial (x y : Fin 4) (p q : ℕ) : MvPolynomial (Fin 4) K :=
  if p = q then X x ^ p * X y ^ q else X x ^ p * X y ^ q + X x ^ q * X y ^ p

/-- The a-1 functionals separating x02*x_ib for every positive i<a. -/
noncomputable def interiorDual (b i : ℕ) : MvPolynomial (Fin 4) K :=
  resultantFactor * symmetricMonomial 0 1 0 (i-1) * symmetricMonomial 2 3 1 (b-2)

/-- The additional functional separating x02*x_0b. -/
noncomputable def boundaryDual (b : ℕ) : MvPolynomial (Fin 4) K :=
  resultantFactor * symmetricMonomial 2 3 0 (b-2)

@[simp] theorem merge_interiorDual (b i : ℕ) :
    rename mergeVariables (interiorDual (K := K) b i) = 0 := by
  simp only [interiorDual,map_mul,merge_resultantFactor,zero_mul]

@[simp] theorem merge_boundaryDual (b : ℕ) :
    rename mergeVariables (boundaryDual (K := K) b) = 0 := by
  simp only [boundaryDual,map_mul,merge_resultantFactor,zero_mul]


/-- Transposing the row slots, or the column slots, preserves the coefficients. -/
def SeparatelySymmetric (F : MvPolynomial (Fin 4) K) : Prop :=
  (∀ i k j l, coefficient F i k j l = coefficient F k i j l) ∧
  (∀ i k j l, coefficient F i k j l = coefficient F i k l j)

def rowSwap : Equiv.Perm (Fin 4) := Equiv.swap 0 1
def columnSwap : Equiv.Perm (Fin 4) := Equiv.swap 2 3

theorem rowSwap_index4 (i k j l : ℕ) :
    (index4 i k j l).mapDomain rowSwap = index4 k i j l := by
  simp only [index4,Finsupp.mapDomain_add,Finsupp.mapDomain_single]
  norm_num [rowSwap,Equiv.swap_apply_def]
  ac_rfl

theorem columnSwap_index4 (i k j l : ℕ) :
    (index4 i k j l).mapDomain columnSwap = index4 i k l j := by
  simp only [index4,Finsupp.mapDomain_add,Finsupp.mapDomain_single]
  norm_num [columnSwap,Equiv.swap_apply_def]
  ac_rfl

theorem symmetric_of_renames (F : MvPolynomial (Fin 4) K)
    (hr : rename rowSwap F = F) (hc : rename columnSwap F = F) : SeparatelySymmetric F := by
  constructor
  · intro i k j l
    have h := coeff_rename_mapDomain rowSwap rowSwap.injective F (index4 i k j l)
    rw [hr,rowSwap_index4] at h
    exact h.symm
  · intro i k j l
    have h := coeff_rename_mapDomain columnSwap columnSwap.injective F (index4 i k j l)
    rw [hc,columnSwap_index4] at h
    exact h.symm

theorem symmetricMonomial_swap (x y : Fin 4) (p q : ℕ) :
    symmetricMonomial (K := K) y x p q = symmetricMonomial x y p q := by
  by_cases h : p = q
  · subst q
    simp only [symmetricMonomial,if_pos rfl]
    ring
  · simp only [symmetricMonomial,if_neg h]
    ring

theorem rename_symmetricMonomial (e : Fin 4 → Fin 4) (x y : Fin 4) (p q : ℕ) :
    rename e (symmetricMonomial (K := K) x y p q) = symmetricMonomial (e x) (e y) p q := by
  by_cases h : p = q <;> simp [symmetricMonomial,h]

@[simp] theorem rowSwap_resultantFactor : rename rowSwap (resultantFactor (K := K)) =
    resultantFactor := by
  simp only [resultantFactor,map_mul,map_sub,rename_X]
  norm_num [rowSwap,Equiv.swap_apply_def]
  ring

@[simp] theorem columnSwap_resultantFactor : rename columnSwap (resultantFactor (K := K)) =
    resultantFactor := by
  simp only [resultantFactor,map_mul,map_sub,rename_X]
  norm_num [columnSwap,Equiv.swap_apply_def]
  ring

theorem interiorDual_symmetric (b i : ℕ) : SeparatelySymmetric (interiorDual (K := K) b i) := by
  apply symmetric_of_renames
  · simp only [interiorDual,map_mul,rowSwap_resultantFactor,rename_symmetricMonomial]
    norm_num [rowSwap,Equiv.swap_apply_def]
    rw [symmetricMonomial_swap (K := K) 0 1 0 (i-1)]
  · simp only [interiorDual,map_mul,columnSwap_resultantFactor,rename_symmetricMonomial]
    norm_num [columnSwap,Equiv.swap_apply_def]
    rw [symmetricMonomial_swap (K := K) 2 3 1 (b-2)]

theorem boundaryDual_symmetric (b : ℕ) : SeparatelySymmetric (boundaryDual (K := K) b) := by
  apply symmetric_of_renames
  · simp only [boundaryDual,map_mul,rowSwap_resultantFactor,rename_symmetricMonomial]
    norm_num [rowSwap,Equiv.swap_apply_def]
  · simp only [boundaryDual,map_mul,columnSwap_resultantFactor,rename_symmetricMonomial]
    norm_num [columnSwap,Equiv.swap_apply_def]
    rw [symmetricMonomial_swap (K := K) 2 3 0 (b-2)]

noncomputable def monomial4 (i k j l : ℕ) : MvPolynomial (Fin 4) K :=
  monomial (index4 i k j l) 1

@[simp] theorem monomial4_mul (i k j l i' k' j' l' : ℕ) :
    monomial4 (K := K) i k j l * monomial4 i' k' j' l' =
      monomial4 (i+i') (k+k') (j+j') (l+l') := by
  simp only [monomial4,monomial_mul_monomial,one_mul,index4_add]

@[simp] theorem coefficient_monomial4 (i k j l i' k' j' l' : ℕ) :
    coefficient (monomial4 (K := K) i k j l) i' k' j' l' =
      if i = i' ∧ k = k' ∧ j = j' ∧ l = l' then 1 else 0 := by
  simp only [coefficient,monomial4,coeff_monomial,index4_eq_iff]

theorem row_symmetricMonomial (p q : ℕ) : symmetricMonomial (K := K) 0 1 p q =
    if p = q then monomial4 p q 0 0 else monomial4 p q 0 0 + monomial4 q p 0 0 := by
  simp only [symmetricMonomial,X_pow_eq_monomial,monomial_mul_monomial,one_mul,
    monomial4,index4,Finsupp.single_zero,add_zero]

theorem column_symmetricMonomial (p q : ℕ) : symmetricMonomial (K := K) 2 3 p q =
    if p = q then monomial4 0 0 p q else monomial4 0 0 p q + monomial4 0 0 q p := by
  simp only [symmetricMonomial,X_pow_eq_monomial,monomial_mul_monomial,one_mul,
    monomial4,index4,Finsupp.single_zero,zero_add]

section DegreeBounds

variable [Nontrivial K]

theorem resultantFactor_degree (v : Fin 4) : (resultantFactor (K := K)).degreeOf v ≤ 2 := by
  have h02 := degreeOf_sub_le v (X 0 : MvPolynomial (Fin 4) K) (X 2)
  have h03 := degreeOf_sub_le v (X 0 : MvPolynomial (Fin 4) K) (X 3)
  have h12 := degreeOf_sub_le v (X 1 : MvPolynomial (Fin 4) K) (X 2)
  have h13 := degreeOf_sub_le v (X 1 : MvPolynomial (Fin 4) K) (X 3)
  have hA := degreeOf_mul_le v (X 0-X 2 : MvPolynomial (Fin 4) K) (X 0-X 3)
  have hB := degreeOf_mul_le v ((X 0-X 2)*(X 0-X 3) : MvPolynomial (Fin 4) K) (X 1-X 2)
  have hC := degreeOf_mul_le v (((X 0-X 2)*(X 0-X 3))*(X 1-X 2) : MvPolynomial (Fin 4) K) (X 1-X 3)
  change (((X 0-X 2)*(X 0-X 3))*(X 1-X 2)*(X 1-X 3) : MvPolynomial (Fin 4) K).degreeOf v ≤ 2
  have h := hC.trans (Nat.add_le_add
    (hB.trans (Nat.add_le_add (hA.trans (Nat.add_le_add h02 h03)) h12)) h13)
  fin_cases v <;> simpa [degreeOf_X] using h

theorem row_symmetricMonomial_degree (p q : ℕ) (v : Fin 4) :
    (symmetricMonomial (K := K) 0 1 p q).degreeOf v ≤ ![max p q,max p q,0,0] v := by
  rw [row_symmetricMonomial]
  split_ifs with h
  · simp only [monomial4,degreeOf_monomial_eq _ _ one_ne_zero]
    fin_cases v <;> simp
  · have hdeg := degreeOf_add_le v (monomial4 (K := K) p q 0 0) (monomial4 q p 0 0)
    simp only [monomial4,degreeOf_monomial_eq _ _ one_ne_zero] at hdeg
    fin_cases v <;> simpa [monomial4,max_comm] using hdeg

theorem column_symmetricMonomial_degree (p q : ℕ) (v : Fin 4) :
    (symmetricMonomial (K := K) 2 3 p q).degreeOf v ≤ ![0,0,max p q,max p q] v := by
  rw [column_symmetricMonomial]
  split_ifs with h
  · simp only [monomial4,degreeOf_monomial_eq _ _ one_ne_zero]
    fin_cases v <;> simp
  · have hdeg := degreeOf_add_le v (monomial4 (K := K) 0 0 p q) (monomial4 0 0 q p)
    simp only [monomial4,degreeOf_monomial_eq _ _ one_ne_zero] at hdeg
    fin_cases v <;> simpa [monomial4,max_comm] using hdeg

theorem bounded_of_degree (a b : ℕ) (F : MvPolynomial (Fin 4) K)
    (h : ∀ v, F.degreeOf v ≤ ![a,a,b,b] v) : Bounded a b F := by
  intro m hm
  exact ⟨(le_degreeOf_of_mem_support 0 hm).trans (h 0),
    (le_degreeOf_of_mem_support 1 hm).trans (h 1),
    (le_degreeOf_of_mem_support 2 hm).trans (h 2),
    (le_degreeOf_of_mem_support 3 hm).trans (h 3)⟩

theorem interiorDual_bounded (a b i : ℕ) (hi : 1 ≤ i) (hia : i < a) (hb : 3 ≤ b) :
    Bounded a b (interiorDual (K := K) b i) := by
  apply bounded_of_degree
  intro v
  have hP := resultantFactor_degree (K := K) v
  have hR := row_symmetricMonomial_degree (K := K) 0 (i-1) v
  have hC := column_symmetricMonomial_degree (K := K) 1 (b-2) v
  have hbmax : max 1 (b-2) = b-2 := max_eq_right (by omega)
  rw [hbmax] at hC
  have hPR := degreeOf_mul_le v (resultantFactor (K := K)) (symmetricMonomial 0 1 0 (i-1))
  have hF := degreeOf_mul_le v
    (resultantFactor (K := K)*symmetricMonomial 0 1 0 (i-1)) (symmetricMonomial 2 3 1 (b-2))
  change (resultantFactor (K := K)*symmetricMonomial 0 1 0 (i-1)*
    symmetricMonomial 2 3 1 (b-2)).degreeOf v ≤ _
  have h := hF.trans (Nat.add_le_add
    (hPR.trans (Nat.add_le_add hP hR)) hC)
  fin_cases v <;> norm_num at h ⊢ <;> omega

theorem boundaryDual_bounded (a b : ℕ) (ha : 2 ≤ a) (hb : 3 ≤ b) :
    Bounded a b (boundaryDual (K := K) b) := by
  apply bounded_of_degree
  intro v
  have hP := resultantFactor_degree (K := K) v
  have hC := column_symmetricMonomial_degree (K := K) 0 (b-2) v
  have hF := degreeOf_mul_le v (resultantFactor (K := K)) (symmetricMonomial 2 3 0 (b-2))
  change (resultantFactor (K := K)*symmetricMonomial 2 3 0 (b-2)).degreeOf v ≤ _
  have h := hF.trans (Nat.add_le_add hP hC)
  fin_cases v <;> norm_num at h ⊢ <;> omega

end DegreeBounds


@[simp] theorem coefficient_add (F G : MvPolynomial (Fin 4) K) (i k j l : ℕ) :
    coefficient (F+G) i k j l = coefficient F i k j l + coefficient G i k j l := by
  simp only [coefficient,MvPolynomial.coeff_add]

@[simp] theorem coefficient_sub (F G : MvPolynomial (Fin 4) K) (i k j l : ℕ) :
    coefficient (F-G) i k j l = coefficient F i k j l - coefficient G i k j l := by
  simp only [coefficient,MvPolynomial.coeff_sub]

theorem monomial4_eq (i k j l : ℕ) : monomial4 (K := K) i k j l =
    X 0 ^ i * X 1 ^ k * X 2 ^ j * X 3 ^ l := by
  simp only [monomial4,index4,monomial_add_single,← X_pow_eq_monomial]

/-- Integral expansion; the repeated middle monomial is retained twice rather
than divided by any scalar. -/
theorem resultantFactor_expansion : resultantFactor (K := K) =
    monomial4 2 2 0 0 - monomial4 2 1 1 0 - monomial4 2 1 0 1 + monomial4 2 0 1 1 -
    monomial4 1 2 1 0 - monomial4 1 2 0 1 + monomial4 1 1 2 0 + monomial4 1 1 1 1 +
    monomial4 1 1 1 1 + monomial4 1 1 0 2 - monomial4 1 0 2 1 - monomial4 1 0 1 2 +
    monomial4 0 2 1 1 - monomial4 0 1 2 1 - monomial4 0 1 1 2 + monomial4 0 0 2 2 := by
  simp only [resultantFactor,monomial4_eq,pow_zero,pow_one,mul_one]
  ring

/-- All four-variable coefficient calculations needed by the induction reduce
to the four terms with zero first row exponent. -/
theorem coefficient_factor_monomial_zero (p q r s k j l : ℕ) :
    coefficient (resultantFactor (K := K)*monomial4 p q r s) 0 k j l =
      if p = 0 then
        (if q+2=k ∧ r+1=j ∧ s+1=l then 1 else 0) -
        (if q+1=k ∧ r+2=j ∧ s+1=l then 1 else 0) -
        (if q+1=k ∧ r+1=j ∧ s+2=l then 1 else 0) +
        (if q=k ∧ r+2=j ∧ s+2=l then 1 else 0)
      else 0 := by
  rw [resultantFactor_expansion]
  simp only [add_mul,sub_mul,monomial4_mul,coefficient_add,coefficient_sub,
    coefficient_monomial4]
  by_cases hp : p=0
  · subst p
    simp [Nat.add_comm]
  · simp [hp,Nat.add_comm]

/-- The positive last-column products have a diagonal dual evaluation matrix
with unit entries, for every row count and every b≥3. -/
theorem interiorDual_last_column (b i r : ℕ) (hb : 3 ≤ b) (hi : 1 ≤ i) :
    coefficient (interiorDual (K := K) b i) 0 r 2 b = if r=i then -1 else 0 := by
  have hb1 : b-2+1 ≠ b := by omega
  have hb2 : b-2+2 = b := by omega
  have hbne2 : (2 : ℕ) ≠ b := by omega
  have hi1 : i-1+1 = i := by omega
  have hmain : coefficient
      (resultantFactor (K := K) * monomial4 0 (i-1) 1 (b-2)) 0 r 2 b =
      if r=i then -1 else 0 := by
    rw [coefficient_factor_monomial_zero]
    by_cases hr : r=i
    · subst r
      simp [hb1,hb2,hi1]
    · simp [hb1,hb2,hi1,hr,Ne.symm hr]
  have hother (hc : ¬ 1=b-2) : coefficient
      (resultantFactor (K := K) * monomial4 0 (i-1) (b-2) 1) 0 r 2 b = 0 := by
    have hbne3 : (3 : ℕ) ≠ b := by omega
    rw [coefficient_factor_monomial_zero]
    simp [hbne2,hbne3]
  have hrowZero (hr : ¬ 0=i-1) (p q : ℕ) : coefficient
      (resultantFactor (K := K) * monomial4 (i-1) 0 p q) 0 r 2 b = 0 := by
    rw [coefficient_factor_monomial_zero,if_neg (Ne.symm hr)]
  rw [interiorDual,row_symmetricMonomial,column_symmetricMonomial]
  by_cases hrow : 0=i-1
  · by_cases hcol : 1=b-2
    · simp only [if_pos hrow,if_pos hcol,mul_assoc,monomial4_mul,
        Nat.zero_add,Nat.add_zero,hmain]
    · simp only [if_pos hrow,if_neg hcol,mul_add,add_mul,mul_assoc,
        monomial4_mul,Nat.zero_add,Nat.add_zero,coefficient_add,
        hmain,hother hcol,add_zero]
  · by_cases hcol : 1=b-2
    · simp only [if_neg hrow,if_pos hcol,mul_add,add_mul,mul_assoc,
        monomial4_mul,Nat.zero_add,Nat.add_zero,coefficient_add,
        hmain,hrowZero hrow,add_zero]
    · simp only [if_neg hrow,if_neg hcol,mul_add,add_mul,mul_assoc,
        monomial4_mul,Nat.zero_add,Nat.add_zero,coefficient_add,
        hmain,hother hcol,hrowZero hrow,add_zero]

/-- The remaining last-column product is separated by the boundary dual. -/
theorem boundaryDual_last_column (b r : ℕ) (hb : 3 ≤ b) :
    coefficient (boundaryDual (K := K) b) 0 r 2 b = if r=0 then 1 else 0 := by
  have hb0 : ¬ 0=b-2 := by omega
  have hb1 : b-2+1 ≠ b := by omega
  have hb2 : b-2+2 = b := by omega
  have hbne1 : (1 : ℕ) ≠ b := by omega
  have hbne2 : (2 : ℕ) ≠ b := by omega
  rw [boundaryDual,column_symmetricMonomial]
  simp [hb0,mul_add,coefficient_add,coefficient_factor_monomial_zero,
    hb1,hb2,hbne1,hbne2,eq_comm]

/-- Package the a functionals in the order of all a last-column generators. -/
noncomputable def columnDual (b : ℕ) (i : ℕ) : MvPolynomial (Fin 4) K :=
  if i=0 then boundaryDual b else -interiorDual b i

theorem columnDual_last_column (b i r : ℕ) (hb : 3 ≤ b) :
    coefficient (columnDual (K := K) b i) 0 r 2 b = if r=i then 1 else 0 := by
  by_cases hi : i=0
  · subst i
    simpa only [columnDual,ite_true] using boundaryDual_last_column (K := K) b r hb
  · rw [columnDual,if_neg hi]
    change -(coefficient (interiorDual (K := K) b i) 0 r 2 b) = _
    rw [interiorDual_last_column b i r hb (by omega)]
    split_ifs <;> simp

theorem columnDual_merge (b i : ℕ) : rename mergeVariables (columnDual (K := K) b i) = 0 := by
  by_cases hi : i=0 <;> simp [columnDual,hi]

theorem columnDual_symmetric (b i : ℕ) : SeparatelySymmetric (columnDual (K := K) b i) := by
  by_cases hi : i=0
  · simp only [columnDual,if_pos hi]
    exact boundaryDual_symmetric b
  · rw [columnDual,if_neg hi]
    obtain ⟨hr,hc⟩ := interiorDual_symmetric (K := K) b i
    constructor
    · intro i' k j l
      simpa only [coefficient,MvPolynomial.coeff_neg] using congrArg Neg.neg (hr i' k j l)
    · intro i' k j l
      simpa only [coefficient,MvPolynomial.coeff_neg] using congrArg Neg.neg (hc i' k j l)

theorem columnDual_bounded [Nontrivial K] (a b : ℕ) (i : Fin a)
    (ha : 2 ≤ a) (hb : 3 ≤ b) : Bounded a b (columnDual (K := K) b i.val) := by
  by_cases hi : i.val=0
  · rw [columnDual,if_pos hi]
    exact boundaryDual_bounded a b ha hb
  · rw [columnDual,if_neg hi]
    intro m hm
    apply interiorDual_bounded (K := K) a b i.val (by omega) i.isLt hb m
    simpa only [support_neg] using hm

end PaperVerification.Segre.TwoFactorDualPolynomial
end
end
end ProbeLayer82

section ProbeLayer83



/-!
# Last-column dual functionals in the literal Segre quotient

The bounded symmetric coefficient polynomials act on the independently proved
full sorted quadratic basis. Their antidiagonal identities annihilate every
quadratic parameter relation, including relations arising from arbitrary
higher-degree ideal expressions, by balanced homogeneous projection. The unit
evaluations therefore prove independence in the literal quotient ring.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorDualFunctionals

open Staircase Monomials Balanced RankParameters Artinian TwoFactorActual
open TwoFactorDualPolynomial

variable {K : Type*} [Field K]

/-- A literal product of two rectangular Segre coordinate polynomials. -/
noncomputable def coordinatePair (a b : ℕ) (u v : Grid a b) :
    degreeTwo (K := K) (n := shape a b) :=
  ⟨cellPolynomial (cell a b u.1 u.2) * cellPolynomial (cell a b v.1 v.2),
    Submodule.subset_span (Set.mem_range_self (cell a b u.1 u.2,cell a b v.1 v.2))⟩

noncomputable def functional (a b : ℕ) (F : MvPolynomial (Fin 4) K) :
    degreeTwo (K := K) (n := shape a b) →ₗ[K] K :=
  (degreeTwoBasis (K := K) (n := shape a b)).constr K (fun q =>
    coefficient F (q.val.1 0).val (q.val.2 0).val (q.val.1 1).val (q.val.2 1).val)

theorem coefficient_min_max (F : MvPolynomial (Fin 4) K) (hF : SeparatelySymmetric F)
    (i k j l : ℕ) :
    coefficient F (min i k) (max i k) (min j l) (max j l) = coefficient F i k j l := by
  by_cases hik : i ≤ k <;> by_cases hjl : j ≤ l
  · simp only [min_eq_left hik,max_eq_right hik,min_eq_left hjl,max_eq_right hjl]
  · simp only [min_eq_left hik,max_eq_right hik,min_eq_right (le_of_not_ge hjl),
      max_eq_left (le_of_not_ge hjl)]
    exact (hF.2 i k j l).symm
  · simp only [min_eq_right (le_of_not_ge hik),max_eq_left (le_of_not_ge hik),
      min_eq_left hjl,max_eq_right hjl]
    exact (hF.1 i k j l).symm
  · simp only [min_eq_right (le_of_not_ge hik),max_eq_left (le_of_not_ge hik),
      min_eq_right (le_of_not_ge hjl),max_eq_left (le_of_not_ge hjl)]
    exact (hF.1 k i l j).trans ((hF.2 i k j l).symm)

/-- Sorting does not change a separately symmetric quadratic coefficient. -/
theorem functional_coordinatePair (a b : ℕ) (F : MvPolynomial (Fin 4) K)
    (hF : SeparatelySymmetric F) (u v : Grid a b) :
    functional a b F (coordinatePair a b u v) =
      coefficient F u.1.val v.1.val u.2.val v.2.val := by
  let x := cell a b u.1 u.2
  let y := cell a b v.1 v.2
  let q : SortedPair (shape a b) := ⟨(meet x y,join x y),fun _ => min_le_max⟩
  have he : coordinatePair (K := K) a b u v = degreeTwoBasis (K := K) q := by
    apply Subtype.ext
    change cellPolynomial x * cellPolynomial y = _
    rw [cellPolynomial_mul_sort]
    simp only [degreeTwoBasis,Module.Basis.map_apply,LinearEquiv.coe_ofEq_apply,
      Module.Basis.coe_span_apply,sortedMonomial_eq_mul,q]
  rw [he,functional,Module.Basis.constr_basis]
  change coefficient F (min u.1.val v.1.val) (max u.1.val v.1.val)
    (min u.2.val v.2.val) (max u.2.val v.2.val) = _
  exact coefficient_min_max F hF _ _ _ _

/-- The entire product of one actual antidiagonal parameter with one variable. -/
noncomputable def rankPair (a b : ℕ) (r : Ranks (shape a b)) (v : Grid a b) :
    degreeTwo (K := K) (n := shape a b) :=
  ∑ u : Grid a b, if u.1.val+u.2.val=r.val then coordinatePair a b u v else 0

theorem rankPair_value (a b : ℕ) (r : Ranks (shape a b)) (v : Grid a b) :
    (rankPair (K := K) a b r v).val =
      (rankParameter (K := K) r).val * cellPolynomial (cell a b v.1 v.2) := by
  have hθ := rankParameter_value (K := K) r
  rw [← Equiv.sum_comp (cellEquiv a b)] at hθ
  simp only [cellEquiv_apply,rank_cell] at hθ
  rw [hθ]
  change (degreeTwo (K := K) (n := shape a b)).subtype
    (∑ u : Grid a b, if u.1.val+u.2.val=r.val then coordinatePair a b u v else 0) = _
  rw [map_sum,Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro u _
  split_ifs
  · rfl
  · simp only [map_zero,zero_mul]

theorem functional_rankPair (a b : ℕ) (F : MvPolynomial (Fin 4) K)
    (hs : SeparatelySymmetric F) (hb : Bounded a b F)
    (hz : MvPolynomial.rename mergeVariables F = 0)
    (r : Ranks (shape a b)) (v : Grid a b) : functional a b F (rankPair a b r v) = 0 := by
  simp only [rankPair,map_sum,apply_ite,map_zero,functional_coordinatePair a b F hs]
  exact antidiagonal_sum_zero a b F hb hz r.val v

noncomputable def liftTwo (a b : ℕ) : degreeTwo (K := K) (n := shape a b) →ₗ[K]
    segreAlgebra (K := K) (n := shape a b) where
  toFun f := ⟨f.val,balancedComponent_le_segreAlgebra 2
    ((le_of_eq (degreeTwo_eq_balanced (K := K) (n := shape a b))) f.property)⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- This is the literal quotient map, without a newly presented substitute ring. -/
noncomputable def quotientTwo (a b : ℕ) : degreeTwo (K := K) (n := shape a b) →ₗ[K]
    Artinian.Reduction (K := K) (n := shape a b) :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (rankParameter (K := K) (n := shape a b)))).toLinearMap.comp
    (liftTwo (K := K) a b)

theorem quotientTwo_coordinatePair (a b : ℕ) (u v : Grid a b) :
    quotientTwo (K := K) a b (coordinatePair a b u v) =
      «variable» a b u.1 u.2 * «variable» a b v.1 v.2 := by
  let π := Ideal.Quotient.mkₐ K (parameterIdeal (rankParameter (K := K) (n := shape a b)))
  have he : liftTwo (K := K) a b (coordinatePair a b u v) =
      coordinate (cell a b u.1 u.2) * coordinate (cell a b v.1 v.2) := Subtype.ext rfl
  change π (liftTwo (K := K) a b (coordinatePair a b u v)) = _
  rw [he,map_mul]
  rfl

theorem degreeOneBasis_value (a b : ℕ) (u : Cell (shape a b)) :
    (degreeOneBasis (K := K) u).val = cellPolynomial u :=
  Module.Basis.coe_span_apply _ _

/-- The whole degree-one polynomial, not a selected list of residue variables,
expands in the rectangular coordinate basis. -/
theorem one_expansion (a b : ℕ) (f : degreeOne (K := K) (n := shape a b)) :
    (∑ u : Grid a b, (degreeOneBasis (K := K)).repr f (cell a b u.1 u.2) •
      cellPolynomial (cell a b u.1 u.2)) = f.val := by
  have he := congrArg Subtype.val ((degreeOneBasis (K := K) (n := shape a b)).sum_repr f)
  change (degreeOne (K := K) (n := shape a b)).subtype
    (∑ u, (degreeOneBasis (K := K)).repr f u • degreeOneBasis u) = f.val at he
  rw [map_sum] at he
  simp only [map_smul,Submodule.subtype_apply,degreeOneBasis_value] at he
  rw [← Equiv.sum_comp (cellEquiv a b)] at he
  simpa only [cellEquiv_apply] using he

/-- Every quadratic relation in the actual quotient is annihilated. The proof
projects arbitrary ideal multipliers to balanced degree one before evaluating;
no degree truncation is assumed in the definition of the quotient. -/
theorem functional_zero_of_quotientTwo_zero (a b : ℕ) (F : MvPolynomial (Fin 4) K)
    (hs : SeparatelySymmetric F) (hb : Bounded a b F)
    (hz : MvPolynomial.rename mergeVariables F = 0)
    (f : degreeTwo (K := K) (n := shape a b)) (hf : quotientTwo (K := K) a b f = 0) :
    functional a b F f = 0 := by
  have hmem : liftTwo (K := K) a b f ∈ parameterIdeal (rankParameter (K := K) (n := shape a b)) := by
    exact Ideal.Quotient.eq_zero_iff_mem.mp hf
  have hamb := mem_ambient_of_mem_parameterIdeal _ hmem
  have hhom : f.val.IsWeightedHomogeneous (factorWeight (n := shape a b)) (diagonalDegree 2) :=
    (le_of_eq (degreeTwo_eq_balanced (K := K) (n := shape a b))) f.property
  obtain ⟨c,hc,he⟩ := homogeneous_ideal_representation
    (fun r : Ranks (shape a b) => (rankParameter (K := K) r).val)
    rankParameter_homogeneous 1 f.val hhom hamb
  let g : Ranks (shape a b) → degreeOne (K := K) (n := shape a b) := fun r =>
    ⟨c r,(le_of_eq (degreeOne_eq_balanced (K := K) (n := shape a b)).symm) (hc r)⟩
  let z : Ranks (shape a b) → Grid a b → K := fun r u =>
    (degreeOneBasis (K := K)).repr (g r) (cell a b u.1 u.2)
  have hexpand (r : Ranks (shape a b)) :
      (∑ u : Grid a b, z r u • cellPolynomial (cell a b u.1 u.2)) = c r :=
    one_expansion a b (g r)
  have hsum : (∑ r, ∑ v : Grid a b, z r v • rankPair (K := K) a b r v) = f := by
    apply Subtype.ext
    change (degreeTwo (K := K) (n := shape a b)).subtype
      (∑ r, ∑ v : Grid a b, z r v • rankPair a b r v) = f.val
    simp only [map_sum,map_smul,Submodule.subtype_apply,rankPair_value]
    calc
      _ = ∑ r, (rankParameter (K := K) r).val *
          (∑ v : Grid a b, z r v • cellPolynomial (cell a b v.1 v.2)) := by
        simp only [Finset.mul_sum,mul_smul_comm]
      _ = ∑ r, (rankParameter (K := K) r).val * c r := by simp only [hexpand]
      _ = f.val := by simpa only [mul_comm] using he
  rw [← hsum,map_sum]
  apply Finset.sum_eq_zero
  intro r _
  simp only [map_sum,map_smul,functional_rankPair a b F hs hb hz,smul_zero,Finset.sum_const_zero]

/-- The literal last-column products with x02, indexed by every row i<a. -/
noncomputable def lastColumnProducts (a b : ℕ) (hb : 3 ≤ b) (i : Fin a) :
    Artinian.Reduction (K := K) (n := shape a b) :=
  «variable» a b 0 ⟨2,by omega⟩ * «variable» a b i.castSucc (Fin.last b)

/-- The decisive unrestricted statement in Lemma3.2: all a last-column
products are linearly independent in the actual Artinian quotient, over every
field and with no upper bound on either chain length. -/
theorem lastColumnProducts_linearIndependent (a b : ℕ) (ha : 2 ≤ a) (hb : 3 ≤ b) :
    LinearIndependent K (lastColumnProducts (K := K) a b hb) := by
  classical
  apply Fintype.linearIndependent_iff.mpr
  intro c hc i
  let u : Grid a b := (0,⟨2,by omega⟩)
  let v : Fin a → Grid a b := fun j => (j.castSucc,Fin.last b)
  let f : degreeTwo (K := K) (n := shape a b) := ∑ j, c j • coordinatePair a b u (v j)
  have hf : quotientTwo (K := K) a b f = 0 := by
    simpa only [f,map_sum,map_smul,quotientTwo_coordinatePair,u,v,lastColumnProducts] using hc
  have hzero := functional_zero_of_quotientTwo_zero a b (columnDual (K := K) b i.val)
    (columnDual_symmetric b i.val) (columnDual_bounded a b i ha hb)
    (columnDual_merge b i.val) f hf
  have heval (j : Fin a) : functional a b (columnDual (K := K) b i.val)
      (coordinatePair a b u (v j)) = if j=i then 1 else 0 := by
    rw [functional_coordinatePair a b _ (columnDual_symmetric b i.val)]
    change coefficient (columnDual (K := K) b i.val) 0 j.val 2 b = _
    rw [columnDual_last_column b i.val j.val hb]
    simp only [Fin.ext_iff]
  change functional a b (columnDual (K := K) b i.val)
    (∑ j, c j • coordinatePair a b u (v j)) = 0 at hzero
  simpa only [map_sum,map_smul,heval,smul_ite,smul_eq_mul,mul_ite,mul_one,mul_zero,Finset.sum_ite_eq',Finset.mem_univ,if_true] using hzero

end PaperVerification.Segre.TwoFactorDualFunctionals
end
end ProbeLayer83

section ProbeLayer84



/-!
# Simultaneous injectivity in finite-dimensional linear families

Two linear families of maps, with the same parameter space but unrelated
domains and codomains, have a common injective member whenever each has one.
The proof uses nonzero minors of the actual matrices in finite bases. This is
the genericity step in last-column propagation for two-factor Segre rings.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericLinearFamilies

open Module

variable {K P M N U V : Type*} [Field K]
  [AddCommGroup P] [Module K P] [Module.Finite K P]
  [AddCommGroup M] [Module K M] [Module.Finite K M]
  [AddCommGroup N] [Module K N] [Module.Finite K N]
  [AddCommGroup U] [Module K U] [Module.Finite K U]
  [AddCommGroup V] [Module K V] [Module.Finite K V]

noncomputable def coordinateMatrix (f : M →ₗ[K] N) :
    Matrix (Fin (finrank K N)) (Fin (finrank K M)) K :=
  LinearMap.toMatrix (finBasis K M) (finBasis K N) f

theorem rank_coordinateMatrix (f : M →ₗ[K] N) :
    (coordinateMatrix f).rank = finrank K (LinearMap.range f) := by
  exact LinearMap.rank_toMatrix f (finBasis K M) (finBasis K N)

theorem injective_iff_full_rank (f : M →ₗ[K] N) :
    Function.Injective f ↔ (coordinateMatrix f).rank = finrank K M := by
  rw [rank_coordinateMatrix]
  constructor
  · exact LinearMap.finrank_range_of_inj
  · intro h
    apply LinearMap.ker_eq_bot.mp
    apply Submodule.finrank_eq_zero.mp
    have he := f.finrank_range_add_finrank_ker
    rw [h] at he
    exact Nat.add_left_cancel (he.trans (Nat.add_zero _).symm)

noncomputable def universalMatrix (F : P →ₗ[K] (M →ₗ[K] N)) :
    Matrix (Fin (finrank K N)) (Fin (finrank K M))
      (MvPolynomial (Fin (finrank K P)) K) :=
  fun i j => ∑ c, MvPolynomial.X c *
    MvPolynomial.C (coordinateMatrix (F (finBasis K P c)) i j)

noncomputable def parameter (a : Fin (finrank K P) → K) : P :=
  ∑ c, a c • finBasis K P c

theorem eval_universalMatrix (F : P →ₗ[K] (M →ₗ[K] N))
    (a : Fin (finrank K P) → K) :
    (universalMatrix F).map (MvPolynomial.eval a) =
      coordinateMatrix (F (parameter a)) := by
  classical
  ext i j
  simp only [Matrix.map_apply, universalMatrix, map_sum, map_mul,
    MvPolynomial.eval_X, MvPolynomial.eval_C, coordinateMatrix, parameter,
    map_smul, Matrix.sum_apply, Matrix.smul_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

theorem parameter_repr (p : P) :
    parameter (fun c => (finBasis K P).repr p c) = p :=
  (finBasis K P).sum_repr p

/-- The exact intersection statement used for propagation. Neither family is
assumed to be injective everywhere or at the other family's witness. -/
theorem exists_common_injective [Infinite K]
    (F : P →ₗ[K] (M →ₗ[K] N)) (G : P →ₗ[K] (U →ₗ[K] V))
    (p q : P) (hp : Function.Injective (F p)) (hq : Function.Injective (G q)) :
    ∃ r : P, Function.Injective (F r) ∧ Function.Injective (G r) := by
  classical
  let a : Fin (finrank K P) → K := fun c => (finBasis K P).repr p c
  let b : Fin (finrank K P) → K := fun c => (finBasis K P).repr q c
  have hF : ((universalMatrix F).map (MvPolynomial.eval a)).rank =
      Fintype.card (Fin (finrank K M)) := by
    rw [eval_universalMatrix]
    change (coordinateMatrix (F (parameter (fun c => (finBasis K P).repr p c)))).rank = _
    rw [parameter_repr, Fintype.card_fin]
    exact (injective_iff_full_rank (F p)).mp hp
  have hG : ((universalMatrix G).map (MvPolynomial.eval b)).rank =
      Fintype.card (Fin (finrank K U)) := by
    rw [eval_universalMatrix]
    change (coordinateMatrix (G (parameter (fun c => (finBasis K P).repr q c)))).rank = _
    rw [parameter_repr, Fintype.card_fin]
    exact (injective_iff_full_rank (G q)).mp hq
  obtain ⟨c, hcF, hcG⟩ := GenericMatrixRank.exists_full_column_rank
    (universalMatrix F) (universalMatrix G) a b hF hG
  rw [eval_universalMatrix, Fintype.card_fin] at hcF hcG
  exact ⟨parameter c, (injective_iff_full_rank _).mpr hcF,
    (injective_iff_full_rank _).mpr hcG⟩

end PaperVerification.Segre.GenericLinearFamilies
end
end ProbeLayer84

section ProbeLayer85



/-!
# Unrestricted last-column propagation in the actual Segre quotient

The restriction to the complete truncation kernel is injective at the explicit
form x02, by the symmetric-polynomial dual functionals. The quotient map is
injective at a lift of any injective smaller Lefschetz form. Nonzero minors
give a common form. The resulting exact-sequence argument takes place in the
literal Artinian rings and their entire first homogeneous components.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1500000

@[expose] public section

namespace PaperVerification.Segre.TwoFactorPropagation

open Staircase Monomials ActualQuotient TwoFactorActual TwoFactorTruncation
open TwoFactorDegreeOne TwoFactorDualFunctionals

variable {K : Type*} [Field K]

noncomputable def lastCombination (a b : ℕ) : (Fin a → K) →ₗ[K]
    Artinian.Reduction (K := K) (n := shape a (b+1)) :=
  Fintype.linearCombination K
    (fun i : Fin a => «variable» (K := K) a (b+1) i.castSucc (Fin.last (b+1)))

set_option maxHeartbeats 1500000 in
noncomputable def restrictionFamily (a b : ℕ) :
    actualDegreeOne (K := K) (n := shape a (b+1)) →ₗ[K]
      ((Fin a → K) →ₗ[K] Artinian.Reduction (K := K) (n := shape a (b+1))) where
  toFun ℓ := (LinearMap.mulLeft K ℓ.val).comp (lastCombination (K := K) a b)
  map_add' x y := by
    apply LinearMap.ext
    intro c
    change (x.val+y.val) * lastCombination a b c =
      x.val * lastCombination a b c + y.val * lastCombination a b c
    exact add_mul _ _ _
  map_smul' c x := by
    apply LinearMap.ext
    intro v
    change (c • x.val) * lastCombination a b v = c • (x.val * lastCombination a b v)
    exact smul_mul_assoc _ _ _

set_option maxHeartbeats 1500000 in
noncomputable def quotientFamily (a b : ℕ) :
    actualDegreeOne (K := K) (n := shape a (b+1)) →ₗ[K]
      (actualDegreeOne (K := K) (n := shape a b) →ₗ[K]
        Artinian.Reduction (K := K) (n := shape a b)) where
  toFun ℓ := (LinearMap.mulLeft K (truncation (K := K) a b ℓ.val)).comp
    (actualDegreeOne (K := K) (n := shape a b)).subtype
  map_add' x y := by
    apply LinearMap.ext
    intro z
    change truncation (K := K) a b (x.val+y.val) * z.val =
      truncation (K := K) a b x.val * z.val + truncation (K := K) a b y.val * z.val
    rw [map_add,add_mul]
  map_smul' c x := by
    apply LinearMap.ext
    intro z
    change truncation (K := K) a b (c • x.val) * z.val = c • (truncation (K := K) a b x.val * z.val)
    rw [map_smul,smul_mul_assoc]

theorem restriction_has_injective_point (a b : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b) :
    ∃ ℓ : actualDegreeOne (K := K) (n := shape a (b+1)),
      Function.Injective (restrictionFamily (K := K) a b ℓ) := by
  classical
  have hb' : 3 ≤ b+1 := by omega
  let ℓ : actualDegreeOne (K := K) (n := shape a (b+1)) :=
    homogeneousResidue (degreeOneBasis (cell a (b+1) 0 ⟨2,by omega⟩))
  refine ⟨ℓ, ?_⟩
  have he : restrictionFamily (K := K) a b ℓ =
      Fintype.linearCombination K (lastColumnProducts (K := K) a (b+1) hb') := by
    apply LinearMap.ext
    intro c
    change oneToReduction (K := K) (n := shape a (b+1))
      (degreeOneBasis (cell a (b+1) 0 ⟨2,by omega⟩)) *
        (∑ i, c i • «variable» (K := K) a (b+1) i.castSucc (Fin.last (b+1))) = _
    rw [oneToReduction_basis]
    change «variable» (K := K) a (b+1) 0 ⟨2,by omega⟩ *
        (∑ i, c i • «variable» (K := K) a (b+1) i.castSucc (Fin.last (b+1))) =
      ∑ i, c i • lastColumnProducts a (b+1) hb' i
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    exact mul_smul_comm _ _ _
  rw [he]
  exact (lastColumnProducts_linearIndependent (K := K) a (b+1) ha hb').fintypeLinearCombination_injective

theorem quotient_has_injective_point (a b : ℕ)
    (ℓ : degreeOne (K := K) (n := shape a b))
    (hℓ : Function.Injective (firstLefschetz ℓ)) :
    ∃ r : actualDegreeOne (K := K) (n := shape a (b+1)),
      Function.Injective (quotientFamily (K := K) a b r) := by
  obtain ⟨q,hq,htr⟩ := truncation_one_surjective a b
    (oneToReduction (K := K) (n := shape a b) ℓ) ⟨ℓ,rfl⟩
  refine ⟨⟨q,hq⟩, ?_⟩
  intro x y hxy
  apply hℓ
  apply Subtype.ext
  change oneToReduction (K := K) (n := shape a b) ℓ * x.val =
    oneToReduction (K := K) (n := shape a b) ℓ * y.val
  change truncation (K := K) a b q * x.val = truncation (K := K) a b q * y.val at hxy
  simpa only [htr] using hxy

/-- Lemma3.2, with its full row and column ranges: injectivity propagates
from (a,b) to (a,b+1) for a,b≥2 over every infinite field. -/
theorem propagate_column [Infinite K] (a b : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (h : ∃ ℓ : degreeOne (K := K) (n := shape a b),
      Function.Injective (firstLefschetz ℓ)) :
    ∃ ℓ : degreeOne (K := K) (n := shape a (b+1)),
      Function.Injective (firstLefschetz ℓ) := by
  classical
  letI := Artinian.reduction_finite (K := K) (n := shape a b)
  letI := Artinian.reduction_finite (K := K) (n := shape a (b+1))
  obtain ⟨ℓ₀,hℓ₀⟩ := h
  obtain ⟨p,hp⟩ := restriction_has_injective_point (K := K) a b ha hb
  obtain ⟨q,hq⟩ := quotient_has_injective_point a b ℓ₀ hℓ₀
  obtain ⟨r,hr,hs⟩ := GenericLinearFamilies.exists_common_injective
    (restrictionFamily (K := K) a b) (quotientFamily (K := K) a b) p q hp hq
  obtain ⟨ℓ,hℓ⟩ := r.property
  refine ⟨ℓ, ?_⟩
  intro x y hxy
  let z := x-y
  have hz : firstLefschetz ℓ z=0 := by
    dsimp [z]
    rw [map_sub,hxy,sub_self]
  have hmul : r.val*z.val=0 := by
    have he := congrArg Subtype.val hz
    change oneToReduction (K := K) (n := shape a (b+1)) ℓ * z.val=0 at he
    simpa only [hℓ] using he
  let z' : actualDegreeOne (K := K) (n := shape a b) :=
    ⟨truncation (K := K) a b z.val,truncation_one_mem a b z.val z.property⟩
  have hsmall : quotientFamily (K := K) a b r z'=0 := by
    change truncation (K := K) a b r.val * truncation (K := K) a b z.val=0
    have he := congrArg (truncation (K := K) a b) hmul
    simpa only [map_mul,map_zero] using he
  have hsmallzero : z'=0 := hs (hsmall.trans (map_zero _).symm)
  have htrunc : truncation (K := K) a b z.val=0 := congrArg Subtype.val hsmallzero
  obtain ⟨c,hc⟩ := degreeOne_kernel a b z htrunc
  have hrestriction : restrictionFamily (K := K) a b r c=0 := by
    change r.val * (∑ i, c i • «variable» (K := K) a (b+1) i.castSucc (Fin.last (b+1)))=0
    rw [← hc]
    exact hmul
  have hc0 : c=0 := hr (hrestriction.trans (map_zero _).symm)
  have hzval : z.val=0 := by
    rw [hc,hc0]
    simp only [Pi.zero_apply,zero_smul,Finset.sum_const_zero]
  have hzz : z=0 := Subtype.ext hzval
  exact sub_eq_zero.mp hzz

/-- Arbitrarily many column extensions, not a bounded finite test. -/
theorem propagate_columns [Infinite K] (a b c : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hbc : b ≤ c)
    (h : ∃ ℓ : degreeOne (K := K) (n := shape a b),
      Function.Injective (firstLefschetz ℓ)) :
    ∃ ℓ : degreeOne (K := K) (n := shape a c),
      Function.Injective (firstLefschetz ℓ) := by
  induction c, hbc using Nat.le_induction with
  | base => exact h
  | succ c hbc ih => exact propagate_column a c ha (hb.trans hbc) ih

end PaperVerification.Segre.TwoFactorPropagation
end
end ProbeLayer85

section ProbeLayer86



/-!
# Transposition of the literal rectangular Segre quotient

Swapping the two original factor-variable sets carries every antidiagonal sum
to the antidiagonal of the same rank. It therefore defines mutually inverse
algebra homomorphisms of the specified Artinian reductions. Homogeneous pieces
and multiplication are transported by these actual ring homomorphisms.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorTranspose

open Staircase Monomials Balanced RankParameters Artinian ActualQuotient TwoFactorActual

variable {K : Type*} [Field K]

def swapVariable (a b : ℕ) : Variables (shape a b) → Variables (shape b a) :=
  fun v => Fin.cases
    (fun j : Fin (a+1) => ⟨1,j⟩)
    (Fin.cases (fun j : Fin (b+1) => ⟨0,j⟩) (fun q => Fin.elim0 q)) v.1 v.2

@[simp] theorem swapVariable_left (a b : ℕ) (i : Fin (a+1)) :
    swapVariable a b ⟨0,i⟩=⟨1,i⟩ := by rfl

@[simp] theorem swapVariable_right (a b : ℕ) (j : Fin (b+1)) :
    swapVariable a b ⟨1,j⟩=⟨0,j⟩ := by rfl

noncomputable def ambientTranspose (a b : ℕ) :
    MvPolynomial (Variables (shape a b)) K →ₐ[K]
      MvPolynomial (Variables (shape b a)) K := MvPolynomial.rename (swapVariable a b)

@[simp] theorem ambientTranspose_cell (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    ambientTranspose (K := K) a b (cellPolynomial (cell a b i j)) =
      cellPolynomial (cell b a j i) := by
  rw [cellPolynomial_value,map_mul]
  simp only [ambientTranspose,MvPolynomial.rename_X,swapVariable_left,
    swapVariable_right,cellPolynomial_value,mul_comm]

theorem ambientTranspose_mem (a b : ℕ)
    (f : segreAlgebra (K := K) (n := shape a b)) :
    ambientTranspose a b f.val ∈ segreAlgebra (K := K) (n := shape b a) := by
  rcases f with ⟨f,hf⟩
  change ambientTranspose a b f ∈ _
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
      obtain ⟨u,rfl⟩ := hf
      obtain ⟨⟨i,j⟩,rfl⟩ := (cellEquiv a b).surjective u
      change ambientTranspose a b (cellPolynomial (cell a b i j)) ∈ _
      rw [ambientTranspose_cell]
      exact Algebra.subset_adjoin (Set.mem_range_self _)
  | algebraMap c =>
      rw [AlgHom.commutes]
      exact Subalgebra.algebraMap_mem _ _
  | add f g hf hg ihf ihg =>
      rw [map_add]
      exact Subalgebra.add_mem _ ihf ihg
  | mul f g hf hg ihf ihg =>
      rw [map_mul]
      exact Subalgebra.mul_mem _ ihf ihg

noncomputable def transposeAlgebra (a b : ℕ) :
    segreAlgebra (K := K) (n := shape a b) →ₐ[K]
      segreAlgebra (K := K) (n := shape b a) :=
  ((ambientTranspose a b).comp (segreAlgebra (K := K) (n := shape a b)).val).codRestrict
    (segreAlgebra (K := K) (n := shape b a)) (ambientTranspose_mem a b)

@[simp] theorem transposeAlgebra_coordinate (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    transposeAlgebra (K := K) a b (coordinate (cell a b i j)) = coordinate (cell b a j i) := by
  apply Subtype.ext
  exact ambientTranspose_cell a b i j

noncomputable def toOtherReduction (a b : ℕ) :
    segreAlgebra (K := K) (n := shape a b) →ₐ[K]
      Reduction (K := K) (n := shape b a) :=
  (Ideal.Quotient.mkₐ K (parameterIdeal (rankParameter (K := K) (n := shape b a)))).comp
    (transposeAlgebra a b)

@[simp] theorem toOtherReduction_coordinate (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    toOtherReduction (K := K) a b (coordinate (cell a b i j)) = «variable» (K := K) b a j i := by
  simp only [toOtherReduction,AlgHom.comp_apply,transposeAlgebra_coordinate]
  rfl

theorem toOtherReduction_rankParameter (a b : ℕ) (r : Ranks (shape a b)) :
    toOtherReduction (K := K) a b (rankParameter r)=0 := by
  let r' : Fin (b+a+1) := ⟨r.val,by simpa only [sideSum_shape,Nat.add_comm b a] using r.isLt⟩
  have hsum : toOtherReduction (K := K) a b (rankParameter r)=
      ∑ i : Fin (a+1), ∑ j : Fin (b+1),
        if i.val+j.val=r.val then «variable» (K := K) b a j i else 0 := by
    rw [rankParameter,map_sum]
    simp only [map_smul]
    rw [← Equiv.sum_comp (cellEquiv a b),Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    simp only [cellEquiv_apply,toOtherReduction_coordinate,rankForms,rankIndex,Fin.ext_iff,
      rank_cell,ite_smul,one_smul,zero_smul]
  rw [hsum,Finset.sum_comm]
  simpa only [r',Nat.add_comm] using rank_sums_zero (K := K) b a r'

theorem parameterIdeal_le_kernel (a b : ℕ) :
    parameterIdeal (rankParameter (K := K) (n := shape a b)) ≤
      RingHom.ker (toOtherReduction (K := K) a b).toRingHom := by
  apply Ideal.span_le.mpr
  rintro f ⟨r,rfl⟩
  exact toOtherReduction_rankParameter a b r

noncomputable def transposeReduction (a b : ℕ) :
    Reduction (K := K) (n := shape a b) →ₐ[K] Reduction (K := K) (n := shape b a) :=
  Ideal.Quotient.liftₐ _ (toOtherReduction a b) (fun _ h => parameterIdeal_le_kernel a b h)

@[simp] theorem transpose_variable (a b : ℕ) (i : Fin (a+1)) (j : Fin (b+1)) :
    transposeReduction (K := K) a b («variable» (K := K) a b i j)=«variable» (K := K) b a j i :=
  toOtherReduction_coordinate a b i j

set_option maxHeartbeats 2000000 in
theorem transpose_twice (a b : ℕ) (x : Reduction (K := K) (n := shape a b)) :
    transposeReduction (K := K) b a (transposeReduction (K := K) a b x)=x := by
  have he : (transposeReduction (K := K) b a).comp (transposeReduction (K := K) a b) =
      AlgHom.id K (Reduction (K := K) (n := shape a b)) := by
    apply AlgHom.ext_of_adjoin_eq_top (residueCoordinates_generate (K := K) (n := shape a b))
    rintro z ⟨u,rfl⟩
    obtain ⟨⟨i,j⟩,rfl⟩ := (cellEquiv a b).surjective u
    change transposeReduction (K := K) b a (transposeReduction (K := K) a b («variable» (K := K) a b i j)) = «variable» (K := K) a b i j
    rw [transpose_variable,transpose_variable]
  exact congrArg (fun f => f x) he

theorem transpose_injective (a b : ℕ) : Function.Injective (transposeReduction (K := K) a b) := by
  have h : Function.LeftInverse (transposeReduction (K := K) b a)
      (transposeReduction (K := K) a b) := transpose_twice a b
  exact h.injective

theorem transpose_one_mem (a b : ℕ) (x : Reduction (K := K) (n := shape a b))
    (hx : x ∈ actualDegreeOne (K := K) (n := shape a b)) :
    transposeReduction (K := K) a b x ∈ actualDegreeOne (K := K) (n := shape b a) := by
  rw [actualDegreeOne_eq_linearSpan (K := K) a b] at hx
  rw [actualDegreeOne_eq_linearSpan (K := K) b a]
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨⟨i,j⟩,rfl⟩ := hx
      rw [transpose_variable]
      exact Submodule.subset_span (Set.mem_range_self (j,i))
  | zero => simpa only [map_zero] using (Submodule.zero_mem (linearCoordinateSpan (K := K) b a))
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
  | smul c x hx ih =>
      rw [map_smul]
      exact Submodule.smul_mem _ c ih

theorem transpose_two_mem (a b : ℕ) (x : Reduction (K := K) (n := shape a b))
    (hx : x ∈ actualDegreeTwo (K := K) (n := shape a b)) :
    transposeReduction (K := K) a b x ∈ actualDegreeTwo (K := K) (n := shape b a) := by
  rw [actualDegreeTwo_eq_quadraticSpan (K := K) a b] at hx
  rw [actualDegreeTwo_eq_quadraticSpan (K := K) b a]
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨⟨⟨i,j⟩,⟨k,l⟩⟩,rfl⟩ := hx
      rw [map_mul,transpose_variable,transpose_variable]
      exact Submodule.subset_span (Set.mem_range_self ((j,i),(l,k)))
  | zero => simpa only [map_zero] using (Submodule.zero_mem (quadraticCoordinateSpan (K := K) b a))
  | add x y hx hy ihx ihy =>
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
  | smul c x hx ih =>
      rw [map_smul]
      exact Submodule.smul_mem _ c ih

/-- Injective first Lefschetz maps are transported by swapping the two
original projective factors; no numerical symmetry is assumed as an axiom. -/
theorem exists_injective_transpose (a b : ℕ)
    (h : ∃ ℓ : degreeOne (K := K) (n := shape a b), Function.Injective (firstLefschetz ℓ)) :
    ∃ ℓ : degreeOne (K := K) (n := shape b a), Function.Injective (firstLefschetz ℓ) := by
  obtain ⟨ℓ,hℓ⟩ := h
  have hmem := transpose_one_mem a b (oneToReduction (K := K) (n := shape a b) ℓ) ⟨ℓ,rfl⟩
  obtain ⟨ℓ',hℓ'⟩ := hmem
  refine ⟨ℓ', ?_⟩
  intro x y hxy
  let x' : actualDegreeOne (K := K) (n := shape a b) :=
    ⟨transposeReduction (K := K) b a x.val,transpose_one_mem b a x.val x.property⟩
  let y' : actualDegreeOne (K := K) (n := shape a b) :=
    ⟨transposeReduction (K := K) b a y.val,transpose_one_mem b a y.val y.property⟩
  have he : firstLefschetz ℓ x'=firstLefschetz ℓ y' := by
    apply Subtype.ext
    have hv := congrArg Subtype.val hxy
    change oneToReduction (K := K) (n := shape b a) ℓ' * x.val =
      oneToReduction (K := K) (n := shape b a) ℓ' * y.val at hv
    have ht := congrArg (transposeReduction (K := K) b a) hv
    rw [map_mul,map_mul,hℓ',transpose_twice] at ht
    exact ht
  have hi := congrArg Subtype.val (hℓ he)
  apply Subtype.ext
  exact transpose_injective b a hi

set_option maxHeartbeats 2000000 in
/-- Surjectivity on the entire actual second homogeneous component is also
invariant under swapping the original factors. -/
theorem exists_surjective_transpose (a b : ℕ)
    (h : ∃ ℓ : degreeOne (K := K) (n := shape a b), Function.Surjective (firstLefschetz ℓ)) :
    ∃ ℓ : degreeOne (K := K) (n := shape b a), Function.Surjective (firstLefschetz ℓ) := by
  obtain ⟨ℓ,hℓ⟩ := h
  have hmem := transpose_one_mem a b (oneToReduction (K := K) (n := shape a b) ℓ) ⟨ℓ,rfl⟩
  obtain ⟨ℓ',hℓ'⟩ := hmem
  refine ⟨ℓ', ?_⟩
  intro y
  let y' : actualDegreeTwo (K := K) (n := shape a b) :=
    ⟨transposeReduction (K := K) b a y.val,transpose_two_mem b a y.val y.property⟩
  obtain ⟨x,hx⟩ := hℓ y'
  refine ⟨⟨transposeReduction (K := K) a b x.val,transpose_one_mem a b x.val x.property⟩, ?_⟩
  apply Subtype.ext
  change oneToReduction (K := K) (n := shape b a) ℓ' * transposeReduction (K := K) a b x.val = y.val
  rw [hℓ',← map_mul]
  have he := congrArg Subtype.val hx
  change oneToReduction (K := K) (n := shape a b) ℓ * x.val = transposeReduction (K := K) b a y.val at he
  rw [he,transpose_twice]

end PaperVerification.Segre.TwoFactorTranspose
end
end ProbeLayer86


/-! Future-only kernel audit for one exported mathematical stage.

Append to the stage being checked, with Lean.Util.CollectAxioms available through
both `public import Lean.Util.CollectAxioms` and `import all Lean.Util.CollectAxioms`
in that stage's header, as required by the reviewed FullFlattenedAudit.

Every new declaration in the checked kernel environment is included: public,
private, generated and vendored declarations receive the same direct-sorry and
transitive-axiom checks. This is evidence for this stage only. Later principal
theorems need not exist yet, and the final full principal audit remains required.

This preparation does not execute the audit, export a module or alter a proof.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The stage kernel audit requires kernel trust level zero"
  let names := (env.checked.get.constants.foldStage2
    (fun (names : Array Name) name _ => names.push name) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The stage mathematical module is empty"
  let privateEnv := env.setExporting false
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut theoremCount : Nat := 0
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if let .thmInfo _ := info then
      theoremCount := theoremCount + 1
  let report := Json.mkObj [
    ("main_module", toJson env.header.mainModule.toString),
    ("declaration_count", toJson names.size),
    ("theorem_count", toJson theoremCount),
    ("trust_level", toJson env.header.trustLevel.toNat),
