/-!
# Functorial actual Čech sheaf resolutions

The sheaf resolution is additive and its augmentation is natural.  These maps
are needed to form the actual double Čech resolution of two covers; no assertion
identifying the Čech complex of the product cover with a tensor total is made.
-/


open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.CechSheafResolution

universe u
variable {X : TopCat.{u}} {ι : Type u} (U : ι → Opens X)

/-- Restriction to intersections is natural in the original presheaf. -/
def restrictionMap {P Q : AbPresheaf (X := X)} (φ : P ⟶ Q) :
    restrictionFunctor P ⟶ restrictionFunctor Q :=
  Functor.whiskerLeft
    (prod.functor.op ⋙ Functor.opHom (Opens X) (Opens X))
    ((Functor.whiskeringRight _ _ _).map φ)

/-- The actual map of sectionwise Čech complexes induced by a presheaf map. -/
def presheafComplexMap {P Q : AbPresheaf (X := X)} (φ : P ⟶ Q) :
    presheafComplex U P ⟶ presheafComplex U Q where
  f n := Functor.whiskerRight
    (Functor.whiskerRight (restrictionMap φ) (cechComplexFunctor U))
    (HomologicalComplex.eval AddCommGrpCat.{u} (ComplexShape.up ℕ) n)
  comm' n m _ := by
    apply NatTrans.ext
    funext W
    exact ((cechComplexFunctor U).map ((restrictionMap φ).app W)).comm n m

/-- The induced map of the actual sheaves of Čech sections. -/
def sheafComplexMap {F G : AbSheaf (X := X)} (φ : F ⟶ G) :
    sheafComplex U F ⟶ sheafComplex U G where
  f n := ⟨(presheafComplexMap U φ.hom).f n⟩
  comm' n m h := by
    apply (sheafToPresheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).map_injective
    exact (presheafComplexMap U φ.hom).comm n m

@[simp] theorem presheafComplexMap_id (P : AbPresheaf (X := X)) :
    presheafComplexMap U (𝟙 P) = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext n
  apply NatTrans.ext
  funext W
  change ((cechComplexFunctor U).map (𝟙 _)).f n = 𝟙 _
  rw [CategoryTheory.Functor.map_id]
  rfl

@[simp] theorem presheafComplexMap_comp {P Q R : AbPresheaf (X := X)}
    (φ : P ⟶ Q) (ψ : Q ⟶ R) :
    presheafComplexMap U (φ ≫ ψ) =
      presheafComplexMap U φ ≫ presheafComplexMap U ψ := by
  apply HomologicalComplex.Hom.ext
  funext n
  apply NatTrans.ext
  funext W
  change ((cechComplexFunctor U).map
    (((restrictionMap φ).app W) ≫ ((restrictionMap ψ).app W))).f n = _
  rw [Functor.map_comp]
  rfl

/-- The Čech sheaf resolution functor. -/
def sheafComplexFunctor : AbSheaf (X := X) ⥤
    CochainComplex (AbSheaf (X := X)) ℕ where
  obj := sheafComplex U
  map := sheafComplexMap U
  map_id F := by
    apply HomologicalComplex.Hom.ext
    funext n
    apply (sheafToPresheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).map_injective
    exact congrArg (fun f ↦ f.f n) (presheafComplexMap_id U F.obj)
  map_comp φ ψ := by
    apply HomologicalComplex.Hom.ext
    funext n
    apply (sheafToPresheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).map_injective
    exact congrArg (fun f ↦ f.f n) (presheafComplexMap_comp U φ.hom ψ.hom)

instance sheafComplexFunctor_additive : (sheafComplexFunctor U).Additive where
  map_add {F G φ ψ} := by
    letI : (cechComplexFunctor (A := AddCommGrpCat.{u}) U).Additive :=
      Functor.additive_of_preserves_binary_products _
    apply HomologicalComplex.Hom.ext
    funext n
    apply (sheafToPresheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).map_injective
    apply NatTrans.ext
    funext W
    change ((cechComplexFunctor U).map
      (((restrictionMap φ.hom).app W) + ((restrictionMap ψ.hom).app W))).f n = _
    rw [Functor.map_add]
    rfl

/-- The terminal-intersection isomorphism commutes with presheaf maps. -/
theorem restrictionTerminalIso_inv_naturality {P Q : AbPresheaf (X := X)}
    (φ : P ⟶ Q) :
    (restrictionTerminalIso P).inv ≫
      Functor.whiskerRight (restrictionMap φ)
        ((evaluation _ _).obj (op (⊤ : Opens X))) =
      φ ≫ (restrictionTerminalIso Q).inv := by
  apply NatTrans.ext
  funext W
  change
    (((𝟙 (P.obj W)) ≫ P.map (𝟙 W)) ≫
      P.map ((isTerminalTop.prodRightUnitor.hom.app W.unop).op)) ≫
        φ.app _ =
      φ.app W ≫ (((𝟙 (Q.obj W)) ≫ Q.map (𝟙 W)) ≫
        Q.map ((isTerminalTop.prodRightUnitor.hom.app W.unop).op))
  simpa only [CategoryTheory.Functor.map_id, Category.id_comp,
    CategoryTheory.Functor.id_obj, Opposite.op_unop] using
    φ.naturality ((isTerminalTop.prodRightUnitor.hom.app W.unop).op)

set_option maxHeartbeats 1000000 in
/-- Naturality of the actual degree-zero augmentation. -/
theorem presheafAugmentation_naturality {P Q : AbPresheaf (X := X)} (φ : P ⟶ Q) :
    presheafAugmentation U P ≫ (presheafComplexMap U φ).f 0 =
      φ ≫ presheafAugmentation U Q := by
  apply NatTrans.ext
  funext W
  change ((restrictionTerminalIso P).inv.app W ≫
      CochainAugmentationKernel.component
        (cechAugmentation U isTerminalTop ((restrictionFunctor P).obj W))) ≫
        ((cechComplexFunctor U).map ((restrictionMap φ).app W)).f 0 =
    φ.app W ≫ ((restrictionTerminalIso Q).inv.app W ≫
      CochainAugmentationKernel.component
        (cechAugmentation U isTerminalTop ((restrictionFunctor Q).obj W)))
  have h := component_naturality
    (cechAugmentation U isTerminalTop ((restrictionFunctor P).obj W))
    (cechAugmentation U isTerminalTop ((restrictionFunctor Q).obj W))
    (((restrictionMap φ).app W).app (op ⊤))
    ((cechComplexFunctor U).map ((restrictionMap φ).app W))
    (cechAugmentation_naturality U isTerminalTop
      ((restrictionFunctor P).obj W) ((restrictionMap φ).app W)).symm
  rw [Category.assoc, ← h, ← Category.assoc]
  exact congrArg
    (fun f : P.obj W ⟶ ((restrictionFunctor Q).obj W).obj (op (⊤ : Opens X)) ↦
      f ≫ CochainAugmentationKernel.component
        (cechAugmentation U isTerminalTop ((restrictionFunctor Q).obj W)))
    (NatTrans.congr_app (restrictionTerminalIso_inv_naturality φ) W)

theorem augmentation_naturality {F G : AbSheaf (X := X)} (φ : F ⟶ G) :
    augmentation U F ≫ (sheafComplexMap U φ).f 0 = φ ≫ augmentation U G := by
  apply (sheafToPresheaf (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}).map_injective
  exact presheafAugmentation_naturality U φ.hom

/-- The actual augmentation as a morphism of cochain complexes. -/
def augmentationMap (F : AbSheaf (X := X)) :
    (CochainComplex.single₀ (AbSheaf (X := X))).obj F ⟶ sheafComplex U F :=
  HomologicalComplex.mkHomFromSingle (augmentation U F) fun n hn ↦ by
    have : n = 1 := by simpa using hn.symm
    subst n
    exact augmentation_d U F

@[simp] theorem augmentationMap_f_zero (F : AbSheaf (X := X)) :
    (augmentationMap U F).f 0 = augmentation U F := by
  simp [augmentationMap, HomologicalComplex.mkHomFromSingle_f]

/-- The augmentation to the actual Čech sheaf resolution is a quasi-isomorphism. -/
theorem quasiIso_augmentationMap (F : AbSheaf (X := X)) (hU : ⨆ i, U i = ⊤) :
    QuasiIso (augmentationMap U F) := by
  rw [quasiIso_iff]
  intro n
  cases n with
  | zero =>
    rw [CochainAugmentationKernel.quasiIsoAt_zero_iff_isLimit]
    haveI := mono_augmentation U F hU
    simpa only [CochainAugmentationKernel.component_eq, augmentationMap_f_zero] using
      (ShortComplex.exact_and_mono_f_iff_f_is_kernel
        (S := ShortComplex.mk (augmentation U F) ((sheafComplex U F).d 0 1)
          (augmentation_d U F))).mp ⟨augmentation_exact U F hU, inferInstance⟩
  | succ n =>
    exact (quasiIsoAt_iff_exactAt _ (n + 1)
      (HomologicalComplex.exactAt_single_obj (ComplexShape.up ℕ) 0 F
        (n + 1) (by omega))).mpr
      (exactAt_succ U F hU n)

set_option backward.isDefEq.respectTransparency false in
/-- The augmentation is a natural transformation, so it can be applied to the
terms and the differentials of another actual resolution. -/
def augmentationNatTrans :
    CochainComplex.single₀ (AbSheaf (X := X)) ⟶ sheafComplexFunctor U where
  app := augmentationMap U
  naturality F G φ := by
    apply HomologicalComplex.from_single_hom_ext
    change (((CochainComplex.single₀ (AbSheaf (X := X))).map φ ≫
      augmentationMap U G).f 0) =
      ((augmentationMap U F ≫ sheafComplexMap U φ).f 0)
    simpa only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
      augmentationMap_f_zero] using (augmentation_naturality U φ).symm

end PaperVerification.Segre.CechSheafResolution

end SegreCechSheafFunctor

end
