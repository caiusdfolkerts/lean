section SegreCriticalGraph

/-!
# Literal singular-vector equations on the graph

The contraction in every factor is expanded in the original tensor
coefficients. The linear critical equations are defined on the full ambient
tensor space. On an actual graph tensor they are exactly the equations saying
that each contraction is proportional to its nonzero factor vector. This
identification includes characteristic two and isotropic factor vectors.

The original tensor belongs both to the graph span and to this critical linear
space. Identifying their intersection with the span of the singular zero scheme
is a separate geometric assertion, not a definition made in this file.
-/

set_option autoImplicit false



namespace PaperVerification.Segre.CriticalGraph

open Staircase Monomials Degeneration Trace GraphSpan
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- All coordinate indices outside one specified factor. -/
abbrev OtherCell (n : I → ℕ) (i : I) := ∀ h : {h : I // h≠i}, Fin (n h.val+1)

/-- Reinsert one factor coordinate into the complete tensor index. -/
def assemble (i : I) (a : Fin (n i+1)) (w : OtherCell n i) : Cell n :=
  (Equiv.piSplitAt i (fun h => Fin (n h+1))).symm (a,w)

@[simp] theorem assemble_same (i : I) (a : Fin (n i+1)) (w : OtherCell n i) :
    assemble i a w i=a := by simp [assemble,Equiv.piSplitAt]

@[simp] theorem assemble_other (i : I) (a : Fin (n i+1)) (w : OtherCell n i)
    (h : {h : I // h≠i}) : assemble i a w h.val=w h := by
  simp [assemble,Equiv.piSplitAt,h.property]

/-- The literal product of all factor coordinates except those of factor i. -/
def otherProduct (x : Variables n → K) (i : I) (w : OtherCell n i) : K :=
  ∏ h : {h : I // h≠i}, x ⟨h.val,w h⟩

theorem eval_cell_assemble (x : Variables n → K) (i : I)
    (a : Fin (n i+1)) (w : OtherCell n i) :
    MvPolynomial.eval x (cellPolynomial (K := K) (assemble i a w))=
      x ⟨i,a⟩*otherProduct x i w := by
  rw [eval_cell_eq_prod]
  rw [← Finset.mul_prod_erase Finset.univ (fun h : I => x ⟨h,assemble i a w h⟩)
    (Finset.mem_univ i), assemble_same]
  congr 1
  rw [Finset.prod_subtype (p := fun h : I => h≠i) (F := inferInstance)
    (Finset.univ.erase i) (by simp)]
  simp only [assemble_other, otherProduct]

/-- The last contraction vector, with every slice coefficient retained. -/
def lastContraction (A : Matrix (Cell n) J K) (x : Variables n → K) : J → K :=
  fun j => MvPolynomial.eval x (segreForm A j)

/-- Contraction in a specified original factor, using all the other factor
vectors and the last factor vector y. -/
def factorContraction (A : Matrix (Cell n) J K) (x : Variables n → K)
    (y : J → K) (i : I) (a : Fin (n i+1)) : K :=
  ∑ w : OtherCell n i, ∑ j : J, A (assemble i a w) j*y j*otherProduct x i w

/-- All ordered two-coordinate critical equations; repetitions and diagonal
coordinates are retained, so the definition does not assume a rank count. -/
abbrev CriticalIndex (n : I → ℕ) := Σ i : I, Fin (n i+1) × Fin (n i+1)

/-- The actual linear critical operator in the full ambient tensor space. -/
def criticalOperator (A : Matrix (Cell n) J K) :
    Matrix (Cell n) J K →ₗ[K] (CriticalIndex n → K) where
  toFun B q := ∑ w : OtherCell n q.1, ∑ j : J,
    (A (assemble q.1 q.2.1 w) j*B (assemble q.1 q.2.2 w) j-
      A (assemble q.1 q.2.2 w) j*B (assemble q.1 q.2.1 w) j)
  map_add' B C := by
    funext q
    simp only [Pi.add_apply,Matrix.add_apply,mul_add]
    simp only [show ∀ a b c d : K, a+b-(c+d)=(a-c)+(b-d) by intros; ring,
      Finset.sum_add_distrib]
  map_smul' a B := by
    funext q
    simp only [RingHom.id_apply,Pi.smul_apply,Matrix.smul_apply,smul_eq_mul,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro w _
    apply Finset.sum_congr rfl
    intro j _
    ring

/-- The critical linear space is the actual kernel, before any span theorem. -/
def criticalSpace (A : Matrix (Cell n) J K) : Submodule K (Matrix (Cell n) J K) :=
  LinearMap.ker (criticalOperator A)

/-- The remaining critical equations, belonging to the last tensor factor. -/
def lastCriticalOperator (A : Matrix (Cell n) J K) :
    Matrix (Cell n) J K →ₗ[K] (J × J → K) where
  toFun B q := ∑ u : Cell n, (A u q.1*B u q.2-A u q.2*B u q.1)
  map_add' B C := by
    funext q
    simp only [Pi.add_apply,Matrix.add_apply,mul_add]
    simp only [show ∀ a b c d : K, a+b-(c+d)=(a-c)+(b-d) by intros; ring,
      Finset.sum_add_distrib]
  map_smul' a B := by
    funext q
    simp only [RingHom.id_apply,Pi.smul_apply,Matrix.smul_apply,smul_eq_mul,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro u _
    ring

/-- The full critical space H_T, with equations from every factor. -/
def fullCriticalSpace (A : Matrix (Cell n) J K) : Submodule K (Matrix (Cell n) J K) :=
  criticalSpace A ⊓ LinearMap.ker (lastCriticalOperator A)

theorem eval_segreForm (A : Matrix (Cell n) J K) (x : Variables n → K) (j : J) :
    MvPolynomial.eval x (segreForm A j)=
      ∑ u : Cell n, A u j*MvPolynomial.eval x (cellPolynomial (K := K) u) := by
  change MvPolynomial.aeval x (segreForm A j)=_
  simp only [segreForm, map_sum, map_smul, smul_eq_mul, MvPolynomial.aeval_eq_eval]

/-- Last-factor critical equations vanish identically on the actual graph. -/
theorem lastCriticalOperator_graphTensor (A : Matrix (Cell n) J K) (x : Variables n → K) :
    lastCriticalOperator A (graphTensor A x)=0 := by
  funext q
  change (∑ u : Cell n,
    (A u q.1*(MvPolynomial.eval x (cellPolynomial u)*MvPolynomial.eval x (segreForm A q.2))-
      A u q.2*(MvPolynomial.eval x (cellPolynomial u)*MvPolynomial.eval x (segreForm A q.1))))=0
  simp only [← mul_assoc,Finset.sum_sub_distrib,← Finset.sum_mul,← eval_segreForm]
  ring

/-- Therefore the whole graph span already satisfies the last-factor equations. -/
theorem graphSpan_le_lastCriticalKernel (A : Matrix (Cell n) J K) :
    graphSpan A ≤ LinearMap.ker (lastCriticalOperator A) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨x,rfl⟩
  exact lastCriticalOperator_graphTensor A x.val

/-- On the graph span, the small-factor equations give exactly the full critical
space intersection. The omitted last equations have been proved redundant. -/
theorem graph_inter_small_eq_full (A : Matrix (Cell n) J K) :
    graphSpan A ⊓ criticalSpace A=graphSpan A ⊓ fullCriticalSpace A := by
  apply le_antisymm
  · intro B hB
    exact ⟨hB.1,hB.2,graphSpan_le_lastCriticalKernel A hB.1⟩
  · intro B hB
    exact ⟨hB.1,hB.2.1⟩

/-- Every tensor satisfies its own linear critical equations, including in
characteristic two; each summand cancels without dividing by two. -/
theorem tensor_mem_criticalSpace (A : Matrix (Cell n) J K) : A ∈ criticalSpace A := by
  change criticalOperator A A=0
  funext q
  change (∑ w : OtherCell n q.1, ∑ j : J,
    (A (assemble q.1 q.2.1 w) j*A (assemble q.1 q.2.2 w) j-
      A (assemble q.1 q.2.2 w) j*A (assemble q.1 q.2.1 w) j))=0
  apply Finset.sum_eq_zero
  intro w _
  apply Finset.sum_eq_zero
  intro j _
  ring

/-- Restriction to the actual graph gives the literal wedge of the factor
vector with its actual contraction. -/
theorem criticalOperator_graphTensor (A : Matrix (Cell n) J K) (x : Variables n → K)
    (i : I) (a b : Fin (n i+1)) :
    criticalOperator A (graphTensor A x) ⟨i,(a,b)⟩=
      x ⟨i,b⟩*factorContraction A x (lastContraction A x) i a-
        x ⟨i,a⟩*factorContraction A x (lastContraction A x) i b := by
  change (∑ w : OtherCell n i, ∑ j : J,
    (A (assemble i a w) j*graphTensor A x (assemble i b w) j-
      A (assemble i b w) j*graphTensor A x (assemble i a w) j))=_
  simp only [graphTensor,eval_cell_assemble,factorContraction,lastContraction,
    Finset.mul_sum,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro w _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- Vanishing of every two-coordinate wedge is equivalent to proportionality
to the entire nonzero vector, over every field. -/
theorem wedge_zero_iff_proportional {D : Type*} (v w : D → K)
    (hv : ∃ b,v b≠0) :
    (∀ a b, v b*w a=v a*w b) ↔ ∃ c : K, ∀ a,w a=c*v a := by
  constructor
  · intro h
    obtain ⟨b,hb⟩ := hv
    refine ⟨w b/v b,?_⟩
    intro a
    apply (mul_left_cancel₀ hb)
    calc
      v b*w a=v a*w b := h a b
      _=v b*((w b/v b)*v a) := by field_simp [hb] <;> ring
  · rintro ⟨c,hc⟩ a b
    rw [hc a,hc b]
    ring

/-- The actual coordinate singular-vector tuple condition. The last vector is
required to be nonzero, and every contraction must be proportional to its
corresponding full factor vector. -/
def IsSingularTuple (A : Matrix (Cell n) J K) (x : FactorPoint n K) (y : J → K) : Prop :=
  y≠0 ∧ (∀ i, ∃ c : K, ∀ a, factorContraction A x.val y i a=c*x.val ⟨i,a⟩) ∧
    ∃ c : K, ∀ j, lastContraction A x.val j=c*y j

/-- For a graph point whose last contraction is nonzero, membership in the
critical linear space is exactly the complete singular-vector condition. -/
theorem graph_mem_criticalSpace_iff_singular (A : Matrix (Cell n) J K)
    (x : FactorPoint n K) (hx : lastContraction A x.val≠0) :
    graphTensor A x.val ∈ criticalSpace A ↔
      IsSingularTuple A x (lastContraction A x.val) := by
  constructor
  · intro h
    refine ⟨hx,?_,⟨1,fun _ => (one_mul _).symm⟩⟩
    intro i
    apply (wedge_zero_iff_proportional (fun a => x.val ⟨i,a⟩)
      (factorContraction A x.val (lastContraction A x.val) i) (x.property i)).mp
    intro a b
    have hq := congrFun (show criticalOperator A (graphTensor A x.val)=0 from h) ⟨i,(a,b)⟩
    rw [criticalOperator_graphTensor] at hq
    exact sub_eq_zero.mp hq
  · rintro ⟨_,h,_⟩
    change criticalOperator A (graphTensor A x.val)=0
    funext q
    rcases q with ⟨i,a,b⟩
    rw [criticalOperator_graphTensor]
    apply sub_eq_zero.mpr
    exact (wedge_zero_iff_proportional (fun a => x.val ⟨i,a⟩)
      (factorContraction A x.val (lastContraction A x.val) i) (x.property i)).mpr (h i) a b

/-- The tensor is in the intersection occurring in Proposition 2.1. Equating
this intersection with the span of the singular zero scheme remains the
separate geometric theorem, and is not assumed here. -/
theorem tensor_mem_graph_inter_critical [Infinite K] (A : Matrix (Cell n) J K) :
    A ∈ graphSpan A ⊓ fullCriticalSpace A := by
  rw [← graph_inter_small_eq_full]
  exact ⟨tensor_mem_graphSpan A,tensor_mem_criticalSpace A⟩

end PaperVerification.Segre.CriticalGraph

end SegreCriticalGraph

section SegreSingularSpan

/-!
# The literal singular rank-one span and the graph intersection

Singular rank-one tensors are defined from all nonzero factor vectors and the
literal contraction equations. Their span is an ordinary submodule span. We
prove the inclusion into the full critical space, and into the actual graph
span when the last slices have no common zero at the factor points.

The reverse inclusion, which is the substantive geometric content of
Proposition 2.1, is deliberately not asserted here.
-/

set_option autoImplicit false



namespace PaperVerification.Segre.SingularSpan

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The entire rank-one tensor in the original ambient coordinate space. -/
def rankOneTensor (x : Variables n → K) (y : J → K) : Matrix (Cell n) J K :=
  fun v j => MvPolynomial.eval x (cellPolynomial (K := K) v)*y j

@[simp] theorem rankOne_lastContraction (A : Matrix (Cell n) J K) (x : Variables n → K) :
    rankOneTensor x (lastContraction A x)=graphTensor A x := rfl

/-- Nonzero vectors in every factor give an actual nonzero rank-one tensor. -/
theorem rankOneTensor_ne_zero (x : FactorPoint n K) (y : J → K) (hy : y≠0) :
    rankOneTensor x.val y≠0 := by
  classical
  choose v hv using x.property
  obtain ⟨j,hj⟩ : ∃ j,y j≠0 := by
    by_contra! h
    apply hy
    funext j
    exact h j
  have hprod : MvPolynomial.eval x.val (cellPolynomial (K := K) v)≠0 := by
    rw [eval_cell_eq_prod]
    exact Finset.prod_ne_zero_iff.mpr (fun i _ => hv i)
  intro h
  have hz := congrArg (fun B : Matrix (Cell n) J K => B v j) h
  exact mul_ne_zero hprod hj hz

/-- Every small-factor critical equation on a rank-one tensor is the exact
two-coordinate proportionality equation for its actual contraction. -/
theorem criticalOperator_rankOne (A : Matrix (Cell n) J K) (x : Variables n → K)
    (y : J → K) (i : I) (a b : Fin (n i+1)) :
    criticalOperator A (rankOneTensor x y) ⟨i,(a,b)⟩=
      x ⟨i,b⟩*factorContraction A x y i a-
        x ⟨i,a⟩*factorContraction A x y i b := by
  change (∑ w : OtherCell n i, ∑ j : J,
    (A (assemble i a w) j*rankOneTensor x y (assemble i b w) j-
      A (assemble i b w) j*rankOneTensor x y (assemble i a w) j))=_
  simp only [rankOneTensor,eval_cell_assemble,factorContraction,
    Finset.mul_sum,← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro w _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The last-factor critical equation is the wedge of the actual last
contraction with the last vector. -/
theorem lastCriticalOperator_rankOne (A : Matrix (Cell n) J K)
    (x : Variables n → K) (y : J → K) (r s : J) :
    lastCriticalOperator A (rankOneTensor x y) (r,s)=
      lastContraction A x r*y s-lastContraction A x s*y r := by
  change (∑ u : Cell n,
    (A u r*(MvPolynomial.eval x (cellPolynomial u)*y s)-
      A u s*(MvPolynomial.eval x (cellPolynomial u)*y r)))=_
  simp only [← mul_assoc,Finset.sum_sub_distrib,← Finset.sum_mul,
    ← eval_segreForm,lastContraction]

/-- The complete singular-vector equations imply membership in H_T, with all
factor equations and no nonisotropic assumption. -/
theorem singular_rankOne_mem_critical (A : Matrix (Cell n) J K)
    (x : FactorPoint n K) (y : J → K) (h : IsSingularTuple A x y) :
    rankOneTensor x.val y ∈ fullCriticalSpace A := by
  constructor
  · change criticalOperator A (rankOneTensor x.val y)=0
    funext q
    rcases q with ⟨i,a,b⟩
    rw [criticalOperator_rankOne]
    obtain ⟨c,hc⟩ := h.2.1 i
    rw [hc a,hc b]
    change _ = (0 : K)
    ring
  · change lastCriticalOperator A (rankOneTensor x.val y)=0
    funext q
    obtain ⟨c,hc⟩ := h.2.2
    rw [lastCriticalOperator_rankOne,hc q.1,hc q.2]
    change _ = (0 : K)
    ring

/-- Every actual singular rank-one tensor, including every allowed choice of
nonzero representatives; nothing is defined through the desired span formula. -/
def singularRankOneSet (A : Matrix (Cell n) J K) : Set (Matrix (Cell n) J K) :=
  {B | ∃ x : FactorPoint n K, ∃ y : J → K,
    IsSingularTuple A x y ∧ B=rankOneTensor x.val y}

/-- The actual linear span of all singular rank-one tensors. -/
def singularSpan (A : Matrix (Cell n) J K) : Submodule K (Matrix (Cell n) J K) :=
  Submodule.span K (singularRankOneSet A)

/-- The singular span is always contained in the full critical space. -/
theorem singularSpan_le_criticalSpace (A : Matrix (Cell n) J K) :
    singularSpan A ≤ fullCriticalSpace A := by
  apply Submodule.span_le.mpr
  rintro B ⟨x,y,h,rfl⟩
  exact singular_rankOne_mem_critical A x y h

/-- The last singular equation puts the entire rank-one tensor in the actual
graph span whenever its last contraction is nonzero. -/
theorem singular_rankOne_mem_graph (A : Matrix (Cell n) J K)
    (x : FactorPoint n K) (y : J → K) (h : IsSingularTuple A x y)
    (hx : lastContraction A x.val≠0) : rankOneTensor x.val y ∈ graphSpan A := by
  obtain ⟨c,hc⟩ := h.2.2
  have hc0 : c≠0 := by
    intro he
    apply hx
    funext j
    rw [hc j,he,zero_mul]
    rfl
  have he : rankOneTensor x.val y=c⁻¹ • graphTensor A x.val := by
    ext v j
    change MvPolynomial.eval x.val (cellPolynomial v)*y j=
      c⁻¹*(MvPolynomial.eval x.val (cellPolynomial v)*lastContraction A x.val j)
    rw [hc j]
    field_simp [hc0] <;> ring
  rw [he]
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨x,rfl⟩

/-- The inclusion from actual singular points to Γ_T∩H_T. Over an algebraically
closed field the displayed point condition is precisely absence of a common
projective zero of the slices. No reverse inclusion is hidden in this result. -/
theorem singularSpan_le_graph_inter_critical (A : Matrix (Cell n) J K)
    (hbase : ∀ x : FactorPoint n K,lastContraction A x.val≠0) :
    singularSpan A ≤ graphSpan A ⊓ fullCriticalSpace A := by
  apply le_inf
  · apply Submodule.span_le.mpr
    rintro B ⟨x,y,h,rfl⟩
    exact singular_rankOne_mem_graph A x y h (hbase x)
  · exact singularSpan_le_criticalSpace A

end PaperVerification.Segre.SingularSpan

end SegreSingularSpan

section SegreProjectiveCharts

/-!
# Normalized product charts for actual graph tensors

Every tuple of nonzero factor vectors belongs to one of the standard affine
charts.  Normalization rescales its graph tensor by the square of the product
of the pivot coordinates.  These identities allow all representative choices
to be compared with polynomial zero loci on the standard affine charts.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ProjectiveCharts

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph SingularSpan
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The free coordinates of the standard chart with pivots `p`. -/
abbrev ChartVar (p : Cell n) := {q : Variables n // q.2 ≠ p q.1}

/-- Regroup the free coordinates by their projective factor. -/
def chartVarEquiv (p : Cell n) :
    ChartVar p ≃ Σ i : I,{a : Fin (n i+1) // a≠p i} where
  toFun q := ⟨q.val.1,⟨q.val.2,q.property⟩⟩
  invFun q := ⟨⟨q.1,q.2.val⟩,q.2.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- Each chart has exactly the projective product dimension many variables. -/
theorem chartVar_card (p : Cell n) : Fintype.card (ChartVar p)=∑ i,n i := by
  classical
  rw [Fintype.card_congr (chartVarEquiv p),Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro i _
  rw [Fintype.card_subtype_compl (fun a : Fin (n i+1) => a=p i)]
  simp

/-- A normalized representative of a point in a standard product chart. -/
def chartVector (p : Cell n) (z : ChartVar p → K) (q : Variables n) : K :=
  if h : q.2 = p q.1 then 1 else z ⟨q,h⟩

@[simp] theorem chartVector_pivot (p : Cell n) (z : ChartVar p → K) (i : I) :
    chartVector p z ⟨i,p i⟩ = 1 := by simp [chartVector]

@[simp] theorem chartVector_free (p : Cell n) (z : ChartVar p → K) (q : ChartVar p) :
    chartVector p z q.val = z q := by simp [chartVector,q.property]

def chartPoint (p : Cell n) (z : ChartVar p → K) : FactorPoint n K :=
  ⟨chartVector p z,fun i => ⟨p i,by simp⟩⟩

/-- Independent rescaling of all factor vectors. -/
def scaleFactors (c : I → K) (x : Variables n → K) (q : Variables n) : K :=
  c q.1*x q

/-- Multilinear cell coordinates acquire the product of the factor scalars. -/
theorem eval_cell_scaleFactors (c : I → K) (x : Variables n → K) (v : Cell n) :
    MvPolynomial.eval (scaleFactors c x) (cellPolynomial (K := K) v) =
      (∏ i,c i)*MvPolynomial.eval x (cellPolynomial v) := by
  simp only [eval_cell_eq_prod,scaleFactors,Finset.prod_mul_distrib]

/-- Every multilinear slice acquires the same product of factor scalars. -/
theorem eval_segreForm_scaleFactors (A : Matrix (Cell n) J K) (c : I → K)
    (x : Variables n → K) (j : J) :
    MvPolynomial.eval (scaleFactors c x) (segreForm A j)=
      (∏ i,c i)*MvPolynomial.eval x (segreForm A j) := by
  simp only [eval_segreForm,eval_cell_scaleFactors,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro v _
  ring

/-- A graph tensor has degree two in every factor, including in characteristic two. -/
theorem graphTensor_scaleFactors (A : Matrix (Cell n) J K) (c : I → K)
    (x : Variables n → K) :
    graphTensor A (scaleFactors c x)=(∏ i,c i)^2 • graphTensor A x := by
  ext v j
  change MvPolynomial.eval (scaleFactors c x) (cellPolynomial v) *
      MvPolynomial.eval (scaleFactors c x) (segreForm A j) =
    (∏ i, c i)^2 * (MvPolynomial.eval x (cellPolynomial v) *
      MvPolynomial.eval x (segreForm A j))
  rw [eval_cell_scaleFactors, eval_segreForm_scaleFactors]
  ring

/-- A rank-one tensor acquires the product of the factor scalars. -/
theorem rankOneTensor_scaleFactors (c : I → K) (x : Variables n → K) (y : J → K) :
    rankOneTensor (scaleFactors c x) y=(∏ i,c i) • rankOneTensor x y := by
  ext v j
  change MvPolynomial.eval (scaleFactors c x) (cellPolynomial v) * y j =
    (∏ i, c i) * (MvPolynomial.eval x (cellPolynomial v) * y j)
  rw [eval_cell_scaleFactors]
  exact mul_assoc _ _ _

/-- All points admit a pivot that is nonzero in every factor. -/
theorem exists_pivots (x : FactorPoint n K) :
    ∃ p : Cell n, ∀ i, x.val ⟨i,p i⟩≠0 := by
  choose p hp using x.property
  exact ⟨p,hp⟩

/-- The ordinary affine coordinates obtained by dividing by each pivot. -/
def chartCoordinates (p : Cell n) (x : Variables n → K) (q : ChartVar p) : K :=
  x q.val / x ⟨q.val.1,p q.val.1⟩

/-- Reconstruct every coordinate, including pivots, from its normalized chart. -/
theorem scale_normalized (p : Cell n) (x : Variables n → K)
    (hp : ∀ i,x ⟨i,p i⟩≠0) :
    scaleFactors (fun i => x ⟨i,p i⟩) (chartVector p (chartCoordinates p x))=x := by
  funext q
  rcases q with ⟨i,a⟩
  by_cases h : a=p i
  · subst a
    simp [scaleFactors]
  · simp only [scaleFactors,chartVector,dif_neg h,chartCoordinates]
    field_simp [hp i] <;> ring

/-- The exact projective scaling factor for the graph. -/
theorem graphTensor_normalized (A : Matrix (Cell n) J K) (p : Cell n)
    (x : Variables n → K) (hp : ∀ i,x ⟨i,p i⟩≠0) :
    graphTensor A x=(∏ i,x ⟨i,p i⟩)^2 •
      graphTensor A (chartVector p (chartCoordinates p x)) := by
  rw [← graphTensor_scaleFactors,scale_normalized p x hp]

/-- The exact projective scaling factor for a rank-one tensor. -/
theorem rankOneTensor_normalized (p : Cell n) (x : Variables n → K) (y : J → K)
    (hp : ∀ i,x ⟨i,p i⟩≠0) :
    rankOneTensor x y=(∏ i,x ⟨i,p i⟩) •
      rankOneTensor (chartVector p (chartCoordinates p x)) y := by
  rw [← rankOneTensor_scaleFactors,scale_normalized p x hp]

theorem rankOneTensor_mem_iff_normalized
    (S : Submodule K (Matrix (Cell n) J K)) (p : Cell n)
    (x : Variables n → K) (y : J → K) (hp : ∀ i,x ⟨i,p i⟩≠0) :
    rankOneTensor x y ∈ S ↔ rankOneTensor (chartVector p (chartCoordinates p x)) y ∈ S := by
  rw [rankOneTensor_normalized p x y hp]
  exact S.smul_mem_iff (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i))

/-- Membership in any linear subspace is independent of chart normalization. -/
theorem graphTensor_mem_iff_normalized (A : Matrix (Cell n) J K)
    (S : Submodule K (Matrix (Cell n) J K)) (p : Cell n)
    (x : Variables n → K) (hp : ∀ i,x ⟨i,p i⟩≠0) :
    graphTensor A x ∈ S ↔ graphTensor A (chartVector p (chartCoordinates p x)) ∈ S := by
  rw [graphTensor_normalized A p x hp]
  exact S.smul_mem_iff (pow_ne_zero 2 (Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)))

/-- A linear form vanishes on an arbitrary graph representative if and only if
it vanishes on the normalized representative. -/
theorem covector_graphTensor_zero_iff_normalized (A : Matrix (Cell n) J K)
    (φ : Module.Dual K (Matrix (Cell n) J K)) (p : Cell n)
    (x : Variables n → K) (hp : ∀ i,x ⟨i,p i⟩≠0) :
    φ (graphTensor A x)=0 ↔ φ (graphTensor A (chartVector p (chartCoordinates p x)))=0 :=
  graphTensor_mem_iff_normalized A (LinearMap.ker φ) p x hp

end PaperVerification.Segre.ProjectiveCharts

end SegreProjectiveCharts

section SegreReducedPointSpan

/-!
# Reduced affine zero schemes and their actual evaluation spans

The linear equations of the span of actual rational points are identified
with membership in the actual defining ideal.  The radical is retained until
reducedness of the quotient is supplied, and the Nullstellensatz is invoked
with its algebraic-closure and finite-variable hypotheses explicitly present.
This is a local ingredient for the projective singular-span argument, not
the global graph-span theorem.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ReducedPointSpan

variable {K σ V : Type*} [Field K] [IsAlgClosed K] [Finite σ]
  [AddCommGroup V] [Module K V]

/-- Evaluation of actual polynomial sections as a covector. -/
def evaluation (f : V →ₗ[K] MvPolynomial σ K) (x : σ → K) : Module.Dual K V :=
  (MvPolynomial.aeval x).toLinearMap.comp f

@[simp]
theorem evaluation_apply (f : V →ₗ[K] MvPolynomial σ K) (x : σ → K) (v : V) :
    evaluation f x v = MvPolynomial.aeval x (f v) := rfl

/-- The span of actual evaluation covectors on every rational point of the
affine scheme cut out by the given ideal. -/
def zeroLocusSpan (f : V →ₗ[K] MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) : Submodule K (Module.Dual K V) :=
  Submodule.span K (Set.range fun x : MvPolynomial.zeroLocus K I =>
    evaluation f x.val)

/-- Vanishing on the point span is exactly membership in the radical;
no assumption of point-separation or of the desired annihilator identity is used. -/
theorem mem_coannihilator_iff (f : V →ₗ[K] MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) (v : V) :
    v ∈ (zeroLocusSpan f I).dualCoannihilator ↔ f v ∈ I.radical := by
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := K) I,
    MvPolynomial.mem_vanishingIdeal_iff, Submodule.mem_dualCoannihilator]
  constructor
  · intro hv x hx
    exact hv (evaluation f x) (Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩)
  · intro hv φ hφ
    change φ ∈ Submodule.span K (Set.range fun x : MvPolynomial.zeroLocus K I =>
      evaluation f x.val) at hφ
    induction hφ using Submodule.span_induction with
    | mem φ hφ =>
      obtain ⟨x, rfl⟩ := hφ
      exact hv x.val x.property
    | zero => rfl
    | add φ ψ _ _ hφ hψ =>
      exact (LinearMap.add_apply φ ψ v).trans (by rw [hφ, hψ, zero_add])
    | smul c φ _ hφ =>
      exact (LinearMap.smul_apply c φ v).trans (by rw [hφ, smul_zero])

/-- Equality of the actual subspaces before assuming reducedness. -/
theorem coannihilator_eq_radical_comap (f : V →ₗ[K] MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) :
    (zeroLocusSpan f I).dualCoannihilator =
      (I.radical.restrictScalars K).comap f := by
  ext v
  exact mem_coannihilator_iff f I v

/-- On a reduced affine scheme, pointwise vanishing is membership in the
defining ideal itself, in every characteristic. -/
theorem coannihilator_eq_comap (f : V →ₗ[K] MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) [IsReduced (MvPolynomial σ K ⧸ I)] :
    (zeroLocusSpan f I).dualCoannihilator =
      (I.restrictScalars K).comap f := by
  have hI : I.IsRadical := (Ideal.isRadical_iff_quotient_reduced I).mpr inferInstance
  rw [coannihilator_eq_radical_comap, hI.radical]

end PaperVerification.Segre.ReducedPointSpan

end SegreReducedPointSpan

section SegreSpanDefect

/-!
# Actual tensor annihilators and the finite-dimensional span defect

All spaces below are the literal coefficient, graph, critical, and singular
spaces from the contraction definitions.  The geometric annihilator identity
is displayed as a hypothesis only in the final conversion lemmas.  It is not
proved by this file and these lemmas are not Proposition 2.1.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.SpanDefect

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph SingularSpan
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The coefficient tuple is the actual covector on the full tensor space,
via the finite-dimensional double-dual identification and the proved
coordinate pairing. -/
def coefficientDualEquiv :
    (J × Cell n → K) ≃ₗ[K] Module.Dual K (Matrix (Cell n) J K) :=
  (Module.evalEquiv K (J × Cell n → K)).trans tensorCovectorEquiv.dualMap

@[simp]
theorem coefficientDualEquiv_apply (c : J × Cell n → K)
    (B : Matrix (Cell n) J K) :
    coefficientDualEquiv c B = tensorCovector B c := rfl

/-- Actual multiplication with its source expressed as tensor covectors. -/
def multiplicationOnCovectors (A : Matrix (Cell n) J K) :
    Module.Dual K (Matrix (Cell n) J K) →ₗ[K] degreeTwo (K := K) (n := n) :=
  (actualMultiplication A).comp coefficientDualEquiv.symm.toLinearMap

/-- The small-factor critical relation space is the actual dual range. -/
def smallRelations (A : Matrix (Cell n) J K) :
    Submodule K (Module.Dual K (Matrix (Cell n) J K)) :=
  LinearMap.range (criticalOperator A).dualMap

/-- The last-factor critical relation space is also the actual dual range. -/
def lastRelations (A : Matrix (Cell n) J K) :
    Submodule K (Module.Dual K (Matrix (Cell n) J K)) :=
  LinearMap.range (lastCriticalOperator A).dualMap

theorem smallRelations_coannihilator (A : Matrix (Cell n) J K) :
    (smallRelations A).dualCoannihilator = criticalSpace A := by
  rw [smallRelations,LinearMap.range_dualMap_eq_dualAnnihilator_ker,
    Subspace.dualAnnihilator_dualCoannihilator_eq]
  rfl

theorem fullCriticalSpace_annihilator (A : Matrix (Cell n) J K) :
    (fullCriticalSpace A).dualAnnihilator = smallRelations A ⊔ lastRelations A := by
  rw [fullCriticalSpace,Subspace.dualAnnihilator_inf_eq]
  simp only [smallRelations,lastRelations,criticalSpace,
    LinearMap.range_dualMap_eq_dualAnnihilator_ker]

/-- The actual graph equations are precisely the actual multiplication
kernel.  Polynomial evaluation on nonzero factor tuples proves both directions. -/
theorem graphSpan_annihilator [Infinite K] (A : Matrix (Cell n) J K) :
    (graphSpan A).dualAnnihilator = LinearMap.ker (multiplicationOnCovectors A) := by
  ext φ
  let c := coefficientDualEquiv.symm φ
  have hφ (B : Matrix (Cell n) J K) : φ B = tensorCovector B c := by
    rw [← coefficientDualEquiv.apply_symm_apply φ]
    rfl
  have he (x : FactorPoint n K) :
      φ (graphTensor A x.val) = evaluationCovector x.val (actualMultiplication A c) := by
    rw [hφ,← dual_multiplication_evaluation]
    rfl
  change φ ∈ (graphSpan A).dualAnnihilator ↔ actualMultiplication A c = 0
  rw [Submodule.mem_dualAnnihilator]
  constructor
  · intro h
    by_contra hn
    obtain ⟨x,hx⟩ := exists_nonzero_evaluation (actualMultiplication A c) hn
    exact hx ((he x).symm.trans (h _ (Submodule.subset_span ⟨x,rfl⟩)))
  · intro hc
    intro B hB
    induction hB using Submodule.span_induction with
    | mem B hB =>
      obtain ⟨x,rfl⟩ := hB
      rw [he,hc,map_zero]
    | zero => exact map_zero φ
    | add B C _ _ hB hC => rw [map_add,hB,hC,add_zero]
    | smul a B _ hB => rw [map_smul,hB,smul_zero]

/-- Hence the graph is the actual coannihilator of the multiplication kernel. -/
theorem graphSpan_eq_coannihilator [Infinite K] (A : Matrix (Cell n) J K) :
    graphSpan A = (LinearMap.ker (multiplicationOnCovectors A)).dualCoannihilator := by
  rw [← graphSpan_annihilator,Subspace.dualAnnihilator_dualCoannihilator_eq]

/-- The last-factor equations really lie in the multiplication kernel;
this follows from their already-proved vanishing on every graph tensor. -/
theorem lastRelations_le_kernel [Infinite K] (A : Matrix (Cell n) J K) :
    lastRelations A ≤ LinearMap.ker (multiplicationOnCovectors A) := by
  rw [← graphSpan_annihilator]
  rintro φ ⟨ψ,rfl⟩
  apply (Submodule.mem_dualAnnihilator _).mpr
  intro B hB
  change ψ (lastCriticalOperator A B) = 0
  rw [show lastCriticalOperator A B = 0 from graphSpan_le_lastCriticalKernel A hB,map_zero]

/-- Changing coefficient coordinates does not change the actual image. -/
theorem range_multiplicationOnCovectors (A : Matrix (Cell n) J K) :
    LinearMap.range (multiplicationOnCovectors A) =
      LinearMap.range (actualMultiplication A) := by
  exact LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _)

/-- The geometric annihilator identity, when proved by the actual
Koszul/cohomology argument, gives the literal singular-span equality. -/
theorem singularSpan_eq_graph_inter_critical_of_annihilator [Infinite K]
    (A : Matrix (Cell n) J K)
    (hgeometry : (singularSpan A).dualAnnihilator =
      LinearMap.ker (multiplicationOnCovectors A) ⊔ smallRelations A) :
    singularSpan A = graphSpan A ⊓ fullCriticalSpace A := by
  rw [← graph_inter_small_eq_full,graphSpan_eq_coannihilator,
    ← smallRelations_coannihilator,← Submodule.dualCoannihilator_sup_eq,
    ← hgeometry,Subspace.dualAnnihilator_dualCoannihilator_eq]

/-- The trace identity then puts the actual tensor in its actual singular
rank-one span.  The geometric premise has not been hidden or weakened. -/
theorem tensor_mem_singularSpan_of_annihilator [Infinite K]
    (A : Matrix (Cell n) J K)
    (hgeometry : (singularSpan A).dualAnnihilator =
      LinearMap.ker (multiplicationOnCovectors A) ⊔ smallRelations A) :
    A ∈ singularSpan A := by
  rw [singularSpan_eq_graph_inter_critical_of_annihilator A hgeometry]
  exact tensor_mem_graph_inter_critical A

/-- A general dimension identity, including the intersection correction
when the small critical equations are not independent after multiplication. -/
theorem singularSpan_dimension_of_annihilator
    (A : Matrix (Cell n) J K)
    (hgeometry : (singularSpan A).dualAnnihilator =
      LinearMap.ker (multiplicationOnCovectors A) ⊔ smallRelations A) :
    Module.finrank K (singularSpan A) + Module.finrank K (smallRelations A) =
      Module.finrank K (LinearMap.range (actualMultiplication A)) +
        Module.finrank K ↥(LinearMap.ker (multiplicationOnCovectors A) ⊓ smallRelations A) := by
  have hdual := Subspace.finrank_add_finrank_dualAnnihilator_eq (singularSpan A)
  rw [hgeometry] at hdual
  have hsup := Submodule.finrank_sup_add_finrank_inf_eq
    (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A)
  have hrank := (multiplicationOnCovectors A).finrank_range_add_finrank_ker
  rw [range_multiplicationOnCovectors,Subspace.dual_finrank_eq] at hrank
  omega

/-- Under injectivity on the actual small-relation space, the dimension
formula is exactly rank of multiplication minus the number of independent
small critical equations. -/
theorem singularSpan_dimension_of_disjoint
    (A : Matrix (Cell n) J K)
    (hgeometry : (singularSpan A).dualAnnihilator =
      LinearMap.ker (multiplicationOnCovectors A) ⊔ smallRelations A)
    (hind : Disjoint (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A)) :
    Module.finrank K (singularSpan A) =
      Module.finrank K (LinearMap.range (actualMultiplication A)) -
        Module.finrank K (smallRelations A) := by
  have h := singularSpan_dimension_of_annihilator A hgeometry
  rw [hind.eq_bot,finrank_bot,add_zero] at h
  omega

/-- The full critical-space defect is the excess multiplication-kernel
dimension beyond the actual last-factor Koszul relations. -/
theorem critical_span_defect_of_annihilator [Infinite K]
    (A : Matrix (Cell n) J K)
    (hgeometry : (singularSpan A).dualAnnihilator =
      LinearMap.ker (multiplicationOnCovectors A) ⊔ smallRelations A)
    (hind : Disjoint (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A)) :
    Module.finrank K (fullCriticalSpace A) - Module.finrank K (singularSpan A) =
      Module.finrank K (LinearMap.ker (multiplicationOnCovectors A)) -
        Module.finrank K (lastRelations A) := by
  have hS := Subspace.finrank_add_finrank_dualAnnihilator_eq (singularSpan A)
  rw [hgeometry] at hS
  have hH := Subspace.finrank_add_finrank_dualAnnihilator_eq (fullCriticalSpace A)
  rw [fullCriticalSpace_annihilator] at hH
  have hRS := Submodule.finrank_sup_add_finrank_inf_eq
    (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A)
  rw [hind.eq_bot,finrank_bot,add_zero] at hRS
  have hCL : Disjoint (smallRelations A) (lastRelations A) :=
    hind.symm.mono_right (lastRelations_le_kernel A)
  have hCS := Submodule.finrank_sup_add_finrank_inf_eq (smallRelations A) (lastRelations A)
  rw [hCL.eq_bot,finrank_bot,add_zero] at hCS
  omega

end PaperVerification.Segre.SpanDefect

end SegreSpanDefect

section SegreProjectivePointSpan

/-!
# The projective singular span from all reduced affine charts

The ideals below are generated by the literal contraction equations restricted
to every standard affine chart of the smaller projective product. The theorem
identifies the annihilator of the ordinary span of actual singular rank-one
tensors with simultaneous ideal membership on these charts. Algebraic closure,
absence of base points, and reducedness are explicit hypotheses. No desired
geometric span identity is built into the definitions.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ProjectivePointSpan

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph SingularSpan
open ProjectiveCharts
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The genuine polynomial coordinate substitution for one product chart. -/
def chartPolynomial (p : Cell n) (q : Variables n) : MvPolynomial (ChartVar p) K :=
  if h : q.2=p q.1 then 1 else MvPolynomial.X ⟨q,h⟩

@[simp] theorem eval_chartPolynomial (p : Cell n) (z : ChartVar p → K)
    (q : Variables n) :
    MvPolynomial.eval z (chartPolynomial p q)=chartVector p z q := by
  by_cases h : q.2=p q.1 <;> simp [chartPolynomial,chartVector,h]

/-- Pullback of polynomial functions by normalized chart coordinates. -/
def chartSubstitution (p : Cell n) :
    MvPolynomial (Variables n) K →ₐ[K] MvPolynomial (ChartVar p) K :=
  MvPolynomial.aeval (chartPolynomial p)

@[simp] theorem eval_chartSubstitution (p : Cell n) (z : ChartVar p → K)
    (f : MvPolynomial (Variables n) K) :
    MvPolynomial.eval z (chartSubstitution p f)=MvPolynomial.eval (chartVector p z) f := by
  apply MvPolynomial.induction_on f
  · intro c
    simp [chartSubstitution]
  · intro a b ha hb
    simp only [map_add,ha,hb]
  · intro a q ha
    have hx : chartSubstitution (K := K) p (MvPolynomial.X q) = chartPolynomial p q := by
      simp [chartSubstitution]
    simp only [map_mul, hx, eval_chartPolynomial, MvPolynomial.eval_X, ha]

/-- Coordinate functions of the actual graph tensor in an affine chart. -/
def chartGraphCoordinate (A : Matrix (Cell n) J K) (p : Cell n)
    (v : Cell n) (j : J) : MvPolynomial (ChartVar p) K :=
  chartSubstitution p (cellPolynomial v*segreForm A j)

@[simp] theorem eval_chartGraphCoordinate (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) (v : Cell n) (j : J) :
    MvPolynomial.eval z (chartGraphCoordinate A p v j)=
      graphTensor A (chartVector p z) v j := by
  simp [chartGraphCoordinate,graphTensor]

/-- The standard coordinate tensor, used only to express ordinary duality. -/
def coordinateTensor (v : Cell n) (j : J) : Matrix (Cell n) J K :=
  Pi.single v (Pi.single j 1)

theorem tensor_coordinate_expansion (B : Matrix (Cell n) J K) :
    B=∑ v,∑ j,B v j • coordinateTensor v j := by
  classical
  ext u r
  have hentry (v : Cell n) (j : J) :
      (B v j • coordinateTensor v j) u r =
        if u = v then if r = j then B v j else 0 else 0 := by
    change B v j * coordinateTensor (K := K) v j u r = _
    by_cases hu : u = v <;> by_cases hr : r = j <;>
      simp [coordinateTensor, Pi.single_apply, hu, hr, eq_comm]
  simp only [Matrix.sum_apply, Finset.sum_apply]
  simp [hentry]

/-- The proved double-dual coordinate equivalence recovers exactly the
ordinary standard-coordinate values of every tensor covector. -/
theorem coefficientDualEquiv_symm_apply
    (φ : Module.Dual K (Matrix (Cell n) J K)) (j : J) (v : Cell n) :
    SpanDefect.coefficientDualEquiv.symm φ (j,v)=φ (coordinateTensor v j) := by
  have h := congrArg (fun ψ : Module.Dual K (Matrix (Cell n) J K) =>
    ψ (coordinateTensor v j)) (SpanDefect.coefficientDualEquiv.apply_symm_apply φ)
  rw [SpanDefect.coefficientDualEquiv_apply] at h
  change (∑ q : J × Cell n, coordinateTensor v j q.2 q.1 *
    SpanDefect.coefficientDualEquiv.symm φ q) = φ (coordinateTensor v j) at h
  have hcoord (u : Cell n) (r : J) :
      coordinateTensor (K := K) v j u r =
        if u = v then (if r = j then (1 : K) else 0) else 0 := by
    by_cases hu : u = v <;> by_cases hr : r = j <;>
      simp [coordinateTensor, Pi.single_apply, hu, hr]
  simpa only [Fintype.sum_prod_type, hcoord, ite_mul, zero_mul, one_mul,
    Finset.sum_ite_eq', Finset.mem_univ, ite_true] using h

/-- A linear form on tensor space restricted to its actual graph in one chart. -/
def chartRestriction (A : Matrix (Cell n) J K) (p : Cell n) :
    Module.Dual K (Matrix (Cell n) J K) →ₗ[K] MvPolynomial (ChartVar p) K where
  toFun φ := ∑ v,∑ j,MvPolynomial.C (φ (coordinateTensor v j))*chartGraphCoordinate A p v j
  map_add' φ ψ := by
    simp only [LinearMap.add_apply,map_add,add_mul,Finset.sum_add_distrib]
  map_smul' c φ := by
    simp only [LinearMap.smul_apply,smul_eq_mul,map_mul,RingHom.id_apply,
      MvPolynomial.smul_eq_C_mul, Finset.mul_sum, mul_assoc] <;> rfl

theorem eval_chartRestriction (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) (φ : Module.Dual K (Matrix (Cell n) J K)) :
    MvPolynomial.eval z (chartRestriction A p φ)=φ (graphTensor A (chartVector p z)) := by
  change MvPolynomial.eval z
    (∑ v,∑ j,MvPolynomial.C (φ (coordinateTensor v j))*chartGraphCoordinate A p v j)=_
  simp only [map_sum,map_mul,MvPolynomial.eval_C,eval_chartGraphCoordinate]
  conv_rhs => rw [tensor_coordinate_expansion (graphTensor A (chartVector p z))]
  simp only [map_sum,map_smul,smul_eq_mul]
  apply Finset.sum_congr rfl
  intro v _
  apply Finset.sum_congr rfl
  intro j _
  exact mul_comm _ _

/-- The restriction polynomial is exactly the chart pullback of the original
Segre multiplication map. Every source coefficient is the value of the
given ordinary tensor covector on its standard coordinate tensor. -/
theorem chartRestriction_eq_multiplication (A : Matrix (Cell n) J K) (p : Cell n)
    (φ : Module.Dual K (Matrix (Cell n) J K)) :
    chartRestriction A p φ=chartSubstitution p
      (actualMultiplication A (fun jv => φ (coordinateTensor jv.2 jv.1))).val := by
  change (∑ v,∑ j,MvPolynomial.C (φ (coordinateTensor v j))*
      chartSubstitution p (cellPolynomial v*segreForm A j))=
    chartSubstitution p (∑ jv : J × Cell n,
      φ (coordinateTensor jv.2 jv.1) • (segreForm A jv.1*cellPolynomial jv.2))
  rw [map_sum,Fintype.sum_prod_type,Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro v _
  apply Finset.sum_congr rfl
  intro j _
  rw [map_smul,map_mul,map_mul,MvPolynomial.smul_eq_C_mul]
  ring

/-- The chart restriction agrees with the multiplication map in the exact
covector coordinates used by the global annihilator and dimension formulas. -/
theorem chartRestriction_eq_multiplicationOnCovectors
    (A : Matrix (Cell n) J K) (p : Cell n)
    (φ : Module.Dual K (Matrix (Cell n) J K)) :
    chartRestriction A p φ=
      chartSubstitution p (SpanDefect.multiplicationOnCovectors A φ).val := by
  rw [chartRestriction_eq_multiplication]
  have hc : (fun jv : J × Cell n => φ (coordinateTensor jv.2 jv.1))=
      SpanDefect.coefficientDualEquiv.symm φ := by
    funext jv
    exact (coefficientDualEquiv_symm_apply φ jv.1 jv.2).symm
  rw [hc]
  rfl

/-- The exact small-mode critical equations on the actual graph. -/
def chartCriticalPolynomial (A : Matrix (Cell n) J K) (p : Cell n)
    (q : CriticalIndex n) : MvPolynomial (ChartVar p) K :=
  ∑ w : OtherCell n q.1,∑ j : J,
    (MvPolynomial.C (A (assemble q.1 q.2.1 w) j)*chartGraphCoordinate A p (assemble q.1 q.2.2 w) j-
     MvPolynomial.C (A (assemble q.1 q.2.2 w) j)*chartGraphCoordinate A p (assemble q.1 q.2.1 w) j)

@[simp] theorem eval_chartCriticalPolynomial (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) (q : CriticalIndex n) :
    MvPolynomial.eval z (chartCriticalPolynomial A p q)=
      criticalOperator A (graphTensor A (chartVector p z)) q := by
  simp only [chartCriticalPolynomial,map_sum,map_sub,map_mul,MvPolynomial.eval_C,
    eval_chartGraphCoordinate,criticalOperator]
  rfl

/-- The polynomial generators are precisely the restrictions of the original
linear critical equations under ordinary duality. -/
theorem chartCriticalPolynomial_eq_restriction [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) (q : CriticalIndex n) :
    chartCriticalPolynomial A p q=
      chartRestriction A p ((LinearMap.proj q).comp (criticalOperator A)) := by
  apply MvPolynomial.funext
  intro z
  rw [eval_chartCriticalPolynomial,eval_chartRestriction]
  rfl

/-- The affine defining ideal, generated independently of any span conclusion. -/
def chartCriticalIdeal (A : Matrix (Cell n) J K) (p : Cell n) :
    Ideal (MvPolynomial (ChartVar p) K) :=
  Ideal.span (Set.range (chartCriticalPolynomial A p))

/-- Points of the chart ideal are exactly the critical graph points. -/
theorem mem_chart_zeroLocus_iff (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) :
    z ∈ MvPolynomial.zeroLocus K (chartCriticalIdeal A p) ↔
      graphTensor A (chartVector p z) ∈ criticalSpace A := by
  rw [chartCriticalIdeal,MvPolynomial.zeroLocus_span]
  change (∀ f ∈ Set.range (chartCriticalPolynomial A p),MvPolynomial.aeval z f=0) ↔
    criticalOperator A (graphTensor A (chartVector p z))=0
  simp only [Set.forall_mem_range,MvPolynomial.aeval_def,
    show algebraMap K K=RingHom.id K from rfl]
  constructor
  · intro h
    funext q
    exact (eval_chartCriticalPolynomial A p z q).symm.trans (h q)
  · intro h q
    exact (eval_chartCriticalPolynomial A p z q).trans (congrFun h q)

/-- The single pivot equation for every free coordinate; there are exactly
`sum nᵢ` of these generators. -/
def pivotCriticalPolynomial (A : Matrix (Cell n) J K) (p : Cell n)
    (q : ChartVar p) : MvPolynomial (ChartVar p) K :=
  chartCriticalPolynomial A p ⟨q.val.1,(q.val.2,p q.val.1)⟩

/-- Every ordered equation is the coordinate combination of two pivot equations. -/
theorem chartCriticalPolynomial_pivot_identity [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n)
    (i : I) (a b : Fin (n i+1)) :
    chartCriticalPolynomial A p ⟨i,(a,b)⟩=
      chartPolynomial p ⟨i,b⟩*chartCriticalPolynomial A p ⟨i,(a,p i)⟩-
        chartPolynomial p ⟨i,a⟩*chartCriticalPolynomial A p ⟨i,(b,p i)⟩ := by
  apply MvPolynomial.funext
  intro z
  simp only [map_sub,map_mul,eval_chartPolynomial,eval_chartCriticalPolynomial,
    criticalOperator_graphTensor,chartVector_pivot]
  ring

/-- Diagonal critical equations are identically zero as polynomials. -/
theorem chartCriticalPolynomial_diagonal (A : Matrix (Cell n) J K)
    (p : Cell n) (i : I) (a : Fin (n i+1)) :
    chartCriticalPolynomial A p ⟨i,(a,a)⟩=0 := by
  simp [chartCriticalPolynomial]

/-- The complete ideal equals the ideal generated by its `sum nᵢ` normalized
pivot equations. This is an equality of ideals, not merely of zero loci. -/
theorem chartCriticalIdeal_eq_pivot_span [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) :
    chartCriticalIdeal A p=Ideal.span (Set.range (pivotCriticalPolynomial A p)) := by
  let J₀ := Ideal.span (Set.range (pivotCriticalPolynomial A p))
  have hpivot (i : I) (a : Fin (n i+1)) :
      chartCriticalPolynomial A p ⟨i,(a,p i)⟩ ∈ J₀ := by
    by_cases ha : a=p i
    · subst a
      rw [chartCriticalPolynomial_diagonal]
      exact J₀.zero_mem
    · exact Ideal.subset_span ⟨⟨⟨i,a⟩,ha⟩,rfl⟩
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨i,a,b⟩,rfl⟩
    rw [chartCriticalPolynomial_pivot_identity]
    exact J₀.sub_mem (J₀.mul_mem_left _ (hpivot i a))
      (J₀.mul_mem_left _ (hpivot i b))
  · apply Ideal.span_le.mpr
    rintro _ ⟨q,rfl⟩
    exact Ideal.subset_span ⟨⟨q.val.1,(q.val.2,p q.val.1)⟩,rfl⟩

/-- Last-mode proportionality gives the literal rescaling between graph and
rank-one tensors. -/
theorem graphTensor_eq_smul_rankOne (A : Matrix (Cell n) J K)
    (x : Variables n → K) (y : J → K) (c : K)
    (hc : ∀ j,lastContraction A x j=c*y j) :
    graphTensor A x=c • rankOneTensor x y := by
  ext v j
  change MvPolynomial.eval x (cellPolynomial v)*lastContraction A x j=
    c*(MvPolynomial.eval x (cellPolynomial v)*y j)
  rw [hc j]
  ring

/-- Every graph representative of a singular tuple is critical. -/
theorem graph_critical_of_singular (A : Matrix (Cell n) J K)
    (x : FactorPoint n K) (y : J → K) (h : IsSingularTuple A x y) :
    graphTensor A x.val ∈ criticalSpace A := by
  obtain ⟨c,hc⟩ := h.2.2
  rw [graphTensor_eq_smul_rankOne A x.val y c hc]
  exact (criticalSpace A).smul_mem c (singular_rankOne_mem_critical A x y h).1

/-- Vanishing on the whole singular span is equivalent to vanishing on its
literal rank-one generators. -/
theorem mem_singular_annihilator_iff (A : Matrix (Cell n) J K)
    (φ : Module.Dual K (Matrix (Cell n) J K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ (x : FactorPoint n K) (y : J → K),IsSingularTuple A x y →
        φ (rankOneTensor x.val y)=0 := by
  rw [Submodule.mem_dualAnnihilator]
  constructor
  · intro h x y hs
    exact h _ (Submodule.subset_span ⟨x,y,hs,rfl⟩)
  · intro h B hB
    change B ∈ Submodule.span K (singularRankOneSet A) at hB
    induction hB using Submodule.span_induction with
    | mem B hB =>
        obtain ⟨x,y,hs,rfl⟩ := hB
        exact h x y hs
    | zero => exact map_zero φ
    | add B C _ _ hB hC => rw [map_add,hB,hC,add_zero]
    | smul c B _ hB => rw [map_smul,hB,smul_zero]

/-- All standard charts, and all actual singular representatives, are included.
The only geometric assumption at this stage is absence of a common slice zero. -/
theorem mem_singular_annihilator_iff_chart_vanishing (A : Matrix (Cell n) J K)
    (hbase : ∀ x : FactorPoint n K,lastContraction A x.val≠0)
    (φ : Module.Dual K (Matrix (Cell n) J K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ (p : Cell n) (z : ChartVar p → K),
        z ∈ MvPolynomial.zeroLocus K (chartCriticalIdeal A p) →
        MvPolynomial.eval z (chartRestriction A p φ)=0 := by
  rw [mem_singular_annihilator_iff]
  constructor
  · intro h p z hz
    rw [eval_chartRestriction]
    let x : FactorPoint n K := chartPoint p z
    have hcrit : graphTensor A x.val ∈ criticalSpace A :=
      (mem_chart_zeroLocus_iff A p z).mp hz
    have hs := (graph_mem_criticalSpace_iff_singular A x (hbase x)).mp hcrit
    exact h x (lastContraction A x.val) hs
  · intro h x y hs
    obtain ⟨p,hp⟩ := exists_pivots x
    let z := chartCoordinates p x.val
    have hcrit : graphTensor A (chartVector p z) ∈ criticalSpace A :=
      (graphTensor_mem_iff_normalized A (criticalSpace A) p x.val hp).mp
        (graph_critical_of_singular A x y hs)
    have hz := h p z ((mem_chart_zeroLocus_iff A p z).mpr hcrit)
    rw [eval_chartRestriction] at hz
    have hzero : φ (graphTensor A x.val)=0 :=
      (covector_graphTensor_zero_iff_normalized A φ p x.val hp).mpr hz
    obtain ⟨c,hc⟩ := hs.2.2
    have hc0 : c≠0 := by
      intro he
      apply hbase x
      funext j
      simpa only [he, zero_mul, Pi.zero_apply] using hc j
    rw [graphTensor_eq_smul_rankOne A x.val y c hc,map_smul,smul_eq_mul] at hzero
    exact (mul_eq_zero.mp hzero).resolve_left hc0

/-- Nullstellensatz on every genuine affine chart: the radical is retained
until reducedness of the chart quotient has actually been supplied. -/
theorem mem_singular_annihilator_iff_chart_radicals [IsAlgClosed K]
    (A : Matrix (Cell n) J K)
    (hbase : ∀ x : FactorPoint n K,lastContraction A x.val≠0)
    (φ : Module.Dual K (Matrix (Cell n) J K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ p : Cell n,chartRestriction A p φ ∈ (chartCriticalIdeal A p).radical := by
  rw [mem_singular_annihilator_iff_chart_vanishing A hbase]
  apply forall_congr'
  intro p
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := K),
    MvPolynomial.mem_vanishingIdeal_iff]
  rfl

/-- Reducedness removes the radical, giving exact membership in the literal
critical ideals. This is the all-chart point-to-ideal bridge used by the
cohomological graph-span argument. -/
theorem mem_singular_annihilator_iff_chart_ideals [IsAlgClosed K]
    (A : Matrix (Cell n) J K)
    (hbase : ∀ x : FactorPoint n K,lastContraction A x.val≠0)
    (hred : ∀ p : Cell n,IsReduced (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p))
    (φ : Module.Dual K (Matrix (Cell n) J K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ p : Cell n,chartRestriction A p φ ∈ chartCriticalIdeal A p := by
  rw [mem_singular_annihilator_iff_chart_radicals A hbase]
  apply forall_congr'
  intro p
  letI := hred p
  have hi : (chartCriticalIdeal A p).IsRadical :=
    (Ideal.isRadical_iff_quotient_reduced _).mpr inferInstance
  rw [hi.radical]

/-- Equality of the actual subspaces, with every chart restriction explicit. -/
theorem singular_annihilator_eq_chart_ideal_intersection [IsAlgClosed K]
    (A : Matrix (Cell n) J K)
    (hbase : ∀ x : FactorPoint n K,lastContraction A x.val≠0)
    (hred : ∀ p : Cell n,IsReduced (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p)) :
    (singularSpan A).dualAnnihilator=
      ⨅ p : Cell n,((chartCriticalIdeal A p).restrictScalars K).comap (chartRestriction A p) := by
  ext φ
  simp only [Submodule.mem_iInf,Submodule.mem_comap,Submodule.restrictScalars_mem]
  exact mem_singular_annihilator_iff_chart_ideals A hbase hred φ

end PaperVerification.Segre.ProjectivePointSpan

end SegreProjectivePointSpan

section SegreAllFactorPointSpan

/-!
# All-factor projective singular span, without a basepoint assumption

A one-dimensional final factor identifies the existing literal singular-span
definition with the full tensor-format problem. Its final proportionality
equation is automatic, even when that contraction is zero. All chart ideals
below are restrictions of the genuine full-factor critical equations. This
provides the point-to-ideal bridge needed in the triangle-inequality regime.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.AllFactorPointSpan

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph SingularSpan
open ProjectiveCharts ProjectivePointSpan
open scoped BigOperators

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

/-- The unique normalized nonzero representative in the one-dimensional factor. -/
def unitVector : Unit → K := fun _ => 1

@[simp] theorem unitVector_apply (u : Unit) : (unitVector : Unit → K) u=1 := rfl

theorem unitVector_ne_zero : (unitVector : Unit → K)≠0 := by
  intro h
  exact one_ne_zero (congrFun h ())

/-- Adding the one-dimensional factor does not add a singular-vector condition. -/
theorem unit_rankOne_critical_iff_singular (A : Matrix (Cell n) Unit K)
    (x : FactorPoint n K) :
    rankOneTensor x.val unitVector ∈ criticalSpace A ↔ IsSingularTuple A x unitVector := by
  constructor
  · intro h
    refine ⟨unitVector_ne_zero,?_,?_⟩
    · intro i
      apply (wedge_zero_iff_proportional (fun a => x.val ⟨i,a⟩)
        (factorContraction A x.val unitVector i) (x.property i)).mp
      intro a b
      have hq := congrFun (show criticalOperator A (rankOneTensor x.val unitVector)=0 from h)
        ⟨i,(a,b)⟩
      rw [criticalOperator_rankOne] at hq
      exact sub_eq_zero.mp hq
    · refine ⟨lastContraction A x.val (),?_⟩
      intro j
      cases j
      simp
  · intro h
    exact (singular_rankOne_mem_critical A x unitVector h).1

/-- Every nonzero last representative differs from the normalized one by a scalar. -/
theorem rankOne_unit_last_scaling (x : Variables n → K) (y : Unit → K) :
    rankOneTensor x y=y () • rankOneTensor x unitVector := by
  funext v j
  cases j
  change MvPolynomial.eval x (cellPolynomial v) * y () =
    y () * (MvPolynomial.eval x (cellPolynomial v) * 1)
  ring

/-- Literal Segre coordinate functions in a normalized chart. -/
def chartSegreCoordinate (p : Cell n) (v : Cell n) : MvPolynomial (ChartVar p) K :=
  chartSubstitution p (cellPolynomial v)

@[simp] theorem eval_chartSegreCoordinate (p : Cell n) (z : ChartVar p → K) (v : Cell n) :
    MvPolynomial.eval z (chartSegreCoordinate p v)=
      rankOneTensor (chartVector p z) unitVector v () := by
  simp [chartSegreCoordinate,rankOneTensor]

/-- Restriction of a linear form to the actual Segre embedding in one chart. -/
def chartRestriction (p : Cell n) :
    Module.Dual K (Matrix (Cell n) Unit K) →ₗ[K] MvPolynomial (ChartVar p) K where
  toFun φ := ∑ v,MvPolynomial.C (φ (coordinateTensor v ()))*chartSegreCoordinate p v
  map_add' φ ψ := by
    simp only [LinearMap.add_apply,map_add,add_mul,Finset.sum_add_distrib]
  map_smul' c φ := by
    simp only [LinearMap.smul_apply,smul_eq_mul,map_mul,RingHom.id_apply,
      MvPolynomial.smul_eq_C_mul, Finset.mul_sum, mul_assoc] <;> rfl

theorem eval_chartRestriction (p : Cell n) (z : ChartVar p → K)
    (φ : Module.Dual K (Matrix (Cell n) Unit K)) :
    MvPolynomial.eval z (chartRestriction p φ)=
      φ (rankOneTensor (chartVector p z) unitVector) := by
  change MvPolynomial.eval z
    (∑ v,MvPolynomial.C (φ (coordinateTensor v ()))*chartSegreCoordinate p v)=_
  simp only [map_sum,map_mul,MvPolynomial.eval_C,eval_chartSegreCoordinate]
  conv_rhs => rw [tensor_coordinate_expansion (rankOneTensor (chartVector p z) unitVector)]
  simp only [Fintype.sum_unique,map_sum,map_smul,smul_eq_mul]
  exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)

/-- Restrict each genuine linear critical equation to the actual Segre chart. -/
def chartCriticalPolynomial (A : Matrix (Cell n) Unit K) (p : Cell n)
    (q : CriticalIndex n) : MvPolynomial (ChartVar p) K :=
  chartRestriction p ((LinearMap.proj q).comp (criticalOperator A))

@[simp] theorem eval_chartCriticalPolynomial (A : Matrix (Cell n) Unit K) (p : Cell n)
    (z : ChartVar p → K) (q : CriticalIndex n) :
    MvPolynomial.eval z (chartCriticalPolynomial A p q)=
      criticalOperator A (rankOneTensor (chartVector p z) unitVector) q := by
  rw [chartCriticalPolynomial,eval_chartRestriction]
  rfl

def chartCriticalIdeal (A : Matrix (Cell n) Unit K) (p : Cell n) :
    Ideal (MvPolynomial (ChartVar p) K) :=
  Ideal.span (Set.range (chartCriticalPolynomial A p))

theorem mem_chart_zeroLocus_iff (A : Matrix (Cell n) Unit K) (p : Cell n)
    (z : ChartVar p → K) :
    z ∈ MvPolynomial.zeroLocus K (chartCriticalIdeal A p) ↔
      rankOneTensor (chartVector p z) unitVector ∈ criticalSpace A := by
  rw [chartCriticalIdeal,MvPolynomial.zeroLocus_span]
  change (∀ f ∈ Set.range (chartCriticalPolynomial A p),MvPolynomial.aeval z f=0) ↔
    criticalOperator A (rankOneTensor (chartVector p z) unitVector)=0
  simp only [Set.forall_mem_range,MvPolynomial.aeval_def,
    show algebraMap K K=RingHom.id K from rfl]
  constructor
  · intro h
    funext q
    exact (eval_chartCriticalPolynomial A p z q).symm.trans (h q)
  · intro h q
    exact (eval_chartCriticalPolynomial A p z q).trans (congrFun h q)

/-- The normalized pivot generators, one for every free chart coordinate. -/
def pivotCriticalPolynomial (A : Matrix (Cell n) Unit K) (p : Cell n)
    (q : ChartVar p) : MvPolynomial (ChartVar p) K :=
  chartCriticalPolynomial A p ⟨q.val.1,(q.val.2,p q.val.1)⟩

theorem chartCriticalPolynomial_pivot_identity [Infinite K]
    (A : Matrix (Cell n) Unit K) (p : Cell n)
    (i : I) (a b : Fin (n i+1)) :
    chartCriticalPolynomial A p ⟨i,(a,b)⟩=
      chartPolynomial p ⟨i,b⟩*chartCriticalPolynomial A p ⟨i,(a,p i)⟩-
        chartPolynomial p ⟨i,a⟩*chartCriticalPolynomial A p ⟨i,(b,p i)⟩ := by
  apply MvPolynomial.funext
  intro z
  simp only [map_sub,map_mul,eval_chartPolynomial,eval_chartCriticalPolynomial,
    criticalOperator_rankOne,chartVector_pivot]
  ring

theorem chartCriticalPolynomial_diagonal [Infinite K]
    (A : Matrix (Cell n) Unit K) (p : Cell n)
    (i : I) (a : Fin (n i+1)) :
    chartCriticalPolynomial A p ⟨i,(a,a)⟩=0 := by
  apply MvPolynomial.funext
  intro z
  simp only [eval_chartCriticalPolynomial,criticalOperator_rankOne,sub_self,map_zero]

/-- The actual all-factor ideal is generated by exactly the pivot equations
of the singular section, not by an enlarged or altered zero scheme. -/
theorem chartCriticalIdeal_eq_pivot_span [Infinite K]
    (A : Matrix (Cell n) Unit K) (p : Cell n) :
    chartCriticalIdeal A p=Ideal.span (Set.range (pivotCriticalPolynomial A p)) := by
  let J₀ := Ideal.span (Set.range (pivotCriticalPolynomial A p))
  have hpivot (i : I) (a : Fin (n i+1)) :
      chartCriticalPolynomial A p ⟨i,(a,p i)⟩ ∈ J₀ := by
    by_cases ha : a=p i
    · subst a
      rw [chartCriticalPolynomial_diagonal]
      exact J₀.zero_mem
    · exact Ideal.subset_span ⟨⟨⟨i,a⟩,ha⟩,rfl⟩
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨i,a,b⟩,rfl⟩
    rw [chartCriticalPolynomial_pivot_identity]
    exact J₀.sub_mem (J₀.mul_mem_left _ (hpivot i a))
      (J₀.mul_mem_left _ (hpivot i b))
  · apply Ideal.span_le.mpr
    rintro _ ⟨q,rfl⟩
    exact Ideal.subset_span ⟨⟨q.val.1,(q.val.2,p q.val.1)⟩,rfl⟩

/-- All-factor singular-span annihilators are detected on every affine chart.
There is no basepoint premise and no assumption about isotropy. -/
theorem mem_singular_annihilator_iff_chart_vanishing
    (A : Matrix (Cell n) Unit K) (φ : Module.Dual K (Matrix (Cell n) Unit K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ (p : Cell n) (z : ChartVar p → K),
        z ∈ MvPolynomial.zeroLocus K (chartCriticalIdeal A p) →
        MvPolynomial.eval z (chartRestriction p φ)=0 := by
  rw [mem_singular_annihilator_iff]
  constructor
  · intro h p z hz
    rw [eval_chartRestriction]
    exact h (chartPoint p z) unitVector
      ((unit_rankOne_critical_iff_singular A _).mp ((mem_chart_zeroLocus_iff A p z).mp hz))
  · intro h x y hs
    have hy : y ()≠0 := by
      intro he
      apply hs.1
      funext j
      cases j
      exact he
    have hcrit : rankOneTensor x.val unitVector ∈ criticalSpace A := by
      apply ((criticalSpace A).smul_mem_iff hy).mp
      rw [← rankOne_unit_last_scaling]
      exact (singular_rankOne_mem_critical A x y hs).1
    obtain ⟨p,hp⟩ := exists_pivots x
    let z := chartCoordinates p x.val
    have hn : rankOneTensor (chartVector p z) unitVector ∈ criticalSpace A :=
      (rankOneTensor_mem_iff_normalized (criticalSpace A) p x.val unitVector hp).mp hcrit
    have hz := h p z ((mem_chart_zeroLocus_iff A p z).mpr hn)
    rw [eval_chartRestriction] at hz
    have hzero : φ (rankOneTensor x.val unitVector)=0 :=
      (rankOneTensor_mem_iff_normalized (LinearMap.ker φ) p x.val unitVector hp).mpr hz
    rw [rankOne_unit_last_scaling,map_smul,hzero,smul_zero]

theorem mem_singular_annihilator_iff_chart_radicals [IsAlgClosed K]
    (A : Matrix (Cell n) Unit K) (φ : Module.Dual K (Matrix (Cell n) Unit K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ p : Cell n,chartRestriction p φ ∈ (chartCriticalIdeal A p).radical := by
  rw [mem_singular_annihilator_iff_chart_vanishing]
  apply forall_congr'
  intro p
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := K),
    MvPolynomial.mem_vanishingIdeal_iff]
  rfl

/-- Reducedness of the genuine full-factor chart schemes removes the radicals. -/
theorem mem_singular_annihilator_iff_chart_ideals [IsAlgClosed K]
    (A : Matrix (Cell n) Unit K)
    (hred : ∀ p : Cell n,IsReduced (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p))
    (φ : Module.Dual K (Matrix (Cell n) Unit K)) :
    φ ∈ (singularSpan A).dualAnnihilator ↔
      ∀ p : Cell n,chartRestriction p φ ∈ chartCriticalIdeal A p := by
  rw [mem_singular_annihilator_iff_chart_radicals]
  apply forall_congr'
  intro p
  letI := hred p
  have hi : (chartCriticalIdeal A p).IsRadical :=
    (Ideal.isRadical_iff_quotient_reduced _).mpr inferInstance
  rw [hi.radical]

theorem singular_annihilator_eq_chart_ideal_intersection [IsAlgClosed K]
    (A : Matrix (Cell n) Unit K)
    (hred : ∀ p : Cell n,IsReduced (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p)) :
    (singularSpan A).dualAnnihilator=
      ⨅ p : Cell n,((chartCriticalIdeal A p).restrictScalars K).comap (chartRestriction p) := by
  ext φ
  simp only [Submodule.mem_iInf,Submodule.mem_comap,Submodule.restrictScalars_mem]
  exact mem_singular_annihilator_iff_chart_ideals A hred φ

end PaperVerification.Segre.AllFactorPointSpan

end SegreAllFactorPointSpan

section SegreAllFactorIncidence

/-!
# Faithful comparison with the full tensor incidence formulation

The one-dimensional-factor presentation is linearly equivalent to the ordinary
coefficient space of the original tensor. Both the rank-one tensors and every
contraction are identified explicitly. The resulting span is exactly the span
of pure tensors from nonzero factor vectors in the literal incidence kernel.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.AllFactorIncidence

open Staircase Monomials GraphSpan CriticalGraph SingularSpan
open ProjectiveCharts ProjectivePointSpan AllFactorPointSpan
open scoped BigOperators

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

/-- The ordinary coordinate equivalence for adjoining a one-dimensional factor. -/
def unitTensorEquiv : (Cell n → K) ≃ₗ[K] Matrix (Cell n) Unit K where
  toFun T v _ := T v
  invFun A v := A v ()
  left_inv _ := rfl
  right_inv A := by
    funext v j
    cases j
    rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Reorganize the original coordinate tuple into its actual factor vectors. -/
def factorVectors (x : Variables n → K) (i : I) (a : Fin (n i+1)) : K := x ⟨i,a⟩

theorem factorVectors_ne_zero (x : FactorPoint n K) (i : I) : factorVectors x.val i≠0 := by
  obtain ⟨a,ha⟩ := x.property i
  intro h
  exact ha (congrFun h a)

/-- The actual pure tensor is the actual rank-one tensor under the coordinate equivalence. -/
theorem unitTensorEquiv_pureTensor (x : Variables n → K) :
    unitTensorEquiv (TangentKernel.pureTensor (factorVectors x))=
      rankOneTensor x unitVector := by
  funext v j
  change (∏ i, x ⟨i, v i⟩) = MvPolynomial.eval x (cellPolynomial v) * 1
  rw [eval_cell_eq_prod, mul_one]

/-- The two literal products over the other tensor slots are identical. -/
theorem otherProduct_assemble (x : Variables n → K) (i : I)
    (a : Fin (n i+1)) (w : OtherCell n i) :
    TangentKernel.otherProduct (factorVectors x) i (assemble i a w)=
      CriticalGraph.otherProduct x i w := by
  classical
  unfold TangentKernel.otherProduct
  rw [Finset.prod_subtype (p := fun j : I => j≠i) (F := inferInstance)
    (Finset.univ.erase i) (by simp)]
  simp only [factorVectors,assemble_other,CriticalGraph.otherProduct]

/-- Exact correspondence of every original factor contraction. -/
theorem contraction_eq_unit_factorContraction (T : Cell n → K)
    (x : Variables n → K) (i : I) (a : Fin (n i+1)) :
    TangentKernel.contraction (factorVectors x) T i a=
      factorContraction (unitTensorEquiv T) x unitVector i a := by
  classical
  unfold TangentKernel.contraction
  rw [← Equiv.sum_comp (Equiv.piSplitAt i (fun h => Fin (n h+1))).symm,
    Fintype.sum_prod_type]
  have hsplit (b : Fin (n i + 1)) (w : OtherCell n i) :
      (Equiv.piSplitAt i (fun h => Fin (n h + 1))).symm (b, w) =
        assemble i b w := rfl
  simp only [hsplit]
  simp [assemble_same,otherProduct_assemble,factorContraction,unitTensorEquiv,unitVector]
  rfl

/-- The complete all-factor singular condition is precisely the literal
incidence kernel, for every nonzero representative and in every characteristic. -/
theorem singularTuple_unit_iff_incidence (T : Cell n → K) (x : FactorPoint n K) :
    IsSingularTuple (unitTensorEquiv T) x unitVector ↔
      TangentKernel.singularIncidenceMap (factorVectors x.val) T=0 := by
  rw [TangentKernel.singularIncidenceMap_eq_zero_iff_of_nonzero
    (factorVectors x.val) T (factorVectors_ne_zero x)]
  constructor
  · intro h i
    obtain ⟨c,hc⟩ := h.2.1 i
    refine ⟨c,?_⟩
    funext a
    rw [contraction_eq_unit_factorContraction]
    exact hc a
  · intro h
    refine ⟨unitVector_ne_zero,?_,?_⟩
    · intro i
      obtain ⟨c,hc⟩ := h i
      refine ⟨c,?_⟩
      intro a
      rw [← contraction_eq_unit_factorContraction]
      exact congrFun hc a
    · refine ⟨lastContraction (unitTensorEquiv T) x.val (),?_⟩
      intro j
      cases j
      simp

/-- Ordinary pure tensors formed from every nonzero factor vector satisfying
the actual tensor incidence equations. -/
def incidencePureTensorSet (T : Cell n → K) : Set (Cell n → K) :=
  {B | ∃ v : ∀ i,Fin (n i+1) → K,
    (∀ i,v i≠0) ∧ TangentKernel.singularIncidenceMap v T=0 ∧ B=TangentKernel.pureTensor v}

def incidencePureTensorSpan (T : Cell n → K) : Submodule K (Cell n → K) :=
  Submodule.span K (incidencePureTensorSet T)

set_option backward.isDefEq.respectTransparency false in
/-- Exact span equivalence; adjoining the one-dimensional factor has changed
neither the singular rank-one tensors nor their ordinary linear span. -/
theorem incidencePureTensorSpan_eq_unit_singularSpan (T : Cell n → K) :
    incidencePureTensorSpan T=
      (singularSpan (unitTensorEquiv T)).map unitTensorEquiv.symm.toLinearMap := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro B ⟨v,hv,hi,rfl⟩
    have hx : ∀ i,∃ a,v i a≠0 := by
      intro i
      by_contra! h
      apply hv i
      funext a
      exact h a
    let x : FactorPoint n K := ⟨fun q => v q.1 q.2,hx⟩
    have hs : IsSingularTuple (unitTensorEquiv T) x unitVector :=
      (singularTuple_unit_iff_incidence T x).mpr hi
    refine ⟨rankOneTensor x.val unitVector,Submodule.subset_span ⟨x,unitVector,hs,rfl⟩,?_⟩
    change unitTensorEquiv.symm (rankOneTensor x.val unitVector) = _
    rw [← unitTensorEquiv_pureTensor,LinearEquiv.symm_apply_apply]
    rfl
  · rw [singularSpan,Submodule.map_span]
    apply Submodule.span_le.mpr
    rintro B ⟨C,⟨x,y,hs,rfl⟩,rfl⟩
    have hy : y ()≠0 := by
      intro he
      apply hs.1
      funext j
      cases j
      exact he
    have hcrit : rankOneTensor x.val unitVector ∈ criticalSpace (unitTensorEquiv T) := by
      apply ((criticalSpace (unitTensorEquiv T)).smul_mem_iff hy).mp
      rw [← rankOne_unit_last_scaling]
      exact (singular_rankOne_mem_critical (unitTensorEquiv T) x y hs).1
    have hi := (singularTuple_unit_iff_incidence T x).mp
      ((unit_rankOne_critical_iff_singular (unitTensorEquiv T) x).mp hcrit)
    change unitTensorEquiv.symm (rankOneTensor x.val y) ∈ incidencePureTensorSpan T
    rw [rankOne_unit_last_scaling,map_smul,← unitTensorEquiv_pureTensor,
      LinearEquiv.symm_apply_apply]
    apply Submodule.smul_mem
    exact Submodule.subset_span ⟨factorVectors x.val,factorVectors_ne_zero x,hi,rfl⟩

end PaperVerification.Segre.AllFactorIncidence

end SegreAllFactorIncidence

section SegreCriticalChartReindex

/-!
# All standard pivots are the normalized incidence charts

The arbitrary pivot in every numerical tensor factor is explicitly reindexed
as the distinguished `none` coordinate. The polynomial-variable equivalence
and tensor-coordinate equivalence identify the actual pivot critical ideals,
so generic finiteness and reducedness of the normalized incidence quotients
transfer to every chart used in the all-factor singular-span theorem.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.CriticalChartReindex

open Staircase CriticalGraph SingularSpan ProjectiveCharts ProjectivePointSpan
open AllFactorIncidence MvPolynomial
open scoped BigOperators

section General

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
  {σ τ : ι → Type*} [∀ i,Fintype (σ i)] [∀ i,Fintype (τ i)]
  {R : Type*} [CommRing R]

/-- Every coordinate of the literal contraction commutes with independently
reindexing the coordinates of all tensor factors. -/
theorem contraction_piCongr (e : ∀ i,σ i ≃ τ i)
    (v : ∀ i,τ i → R) (T : (∀ i,τ i) → R) (i : ι) (a : σ i) :
    TangentKernel.contraction (fun i b => v i (e i b))
      (fun b => T (Equiv.piCongrRight e b)) i a=
        TangentKernel.contraction v T i (e i a) := by
  classical
  unfold TangentKernel.contraction
  rw [← Equiv.sum_comp (Equiv.piCongrRight e)]
  apply Finset.sum_congr rfl
  intro b _
  simp only [Equiv.piCongrRight_apply, Pi.map_apply, Equiv.apply_eq_iff_eq,
    TangentKernel.otherProduct]

end General

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

abbrev FreeFactor (p : Cell n) (i : I) := {a : Fin (n i+1) // a≠p i}

def tensorCellEquiv (p : Cell n) :
    CriticalChart.TensorCell (σ := FreeFactor p) ≃ Cell n :=
  Equiv.piCongrRight (fun i => Equiv.optionSubtypeNe (p i))

def normalizedTensor (T : Cell n → K) (p : Cell n) :
    CriticalChart.TensorCell (σ := FreeFactor p) → K := fun b => T (tensorCellEquiv p b)

/-- This equality retains the actual normalized factor vectors in every
coordinate, including the pivot rather than only the free coordinates. -/
theorem pointVector_eq_reindex (p : Cell n) (z : ChartVar p → K) :
    CriticalChart.pointVector (fun q => z ((chartVarEquiv p).symm q))=
      (fun i a => factorVectors (chartVector p z) i (Equiv.optionSubtypeNe (p i) a)) := by
  funext i a
  cases a with
  | none => simp [CriticalChart.pointVector,factorVectors]
  | some a =>
      simp [CriticalChart.pointVector,factorVectors,chartVector,chartVarEquiv,a.property]

/-- The normalized incidence equation is exactly the literal all-factor
pivot critical polynomial after the explicit polynomial-variable renaming. -/
theorem rename_criticalEquation [Infinite K] (T : Cell n → K) (p : Cell n)
    (q : CriticalChart.Coordinate (σ := FreeFactor p)) :
    MvPolynomial.rename (chartVarEquiv p).symm
      (CriticalChart.criticalEquation (normalizedTensor T p) q)=
        AllFactorPointSpan.pivotCriticalPolynomial (unitTensorEquiv T) p
          ((chartVarEquiv p).symm q) := by
  apply MvPolynomial.funext
  intro z
  rw [MvPolynomial.eval_rename, CriticalChart.eval_criticalEquation]
  dsimp only [Function.comp_def]
  rw [pointVector_eq_reindex]
  change TangentKernel.contraction
      (fun i a => factorVectors (chartVector p z) i (Equiv.optionSubtypeNe (p i) a))
      (fun b => T (Equiv.piCongrRight (fun i => Equiv.optionSubtypeNe (p i)) b))
      q.1 (some q.2)-
    z ((chartVarEquiv p).symm q)*
      TangentKernel.contraction
        (fun i a => factorVectors (chartVector p z) i (Equiv.optionSubtypeNe (p i) a))
        (fun b => T (Equiv.piCongrRight (fun i => Equiv.optionSubtypeNe (p i)) b))
        q.1 none=_
  rw [contraction_piCongr,contraction_piCongr]
  simp only [Equiv.optionSubtypeNe_some,Equiv.optionSubtypeNe_none]
  rw [contraction_eq_unit_factorContraction,contraction_eq_unit_factorContraction]
  rw [AllFactorPointSpan.pivotCriticalPolynomial,
    AllFactorPointSpan.eval_chartCriticalPolynomial,criticalOperator_rankOne]
  simp [chartVarEquiv,chartVector,q.2.property]

/-- The whole actual defining ideal is preserved under the chart equivalence. -/
theorem map_criticalIdeal [Infinite K] (T : Cell n → K) (p : Cell n) :
    (Ideal.span (Set.range (CriticalChart.criticalEquation (normalizedTensor T p)))).map
      (MvPolynomial.rename (R := K) (chartVarEquiv p).symm).toRingHom=
        AllFactorPointSpan.chartCriticalIdeal (unitTensorEquiv T) p := by
  rw [Ideal.map_span,← Set.range_comp,AllFactorPointSpan.chartCriticalIdeal_eq_pivot_span]
  apply congrArg Ideal.span
  ext f
  constructor
  · rintro ⟨q,rfl⟩
    exact ⟨(chartVarEquiv p).symm q,(rename_criticalEquation T p q).symm⟩
  · rintro ⟨q,rfl⟩
    refine ⟨chartVarEquiv p q,?_⟩
    change MvPolynomial.rename (chartVarEquiv p).symm
      (CriticalChart.criticalEquation (normalizedTensor T p) (chartVarEquiv p q)) = _
    simpa only [Equiv.symm_apply_apply] using
      rename_criticalEquation T p (chartVarEquiv p q)

/-- This is an algebra equivalence of the actual full normalized incidence
quotient and the actual all-factor chart quotient, retaining all nilpotents. -/
def chartQuotientEquiv [Infinite K] (T : Cell n → K) (p : Cell n) :
    (MvPolynomial (CriticalChart.Coordinate (σ := FreeFactor p)) K ⧸
      Ideal.span (Set.range (CriticalChart.criticalEquation (normalizedTensor T p)))) ≃ₐ[K]
    (MvPolynomial (ChartVar p) K ⧸ AllFactorPointSpan.chartCriticalIdeal (unitTensorEquiv T) p) :=
  Ideal.quotientEquivAlg _ _ (MvPolynomial.renameEquiv K (chartVarEquiv p).symm)
    (map_criticalIdeal T p).symm

end PaperVerification.Segre.CriticalChartReindex

end SegreCriticalChartReindex

section SegreAllChartGenericity

/-!
# One common nonempty open for every literal projective critical chart

The generic normalized-chart certificate is renamed by the actual complete
coefficient permutation at every pivot. Multiplying this finite family gives
one nonzero polynomial in the original tensor coordinates. The proved chart
quotient algebra equivalence transfers finiteness and reducedness to all
literal ideals used by the projective singular-span theorem.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.AllChartGenericity

open Staircase ProjectiveCharts AllFactorIncidence CriticalChartReindex
open AllFactorPointSpan MvPolynomial
open scoped BigOperators

variable {I K : Type} [Fintype I] [DecidableEq I] [Field K] [Infinite K]
  {n : I → ℕ}

/-- All standard affine charts of every tensor format are finite and reduced
on one actual nonzero-polynomial open in the full coefficient space. No
positivity condition on the projective dimensions is required. -/
theorem exists_all_chart_certificate :
    ∃ r : MvPolynomial (Cell n) K,r≠0 ∧
      ∀ T : Cell n → K,aeval T r≠0 →
        ∀ p : Cell n,
          Module.Finite K
            (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal (unitTensorEquiv T) p) ∧
          IsReduced
            (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal (unitTensorEquiv T) p) := by
  classical
  choose r hr hw using fun p : Cell n =>
    GenericChartCertificate.exists_finite_reduced_certificate
      (K := K) (ι := I) (σ := FreeFactor p)
  let f (p : Cell n) : MvPolynomial (Cell n) K := rename (tensorCellEquiv p) (r p)
  have hf (p : Cell n) : f p≠0 := by
    intro h
    exact hr p ((rename_eq_zero_iff_of_injective (r p) (tensorCellEquiv p).injective).mp h)
  refine ⟨∏ p,f p,Finset.prod_ne_zero_iff.mpr (fun p _ => hf p),?_⟩
  intro T hT p
  rw [map_prod] at hT
  have hp := Finset.prod_ne_zero_iff.mp hT p (Finset.mem_univ p)
  have h := hw p (normalizedTensor T p) (by
    change aeval (fun b => T (tensorCellEquiv p b)) (r p) ≠ 0
    simpa only [f, aeval_rename, Function.comp_def] using hp)
  letI : Module.Finite K
      (MvPolynomial (CriticalChart.Coordinate (σ := FreeFactor p)) K ⧸
        Ideal.span (Set.range (CriticalChart.criticalEquation (normalizedTensor T p)))) := by
    exact h.1
  letI : IsReduced
      (MvPolynomial (CriticalChart.Coordinate (σ := FreeFactor p)) K ⧸
        Ideal.span (Set.range (CriticalChart.criticalEquation (normalizedTensor T p)))) := by
    exact h.2
  exact ⟨Module.Finite.of_surjective (chartQuotientEquiv T p).toLinearMap
      (chartQuotientEquiv T p).surjective,
    isReduced_of_injective (chartQuotientEquiv T p).symm
      (chartQuotientEquiv T p).symm.injective⟩

/-- The simultaneous chart certificate has an actual nonzero evaluation;
its genericity does not rely on an empty principal open. -/
theorem exists_nonempty_all_chart_certificate :
    ∃ r : MvPolynomial (Cell n) K,r≠0 ∧
      (∃ T : Cell n → K,aeval T r≠0) ∧
      ∀ T : Cell n → K,aeval T r≠0 →
        ∀ p : Cell n,
          Module.Finite K
            (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal (unitTensorEquiv T) p) ∧
          IsReduced
            (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal (unitTensorEquiv T) p) := by
  obtain ⟨r,hr,hw⟩ := exists_all_chart_certificate (K := K) (n := n)
  refine ⟨r,hr,?_,hw⟩
  by_contra h
  push_neg at h
  apply hr
  apply MvPolynomial.funext
  intro T
  simpa only [MvPolynomial.aeval_eq_eval, map_zero] using h T

/-- The literal point span is generically detected by the unreduced defining
ideals themselves on all charts; reducedness is proved, not hypothesized. -/
theorem generic_singular_annihilator_eq_chart_ideal_intersection [IsAlgClosed K] :
    ∃ r : MvPolynomial (Cell n) K,r≠0 ∧
      ∀ T : Cell n → K,aeval T r≠0 →
        (SingularSpan.singularSpan (unitTensorEquiv T)).dualAnnihilator=
          ⨅ p : Cell n,
            ((chartCriticalIdeal (unitTensorEquiv T) p).restrictScalars K).comap
              (AllFactorPointSpan.chartRestriction p) := by
  obtain ⟨r,hr,hw⟩ := exists_all_chart_certificate (K := K) (n := n)
  refine ⟨r,hr,?_⟩
  intro T hT
  exact singular_annihilator_eq_chart_ideal_intersection (unitTensorEquiv T)
    (fun p => (hw T hT p).2)

end PaperVerification.Segre.AllChartGenericity

end SegreAllChartGenericity

end SegreCriticalCharts

end
