section SegreExternalSections

/-!
# The actual external-product map on local sections

This file constructs the canonical base-linear map from factor sections to
sections of the external tensor product on every rectangle.  Restriction
naturality is proved on actual sheaf sections.  These are the maps needed
for the horizontal and vertical differentials of the product Čech comparison.
-/


set_option backward.isDefEq.respectTransparency false
open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open CategoryTheory.Functor.LaxMonoidal
open scoped TensorProduct

namespace PaperVerification.Segre.ExternalSections

universe u
variable (R : Type u) [CommRing R]
variable {X : Scheme.{u}} [X.Over (Spec (.of R))]

/-- The usual module of sections with its canonical base-ring action. -/
abbrev sections (M : X.Modules) (U : X.Opens) : ModuleCat.{u} R :=
  ((sectionsBasePresheafFunctor R).obj M).obj (op U)

/-- Forgetting sheafness retains the actual tensor-section comparison. -/
def forgetModules :
    X.Modules ⥤ PresheafOfModulesOfCommRing.{u} X.presheaf :=
  _root_.SheafOfModules.forget X.ringCatSheaf

instance forgetModules_laxMonoidal : (forgetModules (X := X)).LaxMonoidal :=
  TauCeti.SheafOfModules.forgetLaxMonoidal X.sheaf

/-- Evaluate the genuine sheaf sections and restrict their scalars along the base-ring map. -/
def baseSections (U : X.Opens) : X.Modules ⥤ ModuleCat.{u} R :=
  forgetModules ⋙ TauCeti.PresheafOfModulesOfCommRing.evaluation (op U) ⋙
    ModuleCat.restrictScalars ((X.baseRingToStructurePresheaf R).app (op U)).hom

instance baseSections_laxMonoidal (U : X.Opens) :
    (baseSections R U).LaxMonoidal := by
  unfold baseSections
  infer_instance

/-- The canonical product of two local sections in the actual sheaf tensor. -/
def sectionProduct (M N : X.Modules) (U : X.Opens) :
    sections R M U →ₗ[R] sections R N U →ₗ[R] sections R (M ⊗ N) U :=
  TensorProduct.curry (μ (baseSections R U) M N).hom

@[simp] theorem sectionProduct_apply (M N : X.Modules) (U : X.Opens)
    (m : Γ(M,U)) (n : Γ(N,U)) :
    sectionProduct R M N U m n =
      ((μ forgetModules M N).app' (op U)).hom (m ⊗ₜ[Γ(X,U)] n) := by
  exact congrArg (fun x ↦ ((μ forgetModules M N).app' (op U)).hom x)
    (ModuleCat.restrictScalars_μ_tmul
      ((X.baseRingToStructurePresheaf R).app (op U)).hom _ _ m n)

/-- Products of local sections commute with actual restriction. -/
theorem sectionProduct_restrict (M N : X.Modules) {U V : X.Opens} (i : V ⟶ U)
    (m : sections R M U) (n : sections R N U) :
    ((sectionsBasePresheafFunctor R).obj (M ⊗ N)).map i.op
        (sectionProduct R M N U m n) =
      sectionProduct R M N V
        (((sectionsBasePresheafFunctor R).obj M).map i.op m)
        (((sectionsBasePresheafFunctor R).obj N).map i.op n) := by
  change (forgetModules.obj (M ⊗ N)).map i.op
      (sectionProduct R M N U m n) =
    sectionProduct R M N V ((forgetModules.obj M).map i.op m)
      ((forgetModules.obj N).map i.op n)
  erw [sectionProduct_apply, sectionProduct_apply]
  rw [← PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul]
  exact (PresheafOfModulesOfCommRing.naturality_apply
    (μ forgetModules M N) i.op
    ((show Γ(M,U) from m) ⊗ₜ[Γ(X,U)] (show Γ(N,U) from n))).symm

section Pullback

variable {Y : Scheme.{u}} [Y.Over (Spec (.of R))]
  (f : Y ⟶ X) [f.IsOver (Spec (.of R))]

/-- Genuine pullback of local sections is linear over the base ring. -/
def pullbackBase (M : X.Modules) (U : X.Opens) :
    sections R M U →ₗ[R]
      sections R ((Scheme.Modules.pullback f).obj M) (f ⁻¹ᵁ U) := by
  letI := sectionsBaseModule R M U
  letI := sectionsBaseModule R ((Scheme.Modules.pullback f).obj M) (f ⁻¹ᵁ U)
  change Γ(M,U) →ₗ[R] Γ((Scheme.Modules.pullback f).obj M, f ⁻¹ᵁ U)
  refine { toFun := f.pullbackSections M U, map_add' := map_add _, map_smul' := ?_ }
  intro r m
  change f.pullbackSections M U
      ((X.baseRingToStructurePresheaf R).app (op U) r • m) =
    (Y.baseRingToStructurePresheaf R).app (op (f ⁻¹ᵁ U)) r • _
  rw [map_smulₛₗ, app_baseRingToStructurePresheaf]

/-- Pullback followed by the literal restriction to a smaller source open. -/
def pullbackBaseLE (M : X.Modules) (U : X.Opens) (W : Y.Opens)
    (h : W ≤ f ⁻¹ᵁ U) :
    sections R M U →ₗ[R] sections R ((Scheme.Modules.pullback f).obj M) W :=
  (((sectionsBasePresheafFunctor R).obj ((Scheme.Modules.pullback f).obj M)).map
    (homOfLE h).op).hom ∘ₗ pullbackBase R f M U

@[simp]
theorem pullbackBaseLE_apply (M : X.Modules) (U : X.Opens) (W : Y.Opens)
    (h : W ≤ f ⁻¹ᵁ U) (m : sections R M U) :
    pullbackBaseLE R f M U W h m = f.pullbackSectionsLE M U W h m := by
  rw [Scheme.Hom.pullbackSectionsLE_apply]
  rfl

/-- Both routes around an inclusion of rectangles pull back and restrict
the same actual local section. -/
theorem pullbackBaseLE_restrict (M : X.Modules)
    {U U' : X.Opens} {W W' : Y.Opens}
    (hU : U' ≤ U) (hW : W' ≤ W) (h : W ≤ f ⁻¹ᵁ U)
    (h' : W' ≤ f ⁻¹ᵁ U') (m : sections R M U) :
    ((sectionsBasePresheafFunctor R).obj ((Scheme.Modules.pullback f).obj M)).map (homOfLE hW).op
        (pullbackBaseLE R f M U W h m) =
      pullbackBaseLE R f M U' W' h'
        (((sectionsBasePresheafFunctor R).obj M).map (homOfLE hU).op m) := by
  change ((Scheme.Modules.pullback f).obj M).presheaf.map (homOfLE hW).op
      (((Scheme.Modules.pullback f).obj M).presheaf.map (homOfLE h).op (f.pullbackSections M U m)) =
    ((Scheme.Modules.pullback f).obj M).presheaf.map (homOfLE h').op
      (f.pullbackSections M U' (M.presheaf.map (homOfLE hU).op m))
  rw [← f.pullbackSections_restrict M U (homOfLE hU)]
  rw [← CategoryTheory.Functor.map_comp_apply, ← CategoryTheory.Functor.map_comp_apply]
  congr 2

end Pullback

section External

variable {Y P : Scheme.{u}}
  [Y.Over (Spec (.of R))] [P.Over (Spec (.of R))]
  (f : P ⟶ X) (g : P ⟶ Y)
  [f.IsOver (Spec (.of R))] [g.IsOver (Spec (.of R))]
  (M : X.Modules) (N : Y.Modules)

/-- The actual external tensor product along the two specified morphisms. -/
def externalTensor : P.Modules := (Scheme.Modules.pullback f).obj M ⊗ (Scheme.Modules.pullback g).obj N

/-- The literal intersection on which both pulled-back sections exist. -/
def rectangle (U : X.Opens) (V : Y.Opens) : P.Opens :=
  f ⁻¹ᵁ U ⊓ g ⁻¹ᵁ V

/-- The canonical external-product map, defined on every rectangle without
an affineness, cohomology, or genericity hypothesis. -/
def externalProduct (U : X.Opens) (V : Y.Opens) :
    sections R M U ⊗[R] sections R N V →ₗ[R]
      sections R (externalTensor f g M N) (rectangle f g U V) :=
  TensorProduct.lift
    ((sectionProduct R ((Scheme.Modules.pullback f).obj M) ((Scheme.Modules.pullback g).obj N)
      (rectangle f g U V)).compl₁₂
        (pullbackBaseLE R f M U _ inf_le_left)
        (pullbackBaseLE R g N V _ inf_le_right))

@[simp]
theorem externalProduct_tmul (U : X.Opens) (V : Y.Opens)
    (m : sections R M U) (n : sections R N V) :
    externalProduct R f g M N U V (m ⊗ₜ[R] n) =
      sectionProduct R ((Scheme.Modules.pullback f).obj M) ((Scheme.Modules.pullback g).obj N) _
        (pullbackBaseLE R f M U _ inf_le_left m)
        (pullbackBaseLE R g N V _ inf_le_right n) := rfl

set_option maxHeartbeats 400000 in
/-- The actual restriction identity on a pure tensor, with all section
modules fixed before comparing the two pullback restrictions. -/
theorem externalProduct_restrict_tmul {U U' : X.Opens} {V V' : Y.Opens}
    (hU : U' ≤ U) (hV : V' ≤ V) (m : sections R M U) (n : sections R N V) :
    (((sectionsBasePresheafFunctor R).obj (externalTensor f g M N)).map
        (homOfLE (inf_le_inf (f.preimage_mono hU) (g.preimage_mono hV))).op)
        (externalProduct R f g M N U V (m ⊗ₜ[R] n)) =
      externalProduct R f g M N U' V'
        ((((sectionsBasePresheafFunctor R).obj M).map (homOfLE hU).op m) ⊗ₜ[R]
          (((sectionsBasePresheafFunctor R).obj N).map (homOfLE hV).op n)) := by
  have hm := pullbackBaseLE_restrict R f M
    (U := U) (U' := U') (W := rectangle f g U V) (W' := rectangle f g U' V')
    hU (inf_le_inf (f.preimage_mono hU) (g.preimage_mono hV))
    inf_le_left inf_le_left m
  have hn := pullbackBaseLE_restrict R g N
    (U := V) (U' := V') (W := rectangle f g U V) (W' := rectangle f g U' V')
    hV (inf_le_inf (f.preimage_mono hU) (g.preimage_mono hV))
    inf_le_right inf_le_right n
  have hprod := sectionProduct_restrict R
    ((Scheme.Modules.pullback f).obj M) ((Scheme.Modules.pullback g).obj N)
    (homOfLE (inf_le_inf (f.preimage_mono hU) (g.preimage_mono hV)))
    (pullbackBaseLE R f M U (rectangle f g U V) inf_le_left m)
    (pullbackBaseLE R g N V (rectangle f g U V) inf_le_right n)
  exact hprod.trans (congrArg₂
    (fun m n ↦ sectionProduct R ((Scheme.Modules.pullback f).obj M)
      ((Scheme.Modules.pullback g).obj N) (rectangle f g U' V') m n) hm hn)

/-- The canonical map is compatible with both factor restriction maps. -/
theorem externalProduct_restrict {U U' : X.Opens} {V V' : Y.Opens}
    (hU : U' ≤ U) (hV : V' ≤ V) :
    (((sectionsBasePresheafFunctor R).obj (externalTensor f g M N)).map
        (homOfLE (inf_le_inf (f.preimage_mono hU) (g.preimage_mono hV))).op).hom ∘ₗ
        externalProduct R f g M N U V =
      externalProduct R f g M N U' V' ∘ₗ TensorProduct.map
        ((((sectionsBasePresheafFunctor R).obj M).map (homOfLE hU).op).hom)
        ((((sectionsBasePresheafFunctor R).obj N).map (homOfLE hV).op).hom) := by
  apply TensorProduct.ext'
  intro m n
  exact externalProduct_restrict_tmul R f g M N hU hV m n

end External
end PaperVerification.Segre.ExternalSections

end SegreExternalSections

section SegreAffineTensorProductMap

/-!
# The canonical tensor product of sections on an affine open

The affine tensor equivalence is identified with the literal lax monoidal
map of the forgetful sheaf functor. The proof retains the maps on
generators, so that its naturality under restriction is the naturality of
the canonical map, not an arbitrary choice of module isomorphism.
-/


open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open CategoryTheory.Functor.LaxMonoidal
open AlgebraicGeometry.Scheme.Modules
open scoped TensorProduct

namespace PaperVerification.Segre.AffineTensorProductMap

universe u
variable {X : Scheme.{u}} (M N : X.Modules) (U : X.Opens)

/-- The actual tensor-product map on sections, linear over the full
coordinate ring of the open. -/
def sectionTensorMap :
    Γ(M,U) ⊗[Γ(X,U)] Γ(N,U) →ₗ[Γ(X,U)] Γ(M ⊗ N,U) :=
  ((μ (ExternalSections.forgetModules (X := X)) M N).app' (op U)).hom

/-- The affine isomorphism sends every pure tensor to the canonical
product of the two actual sections. -/
theorem affineTensorSectionsIso_hom_tmul (hU : IsAffineOpen U)
    [M.IsQuasicoherent] [N.IsQuasicoherent]
    (m : Γ(M,U)) (n : Γ(N,U)) :
    (AffineTensorSections.affineTensorSectionsIso hU M N).hom (m ⊗ₜ[Γ(X,U)] n) =
      sectionTensorMap M N U (m ⊗ₜ[Γ(X,U)] n) := by
  let e := AffineTensorSections.chartSectionsIso hU
  apply (ConcreteCategory.bijective_of_isIso (e.app (M ⊗ N)).hom).injective
  change (e.app (M ⊗ N)).hom
      ((e.app (M ⊗ N)).inv
        (AffineTensorSections.globalSections.map (μ (restrictFunctor hU.fromSpec) M N)
          ((AffineTensorSections.tensorSectionsIso
            (M.restrict hU.fromSpec) (N.restrict hU.fromSpec)).hom
            ((e.app M).hom m ⊗ₜ[Γ(X,U)] (e.app N).hom n)))) =
    (e.app (M ⊗ N)).hom (sectionTensorMap M N U (m ⊗ₜ[Γ(X,U)] n))
  rw [Iso.inv_hom_id_apply]
  erw [AffineTensorSections.globalSections_μ_apply]
  change (μ (restrictFunctor hU.fromSpec) M N).val.app (op ⊤)
      ((μ (AffineTensorSections.forgetSpec (R := Γ(X,U)))
        (M.restrict hU.fromSpec) (N.restrict hU.fromSpec)).app' (op ⊤)
        (M.fromSpecSectionsEquiv hU m ⊗ₜ[Γ(Spec Γ(X,U),⊤)]
          N.fromSpecSectionsEquiv hU n)) =
    (M ⊗ N).fromSpecSectionsEquiv hU
      (sectionTensorMap M N U (m ⊗ₜ[Γ(X,U)] n))
  have ht := TauCeti.SheafOfModules.pushforward_μ_app_tmul
    (restrictRingCatSheafHom hU.fromSpec) M N (op ⊤)
    (M.fromSpecSectionsEquiv hU m) (N.fromSpecSectionsEquiv hU n)
  change (μ (restrictFunctor hU.fromSpec) M N).val.app (op ⊤)
      ((μ (AffineTensorSections.forgetSpec (R := Γ(X,U)))
        (M.restrict hU.fromSpec) (N.restrict hU.fromSpec)).app' (op ⊤)
        (M.fromSpecSectionsEquiv hU m ⊗ₜ[Γ(Spec Γ(X,U),⊤)]
          N.fromSpecSectionsEquiv hU n)) =
    (μ (ExternalSections.forgetModules (X := X)) M N).app'
      (op (hU.fromSpec ''ᵁ (⊤ : (Spec Γ(X,U)).Opens)))
      (M.fromSpecSectionsEquiv hU m ⊗ₜ
        N.fromSpecSectionsEquiv hU n) at ht
  rw [ht]
  simp only [fromSpecSectionsEquiv_apply, restrictAppIso, Iso.refl_inv,
    ConcreteCategory.id_apply]
  exact PresheafOfModulesOfCommRing.naturality_apply
    (μ (ExternalSections.forgetModules (X := X)) M N)
    (homOfLE (show hU.fromSpec ''ᵁ (⊤ : (Spec Γ(X,U)).Opens) ≤ U by
      rw [Scheme.Hom.image_top_eq_opensRange, hU.opensRange_fromSpec])).op
    (m ⊗ₜ[Γ(X,U)] n)

/-- Equality of the actual linear maps, rather than merely an unspecified
isomorphism between their source and target modules. -/
theorem sectionTensorMap_eq_affineIso (hU : IsAffineOpen U)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    sectionTensorMap M N U =
      (AffineTensorSections.affineTensorSectionsIso hU M N).hom.hom := by
  apply TensorProduct.ext'
  intro m n
  exact (affineTensorSectionsIso_hom_tmul M N U hU m n).symm

/-- The canonical tensor-product map is bijective on an actual affine open. -/
theorem sectionTensorMap_bijective (hU : IsAffineOpen U)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    Function.Bijective (sectionTensorMap M N U) := by
  rw [sectionTensorMap_eq_affineIso M N U hU]
  exact ConcreteCategory.bijective_of_isIso
    (AffineTensorSections.affineTensorSectionsIso hU M N).hom

end PaperVerification.Segre.AffineTensorProductMap

end SegreAffineTensorProductMap

section SegreAffineRectangleTensor

/-!
# Canonical external sections on every affine rectangle

This is the local comparison needed by the genuine product Čech complex.
The coordinate-ring pushout is derived from the cartesian square of
schemes. Pullback and tensor-section isomorphisms retain the actual
pullback-of-sections and tensor-product maps. Hence the canonical
external-product map itself is bijective, and its already-proved
restriction naturality applies.
-/


open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open scoped TensorProduct ChangeOfRings

namespace PaperVerification.Segre.AffineRectangleTensor

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

universe u
variable (R : Type u) [CommRing R]
  {X Y P : Scheme.{u}}
  [X.Over (Spec (.of R))] [Y.Over (Spec (.of R))] [P.Over (Spec (.of R))]
  (f : P ⟶ X) (g : P ⟶ Y)
  [f.IsOver (Spec (.of R))] [g.IsOver (Spec (.of R))]

/-- The actual local pullback on functions preserves the base-ring map. -/
theorem appLE_baseRing (U : X.Opens) (W : P.Opens)
    (h : W ≤ f ⁻¹ᵁ U) (r : R) :
    f.appLE U W h ((X.baseRingToStructurePresheaf R).app (op U) r) =
      (P.baseRingToStructurePresheaf R).app (op W) r := by
  change P.presheaf.map (homOfLE h).op
      (f.app U ((X.baseRingToStructurePresheaf R).app (op U) r)) = _
  rw [app_baseRingToStructurePresheaf]
  have hnat := congrArg (fun α ↦ α.hom r)
    ((P.baseRingToStructurePresheaf R).naturality (homOfLE h).op)
  change (P.baseRingToStructurePresheaf R).app (op W) r =
    P.presheaf.map (homOfLE h).op
      ((P.baseRingToStructurePresheaf R).app (op (f ⁻¹ᵁ U)) r) at hnat
  exact hnat.symm

/-- The coordinate-ring square on an actual affine rectangle is cartesian
dually, over the original base ring R. -/
theorem rectangle_coordinate_pushout
    (H : IsPullback f g (X ↘ Spec (.of R)) (Y ↘ Spec (.of R)))
    (U : X.Opens) (V : Y.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) :
    IsPushout ((X.baseRingToStructurePresheaf R).app (op U))
      ((Y.baseRingToStructurePresheaf R).app (op V))
      (f.appLE U (ExternalSections.rectangle f g U V) inf_le_left)
      (g.appLE V (ExternalSections.rectangle f g U V) inf_le_right) := by
  have h := isIso_pushoutSection_of_isAffineOpen H
    (US := ⊤) (UT := V) (UX := U)
    (UY := ExternalSections.rectangle f g U V) le_top le_top rfl
    (isAffineOpen_top _) hV hU
  have hp := (isIso_pushoutSection_iff H
    (US := ⊤) (UT := V) (UX := U)
    (UY := ExternalSections.rectangle f g U V) le_top le_top rfl).mp h
  refine hp.of_iso (Scheme.ΓSpecIso (.of R))
    (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp only [Scheme.baseRingToStructurePresheaf_app_eq_appLE,
      Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
  · simp only [Scheme.baseRingToStructurePresheaf_app_eq_appLE,
      Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
  · simp
  · simp

/-- The literal rectangle is affine, by the actual cartesian square on
restricted schemes. -/
theorem rectangle_isAffine
    (H : IsPullback f g (X ↘ Spec (.of R)) (Y ↘ Spec (.of R)))
    (U : X.Opens) (V : Y.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) :
    IsAffineOpen (ExternalSections.rectangle f g U V) := by
  haveI : IsAffine U := hU
  haveI : IsAffine V := hV
  haveI : IsAffine (⊤ : (Spec (.of R)).Opens) := isAffineOpen_top _
  exact IsAffine.of_isIso
    (Scheme.Hom.isPullback_resLE H (US := ⊤) (UT := V) (UX := U)
      (UY := ExternalSections.rectangle f g U V) le_top le_top rfl).isoPullback.hom

/-- The actual external-product map is bijective on every affine
rectangle of a fibre product, for arbitrary quasi-coherent factors. -/
theorem externalProduct_bijective
    (H : IsPullback f g (X ↘ Spec (.of R)) (Y ↘ Spec (.of R)))
    (M : X.Modules) (N : Y.Modules) [M.IsQuasicoherent] [N.IsQuasicoherent]
    (U : X.Opens) (V : Y.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) :
    Function.Bijective (ExternalSections.externalProduct R f g M N U V) := by
  let W := ExternalSections.rectangle f g U V
  have hW : IsAffineOpen W := rectangle_isAffine R f g H U V hU hV
  let A := Γ(X,U)
  let B := Γ(Y,V)
  let S := Γ(P,W)
  let MP := (AlgebraicGeometry.Scheme.Modules.pullback f).obj M
  let NP := (AlgebraicGeometry.Scheme.Modules.pullback g).obj N
  letI : Algebra R A := ((X.baseRingToStructurePresheaf R).app (op U)).hom.toAlgebra
  letI : Algebra R B := ((Y.baseRingToStructurePresheaf R).app (op V)).hom.toAlgebra
  letI : Algebra R S := ((P.baseRingToStructurePresheaf R).app (op W)).hom.toAlgebra
  letI : Algebra A S := (f.appLE U W inf_le_left).hom.toAlgebra
  letI : Algebra B S := (g.appLE V W inf_le_right).hom.toAlgebra
  letI : IsScalarTower R A S :=
    IsScalarTower.of_algebraMap_eq fun r ↦ (appLE_baseRing R f U W inf_le_left r).symm
  letI : IsScalarTower R B S :=
    IsScalarTower.of_algebraMap_eq fun r ↦ (appLE_baseRing R g V W inf_le_right r).symm
  letI : Algebra.IsPushout R A B S :=
    CommRingCat.isPushout_iff_isPushout.mp
      (rectangle_coordinate_pushout R f g H U V hU hV)
  letI : Module R Γ(M,U) := sectionsBaseModule R M U
  letI : Module R Γ(N,V) := sectionsBaseModule R N V
  letI : Module R Γ(MP,W) := sectionsBaseModule R MP W
  letI : Module R Γ(NP,W) := sectionsBaseModule R NP W
  letI : Module R Γ(MP ⊗ NP,W) := sectionsBaseModule R (MP ⊗ NP) W
  letI : Module A Γ(MP,W) := Module.compHom _ (algebraMap A S)
  letI : Module A Γ(NP,W) := Module.compHom _ (algebraMap A S)
  letI : Module B Γ(NP,W) := Module.compHom _ (algebraMap B S)
  letI : IsScalarTower R A Γ(M,U) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower R B Γ(N,V) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower R S Γ(MP,W) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower R S Γ(NP,W) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower R S Γ(MP ⊗ NP,W) :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower A S Γ(MP,W) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower A S Γ(NP,W) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower B S Γ(NP,W) := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  letI : IsScalarTower R A Γ(MP,W) := IsScalarTower.to₁₂₄ R A S _
  letI : IsScalarTower R A Γ(NP,W) := IsScalarTower.to₁₂₄ R A S _
  letI : IsScalarTower R B Γ(NP,W) := IsScalarTower.to₁₂₄ R B S _
  let eM : S ⊗[A] Γ(M,U) ≃ₗ[S] Γ(MP,W) :=
    AffinePullbackSections.pullbackSectionsLEEquiv M hU f hW inf_le_left
  let eN : S ⊗[B] Γ(N,V) ≃ₗ[S] Γ(NP,W) :=
    AffinePullbackSections.pullbackSectionsLEEquiv N hV g hW inf_le_right
  let F : Γ(M,U) →ₗ[A] Γ(MP,W) :=
    eM.toLinearMap.restrictScalars A ∘ₗ TensorProduct.mk A S Γ(M,U) 1
  have hF : IsBaseChange S F := IsBaseChange.of_equiv eM (by intro m; rfl)
  let eN' : A ⊗[R] Γ(N,V) ≃ₗ[A] Γ(NP,W) :=
    (Algebra.IsPushout.cancelBaseChange R A B S Γ(N,V)).symm ≪≫ₗ eN.restrictScalars A
  let G : Γ(N,V) →ₗ[R] Γ(NP,W) :=
    eN'.toLinearMap.restrictScalars R ∘ₗ TensorProduct.mk R A Γ(N,V) 1
  have hG : IsBaseChange A G := IsBaseChange.of_equiv eN' (by intro n; rfl)
  have hFm (m : Γ(M,U)) : F m = f.pullbackSectionsLE M U W inf_le_left m :=
    AffinePullbackSections.pullbackSectionsLEEquiv_one_tmul M hU f hW inf_le_left m
  have hGn (n : Γ(N,V)) : G n = g.pullbackSectionsLE N V W inf_le_right n := by
    change eN ((Algebra.IsPushout.cancelBaseChange R A B S Γ(N,V)).symm
      (1 ⊗ₜ[R] n)) = _
    rw [Algebra.IsPushout.cancelBaseChange_symm_tmul, map_one]
    exact AffinePullbackSections.pullbackSectionsLEEquiv_one_tmul N hV g hW inf_le_right n
  let e := ExternalTensorAlgebra.mixedBaseChangeTensorEquiv F G hF hG
  let t := AffineTensorSections.affineTensorSectionsIso hW MP NP
  let tLin : Γ(MP,W) ⊗[S] Γ(NP,W) ≃ₗ[S] Γ(MP ⊗ NP,W) := t.toLinearEquiv
  let E : Γ(MP ⊗ NP,W) ≃ₗ[R] Γ(M,U) ⊗[R] Γ(N,V) :=
    tLin.symm.restrictScalars R ≪≫ₗ e
  have hE (m : Γ(M,U)) (n : Γ(N,V)) :
      E (ExternalSections.externalProduct R f g M N U V (m ⊗ₜ[R] n)) =
        m ⊗ₜ[R] n := by
    erw [ExternalSections.externalProduct_tmul R f g M N U V m n]
    erw [ExternalSections.pullbackBaseLE_apply R f M U W inf_le_left m,
      ExternalSections.pullbackBaseLE_apply R g N V W inf_le_right n]
    erw [ExternalSections.sectionProduct_apply R MP NP W]
    change e (tLin.symm
      (AffineTensorProductMap.sectionTensorMap MP NP W
        (f.pullbackSectionsLE M U W inf_le_left m ⊗ₜ[S]
          g.pullbackSectionsLE N V W inf_le_right n))) = _
    rw [AffineTensorProductMap.sectionTensorMap_eq_affineIso MP NP W hW,
      ← hFm, ← hGn]
    change e (tLin.symm (tLin (F m ⊗ₜ[S] G n))) = _
    rw [LinearEquiv.symm_apply_apply]
    exact ExternalTensorAlgebra.mixedBaseChangeTensorEquiv_tmul F G hF hG m n
  have heq : ExternalSections.externalProduct R f g M N U V = E.symm.toLinearMap := by
    apply TensorProduct.ext'
    intro m n
    apply E.injective
    rw [hE]
    exact (E.apply_symm_apply (m ⊗ₜ[R] n)).symm
  rw [heq]
  exact E.symm.bijective

end PaperVerification.Segre.AffineRectangleTensor

end SegreAffineRectangleTensor

section SegreCochainTotalAugmentation

/-!
# Totalization of actual cochain augmentations

The single-column comparison and the coaugmentation are constructed from the
literal bicomplex.  Rowwise exactness then gives the desired quasi-isomorphism
using the proved first-quadrant chain theorem in the opposite category.
-/


open CategoryTheory CategoryTheory.Limits HomologicalComplex Opposite

namespace PaperVerification.Segre.CochainTotal

universe v u
variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The actual bicomplex supported in horizontal degree zero. -/
abbrev singleColumn (E : CochainComplex C ℕ) : Bicomplex (C := C) :=
  (HomologicalComplex.single (CochainComplex C ℕ) (ComplexShape.up ℕ) 0).obj E

/-- Opposing a single cochain column gives the single opposite chain column. -/
def oppositeSingleIso (E : CochainComplex C ℕ) :
    oppositeBicomplex (singleColumn E) ≅
      (HomologicalComplex.single (ChainComplex Cᵒᵖ ℕ) (ComplexShape.down ℕ) 0).obj E.op :=
  HomologicalComplex.Hom.isoOfComponents
    (fun n ↦ by
      cases n with
      | zero => exact Iso.refl _
      | succ n =>
          have hz : IsZero ((singleColumn E).X (n + 1)) :=
            HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℕ)
              0 E (n + 1) (Nat.succ_ne_zero n)
          have hzop : IsZero ((oppositeBicomplex (singleColumn E)).X (n + 1)) :=
            (HomologicalComplex.opFunctor C (ComplexShape.up ℕ)).map_isZero hz.op
          exact hzop.iso
            (HomologicalComplex.isZero_single_obj_X (ComplexShape.down ℕ)
              0 E.op (n + 1) (Nat.succ_ne_zero n)))
    (by
      intro i j h
      have hleft : (oppositeBicomplex (singleColumn E)).d i j = 0 := by
        change (HomologicalComplex.opFunctor C (ComplexShape.up ℕ)).map
          (((singleColumn E).d j i).op) = 0
        rw [HomologicalComplex.single_obj_d]
        simp only [op_zero, Functor.map_zero]
      erw [hleft, HomologicalComplex.single_obj_d, CategoryTheory.Limits.comp_zero,
        CategoryTheory.Limits.zero_comp])

/-- The total of a single actual cochain column is the original complex. -/
def singleTotalIso (E : CochainComplex C ℕ) : total (singleColumn E) ≅ E := by
  let S := (HomologicalComplex.single (ChainComplex Cᵒᵖ ℕ)
    (ComplexShape.down ℕ) 0).obj E.op
  let ε := HomologicalComplex₂.totalAugmentation S
    (HomologicalComplex.singleObjXSelf _ 0 E.op).hom
    (HomologicalComplex₂.single_d_comp_singleObjXSelf_hom E.op)
  haveI : IsIso ε := HomologicalComplex₂.isIso_totalAugmentation_single E.op
  let e : (oppositeBicomplex (singleColumn E)).total (ComplexShape.down ℕ) ≅ E.op :=
    HomologicalComplex₂.total.mapIso (oppositeSingleIso E) (ComplexShape.down ℕ) ≪≫
      asIso ε
  exact ((HomologicalComplex.unopFunctor C (ComplexShape.down ℕ)).mapIso e.op).symm

/-- An actual augmentation of the zero column induces a morphism from the
original complex to the total complex. -/
def totalCoaugmentation {K : Bicomplex (C := C)} {E : CochainComplex C ℕ}
    (φ : singleColumn E ⟶ K) : E ⟶ total K :=
  (singleTotalIso E).inv ≫ totalMap φ

/-- Exact augmented rows give the actual cochain totalization quasi-isomorphism. -/
theorem quasiIso_totalCoaugmentation_of_rows
    {K : Bicomplex (C := C)} {E : CochainComplex C ℕ}
    (φ : singleColumn E ⟶ K)
    (hφ : ∀ q : ℕ, QuasiIso
      (((HomologicalComplex.eval C (ComplexShape.up ℕ) q).mapHomologicalComplex
        (ComplexShape.up ℕ)).map φ)) :
    QuasiIso (totalCoaugmentation φ) := by
  haveI : QuasiIso (totalMap φ) := quasiIso_totalMap_of_rows φ hφ
  unfold totalCoaugmentation
  infer_instance

/-- Exact augmented columns give the actual cochain totalization
quasi-isomorphism when the augmentation is presented in that direction. -/
theorem quasiIso_totalCoaugmentation_of_columns
    {K : Bicomplex (C := C)} {E : CochainComplex C ℕ}
    (φ : singleColumn E ⟶ K) (hφ : ∀ p : ℕ, QuasiIso (φ.f p)) :
    QuasiIso (totalCoaugmentation φ) := by
  haveI : QuasiIso (totalMap φ) := quasiIso_totalMap_of_columns φ hφ
  unfold totalCoaugmentation
  infer_instance

end PaperVerification.Segre.CochainTotal

end SegreCochainTotalAugmentation

section SegreCechDoubleResolution

/-!
# The actual double Čech resolution

For two covers of one space, this constructs the complex of sheaves on the
double intersections, with both actual Čech differentials.  Its total is an
actual resolution of the original sheaf.  The acyclicity condition below is
on genuine restriction–pushforward sheaves on the double intersections.
-/


open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.CechDoubleResolution

open CechSheafResolution
universe u
variable {X : TopCat.{u}} {ι κ : Type u}
  (U : ι → Opens X) (V : κ → Opens X)

/-- Apply the second Čech resolution to every term of the first and put the
second resolution in the horizontal direction. -/
def bicomplex (F : AbSheaf (X := X)) : CochainTotal.Bicomplex (C := AbSheaf (X := X)) :=
  HomologicalComplex₂.flip
    (((sheafComplexFunctor V).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (sheafComplex U F))

/-- The natural augmentation of every term of the first Čech resolution. -/
def columnZeroAugmentation (F : AbSheaf (X := X)) :
    sheafComplex U F ⟶ (bicomplex U V F).X 0 where
  f q := augmentation V ((sheafComplex U F).X q)
  comm' q r _ := augmentation_naturality V ((sheafComplex U F).d q r)

theorem columnZeroAugmentation_d (F : AbSheaf (X := X)) :
    columnZeroAugmentation U V F ≫ (bicomplex U V F).d 0 1 = 0 := by
  apply HomologicalComplex.Hom.ext
  funext q
  exact augmentation_d V ((sheafComplex U F).X q)

/-- The augmentation as a genuine map of bicomplexes. -/
def bicomplexAugmentation (F : AbSheaf (X := X)) :
    CochainTotal.singleColumn (C := AbSheaf.{u} (X := X))
      (sheafComplex U F) ⟶ bicomplex U V F :=
  HomologicalComplex.mkHomFromSingle (columnZeroAugmentation U V F) fun n hn ↦ by
    have : n = 1 := by simpa using hn.symm
    subst n
    exact columnZeroAugmentation_d U V F

/-- Every augmented row is the actual second Čech sheaf resolution. -/
theorem quasiIso_rows (F : AbSheaf (X := X)) (hV : ⨆ j, V j = ⊤) (q : ℕ) :
    QuasiIso (((HomologicalComplex.eval (AbSheaf (X := X)) (ComplexShape.up ℕ)
      q).mapHomologicalComplex (ComplexShape.up ℕ)).map (bicomplexAugmentation U V F)) := by
  let ev := HomologicalComplex.eval (AbSheaf (X := X)) (ComplexShape.up ℕ) q
  let e := (HomologicalComplex.singleMapHomologicalComplex ev
    (ComplexShape.up ℕ) 0).app (sheafComplex U F)
  let φ := (ev.mapHomologicalComplex (ComplexShape.up ℕ)).map
    (bicomplexAugmentation U V F)
  have h : e.inv ≫ φ = augmentationMap V ((sheafComplex U F).X q) := by
    apply HomologicalComplex.from_single_hom_ext
    simp [φ, e, bicomplexAugmentation, columnZeroAugmentation,
      HomologicalComplex.mkHomFromSingle_f,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self]
    rfl
  change QuasiIso φ
  rw [← quasiIso_iff_comp_left e.inv, h]
  exact quasiIso_augmentationMap V _ hV

/-- The actual total Čech sheaf resolution for the pair of covers. -/
def resolution (F : AbSheaf (X := X)) : CochainComplex (AbSheaf (X := X)) ℕ :=
  CochainTotal.total (bicomplex U V F)

/-- The actual coaugmentation of the double Čech total complex. -/
def resolutionAugmentation (F : AbSheaf (X := X)) :
    (CochainComplex.single₀ (AbSheaf (X := X))).obj F ⟶ resolution U V F :=
  augmentationMap U F ≫ CochainTotal.totalCoaugmentation (bicomplexAugmentation U V F)

/-- Two open covers give a genuine quasi-isomorphism from the original sheaf
to the total of the double Čech resolution. -/
theorem quasiIso_resolutionAugmentation (F : AbSheaf (X := X))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤) :
    QuasiIso (resolutionAugmentation U V F) := by
  haveI := quasiIso_augmentationMap U F hU
  haveI := CochainTotal.quasiIso_totalCoaugmentation_of_rows
    (bicomplexAugmentation U V F) (quasiIso_rows U V F hV)
  unfold resolutionAugmentation
  infer_instance

/-- The actual restriction–pushforward functor. -/
def restrictionPushforwardFunctor (W : Opens X) :
    AbSheaf (X := X) ⥤ AbSheaf (X := X) :=
  W.isOpenEmbedding.sheafPullback AddCommGrpCat.{u} ⋙
    TopCat.Sheaf.pushforward AddCommGrpCat.{u} W.inclusion'

instance restrictionPushforwardFunctor_preservesLimits (W : Opens X) :
    PreservesLimits (restrictionPushforwardFunctor W) := by
  let G := sheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}
  haveI : PreservesLimits (restrictionPushforwardFunctor W ⋙ G) := by
    change PreservesLimits
      (G ⋙ (Functor.whiskeringLeft _ _ _).obj W.isOpenEmbedding.functor.op ⋙
        (Functor.whiskeringLeft _ _ _).obj (Opens.map W.inclusion').op)
    infer_instance
  exact preservesLimits_of_reflects_of_preserves (restrictionPushforwardFunctor W) G

/-- Iterated restriction–pushforward is restriction–pushforward on the
literal intersection of the two opens. -/
def pushedRestrictionCompositionIso (F : AbSheaf (X := X)) (W Z : Opens X) :
    pushedRestriction (pushedRestriction F Z) W ≅ pushedRestriction F (W ⊓ Z) :=
  (fullyFaithfulSheafToPresheaf (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}).preimageIso
    (pushedRestrictionIso (pushedRestriction F Z) W ≪≫
      Functor.isoWhiskerLeft (prod.functor.flip.obj W).op (pushedRestrictionIso F Z) ≪≫
      NatIso.ofComponents
        (F := (prod.functor.flip.obj W).op ⋙
          ((prod.functor.flip.obj Z).op ⋙ F.obj))
        (G := (prod.functor.flip.obj (W ⊓ Z)).op ⋙ F.obj)
        (fun T ↦ F.obj.mapIso (eqToIso (show
          (T.unop ⨯ (W ⊓ Z)) = ((T.unop ⨯ W) ⨯ Z) by
            simp only [CompleteLattice.prod_eq_inf, inf_assoc])).op)
        (by
          intro T T' f
          change F.obj.map _ ≫ F.obj.map _ = F.obj.map _ ≫ F.obj.map _
          rw [← F.obj.map_comp, ← F.obj.map_comp]
          congr 1 <;> exact Subsingleton.elim _ _) ≪≫
      (pushedRestrictionIso F (W ⊓ Z)).symm)

/-- Acyclicity of the actual double-intersection terms, before totalization. -/
theorem bicomplex_term_acyclic [Finite ι] [Finite κ] (F : AbSheaf (X := X))
    (p q n : ℕ)
    (h : ∀ (a : Fin (q + 1) → ι) (b : Fin (p + 1) → κ),
      Subsingleton ((pushedRestriction F
        ((∏ᶜ fun j ↦ V (b j)) ⊓ (∏ᶜ fun j ↦ U (a j)))).H' (n + 1) ⊤)) :
    Subsingleton ((((bicomplex U V F).X p).X q).H' (n + 1) ⊤) := by
  apply term_acyclic V ((sheafComplex U F).X q) p n
  intro b
  let W := ∏ᶜ fun j ↦ V (b j)
  let G := fun a : Fin (q + 1) → ι ↦ pushedRestriction F (∏ᶜ fun j ↦ U (a j))
  let R := restrictionPushforwardFunctor (X := X) W
  let e : pushedRestriction ((sheafComplex U F).X q) W ≅
      ∏ᶜ fun a : Fin (q + 1) → ι ↦
        pushedRestriction F (W ⊓ (∏ᶜ fun j ↦ U (a j))) :=
    R.mapIso (termSheafIso U F q) ≪≫ PreservesProduct.iso R G ≪≫
      Pi.mapIso (fun a ↦ pushedRestrictionCompositionIso F W (∏ᶜ fun j ↦ U (a j)))
  exact FiniteCohomologyProducts.subsingleton_H'_of_iso e (n + 1) ⊤
    (FiniteCohomologyProducts.subsingleton_H'_pi _ (n + 1) ⊤ fun a ↦ h a b)

end PaperVerification.Segre.CechDoubleResolution

namespace PaperVerification.Segre.CochainTotal

open CategoryTheory CategoryTheory.Limits Opposite
universe v u
variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The literal finite antidiagonal indexing the total degree. -/
abbrev TotalIndex (n : ℕ) := (fun i : ℕ × ℕ ↦ i.1 + i.2) ⁻¹' {n}

/-- A total degree is the actual finite product of the bicomplex entries. -/
def totalTermIso (K : Bicomplex (C := C)) (n : ℕ) :
    (total K).X n ≅ ∏ᶜ fun a : TotalIndex n ↦ (K.X a.1.1).X a.1.2 :=
  (opProductIsoCoproduct (fun a : TotalIndex n ↦ (K.X a.1.1).X a.1.2)).unop

end PaperVerification.Segre.CochainTotal


namespace PaperVerification.Segre.CechDoubleResolution

open CechSheafResolution
universe u
variable {X : TopCat.{u}} {ι κ : Type u}
  [Finite ι] [Finite κ] (U : ι → Opens X) (V : κ → Opens X)

/-- The actual double-intersection acyclicity condition. -/
def IsDoubleLeray (F : AbSheaf (X := X)) : Prop :=
  ∀ (p q n : ℕ) (a : Fin (q + 1) → ι) (b : Fin (p + 1) → κ),
    Subsingleton ((pushedRestriction F
      ((∏ᶜ fun j ↦ V (b j)) ⊓ (∏ᶜ fun j ↦ U (a j)))).H' (n + 1) ⊤)

set_option maxHeartbeats 1000000 in
/-- Every total term is acyclic when the actual double intersections are. -/
theorem resolution_term_acyclic (F : AbSheaf (X := X))
    (h : IsDoubleLeray U V F) (j n : ℕ) :
    Subsingleton (((resolution U V F).X j).H' (n + 1) ⊤) := by
  -- The antidiagonal is small; lift its index to the sheaf coefficient universe.
  -- Reindexing is an actual product isomorphism and changes no sheaf term.
  letI : Fintype (CochainTotal.TotalIndex j) :=
    Fintype.ofFinset (Finset.antidiagonal j) (by
      intro a
      simp [CochainTotal.TotalIndex, Finset.mem_antidiagonal])
  let A : ULift.{u} (CochainTotal.TotalIndex j) → AbSheaf.{u} (X := X) :=
    fun a ↦ ((bicomplex U V F).X a.down.1.1).X a.down.1.2
  let e : (resolution U V F).X j ≅ ∏ᶜ A :=
    CochainTotal.totalTermIso (bicomplex U V F) j ≪≫
      Pi.whiskerEquiv (C := AbSheaf.{u} (X := X))
        (f := fun a : CochainTotal.TotalIndex j ↦
          ((bicomplex U V F).X a.1.1).X a.1.2) (g := A)
        (Equiv.ulift : ULift.{u} (CochainTotal.TotalIndex j) ≃
          CochainTotal.TotalIndex j).symm (fun _ ↦ Iso.refl _)
  apply FiniteCohomologyProducts.subsingleton_H'_of_iso e (n + 1) ⊤
  apply FiniteCohomologyProducts.subsingleton_H'_pi A (n + 1) ⊤
  intro a
  exact bicomplex_term_acyclic U V F a.down.1.1 a.down.1.2 n
    (h a.down.1.1 a.down.1.2 n)

/-- Global sections of the actual total Čech sheaf resolution. -/
def sectionComplex (F : AbSheaf (X := X)) : CochainComplex AddCommGrpCat.{u} ℕ :=
  ((sheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} ⋙
    (evaluation _ _).obj (op (⊤ : Opens X))).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj (resolution U V F)

/-- The double Čech complex detects vanishing of the genuine positive sheaf
cohomology.  This is an actual acyclic-resolution comparison, with the
augmentation and all sheaf terms constructed above. -/
theorem cohomology_vanishing_iff (F : AbSheaf (X := X))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤)
    (h : IsDoubleLeray U V F) (n : ℕ) :
    Subsingleton (F.H' (n + 1) ⊤) ↔ (sectionComplex U V F).ExactAt (n + 1) := by
  let ε := resolutionAugmentation U V F
  have hquasi : QuasiIso ε := quasiIso_resolutionAugmentation U V F hU hV
  haveI : QuasiIsoAt ε 0 := hquasi.quasiIsoAt 0
  haveI : Mono (ε.f 0) := CochainAugmentationKernel.mono_f_zero ε
  have hε := CochainAugmentationKernel.exact_f_zero ε
  have hK (j : ℕ) : (resolution U V F).ExactAt (j + 1) := by
    haveI : QuasiIsoAt ε (j + 1) := hquasi.quasiIsoAt (j + 1)
    exact (exactAt_iff_of_quasiIsoAt ε (j + 1)).mp
      (HomologicalComplex.exactAt_single_obj (ComplexShape.up ℕ) 0 F
        (j + 1) (by omega))
  rw [HomologicalComplex.exactAt_iff' _ n (n + 1) (n + 2) (by simp) (by simp),
    ShortComplex.ab_exact_iff]
  exact AcyclicResolution.subsingleton_iff_exact_sections (ε.f 0)
    (HomologicalComplex.single_f_d ε 1) hε hK ⊤
    (resolution_term_acyclic U V F h) n

end PaperVerification.Segre.CechDoubleResolution

end SegreCechDoubleResolution

section SegreSchemeDoubleCech

/-!
# Genuine double Čech comparison on schemes

Affine double intersections satisfy the actual acyclicity requirement of the
constructed double resolution.  The comparison therefore has no separate
assumption about the cohomology of its terms.
-/


open CategoryTheory CategoryTheory.Limits TopologicalSpace AlgebraicGeometry Opposite
open TauCeti.AlgebraicGeometry.Scheme.Modules

namespace PaperVerification.Segre.SchemeDoubleCech

open CechSheafResolution CechDoubleResolution
universe u
variable {X : Scheme.{u}}

/-- On a scheme with affine diagonal, the inclusion of an affine open is an
affine morphism.  This follows from the actual affine-intersection criterion. -/
theorem affine_open_inclusion
    [IsAffineHom (pullback.diagonal (terminal.from X))]
    (W : X.Opens) (hW : IsAffineOpen W) : IsAffineHom W.ι := by
  constructor
  intro T hT
  apply (Scheme.Hom.isAffineOpen_iff_of_isOpenImmersion W.ι).mp
  rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  exact hW.inf hT

/-- Forgetting the module structure of restriction followed by direct image
is the literal restriction–pushforward of the underlying abelian sheaf. -/
def underlyingRestrictionPushforwardIso (M : X.Modules) (W : X.Opens) :
    pushedRestriction ((toSheaf X).obj M) W ≅
      (toSheaf X).obj ((Scheme.Modules.pushforward W.ι).obj (M.restrict W.ι)) :=
  (fullyFaithfulSheafToPresheaf (Opens.grothendieckTopology X)
    AddCommGrpCat.{u}).preimageIso
      (NatIso.ofComponents (fun _ ↦ Iso.refl _) (by intros; rfl))

/-- Actual pushforwards from affine opens are acyclic for quasi-coherent
modules on a scheme with affine diagonal. -/
theorem affine_pushedRestriction_acyclic
    [IsAffineHom (pullback.diagonal (terminal.from X))]
    (M : X.Modules) [M.IsQuasicoherent] (W : X.Opens) (hW : IsAffineOpen W) (n : ℕ) :
    Subsingleton ((pushedRestriction ((toSheaf X).obj M) W).H' (n + 1) ⊤) := by
  haveI : IsAffineHom W.ι := affine_open_inclusion W hW
  haveI : IsAffine W := hW
  exact FiniteCohomologyProducts.subsingleton_H'_of_iso
    (underlyingRestrictionPushforwardIso M W) (n + 1) ⊤
    (AffineDirectImage.cohomologyOnTop_pushforward_vanishing W.ι (M.restrict W.ι) n)

variable {ι κ : Type u} [Finite ι] [Finite κ]
  (U : ι → X.Opens) (V : κ → X.Opens)

/-- Affine double intersections discharge the actual double Leray condition. -/
theorem isDoubleLeray_of_affine
    [IsAffineHom (pullback.diagonal (terminal.from X))]
    (M : X.Modules) [M.IsQuasicoherent]
    (h : ∀ (p q : ℕ) (a : Fin (q + 1) → ι) (b : Fin (p + 1) → κ),
      IsAffineOpen ((∏ᶜ fun j ↦ V (b j)) ⊓ (∏ᶜ fun j ↦ U (a j)))) :
    IsDoubleLeray U V ((toSheaf X).obj M) :=
  fun p q n a b ↦ affine_pushedRestriction_acyclic M _ (h p q a b) n

/-- The actual double Čech total computes vanishing of actual sheaf
cohomology for finite covers with affine double intersections. -/
theorem cohomology_vanishing_iff_doubleCech_exact
    [IsAffineHom (pullback.diagonal (terminal.from X))]
    (M : X.Modules) [M.IsQuasicoherent]
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤)
    (h : ∀ (p q : ℕ) (a : Fin (q + 1) → ι) (b : Fin (p + 1) → κ),
      IsAffineOpen ((∏ᶜ fun j ↦ V (b j)) ⊓ (∏ᶜ fun j ↦ U (a j))))
    (n : ℕ) :
    Subsingleton (TauCeti.AlgebraicGeometry.Scheme.Modules.cohomologyOn M (n + 1) ⊤) ↔
      (sectionComplex U V ((toSheaf X).obj M)).ExactAt (n + 1) :=
  cohomology_vanishing_iff U V ((toSheaf X).obj M) hU hV
    (isDoubleLeray_of_affine U V M h) n

end PaperVerification.Segre.SchemeDoubleCech

end SegreSchemeDoubleCech

section SegreAffineRectangles

/-!
# Actual affine rectangles in a scheme fibre product

The opens used in the double Čech complex are the literal intersections of
the two inverse-image opens.  They are identified with the fibre products
of the corresponding open subschemes.  Consequently affine factor opens
give affine double intersections; the Leray condition is proved here.
-/


open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace
open TauCeti.AlgebraicGeometry.Scheme.Modules

namespace PaperVerification.Segre.AffineRectangles

universe u
variable {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z)

/-- The literal rectangle open in the actual fibre product scheme. -/
def rectangle (U : X.Opens) (V : Y.Opens) : (pullback f g).Opens :=
  pullback.fst f g ⁻¹ᵁ U ⊓ pullback.snd f g ⁻¹ᵁ V

/-- Its affine-chart candidate is the actual fibre product of the opens. -/
def rectangleSource (U : X.Opens) (V : Y.Opens) : Scheme.{u} :=
  pullback (U.ι ≫ f) (V.ι ≫ g)

/-- The canonical map from the fibre product of open subschemes. -/
def rectangleMap (U : X.Opens) (V : Y.Opens) :
    rectangleSource f g U V ⟶ pullback f g :=
  pullback.map (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z)
    (by simp) (by simp)

instance rectangleMap_isOpenImmersion (U : X.Opens) (V : Y.Opens) :
    IsOpenImmersion (rectangleMap f g U V) := by
  exact Scheme.pullback_map_isOpenImmersion
    (U.ι ≫ f) (V.ι ≫ g) f g U.ι V.ι (𝟙 Z) (by simp) (by simp)

/-- The image of the canonical map is exactly the rectangle, including
all scheme points, not merely rational points. -/
theorem rectangleMap_opensRange (U : X.Opens) (V : Y.Opens) :
    (rectangleMap f g U V).opensRange = rectangle f g U V := by
  apply Opens.ext
  change Set.range (rectangleMap f g U V) =
    pullback.fst f g ⁻¹' (U : Set X) ∩ pullback.snd f g ⁻¹' (V : Set Y)
  dsimp only [rectangleMap, rectangleSource]
  rw [Scheme.Pullback.range_map]
  simp only [Scheme.Opens.range_ι]

/-- The genuine open subscheme is canonically the fibre product of opens. -/
def rectangleIso (U : X.Opens) (V : Y.Opens) :
    rectangleSource f g U V ≅ (rectangle f g U V).toScheme :=
  IsOpenImmersion.isoOfRangeEq (rectangleMap f g U V)
    (rectangle f g U V).ι (by
      rw [Scheme.Opens.range_ι]
      exact congrArg (fun W : (pullback f g).Opens ↦ (W : Set ↑(pullback f g : Scheme.{u})))
        (rectangleMap_opensRange f g U V))

@[reassoc (attr := simp)]
theorem rectangleIso_hom_ι (U : X.Opens) (V : Y.Opens) :
    (rectangleIso f g U V).hom ≫ (rectangle f g U V).ι =
      rectangleMap f g U V :=
  IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

@[reassoc (attr := simp)]
theorem rectangleMap_fst (U : X.Opens) (V : Y.Opens) :
    rectangleMap f g U V ≫ pullback.fst f g =
      pullback.fst (U.ι ≫ f) (V.ι ≫ g) ≫ U.ι := by
  unfold rectangleMap
  exact pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem rectangleMap_snd (U : X.Opens) (V : Y.Opens) :
    rectangleMap f g U V ≫ pullback.snd f g =
      pullback.snd (U.ι ≫ f) (V.ι ≫ g) ≫ V.ι := by
  unfold rectangleMap
  exact pullback.lift_snd _ _ _

/-- Affine opens on the two factors have an affine rectangle over an
affine base.  This uses the actual scheme pullback. -/
theorem rectangle_isAffine [IsAffine Z] (U : X.Opens) (V : Y.Opens)
    (hU : IsAffineOpen U) (hV : IsAffineOpen V) :
    IsAffineOpen (rectangle f g U V) := by
  letI : IsAffine U := hU
  letI : IsAffine V := hV
  letI : IsAffine (rectangleSource f g U V) := by
    unfold rectangleSource
    infer_instance
  rw [← rectangleMap_opensRange]
  exact isAffineOpen_opensRange (rectangleMap f g U V)

/-- Pullback preserves the literal finite intersections selected by
the categorical Čech construction. -/
theorem preimage_product {ι : Type*} [Fintype ι] (U : ι → Z.Opens) :
    f ⁻¹ᵁ (∏ᶜ U) = ∏ᶜ fun i ↦ f ⁻¹ᵁ U i := by
  classical
  have hprod (S : Scheme.{u}) (W : ι → S.Opens) :
      (∏ᶜ W) = Finset.univ.inf W := by
    apply le_antisymm
    · exact Finset.le_inf_iff.mpr (fun i _ ↦ leOfHom (Pi.π W i))
    · exact leOfHom (Pi.lift (f := W) (P := Finset.univ.inf W)
        (fun i ↦ homOfLE (Finset.inf_le (f := W) (Finset.mem_univ i))))
  have hU : (∏ᶜ U) = Finset.univ.inf U := hprod Z U
  have hV : (∏ᶜ fun i ↦ f ⁻¹ᵁ U i) =
      Finset.univ.inf (fun i ↦ f ⁻¹ᵁ U i) := hprod X (fun i ↦ f ⁻¹ᵁ U i)
  rw [hU, hV]
  have h (s : Finset ι) :
      f ⁻¹ᵁ s.inf U = s.inf (fun i ↦ f ⁻¹ᵁ U i) := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert i s hi ih =>
      simp only [Finset.inf_insert, Scheme.Hom.preimage_inf, ih]
  exact h Finset.univ

/-- Finite nonempty products of affine opens are affine on a scheme with
affine diagonal. -/
theorem affine_product
    [IsAffineHom (pullback.diagonal (terminal.from X))]
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (U : ι → X.Opens) (hU : ∀ i, IsAffineOpen (U i)) :
    IsAffineOpen (∏ᶜ U) := by
  classical
  have hprod : (∏ᶜ U) = Finset.univ.inf U := by
    apply le_antisymm
    · exact Finset.le_inf_iff.mpr (fun i _ ↦ leOfHom (Pi.π U i))
    · exact leOfHom (Pi.lift (f := U) (P := Finset.univ.inf U)
        (fun i ↦ homOfLE (Finset.inf_le (f := U) (Finset.mem_univ i))))
  rw [hprod]
  simpa only [Finset.inf_eq_iInf, Finset.mem_univ, iInf_true] using
    IsAffineOpen.iInf hU

section Covers

variable [IsAffine Z]
  [IsAffineHom (pullback.diagonal (terminal.from X))]
  [IsAffineHom (pullback.diagonal (terminal.from Y))]
  {ι κ : Type u} (U : ι → X.Opens) (V : κ → Y.Opens)
  (hU : ∀ i, IsAffineOpen (U i)) (hV : ∀ j, IsAffineOpen (V j))

include hU hV

/-- Every double Čech intersection of the two inverse-image covers is
the actual affine rectangle in the corresponding factor intersections. -/
theorem double_intersections_affine (p q : ℕ)
    (a : Fin (q + 1) → ι) (b : Fin (p + 1) → κ) :
    IsAffineOpen
      ((∏ᶜ fun j ↦ pullback.snd f g ⁻¹ᵁ V (b j)) ⊓
        (∏ᶜ fun j ↦ pullback.fst f g ⁻¹ᵁ U (a j))) := by
  rw [← preimage_product, ← preimage_product, inf_comm]
  exact rectangle_isAffine f g _ _
    (affine_product (fun j ↦ U (a j)) (fun j ↦ hU (a j)))
    (affine_product (fun j ↦ V (b j)) (fun j ↦ hV (b j)))

/-- Actual double Čech cohomology on a product with affine factor covers. -/
theorem cohomology_vanishing_iff_doubleCech_exact
    [Finite ι] [Finite κ]
    [IsAffineHom (pullback.diagonal (terminal.from (pullback f g)))]
    (M : (pullback f g).Modules) [M.IsQuasicoherent]
    (hUc : ⨆ i, U i = ⊤) (hVc : ⨆ j, V j = ⊤) (n : ℕ) :
    Subsingleton (TauCeti.AlgebraicGeometry.Scheme.Modules.cohomologyOn M (n + 1) ⊤) ↔
      (CechDoubleResolution.sectionComplex
        (fun i ↦ pullback.fst f g ⁻¹ᵁ U i)
        (fun j ↦ pullback.snd f g ⁻¹ᵁ V j)
        ((TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf (pullback f g)).obj M)).ExactAt (n + 1) :=
  SchemeDoubleCech.cohomology_vanishing_iff_doubleCech_exact _ _ M
    ((pullback.fst f g).iSup_preimage_eq_top hUc)
    ((pullback.snd f g).iSup_preimage_eq_top hVc)
    (double_intersections_affine f g U V hU hV) n

end Covers
end PaperVerification.Segre.AffineRectangles

end SegreAffineRectangles

section SegreCechTensorComparison

/-!
# Tensor products and the genuine iterated Cech complex

For finite covers, tensoring vector spaces preserves the finite products
in every Cech degree. The comparison is built from the proved coefficient
change isomorphism and retains both actual Cech differentials. A natural
map of two-variable presheaves need only be invertible on the actual
cover intersections to induce an isomorphism of the double complexes.
-/


set_option backward.isDefEq.respectTransparency false
open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.CechTensorComparison

universe u v w
variable {K : Type u} [Field K]

/-- Tensor a fixed actual cochain complex with a variable vector space. -/
def tensorCochainRight (B : CochainComplex (ModuleCat.{u} K) ℕ) :
    ModuleCat.{u} K ⥤ CochainComplex (ModuleCat.{u} K) ℕ where
  obj X := ((tensorLeft X).mapHomologicalComplex (ComplexShape.up ℕ)).obj B
  map {X Y} f :=
    { f q := f ▷ B.X q
      comm' p q _ := by
        change (f ▷ B.X p) ≫ (Y ◁ B.d p q) =
          (X ◁ B.d p q) ≫ (f ▷ B.X q)
        simp only [← id_tensorHom, ← tensorHom_id, tensorHom_comp_tensorHom,
          Category.id_comp, Category.comp_id] }
  map_id X := by
    apply HomologicalComplex.Hom.ext
    funext q
    simp
  map_comp f g := by
    apply HomologicalComplex.Hom.ext
    funext q
    simp

instance tensorCochainRight_additive (B : CochainComplex (ModuleCat.{u} K) ℕ) :
    (tensorCochainRight B).Additive where
  map_add {X Y f g} := by
    apply HomologicalComplex.Hom.ext
    funext q
    exact MonoidalPreadditive.add_whiskerRight (X := B.X q) f g

/-- The pointwise complex construction is the actual tensor bicomplex. -/
def tensorCochainBicomplexIso (A B : CochainComplex (ModuleCat.{u} K) ℕ) :
    ((tensorCochainRight B).mapHomologicalComplex (ComplexShape.up ℕ)).obj A ≅
      ProductTensorTotal.tensorBicomplex A B :=
  HomologicalComplex.Hom.isoOfComponents (fun _ ↦ Iso.refl _) (by
    intro p q hpq
    apply HomologicalComplex.Hom.ext
    funext r
    simp only [HomologicalComplex.comp_f, HomologicalComplex.id_f,
      Category.id_comp, Category.comp_id]
    rfl)

variable {D : Type v} [Category.{w} D]

/-- Tensor a fixed actual presheaf with a variable vector space. -/
def tensorPresheafRight (G : Dᵒᵖ ⥤ ModuleCat.{u} K) :
    ModuleCat.{u} K ⥤ (Dᵒᵖ ⥤ ModuleCat.{u} K) where
  obj X := G ⋙ tensorLeft X
  map {X Y} f :=
    { app V := f ▷ G.obj V
      naturality V W h := by
        change (X ◁ G.map h) ≫ (f ▷ G.obj W) =
          (f ▷ G.obj V) ≫ (Y ◁ G.map h)
        simp only [← id_tensorHom, ← tensorHom_id, tensorHom_comp_tensorHom,
          Category.id_comp, Category.comp_id] }
  map_id X := by
    apply NatTrans.ext
    funext V
    simp
  map_comp f g := by
    apply NatTrans.ext
    funext V
    simp

instance tensorPresheafRight_additive (G : Dᵒᵖ ⥤ ModuleCat.{u} K) :
    (tensorPresheafRight G).Additive where
  map_add {X Y f g} := by
    apply NatTrans.ext
    funext V
    exact MonoidalPreadditive.add_whiskerRight (X := G.obj V) f g

section Cech
variable [HasFiniteProducts D] {κ : Type u} [Finite κ] (V : κ → D)

/-- The Cech comparison for tensoring is natural in the variable first
factor, not just an objectwise dimension identity. -/
def tensorCechRightIso (G : Dᵒᵖ ⥤ ModuleCat.{u} K) :
    tensorCochainRight ((cechComplexFunctor V).obj G) ≅
      tensorPresheafRight G ⋙ cechComplexFunctor V :=
  NatIso.ofComponents
    (fun X ↦ (cechComplexFunctorMapIso V (tensorLeft X)).app G)
    (by
      intro X Y f
      apply HomologicalComplex.Hom.ext
      funext q
      apply Pi.hom_ext
      intro b
      simp only [HomologicalComplex.comp_f, Category.assoc]
      erw [cechComplexFunctorMapIso_hom_app_f_π, cechComplexFunctor_map_f_π]
      rw [← Category.assoc]
      erw [cechComplexFunctorMapIso_hom_app_f_π]
      change (f ▷ ((cechComplexFunctor V).obj G).X q) ≫
          (Y ◁ Pi.π _ b) =
        (X ◁ Pi.π _ b) ≫ (f ▷ G.obj (op (∏ᶜ fun j ↦ V (b j))))
      exact (MonoidalCategory.whisker_exchange f (Pi.π _ b)).symm)

variable {C : Type v} [Category.{w} C] [HasFiniteProducts C]
  {ι : Type u} [Finite ι] (U : ι → C)

/-- The actual iterated Cech bicomplex of a two-variable presheaf. -/
def doubleCech (P : Cᵒᵖ ⥤ Dᵒᵖ ⥤ ModuleCat.{u} K) :
    CochainTotal.Bicomplex (C := ModuleCat.{u} K) :=
  (cechComplexFunctor U).obj (P ⋙ cechComplexFunctor V)

/-- The actual map of iterated Cech bicomplexes induced by a natural map
of the two-variable presheaves. -/
def doubleCechMap {P Q : Cᵒᵖ ⥤ Dᵒᵖ ⥤ ModuleCat.{u} K} (α : P ⟶ Q) :
    doubleCech V U P ⟶ doubleCech V U Q :=
  (cechComplexFunctor U).map (Functor.whiskerRight α (cechComplexFunctor V))

/-- The tensor bicomplex of the two Cech complexes is isomorphic to the
genuine double Cech complex of their pointwise tensor presheaf. -/
def tensorCechIso (F : Cᵒᵖ ⥤ ModuleCat.{u} K) (G : Dᵒᵖ ⥤ ModuleCat.{u} K) :
    ProductTensorTotal.tensorBicomplex
      ((cechComplexFunctor U).obj F) ((cechComplexFunctor V).obj G) ≅
        doubleCech V U (F ⋙ tensorPresheafRight G) :=
  (tensorCochainBicomplexIso
    ((cechComplexFunctor U).obj F) ((cechComplexFunctor V).obj G)).symm ≪≫
    (cechComplexFunctorMapIso U
      (tensorCochainRight ((cechComplexFunctor V).obj G))).app F ≪≫
    (cechComplexFunctor U).mapIso (Functor.isoWhiskerLeft F (tensorCechRightIso V G)) ≪≫
    (cechComplexFunctor U).mapIso (Functor.associator F (tensorPresheafRight G)
      (cechComplexFunctor V)).symm

/-- Invertibility on all actual cover intersections suffices; the natural
map need not be invertible on arbitrary opens. -/
theorem isIso_doubleCechMap
    {P Q : Cᵒᵖ ⥤ Dᵒᵖ ⥤ ModuleCat.{u} K} (α : P ⟶ Q)
    (h : ∀ (p q : ℕ) (a : Fin (p + 1) → ι) (b : Fin (q + 1) → κ),
      IsIso ((α.app (op (∏ᶜ fun j ↦ U (a j)))).app
        (op (∏ᶜ fun j ↦ V (b j))))) :
    IsIso (doubleCechMap V U α) := by
  letI (p : ℕ) (a : Fin (p + 1) → ι) :
      IsIso ((cechComplexFunctor V).map
        (α.app (op (∏ᶜ fun j ↦ U (a j))))) := by
    letI (q : ℕ) :
        IsIso (((cechComplexFunctor V).map
          (α.app (op (∏ᶜ fun j ↦ U (a j))))).f q) := by
      letI (b : Fin (q + 1) → κ) := h p q a b
      change IsIso (CategoryTheory.Limits.Pi.map (fun b : Fin (q + 1) → κ ↦
        (α.app (op (∏ᶜ fun j ↦ U (a j)))).app
          (op (∏ᶜ fun j ↦ V (b j)))))
      infer_instance
    exact HomologicalComplex.Hom.isIso_of_components _
  letI (p : ℕ) : IsIso ((doubleCechMap V U α).f p) := by
    change IsIso (CategoryTheory.Limits.Pi.map (fun a : Fin (p + 1) → ι ↦
      (cechComplexFunctor V).map (α.app (op (∏ᶜ fun j ↦ U (a j))))))
    infer_instance
  exact HomologicalComplex.Hom.isIso_of_components _

end Cech
end PaperVerification.Segre.CechTensorComparison

end SegreCechTensorComparison

section SegreRectanglePresheaf

/-!
# The actual rectangle presheaf and its Cech tensor comparison

The two-variable presheaf records sections of the actual external tensor
product on literal inverse-image intersections. Its comparison map is
the canonical product of pulled-back sections. The affine-rectangle
theorem proves invertibility at every cover intersection, giving the
actual bicomplex comparison needed for product cohomology.
-/


open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open TauCeti.CategoryTheory
open scoped TensorProduct

namespace PaperVerification.Segre.RectanglePresheaf

universe u
variable (K : Type u) [Field K]
  {X Y P : Scheme.{u}}
  [X.Over (Spec (.of K))] [Y.Over (Spec (.of K))] [P.Over (Spec (.of K))]
  (f : P ⟶ X) (g : P ⟶ Y)
  [f.IsOver (Spec (.of K))] [g.IsOver (Spec (.of K))]

/-- The literal rectangle, as a functor of its second open. -/
def rectangleFunctor (U : X.Opens) : Y.Opens ⥤ P.Opens where
  obj V := ExternalSections.rectangle f g U V
  map h := homOfLE (inf_le_inf le_rfl (g.preimage_mono (leOfHom h)))

variable (M : X.Modules) (N : Y.Modules)

/-- Actual sections of the external tensor sheaf on rectangles. -/
def rectanglePresheaf : X.Opensᵒᵖ ⥤ Y.Opensᵒᵖ ⥤ ModuleCat.{u} K where
  obj U := (rectangleFunctor f g U.unop).op ⋙
    (sectionsBasePresheafFunctor K).obj (ExternalSections.externalTensor f g M N)
  map {U U'} h :=
    { app V := ((sectionsBasePresheafFunctor K).obj
        (ExternalSections.externalTensor f g M N)).map
        (homOfLE (inf_le_inf (f.preimage_mono (leOfHom h.unop)) le_rfl)).op
      naturality V V' hV := by
        change _ ≫ _ = _ ≫ _
        simp only [Functor.comp_map]
        erw [← Functor.map_comp, ← Functor.map_comp]
        congr 1 <;> exact Subsingleton.elim _ _ }
  map_id U := by
    apply NatTrans.ext
    funext V
    change ((sectionsBasePresheafFunctor K).obj
      (ExternalSections.externalTensor f g M N)).map (𝟙 _) = 𝟙 _
    rw [CategoryTheory.Functor.map_id]
  map_comp h h' := by
    apply NatTrans.ext
    funext V
    change ((sectionsBasePresheafFunctor K).obj
      (ExternalSections.externalTensor f g M N)).map _ =
      ((sectionsBasePresheafFunctor K).obj
        (ExternalSections.externalTensor f g M N)).map _ ≫
      ((sectionsBasePresheafFunctor K).obj
        (ExternalSections.externalTensor f g M N)).map _
    erw [← Functor.map_comp]
    congr 1 <;> exact Subsingleton.elim _ _

/-- The canonical product of two pulled-back local sections is natural
in both opens. -/
def externalProductTransformation :
    ((sectionsBasePresheafFunctor K).obj M) ⋙
      CechTensorComparison.tensorPresheafRight ((sectionsBasePresheafFunctor K).obj N) ⟶
        rectanglePresheaf K f g M N where
  app U :=
    { app V := by
        letI := sectionsBaseModule K M U.unop
        letI := sectionsBaseModule K N V.unop
        letI := sectionsBaseModule K (ExternalSections.externalTensor f g M N)
          (ExternalSections.rectangle f g U.unop V.unop)
        dsimp only [rectanglePresheaf, rectangleFunctor, Functor.comp_obj, Functor.op_obj]
        exact ModuleCat.ofHom (R := K)
          (ExternalSections.externalProduct K f g M N U.unop V.unop)
      naturality V V' hV := by
        have hh : (homOfLE (leOfHom hV.unop)).op = hV := Subsingleton.elim _ _
        have h := (ExternalSections.externalProduct_restrict K f g M N
          (U := U.unop) (U' := U.unop) le_rfl (leOfHom hV.unop)).symm
        rw [hh] at h
        apply ModuleCat.hom_ext
        simpa only [Functor.comp_obj, CechTensorComparison.tensorPresheafRight,
          Functor.comp_map, tensorLeft, curriedTensor_obj_obj, curriedTensor_obj_map, rectanglePresheaf,
          rectangleFunctor, ExternalSections.rectangle, Functor.op_obj, Functor.op_map,
          NatTrans.comp_app, id_eq, homOfLE_leOfHom, Quiver.Hom.op_unop,
          homOfLE_refl, op_id, CategoryTheory.Functor.map_id, ModuleCat.hom_id,
          ModuleCat.hom_comp, ModuleCat.hom_ofHom, ModuleCat.hom_whiskerLeft,
          ModuleCat.hom_whiskerRight, LinearMap.lTensor_def, LinearMap.rTensor_def] using
          h }
  naturality U U' hU := by
    apply NatTrans.ext
    funext V
    have hh : (homOfLE (leOfHom hU.unop)).op = hU := Subsingleton.elim _ _
    have h := (ExternalSections.externalProduct_restrict K f g M N
      (V := V.unop) (V' := V.unop) (leOfHom hU.unop) le_rfl).symm
    rw [hh] at h
    apply ModuleCat.hom_ext
    simpa only [Functor.comp_obj, CechTensorComparison.tensorPresheafRight,
      Functor.comp_map, tensorLeft, curriedTensor_obj_obj, curriedTensor_obj_map, rectanglePresheaf,
      rectangleFunctor, ExternalSections.rectangle, Functor.op_obj, Functor.op_map,
      NatTrans.comp_app, id_eq, homOfLE_leOfHom, Quiver.Hom.op_unop,
      homOfLE_refl, op_id, CategoryTheory.Functor.map_id, ModuleCat.hom_id,
      ModuleCat.hom_comp, ModuleCat.hom_ofHom, ModuleCat.hom_whiskerLeft,
      ModuleCat.hom_whiskerRight, LinearMap.lTensor_def, LinearMap.rTensor_def] using
      h


section FiniteCovers
variable {ι κ : Type u} [Finite ι] [Finite κ]
  (U : ι → X.Opens) (V : κ → Y.Opens)
  [IsAffineHom (pullback.diagonal (terminal.from X))]
  [IsAffineHom (pullback.diagonal (terminal.from Y))]
  [M.IsQuasicoherent] [N.IsQuasicoherent]

/-- The canonical comparison of actual Cech bicomplexes is invertible
when the factor cover opens are affine. -/
theorem externalProductTransformation_isIso_doubleCech
    (H : IsPullback f g (X ↘ Spec (.of K)) (Y ↘ Spec (.of K)))
    (hU : ∀ i, IsAffineOpen (U i)) (hV : ∀ j, IsAffineOpen (V j)) :
    IsIso (CechTensorComparison.doubleCechMap V U
      (externalProductTransformation K f g M N)) := by
  apply CechTensorComparison.isIso_doubleCechMap
  intro p q a b
  rw [ConcreteCategory.isIso_iff_bijective]
  change Function.Bijective
    (ExternalSections.externalProduct K f g M N
      (∏ᶜ fun j ↦ U (a j)) (∏ᶜ fun j ↦ V (b j)))
  exact AffineRectangleTensor.externalProduct_bijective K f g H M N
    (∏ᶜ fun j ↦ U (a j)) (∏ᶜ fun j ↦ V (b j))
    (AffineRectangles.affine_product _ (fun j ↦ hU (a j)))
    (AffineRectangles.affine_product _ (fun j ↦ hV (b j)))

/-- Isomorphism of the actual tensor bicomplex of factor Cech complexes
with the genuine section bicomplex on rectangles. -/
def tensorCechRectangleIso
    (H : IsPullback f g (X ↘ Spec (.of K)) (Y ↘ Spec (.of K)))
    (hU : ∀ i, IsAffineOpen (U i)) (hV : ∀ j, IsAffineOpen (V j)) :
    ProductTensorTotal.tensorBicomplex
      ((cechComplexFunctor U).obj ((sectionsBasePresheafFunctor K).obj M))
      ((cechComplexFunctor V).obj ((sectionsBasePresheafFunctor K).obj N)) ≅
        CechTensorComparison.doubleCech V U (rectanglePresheaf K f g M N) := by
  letI := externalProductTransformation_isIso_doubleCech K f g M N U V H hU hV
  exact CechTensorComparison.tensorCechIso V U
    ((sectionsBasePresheafFunctor K).obj M) ((sectionsBasePresheafFunctor K).obj N) ≪≫
      asIso (CechTensorComparison.doubleCechMap V U
        (externalProductTransformation K f g M N))

set_option maxHeartbeats 1000000 in
/-- The actual rectangle total is exact whenever each split of the total
degree has an actually vanishing factor Cech cohomology group. -/
theorem rectangle_total_exact_of_factor_vanishing
    (H : IsPullback f g (X ↘ Spec (.of K)) (Y ↘ Spec (.of K)))
    (hU : ∀ i, IsAffineOpen (U i)) (hV : ∀ j, IsAffineOpen (V j))
    (n : ℕ)
    (h : ∀ p q : ℕ, p + q = n →
      IsZero (((cechComplexFunctor U).obj
        ((sectionsBasePresheafFunctor K).obj M)).homology p) ∨
      IsZero (((cechComplexFunctor V).obj
        ((sectionsBasePresheafFunctor K).obj N)).homology q)) :
    (CochainTotal.total
      (CechTensorComparison.doubleCech V U (rectanglePresheaf K f g M N))).ExactAt n := by
  let e := tensorCechRectangleIso K f g M N U V H hU hV
  let eTotal :
      CochainTotal.total (ProductTensorTotal.tensorBicomplex
        ((cechComplexFunctor U).obj ((sectionsBasePresheafFunctor K).obj M))
        ((cechComplexFunctor V).obj ((sectionsBasePresheafFunctor K).obj N))) ≅
      CochainTotal.total
        (CechTensorComparison.doubleCech V U (rectanglePresheaf K f g M N)) :=
    (HomologicalComplex.unopFunctor (ModuleCat.{u} K) (ComplexShape.down ℕ)).mapIso
      (((HomologicalComplex₂.totalFunctor (ModuleCat.{u} K)ᵒᵖ (ComplexShape.down ℕ)
          (ComplexShape.down ℕ) (ComplexShape.down ℕ)).mapIso
        (((HomologicalComplex.opFunctor (ModuleCat.{u} K) (ComplexShape.up ℕ)).mapHomologicalComplex
          (ComplexShape.down ℕ)).mapIso
            ((HomologicalComplex.opFunctor (CochainComplex (ModuleCat.{u} K) ℕ)
              (ComplexShape.up ℕ)).mapIso e.op))).op)
  exact HomologicalComplex.ExactAt.of_iso
    (ProductTensorTotal.productTensor_exact_of_factor_vanishing
      ((cechComplexFunctor U).obj ((sectionsBasePresheafFunctor K).obj M))
      ((cechComplexFunctor V).obj ((sectionsBasePresheafFunctor K).obj N)) n h) eTotal

end FiniteCovers
end PaperVerification.Segre.RectanglePresheaf

end SegreRectanglePresheaf

section SegreCechGlobalSections

/-!
# Global sections of the actual double Cech sheaf resolution

This comparison starts with the genuine resolution of sheaves. Global
sections are carried through its product total, and the two complex
constructions are interchanged by their canonical product comparisons.
The resulting bicomplex has the actual sections on double intersections.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.CechGlobalSections

open CechSheafResolution

universe u
variable {X : TopCat.{u}}

/-- The actual global-section functor of sheaves of abelian groups. -/
def globalFunctor : AbSheaf (X := X) ⥤ AddCommGrpCat.{u} :=
  sheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} ⋙
    (evaluation _ _).obj (op (⊤ : Opens X))

instance globalFunctor_preservesLimits : PreservesLimits (globalFunctor (X := X)) := by
  dsimp [globalFunctor]
  infer_instance

instance globalFunctor_additive : (globalFunctor (X := X)).Additive :=
  Functor.additive_of_preserves_binary_products _

/-- Removing the actual intersection with the whole space. -/
def restrictionGlobalIso (P : AbPresheaf (X := X)) :
    (restrictionFunctor P).obj (op (⊤ : Opens X)) ≅ P :=
  NatIso.ofComponents
    (fun W ↦ P.mapIso (eqToIso (show W.unop = ((⊤ : Opens X) ⨯ W.unop) by
      simp only [CompleteLattice.prod_eq_inf, top_inf_eq])).op)
    (by
      intro W Z h
      change P.map _ ≫ P.map _ = P.map _ ≫ P.map _
      rw [← P.map_comp, ← P.map_comp]
      congr 1 <;> exact Subsingleton.elim _ _)

theorem restrictionGlobalIso_naturality {P Q : AbPresheaf (X := X)}
    (φ : P ⟶ Q) :
    (restrictionMap φ).app (op (⊤ : Opens X)) ≫ (restrictionGlobalIso Q).hom =
      (restrictionGlobalIso P).hom ≫ φ := by
  apply NatTrans.ext
  funext W
  change φ.app _ ≫ Q.map _ = P.map _ ≫ φ.app _
  exact (φ.naturality _).symm

variable {ι κ : Type u} (U : ι → Opens X) (V : κ → Opens X)

/-- The global sections of the actual sheaf Cech complex are the actual
Cech complex of the original underlying presheaf. -/
def singleComparisonIso (F : AbSheaf (X := X)) :
    ((globalFunctor (X := X)).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (sheafComplex U F) ≅ (cechComplexFunctor U).obj F.obj :=
  (cechComplexFunctor U).mapIso (restrictionGlobalIso F.obj)

/-- The comparison is natural in the original sheaf, including all maps
needed to apply it to the terms and differential of another resolution. -/
def singleComparisonNatIso :
    sheafComplexFunctor U ⋙
      (globalFunctor (X := X)).mapHomologicalComplex (ComplexShape.up ℕ) ≅
    sheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} ⋙
      cechComplexFunctor U :=
  NatIso.ofComponents (singleComparisonIso U) (by
    intro F G φ
    change (cechComplexFunctor U).map ((restrictionMap φ.hom).app (op (⊤ : Opens X))) ≫
        (cechComplexFunctor U).map (restrictionGlobalIso G.obj).hom =
      (cechComplexFunctor U).map (restrictionGlobalIso F.obj).hom ≫
        (cechComplexFunctor U).map φ.hom
    rw [← Functor.map_comp, ← Functor.map_comp, restrictionGlobalIso_naturality])

/-- The actual section bicomplex on double intersections. -/
def intersectionBicomplex (F : AbSheaf (X := X)) :
    CochainTotal.Bicomplex (C := AddCommGrpCat.{u}) :=
  (cechComplexFunctor V).obj (restrictionFunctor F.obj ⋙ cechComplexFunctor U)

/-- Applying global sections to the double sheaf complex gives the genuine
intersection bicomplex, with both differentials preserved. -/
def bicomplexComparisonIso (F : AbSheaf (X := X)) :
    TotalCoefficientFunctor.mapCochainBi (globalFunctor (X := X))
      (CechDoubleResolution.bicomplex U V F) ≅ intersectionBicomplex U V F :=
  (HomologicalComplex₂.flipFunctor _ (ComplexShape.up ℕ) (ComplexShape.up ℕ)).mapIso
    ((NatIso.mapHomologicalComplex (singleComparisonNatIso V)
      (ComplexShape.up ℕ)).app (sheafComplex U F)) ≪≫
    (CechInterchange.comparisonIso V (presheafComplex U F.obj)).symm

/-- Transport a genuine bicomplex isomorphism through the actual product total. -/
def totalIso {C : Type u} [Category C] [Abelian C]
    {A B : CochainTotal.Bicomplex (C := C)} (e : A ≅ B) :
    CochainTotal.total A ≅ CochainTotal.total B :=
  (HomologicalComplex.unopFunctor C (ComplexShape.down ℕ)).mapIso
    (((HomologicalComplex₂.totalFunctor Cᵒᵖ (ComplexShape.down ℕ)
        (ComplexShape.down ℕ) (ComplexShape.down ℕ)).mapIso
      (((HomologicalComplex.opFunctor C (ComplexShape.up ℕ)).mapHomologicalComplex
        (ComplexShape.down ℕ)).mapIso
          ((HomologicalComplex.opFunctor (CochainComplex C ℕ) (ComplexShape.up ℕ)).mapIso
            e.op))).op)

/-- A chain-level comparison of the actual section complex used by the
acyclic-resolution theorem with the literal double-intersection total. -/
def sectionComplexIso (F : AbSheaf (X := X)) :
    CechDoubleResolution.sectionComplex U V F ≅
      CochainTotal.total (intersectionBicomplex U V F) :=
  TotalCoefficientFunctor.productComparisonIso (globalFunctor (X := X))
    (CechDoubleResolution.bicomplex U V F) ≪≫
    totalIso (bicomplexComparisonIso U V F)


/-- The zeroth homology of the genuine section resolution is the actual
global-section group. Only the cover property is needed in degree zero. -/
def zeroSectionsIso (F : AbSheaf (X := X))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤) :
    (globalFunctor (X := X)).obj F ≅
      (CechDoubleResolution.sectionComplex U V F).homology 0 := by
  let G := globalFunctor (X := X)
  let L := CechDoubleResolution.sectionComplex U V F
  let ε := CechDoubleResolution.resolutionAugmentation U V F
  have hquasi : QuasiIso ε :=
    CechDoubleResolution.quasiIso_resolutionAugmentation U V F hU hV
  haveI : QuasiIsoAt ε 0 := hquasi.quasiIsoAt 0
  haveI : Mono (ε.f 0) := CochainAugmentationKernel.mono_f_zero ε
  let φ : G.obj F ⟶ L.X 0 := G.map (ε.f 0)
  have hφ : φ ≫ L.d 0 1 = 0 := by
    change G.map (ε.f 0) ≫ G.map ((CechDoubleResolution.resolution U V F).d 0 1) = 0
    rw [← G.map_comp, HomologicalComplex.single_f_d ε 1, G.map_zero]
  have hker := (CochainAugmentationKernel.exact_f_zero ε).fIsKernel
  have hmapped : (ShortComplex.mk φ (L.d 0 1) hφ).Exact :=
    ShortComplex.exact_of_f_is_kernel (ShortComplex.mk φ (L.d 0 1) hφ)
      (KernelFork.mapIsLimit _ hker G)
  haveI : Mono φ := by
    dsimp [φ]
    infer_instance
  haveI : IsIso (L.liftCycles φ 1 (by simp) hφ) :=
    (CochainComplex.isIso_liftCycles_iff L φ hφ).mpr ⟨hmapped, inferInstance⟩
  exact asIso (L.liftCycles φ 1 (by simp) hφ) ≪≫ L.isoHomologyπ₀

/-- In degree zero the comparison is with actual sections, not an assumed
cohomology object or an augmentation whose injectivity was omitted. -/
theorem zero_cohomology_vanishing_iff (F : AbSheaf (X := X))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤) :
    Subsingleton (F.H' 0 ⊤) ↔
      (CochainTotal.total (intersectionBicomplex U V F)).ExactAt 0 := by
  let e := zeroSectionsIso U V F hU hV
  have hsection : Subsingleton (F.H' 0 ⊤) ↔
      (CechDoubleResolution.sectionComplex U V F).ExactAt 0 := by
    constructor
    · intro h
      haveI := h
      haveI : Subsingleton ((globalFunctor (X := X)).obj F) :=
        (cohomologyZeroSectionsEquiv F ⊤).symm.injective.subsingleton
      exact (HomologicalComplex.exactAt_iff_isZero_homology _ _).mpr
        ((AddCommGrpCat.isZero_of_subsingleton _).of_iso e.symm)
    · intro h
      haveI : Subsingleton (F.obj.obj (op ⊤)) :=
        AddCommGrpCat.subsingleton_of_isZero (h.isZero_homology.of_iso e)
      exact (cohomologyZeroSectionsEquiv F ⊤).injective.subsingleton
  exact hsection.trans
    ⟨fun h ↦ h.of_iso (sectionComplexIso U V F),
      fun h ↦ h.of_iso (sectionComplexIso U V F).symm⟩

/-- The full positive-degree comparison with actual sheaf cohomology. -/
theorem positive_cohomology_vanishing_iff [Finite ι] [Finite κ]
    (F : AbSheaf (X := X))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤)
    (h : CechDoubleResolution.IsDoubleLeray U V F) (n : ℕ) :
    Subsingleton (F.H' (n + 1) ⊤) ↔
      (CochainTotal.total (intersectionBicomplex U V F)).ExactAt (n + 1) :=
  (CechDoubleResolution.cohomology_vanishing_iff U V F hU hV h n).trans
    ⟨fun h ↦ h.of_iso (sectionComplexIso U V F),
      fun h ↦ h.of_iso (sectionComplexIso U V F).symm⟩

/-- Uniform comparison in every degree, including degree zero. -/
theorem cohomology_vanishing_iff [Finite ι] [Finite κ]
    (F : AbSheaf (X := X))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤)
    (h : CechDoubleResolution.IsDoubleLeray U V F) (n : ℕ) :
    Subsingleton (F.H' n ⊤) ↔
      (CochainTotal.total (intersectionBicomplex U V F)).ExactAt n := by
  cases n with
  | zero => exact zero_cohomology_vanishing_iff U V F hU hV
  | succ n => exact positive_cohomology_vanishing_iff U V F hU hV h n

end PaperVerification.Segre.CechGlobalSections

end SegreCechGlobalSections

section SegreCechBaseChange

/-!
# Cech complexes under a finite-product-preserving change of the base category

The isomorphism uses the actual product comparison of the base functor.
Its differential identity is proved from naturality with every face
projection, so it applies to inverse-image functors on opens without
assuming that the two Cech complexes have been identified.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits Opposite
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.CechBaseChange

universe w v v' v'' u u' u''
variable {C : Type u} [Category.{v} C] [HasFiniteProducts C]
  {D : Type u'} [Category.{v'} D] [HasFiniteProducts D]
  {A : Type u''} [Category.{v''} A] [Preadditive A] [HasProducts.{w} A]
  {ι : Type w} (U : ι → C) (F : C ⥤ D) [PreservesFiniteProducts F]

/-- Naturality of the genuine product comparison with a Cech face map. -/
theorem productComparison_face (n : ℕ) (b : Fin (n + 2) → ι)
    (m : Fin (n + 2)) :
    (PreservesProduct.iso F (fun j ↦ U (b j))).hom ≫
        (Pi.lift fun j ↦ Pi.π (fun j ↦ F.obj (U (b j))) (m.succAbove j)) =
      F.map (Pi.lift fun j ↦ Pi.π (fun j ↦ U (b j)) (m.succAbove j)) ≫
        (PreservesProduct.iso F (fun j ↦ U (b (m.succAbove j)))).hom := by
  apply Pi.hom_ext
  intro j
  rw [Category.assoc, Pi.lift_comp_π, PreservesProduct.iso_hom, piComparison_comp_π,
    Category.assoc, PreservesProduct.iso_hom, piComparison_comp_π,
    ← F.map_comp, Pi.lift_comp_π]

/-- The canonical product comparison in one Cech degree. -/
def degreeIso (P : Dᵒᵖ ⥤ A) (n : ℕ) :
    ((cechComplexFunctor (fun i ↦ F.obj (U i))).obj P).X n ≅
      ((cechComplexFunctor U).obj (F.op ⋙ P)).X n :=
  Pi.mapIso fun a : Fin (n + 1) → ι ↦
    P.mapIso (PreservesProduct.iso F (fun j ↦ U (a j))).op

@[reassoc]
theorem degreeIso_hom_projection (P : Dᵒᵖ ⥤ A) (n : ℕ)
    (a : Fin (n + 1) → ι) :
    (degreeIso U F P n).hom ≫ Pi.π _ a =
      Pi.π _ a ≫ P.map (PreservesProduct.iso F (fun j ↦ U (a j))).hom.op := by
  exact Pi.mapIso_hom_π _ a

/-- The comparison respects the actual alternating Cech differential. -/
theorem degreeIso_comm (P : Dᵒᵖ ⥤ A) (n : ℕ) :
    (degreeIso U F P n).hom ≫
      ((cechComplexFunctor U).obj (F.op ⋙ P)).d n (n + 1) =
    ((cechComplexFunctor (fun i ↦ F.obj (U i))).obj P).d n (n + 1) ≫
      (degreeIso U F P (n + 1)).hom := by
  apply Pi.hom_ext
  intro b
  rw [Category.assoc, cechComplexFunctor_obj_d_comp_π,
    Category.assoc, degreeIso_hom_projection, ← Category.assoc,
    cechComplexFunctor_obj_d_comp_π, Preadditive.comp_sum, Preadditive.sum_comp]
  apply Finset.sum_congr rfl
  intro m _
  rw [Preadditive.comp_zsmul, Preadditive.zsmul_comp]
  congr 1
  rw [← Category.assoc, degreeIso_hom_projection, Category.assoc]
  change Pi.π (fun a : Fin (n + 1) → ι => P.obj (op (∏ᶜ fun j => F.obj (U (a j))))) (b ∘ m.succAbove) ≫
      P.map (PreservesProduct.iso F (fun j ↦ U (b (m.succAbove j)))).hom.op ≫
        P.map (F.map (Pi.lift fun j ↦
          Pi.π (fun j ↦ U (b j)) (m.succAbove j))).op =
    (Pi.π (fun a : Fin (n + 1) → ι => P.obj (op (∏ᶜ fun j => F.obj (U (a j))))) (b ∘ m.succAbove) ≫
      P.map (Pi.lift fun j ↦ Pi.π (fun j ↦ F.obj (U (b j))) (m.succAbove j)).op) ≫
        P.map (PreservesProduct.iso F (fun j ↦ U (b j))).hom.op
  rw [Category.assoc, ← P.map_comp, ← P.map_comp, ← op_comp, ← op_comp,
    productComparison_face]

/-- The canonical isomorphism of whole actual Cech complexes. -/
def comparisonIso (P : Dᵒᵖ ⥤ A) :
    (cechComplexFunctor (fun i ↦ F.obj (U i))).obj P ≅
      (cechComplexFunctor U).obj (F.op ⋙ P) :=
  HomologicalComplex.Hom.isoOfComponents (degreeIso U F P) (by
    intro n m h
    obtain rfl : n + 1 = m := h
    exact degreeIso_comm U F P n)

@[simp]
theorem comparisonIso_hom_f (P : Dᵒᵖ ⥤ A) (n : ℕ) :
    (comparisonIso U F P).hom.f n = (degreeIso U F P n).hom := rfl

/-- Naturality in the coefficient presheaf, needed for a second Cech
direction or for an actual sheaf resolution. -/
def comparisonNatIso :
    cechComplexFunctor (fun i ↦ F.obj (U i)) ≅
      (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ A).obj F.op ⋙ cechComplexFunctor U :=
  NatIso.ofComponents (comparisonIso U F) (by
    intro P Q φ
    apply HomologicalComplex.Hom.ext
    funext n
    change ((cechComplexFunctor (fun i => F.obj (U i))).map φ).f n ≫
        (degreeIso U F Q n).hom =
      (degreeIso U F P n).hom ≫
        ((cechComplexFunctor U).map (Functor.whiskerLeft F.op φ)).f n
    apply Pi.hom_ext
    intro a
    change Fin (n + 1) → ι at a
    simp only [Category.assoc]
    erw [degreeIso_hom_projection, ← Category.assoc,
      cechComplexFunctor_map_f_π, Category.assoc,
      cechComplexFunctor_map_f_π]
    erw [degreeIso_hom_projection_assoc]
    congr 1
    exact (φ.naturality
      (PreservesProduct.iso F (fun j ↦ U (a j))).hom.op).symm)

end PaperVerification.Segre.CechBaseChange

end SegreCechBaseChange

section SegreCechPullbackRectangles

/-!
# Pullback covers and the actual rectangle section complex

Inverse image preserves finite products of opens. Applying the canonical
Cech base-change comparison in both directions therefore identifies the
actual double resolution on the product space with the actual sections on
factor rectangles. This is a comparison of the full complexes, not a count
of their dimensions or a statement about permitted cohomological degrees.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.CechPullbackRectangles

open CechSheafResolution

universe u
variable {P X Y : TopCat.{u}} (f : P ⟶ X) (g : P ⟶ Y)

/-- Actual sections on the categorical rectangle; the category of opens
identifies its finite product with the ordinary open intersection. -/
def rectanglePresheaf (Q : AbPresheaf (X := P)) :
    (Opens X)ᵒᵖ ⥤ (Opens Y)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
  (Opens.map f).op ⋙ restrictionFunctor Q ⋙
    (Functor.whiskeringLeft _ _ _).obj (Opens.map g).op

variable {ι κ : Type u} (U : ι → Opens X) (V : κ → Opens Y)

/-- The genuine bicomplex of sections on factor rectangles. -/
def rectangleBicomplex (Q : AbPresheaf (X := P)) :
    CochainTotal.Bicomplex (C := AddCommGrpCat.{u}) :=
  (cechComplexFunctor U).obj (rectanglePresheaf f g Q ⋙ cechComplexFunctor V)

/-- Two applications of the canonical finite-product comparison change
the two pullback cover directions into the two original cover directions. -/
def baseChangeIso (Q : AbPresheaf (X := P)) :
    (cechComplexFunctor (fun i ↦ (Opens.map f).obj (U i))).obj
      (restrictionFunctor Q ⋙
        cechComplexFunctor (fun j ↦ (Opens.map g).obj (V j))) ≅
      rectangleBicomplex f g U V Q :=
  CechBaseChange.comparisonIso U (Opens.map f)
    (restrictionFunctor Q ⋙
      cechComplexFunctor (fun j ↦ (Opens.map g).obj (V j))) ≪≫
    (cechComplexFunctor U).mapIso
      (Functor.isoWhiskerLeft ((Opens.map f).op ⋙ restrictionFunctor Q)
        (CechBaseChange.comparisonNatIso V (Opens.map g)))

/-- The global sections of the actual double Cech sheaf resolution are
the actual rectangle total, including both differentials and their signs. -/
def sectionRectangleIso (F : AbSheaf (X := P)) :
    CechDoubleResolution.sectionComplex
      (fun j ↦ (Opens.map g).obj (V j))
      (fun i ↦ (Opens.map f).obj (U i)) F ≅
      CochainTotal.total (rectangleBicomplex f g U V F.obj) :=
  CechGlobalSections.sectionComplexIso _ _ F ≪≫
    CechGlobalSections.totalIso (baseChangeIso f g U V F.obj)

theorem pullback_cover_left (hU : ⨆ i, U i = ⊤) :
    (⨆ i, (Opens.map f).obj (U i)) = ⊤ := by
  simpa only [hU, Opens.map_top, Function.comp_def] using (Opens.map_iSup f U).symm

theorem pullback_cover_right (hV : ⨆ j, V j = ⊤) :
    (⨆ j, (Opens.map g).obj (V j)) = ⊤ := by
  simpa only [hV, Opens.map_top, Function.comp_def] using (Opens.map_iSup g V).symm

/-- Vanishing of genuine sheaf cohomology is equivalent to exactness of
the literal rectangle total. Affine rectangles discharge the displayed
actual Leray condition in the scheme application. -/
theorem cohomology_vanishing_iff [Finite ι] [Finite κ]
    (F : AbSheaf (X := P))
    (hU : ⨆ i, U i = ⊤) (hV : ⨆ j, V j = ⊤)
    (h : CechDoubleResolution.IsDoubleLeray
      (fun j ↦ (Opens.map g).obj (V j))
      (fun i ↦ (Opens.map f).obj (U i)) F)
    (n : ℕ) :
    Subsingleton (F.H' n ⊤) ↔
      (CochainTotal.total (rectangleBicomplex f g U V F.obj)).ExactAt n :=
  (CechGlobalSections.cohomology_vanishing_iff _ _ F
    (pullback_cover_right g V hV) (pullback_cover_left f U hU) h n).trans
    ⟨fun h ↦ h.of_iso (CechGlobalSections.totalIso (baseChangeIso f g U V F.obj)),
      fun h ↦ h.of_iso (CechGlobalSections.totalIso
        (baseChangeIso f g U V F.obj)).symm⟩

end PaperVerification.Segre.CechPullbackRectangles

end SegreCechPullbackRectangles

section SegreDoubleCechCoefficients

/-!
# Changing coefficients in the actual double Cech total

The comparison is the two successive canonical Cech coefficient
comparisons, followed by the canonical product-total comparison.
It will be used for the exact forgetful functor from vector spaces
to abelian groups.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Opposite
open TauCeti.CategoryTheory

namespace PaperVerification.Segre.DoubleCechCoefficients

universe w v₁ v₂ v₃ v₄ u₁ u₂ u₃ u₄
variable {C : Type u₁} [Category.{v₁} C] [HasFiniteProducts C]
  {D : Type u₂} [Category.{v₂} D] [HasFiniteProducts D]
  {A : Type u₃} [Category.{v₃} A] [Abelian A] [HasProducts.{w} A]
  {B : Type u₄} [Category.{v₄} B] [Abelian B] [HasProducts.{w} B]
  {ι κ : Type w} (U : ι → C) (V : κ → D)
  (F : A ⥤ B) [F.Additive] [PreservesLimits F]

/-- The ordinary iterated Cech bicomplex over its actual coefficient category. -/
def doubleCech (P : Cᵒᵖ ⥤ Dᵒᵖ ⥤ A) :
    CochainTotal.Bicomplex (C := A) :=
  (cechComplexFunctor U).obj (P ⋙ cechComplexFunctor V)

/-- Apply the coefficient functor in the inner presheaf category. -/
def changePresheaf (P : Cᵒᵖ ⥤ Dᵒᵖ ⥤ A) :
    Cᵒᵖ ⥤ Dᵒᵖ ⥤ B :=
  P ⋙ (Functor.whiskeringRight _ _ _).obj F

-- Arbitrary cover-index universes require preservation at that universe.
-- The actual module-to-abelian-group forgetful functor satisfies this for
-- every universe; no geometric comparison is included in this hypothesis.
variable [PreservesLimitsOfSize.{w,w} F]

/-- The canonical coefficient comparison in both actual Cech directions. -/
def bicomplexIso (P : Cᵒᵖ ⥤ Dᵒᵖ ⥤ A) :
    TotalCoefficientFunctor.mapCochainBi F (doubleCech U V P) ≅
      doubleCech U V (changePresheaf F P) := by
  letI (n : ℕ) : PreservesLimitsOfShape (Discrete (Fin (n + 1) → κ)) F :=
    inferInstance
  letI (n : ℕ) : PreservesLimitsOfShape (Discrete (Fin (n + 1) → ι))
      (F.mapHomologicalComplex (ComplexShape.up ℕ)) := inferInstance
  exact (cechComplexFunctorMapIso U
      (F.mapHomologicalComplex (ComplexShape.up ℕ))).app
        (P ⋙ cechComplexFunctor V) ≪≫
      (cechComplexFunctor U).mapIso
        (Functor.isoWhiskerLeft P (cechComplexFunctorMapIso V F))

/-- The corresponding comparison of the entire signed product totals. -/
def totalIso (P : Cᵒᵖ ⥤ Dᵒᵖ ⥤ A) :
    (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (CochainTotal.total (doubleCech U V P)) ≅
        CochainTotal.total (doubleCech U V (changePresheaf F P)) :=
  TotalCoefficientFunctor.productComparisonIso F (doubleCech U V P) ≪≫
    (HomologicalComplex.unopFunctor B (ComplexShape.down ℕ)).mapIso
      (((HomologicalComplex₂.totalFunctor Bᵒᵖ (ComplexShape.down ℕ)
          (ComplexShape.down ℕ) (ComplexShape.down ℕ)).mapIso
        (((HomologicalComplex.opFunctor B (ComplexShape.up ℕ)).mapHomologicalComplex
          (ComplexShape.down ℕ)).mapIso
            ((HomologicalComplex.opFunctor (CochainComplex B ℕ) (ComplexShape.up ℕ)).mapIso
              (bicomplexIso U V F P).op))).op)

end PaperVerification.Segre.DoubleCechCoefficients

end SegreDoubleCechCoefficients

section SegreRectangleCohomology

/-!
# Actual product-cohomology vanishing on a scheme fibre product

This file assembles the genuine comparisons. The hypothesis concerns the
ordinary sheaf cohomology of the two factor sheaves. The conclusion
concerns the ordinary sheaf cohomology of their actual external tensor
product on a cartesian product of schemes. No comparison with a proxy
cohomology group is taken as an assumption.

Development status: this new source and its new comparison dependencies
must be compiled before any theorem in this file is counted as verified.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Modules
open TauCeti.CategoryTheory TauCeti.AlgebraicGeometry.Scheme.Modules

namespace PaperVerification.Segre.RectangleCohomology

universe u
variable (K : Type u) [Field K]
  {X Y P : Scheme.{u}}
  [X.Over (Spec (.of K))] [Y.Over (Spec (.of K))] [P.Over (Spec (.of K))]
  (f : P ⟶ X) (g : P ⟶ Y)
  [f.IsOver (Spec (.of K))] [g.IsOver (Spec (.of K))]
  (M : X.Modules) (N : Y.Modules)

/-- The underlying two-variable presheaf is the presheaf of actual
sections on the same rectangles. The only change is the canonical
identification of categorical products of opens with intersections. -/
def rectangleUnderlyingIso :
    CechPullbackRectangles.rectanglePresheaf
      (Scheme.forgetToTop.map f) (Scheme.forgetToTop.map g)
      (ExternalSections.externalTensor f g M N).presheaf ≅
    DoubleCechCoefficients.changePresheaf
      (forget₂ (ModuleCat.{u} K) AddCommGrpCat.{u})
      (RectanglePresheaf.rectanglePresheaf K f g M N) := by
  let Q := (ExternalSections.externalTensor f g M N).presheaf
  refine NatIso.ofComponents (fun U ↦ NatIso.ofComponents
    (fun V ↦ Q.mapIso (eqToIso (show
      ExternalSections.rectangle f g U.unop V.unop =
        ((f ⁻¹ᵁ U.unop) ⨯ (g ⁻¹ᵁ V.unop)) by
          simp only [ExternalSections.rectangle, CompleteLattice.prod_eq_inf])).op)
    ?_) ?_
  · intro V V' h
    change Q.map _ ≫ Q.map _ = Q.map _ ≫ Q.map _
    erw [← Q.map_comp, ← Q.map_comp] <;> congr 1
  · intro U U' h
    apply NatTrans.ext
    funext V
    change Q.map _ ≫ Q.map _ = Q.map _ ≫ Q.map _
    erw [← Q.map_comp, ← Q.map_comp] <;> congr 1

variable {ι κ : Type u} [Finite ι] [Finite κ]
  (U : ι → X.Opens) (V : κ → Y.Opens)

/-- The actual module-valued rectangle total, after forgetting scalars,
is canonically the abelian-group-valued rectangle total used by the
double sheaf resolution. -/
def rectangleTotalUnderlyingIso :
    ((forget₂ (ModuleCat.{u} K) AddCommGrpCat.{u}).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj
      (CochainTotal.total (CechTensorComparison.doubleCech V U
        (RectanglePresheaf.rectanglePresheaf K f g M N))) ≅
    CochainTotal.total (CechPullbackRectangles.rectangleBicomplex
      (Scheme.forgetToTop.map f) (Scheme.forgetToTop.map g) U V
      (ExternalSections.externalTensor f g M N).presheaf) :=
  DoubleCechCoefficients.totalIso U V
    (forget₂ (ModuleCat.{u} K) AddCommGrpCat.{u})
    (RectanglePresheaf.rectanglePresheaf K f g M N) ≪≫
      CechGlobalSections.totalIso
        ((cechComplexFunctor U).mapIso
          (Functor.isoWhiskerRight
            (rectangleUnderlyingIso K f g M N).symm (cechComplexFunctor V)))

variable [IsAffineHom (pullback.diagonal (terminal.from X))]
  [IsAffineHom (pullback.diagonal (terminal.from Y))]
  [IsAffineHom (pullback.diagonal (terminal.from P))]
  [M.IsQuasicoherent] [N.IsQuasicoherent]

/-- The actual nonempty intersections in a finite affine cover are
affine. This supplies the precise hypothesis of the linear Leray
comparison, rather than assuming a factor cohomology formula. -/
theorem affine_cover_intersections (hU : ∀ i, IsAffineOpen (U i))
    (s : Finset ι) (hs : s.Nonempty) : IsAffineOpen (s.inf U) := by
  simpa only [Finset.inf_eq_iInf, Finset.mem_coe] using
    IsAffineOpen.biInf (s : Set ι) s.finite_toSet hs (fun i hi ↦ hU i)

/-- The actual pullback cover has affine double intersections. -/
theorem rectangle_leray
    (H : IsPullback f g (X ↘ Spec (.of K)) (Y ↘ Spec (.of K)))
    (hU : ∀ i, IsAffineOpen (U i)) (hV : ∀ j, IsAffineOpen (V j)) :
    CechDoubleResolution.IsDoubleLeray
      (fun j ↦ g ⁻¹ᵁ V j) (fun i ↦ f ⁻¹ᵁ U i)
      ((TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf P).obj
        (ExternalSections.externalTensor f g M N)) := by
  letI : (ExternalSections.externalTensor f g M N).IsQuasicoherent := by
    dsimp [ExternalSections.externalTensor]
    infer_instance
  apply SchemeDoubleCech.isDoubleLeray_of_affine
  intro p q a b
  rw [← AffineRectangles.preimage_product, ← AffineRectangles.preimage_product]
  exact AffineRectangleTensor.rectangle_isAffine K f g H _ _
    (AffineRectangles.affine_product (fun j ↦ U (b j)) (fun j ↦ hU (b j)))
    (AffineRectangles.affine_product (fun j ↦ V (a j)) (fun j ↦ hV (a j)))

/-- A vanishing actual factor cohomology group gives a zero homology
object of its genuine module-valued Cech complex. -/
theorem factor_cech_isZero
    (hU : ∀ i, IsAffineOpen (U i)) (hUc : ⨆ i, U i = ⊤)
    (p : ℕ) (hp : Subsingleton (Cohomology M p)) :
    IsZero (((cechComplexFunctor U).obj
      ((sectionsBasePresheafFunctor K).obj M)).homology p) := by
  letI := hp
  let e := homologyCechComplexLinearEquiv
    (S := K) U (affine_cover_intersections U hU) hUc M p
  letI := e.injective.subsingleton
  exact ModuleCat.isZero_of_subsingleton _

/-- Product-cohomology vanishing for the actual external tensor sheaf.
The field is arbitrary: there is no characteristic-zero assumption and
no inversion of two or of a factorial. -/
theorem cohomology_vanishing_of_factor_vanishing
    (H : IsPullback f g (X ↘ Spec (.of K)) (Y ↘ Spec (.of K)))
    (hU : ∀ i, IsAffineOpen (U i)) (hV : ∀ j, IsAffineOpen (V j))
    (hUc : ⨆ i, U i = ⊤) (hVc : ⨆ j, V j = ⊤)
    (n : ℕ)
    (h : ∀ p q : ℕ, p + q = n →
      Subsingleton (Cohomology M p) ∨ Subsingleton (Cohomology N q)) :
    Subsingleton (Cohomology (ExternalSections.externalTensor f g M N) n) := by
  let E := ExternalSections.externalTensor f g M N
  let F := (TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf P).obj E
  let G := forget₂ (ModuleCat.{u} K) AddCommGrpCat.{u}
  have hmod : (CochainTotal.total (CechTensorComparison.doubleCech V U
      (RectanglePresheaf.rectanglePresheaf K f g M N))).ExactAt n := by
    apply RectanglePresheaf.rectangle_total_exact_of_factor_vanishing
      K f g M N U V H hU hV n
    intro p q hpq
    rcases h p q hpq with hp | hq
    · exact Or.inl (factor_cech_isZero K M U hU hUc p hp)
    · exact Or.inr (factor_cech_isZero K N V hV hVc q hq)
  have hmapped : ((G.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      (CochainTotal.total (CechTensorComparison.doubleCech V U
        (RectanglePresheaf.rectanglePresheaf K f g M N)))).ExactAt n := by
    -- Fix the entire mapped complex before using exactness of its degree-n
    -- short complex; inference need not reconstruct a complex from its sc.
    exact hmod.map G
  have hab : (CochainTotal.total
      (CechPullbackRectangles.rectangleBicomplex
        (Scheme.forgetToTop.map f) (Scheme.forgetToTop.map g) U V E.presheaf)).ExactAt n :=
    HomologicalComplex.ExactAt.of_iso hmapped
      (rectangleTotalUnderlyingIso K f g M N U V)
  have htop : Subsingleton (F.H' n ⊤) :=
    (CechPullbackRectangles.cohomology_vanishing_iff
      (Scheme.forgetToTop.map f) (Scheme.forgetToTop.map g) U V F
      hUc hVc (rectangle_leray K f g M N U V H hU hV) n).mpr hab
  letI : Subsingleton (cohomologyOn E n ⊤) := htop
  exact (cohomologyOnTopIso E n).addCommGroupIsoToAddEquiv.symm.injective.subsingleton

end PaperVerification.Segre.RectangleCohomology

end SegreRectangleCohomology

section SegreFiniteProductCohomology

/-!
# Actual cohomology vanishing for arbitrary finite scheme products

A covered factor records a genuine separated scheme over the coefficient
field, a genuine quasicoherent sheaf, and a finite affine open cover. The
product construction is the actual scheme pullback, its actual external
tensor sheaf, and the literal affine rectangle cover. No cohomology data
is included in this construction.

The cohomology theorem iterates the already constructed double-Cech
comparison. It applies to every nonempty finite family and every degree:
if every degree decomposition has a vanishing factor, the genuine sheaf
cohomology of the actual external tensor product vanishes.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.FiniteProductCohomology

open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open TauCeti.AlgebraicGeometry.Scheme.Modules
open scoped BigOperators

universe u
variable (K : Type u) [Field K]

/-- Actual geometric input for the affine Cech comparison, with no cohomology premise. -/
structure CoveredSheaf where
  scheme : Scheme.{u}
  toBase : scheme ⟶ Spec (.of K)
  sheaf : scheme.Modules
  separated : scheme.IsSeparated
  quasicoherent : sheaf.IsQuasicoherent
  index : Type u
  finiteIndex : Finite index
  opens : index → scheme.Opens
  affine : ∀ i, IsAffineOpen (opens i)
  covers : (⨆ i, opens i) = ⊤

attribute [instance] CoveredSheaf.separated CoveredSheaf.quasicoherent CoveredSheaf.finiteIndex

namespace CoveredSheaf

variable {K}

instance over (A : CoveredSheaf K) : A.scheme.Over (Spec (.of K)) := ⟨A.toBase⟩

/-- The actual scheme fibre product, actual external tensor, and actual rectangle cover. -/
def product (A B : CoveredSheaf K) : CoveredSheaf K := by
  let P := pullback A.toBase B.toBase
  let p : P ⟶ A.scheme := pullback.fst A.toBase B.toBase
  let q : P ⟶ B.scheme := pullback.snd A.toBase B.toBase
  letI : P.Over (Spec (.of K)) := ⟨p ≫ A.toBase⟩
  letI : p.IsOver (Spec (.of K)) := ⟨rfl⟩
  letI : q.IsOver (Spec (.of K)) := ⟨(pullback.condition (f := A.toBase) (g := B.toBase)).symm⟩
  letI : P.IsSeparated := by
    constructor
    have h : terminal.from P = p ≫ terminal.from A.scheme := Subsingleton.elim _ _
    rw [h]
    change IsSeparated (pullback.fst A.toBase B.toBase ≫ terminal.from A.scheme)
    infer_instance
  refine
    { scheme := P
      toBase := p ≫ A.toBase
      sheaf := ExternalSections.externalTensor p q A.sheaf B.sheaf
      separated := inferInstance
      quasicoherent := ?_
      index := A.index × B.index
      finiteIndex := inferInstance
      opens := fun a => p ⁻¹ᵁ A.opens a.1 ⊓ q ⁻¹ᵁ B.opens a.2
      affine := ?_
      covers := ?_ }
  · change (((AlgebraicGeometry.Scheme.Modules.pullback p).obj A.sheaf) ⊗ ((AlgebraicGeometry.Scheme.Modules.pullback q).obj B.sheaf)).IsQuasicoherent
    infer_instance
  · intro a
    exact AffineRectangles.rectangle_isAffine A.toBase B.toBase
      (A.opens a.1) (B.opens a.2) (A.affine a.1) (B.affine a.2)
  · apply top_unique
    intro x hx
    have hxp : p x ∈ (⨆ a, A.opens a) := by rw [A.covers]; trivial
    have hxq : q x ∈ (⨆ a, B.opens a) := by rw [B.covers]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hxp
    obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hxq
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(a, b), ha, hb⟩

@[simp]
theorem product_scheme (A B : CoveredSheaf K) :
    (product A B).scheme = pullback A.toBase B.toBase := rfl

/-- The literal sheaf on the product is the actual external tensor, not a cohomology model. -/
theorem product_sheaf (A B : CoveredSheaf K) :
    (product A B).sheaf =
      ExternalSections.externalTensor (pullback.fst A.toBase B.toBase)
        (pullback.snd A.toBase B.toBase) A.sheaf B.sheaf := rfl

/-- Genuine binary product cohomology, by the actual rectangle Cech comparison. -/
theorem product_cohomology_vanishes (A B : CoveredSheaf K) (n : ℕ)
    (h : ∀ p q : ℕ, p + q = n →
      Subsingleton (Cohomology A.sheaf p) ∨ Subsingleton (Cohomology B.sheaf q)) :
    Subsingleton (Cohomology (product A B).sheaf n) := by
  let P := pullback A.toBase B.toBase
  let p : P ⟶ A.scheme := pullback.fst A.toBase B.toBase
  let q : P ⟶ B.scheme := pullback.snd A.toBase B.toBase
  letI : P.Over (Spec (.of K)) := ⟨p ≫ A.toBase⟩
  letI : p.IsOver (Spec (.of K)) := ⟨rfl⟩
  letI : q.IsOver (Spec (.of K)) := ⟨(pullback.condition (f := A.toBase) (g := B.toBase)).symm⟩
  letI : P.IsSeparated := (product A B).separated
  change Subsingleton (Cohomology (ExternalSections.externalTensor p q A.sheaf B.sheaf) n)
  exact RectangleCohomology.cohomology_vanishing_of_factor_vanishing
    K p q A.sheaf B.sheaf A.opens B.opens
    (IsPullback.of_hasPullback A.toBase B.toBase)
    A.affine B.affine A.covers B.covers n h

/-- The actual right-associated product of a nonempty finite family. -/
def finiteProduct : {k : ℕ} → (Fin (k + 1) → CoveredSheaf K) → CoveredSheaf K
  | 0, A => A 0
  | k + 1, A => product (A 0) (finiteProduct (fun i : Fin (k + 1) => A i.succ))

/-- Every degree decomposition of the actual finite external product is accounted for.
No Bott table, Kunneth isomorphism, or comparison with a proxy is assumed. -/
theorem finiteProduct_cohomology_vanishes {k : ℕ}
    (A : Fin (k + 1) → CoveredSheaf K) (n : ℕ)
    (h : ∀ d : Fin (k + 1) → ℕ, (∑ i, d i) = n →
      ∃ i, Subsingleton (Cohomology (A i).sheaf (d i))) :
    Subsingleton (Cohomology (finiteProduct A).sheaf n) := by
  induction k generalizing n with
  | zero =>
      obtain ⟨i, hi⟩ := h (fun _ => n) (by simp)
      have he : i = (0 : Fin 1) := Fin.eq_zero i
      subst i
      exact hi
  | succ k ih =>
      apply product_cohomology_vanishes
      intro p q hpq
      by_cases hp : Subsingleton (Cohomology (A 0).sheaf p)
      · exact Or.inl hp
      · right
        apply ih
        intro d hd
        have hsum : (∑ i : Fin (k + 2), Fin.cons p d i) = n := by
          rw [Fin.sum_univ_succ]
          simp only [Fin.cons_zero, Fin.cons_succ]
          omega
        obtain ⟨i, hi⟩ := h (Fin.cons p d) hsum
        induction i using Fin.cases with
        | zero => exact (hp hi).elim
        | succ i => exact ⟨i, hi⟩

end CoveredSheaf
end PaperVerification.Segre.FiniteProductCohomology

end SegreFiniteProductCohomology

section SegreFixedProductCohomology

/-!
# External products on one fixed finite product scheme

The covered scheme is fixed independently of its sheaf. The actual external
tensor product of any family of quasicoherent sheaves therefore lives on the
same literal iterated fibre product, including when the exterior degrees and
twists vary. Cohomology vanishing follows from the actual affine-rectangle
comparison, with every cohomological degree decomposition included.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.FixedProductCohomology

open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry
open AlgebraicGeometry.Scheme.Modules
open TauCeti.AlgebraicGeometry.Scheme.Modules
open FiniteProductCohomology
open scoped BigOperators

universe u
variable (K : Type u) [Field K]

/-- The actual covered scheme data, independent of every sheaf and twist. -/
structure CoveredScheme where
  scheme : Scheme.{u}
  toBase : scheme ⟶ Spec (.of K)
  separated : scheme.IsSeparated
  index : Type u
  finiteIndex : Finite index
  opens : index → scheme.Opens
  affine : ∀ i, IsAffineOpen (opens i)
  covers : (⨆ i, opens i) = ⊤

attribute [instance] CoveredScheme.separated CoveredScheme.finiteIndex

namespace CoveredScheme

variable {K}

def ofCoveredSheaf (A : CoveredSheaf K) : CoveredScheme K where
  scheme := A.scheme
  toBase := A.toBase
  separated := A.separated
  index := A.index
  finiteIndex := A.finiteIndex
  opens := A.opens
  affine := A.affine
  covers := A.covers

/-- Attach a genuine quasicoherent sheaf without changing any geometric data. -/
def withSheaf (A : CoveredScheme K) (M : A.scheme.Modules) [M.IsQuasicoherent] :
    CoveredSheaf K where
  scheme := A.scheme
  toBase := A.toBase
  sheaf := M
  separated := A.separated
  quasicoherent := inferInstance
  index := A.index
  finiteIndex := A.finiteIndex
  opens := A.opens
  affine := A.affine
  covers := A.covers

/-- The actual covered fibre product depends only on its two covered schemes. -/
def product (A B : CoveredScheme K) : CoveredScheme K :=
  ofCoveredSheaf (CoveredSheaf.product
    (A.withSheaf (𝟙_ A.scheme.Modules)) (B.withSheaf (𝟙_ B.scheme.Modules)))

@[simp] theorem product_scheme (A B : CoveredScheme K) :
    (product A B).scheme = pullback A.toBase B.toBase := rfl

/-- The actual external tensor sheaf on the fixed geometric fibre product. -/
def externalTensor (A B : CoveredScheme K) (M : A.scheme.Modules) (N : B.scheme.Modules) :
    (product A B).scheme.Modules :=
  ExternalSections.externalTensor (pullback.fst A.toBase B.toBase)
    (pullback.snd A.toBase B.toBase) M N

instance externalTensor_quasicoherent (A B : CoveredScheme K)
    (M : A.scheme.Modules) (N : B.scheme.Modules)
    [M.IsQuasicoherent] [N.IsQuasicoherent] :
    (externalTensor A B M N).IsQuasicoherent := by
  change (((AlgebraicGeometry.Scheme.Modules.pullback (pullback.fst A.toBase B.toBase)).obj M) ⊗
    ((AlgebraicGeometry.Scheme.Modules.pullback (pullback.snd A.toBase B.toBase)).obj N)).IsQuasicoherent
  infer_instance

/-- Actual binary external-product cohomology on the fixed scheme. -/
theorem externalTensor_cohomology_vanishes (A B : CoveredScheme K)
    (M : A.scheme.Modules) (N : B.scheme.Modules)
    [M.IsQuasicoherent] [N.IsQuasicoherent] (n : ℕ)
    (h : ∀ p q : ℕ, p + q = n →
      Subsingleton (Cohomology M p) ∨ Subsingleton (Cohomology N q)) :
    Subsingleton (Cohomology (externalTensor A B M N) n) :=
  CoveredSheaf.product_cohomology_vanishes (A.withSheaf M) (B.withSheaf N) n h

/-- The actual nonempty finite product scheme; its definition contains no sheaf. -/
def finiteProduct : {k : ℕ} → (Fin (k + 1) → CoveredScheme K) → CoveredScheme K
  | 0, A => A 0
  | k + 1, A => product (A 0) (finiteProduct (fun i : Fin (k + 1) => A i.succ))

/-- The actual external product of any sheaf family on the one fixed product. -/
def finiteExternalTensor : {k : ℕ} → (A : Fin (k + 1) → CoveredScheme K) →
    (∀ i, (A i).scheme.Modules) → (finiteProduct A).scheme.Modules
  | 0, A, M => M 0
  | k + 1, A, M =>
      externalTensor (A 0) (finiteProduct (fun i : Fin (k + 1) => A i.succ))
        (M 0) (finiteExternalTensor (fun i : Fin (k + 1) => A i.succ)
          (fun i => M i.succ))

/-- Quasicoherence of the actual finite external product. -/
theorem finiteExternalTensor_quasicoherent {k : ℕ}
    (A : Fin (k + 1) → CoveredScheme K) (M : ∀ i, (A i).scheme.Modules)
    (hM : ∀ i, (M i).IsQuasicoherent) :
    (finiteExternalTensor A M).IsQuasicoherent := by
  induction k with
  | zero => exact hM 0
  | succ k ih =>
      letI := hM 0
      haveI : (finiteExternalTensor (fun i : Fin (k + 1) => A i.succ)
          (fun i => M i.succ)).IsQuasicoherent :=
        ih _ _ (fun i => hM i.succ)
      change (externalTensor (A 0) (finiteProduct (fun i : Fin (k + 1) => A i.succ))
        (M 0) (finiteExternalTensor (fun i : Fin (k + 1) => A i.succ)
          (fun i => M i.succ))).IsQuasicoherent
      infer_instance

/-- Actual cohomology vanishes when every degree decomposition has a zero
factor. The product scheme and all its projections are independent of M. -/
theorem finiteExternalTensor_cohomology_vanishes {k : ℕ}
    (A : Fin (k + 1) → CoveredScheme K) (M : ∀ i, (A i).scheme.Modules)
    (hM : ∀ i, (M i).IsQuasicoherent) (n : ℕ)
    (h : ∀ d : Fin (k + 1) → ℕ, (∑ i, d i) = n →
      ∃ i, Subsingleton (Cohomology (M i) (d i))) :
    Subsingleton (Cohomology (finiteExternalTensor A M) n) := by
  induction k generalizing n with
  | zero =>
      obtain ⟨i, hi⟩ := h (fun _ => n) (by simp)
      have he : i = (0 : Fin 1) := Fin.eq_zero i
      subst i
      exact hi
  | succ k ih =>
      letI := hM 0
      haveI : (finiteExternalTensor (fun i : Fin (k + 1) => A i.succ)
          (fun i => M i.succ)).IsQuasicoherent :=
        finiteExternalTensor_quasicoherent _ _ (fun i => hM i.succ)
      apply externalTensor_cohomology_vanishes
      intro p q hpq
      by_cases hp : Subsingleton (Cohomology (M 0) p)
      · exact Or.inl hp
      · right
        apply ih _ _ (fun i => hM i.succ)
        intro d hd
        have hsum : (∑ i : Fin (k + 2), Fin.cons p d i) = n := by
          rw [Fin.sum_univ_succ]
          simp only [Fin.cons_zero, Fin.cons_succ]
          omega
        obtain ⟨i, hi⟩ := h (Fin.cons p d) hsum
        induction i using Fin.cases with
        | zero => exact (hp hi).elim
        | succ i => exact ⟨i, hi⟩

end CoveredScheme
end PaperVerification.Segre.FixedProductCohomology

end SegreFixedProductCohomology

end SegreProductCohomology

end
end
end ProbeLayer391


/-! Future-only kernel audit for one exported mathematical stage.

Append to the stage being checked, with Lean.Util.CollectAxioms available through
both `public import Lean.Util.CollectAxioms` and `import all Lean.Util.CollectAxioms`
in that stage's header, as required by the reviewed FullFlattenedAudit.

Every new declaration in the checked kernel environment is included: public,
private, generated and vendored declarations receive the same direct-sorry and
transitive-axiom checks. This is evidence for this stage only. Later principal
theorems need not exist yet, and the final full principal audit remains required.

This preparation does not execute the audit, export a module or alter a proof.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The stage kernel audit requires kernel trust level zero"
  let names := (env.checked.get.constants.foldStage2
    (fun (names : Array Name) name _ => names.push name) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The stage mathematical module is empty"
  -- Reject direct proof holes before computing transitive axiom closures.
  -- The complete successful audit below remains unchanged.
  for name in names do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
  let privateEnv := env.setExporting false
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut theoremCount : Nat := 0
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if let .thmInfo _ := info then
      theoremCount := theoremCount + 1
  let report := Json.mkObj [
    ("main_module", toJson env.header.mainModule.toString),
    ("declaration_count", toJson names.size),
    ("theorem_count", toJson theoremCount),
    ("trust_level", toJson env.header.trustLevel.toNat),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("audit_scope", toJson "current_stage_new_declarations")]
  logInfo m!"SEGRE_STAGE_KERNEL_AUDIT_PASS {report.compress}"
