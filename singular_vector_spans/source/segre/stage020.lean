section ProbeLayer386



/-!
# A join with one shared vertex

Two rigid frameworks are translated so that their distinguished vertices are
zero, then placed in complementary coordinate subspaces. Identifying those two
vertices lowers the usual join dimension by one: dimensions `r` and `s` give
dimension `r+s`. Consecutive full diagonal boxes have exactly this relation.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.AmalgamatedJoin

open Matrix GenericRigidity
open scoped Matrix

variable {K I J V W : Type*} [Field K]
  [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]

def leftLift : (I → K) →ₗ[K] (I ⊕ J → K) where
  toFun x := Sum.elim x 0
  map_add' x y := by funext z; cases z <;> simp
  map_smul' c x := by funext z; cases z <;> simp

def rightLift : (J → K) →ₗ[K] (I ⊕ J → K) where
  toFun x := Sum.elim 0 x
  map_add' x y := by funext z; cases z <;> simp
  map_smul' c x := by funext z; cases z <;> simp

@[simp] theorem leftLift_dot (x : I → K) (y : I ⊕ J → K) :
    leftLift x ⬝ᵥ y = x ⬝ᵥ (fun i => y (.inl i)) := by
  simp [leftLift,dotProduct,Fintype.sum_sum_type]

@[simp] theorem rightLift_dot (x : J → K) (y : I ⊕ J → K) :
    rightLift x ⬝ᵥ y = x ⬝ᵥ (fun j => y (.inr j)) := by
  simp [rightLift,dotProduct,Fintype.sum_sum_type]

/-- Retain all vertices on the left and all but the distinguished right
vertex. Every cross edge is present; extra edges at the shared vertex cause
no loss of the original right graph. -/
def graph (G : SimpleGraph V) (H : SimpleGraph W) (b : W) :
    SimpleGraph (V ⊕ {w : W // w ≠ b}) where
  Adj
    | .inl v, .inl w => G.Adj v w
    | .inr v, .inr w => H.Adj v.val w.val
    | .inl _, .inr _ => True
    | .inr _, .inl _ => True
  symm.symm
    | .inl _, .inl _ => G.adj_symm
    | .inr _, .inr _ => H.adj_symm
    | .inl _, .inr _ => id
    | .inr _, .inl _ => id
  loopless.irrefl
    | .inl _ => G.irrefl
    | .inr _ => H.irrefl

noncomputable def rightVertex (a : V) (b : W) (w : W) : V ⊕ {w : W // w ≠ b} := by
  classical
  exact if h : w = b then .inl a else .inr ⟨w,h⟩

@[simp] theorem rightVertex_subtype (a : V) (b : W) (w : {w : W // w ≠ b}) :
    rightVertex a b w.val = .inr w := by
  simp [rightVertex,w.property]

theorem rightVertex_adj (G : SimpleGraph V) (H : SimpleGraph W) (a : V) (b : W)
    (v w : W) (h : H.Adj v w) :
    (graph G H b).Adj (rightVertex a b v) (rightVertex a b w) := by
  classical
  by_cases hv : v = b
  · subst v
    have hw : w ≠ b := fun he => h.ne he.symm
    simp [rightVertex,hw,graph]
  · by_cases hw : w = b
    · subst w
      simp [rightVertex,hv,graph]
    · simpa only [rightVertex,dif_neg hv,dif_neg hw,graph] using h

def position (p : Matrix V I K) (q : Matrix W J K) (a : V) (b : W) :
    Matrix (V ⊕ {w : W // w ≠ b}) (I ⊕ J) K
  | .inl v => leftLift (p v - p a)
  | .inr w => rightLift (q w.val - q b)

@[simp] theorem position_rightVertex (p : Matrix V I K) (q : Matrix W J K)
    (a : V) (b w : W) :
    position p q a b (rightVertex a b w) = rightLift (q w - q b) := by
  classical
  by_cases h : w = b
  · subst w
    simp [rightVertex,position]
  · simp only [rightVertex,dif_neg h,position]

theorem position_left_difference (p : Matrix V I K) (q : Matrix W J K)
    (a : V) (b : W) (v w : V) :
    position p q a b (.inl v) - position p q a b (.inl w) = leftLift (p v - p w) := by
  rw [position,position,← map_sub]
  congr 1
  funext i
  simp only [Pi.sub_apply]
  ring

theorem position_right_difference (p : Matrix V I K) (q : Matrix W J K)
    (a : V) (b : W) (v w : W) :
    position p q a b (rightVertex a b v) - position p q a b (rightVertex a b w) =
      rightLift (q v - q w) := by
  rw [position_rightVertex,position_rightVertex,← map_sub]
  congr 1
  funext i
  simp only [Pi.sub_apply]
  ring

/-- The two translated, complementary frameworks span their full direct-sum
coordinate space, with the shared vertex providing the origin. -/
theorem position_affineSpan (p : Matrix V I K) (q : Matrix W J K) (a : V) (b : W)
    (hp : affineSpan K (Set.range p) = ⊤)
    (hq : affineSpan K (Set.range q) = ⊤) :
    affineSpan K (Set.range (position p q a b)) = ⊤ := by
  let R := Submodule.span K (Set.range (position p q a b))
  have hleft : ∀ x : I → K, leftLift (J := J) x ∈ R := by
    have hd := span_differences_of_affineSpan (fun v => p v) hp (p a)
    have hle : Submodule.span K (Set.range (fun v => p a - p v)) ≤
        R.comap (leftLift (K := K) (I := I) (J := J)) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨v,rfl⟩
      change leftLift (p a - p v) ∈ R
      have h : -(position p q a b (.inl v)) ∈ R :=
        R.neg_mem (Submodule.subset_span ⟨.inl v,rfl⟩)
      simpa only [position,← map_neg,neg_sub] using h
    rw [hd] at hle
    intro x
    exact hle (Submodule.mem_top : x ∈ (⊤ : Submodule K (I → K)))
  have hright : ∀ x : J → K, rightLift (I := I) x ∈ R := by
    have hd := span_differences_of_affineSpan (fun w => q w) hq (q b)
    have hle : Submodule.span K (Set.range (fun w => q b - q w)) ≤
        R.comap (rightLift (K := K) (I := I) (J := J)) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨w,rfl⟩
      change rightLift (q b - q w) ∈ R
      have h : -(position p q a b (rightVertex a b w)) ∈ R :=
        R.neg_mem (Submodule.subset_span ⟨rightVertex a b w,rfl⟩)
      simpa only [position_rightVertex,← map_neg,neg_sub] using h
    rw [hd] at hle
    intro x
    exact hle (Submodule.mem_top : x ∈ (⊤ : Submodule K (J → K)))
  have hR : Submodule.span K (Set.range (position p q a b)) = ⊤ := by
    apply top_unique
    intro x _
    have he : x = leftLift (fun i => x (.inl i)) + rightLift (fun j => x (.inr j)) := by
      funext z
      cases z <;> simp [leftLift,rightLift]
    rw [he]
    exact R.add_mem (hleft _) (hright _)
  have hz : (0 : I ⊕ J → K) ∈ Set.range (position p q a b) :=
    ⟨.inl a,by simp [position]⟩
  rw [affineSpan_eq_span_of_zero_mem ((subset_affineSpan K _) hz),hR] <;> rfl

/-- The actual complementary-subspace placement is rigid. The proof reduces
all internal and cross pairs to complete-graph rigidity, so it works unchanged
in characteristic two. -/
theorem rigidOn_amalgamated [Fintype V] [Fintype W]
    (G : SimpleGraph V) (H : SimpleGraph W)
    (p : Matrix V I K) (q : Matrix W J K) (a : V) (b : W)
    (hp : affineSpan K (Set.range p) = ⊤) (hq : affineSpan K (Set.range q) = ⊤)
    (hG : InfinitesimallyRigidOn G p Set.univ)
    (hH : InfinitesimallyRigidOn H q Set.univ) :
    InfinitesimallyRigidOn (graph G H b) (position p q a b) Set.univ := by
  classical
  intro u hu
  let uA : V → I → K := fun v i => u (.inl v) (.inl i)
  let uB : W → J → K := fun w j => u (rightVertex a b w) (.inr j)
  have hA : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, G.Adj v w →
      (p v - p w) ⬝ᵥ (uA v - uA w) = 0 := by
    intro v _ w _ hvw
    have h := hu (.inl v) (Set.mem_univ _) (.inl w) (Set.mem_univ _) hvw
    rw [position_left_difference,leftLift_dot] at h
    exact h
  have hB : ∀ v ∈ Set.univ, ∀ w ∈ Set.univ, H.Adj v w →
      (q v - q w) ⬝ᵥ (uB v - uB w) = 0 := by
    intro v _ w _ hvw
    have h := hu (rightVertex a b v) (Set.mem_univ _)
      (rightVertex a b w) (Set.mem_univ _) (rightVertex_adj G H a b v w hvw)
    rw [position_right_difference,rightLift_dot] at h
    exact h
  obtain ⟨MA,tA,hMAt,hMAd,hmA⟩ := hG uA hA
  obtain ⟨MB,tB,hMBt,hMBd,hmB⟩ := hH uB hB
  have hall : ∀ v w, (position p q a b v - position p q a b w) ⬝ᵥ (u v - u w) = 0 := by
    intro v w
    cases v with
    | inl v =>
      cases w with
      | inl w =>
        rw [position_left_difference,leftLift_dot]
        change (p v - p w) ⬝ᵥ (uA v - uA w) = 0
        rw [hmA v (Set.mem_univ _),hmA w (Set.mem_univ _)]
        exact trivial_motion_edge MA tA (p v) (p w) hMAt hMAd
      | inr w => exact hu (.inl v) (Set.mem_univ _) (.inr w) (Set.mem_univ _) (by trivial)
    | inr v =>
      cases w with
      | inl w => exact hu (.inr v) (Set.mem_univ _) (.inl w) (Set.mem_univ _) (by trivial)
      | inr w =>
        rw [← rightVertex_subtype a b v,← rightVertex_subtype a b w,
          position_right_difference,rightLift_dot]
        change (q v.val - q w.val) ⬝ᵥ (uB v.val - uB w.val) = 0
        rw [hmB v.val (Set.mem_univ _),hmB w.val (Set.mem_univ _)]
        exact trivial_motion_edge MB tB (q v.val) (q w.val) hMBt hMBd
  exact complete_graph_rigid (position p q a b) (position_affineSpan p q a b hp hq)
    u (fun v _ w _ _ => hall v w)

/-- Rigidity dimensions add when the two distinguished vertices are
identified. No infinite-field assumption is needed for this construction. -/
theorem genericallyRigid_amalgamated [Fintype V] [Fintype W]
    (G : SimpleGraph V) (H : SimpleGraph W) (a : V) (b : W)
    (hG : GenericallyRigid K I G) (hH : GenericallyRigid K J H) :
    GenericallyRigid K (I ⊕ J) (graph G H b) := by
  classical
  obtain ⟨p,hp,hr⟩ := hG
  obtain ⟨q,hq,hs⟩ := hH
  exact ⟨position p q a b,position_affineSpan p q a b hp hq,
    rigidOn_amalgamated G H p q a b hp hq hr hs⟩

end PaperVerification.Segre.AmalgamatedJoin
end
end ProbeLayer386

section ProbeLayer387



/-!
# Coordinate propagation in every excess

The rigidity dimension is exactly `sideSum n + e`, with no restriction on the
characteristic.  The overlap is proved in both regimes used in Section 6:
all starting lengths at least `e`, or sufficiently many positive factors.
The latter proof keeps the full product of the other chain lengths and proves
that its surplus above their sum is minimized at the Boolean box.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ExcessPropagation

open Staircase RankParameters GenericRigidity ChainInduction

variable {K J : Type*} [Field K] [Fintype J] [DecidableEq J]

/-- Exact coordinate induction for arbitrary excess, with the complete
overlap inequality displayed as its only combinatorial input. -/
theorem propagate_of_overlap [Infinite K] (m n : J → ℕ) (e : ℕ)
    (hmn : m ≤ n)
    (hoverlap : ∀ p : J → ℕ, m ≤ p → ∀ i,
      sideSum p + e ≤ p i *
        Fintype.card (Cell (fun j : {j : J // j ≠ i} => p j.val)))
    (hbase : GenericallyRigid K (Fin (sideSum m + e)) (chainGraph m)) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  classical
  suffices h : ∀ d, ∀ n : J → ℕ, sideSum n = d → m ≤ n →
      GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) from h _ n rfl hmn
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro n hd hmn
    by_cases he : n = m
    · subst n
      exact hbase
    have hne : ¬∀ j, m j = n j := fun h => he (funext h).symm
    obtain ⟨i,hi⟩ := not_forall.mp hne
    have hlt : m i < n i := lt_of_le_of_ne (hmn i) hi
    let p := Function.update n i (n i - 1)
    have hmp : m ≤ p := by
      intro j
      by_cases hj : j = i
      · subst j
        simp only [p, Function.update_self]
        omega
      · simpa only [p, Function.update_of_ne hj] using hmn j
    have hside : sideSum p + 1 = sideSum n := by
      have h := sideSum_update n i (n i - 1)
      change sideSum p + n i = sideSum n + (n i - 1) at h
      omega
    have hp := ih (sideSum p) (by omega) p rfl hmp
    have hinc := increase_cell p i hp (by
      simpa only [Fintype.card_fin] using hoverlap p hmp i)
    have hupdate : Function.update p i (p i + 1) = n := by
      funext j
      by_cases hj : j = i
      · subst j
        simp only [p, Function.update_self]
        omega
      · simp only [p, Function.update_of_ne hj]
    rw [hupdate] at hinc
    apply genericallyRigid_fin (chainGraph n) (sideSum n + e) _ hinc
    simp only [Fintype.card_option, Fintype.card_fin]
    omega

/-- The exact Section 6.3 overlap: if the coordinate being enlarged already
has length at least `e`, two other positive factors suffice. -/
theorem overlap_of_large_coordinate (n : J → ℕ) (e : ℕ)
    (hpos : ∀ j, 1 ≤ n j) (hcard : 3 ≤ Fintype.card J)
    (i : J) (hei : e ≤ n i) :
    sideSum n + e ≤ n i *
      Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val)) := by
  classical
  have hc : Fintype.card {j : J // j ≠ i} = Fintype.card J - 1 := by
    rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
  have hQ : sideSum (fun j : {j : J // j ≠ i} => n j.val) + 2 ≤
      Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val)) := by
    simp only [Fintype.card_pi, Fintype.card_fin]
    apply sum_add_two_le_product Finset.univ
    · simp only [Finset.card_univ, hc]
      omega
    · intro j _
      exact hpos j.val
  have hm := Nat.mul_le_mul_left (n i) hQ
  have hs := Nat.mul_le_mul_right
    (sideSum (fun j : {j : J // j ≠ i} => n j.val)) (hpos i)
  rw [sideSum_split n i]
  nlinarith

/-- Unrestricted coordinate propagation used after the diagonal-box core in
Theorem 6.3. The initial rigidity is the only geometric input. -/
theorem propagate_large_lengths [Infinite K] (m n : J → ℕ) (e : ℕ)
    (hcard : 3 ≤ Fintype.card J) (hpos : ∀ i, 1 ≤ m i)
    (he : ∀ i, e ≤ m i) (hmn : m ≤ n)
    (hbase : GenericallyRigid K (Fin (sideSum m + e)) (chainGraph m)) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  apply propagate_of_overlap m n e hmn ?_ hbase
  intro p hmp i
  exact overlap_of_large_coordinate p e (fun j => (hpos j).trans (hmp j))
    hcard i ((he i).trans (hmp i))

/-- The product-minus-sum surplus of positive lengths is no smaller than its
value when every length is one. The subtraction-free form also covers the
empty product and avoids any truncated-subtraction convention. -/
theorem positive_product_surplus {L : Type*} (s : Finset L) (n : L → ℕ)
    (hpos : ∀ i ∈ s, 1 ≤ n i) :
    (∑ i ∈ s, n i) + 2 ^ s.card ≤ (∏ i ∈ s, (n i + 1)) + s.card := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      have hn : 1 ≤ n i := hpos i (Finset.mem_insert_self _ _)
      have hspos : ∀ j ∈ s, 1 ≤ n j := fun j hj => hpos j (Finset.mem_insert_of_mem hj)
      have hih := ih hspos
      have hp : 2 ^ s.card ≤ ∏ j ∈ s, (n j + 1) := by
        calc
          _ = ∏ _j ∈ s, (2 : ℕ) := by rw [Finset.prod_const]
          _ ≤ _ := Finset.prod_le_prod (fun j hj => by have h := hspos j hj; omega)
      have hP : 1 ≤ ∏ j ∈ s, (n j + 1) :=
        (Nat.one_le_pow _ _ (by omega : 0 < (2 : ℕ))).trans hp
      obtain ⟨a,ha⟩ := Nat.exists_eq_add_of_le hn
      obtain ⟨b,hb⟩ := Nat.exists_eq_add_of_le hP
      rw [hb] at hih hp
      rw [Finset.sum_insert hi, Finset.prod_insert hi,
        Finset.card_insert_of_notMem hi, pow_succ,ha,hb]
      nlinarith [Nat.zero_le (a * b)]

/-- The Boolean surplus condition implies the exact cone overlap for every
positive tuple, regardless of the magnitudes of its chain lengths. -/
theorem overlap_of_boolean_surplus (n : J → ℕ) (e : ℕ)
    (hpos : ∀ j, 1 ≤ n j)
    (hbound : e + Fintype.card J ≤ 2 ^ (Fintype.card J - 1)) (i : J) :
    sideSum n + e ≤ n i *
      Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val)) := by
  classical
  have hc : Fintype.card {j : J // j ≠ i} = Fintype.card J - 1 := by
    rw [Fintype.card_subtype_compl, Fintype.card_subtype_eq]
  have hJ : 1 ≤ Fintype.card J := Fintype.card_pos_iff.mpr ⟨i⟩
  have hprod := positive_product_surplus Finset.univ
    (fun j : {j : J // j ≠ i} => n j.val) (fun j _ => hpos j.val)
  have hQ : sideSum (fun j : {j : J // j ≠ i} => n j.val) + e + 1 ≤
      Fintype.card (Cell (fun j : {j : J // j ≠ i} => n j.val)) := by
    simp only [Finset.card_univ, hc] at hprod
    simp only [Fintype.card_pi, Fintype.card_fin]
    unfold sideSum
    dsimp only
    omega
  have hm := Nat.mul_le_mul_left (n i) hQ
  have hs := Nat.mul_le_mul_right
    (sideSum (fun j : {j : J // j ≠ i} => n j.val) + e) (hpos i)
  rw [sideSum_split n i]
  nlinarith

/-- The exact propagation step used after the Boolean cores in both parts of
Theorem 6.1. The numerical hypothesis is uniform in every positive length. -/
theorem propagate_many_factors [Infinite K] (m n : J → ℕ) (e : ℕ)
    (hpos : ∀ i, 1 ≤ m i) (hmn : m ≤ n)
    (hbound : e + Fintype.card J ≤ 2 ^ (Fintype.card J - 1))
    (hbase : GenericallyRigid K (Fin (sideSum m + e)) (chainGraph m)) :
    GenericallyRigid K (Fin (sideSum n + e)) (chainGraph n) := by
  apply propagate_of_overlap m n e hmn ?_ hbase
  intro p hmp i
  exact overlap_of_boolean_surplus p e (fun j => (hpos j).trans (hmp j)) hbound i

end PaperVerification.Segre.ExcessPropagation
end
end ProbeLayer387

section ProbeLayer388



/-!
# The exact neighbor bound for diagonal-box cores

The first and last boxes are literal subsets of the full product of chains.
For a vertex outside a core containing those boxes, their predecessor and
successor sets inject disjointly into the actual core-neighbor set. Their full
cardinalities are computed, and the paired-product inequality gives precisely
the left side of equation (8), for every dimension and every side length.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.DiagonalBoxNeighbors

open Staircase RankParameters

/-- These two natural exponents have exactly the floor/ceiling specifications
for half the number of factors. -/
theorem half_exponents_spec (k : ℕ) :
    2 * (k / 2) ≤ k ∧ k < 2 * (k / 2 + 1) ∧
      k ≤ 2 * ((k + 1) / 2) ∧ 2 * ((k + 1) / 2) < k + 2 := by
  omega

/-- The elementary multiplicative inequality underlying the balanced power
sum. No real convexity or characteristic-dependent argument is used. -/
theorem pow_sum_le_one_add_pow_add (B u v : ℕ) (hB : 1 ≤ B) :
    B ^ u + B ^ v ≤ 1 + B ^ (u + v) := by
  have hu : 1 ≤ B ^ u := Nat.one_le_pow u B hB
  have hv : 1 ≤ B ^ v := Nat.one_le_pow v B hB
  obtain ⟨a,ha⟩ := Nat.exists_eq_add_of_le hu
  obtain ⟨b,hb⟩ := Nat.exists_eq_add_of_le hv
  rw [pow_add,ha,hb]
  nlinarith [Nat.zero_le (a * b)]

theorem balanced_power_sum_le_of_le_half (B k a : ℕ)
    (hB : 1 ≤ B) (ha : a ≤ k / 2) :
    B ^ (k / 2) + B ^ ((k + 1) / 2) ≤ B ^ a + B ^ (k - a) := by
  let u := k / 2 - a
  let v := (k + 1) / 2 - a
  have hau : a + u = k / 2 := by dsimp [u]; omega
  have hav : a + v = (k + 1) / 2 := by dsimp [v]; omega
  have huv : a + (u + v) = k - a := by dsimp [u,v]; omega
  have h := Nat.mul_le_mul_left (B ^ a) (pow_sum_le_one_add_pow_add B u v hB)
  simpa only [mul_add, mul_one, ← pow_add, hau, hav, huv] using h

/-- Among two nonnegative exponents with fixed sum, the power sum is smallest
at the two integers nearest half the sum. -/
theorem balanced_power_sum_le (B k a : ℕ) (hB : 1 ≤ B) (ha : a ≤ k) :
    B ^ (k / 2) + B ^ ((k + 1) / 2) ≤ B ^ a + B ^ (k - a) := by
  by_cases hhalf : a ≤ k / 2
  · exact balanced_power_sum_le_of_le_half B k a hB hhalf
  · have hother : k - a ≤ k / 2 := by omega
    have hback : k - (k - a) = a := by omega
    calc
      _ ≤ B ^ (k - a) + B ^ (k - (k - a)) :=
        balanced_power_sum_le_of_le_half B k (k - a) hB hother
      _ = B ^ a + B ^ (k - a) := by rw [hback, add_comm]

/-- If each paired coordinate contributes at least `B` to one of two positive
products, their sum has the exact balanced-power lower bound. -/
theorem paired_product_lower_bound {I : Type*} (s : Finset I)
    (f g : I → ℕ) (B : ℕ) (hB : 1 ≤ B)
    (hf : ∀ i ∈ s, 1 ≤ f i) (hg : ∀ i ∈ s, 1 ≤ g i)
    (hpair : ∀ i ∈ s, B ≤ f i ∨ B ≤ g i) :
    B ^ (s.card / 2) + B ^ ((s.card + 1) / 2) ≤
      (∏ i ∈ s, f i) + ∏ i ∈ s, g i := by
  classical
  let a := (s.filter (fun i => B ≤ f i)).card
  let b := (s.filter (fun i => ¬B ≤ f i)).card
  have hab : a + b = s.card := Finset.card_filter_add_card_filter_not (s := s) _
  have hfirst : B ^ a ≤ ∏ i ∈ s, f i := by
    calc
      _ = ∏ i ∈ s, if B ≤ f i then B else 1 := by
        simp only [Finset.prod_ite, Finset.prod_const, one_pow, mul_one, a]
      _ ≤ _ := Finset.prod_le_prod (fun i hi => by
        split_ifs with h
        · exact h
        · exact hf i hi)
  have hlast : B ^ b ≤ ∏ i ∈ s, g i := by
    calc
      _ = ∏ i ∈ s, if B ≤ f i then 1 else B := by
        simp only [Finset.prod_ite, Finset.prod_const, one_pow, one_mul, b]
      _ ≤ _ := Finset.prod_le_prod (fun i hi => by
        split_ifs with h
        · exact hg i hi
        · exact (hpair i hi).resolve_left h)
  have hbal := balanced_power_sum_le B s.card a hB (by omega)
  have hb : s.card - a = b := by omega
  rw [hb] at hbal
  exact hbal.trans (Nat.add_le_add hfirst hlast)

variable {J : Type*} [Fintype J] [DecidableEq J]

abbrev Cube (N : ℕ) := Cell (fun _ : J => N)

def firstBox (N L : ℕ) : Set (Cube (J := J) N) :=
  {u | ∀ i, (u i).val ≤ L}

def lastBox (N L : ℕ) : Set (Cube (J := J) N) :=
  {u | ∀ i, N - (u i).val ≤ L}

def lowerNeighbors {N : ℕ} (v : Cube (J := J) N) (L : ℕ) : Set (Cube (J := J) N) :=
  {u | u ≤ v ∧ u ∈ firstBox N L}

def upperNeighbors {N : ℕ} (v : Cube (J := J) N) (L : ℕ) : Set (Cube (J := J) N) :=
  {u | v ≤ u ∧ u ∈ lastBox N L}

/-- Every predecessor in the first box is counted, coordinate by coordinate. -/
noncomputable def lowerNeighborEquiv {N : ℕ} (v : Cube (J := J) N) (L : ℕ) :
    (∀ i, Fin (min (v i).val L + 1)) ≃ ↥(lowerNeighbors v L) where
  toFun z := ⟨fun i => ⟨(z i).val, by
      have hz := (z i).isLt
      have hv : (v i).val < N + 1 := (v i).isLt
      have hm := min_le_left (v i).val L
      omega⟩, by
    constructor
    · intro i
      change (z i).val ≤ (v i).val
      have hz := (z i).isLt
      have hm := min_le_left (v i).val L
      omega
    · intro i
      have hz := (z i).isLt
      have hm := min_le_right (v i).val L
      change (z i).val ≤ L
      omega⟩
  invFun u := fun i => ⟨(u.val i).val, by
    have h₁ : (u.val i).val ≤ (v i).val := u.property.1 i
    have h₂ : (u.val i).val ≤ L := u.property.2 i
    exact Nat.lt_succ_of_le (le_min h₁ h₂)⟩
  left_inv z := by funext i; exact Fin.ext rfl
  right_inv u := by apply Subtype.ext; funext i; exact Fin.ext rfl

/-- Every successor in the last box is counted by reflecting its coordinates
about the top of the cube. -/
noncomputable def upperNeighborEquiv {N : ℕ} (v : Cube (J := J) N) (L : ℕ) :
    (∀ i, Fin (min (N - (v i).val) L + 1)) ≃ ↥(upperNeighbors v L) where
  toFun z := ⟨fun i => ⟨N - (z i).val,
      Nat.lt_succ_of_le (Nat.sub_le N (z i).val)⟩, by
    constructor
    · intro i
      change (v i).val ≤ N - (z i).val
      have hz := (z i).isLt
      have hv : (v i).val < N + 1 := (v i).isLt
      have hm := min_le_left (N - (v i).val) L
      omega
    · intro i
      change N - (N - (z i).val) ≤ L
      have hz := (z i).isLt
      have hm := min_le_right (N - (v i).val) L
      omega⟩
  invFun u := fun i => ⟨N - (u.val i).val, by
    have h₁ : (v i).val ≤ (u.val i).val := u.property.1 i
    have h₂ : N - (u.val i).val ≤ L := u.property.2 i
    apply Nat.lt_succ_of_le
    exact le_min (Nat.sub_le_sub_left h₁ N) h₂⟩
  left_inv z := by
    funext i
    apply Fin.ext
    change N - (N - (z i).val) = (z i).val
    have hz := (z i).isLt
    have hm := min_le_left (N - (v i).val) L
    omega
  right_inv u := by
    apply Subtype.ext
    funext i
    apply Fin.ext
    change N - (N - (u.val i).val) = (u.val i).val
    have hu : (u.val i).val < N + 1 := (u.val i).isLt
    omega

theorem card_lowerNeighbors {N : ℕ} (v : Cube (J := J) N) (L : ℕ) :
    Nat.card ↥(lowerNeighbors v L) = ∏ i, (min (v i).val L + 1) := by
  classical
  calc
    _ = Nat.card (∀ i, Fin (min (v i).val L + 1)) :=
      Nat.card_congr (lowerNeighborEquiv v L).symm
    _ = _ := by simp only [Nat.card_eq_fintype_card, Fintype.card_pi, Fintype.card_fin]

theorem card_upperNeighbors {N : ℕ} (v : Cube (J := J) N) (L : ℕ) :
    Nat.card ↥(upperNeighbors v L) = ∏ i, (min (N - (v i).val) L + 1) := by
  classical
  calc
    _ = Nat.card (∀ i, Fin (min (N - (v i).val) L + 1)) :=
      Nat.card_congr (upperNeighborEquiv v L).symm
    _ = _ := by simp only [Nat.card_eq_fintype_card, Fintype.card_pi, Fintype.card_fin]

/-- Outside the first box, the two counted neighbor sets are disjoint. In
particular no midpoint is double-counted when `N = 2L`. -/
theorem neighbors_disjoint {N : ℕ} (v : Cube (J := J) N) (L : ℕ)
    (hv : v ∉ firstBox N L) : Disjoint (lowerNeighbors v L) (upperNeighbors v L) := by
  apply Set.disjoint_left.mpr
  intro u hu hl
  have he : u = v := le_antisymm hu.1 hl.1
  exact hv (he ▸ hu.2)

/-- The two full box counts have the exact lower bound in equation (8). -/
theorem box_product_lower_bound {N : ℕ} (v : Cube (J := J) N) (L : ℕ)
    (hN : 2 * L ≤ N) :
    (L + 1) ^ (Fintype.card J / 2) + (L + 1) ^ ((Fintype.card J + 1) / 2) ≤
      (∏ i, (min (v i).val L + 1)) + ∏ i, (min (N - (v i).val) L + 1) := by
  apply paired_product_lower_bound Finset.univ _ _ (L + 1) (by omega)
    (fun _ _ => by omega) (fun _ _ => by omega)
  intro i _
  by_cases h : L ≤ (v i).val
  · left
    simpa only [min_eq_right h] using (le_rfl : L + 1 ≤ L + 1)
  · right
    have hv := (v i).isLt
    have hlast : L ≤ N - (v i).val := by omega
    simpa only [min_eq_right hlast] using (le_rfl : L + 1 ≤ L + 1)

/-- The full set of neighbors of `v` lying in an actual proposed core. -/
abbrev CoreNeighbors {N : ℕ} (C : Set (Cube (J := J) N)) (v : Cube (J := J) N) :=
  {u : Cube (J := J) N // u ∈ C ∧ (chainGraph (fun _ : J => N)).Adj v u}

theorem lowerNeighbors_adj {N : ℕ} (v : Cube (J := J) N) (L : ℕ)
    (hv : v ∉ firstBox N L) (u : Cube (J := J) N) (hu : u ∈ lowerNeighbors v L) :
    (chainGraph (fun _ : J => N)).Adj v u := by
  change v ≠ u ∧ (v ≤ u ∨ u ≤ v)
  refine ⟨?_, Or.inr hu.1⟩
  intro he
  exact hv (he.symm ▸ hu.2)

theorem upperNeighbors_adj {N : ℕ} (v : Cube (J := J) N) (L : ℕ)
    (hv : v ∉ lastBox N L) (u : Cube (J := J) N) (hu : u ∈ upperNeighbors v L) :
    (chainGraph (fun _ : J => N)).Adj v u := by
  change v ≠ u ∧ (v ≤ u ∨ u ≤ v)
  refine ⟨?_, Or.inl hu.1⟩
  intro he
  exact hv (he.symm ▸ hu.2)

/-- Every counted predecessor and successor is an actual, distinct neighbor
inside the core. The outside-core condition excludes all duplicated endpoints. -/
noncomputable def boxNeighborEmbedding {N : ℕ} (C : Set (Cube (J := J) N))
    (v : Cube (J := J) N) (L : ℕ)
    (hfirst : firstBox N L ⊆ C) (hlast : lastBox N L ⊆ C) (hv : v ∉ C) :
    (↥(lowerNeighbors v L) ⊕ ↥(upperNeighbors v L)) ↪ CoreNeighbors C v := by
  have hvfirst : v ∉ firstBox N L := fun h => hv (hfirst h)
  have hvlast : v ∉ lastBox N L := fun h => hv (hlast h)
  have hd := neighbors_disjoint v L hvfirst
  refine
    { toFun := fun s => match s with
        | .inl u => ⟨u.val, hfirst u.property.2, lowerNeighbors_adj v L hvfirst u.val u.property⟩
        | .inr u => ⟨u.val, hlast u.property.2, upperNeighbors_adj v L hvlast u.val u.property⟩
      inj' := ?_ }
  intro x y h
  have he := congrArg Subtype.val h
  cases x with
  | inl x =>
    cases y with
    | inl y =>
      change x.val = y.val at he
      exact congrArg Sum.inl (Subtype.ext he)
    | inr y =>
      change x.val = y.val at he
      exact False.elim (Set.disjoint_left.mp hd x.property (he.symm ▸ y.property))
  | inr x =>
    cases y with
    | inl y =>
      change x.val = y.val at he
      exact False.elim (Set.disjoint_left.mp hd y.property (he ▸ x.property))
    | inr y =>
      change x.val = y.val at he
      exact congrArg Sum.inr (Subtype.ext he)

theorem box_counts_le_coreNeighbors {N : ℕ} (C : Set (Cube (J := J) N))
    (v : Cube (J := J) N) (L : ℕ)
    (hfirst : firstBox N L ⊆ C) (hlast : lastBox N L ⊆ C) (hv : v ∉ C) :
    (∏ i, (min (v i).val L + 1)) + ∏ i, (min (N - (v i).val) L + 1) ≤
      Nat.card (CoreNeighbors C v) := by
  classical
  let e := boxNeighborEmbedding C v L hfirst hlast hv
  have h := Fintype.card_le_of_injective e e.injective
  rw [Fintype.card_sum] at h
  have hL := card_lowerNeighbors v L
  have hU := card_upperNeighbors v L
  rw [Nat.card_eq_fintype_card] at hL hU
  rw [hL,hU] at h
  simpa only [Nat.card_eq_fintype_card] using h

/-- The exact neighbor lower bound used to attach every outside vertex in
Theorem 6.3, for an arbitrary core containing the two specified end boxes. -/
theorem core_neighbor_lower_bound {N : ℕ} (C : Set (Cube (J := J) N))
    (v : Cube (J := J) N) (L : ℕ) (hN : 2 * L ≤ N)
    (hfirst : firstBox N L ⊆ C) (hlast : lastBox N L ⊆ C) (hv : v ∉ C) :
    (L + 1) ^ (Fintype.card J / 2) + (L + 1) ^ ((Fintype.card J + 1) / 2) ≤
      Nat.card (CoreNeighbors C v) :=
  (box_product_lower_bound v L hN).trans
    (box_counts_le_coreNeighbors C v L hfirst hlast hv)

/-- Equation (8) therefore supplies all `kN+e` required neighbors, including
the exact boundary equality case. -/
theorem enough_core_neighbors {N : ℕ} (C : Set (Cube (J := J) N))
    (v : Cube (J := J) N) (L e : ℕ) (hN : 2 * L ≤ N)
    (hfirst : firstBox N L ⊆ C) (hlast : lastBox N L ⊆ C) (hv : v ∉ C)
    (hbound : Fintype.card J * N + e ≤
      (L + 1) ^ (Fintype.card J / 2) + (L + 1) ^ ((Fintype.card J + 1) / 2)) :
    Fintype.card J * N + e ≤ Nat.card (CoreNeighbors C v) :=
  hbound.trans (core_neighbor_lower_bound C v L hN hfirst hlast hv)

end PaperVerification.Segre.DiagonalBoxNeighbors
end
end ProbeLayer388

section ProbeLayer389



/-!
# Attaching all outside vertices to a rigid core

A single product of nonzero minor certificates gives one placement where the
core is rigid and every outside vertex has spanning directions to its core
neighbors. All outside velocities are consequently the same rigid motion as
the core velocities. This proves the exact generic attachment step without an
unstated simultaneous-choice assumption, in every characteristic.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.CoreAttachment

open Matrix GenericRigidity RigidityRank
open scoped Matrix

variable {K D V : Type*} [Field K] [Fintype D] [DecidableEq D] [Fintype V]

abbrev NeighborsIn (G : SimpleGraph V) (S : Set V) (v : V) :=
  {w : V // w ∈ S ∧ G.Adj v w}

noncomputable def closedNeighborEmbedding (G : SimpleGraph V) (S : Set V)
    (v : V) (hv : v ∉ S) : Option (NeighborsIn G S v) ↪ V where
  toFun
    | none => v
    | some w => w.val
  inj' x y h := by
    cases x with
    | none =>
      cases y with
      | none => rfl
      | some y =>
        change v = y.val at h
        exact False.elim (hv (h.symm ▸ y.property.1))
    | some x =>
      cases y with
      | none =>
        change x.val = v at h
        exact False.elim (hv (h ▸ x.property.1))
      | some y => exact congrArg some (Subtype.ext h)

/-- A rigid induced core and at least `dim D` actual core neighbors for every
outside vertex imply rigidity of the entire finite graph. -/
theorem genericallyRigid_of_core_neighbors [Infinite K]
    (G : SimpleGraph V) (S : Set V)
    (hcore : GenericallyRigid K D (G.induce S))
    (hneighbors : ∀ v, v ∉ S → Fintype.card D ≤ Nat.card (NeighborsIn G S v)) :
    GenericallyRigid K D G := by
  classical
  let outside := {v : V // v ∉ S}
  obtain ⟨g,hg,hwg⟩ := rigidity_certificate (G.induce S)
    (Function.Embedding.subtype (fun v => v ∈ S)) hcore
  have hc (v : outside) : Fintype.card D + 1 ≤ Fintype.card (Option (NeighborsIn G S v.val)) := by
    have h := hneighbors v.val v.property
    rw [Nat.card_eq_fintype_card] at h
    rw [Fintype.card_option]
    omega
  choose f hf hwf using fun v : outside => affineSpan_certificate (K := K) (I := D)
    (closedNeighborEmbedding G S v.val v.property) (hc v)
  have hp : g * (∏ v : outside, f v) ≠ 0 :=
    mul_ne_zero hg (Finset.prod_ne_zero_iff.mpr (fun v _ => hf v))
  obtain ⟨z,hz⟩ := GenericMatrixRank.exists_eval_ne_zero (g * (∏ v : outside, f v)) hp
  rw [map_mul, mul_ne_zero_iff] at hz
  have hzv (v : outside) : MvPolynomial.eval z (f v) ≠ 0 := by
    have h := hz.2
    rw [map_prod] at h
    exact Finset.prod_ne_zero_iff.mp h v (Finset.mem_univ _)
  let p : Matrix V D K := Matrix.of (flattenVelocity.symm z)
  have hpz : flattenVelocity p = z := rfl
  have hC := hwg p (by rw [hpz]; exact hz.1)
  have hspanC : affineSpan K (Set.range (fun v : S => p v.val)) = ⊤ := hC.1
  have hrigidC : InfinitesimallyRigidOn G p S := (rigidOn_induce_iff G p S).mp hC.2
  have hspan (v : outside) : Submodule.span K
      (Set.range fun w : NeighborsIn G S v.val => p v.val - p w.val) = ⊤ := by
    have hclosed := hwf v p (by rw [hpz]; exact hzv v)
    have hfull := span_differences_of_affineSpan
      (fun w : Option (NeighborsIn G S v.val) =>
        p (closedNeighborEmbedding G S v.val v.property w)) hclosed (p v.val)
    apply top_unique
    rw [← hfull]
    apply Submodule.span_le.mpr
    rintro _ ⟨w,rfl⟩
    cases w with
    | none =>
      change p v.val - p v.val ∈ _
      rw [sub_self]
      exact Submodule.zero_mem _
    | some w => exact Submodule.subset_span ⟨w,rfl⟩
  refine ⟨p,?_,?_⟩
  · apply top_unique
    rw [← hspanC]
    apply affineSpan_mono K
    rintro _ ⟨v,rfl⟩
    exact ⟨v.val,rfl⟩
  · intro u hu
    obtain ⟨M,t,hMt,hMd,hm⟩ := hrigidC u (by
      intro v _ w _ hvw
      exact hu v (Set.mem_univ _) w (Set.mem_univ _) hvw)
    refine ⟨M,t,hMt,hMd,?_⟩
    intro v _
    by_cases hv : v ∈ S
    · exact hm v hv
    · apply motion_at_new_vertex
        (fun w : NeighborsIn G S v => p w.val)
        (fun w : NeighborsIn G S v => u w.val) (p v) (u v) M t hMt hMd
      · exact fun w => hm w.val w.property.1
      · exact hspan ⟨v,hv⟩
      · exact fun w => hu v (Set.mem_univ _) w.val (Set.mem_univ _) w.property.2

/-- The attachment part of Theorem 6.3 applied to the literal diagonal end
boxes. The remaining input is the rigidity of the actual diagonal-box core. -/
theorem cube_rigid_of_end_boxes {J : Type*} [Fintype J] [DecidableEq J]
    [Infinite K] (N L e : ℕ) (C : Set (DiagonalBoxNeighbors.Cube (J := J) N))
    (hN : 2 * L ≤ N)
    (hfirst : DiagonalBoxNeighbors.firstBox N L ⊆ C)
    (hlast : DiagonalBoxNeighbors.lastBox N L ⊆ C)
    (hbound : Fintype.card J * N + e ≤
      (L + 1) ^ (Fintype.card J / 2) + (L + 1) ^ ((Fintype.card J + 1) / 2))
    (hcore : GenericallyRigid K (Fin (Fintype.card J * N + e))
      ((RankParameters.chainGraph (fun _ : J => N)).induce C)) :
    GenericallyRigid K (Fin (Fintype.card J * N + e))
      (RankParameters.chainGraph (fun _ : J => N)) := by
  apply genericallyRigid_of_core_neighbors _ C hcore
  intro v hv
  rw [Fintype.card_fin]
  exact DiagonalBoxNeighbors.enough_core_neighbors C v L e hN hfirst hlast hv hbound

end PaperVerification.Segre.CoreAttachment
end
end ProbeLayer389

section ProbeLayer390



/-!
# The actual consecutive diagonal-box core

The core is a literal union of consecutive full boxes. Adjacent boxes share
one diagonal prefix, and all vertices in earlier boxes precede all vertices in
later boxes. The amalgamated-join theorem therefore adds the full-box rigidity
dimensions, giving `k * sum(lengths) + number_of_boxes` exactly.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.DiagonalCore

open Staircase RankParameters GenericRigidity DiagonalBoxNeighbors
open ChainInduction

variable {J : Type*} [Fintype J] [DecidableEq J]

def firstEmbedding (a b : ℕ) : Cube (J := J) a ↪o Cube (J := J) (a + b) where
  toFun u i := ⟨(u i).val, by
    have h : (u i).val < a + 1 := (u i).isLt
    change (u i).val < a + b + 1
    omega⟩
  inj' u v h := by
    funext i
    exact Fin.ext (congrArg (fun w : Cube (J := J) (a + b) => (w i).val) h)
  map_rel_iff' := by intro u v; rfl

def tailEmbedding (a b : ℕ) : Cube (J := J) b ↪o Cube (J := J) (a + b) where
  toFun u i := ⟨a + (u i).val, by
    have h : (u i).val < b + 1 := (u i).isLt
    change a + (u i).val < a + b + 1
    omega⟩
  inj' u v h := by
    funext i
    apply Fin.ext
    have hi := congrArg (fun w : Cube (J := J) (a + b) => (w i).val) h
    change a + (u i).val = a + (v i).val at hi
    omega
  map_rel_iff' := by
    intro u v
    constructor
    · intro h i
      have hi := h i
      change a + (u i).val ≤ a + (v i).val at hi
      change (u i).val ≤ (v i).val
      omega
    · intro h i
      change a + (u i).val ≤ a + (v i).val
      exact Nat.add_le_add_left (h i) a

@[simp] theorem firstEmbedding_bot (a b : ℕ) :
    firstEmbedding (J := J) a b ⊥ = ⊥ := by
  funext i
  exact Fin.ext rfl

@[simp] theorem tailEmbedding_top (a b : ℕ) :
    tailEmbedding (J := J) a b ⊤ = ⊤ := by
  funext i
  exact Fin.ext rfl

theorem tailEmbedding_bot (a b : ℕ) :
    tailEmbedding (J := J) a b ⊥ = firstEmbedding a b ⊤ := by
  funext i
  exact Fin.ext rfl

/-- Two consecutive full boxes meet in exactly their shared diagonal prefix. -/
theorem first_eq_tail_iff (a b : ℕ) (u : Cube (J := J) a) (v : Cube (J := J) b) :
    firstEmbedding a b u = tailEmbedding a b v ↔ u = ⊤ ∧ v = ⊥ := by
  constructor
  · intro h
    have hi (i : J) : (u i).val = a + (v i).val :=
      congrArg (fun w : Cube (J := J) (a + b) => (w i).val) h
    constructor
    · funext i
      apply Fin.ext
      have hu : (u i).val < a + 1 := (u i).isLt
      have h := hi i
      change (u i).val = a
      omega
    · funext i
      apply Fin.ext
      have hu : (u i).val < a + 1 := (u i).isLt
      have h := hi i
      change (v i).val = 0
      omega
  · rintro ⟨rfl,rfl⟩
    exact (tailEmbedding_bot a b).symm

/-- The literal core, as a subset of the cube with total side length. The
empty sequence gives the single zero vertex and starts the induction. -/
def diagonalCore : (s : List ℕ) → Set (Cube (J := J) s.sum)
  | [] => Set.univ
  | a :: s => Set.range (firstEmbedding (J := J) a s.sum) ∪
      (tailEmbedding a s.sum) '' diagonalCore s

theorem bot_mem_core (s : List ℕ) : (⊥ : Cube (J := J) s.sum) ∈ diagonalCore s := by
  cases s with
  | nil => trivial
  | cons a s => exact Or.inl ⟨⊥,firstEmbedding_bot a s.sum⟩

theorem top_mem_core (s : List ℕ) : (⊤ : Cube (J := J) s.sum) ∈ diagonalCore s := by
  induction s with
  | nil => trivial
  | cons a s ih => exact Or.inr ⟨⊤,ih,tailEmbedding_top a s.sum⟩

noncomputable def tailBase (s : List ℕ) : ↥(diagonalCore (J := J) s) :=
  ⟨⊥,bot_mem_core s⟩

/-- Exactly one right-hand vertex is identified with the first box's top. -/
noncomputable def coreStepEquiv (a : ℕ) (s : List ℕ) :
    (Cube (J := J) a ⊕ {w : ↥(diagonalCore (J := J) s) // w ≠ tailBase s}) ≃
      ↥(diagonalCore (J := J) (a :: s)) := by
  classical
  let F : (Cube (J := J) a ⊕ {w : ↥(diagonalCore (J := J) s) // w ≠ tailBase s}) →
      ↥(diagonalCore (J := J) (a :: s)) := fun x => match x with
    | .inl u => ⟨firstEmbedding a s.sum u,Or.inl (Set.mem_range_self u)⟩
    | .inr w => ⟨tailEmbedding a s.sum w.val.val,
        Or.inr ⟨w.val.val,w.val.property,rfl⟩⟩
  apply Equiv.ofBijective F
  constructor
  · intro x y h
    have he := congrArg Subtype.val h
    cases x with
    | inl x =>
      cases y with
      | inl y => exact congrArg Sum.inl ((firstEmbedding a s.sum).injective he)
      | inr y =>
        have hy := ((first_eq_tail_iff a s.sum x y.val.val).mp he).2
        exact False.elim (y.property (Subtype.ext hy))
    | inr x =>
      cases y with
      | inl y =>
        have hx := ((first_eq_tail_iff a s.sum y x.val.val).mp he.symm).2
        exact False.elim (x.property (Subtype.ext hx))
      | inr y =>
        exact congrArg Sum.inr (Subtype.ext (Subtype.ext ((tailEmbedding a s.sum).injective he)))
  · intro z
    rcases z.property with ⟨u,hu⟩ | ⟨w,hw,hz⟩
    · exact ⟨.inl u,Subtype.ext hu⟩
    · let w' : ↥(diagonalCore (J := J) s) := ⟨w,hw⟩
      by_cases hb : w' = tailBase s
      · have hb' : w = ⊥ := congrArg Subtype.val hb
        refine ⟨.inl ⊤,Subtype.ext ?_⟩
        change firstEmbedding a s.sum ⊤ = z.val
        rw [hb'] at hz
        rw [← tailEmbedding_bot]
        exact hz
      · exact ⟨.inr ⟨w',hb⟩,Subtype.ext hz⟩

/-- Every edge of the amalgamated join is an actual comparability edge of the
literal diagonal-box union. -/
theorem coreStep_graph_le (a : ℕ) (s : List ℕ) :
    AmalgamatedJoin.graph (chainGraph (fun _ : J => a))
      ((chainGraph (fun _ : J => s.sum)).induce (diagonalCore s)) (tailBase s) ≤
        ((chainGraph (fun _ : J => (a :: s).sum)).induce (diagonalCore (a :: s))).comap
          (coreStepEquiv a s) := by
  intro v w h
  cases v with
  | inl v =>
    cases w with
    | inl w =>
      change firstEmbedding a s.sum v ≠ firstEmbedding a s.sum w ∧
        (firstEmbedding a s.sum v ≤ firstEmbedding a s.sum w ∨
          firstEmbedding a s.sum w ≤ firstEmbedding a s.sum v)
      exact ⟨fun he => h.1 ((firstEmbedding a s.sum).injective he),
        h.2.imp (fun hvw => (firstEmbedding a s.sum).monotone hvw)
          (fun hwv => (firstEmbedding a s.sum).monotone hwv)⟩
    | inr w =>
      change firstEmbedding a s.sum v ≠ tailEmbedding a s.sum w.val.val ∧
        (firstEmbedding a s.sum v ≤ tailEmbedding a s.sum w.val.val ∨
          tailEmbedding a s.sum w.val.val ≤ firstEmbedding a s.sum v)
      refine ⟨?_,Or.inl ?_⟩
      · intro he
        exact w.property (Subtype.ext ((first_eq_tail_iff a s.sum v w.val.val).mp he).2)
      · intro i
        change (v i).val ≤ a + (w.val.val i).val
        have hv : (v i).val < a + 1 := (v i).isLt
        omega
  | inr v =>
    cases w with
    | inl w =>
      change tailEmbedding a s.sum v.val.val ≠ firstEmbedding a s.sum w ∧
        (tailEmbedding a s.sum v.val.val ≤ firstEmbedding a s.sum w ∨
          firstEmbedding a s.sum w ≤ tailEmbedding a s.sum v.val.val)
      refine ⟨?_,Or.inr ?_⟩
      · intro he
        exact v.property (Subtype.ext ((first_eq_tail_iff a s.sum w v.val.val).mp he.symm).2)
      · intro i
        change (w i).val ≤ a + (v.val.val i).val
        have hw : (w i).val < a + 1 := (w i).isLt
        omega
    | inr w =>
      change tailEmbedding a s.sum v.val.val ≠ tailEmbedding a s.sum w.val.val ∧
        (tailEmbedding a s.sum v.val.val ≤ tailEmbedding a s.sum w.val.val ∨
          tailEmbedding a s.sum w.val.val ≤ tailEmbedding a s.sum v.val.val)
      exact ⟨fun he => h.1 ((tailEmbedding a s.sum).injective he),
        h.2.imp (fun hvw => (tailEmbedding a s.sum).monotone hvw)
          (fun hwv => (tailEmbedding a s.sum).monotone hwv)⟩

theorem coreStep_rigid {K U V : Type*} [Field K]
    [Fintype U] [DecidableEq U] [Fintype V] [DecidableEq V]
    (a : ℕ) (s : List ℕ)
    (hfirst : GenericallyRigid K U (chainGraph (fun _ : J => a)))
    (htail : GenericallyRigid K V ((chainGraph (fun _ : J => s.sum)).induce (diagonalCore s))) :
    GenericallyRigid K (U ⊕ V)
      ((chainGraph (fun _ : J => (a :: s).sum)).induce (diagonalCore (a :: s))) := by
  classical
  apply ThreeChainCores.rigid_of_le_comap_equiv _ _ (coreStepEquiv a s) (coreStep_graph_le a s)
  exact AmalgamatedJoin.genericallyRigid_amalgamated _ _ ⊤ (tailBase s) hfirst htail

theorem range_firstEmbedding (a b : ℕ) :
    Set.range (firstEmbedding (J := J) a b) = firstBox (a + b) a := by
  ext v
  constructor
  · rintro ⟨u,rfl⟩ i
    exact Nat.le_of_lt_succ (u i).isLt
  · intro hv
    refine ⟨fun i => ⟨(v i).val,Nat.lt_succ_of_le (hv i)⟩,?_⟩
    funext i
    exact Fin.ext rfl

/-- The entire first box belongs to the core, rather than just its selected
interior or diagonal prefix vertices. -/
theorem firstBox_subset_core_cons (a : ℕ) (s : List ℕ) :
    firstBox (J := J) (a :: s).sum a ⊆ diagonalCore (a :: s) := by
  intro v hv
  exact Or.inl ((range_firstEmbedding (J := J) a s.sum).symm ▸ hv)

/-- The entire final box belongs to the core for every prefix of side lengths. -/
theorem lastBox_subset_core_append (s : List ℕ) (L : ℕ) :
    lastBox (J := J) (s ++ [L]).sum L ⊆ diagonalCore (s ++ [L]) := by
  induction s with
  | nil =>
    intro v _
    apply firstBox_subset_core_cons L []
    intro i
    exact Nat.le_of_lt_succ (v i).isLt
  | cons a s ih =>
    intro v hv
    let N := (s ++ [L]).sum
    have hL : L ≤ N := by
      dsimp only [N]
      rw [List.sum_append,List.sum_singleton]
      omega
    have hva (i : J) : a ≤ (v i).val := by
      have h : a + N - (v i).val ≤ L := hv i
      have hb : (v i).val < a + N + 1 := (v i).isLt
      omega
    let u : Cube (J := J) N := fun i => ⟨(v i).val - a,by
      have hb : (v i).val < a + N + 1 := (v i).isLt
      change (v i).val - a < N + 1
      omega⟩
    have hu : u ∈ lastBox N L := by
      intro i
      change N - ((v i).val - a) ≤ L
      have h : a + N - (v i).val ≤ L := hv i
      have ha := hva i
      have hb : (v i).val < a + N + 1 := (v i).isLt
      omega
    refine Or.inr ⟨u,ih hu,?_⟩
    funext i
    apply Fin.ext
    change a + ((v i).val - a) = (v i).val
    exact Nat.add_sub_of_le (hva i)

def minimumSide (k : ℕ) : ℕ := if k = 3 then 2 else 1

theorem minimumSide_pos (k : ℕ) : 1 ≤ minimumSide k := by
  unfold minimumSide
  split_ifs <;> omega

/-- Every full uniform box required by Section 6.3 is one of the already
proved nonexceptional first-Lefschetz rigidity cases. -/
theorem uniform_box_rigid {K : Type*} [Field K] [Infinite K]
    (k a : ℕ) (hk : 3 ≤ k) (ha : minimumSide k ≤ a) :
    GenericallyRigid K (Fin (k * a + 1)) (chainGraph (fun _ : Fin k => a)) := by
  have hpos : ∀ _i : Fin k, 1 ≤ a := fun _ => (minimumSide_pos k).trans ha
  have hex : ∀ h : k = 3, ¬ ChainClassification.ExceptionalTriple
      (fun i : Fin 3 => (fun _ : Fin k => a) (Fin.cast h.symm i)) := by
    intro h he
    subst k
    have ha2 : 2 ≤ a := by
      change 2 ≤ a at ha
      exact ha
    rcases he with ⟨p,he | he | he⟩
    all_goals have h := congrFun he (0 : Fin 3)
    all_goals change a = 1 at h
    all_goals omega
  have h := ChainClassification.positive_nonexceptional (K := K) k hk
    (fun _ => a) hpos hex
  apply genericallyRigid_fin _ _ ?_ h
  simp [sideSum,Fintype.card_fin,Nat.mul_comm]

/-- The actual consecutive-box core has rigidity dimension `kN+t`, where
`N` is the sum of all side lengths and `t` is their number. -/
theorem diagonalCore_rigid {K : Type*} [Field K] [Infinite K]
    (k : ℕ) (hk : 3 ≤ k) (s : List ℕ) (hs : ∀ a ∈ s, minimumSide k ≤ a) :
    GenericallyRigid K (Fin (k * s.sum + s.length))
      ((chainGraph (fun _ : Fin k => s.sum)).induce (diagonalCore s)) := by
  classical
  induction s with
  | nil =>
    let T := ↥(diagonalCore (J := Fin k) [])
    have ht : Nonempty T := ⟨⟨⊥,bot_mem_core []⟩⟩
    have hg : (⊤ : SimpleGraph T) =
        ((chainGraph (fun _ : Fin k => 0)).induce (diagonalCore [])) := by
      ext v w
      have he : v = w := by
        apply Subtype.ext
        funext i
        exact Subsingleton.elim (α := Fin 1) _ _
      subst w
      constructor <;> intro h <;> exact False.elim (h.ne rfl)
    have hc : Fintype.card (Fin 0) + 1 ≤ Fintype.card T := by
      simp only [Fintype.card_fin,zero_add]
      exact Fintype.card_pos_iff.mpr ht
    have hr := complete_genericallyRigid (K := K) (I := Fin 0) (V := T) hc
    have hr' : GenericallyRigid K (Fin 0)
        ((chainGraph (fun _ : Fin k => 0)).induce (diagonalCore [])) := by
      simpa only [hg] using hr
    apply genericallyRigid_fin _ _ ?_ hr'
    simp
  | cons a s ih =>
    have hfirst := uniform_box_rigid (K := K) k a hk (hs a (by simp))
    have htail := ih (fun b hb => hs b (List.mem_cons_of_mem a hb))
    have hstep := coreStep_rigid (J := Fin k) a s hfirst htail
    apply genericallyRigid_fin _ _ ?_ hstep
    simp only [Fintype.card_sum,Fintype.card_fin,List.sum_cons,List.length_cons]
    ring

end PaperVerification.Segre.DiagonalCore
end
end ProbeLayer390


/-! Future-only kernel audit for one exported mathematical stage.

Append to the stage being checked, with Lean.Util.CollectAxioms available through
both `public import Lean.Util.CollectAxioms` and `import all Lean.Util.CollectAxioms`
in that stage's header, as required by the reviewed FullFlattenedAudit.

Every new declaration in the checked kernel environment is included: public,
private, generated and vendored declarations receive the same direct-sorry and
transitive-axiom checks. This is evidence for this stage only. Later principal
theorems need not exist yet, and the final full principal audit remains required.

This preparation does not execute the audit, export a module or alter a proof.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The stage kernel audit requires kernel trust level zero"
  let names := (env.checked.get.constants.foldStage2
    (fun (names : Array Name) name _ => names.push name) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The stage mathematical module is empty"
  let privateEnv := env.setExporting false
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut theoremCount : Nat := 0
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if let .thmInfo _ := info then
      theoremCount := theoremCount + 1
  let report := Json.mkObj [
    ("main_module", toJson env.header.mainModule.toString),
    ("declaration_count", toJson names.size),
    ("theorem_count", toJson theoremCount),
    ("trust_level", toJson env.header.trustLevel.toNat),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("audit_scope", toJson "current_stage_new_declarations")]
  logInfo m!"SEGRE_STAGE_KERNEL_AUDIT_PASS {report.compress}"
