section SegreSheafCoefficientComplex

/-!
# The square-zero law for the actual sheaf coefficient contraction

The differential is the actual exterior contraction, tensor associator, and
coefficient multiplication. Its square-zero law is proved on all local wedges
and transported from the already explicit alternating-deletion formula. The
proof uses only symmetry of the given bilinear coefficient multiplication;
there is no division by two and no characteristic or local-freeness premise.

-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.SheafCoefficientComplex

open CategoryTheory MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open SheafCoefficientContraction
open scoped TensorProduct BigOperators

universe u

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

set_option hygiene false in
set_option quotPrecheck false in local notation "Sh" => SheafOfModules.{u} (ringCatSheaf R)

variable {M N L P M' N' : Sh}

/-- Naturality of the actual local tensor comparison. -/
theorem tensorSection_map (f : M ⟶ M') (g : N ⟶ N') (U : Cᵒᵖ)
    (x : M.val.obj U) (y : N.val.obj U) :
    (f ⊗ₘ g).val.app U (tensorSection R M N U x y) =
      tensorSection R M' N' U (f.val.app U x) (g.val.app U y) := by
  have h := congrArg
    (fun η : M.val ⊗ N.val ⟶ (M' ⊗ N').val =>
      (η.app' U).hom (x ⊗ₜ[R.obj.obj U] y))
    (Functor.LaxMonoidal.μ_natural
      (SheafOfModules.forget (ringCatSheaf R)) f g)
  change (Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) M' N').app U
      (TensorProduct.map (f.val.app' U).hom (g.val.app' U).hom
        (x ⊗ₜ[R.obj.obj U] y)) =
    (f ⊗ₘ g).val.app U (tensorSection R M N U x y) at h
  erw [TensorProduct.map_tmul] at h
  exact h.symm

set_option maxHeartbeats 1000000 in
/-- Associativity is the actual monoidal associator on the canonical local tensors. -/
theorem tensorSection_assoc (U : Cᵒᵖ)
    (x : M.val.obj U) (y : N.val.obj U) (z : P.val.obj U) :
    (α_ M N P).hom.val.app U
        (tensorSection R (M ⊗ N) P U (tensorSection R M N U x y) z) =
      tensorSection R M (N ⊗ P) U x (tensorSection R N P U y z) := by
  have h := congrArg
    (fun η : (M.val ⊗ N.val) ⊗ P.val ⟶ (M ⊗ (N ⊗ P)).val =>
      (η.app' U).hom ((x ⊗ₜ[R.obj.obj U] y) ⊗ₜ[R.obj.obj U] z))
    (Functor.LaxMonoidal.associativity
      (SheafOfModules.forget (ringCatSheaf R)) M N P)
  change (α_ M N P).hom.val.app U
      ((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) (M ⊗ N) P).app U
        (TensorProduct.map
          ((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) M N).app' U).hom
          LinearMap.id ((x ⊗ₜ[R.obj.obj U] y) ⊗ₜ[R.obj.obj U] z))) =
    (Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) M (N ⊗ P)).app U
      (TensorProduct.map LinearMap.id
        ((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) N P).app' U).hom
        (TensorProduct.assoc (R.obj.obj U) (M.val.obj U) (N.val.obj U) (P.val.obj U)
          ((x ⊗ₜ[R.obj.obj U] y) ⊗ₜ[R.obj.obj U] z))) at h
  erw [TensorProduct.map_tmul, TensorProduct.assoc_tmul, TensorProduct.map_tmul] at h
  exact h

/-- Symmetry is the actual sheaf braiding, including in characteristic two. -/
theorem tensorSection_braiding (U : Cᵒᵖ)
    (x : M.val.obj U) (y : N.val.obj U) :
    (β_ M N).hom.val.app U (tensorSection R M N U x y) =
      tensorSection R N M U y x := by
  have h := congrArg
    (fun η : M.val ⊗ N.val ⟶ (N ⊗ M).val =>
      (η.app' U).hom (x ⊗ₜ[R.obj.obj U] y))
    (Functor.LaxBraided.braided
      (F := SheafOfModules.forget (ringCatSheaf R)) M N)
  change (β_ M N).hom.val.app U (tensorSection R M N U x y) =
    (Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) N M).app U
      (TensorProduct.comm (R.obj.obj U) (M.val.obj U) (N.val.obj U)
        (x ⊗ₜ[R.obj.obj U] y)) at h
  simpa only [TensorProduct.comm_tmul, tensorSection] using h

/-- The literal bilinear multiplication of coefficient sections induced by
a morphism from the actual tensor sheaf. -/
def pairingAt (μ : L ⊗ L ⟶ P) (U : Cᵒᵖ) :
    L.val.obj U →ₗ[R.obj.obj U] L.val.obj U →ₗ[R.obj.obj U] P.val.obj U :=
  TensorProduct.curry
    (((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) L L) ≫
      (SheafOfModules.forget (ringCatSheaf R)).map μ).app' U).hom

@[simp] theorem pairingAt_apply (μ : L ⊗ L ⟶ P) (U : Cᵒᵖ)
    (x y : L.val.obj U) :
    pairingAt R μ U x y = μ.val.app U (tensorSection R L L U x y) := rfl

/-- A symmetric sheaf multiplication gives a genuinely symmetric bilinear
multiplication on every section module. -/
theorem pairingAt_symmetric (μ : L ⊗ L ⟶ P)
    (hμ : (β_ L L).hom ≫ μ = μ) (U : Cᵒᵖ) :
    ∀ x y, pairingAt R μ U x y = pairingAt R μ U y x := by
  intro x y
  have h := ConcreteCategory.congr_hom
    (congrArg (fun η => η.val.app U) hμ) (tensorSection R L L U x y)
  change μ.val.app U ((β_ L L).hom.val.app U (tensorSection R L L U x y)) =
    μ.val.app U (tensorSection R L L U x y) at h
  rw [tensorSection_braiding] at h
  exact h.symm

/-- Embed the full sectionwise exterior tensor into the actual sheaf tensor. -/
def wedgeTensorLift (M P : Sh) (n : ℕ) (U : Cᵒᵖ) :
    (⋀[R.obj.obj U]^n (M.val.obj U)) ⊗[R.obj.obj U] P.val.obj U →ₗ[R.obj.obj U]
      (((SheafOfModules.exteriorPower R n).obj M) ⊗ P).val.obj U :=
  ((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R))
      ((SheafOfModules.exteriorPower R n).obj M) P).app' U).hom ∘ₗ
    TensorProduct.map ((exteriorUnit R M n).app' U).hom LinearMap.id

@[simp] theorem wedgeTensorLift_ιMulti_tmul (M P : Sh) (n : ℕ) (U : Cᵒᵖ)
    (v : Fin n → M.val.obj U) (p : P.val.obj U) :
    wedgeTensorLift R M P n U (exteriorPower.ιMulti (R.obj.obj U) n v ⊗ₜ p) =
      tensorSection R ((SheafOfModules.exteriorPower R n).obj M) P U
        (wedgeSection R M n U v) p := rfl

/-- The second differential retains and multiplies the coefficient already
produced by the first differential. -/
def pairedContraction (φ : M ⟶ L) (μ : L ⊗ L ⟶ P) (n : ℕ) :
    ((SheafOfModules.exteriorPower R (n + 1)).obj M) ⊗ L ⟶
      ((SheafOfModules.exteriorPower R n).obj M) ⊗ P :=
  (contraction R φ n ⊗ₘ 𝟙 L) ≫
    (α_ ((SheafOfModules.exteriorPower R n).obj M) L L).hom ≫
      (𝟙 ((SheafOfModules.exteriorPower R n).obj M) ⊗ₘ μ)

/-- The actual second differential agrees with the literal paired deletion
operator on every local wedge and coefficient. -/
theorem pairedContraction_wedge_tensor (φ : M ⟶ L) (μ : L ⊗ L ⟶ P)
    (n : ℕ) (U : Cᵒᵖ) (v : Fin (n + 1) → M.val.obj U) (l : L.val.obj U) :
    (pairedContraction R φ μ n).val.app U
        (tensorSection R ((SheafOfModules.exteriorPower R (n + 1)).obj M) L U
          (wedgeSection R M (n + 1) U v) l) =
      wedgeTensorLift R M P n U
        (CoefficientContraction.pairedContraction (φ.val.app' U).hom
          (pairingAt R μ U) n (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v ⊗ₜ l)) := by
  simp only [pairedContraction, SheafOfModules.comp_val, PresheafOfModules.comp_app,
    ConcreteCategory.comp_apply, SheafOfModules.id_val,
    tensorSection_map, PresheafOfModules.id_app, ConcreteCategory.id_apply,
    contraction_wedgeSection]
  simp only [tensorSection, TensorProduct.sum_tmul, ← TensorProduct.smul_tmul',
    map_sum, map_zsmul]
  change (∑ i : Fin (n + 1), (-1 : ℤ) ^ (i : ℕ) •
    (𝟙 ((SheafOfModules.exteriorPower R n).obj M) ⊗ₘ μ).val.app U
      ((α_ ((SheafOfModules.exteriorPower R n).obj M) L L).hom.val.app U
        (tensorSection R (((SheafOfModules.exteriorPower R n).obj M) ⊗ L) L U
          (tensorSection R ((SheafOfModules.exteriorPower R n).obj M) L U
            (wedgeSection R M n U (i.removeNth v)) (φ.val.app U (v i))) l))) = _
  simp only [tensorSection_assoc, tensorSection_map, SheafOfModules.id_val,
    PresheafOfModules.id_app, ConcreteCategory.id_apply]
  erw [CoefficientContraction.pairedContraction_tmul,
    CoefficientContraction.contraction_ιMulti]
  have happ (z : M.val.obj U) : (φ.val.app' U).hom z = φ.val.app U z := rfl
  simp only [map_sum, map_zsmul, CoefficientContraction.pairedCoefficient_apply, happ]
  apply Finset.sum_congr rfl
  intro i _
  apply congrArg (((-1 : ℤ) ^ (i : ℕ)) • ·)
  erw [wedgeTensorLift_ιMulti_tmul, pairingAt_apply]

/-- The actual sheaf differentials compose to zero, with their full tensor
and coefficient structure retained. -/
theorem pairedContraction_comp_contraction_eq_zero
    (φ : M ⟶ L) (μ : L ⊗ L ⟶ P)
    (hμ : (β_ L L).hom ≫ μ = μ) (n : ℕ) :
    contraction R φ (n + 1) ≫ pairedContraction R φ μ n = 0 := by
  apply TauCeti.SheafOfModules.exteriorPower_hom_ext (n + 2) M
  intro U v
  change (pairedContraction R φ μ n).val.app U
      ((contraction R φ (n + 1)).val.app U (wedgeSection R M (n + 2) U v)) = 0
  rw [contraction_wedgeSection]
  simp only [map_sum, map_zsmul, pairedContraction_wedge_tensor]
  have hzero := CoefficientContraction.pairedContraction_comp_contraction_eq_zero
    (φ.val.app' U).hom (pairingAt R μ U) (pairingAt_symmetric R μ hμ U) n
  have hv := congrArg (wedgeTensorLift R M P n U)
    (LinearMap.congr_fun hzero (exteriorPower.ιMulti (R.obj.obj U) (n + 2) v))
  simp only [LinearMap.comp_apply, LinearMap.zero_apply] at hv
  erw [CoefficientContraction.contraction_ιMulti (R := R.obj.obj U)
    (φ.val.app' U).hom (n + 1) v] at hv
  have happ (z : M.val.obj U) : (φ.val.app' U).hom z = φ.val.app U z := rfl
  simp only [map_sum, map_zsmul, map_zero, happ] at hv
  convert hv using 1
  rfl

end PaperVerification.Segre.SheafCoefficientComplex

end SegreSheafCoefficientComplex

section SegreSheafKoszul

/-!
# The literal contraction complex of exterior-power sheaves

A sheaf map to the structure sheaf induces contraction on sectionwise exterior
powers. Naturality is proved from the explicit alternating deletion formula.
Sheafification then gives maps on the actual exterior-power sheaves. A global
splitting induces the literal wedge homotopy. This is the canonical construction
that will be restricted to projective coordinate charts in the exterior Euler
comparison; no exact sequence is introduced as an assumption.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false



namespace PaperVerification.Segre.SheafKoszul

open CategoryTheory Limits
open TauCeti
open TauCeti.SheafOfModules (ringCatSheaf)

universe u

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable {R : Sheaf J CommRingCat.{u}}
variable {M : SheafOfModules.{u} (ringCatSheaf R)}

/-- The functional on the full section module induced by the actual sheaf morphism. -/
def sectionFunctional (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (U : Cᵒᵖ) :
    Module.Dual (R.obj.obj U) (PresheafOfModulesOfCommRing.obj (R := R.obj) M.val U) :=
  (φ.val.app' U).hom

/-- Its compatibility with restriction is exactly naturality of the original sheaf morphism. -/
theorem sectionFunctional_natural (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R))
    {U V : Cᵒᵖ} (f : U ⟶ V) (x : M.val.obj U) :
    sectionFunctional φ V (M.val.map f x)=R.obj.map f (sectionFunctional φ U x) :=
  PresheafOfModulesOfCommRing.naturality_apply φ.val f x

/-- The public restriction formula, written with the literal algebraic exterior
constructor used by the Koszul differential. -/
theorem exteriorRestriction_ιMulti (p : ℕ) {U V : Cᵒᵖ} (f : U ⟶ V)
    (v : Fin p → PresheafOfModulesOfCommRing.obj (R := R.obj) M.val U) :
    ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) p).obj M.val).map f
        (exteriorPower.ιMulti (R.obj.obj U) p v) =
      exteriorPower.ιMulti (R.obj.obj V)
        (M := PresheafOfModulesOfCommRing.obj (R := R.obj) M.val V) p
        (fun i => M.val.map f (v i)) := by
  exact PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk p M.val f v

/-- Contraction on the literal presheaf of sectionwise exterior powers. -/
def presheafDifferential (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (p : ℕ) :
    ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) (p+1)).obj M.val) ⟶
      ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) p).obj M.val) :=
  PresheafOfModulesOfCommRing.homMk
    (fun U => ModuleCat.ofHom (koszulDifferential (sectionFunctional φ U) p))
    (fun {U V} f => by
      apply ModuleCat.exteriorPower.hom_ext
      ext v
      change koszulDifferential (sectionFunctional φ V) p
        (((PresheafOfModulesOfCommRing.exteriorPower (p+1)).obj M.val).map f
          (exteriorPower.ιMulti (R.obj.obj U) (p+1) v))=
        ((PresheafOfModulesOfCommRing.exteriorPower p).obj M.val).map f
          (koszulDifferential (sectionFunctional φ U) p
            (exteriorPower.ιMulti (R.obj.obj U) (p+1) v))
      erw [exteriorRestriction_ιMulti,
        koszulDifferential_ιMulti,koszulDifferential_ιMulti]
      simp only [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      erw [PresheafOfModules.map_smul, exteriorRestriction_ιMulti]
      erw [sectionFunctional_natural, map_mul, map_pow, map_neg, map_one]
      rfl)

@[simp] theorem presheafDifferential_app
    (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (p : ℕ) (U : Cᵒᵖ) :
    (presheafDifferential φ p).app U=
      ModuleCat.ofHom (koszulDifferential (sectionFunctional φ U) p) := rfl

/-- The presheaf contraction differential squares to zero. -/
theorem presheafDifferential_squared
    (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (p : ℕ) :
    presheafDifferential φ (p+1) ≫ presheafDifferential φ p=0 := by
  ext U : 1
  apply ModuleCat.hom_ext
  change koszulDifferential (sectionFunctional φ U) p ∘ₗ
    koszulDifferential (sectionFunctional φ U) (p+1) = 0
  exact koszulDifferential_comp_koszulDifferential (sectionFunctional φ U) p

/-- The contraction map between the actual sheaf exterior powers. -/
def differential (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (p : ℕ) :
    (SheafOfModules.exteriorPower R (p+1)).obj M ⟶
      (SheafOfModules.exteriorPower R p).obj M :=
  (SheafOfModules.exteriorPowerIso (p+1) M).hom ≫
    (PresheafOfModules.sheafification (𝟙 (ringCatSheaf R).obj)).map
      (presheafDifferential φ p) ≫
    (SheafOfModules.exteriorPowerIso p M).inv

/-- The actual sheaf contraction differential squares to zero. -/
theorem differential_squared (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (p : ℕ) :
    differential φ (p+1) ≫ differential φ p=0 := by
  simp only [differential, Category.assoc, Iso.inv_hom_id_assoc]
  rw [← CategoryTheory.Functor.map_comp_assoc, presheafDifferential_squared, CategoryTheory.Functor.map_zero,
    zero_comp, comp_zero]

/-- Wedge multiplication by the section selected by a sheaf map out of the unit. -/
def presheafWedge (σ : SheafOfModules.unit (ringCatSheaf R) ⟶ M) (p : ℕ) :
    ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) p).obj M.val) ⟶
      ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) (p+1)).obj M.val) :=
  PresheafOfModulesOfCommRing.homMk
    (fun U => ModuleCat.ofHom (TauCeti.ExteriorAlgebra.wedgeLeft (σ.val.app U (1 : R.obj.obj U)) p))
    (fun {U V} f => by
      apply ModuleCat.exteriorPower.hom_ext
      ext v
      change TauCeti.ExteriorAlgebra.wedgeLeft (σ.val.app V (1 : R.obj.obj V)) p
        (((PresheafOfModulesOfCommRing.exteriorPower p).obj M.val).map f
          (exteriorPower.ιMulti (R.obj.obj U) p v))=
        ((PresheafOfModulesOfCommRing.exteriorPower (p+1)).obj M.val).map f
          (TauCeti.ExteriorAlgebra.wedgeLeft (σ.val.app U (1 : R.obj.obj U)) p
            (exteriorPower.ιMulti (R.obj.obj U) p v))
      erw [exteriorRestriction_ιMulti,
        TauCeti.ExteriorAlgebra.wedgeLeft_ιMulti,TauCeti.ExteriorAlgebra.wedgeLeft_ιMulti,
        exteriorRestriction_ιMulti]
      apply congrArg (exteriorPower.ιMulti (R.obj.obj V) (p+1))
      funext i
      refine Fin.cases ?_ (fun j => rfl) i
      change σ.val.app V (1 : R.obj.obj V) =
        M.val.map f (σ.val.app U (1 : R.obj.obj U))
      have hn := PresheafOfModulesOfCommRing.naturality_apply σ.val f (1 : R.obj.obj U)
      change σ.val.app V
          ((PresheafOfModules.unit (ringCatSheaf R).obj).map f (1 : R.obj.obj U)) =
        M.val.map f (σ.val.app U (1 : R.obj.obj U)) at hn
      erw [PresheafOfModules.unit_map_one] at hn
      exact hn)

@[simp] theorem presheafWedge_app
    (σ : SheafOfModules.unit (ringCatSheaf R) ⟶ M) (p : ℕ) (U : Cᵒᵖ) :
    (presheafWedge σ p).app U=
      ModuleCat.ofHom (TauCeti.ExteriorAlgebra.wedgeLeft (σ.val.app U (1 : R.obj.obj U)) p) := rfl

/-- Wedge multiplication as a morphism of actual exterior-power sheaves. -/
def wedge (σ : SheafOfModules.unit (ringCatSheaf R) ⟶ M) (p : ℕ) :
    (SheafOfModules.exteriorPower R p).obj M ⟶
      (SheafOfModules.exteriorPower R (p+1)).obj M :=
  (SheafOfModules.exteriorPowerIso p M).hom ≫
    (PresheafOfModules.sheafification (𝟙 (ringCatSheaf R).obj)).map
      (presheafWedge σ p) ≫
    (SheafOfModules.exteriorPowerIso (p+1) M).inv

/-- A split functional gives the full literal wedge-contraction homotopy on presheaves. -/
theorem presheaf_contracting_identity
    (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R))
    (σ : SheafOfModules.unit (ringCatSheaf R) ⟶ M) (hσ : σ ≫ φ=𝟙 _) (p : ℕ) :
    presheafDifferential φ p ≫ presheafWedge σ p+
      presheafWedge σ (p+1) ≫ presheafDifferential φ (p+1)=𝟙 _ := by
  ext U : 1
  apply ModuleCat.hom_ext
  have h : sectionFunctional φ U (σ.val.app U (1 : R.obj.obj U))=1 := by
    have hh := congrArg
      (fun f : SheafOfModules.unit (ringCatSheaf R) ⟶
          SheafOfModules.unit (ringCatSheaf R) =>
        (f.val.app' U).hom (1 : R.obj.obj U)) hσ
    exact hh
  simpa only [PresheafOfModules.add_app, PresheafOfModules.comp_app,
    PresheafOfModules.id_app, ModuleCat.hom_add,ModuleCat.hom_comp,
    presheafDifferential_app,presheafWedge_app,
    ModuleCat.hom_ofHom,ModuleCat.hom_id,h,one_smul] using
      wedgeLeft_comp_koszulDifferential_add (sectionFunctional φ U) (σ.val.app U (1 : R.obj.obj U)) p

/-- The same homotopy is an identity of the actual sheaf morphisms. -/
theorem contracting_identity
    (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R))
    (σ : SheafOfModules.unit (ringCatSheaf R) ⟶ M) (hσ : σ ≫ φ=𝟙 _) (p : ℕ) :
    differential φ p ≫ wedge σ p+wedge σ (p+1) ≫ differential φ (p+1)=𝟙 _ := by
  let F := PresheafOfModules.sheafification (𝟙 (ringCatSheaf R).obj)
  letI : F.IsLeftAdjoint := by
    dsimp only [F]
    infer_instance
  letI : PreservesBinaryBiproducts F :=
    preservesBinaryBiproducts_of_preservesBinaryCoproducts F
  letI : F.Additive := Functor.additive_of_preservesBinaryBiproducts F
  let e := SheafOfModules.exteriorPowerIso (p+1) M
  calc
    _ = e.hom ≫ F.map (presheafDifferential φ p ≫ presheafWedge σ p +
        presheafWedge σ (p+1) ≫ presheafDifferential φ (p+1)) ≫ e.inv := by
      erw [CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_comp,
        CategoryTheory.Functor.map_comp]
      simp only [differential, wedge, F, e,
        Preadditive.comp_add, Preadditive.add_comp, Category.assoc, Iso.inv_hom_id_assoc]
    _ = 𝟙 _ := by
      erw [presheaf_contracting_identity φ σ hσ, CategoryTheory.Functor.map_id,
        Category.id_comp]
      exact e.hom_inv_id

/-- The full actual short complex of contraction maps. -/
def shortComplex (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R)) (p : ℕ) :
    ShortComplex (SheafOfModules.{u} (ringCatSheaf R)) :=
  ShortComplex.mk (differential φ (p+1)) (differential φ p) (differential_squared φ p)

/-- Every actual sheaf contraction cycle is a boundary under a global splitting. -/
theorem exact_of_split
    (φ : M ⟶ SheafOfModules.unit (ringCatSheaf R))
    (σ : SheafOfModules.unit (ringCatSheaf R) ⟶ M) (hσ : σ ≫ φ=𝟙 _) (p : ℕ) :
    (shortComplex φ p).Exact := by
  apply ((shortComplex φ p).exact_iff_epi_kernel_lift).mpr
  let f := differential φ (p+1)
  let g := differential φ p
  let i := kernel.ι g
  have hright : (i ≫ wedge σ (p+1)) ≫ kernel.lift g f (differential_squared φ p)=𝟙 _ := by
    apply (cancel_mono i).1
    rw [Category.assoc,Category.assoc,kernel.lift_ι,Category.id_comp]
    have hh := congrArg (fun h => i ≫ h) (contracting_identity φ σ hσ p)
    dsimp only [i, g] at hh
    simp only [Preadditive.comp_add,← Category.assoc,kernel.condition,
      zero_comp,zero_add,Category.comp_id] at hh
    simpa only [i, f, g, Category.assoc] using hh
  exact epi_of_epi_fac hright

end PaperVerification.Segre.SheafKoszul

end SegreSheafKoszul

section SegreWeightedSheafKoszul

/-!
# The actual weighted exterior Koszul complex

The presheaf terms retain the full sectionwise exterior powers and the
actual coefficient sheaves. Sheafification, followed by its canonical
monoidal and exterior-power comparisons, gives terms exactly
`Λ^r M ⊗ Q_r`. The square-zero law comes from the actual weighted
alternating deletion maps, without postulating a complex or a resolution.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
open scoped Classical TensorProduct BigOperators

namespace PaperVerification.Segre.WeightedSheafKoszul

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open SheafCoefficientContraction

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

set_option hygiene false in
set_option quotPrecheck false in local notation "Sh" => SheafOfModules.{u} (ringCatSheaf R)
set_option hygiene false in
set_option quotPrecheck false in local notation "PSh" => PresheafOfModulesOfCommRing.{u} R.obj
set_option hygiene false in
set_option quotPrecheck false in local notation "F" => PresheafOfModules.sheafification.{u} (𝟙 (ringCatSheaf R).obj)
local notation "G" => SheafOfModules.forget (ringCatSheaf R)

variable {M L P Q : Sh}

/-- The actual coefficient multiplication on underlying presheaves. -/
def presheafMultiplication (μ : L ⊗ Q ⟶ P) : L.val ⊗ Q.val ⟶ P.val :=
  Functor.LaxMonoidal.μ G L Q ≫ (G).map μ

/-- The actual bilinear coefficient multiplication on every section
module, including its coefficient ring. -/
def multiplicationAt (μ : L ⊗ Q ⟶ P) (U : Cᵒᵖ) :
    L.val.obj U →ₗ[R.obj.obj U] Q.val.obj U →ₗ[R.obj.obj U] P.val.obj U :=
  TensorProduct.curry ((presheafMultiplication R μ).app' U).hom

@[simp] theorem multiplicationAt_apply (μ : L ⊗ Q ⟶ P) (U : Cᵒᵖ)
    (l : L.val.obj U) (q : Q.val.obj U) :
    multiplicationAt R μ U l q = μ.val.app U (tensorSection R L Q U l q) := rfl

/-- The weighted differential is a composite of actual presheaf maps;
its restriction compatibility is therefore part of the construction. -/
def presheafDifferential (φ : M ⟶ L) (μ : L ⊗ Q ⟶ P) (n : ℕ) :
    ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) (n+1)).obj M.val) ⊗ Q.val ⟶
      ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val) ⊗ P.val :=
  (SheafCoefficientContraction.presheafContraction φ.val n ⊗ₘ 𝟙 Q.val) ≫
    (α_ ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val)
      L.val Q.val).hom ≫
    (𝟙 ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val) ⊗ₘ
      presheafMultiplication R μ)

theorem presheafDifferential_wedge_tensor (φ : M ⟶ L) (μ : L ⊗ Q ⟶ P)
    (n : ℕ) (U : Cᵒᵖ) (v : Fin (n+1) → M.val.obj U) (q : Q.val.obj U) :
    (presheafDifferential R φ μ n).app' U
      (exteriorPower.ιMulti (R.obj.obj U) (n+1) v ⊗ₜ q) =
        ∑ i : Fin (n+1), (-1 : ℤ) ^ (i : ℕ) •
          (exteriorPower.ιMulti (R.obj.obj U) n (i.removeNth v) ⊗ₜ
            multiplicationAt R μ U (φ.val.app U (v i)) q) := by
  change TensorProduct.map LinearMap.id ((presheafMultiplication R μ).app' U).hom
    (TensorProduct.assoc (R.obj.obj U) (⋀[R.obj.obj U]^n (M.val.obj U))
      (L.val.obj U) (Q.val.obj U)
      (TensorProduct.map
        (CoefficientContraction.contraction (φ.val.app' U).hom n) LinearMap.id
        (exteriorPower.ιMulti (R.obj.obj U) (n+1) v ⊗ₜ q))) = _
  simp only [TensorProduct.map_tmul, LinearMap.id_apply]
  erw [CoefficientContraction.contraction_ιMulti]
  simp only [TensorProduct.sum_tmul, TensorProduct.smul_tmul', map_sum, map_zsmul,
    TensorProduct.assoc_tmul, TensorProduct.map_tmul, LinearMap.id_apply,
    multiplicationAt, TensorProduct.curry_apply]
  apply Finset.sum_congr rfl
  intro i _
  erw [TensorProduct.assoc_tmul, TensorProduct.map_tmul]
  rfl

set_option maxHeartbeats 1000000 in
/-- Full equality with the ordinary module-valued weighted differential;
the comparison is proved on all exterior and tensor generators. -/
theorem presheafDifferential_app (φ : M ⟶ L) (μ : L ⊗ Q ⟶ P)
    (n : ℕ) (U : Cᵒᵖ) :
    ((presheafDifferential R φ μ n).app' U).hom =
      WeightedContraction.differential (R := R.obj.obj U) (φ.val.app' U).hom
        (multiplicationAt R μ U) n := by
  apply TensorProduct.ext'
  intro w q
  have h : ((presheafDifferential R φ μ n).app' U).hom ∘ₗ
        (TensorProduct.mk (R.obj.obj U) _ (Q.val.obj U)).flip q =
      WeightedContraction.differential (R := R.obj.obj U) (φ.val.app' U).hom
        (multiplicationAt R μ U) n ∘ₗ
        (TensorProduct.mk (R.obj.obj U) _ (Q.val.obj U)).flip q := by
    apply exteriorPower.linearMap_ext
      (R := R.obj.obj U) (M := M.val.obj U)
      (N := (⋀[R.obj.obj U]^n (M.val.obj U)) ⊗[R.obj.obj U] P.val.obj U)
      (n := n + 1)
    apply AlternatingMap.ext
    intro v
    erw [LinearMap.compAlternatingMap_apply,LinearMap.compAlternatingMap_apply]
    change (presheafDifferential R φ μ n).app' U
        (exteriorPower.ιMulti (R.obj.obj U) (n+1) v ⊗ₜ q) = _
    erw [presheafDifferential_wedge_tensor,WeightedContraction.differential_ιMulti_tmul]
    rfl
  exact LinearMap.congr_fun h w

section Complex

variable (M L : Sh) (Q : ℕ → Sh)
variable (φ : M ⟶ L) (μ : ∀ n, L ⊗ Q (n+1) ⟶ Q n)

def presheafTerm (n : ℕ) : PSh :=
  ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val) ⊗ (Q n).val

/-- The required commutation is a literal equality of actual coefficient
actions on every open. Product-line multiplication will supply it. -/
def CoefficientsCommute : Prop :=
  ∀ (n : ℕ) (U : Cᵒᵖ) (a b : L.val.obj U) (q : (Q (n+2)).val.obj U),
    multiplicationAt R (μ n) U a (multiplicationAt R (μ (n+1)) U b q) =
      multiplicationAt R (μ n) U b (multiplicationAt R (μ (n+1)) U a q)

variable (hcomm : CoefficientsCommute R L Q μ)

include hcomm in
theorem presheafDifferential_squared (n : ℕ) :
    presheafDifferential R φ (μ (n+1)) (n+1) ≫
      presheafDifferential R φ (μ n) n = 0 := by
  ext U : 1
  apply ModuleCat.hom_ext
  change ((presheafDifferential R φ (μ n) n).app' U).hom ∘ₗ
      ((presheafDifferential R φ (μ (n+1)) (n+1)).app' U).hom = 0
  erw [presheafDifferential_app,presheafDifferential_app]
  exact WeightedContraction.differential_squared (φ.val.app' U).hom
    (multiplicationAt R (μ (n+1)) U) (multiplicationAt R (μ n) U)
    (hcomm n U) n

/-- The genuine mathematical terms, with their original exterior and
line-sheaf structures visible in the definition. -/
def term (n : ℕ) : Sh := (SheafOfModules.exteriorPower R n).obj M ⊗ Q n

/-- The canonical presentation of the actual term by sheafification of
the sectionwise exterior tensor; every comparison is an isomorphism. -/
def termPresentationIso (n : ℕ) : term R M Q n ≅ (F).obj (presheafTerm R M Q n) :=
  (SheafOfModules.exteriorPowerIso n M ⊗ᵢ
    (TauCeti.SheafOfModules.sheafificationIso _ (Q n)).symm) ≪≫
    Functor.Monoidal.μIso F
      ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val) (Q n).val

/-- The actual differential transported through its proved presentation. -/
def differential (n : ℕ) : term R M Q (n+1) ⟶ term R M Q n :=
  (termPresentationIso R M Q (n+1)).hom ≫
    (F).map (presheafDifferential R φ (μ n) n) ≫
      (termPresentationIso R M Q n).inv

include hcomm in
theorem differential_squared (n : ℕ) :
    differential R M L Q φ μ (n+1) ≫ differential R M L Q φ μ n = 0 := by
  simp only [differential,Category.assoc,Iso.inv_hom_id_assoc]
  erw [←Functor.map_comp_assoc,presheafDifferential_squared R M L Q φ μ hcomm n,
    Functor.map_zero,zero_comp,comp_zero]

/-- The complete chain complex, retaining all exterior degrees. -/
def complex : ChainComplex Sh ℕ :=
  ChainComplex.of (term R M Q) (differential R M L Q φ μ)
    (differential_squared R M L Q φ μ hcomm)

def shortComplex (n : ℕ) : ShortComplex Sh :=
  ShortComplex.mk (differential R M L Q φ μ (n+1))
    (differential R M L Q φ μ n) (differential_squared R M L Q φ μ hcomm n)

end Complex
end PaperVerification.Segre.WeightedSheafKoszul

end SegreWeightedSheafKoszul

section SegreKoszulLocalization

/-!
# Localization of the actual polynomial Koszul complex

The local differential is identified with localization of the original
differential on pure exterior products. Exactness can therefore be checked
at maximal ideals. Together with the finite-quotient parameter theorem,
this proves the original polynomial Koszul complex exact in every positive
degree, without assuming regularity or a chosen resolution.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.KoszulLocalization

open scoped TensorProduct
open TauCeti

section BaseChange

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
  (ι : Type*) [Fintype ι]

/-- Extension of every coefficient, on the actual finite free module. -/
def coefficientExtension : (ι → R) →ₗ[R] (ι → A) :=
  (Algebra.linearMap R A).compLeft ι

@[simp] theorem coefficientExtension_apply (v : ι → R) (i : ι) :
    coefficientExtension R A ι v i = algebraMap R A (v i) := rfl

theorem coefficientExtension_isBaseChange :
    IsBaseChange A (coefficientExtension R A ι) :=
  (IsBaseChange.linearMap R A).finitePow ι

/-- The scalar action on an exterior power is the restriction of its
actual A-module action. -/
local instance exteriorRestriction (q : ℕ) : Module R (⋀[A]^q (ι → A)) :=
  Module.compHom _ (algebraMap R A)

local instance exteriorRestrictionTower (q : ℕ) :
    @IsScalarTower R A (⋀[A]^q (ι → A)) _
      (⋀[A]^q (ι → A)).module.toSMul (exteriorRestriction R A ι q).toSMul :=
  IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl

/-- The canonical map of exterior powers under scalar extension, realized
using the proved exterior base-change equivalence. -/
def exteriorExtension (q : ℕ) :
    ⋀[R]^q (ι → R) →ₗ[R] ⋀[A]^q (ι → A) :=
  ((((coefficientExtension_isBaseChange R A ι).exteriorPowerEquiv q).toLinearMap).restrictScalars R) ∘ₗ TensorProduct.mk R A (⋀[R]^q (ι → R)) 1

@[simp] theorem exteriorExtension_ιMulti (q : ℕ) (v : Fin q → (ι → R)) :
    exteriorExtension R A ι q (exteriorPower.ιMulti R q v) =
      exteriorPower.ιMulti A q (fun j ↦ coefficientExtension R A ι (v j)) := by
  simp only [exteriorExtension, LinearMap.comp_apply, TensorProduct.mk_apply,
    LinearMap.restrictScalars_apply, LinearEquiv.coe_coe,
    IsBaseChange.exteriorPowerEquiv_tmul_ιMulti, one_smul]

theorem exteriorExtension_isBaseChange (q : ℕ) :
    IsBaseChange A (exteriorExtension R A ι q) := by
  apply IsBaseChange.of_equiv
    ((coefficientExtension_isBaseChange R A ι).exteriorPowerEquiv q)
  intro z
  rfl

instance exteriorExtension_isLocalized
    (S : Submonoid R) [IsLocalization S A] (q : ℕ) :
    IsLocalizedModule S (exteriorExtension R A ι q) := by
  rw [isLocalizedModule_iff_isBaseChange S A]
  exact exteriorExtension_isBaseChange R A ι q

/-- Coefficient extension intertwines the literal linear-combination
functionals. -/
theorem linearCombination_extension (x v : ι → R) :
    Fintype.linearCombination A (fun i ↦ algebraMap R A (x i))
        (coefficientExtension R A ι v) =
      algebraMap R A (Fintype.linearCombination R x v) := by
  simp only [Fintype.linearCombination_apply, coefficientExtension_apply,
    smul_eq_mul, map_sum, map_mul]

/-- The actual exterior differential commutes with scalar extension. -/
theorem differential_extension (x : ι → R) (q : ℕ) :
    (koszulDifferential
        (Fintype.linearCombination A (fun i ↦ algebraMap R A (x i))) q).restrictScalars R ∘ₗ
        exteriorExtension R A ι (q + 1) =
      exteriorExtension R A ι q ∘ₗ
        koszulDifferential (Fintype.linearCombination R x) q := by
  apply exteriorPower.linearMap_ext (R := R) (M := ι → R)
    (N := ⋀[A]^q (ι → A)) (n := q + 1)
  apply AlternatingMap.ext
  intro v
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.comp_apply,
    LinearMap.restrictScalars_apply, exteriorExtension_ιMulti,
    koszulDifferential_ιMulti, linearCombination_extension, map_sum, map_smul]
  apply Finset.sum_congr rfl
  intro i _
  have hw :
      i.removeNth (fun j ↦ coefficientExtension R A ι (v j)) =
        fun j ↦ coefficientExtension R A ι (i.removeNth v j) := rfl
  rw [hw, (exteriorExtension R A ι q).map_smul, exteriorExtension_ιMulti]
  change ((-1 : A) ^ (i : ℕ) *
      algebraMap R A ((Fintype.linearCombination R x) (v i))) •
      exteriorPower.ιMulti A q
        (fun j ↦ coefficientExtension R A ι (i.removeNth v j)) =
    ((-1 : R) ^ (i : ℕ) * (Fintype.linearCombination R x) (v i)) •
      exteriorPower.ιMulti A q
        (fun j ↦ coefficientExtension R A ι (i.removeNth v j))
  rw [← map_one (algebraMap R A), ← map_neg, ← map_pow, ← map_mul]
  exact IsScalarTower.algebraMap_smul A _ _

/-- Localization of the original differential is literally the contraction
by the images of the equations, after the proved exterior comparison. -/
theorem localizedMap_differential (S : Submonoid R) [IsLocalization S A]
    (x : ι → R) (q : ℕ) :
    IsLocalizedModule.map S
        (exteriorExtension R A ι (q + 1)) (exteriorExtension R A ι q)
        (koszulDifferential (Fintype.linearCombination R x) q) =
      (koszulDifferential
        (Fintype.linearCombination A (fun i ↦ algebraMap R A (x i))) q).restrictScalars R := by
  apply IsLocalizedModule.linearMap_ext S (exteriorExtension R A ι (q + 1))
    (exteriorExtension R A ι q)
  rw [IsLocalizedModule.map_comp]
  exact (differential_extension R A ι x q).symm

/-- Exactness of the scalar-extended Koszul complexes at all maximal ideals
implies exactness of the actual original complex. -/
theorem exact_of_localized_differentials (x : ι → R) (q : ℕ)
    (h : ∀ (p : Ideal R) [p.IsMaximal],
      (koszulComplex (Fintype.linearCombination (Localization.AtPrime p)
        (fun i ↦ algebraMap R (Localization.AtPrime p) (x i)))).ExactAt (q + 1)) :
    (koszulComplex (Fintype.linearCombination R x)).ExactAt (q + 1) := by
  rw [koszulComplex.exactAt_succ_iff]
  apply exact_of_isLocalized_maximal
    (fun (p : Ideal R) (_ : p.IsMaximal) ↦ ⋀[Localization.AtPrime p]^(q + 2)
      (ι → Localization.AtPrime p))
    (fun (p : Ideal R) (_ : p.IsMaximal) ↦
      exteriorExtension R (Localization.AtPrime p) ι (q + 2))
    (fun (p : Ideal R) (_ : p.IsMaximal) ↦ ⋀[Localization.AtPrime p]^(q + 1)
      (ι → Localization.AtPrime p))
    (fun (p : Ideal R) (_ : p.IsMaximal) ↦
      exteriorExtension R (Localization.AtPrime p) ι (q + 1))
    (fun (p : Ideal R) (_ : p.IsMaximal) ↦ ⋀[Localization.AtPrime p]^q
      (ι → Localization.AtPrime p))
    (fun (p : Ideal R) (_ : p.IsMaximal) ↦
      exteriorExtension R (Localization.AtPrime p) ι q)
  intro p hp
  rw [localizedMap_differential, localizedMap_differential]
  exact (koszulComplex.exactAt_succ_iff _ q).mp (h p)

end BaseChange

section FinitePolynomialScheme

variable {K : Type*} [Field K] {n : ℕ}

/-- The genuine Koszul complex of n polynomials in n variables with a
finite actual quotient algebra is exact in every positive degree. -/
theorem polynomial_koszul_exact
    (f : Fin n → LocalRegularKoszul.PolynomialRing K n)
    [Module.Finite K
      (LocalRegularKoszul.PolynomialRing K n ⧸ LocalRegularKoszul.equationIdeal f)]
    (q : ℕ) :
    (TauCeti.koszulComplex (Fintype.linearCombination _ f)).ExactAt (q + 1) := by
  apply exact_of_localized_differentials _ (Fin n) f q
  intro p hp
  exact LocalRegularKoszul.localized_koszul_exact f p q

end FinitePolynomialScheme
end PaperVerification.Segre.KoszulLocalization

end SegreKoszulLocalization

section SegreRegularSheafKoszul
set_option maxHeartbeats 1000000

/-!
# Actual affine sheaf Koszul exactness

The comparison in this file concerns the contraction maps on the actual
exterior-power sheaves. Its compatibility is proved on sheafified exterior
generators using the genuine tilde adjunction and the sheafification unit.
Consequently the finite-polynomial-quotient result supplies exactness of
the actual sheaf complex on an affine chart.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.RegularSheafKoszul

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open TauCeti
open TauCeti.AlgebraicGeometry

universe u
variable {R : CommRingCat.{u}} (M : ModuleCat.{u} R)

/-- The associated functional to the actual structure sheaf. -/
def tildeFunctional (φ : Module.Dual R M) :
    tilde M ⟶ SheafOfModules.unit (Spec R).ringCatSheaf :=
  tilde.map (ModuleCat.ofHom φ) ≫ (tildeSelf (R := R)).hom

/-- The functional evaluates the associated section of m as the
associated regular function φ(m). -/
theorem tildeFunctional_toOpen (φ : Module.Dual R M)
    (U : (Spec R).Opens) (m : M) :
    SheafKoszul.sectionFunctional (tildeFunctional M φ) (op U)
      (tilde.toOpen M U m) = algebraMap R Γ(Spec R,U) (φ m) := by
  change (tilde.map (ModuleCat.ofHom φ)).val.app (op U) (tilde.toOpen M U m) = _
  rw [tilde_map_val_app_toOpen]
  rfl

/-- The actual sheafification-unit image of a sectionwise exterior vector. -/
def exteriorSectionUnit (q : ℕ) (U : (Spec R).Opens) :
    ModuleCat.of Γ(Spec R,U)
      (⋀[Γ(Spec R,U)]^q (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op U))) ⟶
      ((SheafOfModules.exteriorPower (Spec R).sheaf q).obj (tilde M)).val.obj (op U) :=
  (((PresheafOfModules.sheafificationAdjunction (𝟙 (Spec R).ringCatSheaf.obj)).unit.app
    ((PresheafOfModulesOfCommRing.exteriorPower (R := (Spec R).presheaf) q).obj
      (tilde M).val)).app (op U)) ≫
    (SheafOfModules.exteriorPowerIso q (tilde M)).inv.val.app (op U)

/-- Naturality of sheafification retains the literal exterior differential
on its generating sections. -/
theorem differential_sectionUnit (φ : Module.Dual R M)
    (q : ℕ) (U : (Spec R).Opens)
    (z : ⋀[Γ(Spec R,U)]^(q + 1) (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op U))) :
    (SheafKoszul.differential (tildeFunctional M φ) q).val.app (op U)
      (exteriorSectionUnit M (q + 1) U z) =
      exteriorSectionUnit M q U
        (koszulDifferential
          (SheafKoszul.sectionFunctional (tildeFunctional M φ) (op U)) q z) := by
  let F := PresheafOfModules.sheafification (𝟙 (Spec R).ringCatSheaf.obj)
  let G := SheafOfModules.forget (Spec R).ringCatSheaf ⋙
    PresheafOfModules.restrictScalars (𝟙 (Spec R).ringCatSheaf.obj)
  let adj := PresheafOfModules.sheafificationAdjunction (𝟙 (Spec R).ringCatSheaf.obj)
  let e₁ := SheafOfModules.exteriorPowerIso (q + 1) (tilde M)
  let e₀ := SheafOfModules.exteriorPowerIso q (tilde M)
  let d := SheafKoszul.presheafDifferential (tildeFunctional M φ) q
  have h : adj.unit.app _ ≫ G.map e₁.inv ≫
      G.map (e₁.hom ≫ F.map d ≫ e₀.inv) = d ≫ adj.unit.app _ ≫ G.map e₀.inv := by
    rw [Functor.map_comp, Functor.map_comp]
    rw [← Category.assoc (G.map e₁.inv) (G.map e₁.hom)
      (G.map (F.map d) ≫ G.map e₀.inv)]
    rw [← Functor.map_comp, e₁.inv_hom_id]
    erw [G.map_id, Category.id_comp]
    rw [← Category.assoc, ← Category.assoc]
    exact congrArg (fun f => f ≫ G.map e₀.inv) (adj.unit.naturality d).symm
  have hh := congrArg (fun f => f.app (op U)) h
  have hhh := ConcreteCategory.congr_hom hh z
  exact hhh

/-- Scalar multiples of wedges are carried through the actual affine comparison. -/
theorem tildeExteriorPowerIso_hom_toOpen_smul (q : ℕ) (U : (Spec R).Opens)
    (r : R) (v : Fin q → M) :
    (tildeExteriorPowerIso (R := R) q M).hom.val.app (op U)
      (tilde.toOpen (M.exteriorPower q) U (r • exteriorPower.ιMulti R q v)) =
      exteriorSectionUnit M q U
        (algebraMap R Γ(Spec R,U) r • exteriorPower.ιMulti Γ(Spec R,U) q
          (M := PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op U))
          (fun i ↦ tilde.toOpen M U (v i))) := by
  let E := (modulesSpecToSheaf.obj (tilde (M.exteriorPower q))).presheaf.obj (op U)
  let EA : Module Γ(Spec R,U) E :=
    ((tilde (M.exteriorPower q)).val.obj (op U)).isModule
  let : @IsScalarTower R Γ(Spec R,U) E _ EA.toSMul E.isModule.toSMul :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  have ht := (tilde.toOpen (M.exteriorPower q) U).hom.map_smul r
    (exteriorPower.ιMulti R q v)
  erw [ht]
  erw [← IsScalarTower.algebraMap_smul Γ(Spec R,U) r
    (tilde.toOpen (M.exteriorPower q) U (exteriorPower.ιMulti R q v))]
  erw [((tildeExteriorPowerIso (R := R) q M).hom.val.app (op U)).hom.map_smul]
  erw [tildeExteriorPowerIso_hom_toOpen_mk]
  exact ((exteriorSectionUnit M q U).hom.map_smul
    (algebraMap R Γ(Spec R,U) r)
    (exteriorPower.ιMulti Γ(Spec R,U) q
          (M := PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op U)) (fun i ↦ tilde.toOpen M U (v i)))).symm

/-- The tilde exterior isomorphisms intertwine the actual two contraction
maps. This is the differential comparison, not only an object isomorphism. -/
@[reassoc]
theorem tilde_differential_comparison (φ : Module.Dual R M) (q : ℕ) :
    tilde.map (R := R) (ModuleCat.ofHom (koszulDifferential φ q)) ≫
        (tildeExteriorPowerIso (R := R) q M).hom =
      (tildeExteriorPowerIso (R := R) (q + 1) M).hom ≫
        SheafKoszul.differential (R := (Spec R).sheaf)
          (tildeFunctional (R := R) M φ) q := by
  apply ((tilde.adjunction (R := R)).homEquiv _ _).injective
  apply ModuleCat.exteriorPower.hom_ext
  ext v
  change (tildeExteriorPowerIso q M).hom.val.app (op ⊤)
      ((tilde.map (ModuleCat.ofHom (koszulDifferential φ q))).val.app (op ⊤)
        (tilde.toOpen (M.exteriorPower (q + 1)) ⊤
          (exteriorPower.ιMulti R (q + 1) v))) =
    (SheafKoszul.differential (tildeFunctional M φ) q).val.app (op ⊤)
      ((tildeExteriorPowerIso (q + 1) M).hom.val.app (op ⊤)
        (tilde.toOpen (M.exteriorPower (q + 1)) ⊤
          (exteriorPower.ιMulti R (q + 1) v)))
  erw [tilde_map_val_app_toOpen, tildeExteriorPowerIso_hom_toOpen_mk]
  change (tildeExteriorPowerIso q M).hom.val.app (op ⊤)
      (tilde.toOpen (M.exteriorPower q) ⊤
        (koszulDifferential φ q (exteriorPower.ιMulti R (q + 1) v))) =
    (SheafKoszul.differential (tildeFunctional M φ) q).val.app (op ⊤)
      (exteriorSectionUnit M (q + 1) ⊤
        (exteriorPower.ιMulti Γ(Spec R,⊤) (q + 1)
          (M := PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤))
          (fun i ↦ tilde.toOpen M ⊤ (v i))))
  erw [differential_sectionUnit M φ q ⊤]
  erw [koszulDifferential_ιMulti φ q v]
  erw [koszulDifferential_ιMulti
    (SheafKoszul.sectionFunctional (tildeFunctional (R := R) M φ) (op ⊤)) q
    (fun i ↦ tilde.toOpen M ⊤ (v i))]
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro i _
  erw [tildeFunctional_toOpen]
  have hw : i.removeNth (fun j ↦ tilde.toOpen M ⊤ (v j)) =
      fun j ↦ tilde.toOpen M ⊤ (i.removeNth v j) := rfl
  erw [hw]
  change (tildeExteriorPowerIso q M).hom.val.app (op ⊤)
      (tilde.toOpen (M.exteriorPower q) ⊤
        (((-1 : R) ^ (i : ℕ) * φ (v i)) • exteriorPower.ιMulti R q (i.removeNth v))) =
    exteriorSectionUnit M q ⊤
      (((-1 : Γ(Spec R,⊤)) ^ (i : ℕ) *
        algebraMap R Γ(Spec R,⊤) (φ (v i))) •
        exteriorPower.ιMulti Γ(Spec R,⊤) q
          (M := PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) (tilde M).val (op ⊤))
          (fun j ↦ tilde.toOpen M ⊤ (i.removeNth v j)))
  erw [tildeExteriorPowerIso_hom_toOpen_smul]
  simp only [map_mul, map_pow, map_neg, map_one]

/-- The polynomial short complex before applying the exact tilde functor. -/
def algebraShortComplex (φ : Module.Dual R M) (q : ℕ) :
    ShortComplex (ModuleCat.{u} R) :=
  ShortComplex.mk
    (ModuleCat.ofHom (koszulDifferential φ (q + 1)))
    (ModuleCat.ofHom (koszulDifferential φ q))
    (ModuleCat.hom_ext (koszulDifferential_comp_koszulDifferential φ q))

/-- The actual affine sheaf short complex is isomorphic to the tilde of the
actual module short complex, including both differentials. -/
def tildeShortComplexIso (φ : Module.Dual R M) (q : ℕ) :
    (algebraShortComplex M φ q).map (tilde.functor R) ≅
      SheafKoszul.shortComplex.{u} (tildeFunctional M φ) q :=
  ShortComplex.isoMk
    (tildeExteriorPowerIso (q + 2) M)
    (tildeExteriorPowerIso (q + 1) M)
    (tildeExteriorPowerIso q M)
    (tilde_differential_comparison M φ (q + 1)).symm
    (tilde_differential_comparison M φ q).symm

/-- Exactness of the module Koszul complex gives exactness of the actual
contraction complex of exterior-power sheaves. -/
theorem sheaf_exact_of_module_exact (φ : Module.Dual R M) (q : ℕ)
    (h : (TauCeti.koszulComplex φ).ExactAt (q + 1)) :
    (SheafKoszul.shortComplex.{u} (tildeFunctional M φ) q).Exact := by
  have hmodule : (algebraShortComplex M φ q).Exact := by
    rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
    exact (TauCeti.koszulComplex.exactAt_succ_iff φ q).mp h
  exact ShortComplex.exact_of_iso (tildeShortComplexIso M φ q)
    (hmodule.map (tilde.functor R))

section Polynomial

variable {K : Type u} [Field K] {n : ℕ}

/-- No regular-section assumption: n polynomial equations in n affine
coordinates with a finite actual quotient give an exact actual sheaf
Koszul complex in all positive degrees. -/
theorem polynomial_sheaf_koszul_exact
    (f : Fin n → LocalRegularKoszul.PolynomialRing K n)
    [Module.Finite K
      (LocalRegularKoszul.PolynomialRing K n ⧸ LocalRegularKoszul.equationIdeal f)]
    (q : ℕ) :
    let P := LocalRegularKoszul.PolynomialRing K n
    let M := ModuleCat.of P (Fin n → P)
    (SheafKoszul.shortComplex.{u} (tildeFunctional (R := CommRingCat.of P) M
      (Fintype.linearCombination P f)) q).Exact := by
  apply sheaf_exact_of_module_exact
  exact KoszulLocalization.polynomial_koszul_exact f q

end Polynomial
end PaperVerification.Segre.RegularSheafKoszul

end SegreRegularSheafKoszul

section SegreWeightedKoszulFrames

/-!
# Actual line frames identify the weighted and scalar Koszul complexes

The isomorphisms below use the given sheaf line frames on every term.
Compatibility with each actual coefficient multiplication is checked on
local sections. Under those frames both differentials become the same
scalar exterior contraction, so exactness transfers as an isomorphism
of complete short complexes.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
open scoped Classical TensorProduct

namespace PaperVerification.Segre.WeightedKoszulFrames

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open WeightedSheafKoszul

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

set_option hygiene false in
set_option quotPrecheck false in local notation "Sh" => SheafOfModules.{u} (ringCatSheaf R)
set_option hygiene false in
set_option quotPrecheck false in local notation "F" => PresheafOfModules.sheafification.{u} (𝟙 (ringCatSheaf R).obj)
local notation "G" => SheafOfModules.forget (ringCatSheaf R)

variable {M L P Q : Sh}

/-- The genuine linear equivalence on local sections induced by a sheaf
line trivialization, including its inverse. -/
def frameAt (e : Q ≅ 𝟙_ Sh) (U : Cᵒᵖ) : Q.val.obj U ≃ₗ[R.obj.obj U] R.obj.obj U where
  toLinearMap := (e.hom.val.app' U).hom
  invFun := (e.inv.val.app' U).hom
  left_inv q := by
    have h := congrArg (fun f : Q ⟶ Q => (f.val.app' U).hom q) e.hom_inv_id
    exact h
  right_inv r := by
    have h := congrArg (fun f : (𝟙_ Sh) ⟶ (𝟙_ Sh) => (f.val.app' U).hom r) e.inv_hom_id
    exact h

@[simp] theorem frameAt_apply (e : Q ≅ 𝟙_ Sh) (U : Cᵒᵖ) (q : Q.val.obj U) :
    frameAt R e U q = e.hom.val.app U q := rfl

/-- The sectionwise exterior tensor is scalarized by the actual line
frame and the canonical right unitor. -/
def presheafScalarizeIso (M : Sh) (e : Q ≅ 𝟙_ Sh) (n : ℕ) :
    ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val) ⊗ Q.val ≅
      ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) n).obj M.val) :=
  (Iso.refl _ ⊗ᵢ (G).mapIso e) ≪≫ ρ_ _

theorem presheafScalarizeIso_app (M : Sh) (e : Q ≅ 𝟙_ Sh) (n : ℕ) (U : Cᵒᵖ) :
    (((presheafScalarizeIso R M e n).hom).app' U).hom =
      (WeightedContraction.scalarize (M := M.val.obj U) (frameAt R e U) n).toLinearMap := by
  apply TensorProduct.ext'
  intro w q
  change TensorProduct.rid (R.obj.obj U) (⋀[R.obj.obj U]^n (M.val.obj U))
      (TensorProduct.map LinearMap.id (e.hom.val.app' U).hom
        (w ⊗ₜ[R.obj.obj U] q)) =
    WeightedContraction.scalarize (M := M.val.obj U) (frameAt R e U) n
      (w ⊗ₜ[R.obj.obj U] q)
  rfl

/-- Compatibility is stated for the actual coefficient multiplication
and the actual section maps of the three line frames. -/
def MultiplicationCompatible (μ : L ⊗ Q ⟶ P)
    (eL : L ≅ 𝟙_ Sh) (eQ : Q ≅ 𝟙_ Sh) (eP : P ≅ 𝟙_ Sh) : Prop :=
  ∀ (U : Cᵒᵖ) (l : L.val.obj U) (q : Q.val.obj U),
    frameAt R eP U (multiplicationAt R μ U l q) =
      frameAt R eL U l * frameAt R eQ U q

/-- Equality of the entire presheaf differentials after trivialization. -/
theorem presheaf_differential_scalarizes (φ : M ⟶ L) (μ : L ⊗ Q ⟶ P)
    (eL : L ≅ 𝟙_ Sh) (eQ : Q ≅ 𝟙_ Sh) (eP : P ≅ 𝟙_ Sh)
    (hμ : MultiplicationCompatible R μ eL eQ eP) (n : ℕ) :
    presheafDifferential R φ μ n ≫ (presheafScalarizeIso R M eP n).hom =
      (presheafScalarizeIso R M eQ (n+1)).hom ≫
        SheafKoszul.presheafDifferential (φ ≫ eL.hom) n := by
  ext U : 1
  apply ModuleCat.hom_ext
  change (((presheafScalarizeIso R M eP n).hom).app' U).hom ∘ₗ
      ((presheafDifferential R φ μ n).app' U).hom =
    ((SheafKoszul.presheafDifferential (φ ≫ eL.hom) n).app' U).hom ∘ₗ
      (((presheafScalarizeIso R M eQ (n+1)).hom).app' U).hom
  rw [presheafScalarizeIso_app,presheafScalarizeIso_app,presheafDifferential_app]
  exact WeightedContraction.scalarize_differential (φ.val.app' U).hom
    (multiplicationAt R μ U) (frameAt R eL U) (frameAt R eQ U) (frameAt R eP U)
    (hμ U) n

section Complex

variable (M L : Sh) (Q : ℕ → Sh) (φ : M ⟶ L)
variable (μ : ∀ n, L ⊗ Q (n+1) ⟶ Q n)
variable (eL : L ≅ 𝟙_ Sh) (eQ : ∀ n, Q n ≅ 𝟙_ Sh)
variable (hμ : ∀ n, MultiplicationCompatible R (μ n) eL (eQ (n+1)) (eQ n))

include hμ in
/-- Compatible line frames prove the required coefficient commutation,
using ordinary commutative multiplication in each function ring. -/
theorem coefficientsCommute_of_frames : CoefficientsCommute R L Q μ := by
  intro n U a b q
  apply (frameAt R (eQ n) U).injective
  rw [hμ n U,hμ n U,hμ (n+1) U,hμ (n+1) U]
  ac_rfl

/-- Every actual weighted term is identified with the actual scalar
exterior-power sheaf; the presentation comparisons are retained. -/
def scalarTermIso (n : ℕ) : term R M Q n ≅ (SheafOfModules.exteriorPower R n).obj M :=
  termPresentationIso R M Q n ≪≫ (F).mapIso (presheafScalarizeIso R M (eQ n) n) ≪≫
    (SheafOfModules.exteriorPowerIso n M).symm

include hμ in
@[reassoc] theorem differential_scalarizes (n : ℕ) :
    differential R M L Q φ μ n ≫ (scalarTermIso R M Q eQ n).hom =
      (scalarTermIso R M Q eQ (n+1)).hom ≫
        SheafKoszul.differential (φ ≫ eL.hom) n := by
  simp only [differential,scalarTermIso,Iso.trans_hom,Iso.symm_hom,
    Functor.mapIso_hom,SheafKoszul.differential,Category.assoc,
    Iso.inv_hom_id_assoc]
  rw [←Functor.map_comp_assoc,presheaf_differential_scalarizes R φ (μ n)
    eL (eQ (n+1)) (eQ n) (hμ n) n,Functor.map_comp]
  simp only [Category.assoc,Iso.inv_hom_id_assoc]

/-- An isomorphism of the entire short complexes, including both
original differentials. -/
def shortComplexIso (n : ℕ) :
    shortComplex R M L Q φ μ (coefficientsCommute_of_frames R L Q μ eL eQ hμ) n ≅
      SheafKoszul.shortComplex (φ ≫ eL.hom) n :=
  ShortComplex.isoMk (scalarTermIso R M Q eQ (n+2))
    (scalarTermIso R M Q eQ (n+1)) (scalarTermIso R M Q eQ n)
    (differential_scalarizes R M L Q φ μ eL eQ hμ (n+1)).symm
    (differential_scalarizes R M L Q φ μ eL eQ hμ n).symm

/-- Exactness is transported through the proved comparison, not assumed
for the weighted complex. The remaining premise is the literal scalar
Koszul complex, supplied on polynomial charts by finite-quotient regularity. -/
theorem exact_of_scalar_exact (n : ℕ)
    (h : (SheafKoszul.shortComplex (φ ≫ eL.hom) n).Exact) :
    (shortComplex R M L Q φ μ (coefficientsCommute_of_frames R L Q μ eL eQ hμ) n).Exact :=
  ShortComplex.exact_of_iso (shortComplexIso R M L Q φ μ eL eQ hμ n).symm h

end Complex
end PaperVerification.Segre.WeightedKoszulFrames

end SegreWeightedKoszulFrames

section SegreSheafKoszulNaturality

/-!
# Naturality of the actual scalar sheaf Koszul complex

The source change is an actual sheaf morphism, and compatibility of the
functionals is equality of their entire maps. Exterior functoriality and
the literal alternating formula identify both differentials of every
short complex.
-/

set_option autoImplicit false
open scoped BigOperators

namespace PaperVerification.Segre.SheafKoszulNaturality

open CategoryTheory
open TauCeti.SheafOfModules (ringCatSheaf)
open SheafKoszul

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable {R : Sheaf J CommRingCat.{u}}
variable {M N : SheafOfModules.{u} (ringCatSheaf R)}

local notation "One" => SheafOfModules.unit (ringCatSheaf R)

/-- Source naturality before sheafification, proved on every exterior
generator and retaining the exact alternating signs. -/
@[reassoc] theorem presheaf_natural (f : M ⟶ N) (φ : M ⟶ One) (ψ : N ⟶ One)
    (h : f ≫ ψ = φ) (n : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower (n + 1)).map f.val ≫
        presheafDifferential ψ n =
      presheafDifferential φ n ≫
        (PresheafOfModulesOfCommRing.exteriorPower n).map f.val := by
  ext U : 1
  apply ModuleCat.exteriorPower.hom_ext
  ext v
  change TauCeti.koszulDifferential (sectionFunctional ψ U) n
      (exteriorPower.map (n + 1) (f.val.app' U).hom
        (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v)) =
    exteriorPower.map n (f.val.app' U).hom
      (TauCeti.koszulDifferential (sectionFunctional φ U) n
        (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v))
  erw [exteriorPower.map_apply_ιMulti, TauCeti.koszulDifferential_ιMulti,
    TauCeti.koszulDifferential_ιMulti]
  simp only [map_sum, map_smul, exteriorPower.map_apply_ιMulti, Function.comp_apply]
  apply Finset.sum_congr rfl
  intro i _
  have hv := ConcreteCategory.congr_hom
    (congrArg (fun g => g.val.app U) h) (v i)
  change sectionFunctional ψ U (f.val.app U (v i)) = sectionFunctional φ U (v i) at hv
  erw [hv, exteriorPower.map_apply_ιMulti]
  rfl

/-- Source naturality for the entire actual sheaf differential. -/
@[reassoc] theorem differential_natural (f : M ⟶ N) (φ : M ⟶ One) (ψ : N ⟶ One)
    (h : f ≫ ψ = φ) (n : ℕ) :
    (SheafOfModules.exteriorPower R (n + 1)).map f ≫ differential ψ n =
      differential φ n ≫ (SheafOfModules.exteriorPower R n).map f := by
  simp only [SheafOfModules.exteriorPower_map, differential, Category.assoc,
    Iso.inv_hom_id_assoc]
  erw [← Functor.map_comp_assoc, presheaf_natural f φ ψ h n,
    Functor.map_comp]
  simp only [Category.assoc]

/-- A source isomorphism compatible with the literal functionals induces
an isomorphism of the actual short complexes in every degree. -/
def shortComplexIso (e : M ≅ N) (φ : M ⟶ One) (ψ : N ⟶ One)
    (h : e.hom ≫ ψ = φ) (n : ℕ) : shortComplex φ n ≅ shortComplex ψ n :=
  ShortComplex.isoMk
    ((SheafOfModules.exteriorPower R (n + 2)).mapIso e)
    ((SheafOfModules.exteriorPower R (n + 1)).mapIso e)
    ((SheafOfModules.exteriorPower R n).mapIso e)
    (differential_natural e.hom φ ψ h (n + 1))
    (differential_natural e.hom φ ψ h n)

theorem exact_of_source_iso (e : M ≅ N) (φ : M ⟶ One) (ψ : N ⟶ One)
    (h : e.hom ≫ ψ = φ) (n : ℕ) (hexact : (shortComplex ψ n).Exact) :
    (shortComplex φ n).Exact :=
  ShortComplex.exact_of_iso (shortComplexIso e φ ψ h n).symm hexact

end PaperVerification.Segre.SheafKoszulNaturality

end SegreSheafKoszulNaturality

section SegreWeightedKoszulLocalFormula

/-!
# The actual local formula of the weighted sheaf differential

The canonical map from sectionwise exterior tensors into the actual
weighted term agrees with the tensor of the actual exterior sheafification
map. This identifies every differential on local wedge tensors and proves
that these formulas determine the entire sheaf morphism.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
open scoped Classical TensorProduct BigOperators

namespace PaperVerification.Segre.WeightedKoszulLocalFormula

open CategoryTheory MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open SheafCoefficientContraction WeightedSheafKoszul

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

set_option hygiene false in
set_option quotPrecheck false in local notation "Sh" => SheafOfModules.{u} (ringCatSheaf R)
set_option hygiene false in
set_option quotPrecheck false in local notation "F" => PresheafOfModules.sheafification.{u} (𝟙 (ringCatSheaf R).obj)
local notation "G" => SheafOfModules.forget (ringCatSheaf R)
local notation "A" => TauCeti.SheafOfModules.sheafificationForgetAdjunction R

variable (M : Sh) (Q : ℕ → Sh)

/-- The actual sheafification unit of a weighted term, followed by the
inverse of its canonical exterior-tensor presentation. -/
def termUnit (n : ℕ) : presheafTerm R M Q n ⟶ (term R M Q n).val :=
  (A).unit.app _ ≫ (G).map (termPresentationIso R M Q n).inv

/-- The presentation unit is exactly the genuine tensor of the exterior
sheafification map and the coefficient section. -/
@[reassoc] theorem termUnit_eq (n : ℕ) :
    termUnit R M Q n =
      (exteriorUnit R M n ⊗ₘ 𝟙 (Q n).val) ≫
        Functor.LaxMonoidal.μ G ((SheafOfModules.exteriorPower R n).obj M) (Q n) := by
  have hQ :
      (A).unit.app (Q n).val ≫
          (G).map (TauCeti.SheafOfModules.sheafificationIso _ (Q n)).hom =
        𝟙 (Q n).val := by
    rw [← TauCeti.SheafOfModules.sheafificationForgetAdjunction_counit_app R (Q n)]
    exact (A).right_triangle_components (Q n)
  simp only [termUnit, termPresentationIso, Iso.trans_inv, tensorIso_inv,
    Iso.symm_inv, Functor.Monoidal.μIso_inv, Functor.map_comp, Category.assoc]
  rw [(A).unit_app_tensor_comp_map_δ_assoc,
    ← Functor.LaxMonoidal.μ_natural, ← Category.assoc,
    tensorHom_comp_tensorHom]
  erw [hQ]
  rfl

@[simp] theorem termUnit_wedge_tensor (n : ℕ) (U : Cᵒᵖ)
    (v : Fin n → M.val.obj U) (q : (Q n).val.obj U) :
    (termUnit R M Q n).app U
        (exteriorPower.ιMulti (R.obj.obj U) n v ⊗ₜ q) =
      tensorSection R ((SheafOfModules.exteriorPower R n).obj M) (Q n) U
        (wedgeSection R M n U v) q := by
  rw [termUnit_eq]
  rfl

variable (L : Sh) (φ : M ⟶ L) (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n)

/-- Naturality of sheafification identifies the actual weighted
differential with its full sectionwise presentation. -/
@[reassoc] theorem termUnit_differential (n : ℕ) :
    termUnit R M Q (n + 1) ≫ (G).map (differential R M L Q φ μ n) =
      presheafDifferential R φ (μ n) n ≫ termUnit R M Q n := by
  simp only [termUnit, differential, Functor.map_comp, Category.assoc]
  rw [← Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
    Category.id_comp, ← (A).unit_naturality_assoc]

/-- The actual sheaf differential is the full signed deletion sum on
every local wedge tensor; no comparison map is left unspecified. -/
theorem differential_wedge_tensor (n : ℕ) (U : Cᵒᵖ)
    (v : Fin (n + 1) → M.val.obj U) (q : (Q (n + 1)).val.obj U) :
    (differential R M L Q φ μ n).val.app U
        (tensorSection R ((SheafOfModules.exteriorPower R (n + 1)).obj M)
          (Q (n + 1)) U (wedgeSection R M (n + 1) U v) q) =
      ∑ i : Fin (n + 1), (-1 : ℤ) ^ (i : ℕ) •
        tensorSection R ((SheafOfModules.exteriorPower R n).obj M) (Q n) U
          (wedgeSection R M n U (i.removeNth v))
          (multiplicationAt R (μ n) U (φ.val.app U (v i)) q) := by
  have h := congrArg
    (fun η : presheafTerm R M Q (n + 1) ⟶ (term R M Q n).val =>
      (η.app' U).hom
        (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v ⊗ₜ[R.obj.obj U] q))
    (termUnit_differential R M Q L φ μ n)
  change (differential R M L Q φ μ n).val.app U
      ((termUnit R M Q (n + 1)).app U
        (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v ⊗ₜ[R.obj.obj U] q)) =
    (termUnit R M Q n).app U
      ((presheafDifferential R φ (μ n) n).app' U
        (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v ⊗ₜ[R.obj.obj U] q)) at h
  erw [termUnit_wedge_tensor R M Q (n + 1) U v q,
    presheafDifferential_wedge_tensor R φ (μ n) n U v q] at h
  simp only [map_sum, map_zsmul] at h
  refine h.trans (Finset.sum_congr rfl ?_)
  intro i hi
  exact congrArg
    (fun z : (term R M Q n).val.obj U => (-1 : ℤ) ^ (i : ℕ) • z)
    (termUnit_wedge_tensor R M Q n U (i.removeNth v)
      (multiplicationAt R (μ n) U (φ.val.app U (v i)) q))

omit L φ μ in
/-- The canonical local wedge tensors determine every morphism out of a
weighted term, by the sheafification adjunction and both universal
properties, without any global generation assumption. -/
theorem hom_ext (n : ℕ) {N : Sh} {f g : term R M Q n ⟶ N}
    (h : ∀ (U : Cᵒᵖ) (v : Fin n → M.val.obj U) (q : (Q n).val.obj U),
      f.val.app U
          (tensorSection R ((SheafOfModules.exteriorPower R n).obj M) (Q n) U
            (wedgeSection R M n U v) q) =
        g.val.app U
          (tensorSection R ((SheafOfModules.exteriorPower R n).obj M) (Q n) U
            (wedgeSection R M n U v) q)) : f = g := by
  rw [← cancel_epi (termPresentationIso R M Q n).inv]
  apply ((A).homEquiv _ _).injective
  simp only [Adjunction.homEquiv_unit, Functor.map_comp, ← Category.assoc]
  change termUnit R M Q n ≫ (G).map f = termUnit R M Q n ≫ (G).map g
  ext U : 1
  apply ModuleCat.hom_ext
  let fU : ((⋀[R.obj.obj U]^n (M.val.obj U)) ⊗[R.obj.obj U] (Q n).val.obj U) →ₗ[R.obj.obj U]
      N.val.obj U := ((termUnit R M Q n ≫ (G).map f).app' U).hom
  let gU : ((⋀[R.obj.obj U]^n (M.val.obj U)) ⊗[R.obj.obj U] (Q n).val.obj U) →ₗ[R.obj.obj U]
      N.val.obj U := ((termUnit R M Q n ≫ (G).map g).app' U).hom
  change fU = gU
  apply TensorProduct.ext'
  intro w q
  let a := fU.comp
    ((TensorProduct.mk (R.obj.obj U) _ ((Q n).val.obj U)).flip q)
  let b := gU.comp
    ((TensorProduct.mk (R.obj.obj U) _ ((Q n).val.obj U)).flip q)
  have hab : a = b := by
    apply exteriorPower.linearMap_ext (R := R.obj.obj U) (M := M.val.obj U)
      (N := N.val.obj U) (n := n)
    apply AlternatingMap.ext
    intro v
    erw [LinearMap.compAlternatingMap_apply, LinearMap.compAlternatingMap_apply]
    change f.val.app U ((termUnit R M Q n).app U
        (exteriorPower.ιMulti (R.obj.obj U) n v ⊗ₜ q)) =
      g.val.app U ((termUnit R M Q n).app U
        (exteriorPower.ιMulti (R.obj.obj U) n v ⊗ₜ q))
    simpa only [termUnit_wedge_tensor] using h U v q
  exact LinearMap.congr_fun hab w

end PaperVerification.Segre.WeightedKoszulLocalFormula

end SegreWeightedKoszulLocalFormula

section SegreSheafExteriorRestriction

/-!
# Exterior powers and genuine restriction

The coefficient-changing comparison is an isomorphism when the local
coefficient maps are isomorphisms and the site functor is cocontinuous.
This includes every restriction along an open immersion of schemes.
Sheafification commutes with this restriction because its unit remains
locally bijective; scalar restriction does not change the underlying
presheaf of abelian groups.
-/

set_option autoImplicit false
set_option maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.SheafExteriorRestriction

open CategoryTheory Opposite
open TauCeti.SheafOfModules (ringCatSheaf)

universe u
variable {C D : Type u} [SmallCategory C] [SmallCategory D]
variable {J : GrothendieckTopology C} {K : GrothendieckTopology D}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [K.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [HasWeakSheafify K AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [K.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (F : C ⥤ D) [F.IsContinuous J K]
variable (S : Sheaf J CommRingCat.{u}) (R : Sheaf K CommRingCat.{u})
variable (φ : S ⟶ (F.sheafPushforwardContinuous CommRingCat J K).obj R)

/-- The same actual coefficient map after forgetting commutativity. -/
def ringMap : ringCatSheaf S ⟶
    (F.sheafPushforwardContinuous RingCat J K).obj (ringCatSheaf R) :=
  ⟨Functor.whiskerRight φ.hom (forget₂ CommRingCat RingCat)⟩

/-- Actual scalar-restricted pushforward on module presheaves. -/
abbrev pushPresheaf : PresheafOfModulesOfCommRing.{u} R.obj ⥤
    PresheafOfModulesOfCommRing.{u} S.obj :=
  PresheafOfModules.pushforward (F := F) (ringMap F S R φ).hom

/-- Actual scalar-restricted pushforward on module sheaves. -/
abbrev pushSheaf : SheafOfModules.{u} (ringCatSheaf R) ⥤
    SheafOfModules.{u} (ringCatSheaf S) :=
  SheafOfModules.pushforward (F := F) (ringMap F S R φ)

/-- Pushforward of the actual sheafification unit. -/
def pushUnit (P : PresheafOfModulesOfCommRing.{u} R.obj) :
    (pushPresheaf F S R φ).obj P ⟶
      ((pushSheaf F S R φ).obj
        ((PresheafOfModules.sheafification (R := ringCatSheaf R) (𝟙 _)).obj P)).val :=
  (pushPresheaf F S R φ).map
    ((PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf R).obj)).unit.app P)

theorem pushUnit_underlying (P : PresheafOfModulesOfCommRing.{u} R.obj) :
    (PresheafOfModules.toPresheaf _).map (pushUnit F S R φ P) =
      Functor.whiskerLeft F.op (CategoryTheory.toSheafify K P.presheaf) := by
  change Functor.whiskerLeft F.op
    ((PresheafOfModules.toPresheaf _).map
      ((PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf R).obj)).unit.app P)) = _
  rw [PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app]

variable [F.IsCocontinuous J K]

/-- Cocontinuity preserves the local bijectivity of the sheafification unit. -/
theorem pushUnit_W (P : PresheafOfModulesOfCommRing.{u} R.obj) :
    J.W ((PresheafOfModules.toPresheaf _).map (pushUnit F S R φ P)) := by
  rw [pushUnit_underlying]
  exact (J.W_iff_isLocallyBijective _).mpr
    ⟨Presheaf.isLocallyInjective_whisker J K F _,
      Presheaf.isLocallySurjective_whisker J K F _⟩

instance pushUnit_sheafification_isIso (P : PresheafOfModulesOfCommRing.{u} R.obj) :
    IsIso ((PresheafOfModules.sheafification
      (R := ringCatSheaf S) (𝟙 _)).map (pushUnit F S R φ P)) := by
  change ((MorphismProperty.isomorphisms _).inverseImage
    (PresheafOfModules.sheafification (R := ringCatSheaf S) (𝟙 _)))
      (pushUnit F S R φ P)
  rw [← PresheafOfModules.inverseImage_W_toPresheaf_eq_inverseImage_isomorphisms]
  exact pushUnit_W F S R φ P

/-- Sheafification commutes with scalar-restricted reindexing, through the
actual sheafification unit and counit. -/
def sheafificationPushIso (P : PresheafOfModulesOfCommRing.{u} R.obj) :
    (PresheafOfModules.sheafification (R := ringCatSheaf S) (𝟙 _)).obj
        ((pushPresheaf F S R φ).obj P) ≅
      (pushSheaf F S R φ).obj
        ((PresheafOfModules.sheafification (R := ringCatSheaf R) (𝟙 _)).obj P) :=
  asIso ((PresheafOfModules.sheafification (R := ringCatSheaf S) (𝟙 _)).map
      (pushUnit F S R φ P)) ≪≫
    TauCeti.SheafOfModules.sheafificationIso (ringCatSheaf S)
      ((pushSheaf F S R φ).obj
        ((PresheafOfModules.sheafification (R := ringCatSheaf R) (𝟙 _)).obj P))

/-- The comparison of sheafifications sends the actual sheafification
unit to the pushed-forward sheafification unit. -/
@[reassoc] theorem unit_sheafificationPushIso
    (P : PresheafOfModulesOfCommRing.{u} R.obj) :
    (PresheafOfModules.sheafificationAdjunction (𝟙 (ringCatSheaf S).obj)).unit.app
        ((pushPresheaf F S R φ).obj P) ≫
      (sheafificationPushIso F S R φ P).hom.val =
        pushUnit F S R φ P := by
  simpa only [sheafificationPushIso, Iso.trans_hom, asIso_hom] using
    (TauCeti.SheafOfModules.unit_comp_val_sheafification_map_comp_sheafificationIso_hom
      (R := ringCatSheaf S) (P := (pushPresheaf F S R φ).obj P)
      (M := (pushSheaf F S R φ).obj
        ((PresheafOfModules.sheafification (R₀ := (ringCatSheaf R).obj)
          (R := ringCatSheaf R) (𝟙 (ringCatSheaf R).obj)).obj P))
      (pushUnit F S R φ P))

variable (hφ : ∀ U : Cᵒᵖ, Function.Bijective (φ.hom.app U).hom)

/-- The sectionwise exterior scalar-change comparison is an isomorphism. -/
def exteriorAppIso (P : PresheafOfModulesOfCommRing.{u} R.obj) (r : ℕ) (U : Cᵒᵖ) :
    (((pushPresheaf F S R φ).obj P).obj U).exteriorPower r ≅
      ((pushPresheaf F S R φ).obj
        ((PresheafOfModulesOfCommRing.exteriorPower r).obj P)).obj U := by
  letI : IsIso ((TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison
      (φ.hom.app U).hom r).app (P.obj (F.op.obj U))) :=
    TauCeti.ModuleCat.isIso_restrictScalarsExteriorPowerComparison_app_of_bijective
      (φ.hom.app U).hom (hφ U) r (P.obj (F.op.obj U))
  exact asIso ((TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison
    (φ.hom.app U).hom r).app (P.obj (F.op.obj U)))

@[simp] theorem exteriorAppIso_mk (P : PresheafOfModulesOfCommRing.{u} R.obj)
    (r : ℕ) (U : Cᵒᵖ) (v : Fin r → ((pushPresheaf F S R φ).obj P).obj U) :
    (exteriorAppIso F S R φ hφ P r U).hom (ModuleCat.exteriorPower.mk v) =
      ModuleCat.exteriorPower.mk (M := P.obj (F.op.obj U)) v := by
  exact TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison_app_mk
    (φ.hom.app U).hom r (P.obj (F.op.obj U)) v

set_option maxHeartbeats 1000000 in
/-- Every local coefficient comparison fits into a genuine presheaf isomorphism. -/
def presheafExteriorPushIso (P : PresheafOfModulesOfCommRing.{u} R.obj) (r : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower r).obj
        ((pushPresheaf F S R φ).obj P) ≅
      (pushPresheaf F S R φ).obj
        ((PresheafOfModulesOfCommRing.exteriorPower r).obj P) := by
  -- Fix both presheaves and the component family before the naturality goal.
  -- The raw constructor keeps the actual ring-sheaf presentation throughout.
  let P' : PresheafOfModulesOfCommRing.{u} S.obj := (pushPresheaf F S R φ).obj P
  let E' : PresheafOfModulesOfCommRing.{u} S.obj :=
    (PresheafOfModulesOfCommRing.exteriorPower (R := S.obj) r).obj P'
  let T' : PresheafOfModulesOfCommRing.{u} S.obj :=
    (pushPresheaf F S R φ).obj
      ((PresheafOfModulesOfCommRing.exteriorPower (R := R.obj) r).obj P)
  let e : ∀ U : Cᵒᵖ, E'.obj U ≅ T'.obj U :=
    fun U => exteriorAppIso F S R φ hφ P r U
  change E' ≅ T'
  refine PresheafOfModules.isoMk (R := (ringCatSheaf S).obj)
    (M₁ := E') (M₂ := T') e ?_
  intro U V i
  let A : ModuleCat.{u} (S.obj.obj U) := P'.obj U
  let B : ModuleCat.{u} (S.obj.obj U) :=
    (ModuleCat.restrictScalars.{u} (S.obj.map i).hom).obj (T'.obj V)
  let leftMap : A.exteriorPower r ⟶ B :=
    E'.map i ≫ (ModuleCat.restrictScalars.{u} (S.obj.map i).hom).map (e V).hom
  let rightMap : A.exteriorPower r ⟶ B := (e U).hom ≫ T'.map i
  change leftMap = rightMap
  apply ModuleCat.exteriorPower.hom_ext
    (R := S.obj.obj U) (M := A) (N := B) (n := r)
    (f := leftMap) (g := rightMap)
  apply ModuleCat.AlternatingMap.ext
  intro v
  change (exteriorAppIso F S R φ hφ P r V).hom
      (((PresheafOfModulesOfCommRing.exteriorPower (R := S.obj) r).obj P').map i
        (ModuleCat.exteriorPower.mk v)) =
    T'.map i ((exteriorAppIso F S R φ hφ P r U).hom
      (ModuleCat.exteriorPower.mk v))
  erw [PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk,
    exteriorAppIso_mk, exteriorAppIso_mk]
  exact (PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk
    r P (F.op.map i) v).symm


/-- Exterior powers commute with the actual restriction functor. Both
coefficient-ring changes and sheafifications are included in this iso. -/
def sheafExteriorPushIso (M : SheafOfModules.{u} (ringCatSheaf R)) (r : ℕ) :
    (SheafOfModules.exteriorPower S r).obj ((pushSheaf F S R φ).obj M) ≅
      (pushSheaf F S R φ).obj ((SheafOfModules.exteriorPower R r).obj M) :=
  SheafOfModules.exteriorPowerIso r ((pushSheaf F S R φ).obj M) ≪≫
    (PresheafOfModules.sheafification (R := ringCatSheaf S) (𝟙 _)).mapIso
      (presheafExteriorPushIso F S R φ hφ M.val r) ≪≫
    sheafificationPushIso F S R φ
      ((PresheafOfModulesOfCommRing.exteriorPower r).obj M.val) ≪≫
    (pushSheaf F S R φ).mapIso (SheafOfModules.exteriorPowerIso r M).symm

/-- The exterior restriction comparison carries each actual local wedge
to the same wedge over the original coefficient ring. -/
theorem sheafExteriorPushIso_wedge (M : SheafOfModules.{u} (ringCatSheaf R))
    (r : ℕ) (U : Cᵒᵖ)
    (v : Fin r → ((pushSheaf F S R φ).obj M).val.obj U) :
    (sheafExteriorPushIso F S R φ hφ M r).hom.val.app U
      (SheafCoefficientContraction.wedgeSection S
        ((pushSheaf F S R φ).obj M) r U v) =
      SheafCoefficientContraction.wedgeSection R M r (F.op.obj U) v := by
  let e := presheafExteriorPushIso F S R φ hφ M.val r
  let P := (PresheafOfModulesOfCommRing.exteriorPower r).obj M.val
  have hu := unit_sheafificationPushIso F S R φ P
  have hcomp :
      (PresheafOfModules.sheafificationAdjunction
          (𝟙 (ringCatSheaf S).obj)).unit.app _ ≫
        ((PresheafOfModules.sheafification
          (R := ringCatSheaf S) (𝟙 _)).map e.hom).val ≫
        (sheafificationPushIso F S R φ P).hom.val =
      e.hom ≫ pushUnit F S R φ P := by
    -- Naturality is composed before evaluating sections. Using the equality
    -- directly keeps the actual scalar-restriction functor aliases aligned.
    exact ((PresheafOfModules.sheafificationAdjunction
      (𝟙 (ringCatSheaf S).obj)).unit.naturality_assoc e.hom
        (sheafificationPushIso F S R φ P).hom.val).symm.trans
          (congrArg (e.hom ≫ ·) hu)
  have h := congrArg (fun g => g.app U) hcomp
  have hv := ConcreteCategory.congr_hom h (ModuleCat.exteriorPower.mk (R := S.obj.obj U)
      (M := ((pushPresheaf F S R φ).obj M.val).obj U) v)
  -- Evaluate the categorical square before normalizing its scalar-change
  -- component. The defining exterior-power identifications are identities.
  have he : e.hom.app U (ModuleCat.exteriorPower.mk (R := S.obj.obj U)
      (M := ((pushPresheaf F S R φ).obj M.val).obj U) v) =
      ModuleCat.exteriorPower.mk (R := R.obj.obj (F.op.obj U))
        (M := M.val.obj (F.op.obj U)) v :=
    exteriorAppIso_mk F S R φ hφ M.val r U v
  change (sheafificationPushIso F S R φ P).hom.val.app U
      (((PresheafOfModules.sheafification
        (R := ringCatSheaf S) (𝟙 _)).map e.hom).val.app U
        (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (ringCatSheaf S).obj)).unit.app
          ((PresheafOfModulesOfCommRing.exteriorPower r).obj
            ((pushPresheaf F S R φ).obj M.val))).app U
          (ModuleCat.exteriorPower.mk (R := S.obj.obj U)
            (M := ((pushPresheaf F S R φ).obj M.val).obj U) v))) =
    (pushUnit F S R φ P).app U
      (e.hom.app U (ModuleCat.exteriorPower.mk (R := S.obj.obj U)
        (M := ((pushPresheaf F S R φ).obj M.val).obj U) v)) at hv
  change (sheafificationPushIso F S R φ P).hom.val.app U
      (((PresheafOfModules.sheafification
        (R := ringCatSheaf S) (𝟙 _)).map e.hom).val.app U
        (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (ringCatSheaf S).obj)).unit.app
          ((PresheafOfModulesOfCommRing.exteriorPower r).obj
            ((pushPresheaf F S R φ).obj M.val))).app U
          (ModuleCat.exteriorPower.mk (R := S.obj.obj U)
      (M := ((pushPresheaf F S R φ).obj M.val).obj U) v))) =
    (pushUnit F S R φ P).app U
      (ModuleCat.exteriorPower.mk (R := R.obj.obj (F.op.obj U))
        (M := M.val.obj (F.op.obj U)) v)
  exact hv.trans (congrArg (fun z => (pushUnit F S R φ P).app U z) he)

end PaperVerification.Segre.SheafExteriorRestriction

namespace PaperVerification.Segre.SchemeExteriorRestriction

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.Scheme.Modules
open SheafExteriorRestriction

universe u
variable {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]

/-- The structure sheaf of the open subscheme is the reindexed ambient
structure sheaf through the actual local ring isomorphisms. -/
def coefficientMap : X.sheaf ⟶
    (f.opensFunctor.sheafPushforwardContinuous CommRingCat
      (_root_.Opens.grothendieckTopology X)
      (_root_.Opens.grothendieckTopology Y)).obj Y.sheaf :=
  ⟨{ app := fun U => (f.appIso U.unop).inv,
      naturality := by
        intro U V i
        exact f.appIso_inv_naturality i }⟩

/-- Actual restriction to every open immersion commutes with every exterior
power; this is needed before applying affine module calculations. -/
def restrictExteriorIso (M : Y.Modules) (r : ℕ) :
    AlgebraicGeometry.Scheme.Modules.restrict (X := X) (Y := Y)
      ((SheafOfModules.exteriorPower Y.sheaf r).obj M) f ≅
      (SheafOfModules.exteriorPower X.sheaf r).obj (M.restrict f) := by
  let hφ : ∀ U, Function.Bijective ((coefficientMap f).hom.app U).hom := by
    intro U
    change Function.Bijective (f.appIso U.unop).inv.hom
    exact ConcreteCategory.bijective_of_isIso (f.appIso U.unop).inv
  exact (sheafExteriorPushIso f.opensFunctor X.sheaf Y.sheaf
    (coefficientMap f) hφ M r).symm

/-- The inverse exterior restriction comparison preserves every local
wedge, including the actual change of structure-ring coefficients. -/
theorem restrictExteriorIso_inv_wedge (M : Y.Modules) (r : ℕ)
    (U : X.Opens) (v : Fin r → Γ(M.restrict f, U)) :
    (restrictExteriorIso f M r).inv.app U
      (SheafCoefficientContraction.wedgeSection X.sheaf (M.restrict f) r
        (Opposite.op U) v) =
      SheafCoefficientContraction.wedgeSection Y.sheaf M r
        (Opposite.op (f ''ᵁ U)) v := by
  exact sheafExteriorPushIso_wedge f.opensFunctor X.sheaf Y.sheaf
    (coefficientMap f) (fun V => by
      change Function.Bijective (f.appIso V.unop).inv.hom
      exact ConcreteCategory.bijective_of_isIso (f.appIso V.unop).inv)
    M r (Opposite.op U) v

end PaperVerification.Segre.SchemeExteriorRestriction

end SegreSheafExteriorRestriction

section SegreWeightedKoszulRestriction

/-!
# Genuine restriction of the weighted Koszul differential

The existing restriction tensor isomorphism and the actual exterior
restriction isomorphism identify each full weighted term. Their formulas
on local sections prove that the complete differential, including its
coefficient multiplication, restricts to the expected differential.
Exactness can consequently be checked on an actual open cover.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
open scoped Classical TensorProduct BigOperators

namespace PaperVerification.Segre.WeightedKoszulRestriction

open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open SheafCoefficientContraction SheafCoefficientComplex WeightedSheafKoszul
open WeightedKoszulLocalFormula SchemeExteriorRestriction

universe u
variable {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]

local notation "G" => restrictFunctor f

/-- Use the already proved additivity of actual restriction at the precise
scheme categories appearing in the short-complex map below. -/
local instance restrict_preservesZeroMorphisms :
    (restrictFunctor f).PreservesZeroMorphisms := by
  letI : (restrictFunctor f).Additive := Scheme.Modules.restrictFunctorAdditive f
  infer_instance

/-- Restriction's existing tensor comparison preserves the literal local
tensor of sections, with the actual change of structure-ring scalars. -/
theorem restrict_tensor_section (M N : Y.Modules) (U : X.Opens)
    (m : Γ(M.restrict f, U)) (n : Γ(N.restrict f, U)) :
    (Functor.LaxMonoidal.μ G M N).app U
      (tensorSection X.sheaf (M.restrict f) (N.restrict f) (op U) m n) =
        tensorSection Y.sheaf M N (op (f ''ᵁ U)) m n :=
  TauCeti.SheafOfModules.pushforward_μ_app_tmul
    (restrictRingCatSheafHom f) M N (op U) m n

variable (M L : Y.Modules) (Q : ℕ → Y.Modules)

/-- The coefficient multiplication after actual restriction. -/
def restrictMultiplication (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n) (n : ℕ) :
    L.restrict f ⊗ (Q (n + 1)).restrict f ⟶ (Q n).restrict f :=
  Functor.LaxMonoidal.μ G L (Q (n + 1)) ≫ (G).map (μ n)

@[simp] theorem restrictMultiplication_at
    (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n) (n : ℕ) (U : X.Opens)
    (a : Γ(L.restrict f, U)) (q : Γ((Q (n + 1)).restrict f, U)) :
    multiplicationAt X.sheaf (restrictMultiplication f L Q μ n) (op U) a q =
      multiplicationAt Y.sheaf (μ n) (op (f ''ᵁ U)) a q := by
  simp only [multiplicationAt_apply, restrictMultiplication,
    SheafOfModules.comp_val, PresheafOfModules.comp_app, ConcreteCategory.comp_apply]
  change (μ n).val.app (op (f ''ᵁ U))
      ((Functor.LaxMonoidal.μ G L (Q (n + 1))).app U
        (tensorSection X.sheaf (L.restrict f) ((Q (n + 1)).restrict f) (op U) a q)) = _
  exact congrArg (fun z => (μ n).val.app (op (f ''ᵁ U)) z)
    (restrict_tensor_section f L (Q (n + 1)) U a q)

theorem restrict_coefficientsCommute
    (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n)
    (hcomm : CoefficientsCommute.{u} Y.sheaf L Q μ) :
    CoefficientsCommute.{u} X.sheaf (L.restrict f)
      (fun n => (Q n).restrict f) (restrictMultiplication f L Q μ) := by
  rintro n ⟨U⟩ a b q
  simpa only [restrictMultiplication_at] using hcomm n (op (f ''ᵁ U)) a b q

/-- The local weighted term and the actual restriction of the global term
are canonically isomorphic in every degree. -/
def termIso (n : ℕ) :
    term X.sheaf (M.restrict f) (fun n => (Q n).restrict f) n ≅
      AlgebraicGeometry.Scheme.Modules.restrict (X := X) (Y := Y)
        (term Y.sheaf M Q n) f :=
  by
    let E : Y.Modules := (SheafOfModules.exteriorPower Y.sheaf n).obj M
    letI : IsIso (Functor.LaxMonoidal.μ G E (Q n)) :=
      Scheme.Modules.isIso_restrictFunctor_μ f E (Q n)
    exact ((restrictExteriorIso f M n).symm ⊗ᵢ Iso.refl ((Q n).restrict f)) ≪≫
      asIso (Functor.LaxMonoidal.μ G E (Q n))

/-- The term comparison preserves each actual local wedge tensor. -/
@[simp] theorem termIso_wedge_tensor (n : ℕ) (U : X.Opens)
    (v : Fin n → Γ(M.restrict f, U)) (q : Γ((Q n).restrict f, U)) :
    (termIso f M Q n).hom.val.app (op U)
      (tensorSection X.sheaf
        ((SheafOfModules.exteriorPower X.sheaf n).obj (M.restrict f))
        ((Q n).restrict f) (op U) (wedgeSection X.sheaf (M.restrict f) n (op U) v) q) =
      tensorSection Y.sheaf ((SheafOfModules.exteriorPower Y.sheaf n).obj M)
        (Q n) (op (f ''ᵁ U)) (wedgeSection Y.sheaf M n (op (f ''ᵁ U)) v) q := by
  let E : Y.Modules := (SheafOfModules.exteriorPower Y.sheaf n).obj M
  have he :
      (restrictExteriorIso f M n).inv.val.app (op U)
          (wedgeSection X.sheaf (M.restrict f) n (op U) v) =
        wedgeSection Y.sheaf M n (op (f ''ᵁ U)) v :=
    restrictExteriorIso_inv_wedge f M n U v
  have ht := SheafCoefficientComplex.tensorSection_map X.sheaf
    (restrictExteriorIso f M n).inv (𝟙 ((Q n).restrict f)) (op U)
    (wedgeSection X.sheaf (M.restrict f) n (op U) v) q
  have ht' :
      ((restrictExteriorIso f M n).inv ⊗ₘ 𝟙 ((Q n).restrict f)).val.app (op U)
          (tensorSection X.sheaf
            ((SheafOfModules.exteriorPower X.sheaf n).obj (M.restrict f))
            ((Q n).restrict f) (op U)
            (wedgeSection X.sheaf (M.restrict f) n (op U) v) q) =
        tensorSection X.sheaf (E.restrict f) ((Q n).restrict f) (op U)
          (wedgeSection Y.sheaf M n (op (f ''ᵁ U)) v) q :=
    ht.trans (congrArg₂
      (tensorSection X.sheaf (E.restrict f) ((Q n).restrict f) (op U))
      he rfl)
  have hμ := restrict_tensor_section f E (Q n) U
    (wedgeSection Y.sheaf M n (op (f ''ᵁ U)) v) q
  simp only [termIso, Iso.trans_hom, tensorIso_hom, Iso.symm_hom,
    Iso.refl_hom, asIso_hom, SheafOfModules.comp_val, PresheafOfModules.comp_app,
    ConcreteCategory.comp_apply]
  exact (congrArg (fun z =>
    (Functor.LaxMonoidal.μ G E (Q n)).val.app (op U) z) ht').trans hμ

variable (φ : M ⟶ L) (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n)

/-- The entire actual weighted differential commutes with restriction,
under the canonical term isomorphisms. -/
@[reassoc] theorem differential_restricts (n : ℕ) :
    differential X.sheaf (M.restrict f) (L.restrict f)
        (fun n => (Q n).restrict f) ((G).map φ) (restrictMultiplication f L Q μ) n ≫
      (termIso f M Q n).hom =
        (termIso f M Q (n + 1)).hom ≫
          (G).map (differential Y.sheaf M L Q φ μ n) := by
  apply WeightedKoszulLocalFormula.hom_ext X.sheaf (M.restrict f)
    (fun n => (Q n).restrict f) (n + 1)
  rintro ⟨U⟩ v q
  change (termIso f M Q n).hom.val.app (op U)
      ((differential X.sheaf (M.restrict f) (L.restrict f)
        (fun n => (Q n).restrict f) ((G).map φ) (restrictMultiplication f L Q μ) n).val.app (op U)
        (tensorSection X.sheaf _ _ (op U) (wedgeSection X.sheaf _ (n + 1) (op U) v) q)) =
    (differential Y.sheaf M L Q φ μ n).val.app (op (f ''ᵁ U))
      ((termIso f M Q (n + 1)).hom.val.app (op U)
        (tensorSection X.sheaf _ _ (op U) (wedgeSection X.sheaf _ (n + 1) (op U) v) q))
  simp only [differential_wedge_tensor, map_sum, map_zsmul,
    termIso_wedge_tensor, restrictMultiplication_at]
  rfl

variable (hcomm : CoefficientsCommute.{u} Y.sheaf L Q μ)

set_option pp.rawOnError true in
/-- The genuine restricted short complex, with both differential squares,
is isomorphic to the actual local weighted Koszul complex. -/
def shortComplexIso (n : ℕ) :
    (show ShortComplex X.Modules from
      shortComplex.{u} X.sheaf (M.restrict f) (L.restrict f)
        (fun n => (Q n).restrict f) ((G).map φ) (restrictMultiplication f L Q μ)
        (restrict_coefficientsCommute f L Q μ hcomm) n) ≅
      (show ShortComplex Y.Modules from
        shortComplex.{u} Y.sheaf M L Q φ μ hcomm n).map
          (show Y.Modules ⥤ X.Modules from G) :=
  ShortComplex.isoMk (termIso f M Q (n + 2)) (termIso f M Q (n + 1))
    (termIso f M Q n)
    (differential_restricts f M L Q φ μ (n + 1)).symm
    (differential_restricts f M L Q φ μ n).symm

set_option pp.rawOnError true in
/-- Exactness of the identified local complex gives exactness of the
actual restriction of the global complex. -/
theorem exact_restrict_of_local (n : ℕ)
    (h : (show ShortComplex X.Modules from
      shortComplex.{u} X.sheaf (M.restrict f) (L.restrict f)
        (fun n => (Q n).restrict f) ((G).map φ) (restrictMultiplication f L Q μ)
        (restrict_coefficientsCommute f L Q μ hcomm) n).Exact) :
    ((show ShortComplex Y.Modules from
      shortComplex.{u} Y.sheaf M L Q φ μ hcomm n).map
        (show Y.Modules ⥤ X.Modules from G)).Exact :=
  ShortComplex.exact_of_iso (shortComplexIso f M L Q φ μ hcomm n) h

end PaperVerification.Segre.WeightedKoszulRestriction

namespace PaperVerification.Segre.WeightedKoszulLocalCommutation

open CategoryTheory MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open SheafCoefficientContraction WeightedSheafKoszul WeightedKoszulRestriction

universe u
variable {Y : Scheme.{u}}

/-- Naturality of the actual bilinear coefficient multiplication under
restriction to a smaller open, including the scalar change. -/
theorem multiplication_restrict {L Q P : Y.Modules} (μ : L ⊗ Q ⟶ P)
    {U V : Y.Opens} (hVU : V ≤ U) (a : Γ(L,U)) (q : Γ(Q,U)) :
    P.presheaf.map (homOfLE hVU).op (multiplicationAt Y.sheaf μ (op U) a q) =
      multiplicationAt Y.sheaf μ (op V)
        (L.presheaf.map (homOfLE hVU).op a)
        (Q.presheaf.map (homOfLE hVU).op q) := by
  have h := PresheafOfModulesOfCommRing.naturality_apply
    (presheafMultiplication Y.sheaf μ) (homOfLE hVU).op (a ⊗ₜ q)
  erw [PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul] at h
  exact h.symm

/-- Commutation of the actual coefficient actions is local for any open
immersion cover. Thus local line frames suffice even when the original
coefficient line is globally nontrivial. -/
theorem coefficientsCommute_of_openImmersion_cover
    (L : Y.Modules) (Q : ℕ → Y.Modules)
    (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n)
    {ι : Type*} {Z : ι → Scheme.{u}} (f : ∀ i, Z i ⟶ Y)
    [∀ i, IsOpenImmersion (f i)] (hcover : (⨆ i, (f i).opensRange) = ⊤)
    (hlocal : ∀ i, CoefficientsCommute.{u} (Z i).sheaf (L.restrict (f i))
      (fun n => (Q n).restrict (f i)) (restrictMultiplication (f i) L Q μ)) :
    CoefficientsCommute.{u} Y.sheaf L Q μ := by
  rintro n ⟨U⟩ a b q
  let V : ι → Y.Opens := fun i => f i ''ᵁ (f i ⁻¹ᵁ U)
  let hV : ∀ i, V i ≤ U := fun i => (f i).image_preimage_le U
  apply TopCat.Sheaf.eq_of_locally_eq'
    (⟨(Q n).presheaf, (Q n).isSheaf⟩ : TopCat.Sheaf AddCommGrpCat Y)
    V U (fun i => homOfLE (hV i))
  · simp only [V, Scheme.Hom.image_preimage_eq_opensRange_inf,
      ← iSup_inf_eq, hcover, top_inf_eq, le_rfl]
  · intro i
    simp only [multiplication_restrict]
    have h := hlocal i n (op (f i ⁻¹ᵁ U))
      (L.presheaf.map (homOfLE (hV i)).op a)
      (L.presheaf.map (homOfLE (hV i)).op b)
      ((Q (n + 2)).presheaf.map (homOfLE (hV i)).op q)
    simpa only [restrictMultiplication_at] using h

end PaperVerification.Segre.WeightedKoszulLocalCommutation

namespace PaperVerification.Segre.SchemeKoszulLocalExactness

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open AlgebraicGeometry.Scheme.Modules

universe u
variable {X : Scheme.{u}}

/-- Exactness of an actual short complex of module sheaves can be checked
on any actual open cover. The proof uses its actual homology object and
the canonical exact-functor comparison, without postulating a resolution. -/
theorem exact_of_open_cover (S : ShortComplex X.Modules)
    {ι : Type*} (U : ι → X.Opens) (hU : iSup U = ⊤)
    (h : ∀ i, (S.map (restrictFunctor (U i).ι)).Exact) : S.Exact := by
  rw [S.exact_iff_isZero_homology]
  apply (isZero_iff_of_iSup_eq_top U hU S.homology).mpr
  intro i
  exact IsZero.of_iso ((S.map (restrictFunctor (U i).ι)).exact_iff_isZero_homology.mp (h i))
    (S.mapHomologyIso (restrictFunctor (U i).ι)).symm

/-- Vanishing of a sheaf can be checked after arbitrary open immersions
whose actual images cover the scheme, including affine spectrum charts. -/
theorem isZero_of_openImmersion_cover (M : X.Modules)
    {ι : Type*} {Z : ι → Scheme.{u}} (f : ∀ i, Z i ⟶ X)
    [∀ i, IsOpenImmersion (f i)] (hcover : (⨆ i, (f i).opensRange) = ⊤)
    (h : ∀ i, IsZero (M.restrict (f i))) : IsZero M := by
  rw [IsZero.iff_id_eq_zero]
  apply Scheme.Modules.hom_ext
  intro U
  ext s
  simp only [Scheme.Modules.Hom.id_app, Scheme.Modules.Hom.zero_app,
    AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
    AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
  apply TopCat.Sheaf.eq_of_locally_eq'
    (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf AddCommGrpCat X)
    (fun i => f i ''ᵁ (f i ⁻¹ᵁ U)) U
    (fun i => homOfLE ((f i).image_preimage_le U))
  · simp only [Scheme.Hom.image_preimage_eq_opensRange_inf,
      ← iSup_inf_eq, hcover, top_inf_eq, le_rfl]
  · intro i
    rw [map_zero]
    let W := f i ⁻¹ᵁ U
    let t := M.presheaf.map (homOfLE ((f i).image_preimage_le U)).op s
    have hz : (M.restrictAppIso (f i) W).inv t = 0 := by
      simpa using ConcreteCategory.congr_hom
        (congrArg (fun g => g.app W) ((h i).eq_of_src (𝟙 _) 0))
        ((M.restrictAppIso (f i) W).inv t)
    change t = 0
    rw [← Iso.inv_hom_id_apply (M.restrictAppIso (f i) W) t, hz, map_zero]

/-- Exactness can be checked on actual affine spectrum charts without
replacing the ambient scheme by a surrogate chart cover. -/
theorem exact_of_openImmersion_cover (S : ShortComplex X.Modules)
    {ι : Type*} {Z : ι → Scheme.{u}} (f : ∀ i, Z i ⟶ X)
    [∀ i, IsOpenImmersion (f i)] (hcover : (⨆ i, (f i).opensRange) = ⊤)
    (h : ∀ i, (S.map (restrictFunctor (f i))).Exact) : S.Exact := by
  rw [S.exact_iff_isZero_homology]
  apply isZero_of_openImmersion_cover S.homology f hcover
  intro i
  exact IsZero.of_iso ((S.map (restrictFunctor (f i))).exact_iff_isZero_homology.mp (h i))
    (S.mapHomologyIso (restrictFunctor (f i))).symm

end PaperVerification.Segre.SchemeKoszulLocalExactness

end SegreWeightedKoszulRestriction

section SegreKoszulCoordinateTransport

/-!
# Exact Koszul complexes under genuine coordinate-ring isomorphisms

A ring isomorphism realizes its target as localization at the unit `1`.
The already proved exterior base-change maps and differential comparison
therefore transport full Koszul exactness by exactness of localization.
This keeps actual affine chart rings, rather than replacing them by
definition with polynomial rings.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.KoszulCoordinateTransport

open CategoryTheory AlgebraicGeometry
open KoszulLocalization TauCeti

section Localization

variable (R A : Type*) [CommRing R] [CommRing A] [Algebra R A]
variable (ι : Type*) [Fintype ι]

/-- Exactness of the actual full Koszul complex is preserved by
localization, with its differentials identified explicitly. -/
theorem exact_localizes (S : Submonoid R) [IsLocalization S A]
    (f : ι → R) (q : ℕ)
    (h : (koszulComplex (Fintype.linearCombination R f)).ExactAt (q + 1)) :
    (koszulComplex (Fintype.linearCombination A
      (fun i => algebraMap R A (f i)))).ExactAt (q + 1) := by
  rw [koszulComplex.exactAt_succ_iff] at h ⊢
  have hx := IsLocalizedModule.map_exact S
    (exteriorExtension R A ι (q + 2))
    (exteriorExtension R A ι (q + 1))
    (exteriorExtension R A ι q)
    (koszulDifferential (Fintype.linearCombination R f) (q + 1))
    (koszulDifferential (Fintype.linearCombination R f) q) h
  rw [localizedMap_differential, localizedMap_differential] at hx
  exact hx

omit [Algebra R A] in
/-- The actual target ring of a coordinate isomorphism has precisely the
transported exact Koszul complex. -/
theorem exact_of_ringEquiv (e : R ≃+* A) (f : ι → R) (q : ℕ)
    (h : (koszulComplex (Fintype.linearCombination R f)).ExactAt (q + 1)) :
    (koszulComplex (Fintype.linearCombination A (fun i => e (f i)))).ExactAt (q + 1) := by
  letI : Algebra R A := e.toRingHom.toAlgebra
  letI : IsLocalization.Away (1 : R) A :=
    IsLocalization.away_of_isUnit_of_bijective A isUnit_one e.bijective
  exact exact_localizes R A ι (Submonoid.powers (1 : R)) f q h

end Localization

section Polynomial

universe u
variable {K : Type u} [Field K] {n : ℕ}
variable (A : CommRingCat.{u})

local notation "P" => LocalRegularKoszul.PolynomialRing K n

/-- The actual finite polynomial quotient implies exactness over every
isomorphic actual affine coordinate ring. -/
theorem polynomial_coordinate_koszul_exact (e : P ≃+* A) (f : Fin n → P)
    [Module.Finite K (P ⧸ LocalRegularKoszul.equationIdeal f)] (q : ℕ) :
    (koszulComplex (Fintype.linearCombination A (fun i => e (f i)))).ExactAt (q + 1) :=
  exact_of_ringEquiv P A (Fin n) e f q (polynomial_koszul_exact f q)

/-- The entire actual sheaf Koszul complex on the spectrum of the actual
coordinate ring is exact in every positive degree. -/
theorem polynomial_coordinate_sheaf_exact (e : P ≃+* A) (f : Fin n → P)
    [Module.Finite K (P ⧸ LocalRegularKoszul.equationIdeal f)] (q : ℕ) :
    (SheafKoszul.shortComplex.{u}
      (RegularSheafKoszul.tildeFunctional (ModuleCat.of A (Fin n → A))
        (Fintype.linearCombination A (fun i => e (f i)))) q).Exact :=
  RegularSheafKoszul.sheaf_exact_of_module_exact (ModuleCat.of A (Fin n → A))
    (Fintype.linearCombination A (fun i => e (f i))) q
    (polynomial_coordinate_koszul_exact A e f q)

end Polynomial

section Reindex

universe u
variable {K ι : Type u} [Field K] [Fintype ι]

/-- Literal simultaneous renaming of affine coordinates and equation
indices by a finite index equivalence. -/
def renamedEquations (e : ι ≃ Fin (Fintype.card ι))
    (f : ι → MvPolynomial ι K) :
    Fin (Fintype.card ι) → MvPolynomial (Fin (Fintype.card ι)) K :=
  fun i => MvPolynomial.rename e (f (e.symm i))

/-- The entire equation ideal is transported, including its scheme
structure; this is stronger than equality of the rational zero sets. -/
theorem map_equationIdeal (e : ι ≃ Fin (Fintype.card ι))
    (f : ι → MvPolynomial ι K) :
    (Ideal.span (Set.range f)).map (MvPolynomial.renameEquiv K e).toRingHom =
      LocalRegularKoszul.equationIdeal (renamedEquations e f) := by
  have hlist : Ideal.ofList (List.ofFn (renamedEquations e f)) =
      Ideal.span (Set.range (renamedEquations e f)) :=
    congrArg Ideal.span (Set.ext fun _ => List.mem_ofFn' (renamedEquations e f) _)
  rw [Ideal.map_span, LocalRegularKoszul.equationIdeal, hlist]
  apply congrArg Ideal.span
  ext p
  constructor
  · rintro ⟨g, ⟨i, rfl⟩, rfl⟩
    exact ⟨e i, by simp only [renamedEquations, Equiv.symm_apply_apply]; rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨f (e.symm i), ⟨e.symm i, rfl⟩, rfl⟩

/-- Canonical algebra equivalence of the full actual quotient rings under
renaming of every coordinate and equation index. -/
def quotientRenameEquiv (e : ι ≃ Fin (Fintype.card ι))
    (f : ι → MvPolynomial ι K) :
    (MvPolynomial ι K ⧸ Ideal.span (Set.range f)) ≃ₐ[K]
      (MvPolynomial (Fin (Fintype.card ι)) K ⧸
        LocalRegularKoszul.equationIdeal (renamedEquations e f)) :=
  Ideal.quotientEquivAlg _ _ (MvPolynomial.renameEquiv K e)
    (map_equationIdeal e f).symm

theorem finite_renamed_equation_quotient (e : ι ≃ Fin (Fintype.card ι))
    (f : ι → MvPolynomial ι K)
    [Module.Finite K (MvPolynomial ι K ⧸ Ideal.span (Set.range f))] :
    Module.Finite K (MvPolynomial (Fin (Fintype.card ι)) K ⧸
      LocalRegularKoszul.equationIdeal (renamedEquations e f)) :=
  Module.Finite.of_surjective (quotientRenameEquiv e f).toLinearMap
    (quotientRenameEquiv e f).surjective

end Reindex

section IndexedCoordinateRing

universe u
variable {K ι : Type u} [Field K] [Fintype ι]
variable (A : CommRingCat.{u})

/-- Every finite affine-coordinate index is retained. The temporary `Fin`
model is connected by actual polynomial and source-module equivalences. -/
theorem indexed_coordinate_sheaf_exact
    (e : MvPolynomial ι K ≃+* A) (f : ι → MvPolynomial ι K)
    [Module.Finite K (MvPolynomial ι K ⧸ Ideal.span (Set.range f))] (q : ℕ) :
    (SheafKoszul.shortComplex.{u}
      (RegularSheafKoszul.tildeFunctional (ModuleCat.of A (ι → A))
        (Fintype.linearCombination A (fun i => e (f i)))) q).Exact := by
  classical
  let b := Fintype.equivFin ι
  let g := renamedEquations b f
  let ec : MvPolynomial (Fin (Fintype.card ι)) K ≃+* A :=
    (MvPolynomial.renameEquiv K b).toRingEquiv.symm.trans e
  letI := finite_renamed_equation_quotient b f
  have hc (j : Fin (Fintype.card ι)) : ec (g j) = e (f (b.symm j)) := by
    change e ((MvPolynomial.renameEquiv K b).symm
      ((MvPolynomial.renameEquiv K b) (f (b.symm j)))) = _
    rw [AlgEquiv.symm_apply_apply]
  let ep : (ι → A) ≃ₗ[A] (Fin (Fintype.card ι) → A) :=
    LinearEquiv.piCongrLeft' A (fun _ : ι => A) b
  let em := (tilde.functor A).mapIso ep.toModuleIso
  let ψ₁ := RegularSheafKoszul.tildeFunctional (ModuleCat.of A (ι → A))
    (Fintype.linearCombination A (fun i => e (f i)))
  let ψ₂ := RegularSheafKoszul.tildeFunctional
    (ModuleCat.of A (Fin (Fintype.card ι) → A))
    (Fintype.linearCombination A (fun j => ec (g j)))
  have hmap : ModuleCat.ofHom ep.toLinearMap ≫
      ModuleCat.ofHom (Fintype.linearCombination A (fun j => ec (g j))) =
        ModuleCat.ofHom (Fintype.linearCombination A (fun i => e (f i))) := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro v
    change (Fintype.linearCombination A (fun j => ec (g j))) (ep v) =
      (Fintype.linearCombination A (fun i => e (f i))) v
    simp only [Fintype.linearCombination_apply, hc, ep, LinearEquiv.piCongrLeft'_apply]
    exact Equiv.sum_comp b.symm (fun i => v i • e (f i))
  have hm : em.hom ≫ ψ₂ = ψ₁ := by
    change (tilde.functor A).map (ModuleCat.ofHom ep.toLinearMap) ≫
      ((tilde.functor A).map
        (ModuleCat.ofHom (Fintype.linearCombination A (fun j => ec (g j)))) ≫
          tildeSelf.hom) = _
    rw [← Functor.map_comp_assoc, hmap]
    rfl
  exact SheafKoszulNaturality.exact_of_source_iso em ψ₁ ψ₂ hm q
    (polynomial_coordinate_sheaf_exact A ec g q)

end IndexedCoordinateRing
end PaperVerification.Segre.KoszulCoordinateTransport

end SegreKoszulCoordinateTransport

section SegreWeightedKoszulAffineExactness

/-!
# Actual weighted Koszul exactness on polynomial charts

The local hypotheses are the original finite polynomial quotient and
explicit isomorphisms of the actual source and coefficient sheaves. The
functional and every coefficient multiplication must agree as full maps
under those frames. The conclusion is exactness of the actual weighted
sheaf complex in every positive degree, and then of a global complex
whose restrictions have those properties.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.WeightedKoszulAffineExactness

open CategoryTheory MonoidalCategory AlgebraicGeometry
open WeightedSheafKoszul WeightedKoszulFrames

universe u
variable {K : Type u} [Field K] {n : ℕ}

local notation "P" => LocalRegularKoszul.PolynomialRing K n
local notation "X" => Spec (CommRingCat.of P)

set_option maxHeartbeats 1000000 in
/-- A literal finite polynomial zero scheme supplies exactness of the
actual weighted complex. All changes of frame are genuine sheaf isos,
and compatibility refers to the original maps. -/
theorem polynomial_weighted_exact
    (M L : (X).Modules) (Q : ℕ → (X).Modules)
    (φ : M ⟶ L) (μ : ∀ r, L ⊗ Q (r + 1) ⟶ Q r)
    (eL : L ≅ 𝟙_ (X).Modules) (eQ : ∀ r, Q r ≅ 𝟙_ (X).Modules)
    (hμ : ∀ r, MultiplicationCompatible.{u} (X).sheaf (μ r) eL (eQ (r + 1)) (eQ r))
    (f : Fin n → P)
    [Module.Finite K (P ⧸ LocalRegularKoszul.equationIdeal f)]
    (eM : M ≅ tilde (ModuleCat.of P (Fin n → P)))
    (hφ : @Eq (M ⟶ 𝟙_ (X).Modules)
      (eM.hom ≫ RegularSheafKoszul.tildeFunctional.{u} (R := CommRingCat.of P)
        (ModuleCat.of P (Fin n → P)) (Fintype.linearCombination P f))
      (φ ≫ eL.hom))
    (r : ℕ) :
    (shortComplex.{u} (X).sheaf M L Q φ μ
      (coefficientsCommute_of_frames.{u} (X).sheaf L Q μ eL eQ hμ) r).Exact := by
  have hpoly := RegularSheafKoszul.polynomial_sheaf_koszul_exact.{u}
    (K := K) (n := n) f r
  dsimp (config := { failIfUnchanged := false }) only at hpoly
  apply exact_of_scalar_exact.{u} (X).sheaf M L Q φ μ eL eQ hμ r
  apply SheafKoszulNaturality.exact_of_source_iso.{u} (R := (X).sheaf)
    eM (φ ≫ eL.hom)
    (RegularSheafKoszul.tildeFunctional.{u} (R := CommRingCat.of P)
      (ModuleCat.of P (Fin n → P)) (Fintype.linearCombination P f)) hφ r
  exact hpoly

set_option maxHeartbeats 1000000 in
/-- The same theorem over the actual coordinate ring of an affine chart.
The polynomial presentation is supplied by its genuine ring isomorphism;
the original module and coefficient sheaves remain visible. -/
theorem coordinate_weighted_exact (A : CommRingCat.{u})
    (M L : (Spec A).Modules) (Q : ℕ → (Spec A).Modules)
    (φ : M ⟶ L) (μ : ∀ r, L ⊗ Q (r + 1) ⟶ Q r)
    (eL : L ≅ 𝟙_ (Spec A).Modules) (eQ : ∀ r, Q r ≅ 𝟙_ (Spec A).Modules)
    (hμ : ∀ r, MultiplicationCompatible.{u} (Spec A).sheaf (μ r) eL (eQ (r + 1)) (eQ r))
    (e : P ≃+* A) (f : Fin n → P)
    [Module.Finite K (P ⧸ LocalRegularKoszul.equationIdeal f)]
    (eM : M ≅ tilde (ModuleCat.of A (Fin n → A)))
    (hφ : @Eq (M ⟶ 𝟙_ (Spec A).Modules)
      (eM.hom ≫ RegularSheafKoszul.tildeFunctional.{u} (R := A)
        (ModuleCat.of A (Fin n → A))
        (Fintype.linearCombination A (fun i => e (f i))))
      (φ ≫ eL.hom))
    (r : ℕ) :
    (shortComplex.{u} (Spec A).sheaf M L Q φ μ
      (coefficientsCommute_of_frames.{u} (Spec A).sheaf L Q μ eL eQ hμ) r).Exact := by
  apply exact_of_scalar_exact.{u} (Spec A).sheaf M L Q φ μ eL eQ hμ r
  exact SheafKoszulNaturality.exact_of_source_iso eM (φ ≫ eL.hom)
    (RegularSheafKoszul.tildeFunctional (ModuleCat.of A (Fin n → A))
      (Fintype.linearCombination A (fun i => e (f i)))) hφ r
    (KoszulCoordinateTransport.polynomial_coordinate_sheaf_exact A e f r)

set_option maxHeartbeats 1000000 in
/-- The actual chart-variable index can be used without choosing an
enumeration in the geometric statement or in the sheaf source frame. -/
theorem indexed_coordinate_weighted_exact {ι : Type u} [Fintype ι]
    (A : CommRingCat.{u})
    (M L : (Spec A).Modules) (Q : ℕ → (Spec A).Modules)
    (φ : M ⟶ L) (μ : ∀ r, L ⊗ Q (r + 1) ⟶ Q r)
    (eL : L ≅ 𝟙_ (Spec A).Modules) (eQ : ∀ r, Q r ≅ 𝟙_ (Spec A).Modules)
    (hμ : ∀ r, MultiplicationCompatible.{u} (Spec A).sheaf (μ r) eL (eQ (r + 1)) (eQ r))
    (e : MvPolynomial ι K ≃+* A) (f : ι → MvPolynomial ι K)
    [Module.Finite K (MvPolynomial ι K ⧸ Ideal.span (Set.range f))]
    (eM : M ≅ tilde (ModuleCat.of A (ι → A)))
    (hφ : @Eq (M ⟶ 𝟙_ (Spec A).Modules)
      (eM.hom ≫ RegularSheafKoszul.tildeFunctional.{u} (R := A)
        (ModuleCat.of A (ι → A))
        (Fintype.linearCombination A (fun i => e (f i))))
      (φ ≫ eL.hom))
    (r : ℕ) :
    (shortComplex.{u} (Spec A).sheaf M L Q φ μ
      (coefficientsCommute_of_frames.{u} (Spec A).sheaf L Q μ eL eQ hμ) r).Exact := by
  apply exact_of_scalar_exact.{u} (Spec A).sheaf M L Q φ μ eL eQ hμ r
  exact SheafKoszulNaturality.exact_of_source_iso eM (φ ≫ eL.hom)
    (RegularSheafKoszul.tildeFunctional (ModuleCat.of A (ι → A))
      (Fintype.linearCombination A (fun i => e (f i)))) hφ r
    (KoszulCoordinateTransport.indexed_coordinate_sheaf_exact A e f r)

section Global

variable {Y : Scheme.{u}}

/-- Genuine local weighted exactness on a cover implies exactness of the
original full weighted complex; the local-to-global step concerns its
actual homology, not a separately defined replacement complex. -/
theorem weighted_exact_of_cover (M L : Y.Modules) (Q : ℕ → Y.Modules)
    (φ : M ⟶ L) (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n)
    (hcomm : CoefficientsCommute.{u} Y.sheaf L Q μ)
    {ι : Type*} (U : ι → Y.Opens) (hU : iSup U = ⊤) (r : ℕ)
    (h : ∀ i,
      (shortComplex.{u} (U i).toScheme.sheaf (M.restrict (U i).ι) (L.restrict (U i).ι)
        (fun n => (Q n).restrict (U i).ι)
        ((AlgebraicGeometry.Scheme.Modules.restrictFunctor (U i).ι).map φ)
        (WeightedKoszulRestriction.restrictMultiplication (U i).ι L Q μ)
        (WeightedKoszulRestriction.restrict_coefficientsCommute (U i).ι L Q μ hcomm) r).Exact) :
    (shortComplex.{u} Y.sheaf M L Q φ μ hcomm r).Exact := by
  apply SchemeKoszulLocalExactness.exact_of_open_cover _ U hU
  intro i
  exact WeightedKoszulRestriction.exact_restrict_of_local
    (U i).ι M L Q φ μ hcomm r (h i)

/-- The same descent for actual affine spectrum charts and their original
open immersion maps, using the actual images as the covering opens. -/
theorem weighted_exact_of_openImmersion_cover
    (M L : Y.Modules) (Q : ℕ → Y.Modules)
    (φ : M ⟶ L) (μ : ∀ n, L ⊗ Q (n + 1) ⟶ Q n)
    (hcomm : CoefficientsCommute.{u} Y.sheaf L Q μ)
    {ι : Type*} {Z : ι → Scheme.{u}} (f : ∀ i, Z i ⟶ Y)
    [∀ i, IsOpenImmersion (f i)] (hcover : (⨆ i, (f i).opensRange) = ⊤) (r : ℕ)
    (h : ∀ i,
      (shortComplex.{u} (Z i).sheaf (M.restrict (f i)) (L.restrict (f i))
        (fun n => (Q n).restrict (f i))
        ((AlgebraicGeometry.Scheme.Modules.restrictFunctor (f i)).map φ)
        (WeightedKoszulRestriction.restrictMultiplication (f i) L Q μ)
        (WeightedKoszulRestriction.restrict_coefficientsCommute (f i) L Q μ hcomm) r).Exact) :
    (shortComplex.{u} Y.sheaf M L Q φ μ hcomm r).Exact := by
  apply SchemeKoszulLocalExactness.exact_of_openImmersion_cover _ f hcover
  intro i
  exact WeightedKoszulRestriction.exact_restrict_of_local
    (f i) M L Q φ μ hcomm r (h i)

end Global
