section SegreSheafCoefficientContraction

/-!
# The actual sheaf contraction with coefficients in another sheaf

The sectionwise alternating deletion formula commutes with the genuine
change-of-scalars restrictions. Its transpose under the actual sheafification
adjunction defines a morphism from the genuine exterior-power sheaf to the
genuine tensor product. The full presentation and local wedge formula are
proved, so no unspecified comparison morphism is used.

The construction applies to every commutative ring sheaf, without local
freeness or characteristic assumptions.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.SheafCoefficientContraction

open CategoryTheory MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open scoped TensorProduct BigOperators

universe u v w

section Presheaf

variable {C : Type v} [Category.{w} C]
variable {R : Cᵒᵖ ⥤ CommRingCat.{u}}
variable {M L : PresheafOfModulesOfCommRing.{u} R}

/-- The actual module-valued contraction is compatible with every actual
presheaf restriction, including its change of coefficient ring. -/
def presheafContraction (φ : M ⟶ L) (n : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower (n + 1)).obj M ⟶
      (PresheafOfModulesOfCommRing.exteriorPower n).obj M ⊗ L :=
  PresheafOfModulesOfCommRing.homMk (R := R)
    (M₁ := (PresheafOfModulesOfCommRing.exteriorPower (n + 1)).obj M)
    (M₂ := (PresheafOfModulesOfCommRing.exteriorPower n).obj M ⊗ L)
    (fun U => ModuleCat.ofHom (R := R.obj U)
      (CoefficientContraction.contraction (R := R.obj U)
        (M := M.obj U) (L := L.obj U) (φ.app' U).hom n))
    (fun {U V} f => by
      apply ModuleCat.exteriorPower.hom_ext (R := R.obj U) (M := M.obj U) (n := n + 1)
      apply ModuleCat.AlternatingMap.ext
      intro v
      change CoefficientContraction.contraction (R := R.obj V)
        (M := M.obj V) (L := L.obj V) (φ.app' V).hom n
          (((PresheafOfModulesOfCommRing.exteriorPower (n + 1)).obj M).map f
            (exteriorPower.ιMulti (R.obj U) (n + 1) v)) =
        (((PresheafOfModulesOfCommRing.exteriorPower n).obj M) ⊗ L).map f
          (CoefficientContraction.contraction (R := R.obj U)
        (M := M.obj U) (L := L.obj U) (φ.app' U).hom n
            (exteriorPower.ιMulti (R.obj U) (n + 1) v))
      erw [PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk (n + 1) M f v]
      erw [CoefficientContraction.contraction_ιMulti (R := R.obj V)
        (M := M.obj V) (L := L.obj V) (φ.app' V).hom n
        (fun j => M.map f (v j))]
      erw [CoefficientContraction.contraction_ιMulti (R := R.obj U)
        (M := M.obj U) (L := L.obj U) (φ.app' U).hom n v]
      erw [map_sum ((((PresheafOfModulesOfCommRing.exteriorPower n).obj M ⊗ L).map f).hom)]
      apply Finset.sum_congr rfl
      intro i _
      erw [map_zsmul ((((PresheafOfModulesOfCommRing.exteriorPower n).obj M ⊗ L).map f).hom)]
      congr 1
      erw [PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul,
        PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk,
        ← PresheafOfModulesOfCommRing.naturality_apply φ f]
      rfl)

/-- Every component is the literal algebraic contraction. -/
@[simp] theorem presheafContraction_app (φ : M ⟶ L) (n : ℕ) (U : Cᵒᵖ) :
    (presheafContraction φ n).app' U =
      ModuleCat.ofHom (R := R.obj U)
        (CoefficientContraction.contraction (R := R.obj U)
        (M := M.obj U) (L := L.obj U) (φ.app' U).hom n) := rfl

/-- Naturality in the entire vector and coefficient presheaves. -/
theorem presheafContraction_natural
    {M' L' : PresheafOfModulesOfCommRing.{u} R}
    (f : M ⟶ M') (g : L ⟶ L') (φ : M ⟶ L) (ψ : M' ⟶ L')
    (h : f ≫ ψ = φ ≫ g) (n : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower (n + 1)).map f ≫
        presheafContraction ψ n =
      presheafContraction φ n ≫
        ((PresheafOfModulesOfCommRing.exteriorPower n).map f ⊗ₘ g) := by
  apply PresheafOfModules.hom_ext
  intro U
  apply ModuleCat.hom_ext (R := R.obj U)
  change CoefficientContraction.contraction (R := R.obj U)
        (M := M'.obj U) (L := L'.obj U) (ψ.app' U).hom n ∘ₗ
      exteriorPower.map (n + 1) (f.app' U).hom =
    TensorProduct.map (exteriorPower.map n (f.app' U).hom) (g.app' U).hom ∘ₗ
      CoefficientContraction.contraction (R := R.obj U)
        (M := M.obj U) (L := L.obj U) (φ.app' U).hom n
  apply (CoefficientContraction.contraction_natural (R := R.obj U) _ _ _ _ ?_ n).symm
  exact congrArg (fun η => (η.app' U).hom) h
end Presheaf

section Sheaf

variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})
variable (M L : SheafOfModules.{u} (ringCatSheaf R))

/-- The actual map from sectionwise exterior powers to the underlying
presheaf of the actual exterior-power sheaf. -/
def exteriorUnit (n : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower n).obj M.val ⟶
      ((SheafOfModules.exteriorPower R n).obj M).val :=
  (TauCeti.SheafOfModules.sheafificationForgetAdjunction R).unit.app
      ((PresheafOfModulesOfCommRing.exteriorPower n).obj M.val) ≫
    (SheafOfModules.forget (ringCatSheaf R)).map
      (SheafOfModules.exteriorPowerIso n M).inv

/-- The canonical wedge of actual local sections in the actual exterior sheaf. -/
def wedgeSection (n : ℕ) (U : Cᵒᵖ)
    (v : Fin n → PresheafOfModulesOfCommRing.obj (R := R.obj) M.val U) :
    (((SheafOfModules.exteriorPower R n).obj M).val).obj U :=
  (exteriorUnit R M n).app U (exteriorPower.ιMulti (R.obj.obj U) n v)

/-- The actual tensor of two local sections, using the canonical lax
monoidal map of the inclusion of sheaves into presheaves. -/
def tensorSection (U : Cᵒᵖ) (x : M.val.obj U) (y : L.val.obj U) :
    (M ⊗ L).val.obj U :=
  (Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R)) M L).app U
    (x ⊗ₜ[R.obj.obj U] y)

variable {M L}

/-- The sectionwise contraction is followed by the actual exterior
sheafification map and the actual tensor comparison. -/
def presheafTargetMap (φ : M ⟶ L) (n : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower (n + 1)).obj M.val ⟶
      ((SheafOfModules.exteriorPower R n).obj M ⊗ L).val :=
  presheafContraction φ.val n ≫
    (exteriorUnit R M n ⊗ₘ 𝟙 L.val) ≫
      Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R))
        ((SheafOfModules.exteriorPower R n).obj M) L

/-- The genuine coefficient-valued contraction of exterior-power sheaves. -/
def contraction (φ : M ⟶ L) (n : ℕ) :
    (SheafOfModules.exteriorPower R (n + 1)).obj M ⟶
      (SheafOfModules.exteriorPower R n).obj M ⊗ L :=
  (SheafOfModules.exteriorPowerIso (n + 1) M).hom ≫
    ((TauCeti.SheafOfModules.sheafificationForgetAdjunction R).homEquiv _ _).symm
      (presheafTargetMap R φ n)

/-- The whole sheaf contraction has exactly its prescribed presheaf
presentation; this is the actual adjunction identity. -/
@[reassoc] theorem exteriorUnit_contraction (φ : M ⟶ L) (n : ℕ) :
    exteriorUnit R M (n + 1) ≫
      (SheafOfModules.forget (ringCatSheaf R)).map (contraction R φ n) =
        presheafTargetMap R φ n := by
  let A := TauCeti.SheafOfModules.sheafificationForgetAdjunction R
  let E := SheafOfModules.exteriorPowerIso (n + 1) M
  let f := (A.homEquiv _ _).symm (presheafTargetMap R φ n)
  change A.unit.app _ ≫ (SheafOfModules.forget (ringCatSheaf R)).map E.inv ≫
      (SheafOfModules.forget (ringCatSheaf R)).map (E.hom ≫ f) = _
  rw [Functor.map_comp]
  rw [← Category.assoc
    ((SheafOfModules.forget (ringCatSheaf R)).map E.inv)
    ((SheafOfModules.forget (ringCatSheaf R)).map E.hom)
    ((SheafOfModules.forget (ringCatSheaf R)).map f)]
  rw [← Functor.map_comp, E.inv_hom_id, CategoryTheory.Functor.map_id, Category.id_comp]
  exact (A.homEquiv _ _).apply_symm_apply (presheafTargetMap R φ n)

/-- On every local wedge, the actual sheaf morphism is the full signed
deletion sum with the actual coefficient sections and tensor comparison. -/
theorem contraction_wedgeSection (φ : M ⟶ L) (n : ℕ) (U : Cᵒᵖ)
    (v : Fin (n + 1) → PresheafOfModulesOfCommRing.obj (R := R.obj) M.val U) :
    (contraction R φ n).val.app U (wedgeSection R M (n + 1) U v) =
      ∑ i : Fin (n + 1), (-1 : ℤ) ^ (i : ℕ) •
        tensorSection R ((SheafOfModules.exteriorPower R n).obj M) L U
          (wedgeSection R M n U (i.removeNth v)) (φ.val.app U (v i)) := by
  have h := ConcreteCategory.congr_hom
    (congrArg (fun η => η.app U) (exteriorUnit_contraction R φ n))
      (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v)
  change (contraction R φ n).val.app U (wedgeSection R M (n + 1) U v) =
    (presheafTargetMap R φ n).app U
      (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v) at h
  rw [h]
  change (Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R))
      ((SheafOfModules.exteriorPower R n).obj M) L).app U
        ((exteriorUnit R M n ⊗ₘ 𝟙 L.val).app U
          (CoefficientContraction.contraction (φ.val.app' U).hom n
            (exteriorPower.ιMulti (R.obj.obj U) (n + 1) v))) = _
  erw [CoefficientContraction.contraction_ιMulti (R := R.obj.obj U)
    (φ.val.app' U).hom n v]
  simp only [map_sum, map_zsmul,
    PresheafOfModulesOfCommRing.Monoidal.tensorHom_app,
    ModuleCat.MonoidalCategory.tensorHom_tmul,
    PresheafOfModules.id_app, ConcreteCategory.id_apply,
    tensorSection, wedgeSection]
  apply Finset.sum_congr rfl
  intro i _
  apply congrArg (((-1 : ℤ) ^ (i : ℕ)) • ·)
  apply congrArg ((Functor.LaxMonoidal.μ (SheafOfModules.forget (ringCatSheaf R))
    ((SheafOfModules.exteriorPower R n).obj M) L).app U)
  change TensorProduct.map ((exteriorUnit R M n).app' U).hom LinearMap.id
    (exteriorPower.ιMulti (R.obj.obj U) n (i.removeNth v) ⊗ₜ
      (φ.val.app' U).hom (v i)) = _
  simp only [TensorProduct.map_tmul, LinearMap.id_apply] <;> rfl

end Sheaf

end PaperVerification.Segre.SheafCoefficientContraction

