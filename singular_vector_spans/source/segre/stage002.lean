/-!
# Symmetric powers as homogeneous symmetric polynomials

Multiplication of symmetric-algebra generators identifies the symmetric tensor power of any
module with the homogeneous component of the same degree. Injectivity comes from a left inverse:
the generators act on the symmetric tensors of all degrees by commuting multiplication operators,
so the symmetric algebra acts there as well. For a free module the identification sends the
symmetric tensor basis to the monomial basis. This identifies the quotient-tensor and polynomial
descriptions of symmetric powers, allowing constructions on symmetric tensors to be used
degreewise on the symmetric algebra.

The scalar semiring lies in `Type` because Mathlib's `SymmetricPower R ι M` requires `R` and
`ι` to share a universe, and `Sym[R]^n M` uses `ι = Fin n`. This is also the universe
convention of `Module.Basis.symmetricPower`, used in the basis comparison below.
The module and its basis index type have independent universes.

## Main declarations

* `TauCeti.SymmetricPower.toSymmetricAlgebra` multiplies the generators of a pure symmetric tensor.
* `TauCeti.SymmetricPower.toHomogeneous` restricts multiplication to its homogeneous component.
* `TauCeti.SymmetricPower.equivHomogeneous` is the resulting equivalence.

## References

The multiplication map and its basis comparison are adapted from the closed Tau Ceti PR
https://github.com/TauCetiProject/TauCeti/pull/18162 (feat: construct degreewise PBW
symmetrization).
-/

public section

open scoped TensorProduct

namespace TauCeti.SymmetricPower

open _root_.SymmetricPower

universe v w

variable (R : Type) (M : Type v) [CommSemiring R] [AddCommMonoid M] [Module R M]

private noncomputable def algebraMultilinear (n : ℕ) :
    MultilinearMap R (fun _ : Fin n ↦ M) (SymmetricAlgebra R M) :=
  (MultilinearMap.mkPiAlgebra R (Fin n) (SymmetricAlgebra R M)).compLinearMap
    (fun _ ↦ SymmetricAlgebra.ι R M)

private theorem algebraMultilinear_invariant (n : ℕ) (e : Equiv.Perm (Fin n)) :
    (algebraMultilinear R M n).domDomCongr e = algebraMultilinear R M n := by
  ext m
  exact Equiv.prod_comp e (fun i ↦ SymmetricAlgebra.ι R M (m i))

/-- Multiplication of the canonical generators, descended to the symmetric tensor power. -/
noncomputable def toSymmetricAlgebra (n : ℕ) : Sym[R]^n M →ₗ[R] SymmetricAlgebra R M :=
  lift (algebraMultilinear R M n) (algebraMultilinear_invariant R M n)

/-- A pure symmetric tensor maps to the product of its generators. -/
@[simp]
theorem toSymmetricAlgebra_tprod (n : ℕ) (m : Fin n → M) :
    toSymmetricAlgebra R M n (⨂ₛ[R] i, m i) = ∏ i, SymmetricAlgebra.ι R M (m i) := by
  simp [toSymmetricAlgebra, algebraMultilinear]

/-- Multiplication preserves the degree of a symmetric tensor. -/
theorem toSymmetricAlgebra_mem_homogeneousSubmodule (n : ℕ) (x : Sym[R]^n M) :
    toSymmetricAlgebra R M n x ∈
      TauCeti.SymmetricAlgebra.homogeneousSubmodule R M n := by
  apply LinearMap.apply_mem_of_forall_symmetricPower_tprod
  intro m
  rw [toSymmetricAlgebra_tprod]
  simpa only [List.length_ofFn, List.map_ofFn, List.prod_ofFn, Function.comp_def] using
    TauCeti.SymmetricAlgebra.prod_map_ι_mem_homogeneousSubmodule R M (List.ofFn m)

/-- Multiplication with codomain restricted to the homogeneous component of the same degree. -/
noncomputable def toHomogeneous (n : ℕ) :
    Sym[R]^n M →ₗ[R] TauCeti.SymmetricAlgebra.homogeneousSubmodule R M n :=
  (toSymmetricAlgebra R M n).codRestrict _ (toSymmetricAlgebra_mem_homogeneousSubmodule R M n)

/-- The homogeneous multiplication map has ordinary multiplication as its underlying map. -/
@[simp]
theorem coe_toHomogeneous_apply (n : ℕ) (x : Sym[R]^n M) :
    (toHomogeneous R M n x : SymmetricAlgebra R M) = toSymmetricAlgebra R M n x :=
  (rfl)

/-- The image of multiplication is exactly the homogeneous component of the same degree. -/
theorem range_toSymmetricAlgebra (n : ℕ) :
    LinearMap.range (toSymmetricAlgebra R M n) =
      TauCeti.SymmetricAlgebra.homogeneousSubmodule R M n := by
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact toSymmetricAlgebra_mem_homogeneousSubmodule R M n x
  · rw [TauCeti.SymmetricAlgebra.homogeneousSubmodule_eq_span, Submodule.span_le]
    rintro _ ⟨l, hl, rfl⟩
    subst n
    refine ⟨⨂ₛ[R] i, l.get i, ?_⟩
    rw [toSymmetricAlgebra_tprod]
    simp

/-! ### A left inverse of multiplication

The generators act on the symmetric tensors of all degrees by commuting multiplication
operators, so the symmetric algebra acts there too. Acting on the degree-zero unit tensor and
reading off degree `n` gives a left inverse of multiplication on `Sym[R]^n M`, with no
assumption on `M`. -/

/-- The symmetric tensors of all degrees, on which generators act by multiplication. -/
private abbrev AllDegrees := ∀ k : ℕ, Sym[R]^k M

private noncomputable def shiftComponent (m : M) : (j : ℕ) → AllDegrees R M →ₗ[R] Sym[R]^j M
  | 0 => 0
  | k + 1 => consMul R M k m ∘ₗ LinearMap.proj k

/-- Multiplication by a generator, raising the degree of every symmetric tensor by one. -/
private noncomputable def shiftMul : M →ₗ[R] Module.End R (AllDegrees R M) where
  toFun m := LinearMap.pi (shiftComponent R M m)
  map_add' m m' := by
    ext f j
    cases j <;> simp [shiftComponent]
  map_smul' c m := by
    ext f j
    cases j <;> simp [shiftComponent]

private theorem shiftMul_comm (m m' : M) :
    shiftMul R M m * shiftMul R M m' = shiftMul R M m' * shiftMul R M m := by
  ext f j
  rcases j with _ | _ | k
  · simp [shiftMul, shiftComponent]
  · simp [shiftMul, shiftComponent]
  · simp [shiftMul, shiftComponent, consMul_comm]

private theorem shiftMul_single (m : M) (k : ℕ) (x : Sym[R]^k M) :
    shiftMul R M m (Pi.single (M := fun k ↦ Sym[R]^k M) k x) =
      Pi.single (M := fun k ↦ Sym[R]^k M) (k + 1) (consMul R M k m x) := by
  funext j
  rcases j with _ | j
  · simp [shiftMul, shiftComponent]
  · by_cases h : j = k
    · subst h
      simp [shiftMul, shiftComponent]
    · simp [shiftMul, shiftComponent, Pi.single_eq_of_ne h,
        Pi.single_eq_of_ne (Nat.succ_ne_succ_iff.mpr h)]

private noncomputable def shiftMulAdjoin :
    M →ₗ[R] Algebra.adjoin R (Set.range (shiftMul R M)) :=
  (shiftMul R M).codRestrict (Subalgebra.toSubmodule (Algebra.adjoin R (Set.range (shiftMul R M))))
    fun m ↦ Algebra.subset_adjoin (Set.mem_range_self m)

open scoped IsMulCommutative in
/-- Generators act on symmetric tensors of all degrees by commuting multiplication operators. -/
private noncomputable def shiftAlgHom :
    SymmetricAlgebra R M →ₐ[R] Algebra.adjoin R (Set.range (shiftMul R M)) :=
  haveI := Algebra.isMulCommutative_adjoin R (s := Set.range (shiftMul R M)) <| by
    rintro _ ⟨m, rfl⟩ _ ⟨m', rfl⟩ -
    exact shiftMul_comm R M m m'
  SymmetricAlgebra.lift (shiftMulAdjoin R M)

private theorem coe_shiftAlgHom_ι (m : M) :
    (shiftAlgHom R M (SymmetricAlgebra.ι R M m) : Module.End R (AllDegrees R M)) =
      shiftMul R M m := by
  simp only [shiftAlgHom, SymmetricAlgebra.lift_ι_apply]
  rfl

/-- The degree-zero unit tensor, on which the generators act. -/
private noncomputable def unitTensor : AllDegrees R M :=
  Pi.single (M := fun k ↦ Sym[R]^k M) 0 (⨂ₛ[R] i : Fin 0, (isEmptyElim i : M))

private theorem shiftAlgHom_prod_ι_unitTensor (n : ℕ) (m : Fin n → M) :
    (shiftAlgHom R M (∏ i, SymmetricAlgebra.ι R M (m i)) : Module.End R (AllDegrees R M))
        (unitTensor R M) =
      Pi.single (M := fun k ↦ Sym[R]^k M) n (⨂ₛ[R] i, m i) := by
  induction n with
  | zero => simp [unitTensor, Subsingleton.elim m isEmptyElim]
  | succ n ih =>
    rw [Fin.prod_univ_succ, map_mul, Subalgebra.coe_mul, Module.End.mul_apply, ih,
      coe_shiftAlgHom_ι, shiftMul_single, consMul_tprod, ← Fin.tail_def, Fin.cons_self_tail]

/-- Extraction of the degree-`n` symmetric tensor from the symmetric algebra: a left inverse of
multiplication. -/
private noncomputable def ofSymmetricAlgebra (n : ℕ) :
    SymmetricAlgebra R M →ₗ[R] Sym[R]^n M :=
  LinearMap.proj n ∘ₗ LinearMap.applyₗ (unitTensor R M) ∘ₗ
    (Algebra.adjoin R (Set.range (shiftMul R M))).val.toLinearMap ∘ₗ
      (shiftAlgHom R M).toLinearMap

private theorem ofSymmetricAlgebra_comp_toSymmetricAlgebra (n : ℕ) :
    ofSymmetricAlgebra R M n ∘ₗ toSymmetricAlgebra R M n = LinearMap.id := by
  refine SymmetricPower.ext fun m ↦ ?_
  simp [ofSymmetricAlgebra, shiftAlgHom_prod_ι_unitTensor]

variable {R M}

variable (R M) in
/-- Multiplication identifies the symmetric tensor basis with the homogeneous monomial basis. -/
theorem toSymmetricAlgebra_symmetricPower_apply {κ : Type w} (b : Module.Basis κ R M)
    (n : ℕ) (s : Sym κ n) :
    toSymmetricAlgebra R M n (b.symmetricPower n s) =
      (b.symmetricAlgebraHomogeneous n s : SymmetricAlgebra R M) := by
  classical
  obtain ⟨f, rfl⟩ := TauCeti.Sym.ofFn_surjective s
  rw [Module.Basis.symmetricPower_apply, tprodOfSym_ofFn, toSymmetricAlgebra_tprod]
  apply (SymmetricAlgebra.equivMvPolynomial b).injective
  rw [map_prod, TauCeti.SymmetricAlgebra.equivMvPolynomial_symmetricAlgebraHomogeneous_apply]
  simp only [SymmetricAlgebra.equivMvPolynomial_ι_apply]
  rw [← List.prod_ofFn]
  have hexp : (_root_.Sym.equivFinsuppDegree κ n (TauCeti.Sym.ofFn f)).1 =
      (List.ofFn f : Multiset κ).toFinsupp := by
    rw [_root_.Sym.coe_equivFinsuppDegree_apply, TauCeti.Sym.coe_ofFn]
  rw [hexp]
  simpa only [Multiset.map_coe, Multiset.prod_coe, List.map_ofFn, Function.comp_def] using
    TauCeti.prod_map_X_eq_monomial (R := R) (List.ofFn f : Multiset κ)

/-- Multiplication embeds the symmetric tensor power of any module into its symmetric algebra,
over any commutative semiring. -/
theorem toSymmetricAlgebra_injective (n : ℕ) :
    Function.Injective (toSymmetricAlgebra R M n) :=
  Function.LeftInverse.injective (g := ofSymmetricAlgebra R M n)
    (LinearMap.congr_fun (ofSymmetricAlgebra_comp_toSymmetricAlgebra R M n))

/-- The symmetric tensor power of a module is canonically its degree-`n` homogeneous
symmetric-algebra component. -/
noncomputable def equivHomogeneous (n : ℕ) :
    Sym[R]^n M ≃ₗ[R] TauCeti.SymmetricAlgebra.homogeneousSubmodule R M n := by
  refine LinearEquiv.ofBijective (toHomogeneous R M n) ⟨?_, ?_⟩
  · intro x y h
    exact toSymmetricAlgebra_injective n (congrArg Subtype.val h)
  · intro p
    obtain ⟨x, hx⟩ := (range_toSymmetricAlgebra R M n).ge p.property
    exact ⟨x, Subtype.ext hx⟩

/-- The homogeneous equivalence has multiplication as its underlying map. -/
@[simp]
theorem coe_equivHomogeneous_apply (n : ℕ) (x : Sym[R]^n M) :
    (equivHomogeneous (R := R) (M := M) n x : SymmetricAlgebra R M) =
      toSymmetricAlgebra R M n x :=
  (rfl)

/-- The linear map underlying the homogeneous equivalence is homogeneous multiplication. -/
@[simp]
theorem toLinearMap_equivHomogeneous (n : ℕ) :
    (equivHomogeneous (R := R) (M := M) n).toLinearMap = toHomogeneous R M n := by
  rfl

/-- The homogeneous equivalence sends a pure symmetric tensor to its product of generators. -/
@[simp]
theorem equivHomogeneous_tprod (n : ℕ) (m : Fin n → M) :
    equivHomogeneous (R := R) (M := M) n (⨂ₛ[R] i, m i) =
      ⟨∏ i, SymmetricAlgebra.ι R M (m i), by
        simpa only [toSymmetricAlgebra_tprod] using
          toSymmetricAlgebra_mem_homogeneousSubmodule R M n (⨂ₛ[R] i, m i)⟩ := by
  apply Subtype.ext
  exact toSymmetricAlgebra_tprod R M n m

/-- The inverse homogeneous equivalence sends a product of generators to its pure tensor. -/
@[simp]
theorem equivHomogeneous_symm_prod_ι (n : ℕ) (m : Fin n → M)
    (h : ∏ i, SymmetricAlgebra.ι R M (m i) ∈
      TauCeti.SymmetricAlgebra.homogeneousSubmodule R M n) :
    (equivHomogeneous (R := R) (M := M) n).symm ⟨∏ i, SymmetricAlgebra.ι R M (m i), h⟩ =
      ⨂ₛ[R] i, m i := by
  apply (equivHomogeneous (R := R) (M := M) n).injective
  simp only [LinearEquiv.apply_symm_apply, equivHomogeneous_tprod]

end TauCeti.SymmetricPower
end
end ProbeLayer26

section ProbeLayer27



/-!
# The symmetric-power realization of every Segre homogeneous piece

The paper writes the degree-q component as a tensor product of actual
symmetric powers. This file identifies that tensor product with the complete
balanced polynomial component, in every degree. The equivalence is proved to
be the canonical map multiplying the polynomials in disjoint factor variables;
it is not an arbitrary isomorphism chosen from a dimension count.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.SymmetricRealization

open Staircase Monomials Balanced HigherPieces MvPolynomial Module
open scoped TensorProduct

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

abbrev BalancedExponent (q : ℕ) :=
  {a : Variables n →₀ ℕ // Finsupp.weight (factorWeight (n := n)) a = diagonalDegree q}

abbrev FactorExponent (q : ℕ) :=
  ∀ i : I, {a : Fin (n i+1) →₀ ℕ // a.degree=q}

/-- Concatenate exponent vectors in the disjoint factor-variable blocks. -/
noncomputable def assembleExponent (q : ℕ) (a : FactorExponent (n := n) q) :
    BalancedExponent (n := n) q :=
  ⟨Finsupp.sigmaFinsuppEquivPiFinsupp.symm (fun i => (a i).val),by
    funext i
    rw [factorWeight_apply]
    change (∑ j : Fin (n i+1), (a i).val j)=q
    simpa only [Finsupp.degree_eq_sum] using (a i).property⟩

@[simp] theorem assembleExponent_apply (q : ℕ) (a : FactorExponent (n := n) q)
    (i : I) (j : Fin (n i+1)) : (assembleExponent q a).val ⟨i,j⟩=(a i).val j := rfl

/-- Read the factor degrees from a balanced exponent vector. -/
noncomputable def splitExponent (q : ℕ) (a : BalancedExponent (n := n) q) :
    FactorExponent (n := n) q := fun i =>
  ⟨Finsupp.sigmaFinsuppEquivPiFinsupp a.val i,by
    have h := congrFun a.property i
    rw [factorWeight_apply] at h
    simpa only [Finsupp.degree_eq_sum,Finsupp.sigmaFinsuppEquivPiFinsupp_apply,diagonalDegree] using h⟩

noncomputable def exponentEquiv (q : ℕ) :
    FactorExponent (n := n) q ≃ BalancedExponent (n := n) q where
  toFun := assembleExponent q
  invFun := splitExponent q
  left_inv a := by
    funext i
    apply Subtype.ext
    ext j
    rfl
  right_inv a := by
    apply Subtype.ext
    ext z
    cases z
    rfl

/-- The monomial basis of the entire balanced homogeneous component. -/
noncomputable def balancedBasis (q : ℕ) :
    Basis (BalancedExponent (n := n) q) K (piece (K := K) (n := n) q) :=
  (basisRestrictSupport K {a | Finsupp.weight (factorWeight (n := n)) a = diagonalDegree q}).map
    (LinearEquiv.ofEq _ _ (by
      rw [piece_eq_balanced,weightedHomogeneousSubmodule_eq_finsupp_supported]
      rfl))

@[simp] theorem balancedBasis_value (q : ℕ) (a : BalancedExponent (n := n) q) :
    (balancedBasis (K := K) q a).val=monomial a.val 1 := by
  simp only [balancedBasis,Basis.map_apply,LinearEquiv.coe_ofEq_apply]
  exact basisRestrictSupport_apply_coe (R := K)
    (s := {a : Variables n →₀ ℕ | Finsupp.weight (factorWeight (n := n)) a = diagonalDegree q}) a

/-- The tensor product of the usual factor-polynomial homogeneous spaces. -/
abbrev PolynomialTensor (q : ℕ) :=
  ⨂[K] i : I, MvPolynomial.homogeneousSubmodule (Fin (n i+1)) K q

noncomputable def polynomialTensorBasis (q : ℕ) :
    Basis (FactorExponent (n := n) q) K (PolynomialTensor (K := K) (n := n) q) :=
  Basis.piTensorProduct (fun i : I => TauCeti.homogeneousMonomialBasis (σ := Fin (n i+1)) (R := K) q)

/-- Basis-level equivalence; the next results identify its underlying map. -/
noncomputable def polynomialTensorEquiv (q : ℕ) :
    PolynomialTensor (K := K) (n := n) q ≃ₗ[K] piece (K := K) (n := n) q :=
  (polynomialTensorBasis (K := K) q).equiv (balancedBasis q) (exponentEquiv q)

noncomputable def factorPolynomialMap (q : ℕ) (i : I) :
    MvPolynomial.homogeneousSubmodule (Fin (n i+1)) K q →ₗ[K]
      MvPolynomial (Variables n) K :=
  (MvPolynomial.rename (Sigma.mk i)).toLinearMap.comp
    (MvPolynomial.homogeneousSubmodule (Fin (n i+1)) K q).subtype

noncomputable def polynomialProductMap (q : ℕ) :
    PolynomialTensor (K := K) (n := n) q →ₗ[K] MvPolynomial (Variables n) K :=
  PiTensorProduct.lift ((MultilinearMap.mkPiAlgebra K I (MvPolynomial (Variables n) K)).compLinearMap
    (factorPolynomialMap q))

@[simp] theorem polynomialProductMap_tprod (q : ℕ)
    (p : ∀ i : I, MvPolynomial.homogeneousSubmodule (Fin (n i+1)) K q) :
    polynomialProductMap (K := K) q (PiTensorProduct.tprod K p)=
      ∏ i, MvPolynomial.rename (Sigma.mk i) (p i).val := by
  rw [polynomialProductMap,PiTensorProduct.lift.tprod]
  rfl

theorem assembleExponent_eq_sum (q : ℕ) (a : FactorExponent (n := n) q) :
    (assembleExponent q a).val = ∑ i, ((a i).val.mapDomain (Sigma.mk i)) := by
  classical
  ext z
  obtain ⟨i,j⟩ := z
  rw [Finsupp.finsetSum_apply,Finset.sum_eq_single i]
  · exact (Finsupp.mapDomain_apply_of_injective
      (f := fun j : Fin (n i+1) => (⟨i,j⟩ : Variables n))
      (sigma_mk_injective (β := fun i : I => Fin (n i + 1)) (i := i))
      (a i).val j).symm
  · intro k _ hki
    apply Finsupp.mapDomain_of_notMem_range
    rintro ⟨l,he⟩
    exact hki (congrArg Sigma.fst he)
  · simp

/-- The image of a pure tensor of factor monomials is the actual joint monomial. -/
theorem polynomialProductMap_basis (q : ℕ) (a : FactorExponent (n := n) q) :
    polynomialProductMap (K := K) q (polynomialTensorBasis q a) =
      monomial (assembleExponent q a).val 1 := by
  rw [polynomialTensorBasis,Basis.piTensorProduct_apply,polynomialProductMap_tprod]
  simp only [TauCeti.coe_homogeneousMonomialBasis,MvPolynomial.rename_monomial]
  rw [assembleExponent_eq_sum,MvPolynomial.monomial_sum_one]

/-- The degreewise equivalence is exactly the canonical product map. -/
theorem polynomialTensorEquiv_value (q : ℕ) (p : PolynomialTensor (K := K) (n := n) q) :
    (polynomialTensorEquiv q p).val=polynomialProductMap q p := by
  have h : (piece (K := K) (n := n) q).subtype.comp (polynomialTensorEquiv q).toLinearMap =
      polynomialProductMap q := by
    apply (polynomialTensorBasis (K := K) q).ext
    intro a
    change (polynomialTensorEquiv q (polynomialTensorBasis q a)).val = _
    rw [polynomialTensorEquiv,Basis.equiv_apply,balancedBasis_value,polynomialProductMap_basis]
    rfl
  exact LinearMap.congr_fun h p

@[simp] theorem polynomialTensorEquiv_tprod (q : ℕ)
    (p : ∀ i : I, MvPolynomial.homogeneousSubmodule (Fin (n i+1)) K q) :
    (polynomialTensorEquiv (K := K) q (PiTensorProduct.tprod K p)).val =
      ∏ i, MvPolynomial.rename (Sigma.mk i) (p i).val := by
  rw [polynomialTensorEquiv_value,polynomialProductMap_tprod]

section SymmetricPowers

/- Mathlib's symmetric powers indexed by `Fin q` use a small coefficient
universe. No cardinal, characteristic or dimension restriction is imposed. -/
variable {F : Type} [Field F]

/-- The actual symmetric tensor power of the i-th vector-space factor. -/
abbrev FactorSymmetric (q : ℕ) (i : I) := Sym[F]^q (Fin (n i+1) → F)

/-- The component displayed in the paper, using actual symmetric quotient tensors. -/
abbrev SymmetricTensor (q : ℕ) := ⨂[F] i : I, FactorSymmetric (F := F) (n := n) q i

noncomputable def factorSymmetricEquiv (q : ℕ) (i : I) :
    FactorSymmetric (F := F) (n := n) q i ≃ₗ[F]
      MvPolynomial.homogeneousSubmodule (Fin (n i+1)) F q :=
  (TauCeti.SymmetricPower.equivHomogeneous (R := F) (M := Fin (n i+1) → F) q).trans
    (TauCeti.SymmetricAlgebra.homogeneousSubmoduleEquivMvPolynomial
      F (Fin (n i+1) → F) (Pi.basisFun F (Fin (n i+1))) q)

/-- The factor comparison is the usual map from the symmetric algebra into
coordinate polynomials, restricted to its homogeneous component. -/
theorem factorSymmetricEquiv_value (q : ℕ) (i : I)
    (x : FactorSymmetric (F := F) (n := n) q i) :
    (factorSymmetricEquiv q i x).val =
      SymmetricAlgebra.equivMvPolynomial (Pi.basisFun F (Fin (n i+1)))
        (TauCeti.SymmetricPower.toSymmetricAlgebra F (Fin (n i+1) → F) q x) := by
  simp only [factorSymmetricEquiv,LinearEquiv.trans_apply,
    TauCeti.SymmetricAlgebra.coe_homogeneousSubmoduleEquivMvPolynomial_apply,
    TauCeti.SymmetricPower.coe_equivHomogeneous_apply]

/-- Every degree of the paper's tensor-symmetric-power Segre ring agrees with
its literal balanced polynomial realization. -/
noncomputable def symmetricTensorEquiv (q : ℕ) :
    SymmetricTensor (F := F) (n := n) q ≃ₗ[F] piece (K := F) (n := n) q :=
  (PiTensorProduct.congr (factorSymmetricEquiv (F := F) (n := n) q)).trans
    (polynomialTensorEquiv q)

/-- The map on pure tensor products multiplies the actual homogeneous factor
polynomials in their disjoint coordinate-variable sets. -/
theorem symmetricTensorEquiv_tprod (q : ℕ)
    (p : ∀ i : I, FactorSymmetric (F := F) (n := n) q i) :
    (symmetricTensorEquiv q (PiTensorProduct.tprod F p)).val =
      ∏ i, MvPolynomial.rename (Sigma.mk i) (factorSymmetricEquiv q i (p i)).val := by
  rw [symmetricTensorEquiv,LinearEquiv.trans_apply,PiTensorProduct.congr_tprod,
    polynomialTensorEquiv_tprod]

/-- The ordinary product between two homogeneous polynomial components. -/
noncomputable def factorHomogeneousMul (p q : ℕ) (i : I) :
    MvPolynomial.homogeneousSubmodule (Fin (n i+1)) F p →ₗ[F]
      MvPolynomial.homogeneousSubmodule (Fin (n i+1)) F q →ₗ[F]
        MvPolynomial.homogeneousSubmodule (Fin (n i+1)) F (p+q) where
  toFun x :=
    { toFun := fun y => ⟨x.val*y.val,x.property.mul y.property⟩
      map_add' := fun y z => Subtype.ext (mul_add _ _ _)
      map_smul' := fun c y => Subtype.ext (mul_smul_comm _ _ _) }
  map_add' x y := by
    apply LinearMap.ext
    intro z
    exact Subtype.ext (add_mul _ _ _)
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (smul_mul_assoc _ _ _)

/-- Multiplication in a symmetric algebra, restricted to actual symmetric
powers through the proved canonical homogeneous-component equivalence. -/
noncomputable def factorSymmetricMul (p q : ℕ) (i : I) :
    FactorSymmetric (F := F) (n := n) p i →ₗ[F]
      FactorSymmetric (F := F) (n := n) q i →ₗ[F]
        FactorSymmetric (F := F) (n := n) (p+q) i :=
  ((factorHomogeneousMul p q i).compl₁₂ (factorSymmetricEquiv p i).toLinearMap
    (factorSymmetricEquiv q i).toLinearMap).compr₂
      (factorSymmetricEquiv (p+q) i).symm.toLinearMap

@[simp] theorem factorSymmetricEquiv_mul (p q : ℕ) (i : I)
    (x : FactorSymmetric (F := F) (n := n) p i)
    (y : FactorSymmetric (F := F) (n := n) q i) :
    (factorSymmetricEquiv (p+q) i (factorSymmetricMul p q i x y)).val =
      (factorSymmetricEquiv p i x).val * (factorSymmetricEquiv q i y).val := by
  simp only [factorSymmetricMul,LinearMap.compr₂_apply,LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe,LinearEquiv.apply_symm_apply]
  rfl

/-- The multiplication just defined is the ordinary multiplication of the
symmetric algebra, with no change of the paper's algebra structure. -/
theorem factorSymmetricMul_toSymmetricAlgebra (p q : ℕ) (i : I)
    (x : FactorSymmetric (F := F) (n := n) p i)
    (y : FactorSymmetric (F := F) (n := n) q i) :
    TauCeti.SymmetricPower.toSymmetricAlgebra F (Fin (n i+1) → F) (p+q)
        (factorSymmetricMul p q i x y) =
      TauCeti.SymmetricPower.toSymmetricAlgebra F (Fin (n i+1) → F) p x *
        TauCeti.SymmetricPower.toSymmetricAlgebra F (Fin (n i+1) → F) q y := by
  apply (SymmetricAlgebra.equivMvPolynomial (Pi.basisFun F (Fin (n i+1)))).injective
  rw [map_mul,← factorSymmetricEquiv_value (p+q) i,
    ← factorSymmetricEquiv_value p i,← factorSymmetricEquiv_value q i,
    factorSymmetricEquiv_mul]

/-- Componentwise multiplication of the tensor factors, extended bilinearly
by the universal property of the tensor product. -/
noncomputable def tensorMul (p q : ℕ) :
    SymmetricTensor (F := F) (n := n) p →ₗ[F]
      SymmetricTensor (F := F) (n := n) q →ₗ[F]
        SymmetricTensor (F := F) (n := n) (p+q) :=
  PiTensorProduct.map₂ (factorSymmetricMul p q)

/-- The canonical degreewise equivalence respects the paper's componentwise
symmetric-power multiplication in every pair of degrees. -/
theorem symmetricTensorEquiv_mul (p q : ℕ)
    (x : SymmetricTensor (F := F) (n := n) p)
    (y : SymmetricTensor (F := F) (n := n) q) :
    (symmetricTensorEquiv (p+q) (tensorMul p q x y)).val =
      (symmetricTensorEquiv p x).val * (symmetricTensorEquiv q y).val := by
  let e (d : ℕ) : SymmetricTensor (F := F) (n := n) d →ₗ[F] MvPolynomial (Variables n) F :=
    (piece (K := F) (n := n) d).subtype.comp (symmetricTensorEquiv d).toLinearMap
  have he : (tensorMul (F := F) (n := n) p q).compr₂ (e (p+q)) =
      (LinearMap.mul F (MvPolynomial (Variables n) F)).compl₁₂ (e p) (e q) := by
    apply PiTensorProduct.ext
    apply MultilinearMap.ext
    intro a
    apply PiTensorProduct.ext
    apply MultilinearMap.ext
    intro b
    change (symmetricTensorEquiv (p+q)
      (tensorMul p q (PiTensorProduct.tprod F a) (PiTensorProduct.tprod F b))).val =
        (symmetricTensorEquiv p (PiTensorProduct.tprod F a)).val *
          (symmetricTensorEquiv q (PiTensorProduct.tprod F b)).val
    rw [tensorMul,PiTensorProduct.map₂_tprod_tprod]
    simp only [symmetricTensorEquiv_tprod,factorSymmetricEquiv_mul,map_mul]
    exact Finset.prod_mul_distrib
  exact LinearMap.congr_fun (LinearMap.congr_fun he x) y

end SymmetricPowers

end PaperVerification.Segre.SymmetricRealization
end
end ProbeLayer27

section ProbeLayer28



/-!
# The full graded-algebra correspondence with the paper's Segre ring

The external direct sum of tensor symmetric powers is endowed with its
componentwise symmetric-algebra multiplication. The canonical product of
factor polynomials gives an algebra isomorphism onto the literal Segre
subalgebra used throughout the formalization. All degrees are included.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

@[expose] public section

namespace PaperVerification.Segre.SymmetricRealization

open Staircase Monomials Balanced HigherPieces MvPolynomial Module
open scoped TensorProduct DirectSum

variable {I : Type*} [Fintype I] [DecidableEq I] {n : I → ℕ}
variable {F : Type} [Field F]

instance piece_gradedMonoid : SetLike.GradedMonoid (piece (K := F) (n := n)) where
  one_mem := by
    rw [piece_eq_balanced]
    exact isWeightedHomogeneous_one F _
  mul_mem p q x y hx hy := by
    rw [piece_eq_balanced,mem_weightedHomogeneousSubmodule] at hx hy ⊢
    simpa only [← diagonalDegree_add] using hx.mul hy

noncomputable def scalarPiece : F →ₗ[F] piece (K := F) (n := n) 0 where
  toFun c := ⟨MvPolynomial.C c,by
    rw [piece_eq_balanced]
    exact isWeightedHomogeneous_C _ _⟩
  map_add' x y := Subtype.ext (map_add MvPolynomial.C x y)
  map_smul' c x := by
    apply Subtype.ext
    change MvPolynomial.C (c*x)=c • MvPolynomial.C x
    rw [MvPolynomial.smul_eq_C_mul,map_mul]

@[simp] theorem scalarPiece_value (c : F) : (scalarPiece (n := n) c).val=MvPolynomial.C c := rfl

noncomputable instance tensorGMul : GradedMonoid.GMul (SymmetricTensor (F := F) (n := n)) where
  mul := fun {p q} x y => tensorMul p q x y

noncomputable instance tensorGOne : GradedMonoid.GOne (SymmetricTensor (F := F) (n := n)) where
  one := (symmetricTensorEquiv 0).symm (scalarPiece 1)

noncomputable def gradedRealization :
    GradedMonoid (SymmetricTensor (F := F) (n := n)) ≃
      GradedMonoid (fun q => piece (K := F) (n := n) q) :=
  Equiv.sigmaCongrRight (fun q => (symmetricTensorEquiv q).toEquiv)

@[simp] theorem gradedRealization_mul
    (x y : GradedMonoid (SymmetricTensor (F := F) (n := n))) :
    gradedRealization (x*y)=gradedRealization x*gradedRealization y := by
  apply Sigma.subtype_ext
  · rfl
  · change (symmetricTensorEquiv (x.1+y.1) (tensorMul x.1 y.1 x.2 y.2)).val=
      (symmetricTensorEquiv x.1 x.2).val*(symmetricTensorEquiv y.1 y.2).val
    exact symmetricTensorEquiv_mul x.1 y.1 x.2 y.2

@[simp] theorem gradedRealization_one :
    gradedRealization (1 : GradedMonoid (SymmetricTensor (F := F) (n := n)))=1 := by
  apply Sigma.subtype_ext
  · rfl
  · change (symmetricTensorEquiv 0 ((symmetricTensorEquiv 0).symm (scalarPiece 1))).val=1
    rw [LinearEquiv.apply_symm_apply]
    exact map_one MvPolynomial.C

@[simp] theorem gradedRealization_smul (c : F)
    (x : GradedMonoid (SymmetricTensor (F := F) (n := n))) :
    gradedRealization (c • x)=c • gradedRealization x := by
  apply Sigma.subtype_ext
  · rfl
  · change (symmetricTensorEquiv x.1 (c • x.2)).val=
      c • (symmetricTensorEquiv x.1 x.2).val
    rw [map_smul]
    rfl

noncomputable instance tensorGCommMonoid :
    GradedMonoid.GCommMonoid (SymmetricTensor (F := F) (n := n)) where
  one_mul x := by
    apply gradedRealization.injective
    rw [gradedRealization_mul,gradedRealization_one,one_mul]
  mul_one x := by
    apply gradedRealization.injective
    rw [gradedRealization_mul,gradedRealization_one,mul_one]
  mul_assoc x y z := by
    apply gradedRealization.injective
    simp only [gradedRealization_mul,mul_assoc]
  mul_comm x y := by
    apply gradedRealization.injective
    rw [gradedRealization_mul,gradedRealization_mul,mul_comm]

noncomputable instance tensorGNonUnitalNonAssocSemiring :
    DirectSum.GNonUnitalNonAssocSemiring (SymmetricTensor (F := F) (n := n)) where
  mul_zero x := (tensorMul _ _ x).map_zero
  zero_mul y := LinearMap.congr_fun (tensorMul _ _).map_zero y
  mul_add x y z := (tensorMul _ _ x).map_add y z
  add_mul x y z := LinearMap.congr_fun ((tensorMul _ _).map_add x y) z

noncomputable instance tensorGSemiring :
    DirectSum.GSemiring (SymmetricTensor (F := F) (n := n)) where
  natCast k := (symmetricTensorEquiv 0).symm (scalarPiece (k : F))
  natCast_zero := by simp only [Nat.cast_zero,map_zero]
  natCast_succ k := by
    change (symmetricTensorEquiv 0).symm (scalarPiece ((k+1 : ℕ) : F)) =
      (symmetricTensorEquiv 0).symm (scalarPiece (k : F)) +
        (symmetricTensorEquiv 0).symm (scalarPiece 1)
    rw [Nat.cast_add_one,map_add,map_add]

noncomputable instance tensorGCommSemiring :
    DirectSum.GCommSemiring (SymmetricTensor (F := F) (n := n)) where

noncomputable instance tensorGCommRing :
    DirectSum.GCommRing (SymmetricTensor (F := F) (n := n)) where
  intCast k := (symmetricTensorEquiv 0).symm (scalarPiece (k : F))
  intCast_ofNat k := by
    simp only [Int.cast_natCast] <;> rfl
  intCast_negSucc_ofNat k := by
    simp only [Int.cast_negSucc,map_neg] <;> rfl

/-- The usual scalar inclusion in degree zero. -/
noncomputable instance tensorGAlgebra :
    DirectSum.GAlgebra F (SymmetricTensor (F := F) (n := n)) where
  toFun := ((symmetricTensorEquiv 0).symm.toLinearMap.comp scalarPiece).toAddMonoidHom
  map_one := rfl
  map_mul c d := by
    apply gradedRealization.injective
    apply Sigma.subtype_ext
    · rfl
    · change (symmetricTensorEquiv 0 ((symmetricTensorEquiv 0).symm (scalarPiece (c*d)))).val =
        (symmetricTensorEquiv (0+0) (tensorMul 0 0
          ((symmetricTensorEquiv 0).symm (scalarPiece c))
          ((symmetricTensorEquiv 0).symm (scalarPiece d)))).val
      rw [symmetricTensorEquiv_mul,LinearEquiv.apply_symm_apply,
        LinearEquiv.apply_symm_apply,LinearEquiv.apply_symm_apply]
      exact map_mul MvPolynomial.C c d
  commutes c x := mul_comm _ _
  smul_def c x := by
    apply gradedRealization.injective
    rw [gradedRealization_smul,gradedRealization_mul]
    apply Sigma.subtype_ext (zero_add x.1).symm
    change c • (symmetricTensorEquiv x.1 x.2).val =
      (symmetricTensorEquiv 0 ((symmetricTensorEquiv 0).symm (scalarPiece c))).val *
        (symmetricTensorEquiv x.1 x.2).val
    rw [LinearEquiv.apply_symm_apply]
    exact MvPolynomial.smul_eq_C_mul _ _

/-- Exactly the direct sum displayed in the paper, with the verified
componentwise tensor-symmetric-power algebra structure above. -/
abbrev SymmetricSegre := ⨁ q : ℕ, SymmetricTensor (F := F) (n := n) q

/-- The degreewise comparison extended to the full external direct sum. -/
noncomputable def directSumRealization :
    SymmetricSegre (F := F) (n := n) ≃ₗ[F]
      ⨁ q : ℕ, piece (K := F) (n := n) q :=
  DirectSum.congrLinearEquiv (symmetricTensorEquiv (F := F) (n := n))

@[simp] theorem directSumRealization_of (q : ℕ)
    (x : SymmetricTensor (F := F) (n := n) q) :
    directSumRealization (DirectSum.of (SymmetricTensor (F := F) (n := n)) q x) =
      DirectSum.of (fun q => piece (K := F) (n := n) q) q (symmetricTensorEquiv q x) := by
  simp only [directSumRealization,DirectSum.coe_congrLinearEquiv,DirectSum.lmap_of] <;> rfl

/-- The canonical multiplication map on the full direct sum. -/
noncomputable def realizationMap :
    SymmetricSegre (F := F) (n := n) →ₐ[F] MvPolynomial (Variables n) F :=
  DirectSum.toAlgebra F _
    (fun q => (piece (K := F) (n := n) q).subtype.comp (symmetricTensorEquiv q).toLinearMap)
    (by
      change (symmetricTensorEquiv 0 ((symmetricTensorEquiv 0).symm (scalarPiece 1))).val=1
      rw [LinearEquiv.apply_symm_apply]
      exact map_one MvPolynomial.C)
    (fun {p q} x y => symmetricTensorEquiv_mul p q x y)

@[simp] theorem realizationMap_of (q : ℕ)
    (x : SymmetricTensor (F := F) (n := n) q) :
    realizationMap (DirectSum.of (SymmetricTensor (F := F) (n := n)) q x)=
      (symmetricTensorEquiv q x).val := by
  change DirectSum.toAddMonoid
      (fun p => ((piece (K := F) (n := n) p).subtype.comp
        (symmetricTensorEquiv p).toLinearMap).toAddMonoidHom)
      (DirectSum.of (SymmetricTensor (F := F) (n := n)) q x) =
      (symmetricTensorEquiv q x).val
  exact DirectSum.toAddMonoid_of _ q x

theorem realizationMap_factorization :
    realizationMap.toLinearMap =
      (DirectSum.coeLinearMap (piece (K := F) (n := n))).comp directSumRealization.toLinearMap := by
  apply DirectSum.linearMap_ext
  intro q
  apply LinearMap.ext
  intro x
  change realizationMap (DirectSum.of _ q x) =
    DirectSum.coeLinearMap _ (directSumRealization (DirectSum.of _ q x))
  rw [realizationMap_of,directSumRealization_of,DirectSum.coeLinearMap_of]

theorem realizationMap_range :
    (realizationMap (F := F) (n := n)).range=segreAlgebra (K := F) (n := n) := by
  apply le_antisymm
  · intro z hz
    obtain ⟨x,rfl⟩ := hz
    have hle : (DirectSum.coeLinearMap (piece (K := F) (n := n))).range ≤
        (segreAlgebra (K := F) (n := n)).toSubmodule := by
      rw [DirectSum.range_coeLinearMap]
      apply iSup_le
      intro q
      rw [piece_eq_balanced]
      exact balancedComponent_le_segreAlgebra q
    have hr : realizationMap x ∈
        (DirectSum.coeLinearMap (piece (K := F) (n := n))).range := by
      refine ⟨directSumRealization x,?_⟩
      exact (LinearMap.congr_fun realizationMap_factorization x).symm
    exact hle hr
  · apply Algebra.adjoin_le
    rintro f ⟨u,rfl⟩
    have hm : cellPolynomial (K := F) u ∈ piece (K := F) (n := n) 1 := by
      rw [piece_eq_balanced]
      exact cellPolynomial_homogeneous u
    refine ⟨DirectSum.of _ 1 ((symmetricTensorEquiv 1).symm ⟨cellPolynomial u,hm⟩),?_⟩
    change realizationMap (DirectSum.of (SymmetricTensor (F := F) (n := n)) 1
      ((symmetricTensorEquiv 1).symm ⟨cellPolynomial u,hm⟩)) = cellPolynomial u
    rw [realizationMap_of,LinearEquiv.apply_symm_apply]

/-- Distinct ordinary degrees are distinct multidegrees whenever there is a
factor. This is the exact nonempty-factor hypothesis in the direct-sum map. -/
theorem diagonalDegree_injective [Nonempty I] :
    Function.Injective (diagonalDegree (I := I)) := by
  intro p q hpq
  exact congrFun hpq (Classical.choice (inferInstance : Nonempty I))

theorem realizationMap_injective [Nonempty I] :
    Function.Injective (realizationMap (F := F) (n := n)) := by
  classical
  letI := weightedDecomposition F (factorWeight (n := n))
  have hw : iSupIndep (MvPolynomial.weightedHomogeneousSubmodule F (factorWeight (n := n))) :=
    (DirectSum.Decomposition.isInternal _).submodule_iSupIndep
  have hp : iSupIndep (piece (K := F) (n := n)) := by
    simpa only [Function.comp_def,← piece_eq_balanced] using
      hw.comp (diagonalDegree_injective (I := I))
  have hi : Function.Injective (DirectSum.coeLinearMap (piece (K := F) (n := n))) :=
    hp.dfinsupp_lsum_injective
  intro x y hxy
  apply directSumRealization.injective
  apply hi
  have he := realizationMap_factorization (F := F) (n := n)
  exact (LinearMap.congr_fun he x).symm.trans
    (hxy.trans (LinearMap.congr_fun he y))

/-- The complete canonical graded-algebra realization of the Segre ring
written in the paper as a direct sum of tensor symmetric powers. -/
noncomputable def symmetricSegreEquiv [Nonempty I] :
    SymmetricSegre (F := F) (n := n) ≃ₐ[F] segreAlgebra (K := F) (n := n) :=
  (AlgEquiv.ofInjective realizationMap realizationMap_injective).trans
    (Subalgebra.equivOfEq _ _ realizationMap_range)

@[simp] theorem symmetricSegreEquiv_of [Nonempty I] (q : ℕ)
    (x : SymmetricTensor (F := F) (n := n) q) :
    (symmetricSegreEquiv (DirectSum.of (SymmetricTensor (F := F) (n := n)) q x)).val =
      (symmetricTensorEquiv q x).val := by
  change realizationMap (DirectSum.of _ q x)=_
  exact realizationMap_of q x

end PaperVerification.Segre.SymmetricRealization
end
end ProbeLayer28

section ProbeLayer29



/-!
# Rank-selected connectivity in products of chains

This is the combinatorial baseline for degree-two exactness of the rank-sum
parameters. Between any two distinct ranks, the bipartite comparability graph
is connected. The proof is integral: interpolate ranks by changing one
coordinate, and connect a fixed rank by unit transfers between two coordinates.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.RankConnectivity

open Staircase

variable {I : Type*} [Fintype I] [DecidableEq I] {n : I → ℕ}

theorem rank_update (u : Cell n) (i : I) (a : Fin (n i + 1)) :
    rank (Function.update u i a) + (u i).val = rank u + a.val := by
  have he : (fun j => (Function.update u i a j).val) =
      Function.update (fun j => (u j).val) i a.val := by
    funext j
    by_cases h : j = i
    · subst j
      simp
    · simp [Function.update_of_ne h]
  have h₁ := Finset.sum_update_of_mem (Finset.mem_univ i)
    (fun j => (u j).val) a.val
  have h₂ := Finset.sum_update_of_mem (Finset.mem_univ i)
    (fun j => (u j).val) (u i).val
  simp only [Function.update_eq_self] at h₂
  simp only [rank, he]
  rw [h₁, h₂]
  omega

theorem exists_coordinate_lt (u : Cell n) (h : rank u < sideSum n) :
    ∃ i, (u i).val < n i := by
  by_contra hn
  have he : ∀ i, (u i).val = n i := by
    intro i
    apply le_antisymm (Nat.le_of_lt_succ (u i).isLt)
    exact le_of_not_gt (fun hi => hn ⟨i, hi⟩)
  have hr : rank u = sideSum n := Finset.sum_congr rfl fun i _ => he i
  omega

theorem exists_coordinate_pos (u : Cell n) (h : 0 < rank u) :
    ∃ i, 0 < (u i).val := by
  by_contra hn
  have he : ∀ i, (u i).val = 0 := by
    intro i
    exact Nat.eq_zero_of_not_pos (fun hi => hn ⟨i, hi⟩)
  simp [rank, he] at h

/-- Every intermediate rank occurs above a specified cell. -/
theorem exists_rank_above (u : Cell n) (s : ℕ)
    (hus : rank u ≤ s) (hs : s ≤ sideSum n) :
    ∃ w : Cell n, u ≤ w ∧ rank w = s := by
  suffices h : ∀ d, ∀ v : Cell n, s - rank v = d → rank v ≤ s →
      ∃ w : Cell n, v ≤ w ∧ rank w = s from h _ u rfl hus
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro v hd hv
    by_cases he : rank v = s
    · exact ⟨v, le_rfl, he⟩
    have hvs : rank v < s := lt_of_le_of_ne hv he
    obtain ⟨i, hi⟩ := exists_coordinate_lt v (lt_of_lt_of_le hvs hs)
    let a : Fin (n i + 1) := ⟨(v i).val + 1, by omega⟩
    let v' : Cell n := Function.update v i a
    have hr : rank v' = rank v + 1 := by
      have h := rank_update v i a
      dsimp [v', a] at *
      omega
    have hvv : v ≤ v' := by
      intro j
      by_cases hj : j = i
      · subst j
        simp only [v', Function.update_self]
        exact Nat.le_succ _
      · simp [v', Function.update_of_ne hj]
    obtain ⟨w, hvw, hw⟩ := ih (s - rank v') (by omega) v' rfl (by omega)
    exact ⟨w, hvv.trans hvw, hw⟩

/-- Every intermediate rank occurs below a specified cell. -/
theorem exists_rank_below (u : Cell n) (s : ℕ) (hsu : s ≤ rank u) :
    ∃ w : Cell n, w ≤ u ∧ rank w = s := by
  suffices h : ∀ d, ∀ v : Cell n, rank v - s = d → s ≤ rank v →
      ∃ w : Cell n, w ≤ v ∧ rank w = s from h _ u rfl hsu
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro v hd hv
    by_cases he : rank v = s
    · exact ⟨v, le_rfl, he⟩
    have hsv : s < rank v := lt_of_le_of_ne hv (Ne.symm he)
    obtain ⟨i, hi⟩ := exists_coordinate_pos v (lt_of_le_of_lt (Nat.zero_le s) hsv)
    let a : Fin (n i + 1) := ⟨(v i).val - 1, by have := (v i).isLt; omega⟩
    let v' : Cell n := Function.update v i a
    have hr : rank v' + 1 = rank v := by
      have h := rank_update v i a
      dsimp [v', a] at *
      omega
    have hvv : v' ≤ v := by
      intro j
      by_cases hj : j = i
      · subst j
        simp only [v', Function.update_self]
        exact Nat.sub_le _ _
      · simp [v', Function.update_of_ne hj]
    obtain ⟨w, hwv, hw⟩ := ih (rank v' - s) (by omega) v' rfl (by omega)
    exact ⟨w, hwv.trans hvv, hw⟩

/-- The full interval of ranks from zero through the total chain length occurs. -/
theorem exists_cell_rank (s : ℕ) (hs : s ≤ sideSum n) :
    ∃ u : Cell n, rank u = s := by
  let z : Cell n := fun _ => 0
  have hz : rank z = 0 := by simp [rank, z]
  obtain ⟨u, _, hu⟩ := exists_rank_above z s (by omega) hs
  exact ⟨u, hu⟩

/-- Move one unit from an excessive coordinate to a deficient coordinate.
The rank stays fixed, the join rises by exactly one, and the meet with the
target rises by exactly one. -/
theorem exists_rank_transfer (u v : Cell n) (hr : rank u = rank v) (hne : u ≠ v) :
    ∃ w : Cell n, rank w = rank u ∧
      rank (join u w) = rank u + 1 ∧
      rank (meet w v) = rank (meet u v) + 1 := by
  have hnu : ¬ u ≤ v := fun h => hne (eq_of_le_of_rank_eq h hr)
  have hnv : ¬ v ≤ u := fun h => hne (eq_of_le_of_rank_eq h hr.symm).symm
  obtain ⟨i, hi⟩ := not_forall.mp hnv
  obtain ⟨j, hj⟩ := not_forall.mp hnu
  have hi' : (u i).val < (v i).val := lt_of_not_ge hi
  have hj' : (v j).val < (u j).val := lt_of_not_ge hj
  have hij : i ≠ j := by intro h; subst j; omega
  let a : Fin (n i + 1) := ⟨(u i).val + 1, by have := (v i).isLt; omega⟩
  let b : Fin (n j + 1) := ⟨(u j).val - 1, by have := (u j).isLt; omega⟩
  let z : Cell n := Function.update u i a
  let w : Cell n := Function.update z j b
  have hzi : rank z = rank u + 1 := by
    have h := rank_update u i a
    dsimp [a, z] at *
    omega
  have hzj : z j = u j := Function.update_of_ne hij.symm _ _
  have hwr : rank w = rank u := by
    have h := rank_update z j b
    rw [hzj] at h
    dsimp [b, w] at *
    omega
  have hjoint : join u w = z := by
    funext k
    by_cases hki : k = i
    · subst k
      apply Fin.ext
      simp [join, w, z, Function.update_of_ne hij, a, Fin.val_max] <;> omega
    · by_cases hkj : k = j
      · subst k
        apply Fin.ext
        simp [join, w, z, Function.update_of_ne hij.symm, b, Fin.val_max] <;> omega
      · simp [join, w, z, Function.update_of_ne hki, Function.update_of_ne hkj]
  have hmeet : meet w v = Function.update (meet u v) i a := by
    funext k
    by_cases hki : k = i
    · subst k
      apply Fin.ext
      simp only [meet, w, Function.update_of_ne hij, z, Function.update_self,
        Fin.val_min]
      dsimp [a]
      omega
    · by_cases hkj : k = j
      · subst k
        apply Fin.ext
        simp only [meet, w, Function.update_self, Function.update_of_ne hij.symm,
          Fin.val_min]
        dsimp [b]
        omega
      · simp [meet, w, z, Function.update_of_ne hki, Function.update_of_ne hkj]
  have hm : rank (meet w v) = rank (meet u v) + 1 := by
    rw [hmeet]
    have h := rank_update (meet u v) i a
    have hiu : (meet u v i).val = (u i).val := by
      simp [meet, Fin.val_min, Nat.min_eq_left (Nat.le_of_lt hi')]
    rw [hiu] at h
    change rank (Function.update (meet u v) i a) + (u i).val =
      rank (meet u v) + ((u i).val + 1) at h
    have he : rank (Function.update (meet u v) i a) + (u i).val =
        (rank (meet u v) + 1) + (u i).val := by
      calc
        _ = rank (meet u v) + ((u i).val + 1) := h
        _ = _ := by omega
    exact Nat.add_right_cancel he
  exact ⟨w, hwr, by rw [hjoint, hzi], hm⟩

/-- Any property propagating across one-rank joins propagates throughout a rank
layer. This is connectivity, stated in an induction-friendly form. -/
theorem rankLayer_induction (P : Cell n → Prop) (r : ℕ) (v : Cell n)
    (hv : rank v = r) (hPv : P v)
    (hstep : ∀ u w : Cell n, rank u = r → rank w = r →
      rank (join u w) ≤ r + 1 → P w → P u) :
    ∀ u : Cell n, rank u = r → P u := by
  suffices h : ∀ d, ∀ u : Cell n, r - rank (meet u v) = d → rank u = r → P u by
    intro u hu
    exact h _ u rfl hu
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro u hd hu
    by_cases he : u = v
    · simpa [he] using hPv
    obtain ⟨w, hw, hj, hm⟩ := exists_rank_transfer u v (hu.trans hv.symm) he
    have hmu : rank (meet u v) ≤ r := by simpa [hu] using rank_mono (meet_le_left u v)
    have hmw : rank (meet w v) ≤ r := by simpa [hw, hu] using rank_mono (meet_le_left w v)
    have hPw : P w := ih (r - rank (meet w v)) (by omega) w rfl (hw.trans hu)
    exact hstep u w hu (hw.trans hu) (by omega) hPw

/-- Functions agreeing across comparable vertices of two distinct ranks are
constant on the entire lower rank layer. -/
theorem lower_layer_constant {A : Type*} (f g : Cell n → A) (r s : ℕ)
    (hrs : r < s) (hs : s ≤ sideSum n)
    (hedge : ∀ u v : Cell n, rank u = r → rank v = s → u ≤ v → f u = g v)
    (u v : Cell n) (hu : rank u = r) (hv : rank v = r) : f u = f v := by
  apply rankLayer_induction (fun x => f x = f v) r v hv rfl _ u hu
  intro x y hx hy hxy hfy
  obtain ⟨z, hz, hzr⟩ := exists_rank_above (join x y) s (by omega) hs
  have hxz : x ≤ z := fun i => le_trans (le_max_left _ _) (hz i)
  have hyz : y ≤ z := fun i => le_trans (le_max_right _ _) (hz i)
  exact (hedge x z hx hzr hxz).trans ((hedge y z hy hzr hyz).symm.trans hfy)

/-- The same bipartite connectivity also makes the upper-rank function constant. -/
theorem upper_layer_constant {A : Type*} (f g : Cell n → A) (r s : ℕ)
    (hrs : r < s) (hs : s ≤ sideSum n)
    (hedge : ∀ u v : Cell n, rank u = r → rank v = s → u ≤ v → f u = g v)
    (u v : Cell n) (hu : rank u = s) (hv : rank v = s) : g u = g v := by
  obtain ⟨a, hau, har⟩ := exists_rank_below u r (by omega)
  obtain ⟨b, hbv, hbr⟩ := exists_rank_below v r (by omega)
  exact (hedge a u har hu hau).symm.trans
    ((lower_layer_constant f g r s hrs hs hedge a b har hbr).trans
      (hedge b v hbr hv hbv))

end PaperVerification.Segre.RankConnectivity
end
end ProbeLayer29

section ProbeLayer30



/-!
# The exact linear algebra of degree-two graph multiplication

The square and edge coefficients of multiplication by the linear forms
`∑ᵥ yᵥ` and `∑ᵥ pᵥⱼ yᵥ` are encoded without identifying any independent
coefficients. Eliminating the square coefficients gives an explicit linear
equivalence with the infinitesimal-motion kernel. This is the characteristic-free
linear algebra step in Lemma 4.1 of the Segre paper.

`E` indexes edges and `endpoints` lists their endpoints. No genericity is required
for the equivalence, and no division by two occurs. The identification of this
coefficient map with the degree-two part of the Stanley--Reisner quotient is
separate from this linear algebra result.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GraphKernel

open Matrix
open scoped Matrix

variable {K V I E : Type*} [Field K] [Fintype I]

/-- The coefficient data for one multiplier for each of the `1 + card I` forms. -/
abbrev Coefficients (K V I : Type*) := (V → K) × (V → I → K)

/-- Square coefficients followed by one coefficient for each edge. -/
abbrev QuadraticCoordinates (K V E : Type*) := (V → K) × (E → K)

/-- The actual square and edge formulas obtained by multiplying the forms
`∑ᵥ yᵥ` and `∑ᵥ pᵥⱼ yᵥ` by arbitrary linear forms. -/
def coefficientMap (p : V → I → K) (endpoints : E → V × V) :
    Coefficients K V I →ₗ[K] QuadraticCoordinates K V E where
  toFun z :=
    (fun v => z.1 v + p v ⬝ᵥ z.2 v,
      fun e => z.1 (endpoints e).1 + z.1 (endpoints e).2 +
        p (endpoints e).1 ⬝ᵥ z.2 (endpoints e).2 +
        p (endpoints e).2 ⬝ᵥ z.2 (endpoints e).1)
  map_add' x y := by
    apply Prod.ext
    · funext v
      simp only [Prod.fst_add, Prod.snd_add, Pi.add_apply, dotProduct_add]
      ring
    · funext e
      simp only [Prod.fst_add, Prod.snd_add, Pi.add_apply, dotProduct_add]
      ring
  map_smul' a x := by
    apply Prod.ext
    · funext v
      simp only [Prod.smul_fst, Prod.smul_snd, Pi.smul_apply, dotProduct_smul,
        smul_eq_mul, RingHom.id_apply]
      ring
    · funext e
      simp only [Prod.smul_fst, Prod.smul_snd, Pi.smul_apply, dotProduct_smul,
        smul_eq_mul, RingHom.id_apply]
      ring

/-- The rigidity matrix regarded as a linear map on vertex velocities. -/
def rigidityMap (p : V → I → K) (endpoints : E → V × V) :
    (V → I → K) →ₗ[K] (E → K) where
  toFun u e := (p (endpoints e).1 - p (endpoints e).2) ⬝ᵥ
    (u (endpoints e).1 - u (endpoints e).2)
  map_add' u v := by
    funext e
    simp only [Pi.add_apply, sub_eq_add_neg, neg_add_rev, dotProduct_add,
      dotProduct_neg]
    ring
  map_smul' a u := by
    funext e
    simp only [Pi.smul_apply, ← smul_sub, dotProduct_smul,
      RingHom.id_apply]

/-- The uniquely determined scalar coefficients after the square equations vanish. -/
def completeCoefficients (p u : V → I → K) : Coefficients K V I :=
  (fun v => -(p v ⬝ᵥ u v), u)

/-- After solving the square equations, an edge coefficient is the negative of its
rigidity equation. The identity holds in every characteristic. -/
theorem completed_edge (p u : V → I → K) (endpoints : E → V × V) (e : E) :
    (coefficientMap p endpoints (completeCoefficients p u)).2 e =
      -(rigidityMap p endpoints u e) := by
  simp only [coefficientMap, completeCoefficients, rigidityMap,
    LinearMap.coe_mk, AddHom.coe_mk, sub_dotProduct, dotProduct_sub]
  ring

/-- The square equations determine all scalar coefficients, and the remaining
edge equations are exactly the rigidity equations. -/
theorem coefficientMap_eq_zero_iff
    (p : V → I → K) (endpoints : E → V × V) (z : Coefficients K V I) :
    coefficientMap p endpoints z = 0 ↔
      z = completeCoefficients p z.2 ∧ rigidityMap p endpoints z.2 = 0 := by
  constructor
  · intro hz
    have hs : ∀ v, z.1 v = -(p v ⬝ᵥ z.2 v) := by
      intro v
      have h := congrArg (fun w : QuadraticCoordinates K V E => w.1 v) hz
      exact eq_neg_of_add_eq_zero_left h
    have heq : z = completeCoefficients p z.2 := by
      apply Prod.ext
      · exact funext hs
      · rfl
    refine ⟨heq, ?_⟩
    funext e
    have h := congrArg (fun w : QuadraticCoordinates K V E => w.2 e) hz
    rw [heq, completed_edge] at h
    exact neg_eq_zero.mp h
  · rintro ⟨hz, hu⟩
    have hz' : coefficientMap p endpoints (completeCoefficients p z.2) = 0 := by
      apply Prod.ext
      · funext v
        exact neg_add_cancel _
      · funext e
        rw [completed_edge, hu]
        exact neg_zero
    simpa only [← hz] using hz'

/-- Explicit linear equivalence between the multiplication kernel and the
infinitesimal-motion kernel, with no general-position assumption. -/
def kernelEquiv (p : V → I → K) (endpoints : E → V × V) :
    LinearMap.ker (coefficientMap p endpoints) ≃ₗ[K]
      LinearMap.ker (rigidityMap p endpoints) where
  toFun z := ⟨z.val.2, ((coefficientMap_eq_zero_iff p endpoints z.val).mp z.property).2⟩
  invFun u := ⟨completeCoefficients p u.val,
    (coefficientMap_eq_zero_iff p endpoints _).mpr ⟨rfl, u.property⟩⟩
  left_inv z := by
    apply Subtype.ext
    exact ((coefficientMap_eq_zero_iff p endpoints z.val).mp z.property).1.symm
  right_inv u := rfl
  map_add' x y := rfl
  map_smul' a x := rfl

/-- The multiplication kernel has dimension `rN - ρ`, before quotienting by
Koszul relations. This is the unspecialized kernel formula underlying (5). -/
theorem finrank_multiplication_kernel [Fintype V] [Fintype E]
    (p : V → I → K) (endpoints : E → V × V) :
    Module.finrank K (LinearMap.ker (coefficientMap p endpoints)) =
      Fintype.card V * Fintype.card I -
        Module.finrank K (LinearMap.range (rigidityMap p endpoints)) := by
  rw [(kernelEquiv p endpoints).finrank_eq]
  have h := (rigidityMap p endpoints).finrank_range_add_finrank_ker
  have hd : Module.finrank K (V → I → K) = Fintype.card V * Fintype.card I := by
    simp [Module.finrank_pi_fintype, Module.finrank_pi]
  rw [hd] at h
  exact Nat.eq_sub_of_add_eq' h

end PaperVerification.Segre.GraphKernel
end
end ProbeLayer30

section ProbeLayer31



/-!
# Literal polynomial interpretation of the rigidity coefficient map

The ring in this file is the polynomial ring modulo the ideal generated by
`Xᵤ Xᵥ` for distinct nonadjacent vertices. Thus it is the Stanley--Reisner ring
of the clique complex of the graph, and for a comparability graph it is exactly
the ring of the order complex used in the staircase degeneration.

We prove the square and edge coefficient criterion directly from the monomial
ideal membership theorem. This supplies the quotient interpretation of the
coefficient map without taking that interpretation as an assumption.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GraphQuotient

open Matrix MvPolynomial
open scoped Matrix

variable {K V I : Type*} [Field K] [Fintype V] [Fintype I] [DecidableEq V]

/-- A degree-one polynomial with the specified coefficients. -/
noncomputable def linearForm (f : V → K) : MvPolynomial V K :=
  ∑ v, monomial (exponent v) (f v)

/-- The ordered coefficient matrix of a degree-two polynomial. -/
noncomputable def quadratic (D : V → V → K) : MvPolynomial V K :=
  ∑ v, ∑ w, monomial (exponent v + exponent w) (D v w)

/-- Expanding a product into its literal degree-two monomials. -/
theorem linearForm_mul (f g : V → K) :
    linearForm f * linearForm g = quadratic (fun v w => f v * g w) := by
  simp only [linearForm, quadratic, Finset.sum_mul, Finset.mul_sum, monomial_mul_monomial]
  rw [Finset.sum_comm]

/-- The diagonal monomial occurs only once; this is why characteristic two causes
no loss of a square coefficient. -/
theorem quadratic_square_coeff (D : V → V → K) (u : V) :
    (quadratic D).coeff (exponent u + exponent u) = D u u := by
  classical
  simp [quadratic, coeff_sum, coeff_monomial, exponent_pair_eq_iff, ite_and]

/-- Off-diagonal monomials collect the two ordered terms. -/
theorem quadratic_edge_coeff (D : V → V → K) (u v : V) (huv : u ≠ v) :
    (quadratic D).coeff (exponent u + exponent v) = D u v + D v u := by
  classical
  have split (a b : V) :
      (if (a = u ∧ b = v) ∨ (a = v ∧ b = u) then D a b else 0) =
        (if a = u ∧ b = v then D a b else 0) +
        (if a = v ∧ b = u then D a b else 0) := by
    by_cases hau : a = u <;> by_cases hav : a = v <;>
      by_cases hbu : b = u <;> by_cases hbv : b = v <;> simp_all
  simp only [quadratic, coeff_sum, coeff_monomial, exponent_pair_eq_iff,
    split, Finset.sum_add_distrib]
  simp [ite_and]

/-- Every supported monomial of `quadratic D` is a product of two variables. -/
theorem quadratic_support (D : V → V → K) (m : V →₀ ℕ)
    (hm : m ∈ (quadratic D).support) :
    ∃ u v, m = exponent u + exponent v := by
  classical
  by_contra hn
  push_neg at hn
  have hzero : (quadratic D).coeff m = 0 := by
    simp [quadratic, coeff_sum, coeff_monomial, fun u v => Ne.symm (hn u v)]
  exact (MvPolynomial.mem_support_iff.mp hm) hzero

/-- A degree-two monomial dividing another degree-two monomial equals it. -/
theorem exponent_pair_eq_of_le (a b u v : V)
    (h : exponent a + exponent b ≤ exponent u + exponent v) :
    exponent a + exponent b = exponent u + exponent v := by
  obtain ⟨d, hd⟩ := le_iff_exists_add.mp h
  have hdegree := congrArg Finsupp.degree hd
  have hd0 : d.degree = 0 := by
    simp only [map_add, exponent, Finsupp.degree_single] at hdegree
    omega
  have hd' : d = 0 := (Finsupp.degree_eq_zero_iff d).mp hd0
  simpa only [hd', add_zero] using hd.symm

/-- Exponents of the nonedge generators. -/
def nonedgeExponents (G : SimpleGraph V) : Set (V →₀ ℕ) :=
  {m | ∃ u v, u ≠ v ∧ ¬ G.Adj u v ∧ m = exponent u + exponent v}

/-- The literal Stanley--Reisner ideal generated by degree-two nonfaces. -/
noncomputable def graphIdeal (G : SimpleGraph V) : Ideal (MvPolynomial V K) :=
  Ideal.span ((fun m => monomial m (1 : K)) '' nonedgeExponents G)

/-- A square or an edge monomial cannot occur in the nonedge ideal. -/
theorem live_coefficient_zero (G : SimpleGraph V) (f : MvPolynomial V K)
    (hf : f ∈ graphIdeal G) (u v : V) (hlive : u = v ∨ G.Adj u v) :
    f.coeff (exponent u + exponent v) = 0 := by
  classical
  by_contra hn
  obtain ⟨m, ⟨a, b, hab, hnon, rfl⟩, hm⟩ :=
    MvPolynomial.mem_ideal_span_monomial_image.mp hf _
      (MvPolynomial.mem_support_iff.mpr hn)
  have he := exponent_pair_eq_of_le a b u v hm
  rcases (exponent_pair_eq_iff a b u v).mp he with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · rcases hlive with huv | hadj
    · exact hab huv
    · exact hnon hadj
  · rcases hlive with huv | hadj
    · exact hab huv.symm
    · exact hnon hadj.symm

/-- A quadratic polynomial lies in the nonedge ideal exactly when every square
and edge coefficient vanishes. -/
theorem quadratic_mem_graphIdeal_iff (G : SimpleGraph V) (D : V → V → K) :
    quadratic D ∈ graphIdeal G ↔
      (∀ v, D v v = 0) ∧ (∀ u v, G.Adj u v → D u v + D v u = 0) := by
  constructor
  · intro h
    constructor
    · intro v
      simpa only [quadratic_square_coeff] using
        live_coefficient_zero G (quadratic D) h v v (Or.inl rfl)
    · intro u v huv
      simpa only [quadratic_edge_coeff D u v huv.ne] using
        live_coefficient_zero G (quadratic D) h u v (Or.inr huv)
  · rintro ⟨hs, he⟩
    apply MvPolynomial.mem_ideal_span_monomial_image.mpr
    intro m hm
    obtain ⟨u, v, rfl⟩ := quadratic_support D m hm
    have huv : u ≠ v := by
      intro huv
      subst v
      have hzero := quadratic_square_coeff D u
      rw [hs u] at hzero
      exact (MvPolynomial.mem_support_iff.mp hm) hzero
    have hnon : ¬ G.Adj u v := by
      intro hadj
      have hzero := quadratic_edge_coeff D u v huv
      rw [he u v hadj] at hzero
      exact (MvPolynomial.mem_support_iff.mp hm) hzero
    exact ⟨exponent u + exponent v, ⟨u, v, huv, hnon, rfl⟩, le_rfl⟩

/-- The ordered coefficient matrix of the actual multiplication in Lemma 4.1. -/
def multiplicationCoefficients (p : V → I → K)
    (z : GraphKernel.Coefficients K V I) : V → V → K :=
  fun v w => z.1 w + p v ⬝ᵥ z.2 w

/-- The quadratic polynomial is exactly the sum of products of the specified
`1 + card I` forms with their multiplier forms. -/
theorem quadratic_is_multiplication (p : V → I → K)
    (z : GraphKernel.Coefficients K V I) :
    quadratic (multiplicationCoefficients p z) =
      linearForm (fun _ => 1) * linearForm z.1 +
        ∑ i, linearForm (fun v => p v i) * linearForm (fun v => z.2 v i) := by
  classical
  simp only [linearForm_mul, quadratic, multiplicationCoefficients, dotProduct,
    map_add, map_sum, one_mul, Finset.sum_add_distrib]
  congr 1
  calc
    (∑ v, ∑ w, ∑ i, monomial (exponent v + exponent w) (p v i * z.2 w i)) =
        ∑ v, ∑ i, ∑ w, monomial (exponent v + exponent w) (p v i * z.2 w i) := by
      apply Finset.sum_congr rfl
      intro v _
      rw [Finset.sum_comm]
    _ = ∑ i, ∑ v, ∑ w, monomial (exponent v + exponent w) (p v i * z.2 w i) := by
      rw [Finset.sum_comm]

/-- In the literal Stanley--Reisner quotient, the multiplication polynomial
vanishes if and only if the square and edge equations from Lemma 4.1 hold. -/
theorem multiplication_zero_in_quotient_iff (G : SimpleGraph V) (p : V → I → K)
    (z : GraphKernel.Coefficients K V I) :
    Ideal.Quotient.mk (graphIdeal (K := K) G)
      (linearForm (fun _ => 1) * linearForm z.1 +
        ∑ i, linearForm (fun v => p v i) * linearForm (fun v => z.2 v i)) = 0 ↔
      (∀ v, z.1 v + p v ⬝ᵥ z.2 v = 0) ∧
      (∀ u v, G.Adj u v →
        z.1 u + z.1 v + p u ⬝ᵥ z.2 v + p v ⬝ᵥ z.2 u = 0) := by
  rw [← quadratic_is_multiplication, Ideal.Quotient.eq_zero_iff_mem,
    quadratic_mem_graphIdeal_iff]
  simp only [multiplicationCoefficients]
  constructor
  · rintro ⟨hs, he⟩
    refine ⟨hs, ?_⟩
    intro u v huv
    have h := he u v huv
    linear_combination h
  · rintro ⟨hs, he⟩
    refine ⟨hs, ?_⟩
    intro u v huv
    have h := he u v huv
    linear_combination h

/-- Eliminating the scalar coefficients in the literal quotient gives exactly the
infinitesimal-motion equations. This is the full polynomial identity behind the
kernel comparison, valid for every placement rather than only generic ones. -/
theorem multiplication_zero_iff_rigidity (G : SimpleGraph V) (p : V → I → K)
    (z : GraphKernel.Coefficients K V I) :
    Ideal.Quotient.mk (graphIdeal (K := K) G)
      (linearForm (fun _ => 1) * linearForm z.1 +
        ∑ i, linearForm (fun v => p v i) * linearForm (fun v => z.2 v i)) = 0 ↔
      (∀ v, z.1 v = -(p v ⬝ᵥ z.2 v)) ∧
      (∀ u v, G.Adj u v → (p u - p v) ⬝ᵥ (z.2 u - z.2 v) = 0) := by
  rw [multiplication_zero_in_quotient_iff]
  constructor
  · rintro ⟨hs, he⟩
    have hc : ∀ v, z.1 v = -(p v ⬝ᵥ z.2 v) :=
      fun v => eq_neg_of_add_eq_zero_left (hs v)
    refine ⟨hc, ?_⟩
    intro u v huv
    have h := he u v huv
    rw [hc u, hc v] at h
    simp only [sub_dotProduct, dotProduct_sub]
    linear_combination -h
  · rintro ⟨hc, he⟩
    refine ⟨fun v => by rw [hc v]; exact neg_add_cancel _, ?_⟩
    intro u v huv
    have h := he u v huv
    simp only [sub_dotProduct, dotProduct_sub] at h
    rw [hc u, hc v]
    linear_combination -h

end PaperVerification.Segre.GraphQuotient
end
end ProbeLayer31

section ProbeLayer32



/-!
# Characteristic-independent rigidity for complete tripartite frameworks

This file develops the matrix argument in Lemma 6.2 of
`Singular-vector spans beyond boundary format`.

The field is arbitrary; in particular no hypothesis excluding characteristic two
is imposed. Row spanning is expressed by surjectivity of `Matrix.vecMul`.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre

open Matrix
open scoped Matrix

variable {K : Type*} [Field K]
variable {ι α β γ : Type*} [Fintype ι] [DecidableEq ι]
  [Fintype α] [Fintype β] [Fintype γ]

/-- Algebraic core of tripartite rigidity: all three velocity matrices are obtained
from one skew matrix. The hypotheses are exactly the three families of cross-part
bilinear constraints, together with row spanning of all three position matrices. -/
theorem tripartite_cross_matrix
    (A U : Matrix α ι K) (B V : Matrix β ι K) (C W : Matrix γ ι K)
    (hA : Function.Surjective A.vecMul)
    (hB : Function.Surjective B.vecMul)
    (hC : Function.Surjective C.vecMul)
    (hAB : A * Vᵀ + U * Bᵀ = 0)
    (hAC : A * Wᵀ + U * Cᵀ = 0)
    (hBC : B * Wᵀ + V * Cᵀ = 0) :
    ∃ Q : Matrix ι ι K,
      U = A * Q ∧ V = B * Q ∧ W = C * Q ∧ Qᵀ = -Q := by
  obtain ⟨LA, hLA⟩ := Matrix.vecMul_surjective_iff_exists_left_inverse.mp hA
  obtain ⟨LB, hLB⟩ := Matrix.vecMul_surjective_iff_exists_left_inverse.mp hB
  obtain ⟨LC, hLC⟩ := Matrix.vecMul_surjective_iff_exists_left_inverse.mp hC
  have hBt : Bᵀ * LBᵀ = 1 := by
    simpa only [Matrix.transpose_mul, Matrix.transpose_one] using congrArg Matrix.transpose hLB
  have hCt : Cᵀ * LCᵀ = 1 := by
    simpa only [Matrix.transpose_mul, Matrix.transpose_one] using congrArg Matrix.transpose hLC
  let Q : Matrix ι ι K := -(Vᵀ * LBᵀ)
  have hU : U = A * Q := by
    have h := congrArg (fun M => M * LBᵀ) hAB
    simp only [Matrix.add_mul, Matrix.mul_assoc, hBt, Matrix.mul_one, Matrix.zero_mul] at h
    dsimp [Q]
    rw [Matrix.mul_neg]
    exact eq_neg_of_add_eq_zero_right h
  have hVt : Vᵀ = -(Q * Bᵀ) := by
    have h := congrArg (fun M => LA * M) hAB
    rw [hU] at h
    simp only [Matrix.mul_add, ← Matrix.mul_assoc, hLA, Matrix.one_mul,
      Matrix.mul_zero] at h
    exact eq_neg_of_add_eq_zero_left h
  have hWt : Wᵀ = -(Q * Cᵀ) := by
    have h := congrArg (fun M => LA * M) hAC
    rw [hU] at h
    simp only [Matrix.mul_add, ← Matrix.mul_assoc, hLA, Matrix.one_mul,
      Matrix.mul_zero] at h
    exact eq_neg_of_add_eq_zero_left h
  have hV : V = -(B * Qᵀ) := by
    simpa only [Matrix.transpose_transpose, Matrix.transpose_neg,
      Matrix.transpose_mul] using congrArg Matrix.transpose hVt
  have hW : W = -(C * Qᵀ) := by
    simpa only [Matrix.transpose_transpose, Matrix.transpose_neg,
      Matrix.transpose_mul] using congrArg Matrix.transpose hWt
  have hskew : Qᵀ = -Q := by
    have h := congrArg (fun M => LB * M * LCᵀ) hBC
    rw [hWt, hV] at h
    simp only [Matrix.mul_add, Matrix.add_mul, Matrix.mul_neg, Matrix.neg_mul,
      ← Matrix.mul_assoc, hLB, Matrix.one_mul, Matrix.mul_zero, Matrix.zero_mul] at h
    simp only [Matrix.mul_assoc, hCt, Matrix.mul_one] at h
    have hq : Q + Qᵀ = 0 := by
      simpa only [← neg_add, neg_eq_zero] using h
    exact eq_neg_of_add_eq_zero_right hq
  refine ⟨Q, hU, ?_, ?_, hskew⟩
  · simpa only [hskew, Matrix.mul_neg, neg_neg] using hV
  · simpa only [hskew, Matrix.mul_neg, neg_neg] using hW


/-- A skew bilinear form which vanishes on the diagonal of a spanning set is
alternating. This proof is valid in characteristic two and avoids division by two. -/
theorem bilin_alt_of_skew_of_spanning
    {V₀ : Type*} [AddCommGroup V₀] [Module K V₀]
    (b : LinearMap.BilinForm K V₀) (s : Set V₀)
    (hs : Submodule.span K s = ⊤)
    (hskew : ∀ x y, b x y = -(b y x))
    (hz : ∀ x ∈ s, b x x = 0) : b.IsAlt := by
  intro x
  have hx : x ∈ Submodule.span K s := by rw [hs]; trivial
  induction hx using Submodule.span_induction with
  | mem x hx => exact hz x hx
  | zero => simp
  | add x y hx hy ihx ihy =>
      simp only [map_add, LinearMap.add_apply, ihx, ihy, zero_add, add_zero]
      exact add_eq_zero_iff_eq_neg.mpr (hskew y x)
  | smul a x hx ih =>
      simp [ih]

/-- The same tripartite matrix argument gives an alternating, rather than merely
skew, matrix when the encoded row velocities are orthogonal to their own positions.
This is the extra condition needed in characteristic two. -/
theorem tripartite_alternating_matrix
    (A U : Matrix α ι K) (B V : Matrix β ι K) (C W : Matrix γ ι K)
    (hA : Function.Surjective A.vecMul)
    (hB : Function.Surjective B.vecMul)
    (hC : Function.Surjective C.vecMul)
    (hAB : A * Vᵀ + U * Bᵀ = 0)
    (hAC : A * Wᵀ + U * Cᵀ = 0)
    (hBC : B * Wᵀ + V * Cᵀ = 0)
    (horth : ∀ a, U a ⬝ᵥ A a = 0) :
    ∃ Q : Matrix ι ι K,
      U = A * Q ∧ V = B * Q ∧ W = C * Q ∧
      Qᵀ = -Q ∧ ∀ i, Q i i = 0 := by
  obtain ⟨Q, hU, hV, hW, hskew⟩ :=
    tripartite_cross_matrix A U B V C W hA hB hC hAB hAC hBC
  have hspan : Submodule.span K (Set.range A.row) = ⊤ := by
    rw [← range_vecMulLinear, LinearMap.range_eq_top]
    exact hA
  have hskewb : ∀ x y, Q.toBilin' x y = -(Q.toBilin' y x) := by
    intro x y
    rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply',
      ← Matrix.dotProduct_transpose_mulVec Q x y, hskew,
      Matrix.neg_mulVec, dotProduct_neg, neg_neg]
  have hdiagb : ∀ x ∈ Set.range A.row, Q.toBilin' x x = 0 := by
    rintro x ⟨a, rfl⟩
    rw [Matrix.toBilin'_apply', Matrix.dotProduct_mulVec]
    have h := horth a
    rw [hU] at h
    exact h
  have halt := bilin_alt_of_skew_of_spanning Q.toBilin' (Set.range A.row)
    hspan hskewb hdiagb
  refine ⟨Q, hU, hV, hW, hskew, ?_⟩
  intro i
  simpa only [Matrix.toBilin'_single] using halt (Pi.single i 1)


/-- Homogeneous coordinates for a Euclidean placement, with the final coordinate
indexed by `none`. -/
def augmentedPosition (p : ι → K) : Option ι → K
  | none => 1
  | some i => p i

/-- The velocity encoding used in the tripartite proof. -/
def augmentedVelocity (p u : ι → K) : Option ι → K
  | none => -(p ⬝ᵥ u)
  | some i => u i

/-- Matrix of homogeneous rows for a placement. -/
def augmentedPlacement (p : Matrix α ι K) : Matrix α (Option ι) K :=
  fun a => augmentedPosition (p a)

@[simp] theorem augmented_vecMul_none (p : Matrix α ι K) (c : α → K) :
    (c ᵥ* augmentedPlacement p) none = ∑ a, c a := by
  simp [Matrix.vecMul, dotProduct, augmentedPlacement, augmentedPosition]

@[simp] theorem augmented_vecMul_some (p : Matrix α ι K) (c : α → K) (i : ι) :
    (c ᵥ* augmentedPlacement p) (some i) = (c ᵥ* p) i := by
  rfl

/-- Affine spanning, in the standard Mathlib sense, gives full row span of the
homogeneous position matrix. No general-position hypothesis is added. -/
theorem augmented_surjective_of_affineSpan
    (p : Matrix α ι K) (hp : affineSpan K (Set.range p) = ⊤) :
    Function.Surjective (augmentedPlacement p).vecMul := by
  classical
  have hcombo : ∀ y : ι → K, ∃ c : α → K, (∑ a, c a) = 1 ∧ c ᵥ* p = y := by
    intro y
    have hy : y ∈ affineSpan K (Set.range p) := by rw [hp]; trivial
    obtain ⟨c, hc, hcy⟩ := eq_affineCombination_of_mem_affineSpan_of_fintype hy
    refine ⟨c, hc, ?_⟩
    change y = Finset.univ.affineCombination K (fun a => p a) c at hcy
    rw [Finset.affineCombination_eq_linear_combination _ (fun a => p a) _ hc] at hcy
    rw [Matrix.vecMul_eq_sum]
    exact hcy.symm
  intro y
  obtain ⟨c, hc, hcp⟩ := hcombo (fun i => y (some i))
  obtain ⟨z, hz, hzp⟩ := hcombo 0
  refine ⟨c + (y none - 1) • z, ?_⟩
  ext i
  cases i with
  | none =>
      change ((c + (y none - 1) • z) ᵥ* augmentedPlacement p) none = y none
      rw [augmented_vecMul_none]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib,
        ← Finset.mul_sum, hc, hz, mul_one]
      ring
  | some i =>
      change ((c + (y none - 1) • z) ᵥ* augmentedPlacement p) (some i) = y (some i)
      rw [augmented_vecMul_some, Matrix.add_vecMul, Matrix.smul_vecMul, hcp, hzp]
      simp only [smul_zero, add_zero]

/-- The edge constraint is exactly the encoded cross-part matrix constraint. -/
theorem augmented_cross_of_edge (p q u v : ι → K)
    (h : (p - q) ⬝ᵥ (u - v) = 0) :
    augmentedPosition p ⬝ᵥ augmentedVelocity q v +
      augmentedVelocity p u ⬝ᵥ augmentedPosition q = 0 := by
  have h' := h
  simp only [sub_dotProduct, dotProduct_sub] at h'
  simp only [dotProduct, Fintype.sum_option, augmentedPosition, augmentedVelocity,
    one_mul, mul_one]
  change (-(q ⬝ᵥ v) + p ⬝ᵥ v) + (-(p ⬝ᵥ u) + u ⬝ᵥ q) = 0
  rw [dotProduct_comm u q]
  linear_combination -h'

theorem augmented_velocity_orthogonal (p u : ι → K) :
    augmentedVelocity p u ⬝ᵥ augmentedPosition p = 0 := by
  simp only [dotProduct, Fintype.sum_option, augmentedPosition, augmentedVelocity,
    mul_one]
  change -(p ⬝ᵥ u) + u ⬝ᵥ p = 0
  rw [dotProduct_comm u p]
  exact neg_add_cancel _

/-- Extract the ordinary affine motion from its homogeneous matrix encoding. -/
theorem motion_of_augmented_matrix {δ : Type*} (p u : Matrix δ ι K)
    (Q : Matrix (Option ι) (Option ι) K)
    (hu : Matrix.of (fun a => augmentedVelocity (p a) (u a)) =
      Matrix.of (fun a => augmentedPosition (p a)) * Q) :
    ∀ a, u a = (Matrix.of fun i j => Q (some j) (some i)) *ᵥ p a +
      (fun i => Q none (some i)) := by
  intro a
  funext i
  have hi := congrFun (congrFun hu a) (some i)
  simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct,
    Fintype.sum_option, augmentedPosition, augmentedVelocity,
    mul_comm, add_comm] using hi

/-- Exact all-characteristic form of the substantive assertion in Lemma 6.2.
Every infinitesimal motion of a complete tripartite placement whose three parts
separately affinely span is a common translation plus an alternating linear motion. -/
theorem complete_tripartite_infinitesimal_rigidity
    (pA uA : Matrix α ι K) (pB uB : Matrix β ι K) (pC uC : Matrix γ ι K)
    (hA : affineSpan K (Set.range pA) = ⊤)
    (hB : affineSpan K (Set.range pB) = ⊤)
    (hC : affineSpan K (Set.range pC) = ⊤)
    (hAB : ∀ a b, (pA a - pB b) ⬝ᵥ (uA a - uB b) = 0)
    (hAC : ∀ a c, (pA a - pC c) ⬝ᵥ (uA a - uC c) = 0)
    (hBC : ∀ b c, (pB b - pC c) ⬝ᵥ (uB b - uC c) = 0) :
    ∃ (M : Matrix ι ι K) (t : ι → K),
      Mᵀ = -M ∧ (∀ i, M i i = 0) ∧
      (∀ a, uA a = M *ᵥ pA a + t) ∧
      (∀ b, uB b = M *ᵥ pB b + t) ∧
      (∀ c, uC c = M *ᵥ pC c + t) := by
  let A := augmentedPlacement pA
  let B := augmentedPlacement pB
  let C := augmentedPlacement pC
  let U : Matrix α (Option ι) K := fun a => augmentedVelocity (pA a) (uA a)
  let V : Matrix β (Option ι) K := fun b => augmentedVelocity (pB b) (uB b)
  let W : Matrix γ (Option ι) K := fun c => augmentedVelocity (pC c) (uC c)
  have crossAB : A * Vᵀ + U * Bᵀ = 0 := by
    ext a b
    exact augmented_cross_of_edge (pA a) (pB b) (uA a) (uB b) (hAB a b)
  have crossAC : A * Wᵀ + U * Cᵀ = 0 := by
    ext a c
    exact augmented_cross_of_edge (pA a) (pC c) (uA a) (uC c) (hAC a c)
  have crossBC : B * Wᵀ + V * Cᵀ = 0 := by
    ext b c
    exact augmented_cross_of_edge (pB b) (pC c) (uB b) (uC c) (hBC b c)
  obtain ⟨Q, hU, hV, hW, hQt, hQd⟩ :=
    tripartite_alternating_matrix A U B V C W
      (augmented_surjective_of_affineSpan pA hA)
      (augmented_surjective_of_affineSpan pB hB)
      (augmented_surjective_of_affineSpan pC hC)
      crossAB crossAC crossBC
      (fun a => augmented_velocity_orthogonal (pA a) (uA a))
  let M : Matrix ι ι K := fun i j => Q (some j) (some i)
  let t : ι → K := fun i => Q none (some i)
  refine ⟨M, t, ?_, ?_, motion_of_augmented_matrix pA uA Q hU,
    motion_of_augmented_matrix pB uB Q hV, motion_of_augmented_matrix pC uC Q hW⟩
  · ext i j
    exact congrFun (congrFun hQt (some j)) (some i)
  · intro i
    exact hQd (some i)

end PaperVerification.Segre
end
end ProbeLayer32

section ProbeLayer33



/-!
# Rigidity propagation at arbitrary placements

The gluing and vertex-addition statements below apply to concrete placements
under the exact affine-span or direction-span hypotheses needed in their proofs.
These are the placement-level assertions used in Lemma 4.2. No assumption about
characteristic is imposed and alternating matrices include the diagonal-zero
condition explicitly.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre

open Matrix
open scoped Matrix

variable {K I V : Type*} [Field K] [Fintype I] [DecidableEq I]

/-- An alternating matrix, including the diagonal condition required in
characteristic two, has zero quadratic pairing on every vector. -/
theorem dot_alternating_mulVec_zero (M : Matrix I I K)
    (ht : Mᵀ = -M) (hd : ∀ i, M i i = 0) (x : I → K) :
    x ⬝ᵥ (M *ᵥ x) = 0 := by
  have hspan : Submodule.span K (Set.range (fun i : I => Pi.single i (1 : K))) = ⊤ := by
    have he : ⇑(Pi.basisFun K I) = (fun i : I => Pi.single i (1 : K)) := by
      funext i
      simp only [Pi.basisFun_apply]
    rw [← he]
    exact (Pi.basisFun K I).span_eq
  have hskew : ∀ x y, M.toBilin' x y = -(M.toBilin' y x) := by
    intro x y
    rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply',
      ← Matrix.dotProduct_transpose_mulVec M x y, ht,
      Matrix.neg_mulVec, dotProduct_neg, neg_neg]
  have hdiag : ∀ x ∈ Set.range (fun i : I => Pi.single i (1 : K)),
      M.toBilin' x x = 0 := by
    rintro x ⟨i, rfl⟩
    simpa only [Matrix.toBilin'_single, one_mul, mul_one] using hd i
  simpa only [Matrix.toBilin'_apply'] using
    bilin_alt_of_skew_of_spanning M.toBilin' _ hspan hskew hdiag x

/-- Every common translation plus alternating linear motion satisfies every edge
constraint, without a characteristic restriction. -/
theorem trivial_motion_edge (M : Matrix I I K) (t p q : I → K)
    (ht : Mᵀ = -M) (hd : ∀ i, M i i = 0) :
    (p - q) ⬝ᵥ ((M *ᵥ p + t) - (M *ᵥ q + t)) = 0 := by
  rw [add_sub_add_right_eq_sub, ← Matrix.mulVec_sub]
  exact dot_alternating_mulVec_zero M ht hd (p - q)

/-- A vector orthogonal to a spanning family is zero; this is algebraic
nondegeneracy of the coordinate pairing, not a positivity argument. -/
theorem eq_zero_of_dot_spanning {D : Type*} (a : D → I → K)
    (ha : Submodule.span K (Set.range a) = ⊤) (w : I → K)
    (hw : ∀ d, a d ⬝ᵥ w = 0) : w = 0 := by
  have hall : ∀ x : I → K, x ⬝ᵥ w = 0 := by
    intro x
    have hx : x ∈ Submodule.span K (Set.range a) := by rw [ha]; trivial
    induction hx using Submodule.span_induction with
    | mem x hx => obtain ⟨d, rfl⟩ := hx; exact hw d
    | zero => simp
    | add x y hx hy ihx ihy => simp [add_dotProduct, ihx, ihy]
    | smul c x hx ih => simp [smul_dotProduct, ih]
  funext i
  simpa using hall (Pi.single i (1 : K))

/-- A new vertex is forced to follow a common trivial motion as soon as its
incident directions span the ambient vector space. -/
theorem motion_at_new_vertex {D : Type*}
    (p : D → I → K) (u : D → I → K) (x ux : I → K)
    (M : Matrix I I K) (t : I → K)
    (ht : Mᵀ = -M) (hd : ∀ i, M i i = 0)
    (hu : ∀ d, u d = M *ᵥ p d + t)
    (hspan : Submodule.span K (Set.range (fun d => x - p d)) = ⊤)
    (hedge : ∀ d, (x - p d) ⬝ᵥ (ux - u d) = 0) :
    ux = M *ᵥ x + t := by
  apply sub_eq_zero.mp
  apply eq_zero_of_dot_spanning (fun d => x - p d) hspan
  intro d
  have he := hedge d
  rw [hu d] at he
  have hm := trivial_motion_edge M t x (p d) ht hd
  simp only [dotProduct_sub] at he hm ⊢
  linear_combination he - hm

/-- The affine map associated to a common infinitesimal rigid motion. -/
def motionAffineMap (M : Matrix I I K) (t : I → K) : (I → K) →ᵃ[K] (I → K) where
  toFun p := M *ᵥ p + t
  linear := M.mulVecLin
  map_vadd' p v := by
    change M *ᵥ (v + p) + t = M *ᵥ v + (M *ᵥ p + t)
    rw [Matrix.mulVec_add, add_assoc]

/-- Infinitesimal rigidity restricted to a chosen vertex set. Velocities are
allowed on all vertices, so the definition does not assume any extension theorem. -/
def InfinitesimallyRigidOn (G : SimpleGraph V) (p : V → I → K) (S : Set V) : Prop :=
  ∀ u : V → I → K,
    (∀ v ∈ S, ∀ w ∈ S, G.Adj v w → (p v - p w) ⬝ᵥ (u v - u w) = 0) →
      ∃ (M : Matrix I I K) (t : I → K), Mᵀ = -M ∧ (∀ i, M i i = 0) ∧
        ∀ v ∈ S, u v = M *ᵥ p v + t

/-- Gluing rigid frameworks along an affinely spanning intersection preserves
rigidity. This is the exact placement-level version of Lemma 4.2(ii). -/
theorem rigidOn_union (G : SimpleGraph V) (p : V → I → K) (S T : Set V)
    (hS : InfinitesimallyRigidOn G p S) (hT : InfinitesimallyRigidOn G p T)
    (hspan : affineSpan K (p '' (S ∩ T)) = ⊤) :
    InfinitesimallyRigidOn G p (S ∪ T) := by
  intro u hu
  obtain ⟨MS, tS, hMSt, hMSd, hUS⟩ :=
    hS u (fun v hv w hw h => hu v (Or.inl hv) w (Or.inl hw) h)
  obtain ⟨MT, tT, hMTt, hMTd, hUT⟩ :=
    hT u (fun v hv w hw h => hu v (Or.inr hv) w (Or.inr hw) h)
  have hmaps : motionAffineMap MS tS = motionAffineMap MT tT := by
    apply AffineMap.ext_on hspan
    rintro x ⟨v, hv, rfl⟩
    change MS *ᵥ p v + tS = MT *ᵥ p v + tT
    exact (hUS v hv.1).symm.trans (hUT v hv.2)
  refine ⟨MS, tS, hMSt, hMSd, ?_⟩
  intro v hv
  rcases hv with hv | hv
  · exact hUS v hv
  · rw [hUT v hv]
    exact (congrArg (fun f : (I → K) →ᵃ[K] (I → K) => f (p v)) hmaps).symm

/-- Adding a vertex whose incident directions span preserves rigidity. This is
Lemma 4.2(iii) at every placement meeting the direction-span condition. -/
theorem rigidOn_insert (G : SimpleGraph V) (p : V → I → K) (S : Set V) (x : V)
    (hS : InfinitesimallyRigidOn G p S)
    (hspan : Submodule.span K
      (Set.range (fun v : {v : V // v ∈ S ∧ G.Adj x v} => p x - p v)) = ⊤) :
    InfinitesimallyRigidOn G p (insert x S) := by
  intro u hu
  obtain ⟨M, t, hMt, hMd, hU⟩ :=
    hS u (fun v hv w hw h => hu v (Set.mem_insert_of_mem x hv)
      w (Set.mem_insert_of_mem x hw) h)
  have hx : u x = M *ᵥ p x + t := by
    apply motion_at_new_vertex
      (fun v : {v : V // v ∈ S ∧ G.Adj x v} => p v)
      (fun v : {v : V // v ∈ S ∧ G.Adj x v} => u v)
      (p x) (u x) M t hMt hMd
    · exact fun v => hU v v.property.1
    · exact hspan
    · intro v
      exact hu x (Set.mem_insert x S) v
        (Set.mem_insert_of_mem x v.property.1) v.property.2
  refine ⟨M, t, hMt, hMd, ?_⟩
  intro v hv
  rcases Set.mem_insert_iff.mp hv with rfl | hv
  · exact hx
  · exact hU v hv

/-- Full row span of homogeneous coordinates is also sufficient for affine
spanning, completing the exact equivalence used in rigidity constructions. -/
theorem affineSpan_of_augmented_surjective [Fintype V]
    (p : Matrix V I K) (hp : Function.Surjective (augmentedPlacement p).vecMul) :
    affineSpan K (Set.range p) = ⊤ := by
  apply top_unique
  intro y _
  obtain ⟨c, hc⟩ := hp (augmentedPosition y)
  have hc1 : ∑ v, c v = 1 := by
    have h := congrFun hc none
    simpa only [augmented_vecMul_none, augmentedPosition] using h
  have hcy : c ᵥ* p = y := by
    funext i
    exact congrFun hc (some i)
  have hmem := affineCombination_mem_affineSpan hc1 (fun v => p v)
  rw [Finset.affineCombination_eq_linear_combination _ (fun v => p v) _ hc1] at hmem
  have heq : (∑ v, c v • p v) = y := (Matrix.vecMul_eq_sum c p).symm.trans hcy
  simpa only [heq] using hmem

/-- A complete graph is rigid at every affinely spanning placement. The proof
uses the already established characteristic-independent homogeneous matrix argument. -/
theorem complete_graph_rigid [Fintype V] (p : Matrix V I K)
    (hp : affineSpan K (Set.range p) = ⊤) :
    InfinitesimallyRigidOn (⊤ : SimpleGraph V) p Set.univ := by
  intro u hu
  have hall : ∀ v w, (p v - p w) ⬝ᵥ (u v - u w) = 0 := by
    intro v w
    by_cases h : v = w
    · subst w
      simp
    · exact hu v (Set.mem_univ _) w (Set.mem_univ _) (by simpa using h)
  obtain ⟨M, t, hMt, hMd, hmotion, _, _⟩ :=
    complete_tripartite_infinitesimal_rigidity p (Matrix.of u) p (Matrix.of u)
      p (Matrix.of u) hp hp hp hall hall hall
  exact ⟨M, t, hMt, hMd, fun v _ => hmotion v⟩

end PaperVerification.Segre
end
end ProbeLayer33

