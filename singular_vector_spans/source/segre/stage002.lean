/-!
# The alternating Koszul boundary space in degree two

For linear forms whose coefficient rows are `(1,pᵥ)`, the ordinary degree-two
Koszul relations are the coefficient matrices `A Q`, where `Q` is alternating.
The diagonal condition is part of the definition, including in characteristic
two. The image has dimension `choose (r+1) 2` whenever the coefficient rows span.

The final theorem computes the quotient of the actual square-and-edge
multiplication kernel by this boundary space. The identification with the
polynomial graph quotient is developed in `SegreGraphQuotient`.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.KoszulDimension

open Matrix
open scoped Matrix
open GraphKernel

variable {K D V I E : Type*} [Field K]

/-- Alternating matrices over an arbitrary field, with the diagonal condition
included explicitly so that this is also the exterior-square space in
characteristic two. -/
def alternatingMatrices (K D : Type*) [Field K] : Submodule K (Matrix D D K) where
  carrier := {Q | Qᵀ = -Q ∧ ∀ i, Q i i = 0}
  zero_mem' := by simp
  add_mem' := by
    rintro Q T ⟨hQ, hdQ⟩ ⟨hT, hdT⟩
    exact ⟨by simp [Matrix.transpose_add, hQ, hT, add_comm], by simp [hdQ, hdT]⟩
  smul_mem' := by
    rintro a Q ⟨hQ, hdQ⟩
    exact ⟨by simp [Matrix.transpose_smul, hQ], by simp [hdQ]⟩

/-- Strict upper entries give linear coordinates without any assumption on the
characteristic. The inverse has zero diagonal by construction. -/
def alternatingCoordinates [LinearOrder D] :
    alternatingMatrices K D ≃ₗ[K] ({q : D × D // q.1 < q.2} → K) where
  toFun Q q := Q.val q.val.1 q.val.2
  invFun c := ⟨Matrix.ofStrictUpper c,
    Matrix.transpose_ofStrictUpper c, Matrix.ofStrictUpper_apply_diag c⟩
  left_inv Q := by
    apply Subtype.ext
    change Matrix.ofStrictUpper
      (fun q : {q : D × D // q.1 < q.2} => Q.val q.val.1 q.val.2) = Q.val
    apply Matrix.ext_of_lt_of_transpose_eq_neg
      (Matrix.transpose_ofStrictUpper _) Q.property.1
      (Matrix.ofStrictUpper_apply_diag _) Q.property.2
    intro i j hij
    exact Matrix.ofStrictUpper_apply_of_lt _ ⟨(i, j), hij⟩
  right_inv c := funext (Matrix.ofStrictUpper_apply_of_lt c)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The dimension of alternating matrices is `d choose 2` in every
characteristic, including characteristic two. -/
theorem finrank_alternatingMatrices [Fintype D] :
    Module.finrank K (alternatingMatrices K D) = (Fintype.card D).choose 2 := by
  classical
  let : LinearOrder D := LinearOrder.lift' (Fintype.equivFin D)
    (Fintype.equivFin D).injective
  rw [(alternatingCoordinates (K := K) (D := D)).finrank_eq,
    Module.finrank_pi, Fintype.card_subtype, Fintype.card_product_filter_lt]

variable [Fintype D]

/-- The alternating matrix encoding one ordinary Koszul pair relation. -/
def pairAlternating [DecidableEq D] (i j : D) : alternatingMatrices K D :=
  ⟨Matrix.single i j 1 - Matrix.single j i 1,
    Matrix.transpose_single_sub_single i j 1, by
      intro k
      simp [Matrix.single_apply, and_comm]⟩

/-- Every alternating matrix is a linear combination of the matrices of ordinary
pair relations. This verifies that using alternating matrices adds no extra
boundaries to the Koszul relation space. -/
theorem exists_sum_pairAlternating [LinearOrder D]
    (Q : alternatingMatrices K D) :
    ∃ c : {q : D × D // q.1 < q.2} → K,
      Q = ∑ q, c q • pairAlternating q.val.1 q.val.2 := by
  classical
  let e := alternatingCoordinates (K := K) (D := D)
  let b := (Pi.basisFun K {q : D × D // q.1 < q.2}).map e.symm
  have hb (q : {q : D × D // q.1 < q.2}) :
      b q = pairAlternating q.val.1 q.val.2 := by
    apply e.injective
    funext r
    change e (e.symm (Pi.basisFun K _ q)) r =
      (Matrix.single q.val.1 q.val.2 (1 : K) - Matrix.single q.val.2 q.val.1 (1 : K))
        r.val.1 r.val.2
    rw [LinearEquiv.apply_symm_apply]
    simpa only [Pi.basisFun_apply, Pi.single_apply, eq_comm] using
      (Matrix.single_sub_single_apply_of_lt q r (1 : K)).symm
  refine ⟨fun q => b.repr Q q, ?_⟩
  have h := b.sum_repr Q
  simp_rw [hb] at h
  exact h.symm

/-- Multiply an alternating coefficient matrix by the matrix of linear forms.
The matrix unit `Eᵢⱼ-Eⱼᵢ` gives the usual relation `θᵢ eⱼ-θⱼ eᵢ`. -/
def koszulMatrix (A : Matrix V D K) :
    alternatingMatrices K D →ₗ[K] Matrix V D K where
  toFun Q := A * Q.val
  map_add' Q T := Matrix.mul_add _ _ _
  map_smul' a Q := by
    simp only [Submodule.coe_smul, Matrix.mul_smul, RingHom.id_apply]

/-- Applying a pair matrix produces exactly the coefficient vector of
`θᵢ eⱼ - θⱼ eᵢ`, the defining degree-two Koszul boundary. -/
theorem koszulMatrix_pair_apply [DecidableEq D]
    (A : Matrix V D K) (i j k : D) (v : V) :
    koszulMatrix A (pairAlternating i j) v k =
      (if k = j then A v i else 0) - (if k = i then A v j else 0) := by
  change (A * (Matrix.single i j (1 : K) - Matrix.single j i (1 : K))) v k = _
  rw [Matrix.mul_sub, Matrix.sub_apply]
  have hsingle (a b : D) : (A * Matrix.single a b (1 : K)) v k =
      if k = b then A v a else 0 := by
    by_cases h : k = b
    · subst k
      simp
    · rw [Matrix.mul_single_apply_of_ne (1 : K) a b v k h A, if_neg h]
  rw [hsingle, hsingle]

/-- Independent linear forms have independent degree-two Koszul relations. -/
theorem koszulMatrix_injective [Fintype V] [DecidableEq D]
    (A : Matrix V D K) (hA : Function.Surjective A.vecMul) :
    Function.Injective (koszulMatrix A) := by
  obtain ⟨L, hL⟩ := Matrix.vecMul_surjective_iff_exists_left_inverse.mp hA
  intro Q T hQT
  apply Subtype.ext
  have h := congrArg (fun M : Matrix V D K => L * M) hQT
  change L * (A * Q.val) = L * (A * T.val) at h
  simpa only [← Matrix.mul_assoc, hL, Matrix.one_mul] using h

/-- The Koszul boundary dimension depends only on the number of independent
linear forms. -/
theorem finrank_koszulMatrix_range [Fintype V] [DecidableEq D]
    (A : Matrix V D K) (hA : Function.Surjective A.vecMul) :
    Module.finrank K (LinearMap.range (koszulMatrix A)) =
      (Fintype.card D).choose 2 := by
  rw [LinearMap.finrank_range_of_inj (koszulMatrix_injective A hA),
    finrank_alternatingMatrices]

/-- Coefficients of the distinguished constant-coordinate form and the remaining
forms, assembled into a single matrix. -/
def coefficientsEquiv : Coefficients K V I ≃ₗ[K] Matrix V (Option I) K where
  toFun z v
    | none => z.1 v
    | some i => z.2 v i
  invFun U := (fun v => U v none, fun v i => U v (some i))
  left_inv z := rfl
  right_inv U := by ext v (_ | i) <;> rfl
  map_add' z w := by ext v (_ | i) <;> rfl
  map_smul' a z := by ext v (_ | i) <;> rfl

variable [Fintype I] [DecidableEq I]

/-- The degree-two Koszul boundary map, written in the coefficient coordinates
used for the graph multiplication map. -/
def coefficientBoundary (p : Matrix V I K) :
    alternatingMatrices K (Option I) →ₗ[K] Coefficients K V I :=
  coefficientsEquiv.symm.toLinearMap.comp (koszulMatrix (augmentedPlacement p))

/-- Every Koszul relation gives zero square and zero edge coefficients, without
any assumption on the graph or on the placement. -/
theorem coefficientBoundary_mem_kernel
    (p : Matrix V I K) (endpoints : E → V × V)
    (Q : alternatingMatrices K (Option I)) :
    coefficientBoundary p Q ∈ LinearMap.ker (coefficientMap p endpoints) := by
  let A : Matrix V (Option I) K := augmentedPlacement p
  let U : Matrix V (Option I) K := A * Q.val
  have horth (v : V) : U v ⬝ᵥ A v = 0 := by
    change (A v ᵥ* Q.val) ⬝ᵥ A v = 0
    rw [← Matrix.dotProduct_mulVec]
    exact dot_alternating_mulVec_zero Q.val Q.property.1 Q.property.2 (A v)
  have hcross : A * Uᵀ + U * Aᵀ = 0 := by
    dsimp [U]
    rw [Matrix.transpose_mul, Q.property.1]
    simp only [Matrix.neg_mul, Matrix.mul_neg, Matrix.mul_assoc, neg_add_cancel]
  change coefficientMap p endpoints (coefficientsEquiv.symm U) = 0
  apply Prod.ext
  · funext v
    have h := horth v
    simpa [A, augmentedPlacement, augmentedPosition, coefficientsEquiv,
      coefficientMap, dotProduct, mul_comm, Fintype.sum_option] using h
  · funext e
    have h := congrFun (congrFun hcross (endpoints e).1) (endpoints e).2
    simpa [A, augmentedPlacement, augmentedPosition, coefficientsEquiv,
      coefficientMap, Matrix.mul_apply, Matrix.transpose_apply, dotProduct,
      Fintype.sum_option, mul_comm, add_assoc, add_left_comm, add_comm] using h

/-- The Koszul boundary map takes values in the multiplication kernel. -/
def boundaryToKernel (p : Matrix V I K) (endpoints : E → V × V) :
    alternatingMatrices K (Option I) →ₗ[K]
      LinearMap.ker (coefficientMap p endpoints) :=
  (coefficientBoundary p).codRestrict _
    (coefficientBoundary_mem_kernel p endpoints)

/-- No degree-two Koszul relations coincide when the linear forms are
independent. -/
theorem boundaryToKernel_injective [Fintype V]
    (p : Matrix V I K) (endpoints : E → V × V)
    (hp : Function.Surjective (augmentedPlacement p).vecMul) :
    Function.Injective (boundaryToKernel p endpoints) := by
  intro Q T h
  have h' := congrArg Subtype.val h
  apply koszulMatrix_injective (augmentedPlacement p) hp
  exact coefficientsEquiv.symm.injective h'

/-- The subspace of degree-two Koszul boundaries inside the multiplication
kernel, with no assumed relations beyond those proved above. -/
def boundaries (p : Matrix V I K) (endpoints : E → V × V) :
    Submodule K (LinearMap.ker (coefficientMap p endpoints)) :=
  LinearMap.range (boundaryToKernel p endpoints)

/-- Exact dimension of the degree-two boundary space. -/
theorem finrank_boundaries [Fintype V]
    (p : Matrix V I K) (endpoints : E → V × V)
    (hp : Function.Surjective (augmentedPlacement p).vecMul) :
    Module.finrank K (boundaries p endpoints) =
      (Fintype.card I + 1).choose 2 := by
  rw [boundaries, LinearMap.finrank_range_of_inj
    (boundaryToKernel_injective p endpoints hp), finrank_alternatingMatrices]
  simp only [Fintype.card_option]

/-- The square-and-edge multiplication kernel modulo its Koszul boundaries has
dimension `r N - ρ - choose (r+1) 2`. All ranks are those of the actual displayed
linear maps; there is no characteristic or genericity hypothesis. -/
theorem finrank_kernel_quotient_boundaries [Fintype V] [Fintype E]
    (p : Matrix V I K) (endpoints : E → V × V)
    (hp : Function.Surjective (augmentedPlacement p).vecMul) :
    Module.finrank K
        ((LinearMap.ker (coefficientMap p endpoints)) ⧸ boundaries p endpoints) =
      Fintype.card V * Fintype.card I -
        Module.finrank K (LinearMap.range (rigidityMap p endpoints)) -
        (Fintype.card I + 1).choose 2 := by
  exact (Submodule.finrank_quotient (R := K) (boundaries p endpoints)).trans
    (congrArg₂ Nat.sub
      (finrank_multiplication_kernel (fun v i => p v i) endpoints)
      (finrank_boundaries p endpoints hp))

end PaperVerification.Segre.KoszulDimension
end
end ProbeLayer36

section ProbeLayer37



/-!
# Exact degree-two syzygies of staircase rank parameters

For the actual comparability graph of a product of chains, the antidiagonal
rank-sum parameters have precisely their ordinary alternating Koszul syzygies
in degree two. The proof uses rank-selected connectivity and coefficients in
the literal Stanley--Reisner polynomial quotient. It does not assume
Cohen--Macaulayness, regularity, or a homology-vanishing assertion.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.RankParameters

open Staircase RankConnectivity Matrix GraphQuotient KoszulDimension
open scoped Matrix

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

noncomputable def representative (r : Ranks n) : Cell n :=
  Classical.choose (exists_cell_rank r.val (Nat.le_of_lt_succ r.isLt))

@[simp] theorem rank_representative (r : Ranks n) : rank (representative r) = r.val :=
  Classical.choose_spec (exists_cell_rank r.val (Nat.le_of_lt_succ r.isLt))

@[simp] theorem rankIndex_representative (r : Ranks n) : rankIndex (representative r) = r :=
  Fin.ext (rank_representative r)

set_option maxHeartbeats 2000000 in
/-- Every rank occurs, so the parameter coefficient rows span the whole
parameter coordinate space. -/
theorem rankForms_surjective : Function.Surjective (rankForms (K := K) (n := n)).vecMul := by
  classical
  intro y
  refine ⟨∑ r : Ranks n, y r • Pi.single (representative r) (1 : K), ?_⟩
  change (∑ r : Ranks n, y r • Pi.single (representative r) (1 : K)) ᵥ*
    rankForms (K := K) (n := n) = y
  rw [Matrix.sum_vecMul]
  simp only [Matrix.smul_vecMul, Matrix.single_one_vecMul]
  funext r
  simp only [Finset.sum_apply, Matrix.row_apply, rankForms, rankIndex_representative,
    Pi.smul_apply, smul_eq_mul, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true]

/-- The exact square and edge equations for a multiplication syzygy. -/
def Conditions (U : Matrix (Cell n) (Ranks n) K) : Prop :=
  (∀ u, U u (rankIndex u) = 0) ∧
  (∀ u v, u ≠ v → (u ≤ v ∨ v ≤ u) → U u (rankIndex v) + U v (rankIndex u) = 0)

/-- A syzygy coefficient depends only on the rank of its variable. This is the
precise use of connectivity of each two-rank comparability graph. -/
theorem same_rank_coefficient (U : Matrix (Cell n) (Ranks n) K) (h : Conditions U)
    (u v : Cell n) (hr : rank u = rank v) (j : Ranks n) : U u j = U v j := by
  rcases lt_trichotomy (rank u) j.val with hlt | heq | hgt
  · apply lower_layer_constant (fun x => U x j) (fun y => -U y (rankIndex u))
      (rank u) j.val hlt (Nat.le_of_lt_succ j.isLt) _ u v rfl hr.symm
    intro x y hx hy hxy
    have hix : rankIndex x = rankIndex u := Fin.ext hx
    have hiy : rankIndex y = j := Fin.ext hy
    have hne : x ≠ y := by intro he; subst y; omega
    have he := h.2 x y hne (Or.inl hxy)
    rw [hix, hiy] at he
    exact eq_neg_of_add_eq_zero_left he
  · have hiu : rankIndex u = j := Fin.ext heq
    have hiv : rankIndex v = j := Fin.ext (hr.symm.trans heq)
    have hu0 : U u j = 0 := by simpa [hiu] using h.1 u
    have hv0 : U v j = 0 := by simpa [hiv] using h.1 v
    exact hu0.trans hv0.symm
  · apply upper_layer_constant (fun x => -U x (rankIndex u)) (fun y => U y j)
      j.val (rank u) hgt (rank_le_sideSum u) _ u v rfl hr.symm
    intro x y hx hy hxy
    have hix : rankIndex x = j := Fin.ext hx
    have hiy : rankIndex y = rankIndex u := Fin.ext hy
    have hne : x ≠ y := by intro he; subst y; omega
    have he := h.2 x y hne (Or.inl hxy)
    rw [hix, hiy] at he
    exact (eq_neg_of_add_eq_zero_right he).symm

/-- The edge equation consequently holds for every pair of variables, even
when that pair is incomparable. -/
theorem coefficients_skew (U : Matrix (Cell n) (Ranks n) K) (h : Conditions U)
    (u v : Cell n) : U u (rankIndex v) + U v (rankIndex u) = 0 := by
  have ordered (x y : Cell n) (hxy : rank x < rank y) :
      U x (rankIndex y) + U y (rankIndex x) = 0 := by
    obtain ⟨z, hxz, hzr⟩ := exists_rank_above x (rank y) hxy.le (rank_le_sideSum y)
    have hne : x ≠ z := by intro he; subst z; omega
    have he := h.2 x z hne (Or.inl hxz)
    have hiz : rankIndex z = rankIndex y := Fin.ext hzr
    rw [hiz, same_rank_coefficient U h z y hzr] at he
    exact he
  rcases lt_trichotomy (rank u) (rank v) with hlt | heq | hgt
  · exact ordered u v hlt
  · have hi : rankIndex u = rankIndex v := Fin.ext heq
    rw [← hi, h.1 u]
    simpa [hi] using h.1 v
  · simpa only [add_comm] using ordered v u hgt

/-- Every syzygy is the product of the actual parameter coefficient matrix and
an alternating matrix. In particular no additional degree-two relations exist. -/
theorem conditions_iff_alternating_boundary (U : Matrix (Cell n) (Ranks n) K) :
    Conditions U ↔ ∃ Q : alternatingMatrices K (Ranks n), U = (rankForms (K := K) (n := n)) * Q.val := by
  constructor
  · intro h
    let Q : Matrix (Ranks n) (Ranks n) K := fun r s => U (representative r) s
    have hdiag : ∀ r, Q r r = 0 := by
      intro r
      simpa [Q] using h.1 (representative r)
    have hskew : Qᵀ = -Q := by
      ext r s
      have he := coefficients_skew U h (representative s) (representative r)
      simp only [rankIndex_representative] at he
      exact eq_neg_of_add_eq_zero_left he
    refine ⟨⟨Q, hskew, hdiag⟩, ?_⟩
    ext u r
    rw [rankForms_mul]
    exact same_rank_coefficient U h u (representative (rankIndex u))
      (by simp) r
  · rintro ⟨Q, rfl⟩
    constructor
    · intro u
      rw [rankForms_mul]
      exact Q.property.2 _
    · intro u v _ _
      rw [rankForms_mul, rankForms_mul]
      have he := congrFun (congrFun Q.property.1 (rankIndex v)) (rankIndex u)
      change Q.val (rankIndex u) (rankIndex v) =
        -Q.val (rankIndex v) (rankIndex u) at he
      exact add_eq_zero_iff_eq_neg.mpr he

/-- The literal polynomial rank sum at rank `r`. -/
noncomputable def rankParameterPolynomial (r : Ranks n) : MvPolynomial (Cell n) K :=
  linearForm (fun u => rankForms u r)

/-- Actual multiplication of the rank sums by their degree-one multiplier
polynomials, before passage to the Stanley--Reisner quotient. -/
noncomputable def rankMultiplierPolynomial (U : Matrix (Cell n) (Ranks n) K) :
    MvPolynomial (Cell n) K :=
  ∑ r, rankParameterPolynomial r * linearForm (fun u => U u r)

theorem rankMultiplierPolynomial_eq (U : Matrix (Cell n) (Ranks n) K) :
    rankMultiplierPolynomial U = quadratic (fun u v => U v (rankIndex u)) := by
  classical
  simp only [rankMultiplierPolynomial, rankParameterPolynomial, linearForm_mul, quadratic]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro u _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro v _
  simp [rankForms, ite_mul, apply_ite]

/-- The square-and-edge condition is exactly vanishing of the actual
multiplication polynomial in the actual nonedge quotient. -/
theorem quotient_zero_iff_conditions (U : Matrix (Cell n) (Ranks n) K) :
    Ideal.Quotient.mk (graphIdeal (K := K) (chainGraph n)) (rankMultiplierPolynomial U) = 0 ↔
      Conditions U := by
  rw [Ideal.Quotient.eq_zero_iff_mem, rankMultiplierPolynomial_eq,
    quadratic_mem_graphIdeal_iff]
  simp only [Conditions, chainGraph, and_imp]
  constructor
  · rintro ⟨hd, he⟩
    exact ⟨hd, fun u v hne hle => by simpa only [add_comm] using he u v hne hle⟩
  · rintro ⟨hd, he⟩
    exact ⟨hd, fun u v hne hle => by simpa only [add_comm] using he u v hne hle⟩

/-- Complete degree-two exactness of the rank-sum parameters in the actual
staircase ring, for every finite product of finite chains and every field.
The alternating coefficient space is independently identified with the span
of ordinary pairwise Koszul boundaries in `SegreKoszulDimension`. -/
theorem staircase_rank_parameter_exactness (U : Matrix (Cell n) (Ranks n) K) :
    Ideal.Quotient.mk (graphIdeal (K := K) (chainGraph n)) (rankMultiplierPolynomial U) = 0 ↔
      ∃ Q : alternatingMatrices K (Ranks n), U = (rankForms (K := K) (n := n)) * Q.val := by
  rw [quotient_zero_iff_conditions, conditions_iff_alternating_boundary]

end PaperVerification.Segre.RankParameters
end
end ProbeLayer37

section ProbeLayer38



/-!
# The degree-two staircase family and rank transfer

The rows of the multiplication matrix are the genuine sorted degree-two Segre
monomials. Its columns are a form index and a degree-one coordinate. The family
coefficient for `yᵤ yᵥ` is `t^(2pq)` at the sorted pair `(u ⊓ v,u ⊔ v)`.

The fiber at one is literal Segre multiplication. At every nonzero fiber, the
weight identity gives invertible diagonal changes of source and target. A
nonzero minor at the zero fiber therefore produces a minor of the same size for
actual Segre multiplication over every infinite field. This proves the required
degree-two rank transfer directly, without assuming a flatness theorem.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.Degeneration

open Matrix MvPolynomial Staircase Monomials
open scoped Matrix

variable {I J K : Type*} [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J] [Field K]
variable {n : I → ℕ}

/-- Sort two Segre indices independently in every factor. -/
def sortPair (u v : Cell n) : SortedPair n :=
  ⟨(meet u v, join u v), fun i => min_le_max⟩

theorem sortPair_of_le {u v : Cell n} (h : u ≤ v) :
    sortPair u v = ⟨(u, v), h⟩ := by
  apply Subtype.ext
  apply Prod.ext <;> funext i
  · exact min_eq_left (h i)
  · exact max_eq_right (h i)

theorem sortPair_comm (u v : Cell n) : sortPair u v = sortPair v u := by
  apply Subtype.ext
  apply Prod.ext <;> funext i
  · exact min_comm _ _
  · exact max_comm _ _

/-- Weight of a sorted degree-two coordinate. -/
def targetWeight (q : SortedPair n) : ℕ := weight q.val.1 + weight q.val.2

theorem weight_identity (u v : Cell n) :
    weight u + weight v = targetWeight (sortPair u v) + defectExponent u v :=
  weight_sorting_identity u v

/-- The full degree-two multiplication matrix of the staircase family. The
forms have coefficient matrix `A`, with vertices indexing rows. -/
noncomputable def multiplicationMatrix {R : Type*} [CommRing R]
    (t : R) (A : Matrix (Cell n) J R) :
    Matrix (SortedPair n) (J × Cell n) R := fun q jv =>
  ∑ u, if sortPair u jv.2 = q then t ^ defectExponent u jv.2 * A u jv.1 else 0

/-- Precisely the original comparable pairs survive the zero fiber. -/
theorem sortPair_eq_and_defect_zero (u v : Cell n) (q : SortedPair n) :
    sortPair u v = q ∧ defectExponent u v = 0 ↔
      (u = q.val.1 ∧ v = q.val.2) ∨ (u = q.val.2 ∧ v = q.val.1) := by
  constructor
  · rintro ⟨hs, hd⟩
    rcases (defectExponent_eq_zero_iff u v).mp hd with huv | hvu
    · have he := congrArg Subtype.val ((sortPair_of_le huv).symm.trans hs)
      exact Or.inl ⟨congrArg Prod.fst he, congrArg Prod.snd he⟩
    · have he := congrArg Subtype.val
        ((sortPair_of_le hvu).symm.trans ((sortPair_comm v u).trans hs))
      exact Or.inr ⟨congrArg Prod.snd he, congrArg Prod.fst he⟩
  · rintro (⟨hu, hv⟩ | ⟨hu, hv⟩)
    · subst u; subst v
      exact ⟨sortPair_of_le q.property,
        (defectExponent_eq_zero_iff _ _).mpr (Or.inl q.property)⟩
    · subst u; subst v
      exact ⟨(sortPair_comm _ _).trans (sortPair_of_le q.property),
        (defectExponent_eq_zero_iff _ _).mpr (Or.inr q.property)⟩

theorem zero_fiber_term (u v : Cell n) (q : SortedPair n) (a : K) :
    (if sortPair u v = q then (0 : K) ^ defectExponent u v * a else 0) =
      if (u = q.val.1 ∧ v = q.val.2) ∨ (u = q.val.2 ∧ v = q.val.1) then a else 0 := by
  classical
  by_cases hs : sortPair u v = q
  · by_cases hd : defectExponent u v = 0
    · have h := (sortPair_eq_and_defect_zero u v q).mp ⟨hs, hd⟩
      simp only [if_pos hs, hd, pow_zero, one_mul, if_pos h]
    · have h : ¬ ((u = q.val.1 ∧ v = q.val.2) ∨
          (u = q.val.2 ∧ v = q.val.1)) := by
        intro h
        exact hd ((sortPair_eq_and_defect_zero u v q).mpr h).2
      simp only [if_pos hs, zero_pow hd, zero_mul, if_neg h]
  · have h : ¬ ((u = q.val.1 ∧ v = q.val.2) ∨
        (u = q.val.2 ∧ v = q.val.1)) := by
      intro h
      exact hs ((sortPair_eq_and_defect_zero u v q).mpr h).1
    simp only [if_neg hs, if_neg h]

/-- The surviving square coefficient is the ordinary product coefficient, with
no factor of two. -/
theorem fiber_zero_square (A : Matrix (Cell n) J K) (j : J) (u v : Cell n) :
    multiplicationMatrix 0 A ⟨(u, u), le_rfl⟩ (j, v) =
      if v = u then A u j else 0 := by
  classical
  unfold multiplicationMatrix
  simp_rw [zero_fiber_term]
  by_cases h : v = u
  · subst v
    simp
  · simp [h]

/-- A surviving strict comparable-pair coefficient is the sum of the two
ordinary cross terms. Incomparable monomials vanish at this fiber. -/
theorem fiber_zero_edge (A : Matrix (Cell n) J K) (j : J)
    (q : SortedPair n) (hq : q.val.1 ≠ q.val.2) (v : Cell n) :
    multiplicationMatrix 0 A q (j, v) =
      (if v = q.val.2 then A q.val.1 j else 0) +
        (if v = q.val.1 then A q.val.2 j else 0) := by
  classical
  unfold multiplicationMatrix
  simp_rw [zero_fiber_term]
  by_cases hv₁ : v = q.val.1
  · subst v
    simp [hq]
  · by_cases hv₂ : v = q.val.2
    · subst v
      simp [hq, Ne.symm hq]
    · simp [hv₁, hv₂]

/-- Torus rescaling of the coefficient rows by the staircase weights. -/
def scaleForms (t : K) (A : Matrix (Cell n) J K) : Matrix (Cell n) J K :=
  fun u j => t ^ weight u * A u j

/-- The weight identity gives the exact source/target diagonal change between a
nonzero family fiber and the Segre multiplication matrix. -/
theorem matrix_scaling (t : K) (A : Matrix (Cell n) J K) :
    Matrix.diagonal (fun q : SortedPair n => t ^ targetWeight q) *
        multiplicationMatrix t A =
      multiplicationMatrix 1 (scaleForms t A) *
        Matrix.diagonal (fun jv : J × Cell n => t ^ weight jv.2) := by
  classical
  ext q jv
  simp only [Matrix.diagonal_mul, Matrix.mul_diagonal, multiplicationMatrix,
    scaleForms, one_pow, one_mul]
  rw [Finset.mul_sum, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro u _
  by_cases h : sortPair u jv.2 = q
  · simp only [if_pos h]
    have hw := weight_identity u jv.2
    rw [h] at hw
    calc
      t ^ targetWeight q * (t ^ defectExponent u jv.2 * A u jv.1) =
          t ^ (targetWeight q + defectExponent u jv.2) * A u jv.1 := by
            rw [pow_add, mul_assoc]
      _ = t ^ (weight u + weight jv.2) * A u jv.1 := by rw [← hw]
      _ = (t ^ weight u * A u jv.1) * t ^ weight jv.2 := by
            rw [pow_add]
            ring
  · simp only [if_neg h, mul_zero, zero_mul]

/-- Every nonzero family fiber has exactly the multiplication rank of a Segre
fiber, after rescaling its forms. -/
theorem rank_nonzero_fiber (t : K) (ht : t ≠ 0) (A : Matrix (Cell n) J K) :
    (multiplicationMatrix t A).rank =
      (multiplicationMatrix 1 (scaleForms t A)).rank := by
  classical
  have hrow : (Matrix.diagonal (fun q : SortedPair n => t ^ targetWeight q)).det ≠ 0 := by
    rw [Matrix.det_diagonal]
    exact Finset.prod_ne_zero_iff.mpr fun q _ => pow_ne_zero _ ht
  have hcol : (Matrix.diagonal (fun jv : J × Cell n => t ^ weight jv.2)).det ≠ 0 := by
    rw [Matrix.det_diagonal]
    exact Finset.prod_ne_zero_iff.mpr fun q _ => pow_ne_zero _ ht
  calc
    (multiplicationMatrix t A).rank =
        (Matrix.diagonal (fun q : SortedPair n => t ^ targetWeight q) *
          multiplicationMatrix t A).rank :=
      (Matrix.rank_mul_eq_right_of_det_ne_zero _ _ hrow).symm
    _ = (multiplicationMatrix 1 (scaleForms t A) *
          Matrix.diagonal (fun jv : J × Cell n => t ^ weight jv.2)).rank := by
      rw [matrix_scaling]
    _ = (multiplicationMatrix 1 (scaleForms t A)).rank :=
      Matrix.rank_mul_eq_left_of_det_ne_zero _ _ hcol

/-- A linear form in the actual Segre degree-one component, as a literal
polynomial in the original factor coordinates. -/
noncomputable def segreForm (A : Matrix (Cell n) J K) (j : J) :
    MvPolynomial (Variables n) K :=
  ∑ u, A u j • cellPolynomial u

/-- Every column of the fiber at one is exactly multiplication of its Segre
form by the corresponding degree-one coordinate. -/
theorem fiber_one_column (A : Matrix (Cell n) J K) (j : J) (v : Cell n) :
    ∑ q, multiplicationMatrix 1 A q (j, v) • sortedMonomial (K := K) q =
      segreForm A j * cellPolynomial (K := K) v := by
  classical
  simp only [multiplicationMatrix, one_pow, one_mul, Finset.sum_smul]
  rw [Finset.sum_comm]
  have hcol (u : Cell n) :
      (∑ q : SortedPair n,
        (if sortPair u v = q then A u j else 0) • sortedMonomial (K := K) q) =
      A u j • (cellPolynomial (K := K) u * cellPolynomial v) := by
    rw [Finset.sum_eq_single (sortPair u v)]
    · simp only [if_pos rfl]
      rw [sortedMonomial_eq_mul]
      change A u j •
        (cellPolynomial (K := K) (meet u v) * cellPolynomial (join u v)) = _
      rw [← cellPolynomial_mul_sort]
    · intro q _ hq
      simp only [if_neg (Ne.symm hq), zero_smul]
    · simp
  simp_rw [hcol]
  simp only [segreForm, Finset.sum_mul, smul_mul_assoc]

abbrev Parameters (n : I → ℕ) (J : Type*) := Option (Cell n × J)

/-- The coefficient variables, together with one independent degeneration
parameter. -/
noncomputable def universalMatrix :
    Matrix (SortedPair n) (J × Cell n) (MvPolynomial (Parameters n J) K) :=
  multiplicationMatrix (X none) (fun u j => X (some (u, j)))

def parameterPoint (t : K) (A : Matrix (Cell n) J K) : Parameters n J → K
  | none => t
  | some (u, j) => A u j

theorem eval_universalMatrix (t : K) (A : Matrix (Cell n) J K) :
    (universalMatrix (K := K) (n := n) (J := J)).map
        (MvPolynomial.eval (parameterPoint t A)) = multiplicationMatrix t A := by
  classical
  ext q jv
  simp only [universalMatrix, multiplicationMatrix, Matrix.map_apply, map_sum]
  apply Finset.sum_congr rfl
  intro u _
  split_ifs <;> simp [parameterPoint]

/-- Every rank attained by the zero fiber is attained by actual degree-two Segre
multiplication. The field is arbitrary apart from infinitude, which is exactly
what is required to avoid the zeros of a nonzero minor polynomial. -/
theorem rank_transfer_from_zero [Infinite K]
    (A₀ : Matrix (Cell n) J K) (r : ℕ)
    (h₀ : r ≤ (multiplicationMatrix 0 A₀).rank) :
    ∃ A : Matrix (Cell n) J K, r ≤ (multiplicationMatrix 1 A).rank := by
  classical
  let M := universalMatrix (K := K) (n := n) (J := J)
  obtain ⟨rows, cols, hminor⟩ := Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mp h₀
  let f : MvPolynomial (Parameters n J) K := (M.submatrix rows cols).det
  have hf : f ≠ 0 := by
    intro hz
    apply hminor
    rw [← eval_universalMatrix 0 A₀]
    simp only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    change MvPolynomial.eval (parameterPoint 0 A₀) f = 0
    rw [hz, map_zero]
  have hx : (X (none : Parameters n J) : MvPolynomial (Parameters n J) K) ≠ 0 :=
    MvPolynomial.X_ne_zero none
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero (f * X none) (mul_ne_zero hf hx)
  rw [map_mul, MvPolynomial.eval_X] at hz
  have hfz := (mul_ne_zero_iff.mp hz).1
  have htz := (mul_ne_zero_iff.mp hz).2
  let t := z none
  let A : Matrix (Cell n) J K := fun u j => z (some (u, j))
  have hpoint : parameterPoint t A = z := by
    funext x
    cases x with
    | none => rfl
    | some q => cases q; rfl
  have hr : r ≤ (multiplicationMatrix t A).rank := by
    apply Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mpr
    refine ⟨rows, cols, ?_⟩
    rw [← eval_universalMatrix t A]
    simp only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    change MvPolynomial.eval (parameterPoint t A) f ≠ 0
    rw [hpoint]
    exact hfz
  refine ⟨scaleForms t A, ?_⟩
  rw [← rank_nonzero_fiber t htz A]
  exact hr

end PaperVerification.Segre.Degeneration
end
end ProbeLayer38

section ProbeLayer39



/-!
# The unrestricted degree-two baseline rank

The rank-sum syzygy theorem gives the exact rank of the zero-fiber
multiplication matrix for `d = 1 + sum nᵢ` forms. The verified polynomial
degeneration then transfers this lower bound to genuine Segre multiplication.
This is a degree-two proof, independent of a whole-ring Cohen--Macaulay theorem.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.BaselineRank

open Staircase Monomials Degeneration RankParameters KoszulDimension Matrix
open scoped Matrix

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

/-- Rearrange multiplier coefficients into the column order of the actual
degeneration matrix. -/
def flattenCoefficients : Matrix (Cell n) (Ranks n) K ≃ₗ[K] (Ranks n × Cell n → K) where
  toFun U rv := U rv.2 rv.1
  invFun z u r := z (r,u)
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

noncomputable def zeroMap : Matrix (Cell n) (Ranks n) K →ₗ[K] (SortedPair n → K) :=
  (multiplicationMatrix 0 (rankForms (K := K) (n := n))).mulVecLin.comp
    flattenCoefficients.toLinearMap

theorem zeroMap_square (U : Matrix (Cell n) (Ranks n) K) (u : Cell n) :
    zeroMap U ⟨(u,u), le_rfl⟩ = U u (rankIndex u) := by
  classical
  change (∑ rv : Ranks n × Cell n,
    multiplicationMatrix 0 rankForms ⟨(u,u), le_rfl⟩ rv * U rv.2 rv.1) = _
  rw [Fintype.sum_prod_type]
  simp [fiber_zero_square, rankForms, ite_mul]

theorem zeroMap_edge (U : Matrix (Cell n) (Ranks n) K)
    (q : SortedPair n) (hne : q.val.1 ≠ q.val.2) :
    zeroMap U q = U q.val.2 (rankIndex q.val.1) + U q.val.1 (rankIndex q.val.2) := by
  classical
  change (∑ rv : Ranks n × Cell n,
    multiplicationMatrix 0 rankForms q rv * U rv.2 rv.1) = _
  rw [Fintype.sum_prod_type]
  have he (r : Ranks n) (v : Cell n) := fiber_zero_edge (rankForms (K := K)) r q hne v
  simp [he, rankForms, add_mul, ite_mul, Finset.sum_add_distrib]

/-- The zero-fiber matrix has exactly the square and edge equations used in
the literal polynomial-quotient theorem. -/
theorem zeroMap_eq_zero_iff_conditions (U : Matrix (Cell n) (Ranks n) K) :
    zeroMap U = 0 ↔ Conditions U := by
  constructor
  · intro h
    constructor
    · intro u
      have he := congrFun h ⟨(u,u), le_rfl⟩
      simpa only [zeroMap_square, Pi.zero_apply] using he
    · intro u v hne hcomp
      rcases hcomp with huv | hvu
      · have he := congrFun h ⟨(u,v), huv⟩
        rw [zeroMap_edge U _ hne] at he
        simpa only [Pi.zero_apply, add_comm] using he
      · have he := congrFun h ⟨(v,u), hvu⟩
        rw [zeroMap_edge U _ hne.symm] at he
        exact he
  · intro h
    funext q
    rcases q with ⟨⟨u,v⟩, huv⟩
    by_cases he : u = v
    · subst v
      exact (zeroMap_square U u).trans (h.1 u)
    · rw [zeroMap_edge U _ he]
      exact h.2 v u (Ne.symm he) (Or.inr huv)

/-- The entire zero-fiber kernel is the actual alternating Koszul image. -/
theorem zeroMap_kernel : LinearMap.ker (zeroMap (K := K) (n := n)) =
    LinearMap.range (koszulMatrix (rankForms (K := K) (n := n))) := by
  ext U
  rw [LinearMap.mem_ker, zeroMap_eq_zero_iff_conditions,
    conditions_iff_alternating_boundary]
  constructor
  · rintro ⟨Q, hQ⟩
    exact ⟨Q, hQ.symm⟩
  · rintro ⟨Q, hQ⟩
    exact ⟨Q, hQ.symm⟩

theorem zeroMap_matrix_rank :
    (multiplicationMatrix 0 (rankForms (K := K) (n := n))).rank =
      Module.finrank K (LinearMap.range (zeroMap (K := K) (n := n))) := by
  rw [zeroMap, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top]
  rfl

/-- Exact baseline multiplication rank for every finite product of chains,
including arbitrary zero or positive chain lengths and every characteristic. -/
theorem rank_zero_fiber :
    (multiplicationMatrix 0 (rankForms (K := K) (n := n))).rank =
      Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2 := by
  have hnull := (zeroMap (K := K) (n := n)).finrank_range_add_finrank_ker
  rw [zeroMap_kernel,
    finrank_koszulMatrix_range rankForms rankForms_surjective] at hnull
  have hdom : Module.finrank K (Matrix (Cell n) (Ranks n) K) =
      Fintype.card (Cell n) * (sideSum n + 1) := by
    simp [Module.finrank_matrix, Ranks]
  rw [hdom, Fintype.card_fin] at hnull
  rw [zeroMap_matrix_rank]
  omega

/-- The same baseline lower bound is attained by literal Segre degree-two
multiplication over every infinite field, with no restriction on the number
of factors or their chain lengths. -/
theorem exists_segre_baseline_rank [Infinite K] :
    ∃ A : Matrix (Cell n) (Ranks n) K,
      Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2 ≤
        (multiplicationMatrix 1 A).rank := by
  apply rank_transfer_from_zero (rankForms (K := K) (n := n))
  exact (rank_zero_fiber (K := K) (n := n)).ge

end PaperVerification.Segre.BaselineRank
end
end ProbeLayer39

section ProbeLayer40



/-!
# The universal Koszul upper bound for actual Segre multiplication

All ordinary pair relations vanish under the actual degree-two Segre matrix.
Alternating matrices span precisely those relations, including in characteristic
two. Independent forms therefore give the universal rank upper bound, and an
attained lower bound forces complete degree-two exactness.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.KoszulRank

open Staircase Monomials Degeneration KoszulDimension Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

def flatten : Matrix (Cell n) D K ≃ₗ[K] (D × Cell n → K) where
  toFun U rv := U rv.2 rv.1
  invFun z u r := z (r,u)
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The actual degree-two multiplication map, in the sorted monomial basis. -/
noncomputable def multiplication (A : Matrix (Cell n) D K) :
    Matrix (Cell n) D K →ₗ[K] (SortedPair n → K) :=
  (multiplicationMatrix 1 A).mulVecLin.comp flatten.toLinearMap

theorem pair_columns (A : Matrix (Cell n) D K) (i j : D) (q : SortedPair n) :
    (∑ v, multiplicationMatrix 1 A q (j,v) * A v i) =
      ∑ v, multiplicationMatrix 1 A q (i,v) * A v j := by
  classical
  simp only [multiplicationMatrix, one_pow, one_mul, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro v _
  apply Finset.sum_congr rfl
  intro u _
  rw [sortPair_comm v u]
  split_ifs <;> simp [mul_comm]

/-- Each elementary Koszul pair maps to zero by commutativity of actual Segre
multiplication, proved directly in the multiplication matrix. -/
theorem multiplication_pair_zero (A : Matrix (Cell n) D K) (i j : D) :
    multiplication A (koszulMatrix A (pairAlternating i j)) = 0 := by
  classical
  funext q
  change (∑ rv : D × Cell n, multiplicationMatrix 1 A q rv *
    koszulMatrix A (pairAlternating i j) rv.2 rv.1) = 0
  rw [Fintype.sum_prod_type, Finset.sum_comm]
  simp only [koszulMatrix_pair_apply, mul_sub, mul_ite, mul_zero,
    Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [pair_columns, sub_self]

/-- Every alternating Koszul boundary maps to zero; no restriction on
characteristic is used. -/
theorem multiplication_koszul_zero (A : Matrix (Cell n) D K)
    (Q : alternatingMatrices K D) : multiplication A (koszulMatrix A Q) = 0 := by
  classical
  let decD : DecidableEq D := inferInstance
  let orderD : LinearOrder D := LinearOrder.lift' (Fintype.equivFin D)
    (Fintype.equivFin D).injective
  letI : LinearOrder D := { orderD with
    toDecidableEq := decD
    compare := fun a b => @compareOfLessAndEq D a b orderD.toLT
      (orderD.toDecidableLT a b) decD
    compare_eq_compareOfLessAndEq := fun _ _ => rfl }
  obtain ⟨c, hQ⟩ := exists_sum_pairAlternating Q
  rw [hQ, map_sum, map_sum]
  apply Finset.sum_eq_zero
  intro q _
  rw [map_smul, map_smul, multiplication_pair_zero, smul_zero]

theorem koszul_range_le_kernel (A : Matrix (Cell n) D K) :
    LinearMap.range (koszulMatrix A) ≤ LinearMap.ker (multiplication A) := by
  rintro U ⟨Q, rfl⟩
  exact multiplication_koszul_zero A Q

theorem multiplication_matrix_rank (A : Matrix (Cell n) D K) :
    (multiplicationMatrix 1 A).rank =
      Module.finrank K (LinearMap.range (multiplication A)) := by
  rw [multiplication, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top]
  rfl

/-- The universal rank bound supplied by independent Koszul boundaries. -/
theorem rank_upper_bound (A : Matrix (Cell n) D K)
    (hA : Function.Surjective A.vecMul) :
    (multiplicationMatrix 1 A).rank ≤
      Fintype.card (Cell n) * Fintype.card D - (Fintype.card D).choose 2 := by
  have hle := Submodule.finrank_mono (koszul_range_le_kernel A)
  rw [finrank_koszulMatrix_range A hA] at hle
  have hn := (multiplication A).finrank_range_add_finrank_ker
  have hd : Module.finrank K (Matrix (Cell n) D K) =
      Fintype.card (Cell n) * Fintype.card D := by simp [Module.finrank_matrix]
  rw [hd] at hn
  rw [multiplication_matrix_rank]
  omega

/-- Attaining the Koszul rank bound proves exactness, rather than merely a
numerical rank statement. Every multiplication syzygy is an ordinary boundary. -/
theorem kernel_eq_koszul_range_of_rank_bound (A : Matrix (Cell n) D K)
    (hA : Function.Surjective A.vecMul)
    (hr : Fintype.card (Cell n) * Fintype.card D - (Fintype.card D).choose 2 ≤
      (multiplicationMatrix 1 A).rank) :
    LinearMap.ker (multiplication A) = LinearMap.range (koszulMatrix A) := by
  apply (Submodule.eq_of_le_of_finrank_le (koszul_range_le_kernel A) ?_).symm
  rw [finrank_koszulMatrix_range A hA]
  have hn := (multiplication A).finrank_range_add_finrank_ker
  have hd : Module.finrank K (Matrix (Cell n) D K) =
      Fintype.card (Cell n) * Fintype.card D := by simp [Module.finrank_matrix]
  rw [hd] at hn
  rw [multiplication_matrix_rank] at hr
  omega

end PaperVerification.Segre.KoszulRank
end
end ProbeLayer40

section ProbeLayer41



/-!
# Finite simultaneous generic rank conditions

Each attainable rank bound has a particular nonzero minor polynomial witnessing
it. A product of these witnesses imposes arbitrarily many finite rank conditions
simultaneously over an infinite field, and can avoid any further nonzero
polynomial. No topological or genericity assertion is assumed.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericRank

variable {K σ : Type*} [Field K]

/-- A single nonzero minor polynomial witnesses any attainable rank lower bound. -/
theorem minor_witness {m n : Type*} [Finite m] [Fintype n]
    (A : Matrix m n (MvPolynomial σ K)) (a : σ → K) (r : ℕ)
    (ha : r ≤ (A.map (MvPolynomial.eval a)).rank) :
    ∃ f : MvPolynomial σ K, f ≠ 0 ∧
      ∀ t : σ → K, MvPolynomial.eval t f ≠ 0 →
        r ≤ (A.map (MvPolynomial.eval t)).rank := by
  obtain ⟨rows, cols, hminor⟩ := Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mp ha
  let f : MvPolynomial σ K := (A.submatrix rows cols).det
  refine ⟨f, ?_, ?_⟩
  · intro hf
    apply hminor
    simp only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    change MvPolynomial.eval a f = 0
    rw [hf, map_zero]
  · intro t ht
    apply Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mpr
    refine ⟨rows, cols, ?_⟩
    simpa only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      using ht

/-- Finitely many independently attainable rank bounds can be attained together,
while avoiding an arbitrary additional nonzero polynomial. Row and column index
types may differ between the matrices. -/
theorem exists_rank_bounds_avoiding [Infinite K]
    {ι : Type*} [Fintype ι] {m n : ι → Type*}
    [∀ i, Finite (m i)] [∀ i, Fintype (n i)]
    (A : ∀ i, Matrix (m i) (n i) (MvPolynomial σ K))
    (a : ι → σ → K) (r : ι → ℕ)
    (ha : ∀ i, r i ≤ ((A i).map (MvPolynomial.eval (a i))).rank)
    (g : MvPolynomial σ K) (hg : g ≠ 0) :
    ∃ t : σ → K, MvPolynomial.eval t g ≠ 0 ∧
      ∀ i, r i ≤ ((A i).map (MvPolynomial.eval t)).rank := by
  classical
  choose f hf hw using fun i => minor_witness (A i) (a i) (r i) (ha i)
  have hp : (∏ i, f i) * g ≠ 0 :=
    mul_ne_zero (Finset.prod_ne_zero_iff.mpr fun i _ => hf i) hg
  obtain ⟨t, ht⟩ := GenericMatrixRank.exists_eval_ne_zero ((∏ i, f i) * g) hp
  rw [map_mul, map_prod] at ht
  refine ⟨t, (mul_ne_zero_iff.mp ht).2, ?_⟩
  intro i
  apply hw i t
  exact Finset.prod_ne_zero_iff.mp (mul_ne_zero_iff.mp ht).1 i (Finset.mem_univ _)

/-- The finite simultaneous-rank theorem without an extra avoided locus. -/
theorem exists_rank_bounds [Infinite K]
    {ι : Type*} [Fintype ι] {m n : ι → Type*}
    [∀ i, Finite (m i)] [∀ i, Fintype (n i)]
    (A : ∀ i, Matrix (m i) (n i) (MvPolynomial σ K))
    (a : ι → σ → K) (r : ι → ℕ)
    (ha : ∀ i, r i ≤ ((A i).map (MvPolynomial.eval (a i))).rank) :
    ∃ t : σ → K, ∀ i, r i ≤ ((A i).map (MvPolynomial.eval t)).rank := by
  obtain ⟨t, _, ht⟩ := exists_rank_bounds_avoiding A a r ha 1 one_ne_zero
  exact ⟨t, ht⟩


section Fibers

variable {U D : Type*}

/-- Join an old parameter matrix and the coefficients of one additional form. -/
def joinCoefficients (A : U → D → K) (ℓ : U → K) : U × Option D → K :=
  fun j => j.2.elim (ℓ j.1) (A j.1)

/-- Fix the additional form while retaining every old parameter variable. -/
noncomputable def specializeForm (ℓ : U → K) :
    MvPolynomial (U × Option D) K →+* MvPolynomial (U × D) K :=
  MvPolynomial.eval₂Hom MvPolynomial.C (fun j =>
    j.2.elim (MvPolynomial.C (ℓ j.1)) (fun d => MvPolynomial.X (j.1,d)))

/-- Fix the old parameter matrix while retaining every coefficient of the form. -/
noncomputable def specializeParameters (A : U → D → K) :
    MvPolynomial (U × Option D) K →+* MvPolynomial U K :=
  MvPolynomial.eval₂Hom MvPolynomial.C (fun j =>
    j.2.elim (MvPolynomial.X j.1) (fun d => MvPolynomial.C (A j.1 d)))

theorem eval_specializeForm (A : U → D → K) (ℓ : U → K)
    (f : MvPolynomial (U × Option D) K) :
    MvPolynomial.eval (fun j => A j.1 j.2) (specializeForm ℓ f) =
      MvPolynomial.eval (joinCoefficients A ℓ) f := by
  have he : (MvPolynomial.eval (fun j : U × D => A j.1 j.2)).comp
      (specializeForm ℓ) = MvPolynomial.eval (joinCoefficients A ℓ) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply,specializeForm,MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval_C]
    · intro j
      rcases j with ⟨u,_ | d⟩ <;>
        simp only [RingHom.comp_apply,specializeForm,MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval_C,MvPolynomial.eval_X,joinCoefficients,Option.elim_none,
          Option.elim_some]
  exact congrArg (fun φ : MvPolynomial (U × Option D) K →+* K => φ f) he

theorem eval_specializeParameters (A : U → D → K) (ℓ : U → K)
    (f : MvPolynomial (U × Option D) K) :
    MvPolynomial.eval ℓ (specializeParameters A f) =
      MvPolynomial.eval (joinCoefficients A ℓ) f := by
  have he : (MvPolynomial.eval ℓ).comp (specializeParameters A) =
      MvPolynomial.eval (joinCoefficients A ℓ) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply,specializeParameters,MvPolynomial.eval₂Hom_C,
        MvPolynomial.eval_C]
    · intro j
      rcases j with ⟨u,_ | d⟩ <;>
        simp only [RingHom.comp_apply,specializeParameters,MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval_C,MvPolynomial.eval_X,joinCoefficients,Option.elim_none,
          Option.elim_some]
  exact congrArg (fun φ : MvPolynomial (U × Option D) K →+* K => φ f) he

/-- A nonempty principal open in the joint parameter/form space contains a
nonempty principal open of old parameter choices with nonempty principal-open
fibers in the form coefficients. This proves the iterated generic quantifier,
rather than silently replacing it by one specially chosen parameter family. -/
theorem joint_certificate_has_generic_fibers [Infinite K]
    (f : MvPolynomial (U × Option D) K) (hf : f ≠ 0) :
    ∃ g : MvPolynomial (U × D) K, g ≠ 0 ∧
      ∀ A : U → D → K, MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 →
        ∃ h : MvPolynomial U K, h ≠ 0 ∧ ∀ ℓ : U → K,
          MvPolynomial.eval ℓ h ≠ 0 → MvPolynomial.eval (joinCoefficients A ℓ) f ≠ 0 := by
  obtain ⟨t,ht⟩ := GenericMatrixRank.exists_eval_ne_zero f hf
  let A₀ : U → D → K := fun u d => t (u,some d)
  let ℓ₀ : U → K := fun u => t (u,none)
  have hj : joinCoefficients A₀ ℓ₀ = t := by
    funext j
    rcases j with ⟨u,_ | d⟩ <;> rfl
  have hg : specializeForm ℓ₀ f ≠ 0 := by
    intro hz
    have he := eval_specializeForm A₀ ℓ₀ f
    rw [hz,map_zero,hj] at he
    exact ht he.symm
  refine ⟨specializeForm ℓ₀ f,hg,?_⟩
  intro A hA
  refine ⟨specializeParameters A f,?_,?_⟩
  · intro hz
    have he := eval_specializeParameters A ℓ₀ f
    rw [hz,map_zero,← eval_specializeForm A ℓ₀ f] at he
    exact hA he.symm
  · intro ℓ hℓ
    rwa [eval_specializeParameters] at hℓ

end Fibers

end PaperVerification.Segre.GenericRank
end
end ProbeLayer41

section ProbeLayer42



/-!
# Degree-two exactness for the actual Segre rank-sum parameters

The staircase weight is constant on every rank. Rescaling a nonzero family
fiber therefore rescales the rank-sum forms individually. A one-parameter
minor argument transfers the baseline rank to the very same rank-sum forms
in the actual Segre multiplication matrix, rather than to a perturbed family.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.FixedRankParameters

open Staircase Monomials Degeneration RankParameters KoszulDimension Matrix MvPolynomial
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

theorem multiplicationMatrix_scale_columns (A : Matrix (Cell n) D K) (c : D → K) :
    multiplicationMatrix 1 (fun u j => c j * A u j) =
      multiplicationMatrix 1 A * Matrix.diagonal (fun jv : D × Cell n => c jv.1) := by
  classical
  ext q jv
  rw [Matrix.mul_diagonal]
  simp only [multiplicationMatrix, one_pow, one_mul]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro u _
  split_ifs <;> simp [mul_comm]

def rankWeight (r : Ranks n) : ℕ := r.val * (sideSum n - r.val)

theorem scaleForms_rankForms (t : K) :
    scaleForms t (rankForms (K := K) (n := n)) =
      fun u r => t ^ rankWeight r * rankForms u r := by
  ext u r
  by_cases h : rankIndex u = r
  · have hr : rank u = r.val := congrArg Fin.val h
    simp [scaleForms, rankForms, h, rankWeight, weight, hr]
  · simp [scaleForms, rankForms, h]

theorem rank_scaleForms_rankForms (t : K) (ht : t ≠ 0) :
    (multiplicationMatrix 1 (scaleForms t (rankForms (K := K) (n := n)))).rank =
      (multiplicationMatrix 1 (rankForms (K := K) (n := n))).rank := by
  rw [scaleForms_rankForms, multiplicationMatrix_scale_columns]
  apply Matrix.rank_mul_eq_left_of_det_ne_zero
  rw [Matrix.det_diagonal]
  exact Finset.prod_ne_zero_iff.mpr fun jv _ => pow_ne_zero _ ht

/-- A family with just the degeneration parameter; the rank-sum coefficients
are fixed throughout. -/
noncomputable def fixedFamily :
    Matrix (SortedPair n) (Ranks n × Cell n) (MvPolynomial Unit K) :=
  multiplicationMatrix (X Unit.unit)
    (fun u r => C (rankForms (K := K) (n := n) u r))

theorem eval_fixedFamily (t : K) :
    (fixedFamily (K := K) (n := n)).map (MvPolynomial.eval (fun _ : Unit => t)) =
      multiplicationMatrix t (rankForms (K := K) (n := n)) := by
  classical
  ext q rv
  simp only [fixedFamily, Matrix.map_apply, multiplicationMatrix, map_sum]
  apply Finset.sum_congr rfl
  intro u _
  split_ifs <;> simp

/-- The zero-fiber lower bound survives at the fixed rank-sum forms themselves. -/
theorem fixed_rank_lower_bound [Infinite K] :
    Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2 ≤
      (multiplicationMatrix 1 (rankForms (K := K) (n := n))).rank := by
  classical
  let b := Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2
  have h0 : b ≤ ((fixedFamily (K := K) (n := n)).map
      (MvPolynomial.eval (fun _ : Unit => 0))).rank := by
    rw [eval_fixedFamily]
    exact (BaselineRank.rank_zero_fiber (K := K) (n := n)).ge
  obtain ⟨f, hf, hw⟩ := GenericRank.minor_witness fixedFamily (fun _ : Unit => 0) b h0
  have hx : (X Unit.unit : MvPolynomial Unit K) ≠ 0 := MvPolynomial.X_ne_zero _
  obtain ⟨z, hz⟩ := GenericMatrixRank.exists_eval_ne_zero (f * X Unit.unit)
    (mul_ne_zero hf hx)
  rw [map_mul, MvPolynomial.eval_X] at hz
  have htz := (mul_ne_zero_iff.mp hz).2
  have hr := hw z (mul_ne_zero_iff.mp hz).1
  let t := z Unit.unit
  have he : (fun _ : Unit => t) = z := by
    funext u
    cases u
    rfl
  rw [← he, eval_fixedFamily, rank_nonzero_fiber t htz,
    rank_scaleForms_rankForms t htz] at hr
  exact hr

/-- Exact degree-two rank at the actual Segre antidiagonal parameters in every
characteristic over an infinite field, including every algebraically closed field. -/
theorem fixed_rank_exact [Infinite K] :
    (multiplicationMatrix 1 (rankForms (K := K) (n := n))).rank =
      Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2 := by
  apply le_antisymm
  · simpa only [Ranks, Fintype.card_fin] using
      KoszulRank.rank_upper_bound (rankForms (K := K) (n := n)) rankForms_surjective
  · exact fixed_rank_lower_bound

/-- Exactness, not merely a rank calculation: every actual Segre degree-two
syzygy of the rank sums is an ordinary Koszul boundary. -/
theorem fixed_rank_parameter_exactness [Infinite K] :
    LinearMap.ker (KoszulRank.multiplication (rankForms (K := K) (n := n))) =
      LinearMap.range (koszulMatrix (rankForms (K := K) (n := n))) := by
  apply KoszulRank.kernel_eq_koszul_range_of_rank_bound _ rankForms_surjective
  simpa only [Ranks, Fintype.card_fin] using
    fixed_rank_lower_bound (K := K) (n := n)

end PaperVerification.Segre.FixedRankParameters
end
end ProbeLayer42

section ProbeLayer43



/-!
# Actual polynomial parameter products and their degree-two quotient

The multiplication matrix is identified with the span of literal products
`θⱼ yᵥ` in the polynomial algebra on the factor coordinates. Thus its rank
computes the dimension of an actual polynomial subspace, not a substitute
definition of the desired rank. The quotient below is the degree-two Segre
component modulo precisely that product subspace.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ParameterProducts

open Staircase Monomials Degeneration RankParameters Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I]
  [Fintype D] [DecidableEq D] [Field K] {n : I → ℕ}

/-- The literal polynomial span of the products of the chosen parameter forms
with every degree-one Segre monomial. -/
noncomputable def productSpan (A : Matrix (Cell n) D K) :
    Submodule K (MvPolynomial (Variables n) K) :=
  Submodule.span K (Set.range fun rv : D × Cell n => segreForm A rv.1 * cellPolynomial rv.2)

noncomputable def evaluateTwo : (SortedPair n → K) →ₗ[K] MvPolynomial (Variables n) K :=
  Fintype.linearCombination K (sortedMonomial (K := K) (n := n))

theorem evaluateTwo_injective : Function.Injective (evaluateTwo (K := K) (n := n)) :=
  (sortedMonomial_linearIndependent (K := K) (n := n)).fintypeLinearCombination_injective

noncomputable def evaluatedMultiplication (A : Matrix (Cell n) D K) :
    (D × Cell n → K) →ₗ[K] MvPolynomial (Variables n) K :=
  evaluateTwo.comp (multiplicationMatrix 1 A).mulVecLin

theorem evaluatedMultiplication_single (A : Matrix (Cell n) D K) (rv : D × Cell n) :
    evaluatedMultiplication A (Pi.single rv (1 : K)) =
      segreForm A rv.1 * cellPolynomial rv.2 := by
  change evaluateTwo ((multiplicationMatrix 1 A) *ᵥ Pi.single rv (1 : K)) = _
  rw [Matrix.mulVec_single_one]
  change (∑ q, multiplicationMatrix 1 A q rv • sortedMonomial (K := K) q) = _
  exact fiber_one_column A rv.1 rv.2

/-- Equality of actual polynomial maps, verified on all coefficients. -/
theorem evaluatedMultiplication_eq (A : Matrix (Cell n) D K) :
    evaluatedMultiplication A = Fintype.linearCombination K
      (fun rv : D × Cell n => segreForm A rv.1 * cellPolynomial rv.2) := by
  classical
  apply LinearMap.ext
  intro z
  have hz : z = ∑ rv, z rv • Pi.single rv (1 : K) := by
    funext rv
    simp [Pi.single_apply]
  calc
    evaluatedMultiplication A z =
        ∑ rv, z rv • evaluatedMultiplication A (Pi.single rv (1 : K)) := by
      conv_lhs => rw [hz]
      simp only [map_sum, map_smul]
    _ = ∑ rv, z rv • (segreForm A rv.1 * cellPolynomial rv.2) := by
      simp only [evaluatedMultiplication_single]
    _ = _ := rfl

theorem range_evaluatedMultiplication (A : Matrix (Cell n) D K) :
    LinearMap.range (evaluatedMultiplication A) = productSpan A := by
  rw [evaluatedMultiplication_eq, Fintype.range_linearCombination]
  rfl

theorem kernel_evaluatedMultiplication (A : Matrix (Cell n) D K) :
    LinearMap.ker (evaluatedMultiplication A) =
      LinearMap.ker (multiplicationMatrix 1 A).mulVecLin := by
  ext z
  change evaluateTwo ((multiplicationMatrix 1 A).mulVecLin z) = 0 ↔
    (multiplicationMatrix 1 A).mulVecLin z = 0
  constructor
  · intro hz
    apply evaluateTwo_injective
    exact hz.trans (map_zero (evaluateTwo (K := K) (n := n))).symm
  · intro hz
    rw [hz, map_zero]

/-- The matrix rank is exactly the dimension of the actual polynomial product
subspace. The injectivity of monomial evaluation is part of the proof. -/
theorem finrank_productSpan (A : Matrix (Cell n) D K) :
    Module.finrank K (productSpan A) = (multiplicationMatrix 1 A).rank := by
  rw [← range_evaluatedMultiplication]
  have h₁ := (evaluatedMultiplication A).finrank_range_add_finrank_ker
  have h₂ := (multiplicationMatrix 1 A).mulVecLin.finrank_range_add_finrank_ker
  rw [kernel_evaluatedMultiplication] at h₁
  change Module.finrank K (LinearMap.range (evaluatedMultiplication A)) =
    Module.finrank K (LinearMap.range (multiplicationMatrix 1 A).mulVecLin)
  exact Nat.add_right_cancel (h₁.trans h₂.symm)

theorem productSpan_le_degreeTwo (A : Matrix (Cell n) D K) :
    productSpan A ≤ degreeTwo (K := K) (n := n) := by
  apply Submodule.span_le.mpr
  rintro f ⟨⟨r,v⟩, rfl⟩
  change segreForm A r * cellPolynomial v ∈ degreeTwo (K := K) (n := n)
  simp only [segreForm, Finset.sum_mul, smul_mul_assoc]
  apply Submodule.sum_mem
  intro u _
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨(u,v), rfl⟩

/-- The same literal product space, as a subspace of the actual degree-two
Segre component. -/
noncomputable def productsInDegreeTwo (A : Matrix (Cell n) D K) :
    Submodule K (degreeTwo (K := K) (n := n)) :=
  (productSpan A).comap (degreeTwo (K := K) (n := n)).subtype

theorem finrank_productsInDegreeTwo (A : Matrix (Cell n) D K) :
    Module.finrank K (productsInDegreeTwo A) = (multiplicationMatrix 1 A).rank := by
  exact (Submodule.comapSubtypeEquivOfLe (productSpan_le_degreeTwo A)).finrank_eq.trans
    (finrank_productSpan A)

/-- The dimension of the actual degree-two component modulo actual parameter
products, before any whole-ring regularity or Artinian assertion is needed. -/
theorem finrank_degreeTwo_mod_products (A : Matrix (Cell n) D K) :
    Module.finrank K
      (degreeTwo (K := K) (n := n) ⧸ productsInDegreeTwo A) =
      Fintype.card (SortedPair n) - (multiplicationMatrix 1 A).rank := by
  letI : Module.Finite K (degreeTwo (K := K) (n := n)) :=
    Module.Finite.of_basis (degreeTwoBasis (K := K) (n := n))
  have h := Submodule.finrank_quotient_add_finrank (productsInDegreeTwo A)
  rw [finrank_productsInDegreeTwo,
    Module.finrank_eq_card_basis (degreeTwoBasis (K := K) (n := n))] at h
  omega

/-- The exact degree-two parameter-quotient dimension at the fixed rank sums,
with every product and ambient degree-two space given by literal polynomials. -/
theorem finrank_fixed_degreeTwo_quotient [Infinite K] :
    Module.finrank K
      (degreeTwo (K := K) (n := n) ⧸ productsInDegreeTwo (rankForms (K := K) (n := n))) =
      Fintype.card (SortedPair n) -
        (Fintype.card (Cell n) * (sideSum n + 1) - (sideSum n + 1).choose 2) := by
  rw [finrank_degreeTwo_mod_products, FixedRankParameters.fixed_rank_exact]

end PaperVerification.Segre.ParameterProducts
end
end ProbeLayer43


/-! Future-only kernel audit for one exported mathematical stage.

Append to the stage being checked, with Lean.Util.CollectAxioms available through
both `public import Lean.Util.CollectAxioms` and `import all Lean.Util.CollectAxioms`
in that stage's header, as required by the reviewed FullFlattenedAudit.

Every new declaration in the checked kernel environment is included: public,
private, generated and vendored declarations receive the same direct-sorry and
transitive-axiom checks. This is evidence for this stage only. Later principal
theorems need not exist yet, and the final full principal audit remains required.

This preparation does not execute the audit, export a module or alter a proof.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The stage kernel audit requires kernel trust level zero"
  let names := (env.checked.get.constants.foldStage2
    (fun (names : Array Name) name _ => names.push name) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The stage mathematical module is empty"
  let privateEnv := env.setExporting false
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut theoremCount : Nat := 0
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if let .thmInfo _ := info then
      theoremCount := theoremCount + 1
  let report := Json.mkObj [
    ("main_module", toJson env.header.mainModule.toString),
    ("declaration_count", toJson names.size),
    ("theorem_count", toJson theoremCount),
    ("trust_level", toJson env.header.trustLevel.toNat),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("audit_scope", toJson "current_stage_new_declarations")]
  logInfo m!"SEGRE_STAGE_KERNEL_AUDIT_PASS {report.compress}"
