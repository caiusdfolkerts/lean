section SegreAmbientCriticalScheme

/-!
# The genuine ambient critical linear subscheme

Every row of a finite coefficient matrix defines the actual morphism
O(-1) → O obtained by coordinate multiplication and the genuine O(0) ≅ O
isomorphism. Their combined image is an actual quasicoherent ideal sheaf
on the ambient projective space. Its complete ideal on every standard
chart is the ideal generated by the original normalized linear equations.

The final specialization uses every original critical equation of the
tensor. No point-set replacement or radical occurs in this construction.

-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
open scoped Classical BigOperators

namespace PaperVerification.Segre.AmbientCriticalScheme

open CategoryTheory CategoryTheory.Limits MonoidalCategory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open ProjectiveCech EulerSheaf EulerCriticalChart ProjectiveChartSections
open scoped ProjectiveChartSections

universe u
attribute [local instance] MvPolynomial.gradedAlgebra

section LinearSystem

variable (K V Q : Type u) [Field K] [Fintype V] [DecidableEq V]
  [Fintype Q] [DecidableEq Q]

local notation "𝒜" => MvPolynomial.homogeneousSubmodule V K
local notation "X" => Proj 𝒜
local notation "L" => Proj.twistingSheaf 𝒜 (-1)

/-- The actual finite product of the inverse hyperplane line, one summand
for each original linear equation. -/
def source : (X).Modules := ∏ᶜ fun _ : Q => L

instance source_quasicoherent : (source K V Q).IsQuasicoherent := by
  classical
  let M : Q → (X).Modules := fun _ => L
  letI : HasBiproduct M := HasBiproduct.of_hasProduct M
  exact (SheafOfModules.isQuasicoherent (X).ringCatSheaf).prop_of_iso
    ((biproduct.isoCoproduct M).symm ≪≫ biproduct.isoProduct M)
    (inferInstanceAs (∐ M).IsQuasicoherent)

/-- Multiplication by one original homogeneous coordinate, followed by
the actual zero-twist identification. -/
def coordinateFunctional (v : V) : L ⟶ 𝟙_ (X).Modules :=
  coordinateMul v 0 ≫ (Proj.unitIsoTwistingSheafZero 𝒜).inv

/-- Scalar multiplication uses the original structure morphism to Spec K. -/
def scalarEndomorphism (c : K) : 𝟙_ (X).Modules ⟶ 𝟙_ (X).Modules :=
  globalSectionsSmul (𝟙_ (X).Modules) (baseRingToGlobalSections K X c)

@[simp] theorem scalarEndomorphism_app (c : K) (U : (X).Opens) (r : Γ(X,U)) :
    (scalarEndomorphism K V c).app U r = algebraMap K Γ(X,U) c * r := by
  change (globalSectionsSmul (𝟙_ (X).Modules)
    (baseRingToGlobalSections K X c)).app U r = _
  rw [globalSectionsSmul_app]
  change (X).presheaf.map U.leTop.op (baseRingToGlobalSections K X c) * r =
    ((X).baseRingToStructurePresheaf K).app (op U) c * r
  erw [Scheme.baseRingToStructurePresheaf_app, CommRingCat.comp_apply,
    CommRingCat.ofHom_apply]

/-- The actual morphism O(-1) → O attached to one homogeneous linear row. -/
def rowMap (c : V → K) : L ⟶ 𝟙_ (X).Modules :=
  ∑ v, coordinateFunctional K V v ≫ scalarEndomorphism K V (c v)

/-- The actual combined functional for the entire linear system. -/
def functional (c : Q → V → K) : source K V Q ⟶ 𝟙_ (X).Modules :=
  ∑ q, Pi.π (fun _ : Q => L) q ≫ rowMap K V (c q)

/-- The genuine quasicoherent ideal sheaf of all the linear equations. -/
def idealSheaf (c : Q → V → K) : (X).IdealSheafData :=
  SectionZeroScheme.idealSheaf (functional K V Q c)

/-- The actual closed subscheme cut out by the entire homogeneous linear
system. It is defined independently of the Segre product. -/
def linearScheme (c : Q → V → K) : Scheme.{u} := (idealSheaf K V Q c).subscheme

/-- A whole standard affine chart of the actual ambient projective space. -/
def affineChart (p : V) : (X).affineOpens :=
  ⟨coordinateOpen p,
    Proj.isAffineOpen_basicOpen 𝒜 (MvPolynomial.X p)
      (MvPolynomial.isHomogeneous_X (R := K) p) one_pos⟩

/-- The coefficient functions of a homogeneous row in its original chart. -/
def rowCoefficient (c : V → K) (p : V) (U : (X).Opens)
    (hU : U ≤ coordinateOpen p) : Γ(X,U) :=
  ∑ v, algebraMap K Γ(X,U) (c v) * normalizedCoordinate p U hU v

/-- Each actual coordinate functional has the expected normalized formula
on the canonical O(-1) frame, on every subopen. -/
theorem coordinateFunctional_frame (v p : V) (U : (X).Opens)
    (hU : U ≤ coordinateOpen p) (r : Γ(X,U)) :
    (coordinateFunctional K V v).app U (chartTrivialization p U hU (-1) r) =
      normalizedCoordinate p U hU v * r := by
  apply Subtype.ext
  funext x
  apply HomogeneousLocalization.val_injective
  change
    (((Proj.sectionsLinearEquivTwistingSheafZero 𝒜 U).symm
      (coordinateMulSections v 0 U (chartTrivialization p U hU (-1) r))).val x).val =
        (((normalizedCoordinate p U hU v).val x) * r.val x).val
  erw [Proj.sectionsLinearEquivTwistingSheafZero_symm_apply_val,
    coordinateMulSections_apply, HomogeneousLocalization.val_mul]
  simp only [chartTrivialization, normalizedCoordinate,
    Proj.twistingSheaf.chartSectionsLinearEquiv_apply_apply,
    Proj.twistingSheaf.chartSectionsLinearEquiv_symm_apply_val]
  ring

theorem rowMap_frame (c : V → K) (p : V) (U : (X).Opens)
    (hU : U ≤ coordinateOpen p) (r : Γ(X,U)) :
    (rowMap K V c).app U (chartTrivialization p U hU (-1) r) =
      rowCoefficient K V c p U hU * r := by
  let F := Scheme.Modules.sectionsFunctor U
  letI : F.Additive := by
    refine ⟨?_⟩
    intro M N f g
    rfl
  change (F.map (∑ v, coordinateFunctional K V v ≫
    scalarEndomorphism K V (c v))).hom (chartTrivialization p U hU (-1) r) = _
  erw [Functor.map_sum, ModuleCat.hom_sum, LinearMap.sum_apply]
  simp only [Functor.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply]
  change (∑ v, (scalarEndomorphism K V (c v)).app U
      ((coordinateFunctional K V v).app U (chartTrivialization p U hU (-1) r))) = _
  simp only [scalarEndomorphism_app, coordinateFunctional_frame,
    rowCoefficient, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro v _
  ring

/-- The actual section frame of the whole finite source product. -/
def sourceFrame (p : V) (U : (X).Opens) (hU : U ≤ coordinateOpen p) :
    (Q → Γ(X,U)) ≃ₗ[Γ(X,U)] Γ(source K V Q,U) :=
  (LinearEquiv.piCongrRight
    (fun _ : Q => chartTrivialization p U hU (-1))).trans
      (productSectionsEquiv (fun _ : Q => L) U).symm

@[simp] theorem sourceFrame_component (p : V) (U : (X).Opens)
    (hU : U ≤ coordinateOpen p) (r : Q → Γ(X,U)) (q : Q) :
    productSectionsEquiv (fun _ : Q => L) U (sourceFrame K V Q p U hU r) q =
      chartTrivialization p U hU (-1) (r q) := by
  exact congrFun
    ((productSectionsEquiv (fun _ : Q => L) U).apply_symm_apply
      (fun q => chartTrivialization p U hU (-1) (r q))) q

theorem functional_app (c : Q → V → K) (U : (X).Opens)
    (s : Γ(source K V Q,U)) :
    (functional K V Q c).app U s =
      ∑ q, (rowMap K V (c q)).app U
        (productSectionsEquiv (fun _ : Q => L) U s q) := by
  let F := Scheme.Modules.sectionsFunctor U
  letI : F.Additive := by
    refine ⟨?_⟩
    intro M N f g
    rfl
  change (F.map (∑ q, Pi.π (fun _ : Q => L) q ≫ rowMap K V (c q))).hom s = _
  erw [Functor.map_sum, ModuleCat.hom_sum, LinearMap.sum_apply]
  simp only [Functor.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply,
    productSectionsEquiv_apply]
  rfl

/-- The complete framed functional is the linear combination of the actual
normalized rows; every original equation is present. -/
theorem functional_sourceFrame (c : Q → V → K) (p : V) (U : (X).Opens)
    (hU : U ≤ coordinateOpen p) (r : Q → Γ(X,U)) :
    (functional K V Q c).app U (sourceFrame K V Q p U hU r) =
      Fintype.linearCombination Γ(X,U) (fun q => rowCoefficient K V (c q) p U hU) r := by
  rw [functional_app]
  simp only [sourceFrame_component, rowMap_frame, Fintype.linearCombination_apply,
    smul_eq_mul]
  exact Finset.sum_congr rfl (fun q _ =>
    mul_comm (rowCoefficient K V (c q) p U hU) (r q))

/-- The whole actual image ideal on a projective chart is generated by the
normalized linear coefficients, before taking any radical. -/
theorem sectionIdeal_eq_span (c : Q → V → K) (p : V) :
    (idealSheaf K V Q c).ideal (affineChart K V p) =
      Ideal.span (Set.range (fun q =>
        rowCoefficient K V (c q) p (coordinateOpen p) le_rfl)) := by
  change LinearMap.range
    (SectionZeroScheme.sectionMap (functional K V Q c) (coordinateOpen p)) = _
  let e := sourceFrame K V Q p (coordinateOpen p) le_rfl
  have h : (SectionZeroScheme.sectionMap (functional K V Q c) (coordinateOpen p)).comp
      e.toLinearMap = Fintype.linearCombination Γ(X,coordinateOpen p)
        (fun q => rowCoefficient K V (c q) p (coordinateOpen p) le_rfl) := by
    apply LinearMap.ext
    intro r
    exact functional_sourceFrame K V Q c p (coordinateOpen p) le_rfl r
  have hr : LinearMap.range
      ((SectionZeroScheme.sectionMap (functional K V Q c) (coordinateOpen p)).comp
        e.toLinearMap) =
      LinearMap.range (SectionZeroScheme.sectionMap (functional K V Q c) (coordinateOpen p)) := by
    rw [LinearMap.range_comp, LinearEquiv.range, Submodule.map_top]
  rw [← hr, h, Fintype.range_linearCombination]

/-- The independently defined original homogeneous linear polynomial. -/
def rowPolynomial (c : V → K) : MvPolynomial V K :=
  ∑ v, MvPolynomial.C (c v) * MvPolynomial.X v

/-- Each defining polynomial is homogeneous of degree one, including a
zero row. Thus this is the original projective linear system. -/
theorem rowPolynomial_isHomogeneous (c : V → K) :
    (rowPolynomial K V c).IsHomogeneous 1 := by
  change rowPolynomial K V c ∈ MvPolynomial.homogeneousSubmodule V K 1
  rw [rowPolynomial]
  apply Submodule.sum_mem
  intro v _
  simpa only [MvPolynomial.smul_eq_C_mul] using
    (MvPolynomial.homogeneousSubmodule V K 1).smul_mem (c v)
      (MvPolynomial.isHomogeneous_X (R := K) v)

/-- Actual normalized functions correspond to the entire original
homogeneous row polynomial with only the chart pivot normalized to one. -/
theorem rowCoefficient_polynomial (c : V → K) (p : V) :
    chartSectionsEquiv p (rowCoefficient K V c p (coordinateOpen p) le_rfl) =
      PolynomialChartRing.normalizeCoordinates p (rowPolynomial K V c) := by
  simp only [rowCoefficient, rowPolynomial, map_sum, map_mul,
    AlgEquiv.commutes, MvPolynomial.algebraMap_eq,
    EulerPolynomialCoordinates.chartSectionsEquiv_normalizedCoordinate,
    MvPolynomial.algHom_C, PolynomialChartRing.normalizeCoordinates_X]

/-- The whole actual ideal sheaf on each standard affine chart, expressed
through the genuine structure-ring equivalence. -/
theorem map_sectionIdeal (c : Q → V → K) (p : V) :
    Ideal.map (chartSectionsEquiv (K := K) p).toRingHom
      ((idealSheaf K V Q c).ideal (affineChart K V p)) =
        Ideal.span (Set.range (fun q => PolynomialChartRing.normalizeCoordinates p
          (rowPolynomial K V (c q)))) := by
  erw [sectionIdeal_eq_span, Ideal.map_span, ← Set.range_comp]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext q
  exact rowCoefficient_polynomial K V (c q) p

end LinearSystem

section OriginalCriticalEquations

open Staircase Monomials CriticalGraph ProjectivePointSpan SegreEmbeddingChart

variable {K I : Type u} [Field K] [Fintype I] [DecidableEq I] {n : I → ℕ}

/-- Coefficients of every original linear critical equation, evaluated on
the actual standard tensor coordinate vectors. -/
def criticalCoefficients (A : Matrix (Cell n) Unit K)
    (q : CriticalIndex n) (v : Cell n) : K :=
  criticalOperator A (coordinateTensor v ()) q

/-- The homogeneous ambient equation is precisely the original critical
linear operator on every tensor, before restricting to the Segre variety. -/
theorem eval_criticalRow (A B : Matrix (Cell n) Unit K) (q : CriticalIndex n) :
    MvPolynomial.eval (fun v => B v ())
      (rowPolynomial K (Cell n) (criticalCoefficients A q)) =
        criticalOperator A B q :=
  SegreEmbeddingChart.eval_ambientLinearPolynomial
    ((LinearMap.proj q).comp (criticalOperator A)) B

/-- All and only vectors of the original critical linear subspace satisfy
the defining ambient homogeneous linear equations. -/
theorem criticalSpace_iff_rows (A B : Matrix (Cell n) Unit K) :
    B ∈ criticalSpace A ↔ ∀ q : CriticalIndex n,
      MvPolynomial.eval (fun v => B v ())
        (rowPolynomial K (Cell n) (criticalCoefficients A q)) = 0 := by
  change criticalOperator A B = 0 ↔ _
  constructor
  · intro h q
    rw [eval_criticalRow, h]
    rfl
  · intro h
    funext q
    exact (eval_criticalRow A B q).symm.trans (h q)

/-- The actual ambient ideal sheaf of the full original critical linear
subspace. It lives on the ambient projective tensor space, independently of
the intrinsic product zero-scheme. -/
def ambientCriticalIdeal (A : Matrix (Cell n) Unit K) :
    (Proj (MvPolynomial.homogeneousSubmodule (Cell n) K)).IdealSheafData :=
  idealSheaf K (Cell n) (CriticalIndex n) (criticalCoefficients A)

def ambientCriticalScheme (A : Matrix (Cell n) Unit K) : Scheme.{u} :=
  (ambientCriticalIdeal A).subscheme

/-- The actual ambient ideal sheaf has exactly the full affine critical
ideal used in the explicit Segre pullback, on every ambient chart. -/
theorem ambientCriticalIdeal_chart (A : Matrix (Cell n) Unit K) (p : Cell n) :
    Ideal.map (chartSectionsEquiv (K := K) p).toRingHom
      ((ambientCriticalIdeal A).ideal (affineChart K (Cell n) p)) =
        SegreEmbeddingChart.ambientAffineCriticalIdeal A p := by
  exact map_sectionIdeal K (Cell n) (CriticalIndex n) (criticalCoefficients A) p

end OriginalCriticalEquations

end PaperVerification.Segre.AmbientCriticalScheme

