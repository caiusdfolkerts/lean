section SegreEmbeddedSingularScheme

/-!
# The singular scheme in the actual Segre embedding

The embedded scheme is defined independently as the closed intersection of
the genuine Segre image and the genuine ambient critical linear system.
Equality of the entire chart ideals proves an isomorphism with the
intrinsic singular-tuple zero-scheme. Consequently finite/reduced hypotheses
are transported as actual scheme predicates, not redefined chart predicates.

-/

set_option autoImplicit false
open scoped Classical BigOperators
attribute [local instance] MvPolynomial.gradedAlgebra

namespace PaperVerification.Segre.EmbeddedSingularScheme

open CategoryTheory AlgebraicGeometry Opposite MvPolynomial
open Staircase AllFactorIncidence ActualProductKoszulTerms
open ProductChartSections ActualCriticalExactness
open scoped ProjectiveChartSections ProductChartSections

variable (K : Type) [Field K] [Infinite K] {k : ℕ} (n : Fin (k+1) → ℕ)
local notation "I" => fun i => Fin (n i+1)
set_option quotPrecheck false in local notation "S" => (product K I).scheme
local notation "P" => Proj (homogeneousSubmodule (Cell n) K)

/-- The independently constructed intrinsic critical ideal sheaf. -/
def intrinsicIdeal (T : Cell n → K) : (S).IdealSheafData :=
  SectionZeroScheme.idealSheaf
    (CriticalZeroScheme.untwist K I 1 (fullFunctional K n T))

/-- The ambient ideal is the sum of the actual Segre-image ideal and the
actual ideal sheaf generated by every original critical linear equation. -/
def ideal (T : Cell n → K) : (P).IdealSheafData :=
  (SegreSchemeMorphism.morphism K I).ker ⊔
    AmbientCriticalScheme.ambientCriticalIdeal (unitTensorEquiv T)

/-- The actual closed singular scheme in ambient projective tensor space. -/
def scheme (T : Cell n → K) : Scheme := (ideal K n T).subscheme

def inclusion (T : Cell n → K) : scheme K n T ⟶ P :=
  (ideal K n T).subschemeι

/-- The embedded scheme's original structure morphism to Spec K. -/
def toBase (T : Cell n → K) : scheme K n T ⟶ Spec (.of K) :=
  inclusion K n T ≫ ProjectiveGlobalSections.projectiveToSpec

theorem map_intrinsicIdeal_chart (T : Cell n → K) (p : Cell n) :
    Ideal.map (numericalProductChartSectionsEquiv (K := K) n p).toRingHom
      ((intrinsicIdeal K n T).ideal (CriticalZeroScheme.affineChart K I p))=
        AllFactorPointSpan.chartCriticalIdeal (unitTensorEquiv T) p := by
  change Ideal.map
      ((MvPolynomial.renameEquiv K (ProjectiveCharts.chartVarEquiv p).symm).toRingHom.comp
        (ActualWeightedExactness.coordinateEquiv K I p).toRingHom)
      (SectionZeroScheme.sectionIdeal
        (CriticalZeroScheme.untwist K I 1 (fullFunctional K n T))
        (CriticalZeroScheme.affineChart K I p))=_
  rw [← Ideal.map_map,CriticalZeroScheme.map_sectionIdeal,
    ActualCriticalExactness.map_full_ideal]

/-- Exact equality of the pulled ambient critical ideal and the intrinsic
critical ideal on each whole affine chart. -/
theorem map_ambientCriticalIdeal_chart (T : Cell n → K) (p : Cell n) :
    Ideal.map (SegreSchemeMorphism.chartPullback K I p).toRingHom
      ((AmbientCriticalScheme.ambientCriticalIdeal (unitTensorEquiv T)).ideal
        (AmbientCriticalScheme.affineChart K (Cell n) p))=
      (intrinsicIdeal K n T).ideal (CriticalZeroScheme.affineChart K I p) := by
  let e : Γ(S, ActualProductChartFrames.chart K I p) ≃ₐ[K] MvPolynomial (ProjectiveCharts.ChartVar p) K :=
    numericalProductChartSectionsEquiv (K := K) n p
  have he :
      Ideal.map e.toRingHom
        (Ideal.map (SegreSchemeMorphism.chartPullback K I p).toRingHom
          ((AmbientCriticalScheme.ambientCriticalIdeal (unitTensorEquiv T)).ideal
            (AmbientCriticalScheme.affineChart K (Cell n) p)))=
      Ideal.map e.toRingHom
        ((intrinsicIdeal K n T).ideal (CriticalZeroScheme.affineChart K I p)) := by
    rw [Ideal.map_map]
    have hmaps : e.toRingHom.comp (SegreSchemeMorphism.chartPullback K I p).toRingHom =
        (SegreEmbeddingChart.affinePullback p).toRingHom.comp
          (ProjectiveChartSections.chartSectionsEquiv (K := K) p).toRingHom :=
      congrArg AlgHom.toRingHom
        (SegreSchemeMorphism.chartPullback_polynomial_hom (K := K) n p)
    rw [hmaps]
    rw [← Ideal.map_map, AmbientCriticalScheme.ambientCriticalIdeal_chart,
      SegreEmbeddingChart.map_ambientAffineCriticalIdeal, map_intrinsicIdeal_chart]
  exact e.toRingEquiv.idealComapOrderIso.symm.injective he

/-- The kernel of the actual composite closed inclusion equals the
independently defined ambient intersection ideal. In particular no radical
or reduced-point replacement intervenes in the scheme comparison. -/
theorem composite_kernel (T : Cell n → K) :
    ((intrinsicIdeal K n T).subschemeι ≫ SegreSchemeMorphism.morphism K I).ker=
      ideal K n T := by
  apply ClosedEmbeddingIdeals.ker_subscheme_comp_eq_sup
    (SegreSchemeMorphism.morphism K I) (intrinsicIdeal K n T)
    (AmbientCriticalScheme.ambientCriticalIdeal (unitTensorEquiv T))
    (AmbientCriticalScheme.affineChart K (Cell n))
    ProjectiveCech.coordinate_cover
    (CriticalZeroScheme.affineChart K I)
    (SegreSchemeMorphism.preimage_coordinateOpen K I)
  intro p
  exact map_ambientCriticalIdeal_chart K n T p

/-- The actual scheme isomorphism with the original embedded singular
scheme, proved from equality of the whole ambient defining ideal. -/
def intrinsicIso (T : Cell n → K) :
    LiteralCriticalZeroScheme.singularScheme K n T ≅ scheme K n T :=
  ClosedEmbeddingIdeals.subschemeIso (SegreSchemeMorphism.morphism K I)
    (intrinsicIdeal K n T)
    (AmbientCriticalScheme.ambientCriticalIdeal (unitTensorEquiv T))
    (composite_kernel K n T)

@[reassoc] theorem intrinsicIso_hom_inclusion (T : Cell n → K) :
    (intrinsicIso K n T).hom ≫ inclusion K n T=
      (intrinsicIdeal K n T).subschemeι ≫ SegreSchemeMorphism.morphism K I :=
  ClosedEmbeddingIdeals.subschemeIso_hom_ι _ _ _ _

@[reassoc] theorem intrinsicIso_hom_toBase (T : Cell n → K) :
    (intrinsicIso K n T).hom ≫ toBase K n T=
      LiteralCriticalZeroScheme.singularToBase K n T := by
  rw [toBase,← Category.assoc,intrinsicIso_hom_inclusion,Category.assoc,
    SegreSchemeMorphism.morphism_toBase]
  rfl

theorem finite_iff (T : Cell n → K) :
    IsFinite (toBase K n T) ↔
      IsFinite (LiteralCriticalZeroScheme.singularToBase K n T) := by
  constructor
  · intro h
    letI := h
    have h' : IsFinite ((intrinsicIso K n T).hom ≫ toBase K n T) := inferInstance
    rwa [intrinsicIso_hom_toBase] at h'
  · intro h
    letI := h
    have h' : IsFinite ((intrinsicIso K n T).inv ≫
        LiteralCriticalZeroScheme.singularToBase K n T) := inferInstance
    rw [← intrinsicIso_hom_toBase,← Category.assoc,Iso.inv_hom_id,
      Category.id_comp] at h'
    exact h'

theorem reduced_iff (T : Cell n → K) :
    AlgebraicGeometry.IsReduced (scheme K n T) ↔
      AlgebraicGeometry.IsReduced (LiteralCriticalZeroScheme.singularScheme K n T) := by
  constructor
  · intro h
    letI := h
    exact AlgebraicGeometry.isReduced_of_isOpenImmersion (intrinsicIso K n T).hom
  · intro h
    letI := h
    exact AlgebraicGeometry.isReduced_of_isOpenImmersion (intrinsicIso K n T).inv

/-- The original finite/reduced scheme hypotheses are formally equivalent
in the intrinsic and independently defined embedded presentations. -/
theorem finite_reduced_iff (T : Cell n → K) :
    (IsFinite (toBase K n T) ∧ AlgebraicGeometry.IsReduced (scheme K n T)) ↔
      (IsFinite (LiteralCriticalZeroScheme.singularToBase K n T) ∧
        AlgebraicGeometry.IsReduced (LiteralCriticalZeroScheme.singularScheme K n T)) :=
  and_congr (finite_iff K n T) (reduced_iff K n T)

end PaperVerification.Segre.EmbeddedSingularScheme

end SegreEmbeddedSingularScheme

section SegreEmbeddedSchemePrincipal

/-!
# The printed scheme hypotheses in the genuine Segre embedding

The embedded scheme is the actual Segre image intersected with all original
ambient critical linear equations. The intrinsic endpoints remain unchanged
and are used through the proved whole-ideal scheme isomorphism.

-/

set_option autoImplicit false
open scoped Classical BigOperators

namespace PaperVerification.Segre.EmbeddedSchemePrincipal

open CategoryTheory AlgebraicGeometry
open Staircase GraphSpan CriticalGraph SingularSpan ProjectiveCharts

variable {K : Type} [Field K] [IsAlgClosed K] {k m : ℕ}
  {n : Fin (k+1) → ℕ}

abbrev originalScheme (A : Matrix (Cell n) (Fin (m+1)) K) : Scheme :=
  EmbeddedSingularScheme.scheme K (SingularSchemeGraphCharts.fullShape n m)
    (SingularSchemeGraphCharts.fullArray A)

abbrev originalToBase (A : Matrix (Cell n) (Fin (m+1)) K) :
    originalScheme A ⟶ Spec (.of K) :=
  EmbeddedSingularScheme.toBase K (SingularSchemeGraphCharts.fullShape n m)
    (SingularSchemeGraphCharts.fullArray A)

/-- Proposition 2.1 with the actual finite/reduced scheme in the original
Segre embedding and all three stated conclusions. -/
theorem proposition_2_1 (A : Matrix (Cell n) (Fin (m+1)) K)
    (hb : ∀ x : FactorPoint n K,lastContraction A x.val ≠ 0)
    (hf : IsFinite (originalToBase A))
    (hr : AlgebraicGeometry.IsReduced (originalScheme A)) :
    singularSpan A=graphSpan A ⊓ fullCriticalSpace A ∧
      Module.finrank K (singularSpan A)=
        (Degeneration.multiplicationMatrix 1 A).rank-∑ i,(n i+1).choose 2 ∧
      A ∈ singularSpan A := by
  obtain ⟨hf',hr'⟩ :=
    (EmbeddedSingularScheme.finite_reduced_iff K
      (SingularSchemeGraphCharts.fullShape n m)
      (SingularSchemeGraphCharts.fullArray A)).mp ⟨hf,hr⟩
  exact PrincipalScheme.proposition_2_1 A hb hf' hr'

/-- The dimension formula of Proposition 2.1 as an additive identity in
natural numbers. It records the full critical-image count and, in particular,
proves that this count is at most the multiplication rank. -/
theorem proposition_2_1_dimension_add (A : Matrix (Cell n) (Fin (m+1)) K)
    (hb : ∀ x : FactorPoint n K,lastContraction A x.val ≠ 0)
    (hf : IsFinite (originalToBase A))
    (hr : AlgebraicGeometry.IsReduced (originalScheme A)) :
    Module.finrank K (singularSpan A) + ∑ i : Fin (k+1),(n i+1).choose 2 =
      (Degeneration.multiplicationMatrix 1 A).rank := by
  obtain ⟨hf₀,hr₀⟩ :=
    (EmbeddedSingularScheme.finite_reduced_iff K
      (SingularSchemeGraphCharts.fullShape n m)
      (SingularSchemeGraphCharts.fullArray A)).mp ⟨hf,hr⟩
  obtain ⟨hf',hr'⟩ :=
    SingularSchemeGraphCharts.graph_charts_of_original_scheme A hb hf₀ hr₀
  have hann : (singularSpan A).dualAnnihilator =
      LinearMap.ker (SpanDefect.multiplicationOnCovectors A) ⊔
        SpanDefect.smallRelations A :=
    (ProjectivePointSpan.singular_annihilator_eq_chart_ideal_intersection A hb hr').trans
      (GraphGeometry.graph_chart_image_identity A hf')
  have hdim := SpanImageDimension.singularSpan_dimension_add_image A hann
  rw [ActualCriticalDimension.finrank_mapped_smallRelations n A hf',
    MultiplicationSpanBridge.finrank_range_actualMultiplication] at hdim
  exact hdim

/-- The printed dimension formula as an equality in the integers, obtained
from the additive identity under the same original scheme hypotheses. -/
theorem proposition_2_1_dimension_int (A : Matrix (Cell n) (Fin (m+1)) K)
    (hb : ∀ x : FactorPoint n K,lastContraction A x.val ≠ 0)
    (hf : IsFinite (originalToBase A))
    (hr : AlgebraicGeometry.IsReduced (originalScheme A)) :
    (Module.finrank K (singularSpan A) : ℤ) =
      ((Degeneration.multiplicationMatrix 1 A).rank : ℤ) -
        ∑ i : Fin (k+1),((n i+1).choose 2 : ℤ) := by
  have hdim := congrArg (fun d : ℕ => (d : ℤ))
    (proposition_2_1_dimension_add A hb hf hr)
  rw [Nat.cast_add, Nat.cast_sum] at hdim
  exact (eq_sub_iff_add_eq).mpr hdim

/-- Generic finiteness and reducedness of the actual embedded singular
scheme, in every format and every characteristic. -/
theorem lemma_2_2 (n : Fin (k+1) → ℕ) :
    ∃ p : MvPolynomial (Cell n) K,p ≠ 0 ∧
      (∃ T : Cell n → K,MvPolynomial.eval T p ≠ 0) ∧
      ∀ T : Cell n → K,MvPolynomial.eval T p ≠ 0 →
        IsFinite (EmbeddedSingularScheme.toBase K n T) ∧
          AlgebraicGeometry.IsReduced (EmbeddedSingularScheme.scheme K n T) := by
  obtain ⟨p,hp,hne,h⟩ := PrincipalScheme.lemma_2_2 (K := K) n
  exact ⟨p,hp,hne,fun T hT => (EmbeddedSingularScheme.finite_reduced_iff K n T).mpr
    (h T hT)⟩

/-- Both assertions of Lemma 2.2 on one nonempty principal open, with the
original base-point-free slices and the actual embedded scheme predicates. -/
theorem lemma_2_2_graph (n : Fin (k+1) → ℕ) (m : ℕ)
    (hlen : sideSum n+1 ≤ m+1) :
    ∃ p : MvPolynomial (Cell n × Fin (m+1)) K,p ≠ 0 ∧
      (∃ A : Matrix (Cell n) (Fin (m+1)) K,
        MvPolynomial.eval (fun q => A q.1 q.2) p ≠ 0) ∧
      ∀ A : Matrix (Cell n) (Fin (m+1)) K,
        MvPolynomial.eval (fun q => A q.1 q.2) p ≠ 0 →
          (∀ x : FactorPoint n K,lastContraction A x.val ≠ 0) ∧
          IsFinite (originalToBase A) ∧
          AlgebraicGeometry.IsReduced (originalScheme A) := by
  obtain ⟨p,hp,hne,h⟩ := PrincipalScheme.lemma_2_2_graph (K := K) n m hlen
  refine ⟨p,hp,hne,?_⟩
  intro A hA
  obtain ⟨hb,hf,hr⟩ := h A hA
  exact ⟨hb,(EmbeddedSingularScheme.finite_reduced_iff K
    (SingularSchemeGraphCharts.fullShape n m)
    (SingularSchemeGraphCharts.fullArray A)).mpr ⟨hf,hr⟩⟩

end PaperVerification.Segre.EmbeddedSchemePrincipal

end SegreEmbeddedSchemePrincipal


