section SegreTensorFactorReindex

/-!
# Reindexing every tensor factor, with the literal singular span

This file changes only the names of factor indices. It transports the actual
coefficient array, pure tensors, every contraction, the complete singular
incidence condition, and the ordinary span of its rank-one generators. In
particular, choosing a factor for the graph argument does not impose an
ordering restriction on the tensor format.

-/

set_option autoImplicit false
open scoped Classical BigOperators

namespace PaperVerification.Segre.TensorFactorReindex

open TangentKernel

variable {I I' K : Type*} [Fintype I] [DecidableEq I]
  [Fintype I'] [DecidableEq I'] [Field K]
variable {σ : I → Type*} [∀ i, Fintype (σ i)]

/-- The full tensor-coordinate permutation induced by a factor permutation. -/
def cellEquiv (e : I' ≃ I) : (∀ i : I', σ (e i)) ≃ (∀ i : I, σ i) :=
  Equiv.piCongrLeft σ e

@[simp] theorem cellEquiv_apply (e : I' ≃ I)
    (a : ∀ i : I', σ (e i)) (i : I') : cellEquiv e a (e i) = a i := by
  exact Equiv.piCongrLeft_apply_apply σ e a i

/-- Ordinary coefficient reindexing as a linear equivalence. -/
def tensorEquiv (e : I' ≃ I) :
    ((∀ i : I, σ i) → K) ≃ₗ[K] ((∀ i : I', σ (e i)) → K) where
  toFun T a := T (cellEquiv e a)
  invFun T a := T ((cellEquiv e).symm a)
  left_inv T := by funext a; simp
  right_inv T := by funext a; simp
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def vectors (e : I' ≃ I) (v : ∀ i : I, σ i → K) :
    ∀ i : I', σ (e i) → K := fun i => v (e i)

theorem vectors_nonzero (e : I' ≃ I) (v : ∀ i : I, σ i → K)
    (hv : ∀ i, v i ≠ 0) : ∀ i, vectors e v i ≠ 0 := fun i => hv (e i)

/-- Reindexing sends each actual pure tensor to the same pure tensor with
the factor names changed. -/
theorem tensorEquiv_pureTensor (e : I' ≃ I) (v : ∀ i : I, σ i → K) :
    tensorEquiv e (pureTensor v) = pureTensor (vectors e v) := by
  funext a
  change (∏ i : I, v i (cellEquiv e a i)) = ∏ i : I', v (e i) (a i)
  symm
  apply Fintype.prod_equiv e
  intro i
  rw [cellEquiv_apply]

theorem otherProduct_reindex (e : I' ≃ I) (v : ∀ i : I, σ i → K)
    (i : I') (a : ∀ i : I', σ (e i)) :
    otherProduct (vectors e v) i a = otherProduct v (e i) (cellEquiv e a) := by
  unfold otherProduct
  rw [Finset.prod_subtype (p := fun j : I' => j ≠ i)
    (Finset.univ.erase i) (by simp)]
  rw [Finset.prod_subtype (p := fun j : I => j ≠ e i)
    (Finset.univ.erase (e i)) (by simp)]
  let ee : {j : I' // j ≠ i} ≃ {j : I // j ≠ e i} :=
    e.subtypeEquiv (fun j => by simp)
  apply Fintype.prod_equiv ee
  intro j
  change v (e j.val) (a j.val) = v (e j.val) (cellEquiv e a (e j.val))
  rw [cellEquiv_apply]

/-- Every contraction, with the full coefficient sum, is preserved. -/
theorem contraction_reindex (e : I' ≃ I) (v : ∀ i : I, σ i → K)
    (T : (∀ i : I, σ i) → K) (i : I') (a : σ (e i)) :
    contraction (vectors e v) (tensorEquiv e T) i a = contraction v T (e i) a := by
  unfold contraction
  apply Fintype.sum_equiv (cellEquiv e)
  intro b
  change (if b i = a then T (cellEquiv e b) * otherProduct (vectors e v) i b else 0) =
    (if cellEquiv e b (e i) = a then
      T (cellEquiv e b) * otherProduct v (e i) (cellEquiv e b) else 0)
  rw [cellEquiv_apply, otherProduct_reindex]

/-- The complete singular incidence equations are equivalent under the
factor permutation; there is no nonisotropic assumption. -/
theorem incidence_zero_reindex (e : I' ≃ I) (v : ∀ i : I, σ i → K)
    (T : (∀ i : I, σ i) → K) (hv : ∀ i, v i ≠ 0) :
    singularIncidenceMap (vectors e v) (tensorEquiv e T) = 0 ↔
      singularIncidenceMap v T = 0 := by
  rw [singularIncidenceMap_eq_zero_iff_of_nonzero _ _ (vectors_nonzero e v hv),
    singularIncidenceMap_eq_zero_iff_of_nonzero _ _ hv]
  have hc (i : I') : contraction (vectors e v) (tensorEquiv e T) i =
      contraction v T (e i) := by
    funext a
    exact contraction_reindex e v T i a
  simp only [hc, vectors]
  constructor
  · intro h i
    obtain ⟨j, rfl⟩ := e.surjective i
    exact h j
  · intro h i
    exact h (e i)

/-- Actual rank-one generators in an arbitrary finite tensor format. -/
def incidenceGenerators (T : (∀ i : I, σ i) → K) : Set ((∀ i : I, σ i) → K) :=
  {B | ∃ v : ∀ i : I, σ i → K,
    (∀ i, v i ≠ 0) ∧ singularIncidenceMap v T = 0 ∧ B = pureTensor v}

def incidenceSpan (T : (∀ i : I, σ i) → K) : Submodule K ((∀ i : I, σ i) → K) :=
  Submodule.span K (incidenceGenerators T)

/-- The numeric-coordinate presentation used elsewhere is the same span,
by definition, rather than merely a proxy having the same dimension. -/
theorem incidenceSpan_numeric (n : I → ℕ) (T : Staircase.Cell n → K) :
    incidenceSpan T = AllFactorIncidence.incidencePureTensorSpan T := rfl

/-- The full set of literal singular pure tensors is transported exactly. -/
theorem incidenceGenerators_reindex (e : I' ≃ I) (T : (∀ i : I, σ i) → K) :
    incidenceGenerators (tensorEquiv e T) = tensorEquiv e '' incidenceGenerators T := by
  ext B
  constructor
  · rintro ⟨v', hv', hs', rfl⟩
    let v : ∀ i : I, σ i → K := Equiv.piCongrLeft (fun i => σ i → K) e v'
    have hvr : vectors e v = v' := by
      funext i
      exact Equiv.piCongrLeft_apply_apply (fun i => σ i → K) e v' i
    have hv : ∀ i, v i ≠ 0 := by
      intro i
      obtain ⟨j, rfl⟩ := e.surjective i
      simpa only [vectors] using (show vectors e v j ≠ 0 by rw [hvr]; exact hv' j)
    have hs : singularIncidenceMap v T = 0 := by
      apply (incidence_zero_reindex e v T hv).mp
      rw [hvr]
      exact hs'
    refine ⟨pureTensor v, ⟨v, hv, hs, rfl⟩, ?_⟩
    rw [tensorEquiv_pureTensor, hvr]
  · rintro ⟨C, ⟨v, hv, hs, rfl⟩, rfl⟩
    refine ⟨vectors e v, vectors_nonzero e v hv,
      (incidence_zero_reindex e v T hv).mpr hs, ?_⟩
    exact tensorEquiv_pureTensor e v

/-- Every permutation of factors preserves the entire singular span. -/
theorem incidenceSpan_reindex (e : I' ≃ I) (T : (∀ i : I, σ i) → K) :
    incidenceSpan (tensorEquiv e T) =
      (incidenceSpan T).map (tensorEquiv e).toLinearMap := by
  rw [incidenceSpan, incidenceGenerators_reindex, incidenceSpan, Submodule.map_span]
  rfl

/-- Tensor membership in the actual singular span is invariant under factor
permutation, exactly as required by the unrestricted format theorem. -/
theorem tensor_mem_span_reindex (e : I' ≃ I) (T : (∀ i : I, σ i) → K) :
    tensorEquiv e T ∈ incidenceSpan (tensorEquiv e T) ↔ T ∈ incidenceSpan T := by
  rw [incidenceSpan_reindex]
  constructor
  · rintro ⟨B, hB, hBT⟩
    exact (tensorEquiv e).injective hBT ▸ hB
  · intro h
    exact ⟨T, h, rfl⟩

/-- Nonzero polynomial open certificates pull back through the actual
coefficient permutation without weakening the parameter space. -/
def certificatePullback (e : I' ≃ I)
    (p : MvPolynomial (∀ i : I', σ (e i)) K) : MvPolynomial (∀ i : I, σ i) K :=
  MvPolynomial.rename (cellEquiv e) p

theorem certificatePullback_ne_zero (e : I' ≃ I)
    {p : MvPolynomial (∀ i : I', σ (e i)) K} (hp : p ≠ 0) :
    certificatePullback e p ≠ 0 := by
  intro h
  apply hp
  apply MvPolynomial.rename_injective (cellEquiv e) (cellEquiv e).injective
  simpa only [certificatePullback, map_zero] using h

theorem eval_certificatePullback (e : I' ≃ I)
    (p : MvPolynomial (∀ i : I', σ (e i)) K) (T : (∀ i : I, σ i) → K) :
    MvPolynomial.eval T (certificatePullback e p) =
      MvPolynomial.eval (tensorEquiv e T) p := by
  rw [certificatePullback, MvPolynomial.eval_rename]
  rfl

/-- The complete generic tensor-membership claim transports through every
factor permutation on a proved nonempty principal open. -/
theorem generic_tensor_mem_span_reindex [Infinite K] (e : I' ≃ I)
    (h : ∃ p : MvPolynomial (∀ i : I', σ (e i)) K, p ≠ 0 ∧
      ∀ T, MvPolynomial.eval T p ≠ 0 → T ∈ incidenceSpan T) :
    ∃ p : MvPolynomial (∀ i : I, σ i) K, p ≠ 0 ∧
      ∀ T, MvPolynomial.eval T p ≠ 0 → T ∈ incidenceSpan T := by
  obtain ⟨p, hp, hmem⟩ := h
  refine ⟨certificatePullback e p, certificatePullback_ne_zero e hp, ?_⟩
  intro T hT
  apply (tensor_mem_span_reindex e T).mp
  apply hmem
  rwa [← eval_certificatePullback]

end PaperVerification.Segre.TensorFactorReindex

end SegreTensorFactorReindex

section SegreTensorFactorSplitting

/-!
# Separating a tensor factor without changing singular tensors

The graph construction stores a tensor as a matrix of slices. Here that
storage is explicitly identified with the original full tensor coefficient
space. The complete singular incidence equations, every rank-one tensor, and
their full linear span are preserved. Neither a basepoint-free hypothesis nor
genericity is needed for this coordinate identification.

-/

set_option autoImplicit false
open scoped Classical BigOperators

namespace PaperVerification.Segre.TensorFactorSplitting

open Staircase Monomials TangentKernel GraphSpan CriticalGraph SingularSpan
open TensorFactorReindex FullGraphChartReindex

variable {I J K : Type} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The literal full tensor is stored as its matrix of last-factor slices. -/
def matrixEquiv :
    ((∀ i : Option I, FullFactor n J i) → K) ≃ₗ[K] Matrix (Cell n) J K where
  toFun T v j := T ((originalCellEquiv (n := n) (J := J)).symm (v, j))
  invFun A := originalTensor A
  left_inv T := by
    funext a
    change T ((originalCellEquiv (n := n) (J := J)).symm
      (originalCellEquiv a)) = T a
    rw [Equiv.symm_apply_apply]
  right_inv A := by
    ext v j
    rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem matrixEquiv_originalTensor (A : Matrix (Cell n) J K) :
    matrixEquiv (originalTensor A) = A := (matrixEquiv (n := n) (J := J)).apply_symm_apply A

theorem fullVector_nonzero (x : FactorPoint n K) (y : J → K) (hy : y ≠ 0) :
    ∀ i : Option I, fullVector x.val y i ≠ 0 := by
  intro i
  cases i with
  | none => exact hy
  | some i =>
    obtain ⟨a, ha⟩ := x.property i
    intro h
    exact ha (congrFun h a)

/-- Pure tensors are exactly preserved, including their scalar normalization. -/
theorem matrixEquiv_pureTensor (x : Variables n → K) (y : J → K) :
    matrixEquiv (pureTensor (fullVector x y)) = rankOneTensor x y := by
  ext v j
  change (∏ i : Option I, fullVector x y i
    ((originalCellEquiv (n := n) (J := J)).symm (v, j) i)) =
      MvPolynomial.eval x (cellPolynomial v) * y j
  rw [Fintype.prod_option, eval_cell_eq_prod]
  change y j * (∏ i : I, x ⟨i, v i⟩) = (∏ i : I, x ⟨i, v i⟩) * y j
  exact mul_comm _ _

/-- The full incidence kernel is precisely the original singular-tuple
condition used in the graph theorem. All factors and all contractions remain. -/
theorem full_incidence_iff_singular (A : Matrix (Cell n) J K)
    (x : FactorPoint n K) (y : J → K) (hy : y ≠ 0) :
    singularIncidenceMap (fullVector x.val y) (originalTensor A) = 0 ↔
      IsSingularTuple A x y := by
  rw [singularIncidenceMap_eq_zero_iff_of_nonzero _ _ (fullVector_nonzero x y hy)]
  constructor
  · intro h
    refine ⟨hy, ?_, ?_⟩
    · intro i
      obtain ⟨c, hc⟩ := h (some i)
      refine ⟨c, ?_⟩
      intro a
      have ha := congrFun hc a
      rw [contraction_some] at ha
      exact ha
    · obtain ⟨c, hc⟩ := h none
      refine ⟨c, ?_⟩
      intro a
      have ha := congrFun hc a
      rw [contraction_none] at ha
      exact ha
  · intro h i
    cases i with
    | none =>
      obtain ⟨c, hc⟩ := h.2.2
      refine ⟨c, ?_⟩
      funext a
      exact (contraction_none A x.val y a).trans (hc a)
    | some i =>
      obtain ⟨c, hc⟩ := h.2.1 i
      refine ⟨c, ?_⟩
      funext a
      exact (contraction_some A x.val y i a).trans (hc a)

/-- The complete sets of singular rank-one tensors agree under the original
coefficient reshaping, before taking their spans. -/
theorem singularRankOneSet_eq_image (A : Matrix (Cell n) J K) :
    singularRankOneSet A = matrixEquiv '' incidenceGenerators (originalTensor A) := by
  ext B
  constructor
  · rintro ⟨x, y, hs, rfl⟩
    refine ⟨pureTensor (fullVector x.val y), ?_, matrixEquiv_pureTensor x.val y⟩
    refine ⟨fullVector x.val y, fullVector_nonzero x y hs.1, ?_, rfl⟩
    exact (full_incidence_iff_singular A x y hs.1).mpr hs
  · rintro ⟨C, ⟨v, hv, hs, rfl⟩, rfl⟩
    let x : FactorPoint n K := ⟨fun q => v (some q.1) q.2, by
      intro i
      by_contra! h
      apply hv (some i)
      funext a
      exact h a⟩
    let y : J → K := v none
    have hvxy : fullVector x.val y = v := by
      funext i
      cases i <;> rfl
    refine ⟨x, y, ?_, ?_⟩
    · apply (full_incidence_iff_singular A x y (hv none)).mp
      rwa [hvxy]
    · rw [← hvxy, matrixEquiv_pureTensor]

/-- The graph presentation uses the exact ordinary singular span of the
original full tensor, with no geometric hypothesis hidden in the change of
coordinates. -/
theorem singularSpan_eq_map_incidenceSpan (A : Matrix (Cell n) J K) :
    singularSpan A = (incidenceSpan (originalTensor A)).map matrixEquiv.toLinearMap := by
  rw [singularSpan, singularRankOneSet_eq_image, incidenceSpan, Submodule.map_span]
  rfl

theorem originalTensor_mem_span_iff (A : Matrix (Cell n) J K) :
    originalTensor A ∈ incidenceSpan (originalTensor A) ↔ A ∈ singularSpan A := by
  rw [singularSpan_eq_map_incidenceSpan]
  constructor
  · intro h
    exact ⟨originalTensor A, h, matrixEquiv_originalTensor A⟩
  · rintro ⟨B, hB, hBA⟩
    have hB' : B = originalTensor A :=
      matrixEquiv.injective (hBA.trans (matrixEquiv_originalTensor A).symm)
    exact hB' ▸ hB

/-- A graph-format certificate is a nonzero polynomial in exactly the
original tensor entries after the coordinate reshaping. -/
def certificatePullback (p : MvPolynomial (Cell n × J) K) :
    MvPolynomial (∀ i : Option I, FullFactor n J i) K :=
  MvPolynomial.rename (originalCellEquiv (n := n) (J := J)).symm p

theorem certificatePullback_ne_zero {p : MvPolynomial (Cell n × J) K} (hp : p ≠ 0) :
    certificatePullback p ≠ 0 := by
  intro h
  apply hp
  apply MvPolynomial.rename_injective _ (originalCellEquiv (n := n) (J := J)).symm.injective
  simpa only [certificatePullback, map_zero] using h

theorem eval_certificatePullback (p : MvPolynomial (Cell n × J) K)
    (T : (∀ i : Option I, FullFactor n J i) → K) :
    MvPolynomial.eval T (certificatePullback p) =
      MvPolynomial.eval (fun q => matrixEquiv T q.1 q.2) p := by
  rw [certificatePullback, MvPolynomial.eval_rename]
  rfl

/-- An unrestricted graph-format generic tensor-membership theorem gives
the full original tensor-membership theorem for this factor separation. -/
theorem generic_tensor_mem_span_of_graph
    (h : ∃ p : MvPolynomial (Cell n × J) K, p ≠ 0 ∧
      ∀ A : Matrix (Cell n) J K,
        MvPolynomial.eval (fun q => A q.1 q.2) p ≠ 0 → A ∈ singularSpan A) :
    ∃ p : MvPolynomial (∀ i : Option I, FullFactor n J i) K, p ≠ 0 ∧
      ∀ T, MvPolynomial.eval T p ≠ 0 → T ∈ incidenceSpan T := by
  obtain ⟨p, hp, hmem⟩ := h
  refine ⟨certificatePullback p, certificatePullback_ne_zero hp, ?_⟩
  intro T hT
  let A := matrixEquiv T
  have he : originalTensor A = T := matrixEquiv.symm_apply_apply T
  rw [← he]
  apply (originalTensor_mem_span_iff A).mpr
  apply hmem A
  rwa [← eval_certificatePullback]

end PaperVerification.Segre.TensorFactorSplitting

end SegreTensorFactorSplitting

section SegreCriticalGenericity

/-!
# Independence of the actual small critical equations on the graph

The ordered coordinates below remove only the repetitions in the literal
critical operator. An invertible matrix of its values on genuine graph
tensors gives injectivity of multiplication on the actual relation space.
The same matrix has polynomial entries in the original tensor coefficients,
so one witness gives a nonzero polynomial certificate, without assuming a
generic rank conclusion.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.CriticalGenericity

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph SpanDefect
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- One coordinate for each unordered pair, with its increasing ordering. -/
abbrev OrderedCriticalIndex (n : I → ℕ) :=
  {q : CriticalIndex n // q.2.1 < q.2.2}

def orderedCriticalIndexEquiv (n : I → ℕ) :
    OrderedCriticalIndex n ≃ Σ i : I, Σ b : Fin (n i+1), Fin b.val where
  toFun q := ⟨q.val.1,q.val.2.2,⟨q.val.2.1.val,q.property⟩⟩
  invFun q := ⟨⟨q.1,(⟨q.2.2.val,lt_trans q.2.2.isLt q.2.1.isLt⟩,q.2.1)⟩,q.2.2.isLt⟩
  left_inv q := by rcases q with ⟨⟨i,a,b⟩,h⟩; rfl
  right_inv q := by rcases q with ⟨i,b,a⟩; rfl

theorem orderedCriticalIndex_card (n : I → ℕ) :
    Fintype.card (OrderedCriticalIndex n)=∑ i, (n i+1).choose 2 := by
  classical
  have hsum (m : ℕ) : (∑ a : Fin m, a.val)=m.choose 2 := by
    induction m with
    | zero => simp
    | succ m ih =>
      rw [Fin.sum_univ_castSucc]
      simp only [Fin.val_castSucc,Fin.val_last,ih,Nat.choose_succ_succ,
        Nat.choose_one_right,add_comm]
  rw [Fintype.card_congr (orderedCriticalIndexEquiv n),Fintype.card_sigma]
  simp only [Fintype.card_sigma,Fintype.card_fin,hsum]

def orderedCriticalOperator (A : Matrix (Cell n) J K) :
    Matrix (Cell n) J K →ₗ[K] (OrderedCriticalIndex n → K) :=
  LinearMap.pi fun q => (LinearMap.proj q.val).comp (criticalOperator A)

@[simp] theorem orderedCriticalOperator_apply
    (A B : Matrix (Cell n) J K) (q : OrderedCriticalIndex n) :
    orderedCriticalOperator A B q = criticalOperator A B q.val := rfl

theorem criticalOperator_diagonal (A B : Matrix (Cell n) J K)
    (i : I) (a : Fin (n i+1)) : criticalOperator A B ⟨i,(a,a)⟩=0 := by
  simp [criticalOperator]

theorem criticalOperator_swap (A B : Matrix (Cell n) J K)
    (i : I) (a b : Fin (n i+1)) :
    criticalOperator A B ⟨i,(a,b)⟩ = -criticalOperator A B ⟨i,(b,a)⟩ := by
  change (∑ w : OtherCell n i, ∑ j : J,
    (A (assemble i a w) j*B (assemble i b w) j-
      A (assemble i b w) j*B (assemble i a w) j)) =
    -(∑ w : OtherCell n i, ∑ j : J,
    (A (assemble i b w) j*B (assemble i a w) j-
      A (assemble i a w) j*B (assemble i b w) j))
  simp only [← Finset.sum_neg_distrib,neg_sub]

theorem orderedCriticalOperator_ker (A : Matrix (Cell n) J K) :
    LinearMap.ker (orderedCriticalOperator A)=LinearMap.ker (criticalOperator A) := by
  ext B
  constructor
  · intro h
    change criticalOperator A B=0
    funext q
    rcases q with ⟨i,a,b⟩
    rcases lt_trichotomy a b with hab | hab | hba
    · exact congrFun h ⟨⟨i,(a,b)⟩,hab⟩
    · subst b
      exact criticalOperator_diagonal A B i a
    · rw [criticalOperator_swap]
      have hz : criticalOperator A B ⟨i,(b,a)⟩=0 :=
        congrFun h ⟨⟨i,(b,a)⟩,hba⟩
      rw [hz,neg_zero]
      rfl
  · intro h
    change orderedCriticalOperator A B=0
    funext q
    exact congrFun h q.val

theorem smallRelations_eq_ordered_dual_range (A : Matrix (Cell n) J K) :
    smallRelations A=LinearMap.range (orderedCriticalOperator A).dualMap := by
  simp only [smallRelations,LinearMap.range_dualMap_eq_dualAnnihilator_ker,
    orderedCriticalOperator_ker]

/-- Surjectivity on the actual graph proves disjointness from the actual
multiplication kernel. No geometric annihilator identity is assumed here. -/
theorem disjoint_of_ordered_graph_surjective [Infinite K]
    (A : Matrix (Cell n) J K)
    (h : Function.Surjective ((orderedCriticalOperator A).comp (graphSpan A).subtype)) :
    Disjoint (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A) := by
  rw [smallRelations_eq_ordered_dual_range,←graphSpan_annihilator]
  apply Submodule.disjoint_def.mpr
  rintro φ hφ ⟨ψ,rfl⟩
  apply LinearMap.ext
  intro B
  obtain ⟨C,hC⟩ := h (orderedCriticalOperator A B)
  change ψ (orderedCriticalOperator A B)=0
  rw [←hC]
  exact (Submodule.mem_dualAnnihilator _).mp hφ C C.property

theorem smallRelations_finrank_of_ordered_graph_surjective
    (A : Matrix (Cell n) J K)
    (h : Function.Surjective ((orderedCriticalOperator A).comp (graphSpan A).subtype)) :
    Module.finrank K (smallRelations A)=Fintype.card (OrderedCriticalIndex n) := by
  have hs : Function.Surjective (orderedCriticalOperator A) := by
    intro y
    obtain ⟨x,hx⟩ := h y
    exact ⟨x.val,hx⟩
  rw [smallRelations_eq_ordered_dual_range,
    LinearMap.finrank_range_dualMap_eq_finrank_range,
    LinearMap.range_eq_top.mpr hs,finrank_top,Module.finrank_pi]

/-- The columns are the literal ordered critical values of genuine graph
tensors. In particular this is not a matrix chosen to encode the conclusion. -/
def graphEvaluationMatrix (A : Matrix (Cell n) J K)
    (x : OrderedCriticalIndex n → FactorPoint n K) :
    Matrix (OrderedCriticalIndex n) (OrderedCriticalIndex n) K :=
  fun p q => orderedCriticalOperator A (graphTensor A (x q).val) p

theorem ordered_graph_surjective_of_det
    (A : Matrix (Cell n) J K) (x : OrderedCriticalIndex n → FactorPoint n K)
    (hdet : (graphEvaluationMatrix A x).det≠0) :
    Function.Surjective ((orderedCriticalOperator A).comp (graphSpan A).subtype) := by
  classical
  have hs := Matrix.mulVec_surjective_iff_isUnit.mpr
    ((graphEvaluationMatrix A x).isUnit_iff_isUnit_det.mpr (isUnit_iff_ne_zero.mpr hdet))
  intro y
  obtain ⟨c,hc⟩ := hs y
  refine ⟨⟨∑ q, c q • graphTensor A (x q).val,?_⟩,?_⟩
  · apply Submodule.sum_mem
    intro q _
    apply Submodule.smul_mem
    exact Submodule.subset_span ⟨x q,rfl⟩
  · ext p
    have hc' := congrFun hc p
    simpa only [LinearMap.comp_apply,Submodule.subtype_apply,map_sum,map_smul,
      Finset.sum_apply,Pi.smul_apply,smul_eq_mul,Matrix.mulVec, dotProduct,
      graphEvaluationMatrix,mul_comm] using hc'

/-- A graph coordinate as a polynomial in the original tensor entries. -/
def graphCoordinatePolynomial (x : Variables n → K) (u : Cell n) (j : J) :
    MvPolynomial (Cell n × J) K :=
  MvPolynomial.C (MvPolynomial.eval x (cellPolynomial (K := K) u)) *
    ∑ v : Cell n, MvPolynomial.X (v,j) *
      MvPolynomial.C (MvPolynomial.eval x (cellPolynomial (K := K) v))

theorem eval_graphCoordinatePolynomial (A : Matrix (Cell n) J K)
    (x : Variables n → K) (u : Cell n) (j : J) :
    MvPolynomial.eval (fun v => A v.1 v.2) (graphCoordinatePolynomial x u j)=
      graphTensor A x u j := by
  simp only [graphCoordinatePolynomial,map_mul,map_sum,MvPolynomial.eval_C,
    MvPolynomial.eval_X,graphTensor,eval_segreForm]

def graphEvaluationPolynomial (x : OrderedCriticalIndex n → FactorPoint n K) :
    Matrix (OrderedCriticalIndex n) (OrderedCriticalIndex n)
      (MvPolynomial (Cell n × J) K) := fun p q =>
  ∑ w : OtherCell n p.val.1, ∑ j : J,
    (MvPolynomial.X (assemble p.val.1 p.val.2.1 w,j) *
      graphCoordinatePolynomial (x q).val (assemble p.val.1 p.val.2.2 w) j -
     MvPolynomial.X (assemble p.val.1 p.val.2.2 w,j) *
      graphCoordinatePolynomial (x q).val (assemble p.val.1 p.val.2.1 w) j)

theorem eval_graphEvaluationPolynomial (A : Matrix (Cell n) J K)
    (x : OrderedCriticalIndex n → FactorPoint n K) :
    (graphEvaluationPolynomial (J := J) x).map (MvPolynomial.eval (fun v => A v.1 v.2))=
      graphEvaluationMatrix A x := by
  ext p q
  simp only [Matrix.map_apply,graphEvaluationPolynomial,map_sum,map_sub,map_mul,
    MvPolynomial.eval_X,eval_graphCoordinatePolynomial,graphEvaluationMatrix,
    orderedCriticalOperator_apply,criticalOperator]
  rfl

/-- One invertible test matrix gives the exact polynomial-open genericity
certificate for independence and the dimension of the actual relations. -/
theorem exists_certificate_of_test_witness [Infinite K]
    (x : OrderedCriticalIndex n → FactorPoint n K) (A₀ : Matrix (Cell n) J K)
    (h₀ : (graphEvaluationMatrix A₀ x).det≠0) :
    ∃ p : MvPolynomial (Cell n × J) K, p≠0 ∧
      ∀ A : Matrix (Cell n) J K, MvPolynomial.eval (fun v => A v.1 v.2) p≠0 →
        Disjoint (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A) ∧
        Module.finrank K (smallRelations A)=Fintype.card (OrderedCriticalIndex n) := by
  classical
  let p := (graphEvaluationPolynomial (J := J) x).det
  have he (A : Matrix (Cell n) J K) :
      MvPolynomial.eval (fun v => A v.1 v.2) p=(graphEvaluationMatrix A x).det := by
    simp only [show p=(graphEvaluationPolynomial (J := J) x).det from rfl,
      RingHom.map_det,RingHom.mapMatrix_apply,eval_graphEvaluationPolynomial]
  refine ⟨p,?_,?_⟩
  · intro hp
    apply h₀
    rw [←he A₀,hp,map_zero]
  · intro A hA
    rw [he] at hA
    have hs := ordered_graph_surjective_of_det A x hA
    exact ⟨disjoint_of_ordered_graph_surjective A hs,
      smallRelations_finrank_of_ordered_graph_surjective A hs⟩

end PaperVerification.Segre.CriticalGenericity

end SegreCriticalGenericity

section SegreStarCriticalWitness

/-!
# An actual star-supported tensor witnessing critical independence

There is one slice for the zero cell and one for each positive coordinate in
a single factor. Squared slice weights are chosen pairwise distinct over any
infinite field. Testing the actual graph at a sum of two coordinate vectors
in one factor and the zeroth coordinate in the other factors gives a diagonal
critical-evaluation matrix. Every characteristic is retained.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.StarCriticalWitness

open Staircase Monomials GraphSpan CriticalGraph CriticalGenericity SpanDefect
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

abbrev Star (n : I → ℕ) := Option (Σ i : I, Fin (n i))

def starCell : Star n → Cell n
  | none => 0
  | some ⟨i,a⟩ => Pi.single i a.succ

def coordinateStar (i : I) : Fin (n i+1) → Star n :=
  Fin.cases none (fun a => some ⟨i,a⟩)

@[simp] theorem coordinateStar_zero (i : I) : coordinateStar (n := n) i 0=none := rfl
@[simp] theorem coordinateStar_succ (i : I) (a : Fin (n i)) :
    coordinateStar i a.succ=some ⟨i,a⟩ := rfl

@[simp] theorem starCell_coordinateStar (i : I) (a : Fin (n i+1)) :
    starCell (coordinateStar i a)=Pi.single i a := by
  induction a using Fin.cases with
  | zero => simp [coordinateStar,starCell]
  | succ a => rfl

theorem coordinateStar_injective (i : I) :
    Function.Injective (coordinateStar (n := n) i) := by
  intro a b h
  have he := congrFun (congrArg starCell h) i
  simpa only [starCell_coordinateStar,Pi.single_eq_same] using he

theorem starCell_injective : Function.Injective (starCell (n := n)) := by
  intro s t h
  cases s with
  | none =>
    cases t with
    | none => rfl
    | some t =>
      rcases t with ⟨i,a⟩
      have he := congrFun h i
      have hz : a.succ=0 := by simpa [starCell] using he.symm
      exact (Fin.succ_ne_zero a hz).elim
  | some s =>
    rcases s with ⟨i,a⟩
    cases t with
    | none =>
      have he := congrFun h i
      have hz : a.succ=0 := by simpa [starCell] using he
      exact (Fin.succ_ne_zero a hz).elim
    | some t =>
      rcases t with ⟨j,b⟩
      have hij : i=j := by
        by_contra hne
        have he := congrFun h i
        have hz : a.succ=0 := by simpa [starCell,Pi.single_apply,hne,Ne.symm hne] using he
        exact Fin.succ_ne_zero a hz
      subst j
      have hab : a=b := by simpa [starCell] using congrFun h i
      subst b
      rfl

theorem card_star : Fintype.card (Star n)=sideSum n+1 := by
  simp [Star,Fintype.card_sigma,sideSum]

/-- Two coordinate vectors in the selected factor, with every other factor
equal to its zeroth coordinate vector. -/
def testVector (q : OrderedCriticalIndex n) : Variables n → K := fun z =>
  if z.1=q.val.1 then
    (if z.2=starCell (coordinateStar q.val.1 q.val.2.1) z.1 then 1 else 0) +
    (if z.2=starCell (coordinateStar q.val.1 q.val.2.2) z.1 then 1 else 0)
  else if z.2=0 then 1 else 0

theorem testVector_left (q : OrderedCriticalIndex n) (i : I) :
    testVector (K := K) q ⟨i,starCell (coordinateStar q.val.1 q.val.2.1) i⟩=1 := by
  by_cases hi : i=q.val.1
  · subst i
    simp [testVector,starCell_coordinateStar,ne_of_lt q.property]
  · simp [testVector,hi,starCell_coordinateStar,Pi.single_apply,Ne.symm hi]

theorem testVector_right (q : OrderedCriticalIndex n) (i : I) :
    testVector (K := K) q ⟨i,starCell (coordinateStar q.val.1 q.val.2.2) i⟩=1 := by
  by_cases hi : i=q.val.1
  · subst i
    simp [testVector,starCell_coordinateStar,Ne.symm (ne_of_lt q.property)]
  · simp [testVector,hi,starCell_coordinateStar,Pi.single_apply,Ne.symm hi]

def testPoint (q : OrderedCriticalIndex n) : FactorPoint n K :=
  ⟨testVector q,fun i =>
    ⟨starCell (coordinateStar q.val.1 q.val.2.1) i,by
      rw [testVector_left]
      exact one_ne_zero⟩⟩

theorem cell_eq_single_iff (u : Cell n) (i : I) (a : Fin (n i+1)) :
    u=Pi.single i a ↔ u i=a ∧ ∀ j,j≠i → u j=0 := by
  constructor
  · intro h
    subst u
    exact ⟨by simp,fun j hj => by simp [Pi.single_apply,hj,Ne.symm hj]⟩
  · rintro ⟨hi,hother⟩
    funext j
    by_cases hj : j=i
    · subst j
      simpa using hi
    · simpa [Pi.single_apply,hj,Ne.symm hj] using hother j hj

/-- The pure tensor represented by the test tuple is literally the sum of
the two selected coordinate cells. -/
theorem eval_cell_test (q : OrderedCriticalIndex n) (u : Cell n) :
    MvPolynomial.eval (testVector (K := K) q) (cellPolynomial u)=
      (if u=starCell (coordinateStar q.val.1 q.val.2.1) then 1 else 0) +
      (if u=starCell (coordinateStar q.val.1 q.val.2.2) then 1 else 0) := by
  classical
  rw [eval_cell_eq_prod]
  by_cases hout : ∀ j,j≠q.val.1 → u j=0
  · have hp : (∏ j : I,testVector (K := K) q ⟨j,u j⟩)=
        testVector q ⟨q.val.1,u q.val.1⟩ := by
      apply Finset.prod_eq_single q.val.1
      · intro j _ hj
        simp [testVector,hj,hout j hj]
      · simp
    rw [hp]
    have ha : u=starCell (coordinateStar q.val.1 q.val.2.1) ↔
        u q.val.1=q.val.2.1 := by
      rw [starCell_coordinateStar,cell_eq_single_iff]
      exact and_iff_left hout
    have hb : u=starCell (coordinateStar q.val.1 q.val.2.2) ↔
        u q.val.1=q.val.2.2 := by
      rw [starCell_coordinateStar,cell_eq_single_iff]
      exact and_iff_left hout
    simp only [ha, hb]
    simp only [testVector, if_pos rfl, starCell_coordinateStar,
      Pi.single_eq_same, ite_true]
  · push_neg at hout
    obtain ⟨j,hji,huj⟩ := hout
    have ha : u≠starCell (coordinateStar q.val.1 q.val.2.1) := by
      intro he
      exact huj (((cell_eq_single_iff u q.val.1 q.val.2.1).mp
        (he.trans (starCell_coordinateStar _ _))).2 j hji)
    have hb : u≠starCell (coordinateStar q.val.1 q.val.2.2) := by
      intro he
      exact huj (((cell_eq_single_iff u q.val.1 q.val.2.2).mp
        (he.trans (starCell_coordinateStar _ _))).2 j hji)
    rw [if_neg ha,if_neg hb,zero_add]
    apply Finset.prod_eq_zero (Finset.mem_univ j)
    simp [testVector,hji,huj]

theorem eval_star_test (q : OrderedCriticalIndex n) (s : Star n) :
    MvPolynomial.eval (testVector (K := K) q) (cellPolynomial (starCell s))=
      (if s=coordinateStar q.val.1 q.val.2.1 then 1 else 0) +
      (if s=coordinateStar q.val.1 q.val.2.2 then 1 else 0) := by
  rw [eval_cell_test]
  simp only [starCell_injective.eq_iff]

/-- The slice tensor is specified in its actual coordinate array, including
all unused last-factor coordinates. -/
def starTensor (e : Star n ↪ J) (weights : Star n → K) : Matrix (Cell n) J K :=
  fun u j => ∑ s : Star n, if j=e s then (if u=starCell s then weights s else 0) else 0

@[simp] theorem starTensor_image (e : Star n ↪ J) (weights : Star n → K)
    (u : Cell n) (s : Star n) :
    starTensor e weights u (e s)=if u=starCell s then weights s else 0 := by
  classical
  simp [starTensor,e.injective.eq_iff]

theorem starTensor_column_sum (e : Star n ↪ J) (weights : Star n → K)
    (u : Cell n) (f : J → K) :
    (∑ j : J,starTensor e weights u j*f j)=
      ∑ s : Star n,(if u=starCell s then weights s else 0)*f (e s) := by
  classical
  simp only [starTensor,Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro s _
  simp only [ite_mul,zero_mul,Finset.sum_ite_eq',Finset.mem_univ,if_true]

theorem lastContraction_star_image (e : Star n ↪ J) (weights : Star n → K)
    (x : Variables n → K) (s : Star n) :
    lastContraction (starTensor e weights) x (e s)=
      weights s*MvPolynomial.eval x (cellPolynomial (starCell s)) := by
  classical
  change MvPolynomial.eval x (Degeneration.segreForm (starTensor e weights) (e s))=_
  rw [eval_segreForm]
  simp only [starTensor_image,ite_mul,zero_mul,Finset.sum_ite_eq',
    Finset.mem_univ,if_true]

def otherCell (u : Cell n) (i : I) : OtherCell n i := fun j => u j.val

theorem assemble_otherCell (u : Cell n) (i : I) :
    assemble i (u i) (otherCell u i)=u := by
  funext j
  by_cases hj : j=i
  · subst j
    exact assemble_same _ _ _
  · exact assemble_other i (u i) (otherCell u i) ⟨j,hj⟩

theorem assemble_eq_iff (i : I) (a : Fin (n i+1)) (w : OtherCell n i) (u : Cell n) :
    assemble i a w=u ↔ a=u i ∧ w=otherCell u i := by
  constructor
  · intro h
    refine ⟨?_,?_⟩
    · simpa only [assemble_same] using congrFun h i
    · funext j
      simpa only [assemble_other,otherCell] using congrFun h j.val
  · rintro ⟨rfl,rfl⟩
    exact assemble_otherCell u i

/-- Contraction of the actual slice tensor, before specializing the factor
tuple or asserting any independence. -/
theorem factorContraction_star (e : Star n ↪ J) (weights : Star n → K)
    (x : Variables n → K) (y : J → K) (i : I) (a : Fin (n i+1)) :
    factorContraction (starTensor e weights) x y i a =
      ∑ s : Star n,if a=starCell s i then
        weights s*y (e s)*otherProduct x i (otherCell (starCell s) i) else 0 := by
  classical
  unfold factorContraction
  simp_rw [←Finset.sum_mul,starTensor_column_sum]
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro s _
  by_cases ha : a=starCell s i
  · rw [if_pos ha]
    rw [Finset.sum_eq_single (otherCell (starCell s) i)]
    · rw [if_pos ((assemble_eq_iff _ _ _ _).mpr ⟨ha,rfl⟩)]
    · intro w _ hw
      rw [if_neg (fun he => hw ((assemble_eq_iff _ _ _ _).mp he).2)]
      simp
    · simp
  · rw [if_neg ha]
    apply Finset.sum_eq_zero
    intro w _
    rw [if_neg (fun he => ha ((assemble_eq_iff _ _ _ _).mp he).1)]
    simp

theorem otherProduct_test_left (q : OrderedCriticalIndex n) (i : I) :
    otherProduct (testVector (K := K) q) i
      (otherCell (starCell (coordinateStar q.val.1 q.val.2.1)) i)=1 := by
  simp only [otherProduct,otherCell,testVector_left,Finset.prod_const_one]

theorem otherProduct_test_right (q : OrderedCriticalIndex n) (i : I) :
    otherProduct (testVector (K := K) q) i
      (otherCell (starCell (coordinateStar q.val.1 q.val.2.2)) i)=1 := by
  simp only [otherProduct,otherCell,testVector_right,Finset.prod_const_one]

theorem factorContraction_test (e : Star n ↪ J) (weights : Star n → K)
    (q : OrderedCriticalIndex n) (i : I) (a : Fin (n i+1)) :
    factorContraction (starTensor e weights) (testVector q)
      (lastContraction (starTensor e weights) (testVector q)) i a =
      (if a=starCell (coordinateStar q.val.1 q.val.2.1) i then
        (weights (coordinateStar q.val.1 q.val.2.1))^2 else 0) +
      (if a=starCell (coordinateStar q.val.1 q.val.2.2) i then
        (weights (coordinateStar q.val.1 q.val.2.2))^2 else 0) := by
  classical
  rw [factorContraction_star]
  have hterm (s : Star n) :
      (if a=starCell s i then
        weights s*lastContraction (starTensor e weights) (testVector q) (e s)*
          otherProduct (testVector q) i (otherCell (starCell s) i) else 0) =
      (if s=coordinateStar q.val.1 q.val.2.1 then
        (if a=starCell (coordinateStar q.val.1 q.val.2.1) i then
          (weights (coordinateStar q.val.1 q.val.2.1))^2 else 0) else 0) +
      (if s=coordinateStar q.val.1 q.val.2.2 then
        (if a=starCell (coordinateStar q.val.1 q.val.2.2) i then
          (weights (coordinateStar q.val.1 q.val.2.2))^2 else 0) else 0) := by
    have hne : coordinateStar q.val.1 q.val.2.1≠coordinateStar q.val.1 q.val.2.2 :=
      (coordinateStar_injective q.val.1).ne (ne_of_lt q.property)
    rw [lastContraction_star_image,eval_star_test]
    by_cases hs : s=coordinateStar q.val.1 q.val.2.1
    · subst s
      rw [otherProduct_test_left]
      simp [hne,pow_two]
    · by_cases ht : s=coordinateStar q.val.1 q.val.2.2
      · subst s
        rw [otherProduct_test_right]
        simp [Ne.symm hne,pow_two]
      · simp [hs,ht]
  simp only [hterm,Finset.sum_add_distrib,Finset.sum_ite_eq',
    Finset.mem_univ,if_true]

/-- The exact graph pairing is diagonal, including in characteristic two.
The diagonal entries are differences of squared slice weights. -/
theorem orderedCritical_test (e : Star n ↪ J) (weights : Star n → K)
    (p q : OrderedCriticalIndex n) :
    orderedCriticalOperator (starTensor e weights)
      (graphTensor (starTensor e weights) (testPoint q).val) p =
      if p=q then
        (weights (coordinateStar p.val.1 p.val.2.1))^2-
          (weights (coordinateStar p.val.1 p.val.2.2))^2 else 0 := by
  classical
  rw [orderedCriticalOperator_apply,criticalOperator_graphTensor]
  change testVector q ⟨p.val.1,p.val.2.2⟩ *
      factorContraction (starTensor e weights) (testVector q)
        (lastContraction (starTensor e weights) (testVector q)) p.val.1 p.val.2.1 -
    testVector q ⟨p.val.1,p.val.2.1⟩ *
      factorContraction (starTensor e weights) (testVector q)
        (lastContraction (starTensor e weights) (testVector q)) p.val.1 p.val.2.2 = _
  rw [factorContraction_test,factorContraction_test]
  rcases p with ⟨⟨i,a,b⟩,hab⟩
  rcases q with ⟨⟨j,c,d⟩,hcd⟩
  change a < b at hab
  change c < d at hcd
  have hab' : a.val < b.val := hab
  have hcd' : c.val < d.val := hcd
  by_cases hij : i=j
  · subst j
    have heq :
        (⟨⟨i,(a,b)⟩,hab⟩ : OrderedCriticalIndex n)=⟨⟨i,(c,d)⟩,hcd⟩ ↔
          a=c ∧ b=d := by
      simp only [Subtype.mk.injEq,Sigma.mk.inj_iff,heq_eq_eq,Prod.mk.injEq,true_and]
    simp only [testVector,if_pos rfl,starCell_coordinateStar,Pi.single_eq_same,heq]
    by_cases hac : a=c <;> by_cases had : a=d <;>
      by_cases hbc : b=c <;> by_cases hbd : b=d <;>
      simp_all <;> try omega <;> ring
  · have hpq :
        (⟨⟨i,(a,b)⟩,hab⟩ : OrderedCriticalIndex n)≠⟨⟨j,(c,d)⟩,hcd⟩ := by
      intro he
      exact hij (congrArg (fun q : OrderedCriticalIndex n => q.val.1) he)
    simp [testVector,hij,Ne.symm hij,starCell_coordinateStar,Pi.single_apply,hpq]
    split_ifs <;> ring

/-- Pairwise distinct squares are selected by a nonzero polynomial, without
assuming that squaring is injective in the field. -/
theorem exists_distinct_squared_weights [Infinite K] :
    ∃ weights : Star n → K,Function.Injective (fun s => (weights s)^2) := by
  classical
  let p : MvPolynomial (Star n) K :=
    ∏ s : Star n, ∏ t : Star n, if s=t then 1 else
      MvPolynomial.X s^2-MvPolynomial.X t^2
  have hterm (s t : Star n) (hst : s≠t) :
      (MvPolynomial.X s^2-MvPolynomial.X t^2 : MvPolynomial (Star n) K)≠0 := by
    intro hz
    have he := congrArg (MvPolynomial.eval (fun r => if r=s then (1 : K) else 0)) hz
    simpa [hst,Ne.symm hst] using he
  have hp : p≠0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro s _
    apply Finset.prod_ne_zero_iff.mpr
    intro t _
    by_cases hst : s=t
    · simp [hst]
    · simpa only [if_neg hst] using hterm s t hst
  obtain ⟨weights,hweights⟩ := GenericMatrixRank.exists_eval_ne_zero p hp
  refine ⟨weights,?_⟩
  intro s t heq
  by_contra hst
  have hs : MvPolynomial.eval weights
      (∏ t : Star n,if s=t then 1 else MvPolynomial.X s^2-MvPolynomial.X t^2)≠0 := by
    have hprod : (∏ s : Star n,MvPolynomial.eval weights
        (∏ t : Star n,if s=t then 1 else MvPolynomial.X s^2-MvPolynomial.X t^2))≠0 := by
      simpa only [p,map_prod] using hweights
    exact Finset.prod_ne_zero_iff.mp hprod s (Finset.mem_univ s)
  rw [map_prod] at hs
  have hst' := Finset.prod_ne_zero_iff.mp hs t (Finset.mem_univ t)
  simp only [if_neg hst,map_sub,map_pow,MvPolynomial.eval_X] at hst'
  exact hst' (sub_eq_zero.mpr heq)

/-- An actual tensor with the full critical test matrix invertible, for
every sufficiently large last factor and every infinite field. -/
theorem exists_det_witness [Infinite K]
    (hlen : sideSum n+1≤Fintype.card J) :
    ∃ A : Matrix (Cell n) J K,(graphEvaluationMatrix A (testPoint (K := K))).det≠0 := by
  classical
  obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le
    (α := Star n) (β := J) (by simpa only [card_star] using hlen)
  obtain ⟨weights,hweights⟩ := exists_distinct_squared_weights (K := K) (n := n)
  refine ⟨starTensor e weights,?_⟩
  have he : graphEvaluationMatrix (starTensor e weights) (testPoint (K := K)) =
      Matrix.diagonal (fun p : OrderedCriticalIndex n =>
        (weights (coordinateStar p.val.1 p.val.2.1))^2-
          (weights (coordinateStar p.val.1 p.val.2.2))^2) := by
    ext p q
    rw [graphEvaluationMatrix,orderedCritical_test]
    rfl
  rw [he,Matrix.det_diagonal]
  apply Finset.prod_ne_zero_iff.mpr
  intro p _
  apply sub_ne_zero.mpr
  intro h
  exact (ne_of_lt p.property) ((coordinateStar_injective p.val.1) (hweights h))

/-- Genuine generic independence of the actual small critical relation space
after multiplication, with no geometric or rank-independence premise. -/
theorem generic_independence [Infinite K] (hlen : sideSum n+1≤Fintype.card J) :
    ∃ p : MvPolynomial (Cell n × J) K,p≠0 ∧
      ∀ A : Matrix (Cell n) J K,MvPolynomial.eval (fun v => A v.1 v.2) p≠0 →
        Disjoint (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A) ∧
        Module.finrank K (smallRelations A)=Fintype.card (OrderedCriticalIndex n) := by
  obtain ⟨A,hA⟩ := exists_det_witness (K := K) hlen
  exact exists_certificate_of_test_witness (testPoint (K := K)) A hA

/-- The same actual generic-independence certificate with the paper's printed
binomial dimension, obtained by the explicit ordered-index equivalence. -/
theorem generic_independence_dimension [Infinite K]
    (hlen : sideSum n+1≤Fintype.card J) :
    ∃ p : MvPolynomial (Cell n × J) K,p≠0 ∧
      ∀ A : Matrix (Cell n) J K,MvPolynomial.eval (fun v => A v.1 v.2) p≠0 →
        Disjoint (LinearMap.ker (multiplicationOnCovectors A)) (smallRelations A) ∧
        Module.finrank K (smallRelations A)=∑ i, (n i+1).choose 2 := by
  simpa only [orderedCriticalIndex_card] using
    generic_independence (K := K) hlen

end PaperVerification.Segre.StarCriticalWitness

