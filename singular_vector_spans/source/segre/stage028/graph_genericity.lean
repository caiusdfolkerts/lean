section SegreGeometricBasePointFree

/-!
# The actual slice ideal on every projective chart

Surjectivity of the actual higher multiplication map puts a positive power of
every Segre coordinate in the actual slice ideal. Under any ring-valued
evaluation for which one Segre coordinate is a unit, the evaluated slice ideal
is therefore the unit ideal. In particular, this proves the statement on every
normalized affine chart and at every tuple over any extension field.

The polynomial certificate is the same full-row minor of the actual higher
multiplication matrix. No reducedness, algebraic closure, characteristic, or
geometric base-point-free premise is introduced.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.GeometricBasePointFree

open Staircase Monomials Balanced Artinian HigherPieces RankParameters
  GeneralParameters ArtinianOpen Degeneration GraphSpan CriticalGraph
open scoped BigOperators

universe u v
variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The literal ideal generated by the evaluated original tensor slices. -/
def evaluatedSliceIdeal {R : Type v} [CommRing R]
    (A : Matrix (Cell n) J K)
    (e : MvPolynomial (Variables n) K →+* R) : Ideal R :=
  Ideal.span (Set.range fun j => e (segreForm A j))

/-- The coordinate-power identity works in every commutative target ring,
including nonreduced rings; one invertible Segre coordinate is enough. -/
theorem evaluatedSliceIdeal_eq_top (q : ℕ) (A : Matrix (Cell n) J K)
    (hA : Function.Surjective (multiplication q A))
    {R : Type v} [CommRing R]
    (e : MvPolynomial (Variables n) K →+* R)
    (u : Cell n) (hu : IsUnit (e (cellPolynomial (K := K) u))) :
    evaluatedSliceIdeal A e = ⊤ := by
  have hle : ambientParameterIdeal (parameter A) ≤
      (evaluatedSliceIdeal A e).comap e := by
    apply Ideal.span_le.mpr
    rintro p ⟨j, rfl⟩
    change e (parameter A j).val ∈ evaluatedSliceIdeal A e
    rw [parameter_value]
    exact Ideal.subset_span (Set.mem_range_self j)
  have hm := mem_ambient_of_mem_parameterIdeal (parameter A)
    (coordinate_power_mem_of_surjective q A hA u)
  have hp := hle hm
  change e (cellPolynomial (K := K) u ^ (q + 1)) ∈
    evaluatedSliceIdeal A e at hp
  rw [map_pow] at hp
  exact (evaluatedSliceIdeal A e).eq_top_of_isUnit_mem hp (hu.pow (q + 1))

/-- All affine coordinates on the product chart with the indicated pivot in
each factor; there are precisely the nonpivot coordinates. -/
abbrev ChartVariable (u : Cell n) := Σ i : I, {j : Fin (n i + 1) // j ≠ u i}

/-- Actual normalized homogeneous coordinates on that product chart. -/
def chartCoordinate (u : Cell n) (a : Variables n) :
    MvPolynomial (ChartVariable u) K :=
  if h : a.2 = u a.1 then 1 else MvPolynomial.X ⟨a.1, ⟨a.2, h⟩⟩

@[simp] theorem chartCoordinate_pivot (u : Cell n) (i : I) :
    chartCoordinate (K := K) u ⟨i, u i⟩ = 1 := by
  simp [chartCoordinate]

/-- The actual substitution from multihomogeneous coordinates to the affine
polynomial ring of this normalized product chart. -/
def chartEvaluation (u : Cell n) :
    MvPolynomial (Variables n) K →+*
      MvPolynomial (ChartVariable u) K :=
  MvPolynomial.eval₂Hom MvPolynomial.C (chartCoordinate u)

theorem chartEvaluation_cell (u c : Cell n) :
    chartEvaluation (K := K) u (cellPolynomial c) =
      ∏ i, chartCoordinate (K := K) u ⟨i, c i⟩ := by
  rw [cellPolynomial_eq_prod, map_prod]
  simp only [chartEvaluation, MvPolynomial.eval₂Hom_X']

@[simp] theorem chartEvaluation_pivot (u : Cell n) :
    chartEvaluation (K := K) u (cellPolynomial u) = 1 := by
  rw [chartEvaluation_cell]
  simp only [chartCoordinate_pivot, Finset.prod_const_one]

/-- The actual normalized slice polynomials generate the unit ideal on every
chart. This is an ideal equality, rather than a statement only about K-points. -/
theorem chartSliceIdeal_eq_top (q : ℕ) (A : Matrix (Cell n) J K)
    (hA : Function.Surjective (multiplication q A)) (u : Cell n) :
    evaluatedSliceIdeal A (chartEvaluation u) = ⊤ := by
  apply evaluatedSliceIdeal_eq_top q A hA (chartEvaluation u) u
  rw [chartEvaluation_pivot]
  exact isUnit_one

section ExtensionField

variable {E : Type v} [Field E]

theorem eval₂_cell (h : K →+* E) (x : Variables n → E) (u : Cell n) :
    MvPolynomial.eval₂Hom h x (cellPolynomial (K := K) u) =
      ∏ i, x ⟨i, u i⟩ := by
  rw [cellPolynomial_eq_prod, map_prod]
  simp only [MvPolynomial.eval₂Hom_X']

/-- Extension of coefficients commutes with the literal tensor contraction. -/
theorem eval₂_parameter (h : K →+* E) (A : Matrix (Cell n) J K)
    (x : Variables n → E) (j : J) :
    MvPolynomial.eval₂Hom h x (parameter A j).val =
      lastContraction (A.map h) x j := by
  rw [parameter_value]
  change MvPolynomial.eval₂Hom h x (segreForm A j) =
    MvPolynomial.eval x (segreForm (A.map h) j)
  rw [eval_segreForm]
  simp only [segreForm, map_sum, MvPolynomial.eval₂Hom_smul,
    eval₂_cell, eval_cell_eq_prod, Matrix.map_apply, smul_eq_mul]

/-- No common zero exists even after any field extension. The premise concerns
the original multiplication map over K, not an assumed base-changed map. -/
theorem lastContraction_ne_zero (q : ℕ) (A : Matrix (Cell n) J K)
    (hA : Function.Surjective (multiplication q A))
    (h : K →+* E) (x : FactorPoint n E) :
    lastContraction (A.map h) x.val ≠ 0 := by
  classical
  intro hx
  have hker : ambientParameterIdeal (parameter A) ≤
      RingHom.ker (MvPolynomial.eval₂Hom h x.val) := by
    apply Ideal.span_le.mpr
    rintro p ⟨j, rfl⟩
    change MvPolynomial.eval₂Hom h x.val (parameter A j).val = 0
    rw [eval₂_parameter]
    exact congrFun hx j
  choose u hu using x.property
  have hc : MvPolynomial.eval₂Hom h x.val (cellPolynomial (K := K) u) ≠ 0 := by
    rw [eval₂_cell]
    exact Finset.prod_ne_zero_iff.mpr (fun i _ => hu i)
  have hm := mem_ambient_of_mem_parameterIdeal (parameter A)
    (coordinate_power_mem_of_surjective q A hA u)
  have hz := hker hm
  change MvPolynomial.eval₂Hom h x.val (cellPolynomial (K := K) u ^ (q + 1)) = 0 at hz
  rw [map_pow] at hz
  exact pow_ne_zero (q + 1) hc hz

end ExtensionField

/-- A genuine full-row minor certifies surjectivity of one fixed higher
multiplication map, before any geometric consequence is drawn. -/
theorem rank_many_surjectivity_certificate :
    ∃ (q : ℕ) (f : MvPolynomial (Cell n × Ranks n) K), f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Function.Surjective (multiplication q A) := by
  classical
  obtain ⟨q, hq⟩ := exists_fixed_surjective (K := K) (n := n)
  have hr : Module.finrank K (piece (K := K) (n := n) (q + 1)) ≤
      ((universalHigherMatrix (K := K) (n := n) (D := Ranks n) q).map
        (MvPolynomial.eval (fun j => rankForms (K := K) (n := n) j.1 j.2))).rank := by
    rw [eval_universalHigherMatrix]
    exact ((multiplication_surjective_iff_rank q _).mp hq).ge
  obtain ⟨f, hf, hw⟩ := GenericRank.minor_witness
    (universalHigherMatrix (K := K) (n := n) (D := Ranks n) q)
    (fun j => rankForms (K := K) (n := n) j.1 j.2)
    (Module.finrank K (piece (K := K) (n := n) (q + 1))) hr
  refine ⟨q, f, hf, ?_⟩
  intro A hA
  have hbound := hw (fun j => A j.1 j.2) hA
  rw [eval_universalHigherMatrix] at hbound
  apply (multiplication_surjective_iff_rank q A).mpr
  apply le_antisymm
  · simpa only [PieceIndex, Fintype.card_fin] using
      Matrix.rank_le_card_height (multiplicationMatrix q A)
  · exact hbound

/-- Adding slices preserves the actual evaluated ideal's equality to the
unit ideal, over any commutative target ring. -/
theorem evaluatedSliceIdeal_eq_top_of_subfamily
    (A : Matrix (Cell n) J K) (j : Ranks n ↪ J)
    {R : Type v} [CommRing R] (e : MvPolynomial (Variables n) K →+* R)
    (h : evaluatedSliceIdeal (fun u r => A u (j r)) e = ⊤) :
    evaluatedSliceIdeal A e = ⊤ := by
  apply top_unique
  rw [← h]
  apply Ideal.span_le.mpr
  rintro p ⟨r, rfl⟩
  exact Ideal.subset_span (Set.mem_range_self (j r))

/-- The exact generic range for the graph construction, with a genuine
nonzero polynomial and unit-ideal conclusions on all actual affine charts. -/
theorem chart_certificate (hlen : sideSum n + 1 ≤ Fintype.card J) :
    ∃ f : MvPolynomial (Cell n × J) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) J K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          ∀ u : Cell n, evaluatedSliceIdeal A (chartEvaluation u) = ⊤ := by
  classical
  obtain ⟨j⟩ := Function.Embedding.nonempty_of_card_le
    (α := Ranks n) (β := J) (by simpa only [Ranks, Fintype.card_fin] using hlen)
  obtain ⟨q, f, hf, hw⟩ := rank_many_surjectivity_certificate (K := K) (n := n)
  let ι : Cell n × Ranks n → Cell n × J := fun p => (p.1, j p.2)
  have hι : Function.Injective ι := by
    intro p q h
    change (p.1, j p.2) = (q.1, j q.2) at h
    have hfst : p.1 = q.1 := congrArg (fun z : Cell n × J => z.1) h
    have hsnd : j p.2 = j q.2 := congrArg (fun z : Cell n × J => z.2) h
    exact Prod.ext hfst (j.injective hsnd)
  refine ⟨MvPolynomial.rename ι f, ?_, ?_⟩
  · exact fun he => hf ((MvPolynomial.rename_eq_zero_iff_of_injective f hι).mp he)
  · intro A hA u
    let B : Matrix (Cell n) (Ranks n) K := fun c r => A c (j r)
    have hB : MvPolynomial.eval (fun p => B p.1 p.2) f ≠ 0 := by
      simpa only [MvPolynomial.eval_rename, Function.comp_def, ι, B] using hA
    apply evaluatedSliceIdeal_eq_top_of_subfamily A j
    exact chartSliceIdeal_eq_top q B (hw B hB) u

end PaperVerification.Segre.GeometricBasePointFree

end SegreGeometricBasePointFree

section SegreChartBasePointFree

/-!
# The genuine base-point-free certificate in the all-chart coordinates

The earlier full-row-minor certificate concerns actual slice ideals in a
sigma-indexed chart. This file identifies its substitution with the off-pivot
chart used by the singular-span theorem, preserving whole ideals. The unit
ideal on every chart then proves nonvanishing of the full last contraction
on every tuple of nonzero factor vectors.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ChartBasePointFree

open Staircase Monomials Degeneration GraphSpan CriticalGraph
open ProjectiveCharts ProjectivePointSpan
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The two actual chart substitutions differ only by the explicit regrouping
of their free variables; no change is made to any coefficient or equation. -/
theorem rename_chartEvaluation (p : Cell n) (f : MvPolynomial (Variables n) K) :
    MvPolynomial.rename (chartVarEquiv p).symm
      (GeometricBasePointFree.chartEvaluation p f)=chartSubstitution p f := by
  induction f using MvPolynomial.induction_on with
  | C c => simp [GeometricBasePointFree.chartEvaluation,chartSubstitution]
  | add f g hf hg => simp only [map_add,hf,hg]
  | mul_X f q hf =>
      simp only [map_mul,hf]
      congr 1
      by_cases hq : q.2=p q.1
      · simp [GeometricBasePointFree.chartEvaluation,GeometricBasePointFree.chartCoordinate,
          chartSubstitution,chartPolynomial,hq]
      · simp [GeometricBasePointFree.chartEvaluation,GeometricBasePointFree.chartCoordinate,
          chartSubstitution,chartPolynomial,hq,chartVarEquiv]

/-- The literal slice ideal in the coordinates used for the point-span bridge. -/
def chartSliceIdeal (A : Matrix (Cell n) J K) (p : Cell n) :
    Ideal (MvPolynomial (ChartVar p) K) :=
  Ideal.span (Set.range fun j => chartSubstitution p (segreForm A j))

theorem chartSliceIdeal_eq_map (A : Matrix (Cell n) J K) (p : Cell n) :
    chartSliceIdeal A p=
      (GeometricBasePointFree.evaluatedSliceIdeal A
        (GeometricBasePointFree.chartEvaluation p)).map
          (MvPolynomial.rename (R := K) (chartVarEquiv p).symm).toRingHom := by
  simp only [chartSliceIdeal,GeometricBasePointFree.evaluatedSliceIdeal,
    Ideal.map_span,← Set.range_comp,Function.comp_def,AlgHom.coe_toRingHom,
    rename_chartEvaluation]
  apply congrArg Ideal.span
  apply congrArg Set.range
  funext j
  exact (rename_chartEvaluation p (segreForm A j)).symm

/-- The actual certificate transports to an equality of the complete slice
ideals on every off-pivot chart. -/
theorem chartSliceIdeal_eq_top (A : Matrix (Cell n) J K) (p : Cell n)
    (h : GeometricBasePointFree.evaluatedSliceIdeal A
      (GeometricBasePointFree.chartEvaluation p)=⊤) : chartSliceIdeal A p=⊤ := by
  rw [chartSliceIdeal_eq_map,h,Ideal.map_top]

/-- All-chart unit ideals force nonvanishing at every projective tuple. -/
theorem lastContraction_ne_zero_of_chart_unit (A : Matrix (Cell n) J K)
    (h : ∀ p : Cell n,chartSliceIdeal A p=⊤) (x : FactorPoint n K) :
    lastContraction A x.val≠0 := by
  intro hx
  obtain ⟨p,hp⟩ := exists_pivots x
  let z := chartCoordinates p x.val
  have hc : (∏ i,x.val ⟨i,p i⟩)≠0 :=
    Finset.prod_ne_zero_iff.mpr (fun i _ => hp i)
  have hz (j : J) : MvPolynomial.eval (chartVector p z) (segreForm A j)=0 := by
    have he : MvPolynomial.eval x.val (segreForm A j)=0 := congrFun hx j
    conv_lhs at he => rw [← scale_normalized p x.val hp]
    rw [eval_segreForm_scaleFactors] at he
    exact (mul_eq_zero.mp he).resolve_left hc
  have hker : chartSliceIdeal A p ≤ RingHom.ker (MvPolynomial.eval z) := by
    apply Ideal.span_le.mpr
    rintro f ⟨j,rfl⟩
    change MvPolynomial.eval z (chartSubstitution p (segreForm A j))=0
    rw [eval_chartSubstitution]
    exact hz j
  have h1 : (1 : MvPolynomial (ChartVar p) K) ∈ chartSliceIdeal A p := by
    rw [h p]
    trivial
  have he := hker h1
  change MvPolynomial.eval z (1 : MvPolynomial (ChartVar p) K)=0 at he
  exact one_ne_zero (by simpa only [map_one] using he)

/-- The exact graph-format numerical range gives a nonzero polynomial whose
nonvanishing implies the base-point hypothesis used by the span theorem. -/
theorem generic_lastContraction_ne_zero
    (hlen : sideSum n+1≤Fintype.card J) :
    ∃ f : MvPolynomial (Cell n × J) K,f≠0 ∧
      ∀ A : Matrix (Cell n) J K,MvPolynomial.eval (fun q => A q.1 q.2) f≠0 →
        ∀ x : FactorPoint n K,lastContraction A x.val≠0 := by
  obtain ⟨f,hf,hw⟩ := GeometricBasePointFree.chart_certificate (K := K) hlen
  refine ⟨f,hf,?_⟩
  intro A hA
  exact lastContraction_ne_zero_of_chart_unit A
    (fun p => chartSliceIdeal_eq_top A p (hw A hA p))

end PaperVerification.Segre.ChartBasePointFree

end SegreChartBasePointFree

section SegreGenericGraphChartCertificate

/-!
# Generic finiteness and reducedness of the actual graph critical charts

The normalized incidence certificate is transported by a complete permutation
of the original tensor coefficients at every pair of projective pivots. The
resulting nonzero polynomial is combined with the proved slice-cover
certificate. Exact quotient elimination and localization descent then prove
finiteness and reducedness of every literal graph critical coordinate ring.

-/

set_option autoImplicit false
open scoped Classical BigOperators

namespace PaperVerification.Segre.GenericGraphChartCertificate

open Staircase Monomials GraphSpan CriticalGraph SingularSpan ProjectiveCharts
open ProjectivePointSpan GraphCriticalElimination FullGraphChartReindex
open ChartBasePointFree MvPolynomial

variable {I J K : Type} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] [Infinite K] {n : I → ℕ}

/-- A common nonzero coefficient polynomial for every complete full-factor
chart in the nested coordinates required by graph elimination. -/
theorem exists_full_chart_certificate :
    ∃ r : MvPolynomial (Cell n × J) K,r≠0 ∧
      ∀ A : Matrix (Cell n) J K,eval (fun q => A q.1 q.2) r≠0 →
        ∀ (p : Cell n) (j : J),
          Module.Finite K (FullChartRing A p j) ∧ IsReduced (FullChartRing A p j) := by
  choose r hr hw using fun q : Cell n × J =>
    GenericChartCertificate.exists_finite_reduced_certificate
      (K := K) (ι := Option I) (σ := FullFree q.1 q.2)
  let f (q : Cell n × J) : MvPolynomial (Cell n × J) K :=
    rename (fullCellEquiv q.1 q.2) (r q)
  have hf (q : Cell n × J) : f q≠0 := by
    intro h
    exact hr q ((rename_eq_zero_iff_of_injective (r q)
      (fullCellEquiv q.1 q.2).injective).mp h)
  refine ⟨∏ q,f q,Finset.prod_ne_zero_iff.mpr (fun q _ => hf q),?_⟩
  intro A hA p j
  rw [map_prod] at hA
  have hq := Finset.prod_ne_zero_iff.mp hA (p,j) (Finset.mem_univ (p,j))
  have h := hw (p,j) (fullTensor A p j) (by
    change eval (fun v => A (fullCellEquiv p j v).1 (fullCellEquiv p j v).2)
      (r (p,j)) ≠ 0
    simpa only [f,eval_rename,Function.comp_def] using hq)
  letI : Module.Finite K
      (MvPolynomial (CriticalChart.Coordinate (σ := FullFree p j)) K ⧸
        Ideal.span (Set.range (CriticalChart.criticalEquation (fullTensor A p j)))) := h.1
  letI : IsReduced
      (MvPolynomial (CriticalChart.Coordinate (σ := FullFree p j)) K ⧸
        Ideal.span (Set.range (CriticalChart.criticalEquation (fullTensor A p j)))) := h.2
  exact ⟨Module.Finite.of_surjective (fullChartQuotientEquiv A p j).toLinearMap
      (fullChartQuotientEquiv A p j).surjective,
    isReduced_of_injective (fullChartQuotientEquiv A p j).symm
      (fullChartQuotientEquiv A p j).symm.injective⟩

/-- Finiteness and reducedness of the graph critical scheme are proved on a
single nonempty coefficient open, in the complete graph-format range. -/
theorem exists_graph_chart_certificate (hlen : sideSum n+1≤Fintype.card J) :
    ∃ r : MvPolynomial (Cell n × J) K,r≠0 ∧
      ∀ A : Matrix (Cell n) J K,eval (fun q => A q.1 q.2) r≠0 →
        (∀ x : FactorPoint n K,lastContraction A x.val≠0) ∧
        ∀ p : Cell n,
          Module.Finite K (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p) ∧
          IsReduced (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p) := by
  obtain ⟨b,hb,hbw⟩ := GeometricBasePointFree.chart_certificate (K := K) hlen
  obtain ⟨r,hr,hrw⟩ := exists_full_chart_certificate (K := K) (J := J) (n := n)
  refine ⟨b*r,mul_ne_zero hb hr,?_⟩
  intro A hA
  rw [map_mul] at hA
  have hbase : ∀ p : Cell n,chartSliceIdeal A p=⊤ :=
    fun p => chartSliceIdeal_eq_top A p (hbw A (mul_ne_zero_iff.mp hA).1 p)
  have hfull := hrw A (mul_ne_zero_iff.mp hA).2
  refine ⟨lastContraction_ne_zero_of_chart_unit A hbase,?_⟩
  intro p
  exact ⟨graphChart_finite_of_full_charts A p (hbase p) (fun j => (hfull p j).1),
    graphChart_reduced_of_full_charts A p (hbase p) (fun j => (hfull p j).2)⟩

/-- The displayed principal open is nonempty over every infinite coefficient field. -/
theorem exists_nonempty_graph_chart_certificate (hlen : sideSum n+1≤Fintype.card J) :
    ∃ r : MvPolynomial (Cell n × J) K,r≠0 ∧
      (∃ A : Matrix (Cell n) J K,eval (fun q => A q.1 q.2) r≠0) ∧
      ∀ A : Matrix (Cell n) J K,eval (fun q => A q.1 q.2) r≠0 →
        (∀ x : FactorPoint n K,lastContraction A x.val≠0) ∧
        ∀ p : Cell n,
          Module.Finite K (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p) ∧
          IsReduced (MvPolynomial (ChartVar p) K ⧸ chartCriticalIdeal A p) := by
  obtain ⟨r,hr,hw⟩ := exists_graph_chart_certificate (K := K) hlen
  refine ⟨r,hr,?_,hw⟩
  by_contra h
  push_neg at h
  apply hr
  apply MvPolynomial.funext
  intro v
  simpa only [map_zero] using h (fun u j => v (u,j))

/-- The literal singular-point span is generically detected by the complete
graph defining ideals, with the required reducedness proved above. -/
theorem generic_singular_annihilator_eq_chart_ideal_intersection [IsAlgClosed K]
    (hlen : sideSum n+1≤Fintype.card J) :
    ∃ r : MvPolynomial (Cell n × J) K,r≠0 ∧
      ∀ A : Matrix (Cell n) J K,eval (fun q => A q.1 q.2) r≠0 →
        (singularSpan A).dualAnnihilator=
