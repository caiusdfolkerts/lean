section SegreReducedSliceCover

/-!
# Reducedness descends from the complete slice cover

A family generating the unit ideal gives an injective map into the product
of its principal localizations. Consequently reducedness can be checked on
that cover. Quotient localization and the exact graph elimination equivalence
then transfer reducedness of every full normalized critical chart to the
actual graph quotient. This argument retains all nilpotents until they have
been excluded by proved ring-theoretic statements.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.ReducedSliceCover

open MvPolynomial GraphQuotientElimination
open scoped BigOperators
attribute [local instance] MvPolynomial.algebraMvPolynomial

variable {R J Q : Type*} [CommRing R]

/-- The principal-open cover jointly detects every element, including
nilpotents; no reducedness of the original ring is assumed. -/
theorem isReduced_of_away_cover (s : Set R) (hs : Ideal.span s=⊤)
    (hred : ∀ a : s,IsReduced (Localization.Away a.val)) : IsReduced R := by
  letI := hred
  exact isReduced_of_injective
    (algebraMap R (∀ a : s,Localization.Away a.val))
    (Localization.algebraMap_injective_of_span_eq_top s hs)

theorem isReduced_of_away_family (f : J → R) (hf : Ideal.span (Set.range f)=⊤)
    (hred : ∀ j,IsReduced (Localization.Away (f j))) : IsReduced R := by
  apply isReduced_of_away_cover (Set.range f) hf
  rintro ⟨r,j,rfl⟩
  exact hred j

/-- The quotient of a principal localization is the localization of the
actual quotient, with its original algebra map. -/
def quotientAwayEquiv (I : Ideal R) (r : R) :
    Localization.Away (Ideal.Quotient.mk I r) ≃ₐ[R ⧸ I]
      Localization.Away r ⧸ I.map (algebraMap R (Localization.Away r)) := by
  letI : IsLocalization (Submonoid.powers (Ideal.Quotient.mk I r))
      (Localization.Away r ⧸ I.map (algebraMap R (Localization.Away r))) := by
    simpa only [Algebra.algebraMapSubmonoid,Submonoid.map_powers,
      Ideal.Quotient.algebraMap_eq] using
      (inferInstance : IsLocalization
        (Algebra.algebraMapSubmonoid (R ⧸ I) (Submonoid.powers r))
        (Localization.Away r ⧸ I.map (algebraMap R (Localization.Away r))))
  exact IsLocalization.algEquiv (Submonoid.powers (Ideal.Quotient.mk I r)) _ _

/-- The complete actual quotient is reduced if all of its members of a
unit-ideal principal cover are reduced. -/
theorem quotient_isReduced_of_away_family (I : Ideal R) (f : J → R)
    (hf : Ideal.span (Set.range f)=⊤)
    (hred : ∀ j,IsReduced
      (Localization.Away (f j) ⧸ I.map (algebraMap R (Localization.Away (f j))))) :
    IsReduced (R ⧸ I) := by
  have hcover : Ideal.span (Set.range fun j => Ideal.Quotient.mk I (f j))=⊤ := by
    change Ideal.span (Set.range ((Ideal.Quotient.mk I) ∘ f)) = ⊤
    rw [Set.range_comp,← Ideal.map_span,hf,Ideal.map_top]
  apply isReduced_of_away_family (fun j => Ideal.Quotient.mk I (f j)) hcover
  intro j
  letI := hred j
  exact isReduced_of_injective (quotientAwayEquiv I (f j))
    (quotientAwayEquiv I (f j)).injective

section Finite

variable {K : Type*} [Field K] [Algebra K R]

/-- The canonical map between quotient algebras retains the original
coefficient-field action. This proves the scalar tower used below. -/
private theorem quotientMap_scalarTower (S : Type*) [CommRing S]
    [Algebra R S] [Algebra K S] [IsScalarTower K R S] (I : Ideal R) :
    IsScalarTower K (R ⧸ I) (S ⧸ I.map (algebraMap R S)) := by
  apply IsScalarTower.of_algebraMap_eq
  intro c
  change Ideal.Quotient.mk (I.map (algebraMap R S)) (algebraMap K S c) =
    algebraMap (R ⧸ I) (S ⧸ I.map (algebraMap R S))
      (Ideal.Quotient.mk I (algebraMap K R c))
  rw [Ideal.Quotient.algebraMap_quotient_map_quotient,
    ← IsScalarTower.algebraMap_apply K R S]

/-- A localization of a finite algebra over a field is still finite over
that original field: its Artinian coefficient map is surjective. -/
theorem finite_localization (M : Submonoid R) (S : Type*) [CommRing S]
    [Algebra R S] [Algebra K S] [IsScalarTower K R S] [IsLocalization M S]
    [Module.Finite K R] : Module.Finite K S := by
  haveI : IsArtinianRing R := IsArtinianRing.of_finite K R
  exact Module.Finite.of_surjective (IsScalarTower.toAlgHom K R S).toLinearMap
    (IsArtinianRing.localization_surjective M S)

/-- Finitely many finite principal-open algebras detect the whole algebra,
so no properness premise is required for this affine finiteness descent. -/
theorem finite_of_away_family [Finite J] (f : J → R)
    (hf : Ideal.span (Set.range f)=⊤)
    (hfin : ∀ j,Module.Finite K (Localization.Away (f j))) : Module.Finite K R := by
  classical
  letI : Fintype (Set.range f) := Fintype.ofFinite _
  letI : ∀ a : Set.range f,Module.Finite K (Localization.Away a.val) := by
    rintro ⟨r,j,rfl⟩
    exact hfin j
  exact Module.Finite.of_injective
    (IsScalarTower.toAlgHom K R (∀ a : Set.range f,Localization.Away a.val)).toLinearMap
    (Localization.algebraMap_injective_of_span_eq_top (Set.range f) hf)

theorem quotient_finite_of_away_family [Finite J] (I : Ideal R) (f : J → R)
    (hf : Ideal.span (Set.range f)=⊤)
    (hfin : ∀ j,Module.Finite K
      (Localization.Away (f j) ⧸ I.map (algebraMap R (Localization.Away (f j))))) :
    Module.Finite K (R ⧸ I) := by
  have hcover : Ideal.span (Set.range fun j => Ideal.Quotient.mk I (f j))=⊤ := by
    change Ideal.span (Set.range ((Ideal.Quotient.mk I) ∘ f)) = ⊤
    rw [Set.range_comp,← Ideal.map_span,hf,Ideal.map_top]
  apply finite_of_away_family (fun j => Ideal.Quotient.mk I (f j)) hcover
  intro j
  letI := hfin j
  letI : IsScalarTower K (R ⧸ I)
      (Localization.Away (f j) ⧸ I.map (algebraMap R (Localization.Away (f j)))) :=
    quotientMap_scalarTower (K := K) (Localization.Away (f j)) I
  let e := (quotientAwayEquiv I (f j)).restrictScalars K
  exact Module.Finite.of_injective e.toLinearMap e.injective

end Finite

section Critical

variable [Fintype J] [DecidableEq J]

theorem map_lastCoordinate {S : Type*} [CommRing S] (φ : R →+* S) (j₀ j : J) :
    MvPolynomial.map φ (lastCoordinate (R := R) j₀ j)=lastCoordinate j₀ j := by
  by_cases hj : j=j₀ <;> simp [lastCoordinate,hj]

theorem map_fullSmallEquation {S : Type*} [CommRing S] (φ : R →+* S)
    (d : Q → J → R) (j₀ : J) (q : Q) :
    MvPolynomial.map φ (fullSmallEquation d j₀ q)=
      fullSmallEquation (fun q j => φ (d q j)) j₀ q := by
  simp only [fullSmallEquation,map_sum,map_mul,MvPolynomial.map_C,map_lastCoordinate]

/-- Coefficient extension preserves the complete defining full chart ideal. -/
theorem map_fullCriticalIdeal {S : Type*} [CommRing S] (φ : R →+* S)
    (d : Q → J → R) (f : J → R) (j₀ : J) :
    (fullCriticalIdeal d f j₀).map (MvPolynomial.map φ)=
      fullCriticalIdeal (fun q j => φ (d q j)) (fun j => φ (f j)) j₀ := by
  simp only [fullCriticalIdeal,Ideal.map_sup,Ideal.map_span,← Set.range_comp,
    Function.comp_def,map_sub,map_mul,MvPolynomial.map_C,MvPolynomial.map_X,
    map_fullSmallEquation]

theorem map_graphCriticalIdeal {S : Type*} [CommRing S] (φ : R →+* S)
    (d : Q → J → R) (f : J → R) :
    (graphCriticalIdeal d f).map φ=
      graphCriticalIdeal (fun q j => φ (d q j)) (fun j => φ (f j)) := by
  simp only [graphCriticalIdeal,Ideal.map_span,← Set.range_comp,Function.comp_def,
    graphEquation,map_sum,map_mul]
  rfl

/-- Reduced full chart quotients remain reduced after localizing the base
coefficient ring at the chosen slice. -/
theorem localized_fullCriticalQuotient_isReduced
    (d : Q → J → R) (f : J → R) (j₀ : J)
    [IsReduced (MvPolynomial (LastFree j₀) R ⧸ fullCriticalIdeal d f j₀)] :
    IsReduced
      (MvPolynomial (LastFree j₀) (Localization.Away (f j₀)) ⧸
        fullCriticalIdeal
          (fun q j => algebraMap R (Localization.Away (f j₀)) (d q j))
          (fun j => algebraMap R (Localization.Away (f j₀)) (f j)) j₀) := by
  let P := MvPolynomial (LastFree j₀) R
  let S := MvPolynomial (LastFree j₀) (Localization.Away (f j₀))
  let N : Submonoid P := (Submonoid.powers (f j₀)).map C
  let I := fullCriticalIdeal d f j₀
  haveI : IsLocalization N S := MvPolynomial.isLocalization _ _
  haveI : IsReduced (S ⧸ I.map (algebraMap P S)) :=
    isReduced_localizationPreserves (Algebra.algebraMapSubmonoid (P ⧸ I) N)
      (S ⧸ I.map (algebraMap P S)) inferInstance
  have he : I.map (algebraMap P S)=
      fullCriticalIdeal
        (fun q j => algebraMap R (Localization.Away (f j₀)) (d q j))
        (fun j => algebraMap R (Localization.Away (f j₀)) (f j)) j₀ :=
    map_fullCriticalIdeal (algebraMap R (Localization.Away (f j₀))) d f j₀
  rw [← he]
  infer_instance

/-- If the complete slice vector has no base locus, reducedness of every
full critical chart implies reducedness of the actual graph critical ring. -/
theorem graphCriticalQuotient_isReduced_of_full_charts
    (d : Q → J → R) (f : J → R)
    (hbase : Ideal.span (Set.range f)=⊤)
    (hred : ∀ j,IsReduced (MvPolynomial (LastFree j) R ⧸ fullCriticalIdeal d f j)) :
    IsReduced (R ⧸ graphCriticalIdeal d f) := by
  apply quotient_isReduced_of_away_family (graphCriticalIdeal d f) f hbase
  intro j₀
  let S := Localization.Away (f j₀)
  let φ := algebraMap R S
  let u : Sˣ := (IsLocalization.Away.algebraMap_isUnit (S := S) (f j₀)).unit
  have hu : (u : S)=φ (f j₀) := IsUnit.unit_spec _
  letI := hred j₀
  haveI : IsReduced (MvPolynomial (LastFree j₀) S ⧸
      fullCriticalIdeal (fun q j => φ (d q j)) (fun j => φ (f j)) j₀) :=
    localized_fullCriticalQuotient_isReduced d f j₀
  rw [map_graphCriticalIdeal]
  exact graphCriticalQuotient_isReduced
    (fun q j => φ (d q j)) (fun j => φ (f j)) j₀ u hu

section Finite

variable {K : Type*} [Field K] [Algebra K R]

theorem localized_fullCriticalQuotient_finite
    (d : Q → J → R) (f : J → R) (j₀ : J)
    [Module.Finite K (MvPolynomial (LastFree j₀) R ⧸ fullCriticalIdeal d f j₀)] :
    Module.Finite K
      (MvPolynomial (LastFree j₀) (Localization.Away (f j₀)) ⧸
        fullCriticalIdeal
          (fun q j => algebraMap R (Localization.Away (f j₀)) (d q j))
          (fun j => algebraMap R (Localization.Away (f j₀)) (f j)) j₀) := by
  let P := MvPolynomial (LastFree j₀) R
  let S := MvPolynomial (LastFree j₀) (Localization.Away (f j₀))
  let N : Submonoid P := (Submonoid.powers (f j₀)).map C
  let I := fullCriticalIdeal d f j₀
  haveI : IsLocalization N S := MvPolynomial.isLocalization _ _
  letI : IsScalarTower K P S := IsScalarTower.of_algebraMap_eq fun c => by
    change MvPolynomial.C (algebraMap K (Localization.Away (f j₀)) c) =
      MvPolynomial.map (algebraMap R (Localization.Away (f j₀)))
        (MvPolynomial.C (algebraMap K R c))
    rw [MvPolynomial.map_C, IsScalarTower.algebraMap_apply K R]
  letI : IsScalarTower K (P ⧸ I) (S ⧸ I.map (algebraMap P S)) :=
    quotientMap_scalarTower (K := K) (R := P) S I
  haveI : Module.Finite K (S ⧸ I.map (algebraMap P S)) :=
    finite_localization (K := K) (Algebra.algebraMapSubmonoid (P ⧸ I) N)
      (S ⧸ I.map (algebraMap P S))
  have he : I.map (algebraMap P S)=
      fullCriticalIdeal
        (fun q j => algebraMap R (Localization.Away (f j₀)) (d q j))
        (fun j => algebraMap R (Localization.Away (f j₀)) (f j)) j₀ :=
    map_fullCriticalIdeal (algebraMap R (Localization.Away (f j₀))) d f j₀
  rw [← he]
  infer_instance

/-- Finiteness of all full normalized critical charts descends to the
complete graph coordinate ring on every smaller-factor affine chart. -/
theorem graphCriticalQuotient_finite_of_full_charts
    (d : Q → J → R) (f : J → R)
    (hbase : Ideal.span (Set.range f)=⊤)
    (hfin : ∀ j,Module.Finite K
      (MvPolynomial (LastFree j) R ⧸ fullCriticalIdeal d f j)) :
    Module.Finite K (R ⧸ graphCriticalIdeal d f) := by
  apply quotient_finite_of_away_family (graphCriticalIdeal d f) f hbase
  intro j₀
  let S := Localization.Away (f j₀)
  let φ := algebraMap R S
  let u : Sˣ := (IsLocalization.Away.algebraMap_isUnit (S := S) (f j₀)).unit
  have hu : (u : S)=φ (f j₀) := IsUnit.unit_spec _
  letI := hfin j₀
  haveI : Module.Finite K (MvPolynomial (LastFree j₀) S ⧸
      fullCriticalIdeal (fun q j => φ (d q j)) (fun j => φ (f j)) j₀) :=
    localized_fullCriticalQuotient_finite d f j₀
  rw [map_graphCriticalIdeal]
  let e := (fullGraphQuotientEquiv
    (fun q j => φ (d q j)) (fun j => φ (f j)) j₀ u hu).restrictScalars K
  exact Module.Finite.of_injective e.symm.toLinearMap e.symm.injective

end Finite

end Critical

end PaperVerification.Segre.ReducedSliceCover

end SegreReducedSliceCover

section SegreGraphCriticalElimination

/-!
# The literal full and graph critical equations under elimination

The coefficients below are the original critical-operator coefficients on a
normalized smaller-factor chart. Their linear combination with the last-factor
coordinates is the full singular equation. Their linear combination with the
slice vector is exactly the graph critical polynomial already used in the
point-span bridge. These identities identify complete ideals after arbitrary
coefficient-ring maps, including localization at a slice.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.GraphCriticalElimination

open Staircase Monomials Degeneration Trace GraphSpan CriticalGraph SingularSpan
open ProjectiveCharts ProjectivePointSpan GraphQuotientElimination MvPolynomial
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- The coefficient of one last-factor coordinate in the genuine critical
equation, with every original tensor coefficient retained. -/
def sliceCriticalCoefficient (A : Matrix (Cell n) J K) (p : Cell n)
    (q : CriticalIndex n) (j : J) : MvPolynomial (ChartVar p) K :=
  ∑ w : OtherCell n q.1,
    (C (A (assemble q.1 q.2.1 w) j)*chartSubstitution p (cellPolynomial (assemble q.1 q.2.2 w))-
      C (A (assemble q.1 q.2.2 w) j)*chartSubstitution p (cellPolynomial (assemble q.1 q.2.1 w)))

/-- The actual graph critical polynomial is precisely the contraction of
these coefficients against the complete slice vector. -/
theorem graphEquation_eq_chartCriticalPolynomial (A : Matrix (Cell n) J K)
    (p : Cell n) (q : CriticalIndex n) :
    graphEquation (sliceCriticalCoefficient A p)
      (fun j => chartSubstitution p (segreForm A j)) q=
        ProjectivePointSpan.chartCriticalPolynomial A p q := by
  unfold graphEquation sliceCriticalCoefficient ProjectivePointSpan.chartCriticalPolynomial
  simp only [Finset.sum_mul,chartGraphCoordinate,map_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro w _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The same coefficients reproduce the full original critical operator
for every last-factor vector, not only for the graph substitution. -/
theorem eval_coefficient_sum (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) (y : J → K) (q : CriticalIndex n) :
    (∑ j,MvPolynomial.eval z (sliceCriticalCoefficient A p q j)*y j)=
      criticalOperator A (rankOneTensor (chartVector p z) y) q := by
  change (∑ j,MvPolynomial.eval z (sliceCriticalCoefficient A p q j)*y j)=
    ∑ w : OtherCell n q.1,∑ j : J,
      (A (assemble q.1 q.2.1 w) j*rankOneTensor (chartVector p z) y (assemble q.1 q.2.2 w) j-
        A (assemble q.1 q.2.2 w) j*rankOneTensor (chartVector p z) y (assemble q.1 q.2.1 w) j)
  simp only [sliceCriticalCoefficient,map_sum,map_sub,map_mul,eval_C,
    eval_chartSubstitution,Finset.sum_mul,rankOneTensor]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro w _
  apply Finset.sum_congr rfl
  intro j _
  ring

def normalizedLastVector (j₀ : J) (w : LastFree j₀ → K) (j : J) : K :=
  if h : j=j₀ then 1 else w ⟨j,h⟩

@[simp] theorem normalizedLastVector_pivot (j₀ : J) (w : LastFree j₀ → K) :
    normalizedLastVector j₀ w j₀=1 := by simp [normalizedLastVector]

@[simp] theorem normalizedLastVector_free (j₀ : J) (w : LastFree j₀ → K)
    (j : LastFree j₀) : normalizedLastVector j₀ w j.val=w j := by
  simp [normalizedLastVector,j.property]

/-- The nested polynomial's coefficients and variables are evaluated in
the two actual projective charts. -/
theorem eval₂_fullSmallEquation (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) (j₀ : J) (w : LastFree j₀ → K) (q : CriticalIndex n) :
    (MvPolynomial.eval₂Hom (MvPolynomial.eval z) w)
      (fullSmallEquation (sliceCriticalCoefficient A p) j₀ q)=
        criticalOperator A (rankOneTensor (chartVector p z) (normalizedLastVector j₀ w)) q := by
  have hlast (j : J) :
      (MvPolynomial.eval₂Hom (MvPolynomial.eval z) w)
        (lastCoordinate (R := MvPolynomial (ChartVar p) K) j₀ j)=
          normalizedLastVector j₀ w j := by
    by_cases hj : j=j₀ <;> simp [lastCoordinate,normalizedLastVector,hj]
  simp only [fullSmallEquation,map_sum,map_mul,MvPolynomial.eval₂Hom_C,hlast]
  exact eval_coefficient_sum A p z (normalizedLastVector j₀ w) q

/-- The last-mode pivot polynomial is exactly the original last critical
equation on the complete rank-one tensor. -/
theorem eval₂_fullLastEquation (A : Matrix (Cell n) J K) (p : Cell n)
    (z : ChartVar p → K) (j₀ : J) (w : LastFree j₀ → K) (j : LastFree j₀) :
    (MvPolynomial.eval₂Hom (MvPolynomial.eval z) w)
      (C (chartSubstitution p (segreForm A j.val))-
        C (chartSubstitution p (segreForm A j₀))*X j)=
      lastCriticalOperator A
        (rankOneTensor (chartVector p z) (normalizedLastVector j₀ w)) (j.val,j₀) := by
  rw [lastCriticalOperator_rankOne]
  simp [lastContraction,eval_chartSubstitution]

/-- Retain exactly one pivot equation for each free smaller-factor coordinate. -/
def slicePivotCoefficient (A : Matrix (Cell n) J K) (p : Cell n)
    (q : ChartVar p) (j : J) : MvPolynomial (ChartVar p) K :=
  sliceCriticalCoefficient A p ⟨q.val.1,(q.val.2,p q.val.1)⟩ j

theorem graphEquation_eq_pivotCriticalPolynomial (A : Matrix (Cell n) J K)
    (p : Cell n) (q : ChartVar p) :
    graphEquation (slicePivotCoefficient A p)
      (fun j => chartSubstitution p (segreForm A j)) q=
        ProjectivePointSpan.pivotCriticalPolynomial A p q :=
  graphEquation_eq_chartCriticalPolynomial A p ⟨q.val.1,(q.val.2,p q.val.1)⟩

/-- The graph equation identity survives every ring homomorphism, especially
the actual localization at the selected slice. -/
theorem graphEquation_map {R : Type*} [CommRing R]
    (A : Matrix (Cell n) J K) (p : Cell n)
    (φ : MvPolynomial (ChartVar p) K →+* R) (q : ChartVar p) :
    graphEquation (fun q j => φ (slicePivotCoefficient A p q j))
      (fun j => φ (chartSubstitution p (segreForm A j))) q=
        φ (ProjectivePointSpan.pivotCriticalPolynomial A p q) := by
  rw [← graphEquation_eq_pivotCriticalPolynomial]
  simp only [graphEquation,map_sum,map_mul]

/-- Equality of the full graph chart ideals after arbitrary coefficient
extension. No radical or rational-point replacement is used. -/
theorem graphCriticalIdeal_eq_map [Infinite K] {R : Type*} [CommRing R]
    (A : Matrix (Cell n) J K) (p : Cell n)
    (φ : MvPolynomial (ChartVar p) K →+* R) :
    GraphQuotientElimination.graphCriticalIdeal
      (fun q j => φ (slicePivotCoefficient A p q j))
      (fun j => φ (chartSubstitution p (segreForm A j)))=
        (ProjectivePointSpan.chartCriticalIdeal A p).map φ := by
  rw [ProjectivePointSpan.chartCriticalIdeal_eq_pivot_span,Ideal.map_span]
  simp only [GraphQuotientElimination.graphCriticalIdeal,
    ← Set.range_comp,Function.comp_def]
  exact congrArg Ideal.span (congrArg Set.range (funext (graphEquation_map A p φ)))

/-- The literal full critical quotient on a slice open is isomorphic to the
localized literal graph quotient. The sole extra datum is that the selected
slice is a unit, exactly the defining condition of that open. -/
def literalFullGraphQuotientEquiv [Infinite K] {R : Type*} [CommRing R]
    (A : Matrix (Cell n) J K) (p : Cell n)
    (φ : MvPolynomial (ChartVar p) K →+* R) (j₀ : J) (u : Rˣ)
    (hu : (u : R)=φ (chartSubstitution p (segreForm A j₀))) :
    (MvPolynomial (LastFree j₀) R ⧸
      GraphQuotientElimination.fullCriticalIdeal
        (fun q j => φ (slicePivotCoefficient A p q j))
        (fun j => φ (chartSubstitution p (segreForm A j))) j₀) ≃ₐ[R]
      (R ⧸ (ProjectivePointSpan.chartCriticalIdeal A p).map φ) :=
  (fullGraphQuotientEquiv
    (fun q j => φ (slicePivotCoefficient A p q j))
    (fun j => φ (chartSubstitution p (segreForm A j))) j₀ u hu).trans
    (Ideal.quotientEquivAlgOfEq R (graphCriticalIdeal_eq_map A p φ))

/-- The complete full critical coordinate ring on the smaller-factor chart
and one normalized last-factor chart, before any localization or reduction. -/
abbrev FullChartRing (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) :=
  MvPolynomial (LastFree j₀) (MvPolynomial (ChartVar p) K) ⧸
    GraphQuotientElimination.fullCriticalIdeal (slicePivotCoefficient A p)
      (fun j => chartSubstitution p (segreForm A j)) j₀

theorem graphCriticalIdeal_eq_literal [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) :
    GraphQuotientElimination.graphCriticalIdeal (slicePivotCoefficient A p)
      (fun j => chartSubstitution p (segreForm A j))=
        ProjectivePointSpan.chartCriticalIdeal A p := by
  simpa only [RingHom.id_apply,Ideal.map_id] using
    graphCriticalIdeal_eq_map A p (RingHom.id _)

/-- Reducedness of all genuine full last-factor charts descends to this
literal graph chart, using the proved slice cover and quotient equivalences. -/
theorem graphChart_reduced_of_full_charts [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n)
    (hbase : Ideal.span (Set.range fun j => chartSubstitution p (segreForm A j))=⊤)
    (hred : ∀ j,IsReduced (FullChartRing A p j)) :
    IsReduced (MvPolynomial (ChartVar p) K ⧸ ProjectivePointSpan.chartCriticalIdeal A p) := by
  rw [← graphCriticalIdeal_eq_literal A p]
  exact ReducedSliceCover.graphCriticalQuotient_isReduced_of_full_charts
    (slicePivotCoefficient A p) (fun j => chartSubstitution p (segreForm A j)) hbase hred

/-- Finiteness over the original coefficient field descends through the
same complete cover, with no finite-instance or point-counting replacement. -/
theorem graphChart_finite_of_full_charts [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n)
    (hbase : Ideal.span (Set.range fun j => chartSubstitution p (segreForm A j))=⊤)
    (hfin : ∀ j,Module.Finite K (FullChartRing A p j)) :
    Module.Finite K
      (MvPolynomial (ChartVar p) K ⧸ ProjectivePointSpan.chartCriticalIdeal A p) := by
  rw [← graphCriticalIdeal_eq_literal A p]
  exact ReducedSliceCover.graphCriticalQuotient_finite_of_full_charts
    (slicePivotCoefficient A p) (fun j => chartSubstitution p (segreForm A j)) hbase hfin

end PaperVerification.Segre.GraphCriticalElimination

end SegreGraphCriticalElimination

section SegreFullGraphChartReindex

/-!
# The complete normalized incidence chart is the full graph chart

The final tensor factor is retained as an actual factor. Its free coordinates
are separated from those of the smaller factors by an explicit polynomial
algebra equivalence. Every full incidence equation becomes the corresponding
literal small-factor or last-factor equation. Thus the complete quotient rings,
including possible nilpotents, are isomorphic before any slice localization.

-/

set_option autoImplicit false
open scoped Classical BigOperators

namespace PaperVerification.Segre.FullGraphChartReindex

open Staircase Monomials Degeneration GraphSpan CriticalGraph SingularSpan ProjectiveCharts
open ProjectivePointSpan GraphQuotientElimination GraphCriticalElimination
open CriticalChartReindex MvPolynomial

variable {I J K : Type} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- All original factors, with the final factor placed at `none`. -/
abbrev FullFactor (n : I → ℕ) (J : Type) : Option I → Type
  | none => J
  | some i => Fin (n i+1)

instance (i : Option I) : Fintype (FullFactor n J i) := by
  cases i <;> dsimp [FullFactor] <;> infer_instance

def fullVector (x : Variables n → K) (y : J → K) :
    ∀ i : Option I,FullFactor n J i → K
  | none => y
  | some i => fun a => x ⟨i,a⟩

def originalCellEquiv : (∀ i : Option I,FullFactor n J i) ≃ Cell n × J :=
  Equiv.piOptionEquivProd.trans (Equiv.prodComm _ _)

def originalTensor (A : Matrix (Cell n) J K) :
    (∀ i : Option I,FullFactor n J i) → K :=
  fun v => A (fun i => v (some i)) (v none)

@[simp] theorem originalCellEquiv_symm_none (v : Cell n) (j : J) :
    (originalCellEquiv (n := n) (J := J)).symm (v,j) none = j := rfl

@[simp] theorem originalCellEquiv_symm_some (v : Cell n) (j : J) (i : I) :
    (originalCellEquiv (n := n) (J := J)).symm (v,j) (some i) = v i := rfl

@[simp] theorem originalTensor_originalCellEquiv_symm
    (A : Matrix (Cell n) J K) (v : Cell n) (j : J) :
    originalTensor A ((originalCellEquiv (n := n) (J := J)).symm (v,j)) = A v j := rfl

theorem prod_erase_option_none (f : Option I → K) :
    (∏ o ∈ Finset.univ.erase none,f o)=∏ i,f (some i) := by
  have he : (Finset.univ : Finset (Option I)).erase none=
      Finset.univ.filter (fun o => o≠none) := by ext o; simp
  rw [he,Finset.prod_filter,Fintype.prod_option]
  simp

theorem prod_erase_option_some (f : Option I → K) (i : I) :
    (∏ o ∈ Finset.univ.erase (some i),f o)=
      f none*(∏ j ∈ Finset.univ.erase i,f (some j)) := by
  have he (a : Option I) : (Finset.univ : Finset (Option I)).erase a=
      Finset.univ.filter (fun o => o≠a) := by ext o; simp
  have hi : (Finset.univ : Finset I).erase i=
      Finset.univ.filter (fun j => j≠i) := by ext j; simp
  rw [he,Finset.prod_filter,Fintype.prod_option,hi,Finset.prod_filter]
  simp

theorem otherProduct_none (x : Variables n → K) (y : J → K)
    (v : Cell n) (j : J) :
    TangentKernel.otherProduct (fullVector x y) none
      ((originalCellEquiv (n := n) (J := J)).symm (v,j))=
        ∏ i,x ⟨i,v i⟩ := by
  unfold TangentKernel.otherProduct
  rw [prod_erase_option_none]
  rfl

theorem otherProduct_some (x : Variables n → K) (y : J → K)
    (v : Cell n) (j : J) (i : I) :
    TangentKernel.otherProduct (fullVector x y) (some i)
      ((originalCellEquiv (n := n) (J := J)).symm (v,j))=
        y j*(∏ h ∈ Finset.univ.erase i,x ⟨h,v h⟩) := by
  unfold TangentKernel.otherProduct
  rw [prod_erase_option_some]
  rfl

theorem contraction_none (A : Matrix (Cell n) J K)
    (x : Variables n → K) (y : J → K) (j : J) :
    TangentKernel.contraction (fullVector x y) (originalTensor A) none j=
      lastContraction A x j := by
  classical
  letI : DecidableEq J := Classical.decEq J
  unfold TangentKernel.contraction
  rw [← Equiv.sum_comp (originalCellEquiv (n := n) (J := J)).symm,
    Fintype.sum_prod_type]
  simp only [originalCellEquiv_symm_none, originalTensor_originalCellEquiv_symm,
    otherProduct_none, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  rw [lastContraction,eval_segreForm]
  simp only [eval_cell_eq_prod]

theorem contraction_some (A : Matrix (Cell n) J K)
    (x : Variables n → K) (y : J → K) (i : I) (a : Fin (n i+1)) :
    TangentKernel.contraction (fullVector x y) (originalTensor A) (some i) a=
      factorContraction A x y i a := by
  classical
  letI : DecidableEq (Fin (n i+1)) := Classical.decEq _
  unfold TangentKernel.contraction
  rw [← Equiv.sum_comp (originalCellEquiv (n := n) (J := J)).symm,
    Fintype.sum_prod_type]
  simp only [originalCellEquiv_symm_some, originalTensor_originalCellEquiv_symm,
    otherProduct_some]
  rw [← Equiv.sum_comp (Equiv.piSplitAt i (fun h => Fin (n h+1))).symm,
    Fintype.sum_prod_type]
  have hsplit (b : Fin (n i+1)) (w : OtherCell n i) :
      (Equiv.piSplitAt i (fun h => Fin (n h+1))).symm (b,w) =
        assemble i b w := rfl
  simp only [hsplit, assemble_same]
  have hp (b : Fin (n i+1)) (w : OtherCell n i) :
      (∏ h ∈ Finset.univ.erase i,x ⟨h,assemble i b w h⟩)=
        CriticalGraph.otherProduct x i w := by
    rw [Finset.prod_subtype (p := fun h : I => h≠i) (F := inferInstance)
      (Finset.univ.erase i) (by simp)]
    simp only [assemble_other,CriticalGraph.otherProduct]
  simp only [hp,Finset.sum_ite_irrel,Finset.sum_const_zero,
    Finset.sum_ite_eq',Finset.mem_univ,ite_true]
  simp only [factorContraction,mul_assoc]

/-- The actual free coordinates in every full tensor factor. -/
abbrev FullFree (p : Cell n) (j₀ : J) : Option I → Type
  | none => LastFree j₀
  | some i => FreeFactor p i

instance (p : Cell n) (j₀ : J) (i : Option I) : Fintype (FullFree p j₀ i) := by
  cases i <;> dsimp [FullFree] <;> infer_instance

def fullFactorEquiv (p : Cell n) (j₀ : J) :
    ∀ i : Option I,Option (FullFree p j₀ i) ≃ FullFactor n J i
  | none => Equiv.optionSubtypeNe j₀
  | some i => Equiv.optionSubtypeNe (p i)

def fullCellEquiv (p : Cell n) (j₀ : J) :
    CriticalChart.TensorCell (σ := FullFree p j₀) ≃ Cell n × J :=
  (Equiv.piCongrRight (fullFactorEquiv p j₀)).trans originalCellEquiv

def fullTensor (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) :
    CriticalChart.TensorCell (σ := FullFree p j₀) → K :=
  fun v => A (fullCellEquiv p j₀ v).1 (fullCellEquiv p j₀ v).2

def fullVariableEquiv (p : Cell n) (j₀ : J) :
    CriticalChart.Coordinate (σ := FullFree p j₀) ≃ LastFree j₀ ⊕ ChartVar p where
  toFun q := match q with
    | ⟨none,j⟩ => Sum.inl j
    | ⟨some i,a⟩ => Sum.inr ⟨⟨i,a.val⟩,a.property⟩
  invFun q := match q with
    | Sum.inl j => ⟨none,j⟩
    | Sum.inr q => ⟨some q.val.1,⟨q.val.2,q.property⟩⟩
  left_inv q := by rcases q with ⟨o,a⟩; cases o <;> rfl
  right_inv q := by cases q <;> rfl

/-- The exact affine coordinate algebra, separated into final and smaller variables. -/
def fullRingEquiv (p : Cell n) (j₀ : J) :
    MvPolynomial (CriticalChart.Coordinate (σ := FullFree p j₀)) K ≃ₐ[K]
      MvPolynomial (LastFree j₀) (MvPolynomial (ChartVar p) K) :=
  (MvPolynomial.renameEquiv K (fullVariableEquiv p j₀)).trans
    (MvPolynomial.sumAlgEquiv K _ _)

def fullPointCoordinates (p : Cell n) (j₀ : J)
    (z : ChartVar p → K) (w : LastFree j₀ → K) :
    CriticalChart.Coordinate (σ := FullFree p j₀) → K :=
  fun q => Sum.elim w z (fullVariableEquiv p j₀ q)

theorem eval_fullRingEquiv (p : Cell n) (j₀ : J)
    (z : ChartVar p → K) (w : LastFree j₀ → K)
    (f : MvPolynomial (CriticalChart.Coordinate (σ := FullFree p j₀)) K) :
    (eval₂Hom (eval z) w) (fullRingEquiv p j₀ f)=
      eval (fullPointCoordinates p j₀ z w) f := by
  have h : (eval₂Hom (eval z) w).comp (fullRingEquiv p j₀).toRingHom=
      eval (fullPointCoordinates p j₀ z w) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [fullRingEquiv]
    · rintro ⟨o,a⟩
      cases o <;> simp [fullRingEquiv,fullVariableEquiv,fullPointCoordinates]
  exact RingHom.congr_fun h f

theorem nested_funext [Infinite K]
    {α β : Type} (f g : MvPolynomial α (MvPolynomial β K))
    (h : ∀ (z : β → K) (w : α → K),
      (eval₂Hom (eval z) w) f=(eval₂Hom (eval z) w) g) : f=g := by
  let e := MvPolynomial.sumAlgEquiv K α β
  have he (z : β → K) (w : α → K) :
      (eval₂Hom (eval z) w).comp e.toRingHom=eval (Sum.elim w z) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [e]
    · intro q
      cases q <;> simp [e]
  apply e.symm.injective
  apply MvPolynomial.funext
  intro v
  let z : β → K := fun b => v (Sum.inr b)
  let w : α → K := fun a => v (Sum.inl a)
  have hv : Sum.elim w z=v := by funext q; cases q <;> rfl
  have hf := RingHom.congr_fun (he z w) (e.symm f)
  have hg := RingHom.congr_fun (he z w) (e.symm g)
  change (eval₂Hom (eval z) w) (e (e.symm f)) =
    eval (Sum.elim w z) (e.symm f) at hf
  change (eval₂Hom (eval z) w) (e (e.symm g)) =
    eval (Sum.elim w z) (e.symm g) at hg
  rw [e.apply_symm_apply, hv] at hf hg
  exact hf.symm.trans ((h z w).trans hg)

theorem pointVector_reindex (p : Cell n) (j₀ : J)
    (z : ChartVar p → K) (w : LastFree j₀ → K) :
    CriticalChart.pointVector (fullPointCoordinates p j₀ z w)=
      (fun i a => fullVector (ProjectiveCharts.chartVector p z)
        (normalizedLastVector j₀ w) i (fullFactorEquiv p j₀ i a)) := by
  funext o a
  cases o with
  | none =>
      cases a with
      | none => simp [CriticalChart.pointVector,fullVector,fullFactorEquiv]
      | some a =>
          simp [CriticalChart.pointVector,fullVector,fullFactorEquiv,
            fullPointCoordinates,fullVariableEquiv,normalizedLastVector,a.property]
  | some i =>
      cases a with
      | none => simp [CriticalChart.pointVector,fullVector,fullFactorEquiv]
      | some a =>
          simp [CriticalChart.pointVector,fullVector,fullFactorEquiv,
            fullPointCoordinates,fullVariableEquiv,ProjectiveCharts.chartVector,a.property]

theorem fullTensor_eq_reindex (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) :
    fullTensor A p j₀=
      (fun v => originalTensor A (Equiv.piCongrRight (fullFactorEquiv p j₀) v)) := rfl

/-- The final-factor equation is preserved as an actual polynomial identity. -/
theorem fullRingEquiv_criticalEquation_none [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) (j : LastFree j₀) :
    fullRingEquiv p j₀ (CriticalChart.criticalEquation (fullTensor A p j₀) ⟨none,j⟩)=
      C (chartSubstitution p (segreForm A j.val))-
        C (chartSubstitution p (segreForm A j₀))*X j := by
  apply nested_funext
  intro z w
  rw [eval_fullRingEquiv,CriticalChart.eval_criticalEquation,pointVector_reindex,
    fullTensor_eq_reindex,contraction_piCongr,contraction_piCongr]
  simp only [fullFactorEquiv,Equiv.optionSubtypeNe_some,Equiv.optionSubtypeNe_none,
    contraction_none,fullPointCoordinates,fullVariableEquiv,Sum.elim_inl]
  rw [eval₂_fullLastEquation,lastCriticalOperator_rankOne]
  simp only [normalizedLastVector_pivot,normalizedLastVector_free,mul_one]
  change lastContraction A (chartVector p z) j.val -
      w j * lastContraction A (chartVector p z) j₀ =
    lastContraction A (chartVector p z) j.val -
      lastContraction A (chartVector p z) j₀ * w j
  ring

/-- Each smaller-factor equation is preserved with its complete last-factor dependence. -/
theorem fullRingEquiv_criticalEquation_some [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) (q : ChartVar p) :
    fullRingEquiv p j₀
      (CriticalChart.criticalEquation (fullTensor A p j₀)
        ⟨some q.val.1,⟨q.val.2,q.property⟩⟩)=
      fullSmallEquation (slicePivotCoefficient A p) j₀ q := by
  apply nested_funext
  intro z w
  rw [eval_fullRingEquiv,CriticalChart.eval_criticalEquation,pointVector_reindex,
    fullTensor_eq_reindex,contraction_piCongr,contraction_piCongr]
  simp only [fullFactorEquiv,Equiv.optionSubtypeNe_some,Equiv.optionSubtypeNe_none,
    contraction_some,fullPointCoordinates,fullVariableEquiv,Sum.elim_inr]
  change _=(eval₂Hom (eval z) w)
    (fullSmallEquation (sliceCriticalCoefficient A p) j₀
      ⟨q.val.1,(q.val.2,p q.val.1)⟩)
  rw [eval₂_fullSmallEquation,criticalOperator_rankOne,chartVector_pivot]
  simp [ProjectiveCharts.chartVector,q.property]

/-- Equality of the whole defining ideals, without replacing either by its radical. -/
theorem map_criticalIdeal [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) :
    (Ideal.span (Set.range (CriticalChart.criticalEquation (fullTensor A p j₀)))).map
      (fullRingEquiv p j₀).toRingHom=
      GraphQuotientElimination.fullCriticalIdeal (slicePivotCoefficient A p)
        (fun j => chartSubstitution p (segreForm A j)) j₀ := by
  rw [Ideal.map_span,← Set.range_comp]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨⟨o,a⟩,rfl⟩
    change fullRingEquiv p j₀
      (CriticalChart.criticalEquation (fullTensor A p j₀) ⟨o,a⟩)∈_
    cases o with
    | none =>
        rw [fullRingEquiv_criticalEquation_none]
        exact Ideal.mem_sup_left (Ideal.subset_span ⟨a,rfl⟩)
    | some i =>
        rw [fullRingEquiv_criticalEquation_some A p j₀ ⟨⟨i,a.val⟩,a.property⟩]
        exact Ideal.mem_sup_right (Ideal.subset_span ⟨⟨⟨i,a.val⟩,a.property⟩,rfl⟩)
  · apply sup_le
    · apply Ideal.span_le.mpr
      rintro _ ⟨j,rfl⟩
      exact Ideal.subset_span ⟨⟨none,j⟩,
        by simpa using fullRingEquiv_criticalEquation_none A p j₀ j⟩
    · apply Ideal.span_le.mpr
      rintro _ ⟨q,rfl⟩
      exact Ideal.subset_span ⟨⟨some q.val.1,⟨q.val.2,q.property⟩⟩,
        by simpa using fullRingEquiv_criticalEquation_some A p j₀ q⟩

/-- The exact quotient comparison needed to transfer generic reducedness and finiteness. -/
def fullChartQuotientEquiv [Infinite K]
    (A : Matrix (Cell n) J K) (p : Cell n) (j₀ : J) :
    (MvPolynomial (CriticalChart.Coordinate (σ := FullFree p j₀)) K ⧸
      Ideal.span (Set.range (CriticalChart.criticalEquation (fullTensor A p j₀)))) ≃ₐ[K]
        FullChartRing A p j₀ :=
  Ideal.quotientEquivAlg _ _ (fullRingEquiv p j₀) (map_criticalIdeal A p j₀).symm

