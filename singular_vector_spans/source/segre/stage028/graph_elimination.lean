section SegreGraphQuotientElimination

/-!
# Exact quotient elimination for the graph charts

Eliminating normalized last-factor coordinates is an isomorphism of complete
coordinate rings. For every coefficient ring, every tuple c, and every family
of additional equations h, this file constructs

  R[Y] / (Y-c,h) ≃ₐ[R] R / (h(c)).

The polynomial identities and both inverse homomorphisms are proved. Thus this
comparison transfers reducedness, rather than only matching rational points.
It applies to singular-vector graph charts after making one slice a unit.

-/

set_option autoImplicit false

namespace PaperVerification.Segre.GraphQuotientElimination

open MvPolynomial
open scoped BigOperators

variable {R ι κ : Type*} [CommRing R]

/-- The actual equations that prescribe all eliminated coordinates. -/
def coordinateIdeal (c : ι → R) : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range fun i => X i-C (c i))

/-- Substitution differs from the original polynomial by an element of the
actual coordinate ideal, proved by polynomial induction. -/
theorem sub_C_eval_mem (c : ι → R) (f : MvPolynomial ι R) :
    f-C (eval c f) ∈ coordinateIdeal c := by
  induction f using MvPolynomial.induction_on with
  | C r => simp only [eval_C,sub_self]; exact Ideal.zero_mem _
  | add f g hf hg =>
      convert (coordinateIdeal c).add_mem hf hg using 1 <;> simp only [map_add] <;> ring
  | mul_X f i hf =>
      have hi : X i-C (c i) ∈ coordinateIdeal c := Ideal.subset_span ⟨i,rfl⟩
      convert (coordinateIdeal c).add_mem
        ((coordinateIdeal c).mul_mem_left (X i) hf)
        ((coordinateIdeal c).mul_mem_left (C (eval c f)) hi) using 1
      simp only [map_mul,eval_X]
      ring

def eliminationIdeal (c : ι → R) (h : κ → MvPolynomial ι R) :
    Ideal (MvPolynomial ι R) := coordinateIdeal c ⊔ Ideal.span (Set.range h)

def evaluatedIdeal (c : ι → R) (h : κ → MvPolynomial ι R) : Ideal R :=
  Ideal.span (Set.range fun s => eval c (h s))

/-- The complete eliminated ideal maps into the evaluated ideal. -/
theorem eliminationIdeal_le_kernel (c : ι → R) (h : κ → MvPolynomial ι R) :
    eliminationIdeal c h ≤ RingHom.ker
      ((Ideal.Quotient.mk (evaluatedIdeal c h)).comp (eval c)) := by
  apply sup_le
  · apply Ideal.span_le.mpr
    rintro f ⟨i,rfl⟩
    change Ideal.Quotient.mk (evaluatedIdeal c h) (eval c (X i-C (c i)))=0
    simp
  · apply Ideal.span_le.mpr
    rintro f ⟨s,rfl⟩
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨s,rfl⟩)

/-- Every evaluated relation also vanishes in the original eliminated quotient. -/
theorem evaluatedIdeal_le_comap (c : ι → R) (h : κ → MvPolynomial ι R) :
    evaluatedIdeal c h ≤ (eliminationIdeal c h).comap C := by
  apply Ideal.span_le.mpr
  rintro r ⟨s,rfl⟩
  change C (eval c (h s)) ∈ eliminationIdeal c h
  have hh : h s ∈ eliminationIdeal c h :=
    Ideal.mem_sup_right (Ideal.subset_span ⟨s,rfl⟩)
  have hc : h s-C (eval c (h s)) ∈ eliminationIdeal c h :=
    Ideal.mem_sup_left (sub_C_eval_mem c (h s))
  convert (eliminationIdeal c h).sub_mem hh hc using 1 <;> ring

/-- The forward map is literal evaluation followed by the evaluated quotient. -/
def evaluateQuotient (c : ι → R) (h : κ → MvPolynomial ι R) :
    MvPolynomial ι R ⧸ eliminationIdeal c h →ₐ[R] R ⧸ evaluatedIdeal c h :=
  Ideal.Quotient.liftₐ (eliminationIdeal c h)
    ((Ideal.Quotient.mkₐ R (evaluatedIdeal c h)).comp (aeval c))
    (fun f hf => eliminationIdeal_le_kernel c h hf)

@[simp] theorem evaluateQuotient_mk (c : ι → R) (h : κ → MvPolynomial ι R)
    (f : MvPolynomial ι R) :
    evaluateQuotient c h (Ideal.Quotient.mk (eliminationIdeal c h) f)=
      Ideal.Quotient.mk (evaluatedIdeal c h) (eval c f) := rfl

/-- The inverse sends the coefficient quotient into constant polynomials. -/
def includeQuotient (c : ι → R) (h : κ → MvPolynomial ι R) :
    R ⧸ evaluatedIdeal c h →ₐ[R] MvPolynomial ι R ⧸ eliminationIdeal c h :=
  Ideal.Quotient.liftₐ (evaluatedIdeal c h)
    (Algebra.ofId R (MvPolynomial ι R ⧸ eliminationIdeal c h))
    (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (evaluatedIdeal_le_comap c h hr))

@[simp] theorem includeQuotient_mk (c : ι → R) (h : κ → MvPolynomial ι R) (r : R) :
    includeQuotient c h (Ideal.Quotient.mk (evaluatedIdeal c h) r)=
      Ideal.Quotient.mk (eliminationIdeal c h) (C r) := rfl

theorem include_evaluate (c : ι → R) (h : κ → MvPolynomial ι R)
    (x : MvPolynomial ι R ⧸ eliminationIdeal c h) :
    includeQuotient c h (evaluateQuotient c h x)=x := by
  obtain ⟨f,rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [evaluateQuotient_mk,includeQuotient_mk]
  symm
  apply sub_eq_zero.mp
  rw [← map_sub]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Ideal.mem_sup_left (sub_C_eval_mem c f)

theorem evaluate_include (c : ι → R) (h : κ → MvPolynomial ι R)
    (x : R ⧸ evaluatedIdeal c h) :
    evaluateQuotient c h (includeQuotient c h x)=x := by
  obtain ⟨r,rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [includeQuotient_mk,evaluateQuotient_mk,eval_C]

/-- Exact elimination of all prescribed coordinates, including every
additional equation and every nilpotent of either quotient. -/
def eliminationEquiv (c : ι → R) (h : κ → MvPolynomial ι R) :
    (MvPolynomial ι R ⧸ eliminationIdeal c h) ≃ₐ[R] (R ⧸ evaluatedIdeal c h) where
  __ := evaluateQuotient c h
  invFun := includeQuotient c h
  left_inv := include_evaluate c h
  right_inv := evaluate_include c h

@[simp] theorem eliminationEquiv_mk (c : ι → R) (h : κ → MvPolynomial ι R)
    (f : MvPolynomial ι R) :
    eliminationEquiv c h (Ideal.Quotient.mk (eliminationIdeal c h) f)=
      Ideal.Quotient.mk (evaluatedIdeal c h) (eval c f) := rfl

/-- Reducedness transfers through the literal coordinate-ring equivalence. -/
theorem evaluatedQuotient_isReduced (c : ι → R) (h : κ → MvPolynomial ι R)
    [IsReduced (MvPolynomial ι R ⧸ eliminationIdeal c h)] :
    IsReduced (R ⧸ evaluatedIdeal c h) :=
  isReduced_of_injective (eliminationEquiv c h).symm
    (eliminationEquiv c h).symm.injective

/-- Multiplying a complete family of generators by one unit preserves its ideal. -/
theorem span_range_unit_mul (u : Rˣ) (f : κ → R) :
    Ideal.span (Set.range fun s => (u : R)*f s)=Ideal.span (Set.range f) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨s,rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨s,rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨s,rfl⟩
    have h : (u : R)*f s ∈ Ideal.span (Set.range fun t => (u : R)*f t) :=
      Ideal.subset_span ⟨s,rfl⟩
    change f s ∈ Ideal.span (Set.range fun t => (u : R)*f t)
    simpa only [← mul_assoc,Units.inv_mul,mul_one,one_mul] using
      (Ideal.span (Set.range fun t => (u : R)*f t)).mul_mem_left (↑u⁻¹ : R) h

/-- Once the chosen slice is a unit, the literal last-mode equations
are exactly the normalized coordinate equations, as ideals. -/
theorem span_last_equations (u : Rˣ) (b : ι → R) :
    Ideal.span (Set.range fun i => C (b i)-C (u : R)*X i)=
      coordinateIdeal (fun i => (↑u⁻¹ : R)*b i) := by
  have hu : IsUnit (-(C (u : R) : MvPolynomial ι R)) := (u.isUnit.map C).neg
  let v : (MvPolynomial ι R)ˣ := hu.unit
  have hv : (v : MvPolynomial ι R) = -C (u : R) := hu.unit_spec
  have he : (fun i => C (b i)-C (u : R)*X i)=
      (fun i => (v : MvPolynomial ι R)*(X i-C ((↑u⁻¹ : R)*b i))) := by
    funext i
    rw [hv,map_mul]
    have hc : C (u : R)*C (↑u⁻¹ : R)=(1 : MvPolynomial ι R) := by
      rw [← map_mul,Units.mul_inv,map_one]
    calc
      C (b i)-C (u : R)*X i =
          -(C (u : R))*X i+
            (C (u : R)*C (↑u⁻¹ : R))*C (b i) := by
        rw [hc,one_mul]
        ring
      _ = -(C (u : R))*(X i-C (↑u⁻¹ : R)*C (b i)) := by ring
  rw [he,span_range_unit_mul]
  rfl

section LastFactor

variable {J Q : Type*} [Fintype J] [DecidableEq J]

abbrev LastFree (j₀ : J) := {j : J // j≠j₀}

def lastCoordinate (j₀ j : J) : MvPolynomial (LastFree j₀) R :=
  if h : j=j₀ then 1 else X ⟨j,h⟩

/-- The full small-factor equations are linear in every last-factor coordinate. -/
def fullSmallEquation (d : Q → J → R) (j₀ : J) (q : Q) :
    MvPolynomial (LastFree j₀) R := ∑ j,C (d q j)*lastCoordinate j₀ j

/-- The graph substitutes the complete slice vector for that last factor. -/
def graphEquation (d : Q → J → R) (f : J → R) (q : Q) : R :=
  ∑ j,d q j*f j

def fullCriticalIdeal (d : Q → J → R) (f : J → R) (j₀ : J) :
    Ideal (MvPolynomial (LastFree j₀) R) :=
  Ideal.span (Set.range fun j : LastFree j₀ => C (f j.val)-C (f j₀)*X j) ⊔
    Ideal.span (Set.range (fullSmallEquation d j₀))

def graphCriticalIdeal (d : Q → J → R) (f : J → R) : Ideal R :=
  Ideal.span (Set.range (graphEquation d f))

theorem eval_lastCoordinate (f : J → R) (j₀ : J) (u : Rˣ)
    (hu : (u : R)=f j₀) (j : J) :
    eval (fun j : LastFree j₀ => (↑u⁻¹ : R)*f j.val)
      (lastCoordinate j₀ j)=(↑u⁻¹ : R)*f j := by
  by_cases hj : j=j₀
  · subst j
    simp [lastCoordinate,← hu]
  · simp [lastCoordinate,hj]

/-- Exact substitution of the last-factor equations scales each full small
equation by the inverse of the chosen slice. -/
theorem eval_fullSmallEquation (d : Q → J → R) (f : J → R) (j₀ : J)
    (u : Rˣ) (hu : (u : R)=f j₀) (q : Q) :
    eval (fun j : LastFree j₀ => (↑u⁻¹ : R)*f j.val)
      (fullSmallEquation d j₀ q)=(↑u⁻¹ : R)*graphEquation d f q := by
  simp only [fullSmallEquation,map_sum,map_mul,eval_C,
    eval_lastCoordinate f j₀ u hu,graphEquation,Finset.mul_sum]
  exact Finset.sum_congr rfl (fun _ _ => by ring)

theorem fullCriticalIdeal_eq_elimination (d : Q → J → R) (f : J → R)
    (j₀ : J) (u : Rˣ) (hu : (u : R)=f j₀) :
    fullCriticalIdeal d f j₀=
      eliminationIdeal (fun j : LastFree j₀ => (↑u⁻¹ : R)*f j.val)
        (fullSmallEquation d j₀) := by
  unfold fullCriticalIdeal eliminationIdeal
  rw [← hu,span_last_equations]

theorem evaluatedIdeal_eq_graphCriticalIdeal (d : Q → J → R) (f : J → R)
    (j₀ : J) (u : Rˣ) (hu : (u : R)=f j₀) :
    evaluatedIdeal (fun j : LastFree j₀ => (↑u⁻¹ : R)*f j.val)
      (fullSmallEquation d j₀)=graphCriticalIdeal d f := by
  unfold evaluatedIdeal
  simp only [eval_fullSmallEquation d f j₀ u hu]
  exact span_range_unit_mul u⁻¹ (graphEquation d f)

/-- On the open where the selected slice is invertible, the complete full
critical quotient and the complete graph critical quotient are isomorphic. -/
def fullGraphQuotientEquiv (d : Q → J → R) (f : J → R) (j₀ : J)
    (u : Rˣ) (hu : (u : R)=f j₀) :
    (MvPolynomial (LastFree j₀) R ⧸ fullCriticalIdeal d f j₀) ≃ₐ[R]
      (R ⧸ graphCriticalIdeal d f) :=
  (Ideal.quotientEquivAlgOfEq R (fullCriticalIdeal_eq_elimination d f j₀ u hu)).trans
    ((eliminationEquiv (fun j : LastFree j₀ => (↑u⁻¹ : R)*f j.val)
      (fullSmallEquation d j₀)).trans
        (Ideal.quotientEquivAlgOfEq R (evaluatedIdeal_eq_graphCriticalIdeal d f j₀ u hu)))

theorem graphCriticalQuotient_isReduced (d : Q → J → R) (f : J → R)
    (j₀ : J) (u : Rˣ) (hu : (u : R)=f j₀)
    [IsReduced (MvPolynomial (LastFree j₀) R ⧸ fullCriticalIdeal d f j₀)] :
    IsReduced (R ⧸ graphCriticalIdeal d f) :=
  isReduced_of_injective (fullGraphQuotientEquiv d f j₀ u hu).symm
    (fullGraphQuotientEquiv d f j₀ u hu).symm.injective

end LastFactor

end PaperVerification.Segre.GraphQuotientElimination

