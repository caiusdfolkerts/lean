/-!
# The integral `(2,5)` Segre multiplication table

Every column below is derived from the literal two-by-two minors and rank sums.
The coefficient map has an explicit integral inverse, valid over every
commutative coefficient ring. Source and target orders agree with printed page 8.
-/

@[expose] public section
set_option autoImplicit false
open scoped BigOperators
namespace PaperVerification.Segre.TwoFactor25
variable {R : Type*} [CommRing R]

structure Relations (x : Fin 3 → Fin 6 → R) : Prop where
  minor : ∀ i k j l, x i j * x k l = x i l * x k j
  s0 : x 0 0 = 0
  s1 : x 0 1 + x 1 0 = 0
  s2 : x 0 2 + x 1 1 + x 2 0 = 0
  s3 : x 0 3 + x 1 2 + x 2 1 = 0
  s4 : x 0 4 + x 1 3 + x 2 2 = 0
  s5 : x 0 5 + x 1 4 + x 2 3 = 0
  s6 : x 1 5 + x 2 4 = 0
  s7 : x 2 5 = 0

def source {A : Type*} (x : Fin 3 → Fin 6 → A) : Fin 10 → A :=
  ![x 0 1, x 0 2, x 0 3, x 0 4, x 0 5, x 1 1, x 1 2, x 1 3, x 1 4, x 1 5]

def target {A : Type*} [Mul A] (x : Fin 3 → Fin 6 → A) : Fin 10 → A :=
  ![x 0 1 * x 1 2, x 0 1 * x 1 3, x 0 1 * x 1 4, x 0 1 * x 1 5, x 0 2 * x 1 3, x 0 2 * x 1 4, x 0 2 * x 1 5, x 0 3 * x 1 4, x 0 3 * x 1 5, x 0 4 * x 1 5]

def lefschetz (x : Fin 3 → Fin 6 → R) : R := x 0 2 - x 0 5 - x 1 3

theorem column_0 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 0 1 = (-1) * (x 0 1 * x 1 3) := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 0 2) + (-1) * ((h.minor 0 1 0 5)) + (-1) * ((x 1 2) * h.s0) + (x 1 5) * h.s0 + (x 0 2) * h.s1 + (-1) * ((x 0 5) * h.s1)

theorem column_1 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 0 2 = (-1) * (x 0 1 * x 1 2) + x 0 1 * x 1 5 + (-1) * (x 0 2 * x 1 3) := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 1 2) + (-1) * ((h.minor 0 1 1 5)) + (h.minor 0 2 0 2) + (-1) * ((h.minor 0 2 0 5)) + (-1) * ((x 2 2) * h.s0) + (x 2 5) * h.s0 + (x 0 2) * h.s2 + (-1) * ((x 0 5) * h.s2)

theorem column_2 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 0 3 = (-1) * (x 0 1 * x 1 3) + (2) * (x 0 1 * x 1 5) + (-2) * (x 0 2 * x 1 4) + x 0 2 * x 1 5 := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 1 3) + (-1) * ((h.minor 0 1 1 5)) + (h.minor 0 1 2 4) + (-1) * ((h.minor 0 1 2 5)) + (h.minor 0 2 0 3) + (-1) * ((h.minor 0 2 0 5)) + (h.minor 0 2 1 4) + (-1) * ((h.minor 0 2 1 5)) + (-1) * ((h.minor 0 2 2 3)) + (-1) * ((x 2 3) * h.s0) + (x 2 5) * h.s0 + (x 0 3) * h.s2 + (-1) * ((x 0 5) * h.s2) + (x 0 4) * h.s3 + (-1) * ((x 0 5) * h.s3) + (-1) * ((x 0 3) * h.s4) + (x 0 2) * h.s5 + (-1) * ((x 0 1) * h.s6) + (x 0 1) * h.s7

theorem column_3 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 0 4 = (-1) * (x 0 1 * x 1 4) + (-1) * (x 0 3 * x 1 4) + x 0 3 * x 1 5 := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 1 4) + (h.minor 0 1 3 4) + (-1) * ((h.minor 0 1 3 5)) + (h.minor 0 2 0 4) + (-1) * ((h.minor 0 2 2 5)) + (-1) * ((x 2 4) * h.s0) + (x 0 4) * h.s2 + (-1) * ((x 0 5) * h.s4) + (x 0 2) * h.s7

theorem column_4 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 0 5 = (-1) * (x 0 1 * x 1 5) + (-1) * (x 0 3 * x 1 5) + x 0 4 * x 1 5 := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 1 5) + (h.minor 0 1 3 5) + (-1) * ((h.minor 0 1 4 5)) + (h.minor 0 2 0 5) + (-1) * ((h.minor 0 2 3 5)) + (-1) * ((x 2 5) * h.s0) + (x 0 5) * h.s2 + (-1) * ((x 0 5) * h.s5) + (x 0 3) * h.s7

theorem column_5 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 1 1 = x 0 1 * x 1 2 + x 0 1 * x 1 4 + (-1) * (x 0 1 * x 1 5) + x 0 2 * x 1 3 := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 0 5) + (-1) * ((h.minor 0 1 1 2)) + (h.minor 0 1 1 5) + (-1) * ((h.minor 1 2 0 3)) + (-1) * ((x 1 5) * h.s0) + (x 0 5) * h.s1 + (x 2 3) * h.s1 + (-1) * ((x 1 3) * h.s2) + (-1) * ((x 0 1) * h.s5)

theorem column_6 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 1 2 = (2) * (x 0 1 * x 1 3) + (-2) * (x 0 1 * x 1 5) + (3) * (x 0 2 * x 1 4) + (-1) * (x 0 2 * x 1 5) := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 0 4) + (-1) * ((h.minor 0 1 1 3)) + (2) * ((h.minor 0 1 1 5)) + (-1) * ((h.minor 0 1 2 4)) + (h.minor 0 1 2 5) + (-1) * ((h.minor 0 2 0 3)) + (h.minor 0 2 0 5) + (h.minor 0 2 1 2) + (-1) * ((h.minor 0 2 1 4)) + (h.minor 0 2 2 3) + (-1) * ((h.minor 1 2 0 4)) + (-1) * ((h.minor 1 2 1 3)) + (-1) * ((x 1 4) * h.s0) + (x 2 3) * h.s0 + (-1) * ((x 2 5) * h.s0) + (x 0 4) * h.s1 + (x 2 4) * h.s1 + (-1) * ((x 0 3) * h.s2) + (x 0 5) * h.s2 + (-1) * ((x 1 4) * h.s2) + (x 0 2) * h.s3 + (-1) * ((x 0 4) * h.s3) + (-1) * ((x 1 3) * h.s3) + (-1) * ((x 0 1) * h.s4) + (x 0 3) * h.s4 + (-1) * ((x 0 2) * h.s5) + (x 1 1) * h.s5

theorem column_7 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 1 3 = x 0 2 * x 1 3 + (2) * (x 0 3 * x 1 4) + (-1) * (x 0 3 * x 1 5) := by
  dsimp [lefschetz]
  linear_combination (h.minor 0 1 2 5) + (-1) * ((h.minor 0 1 3 4)) + (h.minor 0 1 3 5) + (-1) * ((h.minor 1 2 0 5)) + (-1) * ((h.minor 1 2 1 4)) + (-1) * ((h.minor 1 2 2 3)) + (x 2 5) * h.s1 + (-1) * ((x 1 5) * h.s2) + (-1) * ((x 1 4) * h.s3) + (-1) * ((x 1 3) * h.s4) + (x 1 2) * h.s5 + (x 1 1) * h.s6 + (-1) * ((x 0 1) * h.s7)

theorem column_8 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 1 4 = x 0 2 * x 1 4 + (3) * (x 0 3 * x 1 5) + (-1) * (x 0 4 * x 1 5) := by
  dsimp [lefschetz]
  linear_combination (-1) * ((h.minor 0 1 3 5)) + (h.minor 0 1 4 5) + (-1) * ((h.minor 0 2 2 5)) + (h.minor 0 2 3 4) + (-1) * ((h.minor 1 2 1 5)) + (-1) * ((h.minor 1 2 2 4)) + (-1) * ((x 1 5) * h.s3) + (-1) * ((x 0 5) * h.s4) + (-1) * ((x 1 4) * h.s4) + (x 0 4) * h.s5 + (-1) * ((x 0 3) * h.s6) + (x 1 2) * h.s6 + (x 0 2) * h.s7 + (x 1 1) * h.s7

theorem column_9 (x : Fin 3 → Fin 6 → R) (h : Relations x) :
    lefschetz x * x 1 5 = x 0 2 * x 1 5 + x 0 4 * x 1 5 := by
  dsimp [lefschetz]
  linear_combination (-1) * ((h.minor 0 2 4 5)) + (-1) * ((h.minor 1 2 2 5)) + (-1) * ((x 1 5) * h.s4) + (-1) * ((x 0 5) * h.s6) + (x 0 4) * h.s7 + (x 1 2) * h.s7

def coefficientMap (a : Fin 10 → R) : Fin 10 → R :=
  ![(-1) * (a 1) + a 5,
    (-1) * (a 0) + (-1) * (a 2) + (2) * (a 6),
    (-1) * (a 3) + a 5,
    a 1 + (2) * (a 2) + (-1) * (a 4) + (-1) * (a 5) + (-2) * (a 6),
    (-1) * (a 1) + a 5 + a 7,
    (-2) * (a 2) + (3) * (a 6) + a 8,
    a 2 + (-1) * (a 6) + a 9,
    (-1) * (a 3) + (2) * (a 7),
    a 3 + (-1) * (a 4) + (-1) * (a 7) + (3) * (a 8),
    a 4 + (-1) * (a 8) + a 9]

def inverseMap (a : Fin 10 → R) : Fin 10 → R :=
  ![a 0 + (-1) * (a 1) + a 3 + a 5 + (-1) * (a 6) + a 9,
    (-3) * (a 0) + a 2 + (2) * (a 4) + (-1) * (a 7),
    (7) * (a 0) + (5) * (a 3) + (-2) * (a 4) + a 5 + (-7) * (a 6) + (2) * (a 7) + (2) * (a 8) + (7) * (a 9),
    (-2) * (a 0) + (2) * (a 4) + (-1) * (a 7),
    (5) * (a 0) + (3) * (a 3) + (-2) * (a 4) + (-6) * (a 6) + (2) * (a 7) + (2) * (a 8) + (6) * (a 9),
    (-2) * (a 0) + a 2 + (2) * (a 4) + (-1) * (a 7),
    (4) * (a 0) + (3) * (a 3) + (-1) * (a 4) + a 5 + (-4) * (a 6) + a 7 + a 8 + (4) * (a 9),
    (-1) * (a 0) + a 4,
    (2) * (a 0) + a 3 + (-1) * (a 4) + (-2) * (a 6) + a 7 + a 8 + (2) * (a 9),
    (-3) * (a 0) + (-2) * (a 3) + a 4 + (4) * (a 6) + (-1) * (a 7) + (-1) * (a 8) + (-3) * (a 9)]

theorem inverse_coefficient (a : Fin 10 → R) :
    inverseMap (coefficientMap a) = a := by
  funext i
  fin_cases i <;> dsimp [inverseMap, coefficientMap] <;> ring

theorem coefficient_inverse (a : Fin 10 → R) :
    coefficientMap (inverseMap a) = a := by
  funext i
  fin_cases i <;> dsimp [inverseMap, coefficientMap] <;> ring

theorem coefficientMap_bijective : Function.Bijective (coefficientMap (R := R)) :=
  ⟨Function.LeftInverse.injective inverse_coefficient,
    Function.RightInverse.surjective coefficient_inverse⟩

theorem table (x : Fin 3 → Fin 6 → R) (h : Relations x) (a : Fin 10 → R) :
    lefschetz x * (∑ j, a j * source x j) = ∑ j, coefficientMap a j * target x j := by
  simp [Fin.sum_univ_succ, source, target, coefficientMap]
  linear_combination
    (a 0) * (column_0 x h) +
    (a 1) * (column_1 x h) +
    (a 2) * (column_2 x h) +
    (a 3) * (column_3 x h) +
    (a 4) * (column_4 x h) +
    (a 5) * (column_5 x h) +
    (a 6) * (column_6 x h) +
    (a 7) * (column_7 x h) +
    (a 8) * (column_8 x h) +
    (a 9) * (column_9 x h)

end PaperVerification.Segre.TwoFactor25
end
