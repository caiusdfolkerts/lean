section ProbeLayer91



/-!
# Corrected integral multiplication table for the `(3,3)` Segre reduction

Every ring identity below is proved from the literal two-by-two minors and rank-sum
relations. The coefficients remain valid over every commutative ring. This file
also proves the displayed coordinate map is invertible; interpreting it as a basis
matrix additionally requires the descent-basis theorem.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre

variable {R : Type*} [CommRing R]

/-- Literal defining relations for the rank-sum reduction of the `(3,3)` Segre ring. -/
structure Relations33 (x : Fin 4 → Fin 4 → R) : Prop where
  minor : ∀ i k j l, x i j * x k l = x i l * x k j
  s0 : x 0 0 = 0
  s1 : x 0 1 + x 1 0 = 0
  s2 : x 0 2 + x 1 1 + x 2 0 = 0
  s3 : x 0 3 + x 1 2 + x 2 1 + x 3 0 = 0
  s4 : x 1 3 + x 2 2 + x 3 1 = 0
  s5 : x 2 3 + x 3 2 = 0
  s6 : x 3 3 = 0

theorem mul33_column_0 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 0 1 = (-1) * (x 0 1 * x 1 2) := by
  linear_combination (-1) * (h.minor 0 1 0 3) + (h.minor 0 3 0 1) + (x 1 3) * h.s0 + (-1) * (x 3 1) * h.s0 + (-1) * (x 0 3) * h.s1 + (x 0 1) * h.s3

theorem mul33_column_1 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 0 2 = (x 0 1 * x 2 2) := by
  linear_combination (-1) * (h.minor 0 2 1 2)

theorem mul33_column_2 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 0 3 = (x 0 1 * x 2 3) := by
  linear_combination (-1) * (h.minor 0 2 1 3)

theorem mul33_column_3 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 1 1 = (-1) * (x 0 1 * x 1 3) + (-3) * (x 0 1 * x 2 2) := by
  linear_combination (-1) * (h.minor 0 2 0 3) + (h.minor 0 2 1 2) + (h.minor 0 3 0 2) + (-1) * (h.minor 1 2 0 2) + (h.minor 1 3 0 1) + (x 2 3) * h.s0 + (-1) * (x 3 2) * h.s0 + (x 2 2) * h.s1 + (-1) * (x 3 1) * h.s1 + (-1) * (x 0 3) * h.s2 + (-1) * (x 1 2) * h.s2 + (x 0 2) * h.s3 + (x 1 1) * h.s3 + (x 0 1) * h.s4

theorem mul33_column_4 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 1 2 = (x 1 1 * x 2 2) := by
  linear_combination (-1) * (h.minor 1 2 1 2)

theorem mul33_column_5 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 1 3 = (x 1 1 * x 2 3) := by
  linear_combination (-1) * (h.minor 1 2 1 3)

theorem mul33_column_6 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 2 1 = (x 0 2 * x 1 3) + (-3) * (x 0 1 * x 2 3) + (-2) * (x 1 1 * x 2 2) := by
  linear_combination (h.minor 0 2 1 3) + (-1) * (h.minor 0 3 1 2) + (-1) * (h.minor 1 2 0 3) + (h.minor 1 2 1 2) + (h.minor 2 3 0 1) + (x 2 3) * h.s1 + (-1) * (x 1 3) * h.s2 + (-1) * (x 3 1) * h.s2 + (x 2 1) * h.s3 + (x 1 1) * h.s4 + (x 0 1) * h.s5

theorem mul33_column_7 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 2 2 = (-1) * (x 0 2 * x 2 3) + (-3) * (x 1 1 * x 2 3) := by
  linear_combination (-1) * (h.minor 0 3 1 3) + (h.minor 1 2 1 3) + (h.minor 1 3 0 3) + (-1) * (h.minor 1 3 1 2) + (h.minor 2 3 0 2) + (-1) * (x 3 3) * h.s1 + (-1) * (x 3 2) * h.s2 + (x 1 3) * h.s3 + (x 2 2) * h.s3 + (-1) * (x 0 3) * h.s4 + (-1) * (x 1 2) * h.s4 + (x 0 2) * h.s5 + (2) * (x 1 1) * h.s5 + (2) * (x 0 1) * h.s6

theorem mul33_column_8 (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
    x 2 1 * x 2 3 = (-1) * (x 1 2 * x 2 3) := by
  linear_combination (-1) * (h.minor 0 3 2 3) + (h.minor 2 3 0 3) + (-1) * (x 3 3) * h.s2 + (x 2 3) * h.s3 + (-1) * (x 0 3) * h.s5 + (2) * (x 0 2) * h.s6 + (x 1 1) * h.s6

/-- The corrected coefficient map for multiplication by `x₂₁` in the paper's
ordered source and target monomials. -/
def correctedMap33 (v : Fin 9 → R) : Fin 9 → R :=
  ![-v 0, -v 3, v 6, v 1 - 3 * v 3, v 2 - 3 * v 6,
    -v 7, v 4 - 2 * v 6, v 5 - 3 * v 7, -v 8]

/-- Integral inverse to the corrected coefficient map. -/
def inverseMap33 (v : Fin 9 → R) : Fin 9 → R :=
  ![-v 0, v 3 - 3 * v 1, v 4 + 3 * v 2, -v 1,
    v 6 + 2 * v 2, v 7 - 3 * v 5, v 2, -v 5, -v 8]

theorem inverse_corrected33 (v : Fin 9 → R) :
    inverseMap33 (correctedMap33 v) = v := by
  funext i
  fin_cases i <;> simp [inverseMap33, correctedMap33]

theorem corrected_inverse33 (v : Fin 9 → R) :
    correctedMap33 (inverseMap33 v) = v := by
  funext i
  fin_cases i <;> simp [inverseMap33, correctedMap33]

/-- The corrected integral matrix is bijective in every characteristic. -/
theorem correctedMap33_bijective : Function.Bijective (correctedMap33 (R := R)) :=
  ⟨Function.LeftInverse.injective inverse_corrected33,
    Function.RightInverse.surjective corrected_inverse33⟩

/-- The second column is especially simple: this is directly a Segre minor.
The printed table has the opposite sign in this column. -/
theorem corrected33_second_column (x : Fin 4 → Fin 4 → R) (h : Relations33 x) :
