section ProbeLayer96



/-!
# All nonexceptional two-factor injective cases

The two integral base calculations and unrestricted last-column propagation
cover every a,b≥2 outside the three exceptional unordered pairs. Both factor
directions use the proved algebraic transposition map.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorInjectivity

open Monomials ActualQuotient TwoFactorActual TwoFactorPropagation TwoFactorTranspose

variable {K : Type*} [Field K] [Infinite K]

def Exceptional (a b : ℕ) : Prop :=
  (a=2 ∧ (b=2 ∨ b=3 ∨ b=4)) ∨ (b=2 ∧ (a=2 ∨ a=3 ∨ a=4))

theorem injective_two_many (b : ℕ) (hb : 5 ≤ b) :
    ∃ ℓ : degreeOne (K := K) (n := shape 2 b), Function.Injective (firstLefschetz ℓ) :=
  propagate_columns 2 5 b (by omega) (by omega) hb
    ⟨TwoFactor25Actual.lefschetzForm,TwoFactor25Actual.firstLefschetz_bijective.1⟩

theorem injective_three_many (b : ℕ) (hb : 3 ≤ b) :
    ∃ ℓ : degreeOne (K := K) (n := shape 3 b), Function.Injective (firstLefschetz ℓ) :=
  propagate_columns 3 3 b (by omega) (by omega) hb
    ⟨TwoFactor33Actual.lefschetzForm,TwoFactor33Actual.firstLefschetz_bijective.1⟩

theorem injective_both_ge_three (a b : ℕ) (ha : 3 ≤ a) (hb : 3 ≤ b) :
    ∃ ℓ : degreeOne (K := K) (n := shape a b), Function.Injective (firstLefschetz ℓ) := by
  have h₁ := exists_injective_transpose 3 b (injective_three_many (K := K) b hb)
  have h₂ := propagate_columns b 3 a (by omega) (by omega) ha h₁
  exact exists_injective_transpose b a h₂

/-- The entire two-factor injective branch of Theorem1.1 for the specified
rank-sum Artinian reduction, with no bound on either factor dimension. -/
theorem positive_nonexceptional (a b : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hex : ¬ Exceptional a b) :
    ∃ ℓ : degreeOne (K := K) (n := shape a b), Function.Injective (firstLefschetz ℓ) := by
  by_cases ha2 : a=2
  · subst a
    have hb5 : 5 ≤ b := by unfold Exceptional at hex; omega
    exact injective_two_many b hb5
  · by_cases hb2 : b=2
    · subst b
      have ha5 : 5 ≤ a := by unfold Exceptional at hex; omega
      exact exists_injective_transpose 2 a (injective_two_many (K := K) a ha5)
    · exact injective_both_ge_three a b (by omega) (by omega)

end PaperVerification.Segre.TwoFactorInjectivity
end
end ProbeLayer96

section ProbeLayer97



/-!
# The exact two-factor exceptional kernels

The complete degree-two surjectivity of the (2,5) calculation descends through
the actual last-column quotient maps. The independently proved actual Hilbert
dimensions then give the exact defects 3,3,2 at (2,2),(2,3),(2,4).
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorSurjectivity

open Staircase Monomials ActualQuotient TwoFactorActual TwoFactorTruncation
open TwoFactorDegreeOne TwoFactorTranspose

variable {K : Type*} [Field K]

set_option maxHeartbeats 2000000 in
/-- A surjective first Lefschetz map descends to every immediate column
quotient, with the full homogeneous source and target retained. -/
theorem surjective_truncation (a b : ℕ)
    (h : ∃ ℓ : degreeOne (K := K) (n := shape a (b+1)),
      Function.Surjective (firstLefschetz ℓ)) :
    ∃ ℓ : degreeOne (K := K) (n := shape a b),
      Function.Surjective (firstLefschetz ℓ) := by
  obtain ⟨ℓ,hℓ⟩ := h
  have hmem := truncation_one_mem (K := K) a b (oneToReduction (K := K) (n := shape a (b+1)) ℓ) ⟨ℓ,rfl⟩
  obtain ⟨ℓ',hℓ'⟩ := hmem
  refine ⟨ℓ', ?_⟩
  intro y
  obtain ⟨v,hv,htr⟩ := truncation_two_surjective (K := K) a b y.val y.property
  obtain ⟨x,hx⟩ := hℓ ⟨v,hv⟩
  refine ⟨⟨truncation (K := K) a b x.val,truncation_one_mem (K := K) a b x.val x.property⟩, ?_⟩
  apply Subtype.ext
  change oneToReduction (K := K) (n := shape a b) ℓ' * truncation (K := K) a b x.val = y.val
  rw [hℓ',← map_mul]
  have he := congrArg Subtype.val hx
  change oneToReduction (K := K) (n := shape a (b+1)) ℓ * x.val=v at he
  rw [he,htr]

theorem small_surjective (b : ℕ) (hb : b=2 ∨ b=3 ∨ b=4) :
    ∃ ℓ : degreeOne (K := K) (n := shape 2 b), Function.Surjective (firstLefschetz ℓ) := by
  have h₅ : ∃ ℓ : degreeOne (K := K) (n := shape 2 5),
      Function.Surjective (firstLefschetz ℓ) :=
    ⟨TwoFactor25Actual.lefschetzForm,TwoFactor25Actual.firstLefschetz_surjective⟩
  have h₄ := surjective_truncation 2 4 h₅
  have h₃ := surjective_truncation 2 3 h₄
  have h₂ := surjective_truncation 2 2 h₃
  rcases hb with rfl | rfl | rfl
  · exact h₂
  · exact h₃
  · exact h₄

theorem small_dimensions [Infinite K] (b : ℕ) (hb : b=2 ∨ b=3 ∨ b=4) :
    (Module.finrank K (actualDegreeOne (K := K) (n := shape 2 b)),
      Module.finrank K (actualDegreeTwo (K := K) (n := shape 2 b))) = (2*b,b.choose 2) := by
  have h₁ := finrank_actualDegreeOne_shape (K := K) 2 b
  apply Prod.ext h₁
  rcases hb with rfl | rfl | rfl
  · have hN : Fintype.card (Cell (shape 2 2))=9 := by decide
    have hQ : Fintype.card (SortedPair (shape 2 2))=36 := by decide
    rw [finrank_actualDegreeTwo,hN,hQ,sideSum_shape]
    norm_num [Nat.choose]
  · have hN : Fintype.card (Cell (shape 2 3))=12 := by decide
    have hQ : Fintype.card (SortedPair (shape 2 3))=60 := by decide
    rw [finrank_actualDegreeTwo,hN,hQ,sideSum_shape]
    norm_num [Nat.choose]
  · have hN : Fintype.card (Cell (shape 2 4))=15 := by decide
    have hQ : Fintype.card (SortedPair (shape 2 4))=90 := by decide
    rw [finrank_actualDegreeTwo,hN,hQ,sideSum_shape]
    norm_num [Nat.choose]

/-- The three original positive defects, computed in the actual ring after
proving surjectivity onto its entire second homogeneous component. -/
theorem small_exact_kernel [Infinite K] (b : ℕ) (hb : b=2 ∨ b=3 ∨ b=4) :
    ∃ ℓ : degreeOne (K := K) (n := shape 2 b), Function.Surjective (firstLefschetz ℓ) ∧
      Module.finrank K (LinearMap.ker (firstLefschetz ℓ)) = if b=4 then 2 else 3 := by
  letI := Artinian.reduction_finite (K := K) (n := shape 2 b)
  obtain ⟨ℓ,hℓ⟩ := small_surjective (K := K) b hb
  refine ⟨ℓ,hℓ,?_⟩
  have hn := (firstLefschetz ℓ).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hℓ,finrank_top] at hn
  have hd := small_dimensions (K := K) b hb
  have hd₁ := congrArg Prod.fst hd
  have hd₂ := congrArg Prod.snd hd
  dsimp only [Prod.fst,Prod.snd] at hd₁ hd₂
  rw [hd₁,hd₂] at hn
  rcases hb with rfl | rfl | rfl <;> norm_num [Nat.choose] at hn ⊢ <;> omega

end PaperVerification.Segre.TwoFactorSurjectivity
end
end ProbeLayer97

section ProbeLayer98



/-!
# The unrestricted P1 factor case

The uniform cardinality of the actual sorted monomial basis, together with
the proved rank-sum exactness, gives A2=0 for every P1×Pb. There is no upper
bound on b and no characteristic restriction.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorOneDimension

open Staircase Monomials ActualQuotient TwoFactorActual TwoFactorDegreeOne

variable {K : Type*} [Field K] [Infinite K]

theorem card_cells_shape (a b : ℕ) : Fintype.card (Cell (shape a b))=(a+1)*(b+1) := by
  rw [HilbertCounts.card_cells]
  simp only [shape,Fin.prod_univ_succ,Matrix.cons_val_zero,Matrix.cons_val_succ,
    Matrix.head_cons,Fin.prod_univ_zero,mul_one]

theorem card_sortedPairs_shape (a b : ℕ) :
    Fintype.card (SortedPair (shape a b))=(a+2).choose 2 * (b+2).choose 2 := by
  rw [HilbertCounts.card_sortedPairs]
  simp only [shape,Fin.prod_univ_succ,Matrix.cons_val_zero,Matrix.cons_val_succ,
    Matrix.head_cons,Fin.prod_univ_zero,mul_one]

theorem finrank_degreeTwo_one (b : ℕ) :
    Module.finrank K (actualDegreeTwo (K := K) (n := shape 1 b))=0 := by
  rw [finrank_actualDegreeTwo,card_cells_shape,card_sortedPairs_shape,sideSum_shape]
  have hs : 1+b+1=b+2 := by omega
  rw [hs]
  norm_num only [show 1+1=2 by rfl,show 1+2=3 by rfl,show Nat.choose 3 2=3 by decide]
  have hc : (b+2).choose 2 * 2=(b+2)*(b+1) := by
    simpa only [Nat.choose_one_right,Nat.add_assoc] using
      (Nat.add_one_mul_choose_eq (b+1) 1).symm
  have h4 : (2*(b+1))*(b+2)=4*(b+2).choose 2 := by nlinarith
  rw [h4]
  omega

/-- The full actual second homogeneous component vanishes in every rank-sum
Artinian reduction of a Segre ring with one projective-line factor. -/
theorem actualDegreeTwo_one_eq_bot (b : ℕ) :
    actualDegreeTwo (K := K) (n := shape 1 b)=⊥ := by
  letI := Artinian.reduction_finite (K := K) (n := shape 1 b)
  exact Submodule.finrank_eq_zero.mp (finrank_degreeTwo_one b)

theorem every_form_surjective (b : ℕ) (ℓ : degreeOne (K := K) (n := shape 1 b)) :
    Function.Surjective (firstLefschetz ℓ) := by
  intro y
  have hy : y.val ∈ (⊥ : Submodule K (Artinian.Reduction (K := K) (n := shape 1 b))) := by
    simpa only [actualDegreeTwo_one_eq_bot] using y.property
  have hy0 : y=0 := Subtype.ext ((Submodule.mem_bot K).mp hy)
  exact ⟨0,(firstLefschetz ℓ).map_zero.trans hy0.symm⟩

theorem exact_kernel (b : ℕ) (ℓ : degreeOne (K := K) (n := shape 1 b)) :
    Module.finrank K (LinearMap.ker (firstLefschetz ℓ))=b := by
  letI := Artinian.reduction_finite (K := K) (n := shape 1 b)
  have h := (firstLefschetz ℓ).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr (every_form_surjective b ℓ),finrank_top,
    finrank_degreeTwo_one,zero_add,finrank_actualDegreeOne_shape,one_mul] at h
  exact h

end PaperVerification.Segre.TwoFactorOneDimension
end
end ProbeLayer98

section ProbeLayer99



/-!
# Fixed actual Lefschetz witnesses give polynomial-matrix rank witnesses

This is the reverse direction needed to pass from the explicit two-factor
Artinian reduction to general reductions. Injectivity implies complete
degree-two Koszul exactness of the enlarged family; surjectivity implies that
its products span the entire quadratic Segre component. Both statements refer
to the original factor polynomials and their independently proved bases.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.FixedLefschetzRanks

open Staircase Monomials RankParameters Degeneration KoszulDimension
open LefschetzBridge ParameterProducts ActualLefschetz ActualQuotient
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

noncomputable def enlarge (ℓ : degreeOne (K := K) (n := n)) :
    Matrix (Cell n) (Option (Ranks n)) K :=
  fun u o => o.elim (coordinates.symm ℓ u) (fun r => rankForms u r)

theorem forms_enlarge (ℓ : degreeOne (K := K) (n := n)) :
    forms (enlarge ℓ) = fun o : Option (Ranks n) =>
      o.elim ℓ (forms (rankForms (K := K) (n := n))) := by
  funext o
  cases o with
  | none => exact coordinates.apply_symm_apply ℓ
  | some r => rfl

theorem pairRelations_le_mapped_koszul (A : Matrix (Cell n) D K) :
    pairRelations (K := K) (forms A) ≤
      (LinearMap.range (koszulMatrix A)).map multiplierCoordinates.toLinearMap := by
  apply Submodule.span_le.mpr
  rintro g ⟨⟨i,j⟩,rfl⟩
  exact ⟨koszulMatrix A (pairAlternating i j),⟨pairAlternating i j,rfl⟩,
    multiplierCoordinates_pair A i j⟩

theorem matrix_exactness_of_actual (A : Matrix (Cell n) D K)
    (hA : LinearMap.ker (multiply polynomialProduct (forms A)) =
      pairRelations (K := K) (forms A)) :
    LinearMap.ker (KoszulRank.multiplication A) = LinearMap.range (koszulMatrix A) := by
  apply le_antisymm
  · intro U hU
    have hg : multiplierCoordinates U ∈ pairRelations (K := K) (forms A) := by
      rw [← hA]
      change multiply polynomialProduct (forms A) (multiplierCoordinates U)=0
      rw [multiply_coordinates,LinearMap.mem_ker.mp hU,map_zero]
    obtain ⟨V,⟨Q,hQ⟩,he⟩ := pairRelations_le_mapped_koszul A hg
    refine ⟨Q,?_⟩
    apply multiplierCoordinates.injective
    rw [hQ]
    exact he
  · exact KoszulRank.koszul_range_le_kernel A

theorem enlarged_exactness_of_injective [Infinite K]
    (ℓ : degreeOne (K := K) (n := n))
    (hℓ : Function.Injective (firstLefschetz ℓ)) :
    LinearMap.ker (multiply polynomialProduct (forms (enlarge ℓ))) =
      pairRelations (K := K) (forms (enlarge ℓ)) := by
  rw [forms_enlarge]
  let θ := forms (rankForms (K := K) (n := n))
  apply le_antisymm
  · intro g hg
    have hwide : splitOption (K := K) g ∈ LinearMap.ker (wideMultiply polynomialProduct θ ℓ) := by
      change wideMultiply polynomialProduct θ ℓ (splitOption (K := K) g)=0
      rw [← multiply_splitOption]
      exact LinearMap.mem_ker.mp hg
    have hproduct : ℓ.val * (g none).val ∈ productSpan (rankForms (K := K) (n := n)) := by
      rw [← range_actual_multiply]
      refine ⟨-(fun r => g (some r)),?_⟩
      rw [map_neg]
      have he : ℓ.val * (g none).val + multiply polynomialProduct θ (fun r => g (some r))=0 := hwide
      exact (eq_neg_of_add_eq_zero_left he).symm
    have hfirst : g none ∈ parameterSpan (K := K) θ :=
      (firstLefschetz_injective_iff ℓ).mp hℓ (g none) hproduct
    let z : LinearMap.ker (wideMultiply polynomialProduct θ ℓ) := ⟨splitOption g,hwide⟩
    have hz : z ∈ LinearMap.ker (cycleProjection polynomialProduct polynomialProduct_comm θ ℓ) := by
      apply Subtype.ext
      exact (Submodule.Quotient.mk_eq_zero (parameterSpan (K := K) θ)).mpr hfirst
    rw [kernel_cycleProjection polynomialProduct polynomialProduct_comm θ ℓ
      fixed_actual_exactness] at hz
    have hmem : splitOption (K := K) g ∈ widePairRelations (K := K) θ ℓ := hz
    rw [← widePairRelations_eq_pairRelations] at hmem
    obtain ⟨g',hg',he⟩ := hmem
    have he' : g'=g := splitOption.injective he
    exact he' ▸ hg'
  · exact pairRelations_le_kernel polynomialProduct polynomialProduct_comm _

theorem rank_lower_bound_of_exactness (A : Matrix (Cell n) D K)
    (hA : LinearMap.ker (KoszulRank.multiplication A) = LinearMap.range (koszulMatrix A)) :
    Fintype.card (Cell n) * Fintype.card D - (Fintype.card D).choose 2 ≤
      (multiplicationMatrix 1 A).rank := by
  have hk := (koszulMatrix A).finrank_range_le
  rw [finrank_alternatingMatrices] at hk
  have hn := (KoszulRank.multiplication A).finrank_range_add_finrank_ker
  have hd : Module.finrank K (Matrix (Cell n) D K)=Fintype.card (Cell n)*Fintype.card D := by
    simp only [Module.finrank_matrix,Module.finrank_self,mul_one]
  rw [hd,hA] at hn
  rw [KoszulRank.multiplication_matrix_rank]
  omega

/-- A fixed actual injective map gives the full enlarged Koszul rank needed
by the universal nonzero-minor genericity certificate. -/
theorem rank_of_injective [Infinite K]
    (ℓ : degreeOne (K := K) (n := n))
    (hℓ : Function.Injective (firstLefschetz ℓ)) :
    Fintype.card (Cell n) * Fintype.card (Option (Ranks n)) -
      (Fintype.card (Option (Ranks n))).choose 2 ≤
        (multiplicationMatrix 1 (enlarge ℓ)).rank :=
  rank_lower_bound_of_exactness _
    (matrix_exactness_of_actual _ (enlarged_exactness_of_injective ℓ hℓ))

theorem old_productSpan_le (ℓ : degreeOne (K := K) (n := n)) :
    productSpan (rankForms (K := K) (n := n)) ≤ productSpan (enlarge ℓ) := by
  apply Submodule.span_le.mpr
  rintro f ⟨⟨r,u⟩,rfl⟩
  exact Submodule.subset_span ⟨(some r,u),rfl⟩

theorem new_product_mem (ℓ g : degreeOne (K := K) (n := n)) :
    ℓ.val*g.val ∈ productSpan (enlarge ℓ) := by
  rw [← range_actual_multiply]
  refine ⟨Pi.single none g,?_⟩
  rw [multiply_single,forms_enlarge]
  rfl

theorem productSpan_full_of_surjective
    (ℓ : degreeOne (K := K) (n := n))
    (hℓ : Function.Surjective (firstLefschetz ℓ)) :
    productSpan (enlarge ℓ)=degreeTwo (K := K) (n := n) := by
  apply le_antisymm (productSpan_le_degreeTwo _)
  intro f hf
  let f' : degreeTwo (K := K) (n := n) := ⟨f,hf⟩
  let y : actualDegreeTwo (K := K) (n := n) :=
    ⟨twoToReduction (K := K) (n := n) f',⟨f',rfl⟩⟩
  obtain ⟨x,hx⟩ := hℓ y
  obtain ⟨g,hg⟩ := x.property
  have he : twoToReduction (K := K) (n := n) (f'-degreeOneProduct ℓ g)=0 := by
    rw [map_sub,twoToReduction_product,hg]
    have hh := congrArg Subtype.val hx
    change oneToReduction (K := K) (n := n) ℓ * x.val =
      twoToReduction (K := K) (n := n) f' at hh
    rw [hh,sub_self]
  have hp : f-ℓ.val*g.val ∈ productSpan (rankForms (K := K) (n := n)) := by
    have hk : f'-degreeOneProduct ℓ g ∈ LinearMap.ker (twoToReduction (K := K) (n := n)) := he
    rw [kernel_twoToReduction] at hk
    exact hk
  have hs := Submodule.add_mem (productSpan (enlarge ℓ))
    (old_productSpan_le ℓ hp) (new_product_mem ℓ g)
  simpa only [sub_add_cancel] using hs

/-- A fixed actual surjective map gives a full-row-rank enlarged multiplication
matrix, on the entire degree-two Segre polynomial space. -/
theorem rank_of_surjective (ℓ : degreeOne (K := K) (n := n))
    (hℓ : Function.Surjective (firstLefschetz ℓ)) :
    (multiplicationMatrix 1 (enlarge ℓ)).rank = Fintype.card (SortedPair n) := by
  have h := congrArg (fun p : Submodule K (MvPolynomial (Variables n) K) => Module.finrank K p)
    (productSpan_full_of_surjective ℓ hℓ)
  rw [finrank_productSpan,Module.finrank_eq_card_basis (degreeTwoBasis (K := K) (n := n))] at h
  exact h

end PaperVerification.Segre.FixedLefschetzRanks
end
end ProbeLayer99

section ProbeLayer100



/-!
# Stress-free exceptions give surjective Segre multiplication

A sorted quadratic coordinate is a square or a strict comparable pair. Every
strict pair has exactly two oriented graph edges. These literal bijections
identify the full row count, so generic stress-freeness gives full row rank in
the staircase fiber and then in actual Segre degree-two multiplication.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.StressMultiplication

open Staircase Monomials RankParameters RigidityRank RigidityMultiplication
open GraphKernel StressFree GenericRigidity Degeneration Matrix
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

abbrev StrictPair (n : I → ℕ) := {q : SortedPair n // q.val.1 ≠ q.val.2}

noncomputable def diagonalEquiv :
    {q : SortedPair n // q.val.1 = q.val.2} ≃ Cell n where
  toFun q := q.val.val.1
  invFun u := ⟨⟨(u,u),le_rfl⟩,rfl⟩
  left_inv q := by
    apply Subtype.ext
    apply Subtype.ext
    exact Prod.ext rfl q.property
  right_inv _ := rfl

/-- The two oriented edges of every strict sorted pair are explicit and
exhaust all edges of the comparability graph. -/
noncomputable def edgeOrientationEquiv :
    Edges (chainGraph n) ≃ StrictPair n ⊕ StrictPair n := by
  classical
  refine
    { toFun := fun e => if h : e.val.1 ≤ e.val.2 then
          Sum.inl ⟨⟨e.val,h⟩,e.property.1⟩ else
          Sum.inr ⟨⟨(e.val.2,e.val.1),e.property.2.resolve_left h⟩,e.property.1.symm⟩
      invFun := fun s => match s with
        | Sum.inl q => ⟨q.val.val,q.property,Or.inl q.val.property⟩
        | Sum.inr q => ⟨(q.val.val.2,q.val.val.1),q.property.symm,Or.inr q.val.property⟩
      left_inv := ?_
      right_inv := ?_ }
  · intro e
    dsimp only
    split_ifs <;> apply Subtype.ext <;> rfl
  · intro s
    cases s with
    | inl q =>
      simp only [dif_pos q.val.property]
    | inr q =>
      have h : ¬ q.val.val.2 ≤ q.val.val.1 := fun h =>
        q.property (le_antisymm q.val.property h)
      simp only [dif_neg h]

/-- Exact full quadratic-row count; the factor two counts orientations only
and is an equality of natural numbers, so no field characteristic enters. -/
theorem twice_card_sortedPair : 2 * Fintype.card (SortedPair n) =
    2 * Fintype.card (Cell n) + Fintype.card (Edges (chainGraph n)) := by
  classical
  have hs := Fintype.card_congr
    (Equiv.sumCompl (fun q : SortedPair n => q.val.1 = q.val.2))
  have hd := Fintype.card_congr (diagonalEquiv (n := n))
  have he := Fintype.card_congr (edgeOrientationEquiv (n := n))
  rw [Fintype.card_sum] at hs he
  change Fintype.card {q : SortedPair n // q.val.1 = q.val.2} +
    Fintype.card (StrictPair n) = Fintype.card (SortedPair n) at hs
  omega

/-- An actual stress-free placement makes the full staircase multiplication
matrix surjective, with no selected monomial subset in the target. -/
theorem rank_zero_of_stressFree (p : Matrix (Cell n) D K)
    (hr : 2 * (rigidityMatrix p (endpoints (chainGraph n))).rank =
      Fintype.card (Edges (chainGraph n))) :
    (multiplicationMatrix 0 (augmentedPlacement p)).rank = Fintype.card (SortedPair n) := by
  have hc := twice_card_sortedPair (n := n)
  rw [rank_zero_eq_vertex_add_rigidity]
  omega

theorem exists_actual_surjective_of_stressFree [Infinite K]
    (h : GenericallyStressFree K D (chainGraph n)) :
    ∃ A : Matrix (Cell n) (Option D) K,
      (multiplicationMatrix 1 A).rank = Fintype.card (SortedPair n) := by
  obtain ⟨p,hp,hr⟩ := h
  obtain ⟨A,hA⟩ := rank_transfer_from_zero (augmentedPlacement p)
    (Fintype.card (SortedPair n)) ((rank_zero_of_stressFree p hr).ge)
  exact ⟨A,le_antisymm (Matrix.rank_le_card_height _) hA⟩

/-- All three exceptional positive triples, including every permutation, attain
full actual quadratic rank after adding one form. -/
theorem exceptional_actual_surjective [Infinite K] (n : Fin 3 → ℕ)
    (hex : ChainClassification.ExceptionalTriple n) :
    ∃ A : Matrix (Cell n) (Option (Ranks n)) K,
      (multiplicationMatrix 1 A).rank = Fintype.card (SortedPair n) :=
  exists_actual_surjective_of_stressFree
    (ChainClassification.exceptional_stressFree (K := K) n hex)

end PaperVerification.Segre.StressMultiplication
end
end ProbeLayer100

section ProbeLayer101



/-!
# Generic surjectivity and exact exceptional kernel dimensions

Full degree-two rank after adjoining one form is identified with surjectivity
of the actual first Lefschetz map. The old-parameter baseline rank is imposed by
an additional nonzero minor, so its actual homogeneous dimensions and therefore
the exact kernel dimension are proved, rather than supplied as assumptions.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GenericSurjectivity

open Staircase Monomials RankParameters Degeneration ParameterProducts ActualLefschetz
open LefschetzBridge GeneralParameters GeneralQuotient GenericFirstLefschetz Matrix
open ActualQuotient (degreeOneProduct)
open scoped Matrix

variable {I D K : Type*} [Fintype I] [DecidableEq I] [Fintype D] [DecidableEq D]
  [Field K] {n : I → ℕ}

/-- Full matrix row rank is surjectivity onto the entire actual quadratic
polynomial space, with its independently proved sorted basis. -/
theorem productSpan_eq_degreeTwo_of_full_rank (A : Matrix (Cell n) D K)
    (hr : (Degeneration.multiplicationMatrix 1 A).rank = Fintype.card (SortedPair n)) :
    productSpan A = degreeTwo (K := K) (n := n) := by
  have hs := Matrix.mulVec_surjective_iff_rank_eq_card.mpr hr
  rw [← range_evaluatedMultiplication,evaluatedMultiplication,LinearMap.range_comp,
    LinearMap.range_eq_top.mpr hs,Submodule.map_top,evaluateTwo,Fintype.range_linearCombination,
    degreeTwo_eq_span_sorted]

/-- Full enlarged degree-two rank gives the actual quotient's surjective
first Lefschetz map. No target basis or quotient-dimension premise is used. -/
theorem firstLefschetz_surjective_of_rank (A : Matrix (Cell n) (Option D) K)
    (hr : (Degeneration.multiplicationMatrix 1 A).rank = Fintype.card (SortedPair n)) :
    Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) := by
  intro y
  obtain ⟨f,hf⟩ := y.property
  have hmem : f.val ∈ productSpan A := by
    rw [productSpan_eq_degreeTwo_of_full_rank A hr]
    exact f.property
  rw [← range_actual_multiply] at hmem
  obtain ⟨g,hg⟩ := hmem
  have hsum : (lefschetzForm A).val * (g none).val +
      multiply polynomialProduct (forms (oldForms A)) (fun d => g (some d)) = f.val := by
    change (∑ o : Option D, (forms A o).val * (g o).val) = f.val at hg
    rw [Fintype.sum_option] at hg
    exact hg
  have hprod : f - degreeOneProduct (lefschetzForm A) (g none) ∈
      productsInDegreeTwo (oldForms A) := by
    change f.val - (lefschetzForm A).val * (g none).val ∈ productSpan (oldForms A)
    rw [← hsum,add_sub_cancel_left,← range_actual_multiply]
    exact ⟨(fun d => g (some d)),rfl⟩
  rw [← GeneralQuotient.kernel_twoToReduction] at hprod
  have he : GeneralQuotient.twoToReduction (oldForms A) f =
      GeneralQuotient.twoToReduction (oldForms A)
        (degreeOneProduct (lefschetzForm A) (g none)) :=
    sub_eq_zero.mp (by simpa only [LinearMap.mem_ker,map_sub] using hprod)
  refine ⟨GeneralQuotient.homogeneousResidue (oldForms A) (g none), ?_⟩
  apply Subtype.ext
  change GeneralQuotient.oneToReduction (oldForms A) (lefschetzForm A) *
    GeneralQuotient.oneToReduction (oldForms A) (g none) = y.val
  rw [← GeneralQuotient.twoToReduction_product,← he,hf]

/-- The old rank-sum family supplies an attainable generic baseline rank. -/
theorem baseline_certificate [Infinite K] :
    ∃ f : MvPolynomial (Cell n × Ranks n) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Fintype.card (Cell n) * Fintype.card (Ranks n) -
            (Fintype.card (Ranks n)).choose 2 ≤
              (Degeneration.multiplicationMatrix 1 A).rank := by
  have hr : Fintype.card (Cell n) * Fintype.card (Ranks n) -
      (Fintype.card (Ranks n)).choose 2 ≤
      ((universalMultiplication (K := K) (n := n) (D := Ranks n)).map
        (MvPolynomial.eval (fun j => rankForms (K := K) (n := n) j.1 j.2))).rank := by
    rw [eval_universalMultiplication,FixedRankParameters.fixed_rank_exact]
    simp only [Ranks,Fintype.card_fin]
    exact le_rfl
  obtain ⟨f,hf,hw⟩ := GenericRank.minor_witness universalMultiplication
    (fun j => rankForms (K := K) (n := n) j.1 j.2) _ hr
  refine ⟨f,hf,?_⟩
  intro A hA
  have h := hw (fun j => A j.1 j.2) hA
  rwa [eval_universalMultiplication] at h

/-- All conditions needed for the full actual surjective branch, including the
old Hilbert-function ranks, hold on one explicitly witnessed principal open. -/
theorem surjective_certificate_of_rank_witnesses [Infinite K]
    (hcol : ∃ A : Matrix (Cell n) (Option (Ranks n)) K, Function.Surjective A.vecMul)
    (hmul : ∃ A : Matrix (Cell n) (Option (Ranks n)) K,
      (Degeneration.multiplicationMatrix 1 A).rank = Fintype.card (SortedPair n)) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          (Degeneration.multiplicationMatrix 1 (oldForms A)).rank =
            Fintype.card (Cell n) * Fintype.card (Ranks n) -
              (Fintype.card (Ranks n)).choose 2 ∧
          Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) := by
  classical
  obtain ⟨A₀,hA₀⟩ := hcol
  obtain ⟨A₁,hA₁⟩ := hmul
  have hc : Fintype.card (Option (Ranks n)) ≤
      ((universalCoefficients (K := K) (n := n) (D := Option (Ranks n))).map
        (MvPolynomial.eval (fun j => A₀ j.1 j.2))).rank := by
    rw [eval_universalCoefficients]
    exact (Matrix.vecMul_surjective_iff_rank_eq_card.mp hA₀).ge
  obtain ⟨fc,hfc,hwc⟩ := GenericRank.minor_witness universalCoefficients
    (fun j => A₀ j.1 j.2) (Fintype.card (Option (Ranks n))) hc
  have hm : Fintype.card (SortedPair n) ≤
      ((universalMultiplication (K := K) (n := n) (D := Option (Ranks n))).map
        (MvPolynomial.eval (fun j => A₁ j.1 j.2))).rank := by
    rw [eval_universalMultiplication,hA₁]
  obtain ⟨fm,hfm,hwm⟩ := GenericRank.minor_witness universalMultiplication
    (fun j => A₁ j.1 j.2) _ hm
  obtain ⟨fa,hfa,hwa⟩ := ArtinianOpen.artinian_certificate (K := K) (n := n)
  obtain ⟨fb,hfb,hwb⟩ := baseline_certificate (K := K) (n := n)
  let fr : MvPolynomial (Cell n × Option (Ranks n)) K :=
    MvPolynomial.rename (oldVariable (n := n) (D := Ranks n)) (fa * fb)
  have hfr : fr ≠ 0 := by
    exact fun h => (mul_ne_zero hfa hfb)
      ((MvPolynomial.rename_eq_zero_iff_of_injective (fa * fb)
        (oldVariable (n := n) (D := Ranks n)).injective).mp h)
  refine ⟨fc * fm * fr,mul_ne_zero (mul_ne_zero hfc hfm) hfr,?_⟩
  intro A hA
  rw [map_mul,map_mul] at hA
  obtain ⟨hcfm,hfrA⟩ := mul_ne_zero_iff.mp hA
  obtain ⟨hfcA,hfmA⟩ := mul_ne_zero_iff.mp hcfm
  have hcrank := hwc (fun j => A j.1 j.2) hfcA
  rw [eval_universalCoefficients] at hcrank
  have hsurj : Function.Surjective A.vecMul := Matrix.vecMul_surjective_iff_rank_eq_card.mpr
    (le_antisymm (Matrix.rank_le_card_width A) hcrank)
  have hold := oldForms_surjective A hsurj
  have hmrank := hwm (fun j => A j.1 j.2) hfmA
  rw [eval_universalMultiplication] at hmrank
  have hfull : (Degeneration.multiplicationMatrix 1 A).rank = Fintype.card (SortedPair n) :=
    le_antisymm (Matrix.rank_le_card_height _) hmrank
  have hab : MvPolynomial.eval (fun j => oldForms A j.1 j.2) (fa * fb) ≠ 0 := by
    simpa only [fr,MvPolynomial.eval_rename,Function.comp_def,oldVariable,
      Function.Embedding.coeFn_mk,oldForms] using hfrA
  rw [map_mul] at hab
  obtain ⟨ha,hb⟩ := mul_ne_zero_iff.mp hab
  have hart := hwa (oldForms A) ha
  have hbase := hwb (oldForms A) hb
  have holdrank := le_antisymm (KoszulRank.rank_upper_bound (oldForms A) hold) hbase
  exact ⟨hart.1,hart.2,hold,holdrank,firstLefschetz_surjective_of_rank A hfull⟩

/-- Rank-nullity in the actual quotient gives the exact kernel dimension once
the independently certified old dimensions and surjectivity are available. -/
theorem finrank_kernel_of_surjective
    (A : Matrix (Cell n) (Option (Ranks n)) K)
    [Module.Finite K (GeneralParameters.Reduction (oldForms A))]
    (hA : Function.Surjective (oldForms A).vecMul)
    (hr : (Degeneration.multiplicationMatrix 1 (oldForms A)).rank =
      Fintype.card (Cell n) * Fintype.card (Ranks n) - (Fintype.card (Ranks n)).choose 2)
    (hs : Function.Surjective
      (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) :
    Module.finrank K (LinearMap.ker
      (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) =
      (Fintype.card (Cell n) - Fintype.card (Ranks n)) -
        (Fintype.card (SortedPair n) -
          (Fintype.card (Cell n) * Fintype.card (Ranks n) - (Fintype.card (Ranks n)).choose 2)) := by
  have h := (GeneralQuotient.firstLefschetz (oldForms A)
    (lefschetzForm A)).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hs,finrank_top,
    GeneralQuotient.finrank_actualDegreeOne _ hA,
    GeneralQuotient.finrank_actualDegreeTwo,hr] at h
  exact Nat.eq_sub_of_add_eq' h

end PaperVerification.Segre.GenericSurjectivity
end
end ProbeLayer101

section ProbeLayer102



/-!
# General two-factor Artinian reductions

Fixed rank-sum Lefschetz witnesses are converted to nonzero polynomial minors
in all parameter and form coefficients. Artinianness and the complete old
degree-two rank are imposed independently. Thus these certificates concern
general actual Artinian reductions, not merely the explicit rank-sum fiber.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.TwoFactorGeneric

open Staircase Monomials RankParameters TwoFactorActual FixedLefschetzRanks
open GenericFirstLefschetz GenericSurjectivity TwoFactorOneDimension

variable {K : Type*} [Field K] [Infinite K]

theorem card_ranks_shape (a b : ℕ) :
    Fintype.card (Ranks (shape a b)) = a+b+1 := by
  change Fintype.card (Fin (sideSum (shape a b)+1)) = a+b+1
  rw [Fintype.card_fin,sideSum_shape]

theorem independent_enlarged_family (a b : ℕ) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    ∃ A : Matrix (Cell (shape a b)) (Option (Ranks (shape a b))) K,
      Function.Surjective A.vecMul := by
  have hcard : Fintype.card (Ranks (shape a b))+1 ≤ Fintype.card (Cell (shape a b)) := by
    rw [card_ranks_shape,card_cells_shape]
    have hab : 1 ≤ a*b := by nlinarith
    nlinarith
  obtain ⟨p,hp⟩ := GenericRigidity.exists_affineSpan_of_card (K := K)
    (I := Ranks (shape a b)) (V := Cell (shape a b)) hcard
  exact ⟨augmentedPlacement p,augmented_surjective_of_affineSpan p hp⟩

/-- Every nonexceptional positive two-factor format has an actual injective
first Lefschetz map on a nonempty principal open in all coefficients. -/
theorem injective_certificate (a b : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hex : ¬ TwoFactorInjectivity.Exceptional a b) :
    ∃ f : MvPolynomial (Cell (shape a b) × Option (Ranks (shape a b))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell (shape a b)) (Option (Ranks (shape a b))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) := by
  obtain ⟨ℓ,hℓ⟩ := TwoFactorInjectivity.positive_nonexceptional (K := K) a b ha hb hex
  exact injective_certificate_of_rank_witnesses
    (independent_enlarged_family a b (by omega) (by omega)) ⟨enlarge ℓ,rank_of_injective ℓ hℓ⟩

theorem exceptional_surjective_witness (a b : ℕ) (hex : TwoFactorInjectivity.Exceptional a b) :
    ∃ ℓ : degreeOne (K := K) (n := shape a b),
      Function.Surjective (ActualQuotient.firstLefschetz ℓ) := by
  rcases hex with ⟨rfl,hb⟩ | ⟨rfl,ha⟩
  · exact TwoFactorSurjectivity.small_surjective b hb
  · exact TwoFactorTranspose.exists_surjective_transpose 2 a
      (TwoFactorSurjectivity.small_surjective (K := K) a ha)

theorem exceptional_numeric_defect (a b : ℕ) (hex : TwoFactorInjectivity.Exceptional a b) :
    (Fintype.card (Cell (shape a b))-Fintype.card (Ranks (shape a b))) -
      (Fintype.card (SortedPair (shape a b))-
        (Fintype.card (Cell (shape a b))*Fintype.card (Ranks (shape a b))-
          (Fintype.card (Ranks (shape a b))).choose 2)) =
      if a=4 ∨ b=4 then 2 else 3 := by
  rw [card_cells_shape,card_sortedPairs_shape,card_ranks_shape]
  rcases hex with ⟨rfl,hb⟩ | ⟨rfl,ha⟩
  · rcases hb with rfl | rfl | rfl <;> norm_num [Nat.choose]
  · rcases ha with rfl | rfl | rfl <;> norm_num [Nat.choose]

/-- The exact exceptional defect at a general actual Artinian reduction,
including transposed formats and every characteristic. -/
theorem exceptional_certificate (a b : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hex : TwoFactorInjectivity.Exceptional a b) :
    ∃ f : MvPolynomial (Cell (shape a b) × Option (Ranks (shape a b))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell (shape a b)) (Option (Ranks (shape a b))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) ∧
          Module.finrank K (LinearMap.ker
            (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) =
              if a=4 ∨ b=4 then 2 else 3 := by
  obtain ⟨ℓ,hℓ⟩ := exceptional_surjective_witness (K := K) a b hex
  obtain ⟨f,hf,hw⟩ := surjective_certificate_of_rank_witnesses
    (independent_enlarged_family (K := K) a b (by omega) (by omega))
    ⟨enlarge ℓ,rank_of_surjective ℓ hℓ⟩
  refine ⟨f,hf,?_⟩
  intro A hA
  obtain ⟨hfin,hart,hcol,hbase,hs⟩ := hw A hA
  letI := hfin
  refine ⟨hfin,hart,hcol,hs,?_⟩
  rw [finrank_kernel_of_surjective A hcol hbase hs]
  exact exceptional_numeric_defect a b hex

include K in
theorem one_numeric_dimensions (b : ℕ) :
    Fintype.card (SortedPair (shape 1 b))-
      (Fintype.card (Cell (shape 1 b))*Fintype.card (Ranks (shape 1 b))-
        (Fintype.card (Ranks (shape 1 b))).choose 2)=0 := by
  simpa only [card_ranks_shape,sideSum_shape] using
    (ActualQuotient.finrank_actualDegreeTwo (K := K) (n := shape 1 b)).symm.trans
      (finrank_degreeTwo_one (K := K) b)

/-- With a projective-line factor, the actual A2 vanishes at general parameter
choices, and every linear form is surjective onto that zero component. -/
theorem one_certificate (b : ℕ) (hb : 1 ≤ b) :
    ∃ f : MvPolynomial (Cell (shape 1 b) × Option (Ranks (shape 1 b))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell (shape 1 b)) (Option (Ranks (shape 1 b))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          GeneralQuotient.actualDegreeTwo (oldForms A)=⊥ ∧
          ∀ ℓ : degreeOne (K := K) (n := shape 1 b),
            Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) ℓ) := by
  let ℓ : degreeOne (K := K) (n := shape 1 b) := 0
  have hs := every_form_surjective (K := K) b ℓ
  obtain ⟨f,hf,hw⟩ := surjective_certificate_of_rank_witnesses
    (independent_enlarged_family (K := K) 1 b (by omega) hb)
    ⟨enlarge ℓ,rank_of_surjective ℓ hs⟩
  refine ⟨f,hf,?_⟩
  intro A hA
  obtain ⟨hfin,hart,hcol,hbase,_⟩ := hw A hA
  letI := hfin
  have hz : GeneralQuotient.actualDegreeTwo (oldForms A)=⊥ := by
    apply Submodule.finrank_eq_zero.mp
    rw [GeneralQuotient.finrank_actualDegreeTwo,hbase]
    exact one_numeric_dimensions (K := K) b
  refine ⟨hfin,hart,hcol,hz,?_⟩
  intro ℓ y
  have hy : y.val ∈ (⊥ : Submodule K (GeneralParameters.Reduction (oldForms A))) := by
    simpa only [hz] using y.property
  have hy0 : y=0 := Subtype.ext ((Submodule.mem_bot K).mp hy)
  exact ⟨0,(GeneralQuotient.firstLefschetz (oldForms A) ℓ).map_zero.trans hy0.symm⟩

include K in
theorem line_numeric_dimensions (a b : ℕ) (hline : a=1 ∨ b=1) :
    Fintype.card (SortedPair (shape a b))-
      (Fintype.card (Cell (shape a b))*Fintype.card (Ranks (shape a b))-
        (Fintype.card (Ranks (shape a b))).choose 2)=0 := by
  rcases hline with rfl | rfl
  · exact one_numeric_dimensions (K := K) b
  · have h := one_numeric_dimensions (K := K) a
    simpa only [card_cells_shape,card_sortedPairs_shape,card_ranks_shape,
      Nat.mul_comm,Nat.add_comm] using h

/-- Both orders of the projective-line case, with vanishing of the entire A2
and the exact kernel dimension for every form in that general reduction. -/
theorem line_certificate (a b : ℕ) (ha : 1 ≤ a) (hb : 1 ≤ b) (hline : a=1 ∨ b=1) :
    ∃ f : MvPolynomial (Cell (shape a b) × Option (Ranks (shape a b))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell (shape a b)) (Option (Ranks (shape a b))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (oldForms A).vecMul ∧
          GeneralQuotient.actualDegreeTwo (oldForms A)=⊥ ∧
          ∀ ℓ : degreeOne (K := K) (n := shape a b),
            Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) ℓ) ∧
            Module.finrank K (LinearMap.ker (GeneralQuotient.firstLefschetz (oldForms A) ℓ))=a*b := by
  have hwitness : ∃ ℓ : degreeOne (K := K) (n := shape a b),
      Function.Surjective (ActualQuotient.firstLefschetz ℓ) := by
    rcases hline with rfl | rfl
    · exact ⟨0,every_form_surjective b 0⟩
    · exact TwoFactorTranspose.exists_surjective_transpose 1 a
        ⟨0,every_form_surjective (K := K) a 0⟩
  obtain ⟨ℓ,hℓ⟩ := hwitness
  obtain ⟨f,hf,hw⟩ := surjective_certificate_of_rank_witnesses
    (independent_enlarged_family (K := K) a b ha hb)
    ⟨enlarge ℓ,rank_of_surjective ℓ hℓ⟩
  refine ⟨f,hf,?_⟩
  intro A hA
  obtain ⟨hfin,hart,hcol,hbase,_⟩ := hw A hA
  letI := hfin
  have hd₂ : Module.finrank K (GeneralQuotient.actualDegreeTwo (oldForms A))=0 := by
    rw [GeneralQuotient.finrank_actualDegreeTwo,hbase]
    exact line_numeric_dimensions (K := K) a b hline
  have hz : GeneralQuotient.actualDegreeTwo (oldForms A)=⊥ := Submodule.finrank_eq_zero.mp hd₂
  have hd₁ : Module.finrank K (GeneralQuotient.actualDegreeOne (oldForms A))=a*b := by
    rw [GeneralQuotient.finrank_actualDegreeOne _ hcol,card_cells_shape,card_ranks_shape]
    have h : (a+1)*(b+1)=a*b+(a+b+1) := by ring
    rw [h,Nat.add_sub_cancel]
  refine ⟨hfin,hart,hcol,hz,?_⟩
  intro ℓ
  have hs : Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) ℓ) := by
    intro y
    have hy : y.val ∈ (⊥ : Submodule K (GeneralParameters.Reduction (oldForms A))) := by
      simpa only [hz] using y.property
    have hy0 : y=0 := Subtype.ext ((Submodule.mem_bot K).mp hy)
    exact ⟨0,(GeneralQuotient.firstLefschetz (oldForms A) ℓ).map_zero.trans hy0.symm⟩
  refine ⟨hs,?_⟩
  have hn := (GeneralQuotient.firstLefschetz (oldForms A) ℓ).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hs,finrank_top,hd₂,zero_add,hd₁] at hn
  exact hn

noncomputable def kernelDefect (a b : ℕ) : ℕ := by
  classical
  exact if a=1 ∨ b=1 then a*b else
    if TwoFactorInjectivity.Exceptional a b then (if a=4 ∨ b=4 then 2 else 3) else 0

/-- The complete two-factor clause of Theorem1.1, with arbitrary positive
factor dimensions and exactly the stated defects. -/
theorem positive_two_firstLefschetz_certificate (a b : ℕ) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    ∃ f : MvPolynomial (Cell (shape a b) × Option (Ranks (shape a b))) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell (shape a b)) (Option (Ranks (shape a b))) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          (Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) ∨
            Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) ∧
          Module.finrank K (LinearMap.ker
            (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)))=kernelDefect a b := by
  classical
  by_cases hline : a=1 ∨ b=1
  · obtain ⟨f,hf,hw⟩ := line_certificate (K := K) a b ha hb hline
    refine ⟨f,hf,?_⟩
    intro A hA
    obtain ⟨hfin,hart,hcol,hzero,hforms⟩ := hw A hA
    have hp := hforms (lefschetzForm A)
    exact ⟨hfin,hart,Or.inr hp.1,by simpa only [kernelDefect,if_pos hline] using hp.2⟩
  · have ha2 : 2 ≤ a := by omega
    have hb2 : 2 ≤ b := by omega
    by_cases hex : TwoFactorInjectivity.Exceptional a b
    · obtain ⟨f,hf,hw⟩ := exceptional_certificate (K := K) a b ha2 hb2 hex
      refine ⟨f,hf,?_⟩
      intro A hA
      obtain ⟨hfin,hart,hcol,hs,hker⟩ := hw A hA
      exact ⟨hfin,hart,Or.inr hs,by
        simpa only [kernelDefect,if_neg hline,if_pos hex] using hker⟩
    · obtain ⟨f,hf,hw⟩ := injective_certificate (K := K) a b ha2 hb2 hex
      refine ⟨f,hf,?_⟩
      intro A hA
      obtain ⟨hfin,hart,hcol,hi⟩ := hw A hA
      refine ⟨hfin,hart,Or.inl hi,?_⟩
      rw [LinearMap.ker_eq_bot.mpr hi]
      simp only [finrank_bot,kernelDefect,if_neg hline,if_neg hex]

end PaperVerification.Segre.TwoFactorGeneric
end
end ProbeLayer102

section ProbeLayer103



/-!
# The complete three-factor first Lefschetz statement

The actual generic Artinian quotient has zero first-Lefschetz kernel except at
permutations of `(1,1,1)`, `(1,1,2)` and `(1,1,3)`. At those triples the actual map
is surjective and its kernel dimensions are respectively `3`, `3` and `1`.
The nonexceptional lengths are unrestricted.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.ThreeFactorLefschetz

open Staircase Monomials RankParameters GenericFirstLefschetz GenericSurjectivity
open ChainClassification ThreeChainCores Matrix

variable {K : Type*} [Field K]

noncomputable def sortedPairReindex (n : Fin 3 → ℕ) (e : Equiv.Perm (Fin 3)) :
    SortedPair (fun i => n (e i)) ≃ SortedPair n where
  toFun q := ⟨(reindexCell n e q.val.1,reindexCell n e q.val.2),
    (reindexCell n e).monotone q.property⟩
  invFun q := ⟨((reindexCell n e).symm q.val.1,(reindexCell n e).symm q.val.2),
    (reindexCell n e).symm.monotone q.property⟩
  left_inv q := by apply Subtype.ext; simp only [OrderIso.symm_apply_apply]
  right_inv q := by apply Subtype.ext; simp only [OrderIso.apply_symm_apply]

/-- On the exact exceptional list, the quotient Hilbert values give exactly
the kernel dimensions printed in Theorem 1.1. -/
theorem exceptional_card_expression (n : Fin 3 → ℕ) (hex : ExceptionalTriple n) :
    (Fintype.card (Cell n) - Fintype.card (Ranks n)) -
      (Fintype.card (SortedPair n) -
        (Fintype.card (Cell n) * Fintype.card (Ranks n) - (Fintype.card (Ranks n)).choose 2)) =
      if sideSum n ≤ 4 then 3 else 1 := by
  obtain ⟨e,he⟩ := hex
  have hc := Fintype.card_congr (reindexCell n e).toEquiv
  have hq := Fintype.card_congr (sortedPairReindex n e)
  have hs := sideSum_reindex n e
  simp only [Ranks,Fintype.card_fin]
  rw [← hc,← hq,← hs]
  rcases he with he | he | he <;> rw [he] <;> decide

/-- The exceptional actual quotient is generically surjective, with the
specified exact kernel dimension and no extra regularity premise. -/
theorem exceptional_certificate [Infinite K] (n : Fin 3 → ℕ)
    (hex : ExceptionalTriple n) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) ∧
          Module.finrank K (LinearMap.ker
            (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) =
              if sideSum n ≤ 4 then 3 else 1 := by
  have hcol : ∃ A : Matrix (Cell n) (Option (Ranks n)) K, Function.Surjective A.vecMul := by
    obtain ⟨p,hp,_⟩ := exceptional_stressFree (K := K) n hex
    exact ⟨augmentedPlacement p,augmented_surjective_of_affineSpan p hp⟩
  obtain ⟨f,hf,hw⟩ := surjective_certificate_of_rank_witnesses hcol
    (StressMultiplication.exceptional_actual_surjective (K := K) n hex)
  refine ⟨f,hf,?_⟩
  intro A hA
  obtain ⟨hfin,hart,hcol,hr,hs⟩ := hw A hA
  letI := hfin
  refine ⟨hfin,hart,hs,?_⟩
  rw [finrank_kernel_of_surjective A hcol hr hs,exceptional_card_expression n hex]

/-- Exact first-Lefschetz defect for positive triples. The exceptional predicate
is independently specified by literal factor permutations. -/
noncomputable def kernelDefect (n : Fin 3 → ℕ) : ℕ := by
  classical
  exact if ExceptionalTriple n then (if sideSum n ≤ 4 then 3 else 1) else 0

/-- The full three-factor branch, with every positive chain length allowed and
all characteristics included, stated using an explicit genericity certificate. -/
theorem positive_three_firstLefschetz_certificate [Infinite K]
    (n : Fin 3 → ℕ) (hpos : ∀ i, 1 ≤ n i) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          (Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) ∨
            Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) ∧
          Module.finrank K (LinearMap.ker
            (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) = kernelDefect n := by
  classical
  by_cases hex : ExceptionalTriple n
  · obtain ⟨f,hf,hw⟩ := exceptional_certificate (K := K) n hex
    refine ⟨f,hf,?_⟩
    intro A hA
    obtain ⟨hfin,hart,hs,hker⟩ := hw A hA
    exact ⟨hfin,hart,Or.inr hs,by simpa only [kernelDefect,if_pos hex] using hker⟩
  · obtain ⟨f,hf,hw⟩ := injective_certificate_of_rigid
      (positive_three_nonexceptional (K := K) n hpos hex)
    refine ⟨f,hf,?_⟩
    intro A hA
    obtain ⟨hfin,hart,hcol,hi⟩ := hw A hA
    refine ⟨hfin,hart,Or.inl hi,?_⟩
    rw [LinearMap.ker_eq_bot.mpr hi]
    simp only [finrank_bot,kernelDefect,if_neg hex]

end PaperVerification.Segre.ThreeFactorLefschetz
end
end ProbeLayer103

section ProbeLayer104



/-!
# The full first Lefschetz theorem for Segre rings

Every positive tuple and every infinite ground field are included. The exact
defect function lists the two-factor exceptions, the projective-line cases,
and the three-factor exceptions up to an actual factor permutation. General
parameters and general forms in the actual A1 are separate quantified opens.

The one-factor algebra-isomorphism clause and the projective-line A2-vanishing
clause are provided separately below, retaining the full statements in the
paper in addition to the maximal-rank assertion.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

@[expose] public section

namespace PaperVerification.Segre.Principal

open Staircase Monomials RankParameters GenericFirstLefschetz

variable {K : Type*} [Field K] [Infinite K]

omit [Infinite K] in
/-- In finite dimensions, the injective-or-surjective condition used below is
exactly the usual maximal-rank equality. This verifies the statement-level
reformulation independently of the Segre proof. -/
theorem maximal_rank_iff {V W : Type*} [AddCommGroup V] [Module K V]
    [AddCommGroup W] [Module K W] [Module.Finite K V] [Module.Finite K W]
    (f : V →ₗ[K] W) :
    Module.finrank K (LinearMap.range f) =
        min (Module.finrank K V) (Module.finrank K W) ↔
      Function.Injective f ∨ Function.Surjective f := by
  constructor
  · intro h
    by_cases hdim : Module.finrank K V ≤ Module.finrank K W
    · left
      apply LinearMap.ker_eq_bot.mp
      apply Submodule.finrank_eq_zero.mp
      have hnull := f.finrank_range_add_finrank_ker
      rw [h, min_eq_left hdim] at hnull
      omega
    · right
      apply LinearMap.range_eq_top.mp
      apply Submodule.eq_top_of_finrank_eq
      exact h.trans (min_eq_right (le_of_lt (lt_of_not_ge hdim)))
  · rintro (hinj | hsurj)
    · rw [LinearMap.finrank_range_of_inj hinj]
      exact (min_eq_left (LinearMap.finrank_le_finrank_of_injective hinj)).symm
    · rw [LinearMap.range_eq_top.mpr hsurj, finrank_top]
      exact (min_eq_right (LinearMap.finrank_le_finrank_of_surjective hsurj)).symm

/-- The literal defect list in Theorem1.1, with no bounded-parameter convention. -/
noncomputable def kernelDefect (k : ℕ) (n : Fin k → ℕ) : ℕ := by
  classical
  exact if h : k=2 then
    TwoFactorGeneric.kernelDefect (n (Fin.cast h.symm (0 : Fin 2)))
      (n (Fin.cast h.symm (1 : Fin 2)))
    else if h : k=3 then
      ThreeFactorLefschetz.kernelDefect (fun i => n (Fin.cast h.symm i))
    else 0

/-- A coefficient-space certificate for the complete positive-tuple theorem.
Every principal algebraic branch is included in this single statement. -/
theorem joint_firstLefschetz_certificate (k : ℕ) (hk : 1 ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i) :
    ∃ f : MvPolynomial (Cell n × Option (Ranks n)) K, f ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Option (Ranks n)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms A)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms A)) ∧
          (Function.Injective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)) ∨
            Function.Surjective (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A))) ∧
          Module.finrank K (LinearMap.ker
            (GeneralQuotient.firstLefschetz (oldForms A) (lefschetzForm A)))=kernelDefect k n := by
  classical
  by_cases h₁ : k=1
  · subst k
    simpa only [kernelDefect,dif_neg (show (1 : ℕ)≠2 by omega),
      dif_neg (show (1 : ℕ)≠3 by omega)] using OneFactorActual.one_factor_joint_certificate (K := K) n
  · by_cases h₂ : k=2
    · subst k
      have he : TwoFactorActual.shape (n 0) (n 1)=n := by
        funext i
        fin_cases i <;> rfl
      have h := TwoFactorGeneric.positive_two_firstLefschetz_certificate
        (K := K) (n 0) (n 1) (hpos 0) (hpos 1)
      rw [show kernelDefect 2 n=TwoFactorGeneric.kernelDefect (n 0) (n 1) by
        simp [kernelDefect]]
      exact he ▸ h
    · by_cases h₃ : k=3
      · subst k
        simpa [kernelDefect] using
          ThreeFactorLefschetz.positive_three_firstLefschetz_certificate (K := K) n hpos
      · have hk3 : 3 ≤ k := by omega
        obtain ⟨f,hf,hw⟩ := positive_nonexceptional_injective_certificate
          (K := K) k hk3 n hpos (fun h => False.elim (h₃ h))
        refine ⟨f,hf,?_⟩
        intro A hA
        obtain ⟨hfin,hart,hcol,hi⟩ := hw A hA
        refine ⟨hfin,hart,Or.inl hi,?_⟩
        rw [LinearMap.ker_eq_bot.mpr hi]
        simp only [finrank_bot,kernelDefect,dif_neg h₂,dif_neg h₃]

/-- Theorem1.1: for general linear Artinian parameters and then for general
ℓ in the actual quotient A1, multiplication A1→A2 has maximal rank and exactly
the paper's kernel dimension. Both generic quantifiers are witnessed by
nonzero polynomials in the appropriate spaces, with no additional hypothesis. -/
theorem theorem_1_1_first_lefschetz (k : ℕ) (hk : 1 ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i) :
    ∃ g : MvPolynomial (Cell n × Ranks n) K, g ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction A) ∧
          IsArtinianRing (GeneralParameters.Reduction A) ∧
          ActualGenericity.GenericActualForms A (fun ℓ =>
            (Function.Injective (ActualGenericity.firstLefschetz A ℓ) ∨
              Function.Surjective (ActualGenericity.firstLefschetz A ℓ)) ∧
            Module.finrank K (LinearMap.ker (ActualGenericity.firstLefschetz A ℓ))=kernelDefect k n) := by
  apply ActualGenericity.iterated_certificate
  obtain ⟨f,hf,hw⟩ := joint_firstLefschetz_certificate (K := K) k hk n hpos
  refine ⟨f,hf,?_⟩
  intro B hB
  obtain ⟨hfin,hart,hr,hker⟩ := hw B hB
  have heq := ActualGenericity.firstLefschetz_lift (oldForms B) (lefschetzForm B)
  refine ⟨hfin,hart,?_,?_⟩
  · simpa only [heq] using hr
  · exact (congrArg (fun L : GeneralQuotient.actualDegreeOne (oldForms B) →ₗ[K]
        GeneralQuotient.actualDegreeTwo (oldForms B) =>
        Module.finrank K (LinearMap.ker L)) heq).trans hker

/-- The same principal theorem with “maximal rank” written literally as the
minimum of the two actual homogeneous dimensions. Finiteness is derived from
the parameter certificate, not added as a hypothesis. -/
theorem theorem_1_1_first_lefschetz_rank (k : ℕ) (hk : 1 ≤ k)
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i) :
    ∃ g : MvPolynomial (Cell n × Ranks n) K, g ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction A) ∧
          IsArtinianRing (GeneralParameters.Reduction A) ∧
          ActualGenericity.GenericActualForms A (fun ℓ =>
            Module.finrank K (LinearMap.range (ActualGenericity.firstLefschetz A ℓ)) =
              min (Module.finrank K (GeneralQuotient.actualDegreeOne A))
                (Module.finrank K (GeneralQuotient.actualDegreeTwo A)) ∧
            Module.finrank K (LinearMap.ker (ActualGenericity.firstLefschetz A ℓ)) =
              kernelDefect k n) := by
  obtain ⟨g, hg, hw⟩ := theorem_1_1_first_lefschetz (K := K) k hk n hpos
  refine ⟨g, hg, ?_⟩
  intro A hA
  obtain ⟨hfin, hart, b, h, hh, hproperty⟩ := hw A hA
  letI := hfin
  refine ⟨hfin, hart, b, h, hh, ?_⟩
  intro c hc
  obtain ⟨hmax, hker⟩ := hproperty c hc
  exact ⟨(maximal_rank_iff _).mpr hmax, hker⟩

/-- The full k=1 algebra statement of Theorem1.1. -/
theorem theorem_1_1_one_factor (n : Fin 1 → ℕ) :
    ∃ g : MvPolynomial (Cell n × Ranks n) K, g ≠ 0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) K,
        MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 →
          Nonempty (GeneralParameters.Reduction A ≃ₐ[K] K) :=
  OneFactor.one_factor_certificate (K := K) n

/-- The full projective-line clause A2=0, for both factor orders and every
positive other dimension, at general old parameter choices. -/
theorem theorem_1_1_projective_line (a b : ℕ) (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hline : a=1 ∨ b=1) :
    ∃ g : MvPolynomial (Cell (TwoFactorActual.shape a b) × Ranks (TwoFactorActual.shape a b)) K,
      g ≠ 0 ∧ ∀ A : Matrix (Cell (TwoFactorActual.shape a b)) (Ranks (TwoFactorActual.shape a b)) K,
        MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction A) ∧
          IsArtinianRing (GeneralParameters.Reduction A) ∧
          GeneralQuotient.actualDegreeTwo A=⊥ := by
  have hcert : ∃ f : MvPolynomial (Cell (TwoFactorActual.shape a b) ×
        Option (Ranks (TwoFactorActual.shape a b))) K, f ≠ 0 ∧
      ∀ B : Matrix (Cell (TwoFactorActual.shape a b)) (Option (Ranks (TwoFactorActual.shape a b))) K,
        MvPolynomial.eval (fun j => B j.1 j.2) f ≠ 0 →
          Module.Finite K (GeneralParameters.Reduction (oldForms B)) ∧
          IsArtinianRing (GeneralParameters.Reduction (oldForms B)) ∧
          GeneralQuotient.actualDegreeTwo (oldForms B)=⊥ := by
    obtain ⟨f,hf,hw⟩ := TwoFactorGeneric.line_certificate (K := K) a b ha hb hline
    exact ⟨f,hf,fun B hB => by
      obtain ⟨hfin,hart,hcol,hzero,_⟩ := hw B hB
      exact ⟨hfin,hart,hzero⟩⟩
  obtain ⟨g,hg,hw⟩ := ActualGenericity.iterated_certificate
    (fun A _ => GeneralQuotient.actualDegreeTwo A=⊥) hcert
  refine ⟨g,hg,?_⟩
  intro A hA
  obtain ⟨hfin,hart,basis,h,hh,hproperty⟩ := hw A hA
  obtain ⟨c,hc⟩ := GenericMatrixRank.exists_eval_ne_zero h hh
  exact ⟨hfin,hart,hproperty c hc⟩

end PaperVerification.Segre.Principal
end
end ProbeLayer104

section ProbeLayer105




/-!
# Theorem 1.1 in the paper's actual direct sum of symmetric tensor powers

The preceding principal endpoint uses the canonical balanced-polynomial
realization. This file transports it to the complete external direct sum
written in the paper, including the whole quotient algebra, both homogeneous
pieces, the actual multiplication map and genericity on the actual quotient
space. The transport uses the proved canonical algebra isomorphism throughout.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000

@[expose] public section

namespace PaperVerification.Segre.SymmetricPrincipal

open Staircase Monomials RankParameters SymmetricRealization

variable {I D : Type*} [Fintype I] [DecidableEq I] [Nonempty I]
  [Fintype D] [DecidableEq D] {n : I → ℕ}
variable {F : Type} [Field F]

/-- General forms are defined in coordinates of a basis of the entire actual
first homogeneous piece of the symmetric-tensor quotient. -/
def GenericSymmetricForms (A : Matrix (Cell n) D F)
    (P : symmetricActualPiece A 1 → Prop) : Prop :=
  ∃ b : Module.Basis (Fin (Module.finrank F (symmetricActualPiece A 1))) F
      (symmetricActualPiece A 1),
    ∃ h : MvPolynomial (Fin (Module.finrank F (symmetricActualPiece A 1))) F,
      h≠0 ∧ ∀ c : Fin (Module.finrank F (symmetricActualPiece A 1)) → F,
        MvPolynomial.eval c h≠0 → P (∑ i,c i • b i)

/-- A certified polynomial open contains an actual symmetric-tensor quotient
form over an infinite field. -/
theorem GenericSymmetricForms.exists [Infinite F]
    {A : Matrix (Cell n) D F} {P : symmetricActualPiece A 1 → Prop}
    (hP : GenericSymmetricForms A P) : ∃ ℓ : symmetricActualPiece A 1, P ℓ := by
  classical
  obtain ⟨b,h,hh,hw⟩ := hP
  obtain ⟨c,hc⟩ := GenericMatrixRank.exists_eval_ne_zero h hh
  exact ⟨∑ i,c i • b i,hw c hc⟩

/-- A nonempty polynomial open is preserved by the canonical full degree-one
linear equivalence, with an explicit reindexing of the two finite bases. -/
theorem generic_forms_transport (A : Matrix (Cell n) D F)
    (P : GeneralQuotient.actualDegreeOne A → Prop)
    (hP : ActualGenericity.GenericActualForms A P) :
    GenericSymmetricForms A (fun ℓ => P (symmetricActualOneEquiv A ℓ)) := by
  classical
  obtain ⟨b,h,hh,hw⟩ := hP
  let e := symmetricActualOneEquiv A
  let E : Fin (Module.finrank F (symmetricActualPiece A 1)) ≃
      Fin (Module.finrank F (GeneralQuotient.actualDegreeOne A)) :=
    finCongr e.finrank_eq
  let b' := (b.map e.symm).reindex E.symm
  let h' := MvPolynomial.rename E.symm h
  have hh' : h'≠0 := by
    intro hz
    apply hh
    apply MvPolynomial.rename_injective E.symm E.symm.injective
    simpa only [map_zero] using hz
  refine ⟨b',h',hh',?_⟩
  intro c hc
  have he : e (∑ i,c i • b' i)=∑ j,c (E.symm j) • b j := by
    calc
      e (∑ i,c i • b' i) = ∑ i,e (c i • b' i) :=
        map_sum e.toAddEquiv (fun i => c i • b' i) Finset.univ
      _ = ∑ i,c i • b (E i) := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [LinearEquiv.map_smul e (c i) (b' i)]
        simp only [b',Module.Basis.reindex_apply,Module.Basis.map_apply,
          Equiv.symm_symm,LinearEquiv.apply_symm_apply]
      _ = ∑ j,c (E.symm j) • b j := by
        simpa only [Equiv.symm_apply_apply] using
          Equiv.sum_comp E (fun j => c (E.symm j) • b j)
  have hc' : MvPolynomial.eval (fun j => c (E.symm j)) h≠0 := by
    simpa only [h',MvPolynomial.eval_rename,Function.comp_def] using hc
  change P (e (∑ i,c i • b' i))
  rw [he]
  exact hw _ hc'

/-- The complete first-Lefschetz assertion for the literal direct sum of
actual symmetric powers displayed in Theorem 1.1. `NeZero k` is exactly the
positive number-of-factors condition; no factor size or characteristic is bounded. -/
theorem theorem_1_1_symmetric [Infinite F] (k : ℕ) [NeZero k]
    (n : Fin k → ℕ) (hpos : ∀ i,1≤n i) :
    ∃ g : MvPolynomial (Cell n × Ranks n) F,g≠0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) F,
        MvPolynomial.eval (fun j => A j.1 j.2) g≠0 →
          Module.Finite F (SymmetricReduction A) ∧ IsArtinianRing (SymmetricReduction A) ∧
          GenericSymmetricForms A (fun ℓ =>
            (Function.Injective (symmetricFirstLefschetz A ℓ) ∨
              Function.Surjective (symmetricFirstLefschetz A ℓ)) ∧
            Module.finrank F (LinearMap.ker (symmetricFirstLefschetz A ℓ))=
              Principal.kernelDefect k n) := by
  have hk : 1≤k := Nat.one_le_iff_ne_zero.mpr (NeZero.ne k)
  obtain ⟨g,hg,hw⟩ := Principal.theorem_1_1_first_lefschetz (K := F) k hk n hpos
  refine ⟨g,hg,?_⟩
  intro A hA
  obtain ⟨hfin,hart,hgeneric⟩ := hw A hA
  letI := hfin
  have hsymfin : Module.Finite F (SymmetricReduction A) :=
    Module.Finite.of_surjective (symmetricReductionEquiv A).symm.toLinearMap
      (symmetricReductionEquiv A).symm.surjective
  have hsymart : IsArtinianRing (SymmetricReduction A) := by
    letI := hsymfin
    exact IsArtinianRing.of_finite F _
  refine ⟨hsymfin,hsymart,?_⟩
  obtain ⟨b,h,hh,hproperty⟩ := generic_forms_transport A _ hgeneric
  refine ⟨b,h,hh,?_⟩
  intro c hc
  obtain ⟨hmax,hker⟩ := hproperty c hc
  refine ⟨?_,(finrank_firstLefschetz_kernel A _).trans hker⟩
  rcases hmax with hinj | hsurj
  · exact Or.inl ((firstLefschetz_injective_iff A _).mpr hinj)
  · exact Or.inr ((firstLefschetz_surjective_iff A _).mpr hsurj)

/-- The same literal symmetric-tensor theorem with maximal rank expressed
as the minimum of the two actual homogeneous dimensions.  Their finiteness
comes from the quotient certificate and is not an extra hypothesis. -/
theorem theorem_1_1_symmetric_rank [Infinite F] (k : ℕ) [NeZero k]
    (n : Fin k → ℕ) (hpos : ∀ i,1≤n i) :
    ∃ g : MvPolynomial (Cell n × Ranks n) F,g≠0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) F,
        MvPolynomial.eval (fun j => A j.1 j.2) g≠0 →
          Module.Finite F (SymmetricReduction A) ∧ IsArtinianRing (SymmetricReduction A) ∧
          GenericSymmetricForms A (fun ℓ =>
            Module.finrank F (LinearMap.range (symmetricFirstLefschetz A ℓ)) =
              min (Module.finrank F (symmetricActualPiece A 1))
                (Module.finrank F (symmetricActualPiece A 2)) ∧
            Module.finrank F (LinearMap.ker (symmetricFirstLefschetz A ℓ))=
              Principal.kernelDefect k n) := by
  obtain ⟨g,hg,hw⟩ := theorem_1_1_symmetric (F := F) k n hpos
  refine ⟨g,hg,?_⟩
  intro A hA
  obtain ⟨hfin,hart,b,h,hh,hproperty⟩ := hw A hA
  letI := hfin
  refine ⟨hfin,hart,b,h,hh,?_⟩
  intro c hc
  obtain ⟨hmax,hker⟩ := hproperty c hc
  exact ⟨(Principal.maximal_rank_iff _).mpr hmax,hker⟩

/-- Explicit nonvacuity of the full principal certificate.  The parameter
matrix and the form in the actual quotient both exist over every infinite
field; neither generic quantifier can hold through an empty parameter space. -/
theorem theorem_1_1_symmetric_nonempty [Infinite F] (k : ℕ) [NeZero k]
    (n : Fin k → ℕ) (hpos : ∀ i, 1 ≤ n i) :
    ∃ (A : Matrix (Cell n) (Ranks n) F) (ℓ : symmetricActualPiece A 1),
      Module.Finite F (SymmetricReduction A) ∧ IsArtinianRing (SymmetricReduction A) ∧
      Module.finrank F (LinearMap.range (symmetricFirstLefschetz A ℓ)) =
        min (Module.finrank F (symmetricActualPiece A 1))
          (Module.finrank F (symmetricActualPiece A 2)) ∧
      Module.finrank F (LinearMap.ker (symmetricFirstLefschetz A ℓ)) =
        Principal.kernelDefect k n := by
  obtain ⟨g, hg, hw⟩ := theorem_1_1_symmetric_rank (F := F) k n hpos
  obtain ⟨c, hc⟩ := GenericMatrixRank.exists_eval_ne_zero g hg
  let A : Matrix (Cell n) (Ranks n) F := fun u r => c (u, r)
  have hA : MvPolynomial.eval (fun j => A j.1 j.2) g ≠ 0 := by
    change MvPolynomial.eval c g ≠ 0
    exact hc
  obtain ⟨hfin, hart, hgeneric⟩ := hw A hA
  obtain ⟨ℓ, hℓ⟩ := GenericSymmetricForms.exists hgeneric
  exact ⟨A, ℓ, hfin, hart, hℓ⟩

/-- The complete one-factor quotient algebra is K also in the literal
symmetric-tensor presentation. -/
theorem theorem_1_1_symmetric_one_factor [Infinite F] (n : Fin 1 → ℕ) :
    ∃ g : MvPolynomial (Cell n × Ranks n) F,g≠0 ∧
      ∀ A : Matrix (Cell n) (Ranks n) F,
        MvPolynomial.eval (fun j => A j.1 j.2) g≠0 →
          Nonempty (SymmetricReduction A ≃ₐ[F] F) := by
  obtain ⟨g,hg,hw⟩ := Principal.theorem_1_1_one_factor (K := F) n
  refine ⟨g,hg,?_⟩
  intro A hA
  obtain ⟨e⟩ := hw A hA
  exact ⟨(symmetricReductionEquiv A).trans e⟩

/-- The full second homogeneous piece vanishes in each projective-line case,
with the same unrestricted parameter open and both factor orders. -/
theorem theorem_1_1_symmetric_projective_line [Infinite F]
    (a b : ℕ) (ha : 1≤a) (hb : 1≤b) (hline : a=1 ∨ b=1) :
    ∃ g : MvPolynomial (Cell (TwoFactorActual.shape a b) ×
      Ranks (TwoFactorActual.shape a b)) F,g≠0 ∧
      ∀ A : Matrix (Cell (TwoFactorActual.shape a b)) (Ranks (TwoFactorActual.shape a b)) F,
        MvPolynomial.eval (fun j => A j.1 j.2) g≠0 →
          symmetricActualPiece A 2=⊥ := by
  obtain ⟨g,hg,hw⟩ := Principal.theorem_1_1_projective_line (K := F) a b ha hb hline
  refine ⟨g,hg,?_⟩
  intro A hA
  obtain ⟨hfin,hart,hzero⟩ := hw A hA
  apply (Submodule.eq_bot_iff (symmetricActualPiece A 2)).mpr
  intro x hx
  have he : (symmetricActualTwoEquiv A ⟨x,hx⟩).val=0 := by
    have hm : (symmetricActualTwoEquiv A ⟨x,hx⟩).val ∈
        (⊥ : Submodule F (GeneralParameters.Reduction A)) := by
      simpa only [hzero] using (symmetricActualTwoEquiv A ⟨x,hx⟩).property
    exact (Submodule.mem_bot F).mp hm
  have he' : symmetricActualTwoEquiv A ⟨x,hx⟩=
      symmetricActualTwoEquiv A 0 := by
    rw [LinearEquiv.map_zero (symmetricActualTwoEquiv A)]
    exact Subtype.ext he
  exact congrArg Subtype.val ((symmetricActualTwoEquiv A).injective he')

end PaperVerification.Segre.SymmetricPrincipal
end
end ProbeLayer105

section ProbeLayer106



/-!
# The literal coefficient trace sends dual multiplication to the original tensor

The functional is the sum of the coefficients of products of coordinate squares
in the original factor polynomial ring. It is defined on actual polynomials,
then restricted to the actual balanced degree-two subspace. For every slice
matrix, not only a generic matrix, its image under dual multiplication is the
coefficient covector of the original tensor. This is the all-characteristic
trace identity needed for the final assertion of Proposition 2.1.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace PaperVerification.Segre.Trace

open Staircase Monomials Degeneration Matrix MvPolynomial
open scoped BigOperators Matrix

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- A pair sorts to a diagonal pair exactly when both original indices equal
that diagonal index. No coefficient field is involved in this fact. -/
theorem sortPair_eq_diagonal_iff (u v w : Cell n) :
    sortPair u v=⟨(w,w),le_rfl⟩ ↔ u=w ∧ v=w := by
  constructor
  · intro h
    have hlo := congrArg (fun q : SortedPair n => q.val.1) h
    have hhi := congrArg (fun q : SortedPair n => q.val.2) h
    change (fun i => min (u i) (v i)) = w at hlo
    change (fun i => max (u i) (v i)) = w at hhi
    constructor
    · funext i
      apply le_antisymm
      · rw [← congrFun hhi i]
        exact le_max_left _ _
      · rw [← congrFun hlo i]
        exact min_le_left _ _
    · funext i
      apply le_antisymm
      · rw [← congrFun hhi i]
        exact le_max_right _ _
      · rw [← congrFun hlo i]
        exact min_le_right _ _
  · rintro ⟨rfl,rfl⟩
    exact sortPair_of_le le_rfl

theorem cellExponent_pair_eq_diagonal_iff (u v w : Cell n) :
    cellExponent u+cellExponent v=cellExponent w+cellExponent w ↔ u=w ∧ v=w := by
  have hs : sortedExponent (sortPair u v)=cellExponent u+cellExponent v :=
    (cellExponent_sort u v).symm
  have hw : sortedExponent (⟨(w,w),le_rfl⟩ : SortedPair n)=cellExponent w+cellExponent w := rfl
  rw [← hs,← hw]
  exact sortedExponent_injective.eq_iff.trans (sortPair_eq_diagonal_iff u v w)

/-- Literal polynomial trace: collect exactly the monomials with a square in
each original factor. -/
def polynomialTrace : MvPolynomial (Variables n) K →ₗ[K] K :=
  ∑ u : Cell n, MvPolynomial.lcoeff K (cellExponent u+cellExponent u)

@[simp] theorem polynomialTrace_apply (f : MvPolynomial (Variables n) K) :
    polynomialTrace f=∑ u : Cell n, f.coeff (cellExponent u+cellExponent u) := by
  simp only [polynomialTrace,LinearMap.sum_apply,MvPolynomial.lcoeff_apply]

/-- On all pairs of Segre coordinate monomials, trace is the ordinary coordinate
Kronecker pairing. In particular no factorial or factor two is introduced. -/
theorem polynomialTrace_cell_product (u v : Cell n) :
    polynomialTrace (cellPolynomial (K := K) u*cellPolynomial v)=if u=v then 1 else 0 := by
  classical
  rw [polynomialTrace_apply]
  simp only [cellPolynomial,monomial_mul_monomial,mul_one,coeff_monomial,
    cellExponent_pair_eq_diagonal_iff]
  by_cases huv : u=v
  · subst v
    simp
  · have hn (w : Cell n) : ¬ (u=w ∧ v=w) := by
      rintro ⟨rfl,rfl⟩
      exact huv rfl
    simp only [hn,if_false,Finset.sum_const_zero]
    exact (if_neg huv).symm

/-- On a slice times a coordinate, trace recovers that exact tensor coefficient. -/
theorem polynomialTrace_slice_product (A : Matrix (Cell n) J K) (j : J) (v : Cell n) :
    polynomialTrace (segreForm A j*cellPolynomial v)=A v j := by
  classical
  simp only [segreForm,Finset.sum_mul,smul_mul_assoc,map_sum,map_smul,
    polynomialTrace_cell_product,smul_eq_mul,mul_ite,mul_one,mul_zero]
  simp

/-- The actual degree-two multiplication map, with full coefficient source and
values in the actual balanced polynomial subspace. -/
def actualMultiplication (A : Matrix (Cell n) J K) :
    (J × Cell n → K) →ₗ[K] degreeTwo (K := K) (n := n) where
  toFun c := ⟨∑ jv, c jv • (segreForm A jv.1*cellPolynomial jv.2),by
    apply Submodule.sum_mem
    intro jv _
    apply Submodule.smul_mem
    simp only [segreForm,Finset.sum_mul,smul_mul_assoc]
    apply Submodule.sum_mem
    intro u _
    apply Submodule.smul_mem
    exact Submodule.subset_span ⟨(u,jv.2),rfl⟩⟩
  map_add' c d := Subtype.ext (by
    simp only [Submodule.coe_add,Pi.add_apply,add_smul,Finset.sum_add_distrib])
  map_smul' c d := Subtype.ext (by
    simp only [Submodule.coe_smul,RingHom.id_apply,Pi.smul_apply,smul_eq_mul,
      mul_smul,Finset.smul_sum])

/-- The trace restricted to the complete actual degree-two Segre component. -/
def degreeTwoTrace : Module.Dual K (degreeTwo (K := K) (n := n)) :=
  polynomialTrace.comp (degreeTwo (K := K) (n := n)).subtype

/-- The original tensor as its coordinate covector under the specified
nondegenerate coordinate pairing. -/
def tensorCovector (A : Matrix (Cell n) J K) : Module.Dual K (J × Cell n → K) where
  toFun c := ∑ jv, A jv.2 jv.1*c jv
  map_add' c d := by simp only [Pi.add_apply,mul_add,Finset.sum_add_distrib]
  map_smul' c d := by
    simp only [RingHom.id_apply,Pi.smul_apply,smul_eq_mul,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro jv _
    ring

/-- The full map-level trace identity for actual Segre multiplication. -/
theorem dual_multiplication_trace (A : Matrix (Cell n) J K) :
    (actualMultiplication A).dualMap degreeTwoTrace=tensorCovector A := by
  apply LinearMap.ext
  intro c
  change polynomialTrace (∑ jv, c jv • (segreForm A jv.1*cellPolynomial jv.2))=
    ∑ jv, A jv.2 jv.1*c jv
  simp only [map_sum,map_smul,polynomialTrace_slice_product,smul_eq_mul]
  exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)

/-- Therefore the original tensor always belongs to the actual dual
multiplication image. This is a universal algebraic identity, with no genericity
or base-point assumption. -/
theorem tensorCovector_mem_dual_image (A : Matrix (Cell n) J K) :
    tensorCovector A ∈ LinearMap.range (actualMultiplication A).dualMap :=
  ⟨degreeTwoTrace,dual_multiplication_trace A⟩

/-- The covector retains every original coefficient, justifying the coordinate
pairing rather than losing tensor data in its definition. -/
@[simp] theorem tensorCovector_single (A : Matrix (Cell n) J K) (j : J) (v : Cell n) :
    tensorCovector A (Pi.single (j,v) 1)=A v j := by
  classical
  simp [tensorCovector,Pi.single_apply]

theorem tensorCovector_injective :
    Function.Injective (tensorCovector (K := K) (n := n) (J := J)) := by
  intro A B h
  ext v j
  have he := congrArg (fun f : Module.Dual K (J × Cell n → K) => f (Pi.single (j,v) 1)) h
  simpa only [tensorCovector_single] using he

/-- The coordinate pairing is linear in the tensor itself. -/
def tensorCovectorLinear : Matrix (Cell n) J K →ₗ[K] Module.Dual K (J × Cell n → K) where
  toFun := tensorCovector
  map_add' A B := by
    apply LinearMap.ext
    intro c
    change (∑ jv, (A jv.2 jv.1 + B jv.2 jv.1) * c jv) =
      (∑ jv, A jv.2 jv.1 * c jv) + ∑ jv, B jv.2 jv.1 * c jv
    simp only [add_mul, Finset.sum_add_distrib]
  map_smul' a A := by
    apply LinearMap.ext
    intro c
    change (∑ jv, (a * A jv.2 jv.1) * c jv) =
      a * ∑ jv, A jv.2 jv.1 * c jv
    simp only [Finset.mul_sum, mul_assoc]

/-- Every coordinate covector arises from exactly one tensor matrix. -/
def tensorCovectorEquiv : Matrix (Cell n) J K ≃ₗ[K] Module.Dual K (J × Cell n → K) :=
  LinearEquiv.ofBijective tensorCovectorLinear ⟨tensorCovector_injective,by
    intro f
    refine ⟨fun v j => f (Pi.single (j,v) 1),?_⟩
    apply LinearMap.ext
    intro c
    have hc : c=∑ jv, c jv • Pi.single jv (1 : K) := by
      funext jv
      simp [Pi.single_apply]
    change (∑ jv, f (Pi.single jv 1)*c jv)=f c
    conv_rhs => rw [hc]
    simp only [map_sum,map_smul,smul_eq_mul]
    exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)⟩

end PaperVerification.Segre.Trace
end
end
end ProbeLayer106

section ProbeLayer107



/-!
# The actual graph span is the actual dual multiplication image

Evaluation on tuples with every factor nonzero spans the entire dual of the
actual degree-two Segre component. Under the full coordinate pairing, dual
multiplication sends each evaluation to the literal rank-one graph tensor.
Consequently its image is exactly the graph span, with no base-point-freeness
or genericity assumption. The trace identity puts the original tensor in this
graph span over every infinite field.
-/

set_option autoImplicit false

@[expose] public section

noncomputable section

namespace PaperVerification.Segre.GraphSpan

open Staircase Monomials Degeneration Trace Matrix MvPolynomial
open scoped BigOperators

variable {I J K : Type*} [Fintype I] [DecidableEq I]
  [Fintype J] [DecidableEq J] [Field K] {n : I → ℕ}

/-- Actual affine representatives of the full product of projective factors. -/
def FactorPoint (n : I → ℕ) (K : Type*) [Zero K] :=
  {x : Variables n → K // ∀ i, ∃ j, x ⟨i,j⟩≠0}

/-- Evaluation, restricted to the full actual balanced quadratic subspace. -/
def evaluationCovector (x : Variables n → K) : Module.Dual K (degreeTwo (K := K) (n := n)) :=
  (MvPolynomial.aeval x).toLinearMap.comp (degreeTwo (K := K) (n := n)).subtype

theorem eval_cell_eq_prod (x : Variables n → K) (u : Cell n) :
    MvPolynomial.eval x (cellPolynomial (K := K) u)=∏ i, x ⟨i,u i⟩ := by
  rw [cellPolynomial_eq_prod,map_prod]
  simp only [MvPolynomial.eval_X]

/-- A vanished factor makes every actual balanced quadratic evaluate to zero. -/
theorem eval_degreeTwo_eq_zero_of_zero_factor (x : Variables n → K) (i : I)
    (hx : ∀ j, x ⟨i,j⟩=0) (f : degreeTwo (K := K) (n := n)) :
    MvPolynomial.eval x f.val=0 := by
  rcases f with ⟨f, hf⟩
  have hcell (u : Cell n) : MvPolynomial.eval x (cellPolynomial (K := K) u)=0 := by
    rw [eval_cell_eq_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ i) (hx (u i))
  change f ∈ Submodule.span K (Set.range
    (fun uv : Cell n × Cell n => cellPolynomial (K := K) uv.1*cellPolynomial uv.2)) at hf
  have hspan : Submodule.span K (Set.range
      (fun uv : Cell n × Cell n => cellPolynomial (K := K) uv.1 * cellPolynomial uv.2)) ≤
      LinearMap.ker (MvPolynomial.aeval x).toLinearMap := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨⟨u, v⟩, rfl⟩
    change MvPolynomial.eval x (cellPolynomial u * cellPolynomial v) = 0
    rw [map_mul,hcell,zero_mul]
  exact hspan hf

/-- Every nonzero actual balanced quadratic has a nonzero value at a tuple with
all factors nonzero. Infinite-field polynomial extensionality discharges the
existence assertion; nonvanishing of the factors is then a proved consequence. -/
theorem exists_nonzero_evaluation [Infinite K]
    (f : degreeTwo (K := K) (n := n)) (hf : f≠0) :
    ∃ x : FactorPoint n K, evaluationCovector x.val f≠0 := by
  have hn : f.val≠0 := by
    intro h
    exact hf (Subtype.ext h)
  obtain ⟨x,hx⟩ : ∃ x : Variables n → K, MvPolynomial.eval x f.val≠0 := by
    by_contra! h
    apply hn
    apply MvPolynomial.funext
    intro x
    rw [h x,map_zero]
  have hpoint : ∀ i, ∃ j, x ⟨i,j⟩≠0 := by
    intro i
    by_contra! hi
    exact hx (eval_degreeTwo_eq_zero_of_zero_factor x i hi f)
  exact ⟨⟨x,hpoint⟩,hx⟩

/-- The actual degree-two evaluations span its entire dual. -/
theorem span_evaluations_eq_top [Infinite K] :
    Submodule.span K (Set.range (fun x : FactorPoint n K => evaluationCovector x.val))=⊤ := by
  letI : Module.Finite K (degreeTwo (K := K) (n := n)) :=
    Module.Finite.of_basis (degreeTwoBasis (K := K) (n := n))
  apply Submodule.span_eq_top_of_ne_zero
  intro f hf
  obtain ⟨x,hx⟩ := exists_nonzero_evaluation f hf
  exact ⟨evaluationCovector x.val,⟨x,rfl⟩,hx⟩

/-- The graph tensor has coordinates `(tensor product of factor coordinates)
times the literal last contraction vector of slice evaluations. -/
def graphTensor (A : Matrix (Cell n) J K) (x : Variables n → K) : Matrix (Cell n) J K :=
  fun v j => MvPolynomial.eval x (cellPolynomial (K := K) v)*MvPolynomial.eval x (segreForm A j)

theorem graphTensor_apply (A : Matrix (Cell n) J K) (x : Variables n → K)
    (v : Cell n) (j : J) :
    graphTensor A x v j=(∏ i, x ⟨i,v i⟩)*
      (∑ u, A u j*(∏ i, x ⟨i,u i⟩)) := by
  rw [graphTensor,eval_cell_eq_prod]
  congr 1
  simp only [segreForm,map_sum]
  apply Finset.sum_congr rfl
  intro u _
  change MvPolynomial.aeval x (A u j • cellPolynomial u)=_
  rw [map_smul]
  change A u j*MvPolynomial.eval x (cellPolynomial u)=_
  rw [eval_cell_eq_prod]

/-- The whole coordinate covector of the graph tensor is the image of the whole
degree-two evaluation under the actual dual multiplication map. -/
theorem dual_multiplication_evaluation (A : Matrix (Cell n) J K) (x : Variables n → K) :
    (actualMultiplication A).dualMap (evaluationCovector x)=tensorCovector (graphTensor A x) := by
  apply LinearMap.ext
  intro c
  change MvPolynomial.aeval x
      (∑ jv, c jv • (segreForm A jv.1*cellPolynomial jv.2))=
    ∑ jv, graphTensor A x jv.2 jv.1*c jv
  simp only [map_sum,map_smul,map_mul,graphTensor,smul_eq_mul]
  apply Finset.sum_congr rfl
  intro jv _
  change c jv * (MvPolynomial.eval x (segreForm A jv.1) *
      MvPolynomial.eval x (cellPolynomial jv.2)) =
    (MvPolynomial.eval x (cellPolynomial jv.2) *
      MvPolynomial.eval x (segreForm A jv.1)) * c jv
  ring

/-- The actual image of dual multiplication in tensor coefficient space, using
the proved full coordinate pairing equivalence. -/
def dualMultiplicationImage (A : Matrix (Cell n) J K) : Submodule K (Matrix (Cell n) J K) :=
  (LinearMap.range (actualMultiplication A).dualMap).map tensorCovectorEquiv.symm.toLinearMap

/-- The graph span is the ordinary linear span of all its actual rank-one graph
tensors, using every nonzero-factor representative. -/
def graphSpan (A : Matrix (Cell n) J K) : Submodule K (Matrix (Cell n) J K) :=
  Submodule.span K (Set.range fun x : FactorPoint n K => graphTensor A x.val)

/-- Graph evaluations span precisely the actual dual multiplication image. -/
theorem graphSpan_eq_dualMultiplicationImage [Infinite K] (A : Matrix (Cell n) J K) :
    graphSpan A=dualMultiplicationImage A := by
  let f := tensorCovectorEquiv.symm.toLinearMap.comp (actualMultiplication A).dualMap
  have he (x : FactorPoint n K) : f (evaluationCovector x.val)=graphTensor A x.val := by
    change tensorCovectorEquiv.symm ((actualMultiplication A).dualMap
      (evaluationCovector x.val))=graphTensor A x.val
    rw [dual_multiplication_evaluation]
    exact tensorCovectorEquiv.symm_apply_apply _
  calc
    graphSpan A=Submodule.span K (Set.range fun x : FactorPoint n K => f (evaluationCovector x.val)) := by
      simp only [graphSpan,he]
    _=(Submodule.span K (Set.range fun x : FactorPoint n K => evaluationCovector x.val)).map f := by
      rw [Submodule.map_span,← Set.range_comp]
      rfl
    _=LinearMap.range f := by rw [span_evaluations_eq_top,Submodule.map_top]
    _=dualMultiplicationImage A := by rw [LinearMap.range_comp]; rfl

/-- The original tensor belongs to this literal graph span for every slice
matrix over an infinite field. The later singular-vector step must still show
that the critical equations cut out all relations on the singular zero scheme. -/
theorem tensor_mem_graphSpan [Infinite K] (A : Matrix (Cell n) J K) : A ∈ graphSpan A := by
  rw [graphSpan_eq_dualMultiplicationImage]
  refine ⟨tensorCovector A,tensorCovector_mem_dual_image A,?_⟩
  exact tensorCovectorEquiv.symm_apply_apply A

end PaperVerification.Segre.GraphSpan
end
end
end ProbeLayer107

section ProbeLayer108



/-!
# The Laurent-monomial contraction in the projective Čech complex

A Laurent monomial occurs on an intersection of coordinate charts exactly
when all its negative exponents belong to the tuple of inverted coordinates.
The usual alternating tuple differential therefore preserves this support
condition. Insertion of a coordinate with nonnegative exponent is an explicit
contracting homotopy. If every exponent is negative, all terms below the
number of coordinates vanish literally.

These are statements about the actual alternating tuple complex, including
its support condition. The comparison with sections of twisting sheaves is
a separate obligation; this file does not call this complex sheaf cohomology.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.CechMonomials

open scoped BigOperators

variable {I K : Type*} [CommRing K]

/-- Tuple length is used, so length zero is the augmentation term. -/
abbrev RawCochain (I K : Type*) (q : ℕ) := (Fin q → I) → K

/-- The literal alternating deletion differential. -/
noncomputable def differential (q : ℕ) : RawCochain I K q →ₗ[K] RawCochain I K (q+1) where
  toFun f a := ∑ j : Fin (q+1), (-1 : K) ^ j.val * f (a ∘ j.succAbove)
  map_add' f g := by
    funext a
    simp only [Pi.add_apply,mul_add,Finset.sum_add_distrib]
  map_smul' c f := by
    funext a
    simp only [Pi.smul_apply,smul_eq_mul,RingHom.id_apply]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring

@[simp] theorem differential_apply (q : ℕ) (f : RawCochain I K q)
    (a : Fin (q+1) → I) :
    differential q f a=∑ j : Fin (q+1), (-1 : K)^j.val*f (a ∘ j.succAbove) := rfl

private theorem deletion_sign_cancel (q : ℕ) (i : Fin (q+2)) (j : Fin (q+1)) :
    (-1 : K)^i.val * (-1 : K)^j.val +
      (-1 : K)^(i.succAbove j).val * (-1 : K)^(j.predAbove i).val = 0 := by
  by_cases h : j.castSucc < i
  · rw [Fin.succAbove_of_castSucc_lt _ _ h,Fin.predAbove_of_castSucc_lt _ _ h]
    simp only [Fin.val_castSucc,Fin.val_pred]
    have hp : i.val-1+1=i.val := by have hh : j.val < i.val := h; omega
    conv_lhs => lhs; lhs; rw [← hp,pow_succ]
    ring
  · have h' : i ≤ j.castSucc := le_of_not_gt h
    rw [Fin.succAbove_of_le_castSucc _ _ h',Fin.predAbove_of_le_castSucc _ _ h']
    simp only [Fin.val_succ,Fin.coe_castPred,pow_succ]
    ring

/-- The literal alternating deletion differential squares to zero. -/
theorem differential_squared (q : ℕ) (f : RawCochain I K q) :
    differential (q+1) (differential q f)=0 := by
  classical
  funext a
  simp only [differential_apply,Finset.mul_sum,Pi.zero_apply]
  rw [← Finset.sum_product',Finset.univ_product_univ]
  refine Finset.sum_involution
    (fun p _ => (p.1.succAbove p.2,p.2.predAbove p.1)) ?_ ?_ (fun _ _ => Finset.mem_univ _) ?_
  · rintro ⟨i,j⟩ _
    have he : (a ∘ (i.succAbove j).succAbove) ∘ (j.predAbove i).succAbove =
        (a ∘ i.succAbove) ∘ j.succAbove := by
      funext k
      simp only [Function.comp_apply,Fin.succAbove_succAbove_succAbove_predAbove]
    change (-1 : K)^i.val * ((-1 : K)^j.val * f ((a ∘ i.succAbove) ∘ j.succAbove)) +
      (-1 : K)^(i.succAbove j).val * ((-1 : K)^(j.predAbove i).val *
        f ((a ∘ (i.succAbove j).succAbove) ∘ (j.predAbove i).succAbove)) = 0
    rw [he,← mul_assoc,← mul_assoc,← add_mul,deletion_sign_cancel,zero_mul]
  · rintro ⟨i,j⟩ _ _ he
    exact Fin.succAbove_ne i j (congrArg Prod.fst he)
  · rintro ⟨i,j⟩ _
    simp only [Fin.succAbove_succAbove_predAbove,Fin.predAbove_predAbove_succAbove]

/-- Insertion of one coordinate is the Čech homotopy. -/
def contraction (v : I) (q : ℕ) : RawCochain I K (q+1) →ₗ[K] RawCochain I K q where
  toFun f a := f (Fin.cons v a)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem contraction_apply (v : I) (q : ℕ) (f : RawCochain I K (q+1))
    (a : Fin q → I) : contraction v q f a=f (Fin.cons v a) := rfl

/-- The contracting identity, over every commutative ring and in every degree. -/
theorem contraction_identity (v : I) (q : ℕ) (f : RawCochain I K (q+1)) :
    contraction v (q+1) (differential (q+1) f) +
      differential q (contraction v q f) = f := by
  funext a
  change (∑ j : Fin (q+2), (-1 : K)^j.val*f (Fin.cons v a ∘ j.succAbove)) +
    (∑ j : Fin (q+1), (-1 : K)^j.val*f (Fin.cons v (a ∘ j.succAbove))) = f a
  rw [Fin.sum_univ_succ]
  have hz : Fin.cons v a ∘ (0 : Fin (q+2)).succAbove = a := by
    funext j
    simp only [Function.comp_apply,Fin.zero_succAbove,Fin.cons_succ]
  rw [hz]
  simp only [Fin.val_zero,pow_zero,one_mul,Fin.val_succ,pow_succ,
    Fin.cons_comp_succ_succAbove]
  change f a + (∑ j : Fin (q+1), ((-1 : K)^j.val*(-1))*
    f (Fin.cons v (a ∘ j.succAbove))) +
      (∑ j : Fin (q+1), (-1 : K)^j.val*f (Fin.cons v (a ∘ j.succAbove))) = f a
  simp only [mul_neg_one,neg_mul,Finset.sum_neg_distrib]
  rw [add_assoc, neg_add_cancel, add_zero]

/-- Coefficients allowed only on tuples containing the negative support. -/
def supportedCochains (S : Set I) (q : ℕ) : Submodule K (RawCochain I K q) where
  carrier := {f | ∀ a, ¬ S ⊆ Set.range a → f a=0}
  zero_mem' := by intro a _; rfl
  add_mem' hf hg := by intro a ha; simp only [Pi.add_apply,hf a ha,hg a ha,add_zero]
  smul_mem' c f hf := by intro a ha; simp only [Pi.smul_apply,hf a ha,smul_zero]

theorem differential_mem_supported {S : Set I} {q : ℕ} {f : RawCochain I K q}
    (hf : f ∈ supportedCochains S q) :
    differential q f ∈ supportedCochains S (q+1) := by
  intro a ha
  rw [differential_apply]
  apply Finset.sum_eq_zero
  intro j _
  rw [hf (a ∘ j.succAbove) (by
    intro h
    apply ha
    intro x hx
    obtain ⟨k,hk⟩ := h hx
    exact ⟨j.succAbove k,hk⟩),mul_zero]

theorem contraction_mem_supported {S : Set I} (v : I) (hv : v ∉ S)
    {q : ℕ} {f : RawCochain I K (q+1)} (hf : f ∈ supportedCochains S (q+1)) :
    contraction v q f ∈ supportedCochains S q := by
  intro a ha
  apply hf
  intro h
  apply ha
  intro x hx
  obtain ⟨j,hj⟩ := h hx
  cases j using Fin.cases with
  | zero =>
    have he : v=x := hj
    exact False.elim (hv (he.symm ▸ hx))
  | succ k => exact ⟨k,hj⟩

/-- Every cocycle with proper negative support is a boundary in the augmented complex. -/
theorem exact_supported (S : Set I) (v : I) (hv : v ∉ S) (q : ℕ)
    (f : RawCochain I K (q+1)) (hf : f ∈ supportedCochains S (q+1))
    (hc : differential (q+1) f=0) :
    ∃ g : RawCochain I K q, g ∈ supportedCochains S q ∧ differential q g=f := by
  refine ⟨contraction v q f,contraction_mem_supported v hv hf,?_⟩
  have h := contraction_identity v q f
  simpa only [hc,map_zero,zero_add] using h

/-- The augmentation coefficient is zero whenever at least one exponent is negative. -/
theorem supported_zero_length {S : Set I} (hS : S.Nonempty)
    (f : RawCochain I K 0) (hf : f ∈ supportedCochains S 0) : f=0 := by
  funext a
  apply hf
  intro h
  obtain ⟨x,hx⟩ := hS
  obtain ⟨j,_⟩ := h hx
  exact Fin.elim0 j

/-- A proper nonempty negative support contributes no global cocycles. -/
theorem global_cocycle_eq_zero {S : Set I} (hS : S.Nonempty)
    (v : I) (hv : v ∉ S) (f : RawCochain I K 1)
    (hf : f ∈ supportedCochains S 1) (hc : differential 1 f=0) : f=0 := by
  obtain ⟨g,hg,hgf⟩ := exact_supported S v hv 0 f hf hc
  rw [supported_zero_length hS g hg,map_zero] at hgf
  exact hgf.symm

/-- A tuple too short to contain every coordinate supports no all-negative monomial. -/
theorem supported_univ_eq_zero [Fintype I] (q : ℕ) (hq : q<Fintype.card I)
    (f : RawCochain I K q) (hf : f ∈ supportedCochains (Set.univ : Set I) q) : f=0 := by
  funext a
  apply hf
  intro h
  have hs : Function.Surjective a := fun i => h (Set.mem_univ i)
  have hc := Fintype.card_le_of_surjective a hs
  simp only [Fintype.card_fin] at hc
  omega

/-- The actual Laurent exponent of a monomial; the total degree is an integer. -/
def negativeSupport (a : I → ℤ) : Set I := {i | a i<0}

theorem negativeSupport_nonempty_of_total_neg [Fintype I] (a : I → ℤ)
    (ha : ∑ i, a i<0) : (negativeSupport a).Nonempty := by
  by_contra h
  have hi : ∀ i, 0≤a i := by
    intro i
    by_contra hn
    exact h ⟨i,by exact lt_of_not_ge hn⟩
  exact (not_lt_of_ge (Finset.sum_nonneg (fun i _ => hi i))) ha

/-- All-negative exponent vectors have total degree at most minus the number of variables. -/
theorem total_le_neg_card_of_all_negative [Fintype I] (a : I → ℤ)
    (ha : ∀ i, a i<0) : ∑ i, a i≤-(Fintype.card I : ℤ) := by
  calc
    ∑ i, a i ≤ ∑ _i : I, (-1 : ℤ) := Finset.sum_le_sum (fun i _ => by have := ha i; omega)
    _ = -(Fintype.card I : ℤ) := by simp

/-- Degree at least `-N` on `P^N` ensures a nonnegative exponent in every monomial. -/
theorem exists_nonnegative_of_total_gt_neg_card [Fintype I] (a : I → ℤ)
    (ha : -(Fintype.card I : ℤ)<∑ i, a i) : ∃ i, 0≤a i := by
  by_contra h
  have hi : ∀ i, a i<0 := by
    intro i
    exact lt_of_not_ge (fun hi => h ⟨i,hi⟩)
  exact (not_lt_of_ge (total_le_neg_card_of_all_negative a hi)) ha

end PaperVerification.Segre.CechMonomials
end
end ProbeLayer108

section ProbeLayer109



/-!
# Exactness of the full finite Laurent-coefficient Čech complex

The coefficient decomposition includes every Laurent exponent of the given
integer total degree and has finite support, exactly as for localized
polynomial sections. The homotopy chooses a nonnegative coordinate separately
for each exponent; finite support is preserved. The conclusions are literal
kernel/image assertions for the alternating tuple differential, without a
sheaf-cohomology assumption or a restriction to finitely many exponents.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.CechMonomials

open scoped BigOperators

variable {I K : Type*} [Fintype I] [CommRing K]

section IndexedMaps

variable {A M N : Type*} [AddCommMonoid M] [AddCommMonoid N]
  [Module K M] [Module K N]

/-- A finite-support map whose linear coefficient map may depend on the index. -/
noncomputable def mapAtIndex (L : A → M →ₗ[K] N) : (A →₀ M) →ₗ[K] (A →₀ N) where
  toFun f := Finsupp.onFinset f.support (fun a => L a (f a)) (by
    intro a ha
    by_contra hn
    have hz : f a=0 := Finsupp.notMem_support_iff.mp hn
    exact ha (by rw [hz,map_zero]))
  map_add' f g := by
    ext a : 1
    exact (L a).map_add _ _
  map_smul' c f := by
    ext a : 1
    exact (L a).map_smul _ _

@[simp] theorem mapAtIndex_apply (L : A → M →ₗ[K] N) (f : A →₀ M) (a : A) :
    mapAtIndex L f a=L a (f a) := rfl

end IndexedMaps

/-- Every integer exponent vector of precisely the prescribed total degree. -/
abbrev DegreeExponent (I : Type*) [Fintype I] (t : ℤ) :=
  {a : I → ℤ // ∑ i, a i=t}

/-- Finitely many Laurent monomials, each with a tuple coefficient. -/
abbrev FiniteCochain (I K : Type*) [Fintype I] [CommRing K] (t : ℤ) (q : ℕ) :=
  DegreeExponent I t →₀ RawCochain I K q

/-- The exact denominator support condition, imposed on every coefficient. -/
def laurentCochains (t : ℤ) (q : ℕ) : Submodule K (FiniteCochain I K t q) where
  carrier := {f | ∀ a, f a ∈ supportedCochains (negativeSupport a.val) q}
  zero_mem' := by
    intro a
    exact (supportedCochains (K := K) (negativeSupport a.val) q).zero_mem
  add_mem' := by
    intro f g hf hg a
    change f a + g a ∈ supportedCochains (K := K) (negativeSupport a.val) q
    exact (supportedCochains (K := K) (negativeSupport a.val) q).add_mem (hf a) (hg a)
  smul_mem' := by
    intro c f hf a
    change c • f a ∈ supportedCochains (K := K) (negativeSupport a.val) q
    exact (supportedCochains (K := K) (negativeSupport a.val) q).smul_mem c (hf a)

noncomputable def laurentDifferential (t : ℤ) (q : ℕ) :
    FiniteCochain I K t q →ₗ[K] FiniteCochain I K t (q+1) :=
  mapAtIndex (fun _ => differential q)

@[simp] theorem laurentDifferential_apply (t : ℤ) (q : ℕ)
    (f : FiniteCochain I K t q) (a : DegreeExponent I t) :
    laurentDifferential (I := I) (K := K) t q f a=differential q (f a) := rfl

theorem laurentDifferential_mem {t : ℤ} {q : ℕ} {f : FiniteCochain I K t q}
    (hf : f ∈ laurentCochains (I := I) (K := K) t q) : laurentDifferential (I := I) (K := K) t q f ∈ laurentCochains (I := I) (K := K) t (q+1) :=
  fun a => differential_mem_supported (hf a)

theorem laurentDifferential_squared (t : ℤ) (q : ℕ) (f : FiniteCochain I K t q) :
    laurentDifferential (I := I) (K := K) t (q+1) (laurentDifferential (I := I) (K := K) t q f)=0 := by
  ext a : 1
  exact differential_squared q (f a)

/-- The insertion map for one exponent; it is zero if all exponents are negative. -/
noncomputable def coefficientContraction (a : I → ℤ) (q : ℕ) :
    RawCochain I K (q+1) →ₗ[K] RawCochain I K q := by
  classical
  exact if h : ∃ i, 0≤a i then contraction (Classical.choose h) q else 0

theorem coefficientContraction_mem (a : I → ℤ) (q : ℕ)
    (f : RawCochain I K (q+1)) (hf : f ∈ supportedCochains (negativeSupport a) (q+1)) :
    coefficientContraction a q f ∈ supportedCochains (negativeSupport a) q := by
  classical
  unfold coefficientContraction
  split_ifs with h
  · apply contraction_mem_supported _ _ hf
    exact not_lt_of_ge (Classical.choose_spec h)
  · exact (supportedCochains _ _).zero_mem

noncomputable def laurentContraction (t : ℤ) (q : ℕ) :
    FiniteCochain I K t (q+1) →ₗ[K] FiniteCochain I K t q :=
  mapAtIndex (fun a => coefficientContraction a.val q)

@[simp] theorem laurentContraction_apply (t : ℤ) (q : ℕ)
    (f : FiniteCochain I K t (q+1)) (a : DegreeExponent I t) :
    laurentContraction (I := I) (K := K) t q f a=coefficientContraction a.val q (f a) := rfl

theorem laurentContraction_mem {t : ℤ} {q : ℕ} {f : FiniteCochain I K t (q+1)}
    (hf : f ∈ laurentCochains (I := I) (K := K) t (q+1)) : laurentContraction (I := I) (K := K) t q f ∈ laurentCochains (I := I) (K := K) t q :=
  fun a => coefficientContraction_mem a.val q (f a) (hf a)

theorem negativeSupport_eq_univ_of_no_nonnegative (a : I → ℤ)
    (ha : ¬ ∃ i, 0≤a i) : negativeSupport a=Set.univ := by
  ext i
  simp only [negativeSupport,Set.mem_setOf_eq,Set.mem_univ,iff_true]
  exact lt_of_not_ge (fun hi => ha ⟨i,hi⟩)

/-- Intermediate projective degrees: every cocycle is an actual finite Laurent boundary. -/
theorem laurent_exact_below_dimension (t : ℤ) (q : ℕ) (hq : q+1<Fintype.card I)
    (f : FiniteCochain I K t (q+1)) (hf : f ∈ laurentCochains (I := I) (K := K) t (q+1))
    (hc : laurentDifferential (I := I) (K := K) t (q+1) f=0) :
    ∃ g : FiniteCochain I K t q, g ∈ laurentCochains (I := I) (K := K) t q ∧
      laurentDifferential (I := I) (K := K) t q g=f := by
  classical
  refine ⟨laurentContraction (I := I) (K := K) t q f,laurentContraction_mem hf,?_⟩
  ext a : 1
  change differential q (coefficientContraction a.val q (f a))=f a
  have hca : differential (q+1) (f a)=0 := congrArg (fun z => z a) hc
  unfold coefficientContraction
  split_ifs with h
  · have hi := contraction_identity (Classical.choose h) q (f a)
    simpa only [hca,map_zero,zero_add] using hi
  · have hz : f a=0 := by
      apply supported_univ_eq_zero (q+1) hq
      simpa only [negativeSupport_eq_univ_of_no_nonnegative a.val h] using hf a
    rw [LinearMap.zero_apply,map_zero,hz]

/-- If the twist is at least `-N` on `P^N`, no all-negative monomial occurs;
the augmented tuple complex is therefore exact in every degree. -/
theorem laurent_exact_of_twist (t : ℤ) (ht : -(Fintype.card I : ℤ)<t) (q : ℕ)
    (f : FiniteCochain I K t (q+1)) (hf : f ∈ laurentCochains (I := I) (K := K) t (q+1))
    (hc : laurentDifferential (I := I) (K := K) t (q+1) f=0) :
    ∃ g : FiniteCochain I K t q, g ∈ laurentCochains (I := I) (K := K) t q ∧
      laurentDifferential (I := I) (K := K) t q g=f := by
  classical
  refine ⟨laurentContraction (I := I) (K := K) t q f,laurentContraction_mem hf,?_⟩
  ext a : 1
  have ha : ∃ i, 0≤a.val i := exists_nonnegative_of_total_gt_neg_card a.val (by rwa [a.property])
  change differential q (coefficientContraction a.val q (f a))=f a
  rw [coefficientContraction,dif_pos ha]
  have hca : differential (q+1) (f a)=0 := congrArg (fun z => z a) hc
  have hi := contraction_identity (Classical.choose ha) q (f a)
  simpa only [hca,map_zero,zero_add] using hi

/-- There are no global sections in a negative degree when projective dimension is positive. -/
theorem laurent_global_cocycle_eq_zero (hI : 1<Fintype.card I) (t : ℤ) (ht : t<0)
    (f : FiniteCochain I K t 1) (hf : f ∈ laurentCochains (I := I) (K := K) t 1)
    (hc : laurentDifferential (I := I) (K := K) t 1 f=0) : f=0 := by
  classical
  ext a : 1
  change f a=0
  have hca : differential 1 (f a)=0 := congrArg (fun z => z a) hc
  by_cases ha : ∃ i, 0≤a.val i
  · obtain ⟨i,hi⟩ := ha
    apply global_cocycle_eq_zero
      (negativeSupport_nonempty_of_total_neg a.val (by rwa [a.property])) i
      (not_lt_of_ge hi) (f a) (hf a) hca
  · apply supported_univ_eq_zero 1 hI
    simpa only [negativeSupport_eq_univ_of_no_nonnegative a.val ha] using hf a

end PaperVerification.Segre.CechMonomials
end
end ProbeLayer109

section ProbeLayer110

/-
The proof of `addMonoidAlgebra_localization` is an additive adaptation of
TauCeti.Algebra.MonoidAlgebra.Localization at commit
06d5bb4e3ebb737dc6538567f5c53bf8800b9362, released under Apache 2.0.
Copyright (c) 2026 The Tau Ceti contributors. All rights reserved.
-/


/-!
# Coordinate localizations as literal Laurent monomial algebras

Inverting the product of the coordinates indexed by `S` gives exactly the
Laurent monomials whose exponents outside `S` are nonnegative. The proof gives
the full universal localization property; it does not merely embed a selected
finite set of fractions. This is the local algebra needed to connect the
monomial Čech calculation to sections on intersections of projective charts.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.CoordinateLocalization

open scoped BigOperators

variable {K I : Type*} [CommRing K] [Fintype I] [DecidableEq I]

/-- Exponents of exactly the monomials available after inverting the coordinates in `S`. -/
def allowedExponents (S : Finset I) : AddSubmonoid (I → ℤ) where
  carrier := {a | ∀ i, i ∉ S → 0≤a i}
  zero_mem' := by intro i _; exact le_refl 0
  add_mem' ha hb := by intro i hi; exact add_nonneg (ha i hi) (hb i hi)

def naturalExponentMap (S : Finset I) : (I →₀ ℕ) →+ allowedExponents S where
  toFun a := ⟨fun i => (a i : ℤ),by intro i _; exact Int.natCast_nonneg _⟩
  map_zero' := Subtype.ext (by funext i; rfl)
  map_add' a b := Subtype.ext (by funext i; exact Int.natCast_add _ _)

theorem naturalExponentMap_injective (S : Finset I) : Function.Injective (naturalExponentMap S) := by
  intro a b hab
  ext i
  exact Int.natCast_inj.mp (congrFun (congrArg Subtype.val hab) i)

/-- The squarefree exponent of the product of the coordinates in `S`. -/
noncomputable def denominatorExponent (S : Finset I) : I →₀ ℕ :=
  ∑ i ∈ S, Finsupp.single i 1

@[simp] theorem denominatorExponent_apply (S : Finset I) (i : I) :
    denominatorExponent S i=if i∈S then 1 else 0 := by
  classical
  simp [denominatorExponent,Finsupp.single_apply]

noncomputable def inverseDenominator (S : Finset I) : allowedExponents S :=
  ⟨fun i => if i∈S then -1 else 0,by intro i hi; simp only [if_neg hi,le_refl]⟩

theorem denominator_add_inverse (S : Finset I) :
    naturalExponentMap S (denominatorExponent S)+inverseDenominator S=0 := by
  apply Subtype.ext
  funext i
  change (denominatorExponent S i : ℤ)+(if i∈S then -1 else 0)=0
  rw [denominatorExponent_apply]
  split_ifs <;> rfl

/-- A common denominator clears every negative exponent in a Laurent monomial. -/
theorem exponent_clear_denominator (S : Finset I) (a : allowedExponents S) :
    ∃ m : ℕ, a+m • naturalExponentMap S (denominatorExponent S) ∈ Set.range (naturalExponentMap S) := by
  classical
  let m : ℕ := ∑ i, (-a.val i).toNat
  have hm (i : I) : (-a.val i).toNat≤m := by
    change (-a.val i).toNat≤∑ j,(-a.val j).toNat
    exact Finset.single_le_sum (fun j _ => Nat.zero_le ((-a.val j).toNat))
      (Finset.mem_univ i)
  have hn (i : I) : 0≤a.val i+(if i∈S then (m : ℤ) else 0) := by
    by_cases hi : i∈S
    · rw [if_pos hi]
      have := hm i
      have hc : -a.val i≤((-a.val i).toNat : ℤ) := by omega
      omega
    · rw [if_neg hi,add_zero]
      exact a.property i hi
  let b : I →₀ ℕ := Finsupp.equivFunOnFinite.symm
    (fun i => (a.val i+(if i∈S then (m : ℤ) else 0)).toNat)
  refine ⟨m,b,?_⟩
  apply Subtype.ext
  funext i
  change ((a.val i+(if i∈S then (m : ℤ) else 0)).toNat : ℤ) =
    a.val i + m • ((denominatorExponent S i : ℕ) : ℤ)
  rw [Int.toNat_of_nonneg (hn i),denominatorExponent_apply]
  split_ifs <;> simp

/-- The exact monomial algebra of a coordinate localization. -/
abbrev LocalLaurent (K I : Type*) [CommRing K] (S : Finset I) :=
  AddMonoidAlgebra K (allowedExponents S)

noncomputable def localizationMap (S : Finset I) : MvPolynomial I K →ₐ[K] LocalLaurent K I S :=
  AddMonoidAlgebra.mapDomainAlgHom K K (naturalExponentMap S)

noncomputable instance localizationAlgebra (S : Finset I) :
    Algebra (MvPolynomial I K) (LocalLaurent K I S) :=
  (localizationMap (K := K) S).toRingHom.toAlgebra

theorem localizationMap_injective (S : Finset I) : Function.Injective (localizationMap (K := K) S) :=
  AddMonoidAlgebra.mapDomain_injective (naturalExponentMap_injective S)

/-- The image of the denominator monomial has its literal negative-exponent inverse. -/
theorem denominator_isUnit (S : Finset I) :
    IsUnit (AddMonoidAlgebra.single (naturalExponentMap S (denominatorExponent S)) (1 : K)) := by
  refine ⟨⟨AddMonoidAlgebra.single (naturalExponentMap S (denominatorExponent S)) (1 : K),
    AddMonoidAlgebra.single (inverseDenominator S) 1,?_,?_⟩,rfl⟩
  · change AddMonoidAlgebra.single (naturalExponentMap S (denominatorExponent S)) (1 : K)*
      AddMonoidAlgebra.single (inverseDenominator S) (1 : K)=1
    rw [AddMonoidAlgebra.single_mul_single,denominator_add_inverse,one_mul,
      ← AddMonoidAlgebra.one_def]
  · change AddMonoidAlgebra.single (inverseDenominator S) (1 : K)*
      AddMonoidAlgebra.single (naturalExponentMap S (denominatorExponent S)) (1 : K)=1
    rw [AddMonoidAlgebra.single_mul_single,add_comm,denominator_add_inverse,one_mul,
      ← AddMonoidAlgebra.one_def]

section GeneralMonoidLocalization

variable {M N : Type*} [AddCommMonoid M] [AddCommMonoid N]

/-- The induced monoid-algebra map has the full localization property. -/
theorem addMonoidAlgebra_localization (f : M →+ N) (hf : Function.Injective f) (x : M)
    (hx : IsUnit (AddMonoidAlgebra.single (f x) (1 : K)))
    (hsurj : ∀ y : N, ∃ m : ℕ, y+m • f x ∈ Set.range f) :
    letI := (AddMonoidAlgebra.mapDomainRingHom K f).toAlgebra
    IsLocalization.Away (AddMonoidAlgebra.single x (1 : K)) (AddMonoidAlgebra K N) := by
  letI := (AddMonoidAlgebra.mapDomainRingHom K f).toAlgebra
  have halg : ∀ a : AddMonoidAlgebra K M,
      algebraMap (AddMonoidAlgebra K M) (AddMonoidAlgebra K N) a =
        AddMonoidAlgebra.mapDomain f a := fun a => by
    rw [RingHom.algebraMap_toAlgebra,AddMonoidAlgebra.mapDomainRingHom_apply]
  refine IsLocalization.Away.mk _ ?_ ?_ ?_
  · rw [halg,AddMonoidAlgebra.mapDomain_single]
    exact hx
  · intro s
    induction s using AddMonoidAlgebra.induction_on with
    | of y =>
      obtain ⟨m,z,hz⟩ := hsurj y
      refine ⟨m,AddMonoidAlgebra.single z 1,?_⟩
      simp [halg,hz]
    | add s t hs ht =>
      obtain ⟨m,a,ha⟩ := hs
      obtain ⟨r,b,hb⟩ := ht
      refine ⟨m+r,a*AddMonoidAlgebra.single x 1^r+b*AddMonoidAlgebra.single x 1^m,?_⟩
      simp only [map_add,map_mul,map_pow]
      rw [← ha,← hb]
      ring
    | smul c s hs =>
      obtain ⟨m,a,ha⟩ := hs
      refine ⟨m,algebraMap K (AddMonoidAlgebra K M) c*a,?_⟩
      have ha' : s*AddMonoidAlgebra.mapDomain f (AddMonoidAlgebra.single x 1)^m =
          AddMonoidAlgebra.mapDomain f a := by simpa only [halg] using ha
      simp only [Algebra.smul_def,halg]
      rw [mul_assoc,ha',AddMonoidAlgebra.mapDomain_mul]
      congr 1
      exact ((AddMonoidAlgebra.mapDomainAlgHom K K f).commutes c).symm
  · intro a b hab
    exact ⟨0,by rw [AddMonoidAlgebra.mapDomain_injective hf hab]⟩

end GeneralMonoidLocalization

theorem denominator_monomial_eq_prod (S : Finset I) :
    MvPolynomial.monomial (denominatorExponent S) (1 : K) = ∏ i ∈ S, MvPolynomial.X i := by
  rw [denominatorExponent,MvPolynomial.monomial_sum_one]
  rfl

/-- All and only coordinate Laurent polynomials form the standard coordinate localization. -/
noncomputable instance localLaurent_isLocalization (S : Finset I) :
    IsLocalization.Away (∏ i ∈ S, (MvPolynomial.X i : MvPolynomial I K)) (LocalLaurent K I S) := by
  rw [← denominator_monomial_eq_prod]
  exact addMonoidAlgebra_localization (naturalExponentMap S) (naturalExponentMap_injective S)
    (denominatorExponent S) (denominator_isUnit S) (exponent_clear_denominator S)

/-- The actual localization is canonically the Laurent coefficient model. -/
noncomputable def coordinateLocalizationEquiv (S : Finset I) :
    Localization.Away (∏ i ∈ S, (MvPolynomial.X i : MvPolynomial I K)) ≃ₐ[MvPolynomial I K]
      LocalLaurent K I S :=
  IsLocalization.algEquiv (Submonoid.powers (∏ i ∈ S, (MvPolynomial.X i : MvPolynomial I K))) _ _

end PaperVerification.Segre.CoordinateLocalization
end
end ProbeLayer110


/-! Future-only kernel audit for one exported mathematical stage.

Append to the stage being checked, with Lean.Util.CollectAxioms available through
both `public import Lean.Util.CollectAxioms` and `import all Lean.Util.CollectAxioms`
in that stage's header, as required by the reviewed FullFlattenedAudit.

Every new declaration in the checked kernel environment is included: public,
private, generated and vendored declarations receive the same direct-sorry and
transitive-axiom checks. This is evidence for this stage only. Later principal
theorems need not exist yet, and the final full principal audit remains required.

This preparation does not execute the audit, export a module or alter a proof.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The stage kernel audit requires kernel trust level zero"
  let names := (env.checked.get.constants.foldStage2
    (fun (names : Array Name) name _ => names.push name) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The stage mathematical module is empty"
  let privateEnv := env.setExporting false
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut theoremCount : Nat := 0
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if let .thmInfo _ := info then
      theoremCount := theoremCount + 1
  let report := Json.mkObj [
    ("main_module", toJson env.header.mainModule.toString),
    ("declaration_count", toJson names.size),
    ("theorem_count", toJson theoremCount),
    ("trust_level", toJson env.header.trustLevel.toNat),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("audit_scope", toJson "current_stage_new_declarations")]
  logInfo m!"SEGRE_STAGE_KERNEL_AUDIT_PASS {report.compress}"
