section ProbeLayer2



/-!
# Simultaneous rank conditions over an infinite field

A nonzero minor at one point remains a nonzero polynomial. Products of finitely
many such minors have a nonzero value over an infinite field. The theorem below
allows two matrix families, with different row and column types, to attain their
specified rank bounds at the same parameter point.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

namespace PaperVerification.GenericMatrixRank

variable {K σ : Type*} [Field K] [Infinite K]

/-- A nonzero polynomial has a nonzero value over an infinite field. -/
theorem exists_eval_ne_zero (p : MvPolynomial σ K) (hp : p ≠ 0) :
    ∃ t : σ → K, MvPolynomial.eval t p ≠ 0 := by
  by_contra hn
  push_neg at hn
  apply hp
  apply MvPolynomial.funext
  intro t
  simpa only [map_zero] using hn t

/-- Two individually attainable polynomial rank bounds are simultaneously attainable. -/
theorem exists_rank_bounds
    {m n u v : Type*} [Finite m] [Fintype n] [Finite u] [Fintype v]
    (A : Matrix m n (MvPolynomial σ K)) (B : Matrix u v (MvPolynomial σ K))
    (a b : σ → K) (r s : ℕ)
    (hA : r ≤ (A.map (MvPolynomial.eval a)).rank)
    (hB : s ≤ (B.map (MvPolynomial.eval b)).rank) :
    ∃ t : σ → K,
      r ≤ (A.map (MvPolynomial.eval t)).rank ∧
      s ≤ (B.map (MvPolynomial.eval t)).rank := by
  obtain ⟨ar, ac, ha⟩ := Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mp hA
  obtain ⟨br, bc, hb⟩ := Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mp hB
  let p : MvPolynomial σ K := (A.submatrix ar ac).det
  let q : MvPolynomial σ K := (B.submatrix br bc).det
  have hp : p ≠ 0 := by
    intro hz
    apply ha
    simp only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    change MvPolynomial.eval a p = 0
    rw [hz, map_zero]
  have hq : q ≠ 0 := by
    intro hz
    apply hb
    simp only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    change MvPolynomial.eval b q = 0
    rw [hz, map_zero]
  obtain ⟨t, ht⟩ := exists_eval_ne_zero (p * q) (mul_ne_zero hp hq)
  rw [map_mul] at ht
  have ht' := mul_ne_zero_iff.mp ht
  refine ⟨t, Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mpr ⟨ar, ac, ?_⟩,
    Matrix.le_rank_iff_exists_det_submatrix_ne_zero.mpr ⟨br, bc, ?_⟩⟩
  · simpa only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      using ht'.1
  · simpa only [Matrix.submatrix_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      using ht'.2

/-- In particular, two full-column-rank conditions can be imposed simultaneously. -/
theorem exists_full_column_rank
    {m n u v : Type*} [Finite m] [Fintype n] [Finite u] [Fintype v]
    (A : Matrix m n (MvPolynomial σ K)) (B : Matrix u v (MvPolynomial σ K))
    (a b : σ → K)
    (hA : (A.map (MvPolynomial.eval a)).rank = Fintype.card n)
    (hB : (B.map (MvPolynomial.eval b)).rank = Fintype.card v) :
    ∃ t : σ → K,
      (A.map (MvPolynomial.eval t)).rank = Fintype.card n ∧
      (B.map (MvPolynomial.eval t)).rank = Fintype.card v := by
  obtain ⟨t, htA, htB⟩ := exists_rank_bounds A B a b _ _ hA.ge hB.ge
  exact ⟨t, le_antisymm (Matrix.rank_le_card_width _) htA,
    le_antisymm (Matrix.rank_le_card_width _) htB⟩

end PaperVerification.GenericMatrixRank
end
end
end ProbeLayer2

section ProbeLayer3



/-!
# Polynomial certificates and the actual Zariski topology on rational points

The topology is induced by the canonical map sending a tuple to the prime
ideal of polynomials vanishing there. Thus polynomial nonvanishing is related
to Mathlib's spectrum topology, independently of any rank theorem. Over an
infinite field the nonvanishing locus of a nonzero polynomial is nonempty and
dense, and a polynomial certificate is equivalent to a property holding on
a nonempty Zariski open set.

This source candidate still requires compilation before certification.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

namespace PaperVerification.PolynomialGenericity

variable {K σ : Type*} [Field K]

/-- The genuine rational-point map into the prime spectrum. -/
def point (t : σ → K) : PrimeSpectrum (MvPolynomial σ K) :=
  ⟨RingHom.ker (MvPolynomial.eval t), RingHom.ker_isPrime (MvPolynomial.eval t)⟩

theorem point_injective : Function.Injective (point (K := K) (σ := σ)) := by
  intro s t h
  have he : (point s).asIdeal=(point t).asIdeal := congrArg PrimeSpectrum.asIdeal h
  funext i
  have hm : MvPolynomial.X i-MvPolynomial.C (s i) ∈ (point s).asIdeal := by
    change MvPolynomial.eval s (MvPolynomial.X i-MvPolynomial.C (s i))=0
    simp only [map_sub,MvPolynomial.eval_X,MvPolynomial.eval_C,sub_self]
  rw [he] at hm
  change MvPolynomial.eval t (MvPolynomial.X i-MvPolynomial.C (s i))=0 at hm
  simp only [map_sub,MvPolynomial.eval_X,MvPolynomial.eval_C,sub_eq_zero] at hm
  exact hm.symm

/-- The usual Zariski topology on the rational points, obtained by pulling
back the prime-spectrum topology along their injective canonical map. -/
def zariskiTopology : TopologicalSpace (σ → K) :=
  TopologicalSpace.induced (point (K := K) (σ := σ)) inferInstance

attribute [local instance] zariskiTopology

def principal (p : MvPolynomial σ K) : Set (σ → K) :=
  {t | MvPolynomial.eval t p≠0}

theorem principal_eq_preimage_basicOpen (p : MvPolynomial σ K) :
    principal p=point ⁻¹' (PrimeSpectrum.basicOpen p : Set _) := by
  ext t
  change (MvPolynomial.eval t p ≠ 0) ↔ p ∉ RingHom.ker (MvPolynomial.eval t)
  rfl

theorem isOpen_principal (p : MvPolynomial σ K) : IsOpen (principal p) := by
  rw [principal_eq_preimage_basicOpen]
  exact isOpen_induced PrimeSpectrum.isOpen_basicOpen

/-- Every neighbourhood in the actual induced topology contains a
polynomial principal neighbourhood of the same point. -/
theorem open_contains_principal {U : Set (σ → K)} (hU : IsOpen U)
    {x : σ → K} (hx : x∈U) :
    ∃ p : MvPolynomial σ K, MvPolynomial.eval x p≠0 ∧ principal p⊆U := by
  obtain ⟨V,hV,hVU⟩ := isOpen_induced_iff.mp hU
  have hxV : point x∈V := by rwa [←hVU] at hx
  obtain ⟨W,⟨p,rfl⟩,hxp,hpV⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.isOpen_iff.mp hV (point x) hxV
  refine ⟨p,?_,?_⟩
  · change p∉RingHom.ker (MvPolynomial.eval x) at hxp
    exact hxp
  · intro y hy
    rw [←hVU]
    apply hpV
    change p∉RingHom.ker (MvPolynomial.eval y)
    exact hy

theorem principal_nonempty_iff [Infinite K] (p : MvPolynomial σ K) :
    (principal p).Nonempty ↔ p≠0 := by
  constructor
  · rintro ⟨x,hx⟩ hp
    exact hx (by rw [hp,map_zero])
  · exact GenericMatrixRank.exists_eval_ne_zero p

theorem principal_dense [Infinite K] (p : MvPolynomial σ K) (hp : p≠0) :
    Dense (principal p) := by
  apply dense_iff_inter_open.mpr
  intro U hU hne
  obtain ⟨x,hx⟩ := hne
  obtain ⟨q,hqx,hqU⟩ := open_contains_principal hU hx
  have hq : q≠0 := by
    intro he
    exact hqx (by rw [he,map_zero])
  obtain ⟨y,hy⟩ := GenericMatrixRank.exists_eval_ne_zero (q*p) (mul_ne_zero hq hp)
  rw [map_mul,mul_ne_zero_iff] at hy
  exact ⟨y,hqU hy.1,hy.2⟩

/-- Exact equivalence between the certificate used in the principal Segre
statements and the ordinary nonempty-open meaning of “general”. -/
theorem certificate_iff_nonempty_open [Infinite K] (P : (σ → K) → Prop) :
    (∃ p : MvPolynomial σ K,p≠0 ∧ ∀ x,MvPolynomial.eval x p≠0 → P x) ↔
      ∃ U : Set (σ → K),IsOpen U ∧ U.Nonempty ∧ ∀ x∈U,P x := by
  constructor
  · rintro ⟨p,hp,hP⟩
    exact ⟨principal p,isOpen_principal p,(principal_nonempty_iff p).mpr hp,hP⟩
  · rintro ⟨U,hU,⟨x,hx⟩,hP⟩
    obtain ⟨p,hpx,hpU⟩ := open_contains_principal hU hx
    refine ⟨p,?_,fun y hy => hP y (hpU hy)⟩
    intro he
    exact hpx (by rw [he,map_zero])

theorem certificate_contains_dense_open [Infinite K] (P : (σ → K) → Prop)
    (h : ∃ p : MvPolynomial σ K,p≠0 ∧ ∀ x,MvPolynomial.eval x p≠0 → P x) :
    ∃ U : Set (σ → K),IsOpen U ∧ U.Nonempty ∧ Dense U ∧ ∀ x∈U,P x := by
  obtain ⟨p,hp,hP⟩ := h
  exact ⟨principal p,isOpen_principal p,(principal_nonempty_iff p).mpr hp,
    principal_dense p hp,hP⟩

end PaperVerification.PolynomialGenericity
end
end
end ProbeLayer3

section ProbeLayer4



/-!
# Exact weights for the Segre staircase degeneration

The vertices are the full product of arbitrary finite chains. The weight identity
below proves that sorting an incomparable pair lowers weight by a strictly positive
integer, and sorting a comparable pair leaves it unchanged. The formulas are
integral and have no field-characteristic hypotheses.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.Staircase

variable {I : Type*} [Fintype I]

abbrev Cell (n : I → ℕ) := ∀ i, Fin (n i + 1)

def rank {n : I → ℕ} (u : Cell n) : ℕ := ∑ i, (u i).val

def sideSum (n : I → ℕ) : ℕ := ∑ i, n i

def meet {n : I → ℕ} (u v : Cell n) : Cell n := fun i => min (u i) (v i)

def join {n : I → ℕ} (u v : Cell n) : Cell n := fun i => max (u i) (v i)

def weight {n : I → ℕ} (u : Cell n) : ℕ := rank u * (sideSum n - rank u)

/-- The exact power of the degeneration parameter for a sorted product. -/
def defectExponent {n : I → ℕ} (u v : Cell n) : ℕ :=
  2 * (rank u - rank (meet u v)) * (rank v - rank (meet u v))

theorem rank_le_sideSum {n : I → ℕ} (u : Cell n) : rank u ≤ sideSum n := by
  apply Finset.sum_le_sum
  intro i _
  have hi := (u i).isLt
  omega

theorem meet_le_left {n : I → ℕ} (u v : Cell n) : meet u v ≤ u :=
  fun i => min_le_left _ _

theorem meet_le_right {n : I → ℕ} (u v : Cell n) : meet u v ≤ v :=
  fun i => min_le_right _ _

theorem rank_mono {n : I → ℕ} {u v : Cell n} (h : u ≤ v) : rank u ≤ rank v :=
  Finset.sum_le_sum (fun i _ => h i)

/-- Coordinatewise inclusion plus equal rank forces equality of vertices. -/
theorem eq_of_le_of_rank_eq {n : I → ℕ} {u v : Cell n}
    (h : u ≤ v) (hr : rank u = rank v) : u = v := by
  funext i
  apply Fin.ext
  exact (Finset.sum_eq_sum_iff_of_le
    (fun j _ => show (u j).val ≤ (v j).val from h j)).mp hr i (Finset.mem_univ i)

/-- Rank is modular under coordinatewise minimum and maximum. -/
theorem rank_add_rank {n : I → ℕ} (u v : Cell n) :
    rank u + rank v = rank (meet u v) + rank (join u v) := by
  simp only [rank, meet, join, ← Finset.sum_add_distrib, Fin.val_min, Fin.val_max]
  apply Finset.sum_congr rfl
  intro i _
  exact (min_add_max _ _).symm

theorem rank_meet_eq_left_iff {n : I → ℕ} (u v : Cell n) :
    rank (meet u v) = rank u ↔ u ≤ v := by
  constructor
  · intro h
    have hm := eq_of_le_of_rank_eq (meet_le_left u v) h
    intro i
    exact min_eq_left_iff.mp (congrFun hm i)
  · intro h
    congr 1
    funext i
    exact min_eq_left (h i)

theorem rank_meet_eq_right_iff {n : I → ℕ} (u v : Cell n) :
    rank (meet u v) = rank v ↔ v ≤ u := by
  have hc : meet u v = meet v u := by funext i; exact min_comm _ _
  rw [hc]
  exact rank_meet_eq_left_iff v u

/-- The exponent vanishes precisely for comparable vertices. -/
theorem defectExponent_eq_zero_iff {n : I → ℕ} (u v : Cell n) :
    defectExponent u v = 0 ↔ u ≤ v ∨ v ≤ u := by
  have hmu := rank_mono (meet_le_left u v)
  have hmv := rank_mono (meet_le_right u v)
  simp only [defectExponent, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
    Nat.sub_eq_zero_iff_le]
  constructor
  · rintro (hu | hv)
    · exact Or.inl ((rank_meet_eq_left_iff u v).mp (le_antisymm hmu hu))
    · exact Or.inr ((rank_meet_eq_right_iff u v).mp (le_antisymm hmv hv))
  · rintro (hu | hv)
    · exact Or.inl ((rank_meet_eq_left_iff u v).mpr hu).ge
    · exact Or.inr ((rank_meet_eq_right_iff u v).mpr hv).ge

/-- Incomparable vertices have strictly positive degeneration exponent. -/
theorem defectExponent_pos_iff {n : I → ℕ} (u v : Cell n) :
    0 < defectExponent u v ↔ ¬ u ≤ v ∧ ¬ v ≤ u := by
  rw [Nat.pos_iff_ne_zero, ne_eq, defectExponent_eq_zero_iff, not_or]

/-- Exact integral weight identity from Section 4.1 of the paper. -/
theorem weight_sorting_identity {n : I → ℕ} (u v : Cell n) :
    weight u + weight v = weight (meet u v) + weight (join u v) +
      defectExponent u v := by
  have hu := rank_le_sideSum u
  have hv := rank_le_sideSum v
  have hm := rank_le_sideSum (meet u v)
  have hj := rank_le_sideSum (join u v)
  have hmu := rank_mono (meet_le_left u v)
  have hmv := rank_mono (meet_le_right u v)
  have hrel : (rank u : ℤ) + rank v = rank (meet u v) + rank (join u v) := by
    exact_mod_cast rank_add_rank u v
  have hjoin : (rank (join u v) : ℤ) = rank u + rank v - rank (meet u v) := by
    omega
  apply Int.ofNat_inj.mp
  simp only [weight, defectExponent, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat,
    Nat.cast_sub hu, Nat.cast_sub hv, Nat.cast_sub hm, Nat.cast_sub hj,
    Nat.cast_sub hmu, Nat.cast_sub hmv]
  rw [hjoin]
  ring

/-- Sorting an incomparable product strictly decreases the specified weight. -/
theorem weight_decreases_of_incomparable {n : I → ℕ} (u v : Cell n)
    (huv : ¬ u ≤ v) (hvu : ¬ v ≤ u) :
    weight (meet u v) + weight (join u v) < weight u + weight v := by
  rw [weight_sorting_identity u v]
  exact Nat.lt_add_of_pos_right ((defectExponent_pos_iff u v).mpr ⟨huv, hvu⟩)

end PaperVerification.Segre.Staircase
end
end ProbeLayer4

section ProbeLayer5



/-!
# Literal exponent vectors of quadratic monomials

This elementary exponent identity is used both by the Segre monomial basis
and by the independent Stanley--Reisner quotient coefficient calculation.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.GraphQuotient

variable {V : Type*} [DecidableEq V]

/-- Exponent vector of a degree-one variable. -/
noncomputable def exponent (v : V) : V →₀ ℕ := Finsupp.single v 1

/-- Equality of quadratic monomials records the unordered pair of their variables. -/
theorem exponent_pair_eq_iff (a b u v : V) :
    exponent a + exponent b = exponent u + exponent v ↔
      (a = u ∧ b = v) ∨ (a = v ∧ b = u) := by
  constructor
  · intro h
    have ha : a = u ∨ a = v := by
      by_contra hn
      push_neg at hn
      have he := congrArg (fun f : V →₀ ℕ => f a) h
      simp [exponent, Finsupp.single_apply, hn.1.symm, hn.2.symm] at he
    rcases ha with rfl | rfl
    · left
      refine ⟨rfl, ?_⟩
      have hb := add_left_cancel h
      exact Finsupp.single_left_injective (by decide : (1 : ℕ) ≠ 0) hb
    · right
      refine ⟨rfl, ?_⟩
      have hb : exponent b = exponent u := by
        apply add_left_cancel (a := exponent a)
        simpa only [add_comm (exponent u) (exponent a)] using h
      exact Finsupp.single_left_injective (by decide : (1 : ℕ) ≠ 0) hb
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · rfl
    · exact add_comm _ _

end PaperVerification.Segre.GraphQuotient
end
end ProbeLayer5

section ProbeLayer6



/-!
# The full degree-two monomial basis of a Segre algebra

All numbers of factors and all finite chain lengths are allowed. The Segre
coordinate functions are literal products of one polynomial variable from each
factor. Sorting the two indices independently in every factor gives an explicit
basis for the span of all products of two coordinate functions.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.Monomials

open MvPolynomial
open Staircase

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K]
variable {n : I → ℕ}

abbrev Variables (n : I → ℕ) := Σ i, Fin (n i + 1)

/-- One copy of the chosen coordinate in each factor. -/
noncomputable def cellExponent (u : Cell n) : Variables n →₀ ℕ :=
  ∑ i, Finsupp.single ⟨i, u i⟩ 1

@[simp] theorem cellExponent_apply (u : Cell n) (i : I) (j : Fin (n i + 1)) :
    cellExponent u ⟨i, j⟩ = if u i = j then 1 else 0 := by
  classical
  rw [cellExponent, Finset.sum_apply', Finset.sum_eq_single i]
  · by_cases h : u i = j <;> simp [Finsupp.single_apply, h]
  · intro k _ hki
    have hne : (⟨k, u k⟩ : Variables n) ≠ ⟨i, j⟩ := by
      intro he
      exact hki (congrArg Sigma.fst he)
    simp [Finsupp.single_apply, hne]
  · simp

/-- A literal rank-one Segre coordinate monomial. -/
noncomputable def cellPolynomial (u : Cell n) : MvPolynomial (Variables n) K :=
  monomial (cellExponent u) 1

/-- The coordinate monomial is exactly the product of one variable in each slot. -/
theorem cellPolynomial_eq_prod (u : Cell n) :
    cellPolynomial (K := K) u = ∏ i, X (⟨i, u i⟩ : Variables n) := by
  simp only [cellPolynomial, cellExponent, monomial_sum_one, X]

/-- Distinct Segre coordinates are distinct ambient monomials. -/
theorem cellExponent_injective : Function.Injective (cellExponent (n := n)) := by
  intro u v h
  funext i
  have hi := congrArg (fun f : Variables n →₀ ℕ => f ⟨i, u i⟩) h
  by_contra huv
  have hvu : v i ≠ u i := Ne.symm huv
  simp only [cellExponent_apply, if_pos rfl, if_neg hvu] at hi
  exact Nat.one_ne_zero hi

/-- The coordinate monomials form a linearly independent family in every
characteristic. -/
theorem cellPolynomial_linearIndependent :
    LinearIndependent K (cellPolynomial (K := K) (n := n)) :=
  (MvPolynomial.basisMonomials (Variables n) K).linearIndependent.comp
    cellExponent cellExponent_injective

/-- The actual degree-one component of the Segre subalgebra. -/
noncomputable def degreeOne : Submodule K (MvPolynomial (Variables n) K) :=
  Submodule.span K (Set.range (cellPolynomial (K := K) (n := n)))

noncomputable def degreeOneBasis : Module.Basis (Cell n) K (degreeOne (K := K) (n := n)) :=
  Module.Basis.span (cellPolynomial_linearIndependent (K := K) (n := n))

/-- Sorting the pair separately in each slot does not change its exponent. -/
theorem cellExponent_sort (u v : Cell n) :
    cellExponent u + cellExponent v = cellExponent (meet u v) + cellExponent (join u v) := by
  ext z
  rcases z with ⟨i, j⟩
  simp only [Finsupp.add_apply, cellExponent_apply]
  by_cases h : u i ≤ v i
  · simp only [meet, join, min_eq_left h, max_eq_right h]
  · have h' : v i ≤ u i := le_of_not_ge h
    simp only [meet, join, min_eq_right h', max_eq_left h', add_comm]

/-- The Segre straightening identity holds in the polynomial ring itself. -/
theorem cellPolynomial_mul_sort (u v : Cell n) :
    cellPolynomial (K := K) u * cellPolynomial v =
      cellPolynomial (meet u v) * cellPolynomial (join u v) := by
  simp only [cellPolynomial, monomial_mul_monomial, mul_one]
  rw [cellExponent_sort u v]

/-- Comparable pairs are the degree-two chain monomials. -/
abbrev SortedPair (n : I → ℕ) := {q : Cell n × Cell n // q.1 ≤ q.2}

noncomputable def sortedExponent (q : SortedPair n) : Variables n →₀ ℕ :=
  cellExponent q.val.1 + cellExponent q.val.2

/-- Different comparable pairs define different monomials in the ambient
multigraded polynomial algebra. -/
theorem sortedExponent_injective : Function.Injective (sortedExponent (n := n)) := by
  rintro ⟨⟨u, v⟩, huv⟩ ⟨⟨u', v'⟩, huv'⟩ h
  have hcoords : ∀ i, u i = u' i ∧ v i = v' i := by
    intro i
    have he : GraphQuotient.exponent (u i) + GraphQuotient.exponent (v i) =
        GraphQuotient.exponent (u' i) + GraphQuotient.exponent (v' i) := by
      ext j
      have hj := congrArg (fun f : Variables n →₀ ℕ => f ⟨i, j⟩) h
      simpa only [sortedExponent, Finsupp.add_apply, cellExponent_apply,
        GraphQuotient.exponent, Finsupp.single_apply] using hj
    rcases (GraphQuotient.exponent_pair_eq_iff (u i) (v i) (u' i) (v' i)).mp he with
      ⟨hu, hv⟩ | ⟨hu, hv⟩
    · exact ⟨hu, hv⟩
    · have heq : u i = u' i := by
        apply le_antisymm
        · simpa only [hv] using huv i
        · simpa only [hu] using huv' i
      exact ⟨heq, hv.trans (heq.symm.trans hu)⟩
  apply Subtype.ext
  apply Prod.ext
  · exact funext (fun i => (hcoords i).1)
  · exact funext (fun i => (hcoords i).2)

/-- The sorted degree-two monomials as literal polynomials. -/
noncomputable def sortedMonomial (q : SortedPair n) : MvPolynomial (Variables n) K :=
  monomial (sortedExponent q) 1

theorem sortedMonomial_eq_mul (q : SortedPair n) :
    sortedMonomial (K := K) q = cellPolynomial q.val.1 * cellPolynomial q.val.2 := by
  simp only [sortedMonomial, sortedExponent, cellPolynomial, monomial_mul_monomial, mul_one]

/-- Linear independence over every field follows from the ambient monomial basis,
so no characteristic-dependent determinant is being assumed. -/
theorem sortedMonomial_linearIndependent :
    LinearIndependent K (sortedMonomial (K := K) (n := n)) := by
  exact (MvPolynomial.basisMonomials (Variables n) K).linearIndependent.comp
    sortedExponent sortedExponent_injective

/-- The actual degree-two component of the subalgebra generated by the Segre
coordinate monomials, expressed as the span of their products. -/
noncomputable def degreeTwo : Submodule K (MvPolynomial (Variables n) K) :=
  Submodule.span K (Set.range (fun q : Cell n × Cell n =>
    cellPolynomial q.1 * cellPolynomial q.2))

/-- The chain monomials span the whole degree-two Segre component. -/
theorem degreeTwo_eq_span_sorted :
    degreeTwo (K := K) (n := n) = Submodule.span K
      (Set.range (sortedMonomial (K := K) (n := n))) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro f ⟨⟨u, v⟩, rfl⟩
    change cellPolynomial (K := K) u * cellPolynomial v ∈
      Submodule.span K (Set.range (sortedMonomial (K := K) (n := n)))
    rw [cellPolynomial_mul_sort]
    let q : SortedPair n := ⟨(meet u v, join u v), fun i => min_le_max⟩
    have hq : sortedMonomial (K := K) q =
        cellPolynomial (meet u v) * cellPolynomial (join u v) :=
      sortedMonomial_eq_mul q
    rw [← hq]
    exact Submodule.subset_span ⟨q, rfl⟩
  · apply Submodule.span_le.mpr
    rintro f ⟨q, rfl⟩
    rw [sortedMonomial_eq_mul]
    exact Submodule.subset_span ⟨q.val, rfl⟩

/-- A basis of the full degree-two Segre component, with no restrictions on the
number of factors or the chain lengths. -/
noncomputable def degreeTwoBasis : Module.Basis (SortedPair n) K (degreeTwo (K := K) (n := n)) := by
  let b : Module.Basis (SortedPair n) K
      (Submodule.span K (Set.range (sortedMonomial (K := K) (n := n)))) :=
    Module.Basis.span (sortedMonomial_linearIndependent (K := K) (n := n))
  let e : (Submodule.span K (Set.range (sortedMonomial (K := K) (n := n)))) ≃ₗ[K]
      degreeTwo (K := K) (n := n) :=
    LinearEquiv.ofEq _ _ (degreeTwo_eq_span_sorted (K := K) (n := n)).symm
  exact b.map e

end PaperVerification.Segre.Monomials
end
end ProbeLayer6

section ProbeLayer7



/-!
# Balanced multigrading of the actual Segre subalgebra

The Segre algebra is defined as the subalgebra generated by its literal
coordinate monomials. Every polynomial homogeneous of equal degree in each
factor lies in that subalgebra. The proof for arbitrary degree removes one
positive coordinate exponent in every factor and inducts on the common degree.

This provides the multigraded contraction needed to pass ambient polynomial
relations for rank-sum parameters to relations in the actual Segre algebra.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.Balanced

open Staircase Monomials MvPolynomial

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

/-- The actual Segre coordinate algebra, inside the original factor polynomial
ring, with its generators equal to products of one coordinate per factor. -/
noncomputable def segreAlgebra : Subalgebra K (MvPolynomial (Variables n) K) :=
  Algebra.adjoin K (Set.range (cellPolynomial (K := K) (n := n)))

/-- The multidegree of one factor variable. -/
def factorWeight (z : Variables n) : I → ℕ := fun i => if z.1 = i then 1 else 0

/-- Equal degree in all factors. -/
def diagonalDegree (q : ℕ) : I → ℕ := fun _ => q

theorem diagonalDegree_add (q r : ℕ) :
    diagonalDegree (I := I) (q + r) = diagonalDegree q + diagonalDegree r := rfl

/-- The weighted exponent is exactly the vector of sums in the individual
factor blocks. -/
theorem factorWeight_apply (a : Variables n →₀ ℕ) (i : I) :
    Finsupp.weight (factorWeight (n := n)) a i =
      ∑ j : Fin (n i + 1), a ⟨i,j⟩ := by
  classical
  rw [Finsupp.weight_eq_sum]
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  rw [Fintype.sum_sigma, Finset.sum_eq_single i]
  · simp [factorWeight]
  · intro j _ hji
    simp [factorWeight, hji]
  · simp

theorem cell_weight (u : Cell n) :
    Finsupp.weight (factorWeight (n := n)) (cellExponent u) = diagonalDegree 1 := by
  funext i
  rw [factorWeight_apply]
  simp [cellExponent_apply, diagonalDegree]

/-- The only exponent with multidegree zero is the zero exponent. -/
theorem exponent_eq_zero_of_weight_zero (a : Variables n →₀ ℕ)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree 0) : a = 0 := by
  ext z
  rcases z with ⟨i,j⟩
  have hi : (∑ j : Fin (n i + 1), a ⟨i,j⟩) = 0 := by
    rw [← factorWeight_apply, ha]
    rfl
  exact (Finset.sum_eq_zero_iff.mp hi) j (Finset.mem_univ _)

/-- A positive balanced exponent contains one complete Segre generator. -/
theorem exists_cellExponent_le (q : ℕ) (a : Variables n →₀ ℕ)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree (q + 1)) :
    ∃ u : Cell n, cellExponent u ≤ a := by
  classical
  have hi : ∀ i : I, ∃ j : Fin (n i + 1), 0 < a ⟨i,j⟩ := by
    intro i
    by_contra h
    have hz : ∀ j : Fin (n i + 1), a ⟨i,j⟩ = 0 :=
      fun j => Nat.eq_zero_of_not_pos (fun hp => h ⟨j,hp⟩)
    have hs := congrFun ha i
    rw [factorWeight_apply] at hs
    simp [hz, diagonalDegree] at hs
  choose u hu using hi
  refine ⟨u, ?_⟩
  intro z
  rcases z with ⟨i,j⟩
  by_cases h : u i = j
  · subst j
    rw [cellExponent_apply, if_pos rfl]
    exact Nat.succ_le_iff.mpr (hu i)
  · simp [cellExponent_apply, h]

/-- All balanced monomials, in every degree, belong to the actual generated
Segre subalgebra. The coefficient is arbitrary in the ground field. -/
theorem balanced_monomial_mem (q : ℕ) (a : Variables n →₀ ℕ)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree q) (c : K) :
    monomial a c ∈ segreAlgebra (K := K) (n := n) := by
  induction q generalizing a with
  | zero =>
      have he := exponent_eq_zero_of_weight_zero a ha
      subst a
      exact (segreAlgebra (K := K) (n := n)).algebraMap_mem c
  | succ q ih =>
      obtain ⟨u, hu⟩ := exists_cellExponent_le q a ha
      let b := a - cellExponent u
      have he : b + cellExponent u = a := tsub_add_cancel_of_le hu
      have hb : Finsupp.weight (factorWeight (n := n)) b = diagonalDegree q := by
        funext i
        have hw := congrArg (fun d => Finsupp.weight (factorWeight (n := n)) d i) he
        rw [map_add, Pi.add_apply, cell_weight, ha] at hw
        dsimp [diagonalDegree] at hw ⊢
        omega
      have hcell : cellPolynomial (K := K) u ∈ segreAlgebra (K := K) (n := n) :=
        Algebra.subset_adjoin (Set.mem_range_self u)
      have hprod := (segreAlgebra (K := K) (n := n)).mul_mem hcell (ih b hb)
      have hpoly : cellPolynomial (K := K) u * monomial b c = monomial a c := by
        rw [cellPolynomial, monomial_mul_monomial, one_mul, add_comm, he]
      exact hpoly ▸ hprod

/-- Every balanced homogeneous polynomial is a Segre polynomial. This is a
proof about the original subalgebra, not a replacement definition of it. -/
theorem balancedComponent_le_segreAlgebra (q : ℕ) :
    weightedHomogeneousSubmodule K (factorWeight (n := n)) (diagonalDegree q) ≤
      (segreAlgebra (K := K) (n := n)).toSubmodule := by
  intro f hf
  rw [MvPolynomial.as_sum f]
  apply Submodule.sum_mem
  intro a ha
  exact balanced_monomial_mem q a (hf (MvPolynomial.mem_support_iff.mp ha)) (f.coeff a)

/-- In particular each balanced homogeneous projection lies in the actual
Segre algebra, even when the original polynomial did not. -/
theorem balancedProjection_mem (q : ℕ) (f : MvPolynomial (Variables n) K) :
    weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree q) f ∈
      segreAlgebra (K := K) (n := n) :=
  balancedComponent_le_segreAlgebra q
    (weightedHomogeneousComponent_mem (factorWeight (n := n)) f (diagonalDegree q))

/-- A Segre coordinate is homogeneous of diagonal multidegree one. -/
theorem cellPolynomial_homogeneous (u : Cell n) :
    (cellPolynomial (K := K) u).IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree 1) :=
  isWeightedHomogeneous_monomial _ _ _ (cell_weight u)

/-- Removing a contained Segre coordinate lowers every factor degree by one. -/
theorem exponent_sub_cell_weight (q : ℕ) (a : Variables n →₀ ℕ) (u : Cell n)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree (q + 1))
    (hu : cellExponent u ≤ a) :
    Finsupp.weight (factorWeight (n := n)) (a - cellExponent u) = diagonalDegree q := by
  have he : (a - cellExponent u) + cellExponent u = a := tsub_add_cancel_of_le hu
  funext i
  have hw := congrArg (fun d => Finsupp.weight (factorWeight (n := n)) d i) he
  rw [map_add, Pi.add_apply, cell_weight, ha] at hw
  dsimp [diagonalDegree] at hw ⊢
  omega

/-- Balanced degree-one monomials are exactly the Segre coordinates. -/
theorem balanced_one_exponent (a : Variables n →₀ ℕ)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree 1) :
    ∃ u : Cell n, a = cellExponent u := by
  obtain ⟨u, hu⟩ := exists_cellExponent_le 0 a ha
  have hz := exponent_eq_zero_of_weight_zero (a - cellExponent u)
    (exponent_sub_cell_weight 0 a u ha hu)
  refine ⟨u, ?_⟩
  have he := tsub_add_cancel_of_le hu
  simpa only [hz, zero_add] using he.symm

/-- Balanced degree-two monomials are precisely products of two Segre
coordinates. Their sorted basis was proved independently in `SegreMonomials`. -/
theorem balanced_two_exponent (a : Variables n →₀ ℕ)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree 2) :
    ∃ u v : Cell n, a = cellExponent u + cellExponent v := by
  obtain ⟨u, hu⟩ := exists_cellExponent_le 1 a ha
  obtain ⟨v, hv⟩ := balanced_one_exponent (a - cellExponent u)
    (exponent_sub_cell_weight 1 a u ha hu)
  refine ⟨u, v, ?_⟩
  have he := tsub_add_cancel_of_le hu
  simpa only [hv, add_comm] using he.symm

/-- The previously defined degree-one polynomial space is the full balanced
homogeneous component, with equality of actual submodules. -/
theorem degreeOne_eq_balanced : degreeOne (K := K) (n := n) =
    weightedHomogeneousSubmodule K (factorWeight (n := n)) (diagonalDegree 1) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro f ⟨u, rfl⟩
    exact cellPolynomial_homogeneous u
  · intro f hf
    rw [MvPolynomial.as_sum f]
    apply Submodule.sum_mem
    intro a ha
    obtain ⟨u, hu⟩ := balanced_one_exponent a (hf (MvPolynomial.mem_support_iff.mp ha))
    rw [hu]
    have he : monomial (cellExponent u) (f.coeff (cellExponent u)) =
        f.coeff (cellExponent u) • cellPolynomial (K := K) u := by
      simp [cellPolynomial, MvPolynomial.smul_monomial]
    rw [he]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self u))

/-- The degree-two space used in every multiplication-rank calculation is the
full actual balanced homogeneous component. -/
theorem degreeTwo_eq_balanced : degreeTwo (K := K) (n := n) =
    weightedHomogeneousSubmodule K (factorWeight (n := n)) (diagonalDegree 2) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro f ⟨⟨u,v⟩, rfl⟩
    change (cellPolynomial (K := K) u * cellPolynomial v).IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree 2)
    simpa only [← diagonalDegree_add] using
      (cellPolynomial_homogeneous (K := K) u).mul (cellPolynomial_homogeneous v)
  · intro f hf
    rw [MvPolynomial.as_sum f]
    apply Submodule.sum_mem
    intro a ha
    obtain ⟨u, v, huv⟩ := balanced_two_exponent a (hf (MvPolynomial.mem_support_iff.mp ha))
    have he : monomial a (f.coeff a) =
        f.coeff a • (cellPolynomial (K := K) u * cellPolynomial v) := by
      simp [huv, cellPolynomial, monomial_mul_monomial, MvPolynomial.smul_monomial]
    rw [he]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self (u,v)))

/-- Homogeneous projection of a product by a balanced linear form. -/
theorem project_mul_linear (f g : MvPolynomial (Variables n) K)
    (hf : f.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree 1))
    (q : ℕ) :
    weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree (q + 1)) (f * g) =
      f * weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree q) g := by
  classical
  letI := weightedGradedAlgebra K (factorWeight (n := n))
  have h := DirectSum.coe_decompose_mul_add_of_left_mem
    (𝒜 := weightedHomogeneousSubmodule K (factorWeight (n := n)))
    (j := diagonalDegree q) hf (b := g)
  have hd : diagonalDegree (I := I) 1 + diagonalDegree q = diagonalDegree (q + 1) := by
    funext i
    simp [diagonalDegree, Nat.add_comm]
  change
    ((weightedDecomposition K (factorWeight (n := n))).decompose' (f * g)
      (diagonalDegree 1 + diagonalDegree q) : MvPolynomial (Variables n) K) =
      f * ((weightedDecomposition K (factorWeight (n := n))).decompose' g
        (diagonalDegree q) : MvPolynomial (Variables n) K) at h
  rw [weightedDecomposition.decompose'_apply, weightedDecomposition.decompose'_apply,
    hd] at h
  exact h

/-- The diagonal degree-zero projection is the literal constant coefficient. -/
theorem balancedProjection_zero (f : MvPolynomial (Variables n) K) :
    weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree 0) f =
      MvPolynomial.C (f.coeff 0) := by
  apply weightedHomogeneousComponent_zero
  intro z hz
  have h := congrFun hz z.1
  simpa [factorWeight] using h

theorem balanced_zero_polynomial (f : MvPolynomial (Variables n) K)
    (hf : f.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree 0)) :
    f = MvPolynomial.C (f.coeff 0) :=
  hf.weightedHomogeneousComponent_same.symm.trans (balancedProjection_zero f)

/-- Every homogeneous relation in an ideal generated by balanced linear forms
has multipliers of the uniquely relevant balanced degree. This is an explicit
representation theorem for the actual polynomial ideal. -/
theorem homogeneous_ideal_representation {D : Type*} [Fintype D]
    (θ : D → MvPolynomial (Variables n) K)
    (hθ : ∀ j, (θ j).IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree 1))
    (q : ℕ) (f : MvPolynomial (Variables n) K)
    (hf : f.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree (q + 1)))
    (hmem : f ∈ Ideal.span (Set.range θ)) :
    ∃ c : D → MvPolynomial (Variables n) K,
      (∀ j, (c j).IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree q)) ∧
        ∑ j, c j * θ j = f := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  let d := fun j => weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree q) (c j)
  refine ⟨d, fun j => weightedHomogeneousComponent_isWeightedHomogeneous _ _, ?_⟩
  have h := congrArg
    (weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree (q + 1))) hc
  rw [map_sum, hf.weightedHomogeneousComponent_same] at h
  calc
    _ = ∑ j, weightedHomogeneousComponent (factorWeight (n := n))
        (diagonalDegree (q + 1)) (c j * θ j) := by
      apply Finset.sum_congr rfl
      intro j _
      rw [mul_comm (c j) (θ j), project_mul_linear _ _ (hθ j) q]
      exact mul_comm _ _
    _ = f := h

section Contraction

variable {D : Type*} [Fintype D]

/-- The internal parameter ideal in the actual Segre algebra. -/
noncomputable def parameterIdeal (θ : D → segreAlgebra (K := K) (n := n)) :
    Ideal (segreAlgebra (K := K) (n := n)) := Ideal.span (Set.range θ)

/-- The same generators in the full polynomial ring on the factor variables. -/
noncomputable def ambientParameterIdeal (θ : D → segreAlgebra (K := K) (n := n)) :
    Ideal (MvPolynomial (Variables n) K) := Ideal.span (Set.range fun j => (θ j).val)

theorem mem_ambient_of_mem_parameterIdeal
    (θ : D → segreAlgebra (K := K) (n := n)) {f : segreAlgebra (K := K) (n := n)}
    (hf : f ∈ parameterIdeal θ) : f.val ∈ ambientParameterIdeal θ := by
  have hle : parameterIdeal θ ≤ (ambientParameterIdeal θ).comap (segreAlgebra).val.toRingHom := by
    apply Ideal.span_le.mpr
    rintro x ⟨j, rfl⟩
    exact Ideal.subset_span (Set.mem_range_self j)
  exact hle hf

/-- A positive balanced homogeneous relation in the ambient parameter ideal
contracts to the internal ideal of the actual Segre algebra. The proof projects
all multipliers to the required balanced degree. -/
theorem homogeneous_mem_parameterIdeal
    (θ : D → segreAlgebra (K := K) (n := n))
    (hθ : ∀ j, (θ j).val.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree 1))
    (q : ℕ) (f : segreAlgebra (K := K) (n := n))
    (hf : f.val.IsWeightedHomogeneous (factorWeight (n := n)) (diagonalDegree (q + 1)))
    (hmem : f.val ∈ ambientParameterIdeal θ) : f ∈ parameterIdeal θ := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  let d : D → segreAlgebra (K := K) (n := n) := fun j =>
    ⟨weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree q) (c j),
      balancedProjection_mem q (c j)⟩
  apply Ideal.mem_span_range_iff_exists_fun.mpr
  refine ⟨d, ?_⟩
  apply Subtype.ext
  change (segreAlgebra (K := K) (n := n)).val (∑ j, d j * θ j) = f.val
  rw [map_sum]
  simp only [map_mul]
  have h := congrArg
    (weightedHomogeneousComponent (factorWeight (n := n)) (diagonalDegree (q + 1))) hc
  rw [map_sum, hf.weightedHomogeneousComponent_same] at h
  calc
    _ = ∑ j, weightedHomogeneousComponent (factorWeight (n := n))
        (diagonalDegree (q + 1)) (c j * (θ j).val) := by
      apply Finset.sum_congr rfl
      intro j _
      rw [mul_comm (c j) ((θ j).val), project_mul_linear _ _ (hθ j) q]
      exact mul_comm _ _
    _ = f.val := h

end Contraction

end PaperVerification.Segre.Balanced
end
end ProbeLayer7

section ProbeLayer8



/-!
# Products of coefficient ideals

The coefficients of a product of univariate polynomials force every product
of one coefficient from each factor into their radical. This holds over any
commutative ring and is the nilpotence input for the fixed Segre rank sums.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open scoped BigOperators

namespace PaperVerification.Segre.ContentRadical

variable {R I : Type*} [CommRing R]

theorem mul_radical_le_radical_mul (J L : Ideal R) :
    J * L.radical ≤ (J * L).radical := by
  rw [Ideal.radical_mul]
  exact le_inf (Ideal.mul_le_left.trans Ideal.le_radical) Ideal.mul_le_right

/-- The whole product of coefficient ideals is contained in the radical of
the coefficient ideal of the literal product polynomial. -/
theorem prod_contentIdeal_le_radical (s : Finset I) (p : I → Polynomial R) :
    (∏ i ∈ s, (p i).contentIdeal) ≤
      (∏ i ∈ s, p i).contentIdeal.radical := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.prod_insert hi]
    exact (Ideal.mul_mono le_rfl ih).trans
      ((mul_radical_le_radical_mul _ _).trans
        (Ideal.radical_le_radical_iff.mpr
          (Polynomial.mul_contentIdeal_le_radical_contentIdeal_mul
            (p := p i) (q := ∏ j ∈ s, p j))))

/-- Every selected coefficient product is nilpotent modulo the coefficients
of the product polynomial; no field or characteristic hypothesis is used. -/
theorem selected_coeff_product_mem_radical (s : Finset I)
    (p : I → Polynomial R) (degree : I → ℕ) :
    (∏ i ∈ s, (p i).coeff (degree i)) ∈
      (∏ i ∈ s, p i).contentIdeal.radical :=
  prod_contentIdeal_le_radical s p
    (Ideal.prod_mem_prod (fun i _ => (p i).coeff_mem_contentIdeal (degree i)))

theorem selected_coeff_product_mem_radical_univ [Fintype I]
    (p : I → Polynomial R) (degree : I → ℕ) :
    (∏ i, (p i).coeff (degree i)) ∈ (∏ i, p i).contentIdeal.radical :=
  selected_coeff_product_mem_radical Finset.univ p degree

/-- The content ideal really is generated by all coefficients, including
zero coefficients; this form connects it directly to coefficient equations. -/
theorem contentIdeal_eq_span_range_coeff (p : Polynomial R) :
    p.contentIdeal = Ideal.span (Set.range p.coeff) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro x hx
    obtain ⟨j, _, rfl⟩ := Polynomial.mem_coeffs_iff.mp hx
    exact Ideal.subset_span ⟨j, rfl⟩
  · apply Ideal.span_le.mpr
    rintro x ⟨j, rfl⟩
    exact p.coeff_mem_contentIdeal j

end PaperVerification.Segre.ContentRadical
end
end
end ProbeLayer8

section ProbeLayer9



/-!
# Rank-indexed Segre parameter definitions

These elementary definitions are shared by the actual Artinian quotient and
by the separate degree-two rigidity argument. No rigidity or syzygy theorem
is needed to define the literal rank sums.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.RankParameters

open Staircase Matrix
open scoped Matrix

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

abbrev Ranks (n : I → ℕ) := Fin (sideSum n + 1)

def rankIndex (u : Cell n) : Ranks n := ⟨rank u, Nat.lt_succ_of_le (rank_le_sideSum u)⟩

@[simp] theorem rankIndex_val (u : Cell n) : (rankIndex u).val = rank u := rfl

/-- The literal comparability graph of the full product of chains. -/
def chainGraph (n : I → ℕ) : SimpleGraph (Cell n) where
  Adj u v := u ≠ v ∧ (u ≤ v ∨ v ≤ u)
  symm.symm := fun _ _ h => ⟨h.1.symm, h.2.symm⟩
  loopless.irrefl := fun _ h => h.1 rfl

instance chainGraph_decidable (n : I → ℕ) : DecidableRel (chainGraph n).Adj :=
  fun u v => inferInstanceAs (Decidable (u ≠ v ∧ (u ≤ v ∨ v ≤ u)))

/-- Coefficient matrix of the rank-sum parameters. -/
def rankForms : Matrix (Cell n) (Ranks n) K :=
  fun u r => if rankIndex u = r then 1 else 0

theorem rankForms_mul (Q : Matrix (Ranks n) (Ranks n) K) (u : Cell n) (r : Ranks n) :
    ((rankForms (K := K) (n := n)) * Q) u r = Q (rankIndex u) r := by
  simp [Matrix.mul_apply, rankForms, ite_mul]

end PaperVerification.Segre.RankParameters
end
end ProbeLayer9

section ProbeLayer10



/-!
# The literal rank-sum Segre quotient is Artinian

The rank parameters are coefficients of a product of univariate polynomials in
the original factor variables. The content-ideal theorem puts every Segre
coordinate in the radical of their ambient ideal. Balanced homogeneous
projection contracts a positive power relation to the actual Segre subalgebra.
The quotient is generated by finitely many nilpotent elements, so it is finite
over the ground field and hence Artinian.

No Cohen--Macaulayness, regular-sequence theorem, Artinian hypothesis, or
characteristic restriction is used in this proof.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.Artinian

open Staircase Monomials Balanced RankParameters

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

/-- A Segre coordinate as an element of the actual generated algebra. -/
noncomputable def coordinate (u : Cell n) : segreAlgebra (K := K) (n := n) :=
  ⟨cellPolynomial u, Algebra.subset_adjoin (Set.mem_range_self u)⟩

/-- The prescribed antidiagonal rank sum, inside the Segre algebra itself. -/
noncomputable def rankParameter (r : Ranks n) : segreAlgebra (K := K) (n := n) :=
  ∑ u : Cell n, rankForms (K := K) u r • coordinate (K := K) u

theorem rankParameter_value (r : Ranks n) :
    (rankParameter (K := K) r).val =
      ∑ u : Cell n, if rank u = r.val then cellPolynomial u else 0 := by
  change (segreAlgebra (K := K) (n := n)).val
    (∑ u : Cell n, rankForms (K := K) u r • coordinate (K := K) u) = _
  simp only [map_sum, map_smul]
  apply Finset.sum_congr rfl
  intro u _
  simp [rankForms, rankIndex, coordinate, Fin.ext_iff, ite_smul]

theorem rankParameter_homogeneous (r : Ranks n) :
    (rankParameter (K := K) r).val.IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree 1) := by
  rw [rankParameter_value]
  apply (MvPolynomial.weightedHomogeneousSubmodule K (factorWeight (n := n))
    (diagonalDegree 1)).sum_mem
  intro u _
  split_ifs
  · exact cellPolynomial_homogeneous u
  · exact Submodule.zero_mem _

/-- The coordinate polynomial of one factor. -/
noncomputable def factorPolynomial (i : I) : Polynomial (MvPolynomial (Variables n) K) :=
  ∑ j : Fin (n i + 1), Polynomial.monomial j.val (MvPolynomial.X ⟨i,j⟩)

theorem factorPolynomial_coeff (i : I) (j : Fin (n i + 1)) :
    (factorPolynomial (K := K) i).coeff j.val = MvPolynomial.X ⟨i,j⟩ := by
  classical
  simp only [factorPolynomial, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
  rw [Finset.sum_eq_single j]
  · simp
  · intro k _ hkj
    have hv : k.val ≠ j.val := fun h => hkj (Fin.ext h)
    simp [hv]
  · simp

theorem prod_polynomial_monomials {J A : Type*} [CommSemiring A]
    (s : Finset J) (d : J → ℕ) (a : J → A) :
    (∏ j ∈ s, Polynomial.monomial (d j) (a j)) =
      Polynomial.monomial (∑ j ∈ s, d j) (∏ j ∈ s, a j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert j s hj ih =>
      simp only [Finset.prod_insert hj, Finset.sum_insert hj, ih,
        Polynomial.monomial_mul_monomial]

/-- Expand the literal product: its degree-`r` coefficient is the rank sum. -/
theorem product_factorPolynomial :
    (∏ i, factorPolynomial (K := K) (n := n) i) =
      ∑ u : Cell n, Polynomial.monomial (rank u) (cellPolynomial u) := by
  simp only [factorPolynomial, Fintype.prod_sum]
  apply Finset.sum_congr rfl
  intro u _
  rw [prod_polynomial_monomials]
  congr 1
  exact (cellPolynomial_eq_prod u).symm

theorem product_factorPolynomial_coeff (j : ℕ) :
    (∏ i, factorPolynomial (K := K) (n := n) i).coeff j =
      ∑ u : Cell n, if rank u = j then cellPolynomial u else 0 := by
  rw [product_factorPolynomial]
  simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Finsupp.single_apply]

/-- The coefficient ideal of the product is exactly the ambient ideal of the
specified finite family of antidiagonal rank sums. -/
theorem contentIdeal_eq_ambient_rankIdeal :
    (∏ i, factorPolynomial (K := K) (n := n) i).contentIdeal =
      ambientParameterIdeal (rankParameter (K := K) (n := n)) := by
  rw [ContentRadical.contentIdeal_eq_span_range_coeff]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro f ⟨j, rfl⟩
    by_cases hj : j ≤ sideSum n
    · have h : (rankParameter (K := K) ⟨j, Nat.lt_succ_of_le hj⟩).val ∈
          ambientParameterIdeal (rankParameter (K := K) (n := n)) :=
        Ideal.subset_span (Set.mem_range_self _)
      change (∏ i, factorPolynomial (K := K) (n := n) i).coeff j ∈
        ambientParameterIdeal (rankParameter (K := K) (n := n))
      simpa only [rankParameter_value, product_factorPolynomial_coeff] using h
    · rw [product_factorPolynomial_coeff]
      have hzero : ∀ u : Cell n, rank u ≠ j := by
        intro u he
        exact hj (he ▸ rank_le_sideSum u)
      simp [hzero]
  · apply Ideal.span_le.mpr
    rintro f ⟨r, rfl⟩
    change (rankParameter (K := K) r).val ∈
      Ideal.span (Set.range (∏ i, factorPolynomial (K := K) (n := n) i).coeff)
    have h := (∏ i, factorPolynomial (K := K) (n := n) i).coeff_mem_contentIdeal r.val
    rw [ContentRadical.contentIdeal_eq_span_range_coeff] at h
    simpa only [rankParameter_value, product_factorPolynomial_coeff] using h

/-- Every Segre generator is nilpotent modulo the ambient rank-sum ideal. -/
theorem coordinate_mem_ambient_radical (u : Cell n) :
    cellPolynomial (K := K) u ∈
      (ambientParameterIdeal (rankParameter (K := K) (n := n))).radical := by
  have h := ContentRadical.selected_coeff_product_mem_radical_univ
    (factorPolynomial (K := K) (n := n)) (fun i => (u i).val)
  simp only [factorPolynomial_coeff, contentIdeal_eq_ambient_rankIdeal] at h
  simpa only [cellPolynomial_eq_prod] using h

/-- The positive power relation holds in the internal ideal, not merely after
extension to the larger factor-polynomial ring. -/
theorem coordinate_power_mem_internal (u : Cell n) :
    ∃ q : ℕ, 0 < q ∧ coordinate (K := K) u ^ q ∈
      parameterIdeal (rankParameter (K := K) (n := n)) := by
  obtain ⟨q, hq⟩ := Ideal.mem_radical_iff.mp (coordinate_mem_ambient_radical (K := K) u)
  refine ⟨q + 1, Nat.succ_pos _, ?_⟩
  apply homogeneous_mem_parameterIdeal (rankParameter (K := K) (n := n))
    rankParameter_homogeneous q (coordinate u ^ (q + 1))
  · change (cellPolynomial (K := K) u ^ (q + 1)).IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree (q + 1))
    have hd : (q + 1) • diagonalDegree (I := I) 1 = diagonalDegree (q + 1) := by
      funext i
      simp [diagonalDegree, Pi.smul_apply, nsmul_eq_mul]
    simpa only [hd] using
      (cellPolynomial_homogeneous (K := K) u).pow (q + 1)
  · change cellPolynomial u ^ (q + 1) ∈ ambientParameterIdeal _
    rw [pow_succ']
    exact Ideal.mul_mem_left _ _ hq

/-- The literal quotient of the actual Segre subalgebra by the fixed rank sums. -/
abbrev Reduction := segreAlgebra (K := K) (n := n) ⧸
  parameterIdeal (rankParameter (K := K) (n := n))

noncomputable def residueCoordinate (u : Cell n) : Reduction (K := K) (n := n) :=
  Ideal.Quotient.mk _ (coordinate u)

theorem residueCoordinate_nilpotent (u : Cell n) :
    IsNilpotent (residueCoordinate (K := K) u) := by
  obtain ⟨q, _, hq⟩ := coordinate_power_mem_internal (K := K) u
  refine ⟨q, ?_⟩
  rw [residueCoordinate, ← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact hq

/-- The quotient is generated by the actual residue coordinates. -/
theorem residueCoordinates_generate :
    Algebra.adjoin K (Set.range (residueCoordinate (K := K) (n := n))) = ⊤ := by
  let π := Ideal.Quotient.mkₐ K (parameterIdeal (rankParameter (K := K) (n := n)))
  let A := Algebra.adjoin K (Set.range (residueCoordinate (K := K) (n := n)))
  have hgen : ∀ (f : MvPolynomial (Variables n) K) (hf : f ∈ segreAlgebra),
      π ⟨f, hf⟩ ∈ A := by
    intro f hf
    induction hf using Algebra.adjoin_induction with
    | mem f hf =>
        obtain ⟨u, rfl⟩ := hf
        exact Algebra.subset_adjoin (Set.mem_range_self u)
    | algebraMap c =>
        change π (algebraMap K (segreAlgebra (K := K) (n := n)) c) ∈ A
        rw [AlgHom.commutes]
        exact A.algebraMap_mem c
    | add f g hf hg ihf ihg =>
        change π (⟨f,hf⟩ + ⟨g,hg⟩) ∈ A
        rw [map_add]
        exact A.add_mem ihf ihg
    | mul f g hf hg ihf ihg =>
        change π (⟨f,hf⟩ * ⟨g,hg⟩) ∈ A
        rw [map_mul]
        exact A.mul_mem ihf ihg
  apply top_unique
  intro z _
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mkₐ_surjective K
    (parameterIdeal (rankParameter (K := K) (n := n))) z
  exact hgen f.val f.property

/-- The fixed rank-sum quotient is finite dimensional over the field. This
establishes actual Artinianness for all factor counts and all chain lengths. -/
theorem reduction_finite : Module.Finite K (Reduction (K := K) (n := n)) := by
  let A := Algebra.adjoin K (Set.range (residueCoordinate (K := K) (n := n)))
  have hint (u : Cell n) : IsIntegral K (residueCoordinate (K := K) u) := by
    obtain ⟨q, hq⟩ := residueCoordinate_nilpotent (K := K) u
    refine ⟨(Polynomial.X ^ q : Polynomial K), Polynomial.monic_X_pow q, ?_⟩
    change Polynomial.eval₂ (algebraMap K (Reduction (K := K) (n := n)))
      (residueCoordinate (K := K) u) (Polynomial.X ^ q) = 0
    rw [Polynomial.eval₂_X_pow]
    exact hq
  haveI : Module.Finite K A := Algebra.finite_adjoin_of_finite_of_isIntegral
    (R := K) (A := Reduction (K := K) (n := n))
    (s := Set.range (residueCoordinate (K := K) (n := n)))
    (Set.finite_range _) (by rintro x ⟨u, rfl⟩; exact hint u)
  apply Module.Finite.of_surjective A.val.toLinearMap
  intro x
  refine ⟨⟨x, ?_⟩, rfl⟩
  change x ∈ Algebra.adjoin K (Set.range (residueCoordinate (K := K) (n := n)))
  rw [residueCoordinates_generate]
  trivial

/-- The literal quotient is an Artinian ring, without an Artinian assumption
in its definition or in the hypotheses. -/
theorem reduction_isArtinian : IsArtinianRing (Reduction (K := K) (n := n)) := by
  letI := reduction_finite (K := K) (n := n)
  exact IsArtinianRing.of_finite K _

end PaperVerification.Segre.Artinian
end
end ProbeLayer10

section ProbeLayer11



/-!
# Every homogeneous piece of the actual Segre algebra

The degree-q space is the span of literal products of q Segre generators. It is
finite dimensional because the index set of such words is finite. An induction
on balanced monomial exponents identifies this space with the full balanced
homogeneous component; no Hilbert-series or Cohen--Macaulay theorem is assumed.
-/

set_option autoImplicit false

@[expose] public section

namespace PaperVerification.Segre.HigherPieces

open Staircase Monomials Balanced Artinian MvPolynomial

variable {I K : Type*} [Fintype I] [DecidableEq I] [Field K] {n : I → ℕ}

noncomputable def wordPolynomial (q : ℕ) (w : Fin q → Cell n) :
    MvPolynomial (Variables n) K := ∏ j, cellPolynomial (w j)

noncomputable def piece (q : ℕ) : Submodule K (MvPolynomial (Variables n) K) :=
  Submodule.span K (Set.range (wordPolynomial (K := K) (n := n) q))

instance piece_finite (q : ℕ) : Module.Finite K (piece (K := K) (n := n) q) :=
  Module.Finite.span_of_finite K (Set.finite_range _)

theorem wordPolynomial_succ (q : ℕ) (w : Fin (q + 1) → Cell n) :
    wordPolynomial (K := K) (q + 1) w =
      cellPolynomial (w 0) * wordPolynomial q (fun j => w j.succ) :=
  Fin.prod_univ_succ _

theorem wordPolynomial_cons (q : ℕ) (u : Cell n) (w : Fin q → Cell n) :
    wordPolynomial (K := K) (q + 1) (Fin.cons u w) =
      cellPolynomial u * wordPolynomial q w := by
  rw [wordPolynomial_succ]
  rfl

theorem wordPolynomial_homogeneous (q : ℕ) (w : Fin q → Cell n) :
    (wordPolynomial (K := K) q w).IsWeightedHomogeneous
      (factorWeight (n := n)) (diagonalDegree q) := by
  induction q with
  | zero =>
      simp only [wordPolynomial, Finset.univ_eq_empty, Finset.prod_empty]
      exact isWeightedHomogeneous_one K _
  | succ q ih =>
      rw [wordPolynomial_succ]
      have h := (cellPolynomial_homogeneous (K := K) (w 0)).mul
        (ih (fun j => w j.succ))
      simpa only [← diagonalDegree_add, Nat.add_comm 1 q] using h

theorem cell_mul_mem_piece (q : ℕ) (u : Cell n)
    {f : MvPolynomial (Variables n) K} (hf : f ∈ piece (K := K) (n := n) q) :
    cellPolynomial u * f ∈ piece (K := K) (n := n) (q + 1) := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
      obtain ⟨w,rfl⟩ := hf
      rw [← wordPolynomial_cons]
      exact Submodule.subset_span (Set.mem_range_self _)
  | zero => simp
  | add f g hf hg ihf ihg =>
      rw [mul_add]
      exact Submodule.add_mem _ ihf ihg
  | smul c f hf ih =>
      rw [mul_smul_comm]
      exact Submodule.smul_mem _ _ ih

theorem balanced_monomial_mem_piece (q : ℕ) (a : Variables n →₀ ℕ)
    (ha : Finsupp.weight (factorWeight (n := n)) a = diagonalDegree q) (c : K) :
    monomial a c ∈ piece (K := K) (n := n) q := by
  induction q generalizing a with
  | zero =>
      have he := exponent_eq_zero_of_weight_zero a ha
      subst a
      have h : wordPolynomial (K := K) 0 (fun j => Fin.elim0 j) ∈
          piece (K := K) (n := n) 0 := Submodule.subset_span (Set.mem_range_self _)
      simpa [wordPolynomial, MvPolynomial.smul_eq_C_mul] using
        Submodule.smul_mem (piece (K := K) (n := n) 0) c h
  | succ q ih =>
      obtain ⟨u,hu⟩ := exists_cellExponent_le q a ha
      have hb := exponent_sub_cell_weight q a u ha hu
      have he : (a - cellExponent u) + cellExponent u = a := tsub_add_cancel_of_le hu
      have h := cell_mul_mem_piece q u (ih (a - cellExponent u) hb)
      have hp : cellPolynomial (K := K) u * monomial (a - cellExponent u) c =
          monomial a c := by
        rw [cellPolynomial, monomial_mul_monomial, one_mul, add_comm, he]
      exact hp ▸ h

/-- Equality with the entire balanced homogeneous component. -/
theorem piece_eq_balanced (q : ℕ) : piece (K := K) (n := n) q =
    weightedHomogeneousSubmodule K (factorWeight (n := n)) (diagonalDegree q) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro f ⟨w,rfl⟩
    exact wordPolynomial_homogeneous q w
  · intro f hf
    rw [MvPolynomial.as_sum f]
    apply Submodule.sum_mem
    intro a ha
    exact balanced_monomial_mem_piece q a (hf (MvPolynomial.mem_support_iff.mp ha)) (f.coeff a)

noncomputable def pieceBasis (q : ℕ) :
    Module.Basis (Fin (Module.finrank K (piece (K := K) (n := n) q))) K
      (piece (K := K) (n := n) q) := Module.finBasis K _

/-- The actual ideal generated by the degree-one Segre coordinates. -/
noncomputable def irrelevantIdeal : Ideal (segreAlgebra (K := K) (n := n)) :=
  Ideal.span (Set.range (coordinate (K := K) (n := n)))

theorem word_mem_irrelevant_power (q : ℕ) (w : Fin q → Cell n) :
    (∏ j, coordinate (K := K) (w j)) ∈ irrelevantIdeal (K := K) (n := n) ^ q := by
  induction q with
  | zero => simp
  | succ q ih =>
      rw [Fin.prod_univ_succ, pow_succ']
      exact Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_range_self (w 0)))
        (ih (fun j => w j.succ))

/-- The fixed rank-sum ideal contains a positive power of the actual irrelevant
ideal. This finite-generation consequence is the input to the open certificate. -/
theorem exists_irrelevant_power_le_rankIdeal :
    ∃ q : ℕ, irrelevantIdeal (K := K) (n := n) ^ (q + 1) ≤
      parameterIdeal (rankParameter (K := K) (n := n)) := by
  have hrad : irrelevantIdeal (K := K) (n := n) ≤
      (parameterIdeal (rankParameter (K := K) (n := n))).radical := by
    apply Ideal.span_le.mpr
    rintro x ⟨u,rfl⟩
    obtain ⟨q,_,hq⟩ := coordinate_power_mem_internal (K := K) u
    exact Ideal.mem_radical_iff.mpr ⟨q,hq⟩
  have hfg : (irrelevantIdeal (K := K) (n := n)).FG :=
    Submodule.fg_span (Set.finite_range _)
  obtain ⟨q,hq⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad hfg
  refine ⟨q, ?_⟩
  exact (Ideal.pow_le_pow_right (Nat.le_succ q)).trans hq

/-- Every sufficiently high homogeneous polynomial is in the actual ambient
rank-sum ideal, using only literal products and the proved irrelevant power. -/
theorem piece_le_rankIdeal (q : ℕ)
    (hq : irrelevantIdeal (K := K) (n := n) ^ (q + 1) ≤
      parameterIdeal (rankParameter (K := K) (n := n))) :
    piece (K := K) (n := n) (q + 1) ≤
      (ambientParameterIdeal (rankParameter (K := K) (n := n))).restrictScalars K := by
  apply Submodule.span_le.mpr
  rintro f ⟨w,rfl⟩
  have h := mem_ambient_of_mem_parameterIdeal _ (hq (word_mem_irrelevant_power (q + 1) w))
  change (segreAlgebra (K := K) (n := n)).val (∏ j, coordinate (w j)) ∈ _ at h
  change wordPolynomial (K := K) (q + 1) w ∈
    ambientParameterIdeal (rankParameter (K := K) (n := n))
  simpa only [map_prod, coordinate, wordPolynomial, Subalgebra.val_apply] using h

end PaperVerification.Segre.HigherPieces
end
end ProbeLayer11

section ProbeLayer12

/-
