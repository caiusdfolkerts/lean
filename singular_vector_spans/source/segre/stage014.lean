/-!
# Acyclicity of affine direct images

The proof uses an actual injective resolution, the proved vanishing of higher
direct images of quasi-coherent modules along affine morphisms, and the genuine
cohomology of the resulting complex of sections.
-/

@[expose] public section

noncomputable section
open CategoryTheory CategoryTheory.Limits TopologicalSpace AlgebraicGeometry Opposite
open TauCeti.AlgebraicGeometry TauCeti.AlgebraicGeometry.Scheme.Modules

namespace PaperVerification.Segre.AffineDirectImage

universe u
variable {X Y : Scheme.{u}} (f : X ⟶ Y) [IsAffineHom f]
  (M : X.Modules) [M.IsQuasicoherent]

/-- Vanishing on the preimage of an open transfers to the actual direct image
for an affine morphism and a quasi-coherent module. -/
theorem cohomologyOn_pushforward_vanishing (V : Y.Opens) (q : ℕ)
    (hM : Subsingleton (Scheme.Modules.cohomologyOn M (q + 1) (f ⁻¹ᵁ V))) :
    Subsingleton
      (Scheme.Modules.cohomologyOn ((Scheme.Modules.pushforward f).obj M) (q + 1) V) := by
  have := (Scheme.Modules.pushforward f).additive_of_preserves_binary_products
  let P := injectiveResolution M
  haveI : Mono (P.ι.f 0) := mono_of_isLimit_fork P.isLimitKernelFork
  let L := ((Scheme.Modules.pushforward f).mapHomologicalComplex _).obj P.cocomplex
  let K := ((toSheaf Y).mapHomologicalComplex _).obj L
  let a := (toSheaf Y).map ((Scheme.Modules.pushforward f).map (P.ι.f 0))
  have ha : a ≫ K.d 0 1 = 0 := by
    change (toSheaf Y).map ((Scheme.Modules.pushforward f).map (P.ι.f 0)) ≫
      (toSheaf Y).map ((Scheme.Modules.pushforward f).map (P.cocomplex.d 0 1)) = 0
    rw [← Functor.map_comp, ← Functor.map_comp, P.ι_f_zero_comp_complex_d,
      Functor.map_zero, Functor.map_zero]
  have ha' : (ShortComplex.mk a (K.d 0 1) ha).Exact := by
    have hP := ShortComplex.exact_of_f_is_kernel
      (S := ShortComplex.mk _ _ P.ι_f_zero_comp_complex_d) P.isLimitKernelFork
    exact (hP.map_of_mono_of_preservesKernel
      (Scheme.Modules.pushforward f) inferInstance inferInstance).map (toSheaf Y)
  haveI : Mono a := by
    haveI : Mono ((Scheme.Modules.pushforward f).map (P.ι.f 0)) :=
      Functor.map_mono _ _
    exact Functor.map_mono (toSheaf Y) _
  have hK (j : ℕ) : K.ExactAt (j + 1) := by
    have hzero : IsZero (L.homology (j + 1)) :=
      IsZero.of_iso (f.isZero_higherDirectImage_succ_of_isAffineHom M j)
        (P.isoRightDerivedObj (Scheme.Modules.pushforward f) (j + 1)).symm
    have hL : L.ExactAt (j + 1) :=
      (HomologicalComplex.exactAt_iff_isZero_homology L (j + 1)).mpr hzero
    exact (K.exactAt_iff' j (j + 1) (j + 2) (by simp) (by simp)).2
      (((L.exactAt_iff' j (j + 1) (j + 2) (by simp) (by simp)).mp hL).map (toSheaf Y))
  have hKV (j k : ℕ) : Subsingleton ((K.X j).H' (k + 1) V) := by
    haveI : (L.X j).presheaf.IsFlasque := by
      change TopCat.Presheaf.IsFlasque
        ((TopCat.Presheaf.pushforward AddCommGrpCat.{u} f.base).obj
          (P.cocomplex.X j).presheaf)
      infer_instance
    exact Scheme.Modules.subsingleton_cohomologyOn_succ_of_isFlasque (L.X j) k V
  apply AcyclicResolution.subsingleton_of_exact_sections a ha ha' hK V hKV q
  intro s hs
  let KX := ((toSheaf X).mapHomologicalComplex _).obj P.cocomplex
  have hι : (toSheaf X).map (P.ι.f 0) ≫ KX.d 0 1 = 0 := by
    rw [Functor.mapHomologicalComplex_obj_d, ← Functor.map_comp,
      P.ι_f_zero_comp_complex_d, Functor.map_zero]
  have hι' : (ShortComplex.mk _ _ hι).Exact :=
    (ShortComplex.exact_of_f_is_kernel
      (S := ShortComplex.mk _ _ P.ι_f_zero_comp_complex_d)
        P.isLimitKernelFork).map (toSheaf X)
  have hKX (j : ℕ) : KX.ExactAt (j + 1) :=
    (KX.exactAt_iff' j (j + 1) (j + 2) (by simp) (by simp)).2
      ((P.exact_succ j).map (toSheaf X))
  have hKXV (j k : ℕ) :
      Subsingleton ((KX.X j).H' (k + 1) (f ⁻¹ᵁ V)) :=
    Scheme.Modules.subsingleton_cohomologyOn_succ_of_isFlasque
      (P.cocomplex.X j) k (f ⁻¹ᵁ V)
  haveI : Mono ((toSheaf X).map (P.ι.f 0)) := Functor.map_mono _ _
  exact Sheaf.H'.exists_d_hom_app_eq_of_resolution (K := KX)
    ((toSheaf X).map (P.ι.f 0)) hι hι' hKX (f ⁻¹ᵁ V) hKXV q hM s hs

/-- In particular, an affine direct image of a quasi-coherent module on an
affine scheme is acyclic on the whole target. -/
theorem cohomologyOnTop_pushforward_vanishing [IsAffine X] (q : ℕ) :
    Subsingleton
      (Scheme.Modules.cohomologyOn ((Scheme.Modules.pushforward f).obj M) (q + 1) ⊤) := by
  apply cohomologyOn_pushforward_vanishing f M ⊤ q
  simpa using Scheme.Modules.subsingleton_cohomologyOn_succ_of_isAffineOpen M
    (isAffineOpen_top X) q

end PaperVerification.Segre.AffineDirectImage
end
