section SegreExteriorProductDecomposition

/-!
# The actual exterior power of a direct product

The canonical wedge of the two factor inclusions gives
`(⨁ a+b=r, (⋀^a M) ⊗ (⋀^b N)) ≃ₗ[R] ⋀^r (M × N)`.
Its bijectivity is proved by regrouping the actual homogeneous decomposition
of the full exterior-algebra product equivalence. Thus the proof works over
every commutative ring and for arbitrary modules; it does not assume free
bases, characteristic zero, or a decomposition theorem as a premise.

The fixed-degree maps are the actual wedge maps and are natural for maps of
both modules. This is the algebraic prerequisite for the sheaf Koszul-term
decomposition. Sheafification, scalar-change compatibility, and the line-twist
comparison are established in the subsequent modules.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ExteriorProductDecomposition

open scoped DirectSum TensorProduct

universe u v w
variable (R : Type u) [CommRing R]
variable (M : Type v) (N : Type w) [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- Every ordered decomposition of the exterior degree is retained. -/
abbrev DegreePair (r : ℕ) := {ab : ℕ × ℕ // ab.1 + ab.2 = r}

/-- The actual tensor product of the two indicated exterior powers. -/
abbrev TensorPiece (ab : ℕ × ℕ) := (⋀[R]^ab.1 M) ⊗[R] (⋀[R]^ab.2 N)

/-- The full finite-degree convolution, expressed as an actual direct sum. -/
abbrev DegreeSum (r : ℕ) := ⨁ ab : DegreePair r, TensorPiece R M N ab.val

/-- The canonical direct-sum module, with its pointwise additive-group
instance made explicit for the full dependent family of degree pairs. -/
abbrev degreeSumModule (r : ℕ) : ModuleCat.{max u v w} R := by
  letI : ∀ ab : DegreePair r, AddCommGroup (TensorPiece R M N ab.val) :=
    fun _ => inferInstance
  exact ModuleCat.of R (DegreeSum R M N r)

/-- Regroup the genuine bigraded direct sum by total degree. -/
def regroup :
    (⨁ ab : ℕ × ℕ, TensorPiece R M N ab) ≃ₗ[R]
      ⨁ r : ℕ, DegreeSum R M N r :=
  { DirectSum.sigmaFiberAddEquiv (fun ab : ℕ × ℕ => ab.1 + ab.2) with
    map_smul' := by
      intro c z
      ext r ab
      rfl }

@[simp] theorem regroup_lof (ab : ℕ × ℕ) (z : TensorPiece R M N ab) :
    regroup R M N (DirectSum.lof R _ _ ab z) =
      DirectSum.lof R _ _ (ab.1 + ab.2)
        (DirectSum.lof R _ _ ⟨ab, rfl⟩ z) :=
  DirectSum.sigmaFiberAddEquiv_of _ ab z

@[simp] theorem regroup_symm_lof (r : ℕ) (ab : DegreePair r)
    (z : TensorPiece R M N ab.val) :
    (regroup R M N).symm
        (DirectSum.lof R _ _ r (DirectSum.lof R _ _ ab z)) =
      DirectSum.lof R _ _ ab.val z := by
  rcases ab with ⟨⟨a, b⟩, h⟩
  subst r
  exact (regroup R M N).symm_apply_eq.mpr (regroup_lof R M N (a, b) z).symm

/-- The full equivalence comes only from the actual algebra product theorem
and the actual homogeneous decompositions of its two factors. -/
def allDegrees :
    (⨁ r : ℕ, DegreeSum R M N r) ≃ₗ[R] ExteriorAlgebra R (M × N) :=
  (regroup R M N).symm ≪≫ₗ
    (TensorProduct.directSum R R (fun a : ℕ => ⋀[R]^a M)
      (fun b : ℕ => ⋀[R]^b N)).symm ≪≫ₗ
    (GradedTensorProduct.auxEquiv R (fun a : ℕ => ⋀[R]^a M)
      (fun b : ℕ => ⋀[R]^b N)).symm ≪≫ₗ
    (ExteriorAlgebra.prodEquivTensor R M N).symm.toLinearEquiv

/-- Wedge the two genuine factor inclusions, before changing total degree. -/
def blockWedge (a b : ℕ) :
    TensorPiece R M N (a, b) →ₗ[R] ⋀[R]^(a + b) (M × N) :=
  TensorProduct.lift
    ((exteriorPower.wedge R (M × N) a b).compl₁₂
      (exteriorPower.map a (LinearMap.inl R M N))
      (exteriorPower.map b (LinearMap.inr R M N)))

/-- The same actual wedge, with the explicit degree equality used only to
place its value in the required homogeneous submodule. -/
def blockWedgeAt (r : ℕ) (ab : DegreePair r) :
    TensorPiece R M N ab.val →ₗ[R] ⋀[R]^r (M × N) :=
  (((⋀[R]^(ab.val.1 + ab.val.2) (M × N)).subtype).comp
    (blockWedge R M N ab.val.1 ab.val.2)).codRestrict _ (fun z => by
      exact (congrArg (fun d : ℕ =>
        (blockWedge R M N ab.val.1 ab.val.2 z : ExteriorAlgebra R (M × N)) ∈
          ⋀[R]^d (M × N)) ab.property).mp
        (blockWedge R M N ab.val.1 ab.val.2 z).property)

@[simp] theorem blockWedgeAt_tmul_coe (r : ℕ) (ab : DegreePair r)
    (x : ⋀[R]^ab.val.1 M) (y : ⋀[R]^ab.val.2 N) :
    (blockWedgeAt R M N r ab (x ⊗ₜ[R] y) : ExteriorAlgebra R (M × N)) =
      ExteriorAlgebra.map (LinearMap.inl R M N) x *
        ExteriorAlgebra.map (LinearMap.inr R M N) y := by
  change (exteriorPower.wedge R (M × N) ab.val.1 ab.val.2
    (exteriorPower.map ab.val.1 (LinearMap.inl R M N) x)
    (exteriorPower.map ab.val.2 (LinearMap.inr R M N) y) :
      ExteriorAlgebra R (M × N)) = _
  change ((exteriorPower.map ab.val.1 (LinearMap.inl R M N) x :
      ExteriorAlgebra R (M × N)) *
    (exteriorPower.map ab.val.2 (LinearMap.inr R M N) y :
      ExteriorAlgebra R (M × N))) = _
  rw [exteriorPower.coe_map, exteriorPower.coe_map]

/-- The canonical sum of all block wedges in exterior degree r. -/
def degreeMap (r : ℕ) : DegreeSum R M N r →ₗ[R] ⋀[R]^r (M × N) :=
  DirectSum.toModule R _ _ (blockWedgeAt R M N r)

@[simp] theorem degreeMap_lof (r : ℕ) (ab : DegreePair r)
    (z : TensorPiece R M N ab.val) :
    degreeMap R M N r (DirectSum.lof R _ _ ab z) = blockWedgeAt R M N r ab z :=
  DirectSum.toModule_lof (φ := blockWedgeAt R M N r) R ab z

private theorem auxEquiv_symm_homogeneous (a b : ℕ)
    (x : ⋀[R]^a M) (y : ⋀[R]^b N) :
    (GradedTensorProduct.auxEquiv R (fun a : ℕ => ⋀[R]^a M)
      (fun b : ℕ => ⋀[R]^b N)).symm
        (DirectSum.lof R _ _ a x ⊗ₜ[R] DirectSum.lof R _ _ b y) =
      (x : ExteriorAlgebra R M) ᵍ⊗ₜ[R] (y : ExteriorAlgebra R N) := by
  apply (GradedTensorProduct.auxEquiv R (fun a : ℕ => ⋀[R]^a M)
    (fun b : ℕ => ⋀[R]^b N)).symm_apply_eq.mpr
  rw [GradedTensorProduct.auxEquiv_tmul,
    DirectSum.decompose_coe, DirectSum.decompose_coe]
  rfl

/-- Restricting the full actual product equivalence gives exactly the
canonical wedge map, rather than an arbitrarily chosen degree equivalence. -/
theorem allDegrees_lof_lof (r : ℕ) (ab : DegreePair r)
    (z : TensorPiece R M N ab.val) :
    allDegrees R M N
        (DirectSum.lof R _ _ r (DirectSum.lof R _ _ ab z)) =
      (blockWedgeAt R M N r ab z : ExteriorAlgebra R (M × N)) := by
  rcases ab with ⟨⟨a, b⟩, h⟩
  subst r
  induction z using TensorProduct.inductionOn with
  | tmul x y =>
      simp only [allDegrees, LinearEquiv.trans_apply, AlgEquiv.toLinearEquiv_apply]
      erw [regroup_symm_lof R M N (a + b) ⟨(a, b), rfl⟩ (x ⊗ₜ[R] y)]
      erw [TensorProduct.directSum_symm_lof_tmul]
      rw [auxEquiv_symm_homogeneous R M N a b x y,
        ExteriorAlgebra.prodEquivTensor_symm_tmul, blockWedgeAt_tmul_coe]
  | add z w hz hw =>
      simp only [map_add, AddMemClass.coe_add, hz, hw]

/-- In the actual exterior grading, the complete equivalence is componentwise
the canonical degree map. -/
theorem lmap_degreeMap_eq :
    DirectSum.lmap (degreeMap R M N) =
      ((allDegrees R M N).trans
        (DirectSum.decomposeLinearEquiv (fun r : ℕ => ⋀[R]^r (M × N)))).toLinearMap := by
  apply DirectSum.linearMap_ext
  intro r
  apply DirectSum.linearMap_ext
  intro ab
  apply LinearMap.ext
  intro z
  simp only [LinearMap.comp_apply, DirectSum.lmap_lof, degreeMap_lof,
    LinearEquiv.coe_coe, LinearEquiv.trans_apply, allDegrees_lof_lof,
    DirectSum.decomposeLinearEquiv_apply_coe]

/-- Every canonical fixed-degree map is bijective, with no freeness premise. -/
theorem degreeMap_bijective (r : ℕ) : Function.Bijective (degreeMap R M N r) := by
  have h : Function.Bijective (DirectSum.lmap (degreeMap R M N)) := by
    rw [lmap_degreeMap_eq]
    exact ((allDegrees R M N).trans
      (DirectSum.decomposeLinearEquiv (fun r : ℕ => ⋀[R]^r (M × N)))).bijective
  exact ⟨((DirectSum.lmap_injective (degreeMap R M N)).mp h.injective) r,
    ((DirectSum.lmap_surjective (degreeMap R M N)).mp h.surjective) r⟩

/-- The full fixed-degree exterior direct-product decomposition, with all
degree pairs and the canonical wedge map, over every commutative ring. -/
def productExteriorEquiv (r : ℕ) :
    DegreeSum R M N r ≃ₗ[R] ⋀[R]^r (M × N) :=
  LinearEquiv.ofBijective (degreeMap R M N r) (degreeMap_bijective R M N r)

@[simp] theorem productExteriorEquiv_lof_tmul_coe (r : ℕ) (ab : DegreePair r)
    (x : ⋀[R]^ab.val.1 M) (y : ⋀[R]^ab.val.2 N) :
    (productExteriorEquiv R M N r (DirectSum.lof R _ _ ab (x ⊗ₜ[R] y)) :
      ExteriorAlgebra R (M × N)) =
      ExteriorAlgebra.map (LinearMap.inl R M N) x *
        ExteriorAlgebra.map (LinearMap.inr R M N) y := by
  change (degreeMap R M N r (DirectSum.lof R _ _ ab (x ⊗ₜ[R] y)) :
    ExteriorAlgebra R (M × N)) = _
  rw [degreeMap_lof]
  exact blockWedgeAt_tmul_coe R M N r ab x y

section Naturality

variable {M N} {M' N' : Type*} [AddCommGroup M'] [Module R M']
  [AddCommGroup N'] [Module R N']

/-- The canonical degree decomposition is natural in both original modules. -/
theorem degreeMap_natural (f : M →ₗ[R] M') (g : N →ₗ[R] N') (r : ℕ) :
    (exteriorPower.map r (f.prodMap g)).comp (degreeMap R M N r) =
      (degreeMap R M' N' r).comp
        (DirectSum.lmap (fun ab : DegreePair r =>
          TensorProduct.map (exteriorPower.map ab.val.1 f)
            (exteriorPower.map ab.val.2 g))) := by
  apply DirectSum.linearMap_ext
  intro ab
  apply TensorProduct.ext'
  intro x y
  apply Subtype.ext
  simp only [LinearMap.comp_apply, DirectSum.lmap_lof, TensorProduct.map_tmul,
    degreeMap_lof, exteriorPower.coe_map, blockWedgeAt_tmul_coe, map_mul]
  have hl : (ExteriorAlgebra.map (f.prodMap g)).comp
      (ExteriorAlgebra.map (LinearMap.inl R M N)) =
      (ExteriorAlgebra.map (LinearMap.inl R M' N')).comp (ExteriorAlgebra.map f) := by
    rw [ExteriorAlgebra.map_comp_map, ExteriorAlgebra.map_comp_map]
    congr 1
    ext m <;> simp
  have hr : (ExteriorAlgebra.map (f.prodMap g)).comp
      (ExteriorAlgebra.map (LinearMap.inr R M N)) =
      (ExteriorAlgebra.map (LinearMap.inr R M' N')).comp (ExteriorAlgebra.map g) := by
    rw [ExteriorAlgebra.map_comp_map, ExteriorAlgebra.map_comp_map]
    congr 1
    ext n <;> simp
  exact congrArg₂ (· * ·) (AlgHom.congr_fun hl (x : ExteriorAlgebra R M))
    (AlgHom.congr_fun hr (y : ExteriorAlgebra R N))

end Naturality
end PaperVerification.Segre.ExteriorProductDecomposition

end SegreExteriorProductDecomposition

section SegrePresheafExteriorWedge

/-!
# Wedge multiplication commutes with actual presheaf restrictions

The exterior powers and tensor product are the genuine sectionwise
presheaves, with their actual change-of-scalars restriction maps. The wedge
comparison is proved on decomposable exterior vectors and then extended by
their full linear spans. It applies over every commutative ring and every
presheaf of modules, without freeness or characteristic assumptions.

This is the scalar-change compatibility needed to sheafify the canonical
exterior direct-sum decomposition.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.PresheafExteriorWedge

open CategoryTheory MonoidalCategory
open scoped TensorProduct

universe u v w
variable {C : Type v} [Category.{w} C]
variable {R : Cᵒᵖ ⥤ CommRingCat.{u}}
variable (M : PresheafOfModulesOfCommRing.{u} R)

set_option maxHeartbeats 800000 in
/-- The actual restriction sends an arbitrary wedge product to the wedge
of the actual restrictions, even when the section rings change. -/
theorem restriction_wedge (a b : ℕ) {U V : Cᵒᵖ} (f : U ⟶ V)
    (x : ⋀[R.obj U]^a (M.obj U)) (y : ⋀[R.obj U]^b (M.obj U)) :
    ((PresheafOfModulesOfCommRing.exteriorPower (a + b)).obj M).map f
        (exteriorPower.wedge (R.obj U) (M.obj U) a b x y) =
      exteriorPower.wedge (R.obj V) (M.obj V) a b
        (((PresheafOfModulesOfCommRing.exteriorPower a).obj M).map f x)
        (((PresheafOfModulesOfCommRing.exteriorPower b).obj M).map f y) := by
  let res (d : ℕ) :
      (⋀[R.obj U]^d (M.obj U)) →ₛₗ[(R.map f).hom] (⋀[R.obj V]^d (M.obj V)) :=
    ((PresheafOfModulesOfCommRing.exteriorPower d).obj M).restrictₛₗ f
  change res (a + b) (exteriorPower.wedge (R.obj U) (M.obj U) a b x y) =
    exteriorPower.wedge (R.obj V) (M.obj V) a b (res a x) (res b y)
  have hx : x ∈ Submodule.span (R.obj U)
      (Set.range (exteriorPower.ιMulti (R.obj U) a (M := M.obj U))) := by
    rw [exteriorPower.ιMulti_span]
    trivial
  have hy : y ∈ Submodule.span (R.obj U)
      (Set.range (exteriorPower.ιMulti (R.obj U) b (M := M.obj U))) := by
    rw [exteriorPower.ιMulti_span]
    trivial
  refine Submodule.span_induction₂
    (p := fun x y _ _ =>
      res (a + b) (exteriorPower.wedge (R.obj U) (M.obj U) a b x y) =
        exteriorPower.wedge (R.obj V) (M.obj V) a b (res a x) (res b y))
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ hx hy
  · rintro x y ⟨s, rfl⟩ ⟨t, rfl⟩
    simp only [res, PresheafOfModules.restrictₛₗ_apply]
    erw [exteriorPower.wedge_ιMulti,
      PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk,
      PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk,
      PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk,
      exteriorPower.wedge_ιMulti]
    apply congrArg (exteriorPower.ιMulti (R.obj V) (a + b))
    funext i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · erw [Fin.append_left, Fin.append_left]
    · erw [Fin.append_right, Fin.append_right]
  · intro y _
    simp only [map_zero, LinearMap.zero_apply]
  · intro x _
    simp only [map_zero]
  · intro x y z _ _ _ hx hy
    simp only [map_add, LinearMap.add_apply, hx, hy]
  · intro x y z _ _ _ hy hz
    simp only [map_add, hy, hz]
  · intro r x y _ _ h
    simp only [map_smul, LinearMap.smul_apply,
      LinearMap.map_smulₛₗ, h]
  · intro r x y _ _ h
    simp only [map_smul, LinearMap.map_smulₛₗ, h]

set_option maxHeartbeats 800000 in
/-- The sectionwise wedge is an actual morphism from the actual presheaf
tensor product to the actual exterior-power presheaf. -/
def wedgeHom (a b : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower a).obj M ⊗
        (PresheafOfModulesOfCommRing.exteriorPower b).obj M ⟶
      (PresheafOfModulesOfCommRing.exteriorPower (a + b)).obj M :=
  PresheafOfModulesOfCommRing.homMk
    (fun U => ModuleCat.ofHom (R := R.obj U)
      (TensorProduct.lift (exteriorPower.wedge (R.obj U) (M.obj U) a b)))
    (fun {U V} f => by
      apply ModuleCat.hom_ext (R := R.obj U)
      apply TensorProduct.ext' (R := R.obj U) (R₂ := R.obj U)
        (M := ⋀[R.obj U]^a (M.obj U)) (N := ⋀[R.obj U]^b (M.obj U))
      intro x y
      change TensorProduct.lift (exteriorPower.wedge (R.obj V) (M.obj V) a b)
          (((PresheafOfModulesOfCommRing.exteriorPower a).obj M ⊗
            (PresheafOfModulesOfCommRing.exteriorPower b).obj M).map f (x ⊗ₜ[R.obj U] y)) =
        ((PresheafOfModulesOfCommRing.exteriorPower (a + b)).obj M).map f
          (exteriorPower.wedge (R.obj U) (M.obj U) a b x y)
      erw [PresheafOfModulesOfCommRing.Monoidal.tensorObj_map_tmul
        (R := R)
        (M₁ := (PresheafOfModulesOfCommRing.exteriorPower a).obj M)
        (M₂ := (PresheafOfModulesOfCommRing.exteriorPower b).obj M) f x y]
      change exteriorPower.wedge (R.obj V) (M.obj V) a b
          (((PresheafOfModulesOfCommRing.exteriorPower a).obj M).map f x)
          (((PresheafOfModulesOfCommRing.exteriorPower b).obj M).map f y) =
        ((PresheafOfModulesOfCommRing.exteriorPower (a + b)).obj M).map f
          (exteriorPower.wedge (R.obj U) (M.obj U) a b x y)
      exact (restriction_wedge (R := R) M a b f x y).symm)

/-- The global morphism retains the literal sectionwise wedge formula. -/
theorem wedgeHom_app_tmul (a b : ℕ) (U : Cᵒᵖ)
    (x : ⋀[R.obj U]^a (M.obj U)) (y : ⋀[R.obj U]^b (M.obj U)) :
    (wedgeHom M a b).app U (x ⊗ₜ[R.obj U] y) =
      exteriorPower.wedge (R.obj U) (M.obj U) a b x y := rfl

/-- Naturality concerns the actual morphisms on each whole exterior power,
not only a chosen basis or chosen local trivialization. -/
theorem wedgeHom_natural {N : PresheafOfModulesOfCommRing.{u} R}
    (φ : M ⟶ N) (a b : ℕ) :
    ((PresheafOfModulesOfCommRing.exteriorPower a).map φ ⊗ₘ
      (PresheafOfModulesOfCommRing.exteriorPower b).map φ) ≫ wedgeHom N a b =
      wedgeHom M a b ≫ (PresheafOfModulesOfCommRing.exteriorPower (a + b)).map φ := by
  ext U : 1
  apply ModuleCat.hom_ext
  change (TensorProduct.lift (exteriorPower.wedge (R.obj U) (N.obj U) a b)).comp
      (TensorProduct.map (exteriorPower.map a (φ.app' U).hom)
        (exteriorPower.map b (φ.app' U).hom)) =
    (exteriorPower.map (a + b) (φ.app' U).hom).comp
      (TensorProduct.lift (exteriorPower.wedge (R.obj U) (M.obj U) a b))
  apply TensorProduct.ext'
  intro x y
  change exteriorPower.wedge (R.obj U) (N.obj U) a b
      (exteriorPower.map a (φ.app' U).hom x)
      (exteriorPower.map b (φ.app' U).hom y) =
    exteriorPower.map (a + b) (φ.app' U).hom
      (exteriorPower.wedge (R.obj U) (M.obj U) a b x y)
  exact exteriorPower.wedge_map_apply (φ.app' U).hom x y

end PaperVerification.Segre.PresheafExteriorWedge

end SegrePresheafExteriorWedge

section SegrePresheafExteriorProduct

/-!
# Exterior powers of an actual binary sum of module presheaves

The source is the genuine categorical coproduct of the tensor products
of exterior-power presheaves. The target is the genuine exterior power
of the categorical binary sum. The comparison is the wedge of the two
canonical inclusions. Evaluation identifies it with the canonical full
algebraic exterior-product decomposition, proved over arbitrary rings.

The resulting isomorphism therefore respects every actual presheaf
restriction, including change of coefficient rings. It does not assume
local bases, characteristic zero, or the desired decomposition as a
premise.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.PresheafExteriorProduct

open CategoryTheory Limits MonoidalCategory
open scoped TensorProduct DirectSum

universe u v w
variable {C : Type v} [Category.{w} C]
variable {R : Cᵒᵖ ⥤ CommRingCat.{u}}
variable (M N : PresheafOfModulesOfCommRing.{u} R)

attribute [local instance] HasBinaryBiproducts.of_hasBinaryProducts
attribute [local instance] preservesBinaryBiproducts_of_preservesBinaryProducts

/-- The degree pair runs through every ordered decomposition of r. -/
abbrev DegreePair := ExteriorProductDecomposition.DegreePair

/-- The genuine tensor product of two exterior-power presheaves. -/
abbrev piece (ab : ℕ × ℕ) : PresheafOfModulesOfCommRing.{u} R :=
  (PresheafOfModulesOfCommRing.exteriorPower ab.1).obj M ⊗
    (PresheafOfModulesOfCommRing.exteriorPower ab.2).obj N

/-- The genuine categorical sum of all degree pairs. -/
abbrev degreeSum (r : ℕ) : PresheafOfModulesOfCommRing.{u} R :=
  ∐ fun ab : DegreePair r => piece M N ab.val

/-- Wedge the actual inclusions in the actual binary sum. -/
def blockWedge (a b : ℕ) : piece M N (a,b) ⟶
    (PresheafOfModulesOfCommRing.exteriorPower (a+b)).obj (M ⊞ N) :=
  ((PresheafOfModulesOfCommRing.exteriorPower a).map
      (biprod.inl : M ⟶ M ⊞ N) ⊗ₘ
    (PresheafOfModulesOfCommRing.exteriorPower b).map
      (biprod.inr : N ⟶ M ⊞ N)) ≫
    PresheafExteriorWedge.wedgeHom (M ⊞ N) a b

/-- Only the proven equality of degrees is used to change the codomain. -/
def blockWedgeAt (r : ℕ) (ab : DegreePair r) : piece M N ab.val ⟶
    (PresheafOfModulesOfCommRing.exteriorPower r).obj (M ⊞ N) :=
  blockWedge M N ab.val.1 ab.val.2 ≫
    eqToHom (congrArg (fun d =>
      (PresheafOfModulesOfCommRing.exteriorPower d).obj (M ⊞ N)) ab.property)

/-- The actual direct-sum comparison whose bijectivity is to be proved. -/
def degreeMap (r : ℕ) : degreeSum M N r ⟶
    (PresheafOfModulesOfCommRing.exteriorPower r).obj (M ⊞ N) :=
  Sigma.desc (blockWedgeAt M N r)

@[reassoc] theorem degreeMap_ι (r : ℕ) (ab : DegreePair r) :
    Sigma.ι (fun ab : DegreePair r => piece M N ab.val) ab ≫ degreeMap M N r =
      blockWedgeAt M N r ab := Sigma.ι_desc _ _

/-- Evaluate the actual categorical sum and compare it with the actual
algebraic direct sum. -/
def sourceSectionsIso (r : ℕ) (U : Cᵒᵖ) :
    (degreeSum M N r).obj U ≅
      ExteriorProductDecomposition.degreeSumModule
        (R.obj U) (M.obj U) (N.obj U) r :=
  PreservesCoproduct.iso (PresheafOfModules.evaluation (R ⋙ forget₂ _ _) U)
      (fun ab : DegreePair r => piece M N ab.val) ≪≫
    ModuleCat.coprodIsoDirectSum (fun ab : DegreePair r => (piece M N ab.val).obj U)

/-- The direct sum uses the additive group already carried by its canonical
bundled module; no additional structure or hypothesis is introduced. -/
local instance degreeSumSectionsAddCommGroup (r : ℕ) (U : Cᵒᵖ) :
    AddCommGroup (ExteriorProductDecomposition.DegreeSum
      (R.obj U) (M.obj U) (N.obj U) r) :=
  ModuleCat.isAddCommGroup (ExteriorProductDecomposition.degreeSumModule
    (R.obj U) (M.obj U) (N.obj U) r)

/-- The section comparison sends each algebraic summand to the actual
presheaf coproduct injection. -/
theorem sourceSectionsIso_inv_lof (r : ℕ) (U : Cᵒᵖ) (ab : DegreePair r) :
    ModuleCat.ofHom (DirectSum.lof (R.obj U) (DegreePair r)
      (fun ab => ExteriorProductDecomposition.TensorPiece
        (R.obj U) (M.obj U) (N.obj U) ab.val) ab) ≫
      (sourceSectionsIso M N r U).inv =
      (Sigma.ι (fun ab : DegreePair r => piece M N ab.val) ab).app U := by
  let F := PresheafOfModules.evaluation (R ⋙ forget₂ CommRingCat RingCat) U
  let P : DegreePair r → PresheafOfModulesOfCommRing.{u} R :=
    fun ab => piece M N ab.val
  let Z : DegreePair r → ModuleCat.{u} (R.obj U) := fun ab => (piece M N ab.val).obj U
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (fun h => h ≫ sigmaComparison F P)
      (ModuleCat.lof_coprodIsoDirectSum_inv Z ab)).trans
        (ι_comp_sigmaComparison F P ab))

/-- Evaluation of the actual categorical binary sum is the ordinary
product of its section modules. -/
def productSectionsIso (U : Cᵒᵖ) :
    (M ⊞ N).obj U ≅ ModuleCat.of (R.obj U) (M.obj U × N.obj U) :=
  (PresheafOfModules.evaluation (R ⋙ forget₂ _ _) U).mapBiprod M N ≪≫
    ModuleCat.biprodIsoProd (M.obj U) (N.obj U)

private theorem biprodIsoProd_hom_fst (U : Cᵒᵖ) :
    (ModuleCat.biprodIsoProd (M.obj U) (N.obj U)).hom ≫
      ModuleCat.ofHom (LinearMap.fst (R.obj U) (M.obj U) (N.obj U)) = biprod.fst := by
  apply (cancel_epi (ModuleCat.biprodIsoProd (M.obj U) (N.obj U)).inv).mp
  simp only [Iso.inv_hom_id_assoc]
  exact (ModuleCat.biprodIsoProd_inv_comp_fst (R := R.obj U) (M.obj U) (N.obj U)).symm

private theorem biprodIsoProd_hom_snd (U : Cᵒᵖ) :
    (ModuleCat.biprodIsoProd (M.obj U) (N.obj U)).hom ≫
      ModuleCat.ofHom (LinearMap.snd (R.obj U) (M.obj U) (N.obj U)) = biprod.snd := by
  apply (cancel_epi (ModuleCat.biprodIsoProd (M.obj U) (N.obj U)).inv).mp
  simp only [Iso.inv_hom_id_assoc]
  exact (ModuleCat.biprodIsoProd_inv_comp_snd (R := R.obj U) (M.obj U) (N.obj U)).symm

@[reassoc] theorem productSectionsIso_hom_fst (U : Cᵒᵖ) :
    (productSectionsIso M N U).hom ≫
      ModuleCat.ofHom (LinearMap.fst (R.obj U) (M.obj U) (N.obj U)) =
      (biprod.fst : M ⊞ N ⟶ M).app U := by
  simp only [productSectionsIso, Iso.trans_hom, Category.assoc,
    biprodIsoProd_hom_fst, Functor.mapBiprod_hom]
  erw [biprod.lift_fst] <;> rfl

@[reassoc] theorem productSectionsIso_hom_snd (U : Cᵒᵖ) :
    (productSectionsIso M N U).hom ≫
      ModuleCat.ofHom (LinearMap.snd (R.obj U) (M.obj U) (N.obj U)) =
      (biprod.snd : M ⊞ N ⟶ N).app U := by
  simp only [productSectionsIso, Iso.trans_hom, Category.assoc,
    biprodIsoProd_hom_snd, Functor.mapBiprod_hom]
  erw [biprod.lift_snd] <;> rfl

/-- The first component of the actual section comparison. -/
theorem productSectionsIso_hom_apply_fst (U : Cᵒᵖ) (z : (M ⊞ N).obj U) :
    ((productSectionsIso M N U).hom z).1 = (biprod.fst : M ⊞ N ⟶ M).app U z := by
  have h := congrArg (fun f : (M ⊞ N).obj U ⟶ M.obj U => f.hom z)
    (productSectionsIso_hom_fst M N U)
  change ((productSectionsIso M N U).hom z).1 =
    (biprod.fst : M ⊞ N ⟶ M).app U z at h
  exact h

/-- The second component of the actual section comparison. -/
theorem productSectionsIso_hom_apply_snd (U : Cᵒᵖ) (z : (M ⊞ N).obj U) :
    ((productSectionsIso M N U).hom z).2 = (biprod.snd : M ⊞ N ⟶ N).app U z := by
  have h := congrArg (fun f : (M ⊞ N).obj U ⟶ N.obj U => f.hom z)
    (productSectionsIso_hom_snd M N U)
  change ((productSectionsIso M N U).hom z).2 =
    (biprod.snd : M ⊞ N ⟶ N).app U z at h
  exact h

/-- The first categorical inclusion is literally the first section-module
inclusion under the product comparison. -/
theorem productSectionsIso_inl (U : Cᵒᵖ) :
    (biprod.inl : M ⟶ M ⊞ N).app U ≫ (productSectionsIso M N U).hom =
      ModuleCat.ofHom (LinearMap.inl (R.obj U) (M.obj U) (N.obj U)) := by
  apply ModuleCat.hom_ext
  ext x : 1
  apply Prod.ext
  · change ((productSectionsIso M N U).hom ((biprod.inl : M ⟶ M ⊞ N).app U x)).1 = x
    rw [productSectionsIso_hom_apply_fst]
    change ((biprod.inl ≫ biprod.fst : M ⟶ M).app U) x = x
    rw [biprod.inl_fst]
    rfl
  · change ((productSectionsIso M N U).hom ((biprod.inl : M ⟶ M ⊞ N).app U x)).2 = 0
    rw [productSectionsIso_hom_apply_snd]
    change ((biprod.inl ≫ biprod.snd : M ⟶ N).app U) x = 0
    rw [biprod.inl_snd]
    rfl

/-- The second categorical inclusion is literally the second
section-module inclusion. -/
theorem productSectionsIso_inr (U : Cᵒᵖ) :
    (biprod.inr : N ⟶ M ⊞ N).app U ≫ (productSectionsIso M N U).hom =
      ModuleCat.ofHom (LinearMap.inr (R.obj U) (M.obj U) (N.obj U)) := by
  apply ModuleCat.hom_ext
  ext y : 1
  apply Prod.ext
  · change ((productSectionsIso M N U).hom ((biprod.inr : N ⟶ M ⊞ N).app U y)).1 = 0
    rw [productSectionsIso_hom_apply_fst]
    change ((biprod.inr ≫ biprod.fst : N ⟶ M).app U) y = 0
    rw [biprod.inr_fst]
    rfl
  · change ((productSectionsIso M N U).hom ((biprod.inr : N ⟶ M ⊞ N).app U y)).2 = y
    rw [productSectionsIso_hom_apply_snd]
    change ((biprod.inr ≫ biprod.snd : N ⟶ N).app U) y = y
    rw [biprod.inr_snd]
    rfl

/-- Evaluate the actual exterior power and apply its actual functorial
image of the binary-product comparison. -/
def targetSectionsIso (r : ℕ) (U : Cᵒᵖ) :
    ((PresheafOfModulesOfCommRing.exteriorPower r).obj (M ⊞ N)).obj U ≅
      ModuleCat.of (R.obj U) (⋀[R.obj U]^r (M.obj U × N.obj U)) :=
  (ModuleCat.exteriorPower.functor (R.obj U) r).mapIso (productSectionsIso M N U)

/-- The presheaf block wedge is exactly the algebraic block wedge after
evaluating on a section module. -/
theorem blockWedge_sections (a b : ℕ) (U : Cᵒᵖ)
    (x : ⋀[R.obj U]^a (M.obj U)) (y : ⋀[R.obj U]^b (N.obj U)) :
    (targetSectionsIso M N (a+b) U).hom
        ((blockWedge M N a b).app U (x ⊗ₜ[R.obj U] y)) =
      ExteriorProductDecomposition.blockWedge
        (R.obj U) (M.obj U) (N.obj U) a b (x ⊗ₜ[R.obj U] y) := by
  change exteriorPower.map (a+b) (productSectionsIso M N U).hom.hom
      (exteriorPower.wedge (R.obj U) ((M ⊞ N).obj U) a b
        (exteriorPower.map a ((biprod.inl : M ⟶ M ⊞ N).app' U).hom x)
        (exteriorPower.map b ((biprod.inr : N ⟶ M ⊞ N).app' U).hom y)) = _
  rw [← exteriorPower.wedge_map_apply]
  have hl := congrArg ModuleCat.Hom.hom (productSectionsIso_inl M N U)
  have hr := congrArg ModuleCat.Hom.hom (productSectionsIso_inr M N U)
  change (productSectionsIso M N U).hom.hom.comp
    ((biprod.inl : M ⟶ M ⊞ N).app' U).hom = LinearMap.inl _ _ _ at hl
  change (productSectionsIso M N U).hom.hom.comp
    ((biprod.inr : N ⟶ M ⊞ N).app' U).hom = LinearMap.inr _ _ _ at hr
  have hleft := congrArg
    (fun g : M.obj U →ₗ[R.obj U] (M.obj U × N.obj U) =>
      exteriorPower.map a g x) hl
  have hright := congrArg
    (fun g : N.obj U →ₗ[R.obj U] (M.obj U × N.obj U) =>
      exteriorPower.map b g y) hr
  rw [exteriorPower.map_comp, LinearMap.comp_apply] at hleft
  rw [exteriorPower.map_comp, LinearMap.comp_apply] at hright
  rw [hleft, hright]
  rfl

/-- The comparison also preserves the explicit total-degree equality. -/
theorem blockWedgeAt_sections (r : ℕ) (ab : DegreePair r) (U : Cᵒᵖ)
    (x : ⋀[R.obj U]^ab.val.1 (M.obj U))
    (y : ⋀[R.obj U]^ab.val.2 (N.obj U)) :
    (targetSectionsIso M N r U).hom
        ((blockWedgeAt M N r ab).app U (x ⊗ₜ[R.obj U] y)) =
      ExteriorProductDecomposition.blockWedgeAt
        (R.obj U) (M.obj U) (N.obj U) r ab (x ⊗ₜ[R.obj U] y) := by
  rcases ab with ⟨⟨a,b⟩,h⟩
  subst r
  apply Subtype.ext
  simpa [blockWedgeAt, ExteriorProductDecomposition.blockWedgeAt] using
    congrArg (fun z : ⋀[R.obj U]^(a+b) (M.obj U × N.obj U) =>
      (z : ExteriorAlgebra (R.obj U) (M.obj U × N.obj U)))
      (blockWedge_sections M N a b U x y)

/-- The complete actual presheaf comparison, on sections, equals the
canonical algebraic map on every full degree summand. -/
theorem degreeMap_sections (r : ℕ) (U : Cᵒᵖ) :
    (sourceSectionsIso M N r U).inv ≫ (degreeMap M N r).app U ≫
      (targetSectionsIso M N r U).hom =
      ModuleCat.ofHom (ExteriorProductDecomposition.degreeMap
        (R.obj U) (M.obj U) (N.obj U) r) := by
  apply ModuleCat.hom_ext
  apply DirectSum.linearMap_ext
  intro ab
  apply TensorProduct.ext'
  intro x y
  have hi := congrArg (fun f => f (x ⊗ₜ[R.obj U] y))
    (sourceSectionsIso_inv_lof M N r U ab)
  have hd := congrArg (fun f => (f.app U) (x ⊗ₜ[R.obj U] y))
    (degreeMap_ι M N r ab)
  change (sourceSectionsIso M N r U).inv
      (DirectSum.lof (R.obj U) _ _ ab (x ⊗ₜ[R.obj U] y)) = _ at hi
  change (degreeMap M N r).app U
      ((Sigma.ι (fun ab : DegreePair r => piece M N ab.val) ab).app U
        (x ⊗ₜ[R.obj U] y)) = _ at hd
  change (targetSectionsIso M N r U).hom
      ((degreeMap M N r).app U ((sourceSectionsIso M N r U).inv
        (DirectSum.lof (R.obj U) _ _ ab (x ⊗ₜ[R.obj U] y)))) = _
  exact (congrArg (fun z => (targetSectionsIso M N r U).hom
      ((degreeMap M N r).app U z)) hi).trans
    ((congrArg (fun z => (targetSectionsIso M N r U).hom z) hd).trans
      ((blockWedgeAt_sections M N r ab U x y).trans
        (ExteriorProductDecomposition.degreeMap_lof
          (R.obj U) (M.obj U) (N.obj U) r ab (x ⊗ₜ[R.obj U] y)).symm))

/-- The section isomorphism uses the proved algebraic product theorem,
not an assumption of componentwise bijectivity. -/
def sectionIso (r : ℕ) (U : Cᵒᵖ) :
    (degreeSum M N r).obj U ≅
      ((PresheafOfModulesOfCommRing.exteriorPower r).obj (M ⊞ N)).obj U :=
  sourceSectionsIso M N r U ≪≫
    (ExteriorProductDecomposition.productExteriorEquiv
      (R.obj U) (M.obj U) (N.obj U) r).toModuleIso ≪≫
    (targetSectionsIso M N r U).symm

/-- The evaluated canonical morphism is the whole section isomorphism. -/
theorem degreeMap_app_eq_iso (r : ℕ) (U : Cᵒᵖ) :
    (degreeMap M N r).app U = (sectionIso M N r U).hom := by
  apply (cancel_epi (sourceSectionsIso M N r U).inv).mp
  apply (cancel_mono (targetSectionsIso M N r U).hom).mp
  rw [Category.assoc, degreeMap_sections]
  simp only [sectionIso, Iso.trans_hom, Iso.symm_hom, Category.assoc,
    Iso.inv_hom_id_assoc, Iso.inv_hom_id, Category.comp_id]
  rfl

/-- The full exterior decomposition is an actual isomorphism of module
presheaves. All coefficient-ring restrictions commute because its hom is
the already constructed canonical wedge morphism. -/
def productExteriorIso (r : ℕ) : degreeSum M N r ≅
    (PresheafOfModulesOfCommRing.exteriorPower r).obj (M ⊞ N) :=
  PresheafOfModulesOfCommRing.isoMk (sectionIso M N r) (fun {U V} f => by
    rw [← degreeMap_app_eq_iso, ← degreeMap_app_eq_iso]
    exact (degreeMap M N r).naturality f)

/-- The isomorphism has the original wedge comparison as its hom. -/
theorem productExteriorIso_hom (r : ℕ) :
    (productExteriorIso M N r).hom = degreeMap M N r := by
  apply PresheafOfModules.hom_ext
  intro U
  exact (degreeMap_app_eq_iso M N r U).symm

/-- Every original summand retains its canonical wedge formula under
the global presheaf decomposition. -/
@[reassoc] theorem productExteriorIso_ι (r : ℕ) (ab : DegreePair r) :
    Sigma.ι (fun ab : DegreePair r => piece M N ab.val) ab ≫
      (productExteriorIso M N r).hom = blockWedgeAt M N r ab := by
  rw [productExteriorIso_hom]
  exact degreeMap_ι M N r ab

end PaperVerification.Segre.PresheafExteriorProduct

end SegrePresheafExteriorProduct

section SegreSheafExteriorProduct

/-!
# The actual exterior direct-sum decomposition for sheaves

Sheafification is the existing strong monoidal left adjoint, so it
preserves the actual tensor products and coproducts. Applied to the
canonical presheaf wedge decomposition, it gives the full binary exterior
decomposition for arbitrary sheaves of modules over a commutative ring
sheaf. The comparison retains its canonical summand wedge formula.

No local freeness, field, characteristic, or exterior-decomposition
hypothesis is added. The only site assumptions are those needed by the
existing sheafification construction; they hold for the scheme sites
used by the geometric argument.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.SheafExteriorProduct

open CategoryTheory Limits MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})
variable (M N : SheafOfModules.{u} (ringCatSheaf R))

attribute [local instance] HasBinaryBiproducts.of_hasBinaryProducts
attribute [local instance] preservesBinaryBiproducts_of_preservesBinaryProducts

abbrev DegreePair := PresheafExteriorProduct.DegreePair

/-- The existing sheafification functor, without an alternative model. -/
abbrev sheafification : PresheafOfModulesOfCommRing.{u} R.obj ⥤
    SheafOfModules.{u} (ringCatSheaf R) :=
  show PresheafOfModules.{u} (ringCatSheaf R).obj ⥤
      SheafOfModules.{u} (ringCatSheaf R) from
    PresheafOfModules.sheafification.{u}
      (R₀ := (ringCatSheaf R).obj) (R := ringCatSheaf R)
      (𝟙 ((ringCatSheaf R).obj))

/-- The canonical strong monoidal structure, at the explicit alias of the same functor. -/
local instance sheafificationMonoidal : (sheafification R).Monoidal :=
  TauCeti.SheafOfModules.sheafificationMonoidal R

/-- A genuine tensor product of the indicated actual exterior sheaves. -/
abbrev piece (ab : ℕ × ℕ) : SheafOfModules.{u} (ringCatSheaf R) :=
  (SheafOfModules.exteriorPower R ab.1).obj M ⊗
    (SheafOfModules.exteriorPower R ab.2).obj N

/-- Every degree decomposition is retained in the actual coproduct. -/
abbrev degreeSum (r : ℕ) : SheafOfModules.{u} (ringCatSheaf R) :=
  ∐ fun ab : DegreePair r => piece R M N ab.val

/-- The actual strong monoidal comparison identifies each summand with
the sheafification of the corresponding presheaf tensor product. -/
def pieceIso (ab : ℕ × ℕ) : piece R M N ab ≅
    (sheafification R).obj (PresheafExteriorProduct.piece M.val N.val ab) :=
  (SheafOfModules.exteriorPowerIso ab.1 M ⊗ᵢ
      SheafOfModules.exteriorPowerIso ab.2 N) ≪≫
    Functor.Monoidal.μIso (sheafification R)
      ((PresheafOfModulesOfCommRing.exteriorPower ab.1).obj M.val)
      ((PresheafOfModulesOfCommRing.exteriorPower ab.2).obj N.val)

/-- Sheafification preserves the full categorical sum of all summands. -/
def sourceIso (r : ℕ) : degreeSum R M N r ≅
    (sheafification R).obj (PresheafExteriorProduct.degreeSum M.val N.val r) :=
  Sigma.mapIso (fun ab : DegreePair r => pieceIso R M N ab.val) ≪≫
    (PreservesCoproduct.iso (sheafification R)
      (fun ab : DegreePair r => PresheafExteriorProduct.piece M.val N.val ab.val)).symm

/-- Each injection is preserved by the actual sum/tensor comparison. -/
@[reassoc] theorem sourceIso_ι (r : ℕ) (ab : DegreePair r) :
    Sigma.ι (fun ab : DegreePair r => piece R M N ab.val) ab ≫
      (sourceIso R M N r).hom =
      (pieceIso R M N ab.val).hom ≫
        (sheafification R).map
          (Sigma.ι (fun ab : DegreePair r =>
            PresheafExteriorProduct.piece M.val N.val ab.val) ab) := by
  simp only [sourceIso, Iso.trans_hom, Iso.symm_hom, Category.assoc,
    Sigma.ι_mapIso_hom_assoc, PreservesCoproduct.inv_hom,
    ι_comp_sigmaComparison]

/-- The forgetful functor preserves the actual binary product, hence
also the binary sum in these additive categories. -/
def underlyingBinaryIso :
    (M ⊞ N).val ≅ M.val ⊞ N.val :=
  (SheafOfModules.forget (ringCatSheaf R)).mapBiprod M N

/-- Change only the genuine underlying binary-sum comparison, then use
the defining sheafification description of the actual exterior power. -/
def targetIso (r : ℕ) :
    (sheafification R).obj
        ((PresheafOfModulesOfCommRing.exteriorPower r).obj (M.val ⊞ N.val)) ≅
      (SheafOfModules.exteriorPower R r).obj (M ⊞ N) :=
  (sheafification R).mapIso
      ((PresheafOfModulesOfCommRing.exteriorPower r).mapIso
        (underlyingBinaryIso R M N).symm) ≪≫
    (SheafOfModules.exteriorPowerIso r (M ⊞ N)).symm

/-- The canonical exterior direct-sum decomposition for the actual
sheaves and actual tensor products, in every exterior degree. -/
def productExteriorIso (r : ℕ) : degreeSum R M N r ≅
    (SheafOfModules.exteriorPower R r).obj (M ⊞ N) :=
  sourceIso R M N r ≪≫
    (sheafification R).mapIso
      (PresheafExteriorProduct.productExteriorIso M.val N.val r) ≪≫
    targetIso R M N r

/-- The actual sheaf comparison has the original summand wedge as its
component. This fixes the map used in the Koszul decomposition. -/
@[reassoc] theorem productExteriorIso_ι (r : ℕ) (ab : DegreePair r) :
    Sigma.ι (fun ab : DegreePair r => piece R M N ab.val) ab ≫
      (productExteriorIso R M N r).hom =
      (pieceIso R M N ab.val).hom ≫
        (sheafification R).map
          (PresheafExteriorProduct.blockWedgeAt M.val N.val r ab) ≫
        (targetIso R M N r).hom := by
  simp only [productExteriorIso, Iso.trans_hom, Functor.mapIso_hom,
    Category.assoc, sourceIso_ι_assoc]
  rw [← Functor.map_comp_assoc, PresheafExteriorProduct.productExteriorIso_ι]

end PaperVerification.Segre.SheafExteriorProduct

end SegreSheafExteriorProduct

section SegreFiniteSheafExterior

/-!
# Every exterior degree of an arbitrary finite sum of actual sheaves

This iterates the proved canonical binary exterior decomposition for an
arbitrary nonempty finite family. Its target is the exterior power of the
actual categorical product (equivalently the finite sum), exactly the
object used by the global singular-vector functional.

The recursive source keeps every pair a+b=r. The separate degree-index
equivalence identifies each recursion step with all full finite degree
tuples whose sum is r, so no bounded or restricted decomposition is used.
All sheaves, sums, tensors, and exterior powers are actual objects of the
existing module-sheaf category.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.FiniteSheafExterior

open CategoryTheory Limits MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open scoped BigOperators

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

attribute [local instance] HasBinaryBiproducts.of_hasBinaryProducts

abbrev DegreePair := ExteriorProductDecomposition.DegreePair

/-- Every full finite tuple of exterior degrees with exactly the required sum. -/
abbrev Degrees (k r : ℕ) := {p : Fin (k+1) → ℕ // (∑ i, p i)=r}

/-- Splitting a full degree tuple into its head and tail is a genuine
bijection, including all zero and large exterior degrees. -/
def splitDegrees (k r : ℕ) :
    (Σ ab : DegreePair r, Degrees k ab.val.2) ≃ Degrees (k+1) r where
  toFun x := ⟨Fin.cons x.1.val.1 x.2.val,by
    rw [Fin.sum_univ_succ]
    simpa only [Fin.cons_zero,Fin.cons_succ,x.2.property] using x.1.property⟩
  invFun p :=
    ⟨⟨(p.val 0,∑ i : Fin (k+1),p.val i.succ),by
        simpa only [Fin.sum_univ_succ] using p.property⟩,
      ⟨fun i => p.val i.succ,rfl⟩⟩
  left_inv x := by
    rcases x with ⟨⟨⟨a,b⟩,h⟩,⟨p,hp⟩⟩
    change (∑ i, p i) = b at hp
    subst b
    rfl
  right_inv p := by
    apply Subtype.ext
    funext i
    exact Fin.cases rfl (fun _ => rfl) i

/-- The actual right-associated finite binary sum. -/
def sumObj : {k : ℕ} →
    (Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) →
      SheafOfModules.{u} (ringCatSheaf R)
  | 0,M => M 0
  | k+1,M => M 0 ⊞ sumObj (fun i : Fin (k+1) => M i.succ)

/-- Every projection of the actual recursive sum. -/
def projection : {k : ℕ} →
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) →
      (i : Fin (k+1)) → (sumObj R M ⟶ M i)
  | 0,M,i => eqToHom (congrArg M (Fin.eq_zero i).symm)
  | k+1,M,i => Fin.cases biprod.fst
      (fun j => biprod.snd ≫ projection (fun l : Fin (k+1) => M l.succ) j) i

/-- The actual universal lifting morphism of the recursive sum. -/
def lift : {k : ℕ} →
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) →
      {Z : SheafOfModules.{u} (ringCatSheaf R)} →
      ((i : Fin (k+1)) → (Z ⟶ M i)) → (Z ⟶ sumObj R M)
  | 0,_,_,f => f 0
  | k+1,M,_,f => biprod.lift (f 0)
      (lift (fun i : Fin (k+1) => M i.succ) (fun i => f i.succ))

@[reassoc] theorem lift_projection {k : ℕ}
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R))
    {Z : SheafOfModules.{u} (ringCatSheaf R)}
    (f : (i : Fin (k+1)) → (Z ⟶ M i)) (i : Fin (k+1)) :
    lift R M f ≫ projection R M i=f i := by
  induction k with
  | zero =>
      have hi : i = 0 := Fin.eq_zero i
      subst i
      change f 0 ≫ 𝟙 (M 0) = f 0
      exact Category.comp_id _
  | succ k ih =>
      induction i using Fin.cases with
      | zero =>
          change biprod.lift (f 0)
              (lift R (fun j : Fin (k + 1) => M j.succ) (fun j => f j.succ)) ≫
            biprod.fst = f 0
          exact biprod.lift_fst _ _
      | succ i =>
          change biprod.lift (f 0)
              (lift R (fun j : Fin (k + 1) => M j.succ) (fun j => f j.succ)) ≫
            (biprod.snd ≫ projection R (fun j : Fin (k + 1) => M j.succ) i) =
              f i.succ
          rw [biprod.lift_snd_assoc]
          exact ih _ _ i

/-- Morphisms into the complete recursive sum are determined by every
original factor projection. -/
theorem projection_ext {k : ℕ}
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R))
    {Z : SheafOfModules.{u} (ringCatSheaf R)} {f g : Z ⟶ sumObj R M}
    (h : ∀ i, f ≫ projection R M i=g ≫ projection R M i) : f=g := by
  induction k with
  | zero =>
      have hzero := h 0
      change f ≫ 𝟙 (M 0) = g ≫ 𝟙 (M 0) at hzero
      exact (Category.comp_id f).symm.trans (hzero.trans (Category.comp_id g))
  | succ k ih =>
      apply biprod.hom_ext
      · have hzero := h 0
        change f ≫ biprod.fst = g ≫ biprod.fst at hzero
        exact hzero
      · apply ih (fun i : Fin (k + 1) => M i.succ)
        intro i
        have hsucc := h i.succ
        change f ≫ (biprod.snd ≫ projection R (fun j : Fin (k + 1) => M j.succ) i) =
          g ≫ (biprod.snd ≫ projection R (fun j : Fin (k + 1) => M j.succ) i) at hsucc
        exact (Category.assoc _ _ _).trans
          (hsucc.trans (Category.assoc _ _ _).symm)

/-- The recursive sum has the genuine universal property of the full
categorical product, with the stated projection maps. -/
def sumIsLimit {k : ℕ}
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) :
    IsLimit (Fan.mk (sumObj R M) (projection R M)) where
  lift s := lift R M (fun i => s.π.app ⟨i⟩)
  fac s i := lift_projection R M (fun j => s.π.app ⟨j⟩) i.as
  uniq s f h := by
    apply projection_ext R M
    intro i
    rw [lift_projection]
    exact h ⟨i⟩

/-- Identification with the actual categorical product used by the
singular-vector critical source. -/
def sumIsoProduct {k : ℕ}
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) :
    sumObj R M ≅ ∏ᶜ M :=
  (limit.isoLimitCone ⟨Fan.mk (sumObj R M) (projection R M),sumIsLimit R M⟩).symm

/-- Every full exterior summand, recursively distributed through the
actual tensor products and categorical coproducts. -/
def exteriorTerms : {k : ℕ} →
    (Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) → ℕ →
      SheafOfModules.{u} (ringCatSheaf R)
  | 0,M,r => (SheafOfModules.exteriorPower R r).obj (M 0)
  | k+1,M,r => ∐ fun ab : DegreePair r =>
      (SheafOfModules.exteriorPower R ab.val.1).obj (M 0) ⊗
        exteriorTerms (fun i : Fin (k+1) => M i.succ) ab.val.2

/-- The complete iterative exterior decomposition for every finite
family and every exterior degree. -/
def exteriorTermsIso : {k : ℕ} →
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) → (r : ℕ) →
      (exteriorTerms R M r ≅ (SheafOfModules.exteriorPower R r).obj (sumObj R M))
  | 0,_,_ => Iso.refl _
  | k+1,M,r =>
      Sigma.mapIso (fun ab : DegreePair r =>
        (Iso.refl ((SheafOfModules.exteriorPower R ab.val.1).obj (M 0))) ⊗ᵢ
          exteriorTermsIso (fun i : Fin (k+1) => M i.succ) ab.val.2) ≪≫
        SheafExteriorProduct.productExteriorIso R (M 0)
          (sumObj R (fun i : Fin (k+1) => M i.succ)) r

/-- The final target is the exterior power of the actual full product,
with no finite-format or exterior-degree bound. -/
def actualFiniteExteriorIso {k : ℕ}
    (M : Fin (k+1) → SheafOfModules.{u} (ringCatSheaf R)) (r : ℕ) :
    exteriorTerms R M r ≅ (SheafOfModules.exteriorPower R r).obj (∏ᶜ M) :=
  exteriorTermsIso R M r ≪≫
    (SheafOfModules.exteriorPower R r).mapIso (sumIsoProduct R M)

end PaperVerification.Segre.FiniteSheafExterior

end SegreFiniteSheafExterior

section SegreFiniteSheafExteriorFull

/-!
# The full exterior-degree decomposition of a finite sheaf sum

Every tuple of exterior degrees with the required sum occurs exactly once.
The recursive binary decomposition is flattened using the actual tensor
functor's coproduct comparison and the explicit degree-index equivalence.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.FiniteSheafExteriorFull

open CategoryTheory Limits MonoidalCategory
open TauCeti.SheafOfModules (ringCatSheaf)
open FiniteSheafExterior

universe u
variable {C : Type u} [SmallCategory C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (R : Sheaf J CommRingCat.{u})

set_option hygiene false in
set_option quotPrecheck false in local notation "Sh" => SheafOfModules.{u} (ringCatSheaf R)

/-- In a one-factor family the total exterior degree fixes its only entry. -/
instance singleDegreesUnique (r : ℕ) : Unique (Degrees 0 r) where
  default := ⟨fun _ => r, by simp⟩
  uniq p := by
    apply Subtype.ext
    funext i
    have hi : i = (0 : Fin 1) := Fin.eq_zero i
    subst i
    simpa using p.property

/-- The actual coproduct of all tensor products of exterior powers. -/
def fullTerms {k : ℕ} (M : Fin (k + 1) → Sh) (r : ℕ) : Sh :=
  ∐ fun p : Degrees k r =>
    FiniteTensor.tensorObj (fun i => (SheafOfModules.exteriorPower R (p.val i)).obj (M i))

/-- The entire recursive decomposition, including its unit at length one,
is the full coproduct indexed by all exterior-degree tuples. -/
def flattenExteriorTerms : {k : ℕ} → (M : Fin (k + 1) → Sh) → (r : ℕ) →
    (exteriorTerms R M r ≅ fullTerms R M r)
  | 0, M, r => by
      let e := coproductUniqueIso (fun p : Degrees 0 r =>
        FiniteTensor.tensorObj
          (fun i => (SheafOfModules.exteriorPower R (p.val i)).obj (M i)))
      exact (ρ_ ((SheafOfModules.exteriorPower R r).obj (M 0))).symm ≪≫ e.symm
  | k + 1, M, r => by
      let T : DegreePair r → Sh :=
        fun ab => (SheafOfModules.exteriorPower R ab.val.1).obj (M 0)
      let N : Fin (k + 1) → Sh := fun i => M i.succ
      let Q : (ab : DegreePair r) → Degrees k ab.val.2 → Sh :=
        fun _ p => FiniteTensor.tensorObj
          (fun i => (SheafOfModules.exteriorPower R (p.val i)).obj (N i))
      let e₁ := Sigma.mapIso (fun ab : DegreePair r =>
        Iso.refl (T ab) ⊗ᵢ flattenExteriorTerms N ab.val.2)
      let e₂ := Sigma.mapIso (fun ab : DegreePair r =>
        PreservesCoproduct.iso (tensorLeft (T ab)) (Q ab))
      let e₃ := sigmaSigmaIso (fun ab : DegreePair r => Degrees k ab.val.2)
        (fun ab p => T ab ⊗ Q ab p)
      let e₄ :
          (∐ fun s : Σ ab : DegreePair r, Degrees k ab.val.2 => T s.1 ⊗ Q s.1 s.2) ≅
            fullTerms R M r :=
        Sigma.whiskerEquiv (C := SheafOfModules.{u} (ringCatSheaf R))
          (f := fun s : Σ ab : DegreePair r, Degrees k ab.val.2 => T s.1 ⊗ Q s.1 s.2)
          (g := fun p : Degrees (k + 1) r => FiniteTensor.tensorObj
            (fun i => (SheafOfModules.exteriorPower R (p.val i)).obj (M i)))
          (splitDegrees k r) (fun _ => Iso.refl _)
      exact e₁ ≪≫ e₂ ≪≫ e₃ ≪≫ e₄

/-- The complete degree-tuple decomposition identifies the exterior power
of the literal categorical product used by the critical functional. -/
def actualFiniteExteriorFullIso {k : ℕ} (M : Fin (k + 1) → Sh) (r : ℕ) :
    fullTerms R M r ≅ (SheafOfModules.exteriorPower R r).obj (∏ᶜ M) :=
  (flattenExteriorTerms R M r).symm ≪≫ actualFiniteExteriorIso R M r

end PaperVerification.Segre.FiniteSheafExteriorFull

end SegreFiniteSheafExteriorFull

section SegrePullbackExteriorMap

/-!
# The canonical exterior comparison for pullback

The comparison is constructed from the actual adjunction and the actual
sheafified wedge of local sections. Its formula fixes the comparison on
all wedges of sections pulled from the base. No invertibility assertion
is built into the definition.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.PullbackExteriorMap

open CategoryTheory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open SheafCoefficientContraction

universe u
variable {X Y : Scheme.{u}} (f : X ⟶ Y)

/-- Wedges of actual sections commute with restriction. -/
theorem wedgeSection_restrict (M : X.Modules) (r : ℕ) {U V : X.Opens}
    (i : V ⟶ U) (v : Fin r → Γ(M, U)) :
    (show X.Modules from (SheafOfModules.exteriorPower X.sheaf r).obj M).presheaf.map i.op
      (wedgeSection X.sheaf M r (op U) v) =
        wedgeSection X.sheaf M r (op V) (fun a => M.presheaf.map i.op (v a)) := by
  have h := PresheafOfModules.naturality_apply
    (exteriorUnit X.sheaf M r) i.op (exteriorPower.ιMulti Γ(X, U) r v)
  erw [PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk] at h
  exact h.symm

/-- Exterior powers of actual sheaf morphisms act on every factor of a wedge. -/
theorem wedgeSection_map {M N : X.Modules} (φ : M ⟶ N) (r : ℕ)
    (U : X.Opens) (v : Fin r → Γ(M, U)) :
    AlgebraicGeometry.Scheme.Modules.Hom.app (X := X)
      ((SheafOfModules.exteriorPower X.sheaf r).map φ) U
      (wedgeSection X.sheaf M r (op U) v) =
        wedgeSection X.sheaf N r (op U) (fun a => φ.app U (v a)) := by
  exact SheafOfModules.exteriorPower_map_val_app_mk r φ (op U) v

/-- The sectionwise comparison changes the coefficient ring of the wedge
and then maps it to the genuine exterior-power sheaf. -/
def pushforwardExteriorApp (M : X.Modules) (r : ℕ) (U : Y.Opens) :
    (PresheafOfModulesOfCommRing.obj (R := Y.presheaf)
      ((pushforward f).obj M).val (op U)).exteriorPower r ⟶
      PresheafOfModulesOfCommRing.obj (R := Y.presheaf)
        ((pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M)).val
          (op U) :=
  ((TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison
      (f.app U).hom r).app
      (PresheafOfModulesOfCommRing.obj (R := X.presheaf) M.val (op (f ⁻¹ᵁ U)))) ≫
    (ModuleCat.restrictScalars (f.app U).hom).map
      ((exteriorUnit X.sheaf M r).app (op (f ⁻¹ᵁ U)))

@[simp] theorem pushforwardExteriorApp_mk (M : X.Modules) (r : ℕ)
    (U : Y.Opens) (v : Fin r → Γ((pushforward f).obj M, U)) :
    pushforwardExteriorApp f M r U (ModuleCat.exteriorPower.mk v) =
      wedgeSection X.sheaf M r (op (f ⁻¹ᵁ U)) v :=
  congrArg (fun z => (exteriorUnit X.sheaf M r).app (op (f ⁻¹ᵁ U)) z)
    (TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison_app_mk
      (f.app U).hom r
      (PresheafOfModulesOfCommRing.obj (R := X.presheaf) M.val (op (f ⁻¹ᵁ U))) v)

set_option maxHeartbeats 800000 in
/-- The coefficient-changing comparison is compatible with every actual
restriction, so it defines a morphism of module presheaves. -/
def pushforwardExteriorPresheaf (M : X.Modules) (r : ℕ) :
    (PresheafOfModulesOfCommRing.exteriorPower r).obj ((pushforward f).obj M).val ⟶
      ((pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M)).val := by
  let P' : PresheafOfModulesOfCommRing.{u} Y.presheaf := ((pushforward f).obj M).val
  let E' : PresheafOfModulesOfCommRing.{u} Y.presheaf :=
    (PresheafOfModulesOfCommRing.exteriorPower (R := Y.presheaf) r).obj P'
  let T' : PresheafOfModulesOfCommRing.{u} Y.presheaf :=
    ((pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M)).val
  let e : ∀ U : Y.Opensᵒᵖ, E'.obj U ⟶ T'.obj U :=
    fun U => pushforwardExteriorApp f M r U.unop
  change E' ⟶ T'
  refine PresheafOfModulesOfCommRing.homMk
    (R := Y.presheaf) (M₁ := E') (M₂ := T') e ?_
  intro U V i
  let A : ModuleCat.{u} (Y.presheaf.obj U) := P'.obj U
  let B : ModuleCat.{u} (Y.presheaf.obj U) :=
    (ModuleCat.restrictScalars.{u} (Y.presheaf.map i).hom).obj (T'.obj V)
  let leftMap : A.exteriorPower r ⟶ B :=
    E'.map i ≫ (ModuleCat.restrictScalars.{u} (Y.presheaf.map i).hom).map (e V)
  let rightMap : A.exteriorPower r ⟶ B := e U ≫ T'.map i
  change leftMap = rightMap
  apply ModuleCat.exteriorPower.hom_ext
    (R := Y.presheaf.obj U) (M := A) (N := B) (n := r)
    (f := leftMap) (g := rightMap)
  apply ModuleCat.AlternatingMap.ext
  intro v
  change pushforwardExteriorApp f M r V.unop
      (((PresheafOfModulesOfCommRing.exteriorPower (R := Y.presheaf) r).obj P').map i
        (ModuleCat.exteriorPower.mk v)) =
    T'.map i (pushforwardExteriorApp f M r U.unop (ModuleCat.exteriorPower.mk v))
  erw [PresheafOfModulesOfCommRing.exteriorPower_obj_map_mk,
    pushforwardExteriorApp_mk, pushforwardExteriorApp_mk]
  exact (wedgeSection_restrict M r ((TopologicalSpace.Opens.map f.base).map i.unop) v).symm

/-- The actual pushforward comparison, extended by the universal property
of sheafification. -/
def pushforwardExteriorComparison (M : X.Modules) (r : ℕ) :
    (SheafOfModules.exteriorPower Y.sheaf r).obj ((pushforward f).obj M) ⟶
      (pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M) :=
  (SheafOfModules.exteriorPowerIso r ((pushforward f).obj M)).hom ≫
    ((TauCeti.SheafOfModules.sheafificationForgetAdjunction Y.sheaf).homEquiv _ _).symm
      (pushforwardExteriorPresheaf f M r)

/-- The comparison restricts to its prescribed sectionwise map. -/
@[reassoc] theorem exteriorUnit_pushforwardComparison (M : X.Modules) (r : ℕ) :
    exteriorUnit Y.sheaf ((pushforward f).obj M) r ≫
        (pushforwardExteriorComparison f M r).val =
      pushforwardExteriorPresheaf f M r := by
  let A := TauCeti.SheafOfModules.sheafificationForgetAdjunction Y.sheaf
  let E := SheafOfModules.exteriorPowerIso r ((pushforward f).obj M)
  let P := (PresheafOfModulesOfCommRing.exteriorPower r).obj ((pushforward f).obj M).val
  let N : Y.Modules := (pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M)
  let F := PresheafOfModules.sheafification.{u}
    (𝟙 (TauCeti.SheafOfModules.ringCatSheaf Y.sheaf).obj)
  let g : F.obj P ⟶ N := (A.homEquiv P N).symm (pushforwardExteriorPresheaf f M r)
  let G := SheafOfModules.forget (TauCeti.SheafOfModules.ringCatSheaf Y.sheaf)
  change (A.unit.app P ≫ G.map E.inv) ≫ G.map (E.hom ≫ g) = _
  calc
    (A.unit.app P ≫ G.map E.inv) ≫ G.map (E.hom ≫ g) =
        A.unit.app P ≫ (G.map E.inv ≫ G.map (E.hom ≫ g)) :=
      Category.assoc _ _ _
    _ = A.unit.app P ≫ G.map (E.inv ≫ (E.hom ≫ g)) :=
      congrArg (fun k : G.obj (F.obj P) ⟶ G.obj N => A.unit.app P ≫ k)
        (G.map_comp E.inv (E.hom ≫ g)).symm
    _ = A.unit.app P ≫ G.map g :=
      congrArg (fun k : F.obj P ⟶ N => A.unit.app P ≫ G.map k)
        (E.inv_hom_id_assoc g)
    _ = pushforwardExteriorPresheaf f M r :=
      (A.homEquiv P N).apply_symm_apply (pushforwardExteriorPresheaf f M r)

/-- The pushforward comparison preserves the actual local wedge. -/
theorem pushforwardExteriorComparison_wedge (M : X.Modules) (r : ℕ)
    (U : Y.Opens) (v : Fin r → Γ((pushforward f).obj M, U)) :
    AlgebraicGeometry.Scheme.Modules.Hom.app (X := Y)
      (pushforwardExteriorComparison f M r) U
      (wedgeSection Y.sheaf ((pushforward f).obj M) r (op U) v) =
        wedgeSection X.sheaf M r (op (f ⁻¹ᵁ U)) v := by
  have h := congrArg
    (fun g : (PresheafOfModulesOfCommRing.exteriorPower r).obj ((pushforward f).obj M).val ⟶
        ((pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M)).val =>
      (g.app' (op U)).hom (ModuleCat.exteriorPower.mk v))
    (exteriorUnit_pushforwardComparison f M r)
  change AlgebraicGeometry.Scheme.Modules.Hom.app (X := Y)
      (pushforwardExteriorComparison f M r) U
      (wedgeSection Y.sheaf ((pushforward f).obj M) r (op U) v) =
    pushforwardExteriorApp f M r U (ModuleCat.exteriorPower.mk v) at h
  exact h.trans (pushforwardExteriorApp_mk f M r U v)

/-- The genuine pullback comparison is the adjoint of the exterior power
of the adjunction unit followed by the genuine pushforward comparison. -/
def pullbackExteriorComparison (M : Y.Modules) (r : ℕ) :
    (pullback f).obj ((SheafOfModules.exteriorPower Y.sheaf r).obj M) ⟶
      (SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M) :=
  ((pullbackPushforwardAdjunction f).homEquiv _ _).symm
    ((SheafOfModules.exteriorPower Y.sheaf r).map
        ((pullbackPushforwardAdjunction f).unit.app M) ≫
      pushforwardExteriorComparison f ((pullback f).obj M) r)

/-- The full adjunction equation, before any section or dimension is chosen. -/
@[reassoc] theorem pullbackExteriorComparison_adjunction (M : Y.Modules) (r : ℕ) :
    (pullbackPushforwardAdjunction f).unit.app
        ((SheafOfModules.exteriorPower Y.sheaf r).obj M) ≫
      (pushforward f).map (pullbackExteriorComparison f M r) =
    (SheafOfModules.exteriorPower Y.sheaf r).map
        ((pullbackPushforwardAdjunction f).unit.app M) ≫
      pushforwardExteriorComparison f ((pullback f).obj M) r :=
  ((pullbackPushforwardAdjunction f).homEquiv _ _).apply_symm_apply _

/-- Pullback of a sheafified wedge is the sheafified wedge of the actual
pulled sections, through the canonical comparison. -/
theorem pullbackExteriorComparison_wedge (M : Y.Modules) (r : ℕ)
    (U : Y.Opens) (v : Fin r → Γ(M, U)) :
    (pullbackExteriorComparison f M r).app (f ⁻¹ᵁ U)
      (f.pullbackSections ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U
        (wedgeSection Y.sheaf M r (op U) v)) =
      wedgeSection X.sheaf ((pullback f).obj M) r (op (f ⁻¹ᵁ U))
        (fun a => f.pullbackSections M U (v a)) := by
  have h := congrArg
    (fun g : (show Y.Modules from (SheafOfModules.exteriorPower Y.sheaf r).obj M) ⟶
        (pushforward f).obj ((SheafOfModules.exteriorPower X.sheaf r).obj
          ((pullback f).obj M)) =>
      g.app U (wedgeSection Y.sheaf M r (op U) v))
    (pullbackExteriorComparison_adjunction f M r)
  change (pullbackExteriorComparison f M r).app (f ⁻¹ᵁ U)
      (f.pullbackSections ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U
        (wedgeSection Y.sheaf M r (op U) v)) =
    AlgebraicGeometry.Scheme.Modules.Hom.app (X := Y)
      (pushforwardExteriorComparison f ((pullback f).obj M) r) U
      (AlgebraicGeometry.Scheme.Modules.Hom.app (X := Y)
        ((SheafOfModules.exteriorPower Y.sheaf r).map
          ((pullbackPushforwardAdjunction f).unit.app M)) U
          (wedgeSection Y.sheaf M r (op U) v)) at h
  exact h.trans ((congrArg
    (fun z => AlgebraicGeometry.Scheme.Modules.Hom.app (X := Y)
      (pushforwardExteriorComparison f ((pullback f).obj M) r) U z)
    (wedgeSection_map ((pullbackPushforwardAdjunction f).unit.app M) r U v)).trans
      (pushforwardExteriorComparison_wedge f ((pullback f).obj M) r U
        (fun a => ((pullbackPushforwardAdjunction f).unit.app M).app U (v a))))

end PaperVerification.Segre.PullbackExteriorMap

end SegrePullbackExteriorMap

section SegreAffineExteriorSections

/-!
# Actual affine sections of exterior powers

The canonical map from the exterior power of global sections to global
sections of the exterior sheaf is proved invertible for quasicoherent
sheaves on an affine spectrum. The proof uses the genuine tilde exterior
comparison and retains its formula on every wedge. Restriction then gives
the corresponding comparison on any affine open of a scheme.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.AffineExteriorSections

open CategoryTheory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open AffineTensorSections SheafCoefficientContraction SchemeExteriorRestriction
open TauCeti.AlgebraicGeometry

universe u
variable {R : CommRingCat.{u}}

/-- Exterior powers of a quasicoherent sheaf on a spectrum are themselves
quasicoherent, by the actual tilde exterior comparison. -/
theorem exteriorPower_quasicoherent_spec (M : (Spec R).Modules)
    [M.IsQuasicoherent] (r : ℕ) :
    ((SheafOfModules.exteriorPower (Spec R).sheaf r).obj M).IsQuasicoherent := by
  letI : IsIso M.fromTildeΓ :=
    AlgebraicGeometry.Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent M
  let e := (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r
      (moduleSpecΓFunctor.obj M)) ≪≫
    (SheafOfModules.exteriorPower (Spec R).sheaf r).mapIso (asIso M.fromTildeΓ)
  exact (SheafOfModules.isQuasicoherent (Spec R).ringCatSheaf).prop_of_iso e inferInstance

/-- The spectrum calculation transports along the actual affine-scheme
isomorphism and the proved exterior restriction comparison. -/
theorem exteriorPower_quasicoherent_affine {X : Scheme.{u}} [IsAffine X]
    (M : X.Modules) [M.IsQuasicoherent] (r : ℕ) :
    ((SheafOfModules.exteriorPower X.sheaf r).obj M).IsQuasicoherent := by
  have h := exteriorPower_quasicoherent_spec (M.restrict X.isoSpec.inv) r
  letI h' : ((show X.Modules from (SheafOfModules.exteriorPower X.sheaf r).obj M).restrict
      X.isoSpec.inv).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent (Spec Γ(X, ⊤)).ringCatSheaf).prop_of_iso
      (restrictExteriorIso X.isoSpec.inv M r).symm h
  exact isQuasicoherent_of_isQuasicoherent_restrict_iso X.isoSpec
    ((SheafOfModules.exteriorPower X.sheaf r).obj M)

/-- Every actual exterior power of every quasicoherent scheme module is
quasicoherent. No locally free or finite-rank hypothesis is needed. -/
instance exteriorPower_quasicoherent {X : Scheme.{u}}
    (M : X.Modules) [M.IsQuasicoherent] (r : ℕ) :
    ((SheafOfModules.exteriorPower X.sheaf r).obj M).IsQuasicoherent := by
  refine isQuasicoherent_of_isQuasicoherent_restrict_affineOpens _ fun U => ?_
  have h := exteriorPower_quasicoherent_affine (M.restrict U.1.ι) r
  exact (SheafOfModules.isQuasicoherent U.1.toScheme.ringCatSheaf).prop_of_iso
    (restrictExteriorIso U.1.ι M r).symm h

/-- The actual wedge map on all global sections, with coefficients
transported through the canonical spectrum global-section isomorphism. -/
def globalExteriorMap (M : (Spec R).Modules) (r : ℕ) :
    (AffineTensorSections.globalSections.obj M).exteriorPower r ⟶
      AffineTensorSections.globalSections.obj ((SheafOfModules.exteriorPower (Spec R).sheaf r).obj M) :=
  ((TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison
      (Scheme.ΓSpecIso R).inv.hom r).app
      (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) M.val (op ⊤))) ≫
    (ModuleCat.restrictScalars (Scheme.ΓSpecIso R).inv.hom).map
      ((exteriorUnit (Spec R).sheaf M r).app (op ⊤))

@[simp] theorem globalExteriorMap_mk (M : (Spec R).Modules) (r : ℕ)
    (v : Fin r → AffineTensorSections.globalSections.obj M) :
    globalExteriorMap M r (ModuleCat.exteriorPower.mk v) =
      wedgeSection (Spec R).sheaf M r (op ⊤) v :=
  congrArg (fun z => (exteriorUnit (Spec R).sheaf M r).app (op ⊤) z)
    (TauCeti.ModuleCat.restrictScalarsExteriorPowerComparison_app_mk
      (Scheme.ΓSpecIso R).inv.hom r
      (PresheafOfModulesOfCommRing.obj (R := (Spec R).presheaf) M.val (op ⊤)) v)

/-- The comparison is natural in the entire sheaf, not only on chosen
generators or finite-dimensional spaces. -/
@[reassoc] theorem globalExteriorMap_natural {M N : (Spec R).Modules}
    (φ : M ⟶ N) (r : ℕ) :
    ModuleCat.exteriorPower.map (AffineTensorSections.globalSections.map φ) r ≫ globalExteriorMap N r =
      globalExteriorMap M r ≫
        AffineTensorSections.globalSections.map ((SheafOfModules.exteriorPower (Spec R).sheaf r).map φ) := by
  apply ModuleCat.exteriorPower.hom_ext
  ext v
  change globalExteriorMap N r
      (ModuleCat.exteriorPower.map (AffineTensorSections.globalSections.map φ) r
        (ModuleCat.exteriorPower.mk (R := R) v)) =
    (AffineTensorSections.globalSections.map
      ((SheafOfModules.exteriorPower (Spec R).sheaf r).map φ))
      (globalExteriorMap M r (ModuleCat.exteriorPower.mk (R := R) v))
  rw [ModuleCat.exteriorPower.map_mk, globalExteriorMap_mk, globalExteriorMap_mk]
  exact (SheafOfModules.exteriorPower_map_val_app_mk r φ (op ⊤) v).symm

/-- On associated sheaves, the actual affine comparison agrees on every
wedge with the independently proved tilde exterior isomorphism. -/
theorem tilde_globalExteriorMap (M : ModuleCat.{u} R) (r : ℕ) :
    ModuleCat.exteriorPower.map (tildeSectionIso M).hom r ≫
        globalExteriorMap (tilde M) r ≫
        AffineTensorSections.globalSections.map (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r M).inv =
      (tildeSectionIso (M.exteriorPower r)).hom := by
  apply ModuleCat.exteriorPower.hom_ext
  ext v
  change (AffineTensorSections.globalSections.map
      (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r M).inv)
      (globalExteriorMap (tilde M) r
        (ModuleCat.exteriorPower.map (tildeSectionIso M).hom r
          (ModuleCat.exteriorPower.mk (R := R) v))) =
    (tildeSectionIso (M.exteriorPower r)).hom
      (ModuleCat.exteriorPower.mk (R := R) v)
  rw [ModuleCat.exteriorPower.map_mk, globalExteriorMap_mk]
  exact TauCeti.AlgebraicGeometry.tildeExteriorPowerIso_inv_toOpen_mk r M ⊤ v

instance globalExteriorMap_tilde_isIso (M : ModuleCat.{u} R) (r : ℕ) :
    IsIso (globalExteriorMap (tilde M) r) := by
  haveI h : IsIso (ModuleCat.exteriorPower.map (tildeSectionIso M).hom r ≫
      globalExteriorMap (tilde M) r ≫
      AffineTensorSections.globalSections.map (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r M).inv) := by
    rw [tilde_globalExteriorMap]
    infer_instance
  haveI hleft : IsIso (ModuleCat.exteriorPower.map (tildeSectionIso M).hom r) :=
    (ModuleCat.exteriorPower.functor R r).map_isIso _
  haveI hmiddle : IsIso (globalExteriorMap (tilde M) r ≫
      AffineTensorSections.globalSections.map (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r M).inv) :=
    IsIso.of_isIso_comp_left
      (ModuleCat.exteriorPower.map (tildeSectionIso M).hom r)
      (globalExteriorMap (tilde M) r ≫
        AffineTensorSections.globalSections.map
          (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r M).inv)
  exact IsIso.of_isIso_comp_right (globalExteriorMap (tilde M) r)
    (AffineTensorSections.globalSections.map
      (TauCeti.AlgebraicGeometry.tildeExteriorPowerIso r M).inv)

/-- The canonical map is invertible for every quasicoherent sheaf on an
affine spectrum, without finite rank or freeness assumptions. -/
instance globalExteriorMap_isIso (M : (Spec R).Modules) [M.IsQuasicoherent] (r : ℕ) :
    IsIso (globalExteriorMap M r) := by
  letI : IsIso M.fromTildeΓ :=
    AlgebraicGeometry.Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent M
  let e := asIso M.fromTildeΓ
  haveI h : IsIso (ModuleCat.exteriorPower.map (AffineTensorSections.globalSections.map e.hom) r ≫
      globalExteriorMap M r) := by
    rw [globalExteriorMap_natural]
    infer_instance
  haveI he : IsIso (ModuleCat.exteriorPower.map (AffineTensorSections.globalSections.map e.hom) r) :=
    (ModuleCat.exteriorPower.functor R r).map_isIso _
  exact IsIso.of_isIso_comp_left
    (ModuleCat.exteriorPower.map (AffineTensorSections.globalSections.map e.hom) r)
    (globalExteriorMap M r)

/-- The actual full global exterior-section isomorphism. -/
def globalExteriorSectionsIso (M : (Spec R).Modules) [M.IsQuasicoherent] (r : ℕ) :
    (AffineTensorSections.globalSections.obj M).exteriorPower r ≅
      AffineTensorSections.globalSections.obj ((SheafOfModules.exteriorPower (Spec R).sheaf r).obj M) :=
  asIso (globalExteriorMap M r)

@[simp] theorem globalExteriorSectionsIso_mk (M : (Spec R).Modules)
    [M.IsQuasicoherent] (r : ℕ) (v : Fin r → AffineTensorSections.globalSections.obj M) :
    (globalExteriorSectionsIso M r).hom (ModuleCat.exteriorPower.mk v) =
      wedgeSection (Spec R).sheaf M r (op ⊤) v :=
  globalExteriorMap_mk M r v

/-- On every actual affine open, all sections of the exterior sheaf are
the exterior power of all sections of the original quasicoherent sheaf. -/
def affineExteriorSectionsIso {X : Scheme.{u}} {U : X.Opens}
    (hU : IsAffineOpen U) (M : X.Modules) [M.IsQuasicoherent] (r : ℕ) :
    ((sectionsFunctor U).obj M).exteriorPower r ≅
      (sectionsFunctor U).obj ((SheafOfModules.exteriorPower X.sheaf r).obj M) :=
  (ModuleCat.exteriorPower.functor Γ(X, U) r).mapIso ((chartSectionsIso hU).app M) ≪≫
    globalExteriorSectionsIso (M.restrict hU.fromSpec) r ≪≫
    AffineTensorSections.globalSections.mapIso (restrictExteriorIso hU.fromSpec M r).symm ≪≫
    ((chartSectionsIso hU).app ((SheafOfModules.exteriorPower X.sheaf r).obj M)).symm

/-- The affine chart section equivalence and exterior restriction comparison
preserve the wedge of every tuple of actual sections. -/
theorem chartExteriorSections_wedge {X : Scheme.{u}} {U : X.Opens}
    (hU : IsAffineOpen U) (M : X.Modules) (r : ℕ)
    (v : Fin r → Γ(M, U)) :
    AffineTensorSections.globalSections.map (restrictExteriorIso hU.fromSpec M r).inv
      (wedgeSection (Spec Γ(X, U)).sheaf (M.restrict hU.fromSpec) r (op ⊤)
        (fun a => ((chartSectionsIso hU).app M).hom (v a))) =
      ((chartSectionsIso hU).app
        ((SheafOfModules.exteriorPower X.sheaf r).obj M)).hom
          (wedgeSection X.sheaf M r (op U) v) := by
  change (restrictExteriorIso hU.fromSpec M r).inv.app ⊤
      (wedgeSection (Spec Γ(X, U)).sheaf (M.restrict hU.fromSpec) r (op ⊤)
        (fun a => M.fromSpecSectionsEquiv hU (v a))) =
      (show X.Modules from (SheafOfModules.exteriorPower X.sheaf r).obj M).fromSpecSectionsEquiv hU
        (wedgeSection X.sheaf M r (op U) v)
  rw [restrictExteriorIso_inv_wedge]
  simp only [fromSpecSectionsEquiv_apply]
  exact (PullbackExteriorMap.wedgeSection_restrict M r _ v).symm

/-- The full affine exterior-section isomorphism is the canonical wedge
map, rather than an isomorphism chosen only by dimension or rank. -/
@[simp] theorem affineExteriorSectionsIso_mk {X : Scheme.{u}} {U : X.Opens}
    (hU : IsAffineOpen U) (M : X.Modules) [M.IsQuasicoherent] (r : ℕ)
    (v : Fin r → Γ(M, U)) :
    (affineExteriorSectionsIso hU M r).hom (ModuleCat.exteriorPower.mk v) =
      wedgeSection X.sheaf M r (op U) v := by
  let E : X.Modules := (SheafOfModules.exteriorPower X.sheaf r).obj M
  let e := (chartSectionsIso hU).app E
  let g := AffineTensorSections.globalSections.map
    (restrictExteriorIso hU.fromSpec M r).inv
  let eExterior := globalExteriorSectionsIso (M.restrict hU.fromSpec) r
  change e.inv (g (eExterior.hom
      (ModuleCat.exteriorPower.map ((chartSectionsIso hU).app M).hom r
        (ModuleCat.exteriorPower.mk (R := Γ(X, U)) v)))) =
    wedgeSection X.sheaf M r (op U) v
  have hmap := ModuleCat.exteriorPower.map_mk ((chartSectionsIso hU).app M).hom v
  have hglobal := globalExteriorSectionsIso_mk (M.restrict hU.fromSpec) r
    (fun a => ((chartSectionsIso hU).app M).hom (v a))
  have hchart := chartExteriorSections_wedge hU M r v
  exact (congrArg (fun z => e.inv (g (eExterior.hom z))) hmap).trans
    ((congrArg (fun z => e.inv (g z)) hglobal).trans
      ((congrArg (fun z => e.inv z) hchart).trans
        (ConcreteCategory.congr_hom e.hom_inv_id _)))

end PaperVerification.Segre.AffineExteriorSections

end SegreAffineExteriorSections

section SegrePullbackExteriorIso

/-!
# Exterior powers of the actual pullback

The canonical comparison is proved to be an isomorphism on a basis of
affine opens contained in inverse images of affine opens. On each such
pair the genuine pullback-section equivalence and genuine affine
exterior-section equivalences identify it with extension of scalars for
exterior powers. Its formula on all wedges fixes the identification.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false

namespace PaperVerification.Segre.PullbackExteriorMap

open CategoryTheory AlgebraicGeometry Opposite
open AlgebraicGeometry.Scheme.Modules
open SheafCoefficientContraction AffineExteriorSections AffinePullbackSections
open scoped TensorProduct ChangeOfRings

universe u
variable {X Y : Scheme.{u}} (f : X ⟶ Y)

/-- The canonical exterior comparison also respects sections pulled back
to any smaller source open. -/
theorem pullbackExteriorComparison_wedgeLE (M : Y.Modules) (r : ℕ)
    (U : Y.Opens) (V : X.Opens) (h : V ≤ f ⁻¹ᵁ U)
    (v : Fin r → Γ(M, U)) :
    (pullbackExteriorComparison f M r).app V
      (f.pullbackSectionsLE ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U V h
        (wedgeSection Y.sheaf M r (op U) v)) =
      wedgeSection X.sheaf ((pullback f).obj M) r (op V)
        (fun a => f.pullbackSectionsLE M U V h (v a)) := by
  have hn := PresheafOfModules.naturality_apply
    (pullbackExteriorComparison f M r).val (homOfLE h).op
    (f.pullbackSections ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U
      (wedgeSection Y.sheaf M r (op U) v))
  have hw := congrArg
    (fun z => ((SheafOfModules.exteriorPower X.sheaf r).obj
      ((pullback f).obj M)).val.map (homOfLE h).op z)
    (pullbackExteriorComparison_wedge f M r U v)
  change (pullbackExteriorComparison f M r).val.app (op V)
      (((pullback f).obj ((SheafOfModules.exteriorPower Y.sheaf r).obj M)).val.map
        (homOfLE h).op
        (f.pullbackSections ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U
          (wedgeSection Y.sheaf M r (op U) v))) =
    wedgeSection X.sheaf ((pullback f).obj M) r (op V)
      (fun a => ((pullback f).obj M).val.map (homOfLE h).op
        (f.pullbackSections M U (v a)))
  exact hn.trans (hw.trans
      (wedgeSection_restrict ((pullback f).obj M) r (homOfLE h)
        (fun a => f.pullbackSections M U (v a))))

section AffineComparison

variable (M : Y.Modules) [M.IsQuasicoherent] (r : ℕ)
variable {U : Y.Opens} {V : X.Opens}
variable (hU : IsAffineOpen U) (hV : IsAffineOpen V) (h : V ≤ f ⁻¹ᵁ U)

abbrev chartAlgebra : Algebra Γ(Y, U) Γ(X, V) :=
  (f.appLE U V h).hom.toAlgebra

/-- The complete source of the affine comparison, with its actual
extension-of-scalars and exterior-section identifications. -/
def sourceExteriorSectionsEquiv :
    letI := chartAlgebra f h
    Γ(X, V) ⊗[Γ(Y, U)] (⋀[Γ(Y, U)]^r Γ(M, U)) ≃ₗ[Γ(X, V)]
      Γ((pullback f).obj ((SheafOfModules.exteriorPower Y.sheaf r).obj M), V) := by
  letI := chartAlgebra f h
  exact ((affineExteriorSectionsIso hU M r).toLinearEquiv.baseChange Γ(Y, U) Γ(X, V)).trans
    (pullbackSectionsLEEquiv ((SheafOfModules.exteriorPower Y.sheaf r).obj M)
      hU f hV h)

/-- The complete target of the affine comparison, with the canonical
exterior-power base-change map and actual pullback of sections. -/
def targetExteriorSectionsEquiv :
    letI := chartAlgebra f h
    Γ(X, V) ⊗[Γ(Y, U)] (⋀[Γ(Y, U)]^r Γ(M, U)) ≃ₗ[Γ(X, V)]
      Γ((SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M), V) := by
  letI := chartAlgebra f h
  let S : ModuleCat.{u} Γ(X, V) :=
    ModuleCat.of Γ(X, V) (Γ(X, V) ⊗[Γ(Y, U)] Γ(M, U))
  let T : ModuleCat.{u} Γ(X, V) := (sectionsFunctor V).obj ((pullback f).obj M)
  let P : S ≅ T := (pullbackSectionsLEEquiv M hU f hV h).toModuleIso
  let Q : S.exteriorPower r ≅ T.exteriorPower r :=
    (ModuleCat.exteriorPower.functor Γ(X, V) r).mapIso P
  let W : T.exteriorPower r ≅ (sectionsFunctor V).obj
      ((SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M)) :=
    affineExteriorSectionsIso hV ((pullback f).obj M) r
  exact (TauCeti.exteriorPower.equivBaseChange (R := Γ(Y, U)) (M := Γ(M, U))
    Γ(X, V) r).symm.trans (Q.toLinearEquiv.trans W.toLinearEquiv)

@[simp] theorem sourceExteriorSectionsEquiv_tmul_wedge
    (a : Γ(X, V)) (v : Fin r → Γ(M, U)) :
    letI := chartAlgebra f h
    sourceExteriorSectionsEquiv f M r hU hV h
      (a ⊗ₜ[Γ(Y, U)] exteriorPower.ιMulti Γ(Y, U) r v) =
      a • f.pullbackSectionsLE ((SheafOfModules.exteriorPower Y.sheaf r).obj M)
        U V h (wedgeSection Y.sheaf M r (op U) v) := by
  letI := chartAlgebra f h
  let E : (⋀[Γ(Y, U)]^r Γ(M, U)) ≃ₗ[Γ(Y, U)]
      Γ((SheafOfModules.exteriorPower Y.sheaf r).obj M, U) :=
    (affineExteriorSectionsIso hU M r).toLinearEquiv
  let P : Γ(X, V) ⊗[Γ(Y, U)]
      Γ((SheafOfModules.exteriorPower Y.sheaf r).obj M, U) ≃ₗ[Γ(X, V)]
      Γ((pullback f).obj ((SheafOfModules.exteriorPower Y.sheaf r).obj M), V) :=
    pullbackSectionsLEEquiv ((SheafOfModules.exteriorPower Y.sheaf r).obj M)
      hU f hV h
  have he : E (exteriorPower.ιMulti Γ(Y, U) r v) =
      wedgeSection Y.sheaf M r (op U) v := affineExteriorSectionsIso_mk hU M r v
  have ht : a ⊗ₜ[Γ(Y, U)] wedgeSection Y.sheaf M r (op U) v =
      a • ((1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)] wedgeSection Y.sheaf M r (op U) v) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  change P ((E.baseChange Γ(Y, U) Γ(X, V))
      (a ⊗ₜ[Γ(Y, U)] exteriorPower.ιMulti Γ(Y, U) r v)) = _
  calc
    _ = P (a ⊗ₜ[Γ(Y, U)] E (exteriorPower.ιMulti Γ(Y, U) r v)) :=
      congrArg P (LinearEquiv.baseChange_tmul Γ(Y, U) Γ(X, V) _ _ (e := E) a _)
    _ = P (a ⊗ₜ[Γ(Y, U)] wedgeSection Y.sheaf M r (op U) v) :=
      congrArg (fun z => P (a ⊗ₜ[Γ(Y, U)] z)) he
    _ = P (a • ((1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)]
        wedgeSection Y.sheaf M r (op U) v)) := congrArg P ht
    _ = a • P ((1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)]
        wedgeSection Y.sheaf M r (op U) v) := P.map_smul a _
    _ = _ := congrArg (fun z => a • z)
      (pullbackSectionsLEEquiv_one_tmul
        ((SheafOfModules.exteriorPower Y.sheaf r).obj M) hU f hV h
        (wedgeSection Y.sheaf M r (op U) v))

@[simp] theorem targetExteriorSectionsEquiv_tmul_wedge
    (a : Γ(X, V)) (v : Fin r → Γ(M, U)) :
    letI := chartAlgebra f h
    targetExteriorSectionsEquiv f M r hU hV h
      (a ⊗ₜ[Γ(Y, U)] exteriorPower.ιMulti Γ(Y, U) r v) =
      a • wedgeSection X.sheaf ((pullback f).obj M) r (op V)
        (fun i => f.pullbackSectionsLE M U V h (v i)) := by
  letI := chartAlgebra f h
  let S : ModuleCat.{u} Γ(X, V) :=
    ModuleCat.of Γ(X, V) (Γ(X, V) ⊗[Γ(Y, U)] Γ(M, U))
  let T : ModuleCat.{u} Γ(X, V) := (sectionsFunctor V).obj ((pullback f).obj M)
  let P : S ≅ T := (pullbackSectionsLEEquiv M hU f hV h).toModuleIso
  let W : T.exteriorPower r ≅ (sectionsFunctor V).obj
      ((SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M)) :=
    affineExteriorSectionsIso hV ((pullback f).obj M) r
  simp only [targetExteriorSectionsEquiv, LinearEquiv.trans_apply,
    TauCeti.exteriorPower.equivBaseChange_symm_tmul_ιMulti, _root_.map_smul]
  change a • W.hom (ModuleCat.exteriorPower.map P.hom r
      (ModuleCat.exteriorPower.mk (M := S)
        (fun i => (1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)] v i))) = _
  have hmap := ModuleCat.exteriorPower.map_mk P.hom
    (fun i => (1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)] v i)
  have hp : (fun i : Fin r => P.hom ((1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)] v i)) =
      (fun i => f.pullbackSectionsLE M U V h (v i)) := by
    funext i
    exact pullbackSectionsLEEquiv_one_tmul M hU f hV h (v i)
  have hw := affineExteriorSectionsIso_mk hV ((pullback f).obj M) r
    (fun i => f.pullbackSectionsLE M U V h (v i))
  calc
    _ = a • W.hom (ModuleCat.exteriorPower.mk (M := T)
        (fun i => P.hom ((1 : Γ(X, V)) ⊗ₜ[Γ(Y, U)] v i))) :=
      congrArg (fun z => a • W.hom z) hmap
    _ = a • W.hom (ModuleCat.exteriorPower.mk (M := T)
        (fun i => f.pullbackSectionsLE M U V h (v i))) :=
      congrArg (fun w : Fin r → T => a • W.hom (ModuleCat.exteriorPower.mk w)) hp
    _ = _ := congrArg (fun z => a • z) hw

/-- The actual pullback exterior map agrees with the canonical affine
base-change equivalence on the entire module of sections. -/
theorem pullbackExteriorComparison_affine :
    letI := chartAlgebra f h
    ((pullbackExteriorComparison f M r).val.app (op V)).hom ∘ₗ
        (sourceExteriorSectionsEquiv f M r hU hV h).toLinearMap =
      (targetExteriorSectionsEquiv f M r hU hV h).toLinearMap := by
  letI := chartAlgebra f h
  let A := Γ(X, V)
  let B := Γ(Y, U)
  let N := Γ((SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M), V)
  letI extB : Module B N := Module.compHom N (f.appLE U V h).hom
  letI extTower : IsScalarTower B A N :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let g : Γ((pullback f).obj
      ((SheafOfModules.exteriorPower Y.sheaf r).obj M), V) →ₗ[A] N :=
    ((pullbackExteriorComparison f M r).val.app (op V)).hom
  let lhs : A ⊗[B] (⋀[B]^r Γ(M, U)) →ₗ[A] N :=
    g ∘ₗ (sourceExteriorSectionsEquiv f M r hU hV h).toLinearMap
  let rhs : A ⊗[B] (⋀[B]^r Γ(M, U)) →ₗ[A] N :=
    (targetExteriorSectionsEquiv f M r hU hV h).toLinearMap
  change lhs = rhs
  apply TensorProduct.AlgebraTensorModule.ext
  intro a z
  have hw : lhs.restrictScalars B ∘ₗ TensorProduct.mk B A (⋀[B]^r Γ(M, U)) a =
      rhs.restrictScalars B ∘ₗ TensorProduct.mk B A (⋀[B]^r Γ(M, U)) a := by
    apply exteriorPower.linearMap_ext
    apply AlternatingMap.ext
    intro v
    change lhs (a ⊗ₜ[B] exteriorPower.ιMulti B r v) =
      rhs (a ⊗ₜ[B] exteriorPower.ιMulti B r v)
    calc
      _ = g (a • f.pullbackSectionsLE
          ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U V h
          (wedgeSection Y.sheaf M r (op U) v)) :=
        congrArg g (sourceExteriorSectionsEquiv_tmul_wedge f M r hU hV h a v)
      _ = a • g (f.pullbackSectionsLE
          ((SheafOfModules.exteriorPower Y.sheaf r).obj M) U V h
          (wedgeSection Y.sheaf M r (op U) v)) := g.map_smul a _
      _ = a • wedgeSection X.sheaf ((pullback f).obj M) r (op V)
          (fun i => f.pullbackSectionsLE M U V h (v i)) :=
        congrArg (fun z : N => a • z)
          (pullbackExteriorComparison_wedgeLE f M r U V h v)
      _ = _ := (targetExteriorSectionsEquiv_tmul_wedge f M r hU hV h a v).symm
  exact LinearMap.congr_fun hw z

include hU hV h in
/-- The canonical comparison is bijective on every such affine pair. -/
theorem pullbackExteriorComparison_affine_bijective :
    Function.Bijective ((pullbackExteriorComparison f M r).app V) := by
  letI := chartAlgebra f h
  let g : Γ((pullback f).obj
      ((SheafOfModules.exteriorPower Y.sheaf r).obj M), V) →ₗ[Γ(X, V)]
      Γ((SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M), V) :=
    ((pullbackExteriorComparison f M r).val.app (op V)).hom
  let E : Γ(X, V) ⊗[Γ(Y, U)] (⋀[Γ(Y, U)]^r Γ(M, U)) ≃ₗ[Γ(X, V)]
      Γ((pullback f).obj ((SheafOfModules.exteriorPower Y.sheaf r).obj M), V) :=
    sourceExteriorSectionsEquiv f M r hU hV h
  let T : Γ(X, V) ⊗[Γ(Y, U)] (⋀[Γ(Y, U)]^r Γ(M, U)) ≃ₗ[Γ(X, V)]
      Γ((SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M), V) :=
    targetExteriorSectionsEquiv f M r hU hV h
  have hp : g ∘ₗ E.toLinearMap = T.toLinearMap :=
    pullbackExteriorComparison_affine f M r hU hV h
  have he : g = (E.symm.trans T).toLinearMap := by
    apply LinearMap.ext
    intro z
    obtain ⟨w, rfl⟩ := E.surjective z
    have hw := LinearMap.congr_fun hp w
    change g (E w) = T w at hw
    exact hw.trans (congrArg T (E.symm_apply_apply w)).symm
  change Function.Bijective g
  rw [he]
  exact (E.symm.trans T).bijective

end AffineComparison

/-- Every scheme has a basis of affine source opens contained in inverse
images of affine target opens. -/
theorem affinePair_basis : TopologicalSpace.Opens.IsBasis
    (Set.range (fun V : {V : X.Opens // IsAffineOpen V ∧
      ∃ U : Y.Opens, IsAffineOpen U ∧ V ≤ f ⁻¹ᵁ U} => V.1)) := by
  rw [TopologicalSpace.Opens.isBasis_iff_nbhd]
  intro W x hx
  obtain ⟨U, hU, hfx, _⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    Y.isBasis_affineOpens (show f x ∈ (⊤ : Y.Opens) from trivial)
  obtain ⟨V, hV, hxV, hVW⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    X.isBasis_affineOpens (show x ∈ W ⊓ f ⁻¹ᵁ U from ⟨hx, hfx⟩)
  exact ⟨V, ⟨⟨V, hV, U, hU, hVW.trans inf_le_right⟩, rfl⟩,
    hxV, hVW.trans inf_le_left⟩

/-- The actual exterior comparison is an isomorphism for every scheme
morphism and every quasicoherent module, in all exterior degrees. -/
instance pullbackExteriorComparison_isIso (M : Y.Modules) [M.IsQuasicoherent] (r : ℕ) :
    IsIso (pullbackExteriorComparison f M r) := by
  rw [← isIso_iff_of_reflects_iso _ (SheafOfModules.toSheaf _)]
  apply TopCat.Sheaf.isIso_iff_isIso_basis (affinePair_basis f)
  intro V
  obtain ⟨U, hU, h⟩ := V.property.2
  exact (ConcreteCategory.isIso_iff_bijective _).mpr
    (pullbackExteriorComparison_affine_bijective f M r hU V.property.1 h)

/-- Canonical exterior-power base change for actual quasicoherent sheaves. -/
def pullbackExteriorIso (M : Y.Modules) [M.IsQuasicoherent] (r : ℕ) :
    (pullback f).obj ((SheafOfModules.exteriorPower Y.sheaf r).obj M) ≅
      (SheafOfModules.exteriorPower X.sheaf r).obj ((pullback f).obj M) :=
  asIso (pullbackExteriorComparison f M r)

