/-!
# The actual images of an exact resolution

This module constructs the image objects and short exact sequences needed for
dimension shifting. No independently supplied image-resolution data is used.
-/



open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject

namespace PaperVerification.Segre.ResolutionImages

universe v u

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- Replace the outer terms of a short complex by the images of its two maps. -/
def imageShortComplex (S : ShortComplex C) : ShortComplex C :=
  ShortComplex.mk (image.ι S.f) (factorThruImage S.g)
    (comp_factorThruImage_eq_zero (image_ι_comp_eq_zero S.zero))

/-- The image sequence of an exact short complex is short exact. -/
theorem imageShortComplex_shortExact (S : ShortComplex C) (hS : S.Exact) :
    (imageShortComplex S).ShortExact := by
  let M : ShortComplex C :=
    ShortComplex.mk (image.ι S.f) S.g (image_ι_comp_eq_zero S.zero)
  let α : S ⟶ M :=
    { τ₁ := factorThruImage S.f
      τ₂ := 𝟙 _
      τ₃ := 𝟙 _
      comm₁₂ := by simp [M]
      comm₂₃ := by simp [M] }
  have hM : M.Exact :=
    (ShortComplex.exact_iff_of_epi_of_isIso_of_mono α).mp hS
  let β : imageShortComplex S ⟶ M :=
    { τ₁ := 𝟙 _
      τ₂ := 𝟙 _
      τ₃ := image.ι S.g
      comm₁₂ := by simp [M, imageShortComplex]
      comm₂₃ := by simp [M, imageShortComplex] }
  have : Epi β.τ₁ := by dsimp [β, M, imageShortComplex]; infer_instance
  have : IsIso β.τ₂ := by dsimp [β, M, imageShortComplex]; infer_instance
  have : Mono β.τ₃ := by dsimp [β, M, imageShortComplex]; infer_instance
  have hB : (imageShortComplex S).Exact :=
    (ShortComplex.exact_iff_of_epi_of_isIso_of_mono β).mpr hM
  exact
    { exact := hB
      mono_f := by dsimp [imageShortComplex]; infer_instance
      epi_g := by dsimp [imageShortComplex]; infer_instance }

variable (T : ℕ → C) (d : ∀ r : ℕ, T (r + 1) ⟶ T r)

/-- The boundary in degree zero is zero; higher boundaries are categorical images. -/
def boundary : ℕ → C
  | 0 => 0
  | r + 1 => image (d r)

/-- The canonical inclusion of an actual boundary in its ambient term. -/
def inclusion (r : ℕ) : boundary T d (r + 1) ⟶ T r :=
  image.ι (d r)

/-- The canonical projection of a term onto the next actual boundary. -/
def projection : ∀ r : ℕ, T r ⟶ boundary T d r
  | 0 => 0
  | r + 1 => factorThruImage (d r)

@[reassoc (attr := simp)]
theorem projection_inclusion (r : ℕ) :
    projection T d (r + 1) ≫ inclusion T d r = d r := by
  exact image.fac (d r)

variable (w : ∀ r : ℕ, d (r + 1) ≫ d r = 0)

include w in
theorem inclusion_projection (r : ℕ) :
    inclusion T d (r + 1) ≫ projection T d (r + 1) = 0 :=
  comp_factorThruImage_eq_zero (image_ι_comp_eq_zero (w r))

/-- The canonical boundary sequence at a positive degree of the resolution. -/
def boundaryShortComplex (r : ℕ) : ShortComplex C :=
  ShortComplex.mk (inclusion T d (r + 1)) (projection T d (r + 1))
    (inclusion_projection T d w r)

/-- Exactness of the original differentials gives the actual short exact
boundary sequences used by dimension shifting. -/
theorem boundaryShortComplex_shortExact (r : ℕ)
    (h : (ShortComplex.mk (d (r + 1)) (d r) (w r)).Exact) :
    (boundaryShortComplex T d w r).ShortExact := by
  exact imageShortComplex_shortExact
    (ShortComplex.mk (d (r + 1)) (d r) (w r)) h

/-- A zero term above the top degree forces the next actual image to be zero. -/
theorem boundary_isZero (N : ℕ) (h : IsZero (T (N + 1))) :
    IsZero (boundary T d (N + 1)) := by
  change IsZero (image (d N))
  rw [IsZero.iff_id_eq_zero]
  apply (cancel_epi (factorThruImage (d N))).mp
  simpa only [Category.comp_id, comp_zero] using
    h.eq_of_src (factorThruImage (d N)) 0

