/-!
# The actual image sheaf and the actual chart coefficient ideals

A section belongs to an image subsheaf precisely when it belongs locally
on an open cover. On an affine open, quasicoherence identifies sections
of that image with the range of the original morphism on sections. Free
source frames and a line frame identify this range with the ideal
generated by the literal coefficients of the morphism. No independent
global ideal identity is assumed.
-/

set_option autoImplicit false
open scoped Classical

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open scoped BigOperators

namespace PaperVerification.Segre.ImageChartMembership

universe u
variable {X : Scheme.{u}} {M N : X.Modules}

/-- The linear map on sections, with its actual coefficient ring. -/
def sectionLinear (φ : M ⟶ N) (U : X.Opens) :
    Γ(M,U) →ₗ[Γ(X,U)] Γ(N,U) := (φ.val.app (op U)).hom

@[simp] theorem sectionLinear_apply (φ : M ⟶ N) (U : X.Opens) (s : Γ(M,U)) :
    sectionLinear φ U s = φ.app U s := rfl

theorem app_restrict (φ : M ⟶ N) {U V : X.Opens} (j : U ⟶ V) (s : Γ(M,V)) :
    φ.app U (M.presheaf.map j.op s) = N.presheaf.map j.op (φ.app V s) := by
  exact ConcreteCategory.congr_hom (φ.mapPresheaf.naturality j.op) s

/-- A monomorphism of module sheaves is injective on sections of every
open; this follows from preservation of limits by the presheaf functor. -/
theorem app_injective (φ : M ⟶ N) [Mono φ] (U : X.Opens) :
    Function.Injective (φ.app U) := by
  haveI : Mono φ.mapPresheaf := Functor.map_mono (Scheme.Modules.toPresheaf X) φ
  haveI : Mono (φ.mapPresheaf.app (op U)) := inferInstance
  simpa only [Scheme.Modules.mapPresheaf_app] using
    (AddCommGrpCat.mono_iff_injective (φ.mapPresheaf.app (op U))).mp
      (inferInstance : Mono (φ.mapPresheaf.app (op U)))

/-- Membership in an actual subobject is local on every open cover. The
local lifts glue because the subobject inclusion is a monomorphism. -/
theorem image_membership_local (φ : M ⟶ N) [Mono φ]
    {κ : Type*} (V : κ → X.Opens) (W : X.Opens)
    (hV : ∀ p, V p ≤ W) (hcover : W ≤ ⨆ p, V p) (s : Γ(N,W)) :
    (∃ z : Γ(M,W), φ.app W z = s) ↔
      ∀ p, ∃ z : Γ(M,V p),
        φ.app (V p) z = N.presheaf.map (homOfLE (hV p)).op s := by
  classical
  constructor
  · rintro ⟨z,rfl⟩ p
    exact ⟨M.presheaf.map (homOfLE (hV p)).op z,
      app_restrict φ (homOfLE (hV p)) z⟩
  · intro h
    choose z hz using h
    let F : TopCat.Sheaf AddCommGrpCat X := ⟨M.presheaf,M.isSheaf⟩
    have hc : TopCat.Presheaf.IsCompatible F.obj V z := by
      intro p q
      apply app_injective φ (V p ⊓ V q)
      rw [app_restrict,app_restrict,hz p,hz q,
        ←ConcreteCategory.comp_apply,←ConcreteCategory.comp_apply,
        ←Functor.map_comp,←Functor.map_comp]
      rfl
    obtain ⟨t,ht,-⟩ := F.existsUnique_gluing' V W
      (fun p => homOfLE (hV p)) hcover z hc
    refine ⟨t,?_⟩
    apply TopCat.Sheaf.eq_of_locally_eq'
      (⟨N.presheaf,N.isSheaf⟩ : TopCat.Sheaf AddCommGrpCat X)
      V W (fun p => homOfLE (hV p)) hcover
    intro p
    rw [←app_restrict,ht p,hz p]

/-- The categorical image of a morphism between quasicoherent modules is
quasicoherent, via its canonical identification with the kernel of the
cokernel. -/
theorem image_isQuasicoherent (φ : M ⟶ N)
    [M.IsQuasicoherent] [N.IsQuasicoherent] : (image φ).IsQuasicoherent := by
  haveI : (Abelian.image φ).IsQuasicoherent := inferInstance
  exact (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso
    (Abelian.imageIsoImage φ) inferInstance

/-- Affine exactness relates the actual image object to the original
morphism on sections; no local lifting premise is added. -/
theorem image_sections_affine_iff (φ : M ⟶ N)
    [M.IsQuasicoherent] [N.IsQuasicoherent]
    (U : X.Opens) (hU : IsAffineOpen U) (s : Γ(N,U)) :
    (∃ z : Γ(image φ,U), (image.ι φ).app U z = s) ↔
      ∃ t : Γ(M,U), φ.app U t = s := by
  letI := image_isQuasicoherent φ
  constructor
  · rintro ⟨z,hz⟩
    obtain ⟨t,ht⟩ :=
      (factorThruImage φ).app_surjective_of_epi_of_isAffineOpen U hU z
    refine ⟨t,?_⟩
    rw [←image.fac φ]
    change (image.ι φ).app U ((factorThruImage φ).app U t) = s
    rw [ht,hz]
  · rintro ⟨t,rfl⟩
    refine ⟨(factorThruImage φ).app U t,?_⟩
    change ((factorThruImage φ ≫ image.ι φ).app U) t = φ.app U t
    rw [image.fac]

section Coefficients

variable {R : Type*} [CommRing R] {α : Type*} [Fintype α] [DecidableEq α]

/-- The range of a linear functional on a finite free module is exactly
the ideal generated by all its coordinate coefficients. -/
theorem range_eq_coefficient_ideal (f : (α → R) →ₗ[R] R) :
    f.range = Ideal.span (Set.range (fun i => f (Pi.single i 1))) := by
  classical
  apply le_antisymm
  · rintro _ ⟨x,rfl⟩
    rw [pi_eq_sum_univ' x,map_sum]
    apply Ideal.sum_mem
    intro i _
    rw [map_smul]
    exact (Ideal.span (Set.range (fun i => f (Pi.single i 1)))).smul_mem (x i)
      (Ideal.subset_span ⟨i,rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨i,rfl⟩
    exact ⟨Pi.single i 1,rfl⟩

end Coefficients

def coefficient {α : Type*} [Fintype α] (φ : M ⟶ N) (U : X.Opens)
    (sourceFrame : (α → Γ(X,U)) ≃ₗ[Γ(X,U)] Γ(M,U))
    (lineFrame : Γ(N,U) ≃ₗ[Γ(X,U)] Γ(X,U)) (i : α) : Γ(X,U) := by
  classical
  exact lineFrame (sectionLinear φ U (sourceFrame (Pi.single i 1)))

/-- A line-valued map in an actual free source frame has the literal
coefficient ideal as its range. -/
theorem framed_range_iff {α : Type*} [Fintype α] (φ : M ⟶ N) (U : X.Opens)
    (sourceFrame : (α → Γ(X,U)) ≃ₗ[Γ(X,U)] Γ(M,U))
    (lineFrame : Γ(N,U) ≃ₗ[Γ(X,U)] Γ(X,U)) (s : Γ(N,U)) :
    (∃ t : Γ(M,U), φ.app U t = s) ↔
      lineFrame s ∈ Ideal.span (Set.range (coefficient φ U sourceFrame lineFrame)) := by
  classical
  let f : (α → Γ(X,U)) →ₗ[Γ(X,U)] Γ(X,U) :=
    lineFrame.toLinearMap.comp ((sectionLinear φ U).comp sourceFrame.toLinearMap)
  change (∃ t : Γ(M,U), φ.app U t = s) ↔
    lineFrame s ∈ Ideal.span (Set.range (fun i => f (Pi.single i 1)))
  rw [←range_eq_coefficient_ideal]
  constructor
  · rintro ⟨t,ht⟩
    refine ⟨sourceFrame.symm t,?_⟩
    simp only [f,LinearMap.comp_apply,LinearEquiv.coe_coe,
      LinearEquiv.apply_symm_apply,sectionLinear_apply,ht]
  · rintro ⟨x,hx⟩
    refine ⟨sourceFrame x,lineFrame.injective hx⟩

/-- The complete global-to-chart comparison. The ideals are generated by
the actual locally trivialized morphism, not arbitrary matching ideals. -/
theorem global_image_iff_chart_ideals (φ : M ⟶ N)
    [M.IsQuasicoherent] [N.IsQuasicoherent]
    {κ : Type*} (V : κ → X.Opens) (hV : ∀ p, IsAffineOpen (V p))
    (hcover : (⊤ : X.Opens) ≤ ⨆ p, V p)
    (α : κ → Type*) [∀ p, Fintype (α p)]
    (sourceFrame : ∀ p, (α p → Γ(X,V p)) ≃ₗ[Γ(X,V p)] Γ(M,V p))
    (lineFrame : ∀ p, Γ(N,V p) ≃ₗ[Γ(X,V p)] Γ(X,V p))
    (s : Γ(N,⊤)) :
    (∃ z : Γ(image φ,⊤), (image.ι φ).app ⊤ z = s) ↔
      ∀ p, lineFrame p (N.presheaf.map (V p).leTop.op s) ∈
        Ideal.span (Set.range (coefficient φ (V p) (sourceFrame p) (lineFrame p))) := by
  rw [image_membership_local (image.ι φ) V ⊤ (fun _ => le_top) hcover s]
  apply forall_congr'
  intro p
  rw [image_sections_affine_iff φ (V p) (hV p),
    framed_range_iff φ (V p) (sourceFrame p) (lineFrame p)] <;> rfl

end PaperVerification.Segre.ImageChartMembership

