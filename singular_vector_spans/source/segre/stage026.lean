/-!
# From the actual augmented resolution to the actual chart ideals

The first differential may be presented with its canonical exterior and
line factors. Its proved source and target isomorphisms identify it with
the original functional. The induced isomorphism of categorical images
then transfers the cohomological surjectivity theorem to that functional.
Combining this with the affine image calculation gives an equality about
the original global sections and the original local coefficient ideals.
-/

set_option autoImplicit false

namespace PaperVerification.Segre.ResolutionImageMembership

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open TauCeti.AlgebraicGeometry.Scheme.Modules
open ImageChartMembership

universe u
variable {X : Scheme.{u}} {M N M' N' : X.Modules}

/-- Surjectivity on sections of an image is invariant under an actual
isomorphism of arrows. Both the original map and its image factor remain
visible in the statement. -/
theorem image_sections_surjective_of_arrow_iso
    (f : M ⟶ N) (g : M' ⟶ N') (eM : M ≅ M') (eN : N ≅ N')
    (h : eM.hom ≫ g = f ≫ eN.hom)
    (hf : Function.Surjective ((factorThruImage f).app ⊤)) :
    Function.Surjective ((factorThruImage g).app ⊤) := by
  let e : Arrow.mk f ≅ Arrow.mk g := Arrow.isoMk' f g eM eN h
  let eI : image f ≅ image g := (im : Arrow X.Modules ⥤ X.Modules).mapIso e
  intro z
  obtain ⟨t,ht⟩ := hf (eI.inv.app ⊤ z)
  refine ⟨eM.hom.app ⊤ t, ?_⟩
  have hc : eI.hom.app ⊤ ((factorThruImage f).app ⊤ t) =
      (factorThruImage g).app ⊤ (eM.hom.app ⊤ t) :=
    congrArg (fun a : M ⟶ image g => a.app ⊤ t) (image.factor_map e.hom)
  rw [←hc,ht]
  exact congrArg (fun a : image g ⟶ image g => a.app ⊤ z) eI.inv_hom_id

/-- The actual cohomology gap supplies surjectivity onto sections of the
original functional's image, after the proved augmentation comparison. -/
theorem image_sections_surjective_of_resolution
    (T : ℕ → X.Modules) (d : ∀ r, T (r+1) ⟶ T r)
    (w : ∀ r, d (r+1) ≫ d r = 0)
    (hex : ∀ r, (ShortComplex.mk (d (r+1)) (d r) (w r)).Exact)
    (B : ℕ) (hB : 1 ≤ B) (hzero : IsZero (T (B+1)))
    (hgap : ∀ r, 2 ≤ r → r ≤ B → ∀ q, q < r →
      Subsingleton (Cohomology (T r) q))
    (φ : M ⟶ N) (e₁ : T 1 ≅ M) (e₀ : T 0 ≅ N)
    (haug : d 0 ≫ e₀.hom = e₁.hom ≫ φ) :
    Function.Surjective ((factorThruImage φ).app ⊤) :=
  image_sections_surjective_of_arrow_iso (d 0) φ e₁ e₀ haug.symm
    (ResolutionSections.first_image_sections_bijective T d w hex B hB hzero hgap).surjective

/-- Once the actual image factor surjects on global sections, membership
in the original global range is equivalent to literal local ideal
membership on a free affine cover. -/
theorem global_range_iff_chart_ideals (φ : M ⟶ N)
    [M.IsQuasicoherent] [N.IsQuasicoherent]
    (hsurj : Function.Surjective ((factorThruImage φ).app ⊤))
    {κ : Type*} (V : κ → X.Opens) (hV : ∀ p, IsAffineOpen (V p))
    (hcover : (⊤ : X.Opens) ≤ ⨆ p, V p)
    (α : κ → Type*) [∀ p, Fintype (α p)]
    (sourceFrame : ∀ p, (α p → Γ(X,V p)) ≃ₗ[Γ(X,V p)] Γ(M,V p))
    (lineFrame : ∀ p, Γ(N,V p) ≃ₗ[Γ(X,V p)] Γ(X,V p))
    (s : Γ(N,⊤)) :
    (∃ t : Γ(M,⊤), φ.app ⊤ t = s) ↔
      ∀ p, lineFrame p (N.presheaf.map (V p).leTop.op s) ∈
        Ideal.span (Set.range (coefficient φ (V p) (sourceFrame p) (lineFrame p))) := by
  rw [← ImageChartMembership.global_image_iff_chart_ideals
    φ V hV hcover α sourceFrame lineFrame s]
  constructor
  · rintro ⟨t,rfl⟩
    refine ⟨(factorThruImage φ).app ⊤ t, ?_⟩
    exact congrArg (fun a : M ⟶ N => a.app ⊤ t) (image.fac φ)
  · rintro ⟨z,hz⟩
    obtain ⟨t,ht⟩ := hsurj z
    refine ⟨t, ?_⟩
    have hc := congrArg (fun a : M ⟶ N => a.app ⊤ t) (image.fac φ)
    change (image.ι φ).app ⊤ ((factorThruImage φ).app ⊤ t) = φ.app ⊤ t at hc
    rw [←hc,ht,hz]

end PaperVerification.Segre.ResolutionImageMembership

