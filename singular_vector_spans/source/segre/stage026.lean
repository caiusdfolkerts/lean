/-!
# The exact cohomology gap in the finite Koszul resolution

For an actual finite resolution, vanishing of H^q(K_r) for r≥2 and q<r
implies that its first differential induces an isomorphism on full global
sections. The proof uses the actual long exact cohomology sequences and the
zero last image; it does not replace the needed scheme-theoretic exactness by
a name. The geometric application must separately construct these exact
image sequences for the regular singular-vector section.
-/

set_option autoImplicit false



namespace PaperVerification.Segre.ResolutionGap

open AlgebraicGeometry CategoryTheory Limits Opposite
open TauCeti.AlgebraicGeometry.Scheme.Modules

universe u

variable {X : Scheme.{u}}

/-- Consecutive actual image sequences of a finite resolution. The names B and
T specify its full image sheaves and full terms; no cohomology is built into
either family. -/
def imageSequence (B T : ℕ → X.Modules)
    (f : ∀ r,B (r+1) ⟶ T r) (g : ∀ r,T r ⟶ B r)
    (w : ∀ r,f r ≫ g r=0) (r : ℕ) : ShortComplex X.Modules :=
  ShortComplex.mk (f r) (g r) (w r)

/-- Descending dimension shifting proves the needed gap for every image sheaf
of an actual bounded exact resolution. -/
theorem image_cohomology_gap (B T : ℕ → X.Modules)
    (f : ∀ r,B (r+1) ⟶ T r) (g : ∀ r,T r ⟶ B r)
    (w : ∀ r,f r ≫ g r=0) (N : ℕ)
    (hS : ∀ r,2≤r → r≤N → (imageSequence B T f g w r).ShortExact)
    (hzero : IsZero (B (N+1)))
    (hgap : ∀ r,2≤r → r≤N → ∀ q,q<r → Subsingleton (Cohomology (T r) q))
    (r q : ℕ) (hr : 2≤r) (hrN : r≤N+1) (hq : q<r) :
    Subsingleton (Cohomology (B r) q) := by
  suffices h : ∀ d r : ℕ,N+1-r=d → 2≤r → r≤N+1 →
      ∀ q,q<r → Subsingleton (Cohomology (B r) q) from
    h _ r rfl hr hrN q hq
  intro d
  induction d using Nat.strong_induction_on with
  | ind d ih =>
    intro r hd hr hrN q hq
    by_cases hlast : r=N+1
    · subst r
      exact AddCommGrpCat.subsingleton_of_isZero ((cohomologyFunctor X q).map_isZero hzero)
    have hrN' : r≤N := by omega
    have hnext := ih (N+1-(r+1)) (by omega) (r+1) rfl
      (by omega) (by omega) (q+1) (by omega)
    exact subsingleton_cohomology_X₃ (hS r hr hrN') q (q+1) rfl
      (hgap r hr hrN' q hq) hnext

/-- The first map of the actual resolution is bijective on full global
sections once the cohomology gap and its exact image sequences are established. -/
theorem first_map_sections_bijective (B T : ℕ → X.Modules)
    (f : ∀ r,B (r+1) ⟶ T r) (g : ∀ r,T r ⟶ B r)
    (w : ∀ r,f r ≫ g r=0) (N : ℕ) (hN : 1≤N)
    (hS : ∀ r,1≤r → r≤N → (imageSequence B T f g w r).ShortExact)
    (hzero : IsZero (B (N+1)))
    (hgap : ∀ r,2≤r → r≤N → ∀ q,q<r → Subsingleton (Cohomology (T r) q)) :
    Function.Bijective ((g 1).app ⊤) := by
  have hB (q : ℕ) (hq : q<2) : Subsingleton (Cohomology (B 2) q) :=
    image_cohomology_gap B T f g w N (fun r hr hrN => hS r (by omega) hrN)
      hzero hgap 2 q (by omega) (by omega) hq
  have hBzero (s : Γ(B 2,⊤)) : s=0 := by
    apply (cohomologyZeroEquiv (B 2)).symm.injective
    exact (hB 0 (by omega)).elim _ _
  refine ⟨?_,sections_surjective (hS 1 le_rfl hN) (hB 1 (by omega))⟩
  intro s t hst
  have hz : (g 1).app ⊤ (s - t) = 0 := by
    rw [map_sub, hst, sub_self]
  obtain ⟨z, hz'⟩ := ((exact_sections (hS 1 le_rfl hN)) (s - t)).mp hz
  change (f 1).app ⊤ z = s - t at hz'
  apply sub_eq_zero.mp
  rw [← hz', hBzero z, map_zero]

/-- The resulting equivalence is induced by the actual first differential,
linear over the actual global function ring of X. -/
def firstMapGlobalSectionsEquiv (B T : ℕ → X.Modules)
    (f : ∀ r,B (r+1) ⟶ T r) (g : ∀ r,T r ⟶ B r)
    (w : ∀ r,f r ≫ g r=0) (N : ℕ) (hN : 1≤N)
    (hS : ∀ r,1≤r → r≤N → (imageSequence B T f g w r).ShortExact)
    (hzero : IsZero (B (N+1)))
    (hgap : ∀ r,2≤r → r≤N → ∀ q,q<r → Subsingleton (Cohomology (T r) q)) :
    Γ(T 1,⊤) ≃ₗ[Γ(X,⊤)] Γ(B 1,⊤) :=
  LinearEquiv.ofBijective ((g 1).val.app (op ⊤)).hom
    (first_map_sections_bijective B T f g w N hN hS hzero hgap)

end PaperVerification.Segre.ResolutionGap

