/-!
# Global sections of the actual first image of a finite resolution

The boundary objects are the categorical images of the given
differentials. Their short exact sequences are proved from exactness of
the original complex. Thus the cohomological gap gives the desired
bijection to the actual image sheaf, without independently postulating
image objects or exact image sequences.

-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open TauCeti.AlgebraicGeometry.Scheme.Modules

namespace PaperVerification.Segre.ResolutionSections

universe u
variable {X : Scheme.{u}}
  (T : ℕ → X.Modules) (d : ∀ r : ℕ, T (r + 1) ⟶ T r)
  (w : ∀ r : ℕ, d (r + 1) ≫ d r = 0)

include w in
/-- The zero-composite identity for the actual image factorization in
every degree, including the artificial zeroth boundary. -/
theorem boundary_zero (r : ℕ) :
    ResolutionImages.inclusion T d r ≫ ResolutionImages.projection T d r = 0 := by
  cases r with
  | zero => simp [ResolutionImages.projection]
  | succ r => exact ResolutionImages.inclusion_projection T d w r

/-- The full image short exact sequence is constructed from the actual
differentials at every positive degree. -/
theorem boundary_shortExact
    (hex : ∀ r, (ShortComplex.mk (d (r + 1)) (d r) (w r)).Exact)
    (r : ℕ) (hr : 1 ≤ r) :
    (ResolutionGap.imageSequence (ResolutionImages.boundary T d) T
      (ResolutionImages.inclusion T d) (ResolutionImages.projection T d)
      (boundary_zero T d w) r).ShortExact := by
  cases r with
  | zero => omega
  | succ r =>
    exact ResolutionImages.boundaryShortComplex_shortExact T d w r (hex r)

/-- The first differential surjects onto all global sections of its
actual image sheaf, and does so injectively when the full cohomology
gap holds. -/
theorem first_image_sections_bijective
    (hex : ∀ r, (ShortComplex.mk (d (r + 1)) (d r) (w r)).Exact)
    (N : ℕ) (hN : 1 ≤ N) (hzero : IsZero (T (N + 1)))
    (hgap : ∀ r, 2 ≤ r → r ≤ N → ∀ q, q < r →
      Subsingleton (Cohomology (T r) q)) :
    Function.Bijective ((factorThruImage (d 0)).app ⊤) :=
  ResolutionGap.first_map_sections_bijective
    (ResolutionImages.boundary T d) T
    (ResolutionImages.inclusion T d) (ResolutionImages.projection T d)
    (boundary_zero T d w) N hN
    (fun r hr _ ↦ boundary_shortExact T d w hex r hr)
    (ResolutionImages.boundary_isZero T d N hzero) hgap

/-- The induced linear equivalence is the literal image factor of the
actual first differential, over the actual global function ring. -/
def firstImageSectionsEquiv
    (hex : ∀ r, (ShortComplex.mk (d (r + 1)) (d r) (w r)).Exact)
    (N : ℕ) (hN : 1 ≤ N) (hzero : IsZero (T (N + 1)))
    (hgap : ∀ r, 2 ≤ r → r ≤ N → ∀ q, q < r →
      Subsingleton (Cohomology (T r) q)) :
    Γ(T 1, ⊤) ≃ₗ[Γ(X, ⊤)] Γ(image (d 0), ⊤) :=
  LinearEquiv.ofBijective ((factorThruImage (d 0)).val.app (op ⊤)).hom
    (first_image_sections_bijective T d w hex N hN hzero hgap)

/-- Membership in the range on global sections is exactly membership
through a global section of the actual image subsheaf. This is the
section-level conclusion needed for the singular ideal, once the
actual singular Koszul terms and vanishing are supplied. -/
theorem mem_range_first_differential_iff
    (hex : ∀ r, (ShortComplex.mk (d (r + 1)) (d r) (w r)).Exact)
    (N : ℕ) (hN : 1 ≤ N) (hzero : IsZero (T (N + 1)))
    (hgap : ∀ r, 2 ≤ r → r ≤ N → ∀ q, q < r →
      Subsingleton (Cohomology (T r) q))
    (s : Γ(T 0, ⊤)) :
    s ∈ LinearMap.range ((d 0).val.app (op ⊤)).hom ↔
      ∃ z : Γ(image (d 0), ⊤), (image.ι (d 0)).app ⊤ z = s := by
  constructor
  · rintro ⟨t, rfl⟩
    refine ⟨(factorThruImage (d 0)).app ⊤ t, ?_⟩
    change ((factorThruImage (d 0) ≫ image.ι (d 0)).app ⊤) t =
      ((d 0).app ⊤) t
    rw [image.fac]
  · rintro ⟨z, hz⟩
    obtain ⟨t, ht⟩ :=
      (first_image_sections_bijective T d w hex N hN hzero hgap).surjective z
    refine ⟨t, ?_⟩
    rw [← image.fac (d 0)]
    change (image.ι (d 0)).app ⊤ ((factorThruImage (d 0)).app ⊤ t) = s
    rw [ht, hz]

end PaperVerification.Segre.ResolutionSections

