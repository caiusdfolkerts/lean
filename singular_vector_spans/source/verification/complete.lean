    `PaperVerification.Segre.ActualTensorSpan.singularSpan_eq_top_of_isEmpty,
    `PaperVerification.Segre.PrincipalTensor.theorem_1_3_all_arities]
  let semanticDefinitions : Array Name := #[
    `PaperVerification.Segre.SymmetricRealization.FactorSymmetric,
    `PaperVerification.Segre.SymmetricRealization.SymmetricTensor,
    `PaperVerification.Segre.SymmetricRealization.SymmetricSegre,
    `PaperVerification.Segre.SymmetricRealization.symmetricParameterIdeal,
    `PaperVerification.Segre.SymmetricRealization.SymmetricReduction,
    `PaperVerification.Segre.SymmetricRealization.symmetricActualPiece,
    `PaperVerification.Segre.SymmetricRealization.symmetricFirstLefschetz,
    `PaperVerification.Segre.SymmetricPrincipal.GenericSymmetricForms,
    `PaperVerification.Segre.Principal.kernelDefect,
    `PaperVerification.Segre.TwoFactorGeneric.kernelDefect,
    `PaperVerification.Segre.ThreeFactorLefschetz.kernelDefect,
    `PaperVerification.Segre.OriginalProjectivePrincipal.GenericProjectiveDefect,
    `PaperVerification.Segre.OriginalProjectivePrincipal.GenericProjectiveFullSpan,
    `PaperVerification.Segre.GenericRigidity.GenericallyRigid,
    `PaperVerification.Segre.StressFree.GenericallyStressFree,
    `PaperVerification.Segre.ActualTensorSpan.Tensor,
    `PaperVerification.Segre.ActualTensorSpan.tensorContraction,
    `PaperVerification.Segre.ActualTensorSpan.IsSingularTuple,
    `PaperVerification.Segre.ActualTensorSpan.singularRankOneSet,
    `PaperVerification.Segre.ActualTensorSpan.singularSpan,
    `PaperVerification.Segre.ActualTensorCriticalSpace.criticalOperator,
    `PaperVerification.Segre.ActualTensorCriticalSpace.criticalSpace,
    `PaperVerification.Segre.ProjectiveSpan.singularPoints,
    `PaperVerification.Segre.AmbientCriticalScheme.ambientCriticalIdeal,
    `PaperVerification.Segre.EmbeddedSingularScheme.ideal,
    `PaperVerification.Segre.AsymptoticGrowth.threeFactorThreshold,
    `PaperVerification.Segre.AsymptoticGrowth.manyFactorThreshold,
    `PaperVerification.Segre.AsymptoticGrowth.rootExponent]
  for name in targets do
    let some info := env.checked.get.find? name
      | throwError "Required principal theorem is missing: {name}"
    match info with
    | .thmInfo _ => pure ()
    | _ => throwError "Required principal declaration is not a theorem: {name}"
  for name in semanticDefinitions do
    let some info := env.checked.get.find? name
      | throwError "Required semantic definition is missing: {name}"
    unless (info.value? (allowOpaque := true)).isSome do
      throwError "Required semantic definition has no checked value: {name}"
  -- Select by the exact imported stage inventory and actual defining module,
  -- including private helpers, generated lemmas, vendored proofs and new declarations.
  let stageModules : Array Name := #[
    `SegreVerified.Stage001,
    `SegreVerified.Stage002,
    `SegreVerified.Stage003,
    `SegreVerified.Stage004,
    `SegreVerified.Stage005,
    `SegreVerified.Stage006,
    `SegreVerified.Stage007,
    `SegreVerified.Stage008,
    `SegreVerified.Stage009,
    `SegreVerified.Stage010,
    `SegreVerified.Stage011,
    `SegreVerified.Stage012,
    `SegreVerified.Stage013,
    `SegreVerified.Stage014,
    `SegreVerified.Stage015.ExtAdjunction,
    `SegreVerified.Stage015.CohomologyInfrastructure,
    `SegreVerified.Stage015.LerayComparison,
    `SegreVerified.Stage015.CohomologyApplications,
    `SegreVerified.Stage015,
    `SegreVerified.Stage016,
    `SegreVerified.Stage017,
    `SegreVerified.Stage018,
    `SegreVerified.Stage019,
    `SegreVerified.Stage020,
    `SegreVerified.Stage021,
    `SegreVerified.Stage022,
    `SegreVerified.Stage023,
    `SegreVerified.Stage024,
    `SegreVerified.Stage025.ProjectiveCech,
    `SegreVerified.Stage025.ProjectiveSections,
    `SegreVerified.Stage025.ProjectiveSpace,
    `SegreVerified.Stage025.Euler,
    `SegreVerified.Stage025.ExteriorKernelCore,
    `SegreVerified.Stage025.ExteriorKernel,
    `SegreVerified.Stage025.ExteriorTwist,
    `SegreVerified.Stage025.ExteriorVanishing,
    `SegreVerified.Stage025.AffineChartAlgebra,
    `SegreVerified.Stage025.ChartCoordinates,
    `SegreVerified.Stage025.EulerCoordinates,
    `SegreVerified.Stage025,
    `SegreVerified.Stage026,
    `SegreVerified.Stage027.ExteriorCoordinates,
    `SegreVerified.Stage027.CriticalCharts,
    `SegreVerified.Stage027.CriticalEuler,
    `SegreVerified.Stage027.ExteriorComparison,
    `SegreVerified.Stage027.TensorSections,
    `SegreVerified.Stage027.KoszulTerms,
    `SegreVerified.Stage027.ProductTerms,
    `SegreVerified.Stage027.GraphCriticalMap,
    `SegreVerified.Stage027.ProductFrames,
    `SegreVerified.Stage027.WeightedComplex,
    `SegreVerified.Stage027.CriticalCoordinates,
    `SegreVerified.Stage027.Resolution,
    `SegreVerified.Stage027,
    `SegreVerified.Stage028.GraphElimination,
    `SegreVerified.Stage028.CriticalPolynomials,
    `SegreVerified.Stage028.GraphGenericity,
    `SegreVerified.Stage028.CriticalExactness,
    `SegreVerified.Stage028.ExternalSections,
    `SegreVerified.Stage028.HomogeneousSections,
    `SegreVerified.Stage028.PullbackSections,
    `SegreVerified.Stage028.LineSections,
    `SegreVerified.Stage028.GlobalWedges,
    `SegreVerified.Stage028.GlobalImage,
    `SegreVerified.Stage028,
    `SegreVerified.Stage029,
    `SegreVerified.Stage030.TensorCoordinates,
    `SegreVerified.Stage030.ActualTensor,
    `SegreVerified.Stage030.FormatReduction,
    `SegreVerified.Stage030.RankAndOpen,
    `SegreVerified.Stage030.TensorSpan,
    `SegreVerified.Stage030.QuantitativeBounds,
    `SegreVerified.Stage030,
    `SegreVerified.Stage031.SectionZeroScheme,
    `SegreVerified.Stage031.CriticalFactorReindex,
    `SegreVerified.Stage031.ProjectiveReduction,
    `SegreVerified.Stage031.ActualCriticalSpace,
    `SegreVerified.Stage031.IntrinsicScheme,
    `SegreVerified.Stage031.PrincipalScheme,
    `SegreVerified.Stage031.SegreCharts,
    `SegreVerified.Stage031.SegreEmbedding,
    `SegreVerified.Stage031.ClosedEmbedding,
    `SegreVerified.Stage031.EmbeddedScheme,
    `SegreVerified.Stage031.ProjectiveSpan,
    `SegreVerified.Stage031.ProjectiveConclusions,
    `SegreVerified.Stage031,
    `SegreVerified.Stage032.Rigidity,
    `SegreVerified.Stage032.AsymptoticGrowth,
    `SegreVerified.Stage032]
  let privateEnv := env.setExporting false
  let stageIndices ← stageModules.mapM fun stage => do
    let some idx := privateEnv.getModuleIdx? stage
      | throwError "Required stage is not imported: {stage}"
    let some entry := privateEnv.header.modules[idx]?
      | throwError "Invalid stage module index: {stage}"
    unless entry.importAll do
      throwError "Required stage was not imported with full private bodies: {stage}"
    return idx.toNat
  let names := (privateEnv.checked.get.constants.fold
    (fun (names : Array Name) name _ =>
      let owned := match privateEnv.getModuleIdxFor? name with
        | none => true
        | some idx => stageIndices.contains idx.toNat
      if owned then names.push name else names) #[]).qsort Name.quickLt
  unless names.size > 0 do throwError "The flattened mathematical module is empty"
  let importedAxioms := exportedAxiomsExt.getState (asyncMode := .mainOnly) env
  -- Match Lean's ordinary export audit, sharing its traversal cache across names.
  let axiomRows := CollectAxioms.runM privateEnv do
    names.mapM fun name =>
      return (name, ← CollectAxioms.collectAndGet importedAxioms.find? name)
  let mut reported : Nat := 0
  let mut outputLines : Array String := #[]
  for (name, axioms) in axiomRows do
    let some info := env.checked.get.find? name
      | throwError "Authored declaration is not kernel checked: {name}"
    if let .axiomInfo _ := info then throwError "Authored axiom: {name}"
    if info.type.hasSorry || ((info.value? (allowOpaque := true)).any (·.hasSorry)) then
      throwError "Authored declaration contains a sorry expression: {name}"
    for ax in axioms do
      unless ax == ``propext || ax == ``Classical.choice || ax == ``Quot.sound do
        throwError "Unapproved transitive axiom in {name}: {ax}"
    if targets.contains name || semanticDefinitions.contains name then
      let deps := info.type.getUsedConstants ++
        ((info.value? (allowOpaque := true)).map Expr.getUsedConstants).getD #[]
      let typeText ← liftTermElabM <| return (← Meta.ppExpr info.type).pretty
      if typeText.contains '⋯' then throwError "Type contains omitted terms: {name}"
      -- Keep a conventional mathematical view alongside the complete explicit
      -- expression. The latter remains the source of the no-omission audit.
      let readableType ← liftTermElabM <| withOptions (fun options =>
          options.setBool `pp.explicit false |>.setBool `pp.proofs false
            |>.setBool `pp.universes false |>.setBool `pp.fullNames false) do
        return (← Meta.ppExpr info.type).pretty
      let mut fields := [
        ("name", toJson name.toString),
        ("universe_parameters", toJson (info.levelParams.map Name.toString)),
        ("transitive_axioms", toJson (axioms.map Name.toString)),
        ("direct_dependencies", toJson (deps.map Name.toString)),
        ("type", toJson typeText),
        ("readable_type", toJson readableType)]
      if semanticDefinitions.contains name then
        let some value := info.value? (allowOpaque := true)
          | throwError "Semantic definition value is missing: {name}"
        let valueText ← liftTermElabM <| return (← Meta.ppExpr value).pretty
        if valueText.contains '⋯' then throwError "Definition contains omitted terms: {name}"
        let readableValue ← liftTermElabM <| withOptions (fun options =>
            options.setBool `pp.explicit false |>.setBool `pp.proofs false
              |>.setBool `pp.universes false |>.setBool `pp.fullNames false) do
          return (← Meta.ppExpr value).pretty
        fields := fields ++ [("definition_value", toJson valueText),
          ("readable_definition_value", toJson readableValue)]
      outputLines := outputLines.push
        ("SEGRE_PRINCIPAL_AUDIT_ROW " ++ (Json.mkObj fields).compress)
      reported := reported + 1
  let report := Json.mkObj [
    ("main_module", toJson env.mainModule.toString),
    ("trust_level", toJson env.header.trustLevel.toNat),
    ("declaration_count", toJson names.size),
    ("required_principal_theorems", toJson (targets.map Name.toString)),
    ("required_semantic_definitions", toJson (semanticDefinitions.map Name.toString)),
    ("allowed_axioms", toJson #["propext", "Classical.choice", "Quot.sound"]),
    ("reported_principal_and_semantic_rows", toJson reported)]
  unless reported == targets.size + semanticDefinitions.size do
    throwError "A required principal or semantic audit row was not produced"
  outputLines := outputLines.push ("SEGRE_FULL_KERNEL_AUDIT_PASS " ++ report.compress)
  let auditPath := (System.FilePath.mk (← getFileName)).withExtension "audit.jsonl"
  IO.FS.writeFile auditPath (String.intercalate "\n" outputLines.toList ++ "\n")
  logInfo m!"SEGRE_FULL_KERNEL_AUDIT_PASS {report.compress}"


/-! A compact, complete dependency graph for the newly checked declarations.

This diagnostic command follows the complete theorem audit.
Every declaration defined by the exact imported 32-stage inventory, or newly
in this compilation unit, is an authored graph vertex. Edges include constants
in both its type and its value. Constants from other imported modules are
identified boundary vertices. Module origins, not namespace prefixes, determine
ownership; effective importAll is required for every authored stage.

The full records are written beside this source as `SegreVerified.audit.jsonl`.
Only short completion summaries are emitted as editor diagnostics. Numeric
vertex identifiers keep the complete dependency record compact.
-/

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  unless env.header.trustLevel == 0 do
    throwError "The modular dependency graph requires kernel trust level zero"
  let stageModules : Array Name := #[
    `SegreVerified.Stage001,
    `SegreVerified.Stage002,
    `SegreVerified.Stage003,
    `SegreVerified.Stage004,
    `SegreVerified.Stage005,
    `SegreVerified.Stage006,
    `SegreVerified.Stage007,
