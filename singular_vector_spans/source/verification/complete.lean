    `PaperVerification.Segre.OriginalProjectivePrincipal.theorem_6_1_second,
    `PaperVerification.Segre.OriginalProjectivePrincipal.theorem_6_1_logarithmic,
    `PaperVerification.Segre.OriginalProjectivePrincipal.theorem_6_3,
    `PaperVerification.Segre.OriginalProjectivePrincipal.uniform_large_factors,
    `PaperVerification.Segre.OriginalProjectivePrincipal.excess_two_six,
    `PaperVerification.Segre.OriginalProjectivePrincipal.three_factor_sqrt_bound,
    `PaperVerification.Segre.OriginalProjectivePrincipal.many_factor_root_bound,
    `PaperVerification.Segre.AsymptoticGrowth.three_factor_threshold_cast,
    `PaperVerification.Segre.AsymptoticGrowth.many_factor_threshold_cast,
    `PaperVerification.Segre.AsymptoticGrowth.three_factor_growth,
    `PaperVerification.Segre.AsymptoticGrowth.many_factor_growth,
    `PaperVerification.Segre.ActualTensorSpan.mem_singularSpan_iff_finite_linear_combination,
