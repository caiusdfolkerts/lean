    `PaperVerification.Segre.GeometricPrincipal.theorem_6_1_logarithmic,
    `PaperVerification.Segre.GeometricPrincipal.theorem_6_3,
    `PaperVerification.Segre.GeometricPrincipal.uniform_large_factors,
