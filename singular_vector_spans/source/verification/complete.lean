  let privateEnv := env.setExporting false
  let stageIndices ← stageModules.mapM fun stage => do
    let some idx := privateEnv.getModuleIdx? stage
      | throwError "Required stage is not imported: {stage}"
    let some entry := privateEnv.header.modules[idx]?
      | throwError "Invalid stage module index: {stage}"
    unless entry.importAll do
      throwError "Required stage was not imported with full private bodies: {stage}"
    return idx.toNat
  let authored := (privateEnv.checked.get.constants.fold
    (fun (names : Array Name) name _ =>
      let owned := match privateEnv.getModuleIdxFor? name with
        | none => true
        | some idx => stageIndices.contains idx.toNat
      if owned then names.push name else names) #[]).qsort Name.quickLt
  let mut names := authored
  let mut identifiers : NameMap Nat := {}
  for index in [:names.size] do
    identifiers := identifiers.insert names[index]! index
  let mut edges : Array (Array Nat) := #[]
  for name in authored do
    let some info := env.checked.get.find? name
      | throwError "Dependency graph encountered an unchecked declaration: {name}"
    let dependencies := info.type.getUsedConstants ++
      ((info.value? (allowOpaque := true)).map Expr.getUsedConstants).getD #[]
    let mut adjacent : Array Nat := #[]
    for dependency in dependencies do
      unless (env.checked.get.find? dependency).isSome do
        throwError "Dependency graph encountered an unchecked dependency: {dependency}"
      let index := (identifiers.find? dependency).getD names.size
      unless identifiers.contains dependency do
        names := names.push dependency
        identifiers := identifiers.insert dependency index
      adjacent := adjacent.push index
    edges := edges.push adjacent
  let nameChunkSize := 256
  let mut outputLines : Array String := #[]
  for first in [:names.size:nameChunkSize] do
    let row := Json.mkObj [
      ("first", toJson first),
      ("names", toJson ((names.extract first (first + nameChunkSize)).map Name.toString))]
    outputLines := outputLines.push ("SEGRE_DEPENDENCY_NAMES " ++ row.compress)
  let edgeChunkSize := 128
  for first in [:edges.size:edgeChunkSize] do
    let row := Json.mkObj [
      ("first", toJson first),
      ("edges", toJson (edges.extract first (first + edgeChunkSize)))]
    outputLines := outputLines.push ("SEGRE_DEPENDENCY_EDGES " ++ row.compress)
  let summary := Json.mkObj [
    ("authored_vertices", toJson authored.size),
    ("all_vertices", toJson names.size),
    ("edge_lists", toJson edges.size),
    ("boundary", toJson "Pinned, kernel-checked imported library declarations")]
  outputLines := outputLines.push ("SEGRE_DEPENDENCY_GRAPH_PASS " ++ summary.compress)
  let auditPath := (System.FilePath.mk (← getFileName)).withExtension "audit.jsonl"
  let principalRecords ← IO.FS.readFile auditPath
  IO.FS.writeFile auditPath
    (principalRecords ++ String.intercalate "\n" outputLines.toList ++ "\n")
  let auditBytes ← IO.FS.readBinFile auditPath
  let descriptor := Json.mkObj [
    ("module", toJson env.mainModule.toString),
    ("path", toJson auditPath.toString),
    ("bytes", toJson auditBytes.size),
    ("hash64", toJson (toString (hash auditBytes).toNat)),
    ("hash_algorithm", toJson "Lean.ByteArray.hash (64-bit; not SHA256)"),
    ("encoding", toJson "UTF-8 JSON records with marker prefixes")]
  logInfo m!"SEGRE_DEPENDENCY_GRAPH_PASS {summary.compress}"
  logInfo m!"SEGRE_AUDIT_FILE {descriptor.compress}"
