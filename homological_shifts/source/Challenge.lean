/-!
# Homological shifts of polymatroidal ideals

The shift is defined by nonzero homology of the actual augmented multigraded
Koszul chains. Its differential is exterior contraction by the sum of coordinate
functionals. The Solution proves equality with the source development's genuine
Mathlib derived-Tor shift, using its proved homogeneous-Koszul/derived-Tor
comparison. No expected rank or support inequality occurs in this definition.
This draft records stabilization, the exact active-ground-set rank formula and
canonicality, and the projective-dimension corollary. Remaining module-generation,
threshold, total-support and integral-closure clauses still require extraction.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
open scoped BigOperators Classical

namespace CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Polynomial exponent vectors. -/
abbrev Exponent (V : Type*) := V →₀ ℕ
/-- A finite family of monomial generators. -/
abbrev Family (V : Type*) := Finset (Exponent V)
/-- Every generator has the same total degree. -/
def Equigenerated (B : Family V) (d : ℕ) : Prop := ∀ a ∈ B, a.degree = d
/-- Membership in the upward closure of the generator exponents. -/
def Contains (B : Family V) (a : Exponent V) : Prop := ∃ b ∈ B, b ≤ a
/-- The discrete one-coordinate exchange operation. -/
def exchange (a : Exponent V) (i j : V) : Exponent V :=
  a - Finsupp.single i 1 + Finsupp.single j 1
/-- The standard discrete polymatroid exchange axiom. -/
def ExchangeAxiom (B : Family V) : Prop :=
  ∀ a ∈ B, ∀ b ∈ B, ∀ i, b i < a i → ∃ j, a j < b j ∧ exchange a i j ∈ B
/-- An equigenerated finite family satisfying the exchange axiom. -/
def IsPolymatroidal (B : Family V) : Prop := (∃ d, Equigenerated B d) ∧ ExchangeAxiom B
/-- The actual polynomial ideal generated by the exponent family. -/
def monomialIdeal (k : Type*) [CommSemiring k] (B : Family V) : Ideal (MvPolynomial V k) :=
  Ideal.span ((fun a : Exponent V => MvPolynomial.monomial a (1 : k)) '' (B : Set (Exponent V)))
/-- Sum of exponents on a coordinate subset. -/
def subsetSum (a : Exponent V) (U : Finset V) : ℕ := ∑ i ∈ U, a i
/-- Maximum exponent sum among actual generators, with zero for the empty family. -/
def upperRank (B : Family V) (U : Finset V) : ℕ := B.sup (fun a => subsetSum a U)
/-- A normalized monotone integral submodular rank function. -/
structure RankFunction (V : Type*) [DecidableEq V] where
  toFun : Finset V → ℕ
  empty : toFun ∅ = 0
  monotone : Monotone toFun
  submodular : ∀ A B, toFun (A ∪ B) + toFun (A ∩ B) ≤ toFun A + toFun B
instance : CoeFun (RankFunction V) (fun _ => Finset V → ℕ) := ⟨RankFunction.toFun⟩
/-- Every nonempty coordinate subset has positive rank. -/
def RankFunction.Active (g : RankFunction V) : Prop := ∀ A, A.Nonempty → 1 ≤ g A
/-- The sum of g(B)-1 over all nonempty blocks of a partition. -/
def partitionCost (g : Finset V → ℕ) {A : Finset V} (P : Finpartition A) : ℕ :=
  ∑ B ∈ P.parts, (g B - 1)
/-- Minimum over every set partition into nonempty blocks, including the empty case. -/
def partitionRank (g : Finset V → ℕ) (A : Finset V) : ℕ :=
  Finset.univ.inf' Finset.univ_nonempty (fun P : Finpartition A => partitionCost g P)
/-- Literal original definition; its data and proof-bearing value are preserved. -/
def RankFunction.Dominates (u g : RankFunction V) : Prop :=
  ∀ A B, A ⊆ B → g B + u A ≤ u B + g A

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
@[simp] theorem RankFunction.map_empty (g : RankFunction V) : g ∅ = 0 := by sorry

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
theorem RankFunction.mixed_submodular {u g : RankFunction V}
    (h : u.Dominates g) (A B : Finset V) :
    g (A ∪ B) + u (A ∩ B) ≤ g A + u B := by sorry

/-- Literal original definition; its data and proof-bearing value are preserved. -/
def augmentedPartitionRank (g : Finset V → ℕ) (A : Finset V) : ℕ :=
  A.card + partitionRank g A

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
@[simp] theorem augmentedPartitionRank_empty (g : Finset V → ℕ) :
    augmentedPartitionRank g ∅ = 0 := by sorry

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
theorem augmentedPartitionRank_mono (g : RankFunction V) :
    Monotone (augmentedPartitionRank g) := by sorry

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
theorem partitionRank_submodular (g : RankFunction V) (hg : g.Active) (A B : Finset V) :
    partitionRank g (A ∪ B) + partitionRank g (A ∩ B) ≤
      partitionRank g A + partitionRank g B := by sorry

/-- Literal original definition; its data and proof-bearing value are preserved. -/
def shiftRankValue (g u : RankFunction V) (i : ℕ) (A : Finset V) : ℕ :=
  if A = ∅ then 0 else min (g A + i) (u A)

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
@[simp] theorem shiftRankValue_empty (g u : RankFunction V) (i : ℕ) :
    shiftRankValue g u i ∅ = 0 := by sorry

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
theorem shiftRankValue_le_u (g u : RankFunction V) (i : ℕ) (A : Finset V) :
    shiftRankValue g u i A ≤ u A := by sorry

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
theorem shiftRankValue_le_add (g u : RankFunction V) (i : ℕ) (A : Finset V) :
    shiftRankValue g u i A ≤ g A + i := by sorry

/-- Literal original definition; its data and proof-bearing value are preserved. -/
def RankFunction.interpolate (g u : RankFunction V) (h : u.Dominates g)
    (i : ℕ) : RankFunction V where
  toFun := shiftRankValue g u i
  empty := shiftRankValue_empty g u i
  monotone := by
    intro A B hAB
    by_cases hA : A = ∅
    · simp [hA]
    have hB : B ≠ ∅ := by
      intro heq
      apply hA
      simpa [heq] using hAB
    simp only [shiftRankValue, if_neg hA, if_neg hB]
    exact min_le_min (Nat.add_le_add_right (g.monotone hAB) i) (u.monotone hAB)
  submodular := by
    intro A B
    by_cases hA : A = ∅
    · simp [hA]
    by_cases hB : B = ∅
    · simp [hB]
    have hUg := shiftRankValue_le_add g u i (A ∪ B)
    have hIg := shiftRankValue_le_add g u i (A ∩ B)
    have hUu := shiftRankValue_le_u g u i (A ∪ B)
    have hIu := shiftRankValue_le_u g u i (A ∩ B)
    have hg := g.submodular A B
    have hu := u.submodular A B
    have hm := RankFunction.mixed_submodular h A B
    have hm' := RankFunction.mixed_submodular h B A
    rw [Finset.union_comm B A, Finset.inter_comm B A] at hm'
    rcases le_total (g A + i) (u A) with ha | ha <;>
      rcases le_total (g B + i) (u B) with hb | hb
    · have hAv : shiftRankValue g u i A = g A + i := by
        simp [shiftRankValue, hA, min_eq_left ha]
      have hBv : shiftRankValue g u i B = g B + i := by
        simp [shiftRankValue, hB, min_eq_left hb]
      rw [hAv, hBv]
      omega
    · have hAv : shiftRankValue g u i A = g A + i := by
        simp [shiftRankValue, hA, min_eq_left ha]
      have hBv : shiftRankValue g u i B = u B := by
        simp [shiftRankValue, hB, min_eq_right hb]
      rw [hAv, hBv]
      omega
    · have hAv : shiftRankValue g u i A = u A := by
        simp [shiftRankValue, hA, min_eq_right ha]
      have hBv : shiftRankValue g u i B = g B + i := by
        simp [shiftRankValue, hB, min_eq_left hb]
      rw [hAv, hBv]
      omega
    · have hAv : shiftRankValue g u i A = u A := by
        simp [shiftRankValue, hA, min_eq_right ha]
      have hBv : shiftRankValue g u i B = u B := by
        simp [shiftRankValue, hB, min_eq_right hb]
      rw [hAv, hBv]
      omega

/-- Literal original definition; its data and proof-bearing value are preserved. -/
def augmentedRank (g : RankFunction V) (hg : g.Active) : RankFunction V where
  toFun := augmentedPartitionRank g
  empty := augmentedPartitionRank_empty g
  monotone := augmentedPartitionRank_mono g
  submodular A B := by
    have h := partitionRank_submodular g hg A B
    have hc := Finset.card_union_add_card_inter A B
    unfold augmentedPartitionRank
    omega

/-- Original proved rank-theoretic typing fact for the literal rank definition. -/
theorem augmentedRank_dominates (g : RankFunction V) (hg : g.Active) :
    (augmentedRank g hg).Dominates g := by sorry

/-- Literal original definition; its data and proof-bearing value are preserved. -/
def homologicalRank (g : RankFunction V) (hg : g.Active) (i : ℕ) : RankFunction V :=
  g.interpolate (augmentedRank g hg) (augmentedRank_dominates g hg) i

/-- All upper-rank inequalities on a monomial exponent. -/
def UpperFeasible (g : RankFunction V) (a : Exponent V) : Prop := ∀ U, subsetSum a U ≤ g U
/-- An integer base: feasible exponent vector of total degree g(E). -/
def IsRankBase (g : RankFunction V) (a : Exponent V) : Prop :=
  a.degree = g Finset.univ ∧ UpperFeasible g a
/-- The constant exponent vector giving a finite search box. -/
def constExponent (n : ℕ) : Exponent V := Finsupp.equivFunOnFinite.symm (fun _ => n)
/-- All integer bases, filtered from the full finite bounding box. -/
def rankBases (g : RankFunction V) : Family V :=
  (Finset.Iic (constExponent (g Finset.univ))).filter (IsRankBase g)
/-- The actual monomial ideal of all integer rank bases. -/
def rankIdeal (k : Type*) [CommSemiring k] (g : RankFunction V) : Ideal (MvPolynomial V k) :=
  monomialIdeal k (rankBases g)
/-- The partition excess over the rank of its union. -/
def partitionDefect (g : RankFunction V) {A : Finset V} (P : Finpartition A) : ℕ :=
  (∑ C ∈ P.parts, g C) - g A
/-- Number of elements minus number of partition blocks. -/
def partitionSlack {A : Finset V} (P : Finpartition A) : ℕ := A.card - P.parts.card
end CommAlg.Polymatroid
namespace CommAlg.Polymatroid
variable {ι : Type*} [Fintype ι] [Nonempty ι]
/-- The literal minimum over a finite nonempty index type. -/
def finiteMinimum (f : ι → ℕ) : ℕ :=
  Finset.univ.inf' Finset.univ_nonempty f
end CommAlg.Polymatroid
namespace CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Partitions having zero rank defect. -/
def zeroDefectPartitions (ρ : RankFunction V) (A : Finset V) : Finset (Finpartition A) :=
  Finset.univ.filter (fun P => partitionDefect ρ P = 0)
/-- Maximum block count of a zero-defect partition. -/
def zeroDefectComponents (ρ : RankFunction V) (A : Finset V) : ℕ :=
  (zeroDefectPartitions ρ A).sup (fun P => P.parts.card)
/-- The eventual projective dimension from the paper. -/
def eventualOffset (ρ : RankFunction V) (A : Finset V) : ℕ := A.card - zeroDefectComponents ρ A

section Ideals
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [CommRing k] [Nontrivial k]
/-- A genuine polynomial ideal with an equigenerated exchange-family presentation. -/
def IsPolymatroidalIdeal (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ B : Family V, IsPolymatroidal B ∧ I = monomialIdeal k B
/-- The uniquely determined minimal monomial generator family, chosen from a presentation. -/
def idealGenerators (I : Ideal (MvPolynomial V k)) (hI : IsPolymatroidalIdeal I) : Family V := hI.choose
/-- Products of polymatroidal ideals are polymatroidal; this is a typing fact,
not an extra hypothesis of the compared stabilization theorem. -/
theorem IsPolymatroidalIdeal.mul {I J : Ideal (MvPolynomial V k)}
    (hI : IsPolymatroidalIdeal I) (hJ : IsPolymatroidalIdeal J) :
    IsPolymatroidalIdeal (I * J) := by sorry
/-- Every power is polymatroidal, including the zeroth power. -/
theorem IsPolymatroidalIdeal.pow {I : Ideal (MvPolynomial V k)}
    (hI : IsPolymatroidalIdeal I) (s : ℕ) : IsPolymatroidalIdeal (I ^ s) := by sorry
/-- Every integral polymatroid rank defines a polymatroidal ideal. -/
theorem isPolymatroidalIdeal_rankIdeal (g : RankFunction V) :
    IsPolymatroidalIdeal (rankIdeal k g) := by sorry
end Ideals
end CommAlg.Polymatroid

namespace CommAlg.Simplicial
variable {V k : Type*} [Fintype V] [LinearOrder V] [CommRing k]
/-- Actual exterior chains on the coordinate vector space. -/
abbrev Ambient (V k : Type*) [Fintype V] [CommRing k] := ExteriorAlgebra k (V → k)
/-- The standard exterior basis indexed by finite coordinate subsets. -/
def basis : Module.Basis (Finset V) k (Ambient V k) := (Pi.basisFun k V).ExteriorAlgebra
/-- The span of actual face wedges of cardinality i; the empty face has degree zero. -/
def Chains (K : Finset V → Prop) (i : ℕ) : Submodule k (Ambient V k) :=
  Submodule.span k (basis '' {s | K s ∧ s.card = i})
/-- The signed augmented simplicial boundary, as actual exterior contraction. -/
abbrev boundary : Ambient V k →ₗ[k] Ambient V k :=
  CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm k (V → k)))
    (Fintype.linearCombination k (fun _ : V => (1 : k)))
/-- A cycle that is not a boundary. Chain degree i is reduced degree i-1. -/
def NonzeroHomology (K : Finset V → Prop) (i : ℕ) : Prop :=
  ∃ z : Ambient V k, z ∈ Chains K i ∧ boundary z = 0 ∧
    ∀ y : Ambient V k, y ∈ Chains K (i + 1) → boundary y ≠ z
end CommAlg.Simplicial

namespace CommAlg.Koszul
open CommAlg.Polymatroid
universe u
variable {V : Type u} [Fintype V] [LinearOrder V]
/-- The squarefree exponent vector of the exterior coordinate subset. -/
def faceExponent (s : Finset V) : Exponent V := ∑ j ∈ s, Finsupp.single j 1
/-- Standard multigraded Koszul faces: permitted simultaneous coordinate deletions. -/
def koszulFaces (B : Family V) (a : Exponent V) (s : Finset V) : Prop :=
  faceExponent s ≤ a ∧ Contains B (a - faceExponent s)
end CommAlg.Koszul

namespace PalomarHomological
open CommAlg CommAlg.Polymatroid
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]
/-- Homological shift via actual Koszul homology. The Solution identifies this
with the genuine derived-Tor definition; no rank formula defines the support. -/
def homologicalShiftIdeal (I : Ideal (MvPolynomial V k)) (hI : IsPolymatroidalIdeal I)
    (i : ℕ) : Ideal (MvPolynomial V k) :=
  Ideal.span ((fun a : Exponent V => MvPolynomial.monomial a (1 : k)) ''
    {a | Simplicial.NonzeroHomology (k := k) (Koszul.koszulFaces (idealGenerators I hI) a) i})

/-- Theorem 1.1's uniform stabilization equality for every i>0 and s>=i. -/
theorem stabilization (I : Ideal (MvPolynomial V k)) (hI : IsPolymatroidalIdeal I)
    (i s : ℕ) (_hi : 0 < i) (hs : i ≤ s) :
    homologicalShiftIdeal (I ^ (s + 1)) (hI.pow (s + 1)) i =
      I * homologicalShiftIdeal (I ^ s) (hI.pow s) i := by sorry
/-- The fixed-polymatroidal-twist clause, on the identical uniform range. -/
theorem twistedStabilization (I J : Ideal (MvPolynomial V k))
    (hI : IsPolymatroidalIdeal I) (hJ : IsPolymatroidalIdeal J)
    (i s : ℕ) (_hi : 0 < i) (hs : i ≤ s) :
    homologicalShiftIdeal (J * I ^ (s + 1)) (hJ.mul (hI.pow (s + 1))) i =
      I * homologicalShiftIdeal (J * I ^ s) (hJ.mul (hI.pow s)) i := by sorry
/-- Theorem 1.2's exact rank formula for the actual homological shift. -/
theorem exactRankFormula (g : RankFunction V) (hg : g.Active) (i : ℕ) :
    homologicalShiftIdeal (rankIdeal k g) (isPolymatroidalIdeal_rankIdeal g) i =
      if homologicalRank g hg i Finset.univ = g Finset.univ + i then
        rankIdeal k (homologicalRank g hg i) else ⊥ := by sorry
/-- The canonical upper-rank clause in the nonzero case, on the actual
minimal monomial generator family of the homological shift. -/
theorem canonicalRank (g : RankFunction V) (hg : g.Active) (i : ℕ)
    (hne : homologicalShiftIdeal (rankIdeal k g) (isPolymatroidalIdeal_rankIdeal g) i ≠ ⊥) :
    ∃ hH : IsPolymatroidalIdeal
        (homologicalShiftIdeal (rankIdeal k g) (isPolymatroidalIdeal_rankIdeal g) i),
      ∀ A : Finset V, upperRank (idealGenerators
        (homologicalShiftIdeal (rankIdeal k g) (isPolymatroidalIdeal_rankIdeal g) i) hH) A =
        homologicalRank g hg i A := by sorry
end PalomarHomological

namespace FourPapers.Homological
open CommAlg.Polymatroid
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]
/-- Corollary 4.3: actual categorical projective dimension of every positive power. -/
theorem corollary_4_3 (ρ : RankFunction V) (hρ : ρ.Active) (s : ℕ) (hs : 1 ≤ s) :
    CategoryTheory.projectiveDimension
        (ModuleCat.of (MvPolynomial V k) ↥((rankIdeal k ρ) ^ s)) =
      (finiteMinimum (fun P : Finpartition (Finset.univ : Finset V) =>
        s * partitionDefect ρ P + partitionSlack P) : WithBot ℕ∞) := by sorry
/-- Corollary 4.3's exact eventual value and its stated stabilization range. -/
theorem corollary_4_3_eventual (ρ : RankFunction V) (hρ : ρ.Active)
    (s : ℕ) (hs : max 1 (eventualOffset ρ Finset.univ) ≤ s) :
    CategoryTheory.projectiveDimension
        (ModuleCat.of (MvPolynomial V k) ↥((rankIdeal k ρ) ^ s)) =
      (eventualOffset ρ Finset.univ : WithBot ℕ∞) := by sorry
end FourPapers.Homological
