module
public import Mathlib

/-! # The Bandari–Herzog localisation conjecture -/

@[expose] public noncomputable section
open scoped BigOperators
open Filter Asymptotics
namespace CommAlg.Polymatroid
open Classical Finset
section ExponentSource
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Natural exponent vectors of monomials. -/
abbrev Exponent (V : Type*) := V →₀ ℕ
/-- A finite monomial exponent family. -/
abbrev Family (V : Type*) := Finset (Exponent V)

/-- Every displayed monomial has degree d. -/
def Equigenerated (B : Family V) (d : ℕ) : Prop := ∀ a ∈ B, a.degree = d

/-- No distinct displayed monomial divides another. -/
def Antichain (B : Family V) : Prop := ∀ a ∈ B, ∀ b ∈ B, a ≤ b → a = b
/-- Remove one unit from coordinate i and add one at coordinate j. -/
def exchange (a : Exponent V) (i j : V) : Exponent V :=
  a - Finsupp.single i 1 + Finsupp.single j 1

/-- The ordinary polymatroid exchange axiom. -/
def ExchangeAxiom (B : Family V) : Prop :=
  ∀ a ∈ B, ∀ b ∈ B, ∀ i, b i < a i →
    ∃ j, a j < b j ∧ exchange a i j ∈ B

/-- Equigeneration together with the ordinary exchange axiom. -/
def IsPolymatroidal (B : Family V) : Prop :=
  (∃ d, Equigenerated B d) ∧ ExchangeAxiom B

/-- The genuine polynomial ideal generated by the displayed monomials. -/
def monomialIdeal (k : Type*) [CommSemiring k] (B : Family V) :
    Ideal (MvPolynomial V k) :=
  Ideal.span ((fun a : Exponent V => MvPolynomial.monomial a (1 : k)) '' (B : Set (Exponent V)))
end ExponentSource
section Ideals
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [CommRing k] [Nontrivial k]
/-- A polynomial ideal admitting a finite equigenerated exchange family. -/
def IsPolymatroidalIdeal (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ B : Family V, IsPolymatroidal B ∧ I = monomialIdeal k B
end Ideals
end CommAlg.Polymatroid
namespace CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [LinearOrder V]
variable {k : Type*} [CommSemiring k]
/-- Ideal generated by the variables indexed by the finite set C. -/
def variableIdeal (C : Finset V) : Ideal (MvPolynomial V k) :=
  Ideal.span (MvPolynomial.X '' (C : Set V))
end CommAlg.Polymatroid
section HomogeneousFreeSource
local instance (priority := 2000) classicalBasisDecidableEqHomogeneousFree (α : Type*) [Fintype α] : DecidableEq α := Classical.decEq α
namespace Characterizations.Resolution
universe u v w
variable {V k : Type u} {J : Type v} {L : Type w} [CommRing k] [Fintype J] [Fintype L]
/-- The actual multivariate polynomial coefficient ring. -/
abbrev Polynomial := MvPolynomial V k
/-- A finite free module with its displayed coordinate basis. -/
abbrev Free (J : Type v) := J → Polynomial (V := V) (k := k)
/-- All entries of the matrix of the actual polynomial-linear map have degree `r`. -/
def IsHomogeneousMap (f : Free (V := V) (k := k) J →ₗ[Polynomial (V := V) (k := k)]
    Free (V := V) (k := k) L) (r : ℕ) : Prop :=
  ∀ a b, (f (Pi.single b 1) a).IsHomogeneous r
end Characterizations.Resolution
end HomogeneousFreeSource
section ResolutionBasicSource
local instance (priority := 2000) classicalBasisDecidableEqBasic (α : Type*) [Fintype α] : DecidableEq α := Classical.decEq α
namespace Characterizations
open Resolution
section Resolutions
universe u
variable {V k : Type u} [CommRing k]
/-- An exact augmented complex of finite free polynomial modules, with linear
matrix entries and degree-d homogeneous augmentation. -/
structure LinearResolution (I : Ideal (MvPolynomial V k)) (d : ℕ) where
  Index : ℕ → Type
  finite : ∀ n, Fintype (Index n)
  differential : ∀ n, (Index (n + 1) → MvPolynomial V k) →ₗ[MvPolynomial V k]
    (Index n → MvPolynomial V k)
  augmentation : (Index 0 → MvPolynomial V k) →ₗ[MvPolynomial V k] MvPolynomial V k
  augmentation_range : LinearMap.range augmentation = I
  exact_zero : LinearMap.range (differential 0) = LinearMap.ker augmentation
  exact_succ : ∀ n, LinearMap.range (differential (n + 1)) = LinearMap.ker (differential n)
  linear : ∀ n, letI := finite n; letI := finite (n + 1)
    IsHomogeneousMap (differential n) 1
  augmentation_homogeneous : ∀ b, (augmentation (Pi.single b 1)).IsHomogeneous d

attribute [instance] LinearResolution.finite

/-- Existence of an exact finite-free resolution with shifts `d + i`. -/
def HasLinearResolution (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ d, Nonempty (LinearResolution I d)
end Resolutions
end Characterizations
end ResolutionBasicSource
namespace Characterizations
open Classical Finset CommAlg CommAlg.Polymatroid MvPolynomial
section LocalDefs
variable {V : Type*} [Fintype V] [DecidableEq V]
variable (k : Type*) [CommSemiring k]
/-- Substitution of one for each variable outside U. -/
def localizationMap (U : Finset V) : MvPolynomial V k →ₐ[k] MvPolynomial U k :=
  MvPolynomial.aeval (fun i => if hi : i ∈ U then MvPolynomial.X ⟨i, hi⟩ else 1)
/-- The ordinary image ideal under that monomial localization. -/
def monomialLocalization (I : Ideal (MvPolynomial V k)) (U : Finset V) :
    Ideal (MvPolynomial U k) := Ideal.map (localizationMap k U).toRingHom I
end LocalDefs
section Localization
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]
/-- The ordinary meaning of a monomial ideal, permitting an arbitrary exponent set. -/
def IsMonomialIdeal (I : Ideal (MvPolynomial V k)) : Prop :=
  ∃ A : Set (Exponent V), I = Ideal.span ((fun a => monomial a (1 : k)) '' A)
end Localization
end Characterizations
namespace CommAlg.Polymatroid
open Classical Finset
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Delete every generator divisible by a distinct displayed generator. -/
def minimalFamily (B : Family V) : Family V :=
  B.filter (fun a => ∀ b ∈ B, b ≤ a → b = a)
/-- Set coordinates outside U to zero in the exponent vector, corresponding
to setting their variables to one in the monomial. -/
def project (U : Finset V) (a : Exponent V) : Exponent V := a.filter (· ∈ U)
/-- Minimal exponent family after monomial localization, in ambient coordinates. -/
def localize (B : Family V) (U : Finset V) : Family V :=
  minimalFamily (B.image (project U))
/-- Every monomial localization has generators of one degree. -/
def LocallyEquigenerated (B : Family V) : Prop :=
  ∀ U : Finset V, ∃ d, Equigenerated (localize B U) d
end CommAlg.Polymatroid
namespace Characterizations
open Classical Finset CommAlg.Polymatroid
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- The retained-coordinate exponent vector in the smaller polynomial ring. -/
def restrictExponent (U : Finset V) (a : Exponent V) : Exponent U :=
  a.subtypeDomain (· ∈ U)
/-- The actual minimal generator family after substitution of one outside U. -/
def localFamily (B : Family V) (U : Finset V) : Family U :=
  minimalFamily (B.image (restrictExponent U))
end Characterizations
namespace CommAlg.Polymatroid
open Classical Finset
variable {V : Type*} [Fintype V] [DecidableEq V]
/-- Sum of a monomial exponent over a coordinate set. -/
def subsetSum (a : Exponent V) (U : Finset V) : ℕ := ∑ i ∈ U, a i
/-- Minimum retained degree among the displayed monomial generators. -/
def lowerRank (B : Family V) (U : Finset V) : ℕ :=
  if h : B.Nonempty then B.inf' h (fun a => subsetSum a U) else 0
end CommAlg.Polymatroid
namespace Characterizations
open Classical Finset CommAlg.Polymatroid MvPolynomial
section Socle
variable {V : Type*} [Fintype V] [DecidableEq V]
variable {k : Type*} [CommRing k] [Nontrivial k]
/-- The socle of the actual polynomial quotient, annihilated by all variables. -/
def quotientSocle (I : Ideal (MvPolynomial V k)) : Set (MvPolynomial V k ⧸ I) :=
  {q | ∀ i : V, Ideal.Quotient.mk I (X i) * q = 0}
/-- Every socle class admits a homogeneous representative of degree d. -/
def SocleConcentrated (I : Ideal (MvPolynomial V k)) (d : ℕ) : Prop :=
  ∀ q ∈ quotientSocle I, ∃ f : MvPolynomial V k,
    f.IsHomogeneous d ∧ Ideal.Quotient.mk I f = q
end Socle
end Characterizations

end

@[expose] public noncomputable section
namespace BandariHerzog
open Classical CommAlg.Polymatroid Characterizations
universe u
variable {V k : Type u} [Fintype V] [LinearOrder V] [Field k]

/-- Theorem 1.1 of the supplied paper. -/
theorem localisation_conjecture {I : Ideal (MvPolynomial V k)}
    (hI : IsMonomialIdeal I) (_hne : I ≠ ⊥) :
    IsPolymatroidalIdeal I ↔
      ∀ U : Finset V, HasLinearResolution (monomialLocalization k I U) := by
  sorry

/-- Theorem 1.2 of the supplied paper. -/
theorem intersection_type {B : Family V} (hB : B.Nonempty) (ha : Antichain B)
    (hl : LocallyEquigenerated B)
    (hi : ∃ e : Finset V → ℕ, monomialIdeal k B =
      ⨅ U : Finset V, (variableIdeal (k := k) U) ^ e U) : IsPolymatroidal B := by
  sorry

/-- Lemma 2.1 of the supplied paper. -/
theorem lower_rank_supermodular {B : Family V} (hB : B.Nonempty)
    (hl : LocallyEquigenerated B) (A C : Finset V) :
    lowerRank B A + lowerRank B C ≤ lowerRank B (A ∪ C) + lowerRank B (A ∩ C) := by
  sorry

/-- Closing socle criterion, page 4 of the supplied paper. -/
theorem local_socle_criterion {B : Family V} (hB : B.Nonempty) (ha : Antichain B) :
    IsPolymatroidal B ↔ LocallyEquigenerated B ∧
      ∀ U : Finset V, monomialIdeal k (localFamily B U) ≠ ⊤ →
        SocleConcentrated (monomialIdeal k (localFamily B U)) (lowerRank B U - 1) := by
  sorry

end BandariHerzog
