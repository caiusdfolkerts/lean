def rawGenerators (g c : Nat) : Nat :=
  (PackedRawNatGrowth.take 13
    (PackedRawNatGrowth.drop (13*(c%64)) (mapTable.get (g*82+c/64)))) % 5238
def rawInverseGenerators (g c : Nat) : Nat :=
