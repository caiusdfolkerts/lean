    Interval (group0430.pairTest FacetUniverses.FullSix0.cells) 128 155 :=
  interval_of_check _ 128 27 (by decide +kernel)
theorem group0430_facts : group0430.Facts FacetUniverses.FullSix0.cells :=
  group0430.facts_of_checks _ group0430_header (interval_append _ 0 128 155 group0430_pairs_00000 group0430_pairs_00128)
#print axioms group0430_facts
