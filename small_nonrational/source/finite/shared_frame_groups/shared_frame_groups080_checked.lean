theorem group0890_header : group0890.headerCheck = true := by
  decide +kernel
theorem group0890_pairs_00000 :
    Interval (group0890.pairTest FacetUniverses.FullSix0.cells) 0 128 :=
  interval_of_check _ 0 128 (by decide +kernel)
