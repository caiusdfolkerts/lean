    Interval (group0890.pairTest FacetUniverses.FullSix0.cells) 128 162 :=
  interval_of_check _ 128 34 (by decide +kernel)
theorem group0890_facts : group0890.Facts FacetUniverses.FullSix0.cells :=
  group0890.facts_of_checks _ group0890_header (interval_append _ 0 128 162 group0890_pairs_00000 group0890_pairs_00128)
#print axioms group0890_facts
