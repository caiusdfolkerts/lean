module
prelude
public import RootedSevenPure037
public import RawGraphGrowthFrames
public import FiniteChecks

@[expose] public section
set_option maxHeartbeats 0
namespace Papers.RationalityTen.FacetUniverses.RootedSevenPure037.Outside
open Papers.RationalityTen ConcreteGrowth RawGraphGrowthFrames
abbrev generatorCount : Nat := 2
def vertexTable : Table Nat :=
(.branch 1
 (.leaf 650793726480)
 (.leaf 590395748880))
def mapTable : Table Nat :=
(.branch 1
 (.leaf )
 (.leaf ))
def vertexCode (g : Fin generatorCount) : Nat := vertexTable.get g.val
def forward (g : Fin generatorCount) : Fin cellCount → Fin cellCount :=
  packedCellMap (by decide) 10 (mapTable.get g.val)
def rawMap (g c : Nat) : Nat :=
  ((mapTable.get g >>> (10 * c)) % 1024) % 586
theorem rawMap_exact (g : Fin generatorCount) (c : Fin cellCount) :
    rawMap g.val c.val = (forward g c).val := rfl
theorem vertex_checks (g : Fin generatorCount) :
    TenGraphEdges.permutationCheck (vertexCode g) (vertexCode g) = true := by
  have h : ∀ g : Fin generatorCount,
      TenGraphEdges.permutationCheck (vertexCode g) (vertexCode g) = true := by decide +kernel
  exact h g
def cellTest (g i : Nat) : Bool :=
  let generator := Fin.ofNat generatorCount g
  let cell := Fin.ofNat cellCount i
  inverseCheckAt (forward generator) (forward generator) cell &&
    cellRelabelCheck (TenGraphEdges.vertexMap (vertexCode generator))
      (cells cell) (cells (forward generator cell))
end Papers.RationalityTen.FacetUniverses.RootedSevenPure037.Outside
