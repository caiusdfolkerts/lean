abbrev cellCount : Nat := 461
abbrev nodeCount : Nat := 655
abbrev leafCount : Nat := 6
def widths : PackedRawNatGrowth.Widths := ⟨9,10,0,3⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 3
 (.branch 1
 (.leaf ⟨hexnat% "",⟩)
 (.branch 2
 (.leaf ⟨,⟩)
 (.leaf ⟨hexnat% "",⟩)))
 (.branch 4
 (.leaf ⟨,⟩)
 (.branch 5
 (.leaf ⟨,⟩)
 (.leaf ⟨,0x826000007aa00000725000005ff00000542000004a20000041f0000039300000311000002a100000231000001910000010e0000008200000000⟩))))
def counterTable : Table Nat :=
(.branch 3
 (.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf )))
 (.branch 4
 (.leaf )
 (.branch 5
 (.leaf )
 (.leaf 0x401000201000100c0008061004031002018c0100c610806408403104201882100c4008063004031842019021))))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.branch 3
 (.branch 1
 (.leaf [0,15,57,92,116,221,299,374])
 (.branch 2
 (.leaf [0,16,69,92,116,233,311,374])
 (.leaf [0,14,56,93,117,220,298,375])))
