abbrev cellCount : Nat := 556
abbrev nodeCount : Nat := 421
abbrev leafCount : Nat := 1
def widths : PackedRawNatGrowth.Widths := ⟨10,9,0,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 2
 (.branch 1
 (.leaf ⟨,⟩)
 (.leaf ⟨,⟩))
 (.branch 3
 (.leaf ⟨,⟩)
 (.leaf ⟨,0xd7400000d1b00000cb800000c5e00000c0500000ba200000b4800000aef00000a8c00000a1f000009bb00000962000008ff000008920000082e000007d50000077200000718000006bf0000065c00000602000005a900000546000004d9000004750000041c000003b90000034c000002e80000028f0000022c000001d20000017900000116000000bc0000006300000000⟩)))
def counterTable : Table Nat :=
(.branch 2
 (.branch 1
 (.leaf )
 (.leaf ))
 (.branch 3
 (.leaf )
 (.leaf 0x1080000842000421080210000108400084210042000021080010842008441004200002108001084200844100420000210800108420084000042100021084010800008420004210802110401080000842000421080211040108000084200042108021000010840008421004200002108001)))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.leaf [])
def rawLeaves := leafTable.get

def leaves : Fin leafCount → List (Fin cellCount) := decodedLeaves rawLeaves
def quota : Nat → Nat
  | 0 => 1
  | 1 => 0
  | 2 => 3
  | 3 => 5
  | 4 => 1
  | _ => 0

def nodeTest (i : Nat) : Bool :=
  CounterGrowthReplay.check widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenMixed023.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenMixed023.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenMixed023.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenMixed023.keys Papers.RationalityTen.RootedCaches.RootedSevenMixed023.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenMixed023.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenMixed023.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenMixed023.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenMixed023.keys Papers.RationalityTen.RootedCaches.RootedSevenMixed023.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenMixed023.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenMixed023.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenMixed023.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenMixed023.keys Papers.RationalityTen.RootedCaches.RootedSevenMixed023.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenMixed023.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

end Papers.RationalityTen.RootedForests.RootedRawForest0023
