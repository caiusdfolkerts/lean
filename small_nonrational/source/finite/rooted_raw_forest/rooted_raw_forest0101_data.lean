module
prelude
public import RootedSevenPure067GrowthCacheData
public import IdentityRawMaps
public import CounterGrowthReplay
public import RawNatGrowthCompleteness
public import FiniteChecks

@[expose] public section
noncomputable section
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Papers.RationalityTen.RootedForests.RootedRawForest0101
open Papers.RationalityTen ConcreteGrowth FiniteChecks
open GrowthDAG SparseGrowthDAG GrowthPruning GrowthRenaming
open GrowthBitsets BatchedGrowthPruning BatchedOrbitGrowth
open RawNatGrowthSoundness RawNatGrowthCompleteness

abbrev cellCount : Nat := 406
abbrev nodeCount : Nat := 274
abbrev leafCount : Nat := 6
def widths : PackedRawNatGrowth.Widths := ⟨9,9,0,3⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 1
 (.leaf ⟨,⟩)
 (.branch 2
 (.leaf ⟨,⟩)
 (.leaf ⟨,0x7a60000072d000006ab000005c600000532000004cb00000464000003fd00000369000003020000029b00000234000001d6000001780000011a000000bc0000005e00000000⟩)))
def counterTable : Table Nat :=
(.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf 0x2008001008000806000403080201880100c400806200403080201880100c400806200403080201840100c2008061004030802018401)))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.branch 3
 (.branch 1
 (.leaf [0,2,37,74,140,165,186,211,245,314])
 (.branch 2
 (.leaf [0,14,37,62,141,164,185,211,233,315])
 (.leaf [0,1,38,86,139,165,186,212,257,302])))
 (.branch 4
 (.leaf [0,26,38,61,141,163,184,212,234,303])
 (.branch 5
 (.leaf [0,13,39,85,139,164,185,213,258,290])
 (.leaf [0,25,39,73,140,163,184,213,246,291]))))
def rawLeaves := leafTable.get

def leaves : Fin leafCount → List (Fin cellCount) := decodedLeaves rawLeaves
def quota : Nat → Nat
  | 0 => 1
  | 1 => 0
  | 2 => 6
  | 3 => 3
  | 4 => 0
  | _ => 0

def nodeTest (i : Nat) : Bool :=
  CounterGrowthReplay.check widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure067.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure067.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure067.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure067.keys Papers.RationalityTen.RootedCaches.RootedSevenPure067.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure067.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure067.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure067.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure067.keys Papers.RationalityTen.RootedCaches.RootedSevenPure067.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure067.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure067.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure067.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure067.keys Papers.RationalityTen.RootedCaches.RootedSevenPure067.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenPure067.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

end Papers.RationalityTen.RootedForests.RootedRawForest0101
