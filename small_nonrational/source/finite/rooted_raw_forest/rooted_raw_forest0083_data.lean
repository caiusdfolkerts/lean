abbrev cellCount : Nat := 496
abbrev nodeCount : Nat := 157
abbrev leafCount : Nat := 1
def widths : PackedRawNatGrowth.Widths := ⟨9,8,0,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 1
 (.leaf ⟨,⟩)
 (.leaf ⟨,0xc4c00000bd600000abe00000a36000009d80000097a0000091c000008b600000836000007cf0000076800000702000006820000061b000005b40000052c000004ce0000047000000412000003ac0000032c000002c50000025e000001f80000017800000111000000aa0000005500000000⟩))
def counterTable : Table Nat :=
(.branch 1
 (.leaf )
 (.leaf 0x10040008040004020802010801008400804200402080201080100860080430040208020108010086008043004020802010801008400804200402080201080100860080430040208020108010086008043004020802010401))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.leaf [])
def rawLeaves := leafTable.get

def leaves : Fin leafCount → List (Fin cellCount) := decodedLeaves rawLeaves
def quota : Nat → Nat
  | 0 => 1
  | 1 => 0
  | 2 => 7
  | 3 => 2
  | 4 => 0
  | _ => 0

def nodeTest (i : Nat) : Bool :=
  CounterGrowthReplay.check widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure049.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure049.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure049.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure049.keys Papers.RationalityTen.RootedCaches.RootedSevenPure049.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure049.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure049.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure049.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure049.keys Papers.RationalityTen.RootedCaches.RootedSevenPure049.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure049.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure049.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure049.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure049.keys Papers.RationalityTen.RootedCaches.RootedSevenPure049.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenPure049.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

