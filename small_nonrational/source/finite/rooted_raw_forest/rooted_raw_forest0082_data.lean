theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure048.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure048.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure048.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure048.keys Papers.RationalityTen.RootedCaches.RootedSevenPure048.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure048.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure048.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure048.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure048.keys Papers.RationalityTen.RootedCaches.RootedSevenPure048.fastKind quota
