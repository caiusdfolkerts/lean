 (.branch 10
 (.leaf ⟨hexnat% "",⟩)
 (.branch 11
 (.leaf ⟨hexnat% "",⟩)
 (.leaf ⟨,⟩)))))
def counterTable : Table Nat :=
(.branch 6
 (.branch 3
 (.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf )))
 (.branch 4
 (.leaf )
 (.branch 5
 (.leaf )
 (.leaf ))))
 (.branch 9
