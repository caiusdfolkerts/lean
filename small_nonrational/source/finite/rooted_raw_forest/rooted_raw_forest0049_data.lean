abbrev cellCount : Nat := 659
abbrev nodeCount : Nat := 1465
abbrev leafCount : Nat := 1
def widths : PackedRawNatGrowth.Widths := ⟨10,11,0,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 6
 (.branch 3
 (.branch 1
 (.leaf ⟨,⟩)
 (.branch 2
 (.leaf ⟨,⟩)
 (.leaf ⟨,⟩)))
 (.branch 4
 (.leaf ⟨hexnat% "",⟩)
