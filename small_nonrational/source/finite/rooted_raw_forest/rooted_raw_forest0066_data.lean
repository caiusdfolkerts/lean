def rawLeaves (i : Nat) : List Nat :=
  let code := leafTable.get i
  (PackedRawNatGrowth.readList 9 (PackedRawNatGrowth.take 5 code)
    (PackedRawNatGrowth.drop 5 code)).1

def leaves : Fin leafCount → List (Fin cellCount) := decodedLeaves rawLeaves
def quota : Nat → Nat
  | 0 => 1
  | 1 => 2
  | 2 => 4
  | 3 => 5
  | 4 => 0
  | _ => 0

def nodeTest (i : Nat) : Bool :=
  CounterGrowthReplay.check widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure032.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure032.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure032.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure032.keys Papers.RationalityTen.RootedCaches.RootedSevenPure032.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure032.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure032.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure032.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure032.keys Papers.RationalityTen.RootedCaches.RootedSevenPure032.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure032.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure032.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure032.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure032.keys Papers.RationalityTen.RootedCaches.RootedSevenPure032.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenPure032.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

