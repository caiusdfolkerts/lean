abbrev nodeCount : Nat := 1216
abbrev leafCount : Nat := 6
def widths : PackedRawNatGrowth.Widths := ⟨9,11,0,3⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 5
