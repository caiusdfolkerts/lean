abbrev cellCount : Nat := 496
abbrev nodeCount : Nat := 289
abbrev leafCount : Nat := 1
def widths : PackedRawNatGrowth.Widths := ⟨9,9,0,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 1
 (.leaf ⟨,⟩)
 (.branch 2
 (.leaf ⟨,⟩)
 (.leaf ⟨,0xf3800000ebf00000d7700000d1000000c7c00000c1500000bae00000b4700000ae000000a4c000009e50000097e00000917000008a600000835000007e00000078b00000736000006e10000068c00000637000005c600000555000004e4000004730000033d000002d600000242000001db000001740000010d0000005e00000000⟩)))
def counterTable : Table Nat :=
(.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf 0x1004000804000402080201080100c40080430040218020104010084008062004021802010c0100c000806000403000201800100c0008060004020802010401008200804100402080201040100800080600040400020204010102008081004020802018401)))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.leaf [])
def rawLeaves := leafTable.get

def leaves : Fin leafCount → List (Fin cellCount) := decodedLeaves rawLeaves
def quota : Nat → Nat
  | 0 => 1
  | 1 => 0
  | 2 => 5
  | 3 => 4
  | 4 => 0
  | _ => 0

def nodeTest (i : Nat) : Bool :=
  CounterGrowthReplay.check widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure053.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure053.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure053.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure053.keys Papers.RationalityTen.RootedCaches.RootedSevenPure053.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure053.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure053.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure053.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure053.keys Papers.RationalityTen.RootedCaches.RootedSevenPure053.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure053.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure053.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure053.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure053.keys Papers.RationalityTen.RootedCaches.RootedSevenPure053.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenPure053.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

