    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure007.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure007.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure007.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure007.keys Papers.RationalityTen.RootedCaches.RootedSevenPure007.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure007.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure007.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure007.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure007.keys Papers.RationalityTen.RootedCaches.RootedSevenPure007.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenPure007.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

