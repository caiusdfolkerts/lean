module
prelude
public import RootedSevenPure003GrowthCacheData
public import IdentityRawMaps
public import CounterGrowthReplay
public import RawNatGrowthCompleteness
public import FiniteChecks

@[expose] public section
noncomputable section
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Papers.RationalityTen.RootedForests.RootedRawForest0037
open Papers.RationalityTen ConcreteGrowth FiniteChecks
open GrowthDAG SparseGrowthDAG GrowthPruning GrowthRenaming
open GrowthBitsets BatchedGrowthPruning BatchedOrbitGrowth
open RawNatGrowthSoundness RawNatGrowthCompleteness

abbrev cellCount : Nat := 586
abbrev nodeCount : Nat := 262
abbrev leafCount : Nat := 1
def widths : PackedRawNatGrowth.Widths := ⟨10,9,0,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 1
 (.leaf ⟨,⟩)
 (.branch 2
 (.leaf ⟨,⟩)
 (.leaf ⟨0x10409d5a13158250003000001b800181842fc07dea0f3bc1b74832e3055b809b54126781ec903586062f40b5b814b60256a042d0075980cb201562022c00357804ae0040058000001e138002810be0002000002b09c2100070124e0048bfc907f11afd22c0014000003a2f84e1080040000000002c9262f84e108005000000000549222f84e108005,0x3cc000001e400000181000000c80000006400000000⟩)))
def counterTable : Table Nat :=
(.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf 0x20080010080008060004040002020001)))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.leaf [])
def rawLeaves := leafTable.get

def leaves : Fin leafCount → List (Fin cellCount) := decodedLeaves rawLeaves
def quota : Nat → Nat
  | 0 => 1
  | 1 => 0
  | 2 => 4
  | 3 => 5
  | 4 => 0
  | _ => 0

def nodeTest (i : Nat) : Bool :=
  CounterGrowthReplay.check widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure003.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure003.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure003.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure003.keys Papers.RationalityTen.RootedCaches.RootedSevenPure003.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 1 leafCount nodeCount (rawNodes i) = true ∧
      RawNatGrowthCheck.nodeCheck Papers.RationalityTen.RootedCaches.RootedSevenPure003.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure003.badMasks
        Papers.RationalityTen.RootedCaches.RootedSevenPure003.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure003.keys Papers.RationalityTen.RootedCaches.RootedSevenPure003.fastKind quota
        Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves rawNodes i = true :=
  CounterGrowthReplay.check_sound widths cellCount 1024 1 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSevenPure003.candidateMasks Papers.RationalityTen.RootedCaches.RootedSevenPure003.badMasks
    Papers.RationalityTen.RootedCaches.RootedSevenPure003.kindMasks Papers.RationalityTen.RootedCaches.RootedSevenPure003.keys Papers.RationalityTen.RootedCaches.RootedSevenPure003.fastKind quota
    Papers.RationalityTen.IdentityRawMaps.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSevenPure003.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

end Papers.RationalityTen.RootedForests.RootedRawForest0037
