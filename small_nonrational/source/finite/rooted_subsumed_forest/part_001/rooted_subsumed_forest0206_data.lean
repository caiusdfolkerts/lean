abbrev cellCount : Nat := 8084
abbrev nodeCount : Nat := 786
abbrev leafCount : Nat := 1
def widths : PackedRawNatGrowth.Widths := ⟨13,10,6,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 3
 (.branch 1
 (.leaf ⟨(hexnat% ""),⟩)
 (.branch 2
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩)))
 (.branch 5
