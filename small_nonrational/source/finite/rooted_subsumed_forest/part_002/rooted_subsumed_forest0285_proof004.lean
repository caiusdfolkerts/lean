def test2560 (i : Nat) := nodeTest (i+2560)
theorem test2560_block_0 : Interval test2560 0 10 :=
  interval_of_check test2560 0 10 (by decide +kernel)

theorem test2560_complete : Interval test2560 0 10 :=
  test2560_block_0
theorem nodeInterval2560 : Interval nodeTest 2560 2570 := by
  intro i hlo hhi
  have h := test2560_complete (i-2560) (Nat.zero_le _) (by omega)
  simpa only [test2560, Nat.sub_add_cancel hlo] using h

