def counterTable : Table Nat :=
(.branch 4
 (.branch 2
 (.branch 1
 (.leaf )
 (.leaf ))
 (.branch 3
 (.leaf )
 (.leaf )))
 (.branch 6
 (.branch 5
 (.leaf )
 (.leaf ))
 (.branch 7
