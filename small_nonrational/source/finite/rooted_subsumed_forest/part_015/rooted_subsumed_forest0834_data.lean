abbrev cellCount : Nat := 2170
abbrev nodeCount : Nat := 1130
abbrev leafCount : Nat := 8
def widths : PackedRawNatGrowth.Widths := ⟨12,11,9,3⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 4
 (.branch 2
 (.branch 1
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩))
 (.branch 3
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩)))
 (.branch 6
