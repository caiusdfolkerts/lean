def test640 (i : Nat) := nodeTest (i+640)
theorem test640_block_0 : Interval test640 0 3 :=
  interval_of_check test640 0 3 (by decide +kernel)

theorem test640_complete : Interval test640 0 3 :=
  test640_block_0
theorem nodeInterval640 : Interval nodeTest 640 643 := by
  intro i hlo hhi
  have h := test640_complete (i-640) (Nat.zero_le _) (by omega)
  simpa only [test640, Nat.sub_add_cancel hlo] using h

