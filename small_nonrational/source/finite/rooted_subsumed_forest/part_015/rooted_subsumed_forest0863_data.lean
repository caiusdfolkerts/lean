abbrev cellCount : Nat := 2170
abbrev nodeCount : Nat := 794
abbrev leafCount : Nat := 3
def widths : PackedRawNatGrowth.Widths := ⟨12,10,9,2⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 3
 (.branch 1
 (.leaf ⟨(hexnat% ""),⟩)
 (.branch 2
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩)))
 (.branch 5
 (.branch 4
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩))
 (.branch 6
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨,0x17a6000016de0000160a000010ce0000102000000f2500000e1e00000d4c00000a96000009e50000098d000008dc00000884000007ab000006d20000066e000005890000052500000440000003dc0000032b000002c700000216000001b2000000d900000000⟩))))
def counterTable : Table Nat :=
(.branch 3
 (.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf )))
 (.branch 5
 (.branch 4
 (.leaf )
 (.leaf ))
 (.branch 6
 (.leaf )
 (.leaf ))))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 55 (PackedRawNatGrowth.drop (55*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.branch 1
