abbrev cellCount : Nat := 8084
abbrev nodeCount : Nat := 958
abbrev leafCount : Nat := 7
def widths : PackedRawNatGrowth.Widths := ⟨13,10,6,3⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 4
 (.branch 2
 (.branch 1
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩))
 (.branch 3
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩)))
 (.branch 6
 (.branch 5
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨(hexnat% ""),⟩))
 (.branch 7
 (.leaf ⟨(hexnat% ""),⟩)
 (.leaf ⟨,⟩))))
def counterTable : Table Nat :=
(.branch 4
 (.branch 2
 (.branch 1
 (.leaf )
 (.leaf ))
 (.branch 3
 (.leaf )
 (.leaf )))
 (.branch 6
 (.branch 5
 (.leaf )
 (.leaf ))
 (.branch 7
 (.leaf )
 (.leaf ))))
def codes (i : Nat) : Nat :=
  let b := blocks.get (i / 128)
  PackedRawNatGrowth.drop
    (PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) b.offsets)) b.payload
def counters (i : Nat) : Nat :=
  PackedRawNatGrowth.take 55 (PackedRawNatGrowth.drop (55*(i%128)) (counterTable.get (i/128)))
def rawNodes (i : Nat) := PackedRawNatGrowth.decodeNode widths (codes i)

def leafTable : Table (List Nat) :=
(.branch 3
 (.branch 1
 (.leaf [0,63,139,225,333,355,529,655,925,1054,1229])
 (.branch 2
 (.leaf [0,1,189,332,335,530,553,643,946,1053,1230])
 (.leaf [0,21,104,211,330,530,598,679,905,1017,1234])))
 (.branch 5
