def nodeTest (i : Nat) : Bool :=
  SubsumedCounterReplay.check widths cellCount 1024 96 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSixExtra00.candidateMasks Papers.RationalityTen.RootedCaches.RootedSixExtra00.badMasks
    Papers.RationalityTen.RootedCaches.RootedSixExtra00.kindMasks Papers.RationalityTen.RootedCaches.RootedSixExtra00.keys Papers.RationalityTen.RootedCaches.RootedSixExtra00.fastKind quota
    Papers.RationalityTen.FacetUniverses.RootedSixExtra00.Generators.FastWords.rawMaps rawLeaves codes counters i
theorem nodeTest_sound (i : Nat) (h : nodeTest i = true) :
    nodeBounds cellCount 1024 96 leafCount nodeCount (rawNodes i) = true ∧
      SubsumedRawGrowth.nodeCheck Papers.RationalityTen.RootedCaches.RootedSixExtra00.candidateMasks Papers.RationalityTen.RootedCaches.RootedSixExtra00.badMasks
        Papers.RationalityTen.RootedCaches.RootedSixExtra00.kindMasks Papers.RationalityTen.RootedCaches.RootedSixExtra00.keys Papers.RationalityTen.RootedCaches.RootedSixExtra00.fastKind quota
        Papers.RationalityTen.FacetUniverses.RootedSixExtra00.Generators.FastWords.rawMaps rawLeaves rawNodes i = true :=
  SubsumedCounterReplay.check_sound widths cellCount 1024 96 leafCount nodeCount
    Papers.RationalityTen.RootedCaches.RootedSixExtra00.candidateMasks Papers.RationalityTen.RootedCaches.RootedSixExtra00.badMasks
    Papers.RationalityTen.RootedCaches.RootedSixExtra00.kindMasks Papers.RationalityTen.RootedCaches.RootedSixExtra00.keys Papers.RationalityTen.RootedCaches.RootedSixExtra00.fastKind quota
    Papers.RationalityTen.FacetUniverses.RootedSixExtra00.Generators.FastWords.rawMaps rawLeaves codes counters i h
def leafTest (i : Nat) : Bool :=
  listBounds cellCount (rawLeaves i) &&
    (WitnessGrowthDAG.closedCheck FacetUniverses.RootedSixExtra00.ridgeList
      ((rawLeaves i).map (Fin.ofNat cellCount)) &&
      decide (((rawLeaves i).map (Fin.ofNat cellCount)).Nodup))

