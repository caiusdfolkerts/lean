def test640 (i : Nat) := nodeTest (i+640)
theorem test640_block_0 : Interval test640 0 16 :=
  interval_of_check test640 0 16 (by decide +kernel)

theorem test640_block_1 : Interval test640 16 19 :=
  interval_of_check test640 16 3 (by decide +kernel)

theorem test640_complete : Interval test640 0 19 :=
  (interval_append test640 0 16 19
  test640_block_0
  test640_block_1)
theorem nodeInterval640 : Interval nodeTest 640 659 := by
  intro i hlo hhi
  have h := test640_complete (i-640) (Nat.zero_le _) (by omega)
  simpa only [test640, Nat.sub_add_cancel hlo] using h

