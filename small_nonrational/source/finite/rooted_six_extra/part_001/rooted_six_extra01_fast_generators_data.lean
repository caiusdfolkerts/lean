module
prelude
import HexNatLiteral
public import RootedSixExtra01GeneratorsData
public import FastGeneratorWords

@[expose] public section
noncomputable section
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Papers.RationalityTen.FacetUniverses.RootedSixExtra01.Generators.Fast
open Papers.RationalityTen ConcreteGrowth

/- One integer stores the whole image list for each generator. -/
def mapTable : Table Nat :=
(.branch 2
 (.branch 1
 (.leaf (hexnat% ""))
 (.leaf (hexnat% "")))
 (.branch 3
 (.leaf (hexnat% ""))
 (.leaf (hexnat% ""))))
def rawGenerators (a c : Nat) : Nat :=
  PackedRawNatGrowth.take 12
    (PackedRawNatGrowth.drop (12 * c) (mapTable.get a))
def rawMaps (frame cell : Nat) : Nat :=
  CheckedGraphGrowthWords.rawApply rawGenerators
    (Papers.RationalityTen.FacetUniverses.RootedSixExtra01.Generators.rawWords frame) cell
def test (i : Nat) : Bool :=
  rawGenerators (i / 3150) (i % 3150) ==
    Papers.RationalityTen.FacetUniverses.RootedSixExtra01.Generators.rawGenerators (i / 3150) (i % 3150)
end Papers.RationalityTen.FacetUniverses.RootedSixExtra01.Generators.Fast
