def wordTable : Table Nat :=
(.branch 1
 (.leaf )
 (.leaf 289072562201089507415087921902746222976011257117308165774103112349068077841707004022614958615763827897661399721650157491532729460249439450563592590429179444450163112886567402521998243576814960288521373898566498409652930866838894319725060571558420894886844675043344263189))
def rawGenerators (g c : Nat) : Nat :=
  (PackedRawNatGrowth.take 14
    (PackedRawNatGrowth.drop (14*(c%64)) (mapTable.get (g*138+c/64)))) % 8824
def rawInverseGenerators (g c : Nat) : Nat :=
  (PackedRawNatGrowth.take 14
    (PackedRawNatGrowth.drop (14*(c%64)) (inverseMapTable.get (g*138+c/64)))) % 8824
def forward (g : Fin generatorCount) (c : Fin 8824) : Fin 8824 :=
  ⟨rawGenerators g.val c.val, Nat.mod_lt _ (by decide)⟩
def inverse (g : Fin generatorCount) (c : Fin 8824) : Fin 8824 :=
  ⟨rawInverseGenerators g.val c.val, Nat.mod_lt _ (by decide)⟩
def vertexCode (g : Fin generatorCount) := vertexTable.get g.val
def vertexInverseCode (g : Fin generatorCount) := vertexInverseTable.get g.val
def rawWords (frame : Nat) : List Nat :=
  let code := PackedRawNatGrowth.take 28
    (PackedRawNatGrowth.drop (28*(frame%64)) (wordTable.get (frame/64)))
  ((PackedRawNatGrowth.readList 3 (PackedRawNatGrowth.take 4 code)
    (PackedRawNatGrowth.drop 4 code)).1).map (fun x => x % generatorCount)
def rawMaps (frame cell : Nat) :=
  CheckedGraphGrowthWords.rawApply rawGenerators (rawWords frame) cell
def words (frame : Fin frameCount) : List (Fin generatorCount) :=
  (rawWords frame.val).map (Fin.ofNat generatorCount)
theorem word_bounds (i : Nat) : RawNatGrowthSoundness.listBounds generatorCount (rawWords i) = true := by
  apply List.all_eq_true.mpr
  intro a ha
  obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
  exact decide_eq_true (Nat.mod_lt b (by decide))
theorem raw_words_exact (frame : Fin frameCount) :
    rawWords frame.val = (words frame).map Fin.val :=
  (RawNatGrowthSoundness.val_decode_list _ (word_bounds frame.val)).symm
theorem raw_generators_exact (g : Fin generatorCount) (c : Fin 8824) :
    rawGenerators g.val c.val = (forward g c).val := rfl
theorem identity_exact (c : Nat) : rawMaps 0 c = c := rfl
theorem vertex_checks (g : Fin generatorCount) :
    TenGraphEdges.permutationCheck (vertexCode g) (vertexInverseCode g) = true := by
  have h : ∀ g : Fin generatorCount,
    TenGraphEdges.permutationCheck (vertexCode g) (vertexInverseCode g) = true := by decide +kernel
  exact h g
def cellTest (g i : Nat) : Bool :=
  let gen := Fin.ofNat generatorCount g
  let cell := Fin.ofNat 8824 i
  inverseCheckAt (forward gen) (inverse gen) cell &&
    cellRelabelCheck (TenGraphEdges.vertexMap (vertexCode gen))
      (cells cell) (cells (forward gen cell))
