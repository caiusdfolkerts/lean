def wordCode : Nat := 
def rawWords (frame : Nat) : List Nat :=
  if frame < 240 then
    let code := take 37 (drop (37*frame) wordCode)
    ((readList 3 (take 4 code) (drop 4 code)).1).map
      (fun x => x % 5)
  else Papers.RationalityTen.FacetUniverses.RootedSixExtra06.Generators.rawWords frame
def rawMaps (frame cell : Nat) : Nat :=
  if frame = 0 then cell else
    CheckedGraphGrowthWords.rawApply Papers.RationalityTen.FacetUniverses.RootedSixExtra06.Generators.Fast.rawGenerators (rawWords frame) cell
def test (i : Nat) : Bool := rawWords i == Papers.RationalityTen.FacetUniverses.RootedSixExtra06.Generators.rawWords i
