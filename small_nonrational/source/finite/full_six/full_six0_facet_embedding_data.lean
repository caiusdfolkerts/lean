noncomputable def witness (code : Nat) : Fin FacetUniverses.FullSix0.cellCount :=
  Fin.ofNat FacetUniverses.FullSix0.cellCount
    ((witnessTable.get (code / 128) / 65536 ^ (code % 128)) % 65536)

noncomputable def canonicalCode (i : Nat) : Nat :=
  (inverseTable.get (i / 128) / 262144 ^ (i % 128)) % 262144

noncomputable def template : ConcreteGrowth.Cell :=
  ⟨4, 63, [3, 5, 6, 9, 10, 12, 18, 20, 24, 36, 40, 48], [7, 11, 13, 22, 26, 44, 52, 56]⟩

noncomputable def embeddingTest (code : Nat) : Bool :=
  RawFacetEmbedding.embeddingCheck 6 template FacetUniverses.FullSix0.cells code (witness code)

noncomputable def inverseTest (i : Nat) : Bool :=
  decide (canonicalCode i < 151200 ∧
    (witness (canonicalCode i)).val = 6510 + i) &&
  RawFacetEmbedding.wellFormedCheck (FacetUniverses.FullSix0.cells (witness (canonicalCode i)))
end Papers.RationalityTen.FullSix0FacetEmbedding
