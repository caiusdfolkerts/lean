def widths : PackedRawNatGrowth.Widths := ⟨10,9,1,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 1
 (.leaf ⟨,⟩)
 (.branch 2
 (.leaf ⟨,⟩)
 (.leaf ⟨,6149010960207972156783404931727492018908384000417596066549798727009017835356977452658232862136720482692997934251825811558898012913091344733512466244242530871783414448105399610847568689759612178538009295074032036715466199175089490394489211379639785550591159433166215589884264133427200⟩)))
def rawNodes := PackedRawNatGrowth.nodes blocks widths 128
def nodeTest (i : Nat) : Bool :=
  nodeBounds 646 1024 1 1 286 (rawNodes i) &&
    RawNatGrowthCheck.nodeCheck candidateMasks badMasks kindMasks keys rawKind quota
      (fun _ c => c) rawLeaves rawNodes i
def leafTest (i : Nat) : Bool :=
  listBounds 646 (rawLeaves i) &&
    WitnessGrowthDAG.closedCheck ridgeList ((rawLeaves i).map (Fin.ofNat 646))


def codes (i : Nat) : Nat :=
  let block := blocks.get (i / 128)
  let offset := PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) block.offsets)
  PackedRawNatGrowth.drop offset block.payload
def countersTable : Table Nat :=
(.branch 1
 (.leaf )
 (.branch 2
 (.leaf )
 (.leaf 182016530112017742617192282511498113299152527726460896758113333229219071090758491128513339140719073151077015940821897340988594903923787008867834294155265137010487215482308915755935296345299824197917294752290171849310209)))
def counters (i : Nat) := PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (countersTable.get (i/128)))
def maskLookupTable : Table Nat :=
(.branch 2
 (.branch 1
 (.leaf )
 (.leaf ))
 (.branch 3
 (.leaf )
 (.branch 4
 (.leaf )
 (.leaf ))))
def maskLookup (i : Nat) := PackedRawNatGrowth.take 646 (PackedRawNatGrowth.drop (646*(i%64)) (maskLookupTable.get (i/64)))
def selectedMasks (i : Nat) : Nat :=
  if i < 286 then maskLookup i else StreamingRawGrowth.nodeMask widths (codes i)
def maskTest (i : Nat) := decide (selectedMasks i = StreamingRawGrowth.nodeMask widths (codes i))
def fastTest (i : Nat) : Bool :=
  CachedMaskGrowth.countedCheck widths 646 1024 1 1 286
    candidateMasks badMasks kindMasks keys rawKind quota (fun _ c => c)
    rawLeaves codes counters selectedMasks i

end Papers.RationalityTen.PackedReplay.PackedSevenMixed002
