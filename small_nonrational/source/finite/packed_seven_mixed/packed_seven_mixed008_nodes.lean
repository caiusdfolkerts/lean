module
prelude
public import PackedSevenMixed008Data
public import PackedRawNatGrowth
public import CachedMaskGrowth

@[expose] public section
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Papers.RationalityTen.PackedReplay.PackedSevenMixed008
open Papers.RationalityTen
open ConcreteGrowth GrowthDAG SparseGrowthDAG GrowthPruning GrowthRenaming
open GrowthBitsets BatchedGrowthPruning BatchedOrbitGrowth FiniteChecks
open RawNatGrowthSoundness RawNatGrowthCompleteness RawGrowthCacheCertificate
def widths : PackedRawNatGrowth.Widths := ⟨10,8,1,1⟩
def blocks : Table PackedRawNatGrowth.Block :=
(.branch 1
 (.leaf ⟨,⟩)
 (.leaf ⟨,⟩))
def rawNodes := PackedRawNatGrowth.nodes blocks widths 128
def nodeTest (i : Nat) : Bool :=
  nodeBounds 694 1024 1 1 196 (rawNodes i) &&
    RawNatGrowthCheck.nodeCheck candidateMasks badMasks kindMasks keys rawKind quota
      (fun _ c => c) rawLeaves rawNodes i
def leafTest (i : Nat) : Bool :=
  listBounds 694 (rawLeaves i) &&
    WitnessGrowthDAG.closedCheck ridgeList ((rawLeaves i).map (Fin.ofNat 694))


def codes (i : Nat) : Nat :=
  let block := blocks.get (i / 128)
  let offset := PackedRawNatGrowth.take 32 (PackedRawNatGrowth.drop (32*(i%128)) block.offsets)
  PackedRawNatGrowth.drop offset block.payload
def countersTable : Table Nat :=
(.branch 1
 (.leaf )
 (.leaf ))
def counters (i : Nat) := PackedRawNatGrowth.take 25 (PackedRawNatGrowth.drop (25*(i%128)) (countersTable.get (i/128)))
def maskLookupTable : Table Nat :=
(.branch 2
 (.branch 1
 (.leaf )
 (.leaf ))
 (.branch 3
 (.leaf )
 (.leaf )))
def maskLookup (i : Nat) := PackedRawNatGrowth.take 694 (PackedRawNatGrowth.drop (694*(i%64)) (maskLookupTable.get (i/64)))
def selectedMasks (i : Nat) : Nat :=
  if i < 196 then maskLookup i else StreamingRawGrowth.nodeMask widths (codes i)
def maskTest (i : Nat) := decide (selectedMasks i = StreamingRawGrowth.nodeMask widths (codes i))
def fastTest (i : Nat) : Bool :=
  CachedMaskGrowth.countedCheck widths 694 1024 1 1 196
    candidateMasks badMasks kindMasks keys rawKind quota (fun _ c => c)
    rawLeaves codes counters selectedMasks i

end Papers.RationalityTen.PackedReplay.PackedSevenMixed008
