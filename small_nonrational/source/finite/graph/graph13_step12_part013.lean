noncomputable def fastTest (i : Nat) : Bool := (List.finRange 45).all fun edge =>
  Graph13FastEdgeMaps.extensionCheck
    (Papers.RationalityTen.GraphCatalogue.Generated.Graph13.Level12.entry (Fin.ofNat 8333 i)) Papers.RationalityTen.GraphCatalogue.Generated.Graph13.Level13.entry edge
    (choiceAt (lookup i) edge)
theorem fastTest_eq (i : Nat) : fastTest i = test i := by
  unfold fastTest test
  apply congrArg (fun f : Fin 45 → Bool => (List.finRange 45).all f)
  funext edge
  exact Graph13FastEdgeMaps.extensionCheck_eq _ _ _ _

theorem fast_interval (lo count : Nat)
    (h : checkRange fastTest lo count = true) : Interval test lo (lo+count) := by
  intro i hlo hhi
  rw [← fastTest_eq]
  exact checkRange_sound fastTest lo count h i hlo hhi

