theorem pairMasks_exact : pairMasks = (List.finRange 120).map TenGraphTriangles.pairs := by
  decide +kernel

def count (complement : Nat) : Nat :=
  (pairMasks.filter fun mask => decide (Nat.land complement mask = 0)).length

theorem count_eq (complement : Nat) : count complement = TenGraphTriangles.count complement := by
  rw [count, pairMasks_exact, List.filter_map, List.length_map]
  rfl

