def rawWords (i : Nat) : List Nat :=
  let code := PackedRawNatGrowth.take 48
    (PackedRawNatGrowth.drop (48*(i%64)) (wordTable.get (i/64)))
  ((PackedRawNatGrowth.readList 3 (PackedRawNatGrowth.take 4 code)
    (PackedRawNatGrowth.drop 4 code)).1).map (fun g => g % 7)
def rawGenerators (g c : Nat) : Nat :=
  ((generatorTable.get g >>> (12 * c)) % 4096) % 3436
def rawMaps (frame cell : Nat) : Nat :=
  CheckedGraphGrowthWords.rawApply rawGenerators (rawWords frame) cell
def forward (g : Fin 7) := packedCellMap (n := 3436) (by decide) 12 (generatorTable.get g.val)
def vertices (g : Fin 7) := TenGraphEdges.vertexMap (vertexTable.get g.val)
def words (frame : Fin 1440) : List (Fin 7) :=
  (rawWords frame.val).map (Fin.ofNat 7)
theorem word_bounds (i : Nat) : RawNatGrowthSoundness.listBounds 7 (rawWords i) = true := by
  apply List.all_eq_true.mpr
  intro a ha
  obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
  exact decide_eq_true (Nat.mod_lt b (by decide))
theorem raw_words_exact (frame : Fin 1440) :
    rawWords frame.val = (words frame).map Fin.val :=
  (RawNatGrowthSoundness.val_decode_list _ (word_bounds frame.val)).symm
theorem vertex_checks (g : Fin 7) :
    TenGraphEdges.permutationCheck (vertexTable.get g.val) (vertexTable.get g.val) = true := by
  have h : ∀ g : Fin 7, TenGraphEdges.permutationCheck
      (vertexTable.get g.val) (vertexTable.get g.val) = true := by decide +kernel
  exact h g
noncomputable def cellTest (g i : Nat) : Bool :=
  let generator := Fin.ofNat 7 g
  let cell := Fin.ofNat 3436 i
  inverseCheckAt (forward generator) (forward generator) cell &&
    cellRelabelCheck (vertices generator) (FacetUniverses.Small.cells cell)
      (FacetUniverses.Small.cells (forward generator cell))
theorem raw_generators_exact (g : Fin 7) (c : Fin 3436) :
    rawGenerators g.val c.val = (forward g c).val := rfl
end Papers.RationalityTen.RootedSmallGeneratorWords
