    intro i; fin_cases i <;> intro q t <;>
      simp [factor0, evalRat, axisSlope] <;> ring
  apply AlgebraicChartDensity.multiaffine_density_of_affine_bezout factor0
    haffine x hx (![![0, 1, 1]]) (![-(1)])
