/- Source: FiniteSixFacetKinds.lean -/





@[expose] public section

/-!
# Finite facet kinds and exact rooted metadata

This module contains only finite cells and numerical metadata. All geometric
claims connecting these profiles to actual faces are proved by the actual
facet adapters; literal universe checks can import this small module alone.
-/

namespace Papers.RationalityTen.SixFacetProfileRefinement
open Finset
open MatroidChecked.FacetBoundaryEncoding
open CellFacetInvariants LiteralMaskGeometry

inductive Kind where
  | tetrahedron
  | bipyramid
  | squarePyramid
  | six (i : Fin 7)
  deriving DecidableEq, Fintype

namespace Kind

def size : Kind → ℕ
  | .tetrahedron => 4
  | .bipyramid | .squarePyramid => 5
  | .six _ => 6

def quadrilaterals : Kind → ℕ
  | .tetrahedron | .bipyramid => 0
  | .squarePyramid => 1
  | .six i => ![0, 1, 0, 1, 0, 2, 3] i

def pentagons : Kind → ℕ
  | .six i => if i = 4 then 1 else 0
  | _ => 0

end Kind

/-- The type counts retain both pairs of six-vertex types with the same
polygon-size profile, so the later finite search loses no combinatorial type. -/
structure Counts where
  T : ℕ
  BP : ℕ
  SP : ℕ
  six : Fin 7 → ℕ

namespace RawEncoding

/-- The producer's old six-template order, transported to the complete
local catalogue used by the geometric classification and numerical rows. -/
def oldToCurrent : Fin 7 ≃ Fin 7 where
  toFun := ![0, 1, 5, 3, 2, 6, 4]
  invFun := ![0, 1, 4, 3, 6, 2, 5]
  left_inv := by decide +kernel
  right_inv := by decide +kernel

/-- Positive tags are tetrahedron, bipyramid, square pyramid, followed by
the seven six-vertex types in the producer's order. Zero is reserved for
the distinguished root. -/
def tag : Kind → ℕ
  | .tetrahedron => 1
  | .bipyramid => 2
  | .squarePyramid => 3
  | .six i => 4 + (oldToCurrent.symm i).val

theorem tag_injective : Function.Injective tag := by decide +kernel
theorem tag_ne_zero : ∀ a : Kind, tag a ≠ 0 := by decide +kernel
theorem tag_le_ten : ∀ a : Kind, tag a ≤ 10 := by decide +kernel

def decodeKind (rootType : Fin 7) : ℕ → Kind
  | 0 => .six (oldToCurrent rootType)
  | 1 => .tetrahedron
  | 2 => .bipyramid
  | 3 => .squarePyramid
  | k + 4 => if h : k < 7 then .six (oldToCurrent ⟨k, h⟩) else .tetrahedron

theorem tag_decodeKind (rootType : Fin 7) (k : ℕ) (hzero : k ≠ 0) (hle : k ≤ 10) :
    tag (decodeKind rootType k) = k := by
  have hcases : k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨
      k = 6 ∨ k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 := by omega
  rcases hcases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl

theorem decodeKind_six (rootType i : Fin 7) :
    decodeKind rootType (4 + i.val) = .six (oldToCurrent i) := by
  rw [Nat.add_comm]
  simp only [decodeKind, dif_pos i.isLt]

end RawEncoding

def Counts.count (C : Counts) : Kind → ℕ
  | .tetrahedron => C.T
  | .bipyramid => C.BP
  | .squarePyramid => C.SP
  | .six i => C.six i

/-- Rooted quotas in exactly the producer's tag convention. The subtraction
is on the actual root type; all remaining six-type counts retain their
complete combinatorial distinction. -/
def Counts.rootedQuota (C : Counts) (rootType : Fin 7) (k : ℕ) : ℕ :=
  if k = 0 then 1 else if k ≤ 10 then
    C.count (RawEncoding.decodeKind rootType k) -
      (if RawEncoding.decodeKind rootType k = .six (RawEncoding.oldToCurrent rootType)
        then 1 else 0)
  else 0

@[simp] theorem Counts.rootedQuota_zero (C : Counts) (r : Fin 7) :
    C.rootedQuota r 0 = 1 := rfl

@[simp] theorem Counts.rootedQuota_tetrahedron (C : Counts) (r : Fin 7) :
    C.rootedQuota r 1 = C.T := by simp [Counts.rootedQuota, RawEncoding.decodeKind, Counts.count]

@[simp] theorem Counts.rootedQuota_bipyramid (C : Counts) (r : Fin 7) :
    C.rootedQuota r 2 = C.BP := by simp [Counts.rootedQuota, RawEncoding.decodeKind, Counts.count]

@[simp] theorem Counts.rootedQuota_squarePyramid (C : Counts) (r : Fin 7) :
    C.rootedQuota r 3 = C.SP := by simp [Counts.rootedQuota, RawEncoding.decodeKind, Counts.count]

@[simp] theorem Counts.rootedQuota_six (C : Counts) (r i : Fin 7) :
    C.rootedQuota r (4 + i.val) =
      C.six (RawEncoding.oldToCurrent i) - (if i = r then 1 else 0) := by
  have hzero : 4 + i.val ≠ 0 := by omega
  have hle : 4 + i.val ≤ 10 := by omega
  simp only [Counts.rootedQuota, if_neg hzero, if_pos hle,
    RawEncoding.decodeKind_six, Counts.count, Kind.six.injEq,
    RawEncoding.oldToCurrent.injective.eq_iff]

/-- A finite literal check identifies each candidate's exact size profile
and kind tag. The unique tag-zero candidate is the distinguished root. -/
def RawProfileCheck {c : ℕ} (cells : Fin c → ConcreteGrowth.Cell)
    (rootType : Fin 7) (root i : Fin c) : Prop :=
  (cells i).kind ≤ 10 ∧ ((cells i).kind = 0 ↔ i = root) ∧
    (decodeCell (cells i)).vertices.card = (RawEncoding.decodeKind rootType (cells i).kind).size ∧
    cellRidgeSizeCount (decodeCell (cells i)) 4 =
      (RawEncoding.decodeKind rootType (cells i).kind).quadrilaterals ∧
    cellRidgeSizeCount (decodeCell (cells i)) 5 =
      (RawEncoding.decodeKind rootType (cells i).kind).pentagons ∧
    cellExcess (decodeCell (cells i)) =
      ((RawEncoding.decodeKind rootType (cells i).kind).quadrilaterals : ℤ) +
        2 * (RawEncoding.decodeKind rootType (cells i).kind).pentagons

instance {c : ℕ} (cells : Fin c → ConcreteGrowth.Cell)
    (rootType : Fin 7) (root i : Fin c) :
    Decidable (RawProfileCheck cells rootType root i) := by
  unfold RawProfileCheck
  infer_instance

end Papers.RationalityTen.SixFacetProfileRefinement

end
