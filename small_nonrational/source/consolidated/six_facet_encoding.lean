/- Source: SixFacetProfileRefinement.lean -/








@[expose] public section

/-!
# Exact local profiles for the complete all-six-facet budget

The ten local kinds consist of a tetrahedron, the two five-vertex types,
and all seven six-vertex types. Their numbers of quadrilateral and
pentagonal polygons are checked against the complete literal boundaries.
The actual local classification then supplies a kind for every facet.
-/

noncomputable section
namespace Papers.RationalityTen.SixFacetProfileRefinement

open Finset Set
open scoped Classical BigOperators
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes Papers.PolytopeFaceCounting Papers.PolytopeIncidenceCounting
open Papers.PolytopeFacetSurplus Papers.PolytopeRelationBudget
open ChirotopeDensity ActualSmallFacetClassification ActualFacetCatalogueTransport
open MatroidChecked.FacetBoundaryEncoding CellFacetInvariants

/-- Count each actual polygon size directly from its complete facet cell. -/
theorem actualCell_ridge_size_count {d n : ℕ} (P : ConvexPolytope d)
    (lab : P.vertices ≃ Fin n) (F : Face P 3) (k : ℕ) :
    cellRidgeSizeCount (actualCell P lab F) k = facetPolygonSizeCount P F k := by
  unfold cellRidgeSizeCount
  change ((((Finset.univ : Finset (Face P 2)).filter fun R =>
    R.val.carrier ⊆ F.val.carrier).image (faceLabels P lab)).filter fun S => S.card = k).card = _
  rw [Finset.filter_image, Finset.card_image_of_injective _ (faceLabels_injective P lab),
    Finset.filter_filter]
  have hcard (R : Face P 2) : (faceLabels P lab R).card =
      Nat.card (VerticesOn P R.val.carrier) := ActualFaceTransport.labels_card P lab R
  simp_rw [hcard]
  symm
  unfold facetPolygonSizeCount
  apply Finset.card_bij (fun R _ => R.val)
  · intro R hR
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hR ⊢
    exact ⟨R.property, hR⟩
  · intro R _ S _ h
    exact Subtype.ext h
  · intro R hR
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hR
    exact ⟨⟨R, hR.1⟩, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hR.2⟩, rfl⟩

namespace Kind

def template : (a : Kind) → Finset (PolygonBoundaryCatalogue.Polygon a.size)
  | .tetrahedron => FiniteCycleCandidates.N4.templates 0
  | .bipyramid => FiniteCycleCandidates.N5.templates 0
  | .squarePyramid => FiniteCycleCandidates.N5.templates 1
  | .six i => FiniteCycleCandidates.N6.templates i

/-- The complete literal polygons determine all local numerical data. -/
theorem template_profile : ∀ a : Kind,
    (cellOfBoundary a.template).vertices.card = a.size ∧
    cellRidgeSizeCount (cellOfBoundary a.template) 4 = a.quadrilaterals ∧
    cellRidgeSizeCount (cellOfBoundary a.template) 5 = a.pentagons ∧
    cellExcess (cellOfBoundary a.template) = (a.quadrilaterals : ℤ) + 2 * a.pentagons := by
  decide +kernel

def enumerate : Fin 10 → Kind :=
  ![.tetrahedron, .bipyramid, .squarePyramid,
    .six 0, .six 1, .six 2, .six 3, .six 4, .six 5, .six 6]

theorem enumerate_bijective : Function.Bijective enumerate := by decide +kernel

theorem sum_eq (f : Kind → ℕ) :
    (∑ a : Kind, f a) = f .tetrahedron + f .bipyramid + f .squarePyramid +
      ∑ i : Fin 7, f (.six i) := by
  rw [← enumerate_bijective.sum_comp f]
  simp [enumerate, Fin.sum_univ_succ] <;> omega

end Kind

def Matches {d : ℕ} (P : ConvexPolytope d) (F : Face P 3) (a : Kind) : Prop :=
  facetVertexCount P F = a.size ∧
  facetPolygonSizeCount P F 4 = a.quadrilaterals ∧
  facetPolygonSizeCount P F 5 = a.pentagons ∧
  facetPolygonExcess P F = (a.quadrilaterals : ℤ) + 2 * a.pentagons

theorem matches_of_template {d n : ℕ} (P : ConvexPolytope d)
    (lab : P.vertices ≃ Fin n) (F : Face P 3) (a : Kind)
    (loc : (facePolytope P F.val.isFace).vertices ≃ Fin a.size)
    (h : polygonBoundary (facePolytope P F.val.isFace) loc = a.template) :
    Matches P F a := by
  have hc := actualCell_of_template P lab F loc a.template h
  have hv := congrArg (fun C => C.vertices.card) hc
  have hq := congrArg (fun C => cellRidgeSizeCount C 4) hc
  have hp := congrArg (fun C => cellRidgeSizeCount C 5) hc
  have hg := congrArg cellExcess hc
  rw [actualCell_vertex_card, mapCell_vertex_card, (Kind.template_profile a).1] at hv
  rw [actualCell_ridge_size_count, mapCell_ridge_size_count,
    (Kind.template_profile a).2.1] at hq
  rw [actualCell_ridge_size_count, mapCell_ridge_size_count,
    (Kind.template_profile a).2.2.1] at hp
  rw [actualCell_excess, mapCell_excess, (Kind.template_profile a).2.2.2] at hg
  exact ⟨hv, hq, hp, hg⟩

/-- Every actual three-face on at most six vertices receives one of the ten
complete local kinds, with no conditional catalogue-coverage premise. -/
theorem actual_facet_matches_kind {d n : ℕ} (P : ConvexPolytope d)
    (lab : P.vertices ≃ Fin n) (F : Face P 3) (hF : facetVertexCount P F ≤ 6) :
    ∃ a : Kind, Matches P F a := by
  let Q := facePolytope P F.val.isFace
  have hQ : Q.dim = 3 := by
    change faceDim Q.toSet = 3
    rw [facePolytope_toSet]
    exact F.property
  have hc : Q.vertices.card = facetVertexCount P F := by
    simpa only [facetVertexCount, Nat.card_eq_fintype_card, Fintype.card_coe] using
      (Nat.card_congr (faceVerticesEquiv P F.val.isFace)).symm
  have hmin : 4 ≤ facetVertexCount P F :=
    Nat.succ_le_iff.mpr (Papers.PolytopeThreeIncidences.face_vertex_card_gt_dimension P 3 F)
  have hcases : facetVertexCount P F = 4 ∨ facetVertexCount P F = 5 ∨
      facetVertexCount P F = 6 := by omega
  rcases hcases with h4 | h5 | h6
  · obtain ⟨loc, i, hi⟩ := four_vertex_classification Q hQ (hc.trans h4)
    have hi0 : i = 0 := Fin.eq_zero i
    subst i
    exact ⟨.tetrahedron, matches_of_template P lab F .tetrahedron loc hi⟩
  · obtain ⟨loc, i, hi⟩ := five_vertex_classification Q hQ (hc.trans h5)
    have hcases : i = 0 ∨ i = 1 := by omega
    rcases hcases with rfl | rfl
    · exact ⟨.bipyramid, matches_of_template P lab F .bipyramid loc hi⟩
    · exact ⟨.squarePyramid, matches_of_template P lab F .squarePyramid loc hi⟩
  · obtain ⟨loc, i, hi⟩ := six_vertex_classification Q hQ (hc.trans h6)
    exact ⟨.six i, matches_of_template P lab F (.six i) loc hi⟩

/-- A simultaneous complete assignment, used only to count the actual kinds. -/
theorem actual_kind_assignment {d n : ℕ} (P : ConvexPolytope d)
    (lab : P.vertices ≃ Fin n)
    (hfacets : ∀ F : Face P 3, facetVertexCount P F ≤ 6) :
    ∃ kind : Face P 3 → Kind, ∀ F, Matches P F (kind F) := by
  choose kind hk using fun F => actual_facet_matches_kind P lab F (hfacets F)
  exact ⟨kind, hk⟩

def kindCount {d : ℕ} (P : ConvexPolytope d) (kind : Face P 3 → Kind) (a : Kind) : ℕ :=
  (Finset.univ.filter fun F => kind F = a).card

def countsOf {d : ℕ} (P : ConvexPolytope d) (kind : Face P 3 → Kind) : Counts where
  T := kindCount P kind .tetrahedron
  BP := kindCount P kind .bipyramid
  SP := kindCount P kind .squarePyramid
  six i := kindCount P kind (.six i)

def Counts.Refines (C : Counts) (B : AllSixFacetBudget) : Prop :=
  B.L = ∑ i, C.six i ∧
  B.t = C.six 6 ∧
  2 * B.p = C.six 4 ∧
  2 * B.q = C.SP + C.six 1 + C.six 3 + 2 * C.six 5 + 3 * C.six 6 ∧
  B.E = C.BP + C.SP + 2 * B.L ∧
  B.m = C.T + C.BP + C.SP + B.L

/-- Counting the exact local profiles produces every equality used in the
478-row numerical enumeration, including the even pentagonal-facet count. -/
theorem counts_refine_actual {d : ℕ} (P : ConvexPolytope d) (hP : P.dim = 4)
    (kind : Face P 3 → Kind) (hk : ∀ F, Matches P F (kind F)) :
    (countsOf P kind).Refines (actualAllSixFacetBudget P) := by
  let C := countsOf P kind
  have hweighted (w : Kind → ℕ) :
      (∑ a : Kind, kindCount P kind a * w a) = ∑ F : Face P 3, w (kind F) := by
    exact FacetCapacityBounds.sum_kind_weights Finset.univ kind w
  have hm : Nat.card (Face P 3) = C.T + C.BP + C.SP + ∑ i, C.six i := by
    have h := hweighted (fun _ => 1)
    rw [Kind.sum_eq] at h
    simpa only [mul_one, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
      ← Nat.card_eq_fintype_card, Nat.cast_id, C, countsOf] using h.symm
  have hN : (nonsimplicialFacets P).card = C.BP + C.SP + ∑ i, C.six i := by
    have h := hweighted (fun a => if 4 < a.size then 1 else 0)
    have hp (F : Face P 3) : (if 4 < (kind F).size then (1 : ℕ) else 0) =
        if F ∈ nonsimplicialFacets P then 1 else 0 := by
      simp only [mem_nonsimplicialFacets, (hk F).1]
    simp_rw [hp] at h
    have hs : (∑ F : Face P 3, if F ∈ nonsimplicialFacets P then (1 : ℕ) else 0) =
        (nonsimplicialFacets P).card := by
      simp only [Finset.sum_boole, Finset.filter_mem_eq_inter, Finset.univ_inter, Nat.cast_id]
    rw [hs] at h
    rw [Kind.sum_eq] at h
    simpa [Kind.size, C, countsOf] using h.symm
  have hL : (sixVertexFacets P).card = ∑ i, C.six i := by
    have h := hweighted (fun a => if a.size = 6 then 1 else 0)
    have hp (F : Face P 3) : (if (kind F).size = 6 then (1 : ℕ) else 0) =
        if F ∈ sixVertexFacets P then 1 else 0 := by
      simp only [sixVertexFacets, Finset.mem_filter, Finset.mem_univ, true_and, (hk F).1]
    simp_rw [hp] at h
    rw [Kind.sum_eq] at h
    simpa [Kind.size, C, countsOf] using h.symm
  have ht : (threeExcessFacets P).card = C.six 6 := by
    have hshape : ∀ a : Kind,
        (a.quadrilaterals : ℤ) + 2 * a.pentagons = 3 ↔ a = .six 6 := by decide +kernel
    have heq : threeExcessFacets P = Finset.univ.filter (fun F => kind F = .six 6) := by
      ext F
      simp only [threeExcessFacets, Finset.mem_filter, Finset.mem_univ, true_and,
        (hk F).2.2.2, hshape]
    rw [heq]
    rfl
  have hp : 2 * (pentagonalFaces P).card = C.six 4 := by
    have h := hweighted Kind.pentagons
    have hlocal (F : Face P 3) : (kind F).pentagons = facetPolygonSizeCount P F 5 :=
      (hk F).2.2.1.symm
    simp_rw [hlocal] at h
    have hsumZ := sum_facet_polygon_size_counts P hP 5
    have hsum : (∑ F : Face P 3, facetPolygonSizeCount P F 5) =
        2 * (pentagonalFaces P).card := by exact_mod_cast hsumZ
    rw [hsum, Kind.sum_eq] at h
    simpa [Kind.pentagons, C, countsOf, Fin.sum_univ_succ] using h.symm
  have hq : 2 * (quadrilateralFaces P).card =
      C.SP + C.six 1 + C.six 3 + 2 * C.six 5 + 3 * C.six 6 := by
    have h := hweighted Kind.quadrilaterals
    have hlocal (F : Face P 3) : (kind F).quadrilaterals = facetPolygonSizeCount P F 4 :=
      (hk F).2.1.symm
    simp_rw [hlocal] at h
    have hsumZ := sum_facet_polygon_size_counts P hP 4
    have hsum : (∑ F : Face P 3, facetPolygonSizeCount P F 4) =
        2 * (quadrilateralFaces P).card := by exact_mod_cast hsumZ
    rw [hsum, Kind.sum_eq] at h
    simp [Kind.quadrilaterals, Fin.sum_univ_succ] at h
    dsimp only [C, countsOf] at h ⊢
    omega
  change (sixVertexFacets P).card = (∑ i, C.six i) ∧
    (threeExcessFacets P).card = C.six 6 ∧
    2 * (pentagonalFaces P).card = C.six 4 ∧
    2 * (quadrilateralFaces P).card =
      C.SP + C.six 1 + C.six 3 + 2 * C.six 5 + 3 * C.six 6 ∧
    (nonsimplicialFacets P).card + (sixVertexFacets P).card =
      C.BP + C.SP + 2 * (sixVertexFacets P).card ∧
    Nat.card (Face P 3) = C.T + C.BP + C.SP + (sixVertexFacets P).card
  exact ⟨hL, ht, hp, hq, by omega, by omega⟩

/-- Actual complete numerical reduction to seven six-vertex type counts.
All shape and incidence facts are established before any finite search. -/
theorem actual_all_six_type_budget {n : ℕ}
    (P : ConvexPolytope 4) (hP : P.IsFullDim) (e : Fin n ≃ P.vertices)
    (hn : P.vertices.card = 10) (hN : 10 ≤ (nonsimplicialFacets P).card)
    (hc : 9 ≤ Fintype.card (SparseSharedRowIndex P e))
    (hfacets : ∀ F : Face P 3, facetVertexCount P F ≤ 6)
    (hsix : (sixVertexFacets P).Nonempty) :
    ∃ C : Counts, C.Refines (actualAllSixFacetBudget P) ∧
      (actualAllSixFacetBudget P).Admissible := by
  obtain ⟨kind, hk⟩ := actual_kind_assignment P e.symm hfacets
  exact ⟨countsOf P kind, counts_refine_actual P hP kind hk,
    actual_all_six_budget_admissible P hP e hn hN hc hfacets hsix⟩

end Papers.RationalityTen.SixFacetProfileRefinement

end
