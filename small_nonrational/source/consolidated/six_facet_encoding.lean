@[expose] public section

/-!
# Complete actual coverage for the small-plus-six0 universe

The first 6,510 records reuse the complete small-facet universe. The other
37,800 records are the complete embeddings of the six-vertex template of
index zero. Both coverage and record validity come from the same checked
injection table. The actual count vector retains full template labelings.
-/

noncomputable section
namespace Papers.RationalityTen.FacetUniverses.FullSix0

open Finset
open scoped Classical
open LiteralMaskGeometry ActualFacetCatalogueTransport CellFacetInvariants

theorem cells_wellFormed (i : Fin cellCount) : WellFormed (cells i) := by
  have hibound : i.val < 44310 := i.isLt
  by_cases hi : i.val < 6510
  · let j : Fin 6510 := ⟨i.val, hi⟩
    have hij : Fin.castLE (show 6510 ≤ cellCount by decide) j = i := Fin.ext rfl
    rw [← hij, cells_small]
    exact FullSmall.cells_wellFormed j
  · let j : Fin 37800 := ⟨i.val - 6510, by omega⟩
    have hij : (⟨6510 + j.val, by change 6510 + j.val < 44310; omega⟩ : Fin cellCount) = i := by
      apply Fin.ext
      dsimp only [j]
      omega
    rw [← hij]
    exact FullSix0FacetEmbedding.canonical_wellFormed j

theorem cells_kind_correct (i : Fin cellCount) :
    FullSix0FacetTargetBudgets.KindCheck cells i := by
  have hibound : i.val < 44310 := i.isLt
  unfold FullSix0FacetTargetBudgets.KindCheck
  by_cases hi : i.val < 6510
  · let j : Fin 6510 := ⟨i.val, hi⟩
    have hij : Fin.castLE (show 6510 ≤ cellCount by decide) j = i := Fin.ext rfl
    rw [← hij, cells_small]
    have hsize := FullSmall.cells_vertex_card_le_five j
    have hsix : (decodeCell (FullSmall.cells j)).vertices.card ≠ 6 := by omega
    rw [if_neg hsix]
    exact FullSmall.cells_kind_correct j
  · let j : Fin 37800 := ⟨i.val - 6510, by omega⟩
    have hij : (⟨6510 + j.val, by change 6510 + j.val < 44310; omega⟩ : Fin cellCount) = i := by
      apply Fin.ext
      dsimp only [j]
      omega
    rw [← hij, suffix_kind]
    have hsize : (decodeCell (cells
        ⟨6510 + j.val, by change 6510 + j.val < 44310; omega⟩)).vertices.card = 6 := by
      rw [FullSix0FacetEmbedding.canonical_decoded, mapCell_vertex_card]
      change (Finset.univ : Finset (Fin 6)).card = 6
      simp only [Finset.card_univ, Fintype.card_fin]
    rw [hsize, if_pos rfl]

theorem cells_kind_lt_five (i : Fin cellCount) : (cells i).kind < 5 := by
  have h := cells_kind_correct i
  unfold FullSix0FacetTargetBudgets.KindCheck at h
  split_ifs at h <;> omega

end Papers.RationalityTen.FacetUniverses.FullSix0

namespace Papers.RationalityTen.FullSix0FacetActualCoverage

open Finset Set
open scoped Classical
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes Papers.PolytopeFaceCounting Papers.PolytopeFacetSurplus
open ChirotopeDensity MatroidChecked.FacetBoundaryEncoding
open LiteralMaskGeometry ActualFacetCatalogueTransport ActualFacetTemplateAssignment
open SixFacetProfileRefinement

/-- Vanishing of the other six-type classes supplies genuine local
template coverage, not merely agreement of face-count profiles. -/
theorem covers_facet {d : ℕ} (P : ConvexPolytope d) (lab : P.vertices ≃ Fin 10)
    (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0)
    (F : Face P 3) :
    ∃ i, decodeCell (FacetUniverses.FullSix0.cells i) = actualCell P lab F := by
  rcases A.only_six_zero lab hcounts F with hsmall | hsix
  · obtain ⟨j, hj⟩ := FullSmallFacetActualCoverage.covers_facet P lab F hsmall
    refine ⟨Fin.castLE (by decide) j, ?_⟩
    rw [FacetUniverses.FullSix0.cells_small]
    exact hj
  · obtain ⟨loc, hloc⟩ := hsix
    have hcell := actualCell_of_template P lab F loc (Kind.template (.six 0)) hloc
    obtain ⟨j, hj⟩ := FullSix0FacetEmbedding.covers
      (ActualFaceTransport.labelEmbedding P lab F loc)
    exact ⟨j, hj.trans hcell.symm⟩

theorem encoding_exists {d : ℕ} (P : ConvexPolytope d) (lab : P.vertices ≃ Fin 10)
    (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0) :
    Nonempty (Encoding P lab (fun i => decodeCell (FacetUniverses.FullSix0.cells i))) :=
  encoding_of_coverage P lab _ (covers_facet P lab A hcounts)

/-- The resulting full-universe target has exactly the actual type counts.
This is the input used before the checked induced-graph subuniverse filter. -/
theorem encoding_with_exact_counts {d : ℕ}
    (P : ConvexPolytope d) (lab : P.vertices ≃ Fin 10) (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0) :
    ∃ E : Encoding P lab (fun i => decodeCell (FacetUniverses.FullSix0.cells i)),
      ∀ j : Fin 5,
        (E.family.filter fun i => (FacetUniverses.FullSix0.cells i).kind = j.val).card =
          FullSix0FacetTargetBudgets.quota (countsOf P A.kind) j.val := by
  obtain ⟨E⟩ := encoding_exists P lab A hcounts
  exact ⟨E, FullSix0FacetTargetBudgets.actual_quota_counts
    FacetUniverses.FullSix0.cells E A hcounts FacetUniverses.FullSix0.cells_kind_correct⟩

end Papers.RationalityTen.FullSix0FacetActualCoverage

end
