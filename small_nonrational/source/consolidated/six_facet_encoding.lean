@[expose] public section

/-!
# Actual six-facet budgets belong to the exhaustive numerical enumerator

The conversion records all seven type counts explicitly. The proofs below
recover the natural-number subtractions for tetrahedra, bipyramids, and square
pyramids from exact count equations, so truncated subtraction introduces no
spurious geometric assumption.
-/

namespace Papers.RationalityTen.SixFacetProfileRefinement

open Finset
open scoped BigOperators
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes Papers.PolytopeFaceCounting Papers.PolytopeFacetSurplus
open ChirotopeDensity
open SixBudgetEnumeration

def Counts.toRow (C : Counts) (B : AllSixFacetBudget) : Row where
  m := B.m
  E := B.E
  q := B.q
  types := [C.six 0, C.six 1, C.six 2, C.six 3, C.six 4, C.six 5, C.six 6]

theorem Counts.toRow_L (C : Counts) (B : AllSixFacetBudget) :
    (C.toRow B).L = ∑ i, C.six i := by
  simp [Counts.toRow, Row.L, Fin.sum_univ_succ] <;> omega

/-- The catalogue's derived counts equal the original actual counts. -/
theorem Counts.toRow_counts (C : Counts) (B : AllSixFacetBudget) (h : C.Refines B) :
    (C.toRow B).L = B.L ∧ (C.toRow B).t = B.t ∧ (C.toRow B).p = B.p ∧
    (C.toRow B).SP = C.SP ∧ (C.toRow B).BP = C.BP ∧ (C.toRow B).T = C.T := by
  rcases h with ⟨hL, ht, hp, hq, hE, hm⟩
  have hrL : (C.toRow B).L = B.L := (C.toRow_L B).trans hL.symm
  have hrt : (C.toRow B).t = B.t := ht.symm
  have hrp : (C.toRow B).p = B.p := by
    change C.six 4 / 2 = B.p
    omega
  have hrs : (C.toRow B).SP = C.SP := by
    change 2 * B.q - (C.six 1 + C.six 3 + 2 * C.six 5 + 3 * C.six 6) = C.SP
    omega
  have hrb : (C.toRow B).BP = C.BP := by
    unfold Row.BP
    rw [hrL, hrs]
    change B.E - 2 * B.L - C.SP = C.BP
    omega
  have hrT : (C.toRow B).T = C.T := by
    unfold Row.T
    rw [hrL]
    change B.m + B.L - B.E = C.T
    omega
  exact ⟨hrL, hrt, hrp, hrs, hrb, hrT⟩

theorem Counts.toRow_admissible (C : Counts) (B : AllSixFacetBudget)
    (h : C.Refines B) (hB : B.Admissible) : (C.toRow B).Admissible := by
  obtain ⟨hrL, hrt, hrp, hrs, _, _⟩ := C.toRow_counts B h
  rcases h with ⟨hL, ht, hp, hq, hE, hm⟩
  rcases hB with ⟨hBm, hBL, hBLE, hBE, hBmE, hBt, hBq, hBW⟩
  unfold Row.Admissible
  rw [hrL, hrt, hrp, hrs]
  change 7 = 7 ∧ 10 ≤ B.m ∧ 1 ≤ B.L ∧ B.L + 10 ≤ B.E ∧
    B.E ≤ B.m + B.L ∧ B.m + B.E ≤ 26 ∧ B.t ≤ B.L ∧
    C.six 4 = 2 * B.p ∧
    C.six 1 + C.six 3 + 2 * C.six 5 + 3 * C.six 6 ≤ 2 * B.q ∧
    C.SP + 2 * B.L ≤ B.E ∧ B.q + 2 * B.p + 9 ≤ B.E + B.t ∧
    2 * B.E + B.m + B.L ≤ 35 + B.q + 3 * B.p
  exact ⟨rfl, hBm, hBL, hBLE, hBE, hBmE, hBt, hp.symm,
    by omega, by omega, hBq, hBW⟩

/-- Every actual all-six residual has a row in the complete finite numerical
enumerator, with the actual small-facet counts recovered exactly. -/
theorem actual_six_budget_mem_enumeration {n : ℕ}
    (P : ConvexPolytope 4) (hP : P.IsFullDim) (e : Fin n ≃ P.vertices)
    (hn : P.vertices.card = 10) (hN : 10 ≤ (nonsimplicialFacets P).card)
    (hc : 9 ≤ Fintype.card (SparseSharedRowIndex P e))
    (hfacets : ∀ F : Face P 3, facetVertexCount P F ≤ 6)
    (hsix : (sixVertexFacets P).Nonempty) :
    ∃ C : Counts,
      C.Refines (actualAllSixFacetBudget P) ∧
      C.toRow (actualAllSixFacetBudget P) ∈ enumeratedRows ∧
      (C.toRow (actualAllSixFacetBudget P)).SP = C.SP ∧
      (C.toRow (actualAllSixFacetBudget P)).BP = C.BP ∧
      (C.toRow (actualAllSixFacetBudget P)).T = C.T := by
  obtain ⟨C, hC, hB⟩ := actual_all_six_type_budget P hP e hn hN hc hfacets hsix
  have hcounts := C.toRow_counts (actualAllSixFacetBudget P) hC
  refine ⟨C, hC, enumerated_complete _ (C.toRow_admissible _ hC hB), ?_⟩
  exact hcounts.2.2.2

/-- The concrete 478 rows, rather than an unevaluated search expression,
cover every actual all-six residual with exactly its actual facet counts. -/
theorem actual_six_budget_mem_catalogue {n : ℕ}
    (P : ConvexPolytope 4) (hP : P.IsFullDim) (e : Fin n ≃ P.vertices)
    (hn : P.vertices.card = 10) (hN : 10 ≤ (nonsimplicialFacets P).card)
    (hc : 9 ≤ Fintype.card (SparseSharedRowIndex P e))
    (hfacets : ∀ F : Face P 3, facetVertexCount P F ≤ 6)
    (hsix : (sixVertexFacets P).Nonempty) :
    ∃ C : Counts,
      C.Refines (actualAllSixFacetBudget P) ∧
      C.toRow (actualAllSixFacetBudget P) ∈ catalogue ∧
      (C.toRow (actualAllSixFacetBudget P)).SP = C.SP ∧
      (C.toRow (actualAllSixFacetBudget P)).BP = C.BP ∧
      (C.toRow (actualAllSixFacetBudget P)).T = C.T := by
  rw [← enumerated_eq_catalogue]
  exact actual_six_budget_mem_enumeration P hP e hn hN hc hfacets hsix

end Papers.RationalityTen.SixFacetProfileRefinement

