noncomputable section
namespace Papers.RationalityTen.FullSix0FacetTargetBudgets

open Finset Set
open scoped Classical
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes Papers.PolytopeFaceCounting Papers.PolytopeFacetSurplus
open ChirotopeDensity MatroidChecked.FacetBoundaryEncoding
open LiteralMaskGeometry CellFacetInvariants SixFacetProfileRefinement
open ActualFacetTemplateAssignment

def KindCheck {c : ℕ} (cells : Fin c → ConcreteGrowth.Cell) (i : Fin c) : Prop :=
  (cells i).kind =
    if (decodeCell (cells i)).vertices.card = 6 then 4 else
      if 4 < (decodeCell (cells i)).vertices.card then
        if cellExcess (decodeCell (cells i)) = 1 then 3 else 2
      else 1

instance {c : ℕ} (cells : Fin c → ConcreteGrowth.Cell) (i : Fin c) :
    Decidable (KindCheck cells i) := by unfold KindCheck; infer_instance

def quota (C : Counts) : ℕ → ℕ
  | 1 => C.T
  | 2 => C.BP
  | 3 => C.SP
  | 4 => C.six 0
  | _ => 0

private theorem profile_tag : ∀ a : Kind, (a.size ≤ 5 ∨ a = .six 0) →
    (if a.size = 6 then 4 else if 4 < a.size then
      if (a.quadrilaterals : ℤ) + 2 * a.pentagons = 1 then 3 else 2
    else 1) = RawEncoding.tag a := by decide +kernel

theorem actual_kind {d c : ℕ} {P : ConvexPolytope d}
    {lab : P.vertices ≃ Fin 10} (cells : Fin c → ConcreteGrowth.Cell)
    (E : Encoding P lab (fun i => decodeCell (cells i)))
    (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0)
    (hcheck : ∀ i, KindCheck cells i) (F : Face P 3) :
    (cells (E.index F)).kind = RawEncoding.tag (A.kind F) := by
  have hi := hcheck (E.index F)
  unfold KindCheck at hi
  rw [E.index_spec, actualCell_vertex_card, actualCell_excess] at hi
  have hm := A.matches lab F
  rw [hm.1, hm.2.2.2] at hi
  have hallowed : (A.kind F).size ≤ 5 ∨ A.kind F = .six 0 := by
    cases hkind : A.kind F with
    | tetrahedron => exact Or.inl (by decide)
    | bipyramid => exact Or.inl (by decide)
    | squarePyramid => exact Or.inl (by decide)
    | six j =>
      have hj := A.six_index_zero hcounts F j hkind
      exact Or.inr (congrArg Kind.six hj)
  rw [profile_tag _ hallowed] at hi
  exact hi

theorem tagged_counts {d : ℕ} (P : ConvexPolytope d) (kind : Face P 3 → Kind)
    (j : Fin 5) :
    (Finset.univ.filter fun F => RawEncoding.tag (kind F) = j.val).card =
      quota (countsOf P kind) j.val := by
  fin_cases j
  · change (Finset.univ.filter fun F => RawEncoding.tag (kind F) = 0).card = 0
    apply Finset.card_eq_zero.mpr
    apply Finset.filter_eq_empty_iff.mpr
    intro F _
    exact RawEncoding.tag_ne_zero (kind F)
  · change (Finset.univ.filter fun F =>
        RawEncoding.tag (kind F) = RawEncoding.tag .tetrahedron).card =
      (Finset.univ.filter fun F => kind F = .tetrahedron).card
    simp only [RawEncoding.tag_injective.eq_iff]
  · change (Finset.univ.filter fun F =>
        RawEncoding.tag (kind F) = RawEncoding.tag .bipyramid).card =
      (Finset.univ.filter fun F => kind F = .bipyramid).card
    simp only [RawEncoding.tag_injective.eq_iff]
  · change (Finset.univ.filter fun F =>
        RawEncoding.tag (kind F) = RawEncoding.tag .squarePyramid).card =
      (Finset.univ.filter fun F => kind F = .squarePyramid).card
    simp only [RawEncoding.tag_injective.eq_iff]
  · change (Finset.univ.filter fun F =>
        RawEncoding.tag (kind F) = RawEncoding.tag (.six 0)).card =
      (Finset.univ.filter fun F => kind F = .six 0).card
    simp only [RawEncoding.tag_injective.eq_iff]

/-- The local graph checker's five kind slots have exactly the actual
counts, including the unused zero slot. -/
theorem actual_quota_counts {d c : ℕ} {P : ConvexPolytope d}
    {lab : P.vertices ≃ Fin 10} (cells : Fin c → ConcreteGrowth.Cell)
    (E : Encoding P lab (fun i => decodeCell (cells i)))
    (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0)
    (hcheck : ∀ i, KindCheck cells i) (j : Fin 5) :
    (E.family.filter fun i => (cells i).kind = j.val).card =
      quota (countsOf P A.kind) j.val := by
  rw [ActualGrowthTarget.encoded_kind_card]
  simp only [actual_kind cells E A hcounts hcheck]
  exact tagged_counts P A.kind j

end Papers.RationalityTen.FullSix0FacetTargetBudgets

end
