section BundlePart8
/- Source: SixZeroTriangleShapes.lean -/





@[expose] public section

/-!
# Triangle counts when the six-vertex facets have template zero

The additional template has eight triangular ridges. Each such facet
therefore contributes two more graph triangles after ridge pairing.
Together with the bipyramid equators this gives `2*m + 2*BP + 2*L`.
The special graph-conditioned numerical row uses `m=14`, `BP=5`, `L=1`.
-/

noncomputable section
namespace Papers.RationalityTen.SixZeroTriangleShapes

open Finset
open scoped BigOperators
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes Papers.PolytopeFaceCounting Papers.PolytopeIncidenceCounting
open Papers.PolytopeFacetSurplus
open MatroidChecked.FacetBoundaryEncoding MatroidChecked.BoundaryTriangleCount
open ActualFacetCatalogueTransport ActualFacetTemplateAssignment SixFacetProfileRefinement
open LiteralMaskGeometry CellFacetInvariants ActualFacetInducedGraph
open ActualGraphTriangleCount SmallFacetTriangleShapes

variable {m n : ℕ}

def MixedBipyramidPredicate (C : Cell n) : Prop :=
  C.vertices.card ≠ 6 ∧ BipyramidPredicate C

instance (C : Cell n) : Decidable (MixedBipyramidPredicate C) := by
  unfold MixedBipyramidPredicate
  infer_instance

structure SixTriangleShape (C : Cell n) : Prop where
  edges : ∀ R ∈ C.ridges, R.card = 3 → R.powersetCard 2 ⊆ C.edges
  count : cellRidgeSizeCount C 3 =
    4 + (if MixedBipyramidPredicate C then 2 else 0) +
      (if C.vertices.card = 6 then 4 else 0)
  base : MixedBipyramidPredicate C → ∃ T, BaseRules C T

theorem sixTriangleShape_of_small (C : Cell n) (h : TriangleShape C)
    (hne : C.vertices.card ≠ 6) : SixTriangleShape C := by
  refine ⟨h.edges, ?_, fun hB => h.base hB.2⟩
  simpa [MixedBipyramidPredicate, hne] using h.count

theorem sixTriangleShape_map (f : Fin m ↪ Fin n) (C : Cell m)
    (h : SixTriangleShape C) : SixTriangleShape (mapCell f C) := by
  refine ⟨?_, ?_, ?_⟩
  · intro R hR hcard
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hR
    rw [Finset.card_image_of_injective _ f.injective] at hcard
    rw [powersetCard_image]
    exact Finset.image_subset_image (h.edges S hS hcard)
  · calc
      cellRidgeSizeCount (mapCell f C) 3 = cellRidgeSizeCount C 3 :=
        mapCell_ridge_size_count f C 3
      _ = 4 + (if MixedBipyramidPredicate C then 2 else 0) +
          (if C.vertices.card = 6 then 4 else 0) := h.count
      _ = _ := by
        by_cases hB : MixedBipyramidPredicate C <;>
          by_cases h6 : C.vertices.card = 6 <;>
          simp only [MixedBipyramidPredicate, BipyramidPredicate,
            mapCell_vertex_card, mapCell_excess] at hB ⊢ <;>
          simp only [hB, h6, ite_true, ite_false]
  · intro hB
    have hB' : MixedBipyramidPredicate C := by
      simpa only [MixedBipyramidPredicate, BipyramidPredicate,
        mapCell_vertex_card, mapCell_excess] using hB
    obtain ⟨T, hT⟩ := h.base hB'
    exact ⟨T.image f, baseRules_map f C T hT⟩

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem six_zero_shape : SixTriangleShape
    (cellOfBoundary (FiniteCycleCandidates.N6.templates 0)) := by
  refine ⟨by decide +kernel, by decide +kernel, ?_⟩
  intro h
  exact False.elim ((show ¬ MixedBipyramidPredicate
    (cellOfBoundary (FiniteCycleCandidates.N6.templates 0)) by decide +kernel) h)

theorem actual_mixed_facet_shape {d : ℕ} (P : ConvexPolytope d)
    (lab : P.vertices ≃ Fin n) (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0)
    (F : Face P 3) : SixTriangleShape (actualCell P lab F) := by
  rcases A.only_six_zero lab hcounts F with hsmall | hsix
  · apply sixTriangleShape_of_small _ (actual_small_facet_shape P lab F hsmall)
    rw [actualCell_vertex_card]
    omega
  · obtain ⟨loc, hloc⟩ := hsix
    rw [actualCell_of_template P lab F loc (Kind.template (.six 0)) hloc]
    exact sixTriangleShape_map _ _ six_zero_shape

theorem mixed_kind_two_iff {c : ℕ} (cells : Fin c → ConcreteGrowth.Cell)
    (hkind : ∀ i, FullSix0FacetTargetBudgets.KindCheck cells i) (i : Fin c) :
    (cells i).kind = 2 ↔ MixedBipyramidPredicate (decodeCell (cells i)) := by
  have h := hkind i
  unfold FullSix0FacetTargetBudgets.KindCheck at h
  rw [h]
  unfold MixedBipyramidPredicate BipyramidPredicate
  by_cases hsix : (decodeCell (cells i)).vertices.card = 6 <;>
    by_cases hv : 4 < (decodeCell (cells i)).vertices.card <;>
    by_cases hx : cellExcess (decodeCell (cells i)) = 1 <;> simp [hsix, hv, hx]

theorem mixed_kind_four_iff {c : ℕ} (cells : Fin c → ConcreteGrowth.Cell)
    (hkind : ∀ i, FullSix0FacetTargetBudgets.KindCheck cells i) (i : Fin c) :
    (cells i).kind = 4 ↔ (decodeCell (cells i)).vertices.card = 6 := by
  have h := hkind i
  unfold FullSix0FacetTargetBudgets.KindCheck at h
  rw [h]
  by_cases hsix : (decodeCell (cells i)).vertices.card = 6 <;>
    by_cases hv : 4 < (decodeCell (cells i)).vertices.card <;>
    by_cases hx : cellExcess (decodeCell (cells i)) = 1 <;> simp [hsix, hv, hx]

/-- The weighted count follows from exact local facet shapes and actual
ridge pairing. Both selected subfamilies are ordinary literal kind classes. -/
theorem actual_six_zero_triangle_lower_bound {d c : ℕ} {P : ConvexPolytope d}
    {lab : P.vertices ≃ Fin 10} (cells : Fin c → ConcreteGrowth.Cell)
    (hwell : ∀ i, WellFormed (cells i))
    (hkind : ∀ i, FullSix0FacetTargetBudgets.KindCheck cells i)
    (E : Encoding P lab (fun i => decodeCell (cells i))) (hdim : P.dim = 4)
    (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0) :
    2 * E.family.card + 2 * (E.family.filter fun i => (cells i).kind = 2).card +
        2 * (E.family.filter fun i => (cells i).kind = 4).card ≤
      TenGraphTriangles.count (complementMask (literalGraphEdges cells E.family)) := by
  classical
  let C := fun i => decodeCell (cells i)
  let B := E.family.filter fun i => (cells i).kind = 2
  let H := E.family.filter fun i => (cells i).kind = 4
  have hBS : B ⊆ E.family := Finset.filter_subset _ _
  have hHS : H ⊆ E.family := Finset.filter_subset _ _
  have hshape (i : Fin c) (hi : i ∈ E.family) : SixTriangleShape (C i) := by
    obtain ⟨F, rfl⟩ := (E.mem_family i).mp hi
    dsimp only [C]
    rw [E.index_spec]
    exact actual_mixed_facet_shape P lab A hcounts F
  have hbase (i : Fin c) (hi : i ∈ B) : ∃ T, BaseRules (C i) T :=
    (hshape i (hBS hi)).base
      ((mixed_kind_two_iff cells hkind i).mp (Finset.mem_filter.mp hi).2)
  let base (i : Fin c) : Finset (Fin 10) :=
    if hi : i ∈ B then Classical.choose (hbase i hi) else ∅
  have hrules (i : Fin c) (hi : i ∈ B) : BaseRules (C i) (base i) := by
    dsimp only [base]
    rw [dif_pos hi]
    exact Classical.choose_spec (hbase i hi)
  have hridge (i : Fin c) (hi : i ∈ E.family)
      (R : Finset (Fin 10)) (hR : R ∈ (C i).ridges) : R ⊆ (C i).vertices := by
    obtain ⟨F, hFi⟩ := (E.mem_family i).mp hi
    dsimp only [C] at hR ⊢
    rw [← hFi, E.index_spec] at hR ⊢
    obtain ⟨Q, hQF, hQR⟩ := (actualCell_ridge_iff P lab F R).mp hR
    rw [← hQR]
    exact (faceLabels_subset_iff P lab Q F).mpr hQF
  have hlower := triangles_include_ridges_and_bases C E.family B hBS
    E.pairwise_compatible hridge (fun i hi => (hshape i hi).edges) base hrules
  have hpair := E.ridge_pairing hdim
  change ∀ R : Finset (Fin 10),
    (E.family.filter fun i => R ∈ (C i).ridges).card = 0 ∨
    (E.family.filter fun i => R ∈ (C i).ridges).card = 2 at hpair
  have hdouble := double_triangular_ridges C E.family hpair
  have hfilterB : E.family.filter (fun i => i ∈ B) = B := by
    ext i
    simp only [Finset.mem_filter]
    exact ⟨fun h => h.2, fun h => ⟨hBS h, h⟩⟩
  have hfilterH : E.family.filter (fun i => i ∈ H) = H := by
    ext i
    simp only [Finset.mem_filter]
    exact ⟨fun h => h.2, fun h => ⟨hHS h, h⟩⟩
  have hcount (i : Fin c) (hi : i ∈ E.family) :
      ((C i).ridges.filter fun R => R.card = 3).card =
        4 + (if i ∈ B then 2 else 0) + (if i ∈ H then 4 else 0) := by
    have hB : i ∈ B ↔ MixedBipyramidPredicate (C i) := by
      simp only [B, Finset.mem_filter, hi, true_and, C,
        mixed_kind_two_iff cells hkind i]
    have hH : i ∈ H ↔ (C i).vertices.card = 6 := by
      simp only [H, Finset.mem_filter, hi, true_and, C,
        mixed_kind_four_iff cells hkind i]
    change cellRidgeSizeCount (C i) 3 = _
    simpa only [hB, hH] using (hshape i hi).count
  have hsum : (∑ i ∈ E.family, ((C i).ridges.filter fun R => R.card = 3).card) =
      4 * E.family.card + 2 * B.card + 4 * H.card := by
    calc
      _ = ∑ i ∈ E.family,
          (4 + (if i ∈ B then 2 else 0) + (if i ∈ H then 4 else 0)) :=
        Finset.sum_congr rfl hcount
      _ = _ := by
        simp only [Finset.sum_add_distrib]
        rw [← Finset.sum_filter, hfilterB, ← Finset.sum_filter, hfilterH]
        simp [mul_comm]
  rw [actual_triangle_count cells hwell E]
  change 2 * E.family.card + 2 * B.card + 2 * H.card ≤
    (graphTriangles (E.family.biUnion fun i => (C i).edges)).card
  omega

end Papers.RationalityTen.SixZeroTriangleShapes

end
end
