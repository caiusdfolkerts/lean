section BundlePart5
/- Source: ActualFacetTemplateAssignment.lean -/




@[expose] public section

/-!
# Complete facet-template assignments retained through numerical reduction

The local profile equations do not identify a three-polytope uniquely.
Here the assignment retains a labeling of the complete polygon boundary
for every facet. Consequently a zero type count excludes the corresponding
combinatorial type, as well as its numerical profile.
-/

noncomputable section
namespace Papers.RationalityTen.ActualFacetTemplateAssignment

open Finset Set
open scoped Classical
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes Papers.PolytopeFaceCounting Papers.PolytopeIncidenceCounting
open Papers.PolytopeFacetSurplus Papers.PolytopeRelationBudget
open ChirotopeDensity ActualSmallFacetClassification
open SixFacetProfileRefinement
open ActualPolygonBoundary ActualFacetCatalogueTransport

def RealizesKind {d : ℕ} (P : ConvexPolytope d) (F : Face P 3) (a : Kind) : Prop :=
  ∃ loc : (facePolytope P F.val.isFace).vertices ≃ Fin a.size,
    polygonBoundary (facePolytope P F.val.isFace) loc = a.template

theorem realizes_kind {d : ℕ} (P : ConvexPolytope d) (F : Face P 3)
    (hF : facetVertexCount P F ≤ 6) : ∃ a : Kind, RealizesKind P F a := by
  let Q := facePolytope P F.val.isFace
  have hQ : Q.dim = 3 := by
    change faceDim Q.toSet = 3
    rw [facePolytope_toSet]
    exact F.property
  have hc : Q.vertices.card = facetVertexCount P F := by
    simpa only [facetVertexCount, Nat.card_eq_fintype_card, Fintype.card_coe] using
      (Nat.card_congr (faceVerticesEquiv P F.val.isFace)).symm
  have hmin : 4 ≤ facetVertexCount P F :=
    Nat.succ_le_iff.mpr (Papers.PolytopeThreeIncidences.face_vertex_card_gt_dimension P 3 F)
  have hcases : facetVertexCount P F = 4 ∨ facetVertexCount P F = 5 ∨
      facetVertexCount P F = 6 := by omega
  rcases hcases with h4 | h5 | h6
  · obtain ⟨loc, i, hi⟩ := four_vertex_classification Q hQ (hc.trans h4)
    have hi0 : i = 0 := Fin.eq_zero i
    subst i
    exact ⟨.tetrahedron, loc, hi⟩
  · obtain ⟨loc, i, hi⟩ := five_vertex_classification Q hQ (hc.trans h5)
    have hi01 : i = 0 ∨ i = 1 := by omega
    rcases hi01 with rfl | rfl
    · exact ⟨.bipyramid, loc, hi⟩
    · exact ⟨.squarePyramid, loc, hi⟩
  · obtain ⟨loc, i, hi⟩ := six_vertex_classification Q hQ (hc.trans h6)
    exact ⟨.six i, loc, hi⟩

structure Assignment {d : ℕ} (P : ConvexPolytope d) where
  kind : Face P 3 → Kind
  realizes : ∀ F, RealizesKind P F (kind F)

theorem assignment_exists {d : ℕ} (P : ConvexPolytope d)
    (hfacets : ∀ F : Face P 3, facetVertexCount P F ≤ 6) :
    Nonempty (Assignment P) := by
  choose kind hk using fun F => realizes_kind P F (hfacets F)
  exact ⟨⟨kind, hk⟩⟩

theorem Assignment.matches {d n : ℕ} {P : ConvexPolytope d}
    (A : Assignment P) (lab : P.vertices ≃ Fin n) (F : Face P 3) :
    Matches P F (A.kind F) := by
  obtain ⟨loc, hloc⟩ := A.realizes F
  exact matches_of_template P lab F (A.kind F) loc hloc

theorem Assignment.refines {d n : ℕ} {P : ConvexPolytope d}
    (A : Assignment P) (hP : P.dim = 4) (lab : P.vertices ≃ Fin n) :
    (countsOf P A.kind).Refines (actualAllSixFacetBudget P) :=
  counts_refine_actual P hP A.kind (A.matches lab)

theorem Assignment.six_index_zero {d : ℕ} {P : ConvexPolytope d}
    (A : Assignment P)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0)
    (F : Face P 3) (j : Fin 7) (hkind : A.kind F = .six j) : j = 0 := by
  by_contra hj
  have hz := hcounts j hj
  change (Finset.univ.filter fun G => A.kind G = .six j).card = 0 at hz
  have hpos : 0 < (Finset.univ.filter fun G => A.kind G = .six j).card :=
    Finset.card_pos.mpr ⟨F, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hkind⟩⟩
  omega

/-- Empty type classes exclude those complete facet templates. No inference
from equality of face numbers to combinatorial equivalence is used. -/
theorem Assignment.only_six_zero {d n : ℕ} {P : ConvexPolytope d}
    (A : Assignment P) (lab : P.vertices ≃ Fin n)
    (hcounts : ∀ j : Fin 7, j ≠ 0 → (countsOf P A.kind).six j = 0)
    (F : Face P 3) :
    facetVertexCount P F ≤ 5 ∨ RealizesKind P F (.six 0) := by
  have hm := (A.matches lab F).1
  cases hkind : A.kind F with
  | tetrahedron =>
    left
    have hfour : facetVertexCount P F = 4 := by
      simpa only [hkind, Kind.size] using hm
    omega
  | bipyramid =>
    left
    simpa only [hkind, Kind.size] using hm.le
  | squarePyramid =>
    left
    simpa only [hkind, Kind.size] using hm.le
  | six j =>
    have hj : j = 0 := A.six_index_zero hcounts F j hkind
    subst j
    right
    simpa only [hkind] using A.realizes F

/-- The complete 478-row reduction can be made with one assignment whose
full boundary labelings remain available for every later branch. -/
theorem actual_assignment_mem_catalogue {n : ℕ}
    (P : ConvexPolytope 4) (hP : P.IsFullDim) (e : Fin n ≃ P.vertices)
    (hn : P.vertices.card = 10) (hN : 10 ≤ (nonsimplicialFacets P).card)
    (hc : 9 ≤ Fintype.card (SparseSharedRowIndex P e))
    (hfacets : ∀ F : Face P 3, facetVertexCount P F ≤ 6)
    (hsix : (sixVertexFacets P).Nonempty) :
    ∃ A : Assignment P,
      (countsOf P A.kind).Refines (actualAllSixFacetBudget P) ∧
      (countsOf P A.kind).toRow (actualAllSixFacetBudget P) ∈
        SixBudgetEnumeration.catalogue := by
  obtain ⟨A⟩ := assignment_exists P hfacets
  have hA := A.refines hP e.symm
  have hbudget := actual_all_six_budget_admissible P hP e hn hN hc hfacets hsix
  exact ⟨A, hA, SixBudgetEnumeration.complete _
    ((countsOf P A.kind).toRow_admissible _ hA hbudget)⟩

end Papers.RationalityTen.ActualFacetTemplateAssignment

end
