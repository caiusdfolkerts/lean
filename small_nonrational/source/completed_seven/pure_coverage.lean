noncomputable section
namespace Papers.RationalityTen.RootedCoverage.RootedSevenPure019

open SixFacetProfileRefinement ActualFacetCatalogueTransport LiteralMaskGeometry
open RootedCanonical.RootedSevenPure019

abbrev root : Fin FacetUniverses.RootedSevenPure019.cellCount := 0

/-- Current local labels map to the original universe root labels. -/
def rootEmbedding : Fin 7 ↪ Fin 10 where
  toFun := ![0, 1, 2, 3, 4, 5, 6]
  inj' := by decide +kernel

theorem root_exact :
    mapCell rootEmbedding
      (cellOfBoundary (FiniteCycleCandidates.N7.templates 9)) =
      decodeCell (FacetUniverses.RootedSevenPure019.cells root) := by
  apply cell_ext <;> decide +kernel

theorem root_kind : (FacetUniverses.RootedSevenPure019.cells root).kind = 0 := by
  decide +kernel

