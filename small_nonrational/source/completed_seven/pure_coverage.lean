    SevenFamilyActualEncoding.Coverage FacetUniverses.RootedSevenPure062.cells root 28
      (fun a => a.size ≤ 5) (SevenFamilyActualEncoding.rowQuota 0 7 2 0) :=
  coverage _ (by
    intro k hk
    have hk' : k = 1 := by simpa [omittedTags] using hk
    rcases hk' with rfl <;> rfl)

end Papers.RationalityTen.RootedCoverage.RootedSevenPure062

