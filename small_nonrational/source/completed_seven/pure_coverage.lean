    SevenFamilyActualEncoding.Coverage FacetUniverses.RootedSevenPure004.cells root 2
      (fun a => a.size ≤ 5) (SevenFamilyActualEncoding.rowQuota 1 4 5 0) :=
  coverage _ (by
    intro k hk
    simp only [omittedTags, List.not_mem_nil] at hk)

end Papers.RationalityTen.RootedCoverage.RootedSevenPure004

