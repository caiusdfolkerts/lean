/- Source module: RootedSevenPure000Coverage -/
@[expose] public section

/-!
# Complete compatible-template coverage for RootedSevenPure000

The full canonical placement theorems retain vertices, edges, polygons
and the candidate kind. An omitted positive tag can be used only with
zero quota. Root labels are explicitly transported from the complete
local catalogue to the original finite universe.
-/

noncomputable section
namespace Papers.RationalityTen.RootedCoverage.RootedSevenPure000

open SixFacetProfileRefinement ActualFacetCatalogueTransport LiteralMaskGeometry
open RootedCanonical.RootedSevenPure000

abbrev root : Fin FacetUniverses.RootedSevenPure000.cellCount := 0

/-- Current local labels map to the original universe root labels. -/
def rootEmbedding : Fin 7 ↪ Fin 10 where
  toFun := ![0, 1, 2, 3, 4, 5, 6]
  inj' := by decide +kernel

theorem root_exact :
    mapCell rootEmbedding
      (cellOfBoundary (FiniteCycleCandidates.N7.templates 0)) =
      decodeCell (FacetUniverses.RootedSevenPure000.cells root) := by
  apply cell_ext <;> decide +kernel

theorem root_kind : (FacetUniverses.RootedSevenPure000.cells root).kind = 0 := by
  decide +kernel

/-- Exactly the omitted tags among the permitted nonroot local kinds. -/
def omittedTags : List Nat := []

def coverage (quota : Nat → Nat)
    (hzero : ∀ k, k ∈ omittedTags → quota k = 0) :
    SevenFamilyActualEncoding.Coverage FacetUniverses.RootedSevenPure000.cells root 0 (fun a => a.size ≤ 5) quota where
  rootEmbedding := rootEmbedding
  rootCell := root_exact
  rootKind := root_kind
  complete := by
    intro a hallowed hpos f h
    cases a with
    | tetrahedron => exact S4T0.covers_exact f h
    | bipyramid => exact S5T0.covers_exact f h
    | squarePyramid => exact S5T1.covers_exact f h
    | six i =>
      change 6 ≤ 5 at hallowed
      omega

/-- The exact numerical family discharges every omitted-kind condition. -/
def rowCoverage :
    SevenFamilyActualEncoding.Coverage FacetUniverses.RootedSevenPure000.cells root 0
      (fun a => a.size ≤ 5) (SevenFamilyActualEncoding.rowQuota 1 3 6 0) :=
  coverage _ (by
    intro k hk
    simp only [omittedTags, List.not_mem_nil] at hk)

end Papers.RationalityTen.RootedCoverage.RootedSevenPure000

end
end

