  simpa only [symmetry, Fin.ofNat_val_eq_self] using
    symmetry_complete i.val (Nat.zero_le _) i.isLt
theorem generator_checks (g : Fin FacetUniverses.RootedSevenPure018.Outside.generatorCount)
    (i : Fin FacetUniverses.RootedSevenPure018.cellCount) :
    RawGraphGrowthFrames.inverseCheckAt (FacetUniverses.RootedSevenPure018.Outside.forward g) (FacetUniverses.RootedSevenPure018.Outside.forward g) i = true ∧
    RawGraphGrowthFrames.cellRelabelCheck
      (TenGraphEdges.vertexMap (FacetUniverses.RootedSevenPure018.Outside.vertexCode g))
      (FacetUniverses.RootedSevenPure018.cells i) (FacetUniverses.RootedSevenPure018.cells (FacetUniverses.RootedSevenPure018.Outside.forward g i)) = true := by
  apply Bool.and_eq_true_iff.mp
  simpa only [FacetUniverses.RootedSevenPure018.Outside.cellTest, Fin.ofNat_val_eq_self] using
    FacetUniverses.RootedSevenPure018.Outside.cell_checked g i

noncomputable def generators (g : Fin FacetUniverses.RootedSevenPure018.Outside.generatorCount) :
    BoundaryGeneratorFrames.BoundaryFrame FacetUniverses.RootedSevenPure018.cells :=
  BoundaryGeneratorFrames.checkedFrame FacetUniverses.RootedSevenPure018.cells
    (FacetUniverses.RootedSevenPure018.Outside.vertexCode g) (FacetUniverses.RootedSevenPure018.Outside.vertexCode g)
    (FacetUniverses.RootedSevenPure018.Outside.vertex_checks g) (FacetUniverses.RootedSevenPure018.Outside.forward g) (FacetUniverses.RootedSevenPure018.Outside.forward g)
    (fun i => (generator_checks g i).1) (fun i => (generator_checks g i).2)

theorem outside_avoids (i : Fin blockCount) (j : Fin (blocks i).outside) :
    OutsideBoundarySymmetry.outsideEmbedding (blocks i) j ∉ (decodeCell root).vertices :=
  OutsidePlacementSemantics.outside_avoids_root FacetUniverses.RootedSevenPure018.Outside.vertexCode root
    (blocks i) (raw i) (checkedBlock_representation _ _) (symmetry_checked i) j
theorem outside_generators (i : Fin blockCount) (j : Fin ((blocks i).outside - 1)) :
    ∃ F : BoundaryGeneratorFrames.BoundaryFrame FacetUniverses.RootedSevenPure018.cells,
      F.vertices = (OutsideBoundarySymmetry.adjacentSwap (blocks i).outside j).viaEmbedding
        (OutsideBoundarySymmetry.outsideEmbedding (blocks i)) :=
  OutsidePlacementSemantics.adjacent_frame FacetUniverses.RootedSevenPure018.cells generators
    FacetUniverses.RootedSevenPure018.Outside.vertexCode (fun _ _ => rfl) root (blocks i) (raw i)
    (checkedBlock_representation _ _) (symmetry_checked i) j
theorem covers_exact : ∀ f : Fin 4 ↪ Fin 10,
    (mapCell f localCell).Compatible (decodeCell root) →
      ∃ i, (FacetUniverses.RootedSevenPure018.cells i).kind = template.kind ∧
        decodeCell (FacetUniverses.RootedSevenPure018.cells i) = mapCell f localCell :=
  SymmetricRootedFacetCoverage.covers_of_canonical_checks
    template root localCell template_exact local_vertices root_wellFormed root_edges root_ridges
    FacetUniverses.RootedSevenPure018.cells blocks raw (fun i => checkedBlock_representation _ _)
    normalizers_complete outside_avoids outside_generators witness placement_checks
theorem covers (f : Fin 4 ↪ Fin 10)
    (h : (mapCell f localCell).Compatible (decodeCell root)) :
    ∃ i, decodeCell (FacetUniverses.RootedSevenPure018.cells i) = mapCell f localCell := by
  obtain ⟨i, _, hi⟩ := covers_exact f h
  exact ⟨i, hi⟩
end Papers.RationalityTen.RootedCanonical.RootedSevenPure018.S4T0

