    SevenFamilyActualEncoding.Coverage FacetUniverses.RootedSevenPure019.cells root 9
      (fun a => a.size ≤ 5) (SevenFamilyActualEncoding.rowQuota 0 6 3 0) :=
  coverage _ (by
    intro k hk
