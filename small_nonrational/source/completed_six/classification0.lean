@[expose] public section

/-! Exact finite classification for rooted case 140.
The complete forest for case 296 is reused by proved quota monotonicity.
The quota remains the exact original quota. Every larger-forest leaf has a
new checked route to a smaller-quota failure or an identical original leaf. -/

noncomputable section
namespace Papers.RationalityTen.CompletedRooted.Case0140

open RootedForests.RootedSubsumedForest0296
open RawNatGrowthCompleteness RawNatGrowthSoundness

theorem raw_leaves_exact (j : Fin 7) :
    (leaves j).map FacetUniverses.RootedSixBase00.cells =
      (rawLeaves j.val).map RootedCaches.RootedSixBase00.rawCells := by
  have hb := (Bool.and_eq_true_iff.mp
    (leafTest_complete j.val (Nat.zero_le _) j.isLt)).1
  have hval : (leaves j).map Fin.val = rawLeaves j.val := val_decode_list _ hb
  calc
    (leaves j).map FacetUniverses.RootedSixBase00.cells =
        ((leaves j).map Fin.val).map RootedCaches.RootedSixBase00.rawCells := by
      rw [List.map_map]
      rfl
    _ = (rawLeaves j.val).map RootedCaches.RootedSixBase00.rawCells := by rw [hval]

def classification : RootedFamilyClosure.FiniteClassification
    FacetUniverses.RootedSixBase00.cells RootedForests.RootedSubsumedForest0140.quota (0 : Fin 21976) where
  wellFormed := CompletedRootedFrames.RootedSixBase00.cells_wellFormed
  generatorCount := 96
  frames := CompletedRootedFrames.RootedSixBase00.frame
  leafCount := 7
  leaves := leaves
  rawLeaves := fun j => (rawLeaves j.val).map RootedCaches.RootedSixBase00.rawCells
  raw_exact := raw_leaves_exact
  certificates := RootedQuotaTransfers.Case0140.disposition
  checked := RootedQuotaTransfers.Case0140.disposition_checked
  complete := fun B hB hroot => boundary_classification
    (fun f => (CompletedRootedFrames.RootedSixBase00.frame f).toBoundaryRenaming
      CompletedRootedFrames.RootedSixBase00.cells_wellFormed)
    CompletedRootedFrames.RootedSixBase00.maps_exact B
      (QuotaLeafTransfer.target_mono hB RootedQuotaTransfers.Case0140.quota_le) hroot

#print axioms classification
end Papers.RationalityTen.CompletedRooted.Case0140

end
end
end Case0140

