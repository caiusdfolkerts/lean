        ((leaves j).map Fin.val).map RootedCaches.RootedSixBase03.rawCells := by
      rw [List.map_map]
      rfl
    _ = (rawLeaves j.val).map RootedCaches.RootedSixBase03.rawCells := by rw [hval]

