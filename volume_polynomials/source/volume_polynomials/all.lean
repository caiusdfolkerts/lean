  | refine ⟨fun h => ?_, fun h => ?_⟩
    · simpa [Function.comp_def, preimage_preimage] using h.comp_eval fun i => X (e.symm i)
    · simpa [Function.comp_def] using h.comp_eval fun i => X (e i)

