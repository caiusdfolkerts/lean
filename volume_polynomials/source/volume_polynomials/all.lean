    (T : F ≃L[ℝ] (ℝ × E)) (hT : MeasurePreserving T volume volume)
    {C : Set F} (hC : IsCompact C) (hc : Convex ℝ C) {v : F} {c : ℝ}
    (hv : T v = (c, 0)) (hc0 : 0 ≤ c) :
