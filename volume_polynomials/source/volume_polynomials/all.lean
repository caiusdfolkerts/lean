    Irrational (θ / Real.pi) := by
  first
  | rintro ⟨q, hq⟩
    apply Holonomy.angle_not_rational_multiple_pi hθ
    exact ⟨q, (div_eq_iff Real.pi_ne_zero).mp hq.symm⟩

