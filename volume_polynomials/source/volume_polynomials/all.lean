    let .ok recorded := fromJson? (α := Array String) encoded
      | throwError "Malformed name array in source-ownership checkpoint {marker}"
    for name in recorded do
      let key := Name.mkSimple name
      if previous.contains key then
        throwError "A declaration has duplicate source ownership: {name}"
      previous := previous.insert key
  let names := env.constants.foldStage2 (fun acc name _ => name :: acc) ([] : List Name)
  let mut current : Array String := #[]
  let mut serialization : NameMap Name := {}
  for name in names do
    if !markerNamespace.isPrefixOf name then
      let key := Name.mkSimple name.toString
      if let some other := serialization.find? key then
        unless other == name do
          throwError "Ambiguous declaration-name serialization: {name} / {other}"
      serialization := serialization.insert key name
      unless previous.contains key do
        current := current.push name.toString
  for name in previous do
    unless serialization.contains name do
      throwError "A previously recorded declaration disappeared: {name}"
  let marker := Name.mkStr2 "CanonicalSourceOwnership" "block_311"
  if env.contains marker then
    throwError "Reserved source-ownership name already exists: {marker}"
  liftCoreM <| Lean.addDecl (.defnDecl {
    name := marker, levelParams := [], type := mkConst ``String,
    value := mkStrLit (toJson current).compress,
    hints := .abbrev, safety := .safe })
  -- Only memoization caches reset; all checked declarations and ownership edges remain.
  modifyEnv fun env =>
    Lean.Meta.auxLemmasExt.setState env ({} : Lean.Meta.AuxLemmas)
  modifyEnv fun env =>
    Lean.Meta.Match.matcherExt.setState env {}

