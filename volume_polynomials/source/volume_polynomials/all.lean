    (hvs : ∀ w ∈ vs, 0 ≤ w.1 ∧ w.2 ≤ 0) (hv : 0 ≤ v.1 ∧ v.2 ≤ 0) :
    ⟪cornerMean (cornerMeasure vs), edgeVector v⟫_ℝ =
