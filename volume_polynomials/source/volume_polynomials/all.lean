theorem AFBodyTuple_commonRefinement
    (hIH : AlexandrovFenchelDimension.{u} n) (hdim : finrank ℝ E = n + 3)
    (K : Fin (n + 3) → ConvexBody E) (D : CommonRefinement K)
    (h0 : ∀ i, (0 : E) ∈ K i) {r : ℝ} (hr : 0 < r) :
