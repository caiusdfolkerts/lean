      intro z hz
      change z ∈ kernelBody (bodyAtHeight l h₀ hp hc h) (l i) v hv
      rw [kernelBody_bodyAtHeight_mem_iff l h₀ hg hp hc hf hh i v hv]
      intro j
      by_cases hji : j = i
