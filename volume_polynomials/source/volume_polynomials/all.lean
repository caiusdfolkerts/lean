    have ht : (1 : ℝ) / ((n : ℝ) + 1) ∈ Ioc (0 : ℝ) 1 := by
      first
      | refine ⟨by positivity, ?_⟩
        apply (div_le_iff₀ (by positivity : 0 < (n : ℝ) + 1)).mpr
        have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
