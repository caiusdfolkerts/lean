    IsSemialgebraicMap (f * g) :=
  isSemialgebraicOn_univ.1 <| (isSemialgebraicOn_univ.2 hf).mul (isSemialgebraicOn_univ.2 hg)

/-- Given projection closure, the pointwise difference of semialgebraic maps is semialgebraic. -/
