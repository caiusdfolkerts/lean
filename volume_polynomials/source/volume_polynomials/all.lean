    ("sha256", toJson sourceHashes[index]!),
    ("allowed_local_modules", toJson (allowed[index]!.map fun j => modules[j]!))]
  let report := Json.mkObj [
    ("status", toJson (if violations.isEmpty then "PASSED" else "FAILED")),
    ("violations", .arr violations),
    ("scope", toJson "Actual local constant types and values, including private and generated declarations, checked against each original source's transitive local import closure."),
    ("compiler_gate", toJson "This audit is valid only with an ordinary pinned compiler exit status of zero and the separately checked source-hash correspondence."),
    ("safe_metadata_namespace", toJson "CanonicalSourceOwnership"),
    ("sources", .arr sourceRows), ("ownership", .arr ownership),
    ("local_dependencies", .arr edges)]
  liftIO <| IO.FS.writeFile ".lake/reports/audit/canonical-source-ownership.json" report.pretty
