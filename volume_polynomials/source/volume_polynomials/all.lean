    nlinarith

theorem minkowski_squared (hdim : finrank ℝ E = 2) (A B : ConvexBody E) :
    μ.real (A : Set E) * μ.real (B : Set E) ≤ mixedArea μ A B ^ 2 := by
  first
  | have h := sqrt_area_mul_le_mixedArea μ hdim A B
