          have hub : u = b := hu
          subst u
          exact ⟨b, hb, v, hv, rfl⟩
        · change translateBody (if firstPattern (n + 1) i j = true then b else a) S ≤ _
          rw [if_neg hj]
          simp only [patternBody, if_neg hj, thickened]
          rintro x ⟨u, hu, v, hv, rfl⟩
          have hua : u = a := hu
          subst u
          exact ⟨a, ha, v, hv, rfl⟩

