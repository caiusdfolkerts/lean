    DenseRange (rotationUnit θ) := by
  first
  | have hd : DenseRange (fun m : ℤ => m • (θ : AddCircle Real.pi)) :=
      AddCircle.denseRange_zsmul_coe_iff.mpr (angle_ratio_irrational hθ)
    let e := AddCircle.homeomorphCircle Real.pi_ne_zero
