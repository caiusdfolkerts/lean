      cornerKernel (Real.log (|e.2| / |e.1|)) (Real.log (|f.2| / |f.1|)) = _
    rw [mul_comm (Real.sqrt (|f.1| * |f.2|)) (Real.sqrt (|e.1| * |e.2|))]
    exact HalfZonotope.weighted_cornerKernel (abs_nonneg e.1) (abs_nonneg e.2)
