    (hp : ∀ i, 0 < h i) (i : ι) (v : E) (hv : u i v = 1) :
    normalized u h i (h i • v) = 1 := by
  first
  | simp only [normalized, ContinuousLinearMap.smul_apply, map_smul, smul_eq_mul,
      hv, mul_one, inv_mul_cancel₀ (hp i).ne', mul_inv_cancel₀ (hp i).ne']

