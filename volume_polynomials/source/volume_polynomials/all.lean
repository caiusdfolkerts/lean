              refine (Finset.sum_eq_zero fun j _ ↦ indicator_of_notMem ?_ _).le
              exact fun h ↦ hx ((H.add_mem_cancel_right (hw j)).mp h.2)
        _ = D * μ H := lintegral_indicator_const hH _
