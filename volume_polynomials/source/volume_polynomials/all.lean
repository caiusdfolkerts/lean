theorem cauchyIndex_insert (p q : R[X]) {a : R} {s : Set R} (h : a ∉ s) :
    cauchyIndex p q (insert a s) = cauchyJump p q a + cauchyIndex p q s :=
  finsum_mem_insert' _ h ((finite_support_cauchyJump p q).inter_of_right s)

