def facetWeight (i : ι) (v : E) (hv : l i v = 1) : ℝ :=
  (volumeFactor (continuousEquiv (l i) v hv) : ℝ) * volume.real (facetBase l i v)

theorem facetWeight_nonneg (i : ι) (v : E) (hv : l i v = 1) :
    0 ≤ facetWeight l i v hv :=
