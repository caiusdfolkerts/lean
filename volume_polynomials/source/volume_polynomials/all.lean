  first
  | have hm : MeasurableSet {x : E | radialMap (r, x) ∈ K} :=
      hK.preimage (continuous_radialMap.comp (continuous_const.prodMk continuous_id)).measurable
    have heq : (fun x : E => radialWeight k K (r, x)) =
