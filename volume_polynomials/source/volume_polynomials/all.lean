      (2 * mixedArea μ A P) (Ioi 0) 0 := by
  first
  | have hp : HasDerivAt (fun t : ℝ => μ.real (P : Set E) +
        t * (2 * mixedArea μ A P) + t ^ 2 * μ.real (A : Set E))
