theorem radial_polynomial_leadingCoeff (P : Polynomial (Polynomial ℂ))
    (z h δ : ℕ → ℂ) (ζ β : ℂ)
    (hz : Tendsto z atTop (𝓝 ζ)) (hδ : Tendsto δ atTop (𝓝 0))
    (hres : Tendsto (fun n => δ n * h n) atTop (𝓝 β))
    (hrel : ∀ n, P.eval₂ (Polynomial.evalRingHom (z n)) (h n) = 0) :
