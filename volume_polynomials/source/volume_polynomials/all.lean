  for (name, _) in declarations do
    localNames := localNames.insert name
    if markerNamespace.isPrefixOf name then
      unless expectedMarkers.contains name do
        throwError "Unexpected declaration uses the reserved audit namespace: {name}"
    else
      ordinaryCount := ordinaryCount + 1
      let key := Name.mkSimple name.toString
      if let some other := serialization.find? key then
        unless other == name do
          throwError "Ambiguous declaration-name serialization: {name} / {other}"
