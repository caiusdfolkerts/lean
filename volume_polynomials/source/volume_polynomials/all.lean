    (hvp : ∀ t ∈ Ico 0 M, v t = u t ^ k)
    (hvz : ∀ t, M ≤ t → v t = 0)
    (hvint : ∀ a : ℝ, 0 ≤ a → IntegrableOn v (Icc 0 a))
    (hxvint : ∀ a : ℝ, 0 ≤ a → IntegrableOn (fun t => t * v t) (Icc 0 a)) :
