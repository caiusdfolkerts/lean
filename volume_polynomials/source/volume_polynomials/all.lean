    simp only [mem_inter_iff, Finset.coe_filter, mem_ofPred_eq]
    exact ⟨fun h => ⟨⟨support_cauchyJump_subset p q h.2, h.1⟩, h.2⟩,
      fun h => ⟨h.1.2, h.2⟩⟩

