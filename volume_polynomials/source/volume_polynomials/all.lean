    (hf : ∀ k ∈ s, ∀ j ≤ i, ContinuousAt (fun x ↦ (f k x).coeff j) x₀) :
    ContinuousAt (fun x ↦ (∏ k ∈ s, f k x).coeff i) x₀ := by
