    {p : R[X]} (hp : p ≠ 0) (Q : J → R[X]) (σ : J → SignType) :
    0 < signCount p.roots.toFinset Q σ ↔
      ∃ x : R, p.eval x = 0 ∧ ∀ j, sign ((Q j).eval x) = σ j := by
  first
  | classical
    simp only [signCount_pos, Multiset.mem_toFinset, mem_roots hp, IsRoot.def]

