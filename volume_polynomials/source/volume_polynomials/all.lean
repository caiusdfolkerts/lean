      change (∫ x : E, (fiberSet C y).indicator (fun _ => (1 : ℝ)) x) = _
      rw [integral_indicator (fiberSet_compact C y).measurableSet, setIntegral_const]
      simp only [smul_eq_mul, mul_one]
