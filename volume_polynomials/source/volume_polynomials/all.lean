    geometricWeight n ^ 2 = geometricNormalizer n ^ 2 * (4 : ℝ) ^ n / 4 := by
  first
  | simp only [geometricWeight, div_pow, mul_pow,
      Real.sq_sqrt (pow_nonneg (by norm_num : (0 : ℝ) ≤ 4) n)]
    norm_num

