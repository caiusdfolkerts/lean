@[simp] theorem diagonalEquiv_apply (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) (x : Plane) :
    diagonalEquiv a b ha hb x = (a * x.1, b * x.2) := diagonalLinear_apply a b x

