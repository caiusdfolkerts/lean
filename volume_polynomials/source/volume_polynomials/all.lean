      volume.real C + t * volume.real (projection (T '' C)) := by
  calc
    volume.real (C + (fun s : ℝ => s • v) '' Icc 0 t) =
        volume.real (T '' (C + (fun s : ℝ => s • v) '' Icc 0 t)) :=
