    SupportGeometry.support (PlanarCorner.segmentBody v : Set Plane) l = |l v| / 2 := by
  first
  | apply le_antisymm
    · apply SupportGeometry.support_le (PlanarCorner.segmentBody v).nonempty l
      rintro x ⟨t, ht, rfl⟩
      have ht' : |t| ≤ 1 / 2 := abs_le.mpr ht
