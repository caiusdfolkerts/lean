public section

namespace TauCeti

open _root_.Polynomial Set SignType

section Ordered

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

/-- The leading pair `[s_m, 0, …, 0, s_n]` contributes the sign of `p * q` at infinity when
