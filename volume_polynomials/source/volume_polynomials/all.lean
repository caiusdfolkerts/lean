theorem positive_of_nonnegative_on_cone {n : ℕ}
    (F : MultilinearMap ℝ (fun _ : Fin n => V) ℝ)
    (hF : ∀ x : Fin n → V, (∀ i, x i ∈ C) → 0 ≤ F x)
    {p : V} (hp : p ∈ C) (hdiag : 0 < F (fun _ => p))
    (H : Fin n → V) (hH : ∀ i, H i ∈ C) : 0 < F H := by
