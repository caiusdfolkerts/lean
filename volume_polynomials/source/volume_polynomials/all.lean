    have hb2 : b.2 ≠ 0 := fun h => hb (Or.inr h)
    have hc1 : c.1 ≠ 0 := fun h => hc (Or.inl h)
    have hc2 : c.2 ≠ 0 := fun h => hc (Or.inr h)
