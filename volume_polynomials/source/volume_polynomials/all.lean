noncomputable def signedSlopeFourier (ν : SignedMeasure ℝ) (ξ : ℝ) : ℂ :=
  ∫ᵛ x : ℝ, Complex.exp ((ξ : ℂ) * x * Complex.I) ∂<•ν

theorem signedSlopeFourier_sub (μ ν : Measure ℝ)
    [IsFiniteMeasure μ] [IsFiniteMeasure ν] (ξ : ℝ) :
