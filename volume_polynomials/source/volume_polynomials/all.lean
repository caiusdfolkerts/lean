          change t • q.2 = (0 : Plane)
          rw [show q.2 = (0 : Plane) from hq0, smul_zero]⟩
    · rintro ⟨hp, hp0⟩
      refine ⟨(p.1 / t, 0), ⟨⟨div_nonneg hp.1 ht, (div_le_one htp).mpr hp.2⟩, rfl⟩, ?_⟩
      apply Prod.ext
      · change t * (p.1 / t) = p.1
        field_simp [ht0]
      · simpa using hp0.symm

