theorem integral_third_difference {k : ℕ}
    (F : ConvexBody (Space 3 × Space k)) (B C : Body 3) (J : ℝ) :
    (∑ i : Fin 6, differenceWeight i *
      (J * ∫ y in ConvexFibers.projection F,
