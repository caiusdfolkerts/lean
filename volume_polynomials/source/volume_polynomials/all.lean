          ⟨-(1 / 2), ⟨le_rfl, by norm_num⟩, rfl⟩
        have h := SupportGeometry.le_support (PlanarCorner.segmentBody v).isCompact l hp
        simp only [map_smul, smul_eq_mul] at h
        rw [abs_of_neg (lt_of_not_ge hv)]
