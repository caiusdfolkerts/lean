        have h₂ := mul_le_mul_of_nonneg_left (orbit_norm_le (n + 1)) (norm_nonneg p.2)
        nlinarith
      _ ≤ 4 * ‖p‖ := by
        have h₁ : ‖p.1‖ ≤ ‖p‖ := le_max_left _ _
        have h₂ : ‖p.2‖ ≤ ‖p‖ := le_max_right _ _
        linarith

