      | throwError "Malformed JSON in source-ownership checkpoint {marker}"
    let .ok names := fromJson? (α := Array String) encoded
      | throwError "Malformed name array in source-ownership checkpoint {marker}"
    for name in names do
      let key := Name.mkSimple name
      if owners.contains key then
        throwError "A local declaration has duplicate ownership: {name}"
      owners := owners.insert key index
      ownership := ownership.push (Json.mkObj [
        ("name", toJson name), ("source_module", toJson modules[index]!),
        ("source_path", toJson paths[index]!)])
