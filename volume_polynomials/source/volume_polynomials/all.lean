  first
  | constructor
    · intro i
      simp_rw [cornerMatrix_moment_eq_ofReal_integral]
      rw [← ENNReal.ofReal_sum_of_nonneg (fun j _ => integral_nonneg
        (fun x => (Real.exp_pos ((-1 / 2 : ℝ) * x)).le))]
