    rw [rotationFrequency, h, Complex.norm_exp_ofReal_mul_I]

noncomputable def sineGeneratingFunction (θ : ℝ) (z : ℂ) : ℂ :=
  ∑' n : ℕ, ((|Real.sin ((n + 1 : ℕ) * θ)| : ℝ) : ℂ) * z^(n + 1)

theorem sine_fourier_at_multiple (θ : ℝ) (n : ℕ) :
