      facetMixedForm l h₀ hg hp hc i v hv H x h := by
  first
  | rw [facetMixedForm_eq l h₀ hg hp hc i v hv H hH hx hh]
    unfold facetMixedValue
    congr 1
    funext j
    exact Fin.cases rfl (fun k => Fin.cases rfl (fun _ => rfl) k) j

