        (hg.min measurable_const) hh (hbdd m) (hbdd n) fun x y ↦
        (mul_le_mul' (ENNReal.rpow_le_rpow (min_le_left _ _) h1θ.le)
          (ENNReal.rpow_le_rpow (min_le_left _ _) hθ₀.le)).trans (hfgh x y)
