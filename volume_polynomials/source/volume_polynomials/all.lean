    active l h (vertexMap l b h) = b.val := by
  first
  | ext i
    rw [mem_active]
    constructor
    · intro hi
      by_contra hni
      exact (hs i hni).ne hi
    · intro hi
      exact vertexMap_active l b h ⟨i, hi⟩

