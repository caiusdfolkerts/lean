    if Finsupp.mapDomain (Fin.castAdd k) (exponent α) = exponent β then X α else 0

theorem extraVariableCoordinate_eval {m d : ℕ} (k : ℕ) (c : Coefficients m d)
    (β : MultiIndex (m + k) d) :
