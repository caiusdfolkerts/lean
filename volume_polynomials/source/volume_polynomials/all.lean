    have hcorner := PlanarCorner.mixedArea_corner_inequality D.A Q
    rw [D.A_width, D.A_height, hQ.1, hQ.2.1, one_mul, mul_one] at hcorner
    simp only [one_mul, mul_one] at hcorner
    refine ⟨D, Q, hQ, hTq, hz, ?_, D.A_area.trans hAa⟩
    linarith

