        have ht := fun w hw => hvs w (List.mem_cons_of_mem v hw)
        have hs : 0 ≤ (vs.map (cornerInteraction v)).sum := by
          first
          | apply List.sum_nonneg
            intro x hx
            obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hx
            exact cornerInteraction_nonneg hv (ht w hw)
