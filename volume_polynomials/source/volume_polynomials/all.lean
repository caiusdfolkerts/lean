    letI : ∀ i, MeasureSpace (LinearMap.ker (D.normal i).toLinearMap) :=
      fun i => ⟨kernelMeasure (D.normal i)⟩
    letI : ∀ i, Measure.IsAddHaarMeasure (volume : Measure (LinearMap.ker (D.normal i).toLinearMap)) :=
