      ext <;> simp only [diagonalLinear_apply, Prod.fst, Prod.snd] <;> field_simp [ha, hb]

theorem mem_rightTriangle_slice {a b x z : ℝ} (ha : a ≠ 0) (hb : b ≠ 0) :
    (x, z) ∈ rightTriangle a b ↔
