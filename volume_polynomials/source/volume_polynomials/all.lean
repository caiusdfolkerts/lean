    (T : F ≃L[ℝ] (ℝ × E)) (hT : MeasurePreserving T volume volume)
    {C : Set F} (hC : IsCompact C) (hc : Convex ℝ C) {v : F}
    (hv : T v = (1, 0)) {t : ℝ} (ht : 0 ≤ t) :
