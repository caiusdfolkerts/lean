        rw [div_le_iff₀ hL]
        rw [le_div_iff₀ (by positivity)] at hj
        linarith
      -- `z = (1 - t) • b + t • y` with `b = x + (1 - t)⁻¹ • (z - c j)` in `ball x r`.
