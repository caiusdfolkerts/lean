        apply integral_congr_ae
        filter_upwards [hSupport] with x hx
        rw [real_inner_comm, inner_cornerFeature_mean, integral_cornerTestMeasure hR]
        exact cornerTestPotential_inside hx.1 hx.2
      _ = μ.real univ := by simp

