and every vector with nonnegative quadratic value. -/
theorem form_reverse_cauchy_schwarz {ι : Type*} [Fintype ι]
    (hdim : finrank ℝ E = 2) (K : ι → ConvexBody E)
    (hpositive : 0 < form μ K (fun _ => 1) (fun _ => 1))
