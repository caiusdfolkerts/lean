      first
      | rw [hB.unit_second_moment hBw hBh, hBa]
        ring
    have hc2 : slopeSecondMoment (cornerMatrix c) = 1 + 2 * δ := by
      first
      | rw [hC.unit_second_moment hCw hCh, hCa]
        ring
