      convert ((hasDerivAt_const (0 : ℝ) (μ.real (P : Set E))).add
        ((hasDerivAt_id (0 : ℝ)).mul_const (2 * mixedArea μ A P))).add
        (((hasDerivAt_id (0 : ℝ)).pow 2).mul_const (μ.real (A : Set E))) using 1 <;> norm_num
      all_goals rfl
