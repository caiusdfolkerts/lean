    intro α _
    split_ifs <;> simp

theorem not_semialgebraic_extraVariables {m k d : ℕ}
    (h : ¬ TauCeti.IsSemialgebraic (VolumeLocus m d)) :
    ¬ TauCeti.IsSemialgebraic (VolumeLocus (m + k) d) := by
  first
  | intro hlarge
