namespace VolumePolynomials.ClippedConeVolume

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def radialSlice (k : ℕ) (R : ℝ) (K : Set (ℝ × E)) (x : E) : ℝ :=
