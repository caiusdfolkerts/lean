      intro i
      fin_cases i
      · norm_num
      · exact hb
      · exact hc)
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, evaluate_coefficients,
      one_pow, one_smul, one_mul] at h
