/-- The planar Minkowski inequality for literal Haar area and literal mixed area. -/
theorem sqrt_area_mul_le_mixedArea (hdim : finrank ℝ E = 2) (A B : ConvexBody E) :
    Real.sqrt (μ.real (A : Set E)) * Real.sqrt (μ.real (B : Set E)) ≤
      mixedArea μ A B := by
