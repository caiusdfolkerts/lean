/-- The unit frequency e^(2 i m θ). -/
noncomputable def rotationFrequency (θ : ℝ) (m : ℤ) : ℂ :=
  Complex.exp (2 * (m : ℂ) * (θ : ℂ) * Complex.I)

theorem rotationFrequency_norm (θ : ℝ) (m : ℤ) : ‖rotationFrequency θ m‖ = 1 := by
  first
  | have h : 2 * (m : ℂ) * (θ : ℂ) * Complex.I =
