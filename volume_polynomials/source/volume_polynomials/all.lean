the left input coefficient itself. -/
@[simp]
theorem _root_.Polynomial.signedPsc_left_bound (p q : R[X]) (m n : ℕ) :
    signedPsc p q m n m =
      if m ≤ n then p.coeff m ^ (n - m) else p.coeff m := by
  first
  | by_cases hmn : m ≤ n <;> simp [signedPsc, hmn]

