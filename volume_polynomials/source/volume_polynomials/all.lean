theorem area_add_smul (hdim : finrank ℝ E = 2) (P A : ConvexBody E)
    {r : ℝ} (hr : 0 ≤ r) :
    μ.real (P + r • A : ConvexBody E) = μ.real (P : Set E) +
      r * (2 * mixedArea μ A P) + r ^ 2 * μ.real (A : Set E) := by
  first
