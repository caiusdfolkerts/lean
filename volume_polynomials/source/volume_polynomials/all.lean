      1 + Complex.normSq (z * z) := by
  first
  | simp [offDiagonalPair, matrixSecondTrace_eq_sum, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Fin.sum_univ_two, Complex.normSq_apply, Complex.mul_re, Complex.mul_im] <;> ring

