    LinearMap.det (diagonalLinear a b).toLinearMap = a * b := by
  first
  | change LinearMap.det (frameMap (a, 0) (0, b)) = _
    rw [frameMap_det]
    simp [determinant]

def diagonalEquiv (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) : Plane ≃L[ℝ] Plane :=
  ((diagonalLinear a b).toLinearMap.equivOfDetNeZero
