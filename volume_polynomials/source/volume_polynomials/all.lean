      simp only [coe_mapBody, Set.image_image]
      congr 1
      funext x
      simp only [Function.comp_apply, diagonalLinear_apply]
    rw [height, he, length_image_mul]
    rfl

theorem support_mapBody (L : Plane →L[ℝ] Plane) (P : ConvexBody Plane)
    (l : Plane →L[ℝ] ℝ) :
