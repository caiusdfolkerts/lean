  first
  | refine ⟨hs.linear_image (LinearMap.fst ℝ P F), ?_⟩
    rintro _ ⟨⟨p, y⟩, hy, rfl⟩ _ ⟨⟨q, z⟩, hz, rfl⟩ a b ha hb hab
