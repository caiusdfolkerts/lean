    (ht : t ∈ Icc (-(1 / 2 : ℝ)) (1 / 2)) : t • vs.sum ∈ zonotope vs := by
  first
  | induction vs with
    | nil => simp [zonotope]
    | cons v vs ih =>
        refine ⟨t • vs.sum, ih, t • v, ⟨t, ht, rfl⟩, ?_⟩
        simp only [List.sum_cons, smul_add]
        exact add_comm _ _

