@[simp]
theorem _root_.Polynomial.signedPsc_map_map [CommRing S] (f : R →+* S)
    (p q : R[X]) (m n j : ℕ) :
    signedPsc (p.map f) (q.map f) m n j = f (signedPsc p q m n j) := by
  first
  | simp [signedPsc, apply_ite f]

