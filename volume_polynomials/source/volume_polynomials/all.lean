    (hBw : width B = 1) (hBh : height B = 1)
    (hCw : width C = 1) (hCh : height C = 1)
    (hQ : Represents Q (completedEdges (productEdges b c)))
    (hQw : width Q = 1) (hQh : height Q = 1)
