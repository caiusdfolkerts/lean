theorem analytic_zero_on_disk_of_real_interval (f : ℂ → ℂ)
    (hf : AnalyticOnNhd ℂ f (ball 0 1))
    (hz : ∀ x : ℝ, x ∈ Ioo 0 1 → f (x : ℂ) = 0) :
