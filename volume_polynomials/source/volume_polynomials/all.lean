theorem mixedVolume_facet_identity {n : ℕ}
    (K : Fin n → ConvexBody E) (D : FixedFacets (fun j => (K j : Set E)))
    (h0 : ∀ j, (0 : E) ∈ K j) (hint : (0 : E) ∈ interior (∑ j, (K j : Set E)))
