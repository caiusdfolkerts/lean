    have hB := Real.sq_sqrt (show 0 ≤ μ.real (B : Set E) from measureReal_nonneg)
    have hsum := Real.sq_sqrt (show 0 ≤ μ.real (A + B : ConvexBody E) from measureReal_nonneg)
