    · simp [hx, abs_nonneg e.2]
    by_cases hy : e.2 = 0
    · simp [hy, abs_nonneg e.1]
    have h := HalfZonotope.atom_exponential_moments (abs_pos.mpr hx) (abs_pos.mpr hy)
