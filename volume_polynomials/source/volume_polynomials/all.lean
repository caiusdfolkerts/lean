      ⟨by simpa only [Measure.restrict_apply_univ] using hZ.measure_lt_top⟩
    apply (integrable_const C).mono' (concave_aestronglyMeasurable hf)
    filter_upwards [ae_restrict_mem hZ.measurableSet] with x hx
    exact hb x hx

