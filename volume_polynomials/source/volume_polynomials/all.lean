    throwError "LOCAL IMPORT AUDIT FAILED: {violations.size} undeclared local dependencies; complete ownership and violation records were written to the audit report."
  logInfo m!"LOCAL IMPORT AUDIT PASSED: {ordinaryCount} declarations across {modules.size} original sources; no undeclared local dependencies."

