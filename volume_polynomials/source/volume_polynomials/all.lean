variable {X S : Type*}

/-- Any multiset with as many entries as a finite type can be enumerated by that type. -/
theorem exists_map_univ_eq [Fintype X] (s : Multiset S) (h : s.card = Fintype.card X) :
    ∃ f : X → S, Finset.univ.val.map f = s := by
  first
