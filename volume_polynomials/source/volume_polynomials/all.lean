    (hp : ∀ i, 0 < h₀ i) (hc : IsCompact (body l h₀))
    (H : Fin d → Fin m → ℝ) : Fin d → ConvexBody E :=
  fun j => bodyAtHeight l h₀ hp hc (H j)

