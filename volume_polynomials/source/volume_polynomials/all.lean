theorem rawGeometricGenerators_product (n : ℕ) :
    ∀ v ∈ rawGeometricGenerators n,
      4 * (v.1 * (-v.2)) = (4 : ℝ) ^ n := by
  first
  | induction n with
    | zero => simp [rawGeometricGenerators]
    | succ n ih =>
