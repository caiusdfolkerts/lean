    volume.real (forcedBody lam hlam₀ hlam₁ : Set (ℝ × ℝ)) = realAreaSeries angle lam := by
  first
  | rw [forcedBody, area_infinite_segment_series, weighted_determinant_series lam hlam₀ hlam₁]

