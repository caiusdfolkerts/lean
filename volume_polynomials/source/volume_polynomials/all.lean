  first
  | constructor
    · ext t
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact ⟨hx.1, by linarith [hx.2.1, hx.2.2]⟩
      · intro ht
        exact ⟨(t, 0), ⟨ht.1, le_rfl, by simpa using ht.2⟩, rfl⟩
    · ext t
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact ⟨hx.2.1, by linarith [hx.1, hx.2.2]⟩
      · intro ht
