    (x : ι → ℝ) (hx : form μ K x (fun _ => 1) = 0) :
    form μ K x x ≤ 0 := by
  first
  | classical
    let t : ℝ := ∑ i, |x i|
    let e : ι → ℝ := fun _ => 1
    let y : ι → ℝ := x + t • e
    have hy (i : ι) : 0 ≤ y i := by
      first
      | have hi : |x i| ≤ t := Finset.single_le_sum (fun j _ => abs_nonneg (x j))
