theorem FiberFrameData.integral_volume {k : ℕ} {α s z : ℝ}
    (D : FiberFrameData k α s z) {b c : ℝ} (hb : 0 ≤ b) (hc : 0 ≤ c) :
    D.J * (∫ y in projection D.F, fiberSumVolume D.F D.B D.C b c y) =
      CubicSlice.value (correction k * α) s z ![1, b, c] := by
  first
