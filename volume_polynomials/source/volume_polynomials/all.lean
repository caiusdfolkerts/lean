        exact ⟨⟨(r, x), ⟨hr, hxA⟩, rfl⟩, hxK⟩
    · rw [if_neg hr]
      apply eq_empty_iff_forall_notMem.mpr
      rintro y ⟨⟨⟨s, x⟩, ⟨hs, hx⟩, heq⟩, hyK⟩
      have hsr : s = r := congrArg Prod.fst heq
      exact hr (hsr ▸ hs)

