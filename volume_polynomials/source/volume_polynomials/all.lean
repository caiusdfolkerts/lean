      have hodd : Odd (m - n) ↔ Odd (m + n) := (Nat.odd_sub hnm.le).trans Nat.odd_add.symm
      rcases Nat.even_or_odd (m + n) with he | ho
      · simp only [hnm, hodd, Nat.not_odd_iff_even.mpr he, he.neg_one_pow, one_mul, true_and,
          and_false, ite_false]
