    intro i _
    rw [mixedArea_smul_left μ _ _ (hx i), mixedArea_sum_right, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [mixedArea_smul_right μ _ _ (hy j)]
    ring

theorem form_one_one {ι : Type*} [Fintype ι] (K : ι → ConvexBody E) :
