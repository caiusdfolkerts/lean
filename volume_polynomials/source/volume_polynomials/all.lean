        (fun k hik hkj => hlog k (by omega) (by omega))
        (i - 1) j le_rfl (by omega) (by omega)
      have hip : i - 1 + 1 = i := by omega
      rw [hip] at hrat
      have hx := (div_le_div_iff₀ (hpos j (by omega) (by omega)) hleftpos).mp hrat
      simpa only [mul_comm] using hx

