def AdditiveOn (f : V → ℝ) : Prop :=
  ∀ a ∈ C, ∀ b ∈ C, f (a + b) = f a + f b

def PositiveHomogeneousOn (f : V → ℝ) : Prop :=
  ∀ r : ℝ, 0 < r → ∀ x ∈ C, f (r • x) = r * f x

