      intro i
      have hnot : ¬ ∀ x : E, l i x = 0 := by
        intro hz
        apply D.facets.normal_ne_zero i
        ext x
        exact hz x
      obtain ⟨x, hx⟩ := not_forall.mp hnot
      refine ⟨(l i x)⁻¹ • x, ?_⟩
      simp only [map_smul, smul_eq_mul, inv_mul_cancel₀ hx]
