      ← ENNReal.orderIsoRpow_apply _ hθ₀, OrderIso.map_iSup, OrderIso.map_iSup, ENNReal.iSup_mul]
    exact iSup_le fun m ↦ by
      rw [ENNReal.mul_iSup]
