    (hv : T v = (1, 0)) (t : ℝ) :
    T '' ((fun s : ℝ => s • v) '' Icc 0 t) = horizontal t := by
  rw [Set.image_image]
  ext p
  constructor
  · rintro ⟨s, hs, hsp⟩
    have heq : (s, (0 : E)) = p := by
      simpa only [Function.comp_apply, map_smul, hv, Prod.smul_mk,
        smul_eq_mul, mul_one, smul_zero] using hsp
    rw [← heq]
    exact ⟨hs, rfl⟩
