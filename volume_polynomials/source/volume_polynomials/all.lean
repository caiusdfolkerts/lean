      refine ⟨(q.1 - sInf J, 0), ⟨?_, rfl⟩, ?_⟩
      · rw [hwidth]
        exact ⟨by linarith [hqJ.1], by linarith [hqJ.2]⟩
      · ext <;> simp [diagonalLinear_apply] <;> ring
