    (atomWeight (interactionEdge b c) : ℝ) =
      (atomWeight b : ℝ) * (atomWeight c : ℝ) := by
  first
  | change Real.sqrt (|(interactionEdge b c).1| * |(interactionEdge b c).2|) =
      Real.sqrt (|b.1| * |b.2|) * Real.sqrt (|c.1| * |c.2|)
