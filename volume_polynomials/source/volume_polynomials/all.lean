theorem exists_continuous_ordered_roots_of_preconnectedSpace [PreconnectedSpace B] [Nonempty B]
    (hF : ∀ i ≤ d, Continuous (fun x => (F x).coeff i))
    (hdeg : ∀ x, (F x).degree = d)
    (hcard : ∀ x₀, ∀ᶠ x in 𝓝 x₀,
