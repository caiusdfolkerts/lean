      first
      | have hK : Continuous (fun eps : ℝ => axisBody (axes eps)) :=
          (continuous_axisBody n).comp hcaxes
        have hsum : Continuous (fun eps : ℝ => t • body n + s • axisBody (axes eps)) :=
          continuous_const.fun_add (hK.fun_const_smul s)
