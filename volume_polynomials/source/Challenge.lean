/-! # Volume polynomials and the Heine-Shephard problem
The geometric semantics are literal convex sets, Lebesgue volume, and equality
at every nonnegative real Minkowski weight. The entry compares all principal
claims, including the exact shape series, countable characterization, strict
separation, finite certificates, rejection, and whole-sequence reconstruction.
Three algorithm values are supplied through Comparator definition_names;
no geometric concept or realizability predicate is left unspecified.
-/

@[expose] public section
noncomputable section
open Set MeasureTheory Filter Metric Polynomial
open scoped BigOperators Pointwise Topology
namespace TauCeti
open MvPolynomial
variable {σ τ R : Type*} [CommRing R] [LinearOrder R]
/-- Membership in the finite Boolean algebra generated by polynomial zero sets and strict positivity sets. -/
def IsSemialgebraic (s : Set (σ → R)) : Prop :=
  s ∈ generateSetAlgebra
    (range (fun p : MvPolynomial σ R => {x | eval x p = 0}) ∪
      range (fun p : MvPolynomial σ R => {x | 0 < eval x p}))
end TauCeti

namespace VolumePolynomials
/-- Literal real coordinate space. -/
abbrev Space (d : ℕ) := Fin d → ℝ

/-- An actual nonempty compact convex subset of coordinate space. -/
abbrev Body (d : ℕ) := ConvexBody (Space d)

/-- Exactly the ordinary monomials of total degree d. -/
abbrev MultiIndex (n d : ℕ) :=
  {α : Fin n → Fin (d + 1) // ∑ i, (α i : ℕ) = d}

/-- The complete real array of ordinary degree-d coefficients. -/
abbrev Coefficients (n d : ℕ) := MultiIndex n d → ℝ

/-- The ordinary homogeneous polynomial evaluated at all weights. -/
def evaluate {n d : ℕ} (c : Coefficients n d) (t : Fin n → ℝ) : ℝ :=
  ∑ α, c α * ∏ i, t i ^ (α.1 i : ℕ)

/-- The actual weighted Minkowski sum of the convex bodies. -/
def weightedSum {n d : ℕ} (K : Fin n → Body d) (t : Fin n → ℝ) : Body d :=
  ∑ i, t i • K i

/-- Actual Lebesgue volume of the literal body. -/
def bodyVolume {d : ℕ} (K : Body d) : ℝ := volume.real (K : Set (Space d))

/-- Actual volume of the weighted Minkowski sum. -/
def volumeFunction {n d : ℕ} (K : Fin n → Body d) (t : Fin n → ℝ) : ℝ :=
  bodyVolume (weightedSum K t)

/-- Equality of the polynomial and actual volume at every nonnegative real weight. -/
def Realizes {n d : ℕ} (K : Fin n → Body d) (c : Coefficients n d) : Prop :=
  ∀ t : Fin n → ℝ, (∀ i, 0 ≤ t i) → evaluate c t = volumeFunction K t

/-- Existence of an actual nonempty compact convex tuple realizing all coefficients. -/
def VolumeLocus (n d : ℕ) : Set (Coefficients n d) := {c | ∃ K, Realizes K c}

namespace PolytopeGeometry
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
/-- The actual set is the convex hull of a finite set. -/
def IsFiniteHull (C : Set E) : Prop := ∃ S : Set E, S.Finite ∧ C = convexHull ℝ S
end PolytopeGeometry
open PolytopeGeometry
/-- A literal finite convex hull with nonempty ambient interior. -/
def FullDimensionalPolytope {d : ℕ} (K : Body d) : Prop :=
  IsFiniteHull (K : Set (Space d)) ∧ (interior (K : Set (Space d))).Nonempty
/-- The coefficient locus of actual tuples of full-dimensional polytopes. -/
def FullDimensionalPolytopeLocus (n d : ℕ) : Set (Coefficients n d) :=
  {c | ∃ K : Fin n → Body d, (∀ i, FullDimensionalPolytope (K i)) ∧ Realizes K c}
end VolumePolynomials

namespace VolumePolynomials.Holonomy
/-- The product-coordinate plane. -/
abbrev Plane := ℝ × ℝ
/-- The three-dimensional coordinate space. -/
abbrev ThreeSpace := Fin 3 → ℝ
/-- The literal irrational-rotation return matrix in the paper. -/
def returnMap (p : ℝ × ℝ) : ℝ × ℝ := (p.2, -p.1 + (2 / 3 : ℝ) * p.2)
/-- Orbit of the generating vector (1,0) under the return matrix. -/
def orbit : ℕ → ℝ × ℝ
  | 0 => (1, 0)
  | n + 1 => returnMap (orbit n)
/-- The geometric weighting of the explicit rotation orbit. -/
def weightedOrbit (lam : ℝ) (n : ℕ) : ℝ × ℝ := lam ^ n • orbit n
/-- The paper angle arccos(1/3). -/
def angle : ℝ := Real.arccos (1 / 3)
/-- Equality with the translated image under an injective continuous linear map. -/
def AffineCopy (S : Set Plane) (T : Set ThreeSpace) : Prop :=
  ∃ v : ThreeSpace, ∃ f : Plane →L[ℝ] ThreeSpace,
    Function.Injective f ∧ T = v +ᵥ f '' S
/-- The whole exposed face of a nonzero functional is a nondegenerate segment. -/
def IsExposedEdge {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (K F : Set E) : Prop :=
  ∃ l : E →L[ℝ] ℝ, l ≠ 0 ∧ F = l.toExposed K ∧
    ∃ a v : E, v ≠ 0 ∧
      F = {x | ∃ t : Icc (-(1 / 2 : ℝ)) (1 / 2 : ℝ), x = a + (t : ℝ) • v}
end VolumePolynomials.Holonomy

namespace VolumePolynomials
/-- An independent coefficient in [-1/2,1/2] for every segment. -/
abbrev SegmentChoice := ℕ → Icc (- (1/2 : ℝ)) (1/2 : ℝ)
section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
/-- The actual sum of the chosen scaled segment vectors. -/
noncomputable def seriesPoint (u : ℕ → E) (t : SegmentChoice) : E :=
  ∑' n, (t n : ℝ) • u n
/-- The literal infinite Minkowski sum, as the range of all segment choices. -/
def segmentSeries (u : ℕ → E) : Set E := Set.range (seriesPoint u)
end
/-- The explicit forced planar set, without bundling a proof of compact convexity. Its carrier is identical to source forcedBody. -/
def PalomarForcedSet (lam : ℝ) : Set (ℝ × ℝ) :=
  segmentSeries (Holonomy.weightedOrbit lam)
/-- Continuous extension across a neighborhood of a point of the complex unit circle. -/
def HasLocalContinuousExtension (F : ℂ → ℂ) (ζ : ℂ) : Prop :=
  ∃ δ > 0, ∃ g : ℂ → ℂ, ContinuousOn g (ball ζ δ) ∧
    ∀ z ∈ ball ζ δ, ‖z‖ < 1 → g z = F z

/-- The explicit rational Chebyshev coefficients for the normalized sine series. -/
def rationalSineCoefficient : ℕ → ℚ
  | 0 => 0
  | n + 1 => |(Polynomial.Chebyshev.U ℚ (n : ℤ)).eval (1 / 3)|

/-- The ordinary finite Cauchy convolution of two rational sequences. -/
def rationalConvolution (a b : ℕ → ℚ) (n : ℕ) : ℚ :=
  ∑ p ∈ Finset.antidiagonal n, a p.1 * b p.2

/-- The rational Taylor coefficients of the complete area generating function. -/
def areaTaylorCoefficient : ℕ → ℚ :=
  rationalConvolution (rationalConvolution rationalSineCoefficient (fun _ => 1))
    (fun n => (-1) ^ n)

/-- The actual complex sine generating series. -/
noncomputable def sineGeneratingFunction (θ : ℝ) (z : ℂ) : ℂ :=
  ∑' n : ℕ, ((|Real.sin ((n + 1 : ℕ) * θ)| : ℝ) : ℂ) * z^(n + 1)

/-- The complete complex area extension, with its exact denominator. -/
noncomputable def areaGeneratingFunction (θ : ℝ) (z : ℂ) : ℂ :=
  sineGeneratingFunction θ z / ((1 - z ^ 2) * (Real.sin θ : ℂ))

/-- The displayed real area series on the unit interval. -/
def realAreaSeries (θ lam : ℝ) : ℝ :=
  (∑' n : ℕ, |Real.sin (((n + 1 : ℕ) : ℝ) * θ)| * lam ^ (n + 1)) /
    ((1 - lam ^ 2) * Real.sin θ)

/-- Actual real-function germs on a punctured right-hand neighborhood of zero. -/
abbrev PositiveRealGerm := Germ (𝓝[>] (0 : ℝ)) ℝ

/-- Polynomial evaluation in actual function germs. -/
noncomputable def germPolynomialEvaluation {α : Type*} (l : Filter α) (s : α → ℝ) :
    ℝ[X] →+* Germ l ℝ :=
  (Germ.coeRingHom l).comp (RingHom.pi fun x => Polynomial.evalRingHom (s x))

theorem positive_nhds_le_cofinite : (𝓝[>] (0 : ℝ)) ≤ Filter.cofinite := by
  first
  | apply le_trans _ (nhdsNE_le_cofinite (0 : ℝ))
    exact nhdsWithin_mono 0 (fun x hx => ne_of_gt hx)

theorem polynomial_evaluation_germ_isUnit (p : Polynomial ℝ) (hp : p ≠ 0) :
    IsUnit (germPolynomialEvaluation (𝓝[>] (0 : ℝ)) id p) := by
  first
  | have hne : ∀ᶠ x : ℝ in 𝓝[>] 0, p.eval x ≠ 0 :=
      (Polynomial.eventually_eval_ne_zero_cofinite hp).filter_mono positive_nhds_le_cofinite
    apply isUnit_iff_exists_inv.mpr
    refine ⟨Germ.ofFun (fun x : ℝ => (p.eval x)⁻¹), ?_⟩
    change Germ.ofFun (fun x : ℝ => p.eval x * (p.eval x)⁻¹) =
      (Germ.ofFun (fun _ : ℝ => (1 : ℝ)) : PositiveRealGerm)
    apply Germ.coe_eq.mpr
    filter_upwards [hne] with x hx
    exact mul_inv_cancel₀ hx

/-- Evaluation of rational functions into actual punctured-right germs by localization. -/
def rationalFunctionGermEvaluation : RatFunc ℝ →+* PositiveRealGerm :=
  IsLocalization.lift (S := RatFunc ℝ) (M := nonZeroDivisors (Polynomial ℝ))
    (g := germPolynomialEvaluation (𝓝[>] (0 : ℝ)) id)
    (fun p => polynomial_evaluation_germ_isUnit p (nonZeroDivisors.ne_zero p.property))
/-- The literal rational-function-field algebra structure induced by evaluation. -/
def rationalFunctionGermAlgebra : Algebra (RatFunc ℝ) PositiveRealGerm :=
  rationalFunctionGermEvaluation.toAlgebra
end VolumePolynomials

namespace VolumePolynomials.ShapeConditions
/-- The nine body labels. -/
abbrev Label := Fin 9

/-- Two real parameters and every ordinary cubic coefficient. -/
abbrev Variable := Fin 2 ⊕ MultiIndex 9 3

/-- Rational polynomials in both parameters and all ordinary coefficients. -/
abbrev RationalPolynomial := MvPolynomial Variable ℚ

/-- The distinguished body index six. -/
def bodyA : Label := 6

/-- Literal substitution of the two parameters and complete coefficient array. -/
def assignment (lam a : ℝ) (c : Coefficients 9 3) : Variable → ℝ :=
  Sum.elim (fun i => if i = 0 then lam else a) c

/-- The ring homomorphism evaluating the finite rational shape constraints. -/
def polynomialValue (lam a : ℝ) (c : Coefficients 9 3) : RationalPolynomial →+* ℝ :=
  MvPolynomial.eval₂Hom (algebraMap ℚ ℝ) (assignment lam a c)
end VolumePolynomials.ShapeConditions

namespace VolumePolynomials.Main
open ShapeConditions Holonomy
/-- Satisfaction of all finite rational equality and strict inequality constraints. -/
def SatisfiesShapeSystem (P Q : List RationalPolynomial)
    (lam a : ℝ) (c : Coefficients 9 3) : Prop :=
  (∀ p ∈ P, polynomialValue lam a c p = 0) ∧
  (∀ q ∈ Q, 0 < polynomialValue lam a c q)

/-- Supplied algorithm value: the source executable rational matrix enumerator
`Main.volumeInequalityMatrix`, whose exact implementation is retained in the
full development. The compared statements constrain it on every coefficient
vector by the exact volume-locus equivalence and finite certificates. -/
def volumeInequalityMatrix (n d k : ℕ) : MultiIndex n d → MultiIndex n d → ℚ := by sorry
/-- Supplied polynomial representation of the same source enumerator.
The compared characterization requires homogeneous rational degree-two forms
and exact equivalence with geometric realizability for every positive dimension. -/
def volumeInequalityPolynomial (n d k : ℕ) : MvPolynomial (MultiIndex n d) ℚ := by sorry
end VolumePolynomials.Main

namespace VolumePolynomials.RationalCertificates
variable {ι : Type*} [Fintype ι]
/-- The rational quadratic form evaluated exactly on rational input. -/
def quadraticValue (M : ι → ι → ℚ) (q : ι → ℚ) : ℚ :=
  ∑ i, ∑ j, M i j * q i * q j

/-- The same rational quadratic form evaluated on real input. -/
def realQuadratic (M : ι → ι → ℚ) (c : ι → ℝ) : ℝ :=
  ∑ i, ∑ j, (M i j : ℝ) * c i * c j

/-- The explicit rational interval-error bound. -/
def quadraticError (M : ι → ι → ℚ) (q : ι → ℚ) (δ : ℚ) : ℚ :=
  ∑ i, ∑ j, |M i j| * δ * (|q i| + |q j| + δ)

/-- The rational input precision 1/(h+1). -/
def precision (h : ℕ) : ℚ := 1 / ((h : ℚ) + 1)

/-- A rational approximation with the stated error at every precision and coordinate. -/
def IsName (c : ι → ℝ) (a : ℕ → ι → ℚ) : Prop :=
  ∀ h i, |c i - (a h i : ℝ)| ≤ (precision h : ℝ)

/-- A negative coordinate or negative quadratic, each with one finite precision. -/
abbrev Certificate (ι : Type*) := (ι × ℕ) ⊕ (ℕ × ℕ)

/-- The explicit strict rational validity test for a finite certificate. -/
def Valid (matrices : ℕ → ι → ι → ℚ) (a : ℕ → ι → ℚ) : Certificate ι → Prop
  | .inl (i, h) => a h i + precision h < 0
  | .inr (k, h) => quadraticValue (matrices k) (a h) +
      quadraticError (matrices k) (a h) (precision h) < 0
instance validDecidable (matrices : ℕ → ι → ι → ℚ) (a : ℕ → ι → ℚ)
    (cert : Certificate ι) : Decidable (Valid matrices a cert) := by
  cases cert <;> unfold Valid <;> infer_instance
/-- The exact finite-code enumeration of valid rational certificates. -/
def enumerate [Encodable ι] (matrices : ℕ → ι → ι → ℚ) (a : ℕ → ι → ℚ)
    (j : ℕ) : Option (Certificate ι) :=
  match Encodable.decode j with
  | none => none
  | some cert => if Valid matrices a cert then some cert else none
end VolumePolynomials.RationalCertificates

namespace VolumePolynomials.RationalHulls
/-- A finite rational vertex. -/
abbrev RationalPoint (d : ℕ) := Fin d → ℚ

/-- Coordinatewise inclusion of a rational vertex into real space. -/
def realPoint {d : ℕ} (x : RationalPoint d) : Space d := fun i => (x i : ℝ)

/-- The actual real vertices represented by a rational list. -/
def vertices {d : ℕ} (L : List (RationalPoint d)) : Set (Space d) :=
  realPoint '' {x | x ∈ L}

/-- The actual convex hull of the finite rational vertices. -/
def hull {d : ℕ} (L : List (RationalPoint d)) : Set (Space d) := convexHull ℝ (vertices L)

theorem realPoint_zero (d : ℕ) : realPoint (0 : RationalPoint d) = (0 : Space d) := by
  first
  | funext i
    change ((0 : ℚ) : ℝ) = 0
    exact Rat.cast_zero
theorem vertices_finite {d : ℕ} (L : List (RationalPoint d)) : (vertices L).Finite := by
  first
  | simpa only [vertices, List.coe_toFinset] using L.toFinset.finite_toSet.image realPoint
/-- The actual rational convex hull as a compact convex body, with zero among its vertices. -/
noncomputable def body {d : ℕ} (L : List (RationalPoint d)) (hL : 0 ∈ L) : Body d where
  carrier := hull L
  convex' := convex_convexHull ℝ _
  isCompact' := (vertices_finite L).isCompact_convexHull ℝ
  nonempty' := ⟨(0 : Space d),
    subset_convexHull ℝ _ ⟨(0 : RationalPoint d), hL, realPoint_zero d⟩⟩
end VolumePolynomials.RationalHulls

namespace VolumePolynomials.RationalReconstruction
open RationalHulls
/-- A tuple of finite rational vertex lists with a fixed computable order. -/
structure State (n d : ℕ) where
  vertices : Fin n → List (RationalPoint d)
  deriving DecidableEq

instance stateEncodable (n d : ℕ) : Encodable (State n d) :=
  Encodable.ofEquiv (Fin n → List (RationalPoint d))
    { toFun := State.vertices
      invFun := State.mk
      left_inv := fun s => by cases s; rfl
      right_inv := fun _ => rfl }

instance stateLinearOrder (n d : ℕ) : LinearOrder (State n d) :=
  LinearOrder.lift' Encodable.encode Encodable.encode_injective

instance stateInhabited (n d : ℕ) : Inhabited (State n d) := ⟨⟨fun _ => [0]⟩⟩

/-- The actual rational hulls returned by a finite output state. -/
noncomputable def stateBodies {n d : ℕ} (s : State n d) : Fin n → Body d :=
  fun i => if h : 0 ∈ s.vertices i then body (s.vertices i) h else 0
/-- Supplied algorithm value: the complete source rational reconstruction
procedure, including its input-derived radius and finite path selection.
The compared theorem constrains every output on every valid rational input
name: convergence of the whole sequence, exact realization, rejection iff
nonrealizability, and literal rational-hull output semantics. -/
def reconstruct (n d : ℕ) (a : ℕ → MultiIndex n d → ℚ) (h : ℕ) : Option (State n d) := by sorry
end VolumePolynomials.RationalReconstruction

open VolumePolynomials VolumePolynomials.Main VolumePolynomials.ShapeConditions
