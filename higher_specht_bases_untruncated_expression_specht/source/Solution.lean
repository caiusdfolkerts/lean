module

public import higher_specht.verified.remaining04_geometry_complete

@[expose] public section
noncomputable section
open TauCeti Finset MvPolynomial
open scoped BigOperators

namespace HigherSpecht

/-- The Specht representation of this shape, presented as the left ideal
generated by the row symmetrizer times the column antisymmetrizer. -/
abbrev paperYoungIdealRepresentation {n : ℕ} (part : n.Partition)
    (T : YoungTableau (YoungDiagram.ofPartition part)) :=
  Representation.ofModule' (k := ℂ) (G := Equiv.Perm (Fin n))
    (Ideal.span {(MonoidAlgebra.domCongr ℂ ℂ
        (finCongr (YoungDiagram.card_ofPartition part)).permCongrHom
        (TauCeti.YoungTableau.youngSymmetrizerOver ℂ T))} :
      Ideal (MonoidAlgebra ℂ (Equiv.Perm (Fin n))))

/-- The displayed higher Specht vectors for every untruncated ideal expression
are actual irreducible copies of the indicated partition's Specht representation. -/
theorem untruncated_expression_specht_spans {n : ℕ} (e : UntruncatedIdealExpression n)
    (i : UnboundedHarmonicIndex n) (hi : i ∈ e.eligible) :
    ∃ T0 : YoungTableau (YoungDiagram.ofPartition i.part),
    ∃ W : Subrepresentation (quotientRepresentation (e.ideal ℂ) (e.permutationStable ℂ)),
      W.toSubmodule =
        Submodule.span ℂ (Set.range
          (fun T : StandardYoungTableau (YoungDiagram.ofPartition i.part) =>
            Ideal.Quotient.mk (e.ideal ℂ) (unboundedMasterPolynomial i T))) ∧
      (∀ T : StandardYoungTableau (YoungDiagram.ofPartition i.part),
        W.toSubmodule =
          Submodule.span ℂ (Set.range (fun g : Equiv.Perm (Fin n) =>
            quotientRepresentation (e.ideal ℂ) (e.permutationStable ℂ) g
              (Ideal.Quotient.mk (e.ideal ℂ) (unboundedMasterPolynomial i T))))) ∧
      W.toRepresentation.IsIrreducible ∧
      Nonempty (Representation.Equiv (paperYoungIdealRepresentation i.part T0) W.toRepresentation) := by
  obtain ⟨hs, hc, hirr, _⟩ := e.corollary_6_7_specht_copy i hi
  refine ⟨(StandardYoungTableau.rowSuperstandard _).toTableau, e.fixedSpechtCopy i, hs, hc, hirr, ?_⟩
  exact ⟨(complexYoungIdealSpechtEquiv i.part).trans (e.fixedSpechtCopyEquiv i hi)⟩

end HigherSpecht
