module

public import higher_specht.verified.remaining04_geometry_complete

@[expose] public section
noncomputable section
open TauCeti Finset MvPolynomial
open scoped BigOperators

namespace HigherSpecht

/-- The Specht representation of this shape, presented as the left ideal
generated by the row symmetrizer times the column antisymmetrizer. -/
abbrev paperYoungIdealRepresentation {n : ℕ} (part : n.Partition)
    (T : YoungTableau (YoungDiagram.ofPartition part)) :=
  Representation.ofModule' (k := ℂ) (G := Equiv.Perm (Fin n))
    (Ideal.span {(MonoidAlgebra.domCongr ℂ ℂ
        (finCongr (YoungDiagram.card_ofPartition part)).permCongrHom
        (TauCeti.YoungTableau.youngSymmetrizerOver ℂ T))} :
      Ideal (MonoidAlgebra ℂ (Equiv.Perm (Fin n))))

theorem griffin_graded_specht_character {n s : ℕ} (e : GriffinIdealExpression n s)
    (hs : 0 < s) (d : ℕ) :
    ∃ T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part),
    ∃ f : Fintype {i : FiniteHarmonicIndex n s // i ∈ e.eligible ∧ i.toUnboundedHarmonicIndex.degree = d},
    ∀ g : Equiv.Perm (Fin n),
      letI := f
      (homogeneousQuotientSubrepresentation (e.ideal ℂ)
        (e.permutationStable ℂ) d).toRepresentation.character g =
        ∑ i : {i : FiniteHarmonicIndex n s // i ∈ e.eligible ∧ i.toUnboundedHarmonicIndex.degree = d},
          (paperYoungIdealRepresentation i.val.part (T i.val.part)).character g := by
  classical
  let T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part) :=
    fun part => (StandardYoungTableau.rowSuperstandard _).toTableau
  refine ⟨T, (inferInstance : Fintype (e.DegreeCopyIndex d)), ?_⟩
  intro g
  change (e.gradedPiece d).toRepresentation.character g = _
  rw [e.character_gradedPiece hs d g]
  apply Finset.sum_congr rfl
  intro i hi
  exact (congrFun (Representation.char_iso (complexYoungIdealSpechtEquiv i.val.part)) g).symm

theorem untruncated_graded_specht_character {n : ℕ} (e : UntruncatedIdealExpression n)
    (d : ℕ) :
    ∃ T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part),
    ∃ f : Fintype {i : UnboundedHarmonicIndex n // i ∈ e.eligible ∧ i.degree = d},
    ∀ g : Equiv.Perm (Fin n),
      letI := f
      (homogeneousQuotientSubrepresentation (e.ideal ℂ)
        (e.permutationStable ℂ) d).toRepresentation.character g =
        ∑ i : {i : UnboundedHarmonicIndex n // i ∈ e.eligible ∧ i.degree = d},
          (paperYoungIdealRepresentation i.val.part (T i.val.part)).character g := by
  classical
  let T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part) :=
    fun part => (StandardYoungTableau.rowSuperstandard _).toTableau
  refine ⟨T, (inferInstance : Fintype (e.DegreeCopyIndex d)), ?_⟩
  intro g
  change (e.gradedPiece d).toRepresentation.character g = _
  rw [e.character_gradedPiece d g]
  apply Finset.sum_congr rfl
  intro i hi
  exact (congrFun (Representation.char_iso (complexYoungIdealSpechtEquiv i.val.part)) g).symm

/-- The full Springer intersection character in each degree. The real ideal
and its defining eligibility condition are both specified. -/
theorem springer_intersection_graded_specht_character {n : ℕ} (hn : 0 < n)
    (A : Finset n.Partition) (hA : A.Nonempty) (d : ℕ) :
    ∃ e : GriffinIdealExpression n n,
      e.ideal ℂ = springerIntersectionIdeal ℂ A ∧
      (∀ i : FiniteHarmonicIndex n n, i ∈ e.eligible ↔
        i.multiplier = ⊥ ∧ ∃ part ∈ A, CatDominates i.left (YoungDiagram.ofPartition part)) ∧
      ∃ T : (part : n.Partition) → YoungTableau (YoungDiagram.ofPartition part),
      ∃ f : Fintype {z : SpringerIntersectionLeftIndex A // cochargeDegree z.val.2 = d},
      ∀ g : Equiv.Perm (Fin n),
        letI := f
        (homogeneousQuotientSubrepresentation (e.ideal ℂ)
          (e.permutationStable ℂ) d).toRepresentation.character g =
          ∑ z : {z : SpringerIntersectionLeftIndex A // cochargeDegree z.val.2 = d},
            (paperYoungIdealRepresentation z.val.val.1 (T z.val.val.1)).character g := by
  classical
  let e := springerIntersectionExpression A hA
  have helig (i : FiniteHarmonicIndex n n) := springerIntersectionExpression_eligible A hA i
  obtain ⟨T, F, hχ⟩ := griffin_graded_specht_character e hn d
  letI : Fintype (e.DegreeCopyIndex d) := F
  let E : e.DegreeCopyIndex d ≃ {z : SpringerIntersectionLeftIndex A //
      cochargeDegree z.val.2 = d} :=
    { toFun := fun i => ⟨⟨⟨i.val.part, i.val.left⟩,
        ((helig i.val).mp i.property.1).2⟩, by
          have hz := ((helig i.val).mp i.property.1).1
          simpa only [UnboundedHarmonicIndex.degree, hz, YoungDiagram.card,
            YoungDiagram.cells_bot, Finset.card_empty, Nat.add_zero] using i.property.2⟩
      invFun := fun z => ⟨springerCommonFiniteIndex hn z.val.val,
        (helig _).mpr ⟨rfl, z.val.property⟩, by
          change cochargeDegree z.val.val.2 + (⊥ : YoungDiagram).card = d
          simpa only [YoungDiagram.card, YoungDiagram.cells_bot, Finset.card_empty,
            Nat.add_zero] using z.property⟩
      left_inv := fun i => by
        apply Subtype.ext
        have hm := ((helig i.val).mp i.property.1).1
        rcases i with ⟨⟨⟨part, S, eta, he⟩, hd, hw⟩, hi⟩
        dsimp only at hm
        subst eta
        rfl
      right_inv := fun _ => rfl }
  let F' := Fintype.ofEquiv (e.DegreeCopyIndex d) E
  refine ⟨e, springerIntersectionExpression_ideal A hA, helig, T, F', ?_⟩
  intro g
  letI := F'
  exact (hχ g).trans (Equiv.sum_comp E
    (fun z => (paperYoungIdealRepresentation z.val.val.1 (T z.val.val.1)).character g))

end HigherSpecht
