        Real.rpow_neg hsum.det_pos.le]
      field_simp [(multivariateGamma_pos (p := p) (by linarith : ((p : ℝ) - 1) / 2 < α / 2)).ne',
        (multivariateGamma_pos (p := p) (by linarith : ((p : ℝ) - 1) / 2 < β / 2)).ne',
        (multivariateGamma_sum_degree_pos hα hβ).ne',
        (Real.rpow_pos_of_pos two_pos (α * (p : ℝ) / 2)).ne',
        (Real.rpow_pos_of_pos two_pos (β * (p : ℝ) / 2)).ne',
        (Real.rpow_pos_of_pos hY.det_pos (α / 2)).ne',
        (Real.rpow_pos_of_pos hsum.det_pos ((α + β) / 2)).ne'] <;> ring
