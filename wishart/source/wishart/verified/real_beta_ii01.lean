/- Source: Wishart/MatrixBetaIIConditionalMeans.lean -/



/-!
# Actual conditional determinant means in the beta-II hierarchy

The conditional expectation is represented by a standard Wishart determinant
and a single scalar scale argument.  It is a measurable extended-valued
nondecreasing function, even when some or all of its values are infinite.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification
open scoped Classical ENNReal MatrixOrder Matrix.Norms.L2Operator

noncomputable section

namespace Wishart

open Spectral

def determinantScaleMean (α : ℝ) (k : ℕ) (f : ℝ → ℝ≥0∞) (t : ℝ) : ℝ≥0∞ :=
  ∫⁻ Z : SymmetricMatrix k, f (t * (Z : Matrix (Fin k) (Fin k) ℝ).det)
    ∂nonsingularWishartMeasure α (1 : Matrix (Fin k) (Fin k) ℝ)

theorem measurable_determinantScaleMean {α : ℝ} {k : ℕ}
    (hα : (k : ℝ) - 1 < α) {f : ℝ → ℝ≥0∞} (hf : Measurable f) :
    Measurable (determinantScaleMean α k f) := by
  letI := isProbabilityMeasure_nonsingularWishartMeasure
    (S := (1 : Matrix (Fin k) (Fin k) ℝ)) Matrix.PosDef.one hα
  have hm : Measurable (fun z : ℝ × SymmetricMatrix k =>
      f (z.1 * (z.2 : Matrix (Fin k) (Fin k) ℝ).det)) := by
    apply hf.comp
    fun_prop
  exact hm.lintegral_prod_right

theorem monotoneOn_determinantScaleMean {α : ℝ} {k : ℕ}
    {f : ℝ → ℝ≥0∞} (hf : MonotoneOn f (Set.Ioi 0)) :
    MonotoneOn (determinantScaleMean α k f) (Set.Ioi 0) := by
  intro s hs t ht hst
  apply lintegral_mono_ae
  filter_upwards [ae_posDef_nonsingularWishartMeasure α
    (1 : Matrix (Fin k) (Fin k) ℝ)] with Z hZ
  exact hf (mul_pos hs hZ.det_pos) (mul_pos ht hZ.det_pos)
    (mul_le_mul_of_nonneg_right hst hZ.det_pos.le)

theorem det_sqrt_symmetricCongruence {k : ℕ}
    (S : SymmetricMatrix k) (hS : (S : Matrix (Fin k) (Fin k) ℝ).PosDef)
    (Z : SymmetricMatrix k) :
    (Matrix.symmetricCongruenceLinearMap (CFC.sqrt (S : Matrix (Fin k) (Fin k) ℝ)) Z :
      Matrix (Fin k) (Fin k) ℝ).det =
      (S : Matrix (Fin k) (Fin k) ℝ).det * (Z : Matrix (Fin k) (Fin k) ℝ).det := by
  have hsquare : (CFC.sqrt (S : Matrix (Fin k) (Fin k) ℝ)).det *
      (CFC.sqrt (S : Matrix (Fin k) (Fin k) ℝ)).det =
      (S : Matrix (Fin k) (Fin k) ℝ).det := by
    simpa only [Matrix.det_mul] using congrArg Matrix.det
      (CFC.sqrt_mul_sqrt_self (S : Matrix (Fin k) (Fin k) ℝ) hS.posSemidef.nonneg)
  rw [Matrix.coe_symmetricCongruenceLinearMap_apply, Matrix.det_mul,
    Matrix.det_mul, Matrix.det_transpose]
  calc
    _ = ((CFC.sqrt (S : Matrix (Fin k) (Fin k) ℝ)).det *
        (CFC.sqrt (S : Matrix (Fin k) (Fin k) ℝ)).det) *
        (Z : Matrix (Fin k) (Fin k) ℝ).det := by ring
    _ = _ := by rw [hsquare]

/-- The literal conditional marginal law, with no finite-moment condition. -/
theorem lintegral_compression_eq_determinantScaleMean {p k : ℕ} {α : ℝ}
    (hα : (p : ℝ) - 1 < α) (B : Matrix (Fin p) (Fin k) ℝ) (hB : B.rank = k)
    (Y : SymmetricMatrix p) (hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef)
    (f : ℝ → ℝ≥0∞) (hf : Measurable f) :
    (∫⁻ X : SymmetricMatrix p,
      f (Bᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B).det
        ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) =
      determinantScaleMean α k f (Bᵀ * (Y : Matrix (Fin p) (Fin p) ℝ) * B).det := by
  let S : SymmetricMatrix k := Matrix.symmetricCongruenceLinearMap Bᵀ Y
  have hS : (S : Matrix (Fin k) (Fin k) ℝ).PosDef := by
    simpa only [S, Matrix.coe_symmetricCongruenceLinearMap_apply,
      Matrix.transpose_transpose, compressionScale]
      using compressionScale_posDef hY B hB
  have hmap := map_symmetricCongruenceLinearMap_nonsingularWishartMeasure Bᵀ
    (by simpa only [Matrix.rank_transpose] using hB) hY hα
  rw [Matrix.transpose_transpose] at hmap
  have hm : Measurable (fun Z : SymmetricMatrix k =>
      f (Z : Matrix (Fin k) (Fin k) ℝ).det) := hf.comp (by fun_prop)
  calc
    _ = ∫⁻ Z : SymmetricMatrix k, f (Z : Matrix (Fin k) (Fin k) ℝ).det
        ∂nonsingularWishartMeasure α (S : Matrix (Fin k) (Fin k) ℝ) := by
      simp only [S, Matrix.coe_symmetricCongruenceLinearMap_apply, Matrix.transpose_transpose]
      rw [← hmap, lintegral_map hm (LinearMap.continuous_of_finiteDimensional _).measurable]
      simp only [Matrix.coe_symmetricCongruenceLinearMap_apply, Matrix.transpose_transpose]
    _ = determinantScaleMean α k f (S : Matrix (Fin k) (Fin k) ℝ).det := by
      rw [← map_sqrt_congruence_identityWishart α S hS,
        lintegral_map hm (LinearMap.continuous_of_finiteDimensional _).measurable]
      unfold determinantScaleMean
      apply lintegral_congr
      intro Z
      rw [det_sqrt_symmetricCongruence S hS Z]
    _ = _ := by
      simp only [S, Matrix.coe_symmetricCongruenceLinearMap_apply, Matrix.transpose_transpose]

def inverseMeanSpectralTest {p k : ℕ} (α : ℝ)
    (Omega : Matrix (Fin p) (Fin p) ℝ) (B : Matrix (Fin p) (Fin k) ℝ)
    (f : ℝ → ℝ≥0∞) (lam : Fin k → ℝ) : ℝ≥0∞ :=
  determinantScaleMean α k f ((compressionScale Omega B).det * ∏ j, max (lam j) 0)

theorem measurable_inverseMeanSpectralTest {p k : ℕ} {α : ℝ}
    (hα : (k : ℝ) - 1 < α) (Omega : Matrix (Fin p) (Fin p) ℝ)
    (B : Matrix (Fin p) (Fin k) ℝ) {f : ℝ → ℝ≥0∞} (hf : Measurable f) :
    Measurable (inverseMeanSpectralTest α Omega B f) :=
  (measurable_determinantScaleMean hα hf).comp (by fun_prop)

theorem monotoneOn_inverseMeanSpectralTest {p k : ℕ} {α : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (B : Matrix (Fin p) (Fin k) ℝ) (hB : B.rank = k)
    {f : ℝ → ℝ≥0∞} (hf : MonotoneOn f (Set.Ioi 0)) :
    MonotoneOn (inverseMeanSpectralTest α Omega B f) (positiveOrderedSpectrum k) := by
  intro lam hlam mu hmu hle
  have hscale := (compressionScale_posDef hOmega B hB).det_pos
  apply monotoneOn_determinantScaleMean hf
  · exact mul_pos hscale (Finset.prod_pos fun j _ => lt_of_lt_of_le (hlam.2 j) (le_max_left _ _))
  · exact mul_pos hscale (Finset.prod_pos fun j _ => lt_of_lt_of_le (hmu.2 j) (le_max_left _ _))
  · apply mul_le_mul_of_nonneg_left _ hscale.le
    apply Finset.prod_le_prod₀
    · intro j hj
      exact le_max_right _ _
    · intro j hj
      exact max_le_max (hle j) le_rfl

theorem inverseMeanSpectralTest_eq {p k : ℕ} (α : ℝ)
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (B : Matrix (Fin p) (Fin k) ℝ) (hB : B.rank = k) (f : ℝ → ℝ≥0∞)
    (Y : SymmetricMatrix p) (hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef) :
    inverseMeanSpectralTest α Omega B f
        (ascendingSpectrum (normalizedCompression Omega B Y)) =
      determinantScaleMean α k f (Bᵀ * (Y : Matrix (Fin p) (Fin p) ℝ) * B).det := by
  have hN := normalizedCompression_posDef hOmega B hB hY
  have hspec := ascendingSpectrum_mem_positiveOrderedSpectrum
    (normalizedCompression Omega B Y) hN
  have hdet := inverseCompressionDeterminant_normalized hOmega B hB 0 Y
  simp only [inverseCompressionDeterminant, inverseShiftedDeterminant, zero_smul, add_zero]
    at hdet
  unfold inverseMeanSpectralTest
  congr 1
  rw [hdet, det_eq_prod_ascendingSpectrum]
  congr 1
  apply Finset.prod_congr rfl
  intro j hj
  exact max_eq_left (hspec.2 j).le

end Wishart
end
end CanonicalSource3

section CanonicalSource4
/- Source: Wishart/MatrixBetaIIAssociation.lean -/



/-!
# Two-level product association for the actual matrix beta-II law

The intermediate theorem below has an explicit conditional Wishart comparison
premise.  The beta-II principal theorem must supply that premise using the
proved Wishart product theorem with its exact rank condition.  Everything else
here, including the mixture law and the extended conditional-mean association,
is derived from the actual measures.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification
open scoped Classical ENNReal MatrixOrder Matrix.Norms.L2Operator

noncomputable section

namespace Wishart

open Spectral

def compressionOuterProduct {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (f : Fin d → ℝ → ℝ≥0∞) (J : Finset (Fin d)) (X : SymmetricMatrix p) : ℝ≥0∞ :=
  ∏ i ∈ J, f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det

theorem measurable_compressionOuterProduct {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    {f : Fin d → ℝ → ℝ≥0∞} (hf : ∀ i, Measurable (f i)) (J : Finset (Fin d)) :
    Measurable (compressionOuterProduct k B f J) := by
  apply Finset.measurable_prod
  intro i hi
  exact (hf i).comp (by fun_prop)

/-- Internal two-level association.  Its only comparison premise is exactly
the conditional Wishart product inequality; the inverse-Wishart comparison is
proved, and the beta-II law is the density-defined measure. -/
theorem matrixBetaII_product_of_wishart_products {p d : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (f : Fin d → ℝ → ℝ≥0∞)
    (hfm : ∀ i, Measurable (f i)) (hfmono : ∀ i, MonotoneOn (f i) (Set.Ioi 0))
    (J : Finset (Fin d))
    (hconditional : ∀ Y : SymmetricMatrix p, (Y : Matrix (Fin p) (Fin p) ℝ).PosDef →
      (∏ i ∈ J, ∫⁻ X : SymmetricMatrix p,
        f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det
          ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) ≤
      ∫⁻ X, compressionOuterProduct k B f J X
        ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) :
    (∏ i ∈ J, ∫⁻ X : SymmetricMatrix p,
      f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det
        ∂matrixBetaIIMeasure α β Omega) ≤
      ∫⁻ X, compressionOuterProduct k B f J X ∂matrixBetaIIMeasure α β Omega := by
  let Φ (i : Fin d) := inverseMeanSpectralTest α Omega (B i) (f i)
  let T (i : Fin d) (Y : SymmetricMatrix p) :=
    ascendingSpectrum (normalizedCompression Omega (B i) Y)
  have hαk (i : Fin d) : (k i : ℝ) - 1 < α := by
    have hkp : k i ≤ p := by rw [← hB i]; exact (B i).rank_le_height
    have hcast : (k i : ℝ) ≤ p := Nat.cast_le.mpr hkp
    linarith
  have hΦm (i : Fin d) : Measurable (Φ i) :=
    measurable_inverseMeanSpectralTest (hαk i) Omega (B i) (hfm i)
  have hΦmono (i : Fin d) : MonotoneOn (Φ i) (positiveOrderedSpectrum (k i)) :=
    monotoneOn_inverseMeanSpectralTest hOmega (B i) (hB i) (hfmono i)
  have hcond (Y : SymmetricMatrix p) (hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef)
      (i : Fin d) : Φ i (T i Y) = ∫⁻ X : SymmetricMatrix p,
        f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det
          ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ) := by
    rw [lintegral_compression_eq_determinantScaleMean hα (B i) (hB i) Y hY (f i) (hfm i)]
    exact inverseMeanSpectralTest_eq α hOmega (B i) (hB i) (f i) Y hY
  have hsingle (i : Fin d) :
      (∫⁻ X : SymmetricMatrix p,
        f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det
          ∂matrixBetaIIMeasure α β Omega) =
        ∫⁻ Y, Φ i (T i Y) ∂inverseWishartMeasure β Omega := by
    have hm : Measurable (fun X : SymmetricMatrix p =>
        f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det) :=
      (hfm i).comp (by fun_prop)
    rw [lintegral_matrixBetaIIMeasure hOmega hα hβ
      (fun X : SymmetricMatrix p =>
        f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det) hm]
    apply lintegral_congr_ae
    filter_upwards [ae_posDef_inverseWishartMeasure β Omega] with Y hY
    exact (hcond Y hY i).symm
  calc
    _ = ∏ i ∈ J, ∫⁻ Y, Φ i (T i Y) ∂inverseWishartMeasure β Omega := by
      apply Finset.prod_congr rfl
      intro i hi
      exact hsingle i
    _ ≤ ∫⁻ Y, ∏ i ∈ J, Φ i (T i Y) ∂inverseWishartMeasure β Omega :=
      inverseCompression_ennreal_product hOmega hβ k B hB Φ hΦm (Or.inl hΦmono) J
    _ ≤ _ := by
      rw [lintegral_matrixBetaIIMeasure hOmega hα hβ _
        (measurable_compressionOuterProduct k B hfm J)]
      apply lintegral_mono_ae
      filter_upwards [ae_posDef_inverseWishartMeasure β Omega] with Y hY
      simp_rw [hcond Y hY]
      exact hconditional Y hY

def geometricOuterENN (f : ℝ → ℝ) (x : ℝ) : ℝ≥0∞ :=
  ENNReal.ofReal (positiveOuterExtension f x)

theorem measurable_geometricOuterENN {f : ℝ → ℝ} (hf : GeometricallyLogConvex f) :
    Measurable (geometricOuterENN f) :=
  (measurable_positiveOuterExtension hf).ennreal_ofReal

theorem geometricOuterENN_eq {f : ℝ → ℝ} {x : ℝ} (hx : 0 < x) :
    geometricOuterENN f x = ENNReal.ofReal (f x) := by
  rw [geometricOuterENN, positiveOuterExtension_eq hx]

theorem monotoneOn_geometricOuterENN {f : ℝ → ℝ} (hf : GeometricallyLogConvex f) :
    MonotoneOn (geometricOuterENN f) (Set.Ioi 0) := by
  intro x hx y hy hxy
  rw [geometricOuterENN_eq hx, geometricOuterENN_eq hy]
  exact ENNReal.ofReal_le_ofReal (hf.monotoneOn hx hy hxy)

theorem compressionOuterProduct_geometric_eq {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (hB : ∀ i, (B i).rank = k i)
    (f : Fin d → ℝ → ℝ) (hf : ∀ i, GeometricallyLogConvex (f i))
    (J : Finset (Fin d)) (X : SymmetricMatrix p)
    (hX : (X : Matrix (Fin p) (Fin p) ℝ).PosDef) :
    compressionOuterProduct k B (fun i => geometricOuterENN (f i)) J X =
      ENNReal.ofReal (∏ i ∈ J, f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det) := by
  have hpos (i : Fin d) : 0 < ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det :=
    (compressionScale_posDef hX (B i) (hB i)).det_pos
  rw [ENNReal.ofReal_prod_of_nonneg (fun i _ => ((hf i).positive _ (hpos i)).le)]
  apply Finset.prod_congr rfl
  intro i hi
  exact geometricOuterENN_eq (hpos i)

/-- The geometric outer-function form of the hierarchy assembly.  The named
conditional premise is supplied by the exact-rank Wishart theorem in the final
beta-II wrapper; it is not an added hypothesis of the manuscript's theorem. -/
theorem matrixBetaII_geometric_product_of_wishart_products {p d : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (f : Fin d → ℝ → ℝ)
    (hf : ∀ i, GeometricallyLogConvex (f i)) (J : Finset (Fin d))
    (hconditional : ∀ Y : SymmetricMatrix p, (Y : Matrix (Fin p) (Fin p) ℝ).PosDef →
      (∏ i ∈ J, ∫⁻ X : SymmetricMatrix p,
        ENNReal.ofReal (f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det)
          ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) ≤
      ∫⁻ X : SymmetricMatrix p,
        ENNReal.ofReal (∏ i ∈ J, f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det)
          ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) :
    (∏ i ∈ J, ∫⁻ X : SymmetricMatrix p,
      ENNReal.ofReal (f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det)
        ∂matrixBetaIIMeasure α β Omega) ≤
    ∫⁻ X : SymmetricMatrix p,
      ENNReal.ofReal (∏ i ∈ J, f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det)
        ∂matrixBetaIIMeasure α β Omega := by
  have hsingle (μ : Measure (SymmetricMatrix p))
      (hμ : ∀ᵐ (X : SymmetricMatrix p) ∂μ,
        (X : Matrix (Fin p) (Fin p) ℝ).PosDef) (i : Fin d) :
      (∫⁻ X : SymmetricMatrix p, geometricOuterENN (f i)
        ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det ∂μ) =
      ∫⁻ X : SymmetricMatrix p, ENNReal.ofReal
        (f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det) ∂μ := by
    apply lintegral_congr_ae
    filter_upwards [hμ] with X hX
    exact geometricOuterENN_eq (compressionScale_posDef hX (B i) (hB i)).det_pos
  have hjoint (μ : Measure (SymmetricMatrix p))
      (hμ : ∀ᵐ (X : SymmetricMatrix p) ∂μ,
        (X : Matrix (Fin p) (Fin p) ℝ).PosDef) :
