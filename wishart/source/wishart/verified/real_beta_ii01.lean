/-!
# Extended-valued inverse-Wishart spectral tests

Conditional moments in the beta-II hierarchy can be infinite at individual
conditioning matrices.  This module extends the nonnegative real-valued
inverse-Wishart association theorem to measurable extended-valued tests by
bounded truncation and monotone convergence.  No conditional integrability
assumption is introduced.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification Filter
open scoped Classical ENNReal Topology MatrixOrder Matrix.Norms.L2Operator

noncomputable section



namespace Wishart

open Spectral

/-- Association for genuinely extended-valued spectral functions.  This is
needed when conditional expectations in a mixture may take the value infinity.
Both common monotonicity directions are retained. -/
theorem inverseCompression_ennreal_product {p d : ℕ} {β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hβ : (p : ℝ) - 1 < β) (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (hB : ∀ i, (B i).rank = k i)
    (Φ : ∀ i, (Fin (k i) → ℝ) → ℝ≥0∞) (hΦm : ∀ i, Measurable (Φ i))
    (hdir : (∀ i, MonotoneOn (Φ i) (positiveOrderedSpectrum (k i))) ∨
      (∀ i, AntitoneOn (Φ i) (positiveOrderedSpectrum (k i))))
    (J : Finset (Fin d)) :
    (∏ i ∈ J, ∫⁻ Y, Φ i (ascendingSpectrum (normalizedCompression Omega (B i) Y))
      ∂inverseWishartMeasure β Omega) ≤
    ∫⁻ Y, ∏ i ∈ J, Φ i (ascendingSpectrum (normalizedCompression Omega (B i) Y))
      ∂inverseWishartMeasure β Omega := by
  let μ := inverseWishartMeasure β Omega
  let Ψ (n : ℕ) (i : Fin d) := ennrealTruncation n (Φ i)
  let T (i : Fin d) (Y : SymmetricMatrix p) :=
    ascendingSpectrum (normalizedCompression Omega (B i) Y)
  have hTm (i : Fin d) : Measurable (T i) :=
    (continuous_ascendingSpectrum (k i)).measurable.comp
      (measurable_normalizedCompression Omega (B i))
  have hΨm (n : ℕ) (i : Fin d) : Measurable (Ψ n i) :=
    measurable_ennrealTruncation n (hΦm i)
  have hΨ0 (n : ℕ) (i : Fin d) (x) : 0 ≤ Ψ n i x :=
    ennrealTruncation_nonneg n (Φ i) x
  have hΨdir (n : ℕ) : CommonSpectralMonotonicity k (Ψ n) := by
    rcases hdir with hinc | hdec
    · exact Or.inl fun i => monotoneOn_ennrealTruncation n (hinc i)
    · exact Or.inr fun i => antitoneOn_ennrealTruncation n (hdec i)
  let A (i : Fin d) (n : ℕ) := ∫⁻ Y, ENNReal.ofReal (Ψ n i (T i Y)) ∂μ
  have hA (i : Fin d) : Monotone (A i) := by
    intro n m hnm
    apply lintegral_mono
    intro Y
    simp only [Ψ, ofReal_ennrealTruncation]
    exact min_le_min_left _ (by exact_mod_cast hnm)
  have hAsup (i : Fin d) :
      (∫⁻ Y, Φ i (T i Y) ∂μ) = ⨆ n : ℕ, A i n :=
    lintegral_eq_iSup_ennrealTruncation μ ((hΦm i).comp (hTm i))
  change (∏ i ∈ J, ∫⁻ Y, Φ i (T i Y) ∂μ) ≤
    ∫⁻ Y, ∏ i ∈ J, Φ i (T i Y) ∂μ
  simp_rw [hAsup]
  rw [ennreal_prod_iSup_nat J A (fun i _ => hA i)]
  apply iSup_le
  intro n
  have hc := inverseCompression_product_lintegral hOmega hβ k B hB (Ψ n)
    (hΨm n) (hΨ0 n) (hΨdir n) J
  have hsingle (i : Fin d) :
      inverseCompressionExtendedMoment β Omega k B (Ψ n) {i} = A i n := by
    simp [inverseCompressionExtendedMoment, inverseCompressionProduct, inverseCompressionFactor,
      A, T, μ]
  simp_rw [hsingle] at hc
  apply hc.trans
  apply lintegral_mono
  intro Y
  change ENNReal.ofReal (∏ i ∈ J, Ψ n i (T i Y)) ≤ ∏ i ∈ J, Φ i (T i Y)
  rw [ENNReal.ofReal_prod_of_nonneg (fun i _ => hΨ0 n i (T i Y))]
  apply Finset.prod_le_prod'
  intro i hi
  rw [show Ψ n i (T i Y) = ennrealTruncation n (Φ i) (T i Y) from rfl,
    ofReal_ennrealTruncation]
  exact min_le_left _ _

end Wishart
end
end CanonicalSource2

