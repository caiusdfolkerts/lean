    apply lintegral_congr_ae
    filter_upwards [hμ] with X hX
    exact compressionOuterProduct_geometric_eq k B hB f hf J X hX
  have h := matrixBetaII_product_of_wishart_products hOmega hα hβ k B hB
    (fun i => geometricOuterENN (f i))
