/-!
# The proved matrix beta-II hierarchy

The density-defined law equals the actual inverse-Wishart mixture of Wishart
laws. A second equality realizes it as `sqrt(Y) Z sqrt(Y)` with independent
`Y ~ IW(β,Ω)` and `Z ~ W(α,I)`. All degrees remain arbitrary admissible reals.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification
open scoped Classical ENNReal MatrixOrder Matrix.Norms.L2Operator

noncomputable section

namespace Wishart

@[fun_prop] theorem measurable_wishartScaleFamily {p : ℕ} (α : ℝ) :
    Measurable (fun Y : SymmetricMatrix p =>
      nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) :=
  measurable_nonsingularWishartMeasure_selfAdjoint.comp (measurable_const.prodMk measurable_id)

@[fun_prop] theorem measurable_wishartScalePDF {p : ℕ} (α : ℝ) :
    Measurable (fun z : SymmetricMatrix p × SymmetricMatrix p =>
      nonsingularWishartPDF α (z.1 : Matrix (Fin p) (Fin p) ℝ) z.2) :=
  (measurable_uncurry_nonsingularWishartPDF p).comp
    ((measurable_const.prodMk (measurable_subtype_coe.comp measurable_fst)).prodMk measurable_snd)

theorem matrixBetaIIMeasure_eq_bind {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β) :
    matrixBetaIIMeasure α β Omega = (inverseWishartMeasure β Omega).bind
      (fun Y : SymmetricMatrix p => nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)) := by
  symm
  apply Measure.ext_of_lintegral
  intro f hf
  have hqf : Measurable (fun z : SymmetricMatrix p × SymmetricMatrix p =>
      nonsingularWishartPDF α (z.1 : Matrix (Fin p) (Fin p) ℝ) z.2 * f z.2) :=
    (measurable_wishartScalePDF α).mul (hf.comp measurable_snd)
  have hrf : Measurable (fun z : SymmetricMatrix p × SymmetricMatrix p =>
      inverseWishartPDF β Omega z.1 *
        (nonsingularWishartPDF α (z.1 : Matrix (Fin p) (Fin p) ℝ) z.2 * f z.2)) :=
    ((measurable_inverseWishartPDF β Omega).comp measurable_fst).mul hqf
  calc
    (∫⁻ X, f X ∂(inverseWishartMeasure β Omega).bind
        (fun Y : SymmetricMatrix p => nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ))) =
        ∫⁻ Y, ∫⁻ X, f X ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)
          ∂inverseWishartMeasure β Omega :=
      Measure.lintegral_bind (measurable_wishartScaleFamily α).aemeasurable hf.aemeasurable
    _ = ∫⁻ Y, ∫⁻ X, nonsingularWishartPDF α (Y : Matrix (Fin p) (Fin p) ℝ) X * f X
          ∂symmetricLebesgue p ∂inverseWishartMeasure β Omega := by
      apply lintegral_congr_ae
      filter_upwards [ae_posDef_inverseWishartMeasure β Omega] with Y hY
      rw [nonsingularWishartMeasure_of_posDef hY hα,
        lintegral_withDensity_eq_lintegral_mul _ (measurable_nonsingularWishartPDF _ _) hf]
      rfl
    _ = ∫⁻ Y, inverseWishartPDF β Omega Y *
          (∫⁻ X, nonsingularWishartPDF α (Y : Matrix (Fin p) (Fin p) ℝ) X * f X
            ∂symmetricLebesgue p) ∂symmetricLebesgue p := by
      rw [inverseWishartMeasure_of_posDef hOmega hβ,
        lintegral_withDensity_eq_lintegral_mul _ (measurable_inverseWishartPDF _ _)
          hqf.lintegral_prod_right]
      rfl
    _ = ∫⁻ Y, ∫⁻ X, inverseWishartPDF β Omega Y *
          (nonsingularWishartPDF α (Y : Matrix (Fin p) (Fin p) ℝ) X * f X)
            ∂symmetricLebesgue p ∂symmetricLebesgue p := by
      apply lintegral_congr
      intro Y
      exact (lintegral_const_mul _ ((measurable_nonsingularWishartPDF _ _).mul hf)).symm
    _ = ∫⁻ X, ∫⁻ Y, inverseWishartPDF β Omega Y *
          (nonsingularWishartPDF α (Y : Matrix (Fin p) (Fin p) ℝ) X * f X)
            ∂symmetricLebesgue p ∂symmetricLebesgue p :=
      lintegral_lintegral_swap hrf.aemeasurable
    _ = ∫⁻ X, matrixBetaIIPDF α β Omega X * f X ∂symmetricLebesgue p := by
      apply lintegral_congr
      intro X
      simp_rw [← mul_assoc]
      rw [← lintegral_matrixBetaII_jointPDF hOmega hα hβ X]
      exact lintegral_mul_const (f X)
        (show Measurable (fun Y : SymmetricMatrix p =>
          inverseWishartPDF β Omega Y *
            nonsingularWishartPDF α (Y : Matrix (Fin p) (Fin p) ℝ) X) from
          (measurable_inverseWishartPDF _ _).mul
            ((measurable_wishartScalePDF α).comp
              (measurable_id.prodMk measurable_const)))
    _ = ∫⁻ X, f X ∂matrixBetaIIMeasure α β Omega :=
      (lintegral_withDensity_eq_lintegral_mul _ (measurable_matrixBetaIIPDF _ _ _) hf).symm

theorem isProbabilityMeasure_matrixBetaIIMeasure {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β) :
    IsProbabilityMeasure (matrixBetaIIMeasure α β Omega) := by
  letI := isProbabilityMeasure_inverseWishartMeasure hOmega hβ
  constructor
  rw [matrixBetaIIMeasure_eq_bind hOmega hα hβ,
    Measure.bind_apply MeasurableSet.univ (measurable_wishartScaleFamily α).aemeasurable]
  have hmass : (fun Y : SymmetricMatrix p =>
      nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ) Set.univ) =ᵐ[
        inverseWishartMeasure β Omega] fun _ => (1 : ℝ≥0∞) := by
    filter_upwards [ae_posDef_inverseWishartMeasure β Omega] with Y hY
    letI := isProbabilityMeasure_nonsingularWishartMeasure hY hα
    exact measure_univ
  rw [lintegral_congr_ae hmass]
  simp

theorem lintegral_matrixBetaIIMeasure {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (f : SymmetricMatrix p → ℝ≥0∞) (hf : Measurable f) :
    (∫⁻ X, f X ∂matrixBetaIIMeasure α β Omega) =
      ∫⁻ Y, ∫⁻ X, f X ∂nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ)
        ∂inverseWishartMeasure β Omega := by
  rw [matrixBetaIIMeasure_eq_bind hOmega hα hβ]
  exact Measure.lintegral_bind (measurable_wishartScaleFamily α).aemeasurable hf.aemeasurable

def matrixBetaIISample {p : ℕ} (z : SymmetricMatrix p × SymmetricMatrix p) : SymmetricMatrix p :=
  Matrix.symmetricCongruenceLinearMap (CFC.sqrt (z.1 : Matrix (Fin p) (Fin p) ℝ)) z.2

@[fun_prop] theorem measurable_matrixBetaIISample {p : ℕ} :
    Measurable (@matrixBetaIISample p) := by
  apply Measurable.subtype_mk
  have hsqrt : Measurable (fun z : SymmetricMatrix p × SymmetricMatrix p =>
      CFC.sqrt (z.1 : Matrix (Fin p) (Fin p) ℝ)) :=
    CFC.measurable_sqrt.comp (measurable_subtype_coe.comp measurable_fst)
  have htranspose : Measurable (fun z : SymmetricMatrix p × SymmetricMatrix p =>
      (CFC.sqrt (z.1 : Matrix (Fin p) (Fin p) ℝ))ᵀ) := by
    apply measurable_pi_iff.mpr
    intro i
    apply measurable_pi_iff.mpr
    intro j
    exact (measurable_pi_apply i).comp ((measurable_pi_apply j).comp hsqrt)
  change Measurable (fun z : SymmetricMatrix p × SymmetricMatrix p =>
    (matrixBetaIISample z : Matrix (Fin p) (Fin p) ℝ))
  have he (z : SymmetricMatrix p × SymmetricMatrix p) :
      (matrixBetaIISample z : Matrix (Fin p) (Fin p) ℝ) =
        CFC.sqrt (z.1 : Matrix (Fin p) (Fin p) ℝ) *
          (z.2 : Matrix (Fin p) (Fin p) ℝ) *
          (CFC.sqrt (z.1 : Matrix (Fin p) (Fin p) ℝ))ᵀ :=
    Matrix.coe_symmetricCongruenceLinearMap_apply _ _
  simp_rw [he]
  exact (hsqrt.mul (measurable_subtype_coe.comp measurable_snd)).mul htranspose

theorem map_sqrt_congruence_identityWishart {p : ℕ} (α : ℝ)
    (Y : SymmetricMatrix p) (hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef) :
    (nonsingularWishartMeasure α (1 : Matrix (Fin p) (Fin p) ℝ)).map
      (Matrix.symmetricCongruenceLinearMap (CFC.sqrt (Y : Matrix (Fin p) (Fin p) ℝ))) =
      nonsingularWishartMeasure α (Y : Matrix (Fin p) (Fin p) ℝ) := by
  rw [map_symmetricCongruenceLinearMap_nonsingularWishartMeasure_of_det_ne_zero _ _
      (sqrt_det_ne_zero_of_posDef hY), Matrix.mul_one, matrix_sqrt_transpose,
    CFC.sqrt_mul_sqrt_self _ hY.posSemidef.nonneg]

/-- The entire density-defined matrix beta-II law is the independent congruence
mixture used for sharp moment comparisons. -/
theorem map_matrixBetaIISample {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β) :
    ((inverseWishartMeasure β Omega).prod
      (nonsingularWishartMeasure α (1 : Matrix (Fin p) (Fin p) ℝ))).map matrixBetaIISample =
        matrixBetaIIMeasure α β Omega := by
  letI := isProbabilityMeasure_nonsingularWishartMeasure Matrix.PosDef.one hα
  apply Measure.ext_of_lintegral
  intro f hf
  rw [lintegral_map hf measurable_matrixBetaIISample,
    lintegral_prod (fun z : SymmetricMatrix p × SymmetricMatrix p =>
      f (matrixBetaIISample z)) (hf.comp measurable_matrixBetaIISample).aemeasurable,
    lintegral_matrixBetaIIMeasure hOmega hα hβ f hf]
  apply lintegral_congr_ae
  filter_upwards [ae_posDef_inverseWishartMeasure β Omega] with Y hY
  rw [← map_sqrt_congruence_identityWishart α Y hY,
    lintegral_map hf (LinearMap.continuous_of_finiteDimensional _).measurable]
  rfl

theorem ae_posDef_matrixBetaIIMeasure {p : ℕ} (α β : ℝ)
    (Omega : Matrix (Fin p) (Fin p) ℝ) :
    ∀ᵐ (X : SymmetricMatrix p) ∂matrixBetaIIMeasure α β Omega,
      (X : Matrix (Fin p) (Fin p) ℝ).PosDef := by
  rw [ae_iff]
  change (matrixBetaIIMeasure α β Omega) ({X : SymmetricMatrix p |
    (X : Matrix (Fin p) (Fin p) ℝ).PosDef}ᶜ) = 0
  rw [matrixBetaIIMeasure, withDensity_apply _ (measurableSet_posDefMatrix p).compl]
  apply setLIntegral_eq_zero (measurableSet_posDefMatrix p).compl
  intro X hX
  simp only [matrixBetaIIPDF, matrixBetaIIPDFReal_of_not_posDef α β Omega hX, ENNReal.ofReal_zero, Pi.zero_apply]

