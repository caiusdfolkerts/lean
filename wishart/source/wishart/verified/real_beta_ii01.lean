def matrixBetaIIConstant {p : ℕ} (α β : ℝ) (Omega : Matrix (Fin p) (Fin p) ℝ) : ℝ :=
  multivariateGamma p ((α + β) / 2) /
    (multivariateGamma p (α / 2) * multivariateGamma p (β / 2)) * Omega.det ^ (β / 2)

def matrixBetaIIPDFReal {p : ℕ} (α β : ℝ) (Omega : Matrix (Fin p) (Fin p) ℝ)
    (X : SymmetricMatrix p) : ℝ :=
  if (X : Matrix (Fin p) (Fin p) ℝ).PosDef then
    matrixBetaIIConstant α β Omega *
      (X : Matrix (Fin p) (Fin p) ℝ).det ^ ((α - p - 1) / 2) *
        (Omega + (X : Matrix (Fin p) (Fin p) ℝ)).det ^ (-((α + β) / 2))
  else 0

def matrixBetaIIPDF {p : ℕ} (α β : ℝ) (Omega : Matrix (Fin p) (Fin p) ℝ)
    (X : SymmetricMatrix p) : ℝ≥0∞ := ENNReal.ofReal (matrixBetaIIPDFReal α β Omega X)

/-- The beta-II law is defined by the paper's density, not by an assumed
hierarchy. Equality to the hierarchy is proved in the next module. -/
def matrixBetaIIMeasure {p : ℕ} (α β : ℝ) (Omega : Matrix (Fin p) (Fin p) ℝ) :
    Measure (SymmetricMatrix p) := (symmetricLebesgue p).withDensity (matrixBetaIIPDF α β Omega)

theorem multivariateGamma_sum_degree_pos {p : ℕ} {α β : ℝ}
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β) :
    0 < multivariateGamma p ((α + β) / 2) := by
  by_cases hp : p = 0
  · subst p
    simp
  have hple : (1 : ℝ) ≤ p := by exact_mod_cast (Nat.one_le_iff_ne_zero.mpr hp)
  apply multivariateGamma_pos
  linarith

theorem matrixBetaIIConstant_pos {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β) :
    0 < matrixBetaIIConstant α β Omega :=
  mul_pos (div_pos (multivariateGamma_sum_degree_pos hα hβ)
    (mul_pos (multivariateGamma_pos (by linarith)) (multivariateGamma_pos (by linarith))))
    (Real.rpow_pos_of_pos hOmega.det_pos _)

@[simp] theorem matrixBetaIIPDFReal_of_posDef {p : ℕ} (α β : ℝ)
    (Omega : Matrix (Fin p) (Fin p) ℝ) {X : SymmetricMatrix p}
    (hX : (X : Matrix (Fin p) (Fin p) ℝ).PosDef) :
    matrixBetaIIPDFReal α β Omega X = matrixBetaIIConstant α β Omega *
      (X : Matrix (Fin p) (Fin p) ℝ).det ^ ((α - p - 1) / 2) *
        (Omega + (X : Matrix (Fin p) (Fin p) ℝ)).det ^ (-((α + β) / 2)) :=
  if_pos hX

@[simp] theorem matrixBetaIIPDFReal_of_not_posDef {p : ℕ} (α β : ℝ)
    (Omega : Matrix (Fin p) (Fin p) ℝ) {X : SymmetricMatrix p}
    (hX : ¬ (X : Matrix (Fin p) (Fin p) ℝ).PosDef) :
    matrixBetaIIPDFReal α β Omega X = 0 := if_neg hX

theorem matrixBetaIIPDFReal_nonneg {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β) (X : SymmetricMatrix p) :
    0 ≤ matrixBetaIIPDFReal α β Omega X := by
  by_cases hX : (X : Matrix (Fin p) (Fin p) ℝ).PosDef
  · rw [matrixBetaIIPDFReal_of_posDef α β Omega hX]
    exact mul_nonneg (mul_nonneg (matrixBetaIIConstant_pos hOmega hα hβ).le
      (Real.rpow_nonneg hX.det_pos.le _))
      (Real.rpow_nonneg (hOmega.add hX).det_pos.le _)
  · rw [matrixBetaIIPDFReal_of_not_posDef α β Omega hX]

@[fun_prop] theorem measurable_matrixBetaIIPDFReal {p : ℕ}
    (α β : ℝ) (Omega : Matrix (Fin p) (Fin p) ℝ) :
    Measurable (matrixBetaIIPDFReal α β Omega) := by
  unfold matrixBetaIIPDFReal
  apply Measurable.ite (measurableSet_posDefMatrix p)
  · fun_prop
  · fun_prop

@[fun_prop] theorem measurable_matrixBetaIIPDF {p : ℕ}
    (α β : ℝ) (Omega : Matrix (Fin p) (Fin p) ℝ) :
    Measurable (matrixBetaIIPDF α β Omega) :=
  (measurable_matrixBetaIIPDFReal α β Omega).ennreal_ofReal

theorem matrixBetaII_jointPDFReal {p : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (X Y : SymmetricMatrix p) :
    inverseWishartPDFReal β Omega Y *
        nonsingularWishartPDFReal α (Y : Matrix (Fin p) (Fin p) ℝ) X =
      matrixBetaIIPDFReal α β Omega X *
        inverseWishartPDFReal (α + β) (Omega + (X : Matrix (Fin p) (Fin p) ℝ)) Y := by
  by_cases hX : (X : Matrix (Fin p) (Fin p) ℝ).PosDef
  · by_cases hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef
    · have hsum := hOmega.add hX
      have h2 : (2 : ℝ) ^ ((α + β) * (p : ℝ) / 2) =
          (2 : ℝ) ^ (α * (p : ℝ) / 2) * (2 : ℝ) ^ (β * (p : ℝ) / 2) := by
        rw [← Real.rpow_add two_pos]
        congr 1
        ring
      have hpow : (Y : Matrix (Fin p) (Fin p) ℝ).det ^ (-((α + β + p + 1) / 2)) =
          (Y : Matrix (Fin p) (Fin p) ℝ).det ^ (-((β + p + 1) / 2)) /
