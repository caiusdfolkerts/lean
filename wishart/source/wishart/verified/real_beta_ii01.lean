        rw [Matrix.add_mul, Matrix.trace_add, Matrix.trace_mul_comm
          (X : Matrix (Fin p) (Fin p) ℝ) (Y : Matrix (Fin p) (Fin p) ℝ)⁻¹]
      have hexp : Real.exp (-((Omega + (X : Matrix (Fin p) (Fin p) ℝ)) *
          (Y : Matrix (Fin p) (Fin p) ℝ)⁻¹).trace / 2) =
          Real.exp (-(Omega * (Y : Matrix (Fin p) (Fin p) ℝ)⁻¹).trace / 2) *
            Real.exp (-((Y : Matrix (Fin p) (Fin p) ℝ)⁻¹ *
              (X : Matrix (Fin p) (Fin p) ℝ)).trace / 2) := by
        rw [← Real.exp_add, htrace]
