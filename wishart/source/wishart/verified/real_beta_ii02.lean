def wishartDeterminantMomentConstant (k : ℕ) (α r : ℝ) : ℝ :=
  (2 : ℝ) ^ ((k : ℝ) * r) *
    (multivariateGamma k (α / 2 + r) / multivariateGamma k (α / 2))

theorem wishartDeterminantMomentConstant_pos {k : ℕ} {α r : ℝ}
    (hα : (k : ℝ) - 1 < α) (hr : 0 ≤ r) : 0 < wishartDeterminantMomentConstant k α r :=
  mul_pos (Real.rpow_pos_of_pos two_pos _) (div_pos
    (multivariateGamma_pos (by linarith)) (multivariateGamma_pos (by linarith)))

