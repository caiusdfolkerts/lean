    filter_upwards [ae_posDef_nonsingularWishartMeasure α S] with X hX
    exact Real.rpow_nonneg (compressionScale_posDef hX B hB).det_pos.le _
  rw [← ofReal_integral_eq_lintegral_ofReal hI hnonneg,
    integral_compression_det_rpow_wishart hS hα B hB hr]
