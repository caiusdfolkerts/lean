section CanonicalSource2
/- Source: Wishart/PrincipalSelectionMatrix.lean -/



/-! # Principal coordinate selections as full-rank compression matrices -/

noncomputable section
open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification
open scoped Classical MatrixOrder Matrix.Norms.L2Operator

namespace Wishart

def principalSelectionMatrix {p : ℕ} (I : Finset (Fin p)) :
    Matrix (Fin p) (Fin (Fintype.card I)) ℝ :=
  (1 : Matrix (Fin p) (Fin p) ℝ).submatrix id (principalSetCoordinates I)

theorem principalSelectionMatrix_gram {p : ℕ} (I : Finset (Fin p)) :
    (principalSelectionMatrix I)ᵀ * principalSelectionMatrix I = 1 := by
  have h := Matrix.submatrix_one_mul_mul_submatrix_one (principalSetCoordinates I)
    (1 : Matrix (Fin p) (Fin p) ℝ)
  simpa only [principalSelectionMatrix, Matrix.transpose_submatrix, Matrix.transpose_one,
    Matrix.mul_one, Matrix.submatrix_one _ (principalSetCoordinates_injective I)] using h

theorem principalSelectionMatrix_rank {p : ℕ} (I : Finset (Fin p)) :
    (principalSelectionMatrix I).rank = Fintype.card I := by
  apply le_antisymm (principalSelectionMatrix I).rank_le_width
  have h := Matrix.rank_mul_le_right (principalSelectionMatrix I)ᵀ (principalSelectionMatrix I)
  rw [principalSelectionMatrix_gram, Matrix.rank_one, Fintype.card_fin] at h
  exact h

theorem principalSelectionMatrix_det {p : ℕ} (I : Finset (Fin p)) (X : SymmetricMatrix p) :
    ((principalSelectionMatrix I)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) *
      principalSelectionMatrix I).det = principalMinor I X := by
  rw [principalSelectionMatrix, Matrix.transpose_submatrix, Matrix.transpose_one,
    Matrix.submatrix_one_mul_mul_submatrix_one]
  exact principalSetMatrix_det I X

end Wishart
end
end CanonicalSource2

section CanonicalSource3
/- Source: Wishart/MatrixBetaIITheorem.lean -/



/-!
# Theorem 6.3 and its exact moment statements

The conditional Wishart product comparison is instantiated here. Because the
beta-II determinants are unshifted, their actual constancy on the positive
definite cone is independent of the conditioning scale. Thus the same exact
retained-rank condition applies at every conditioning matrix.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification
open WishartVerification.MomentAssembly
open scoped Classical ENNReal MatrixOrder Matrix.Norms.L2Operator

noncomputable section

namespace Wishart

def betaIIGeometricFamily {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (hB : ∀ i, (B i).rank = k i)
    (f : Fin d → ℝ → ℝ) (hf : ∀ i, GeometricallyLogConvex (f i)) :
    GeometricCompressionFamily p (Fin d) where
  size := k
  matrix := B
  full_rank := hB
  shift := fun _ => 0
  shift_nonneg := fun _ => le_rfl
  outer := f
  geometric := hf

theorem betaIIGeometricFamily_factor {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (hB : ∀ i, (B i).rank = k i)
    (f : Fin d → ℝ → ℝ) (hf : ∀ i, GeometricallyLogConvex (f i))
    (Sigma : Matrix (Fin p) (Fin p) ℝ) (i : Fin d) (X : SymmetricMatrix p) :
    (betaIIGeometricFamily k B hB f hf).factor Sigma i X =
      f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det := by
  change f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i +
    (0 : ℝ) • compressionScale Sigma (B i)).det = _
  simp only [zero_smul, add_zero]

theorem betaIIGeometricFamily_constantFactor_iff {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (hB : ∀ i, (B i).rank = k i)
    (f : Fin d → ℝ → ℝ) (hf : ∀ i, GeometricallyLogConvex (f i))
    (Sigma Omega : Matrix (Fin p) (Fin p) ℝ) (i : Fin d) :
    (betaIIGeometricFamily k B hB f hf).ConstantFactor Sigma i ↔
      (betaIIGeometricFamily k B hB f hf).ConstantFactor Omega i := by
  simp only [GeometricCompressionFamily.ConstantFactor, betaIIGeometricFamily_factor]

theorem betaIIGeometricFamily_activeProper_eq {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (hB : ∀ i, (B i).rank = k i)
    (f : Fin d → ℝ → ℝ) (hf : ∀ i, GeometricallyLogConvex (f i))
    (Sigma Omega : Matrix (Fin p) (Fin p) ℝ) :
    (betaIIGeometricFamily k B hB f hf).activeProper Sigma =
      (betaIIGeometricFamily k B hB f hf).activeProper Omega := by
  ext i
  simp only [GeometricCompressionFamily.activeProper, Finset.mem_filter, Finset.mem_univ,
    true_and, betaIIGeometricFamily_constantFactor_iff k B hB f hf Sigma Omega i]

/-- Theorem 6.3: the literal density (18), every admissible real pair of
shapes, arbitrary overlapping full-column-rank compressions, and extended
expectations under exactly Theorem 5.1's retained largest-plus-third-largest
rank condition. No conditional-law or comparison premise remains. -/
theorem theorem_6_3 {p d : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (f : Fin d → ℝ → ℝ)
    (hf : ∀ i, GeometricallyLogConvex (f i))
    (hsize : orderedRankThreshold k ((betaIIGeometricFamily k B hB f hf).activeProper Omega) p α)
    (J : Finset (Fin d)) :
    (∏ i ∈ J, ∫⁻ X : SymmetricMatrix p,
      ENNReal.ofReal (f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det)
        ∂matrixBetaIIMeasure α β Omega) ≤
      ∫⁻ X : SymmetricMatrix p,
        ENNReal.ofReal (∏ i ∈ J, f i ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det)
          ∂matrixBetaIIMeasure α β Omega := by
  apply matrixBetaII_geometric_product_of_wishart_products hOmega hα hβ k B hB f hf J
  intro Y hY
  let F := betaIIGeometricFamily k B hB f hf
  have hsizeY : orderedRankThreshold F.size (F.activeProper (Y : Matrix (Fin p) (Fin p) ℝ)) p α := by
    change orderedRankThreshold k ((betaIIGeometricFamily k B hB f hf).activeProper
      (Y : Matrix (Fin p) (Fin p) ℝ)) p α
    rw [betaIIGeometricFamily_activeProper_eq k B hB f hf _ Omega]
    exact hsize
  have h := F.product_moments_le (Y : Matrix (Fin p) (Fin p) ℝ) hY hα hsizeY J
  simpa only [GeometricCompressionFamily.moment_singleton, GeometricCompressionFamily.moment,
    GeometricCompressionFamily.subproduct, F, betaIIGeometricFamily_factor,
    Finset.prod_singleton] using h

theorem disjoint_principal_orderedRankThreshold {p d : ℕ} {α : ℝ}
    (hα : (p : ℝ) - 1 < α) (I : Fin d → Finset (Fin p))
    (hI : ∀ i, (I i).Nonempty) (hdisjoint : Pairwise (fun i j => Disjoint (I i) (I j)))
    (A : Finset (Fin d)) :
    orderedRankThreshold (fun i => Fintype.card (I i)) A p α := by
  apply (orderedRankThreshold_iff _ _ _ _).mpr
  intro i hi j hj l hl hij hil hjl hrij hril
  obtain ⟨a, hal⟩ := hI l
  have hai : a ∉ I i := fun hai => Finset.disjoint_left.mp (hdisjoint hil.symm) hal hai
  have haj : a ∉ I j := fun haj => Finset.disjoint_left.mp (hdisjoint hjl.symm) hal haj
  have ha : a ∉ I i ∪ I j := by simp only [Finset.mem_union, not_or]; exact ⟨hai, haj⟩
  have hcard := Finset.card_le_card (Finset.subset_univ (insert a (I i ∪ I j)))
  have hnat : (I i).card + (I j).card + 1 ≤ p := by
    simpa only [Finset.card_insert_of_notMem ha,
      Finset.card_union_of_disjoint (hdisjoint hij), Finset.card_univ, Fintype.card_fin] using hcard
  have hreal : (Fintype.card (I i) : ℝ) + Fintype.card (I j) + 1 ≤ p := by
    simp only [Fintype.card_coe]
    exact_mod_cast hnat
  exact (min_le_left _ _).trans (by linarith)

/-- The disjoint-principal-block clause has no restriction on either
admissible shape. The blocks need not cover the ambient coordinates. -/
theorem theorem_6_3_disjoint_principal_blocks {p d : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (I : Fin d → Finset (Fin p)) (hI : ∀ i, (I i).Nonempty)
    (hdisjoint : Pairwise (fun i j => Disjoint (I i) (I j)))
    (f : Fin d → ℝ → ℝ) (hf : ∀ i, GeometricallyLogConvex (f i))
    (J : Finset (Fin d)) :
    (∏ i ∈ J, ∫⁻ X, ENNReal.ofReal (f i (principalMinor (I i) X))
      ∂matrixBetaIIMeasure α β Omega) ≤
    ∫⁻ X, ENNReal.ofReal (∏ i ∈ J, f i (principalMinor (I i) X))
      ∂matrixBetaIIMeasure α β Omega := by
  have h := theorem_6_3 hOmega hα hβ (fun i => Fintype.card (I i))
    (fun i => principalSelectionMatrix (I i)) (fun i => principalSelectionMatrix_rank (I i))
    f hf (disjoint_principal_orderedRankThreshold hα I hI hdisjoint _) J
  simpa only [principalSelectionMatrix_det] using h

/-- The exact marginal multivariate-gamma constant printed after Theorem 6.3. -/
theorem theorem_6_3_gamma_moment {p k : ℕ} {α β r : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (B : Matrix (Fin p) (Fin k) ℝ) (hB : B.rank = k)
    (hr : 0 ≤ r) (hthreshold : 2 * r < β - p + 1) :
    (∫ X : SymmetricMatrix p, (Bᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B).det ^ r
      ∂matrixBetaIIMeasure α β Omega) =
      (compressionScale Omega B).det ^ r *
        (multivariateGamma k (α / 2 + r) / multivariateGamma k (α / 2)) *
          (multivariateGamma k ((β - p + k) / 2 - r) /
            multivariateGamma k ((β - p + k) / 2)) :=
  integral_compression_det_rpow_matrixBetaII hOmega hα hβ B hB hr hthreshold

theorem theorem_6_3_finite_moment_iff {p d : ℕ} {α β : ℝ}
    {Omega : Matrix (Fin p) (Fin p) ℝ} (hOmega : Omega.PosDef)
    (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (ν : Fin d → ℝ) (hν : ∀ i, 0 ≤ ν i)
    (hactive : ∀ i, 0 < ν i → 0 < k i) :
    Integrable (compressionDeterminantProduct k B ν Finset.univ)
      (matrixBetaIIMeasure α β Omega) ↔ 2 * (∑ i, ν i) < β - p + 1 :=
  integrable_compressionDeterminantProduct_matrixBetaII_iff hOmega hα hβ k B hB ν hν hactive

end Wishart
end
end CanonicalSource3
