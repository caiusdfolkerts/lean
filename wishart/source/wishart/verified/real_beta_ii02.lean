    (B : Matrix (Fin p) (Fin k) ℝ) (hB : B.rank = k) (hr : 0 ≤ r) :
    (∫ X : SymmetricMatrix p, (Bᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B).det ^ r
      ∂nonsingularWishartMeasure α S) =
      wishartDeterminantMomentConstant k α r * (compressionScale S B).det ^ r := by
  have hk : k ≤ p := by rw [← hB]; exact B.rank_le_height
  have hαk : (k : ℝ) - 1 < α := by
    have hkp : (k : ℝ) ≤ p := Nat.cast_le.mpr hk
    linarith
  have hmap := map_symmetricCongruenceLinearMap_nonsingularWishartMeasure Bᵀ
    (by simpa only [Matrix.rank_transpose] using hB) hS hα
  rw [Matrix.transpose_transpose] at hmap
  have h := integral_det_rpow_wishart (compressionScale_posDef hS B hB) hαk
    (r := r) (by linarith)
  simp only [compressionScale] at h
  rw [← hmap, integral_map_of_stronglyMeasurable
    (LinearMap.continuous_of_finiteDimensional _).measurable (by fun_prop)] at h
  simp only [Matrix.coe_symmetricCongruenceLinearMap_apply, Matrix.transpose_transpose] at h
  rw [h, wishartDeterminantMomentConstant, compressionScale]
  ring

theorem lintegral_compression_det_rpow_wishart {p k : ℕ} {α r : ℝ}
    {S : Matrix (Fin p) (Fin p) ℝ} (hS : S.PosDef) (hα : (p : ℝ) - 1 < α)
    (B : Matrix (Fin p) (Fin k) ℝ) (hB : B.rank = k) (hr : 0 ≤ r) :
    (∫⁻ X : SymmetricMatrix p, ENNReal.ofReal
      ((Bᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B).det ^ r)
        ∂nonsingularWishartMeasure α S) =
      ENNReal.ofReal (wishartDeterminantMomentConstant k α r) *
        ENNReal.ofReal ((compressionScale S B).det ^ r) := by
  letI := isProbabilityMeasure_nonsingularWishartMeasure hS hα
  have hI := ((allFiniteMoments_wishart_compression_det hS hα B).rpow hr).integrable
