/-!
# Exact joint moment range for matrix beta-II

Weighted AM–GM proves sufficiency from the exact marginal moments. Necessity
uses the actual independent congruence hierarchy and Fubini: one fixed
positive-definite Wishart realization bounds the mixture matrix below by a
positive scalar multiple of its inverse-Wishart factor. No overlap or rank
comparison is needed for this moment result.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification Filter Topology
open scoped Classical ENNReal MatrixOrder Matrix.Norms.L2Operator

noncomputable section

namespace Wishart

def compressionDeterminantProduct {p d : ℕ} (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (ν : Fin d → ℝ)
    (J : Finset (Fin d)) (X : SymmetricMatrix p) : ℝ :=
  ∏ i ∈ J, ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det ^ ν i

@[fun_prop] theorem measurable_compressionDeterminantProduct {p d : ℕ}
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (ν : Fin d → ℝ) (J : Finset (Fin d)) : Measurable (compressionDeterminantProduct k B ν J) := by
  unfold compressionDeterminantProduct
  fun_prop

theorem compressionDeterminantProduct_eq_inverse_zero {p d : ℕ}
    (Omega : Matrix (Fin p) (Fin p) ℝ) (k : Fin d → ℕ)
    (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ) (ν : Fin d → ℝ) (J : Finset (Fin d)) :
    compressionDeterminantProduct k B ν J = inverseDeterminantProduct Omega k B (fun _ => 0) ν J := by
  funext X
  simp only [compressionDeterminantProduct, inverseDeterminantProduct,
    inverseCompressionDeterminant, zero_smul, add_zero]

theorem integrable_compressionDeterminantProduct_matrixBetaII
    {p d : ℕ} {α β : ℝ} {Omega : Matrix (Fin p) (Fin p) ℝ}
    (hOmega : Omega.PosDef) (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (ν : Fin d → ℝ) (J : Finset (Fin d))
    (hν : ∀ i ∈ J, 0 ≤ ν i) (hthreshold : 2 * (∑ i ∈ J, ν i) < β - p + 1) :
    Integrable (compressionDeterminantProduct k B ν J) (matrixBetaIIMeasure α β Omega) := by
  letI := isProbabilityMeasure_matrixBetaIIMeasure hOmega hα hβ
  apply integrable_rpow_product_of_sum_moments J
    (fun i (X : SymmetricMatrix p) =>
      ((B i)ᵀ * (X : Matrix (Fin p) (Fin p) ℝ) * B i).det) ν
  · intro i hi
    fun_prop
  · filter_upwards [ae_posDef_matrixBetaIIMeasure α β Omega] with X hX i hi
    exact (compressionScale_posDef hX (B i) (hB i)).det_pos.le
  · exact hν
  · intro i hi
    exact integrable_compression_det_rpow_matrixBetaII hOmega hα hβ (B i) (hB i)
      (Finset.sum_nonneg hν) hthreshold

theorem exists_positive_scalar_below_posDef {p : ℕ} (Z : SymmetricMatrix p)
    (hZ : (Z : Matrix (Fin p) (Fin p) ℝ).PosDef) :
    ∃ a : ℝ, 0 < a ∧ ((Z : Matrix (Fin p) (Fin p) ℝ) - a • 1).PosSemidef := by
  let I : SymmetricMatrix p := ⟨1, IsSelfAdjoint.one _⟩
  have hc : Continuous (fun t : ℝ => Z - t • I) :=
    continuous_const.sub (continuous_id.smul continuous_const)
  have ht : Tendsto (fun t : ℝ => Z - t • I) (𝓝 0) (𝓝 Z) := by
    simpa only [ContinuousAt, zero_smul, sub_zero] using
      hc.continuousAt (x := (0 : ℝ))
  have hnear : ∀ᶠ t : ℝ in 𝓝 0,
      ((Z - t • I : SymmetricMatrix p) : Matrix (Fin p) (Fin p) ℝ).PosDef :=
    ht.eventually ((isOpen_setOfPred_posDefMatrix p).mem_nhds hZ)
  obtain ⟨δ, hδ, hδsub⟩ := Metric.mem_nhds_iff.mp hnear
  refine ⟨δ / 2, half_pos hδ, ?_⟩
  have hinside : δ / 2 ∈ Metric.ball (0 : ℝ) δ := by
    rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_of_pos (half_pos hδ)]
    linarith
  simpa only [Submodule.coe_sub, Submodule.coe_smul, I] using (hδsub hinside).posSemidef

theorem matrixBetaIISample_ge_smul {p : ℕ} (Y Z : SymmetricMatrix p)
    (hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef) {a : ℝ}
    (hZ : ((Z : Matrix (Fin p) (Fin p) ℝ) - a • 1).PosSemidef) :
    ((matrixBetaIISample (Y, Z) : Matrix (Fin p) (Fin p) ℝ) -
      a • (Y : Matrix (Fin p) (Fin p) ℝ)).PosSemidef := by
  have h := hZ.mul_mul_conjTranspose_same (CFC.sqrt (Y : Matrix (Fin p) (Fin p) ℝ))
  simpa only [matrixBetaIISample, Matrix.coe_symmetricCongruenceLinearMap_apply,
    Matrix.conjTranspose_eq_transpose_of_trivial, Matrix.mul_sub, Matrix.sub_mul,
    Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one, matrix_sqrt_transpose,
    CFC.sqrt_mul_sqrt_self _ hY.posSemidef.nonneg] using h

theorem compressionDeterminantProduct_congruence_lower {p d : ℕ}
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (ν : Fin d → ℝ) (hν : ∀ i, 0 ≤ ν i)
    (Y Z : SymmetricMatrix p) (hY : (Y : Matrix (Fin p) (Fin p) ℝ).PosDef)
    {a : ℝ} (ha : 0 < a) (hZ : ((Z : Matrix (Fin p) (Fin p) ℝ) - a • 1).PosSemidef) :
    (∏ i, (a ^ k i) ^ ν i) * compressionDeterminantProduct k B ν Finset.univ Y ≤
      compressionDeterminantProduct k B ν Finset.univ (matrixBetaIISample (Y, Z)) := by
  have hdiff := matrixBetaIISample_ge_smul Y Z hY hZ
  unfold compressionDeterminantProduct
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_le_prod₀
  · intro i hi
    exact mul_nonneg (Real.rpow_nonneg (pow_nonneg ha.le _) _)
      (Real.rpow_nonneg (compressionScale_posDef hY (B i) (hB i)).det_pos.le _)
  · intro i hi
    have hdet := compressedDeterminant_mono Matrix.PosSemidef.zero (B i)
      (a • Y) (matrixBetaIISample (Y, Z))
      (by simpa only [Submodule.coe_smul] using hY.posSemidef.smul ha.le)
      (by simpa only [Submodule.coe_smul] using hdiff)
    simp only [compressedDeterminant, zero_add, Submodule.coe_smul,
      Matrix.mul_smul, Matrix.smul_mul, Matrix.det_smul, Fintype.card_fin] at hdet
    have hcompression : 0 ≤ ((B i)ᵀ * (Y : Matrix (Fin p) (Fin p) ℝ) * B i).det := by
      simpa only [compressionScale] using (compressionScale_posDef hY (B i) (hB i)).det_pos.le
    rw [← Real.mul_rpow (pow_nonneg ha.le _) hcompression]
    exact Real.rpow_le_rpow (mul_nonneg (pow_nonneg ha.le _) hcompression) hdet (hν i)

/-- Joint beta-II integrability forces the corresponding inverse-Wishart
integrability. Fubini permits a fixed positive-definite Wishart realization;
its lower scalar bound supplies a positive constant for all factors at once. -/
theorem integrable_inverse_product_of_matrixBetaII_product
    {p d : ℕ} {α β : ℝ} {Omega : Matrix (Fin p) (Fin p) ℝ}
    (hOmega : Omega.PosDef) (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (ν : Fin d → ℝ) (hν : ∀ i, 0 ≤ ν i)
    (hI : Integrable (compressionDeterminantProduct k B ν Finset.univ)
      (matrixBetaIIMeasure α β Omega)) :
    Integrable (compressionDeterminantProduct k B ν Finset.univ)
      (inverseWishartMeasure β Omega) := by
  letI := isProbabilityMeasure_inverseWishartMeasure hOmega hβ
  letI := isProbabilityMeasure_nonsingularWishartMeasure Matrix.PosDef.one hα
  have hprod : Integrable (fun z => compressionDeterminantProduct k B ν Finset.univ
      (matrixBetaIISample z))
      ((inverseWishartMeasure β Omega).prod
        (nonsingularWishartMeasure α (1 : Matrix (Fin p) (Fin p) ℝ))) := by
    rw [← map_matrixBetaIISample hOmega hα hβ] at hI
    exact (integrable_map_measure (measurable_compressionDeterminantProduct k B ν _).aestronglyMeasurable
      measurable_matrixBetaIISample.aemeasurable).mp hI
  obtain ⟨Z, hZI, hZ⟩ := (hprod.prod_left_ae.and
    (ae_posDef_nonsingularWishartMeasure α (1 : Matrix (Fin p) (Fin p) ℝ))).exists
  obtain ⟨a, ha, hZa⟩ := exists_positive_scalar_below_posDef Z hZ
  let C : ℝ := ∏ i, (a ^ k i) ^ ν i
  have hC : 0 < C := Finset.prod_pos (fun i _ => Real.rpow_pos_of_pos (pow_pos ha _) _)
  apply (hZI.const_mul C⁻¹).mono'
  · exact (measurable_compressionDeterminantProduct k B ν _).aestronglyMeasurable
  filter_upwards [ae_posDef_inverseWishartMeasure β Omega] with Y hY
  have hnn : 0 ≤ compressionDeterminantProduct k B ν Finset.univ Y :=
    Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (compressionScale_posDef hY (B i) (hB i)).det_pos.le _)
  rw [Real.norm_eq_abs, abs_of_nonneg hnn]
  have h := mul_le_mul_of_nonneg_left
    (compressionDeterminantProduct_congruence_lower k B hB ν hν Y Z hY ha hZa)
    (inv_pos.mpr hC).le
  simpa only [C, ← mul_assoc, inv_mul_cancel₀ hC.ne', one_mul] using h

/-- Exact joint finite-moment condition after Theorem 6.3. There is no rank
comparison or restriction on overlap; active factors have positive rank. -/
theorem integrable_compressionDeterminantProduct_matrixBetaII_iff
    {p d : ℕ} {α β : ℝ} {Omega : Matrix (Fin p) (Fin p) ℝ}
    (hOmega : Omega.PosDef) (hα : (p : ℝ) - 1 < α) (hβ : (p : ℝ) - 1 < β)
    (k : Fin d → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (hB : ∀ i, (B i).rank = k i) (ν : Fin d → ℝ) (hν : ∀ i, 0 ≤ ν i)
    (hactive : ∀ i, 0 < ν i → 0 < k i) :
    Integrable (compressionDeterminantProduct k B ν Finset.univ)
      (matrixBetaIIMeasure α β Omega) ↔ 2 * (∑ i, ν i) < β - p + 1 := by
  constructor
  · intro hI
    have hIW := integrable_inverse_product_of_matrixBetaII_product hOmega hα hβ k B hB ν hν hI
    rw [compressionDeterminantProduct_eq_inverse_zero Omega] at hIW
    exact inverseDeterminantProduct_integrable_implies_sum_lt hOmega hβ k B hB
      (fun _ => 0) ν (fun _ => le_rfl) hν hactive hIW
  · intro hthreshold
    exact integrable_compressionDeterminantProduct_matrixBetaII hOmega hα hβ k B hB ν Finset.univ
      (fun i _ => hν i) hthreshold

end Wishart
end
