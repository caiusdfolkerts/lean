section CanonicalSource2
/- Source: Wishart/GramMonotonePair.lean -/



/-!
# The unrestricted monotone pair clause of Corollary 5.4

Outer functions are arbitrary nonnegative increasing functions on `[0,∞)`.
Their actual values at zero are retained. Bounded truncations pass to the
extended inequality by monotone convergence, and the three stated finite
moments recover the real-integral formulation.
-/

open Matrix MeasureTheory TauCeti TauCeti.Probability WishartVerification
open scoped Classical ENNReal MatrixOrder Matrix.Norms.L2Operator
noncomputable section

namespace WishartVerification

def nonnegativeMonotoneExtension (f : ℝ → ℝ) : ℝ → ℝ := (Set.Ici (0 : ℝ)).indicator f

theorem nonnegativeMonotoneExtension_eq {f : ℝ → ℝ} {t : ℝ} (ht : 0 ≤ t) :
    nonnegativeMonotoneExtension f t = f t := Set.indicator_of_mem ht _

theorem nonnegativeMonotoneExtension_nonneg {f : ℝ → ℝ}
    (hf0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ f t) (t : ℝ) :
    0 ≤ nonnegativeMonotoneExtension f t := Set.indicator_nonneg hf0 t

theorem monotone_nonnegativeMonotoneExtension {f : ℝ → ℝ}
    (hf0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ f t) (hf : MonotoneOn f (Set.Ici 0)) :
    Monotone (nonnegativeMonotoneExtension f) := by
  intro x y hxy
  by_cases hx : 0 ≤ x
  · have hy : 0 ≤ y := hx.trans hxy
    rw [nonnegativeMonotoneExtension_eq hx, nonnegativeMonotoneExtension_eq hy]
    exact hf hx hy hxy
  · rw [nonnegativeMonotoneExtension, Set.indicator_of_notMem hx]
    exact nonnegativeMonotoneExtension_nonneg hf0 y

theorem measurable_nonnegativeMonotoneExtension {f : ℝ → ℝ}
    (hf0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ f t) (hf : MonotoneOn f (Set.Ici 0)) :
    Measurable (nonnegativeMonotoneExtension f) := (monotone_nonnegativeMonotoneExtension hf0 hf).measurable

end WishartVerification

namespace Wishart

theorem shiftedCompressionDeterminant_nonneg_of_posSemidef {p k : ℕ}
    {Sigma : Matrix (Fin p) (Fin p) ℝ} (hSigma : Sigma.PosSemidef)
    (M : Matrix (Fin p) (Fin k) ℝ) {c : ℝ} (hc : 0 ≤ c)
    {X : SymmetricMatrix p} (hX : (X : Matrix (Fin p) (Fin p) ℝ).PosSemidef) :
    0 ≤ shiftedCompressionDeterminant Sigma M c X := by
  have hcomp := hX.conjTranspose_mul_mul_same M
  have hscale := (hSigma.conjTranspose_mul_mul_same M).smul hc
  simpa only [shiftedCompressionDeterminant, compressionScale,
    Matrix.conjTranspose_eq_transpose_of_trivial] using (hcomp.add hscale).det_nonneg

theorem gram_compression_monotone_pair_lintegral_global {p q k : ℕ} (n : ℕ) {c d : ℝ}
    {Sigma : Matrix (Fin p) (Fin p) ℝ} (hSigma : Sigma.PosDef)
    (Q : Matrix (Fin p) (Fin q) ℝ) (hQ : Q.rank = q)
    (M : Matrix (Fin p) (Fin k) ℝ) (hM : M.rank = k) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (f g : ℝ → ℝ) (hfm : Measurable f) (hgm : Measurable g)
    (hf0 : ∀ t, 0 ≤ f t) (hg0 : ∀ t, 0 ≤ g t)
    (hfmono : MonotoneOn f (Set.Ici 0)) (hgmono : MonotoneOn g (Set.Ici 0)) :
    (∫⁻ X, ENNReal.ofReal (f (shiftedCompressionDeterminant Sigma Q c X))
      ∂wishartGramMeasure n Sigma) *
      (∫⁻ X, ENNReal.ofReal (g (shiftedCompressionDeterminant Sigma M d X))
        ∂wishartGramMeasure n Sigma) ≤
      ∫⁻ X, ENNReal.ofReal (f (shiftedCompressionDeterminant Sigma Q c X) *
        g (shiftedCompressionDeterminant Sigma M d X)) ∂wishartGramMeasure n Sigma := by
  apply lintegral_association_of_truncated_integral_association
    (wishartGramMeasure n Sigma)
    (fun X => f (shiftedCompressionDeterminant Sigma Q c X))
    (fun X => g (shiftedCompressionDeterminant Sigma M d X))
    (hfm.comp (measurable_shiftedCompressionDeterminant Sigma Q c))
    (hgm.comp (measurable_shiftedCompressionDeterminant Sigma M d))
    (fun X => hf0 _) (fun X => hg0 _)
  intro l
  let A : ℝ := (l : ℝ) + 1
  have hA : 0 ≤ A := by positivity
  have hfn : ∀ t, 0 ≤ nonnegativeTruncation l f t := nonnegativeTruncation_nonneg l f hf0
  have hgn : ∀ t, 0 ≤ nonnegativeTruncation l g t := nonnegativeTruncation_nonneg l g hg0
  exact gram_compression_monotone_pair_bounded n hSigma Q hQ M hM hc hd
    (nonnegativeTruncation l f) (nonnegativeTruncation l g)
    (hfm.min measurable_const) (hgm.min measurable_const) hfn hgn
    (fun x hx y hy hxy => min_le_min_right _ (hfmono hx hy hxy))
    (fun x hx y hy hxy => min_le_min_right _ (hgmono hx hy hxy)) A A hA hA
    (fun t => by rw [Real.norm_eq_abs, abs_of_nonneg (hfn t)]; exact min_le_right _ _)
    (fun t => by rw [Real.norm_eq_abs, abs_of_nonneg (hgn t)]; exact min_le_right _ _)

/-- The stronger extended-expectation form of the two-factor assertion.
Only the nonnegative-domain values and monotonicity of the outer functions enter.
All ranks, overlaps, and natural sample sizes are allowed. -/
theorem gram_compression_monotone_pair_lintegral {p q k : ℕ} (n : ℕ) {c d : ℝ}
    {Sigma : Matrix (Fin p) (Fin p) ℝ} (hSigma : Sigma.PosDef)
    (Q : Matrix (Fin p) (Fin q) ℝ) (hQ : Q.rank = q)
    (M : Matrix (Fin p) (Fin k) ℝ) (hM : M.rank = k) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (f g : ℝ → ℝ)
    (hf0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ f t) (hg0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ g t)
    (hfmono : MonotoneOn f (Set.Ici 0)) (hgmono : MonotoneOn g (Set.Ici 0)) :
    (∫⁻ X, ENNReal.ofReal (f (shiftedCompressionDeterminant Sigma Q c X))
      ∂wishartGramMeasure n Sigma) *
      (∫⁻ X, ENNReal.ofReal (g (shiftedCompressionDeterminant Sigma M d X))
        ∂wishartGramMeasure n Sigma) ≤
      ∫⁻ X, ENNReal.ofReal (f (shiftedCompressionDeterminant Sigma Q c X) *
        g (shiftedCompressionDeterminant Sigma M d X)) ∂wishartGramMeasure n Sigma := by
  let F := nonnegativeMonotoneExtension f
  let G := nonnegativeMonotoneExtension g
  have h := gram_compression_monotone_pair_lintegral_global n hSigma Q hQ M hM hc hd F G
    (measurable_nonnegativeMonotoneExtension hf0 hfmono)
    (measurable_nonnegativeMonotoneExtension hg0 hgmono)
    (nonnegativeMonotoneExtension_nonneg hf0) (nonnegativeMonotoneExtension_nonneg hg0)
    ((monotone_nonnegativeMonotoneExtension hf0 hfmono).monotoneOn _)
    ((monotone_nonnegativeMonotoneExtension hg0 hgmono).monotoneOn _)
  have heq : ∀ᵐ X ∂wishartGramMeasure n Sigma,
      F (shiftedCompressionDeterminant Sigma Q c X) = f (shiftedCompressionDeterminant Sigma Q c X) ∧
      G (shiftedCompressionDeterminant Sigma M d X) = g (shiftedCompressionDeterminant Sigma M d X) := by
    filter_upwards [ae_posSemidef_wishartGramMeasure n Sigma] with X hX
    exact ⟨nonnegativeMonotoneExtension_eq (shiftedCompressionDeterminant_nonneg_of_posSemidef hSigma.posSemidef Q hc hX),
      nonnegativeMonotoneExtension_eq (shiftedCompressionDeterminant_nonneg_of_posSemidef hSigma.posSemidef M hd hX)⟩
  have hsel := lintegral_congr_ae (heq.mono fun X hX => congrArg ENNReal.ofReal hX.1)
  have hrem := lintegral_congr_ae (heq.mono fun X hX => congrArg ENNReal.ofReal hX.2)
  have hjoint := lintegral_congr_ae (heq.mono fun X hX =>
    congrArg ENNReal.ofReal (congrArg₂ (· * ·) hX.1 hX.2))
  rwa [hsel, hrem, hjoint] at h

/-- The final sentence of Corollary 5.4, for arbitrary nonnegative
nondecreasing outer functions and exactly the displayed finite moments. -/
theorem corollary_5_4_monotone_pair {p q k : ℕ} (n : ℕ) {c d : ℝ}
    {Sigma : Matrix (Fin p) (Fin p) ℝ} (hSigma : Sigma.PosDef)
    (Q : Matrix (Fin p) (Fin q) ℝ) (hQ : Q.rank = q)
    (M : Matrix (Fin p) (Fin k) ℝ) (hM : M.rank = k) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (f g : ℝ → ℝ)
    (hf0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ f t) (hg0 : ∀ t ∈ Set.Ici (0 : ℝ), 0 ≤ g t)
    (hfmono : MonotoneOn f (Set.Ici 0)) (hgmono : MonotoneOn g (Set.Ici 0))
    (hIf : Integrable (fun X => f (shiftedCompressionDeterminant Sigma Q c X))
      (wishartGramMeasure n Sigma))
    (hIg : Integrable (fun X => g (shiftedCompressionDeterminant Sigma M d X))
      (wishartGramMeasure n Sigma))
    (hIjoint : Integrable (fun X => f (shiftedCompressionDeterminant Sigma Q c X) *
      g (shiftedCompressionDeterminant Sigma M d X)) (wishartGramMeasure n Sigma)) :
    (∫ X, f (shiftedCompressionDeterminant Sigma Q c X) ∂wishartGramMeasure n Sigma) *
      (∫ X, g (shiftedCompressionDeterminant Sigma M d X) ∂wishartGramMeasure n Sigma) ≤
      ∫ X, f (shiftedCompressionDeterminant Sigma Q c X) *
        g (shiftedCompressionDeterminant Sigma M d X) ∂wishartGramMeasure n Sigma := by
  have hfnn : ∀ᵐ X ∂wishartGramMeasure n Sigma,
      0 ≤ f (shiftedCompressionDeterminant Sigma Q c X) :=
    (ae_posSemidef_wishartGramMeasure n Sigma).mono fun X hX =>
      hf0 _ (shiftedCompressionDeterminant_nonneg_of_posSemidef hSigma.posSemidef Q hc hX)
  have hgnn : ∀ᵐ X ∂wishartGramMeasure n Sigma,
      0 ≤ g (shiftedCompressionDeterminant Sigma M d X) :=
    (ae_posSemidef_wishartGramMeasure n Sigma).mono fun X hX =>
      hg0 _ (shiftedCompressionDeterminant_nonneg_of_posSemidef hSigma.posSemidef M hd hX)
  have hprodnn := (hfnn.and hgnn).mono fun X hX => mul_nonneg hX.1 hX.2
  have h := gram_compression_monotone_pair_lintegral n hSigma Q hQ M hM hc hd f g hf0 hg0 hfmono hgmono
  rw [← ofReal_integral_eq_lintegral_ofReal hIf hfnn,
    ← ofReal_integral_eq_lintegral_ofReal hIg hgnn,
    ← ofReal_integral_eq_lintegral_ofReal hIjoint hprodnn,
    ← ENNReal.ofReal_mul (integral_nonneg_of_ae hfnn)] at h
  exact (ENNReal.ofReal_le_ofReal_iff (integral_nonneg_of_ae hprodnn)).mp h


end Wishart
end
