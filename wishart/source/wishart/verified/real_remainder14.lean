/- Source: Wishart/GramCorollary.lean -/



/-!
# Corollary 5.4: the actual singular integer Gaussian Gram law

The three principal exports are the geometric product inequality with its
exact retained-rank condition, the unrestricted arbitrary monotone pair
inequality, and joint finiteness of all nonnegative determinant powers.
The natural-number Gram law is defined from independent Gaussian rows.
-/

noncomputable section
open MeasureTheory ProbabilityTheory TauCeti TauCeti.Probability
open WishartVerification WishartVerification.MomentAssembly
open scoped Classical BigOperators ENNReal Matrix MatrixOrder Matrix.Norms.Operator
namespace Wishart

/-- The complete product assertion, with the prescribed finite boundary
values and actual almost-sure constancy under the specified law. -/
theorem corollary_5_4 {p : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (hn : 1 ≤ n) {Sigma : Matrix (Fin p) (Fin p) ℝ}
    (hSigma : Sigma.PosDef) (F : GramGeometricCompressionFamily p ι)
    (hrank : gramOrderedRankThreshold F.size (F.activeProper Sigma n) n) :
    (∏ i, ∫⁻ X, ENNReal.ofReal (F.factor Sigma i X) ∂wishartGramMeasure n Sigma) ≤
      ∫⁻ X, ENNReal.ofReal (∏ i, F.factor Sigma i X) ∂wishartGramMeasure n Sigma :=
  F.product_integrals_le_integral_product Sigma n hSigma hrank

/-- The finiteness sentence imposes no overlap, compression-rank, or sample
size threshold. It includes every nonnegative real exponent, and finite
moments of the joint product of every order. -/
theorem corollary_5_4_power_moments {p : ℕ} {ι : Type*} [Fintype ι]
    (n : ℕ) (Sigma : Matrix (Fin p) (Fin p) ℝ)
    (k : ι → ℕ) (B : ∀ i, Matrix (Fin p) (Fin (k i)) ℝ)
    (c ν : ι → ℝ) (hν : ∀ i, 0 ≤ ν i) :
    HasAllFiniteMoments (fun X : SymmetricMatrix p =>
      ∏ i, shiftedCompressionDeterminant Sigma (B i) (c i) X ^ ν i)
      (wishartGramMeasure n Sigma) := by
  simpa only [shiftedCompressionDeterminant, add_comm] using
    allFiniteMoments_gram_determinant_product n Sigma k
      (fun i => c i • compressionScale Sigma (B i)) B ν hν

/-- An almost-sure zero factor makes both the joint moment and the product
of marginal moments zero, even if another marginal moment is infinite. -/
theorem corollary_5_4_zero_factor {p : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (Sigma : Matrix (Fin p) (Fin p) ℝ)
    (F : GramGeometricCompressionFamily p ι) (i : ι)
    (hzero : ∀ᵐ X ∂wishartGramMeasure n Sigma, F.factor Sigma i X = 0) :
    F.moment Sigma n Finset.univ = 0 ∧
      (∏ j, F.moment Sigma n {j}) = 0 := by
  refine ⟨F.moment_eq_zero_of_factor_ae_zero Sigma n Finset.univ i (Finset.mem_univ i) hzero, ?_⟩
  apply Finset.prod_eq_zero (Finset.mem_univ i)
  exact F.moment_eq_zero_of_factor_ae_zero Sigma n {i} i (Finset.mem_singleton_self i) hzero

end Wishart
end
