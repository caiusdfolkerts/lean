module

public import ToricPower.SubfanOpenImmersion
public import ToricPower.SubfanRayRetraction
public import ToricPower.ToricAtlasFrameTransitions
public import Mathlib.AlgebraicGeometry.Morphisms.Affine

/-!
# The divisorial subfan inclusion is an affine open immersion

On every chart of the extending regular fan, its intersection with the
original toric variety is exactly the chart of the face generated by
the old rays. This proves affineness of the actual scheme map. It is
the geometric input allowing ordinary direct image to preserve
quasicoherence in the coherent-extension argument.
-/

@[expose] public noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicGeometry CategoryTheory TauCeti.Toric Set

namespace ToricPower

universe u

variable {N : Type u} {V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} (fan extension : Fan i) (included : fan.cones ⊆ extension.cones)
  (regular : extension.IsRegular) (rayFull : IsFullOnRays fan extension)

/-- The old-ray face is the greatest original cone contained in the
specified extension cone. -/
theorem subfanCone_le_oldRayFace_iff (σ : fan.cones) (τ : extension.cones) :
    σ ≤ subfanOldRayFace fan extension regular rayFull τ ↔
      subfanConeEmbedding fan extension included σ ≤ τ := by
  constructor
  · intro below
    change σ.val ≤ τ.val
    change σ.val ≤ (subfanOldRayFace fan extension regular rayFull τ).val at below
    exact below.trans (subfanOldRayFace_le fan extension regular rayFull τ)
  · intro below
    apply fanCone_le_of_rays fan
    intro ρ rayBelow
    apply (subfanOldRayFace_oldRay fan extension included regular rayFull τ ρ).mpr
    change ρ.toCone.val ≤ σ.val at rayBelow
    change σ.val ≤ τ.val at below
    change ρ.toCone.val ≤ τ.val
    exact rayBelow.trans below

/-- The actual inverse image of every extension chart is the actual
old-ray-face chart of the original fan. -/
theorem subfanSchemeMap_chart_preimage (τ : extension.cones) :
    subfanSchemeMap fan extension included ⁻¹ᵁ (extension.affineToricChartι τ).opensRange =
      (fan.affineToricChartι (subfanOldRayFace fan extension regular rayFull τ)).opensRange := by
  apply TopologicalSpace.Opens.ext
  ext x
  constructor
  · intro inside
    obtain ⟨σ,z,rfl⟩ := fan.exists_affineToricChartι_apply_eq x
    let oldσ := subfanConeEmbedding fan extension included σ
    have both : subfanSchemeMap fan extension included (fan.affineToricChartι σ z) ∈
        (extension.affineToricChartι oldσ).opensRange ⊓
          (extension.affineToricChartι τ).opensRange :=
      ⟨⟨z,(subfanSchemeMap_chart_apply fan extension included σ z).symm⟩,inside⟩
    rw [← chart_opensRange_intersection extension oldσ τ] at both
    obtain ⟨w,pointEqual⟩ := both
    have oldMeet : (oldσ ⊓ τ).val ∈ fan.cones :=
      fan.mem_of_isFaceOf σ.property
        (extension.isFaceOf_of_le oldσ.property (oldσ ⊓ τ).property inf_le_left)
    let meet : fan.cones := ⟨(oldσ ⊓ τ).val,oldMeet⟩
    have meetBelow : meet ≤ subfanOldRayFace fan extension regular rayFull τ :=
      (subfanCone_le_oldRayFace_iff fan extension included regular rayFull meet τ).mpr
        inf_le_right
    have samePoint : fan.affineToricChartι meet w = fan.affineToricChartι σ z :=
      subfanSchemeMap_injective fan extension included
        ((subfanSchemeMap_chart_apply fan extension included meet w).trans pointEqual)
    exact samePoint ▸ toricChart_opensRange_mono fan meetBelow ⟨w,rfl⟩
  · rintro ⟨z,rfl⟩
    change subfanSchemeMap fan extension included
      (fan.affineToricChartι (subfanOldRayFace fan extension regular rayFull τ) z) ∈
        (extension.affineToricChartι τ).opensRange
    rw [subfanSchemeMap_chart_apply]
    exact toricChart_opensRange_mono extension (small := subfanConeEmbedding fan extension included
      (subfanOldRayFace fan extension regular rayFull τ)) (large := τ)
      (subfanOldRayFace_le fan extension regular rayFull τ) ⟨z,rfl⟩

include regular rayFull in
/-- This is the literal open immersion from the original fan, proved
affine by its genuine affine chart inverse images. -/
theorem subfanSchemeMap_isAffineHom :
    IsAffineHom (subfanSchemeMap fan extension included) := by
  apply isAffineHom_of_forall_exists_isAffineOpen
  intro x
  obtain ⟨τ,z,rfl⟩ := extension.exists_affineToricChartι_apply_eq x
  refine ⟨(extension.affineToricChartι τ).opensRange,⟨z,rfl⟩,
    isAffineOpen_opensRange (extension.affineToricChartι τ),?_⟩
  rw [subfanSchemeMap_chart_preimage fan extension included regular rayFull τ]
  exact isAffineOpen_opensRange
    (fan.affineToricChartι (subfanOldRayFace fan extension regular rayFull τ))

end ToricPower

end
