module

public import ToricPower.FanRayCoordinates

/-!
# Exact intersections of coherently lifted quotient cones

Choose one lift of each ray of a quotient fan and a positive kernel
vector. The cone above a quotient cone is generated by those ray lifts
and the kernel vector. Its intersection with another such cone is
exactly the lift of the common face. All memberships are proved from
actual nonnegative ray coefficients; no fan intersection axiom is
assumed for the lifted cones.
-/

@[expose] public noncomputable section

open TauCeti.Toric
namespace ToricPower.FanSubdivision

variable {P V W : Type*} [AddCommGroup P]
  [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  {j : P →+ W} (fan : Fan j) (a : V) (lifts : fan.Ray → V)

def liftedRayCombination : (fan.Ray →₀ ℝ) →ₗ[ℝ] V :=
  Finsupp.linearCombination ℝ lifts

/-- The positive lift of a quotient cone, including the kernel ray. -/
def liftedCone (σ : fan.cones) : PointedCone ℝ V :=
  PointedCone.hull ℝ {a} ⊔ PointedCone.hull ℝ
    (lifts '' {ρ : fan.Ray | ρ.toCone ≤ σ})

theorem mem_liftedCone_iff (σ : fan.cones) (x : V) :
    x ∈ liftedCone fan a lifts σ ↔
      ∃ (r : ℝ) (c : fan.Ray →₀ ℝ), 0 ≤ r ∧ (∀ ρ, 0 ≤ c ρ) ∧
        rayProfileSupported fan σ c ∧ r • a + liftedRayCombination fan lifts c = x := by
  constructor
  · intro member
    obtain ⟨y,hy,z,hz,sum⟩ := Submodule.mem_sup.mp member
    obtain ⟨r,nonnegative,rfl⟩ := PointedCone.mem_hull_singleton.mp hy
    obtain ⟨c,supported,positive,eq⟩ := PointedCone.mem_hull_image_iff_linearCombination.mp hz
    exact ⟨r,c,nonnegative,positive,(Finsupp.mem_supported _ _).mp supported,
      (congrArg (fun v => r • a + v) eq).trans sum⟩
  · rintro ⟨r,c,nonnegative,positive,supported,evaluate⟩
    rw [← evaluate]
    apply Submodule.mem_sup.mpr
    refine ⟨r • a,PointedCone.mem_hull_singleton.mpr ⟨r,nonnegative,rfl⟩,
      liftedRayCombination fan lifts c,?_,rfl⟩
    exact PointedCone.mem_hull_image_iff_linearCombination.mpr
      ⟨c,(Finsupp.mem_supported _ _).mpr supported,positive,rfl⟩

theorem liftedCone_mono {σ τ : fan.cones} (below : σ ≤ τ) :
    liftedCone fan a lifts σ ≤ liftedCone fan a lifts τ := by
  intro x member
  obtain ⟨r,c,hr,hc,supported,evaluate⟩ := (mem_liftedCone_iff fan a lifts σ x).mp member
  exact (mem_liftedCone_iff fan a lifts τ x).mpr
    ⟨r,c,hr,hc,fun ρ hρ => (supported ρ hρ).trans below,evaluate⟩

theorem generator_mem_liftedCone (σ : fan.cones) : a ∈ liftedCone fan a lifts σ := by
  apply (show PointedCone.hull ℝ {a} ≤ liftedCone fan a lifts σ from le_sup_left)
  exact PointedCone.subset_hull (Set.mem_singleton a)

theorem rayLift_mem_liftedCone (σ : fan.cones) (ρ : fan.Ray) (below : ρ.toCone ≤ σ) :
    lifts ρ ∈ liftedCone fan a lifts σ := by
  apply (show PointedCone.hull ℝ (lifts '' {ρ : fan.Ray | ρ.toCone ≤ σ}) ≤
    liftedCone fan a lifts σ from le_sup_right)
  exact PointedCone.subset_hull ⟨ρ,below,rfl⟩

variable (projection : V →ₗ[ℝ] W) (kernelVector : projection a = 0)
  (projects : ∀ ρ, projection (lifts ρ) = fanRayRealVector fan ρ)

include projects in
theorem liftedRayCombination_projects (c : fan.Ray →₀ ℝ) :
    projection (liftedRayCombination fan lifts c) = fanRayCombination fan c := by
  rw [liftedRayCombination,LinearMap.map_finsupp_linearCombination]
  have vectors : projection ∘ lifts = fanRayRealVector fan := funext projects
  rw [vectors]
  rfl

include kernelVector projects in
theorem liftedProfile_projects (r : ℝ) (c : fan.Ray →₀ ℝ) :
    projection (r • a + liftedRayCombination fan lifts c) = fanRayCombination fan c := by
  rw [map_add,map_smul,kernelVector,smul_zero,zero_add,
    liftedRayCombination_projects fan lifts projection projects]

include kernelVector projects in
theorem liftedCone_projects_mem (σ : fan.cones) {x : V}
    (member : x ∈ liftedCone fan a lifts σ) : projection x ∈ σ.val := by
  obtain ⟨r,c,hr,hc,supported,rfl⟩ := (mem_liftedCone_iff fan a lifts σ x).mp member
  rw [liftedProfile_projects fan a lifts projection kernelVector projects]
  exact rayProfileCombination_mem fan σ c hc supported

include kernelVector projects in
/-- Membership in an overlapping lifted cone is detected by the
literal projected point, once membership in the first cone is known. -/
theorem mem_liftedCone_of_projection_mem (σ τ : fan.cones) {x : V}
    (member : x ∈ liftedCone fan a lifts σ) (projected : projection x ∈ τ.val) :
    x ∈ liftedCone fan a lifts τ := by
  obtain ⟨r,c,hr,hc,supported,evaluate⟩ := (mem_liftedCone_iff fan a lifts σ x).mp member
  have projectionEq : fanRayCombination fan c = projection x := by
    rw [← evaluate,liftedProfile_projects fan a lifts projection kernelVector projects]
  have common : fanRayCombination fan c ∈ σ.val ⊓ τ.val :=
    ⟨rayProfileCombination_mem fan σ c hc supported,projectionEq.symm ▸ projected⟩
  have commonSupport := rayProfile_supported_in_face fan σ (σ.val ⊓ τ.val)
    (fan.inf_isFaceOf_left σ.property τ.property) c hc supported common
  exact (mem_liftedCone_iff fan a lifts τ x).mpr
    ⟨r,c,hr,hc,fun ρ hρ => (commonSupport ρ hρ).trans inf_le_right,evaluate⟩

include kernelVector projects in
theorem liftedCone_inf (σ τ : fan.cones) :
    liftedCone fan a lifts σ ⊓ liftedCone fan a lifts τ =
      liftedCone fan a lifts (σ ⊓ τ) := by
  apply le_antisymm
  · intro x member
    apply mem_liftedCone_of_projection_mem fan a lifts projection kernelVector projects σ (σ ⊓ τ)
      member.1
    exact ⟨liftedCone_projects_mem fan a lifts projection kernelVector projects σ member.1,
      liftedCone_projects_mem fan a lifts projection kernelVector projects τ member.2⟩
  · exact le_inf (liftedCone_mono fan a lifts inf_le_left)
      (liftedCone_mono fan a lifts inf_le_right)

include kernelVector projects in
/-- The common lifted cone is a face for the actual cone definition. -/
theorem liftedCone_inf_isFaceOf (σ τ : fan.cones) :
    (liftedCone fan a lifts σ ⊓ liftedCone fan a lifts τ).IsFaceOf
      (liftedCone fan a lifts σ) := by
  refine ⟨inf_le_left,?_⟩
  intro x y r hx hy positive combined
  have hx' := liftedCone_projects_mem fan a lifts projection kernelVector projects σ hx
  have hy' := liftedCone_projects_mem fan a lifts projection kernelVector projects σ hy
  have combined' : r • projection x + projection y ∈ σ.val ⊓ τ.val := by
    rw [← map_smul,← map_add]
    exact ⟨liftedCone_projects_mem fan a lifts projection kernelVector projects σ combined.1,
      liftedCone_projects_mem fan a lifts projection kernelVector projects τ combined.2⟩
  have inFace := (fan.inf_isFaceOf_left σ.property τ.property).mem_of_smul_add_mem
    hx' hy' positive combined'
  exact ⟨hx,mem_liftedCone_of_projection_mem fan a lifts projection kernelVector projects
    σ τ hx inFace.2⟩

end ToricPower.FanSubdivision
end
