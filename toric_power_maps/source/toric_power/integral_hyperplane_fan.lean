module

public import ToricPower.IntegralHalfspaceCones
public import TauCeti.Geometry.Toric.Algebraic.Fan.Basic

/-!
# The complete rational fan of a finite integral hyperplane arrangement

Every sign region is an actual cone generated by finitely many lattice
vectors. A separating family of forms makes these cones salient. Their
intersections are faces, and every vector belongs to its own sign region.
Thus the arrangement gives an actual complete toric fan in the original
lattice, without assuming polyhedral rationality or completeness.
-/

@[expose] public noncomputable section
open TauCeti.Toric Set

namespace ToricPower.FanSubdivision

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

def signConstraint (sign : Ordering) (value : ℝ) : Prop :=
  match sign with
  | .lt => value ≤ 0
  | .eq => value = 0
  | .gt => 0 ≤ value

def signHalfspace (form : V →ₗ[ℝ] ℝ) (sign : Ordering) : PointedCone ℝ V :=
  match sign with
  | .lt => PointedCone.comap (-form) (PointedCone.positive ℝ ℝ)
  | .eq => PointedCone.ofSubmodule form.ker
  | .gt => PointedCone.comap form (PointedCone.positive ℝ ℝ)

theorem mem_signHalfspace (form : V →ₗ[ℝ] ℝ) (sign : Ordering) (x : V) :
    x ∈ signHalfspace form sign ↔ signConstraint sign (form x) := by
  cases sign <;> simp [signHalfspace,signConstraint]

def hyperplaneSignCone {κ : Type*} (forms : κ → V →ₗ[ℝ] ℝ) (sign : κ → Ordering) :
    PointedCone ℝ V := ⨅ k, signHalfspace (forms k) (sign k)

theorem mem_hyperplaneSignCone {κ : Type*} (forms : κ → V →ₗ[ℝ] ℝ)
    (sign : κ → Ordering) (x : V) :
    x ∈ hyperplaneSignCone forms sign ↔ ∀ k, signConstraint (sign k) (forms k x) := by
  simp only [hyperplaneSignCone,Submodule.mem_iInf,mem_signHalfspace]

/-- The actual common part of two sign regions is a face of each. -/
theorem hyperplaneSignCone_inf_isFaceOf {κ : Type*} (forms : κ → V →ₗ[ℝ] ℝ)
    (first second : κ → Ordering) :
    (hyperplaneSignCone forms first ⊓ hyperplaneSignCone forms second).IsFaceOf
      (hyperplaneSignCone forms first) := by
  refine ⟨inf_le_left,?_⟩
  intro x y r hx hy positive combined
  refine ⟨hx,(mem_hyperplaneSignCone forms second x).mpr ?_⟩
  intro k
  have firstX := (mem_hyperplaneSignCone forms first x).mp hx k
  have firstY := (mem_hyperplaneSignCone forms first y).mp hy k
  have secondSum := (mem_hyperplaneSignCone forms second (r • x+y)).mp combined.2 k
  rw [map_add,map_smul,smul_eq_mul] at secondSum
  cases hfirst : first k <;> cases hsecond : second k <;>
    simp only [hfirst,hsecond,signConstraint] at firstX firstY secondSum ⊢ <;> nlinarith

variable {κ N : Type*} [Fintype κ] [DecidableEq κ] [AddCommGroup N]
  {i : N →+ V} (lattice : IsIntegralLattice i) (characters : κ → N →+ ℤ)

def signInequalityCharacters (sign : κ → Ordering) : (κ × Bool) → N →+ ℤ :=
  fun p => match sign p.1,p.2 with
  | .lt,false => characters p.1
  | .lt,true => 0
  | .eq,false => characters p.1
  | .eq,true => -(characters p.1)
  | .gt,false => -(characters p.1)
  | .gt,true => 0

theorem hyperplaneSignCone_integral_inequalities (sign : κ → Ordering) (x : V) :
    x ∈ hyperplaneSignCone (fun k => lattice.realCharacter (characters k)) sign ↔
      ∀ p, lattice.realCharacter (signInequalityCharacters characters sign p) x ≤ 0 := by
  rw [mem_hyperplaneSignCone]
  constructor
  · intro member p
    obtain ⟨k,b⟩ := p
    have signX := member k
    cases h : sign k <;> cases b <;>
      simp only [h,signConstraint] at signX <;>
      simp only [signInequalityCharacters,h,map_zero,map_neg,LinearMap.zero_apply,LinearMap.neg_apply] <;>
      linarith
  · intro inequalities k
    have first := inequalities (k,false)
    have second := inequalities (k,true)
    cases h : sign k <;>
      simp only [signInequalityCharacters,h,map_zero,map_neg,LinearMap.zero_apply,LinearMap.neg_apply]
        at first second <;>
      simp only [signConstraint] <;> linarith

theorem hyperplaneSignCone_rational (sign : κ → Ordering) :
    IsLatticeRational i
      (hyperplaneSignCone (fun k => lattice.realCharacter (characters k)) sign) :=
  integral_inequalityCone_isLatticeRational lattice _
    (signInequalityCharacters characters sign)
    (hyperplaneSignCone_integral_inequalities lattice characters sign)

variable (separates : ∀ x : V, (∀ k, lattice.realCharacter (characters k) x = 0) → x = 0)

include separates in
theorem hyperplaneSignCone_toric (sign : κ → Ordering) :
    IsToricCone i
      (hyperplaneSignCone (fun k => lattice.realCharacter (characters k)) sign) := by
  refine ⟨hyperplaneSignCone_rational lattice characters sign,?_⟩
  intro x member nonzero negativeMember
  apply nonzero
  apply separates x
  intro k
  have positive := (mem_hyperplaneSignCone _ sign x).mp member k
  have negative := (mem_hyperplaneSignCone _ sign (-x)).mp negativeMember k
  rw [map_neg] at negative
  cases h : sign k <;> simp only [h,signConstraint] at positive negative <;> linarith

/-- The genuine finite complete fan cut out by the integral hyperplanes. -/
def integralHyperplaneFan : Fan i :=
  Fan.ofCones lattice
    (Set.range (hyperplaneSignCone (fun k => lattice.realCharacter (characters k))))
    (Set.finite_range _) (by
      rintro _ ⟨sign,rfl⟩
      exact hyperplaneSignCone_toric lattice characters separates sign)
    (by
      rintro _ _ ⟨first,rfl⟩ ⟨second,rfl⟩
      exact hyperplaneSignCone_inf_isFaceOf _ first second)

theorem hyperplaneSignCone_mem_fan (sign : κ → Ordering) :
    hyperplaneSignCone (fun k => lattice.realCharacter (characters k)) sign ∈
      (integralHyperplaneFan lattice characters separates).cones :=
  Fan.subset_ofCones_cones _ _ _ _ _ ⟨sign,rfl⟩

theorem integralHyperplaneFan_complete :
    (integralHyperplaneFan lattice characters separates).IsComplete := by
  classical
  rw [Fan.isComplete_iff]
  intro x
  let sign : κ → Ordering := fun k =>
    if lattice.realCharacter (characters k) x < 0 then .lt
    else if lattice.realCharacter (characters k) x = 0 then .eq else .gt
  refine ⟨hyperplaneSignCone (fun k => lattice.realCharacter (characters k)) sign,
    hyperplaneSignCone_mem_fan lattice characters separates sign,?_⟩
  apply (mem_hyperplaneSignCone _ sign x).mpr
  intro k
  dsimp [sign]
  split_ifs <;> simp only [signConstraint] <;> linarith

/-- Every hyperplane has a constant weak sign on every cone of the
constructed fan, including all faces added by `Fan.ofCones`. -/
theorem integralHyperplaneFan_cone_weakSign
    (σ : (integralHyperplaneFan lattice characters separates).cones) (k : κ) :
    (∀ x ∈ σ.val, 0 ≤ lattice.realCharacter (characters k) x) ∨
      (∀ x ∈ σ.val, lattice.realCharacter (characters k) x ≤ 0) := by
  obtain ⟨_,⟨sign,rfl⟩,face⟩ :=
    (Fan.mem_ofCones_cones lattice _ _ _ _).mp σ.property
  have constrained (x : V) (member : x ∈ σ.val) :=
    (mem_hyperplaneSignCone _ sign x).mp (face.le member) k
  cases h : sign k
  · right
    intro x member
    simpa only [h,signConstraint] using constrained x member
  · left
    intro x member
    have zero : lattice.realCharacter (characters k) x = 0 := by
      simpa only [h,signConstraint] using constrained x member
    exact zero.ge
  · left
    intro x member
    simpa only [h,signConstraint] using constrained x member

end ToricPower.FanSubdivision
end
