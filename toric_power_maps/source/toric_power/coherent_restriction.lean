open CategoryTheory Limits

namespace TauCeti.AlgebraicGeometry

open _root_.AlgebraicGeometry _root_.AlgebraicGeometry.Scheme.Modules

universe u

noncomputable section

private theorem isQuasicoherent_kernel_spec {R : CommRingCat.{u}}
    {M N : (Spec R).Modules} (f : M ⟶ N) [M.IsQuasicoherent] [N.IsQuasicoherent] :
    (kernel f).IsQuasicoherent := by
  exact (SheafOfModules.isQuasicoherent (Spec R).ringCatSheaf).prop_of_iso
    (tildeKernelIso f) inferInstance

private theorem isQuasicoherent_kernel_affine {X : Scheme.{u}} [IsAffine X]
    {M N : X.Modules} (f : M ⟶ N) [M.IsQuasicoherent] [N.IsQuasicoherent] :
    (kernel f).IsQuasicoherent := by
  let F := Scheme.Modules.restrictFunctor X.isoSpec.inv
  have : (F.obj (kernel f)).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent (Spec Γ(X, ⊤)).ringCatSheaf).prop_of_iso
      (PreservesKernel.iso F f).symm (isQuasicoherent_kernel_spec (F.map f))
  exact isQuasicoherent_of_isQuasicoherent_restrict_iso X.isoSpec (kernel f)

/-- The ambient kernel of a morphism of quasicoherent sheaves on any scheme is quasicoherent. -/
instance _root_.AlgebraicGeometry.Scheme.Modules.isQuasicoherent_kernel
    {X : Scheme.{u}} {M N : X.Modules} (f : M ⟶ N)
    [M.IsQuasicoherent] [N.IsQuasicoherent] : (kernel f).IsQuasicoherent := by
  refine isQuasicoherent_of_isQuasicoherent_restrict_affineOpens (kernel f) fun U ↦ ?_
  let F := Scheme.Modules.restrictFunctor U.1.ι
  exact (SheafOfModules.isQuasicoherent U.1.toScheme.ringCatSheaf).prop_of_iso
    (PreservesKernel.iso F f).symm (isQuasicoherent_kernel_affine (F.map f))

/-- Kernels of quasicoherent modules on the slice site of an open subscheme are
quasicoherent. This is the open-subscheme kernel criterion transported by `overEquiv`. -/
instance isQuasicoherent_kernel_over {X : Scheme.{u}} (U : X.Opens)
    {M N : SheafOfModules.{u} (X.ringCatSheaf.over U)} (f : M ⟶ N)
    [M.IsQuasicoherent] [N.IsQuasicoherent] : (kernel f).IsQuasicoherent := by
  let e := Scheme.Modules.overEquiv U
  have : (e.functor.obj (kernel f)).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent U.toScheme.ringCatSheaf).prop_of_iso
      (PreservesKernel.iso e.functor f).symm
      (Scheme.Modules.isQuasicoherent_kernel (e.functor.map f))
  have h := isQuasicoherent_overEquiv_inverse U (e.functor.obj (kernel f))
  exact (SheafOfModules.isQuasicoherent (X.ringCatSheaf.over U)).prop_of_iso
    (e.unitIso.app (kernel f)).symm h

/-- Quasicoherence is closed under ambient kernels. The generic full-subcategory construction
therefore supplies kernels in `QuasicoherentSheaf X`. -/
instance _root_.AlgebraicGeometry.Scheme.Modules.isQuasicoherent_isClosedUnderKernels
    (X : Scheme.{u}) :
    (SheafOfModules.isQuasicoherent X.ringCatSheaf).IsClosedUnderKernels where
  kernels_le := by
    rintro _ ⟨f, k, hk, hM, hN⟩
    have := hM
    have := hN
    exact (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso
      (limit.isoLimitCone ⟨k, hk⟩) (Scheme.Modules.isQuasicoherent_kernel f)

namespace QuasicoherentSheaf

/-- The inclusion of quasicoherent sheaves preserves kernels: their universal property is the
one in the ambient category of all module sheaves. -/
instance inclusion_preservesKernel {X : Scheme.{u}} {E F : QuasicoherentSheaf X}
    (f : E ⟶ F) :
    PreservesLimit (parallelPair f 0) (ObjectProperty.ι
      (SheafOfModules.isQuasicoherent X.ringCatSheaf)) :=
  ObjectProperty.preservesKernels_ι _ f

end QuasicoherentSheaf

end

end TauCeti.AlgebraicGeometry

end

end QuasicoherentKernelSource

namespace TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf

universe u

variable {U X : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j]

/-- Restriction to an open subscheme in the actual category of coherent
module sheaves. -/
def restrictFunctor : FinitelyPresentedSheaf X ⥤ FinitelyPresentedSheaf U :=
  ObjectProperty.lift _ (ObjectProperty.ι _ ⋙ Scheme.Modules.restrictFunctor j)
    (fun M => ToricPower.finitePresentation_restrict j M.obj)

@[simp]
theorem restrictFunctor_obj_underlying (M : FinitelyPresentedSheaf X) :
    ((restrictFunctor j).obj M).obj = (Scheme.Modules.restrictFunctor j).obj M.obj := rfl

@[simp]
theorem restrictFunctor_map_underlying {M N : FinitelyPresentedSheaf X} (φ : M ⟶ N) :
    ((restrictFunctor j).map φ).hom = (Scheme.Modules.restrictFunctor j).map φ.hom := rfl

@[simp]
theorem restrictFunctor_comp_inclusion :
    restrictFunctor j ⋙ ObjectProperty.ι (SheafOfModules.isFinitePresentation U.ringCatSheaf) =
      ObjectProperty.ι (SheafOfModules.isFinitePresentation X.ringCatSheaf) ⋙
        Scheme.Modules.restrictFunctor j := rfl

instance : (restrictFunctor j).Additive := by
  constructor
  intro M N φ ψ
  exact ObjectProperty.hom_ext _
    ((Scheme.Modules.restrictFunctor j).map_add (f := φ.hom) (g := ψ.hom))

variable [IsLocallyNoetherian U] [IsLocallyNoetherian X]

instance : PreservesFiniteLimits (restrictFunctor j) := by
  let F := restrictFunctor j
  let I : FinitelyPresentedSheaf U ⥤ U.Modules :=
    (SheafOfModules.isFinitePresentation U.ringCatSheaf).ι
  have hFI : PreservesFiniteLimits (F ⋙ I) := by
    change PreservesFiniteLimits
      ((SheafOfModules.isFinitePresentation X.ringCatSheaf).ι ⋙
        Scheme.Modules.restrictFunctor j)
    exact @comp_preservesFiniteLimits _ _ _ _ _ _ _ _
      (ToricPower.coherentInclusion_preservesFiniteLimits X)
      (inferInstanceAs (PreservesFiniteLimits (Scheme.Modules.restrictFunctor j)))
  letI := hFI
  exact preservesFiniteLimits_of_reflects_of_preserves F I

instance : PreservesFiniteColimits (restrictFunctor j) := by
  let F := restrictFunctor j
  let I : FinitelyPresentedSheaf U ⥤ U.Modules :=
    (SheafOfModules.isFinitePresentation U.ringCatSheaf).ι
  have hFI : PreservesFiniteColimits (F ⋙ I) := by
    change PreservesFiniteColimits
      ((SheafOfModules.isFinitePresentation X.ringCatSheaf).ι ⋙
        Scheme.Modules.restrictFunctor j)
    exact @comp_preservesFiniteColimits _ _ _ _ _ _ _ _
      (ToricPower.coherentInclusion_preservesFiniteColimits X)
      (inferInstanceAs (PreservesFiniteColimits (Scheme.Modules.restrictFunctor j)))
  letI := hFI
  exact preservesFiniteColimits_of_reflects_of_preserves F I

end TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf

namespace ToricPower

universe u

local instance coherentRestrictionStandardDerivedCategory (X : Scheme.{u})
    [IsLocallyNoetherian X] : HasDerivedCategory.{u + 1} (Coh X) :=
  HasDerivedCategory.standard (Coh X)

variable {U X : Scheme.{u}} [IsLocallyNoetherian U] [IsLocallyNoetherian X]
  (j : U ⟶ X) [IsOpenImmersion j]

/-- Exact restriction on the literal bounded derived categories of
coherent sheaves. -/
def coherentDerivedRestriction : DbCoh X ⥤ DbCoh U :=
  (TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf.restrictFunctor j).mapBoundedDerivedCategory

instance : (coherentDerivedRestriction j).CommShift ℤ := by
  unfold coherentDerivedRestriction
  infer_instance

instance : (coherentDerivedRestriction j).IsTriangulated := by
  unfold coherentDerivedRestriction
  infer_instance

/-- Derived restriction of a sheaf in degree zero is its ordinary
restriction in degree zero. -/
def coherentDerivedRestrictionSingleIso (M : Coh X) :
    (coherentDerivedRestriction j).obj (coherentSingle X M) ≅
      coherentSingle U
        ((TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf.restrictFunctor j).obj M) :=
  ((TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf.restrictFunctor j).mapBoundedDerivedCategorySingleFunctor
    0).app M

/-- Once extension of coherent sheaves has been established geometrically,
exact restriction preserves classical generators. Only extension of sheaves,
not lifting of arbitrary complexes, is needed for this implication. -/
theorem coherentDerivedRestriction_generates_of_essentiallySurjective
    [(TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf.restrictFunctor j).EssSurj]
    (G : DbCoh X) (hG : generatesDbCoh G) :
    generatesDbCoh ((coherentDerivedRestriction j).obj G) :=
  boundedDerived_generator_of_essentiallySurjective
    (TauCeti.AlgebraicGeometry.FinitelyPresentedSheaf.restrictFunctor j) G hG

end ToricPower

end
