/-!
# Coherent restriction and finite algebraic extensions

Restriction along an open immersion is the actual restriction of module
sheaves. On locally Noetherian schemes its restriction to coherent sheaves
is exact. This file also supplies the algebraic extension step: finitely
many finite localizations of a module are already localizations of one
finitely generated submodule, which is finitely presented over a
Noetherian base.

The geometric assertion that every coherent sheaf extends across a
quasi-compact open immersion is a separate assertion. No essential
surjectivity instance is postulated here.
-/

@[expose] public noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

namespace ToricPower

section FiniteLocalization

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]

/-- A finite localized module is generated by the fractions of finitely
many elements of the original module. The original module need not be
finitely generated. -/
theorem exists_fg_submodule_localized_eq_top
    {S N : Type*} [CommRing S] [Algebra R S]
    [AddCommGroup N] [Module R N] [Module S N] [IsScalarTower R S N]
    (p : Submonoid R) [IsLocalization p S]
    (f : M →ₗ[R] N) [IsLocalizedModule p f] [Module.Finite S N] :
    ∃ P : Submodule R M, P.FG ∧ P.localized' S p f = ⊤ := by
  classical
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := S) (M := N)
  choose a ha using fun i : Fin n => IsLocalizedModule.mk'_surjective p f (g i)
  let P : Submodule R M := Submodule.span R (Set.range (fun i : Fin n => (a i).1))
  refine ⟨P, Submodule.fg_span (Set.finite_range _), ?_⟩
  apply top_unique
  rw [← hg, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  exact ⟨(a i).1, Submodule.subset_span ⟨i, rfl⟩, (a i).2, ha i⟩

/-- The finite submodules needed for finitely many localizations can be
chosen simultaneously. Different members may use different localization
rings and different localized modules. -/
theorem exists_fg_submodule_localized_eq_top_family
    {I : Type*} [Finite I]
    (S N : I → Type*) [∀ i, CommRing (S i)] [∀ i, Algebra R (S i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    [∀ i, Module (S i) (N i)] [∀ i, IsScalarTower R (S i) (N i)]
    (p : I → Submonoid R) [∀ i, IsLocalization (p i) (S i)]
    (f : ∀ i, M →ₗ[R] N i) [∀ i, IsLocalizedModule (p i) (f i)]
    [∀ i, Module.Finite (S i) (N i)] :
    ∃ P : Submodule R M, P.FG ∧ ∀ i, P.localized' (S i) (p i) (f i) = ⊤ := by
  classical
  choose P hP hloc using fun i =>
    exists_fg_submodule_localized_eq_top (S := S i) (N := N i) (p i) (f i)
  refine ⟨⨆ i, P i, Submodule.fg_iSup P hP, ?_⟩
  intro i
  rw [Submodule.localized'_iSup]
  apply top_unique
  rw [← hloc i]
  exact le_iSup (fun j => (P j).localized' (S i) (p i) (f i)) i

/-- Over a Noetherian ring the simultaneous extension can be chosen
finitely presented, as required for the affine coherent-sheaf extension
argument. -/
theorem exists_finitePresentation_submodule_localized_eq_top_family
    [IsNoetherianRing R] {I : Type*} [Finite I]
    (S N : I → Type*) [∀ i, CommRing (S i)] [∀ i, Algebra R (S i)]
    [∀ i, AddCommGroup (N i)] [∀ i, Module R (N i)]
    [∀ i, Module (S i) (N i)] [∀ i, IsScalarTower R (S i) (N i)]
    (p : I → Submonoid R) [∀ i, IsLocalization (p i) (S i)]
    (f : ∀ i, M →ₗ[R] N i) [∀ i, IsLocalizedModule (p i) (f i)]
    [∀ i, Module.Finite (S i) (N i)] :
    ∃ P : Submodule R M, Module.FinitePresentation R P ∧
      ∀ i, P.localized' (S i) (p i) (f i) = ⊤ := by
  obtain ⟨P, hP, hloc⟩ :=
    exists_fg_submodule_localized_eq_top_family S N p f
  letI : Module.Finite R P := Module.Finite.iff_fg.mpr hP
  exact ⟨P, Module.finitePresentation_of_finite R P, hloc⟩

end FiniteLocalization

end ToricPower


