module

public import TauCeti.Geometry.Toric.Algebraic.Fan.Basic
public import TauCeti.Geometry.Convex.Cone.Face.Simplicial
public import Mathlib.Geometry.Convex.Cone.Simplicial
public import Mathlib.Tactic.Linarith
public import Mathlib.Tactic.Abel

/-!
# Coning a boundary subdivision

The cones used in a relative subdivision are literal sums of a ray and
boundary cones. Their intersections are established geometrically: a point
of a proper face cannot contain a positive contribution from an interior
point. This also proves uniqueness of the radial coordinate, so coning
preserves the face relation and simpliciality.
-/

@[expose] public noncomputable section

open TauCeti.Toric

namespace ToricPower.FanSubdivision

variable {V : Type*} [AddCommGroup V] [Module ℝ V]
  {C F G S T : PointedCone ℝ V} {p x y z : V} {a b : ℝ}

/-- The actual cone generated by a point and a cone. -/
def rayJoin (p : V) (S : PointedCone ℝ V) : PointedCone ℝ V :=
  PointedCone.hull ℝ {p} ⊔ S

theorem mem_rayJoin : x ∈ rayJoin p S ↔
    ∃ a : ℝ, 0 ≤ a ∧ ∃ y ∈ S, a • p + y = x := by
  constructor
  · intro hx
    obtain ⟨u, hu, y, hy, h⟩ := Submodule.mem_sup.mp hx
    obtain ⟨a, ha, rfl⟩ := PointedCone.mem_hull_singleton.mp hu
    exact ⟨a, ha, y, hy, h⟩
  · rintro ⟨a, ha, y, hy, rfl⟩
    exact Submodule.add_mem_sup (PointedCone.mem_hull_singleton.mpr ⟨a, ha, rfl⟩) hy

theorem rayJoin_mono (p : V) (h : S ≤ T) : rayJoin p S ≤ rayJoin p T :=
  sup_le_sup_left h _

theorem le_rayJoin (p : V) (S : PointedCone ℝ V) : S ≤ rayJoin p S := le_sup_right

theorem point_mem_rayJoin (p : V) (S : PointedCone ℝ V) : p ∈ rayJoin p S :=
  Submodule.mem_sup_left (PointedCone.subset_hull (Set.mem_singleton p))

theorem rayJoin_le (hp : p ∈ C) (hS : S ≤ C) : rayJoin p S ≤ C := by
  exact sup_le (Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hp)) hS

/-- A point of the ambient cone that lies in the span of a face lies in
that face. This gives the linear independence needed when coning. -/
theorem face_mem_of_mem_span (hF : F.IsFaceOf C) (hp : p ∈ C)
    (hspan : p ∈ Submodule.span ℝ (F : Set V)) : p ∈ F := by
  obtain ⟨u, hu, v, hv, h⟩ := PointedCone.mem_span.mp hspan
  apply hF.mem_of_add_mem_left hp (hF.le hv)
  rw [h, sub_add_cancel]
  exact hu

theorem point_not_mem_span_face (hF : F.IsFaceOf C) (hp : p ∈ C) (hne : p ∉ F) :
    p ∉ Submodule.span ℝ (F : Set V) := fun h => hne (face_mem_of_mem_span hF hp h)

/-- Radial expressions with residual points on the boundary have the same
radial coefficient. No affine independence assumption is needed. -/
theorem boundary_radial_unique (hp : p ∈ C)
    (hF : F.IsFaceOf C) (hG : G.IsFaceOf C) (hpF : p ∉ F) (hpG : p ∉ G)
    (hx : x ∈ F) (hy : y ∈ G) (h : a • p + x = b • p + y) :
    a = b ∧ x = y := by
  have not_lt (hba : a < b) : False := by
    apply hpF
    apply hF.mem_of_smul_add_mem hp (hG.le hy) (sub_pos.mpr hba)
    have heq : (b - a) • p + y = x := by
      calc
        (b - a) • p + y = (b • p + y) - a • p := by rw [sub_smul]; abel
        _ = (a • p + x) - a • p := by rw [← h]
        _ = x := by abel
    rwa [heq]
  have not_gt (hab : b < a) : False := by
    apply hpG
    apply hG.mem_of_smul_add_mem hp (hF.le hx) (sub_pos.mpr hab)
    have heq : (a - b) • p + x = y := by
      calc
        (a - b) • p + x = (a • p + x) - b • p := by rw [sub_smul]; abel
        _ = (b • p + y) - b • p := by rw [h]
        _ = y := by abel
    rwa [heq]
  have hab : a = b := le_antisymm (le_of_not_gt not_gt) (le_of_not_gt not_lt)
  refine ⟨hab, ?_⟩
  rw [hab] at h
  exact add_left_cancel h

/-- Intersecting a coned boundary cell with an old face removes the new
ray whenever the new point does not lie in that face. -/
theorem rayJoin_inf_face (hp : p ∈ C) (hS : S ≤ C)
    (hF : F.IsFaceOf C) (hpF : p ∉ F) :
    rayJoin p S ⊓ F = S ⊓ F := by
  apply le_antisymm
  · intro x hx
    obtain ⟨a, ha, y, hy, rfl⟩ := mem_rayJoin.mp hx.1
    have azero : a = 0 := by
      by_contra hne
      exact hpF (hF.mem_of_smul_add_mem hp (hS hy) (lt_of_le_of_ne ha (Ne.symm hne)) hx.2)
    change a • p + y ∈ S ∧ a • p + y ∈ F
    rw [azero, zero_smul, zero_add] at hx ⊢
    exact ⟨hy, hx.2⟩
  · exact inf_le_inf (le_rayJoin p S) le_rfl

/-- If an old face contains the radial point, the new cone restricts to
the cone on the restricted boundary cell. -/
theorem rayJoin_inf_face_of_mem (hS : S ≤ C) (hF : F.IsFaceOf C) (hpF : p ∈ F) :
    rayJoin p S ⊓ F = rayJoin p (S ⊓ F) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨a, ha, y, hy, rfl⟩ := mem_rayJoin.mp hx.1
    have yFace := hF.mem_of_add_mem_right
      (C.smul_mem ha (hF.le hpF)) (hS hy) hx.2
    exact mem_rayJoin.mpr ⟨a, ha, y, ⟨hy, yFace⟩, rfl⟩
  · exact le_inf (rayJoin_mono p inf_le_left) (rayJoin_le hpF inf_le_right)

theorem base_isFaceOf_rayJoin (hp : p ∈ C) (hS : S.IsFaceOf C) :
    S.IsFaceOf (rayJoin p S) := by
  refine ⟨le_rayJoin p S, ?_⟩
  intro x y a hx hy ha hxy
  exact hS.mem_of_smul_add_mem (rayJoin_le hp hS.le hx)
    (rayJoin_le hp hS.le hy) ha hxy

/-- Every face of a coned cell is either an old boundary face or the cone
on an old boundary face. This is also valid without simpliciality. -/
theorem rayJoin_face_classification (face : F.IsFaceOf (rayJoin p S)) :
    (F ⊓ S).IsFaceOf S ∧
      (F = F ⊓ S ∨ F = rayJoin p (F ⊓ S)) := by
  have infFace : (F ⊓ S).IsFaceOf S := by
    have h := face.inf (PointedCone.IsFaceOf.refl S)
    rwa [inf_eq_right.mpr (le_rayJoin p S)] at h
  refine ⟨infFace, ?_⟩
  by_cases hpF : p ∈ F
  · right
    apply le_antisymm
    · intro x hx
      obtain ⟨a, ha, y, hy, rfl⟩ := mem_rayJoin.mp (face.le hx)
      have yFace := face.mem_of_add_mem_right
        ((rayJoin p S).smul_mem ha (point_mem_rayJoin p S)) (le_rayJoin p S hy) hx
      exact mem_rayJoin.mpr ⟨a, ha, y, ⟨yFace, hy⟩, rfl⟩
    · exact rayJoin_le hpF inf_le_left
  · left
    apply le_antisymm _ inf_le_left
    intro x hx
    refine ⟨hx, ?_⟩
    obtain ⟨a, ha, y, hy, h⟩ := mem_rayJoin.mp (face.le hx)
    have azero : a = 0 := by
      by_contra hne
      exact hpF (face.mem_of_smul_add_mem (point_mem_rayJoin p S)
        (le_rayJoin p S hy) (lt_of_le_of_ne ha (Ne.symm hne)) (h ▸ hx))
    rw [azero, zero_smul, zero_add] at h
    rw [← h]
    exact hy

/-- Intersections of coned boundary cells are coned intersections. -/
theorem rayJoin_inf (hp : p ∈ C)
    (hF : F.IsFaceOf C) (hG : G.IsFaceOf C) (hpF : p ∉ F) (hpG : p ∉ G)
    (hS : S ≤ F) (hT : T ≤ G) :
    rayJoin p S ⊓ rayJoin p T = rayJoin p (S ⊓ T) := by
  apply le_antisymm
  · intro z hz
    obtain ⟨a, ha, x, hx, hax⟩ := mem_rayJoin.mp hz.1
    obtain ⟨b, hb, y, hy, hby⟩ := mem_rayJoin.mp hz.2
    obtain ⟨hab, hxy⟩ := boundary_radial_unique hp hF hG hpF hpG (hS hx) (hT hy)
      (hax.trans hby.symm)
    exact mem_rayJoin.mpr ⟨a, ha, x, ⟨hx, hxy ▸ hy⟩, hax⟩
  · exact le_inf (rayJoin_mono p inf_le_left) (rayJoin_mono p inf_le_right)

/-- Coning preserves a face of a boundary cell. -/
theorem rayJoin_isFaceOf (hp : p ∈ C) (hF : F.IsFaceOf C) (hpF : p ∉ F)
    (hT : T ≤ F) (hST : S.IsFaceOf T) :
    (rayJoin p S).IsFaceOf (rayJoin p T) := by
  refine ⟨rayJoin_mono p hST.le, ?_⟩
  intro x y c hx hy hc hxy
  obtain ⟨a, ha, u, hu, rfl⟩ := mem_rayJoin.mp hx
  obtain ⟨b, hb, v, hv, rfl⟩ := mem_rayJoin.mp hy
  obtain ⟨d, hd, w, hw, heq⟩ := mem_rayJoin.mp hxy
  have hrepr : (c * a + b) • p + (c • u + v) = d • p + w := by
    rw [heq]
    simp only [add_smul, mul_smul, smul_add]
    abel
  have hres := (boundary_radial_unique hp hF hF hpF hpF
    (hT (T.add_mem (T.smul_mem hc.le hu) hv)) (hT (hST.le hw)) hrepr).2
  exact mem_rayJoin.mpr ⟨a, ha, u, hST.mem_of_smul_add_mem hu hv hc (hres ▸ hw), rfl⟩

/-- A simplicial boundary cell stays simplicial on adjoining an interior
ray. The independence proof is over the actual ambient real vector space. -/
theorem rayJoin_isSimplicial (hp : p ∈ C) (hF : F.IsFaceOf C) (hpF : p ∉ F)
    (hS : S ≤ F) (simplicial : S.IsSimplicial) : (rayJoin p S).IsSimplicial := by
  obtain ⟨s, finite, independent, hs⟩ := simplicial
  have generators : s ⊆ (F : Set V) := by
    intro x hx
    apply hS
    rw [← hs]
    exact PointedCone.subset_hull hx
  have notSpan : p ∉ Submodule.span ℝ s := fun h =>
    point_not_mem_span_face hF hp hpF (Submodule.span_mono generators h)
  refine ⟨insert p s, finite.insert p, independent.id_insert notSpan, ?_⟩
  rw [show insert p s = ({p} : Set V) ∪ s by ext; simp]
  change Submodule.span {r : ℝ // 0 ≤ r} ({p} ∪ s) = _
  rw [Submodule.span_union]
  change PointedCone.hull ℝ {p} ⊔ PointedCone.hull ℝ s = _
  rw [hs]
  rfl

theorem simplicial_of_face (simplicial : C.IsSimplicial) (face : F.IsFaceOf C) :
    F.IsSimplicial := by
  obtain ⟨s, finite, independent, spans⟩ := simplicial
  refine ⟨s ∩ (F : Set V), finite.inter_of_left _, independent.mono Set.inter_subset_left, ?_⟩
  exact (PointedCone.Face.eq_hull_inter_of_eq_hull ⟨F, face⟩ s spans.symm).symm

theorem span_base_lt_rayJoin (hp : p ∈ C) (hF : F.IsFaceOf C) (hpF : p ∉ F)
    (hS : S ≤ F) :
    Submodule.span ℝ (S : Set V) < Submodule.span ℝ (rayJoin p S : Set V) := by
  refine lt_of_le_of_ne (Submodule.span_mono (le_rayJoin p S)) ?_
  intro equality
  apply point_not_mem_span_face hF hp hpF
  apply Submodule.span_mono hS
  rw [equality]
  exact Submodule.subset_span (point_mem_rayJoin p S)

variable {N : Type*} [AddCommGroup N] {i : N →+ V}

theorem rayJoin_isToricCone (hC : IsToricCone i C) (q : N) (hq : i q ∈ C)
    (hS : IsToricCone i S) (hSC : S ≤ C) : IsToricCone i (rayJoin (i q) S) := by
  refine ⟨(isToricCone_hull_singleton i q).rational.sup hS.rational, ?_⟩
  intro x hx hne hneg
  exact hC.salient x (rayJoin_le hq hSC hx) hne (rayJoin_le hq hSC hneg)

end ToricPower.FanSubdivision
end
