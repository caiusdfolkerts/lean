module

public import ToricPower.IntegralHalfspaceCones
public import ToricPower.IntegralDualLattice
public import TauCeti.Geometry.Convex.Cone.Alternative
public import Mathlib.Geometry.Convex.Cone.Dual
public import Mathlib.Tactic.Linarith

/-!
# Finite integral inequalities for rational cones

Tucker's theorem gives an algebraic separation theorem for a finitely
generated cone. Applying the finite-generation theorem for integral
halfspaces to the actual character lattice then gives the converse
description by finitely many integral inequalities. No smoothness or
simpliciality is used.
-/

@[expose] public noncomputable section
open TauCeti.Toric
open scoped BigOperators

namespace ToricPower.FanSubdivision

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- Algebraic bipolarity, proved from Tucker's theorem rather than an
unproved closedness assertion about finitely generated cones. -/
theorem finiteCone_mem_iff_nonneg (C : PointedCone ℝ V) (finite : C.FG) (x : V) :
    x ∈ C ↔ ∀ φ : Module.Dual ℝ V, (∀ y ∈ C, 0 ≤ φ y) → 0 ≤ φ x := by
  classical
  refine ⟨fun hx φ nonnegative => nonnegative x hx, ?_⟩
  intro tests
  obtain ⟨s, spans⟩ := finite
  let family : Option s → V := fun j => j.elim (-x) Subtype.val
  obtain ⟨c, φ, cNonnegative, relation, φNonnegative, positive⟩ :=
    TauCeti.exists_nonneg_sum_smul_eq_zero_and_coeff_add_dual_pos_at
      (K := ℝ) family none
  have generatorsNonnegative (y : V) (hy : y ∈ s) : 0 ≤ φ y :=
    φNonnegative (some ⟨y, hy⟩)
  have φCone : ∀ y ∈ C, 0 ≤ φ y := by
    rw [← spans]
    intro y hy
    induction hy using Submodule.span_induction with
    | mem z hz => exact generatorsNonnegative z hz
    | zero => simp
    | add y z _ _ hy hz => simpa only [map_add] using add_nonneg hy hz
    | smul r z _ hz =>
      change 0 ≤ φ ((r : ℝ) • z)
      rw [map_smul, smul_eq_mul]
      exact mul_nonneg r.property hz
  have φx : φ x = 0 := by
    have hminus : 0 ≤ -φ x := by simpa only [family, Option.elim_none, map_neg] using φNonnegative none
    exact le_antisymm (neg_nonneg.mp hminus) (tests φ φCone)
  have cPositive : 0 < c none := by
    simpa only [family, Option.elim_none, map_neg, φx, neg_zero, add_zero] using positive
  have sumEq : ∑ y : s, c (some y) • (y : V) = c none • x := by
    have h := relation
    simp only [Fintype.sum_option, family, Option.elim_none, Option.elim_some, smul_neg] at h
    exact eq_of_sub_eq_zero (by simpa only [sub_eq_add_neg, add_comm] using h)
  have sumMember : ∑ y : s, c (some y) • (y : V) ∈ C := by
    apply C.sum_mem
    intro y _
    apply C.smul_mem (cNonnegative (some y))
    rw [← spans]
    exact Submodule.subset_span y.property
  have scaled := C.smul_mem (inv_nonneg.mpr cPositive.le) sumMember
  rw [sumEq, smul_smul, inv_mul_cancel₀ cPositive.ne', one_smul] at scaled
  exact scaled

variable {N : Type*} [AddCommGroup N] {i : N →+ V}

/-- Evaluation at an integral vector, as a character of the character
lattice. -/
def integralEvaluation (n : N) : (N →+ ℤ) →+ ℤ where
  toFun m := m n
  map_zero' := rfl
  map_add' _ _ := rfl

theorem dualLattice_realEvaluation (lattice : IsIntegralLattice i) (n : N) :
    (integralLattice_realCharacter lattice).realCharacter (integralEvaluation n) =
      Module.Dual.eval ℝ V (i n) := by
  apply Eq.symm
  apply (integralLattice_realCharacter lattice).eq_realCharacter
  intro m
  exact lattice.realCharacter_apply m n

/-- The real dual cone is generated by actual integral characters. -/
theorem rationalCone_dual_isLatticeRational (lattice : IsIntegralLattice i)
    (C : PointedCone ℝ V) (rational : IsLatticeRational i C) :
    IsLatticeRational lattice.realCharacter
      (PointedCone.dual (Module.Dual.eval ℝ V) (C : Set V)) := by
  classical
  obtain ⟨s, hC⟩ := isLatticeRational_iff.mp rational
  let forms : s → (N →+ ℤ) →+ ℤ := fun n => -integralEvaluation n.val
  apply integral_inequalityCone_isLatticeRational
    (integralLattice_realCharacter lattice) _ forms
  intro φ
  rw [hC, PointedCone.dual_hull]
  change (∀ ⦃v⦄, v ∈ i '' (s : Set N) → 0 ≤ φ v) ↔ _
  have formValue (n : s) :
      (integralLattice_realCharacter lattice).realCharacter (forms n) φ = -φ (i n.val) := by
    simp only [forms, map_neg, LinearMap.neg_apply, dualLattice_realEvaluation,
      Module.Dual.eval_apply]
  simp only [formValue, neg_nonpos]
  constructor
  · intro h n
    exact h (Set.mem_image_of_mem i n.property)
  · intro h v hv
    obtain ⟨n, hn, rfl⟩ := hv
    exact h ⟨n, hn⟩

/-- A rational cone has a finite integral halfspace description. The
inequalities use the original lattice, including in lower dimension. -/
theorem rationalCone_exists_integral_inequalities (lattice : IsIntegralLattice i)
    (C : PointedCone ℝ V) (rational : IsLatticeRational i C) :
    ∃ s : Finset (N →+ ℤ), ∀ x : V,
      x ∈ C ↔ ∀ m ∈ s, 0 ≤ lattice.realCharacter m x := by
  classical
  obtain ⟨s, dualSpans⟩ := isLatticeRational_iff.mp
    (rationalCone_dual_isLatticeRational lattice C rational)
  refine ⟨s, fun x => ?_⟩
  rw [finiteCone_mem_iff_nonneg C rational.fg x]
  constructor
  · intro h m hm
    apply h
    have member : lattice.realCharacter m ∈
        PointedCone.dual (Module.Dual.eval ℝ V) (C : Set V) := by
      rw [dualSpans]
      exact PointedCone.subset_hull (Set.mem_image_of_mem _ hm)
    exact fun y hy => member hy
  · intro h φ nonnegative
    have member : φ ∈ PointedCone.hull ℝ (lattice.realCharacter '' (s : Set (N →+ ℤ))) := by
      rw [← dualSpans]
      exact nonnegative
    clear nonnegative
    induction member using Submodule.span_induction with
    | mem ψ hψ =>
      obtain ⟨m, hm, rfl⟩ := hψ
      exact h m hm
    | zero => simp
    | add ψ χ _ _ hψ hχ => exact add_nonneg hψ hχ
    | smul r ψ _ hψ =>
      exact mul_nonneg r.property hψ

end ToricPower.FanSubdivision
end
