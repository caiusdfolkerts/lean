module

public import ToricPower.LinearTestFiniteness
public import ToricPower.FanRayIndex
public import TauCeti.Geometry.Toric.Algebraic.Ray.Generation

/-!
# The finite ray-span reduction in Section 5

For an arbitrary linear test subspace `W`, the rays of the fan contained
in `W` span a rational linear test subspace `U ≤ W`. Exactly the same
cones of the original fan are contained in `U` and in `W`. The family of
all such ray spans is finite, with no completeness assumption.

This is the combinatorial part of the reduction. Identifying the two
associated toric schemes up to a split torus factor, and transporting
cohomological nonvanishing, are separate geometric dependencies. They
are not asserted by the cone statements below.

Development source awaiting compilation.
-/

@[expose] public noncomputable section

open Set TauCeti.Toric
open scoped Classical

namespace ToricPower

variable {N V : Type*} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V}

/-- The real span of the selected actual one-dimensional fan cones. -/
def fanRaySpan (fan : Fan i) (S : Set fan.Ray) : Submodule ℝ V :=
  ⨆ ρ : fan.Ray, ⨆ (_ : ρ ∈ S), Submodule.span ℝ (ρ.toCone.val : Set V)

/-- All ray-generated subspaces form an actually finite family. -/
theorem fanRaySpan_range_finite (fan : Fan i) :
    (Set.range (fanRaySpan fan)).Finite := by
  classical
  letI : Fintype fan.Ray := Fintype.ofFinite _
  exact Set.finite_range _

theorem fanRaySpan_ray_le (fan : Fan i) (S : Set fan.Ray)
    (ρ : fan.Ray) (hρ : ρ ∈ S) :
    ρ.toCone.val ≤ (fanRaySpan fan S : PointedCone ℝ V) := by
  intro x hx
  have hle : Submodule.span ℝ (ρ.toCone.val : Set V) ≤ fanRaySpan fan S :=
    le_iSup_of_le ρ (le_iSup_of_le hρ le_rfl)
  exact hle (Submodule.subset_span hx)

theorem fanRaySpan_le_iff (fan : Fan i) (S : Set fan.Ray) (W : Submodule ℝ V) :
    fanRaySpan fan S ≤ W ↔
      ∀ ρ ∈ S, ρ.toCone.val ≤ (W : PointedCone ℝ V) := by
  constructor
  · intro h ρ hρ
    exact (fanRaySpan_ray_le fan S ρ hρ).trans h
  · intro h
    exact iSup_le fun ρ => iSup_le fun hρ => Submodule.span_le.mpr (h ρ hρ)

/-- The rays retained by a subspace, taken in the original fan. -/
def fanRaysIn (fan : Fan i) (W : Submodule ℝ V) : Set fan.Ray :=
  {ρ | ρ.toCone.val ≤ (W : PointedCone ℝ V)}

def linearRayCore (fan : Fan i) (W : Submodule ℝ V) : Submodule ℝ V :=
  fanRaySpan fan (fanRaysIn fan W)

theorem linearRayCore_le (fan : Fan i) (W : Submodule ℝ V) :
    linearRayCore fan W ≤ W :=
  (fanRaySpan_le_iff fan (fanRaysIn fan W) W).mpr (fun _ h => h)

/-- A toric cone is the join of its genuine rays, so every cone
contained in `W` is already contained in the retained ray span. -/
theorem cone_le_linearRayCore (fan : Fan i) (W : Submodule ℝ V)
    {σ : PointedCone ℝ V} (hσ : σ ∈ fan.cones)
    (hσW : σ ≤ (W : PointedCone ℝ V)) :
    σ ≤ (linearRayCore fan W : PointedCone ℝ V) := by
  rw [← ToricRay.iSup_toPointedCone (fan.isToricCone hσ).fg
    (fan.isToricCone hσ).salient]
  apply iSup_le
  intro ρ
  exact fanRaySpan_ray_le fan (fanRaysIn fan W)
    (Fan.Ray.ofToricRay fan ⟨σ, hσ⟩ ρ)
    (ρ.val.isFaceOf.le.trans hσW)

/-- The two subspaces retain exactly the same cones of the fan. -/
theorem cone_le_linearRayCore_iff (fan : Fan i) (W : Submodule ℝ V)
    {σ : PointedCone ℝ V} (hσ : σ ∈ fan.cones) :
    σ ≤ (linearRayCore fan W : PointedCone ℝ V) ↔ σ ≤ (W : PointedCone ℝ V) :=
  ⟨fun h => h.trans (linearRayCore_le fan W), cone_le_linearRayCore fan W hσ⟩

/-- Linearity is inherited because the actual intersection with every
fan cone is unchanged. -/
theorem linearRayCore_intersection (fan : Fan i) (W : Submodule ℝ V)
    (hW : IsLinearSubspace fan W) {σ : PointedCone ℝ V} (hσ : σ ∈ fan.cones) :
    σ ⊓ (linearRayCore fan W : PointedCone ℝ V) = σ ⊓ (W : PointedCone ℝ V) := by
  apply le_antisymm
  · exact inf_le_inf_left σ (linearRayCore_le fan W)
  · exact le_inf inf_le_left
      (cone_le_linearRayCore fan W (hW σ hσ) inf_le_right)

theorem linearRayCore_linear (fan : Fan i) (W : Submodule ℝ V)
    (hW : IsLinearSubspace fan W) : IsLinearSubspace fan (linearRayCore fan W) := by
  intro σ hσ
  rw [linearRayCore_intersection fan W hW hσ]
  exact hW σ hσ

/-- Every selected ray is generated by actual lattice points, so the
retained ray span is rational even if no rationality of `W` is assumed. -/
theorem fanRaySpan_rational (fan : Fan i) (S : Set fan.Ray) :
    IsRationalSubspace i (fanRaySpan fan S) := by
  let U := fanRaySpan fan S
  let K := Submodule.span ℝ (Set.range (fun n : latticeTrace i U => i n))
  change K = U
  apply le_antisymm
  · exact Submodule.span_le.mpr (by rintro _ ⟨n, rfl⟩; exact n.property)
  · apply iSup_le
    intro ρ
    apply iSup_le
    intro hρ
    obtain ⟨t, ht⟩ := (isLatticeRational_iff).mp
      (fan.isToricCone ρ.toCone.property).rational
    have hspan : Submodule.span ℝ (ρ.toCone.val : Set V) =
        Submodule.span ℝ (i '' (t : Set N)) := by
      rw [ht]
      apply le_antisymm
      · exact Submodule.span_le.mpr (PointedCone.hull_le_span ℝ _)
      · exact Submodule.span_mono PointedCone.subset_hull
    rw [hspan]
    apply Submodule.span_le.mpr
    rintro x ⟨n, hn, rfl⟩
    have hnρ : i n ∈ ρ.toCone.val := by
      rw [ht]
      exact PointedCone.subset_hull ⟨n, hn, rfl⟩
    have hnU : i n ∈ U := fanRaySpan_ray_le fan S ρ hρ hnρ
    exact Submodule.subset_span ⟨⟨n, hnU⟩, rfl⟩

/-- The ray reduction is an actual rational linear test in the same
ambient fan, with its saturated integral trace. -/
def rayReducedLinearTest (fan : Fan i) (W : LinearSubspace fan) : LinearSubspace fan where
  space := linearRayCore fan W.space
  rational := fanRaySpan_rational fan (fanRaysIn fan W.space)
  linear := linearRayCore_linear fan W.space W.linear

/-- The range of the reduction on the full family of linear tests is
finite.  This does not assert the missing torus-factor cohomology comparison. -/
theorem rayReducedLinearTest_range_finite (fan : Fan i) :
    (Set.range (rayReducedLinearTest fan)).Finite := by
  have himage : (LinearSubspace.space '' Set.range (rayReducedLinearTest fan)).Finite := by
    apply (fanRaySpan_range_finite fan).subset
    rintro U ⟨L, ⟨W, rfl⟩, rfl⟩
    exact ⟨fanRaysIn fan W.space, rfl⟩
  exact himage.of_finite_image (LinearSubspace.space_injective fan).injOn

end ToricPower
