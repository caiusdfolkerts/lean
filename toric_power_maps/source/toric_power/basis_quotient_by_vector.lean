module

public import Mathlib.LinearAlgebra.Basis.Basic
public import Mathlib.LinearAlgebra.LinearIndependent.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# An integral quotient basis after deleting one basis vector

A surjective linear map whose kernel is generated by a single basis
vector sends the remaining vectors to a basis of the actual target.
This works over a ring, so it supplies the integral and real bases of
the quotient lattice used in a toric ray star.
-/

@[expose] public noncomputable section

namespace ToricPower.FanSubdivision

variable {R ι M P : Type*} [Ring R]
  [AddCommGroup M] [Module R M] [AddCommGroup P] [Module R P]
  (basis : Module.Basis ι R M) (pivot : ι) (projection : M →ₗ[R] P)
  (kernel : LinearMap.ker projection = Submodule.span R {basis pivot})

include kernel in
theorem projected_basis_pivot_eq_zero : projection (basis pivot) = 0 := by
  apply LinearMap.mem_ker.mp
  rw [kernel]
  exact Submodule.mem_span_singleton_self _

include kernel in
theorem projected_basis_linearIndependent :
    LinearIndependent R (fun j : {j : ι // j ≠ pivot} => projection (basis j.val)) := by
  have independent := basis.linearIndependent.comp
    (fun j : {j : ι // j ≠ pivot} => j.val) Subtype.val_injective
  apply independent.map
  rw [kernel]
  have rangeEq :
      Set.range (fun j : {j : ι // j ≠ pivot} => basis j.val) =
        basis '' {j | j ≠ pivot} := by
    ext x
    exact ⟨fun ⟨j,hj⟩ => ⟨j.val,j.property,hj⟩,
      fun ⟨j,hj,eq⟩ => ⟨⟨j,hj⟩,eq⟩⟩
  change Disjoint (Submodule.span R
    (Set.range (fun j : {j : ι // j ≠ pivot} => basis j.val)))
    (Submodule.span R {basis pivot})
  rw [rangeEq]
  have disjoint : Disjoint {j : ι | j ≠ pivot} {pivot} := by
    exact Set.disjoint_left.mpr (fun j different same => different same)
  simpa only [Set.image_singleton] using basis.linearIndependent.disjoint_span_image disjoint

include kernel in
theorem projected_basis_span_eq_top (surjective : Function.Surjective projection) :
    Submodule.span R
      (Set.range (fun j : {j : ι // j ≠ pivot} => projection (basis j.val))) = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨y,rfl⟩ := surjective x
  have member : y ∈ Submodule.span R (Set.range basis) := by rw [basis.span_eq]; trivial
  refine Submodule.span_induction
    (p := fun y _ => projection y ∈ Submodule.span R
      (Set.range (fun j : {j : ι // j ≠ pivot} => projection (basis j.val))))
    ?_ ?_ ?_ ?_ member
  · rintro y ⟨j,rfl⟩
    by_cases same : j = pivot
    · subst j
      rw [projected_basis_pivot_eq_zero basis pivot projection kernel]
      exact Submodule.zero_mem _
    · exact Submodule.subset_span ⟨⟨j,same⟩,rfl⟩
  · rw [map_zero]
    exact Submodule.zero_mem _
  · intro x y hx hy px py
    rw [map_add]
    exact Submodule.add_mem _ px py
  · intro r x hx px
    rw [map_smul]
    exact Submodule.smul_mem _ r px

/-- The basis is made from the actual images, with no arbitrary
isomorphism or additional freeness assumption on the target. -/
def projectedBasis (surjective : Function.Surjective projection) :
    Module.Basis {j : ι // j ≠ pivot} R P :=
  Module.Basis.mk (projected_basis_linearIndependent basis pivot projection kernel)
    (ge_of_eq (projected_basis_span_eq_top basis pivot projection kernel surjective))

@[simp]
theorem projectedBasis_apply (surjective : Function.Surjective projection)
    (j : {j : ι // j ≠ pivot}) :
    projectedBasis basis pivot projection kernel surjective j = projection (basis j.val) :=
  Module.Basis.mk_apply _ _ _

end ToricPower.FanSubdivision
end
