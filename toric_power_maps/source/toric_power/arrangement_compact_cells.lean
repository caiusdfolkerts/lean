module

public import ToricPower.ArrangementLocalSupport
public import Mathlib.Topology.Compactness.LocallyFinite

/-!
# Finite closed face carriers in the universal arrangement

Local finiteness is used on the genuine periodic arrangement, with all
lattice translates present. The cells contained in a compact carrier
form a finite downward-closed subposet. In particular a finite union
of closed cells gives exactly the kind of support on which extension
by zero permits a derived local Hom computation.
-/

@[expose] public noncomputable section

open CategoryTheory Set

namespace ToricPower.IntegralArrangement

variable {n s : ℕ} (A : Fin s → Fin n → ℤ)

local notation "U" => UniversalIncidenceObject A
local notation "E" => Fin n → ℝ

/-- Local finiteness for the actual cell indexing, in all dimensions. -/
theorem universalClosedCells_locallyFinite :
    LocallyFinite (universalIncidenceClosedCell A) :=
  (closedCells_locallyFinite (augmentedForms A)
    (fun i => (augmentedForms A i).continuous_of_finiteDimensional)).comp_injective
      (universalIncidenceLabels_injective A)

/-- Every genuine cell has a point in its genuine closed carrier. -/
theorem universalClosedCell_nonempty (c : U) :
    (universalIncidenceClosedCell A c).Nonempty :=
  ⟨cellCenter (augmentedForms A) c.2,
    cell_subset_closedCell _ _ _ (cellCenter_mem _ c.2)⟩

/-- Cells wholly contained in the prescribed geometric carrier. -/
def cellsCarriedBy (K : Set E) (c : U) : Prop :=
  universalIncidenceClosedCell A c ⊆ K

theorem cellsCarriedBy_downward (K : Set E) : Antitone (cellsCarriedBy A K) := by
  intro c d h hd
  exact Set.Subset.trans h hd

/-- Compactness supplies finiteness; no lattice cutoff is introduced. -/
theorem cellsCarriedBy_finite (K : Set E) (compact : IsCompact K) :
    {c : U | cellsCarriedBy A K c}.Finite := by
  apply ((universalClosedCells_locallyFinite A).finite_nonempty_inter_compact compact).subset
  intro c hc
  obtain ⟨x,hx⟩ := universalClosedCell_nonempty A c
  exact ⟨x,hx,hc hx⟩

/-- The closed geometric carrier generated by a set of actual cells. -/
def closedCellCarrier (S : Set U) : Set E :=
  ⋃ c ∈ S, universalIncidenceClosedCell A c

theorem closedCell_subset_carrier {S : Set U} {c : U} (hc : c ∈ S) :
    universalIncidenceClosedCell A c ⊆ closedCellCarrier A S := by
  intro x hx
  exact mem_iUnion.mpr ⟨c,mem_iUnion.mpr ⟨hc,hx⟩⟩

theorem closedCellCarrier_isCompact (S : Set U) (finite : S.Finite) :
    IsCompact (closedCellCarrier A S) :=
  finite.isCompact_biUnion (fun c _ => closedCell_isCompact A _ _)

/-- Taking every face in a finite closed carrier remains a finite
construction and includes the original support cells. -/
theorem closedCellCarrier_cells_finite (S : Set U) (finite : S.Finite) :
    {c : U | cellsCarriedBy A (closedCellCarrier A S) c}.Finite :=
  cellsCarriedBy_finite A _ (closedCellCarrier_isCompact A S finite)

end ToricPower.IntegralArrangement

end
