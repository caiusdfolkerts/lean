module

public import ToricPower.ArrangementNormalizedLift
public import ToricPower.ArrangementUniversalCover
public import ToricPower.ArrangementCompactCells
public import ToricPower.CellularClosedSupportRestriction
public import Mathlib.Algebra.Homology.Embedding.ExtendHomology

/-!
# A literal closed-support model for the normalized character lift

The complete lift is transported to the genuine universal cells.
Its finite cohomological support generates a compact closed carrier.
The original restriction/extension unit then replaces the lift by a
complex whose terms vanish outside that carrier. All comparisons are
quasi-isomorphisms of full diagrams, including their incidence maps.
-/

@[expose] public noncomputable section

set_option backward.defeqAttrib.useBackward true
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TauCeti.Toric Set
open ToricPower.IntegralArrangement

namespace ToricPower

variable {N : Type} {V : Type*} [AddCommGroup N] [AddCommGroup V]
  [Module ℝ V] {i : N →+ V} (fan : Fan i)
  [nonempty : Nonempty fan.cones] (regular : fan.IsRegular)
  {n s : ℕ} (basis : Module.Basis (Fin n) ℤ (N →+ ℤ)) (rays : Fin s ≃ fan.Ray)

local notation "A" => fanArrangementMatrix fan basis rays
local notation "U" => UniversalIncidenceObject A
local notation "charts" => toricMeetChartEquiv fan
local notation "W" => WeightedIncidenceObject A

local instance compactLift_chartIndexFintype : Fintype (ToricMeetChartIndex fan) := Fintype.ofFinite _

/-- Every genuine universal cell carries its original complete Čech complex. -/
def normalizedUniversalLift (b : fan.Ray → ℤ) : U ⥤ CochainComplex (ModuleCat ℂ) ℕ :=
  cellsToWeighted A ⋙ arrangementLiftedCech fan basis rays charts (b - (fun _ => 1))

def normalizedUniversalLiftSupport (b : fan.Ray → ℤ) : Set U :=
  (weightedIncidenceCellEquiv A) ''
    arrangementLiftedCechSupport fan basis rays charts (b - (fun _ => 1))

include regular in
theorem normalizedUniversalLiftSupport_finite
    (complete : fan.IsComplete) (b : fan.Ray → ℤ) :
    (normalizedUniversalLiftSupport fan basis rays b).Finite :=
  (arrangementNormalizedLiftedSupport_finite fan regular basis rays complete b).image _

/-- The geometric closed carrier is generated by the proved finite support. -/
def normalizedUniversalLiftCarrier (b : fan.Ray → ℤ) : Set (Fin n → ℝ) :=
  closedCellCarrier A (normalizedUniversalLiftSupport fan basis rays b)

include regular in
theorem normalizedUniversalLiftCarrier_isCompact
    (complete : fan.IsComplete) (b : fan.Ray → ℤ) :
    IsCompact (normalizedUniversalLiftCarrier fan basis rays b) :=
  closedCellCarrier_isCompact A _
    (normalizedUniversalLiftSupport_finite fan regular basis rays complete b)

/-- Every face contained in that carrier is retained. -/
def normalizedUniversalLiftClosedSupport (b : fan.Ray → ℤ) : U → Prop :=
  cellsCarriedBy A (normalizedUniversalLiftCarrier fan basis rays b)

theorem normalizedUniversalLiftClosedSupport_downward (b : fan.Ray → ℤ) :
    Antitone (normalizedUniversalLiftClosedSupport fan basis rays b) :=
  cellsCarriedBy_downward A _

include regular in
theorem normalizedUniversalLiftClosedSupport_finite
    (complete : fan.IsComplete) (b : fan.Ray → ℤ) :
    {c | normalizedUniversalLiftClosedSupport fan basis rays b c}.Finite :=
  cellsCarriedBy_finite A _
    (normalizedUniversalLiftCarrier_isCompact fan regular basis rays complete b)

/-- Outside the closed carrier the original full complex is acyclic. -/
theorem normalizedUniversalLift_acyclic_outside (b : fan.Ray → ℤ) (c : U)
    (outside : ¬ normalizedUniversalLiftClosedSupport fan basis rays b c) :
    ((normalizedUniversalLift fan basis rays b).obj c).Acyclic := by
  intro q
  rw [HomologicalComplex.exactAt_iff_isZero_homology,ModuleCat.isZero_iff_subsingleton]
  apply not_nontrivial_iff_subsingleton.mp
  intro nonzero
  apply outside
  apply closedCell_subset_carrier A
  refine ⟨(cellsToWeighted A).obj c, ?_, ?_⟩
  · exact ⟨q,nonzero⟩
  · exact (weightedIncidenceCellEquiv A).apply_symm_apply c

/-- The actual unbounded-category representative, extended by zero in
negative degrees; the prescribed normalization shift is applied later. -/
def normalizedUniversalLiftComplex (b : fan.Ray → ℤ) :
    CochainComplex (U ⥤ ModuleCat.{0} ℂ) ℤ :=
  complexDiagramTranspose (normalizedUniversalLift fan basis rays b ⋙
    ComplexShape.embeddingUpNat.extendFunctor (ModuleCat ℂ))

theorem normalizedUniversalLiftComplex_acyclic_outside
    (b : fan.Ray → ℤ) (c : U)
    (outside : ¬ normalizedUniversalLiftClosedSupport fan basis rays b c) :
    ((((evaluation U (ModuleCat.{0} ℂ)).obj c).mapHomologicalComplex (.up ℤ)).obj
      (normalizedUniversalLiftComplex fan basis rays b)).Acyclic := by
  intro q
  let K := (normalizedUniversalLift fan basis rays b).obj c
  change (K.extend ComplexShape.embeddingUpNat).ExactAt q
  by_cases hq : ∃ p : ℕ, (p : ℤ) = q
  · obtain ⟨p,hp⟩ := hq
    exact (K.extend_exactAt_iff ComplexShape.embeddingUpNat hp).mpr
      (normalizedUniversalLift_acyclic_outside fan basis rays b c outside p)
  · exact K.extend_exactAt ComplexShape.embeddingUpNat q (by
      intro p hp
      exact hq ⟨p,hp⟩)

/-- The literal closed-support unit is a quasi-isomorphism of complete
integer-indexed diagram complexes. -/
theorem normalizedUniversalLift_closedUnit_quasiIso (b : fan.Ray → ℤ) :
    QuasiIso (Cellular.closedFaceComplexUnit ℂ
      (normalizedUniversalLiftClosedSupport fan basis rays b)
      (normalizedUniversalLiftClosedSupport_downward fan basis rays b) (.up ℤ)
      (normalizedUniversalLiftComplex fan basis rays b)) :=
  Cellular.closedFaceComplexUnit_quasiIso ℂ _ _ (.up ℤ) _
    (normalizedUniversalLiftComplex_acyclic_outside fan basis rays b)

end ToricPower

end
