module

public import ToricPower.BasisQuotientByVector
public import TauCeti.Geometry.Toric.Algebraic.Ray.Face

/-!
# Regularity of quotient-star cones

An extending integral basis contains the selected primitive ray.
The quotient basis is obtained by deleting that vector. Every image
cone is therefore generated by a subfamily of the actual quotient
basis, which proves regularity of quotient stars in every rank.
-/

@[expose] public noncomputable section
open TauCeti.Toric
namespace ToricPower.FanSubdivision

variable {N P V W : Type*} [AddCommGroup N] [AddCommGroup P]
  [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  {i : N →+ V} {j : P →+ W}

theorem cone_map_hull (projection : V →ₗ[ℝ] W) (vectors : Set V) :
    PointedCone.map projection (PointedCone.hull ℝ vectors) =
      PointedCone.hull ℝ (projection '' vectors) := by
  simp only [PointedCone.map, PointedCone.hull, Submodule.map_span]
  rfl

/-- The image of a basis cone under a quotient killing one basis
vector is a basis cone for the literal quotient basis. -/
theorem basisCone_quotient_isRegular
    (targetLattice : IsIntegralLattice j)
    {ι : Type*} (basis : Module.Basis ι ℤ N) (pivot : ι)
    (latticeProjection : N →ₗ[ℤ] P) (projection : V →ₗ[ℝ] W)
    (compatible : ∀ n, projection (i n) = j (latticeProjection n))
    (kernel : LinearMap.ker latticeProjection = Submodule.span ℤ {basis pivot})
    (surjective : Function.Surjective latticeProjection) (active : Set ι) :
    IsRegularCone j (PointedCone.map projection
      (PointedCone.hull ℝ (i '' (basis '' active)))) := by
  classical
  let quotientBasis := projectedBasis basis pivot latticeProjection kernel surjective
  let quotientActive : Set {a : ι // a ≠ pivot} := {a | a.val ∈ active}
  let targetCone := PointedCone.hull ℝ (j '' (quotientBasis '' quotientActive))
  have imageEq : projection '' (i '' (basis '' active)) =
      j '' ((fun a => latticeProjection (basis a)) '' active) := by
    simp only [Set.image_image,Function.comp_def,compatible]
  have coneEq : PointedCone.map projection (PointedCone.hull ℝ (i '' (basis '' active))) =
      targetCone := by
    rw [cone_map_hull,imageEq]
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨_,⟨a,ha,rfl⟩,rfl⟩
      by_cases same : a = pivot
      · subst a
        change j (latticeProjection (basis pivot)) ∈ targetCone
        rw [projected_basis_pivot_eq_zero basis pivot latticeProjection kernel,map_zero]
        exact targetCone.zero_mem
      · apply PointedCone.subset_hull
        refine ⟨quotientBasis ⟨a,same⟩,⟨⟨a,same⟩,ha,rfl⟩,?_⟩
        rw [projectedBasis_apply]
    · apply Submodule.span_le.mpr
      rintro _ ⟨_,⟨a,ha,rfl⟩,rfl⟩
      apply PointedCone.subset_hull
      refine ⟨latticeProjection (basis a.val),⟨a.val,ha,rfl⟩,?_⟩
      rw [projectedBasis_apply]
  rw [coneEq]
  exact isRegularCone_hull_image_basis targetLattice quotientBasis quotientActive

/-- Every regular cone containing the selected primitive ray has a
regular image in the quotient lattice. -/
theorem regularCone_quotientRay_isRegular
    (sourceLattice : IsIntegralLattice i) (targetLattice : IsIntegralLattice j)
    {σ : PointedCone ℝ V} (regular : IsRegularCone i σ) (ray : ToricRay σ)
    (generator : N) (primitive : IsPrimitiveGenerator i ray generator)
    (latticeProjection : N →ₗ[ℤ] P) (projection : V →ₗ[ℝ] W)
    (compatible : ∀ n, projection (i n) = j (latticeProjection n))
    (kernel : LinearMap.ker latticeProjection = Submodule.span ℤ {generator})
    (surjective : Function.Surjective latticeProjection) :
    IsRegularCone j (PointedCone.map projection σ) := by
  obtain ⟨m,basis,rayIndex,basisExtends⟩ := regular.exists_basis
  have values (ρ : ToricRay σ) :
      basis (rayIndex ρ) = primitiveGenerator sourceLattice regular.toIsToricCone ρ :=
    (basisExtends.isPrimitiveGenerator_apply ρ).eq_primitiveGenerator sourceLattice regular.toIsToricCone
  have pivotValue : basis (rayIndex ray) = generator :=
    (values ray).trans
      (primitive.eq_primitiveGenerator sourceLattice regular.toIsToricCone).symm
  have generators : basis '' Set.range rayIndex =
      Set.range (primitiveGenerator sourceLattice regular.toIsToricCone) := by
    ext x
    constructor
    · rintro ⟨_,⟨ρ,rfl⟩,rfl⟩
      exact ⟨ρ,(values ρ).symm⟩
    · rintro ⟨ρ,rfl⟩
      exact ⟨rayIndex ρ,⟨ρ,rfl⟩,values ρ⟩
  have coneEq : PointedCone.hull ℝ (i '' (basis '' Set.range rayIndex)) = σ := by
    rw [generators]
    exact regular.toIsToricCone.hull_primitiveGenerator sourceLattice
  rw [← coneEq]
  apply basisCone_quotient_isRegular targetLattice basis (rayIndex ray)
    latticeProjection projection compatible
  · rw [kernel,pivotValue]
  · exact surjective

end ToricPower.FanSubdivision
end
