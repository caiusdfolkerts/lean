    RingEquiv.coe_toRingHom,AlgEquiv.coe_toRingEquiv] using hle hx

def clusterOddCoefficientEquiv (e : A ≃ₐ[F] B)
    (cluster : ι → κ) (z beta : ι → A) (r u v : ι → ℕ) :
