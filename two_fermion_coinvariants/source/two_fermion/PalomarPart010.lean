    (d : StrictData (K := R) (n := n)) (j : ℕ) :
    Module.finrank R (strictExteriorPiece d j)=
      (Polynomial.C ((∏ i,d.r i)*n.factorial)*(1+Polynomial.X)^(n-1) : Polynomial ℕ).coeff j := by
