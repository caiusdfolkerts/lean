    (pairedIdeal d.beta d.phi d.a d.b).ringCon.mkₐ_surjective (α := F)
  have hq₀ : Function.Surjective q₀ :=
    (pairedIdeal d.beta (fun i ↦ X i^d.r i)
      (fun i ↦ X i^d.u i) (fun i ↦ X i^d.v i)).ringCon.mkₐ_surjective (α := F)
