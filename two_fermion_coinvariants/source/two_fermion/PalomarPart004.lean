      (completedWordPolynomial (φ ∘ Fin.castLE hi') N d S
        (b'.ExteriorAlgebra.repr x S) (Fin.last i)) ((i + 1) - S.card) := by
    rcases hd with ⟨hmark, rfl⟩ | ⟨hmark, rfl⟩
    · obtain ⟨hθ, hξ⟩ := (wordMark_eq_theta_iff S (Fin.last i)).mp hmark
