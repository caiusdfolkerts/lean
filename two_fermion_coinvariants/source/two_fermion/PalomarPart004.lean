        (prefixWord (Nat.succ_le_iff.mpr hi) T)) (Fin.last i) =
      contractionSign (T \ pairedPrefix n (i + 1)).toList T •
        completedOccupation (harmonicData φ β a c T) N (b.ExteriorAlgebra.repr w T) d i := by
