theorem prefix_completedWordPolynomial (φ β a c : Fin n → R)
    (T : Finset (Fin n ⊕ Fin n)) (N : ℕ) (w : ExteriorAlgebra R V)
    (hmax : ∀ U, b.ExteriorAlgebra.repr w U ≠ 0 → toColex U ≤ toColex T)
