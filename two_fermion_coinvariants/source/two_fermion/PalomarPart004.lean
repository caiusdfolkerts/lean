    rw [← pairedFiniteRelation_ideal d,twoSidedIdealSubmodule_span b]
  have hker₀ : q₀.ker = Submodule.span F (Set.range g) := by
    rw [show q₀.ker = twoSidedIdealSubmodule (pairedIdeal d.beta
