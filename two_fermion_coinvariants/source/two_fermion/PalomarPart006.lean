      have hlt : i + 1 < l.length := by lia
      have hne := (List.isChain_iff_getElem.mp hchain) i hlt
      rcases lt_or_gt_of_ne hne with hlt' | hgt'
      · exact Or.inr (mem_ascentSet.mpr ⟨hlt, hlt'⟩)
      · exact Or.inl (mem_descentSet.mpr ⟨hlt, hgt'⟩)
