theorem descentSet_reverse (l : List α) :
    l.reverse.descentSet = l.ascentSet.image (fun i => l.length - 2 - i) := by
  ext i
  constructor
  · intro hi
    obtain ⟨h, hlt⟩ := mem_descentSet.mp hi
    have h' : i + 1 < l.length := by simpa using h
