    (clusterOddIdeal cluster z beta r u v)
    (clusterOddIdeal cluster (fun i ↦ e (z i)) (fun i ↦ e (beta i)) r u v)
    (clusterOddIdeal_coefficient_map e cluster z beta r u v)
