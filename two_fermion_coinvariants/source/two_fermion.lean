  have he := color_preserves_basisTail hn g
  have h := @WeightRees.fiberOne_equivariant
    F (StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi)
    (StrictPowerIndex (data (F := F) hn).r)
