noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open scoped Classical BigOperators

namespace PaperVerification.Fermion.TypeA

open Exterior

variable {F : Type*} [Field F] [CharZero F] {n : ℕ}

local instance colorGradedTraceOddOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' modeRank modeRank_injective

/-- Ordinary polynomial degree; both exterior families have degree zero. -/
def polynomialDegree (z : SuperMonomialIndex n) : ℕ := ∑ i,z.1 i

def boxPolynomialDegree (hn : 0<n) (z : StrictIndex (data (F := F) hn)) : ℕ :=
  ∑ i,z.val.2 i

theorem strictSuperWeight_data (hn : 0<n) :
    strictSuperWeight (data (F := F) hn)=polynomialDegree := by
  funext z
  simp only [strictSuperWeight_apply,data,coveringWeight,Finset.prod_const_one,
    Finsupp.weight_eq_sum,smul_eq_mul,mul_one,polynomialDegree]

/-- This is the actual image of degree-k polynomials tensored with the
entire original exterior algebra. -/
def polynomialPiece (hn : 0<n) (k : ℕ) :
    Submodule F (StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi) :=
  (BasisFiltered.homogeneousPiece (superMonomialBasis (K := F)) polynomialDegree k).map
    ((strictIdeal (data (F := F) hn).beta (data (F := F) hn).phi).ringCon.mkₐ F).toLinearMap

theorem polynomial_kernel_component (hn : 0<n) (k : ℕ) (x : SuperRing F n)
    (hx : x∈(((strictIdeal (data (F := F) hn).beta (data (F := F) hn).phi).ringCon.mkₐ F).toLinearMap).ker) :
    BasisFiltered.component (superMonomialBasis (K := F)) polynomialDegree k x ∈
      (((strictIdeal (data (F := F) hn).beta (data (F := F) hn).phi).ringCon.mkₐ F).toLinearMap).ker := by
  have hphi :
      (fun i : Fin n ↦ (MvPolynomial.X i : PolynomialRing F n)^(data (F := F) hn).r i)=
        (data (F := F) hn).phi := by
    funext i
    change (MvPolynomial.X i : PolynomialRing F n)^1=MvPolynomial.X i
    exact pow_one _
  have hx' : x∈(((strictIdeal (data (F := F) hn).beta
      (fun i ↦ MvPolynomial.X i^(data (F := F) hn).r i)).ringCon.mkₐ F).toLinearMap).ker := by
    rw [hphi]
    exact hx
  have h := strictPower_kernel_component (data (F := F) hn) k x hx'
  rw [strictSuperWeight_data,hphi] at h
  exact h

theorem boxMonomial_polynomial_homogeneous (hn : 0<n)
    (z : StrictIndex (data (F := F) hn)) :
    BasisFiltered.Homogeneous (superMonomialBasis (K := F)) polynomialDegree
      (boxPolynomialDegree (F := F) hn z) (boxMonomial z.val.1.1 z.val.1.2 z.val.2) := by
  rw [boxMonomial_eq_tensor]
  simpa only [superMonomialBasis_apply,polynomialDegree,boxPolynomialDegree,
    Finsupp.coe_equivFunOnFinite_symm] using
      (BasisFiltered.homogeneous_basis (superMonomialBasis (K := F)) polynomialDegree
        (Finsupp.equivFunOnFinite.symm z.val.2,z.val.1.1.disjSum z.val.1.2))

abbrev PolynomialBoxIndex (hn : 0<n) (k : ℕ) :=
  {z : StrictIndex (data (F := F) hn) // boxPolynomialDegree (F := F) hn z=k}

/-- Every degree piece has exactly the literal basis vectors of that degree. -/
def polynomialPieceBasis (hn : 0<n) (k : ℕ) :
    Module.Basis (PolynomialBoxIndex (F := F) hn k) F (polynomialPiece (F := F) hn k) :=
  BasisFiltered.quotientPieceBasis (superMonomialBasis (K := F)) polynomialDegree
    ((strictIdeal (data (F := F) hn).beta (data (F := F) hn).phi).ringCon.mkₐ F).toLinearMap
    (strictPaperBasis (data (F := F) hn))
    (fun z ↦ boxMonomial z.val.1.1 z.val.1.2 z.val.2)
    (boxPolynomialDegree (F := F) hn) (boxMonomial_polynomial_homogeneous (F := F) hn)
    (fun z ↦ by rw [strictPaperBasis_apply]; rfl)
    (polynomial_kernel_component (F := F) hn) k

@[simp] theorem polynomialPieceBasis_coe (hn : 0<n) (k : ℕ)
    (z : PolynomialBoxIndex (F := F) hn k) :
    (polynomialPieceBasis (F := F) hn k z : StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi)=
      strictPaperBasis (data (F := F) hn) z.val :=
  BasisFiltered.quotientPieceBasis_coe _ _ _ _ _ _ _ _ _ _ _

theorem diagonal_preserves_polynomialPiece (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0)
    (x : StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi)
    (hx : x∈polynomialPiece (F := F) hn k) :
    ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i) x ∈
      polynomialPiece (F := F) hn k := by
  let b := polynomialPieceBasis (F := F) hn k
  have he : (∑ z : PolynomialBoxIndex (F := F) hn k,
      b.repr ⟨x,hx⟩ z • strictPaperBasis (data (F := F) hn) z.val)=x := by
    simpa only [map_sum,map_smul,Submodule.subtype_apply,polynomialPieceBasis_coe,b] using
      congrArg (polynomialPiece (F := F) hn k).subtype (b.sum_repr ⟨x,hx⟩)
  rw [←he,map_sum]
  apply Submodule.sum_mem
  intro z hz
  rw [map_smul,quotientEquiv_strictPaperBasis_diagonal hn g h01 h10]
  apply Submodule.smul_mem
  apply Submodule.smul_mem
  rw [←polynomialPieceBasis_coe (F := F) hn k z]
  exact (polynomialPieceBasis (F := F) hn k z).property

/-- Restriction of the genuine quotient action to its actual degree piece. -/
def diagonalPolynomialPieceMap (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    polynomialPiece (F := F) hn k →ₗ[F] polynomialPiece (F := F) hn k :=
  (ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i)).toLinearMap.restrict
    (diagonal_preserves_polynomialPiece (F := F) hn k g h01 h10)

theorem diagonalPolynomialPieceMap_basis (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0)
    (z : PolynomialBoxIndex (F := F) hn k) :
    diagonalPolynomialPieceMap (F := F) hn k g h01 h10 (polynomialPieceBasis (F := F) hn k z)=
      diagonalMonomialWeight (g.val 0 0) (g.val 1 1) hn z.val •
        polynomialPieceBasis (F := F) hn k z := by
  apply Subtype.ext
  change ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i)
      ((polynomialPieceBasis (F := F) hn k z : polynomialPiece (F := F) hn k) :
        StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi)=
    diagonalMonomialWeight (g.val 0 0) (g.val 1 1) hn z.val •
      ((polynomialPieceBasis (F := F) hn k z : polynomialPiece (F := F) hn k) :
        StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi)
  simp only [polynomialPieceBasis_coe]
  exact quotientEquiv_strictPaperBasis_diagonal hn g h01 h10 z.val

/-- Each coefficient of the graded character is the trace on the actual
homogeneous quotient space, with the exact full set of degree-k boxes. -/
theorem diagonal_polynomial_trace_eq_box_sum (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    LinearMap.trace F (polynomialPiece (F := F) hn k) (diagonalPolynomialPieceMap (F := F) hn k g h01 h10)=
      ∑ z : PolynomialBoxIndex (F := F) hn k,
        diagonalMonomialWeight (g.val 0 0) (g.val 1 1) hn z.val := by
  rw [LinearMap.trace_eq_matrix_trace F (polynomialPieceBasis (F := F) hn k),Matrix.trace]
  apply Finset.sum_congr rfl
  intro z hz
  rw [Matrix.diag_apply,LinearMap.toMatrix_apply,
    diagonalPolynomialPieceMap_basis (F := F) hn k g h01 h10]
  let b := polynomialPieceBasis (F := F) hn k
  let c : F := diagonalMonomialWeight (g.val 0 0) (g.val 1 1) hn z.val
  change (b.repr (c • b z)) z=c
  have hs := LinearEquiv.map_smul b.repr c (b z)
  have he := congrArg (fun x : PolynomialBoxIndex (F := F) hn k →₀ F ↦ x z) hs
  simpa only [Module.Basis.repr_self,Finsupp.smul_apply,
    Finsupp.single_eq_same,smul_eq_mul,mul_one] using he

/-- The finite polynomial whose coefficients will be proved to be the
actual degree-piece traces. The verification is coefficientwise for every k. -/
def diagonalCharacterPolynomial (hn : 0<n) (u v : F) : Polynomial F :=
  ∑ z : StrictIndex (data (F := F) hn),
    Polynomial.C (diagonalMonomialWeight u v hn z)*
      Polynomial.X^boxPolynomialDegree (F := F) hn z

theorem diagonalCharacterPolynomial_coeff (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    (diagonalCharacterPolynomial (F := F) hn (g.val 0 0) (g.val 1 1)).coeff k=
      LinearMap.trace F (polynomialPiece (F := F) hn k) (diagonalPolynomialPieceMap (F := F) hn k g h01 h10) := by
  rw [diagonal_polynomial_trace_eq_box_sum]
  simp only [diagonalCharacterPolynomial,Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow]
  rw [←Finset.sum_subtype
    (Finset.univ.filter (fun z : StrictIndex (data (F := F) hn) ↦ boxPolynomialDegree (F := F) hn z=k))
    (by intro z; simp only [Finset.mem_filter,Finset.mem_univ,true_and])
    (diagonalMonomialWeight (g.val 0 0) (g.val 1 1) hn)]
  simp only [Finset.sum_filter,eq_comm]

/-- Exactly the multiplicity-vector polynomial printed in equation (22). -/
theorem diagonalCharacterPolynomial_eq_multiplicities (hn : 0<n) (u v : F) :
    diagonalCharacterPolynomial (F := F) hn u v=
      ∑ m : MultiplicityVector n,if Admissible m then
        ColorPaths.multiplicityBoxPolynomial (Polynomial.X : Polynomial F) m*
          (Polynomial.C u+Polynomial.C v)^ColorPaths.singleCount m*
          (Polynomial.C u*Polynomial.C v)^ColorPaths.doubleCount m else 0 := by
  rw [←strict_paper_q_color_sum (F := F) hn]
  apply Finset.sum_congr rfl
  intro z hz
  simp only [diagonalMonomialWeight,boxPolynomialDegree,map_mul,map_pow]
  ring

/-- Equation (22) as equality with traces of the original GL2 action on
every original polynomial-degree quotient space. -/
theorem equation_22_diagonal_trace (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    LinearMap.trace F (polynomialPiece (F := F) hn k) (diagonalPolynomialPieceMap (F := F) hn k g h01 h10)=
      (∑ m : MultiplicityVector n,if Admissible m then
        ColorPaths.multiplicityBoxPolynomial (Polynomial.X : Polynomial F) m*
          (Polynomial.C (g.val 0 0)+Polynomial.C (g.val 1 1))^ColorPaths.singleCount m*
          (Polynomial.C (g.val 0 0)*Polynomial.C (g.val 1 1))^ColorPaths.doubleCount m else 0).coeff k := by
  rw [←diagonalCharacterPolynomial_coeff (F := F) hn k g h01 h10,
    diagonalCharacterPolynomial_eq_multiplicities]

end PaperVerification.Fermion.TypeA
end
end
end BatchFile_421

section BatchFile_422
/- Literal source: PaperVerification/FermionColorPolynomialAction.lean -/


/-!
# The full GL2 action on every actual polynomial-degree piece

All color changes preserve polynomial degree before taking the quotient.
The degree pieces are the independently defined homogeneous images, and
restriction of the genuine quotient action gives their representations.
Every coefficient of the graded character is a trace of this genuine full
group representation. Rationality and semisimplicity are developed separately.

-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators TensorProduct

namespace PaperVerification.Fermion.TypeA

open Exterior
variable {F : Type*} [Field F] [CharZero F] {n : ℕ}

/-- The original total quotient carries the actual color action over every
characteristic-zero coefficient field. This definition does not use a
choice of basis, a trace formula, or a representation decomposition. -/
def quotientColorRepresentation :
    Representation F (Matrix.GeneralLinearGroup (Fin 2) F)
      (StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i)) where
  toFun g := (ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i)).toLinearMap
  map_one' := by
    rw [ColorAction.quotientEquiv_one]
    rfl
  map_mul' g h := by
    rw [ColorAction.quotientEquiv_mul]
    rfl

/-- Finiteness follows from the literal strict basis, with all its original
parameters specialized to type A. -/
theorem quotientColor_finite (hn : 0<n) :
    Module.Finite F
      (StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i)) :=
  Module.Finite.of_basis (strictPaperBasis (data (F := F) hn))

/-- Equation (23) for the character of the actual total GL2 representation,
with the original permutation ascent and descent statistics. -/
theorem equation_23_character (hn : 0<n)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    Representation.character
      (V := StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i))
      (quotientColorRepresentation (F := F) (n := n)) g=
      Eulerian.permutationPolynomial n (1+g.val 0 0) (1+g.val 1 1) :=
  diagonal_trace_eq_eulerian hn g h01 h10

local instance colorPolynomialActionOddOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' modeRank modeRank_injective

/-- The polynomial exponent is unchanged in every term of the color image. -/
theorem ambient_superMonomial_expansion (A : ColorAction.ColorMatrix F)
    (a : Fin n →₀ ℕ) (T : Finset (OddIndex n)) :
    ColorAction.ambient A (superMonomialBasis (K := F) (a,T))=
      ∑ S : Finset (OddIndex n),
        ((Pi.basisFun F (OddIndex n)).ExteriorAlgebra.repr
          (ExteriorAlgebra.map (ColorAction.linear A)
            ((Pi.basisFun F (OddIndex n)).ExteriorAlgebra T))) S •
              superMonomialBasis (K := F) (a,S) := by
  let E := (Pi.basisFun F (OddIndex n)).ExteriorAlgebra
  rw [superMonomialBasis_apply]
  change MvPolynomial.monomial a (1 : F) ⊗ₜ[F]
      ExteriorAlgebra.map (ColorAction.linear A) (E T)=_
  conv_lhs => rw [←E.sum_repr (ExteriorAlgebra.map (ColorAction.linear A) (E T))]
  simp only [TensorProduct.tmul_sum,TensorProduct.tmul_smul,superMonomialBasis_apply,E]

/-- Polynomial homogeneity is preserved on the ambient algebra, independently
of the quotient normal form or its basis. -/
theorem ambient_preserves_polynomial_homogeneous (A : ColorAction.ColorMatrix F)
    (k : ℕ) (x : SuperRing F n)
    (hx : BasisFiltered.Homogeneous (superMonomialBasis (K := F)) polynomialDegree k x) :
    BasisFiltered.Homogeneous (superMonomialBasis (K := F)) polynomialDegree k
      (ColorAction.ambient A x) := by
  let b := superMonomialBasis (K := F) (n := n)
  let H := BasisFiltered.homogeneousPiece b polynomialDegree k
  let f : SuperRing F n →ₗ[F] SuperRing F n :=
    ((ColorAction.ambient (n := n) A).restrictScalars F).toLinearMap
  change f x∈H
  rw [←b.linearCombination_repr x,Finsupp.linearCombination_apply,Finsupp.sum,map_sum]
  apply Submodule.sum_mem
  intro z hz
  rw [map_smul]
  apply Submodule.smul_mem
  change ColorAction.ambient A (superMonomialBasis z)∈H
  rw [ambient_superMonomial_expansion]
  apply Submodule.sum_mem
  intro S hS
  apply Submodule.smul_mem
  have hd := hx z (Finsupp.mem_support_iff.mp hz)
  change BasisFiltered.Homogeneous (superMonomialBasis (K := F)) polynomialDegree k
    (superMonomialBasis (z.1,S))
  have h := BasisFiltered.homogeneous_basis (superMonomialBasis (K := F))
    polynomialDegree (z.1,S)
  exact (show polynomialDegree (z.1,S)=k from hd) ▸ h

/-- Every GL2 element, not only the diagonal torus, preserves the actual
homogeneous quotient image. -/
theorem color_preserves_polynomialPiece (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F)
    (x : StrictQuotient (data (F := F) hn).beta (data (F := F) hn).phi)
    (hx : x∈polynomialPiece (F := F) hn k) :
    ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i) x∈
      polynomialPiece (F := F) hn k := by
  change x ∈ (BasisFiltered.homogeneousPiece (superMonomialBasis (K := F))
    polynomialDegree k).map
      ((strictIdeal (data (F := F) hn).beta (data (F := F) hn).phi).ringCon.mkₐ F).toLinearMap at hx
  obtain ⟨y,hy,rfl⟩ := Submodule.mem_map.mp hx
  apply Submodule.mem_map.mpr
  refine ⟨ColorAction.ambient g.val y,
    ambient_preserves_polynomial_homogeneous g.val k y hy,?_⟩
  exact (ColorAction.quotientEquiv_mk g (fun i : Fin n ↦ MvPolynomial.X i) y).symm

/-- Restriction of the full genuine group action to each original degree. -/
def polynomialPieceColorRepresentation (hn : 0<n) (k : ℕ) :
    Representation F (Matrix.GeneralLinearGroup (Fin 2) F) (polynomialPiece (F := F) hn k) where
  toFun g := (ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i)).toLinearMap.restrict
    (color_preserves_polynomialPiece (F := F) hn k g)
  map_one' := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ColorAction.quotientEquiv 1 (fun i : Fin n ↦ MvPolynomial.X i)
      (x : StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i))=
        (x : StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i))
    rw [ColorAction.quotientEquiv_one]
    rfl
  map_mul' g h := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change ColorAction.quotientEquiv (g*h) (fun i : Fin n ↦ MvPolynomial.X i)
      (x : StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i))=
      ColorAction.quotientEquiv g (fun i : Fin n ↦ MvPolynomial.X i)
        (ColorAction.quotientEquiv h (fun i : Fin n ↦ MvPolynomial.X i)
          (x : StrictQuotient (fun _ : Fin n ↦ (1 : F)) (fun i ↦ MvPolynomial.X i)))
    rw [ColorAction.quotientEquiv_mul,AlgEquiv.mul_apply]

/-- The map used in the coefficientwise character calculation is literally
this representation evaluated on the diagonal element. -/
theorem polynomialPieceColorRepresentation_diagonal (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    polynomialPieceColorRepresentation (F := F) hn k g=diagonalPolynomialPieceMap (F := F) hn k g h01 h10 := by
  apply LinearMap.ext
  intro x
  rfl

/-- Finiteness of the actual piece follows from its proved degree-selected
basis; it is not an additional premise of the character formula. -/
instance polynomialPiece_finite (hn : 0<n) (k : ℕ) :
    Module.Finite F (polynomialPiece (F := F) hn k) :=
  Module.Finite.of_basis (polynomialPieceBasis (F := F) hn k)

/-- Equation (22), coefficient by coefficient, for the character of the
actual full GL2 representation on each original polynomial degree. -/
theorem equation_22_character (hn : 0<n) (k : ℕ)
    (g : Matrix.GeneralLinearGroup (Fin 2) F) (h01 : g.val 0 1=0) (h10 : g.val 1 0=0) :
    Representation.character (V := polynomialPiece (F := F) hn k)
      (polynomialPieceColorRepresentation (F := F) hn k) g=
      (∑ m : MultiplicityVector n,if Admissible m then
        ColorPaths.multiplicityBoxPolynomial (Polynomial.X : Polynomial F) m*
          (Polynomial.C (g.val 0 0)+Polynomial.C (g.val 1 1))^ColorPaths.singleCount m*
          (Polynomial.C (g.val 0 0)*Polynomial.C (g.val 1 1))^ColorPaths.doubleCount m else 0).coeff k := by
  rw [Representation.character,polynomialPieceColorRepresentation_diagonal hn k g h01 h10]
  exact equation_22_diagonal_trace hn k g h01 h10

end PaperVerification.Fermion.TypeA
end
end
end BatchFile_422

section BatchFile_423
/- Literal source: PaperVerification/FermionColorPolynomialRational.lean -/


/-!
# Rationality and complete reducibility in each actual polynomial degree

Matrix coefficients of the genuine degree-piece action are extended to
linear functionals on the original quotient and evaluated on its literal
monomial representatives. Polynomiality is proved before applying the
pinned rational-representation complete-reducibility theorem.

-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical BigOperators TensorProduct

namespace PaperVerification.Fermion.TypeA

open Exterior
variable {n : ℕ}

local instance colorPolynomialRationalOddOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' modeRank modeRank_injective

/-- Each actual degree-piece representation has polynomial matrix entries.
Extension of coordinate functionals is ordinary linear algebra, independent
of the desired representation decomposition. -/
theorem polynomialPieceColorRepresentation_polynomial (hn : 0<n) (k : ℕ) :
    TauCeti.IsPolynomialRep (polynomialPieceColorRepresentation (F := ℂ) hn k) := by
  let B := polynomialPieceBasis (F := ℂ) hn k
  apply (TauCeti.isPolynomialRep_iff_forall_mem_polynomialFunctions B).mpr
  intro i j
  obtain ⟨ell,hell⟩ := (B.coord i).exists_extend
  let q := (strictIdeal (fun _ : Fin n ↦ (1 : ℂ))
    (fun t : Fin n ↦ MvPolynomial.X t)).ringCon.mkₐ ℂ
  have h := ColorAction.boxMonomial_matrixCoefficient_polynomial
    j.val.val.1.1 j.val.val.1.2 j.val.val.2 (ell.comp q.toLinearMap)
  convert h using 1
  funext g
  rw [LinearMap.toMatrix_apply]
  change (B.coord i) (polynomialPieceColorRepresentation hn k g (B j))=_
  rw [←hell]
  change ell (ColorAction.quotientEquiv g (fun t : Fin n ↦ MvPolynomial.X t)
    ((polynomialPieceBasis (F := ℂ) hn k j : polynomialPiece (F := ℂ) hn k) :
      StrictQuotient (data (F := ℂ) hn).beta (data (F := ℂ) hn).phi))=_
  rw [polynomialPieceBasis_coe,strictPaperBasis_apply]
  change ell (ColorAction.quotientEquiv g (fun t : Fin n ↦ MvPolynomial.X t)
    (q (boxMonomial j.val.val.1.1 j.val.val.1.2 j.val.val.2)))=_
  rw [ColorAction.quotientEquiv_mk]
  rfl

/-- Complete reducibility applies in every actual polynomial degree, as used
in Section8.2, without a semisimplicity or rationality hypothesis. -/
theorem polynomialPieceColorRepresentation_semisimple (hn : 0<n) (k : ℕ) :
    (polynomialPieceColorRepresentation (F := ℂ) hn k).IsSemisimpleRepresentation :=
