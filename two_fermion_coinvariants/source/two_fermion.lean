      (d.map (algebraMap R S)).a (d.map (algebraMap R S)).b).ringCon.mkₐ S).toLinearMap
    (by
      intro y
      obtain ⟨x,hx⟩ := (pairedIdeal d.beta d.phi d.a d.b).ringCon.mkₐ_surjective (α := R) y
