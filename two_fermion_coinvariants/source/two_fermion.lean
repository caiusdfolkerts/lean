/- Literal source: PaperVerification/FermionNewtonProfileNonzero.lean -/


/-!
# Nonvanishing of the full compatible-profile Newton determinant

Constant profiles follow from the simultaneous all-one induction. For a
nonconstant profile, the suffix determinant is supplied by induction and the
initial block by the constant-profile result on its independent subset of
variables. This proves nonvanishing of the actual columns for all compatible
profiles; no bounded configuration or extra positivity hypothesis is used.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace PaperVerification.Fermion.Newton

open Polynomial
open scoped BigOperators Matrix

variable (F : Type*) [Field F]

theorem profileGeneric_det_ne_zero (n : ℕ)
    (δ : Fin n → ℕ) (σ : Fin n → ℤ) (β : Fin n → F)
    (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    (profileNewtonMatrix δ σ (successiveNode F n) (successiveBaseMap F n ∘ β)).det ≠ 0 := by
  induction n with
  | zero => simp only [Matrix.det_isEmpty, ne_eq, one_ne_zero, not_false_eq_true]
  | succ n ih =>
      by_cases hconstant : ∀ i, δ i = δ 0
      · have hδ : δ = fun _ ↦ δ 0 := funext hconstant
        rw [hδ]
        exact constantProfileGeneric_det_ne_zero F (n + 1) (δ 0) σ β hσ hβ
      let δs : Fin n → ℕ := δ ∘ Fin.succ
      let σs : Fin n → ℤ := σ ∘ Fin.succ
      let βs : Fin n → F := β ∘ Fin.succ
      let y := successiveNode F n
      let γ : Fin n → SuccessiveField F n := successiveBaseMap F n ∘ βs
      let c := suffixCoefficientMap F n
      let φ := newVariablePolynomialMap F n
      let x := successiveNode F (n + 1)
      let γfull : Fin (n + 1) → SuccessiveField F (n + 1) := successiveBaseMap F (n + 1) ∘ β
      have hcs : Compatible δs σs := by
        constructor
        · intro i j hij hi
          exact hc.1 i.succ j.succ (Fin.succ_lt_succ_iff.mpr hij) hi
        · intro i j hij hi
          exact hc.2 i.succ j.succ (Fin.succ_lt_succ_iff.mpr hij) hi
      have hσs : ∀ i, σs i = -1 ∨ σs i = 0 ∨ σs i = 1 := fun i ↦ hσ i.succ
      have hβs : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, βs i) := by
        intro U hU
        have h := hβ (U.map (Fin.succEmb n)) (hU.map)
        simpa only [Finset.sum_map, Fin.coe_succEmb, βs, Function.comp_apply] using h
      have hdet := ih δs σs βs hcs hσs hβs
      change (profileNewtonMatrix δs σs y γ).det ≠ 0 at hdet
      have hxsucc : x ∘ Fin.succ = c ∘ y := by
        funext i
        exact successiveNode_succ F n i
      have hγsucc : γfull ∘ Fin.succ = c ∘ γ := by
        funext i
        exact successiveBaseMap_succ F n (β i.succ)
      have hSmap : profileNewtonMatrix δs σs (x ∘ Fin.succ) (γfull ∘ Fin.succ) =
          (profileNewtonMatrix δs σs y γ).map c := by
        rw [hxsucc, hγsucc, profileNewtonMatrix_map]
      have hS : (profileNewtonMatrix δs σs (x ∘ Fin.succ) (γfull ∘ Fin.succ)).det ≠ 0 := by
        rw [hSmap, matrix_map_det]
        exact (map_ne_zero c).mpr hdet
      change (profileNewtonMatrix δ σ x γfull).det ≠ 0
      rcases hσ 0 with hminus | hnonnegative
      · have hmin : ∀ i, δ 0 ≤ δs i := fun i ↦ hc.2 0 i.succ (Fin.succ_pos _) hminus
        have hstrict : ∃ i, δ 0 < δs i := by
          by_contra hn
          apply hconstant
          intro i
          refine Fin.cases rfl (fun j ↦ ?_) i
          exact le_antisymm (Nat.le_of_not_gt (fun hj ↦ hn ⟨j, hj⟩)) (hmin j)
        obtain ⟨m, hm, hδ, hjump⟩ := exists_initial_constant_block δs (δ 0) hmin hstrict
        cases n with
        | zero => omega
        | succ n =>
            let e := prefixEmbedding hm.le
            let ρ : MvPolynomial (Fin m) F →+* SuccessiveField F (n + 1) :=
              (successiveCoordinateMap F (n + 1)).comp (MvPolynomial.rename e).toRingHom
            have hρ : Function.Injective ρ :=
              (successiveCoordinateMap_injective F (n + 1)).comp
                (MvPolynomial.rename_injective e e.injective)
            have hβp : ∀ U : Finset (Fin m), U.Nonempty →
                IsUnit (∑ i ∈ U, βs (e i)) := by
              intro U hU
              have h := hβs (U.map e) (hU.map)
              simpa only [Finset.sum_map] using h
            have hblock : ((profileNewtonMatrix δs σs y γ).submatrix e e).det ≠ 0 := by
              rw [profileNewtonMatrix_prefix_block hm δs (δ 0) σs y γ hδ hjump]
              have h := constantProfile_det_of_injective_polynomial_map ρ hρ (δ 0)
                (σs ∘ e) (βs ∘ e) (fun i ↦ hσs (e i)) hβp
              have hρX (i : Fin m) : ρ (MvPolynomial.X i) = y (e i) := by
                change successiveCoordinateMap F (n + 1)
                  (MvPolynomial.rename e (MvPolynomial.X i)) = _
                rw [MvPolynomial.rename_X]
                rfl
              have hρC (i : Fin m) : ρ (MvPolynomial.C (βs (e i))) = γ (e i) := by
                change successiveCoordinateMap F (n + 1)
                  (MvPolynomial.rename e (MvPolynomial.C (βs (e i)))) = _
                rw [MvPolynomial.rename_C]
                rfl
              simpa only [hρX, hρC, Function.comp_def,e] using h
            have hweights : ∀ U : Finset (Fin (n + 2)), U.Nonempty →
                IsUnit (∑ i ∈ U, (Fin.cases (successiveBaseMap F (n + 1) (β 0)) γ i : SuccessiveField F (n + 1))) := by
              intro U hU
              have he : Fin.cases (successiveBaseMap F (n + 1) (β 0)) γ =
                  successiveBaseMap F (n + 1) ∘ β := by
                funext i
                exact Fin.cases rfl (fun j ↦ rfl) i
              rw [he]
              simp only [Function.comp_apply]
              rw [← map_sum]
              exact (hβ U hU).map (successiveBaseMap F (n + 1))
            have hmnew := profile_negative_step_det_ne_zero φ
              (newVariablePolynomialMap_injective F (n + 1)) δs σs (δ 0) y γ
              (successiveBaseMap F (n + 1) (β 0)) hm hmin hδ hjump
              (compatible_prefix_no_positive hm δs (δ 0) σs hcs hδ hjump)
              hweights hdet hblock
            have hδcase : δ = Fin.cases (δ 0) δs := by
              funext i
              exact Fin.cases rfl (fun j ↦ rfl) i
            have hσcase : σ = Fin.cases (-1) σs := by
              funext i
              exact Fin.cases hminus (fun j ↦ rfl) i
            have hxcase : x = Fin.cases (φ X) (fun i ↦ φ (C (y i))) := by
              funext i
              exact Fin.cases (successiveNode_zero F (n + 1))
                (fun j ↦ successiveNode_succ F (n + 1) j) i
            have hγcase : γfull =
                Fin.cases (φ (C (successiveBaseMap F (n + 1) (β 0))))
                  (fun i ↦ φ (C (γ i))) := by
              funext i
              exact Fin.cases (successiveBaseMap_succ F (n + 1) (β 0))
                (fun j ↦ successiveBaseMap_succ F (n + 1) (β j.succ)) i
            rw [hδcase, hσcase, hxcase, hγcase]
            exact hmnew
      · exact profileNewtonMatrix_nonnegative_det_ne_zero δ σ x γfull hnonnegative
          (successiveNode_injective F (n + 1)) (successiveNode_ne_zero F (n + 1) 0) hS

/-- Nonzero determinant of the paper's literal columns, for every compatible
nonnegative multiplicity profile and every allowed sign word. -/
theorem newtonColumn_det_ne_zero (n : ℕ)
    (δ : Fin n → ℕ) (σ : Fin n → ℤ) (β : Fin n → F)
    (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    Matrix.det (fun k i : Fin n ↦ newtonColumn β δ σ i k) ≠ 0 := by
  have h := profileGeneric_det_ne_zero F n δ σ β hc hσ hβ
  simp_rw [newtonColumn_eq_profileNewtonMatrix F]
  change (profileNewtonMatrix δ σ (rationalNode (F := F))
    (fun i ↦ algebraMap F (RationalFunctions (F := F)) (β i))).det ≠ 0
  intro hz
  apply h
  have he := congrArg (successiveFractionMap F n) hz
  rw [map_zero, ← matrix_map_det, profileNewtonMatrix_map] at he
  simpa only [Function.comp_def, successiveFractionMap_node, successiveFractionMap_scalar] using he

end PaperVerification.Fermion.Newton
end
end
end BatchFile_51

section BatchFile_52
/- Literal source: PaperVerification/FermionNewtonDenominators.lean -/


/-!
# Actual polynomial numerators for the rational Newton columns

Every pole denominator is a product of distinct negative edge equations.
The common negative product therefore clears it. This file keeps that fact
as divisibility in the original polynomial ring, including the coordinate
factors prescribed by the multiplicity profile.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial
open scoped BigOperators

variable {F : Type*} [Field F] {n : ℕ}

def starDenominator (k : Fin n) (T : Finset (Fin n)) : P (F := F) (n := n) :=
  ∏ j ∈ T, (X k - X j)

theorem starLinear_prime (k j : Fin n) (hkj : k ≠ j) :
    Prime (X (R := F) k - X j) := by
  have h := (MulEquiv.prime_iff (coordinateShear (F := F) k j hkj)).mpr
    (MvPolynomial.prime_X (R := F) (i := k))
  simpa only [coordinateShear_X_self] using h

theorem starLinear_relPrime (k j l : Fin n) (hkj : k ≠ j) (hkl : k ≠ l) (hjl : j ≠ l) :
    IsRelPrime (X (R := F) k - X j) (X k - X l) := by
  apply (starLinear_prime k j hkj).irreducible.isRelPrime_iff_not_dvd.mpr
  intro hd
  let ev : P (F := F) (n := n) →ₐ[F] (P (F := F) (n := n)) := aeval fun t ↦ if t = j then X k else X t
  have h := map_dvd ev hd
  have hz : (X (R := F) k - X l) = 0 := by
    simpa only [ev, map_sub, aeval_X, if_neg hkj, if_pos rfl, if_true, sub_self,
      if_neg (Ne.symm hjl), zero_dvd_iff] using h
  exact hkl (MvPolynomial.X_injective (sub_eq_zero.mp hz))

theorem starLinear_relPrime_coordinate (k j : Fin n) (hkj : k ≠ j) :
    IsRelPrime (X (R := F) k - X j) (X k) := by
  apply IsRelPrime.symm
  apply (MvPolynomial.prime_X (R := F) (i := k)).irreducible.isRelPrime_iff_not_dvd.mpr
  intro hd
  have h := (coordinateRestriction_eq_zero_iff k (X (R := F) k - X j)).mpr hd
  have hz : (X (R := F) j) = 0 := by
    simpa only [coordinateRestriction, map_sub, aeval_X, if_pos rfl, if_true,
      if_neg (Ne.symm hkj), zero_sub, neg_eq_zero] using h
  exact MvPolynomial.X_ne_zero (R := F) j hz

theorem starLinear_dvd_negativeDenominator (σ : Fin n → ℤ) (k j : Fin n)
    (hkj : k ≠ j)
    (hneg : (k < j → σ k = -1) ∧ (j < k → σ j = -1)) :
    (X (R := F) k - X j) ∣ negativeDenominator σ := by
  rcases lt_or_gt_of_ne hkj with hlt | hgt
  · exact edgeLinear_dvd_negativeDenominator σ ⟨(k,j),hlt⟩ (hneg.1 hlt)
  · obtain ⟨q,hq⟩ := edgeLinear_dvd_negativeDenominator (F := F) σ ⟨(j,k),hgt⟩ (hneg.2 hgt)
    refine ⟨-q, ?_⟩
    rw [hq]
    change (X j - X k) * q = (X k - X j) * -q
    ring

theorem starDenominator_dvd_negativeDenominator (σ : Fin n → ℤ)
    (k : Fin n) (T : Finset (Fin n)) (hself : k ∉ T)
    (hneg : ∀ j ∈ T, (k < j → σ k = -1) ∧ (j < k → σ j = -1)) :
    starDenominator (F := F) k T ∣ negativeDenominator σ := by
  apply Finset.prod_dvd_of_isRelPrime
  · intro j hj l hl hjl
    change j ∈ T at hj
    change l ∈ T at hl
    exact starLinear_relPrime k j l (fun h ↦ hself (by simpa only [h] using hj))
      (fun h ↦ hself (by simpa only [h] using hl)) hjl
  · intro j hj
    exact starLinear_dvd_negativeDenominator σ k j
      (fun h ↦ hself (by simpa only [h] using hj)) (hneg j hj)

theorem starDenominator_ne_zero (k : Fin n) (T : Finset (Fin n)) (hself : k ∉ T) :
    starDenominator (F := F) k T ≠ 0 := by
  apply Finset.prod_ne_zero_iff.mpr
  intro j hj
  exact sub_ne_zero.mpr (fun h ↦ hself (by simpa only [MvPolynomial.X_injective h] using hj))

theorem active_denominator_dvd (δ : Fin n → ℕ) (σ : Fin n → ℤ)
    (i k : Fin n) (hk : k ∈ activeInterval δ i) :
    starDenominator (F := F) k (earlierNegative σ i) ∣ negativeDenominator σ := by
  have hik := ((mem_activeInterval δ i k).mp hk).1
  apply starDenominator_dvd_negativeDenominator
  · intro hn
    exact (not_lt_of_ge hik) ((mem_earlierNegative σ i k).mp hn).1
  · intro j hj
    rcases (mem_earlierNegative σ i j).mp hj with ⟨hji,hjσ⟩
    exact ⟨fun hkj ↦ False.elim ((not_lt_of_ge (le_of_lt (hji.trans_le hik))) hkj),
      fun _ ↦ hjσ⟩

theorem residue_denominator_dvd (δ : Fin n → ℕ) (σ : Fin n → ℤ)
    (i k l : Fin n) (hk : k ∈ earlierNegative σ i) (hl : l ∈ activeInterval δ i) :
    starDenominator (F := F) k ((earlierNegative σ i).erase k) * (X k - X l) ∣
      negativeDenominator σ := by
  have hki := ((mem_earlierNegative σ i k).mp hk).1
  have hkσ := ((mem_earlierNegative σ i k).mp hk).2
  have hil := ((mem_activeInterval δ i l).mp hl).1
  have hkl : k < l := hki.trans_le hil
  have hlnot : l ∉ (earlierNegative σ i).erase k := by
    intro h
    exact (not_lt_of_ge hil) ((mem_earlierNegative σ i l).mp (Finset.mem_erase.mp h).2).1
  have h := starDenominator_dvd_negativeDenominator (F := F) σ k
    (insert l ((earlierNegative σ i).erase k))
    (by simp only [Finset.mem_insert, Finset.mem_erase]; exact not_or.mpr ⟨ne_of_lt hkl, by simp⟩)
    (by
      intro j hj
      rcases Finset.mem_insert.mp hj with rfl | hj
      · exact ⟨fun _ ↦ hkσ, fun hlt ↦ False.elim ((not_lt_of_ge (le_of_lt (hki.trans_le hil))) hlt)⟩
      · exact ⟨fun _ ↦ hkσ, fun _ ↦ ((mem_earlierNegative σ i j).mp (Finset.mem_erase.mp hj).2).2⟩)
  simpa only [starDenominator, Finset.prod_insert hlnot, mul_comm] using h

/-- Rational functions whose common-denominator numerator has a prescribed
polynomial divisor. This is an actual submodule, so sums of residue terms
retain both polynomiality and the coordinate divisibility. -/
def clearedDivisibility (Q p : P (F := F) (n := n)) : Submodule (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) where
  carrier := {z | ∃ a : (P (F := F) (n := n)), p ∣ a ∧ algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) a =
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) Q * z}
  zero_mem' := ⟨0, dvd_zero _, by simp⟩
  add_mem' := by
    rintro x y ⟨a,ha,hea⟩ ⟨b,hb,heb⟩
    refine ⟨a+b,dvd_add ha hb,?_⟩
    rw [map_add,hea,heb,mul_add]
  smul_mem' := by
    rintro a x ⟨b,hb,heb⟩
    refine ⟨a*b,dvd_mul_of_dvd_right hb a,?_⟩
    rw [map_mul,heb,Algebra.smul_def]
    ring

theorem fraction_mem_clearedDivisibility
    (Q p N D : P (F := F) (n := n)) (hD : D ∣ Q) (hD0 : D ≠ 0) (hN : p ∣ N) :
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) N /
        algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) D ∈ clearedDivisibility Q p := by
  obtain ⟨q,hq⟩ := hD
  refine ⟨q*N,dvd_mul_of_dvd_right hN q,?_⟩
  have hd : algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) D ≠ 0 := by
    intro hz
    exact hD0 (IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (by simpa using hz))
  rw [hq,map_mul,map_mul]
  field_simp [hd]
  <;> ring

theorem evaluated_numerator_coordinate_dvd
    (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k : Fin n) (hδ : δ k ≤ δ i) :
    X k ^ δ k ∣ (columnNumerator (F := F) δ σ i).eval (X k) := by
  rw [columnNumerator, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X]
  exact dvd_mul_of_dvd_left (pow_dvd_pow (X k) hδ) _

theorem map_starDenominator (k : Fin n) (T : Finset (Fin n)) :
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (starDenominator (F := F) k T) =
      ∏ j ∈ T, (rationalNode k - rationalNode j) := by
  simp only [starDenominator, map_prod, map_sub, rationalNode]

end PaperVerification.Fermion.Newton
end
end
