    Module.Basis (MultiplicityColoring m) F (ColorPaths.ExteriorColorTensor F m) :=
  (ColorPaths.exteriorColorTensorBasis F m).unitsSMul
    (fun T ↦ (Units.mk0 (assemblyScalar m T) (assemblyScalar_ne_zero m T))⁻¹)

