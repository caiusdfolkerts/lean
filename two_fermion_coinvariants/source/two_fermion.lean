theorem ringKrullDim_le_ringKrullDim_add_ringKrullDim_quotient_map_maximalIdeal [IsLocalRing R]
    [IsLocalRing S] [IsNoetherianRing R] [IsNoetherianRing S] [IsLocalHom (algebraMap R S)] :
