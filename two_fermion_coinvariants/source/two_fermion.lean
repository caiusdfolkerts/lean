theorem isCohenMacaulay_self_iff :
    Module.IsCohenMacaulay B B ↔
      Module.IsCohenMacaulay (Localization.AtPrime p) (Localization.AtPrime p) :=
  have := IsLocalization.isNoetherianRing p.primeCompl B inferInstance
