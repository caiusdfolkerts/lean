theorem theorem_7_2 {F : Type} [Field F] [CharZero F] [IsAlgClosed F] {n : ℕ}
    (d : SeparatedPairedData F n) :
    Finite d.O.SupportPoint ∧
    (∀ rho : d.O.SupportPoint,∃ e :
        d.LocalSuper rho ≃ₐ[F] (d.localClusterFamily rho).tensor.Carrier,
