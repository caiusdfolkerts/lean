/- Literal source: PaperVerification/FermionCoinvariantLocalBlocks.lean -/


/-!
# Actual local invariant blocks and the moment-ideal inclusion

This file proves that every original moment
generator is a genuine positive invariant for the independently defined
wreath action. The reverse ideal inclusion requires the full Reynolds and
occupied-index argument; it is not postulated here.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators TensorProduct

namespace PaperVerification.Fermion.Coinvariants

variable {R : Type*} [CommRing R] {n r : ℕ}

def oddPart : MomentKind → Fin n → SuperRing R n
  | .polynomial,_ => 1
  | .theta,i => theta R n i
  | .xi,i => xi R n i
  | .mixed,i => theta R n i*xi R n i

def oddWeight (p q : ℕ) : MomentKind → ℕ
  | .polynomial => 0
  | .theta => p
  | .xi => q
  | .mixed => p+q

/-- The literal one-index block, including all four exterior possibilities. -/
def localBlock (d : ℕ) (a : MomentKind) (i : Fin n) : SuperRing R n :=
  even (R := R) i^d*oddPart a i

def blockSum (d : ℕ) (a : MomentKind) : SuperRing R n := ∑ i,localBlock d a i

@[simp] theorem permutation_oddPart (σ : Equiv.Perm (Fin n)) (a : MomentKind) (i : Fin n) :
    permutation (R := R) σ (oddPart a i)=oddPart a (σ i) := by
  cases a <;> simp only [oddPart,map_one,map_mul,permutation_theta,permutation_xi]

@[simp] theorem permutation_localBlock (σ : Equiv.Perm (Fin n))
    (d : ℕ) (a : MomentKind) (i : Fin n) :
    permutation (R := R) σ (localBlock d a i)=localBlock d a (σ i) := by
  simp only [localBlock,map_mul,map_pow,permutation_even,permutation_oddPart]

@[simp] theorem diagonal_oddPart (p q : ℕ) (c : Fin n → Rˣ)
    (a : MomentKind) (i : Fin n) :
    diagonal p q c (oddPart a i)=(c i : R)^oddWeight p q a • oddPart a i := by
  cases a <;> simp only [oddPart,oddWeight,map_one,map_mul,diagonal_theta,
    diagonal_xi,pow_zero,one_smul,pow_add,smul_mul_smul_comm]

@[simp] theorem diagonal_localBlock (p q : ℕ) (c : Fin n → Rˣ)
    (d : ℕ) (a : MomentKind) (i : Fin n) :
    diagonal p q c (localBlock d a i)=(c i : R)^(d+oddWeight p q a) • localBlock d a i := by
  simp only [localBlock,map_mul,map_pow,diagonal_even,diagonal_oddPart,
    smul_pow,smul_mul_smul_comm,pow_add]

@[simp] theorem wreathAction_localBlock (p q : ℕ) (g : WreathGroup R n r)
    (d : ℕ) (a : MomentKind) (i : Fin n) :
    wreathAction p q g (localBlock d a i)=
      ((g.left (g.right i) : Rˣ) : R)^(d+oddWeight p q a) • localBlock d a (g.right i) := by
  change diagonal p q (fun j ↦ (g.left j : Rˣ))
    (permutation g.right (localBlock d a i))=_
  rw [permutation_localBlock,diagonal_localBlock]

theorem root_pow_eq_one_of_dvd (z : rootsOfUnity r R) {d : ℕ} (hd : r∣d) :
    ((z : Rˣ) : R)^d=1 := by
  obtain ⟨k,rfl⟩ := hd
  rw [pow_mul,(mem_rootsOfUnity' r z.val).mp z.property,one_pow]

/-- The natural exponent `r-a` is exactly the character `-a` on the
original cyclic factor, not an additional character assumption. -/
theorem root_opposite_character {a : ℕ} (ha : a≤r) (z : rootsOfUnity r R) :
    (z : Rˣ)^(r-a)=((z : Rˣ)^a)⁻¹ := by
  apply eq_inv_of_mul_eq_one_right
  rw [←pow_add,Nat.add_sub_of_le ha]
  exact (mem_rootsOfUnity r z.val).mp z.property

/-- The divisibility condition is exactly the local cyclic-character condition. -/
theorem blockSum_invariant (p q : ℕ) (d : ℕ) (a : MomentKind)
    (hd : r∣d+oddWeight p q a) (g : WreathGroup R n r) :
    wreathAction p q g (blockSum (R := R) (n := n) d a)=blockSum d a := by
  simp only [blockSum,map_sum,wreathAction_localBlock,
    root_pow_eq_one_of_dvd _ hd,one_smul]
  exact Equiv.sum_comp g.right (localBlock d a)

@[simp] theorem augmentation_localBlock (d : ℕ) (a : MomentKind) (i : Fin n)
    (hp : 0<d ∨ a≠.polynomial) : augmentation (localBlock (R := R) d a i)=0 := by
  cases a with
  | polynomial =>
      have hd : d≠0 := Nat.ne_of_gt (hp.resolve_right (by simp))
      simp only [localBlock,oddPart,map_mul,map_pow,map_one,augmentation_even,
        zero_pow hd,mul_one]
  | theta => simp only [localBlock,oddPart,map_mul,augmentation_theta,mul_zero]
  | xi => simp only [localBlock,oddPart,map_mul,augmentation_xi,mul_zero]
  | mixed => simp only [localBlock,oddPart,map_mul,augmentation_theta,
      augmentation_xi,mul_zero]

theorem blockSum_mem_positiveInvariantIdeal (p q : ℕ) (d : ℕ) (a : MomentKind)
    (hd : r∣d+oddWeight p q a) (hp : 0<d ∨ a≠.polynomial) :
    blockSum (R := R) (n := n) d a∈positiveInvariantIdeal (r := r) p q := by
  apply TwoSidedIdeal.subset_span
  refine ⟨?_,blockSum_invariant p q d a hd⟩
  simp only [blockSum,map_sum,augmentation_localBlock d a _ hp,Finset.sum_const_zero]

/-- The four exponents printed in Section 8.1, including the positive ordinary family. -/
def oppositeExponent (r a : ℕ) : MomentKind → ℕ → ℕ
  | .polynomial,k => r*(k+1)
  | .theta,k => r-a+r*k
  | .xi,k => a+r*k
  | .mixed,k => r*k

theorem oppositeExponent_weight_dvd (r a : ℕ) (ha : a≤r)
    (c : MomentKind) (k : ℕ) : r∣oppositeExponent r a c k+oddWeight a (r-a) c := by
  cases c <;> refine ⟨k+1,?_⟩ <;>
    simp only [oppositeExponent,oddWeight,Nat.mul_add,Nat.mul_one] <;> omega

theorem oppositeExponent_positive (r a : ℕ) (hr : 0<r)
    (c : MomentKind) (k : ℕ) : 0<oppositeExponent r a c k ∨ c≠.polynomial := by
  cases c
  · exact Or.inl (Nat.mul_pos hr (Nat.succ_pos k))
  all_goals exact Or.inr (by decide)

/-- The two-sided scalar action is the genuine polynomial inclusion. -/
theorem polynomial_smul_eq_even_mul (p : PolynomialRing R n) (x : SuperRing R n) :
    p • x=Algebra.TensorProduct.includeLeft (R := R) (S := R) p*x := by
  induction x using TensorProduct.induction_on with
  | zero => simp only [smul_zero,mul_zero]
  | tmul a b =>
      simp only [TensorProduct.smul_tmul',smul_eq_mul,
        Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.tmul_mul_tmul,one_mul]
  | add x y hx hy => simp only [smul_add,mul_add,hx,hy]

theorem moment_local_monomials (r : ℕ) (d : Fin n → ℕ)
    (v : Fin n → SuperRing R n) (k : ℕ) :
    moment (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^r)
      (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^d i • v i) k=
      ∑ i,even (R := R) i^(r*k+d i)*v i := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [←pow_mul,smul_smul,←pow_add,polynomial_smul_eq_even_mul,map_pow]
  rfl

def oppositeBaseExponent (r a : ℕ) : MomentKind → ℕ
  | .polynomial => r
  | .theta => r-a
  | .xi => a
  | .mixed => 0

theorem pairedCoefficients_opposite (r a : ℕ) (ha : a≤r)
    (c : MomentKind) (i : Fin n) :
    pairedCoefficients (fun _ : Fin n ↦ (1 : R))
      (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^a)
      (fun i ↦ (MvPolynomial.X i)^ (r-a)) c i=
      (MvPolynomial.X i : PolynomialRing R n)^oppositeBaseExponent r a c •
        oddPart (R := R) c i := by
  cases c with
  | polynomial =>
      simp only [pairedCoefficients,oppositeBaseExponent,oddPart,MvPolynomial.C_1,one_mul]
      rw [←pow_add,Nat.add_sub_of_le ha]
  | theta => rfl
  | xi => simp only [pairedCoefficients,oppositeBaseExponent,oddPart,MvPolynomial.C_1,one_mul]
  | mixed => simp only [pairedCoefficients,oppositeBaseExponent,oddPart,pow_zero,one_smul]

theorem paired_moment_eq_opposite_blockSum (r a : ℕ) (ha : a≤r)
    (c : MomentKind) (k : ℕ) :
    moment (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^r)
      (pairedCoefficients (fun _ : Fin n ↦ (1 : R))
        (fun i ↦ (MvPolynomial.X i)^a) (fun i ↦ (MvPolynomial.X i)^(r-a)) c) k=
      blockSum (oppositeExponent r a c k) c := by
  have hcoeff := funext (pairedCoefficients_opposite (R := R) (n := n) r a ha c)
  rw [hcoeff,moment_local_monomials]
  unfold blockSum localBlock
  apply Finset.sum_congr rfl
  intro i hi
  congr 2
  cases c <;> simp [oppositeBaseExponent,oppositeExponent,Nat.mul_add,Nat.add_comm]

/-- Every paired moment generator is a genuine positive wreath invariant.
This is one direction of the intended equality, not a claim of completion. -/
theorem pairedMomentIdeal_le_positiveInvariantIdeal (r a : ℕ) (hr : 0<r) (ha : a≤r) :
    pairedIdeal (fun _ : Fin n ↦ (1 : R))
      (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^r)
      (fun i ↦ (MvPolynomial.X i)^a) (fun i ↦ (MvPolynomial.X i)^(r-a))≤
        positiveInvariantIdeal (R := R) (n := n) (r := r) a (r-a) := by
  apply TwoSidedIdeal.span_le.mpr
  rintro _ ⟨⟨c,k⟩,rfl⟩
  dsimp only
  rw [paired_moment_eq_opposite_blockSum r a ha]
  exact blockSum_mem_positiveInvariantIdeal a (r-a) _ c
    (oppositeExponent_weight_dvd r a ha c k) (oppositeExponent_positive r a hr c k)

/-- The strict-family exponents for trivial exterior cyclic characters. -/
def strictExponent (r : ℕ) : MomentKind → ℕ → ℕ
  | .polynomial,k => r*(k+1)
  | _,k => r*k

theorem strictCoefficients_one (r : ℕ) (c : MomentKind) (i : Fin n) :
    strictCoefficients (fun _ : Fin n ↦ (1 : R))
      (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^r) c i=
      (MvPolynomial.X i : PolynomialRing R n)^(if c=.polynomial then r else 0) •
        oddPart (R := R) c i := by
  cases c <;> simp [strictCoefficients,oddPart]

theorem strict_moment_eq_blockSum (r : ℕ) (c : MomentKind) (k : ℕ) :
    moment (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^r)
      (strictCoefficients (fun _ : Fin n ↦ (1 : R))
        (fun i ↦ (MvPolynomial.X i)^r) c) k=
      blockSum (strictExponent r c k) c := by
  have hcoeff := funext (strictCoefficients_one (R := R) (n := n) r c)
  rw [hcoeff,moment_local_monomials]
  unfold blockSum localBlock
  apply Finset.sum_congr rfl
  intro i hi
  congr 2
  cases c <;> simp [strictExponent,Nat.mul_add]

/-- The strict moments also lie in the independently defined positive
invariant ideal, with both exterior characters genuinely trivial. -/
theorem strictMomentIdeal_le_positiveInvariantIdeal (r : ℕ) (hr : 0<r) :
    strictIdeal (fun _ : Fin n ↦ (1 : R))
      (fun i ↦ (MvPolynomial.X i : PolynomialRing R n)^r)≤
        positiveInvariantIdeal (R := R) (n := n) (r := r) 0 0 := by
  apply TwoSidedIdeal.span_le.mpr
  rintro _ ⟨⟨c,k⟩,rfl⟩
  dsimp only
  rw [strict_moment_eq_blockSum r c k]
  apply blockSum_mem_positiveInvariantIdeal 0 0 _ c
  · cases c <;> simp [strictExponent,oddWeight]
  · cases c
    · exact Or.inl (Nat.mul_pos hr (Nat.succ_pos k))
    all_goals exact Or.inr (by decide)

end PaperVerification.Fermion.Coinvariants
end
end
end BatchFile_433

section BatchFile_434
/- Literal source: PaperVerification/FermionCoinvariantMonomials.lean -/


/-!
# Original supermonomials, occupied indices and local factorization

All support and cyclic-weight data belong to the
actual polynomial/exterior basis. Products use the genuine exterior shuffle
sign, including the zero case. The local factorization uses an actual unit
and erases exactly one occupied coordinate, so its induction measure strictly
decreases without discarding exterior signs or polynomial exponents.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators TensorProduct

namespace PaperVerification.Fermion.Coinvariants

variable {R : Type*} [CommRing R] {n : ℕ}

/-- The original index of either labelled odd generator. -/
def oddSite : OddIndex n → Fin n := Sum.elim id id

def oddLocalWeight (p q : ℕ) (i : Fin n) : OddIndex n → ℕ
  | .inl j => if j=i then p else 0
  | .inr j => if j=i then q else 0

/-- The character exponent at one original index. -/
def localDegree (p q : ℕ) (z : SuperMonomialIndex n) (i : Fin n) : ℕ :=
  z.1 i+∑ j∈z.2,oddLocalWeight p q i j

/-- A position is occupied by an even positive power or by either odd label. -/
def occupied (z : SuperMonomialIndex n) : Finset (Fin n) :=
  z.1.support ∪ z.2.image oddSite

@[simp] theorem mem_occupied (z : SuperMonomialIndex n) (i : Fin n) :
    i∈occupied z ↔ z.1 i≠0 ∨ Sum.inl i∈z.2 ∨ Sum.inr i∈z.2 := by
  simp only [occupied,Finset.mem_union,Finsupp.mem_support_iff,Finset.mem_image]
  constructor
  · rintro (h|⟨j,hj,he⟩)
    · exact Or.inl h
    · cases j with
      | inl j =>
          have hji : j=i := he
          subst j
          exact Or.inr (Or.inl hj)
      | inr j =>
          have hji : j=i := he
          subst j
          exact Or.inr (Or.inr hj)
  · rintro (h|h|h)
    · exact Or.inl h
    · exact Or.inr ⟨.inl i,h,rfl⟩
    · exact Or.inr ⟨.inr i,h,rfl⟩

/-- The actual four possible local exterior subsets. -/
def blockOddSet (a : MomentKind) (i : Fin n) : Finset (OddIndex n) :=
  match a with
  | .polynomial => ∅
  | .theta => {.inl i}
  | .xi => {.inr i}
  | .mixed => {.inl i,.inr i}

def localKind (T : Finset (OddIndex n)) (i : Fin n) : MomentKind :=
  if Sum.inl i∈T then (if Sum.inr i∈T then .mixed else .theta)
  else if Sum.inr i∈T then .xi else .polynomial

def localIndex (d : ℕ) (a : MomentKind) (i : Fin n) : SuperMonomialIndex n :=
  (Finsupp.single i d,blockOddSet a i)

def eraseIndex (z : SuperMonomialIndex n) (i : Fin n) : SuperMonomialIndex n :=
  (z.1.erase i,z.2.filter (fun j ↦ oddSite j≠i))

def joinIndex (z t : SuperMonomialIndex n) : SuperMonomialIndex n :=
  (z.1+t.1,z.2∪t.2)

@[simp] theorem occupied_join (z t : SuperMonomialIndex n) :
    occupied (joinIndex z t)=occupied z∪occupied t := by
  ext i
  simp only [mem_occupied,joinIndex,Finsupp.add_apply,Finset.mem_union]
  have hzero : z.1 i+t.1 i≠0 ↔ z.1 i≠0 ∨ t.1 i≠0 := by omega
  rw [hzero]
  tauto

@[simp] theorem occupied_eraseIndex (z : SuperMonomialIndex n) (i : Fin n) :
    occupied (eraseIndex z i)=(occupied z).erase i := by
  ext j
  simp only [mem_occupied,eraseIndex,Finsupp.erase_apply,Finset.mem_filter,
    oddSite,Finset.mem_erase]
  by_cases h : j=i
  · subst j; simp
  · simp [h,Ne.symm h]

theorem localKind_set (T : Finset (OddIndex n)) (i : Fin n) :
    blockOddSet (localKind T i) i=T.filter (fun j ↦ oddSite j=i) := by
  ext j
  cases j with
  | inl j =>
      by_cases hji : j=i
      · subst j
        by_cases ht : Sum.inl i∈T <;> by_cases hz : Sum.inr i∈T <;>
          simp [localKind,blockOddSet,ht,hz,oddSite]
      · by_cases ht : Sum.inl i∈T <;> by_cases hz : Sum.inr i∈T <;>
          simp [localKind,blockOddSet,ht,hz,oddSite,hji,Ne.symm hji]
  | inr j =>
      by_cases hji : j=i
      · subst j
        by_cases ht : Sum.inl i∈T <;> by_cases hz : Sum.inr i∈T <;>
          simp [localKind,blockOddSet,ht,hz,oddSite]
      · by_cases ht : Sum.inl i∈T <;> by_cases hz : Sum.inr i∈T <;>
          simp [localKind,blockOddSet,ht,hz,oddSite,hji,Ne.symm hji]

theorem localIndex_disjoint_erase (z : SuperMonomialIndex n) (i : Fin n) :
    Disjoint (localIndex (z.1 i) (localKind z.2 i) i).2 (eraseIndex z i).2 := by
  rw [localIndex,localKind_set]
  exact Finset.disjoint_filter_filter_not _ _ _

@[simp] theorem join_local_erase (z : SuperMonomialIndex n) (i : Fin n) :
    joinIndex (localIndex (z.1 i) (localKind z.2 i) i) (eraseIndex z i)=z := by
  apply Prod.ext
  · ext j
    by_cases h : j=i
    · subst j; simp [joinIndex,localIndex,eraseIndex]
    · simp [joinIndex,localIndex,eraseIndex,Finsupp.single_apply,h,Ne.symm h]
  · simp only [joinIndex,localIndex,eraseIndex,localKind_set]
    exact Finset.filter_union_filter_not_eq _ _

theorem occupied_localIndex_subset (d : ℕ) (a : MomentKind) (i : Fin n) :
    occupied (localIndex d a i)⊆{i} := by
  intro j hj
  rw [mem_occupied] at hj
  by_contra hji
  have hne : j≠i := by simpa using hji
  rcases hj with h|h|h
  · simpa [localIndex,Finsupp.single_apply,hne,Ne.symm hne] using h
  · cases a <;> simpa [localIndex,blockOddSet,hne,Ne.symm hne] using h
  · cases a <;> simpa [localIndex,blockOddSet,hne,Ne.symm hne] using h

theorem localKind_positive {z : SuperMonomialIndex n} {i : Fin n}
    (hi : i∈occupied z) : 0<z.1 i ∨ localKind z.2 i≠.polynomial := by
  rcases mem_occupied z i |>.mp hi with h|h|h
  · exact Or.inl (Nat.pos_of_ne_zero h)
  · exact Or.inr (by by_cases ht : Sum.inr i∈z.2 <;> simp [localKind,h,ht])
  · exact Or.inr (by by_cases ht : Sum.inl i∈z.2 <;> simp [localKind,ht,h])

theorem localDegree_join (p q : ℕ) (z t : SuperMonomialIndex n)
    (h : Disjoint z.2 t.2) (i : Fin n) :
    localDegree p q (joinIndex z t) i=localDegree p q z i+localDegree p q t i := by
  simp only [localDegree,joinIndex,Finsupp.add_apply,Finset.sum_union h]
  omega

@[simp] theorem localDegree_localIndex (p q d : ℕ) (a : MomentKind) (i j : Fin n) :
    localDegree p q (localIndex d a i) j=
      if i=j then d+oddWeight p q a else 0 := by
  by_cases h : i=j
  · subst j
    cases a <;> simp [localDegree,localIndex,blockOddSet,oddLocalWeight,oddWeight]
  · cases a <;>
      simp [localDegree,localIndex,blockOddSet,oddLocalWeight,oddWeight,h,Ne.symm h]

theorem localDegree_eraseIndex (p q : ℕ) (z : SuperMonomialIndex n) (i j : Fin n) :
    localDegree p q (eraseIndex z i) j=if j=i then 0 else localDegree p q z j := by
  by_cases hji : j=i
  · subst j
    simp only [localDegree,eraseIndex,Finsupp.erase_same,zero_add,if_pos rfl]
    apply Finset.sum_eq_zero
    intro k hk
    have h := (Finset.mem_filter.mp hk).2
    cases k <;> simp_all [oddLocalWeight,oddSite]
  · rw [if_neg hji]
    unfold localDegree eraseIndex
    rw [Finsupp.erase_ne hji]
    congr 1
    apply Finset.sum_subset (Finset.filter_subset _ _)
    intro k hk hnot
    have he : oddSite k=i := by simpa only [Finset.mem_filter,hk,true_and,not_not] using hnot
    cases k <;> simp_all [oddLocalWeight,oddSite,Ne.symm hji]

theorem localDegree_at_eq (p q : ℕ) (z : SuperMonomialIndex n) (i : Fin n) :
    localDegree p q z i=z.1 i+oddWeight p q (localKind z.2 i) := by
  have h := localDegree_join p q
    (localIndex (z.1 i) (localKind z.2 i) i) (eraseIndex z i)
    (localIndex_disjoint_erase z i) i
  rw [join_local_erase,localDegree_localIndex,localDegree_eraseIndex,
    if_pos rfl,if_pos rfl,add_zero] at h
  exact h

section ActualProducts

local instance coinvariantMonomialOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' Exterior.modeRank Exterior.modeRank_injective

/-- Disjoint original exterior labels produce precisely a shuffle-sign unit. -/
theorem basis_mul_unit (z t : SuperMonomialIndex n) (h : Disjoint z.2 t.2) :
    ∃ ε : Rˣ,superMonomialBasis (K := R) z*superMonomialBasis t=
      (ε : R) • superMonomialBasis (joinIndex z t) := by
  let S : Set.powersetCard (OddIndex n) z.2.card := ⟨z.2,rfl⟩
  let T : Set.powersetCard (OddIndex n) t.2.card := ⟨t.2,rfl⟩
  let sign : ℤˣ := (Set.powersetCard.permOfDisjoint (s := S) (t := T) h).sign
  let ε : Rˣ := Units.map (Int.castRingHom R).toMonoidHom sign
  refine ⟨ε,?_⟩
  rw [superMonomialBasis_apply,superMonomialBasis_apply,
    Algebra.TensorProduct.tmul_mul_tmul,MvPolynomial.monomial_mul_monomial,one_mul,
    ExteriorAlgebra.basis_mul_of_disjoint (Pi.basisFun R (OddIndex n)) S T h,
    Set.powersetCard.coe_disjUnion,Finset.disjUnion_eq_union]
  change MvPolynomial.monomial (z.1+t.1) 1 ⊗ₜ[R]
    (sign • (Pi.basisFun R (OddIndex n)).ExteriorAlgebra (z.2∪t.2))=_
  have hε : (ε : R)=((sign : ℤ) : R) := rfl
  rw [hε,superMonomialBasis_apply]
  let p : PolynomialRing R n := MvPolynomial.monomial (z.1+t.1) 1
  let w : ExteriorAlgebra R (OddModule R n) :=
    (Pi.basisFun R (OddIndex n)).ExteriorAlgebra (z.2∪t.2)
  have hcast : sign • w=((sign : ℤ) : R) • w := by
    rw [Units.smul_def]
    exact (Int.cast_smul_eq_zsmul R (sign : ℤ) w).symm
  change p ⊗ₜ[R] (sign • w)=((sign : ℤ) : R) • (p ⊗ₜ[R] w)
  exact (congrArg (fun y : ExteriorAlgebra R (OddModule R n) ↦ p ⊗ₜ[R] y) hcast).trans
    (TensorProduct.tmul_smul ((sign : ℤ) : R) p w)

/-- Repeated original exterior labels give zero, not a new basis word. -/
theorem basis_mul_zero (z t : SuperMonomialIndex n) (h : ¬Disjoint z.2 t.2) :
    superMonomialBasis (K := R) z*superMonomialBasis t=0 := by
  rw [superMonomialBasis_apply,superMonomialBasis_apply,
    Algebra.TensorProduct.tmul_mul_tmul,
    ExteriorAlgebra.basis_mul_of_not_disjoint (Pi.basisFun R (OddIndex n))
      (⟨z.2,rfl⟩ : Set.powersetCard (OddIndex n) z.2.card)
      (⟨t.2,rfl⟩ : Set.powersetCard (OddIndex n) t.2.card) h,
    TensorProduct.tmul_zero]

private theorem basis_empty :
    (Pi.basisFun R (OddIndex n)).ExteriorAlgebra (∅ : Finset (OddIndex n))=1 := by
  rw [Module.Basis.exteriorAlgebra_eq_prod_map_sort]
  simp

private theorem basis_inl (i : Fin n) :
    (Pi.basisFun R (OddIndex n)) (.inl i)=Pi.single (.inl i) 1 := by
  funext j
  cases j <;> simp [Pi.basisFun_apply,Pi.single_apply]

private theorem basis_inr (i : Fin n) :
    (Pi.basisFun R (OddIndex n)) (.inr i)=Pi.single (.inr i) 1 := by
  funext j
  cases j <;> simp [Pi.basisFun_apply,Pi.single_apply]

/-- The local algebra factor is exactly the original supermonomial basis vector. -/
theorem localBlock_eq_basis (d : ℕ) (a : MomentKind) (i : Fin n) :
    localBlock (R := R) d a i=superMonomialBasis (localIndex d a i) := by
  rw [superMonomialBasis_apply]
  have he : even (R := R) i^d=
      Algebra.TensorProduct.includeLeft (R := R) (S := R)
        (MvPolynomial.monomial (Finsupp.single i d) (1:R)) := by
    rw [←MvPolynomial.X_pow_eq_monomial,map_pow]
    rfl
  rw [localBlock,he]
  cases a with
  | polynomial =>
      simp only [oddPart,localIndex,blockOddSet,basis_empty,mul_one,
        Algebra.TensorProduct.includeLeft_apply]
  | theta =>
      rw [show (localIndex d .theta i).2={Sum.inl i} from rfl,
        TauCeti.ExteriorAlgebra.basis_singleton,basis_inl]
      simp only [oddPart,theta,localIndex,Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.includeRight_apply,Algebra.TensorProduct.tmul_mul_tmul,mul_one,one_mul]
  | xi =>
      rw [show (localIndex d .xi i).2={Sum.inr i} from rfl,
        TauCeti.ExteriorAlgebra.basis_singleton,basis_inr]
      simp only [oddPart,xi,localIndex,Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.includeRight_apply,Algebra.TensorProduct.tmul_mul_tmul,mul_one,one_mul]
  | mixed =>
      have hi : @LT.lt (OddIndex n) coinvariantMonomialOrder.toLT (Sum.inl i) (Sum.inr i) := by
        change Exterior.modeRank (.inl i)<Exterior.modeRank (.inr i)
        simp only [Exterior.modeRank]
        omega
      have hpair : (Pi.basisFun R (OddIndex n)).ExteriorAlgebra
          (localIndex d .mixed i).2=
          ExteriorAlgebra.ι R ((Pi.basisFun R (OddIndex n)) (.inl i))*
            ExteriorAlgebra.ι R ((Pi.basisFun R (OddIndex n)) (.inr i)) := by
        convert TauCeti.ExteriorAlgebra.basis_pair (Pi.basisFun R (OddIndex n)) hi using 1 <;>
          congr 1 <;> ext j <;> simp [localIndex,blockOddSet]
      rw [hpair,basis_inl,basis_inr]
      simp only [oddPart,theta,xi,localIndex,Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.includeRight_apply,Algebra.TensorProduct.tmul_mul_tmul,
        mul_one,one_mul,mul_assoc]

/-- Removing one occupied coordinate gives a unit-valued, exact factorization. -/
theorem local_factorization (z : SuperMonomialIndex n) (i : Fin n) :
    ∃ ε : Rˣ,localBlock (R := R) (z.1 i) (localKind z.2 i) i*
      superMonomialBasis (eraseIndex z i)=(ε:R) • superMonomialBasis z := by
  rw [localBlock_eq_basis]
  obtain ⟨ε,hε⟩ := basis_mul_unit (R := R)
    (localIndex (z.1 i) (localKind z.2 i) i) (eraseIndex z i)
    (localIndex_disjoint_erase z i)
  exact ⟨ε,by simpa only [join_local_erase] using hε⟩

end ActualProducts
end PaperVerification.Fermion.Coinvariants
end
end
end BatchFile_434

section BatchFile_435
/- Literal source: PaperVerification/FermionCoinvariantBasisAction.lean -/


/-!
# Actual monomial actions and cyclic-compatible coefficients

The diagonal eigenvalue and pointwise-support
stabilizer formulas are derived from the actual local factorization. The
augmentation coefficient is proved from the original augmentation. Primitive
roots then force precisely the printed coordinatewise divisibilities over a
field, without assuming an invariant-basis theorem.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators TensorProduct

namespace PaperVerification.Fermion.Coinvariants

variable {R : Type*} [CommRing R] {n : ℕ}

local instance coinvariantBasisActionOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' Exterior.modeRank Exterior.modeRank_injective

def emptyIndex : SuperMonomialIndex n := (0,∅)

@[simp] theorem occupied_eq_empty (z : SuperMonomialIndex n) :
    occupied z=∅ ↔ z=emptyIndex := by
  rw [occupied,Finset.union_eq_empty,Finset.image_eq_empty,Finsupp.support_eq_empty]
  constructor
  · intro h
    exact Prod.ext h.1 h.2
  · intro h
    subst z
    exact ⟨rfl,rfl⟩

@[simp] theorem emptyIndex_basis : superMonomialBasis (K := R) (emptyIndex (n := n))=1 := by
  rw [superMonomialBasis_apply]
  simp [emptyIndex,Module.Basis.exteriorAlgebra_eq_prod_map_sort,
    Algebra.TensorProduct.one_def]

/-- A permutation fixing every occupied original index fixes the actual word,
including its exterior ordering and polynomial exponents. -/
theorem permutation_basis_of_fix (z : SuperMonomialIndex n)
    (σ : Equiv.Perm (Fin n)) (hσ : ∀ i∈occupied z,σ i=i) :
    permutation (R := R) σ (superMonomialBasis z)=superMonomialBasis z := by
  suffices h : ∀ k : ℕ,∀ z : SuperMonomialIndex n,(occupied z).card=k →
      ∀ σ : Equiv.Perm (Fin n),(∀ i∈occupied z,σ i=i) →
        permutation (R := R) σ (superMonomialBasis z)=superMonomialBasis z from
    h _ z rfl σ hσ
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
      intro z hk σ hσ
      by_cases hz : occupied z=∅
      · rw [(occupied_eq_empty z).mp hz,emptyIndex_basis,map_one]
      obtain ⟨i,hi⟩ := Finset.nonempty_iff_ne_empty.mpr hz
      obtain ⟨ε,hε⟩ := local_factorization (R := R) z i
      have hr : (occupied (eraseIndex z i)).card<k := by
        rw [occupied_eraseIndex,←hk]
        exact Finset.card_erase_lt_of_mem hi
      have hs : ∀ j∈occupied (eraseIndex z i),σ j=j := by
        rw [occupied_eraseIndex]
        intro j hj
        exact hσ j (Finset.mem_erase.mp hj).2
      have H := congrArg (permutation (R := R) σ) hε
      rw [map_mul,permutation_localBlock,hσ i hi,
        ih _ hr _ rfl σ hs,map_smul] at H
      apply ε.isUnit.smul_left_cancel.mp
      exact H.symm.trans hε

/-- The original augmentation kills every nonconstant original basis vector. -/
theorem augmentation_basis_nonempty (z : SuperMonomialIndex n)
    (hz : (occupied z).Nonempty) : augmentation (superMonomialBasis (K := R) z)=0 := by
  obtain ⟨i,hi⟩ := hz
  obtain ⟨ε,hε⟩ := local_factorization (R := R) z i
  have H := congrArg (augmentation (R := R) (n := n)) hε
  rw [map_mul,augmentation_localBlock _ _ _ (localKind_positive hi),
    zero_mul,map_smul] at H
  apply ε.isUnit.smul_left_cancel.mp
  exact H.symm.trans (smul_zero _).symm

/-- Positivity is exactly vanishing of the original constant basis coefficient. -/
theorem augmentation_eq_empty_coefficient (x : SuperRing R n) :
    augmentation x=(superMonomialBasis (K := R)).repr x emptyIndex := by
  have he : (augmentation (R := R) (n := n)).toLinearMap=
      (superMonomialBasis (K := R)).coord emptyIndex := by
    apply (superMonomialBasis (K := R)).ext
    intro z
    by_cases hz : z=emptyIndex
    · subst z
      rw [AlgHom.toLinearMap_apply,Module.Basis.coord_apply,
        Module.Basis.repr_self,Finsupp.single_eq_same,emptyIndex_basis,map_one]
    · have hn : (occupied z).Nonempty := Finset.nonempty_iff_ne_empty.mpr
        (fun h ↦ hz ((occupied_eq_empty z).mp h))
      rw [AlgHom.toLinearMap_apply,augmentation_basis_nonempty z hn,
        Module.Basis.coord_apply,Module.Basis.repr_self,Finsupp.single_apply,if_neg hz]
  exact LinearMap.congr_fun he x

def diagonalAt (c : Rˣ) (i : Fin n) : Fin n → Rˣ := fun j ↦ if j=i then c else 1

theorem diagonalAt_localBlock (p q : ℕ) (c : Rˣ) (i j : Fin n)
    (d : ℕ) (a : MomentKind) :
    diagonal p q (diagonalAt c i) (localBlock (R := R) d a j)=
      (c : R)^(if j=i then d+oddWeight p q a else 0) • localBlock d a j := by
  rw [diagonal_localBlock]
  by_cases h : j=i <;> simp [diagonalAt,h]

/-- The diagonal eigenvalue is the actual local character exponent. -/
theorem diagonalAt_basis (p q : ℕ) (c : Rˣ) (i : Fin n) (z : SuperMonomialIndex n) :
    diagonal p q (diagonalAt c i) (superMonomialBasis (K := R) z)=
      (c : R)^localDegree p q z i • superMonomialBasis z := by
  suffices h : ∀ k : ℕ,∀ z : SuperMonomialIndex n,(occupied z).card=k →
      diagonal p q (diagonalAt c i) (superMonomialBasis (K := R) z)=
        (c : R)^localDegree p q z i • superMonomialBasis z from h _ z rfl
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
      intro z hk
      by_cases hz : occupied z=∅
      · rw [(occupied_eq_empty z).mp hz,emptyIndex_basis,map_one]
        simp [localDegree,emptyIndex]
      obtain ⟨j,hj⟩ := Finset.nonempty_iff_ne_empty.mpr hz
      obtain ⟨ε,hε⟩ := local_factorization (R := R) z j
      have hr : (occupied (eraseIndex z j)).card<k := by
        rw [occupied_eraseIndex,←hk]
        exact Finset.card_erase_lt_of_mem hj
      have hd : localDegree p q z i=
          (if j=i then z.1 j+oddWeight p q (localKind z.2 j) else 0)+
            localDegree p q (eraseIndex z j) i := by
        have he := localDegree_join p q
          (localIndex (z.1 j) (localKind z.2 j) j) (eraseIndex z j)
          (localIndex_disjoint_erase z j) i
        simpa only [join_local_erase,localDegree_localIndex] using he
      have H := congrArg (diagonal p q (diagonalAt c i)) hε
      rw [map_mul,diagonalAt_localBlock,ih _ hr _ rfl,smul_mul_smul_comm,
        ←pow_add,←hd,hε,map_smul] at H
      apply ε.isUnit.smul_left_cancel.mp
      exact H.symm.trans (smul_comm _ _ _)

/-- The literal coordinate functional sees the same diagonal eigenvalue. -/
theorem diagonalAt_coefficient (p q : ℕ) (c : Rˣ) (i : Fin n)
    (z : SuperMonomialIndex n) (x : SuperRing R n) :
    (superMonomialBasis (K := R)).repr (diagonal p q (diagonalAt c i) x) z=
      (c : R)^localDegree p q z i*(superMonomialBasis (K := R)).repr x z := by
  let b := superMonomialBasis (K := R) (n := n)
  have he : (b.coord z).comp (diagonal p q (diagonalAt c i)).toLinearMap=
      (c : R)^localDegree p q z i • b.coord z := by
    apply b.ext
    intro t
    change b.repr (diagonal p q (diagonalAt c i) (b t)) z=
      (c : R)^localDegree p q z i*b.repr (b t) z
    rw [diagonalAt_basis,map_smul,Module.Basis.repr_self,Finsupp.smul_apply,
      Finsupp.single_apply]
    by_cases ht : t=z
    · subst t; simp
    · simp [ht]
  exact LinearMap.congr_fun he x

theorem wreath_invariant_permutation {r p q : ℕ} {x : SuperRing R n}
    (hx : ∀ g : WreathGroup R n r,wreathAction p q g x=x)
    (σ : Equiv.Perm (Fin n)) : permutation σ x=x := by
  have h := hx ⟨1,σ⟩
  change diagonal p q (fun i ↦ ((1 : Fin n → rootsOfUnity r R) i : Rˣ))
    (permutation σ x)=x at h
  simp only [Pi.one_apply,OneMemClass.coe_one] at h
  change diagonal p q (1 : Fin n → Rˣ) (permutation σ x)=x at h
  rwa [diagonal_one,AlgEquiv.one_apply] at h

theorem wreath_invariant_diagonalAt {r p q : ℕ} {x : SuperRing R n}
    (hx : ∀ g : WreathGroup R n r,wreathAction p q g x=x)
    (c : rootsOfUnity r R) (i : Fin n) : diagonal p q (diagonalAt (c : Rˣ) i) x=x := by
  have h := hx ⟨(fun j ↦ if j=i then c else 1),1⟩
  change diagonal p q (fun j ↦ ((if j=i then c else 1 : rootsOfUnity r R) : Rˣ))
    (permutation 1 x)=x at h
  rw [permutation_one,AlgEquiv.one_apply] at h
  have he : (fun j ↦ ((if j=i then c else 1 : rootsOfUnity r R) : Rˣ))=
      diagonalAt (c : Rˣ) i := by
    funext j
    by_cases hj : j=i <;> simp [diagonalAt,hj]
  rwa [he] at h

section Field

variable {F : Type*} [Field F] {r p q : ℕ}

/-- A nonzero coefficient of a true invariant has every required cyclic
weight divisible by r. The only field step cancels that nonzero coefficient. -/
theorem invariant_coefficient_compatible (ζ : Fˣ) (hζ : IsPrimitiveRoot (ζ : F) r)
    (x : SuperRing F n) (hx : ∀ g : WreathGroup F n r,wreathAction p q g x=x)
    (z : SuperMonomialIndex n) (hz : (superMonomialBasis (K := F)).repr x z≠0)
    (i : Fin n) : r∣localDegree p q z i := by
  let c : rootsOfUnity r F := ⟨ζ,(mem_rootsOfUnity' r ζ).mpr hζ.pow_eq_one⟩
  have he := congrArg (fun y : SuperRing F n ↦ (superMonomialBasis (K := F)).repr y z)
    (wreath_invariant_diagonalAt hx c i)
  rw [diagonalAt_coefficient] at he
  have hpow : (ζ : F)^localDegree p q z i=1 := by
    apply mul_right_cancel₀ hz
    simpa only [one_mul] using he
  exact (hζ.pow_eq_one_iff_dvd _).mp hpow

end Field
end PaperVerification.Fermion.Coinvariants
end
end
