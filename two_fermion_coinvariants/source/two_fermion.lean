      _ 0 (polynomial_hasTop_zero_weight _) (pairedMomentWord z.2.1.1 i) z.1 z.2.2
    have hw : superMonomialWeight (fun _ : Fin n ↦ 0) (fun _ : OddIndex n ↦ 1)=
