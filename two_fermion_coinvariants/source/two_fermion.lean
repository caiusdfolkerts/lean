  -- UTF-8 slices avoid allocating a list of every character in a large graph.
  -- Even JSON escaping of 65,536 characters is below the guarded 512 KiB cap.
  let emitDocument : String → Json → CommandElabM Nat := fun documentTag document => do
    let encoded := document.compress
    let chunkCount := (encoded.length + 65535) / 65536
    let mut remaining := encoded.toSlice
    let mut sequence := 0
    while remaining.utf8ByteSize > 0 do
      let payload := (remaining.take 65536).copy
      remaining := remaining.drop 65536
      let envelope := Json.mkObj [
        ("audit_spec_sha256", toJson auditSpecHash),
        ("document", toJson documentTag), ("sequence", toJson sequence),
        ("chunk_count", toJson chunkCount),
        ("document_utf8_bytes", toJson encoded.utf8ByteSize),
        ("data", toJson payload)]
      let message := envelope.compress
      if message.utf8ByteSize > 524288 then
        throwError "Audit log chunk exceeded its 512 KiB limit."
      logInfo m!"FERMION_AUDIT_CHUNK_V1 {message}"
      sequence := sequence + 1
    unless sequence == chunkCount do
      throwError "Audit log chunk count mismatch."
    return sequence

  if requiredTheorems.isEmpty then
    throwError "The principal theorem list must not be empty."
  for name in requiredTheorems do
    unless inspectBody name do
      throwError "Principal theorem is not in the current literal proof module: {name}"
    let some (.thmInfo _) := env.checked.get.find? name
      | throwError "Principal target is not an actual kernel-checked theorem: {name}"
  for name in requiredDefinitions ++ supportingDefinitions do
    unless inspectBody name do
      throwError "Requested construction or definition is outside the actual-body module: {name}"
    let some info := env.checked.get.find? name
      | throwError "Requested construction or definition is missing: {name}"
    unless (info.value? (allowOpaque := true)).isSome do
      throwError "Requested construction or definition has no actual body: {name}"

  let authored ← env.constants.foldM (init := #[]) fun names name _ => do
    return if inspectBody name && !name.isInternalDetail then names.push name else names
  let authored := authored.qsort Name.quickLt
  if authored.isEmpty then
    throwError "No authored mathematical declarations are present."
  let mut failures : Array String := #[]
  let mut stockRows : Array Json := #[]
  for name in requiredTheorems ++ requiredDefinitions do
    let axioms ← collectAxioms name
    for ax in axioms do
      unless allowed ax do
        failures := failures.push s!"Principal stock axiom check {name}: {ax}"
    stockRows := stockRows.push <| Json.mkObj [
      ("name", toJson name.toString),
      ("transitive_axioms", toJson (axioms.map Name.toString))]

  -- All public mathematical declarations are roots, not just the endpoints.
  -- Private proof helpers are reached through the actual expressions. Each
  -- expression body is visited once, including opaque and theorem bodies.
  let mut todo := authored ++ requiredTheorems ++ requiredDefinitions ++ supportingDefinitions
  let mut seen : Std.HashSet Name := {}
  let mut nodeIds : Std.HashMap Name Nat := {}
  let mut actualAxioms : Std.HashSet Name := {}
  let mut missing : Array String := #[]
  let mut actualGraph : Array Json := #[]
  let mut boundaryRows : Array Json := #[]
  while !todo.isEmpty do
    let name := todo.back!
    todo := todo.pop
    if !seen.contains name then
      seen := seen.insert name
      if !nodeIds.contains name then
        nodeIds := nodeIds.insert name nodeIds.size
      let nodeId := nodeIds[name]!
      match env.checked.get.find? name with
      | none => missing := missing.push name.toString
      | some info =>
        if inspectBody name then
          let mut deps := info.type.getUsedConstants
          let kind := match info with
            | .thmInfo _ => "theorem"
            | .axiomInfo _ => "axiom"
            | .defnInfo _ => "definition"
            | .opaqueInfo _ => "opaque"
            | .inductInfo _ => "inductive"
            | .ctorInfo _ => "constructor"
            | .recInfo _ => "recursor"
            | .quotInfo _ => "quotient primitive"
          match info with
          | .axiomInfo _ =>
            actualAxioms := actualAxioms.insert name
            unless allowed name do
              failures := failures.push s!"Authored/vendor axiom or missing body: {name}"
          | .defnInfo v => deps := deps ++ v.value.getUsedConstants
          | .thmInfo v => deps := deps ++ v.value.getUsedConstants
          | .opaqueInfo v => deps := deps ++ v.value.getUsedConstants
          | .inductInfo v => deps := deps ++ v.ctors.toArray
          | _ => pure ()
          -- Dependency multiplicity has no logical significance. Preserve
          -- every distinct edge, recording its named node by a dense index.
          let uniqueDeps := (deps.foldl (fun (names : Std.HashSet Name) dep => names.insert dep)
            ({} : Std.HashSet Name)).toArray.qsort Name.quickLt
          let mut dependencyIds : Array Nat := #[]
          for dep in uniqueDeps do
            if !nodeIds.contains dep then
              nodeIds := nodeIds.insert dep nodeIds.size
            dependencyIds := dependencyIds.push nodeIds[dep]!
          todo := todo ++ uniqueDeps
          actualGraph := actualGraph.push <| Json.mkObj [
            ("name", toJson name.toString), ("kind", toJson kind),
            ("id", toJson nodeId), ("module", toJson (moduleFor name).toString),
            ("dependencies", toJson dependencyIds)]
        else
          unless trustedBoundary name do
            failures := failures.push s!"Unexpected imported dependency module {(moduleFor name)}: {name}"
          let axioms ← collectAxioms name
          for ax in axioms do
            actualAxioms := actualAxioms.insert ax
            unless allowed ax do
              failures := failures.push s!"Pinned library boundary {name}: {ax}"
          boundaryRows := boundaryRows.push <| Json.mkObj [
            ("name", toJson name.toString), ("id", toJson nodeId),
            ("module", toJson (moduleFor name).toString),
            ("transitive_axioms", toJson (axioms.map Name.toString))]
  for name in missing do
    failures := failures.push s!"Missing actual dependency: {name}"
  let actualAxiomNames := actualAxioms.toArray.qsort Name.quickLt

  -- Contracts retain every explicit, implicit and instance binder.
  let contract : Name → ConstantInfo → CommandElabM Json := fun name info =>
    liftTermElabM <| Meta.forallTelescope info.type fun xs conclusion => do
      let mut binders : Array Json := #[]
      for x in xs do
        let d ← Meta.getFVarLocalDecl x
        let kind := match d.binderInfo with
          | .default => "explicit"
          | .implicit => "implicit"
          | .strictImplicit => "strict implicit"
          | .instImplicit => "instance implicit"
        binders := binders.push <| Json.mkObj [
          ("name", toJson d.userName.toString), ("binder_kind", toJson kind),
          ("type", toJson (← Meta.ppExpr d.type).pretty)]
      pure <| Json.mkObj [
        ("name", toJson name.toString), ("type", toJson (← Meta.ppExpr info.type).pretty),
        ("universe_parameters", toJson (info.levelParams.map Name.toString)),
        ("all_outer_binders", toJson binders),
        ("conclusion", toJson (← Meta.ppExpr conclusion).pretty)]
  let mut principalRows : Array Json := #[]
  for name in requiredTheorems ++ requiredDefinitions do
    let some info := env.checked.get.find? name
      | throwError "Principal declaration disappeared: {name}"
    principalRows := principalRows.push (← contract name info)

  let mut structureRows : Array Json := #[]
  for name in structures do
    unless inspectBody name do
      throwError "Parameter structure is outside the literal proof module: {name}"
    let mut fields : Array Json := #[]
    for field in getStructureFields env name do
      let some fi := getFieldInfo? env name field
        | throwError "Missing parameter field metadata: {name}.{field}"
      let some info := env.checked.get.find? fi.projFn
        | throwError "Missing parameter projection: {fi.projFn}"
      fields := fields.push <| Json.mkObj [
        ("field", toJson field.toString), ("projection", toJson fi.projFn.toString),
        ("contract", ← contract fi.projFn info)]
    if fields.isEmpty then
      throwError "Requested parameter structure has no inspected fields: {name}"
    structureRows := structureRows.push <| Json.mkObj [
      ("name", toJson name.toString), ("all_direct_fields", toJson fields)]

  let mut definitionRows : Array Json := #[]
  for name in supportingDefinitions do
    let some info := env.checked.get.find? name
      | throwError "Supporting definition is missing: {name}"
    let some value := info.value? (allowOpaque := true)
      | throwError "Supporting definition has no actual body: {name}"
    let bodyText ← liftTermElabM <| return (← Meta.ppExpr value).pretty
    definitionRows := definitionRows.push <| Json.mkObj [
      ("name", toJson name.toString), ("contract", ← contract name info),
      ("body", toJson bodyText)]

  let metadata := Json.mkObj [
    ("audit_spec_sha256", toJson auditSpecHash),
    ("current_literal_module", toJson env.mainModule.toString),
    ("required_theorems", toJson (requiredTheorems.map Name.toString)),
    ("required_constructions", toJson (requiredDefinitions.map Name.toString)),
    ("read_from_checked_environment", toJson true),
    ("all_public_authored_declarations_are_traversal_roots", toJson true),
    ("authored_root_count", toJson authored.size),
    ("actual_body_traversal_to_trusted_library_boundary", toJson true),
    ("trusted_library_module_prefixes", toJson (trustedPrefixes.map Name.toString)),
    ("imported_modules", toJson (env.allImportedModuleNames.map Name.toString)),
    ("traversed_constant_count", toJson seen.size),
    ("dependency_encoding", toJson "node-indices-v1"),
    ("indexed_node_count", toJson nodeIds.size),
    ("actual_body_count", toJson actualGraph.size),
    ("boundary_count", toJson boundaryRows.size),
    ("actual_foundational_axioms", toJson (actualAxiomNames.map Name.toString)),
    ("missing_actual_dependencies", toJson missing),
    ("unapproved_dependency_occurrences", toJson failures)]
  let mut chunks : Array Json := #[]
  for (tag, document) in #[
      ("metadata", metadata),
      ("stock_principal_axioms", toJson stockRows),
      ("actual_dependency_graph", toJson actualGraph),
      ("library_boundary", toJson boundaryRows),
      ("principal_contracts", toJson principalRows),
      ("parameter_structures", toJson structureRows),
      ("independent_definitions", toJson definitionRows)] do
    let count ← emitDocument tag document
    chunks := chunks.push <| Json.mkObj [("document", toJson tag), ("chunks", toJson count)]
  unless failures.isEmpty do
    throwError "Standalone audit rejected {failures.size} dependency problems."
  let complete := Json.mkObj [
    ("audit_spec_sha256", toJson auditSpecHash), ("result", toJson "passed"),
    ("required_theorem_count", toJson requiredTheorems.size),
    ("required_construction_count", toJson requiredDefinitions.size),
    ("independent_definition_count", toJson supportingDefinitions.size),
    ("traversed_constant_count", toJson seen.size), ("documents", toJson chunks)]
  logInfo m!"FERMION_AUDIT_COMPLETE_V1 {complete.compress}"
