        (d.map (algebraMap R S)).a (d.map (algebraMap R S)).b :=
  quotientBaseChangeEquivOfSpans (superBaseChangeEquiv R S)
    ((pairedIdeal d.beta d.phi d.a d.b).ringCon.mkₐ R).toLinearMap
