  induction b using ENat.recTopCoe with
  | top => simp_all
  | coe b =>
    induction a using ENat.recTopCoe with
    | top => simp at h₂
    | coe a =>
      norm_cast at h₂ ⊢
      rcases min_le_iff.mp h₁ with h | h <;> norm_cast at h <;> omega

