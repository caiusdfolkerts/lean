    rw [AlgEquiv.apply_symm_apply]
    convert (tensorTwoSidedQuotientEquiv_tmul_mk (R := PolynomialRing F n)
      (S := d.O.Ordinary) (A := SuperRing F n)
      d.superIdeal 1 (theta F n i)).symm using 1 <;> rfl
