section BatchFile_53
/- Literal source: PaperVerification/FermionNewtonNumerators.lean -/


/-!
# The common-numerator matrix of the literal Newton columns

The matrix is defined by genuine polynomial representatives after clearing
the full negative denominator. Their existence and coordinate divisibility
are proved from the actual interpolation and residue formulas. Injectivity
of the polynomial embedding makes the representatives unique.
-/

@[expose] public section

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial
open scoped BigOperators Matrix

variable {F : Type*} [Field F] {n : ℕ}

theorem newtonColumn_active_formula
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k : Fin n)
    (hk : k ∈ activeInterval δ i) :
    newtonColumn β δ σ i k =
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) ((columnNumerator δ σ i).eval (X k)) /
        algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (starDenominator k (earlierNegative σ i)) := by
  rw [newtonColumn, rationalColumn, if_pos hk]
  rw [show rationalNode (F := F) k =
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (X k) from rfl,
    Polynomial.eval_map_apply, map_starDenominator]
  simp only [Lagrange.nodal, Polynomial.eval_prod, Polynomial.eval_sub,
    Polynomial.eval_X, Polynomial.eval_C, rationalNode]

theorem newtonColumn_residue_formula
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k : Fin n)
    (hk : k ∈ earlierNegative σ i) :
    newtonColumn β δ σ i k = ∑ l ∈ activeInterval δ i,
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (C (β l / β k)) *
        (algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) ((columnNumerator δ σ i).eval (X k)) /
          algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n))
            (starDenominator k ((earlierNegative σ i).erase k) * (X k - X l))) := by
  have hna : k ∉ activeInterval δ i := fun ha ↦
    Finset.disjoint_left.mp (activeInterval_disjoint_earlierNegative δ σ i) ha hk
  rw [newtonColumn, rationalColumn, if_neg hna, if_pos hk, simpleResidue]
  rw [show rationalNode (F := F) k =
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (X k) from rfl,
    Polynomial.eval_map_apply]
  simp only [Lagrange.nodalWeight, Finset.prod_inv_distrib, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l hl
  have hC (a : F) :
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (C a) =
        algebraMap F (RationalFunctions (F := F) (n := n)) a :=
    (IsScalarTower.algebraMap_apply F (P (F := F) (n := n))
      (RationalFunctions (F := F) (n := n)) a).symm
  rw [map_mul, map_starDenominator, map_sub, hC, map_div₀]
  simp only [rationalNode, hC, div_eq_mul_inv, mul_inv_rev]
  ring

theorem newtonColumn_mem_cleared_coordinate
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) :
    newtonColumn β δ σ i k ∈
      clearedDivisibility (negativeDenominator σ) (X k ^ δ k) := by
  by_cases ha : k ∈ activeInterval δ i
  · rw [newtonColumn_active_formula β δ σ i k ha]
    apply fraction_mem_clearedDivisibility
    · exact active_denominator_dvd δ σ i k ha
    · apply starDenominator_ne_zero
      exact fun hn ↦ Finset.disjoint_left.mp (activeInterval_disjoint_earlierNegative δ σ i) ha hn
    · exact evaluated_numerator_coordinate_dvd δ σ i k
        (activeInterval_multiplicity_le δ i k ha)
  · by_cases hn : k ∈ earlierNegative σ i
    · rw [newtonColumn_residue_formula β δ σ i k hn]
      apply (clearedDivisibility (negativeDenominator σ) (X k ^ δ k)).sum_mem
      intro l hl
      rw [← Algebra.smul_def]
      apply (clearedDivisibility (negativeDenominator σ) (X k ^ δ k)).smul_mem
      apply fraction_mem_clearedDivisibility
      · exact residue_denominator_dvd δ σ i k l hn hl
      · apply mul_ne_zero (starDenominator_ne_zero k _ (Finset.notMem_erase k _))
        have hkl : k < l := ((mem_earlierNegative σ i k).mp hn).1.trans_le
          ((mem_activeInterval δ i l).mp hl).1
        exact sub_ne_zero.mpr (fun h ↦ (ne_of_lt hkl) (MvPolynomial.X_injective h))
      · exact evaluated_numerator_coordinate_dvd δ σ i k
          (earlierNegative_multiplicity_le δ σ hc i k hn)
    · have hz : newtonColumn β δ σ i k = 0 := by
        simp only [newtonColumn, rationalColumn, if_neg ha, if_neg hn]
      rw [hz]
      exact (clearedDivisibility _ _).zero_mem

def columnCommonNumerator
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) : P (F := F) (n := n) :=
  Classical.choose (newtonColumn_mem_cleared_coordinate β δ σ hc i k)

theorem columnCommonNumerator_coordinate_dvd
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) : X k ^ δ k ∣ columnCommonNumerator β δ σ hc i k :=
  (Classical.choose_spec (newtonColumn_mem_cleared_coordinate β δ σ hc i k)).1

theorem map_columnCommonNumerator
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) :
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (columnCommonNumerator β δ σ hc i k) =
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) * newtonColumn β δ σ i k :=
  (Classical.choose_spec (newtonColumn_mem_cleared_coordinate β δ σ hc i k)).2

theorem columnCommonNumerator_unique
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) (a : P (F := F) (n := n))
    (ha : algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) a =
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) * newtonColumn β δ σ i k) :
    a = columnCommonNumerator β δ σ hc i k :=
  IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n))
    (ha.trans (map_columnCommonNumerator β δ σ hc i k).symm)

def commonNumeratorMatrix
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ) :
    Matrix (Fin n) (Fin n) (P (F := F) (n := n)) :=
  fun k i ↦ columnCommonNumerator β δ σ hc i k

theorem commonNumeratorMatrix_map
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ) :
    (commonNumeratorMatrix β δ σ hc).map (algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n))) =
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) •
        (fun k i ↦ newtonColumn β δ σ i k :
          Matrix (Fin n) (Fin n) (RationalFunctions (F := F) (n := n))) := by
  ext k i
  exact map_columnCommonNumerator β δ σ hc i k

theorem commonNumeratorMatrix_det_ne_zero
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (hσ : ∀ i, σ i = -1 ∨ σ i = 0 ∨ σ i = 1)
    (hβ : ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)) :
    (commonNumeratorMatrix β δ σ hc).det ≠ 0 := by
  have hq : algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (negativeDenominator σ) ≠ 0 := by
    intro hz
    exact negativeDenominator_ne_zero σ
      (IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (by simpa using hz))
  intro hz
  have h := congrArg (algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n))) hz
  rw [map_zero, ← matrix_map_det,
    commonNumeratorMatrix_map, Matrix.det_smul, Fintype.card_fin] at h
  exact (mul_ne_zero (pow_ne_zero n hq) (newtonColumn_det_ne_zero F n δ σ β hc hσ hβ)) h

end PaperVerification.Fermion.Newton
end
end
end BatchFile_53

section BatchFile_54
/- Literal source: PaperVerification/FermionNewtonHyperplaneEvaluation.lean -/


/-!
# Divisibility detected by identifying two coordinates

The hyperplane tests below concern the actual polynomial numerator, not a
formal residue symbol. They reduce tangency and cancellation of opposite
simple poles to ordinary polynomial equalities after identifying the two
coordinates.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial
open scoped BigOperators

variable {F : Type*} [Field F] {n : ℕ}

def identifyCoordinates (i j : Fin n) : P (F := F) (n := n) →ₐ[F] (P (F := F) (n := n)) :=
  aeval fun k ↦ if k = i then X j else X k

@[simp] theorem identifyCoordinates_X (i j k : Fin n) :
    identifyCoordinates (F := F) i j (X k) = if k = i then X j else X k := by
  simp only [identifyCoordinates, aeval_X]

theorem identifyCoordinates_eq_comp (i j : Fin n) (hij : i ≠ j) :
    identifyCoordinates (F := F) i j =
      (coordinateRestriction i).comp (coordinateShear i j hij).symm.toAlgHom := by
  ext k
  by_cases hk : k = i
  · subst k
    simp [identifyCoordinates, coordinateRestriction, coordinateShear, hij, Ne.symm hij]
  · simp [identifyCoordinates, coordinateRestriction, coordinateShear, hk]

theorem identifyCoordinates_eq_zero_iff (i j : Fin n) (hij : i ≠ j) (p : P (F := F) (n := n)) :
    identifyCoordinates i j p = 0 ↔ (X i - X j) ∣ p := by
  rw [identifyCoordinates_eq_comp i j hij]
  change coordinateRestriction i ((coordinateShear i j hij).symm p) = 0 ↔ _
  rw [coordinateRestriction_eq_zero_iff]
  constructor
  · intro hp
    have h := map_dvd (coordinateShear (F := F) i j hij) hp
    simpa only [coordinateShear_X_self, AlgEquiv.apply_symm_apply] using h
  · intro hp
    rw [← coordinateShear_X_self i j hij] at hp
    have h := map_dvd (coordinateShear (F := F) i j hij).symm hp
    simpa only [AlgEquiv.symm_apply_apply] using h

theorem identifyCoordinates_self_sub (i j : Fin n) (hij : i ≠ j) :
    identifyCoordinates (F := F) i j (X i - X j) = 0 := by
  simp only [map_sub, identifyCoordinates_X, if_pos rfl, if_true, if_neg (Ne.symm hij), sub_self]

theorem identifyCoordinates_star_ne_zero
    (a b k j : Fin n) (hab : a ≠ b) (hkj : k ≠ j)
    (hnotpair : ¬ (k = a ∧ j = b) ∧ ¬ (k = b ∧ j = a)) :
    identifyCoordinates (F := F) a b (X k - X j) ≠ 0 := by
  rw [map_sub, identifyCoordinates_X, identifyCoordinates_X]
  intro hz
  have he : (if k = a then b else k) = (if j = a then b else j) := by
    apply MvPolynomial.X_injective (R := F)
    simpa only [apply_ite] using sub_eq_zero.mp hz
  by_cases hka : k = a
  · by_cases hja : j = a
    · exact hkj (hka.trans hja.symm)
    · simp only [hka, hja, if_true, if_false] at he
      exact hnotpair.1 ⟨hka, he.symm⟩
  · by_cases hja : j = a
    · simp only [hka, hja, if_false, if_true] at he
      exact hnotpair.2 ⟨he, hja⟩
    · simp only [hka, hja, if_false] at he
      exact hkj he

section AlgebraicTests

variable {R S : Type*} [CommRing R] [IsDomain R] [CommRing S] [IsDomain S]

/-- If a denominator does not vanish on a hyperplane, a common numerator
vanishes there whenever the common denominator does. -/
theorem numerator_vanishes_of_regular_denominator
    (φ : R →+* S) (Q N D A : R)
    (hA : D * A = Q * N) (hQ : φ Q = 0) (hD : φ D ≠ 0) : φ A = 0 := by
  have h := congrArg φ hA
  rw [map_mul, map_mul, hQ, zero_mul] at h
  exact (mul_eq_zero.mp h).resolve_left hD

/-- Equal evaluations of numerator and denominator give equal evaluations
of the cleared rational functions, without requiring the common denominator
itself to survive restriction. -/
theorem numerator_evaluations_eq_of_fraction_data
    (φ : R →+* S) (Q N₁ N₂ D₁ D₂ A₁ A₂ : R)
    (h₁ : D₁ * A₁ = Q * N₁) (h₂ : D₂ * A₂ = Q * N₂)
    (hD : φ D₁ ≠ 0) (hDeq : φ D₁ = φ D₂) (hNeq : φ N₁ = φ N₂) :
    φ A₁ = φ A₂ := by
  apply mul_left_cancel₀ hD
  have h₁' := congrArg φ h₁
  have h₂' := congrArg φ h₂
  simp only [map_mul] at h₁' h₂'
  rw [h₁', hDeq, h₂', hNeq]

/-- A single common factor is canceled in the polynomial ring before
restriction. This is the exact algebraic step behind a simple-pole residue. -/
theorem cancel_common_pole
    (p Q N D A : R) (hp : p ≠ 0)
    (h : (p * D) * A = (p * Q) * N) : D * A = Q * N := by
  apply mul_left_cancel₀ hp
  simpa only [mul_assoc] using h

/-- Opposite simple-pole denominators and matching weighted numerators
force the weighted numerator sum to vanish on the hyperplane. -/
theorem weighted_opposite_poles_cancel
    (φ : R →+* S) (p Q N₁ N₂ D₁ D₂ A₁ A₂ u v : R)
    (hp : p ≠ 0)
    (h₁ : (p * D₁) * A₁ = (p * Q) * N₁)
    (h₂ : ((-p) * D₂) * A₂ = (p * Q) * N₂)
    (hD : φ D₁ ≠ 0) (hDeq : φ D₁ = φ D₂)
    (hN : φ u * φ N₁ = φ v * φ N₂) :
    φ (u * A₁ + v * A₂) = 0 := by
  have h₁' := cancel_common_pole p Q N₁ D₁ A₁ hp h₁
  have h₂' : D₂ * A₂ = -(Q * N₂) := by
    apply mul_left_cancel₀ hp
    have he : p * (D₂ * A₂) = -(p * (Q * N₂)) := by
      have hneg := congrArg Neg.neg h₂
      simpa only [neg_mul, mul_assoc, neg_neg] using hneg
    simpa only [mul_neg] using he
  apply (mul_eq_zero.mp (show φ D₁ * φ (u * A₁ + v * A₂) = 0 from ?_)).resolve_left hD
  have h₁m := congrArg φ h₁'
  have h₂m := congrArg φ h₂'
  simp only [map_mul, map_neg] at h₁m h₂m
  rw [map_add, map_mul, map_mul, mul_add]
  calc
    φ D₁ * (φ u * φ A₁) + φ D₁ * (φ v * φ A₂) =
        φ u * (φ D₁ * φ A₁) + φ v * (φ D₂ * φ A₂) := by rw [← hDeq]; ring
    _ = φ Q * (φ u * φ N₁ - φ v * φ N₂) := by rw [h₁m, h₂m]; ring
    _ = 0 := by rw [hN, sub_self, mul_zero]

end AlgebraicTests

end PaperVerification.Fermion.Newton
end
end
end BatchFile_54

section BatchFile_55
/- Literal source: PaperVerification/FermionNewtonLocalNumerators.lean -/


/-!
# Explicit numerator terms and the off-pair normal conditions

The chosen common numerator is identified with the polynomial quotients
clearing each actual denominator. For a negative hyperplane, every row outside
its two endpoints has only denominators that remain nonzero after restriction;
its numerator is therefore divisible by that hyperplane equation.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Newton

open MvPolynomial
open scoped BigOperators

variable {F : Type*} [Field F] {n : ℕ}

def clearedFractionNumerator (Q N D : P (F := F) (n := n)) (hD : D ∣ Q) : P (F := F) (n := n) :=
  Classical.choose hD * N

theorem clearedFractionNumerator_relation (Q N D : P (F := F) (n := n)) (hD : D ∣ Q) :
    D * clearedFractionNumerator Q N D hD = Q * N := by
  rw [clearedFractionNumerator, ← mul_assoc, ← Classical.choose_spec hD]

theorem map_clearedFractionNumerator (Q N D : P (F := F) (n := n)) (hD : D ∣ Q) (hD0 : D ≠ 0) :
    algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (clearedFractionNumerator Q N D hD) =
      algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) Q *
        (algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) N /
          algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) D) := by
  have h := congrArg (algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)))
    (clearedFractionNumerator_relation Q N D hD)
  simp only [map_mul] at h
  have hd : algebraMap (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) D ≠ 0 := by
    intro hz
    exact hD0 (IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n)) (by simpa using hz))
  apply mul_left_cancel₀ hd
  rw [h]
  field_simp [hd]
  <;> ring

def activeNumerator (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k : Fin n)
    (hk : k ∈ activeInterval δ i) : P (F := F) (n := n) :=
  clearedFractionNumerator (negativeDenominator σ) ((columnNumerator δ σ i).eval (X k))
    (starDenominator k (earlierNegative σ i)) (active_denominator_dvd δ σ i k hk)

def residueNumerator (δ : Fin n → ℕ) (σ : Fin n → ℤ) (i k l : Fin n)
    (hk : k ∈ earlierNegative σ i) (hl : l ∈ activeInterval δ i) : P (F := F) (n := n) :=
  clearedFractionNumerator (negativeDenominator σ) ((columnNumerator δ σ i).eval (X k))
    (starDenominator k ((earlierNegative σ i).erase k) * (X k - X l))
    (residue_denominator_dvd δ σ i k l hk hl)

theorem columnCommonNumerator_eq_active
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) (hk : k ∈ activeInterval δ i) :
    columnCommonNumerator β δ σ hc i k = activeNumerator δ σ i k hk := by
  apply Eq.symm
  apply columnCommonNumerator_unique
  rw [newtonColumn_active_formula β δ σ i k hk]
  exact map_clearedFractionNumerator _ _ _ _ (starDenominator_ne_zero k _
    (fun hn ↦ Finset.disjoint_left.mp (activeInterval_disjoint_earlierNegative δ σ i) hk hn))

theorem columnCommonNumerator_eq_residue_sum
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) (hk : k ∈ earlierNegative σ i) :
    columnCommonNumerator β δ σ hc i k =
      ∑ l : activeInterval δ i, C (β l.val / β k) * residueNumerator δ σ i k l.val hk l.property := by
  apply Eq.symm
  apply columnCommonNumerator_unique
  rw [newtonColumn_residue_formula β δ σ i k hk, map_sum, Finset.mul_sum,
    ← Finset.sum_coe_sort (activeInterval δ i)]
  apply Finset.sum_congr rfl
  intro l hl
  rw [map_mul]
  unfold residueNumerator
  rw [map_clearedFractionNumerator]
  · ring
  · apply mul_ne_zero (starDenominator_ne_zero k _ (Finset.notMem_erase k _))
    have hkl : k < l.val := ((mem_earlierNegative σ i k).mp hk).1.trans_le
      ((mem_activeInterval δ i l.val).mp l.property).1
    exact sub_ne_zero.mpr (fun h ↦ (ne_of_lt hkl) (MvPolynomial.X_injective h))

theorem columnCommonNumerator_eq_zero_of_outside
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i k : Fin n) (ha : k ∉ activeInterval δ i) (hn : k ∉ earlierNegative σ i) :
    columnCommonNumerator β δ σ hc i k = 0 := by
  apply IsFractionRing.injective (P (F := F) (n := n)) (RationalFunctions (F := F) (n := n))
  rw [map_columnCommonNumerator]
  simp only [newtonColumn, rationalColumn, if_neg ha, if_neg hn, mul_zero, map_zero]

theorem identifyCoordinates_starDenominator_ne_zero
    (a b k : Fin n) (hab : a ≠ b) (hka : k ≠ a) (hkb : k ≠ b)
    (T : Finset (Fin n)) (hself : k ∉ T) :
    identifyCoordinates (F := F) a b (starDenominator k T) ≠ 0 := by
  rw [starDenominator, map_prod]
  apply Finset.prod_ne_zero_iff.mpr
  intro j hj
  exact identifyCoordinates_star_ne_zero a b k j hab
    (fun h ↦ hself (by simpa only [h] using hj))
    ⟨fun h ↦ hka h.1, fun h ↦ hkb h.1⟩

theorem identifyCoordinates_negativeDenominator_eq_zero
    (σ : Fin n → ℤ) (e : Edge n) (he : σ e.1.1 = -1) :
    identifyCoordinates (F := F) e.1.1 e.1.2 (negativeDenominator σ) = 0 := by
  apply (identifyCoordinates_eq_zero_iff e.1.1 e.1.2 (ne_of_lt e.2) _).mpr
  exact edgeLinear_dvd_negativeDenominator σ e he

/-- The full normal condition away from the two endpoints, for each
literal common-numerator column. -/
theorem columnCommonNumerator_negative_other_dvd
    (β : Fin n → F) (δ : Fin n → ℕ) (σ : Fin n → ℤ) (hc : Compatible δ σ)
    (i : Fin n) (e : Edge n) (he : σ e.1.1 = -1)
    (k : Fin n) (hka : k ≠ e.1.1) (hkb : k ≠ e.1.2) :
    edgeLinear e ∣ columnCommonNumerator β δ σ hc i k := by
  apply (identifyCoordinates_eq_zero_iff e.1.1 e.1.2 (ne_of_lt e.2) _).mp
  let φ := (identifyCoordinates (F := F) e.1.1 e.1.2).toRingHom
  have hQ : φ (negativeDenominator σ) = 0 :=
    identifyCoordinates_negativeDenominator_eq_zero σ e he
  by_cases ha : k ∈ activeInterval δ i
