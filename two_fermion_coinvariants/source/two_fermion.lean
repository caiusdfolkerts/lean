/- Literal source: PaperVerification/FermionOddPresentation.lean -/


/-!
# The genuine odd relation ideals over the local coefficient algebra

-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical BigOperators

namespace PaperVerification.Fermion

inductive LocalOddFamily
  | theta
  | xi
  | mixed
  deriving DecidableEq

instance : Fintype LocalOddFamily where
  elems := {.theta,.xi,.mixed}
  complete x := by cases x <;> simp

theorem span_family_killed_iff {C D τ : Type*} [Ring C] [Ring D]
    (gen : τ → C) (q : C →+* D) :
    (∀ x∈TwoSidedIdeal.span (Set.range gen),q x=0) ↔ ∀ i,q (gen i)=0 := by
  constructor
  · intro h i
    exact h _ (TwoSidedIdeal.subset_span ⟨i,rfl⟩)
  · intro h
    have hle : TwoSidedIdeal.span (Set.range gen)≤
        TwoSidedIdeal.ofRingCon (RingCon.ker q) := by
      apply TwoSidedIdeal.span_le.mpr
      rintro x ⟨i,rfl⟩
      change q (gen i)=q 0
      simpa only [map_zero] using h i
    intro x hx
    have he := hle hx
    change q x=q 0 at he
    simpa only [map_zero] using he

variable {A B ι κ : Type*} [CommRing A] [Ring B] [Algebra A B]
  [Fintype ι] [Fintype κ]

def separatedOddCurrent (node beta a b : ι → A) (family : LocalOddFamily) (k : ℕ) :
    ClusterExterior A ι :=
  match family with
  | .theta => ∑ i,node i^k • (b i • clusterTheta i)
  | .xi => ∑ i,node i^k • ((beta i*a i) • clusterXi i)
  | .mixed => ∑ i,node i^k • (clusterTheta i*clusterXi i)

def separatedOddIdeal (node beta a b : ι → A) : TwoSidedIdeal (ClusterExterior A ι) :=
  TwoSidedIdeal.span (Set.range (fun p : LocalOddFamily×ℕ ↦
    separatedOddCurrent node beta a b p.1 p.2))

abbrev SeparatedOddQuotient (node beta a b : ι → A) :=
  (separatedOddIdeal node beta a b).ringCon.Quotient

def clusterOddCurrent (cluster : ι → κ) (z beta : ι → A) (r u v : ι → ℕ)
    (family : LocalOddFamily) (c : κ) (k : ℕ) : ClusterExterior A ι :=
  match family with
  | .theta => ∑ i : {i : ι // cluster i=c},
      z i.1^(r i.1*k) • (z i.1^v i.1 • clusterTheta i.1)
  | .xi => ∑ i : {i : ι // cluster i=c},
      z i.1^(r i.1*k) • ((beta i.1*z i.1^u i.1) • clusterXi i.1)
  | .mixed => ∑ i : {i : ι // cluster i=c},
      z i.1^(r i.1*k) • (clusterTheta i.1*clusterXi i.1)

def clusterOddIdeal (cluster : ι → κ) (z beta : ι → A) (r u v : ι → ℕ) :
    TwoSidedIdeal (ClusterExterior A ι) :=
  TwoSidedIdeal.span (Set.range (fun p : κ×(LocalOddFamily×ℕ) ↦
    clusterOddCurrent cluster z beta r u v p.2.1 p.1 p.2.2))

abbrev ClusterOddQuotient (cluster : ι → κ) (z beta : ι → A) (r u v : ι → ℕ) :=
  (clusterOddIdeal cluster z beta r u v).ringCon.Quotient

theorem separatedOddIdeal_killed_iff (node beta a b : ι → A)
    (q : ClusterExterior A ι →ₐ[A] B) :
    (∀ x∈separatedOddIdeal node beta a b,q x=0) ↔
      HasSeparatedOddCurrents node beta a b
        (fun i ↦ q (clusterTheta i)) (fun i ↦ q (clusterXi i))
        (fun i ↦ q (clusterTheta i)*q (clusterXi i)) := by
  change (∀ x∈TwoSidedIdeal.span (Set.range
    (fun p : LocalOddFamily×ℕ ↦ separatedOddCurrent node beta a b p.1 p.2)),
      q.toRingHom x=0) ↔ _
  rw [span_family_killed_iff]
  change (∀ p : LocalOddFamily×ℕ,q (separatedOddCurrent node beta a b p.1 p.2)=0) ↔ _
  constructor
  · intro h
    exact ⟨fun k ↦ by simpa only [separatedOddCurrent,map_sum,map_smul,map_mul] using h (.theta,k),
      fun k ↦ by simpa only [separatedOddCurrent,map_sum,map_smul,map_mul] using h (.xi,k),
      fun k ↦ by simpa only [separatedOddCurrent,map_sum,map_smul,map_mul] using h (.mixed,k)⟩
  · rintro ⟨ht,hx,hm⟩ ⟨family,k⟩
    cases family
    · simpa only [separatedOddCurrent,map_sum,map_smul,map_mul] using ht k
    · simpa only [separatedOddCurrent,map_sum,map_smul,map_mul] using hx k
    · simpa only [separatedOddCurrent,map_sum,map_smul,map_mul] using hm k

theorem clusterOddIdeal_killed_iff (cluster : ι → κ) (z beta : ι → A) (r u v : ι → ℕ)
    (q : ClusterExterior A ι →ₐ[A] B) :
    (∀ x∈clusterOddIdeal cluster z beta r u v,q x=0) ↔
      HasClusterOddCurrents cluster z beta r u v
        (fun i ↦ q (clusterTheta i)) (fun i ↦ q (clusterXi i))
        (fun i ↦ q (clusterTheta i)*q (clusterXi i)) := by
  change (∀ x∈TwoSidedIdeal.span (Set.range
    (fun p : κ×(LocalOddFamily×ℕ) ↦
      clusterOddCurrent cluster z beta r u v p.2.1 p.1 p.2.2)),q.toRingHom x=0) ↔ _
  rw [span_family_killed_iff]
  change (∀ p : κ×(LocalOddFamily×ℕ),
    q (clusterOddCurrent cluster z beta r u v p.2.1 p.1 p.2.2)=0) ↔ _
  constructor
  · intro h
    exact ⟨fun c k ↦ by simpa only [clusterOddCurrent,map_sum,map_smul,map_mul] using h (c,.theta,k),
      fun c k ↦ by simpa only [clusterOddCurrent,map_sum,map_smul,map_mul] using h (c,.xi,k),
      fun c k ↦ by simpa only [clusterOddCurrent,map_sum,map_smul,map_mul] using h (c,.mixed,k)⟩
  · rintro ⟨ht,hx,hm⟩ ⟨c,family,k⟩
    cases family
    · simpa only [clusterOddCurrent,map_sum,map_smul,map_mul] using ht c k
    · simpa only [clusterOddCurrent,map_sum,map_smul,map_mul] using hx c k
    · simpa only [clusterOddCurrent,map_sum,map_smul,map_mul] using hm c k

end PaperVerification.Fermion
end
end
end BatchFile_461

section BatchFile_462
/- Literal source: PaperVerification/FermionOddNormalizationEquiv.lean -/


/-!
# The actual local odd normalization isomorphism

Both maps are induced on genuine two-sided quotient rings by inverse diagonal
exterior automorphisms. All three relation families, including the mixed
family, are checked using the full nilpotent-jet current equivalence.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical

namespace PaperVerification.Fermion

variable {F A B ι κ : Type*} [Field F] [CommRing A] [Algebra F A]
  [Ring B] [Algebra A B] [Fintype ι] [Fintype κ]

variable (G : Polynomial F) (hG : G≠0)
  (center : κ → F) (hc : Function.Injective center)
  (cluster : ι → κ) (node z beta a b : ι → A) (r u v : ι → ℕ)
  (hz : ∀ i,z i^r i=node i-algebraMap F A (center (cluster i)))
  (N : κ → ℕ)
  (hN : ∀ i,(node i-algebraMap F A (center (cluster i)))^(N (cluster i))=0)
  (unitA unitB : ι → Aˣ)
  (ha : ∀ i,a i=z i^u i*(unitA i : A))
  (hb : ∀ i,b i=z i^v i*(unitB i : A))
  (hAB : ∀ i,(unitA i : A)*(unitB i : A)=
    Polynomial.aeval (node i) (rootCofactor G (center (cluster i))))

include hG hc hz hN ha hb hAB in
theorem odd_normalization_kills_iff (q : ClusterExterior A ι →ₐ[A] B) :
    (∀ x∈separatedOddIdeal node beta a b,q x=0) ↔
      ∀ x∈clusterOddIdeal cluster z beta r u v,
        (q.comp (pairedOddUnitEquiv unitA unitB).toAlgHom) x=0 := by
  rw [separatedOddIdeal_killed_iff,clusterOddIdeal_killed_iff]
  simpa only [AlgHom.comp_apply,AlgEquiv.coe_toAlgHom,
    pairedOddUnitEquiv_theta,pairedOddUnitEquiv_xi,map_smul,
    smul_mul_smul_comm,mul_comm] using
    separated_odd_cluster_equivalence G hG center hc cluster node z beta a b r u v
      hz N hN unitA unitB ha hb hAB
      (fun i ↦ q (clusterTheta i)) (fun i ↦ q (clusterXi i))
      (fun i ↦ q (clusterTheta i)*q (clusterXi i))

/-- The isomorphism sends the old odd generators to the inversely rescaled
normalized generators and fixes the entire actual coefficient algebra. -/
def oddNormalizationEquiv :
    SeparatedOddQuotient node beta a b ≃ₐ[A]
      ClusterOddQuotient cluster z beta r u v := by
  let I := separatedOddIdeal node beta a b
  let J := clusterOddIdeal cluster z beta r u v
  let qI := I.ringCon.mkₐ A
  let qJ := J.ringCon.mkₐ A
  let e := pairedOddUnitEquiv unitA unitB
  let f : ClusterExterior A ι →ₐ[A] J.ringCon.Quotient := qJ.comp e.symm.toAlgHom
  have hf : ∀ x∈I,f x=0 := by
    apply (odd_normalization_kills_iff G hG center hc cluster node z beta a b r u v
      hz N hN unitA unitB ha hb hAB f).mpr
    intro x hx
    change qJ (e.symm (e x))=0
    rw [AlgEquiv.symm_apply_apply]
    exact quotientMk_eq_zero_of_mem J x hx
  let g : ClusterExterior A ι →ₐ[A] I.ringCon.Quotient := qI.comp e.toAlgHom
  have hg : ∀ x∈J,g x=0 :=
    (odd_normalization_kills_iff G hG center hc cluster node z beta a b r u v
      hz N hN unitA unitB ha hb hAB qI).mp
        (fun x hx ↦ quotientMk_eq_zero_of_mem I x hx)
  let fbar : I.ringCon.Quotient →ₐ[A] J.ringCon.Quotient :=
    I.ringCon.liftₐ f (ringCon_le_ker_of_kills I f hf)
  let gbar : J.ringCon.Quotient →ₐ[A] I.ringCon.Quotient :=
    J.ringCon.liftₐ g (ringCon_le_ker_of_kills J g hg)
  exact AlgEquiv.ofAlgHom fbar gbar
    (by
      apply RingCon.Quotient.hom_extₐ
      apply AlgHom.ext
      intro x
      change qJ (e.symm (e x))=qJ x
      rw [AlgEquiv.symm_apply_apply])
    (by
      apply RingCon.Quotient.hom_extₐ
      apply AlgHom.ext
      intro x
      change qI (e (e.symm x))=qI x
      rw [AlgEquiv.apply_symm_apply])

@[simp] theorem oddNormalizationEquiv_mk (x : ClusterExterior A ι) :
    oddNormalizationEquiv G hG center hc cluster node z beta a b r u v
      hz N hN unitA unitB ha hb hAB
      ((separatedOddIdeal node beta a b).ringCon.mkₐ A x)=
    (clusterOddIdeal cluster z beta r u v).ringCon.mkₐ A
      ((pairedOddUnitEquiv unitA unitB).symm x) := rfl

@[simp] theorem oddNormalizationEquiv_theta (i : ι) :
    oddNormalizationEquiv G hG center hc cluster node z beta a b r u v
      hz N hN unitA unitB ha hb hAB
      ((separatedOddIdeal node beta a b).ringCon.mkₐ A (clusterTheta i))=
    (↑((unitB i)⁻¹) : A) •
      (clusterOddIdeal cluster z beta r u v).ringCon.mkₐ A (clusterTheta i) := by
  rw [oddNormalizationEquiv_mk,pairedOddUnitEquiv_symm_theta,map_smul]

@[simp] theorem oddNormalizationEquiv_xi (i : ι) :
    oddNormalizationEquiv G hG center hc cluster node z beta a b r u v
      hz N hN unitA unitB ha hb hAB
      ((separatedOddIdeal node beta a b).ringCon.mkₐ A (clusterXi i))=
    (↑((unitA i)⁻¹) : A) •
      (clusterOddIdeal cluster z beta r u v).ringCon.mkₐ A (clusterXi i) := by
  rw [oddNormalizationEquiv_mk,pairedOddUnitEquiv_symm_xi,map_smul]

end PaperVerification.Fermion
end
end
end BatchFile_462

section BatchFile_463
/- Literal source: PaperVerification/FermionLocalPrefactors.lean -/


/-!
# Residual paired units in the actual local coefficient algebra

The paired product identity is proved first in F[X]. Its cofactor identity is
then evaluated, so the proof never cancels a nilpotent local coordinate.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace PaperVerification.Fermion

open Polynomial
open scoped Classical BigOperators

structure SeparatedPairedData (F : Type*) [Field F] (n : ℕ)
    extends SeparatedOrdinaryData F n where
  a : Fin n → Polynomial F
  b : Fin n → Polynomial F
  a_monic : ∀ i,(a i).Monic
  b_monic : ∀ i,(b i).Monic
  paired_product : ∀ i,a i*b i=G.comp (phi i)

theorem unit_coordinate_factorization {A : Type*} [CommRing A]
    (t : A) (w q : Aˣ) (m : ℕ) :
    (t*(w:A))^m*(↑(q*(w⁻¹)^m):A)=t^m*(q:A) := by
  have hw : (w:A)^m*(↑(w⁻¹):A)^m=1 := by
    rw [←mul_pow,Units.mul_inv,one_pow]
  simp only [mul_pow,Units.val_mul,Units.val_pow_eq_pow_val]
  calc
    t^m*(w:A)^m*((q:A)*(↑(w⁻¹):A)^m)=
        t^m*(q:A)*((w:A)^m*(↑(w⁻¹):A)^m) := by ring
    _=t^m*(q:A) := by rw [hw,mul_one]

namespace SeparatedPairedData

variable {F : Type*} [Field F] [CharZero F] [IsAlgClosed F] {n : ℕ}
variable (d : SeparatedPairedData F n)
variable (rho : d.toSeparatedOrdinaryData.SupportPoint)

abbrev O := d.toSeparatedOrdinaryData

def localA (i : Fin n) : d.O.LocalOrdinary rho :=
  Polynomial.aeval (d.O.localX rho i) (d.a i)

def localB (i : Fin n) : d.O.LocalOrdinary rho :=
  Polynomial.aeval (d.O.localX rho i) (d.b i)

def thetaOrder (i : Fin n) : ℕ := (d.a i).rootMultiplicity (rho.1 i)
def xiOrder (i : Fin n) : ℕ := (d.b i).rootMultiplicity (rho.1 i)

theorem local_exponent_balance (i : Fin n) :
    d.thetaOrder rho i+d.xiOrder rho i=
      d.O.ramificationOrder rho i*
        d.O.clusterMultiplicity rho (d.O.pointCluster rho i) :=
  paired_rootMultiplicity_balance d.G (d.phi i) (d.a i) (d.b i) (rho.1 i)
    d.G_monic.ne_zero (d.O.centered_phi_ne_zero rho i) (d.paired_product i)

def coordinateUnit (i : Fin n) : (d.O.LocalOrdinary rho)ˣ :=
  (d.O.coordinate rho i).evaluatedUnit
    (d.O.localCenteredX rho i) (d.O.localCenteredX_nilpotent rho i)

theorem local_cofactor_unit (p : Polynomial F) (hp : p≠0) (i : Fin n) :
    IsUnit (Polynomial.aeval (d.O.localX rho i) (rootCofactor p (rho.1 i))) := by
  apply (unit_iff_residue_ne_zero (F := F) (A := d.O.LocalOrdinary rho)
    (d.O.localResidue rho) _).mpr
  rw [←Polynomial.aeval_algHom_apply,d.O.localResidue_x]
  simpa only [Polynomial.aeval_def,Algebra.algebraMap_self,Polynomial.eval₂_id] using
    rootCofactor_eval_ne_zero p hp (rho.1 i)

def localUnitA (i : Fin n) : (d.O.LocalOrdinary rho)ˣ :=
  (d.local_cofactor_unit rho (d.a i) (d.a_monic i).ne_zero i).unit *
    (d.coordinateUnit rho i)⁻¹^d.thetaOrder rho i

def localUnitB (i : Fin n) : (d.O.LocalOrdinary rho)ˣ :=
  (d.local_cofactor_unit rho (d.b i) (d.b_monic i).ne_zero i).unit *
    (d.coordinateUnit rho i)⁻¹^d.xiOrder rho i

theorem localZ_eq_centered_mul_unit (i : Fin n) :
    d.O.localZ rho i=d.O.localCenteredX rho i*(d.coordinateUnit rho i : d.O.LocalOrdinary rho) :=
  (d.O.coordinate rho i).forward_eq_mul_unit _ _

theorem localA_factorization (i : Fin n) :
    d.localA rho i=d.O.localZ rho i^d.thetaOrder rho i*
      (d.localUnitA rho i : d.O.LocalOrdinary rho) := by
  rw [d.localZ_eq_centered_mul_unit,localUnitA]
  rw [unit_coordinate_factorization (d.O.localCenteredX rho i) (d.coordinateUnit rho i)
    (d.local_cofactor_unit rho (d.a i) (d.a_monic i).ne_zero i).unit
    (d.thetaOrder rho i)]
  rw [IsUnit.unit_spec]
  have he := congrArg (Polynomial.aeval (d.O.localX rho i))
    (rootCofactor_factorization (d.a i) (rho.1 i))
  simpa only [map_mul,map_pow,map_sub,Polynomial.aeval_X,Polynomial.aeval_C,
    thetaOrder,localA,SeparatedOrdinaryData.localCenteredX] using he.symm

theorem localB_factorization (i : Fin n) :
    d.localB rho i=d.O.localZ rho i^d.xiOrder rho i*
      (d.localUnitB rho i : d.O.LocalOrdinary rho) := by
  rw [d.localZ_eq_centered_mul_unit,localUnitB]
  rw [unit_coordinate_factorization (d.O.localCenteredX rho i) (d.coordinateUnit rho i)
    (d.local_cofactor_unit rho (d.b i) (d.b_monic i).ne_zero i).unit
    (d.xiOrder rho i)]
  rw [IsUnit.unit_spec]
  have he := congrArg (Polynomial.aeval (d.O.localX rho i))
    (rootCofactor_factorization (d.b i) (rho.1 i))
  simpa only [map_mul,map_pow,map_sub,Polynomial.aeval_X,Polynomial.aeval_C,
    xiOrder,localB,SeparatedOrdinaryData.localCenteredX] using he.symm

/-- The exact product identity for the two residual units. -/
theorem localUnit_product (i : Fin n) :
    (d.localUnitA rho i : d.O.LocalOrdinary rho)*
      (d.localUnitB rho i : d.O.LocalOrdinary rho)=
        Polynomial.aeval (d.O.localNode rho i)
          (rootCofactor d.G (d.O.clusterCenter rho (d.O.pointCluster rho i))) := by
  let w := d.coordinateUnit rho i
  let u := d.thetaOrder rho i
  let v := d.xiOrder rho i
  let r := d.O.ramificationOrder rho i
  let s := d.O.clusterMultiplicity rho (d.O.pointCluster rho i)
  let qa := Polynomial.aeval (d.O.localX rho i) (rootCofactor (d.a i) (rho.1 i))
  let qb := Polynomial.aeval (d.O.localX rho i) (rootCofactor (d.b i) (rho.1 i))
  let H := Polynomial.aeval (d.O.localNode rho i)
    (rootCofactor d.G ((d.phi i).eval (rho.1 i)))
  have hq : qa*qb=(w : d.O.LocalOrdinary rho)^(r*s)*H := by
    have he := congrArg (Polynomial.aeval (d.O.localX rho i))
      (paired_rootCofactor_product d.G (d.phi i) (d.a i) (d.b i) (rho.1 i)
        d.G_monic.ne_zero (d.O.centered_phi_ne_zero rho i) (d.paired_product i))
    have hw := (d.O.coordinate rho i).evaluatedUnit_power
      (d.O.localCenteredX rho i) (d.O.localCenteredX_nilpotent rho i)
    simp only [SeparatedOrdinaryData.localCenteredX,sub_add_cancel] at hw
    simpa only [map_mul,map_pow,Polynomial.aeval_comp,←hw,←pow_mul,
      qa,qb,w,coordinateUnit,r,s,H,O,SeparatedOrdinaryData.localCenteredX,
      SeparatedOrdinaryData.localNode,
      SeparatedOrdinaryData.ramificationOrder,SeparatedOrdinaryData.clusterMultiplicity,
      SeparatedOrdinaryData.pointCluster] using he
  have huv : u+v=r*s := d.local_exponent_balance rho i
  have hw : (w : d.O.LocalOrdinary rho)^(r*s)*
      (↑(w⁻¹) : d.O.LocalOrdinary rho)^(r*s)=1 := by
    rw [←mul_pow,Units.mul_inv,one_pow]
  change _=H
  simp only [localUnitA,localUnitB,Units.val_mul,Units.val_pow_eq_pow_val,IsUnit.unit_spec]
  change (qa*(↑(w⁻¹) : d.O.LocalOrdinary rho)^u)*
