  (d.globalSuperPolynomialBaseEquiv).symm.toAlgHom.comp
    ((tensorTwoSidedQuotientEquiv (R := PolynomialRing F n)
      (S := d.O.Ordinary) d.superIdeal).symm.toAlgHom.comp
