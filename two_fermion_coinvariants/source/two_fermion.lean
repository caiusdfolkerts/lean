    `PaperVerification.Fermion.Coinvariants.coinvariantPhysicalPiece,
    `PaperVerification.Fermion.PhysicalHilbert.exponent,
    `PaperVerification.Fermion.Coinvariants.oppositeHilbertPolynomial,
    `PaperVerification.Fermion.Coinvariants.trivialColorHilbertPolynomial,
    `PaperVerification.Fermion.Coinvariants.lentferTypeAUpper,
    `PaperVerification.Fermion.Coinvariants.lentferTypeBUpper
