module

public import PaperVerification.FermionMoments
public import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.Congruence.Basic
public import Mathlib.Algebra.MvPolynomial.Basic
public import Mathlib.Data.Finsupp.Fintype
public import Mathlib.Data.Finset.Sort
public import Mathlib.Data.Nat.Factorial.Basic
public import Mathlib.Data.Rat.Defs
public import Mathlib.Tactic.DeriveFintype
public import Mathlib.Tactic.Ring

/-!
# The actual two-fermion moment algebras

The ring in the paper is defined literally as a tensor product of the polynomial
ring with the exterior algebra on two copies of `Fin n`. The moment ideals are
two-sided ideals of that ring, not merely ideals of a commutative surrogate.

The statements `PairedBasisClaim` and `StrictBasisClaim` below record the basis
parts of Theorems 1.1 and 1.2. They are propositions, not theorems: this file does
not claim a proof of either statement. The finite-presentation theorems are proved.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.Fermion

open scoped BigOperators TensorProduct

universe u
variable (K : Type u) [CommRing K] (n : ℕ)

/-- The polynomial factor of the paper's algebra. -/
abbrev PolynomialRing := MvPolynomial (Fin n) K

/-- The two separately labelled exterior families. -/
abbrev OddIndex := Fin n ⊕ Fin n

/-- The free module on the exterior generators. -/
abbrev OddModule := OddIndex n → K

/-- The ambient algebra `K[x] ⊗ Λ(θ, ξ)`. -/
abbrev SuperRing := PolynomialRing K n ⊗[K] ExteriorAlgebra K (OddModule K n)

/-- Scalar multiplication descends to the literal ring-congruence quotient.

The additive group instance on a concrete tensor-product quotient is selected
before its semiring instance. Constructing this module directly along the
surjective quotient map avoids asking typeclass search to identify the two
paths through the additive structure. The operations are the canonical ones.
-/
@[reducible] noncomputable instance superQuotientModule (I : TwoSidedIdeal (SuperRing K n)) :
    Module K I.ringCon.Quotient := by
  let q : SuperRing K n →+ I.ringCon.Quotient :=
    { toFun := fun x ↦ (x : I.ringCon.Quotient)
      map_zero' := rfl
      map_add' := fun _ _ ↦ rfl }
  exact Function.Surjective.module K q
    (fun x ↦ I.ringCon.mk'_surjective x) (fun _ _ ↦ rfl)

/-- The inclusion of a theta generator into the tensor-product algebra. -/
noncomputable def theta (i : Fin n) : SuperRing K n :=
  Algebra.TensorProduct.includeRight
    (ExteriorAlgebra.ι K (Pi.single (Sum.inl i) 1))

/-- The inclusion of a xi generator into the tensor-product algebra. -/
noncomputable def xi (i : Fin n) : SuperRing K n :=
  Algebra.TensorProduct.includeRight
    (ExteriorAlgebra.ι K (Pi.single (Sum.inr i) 1))

/-- The four kinds of moments: polynomial, theta, xi, and mixed. -/
inductive MomentKind
  | polynomial | theta | xi | mixed
  deriving DecidableEq

instance : Fintype MomentKind where
  elems := {.polynomial, .theta, .xi, .mixed}
  complete x := by cases x <;> simp

variable {K n}

/-- Coefficients of the paired moment family, before multiplying by `φᵢᵏ`. -/
noncomputable def pairedCoefficients (β : Fin n → K)
    (a b : Fin n → PolynomialRing K n) : MomentKind → Fin n → SuperRing K n
  | .polynomial, i => (MvPolynomial.C (β i) * a i * b i) • (1 : SuperRing K n)
  | .theta, i => b i • theta K n i
  | .xi, i => (MvPolynomial.C (β i) * a i) • xi K n i
  | .mixed, i => theta K n i * xi K n i

/-- The two-sided ideal generated by all four paired moment families. -/
noncomputable abbrev pairedIdeal (β : Fin n → K)
    (φ a b : Fin n → PolynomialRing K n) : TwoSidedIdeal (SuperRing K n) :=
  momentIdeal φ (pairedCoefficients β a b)

/-- The paired quotient from Theorem 1.1. -/
abbrev PairedQuotient (β : Fin n → K) (φ a b : Fin n → PolynomialRing K n) :=
  (pairedIdeal β φ a b).ringCon.Quotient

/-- An exact finite presentation of the paired ideal, valid over every commutative ring. -/
theorem pairedIdeal_finite (β : Fin n → K) (φ a b : Fin n → PolynomialRing K n) :
    pairedIdeal β φ a b = finiteMomentIdeal φ (pairedCoefficients β a b) :=
  momentIdeal_eq_finite _ _

/-- Coefficients of the strict family. The ordinary coefficient includes one `φᵢ`,
so the index `k = 0` gives the first positive ordinary moment. -/
noncomputable def strictCoefficients (β : Fin n → K)
    (φ : Fin n → PolynomialRing K n) : MomentKind → Fin n → SuperRing K n
  | .polynomial, i => (MvPolynomial.C (β i) * φ i) • (1 : SuperRing K n)
  | .theta, i => theta K n i
  | .xi, i => (MvPolynomial.C (β i) : PolynomialRing K n) • xi K n i
  | .mixed, i => theta K n i * xi K n i

/-- The strict-height ideal from equation (4). -/
noncomputable abbrev strictIdeal (β : Fin n → K) (φ : Fin n → PolynomialRing K n) :
    TwoSidedIdeal (SuperRing K n) :=
  momentIdeal φ (strictCoefficients β φ)

/-- The strict quotient from Theorem 1.2. -/
abbrev StrictQuotient (β : Fin n → K) (φ : Fin n → PolynomialRing K n) :=
  (strictIdeal β φ).ringCon.Quotient

/-- An exact finite presentation of the strict ideal, valid over every commutative ring. -/
theorem strictIdeal_finite (β : Fin n → K) (φ : Fin n → PolynomialRing K n) :
    strictIdeal β φ = finiteMomentIdeal φ (strictCoefficients β φ) :=
  momentIdeal_eq_finite _ _

/-- The characteristic and subset-sum assumptions of equation (1). -/
def AllowedWeights (β : Fin n → K) : Prop :=
  IsUnit (n.factorial : K) ∧
    ∀ U : Finset (Fin n), U.Nonempty → IsUnit (∑ i ∈ U, β i)

/-- Rational weight of a polynomial monomial, with variable `i` having weight `1/rᵢ`. -/
def monomialWeight (r : Fin n → ℕ) (e : Fin n →₀ ℕ) : ℚ :=
  ∑ i, (e i : ℚ) / (r i : ℚ)

/-- The highest weighted form is exactly the monomial `xᵢᵈ`, with coefficient one. -/
def HasHighestPower (r : Fin n → ℕ) (p : PolynomialRing K n)
    (i : Fin n) (d : ℕ) : Prop :=
  p.coeff (Finsupp.single i d) = 1 ∧
    ∀ e ∈ p.support, e ≠ Finsupp.single i d →
      monomialWeight r e < (d : ℚ) / (r i : ℚ)

/-- Exact parameter hypotheses of the paired theorem, including all coupled lower terms. -/
structure PairedData where
  positive_n : 0 < n
  s : ℕ
  positive_s : 0 < s
  r : Fin n → ℕ
  u : Fin n → ℕ
  v : Fin n → ℕ
  positive_r : ∀ i, 0 < r i
  degree_split : ∀ i, u i + v i = r i * s
  beta : Fin n → K
  allowed_weights : AllowedWeights beta
  phi : Fin n → PolynomialRing K n
  a : Fin n → PolynomialRing K n
  b : Fin n → PolynomialRing K n
  highest_phi : ∀ i, HasHighestPower r (phi i) i (r i)
  highest_a : ∀ i, HasHighestPower r (a i) i (u i)
  highest_b : ∀ i, HasHighestPower r (b i) i (v i)

/-- Exact parameter hypotheses of the strict theorem. -/
structure StrictData where
  positive_n : 0 < n
  r : Fin n → ℕ
  positive_r : ∀ i, 0 < r i
  beta : Fin n → K
  allowed_weights : AllowedWeights beta
  phi : Fin n → PolynomialRing K n
  highest_phi : ∀ i, HasHighestPower r (phi i) i (r i)

/-- Number of the two exterior marks at an index. -/
def marks (T S : Finset (Fin n)) (i : Fin n) : ℕ :=
  (if i ∈ T then 1 else 0) + (if i ∈ S then 1 else 0)

/-- Arrival height after index `i`; Lean's indices start at zero. -/
def height (T S : Finset (Fin n)) (i : Fin n) : ℤ :=
  (i.val : ℤ) + 1 - ∑ j ∈ Finset.univ.filter (fun j ↦ j ≤ i), (marks T S j : ℤ)

/-- Height just before index `i`. -/
def previousHeight (T S : Finset (Fin n)) (i : Fin n) : ℤ :=
  (i.val : ℤ) - ∑ j ∈ Finset.univ.filter (fun j ↦ j < i), (marks T S j : ℤ)

/-- The preceding-height and arrival-height conventions agree exactly. -/
theorem height_eq_previousHeight (T S : Finset (Fin n)) (i : Fin n) :
    height T S i = previousHeight T S i + 1 - marks T S i := by
  have hi : i ∉ Finset.univ.filter (fun j : Fin n ↦ j < i) := by simp
  have hprefix : Finset.univ.filter (fun j : Fin n ↦ j ≤ i) =
      insert i (Finset.univ.filter (fun j : Fin n ↦ j < i)) := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
    exact le_iff_eq_or_lt
  simp only [height, previousHeight, hprefix, Finset.sum_insert hi]
  ring

/-- The exponent bound `rᵢ(s+cᵢ₋₁) - uᵢ tᵢ - vᵢ zᵢ` from Theorem 1.1. -/
def pairedBound (d : PairedData (K := K) (n := n))
    (T S : Finset (Fin n)) (i : Fin n) : ℤ :=
  (d.r i : ℤ) * ((d.s : ℤ) + previousHeight T S i) -
    (if i ∈ T then (d.u i : ℤ) else 0) -
    (if i ∈ S then (d.v i : ℤ) else 0)

theorem pairedBound_unmarked (d : PairedData (K := K) (n := n))
    (T S : Finset (Fin n)) (i : Fin n) (hT : i ∉ T) (hS : i ∉ S) :
    pairedBound d T S i = (d.r i : ℤ) * (height T S i + d.s - 1) := by
  rw [height_eq_previousHeight]
  simp only [pairedBound, marks, hT, hS, if_false, zero_add, Nat.cast_zero, sub_zero]
  ring

theorem pairedBound_theta (d : PairedData (K := K) (n := n))
    (T S : Finset (Fin n)) (i : Fin n) (hT : i ∈ T) (hS : i ∉ S) :
    pairedBound d T S i = (d.r i : ℤ) * height T S i + d.v i := by
  have hsplit : (d.u i : ℤ) + d.v i = (d.r i : ℤ) * d.s := by
    exact_mod_cast d.degree_split i
  rw [height_eq_previousHeight]
  simp only [pairedBound, marks, hT, hS, if_true, if_false, add_zero,
    Nat.cast_one, sub_zero, add_sub_cancel_right]
  calc
    _ = (d.r i : ℤ) * previousHeight T S i + ((d.r i : ℤ) * d.s - d.u i) := by ring
    _ = _ := by rw [← hsplit]; ring

theorem pairedBound_xi (d : PairedData (K := K) (n := n))
    (T S : Finset (Fin n)) (i : Fin n) (hT : i ∉ T) (hS : i ∈ S) :
    pairedBound d T S i = (d.r i : ℤ) * height T S i + d.u i := by
  have hsplit : (d.u i : ℤ) + d.v i = (d.r i : ℤ) * d.s := by
    exact_mod_cast d.degree_split i
  rw [height_eq_previousHeight]
  simp only [pairedBound, marks, hT, hS, if_true, if_false, zero_add,
    Nat.cast_one, sub_zero, add_sub_cancel_right]
  calc
    _ = (d.r i : ℤ) * previousHeight T S i + ((d.r i : ℤ) * d.s - d.v i) := by ring
    _ = _ := by rw [← hsplit]; ring

theorem pairedBound_double (d : PairedData (K := K) (n := n))
    (T S : Finset (Fin n)) (i : Fin n) (hT : i ∈ T) (hS : i ∈ S) :
    pairedBound d T S i = (d.r i : ℤ) * (height T S i + 1) := by
  have hsplit : (d.u i : ℤ) + d.v i = (d.r i : ℤ) * d.s := by
    exact_mod_cast d.degree_split i
  rw [height_eq_previousHeight]
  simp only [pairedBound, marks, hT, hS, if_true, Nat.cast_add, Nat.cast_one]
  calc
    _ = (d.r i : ℤ) * previousHeight T S i + ((d.r i : ℤ) * d.s - (d.u i + d.v i)) := by
      ring
    _ = _ := by rw [hsplit]; ring

/-- The proposed monomials are indexed by their exterior supports and polynomial exponents. -/
abbrev PairedIndex (d : PairedData (K := K) (n := n)) :=
  {z : (Finset (Fin n) × Finset (Fin n)) × (Fin n → ℕ) //
    (∀ i, 0 ≤ height z.1.1 z.1.2 i) ∧
    ∀ i, (z.2 i : ℤ) < pairedBound d z.1.1 z.1.2 i}

/-- The strict boxes use the strict arrival-height inequalities at every prefix. -/
abbrev StrictIndex (d : StrictData (K := K) (n := n)) :=
  {z : (Finset (Fin n) × Finset (Fin n)) × (Fin n → ℕ) //
    (∀ i, 1 ≤ height z.1.1 z.1.2 i) ∧
    ∀ i, (z.2 i : ℤ) < (d.r i : ℤ) * height z.1.1 z.1.2 i}

/-- The literal monomial `xᵉ θ_T ξ_S`, with increasing order within each color. -/
noncomputable def boxMonomial (T S : Finset (Fin n)) (e : Fin n → ℕ) : SuperRing K n :=
  MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm e) (1 : K) •
    ((T.sort.map (theta K n)).prod * (S.sort.map (xi K n)).prod)

/-- The proposed paired residue-class family. -/
noncomputable def pairedClasses (d : PairedData (K := K) (n := n))
    (z : PairedIndex d) : PairedQuotient d.beta d.phi d.a d.b :=
  (pairedIdeal d.beta d.phi d.a d.b).ringCon.mkₐ K
    (boxMonomial z.1.1.1 z.1.1.2 z.1.2)

/-- The proposed strict residue-class family. -/
noncomputable def strictClasses (d : StrictData (K := K) (n := n))
    (z : StrictIndex d) : StrictQuotient d.beta d.phi :=
  (strictIdeal d.beta d.phi).ringCon.mkₐ K
    (boxMonomial z.1.1.1 z.1.1.2 z.1.2)

/-- Exact basis assertion of Theorem 1.1, using the original monomial residue classes. -/
def PairedBasisClaim (d : PairedData (K := K) (n := n)) : Prop :=
  LinearIndependent K (pairedClasses d) ∧
    Submodule.span K (Set.range (pairedClasses d)) = ⊤

/-- Exact basis assertion of Theorem 1.2, using the original monomial residue classes. -/
def StrictBasisClaim (d : StrictData (K := K) (n := n)) : Prop :=
  LinearIndependent K (strictClasses d) ∧
    Submodule.span K (Set.range (strictClasses d)) = ⊤

end PaperVerification.Fermion
