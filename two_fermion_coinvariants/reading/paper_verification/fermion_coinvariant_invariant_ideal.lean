module

public import PaperVerification.FermionCoinvariantBasisAction
public import Mathlib.Algebra.BigOperators.Finsupp.Basic
public import Mathlib.GroupTheory.Perm.Fin

/-!
# The positive invariant ideal is generated by one-index block sums

The reverse inclusion is proved by strong
induction on the actual number of occupied original indices. Every collision
is expanded by the genuine exterior shuffle product and has strictly smaller
support. No orbit-sum basis, polarization theorem, invariant-generation
assertion or smaller-support hypothesis is assumed in the final statements.
The type-A statement works over every commutative ring in which n! is a unit.
The wreath statement uses a primitive root only to force the exact coordinate
character divisibilities of nonzero coefficients over a field.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators TensorProduct

namespace PaperVerification.Fermion.Coinvariants

variable {R : Type*} [CommRing R] {n r p q : ℕ}

local instance coinvariantInvariantIdealOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' Exterior.modeRank Exterior.modeRank_injective

/-- The proposed generating ideal is independent of the invariant ideal. -/
def blockIdeal (r p q : ℕ) : TwoSidedIdeal (SuperRing R n) :=
  TwoSidedIdeal.span {f | ∃ (d : ℕ) (a : MomentKind),
    r∣d+oddWeight p q a ∧ (0<d ∨ a≠.polynomial) ∧ f=blockSum d a}

theorem blockSum_mem_blockIdeal (d : ℕ) (a : MomentKind)
    (hd : r∣d+oddWeight p q a) (hp : 0<d ∨ a≠.polynomial) :
    blockSum (R := R) (n := n) d a∈blockIdeal r p q :=
  TwoSidedIdeal.subset_span ⟨d,a,hd,hp,rfl⟩

theorem blockIdeal_le_positiveInvariantIdeal :
    blockIdeal (R := R) (n := n) r p q≤positiveInvariantIdeal (r := r) p q := by
  apply TwoSidedIdeal.span_le.mpr
  rintro f ⟨d,a,hd,hp,rfl⟩
  exact blockSum_mem_positiveInvariantIdeal p q d a hd hp

theorem permutation_blockSum (σ : Equiv.Perm (Fin n)) (d : ℕ) (a : MomentKind) :
    permutation (R := R) σ (blockSum d a)=blockSum d a := by
  simp only [blockSum,map_sum,permutation_localBlock]
  exact Equiv.sum_comp σ (localBlock d a)

theorem permutation_mem_blockIdeal (σ : Equiv.Perm (Fin n)) (x : SuperRing R n)
    (hx : x∈blockIdeal r p q) : permutation σ x∈blockIdeal r p q := by
  apply map_mem_span_of_fixed_generators (permutation (R := R) σ).toAlgHom _ _ hx
  rintro f ⟨d,a,hd,hp,rfl⟩
  exact permutation_blockSum σ d a

theorem occupied_localIndex_nonempty (d : ℕ) (a : MomentKind) (i : Fin n)
    (hp : 0<d ∨ a≠.polynomial) : i∈occupied (localIndex d a i) := by
  rw [mem_occupied]
  cases a with
  | polynomial =>
      have hd : d≠0 := (hp.resolve_right (by simp)).ne'
      exact Or.inl (by simpa [localIndex] using hd)
  | theta => exact Or.inr (Or.inl (by simp [localIndex,blockOddSet]))
  | xi => exact Or.inr (Or.inr (by simp [localIndex,blockOddSet]))
  | mixed => exact Or.inr (Or.inl (by simp [localIndex,blockOddSet]))

/-- The complete occupied-index induction, including all collision terms
and all actual exterior signs. -/
theorem symmetrizer_basis_mem_blockIdeal (hfac : IsUnit (n.factorial : R))
    (z : SuperMonomialIndex n) (hz : (occupied z).Nonempty)
    (hchar : ∀ i,r∣localDegree p q z i) :
    symmetrizer (permutationAction (R := R) (n := n))
      (superMonomialBasis (K := R) z)∈blockIdeal r p q := by
  suffices H : ∀ k : ℕ,∀ z : SuperMonomialIndex n,(occupied z).card=k →
      (occupied z).Nonempty → (∀ i,r∣localDegree p q z i) →
      symmetrizer (permutationAction (R := R) (n := n))
        (superMonomialBasis (K := R) z)∈blockIdeal r p q from
    H _ z rfl hz hchar
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
      intro z hk hz hchar
      obtain ⟨i,hi⟩ := hz
      let t := eraseIndex z i
      let S := occupied t
      let d := z.1 i
      let a := localKind z.2 i
      let ρ := permutationAction (R := R) (n := n)
      let I := blockIdeal (R := R) (n := n) r p q
      have hp : 0<d ∨ a≠.polynomial := localKind_positive hi
      have hd : r∣d+oddWeight p q a := by
        simpa only [d,a,localDegree_at_eq] using hchar i
      have ht : ∀ j,r∣localDegree p q t j := by
        intro j
        dsimp only [t]
        rw [localDegree_eraseIndex]
        split_ifs
        · exact dvd_zero _
        · exact hchar j
      have hcard : S.card<k := by
        dsimp only [S,t]
        rw [occupied_eraseIndex,←hk]
        exact Finset.card_erase_lt_of_mem hi
      have hnot : i∉S := by simp [S,t,occupied_eraseIndex]
      have hcollision (j : Fin n) (hj : j∈S) :
          symmetrizer ρ (localBlock (R := R) d a j*superMonomialBasis t)∈I := by
        rw [localBlock_eq_basis]
        by_cases hdis : Disjoint (localIndex d a j).2 t.2
        · obtain ⟨ε,hε⟩ := basis_mul_unit (R := R) (localIndex d a j) t hdis
          rw [hε,map_smul]
          apply ideal_smul_mem I
          let u := joinIndex (localIndex d a j) t
          have hsub : occupied u⊆S := by
            dsimp only [u]
            rw [occupied_join]
            apply Finset.union_subset
            · intro l hl
              have he : l=j := Finset.mem_singleton.mp (occupied_localIndex_subset d a j hl)
              simpa only [he] using hj
            · exact Finset.Subset.rfl
          have hu : (occupied u).Nonempty := by
            refine ⟨j,?_⟩
            dsimp only [u]
            rw [occupied_join]
            exact Finset.mem_union_left _ (occupied_localIndex_nonempty d a j hp)
          have hc : ∀ l,r∣localDegree p q u l := by
            intro l
            dsimp only [u]
            rw [localDegree_join _ _ _ _ hdis,localDegree_localIndex]
            apply dvd_add _ (ht l)
            split_ifs
            · exact hd
            · exact dvd_zero _
          exact ih _ ((Finset.card_le_card hsub).trans_lt hcard) u rfl hu hc
        · rw [basis_mul_zero _ _ hdis,map_zero]
          exact I.zero_mem
      have havg : symmetrizer ρ (localBlock (R := R) d a i*superMonomialBasis t)∈I :=
        symmetrizer_fresh_mem ρ I
          (fun σ x hx ↦ permutation_mem_blockIdeal σ x hx) hfac
          (localBlock (R := R) d a) (fun σ j ↦ permutation_localBlock σ d a j)
          (blockSum_mem_blockIdeal d a hd hp) S (superMonomialBasis t)
          (fun σ hσ ↦ permutation_basis_of_fix t σ hσ) hcollision i hnot
      obtain ⟨ε,hε⟩ := local_factorization (R := R) z i
      change symmetrizer ρ (localBlock (R := R) (z.1 i) (localKind z.2 i) i*
        superMonomialBasis (eraseIndex z i))∈I at havg
      rw [hε,map_smul] at havg
      exact ideal_mem_of_unit_smul_mem I ε.isUnit havg

/-- Coefficient compatibility is the only input at this linear step. It is
proved from the original cyclic action below, and is automatic when r=1. -/
theorem invariant_mem_blockIdeal_of_coefficients (hfac : IsUnit (n.factorial : R))
    (x : SuperRing R n) (hpositive : augmentation x=0)
    (hperm : ∀ σ : Equiv.Perm (Fin n),permutation σ x=x)
    (hchar : ∀ z : SuperMonomialIndex n,
      (superMonomialBasis (K := R)).repr x z≠0 → ∀ i,r∣localDegree p q z i) :
    x∈blockIdeal r p q := by
  let b := superMonomialBasis (K := R) (n := n)
  let ρ := permutationAction (R := R) (n := n)
  have hcard : IsUnit (Fintype.card (Equiv.Perm (Fin n)) : R) := by
    simpa only [Fintype.card_perm,Fintype.card_fin] using hfac
  apply invariant_mem_of_symmetrizer_mem ρ (blockIdeal r p q) hcard hperm
  have hexp : x=∑ z∈(b.repr x).support,(b.repr x) z • b z :=
    by simpa only [Finsupp.linearCombination_apply,Finsupp.sum] using
      (b.linearCombination_repr x).symm
  rw [hexp,map_sum]
  apply sum_mem
  intro z hz
  rw [map_smul]
  apply ideal_smul_mem
  have hcoef : b.repr x z≠0 := Finsupp.mem_support_iff.mp hz
  have hne : z≠emptyIndex := by
    intro he
    have hc := augmentation_eq_empty_coefficient x
    rw [hpositive] at hc
    exact hcoef (by simpa only [he] using hc.symm)
  exact symmetrizer_basis_mem_blockIdeal hfac z
    (Finset.nonempty_iff_ne_empty.mpr (fun he ↦ hne ((occupied_eq_empty z).mp he)))
    (hchar z hcoef)

/-- Type-A invariant generation over every commutative coefficient ring
with n! invertible. No field, characteristic-zero or semisimplicity premise. -/
theorem positiveInvariantIdeal_eq_blockIdeal_typeA (hfac : IsUnit (n.factorial : R)) :
    positiveInvariantIdeal (R := R) (n := n) (r := 1) 0 0=blockIdeal 1 0 0 := by
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    intro x hx
    exact invariant_mem_blockIdeal_of_coefficients hfac x hx.1
      (wreath_invariant_permutation hx.2) (fun z hz i ↦ one_dvd _)
  · exact blockIdeal_le_positiveInvariantIdeal

section Field

variable {F : Type*} [Field F]

/-- Full wreath invariant generation, derived from the literal original group
action. A primitive root supplies all eigenvalue separations; n! is the only
integer divided in the occupied-index proof. -/
theorem positiveInvariantIdeal_eq_blockIdeal (hfac : IsUnit (n.factorial : F))
    (ζ : Fˣ) (hζ : IsPrimitiveRoot (ζ : F) r) :
    positiveInvariantIdeal (R := F) (n := n) (r := r) p q=blockIdeal r p q := by
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    intro x hx
    exact invariant_mem_blockIdeal_of_coefficients hfac x hx.1
      (wreath_invariant_permutation hx.2)
      (invariant_coefficient_compatible ζ hζ x hx.2)
  · exact blockIdeal_le_positiveInvariantIdeal

end Field
end PaperVerification.Fermion.Coinvariants
