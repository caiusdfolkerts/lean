module

public import PaperVerification.FermionCreators
public import TauCeti.LinearAlgebra.ExteriorAlgebra.HermitianMetric
public import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# The coefficient pairing detects the actual two-sided relations

The exterior basis is paired with itself by its coordinate pairing. Creation
and contraction are adjoint for this pairing. Its orthogonal to all moment
harmonics is proved to be a two-sided ideal; it therefore contains the literal
two-sided ideal generated by the odd and mixed moments. This supplies the
relation-annihilation step used by the triangular creator argument.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Exterior

open scoped BigOperators

variable {R V I : Type*} [CommRing R] [AddCommGroup V] [Module R V]
    [Fintype I] [LinearOrder I]

local notation "E" => ExteriorAlgebra R V

/-- The actual coordinate pairing, with the increasing wedge basis orthonormal. -/
def coefficientPairing (b : Module.Basis I R V) : E →ₗ[R] E →ₗ[R] R :=
  b.ExteriorAlgebra.toDual

theorem coefficientPairing_matrix (b : Module.Basis I R V) :
    coefficientPairing b = Matrix.toLinearMapₛₗ₂ (RingHom.id R)
      b.ExteriorAlgebra b.ExteriorAlgebra (1 : Matrix (Finset I) (Finset I) R) := by
  apply LinearMap.ext_basis b.ExteriorAlgebra b.ExteriorAlgebra
  intro S T
  simp only [coefficientPairing, Module.Basis.toDual_apply,
    Matrix.toLinearMapₛₗ₂_apply_basis, Matrix.one_apply, eq_comm]

@[simp]
theorem coefficientPairing_basis_left (b : Module.Basis I R V) (S : Finset I) (w : E) :
    coefficientPairing b (b.ExteriorAlgebra S) w = b.ExteriorAlgebra.repr w S :=
  b.ExteriorAlgebra.toDual_apply_right S w

@[simp]
theorem coefficientPairing_basis_right (b : Module.Basis I R V) (S : Finset I) (w : E) :
    coefficientPairing b w (b.ExteriorAlgebra S) = b.ExteriorAlgebra.repr w S :=
  b.ExteriorAlgebra.toDual_apply_left w S

theorem coefficientPairing_creation_adjoint (b : Module.Basis I R V)
    (v : V) (x y : E) :
    coefficientPairing b (ExteriorAlgebra.ι R v * x) y =
      coefficientPairing b x (annihilation (b.toDual v) y) := by
  letI : StarRing R := starRingOfComm
  have hv : Matrix.toLinearMapₛₗ₂ (starRingEnd R) b b (1 : Matrix I I R) v = b.toDual v := by
    have heq : Matrix.toLinearMapₛₗ₂ (starRingEnd R) b b (1 : Matrix I I R) = b.toDual := by
      apply LinearMap.ext_basis b b
      intro i j
      rw [Matrix.toLinearMapₛₗ₂_apply_basis, Matrix.one_apply]
      exact (b.toDual_apply i j).symm
    rw [heq]
  have h := ExteriorAlgebra.toLinearMapₛₗ₂_ι_mul_left b v x y
  rw [hv] at h
  have hpair : Matrix.toLinearMapₛₗ₂ (starRingEnd R) b.ExteriorAlgebra b.ExteriorAlgebra
      (1 : Matrix (Finset I) (Finset I) R) = coefficientPairing b := by
    rw [coefficientPairing_matrix]
    apply LinearMap.ext_basis b.ExteriorAlgebra b.ExteriorAlgebra
    intro S T
    simp only [Matrix.toLinearMapₛₗ₂_apply_basis]
  rw [hpair] at h
  simpa only [annihilation] using h

theorem coefficientPairing_basis_creation_adjoint (b : Module.Basis I R V)
    (i : I) (x y : E) :
    coefficientPairing b (ExteriorAlgebra.ι R (b i) * x) y =
      coefficientPairing b x (annihilation (b.coord i) y) := by
  rw [coefficientPairing_creation_adjoint, b.coe_toDual_self]

/-- The degree involution is self-adjoint for the coordinate pairing. -/
theorem coefficientPairing_involute (b : Module.Basis I R V) (x y : E) :
    coefficientPairing b (CliffordAlgebra.involute x) y =
      coefficientPairing b x (CliffordAlgebra.involute y) := by
  have heq : (coefficientPairing b).comp CliffordAlgebra.involute.toLinearMap =
      (coefficientPairing b).compl₂ CliffordAlgebra.involute.toLinearMap := by
    apply LinearMap.ext_basis b.ExteriorAlgebra b.ExteriorAlgebra
    intro S T
    simp only [LinearMap.comp_apply, LinearMap.compl₂_apply, AlgHom.toLinearMap_apply,
      TauCeti.ExteriorAlgebra.involute_basis, map_smul, LinearMap.smul_apply,
      coefficientPairing_basis_left, coefficientPairing_basis_right,
      Module.Basis.repr_self, Finsupp.single_apply, smul_eq_mul]
    by_cases h : S = T
    · subst T
      simp only [if_true]
    · simp only [h, Ne.symm h, if_false, mul_zero]
  exact LinearMap.congr_fun₂ heq x y

section Moments

variable {n : ℕ} [LinearOrder (Fin n ⊕ Fin n)]
    (b : Module.Basis (Fin n ⊕ Fin n) R V) (φ β a c : Fin n → R)

/-- Literal odd polynomial moment relations in the exterior algebra over the
ordinary quotient coefficient ring. -/
def thetaRelation (p : Polynomial R) : E :=
  ∑ i, (c i * p.eval (φ i)) • ExteriorAlgebra.ι R (b (.inl i))

def xiRelation (p : Polynomial R) : E :=
  ∑ i, (β i * a i * p.eval (φ i)) • ExteriorAlgebra.ι R (b (.inr i))

def mixedRelation (p : Polynomial R) : E :=
  ∑ i, p.eval (φ i) • (ExteriorAlgebra.ι R (b (.inl i)) * ExteriorAlgebra.ι R (b (.inr i)))

theorem thetaRelation_adjoint (p : Polynomial R) (x y : E) :
    coefficientPairing b (thetaRelation b φ c p * x) y =
      coefficientPairing b x (thetaCurrent b φ c p y) := by
  simp only [thetaRelation, Finset.sum_mul, smul_mul_assoc, map_sum, map_smul,
    LinearMap.sum_apply, LinearMap.smul_apply, coefficientPairing_basis_creation_adjoint,
    thetaCurrent_eq_sum, smul_eq_mul]

theorem xiRelation_adjoint (p : Polynomial R) (x y : E) :
    coefficientPairing b (xiRelation b φ β a p * x) y =
      coefficientPairing b x (xiCurrent b φ β a p y) := by
  simp only [xiRelation, Finset.sum_mul, smul_mul_assoc, map_sum, map_smul,
    LinearMap.sum_apply, LinearMap.smul_apply, coefficientPairing_basis_creation_adjoint,
    xiCurrent_eq_sum, smul_eq_mul]

theorem mixedRelation_adjoint (p : Polynomial R) (x y : E) :
    coefficientPairing b (mixedRelation b φ p * x) y =
      coefficientPairing b x (mixedCurrent b φ p y) := by
  simp only [mixedRelation, Finset.sum_mul, smul_mul_assoc, mul_assoc, map_sum, map_smul,
    LinearMap.sum_apply, LinearMap.smul_apply, coefficientPairing_basis_creation_adjoint,
    mixedCurrent, pairLower, Module.End.mul_apply, smul_eq_mul]

def IsHarmonicOrthogonal (z : E) : Prop :=
  ∀ w : E, IsHarmonic b φ β a c w → coefficientPairing b z w = 0

theorem IsHarmonicOrthogonal.involute {z : E}
    (hz : IsHarmonicOrthogonal b φ β a c z) :
    IsHarmonicOrthogonal b φ β a c (CliffordAlgebra.involute z) := by
  intro w hw
  rw [coefficientPairing_involute]
  exact hz _ (IsHarmonic.involute b φ β a c hw)

theorem IsHarmonicOrthogonal.mul_left (x : E) {z : E}
    (hz : IsHarmonicOrthogonal b φ β a c z) :
    IsHarmonicOrthogonal b φ β a c (x * z) := by
  induction x using CliffordAlgebra.left_induction with
  | algebraMap r =>
      intro w hw
      rw [← Algebra.smul_def, map_smul, LinearMap.smul_apply, hz w hw, smul_zero]
  | add x y hx hy =>
      intro w hw
      simp only [add_mul, map_add, LinearMap.add_apply, hx w hw, hy w hw, add_zero]
  | ι_mul x v hx =>
      intro w hw
      rw [mul_assoc, coefficientPairing_creation_adjoint]
      apply hx
      exact IsHarmonic.annihilation b φ β a c hw _

theorem IsHarmonicOrthogonal.mul_generator {z : E}
    (hz : IsHarmonicOrthogonal b φ β a c z) (v : V) :
    IsHarmonicOrthogonal b φ β a c (z * ExteriorAlgebra.ι R v) := by
  have heq : z * ExteriorAlgebra.ι R v = ExteriorAlgebra.ι R v * CliffordAlgebra.involute z := by
    rw [ExteriorAlgebra.ι_mul_eq_involute_mul, CliffordAlgebra.involute_involute]
  rw [heq]
  exact IsHarmonicOrthogonal.mul_left b φ β a c _
    (IsHarmonicOrthogonal.involute b φ β a c hz)

theorem IsHarmonicOrthogonal.mul_right (x : E) {z : E}
    (hz : IsHarmonicOrthogonal b φ β a c z) :
    IsHarmonicOrthogonal b φ β a c (z * x) := by
  induction x using CliffordAlgebra.right_induction generalizing z with
  | algebraMap r =>
      intro w hw
      rw [← Algebra.commutes r z, ← Algebra.smul_def, map_smul,
        LinearMap.smul_apply, hz w hw, smul_zero]
  | add x y hx hy =>
      intro w hw
      simp only [mul_add, map_add, LinearMap.add_apply, hx hz w hw, hy hz w hw, add_zero]
  | mul_ι v x hx =>
      rw [← mul_assoc]
      exact IsHarmonicOrthogonal.mul_generator b φ β a c (hx hz) v

/-- Orthogonality to all harmonics defines an actual two-sided ideal. -/
def harmonicOrthogonalIdeal : TwoSidedIdeal E :=
  TwoSidedIdeal.mk' {z | IsHarmonicOrthogonal b φ β a c z}
    (fun _ _ ↦ by simp only [map_zero, LinearMap.zero_apply])
    (fun hx hy w hw ↦ by simp only [map_add, LinearMap.add_apply, hx w hw, hy w hw, add_zero])
    (fun hx w hw ↦ by simp only [map_neg, LinearMap.neg_apply, hx w hw, neg_zero])
    (fun {x _} hz ↦ IsHarmonicOrthogonal.mul_left b φ β a c x hz)
    (fun { _ x} hz ↦ IsHarmonicOrthogonal.mul_right b φ β a c x hz)

@[simp]
theorem mem_harmonicOrthogonalIdeal (z : E) :
    z ∈ harmonicOrthogonalIdeal b φ β a c ↔ IsHarmonicOrthogonal b φ β a c z := by
  exact TwoSidedIdeal.mem_mk' _ _ _ _ _ _ z

/-- All literal odd and mixed relations belong to the harmonic orthogonal. -/
theorem relations_mem_harmonicOrthogonal (p : Polynomial R) :
    thetaRelation b φ c p ∈ harmonicOrthogonalIdeal b φ β a c ∧
    xiRelation b φ β a p ∈ harmonicOrthogonalIdeal b φ β a c ∧
    mixedRelation b φ p ∈ harmonicOrthogonalIdeal b φ β a c := by
  simp only [mem_harmonicOrthogonalIdeal]
  refine ⟨?_, ?_, ?_⟩ <;> intro w hw
  · have h := thetaRelation_adjoint b φ c p 1 w
    simpa only [mul_one, hw.1 p, map_zero] using h
  · have h := xiRelation_adjoint b φ β a p 1 w
    simpa only [mul_one, hw.2.1 p, map_zero] using h
  · have h := mixedRelation_adjoint b φ p 1 w
    simpa only [mul_one, hw.2.2 p, map_zero] using h

end Moments

end PaperVerification.Fermion.Exterior
