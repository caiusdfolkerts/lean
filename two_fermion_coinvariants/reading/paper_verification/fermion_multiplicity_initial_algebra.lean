module

public import PaperVerification.FermionStrictMultiplicityInitial
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel

/-!
# The multiplicity initial object is the actual algebra ideal

The coefficientwise colon module is the kernel of a literal exterior
algebra homomorphism: first impose the ordinary moments, then scale each
exterior generator by its creator diagonal. This proves the two-sided
ideal assertion and identifies the ideal generated by actual smallest-
weight initial forms, rather than defining an initial ideal to be a
desired coefficientwise answer.

-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.Fermion.Exterior

open scoped BigOperators

variable {R V I : Type*} [CommRing R] [AddCommGroup V] [Module R V]
  [LinearOrder I] [Fintype I]

def diagonalLinearMap (b : Module.Basis I R V) (a : I → R) : V →ₗ[R] V :=
  b.constr R (fun i ↦ a i • b i)

@[simp] theorem diagonalLinearMap_basis (b : Module.Basis I R V) (a : I → R) (i : I) :
    diagonalLinearMap b a (b i)=a i • b i := b.constr_basis R _ i

def diagonalAlgebraMap (b : Module.Basis I R V) (a : I → R) :
    ExteriorAlgebra R V →ₐ[R] ExteriorAlgebra R V :=
  ExteriorAlgebra.map (diagonalLinearMap b a)

theorem diagonalAlgebraMap_basis (b : Module.Basis I R V) (a : I → R)
    (T : Finset I) :
    diagonalAlgebraMap b a (b.ExteriorAlgebra T)=
      (∏ i∈T,a i) • b.ExteriorAlgebra T := by
  have h := b.map_exteriorPower_of_apply (diagonalLinearMap b a) a
    (diagonalLinearMap_basis b a) T.card (⟨T,rfl⟩ : Set.powersetCard I T.card)
  have hc := congrArg (fun x : ⋀[R]^T.card V ↦ (x : ExteriorAlgebra R V)) h
  simpa only [exteriorPower.coe_map,Submodule.coe_smul,
    ←ExteriorAlgebra.basis_eq_coe_basis,diagonalAlgebraMap] using hc

theorem diagonalAlgebraMap_coordinate (b : Module.Basis I R V) (a : I → R)
    (z : ExteriorAlgebra R V) (T : Finset I) :
    b.ExteriorAlgebra.repr (diagonalAlgebraMap b a z) T=
      (∏ i∈T,a i)*b.ExteriorAlgebra.repr z T := by
  classical
  have hm : (b.ExteriorAlgebra.coord T).comp (diagonalAlgebraMap b a).toLinearMap=
      (∏ i∈T,a i) • b.ExteriorAlgebra.coord T := by
    apply b.ExteriorAlgebra.ext
    intro S
    rw [LinearMap.comp_apply,AlgHom.toLinearMap_apply,diagonalAlgebraMap_basis,
      map_smul,LinearMap.smul_apply]
    by_cases hST : S=T
    · subst S
      rfl
    · simp only [Module.Basis.coord_apply,Module.Basis.repr_self,
        Finsupp.single_eq_of_ne (Ne.symm hST),smul_zero]
  simpa only [LinearMap.comp_apply,AlgHom.toLinearMap_apply,Module.Basis.coord_apply,LinearMap.smul_apply,
    smul_eq_mul] using LinearMap.congr_fun hm z

end PaperVerification.Fermion.Exterior

namespace PaperVerification.Fermion

open Exterior
open scoped BigOperators

variable {F : Type*} [Field F] {n : ℕ}

local instance FermionMultiplicityInitialAlgebra_localInst_1 : LinearOrder (OddIndex n) :=
  LinearOrder.lift' modeRank modeRank_injective

def strictDiagonalAlgebraMap (d : StrictData (K := F) (n := n)) :
    SuperRing F n →ₐ[F]
      ExteriorAlgebra (StrictCoefficientQuotient d) (OddModule (StrictCoefficientQuotient d) n) :=
  ((diagonalAlgebraMap (Pi.basisFun (StrictCoefficientQuotient d) (OddIndex n))
    (prefixCreatorDiagonal
      (fun i ↦ strictCoefficientProjection d (d.phi i))
      (fun i ↦ algebraMap F (StrictCoefficientQuotient d) (d.beta i))
      (fun i ↦ strictCoefficientProjection d (d.phi i))
      (fun i ↦ strictCoefficientProjection d (d.phi i)))).restrictScalars F).comp
        (superSpecialization (strictCoefficientProjection d))

theorem strictDiagonalAlgebraMap_coordinate (d : StrictData (K := F) (n := n))
    (z : SuperRing F n) (T : Finset (OddIndex n)) :
    (Pi.basisFun (StrictCoefficientQuotient d) (OddIndex n)).ExteriorAlgebra.repr
      (strictDiagonalAlgebraMap d z) T=
        strictCoefficientProjection d
          (creatorWordPolynomial d.creatorData T*(superPolynomialBasis (K := F)).repr z T) := by
  rw [strictDiagonalAlgebraMap,AlgHom.comp_apply,AlgHom.restrictScalars_apply,
    diagonalAlgebraMap_coordinate,superSpecialization_coordinate,map_mul]
  congr 1
  simp only [creatorWordPolynomial,StrictData.creatorData,map_prod,creatorDiagonal_map]

theorem strictDiagonalAlgebraMap_eq_zero_iff (d : StrictData (K := F) (n := n))
    (z : SuperRing F n) :
    strictDiagonalAlgebraMap d z=0 ↔
      ∀ T,(superPolynomialBasis (K := F)).repr z T∈
        principalColon (coupledOrdinaryIdeal d.pairedExtension)
          (creatorWordPolynomial d.creatorData T) := by
  constructor
  · intro hz T
    have hc := congrArg (fun x ↦
      (Pi.basisFun (StrictCoefficientQuotient d) (OddIndex n)).ExteriorAlgebra.repr x T) hz
    rw [strictDiagonalAlgebraMap_coordinate,map_zero,Finsupp.zero_apply] at hc
    exact (mem_principalColon _ _ _).mpr
      (by simpa only [mul_comm] using Ideal.Quotient.eq_zero_iff_mem.mp hc)
  · intro hz
    apply (Pi.basisFun (StrictCoefficientQuotient d) (OddIndex n)).ExteriorAlgebra.repr.injective
    ext T
    rw [strictDiagonalAlgebraMap_coordinate,map_zero,Finsupp.zero_apply]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    simpa only [mul_comm] using (mem_principalColon _ _ _).mp (hz T)

/-- The literal two-sided ideal generated by smallest-weight initial forms
of literal strict relations. -/
def strictMultiplicityInitialIdeal (d : StrictData (K := F) (n := n)) :
    TwoSidedIdeal (SuperRing F n) :=
  TwoSidedIdeal.span (strictMultiplicityInitialGenerators d)

/-- Identifying the actual ideal uses both inclusions of the independently
proved initial-module equality; the diagonal homomorphism supplies ideality. -/
theorem strictMultiplicityInitialIdeal_eq_kernel (d : StrictData (K := F) (n := n)) :
    strictMultiplicityInitialIdeal d=TwoSidedIdeal.ker (strictDiagonalAlgebraMap d) := by
  have he (z : SuperRing F n) :
      z∈strictMultiplicityInitialModule d ↔ strictDiagonalAlgebraMap d z=0 :=
    (strict_multiplicity_initial_mem_iff d z).trans
      (strictDiagonalAlgebraMap_eq_zero_iff d z).symm
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    intro z hz
    apply (TwoSidedIdeal.mem_ker (strictDiagonalAlgebraMap d)).mpr
    exact (he z).mp (Submodule.subset_span hz)
  · intro z hz
    have hlin : z∈strictMultiplicityInitialModule d :=
      (he z).mpr ((TwoSidedIdeal.mem_ker (strictDiagonalAlgebraMap d)).mp hz)
    have hle : strictMultiplicityInitialModule d≤
        twoSidedIdealSubmodule (K := F) (strictMultiplicityInitialIdeal d) := by
      apply Submodule.span_le.mpr
      intro x hx
      exact TwoSidedIdeal.subset_span hx
    exact hle hlin

/-- The coefficientwise colon equality is an equality for the actual
two-sided initial ideal, retaining the ambient algebra multiplication. -/
theorem strict_multiplicity_initialIdeal_mem_iff (d : StrictData (K := F) (n := n))
    (z : SuperRing F n) :
    z∈strictMultiplicityInitialIdeal d ↔
      ∀ T,(superPolynomialBasis (K := F)).repr z T∈
        principalColon (coupledOrdinaryIdeal d.pairedExtension)
          (creatorWordPolynomial d.creatorData T) := by
  rw [strictMultiplicityInitialIdeal_eq_kernel,TwoSidedIdeal.mem_ker,
    strictDiagonalAlgebraMap_eq_zero_iff]

end PaperVerification.Fermion
