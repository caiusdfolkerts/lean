module

public import PaperVerification.FermionGradedTensor
public import PaperVerification.FermionGradedQuotient
public import PaperVerification.FermionTensorQuotient

/-!
# Genuine graded tensor products commute with homogeneous two-sided quotients

The quotient ideal is generated by the actual images of both factor ideals.
The multiplication is Mathlib's signed graded tensor multiplication. The maps
and their inverse identities are constructed from the two universal properties;
no flatness or dimension equality is assumed.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped TensorProduct

namespace PaperVerification.Fermion

variable {R A B C D : Type*} [CommRing R]
  [Ring A] [Ring B] [Ring C] [Ring D]
  [Algebra R A] [Algebra R B] [Algebra R C] [Algebra R D]
variable (pA : ℕ → Submodule R A) (pB : ℕ → Submodule R B)
  (pC : ℕ → Submodule R C) (pD : ℕ → Submodule R D)
  [GradedAlgebra pA] [GradedAlgebra pB] [GradedAlgebra pC] [GradedAlgebra pD]

theorem gradedTensor_inclusions_anticomm {i j : ℕ} (a : pA i) (b : pB j) :
    GradedTensorProduct.includeLeft pA pB a *
      GradedTensorProduct.includeRight pA pB b =
    (-1 : ℤˣ)^(j*i) •
      (GradedTensorProduct.includeRight pA pB b *
        GradedTensorProduct.includeLeft pA pB a) := by
  change ((a : A) ᵍ⊗ₜ[R] (1 : B)) * ((1 : A) ᵍ⊗ₜ[R] (b : B)) =
    (-1 : ℤˣ)^(j*i) •
      (((1 : A) ᵍ⊗ₜ[R] (b : B)) * ((a : A) ᵍ⊗ₜ[R] (1 : B)))
  rw [GradedTensorProduct.tmul_one_mul_one_tmul,
    GradedTensorProduct.tmul_coe_mul_coe_tmul]
  simp only [one_mul,mul_one,smul_smul,Int.units_mul_self,one_smul]

def gradedTensorMap (f : A →ₐ[R] C) (g : B →ₐ[R] D)
    (hf : ∀ n a,a∈pA n → f a∈pC n)
    (hg : ∀ n b,b∈pB n → g b∈pD n) :
    pA ᵍ⊗[R] pB →ₐ[R] pC ᵍ⊗[R] pD :=
  GradedTensorProduct.lift pA pB
    ((GradedTensorProduct.includeLeft pC pD).comp f)
    ((GradedTensorProduct.includeRight pC pD).comp g)
    (fun i j a b ↦ gradedTensor_inclusions_anticomm pC pD
      ⟨f a,hf i a a.property⟩ ⟨g b,hg j b b.property⟩)

@[simp] theorem gradedTensorMap_tmul
    (f : A →ₐ[R] C) (g : B →ₐ[R] D)
    (hf : ∀ n a,a∈pA n → f a∈pC n)
    (hg : ∀ n b,b∈pB n → g b∈pD n) (a : A) (b : B) :
    gradedTensorMap pA pB pC pD f g hf hg (a ᵍ⊗ₜ[R] b)=
      f a ᵍ⊗ₜ[R] g b := by
  change (f a ᵍ⊗ₜ[R] (1 : D) : pC ᵍ⊗[R] pD) *
    ((1 : C) ᵍ⊗ₜ[R] g b : pC ᵍ⊗[R] pD) =
    (f a ᵍ⊗ₜ[R] g b : pC ᵍ⊗[R] pD)
  exact GradedTensorProduct.tmul_one_mul_one_tmul pC pD (f a) (g b)

section Quotients

variable (I : TwoSidedIdeal A) (J : TwoSidedIdeal B)

def gradedTensorRelationIdeal : TwoSidedIdeal (pA ᵍ⊗[R] pB) :=
  TwoSidedIdeal.span
    ((GradedTensorProduct.includeLeft pA pB '' (I : Set A)) ∪
      (GradedTensorProduct.includeRight pA pB '' (J : Set B)))

abbrev GradedTensorQuotient := (gradedTensorRelationIdeal pA pB I J).ringCon.Quotient

def gradedTensorQuotientPartLeft : ℕ → Submodule R I.ringCon.Quotient :=
  gradedImagePart pA (I.ringCon.mkₐ R)

def gradedTensorQuotientPartRight : ℕ → Submodule R J.ringCon.Quotient :=
  gradedImagePart pB (J.ringCon.mkₐ R)

variable
  (hI : ∀ n a,a∈I → GradedAlgebra.proj pA n a∈I)
  (hJ : ∀ n b,b∈J → GradedAlgebra.proj pB n b∈J)

def gradedTensorQuotientGradingLeft :
    GradedAlgebra (gradedTensorQuotientPartLeft pA I) :=
  gradedImageAlgebra pA (I.ringCon.mkₐ R) (RingCon.mkₐ_surjective (α := R) _) (by
    intro n a ha
    have hamem : a∈I := by
      change ((a : A) : I.ringCon.Quotient)=((0 : A) : I.ringCon.Quotient) at ha
      exact Quotient.exact ha
    exact quotientMk_eq_zero_of_mem (R := R) I _ (hI n a hamem))

def gradedTensorQuotientGradingRight :
    GradedAlgebra (gradedTensorQuotientPartRight pB J) :=
  gradedImageAlgebra pB (J.ringCon.mkₐ R) (RingCon.mkₐ_surjective (α := R) _) (by
    intro n b hb
    have hbmem : b∈J := by
      change ((b : B) : J.ringCon.Quotient)=((0 : B) : J.ringCon.Quotient) at hb
      exact Quotient.exact hb
    exact quotientMk_eq_zero_of_mem (R := R) J _ (hJ n b hbmem))

def gradedTensorQuotientIncludeLeft :
    I.ringCon.Quotient →ₐ[R] GradedTensorQuotient pA pB I J :=
  I.ringCon.liftₐ
    (((gradedTensorRelationIdeal pA pB I J).ringCon.mkₐ R).comp
      (GradedTensorProduct.includeLeft pA pB))
    (ringCon_le_ker_of_kills I _ (by
      intro a ha
      apply quotientMk_eq_zero_of_mem (R := R)
      exact TwoSidedIdeal.subset_span (Or.inl ⟨a,ha,rfl⟩)))

def gradedTensorQuotientIncludeRight :
    J.ringCon.Quotient →ₐ[R] GradedTensorQuotient pA pB I J :=
  J.ringCon.liftₐ
    (((gradedTensorRelationIdeal pA pB I J).ringCon.mkₐ R).comp
      (GradedTensorProduct.includeRight pA pB))
    (ringCon_le_ker_of_kills J _ (by
      intro b hb
      apply quotientMk_eq_zero_of_mem (R := R)
      exact TwoSidedIdeal.subset_span (Or.inr ⟨b,hb,rfl⟩)))

@[simp] theorem gradedTensorQuotientIncludeLeft_mk (a : A) :
    gradedTensorQuotientIncludeLeft pA pB I J (I.ringCon.mkₐ R a)=
      (gradedTensorRelationIdeal pA pB I J).ringCon.mkₐ R
        (GradedTensorProduct.includeLeft pA pB a) := rfl

@[simp] theorem gradedTensorQuotientIncludeRight_mk (b : B) :
    gradedTensorQuotientIncludeRight pA pB I J (J.ringCon.mkₐ R b)=
      (gradedTensorRelationIdeal pA pB I J).ringCon.mkₐ R
        (GradedTensorProduct.includeRight pA pB b) := rfl

theorem gradedTensorQuotient_inclusions_anticomm {i j : ℕ}
    (a : gradedTensorQuotientPartLeft pA I i)
    (b : gradedTensorQuotientPartRight pB J j) :
    gradedTensorQuotientIncludeLeft pA pB I J a *
      gradedTensorQuotientIncludeRight pA pB I J b =
      (-1 : ℤˣ)^(j*i) •
        (gradedTensorQuotientIncludeRight pA pB I J b *
          gradedTensorQuotientIncludeLeft pA pB I J a) := by
  obtain ⟨a,ha,hea⟩ := a.property
  obtain ⟨b,hb,heb⟩ := b.property
  change (I.ringCon.mkₐ R) a = _ at hea
  change (J.ringCon.mkₐ R) b = _ at heb
  rw [←hea,←heb,gradedTensorQuotientIncludeLeft_mk,gradedTensorQuotientIncludeRight_mk,
    ←map_mul,←map_mul,gradedTensor_inclusions_anticomm pA pB ⟨a,ha⟩ ⟨b,hb⟩]
  exact AlgHom.map_smul_of_tower _ _ _

def gradedTensorTwoSidedQuotientEquiv :
    letI := gradedTensorQuotientGradingLeft pA I hI
    letI := gradedTensorQuotientGradingRight pB J hJ
    GradedTensorQuotient pA pB I J ≃ₐ[R]
      (gradedTensorQuotientPartLeft pA I ᵍ⊗[R]
        gradedTensorQuotientPartRight pB J) := by
  letI := gradedTensorQuotientGradingLeft pA I hI
  letI := gradedTensorQuotientGradingRight pB J hJ
  let K := gradedTensorRelationIdeal pA pB I J
  let qK := K.ringCon.mkₐ R
  let pI := gradedTensorQuotientPartLeft pA I
  let pJ := gradedTensorQuotientPartRight pB J
  let f := gradedTensorMap pA pB pI pJ (I.ringCon.mkₐ R) (J.ringCon.mkₐ R)
    (fun n a ha ↦ ⟨a,ha,rfl⟩) (fun n b hb ↦ ⟨b,hb,rfl⟩)
  have hf : ∀ x∈K,f x=0 := by
    have hle : K≤TwoSidedIdeal.ofRingCon (RingCon.ker f.toRingHom) := by
      apply TwoSidedIdeal.span_le.mpr
      rintro x (⟨a,ha,rfl⟩|⟨b,hb,rfl⟩)
      · change f (a ᵍ⊗ₜ[R] (1:B))=f 0
        simp only [f,gradedTensorMap_tmul,quotientMk_eq_zero_of_mem I a ha,map_one,
          map_zero,GradedTensorProduct.tmul,TensorProduct.zero_tmul]
      · change f ((1:A) ᵍ⊗ₜ[R] b)=f 0
        simp only [f,gradedTensorMap_tmul,quotientMk_eq_zero_of_mem J b hb,map_one,
          map_zero,GradedTensorProduct.tmul,TensorProduct.tmul_zero]
    intro x hx
    have he := hle hx
    change f x=f 0 at he
    simpa only [map_zero] using he
  let fbar := K.ringCon.liftₐ f (ringCon_le_ker_of_kills K f hf)
  let g := GradedTensorProduct.lift pI pJ
    (gradedTensorQuotientIncludeLeft pA pB I J)
    (gradedTensorQuotientIncludeRight pA pB I J)
    (fun {_ _} a b ↦ gradedTensorQuotient_inclusions_anticomm pA pB I J a b)
  have hfbar (a : A) (b : B) :
      fbar (qK (a ᵍ⊗ₜ[R] b)) =
        (I.ringCon.mkₐ R a) ᵍ⊗ₜ[R] (J.ringCon.mkₐ R b) :=
    gradedTensorMap_tmul pA pB pI pJ (I.ringCon.mkₐ R) (J.ringCon.mkₐ R)
      (fun n a ha ↦ ⟨a,ha,rfl⟩) (fun n b hb ↦ ⟨b,hb,rfl⟩) a b
  have hg (a : I.ringCon.Quotient) (b : J.ringCon.Quotient) :
      g (a ᵍ⊗ₜ[R] b) =
        gradedTensorQuotientIncludeLeft pA pB I J a *
          gradedTensorQuotientIncludeRight pA pB I J b := rfl
  refine AlgEquiv.ofAlgHom fbar g ?_ ?_
  · apply GradedTensorProduct.algHom_ext
    · apply RingCon.Quotient.hom_extₐ
      apply AlgHom.ext
      intro a
      change fbar (g ((I.ringCon.mkₐ R a) ᵍ⊗ₜ[R] (1 : J.ringCon.Quotient))) =
        (I.ringCon.mkₐ R a) ᵍ⊗ₜ[R] (1 : J.ringCon.Quotient)
      rw [hg,map_one,mul_one,gradedTensorQuotientIncludeLeft_mk]
      change fbar (qK (a ᵍ⊗ₜ[R] (1 : B))) = _
      rw [hfbar,map_one]
    · apply RingCon.Quotient.hom_extₐ
      apply AlgHom.ext
      intro b
      change fbar (g ((1 : I.ringCon.Quotient) ᵍ⊗ₜ[R] (J.ringCon.mkₐ R b))) =
        (1 : I.ringCon.Quotient) ᵍ⊗ₜ[R] (J.ringCon.mkₐ R b)
      rw [hg,map_one,one_mul,gradedTensorQuotientIncludeRight_mk]
      change fbar (qK ((1 : A) ᵍ⊗ₜ[R] b)) = _
      rw [hfbar,map_one]
  · apply RingCon.Quotient.hom_extₐ
    apply GradedTensorProduct.algHom_ext
    · apply AlgHom.ext
      intro a
      change g (fbar (qK (a ᵍ⊗ₜ[R] (1 : B)))) = qK (a ᵍ⊗ₜ[R] (1 : B))
      rw [hfbar,map_one,hg,map_one,mul_one,gradedTensorQuotientIncludeLeft_mk]
      rfl
    · apply AlgHom.ext
      intro b
      change g (fbar (qK ((1 : A) ᵍ⊗ₜ[R] b))) = qK ((1 : A) ᵍ⊗ₜ[R] b)
      rw [hfbar,map_one,hg,map_one,one_mul,gradedTensorQuotientIncludeRight_mk]
      rfl

end Quotients
end PaperVerification.Fermion

