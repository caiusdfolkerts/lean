module

public import PaperVerification.FermionKoszulAdjoint
public import Mathlib.RingTheory.Ideal.Colon

/-!
# The determinant-colon theorem for regular sequences

For equally long sequences `a,b` related by a matrix, regularity of `b`
implies `(b) : det(C) = (a)`. The proof uses the reverse Koszul comparison:
its bottom map is the determinant and its top map is the identity. A relation
annihilated by the determinant lifts to a null-homotopy; the top equation then
puts the relation in `(a)`.

No Frobenius property, finite-colength claim, or determinant-colon identity is
assumed. The only exactness input is the proved Koszul exactness theorem for
the stated regular sequence.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace PaperVerification.Fermion.Koszul

open TauCeti
open scoped BigOperators

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Free R M] [Module.Finite R M]

/-- Applying any scalar-valued linear functional after a Koszul differential
gives an element of the ideal generated by the original functional's values. -/
theorem functional_koszulDifferential_mem_range (φ : Module.Dual R M) (k : ℕ)
    (ℓ : ⋀[R]^k M →ₗ[R] R) (w : ⋀[R]^(k + 1) M) :
    ℓ (koszulDifferential φ k w) ∈ LinearMap.range φ := by
  have htop : (⊤ : Submodule R (⋀[R]^(k + 1) M)) ≤
      (LinearMap.range φ).comap (ℓ ∘ₗ koszulDifferential φ k) := by
    rw [← exteriorPower.ιMulti_span R (k + 1) M, Submodule.span_le]
    rintro _ ⟨v, rfl⟩
    change ℓ (koszulDifferential φ k (exteriorPower.ιMulti R (k + 1) v)) ∈
      LinearMap.range φ
    rw [koszulDifferential_ιMulti, map_sum]
    apply Submodule.sum_mem
    intro i _
    rw [map_smul]
    have hi := Submodule.smul_mem (LinearMap.range φ)
      (((-1 : R) ^ (i : ℕ)) * ℓ (exteriorPower.ιMulti R k (i.removeNth v)))
      (LinearMap.mem_range_self φ (v i))
    simpa only [smul_eq_mul, mul_assoc, mul_left_comm, mul_comm] using hi
  exact htop (Submodule.mem_top : w ∈ (⊤ : Submodule R _))

variable (vol : ⋀[R]^(Module.finrank R M) M ≃ₗ[R] R)

include vol in
/-- The easy containment in the determinant-colon theorem, obtained from the
degree-zero chain-map equation. -/
theorem mul_det_mem_range (φ ψ : Module.Dual R M) (g : M →ₗ[R] M)
    (hg : φ ∘ₗ g = ψ) {r : R} (hr : r ∈ LinearMap.range φ) :
    r * LinearMap.det g ∈ LinearMap.range ψ := by
  obtain ⟨m, rfl⟩ := hr
  let x := (exteriorPower.oneEquiv R M).symm m
  let z := adjoint vol g 1 x
  refine ⟨exteriorPower.oneEquiv R M z, ?_⟩
  have hcomm := LinearMap.congr_fun (adjoint_comm vol φ ψ g hg 0) x
  have hs := congrArg (exteriorPower.zeroEquiv R M) hcomm
  simpa only [LinearMap.comp_apply, zeroEquiv_koszulDifferential_zero, adjoint_zero,
    LinearMap.smul_apply, LinearMap.id_apply, map_smul, smul_eq_mul,
    LinearEquiv.apply_symm_apply, mul_comm, x, z] using hs

/-- The image condition in degree zero needed to lift the reverse comparison
to a null-homotopy. -/
theorem scaled_adjoint_zero_range_le (ψ : Module.Dual R M) (g : M →ₗ[R] M)
    (r : R) (hr : r * LinearMap.det g ∈ LinearMap.range ψ) :
    LinearMap.range (r • adjoint vol g 0) ≤ LinearMap.range (koszulDifferential ψ 0) := by
  obtain ⟨m, hm⟩ := hr
  rintro _ ⟨x, rfl⟩
  refine ⟨(exteriorPower.oneEquiv R M).symm ((exteriorPower.zeroEquiv R M x) • m), ?_⟩
  apply (exteriorPower.zeroEquiv R M).injective
  simp only [zeroEquiv_koszulDifferential_zero, LinearEquiv.apply_symm_apply,
    map_smul, hm, adjoint_zero, LinearMap.smul_apply, LinearMap.id_apply,
    smul_eq_mul, mul_assoc, mul_left_comm, mul_comm]

include vol in
/-- A top scalar of a chain comparison that lifts zero belongs to the ideal
of values of its source differential. -/
theorem top_scalar_mem_range
    (φ ψ : Module.Dual R M)
    (f : ∀ k, ⋀[R]^k M →ₗ[R] ⋀[R]^k M)
    (hψ : ∀ k, Function.Exact (koszulDifferential ψ (k + 1)) (koszulDifferential ψ k))
    (hcomm : ∀ k, koszulDifferential ψ k ∘ₗ f (k + 1) = f k ∘ₗ koszulDifferential φ k)
    (hzero : LinearMap.range (f 0) ≤ LinearMap.range (koszulDifferential ψ 0))
    (r : R) (htop : f (Module.finrank R M) = r • LinearMap.id) :
    r ∈ LinearMap.range φ := by
  rcases hd : Module.finrank R M with _ | n
  · have htop' : f 0 = r • LinearMap.id := hd ▸ htop
    let x := (exteriorPower.zeroEquiv R M).symm 1
    obtain ⟨z, hz⟩ := hzero (LinearMap.mem_range_self (f 0) x)
    have hz0 : z = 0 := exteriorPower.eq_zero_of_finrank_lt 1 (by omega) z
    have hs := congrArg (exteriorPower.zeroEquiv R M) hz
    have hr0 : r = 0 := by
      simpa only [hz0, map_zero, htop', LinearMap.smul_apply, LinearMap.id_apply,
        map_smul, x, LinearEquiv.apply_symm_apply, smul_eq_mul, mul_one] using hs.symm
    rw [hr0]
    exact Submodule.zero_mem _
  · letI : Subsingleton (⋀[R]^(n + 2) M) :=
      ⟨fun x y ↦ (exteriorPower.eq_zero_of_finrank_lt _ (by omega) x).trans
        (exteriorPower.eq_zero_of_finrank_lt _ (by omega) y).symm⟩
    obtain ⟨h, hh⟩ := linear_chain_map_top_factors
      (koszulDifferential φ) (koszulDifferential ψ) f
      (koszulDifferential_comp_koszulDifferential φ) hψ hcomm hzero n
    have htop' : f (n + 1) = r • LinearMap.id := hd ▸ htop
    let e : ⋀[R]^(n + 1) M ≃ₗ[R] R :=
      (LinearEquiv.ofEq _ _ (congrArg (fun d ↦ ⋀[R]^d M) hd.symm)).trans vol
    have hmem := functional_koszulDifferential_mem_range φ n
      (e.toLinearMap ∘ₗ h) (e.symm 1)
    have hs := congrArg e (LinearMap.congr_fun hh (e.symm 1))
    have heq : r = e (h (koszulDifferential φ n (e.symm 1))) := by
      simpa only [htop', LinearMap.smul_apply, LinearMap.id_apply, map_smul,
        LinearEquiv.apply_symm_apply, smul_eq_mul, mul_one, LinearMap.comp_apply] using hs
    rw [heq]
    exact hmem

include vol in
/-- Kernel identification for the reverse Koszul comparison. Only exactness of
the target Koszul complex is required. -/
theorem mem_range_of_mul_det_mem_range
    (φ ψ : Module.Dual R M) (g : M →ₗ[R] M) (hg : φ ∘ₗ g = ψ)
    (hψ : ∀ k, Function.Exact (koszulDifferential ψ (k + 1)) (koszulDifferential ψ k))
    {r : R} (hr : r * LinearMap.det g ∈ LinearMap.range ψ) :
    r ∈ LinearMap.range φ := by
  apply top_scalar_mem_range vol φ ψ (fun k ↦ r • adjoint vol g k) hψ
    (fun k ↦ ?_) (scaled_adjoint_zero_range_le vol ψ g r hr) r
  · rw [adjoint_top]
  · rw [LinearMap.comp_smul, LinearMap.smul_comp, adjoint_comm vol φ ψ g hg]

include vol in
/-- The literal principal-colon equality for a Koszul-regular comparison. -/
theorem range_colon_det_eq
    (φ ψ : Module.Dual R M) (g : M →ₗ[R] M) (hg : φ ∘ₗ g = ψ)
    (hψ : ∀ k, Function.Exact (koszulDifferential ψ (k + 1)) (koszulDifferential ψ k)) :
    (LinearMap.range ψ).colon {LinearMap.det g} = LinearMap.range φ := by
  ext r
  rw [Submodule.mem_colon_singleton, smul_eq_mul]
  exact ⟨mem_range_of_mul_det_mem_range vol φ ψ g hg hψ,
    mul_det_mem_range vol φ ψ g hg⟩

/-- **Determinant-colon theorem for regular sequences.** The two ideals are
the ideals generated by the actual two sequences. The comparison matrix is
represented by its linear map, and its determinant is Mathlib's determinant.
There is no restriction on the characteristic or on the coefficient ring. -/
theorem span_colon_det_eq_of_isWeaklyRegular {n : ℕ}
    (a b : Fin n → R) (g : (Fin n → R) →ₗ[R] (Fin n → R))
    (hg : Fintype.linearCombination R a ∘ₗ g = Fintype.linearCombination R b)
    (hb : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn b)) :
    (Ideal.span (Set.range b)).colon {LinearMap.det g} = Ideal.span (Set.range a) := by
  nontriviality R
  let vol := (Module.finBasis R (Fin n → R)).exteriorPowerTopEquiv
  have hψ (k : ℕ) :
      Function.Exact (koszulDifferential (Fintype.linearCombination R b) (k + 1))
        (koszulDifferential (Fintype.linearCombination R b) k) :=
    (koszulComplex.exactAt_succ_iff _ k).mp
      (koszulComplex.exactAt_of_isWeaklyRegular b hb k)
  simpa only [Fintype.range_linearCombination] using
    range_colon_det_eq vol (Fintype.linearCombination R a)
      (Fintype.linearCombination R b) g hg hψ

end PaperVerification.Fermion.Koszul
