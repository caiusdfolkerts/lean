module

public import PaperVerification.FermionMomentRecurrence
public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import Mathlib.RingTheory.TwoSidedIdeal.BigOperators

/-!
# Finite moment ideal presentations

The scalar recurrence in `FermionMomentRecurrence` applies to the literal
two-sided ideals of the exterior coefficient algebra. Every infinite moment
family has exactly the ideal generated by its first `n` entries.
-/

@[expose] public section

set_option autoImplicit false

namespace PaperVerification.Fermion

open scoped BigOperators
open Polynomial

variable {R : Type*} [CommRing R]
variable {n : ℕ}

section Algebra

variable {A : Type*} [Ring A] [Algebra R A]

/-- Containing the first `n` moments forces a two-sided ideal to contain every moment. -/
theorem moment_mem_of_first (x : Fin n → R) (v : Fin n → A)
    (I : TwoSidedIdeal A) (h : ∀ j : Fin n, moment x v (j : ℕ) ∈ I) (k : ℕ) :
    moment x v k ∈ I := by
  rw [moment_eq_sum_first]
  apply sum_mem
  intro j _
  rw [Algebra.smul_def]
  exact I.mul_mem_left _ _ (h j)

/-- The moment ideal attached to any family of coefficient vectors. -/
def momentIdeal {κ : Type*} (x : Fin n → R) (v : κ → Fin n → A) : TwoSidedIdeal A :=
  TwoSidedIdeal.span (Set.range fun p : κ × ℕ ↦ moment x (v p.1) p.2)

/-- A finite-index presentation of each coefficient vector's moments. -/
def finiteMomentIdeal {κ : Type*} (x : Fin n → R) (v : κ → Fin n → A) :
    TwoSidedIdeal A :=
  TwoSidedIdeal.span (Set.range fun p : κ × Fin n ↦ moment x (v p.1) (p.2 : ℕ))

/-- Replacing every infinite moment family by its first `n` generators preserves the ideal. -/
theorem momentIdeal_eq_finite {κ : Type*} (x : Fin n → R) (v : κ → Fin n → A) :
    momentIdeal x v = finiteMomentIdeal x v := by
  apply le_antisymm
  · apply TwoSidedIdeal.span_le.mpr
    rintro _ ⟨⟨a, k⟩, rfl⟩
    apply moment_mem_of_first x (v a)
    intro j
    exact TwoSidedIdeal.subset_span ⟨(a, j), rfl⟩
  · apply TwoSidedIdeal.span_mono
    rintro _ ⟨⟨a, j⟩, rfl⟩
    exact ⟨(a, (j : ℕ)), rfl⟩

end Algebra

end PaperVerification.Fermion
