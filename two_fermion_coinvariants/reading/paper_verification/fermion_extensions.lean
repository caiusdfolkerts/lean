    have ha0 : 0 < a := by
      dsimp [a]
      lia
    have ha1 : a + 1 < l.length := by
      dsimp [a]
      lia
    have hleft : a - 1 = l.length - 1 - (i + 1) := by
      dsimp [a]
      lia
