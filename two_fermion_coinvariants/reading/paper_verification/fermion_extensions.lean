/-- The empty word has no peaks. -/
@[simp] theorem peakSet_nil : peakSet ([] : List α) = ∅ := by
  rfl

/-- A one-letter word has no peaks. -/
@[simp] theorem peakSet_singleton (a : α) : peakSet [a] = ∅ := by
  rfl

