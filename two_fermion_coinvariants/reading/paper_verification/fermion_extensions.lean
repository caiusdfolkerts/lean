    have h := (sum_constantFiber (ι := d.Index c) (C := (d.factor c).Carrier)
      (fiberFintype := constantFiberClassicalFintype (d.Index c))
      (fun i ↦ (d.factorRep c).z i ^ (d.r c i*k) *
