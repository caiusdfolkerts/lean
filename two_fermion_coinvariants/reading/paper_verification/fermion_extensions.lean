  ⟨(d.factorToWholeRep c).lift d.whole_supercommutative,
    fun _ _ hx ↦ (d.factorToWholeRep c).lift_degree d.whole_supercommutative hx⟩

def factorInclude (c : Fin m) : NGradedHom (d.factor c) d.tensor :=
