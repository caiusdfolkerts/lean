/- Literal source: PaperVerification/FermionNaturalExteriorTensor.lean -/


/-!
# Natural ordered multiplication of exterior tensors

The map in this file is defined by the actual ordered exterior product. Its
naturality is proved before any bases, dimensions, coefficient quotients or
representations are introduced. It is intended for the genuine color-block
comparison in Theorem 8.1. 
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped TensorProduct

namespace PaperVerification.Fermion.NaturalExteriorTensor

variable {R V W : Type*} [CommRing R]
  [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W] {n : ℕ}

/-- Insert each exterior factor into the original exterior algebra, then
multiply in increasing index order. No action is transported to define this map. -/
def assemble (d : Fin n → ℕ) (e : Fin n → V →ₗ[R] W) :
    (⨂[R] i : Fin n, (⋀[R]^(d i) V)) →ₗ[R] ExteriorAlgebra R W :=
  PiTensorProduct.lift <|
    (MultilinearMap.mkPiAlgebraFin R n (ExteriorAlgebra R W)).compLinearMap
      (fun i ↦ (ExteriorAlgebra.map (e i)).toLinearMap.comp (Submodule.subtype _))

@[simp] theorem assemble_tprod (d : Fin n → ℕ) (e : Fin n → V →ₗ[R] W)
    (x : ∀ i, ⋀[R]^(d i) V) :
    assemble d e (PiTensorProduct.tprod R x) =
      (List.ofFn (fun i ↦ ExteriorAlgebra.map (e i) (x i))).prod := by
  simp only [assemble, PiTensorProduct.lift.tprod,
    MultilinearMap.compLinearMap_apply, MultilinearMap.mkPiAlgebraFin_apply,
    LinearMap.comp_apply, AlgHom.toLinearMap_apply, Submodule.coe_subtype]

/-- Naturality for independently specified local maps and an actual global
map, with the commuting square stated on the original vector spaces. -/
theorem assemble_natural (d : Fin n → ℕ) (e : Fin n → V →ₗ[R] W)
    (g : Fin n → V →ₗ[R] V) (h : W →ₗ[R] W)
    (he : ∀ i, h.comp (e i) = (e i).comp (g i)) :
    (ExteriorAlgebra.map h).toLinearMap.comp (assemble d e) =
      (assemble d e).comp (PiTensorProduct.map (fun i ↦ exteriorPower.map (d i) (g i))) := by
  apply PiTensorProduct.ext
  apply MultilinearMap.ext
  intro x
  simp only [LinearMap.compMultilinearMap_apply, LinearMap.comp_apply,
    assemble_tprod, PiTensorProduct.map_tprod, AlgHom.toLinearMap_apply,
    exteriorPower.coe_map, map_list_prod, List.map_ofFn]
  congr 1
  apply congrArg List.ofFn
  funext i
  change ((ExteriorAlgebra.map h).comp (ExteriorAlgebra.map (e i))) (x i) =
    ((ExteriorAlgebra.map (e i)).comp (ExteriorAlgebra.map (g i))) (x i)
  rw [ExteriorAlgebra.map_comp_map, ExteriorAlgebra.map_comp_map, he i]

/-- The vector form of the same commuting square, for arbitrary tensors. -/
theorem assemble_natural_apply (d : Fin n → ℕ) (e : Fin n → V →ₗ[R] W)
    (g : Fin n → V →ₗ[R] V) (h : W →ₗ[R] W)
    (he : ∀ i, h.comp (e i) = (e i).comp (g i))
    (x : ⨂[R] i : Fin n, (⋀[R]^(d i) V)) :
    ExteriorAlgebra.map h (assemble d e x) =
      assemble d e (PiTensorProduct.map (fun i ↦ exteriorPower.map (d i) (g i)) x) :=
  LinearMap.congr_fun (assemble_natural d e g h he) x

end PaperVerification.Fermion.NaturalExteriorTensor
end
end
end BatchFile_102

run_cmd Lean.logInfo "BATCH_SOURCE_END: PaperVerification/FermionNaturalExteriorTensor.lean"
section BatchFile_103
/- Literal source: PaperVerification/FermionNaturalColorEmbedding.lean -/


/-!
# The literal local color embeddings

Each copy of the two-dimensional color space maps to the original theta and
xi generators at its own index. Independent color changes commute with these
embeddings before any quotient or representation comparison is constructed.

-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 100000
noncomputable section
open scoped BigOperators TensorProduct

namespace PaperVerification.Fermion.NaturalColor

variable {R : Type*} [CommRing R] {n : ℕ}

/-- The local two-color space at index i, embedded in the original odd module. -/
def embedding (i : Fin n) : (Fin 2 → R) →ₗ[R] OddModule R n where
  toFun v := Sum.elim (fun j ↦ if j=i then v 0 else 0)
    (fun j ↦ if j=i then v 1 else 0)
  map_add' v w := by
    funext j
    cases j <;> simp only [Sum.elim_inl,Sum.elim_inr,Pi.add_apply] <;>
      split_ifs <;> simp
  map_smul' c v := by
    funext j
    cases j <;> simp only [Sum.elim_inl,Sum.elim_inr,Pi.smul_apply,
      smul_eq_mul,RingHom.id_apply] <;> split_ifs <;> simp

@[simp] theorem embedding_theta (i : Fin n) :
    embedding (R := R) i (Pi.single 0 1)=Pi.single (Sum.inl i) 1 := by
  classical
  funext j
  cases j <;> simp [embedding,Pi.single_apply,eq_comm]

@[simp] theorem embedding_xi (i : Fin n) :
    embedding (R := R) i (Pi.single 1 1)=Pi.single (Sum.inr i) 1 := by
  classical
  funext j
  cases j <;> simp [embedding,Pi.single_apply,eq_comm]

/-- The usual matrix action, explicitly on the original two coordinates. -/
def colorLinear (A : Matrix (Fin 2) (Fin 2) R) : (Fin 2 → R) →ₗ[R] (Fin 2 → R) where
  toFun v c := A c 0*v 0+A c 1*v 1
  map_add' v w := by funext c; simp only [Pi.add_apply]; ring
  map_smul' r v := by
    funext c
    simp only [Pi.smul_apply,smul_eq_mul,RingHom.id_apply]
    ring

@[simp] theorem colorLinear_one :
    colorLinear (1 : Matrix (Fin 2) (Fin 2) R)=LinearMap.id := by
  ext v c
  fin_cases c <;> simp [colorLinear,Matrix.one_apply]

theorem colorLinear_mul (A B : Matrix (Fin 2) (Fin 2) R) :
    colorLinear (A*B)=(colorLinear A).comp (colorLinear B) := by
  ext v c
  simp only [colorLinear,LinearMap.coe_mk,AddHom.coe_mk,LinearMap.comp_apply,
    Matrix.mul_apply,Fin.sum_univ_two]
  ring

/-- Independent matrix changes on the original theta/xi coordinates.
This is definitionally the existing ColorAction.indexLinear map. -/
def independentLinear (A : Fin n → Matrix (Fin 2) (Fin 2) R) :
    OddModule R n →ₗ[R] OddModule R n where
  toFun v := Sum.elim
    (fun i ↦ A i 0 0*v (.inl i)+A i 0 1*v (.inr i))
    (fun i ↦ A i 1 0*v (.inl i)+A i 1 1*v (.inr i))
  map_add' v w := by
    funext j
    cases j <;> simp only [Sum.elim_inl,Sum.elim_inr,Pi.add_apply] <;> ring
  map_smul' c v := by
    funext j
    cases j <;> simp only [Sum.elim_inl,Sum.elim_inr,Pi.smul_apply,
      smul_eq_mul,RingHom.id_apply] <;> ring

/-- The local/global commuting square for every matrix at every index. -/
theorem embedding_natural (A : Fin n → Matrix (Fin 2) (Fin 2) R) (i : Fin n) :
    (independentLinear A).comp (embedding i)=
      (embedding i).comp (colorLinear (A i)) := by
  classical
  ext v j
  cases j with
  | inl j =>
      by_cases h : j=i
      · subst j; simp [independentLinear,embedding,colorLinear]
      · simp [independentLinear,embedding,colorLinear,h]
  | inr j =>
      by_cases h : j=i
      · subst j; simp [independentLinear,embedding,colorLinear]
      · simp [independentLinear,embedding,colorLinear,h]

/-- Actual exterior multiplication of arbitrary prescribed local degrees. -/
def assemble (d : Fin n → ℕ) :
    (⨂[R] i : Fin n, (⋀[R]^(d i) (Fin 2 → R))) →ₗ[R]
      ExteriorAlgebra R (OddModule R n) :=
  NaturalExteriorTensor.assemble (R := R) (V := Fin 2 → R) (W := OddModule R n)
    d (embedding (R := R))

@[simp] theorem assemble_tprod (d : Fin n → ℕ)
    (x : ∀ i,⋀[R]^(d i) (Fin 2 → R)) :
    assemble d (PiTensorProduct.tprod R x)=
      (List.ofFn (fun i ↦ ExteriorAlgebra.map (embedding i) (x i))).prod :=
  NaturalExteriorTensor.assemble_tprod (R := R) (V := Fin 2 → R) (W := OddModule R n)
    d (embedding (R := R)) x

/-- The independently defined actions commute with the natural multiplication. -/
theorem assemble_natural (d : Fin n → ℕ)
    (A : Fin n → Matrix (Fin 2) (Fin 2) R)
    (x : ⨂[R] i : Fin n, (⋀[R]^(d i) (Fin 2 → R))) :
    ExteriorAlgebra.map (independentLinear A) (assemble d x)=
      assemble d (PiTensorProduct.map
        (fun i ↦ exteriorPower.map (d i) (colorLinear (A i))) x) :=
  NaturalExteriorTensor.assemble_natural_apply (R := R) (V := Fin 2 → R) (W := OddModule R n)
    d (embedding (R := R))
    (fun i ↦ colorLinear (A i)) (independentLinear A) (embedding_natural A) x

end PaperVerification.Fermion.NaturalColor
end
end
end BatchFile_103

run_cmd Lean.logInfo "BATCH_SOURCE_END: PaperVerification/FermionNaturalColorEmbedding.lean"
section BatchFile_104
/- Literal source: PaperVerification/FermionNaturalColorBasis.lean -/


/-!
# A unit comparison for the actual natural color assembly

Each tensor factor contributes its original
local exterior word.  Their concatenation contains each original odd
coordinate exactly once.  Successive exterior-basis insertions therefore
supply an actual shuffle-sign unit.  No explicit crossing-count formula is
assumed, and the final word uses the paper's theta-then-xi order.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical TensorProduct BigOperators

namespace PaperVerification.Fermion.NaturalColor

section OrderedWords

variable {R V I : Type*} [CommRing R] [AddCommGroup V] [Module R V]
  [LinearOrder I] (b : Module.Basis I R V)

private theorem exteriorBasis_empty : b.ExteriorAlgebra (∅ : Finset I)=1 := by
  rw [Module.Basis.exteriorAlgebra_eq_prod_map_sort]
  simp

/-- Any duplicate-free ordering of a fixed basis subset differs from its
sorted exterior basis word by an actual unit of the coefficient ring. -/
theorem orderedWord_basis_unit (l : List I) (hl : l.Nodup) :
    ∃ ε : Rˣ,(l.map (fun i ↦ ExteriorAlgebra.ι R (b i))).prod=
      (ε : R) • b.ExteriorAlgebra l.toFinset := by
  induction l with
  | nil =>
      refine ⟨1,?_⟩
      simp only [List.map_nil,List.prod_nil,List.toFinset_nil,Units.val_one,
        one_smul,exteriorBasis_empty]
  | cons i l ih =>
      have hi : i∉l := (List.nodup_cons.mp hl).1
      have hli : l.Nodup := (List.nodup_cons.mp hl).2
      have hiset : i∉l.toFinset := by simpa only [List.mem_toFinset] using hi
      obtain ⟨ε,hε⟩ := ih hli
      let sign := TauCeti.ExteriorAlgebra.basisEraseSign i (insert i l.toFinset)
      let η : Rˣ := Units.map (Int.castRingHom R).toMonoidHom sign
      have hp : ExteriorAlgebra.ι R (b i)*b.ExteriorAlgebra l.toFinset=
          (η : R) • b.ExteriorAlgebra (insert i l.toFinset) := by
        have h := TauCeti.ExteriorAlgebra.basis_singleton_mul_basis_erase b i
          (insert i l.toFinset) (Finset.mem_insert_self _ _)
        rw [TauCeti.ExteriorAlgebra.basis_singleton,Finset.erase_insert hiset] at h
        change ExteriorAlgebra.ι R (b i)*b.ExteriorAlgebra l.toFinset=
          ((sign : ℤ) : R) • b.ExteriorAlgebra (insert i l.toFinset)
        simpa only [sign,Units.smul_def,Int.cast_smul_eq_zsmul] using h
      refine ⟨ε*η,?_⟩
      simp only [List.map_cons,List.prod_cons,List.toFinset_cons,hε,Units.val_mul]
      rw [Algebra.mul_smul_comm,hp,smul_smul]

end OrderedWords

section Lists

variable {n : ℕ}
open Endpoint Paths ColorPaths

def localWord (i : Fin n) : Mark → List (OddIndex n)
  | .unmarked => []
  | .theta => [.inl i]
  | .xi => [.inr i]
  | .double => [.inl i,.inr i]

@[simp] theorem localWord_nodup (i : Fin n) (a : Mark) :
    (localWord i a).Nodup := by
  cases a <;> simp [localWord]

@[simp] theorem localWord_mem_inl (i j : Fin n) (a : Mark) :
    Sum.inl j∈localWord i a ↔ j=i ∧ (a=.theta ∨ a=.double) := by
  cases a <;> simp [localWord]

@[simp] theorem localWord_mem_inr (i j : Fin n) (a : Mark) :
    Sum.inr j∈localWord i a ↔ j=i ∧ (a=.xi ∨ a=.double) := by
  cases a <;> simp [localWord]

theorem localWord_index {i : Fin n} {a : Mark} {j : OddIndex n}
    (hj : j∈localWord i a) : Sum.elim id id j=i := by
  cases j with
  | inl j => exact (localWord_mem_inl i j a).mp hj |>.1
  | inr j => exact (localWord_mem_inr i j a).mp hj |>.1

/-- Increasing index order, and theta before xi within one index. -/
def orderedColorWord (marks : Fin n → Mark) : List (OddIndex n) :=
  (List.finRange n).flatMap (fun i ↦ localWord i (marks i))

theorem orderedColorWord_nodup (marks : Fin n → Mark) :
    (orderedColorWord marks).Nodup := by
  rw [orderedColorWord,List.nodup_flatMap]
  refine ⟨fun i hi ↦ localWord_nodup i (marks i),?_⟩
  apply (List.nodup_finRange n).imp
  intro i j hij
  intro x hxi hxj
  exact hij ((localWord_index hxi).symm.trans (localWord_index hxj))

theorem orderedColorWord_toFinset (marks : Fin n → Mark) :
    (orderedColorWord marks).toFinset=wordOfMarks marks := by
  ext a
  cases a with
  | inl i =>
      simp only [List.mem_toFinset,orderedColorWord,List.mem_flatMap,
        List.mem_finRange,localWord_mem_inl,wordOfMarks_inl,true_and]
      simp
  | inr i =>
      simp only [List.mem_toFinset,orderedColorWord,List.mem_flatMap,
        List.mem_finRange,localWord_mem_inr,wordOfMarks_inr,true_and]
      simp

private theorem prod_map_flatMap {A B C : Type*} [Monoid C]
    (l : List A) (w : A → List B) (f : B → C) :
    ((l.flatMap w).map f).prod=(l.map (fun i ↦ ((w i).map f).prod)).prod := by
  induction l with
  | nil => simp
  | cons i l ih =>
      simp only [List.flatMap_cons,List.map_append,List.prod_append,
        List.map_cons,List.prod_cons,ih]

end Lists

section ColorBasis

open Endpoint Paths ColorPaths
variable {R : Type*} [CommRing R] {n : ℕ}

local instance paperOddOrder : LinearOrder (OddIndex n) :=
  LinearOrder.lift' Exterior.modeRank Exterior.modeRank_injective

private theorem embedding_basis_theta (i : Fin n) :
    embedding (R := R) i ((Pi.basisFun R (Fin 2)) 0)=
      (Pi.basisFun R (OddIndex n)) (.inl i) := by
  funext j
  cases j <;> simp [embedding,Pi.basisFun_apply,Pi.single_apply,eq_comm]

private theorem embedding_basis_xi (i : Fin n) :
    embedding (R := R) i ((Pi.basisFun R (Fin 2)) 1)=
      (Pi.basisFun R (OddIndex n)) (.inr i) := by
  funext j
  cases j <;> simp [embedding,Pi.basisFun_apply,Pi.single_apply,eq_comm]

private theorem localExteriorBasis_image (m : MultiplicityVector n)
    (T : MultiplicityColoring m) (i : Fin n) :
    ExteriorAlgebra.map (embedding (R := R) i)
      ((Pi.basisFun R (Fin 2)).exteriorPower (m i).val
        ((coloringExteriorIndexEquiv m T) i))=
      ((localWord i (wordMark T.val i)).map
        (fun j ↦ ExteriorAlgebra.ι R ((Pi.basisFun R (OddIndex n)) j))).prod := by
  rw [←ExteriorAlgebra.basis_eq_coe_basis]
  change ExteriorAlgebra.map (embedding (R := R) i)
      ((Pi.basisFun R (Fin 2)).ExteriorAlgebra (markSubset (wordMark T.val i)))=_
  generalize ha : wordMark T.val i=a
  cases a with
  | unmarked =>
      simp only [markSubset,localWord,exteriorBasis_empty,map_one,
        List.map_nil,List.prod_nil]
  | theta =>
      simp only [markSubset,localWord,TauCeti.ExteriorAlgebra.basis_singleton,
        ExteriorAlgebra.map_apply_ι,embedding_basis_theta,List.map_cons,
        List.map_nil,List.prod_cons,List.prod_nil,mul_one]
  | xi =>
      simp only [markSubset,localWord,TauCeti.ExteriorAlgebra.basis_singleton,
        ExteriorAlgebra.map_apply_ι,embedding_basis_xi,List.map_cons,
        List.map_nil,List.prod_cons,List.prod_nil,mul_one]
  | double =>
      rw [show markSubset Mark.double=({0,1} : Finset (Fin 2)) from rfl,
        TauCeti.ExteriorAlgebra.basis_pair (Pi.basisFun R (Fin 2)) (by decide : (0 : Fin 2)<1),
        map_mul,ExteriorAlgebra.map_apply_ι,ExteriorAlgebra.map_apply_ι,
        embedding_basis_theta,embedding_basis_xi]
      simp only [localWord,List.map_cons,List.map_nil,List.prod_cons,List.prod_nil,mul_one]

/-- The actual tensor basis assembles to the ordered list of its original
odd generators. This is a calculation in the original exterior algebra. -/
theorem assemble_basis_word (m : MultiplicityVector n) (T : MultiplicityColoring m) :
    assemble (fun i ↦ (m i).val) (exteriorColorTensorBasis R m T)=
      ((orderedColorWord (wordMark T.val)).map
        (fun j ↦ ExteriorAlgebra.ι R ((Pi.basisFun R (OddIndex n)) j))).prod := by
  rw [exteriorColorTensorBasis_apply,assemble_tprod]
  simp_rw [localExteriorBasis_image]
  rw [List.ofFn_eq_map]
  exact (prod_map_flatMap (List.finRange n)
    (fun i ↦ localWord i (wordMark T.val i))
    (fun j ↦ ExteriorAlgebra.ι R ((Pi.basisFun R (OddIndex n)) j))).symm

/-- Assembly has an invertible diagonal coefficient relative to the paper's
actual theta-then-xi exterior basis; no explicit sign formula is required. -/
