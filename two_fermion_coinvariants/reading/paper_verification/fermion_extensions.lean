/-- The conclusion is an algebra equivalence from the literal tensor fiber. -/
def fiberAlgEquiv
    (hone : (1 : B)=∑ i,(Polynomial.monomial (weight i) (b.repr 1 i)).eval c • b₀ i)
    (hmul₀ : ∀ i j,b₀ i*b₀ j=
