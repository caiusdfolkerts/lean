  scalarExteriorBaseChange F (PolynomialRing F n)
    (d.toSeparatedOrdinaryData.LocalOrdinary rho) (OddIndex n)

@[simp] theorem localAmbientEquiv_theta (rho : d.toSeparatedOrdinaryData.SupportPoint)
    (i : Fin n) :
