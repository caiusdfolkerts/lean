        Localization.AtPrime m.asIdeal ⊗[d.toSeparatedOrdinaryData.Ordinary] d.SuperQuotient :=
  centralArtinianProductEquiv d.toSeparatedOrdinaryData.Ordinary d.SuperQuotient

