    (fiberLinearEquiv_one b weight hmul c b₀ hone)
    (fiberLinearEquiv_mul b weight hmul c b₀ hmul₀)

@[simp] theorem fiberAlgEquiv_basis
    (hone : (1 : B)=∑ i,(Polynomial.monomial (weight i) (b.repr 1 i)).eval c • b₀ i)
