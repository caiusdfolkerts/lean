    letI := targetEvaluation (B := B) c
    letI := evaluationTower (B := B) c
    K ⊗[Polynomial K] algebra b weight hmul ≃ₐ[K] B := by
  letI := scalarEvaluation c
  letI := targetEvaluation (B := B) c
  letI := evaluationTower (B := B) c
