@[simp] theorem ordinaryToSuper_mk (p : PolynomialRing F n) :
    d.ordinaryToSuper (d.toSeparatedOrdinaryData.ordinaryMk p)=
      @algebraMap (PolynomialRing F n) d.SuperQuotient _ _
