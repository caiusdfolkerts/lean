section BatchFile_107
/- Literal source: PaperVerification/FermionDescendingGradedAction.lean -/


/-!
# The action induced on actual successive filtration quotients

A filtration-preserving algebra map acts on F_d/F_(d+1) by mapping its
representative.  These maps give an algebra map of the actual direct sum.
Their identity and composition laws are checked on quotient representatives,
so group actions are induced by the original action without transport through
an initial-algebra identification.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped DirectSum

namespace PaperVerification.Fermion.DescendingAlgebra

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- Restriction of the original algebra map to an actual filtration piece. -/
def filteredMap (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) (d : ℕ) :
    f.piece d →ₗ[R] f.piece d where
  toFun x := ⟨e x,he d x x.property⟩
  map_add' x y := Subtype.ext (map_add e (x : A) (y : A))
  map_smul' c x := Subtype.ext (map_smul e c (x : A))

/-- The map on the actual quotient F_d/F_(d+1). -/
def pieceMap (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) (d : ℕ) :
    GradedPiece f d →ₗ[R] GradedPiece f d :=
  (nextRestricted f d).mapQ (nextRestricted f d) (filteredMap f e he d)
    (fun x hx ↦ he (d+1) x hx)

@[simp] theorem pieceMap_mk (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) (d : ℕ) (x : f.piece d) :
    pieceMap f e he d (Submodule.Quotient.mk x)=
      Submodule.Quotient.mk (⟨e x,he d x x.property⟩ : f.piece d) := rfl

theorem pieceMap_one (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) :
    pieceMap f e he 0 (gradedOne f)=gradedOne f := by
  rw [gradedOne_def,pieceMap_mk]
  apply congrArg Submodule.Quotient.mk
  apply Subtype.ext
  exact map_one e

theorem pieceMap_mul (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) (i j : ℕ)
    (x : GradedPiece f i) (y : GradedPiece f j) :
    pieceMap f e he (i+j) (gradedMul f i j x y)=
      gradedMul f i j (pieceMap f e he i x) (pieceMap f e he j y) := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      induction y using Submodule.Quotient.induction_on with
      | _ y =>
          rw [gradedMul_apply_mk,pieceMap_mk,pieceMap_mk,pieceMap_mk,gradedMul_apply_mk]
          apply congrArg Submodule.Quotient.mk
          apply Subtype.ext
          exact map_mul e (x : A) (y : A)

/-- The induced algebra map is assembled from the original representative maps. -/
def associatedMap (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) :
    AssociatedGraded f →ₐ[R] AssociatedGraded f :=
  DirectSum.toAlgebra R _
    (fun d ↦ (DirectSum.lof R ℕ (GradedPiece f) d).comp (pieceMap f e he d))
    (by
      change DirectSum.of (GradedPiece f) 0 (pieceMap f e he 0 (gradedOne f))=1
      rw [pieceMap_one,associatedGraded_of_gradedOne])
    (by
      intro i j x y
      change DirectSum.of (GradedPiece f) (i+j)
          (pieceMap f e he (i+j) (gradedMul f i j x y))=
        DirectSum.of (GradedPiece f) i (pieceMap f e he i x)*
          DirectSum.of (GradedPiece f) j (pieceMap f e he j y)
      rw [associatedGraded_of_mul_of,pieceMap_mul])

@[simp] theorem associatedMap_of (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) (d : ℕ) (x : GradedPiece f d) :
    associatedMap f e he (DirectSum.of (GradedPiece f) d x)=
      DirectSum.of (GradedPiece f) d (pieceMap f e he d x) :=
  DirectSum.toAddMonoid_of _ d x

@[simp] theorem associatedMap_of_mk (f : Filtration R A) (e : A →ₐ[R] A)
    (he : ∀ d x,x∈f.piece d → e x∈f.piece d) (d : ℕ) (x : f.piece d) :
    associatedMap f e he (DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk x))=
      DirectSum.of (GradedPiece f) d
        (Submodule.Quotient.mk (⟨e x,he d x x.property⟩ : f.piece d)) := by
  rw [associatedMap_of,pieceMap_mk]

/-- Every filtration-preserving automorphism induces its actual graded automorphism. -/
def associatedEquiv (f : Filtration R A) (e : A ≃ₐ[R] A)
    (he : ∀ d x,e x∈f.piece d ↔ x∈f.piece d) :
    AssociatedGraded f ≃ₐ[R] AssociatedGraded f :=
  let hf : ∀ d x,x∈f.piece d → e x∈f.piece d :=
    fun d x hx ↦ (he d x).mpr hx
  let hb : ∀ d x,x∈f.piece d → e.symm x∈f.piece d :=
    fun d x hx ↦ (he d (e.symm x)).mp (by simpa only [e.apply_symm_apply] using hx)
  let forward := associatedMap f e.toAlgHom hf
  let backward := associatedMap f e.symm.toAlgHom hb
  AlgEquiv.ofAlgHom forward backward
    (by
      apply DirectSum.algHom_ext
      intro d x
      induction x using Submodule.Quotient.induction_on with
      | _ x =>
          change forward (backward (DirectSum.of (GradedPiece f) d
            (Submodule.Quotient.mk x)))=
              DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk x)
          let x' : f.piece d := ⟨e.symm (x : A),hb d x x.property⟩
          have hback : backward (DirectSum.of (GradedPiece f) d
              (Submodule.Quotient.mk x))=
                DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk x') :=
            associatedMap_of_mk f e.symm.toAlgHom hb d x
          have hforward := associatedMap_of_mk f e.toAlgHom hf d x'
          refine (congrArg forward hback).trans (hforward.trans ?_)
          apply congrArg (fun y : f.piece d ↦
            DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk y))
          apply Subtype.ext
          exact e.apply_symm_apply (x : A))
    (by
      apply DirectSum.algHom_ext
      intro d x
      induction x using Submodule.Quotient.induction_on with
      | _ x =>
          change backward (forward (DirectSum.of (GradedPiece f) d
            (Submodule.Quotient.mk x)))=
              DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk x)
          let x' : f.piece d := ⟨e (x : A),hf d x x.property⟩
          have hforward : forward (DirectSum.of (GradedPiece f) d
              (Submodule.Quotient.mk x))=
                DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk x') :=
            associatedMap_of_mk f e.toAlgHom hf d x
          have hback := associatedMap_of_mk f e.symm.toAlgHom hb d x'
          refine (congrArg backward hforward).trans (hback.trans ?_)
          apply congrArg (fun y : f.piece d ↦
            DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk y))
          apply Subtype.ext
          exact e.symm_apply_apply (x : A))

@[simp] theorem associatedEquiv_of_mk (f : Filtration R A) (e : A ≃ₐ[R] A)
    (he : ∀ d x,e x∈f.piece d ↔ x∈f.piece d) (d : ℕ) (x : f.piece d) :
    associatedEquiv f e he (DirectSum.of (GradedPiece f) d (Submodule.Quotient.mk x))=
      DirectSum.of (GradedPiece f) d
        (Submodule.Quotient.mk (⟨e x,(he d x).mpr x.property⟩ : f.piece d)) :=
  associatedMap_of_mk f e.toAlgHom (fun d x hx ↦ (he d x).mpr hx) d x

/-- The induced action comes directly from the original action on each quotient. -/
def associatedAction {G : Type*} [Group G] (f : Filtration R A)
    (rho : G →* (A ≃ₐ[R] A))
    (hrho : ∀ g d x,rho g x∈f.piece d ↔ x∈f.piece d) :
    G →* (AssociatedGraded f ≃ₐ[R] AssociatedGraded f) where
  toFun g := associatedEquiv f (rho g) (hrho g)
  map_one' := by
    apply AlgEquiv.coe_toAlgHom_injective
    apply DirectSum.algHom_ext
    intro d x
    induction x using Submodule.Quotient.induction_on with
    | _ x =>
        change associatedEquiv f (rho 1) (hrho 1) (DirectSum.of _ d (Submodule.Quotient.mk x))=_
        simp only [associatedEquiv_of_mk,map_one,AlgEquiv.one_apply,AlgEquiv.coe_toAlgHom]
  map_mul' g h := by
    apply AlgEquiv.coe_toAlgHom_injective
    apply DirectSum.algHom_ext
    intro d x
    induction x using Submodule.Quotient.induction_on with
    | _ x =>
        change associatedEquiv f (rho (g*h)) (hrho (g*h))
          (DirectSum.of _ d (Submodule.Quotient.mk x))=
          associatedEquiv f (rho g) (hrho g)
            (associatedEquiv f (rho h) (hrho h) (DirectSum.of _ d (Submodule.Quotient.mk x)))
        simp only [associatedEquiv_of_mk,map_mul,AlgEquiv.mul_apply]

end PaperVerification.Fermion.DescendingAlgebra
end
end
end BatchFile_107

run_cmd Lean.logInfo "BATCH_SOURCE_END: PaperVerification/FermionDescendingGradedAction.lean"
section BatchFile_108
/- Literal source: PaperVerification/FermionDescendingBasisComparison.lean -/


/-!
# Actual descending graded pieces and the zero-weight product

The source is the direct sum of the actual quotients F_d/F_(d+1). Component
projection identifies each quotient with its homogeneous basis submodule.
The resulting algebra comparison retains exactly the structure constants
whose weight is the sum of the input weights. These are proved conditions,
not definitions of either the original or target algebra.

-/

@[expose] public section
set_option autoImplicit false
noncomputable section
open scoped Classical BigOperators DirectSum

namespace PaperVerification.Fermion.DescendingBasis

open BasisFiltered DescendingAlgebra

variable {K A I : Type*} [CommRing K] [Ring A] [Algebra K A] [Fintype I]
  (b : Module.Basis I K A) (w : I → ℕ) (hmul : WeightRees.Multiplicative b w)

include hmul in
/-- The actual basis tail is multiplicative in the original algebra. -/
theorem tail_mul {d e : ℕ} {x y : A}
    (hx : x∈BlockInitial.lowerSubmodule b w d)
    (hy : y∈BlockInitial.lowerSubmodule b w e) :
    x*y∈BlockInitial.lowerSubmodule b w (d+e) := by
  rw [←b.sum_repr x,←b.sum_repr y,Finset.sum_mul]
  apply Submodule.sum_mem
  intro i hi
  rw [Finset.mul_sum]
  apply Submodule.sum_mem
  intro j hj
  by_cases hxi : b.repr x i=0
  · simp only [hxi,zero_smul,zero_mul]
    exact Submodule.zero_mem _
  by_cases hyj : b.repr y j=0
  · simp only [hyj,zero_smul,mul_zero]
    exact Submodule.zero_mem _
  rw [smul_mul_smul_comm]
  apply Submodule.smul_mem
  intro k hk
  exact (Nat.add_le_add (hx i hxi) (hy j hyj)).trans (hmul i j k hk)

/-- No quotient or candidate initial algebra occurs in this filtration. -/
def filtration : DescendingAlgebra.Filtration K A where
  piece := BlockInitial.lowerSubmodule b w
  antitone := fun d e h x hx i hi ↦ h.trans (hx i hi)
  one_mem := fun i hi ↦ Nat.zero_le _
  mul_mem := tail_mul b w hmul

/-- Project an actual filtered element to its degree-d basis component. -/
def componentMap (d : ℕ) :
    (filtration b w hmul).piece d →ₗ[K] homogeneousPiece b w d where
  toFun x := ⟨component b w d x,homogeneous_component b w d x⟩
  map_add' x y := Subtype.ext ((component b w d).map_add x y)
  map_smul' r x := Subtype.ext ((component b w d).map_smul r x)

/-- The kernel is exactly the next filtration step, not a presumed initial ideal. -/
theorem componentMap_ker (d : ℕ) :
    LinearMap.ker (componentMap b w hmul d)=
      nextRestricted (filtration b w hmul) d := by
  ext x
  rw [LinearMap.mem_ker]
  change componentMap b w hmul d x=0 ↔
    BlockInitial.LowerBound b w (d+1) (x : A)
  constructor
  · intro hz i hi
    have hd := x.property i hi
    have hne : w i≠d := by
      intro he
      have h := congrArg (fun z : homogeneousPiece b w d ↦ b.repr z i) hz
      change b.repr (component b w d x) i=b.repr 0 i at h
      rw [repr_component,if_pos he,map_zero,Finsupp.zero_apply] at h
      exact hi h
    omega
  · intro hx
    apply Subtype.ext
    apply b.repr.injective
    ext i
    change b.repr (component b w d x) i=b.repr 0 i
    rw [repr_component,map_zero,Finsupp.zero_apply]
    by_cases he : w i=d
    · rw [if_pos he]
      by_contra hi
      have h := hx i hi
      omega
    · rw [if_neg he]

theorem componentMap_surjective (d : ℕ) :
    Function.Surjective (componentMap b w hmul d) := by
  intro y
  have hy : (y : A)∈(filtration b w hmul).piece d :=
    fun i hi ↦ (y.property i hi).ge
  refine ⟨⟨y,hy⟩,?_⟩
  apply Subtype.ext
  change component b w d y=y
  rw [component_of_homogeneous b w y.property,if_pos rfl]

/-- The degree-piece comparison is the first isomorphism theorem for the
actual component map, with its kernel proved above. -/
def pieceEquiv (d : ℕ) :
    GradedPiece (filtration b w hmul) d ≃ₗ[K] homogeneousPiece b w d :=
  (Submodule.quotEquivOfEq _ _ (componentMap_ker b w hmul d).symm).trans
    ((componentMap b w hmul d).quotKerEquivOfSurjective
      (componentMap_surjective b w hmul d))

@[simp] theorem pieceEquiv_mk (d : ℕ) (x : (filtration b w hmul).piece d) :
    (pieceEquiv b w hmul d (Submodule.Quotient.mk x) : A)=component b w d x := by
  simp only [pieceEquiv,LinearEquiv.trans_apply,Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk]
  rfl

/-- The ungraded module is the internal sum of its actual basis components. -/
theorem homogeneous_internal : DirectSum.IsInternal (homogeneousPiece b w) := by
  have h := BasisFiltered.homogeneousQuotient_isInternal b w
    (LinearMap.id : A →ₗ[K] A) b b w
    (fun i ↦ homogeneous_basis b w i) (fun i ↦ rfl)
    (fun d x hx ↦ by
      have hx0 : x=0 := hx
      subst x
      simp only [map_zero,Submodule.zero_mem])
  simpa only [Submodule.map_id] using h

/-- Every actual graded piece is retained, including every zero piece. -/
def totalEquiv : AssociatedGraded (filtration b w hmul) ≃ₗ[K] A :=
  (DirectSum.congrLinearEquiv (pieceEquiv b w hmul)).trans
    (LinearEquiv.ofBijective (DirectSum.coeLinearMap (homogeneousPiece b w))
      (homogeneous_internal b w))

@[simp] theorem totalEquiv_of_mk (d : ℕ) (x : (filtration b w hmul).piece d) :
    totalEquiv b w hmul
      (DirectSum.of (GradedPiece (filtration b w hmul)) d (Submodule.Quotient.mk x))=
      component b w d x := by
  change DirectSum.coeLinearMap (homogeneousPiece b w)
    (DirectSum.lmap (fun k ↦ (pieceEquiv b w hmul k).toLinearMap)
      (DirectSum.of (GradedPiece (filtration b w hmul)) d (Submodule.Quotient.mk x)))=_
  rw [DirectSum.lmap_of,DirectSum.coeLinearMap_of]
  exact pieceEquiv_mk b w hmul d x

theorem basis_mem_tail (i : I) : b i∈(filtration b w hmul).piece (w i) := by
  change BlockInitial.LowerBound b w (w i) (b i)
  simpa only [one_smul] using BlockInitial.lowerBound_single (b := b) (weight := w) i (1 : K)

@[simp] theorem totalEquiv_symm_basis (i : I) :
    (totalEquiv b w hmul).symm (b i)=
      DirectSum.of (GradedPiece (filtration b w hmul)) (w i)
        (Submodule.Quotient.mk ⟨b i,basis_mem_tail b w hmul i⟩) := by
  apply (totalEquiv b w hmul).injective
  rw [LinearEquiv.apply_symm_apply,totalEquiv_of_mk,
    component_of_homogeneous b w (homogeneous_basis b w i),if_pos rfl]

/-- An actual basis of the direct sum of filtration quotients. -/
def gradedBasis : Module.Basis I K (AssociatedGraded (filtration b w hmul)) :=
  b.map (totalEquiv b w hmul).symm

@[simp] theorem gradedBasis_apply (i : I) :
    gradedBasis b w hmul i=
      DirectSum.of (GradedPiece (filtration b w hmul)) (w i)
        (Submodule.Quotient.mk ⟨b i,basis_mem_tail b w hmul i⟩) := by
  rw [gradedBasis,Module.Basis.map_apply,totalEquiv_symm_basis]

section Target

variable {B : Type*} [Ring B] [Algebra K B] (c : Module.Basis I K B)

def comparison : AssociatedGraded (filtration b w hmul) ≃ₗ[K] B :=
  (totalEquiv b w hmul).trans (b.equiv c (Equiv.refl I))

@[simp] theorem comparison_basis (i : I) :
    comparison b w hmul c (gradedBasis b w hmul i)=c i := by
  simp only [comparison,gradedBasis,Module.Basis.map_apply,LinearEquiv.trans_apply,
    LinearEquiv.apply_symm_apply,Module.Basis.equiv_apply,Equiv.refl_apply]

theorem equiv_component (d : ℕ) (x : A) :
    b.equiv c (Equiv.refl I) (component b w d x)=
      ∑ i,if w i=d then b.repr x i • c i else 0 := by
  rw [←b.sum_repr (component b w d x),map_sum]
  simp only [map_smul,Module.Basis.equiv_apply,Equiv.refl_apply,repr_component]
  apply Finset.sum_congr rfl
  intro i hi
  split_ifs <;> simp only [zero_smul]

theorem comparison_one
    (hone : (1 : B)=∑ i,if w i=0 then b.repr 1 i • c i else 0) :
    comparison b w hmul c 1=1 := by
  rw [←associatedGraded_of_gradedOne,gradedOne_def]
  change b.equiv c (Equiv.refl I)
    (totalEquiv b w hmul
      (DirectSum.of (GradedPiece (filtration b w hmul)) 0
        (Submodule.Quotient.mk ⟨1,one_mem_filtration _⟩)))=1
  rw [totalEquiv_of_mk,equiv_component]
  exact hone.symm

theorem comparison_basis_mul
    (hprod : ∀ i j,c i*c j=∑ k,
      if w k=w i+w j then b.repr (b i*b j) k • c k else 0) (i j : I) :
    comparison b w hmul c (gradedBasis b w hmul i*gradedBasis b w hmul j)=c i*c j := by
  rw [gradedBasis_apply,gradedBasis_apply,associatedGraded_of_mul_of,gradedMul_apply_mk]
  change b.equiv c (Equiv.refl I)
    (totalEquiv b w hmul
      (DirectSum.of (GradedPiece (filtration b w hmul)) (w i+w j)
        (Submodule.Quotient.mk ⟨b i*b j,_⟩)))=c i*c j
  rw [totalEquiv_of_mk,equiv_component]
  exact (hprod i j).symm

theorem comparison_mul
    (hprod : ∀ i j,c i*c j=∑ k,
      if w k=w i+w j then b.repr (b i*b j) k • c k else 0)
    (x y : AssociatedGraded (filtration b w hmul)) :
    comparison b w hmul c (x*y)=comparison b w hmul c x*comparison b w hmul c y := by
  let E := comparison b w hmul c
  let B := gradedBasis b w hmul
  have hgen (i j : I) : E (B i*B j)=E (B i)*E (B j) := by
    simpa only [E,B,comparison_basis] using comparison_basis_mul b w hmul c hprod i j
  have hx := B.mem_span x
  have hy := B.mem_span y
  have hright (i : I) : E (B i*y)=E (B i)*E y := by
    induction hy using Submodule.span_induction with
    | mem z hz => obtain ⟨j,rfl⟩ := hz; exact hgen i j
    | zero => simp only [mul_zero,map_zero]
    | add z t hz ht ihz iht => simp only [mul_add,map_add,ihz,iht]
    | smul r z hz ih => simp only [mul_smul_comm,map_smul,ih]
  induction hx using Submodule.span_induction with
  | mem z hz => obtain ⟨i,rfl⟩ := hz; exact hright i
  | zero => simp only [zero_mul,map_zero]
  | add z t hz ht ihz iht => simp only [add_mul,map_add,ihz,iht]
  | smul r z hz ih =>
      change E ((r • z)*y)=E (r • z)*E y
      calc
        E ((r • z)*y)=E (r • (z*y)) :=
          congrArg E (Algebra.smul_mul_assoc r z y)
        _=r • E (z*y) := E.map_smul r (z*y)
        _=r • (E z*E y) := congrArg (fun t ↦ r • t) ih
        _=E (r • z)*E y := by
          rw [E.map_smul]
          exact (Algebra.smul_mul_assoc r (E z) (E y)).symm

/-- An algebra equivalence from the independently constructed associated
graded, once the target's actual unit and products have been proved. -/
def comparisonAlgEquiv
    (hone : (1 : B)=∑ i,if w i=0 then b.repr 1 i • c i else 0)
    (hprod : ∀ i j,c i*c j=∑ k,
      if w k=w i+w j then b.repr (b i*b j) k • c k else 0) :
    AssociatedGraded (filtration b w hmul) ≃ₐ[K] B :=
  AlgEquiv.ofLinearEquiv (comparison b w hmul c)
    (comparison_one b w hmul c hone) (comparison_mul b w hmul c hprod)

end Target
end PaperVerification.Fermion.DescendingBasis
end
end
end BatchFile_108

run_cmd Lean.logInfo "BATCH_SOURCE_END: PaperVerification/FermionDescendingBasisComparison.lean"
section BatchFile_109
/- Literal source: PaperVerification/FermionMultiplicityAssociatedGraded.lean -/


/-!
# The actual associated graded for smallest multiplicity weights

This is the direct sum of F_d/F_(d+1), with the product induced from the
original moment quotient. The filtration is rigorously identified with the
independently defined ambient-image filtration. The comparison with the
smallest-weight initial quotient uses the already proved exact structure
constants and is an algebra equivalence, not a dimension equality.

-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped Classical BigOperators DirectSum

namespace PaperVerification.Fermion


open MvPolynomial Exterior

variable {F : Type*} [Field F] {n : ℕ}

local instance FermionMultiplicityAssociatedGraded_localInst_1 : LinearOrder (OddIndex n) :=
  LinearOrder.lift' modeRank modeRank_injective

/-- This multiplicative filtration is constructed from the actual quotient
basis; the next theorem proves it equals the original ambient-image filtration. -/
abbrev strictMultiplicityDescendingFiltration (d : StrictData (K := F) (n := n)) :
    DescendingAlgebra.Filtration F (StrictQuotient d.beta d.phi) :=
  DescendingBasis.filtration (K := F) (A := StrictQuotient d.beta d.phi)
    (strictCoupledBasis d) (strictBasisMultiplicityWeight d)
    (strictBasisMultiplicityWeight_multiplicative d)

theorem strictMultiplicityDescendingFiltration_piece
    (d : StrictData (K := F) (n := n)) (r : ℕ) :
    (strictMultiplicityDescendingFiltration d).piece r=strictMultiplicityFiltration d r :=
  (strictMultiplicityFiltration_eq_basisTail d r).symm

/-- The actual direct sum of successive descending-filtration quotients. -/
abbrev StrictMultiplicityAssociatedGraded (d : StrictData (K := F) (n := n)) :=
  DescendingAlgebra.AssociatedGraded (strictMultiplicityDescendingFiltration d)

set_option maxHeartbeats 1000000 in
/-- All structure constants and the unit are inherited from the actual
initial algebra and were proved independently before this comparison. -/
def strictMultiplicityAssociatedGradedEquiv (d : StrictData (K := F) (n := n)) :
    StrictMultiplicityAssociatedGraded d ≃ₐ[F] StrictMultiplicityInitialQuotient d := by
  let b := strictCoupledBasis d
  let w := strictBasisMultiplicityWeight d
  have hweight := strictBasisMultiplicityWeight_multiplicative d
  let c := strictMultiplicityInitialBasis d
  let makeEquiv := DescendingBasis.comparisonAlgEquiv
    (K := F) (A := StrictQuotient d.beta d.phi) (I := StrictPowerIndex d.r)
    (B := StrictMultiplicityInitialQuotient d)
    (b := b) (w := w) (hmul := hweight) (c := c)
  let e := makeEquiv
    (by
      dsimp only [b,w,c]
      rw [strictInitial_basis_one d]
      apply Finset.sum_congr rfl
      intro i hi
      rw [WeightRees.unitPolynomial_eval_zero (K := F)
        (A := StrictQuotient d.beta d.phi) (strictCoupledBasis d)
        (strictBasisMultiplicityWeight d) i]
      split_ifs <;> simp only [zero_smul])
    (by
      dsimp only [b,w,c]
      intro i j
      rw [strictInitial_basis_mul d i j]
      apply Finset.sum_congr rfl
      intro k hk
      rw [WeightRees.multiplicationPolynomial_eval_zero (K := F)
        (A := StrictQuotient d.beta d.phi) (strictCoupledBasis d)
        (strictBasisMultiplicityWeight d) (strictBasisMultiplicityWeight_multiplicative d) i j k]
      split_ifs <;> simp only [zero_smul])
  exact e

/-- The comparison takes the actual graded class of each original basis
representative to its actual initial class, with exactly the same weight. -/
@[simp] theorem strictMultiplicityAssociatedGradedEquiv_basis
    (d : StrictData (K := F) (n := n)) (i : StrictPowerIndex d.r) :
    strictMultiplicityAssociatedGradedEquiv d
      (DescendingBasis.gradedBasis (K := F) (A := StrictQuotient d.beta d.phi)
        (strictCoupledBasis d) (strictBasisMultiplicityWeight d)
        (strictBasisMultiplicityWeight_multiplicative d) i)=
      strictMultiplicityInitialBasis d i :=
  DescendingBasis.comparison_basis _ _ _ _ i

/-- The full quotient representatives determine the comparison in every
degree; larger weights are exactly those killed by the next-step quotient. -/
theorem strictMultiplicityAssociatedGradedEquiv_of_mk
    (d : StrictData (K := F) (n := n)) (r : ℕ)
    (x : (strictMultiplicityDescendingFiltration d).piece r) :
    strictMultiplicityAssociatedGradedEquiv d
      (DirectSum.of (DescendingAlgebra.GradedPiece (strictMultiplicityDescendingFiltration d))
        r (Submodule.Quotient.mk x))=
      ∑ i : StrictPowerIndex d.r,
        if strictBasisMultiplicityWeight d i=r then
          (strictCoupledBasis d).repr x i • strictMultiplicityInitialBasis d i else 0 := by
  change (strictCoupledBasis d).equiv (strictMultiplicityInitialBasis d)
    (Equiv.refl (StrictPowerIndex d.r))
    (DescendingBasis.totalEquiv _ _ _ (DirectSum.of _ r (Submodule.Quotient.mk x)))=_
  rw [DescendingBasis.totalEquiv_of_mk]
  have hx := DescendingBasis.equiv_component (K := F)
    (A := StrictQuotient d.beta d.phi) (I := StrictPowerIndex d.r)
    (B := StrictMultiplicityInitialQuotient d)
    (b := strictCoupledBasis d) (w := strictBasisMultiplicityWeight d)
    (c := strictMultiplicityInitialBasis d) r (x : StrictQuotient d.beta d.phi)
  exact hx

end PaperVerification.Fermion
end
end
end BatchFile_109

