module

public import Mathlib.LinearAlgebra.Quotient.Bilinear
public import Mathlib.LinearAlgebra.TensorProduct.Submodule
public import Mathlib.Algebra.DirectSum.Algebra
public import Lean.Elab.Tactic.Omega

@[expose] public section
set_option autoImplicit false

open scoped DirectSum

universe u w

namespace PaperVerification.Fermion.DescendingAlgebra

variable (R : Type u) (A : Type w) [CommRing R] [Ring A] [Algebra R A]

/-- An actual descending multiplicative filtration. No freeness, grading,
or associated-graded identification is supplied as part of the data. -/
structure Filtration where
  piece : ℕ → Submodule R A
  antitone : Antitone piece
  one_mem : (1 : A) ∈ piece 0
  mul_mem : ∀ {i j : ℕ} {x y : A}, x ∈ piece i → y ∈ piece j → x*y ∈ piece (i+j)

variable {R A}

abbrev filtration (f : Filtration R A) := f.piece

def nextStep (f : Filtration R A) (k : ℕ) : Submodule R A := f.piece (k+1)

def nextRestricted (f : Filtration R A) (k : ℕ) : Submodule R (filtration f k) :=
  (nextStep f k).comap (filtration f k).subtype

@[simp] theorem mem_nextRestricted_iff (f : Filtration R A) (k : ℕ)
    (x : filtration f k) : x ∈ nextRestricted f k ↔ (x : A) ∈ nextStep f k := Iff.rfl

theorem mul_mem_filtration (f : Filtration R A) {i j : ℕ} {x y : A}
    (hx : x ∈ filtration f i) (hy : y ∈ filtration f j) : x*y ∈ filtration f (i+j) :=
  f.mul_mem hx hy

theorem mul_mem_next_left (f : Filtration R A) {i j : ℕ} {x y : A}
    (hx : x ∈ nextStep f i) (hy : y ∈ filtration f j) : x*y ∈ nextStep f (i+j) := by
  have h := f.mul_mem hx hy
  simpa only [nextStep,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using h

theorem mul_mem_next_right (f : Filtration R A) {i j : ℕ} {x y : A}
    (hx : x ∈ filtration f i) (hy : y ∈ nextStep f j) : x*y ∈ nextStep f (i+j) := by
  have h := f.mul_mem hx hy
  simpa only [nextStep,Nat.add_assoc] using h

theorem one_mem_filtration (f : Filtration R A) : (1 : A) ∈ filtration f 0 :=
  f.one_mem

theorem algebraMap_mem_filtration (f : Filtration R A) (r : R) :
    algebraMap R A r ∈ filtration f 0 := by
  simpa only [Algebra.smul_def,mul_one] using
    (filtration f 0).smul_mem r (one_mem_filtration f)

@[simp] theorem filtration_coe_cast (f : Filtration R A) {i j : ℕ} (h : i=j)
    (x : filtration f i) :
    ((cast (congrArg (fun k => ↥(filtration f k)) h) x : filtration f j) : A)=x := by
  subst j
  rfl

/-- The degree-`k` quotient of a descending filtration by its next step. -/
abbrev GradedPiece (f : Filtration R A) (k : ℕ) : Type w :=
  filtration f k ⧸ nextRestricted f k

/-- The class of a filtered element in the graded piece of its degree vanishes exactly when the
element already lies in the next filtration step. -/
theorem gradedPiece_mk_eq_zero_iff (f : Filtration R A) {k : ℕ} (x : filtration f k) :
    (Submodule.Quotient.mk x : GradedPiece f k) = 0 ↔
      (x : A) ∈ nextStep f k := by
  rw [Submodule.Quotient.mk_eq_zero, mem_nextRestricted_iff]

/-- The direct sum of the homogeneous pieces of the descending filtration generated by `f`. -/
abbrev AssociatedGraded (f : Filtration R A) : Type w :=
  ⨁ k : ℕ, GradedPiece f k

noncomputable def filteredMul (f : Filtration R A) (i j : ℕ) :
    filtration f i →ₗ[R] filtration f j →ₗ[R] filtration f (i + j) :=
  { toFun := fun x =>
      { toFun := fun y => ⟨(x : A)*y,mul_mem_filtration f x.property y.property⟩
        map_add' := fun y z => Subtype.ext (mul_add (x : A) y z)
        map_smul' := fun c y => Subtype.ext (mul_smul_comm c (x : A) (y : A)) }
    map_add' := fun x y => LinearMap.ext (fun z => Subtype.ext (add_mul (x : A) y z))
    map_smul' := fun c x => LinearMap.ext (fun y => Subtype.ext (smul_mul_assoc c (x : A) y)) }

noncomputable def gradedPreMul (f : Filtration R A) (i j : ℕ) :
    filtration f i →ₗ[R] filtration f j →ₗ[R] GradedPiece f (i + j) :=
  (filteredMul f i j).compr₂ (Submodule.mkQ _)

theorem gradedPreMul_apply (f : Filtration R A) (i j : ℕ)
    (x : filtration f i) (y : filtration f j) :
    gradedPreMul f i j x y =
      Submodule.Quotient.mk
        (⟨(x : A) * y, mul_mem_filtration f x.property y.property⟩ :
          filtration f (i + j)) :=
  rfl

theorem gradedPreMul_mem_ker_left (f : Filtration R A) (i j : ℕ) :
    nextRestricted f i ≤
      (gradedPreMul f i j).ker := by
  rintro ⟨x, hx⟩ hnextStep
  rw [mem_nextRestricted_iff] at hnextStep
  rw [LinearMap.mem_ker]
  ext y
  simp only [gradedPreMul_apply, LinearMap.zero_apply]
  rw [gradedPiece_mk_eq_zero_iff]
  -- The filtration product lemma is stated for ambient filtered-algebra elements.
  change (x : A) * (y : A) ∈ nextStep f (i + j)
  exact mul_mem_next_left f hnextStep y.property

theorem gradedPreMul_mem_ker_right (f : Filtration R A) (i j : ℕ) :
    nextRestricted f j ≤
      (gradedPreMul f i j).flip.ker := by
  rintro ⟨y, hy⟩ hnextStep
  rw [mem_nextRestricted_iff] at hnextStep
  rw [LinearMap.mem_ker]
  ext x
  simp only [LinearMap.flip_apply, LinearMap.zero_apply]
  rw [gradedPreMul_apply, gradedPiece_mk_eq_zero_iff]
  -- The filtration product lemma is stated for ambient filtered-algebra elements.
  change (x : A) * (y : A) ∈ nextStep f (i + j)
  exact mul_mem_next_right f x.property hnextStep

/-- Multiplication of two homogeneous pieces of the associated graded algebra of the word
filtration. -/
noncomputable def gradedMul (f : Filtration R A) (i j : ℕ) :
    GradedPiece f i →ₗ[R] GradedPiece f j →ₗ[R]
      GradedPiece f (i + j) :=
  (gradedPreMul f i j).liftQ₂ _ _
    (gradedPreMul_mem_ker_left f i j)
    (gradedPreMul_mem_ker_right f i j)

/-- On quotient representatives, the homogeneous product is induced by multiplication in `A`. -/
@[simp]
theorem gradedMul_apply_mk (f : Filtration R A) (i j : ℕ) (x : filtration f i)
    (y : filtration f j) :
    gradedMul f i j (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk
        (⟨(x : A) * y, mul_mem_filtration f x.property y.property⟩ :
          filtration f (i + j)) :=
  by
  rw [gradedMul, LinearMap.liftQ₂_mk]
  exact gradedPreMul_apply f i j x y

/-- Casting a quotient class between equal degrees casts its filtration representative. -/
@[simp]
theorem gradedPiece_cast_mk (f : Filtration R A) {i j : ℕ}
    (h : i = j) (x : filtration f i) :
    cast (congrArg (GradedPiece f) h) (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (cast (congrArg (fun k => ↥(filtration f k)) h) x) := by
  subst j
  rfl

theorem gradedMul_mk_eq_cast (f : Filtration R A) {i j k : ℕ}
    (h : i + j = k) (x : filtration f i) (y : filtration f j)
    (z : filtration f k)
    (hz : (x : A) * y = z) :
    cast (congrArg (GradedPiece f) h)
        (gradedMul f i j (Submodule.Quotient.mk x) (Submodule.Quotient.mk y)) =
      Submodule.Quotient.mk z := by
  rw [gradedMul_apply_mk, gradedPiece_cast_mk f h]
  apply congrArg Submodule.Quotient.mk
  apply Subtype.ext
  rw [filtration_coe_cast f h]
  exact hz

theorem gradedMul_mk_eq_cast_rev (f : Filtration R A) {i j k : ℕ}
    (h : k = i + j) (x : filtration f i) (y : filtration f j)
    (z : filtration f k)
    (hz : (x : A) * y = z) :
    gradedMul f i j (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      cast (congrArg (GradedPiece f) h) (Submodule.Quotient.mk z) := by
  subst k
  exact gradedMul_mk_eq_cast f rfl x y z hz

/-- Homogeneous descending-filtration multiplication is associative after reindexing degrees. -/
theorem gradedMul_assoc (f : Filtration R A) (i j k : ℕ)
    (x : GradedPiece f i) (y : GradedPiece f j)
    (z : GradedPiece f k) :
    cast (congrArg (GradedPiece f) (Nat.add_assoc i j k))
      (gradedMul f (i + j) k (gradedMul f i j x y) z) =
      gradedMul f i (j + k) x (gradedMul f j k y z) := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      induction y using Submodule.Quotient.induction_on with
      | _ y =>
          induction z using Submodule.Quotient.induction_on with
          | _ z =>
              rw [gradedMul_apply_mk f i j x y, gradedMul_apply_mk f j k y z]
              conv_rhs => rw [gradedMul_apply_mk]
              apply gradedMul_mk_eq_cast f (Nat.add_assoc i j k)
              exact mul_assoc (x : A) (y : A) (z : A)

/-- The degree-zero unit of the homogeneous descending-filtration pieces. -/
noncomputable def gradedOne (f : Filtration R A) :
    GradedPiece f 0 :=
  Submodule.Quotient.mk ⟨1, one_mem_filtration f⟩

/-- The degree-zero unit is the quotient class of `(1 : A)`. -/
theorem gradedOne_def (f : Filtration R A) :
    gradedOne f =
      Submodule.Quotient.mk (⟨1, one_mem_filtration f⟩ : filtration f 0) := by
  rfl

/-- The quotient class of `(1 : A)` is the degree-zero homogeneous unit. -/
@[simp] theorem mk_one_eq_gradedOne (f : Filtration R A) :
    Submodule.Quotient.mk (⟨1, one_mem_filtration f⟩ : filtration f 0) =
      gradedOne f :=
  (gradedOne_def f).symm

/-- The degree-zero class of a scalar in the associated graded of the descending filtration. -/
noncomputable def gradedAlgebraMap₀ (f : Filtration R A) :
    R →+ GradedPiece f 0 where
  toFun r := Submodule.Quotient.mk
    ⟨algebraMap R (A) r, algebraMap_mem_filtration f r⟩
  map_zero' := by simp
  map_add' r s := by
    rw [← Submodule.Quotient.mk_add]
    apply congrArg Submodule.Quotient.mk
    exact Subtype.ext (map_add (algebraMap R (A)) r s)

/-- The degree-zero scalar map is the quotient class of its ambient scalar. -/
theorem gradedAlgebraMap₀_apply (f : Filtration R A) (r : R) :
    gradedAlgebraMap₀ f r =
      Submodule.Quotient.mk
        (⟨algebraMap R (A) r, algebraMap_mem_filtration f r⟩ :
          filtration f 0) := by
  rfl

/-- The quotient class of an ambient scalar is its degree-zero homogeneous class. -/
@[simp] theorem mk_algebraMap_eq_gradedAlgebraMap₀ (f : Filtration R A) (r : R) :
    Submodule.Quotient.mk
      (⟨algebraMap R (A) r, algebraMap_mem_filtration f r⟩ :
        filtration f 0) = gradedAlgebraMap₀ f r :=
  (gradedAlgebraMap₀_apply f r).symm

/-- The degree-zero scalar map sends `1` to the homogeneous unit. -/
@[simp] theorem gradedAlgebraMap₀_one (f : Filtration R A) :
    gradedAlgebraMap₀ f 1 = gradedOne f := by
  rw [gradedAlgebraMap₀_apply, gradedOne_def]
  exact congrArg Submodule.Quotient.mk (Subtype.ext (map_one (algebraMap R A)))

/-- The degree-zero homogeneous unit acts on the left. -/
@[simp] theorem gradedOne_mul (f : Filtration R A) (k : ℕ)
    (x : GradedPiece f k) :
    gradedMul f 0 k (gradedOne f) x =
      cast (congrArg (GradedPiece f) (Nat.zero_add k).symm) x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      simpa only [gradedOne_def] using
        gradedMul_mk_eq_cast_rev f (Nat.zero_add k).symm
          (⟨1, one_mem_filtration f⟩ : filtration f 0) x x (one_mul (x : A))

/-- The degree-zero homogeneous unit acts on the right. -/
@[simp] theorem gradedMul_one (f : Filtration R A) (k : ℕ)
    (x : GradedPiece f k) :
    gradedMul f k 0 x (gradedOne f) =
      cast (congrArg (GradedPiece f) (Nat.add_zero k).symm) x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      simpa only [gradedOne_def] using
        gradedMul_mk_eq_cast_rev f (Nat.add_zero k).symm x
          (⟨1, one_mem_filtration f⟩ : filtration f 0) x (mul_one (x : A))

/-- The homogeneous degree-zero class supplies the `GOne` structure on filtration pieces. -/
noncomputable instance gradedGOne {f : Filtration R A} :
    GradedMonoid.GOne (GradedPiece f) where
  one := gradedOne f

/-- The graded unit field is the named degree-zero unit. -/
@[simp] theorem gradedGOne_one {f : Filtration R A} :
    (GradedMonoid.GOne.one : GradedPiece f 0) = gradedOne f := rfl

/-- Homogeneous filtration multiplication supplies the `GMul` structure on filtration pieces. -/
noncomputable instance gradedGMul {f : Filtration R A} :
    GradedMonoid.GMul (GradedPiece f) where
  mul {i j} := fun x y => gradedMul f i j x y

/-- The graded multiplication field is the named homogeneous multiplication. -/
@[simp] theorem gradedGMul_mul {f : Filtration R A} {i j : ℕ}
    (x : GradedPiece f i) (y : GradedPiece f j) :
    GradedMonoid.GMul.mul x y = gradedMul f i j x y := rfl

/-- The homogeneous unit and multiplication form a graded monoid of filtration pieces. -/
noncomputable instance gradedGMonoid {f : Filtration R A} :
    GradedMonoid.GMonoid (GradedPiece f) :=
  { gradedGMul (f := f), gradedGOne (f := f) with
    one_mul := fun x => by
      rcases x with ⟨k, x⟩
      apply Sigma.ext (Nat.zero_add k)
      apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.zero_add k))
      -- The sigma equality is now a homogeneous equality after exposing the GOne and GMul fields.
      change cast (congrArg (GradedPiece f) (Nat.zero_add k))
        (gradedMul f 0 k (gradedOne f) x) = x
      rw [gradedOne_mul]
      simp
    mul_one := fun x => by
      rcases x with ⟨k, x⟩
      apply Sigma.ext (Nat.add_zero k)
      apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.add_zero k))
      -- The sigma equality is now a homogeneous equality after exposing the GOne and GMul fields.
      change cast (congrArg (GradedPiece f) (Nat.add_zero k))
        (gradedMul f k 0 x (gradedOne f)) = x
      rw [gradedMul_one]
      simp
    mul_assoc := fun x y z => by
      rcases x with ⟨i, x⟩
      rcases y with ⟨j, y⟩
      rcases z with ⟨k, z⟩
      apply Sigma.ext (Nat.add_assoc i j k)
      apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.add_assoc i j k))
      exact gradedMul_assoc f i j k x y z }

/-- Bilinearity and scalar casts make the homogeneous pieces a direct-sum graded ring. -/
noncomputable instance gradedGRing {f : Filtration R A} :
    DirectSum.GRing (GradedPiece f) where
  mul_zero := fun x => (gradedMul f _ _ x).map_zero
  zero_mul := fun x => by
    -- `DirectSum.GRing` states this through `GMul`; expose its declared homogeneous product.
    change gradedMul f _ _ 0 x = 0
    rw [LinearMap.map_zero]
    rfl
  mul_add := fun x y z => (gradedMul f _ _ x).map_add y z
  add_mul := fun x y z => by
    -- `DirectSum.GRing` states this through `GMul`; expose its declared homogeneous product.
    change gradedMul f _ _ (x + y) z =
      gradedMul f _ _ x z + gradedMul f _ _ y z
    rw [LinearMap.map_add]
    rfl
  natCast := fun n => gradedAlgebraMap₀ f n
  natCast_zero := by
    rw [Nat.cast_zero]
    exact map_zero (gradedAlgebraMap₀ f)
  natCast_succ := fun n => by
    -- The cast field is represented by the degree-zero scalar class chosen above.
    change gradedAlgebraMap₀ f ((n + 1 : ℕ) : R) =
      gradedAlgebraMap₀ f (n : R) + gradedOne f
    rw [Nat.cast_succ, map_add]
    rw [gradedAlgebraMap₀_one]
  intCast := fun z => gradedAlgebraMap₀ f z
  intCast_ofNat := fun n => by
    -- Integer casts use the same chosen degree-zero scalar representative.
    change gradedAlgebraMap₀ f ((n : ℤ) : R) = gradedAlgebraMap₀ f (n : R)
    norm_cast
  intCast_negSucc_ofNat := fun n => by
    -- Integer casts use the same chosen degree-zero scalar representative.
    change gradedAlgebraMap₀ f ((Int.negSucc n : ℤ) : R) =
      -gradedAlgebraMap₀ f ((n + 1 : ℕ) : R)
    rw [Int.cast_negSucc, map_neg]

/-- Left multiplication by a degree-zero scalar class is scalar multiplication. -/
@[simp] theorem gradedAlgebraMap₀_mul (f : Filtration R A) (r : R) (k : ℕ)
    (x : GradedPiece f k) :
    cast (congrArg (GradedPiece f) (Nat.zero_add k))
      (gradedMul f 0 k (gradedAlgebraMap₀ f r) x) = r • x := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      rw [gradedAlgebraMap₀_apply, ← Submodule.Quotient.mk_smul]
      apply gradedMul_mk_eq_cast f (Nat.zero_add k)
      exact (Algebra.smul_def r (x : A)).symm

/-- Degree-zero scalar classes multiply by multiplying their scalars. -/
@[simp 1100] theorem gradedAlgebraMap₀_mul_algebraMap₀ (f : Filtration R A) (r s : R) :
    gradedMul f 0 0 (gradedAlgebraMap₀ f r)
      (gradedAlgebraMap₀ f s) = gradedAlgebraMap₀ f (r * s) := by
  simp only [gradedAlgebraMap₀_apply, gradedMul_apply_mk]
  exact congrArg Submodule.Quotient.mk (Subtype.ext (map_mul (algebraMap R A) r s).symm)

/-- Degree-zero scalar classes commute with homogeneous products after reindexing degrees. -/
theorem gradedAlgebraMap₀_commutes (f : Filtration R A) (r : R) (k : ℕ)
    (x : GradedPiece f k) :
    cast (congrArg (GradedPiece f)
      ((Nat.zero_add k).trans (Nat.add_zero k).symm))
      (gradedMul f 0 k (gradedAlgebraMap₀ f r) x) =
      gradedMul f k 0 x (gradedAlgebraMap₀ f r) := by
  induction x using Submodule.Quotient.induction_on with
  | _ x =>
      rw [gradedAlgebraMap₀_apply]
      conv_rhs => rw [gradedMul_apply_mk]
      apply gradedMul_mk_eq_cast f
        ((Nat.zero_add k).trans (Nat.add_zero k).symm)
      exact Algebra.commutes r (x : A)

/-- Right multiplication by a degree-zero scalar class is scalar multiplication. -/
@[simp] theorem gradedMul_algebraMap₀ (f : Filtration R A) (r : R) (k : ℕ)
    (x : GradedPiece f k) :
    gradedMul f k 0 x (gradedAlgebraMap₀ f r) = r • x := by
  rw [← gradedAlgebraMap₀_commutes f r k x]
  simpa only [cast_cast, cast_eq] using gradedAlgebraMap₀_mul f r k x

/-- The graded-ring structure supplies the semiring structure needed by the direct sum. -/
noncomputable instance gradedGSemiring {f : Filtration R A} :
    DirectSum.GSemiring (GradedPiece f) := by
  exact @DirectSum.GRing.toGSemiring ℕ (GradedPiece f) _ _
    (gradedGRing (f := f))

/-- Degree-zero scalar classes make the homogeneous pieces into a graded `R`-algebra. -/
noncomputable instance gradedGAlgebra {f : Filtration R A} :
    DirectSum.GAlgebra R (GradedPiece f) where
  toFun := gradedAlgebraMap₀ f
  map_one := by
    -- `DirectSum.GAlgebra.map_one` is phrased through the degree-zero `GOne` field.
    change gradedAlgebraMap₀ f 1 = gradedOne f
    exact gradedAlgebraMap₀_one f
  map_mul r s := by
    apply Sigma.ext (Nat.zero_add 0).symm
    apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.zero_add 0).symm)
    -- The scalar product is a degree-zero homogeneous product after this reindexing.
    change cast (congrArg (GradedPiece f) (Nat.zero_add 0).symm)
      (gradedAlgebraMap₀ f (r * s)) =
      gradedMul f 0 0 (gradedAlgebraMap₀ f r)
        (gradedAlgebraMap₀ f s)
    rw [gradedAlgebraMap₀_mul_algebraMap₀]
    simp
  commutes r x := by
    rcases x with ⟨k, x⟩
    apply Sigma.ext ((Nat.zero_add k).trans (Nat.add_zero k).symm)
    apply heq_of_cast_eq
      (congrArg (GradedPiece f) ((Nat.zero_add k).trans (Nat.add_zero k).symm))
    exact gradedAlgebraMap₀_commutes f r k x
  smul_def r x := by
    rcases x with ⟨k, x⟩
    apply Sigma.ext (Nat.zero_add k).symm
    apply heq_of_cast_eq (congrArg (GradedPiece f) (Nat.zero_add k).symm)
    -- The sigma-level scalar law reduces to the degree-`k` homogeneous scalar equation.
    change cast (congrArg (GradedPiece f) (Nat.zero_add k).symm) (r • x) =
      gradedMul f 0 k (gradedAlgebraMap₀ f r) x
    symm
    simpa only [cast_cast, cast_eq] using
      congrArg (cast (congrArg (GradedPiece f) (Nat.zero_add k).symm))
        (gradedAlgebraMap₀_mul f r k x)

/-- The graded scalar-map field is the named degree-zero scalar map. -/
@[simp] theorem gradedGAlgebra_toFun {f : Filtration R A} (r : R) :
    (gradedGAlgebra (f := f)).toFun r = gradedAlgebraMap₀ f r := rfl

/-- The direct sum of homogeneous filtration pieces inherits its associated-graded
ring structure. -/
noncomputable instance associatedGradedRing {f : Filtration R A} :
    Ring (AssociatedGraded f) := by
  letI : ∀ k, AddCommGroup (GradedPiece f k) := fun _ => inferInstance
  infer_instance

/-- The degree-zero homogeneous unit generates the unit of the associated graded. -/
@[simp] theorem associatedGraded_of_gradedOne {f : Filtration R A} :
    DirectSum.of (GradedPiece f) 0 (gradedOne f) = (1 : AssociatedGraded f) := by
  rw [DirectSum.one_def, gradedGOne_one]

/-- The degree-zero homogeneous scalar class generates its scalar in the associated graded. -/
@[simp] theorem associatedGraded_of_gradedAlgebraMap₀ {f : Filtration R A} (r : R) :
    DirectSum.of (GradedPiece f) 0 (gradedAlgebraMap₀ f r) =
      algebraMap R (AssociatedGraded f) r := by
  rw [DirectSum.algebraMap_apply, gradedGAlgebra_toFun]

/-- The product of two homogeneous generators in the associated graded is their named
homogeneous product. -/
@[simp] theorem associatedGraded_of_mul_of {f : Filtration R A} {i j : ℕ}
    (x : GradedPiece f i) (y : GradedPiece f j) :
    (DirectSum.of (GradedPiece f) i x * DirectSum.of (GradedPiece f) j y : AssociatedGraded f) =
      DirectSum.of (GradedPiece f) (i + j) (gradedMul f i j x y) := by
  rw [DirectSum.of_mul_of, gradedGMul_mul]


end PaperVerification.Fermion.DescendingAlgebra
