module

public import PaperVerification.FermionMultiplicityBlocks

/-!
# The exact type-A specialization of the multiplicity initial ideal

The ordinary ideal is literally generated by p_1,...,p_n, the factor is
the paper's product x_i times all later differences, and the multiplicities
range independently over 0,1,2. Admissibility uses the exact positive arrival
heights. The stated initial ideal retains every colored coefficient.

The Rees-family and group-action clauses of Theorem 8.1 are developed
in the subsequent Rees and color-action files.
-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace PaperVerification.Fermion.TypeA

open MvPolynomial Exterior
open scoped BigOperators

variable {F : Type*} [Field F] [CharZero F] {n : ℕ}

local instance FermionTypeAMultiplicity_localInst_1 : LinearOrder (OddIndex n) :=
  LinearOrder.lift' modeRank modeRank_injective
local instance typeAMultiplicityDecidableEq : DecidableEq (OddIndex n) :=
  (interleavedOddOrder n).toDecidableEq

def data (hn : 0<n) : StrictData (K := F) (n := n) where
  positive_n := hn
  r := fun _ ↦ 1
  positive_r := fun _ ↦ Nat.zero_lt_one
  beta := fun _ ↦ 1
  allowed_weights := by
    refine ⟨isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero n)),?_⟩
    intro U hU
    have hc : (U.card : F)≠0 := Nat.cast_ne_zero.mpr (Finset.card_ne_zero.mpr hU)
    simpa only [Finset.sum_const,nsmul_one] using isUnit_iff_ne_zero.mpr hc
  phi := fun i ↦ X i
  highest_phi := fun i ↦ by simpa only [pow_one] using highestPower_X_pow (fun _ : Fin n ↦ 1) i 1

def powerSum (k : ℕ) : PolynomialRing F n := ∑ i,(X i)^(k+1)

def ordinaryIdeal : Ideal (PolynomialRing F n) :=
  Ideal.span (Set.range (fun k : Fin n ↦ powerSum (F := F) k.val))

theorem ordinaryIdeal_eq (hn : 0<n) :
    coupledOrdinaryIdeal (data (F := F) hn).pairedExtension=ordinaryIdeal (F := F) (n := n) := by
  unfold coupledOrdinaryIdeal ordinaryIdeal
  congr 2
  funext k
  simp only [coupledOrdinaryMoment,StrictData.pairedExtension,data,moment,powerSum,
    map_one,one_mul,mul_one,smul_eq_mul,pow_succ]

/-- Exactly the multiplicity factor f_m printed in Section 8.2. -/
def factor (m : MultiplicityVector n) : PolynomialRing F n :=
  ∏ i,(X i*∏ j∈Finset.Ioi i,(X i-X j))^(m i).val

def coefficientIdeal (m : MultiplicityVector n) : Ideal (PolynomialRing F n) :=
  principalColon ordinaryIdeal (factor m)

def arrival (m : MultiplicityVector n) (i : Fin n) : ℤ :=
  ((i.val+1 : ℕ) : ℤ)-((∑ j∈Finset.Iic i,(m j).val : ℕ) : ℤ)

def Admissible (m : MultiplicityVector n) : Prop := ∀ i,(1 : ℤ)≤arrival m i

theorem prefix_card_eq_multiplicity_Iic (T : Finset (OddIndex n)) (i : Fin n) :
    (T ∩ pairedPrefix n (i.val+1)).card=
      ∑ j∈Finset.Iic i,(wordMultiplicityVector T j).val := by
  rw [prefix_card_eq_multiplicity_sum T (i.val+1)]
  apply Finset.sum_congr
  · ext j
    simp only [Finset.mem_filter,Finset.mem_univ,true_and,Finset.mem_Iic]
    change (j.val < i.val + 1) ↔ (j.val ≤ i.val)
    omega
  · intro j hj
    rfl

theorem strictWord_iff_admissible (T : Finset (OddIndex n)) :
    StrictWord T ↔ Admissible (wordMultiplicityVector T) := by
  constructor
  · intro h i
    have hp := h (i.val+1) (Nat.succ_pos _) (Nat.succ_le_of_lt i.isLt)
    rw [prefix_card_eq_multiplicity_Iic] at hp
    unfold arrival
    omega
  · intro h j hj hjn
    let i : Fin n := ⟨j-1,by omega⟩
    have hi : i.val+1=j := by dsimp only [i]; omega
    have hp := h i
    unfold arrival at hp
    rw [←prefix_card_eq_multiplicity_Iic,hi] at hp
    omega

def canonicalWord (m : MultiplicityVector n) : Finset (OddIndex n) := by
  classical
  exact Finset.univ.filter fun a ↦ match a with
    | .inl i => (m i).val≠0
    | .inr i => (m i).val=2

theorem canonicalWord_multiplicity (m : MultiplicityVector n) :
    wordMultiplicityVector (canonicalWord m)=m := by
  funext i
  apply Fin.ext
  have hi := (m i).isLt
  change wordMultiplicity (canonicalWord m) i=(m i).val
  simp only [wordMultiplicity,canonicalWord,Finset.mem_filter,Finset.mem_univ,true_and]
  split_ifs <;> omega

theorem inadmissible_coefficientIdeal_eq_top (hn : 0<n)
    (m : MultiplicityVector n) (hm : ¬Admissible m) :
    coefficientIdeal (F := F) m=⊤ := by
  have hT : ¬StrictWord (canonicalWord m) := by
    rw [strictWord_iff_admissible,canonicalWord_multiplicity]
    exact hm
  have he := strictMultiplicityColon_eq_top_of_not_strict (data (F := F) hn) (canonicalWord m) hT
  rw [ordinaryIdeal_eq (F := F) hn] at he
  simpa only [canonicalWord_multiplicity,data,multiplicityFactor,
    coefficientIdeal,factor] using he

/-- The actual smallest-weight initial ideal in equation (21), defined from
actual strict relations and the literal weight 3^(i-1) on both colors. -/
def initialIdeal (hn : 0<n) : TwoSidedIdeal (SuperRing F n) :=
  strictMultiplicityInitialIdeal (data hn)

/-- Equation (21), in coefficient form. The accompanying exact exterior
basis regrouping is `multiplicityColoringEquiv`; this condition includes
every coefficient in every multiplicity block. -/
theorem equation_21 (hn : 0<n) (z : SuperRing F n) :
    z∈initialIdeal hn ↔
      ∀ T,(superPolynomialBasis (K := F)).repr z T∈
        coefficientIdeal (wordMultiplicityVector T) := by
  have he := strict_multiplicity_initialIdeal_mem_iff_blocks (data (F := F) hn) z
  rw [ordinaryIdeal_eq (F := F) hn] at he
  simpa only [initialIdeal,data,multiplicityFactor,coefficientIdeal,factor] using he

end PaperVerification.Fermion.TypeA
