module

public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Nilpotent.Lemmas
public import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic
public import Mathlib.RingTheory.LocalRing.Basic

/-!
# Algebras generated by nilpotent coordinates

These lemmas derive finiteness, the local-ring property, and the unit criterion
from actual polynomial generators. None of these conclusions is included as
a hypothesis in the local factor construction.
-/

@[expose] public section
set_option autoImplicit false
noncomputable section

namespace PaperVerification.Fermion

section General

variable {R A ι : Type*} [CommRing R] [CommRing A] [Algebra R A]

theorem nilpotent_aeval_sub_constant (x : ι → A)
    (hx : ∀ i,IsNilpotent (x i)) (p : MvPolynomial ι R) :
    IsNilpotent (MvPolynomial.aeval x p-
      algebraMap R A (MvPolynomial.constantCoeff p)) := by
  let q : A →ₐ[R] A ⧸ nilradical A := Ideal.Quotient.mkₐ R (nilradical A)
  have hxq : ∀ i,q (x i)=0 := fun i ↦
    Ideal.Quotient.eq_zero_iff_mem.mpr (mem_nilradical.mpr (hx i))
  apply mem_nilradical.mp
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change q (MvPolynomial.aeval x p-algebraMap R A (MvPolynomial.constantCoeff p))=0
  rw [map_sub,MvPolynomial.comp_aeval_apply,q.commutes]
  simp only [hxq,MvPolynomial.aeval_zero',sub_self]

/-- Nilpotence provides an explicit monic annihilating polynomial. -/
theorem integral_of_nilpotent_coordinate (a : A) (ha : IsNilpotent a) : IsIntegral R a := by
  obtain ⟨N,hN⟩ := ha
  exact ⟨Polynomial.X^N,Polynomial.monic_X_pow N,by
    change Polynomial.aeval a (Polynomial.X^N)=0
    simpa only [Polynomial.aeval_X_pow] using hN⟩

theorem finite_of_nilpotent_polynomial_generators [Finite ι]
    (x : ι → A) (hx : ∀ i,IsNilpotent (x i))
    (hgen : Function.Surjective (MvPolynomial.aeval (R := R) x)) :
    Module.Finite R A := by
  letI : Algebra.FiniteType R A :=
    Algebra.FiniteType.of_surjective (MvPolynomial.aeval x) hgen
  letI : Algebra.IsIntegral R A := ⟨fun a ↦ by
    obtain ⟨p,rfl⟩ := hgen a
    induction p using MvPolynomial.induction_on with
    | C r => simpa only [MvPolynomial.aeval_C] using (show IsIntegral R (algebraMap R A r) from isIntegral_algebraMap)
    | add p q hp hq => simpa only [map_add] using hp.add hq
    | mul_X p i hp =>
      simpa only [map_mul,MvPolynomial.aeval_X] using
        hp.mul (integral_of_nilpotent_coordinate (R := R) (x i) (hx i))⟩
  exact Algebra.IsIntegral.finite

end General

section Field

variable {F A ι : Type*} [Field F] [CommRing A] [Algebra F A]

theorem residue_of_aeval_nilpotent_generators (x : ι → A)
    (residue : A →ₐ[F] F) (hresidue : ∀ i,residue (x i)=0)
    (p : MvPolynomial ι F) :
    residue (MvPolynomial.aeval x p)=MvPolynomial.constantCoeff p := by
  rw [MvPolynomial.comp_aeval_apply]
  simp only [hresidue,MvPolynomial.aeval_zero',Algebra.algebraMap_self,RingHom.id_apply]

/-- The exact unit criterion follows from nilpotence of the centered
polynomial, and therefore applies before establishing a local-ring instance. -/
theorem unit_iff_residue_of_nilpotent_generators (x : ι → A)
    (hx : ∀ i,IsNilpotent (x i))
    (hgen : Function.Surjective (MvPolynomial.aeval (R := F) x))
    (residue : A →ₐ[F] F) (hresidue : ∀ i,residue (x i)=0) (a : A) :
    IsUnit a ↔ residue a≠0 := by
  constructor
  · intro h
    exact (h.map residue.toRingHom).ne_zero
  · intro ha
    obtain ⟨p,rfl⟩ := hgen a
    have hconst : MvPolynomial.constantCoeff p≠0 := by
      rwa [residue_of_aeval_nilpotent_generators x residue hresidue p] at ha
    have hn := nilpotent_aeval_sub_constant x hx p
    have hu : IsUnit (algebraMap F A (MvPolynomial.constantCoeff p)) :=
      (isUnit_iff_ne_zero.mpr hconst).map (algebraMap F A)
    simpa only [sub_add_cancel] using
      hn.isUnit_add_right_of_commute hu (Commute.all _ _)

/-- The residue map, which is an actual algebra homomorphism to the field,
makes the nilpotently generated algebra a local ring. -/
theorem localRing_of_nilpotent_generators (x : ι → A)
    (hx : ∀ i,IsNilpotent (x i))
    (hgen : Function.Surjective (MvPolynomial.aeval (R := F) x))
    (residue : A →ₐ[F] F) (hresidue : ∀ i,residue (x i)=0) :
    IsLocalRing A := by
  letI : Nontrivial A := residue.toRingHom.domain_nontrivial
  apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
  intro a
  by_cases ha : residue a=0
  · right
    apply (unit_iff_residue_of_nilpotent_generators x hx hgen residue hresidue (1-a)).mpr
    simp [ha]
  · left
    exact (unit_iff_residue_of_nilpotent_generators x hx hgen residue hresidue a).mpr ha

end Field

end PaperVerification.Fermion
