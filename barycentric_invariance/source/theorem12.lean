/- BEGIN FourPapers.Universal.CanonicalMultiplication -/
section

/-! # Multiplication of the canonical leading symbols

The comparison itself is a parameter-module map.  Multiplicativity belongs to
the independent canonical map on the associated graded.  We prove the precise
lower-filtration defect for products, using the strict polynomial weight drop
of a nonchain monomial in the original Stanley quotient.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical Finset MvPolynomial
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K : Type*) [CommRing K] (hs : IsSimplicialPoset P)

theorem originalPolynomialWeight_add (d : ℕ) (a b : NonzeroFace P →₀ ℕ) :
    originalPolynomialWeight d (a + b) =
      originalPolynomialWeight d a + originalPolynomialWeight d b := by
  simp only [originalPolynomialWeight]
  rw [Finsupp.sum_add_index (fun _ => by simp) (fun _ _ _ => by simp [add_mul])]

include hs in
theorem stalkExponent_rankWeight_strict (d : ℕ) (p : P) (a : NonzeroFace P →₀ ℕ)
    (ha : ∀ q ∈ a.support, q.val ≤ p) (hchain : ¬ BarycentricAllowed a) :
    polynomialRankWeight d (fun v => stalkExponent p a v) < originalPolynomialWeight d a := by
  have hn : ∃ s t : OriginalExponentFactors a,
      ¬ (originalFactorFaces p a s ⊆ originalFactorFaces p a t ∨
        originalFactorFaces p a t ⊆ originalFactorFaces p a s) := by
    unfold BarycentricAllowed at hchain
    push_neg at hchain
    obtain ⟨q, hq, r, hr, hqr, hrq⟩ := hchain
    let s : OriginalExponentFactors a := ⟨q, ⟨0, Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hq)⟩⟩
    let t : OriginalExponentFactors a := ⟨r, ⟨0, Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hr)⟩⟩
    refine ⟨s, t, ?_⟩
    change ¬ (stalkVertexSet p q.val ⊆ stalkVertexSet p r.val ∨
      stalkVertexSet p r.val ⊆ stalkVertexSet p q.val)
    rw [stalkVertexSet_subset_iff hs (ha q hq) (ha r hr),
      stalkVertexSet_subset_iff hs (ha r hr) (ha q hq)]
    exact not_or.mpr ⟨hqr, hrq⟩
  have h := polynomialRankWeight_occurrence_lt_of_not_chain d (originalFactorFaces p a) hn
  simpa only [originalFactorFaces_occurrence, originalFactorFaces_weight d p a ha] using h

theorem faceRingMonomial_nonchain_lower (d : ℕ) (a : NonzeroFace P →₀ ℕ)
    (ha : ¬ BarycentricAllowed a) :
    faceRingMonomial K hs a ∈ originalFaceWeightLevel K hs d (originalPolynomialWeight d a) := by
  intro b hb
  rw [standardFaceBasis_repr_atCarrier, polynomialStandardCoordinates_apply_of_inside
    K hs (standardCarrier b) _ ⟨b, le_rfl⟩]
  change (faceEvaluation K (standardCarrier b) (monomial a 1)).coeff
    (stalkExponent (standardCarrier b) b.val) = 0
  by_cases ha' : ∀ q ∈ a.support, q.val ≤ standardCarrier b
  · rw [faceEvaluation_monomial_of_inside K _ a ha', MvPolynomial.coeff_monomial]
    apply if_neg
    intro he
    have hw := stalkExponent_rankWeight_strict hs d (standardCarrier b) a ha' ha
    rw [he, stalkExponent_standardRankWeight hs d (standardCarrier b) ⟨b, le_rfl⟩] at hw
    exact (not_lt_of_ge hb) hw
  · rw [faceEvaluation_monomial_of_outside K _ a ha']
    rfl

@[simp] theorem canonicalOriginalComparison_basis (a : StandardFaceIndex P) :
    canonicalOriginalComparison K hs (barycentricGlobalStandardBasis K a) =
      standardFaceBasis K hs a := by
  apply (standardFaceBasis K hs).repr.injective
  rw [canonicalOriginalComparison, canonicalBasisEquiv_repr,
    Module.Basis.repr_self, Module.Basis.repr_self]

theorem barycentricStandardBasis_product (a b : StandardFaceIndex P) :
    barycentricGlobalStandardBasis K a * barycentricGlobalStandardBasis K b =
      Ideal.Quotient.mk (barycentricIdeal (P := P) K) (monomial (a.val + b.val) 1) := by
  rw [← barycentricGlobalStandardBasis_monomial, ← barycentricGlobalStandardBasis_monomial,
    ← map_mul, MvPolynomial.monomial_mul, one_mul]

theorem barycentricMonomial_forbidden (a : NonzeroFace P →₀ ℕ)
    (ha : ¬ BarycentricAllowed a) :
    Ideal.Quotient.mk (barycentricIdeal (P := P) K) (monomial a 1) = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [barycentricIdeal_eq_forbiddenIdeal]
  exact Ideal.subset_span ⟨a, ha, rfl⟩

theorem canonicalOriginalComparison_product_basis_lower (d : ℕ)
    (a b : StandardFaceIndex P) :
    canonicalOriginalComparison K hs
        (barycentricGlobalStandardBasis K a * barycentricGlobalStandardBasis K b) -
      canonicalOriginalComparison K hs (barycentricGlobalStandardBasis K a) *
        canonicalOriginalComparison K hs (barycentricGlobalStandardBasis K b) ∈
      originalFaceWeightLevel K hs d (standardRankWeight d a + standardRankWeight d b) := by
  rw [canonicalOriginalComparison_basis, canonicalOriginalComparison_basis,
    barycentricStandardBasis_product]
  have hprod : standardFaceBasis K hs a * standardFaceBasis K hs b =
      faceRingMonomial K hs (a.val + b.val) := by
    rw [standardFaceBasis_apply, standardFaceBasis_apply]
    exact (faceRingMonomial_add K hs a.val b.val).symm
  rw [hprod]
  by_cases hab : BarycentricAllowed (a.val + b.val)
  · rw [barycentricGlobalStandardBasis_monomial K ⟨a.val + b.val, hab⟩,
      canonicalOriginalComparison_basis, standardFaceBasis_apply]
    change faceRingMonomial K hs (a.val + b.val) -
      faceRingMonomial K hs (a.val + b.val) ∈ _
    rw [sub_self]
    exact Submodule.zero_mem _
  · rw [barycentricMonomial_forbidden K _ hab, map_zero, zero_sub]
    apply Submodule.neg_mem
    have h := faceRingMonomial_nonchain_lower K hs d (a.val + b.val) hab
    rw [originalPolynomialWeight_add] at h
    exact h

section Bilinear
variable {I J L M N : Type*}
  [AddCommGroup L] [Module K L] [AddCommGroup M] [Module K M]
  [AddCommGroup N] [Module K N]

theorem bilinear_mem_of_basis_support (b : Module.Basis I K L) (c : Module.Basis J K M)
    (f : L →ₗ[K] M →ₗ[K] N) (S : Submodule K N) (x : L) (y : M)
    (hf : ∀ i ∈ (b.repr x).support, ∀ j ∈ (c.repr y).support, f (b i) (c j) ∈ S) :
    f x y ∈ S := by
  have hx := b.linearCombination_repr x
  have hy := c.linearCombination_repr y
  rw [← hx, ← hy]
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, map_smul,
    LinearMap.sum_apply, LinearMap.smul_apply]
  apply Submodule.sum_mem
  intro j hj
  apply Submodule.smul_mem
  apply Submodule.sum_mem
  intro i hi
  apply Submodule.smul_mem
  exact hf i hi j hj

theorem basisWeightLevel_mono (b : Module.Basis I K L) (w : I → ℤ)
    {n m : ℤ} (hnm : n ≤ m) : basisWeightLevel b w n ≤ basisWeightLevel b w m := by
  intro x hx i hi
  exact hx i (hnm.trans hi)
end Bilinear

def canonicalProductDefect :
    BarycentricRing (P := P) K →ₗ[K] BarycentricRing (P := P) K →ₗ[K] FaceRing K hs :=
  (LinearMap.mul K (BarycentricRing (P := P) K)).compr₂
      (canonicalOriginalComparison K hs).toLinearMap -
    (LinearMap.mul K (FaceRing K hs)).compl₁₂
      (canonicalOriginalComparison K hs).toLinearMap (canonicalOriginalComparison K hs).toLinearMap

theorem canonicalOriginalComparison_product_lower (d : ℕ) (r s : ℤ)
    (x y : BarycentricRing (P := P) K)
    (hx : x ∈ usualBarycentricWeightLevel K d (r + 1))
    (hy : y ∈ usualBarycentricWeightLevel K d (s + 1)) :
    canonicalOriginalComparison K hs (x * y) -
      canonicalOriginalComparison K hs x * canonicalOriginalComparison K hs y ∈
      usualFaceWeightLevel K hs d (r + s) := by
  rw [usualFaceWeightLevel_eq]
  rw [usualBarycentricWeightLevel_eq] at hx hy
  change canonicalProductDefect K hs x y ∈ _
  apply bilinear_mem_of_basis_support K (barycentricGlobalStandardBasis K)
    (barycentricGlobalStandardBasis K)
  intro a ha b hb
  have hwa := basisWeightLevel_support (barycentricGlobalStandardBasis K)
    (standardRankWeight d) (r + 1) x hx a ha
  have hwb := basisWeightLevel_support (barycentricGlobalStandardBasis K)
    (standardRankWeight d) (s + 1) y hy b hb
  exact basisWeightLevel_mono K (standardFaceBasis K hs) (standardRankWeight d)
    (show standardRankWeight d a + standardRankWeight d b ≤ r + s by omega)
    (canonicalOriginalComparison_product_basis_lower K hs d a b)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ColorExteriorOperators -/
section

/-! # The actual exterior contraction used in colorful Koszul strands

The coefficient operators are ordinary linear endomorphisms.  The Cartan
identity below is proved in the literal exterior tensor module.  In a strand
with a repeated color the corresponding coefficient operator is the identity,
so exterior creation supplies a genuine contracting homotopy.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical TensorProduct CliffordAlgebra
open scoped TensorProduct
variable {K C M : Type*} [CommRing K] [Fintype C] [LinearOrder C]
  [AddCommGroup M] [Module K M]

abbrev ColorExterior (K C : Type*) [CommRing K] [Fintype C] :=
  ExteriorAlgebra K (C → K)

abbrev ColorExteriorModule (K C M : Type*) [CommRing K] [Fintype C]
    [AddCommGroup M] [Module K M] := ColorExterior K C ⊗[K] M

def colorContraction (i : C) : ColorExterior K C →ₗ[K] ColorExterior K C :=
  CommAlg.Simplicial.contraction i

def colorCreation (i : C) : ColorExterior K C →ₗ[K] ColorExterior K C :=
  CommAlg.Simplicial.creation i

theorem colorContraction_creation (i j : C) (e : ColorExterior K C) :
    colorContraction j (colorCreation i e) =
      (if i = j then e else 0) - colorCreation i (colorContraction j e) := by
  change contractLeft ((Pi.basisFun K C).coord j)
    (ExteriorAlgebra.ι K ((Pi.basisFun K C) i) * e) = _
  rw [contractLeft_ι_mul]
  simp only [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
  split_ifs <;> simp only [one_smul, zero_smul]
  all_goals rfl

def colorTensorCreation (i : C) : ColorExteriorModule K C M →ₗ[K] ColorExteriorModule K C M :=
  TensorProduct.map (colorCreation i) LinearMap.id

def colorTensorDifferential (x : C → Module.End K M) :
    ColorExteriorModule K C M →ₗ[K] ColorExteriorModule K C M :=
  ∑ i : C, TensorProduct.map (colorContraction i) (x i)

@[simp] theorem colorTensorCreation_tmul (i : C) (e : ColorExterior K C) (m : M) :
    colorTensorCreation i (e ⊗ₜ[K] m) = colorCreation i e ⊗ₜ[K] m := rfl

theorem colorTensorDifferential_tmul (x : C → Module.End K M)
    (e : ColorExterior K C) (m : M) :
    colorTensorDifferential x (e ⊗ₜ[K] m) =
      ∑ i : C, colorContraction i e ⊗ₜ[K] x i m := by
  simp only [colorTensorDifferential, LinearMap.sum_apply, TensorProduct.map_tmul]

/-- Cartan's identity with arbitrary coefficient endomorphisms.  It is a
literal equality of linear maps on the exterior tensor product. -/
theorem colorTensorDifferential_creation (x : C → Module.End K M) (i : C)
    (z : ColorExteriorModule K C M) :
    colorTensorDifferential x (colorTensorCreation i z) +
      colorTensorCreation i (colorTensorDifferential x z) =
        TensorProduct.map LinearMap.id (x i) z := by
  induction z using TensorProduct.induction_on with
  | zero => simp only [map_zero, add_zero]
  | add z w hz hw =>
      simp only [map_add]
      rw [add_add_add_comm, hz, hw]
  | tmul e m =>
      rw [colorTensorCreation_tmul, colorTensorDifferential_tmul,
        colorTensorDifferential_tmul, map_sum]
      simp only [colorTensorCreation_tmul, colorContraction_creation,
        TensorProduct.sub_tmul, Finset.sum_sub_distrib]
      rw [sub_add_cancel]
      rw [Finset.sum_eq_single i]
      · simp only [if_pos rfl, if_true, TensorProduct.map_tmul, LinearMap.id_apply]
      · intro j hj hji
        simp only [if_neg (Ne.symm hji), zero_tmul]
      · intro hi
        exact (hi (Finset.mem_univ i)).elim

/-- An identity coefficient gives an actual contraction, without dividing by
any scalar and over every commutative coefficient ring. -/
theorem colorTensorDifferential_contraction (x : C → Module.End K M) (i : C)
    (hi : x i = LinearMap.id) (z : ColorExteriorModule K C M) :
    colorTensorDifferential x (colorTensorCreation i z) +
      colorTensorCreation i (colorTensorDifferential x z) = z := by
  simpa only [hi, TensorProduct.map_id, LinearMap.id_apply] using
    colorTensorDifferential_creation x i z

/-- Every actual cycle is an actual boundary in an identity-coordinate strand. -/
theorem colorTensorCycle_boundary (x : C → Module.End K M) (i : C)
    (hi : x i = LinearMap.id) (z : ColorExteriorModule K C M)
    (hz : colorTensorDifferential x z = 0) :
    colorTensorDifferential x (colorTensorCreation i z) = z := by
  have h := colorTensorDifferential_contraction x i hi z
  simpa only [hz, map_zero, add_zero] using h

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeCochains -/
section

/-! # Actual augmented relative simplicial cochains

Chains are the usual exterior face submodules, with the empty face in degree
zero.  Relative chains are their literal quotient by the subcomplex.  Cochains
are linear duals of these quotient modules, with differential the transpose of
the signed simplicial boundary.  Reduced cohomological degree `q` means chain
cardinality degree `q+1`; degrees below minus one are explicitly zero.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open CategoryTheory CommAlg
universe u v
variable {K : Type u} {V : Type v} [CommRing K] [Fintype V] [LinearOrder V]

def augmentedFaceBoundary (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    Simplicial.Chains (k := K) Λ (i + 1) →ₗ[K] Simplicial.Chains (k := K) Λ i :=
  (Simplicial.boundary.domRestrict (Simplicial.Chains Λ (i + 1))).codRestrict _
    (fun x => Simplicial.boundary_mem hΛ x.property)

def relativeFaceSubmodule (Λ Λ₀ : Finset V → Prop) (i : ℕ) :
    Submodule K (Simplicial.Chains (k := K) Λ i) :=
  (Simplicial.Chains Λ₀ i).comap (Simplicial.Chains Λ i).subtype

abbrev RelativeAugmentedChains (Λ Λ₀ : Finset V → Prop) (i : ℕ) :=
  Simplicial.Chains (k := K) Λ i ⧸ relativeFaceSubmodule (K := K) Λ Λ₀ i

def relativeAugmentedBoundary (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (i : ℕ) :
    RelativeAugmentedChains (K := K) Λ Λ₀ (i + 1) →ₗ[K]
      RelativeAugmentedChains (K := K) Λ Λ₀ i :=
  Submodule.mapQ _ _ (augmentedFaceBoundary Λ hΛ i) (by
    intro x hx
    exact Simplicial.boundary_mem hΛ₀ hx)

theorem relativeAugmentedBoundary_square (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (i : ℕ) :
    (relativeAugmentedBoundary (K := K) Λ Λ₀ hΛ hΛ₀ i).comp
      (relativeAugmentedBoundary (K := K) Λ Λ₀ hΛ hΛ₀ (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective
    (relativeFaceSubmodule (K := K) Λ Λ₀ (i + 2)) x
  change Submodule.Quotient.mk
    (augmentedFaceBoundary Λ hΛ i (augmentedFaceBoundary Λ hΛ (i + 1) y)) = 0
  have hz : augmentedFaceBoundary (K := K) Λ hΛ i
      (augmentedFaceBoundary Λ hΛ (i + 1) y) = 0 :=
    Subtype.ext (Simplicial.boundary_boundary y.val)
  rw [hz]
  exact Submodule.Quotient.mk_zero _

def relativeAugmentedCoboundary (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (i : ℕ) :
    Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i) →ₗ[K]
      Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ (i + 1)) :=
  (relativeAugmentedBoundary Λ Λ₀ hΛ hΛ₀ i).dualMap

theorem relativeAugmentedCoboundary_square (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (i : ℕ) :
    (relativeAugmentedCoboundary (K := K) Λ Λ₀ hΛ hΛ₀ (i + 1)).comp
      (relativeAugmentedCoboundary (K := K) Λ Λ₀ hΛ hΛ₀ i) = 0 := by
  apply LinearMap.ext
  intro f
  apply LinearMap.ext
  intro x
  change f ((relativeAugmentedBoundary Λ Λ₀ hΛ hΛ₀ i)
    (relativeAugmentedBoundary Λ Λ₀ hΛ hΛ₀ (i + 1) x)) = 0
  have hz := LinearMap.congr_fun (relativeAugmentedBoundary_square
    (K := K) Λ Λ₀ hΛ hΛ₀ i) x
  change relativeAugmentedBoundary Λ Λ₀ hΛ hΛ₀ i
    (relativeAugmentedBoundary Λ Λ₀ hΛ hΛ₀ (i + 1) x) = 0 at hz
  rw [hz, map_zero]

def relativeAugmentedCochainComplex (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) :
    CochainComplex (ModuleCat.{max u v} K) ℕ :=
  CochainComplex.of
    (fun i => ModuleCat.of K (Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i)))
    (fun i => ModuleCat.ofHom (relativeAugmentedCoboundary Λ Λ₀ hΛ hΛ₀ i))
    (fun i => ModuleCat.hom_ext (relativeAugmentedCoboundary_square Λ Λ₀ hΛ hΛ₀ i))

/-- Literal reduced relative cohomology, including the augmentation degree. -/
def reducedRelativeCohomology (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (q : ℤ) :
    ModuleCat.{max u v} K :=
  if -1 ≤ q then (relativeAugmentedCochainComplex (K := K) Λ Λ₀ hΛ hΛ₀).homology (q + 1).toNat
  else ModuleCat.of K (ULift.{v} (Fin 0 → K))

def rankSelection {C : Type*} [DecidableEq C] (D : ProperlyColoredComplex V C) (S : Finset C) :
    Finset V → Prop := fun F => D.face F ∧ F.image D.color ⊆ S

theorem rankSelection_downward {C : Type*} [DecidableEq C] (D : ProperlyColoredComplex V C)
    (S : Finset C) : Simplicial.Downward (rankSelection D S) := by
  intro s t hts hs
  exact ⟨D.downward hts hs.1, (Finset.image_subset_image hts).trans hs.2⟩

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.TorKoszulBridge -/
section

/-! # The ordinary order of the two Tor arguments

Mathlib's `Tor M K` resolves its second argument.  The checked polynomial
Koszul resolution computes `Tor' K M`, which resolves its first argument.
These constructions resolve the same coefficient module.  The bridge below
therefore only needs the braiding between `(-) ⊗ M` and `M ⊗ (-)`; no unproved
balanced-derived-functor theorem is assumed.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open CategoryTheory CategoryTheory.MonoidalCategory

section DerivedIso
variable {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D]
  [HasProjectiveResolutions C]
  {F G : C ⥤ D} [F.Additive] [G.Additive]

def leftDerivedOfNaturalIso (e : F ≅ G) (i : ℕ) : F.leftDerived i ≅ G.leftDerived i where
  hom := NatTrans.leftDerived e.hom i
  inv := NatTrans.leftDerived e.inv i
  hom_inv_id := by
    rw [← NatTrans.leftDerived_comp, e.hom_inv_id, NatTrans.leftDerived_id]
  inv_hom_id := by
    rw [← NatTrans.leftDerived_comp, e.inv_hom_id, NatTrans.leftDerived_id]
end DerivedIso

universe u v
variable {R : Type u} [CommRing R]

def tensorOrderIso (M : ModuleCat.{u} R) :
    (tensoringRight (ModuleCat.{u} R)).obj M ≅ (tensoringLeft (ModuleCat.{u} R)).obj M :=
  NatIso.ofComponents (fun N => (TensorProduct.comm R N M).toModuleIso) (by
    intro N N' f
    apply ModuleCat.hom_ext
    apply TensorProduct.ext'
    intro n m
    rfl)

def torArgumentOrderIso (i : ℕ) (N M : ModuleCat.{u} R) :
    ((Tor' (ModuleCat R) i).obj N).obj M ≅ ((Tor (ModuleCat R) i).obj M).obj N :=
  (leftDerivedOfNaturalIso (tensorOrderIso M) i).app N

section Polynomial
variable {k : Type u} [CommRing k]

/-- The existing genuine coefficient Tor has the ordinary argument order. -/
def coefficientTorOrderIso (n i : ℕ) (M : ModuleCat.{u} (MvPolynomial (Fin n) k)) :
    ((Tor' (ModuleCat (MvPolynomial (Fin n) k)) i).obj
      (ModuleCat.of (MvPolynomial (Fin n) k) (CommAlg.Koszul.Residue n k))).obj M ≅
    ((Tor (ModuleCat (MvPolynomial (Fin n) k)) i).obj M).obj
      (ModuleCat.of (MvPolynomial (Fin n) k) (CommAlg.Koszul.Residue n k)) :=
  torArgumentOrderIso i _ M

/-- The original Koszul differential computes the ordinary derived tensor
functor, with the actual coefficient module resolved by its variables. -/
def ordinaryPolynomialTorIso [Nontrivial k] (n i : ℕ)
    (M : ModuleCat.{u} (MvPolynomial (Fin n) k)) :
    ((Tor (ModuleCat (MvPolynomial (Fin n) k)) i).obj M).obj
      (ModuleCat.of (MvPolynomial (Fin n) k) (CommAlg.Koszul.Residue n k)) ≅
      (CommAlg.Koszul.coefficientComplex
        (List.ofFn (MvPolynomial.X : Fin n → MvPolynomial (Fin n) k)) M).homology i :=
  (coefficientTorOrderIso n i M).symm ≪≫ CommAlg.Koszul.polynomialTorIso n i M

end Polynomial

section FinitePolynomial
variable {V : Type} {k : Type u} [Fintype V] [LinearOrder V] [CommRing k]

/-- The displayed Tor has the coefficient ring itself as its second argument,
with variables acting by zero, for an arbitrary finite variable type. -/
def ordinaryFinitePolynomialTorIso [Nontrivial k] (i : ℕ)
    (M : ModuleCat.{u} (MvPolynomial V k)) :
    ((Tor (ModuleCat (MvPolynomial V k)) i).obj M).obj
      (CommAlg.Koszul.residueCoefficientModule (V := V) (k := k)) ≅
      (CommAlg.Koszul.familyCoefficientComplex (MvPolynomial.X : V → MvPolynomial V k) M).homology i :=
  (torArgumentOrderIso i (CommAlg.Koszul.residueCoefficientModule (V := V) (k := k)) M).symm ≪≫
    (CommAlg.Koszul.finitePolynomialTorCoefficientIso i M).symm ≪≫
    CommAlg.Koszul.finitePolynomialTorIso i M

end FinitePolynomial
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.KoszulCoefficientNaturality -/
section

/-! # Naturality of the actual coefficient Koszul complex for arbitrary modules -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CategoryTheory.MonoidalCategory CommAlg
open scoped TensorProduct
universe u v
variable {R : Type u} {V : Type} [CommRing R] [Fintype V] [LinearOrder V]

def tensorCoefficientMap {S : Type*} [CommRing S] (L : ChainComplex (ModuleCat S) ℕ)
    {M N : ModuleCat S} (f : M ⟶ N) :
    (((tensoringRight (ModuleCat S)).obj M).mapHomologicalComplex (ComplexShape.down ℕ)).obj L ⟶
      (((tensoringRight (ModuleCat S)).obj N).mapHomologicalComplex (ComplexShape.down ℕ)).obj L :=
  (NatTrans.mapHomologicalComplex ((tensoringRight (ModuleCat S)).map f) _).app L

abbrev familyCoefficientMap (x : V → R) {M N : ModuleCat.{u} R} (f : M ⟶ N) :
    Koszul.familyCoefficientComplex x M ⟶ Koszul.familyCoefficientComplex x N :=
  tensorCoefficientMap (S := R) (koszulComplex (Fintype.linearCombination R x)) f

def coordinateCoefficientMap (x : V → R) {M N : ModuleCat.{u} R} (f : M ⟶ N) :
    Koszul.coordinateComplex x M ⟶ Koszul.coordinateComplex x N where
  f i := ModuleCat.ofHom (Finsupp.mapRange.linearMap f.hom)
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [Koszul.coordinateComplex_d, Koszul.coordinateComplex_d]
    apply ModuleCat.hom_ext
    apply Finsupp.lhom_ext
    intro s m
    change Koszul.coordinateDifferential x N j
        (Finsupp.mapRange.linearMap f.hom (Finsupp.single s m)) =
      Finsupp.mapRange.linearMap f.hom
        (Koszul.coordinateDifferential x M j (Finsupp.single s m))
    simp only [LinearMap.comp_apply, Finsupp.lsingle_apply, Finsupp.mapRange.linearMap_apply,
      Finsupp.mapRange_single, Koszul.coordinateDifferential_single, map_sum]
    apply Finset.sum_congr rfl
    intro a ha
    simp only [map_smul, map_zsmul_unit, Finsupp.mapRange_single]

theorem coefficientCoordinates_natural (x : V → R) {M N : ModuleCat.{u} R} (f : M ⟶ N)
    (i : ℕ) (z : (Koszul.familyCoefficientComplex x M).X i) :
    Koszul.coefficientCoordinates x N i ((familyCoefficientMap x f).f i z) =
      Finsupp.mapRange.linearMap f.hom (Koszul.coefficientCoordinates x M i z) := by
  have h : (Koszul.coefficientCoordinates x N i).toLinearMap.comp ((familyCoefficientMap x f).f i).hom =
      (Finsupp.mapRange.linearMap f.hom).comp (Koszul.coefficientCoordinates x M i).toLinearMap := by
    apply TensorProduct.ext
    apply ((Pi.basisFun R V).exteriorPower i).ext
    intro s
    apply LinearMap.ext
    intro m
    change Koszul.coefficientCoordinates x N i
      (((Pi.basisFun R V).exteriorPower i s) ⊗ₜ[R] f m) =
        Finsupp.mapRange.linearMap f.hom
          (Koszul.coefficientCoordinates x M i (((Pi.basisFun R V).exteriorPower i s) ⊗ₜ[R] m))
    rw [Koszul.coordinates_basis_tensor, Koszul.coordinates_basis_tensor]
    simp only [Finsupp.mapRange.linearMap_apply, Finsupp.mapRange_single]
  exact LinearMap.congr_fun h z

theorem coordinateComplexIso_natural (x : V → R) {M N : ModuleCat.{u} R} (f : M ⟶ N) :
    familyCoefficientMap x f ≫ (Koszul.coordinateComplexIso x N).hom =
      (Koszul.coordinateComplexIso x M).hom ≫ coordinateCoefficientMap x f := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  ext z
  exact coefficientCoordinates_natural x f i z

/-- Coefficientwise naturality for arbitrary modules, including relative ideals. -/
theorem coordinateDifferential_natural (x : V → R) {M N : ModuleCat.{u} R}
    (f : M ⟶ N) (i : ℕ) :
    (Finsupp.mapRange.linearMap f.hom).comp (Koszul.coordinateDifferential x M i) =
      (Koszul.coordinateDifferential x N i).comp (Finsupp.mapRange.linearMap f.hom) := by
  have h := (coordinateCoefficientMap x f).comm (i + 1) i
  rw [Koszul.coordinateComplex_d, Koszul.coordinateComplex_d] at h
  exact (congrArg (fun g => g.hom) h).symm

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ColorfulKoszulBasis -/
section

/-! # Color degrees of the genuine coefficient Koszul complex

The differential here is transported from the actual tensor Koszul resolution
in `CommAlg.Koszul.Coordinates`.  Its coefficient action is the color sum in
the ordinary Stanley--Reisner quotient.  The color homogeneous subcomplexes
are submodules of this actual complex, not complexes stipulated to have the
desired homology.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset MvPolynomial CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)

def parameterAction : MvPolynomial C K →ₐ[K] D.Ring K := MvPolynomial.aeval (D.colorParameter K)

local instance parameterAlgebra : Algebra (MvPolynomial C K) (D.Ring K) :=
  (D.parameterAction K).toRingHom.toAlgebra

def ringBasis : Module.Basis {a : V →₀ ℕ // D.allowed a} K (D.Ring K) :=
  standardMonomialBasis D.allowed D.allowed_divisorClosed

@[simp] theorem ringBasis_apply (a : {a : V →₀ ℕ // D.allowed a}) :
    D.ringBasis K a = D.monomial K a.val :=
  standardMonomialBasis_apply D.allowed D.allowed_divisorClosed a

abbrev KoszulIndex (i : ℕ) := Σ s : Set.powersetCard C i, {a : V →₀ ℕ // D.allowed a}

def koszulBasis (i : ℕ) :
    Module.Basis (D.KoszulIndex i) K (Set.powersetCard C i →₀ D.Ring K) :=
  Finsupp.basis (fun _ : Set.powersetCard C i => D.ringBasis K)

@[simp] theorem koszulBasis_apply (i : ℕ) (s : Set.powersetCard C i)
    (a : {a : V →₀ ℕ // D.allowed a}) :
    D.koszulBasis K i ⟨s, a⟩ = Finsupp.single s (D.monomial K a.val) := by
  simp only [koszulBasis, Finsupp.coe_basis, ringBasis_apply]

def koszulColorDegree {i : ℕ} (t : D.KoszulIndex i) : C →₀ ℕ :=
  D.colorDegree t.2.val + Koszul.faceExponent t.1.val

def colorKoszulPiece (β : C →₀ ℕ) (i : ℕ) :
    Submodule K (Set.powersetCard C i →₀ D.Ring K) :=
  Grading.Piece (D.koszulBasis K i) D.koszulColorDegree β

/-- Use the group structure attached to the existing coefficient module. -/
instance colorKoszulPieceAddCommGroup (β : C →₀ ℕ) (i : ℕ) :
    AddCommGroup (D.colorKoszulPiece K β i) :=
  Module.addCommMonoidToAddCommGroup K

def colorKoszulPieceBasis (β : C →₀ ℕ) (i : ℕ) :
    Module.Basis {t : D.KoszulIndex i // D.koszulColorDegree t = β} K
      (D.colorKoszulPiece K β i) :=
  Grading.restrictedBasis (D.koszulBasis K i) (fun t => D.koszulColorDegree t = β)

/-- The value of a homogeneous basis vector in the original coefficient module. -/
@[simp] theorem colorKoszulPieceBasis_val (β : C →₀ ℕ) (i : ℕ)
    (t : {t : D.KoszulIndex i // D.koszulColorDegree t = β}) :
    (D.colorKoszulPieceBasis K β i t).val = D.koszulBasis K i t.val := by
  exact Grading.restrictedBasis_val (D.koszulBasis K i)
    (fun t => D.koszulColorDegree t = β) t

def koszulDifferential (i : ℕ) :
    (Set.powersetCard C (i + 1) →₀ D.Ring K) →ₗ[K] (Set.powersetCard C i →₀ D.Ring K) :=
  (Koszul.coordinateDifferential (X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) (D.Ring K)) i).restrictScalars K

theorem koszulDifferential_comp (i : ℕ) :
    (D.koszulDifferential K i).comp (D.koszulDifferential K (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  exact LinearMap.congr_fun (Koszul.coordinateDifferential_comp
    (X : C → MvPolynomial C K) (ModuleCat.of (MvPolynomial C K) (D.Ring K)) i) x

theorem colorDegree_add (a b : V →₀ ℕ) :
    D.colorDegree (a + b) = D.colorDegree a + D.colorDegree b := Finsupp.mapDomain_add

theorem colorDegree_single (v : V) (n : ℕ) :
    D.colorDegree (Finsupp.single v n) = Finsupp.single (D.color v) n :=
  Finsupp.mapDomain_single

def nextKoszulIndex {i : ℕ} (t : D.KoszulIndex (i + 1))
    (j : {j // j ∈ t.1.val}) (v : V)
    (hv : D.allowed (Finsupp.single v 1 + t.2.val)) : D.KoszulIndex i :=
  ⟨Koszul.eraseIndex t.1 j, ⟨Finsupp.single v 1 + t.2.val, hv⟩⟩

theorem nextKoszulIndex_degree {i : ℕ} (t : D.KoszulIndex (i + 1))
    (j : {j // j ∈ t.1.val}) (v : V) (hc : D.color v = j.val)
    (hv : D.allowed (Finsupp.single v 1 + t.2.val)) :
    D.koszulColorDegree (D.nextKoszulIndex t j v hv) = D.koszulColorDegree t := by
  change D.colorDegree (Finsupp.single v 1 + t.2.val) +
    Koszul.faceExponent (t.1.val.erase j.val) = _
  rw [D.colorDegree_add, D.colorDegree_single, hc]
  rw [add_comm (Finsupp.single j.val 1), add_assoc,
    add_comm (Finsupp.single j.val 1), Koszul.faceExponent_erase_add j.property]
  rfl

theorem parameter_variable_smul (j : C) (x : D.Ring K) :
    (X j : MvPolynomial C K) • x = D.colorParameter K j * x := by
  change (D.parameterAction K) (X j) * x = _
  rw [parameterAction, MvPolynomial.aeval_X]

theorem colorParameter_monomial_expansion (j : C) (a : V →₀ ℕ) :
    D.colorParameter K j * D.monomial K a =
      ∑ v ∈ Finset.univ.filter (fun v => D.color v = j),
        if h : D.allowed (Finsupp.single v 1 + a) then D.monomial K (Finsupp.single v 1 + a) else 0 := by
  rw [colorParameter, Finset.sum_mul]
  apply Finset.sum_congr (by ext; simp)
  intro v hv
  rw [D.variable_mul_monomial]
  split_ifs with h
  · rfl
  · exact D.monomial_eq_zero_of_forbidden K _ h

theorem koszulDifferential_basis (i : ℕ) (t : D.KoszulIndex (i + 1)) :
    D.koszulDifferential K i (D.koszulBasis K (i + 1) t) =
      ∑ j : {j // j ∈ t.1.val},
        ∑ v ∈ Finset.univ.filter (fun v => D.color v = j.val),
          if h : D.allowed (Finsupp.single v 1 + t.2.val) then
            TauCeti.ExteriorAlgebra.basisEraseSign j.val t.1.val •
              D.koszulBasis K i (D.nextKoszulIndex t j v h)
          else 0 := by
  obtain ⟨s, a⟩ := t
  rw [koszulBasis_apply (K := K) (D := D)]
  change Koszul.coordinateDifferential (X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) (D.Ring K)) i (Finsupp.single s (D.monomial K a.val)) = _
  rw [Koszul.coordinateDifferential_single]
  apply Finset.sum_congr rfl
  intro j hj
  rw [smul_comm (X j.val), parameter_variable_smul (K := K) (D := D),
    colorParameter_monomial_expansion (K := K) (D := D)]
  simp only [Finset.smul_sum, Finsupp.single_finsetSum]
  apply Finset.sum_congr rfl
  intro v hv
  split_ifs with h
  · simp only [nextKoszulIndex, koszulBasis_apply, Finsupp.smul_single]
  · simp only [smul_zero, Finsupp.single_zero]

theorem koszulDifferential_homogeneous (β : C →₀ ℕ) (i : ℕ)
    {x : Set.powersetCard C (i + 1) →₀ D.Ring K}
    (hx : x ∈ D.colorKoszulPiece K β (i + 1)) :
    D.koszulDifferential K i x ∈ D.colorKoszulPiece K β i := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨t, ht, rfl⟩ := hx
      rw [koszulDifferential_basis (K := K) (D := D)]
      apply Submodule.sum_mem
      intro j hj
      apply Submodule.sum_mem
      intro v hv
      split_ifs with h
      · apply (Submodule.smul_mem_iff' _ (TauCeti.ExteriorAlgebra.basisEraseSign j.val t.1.val)).2
        exact Submodule.subset_span ⟨D.nextKoszulIndex t j v h,
          (D.nextKoszulIndex_degree t j v (Finset.mem_filter.mp hv).2 h).trans ht, rfl⟩
      · exact Submodule.zero_mem _
  | zero => simpa only [map_zero] using (D.colorKoszulPiece K β i).zero_mem
  | add x y hx hy ihx ihy => simpa only [map_add] using (D.colorKoszulPiece K β i).add_mem ihx ihy
  | smul c x hx ih => simpa only [map_smul] using (D.colorKoszulPiece K β i).smul_mem c ih

def colorKoszulDifferential (β : C →₀ ℕ) (i : ℕ) :
    D.colorKoszulPiece K β (i + 1) →ₗ[K] D.colorKoszulPiece K β i :=
  ((D.koszulDifferential K i).domRestrict _).codRestrict _
    (fun x => D.koszulDifferential_homogeneous K β i x.property)

theorem colorKoszulDifferential_comp (β : C →₀ ℕ) (i : ℕ) :
    (D.colorKoszulDifferential K β i).comp (D.colorKoszulDifferential K β (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  exact Subtype.ext (LinearMap.congr_fun (D.koszulDifferential_comp K i) x.val)

def colorKoszulComplex (β : C →₀ ℕ) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (D.colorKoszulPiece K β i))
    (fun i => ModuleCat.ofHom (D.colorKoszulDifferential K β i))
    (fun i => ModuleCat.hom_ext (D.colorKoszulDifferential_comp K β i))

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.ColorfulStrandIndices -/
section

/-! # Exact face indices for every color strand

No squarefreeness is imposed in the first equivalence.  A coefficient monomial
of residual color degree is replaced by its actual supporting face.  In a
squarefree strand the exterior colors are exactly the complementary colors
of that face; the cardinality relation includes the empty face.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset CommAlg
universe u v
variable {V : Type u} {C : Type} [Fintype V] [Fintype C] [LinearOrder C]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C)
local instance : DecidableEq C := Classical.decEq C

abbrev ColorStrandIndex (β : C →₀ ℕ) (i : ℕ) :=
  {t : D.KoszulIndex i // D.koszulColorDegree t = β}

abbrev ResidualFaceIndex (β : C →₀ ℕ) (i : ℕ) :=
  Σ s : {s : Set.powersetCard C i // Koszul.faceExponent s.val ≤ β},
    D.FaceWithColors (β - Koszul.faceExponent s.val.val).support


theorem residualFaceIndex_ext {β : C →₀ ℕ} {i : ℕ}
    {t u : D.ResidualFaceIndex β i}
    (hU : t.1.val.val = u.1.val.val) (hF : t.2.val = u.2.val) : t = u := by
  obtain ⟨s, F⟩ := t
  obtain ⟨t, G⟩ := u
  have hst : s = t := Subtype.ext (Subtype.ext hU)
  cases hst
  exact Sigma.ext rfl (heq_of_eq (Subtype.ext hF))

theorem strandIndex_exterior_le {β : C →₀ ℕ} {i : ℕ} (t : D.ColorStrandIndex β i) :
    Koszul.faceExponent t.val.1.val ≤ β := by
  exact (le_add_self : Koszul.faceExponent t.val.1.val ≤
    D.colorDegree t.val.2.val + Koszul.faceExponent t.val.1.val).trans (le_of_eq t.property)

theorem strandIndex_residual {β : C →₀ ℕ} {i : ℕ} (t : D.ColorStrandIndex β i) :
    D.colorDegree t.val.2.val = β - Koszul.faceExponent t.val.1.val := by
  exact ((add_tsub_cancel_right (D.colorDegree t.val.2.val)
    (Koszul.faceExponent t.val.1.val)).symm).trans
      (congrArg (fun γ => γ - Koszul.faceExponent t.val.1.val) t.property)

def strandIndexFace (β : C →₀ ℕ) (i : ℕ) : D.ColorStrandIndex β i → D.ResidualFaceIndex β i :=
  fun t => ⟨⟨t.val.1, D.strandIndex_exterior_le t⟩,
    D.monomialColorEquiv (β - Koszul.faceExponent t.val.1.val)
      ⟨t.val.2.val, t.val.2.property, D.strandIndex_residual t⟩⟩

def faceStrandIndex (β : C →₀ ℕ) (i : ℕ) : D.ResidualFaceIndex β i → D.ColorStrandIndex β i :=
  fun t =>
    let a := (D.monomialColorEquiv (β - Koszul.faceExponent t.1.val.val)).symm t.2
    ⟨⟨t.1.val, ⟨a.val, a.property.1⟩⟩, by
      change D.colorDegree a.val + Koszul.faceExponent t.1.val.val = β
      rw [a.property.2, tsub_add_cancel_of_le t.1.property]⟩

def strandFaceEquiv (β : C →₀ ℕ) (i : ℕ) : D.ColorStrandIndex β i ≃ D.ResidualFaceIndex β i where
  toFun := D.strandIndexFace β i
  invFun := D.faceStrandIndex β i
  left_inv t := by
    have he := congrArg
      (fun a : D.MonomialOfColorDegree (β - Koszul.faceExponent t.val.1.val) => a.val)
      ((D.monomialColorEquiv (β - Koszul.faceExponent t.val.1.val)).symm_apply_apply
        ⟨t.val.2.val, t.val.2.property, D.strandIndex_residual t⟩)
    apply Subtype.ext
    apply Sigma.ext
    · rfl
    exact heq_of_eq (Subtype.ext he)
  right_inv t := by
    apply D.residualFaceIndex_ext
    · rfl
    exact congrArg Subtype.val
      ((D.monomialColorEquiv (β - Koszul.faceExponent t.1.val.val)).apply_symm_apply t.2)

theorem faceExponent_support (s : Finset C) : (Koszul.faceExponent s).support = s := by
  ext j
  simp only [Finsupp.mem_support_iff, Koszul.faceExponent_apply]
  by_cases hj : j ∈ s <;> simp [hj]

theorem faceExponent_le_iff (s t : Finset C) :
    Koszul.faceExponent s ≤ Koszul.faceExponent t ↔ s ⊆ t := by
  constructor
  · intro h j hj
    have hh := h j
    by_contra hn
    have hh0 : (1 : ℕ) ≤ 0 := by
      simpa only [Koszul.faceExponent_apply, if_pos hj, if_neg hn] using hh
    omega
  · exact Koszul.faceExponent_mono

theorem faceExponent_sub (s t : Finset C) :
    Koszul.faceExponent s - Koszul.faceExponent t = Koszul.faceExponent (s \ t) := by
  ext j
  simp only [Finsupp.tsub_apply, Koszul.faceExponent_apply, Finset.mem_sdiff]
  by_cases hs : j ∈ s <;> by_cases ht : j ∈ t <;> simp [hs, ht]

abbrev SquarefreeFaceIndex (S : Finset C) (i : ℕ) :=
  {F : Finset V // D.face F ∧ F.image D.color ⊆ S ∧ F.card + i = S.card}

theorem face_card_eq_colors (F : Finset V) (hF : D.face F) :
    (F.image D.color).card = F.card := Finset.card_image_of_injOn (D.proper F hF)

def squarefreeStrandFace (S : Finset C) (i : ℕ) :
    D.ColorStrandIndex (Koszul.faceExponent S) i → D.SquarefreeFaceIndex S i := fun t => by
  let a := D.strandFaceEquiv (Koszul.faceExponent S) i t
  have hU : a.1.val.val ⊆ S := (faceExponent_le_iff _ _).mp a.1.property
  have hcolors : a.2.val.image D.color = S \ a.1.val.val := by
    exact a.2.property.2.trans (show
      (Koszul.faceExponent S - Koszul.faceExponent a.1.val.val).support = S \ a.1.val.val by
      rw [faceExponent_sub, faceExponent_support])
  refine ⟨a.2.val, a.2.property.1, ?_, ?_⟩
  · rw [hcolors]
    exact Finset.sdiff_subset
  · rw [← D.face_card_eq_colors a.2.val a.2.property.1, hcolors,
      Finset.card_sdiff_of_subset hU]
    have hc : a.1.val.val.card = i := a.1.val.property
    have hl := Finset.card_le_card hU
    omega

def squarefreeFaceStrand (S : Finset C) (i : ℕ) :
    D.SquarefreeFaceIndex S i → D.ColorStrandIndex (Koszul.faceExponent S) i := fun F => by
  let U := S \ F.val.image D.color
  have hU : U.card = i := by
    rw [Finset.card_sdiff_of_subset F.property.2.1, D.face_card_eq_colors F.val F.property.1]
    omega
  let s : {s : Set.powersetCard C i // Koszul.faceExponent s.val ≤ Koszul.faceExponent S} :=
    ⟨⟨U, hU⟩, Koszul.faceExponent_mono Finset.sdiff_subset⟩
  refine (D.strandFaceEquiv (Koszul.faceExponent S) i).symm ?_
  refine ⟨s, ⟨F.val, F.property.1, ?_⟩⟩
  rw [faceExponent_sub, faceExponent_support]
  change F.val.image D.color = S \ (S \ F.val.image D.color)
  exact (Finset.sdiff_sdiff_self_left _ _).trans (Finset.inter_eq_right.mpr F.property.2.1) |>.symm

def squarefreeStrandFaceEquiv (S : Finset C) (i : ℕ) :
    D.ColorStrandIndex (Koszul.faceExponent S) i ≃ D.SquarefreeFaceIndex S i where
  toFun := D.squarefreeStrandFace S i
  invFun := D.squarefreeFaceStrand S i
  left_inv t := by
    apply (D.strandFaceEquiv (Koszul.faceExponent S) i).injective
    change (D.strandFaceEquiv (Koszul.faceExponent S) i)
      ((D.strandFaceEquiv (Koszul.faceExponent S) i).symm _) = _
    rw [Equiv.apply_symm_apply]
    apply D.residualFaceIndex_ext
    · change S \ (D.strandFaceEquiv (Koszul.faceExponent S) i t).2.val.image D.color = _
      rw [(D.strandFaceEquiv (Koszul.faceExponent S) i t).2.property.2,
        faceExponent_sub, faceExponent_support, Finset.sdiff_sdiff_self_left]
      exact Finset.inter_eq_right.mpr ((faceExponent_le_iff _ _).mp
        (D.strandFaceEquiv (Koszul.faceExponent S) i t).1.property)
    · rfl
  right_inv F := by
    apply Subtype.ext
    change ((D.strandFaceEquiv (Koszul.faceExponent S) i)
      ((D.strandFaceEquiv (Koszul.faceExponent S) i).symm _)).2.val = F.val
    exact congrArg
      (fun t : D.ResidualFaceIndex (Koszul.faceExponent S) i => t.2.val)
      ((D.strandFaceEquiv (Koszul.faceExponent S) i).apply_symm_apply _)

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.ColorfulComplementSigns -/
section

/-! # The complement sign in the colorful cochain comparison -/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical Finset
variable {C : Type*} [LinearOrder C] [DecidableEq C]

def complementSign (S U : Finset C) : ℤˣ :=
  (-1 : ℤˣ) ^ (∑ i ∈ U, (S.filter (fun j => j < i)).card)

theorem complementSign_erase (S U : Finset C) {i : C} (hi : i ∈ U) :
    complementSign S U = complementSign S (U.erase i) *
      (-1 : ℤˣ) ^ (S.filter (fun j => j < i)).card := by
  unfold complementSign
  rw [← Finset.sum_erase_add _ _ hi, pow_add]

theorem filter_card_partition (S U : Finset C) (hU : U ⊆ S) (i : C) :
    (S.filter (fun j => j < i)).card =
      (U.filter (fun j => j < i)).card + ((S \ U).filter (fun j => j < i)).card := by
  have hh : S.filter (fun j => j < i) =
      U.filter (fun j => j < i) ∪ (S \ U).filter (fun j => j < i) := by
    rw [← Finset.filter_union, Finset.union_sdiff_of_subset hU]
  rw [hh, Finset.card_union_of_disjoint]
  apply Finset.disjoint_left.mpr
  intro x hx hy
  exact (Finset.mem_sdiff.mp (Finset.mem_filter.mp hy).1).2
    (Finset.mem_filter.mp hx).1

theorem sign_square (e : ℕ) : ((-1 : ℤˣ) ^ e) * ((-1 : ℤˣ) ^ e) = 1 := by
  rw [← mul_pow]
  simp

/-- Removing an exterior color corresponds to inserting it into the
complementary face, with exactly the ordinary coboundary sign. -/
theorem complementSign_boundary (S U : Finset C) (hU : U ⊆ S) {i : C} (hi : i ∈ U) :
    TauCeti.ExteriorAlgebra.basisEraseSign i U * complementSign S (U.erase i) =
      complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign i (S \ U) := by
  rw [complementSign_erase S U hi,
    TauCeti.ExteriorAlgebra.basisEraseSign_eq_neg_one_pow_card_filter_lt,
    TauCeti.ExteriorAlgebra.basisEraseSign_eq_neg_one_pow_card_filter_lt,
    filter_card_partition S U hU i, pow_add]
  rw [mul_assoc, mul_assoc, sign_square, mul_one, mul_comm]

namespace ProperlyColoredComplex
variable {V : Type*} [Fintype V]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C)

/-- A global vertex ordering whose restriction to every face is exactly the
color ordering.  The auxiliary finite enumeration only breaks ties between
vertices that cannot lie together in a face. -/
def colorLinearOrder : LinearOrder V :=
  LinearOrder.lift' (fun v => toLex (D.color v, (Fintype.equivFin V) v)) (by
    intro v w h
    apply (Fintype.equivFin V).injective
    exact congrArg (fun p => (ofLex p).2) h)

theorem colorLinearOrder_lt_iff (F : Finset V) (hF : D.face F)
    {v w : V} (hv : v ∈ F) (hw : w ∈ F) :
    @LT.lt V D.colorLinearOrder.toLT v w ↔ D.color v < D.color w := by
  change (toLex (D.color v, (Fintype.equivFin V) v) <
    toLex (D.color w, (Fintype.equivFin V) w)) ↔ _
  rw [Prod.Lex.toLex_lt_toLex]
  constructor
  · rintro (h | ⟨hc, he⟩)
    · exact h
    · have hvw := D.proper F hF hv hw hc
      exact (lt_irrefl _ (hvw ▸ he)).elim
  · exact Or.inl

end ProperlyColoredComplex
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeCochainCoordinates -/
section

/-! # Coordinates of the ordinary augmented relative cochains

These are evaluations on the actual oriented simplicial face chains, after
the literal quotient by the subcomplex.  Faces of the subcomplex have zero
coordinate.  The construction is over an arbitrary commutative ring.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical CommAlg
variable {K V : Type*} [CommRing K] [Fintype V] [LinearOrder V]

abbrev AugmentedFaceIndex (Λ : Finset V → Prop) (i : ℕ) :=
  {F : Finset V // Λ F ∧ F.card = i}

abbrev RelativeFaceIndex (Λ Λ₀ : Finset V → Prop) (i : ℕ) :=
  {F : Finset V // Λ F ∧ F.card = i ∧ ¬ Λ₀ F}

def augmentedChainBasis (Λ : Finset V → Prop) (i : ℕ) :
    Module.Basis (AugmentedFaceIndex Λ i) K (Simplicial.Chains (k := K) Λ i) :=
  Grading.restrictedBasis Simplicial.basis (fun F => Λ F ∧ F.card = i)

@[simp] theorem augmentedChainBasis_val (Λ : Finset V → Prop) (i : ℕ)
    (F : AugmentedFaceIndex Λ i) :
    (augmentedChainBasis (K := K) Λ i F).val = Simplicial.basis F.val :=
  Grading.restrictedBasis_val _ _ F

def relativeFaceClass (Λ Λ₀ : Finset V → Prop) (i : ℕ) (F : AugmentedFaceIndex Λ i) :
    RelativeAugmentedChains (K := K) Λ Λ₀ i :=
  Submodule.Quotient.mk (augmentedChainBasis Λ i F)

theorem relativeFaceClass_zero (Λ Λ₀ : Finset V → Prop) (i : ℕ)
    (F : AugmentedFaceIndex Λ i) (hF : Λ₀ F.val) :
    relativeFaceClass (K := K) Λ Λ₀ i F = 0 := by
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  change (augmentedChainBasis Λ i F).val ∈ Simplicial.Chains Λ₀ i
  rw [augmentedChainBasis_val]
  exact Simplicial.basis_mem hF F.property.2

def relativeCochainCoordinates (Λ Λ₀ : Finset V → Prop) (i : ℕ) :
    Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i) →ₗ[K]
      (RelativeFaceIndex Λ Λ₀ i → K) where
  toFun f F := f (relativeFaceClass Λ Λ₀ i ⟨F.val, F.property.1, F.property.2.1⟩)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def extendRelativeCoordinates (Λ Λ₀ : Finset V → Prop) (i : ℕ)
    (f : RelativeFaceIndex Λ Λ₀ i → K) : Simplicial.Ambient V K →ₗ[K] K :=
  Simplicial.basis.constr K (fun F =>
    if h : Λ F ∧ F.card = i ∧ ¬ Λ₀ F then f ⟨F, h⟩ else 0)

@[simp] theorem extendRelativeCoordinates_basis (Λ Λ₀ : Finset V → Prop) (i : ℕ)
    (f : RelativeFaceIndex Λ Λ₀ i → K) (F : Finset V) :
    extendRelativeCoordinates Λ Λ₀ i f (Simplicial.basis F) =
      if h : Λ F ∧ F.card = i ∧ ¬ Λ₀ F then f ⟨F, h⟩ else 0 := by
  exact Module.Basis.constr_basis _ _ _ F

theorem extendRelativeCoordinates_kills (Λ Λ₀ : Finset V → Prop) (i : ℕ)
    (f : RelativeFaceIndex Λ Λ₀ i → K) {z : Simplicial.Ambient V K}
    (hz : z ∈ Simplicial.Chains Λ₀ i) : extendRelativeCoordinates Λ Λ₀ i f z = 0 := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨F, hF, rfl⟩ := hz
      rw [extendRelativeCoordinates_basis, dif_neg]
      exact fun h => h.2.2 hF.1
  | zero => exact map_zero _
  | add x y hx hy ihx ihy => rw [map_add, ihx, ihy, add_zero]
  | smul c x hx ih => rw [map_smul, ih, smul_zero]

def relativeCochainFromCoordinates (Λ Λ₀ : Finset V → Prop) (i : ℕ)
    (f : RelativeFaceIndex Λ Λ₀ i → K) :
    Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i) := by
  let f' : Simplicial.Chains (k := K) Λ i →ₗ[K] K :=
    (extendRelativeCoordinates (K := K) Λ Λ₀ i f).domRestrict (Simplicial.Chains (k := K) Λ i)
  exact (relativeFaceSubmodule (K := K) Λ Λ₀ i).liftQ f' (by
    intro z hz
    exact extendRelativeCoordinates_kills (K := K) Λ Λ₀ i f (z := z.val) hz)

theorem relativeCochainCoordinates_injective (Λ Λ₀ : Finset V → Prop) (i : ℕ) :
    Function.Injective (relativeCochainCoordinates (K := K) Λ Λ₀ i) := by
  intro f g h
  apply Submodule.linearMap_qext
  apply (augmentedChainBasis (K := K) Λ i).ext
  intro F
  change f (relativeFaceClass Λ Λ₀ i F) = g (relativeFaceClass Λ Λ₀ i F)
  by_cases hF : Λ₀ F.val
  · rw [relativeFaceClass_zero Λ Λ₀ i F hF, map_zero, map_zero]
  · exact congrFun h ⟨F.val, F.property.1, F.property.2, hF⟩

theorem relativeCochainCoordinates_surjective (Λ Λ₀ : Finset V → Prop) (i : ℕ) :
    Function.Surjective (relativeCochainCoordinates (K := K) Λ Λ₀ i) := by
  intro f
  refine ⟨relativeCochainFromCoordinates Λ Λ₀ i f, ?_⟩
  funext F
  change extendRelativeCoordinates Λ Λ₀ i f
    (augmentedChainBasis Λ i ⟨F.val, F.property.1, F.property.2.1⟩).val = f F
  rw [augmentedChainBasis_val, extendRelativeCoordinates_basis, dif_pos F.property]

/-- The coordinates are an isomorphism for the independently defined standard
cochains, rather than a definition of their cohomology. -/
def relativeCochainCoordinateEquiv (Λ Λ₀ : Finset V → Prop) (i : ℕ) :
    Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i) ≃ₗ[K]
      (RelativeFaceIndex Λ Λ₀ i → K) :=
  LinearEquiv.ofBijective (relativeCochainCoordinates Λ Λ₀ i)
    ⟨relativeCochainCoordinates_injective Λ Λ₀ i,
      relativeCochainCoordinates_surjective Λ Λ₀ i⟩

def eraseAugmentedFace (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ)
    (i : ℕ) (F : AugmentedFaceIndex Λ (i + 1)) (v : {v // v ∈ F.val}) :
    AugmentedFaceIndex Λ i :=
  ⟨F.val.erase v.val, hΛ (Finset.erase_subset _ _) F.property.1,
    by simpa only [F.property.2, Nat.add_sub_cancel] using Finset.card_erase_of_mem v.property⟩

theorem augmentedFaceBoundary_basis (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ)
    (i : ℕ) (F : AugmentedFaceIndex Λ (i + 1)) :
    augmentedFaceBoundary (K := K) Λ hΛ i (augmentedChainBasis Λ (i + 1) F) =
      ∑ v : {v // v ∈ F.val}, TauCeti.ExteriorAlgebra.basisEraseSign v.val F.val •
        augmentedChainBasis Λ i (eraseAugmentedFace Λ hΛ i F v) := by
  apply Subtype.ext
  change Simplicial.boundary ((augmentedChainBasis Λ (i + 1) F).val) = _
  rw [augmentedChainBasis_val, Simplicial.boundary_eq_sum]
  simp only [Submodule.coe_sum, Submodule.coe_smul_of_tower]
  change (∑ v : V, Simplicial.contraction (k := K) v (Simplicial.basis (k := K) F.val)) =
    ∑ v : {v // v ∈ F.val}, TauCeti.ExteriorAlgebra.basisEraseSign v.val F.val •
      (augmentedChainBasis (K := K) Λ i (eraseAugmentedFace Λ hΛ i F v)).val
  calc
    _ = ∑ v ∈ F.val, Simplicial.contraction (k := K) v (Simplicial.basis (k := K) F.val) := by
      symm
      apply Finset.sum_subset (Finset.subset_univ _)
      intro v hv hn
      rw [Simplicial.contraction_basis, if_neg hn]
    _ = ∑ v : {v // v ∈ F.val}, Simplicial.contraction (k := K) v.val (Simplicial.basis (k := K) F.val) :=
      Finset.sum_subtype F.val (fun _ => Iff.rfl) _
    _ = _ := by
      apply Finset.sum_congr rfl
      intro v hv
      rw [Simplicial.contraction_basis, if_pos v.property, augmentedChainBasis_val]
      rfl

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.AssociatedGradeMultiplication -/
section

/-! # Multiplication on the literal associated-grade quotients

The product is induced from the original ring product by the two quotient
universal properties.  It is not transported along the comparison map.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical MvPolynomial
variable {K A : Type*} [CommRing K] [Ring A] [Algebra K A]

def WeightMultiplicative (F : ℤ → Submodule K A) : Prop :=
  ∀ r s x y, x ∈ F (r + 1) → y ∈ F (s + 1) → x * y ∈ F (r + s + 1)

def weightLevelProduct (F : ℤ → Submodule K A) (hmul : WeightMultiplicative F) (r s : ℤ) :
    F (r + 1) →ₗ[K] F (s + 1) →ₗ[K] F (r + s + 1) where
  toFun x :=
    { toFun := fun y => ⟨x.val * y.val, hmul r s x.val y.val x.property y.property⟩
      map_add' := fun y z => Subtype.ext (mul_add x.val y.val z.val)
      map_smul' := fun c y => Subtype.ext (mul_smul_comm c x.val y.val) }
  map_add' x y := by ext z; exact add_mul x.val y.val z.val
  map_smul' c x := by ext y; exact smul_mul_assoc c x.val y.val

def weightLevelProductClass (F : ℤ → Submodule K A) (hmul : WeightMultiplicative F) (r s : ℤ) :
    F (r + 1) →ₗ[K] F (s + 1) →ₗ[K] weightFiltrationGrade F (r + s) :=
  (weightLevelProduct F hmul r s).compr₂ ((F (r + s)).comap (F (r + s + 1)).subtype).mkQ

theorem weightLevelProductClass_left_lower (F : ℤ → Submodule K A)
    (hmul : WeightMultiplicative F) (r s : ℤ) :
    (F r).comap (F (r + 1)).subtype ≤ LinearMap.ker (weightLevelProductClass F hmul r s) := by
  intro x hx
  apply LinearMap.ext
  intro y
  change Submodule.Quotient.mk (weightLevelProduct F hmul r s x y) = 0
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  have h := hmul (r - 1) s x.val y.val (by simpa using hx) y.property
  change x.val * y.val ∈ F (r + s)
  simpa only [show r - 1 + s + 1 = r + s by omega] using h

theorem weightLevelProductClass_right_lower (F : ℤ → Submodule K A)
    (hmul : WeightMultiplicative F) (r s : ℤ) :
    (F s).comap (F (s + 1)).subtype ≤ LinearMap.ker (weightLevelProductClass F hmul r s).flip := by
  intro y hy
  apply LinearMap.ext
  intro x
  change Submodule.Quotient.mk (weightLevelProduct F hmul r s x y) = 0
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  have h := hmul r (s - 1) x.val y.val x.property (by simpa using hy)
  change x.val * y.val ∈ F (r + s)
  simpa only [show r + (s - 1) + 1 = r + s by omega] using h

/-- The multiplication induced by the original ring multiplication on two
consecutive filtration quotients. -/
def weightGradeProduct (F : ℤ → Submodule K A) (hmul : WeightMultiplicative F) (r s : ℤ) :
    weightFiltrationGrade F r →ₗ[K] weightFiltrationGrade F s →ₗ[K]
      weightFiltrationGrade F (r + s) :=
  (weightLevelProductClass F hmul r s).liftQ₂ _ _
    (weightLevelProductClass_left_lower F hmul r s)
    (weightLevelProductClass_right_lower F hmul r s)

@[simp] theorem weightGradeProduct_mk (F : ℤ → Submodule K A)
    (hmul : WeightMultiplicative F) (r s : ℤ) (x : F (r + 1)) (y : F (s + 1)) :
    weightGradeProduct F hmul r s (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk (weightLevelProduct F hmul r s x y) := rfl

section Poset
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P)

@[simp] theorem canonicalOriginalComparison_one :
    canonicalOriginalComparison K hs (1 : BarycentricRing (P := P) K) = 1 := by
  let a : StandardFaceIndex P := ⟨0, by simp [BarycentricAllowed]⟩
  have hB : barycentricGlobalStandardBasis K a = 1 := by
    rw [← barycentricGlobalStandardBasis_monomial]
    simp [a, MvPolynomial.monomial_zero]
  have hR : standardFaceBasis K hs a = 1 := by
    rw [standardFaceBasis_apply]
    simp [a, faceRingMonomial, MvPolynomial.monomial_zero]
  rw [← hB, canonicalOriginalComparison_basis, hR]

theorem standardFaceBasis_product_weight (d : ℕ) (a b : StandardFaceIndex P) :
    standardFaceBasis K hs a * standardFaceBasis K hs b ∈
      originalFaceWeightLevel K hs d (standardRankWeight d a + standardRankWeight d b + 1) := by
  rw [standardFaceBasis_apply, standardFaceBasis_apply, ← faceRingMonomial_add]
  intro c hc
  exact originalFace_monomial_weight K hs d (a.val + b.val) 1 c (by
    rw [originalPolynomialWeight_add]
    change standardRankWeight d a + standardRankWeight d b < standardRankWeight d c
    omega)

theorem barycentricBasis_product_weight (d : ℕ) (a b : StandardFaceIndex P) :
    barycentricGlobalStandardBasis K a * barycentricGlobalStandardBasis K b ∈
      originalBarycentricWeightLevel K d (standardRankWeight d a + standardRankWeight d b + 1) := by
  rw [barycentricStandardBasis_product]
  by_cases hab : BarycentricAllowed (a.val + b.val)
  · rw [barycentricGlobalStandardBasis_monomial K ⟨a.val + b.val, hab⟩]
    intro c hc
    rw [Module.Basis.repr_self, Finsupp.single_apply]
    apply if_neg
    intro he
    have hw : standardRankWeight d (⟨a.val + b.val, hab⟩ : StandardFaceIndex P) =
        standardRankWeight d a + standardRankWeight d b := originalPolynomialWeight_add d a.val b.val
    rw [he] at hw
    omega
  · rw [barycentricMonomial_forbidden K _ hab]
    exact Submodule.zero_mem _

theorem originalFaceWeight_multiplicative (d : ℕ) :
    WeightMultiplicative (originalFaceWeightLevel K hs d) := by
  intro r s x y hx hy
  apply bilinear_mem_of_basis_support K (standardFaceBasis K hs) (standardFaceBasis K hs)
    (LinearMap.mul K (FaceRing K hs))
  intro a ha b hb
  have hwa := basisWeightLevel_support (standardFaceBasis K hs) (standardRankWeight d) (r + 1) x hx a ha
  have hwb := basisWeightLevel_support (standardFaceBasis K hs) (standardRankWeight d) (s + 1) y hy b hb
  exact basisWeightLevel_mono K (standardFaceBasis K hs) (standardRankWeight d)
    (show standardRankWeight d a + standardRankWeight d b + 1 ≤ r + s + 1 by omega)
    (standardFaceBasis_product_weight K hs d a b)

theorem originalBarycentricWeight_multiplicative (d : ℕ) :
    WeightMultiplicative (originalBarycentricWeightLevel (P := P) K d) := by
  intro r s x y hx hy
  apply bilinear_mem_of_basis_support K (barycentricGlobalStandardBasis K)
    (barycentricGlobalStandardBasis K) (LinearMap.mul K (BarycentricRing (P := P) K))
  intro a ha b hb
  have hwa := basisWeightLevel_support (barycentricGlobalStandardBasis K) (standardRankWeight d)
    (r + 1) x hx a ha
  have hwb := basisWeightLevel_support (barycentricGlobalStandardBasis K) (standardRankWeight d)
    (s + 1) y hy b hb
  exact basisWeightLevel_mono K (barycentricGlobalStandardBasis K) (standardRankWeight d)
    (show standardRankWeight d a + standardRankWeight d b + 1 ≤ r + s + 1 by omega)
    (barycentricBasis_product_weight K d a b)

/-- The canonical associated-grade comparison respects the literal quotient
multiplications, in every pair of integer filtration degrees. -/
theorem canonicalOriginalAssociatedGrade_multiplicative (d : ℕ) (r s : ℤ)
    (x : weightFiltrationGrade (originalBarycentricWeightLevel (P := P) K d) r)
    (y : weightFiltrationGrade (originalBarycentricWeightLevel (P := P) K d) s) :
    weightFiltrationGradeEquiv (originalBarycentricWeightLevel K d) (originalFaceWeightLevel K hs d)
        (canonicalOriginalComparison K hs) (canonicalOriginalComparison_filtered K hs d) (r + s)
        (weightGradeProduct (originalBarycentricWeightLevel K d)
          (originalBarycentricWeight_multiplicative K d) r s x y) =
      weightGradeProduct (originalFaceWeightLevel K hs d) (originalFaceWeight_multiplicative K hs d) r s
        (weightFiltrationGradeEquiv (originalBarycentricWeightLevel K d) (originalFaceWeightLevel K hs d)
          (canonicalOriginalComparison K hs) (canonicalOriginalComparison_filtered K hs d) r x)
        (weightFiltrationGradeEquiv (originalBarycentricWeightLevel K d) (originalFaceWeightLevel K hs d)
          (canonicalOriginalComparison K hs) (canonicalOriginalComparison_filtered K hs d) s y) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  change Submodule.Quotient.mk (⟨canonicalOriginalComparison K hs (x.val * y.val), _⟩ :
      originalFaceWeightLevel K hs d (r + s + 1)) =
    Submodule.Quotient.mk ⟨canonicalOriginalComparison K hs x.val *
      canonicalOriginalComparison K hs y.val, _⟩
  apply (Submodule.Quotient.eq _).mpr
  have h := canonicalOriginalComparison_product_lower K hs d r s x.val y.val
    (by rw [usualBarycentricWeightLevel_eq]; exact x.property)
    (by rw [usualBarycentricWeightLevel_eq]; exact y.property)
  rwa [usualFaceWeightLevel_eq] at h

end Poset
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ColorfulTorGrading -/
section

/-! # Genuine color grading of the ordinary derived Tor module

Each homogeneous part is mapped into Mathlib's actual derived tensor module.
Its inclusion splits by a genuine homogeneous chain projection.  The Tor
comparison includes the zero coefficient ring and uses the coefficient ring
itself, with its usual augmentation action, as the second argument.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)
local instance colorParameterAlgebra : Algebra (MvPolynomial C K) (D.Ring K) :=
  (D.parameterAction K).toRingHom.toAlgebra

def colorUnderlyingComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of
    (fun i => ModuleCat.of K (Set.powersetCard C i →₀ D.Ring K))
    (fun i => ModuleCat.ofHom (D.koszulDifferential K i))
    (fun i => ModuleCat.hom_ext (D.koszulDifferential_comp K i))

@[simp] theorem colorUnderlyingComplex_d (i : ℕ) :
    (D.colorUnderlyingComplex K).d (i + 1) i = ModuleCat.ofHom (D.koszulDifferential K i) := by
  simp [colorUnderlyingComplex]

@[simp] theorem colorKoszulComplex_d (β : C →₀ ℕ) (i : ℕ) :
    (D.colorKoszulComplex K β).d (i + 1) i = ModuleCat.ofHom (D.colorKoszulDifferential K β i) := by
  simp [colorKoszulComplex]

def colorProjection (β : C →₀ ℕ) (i : ℕ) :
    Module.End K (Set.powersetCard C i →₀ D.Ring K) :=
  Grading.projection (D.koszulBasis K i) D.koszulColorDegree β

theorem colorProjection_commutes (β : C →₀ ℕ) (i : ℕ) :
    (D.colorProjection K β i).comp (D.koszulDifferential K i) =
      (D.koszulDifferential K i).comp (D.colorProjection K β (i + 1)) := by
  apply (D.koszulBasis K (i + 1)).ext
  intro t
  change D.colorProjection K β i (D.koszulDifferential K i (D.koszulBasis K (i + 1) t)) =
    D.koszulDifferential K i (D.colorProjection K β (i + 1) (D.koszulBasis K (i + 1) t))
  have hm := D.koszulDifferential_homogeneous K (D.koszulColorDegree t) i
    (Grading.basis_mem_piece (D.koszulBasis K (i + 1)) D.koszulColorDegree t)
  change Grading.projection _ _ β _ = D.koszulDifferential K i (Grading.projection _ _ β _)
  rw [Grading.projection_basis]
  by_cases ht : D.koszulColorDegree t = β
  · rw [if_pos ht]
    exact Grading.projection_eq_self (ht ▸ hm)
  · rw [if_neg ht, map_zero]
    exact Grading.projection_eq_zero (Ne.symm ht) hm

def colorInclusion (β : C →₀ ℕ) : D.colorKoszulComplex K β ⟶ D.colorUnderlyingComplex K where
  f i := ModuleCat.ofHom (D.colorKoszulPiece K β i).subtype
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [colorUnderlyingComplex_d, colorKoszulComplex_d]
    rfl

def colorRetraction (β : C →₀ ℕ) : D.colorUnderlyingComplex K ⟶ D.colorKoszulComplex K β where
  f i := ModuleCat.ofHom ((D.colorProjection K β i).codRestrict _
    (fun x => Grading.projection_mem (D.koszulBasis K i) D.koszulColorDegree β x))
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [colorUnderlyingComplex_d, colorKoszulComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact (LinearMap.congr_fun (D.colorProjection_commutes K β j) x).symm

theorem colorInclusion_retraction (β : C →₀ ℕ) :
    D.colorInclusion K β ≫ D.colorRetraction K β = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact Grading.projection_eq_self x.property

theorem colorHomology_injective (β : C →₀ ℕ) (i : ℕ) :
    Function.Injective (HomologicalComplex.homologyMap (D.colorInclusion K β) i).hom := by
  have hs : HomologicalComplex.homologyMap (D.colorInclusion K β) i ≫
      HomologicalComplex.homologyMap (D.colorRetraction K β) i = 𝟙 _ := by
    rw [← HomologicalComplex.homologyMap_comp, colorInclusion_retraction,
      HomologicalComplex.homologyMap_id]
  intro x y h
  have hh := congrArg (HomologicalComplex.homologyMap (D.colorRetraction K β) i) h
  simpa only [← ModuleCat.comp_apply, hs, ModuleCat.id_apply] using hh

def colorRestrictionEquiv (i : ℕ) :
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).obj
      (ModuleCat.of (MvPolynomial C K) (Set.powersetCard C i →₀ D.Ring K))) ≃ₗ[K]
      (Set.powersetCard C i →₀ D.Ring K) where
  toFun := id
  invFun := id
  left_inv := fun _ => rfl
  right_inv := fun _ => rfl
  map_add' := fun _ _ => rfl
  map_smul' r z := by
    change (algebraMap K (MvPolynomial C K) r) •
      (show Set.powersetCard C i →₀ D.Ring K from z) =
      r • (show Set.powersetCard C i →₀ D.Ring K from z)
    exact algebraMap_smul (MvPolynomial C K) r (show Set.powersetCard C i →₀ D.Ring K from z)

def colorRestrictionComplexIso :
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
      (Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K)
        (ModuleCat.of (MvPolynomial C K) (D.Ring K))) ≅ D.colorUnderlyingComplex K :=
  HomologicalComplex.Hom.isoOfComponents (fun i => (D.colorRestrictionEquiv K i).toModuleIso) (by
    intro i j hij
    obtain rfl : i = j + 1 := hij.symm
    simp only [Functor.mapHomologicalComplex_obj_d, Koszul.coordinateComplex_d, colorUnderlyingComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    rfl)

def ordinaryColorTor (i : ℕ) : ModuleCat.{u} K :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).obj
    (((Tor (ModuleCat (MvPolynomial C K)) i).obj
      (ModuleCat.of (MvPolynomial C K) (D.Ring K))).obj
        (Koszul.residueCoefficientModule (V := C) (k := K)))

def colorTorIsoNontrivial [Nontrivial K] (i : ℕ) :
    D.ordinaryColorTor K i ≅ (D.colorUnderlyingComplex K).homology i :=
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let M := ModuleCat.of (MvPolynomial C K) (D.Ring K)
  let Cx := Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K) M
  F.mapIso (ordinaryFinitePolynomialTorIso i M ≪≫
    (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).mapIso
      (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) M)) ≪≫
    ((Cx.sc i).mapHomologyIso F).symm ≪≫
    (HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).mapIso
      (D.colorRestrictionComplexIso K)

/-- Genuine derived Tor over every coefficient ring, including the zero ring. -/
def colorTorIso (i : ℕ) : D.ordinaryColorTor K i ≅ (D.colorUnderlyingComplex K).homology i := by
  by_cases h : Nontrivial K
  · letI := h
    exact D.colorTorIsoNontrivial K i
  · letI : Subsingleton K := not_nontrivial_iff_subsingleton.mp h
    letI := Module.subsingleton K (D.ordinaryColorTor K i)
    letI := Module.subsingleton K ((D.colorUnderlyingComplex K).homology i)
    exact
      { hom := 0
        inv := 0
        hom_inv_id := by
          apply ModuleCat.hom_ext
          ext x
          exact Subsingleton.elim _ _
        inv_hom_id := by
          apply ModuleCat.hom_ext
          ext x
          exact Subsingleton.elim _ _ }

def colorHomologyToTor (β : C →₀ ℕ) (i : ℕ) :
    (D.colorKoszulComplex K β).homology i ⟶ D.ordinaryColorTor K i :=
  HomologicalComplex.homologyMap (D.colorInclusion K β) i ≫ (D.colorTorIso K i).inv

theorem colorHomologyToTor_injective (β : C →₀ ℕ) (i : ℕ) :
    Function.Injective (D.colorHomologyToTor K β i).hom :=
  (D.colorTorIso K i).symm.toLinearEquiv.injective.comp (D.colorHomology_injective K β i)

/-- An actual submodule of derived Tor, not a combinatorial replacement. -/
def colorTorPiece (β : C →₀ ℕ) (i : ℕ) : Submodule K (D.ordinaryColorTor K i) :=
  LinearMap.range (D.colorHomologyToTor K β i).hom

def colorTorPieceIso (β : C →₀ ℕ) (i : ℕ) :
    (D.colorKoszulComplex K β).homology i ≅ ModuleCat.of K (D.colorTorPiece K β i) :=
  (LinearEquiv.ofInjective (D.colorHomologyToTor K β i).hom
    (D.colorHomologyToTor_injective K β i)).toModuleIso

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Common.BasisPieces -/
section

/-! # Basis degree pieces and projections

A small, standalone implementation of the span and coefficient-projection
constructions used in the filtered homology argument.  The definitions are
literal submodules of the original module.  No homological infrastructure is
required to construct them.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.BasisGrading

open Classical

variable {R M I A : Type*} [CommRing R] [AddCommMonoid M] [Module R M]

/-- Restrict a basis to the span of an arbitrary set of its indices. -/
def restrictedBasis (b : Module.Basis I R M) (P : I → Prop) :
    Module.Basis {i // P i} R (Submodule.span R (b '' {i | P i})) :=
  (Module.Basis.span (b.linearIndependent.comp Subtype.val Subtype.val_injective)).map
    (LinearEquiv.ofEq _ _ (by congr 1; ext x; simp))

@[simp] lemma restrictedBasis_val (b : Module.Basis I R M) (P : I → Prop)
    (i : {i // P i}) :
    (restrictedBasis b P i).val = b i.val := by
  simp [restrictedBasis, Module.Basis.map_apply]

/-- A degree component is a genuine submodule of the original module. -/
def Piece (b : Module.Basis I R M) (deg : I → A) (a : A) : Submodule R M :=
  Submodule.span R (b '' {i | deg i = a})

lemma mem_piece (b : Module.Basis I R M) (deg : I → A) (a : A) (x : M) :
    x ∈ Piece b deg a ↔ ∀ i, b.repr x i ≠ 0 → deg i = a := by
  rw [Piece, b.mem_span_image]
  simp only [Set.subset_def, Finset.mem_coe, Finsupp.mem_support_iff, Set.mem_setOf_eq]

lemma basis_mem_piece (b : Module.Basis I R M) (deg : I → A) (i : I) :
    b i ∈ Piece b deg (deg i) := Submodule.subset_span ⟨i, rfl, rfl⟩

def filterMap (P : I → Prop) : (I →₀ R) →ₗ[R] (I →₀ R) where
  toFun := Finsupp.filter P
  map_add' x y := Finsupp.filter_add
  map_smul' c x := Finsupp.filter_smul

@[simp] lemma filterMap_apply (P : I → Prop) (x : I →₀ R) :
    filterMap P x = x.filter P := rfl

/-- Homogeneous projection defined on the original module by its actual basis coefficients. -/
def projection (b : Module.Basis I R M) (deg : I → A) (a : A) : M →ₗ[R] M :=
  b.repr.symm.toLinearMap ∘ₗ filterMap (fun i => deg i = a) ∘ₗ
    b.repr.toLinearMap

@[simp] lemma projection_basis (b : Module.Basis I R M) (deg : I → A) (a : A) (i : I) :
    projection b deg a (b i) = if deg i = a then b i else 0 := by
  by_cases h : deg i = a
  · simp [projection, h, Finsupp.filter_single_of_pos]
  · simp [projection, h, Finsupp.filter_single_of_neg]

lemma projection_mem (b : Module.Basis I R M) (deg : I → A) (a : A) (x : M) :
    projection b deg a x ∈ Piece b deg a := by
  rw [mem_piece]
  intro i hi
  simp only [projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, filterMap_apply,
    Finsupp.filter_apply] at hi
  split_ifs at hi with h
  · exact h
  · exact (hi rfl).elim

lemma projection_eq_self {b : Module.Basis I R M} {deg : I → A} {a : A} {x : M}
    (hx : x ∈ Piece b deg a) : projection b deg a x = x := by
  apply b.repr.injective
  simp only [projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply]
  ext i
  simp only [filterMap_apply, Finsupp.filter_apply]
  by_cases hi : deg i = a
  · simp [hi]
  · have hz : b.repr x i = 0 := by
      by_contra hn
      exact hi ((mem_piece b deg a x).mp hx i hn)
    simp [hi, hz]

lemma projection_eq_zero {b : Module.Basis I R M} {deg : I → A} {a c : A}
    (h : a ≠ c) {x : M} (hx : x ∈ Piece b deg c) : projection b deg a x = 0 := by
  apply b.repr.injective
  simp only [projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, map_zero]
  ext i
  simp only [filterMap_apply, Finsupp.filter_apply, Finsupp.zero_apply]
  split_ifs with hi
  · by_contra hn
    exact h (hi.symm.trans ((mem_piece b deg c x).mp hx i hn))
  · rfl

/-- Every actual vector is the finite sum of its homogeneous components. -/
lemma sum_projections [DecidableEq A] (b : Module.Basis I R M) (deg : I → A) (x : M) :
    ∑ a ∈ (b.repr x).support.image deg, projection b deg a x = x := by
  apply b.repr.injective
  simp only [map_sum, projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply]
  ext i
  simp only [Finsupp.finset_sum_apply, filterMap_apply, Finsupp.filter_apply]
  by_cases hi : b.repr x i = 0
  · simp [hi]
  · have hm : deg i ∈ (b.repr x).support.image deg :=
      Finset.mem_image.mpr ⟨i, Finsupp.mem_support_iff.mpr hi, rfl⟩
    rw [Finset.sum_eq_single (deg i)]
    · simp
    · intro a ha hne
      simp [Ne.symm hne]
    · intro hnot
      exact (hnot hm).elim

section Maps
variable {N J : Type*} [AddCommMonoid N] [Module R N]

/-- Homogeneous basis images give a map of the actual homogeneous submodules. -/
lemma map_piece (b : Module.Basis I R M) (c : Module.Basis J R N)
    (w : I → A) (v : J → A) (f : M →ₗ[R] N)
    (hf : ∀ i, f (b i) ∈ Piece c v (w i)) (a : A)
    (x : M) (hx : x ∈ Piece b w a) : f x ∈ Piece c v a := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      change w i = a at hi
      simpa only [hi] using hf i
  | zero => simpa only [map_zero] using (Piece c v a).zero_mem
  | add x y hx hy ihx ihy => simpa only [map_add] using (Piece c v a).add_mem ihx ihy
  | smul r x hx ih => simpa only [map_smul] using (Piece c v a).smul_mem r ih

/-- Any coefficient projection preserves every other basis grading. -/
lemma projection_mem_piece {A' : Type*} (b : Module.Basis I R M)
    (w : I → A) (v : I → A') (a : A) (a' : A') (x : M)
    (hx : x ∈ Piece b v a') : projection b w a x ∈ Piece b v a' := by
  rw [mem_piece] at hx ⊢
  intro i hi
  apply hx i
  intro hz
  apply hi
  simp only [projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, filterMap_apply, Finsupp.filter_apply, hz, ite_self]

end Maps

end FourPapers.BasisGrading

end
end

/- BEGIN FourPapers.Common.FilteredHomologyNaturality -/
section

/-! # Naturality of the canonical filtered homology comparison

The maps on homology and its filtration are the maps induced on cycles and
boundaries.  Naturality is proved on actual cycle representatives.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.FilteredHomology
open Classical
variable {K X Y Z X' Y' Z' : Type*} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z] [AddCommGroup X'] [Module K X']
  [AddCommGroup Y'] [Module K Y'] [AddCommGroup Z'] [Module K Z']
variable (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
  (f' : X' →ₗ[K] Y') (g' : Y' →ₗ[K] Z') (hfg' : g'.comp f' = 0)
  (a : X →ₗ[K] X') (b : Y →ₗ[K] Y') (c : Z →ₗ[K] Z')
  (hab : b.comp f = f'.comp a) (hbc : c.comp g = g'.comp b)

def inducedCycleMap : LinearMap.ker g →ₗ[K] LinearMap.ker g' :=
  (b.domRestrict _).codRestrict _ (by
    intro y
    change g' (b y.val) = 0
    have hy : g y.val = 0 := y.property
    have h := LinearMap.congr_fun hbc y.val
    simpa only [LinearMap.comp_apply, hy, map_zero] using h.symm)

include hab in
theorem inducedCycleMap_boundary (x : X) :
    inducedCycleMap g g' b c hbc (boundaryMap f g hfg x) =
      boundaryMap f' g' hfg' (a x) := by
  apply Subtype.ext
  exact LinearMap.congr_fun hab x

def inducedHomologyMap : Homology f g hfg →ₗ[K] Homology f' g' hfg' :=
  Submodule.mapQ _ _ (inducedCycleMap g g' b c hbc) (by
    rintro z ⟨x, rfl⟩
    exact ⟨a x, (inducedCycleMap_boundary f g hfg f' g' hfg' a b c hab hbc x).symm⟩)

@[simp] theorem inducedHomologyMap_class (z : LinearMap.ker g) :
    inducedHomologyMap f g hfg f' g' hfg' a b c hab hbc (homologyClass f g hfg z) =
      homologyClass f' g' hfg' (inducedCycleMap g g' b c hbc z) := rfl

variable (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
  (H : Filtration (K := K) Z) (F' : Filtration (K := K) X')
  (G' : Filtration (K := K) Y') (H' : Filtration (K := K) Z')
  (ha : Preserves F F' a) (hb : Preserves G G' b) (hc : Preserves H H' c)

include hb in
theorem inducedHomologyMap_preserves :
    Preserves (homologyFiltration G f g hfg) (homologyFiltration G' f' g' hfg')
      (inducedHomologyMap f g hfg f' g' hfg' a b c hab hbc) := by
  intro n x hx
  obtain ⟨z, hz, rfl⟩ := hx
  refine ⟨inducedCycleMap g g' b c hbc z, hb n z.val hz, ?_⟩
  rfl

include hab in
theorem gradeMap_square (hf : Preserves F G f) (hf' : Preserves F' G' f') (n : ℕ) :
    (gradeMap G G' b hb n).comp (gradeMap F G f hf n) =
      (gradeMap F' G' f' hf' n).comp (gradeMap F F' a ha n) := by
  apply LinearMap.ext
  intro x
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel G' n))
  apply Subtype.ext
  exact LinearMap.congr_fun hab x.val

def inducedGradedHomologyMap
    (hf : Preserves F G f) (hg : Preserves G H g)
    (hf' : Preserves F' G' f') (hg' : Preserves G' H' g') (n : ℕ) :
    GradedHomology F G H f g hf hg hfg n →ₗ[K]
      GradedHomology F' G' H' f' g' hf' hg' hfg' n :=
  inducedHomologyMap _ _ (gradeMap_comp F G H f g hf hg hfg n)
    _ _ (gradeMap_comp F' G' H' f' g' hf' hg' hfg' n)
    (gradeMap F F' a ha n) (gradeMap G G' b hb n) (gradeMap H H' c hc n)
    (gradeMap_square f f' a b hab F G F' G' ha hb hf hf' n)
    (gradeMap_square g g' b c hbc G H G' H' hb hc hg hg' n)

def filteredCycleMap (n : ℕ) : cycleLevel G g (n + 1) →ₗ[K] cycleLevel G' g' (n + 1) :=
  ((inducedCycleMap g g' b c hbc).domRestrict _).codRestrict _
    (fun z => hb (n + 1) z.val.val z.property)

@[simp] theorem inducedGradedHomologyMap_class
    (hf : Preserves F G f) (hg : Preserves G H g)
    (hf' : Preserves F' G' f') (hg' : Preserves G' H' g') (n : ℕ)
    (z : cycleLevel G g (n + 1)) :
    inducedGradedHomologyMap f g hfg f' g' hfg' a b c hab hbc
      F G H F' G' H' ha hb hc hf hg hf' hg' n
      (leadingHomologyClass F G H f g hf hg hfg n z) =
        leadingHomologyClass F' G' H' f' g' hf' hg' hfg' n
          (filteredCycleMap g g' b c hbc G G' hb n z) := rfl

@[simp] theorem inducedFilteredHomologyMap_class (n : ℕ)
    (z : cycleLevel G g (n + 1)) :
    gradeMap (homologyFiltration G f g hfg) (homologyFiltration G' f' g' hfg')
      (inducedHomologyMap f g hfg f' g' hfg' a b c hab hbc)
      (inducedHomologyMap_preserves f g hfg f' g' hfg' a b c hab hbc G G' hb) n
        (filteredHomologyClass G f g hfg n z) =
      filteredHomologyClass G' f' g' hfg' n
        (filteredCycleMap g g' b c hbc G G' hb n z) := rfl

/-- The canonical comparison is natural for every filtered chain map,
without any equivariance assumption on the chosen cycle lifts. -/
theorem associatedHomologyEquiv_natural
    (hf : Preserves F G f) (hg : Preserves G H g)
    (hf' : Preserves F' G' f') (hg' : Preserves G' H' g')
    (lf : LiftsCycles F G f) (lg : LiftsCycles G H g)
    (lf' : LiftsCycles F' G' f') (lg' : LiftsCycles G' H' g')
    (n : ℕ) (x : Grade (homologyFiltration G f g hfg) n) :
    associatedHomologyEquiv F' G' H' f' g' hf' hg' hfg' n lf' lg'
      (gradeMap (homologyFiltration G f g hfg) (homologyFiltration G' f' g' hfg')
        (inducedHomologyMap f g hfg f' g' hfg' a b c hab hbc)
        (inducedHomologyMap_preserves f g hfg f' g' hfg' a b c hab hbc G G' hb) n x) =
      inducedGradedHomologyMap f g hfg f' g' hfg' a b c hab hbc
        F G H F' G' H' ha hb hc hf hg hf' hg' n
          (associatedHomologyEquiv F G H f g hf hg hfg n lf lg x) := by
  obtain ⟨z, rfl⟩ := filteredHomologyClass_surjective G f g hfg n x
  rw [inducedFilteredHomologyMap_class, associatedHomologyEquiv_class,
    associatedHomologyEquiv_class, inducedGradedHomologyMap_class]

end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Universal.MiddleHomologyEquiv -/
section

/-! # Homology comparison from literal cycles and boundaries

Only the middle-module equivalence is needed.  This handles the degree-zero
ends of augmented complexes, where an adjacent object can be nonzero even
though its differential is zero.  The kernel and image conditions are proved
separately in each application.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
variable {K : Type*} [CommRing K]
variable {X Y Z X' Y' Z' : Type*}
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y] [AddCommGroup Z] [Module K Z]
  [AddCommGroup X'] [Module K X'] [AddCommGroup Y'] [Module K Y'] [AddCommGroup Z'] [Module K Z']
variable (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
  (f' : X' →ₗ[K] Y') (g' : Y' →ₗ[K] Z') (hfg' : g'.comp f' = 0)
  (e : Y ≃ₗ[K] Y') (hcycles : ∀ y, g' (e y) = 0 ↔ g y = 0)
  (hboundaries : ∀ y, (∃ x', f' x' = e y) ↔ ∃ x, f x = y)

def middleCycleEquiv : LinearMap.ker g ≃ₗ[K] LinearMap.ker g' where
  toFun y := ⟨e y.val, (hcycles y.val).mpr y.property⟩
  invFun y := ⟨e.symm y.val, (hcycles (e.symm y.val)).mp
    (by rw [LinearEquiv.apply_symm_apply]; exact y.property)⟩
  left_inv y := Subtype.ext (e.symm_apply_apply y.val)
  right_inv y := Subtype.ext (e.apply_symm_apply y.val)
  map_add' x y := Subtype.ext (map_add e x.val y.val)
  map_smul' a y := Subtype.ext (map_smul e a y.val)

theorem mem_boundaryRange (y : LinearMap.ker g) :
    y ∈ LinearMap.range (boundaryMap f g hfg) ↔ ∃ x, f x = y.val := by
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨x, congrArg Subtype.val hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨x, Subtype.ext hx⟩

include hboundaries in
theorem middleCycleEquiv_boundaries :
    (LinearMap.range (boundaryMap f g hfg)).map
      (middleCycleEquiv g g' e hcycles).toLinearMap =
      LinearMap.range (boundaryMap f' g' hfg') := by
  rw [Submodule.map_equiv_eq_comap_symm]
  ext y
  change (middleCycleEquiv g g' e hcycles).symm y ∈ LinearMap.range (boundaryMap f g hfg) ↔ _
  rw [mem_boundaryRange, mem_boundaryRange]
  have hh := (hboundaries ((middleCycleEquiv g g' e hcycles).symm y).val).symm
  have he : e ((middleCycleEquiv g g' e hcycles).symm y).val = y.val := e.apply_symm_apply y.val
  simpa only [he] using hh

/-- An actual equivalence of kernels modulo images. -/
def middleHomologyEquiv : Homology f g hfg ≃ₗ[K] Homology f' g' hfg' :=
  Submodule.Quotient.equiv _ _ (middleCycleEquiv g g' e hcycles)
    (middleCycleEquiv_boundaries f g hfg f' g' hfg' e hcycles hboundaries)

@[simp] theorem middleHomologyEquiv_class (y : LinearMap.ker g) :
    middleHomologyEquiv f g hfg f' g' hfg' e hcycles hboundaries
      (homologyClass f g hfg y) =
      homologyClass f' g' hfg' (middleCycleEquiv g g' e hcycles y) := rfl


section Categorical
open CategoryTheory
universe u v
variable {R : Type u} [CommRing R]

/-- The preceding quotient equivalence is an isomorphism of the standard
categorical homology objects, with literal kernels and images as its only
comparison conditions. -/
def shortComplexMiddleHomologyIso (S T : ShortComplex (ModuleCat.{v} R))
    (e : S.X₂ ≃ₗ[R] T.X₂)
    (hcycles : ∀ y, T.g (e y) = 0 ↔ S.g y = 0)
    (hboundaries : ∀ y, (∃ x', T.f x' = e y) ↔ ∃ x, S.f x = y) :
    S.homology ≅ T.homology :=
  S.moduleCatHomologyIso ≪≫
    (middleHomologyEquiv S.f.hom S.g.hom (by exact congrArg (fun q => q.hom) S.zero)
      T.f.hom T.g.hom (by exact congrArg (fun q => q.hom) T.zero)
      e hcycles hboundaries).toModuleIso ≪≫ T.moduleCatHomologyIso.symm
end Categorical

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.FilteredHomologyEquivalence -/
section

/-! # Equivalences of the literal filtration and homology quotients -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.FilteredHomology
open Classical
variable {K X Y Z X' Y' Z' : Type*} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z] [AddCommGroup X'] [Module K X']
  [AddCommGroup Y'] [Module K Y'] [AddCommGroup Z'] [Module K Z']

def levelEquiv (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (e : X ≃ₗ[K] Y) (he : ∀ n x, e x ∈ G.level n ↔ x ∈ F.level n) (n : ℕ) :
    F.level n ≃ₗ[K] G.level n where
  toFun x := ⟨e x.val, (he n x.val).mpr x.property⟩
  invFun y := ⟨e.symm y.val, (he n (e.symm y.val)).mp
    (by simpa only [LinearEquiv.apply_symm_apply] using y.property)⟩
  left_inv x := Subtype.ext (e.symm_apply_apply x.val)
  right_inv y := Subtype.ext (e.apply_symm_apply y.val)
  map_add' x y := Subtype.ext (e.map_add x.val y.val)
  map_smul' a x := Subtype.ext (e.map_smul a x.val)

theorem levelEquiv_lower (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (e : X ≃ₗ[K] Y) (he : ∀ n x, e x ∈ G.level n ↔ x ∈ F.level n) (n : ℕ) :
    (lowerInLevel F n).map (levelEquiv F G e he (n + 1)).toLinearMap = lowerInLevel G n := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact (he n x.val).mpr hx
  · intro hy
    refine ⟨(levelEquiv F G e he (n + 1)).symm y, ?_,
      (levelEquiv F G e he (n + 1)).apply_symm_apply y⟩
    exact (he n (e.symm y.val)).mp
      (by simpa only [LinearEquiv.apply_symm_apply] using (show y.val ∈ G.level n from hy))

def gradeEquiv (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (e : X ≃ₗ[K] Y) (he : ∀ n x, e x ∈ G.level n ↔ x ∈ F.level n) (n : ℕ) :
    Grade F n ≃ₗ[K] Grade G n :=
  Submodule.Quotient.equiv _ _ (levelEquiv F G e he (n + 1)) (levelEquiv_lower F G e he n)

@[simp] theorem gradeEquiv_mk (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (e : X ≃ₗ[K] Y) (he : ∀ n x, e x ∈ G.level n ↔ x ∈ F.level n)
    (n : ℕ) (x : F.level (n + 1)) :
    gradeEquiv F G e he n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (levelEquiv F G e he (n + 1) x) := rfl

theorem gradeEquiv_eq_gradeMap (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (e : X ≃ₗ[K] Y) (he : ∀ n x, e x ∈ G.level n ↔ x ∈ F.level n) (n : ℕ) :
    (gradeEquiv F G e he n).toLinearMap = gradeMap F G e.toLinearMap (fun n x => (he n x).mpr) n := by
  apply LinearMap.ext
  intro x
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  rfl

theorem gradeMap_eq_of_lower_error (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f g : X →ₗ[K] Y) (hf : Preserves F G f) (hg : Preserves F G g) (n : ℕ)
    (herror : ∀ x, x ∈ F.level (n + 1) → f x - g x ∈ G.level n) :
    gradeMap F G f hf n = gradeMap F G g hg n := by
  apply LinearMap.ext
  intro x
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  apply (Submodule.Quotient.eq _).mpr
  exact herror x.val x.property

/-- The quotient equivalence induced by an actual chain equivalence on
three adjacent terms, including either zero end differential. -/
def chainHomologyEquiv
    (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
    (f' : X' →ₗ[K] Y') (g' : Y' →ₗ[K] Z') (hfg' : g'.comp f' = 0)
    (a : X ≃ₗ[K] X') (b : Y ≃ₗ[K] Y') (c : Z ≃ₗ[K] Z')
    (hab : ∀ x, f' (a x) = b (f x)) (hbc : ∀ y, g' (b y) = c (g y)) :
    Homology f g hfg ≃ₗ[K] Homology f' g' hfg' :=
  FourPapers.Universal.middleHomologyEquiv f g hfg f' g' hfg' b
    (by intro y; rw [hbc]; exact c.map_eq_zero_iff)
    (by
      intro y
      constructor
      · rintro ⟨x, hx⟩
        refine ⟨a.symm x, b.injective ?_⟩
        rw [← hab, LinearEquiv.apply_symm_apply, hx]
      · rintro ⟨x, hx⟩
        exact ⟨a x, by rw [hab, hx]⟩)

end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Common.FilteredSubmodule -/
section

/-! # Restrictions of intrinsic filtered homology to homogeneous summands -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.FilteredHomology
open Classical
variable {K X Y Z : Type*} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z]

def submoduleFiltration (F : Filtration (K := K) X) (N : Submodule K X) :
    Filtration (K := K) N where
  level n := (F.level n).comap N.subtype
  zero := by simp only [F.zero, Submodule.comap_bot, LinearMap.ker_eq_bot.mpr N.injective_subtype]
  mono := fun _ _ h => Submodule.comap_mono (F.mono h)
  exhaustive x := F.exhaustive x.val

def restrictedMap (f : X →ₗ[K] Y) (N : Submodule K X) (M : Submodule K Y)
    (hNM : ∀ x, x ∈ N → f x ∈ M) : N →ₗ[K] M :=
  (f.domRestrict N).codRestrict M (fun x => hNM x.val x.property)

theorem restrictedMap_preserves (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (N : Submodule K X) (M : Submodule K Y)
    (hNM : ∀ x, x ∈ N → f x ∈ M) :
    Preserves (submoduleFiltration F N) (submoduleFiltration G M) (restrictedMap f N M hNM) :=
  fun n x hx => hf n x.val hx

/-- Actual cycle lifts restrict to a summand whenever its genuine projection
is filtered and commutes with the differential. -/
theorem restrictedMap_liftsCycles (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (lf : LiftsCycles F G f)
    (N : Submodule K X) (M : Submodule K Y) (hNM : ∀ x, x ∈ N → f x ∈ M)
    (p : Module.End K X) (q : Module.End K Y)
    (hp : ∀ x, p x ∈ N) (hp_id : ∀ x, x ∈ N → p x = x)
    (hpF : Preserves F F p) (hcomm : ∀ x, f (p x) = q (f x)) :
    LiftsCycles (submoduleFiltration F N) (submoduleFiltration G M) (restrictedMap f N M hNM) := by
  intro n x hx hfx
  obtain ⟨z, hz, hfz, hxz⟩ := lf n x.val hx hfx
  refine ⟨⟨p z, hp z⟩, hpF (n + 1) z hz, ?_, ?_⟩
  · apply Subtype.ext
    change f (p z) = 0
    exact (hcomm z).trans (by rw [hfz, map_zero])
  · have h := hpF n (x.val - z) hxz
    change x.val - p z ∈ F.level n
    simpa only [map_sub, hp_id x.val x.property] using h

theorem submoduleFiltration_top (F : Filtration (K := K) X) (N : Submodule K X)
    (n : ℕ) (hN : N ≤ F.level n) : (submoduleFiltration F N).level n = ⊤ := by
  ext x
  exact iff_of_true (hN x.property) Submodule.mem_top

theorem homologyFiltration_top (F : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
    (n : ℕ) (hF : F.level n = ⊤) : (homologyFiltration F f g hfg).level n = ⊤ := by
  apply top_unique
  intro x hx
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap f g hfg)).mkQ_surjective x
  refine ⟨z, ?_, rfl⟩
  change z.val ∈ F.level n
  rw [hF]
  exact Submodule.mem_top

end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Universal.OriginalAutomorphisms -/
section

/-! # The natural automorphisms of the original face-ring presentations

Every action in this file is induced by renaming the actual face variables.
The quotient ideals and the rank-sum parameters are proved invariant.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical Finset MvPolynomial
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K : Type*) [CommRing K] (hs : IsSimplicialPoset P)

def nonzeroFaceOrderEquiv (e : P ≃o P) : NonzeroFace P ≃ NonzeroFace P where
  toFun p := ⟨e p.val, fun h => p.property (e.injective (h.trans e.map_bot.symm))⟩
  invFun p := ⟨e.symm p.val, fun h => p.property (e.symm.injective (h.trans e.symm.map_bot.symm))⟩
  left_inv p := Subtype.ext (e.symm_apply_apply p.val)
  right_inv p := Subtype.ext (e.apply_symm_apply p.val)

@[simp] theorem nonzeroFaceOrderEquiv_apply (e : P ≃o P) (p : NonzeroFace P) :
    (nonzeroFaceOrderEquiv e p).val = e p.val := rfl

theorem faceSymbol_rename (e : P ≃o P) (p : P) :
    MvPolynomial.rename (nonzeroFaceOrderEquiv e) (faceSymbol K p) =
      faceSymbol K (e p) := by
  by_cases hp : p = ⊥
  · subst p
    simp [faceSymbol, e.map_bot]
  · have he : e p ≠ ⊥ := fun h => hp (e.injective (h.trans e.map_bot.symm))
    simp only [faceSymbol, dif_neg hp, dif_neg he, rename_X]
    rfl

theorem minimalCommonUppers_orderIso (e : P ≃o P) (p q : P) :
    minimalCommonUppers (e p) (e q) = (minimalCommonUppers p q).image e := by
  ext w
  simp only [mem_minimalCommonUppers, Finset.mem_image]
  constructor
  · intro hw
    refine ⟨e.symm w, ?_, e.apply_symm_apply w⟩
    refine ⟨by simpa using e.symm.monotone hw.1,
      by simpa using e.symm.monotone hw.2.1, ?_⟩
    intro v hp hq hv
    apply e.injective
    exact (hw.2.2 (e v) (e.monotone hp) (e.monotone hq)
      (by simpa using e.monotone hv)).trans (e.apply_symm_apply w).symm
  · rintro ⟨v, hv, rfl⟩
    refine ⟨e.monotone hv.1, e.monotone hv.2.1, ?_⟩
    intro w hp hq hw
    have hh := hv.2.2 (e.symm w) (by simpa using e.symm.monotone hp)
      (by simpa using e.symm.monotone hq) (by simpa using e.symm.monotone hw)
    simpa using congrArg e hh

theorem faceMeetBelow_orderIso (e : P ≃o P) (p q w : P)
    (hp : p ≤ w) (hq : q ≤ w) :
    e (faceMeetBelow hs p q w hp hq) =
      faceMeetBelow hs (e p) (e q) (e w) (e.monotone hp) (e.monotone hq) := by
  apply le_antisymm
  · exact le_faceMeetBelow hs _ _ _ _ _
      (e.monotone (faceMeetBelow_le_left hs p q w hp hq))
      (e.monotone (faceMeetBelow_le_right hs p q w hp hq))
  · have hl := e.symm.monotone
      (faceMeetBelow_le_left hs (e p) (e q) (e w) (e.monotone hp) (e.monotone hq))
    have hr := e.symm.monotone
      (faceMeetBelow_le_right hs (e p) (e q) (e w) (e.monotone hp) (e.monotone hq))
    have hm := le_faceMeetBelow hs p q w hp hq
      (by simpa only [e.symm_apply_apply] using hl)
      (by simpa only [e.symm_apply_apply] using hr)
    simpa only [e.apply_symm_apply] using e.monotone hm

theorem faceRelations_rename (e : P ≃o P) {f : FacePolynomial (P := P) K}
    (hf : f ∈ faceRelations K hs) :
    MvPolynomial.rename (nonzeroFaceOrderEquiv e) f ∈ faceRelations K hs := by
  rcases hf with ⟨p, q, w, hp, hq, rfl⟩ | ⟨p, q, hnone, rfl⟩
  · left
    refine ⟨e p, e q, e w, e.monotone hp, e.monotone hq, ?_⟩
    rw [map_sub, map_mul, map_mul, map_sum, faceSymbol_rename, faceSymbol_rename,
      faceSymbol_rename, faceMeetBelow_orderIso, minimalCommonUppers_orderIso]
    congr 1
    congr 1
    rw [Finset.sum_image]
    · apply Finset.sum_congr rfl
      intro a ha
      exact faceSymbol_rename K e a
    · exact fun _ _ _ _ h => e.injective h
  · right
    refine ⟨e p, e q, ?_, ?_⟩
    · rintro ⟨w, hp, hq⟩
      exact hnone ⟨e.symm w, by simpa using e.symm.monotone hp,
        by simpa using e.symm.monotone hq⟩
    · rw [map_mul, faceSymbol_rename, faceSymbol_rename]

def faceRingOrderMap (e : P ≃o P) : FaceRing K hs →ₐ[K] FaceRing K hs := by
  let f := (Ideal.Quotient.mkₐ K (faceIdeal K hs)).comp
    (MvPolynomial.rename (nonzeroFaceOrderEquiv e))
  apply Ideal.Quotient.liftₐ (faceIdeal K hs) f
  have hh : faceIdeal K hs ≤ RingHom.ker f.toRingHom := by
    apply Ideal.span_le.mpr
    intro p hp
    change Ideal.Quotient.mk (faceIdeal K hs)
      (MvPolynomial.rename (nonzeroFaceOrderEquiv e) p) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (faceRelations_rename K hs e hp))
  exact fun p hp => hh hp

@[simp] theorem faceRingOrderMap_mk (e : P ≃o P) (f : FacePolynomial (P := P) K) :
    faceRingOrderMap K hs e (Ideal.Quotient.mk (faceIdeal K hs) f) =
      Ideal.Quotient.mk (faceIdeal K hs)
        (MvPolynomial.rename (nonzeroFaceOrderEquiv e) f) := rfl

def barycentricRingOrderMap (e : P ≃o P) :
    BarycentricRing (P := P) K →ₐ[K] BarycentricRing (P := P) K := by
  let f := (Ideal.Quotient.mkₐ K (barycentricIdeal (P := P) K)).comp
    (MvPolynomial.rename (nonzeroFaceOrderEquiv e))
  apply Ideal.Quotient.liftₐ (barycentricIdeal K) f
  have hh : barycentricIdeal (P := P) K ≤ RingHom.ker f.toRingHom := by
    apply Ideal.span_le.mpr
    rintro p ⟨a, b, hab, hba, rfl⟩
    change Ideal.Quotient.mk (barycentricIdeal K)
      (MvPolynomial.rename (nonzeroFaceOrderEquiv e) (X a * X b)) = 0
    rw [map_mul, rename_X, rename_X]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.subset_span ⟨nonzeroFaceOrderEquiv e a, nonzeroFaceOrderEquiv e b,
      fun h => hab (e.le_iff_le.mp h), fun h => hba (e.le_iff_le.mp h), rfl⟩
  exact fun p hp => hh hp

@[simp] theorem barycentricRingOrderMap_mk (e : P ≃o P) (f : FacePolynomial (P := P) K) :
    barycentricRingOrderMap K e (Ideal.Quotient.mk (barycentricIdeal K) f) =
      Ideal.Quotient.mk (barycentricIdeal K)
        (MvPolynomial.rename (nonzeroFaceOrderEquiv e) f) := rfl

theorem faceRingOrderMap_inverse (e : P ≃o P) (x : FaceRing K hs) :
    faceRingOrderMap K hs e.symm (faceRingOrderMap K hs e x) = x := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [faceRingOrderMap_mk, faceRingOrderMap_mk, rename_rename]
  have he : (nonzeroFaceOrderEquiv e.symm) ∘ nonzeroFaceOrderEquiv e = id := by
    funext p
    exact Subtype.ext (e.symm_apply_apply p.val)
  rw [he, rename_id_apply]

theorem barycentricRingOrderMap_inverse (e : P ≃o P) (x : BarycentricRing (P := P) K) :
    barycentricRingOrderMap K e.symm (barycentricRingOrderMap K e x) = x := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [barycentricRingOrderMap_mk, barycentricRingOrderMap_mk, rename_rename]
  have he : (nonzeroFaceOrderEquiv e.symm) ∘ nonzeroFaceOrderEquiv e = id := by
    funext p
    exact Subtype.ext (e.symm_apply_apply p.val)
  rw [he, rename_id_apply]

def faceRingOrderAut (e : P ≃o P) : FaceRing K hs ≃ₐ[K] FaceRing K hs :=
  AlgEquiv.ofAlgHom (faceRingOrderMap K hs e) (faceRingOrderMap K hs e.symm)
    (by ext x; exact faceRingOrderMap_inverse K hs e.symm x)
    (by ext x; exact faceRingOrderMap_inverse K hs e x)

def barycentricRingOrderAut (e : P ≃o P) :
    BarycentricRing (P := P) K ≃ₐ[K] BarycentricRing (P := P) K :=
  AlgEquiv.ofAlgHom (barycentricRingOrderMap K e) (barycentricRingOrderMap K e.symm)
    (by ext x; exact barycentricRingOrderMap_inverse K e.symm x)
    (by ext x; exact barycentricRingOrderMap_inverse K e x)

@[simp] theorem faceRingOrderAut_generator (e : P ≃o P) (p : P) :
    faceRingOrderAut K hs e (faceRingGenerator K hs p) = faceRingGenerator K hs (e p) := by
  change Ideal.Quotient.mk (faceIdeal K hs)
    (MvPolynomial.rename (nonzeroFaceOrderEquiv e) (faceSymbol K p)) = _
  rw [faceSymbol_rename]
  rfl

@[simp] theorem barycentricRingOrderAut_generator (e : P ≃o P) (p : P) :
    barycentricRingOrderAut K e (barycentricGenerator K p) = barycentricGenerator K (e p) := by
  change Ideal.Quotient.mk (barycentricIdeal K)
    (MvPolynomial.rename (nonzeroFaceOrderEquiv e) (faceSymbol K p)) = _
  rw [faceSymbol_rename]
  rfl

theorem rankFaces_orderIso (e : P ≃o P) (r : ℕ) :
    (univ.filter fun p : P => faceRank p = r).image e =
      univ.filter fun p : P => faceRank p = r := by
  ext p
  simp only [mem_image, mem_filter, mem_univ, true_and]
  constructor
  · rintro ⟨q, hq, rfl⟩
    rwa [faceRank_eq_of_orderIso]
  · intro hp
    exact ⟨e.symm p, by simpa only [faceRank_eq_of_orderIso] using hp, e.apply_symm_apply p⟩

@[simp] theorem faceRingOrderAut_parameter (e : P ≃o P) (r : ℕ) :
    faceRingOrderAut K hs e (faceRankParameter K hs r) = faceRankParameter K hs r := by
  simp only [faceRankParameter, map_sum, faceRingOrderAut_generator]
  conv_rhs => rw [← rankFaces_orderIso e r]
  rw [Finset.sum_image]
  exact fun _ _ _ _ h => e.injective h

@[simp] theorem barycentricRingOrderAut_parameter (e : P ≃o P) (r : ℕ) :
    barycentricRingOrderAut K e (barycentricRankParameter K r) = barycentricRankParameter K r := by
  simp only [barycentricRankParameter, map_sum, barycentricRingOrderAut_generator]
  conv_rhs => rw [← rankFaces_orderIso e r]
  rw [Finset.sum_image]
  exact fun _ _ _ _ h => e.injective h

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.OriginalAutomorphismBasis -/
section

/-! # The canonical comparison and natural face permutations

The standard basis indices are the actual exponent vectors on chains.  Their
permutation preserves both the internal degree and the rank weight.  These
identities prove equivariance of the leading comparison without imposing
any equivariance condition on a choice of triangular lift.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical Finset MvPolynomial
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]

lemma barycentricAllowed_orderMap (e : P ≃o P) (a : StandardFaceIndex P) :
    BarycentricAllowed (a.val.mapDomain (nonzeroFaceOrderEquiv e)) := by
  intro p hp q hq
  rw [Finsupp.mapDomain_support_of_injective (nonzeroFaceOrderEquiv e).injective] at hp hq
  obtain ⟨p₀, hp₀, rfl⟩ := Finset.mem_image.mp hp
  obtain ⟨q₀, hq₀, rfl⟩ := Finset.mem_image.mp hq
  rcases a.property p₀ hp₀ q₀ hq₀ with h | h
  · exact Or.inl (e.monotone h)
  · exact Or.inr (e.monotone h)

def standardFaceOrderEquiv (e : P ≃o P) : StandardFaceIndex P ≃ StandardFaceIndex P where
  toFun a := ⟨a.val.mapDomain (nonzeroFaceOrderEquiv e), barycentricAllowed_orderMap e a⟩
  invFun a := ⟨a.val.mapDomain (nonzeroFaceOrderEquiv e.symm), barycentricAllowed_orderMap e.symm a⟩
  left_inv a := by
    apply Subtype.ext
    change Finsupp.mapDomain (nonzeroFaceOrderEquiv e.symm)
      (Finsupp.mapDomain (nonzeroFaceOrderEquiv e) a.val) = a.val
    rw [← Finsupp.mapDomain_comp]
    have hh : nonzeroFaceOrderEquiv e.symm ∘ nonzeroFaceOrderEquiv e = id := by
      funext p
      exact Subtype.ext (e.symm_apply_apply p.val)
    rw [hh, Finsupp.mapDomain_id]
  right_inv a := by
    apply Subtype.ext
    change Finsupp.mapDomain (nonzeroFaceOrderEquiv e)
      (Finsupp.mapDomain (nonzeroFaceOrderEquiv e.symm) a.val) = a.val
    rw [← Finsupp.mapDomain_comp]
    have hh : nonzeroFaceOrderEquiv e ∘ nonzeroFaceOrderEquiv e.symm = id := by
      funext p
      exact Subtype.ext (e.apply_symm_apply p.val)
    rw [hh, Finsupp.mapDomain_id]

@[simp] theorem standardFaceOrderEquiv_val (e : P ≃o P) (a : StandardFaceIndex P) :
    (standardFaceOrderEquiv e a).val = a.val.mapDomain (nonzeroFaceOrderEquiv e) := rfl

@[simp] theorem standardFaceOrderEquiv_weight (e : P ≃o P) (d : ℕ) (a : StandardFaceIndex P) :
    standardRankWeight d (standardFaceOrderEquiv e a) = standardRankWeight d a := by
  unfold standardRankWeight
  rw [standardFaceOrderEquiv_val,
    Finsupp.sum_mapDomain_index (fun _ => by simp)
      (fun _ _ _ => by simp only [Nat.cast_add, add_mul])]
  simp only [nonzeroFaceOrderEquiv_apply, faceRank_eq_of_orderIso]

@[simp] theorem standardFaceOrderEquiv_degree (e : P ≃o P) (a : StandardFaceIndex P) :
    standardOrdinaryDegree (standardFaceOrderEquiv e a) = standardOrdinaryDegree a := by
  unfold standardOrdinaryDegree
  rw [standardFaceOrderEquiv_val,
    Finsupp.sum_mapDomain_index (fun _ => by simp) (fun _ _ _ => by simp only [add_mul])]
  simp only [nonzeroFaceOrderEquiv_apply, faceRank_eq_of_orderIso]

variable (K : Type*) [CommRing K] (hs : IsSimplicialPoset P)

@[simp] theorem faceRingOrderAut_standardBasis (e : P ≃o P) (a : StandardFaceIndex P) :
    faceRingOrderAut K hs e (standardFaceBasis K hs a) =
      standardFaceBasis K hs (standardFaceOrderEquiv e a) := by
  rw [standardFaceBasis_apply, standardFaceBasis_apply]
  change Ideal.Quotient.mk (faceIdeal K hs)
    (MvPolynomial.rename (nonzeroFaceOrderEquiv e) (monomial a.val 1)) = _
  rw [MvPolynomial.rename_monomial]
  rfl

@[simp] theorem barycentricRingOrderAut_standardBasis (e : P ≃o P) (a : StandardFaceIndex P) :
    barycentricRingOrderAut K e (barycentricGlobalStandardBasis K a) =
      barycentricGlobalStandardBasis K (standardFaceOrderEquiv e a) := by
  rw [← barycentricGlobalStandardBasis_monomial, ← barycentricGlobalStandardBasis_monomial]
  change Ideal.Quotient.mk (barycentricIdeal K)
    (MvPolynomial.rename (nonzeroFaceOrderEquiv e) (monomial a.val 1)) = _
  rw [MvPolynomial.rename_monomial]
  rfl

@[simp] theorem canonicalOriginalComparison_standardBasis (a : StandardFaceIndex P) :
    canonicalOriginalComparison K hs (barycentricGlobalStandardBasis K a) =
      standardFaceBasis K hs a := by
  simp only [canonicalOriginalComparison, canonicalBasisEquiv, LinearEquiv.trans_apply,
    Module.Basis.repr_self, Module.Basis.repr_symm_single, one_smul]

/-- Equivariance of the independently specified standard-monomial comparison. -/
theorem canonicalOriginalComparison_equivariant (e : P ≃o P) (x : BarycentricRing (P := P) K) :
    faceRingOrderAut K hs e (canonicalOriginalComparison K hs x) =
      canonicalOriginalComparison K hs (barycentricRingOrderAut K e x) := by
  have h : (faceRingOrderAut K hs e).toLinearMap.comp
      (canonicalOriginalComparison K hs).toLinearMap =
      (canonicalOriginalComparison K hs).toLinearMap.comp
        (barycentricRingOrderAut K e).toLinearMap := by
    apply (barycentricGlobalStandardBasis K).ext
    intro a
    simp only [LinearMap.comp_apply, AlgEquiv.toLinearMap_apply, LinearEquiv.coe_coe,
      canonicalOriginalComparison_standardBasis, faceRingOrderAut_standardBasis,
      barycentricRingOrderAut_standardBasis]
  exact LinearMap.congr_fun h x

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.BasisFilteredHomology -/
section

set_option maxRecDepth 4000
set_option maxHeartbeats 300000
set_option Elab.async false
/-! # Actual cycle lifts for a basis-graded differential

The filtration is the span of basis vectors of weight below its index.  Its
top projections are the actual basis coefficient projections.  A differential
homogeneous in these weights has all required cycle lifts over any ring.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
variable {K I J X Y : Type*} [CommRing K] [AddCommGroup X] [Module K X]
  [AddCommGroup Y] [Module K Y]

def basisFiltration (b : Module.Basis I K X) (w : I → ℕ) : Filtration (K := K) X where
  level n := Submodule.span K (b '' {i | w i < n})
  zero := by simp
  mono := by
    intro m n hmn
    apply Submodule.span_mono
    exact Set.image_mono (fun i hi => hi.trans_le hmn)
  exhaustive x := by
    refine ⟨(b.repr x).support.sup w + 1, ?_⟩
    rw [b.mem_span_image]
    intro i hi
    exact Nat.lt_succ_of_le (Finset.le_sup (f := w) hi)

theorem basisFiltration_mem (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ) (x : X) :
    x ∈ (basisFiltration b w).level n ↔ ∀ i, n ≤ w i → b.repr x i = 0 := by
  rw [basisFiltration, b.mem_span_image]
  constructor
  · intro h i hi
    by_contra hn
    exact (not_lt_of_ge hi) (h (Finsupp.mem_support_iff.mpr hn))
  · intro h i hi
    by_contra hn
    exact Finsupp.mem_support_iff.mp hi (h i (Nat.le_of_not_gt hn))

@[simp] theorem basisProjection_coefficient (b : Module.Basis I K X) (w : I → ℕ)
    (n : ℕ) (x : X) (i : I) :
    b.repr (FourPapers.BasisGrading.projection b w n x) i = if w i = n then b.repr x i else 0 := by
  simp only [FourPapers.BasisGrading.projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, FourPapers.BasisGrading.filterMap_apply, Finsupp.filter_apply]
  split_ifs <;> rfl

theorem basisProjection_level (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ) (x : X) :
    FourPapers.BasisGrading.projection b w n x ∈ (basisFiltration b w).level (n + 1) := by
  rw [basisFiltration_mem]
  intro i hi
  rw [basisProjection_coefficient, if_neg (by omega)]

theorem basisProjection_error_lower (b : Module.Basis I K X) (w : I → ℕ)
    (n : ℕ) (x : X) (hx : x ∈ (basisFiltration b w).level (n + 1)) :
    x - FourPapers.BasisGrading.projection b w n x ∈ (basisFiltration b w).level n := by
  rw [basisFiltration_mem] at hx ⊢
  intro i hi
  rw [map_sub, Finsupp.sub_apply, basisProjection_coefficient]
  by_cases hn : w i = n
  · rw [if_pos hn, sub_self]
  · rw [if_neg hn, sub_zero]
    exact hx i (by omega)

theorem basisProjection_lower_zero (b : Module.Basis I K X) (w : I → ℕ)
    (n : ℕ) (x : X) (hx : x ∈ (basisFiltration b w).level n) :
    FourPapers.BasisGrading.projection b w n x = 0 := by
  apply b.repr.injective
  ext i
  rw [basisProjection_coefficient, map_zero, Finsupp.zero_apply]
  split_ifs with hi
  · exact (basisFiltration_mem b w n x).mp hx i (by omega)
  · rfl

/-- A genuinely homogeneous differential preserves every weight bound. -/
theorem basisHomogeneous_preserves (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (w : I → ℕ) (v : J → ℕ) (f : X →ₗ[K] Y)
    (h : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) :
    Preserves (basisFiltration b w) (basisFiltration c v) f := by
  intro n x hx
  change x ∈ Submodule.span K (b '' {i | w i < n}) at hx
  change f x ∈ Submodule.span K (c '' {j | v j < n})
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨i, hi, rfl⟩
    have hs : {j | v j = w i} ⊆ {j | v j < n} := by
      intro j hj
      change v j < n
      rw [hj]
      exact hi
    exact (Submodule.span_mono (Set.image_mono hs)) (h i)
  · simpa only [map_zero] using (Submodule.span K (c '' {j | v j < n})).zero_mem
  · intro x y _ _ hx hy
    simpa only [map_add] using (Submodule.span K (c '' {j | v j < n})).add_mem hx hy
  · intro a x _ hx
    simpa only [map_smul] using (Submodule.span K (c '' {j | v j < n})).smul_mem a hx

/-- A weight-preserving permutation of basis vectors acts on the literal
filtration.  This is used for the natural poset automorphisms. -/
theorem basisMap_preserves (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (w : I → ℕ) (v : J → ℕ) (σ : I → J) (f : X →ₗ[K] Y)
    (hf : ∀ i, f (b i) = c (σ i)) (hσ : ∀ i, v (σ i) = w i) :
    Preserves (basisFiltration b w) (basisFiltration c v) f := by
  apply basisHomogeneous_preserves
  intro i
  rw [hf i, ← hσ i]
  exact FourPapers.BasisGrading.basis_mem_piece c v (σ i)

/-- Projection to one basis degree preserves every basis-weight bound. -/
theorem basisProjection_preserves_other {A : Type*} (b : Module.Basis I K X)
    (degree : I → A) (a : A) (w : I → ℕ) :
    Preserves (basisFiltration b w) (basisFiltration b w)
      (FourPapers.BasisGrading.projection b degree a) := by
  apply basisHomogeneous_preserves
  intro i
  rw [FourPapers.BasisGrading.projection_basis]
  split_ifs
  · exact FourPapers.BasisGrading.basis_mem_piece b w i
  · exact (FourPapers.BasisGrading.Piece b w (w i)).zero_mem

theorem basisProjection_commutes (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (w : I → ℕ) (v : J → ℕ) (f : X →ₗ[K] Y)
    (h : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) (n : ℕ) :
    f.comp (FourPapers.BasisGrading.projection b w n) = (FourPapers.BasisGrading.projection c v n).comp f := by
  apply b.ext
  intro i
  simp only [LinearMap.comp_apply, FourPapers.BasisGrading.projection_basis]
  by_cases hi : w i = n
  · rw [if_pos hi]
    exact (FourPapers.BasisGrading.projection_eq_self (hi ▸ h i)).symm
  · rw [if_neg hi, map_zero]
    exact (FourPapers.BasisGrading.projection_eq_zero (Ne.symm hi) (h i)).symm

/-- Concrete homogeneous basis data imply cycle lifting in the literal
weight filtration.  No exactness or splitting assumption is retained. -/
theorem basisHomogeneous_liftsCycles (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (w : I → ℕ) (v : J → ℕ) (f : X →ₗ[K] Y)
    (h : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) :
    LiftsCycles (basisFiltration b w) (basisFiltration c v) f :=
  liftsCycles_of_projections (basisFiltration b w) (basisFiltration c v) f
    (FourPapers.BasisGrading.projection b w) (FourPapers.BasisGrading.projection c v)
    (fun n x _ => basisProjection_level b w n x)
    (basisProjection_error_lower b w) (basisProjection_lower_zero c v)
    (basisProjection_commutes b c w v f h)


/-- Top coefficient projection to the genuine homogeneous submodule. -/
def basisTopProjection (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ) :
    (basisFiltration b w).level (n + 1) →ₗ[K] FourPapers.BasisGrading.Piece b w n :=
  ((FourPapers.BasisGrading.projection b w n).domRestrict _).codRestrict _
    (fun x => FourPapers.BasisGrading.projection_mem b w n x.val)

theorem basisTopProjection_ker (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ) :
    LinearMap.ker (basisTopProjection b w n) = lowerInLevel (basisFiltration b w) n := by
  ext x
  constructor
  · intro h
    have hz : FourPapers.BasisGrading.projection b w n x.val = 0 := congrArg Subtype.val h
    change x.val ∈ (basisFiltration b w).level n
    simpa only [hz, sub_zero] using basisProjection_error_lower b w n x.val x.property
  · intro h
    exact Subtype.ext (basisProjection_lower_zero b w n x.val h)

theorem basisTopProjection_surjective (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ) :
    Function.Surjective (basisTopProjection b w n) := by
  intro y
  have hy : y.val ∈ (basisFiltration b w).level (n + 1) := by
    have hp := basisProjection_level b w n y.val
    rwa [FourPapers.BasisGrading.projection_eq_self y.property] at hp
  exact ⟨⟨y.val, hy⟩, Subtype.ext (FourPapers.BasisGrading.projection_eq_self y.property)⟩

/-- The canonical identification of the literal successive quotient with the
actual homogeneous submodule is induced by the top coefficient projection. -/
def basisGradeEquiv (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ) :
    Grade (basisFiltration b w) n ≃ₗ[K] FourPapers.BasisGrading.Piece b w n :=
  (Submodule.quotEquivOfEq _ _ (basisTopProjection_ker b w n).symm).trans
    ((basisTopProjection b w n).quotKerEquivOfSurjective (basisTopProjection_surjective b w n))

@[simp] theorem basisGradeEquiv_mk (b : Module.Basis I K X) (w : I → ℕ) (n : ℕ)
    (x : (basisFiltration b w).level (n + 1)) :
    basisGradeEquiv b w n (Submodule.Quotient.mk x) = basisTopProjection b w n x := rfl

/-- Compatibility with the actual associated graded differential is the
coefficient-projection identity, stated on representatives. -/
theorem basisGradeEquiv_differential (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (w : I → ℕ) (v : J → ℕ) (f : X →ₗ[K] Y)
    (hf : Preserves (basisFiltration b w) (basisFiltration c v) f)
    (h : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) (n : ℕ)
    (x : Grade (basisFiltration b w) n) :
    (basisGradeEquiv c v n
      (gradeMap (basisFiltration b w) (basisFiltration c v) f hf n x)).val =
      f (basisGradeEquiv b w n x).val := by
  obtain ⟨y, rfl⟩ := (lowerInLevel (basisFiltration b w) n).mkQ_surjective x
  change FourPapers.BasisGrading.projection c v n (f y.val) = f (FourPapers.BasisGrading.projection b w n y.val)
  exact (LinearMap.congr_fun (basisProjection_commutes b c w v f h n) y.val).symm

end FourPapers.Universal

#print axioms FourPapers.Universal.basisHomogeneous_liftsCycles

end
end

/- BEGIN FourPapers.Universal.FinsuppFilteredComparison -/
section

/-! # Passing a triangular comparison to exterior-coordinate modules -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
variable {K I S M N : Type*} [CommRing K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

def sumIndexWeight (w : I → ℤ) (v : S → ℤ) (a : Σ _ : S, I) : ℤ := w a.2 + v a.1

theorem mapRange_hasWeightLeading (b : Module.Basis I K M) (c : Module.Basis I K N)
    (w : I → ℤ) (v : S → ℤ) (f : M →ₗ[K] N) (hf : HasWeightLeading b c w f) :
    HasWeightLeading (Finsupp.basis fun _ : S => b) (Finsupp.basis fun _ : S => c)
      (sumIndexWeight w v) (Finsupp.mapRange.linearMap f) := by
  rintro ⟨s, a⟩ ⟨t, a'⟩ hab
  simp only [Finsupp.coe_basis, Finsupp.basis_repr,
    Finsupp.mapRange.linearMap_apply, Finsupp.mapRange_single]
  by_cases hst : s = t
  · subst t
    simp only [Finsupp.single_eq_same, Sigma.mk.injEq, true_and, heq_iff_eq]
    exact hf a a' (by dsimp [sumIndexWeight] at hab; omega)
  · simp [hst]

/-- The natural-number indexing is just a harmless reindexing of the
paper's integer weight filtration, whose basis weights are nonnegative. -/
theorem basisFiltration_int_eq (b : Module.Basis I K M) (w : I → ℤ)
    (hw : ∀ i, 0 ≤ w i) (n : ℕ) :
    (basisFiltration b (fun i => (w i).toNat)).level n = basisWeightLevel b w (n : ℤ) := by
  ext x
  rw [basisFiltration_mem]
  change (∀ i, n ≤ (w i).toNat → b.repr x i = 0) ↔
    (∀ i, (n : ℤ) ≤ w i → b.repr x i = 0)
  constructor
  · intro h i hi
    exact h i (by have hh := Int.toNat_of_nonneg (hw i); omega)
  · intro h i hi
    exact h i (by have hh := Int.toNat_of_nonneg (hw i); omega)

theorem weightLeading_basisFiltration_iff (b : Module.Basis I K M) (c : Module.Basis I K N)
    (w : I → ℤ) (hw : ∀ i, 0 ≤ w i) (f : M →ₗ[K] N)
    (hf : HasWeightLeading b c w f) (n : ℕ) (x : M) :
    f x ∈ (basisFiltration c (fun i => (w i).toNat)).level n ↔
      x ∈ (basisFiltration b (fun i => (w i).toNat)).level n := by
  rw [basisFiltration_int_eq b w hw n, basisFiltration_int_eq c w hw n]
  exact weightLeading_mem_iff b c w f hf n x

theorem weightLeading_basisFiltration_error (b : Module.Basis I K M) (c : Module.Basis I K N)
    (w : I → ℤ) (hw : ∀ i, 0 ≤ w i) (f : M →ₗ[K] N)
    (hf : HasWeightLeading b c w f) (n : ℕ) (x : M)
    (hx : x ∈ (basisFiltration b (fun i => (w i).toNat)).level (n + 1)) :
    f x - canonicalBasisEquiv b c x ∈ (basisFiltration c (fun i => (w i).toNat)).level n := by
  rw [basisFiltration_int_eq b w hw] at hx
  rw [basisFiltration_int_eq c w hw]
  exact weightLeading_error_lower b c w f hf n x (by simpa only [Nat.cast_add, Nat.cast_one] using hx)

theorem basisHomogeneous_int_preserves {J : Type*} (b : Module.Basis I K M)
    (c : Module.Basis J K N) (w : I → ℤ) (v : J → ℤ) (f : M →ₗ[K] N)
    (hf : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) :
    Preserves (basisFiltration b (fun i => (w i).toNat))
      (basisFiltration c (fun j => (v j).toNat)) f := by
  apply basisHomogeneous_preserves
  intro i
  rw [FourPapers.BasisGrading.mem_piece]
  intro j hj
  exact congrArg Int.toNat ((FourPapers.BasisGrading.mem_piece c v (w i) (f (b i))).mp (hf i) j hj)

theorem basisDegreePiece_eq (b : Module.Basis I K M) (degree : I → ℕ) (j : ℕ) :
    FourPapers.BasisGrading.Piece b degree j = basisOrdinaryDegreePiece b degree j := by
  ext x
  rw [FourPapers.BasisGrading.mem_piece]
  change (∀ i, b.repr x i ≠ 0 → degree i = j) ↔
    (∀ i, degree i ≠ j → b.repr x i = 0)
  constructor
  · intro h i hi
    by_contra hn
    exact hi (h i hn)
  · intro h i hi
    by_contra hn
    exact hi (h i hn)

theorem basisHomogeneous_int_liftsCycles {J : Type*} (b : Module.Basis I K M)
    (c : Module.Basis J K N) (w : I → ℤ) (v : J → ℤ) (f : M →ₗ[K] N)
    (hf : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) :
    LiftsCycles (basisFiltration b (fun i => (w i).toNat))
      (basisFiltration c (fun j => (v j).toNat)) f := by
  apply basisHomogeneous_liftsCycles
  intro i
  rw [FourPapers.BasisGrading.mem_piece]
  intro j hj
  exact congrArg Int.toNat ((FourPapers.BasisGrading.mem_piece c v (w i) (f (b i))).mp (hf i) j hj)

/-- A fixed internal degree has an explicit finite bound on the filtration. -/
theorem basisDegreePiece_bounded (b : Module.Basis I K M) (w degree : I → ℕ)
    (bound : ℕ → ℕ) (hbound : ∀ i, w i ≤ bound (degree i)) (j : ℕ) (x : M)
    (hx : x ∈ FourPapers.BasisGrading.Piece b degree j) :
    x ∈ (basisFiltration b w).level (bound j + 1) := by
  rw [basisFiltration_mem]
  intro i hi
  by_contra hne
  have hd := (FourPapers.BasisGrading.mem_piece b degree j x).mp hx i hne
  have hb := hbound i
  rw [hd] at hb
  omega

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.KoszulBasisWeights -/
section

/-! # The exact internal degrees and rank weights of Koszul basis vectors -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 400000
namespace FourPapers.Universal
open Classical Finset
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]

theorem rankWeight_nonnegative (d r : ℕ) (hr : r ≤ d) : 0 ≤ rankWeight d r := by
  unfold rankWeight
  have h : (r : ℤ) ≤ d := by exact_mod_cast hr
  exact mul_nonneg (by positivity) (by omega)

theorem rankWeight_linear_bound (d r : ℕ) : rankWeight d r ≤ 2 * (d : ℤ) * r := by
  unfold rankWeight
  nlinarith [sq_nonneg (r : ℤ)]

theorem standardRankWeight_nonnegative (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
    (a : StandardFaceIndex P) : 0 ≤ standardRankWeight d a := by
  unfold standardRankWeight Finsupp.sum
  apply Finset.sum_nonneg
  intro p hp
  exact mul_nonneg (by positivity) (rankWeight_nonnegative d _ (hrank p.val))

theorem standardRankWeight_linear_bound (d : ℕ) (a : StandardFaceIndex P) :
    standardRankWeight d a ≤ 2 * (d : ℤ) * (standardOrdinaryDegree a : ℤ) := by
  unfold standardRankWeight standardOrdinaryDegree Finsupp.sum
  rw [Nat.cast_sum, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro p hp
  have hh := mul_le_mul_of_nonneg_left (rankWeight_linear_bound d (faceRank p.val))
    (show 0 ≤ (a.val p : ℤ) by positivity)
  simpa only [Nat.cast_mul, mul_assoc, mul_left_comm, mul_comm] using hh

def koszulExteriorDegree {d i : ℕ} (s : Set.powersetCard (Fin d) i) : ℕ :=
  ∑ j ∈ s.val, (j.val + 1)

def koszulExteriorWeight (d : ℕ) {i : ℕ} (s : Set.powersetCard (Fin d) i) : ℤ :=
  ∑ j ∈ s.val, rankWeight d (j.val + 1)

abbrev OriginalKoszulIndex (P : Type*) [PartialOrder P] [OrderBot P] (d i : ℕ) :=
  Σ _ : Set.powersetCard (Fin d) i, StandardFaceIndex P

def originalKoszulDegree {d i : ℕ} (a : OriginalKoszulIndex P d i) : ℕ :=
  standardOrdinaryDegree a.2 + koszulExteriorDegree a.1

def originalKoszulWeight (d : ℕ) {i : ℕ} (a : OriginalKoszulIndex P d i) : ℤ :=
  standardRankWeight d a.2 + koszulExteriorWeight d a.1

theorem koszulExteriorWeight_nonnegative (d : ℕ) {i : ℕ}
    (s : Set.powersetCard (Fin d) i) : 0 ≤ koszulExteriorWeight d s := by
  apply Finset.sum_nonneg
  intro j hj
  exact rankWeight_nonnegative d (j.val + 1) (by omega)

theorem koszulExteriorWeight_linear_bound (d : ℕ) {i : ℕ}
    (s : Set.powersetCard (Fin d) i) :
    koszulExteriorWeight d s ≤ 2 * (d : ℤ) * (koszulExteriorDegree s : ℤ) := by
  unfold koszulExteriorWeight koszulExteriorDegree
  rw [Nat.cast_sum, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro j hj
  exact rankWeight_linear_bound d (j.val + 1)

theorem originalKoszulWeight_nonnegative (d : ℕ)
    (hrank : ∀ p : P, faceRank p ≤ d) {i : ℕ} (a : OriginalKoszulIndex P d i) :
    0 ≤ originalKoszulWeight d a :=
  add_nonneg (standardRankWeight_nonnegative d hrank a.2) (koszulExteriorWeight_nonnegative d a.1)

theorem originalKoszulWeight_linear_bound (d : ℕ) {i : ℕ}
    (a : OriginalKoszulIndex P d i) :
    originalKoszulWeight d a ≤ 2 * (d : ℤ) * (originalKoszulDegree a : ℤ) := by
  have h₁ := standardRankWeight_linear_bound d a.2
  have h₂ := koszulExteriorWeight_linear_bound d a.1
  dsimp [originalKoszulWeight, originalKoszulDegree]
  push_cast
  nlinarith

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ParameterKoszul -/
section

/-! # The genuine Koszul complexes of the two parameter actions

The differential is the exterior-coordinate form of the ordinary tensor
Koszul complex.  A parameter-module comparison acts on coefficients only.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg
universe u v
section ParameterGenerality
variable {K B B' : Type u} {C : Type} [CommRing K] [CommRing B] [CommRing B']
  [Algebra K B] [Algebra K B'] [Fintype C] [LinearOrder C]

def parameterKoszulDifferential (γ : C → B) (i : ℕ) :
    (Set.powersetCard C (i + 1) →₀ B) →ₗ[K] (Set.powersetCard C i →₀ B) :=
  (Koszul.coordinateDifferential γ (ModuleCat.of B B) i).restrictScalars K

theorem parameterKoszulDifferential_comp (γ : C → B) (i : ℕ) :
    (parameterKoszulDifferential (K := K) γ i).comp
      (parameterKoszulDifferential (K := K) γ (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  exact LinearMap.congr_fun (Koszul.coordinateDifferential_comp γ (ModuleCat.of B B) i) x

@[simp] theorem parameterKoszulDifferential_single (γ : C → B) (i : ℕ)
    (s : Set.powersetCard C (i + 1)) (b : B) :
    parameterKoszulDifferential (K := K) γ i (Finsupp.single s b) =
      ∑ j : {j // j ∈ s.val}, Finsupp.single (Koszul.eraseIndex s j)
        (γ j.val * (TauCeti.ExteriorAlgebra.basisEraseSign j.val s.val • b)) :=
  Koszul.coordinateDifferential_single γ (ModuleCat.of B B) i s b

def parameterKoszulComplex (γ : C → B) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (Set.powersetCard C i →₀ B))
    (fun i => ModuleCat.ofHom (parameterKoszulDifferential (K := K) γ i))
    (fun i => ModuleCat.hom_ext (parameterKoszulDifferential_comp (K := K) γ i))

@[simp] theorem parameterKoszulComplex_d (γ : C → B) (i : ℕ) :
    (parameterKoszulComplex (K := K) γ).d (i + 1) i =
      ModuleCat.ofHom (parameterKoszulDifferential (K := K) γ i) := by
  simp [parameterKoszulComplex]

theorem parameterKoszul_map_commutes (γ : C → B) (δ : C → B')
    (f : B →ₗ[K] B') (hf : ∀ j b, f (γ j * b) = δ j * f b) (i : ℕ) :
    (Finsupp.mapRange.linearMap f).comp (parameterKoszulDifferential (K := K) γ i) =
      (parameterKoszulDifferential (K := K) δ i).comp (Finsupp.mapRange.linearMap f) := by
  apply Finsupp.lhom_ext
  intro s b
  simp only [LinearMap.comp_apply, Finsupp.lsingle_apply,
    parameterKoszulDifferential_single, map_sum,
    Finsupp.mapRange.linearMap_apply, Finsupp.mapRange_single]
  apply Finset.sum_congr rfl
  intro j hj
  rw [hf, map_zsmul_unit]

def parameterKoszulMap (γ : C → B) (δ : C → B')
    (f : B →ₗ[K] B') (hf : ∀ j b, f (γ j * b) = δ j * f b) :
    parameterKoszulComplex (K := K) γ ⟶ parameterKoszulComplex (K := K) δ where
  f i := ModuleCat.ofHom (Finsupp.mapRange.linearMap f)
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [parameterKoszulComplex_d, parameterKoszulComplex_d]
    exact ModuleCat.hom_ext (parameterKoszul_map_commutes γ δ f hf j).symm

def parameterKoszulEquiv (γ : C → B) (δ : C → B')
    (e : B ≃ₗ[K] B') (he : ∀ j b, e (γ j * b) = δ j * e b) :
    parameterKoszulComplex (K := K) γ ≅ parameterKoszulComplex (K := K) δ :=
  HomologicalComplex.Hom.isoOfComponents
    (fun _ => (Finsupp.mapRange.linearEquiv e).toModuleIso) (by
      intro i j hij
      obtain rfl : i = j + 1 := hij.symm
      rw [parameterKoszulComplex_d, parameterKoszulComplex_d]
      exact ModuleCat.hom_ext (parameterKoszul_map_commutes γ δ e.toLinearMap he j).symm)

end ParameterGenerality

section Original
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

abbrev originalKoszulComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  parameterKoszulComplex (K := K) (fun i : Fin d => faceRankParameter K hs (i.val + 1))

abbrev barycentricKoszulComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  parameterKoszulComplex (K := K)
    (fun i : Fin d => barycentricRankParameter (P := P) K (i.val + 1))

def originalKoszulComparison : barycentricKoszulComplex (P := P) K d ≅ originalKoszulComplex K hs d :=
  parameterKoszulEquiv _ _ (universalOriginalParameterComparison K hs d hrank).toLinearEquiv (by
    intro i x
    simpa only [barycentricParameterAction, faceParameterAction, MvPolynomial.aeval_X] using
      (universalOriginalParameterComparison K hs d hrank).map_X_mul i x)

@[simp] theorem originalKoszulComparison_apply (i : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (s : Set.powersetCard (Fin d) i) :
    (show Set.powersetCard (Fin d) i →₀ FaceRing K hs from
      (originalKoszulComparison K hs d hrank).hom.f i x) s =
      (universalOriginalParameterComparison K hs d hrank).toLinearEquiv (x s) := rfl

end Original
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.OriginalKoszulFiltration -/
section

/-! # The intrinsic rank-weight filtration on the original Koszul terms

The filtration uses the actual chain-monomial/exterior basis, and the
comparison is the coefficientwise extension of Theorem 1.1.  Its leading
map is the independently defined canonical basis correspondence.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

def originalKoszulBasis (i : ℕ) :
    Module.Basis (OriginalKoszulIndex P d i) K (Set.powersetCard (Fin d) i →₀ FaceRing K hs) :=
  Finsupp.basis (fun _ => standardFaceBasis K hs)

def barycentricKoszulBasis (i : ℕ) : Module.Basis (OriginalKoszulIndex P d i) K
    (Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :=
  Finsupp.basis (fun _ => barycentricGlobalStandardBasis K)

def originalKoszulFiltration (i : ℕ) :
    Filtration (K := K) (Set.powersetCard (Fin d) i →₀ FaceRing K hs) :=
  basisFiltration (originalKoszulBasis K hs d i) (fun a => (originalKoszulWeight d a).toNat)

def barycentricKoszulFiltration (i : ℕ) :
    Filtration (K := K) (Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :=
  basisFiltration (barycentricKoszulBasis (P := P) K d i) (fun a => (originalKoszulWeight d a).toNat)

def originalKoszulDegreePiece (i j : ℕ) :=
  FourPapers.BasisGrading.Piece (originalKoszulBasis K hs d i) originalKoszulDegree j

def barycentricKoszulDegreePiece (i j : ℕ) :=
  FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i) originalKoszulDegree j

def originalKoszulCoefficientEquiv (hrank : ∀ p : P, faceRank p ≤ d) (i : ℕ) :
    (Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) ≃ₗ[K]
      (Set.powersetCard (Fin d) i →₀ FaceRing K hs) :=
  Finsupp.mapRange.linearEquiv (universalOriginalParameterComparison K hs d hrank).toLinearEquiv

def canonicalKoszulCoefficientEquiv (i : ℕ) :
    (Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) ≃ₗ[K]
      (Set.powersetCard (Fin d) i →₀ FaceRing K hs) :=
  Finsupp.mapRange.linearEquiv (canonicalOriginalComparison K hs)

theorem originalKoszulCoefficientEquiv_leading
    (hrank : ∀ p : P, faceRank p ≤ d) (i : ℕ) :
    HasWeightLeading (barycentricKoszulBasis (P := P) K d i) (originalKoszulBasis K hs d i)
      (originalKoszulWeight d) (originalKoszulCoefficientEquiv K hs d hrank i).toLinearMap :=
  mapRange_hasWeightLeading (barycentricGlobalStandardBasis K) (standardFaceBasis K hs)
    (standardRankWeight d) (koszulExteriorWeight d)
    (universalOriginalParameterComparison K hs d hrank).toLinearEquiv.toLinearMap
    (universalOriginalParameterComparison_hasWeightLeading K hs d hrank)

theorem originalKoszulCoefficientEquiv_degreeCoefficient
    (hrank : ∀ p : P, faceRank p ≤ d) (i : ℕ)
    (a b : OriginalKoszulIndex P d i) (hab : originalKoszulDegree b ≠ originalKoszulDegree a) :
    (originalKoszulBasis K hs d i).repr
      (originalKoszulCoefficientEquiv K hs d hrank i (barycentricKoszulBasis (P := P) K d i a)) b = 0 := by
  rcases a with ⟨s, a⟩
  rcases b with ⟨t, b⟩
  simp only [originalKoszulCoefficientEquiv, originalKoszulBasis, barycentricKoszulBasis,
    Finsupp.coe_basis, Finsupp.basis_repr,
    Finsupp.mapRange.linearEquiv_apply, Finsupp.mapRange_single]
  by_cases hst : s = t
  · subst t
    rw [Finsupp.single_eq_same]
    apply universalOriginalParameterComparison_degree K hs d hrank a b
    intro he
    exact hab (by simp only [originalKoszulDegree, he])
  · simp [hst]

theorem originalKoszulCoefficientEquiv_degree
    (hrank : ∀ p : P, faceRank p ≤ d) (i j : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    originalKoszulCoefficientEquiv K hs d hrank i x ∈ originalKoszulDegreePiece K hs d i j ↔
      x ∈ barycentricKoszulDegreePiece (P := P) K d i j := by
  unfold originalKoszulDegreePiece barycentricKoszulDegreePiece
  rw [basisDegreePiece_eq, basisDegreePiece_eq]
  exact basisOrdinaryDegreePiece_equiv_iff _ _ _
    (originalKoszulCoefficientEquiv K hs d hrank i)
    (originalKoszulCoefficientEquiv_degreeCoefficient K hs d hrank i) j x

theorem originalKoszulCoefficientEquiv_filtered
    (hrank : ∀ p : P, faceRank p ≤ d) (i n : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    originalKoszulCoefficientEquiv K hs d hrank i x ∈ (originalKoszulFiltration K hs d i).level n ↔
      x ∈ (barycentricKoszulFiltration (P := P) K d i).level n :=
  weightLeading_basisFiltration_iff _ _ _ (originalKoszulWeight_nonnegative d hrank)
    _ (originalKoszulCoefficientEquiv_leading K hs d hrank i) n x

theorem canonicalKoszulCoefficientEquiv_eq (i : ℕ) :
    canonicalKoszulCoefficientEquiv K hs d i =
      canonicalBasisEquiv (barycentricKoszulBasis (P := P) K d i) (originalKoszulBasis K hs d i) := by
  apply LinearEquiv.toLinearMap_injective
  apply (barycentricKoszulBasis (P := P) K d i).ext
  rintro ⟨s, a⟩
  simp only [LinearEquiv.coe_coe, canonicalBasisEquiv, LinearEquiv.trans_apply,
    Module.Basis.repr_self, Module.Basis.repr_symm_single, one_smul]
  simp only [canonicalKoszulCoefficientEquiv, barycentricKoszulBasis, originalKoszulBasis,
    Finsupp.coe_basis, Finsupp.mapRange.linearEquiv_apply, Finsupp.mapRange_single,
    canonicalOriginalComparison_standardBasis]

theorem originalKoszulCoefficientEquiv_error_lower
    (hrank : ∀ p : P, faceRank p ≤ d) (i n : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (hx : x ∈ (barycentricKoszulFiltration (P := P) K d i).level (n + 1)) :
    originalKoszulCoefficientEquiv K hs d hrank i x - canonicalKoszulCoefficientEquiv K hs d i x ∈
      (originalKoszulFiltration K hs d i).level n := by
  rw [canonicalKoszulCoefficientEquiv_eq]
  exact weightLeading_basisFiltration_error _ _ _ (originalKoszulWeight_nonnegative d hrank)
    _ (originalKoszulCoefficientEquiv_leading K hs d hrank i) n x hx

theorem originalKoszulDegreePiece_finite (i j : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ FaceRing K hs)
    (hx : x ∈ originalKoszulDegreePiece K hs d i j) :
    x ∈ (originalKoszulFiltration K hs d i).level (2 * d * j + 1) := by
  apply basisDegreePiece_bounded _ _ _ (fun j => 2 * d * j) ?_ j x hx
  intro a
  have h := originalKoszulWeight_linear_bound d a
  have hc : ((2 * d * originalKoszulDegree a : ℕ) : ℤ) =
      2 * (d : ℤ) * (originalKoszulDegree a : ℤ) := by push_cast; rfl
  rw [← hc] at h
  exact Int.toNat_le.mpr (by simpa using h)

theorem barycentricKoszulDegreePiece_finite (i j : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (hx : x ∈ barycentricKoszulDegreePiece (P := P) K d i j) :
    x ∈ (barycentricKoszulFiltration (P := P) K d i).level (2 * d * j + 1) := by
  apply basisDegreePiece_bounded _ _ _ (fun j => 2 * d * j) ?_ j x hx
  intro a
  have h := originalKoszulWeight_linear_bound d a
  have hc : ((2 * d * originalKoszulDegree a : ℕ) : ℤ) =
      2 * (d : ℤ) * (originalKoszulDegree a : ℤ) := by push_cast; rfl
  rw [← hc] at h
  exact Int.toNat_le.mpr (by simpa using h)

/-- The natural poset automorphism, acting on coefficients and fixing the
parameter exterior generators, is a genuine chain automorphism. -/
def originalKoszulOrderAut (e : P ≃o P) : originalKoszulComplex K hs d ≅ originalKoszulComplex K hs d :=
  parameterKoszulEquiv _ _ (faceRingOrderAut K hs e).toLinearEquiv (by
    intro i x
    simp only [AlgEquiv.toLinearEquiv_apply, map_mul, faceRingOrderAut_parameter])

def barycentricKoszulOrderAut (e : P ≃o P) :
    barycentricKoszulComplex (P := P) K d ≅ barycentricKoszulComplex (P := P) K d :=
  parameterKoszulEquiv _ _ (barycentricRingOrderAut K e).toLinearEquiv (by
    intro i x
    simp only [AlgEquiv.toLinearEquiv_apply, map_mul, barycentricRingOrderAut_parameter])

theorem originalKoszulOrderAut_filtered (e : P ≃o P) (i : ℕ) :
    Preserves (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d i)
      (Finsupp.mapRange.linearMap (faceRingOrderAut K hs e).toLinearMap) := by
  apply basisMap_preserves _ _ _ _
    (fun a : OriginalKoszulIndex P d i => ⟨a.1, standardFaceOrderEquiv e a.2⟩)
  · rintro ⟨s, a⟩
    simp only [originalKoszulBasis, Finsupp.coe_basis, Finsupp.mapRange.linearMap_apply,
      Finsupp.mapRange_single, AlgEquiv.toLinearMap_apply, faceRingOrderAut_standardBasis]
  · intro a
    simp only [originalKoszulWeight, standardFaceOrderEquiv_weight]

theorem barycentricKoszulOrderAut_filtered (e : P ≃o P) (i : ℕ) :
    Preserves (barycentricKoszulFiltration (P := P) K d i)
      (barycentricKoszulFiltration (P := P) K d i)
      (Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap) := by
  apply basisMap_preserves _ _ _ _
    (fun a : OriginalKoszulIndex P d i => ⟨a.1, standardFaceOrderEquiv e a.2⟩)
  · rintro ⟨s, a⟩
    simp only [barycentricKoszulBasis, Finsupp.coe_basis, Finsupp.mapRange.linearMap_apply,
      Finsupp.mapRange_single, AlgEquiv.toLinearMap_apply, barycentricRingOrderAut_standardBasis]
  · intro a
    simp only [originalKoszulWeight, standardFaceOrderEquiv_weight]

theorem canonicalKoszulCoefficientEquiv_equivariant (e : P ≃o P) (i : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    Finsupp.mapRange.linearMap (faceRingOrderAut K hs e).toLinearMap
      (canonicalKoszulCoefficientEquiv K hs d i x) =
      canonicalKoszulCoefficientEquiv K hs d i
        (Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap x) := by
  apply Finsupp.ext
  intro s
  exact canonicalOriginalComparison_equivariant K hs e (x s)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.BarycentricKoszulHomogeneous -/
section

/-! # Homogeneity of the actual barycentric Koszul differential

This proof works directly in the original quotient presentation.  A
coefficient can only occur at the exponent obtained by adding the deleted
parameter's vertex.  Thus the total rank weight and internal degree are
preserved, before invoking any homology or cohomology comparison.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical Finset MvPolynomial CommAlg FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K)

def weightedChainDegree (w : NonzeroFace P → ℤ) (a : StandardFaceIndex P) : ℤ :=
  a.val.sum (fun p n => (n : ℤ) * w p)

lemma weightedChainDegree_add_vertex (w : NonzeroFace P → ℤ) (p : NonzeroFace P)
    (a b : StandardFaceIndex P) (h : Finsupp.single p 1 + a.val = b.val) :
    weightedChainDegree w b = w p + weightedChainDegree w a := by
  unfold weightedChainDegree
  rw [← h, Finsupp.sum_add_index' (fun _ => by simp)
    (fun _ _ _ => by simp only [Nat.cast_add, add_mul])]
  simp

lemma barycentricBasis_generator_mul_coefficient (p : NonzeroFace P)
    (a b : StandardFaceIndex P) :
    (barycentricGlobalStandardBasis K).repr
      (barycentricGenerator K p.val * barycentricGlobalStandardBasis K a) b =
      if Finsupp.single p 1 + a.val = b.val then 1 else 0 := by
  rw [← barycentricGlobalStandardBasis_monomial]
  simp only [barycentricGenerator, faceSymbol, dif_neg p.property]
  rw [← map_mul]
  change standardCoefficients BarycentricAllowed (X p * monomial a.val (1 : K)) b = _
  rw [MvPolynomial.X, monomial_mul, one_mul, standardCoefficients_apply, coeff_monomial]

/-- Multiplying a standard monomial by a rank sum is homogeneous for any
vertex weighting which is constant on that rank. -/
theorem barycentricParameter_mul_homogeneous (w : NonzeroFace P → ℤ)
    (r : ℕ) (hr : 0 < r) (c : ℤ)
    (hw : ∀ p : NonzeroFace P, faceRank p.val = r → w p = c)
    (a : StandardFaceIndex P) :
    barycentricRankParameter K r * barycentricGlobalStandardBasis K a ∈
      FourPapers.BasisGrading.Piece (barycentricGlobalStandardBasis K) (weightedChainDegree w)
        (c + weightedChainDegree w a) := by
  rw [FourPapers.BasisGrading.mem_piece]
  intro b hb
  by_contra hdeg
  apply hb
  unfold barycentricRankParameter
  rw [Finset.sum_mul, map_sum, Finsupp.finset_sum_apply]
  apply Finset.sum_eq_zero
  intro p hp
  have hpRank : faceRank p = r := (Finset.mem_filter.mp hp).2
  have hp0 : p ≠ ⊥ := by
    intro he
    rw [he, faceRank_bot] at hpRank
    omega
  let p' : NonzeroFace P := ⟨p, hp0⟩
  change (barycentricGlobalStandardBasis K).repr
    (barycentricGenerator K p'.val * barycentricGlobalStandardBasis K a) b = 0
  rw [barycentricBasis_generator_mul_coefficient]
  apply if_neg
  intro h
  apply hdeg
  rw [weightedChainDegree_add_vertex w p' a b h, hw p' hpRank]

lemma finsuppSingle_weight_piece {I S : Type*} {M : Type u} [AddCommGroup M] [Module K M]
    (b : Module.Basis I K M) (w : I → ℤ) (v : S → ℤ) (s : S) (r : ℤ)
    (x : M) (hx : x ∈ FourPapers.BasisGrading.Piece b w r) :
    Finsupp.single s x ∈ FourPapers.BasisGrading.Piece
      (Finsupp.basis fun _ : S => b) (sumIndexWeight w v) (r + v s) := by
  rw [FourPapers.BasisGrading.mem_piece]
  rintro ⟨t, a⟩ ha
  simp only [Finsupp.basis_repr] at ha
  by_cases hst : s = t
  · subst t
    rw [Finsupp.single_eq_same] at ha
    have hw := (FourPapers.BasisGrading.mem_piece b w r x).mp hx a ha
    simp only [sumIndexWeight, hw]
  · simp [hst] at ha

lemma koszulExteriorWeight_erase (d : ℕ) {i : ℕ}
    (s : Set.powersetCard (Fin d) (i + 1)) (j : {j // j ∈ s.val}) :
    koszulExteriorWeight d (Koszul.eraseIndex s j) + rankWeight d (j.val.val + 1) =
      koszulExteriorWeight d s := by
  exact Finset.sum_erase_add s.val (fun j : Fin d => rankWeight d (j.val + 1)) j.property

def rankWeightedKoszulDegree (w : ℕ → ℤ) {d i : ℕ}
    (a : OriginalKoszulIndex P d i) : ℤ :=
  weightedChainDegree (fun p : NonzeroFace P => w (faceRank p.val)) a.2 +
    ∑ j ∈ a.1.val, w (j.val + 1)

/-- The differential preserves every additive weighting of the rank colors.
This includes both the internal degree and the quadratic filtration weight. -/
theorem barycentricKoszulDifferential_rankWeighting (d : ℕ) (w : ℕ → ℤ)
    (i : ℕ) (a : OriginalKoszulIndex P d (i + 1)) :
    parameterKoszulDifferential (K := K)
      (fun j : Fin d => barycentricRankParameter K (j.val + 1)) i
        (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈
      FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
        (rankWeightedKoszulDegree w) (rankWeightedKoszulDegree w a) := by
  rcases a with ⟨s, a⟩
  simp only [barycentricKoszulBasis, Finsupp.coe_basis, parameterKoszulDifferential_single]
  apply Submodule.sum_mem
  intro j hj
  rw [mul_smul_comm, ← Finsupp.smul_single]
  apply (Submodule.smul_mem_iff' _ (TauCeti.ExteriorAlgebra.basisEraseSign j.val s.val)).2
  have h := barycentricParameter_mul_homogeneous K
    (fun p : NonzeroFace P => w (faceRank p.val)) (j.val.val + 1) (by omega)
    (w (j.val.val + 1)) (by intro p hp; rw [hp]) a
  have hsingle := finsuppSingle_weight_piece K (barycentricGlobalStandardBasis K)
    (weightedChainDegree (fun p : NonzeroFace P => w (faceRank p.val)))
    (fun t : Set.powersetCard (Fin d) i => ∑ j ∈ t.val, w (j.val + 1)) (Koszul.eraseIndex s j)
    (w (j.val.val + 1) + weightedChainDegree (fun p : NonzeroFace P => w (faceRank p.val)) a)
    (barycentricRankParameter K (j.val.val + 1) * barycentricGlobalStandardBasis K a) h
  have he := Finset.sum_erase_add s.val (fun j : Fin d => w (j.val + 1)) j.property
  have hdegree : (w (j.val.val + 1) + weightedChainDegree
      (fun p : NonzeroFace P => w (faceRank p.val)) a) +
      (∑ k ∈ (Koszul.eraseIndex s j).val, w (k.val + 1)) =
        rankWeightedKoszulDegree w (⟨s, a⟩ : OriginalKoszulIndex P d (i + 1)) := by
    change (w (j.val.val + 1) + weightedChainDegree
      (fun p : NonzeroFace P => w (faceRank p.val)) a) +
      (∑ k ∈ s.val.erase j.val, w (k.val + 1)) = _
    dsimp [rankWeightedKoszulDegree]
    omega
  have hweight : sumIndexWeight
      (weightedChainDegree (fun p : NonzeroFace P => w (faceRank p.val)))
      (fun t : Set.powersetCard (Fin d) i => ∑ j ∈ t.val, w (j.val + 1)) =
      (rankWeightedKoszulDegree w : OriginalKoszulIndex P d i → ℤ) := by
    funext z
    rfl
  rw [hweight, hdegree] at hsingle
  exact hsingle

/-- Exact total rank-weight homogeneity of the ordinary differential. -/
theorem barycentricKoszulDifferential_weight (d i : ℕ) (a : OriginalKoszulIndex P d (i + 1)) :
    parameterKoszulDifferential (K := K)
      (fun j : Fin d => barycentricRankParameter K (j.val + 1)) i
        (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈
      FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
        (originalKoszulWeight d) (originalKoszulWeight d a) :=
  barycentricKoszulDifferential_rankWeighting K d (rankWeight d) i a

lemma rankWeightedKoszulDegree_cast {d i : ℕ} (a : OriginalKoszulIndex P d i) :
    rankWeightedKoszulDegree (fun r => (r : ℤ)) a = (originalKoszulDegree a : ℤ) := by
  simp only [rankWeightedKoszulDegree, weightedChainDegree, originalKoszulDegree,
    standardOrdinaryDegree, koszulExteriorDegree, Finsupp.sum, Nat.cast_add,
    Nat.cast_sum, Nat.cast_mul, Nat.cast_one]

/-- Exact internal homogeneity, with the degree of the rank-r exterior
generator equal to r, as in the paper. -/
theorem barycentricKoszulDifferential_degree (d i : ℕ) (a : OriginalKoszulIndex P d (i + 1)) :
    parameterKoszulDifferential (K := K)
      (fun j : Fin d => barycentricRankParameter K (j.val + 1)) i
        (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈
      FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
        originalKoszulDegree (originalKoszulDegree a) := by
  have h := barycentricKoszulDifferential_rankWeighting K d (fun r => (r : ℤ)) i a
  rw [FourPapers.BasisGrading.mem_piece] at h ⊢
  intro b hb
  have he := h b hb
  rw [rankWeightedKoszulDegree_cast, rankWeightedKoszulDegree_cast] at he
  exact_mod_cast he

theorem barycentricKoszulDifferential_preserves (d i : ℕ) :
    Preserves (barycentricKoszulFiltration (P := P) K d (i + 1))
      (barycentricKoszulFiltration (P := P) K d i)
      (parameterKoszulDifferential (K := K)
        (fun j : Fin d => barycentricRankParameter K (j.val + 1)) i) :=
  basisHomogeneous_int_preserves _ _ _ _ _ (barycentricKoszulDifferential_weight K d i)

/-- These are actual cycle lifts in the literal Koszul term filtration. -/
theorem barycentricKoszulDifferential_liftsCycles (d i : ℕ) :
    LiftsCycles (barycentricKoszulFiltration (P := P) K d (i + 1))
      (barycentricKoszulFiltration (P := P) K d i)
      (parameterKoszulDifferential (K := K)
        (fun j : Fin d => barycentricRankParameter K (j.val + 1)) i) :=
  basisHomogeneous_int_liftsCycles _ _ _ _ _ (barycentricKoszulDifferential_weight K d i)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.OriginalKoszulCycles -/
section

/-! # Actual filtered cycle lifting in the original parameter Koszul complex -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

abbrev originalKoszulDifferential (i : ℕ) := parameterKoszulDifferential (K := K)
  (fun j : Fin d => faceRankParameter K hs (j.val + 1)) i

abbrev barycentricKoszulDifferential (i : ℕ) := parameterKoszulDifferential (K := K)
  (fun j : Fin d => barycentricRankParameter (P := P) K (j.val + 1)) i

theorem originalKoszulCoefficientEquiv_commutes (i : ℕ)
    (x : Set.powersetCard (Fin d) (i + 1) →₀ BarycentricRing (P := P) K) :
    originalKoszulDifferential K hs d i (originalKoszulCoefficientEquiv K hs d hrank (i + 1) x) =
      originalKoszulCoefficientEquiv K hs d hrank i (barycentricKoszulDifferential (P := P) K d i x) := by
  have h := parameterKoszul_map_commutes
    (fun j : Fin d => barycentricRankParameter (P := P) K (j.val + 1))
    (fun j : Fin d => faceRankParameter K hs (j.val + 1))
    (universalOriginalParameterComparison K hs d hrank).toLinearEquiv.toLinearMap (by
      intro j b
      simpa only [barycentricParameterAction, faceParameterAction, MvPolynomial.aeval_X,
        LinearEquiv.coe_coe] using
        (universalOriginalParameterComparison K hs d hrank).map_X_mul j b) i
  exact (LinearMap.congr_fun h x).symm

include hrank in
theorem originalKoszulDifferential_preserves (i : ℕ) :
    Preserves (originalKoszulFiltration K hs d (i + 1)) (originalKoszulFiltration K hs d i)
      (originalKoszulDifferential K hs d i) := by
  intro n x hx
  let y := (originalKoszulCoefficientEquiv K hs d hrank (i + 1)).symm x
  have hy : y ∈ (barycentricKoszulFiltration (P := P) K d (i + 1)).level n :=
    (originalKoszulCoefficientEquiv_filtered K hs d hrank (i + 1) n y).mp
      (by simpa only [y, LinearEquiv.apply_symm_apply] using hx)
  have hdy := barycentricKoszulDifferential_preserves K d i n y hy
  have h := (originalKoszulCoefficientEquiv_filtered K hs d hrank i n
    (barycentricKoszulDifferential (P := P) K d i y)).mpr hdy
  rw [← originalKoszulCoefficientEquiv_commutes] at h
  simpa only [y, LinearEquiv.apply_symm_apply] using h

include hrank in
/-- The required cycle lifts on the original ring are constructed by the
proved filtered chain equivalence; no degeneration assertion is assumed. -/
theorem originalKoszulDifferential_liftsCycles (i : ℕ) :
    LiftsCycles (originalKoszulFiltration K hs d (i + 1)) (originalKoszulFiltration K hs d i)
      (originalKoszulDifferential K hs d i) :=
  liftsCycles_of_filteredEquiv
    (barycentricKoszulFiltration (P := P) K d (i + 1))
    (barycentricKoszulFiltration (P := P) K d i) (barycentricKoszulDifferential (P := P) K d i)
    (originalKoszulFiltration K hs d (i + 1)) (originalKoszulFiltration K hs d i)
    (originalKoszulDifferential K hs d i)
    (originalKoszulCoefficientEquiv K hs d hrank (i + 1))
    (originalKoszulCoefficientEquiv K hs d hrank i)
    (originalKoszulCoefficientEquiv_filtered K hs d hrank (i + 1))
    (originalKoszulCoefficientEquiv_filtered K hs d hrank i)
    (originalKoszulCoefficientEquiv_commutes K hs d hrank i)
    (barycentricKoszulDifferential_liftsCycles K d i)

include hrank in
theorem originalKoszulDifferential_degree (i j : ℕ)
    (x : Set.powersetCard (Fin d) (i + 1) →₀ FaceRing K hs)
    (hx : x ∈ originalKoszulDegreePiece K hs d (i + 1) j) :
    originalKoszulDifferential K hs d i x ∈ originalKoszulDegreePiece K hs d i j := by
  let y := (originalKoszulCoefficientEquiv K hs d hrank (i + 1)).symm x
  have hy : y ∈ barycentricKoszulDegreePiece (P := P) K d (i + 1) j :=
    (originalKoszulCoefficientEquiv_degree K hs d hrank (i + 1) j y).mp
      (by simpa only [y, LinearEquiv.apply_symm_apply] using hx)
  have hdy := FourPapers.BasisGrading.map_piece _ _ _ _ _
    (barycentricKoszulDifferential_degree K d i) j y hy
  have h := (originalKoszulCoefficientEquiv_degree K hs d hrank i j
    (barycentricKoszulDifferential (P := P) K d i y)).mpr hdy
  rw [← originalKoszulCoefficientEquiv_commutes] at h
  simpa only [y, LinearEquiv.apply_symm_apply] using h

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.OriginalKoszulHomology -/
section

/-! # The intrinsic filtration and canonical associated homology comparison

Homology is the literal kernel modulo image of the original Koszul complex.
The filtration is the image of bounded-weight cycles, so it is independent
of the triangular comparison used to prove cycle lifting.  All homological
degrees, including degree zero, are handled by the actual chain complex.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

abbrev complexIncoming (C : ChainComplex (ModuleCat.{u} K) ℕ) (i : ℕ) :=
  (C.d (i + 1) i).hom
abbrev complexOutgoing (C : ChainComplex (ModuleCat.{u} K) ℕ) (i : ℕ) :=
  (C.d i (i - 1)).hom

theorem complexIncomingOutgoing (C : ChainComplex (ModuleCat.{u} K) ℕ) (i : ℕ) :
    (complexOutgoing C i).comp (complexIncoming C i) = 0 :=
  congrArg (fun f => f.hom) (C.d_comp_d (i + 1) i (i - 1))

abbrev complexKernelHomology (C : ChainComplex (ModuleCat.{u} K) ℕ) (i : ℕ) :=
  Homology (complexIncoming C i) (complexOutgoing C i) (complexIncomingOutgoing C i)

/-- The cycle quotient used here is canonically the standard categorical
homology of precisely the same complex. -/
def complexKernelHomologyIso (C : ChainComplex (ModuleCat.{u} K) ℕ) (i : ℕ) :
    C.homology i ≅ ModuleCat.of K (complexKernelHomology C i) :=
  C.homologyIsoSc' (i + 1) i (i - 1) (ChainComplex.prev ℕ i)
    (by cases i <;> simp) ≪≫ (C.sc' (i + 1) i (i - 1)).moduleCatHomologyIso

variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

abbrev originalKoszulHomology (i : ℕ) := complexKernelHomology (originalKoszulComplex K hs d) i
abbrev barycentricKoszulHomology (i : ℕ) := complexKernelHomology (barycentricKoszulComplex (P := P) K d) i

def originalKoszulHomologyFiltration (i : ℕ) : Filtration (K := K) (originalKoszulHomology K hs d i) :=
  homologyFiltration (originalKoszulFiltration K hs d i)
    (complexIncoming (originalKoszulComplex K hs d) i) (complexOutgoing (originalKoszulComplex K hs d) i)
    (complexIncomingOutgoing (originalKoszulComplex K hs d) i)

def barycentricKoszulHomologyFiltration (i : ℕ) :
    Filtration (K := K) (barycentricKoszulHomology (P := P) K d i) :=
  homologyFiltration (barycentricKoszulFiltration (P := P) K d i)
    (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
    (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
    (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) i)

include hrank in
theorem originalIncoming_preserves (i : ℕ) :
    Preserves (originalKoszulFiltration K hs d (i + 1)) (originalKoszulFiltration K hs d i)
      (complexIncoming (originalKoszulComplex K hs d) i) := by
  simpa only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom, originalKoszulDifferential] using
    originalKoszulDifferential_preserves K hs d hrank i

include hrank in
theorem originalOutgoing_preserves (i : ℕ) :
    Preserves (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d (i - 1))
      (complexOutgoing (originalKoszulComplex K hs d) i) := by
  cases i with
  | zero =>
      have hz := (originalKoszulComplex K hs d).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero]
      intro n x hx
      exact ((originalKoszulFiltration K hs d 0).level n).zero_mem
  | succ i =>
      simpa only [complexOutgoing, Nat.succ_sub_one, Nat.add_sub_cancel, parameterKoszulComplex_d, ModuleCat.hom_ofHom, originalKoszulDifferential] using
        originalKoszulDifferential_preserves K hs d hrank i

include hrank in
theorem originalIncoming_liftsCycles (i : ℕ) :
    LiftsCycles (originalKoszulFiltration K hs d (i + 1)) (originalKoszulFiltration K hs d i)
      (complexIncoming (originalKoszulComplex K hs d) i) := by
  simpa only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom, originalKoszulDifferential] using
    originalKoszulDifferential_liftsCycles K hs d hrank i

include hrank in
theorem originalOutgoing_liftsCycles (i : ℕ) :
    LiftsCycles (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d (i - 1))
      (complexOutgoing (originalKoszulComplex K hs d) i) := by
  cases i with
  | zero =>
      have hz := (originalKoszulComplex K hs d).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero]
      intro n x hx hdx
      exact ⟨x, hx, rfl, by simpa only [sub_self] using
        ((originalKoszulFiltration K hs d 0).level n).zero_mem⟩
  | succ i =>
      simpa only [complexOutgoing, Nat.succ_sub_one, Nat.add_sub_cancel, parameterKoszulComplex_d, ModuleCat.hom_ofHom, originalKoszulDifferential] using
        originalKoszulDifferential_liftsCycles K hs d hrank i

/-- The intrinsic associated graded of original Koszul homology is
canonically the homology of its associated graded differential. -/
def originalKoszulAssociatedHomology (i n : ℕ) :
    Grade (originalKoszulHomologyFiltration K hs d i) n ≃ₗ[K]
      GradedHomology (originalKoszulFiltration K hs d (i + 1))
        (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d (i - 1))
        (complexIncoming (originalKoszulComplex K hs d) i)
        (complexOutgoing (originalKoszulComplex K hs d) i)
        (originalIncoming_preserves K hs d hrank i) (originalOutgoing_preserves K hs d hrank i)
        (complexIncomingOutgoing (originalKoszulComplex K hs d) i) n :=
  associatedHomologyEquiv _ _ _ _ _ _ _ _ n
    (originalIncoming_liftsCycles K hs d hrank i) (originalOutgoing_liftsCycles K hs d hrank i)

/-- The value of the canonical comparison is specified on actual bounded
cycles.  In particular its definition does not depend on a cycle-lifting
algorithm or on an equivariant choice of triangular module comparison. -/
theorem originalKoszulAssociatedHomology_class (i n : ℕ)
    (z : cycleLevel (originalKoszulFiltration K hs d i)
      (complexOutgoing (originalKoszulComplex K hs d) i) (n + 1)) :
    originalKoszulAssociatedHomology K hs d hrank i n
      (filteredHomologyClass (originalKoszulFiltration K hs d i)
        (complexIncoming (originalKoszulComplex K hs d) i)
        (complexOutgoing (originalKoszulComplex K hs d) i)
        (complexIncomingOutgoing (originalKoszulComplex K hs d) i) n z) =
      leadingHomologyClass (originalKoszulFiltration K hs d (i + 1))
        (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d (i - 1))
        (complexIncoming (originalKoszulComplex K hs d) i)
        (complexOutgoing (originalKoszulComplex K hs d) i)
        (originalIncoming_preserves K hs d hrank i) (originalOutgoing_preserves K hs d hrank i)
        (complexIncomingOutgoing (originalKoszulComplex K hs d) i) n z :=
  associatedHomologyEquiv_class _ _ _ _ _ _ _ _ n _ _ z

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.InternalKoszulFiltration -/
section

/-! # Finite intrinsic filtrations in every internal degree

The internal strand is a genuine homogeneous subcomplex of the ordinary
Koszul complex.  Its inclusion has the actual homogeneous projection as a
retraction.  The rank-weight filtration is restricted to these submodules;
its bound is explicitly 2*d*j in internal degree j.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

section GeneralComplex
variable (C : ChainComplex (ModuleCat.{u} K) ℕ) (F : ∀ i, Filtration (K := K) (C.X i))

theorem complexOutgoing_preserves
    (h : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i)) (i : ℕ) :
    Preserves (F i) (F (i - 1)) (complexOutgoing C i) := by
  cases i with
  | zero =>
      have hz := C.shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero]
      intro n x hx
      exact ((F 0).level n).zero_mem
  | succ i =>
      simpa only [complexOutgoing, complexIncoming, Nat.succ_sub_one] using h i

theorem complexOutgoing_liftsCycles
    (h : ∀ i, LiftsCycles (F (i + 1)) (F i) (complexIncoming C i)) (i : ℕ) :
    LiftsCycles (F i) (F (i - 1)) (complexOutgoing C i) := by
  cases i with
  | zero =>
      have hz := C.shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero]
      intro n x hx hdx
      exact ⟨x, hx, rfl, by simpa only [sub_self] using ((F 0).level n).zero_mem⟩
  | succ i =>
      simpa only [complexOutgoing, complexIncoming, Nat.succ_sub_one] using h i
end GeneralComplex

variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def originalKoszulDegreeDifferential (j i : ℕ) :
    originalKoszulDegreePiece K hs d (i + 1) j →ₗ[K] originalKoszulDegreePiece K hs d i j :=
  restrictedMap (originalKoszulDifferential K hs d i) _ _
    (originalKoszulDifferential_degree K hs d hrank i j)

def originalKoszulDegreeComplex (j : ℕ) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (originalKoszulDegreePiece K hs d i j))
    (fun i => ModuleCat.ofHom (originalKoszulDegreeDifferential K hs d hrank j i)) (by
      intro i
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      exact LinearMap.congr_fun (parameterKoszulDifferential_comp
        (K := K) (fun r : Fin d => faceRankParameter K hs (r.val + 1)) i) x.val)

@[simp] theorem originalKoszulDegreeComplex_d (j i : ℕ) :
    (originalKoszulDegreeComplex K hs d hrank j).d (i + 1) i =
      ModuleCat.ofHom (originalKoszulDegreeDifferential K hs d hrank j i) := by
  simp [originalKoszulDegreeComplex]

def originalKoszulDegreeProjection (j i : ℕ) :
    Module.End K (Set.powersetCard (Fin d) i →₀ FaceRing K hs) :=
  FourPapers.BasisGrading.projection (originalKoszulBasis K hs d i) originalKoszulDegree j

include hrank in
theorem originalKoszulDegreeProjection_commutes (j i : ℕ) :
    (originalKoszulDifferential K hs d i).comp (originalKoszulDegreeProjection K hs d j (i + 1)) =
      (originalKoszulDegreeProjection K hs d j i).comp (originalKoszulDifferential K hs d i) :=
  basisProjection_commutes _ _ _ _ _
    (fun a => originalKoszulDifferential_degree K hs d hrank i (originalKoszulDegree a)
      (originalKoszulBasis K hs d (i + 1) a)
      (FourPapers.BasisGrading.basis_mem_piece _ _ a)) j

def originalKoszulDegreeInclusion (j : ℕ) :
    originalKoszulDegreeComplex K hs d hrank j ⟶ originalKoszulComplex K hs d where
  f i := ModuleCat.ofHom (originalKoszulDegreePiece K hs d i j).subtype
  comm' i k hik := by
    obtain rfl : i = k + 1 := hik.symm
    rw [parameterKoszulComplex_d, originalKoszulDegreeComplex_d]
    rfl

def originalKoszulDegreeRetraction (j : ℕ) :
    originalKoszulComplex K hs d ⟶ originalKoszulDegreeComplex K hs d hrank j where
  f i := ModuleCat.ofHom ((originalKoszulDegreeProjection K hs d j i).codRestrict _
    (fun x => FourPapers.BasisGrading.projection_mem _ _ _ x))
  comm' i k hik := by
    obtain rfl : i = k + 1 := hik.symm
    rw [parameterKoszulComplex_d, originalKoszulDegreeComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact (LinearMap.congr_fun (originalKoszulDegreeProjection_commutes K hs d hrank j k) x)

theorem originalKoszulDegreeInclusion_retraction (j : ℕ) :
    originalKoszulDegreeInclusion K hs d hrank j ≫ originalKoszulDegreeRetraction K hs d hrank j = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self x.property

theorem originalKoszulDegreeHomology_injective (j i : ℕ) :
    Function.Injective (HomologicalComplex.homologyMap (originalKoszulDegreeInclusion K hs d hrank j) i).hom := by
  have h : HomologicalComplex.homologyMap (originalKoszulDegreeInclusion K hs d hrank j) i ≫
      HomologicalComplex.homologyMap (originalKoszulDegreeRetraction K hs d hrank j) i = 𝟙 _ := by
    rw [← HomologicalComplex.homologyMap_comp, originalKoszulDegreeInclusion_retraction,
      HomologicalComplex.homologyMap_id]
  intro x y hxy
  have hh := congrArg (HomologicalComplex.homologyMap (originalKoszulDegreeRetraction K hs d hrank j) i) hxy
  simpa only [← ModuleCat.comp_apply, h, ModuleCat.id_apply] using hh

def originalDegreeTermFiltration (j i : ℕ) :
    Filtration (K := K) (originalKoszulDegreePiece K hs d i j) :=
  submoduleFiltration (originalKoszulFiltration K hs d i) (originalKoszulDegreePiece K hs d i j)

theorem originalDegreeTermFiltration_top (j i : ℕ) :
    (originalDegreeTermFiltration K hs d j i).level (2 * d * j + 1) = ⊤ :=
  submoduleFiltration_top _ _ _ (originalKoszulDegreePiece_finite K hs d i j)

theorem originalDegreeDifferential_preserves (j i : ℕ) :
    Preserves (originalDegreeTermFiltration K hs d j (i + 1)) (originalDegreeTermFiltration K hs d j i)
      (originalKoszulDegreeDifferential K hs d hrank j i) :=
  restrictedMap_preserves _ _ _ (originalKoszulDifferential_preserves K hs d hrank i) _ _ _

theorem originalDegreeDifferential_liftsCycles (j i : ℕ) :
    LiftsCycles (originalDegreeTermFiltration K hs d j (i + 1)) (originalDegreeTermFiltration K hs d j i)
      (originalKoszulDegreeDifferential K hs d hrank j i) :=
  restrictedMap_liftsCycles _ _ _ (originalKoszulDifferential_liftsCycles K hs d hrank i) _ _ _
    (originalKoszulDegreeProjection K hs d j (i + 1)) (originalKoszulDegreeProjection K hs d j i)
    (fun x => FourPapers.BasisGrading.projection_mem _ _ _ x)
    (fun x hx => FourPapers.BasisGrading.projection_eq_self hx)
    (basisProjection_preserves_other _ _ _ _)
    (fun x => LinearMap.congr_fun (originalKoszulDegreeProjection_commutes K hs d hrank j i) x)

abbrev originalInternalKoszulHomology (j i : ℕ) :=
  complexKernelHomology (originalKoszulDegreeComplex K hs d hrank j) i

def originalInternalHomologyFiltration (j i : ℕ) :
    Filtration (K := K) (originalInternalKoszulHomology K hs d hrank j i) :=
  homologyFiltration (originalDegreeTermFiltration K hs d j i)
    (complexIncoming (originalKoszulDegreeComplex K hs d hrank j) i)
    (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i)
    (complexIncomingOutgoing (originalKoszulDegreeComplex K hs d hrank j) i)

/-- An explicit finite upper endpoint, valid over every commutative ring. -/
theorem originalInternalHomologyFiltration_finite (j i : ℕ) :
    (originalInternalHomologyFiltration K hs d hrank j i).level (2 * d * j + 1) = ⊤ :=
  homologyFiltration_top _ _ _ _ _ (originalDegreeTermFiltration_top K hs d j i)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.KoszulAssociatedComparison -/
section

/-! # The canonical graded comparison of the two actual Koszul homologies -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K X Y X' Y' : Type u} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup X'] [Module K X'] [AddCommGroup Y'] [Module K Y']

theorem gradeEquiv_commutes
    (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (F' : Filtration (K := K) X') (G' : Filtration (K := K) Y')
    (f : X →ₗ[K] Y) (f' : X' →ₗ[K] Y') (hf : Preserves F G f) (hf' : Preserves F' G' f')
    (a : X ≃ₗ[K] X') (b : Y ≃ₗ[K] Y')
    (ha : ∀ n x, a x ∈ F'.level n ↔ x ∈ F.level n)
    (hb : ∀ n y, b y ∈ G'.level n ↔ y ∈ G.level n)
    (hcomm : ∀ x, f' (a x) = b (f x)) (n : ℕ) (x : Grade F n) :
    gradeMap F' G' f' hf' n (gradeEquiv F F' a ha n x) =
      gradeEquiv G G' b hb n (gradeMap F G f hf n x) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel G' n))
  apply Subtype.ext
  exact hcomm x.val

variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

theorem canonicalKoszulCoefficientEquiv_filtered (i n : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    canonicalKoszulCoefficientEquiv K hs d i x ∈ (originalKoszulFiltration K hs d i).level n ↔
      x ∈ (barycentricKoszulFiltration (P := P) K d i).level n := by
  change _ ∈ (basisFiltration (originalKoszulBasis K hs d i) _).level n ↔
    _ ∈ (basisFiltration (barycentricKoszulBasis (P := P) K d i) _).level n
  rw [basisFiltration_mem, basisFiltration_mem, canonicalKoszulCoefficientEquiv_eq]
  simp only [canonicalBasisEquiv_repr]

def koszulGradeComparison (i n : ℕ) :
    Grade (barycentricKoszulFiltration (P := P) K d i) n ≃ₗ[K]
      Grade (originalKoszulFiltration K hs d i) n :=
  gradeEquiv _ _ (originalKoszulCoefficientEquiv K hs d hrank i)
    (originalKoszulCoefficientEquiv_filtered K hs d hrank i) n

def canonicalKoszulGradeComparison (i n : ℕ) :
    Grade (barycentricKoszulFiltration (P := P) K d i) n ≃ₗ[K]
      Grade (originalKoszulFiltration K hs d i) n :=
  gradeEquiv _ _ (canonicalKoszulCoefficientEquiv K hs d i)
    (canonicalKoszulCoefficientEquiv_filtered K hs d i) n

/-- Independence from every lower-weight correction in the chosen lift. -/
theorem koszulGradeComparison_eq_canonical (i n : ℕ) :
    koszulGradeComparison K hs d hrank i n = canonicalKoszulGradeComparison K hs d i n := by
  apply LinearEquiv.toLinearMap_injective
  rw [koszulGradeComparison, canonicalKoszulGradeComparison,
    gradeEquiv_eq_gradeMap, gradeEquiv_eq_gradeMap]
  exact gradeMap_eq_of_lower_error _ _ _ _ _ _ n
    (originalKoszulCoefficientEquiv_error_lower K hs d hrank i n)

theorem barycentricIncoming_preserves (i : ℕ) :
    Preserves (barycentricKoszulFiltration (P := P) K d (i + 1))
      (barycentricKoszulFiltration (P := P) K d i)
      (complexIncoming (barycentricKoszulComplex (P := P) K d) i) := by
  simpa only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom,
    originalKoszulDifferential, barycentricKoszulDifferential] using barycentricKoszulDifferential_preserves K d i

theorem barycentricOutgoing_preserves (i : ℕ) :
    Preserves (barycentricKoszulFiltration (P := P) K d i)
      (barycentricKoszulFiltration (P := P) K d (i - 1))
      (complexOutgoing (barycentricKoszulComplex (P := P) K d) i) :=
  complexOutgoing_preserves (barycentricKoszulComplex (P := P) K d)
    (barycentricKoszulFiltration (P := P) K d) (barycentricIncoming_preserves K d) i

theorem coefficientEquiv_incoming_commutes (i : ℕ)
    (x : Set.powersetCard (Fin d) (i + 1) →₀ BarycentricRing (P := P) K) :
    complexIncoming (originalKoszulComplex K hs d) i
      (originalKoszulCoefficientEquiv K hs d hrank (i + 1) x) =
      originalKoszulCoefficientEquiv K hs d hrank i
        (complexIncoming (barycentricKoszulComplex (P := P) K d) i x) := by
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change originalKoszulDifferential K hs d i
      (originalKoszulCoefficientEquiv K hs d hrank (i + 1) x) =
    originalKoszulCoefficientEquiv K hs d hrank i (barycentricKoszulDifferential (P := P) K d i x)
  exact originalKoszulCoefficientEquiv_commutes K hs d hrank i x

theorem coefficientEquiv_outgoing_commutes (i : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    complexOutgoing (originalKoszulComplex K hs d) i
      (originalKoszulCoefficientEquiv K hs d hrank i x) =
      originalKoszulCoefficientEquiv K hs d hrank (i - 1)
        (complexOutgoing (barycentricKoszulComplex (P := P) K d) i x) := by
  cases i with
  | zero =>
      have hR := (originalKoszulComplex K hs d).shape 0 0 (by decide)
      have hB := (barycentricKoszulComplex (P := P) K d).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hR, hB, ModuleCat.hom_zero, LinearMap.zero_apply, map_zero]
  | succ i =>
      simpa only [complexOutgoing, complexIncoming, Nat.succ_sub_one, Nat.add_sub_cancel] using
        coefficientEquiv_incoming_commutes K hs d hrank i x

abbrev originalGradedKoszulHomology (i n : ℕ) :=
  GradedHomology (originalKoszulFiltration K hs d (i + 1)) (originalKoszulFiltration K hs d i)
    (originalKoszulFiltration K hs d (i - 1))
    (complexIncoming (originalKoszulComplex K hs d) i) (complexOutgoing (originalKoszulComplex K hs d) i)
    (originalIncoming_preserves K hs d hrank i) (originalOutgoing_preserves K hs d hrank i)
    (complexIncomingOutgoing (originalKoszulComplex K hs d) i) n

abbrev barycentricGradedKoszulHomology (i n : ℕ) :=
  GradedHomology (barycentricKoszulFiltration (P := P) K d (i + 1))
    (barycentricKoszulFiltration (P := P) K d i) (barycentricKoszulFiltration (P := P) K d (i - 1))
    (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
    (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
    (barycentricIncoming_preserves K d i) (barycentricOutgoing_preserves K d i)
    (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) i) n

def koszulGradedHomologyComparison (i n : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i n ≃ₗ[K] originalGradedKoszulHomology K hs d hrank i n :=
  chainHomologyEquiv _ _ _ _ _ _
    (koszulGradeComparison K hs d hrank (i + 1) n)
    (koszulGradeComparison K hs d hrank i n)
    (koszulGradeComparison K hs d hrank (i - 1) n)
    (gradeEquiv_commutes _ _ _ _ _ _ _ _ _ _
      (originalKoszulCoefficientEquiv_filtered K hs d hrank (i + 1))
      (originalKoszulCoefficientEquiv_filtered K hs d hrank i)
      (coefficientEquiv_incoming_commutes K hs d hrank i) n)
    (gradeEquiv_commutes _ _ _ _ _ _ _ _ _ _
      (originalKoszulCoefficientEquiv_filtered K hs d hrank i)
      (originalKoszulCoefficientEquiv_filtered K hs d hrank (i - 1))
      (coefficientEquiv_outgoing_commutes K hs d hrank i) n)

/-- The canonical filtered-homology comparison from the original ring to
the associated graded barycentric Koszul homology. -/
def originalAssociatedBarycentricHomology (i n : ℕ) :
    Grade (originalKoszulHomologyFiltration K hs d i) n ≃ₗ[K]
      barycentricGradedKoszulHomology (P := P) K d i n :=
  (originalKoszulAssociatedHomology K hs d hrank i n).trans
    (koszulGradedHomologyComparison K hs d hrank i n).symm

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.BarycentricWeightHomology -/
section

/-! # Identifying the barycentric graded homology with the actual weight strands -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (d : ℕ)

def barycentricKoszulWeightPiece (n i : ℕ) :=
  FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
    (fun a => (originalKoszulWeight d a).toNat) n

theorem barycentricIncoming_weight (i : ℕ) (a : OriginalKoszulIndex P d (i + 1)) :
    complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈
      barycentricKoszulWeightPiece (P := P) K d (originalKoszulWeight d a).toNat i := by
  have h : complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈
      FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
        (originalKoszulWeight d) (originalKoszulWeight d a) := by
    simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
    change parameterKoszulDifferential (K := K)
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i
        (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈ _
    exact barycentricKoszulDifferential_weight K d i a
  rw [FourPapers.BasisGrading.mem_piece] at h
  change _ ∈ FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
    (fun b => (originalKoszulWeight d b).toNat) (originalKoszulWeight d a).toNat
  rw [FourPapers.BasisGrading.mem_piece]
  intro b hb
  exact congrArg Int.toNat (h b hb)

theorem barycentricOutgoing_weight (i : ℕ) (a : OriginalKoszulIndex P d i) :
    complexOutgoing (barycentricKoszulComplex (P := P) K d) i
      (barycentricKoszulBasis (P := P) K d i a) ∈
      barycentricKoszulWeightPiece (P := P) K d (originalKoszulWeight d a).toNat (i - 1) := by
  cases i with
  | zero =>
      have hz := (barycentricKoszulComplex (P := P) K d).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero, LinearMap.zero_apply]
      exact Submodule.zero_mem _
  | succ i =>
      simpa only [complexOutgoing, complexIncoming, Nat.succ_sub_one, Nat.add_sub_cancel] using barycentricIncoming_weight K d i a

def barycentricWeightIncoming (n i : ℕ) :
    barycentricKoszulWeightPiece (P := P) K d n (i + 1) →ₗ[K]
      barycentricKoszulWeightPiece (P := P) K d n i :=
  restrictedMap (complexIncoming (barycentricKoszulComplex (P := P) K d) i) _ _
    (FourPapers.BasisGrading.map_piece _ _ _ _ _ (barycentricIncoming_weight K d i) n)

def barycentricWeightOutgoing (n i : ℕ) :
    barycentricKoszulWeightPiece (P := P) K d n i →ₗ[K]
      barycentricKoszulWeightPiece (P := P) K d n (i - 1) :=
  restrictedMap (complexOutgoing (barycentricKoszulComplex (P := P) K d) i) _ _
    (FourPapers.BasisGrading.map_piece _ _ _ _ _ (barycentricOutgoing_weight K d i) n)

theorem barycentricWeight_complex (n i : ℕ) :
    (barycentricWeightOutgoing (P := P) K d n i).comp (barycentricWeightIncoming (P := P) K d n i) = 0 := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact LinearMap.congr_fun (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) i) x.val

abbrev barycentricWeightHomology (n i : ℕ) :=
  Homology (K := K)
    (X := barycentricKoszulWeightPiece (P := P) K d n (i + 1))
    (Y := barycentricKoszulWeightPiece (P := P) K d n i)
    (Z := barycentricKoszulWeightPiece (P := P) K d n (i - 1))
    (barycentricWeightIncoming (P := P) K d n i) (barycentricWeightOutgoing (P := P) K d n i)
    (barycentricWeight_complex (P := P) K d n i)

def barycentricGradeWeightHomology (n i : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i n ≃ₗ[K] barycentricWeightHomology (P := P) K d n i :=
  chainHomologyEquiv _ _ _ _ _ _
    (basisGradeEquiv (barycentricKoszulBasis (P := P) K d (i + 1)) _ n)
    (basisGradeEquiv (barycentricKoszulBasis (P := P) K d i) _ n)
    (basisGradeEquiv (barycentricKoszulBasis (P := P) K d (i - 1)) _ n)
    (by
      intro x
      apply Subtype.ext
      exact (basisGradeEquiv_differential _ _ _ _ _ (barycentricIncoming_preserves K d i)
        (barycentricIncoming_weight K d i) n x).symm)
    (by
      intro x
      apply Subtype.ext
      exact (basisGradeEquiv_differential _ _ _ _ _ (barycentricOutgoing_preserves K d i)
        (barycentricOutgoing_weight K d i) n x).symm)

variable (hs : IsSimplicialPoset P) (hrank : ∀ p : P, faceRank p ≤ d)

/-- The intrinsic graded piece of original Koszul homology is the homology
of the honest rank-weight strand of the barycentric Koszul complex. -/
def originalAssociatedWeightHomology (i n : ℕ) :
    Grade (originalKoszulHomologyFiltration K hs d i) n ≃ₗ[K]
      barycentricWeightHomology (P := P) K d n i :=
  (originalAssociatedBarycentricHomology K hs d hrank i n).trans
    (barycentricGradeWeightHomology (P := P) K d n i)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.BigradedFiltration -/
section

/-! # Successive quotients inside a fixed internal degree

Top weight projection identifies the actual filtration quotient inside a
homogeneous summand with the intersection of the two homogeneous pieces.
No chosen basis of that intersection or cancellation assumption is needed.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
variable {K I J X Y A : Type*} [CommRing K] [AddCommGroup X] [Module K X]
  [AddCommGroup Y] [Module K Y]

def basisDoublePiece (b : Module.Basis I K X) (degree : I → A) (a : A) (w : I → ℕ) (n : ℕ) :
    Submodule K (FourPapers.BasisGrading.Piece b degree a) :=
  (FourPapers.BasisGrading.Piece b w n).comap (FourPapers.BasisGrading.Piece b degree a).subtype

def basisDegreeFiltration (b : Module.Basis I K X) (degree : I → A) (a : A) (w : I → ℕ) :=
  submoduleFiltration (basisFiltration b w) (FourPapers.BasisGrading.Piece b degree a)

def basisDoubleTopProjection (b : Module.Basis I K X) (degree : I → A) (a : A)
    (w : I → ℕ) (n : ℕ) :
    (basisDegreeFiltration b degree a w).level (n + 1) →ₗ[K] basisDoublePiece b degree a w n :=
  ((restrictedMap (FourPapers.BasisGrading.projection b w n)
    (FourPapers.BasisGrading.Piece b degree a) (FourPapers.BasisGrading.Piece b degree a)
    (fun x hx => FourPapers.BasisGrading.projection_mem_piece b w degree n a x hx)).domRestrict _).codRestrict _
      (fun x => FourPapers.BasisGrading.projection_mem b w n x.val.val)

theorem basisDoubleTopProjection_ker (b : Module.Basis I K X) (degree : I → A) (a : A)
    (w : I → ℕ) (n : ℕ) :
    LinearMap.ker (basisDoubleTopProjection b degree a w n) =
      lowerInLevel (basisDegreeFiltration b degree a w) n := by
  ext x
  constructor
  · intro h
    have hz : FourPapers.BasisGrading.projection b w n x.val.val = 0 :=
      congrArg (fun y : basisDoublePiece b degree a w n => y.val.val) h
    change x.val.val ∈ (basisFiltration b w).level n
    simpa only [hz, sub_zero] using basisProjection_error_lower b w n x.val.val x.property
  · intro h
    apply Subtype.ext
    apply Subtype.ext
    exact basisProjection_lower_zero b w n x.val.val h

theorem basisDoubleTopProjection_surjective (b : Module.Basis I K X) (degree : I → A) (a : A)
    (w : I → ℕ) (n : ℕ) : Function.Surjective (basisDoubleTopProjection b degree a w n) := by
  intro y
  have hy : y.val.val ∈ (basisFiltration b w).level (n + 1) := by
    have hp := basisProjection_level b w n y.val.val
    have hself : FourPapers.BasisGrading.projection b w n y.val.val = y.val.val :=
      FourPapers.BasisGrading.projection_eq_self
        (show y.val.val ∈ FourPapers.BasisGrading.Piece b w n from y.property)
    rwa [hself] at hp
  refine ⟨⟨y.val, hy⟩, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self y.property

def basisDoubleGradeEquiv (b : Module.Basis I K X) (degree : I → A) (a : A)
    (w : I → ℕ) (n : ℕ) :
    Grade (basisDegreeFiltration b degree a w) n ≃ₗ[K] basisDoublePiece b degree a w n :=
  (Submodule.quotEquivOfEq _ _ (basisDoubleTopProjection_ker b degree a w n).symm).trans
    ((basisDoubleTopProjection b degree a w n).quotKerEquivOfSurjective
      (basisDoubleTopProjection_surjective b degree a w n))

@[simp] theorem basisDoubleGradeEquiv_mk (b : Module.Basis I K X) (degree : I → A) (a : A)
    (w : I → ℕ) (n : ℕ) (x : (basisDegreeFiltration b degree a w).level (n + 1)) :
    basisDoubleGradeEquiv b degree a w n (Submodule.Quotient.mk x) =
      basisDoubleTopProjection b degree a w n x := rfl

def basisDoubleMap (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (degree : I → A) (degree' : J → A) (a : A) (w : I → ℕ) (v : J → ℕ)
    (f : X →ₗ[K] Y)
    (hd : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c degree' (degree i))
    (hw : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) (n : ℕ) :
    basisDoublePiece b degree a w n →ₗ[K] basisDoublePiece c degree' a v n :=
  restrictedMap
    (restrictedMap f _ _ (FourPapers.BasisGrading.map_piece b c degree degree' f hd a)) _ _
    (fun x hx => FourPapers.BasisGrading.map_piece b c w v f hw n x.val hx)

theorem basisDoubleGradeEquiv_differential (b : Module.Basis I K X) (c : Module.Basis J K Y)
    (degree : I → A) (degree' : J → A) (a : A) (w : I → ℕ) (v : J → ℕ)
    (f : X →ₗ[K] Y)
    (hd : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c degree' (degree i))
    (hw : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i)) (n : ℕ)
    (x : Grade (basisDegreeFiltration b degree a w) n) :
    basisDoubleMap b c degree degree' a w v f hd hw n (basisDoubleGradeEquiv b degree a w n x) =
      basisDoubleGradeEquiv c degree' a v n
        (gradeMap _ _ (restrictedMap f _ _ (FourPapers.BasisGrading.map_piece b c degree degree' f hd a))
          (restrictedMap_preserves _ _ _ (basisHomogeneous_preserves b c w v f hw) _ _ _) n x) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel (basisDegreeFiltration b degree a w) n).mkQ_surjective x
  apply Subtype.ext
  apply Subtype.ext
  exact LinearMap.congr_fun (basisProjection_commutes b c w v f hw n) x.val.val

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.InternalKoszulComparison -/
section

/-! # The canonical comparison in each internal degree

The source filtration is defined on actual internally homogeneous cycles.
The target consists of the actual homogeneous strands of the barycentric
Koszul differential; no homology group is substituted by definition.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 650000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def barycentricKoszulDegreeDifferential (j i : ℕ) :
    barycentricKoszulDegreePiece (P := P) K d (i + 1) j →ₗ[K]
      barycentricKoszulDegreePiece (P := P) K d i j :=
  restrictedMap (barycentricKoszulDifferential (P := P) K d i) _ _
    (FourPapers.BasisGrading.map_piece _ _ _ _ _ (barycentricKoszulDifferential_degree K d i) j)

def barycentricKoszulDegreeComplex (j : ℕ) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (barycentricKoszulDegreePiece (P := P) K d i j))
    (fun i => ModuleCat.ofHom (barycentricKoszulDegreeDifferential (P := P) K d j i)) (by
      intro i
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      exact LinearMap.congr_fun (parameterKoszulDifferential_comp
        (K := K) (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i) x.val)

@[simp] theorem barycentricKoszulDegreeComplex_d (j i : ℕ) :
    (barycentricKoszulDegreeComplex (P := P) K d j).d (i + 1) i =
      ModuleCat.ofHom (barycentricKoszulDegreeDifferential (P := P) K d j i) := by
  simp [barycentricKoszulDegreeComplex]

def barycentricDegreeTermFiltration (j i : ℕ) :=
  submoduleFiltration (barycentricKoszulFiltration (P := P) K d i)
    (barycentricKoszulDegreePiece (P := P) K d i j)

def internalKoszulCoefficientEquiv (j i : ℕ) :
    barycentricKoszulDegreePiece (P := P) K d i j ≃ₗ[K] originalKoszulDegreePiece K hs d i j where
  toFun x := ⟨originalKoszulCoefficientEquiv K hs d hrank i x.val,
    (originalKoszulCoefficientEquiv_degree K hs d hrank i j x.val).mpr x.property⟩
  invFun y := ⟨(originalKoszulCoefficientEquiv K hs d hrank i).symm y.val,
    (originalKoszulCoefficientEquiv_degree K hs d hrank i j _).mp
      (by simpa only [LinearEquiv.apply_symm_apply] using y.property)⟩
  left_inv x := Subtype.ext ((originalKoszulCoefficientEquiv K hs d hrank i).symm_apply_apply x.val)
  right_inv y := Subtype.ext ((originalKoszulCoefficientEquiv K hs d hrank i).apply_symm_apply y.val)
  map_add' x y := Subtype.ext (map_add _ x.val y.val)
  map_smul' a x := Subtype.ext (map_smul _ a x.val)

theorem internalKoszulCoefficientEquiv_filtered (j i n : ℕ)
    (x : barycentricKoszulDegreePiece (P := P) K d i j) :
    internalKoszulCoefficientEquiv K hs d hrank j i x ∈ (originalDegreeTermFiltration K hs d j i).level n ↔
      x ∈ (barycentricDegreeTermFiltration (P := P) K d j i).level n :=
  originalKoszulCoefficientEquiv_filtered K hs d hrank i n x.val

theorem internalKoszulCoefficientEquiv_commutes (j i : ℕ)
    (x : barycentricKoszulDegreePiece (P := P) K d (i + 1) j) :
    originalKoszulDegreeDifferential K hs d hrank j i
      (internalKoszulCoefficientEquiv K hs d hrank j (i + 1) x) =
      internalKoszulCoefficientEquiv K hs d hrank j i
        (barycentricKoszulDegreeDifferential (P := P) K d j i x) :=
  Subtype.ext (originalKoszulCoefficientEquiv_commutes K hs d hrank i x.val)

def originalInternalKoszulComparison (j : ℕ) :
    barycentricKoszulDegreeComplex (P := P) K d j ≅ originalKoszulDegreeComplex K hs d hrank j :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (internalKoszulCoefficientEquiv K hs d hrank j i).toModuleIso) (by
      intro i k hik
      obtain rfl : i = k + 1 := hik.symm
      rw [barycentricKoszulDegreeComplex_d, originalKoszulDegreeComplex_d]
      apply ModuleCat.hom_ext
      ext x
      exact internalKoszulCoefficientEquiv_commutes K hs d hrank j k x)

theorem barycentricDegreeIncoming_preserves (j i : ℕ) :
    Preserves (barycentricDegreeTermFiltration (P := P) K d j (i + 1))
      (barycentricDegreeTermFiltration (P := P) K d j i)
      (complexIncoming (barycentricKoszulDegreeComplex (P := P) K d j) i) := by
  simp only [complexIncoming, barycentricKoszulDegreeComplex_d, ModuleCat.hom_ofHom]
  intro n x hx
  exact barycentricKoszulDifferential_preserves K d i n x.val hx

theorem originalDegreeIncoming_preserves (j i : ℕ) :
    Preserves (originalDegreeTermFiltration K hs d j (i + 1))
      (originalDegreeTermFiltration K hs d j i)
      (complexIncoming (originalKoszulDegreeComplex K hs d hrank j) i) := by
  simpa only [complexIncoming, originalKoszulDegreeComplex_d, ModuleCat.hom_ofHom] using originalDegreeDifferential_preserves K hs d hrank j i

theorem originalDegreeIncoming_liftsCycles (j i : ℕ) :
    LiftsCycles (originalDegreeTermFiltration K hs d j (i + 1))
      (originalDegreeTermFiltration K hs d j i)
      (complexIncoming (originalKoszulDegreeComplex K hs d hrank j) i) := by
  simpa only [complexIncoming, originalKoszulDegreeComplex_d, ModuleCat.hom_ofHom] using originalDegreeDifferential_liftsCycles K hs d hrank j i

theorem internalCoefficientEquiv_incoming (j i : ℕ)
    (x : barycentricKoszulDegreePiece (P := P) K d (i + 1) j) :
    complexIncoming (originalKoszulDegreeComplex K hs d hrank j) i
      (internalKoszulCoefficientEquiv K hs d hrank j (i + 1) x) =
      internalKoszulCoefficientEquiv K hs d hrank j i
        (complexIncoming (barycentricKoszulDegreeComplex (P := P) K d j) i x) := by
  simp only [complexIncoming, originalKoszulDegreeComplex_d, barycentricKoszulDegreeComplex_d,
    ModuleCat.hom_ofHom]
  change originalKoszulDegreeDifferential K hs d hrank j i
      (internalKoszulCoefficientEquiv K hs d hrank j (i + 1) x) =
    internalKoszulCoefficientEquiv K hs d hrank j i
      (barycentricKoszulDegreeDifferential (P := P) K d j i x)
  exact internalKoszulCoefficientEquiv_commutes K hs d hrank j i x

theorem internalCoefficientEquiv_outgoing (j i : ℕ)
    (x : barycentricKoszulDegreePiece (P := P) K d i j) :
    complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i
      (internalKoszulCoefficientEquiv K hs d hrank j i x) =
      internalKoszulCoefficientEquiv K hs d hrank j (i - 1)
        (complexOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i x) := by
  cases i with
  | zero =>
      have hR := (originalKoszulDegreeComplex K hs d hrank j).shape 0 0 (by decide)
      have hB := (barycentricKoszulDegreeComplex (P := P) K d j).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hR, hB, ModuleCat.hom_zero, LinearMap.zero_apply, map_zero]
  | succ i =>
      simpa only [complexOutgoing, complexIncoming, Nat.succ_sub_one, Nat.add_sub_cancel] using
        internalCoefficientEquiv_incoming K hs d hrank j i x

def internalKoszulGradeComparison (j i n : ℕ) :
    Grade (barycentricDegreeTermFiltration (P := P) K d j i) n ≃ₗ[K]
      Grade (originalDegreeTermFiltration K hs d j i) n :=
  gradeEquiv _ _ (internalKoszulCoefficientEquiv K hs d hrank j i)
    (internalKoszulCoefficientEquiv_filtered K hs d hrank j i) n

abbrev barycentricInternalGradedHomology (j i n : ℕ) :=
  GradedHomology (barycentricDegreeTermFiltration (P := P) K d j (i + 1))
    (barycentricDegreeTermFiltration (P := P) K d j i) (barycentricDegreeTermFiltration (P := P) K d j (i - 1))
    (complexIncoming (barycentricKoszulDegreeComplex (P := P) K d j) i)
    (complexOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i)
    (barycentricDegreeIncoming_preserves K d j i)
    (complexOutgoing_preserves (barycentricKoszulDegreeComplex (P := P) K d j)
      (barycentricDegreeTermFiltration (P := P) K d j) (barycentricDegreeIncoming_preserves K d j) i)
    (complexIncomingOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i) n

abbrev originalInternalGradedHomology (j i n : ℕ) :=
  GradedHomology (originalDegreeTermFiltration K hs d j (i + 1))
    (originalDegreeTermFiltration K hs d j i) (originalDegreeTermFiltration K hs d j (i - 1))
    (complexIncoming (originalKoszulDegreeComplex K hs d hrank j) i)
    (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i)
    (originalDegreeIncoming_preserves K hs d hrank j i)
    (complexOutgoing_preserves (originalKoszulDegreeComplex K hs d hrank j)
      (originalDegreeTermFiltration K hs d j) (originalDegreeIncoming_preserves K hs d hrank j) i)
    (complexIncomingOutgoing (originalKoszulDegreeComplex K hs d hrank j) i) n

def internalKoszulGradedHomologyComparison (j i n : ℕ) :
    barycentricInternalGradedHomology (P := P) K d j i n ≃ₗ[K]
      originalInternalGradedHomology K hs d hrank j i n :=
  chainHomologyEquiv _ _ _ _ _ _
    (internalKoszulGradeComparison K hs d hrank j (i + 1) n)
    (internalKoszulGradeComparison K hs d hrank j i n)
    (internalKoszulGradeComparison K hs d hrank j (i - 1) n)
    (gradeEquiv_commutes _ _ _ _ _ _ _ _ _ _
      (internalKoszulCoefficientEquiv_filtered K hs d hrank j (i + 1))
      (internalKoszulCoefficientEquiv_filtered K hs d hrank j i)
      (internalCoefficientEquiv_incoming K hs d hrank j i) n)
    (gradeEquiv_commutes _ _ _ _ _ _ _ _ _ _
      (internalKoszulCoefficientEquiv_filtered K hs d hrank j i)
      (internalKoszulCoefficientEquiv_filtered K hs d hrank j (i - 1))
      (internalCoefficientEquiv_outgoing K hs d hrank j i) n)

/-- The finite, intrinsic internal-degree filtration has the required
canonical comparison with the barycentric graded homology. -/
def originalInternalAssociatedBarycentricHomology (j i n : ℕ) :
    Grade (originalInternalHomologyFiltration K hs d hrank j i) n ≃ₗ[K]
      barycentricInternalGradedHomology (P := P) K d j i n :=
  (associatedHomologyEquiv _ _ _ _ _ _ _ _ n
    (originalDegreeIncoming_liftsCycles K hs d hrank j i)
    (complexOutgoing_liftsCycles (originalKoszulDegreeComplex K hs d hrank j)
      (originalDegreeTermFiltration K hs d j) (originalDegreeIncoming_liftsCycles K hs d hrank j) i)).trans
      (internalKoszulGradedHomologyComparison K hs d hrank j i n).symm

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.BarycentricBigradedHomology -/
section

/-! # The honest internal-degree and weight strands on the barycentric side -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (d : ℕ)

def barycentricDoublePiece (j n i : ℕ) :
    Submodule K (barycentricKoszulDegreePiece (P := P) K d i j) :=
  basisDoublePiece (barycentricKoszulBasis (P := P) K d i) originalKoszulDegree j
    (fun a => (originalKoszulWeight d a).toNat) n

theorem barycentricIncoming_degree (i : ℕ) (a : OriginalKoszulIndex P d (i + 1)) :
    complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈
      barycentricKoszulDegreePiece (P := P) K d i (originalKoszulDegree a) := by
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change parameterKoszulDifferential (K := K)
    (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i
      (barycentricKoszulBasis (P := P) K d (i + 1) a) ∈ _
  exact barycentricKoszulDifferential_degree K d i a

theorem barycentricOutgoing_degree (i : ℕ) (a : OriginalKoszulIndex P d i) :
    complexOutgoing (barycentricKoszulComplex (P := P) K d) i
      (barycentricKoszulBasis (P := P) K d i a) ∈
      barycentricKoszulDegreePiece (P := P) K d (i - 1) (originalKoszulDegree a) := by
  cases i with
  | zero =>
      have hz := (barycentricKoszulComplex (P := P) K d).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero, LinearMap.zero_apply]
      exact Submodule.zero_mem _
  | succ i =>
      simpa only [complexOutgoing, complexIncoming, Nat.succ_sub_one, Nat.add_sub_cancel] using barycentricIncoming_degree K d i a

def barycentricDoubleIncoming (j n i : ℕ) :
    barycentricDoublePiece (P := P) K d j n (i + 1) →ₗ[K] barycentricDoublePiece (P := P) K d j n i :=
  basisDoubleMap _ _ _ _ j _ _ (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
    (barycentricIncoming_degree K d i) (barycentricIncoming_weight K d i) n

def barycentricDoubleOutgoing (j n i : ℕ) :
    barycentricDoublePiece (P := P) K d j n i →ₗ[K] barycentricDoublePiece (P := P) K d j n (i - 1) :=
  basisDoubleMap _ _ _ _ j _ _ (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
    (barycentricOutgoing_degree K d i) (barycentricOutgoing_weight K d i) n

theorem barycentricDouble_complex (j n i : ℕ) :
    (barycentricDoubleOutgoing (P := P) K d j n i).comp (barycentricDoubleIncoming (P := P) K d j n i) = 0 := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Subtype.ext
  exact LinearMap.congr_fun (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) i) x.val.val

/-- The group structure is derived from the existing module structure, so its
additive monoid is exactly the one used by the nested strand maps. -/
instance (priority := 100) barycentricDoublePieceAddCommGroup (j n i : ℕ) :
    AddCommGroup (barycentricDoublePiece (P := P) K d j n i) :=
  Module.addCommMonoidToAddCommGroup K

abbrev barycentricBigradedHomology (j n i : ℕ) :=
  Homology (K := K)
    (X := barycentricDoublePiece (P := P) K d j n (i + 1))
    (Y := barycentricDoublePiece (P := P) K d j n i)
    (Z := barycentricDoublePiece (P := P) K d j n (i - 1))
    (barycentricDoubleIncoming (P := P) K d j n i) (barycentricDoubleOutgoing (P := P) K d j n i)
    (barycentricDouble_complex (P := P) K d j n i)

/-- Reify the inherited group structure using the group data already stored
in the filtration's type, avoiding a second instance search on its carrier. -/
def filtrationLevelAddCommGroup {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (F : Filtration (K := R) M) (n : ℕ) : AddCommGroup (F.level n) :=
  Submodule.addCommGroup (F.level n)

local instance barycentricDegreeLevelAddCommGroup (j i n : ℕ) :
    AddCommGroup ((barycentricDegreeTermFiltration (P := P) K d j i).level n) :=
  filtrationLevelAddCommGroup (barycentricDegreeTermFiltration (P := P) K d j i) n

/-- Explicitly typed homogeneous grade equivalence, with the same scalar
and additive structures as the actual strand complex. -/
def barycentricInternalGradeWeightEquiv (j i n : ℕ) :
    Grade (barycentricDegreeTermFiltration (P := P) K d j i) n ≃ₗ[K]
      barycentricDoublePiece (P := P) K d j n i :=
  basisDoubleGradeEquiv (barycentricKoszulBasis (P := P) K d i) originalKoszulDegree j
    (fun a => (originalKoszulWeight d a).toNat) n

@[simp] theorem barycentricInternalGradeWeightEquiv_mk (j i n : ℕ)
    (x : (barycentricDegreeTermFiltration (P := P) K d j i).level (n + 1)) :
    barycentricInternalGradeWeightEquiv (P := P) K d j i n (Submodule.Quotient.mk x) =
      basisDoubleTopProjection (barycentricKoszulBasis (P := P) K d i) originalKoszulDegree j
        (fun a => (originalKoszulWeight d a).toNat) n x := rfl

set_option maxHeartbeats 1500000 in
def barycentricInternalGradeWeightHomology (j i n : ℕ) :
    barycentricInternalGradedHomology (P := P) K d j i n ≃ₗ[K]
      barycentricBigradedHomology (P := P) K d j n i :=
  chainHomologyEquiv (K := K)
    (gradeMap (barycentricDegreeTermFiltration (P := P) K d j (i + 1))
      (barycentricDegreeTermFiltration (P := P) K d j i)
      (complexIncoming (barycentricKoszulDegreeComplex (P := P) K d j) i)
      (barycentricDegreeIncoming_preserves K d j i) n)
    (gradeMap (barycentricDegreeTermFiltration (P := P) K d j i)
      (barycentricDegreeTermFiltration (P := P) K d j (i - 1))
      (complexOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i)
      (complexOutgoing_preserves (barycentricKoszulDegreeComplex (P := P) K d j)
        (barycentricDegreeTermFiltration (P := P) K d j)
        (barycentricDegreeIncoming_preserves K d j) i) n)
    (gradeMap_comp _ _ _ _ _ (barycentricDegreeIncoming_preserves K d j i)
      (complexOutgoing_preserves (barycentricKoszulDegreeComplex (P := P) K d j)
        (barycentricDegreeTermFiltration (P := P) K d j)
        (barycentricDegreeIncoming_preserves K d j) i)
      (complexIncomingOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i) n)
    (barycentricDoubleIncoming (P := P) K d j n i)
    (barycentricDoubleOutgoing (P := P) K d j n i)
    (barycentricDouble_complex (P := P) K d j n i)
    (barycentricInternalGradeWeightEquiv (P := P) K d j (i + 1) n)
    (barycentricInternalGradeWeightEquiv (P := P) K d j i n)
    (barycentricInternalGradeWeightEquiv (P := P) K d j (i - 1) n)
    (by
      intro x
      obtain ⟨x, rfl⟩ := (lowerInLevel (barycentricDegreeTermFiltration (P := P) K d j (i + 1)) n).mkQ_surjective x
      apply Subtype.ext
      apply Subtype.ext
      change complexIncoming (barycentricKoszulComplex (P := P) K d) i
          (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i + 1))
            (fun a => (originalKoszulWeight d a).toNat) n x.val.val) =
        FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
          (fun a => (originalKoszulWeight d a).toNat) n
          (show barycentricKoszulDegreePiece (P := P) K d i j from
            complexIncoming (barycentricKoszulDegreeComplex (P := P) K d j) i x.val).val
      have hv : (show barycentricKoszulDegreePiece (P := P) K d i j from
          complexIncoming (barycentricKoszulDegreeComplex (P := P) K d j) i x.val).val =
          complexIncoming (barycentricKoszulComplex (P := P) K d) i x.val.val := by
        simp only [complexIncoming, barycentricKoszulDegreeComplex_d,
          parameterKoszulComplex_d, ModuleCat.hom_ofHom]
        rfl
      rw [hv]
      exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
        (barycentricIncoming_weight K d i) n) x.val.val)
    (by
      intro x
      have hout : complexOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i =
          restrictedMap (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
            (barycentricKoszulDegreePiece (P := P) K d i j)
            (barycentricKoszulDegreePiece (P := P) K d (i - 1) j)
            (FourPapers.BasisGrading.map_piece _ _ _ _ _ (barycentricOutgoing_degree K d i) j) := by
        cases i with
        | zero =>
            have hB := (barycentricKoszulComplex (P := P) K d).shape 0 0 (by decide)
            have hD := (barycentricKoszulDegreeComplex (P := P) K d j).shape 0 0 (by decide)
            simp only [complexOutgoing, Nat.zero_sub, hB, hD, ModuleCat.hom_zero]
            apply LinearMap.ext
            intro y
            apply Subtype.ext
            rfl
        | succ i =>
            simp only [complexOutgoing, Nat.succ_sub_one, barycentricKoszulDegreeComplex_d,
              parameterKoszulComplex_d, ModuleCat.hom_ofHom]
            rfl
      obtain ⟨x, rfl⟩ := (lowerInLevel (barycentricDegreeTermFiltration (P := P) K d j i) n).mkQ_surjective x
      apply Subtype.ext
      apply Subtype.ext
      change complexOutgoing (barycentricKoszulComplex (P := P) K d) i
          (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
            (fun a => (originalKoszulWeight d a).toNat) n x.val.val) =
        FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i - 1))
          (fun a => (originalKoszulWeight d a).toNat) n
          (show barycentricKoszulDegreePiece (P := P) K d (i - 1) j from
            complexOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i x.val).val
      have hv := congrArg
        (fun f : barycentricKoszulDegreePiece (P := P) K d i j →ₗ[K]
          barycentricKoszulDegreePiece (P := P) K d (i - 1) j => (f x.val).val) hout
      change (show barycentricKoszulDegreePiece (P := P) K d (i - 1) j from
          complexOutgoing (barycentricKoszulDegreeComplex (P := P) K d j) i x.val).val =
        complexOutgoing (barycentricKoszulComplex (P := P) K d) i x.val.val at hv
      rw [hv]
      exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
        (barycentricOutgoing_weight K d i) n) x.val.val)

variable (hs : IsSimplicialPoset P) (hrank : ∀ p : P, faceRank p ≤ d)

/-- Full internal-degree/rank-weight comparison on the literal homology
modules, with every filtration level defined by actual bounded cycles. -/
def originalInternalAssociatedBigradedHomology (j i n : ℕ) :
    Grade (originalInternalHomologyFiltration K hs d hrank j i) n ≃ₗ[K]
      barycentricBigradedHomology (P := P) K d j n i :=
  (originalInternalAssociatedBarycentricHomology K hs d hrank j i n).trans
    (barycentricInternalGradeWeightHomology (P := P) K d j i n)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.FilteredSubcomplex -/
section

/-! # Homogeneous relative subcomplexes

A relative term is a literal submodule of a chain group.  Homogeneous
projections which preserve it give genuine cycle lifts inside that
submodule; their successive quotients are its actual weight pieces.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

/-- The actual restriction of a chain complex to preserved submodules. -/
def submoduleComplex (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (N : ∀ i, Submodule K (C.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i) :
    ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (N i))
    (fun i => ModuleCat.ofHom (restrictedMap (complexIncoming C i) _ _ (hN i))) (by
      intro i
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      exact congrArg (fun f => f x.val) (C.d_comp_d (i + 2) (i + 1) i))

@[simp] theorem submoduleComplex_d (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (N : ∀ i, Submodule K (C.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i) (i : ℕ) :
    (submoduleComplex C N hN).d (i + 1) i =
      ModuleCat.ofHom (restrictedMap (complexIncoming C i) _ _ (hN i)) := by
  simp [submoduleComplex]

def submoduleComplexInclusion (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (N : ∀ i, Submodule K (C.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i) :
    submoduleComplex C N hN ⟶ C where
  f i := ModuleCat.ofHom (N i).subtype
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [submoduleComplex_d]
    rfl

theorem submoduleComplex_outgoing_val (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (N : ∀ i, Submodule K (C.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i)
    (i : ℕ) (x : N i) :
    (complexOutgoing (submoduleComplex C N hN) i x).val = complexOutgoing C i x.val := by
  cases i with
  | zero =>
      have hC := C.shape 0 0 (by decide)
      have hN' := (submoduleComplex C N hN).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hC, hN', ModuleCat.hom_zero, LinearMap.zero_apply,
        Submodule.coe_zero]
  | succ i =>
      simp only [complexOutgoing, Nat.succ_sub_one, submoduleComplex_d]
      rfl

theorem submoduleComplex_outgoing_mem (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (N : ∀ i, Submodule K (C.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i)
    (i : ℕ) (x : C.X i) (hx : x ∈ N i) : complexOutgoing C i x ∈ N (i - 1) := by
  rw [← submoduleComplex_outgoing_val C N hN i ⟨x, hx⟩]
  exact (complexOutgoing (submoduleComplex C N hN) i ⟨x, hx⟩).property

theorem submoduleComplex_outgoing_eq (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (N : ∀ i, Submodule K (C.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i) (i : ℕ) :
    complexOutgoing (submoduleComplex C N hN) i =
      restrictedMap (complexOutgoing C i) (N i) (N (i - 1)) (submoduleComplex_outgoing_mem C N hN i) := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact submoduleComplex_outgoing_val C N hN i x

section BasisRestriction
variable {I J X Y : Type*} [AddCommGroup X] [Module K X]
  [AddCommGroup Y] [Module K Y]

/-- Homogeneous cycle lifting remains valid in every subcomplex preserved
by the genuine coefficient projections. -/
theorem basisRestricted_liftsCycles
    (b : Module.Basis I K X) (c : Module.Basis J K Y) (w : I → ℕ) (v : J → ℕ)
    (f : X →ₗ[K] Y) (hf : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i))
    (N : Submodule K X) (M : Submodule K Y)
    (hNM : ∀ x, x ∈ N → f x ∈ M)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N)
    (hq : ∀ n y, y ∈ M → FourPapers.BasisGrading.projection c v n y ∈ M) :
    LiftsCycles (submoduleFiltration (basisFiltration b w) N)
      (submoduleFiltration (basisFiltration c v) M) (restrictedMap f N M hNM) := by
  intro n x hx hfx
  refine ⟨⟨FourPapers.BasisGrading.projection b w n x.val, hp n x.val x.property⟩,
    basisProjection_level b w n x.val, ?_, ?_⟩
  · apply Subtype.ext
    exact (LinearMap.congr_fun (basisProjection_commutes b c w v f hf n) x.val).trans
      (basisProjection_lower_zero c v n (f x.val) hfx)
  · exact basisProjection_error_lower b w n x.val hx

def basisRestrictedWeightPiece (b : Module.Basis I K X) (w : I → ℕ)
    (N : Submodule K X) (n : ℕ) : Submodule K N :=
  (FourPapers.BasisGrading.Piece b w n).comap N.subtype

def basisRestrictedTopProjection (b : Module.Basis I K X) (w : I → ℕ)
    (N : Submodule K X)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N) (n : ℕ) :
    (submoduleFiltration (basisFiltration b w) N).level (n + 1) →ₗ[K]
      basisRestrictedWeightPiece b w N n :=
  ((restrictedMap (FourPapers.BasisGrading.projection b w n) N N (hp n)).domRestrict _).codRestrict _
    (fun x => FourPapers.BasisGrading.projection_mem b w n x.val.val)

theorem basisRestrictedTopProjection_ker (b : Module.Basis I K X) (w : I → ℕ)
    (N : Submodule K X)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N) (n : ℕ) :
    LinearMap.ker (basisRestrictedTopProjection b w N hp n) =
      lowerInLevel (submoduleFiltration (basisFiltration b w) N) n := by
  ext x
  constructor
  · intro h
    have hz : FourPapers.BasisGrading.projection b w n x.val.val = 0 :=
      congrArg (fun y : basisRestrictedWeightPiece b w N n => y.val.val) h
    change x.val.val ∈ (basisFiltration b w).level n
    simpa only [hz, sub_zero] using basisProjection_error_lower b w n x.val.val x.property
  · intro h
    apply Subtype.ext
    apply Subtype.ext
    exact basisProjection_lower_zero b w n x.val.val h

theorem basisRestrictedTopProjection_surjective (b : Module.Basis I K X) (w : I → ℕ)
    (N : Submodule K X)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N) (n : ℕ) :
    Function.Surjective (basisRestrictedTopProjection b w N hp n) := by
  intro y
  have hy : y.val.val ∈ (basisFiltration b w).level (n + 1) := by
    have h := basisProjection_level b w n y.val.val
    have hself : FourPapers.BasisGrading.projection b w n y.val.val = y.val.val :=
      FourPapers.BasisGrading.projection_eq_self
        (show y.val.val ∈ FourPapers.BasisGrading.Piece b w n from y.property)
    rwa [hself] at h
  refine ⟨⟨y.val, hy⟩, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self y.property

def basisRestrictedGradeEquiv (b : Module.Basis I K X) (w : I → ℕ)
    (N : Submodule K X)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N) (n : ℕ) :
    Grade (submoduleFiltration (basisFiltration b w) N) n ≃ₗ[K]
      basisRestrictedWeightPiece b w N n :=
  (Submodule.quotEquivOfEq _ _ (basisRestrictedTopProjection_ker b w N hp n).symm).trans
    ((basisRestrictedTopProjection b w N hp n).quotKerEquivOfSurjective
      (basisRestrictedTopProjection_surjective b w N hp n))

@[simp] theorem basisRestrictedGradeEquiv_mk (b : Module.Basis I K X) (w : I → ℕ)
    (N : Submodule K X)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N) (n : ℕ)
    (x : (submoduleFiltration (basisFiltration b w) N).level (n + 1)) :
    basisRestrictedGradeEquiv b w N hp n (Submodule.Quotient.mk x) =
      basisRestrictedTopProjection b w N hp n x := rfl

def basisRestrictedWeightMap
    (b : Module.Basis I K X) (c : Module.Basis J K Y) (w : I → ℕ) (v : J → ℕ)
    (f : X →ₗ[K] Y) (hf : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i))
    (N : Submodule K X) (M : Submodule K Y) (hNM : ∀ x, x ∈ N → f x ∈ M) (n : ℕ) :
    basisRestrictedWeightPiece b w N n →ₗ[K] basisRestrictedWeightPiece c v M n :=
  restrictedMap (restrictedMap f N M hNM) _ _
    (fun x hx => FourPapers.BasisGrading.map_piece b c w v f hf n x.val hx)

theorem basisRestrictedGradeEquiv_differential
    (b : Module.Basis I K X) (c : Module.Basis J K Y) (w : I → ℕ) (v : J → ℕ)
    (f : X →ₗ[K] Y) (hf : ∀ i, f (b i) ∈ FourPapers.BasisGrading.Piece c v (w i))
    (N : Submodule K X) (M : Submodule K Y) (hNM : ∀ x, x ∈ N → f x ∈ M)
    (hp : ∀ n x, x ∈ N → FourPapers.BasisGrading.projection b w n x ∈ N)
    (hq : ∀ n y, y ∈ M → FourPapers.BasisGrading.projection c v n y ∈ M)
    (n : ℕ) (x : Grade (submoduleFiltration (basisFiltration b w) N) n) :
    basisRestrictedWeightMap b c w v f hf N M hNM n (basisRestrictedGradeEquiv b w N hp n x) =
      basisRestrictedGradeEquiv c v M hq n
        (gradeMap _ _ (restrictedMap f N M hNM)
          (restrictedMap_preserves _ _ f (basisHomogeneous_preserves b c w v f hf) N M hNM) n x) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel (submoduleFiltration (basisFiltration b w) N) n).mkQ_surjective x
  apply Subtype.ext
  apply Subtype.ext
  exact LinearMap.congr_fun (basisProjection_commutes b c w v f hf n) x.val.val

end BasisRestriction
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.FilteredComplex -/
section

/-! # Intrinsic filtrations on the homology of chain complexes -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

def complexHomologyFiltration (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (F : ∀ i, Filtration (K := K) (C.X i)) (i : ℕ) :=
  homologyFiltration (F i) (complexIncoming C i) (complexOutgoing C i) (complexIncomingOutgoing C i)

abbrev complexGradedHomology (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (F : ∀ i, Filtration (K := K) (C.X i))
    (hf : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i)) (i n : ℕ) :=
  GradedHomology (F (i + 1)) (F i) (F (i - 1)) (complexIncoming C i) (complexOutgoing C i)
    (hf i) (complexOutgoing_preserves C F hf i) (complexIncomingOutgoing C i) n

def complexAssociatedHomologyEquiv (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (F : ∀ i, Filtration (K := K) (C.X i))
    (hf : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hl : ∀ i, LiftsCycles (F (i + 1)) (F i) (complexIncoming C i)) (i n : ℕ) :
    Grade (complexHomologyFiltration C F i) n ≃ₗ[K] complexGradedHomology C F hf i n :=
  associatedHomologyEquiv _ _ _ _ _ (hf i) (complexOutgoing_preserves C F hf i)
    (complexIncomingOutgoing C i) n (hl i) (complexOutgoing_liftsCycles C F hl i)

def complexIsoLinearEquiv {C D : ChainComplex (ModuleCat.{u} K) ℕ} (e : C ≅ D) (i : ℕ) :
    C.X i ≃ₗ[K] D.X i := (HomologicalComplex.Hom.isoApp e i).toLinearEquiv

theorem complexIso_commutes {C D : ChainComplex (ModuleCat.{u} K) ℕ} (e : C ≅ D)
    (i j : ℕ) (x : C.X i) :
    D.d i j (complexIsoLinearEquiv e i x) = complexIsoLinearEquiv e j (C.d i j x) :=
  congrArg (fun f : C.X i ⟶ D.X j => f x) (e.hom.comm i j)

def complexGradedHomologyEquiv {C D : ChainComplex (ModuleCat.{u} K) ℕ}
    (F : ∀ i, Filtration (K := K) (C.X i)) (G : ∀ i, Filtration (K := K) (D.X i))
    (hf : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hg : ∀ i, Preserves (G (i + 1)) (G i) (complexIncoming D i))
    (e : C ≅ D)
    (he : ∀ i n x, complexIsoLinearEquiv e i x ∈ (G i).level n ↔ x ∈ (F i).level n)
    (i n : ℕ) : complexGradedHomology C F hf i n ≃ₗ[K] complexGradedHomology D G hg i n :=
  chainHomologyEquiv _ _ _ _ _ _
    (gradeEquiv _ _ (complexIsoLinearEquiv e (i + 1)) (he (i + 1)) n)
    (gradeEquiv _ _ (complexIsoLinearEquiv e i) (he i) n)
    (gradeEquiv _ _ (complexIsoLinearEquiv e (i - 1)) (he (i - 1)) n)
    (gradeEquiv_commutes _ _ _ _ _ _ _ _ _ _ (he (i + 1)) (he i)
      (complexIso_commutes e (i + 1) i) n)
    (gradeEquiv_commutes _ _ _ _ _ _ _ _ _ _ (he i) (he (i - 1))
      (complexIso_commutes e i (i - 1)) n)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeKoszulFiltration -/
section

/-! # The actual restriction kernels in the original Koszul complexes

Every term consists of finitely supported exterior coordinates whose
coefficients lie in the usual restriction ideal.  The construction accepts
all downward closed subsets, including the empty one.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
section ParameterGenerality
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]

def idealCoefficientSubmodule (S : Type*) (I : Ideal B) : Submodule K (S →₀ B) where
  carrier := {x | ∀ s, x s ∈ I}
  zero_mem' := fun _ => I.zero_mem
  add_mem' := fun hx hy s => I.add_mem (hx s) (hy s)
  smul_mem' := fun k x hx s => I.smul_of_tower_mem k (hx s)

@[simp] theorem mem_idealCoefficientSubmodule (S : Type*) (I : Ideal B) (x : S →₀ B) :
    x ∈ idealCoefficientSubmodule (K := K) S I ↔ ∀ s, x s ∈ I := Iff.rfl

theorem single_mem_idealCoefficientSubmodule (S : Type*) (I : Ideal B) (s : S) (b : B)
    (hb : b ∈ I) : Finsupp.single s b ∈ idealCoefficientSubmodule (K := K) S I := by
  intro t
  by_cases h : s = t
  · simpa only [Finsupp.single_apply, if_pos h] using hb
  · simpa only [Finsupp.single_apply, if_neg h] using I.zero_mem

variable [Fintype C] [LinearOrder C]

theorem parameterKoszulDifferential_ideal (γ : C → B) (I : Ideal B) (i : ℕ)
    (x : Set.powersetCard C (i + 1) →₀ B)
    (hx : x ∈ idealCoefficientSubmodule (K := K) _ I) :
    parameterKoszulDifferential (K := K) γ i x ∈ idealCoefficientSubmodule (K := K) _ I := by
  rw [← Finsupp.sum_single x, Finsupp.sum, map_sum]
  apply (idealCoefficientSubmodule (K := K) _ I).sum_mem
  intro s hs
  rw [parameterKoszulDifferential_single]
  apply (idealCoefficientSubmodule (K := K) _ I).sum_mem
  intro j hj
  apply single_mem_idealCoefficientSubmodule
  exact I.mul_mem_left _ (I.smul_of_tower_mem _ (hx s))

end ParameterGenerality

section Original
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def originalRelativeKoszulTerm (i : ℕ) : Submodule K ((originalKoszulComplex K hs d).X i) :=
  idealCoefficientSubmodule _ (faceRestrictionIdeal K hs Q)

def barycentricRelativeKoszulTerm (i : ℕ) : Submodule K ((barycentricKoszulComplex (P := P) K d).X i) :=
  idealCoefficientSubmodule _ (barycentricRestrictionIdeal K Q)

theorem originalRelativeKoszulTerm_preserved (i : ℕ) (x : (originalKoszulComplex K hs d).X (i + 1))
    (hx : x ∈ originalRelativeKoszulTerm K hs d Q (i + 1)) :
    complexIncoming (originalKoszulComplex K hs d) i x ∈ originalRelativeKoszulTerm K hs d Q i := by
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change parameterKoszulDifferential (K := K) (fun r : Fin d => faceRankParameter K hs (r.val + 1)) i x ∈
    idealCoefficientSubmodule (K := K) _ (faceRestrictionIdeal K hs Q)
  exact parameterKoszulDifferential_ideal (K := K) (fun r : Fin d => faceRankParameter K hs (r.val + 1))
    (faceRestrictionIdeal K hs Q) i x hx

theorem barycentricRelativeKoszulTerm_preserved (i : ℕ) (x : (barycentricKoszulComplex (P := P) K d).X (i + 1))
    (hx : x ∈ barycentricRelativeKoszulTerm (P := P) K d Q (i + 1)) :
    complexIncoming (barycentricKoszulComplex (P := P) K d) i x ∈ barycentricRelativeKoszulTerm (P := P) K d Q i := by
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change parameterKoszulDifferential (K := K)
    (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i x ∈
      idealCoefficientSubmodule (K := K) _ (barycentricRestrictionIdeal K Q)
  exact parameterKoszulDifferential_ideal (K := K)
    (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1))
      (barycentricRestrictionIdeal K Q) i x hx

def originalRelativeKoszulComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  submoduleComplex (originalKoszulComplex K hs d) (originalRelativeKoszulTerm K hs d Q)
    (originalRelativeKoszulTerm_preserved K hs d Q)

def barycentricRelativeKoszulComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  submoduleComplex (barycentricKoszulComplex (P := P) K d) (barycentricRelativeKoszulTerm (P := P) K d Q)
    (barycentricRelativeKoszulTerm_preserved K d Q)

def originalRelativeTermFiltration (i : ℕ) :=
  submoduleFiltration (originalKoszulFiltration K hs d i) (originalRelativeKoszulTerm K hs d Q i)

def barycentricRelativeTermFiltration (i : ℕ) :=
  submoduleFiltration (barycentricKoszulFiltration (P := P) K d i) (barycentricRelativeKoszulTerm (P := P) K d Q i)

include hs hQ in
theorem barycentricRelativeKoszulTerm_coefficient (i : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i) :
    x ∈ barycentricRelativeKoszulTerm (P := P) K d Q i ↔
      ∀ a : OriginalKoszulIndex P d i, standardCarrier a.2 ∈ Q →
        (barycentricKoszulBasis (P := P) K d i).repr x a = 0 := by
  change Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K at x
  constructor
  · intro hx a ha
    exact (barycentricRestrictionIdeal_mem_iff_coefficient K hs Q hQ (x a.1)).mp (hx a.1) a.2 ha
  · intro hx s
    apply (barycentricRestrictionIdeal_mem_iff_coefficient K hs Q hQ (x s)).mpr
    exact fun a ha => hx ⟨s, a⟩ ha

include hs hQ in
/-- The relative ideal is preserved by every basis degree projection. -/
theorem barycentricProjection_relative {A : Type*} (i : ℕ) (degree : OriginalKoszulIndex P d i → A)
    (a : A) (x : (barycentricKoszulComplex (P := P) K d).X i)
    (hx : x ∈ barycentricRelativeKoszulTerm (P := P) K d Q i) :
    FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i) degree a x ∈
      barycentricRelativeKoszulTerm (P := P) K d Q i := by
  rw [barycentricRelativeKoszulTerm_coefficient K hs d Q hQ] at hx ⊢
  intro b hb
  simp only [FourPapers.BasisGrading.projection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, FourPapers.BasisGrading.filterMap_apply, Finsupp.filter_apply]
  split_ifs
  · exact hx b hb
  · rfl

variable (hrank : ∀ p : P, faceRank p ≤ d)

include hQ in
theorem originalKoszulCoefficientEquiv_relative (i : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i) :
    originalKoszulCoefficientEquiv K hs d hrank i x ∈ originalRelativeKoszulTerm K hs d Q i ↔
      x ∈ barycentricRelativeKoszulTerm (P := P) K d Q i := by
  change Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K at x
  constructor
  · intro hx s
    exact Ideal.Quotient.eq_zero_iff_mem.mp
      ((universalOriginalParameterComparison_restrictionKernel K hs d hrank Q hQ (x s)).mp
        (Ideal.Quotient.eq_zero_iff_mem.mpr (hx s)))
  · intro hx s
    exact Ideal.Quotient.eq_zero_iff_mem.mp
      ((universalOriginalParameterComparison_restrictionKernel K hs d hrank Q hQ (x s)).mpr
        (Ideal.Quotient.eq_zero_iff_mem.mpr (hx s)))

def relativeKoszulCoefficientEquiv (i : ℕ) :
    barycentricRelativeKoszulTerm (P := P) K d Q i ≃ₗ[K] originalRelativeKoszulTerm K hs d Q i where
  toFun x := ⟨originalKoszulCoefficientEquiv K hs d hrank i x.val,
    (originalKoszulCoefficientEquiv_relative K hs d Q hQ hrank i x.val).mpr x.property⟩
  invFun y := ⟨(originalKoszulCoefficientEquiv K hs d hrank i).symm y.val,
    (originalKoszulCoefficientEquiv_relative K hs d Q hQ hrank i _).mp
      (by simpa only [LinearEquiv.apply_symm_apply] using y.property)⟩
  left_inv x := Subtype.ext ((originalKoszulCoefficientEquiv K hs d hrank i).symm_apply_apply x.val)
  right_inv y := Subtype.ext ((originalKoszulCoefficientEquiv K hs d hrank i).apply_symm_apply y.val)
  map_add' x y := Subtype.ext (map_add _ x.val y.val)
  map_smul' a x := Subtype.ext (map_smul _ a x.val)

theorem relativeKoszulCoefficientEquiv_filtered (i n : ℕ)
    (x : barycentricRelativeKoszulTerm (P := P) K d Q i) :
    relativeKoszulCoefficientEquiv K hs d Q hQ hrank i x ∈ (originalRelativeTermFiltration K hs d Q i).level n ↔
      x ∈ (barycentricRelativeTermFiltration (P := P) K d Q i).level n :=
  originalKoszulCoefficientEquiv_filtered K hs d hrank i n x.val

theorem relativeKoszulCoefficientEquiv_incoming (i : ℕ)
    (x : barycentricRelativeKoszulTerm (P := P) K d Q (i + 1)) :
    complexIncoming (originalRelativeKoszulComplex K hs d Q) i
      (relativeKoszulCoefficientEquiv K hs d Q hQ hrank (i + 1) x) =
      relativeKoszulCoefficientEquiv K hs d Q hQ hrank i
        (complexIncoming (barycentricRelativeKoszulComplex (P := P) K d Q) i x) := by
  simp only [complexIncoming, originalRelativeKoszulComplex, barycentricRelativeKoszulComplex,
    submoduleComplex_d, ModuleCat.hom_ofHom]
  apply Subtype.ext
  change complexIncoming (originalKoszulComplex K hs d) i
      (originalKoszulCoefficientEquiv K hs d hrank (i + 1) x.val) =
    originalKoszulCoefficientEquiv K hs d hrank i
      (complexIncoming (barycentricKoszulComplex (P := P) K d) i x.val)
  exact coefficientEquiv_incoming_commutes K hs d hrank i x.val

theorem barycentricRelativeIncoming_preserves (i : ℕ) :
    Preserves (barycentricRelativeTermFiltration (P := P) K d Q (i + 1))
      (barycentricRelativeTermFiltration (P := P) K d Q i)
      (complexIncoming (barycentricRelativeKoszulComplex (P := P) K d Q) i) := by
  simpa only [complexIncoming, barycentricRelativeKoszulComplex, submoduleComplex_d, ModuleCat.hom_ofHom,
    barycentricRelativeTermFiltration, barycentricKoszulFiltration] using
    restrictedMap_preserves _ _ _ (barycentricIncoming_preserves K d i) _ _
      (barycentricRelativeKoszulTerm_preserved K d Q i)

include hs hQ in
theorem barycentricRelativeIncoming_liftsCycles (i : ℕ) :
    LiftsCycles (barycentricRelativeTermFiltration (P := P) K d Q (i + 1))
      (barycentricRelativeTermFiltration (P := P) K d Q i)
      (complexIncoming (barycentricRelativeKoszulComplex (P := P) K d Q) i) := by
  simpa only [complexIncoming, barycentricRelativeKoszulComplex, submoduleComplex_d, ModuleCat.hom_ofHom,
    barycentricRelativeTermFiltration, barycentricKoszulFiltration] using
    basisRestricted_liftsCycles (barycentricKoszulBasis (P := P) K d (i + 1))
      (barycentricKoszulBasis (P := P) K d i) _ _
      (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
      (barycentricIncoming_weight K d i) _ _ (barycentricRelativeKoszulTerm_preserved K d Q i)
      (fun n x hx => barycentricProjection_relative K hs d Q hQ (i + 1) _ n x hx)
      (fun n x hx => barycentricProjection_relative K hs d Q hQ i _ n x hx)

include hrank in
theorem originalRelativeIncoming_preserves (i : ℕ) :
    Preserves (originalRelativeTermFiltration K hs d Q (i + 1)) (originalRelativeTermFiltration K hs d Q i)
      (complexIncoming (originalRelativeKoszulComplex K hs d Q) i) := by
  simpa only [complexIncoming, originalRelativeKoszulComplex, submoduleComplex_d, ModuleCat.hom_ofHom,
    originalRelativeTermFiltration] using
    restrictedMap_preserves _ _ _ (originalIncoming_preserves K hs d hrank i) _ _
      (originalRelativeKoszulTerm_preserved K hs d Q i)

include hQ hrank in
theorem originalRelativeIncoming_liftsCycles (i : ℕ) :
    LiftsCycles (originalRelativeTermFiltration K hs d Q (i + 1)) (originalRelativeTermFiltration K hs d Q i)
      (complexIncoming (originalRelativeKoszulComplex K hs d Q) i) :=
  liftsCycles_of_filteredEquiv _ _ _ _ _ _
    (relativeKoszulCoefficientEquiv K hs d Q hQ hrank (i + 1))
    (relativeKoszulCoefficientEquiv K hs d Q hQ hrank i)
    (relativeKoszulCoefficientEquiv_filtered K hs d Q hQ hrank (i + 1))
    (relativeKoszulCoefficientEquiv_filtered K hs d Q hQ hrank i)
    (relativeKoszulCoefficientEquiv_incoming K hs d Q hQ hrank i)
    (barycentricRelativeIncoming_liftsCycles K hs d Q hQ i)

end Original
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeInternalFiltration -/
section

/-! # Finite intrinsic relative filtrations in every internal degree

The relative chain group is the intersection of the actual restriction
kernel with the actual ordinary-degree submodule.  The filtration comes
from bounded-weight cycles in this intersection.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

def originalRelativeDegreeTerm (j i : ℕ) : Submodule K ((originalKoszulComplex K hs d).X i) :=
  originalRelativeKoszulTerm K hs d Q i ⊓ originalKoszulDegreePiece K hs d i j

def barycentricRelativeDegreeTerm (j i : ℕ) : Submodule K ((barycentricKoszulComplex (P := P) K d).X i) :=
  barycentricRelativeKoszulTerm (P := P) K d Q i ⊓ barycentricKoszulDegreePiece (P := P) K d i j

include hrank in
theorem originalRelativeDegreeTerm_preserved (j i : ℕ) (x : (originalKoszulComplex K hs d).X (i + 1))
    (hx : x ∈ originalRelativeDegreeTerm K hs d Q j (i + 1)) :
    complexIncoming (originalKoszulComplex K hs d) i x ∈ originalRelativeDegreeTerm K hs d Q j i := by
  refine ⟨originalRelativeKoszulTerm_preserved K hs d Q i x hx.1, ?_⟩
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change originalKoszulDifferential K hs d i x ∈ originalKoszulDegreePiece K hs d i j
  exact originalKoszulDifferential_degree K hs d hrank i j x hx.2

theorem barycentricRelativeDegreeTerm_preserved (j i : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X (i + 1))
    (hx : x ∈ barycentricRelativeDegreeTerm (P := P) K d Q j (i + 1)) :
    complexIncoming (barycentricKoszulComplex (P := P) K d) i x ∈
      barycentricRelativeDegreeTerm (P := P) K d Q j i :=
  ⟨barycentricRelativeKoszulTerm_preserved K d Q i x hx.1,
    FourPapers.BasisGrading.map_piece _ _ _ _ _ (barycentricIncoming_degree K d i) j x hx.2⟩

def originalRelativeDegreeComplex (j : ℕ) : ChainComplex (ModuleCat.{u} K) ℕ :=
  submoduleComplex (originalKoszulComplex K hs d) (originalRelativeDegreeTerm K hs d Q j)
    (originalRelativeDegreeTerm_preserved K hs d Q hrank j)

def barycentricRelativeDegreeComplex (j : ℕ) : ChainComplex (ModuleCat.{u} K) ℕ :=
  submoduleComplex (barycentricKoszulComplex (P := P) K d) (barycentricRelativeDegreeTerm (P := P) K d Q j)
    (barycentricRelativeDegreeTerm_preserved K d Q j)

def originalRelativeDegreeFiltration (j i : ℕ) :=
  submoduleFiltration (originalKoszulFiltration K hs d i) (originalRelativeDegreeTerm K hs d Q j i)

def barycentricRelativeDegreeFiltration (j i : ℕ) :=
  submoduleFiltration (barycentricKoszulFiltration (P := P) K d i) (barycentricRelativeDegreeTerm (P := P) K d Q j i)

include hs hQ in
theorem barycentricWeightProjection_relativeDegree (j i n : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i)
    (hx : x ∈ barycentricRelativeDegreeTerm (P := P) K d Q j i) :
    FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
      (fun a => (originalKoszulWeight d a).toNat) n x ∈
      barycentricRelativeDegreeTerm (P := P) K d Q j i :=
  ⟨barycentricProjection_relative K hs d Q hQ i _ n x hx.1,
    FourPapers.BasisGrading.projection_mem_piece _ _ _ n j x hx.2⟩

include hQ in
theorem originalKoszulCoefficientEquiv_relativeDegree (j i : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i) :
    originalKoszulCoefficientEquiv K hs d hrank i x ∈ originalRelativeDegreeTerm K hs d Q j i ↔
      x ∈ barycentricRelativeDegreeTerm (P := P) K d Q j i :=
  and_congr (originalKoszulCoefficientEquiv_relative K hs d Q hQ hrank i x)
    (originalKoszulCoefficientEquiv_degree K hs d hrank i j x)

def relativeInternalCoefficientEquiv (j i : ℕ) :
    barycentricRelativeDegreeTerm (P := P) K d Q j i ≃ₗ[K] originalRelativeDegreeTerm K hs d Q j i where
  toFun x := ⟨originalKoszulCoefficientEquiv K hs d hrank i x.val,
    (originalKoszulCoefficientEquiv_relativeDegree K hs d Q hQ hrank j i x.val).mpr x.property⟩
  invFun y := ⟨(originalKoszulCoefficientEquiv K hs d hrank i).symm y.val,
    (originalKoszulCoefficientEquiv_relativeDegree K hs d Q hQ hrank j i _).mp
      (by simpa only [LinearEquiv.apply_symm_apply] using y.property)⟩
  left_inv x := Subtype.ext ((originalKoszulCoefficientEquiv K hs d hrank i).symm_apply_apply x.val)
  right_inv y := Subtype.ext ((originalKoszulCoefficientEquiv K hs d hrank i).apply_symm_apply y.val)
  map_add' x y := Subtype.ext (map_add _ x.val y.val)
  map_smul' a x := Subtype.ext (map_smul _ a x.val)

theorem relativeInternalCoefficientEquiv_filtered (j i n : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j i) :
    relativeInternalCoefficientEquiv K hs d Q hQ hrank j i x ∈
        (originalRelativeDegreeFiltration K hs d Q j i).level n ↔
      x ∈ (barycentricRelativeDegreeFiltration (P := P) K d Q j i).level n :=
  originalKoszulCoefficientEquiv_filtered K hs d hrank i n x.val

theorem relativeInternalCoefficientEquiv_incoming (j i : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j (i + 1)) :
    complexIncoming (originalRelativeDegreeComplex K hs d Q hrank j) i
      (relativeInternalCoefficientEquiv K hs d Q hQ hrank j (i + 1) x) =
      relativeInternalCoefficientEquiv K hs d Q hQ hrank j i
        (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i x) := by
  simp only [complexIncoming, originalRelativeDegreeComplex, barycentricRelativeDegreeComplex,
    submoduleComplex_d, ModuleCat.hom_ofHom]
  apply Subtype.ext
  change complexIncoming (originalKoszulComplex K hs d) i
      (originalKoszulCoefficientEquiv K hs d hrank (i + 1) x.val) =
    originalKoszulCoefficientEquiv K hs d hrank i
      (complexIncoming (barycentricKoszulComplex (P := P) K d) i x.val)
  exact coefficientEquiv_incoming_commutes K hs d hrank i x.val

def relativeInternalKoszulComparison (j : ℕ) :
    barycentricRelativeDegreeComplex (P := P) K d Q j ≅ originalRelativeDegreeComplex K hs d Q hrank j :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i).toModuleIso) (by
      intro i k hik
      obtain rfl : i = k + 1 := hik.symm
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      exact relativeInternalCoefficientEquiv_incoming K hs d Q hQ hrank j k x)

theorem barycentricRelativeDegreeIncoming_preserves (j i : ℕ) :
    Preserves (barycentricRelativeDegreeFiltration (P := P) K d Q j (i + 1))
      (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
      (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i) := by
  simpa only [complexIncoming, barycentricRelativeDegreeComplex, submoduleComplex_d, ModuleCat.hom_ofHom,
    barycentricRelativeDegreeFiltration, barycentricKoszulFiltration] using
    restrictedMap_preserves _ _ _ (barycentricIncoming_preserves K d i) _ _
      (barycentricRelativeDegreeTerm_preserved K d Q j i)

theorem originalRelativeDegreeIncoming_preserves (j i : ℕ) :
    Preserves (originalRelativeDegreeFiltration K hs d Q j (i + 1))
      (originalRelativeDegreeFiltration K hs d Q j i)
      (complexIncoming (originalRelativeDegreeComplex K hs d Q hrank j) i) := by
  simpa only [complexIncoming, originalRelativeDegreeComplex, submoduleComplex_d, ModuleCat.hom_ofHom,
    originalRelativeDegreeFiltration] using
    restrictedMap_preserves _ _ _ (originalIncoming_preserves K hs d hrank i) _ _
      (originalRelativeDegreeTerm_preserved K hs d Q hrank j i)

include hs hQ in
theorem barycentricRelativeDegreeIncoming_liftsCycles (j i : ℕ) :
    LiftsCycles (barycentricRelativeDegreeFiltration (P := P) K d Q j (i + 1))
      (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
      (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i) := by
  simpa only [complexIncoming, barycentricRelativeDegreeComplex, submoduleComplex_d, ModuleCat.hom_ofHom,
    barycentricRelativeDegreeFiltration, barycentricKoszulFiltration] using
    basisRestricted_liftsCycles (barycentricKoszulBasis (P := P) K d (i + 1))
      (barycentricKoszulBasis (P := P) K d i) _ _
      (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
      (barycentricIncoming_weight K d i) _ _ (barycentricRelativeDegreeTerm_preserved K d Q j i)
      (barycentricWeightProjection_relativeDegree K hs d Q hQ j (i + 1))
      (barycentricWeightProjection_relativeDegree K hs d Q hQ j i)

include hQ in
theorem originalRelativeDegreeIncoming_liftsCycles (j i : ℕ) :
    LiftsCycles (originalRelativeDegreeFiltration K hs d Q j (i + 1))
      (originalRelativeDegreeFiltration K hs d Q j i)
      (complexIncoming (originalRelativeDegreeComplex K hs d Q hrank j) i) :=
  liftsCycles_of_filteredEquiv _ _ _ _ _ _
    (relativeInternalCoefficientEquiv K hs d Q hQ hrank j (i + 1))
    (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i)
    (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j (i + 1))
    (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j i)
    (relativeInternalCoefficientEquiv_incoming K hs d Q hQ hrank j i)
    (barycentricRelativeDegreeIncoming_liftsCycles K hs d Q hQ j i)

abbrev originalRelativeInternalHomology (j i : ℕ) :=
  complexKernelHomology (originalRelativeDegreeComplex K hs d Q hrank j) i

def originalRelativeInternalHomologyFiltration (j i : ℕ) :=
  complexHomologyFiltration (originalRelativeDegreeComplex K hs d Q hrank j)
    (originalRelativeDegreeFiltration K hs d Q j) i

/-- The literal filtration in internal degree `j` has the uniform finite
bound `2*d*j+1`, also for the empty relative subposet. -/
theorem originalRelativeInternalHomologyFiltration_finite (j i : ℕ) :
    (originalRelativeInternalHomologyFiltration K hs d Q hrank j i).level (2 * d * j + 1) = ⊤ := by
  apply homologyFiltration_top
  apply submoduleFiltration_top
  intro x hx
  exact originalKoszulDegreePiece_finite K hs d i j x hx.2

def relativeInternalAssociatedGradedComparison (j i n : ℕ) :
    Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) n ≃ₗ[K]
      complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d Q j)
        (barycentricRelativeDegreeFiltration (P := P) K d Q j)
        (barycentricRelativeDegreeIncoming_preserves K d Q j) i n :=
  (complexAssociatedHomologyEquiv (originalRelativeDegreeComplex K hs d Q hrank j)
    (originalRelativeDegreeFiltration K hs d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (originalRelativeDegreeIncoming_liftsCycles K hs d Q hQ hrank j) i n).trans
      (complexGradedHomologyEquiv _ _
        (barycentricRelativeDegreeIncoming_preserves K d Q j)
        (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
        (relativeInternalKoszulComparison K hs d Q hQ hrank j)
        (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j) i n).symm

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeBigradedHomology -/
section

/-! # Relative barycentric strands and the finite filtration comparison -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (d : ℕ) (Q : Set P)

def barycentricRelativeBigradedTerm (j n i : ℕ) :=
  basisRestrictedWeightPiece (barycentricKoszulBasis (P := P) K d i)
    (fun a => (originalKoszulWeight d a).toNat) (barycentricRelativeDegreeTerm (P := P) K d Q j i) n

def barycentricRelativeBigradedIncoming (j n i : ℕ) :
    barycentricRelativeBigradedTerm (P := P) K d Q j n (i + 1) →ₗ[K]
      barycentricRelativeBigradedTerm (P := P) K d Q j n i :=
  basisRestrictedWeightMap _ _ _ _ (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
    (barycentricIncoming_weight K d i) _ _ (barycentricRelativeDegreeTerm_preserved K d Q j i) n

def barycentricRelativeBigradedOutgoing (j n i : ℕ) :
    barycentricRelativeBigradedTerm (P := P) K d Q j n i →ₗ[K]
      barycentricRelativeBigradedTerm (P := P) K d Q j n (i - 1) :=
  basisRestrictedWeightMap _ _ _ _ (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
    (barycentricOutgoing_weight K d i) _ _
    (submoduleComplex_outgoing_mem _ _ (barycentricRelativeDegreeTerm_preserved K d Q j) i) n

theorem barycentricRelativeBigraded_complex (j n i : ℕ) :
    (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i).comp
      (barycentricRelativeBigradedIncoming (P := P) K d Q j n i) = 0 := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Subtype.ext
  exact LinearMap.congr_fun (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) i) x.val.val

abbrev barycentricRelativeBigradedHomology (j n i : ℕ) :=
  Homology (barycentricRelativeBigradedIncoming (P := P) K d Q j n i)
    (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i)
    (barycentricRelativeBigraded_complex (P := P) K d Q j n i)

variable (hs : IsSimplicialPoset P)
variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def barycentricRelativeGradeWeightEquiv (j i n : ℕ) :
    Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n ≃ₗ[K]
      barycentricRelativeBigradedTerm (P := P) K d Q j n i :=
  basisRestrictedGradeEquiv (barycentricKoszulBasis (P := P) K d i)
    (fun a => (originalKoszulWeight d a).toNat) (barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (barycentricWeightProjection_relativeDegree K hs d Q hQ j i) n

def barycentricRelativeGradeWeightHomology (j i n : ℕ) :
    complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d Q j)
      (barycentricRelativeDegreeFiltration (P := P) K d Q j)
      (barycentricRelativeDegreeIncoming_preserves K d Q j) i n ≃ₗ[K]
        barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
  chainHomologyEquiv _ _ _ _ _ _
    (barycentricRelativeGradeWeightEquiv K d Q hs hQ j (i + 1) n)
    (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n)
    (barycentricRelativeGradeWeightEquiv K d Q hs hQ j (i - 1) n)
    (by
      intro x
      obtain ⟨x, rfl⟩ := (lowerInLevel (barycentricRelativeDegreeFiltration (P := P) K d Q j (i + 1)) n).mkQ_surjective x
      simp only [barycentricRelativeGradeWeightEquiv, gradeMap_mk, basisRestrictedGradeEquiv_mk]
      apply Subtype.ext
      apply Subtype.ext
      simp only [complexIncoming, barycentricRelativeDegreeComplex, submoduleComplex_d, ModuleCat.hom_ofHom]
      change complexIncoming (barycentricKoszulComplex (P := P) K d) i
          (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i + 1))
            (fun a => (originalKoszulWeight d a).toNat) n x.val.val) =
        FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
          (fun a => (originalKoszulWeight d a).toNat) n
          (complexIncoming (barycentricKoszulComplex (P := P) K d) i x.val.val)
      exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
        (barycentricIncoming_weight K d i) n) x.val.val)
    (by
      intro x
      obtain ⟨x, rfl⟩ := (lowerInLevel (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n).mkQ_surjective x
      simp only [barycentricRelativeGradeWeightEquiv, gradeMap_mk, basisRestrictedGradeEquiv_mk]
      apply Subtype.ext
      apply Subtype.ext
      simp only [barycentricRelativeDegreeComplex, submoduleComplex_outgoing_eq]
      change complexOutgoing (barycentricKoszulComplex (P := P) K d) i
          (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
            (fun a => (originalKoszulWeight d a).toNat) n x.val.val) =
        FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i - 1))
          (fun a => (originalKoszulWeight d a).toNat) n
          (complexOutgoing (barycentricKoszulComplex (P := P) K d) i x.val.val)
      exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
        (barycentricOutgoing_weight K d i) n) x.val.val)

/-- The finite filtration on genuine relative cycles has associated graded
isomorphic to the actual internally homogeneous weight strands on the
barycentric restriction kernel. -/
def originalRelativeAssociatedBigradedHomology
    (hrank : ∀ p : P, faceRank p ≤ d) (j i n : ℕ) :
    Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) n ≃ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
  (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank j i n).trans
    (barycentricRelativeGradeWeightHomology K d Q hs hQ j i n)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeBoundaryCases -/
section

/-! # The genuinely empty relative subposet

The ideal for the empty lower ideal contains the bottom generator, which
is one.  Thus its relative module is the whole ring, exactly as for the
usual relative cohomology of a pair with empty second member.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

theorem faceRestrictionIdeal_empty : faceRestrictionIdeal K hs (∅ : Set P) = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  have h : faceRingGenerator K hs (⊥ : P) ∈ faceRestrictionIdeal K hs (∅ : Set P) :=
    Ideal.subset_span ⟨⊥, Set.notMem_empty _, rfl⟩
  simpa only [faceRingGenerator, faceSymbol_bot, map_one] using h

theorem barycentricRestrictionIdeal_empty : barycentricRestrictionIdeal K (∅ : Set P) = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  have h : barycentricGenerator K (⊥ : P) ∈ barycentricRestrictionIdeal K (∅ : Set P) :=
    Ideal.subset_span ⟨⊥, Set.notMem_empty _, rfl⟩
  simpa only [barycentricGenerator, faceSymbol_bot, map_one] using h

theorem originalRelativeKoszulTerm_empty (i : ℕ) :
    originalRelativeKoszulTerm K hs d (∅ : Set P) i = ⊤ := by
  ext x
  change Set.powersetCard (Fin d) i →₀ FaceRing K hs at x
  change (∀ s, x s ∈ faceRestrictionIdeal K hs (∅ : Set P)) ↔ True
  simp only [faceRestrictionIdeal_empty, Submodule.mem_top, implies_true]

theorem barycentricRelativeKoszulTerm_empty (i : ℕ) :
    barycentricRelativeKoszulTerm (P := P) K d (∅ : Set P) i = ⊤ := by
  ext x
  change Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K at x
  change (∀ s, x s ∈ barycentricRestrictionIdeal K (∅ : Set P)) ↔ True
  simp only [barycentricRestrictionIdeal_empty, Submodule.mem_top, implies_true]

theorem originalRelativeDegreeTerm_empty (j i : ℕ) :
    originalRelativeDegreeTerm K hs d (∅ : Set P) j i = originalKoszulDegreePiece K hs d i j := by
  rw [originalRelativeDegreeTerm, originalRelativeKoszulTerm_empty, top_inf_eq]

theorem barycentricRelativeDegreeTerm_empty (j i : ℕ) :
    barycentricRelativeDegreeTerm (P := P) K d (∅ : Set P) j i = barycentricKoszulDegreePiece (P := P) K d i j := by
  rw [barycentricRelativeDegreeTerm, barycentricRelativeKoszulTerm_empty, top_inf_eq]

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.HomologyEquivNaturality -/
section

/-! # Naturality on the literal kernel/image quotients -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.FilteredHomology
open Classical
variable {K X Y Z X' Y' Z' : Type*} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y] [AddCommGroup Z] [Module K Z]
  [AddCommGroup X'] [Module K X'] [AddCommGroup Y'] [Module K Y'] [AddCommGroup Z'] [Module K Z']

theorem middleHomologyEquiv_intertwines
    (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
    (f' : X' →ₗ[K] Y') (g' : Y' →ₗ[K] Z') (hfg' : g'.comp f' = 0)
    (e : Y ≃ₗ[K] Y') (hcycles : ∀ y, g' (e y) = 0 ↔ g y = 0)
    (hboundaries : ∀ y, (∃ x', f' x' = e y) ↔ ∃ x, f x = y)
    (a : Module.End K X) (b : Module.End K Y) (c : Module.End K Z)
    (hab : b.comp f = f.comp a) (hbc : c.comp g = g.comp b)
    (a' : Module.End K X') (b' : Module.End K Y') (c' : Module.End K Z')
    (hab' : b'.comp f' = f'.comp a') (hbc' : c'.comp g' = g'.comp b')
    (hcomm : ∀ y, e (b y) = b' (e y)) (x : Homology f g hfg) :
    FourPapers.Universal.middleHomologyEquiv f g hfg f' g' hfg' e hcycles hboundaries
      (inducedHomologyMap f g hfg f g hfg a b c hab hbc x) =
      inducedHomologyMap f' g' hfg' f' g' hfg' a' b' c' hab' hbc'
        (FourPapers.Universal.middleHomologyEquiv f g hfg f' g' hfg' e hcycles hboundaries x) := by
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap f g hfg)).mkQ_surjective x
  change FourPapers.Universal.middleHomologyEquiv f g hfg f' g' hfg' e hcycles hboundaries
      (inducedHomologyMap f g hfg f g hfg a b c hab hbc (homologyClass f g hfg z)) =
    inducedHomologyMap f' g' hfg' f' g' hfg' a' b' c' hab' hbc'
      (FourPapers.Universal.middleHomologyEquiv f g hfg f' g' hfg' e hcycles hboundaries
        (homologyClass f g hfg z))
  rw [inducedHomologyMap_class, FourPapers.Universal.middleHomologyEquiv_class,
    FourPapers.Universal.middleHomologyEquiv_class, inducedHomologyMap_class]
  apply congrArg (homologyClass f' g' hfg')
  apply Subtype.ext
  exact hcomm z.val

theorem chainHomologyEquiv_intertwines
    (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
    (f' : X' →ₗ[K] Y') (g' : Y' →ₗ[K] Z') (hfg' : g'.comp f' = 0)
    (ea : X ≃ₗ[K] X') (eb : Y ≃ₗ[K] Y') (ec : Z ≃ₗ[K] Z')
    (heab : ∀ x, f' (ea x) = eb (f x)) (hebc : ∀ y, g' (eb y) = ec (g y))
    (a : Module.End K X) (b : Module.End K Y) (c : Module.End K Z)
    (hab : b.comp f = f.comp a) (hbc : c.comp g = g.comp b)
    (a' : Module.End K X') (b' : Module.End K Y') (c' : Module.End K Z')
    (hab' : b'.comp f' = f'.comp a') (hbc' : c'.comp g' = g'.comp b')
    (hcomm : ∀ y, eb (b y) = b' (eb y)) (x : Homology f g hfg) :
    chainHomologyEquiv f g hfg f' g' hfg' ea eb ec heab hebc
      (inducedHomologyMap f g hfg f g hfg a b c hab hbc x) =
      inducedHomologyMap f' g' hfg' f' g' hfg' a' b' c' hab' hbc'
        (chainHomologyEquiv f g hfg f' g' hfg' ea eb ec heab hebc x) :=
  middleHomologyEquiv_intertwines f g hfg f' g' hfg' eb _ _ a b c hab hbc a' b' c' hab' hbc' hcomm x

theorem gradeEquiv_intertwines_lower
    (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (e : X ≃ₗ[K] Y) (he : ∀ n x, e x ∈ G.level n ↔ x ∈ F.level n)
    (a : Module.End K X) (b : Module.End K Y) (ha : Preserves F F a) (hb : Preserves G G b)
    (n : ℕ) (herror : ∀ x, x ∈ F.level (n + 1) → b (e x) - e (a x) ∈ G.level n)
    (x : Grade F n) :
    gradeMap G G b hb n (gradeEquiv F G e he n x) =
      gradeEquiv F G e he n (gradeMap F F a ha n x) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  apply (Submodule.Quotient.eq _).mpr
  exact herror x.val x.property

end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Common.SubcomplexNaturality -/
section

/-! # Literal subcomplex maps and their canonical homology actions -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]
variable {C D E : ChainComplex (ModuleCat.{u} K) ℕ}

def submoduleComplexMap
    (N : ∀ i, Submodule K (C.X i)) (M : ∀ i, Submodule K (D.X i))
    (hN : ∀ i x, x ∈ N (i + 1) → complexIncoming C i x ∈ N i)
    (hM : ∀ i x, x ∈ M (i + 1) → complexIncoming D i x ∈ M i)
    (f : C ⟶ D) (hf : ∀ i x, x ∈ N i → f.f i x ∈ M i) :
    submoduleComplex C N hN ⟶ submoduleComplex D M hM where
  f i := ModuleCat.ofHom (restrictedMap (f.f i).hom (N i) (M i) (hf i))
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [submoduleComplex_d, submoduleComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact congrArg (fun q : C.X (j + 1) ⟶ D.X j => q x.val) (f.comm (j + 1) j)

def complexKernelHomologyMap (f : C ⟶ D) (i : ℕ) :
    complexKernelHomology C i →ₗ[K] complexKernelHomology D i :=
  inducedHomologyMap _ _ (complexIncomingOutgoing C i) _ _ (complexIncomingOutgoing D i)
    (f.f (i + 1)).hom (f.f i).hom (f.f (i - 1)).hom
    (congrArg (fun q => q.hom) (f.comm (i + 1) i)).symm
    (congrArg (fun q => q.hom) (f.comm i (i - 1))).symm

@[simp] theorem complexKernelHomologyMap_class (f : C ⟶ D) (i : ℕ)
    (z : LinearMap.ker (complexOutgoing C i)) :
    complexKernelHomologyMap f i (homologyClass _ _ (complexIncomingOutgoing C i) z) =
      homologyClass _ _ (complexIncomingOutgoing D i)
        (inducedCycleMap _ _ (f.f i).hom (f.f (i - 1)).hom
          (congrArg (fun q => q.hom) (f.comm i (i - 1))).symm z) := rfl

theorem complexKernelHomologyMap_id (i : ℕ) :
    complexKernelHomologyMap (𝟙 C) i = LinearMap.id := by
  apply LinearMap.ext
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _ (complexIncomingOutgoing C i))).mkQ_surjective x
  rfl

theorem complexKernelHomologyMap_comp (f : C ⟶ D) (g : D ⟶ E) (i : ℕ) :
    complexKernelHomologyMap (f ≫ g) i = (complexKernelHomologyMap g i).comp (complexKernelHomologyMap f i) := by
  apply LinearMap.ext
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _ (complexIncomingOutgoing C i))).mkQ_surjective x
  rfl

theorem complexKernelHomologyMap_preserves (f : C ⟶ D)
    (F : ∀ i, Filtration (K := K) (C.X i)) (G : ∀ i, Filtration (K := K) (D.X i))
    (hf : ∀ i, Preserves (F i) (G i) (f.f i).hom) (i : ℕ) :
    Preserves (complexHomologyFiltration C F i) (complexHomologyFiltration D G i)
      (complexKernelHomologyMap f i) :=
  inducedHomologyMap_preserves _ _ _ _ _ _ _ _ _ _ _ (F i) (G i) (hf i)

def complexKernelHomologyEquiv (e : C ≅ D) (i : ℕ) :
    complexKernelHomology C i ≃ₗ[K] complexKernelHomology D i :=
  chainHomologyEquiv _ _ (complexIncomingOutgoing C i) _ _ (complexIncomingOutgoing D i)
    (complexIsoLinearEquiv e (i + 1)) (complexIsoLinearEquiv e i) (complexIsoLinearEquiv e (i - 1))
    (complexIso_commutes e (i + 1) i) (complexIso_commutes e i (i - 1))

theorem complexKernelHomologyEquiv_toLinearMap (e : C ≅ D) (i : ℕ) :
    (complexKernelHomologyEquiv e i).toLinearMap = complexKernelHomologyMap e.hom i := by
  apply LinearMap.ext
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _ (complexIncomingOutgoing C i))).mkQ_surjective x
  rfl

theorem complexKernelHomologyEquiv_symm_toLinearMap (e : C ≅ D) (i : ℕ) :
    (complexKernelHomologyEquiv e i).symm.toLinearMap = complexKernelHomologyMap e.inv i := by
  apply LinearMap.ext
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _ (complexIncomingOutgoing D i))).mkQ_surjective x
  rfl

theorem complexKernelHomologyEquiv_filtered (e : C ≅ D)
    (F : ∀ i, Filtration (K := K) (C.X i)) (G : ∀ i, Filtration (K := K) (D.X i))
    (he : ∀ i n x, complexIsoLinearEquiv e i x ∈ (G i).level n ↔ x ∈ (F i).level n)
    (i n : ℕ) (x : complexKernelHomology C i) :
    complexKernelHomologyEquiv e i x ∈ (complexHomologyFiltration D G i).level n ↔
      x ∈ (complexHomologyFiltration C F i).level n := by
  have hf : ∀ k, Preserves (F k) (G k) (e.hom.f k).hom := fun k m y hy => (he k m y).mpr hy
  have hi : ∀ k, Preserves (G k) (F k) (e.inv.f k).hom := by
    intro k m y hy
    exact (he k m ((complexIsoLinearEquiv e k).symm y)).mp
      (by simpa only [LinearEquiv.apply_symm_apply] using hy)
  constructor
  · intro hx
    have h := complexKernelHomologyMap_preserves e.inv G F hi i n _ hx
    rw [← complexKernelHomologyEquiv_symm_toLinearMap] at h
    simpa only [LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] using h
  · intro hx
    have h := complexKernelHomologyMap_preserves e.hom F G hf i n x hx
    rwa [← complexKernelHomologyEquiv_toLinearMap] at h

def complexKernelMapData (f : C ⟶ D) (i : ℕ) :
    ShortComplex.LeftHomologyMapData
      ((HomologicalComplex.shortComplexFunctor' (ModuleCat K) (ComplexShape.down ℕ) (i + 1) i (i - 1)).map f)
      (C.sc' (i + 1) i (i - 1)).moduleCatLeftHomologyData
      (D.sc' (i + 1) i (i - 1)).moduleCatLeftHomologyData where
  φK := ModuleCat.ofHom (inducedCycleMap _ _ (f.f i).hom (f.f (i - 1)).hom
    (congrArg (fun q => q.hom) (f.comm i (i - 1))).symm)
  φH := ModuleCat.ofHom (complexKernelHomologyMap f i)
  commi := rfl
  commf' := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact (congrArg (fun q : C.X (i + 1) ⟶ D.X i => q x) (f.comm (i + 1) i)).symm
  commπ := rfl

/-- The explicit cycle-quotient action is exactly the standard categorical
homology action on the same complex. -/
theorem complexKernelHomologyIso_natural (f : C ⟶ D) (i : ℕ) :
    HomologicalComplex.homologyMap f i ≫ (complexKernelHomologyIso D i).hom =
      (complexKernelHomologyIso C i).hom ≫ ModuleCat.ofHom (complexKernelHomologyMap f i) := by
  have hnext : (ComplexShape.down ℕ).next i = i - 1 := by cases i <;> simp
  have hS := (HomologicalComplex.homologyFunctorIso' (ModuleCat K) (ComplexShape.down ℕ)
    (i + 1) i (i - 1) (ChainComplex.prev ℕ i) hnext).hom.naturality f
  have hD := (complexKernelMapData f i).homologyMap_comm
  change HomologicalComplex.homologyMap f i ≫
      (D.homologyIsoSc' (i + 1) i (i - 1) (ChainComplex.prev ℕ i) hnext).hom =
    (C.homologyIsoSc' (i + 1) i (i - 1) (ChainComplex.prev ℕ i) hnext).hom ≫
      ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' (ModuleCat K) (ComplexShape.down ℕ)
          (i + 1) i (i - 1)).map f) at hS
  change ShortComplex.homologyMap
      ((HomologicalComplex.shortComplexFunctor' (ModuleCat K) (ComplexShape.down ℕ)
        (i + 1) i (i - 1)).map f) ≫
      (D.sc' (i + 1) i (i - 1)).moduleCatHomologyIso.hom =
    (C.sc' (i + 1) i (i - 1)).moduleCatHomologyIso.hom ≫
      ModuleCat.ofHom (complexKernelHomologyMap f i) at hD
  change HomologicalComplex.homologyMap f i ≫
      ((D.homologyIsoSc' (i + 1) i (i - 1) (ChainComplex.prev ℕ i) hnext).hom ≫
        (D.sc' (i + 1) i (i - 1)).moduleCatHomologyIso.hom) =
    ((C.homologyIsoSc' (i + 1) i (i - 1) (ChainComplex.prev ℕ i) hnext).hom ≫
        (C.sc' (i + 1) i (i - 1)).moduleCatHomologyIso.hom) ≫ _
  have hS' := congrArg
    (fun q : C.homology i ⟶ (D.sc' (i + 1) i (i - 1)).homology =>
      q ≫ (D.sc' (i + 1) i (i - 1)).moduleCatHomologyIso.hom) hS
  have hD' := congrArg
    (fun q : (C.sc' (i + 1) i (i - 1)).homology ⟶ ModuleCat.of K (complexKernelHomology D i) =>
      (C.homologyIsoSc' (i + 1) i (i - 1) (ChainComplex.prev ℕ i)
        hnext).hom ≫ q) hD
  exact (Category.assoc _ _ _).symm.trans
    (hS'.trans ((Category.assoc _ _ _).trans (hD'.trans (Category.assoc _ _ _).symm)))


def complexGradedHomologyMap (f : C ⟶ D)
    (F : ∀ i, Filtration (K := K) (C.X i)) (G : ∀ i, Filtration (K := K) (D.X i))
    (hF : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hG : ∀ i, Preserves (G (i + 1)) (G i) (complexIncoming D i))
    (hf : ∀ i, Preserves (F i) (G i) (f.f i).hom) (i n : ℕ) :
    complexGradedHomology C F hF i n →ₗ[K] complexGradedHomology D G hG i n :=
  inducedGradedHomologyMap _ _ (complexIncomingOutgoing C i) _ _ (complexIncomingOutgoing D i)
    (f.f (i + 1)).hom (f.f i).hom (f.f (i - 1)).hom
    (congrArg (fun q => q.hom) (f.comm (i + 1) i)).symm
    (congrArg (fun q => q.hom) (f.comm i (i - 1))).symm
    (F (i + 1)) (F i) (F (i - 1)) (G (i + 1)) (G i) (G (i - 1))
    (hf (i + 1)) (hf i) (hf (i - 1)) (hF i) (complexOutgoing_preserves C F hF i)
    (hG i) (complexOutgoing_preserves D G hG i) n

theorem complexAssociatedHomologyEquiv_natural (f : C ⟶ D)
    (F : ∀ i, Filtration (K := K) (C.X i)) (G : ∀ i, Filtration (K := K) (D.X i))
    (hF : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hG : ∀ i, Preserves (G (i + 1)) (G i) (complexIncoming D i))
    (hf : ∀ i, Preserves (F i) (G i) (f.f i).hom)
    (lF : ∀ i, LiftsCycles (F (i + 1)) (F i) (complexIncoming C i))
    (lG : ∀ i, LiftsCycles (G (i + 1)) (G i) (complexIncoming D i))
    (i n : ℕ) (x : Grade (complexHomologyFiltration C F i) n) :
    complexAssociatedHomologyEquiv D G hG lG i n
      (gradeMap _ _ (complexKernelHomologyMap f i) (complexKernelHomologyMap_preserves f F G hf i) n x) =
      complexGradedHomologyMap f F G hF hG hf i n (complexAssociatedHomologyEquiv C F hF lF i n x) :=
  associatedHomologyEquiv_natural _ _ _ _ _ _ _ _ _ _ _
    (F (i + 1)) (F i) (F (i - 1)) (G (i + 1)) (G i) (G (i - 1))
    (hf (i + 1)) (hf i) (hf (i - 1)) (hF i) (complexOutgoing_preserves C F hF i)
    (hG i) (complexOutgoing_preserves D G hG i)
    (lF i) (complexOutgoing_liftsCycles C F lF i) (lG i) (complexOutgoing_liftsCycles D G lG i) n x


theorem complexGradedHomologyEquiv_intertwines
    (F : ∀ i, Filtration (K := K) (C.X i)) (G : ∀ i, Filtration (K := K) (D.X i))
    (hF : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hG : ∀ i, Preserves (G (i + 1)) (G i) (complexIncoming D i))
    (e : C ≅ D)
    (he : ∀ i n x, complexIsoLinearEquiv e i x ∈ (G i).level n ↔ x ∈ (F i).level n)
    (a : C ⟶ C) (b : D ⟶ D)
    (ha : ∀ i, Preserves (F i) (F i) (a.f i).hom)
    (hb : ∀ i, Preserves (G i) (G i) (b.f i).hom)
    (n : ℕ)
    (hcomm : ∀ i x, gradeMap (G i) (G i) (b.f i).hom (hb i) n
        (gradeEquiv (F i) (G i) (complexIsoLinearEquiv e i) (he i) n x) =
      gradeEquiv (F i) (G i) (complexIsoLinearEquiv e i) (he i) n
        (gradeMap (F i) (F i) (a.f i).hom (ha i) n x))
    (i : ℕ) (x : complexGradedHomology C F hF i n) :
    complexGradedHomologyEquiv F G hF hG e he i n
      (complexGradedHomologyMap a F F hF hF ha i n x) =
      complexGradedHomologyMap b G G hG hG hb i n
        (complexGradedHomologyEquiv F G hF hG e he i n x) :=
  chainHomologyEquiv_intertwines _ _ _ _ _ _ _ _ _ _ _
    (gradeMap (F (i + 1)) (F (i + 1)) (a.f (i + 1)).hom (ha (i + 1)) n)
    (gradeMap (F i) (F i) (a.f i).hom (ha i) n)
    (gradeMap (F (i - 1)) (F (i - 1)) (a.f (i - 1)).hom (ha (i - 1)) n)
    (gradeMap_square (complexIncoming C i) (complexIncoming C i)
      (a.f (i + 1)).hom (a.f i).hom
      (congrArg (fun q => q.hom) (a.comm (i + 1) i)).symm
      (F (i + 1)) (F i) (F (i + 1)) (F i)
      (ha (i + 1)) (ha i) (hF i) (hF i) n)
    (gradeMap_square (complexOutgoing C i) (complexOutgoing C i)
      (a.f i).hom (a.f (i - 1)).hom
      (congrArg (fun q => q.hom) (a.comm i (i - 1))).symm
      (F i) (F (i - 1)) (F i) (F (i - 1))
      (ha i) (ha (i - 1)) (complexOutgoing_preserves C F hF i)
      (complexOutgoing_preserves C F hF i) n)
    (gradeMap (G (i + 1)) (G (i + 1)) (b.f (i + 1)).hom (hb (i + 1)) n)
    (gradeMap (G i) (G i) (b.f i).hom (hb i) n)
    (gradeMap (G (i - 1)) (G (i - 1)) (b.f (i - 1)).hom (hb (i - 1)) n)
    (gradeMap_square (complexIncoming D i) (complexIncoming D i)
      (b.f (i + 1)).hom (b.f i).hom
      (congrArg (fun q => q.hom) (b.comm (i + 1) i)).symm
      (G (i + 1)) (G i) (G (i + 1)) (G i)
      (hb (i + 1)) (hb i) (hG i) (hG i) n)
    (gradeMap_square (complexOutgoing D i) (complexOutgoing D i)
      (b.f i).hom (b.f (i - 1)).hom
      (congrArg (fun q => q.hom) (b.comm i (i - 1))).symm
      (G i) (G (i - 1)) (G i) (G (i - 1))
      (hb i) (hb (i - 1)) (complexOutgoing_preserves D G hG i)
      (complexOutgoing_preserves D G hG i) n)
    (fun y => (hcomm i y).symm) x

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.OriginalKoszulActions -/
section

/-! # Natural automorphisms of the absolute and relative Koszul complexes

All maps are induced by the actual order automorphism on face generators.
The relative action requires precisely stability of the chosen lower ideal.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

theorem standardFaceOrderEquiv_refl (a : StandardFaceIndex P) :
    standardFaceOrderEquiv (OrderIso.refl P) a = a := by
  apply Subtype.ext
  change Finsupp.mapDomain id a.val = a.val
  exact Finsupp.mapDomain_id

theorem standardFaceOrderEquiv_trans (e f : P ≃o P) (a : StandardFaceIndex P) :
    standardFaceOrderEquiv (e.trans f) a = standardFaceOrderEquiv f (standardFaceOrderEquiv e a) := by
  apply Subtype.ext
  change Finsupp.mapDomain (nonzeroFaceOrderEquiv (e.trans f)) a.val =
    Finsupp.mapDomain (nonzeroFaceOrderEquiv f) (Finsupp.mapDomain (nonzeroFaceOrderEquiv e) a.val)
  rw [← Finsupp.mapDomain_comp]
  rfl

theorem faceRingOrderAut_refl (x : FaceRing K hs) : faceRingOrderAut K hs (OrderIso.refl P) x = x := by
  have h : (faceRingOrderAut K hs (OrderIso.refl P)).toLinearMap = LinearMap.id := by
    apply (standardFaceBasis K hs).ext
    intro a
    simp only [AlgEquiv.toLinearMap_apply, faceRingOrderAut_standardBasis,
      standardFaceOrderEquiv_refl, LinearMap.id_apply]
  exact LinearMap.congr_fun h x

theorem barycentricRingOrderAut_refl (x : BarycentricRing (P := P) K) :
    barycentricRingOrderAut K (OrderIso.refl P) x = x := by
  have h : (barycentricRingOrderAut K (OrderIso.refl P)).toLinearMap = LinearMap.id := by
    apply (barycentricGlobalStandardBasis K).ext
    intro a
    simp only [AlgEquiv.toLinearMap_apply, barycentricRingOrderAut_standardBasis,
      standardFaceOrderEquiv_refl, LinearMap.id_apply]
  exact LinearMap.congr_fun h x

theorem faceRingOrderAut_trans (e f : P ≃o P) (x : FaceRing K hs) :
    faceRingOrderAut K hs (e.trans f) x = faceRingOrderAut K hs f (faceRingOrderAut K hs e x) := by
  have h : (faceRingOrderAut K hs (e.trans f)).toLinearMap =
      (faceRingOrderAut K hs f).toLinearMap.comp (faceRingOrderAut K hs e).toLinearMap := by
    apply (standardFaceBasis K hs).ext
    intro a
    simp only [AlgEquiv.toLinearMap_apply, LinearMap.comp_apply, faceRingOrderAut_standardBasis,
      standardFaceOrderEquiv_trans]
  exact LinearMap.congr_fun h x

theorem barycentricRingOrderAut_trans (e f : P ≃o P) (x : BarycentricRing (P := P) K) :
    barycentricRingOrderAut K (e.trans f) x = barycentricRingOrderAut K f (barycentricRingOrderAut K e x) := by
  have h : (barycentricRingOrderAut K (e.trans f)).toLinearMap =
      (barycentricRingOrderAut K f).toLinearMap.comp (barycentricRingOrderAut K e).toLinearMap := by
    apply (barycentricGlobalStandardBasis K).ext
    intro a
    simp only [AlgEquiv.toLinearMap_apply, LinearMap.comp_apply, barycentricRingOrderAut_standardBasis,
      standardFaceOrderEquiv_trans]
  exact LinearMap.congr_fun h x

theorem originalKoszulOrderAut_degree (e : P ≃o P) (i j : ℕ)
    (x : (originalKoszulComplex K hs d).X i) (hx : x ∈ originalKoszulDegreePiece K hs d i j) :
    (originalKoszulOrderAut K hs d e).hom.f i x ∈ originalKoszulDegreePiece K hs d i j := by
  change Set.powersetCard (Fin d) i →₀ FaceRing K hs at x
  change Finsupp.mapRange.linearMap (faceRingOrderAut K hs e).toLinearMap x ∈
    FourPapers.BasisGrading.Piece (originalKoszulBasis K hs d i) originalKoszulDegree j
  apply FourPapers.BasisGrading.map_piece _ _ _ _ _ _ j x hx
  intro a
  change Finsupp.mapRange.linearMap (faceRingOrderAut K hs e).toLinearMap (originalKoszulBasis K hs d i a) ∈ _
  rcases a with ⟨s, a⟩
  simp only [originalKoszulBasis, Finsupp.coe_basis, Finsupp.mapRange.linearMap_apply,
    Finsupp.mapRange_single, AlgEquiv.toLinearMap_apply, faceRingOrderAut_standardBasis]
  have h := FourPapers.BasisGrading.basis_mem_piece (originalKoszulBasis K hs d i)
    originalKoszulDegree (⟨s, standardFaceOrderEquiv e a⟩ : OriginalKoszulIndex P d i)
  simpa only [originalKoszulBasis, Finsupp.coe_basis, originalKoszulDegree, standardFaceOrderEquiv_degree] using h

theorem barycentricKoszulOrderAut_degree (e : P ≃o P) (i j : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i) (hx : x ∈ barycentricKoszulDegreePiece (P := P) K d i j) :
    (barycentricKoszulOrderAut (P := P) K d e).hom.f i x ∈ barycentricKoszulDegreePiece (P := P) K d i j := by
  change Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K at x
  change Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap x ∈
    FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i) originalKoszulDegree j
  apply FourPapers.BasisGrading.map_piece _ _ _ _ _ _ j x hx
  intro a
  change Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap (barycentricKoszulBasis (P := P) K d i a) ∈ _
  rcases a with ⟨s, a⟩
  simp only [barycentricKoszulBasis, Finsupp.coe_basis, Finsupp.mapRange.linearMap_apply,
    Finsupp.mapRange_single, AlgEquiv.toLinearMap_apply, barycentricRingOrderAut_standardBasis]
  have h := FourPapers.BasisGrading.basis_mem_piece (barycentricKoszulBasis (P := P) K d i)
    originalKoszulDegree (⟨s, standardFaceOrderEquiv e a⟩ : OriginalKoszulIndex P d i)
  simpa only [barycentricKoszulBasis, Finsupp.coe_basis, originalKoszulDegree, standardFaceOrderEquiv_degree] using h

variable (Q : Set P) (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

include hstable in
theorem faceRingOrderAut_relative (x : FaceRing K hs) (hx : x ∈ faceRestrictionIdeal K hs Q) :
    faceRingOrderAut K hs e x ∈ faceRestrictionIdeal K hs Q := by
  have hI : faceRestrictionIdeal K hs Q ≤
      Ideal.comap (faceRingOrderAut K hs e).toRingHom (faceRestrictionIdeal K hs Q) := by
    apply Ideal.span_le.mpr
    rintro y ⟨p, hp, rfl⟩
    change faceRingOrderAut K hs e (faceRingGenerator K hs p) ∈ faceRestrictionIdeal K hs Q
    rw [faceRingOrderAut_generator]
    exact Ideal.subset_span ⟨e p, fun h => hp ((hstable p).mp h), rfl⟩
  exact hI hx

include hstable in
theorem barycentricRingOrderAut_relative (x : BarycentricRing (P := P) K)
    (hx : x ∈ barycentricRestrictionIdeal K Q) :
    barycentricRingOrderAut K e x ∈ barycentricRestrictionIdeal K Q := by
  have hI : barycentricRestrictionIdeal K Q ≤
      Ideal.comap (barycentricRingOrderAut K e).toRingHom (barycentricRestrictionIdeal K Q) := by
    apply Ideal.span_le.mpr
    rintro y ⟨p, hp, rfl⟩
    change barycentricRingOrderAut K e (barycentricGenerator K p) ∈ barycentricRestrictionIdeal K Q
    rw [barycentricRingOrderAut_generator]
    exact Ideal.subset_span ⟨e p, fun h => hp ((hstable p).mp h), rfl⟩
  exact hI hx

include hstable in
theorem originalKoszulOrderAut_relativeDegree (j i : ℕ)
    (x : (originalKoszulComplex K hs d).X i) (hx : x ∈ originalRelativeDegreeTerm K hs d Q j i) :
    (originalKoszulOrderAut K hs d e).hom.f i x ∈ originalRelativeDegreeTerm K hs d Q j i := by
  change Set.powersetCard (Fin d) i →₀ FaceRing K hs at x
  exact ⟨fun s => faceRingOrderAut_relative K hs Q e hstable (x s) (hx.1 s),
    originalKoszulOrderAut_degree K hs d e i j x hx.2⟩

include hstable in
theorem barycentricKoszulOrderAut_relativeDegree (j i : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i)
    (hx : x ∈ barycentricRelativeDegreeTerm (P := P) K d Q j i) :
    (barycentricKoszulOrderAut (P := P) K d e).hom.f i x ∈
      barycentricRelativeDegreeTerm (P := P) K d Q j i := by
  change Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K at x
  exact ⟨fun s => barycentricRingOrderAut_relative K Q e hstable (x s) (hx.1 s),
    barycentricKoszulOrderAut_degree K d e i j x hx.2⟩

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeKoszulEquivariance -/
section

/-! # Equivariance of the intrinsic relative filtration comparison

The triangular module comparison itself need not commute with a group
action.  Its discrepancy does have strictly smaller rank weight, because
its leading standard-monomial correspondence is canonical.  This is the
precise reason the actual associated graded homology action is equivariant.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

/-- The failure of equivariance of the chosen lift is strictly lower
weight; the leading map is the already proved canonical equivariant map. -/
theorem originalKoszulComparison_equivariance_error (e : P ≃o P) (i n : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i)
    (hx : x ∈ (barycentricKoszulFiltration (P := P) K d i).level (n + 1)) :
    (show Set.powersetCard (Fin d) i →₀ FaceRing K hs from
      (originalKoszulOrderAut K hs d e).hom.f i (originalKoszulCoefficientEquiv K hs d hrank i x)) -
      originalKoszulCoefficientEquiv K hs d hrank i ((barycentricKoszulOrderAut (P := P) K d e).hom.f i x) ∈
        (originalKoszulFiltration K hs d i).level n := by
  have h₁ := originalKoszulOrderAut_filtered K hs d e i n _
    (originalKoszulCoefficientEquiv_error_lower K hs d hrank i n x hx)
  have h₂ := originalKoszulCoefficientEquiv_error_lower K hs d hrank i n
    ((barycentricKoszulOrderAut (P := P) K d e).hom.f i x)
    (barycentricKoszulOrderAut_filtered K d e i (n + 1) x hx)
  have hh := ((originalKoszulFiltration K hs d i).level n).sub_mem h₁ h₂
  change Finsupp.mapRange.linearMap (faceRingOrderAut K hs e).toLinearMap
    (originalKoszulCoefficientEquiv K hs d hrank i x) -
    originalKoszulCoefficientEquiv K hs d hrank i
      (Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap x) ∈ _
  change Finsupp.mapRange.linearMap (faceRingOrderAut K hs e).toLinearMap
      (originalKoszulCoefficientEquiv K hs d hrank i x - canonicalKoszulCoefficientEquiv K hs d i x) -
    (originalKoszulCoefficientEquiv K hs d hrank i
        (Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap x) -
      canonicalKoszulCoefficientEquiv K hs d i
        (Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap x)) ∈ _ at hh
  convert hh using 1
  rw [map_sub, canonicalKoszulCoefficientEquiv_equivariant]
  abel

variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

def originalRelativeInternalOrderMap (j : ℕ) :
    originalRelativeDegreeComplex K hs d Q hrank j ⟶ originalRelativeDegreeComplex K hs d Q hrank j :=
  submoduleComplexMap _ _ (originalRelativeDegreeTerm_preserved K hs d Q hrank j)
    (originalRelativeDegreeTerm_preserved K hs d Q hrank j)
    (originalKoszulOrderAut K hs d e).hom (originalKoszulOrderAut_relativeDegree K hs d Q e hstable j)

def barycentricRelativeInternalOrderMap (j : ℕ) :
    barycentricRelativeDegreeComplex (P := P) K d Q j ⟶ barycentricRelativeDegreeComplex (P := P) K d Q j :=
  submoduleComplexMap _ _ (barycentricRelativeDegreeTerm_preserved K d Q j)
    (barycentricRelativeDegreeTerm_preserved K d Q j)
    (barycentricKoszulOrderAut (P := P) K d e).hom (barycentricKoszulOrderAut_relativeDegree K d Q e hstable j)

theorem originalRelativeInternalOrderMap_filtered (j i : ℕ) :
    Preserves (originalRelativeDegreeFiltration K hs d Q j i) (originalRelativeDegreeFiltration K hs d Q j i)
      ((originalRelativeInternalOrderMap K hs d hrank Q e hstable j).f i).hom :=
  fun n x hx => originalKoszulOrderAut_filtered K hs d e i n x.val hx

theorem barycentricRelativeInternalOrderMap_filtered (j i : ℕ) :
    Preserves (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
      (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
      ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f i).hom :=
  fun n x hx => barycentricKoszulOrderAut_filtered K d e i n x.val hx

def originalRelativeInternalHomologyAction (j i : ℕ) :
    Module.End K (originalRelativeInternalHomology K hs d Q hrank j i) :=
  complexKernelHomologyMap (originalRelativeInternalOrderMap K hs d hrank Q e hstable j) i

/-- Stability is proved for the literal bounded-cycle filtration, before
using the barycentric identification. -/
theorem originalRelativeInternalHomologyAction_filtered (j i : ℕ) :
    Preserves (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
      (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
      (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i) :=
  complexKernelHomologyMap_preserves _ _ _ (originalRelativeInternalOrderMap_filtered K hs d hrank Q e hstable j) i

theorem relativeInternalGradeComparison_equivariant (j i n : ℕ)
    (x : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n) :
    gradeMap _ _ ((originalRelativeInternalOrderMap K hs d hrank Q e hstable j).f i).hom
      (originalRelativeInternalOrderMap_filtered K hs d hrank Q e hstable j i) n
      (gradeEquiv _ _ (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i)
        (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j i) n x) =
      gradeEquiv _ _ (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i)
        (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j i) n
        (gradeMap _ _ ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f i).hom
          (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j i) n x) := by
  apply gradeEquiv_intertwines_lower
  intro y hy
  exact originalKoszulComparison_equivariance_error K hs d hrank e i n y.val hy

def originalRelativeGradedHomologyAction (j i n : ℕ) :=
  complexGradedHomologyMap (originalRelativeInternalOrderMap K hs d hrank Q e hstable j)
    (originalRelativeDegreeFiltration K hs d Q j) (originalRelativeDegreeFiltration K hs d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (originalRelativeInternalOrderMap_filtered K hs d hrank Q e hstable j) i n

def barycentricRelativeGradedHomologyAction (j i n : ℕ) :=
  complexGradedHomologyMap (barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j)
    (barycentricRelativeDegreeFiltration (P := P) K d Q j) (barycentricRelativeDegreeFiltration (P := P) K d Q j)
    (barycentricRelativeDegreeIncoming_preserves K d Q j)
    (barycentricRelativeDegreeIncoming_preserves K d Q j)
    (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j) i n

/-- Equivariance of the canonical associated graded comparison on the
honest relative internal-degree homology groups. -/
theorem relativeInternalAssociatedGradedComparison_equivariant (j i n : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) n) :
    relativeInternalAssociatedGradedComparison K hs d Q hQ hrank j i n
      (gradeMap _ _ (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i)
        (originalRelativeInternalHomologyAction_filtered K hs d hrank Q e hstable j i) n x) =
      barycentricRelativeGradedHomologyAction K d Q e hstable j i n
        (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank j i n x) := by
  let E := complexGradedHomologyEquiv _ _
    (barycentricRelativeDegreeIncoming_preserves K d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (relativeInternalKoszulComparison K hs d Q hQ hrank j)
    (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j) i n
  have hE := complexGradedHomologyEquiv_intertwines _ _
    (barycentricRelativeDegreeIncoming_preserves K d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (relativeInternalKoszulComparison K hs d Q hQ hrank j)
    (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j)
    (barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j)
    (originalRelativeInternalOrderMap K hs d hrank Q e hstable j)
    (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j)
    (originalRelativeInternalOrderMap_filtered K hs d hrank Q e hstable j) n
    (fun k y => relativeInternalGradeComparison_equivariant K hs d hrank Q hQ e hstable j k n y) i
  have hA := complexAssociatedHomologyEquiv_natural
    (originalRelativeInternalOrderMap K hs d hrank Q e hstable j)
    (originalRelativeDegreeFiltration K hs d Q j) (originalRelativeDegreeFiltration K hs d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (originalRelativeInternalOrderMap_filtered K hs d hrank Q e hstable j)
    (originalRelativeDegreeIncoming_liftsCycles K hs d Q hQ hrank j)
    (originalRelativeDegreeIncoming_liftsCycles K hs d Q hQ hrank j) i n x
  apply E.injective
  change E (E.symm _) = E (barycentricRelativeGradedHomologyAction K d Q e hstable j i n (E.symm _))
  rw [LinearEquiv.apply_symm_apply]
  have hEt := hE (E.symm
    (complexAssociatedHomologyEquiv
      (originalRelativeDegreeComplex K hs d Q hrank j)
      (originalRelativeDegreeFiltration K hs d Q j)
      (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
      (originalRelativeDegreeIncoming_liftsCycles K hs d Q hQ hrank j) i n x))
  change E (barycentricRelativeGradedHomologyAction K d Q e hstable j i n (E.symm _)) =
    originalRelativeGradedHomologyAction K hs d hrank Q e hstable j i n (E (E.symm _)) at hEt
  rw [LinearEquiv.apply_symm_apply] at hEt
  exact hA.trans hEt.symm

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeBigradedEquivariance -/
section

/-! # The actual order action on barycentric relative weight strands -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (d : ℕ) (e : P ≃o P)

theorem barycentricKoszulOrderAut_weight_basis (i : ℕ) (a : OriginalKoszulIndex P d i) :
    (barycentricKoszulOrderAut (P := P) K d e).hom.f i (barycentricKoszulBasis (P := P) K d i a) ∈
      barycentricKoszulWeightPiece (P := P) K d (originalKoszulWeight d a).toNat i := by
  rcases a with ⟨s, a⟩
  change Finsupp.mapRange.linearMap (barycentricRingOrderAut K e).toLinearMap
    (barycentricKoszulBasis (P := P) K d i ⟨s, a⟩) ∈ _
  simp only [barycentricKoszulBasis, Finsupp.coe_basis, Finsupp.mapRange.linearMap_apply,
    Finsupp.mapRange_single, AlgEquiv.toLinearMap_apply, barycentricRingOrderAut_standardBasis]
  have h := FourPapers.BasisGrading.basis_mem_piece (barycentricKoszulBasis (P := P) K d i)
    (fun b => (originalKoszulWeight d b).toNat) (⟨s, standardFaceOrderEquiv e a⟩ : OriginalKoszulIndex P d i)
  simpa only [barycentricKoszulWeightPiece, barycentricKoszulBasis, Finsupp.coe_basis, originalKoszulWeight, standardFaceOrderEquiv_weight] using h

variable (Q : Set P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

def barycentricRelativeBigradedOrderMap (j n i : ℕ) :
    Module.End K (barycentricRelativeBigradedTerm (P := P) K d Q j n i) :=
  basisRestrictedWeightMap _ _ _ _ ((barycentricKoszulOrderAut (P := P) K d e).hom.f i).hom
    (barycentricKoszulOrderAut_weight_basis K d e i) _ _
    (barycentricKoszulOrderAut_relativeDegree K d Q e hstable j i) n

theorem barycentricRelativeBigradedOrderMap_incoming (j n i : ℕ) :
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n i).comp
      (barycentricRelativeBigradedIncoming (P := P) K d Q j n i) =
      (barycentricRelativeBigradedIncoming (P := P) K d Q j n i).comp
        (barycentricRelativeBigradedOrderMap K d e Q hstable j n (i + 1)) := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Subtype.ext
  exact (congrArg (fun f => f x.val.val) ((barycentricKoszulOrderAut (P := P) K d e).hom.comm (i + 1) i)).symm

theorem barycentricRelativeBigradedOrderMap_outgoing (j n i : ℕ) :
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n (i - 1)).comp
      (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i) =
      (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i).comp
        (barycentricRelativeBigradedOrderMap K d e Q hstable j n i) := by
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Subtype.ext
  exact (congrArg (fun f => f x.val.val) ((barycentricKoszulOrderAut (P := P) K d e).hom.comm i (i - 1))).symm

def barycentricRelativeBigradedHomologyAction (j n i : ℕ) :
    Module.End K (barycentricRelativeBigradedHomology (P := P) K d Q j n i) :=
  inducedHomologyMap _ _ (barycentricRelativeBigraded_complex K d Q j n i)
    _ _ (barycentricRelativeBigraded_complex K d Q j n i)
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n (i + 1))
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n i)
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n (i - 1))
    (barycentricRelativeBigradedOrderMap_incoming K d e Q hstable j n i)
    (barycentricRelativeBigradedOrderMap_outgoing K d e Q hstable j n i)

variable (hs : IsSimplicialPoset P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

theorem barycentricRelativeGradeWeightEquiv_equivariant (j i n : ℕ)
    (x : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n) :
    barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n
      (gradeMap _ _ ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f i).hom
        (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j i) n x) =
      barycentricRelativeBigradedOrderMap K d e Q hstable j n i
        (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n x) :=
  (basisRestrictedGradeEquiv_differential _ _ _ _
    ((barycentricKoszulOrderAut (P := P) K d e).hom.f i).hom
    (barycentricKoszulOrderAut_weight_basis K d e i) _ _
    (barycentricKoszulOrderAut_relativeDegree K d Q e hstable j i)
    (barycentricWeightProjection_relativeDegree K hs d Q hQ j i)
    (barycentricWeightProjection_relativeDegree K hs d Q hQ j i) n x).symm

theorem barycentricRelativeGradeWeightHomology_equivariant (j i n : ℕ)
    (x : complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d Q j)
      (barycentricRelativeDegreeFiltration (P := P) K d Q j)
      (barycentricRelativeDegreeIncoming_preserves K d Q j) i n) :
    barycentricRelativeGradeWeightHomology K d Q hs hQ j i n
      (barycentricRelativeGradedHomologyAction K d Q e hstable j i n x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (barycentricRelativeGradeWeightHomology K d Q hs hQ j i n x) :=
  chainHomologyEquiv_intertwines _ _ _ _ _ _ _ _ _ _ _
    (gradeMap _ _ ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f (i + 1)).hom
      (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j (i + 1)) n)
    (gradeMap _ _ ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f i).hom
      (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j i) n)
    (gradeMap _ _ ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f (i - 1)).hom
      (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j (i - 1)) n)
    (gradeMap_square
      (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i)
      (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i)
      ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f (i + 1)).hom
      ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f i).hom
      (congrArg (fun f => f.hom)
        ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).comm (i + 1) i)).symm
      _ _ _ _ (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j (i + 1))
      (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j i)
      (barycentricRelativeDegreeIncoming_preserves K d Q j i)
      (barycentricRelativeDegreeIncoming_preserves K d Q j i) n)
    (gradeMap_square
      (complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q j) i)
      (complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q j) i)
      ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f i).hom
      ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).f (i - 1)).hom
      (congrArg (fun f => f.hom)
        ((barycentricRelativeInternalOrderMap (P := P) K d Q e hstable j).comm i (i - 1))).symm
      _ _ _ _ (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j i)
      (barycentricRelativeInternalOrderMap_filtered K d Q e hstable j (i - 1))
      (complexOutgoing_preserves _ _ (barycentricRelativeDegreeIncoming_preserves K d Q j) i)
      (complexOutgoing_preserves _ _ (barycentricRelativeDegreeIncoming_preserves K d Q j) i) n)
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n (i + 1))
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n i)
    (barycentricRelativeBigradedOrderMap K d e Q hstable j n (i - 1))
    (barycentricRelativeBigradedOrderMap_incoming K d e Q hstable j n i)
    (barycentricRelativeBigradedOrderMap_outgoing K d e Q hstable j n i)
    (barycentricRelativeGradeWeightEquiv_equivariant K d e Q hstable hs hQ j i n) x

/-- The intrinsic finite relative filtration identifies equivariantly with
the genuine relative barycentric weight strands. -/
theorem originalRelativeAssociatedBigradedHomology_equivariant
    (hrank : ∀ p : P, faceRank p ≤ d) (j i n : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) n) :
    originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank j i n
      (gradeMap _ _ (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i)
        (originalRelativeInternalHomologyAction_filtered K hs d hrank Q e hstable j i) n x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank j i n x) := by
  change barycentricRelativeGradeWeightHomology K d Q hs hQ j i n
      (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank j i n _) = _
  rw [relativeInternalAssociatedGradedComparison_equivariant]
  exact barycentricRelativeGradeWeightHomology_equivariant K d e Q hstable hs hQ j i n _

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeAbsoluteComparison -/
section

/-! # The empty relative pair is exactly the absolute construction -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def originalEmptyRelativeTermEquiv (j i : ℕ) :
    originalRelativeDegreeTerm K hs d (∅ : Set P) j i ≃ₗ[K] originalKoszulDegreePiece K hs d i j :=
  LinearEquiv.ofEq _ _ (originalRelativeDegreeTerm_empty K hs d j i)

def barycentricEmptyRelativeTermEquiv (j i : ℕ) :
    barycentricRelativeDegreeTerm (P := P) K d (∅ : Set P) j i ≃ₗ[K]
      barycentricKoszulDegreePiece (P := P) K d i j :=
  LinearEquiv.ofEq _ _ (barycentricRelativeDegreeTerm_empty K d j i)

def originalEmptyRelativeComplexIso (j : ℕ) :
    originalRelativeDegreeComplex K hs d (∅ : Set P) hrank j ≅ originalKoszulDegreeComplex K hs d hrank j :=
  HomologicalComplex.Hom.isoOfComponents (fun i => (originalEmptyRelativeTermEquiv K hs d j i).toModuleIso) (by
    intro i k hik
    obtain rfl : i = k + 1 := hik.symm
    simp only [originalRelativeDegreeComplex, submoduleComplex_d, originalKoszulDegreeComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply,
      LinearEquiv.toModuleIso_hom, LinearEquiv.coe_coe,
      originalEmptyRelativeTermEquiv, barycentricEmptyRelativeTermEquiv,
      originalKoszulDegreeDifferential, barycentricKoszulDegreeDifferential,
      restrictedMap, LinearEquiv.coe_ofEq_apply, complexIncoming,
      originalKoszulComplex, barycentricKoszulComplex, parameterKoszulComplex_d]
    rfl)

def barycentricEmptyRelativeComplexIso (j : ℕ) :
    barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j ≅ barycentricKoszulDegreeComplex (P := P) K d j :=
  HomologicalComplex.Hom.isoOfComponents (fun i => (barycentricEmptyRelativeTermEquiv (P := P) K d j i).toModuleIso) (by
    intro i k hik
    obtain rfl : i = k + 1 := hik.symm
    simp only [barycentricRelativeDegreeComplex, submoduleComplex_d, barycentricKoszulDegreeComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply,
      LinearEquiv.toModuleIso_hom, LinearEquiv.coe_coe,
      originalEmptyRelativeTermEquiv, barycentricEmptyRelativeTermEquiv,
      originalKoszulDegreeDifferential, barycentricKoszulDegreeDifferential,
      restrictedMap, LinearEquiv.coe_ofEq_apply, complexIncoming,
      originalKoszulComplex, barycentricKoszulComplex, parameterKoszulComplex_d]
    rfl)

def originalEmptyRelativeHomologyEquiv (j i : ℕ) :
    originalRelativeInternalHomology K hs d (∅ : Set P) hrank j i ≃ₗ[K]
      originalInternalKoszulHomology K hs d hrank j i :=
  complexKernelHomologyEquiv (originalEmptyRelativeComplexIso K hs d hrank j) i

theorem originalEmptyRelativeHomologyEquiv_filtered (j i n : ℕ)
    (x : originalRelativeInternalHomology K hs d (∅ : Set P) hrank j i) :
    originalEmptyRelativeHomologyEquiv K hs d hrank j i x ∈
        (originalInternalHomologyFiltration K hs d hrank j i).level n ↔
      x ∈ (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i).level n :=
  complexKernelHomologyEquiv_filtered (originalEmptyRelativeComplexIso K hs d hrank j) _ _
    (fun i n y => by
      change ((originalEmptyRelativeTermEquiv K hs d j i) y).val ∈
        (originalKoszulFiltration K hs d i).level n ↔
        y.val ∈ (originalKoszulFiltration K hs d i).level n
      rfl) i n x

/-- The absolute filtration is literally the empty-pair relative filtration
under the identity-on-coefficients homology identification. -/
def originalEmptyRelativeGradeEquiv (j i n : ℕ) :
    Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n ≃ₗ[K]
      Grade (originalInternalHomologyFiltration K hs d hrank j i) n :=
  gradeEquiv _ _ (originalEmptyRelativeHomologyEquiv K hs d hrank j i)
    (originalEmptyRelativeHomologyEquiv_filtered K hs d hrank j i) n

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ParameterTorComparison -/
section

/-! # The ordinary derived Tor modules of the original presentations

The actual parameter-module equivalence induces an isomorphism of Mathlib's
derived tensor functor.  This map is not asserted to be equivariant: equivariance
belongs to the canonical associated graded comparison established separately.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open CategoryTheory
universe u
variable {K P : Type u} [CommRing K] [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

local instance originalParameterAlgebra : Algebra (MvPolynomial (Fin d) K) (FaceRing K hs) :=
  (faceParameterAction K hs d).toRingHom.toAlgebra
local instance barycentricParameterAlgebra :
    Algebra (MvPolynomial (Fin d) K) (BarycentricRing (P := P) K) :=
  (barycentricParameterAction (P := P) K d).toRingHom.toAlgebra

def originalParameterTor (m : ℕ) : ModuleCat.{u} K :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial (Fin d) K))).obj
    (((Tor (ModuleCat (MvPolynomial (Fin d) K)) m).obj
      (ModuleCat.of (MvPolynomial (Fin d) K) (FaceRing K hs))).obj
        (CommAlg.Koszul.residueCoefficientModule (V := Fin d) (k := K)))

def barycentricParameterTor (m : ℕ) : ModuleCat.{u} K :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial (Fin d) K))).obj
    (((Tor (ModuleCat (MvPolynomial (Fin d) K)) m).obj
      (ModuleCat.of (MvPolynomial (Fin d) K) (BarycentricRing (P := P) K))).obj
        (CommAlg.Koszul.residueCoefficientModule (V := Fin d) (k := K)))

/-- Actual derived Tor comparison, over every commutative coefficient ring,
including the zero ring.  This is a consequence of the already proved module
theorem, not a definition of either Tor module. -/
def parameterTorComparison (m : ℕ) :
    originalParameterTor K hs d m ≅ barycentricParameterTor (P := P) K d m :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial (Fin d) K))).mapIso
    (((Tor (ModuleCat (MvPolynomial (Fin d) K)) m).mapIso
      (theoremOneParameterModuleEquiv K hs d hrank).toModuleIso).app
        (CommAlg.Koszul.residueCoefficientModule (V := Fin d) (k := K)))

end FourPapers.Universal

#print axioms FourPapers.Universal.parameterTorComparison

end
end

/- BEGIN FourPapers.Universal.ParameterTorKoszul -/
section

/-! # The actual ordinary Tor functor and coefficient Koszul homology

The second argument is the coefficient ring with its augmentation action.
The comparison is obtained from the proved polynomial Koszul resolution and
an identity-on-coordinates restriction of scalars.  The zero ring is handled
explicitly and needs no nontriviality hypothesis.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg
universe u v
section ParameterGenerality
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]
variable (φ : MvPolynomial C K →ₐ[K] B)

def ordinaryParameterTor (i : ℕ) : ModuleCat.{u} K := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact (ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).obj
    (((Tor (ModuleCat (MvPolynomial C K)) i).obj
      (ModuleCat.of (MvPolynomial C K) B)).obj
        (Koszul.residueCoefficientModule (V := C) (k := K)))

def parameterRestrictionEquiv (i : ℕ) :
    letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).obj
      (ModuleCat.of (MvPolynomial C K) (Set.powersetCard C i →₀ B))) ≃ₗ[K]
      (Set.powersetCard C i →₀ B) := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact {
    toFun := id
    invFun := id
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_add' := fun _ _ => rfl
    map_smul' := fun r x => by
      change (algebraMap K (MvPolynomial C K) r) •
        (show Set.powersetCard C i →₀ B from x) = r • (show Set.powersetCard C i →₀ B from x)
      exact algebraMap_smul (MvPolynomial C K) r (show Set.powersetCard C i →₀ B from x) }

theorem parameterRestriction_differential (i : ℕ) :
    letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
    (Koszul.coordinateDifferential (MvPolynomial.X : C → MvPolynomial C K)
      (ModuleCat.of (MvPolynomial C K) B) i).restrictScalars K =
        parameterKoszulDifferential (K := K) (fun j => φ (MvPolynomial.X j)) i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  apply Finsupp.lhom_ext
  intro s b
  change Koszul.coordinateDifferential (MvPolynomial.X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) B) i (Finsupp.single s b) = _
  rw [Koszul.coordinateDifferential_single, parameterKoszulDifferential_single]
  apply Finset.sum_congr rfl
  intro j hj
  congr 1

/-- Identity on the ordinary exterior-coordinate coefficient modules. -/
def parameterRestrictionComplexIso :
    letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
        (Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K)
          (ModuleCat.of (MvPolynomial C K) B)) ≅
      parameterKoszulComplex (K := K) (fun j => φ (MvPolynomial.X j)) := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact HomologicalComplex.Hom.isoOfComponents (fun i => (parameterRestrictionEquiv φ i).toModuleIso) (by
    intro i j hij
    obtain rfl : i = j + 1 := hij.symm
    simp only [Functor.mapHomologicalComplex_obj_d, Koszul.coordinateComplex_d,
      parameterKoszulComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact (LinearMap.congr_fun (parameterRestriction_differential φ j) x).symm)

def ordinaryParameterTorKoszulIsoNontrivial [Nontrivial K] (i : ℕ) :
    ordinaryParameterTor φ i ≅ (parameterKoszulComplex (K := K) (fun j => φ (MvPolynomial.X j))).homology i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let M := ModuleCat.of (MvPolynomial C K) B
  let Cx := Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K) M
  exact F.mapIso (ordinaryFinitePolynomialTorIso i M ≪≫
    (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).mapIso
      (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) M)) ≪≫
    ((Cx.sc i).mapHomologyIso F).symm ≪≫
    (HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).mapIso
      (parameterRestrictionComplexIso φ)

def ordinaryParameterTorKoszulIso (i : ℕ) :
    ordinaryParameterTor φ i ≅ (parameterKoszulComplex (K := K) (fun j => φ (MvPolynomial.X j))).homology i := by
  by_cases h : Nontrivial K
  · letI := h
    exact ordinaryParameterTorKoszulIsoNontrivial φ i
  · letI : Subsingleton K := not_nontrivial_iff_subsingleton.mp h
    let T : ModuleCat.{u} K := ordinaryParameterTor φ i
    let H : ModuleCat.{u} K := (parameterKoszulComplex (K := K) (fun j => φ (MvPolynomial.X j))).homology i
    letI : Subsingleton T := Module.subsingleton K T
    letI : Subsingleton H := Module.subsingleton K H
    exact (LinearEquiv.ofSubsingleton T H).toModuleIso

end ParameterGenerality

section Original
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

def originalParameterTorKoszulIso (i : ℕ) :
    originalParameterTor K hs d i ≅ (originalKoszulComplex K hs d).homology i := by
  simpa only [originalParameterTor, ordinaryParameterTor, originalKoszulComplex,
    faceParameterAction, MvPolynomial.aeval_X] using
    ordinaryParameterTorKoszulIso (faceParameterAction K hs d) i

def barycentricParameterTorKoszulIso (i : ℕ) :
    barycentricParameterTor (P := P) K d i ≅ (barycentricKoszulComplex (P := P) K d).homology i := by
  simpa only [barycentricParameterTor, ordinaryParameterTor, barycentricKoszulComplex,
    barycentricParameterAction, MvPolynomial.aeval_X] using
    ordinaryParameterTorKoszulIso (barycentricParameterAction (P := P) K d) i

def originalParameterTorKernelIso (i : ℕ) :
    originalParameterTor K hs d i ≅ ModuleCat.of K (originalKoszulHomology K hs d i) :=
  originalParameterTorKoszulIso K hs d i ≪≫ complexKernelHomologyIso _ i

end Original
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.TorFunctorNaturality -/
section

/-! # Naturality of the chosen-resolution and Koszul-coordinate Tor comparisons

All actions used later are the ordinary derived-functor actions.  The
comparison maps are proved natural in the coefficient module; no group
action is defined by transporting it across a noncanonical isomorphism.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CategoryTheory.MonoidalCategory CommAlg
open scoped TensorProduct

section IsoSquares
variable {E : Type*} [Category E] {A B D A' B' D' : E}

theorem isoSquare_symm (e : A ≅ B) (e' : A' ≅ B') (f : A ⟶ A') (g : B ⟶ B')
    (h : f ≫ e'.hom = e.hom ≫ g) : g ≫ e'.inv = e.inv ≫ f := by
  apply (cancel_epi e.hom).mp
  rw [← Category.assoc, ← h, Category.assoc, Iso.hom_inv_id, Category.comp_id,
    Iso.hom_inv_id_assoc]

theorem isoSquare_trans (e : A ≅ B) (e' : A' ≅ B') (q : B ≅ D) (q' : B' ≅ D')
    (f : A ⟶ A') (g : B ⟶ B') (h : D ⟶ D')
    (he : f ≫ e'.hom = e.hom ≫ g) (hq : g ≫ q'.hom = q.hom ≫ h) :
    f ≫ (e' ≪≫ q').hom = (e ≪≫ q).hom ≫ h := by
  change f ≫ (e'.hom ≫ q'.hom) = (e.hom ≫ q.hom) ≫ h
  rw [← Category.assoc, he, Category.assoc, hq, ← Category.assoc]
end IsoSquares

section Derived
variable {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D]
  [HasProjectiveResolutions C]
  {F G : C ⥤ D} [F.Additive] [G.Additive]

/-- Naturality in the additive functor, at a fixed proved projective resolution. -/
theorem resolutionComparison_natural (α : F ⟶ G) {X : C}
    (P : ProjectiveResolution X) (i : ℕ) :
    (NatTrans.leftDerived α i).app X ≫ (P.isoLeftDerivedObj G i).hom =
      (P.isoLeftDerivedObj F i).hom ≫
        HomologicalComplex.homologyMap ((NatTrans.mapHomologicalComplex α _).app P.complex) i := by
  rw [ProjectiveResolution.leftDerived_app_eq α P i]
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  rfl
end Derived

universe u v
variable {R : Type u} [CommRing R]

lemma tensorOrderIso_natural {M N : ModuleCat.{u} R} (f : M ⟶ N) :
    (tensoringRight (ModuleCat R)).map f ≫ (tensorOrderIso N).hom =
      (tensorOrderIso M).hom ≫ (tensoringLeft (ModuleCat R)).map f := by
  apply NatTrans.ext
  funext X
  apply ModuleCat.hom_ext
  apply TensorProduct.ext'
  intro x m
  rfl

theorem torArgumentOrderIso_natural (i : ℕ) (X : ModuleCat.{u} R)
    {M N : ModuleCat.{u} R} (f : M ⟶ N) :
    ((Tor' (ModuleCat R) i).obj X).map f ≫ (torArgumentOrderIso i X N).hom =
      (torArgumentOrderIso i X M).hom ≫ ((Tor (ModuleCat R) i).map f).app X := by
  have h := congrArg
    (fun α : (tensoringRight (ModuleCat R)).obj M ⟶ (tensoringLeft (ModuleCat R)).obj N =>
      (NatTrans.leftDerived α i).app X) (tensorOrderIso_natural f)
  change (NatTrans.leftDerived ((tensoringRight (ModuleCat R)).map f) i).app X ≫
      (NatTrans.leftDerived (tensorOrderIso N).hom i).app X =
    (NatTrans.leftDerived (tensorOrderIso M).hom i).app X ≫
      (NatTrans.leftDerived ((tensoringLeft (ModuleCat R)).map f) i).app X
  simpa only [NatTrans.leftDerived_comp, NatTrans.comp_app] using h

variable {V : Type} [Fintype V] [LinearOrder V]

section Polynomial
variable {K : Type u} [CommRing K]

theorem finitePolynomialTorCoefficientIso_natural (i : ℕ)
    {M N : ModuleCat.{u} (MvPolynomial V K)} (f : M ⟶ N) :
    ((Tor' (ModuleCat (MvPolynomial V K)) i).obj
      (ModuleCat.of (MvPolynomial V K) (Koszul.FiniteResidue V K))).map f ≫
        (Koszul.finitePolynomialTorCoefficientIso i N).hom =
      (Koszul.finitePolynomialTorCoefficientIso i M).hom ≫
        ((Tor' (ModuleCat (MvPolynomial V K)) i).obj
          (Koszul.residueCoefficientModule (V := V) (k := K))).map f :=
  ((Tor' (ModuleCat (MvPolynomial V K)) i).map
    (Koszul.residueCoefficientIso (V := V) (k := K)).hom).naturality f

lemma finiteCoefficientComplexIso_natural
    {M N : ModuleCat.{u} (MvPolynomial V K)} (f : M ⟶ N) :
    tensorCoefficientMap (koszulComplex.ofList (Koszul.finiteVariableList (V := V) (k := K))) f ≫
      (Koszul.finiteCoefficientComplexIso N).hom =
        (Koszul.finiteCoefficientComplexIso M).hom ≫
          familyCoefficientMap (MvPolynomial.X : V → MvPolynomial V K) f := by
  exact ((NatTrans.mapHomologicalComplex
    ((tensoringRight (ModuleCat (MvPolynomial V K))).map f) (ComplexShape.down ℕ)).naturality
      (Koszul.finiteVariableKoszulIso (V := V) (k := K)).hom).symm

theorem finitePolynomialTorIso_natural [Nontrivial K] (i : ℕ)
    {M N : ModuleCat.{u} (MvPolynomial V K)} (f : M ⟶ N) :
    ((Tor' (ModuleCat (MvPolynomial V K)) i).obj
      (ModuleCat.of (MvPolynomial V K) (Koszul.FiniteResidue V K))).map f ≫
        (Koszul.finitePolynomialTorIso i N).hom =
      (Koszul.finitePolynomialTorIso i M).hom ≫
        HomologicalComplex.homologyMap (familyCoefficientMap (MvPolynomial.X : V → MvPolynomial V K) f) i := by
  have hr := resolutionComparison_natural ((tensoringRight (ModuleCat (MvPolynomial V K))).map f)
    (Koszul.finitePolynomialResolution (V := V) (k := K)) i
  have hc := congrArg (fun a => (HomologicalComplex.homologyFunctor
    (ModuleCat (MvPolynomial V K)) (ComplexShape.down ℕ) i).map a)
      (finiteCoefficientComplexIso_natural f)
  simp only [Functor.map_comp] at hc
  dsimp only [Koszul.finitePolynomialTorIso, Iso.trans_hom, Functor.mapIso_hom]
  simp only [Tor'_obj_map]
  rw [← Category.assoc]
  erw [hr]
  rw [Category.assoc]
  change _ ≫ ((HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial V K))
      (ComplexShape.down ℕ) i).map _ ≫
      (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial V K))
        (ComplexShape.down ℕ) i).map _) = _
  erw [hc]
  rw [← Category.assoc]
  rfl

/-- The standard Tor action is the coefficientwise Koszul action, before
any combinatorial or filtered comparison is applied. -/
theorem ordinaryFinitePolynomialTorIso_natural [Nontrivial K] (i : ℕ)
    {M N : ModuleCat.{u} (MvPolynomial V K)} (f : M ⟶ N) :
    ((Tor (ModuleCat (MvPolynomial V K)) i).map f).app
        (Koszul.residueCoefficientModule (V := V) (k := K)) ≫
      (ordinaryFinitePolynomialTorIso i N).hom =
        (ordinaryFinitePolynomialTorIso i M).hom ≫
          HomologicalComplex.homologyMap
            (familyCoefficientMap (MvPolynomial.X : V → MvPolynomial V K) f) i := by
  have ho := torArgumentOrderIso_natural i (Koszul.residueCoefficientModule (V := V) (k := K)) f
  have hc := finitePolynomialTorCoefficientIso_natural i f
  have hp := finitePolynomialTorIso_natural i f
  exact isoSquare_trans
    ((torArgumentOrderIso i (Koszul.residueCoefficientModule (V := V) (k := K)) M).symm ≪≫
      (Koszul.finitePolynomialTorCoefficientIso i M).symm)
    ((torArgumentOrderIso i (Koszul.residueCoefficientModule (V := V) (k := K)) N).symm ≪≫
      (Koszul.finitePolynomialTorCoefficientIso i N).symm)
    (Koszul.finitePolynomialTorIso i M) (Koszul.finitePolynomialTorIso i N) _ _ _
    (isoSquare_trans _ _ _ _ _ _ _
      (isoSquare_symm _ _ _ _ ho) (isoSquare_symm _ _ _ _ hc)) hp

end Polynomial
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ParameterTorNaturality -/
section

/-! # The derived Tor comparison intertwines the actual coefficient actions -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg
universe u v
variable {K B B' : Type u} {C : Type} [CommRing K] [CommRing B] [CommRing B']
  [Algebra K B] [Algebra K B'] [Fintype C] [LinearOrder C]
variable (φ : MvPolynomial C K →ₐ[K] B) (ψ : MvPolynomial C K →ₐ[K] B')
variable (f :
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
  B →ₗ[MvPolynomial C K] B')

theorem parameterCoefficientMap_intertwines (j : C) (b : B) :
    f (φ (MvPolynomial.X j) * b) = ψ (MvPolynomial.X j) * f b := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
  exact f.map_smul (MvPolynomial.X j) b

def parameterCoefficientKoszulMap :
    parameterKoszulComplex (K := K) (fun j => φ (MvPolynomial.X j)) ⟶
      parameterKoszulComplex (K := K) (fun j => ψ (MvPolynomial.X j)) := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
  exact parameterKoszulMap _ _ (f.restrictScalars K) (parameterCoefficientMap_intertwines φ ψ f)

def ordinaryParameterTorMap (i : ℕ) : ordinaryParameterTor φ i ⟶ ordinaryParameterTor ψ i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
  exact (ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).map
    (((Tor (ModuleCat (MvPolynomial C K)) i).map (ModuleCat.ofHom f)).app
      (Koszul.residueCoefficientModule (V := C) (k := K)))

theorem parameterRestrictionComplexIso_natural :
    letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
    letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapHomologicalComplex
      (ComplexShape.down ℕ)).map
        (coordinateCoefficientMap (MvPolynomial.X : C → MvPolynomial C K) (ModuleCat.ofHom f)) ≫
        (parameterRestrictionComplexIso ψ).hom =
      (parameterRestrictionComplexIso φ).hom ≫ parameterCoefficientKoszulMap φ ψ f := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Finsupp.ext
  intro s
  rfl

theorem ordinaryParameterTorKoszulIso_natural_nontrivial [Nontrivial K] (i : ℕ) :
    ordinaryParameterTorMap φ ψ f i ≫ (ordinaryParameterTorKoszulIsoNontrivial ψ i).hom =
      (ordinaryParameterTorKoszulIsoNontrivial φ i).hom ≫
        HomologicalComplex.homologyMap (parameterCoefficientKoszulMap φ ψ f) i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  letI : Algebra (MvPolynomial C K) B' := ψ.toRingHom.toAlgebra
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let M := ModuleCat.of (MvPolynomial C K) B
  let N := ModuleCat.of (MvPolynomial C K) B'
  let Cx := Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K) M
  let Cy := Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K) N
  let hmap := coordinateCoefficientMap (MvPolynomial.X : C → MvPolynomial C K) (ModuleCat.ofHom f)
  have hc := congrArg
    (fun a => (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K))
      (ComplexShape.down ℕ) i).map a)
    (coordinateComplexIso_natural (MvPolynomial.X : C → MvPolynomial C K) (ModuleCat.ofHom f))
  simp only [Functor.map_comp] at hc
  have ht := isoSquare_trans
    (ordinaryFinitePolynomialTorIso i M) (ordinaryFinitePolynomialTorIso i N)
    ((HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K))
      (ComplexShape.down ℕ) i).mapIso (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) M))
    ((HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K))
      (ComplexShape.down ℕ) i).mapIso (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) N))
    _ _ _ (ordinaryFinitePolynomialTorIso_natural i (ModuleCat.ofHom f)) hc
  have htF := congrArg (fun a => F.map a) ht
  simp only [Functor.map_comp] at htF
  have hs := ShortComplex.mapHomologyIso_inv_naturality
    ((HomologicalComplex.shortComplexFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).map hmap) F
  have hp := congrArg
    (fun a => (HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).map a)
    (parameterRestrictionComplexIso_natural φ ψ f)
  simp only [Functor.map_comp] at hp
  exact isoSquare_trans
    (F.mapIso (ordinaryFinitePolynomialTorIso i M ≪≫
      (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).mapIso
        (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) M)) ≪≫
      ((Cx.sc i).mapHomologyIso F).symm)
    (F.mapIso (ordinaryFinitePolynomialTorIso i N ≪≫
      (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).mapIso
        (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) N)) ≪≫
      ((Cy.sc i).mapHomologyIso F).symm)
    ((HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).mapIso
      (parameterRestrictionComplexIso φ))
    ((HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).mapIso
      (parameterRestrictionComplexIso ψ)) _ _ _
    (isoSquare_trans _ _ _ _ _ _ _ htF hs) hp

/-- Naturality, including the zero coefficient ring, for every genuine
parameter-module morphism. -/
theorem ordinaryParameterTorKoszulIso_natural (i : ℕ) :
    ordinaryParameterTorMap φ ψ f i ≫ (ordinaryParameterTorKoszulIso ψ i).hom =
      (ordinaryParameterTorKoszulIso φ i).hom ≫
        HomologicalComplex.homologyMap (parameterCoefficientKoszulMap φ ψ f) i := by
  by_cases h : Nontrivial K
  · letI := h
    simpa only [ordinaryParameterTorKoszulIso, dif_pos h] using
      ordinaryParameterTorKoszulIso_natural_nontrivial φ ψ f i
  · letI : Subsingleton K := not_nontrivial_iff_subsingleton.mp h
    letI := Module.subsingleton K
      ((parameterKoszulComplex (K := K) (fun j => ψ (MvPolynomial.X j))).homology i)
    apply ModuleCat.hom_ext
    ext x
    exact Subsingleton.elim _ _

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ModuleTorKoszul -/
section

/-! # Ordinary Tor and coordinate Koszul homology for arbitrary modules

This is the natural derived-functor comparison for arbitrary parameter
modules, including restriction ideals.  No ring structure on the
coefficient module is used.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg
universe u v
variable {K : Type u} {C : Type} [CommRing K] [Fintype C] [LinearOrder C]

def ordinaryModuleParameterTor (M : ModuleCat.{u} (MvPolynomial C K)) (i : ℕ) : ModuleCat.{u} K :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).obj
    (((Tor (ModuleCat (MvPolynomial C K)) i).obj M).obj
      (Koszul.residueCoefficientModule (V := C) (k := K)))

def ordinaryModuleParameterTorMap {M N : ModuleCat.{u} (MvPolynomial C K)} (f : M ⟶ N) (i : ℕ) :
    ordinaryModuleParameterTor M i ⟶ ordinaryModuleParameterTor N i :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).map
    (((Tor (ModuleCat (MvPolynomial C K)) i).map f).app
      (Koszul.residueCoefficientModule (V := C) (k := K)))

def moduleTorCoordinateComplex (M : ModuleCat.{u} (MvPolynomial C K)) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapHomologicalComplex
    (ComplexShape.down ℕ)).obj (Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K) M)

def moduleTorCoordinateMap {M N : ModuleCat.{u} (MvPolynomial C K)} (f : M ⟶ N) :
    moduleTorCoordinateComplex M ⟶ moduleTorCoordinateComplex N :=
  ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapHomologicalComplex
    (ComplexShape.down ℕ)).map (coordinateCoefficientMap (MvPolynomial.X : C → MvPolynomial C K) f)

def ordinaryModuleTorCoordinateIsoNontrivial [Nontrivial K]
    (M : ModuleCat.{u} (MvPolynomial C K)) (i : ℕ) :
    ordinaryModuleParameterTor M i ≅ (moduleTorCoordinateComplex M).homology i :=
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  F.mapIso (ordinaryFinitePolynomialTorIso i M ≪≫
    (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).mapIso
      (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) M)) ≪≫
    (((Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K) M).sc i).mapHomologyIso F).symm

def ordinaryModuleTorCoordinateIso (M : ModuleCat.{u} (MvPolynomial C K)) (i : ℕ) :
    ordinaryModuleParameterTor M i ≅ (moduleTorCoordinateComplex M).homology i := by
  by_cases h : Nontrivial K
  · letI := h
    exact ordinaryModuleTorCoordinateIsoNontrivial M i
  · letI : Subsingleton K := not_nontrivial_iff_subsingleton.mp h
    let T : ModuleCat.{u} K := ordinaryModuleParameterTor M i
    let H : ModuleCat.{u} K := (moduleTorCoordinateComplex M).homology i
    letI : Subsingleton T := Module.subsingleton K T
    letI : Subsingleton H := Module.subsingleton K H
    exact (LinearEquiv.ofSubsingleton T H).toModuleIso

theorem ordinaryModuleTorCoordinateIso_natural_nontrivial [Nontrivial K]
    {M N : ModuleCat.{u} (MvPolynomial C K)} (f : M ⟶ N) (i : ℕ) :
    ordinaryModuleParameterTorMap f i ≫ (ordinaryModuleTorCoordinateIsoNontrivial N i).hom =
      (ordinaryModuleTorCoordinateIsoNontrivial M i).hom ≫
        HomologicalComplex.homologyMap (moduleTorCoordinateMap f) i := by
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let hmap := coordinateCoefficientMap (MvPolynomial.X : C → MvPolynomial C K) f
  have hc := congrArg
    (fun a => (HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K))
      (ComplexShape.down ℕ) i).map a)
    (coordinateComplexIso_natural (MvPolynomial.X : C → MvPolynomial C K) f)
  simp only [Functor.map_comp] at hc
  have ht := isoSquare_trans
    (ordinaryFinitePolynomialTorIso i M) (ordinaryFinitePolynomialTorIso i N)
    ((HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K))
      (ComplexShape.down ℕ) i).mapIso (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) M))
    ((HomologicalComplex.homologyFunctor (ModuleCat (MvPolynomial C K))
      (ComplexShape.down ℕ) i).mapIso (Koszul.coordinateComplexIso (MvPolynomial.X : C → MvPolynomial C K) N))
    _ _ _ (ordinaryFinitePolynomialTorIso_natural i f) hc
  have htF := congrArg (fun a => F.map a) ht
  simp only [Functor.map_comp] at htF
  have hs := ShortComplex.mapHomologyIso_inv_naturality
    ((HomologicalComplex.shortComplexFunctor (ModuleCat (MvPolynomial C K)) (ComplexShape.down ℕ) i).map hmap) F
  exact isoSquare_trans _ _ _ _ _ _ _ htF hs

/-- Every coefficient action here is the actual derived Tor action. -/
theorem ordinaryModuleTorCoordinateIso_natural
    {M N : ModuleCat.{u} (MvPolynomial C K)} (f : M ⟶ N) (i : ℕ) :
    ordinaryModuleParameterTorMap f i ≫ (ordinaryModuleTorCoordinateIso N i).hom =
      (ordinaryModuleTorCoordinateIso M i).hom ≫ HomologicalComplex.homologyMap (moduleTorCoordinateMap f) i := by
  by_cases h : Nontrivial K
  · letI := h
    simpa only [ordinaryModuleTorCoordinateIso, dif_pos h] using
      ordinaryModuleTorCoordinateIso_natural_nontrivial f i
  · letI : Subsingleton K := not_nontrivial_iff_subsingleton.mp h
    letI := Module.subsingleton K ((moduleTorCoordinateComplex N).homology i)
    apply ModuleCat.hom_ext
    ext x
    exact Subsingleton.elim _ _

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.IdealParameterTor -/
section

/-! # Genuine derived Tor of an actual restriction ideal

A finitely supported function valued in the ideal is identified with the
literal submodule of ambient coefficient functions valued in that ideal.
The resulting chain comparison is identity on every coefficient.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg FourPapers.FilteredHomology
universe u v
section ParameterGenerality
variable {K T B : Type u} {C : Type} [CommRing K] [CommRing T] [Algebra K T]
  [CommRing B] [Algebra K B]

/-- Identity on elements, with the two scalar actions compared explicitly. -/
def moduleRestrictionEquiv (M : Type u) [AddCommGroup M] [Module T M] [Module K M]
    [IsScalarTower K T M] :
    ((ModuleCat.restrictScalars (algebraMap K T)).obj (ModuleCat.of T M)) ≃ₗ[K] M where
  toFun := id
  invFun := id
  left_inv x := rfl
  right_inv x := rfl
  map_add' x y := rfl
  map_smul' k x := by
    change (algebraMap K T k) • (show M from x) = k • (show M from x)
    exact algebraMap_smul T k (show M from x)

def idealCoefficientEquiv (S : Type*) [Finite S] (I : Ideal B) :
    (S →₀ I) ≃ₗ[K] idealCoefficientSubmodule (K := K) S I where
  toFun x := ⟨Finsupp.mapRange.linearMap (I.subtype.restrictScalars K) x, fun s => (x s).property⟩
  invFun x := Finsupp.equivFunOnFinite.symm (fun s => (⟨x.val s, x.property s⟩ : I))
  left_inv x := by ext s; rfl
  right_inv x := by apply Subtype.ext; ext s; rfl
  map_add' x y := by apply Subtype.ext; ext s; rfl
  map_smul' k x := by apply Subtype.ext; ext s; rfl

@[simp] theorem idealCoefficientEquiv_apply (S : Type*) [Finite S] (I : Ideal B)
    (x : S →₀ I) (s : S) : (idealCoefficientEquiv (K := K) S I x).val s = (x s).val := rfl

variable [Fintype C] [LinearOrder C]
variable (φ : MvPolynomial C K →ₐ[K] B)
variable (I : Ideal B)

def idealParameterCoefficientModule : ModuleCat.{u} (MvPolynomial C K) := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact ModuleCat.of (MvPolynomial C K) I

def ordinaryIdealParameterTor (i : ℕ) : ModuleCat.{u} K :=
  ordinaryModuleParameterTor (idealParameterCoefficientModule φ I) i

theorem parameterIdealTerm_preserved (i : ℕ)
    (x : (parameterKoszulComplex (K := K) (fun c => φ (MvPolynomial.X c))).X (i + 1))
    (hx : x ∈ idealCoefficientSubmodule (K := K) _ I) :
    complexIncoming (parameterKoszulComplex (K := K) (fun c => φ (MvPolynomial.X c))) i x ∈
      idealCoefficientSubmodule (K := K) _ I := by
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change parameterKoszulDifferential (K := K) (fun c => φ (MvPolynomial.X c)) i x ∈
    idealCoefficientSubmodule (K := K) _ I
  exact parameterKoszulDifferential_ideal (K := K) (fun c => φ (MvPolynomial.X c)) I i x hx

def idealParameterKoszulComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  submoduleComplex (parameterKoszulComplex (K := K) (fun c => φ (MvPolynomial.X c)))
    (fun i => idealCoefficientSubmodule (K := K) (Set.powersetCard C i) I) (parameterIdealTerm_preserved φ I)

def idealParameterTermEquiv (i : ℕ) :
    (moduleTorCoordinateComplex (idealParameterCoefficientModule φ I)).X i ≃ₗ[K]
      (idealParameterKoszulComplex φ I).X i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact (moduleRestrictionEquiv (T := MvPolynomial C K) (Set.powersetCard C i →₀ I)).trans
    (idealCoefficientEquiv (K := K) _ I)

/-- The genuine coefficient Koszul complex is the literal relative kernel
subcomplex of the ambient ring Koszul complex. -/
def idealParameterKoszulIso :
    moduleTorCoordinateComplex (idealParameterCoefficientModule φ I) ≅ idealParameterKoszulComplex φ I := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact HomologicalComplex.Hom.isoOfComponents (fun i => (idealParameterTermEquiv φ I i).toModuleIso) (by
    intro i j hij
    obtain rfl : i = j + 1 := hij.symm
    simp only [moduleTorCoordinateComplex, idealParameterKoszulComplex,
      Functor.mapHomologicalComplex_obj_d, Koszul.coordinateComplex_d, submoduleComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_ofHom]
    apply Subtype.ext
    simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
    have h := LinearMap.congr_fun
      (coordinateDifferential_natural (MvPolynomial.X : C → MvPolynomial C K)
        (ModuleCat.ofHom (I.subtype.restrictScalars (MvPolynomial C K))) j) x
    change parameterKoszulDifferential (K := K) (fun c => φ (MvPolynomial.X c)) j
        (Finsupp.mapRange.linearMap (I.subtype.restrictScalars K) x) = _
    rw [← parameterRestriction_differential φ j]
    exact h.symm)

def ordinaryIdealParameterTorKoszulIso (i : ℕ) :
    ordinaryIdealParameterTor φ I i ≅ (idealParameterKoszulComplex φ I).homology i :=
  ordinaryModuleTorCoordinateIso (idealParameterCoefficientModule φ I) i ≪≫
    HomologicalComplex.homologyMapIso (idealParameterKoszulIso φ I) i

def ordinaryIdealParameterTorKernelIso (i : ℕ) :
    ordinaryIdealParameterTor φ I i ≅ ModuleCat.of K (complexKernelHomology (idealParameterKoszulComplex φ I) i) :=
  ordinaryIdealParameterTorKoszulIso φ I i ≪≫ complexKernelHomologyIso (idealParameterKoszulComplex φ I) i

end ParameterGenerality

section Original
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (Q : Set P)

abbrev originalRelativeParameterTor (i : ℕ) :=
  ordinaryIdealParameterTor (faceParameterAction K hs d) (faceRestrictionIdeal K hs Q) i

/-- The parameter-action Koszul kernel and the displayed original relative
complex have the same coefficient modules.  The components are identities;
only the evaluated parameter notation in their differentials differs. -/
def originalRelativeParameterKoszulComplexIso :
    idealParameterKoszulComplex (faceParameterAction K hs d) (faceRestrictionIdeal K hs Q) ≅
      originalRelativeKoszulComplex K hs d Q :=
  HomologicalComplex.Hom.isoOfComponents (fun _ => Iso.refl _) (by
    intro i j hij
    obtain rfl : i = j + 1 := hij.symm
    simp only [idealParameterKoszulComplex, originalRelativeKoszulComplex, submoduleComplex_d,
      Iso.refl_hom, Category.id_comp, Category.comp_id]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
    change parameterKoszulDifferential (K := K)
        (fun c : Fin d => faceRankParameter K hs (c.val + 1)) j x.val =
      parameterKoszulDifferential (K := K)
        (fun c : Fin d => faceParameterAction K hs d (MvPolynomial.X c)) j x.val
    have hγ : (fun c : Fin d => faceParameterAction K hs d (MvPolynomial.X c)) =
        (fun c : Fin d => faceRankParameter K hs (c.val + 1)) := by
      funext c
      simp only [faceParameterAction, MvPolynomial.aeval_X]
    rw [hγ])

def originalRelativeParameterTorKoszulIso (i : ℕ) :
    originalRelativeParameterTor K hs d Q i ≅ (originalRelativeKoszulComplex K hs d Q).homology i :=
  ordinaryIdealParameterTorKoszulIso (faceParameterAction K hs d) (faceRestrictionIdeal K hs Q) i ≪≫
    HomologicalComplex.homologyMapIso (originalRelativeParameterKoszulComplexIso K hs d Q) i

def originalRelativeParameterTorKernelIso (i : ℕ) :
    originalRelativeParameterTor K hs d Q i ≅
      ModuleCat.of K (complexKernelHomology (originalRelativeKoszulComplex K hs d Q) i) :=
  originalRelativeParameterTorKoszulIso K hs d Q i ≪≫ complexKernelHomologyIso (originalRelativeKoszulComplex K hs d Q) i

end Original
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.IdealParameterTorNaturality -/
section

/-! # Naturality for the actual derived Tor of a relative ideal -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg FourPapers.FilteredHomology
universe u v
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B] [Fintype C] [LinearOrder C]
variable (φ : MvPolynomial C K →ₐ[K] B)
variable (I : Ideal B) (f :
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  B →ₗ[MvPolynomial C K] B) (hI : ∀ x, x ∈ I → f x ∈ I)

def idealParameterCoefficientMap :
    letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
    I →ₗ[MvPolynomial C K] I := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact {
    toFun := fun x => ⟨f x.val, hI x.val x.property⟩
    map_add' := fun x y => Subtype.ext (map_add f x.val y.val)
    map_smul' := fun a x => Subtype.ext (map_smul f a x.val) }

def idealParameterAmbientKoszulMap :
    idealParameterKoszulComplex φ I ⟶ idealParameterKoszulComplex φ I :=
  submoduleComplexMap _ _ (parameterIdealTerm_preserved φ I) (parameterIdealTerm_preserved φ I)
    (parameterCoefficientKoszulMap φ φ f) (fun i x hx => by
      change Set.powersetCard C i →₀ B at x
      change ∀ s, x s ∈ I at hx
      change ∀ s, f (x s) ∈ I
      exact fun s => hI (x s) (hx s))

def ordinaryIdealParameterTorMap (i : ℕ) : ordinaryIdealParameterTor φ I i ⟶ ordinaryIdealParameterTor φ I i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  exact ordinaryModuleParameterTorMap (ModuleCat.ofHom (idealParameterCoefficientMap φ I f hI)) i

theorem idealParameterKoszulIso_natural :
    letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
    moduleTorCoordinateMap (ModuleCat.ofHom (idealParameterCoefficientMap φ I f hI)) ≫
      (idealParameterKoszulIso φ I).hom =
      (idealParameterKoszulIso φ I).hom ≫ idealParameterAmbientKoszulMap φ I f hI := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Finsupp.ext
  intro s
  rfl

theorem ordinaryIdealParameterTorKoszulIso_natural (i : ℕ) :
    ordinaryIdealParameterTorMap φ I f hI i ≫ (ordinaryIdealParameterTorKoszulIso φ I i).hom =
      (ordinaryIdealParameterTorKoszulIso φ I i).hom ≫
        HomologicalComplex.homologyMap (idealParameterAmbientKoszulMap φ I f hI) i := by
  letI : Algebra (MvPolynomial C K) B := φ.toRingHom.toAlgebra
  have h := congrArg
    (fun q => (HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).map q)
    (idealParameterKoszulIso_natural φ I f hI)
  simp only [Functor.map_comp] at h
  exact isoSquare_trans _ _ _ _ _ _ _
    (ordinaryModuleTorCoordinateIso_natural (ModuleCat.ofHom (idealParameterCoefficientMap φ I f hI)) i) h

/-- The action on the cycle quotient is the genuine ordinary Tor action,
with the comparison itself proved natural. -/
theorem ordinaryIdealParameterTorKernelIso_natural (i : ℕ) :
    ordinaryIdealParameterTorMap φ I f hI i ≫ (ordinaryIdealParameterTorKernelIso φ I i).hom =
      (ordinaryIdealParameterTorKernelIso φ I i).hom ≫
        ModuleCat.ofHom (complexKernelHomologyMap (idealParameterAmbientKoszulMap φ I f hI) i) :=
  isoSquare_trans _ _ _ _ _ _ _ (ordinaryIdealParameterTorKoszulIso_natural φ I f hI i)
    (complexKernelHomologyIso_natural (idealParameterAmbientKoszulMap φ I f hI) i)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeInternalTor -/
section

/-! # The finite filtration inside the actual internally graded Tor module

The internally homogeneous Koszul complex is a split subcomplex of the
actual relative coefficient complex.  Its homology is therefore identified
with a submodule of ordinary derived Tor, rather than being declared to be
Tor by definition.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

include hrank hQ in
theorem originalKoszulDegreeProjection_relative (j i : ℕ)
    (x : (originalKoszulComplex K hs d).X i) (hx : x ∈ originalRelativeKoszulTerm K hs d Q i) :
    originalKoszulDegreeProjection K hs d j i x ∈ originalRelativeKoszulTerm K hs d Q i := by
  let E := originalKoszulCoefficientEquiv K hs d hrank i
  let y := E.symm x
  have hy : y ∈ barycentricRelativeKoszulTerm (P := P) K d Q i :=
    (originalKoszulCoefficientEquiv_relative K hs d Q hQ hrank i y).mp
      (by simpa only [y, E, LinearEquiv.apply_symm_apply] using hx)
  have hproj := barycentricProjection_relative K hs d Q hQ i originalKoszulDegree j y hy
  have hh := (originalKoszulCoefficientEquiv_relative K hs d Q hQ hrank i _).mpr hproj
  have hc := LinearMap.congr_fun (basisProjection_commutes
    (barycentricKoszulBasis (P := P) K d i) (originalKoszulBasis K hs d i)
    originalKoszulDegree originalKoszulDegree E.toLinearMap
    (fun a => (originalKoszulCoefficientEquiv_degree K hs d hrank i (originalKoszulDegree a) _).mpr
      (FourPapers.BasisGrading.basis_mem_piece _ _ a)) j) y
  change E (FourPapers.BasisGrading.projection _ originalKoszulDegree j y) =
    originalKoszulDegreeProjection K hs d j i (E y) at hc
  rw [hc] at hh
  simpa only [y, E, LinearEquiv.apply_symm_apply] using hh

def originalRelativeDegreeInclusion (j : ℕ) :
    originalRelativeDegreeComplex K hs d Q hrank j ⟶ originalRelativeKoszulComplex K hs d Q where
  f i := ModuleCat.ofHom (Submodule.inclusion inf_le_left)
  comm' i k hik := by
    obtain rfl : i = k + 1 := hik.symm
    simp only [originalRelativeDegreeComplex, originalRelativeKoszulComplex, submoduleComplex_d]
    rfl

def originalRelativeDegreeRetraction (j : ℕ) :
    originalRelativeKoszulComplex K hs d Q ⟶ originalRelativeDegreeComplex K hs d Q hrank j where
  f i := ModuleCat.ofHom ((originalKoszulDegreeProjection K hs d j i).domRestrict _ |>.codRestrict _
    (fun x => ⟨originalKoszulDegreeProjection_relative K hs d hrank Q hQ j i x.val x.property,
      FourPapers.BasisGrading.projection_mem _ _ _ x.val⟩))
  comm' i k hik := by
    obtain rfl : i = k + 1 := hik.symm
    simp only [originalRelativeDegreeComplex, originalRelativeKoszulComplex, submoduleComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_ofHom,
      complexIncoming, parameterKoszulComplex_d]
    change originalKoszulDifferential K hs d k
      (originalKoszulDegreeProjection K hs d j (k + 1) x.val) =
        originalKoszulDegreeProjection K hs d j k (originalKoszulDifferential K hs d k x.val)
    exact LinearMap.congr_fun (originalKoszulDegreeProjection_commutes K hs d hrank j k) x.val

theorem originalRelativeDegreeInclusion_retraction (j : ℕ) :
    originalRelativeDegreeInclusion K hs d hrank Q j ≫ originalRelativeDegreeRetraction K hs d hrank Q hQ j = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change originalKoszulDegreeProjection K hs d j i x.val = x.val
  exact FourPapers.BasisGrading.projection_eq_self x.property.2

include hQ in
theorem originalRelativeDegreeHomology_injective (j i : ℕ) :
    Function.Injective (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i) := by
  have h : (complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ j) i).comp
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i) = LinearMap.id := by
    rw [← complexKernelHomologyMap_comp, originalRelativeDegreeInclusion_retraction, complexKernelHomologyMap_id]
  intro x y hxy
  have hh := congrArg (complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ j) i) hxy
  simpa only [← LinearMap.comp_apply, h, LinearMap.id_apply] using hh

def originalRelativeTorDegreeMap (j i : ℕ) :
    originalRelativeInternalHomology K hs d Q hrank j i →ₗ[K] originalRelativeParameterTor K hs d Q i :=
  ((originalRelativeParameterTorKernelIso K hs d Q i).symm.toLinearEquiv).toLinearMap.comp
    (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i)

include hQ in
theorem originalRelativeTorDegreeMap_injective (j i : ℕ) :
    Function.Injective (originalRelativeTorDegreeMap K hs d hrank Q j i) := by
  intro x y hxy
  apply originalRelativeDegreeHomology_injective K hs d hrank Q hQ j i
  exact ((originalRelativeParameterTorKernelIso K hs d Q i).symm.toLinearEquiv).injective hxy

/-- The internal-degree submodule inside ordinary derived Tor.  The map
whose range is taken is the inclusion of the actual homogeneous resolution. -/
def originalRelativeTorDegreePiece (j i : ℕ) : Submodule K (originalRelativeParameterTor K hs d Q i) :=
  LinearMap.range (originalRelativeTorDegreeMap K hs d hrank Q j i)

def originalRelativeTorDegreeEquiv (j i : ℕ) :
    originalRelativeInternalHomology K hs d Q hrank j i ≃ₗ[K] originalRelativeTorDegreePiece K hs d hrank Q j i :=
  LinearEquiv.ofInjective _ (originalRelativeTorDegreeMap_injective K hs d hrank Q hQ j i)

section Transfer
variable {X Y : Type*} [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]

def equivalenceFiltration (F : Filtration (K := K) X) (E : X ≃ₗ[K] Y) : Filtration (K := K) Y where
  level n := (F.level n).comap E.symm.toLinearMap
  zero := by rw [F.zero, Submodule.comap_bot]; exact LinearMap.ker_eq_bot.mpr E.symm.injective
  mono := fun _ _ h => Submodule.comap_mono (F.mono h)
  exhaustive y := F.exhaustive (E.symm y)

theorem equivalenceFiltration_apply (F : Filtration (K := K) X) (E : X ≃ₗ[K] Y)
    (n : ℕ) (x : X) : E x ∈ (equivalenceFiltration K F E).level n ↔ x ∈ F.level n := by
  change E.symm (E x) ∈ F.level n ↔ x ∈ F.level n
  rw [LinearEquiv.symm_apply_apply]

end Transfer

def originalRelativeTorFiltration (j i : ℕ) : Filtration (K := K)
    (originalRelativeTorDegreePiece K hs d hrank Q j i) :=
  equivalenceFiltration K (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)

theorem originalRelativeTorFiltration_finite (j i : ℕ) :
    (originalRelativeTorFiltration K hs d hrank Q hQ j i).level (2 * d * j + 1) = ⊤ := by
  ext x
  change _ ∈ (originalRelativeInternalHomologyFiltration K hs d Q hrank j i).level (2 * d * j + 1) ↔ _
  rw [originalRelativeInternalHomologyFiltration_finite]
  exact Iff.rfl

def originalRelativeTorAssociatedBigraded (j i n : ℕ) :
    Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n ≃ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
  (gradeEquiv _ _ (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)
    (equivalenceFiltration_apply K _ _) n).symm.trans
      (originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank j i n)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeTorGrading -/
section

open scoped DirectSum
/-! # Exhaustion and independence of the genuine internal Tor grading

Every Tor class is a finite sum of the internally homogeneous classes
coming from the actual Koszul resolution.  Distinct internal pieces are
independent, by the genuine homogeneous chain projections.  This audits
that the internal-degree modules used in the filtration omit no Tor class.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

theorem complexKernelHomologyMap_zero (C D : ChainComplex (ModuleCat.{u} K) ℕ) (i : ℕ) :
    complexKernelHomologyMap (0 : C ⟶ D) i = 0 := by
  apply LinearMap.ext
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _ (complexIncomingOutgoing C i))).mkQ_surjective x
  change homologyClass _ _ (complexIncomingOutgoing D i) 0 = 0
  exact map_zero _

variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

theorem originalRelativeDegreeInclusion_retraction_off (j k : ℕ) (hjk : j ≠ k) :
    originalRelativeDegreeInclusion K hs d hrank Q j ≫ originalRelativeDegreeRetraction K hs d hrank Q hQ k = 0 := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change originalKoszulDegreeProjection K hs d k i x.val = 0
  exact FourPapers.BasisGrading.projection_eq_zero (Ne.symm hjk) x.property.2

def originalRelativeTorDegreeRetraction (j i : ℕ) :
    originalRelativeParameterTor K hs d Q i →ₗ[K] originalRelativeInternalHomology K hs d Q hrank j i :=
  (complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ j) i).comp
    (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.toLinearMap

theorem originalRelativeTorDegreeRetraction_map (j i : ℕ)
    (x : originalRelativeInternalHomology K hs d Q hrank j i) :
    originalRelativeTorDegreeRetraction K hs d hrank Q hQ j i
      (originalRelativeTorDegreeMap K hs d hrank Q j i x) = x := by
  change complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ j) i
      ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.symm _)) = x
  rw [LinearEquiv.apply_symm_apply]
  have h : (complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ j) i).comp
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i) = LinearMap.id := by
    rw [← complexKernelHomologyMap_comp, originalRelativeDegreeInclusion_retraction, complexKernelHomologyMap_id]
  exact LinearMap.congr_fun h x

theorem originalRelativeTorDegreeRetraction_map_off (j k i : ℕ) (hjk : j ≠ k)
    (x : originalRelativeInternalHomology K hs d Q hrank j i) :
    originalRelativeTorDegreeRetraction K hs d hrank Q hQ k i
      (originalRelativeTorDegreeMap K hs d hrank Q j i x) = 0 := by
  change complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ k) i
      ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.symm _)) = 0
  rw [LinearEquiv.apply_symm_apply]
  have h : (complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ k) i).comp
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i) = 0 := by
    rw [← complexKernelHomologyMap_comp, originalRelativeDegreeInclusion_retraction_off K hs d hrank Q hQ j k hjk,
      complexKernelHomologyMap_zero]
  exact LinearMap.congr_fun h x

theorem originalRelativeHomology_finite_degree_sum (i : ℕ)
    (x : complexKernelHomology (originalRelativeKoszulComplex K hs d Q) i) :
    ∃ S : Finset ℕ, ∑ j ∈ S,
      complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i
        (complexKernelHomologyMap (originalRelativeDegreeRetraction K hs d hrank Q hQ j) i x) = x := by
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _
    (complexIncomingOutgoing (originalRelativeKoszulComplex K hs d Q) i))).mkQ_surjective x
  let S := ((originalKoszulBasis K hs d i).repr z.val.val).support.image originalKoszulDegree
  let C := originalRelativeKoszulComplex K hs d Q
  let proj (j : ℕ) : C ⟶ C := originalRelativeDegreeRetraction K hs d hrank Q hQ j ≫
    originalRelativeDegreeInclusion K hs d hrank Q j
  let zp (j : ℕ) : LinearMap.ker (complexOutgoing C i) :=
    inducedCycleMap _ _ ((proj j).f i).hom ((proj j).f (i - 1)).hom
      (congrArg (fun q => q.hom) ((proj j).comm i (i - 1))).symm z
  have hz : ∑ j ∈ S, zp j = z := by
    apply Subtype.ext
    change (LinearMap.ker (complexOutgoing C i)).subtype (∑ j ∈ S, zp j) = z.val
    rw [map_sum]
    apply Subtype.ext
    change (originalRelativeKoszulTerm K hs d Q i).subtype (∑ j ∈ S, (zp j).val) = z.val.val
    rw [map_sum]
    change ∑ j ∈ S, originalKoszulDegreeProjection K hs d j i z.val.val = z.val.val
    exact FourPapers.BasisGrading.sum_projections (originalKoszulBasis K hs d i) originalKoszulDegree z.val.val
  refine ⟨S, ?_⟩
  calc
    _ = ∑ j ∈ S, homologyClass _ _ (complexIncomingOutgoing C i) (zp j) := by
      apply Finset.sum_congr rfl
      intro j hj
      rfl
    _ = homologyClass _ _ (complexIncomingOutgoing C i) (∑ j ∈ S, zp j) := (map_sum _ _ _).symm
    _ = _ := congrArg (homologyClass _ _ (complexIncomingOutgoing C i)) hz

/-- Every actual derived Tor element is a finite sum of its genuine
internal homogeneous components. -/
theorem originalRelativeTor_finite_degree_sum (i : ℕ)
    (x : originalRelativeParameterTor K hs d Q i) :
    ∃ S : Finset ℕ, ∑ j ∈ S, originalRelativeTorDegreeMap K hs d hrank Q j i
      (originalRelativeTorDegreeRetraction K hs d hrank Q hQ j i x) = x := by
  obtain ⟨S, hS⟩ := originalRelativeHomology_finite_degree_sum K hs d hrank Q hQ i
    ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv x)
  refine ⟨S, ?_⟩
  apply (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.injective
  rw [map_sum]
  simpa only [originalRelativeTorDegreeMap, originalRelativeTorDegreeRetraction, LinearMap.comp_apply,
    LinearEquiv.coe_coe, ← Iso.toLinearEquiv_symm, LinearEquiv.apply_symm_apply] using hS

include hQ in
theorem originalRelativeTorDegreePiece_iSup (i : ℕ) :
    (⨆ j, originalRelativeTorDegreePiece K hs d hrank Q j i) = ⊤ := by
  apply top_unique
  intro x hx
  obtain ⟨S, hS⟩ := originalRelativeTor_finite_degree_sum K hs d hrank Q hQ i x
  rw [← hS]
  apply Submodule.sum_mem
  intro j hj
  exact (le_iSup (fun j => originalRelativeTorDegreePiece K hs d hrank Q j i) j)
    ⟨originalRelativeTorDegreeRetraction K hs d hrank Q hQ j i x, rfl⟩

include hQ in
theorem originalRelativeTorDegreePiece_independent (i : ℕ) :
    iSupIndep (fun j => originalRelativeTorDegreePiece K hs d hrank Q j i) := by
  rw [iSupIndep_def]
  intro j
  apply Submodule.disjoint_def.mpr
  intro x hx hother
  have hker : (⨆ (k : ℕ) (_ : k ≠ j), originalRelativeTorDegreePiece K hs d hrank Q k i) ≤
      LinearMap.ker (originalRelativeTorDegreeRetraction K hs d hrank Q hQ j i) := by
    refine iSup_le fun k => iSup_le fun hkj => ?_
    rintro y ⟨z, rfl⟩
    exact originalRelativeTorDegreeRetraction_map_off K hs d hrank Q hQ k j i hkj z
  have hz := hker hother
  obtain ⟨y, rfl⟩ := hx
  change originalRelativeTorDegreeRetraction K hs d hrank Q hQ j i
    (originalRelativeTorDegreeMap K hs d hrank Q j i y) = 0 at hz
  rw [originalRelativeTorDegreeRetraction_map] at hz
  rw [hz, map_zero]

include hQ in
theorem originalRelativeTorDegreePiece_internal (i : ℕ) :
    DirectSum.IsInternal (fun j => originalRelativeTorDegreePiece K hs d hrank Q j i) :=
  DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    (originalRelativeTorDegreePiece_independent K hs d hrank Q hQ i)
    (originalRelativeTorDegreePiece_iSup K hs d hrank Q hQ i)

/-- A complete, honest direct-sum grading of the ordinary derived Tor
module, with no omitted or newly imposed internal-degree restriction. -/
def originalRelativeTorInternalDecomposition (i : ℕ) :
    originalRelativeParameterTor K hs d Q i ≃ₗ[K]
      ⨁ j : ℕ, originalRelativeTorDegreePiece K hs d hrank Q j i :=
  (LinearEquiv.ofBijective (DirectSum.coeLinearMap (fun j => originalRelativeTorDegreePiece K hs d hrank Q j i))
    (originalRelativeTorDegreePiece_internal K hs d hrank Q hQ i)).symm

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeTorEquivariance -/
section

/-! # The finite filtration is stable under the actual derived Tor action

Parameter linearity of the order action is proved on the original ring.
The ordinary Tor functor then supplies its action; naturality identifies it
with the action on actual Koszul cycle representatives.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

theorem faceRingOrderAut_parameterAction (e : P ≃o P) (t : MvPolynomial (Fin d) K) :
    faceRingOrderAut K hs e (faceParameterAction K hs d t) = faceParameterAction K hs d t := by
  have h : (faceRingOrderAut K hs e).toAlgHom.comp (faceParameterAction K hs d) = faceParameterAction K hs d := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, faceParameterAction, MvPolynomial.aeval_X, AlgEquiv.coe_algHom,
      faceRingOrderAut_parameter]
  exact DFunLike.congr_fun h t

theorem barycentricRingOrderAut_parameterAction (e : P ≃o P) (t : MvPolynomial (Fin d) K) :
    barycentricRingOrderAut K e (barycentricParameterAction (P := P) K d t) =
      barycentricParameterAction (P := P) K d t := by
  have h : (barycentricRingOrderAut K e).toAlgHom.comp (barycentricParameterAction (P := P) K d) =
      barycentricParameterAction (P := P) K d := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, barycentricParameterAction, MvPolynomial.aeval_X, AlgEquiv.coe_algHom,
      barycentricRingOrderAut_parameter]
  exact DFunLike.congr_fun h t

local instance actualFaceParameterAlgebra : Algebra (MvPolynomial (Fin d) K) (FaceRing K hs) :=
  (faceParameterAction K hs d).toRingHom.toAlgebra

def faceParameterOrderMap (e : P ≃o P) : FaceRing K hs →ₗ[MvPolynomial (Fin d) K] FaceRing K hs where
  toFun := faceRingOrderAut K hs e
  map_add' := map_add _
  map_smul' t x := by
    change faceRingOrderAut K hs e (faceParameterAction K hs d t * x) =
      faceParameterAction K hs d t * faceRingOrderAut K hs e x
    rw [map_mul, faceRingOrderAut_parameterAction]

variable (Q : Set P) (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

def originalRelativeTorOrderMap (i : ℕ) :
    originalRelativeParameterTor K hs d Q i ⟶ originalRelativeParameterTor K hs d Q i :=
  ordinaryIdealParameterTorMap (faceParameterAction K hs d) (faceRestrictionIdeal K hs Q)
    (faceParameterOrderMap K hs d e) (faceRingOrderAut_relative K hs Q e hstable) i

def originalRelativeKoszulOrderMap :
    originalRelativeKoszulComplex K hs d Q ⟶ originalRelativeKoszulComplex K hs d Q :=
  submoduleComplexMap _ _ (originalRelativeKoszulTerm_preserved K hs d Q)
    (originalRelativeKoszulTerm_preserved K hs d Q) (originalKoszulOrderAut K hs d e).hom
    (fun i x hx => by
      change Set.powersetCard (Fin d) i →₀ FaceRing K hs at x
      change ∀ s, x s ∈ faceRestrictionIdeal K hs Q at hx
      change ∀ s, faceRingOrderAut K hs e (x s) ∈ faceRestrictionIdeal K hs Q
      exact fun s => faceRingOrderAut_relative K hs Q e hstable (x s) (hx s))

theorem originalRelativeTorOrderMap_natural (i : ℕ) :
    originalRelativeTorOrderMap K hs d Q e hstable i ≫ (originalRelativeParameterTorKernelIso K hs d Q i).hom =
      (originalRelativeParameterTorKernelIso K hs d Q i).hom ≫
        ModuleCat.ofHom (complexKernelHomologyMap (originalRelativeKoszulOrderMap K hs d Q e hstable) i) := by
  let φ := faceParameterAction K hs d
  let I := faceRestrictionIdeal K hs Q
  let f := faceParameterOrderMap K hs d e
  let hI := faceRingOrderAut_relative K hs Q e hstable
  let c := originalRelativeParameterKoszulComplexIso K hs d Q
  let a := idealParameterAmbientKoszulMap φ I f hI
  let b := originalRelativeKoszulOrderMap K hs d Q e hstable
  have hc : a ≫ c.hom = c.hom ≫ b := by
    apply HomologicalComplex.Hom.ext
    funext k
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    apply Finsupp.ext
    intro s
    rfl
  have hh : HomologicalComplex.homologyMap a i ≫ (HomologicalComplex.homologyMapIso c i).hom =
      (HomologicalComplex.homologyMapIso c i).hom ≫ HomologicalComplex.homologyMap b i := by
    simpa only [HomologicalComplex.homologyMapIso_hom, HomologicalComplex.homologyMap_comp] using
      congrArg (fun f => HomologicalComplex.homologyMap f i) hc
  have ht : originalRelativeTorOrderMap K hs d Q e hstable i ≫
      (originalRelativeParameterTorKoszulIso K hs d Q i).hom =
      (originalRelativeParameterTorKoszulIso K hs d Q i).hom ≫ HomologicalComplex.homologyMap b i :=
    isoSquare_trans (ordinaryIdealParameterTorKoszulIso φ I i) (ordinaryIdealParameterTorKoszulIso φ I i)
      (HomologicalComplex.homologyMapIso c i) (HomologicalComplex.homologyMapIso c i)
      (originalRelativeTorOrderMap K hs d Q e hstable i) (HomologicalComplex.homologyMap a i)
      (HomologicalComplex.homologyMap b i)
      (ordinaryIdealParameterTorKoszulIso_natural φ I f hI i) hh
  exact isoSquare_trans (originalRelativeParameterTorKoszulIso K hs d Q i)
    (originalRelativeParameterTorKoszulIso K hs d Q i)
    (complexKernelHomologyIso (originalRelativeKoszulComplex K hs d Q) i)
    (complexKernelHomologyIso (originalRelativeKoszulComplex K hs d Q) i)
    (originalRelativeTorOrderMap K hs d Q e hstable i) (HomologicalComplex.homologyMap b i)
    (ModuleCat.ofHom (complexKernelHomologyMap b i)) ht (complexKernelHomologyIso_natural b i)

variable (hrank : ∀ p : P, faceRank p ≤ d)
variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

theorem originalRelativeDegreeInclusion_equivariant (j : ℕ) :
    originalRelativeDegreeInclusion K hs d hrank Q j ≫ originalRelativeKoszulOrderMap K hs d Q e hstable =
      originalRelativeInternalOrderMap K hs d hrank Q e hstable j ≫ originalRelativeDegreeInclusion K hs d hrank Q j := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  rfl

theorem originalRelativeTorDegreeMap_equivariant (j i : ℕ)
    (x : originalRelativeInternalHomology K hs d Q hrank j i) :
    originalRelativeTorOrderMap K hs d Q e hstable i (originalRelativeTorDegreeMap K hs d hrank Q j i x) =
      originalRelativeTorDegreeMap K hs d hrank Q j i
        (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i x) := by
  apply (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.injective
  have hT := congrArg (fun q => q (originalRelativeTorDegreeMap K hs d hrank Q j i x))
    (originalRelativeTorOrderMap_natural K hs d Q e hstable i)
  have hC := congrArg (fun f => complexKernelHomologyMap f i)
    (originalRelativeDegreeInclusion_equivariant K hs d Q e hstable hrank j)
  rw [complexKernelHomologyMap_comp, complexKernelHomologyMap_comp] at hC
  change (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
    (originalRelativeTorOrderMap K hs d Q e hstable i _) = _
  rw [show (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
      (originalRelativeTorOrderMap K hs d Q e hstable i _) =
        complexKernelHomologyMap (originalRelativeKoszulOrderMap K hs d Q e hstable) i
          ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
            (originalRelativeTorDegreeMap K hs d hrank Q j i x)) from hT]
  change complexKernelHomologyMap _ i
      ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.symm _)) =
    (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv
      ((originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.symm _)
  rw [LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
  exact LinearMap.congr_fun hC x

def originalRelativeTorDegreeAction (j i : ℕ) :
    Module.End K (originalRelativeTorDegreePiece K hs d hrank Q j i) :=
  restrictedMap (originalRelativeTorOrderMap K hs d Q e hstable i).hom _ _ (by
    rintro x ⟨y, rfl⟩
    exact ⟨originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i y,
      (originalRelativeTorDegreeMap_equivariant K hs d Q e hstable hrank j i y).symm⟩)

theorem originalRelativeTorDegreeEquiv_equivariant (j i : ℕ)
    (x : originalRelativeInternalHomology K hs d Q hrank j i) :
    originalRelativeTorDegreeAction K hs d Q e hstable hrank j i
      (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i x) =
      originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i
        (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i x) := by
  apply Subtype.ext
  exact originalRelativeTorDegreeMap_equivariant K hs d Q e hstable hrank j i x

theorem originalRelativeTorDegreeAction_filtered (j i : ℕ) :
    Preserves (originalRelativeTorFiltration K hs d hrank Q hQ j i)
      (originalRelativeTorFiltration K hs d hrank Q hQ j i)
      (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i) := by
  intro n x hx
  let E := originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i
  have h := originalRelativeInternalHomologyAction_filtered K hs d hrank Q e hstable j i n (E.symm x) hx
  have he := originalRelativeTorDegreeEquiv_equivariant K hs d Q e hstable hrank hQ j i (E.symm x)
  change E.symm (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i x) ∈
    (originalRelativeInternalHomologyFiltration K hs d Q hrank j i).level n
  rw [← E.apply_symm_apply x, he, LinearEquiv.symm_apply_apply]
  exact h

/-- Full equivariance of the finite filtration comparison on the internal
submodule of actual derived Tor, for every stable lower ideal. -/
theorem originalRelativeTorAssociatedBigraded_equivariant (j i n : ℕ)
    (x : Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n) :
    originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n
      (gradeMap _ _ (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i)
        (originalRelativeTorDegreeAction_filtered K hs d Q e hstable hrank hQ j i) n x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n x) := by
  let E := gradeEquiv (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
    (originalRelativeTorFiltration K hs d hrank Q hQ j i)
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)
    (equivalenceFiltration_apply K (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
      (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)) n
  have hE := gradeEquiv_commutes _ _ _ _
    (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i)
    (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i)
    (originalRelativeInternalHomologyAction_filtered K hs d hrank Q e hstable j i)
    (originalRelativeTorDegreeAction_filtered K hs d Q e hstable hrank hQ j i)
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)
    (equivalenceFiltration_apply K (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
      (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i))
    (equivalenceFiltration_apply K (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
      (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i))
    (originalRelativeTorDegreeEquiv_equivariant K hs d Q e hstable hrank hQ j i) n (E.symm x)
  have hh : E.symm (gradeMap _ _ (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i)
      (originalRelativeTorDegreeAction_filtered K hs d Q e hstable hrank hQ j i) n x) =
      gradeMap _ _ (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i)
        (originalRelativeInternalHomologyAction_filtered K hs d hrank Q e hstable j i) n (E.symm x) := by
    apply E.injective
    rw [E.apply_symm_apply]
    have hc : gradeMap (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i)
        (originalRelativeTorDegreeAction_filtered K hs d Q e hstable hrank hQ j i) n
        (E (E.symm x)) =
      E (gradeMap (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
        (originalRelativeInternalHomologyFiltration K hs d Q hrank j i)
        (originalRelativeInternalHomologyAction K hs d hrank Q e hstable j i)
        (originalRelativeInternalHomologyAction_filtered K hs d hrank Q e hstable j i) n
        (E.symm x)) := hE
    rw [E.apply_symm_apply] at hc
    exact hc
  change originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank j i n (E.symm _) = _
  rw [hh]
  exact originalRelativeAssociatedBigradedHomology_equivariant K d e Q hstable hs hQ hrank j i n (E.symm x)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.InternalTorFiniteness -/
section

/-! # Finiteness of every actual internal Tor component over a field

Every nonzero face has positive rank.  Consequently an exponent in total
internal degree `j` is at most `j`, which gives a genuine finite index set
for the homogeneous chain basis.  Finite dimensionality of cycles,
quotients, and the actual Tor submodule then follows.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (hs : IsSimplicialPoset P)

include hs in
theorem standardExponent_le_degree (a : StandardFaceIndex P) (p : NonzeroFace P) :
    a.val p ≤ standardOrdinaryDegree a := by
  have hp : 1 ≤ faceRank p.val := by
    have h := (faceRank_strictMono hs) (bot_lt_iff_ne_bot.mpr p.property)
    exact Nat.succ_le_of_lt (by simpa only [faceRank_bot] using h)
  by_cases hm : p ∈ a.val.support
  · calc
      a.val p = a.val p * 1 := (mul_one _).symm
      _ ≤ a.val p * faceRank p.val := Nat.mul_le_mul_left _ hp
      _ ≤ standardOrdinaryDegree a :=
        Finset.single_le_sum (fun q hq => Nat.zero_le (a.val q * faceRank q.val)) hm
  · have hz : a.val p = 0 := Finsupp.notMem_support_iff.mp hm
    rw [hz]
    exact Nat.zero_le _

include hs in
/-- The full internally homogeneous chain index set is finite, with no
restriction on the ring or on the homological degree. -/
theorem originalKoszulDegreeIndex_finite (d i j : ℕ) :
    Finite {a : OriginalKoszulIndex P d i // originalKoszulDegree a = j} := by
  let f : {a : OriginalKoszulIndex P d i // originalKoszulDegree a = j} →
      Set.powersetCard (Fin d) i × (NonzeroFace P → Fin (j + 1)) := fun a =>
    (a.val.1, fun p => ⟨a.val.2.val p, Nat.lt_succ_of_le ((standardExponent_le_degree hs a.val.2 p).trans
      (calc
        standardOrdinaryDegree a.val.2 ≤ originalKoszulDegree a.val := Nat.le_add_right _ _
        _ = j := a.property))⟩)
  apply Finite.of_injective f
  intro a b h
  rcases a with ⟨⟨s, a⟩, ha⟩
  rcases b with ⟨⟨t, b⟩, hb⟩
  have ht : s = t := congrArg Prod.fst h
  subst t
  have hab : a = b := by
    apply Subtype.ext
    apply Finsupp.ext
    intro p
    exact congrArg (fun y : Set.powersetCard (Fin d) i × (NonzeroFace P → Fin (j + 1)) =>
      (y.2 p).val) h
  subst b
  rfl

variable (K : Type u) [CommRing K]

theorem originalKoszulDegreePiece_moduleFinite (d i j : ℕ) :
    Module.Finite K (originalKoszulDegreePiece K hs d i j) := by
  letI := originalKoszulDegreeIndex_finite hs d i j
  exact Module.Finite.of_basis
    (FourPapers.BasisGrading.restrictedBasis (originalKoszulBasis K hs d i) (fun a => originalKoszulDegree a = j))

include hs in
theorem barycentricKoszulDegreePiece_moduleFinite (d i j : ℕ) :
    Module.Finite K (barycentricKoszulDegreePiece (P := P) K d i j) := by
  letI := originalKoszulDegreeIndex_finite hs d i j
  exact Module.Finite.of_basis
    (FourPapers.BasisGrading.restrictedBasis (barycentricKoszulBasis (P := P) K d i) (fun a => originalKoszulDegree a = j))

end FourPapers.Universal

namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [Field K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

theorem originalRelativeInternalHomology_finiteDimensional (j i : ℕ) :
    FiniteDimensional K (originalRelativeInternalHomology K hs d Q hrank j i) := by
  letI := originalKoszulDegreePiece_moduleFinite hs K d i j
  letI : FiniteDimensional K (originalRelativeDegreeTerm K hs d Q j i) :=
    Submodule.finiteDimensional_inf_right
      (V := Set.powersetCard (Fin d) i →₀ FaceRing K hs)
      (originalRelativeKoszulTerm K hs d Q i) (originalKoszulDegreePiece K hs d i j)
  letI : FiniteDimensional K ((originalRelativeDegreeComplex K hs d Q hrank j).X i) :=
    (show FiniteDimensional K (originalRelativeDegreeTerm K hs d Q j i) from inferInstance)
  change FiniteDimensional K (LinearMap.ker _ ⧸ LinearMap.range _)
  infer_instance

include hQ in
theorem originalRelativeTorDegreePiece_finiteDimensional (j i : ℕ) :
    FiniteDimensional K (originalRelativeTorDegreePiece K hs d hrank Q j i) := by
  letI := originalRelativeInternalHomology_finiteDimensional K hs d hrank Q j i
  exact Module.Finite.equiv (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.PosetTorRepresentations -/
section

/-! # Group actions on the genuine internal Tor modules

An action is specified by order automorphisms satisfying the ordinary
identity and composition laws.  This is converted both to the usual
`MulAction` and to the induced representation on actual derived Tor.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
variable (G : Type v) (P : Type u) [Group G] [PartialOrder P]

structure PosetGroupAction where
  orderIso : G → P ≃o P
  one : orderIso 1 = OrderIso.refl P
  mul : ∀ g h, orderIso (g * h) = (orderIso h).trans (orderIso g)

namespace PosetGroupAction
variable {G P}

def toMulAction (a : PosetGroupAction G P) : MulAction G P where
  smul g p := a.orderIso g p
  one_smul p := congrArg (fun e : P ≃o P => e p) a.one
  mul_smul g h p := congrArg (fun e : P ≃o P => e p) (a.mul g h)

/-- Every ordinary monotone group action gives precisely the preceding
action data; no freeness or faithfulness condition is imposed. -/
def ofMulAction [MulAction G P] (hmono : ∀ g : G, Monotone (fun p : P => g • p)) : PosetGroupAction G P where
  orderIso g :=
    { toFun := fun p => g • p
      invFun := fun p => g⁻¹ • p
      left_inv := fun p => inv_smul_smul g p
      right_inv := fun p => smul_inv_smul g p
      map_rel_iff' := by
        intro p q
        change g • p ≤ g • q ↔ p ≤ q
        constructor
        · intro h
          simpa only [inv_smul_smul] using hmono g⁻¹ h
        · exact fun hpq => hmono g hpq }
  one := by ext p; exact one_smul G p
  mul g h := by ext p; exact mul_smul g h p

end PosetGroupAction

variable {G P}
variable {K : Type u} [CommRing K] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (a : PosetGroupAction G P)
variable (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)

theorem originalRelativeInternalOrderMap_one (j : ℕ) :
    originalRelativeInternalOrderMap K hs d hrank Q (a.orderIso 1) (hstable 1) j = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Finsupp.ext
  intro s
  change faceRingOrderAut K hs (a.orderIso 1) ((show Set.powersetCard (Fin d) i →₀ FaceRing K hs from x.val) s) = (show Set.powersetCard (Fin d) i →₀ FaceRing K hs from x.val) s
  rw [a.one, faceRingOrderAut_refl]

theorem originalRelativeInternalOrderMap_mul (g h : G) (j : ℕ) :
    originalRelativeInternalOrderMap K hs d hrank Q (a.orderIso (g * h)) (hstable (g * h)) j =
      originalRelativeInternalOrderMap K hs d hrank Q (a.orderIso h) (hstable h) j ≫
        originalRelativeInternalOrderMap K hs d hrank Q (a.orderIso g) (hstable g) j := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  apply Finsupp.ext
  intro s
  change faceRingOrderAut K hs (a.orderIso (g * h)) ((show Set.powersetCard (Fin d) i →₀ FaceRing K hs from x.val) s) =
    faceRingOrderAut K hs (a.orderIso g) (faceRingOrderAut K hs (a.orderIso h) ((show Set.powersetCard (Fin d) i →₀ FaceRing K hs from x.val) s))
  rw [a.mul, faceRingOrderAut_trans]

def originalRelativeInternalHomologyRepresentation (j i : ℕ) :
    Representation K G (originalRelativeInternalHomology K hs d Q hrank j i) where
  toFun g := originalRelativeInternalHomologyAction K hs d hrank Q (a.orderIso g) (hstable g) j i
  map_one' := by
    change complexKernelHomologyMap _ i = _
    rw [originalRelativeInternalOrderMap_one, complexKernelHomologyMap_id]
    rfl
  map_mul' g h := by
    change complexKernelHomologyMap _ i = _
    rw [originalRelativeInternalOrderMap_mul, complexKernelHomologyMap_comp]
    rfl

variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

/-- The action is the restriction of the actual ordinary Tor functor map.
Its group laws are proved using naturality and genuine chain action laws. -/
def originalRelativeTorDegreeRepresentation (j i : ℕ) :
    Representation K G (originalRelativeTorDegreePiece K hs d hrank Q j i) where
  toFun g := originalRelativeTorDegreeAction K hs d Q (a.orderIso g) (hstable g) hrank j i
  map_one' := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i).surjective x
    rw [originalRelativeTorDegreeEquiv_equivariant]
    change originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i
      (originalRelativeInternalHomologyRepresentation K hs d hrank Q a hstable j i 1 y) = _
    rw [map_one]
    rfl
  map_mul' g h := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i).surjective x
    change originalRelativeTorDegreeAction K hs d Q (a.orderIso (g * h)) (hstable (g * h)) hrank j i _ =
      originalRelativeTorDegreeAction K hs d Q (a.orderIso g) (hstable g) hrank j i
        (originalRelativeTorDegreeAction K hs d Q (a.orderIso h) (hstable h) hrank j i _)
    rw [originalRelativeTorDegreeEquiv_equivariant, originalRelativeTorDegreeEquiv_equivariant,
      originalRelativeTorDegreeEquiv_equivariant]
    change originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i
      (originalRelativeInternalHomologyRepresentation K hs d hrank Q a hstable j i (g * h) y) =
      originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i
        (originalRelativeInternalHomologyRepresentation K hs d hrank Q a hstable j i g
          (originalRelativeInternalHomologyRepresentation K hs d hrank Q a hstable j i h y))
    rw [map_mul]
    rfl

theorem originalRelativeTorDegreeRepresentation_filtered (j i : ℕ) (g : G) :
    Preserves (originalRelativeTorFiltration K hs d hrank Q hQ j i)
      (originalRelativeTorFiltration K hs d hrank Q hQ j i)
      (originalRelativeTorDegreeRepresentation K hs d hrank Q a hstable hQ j i g) :=
  originalRelativeTorDegreeAction_filtered K hs d Q (a.orderIso g) (hstable g) hrank hQ j i

section Intertwining
variable {M N : Type u} [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

/-- If a specified family of actual maps intertwines with a representation,
it obeys the group laws.  The family itself is retained as `toFun`. -/
def representationOfIntertwiningEquiv (ρ : Representation K G M) (E : M ≃ₗ[K] N)
    (τ : G → Module.End K N) (h : ∀ g x, E (ρ g x) = τ g (E x)) : Representation K G N where
  toFun := τ
  map_one' := by
    ext y
    obtain ⟨x, rfl⟩ := E.surjective y
    rw [← h, map_one]
    rfl
  map_mul' g h' := by
    ext y
    obtain ⟨x, rfl⟩ := E.surjective y
    rw [← h, map_mul]
    change E (ρ g (ρ h' x)) = τ g (τ h' (E x))
    rw [h, h]

end Intertwining
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.FiniteGradedSum -/
section

open scoped DirectSum
/-! # Finite filtrations and exact regrouping of associated graded modules

The associated graded object is the direct sum of all its literal quotient
grades.  A finite upper bound is proved to remove precisely zero grades.
The second construction regroups a family by its weight and then removes
that auxiliary weight index.  Every original index occurs once, including
the empty color set and all zero modules; no weight restriction survives in
the resulting statement.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.FilteredHomology
open Classical
variable {K : Type*} [CommRing K]
variable {M : Type*} [AddCommGroup M] [Module K M]

theorem filtration_level_top_of_ge (F : Filtration (K := K) M)
    (N : ℕ) (hN : F.level N = ⊤) (n : ℕ) (hn : N ≤ n) : F.level n = ⊤ := by
  apply top_unique
  rw [← hN]
  exact F.mono hn

theorem grade_subsingleton_of_finite (F : Filtration (K := K) M)
    (N : ℕ) (hN : F.level N = ⊤) (n : ℕ) (hn : N ≤ n) :
    Subsingleton (Grade F n) := by
  refine ⟨fun x y => ?_⟩
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  obtain ⟨y, rfl⟩ := (lowerInLevel F n).mkQ_surjective y
  apply (Submodule.Quotient.eq _).mpr
  change x.val - y.val ∈ F.level n
  rw [filtration_level_top_of_ge F N hN n hn]
  trivial

section Truncation
variable (K) (A : ℕ → Type*) [∀ n, AddCommGroup (A n)] [∀ n, Module K (A n)]

/-- Restriction to the first `N` indices is an equivalence exactly when
the omitted modules are zero.  Its map is literal coordinate restriction. -/
def directSumFiniteTruncation (N : ℕ)
    (hzero : ∀ n, N ≤ n → Subsingleton (A n)) :
    (⨁ n, A n) ≃ₗ[K] (∀ n : Fin N, A n.val) :=
  LinearEquiv.ofBijective
    { toFun := fun (x : ⨁ n, A n) (n : Fin N) => x n.val
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
    ⟨by
      intro x y h
      apply DFinsupp.ext
      intro n
      by_cases hn : n < N
      · exact congrFun h ⟨n, hn⟩
      · letI := hzero n (Nat.le_of_not_gt hn)
        exact Subsingleton.elim _ _,
    by
      intro x
      refine ⟨DFinsupp.mk (β := A) (Finset.range N)
        (fun n => x ⟨n.val, Finset.mem_range.mp n.property⟩), ?_⟩
      funext n
      change (DFinsupp.mk (β := A) (Finset.range N)
        (fun t => x ⟨t.val, Finset.mem_range.mp t.property⟩)) n.val = x n
      rw [DFinsupp.mk_of_mem (Finset.mem_range.mpr n.isLt)]⟩

@[simp] theorem directSumFiniteTruncation_apply (N : ℕ)
    (hzero : ∀ n, N ≤ n → Subsingleton (A n))
    (x : ⨁ n, A n) (n : Fin N) :
    directSumFiniteTruncation K A N hzero x n = x n.val := rfl

end Truncation

/-- The entire associated graded of a finite filtration is the finite
product of its possibly nonzero grades.  The zero cutoff is proved. -/
def associatedGradedFiniteEquiv (F : Filtration (K := K) M)
    (N : ℕ) (hN : F.level N = ⊤) :
    (⨁ n, Grade F n) ≃ₗ[K] (∀ n : Fin N, Grade F n.val) :=
  directSumFiniteTruncation K (Grade F) N (grade_subsingleton_of_finite F N hN)

section Fibers
variable (K) {I J : Type*} (w : I → J)
variable (H : I → Type*) [∀ s, AddCommGroup (H s)] [∀ s, Module K (H s)]

/-- Regrouping a direct sum by the fibers of an arbitrary function. -/
def directSumFiberLinearEquiv :
    (⨁ s, H s) ≃ₗ[K] (⨁ n, ⨁ s : {s : I // w s = n}, H s.val) :=
  (DirectSum.lequivCongrLeft K (Equiv.sigmaFiberEquiv w).symm).trans
    (DirectSum.sigmaLcurryEquiv K (δ := fun (n : J) (s : {s : I // w s = n}) => H s.val))

@[simp] theorem directSumFiberLinearEquiv_apply (x : ⨁ s, H s)
    (n : J) (s : {s : I // w s = n}) :
    directSumFiberLinearEquiv K w H x n s = x s.val := rfl

@[simp] theorem directSumFiberLinearEquiv_symm_apply
    (x : ⨁ n, ⨁ s : {s : I // w s = n}, H s.val) (s : I) :
    (directSumFiberLinearEquiv K w H).symm x s = x (w s) ⟨s, rfl⟩ := by
  exact congrArg (fun y => y (w s) ⟨s, rfl⟩)
    ((directSumFiberLinearEquiv K w H).apply_symm_apply x)

end Fibers

section FiniteFibers
variable (K) {I : Type*} [Fintype I] (w : I → ℕ)
variable (A : ℕ → Type*) [∀ n, AddCommGroup (A n)] [∀ n, Module K (A n)]
variable (H : I → Type*) [∀ s, AddCommGroup (H s)] [∀ s, Module K (H s)]

/-- An isomorphism in each weight gives an isomorphism of the complete
direct sum with all original summands.  No bound on the weight is assumed. -/
def gradedSumFiberEquiv
    (E : ∀ n, A n ≃ₗ[K] (∀ s : {s : I // w s = n}, H s.val)) :
    (⨁ n, A n) ≃ₗ[K] (∀ s, H s) :=
  (DirectSum.congrLinearEquiv (fun n => (E n).trans
    (DirectSum.linearEquivFunOnFintype K {s : I // w s = n} (fun s => H s.val)).symm)).trans
      ((directSumFiberLinearEquiv K w H).symm.trans
        (DirectSum.linearEquivFunOnFintype K I H))

@[simp] theorem gradedSumFiberEquiv_apply
    (E : ∀ n, A n ≃ₗ[K] (∀ s : {s : I // w s = n}, H s.val))
    (x : ⨁ n, A n) (s : I) :
    gradedSumFiberEquiv K w A H E x s = E (w s) (x (w s)) ⟨s, rfl⟩ := by
  simp only [gradedSumFiberEquiv, LinearEquiv.trans_apply,
    DirectSum.linearEquivFunOnFintype_apply]
  rw [directSumFiberLinearEquiv_symm_apply]
  rfl

/-- Coordinatewise intertwining survives the exact fiber regrouping. -/
theorem gradedSumFiberEquiv_intertwines
    (E : ∀ n, A n ≃ₗ[K] (∀ s : {s : I // w s = n}, H s.val))
    (a : ∀ n, A n →ₗ[K] A n) (b : ∀ s, H s →ₗ[K] H s)
    (he : ∀ n (x : A n) (s : {s : I // w s = n}),
      E n (a n x) s = b s.val (E n x s)) (x : ⨁ n, A n) :
    gradedSumFiberEquiv K w A H E (DirectSum.lmap a x) =
      fun s => b s (gradedSumFiberEquiv K w A H E x s) := by
  funext s
  simp only [gradedSumFiberEquiv_apply, DirectSum.lmap_apply]
  exact he (w s) (x (w s)) ⟨s, rfl⟩

end FiniteFibers

section TwoConditions
variable (K) {I : Type*} [Fintype I] (p : I → Prop) (w : I → ℕ)
variable (H : I → Type*) [∀ s, AddCommGroup (H s)] [∀ s, Module K (H s)]

/-- Separating an internal-degree condition from a weight condition. -/
def piConditionFiberEquiv (n : ℕ) :
    (∀ s : {s : I // p s ∧ w s = n}, H s.val) ≃ₗ[K]
      (∀ s : {s : {s : I // p s} // w s.val = n}, H s.val.val) where
  toFun x s := x ⟨s.val.val, s.val.property, s.property⟩
  invFun x s := x ⟨⟨s.val, s.property.1⟩, s.property.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

variable (A : ℕ → Type*) [∀ n, AddCommGroup (A n)] [∀ n, Module K (A n)]

/-- The final weight index disappears, leaving exactly the prescribed
internal-degree condition on the original finite family. -/
def gradedSumConditionEquiv
    (E : ∀ n, A n ≃ₗ[K] (∀ s : {s : I // p s ∧ w s = n}, H s.val)) :
    (⨁ n, A n) ≃ₗ[K] (∀ s : {s : I // p s}, H s.val) :=
  gradedSumFiberEquiv K (fun s : {s : I // p s} => w s.val) A (fun s => H s.val)
    (fun n => (E n).trans (piConditionFiberEquiv K p w H n))

@[simp] theorem gradedSumConditionEquiv_apply
    (E : ∀ n, A n ≃ₗ[K] (∀ s : {s : I // p s ∧ w s = n}, H s.val))
    (x : ⨁ n, A n) (s : {s : I // p s}) :
    gradedSumConditionEquiv K p w H A E x s =
      E (w s.val) (x (w s.val)) ⟨s.val, s.property, rfl⟩ := by
  rw [gradedSumConditionEquiv, gradedSumFiberEquiv_apply]
  rfl

theorem gradedSumConditionEquiv_intertwines
    (E : ∀ n, A n ≃ₗ[K] (∀ s : {s : I // p s ∧ w s = n}, H s.val))
    (a : ∀ n, A n →ₗ[K] A n) (b : ∀ s, H s →ₗ[K] H s)
    (he : ∀ n (x : A n) (s : {s : I // p s ∧ w s = n}),
      E n (a n x) s = b s.val (E n x s)) (x : ⨁ n, A n) :
    gradedSumConditionEquiv K p w H A E (DirectSum.lmap a x) =
      fun s => b s.val (gradedSumConditionEquiv K p w H A E x s) := by
  funext s
  simp only [gradedSumConditionEquiv_apply, DirectSum.lmap_apply]
  exact he (w s.val) (x (w s.val)) ⟨s.val, s.property, rfl⟩

end TwoConditions

theorem sum_finite_weight_fibers {I T : Type*} [Fintype I] [AddCommMonoid T]
    (p : I → Prop) (w : I → ℕ) (f : I → T) (N : ℕ)
    (hN : ∀ s, p s → w s < N) :
    (∑ n ∈ Finset.range N, ∑ s : {s : I // p s ∧ w s = n}, f s.val) =
      ∑ s : {s : I // p s}, f s.val := by
  calc
    _ = ∑ n ∈ Finset.range N,
        ∑ s ∈ (Finset.univ.filter p).filter (fun s => w s = n), f s := by
      apply Finset.sum_congr rfl
      intro n hn
      symm
      exact Finset.sum_subtype _ (by intro s; simp) f
    _ = ∑ s ∈ Finset.univ.filter p, f s :=
      Finset.sum_fiberwise_of_maps_to
        (fun s hs => Finset.mem_range.mpr (hN s (Finset.mem_filter.mp hs).2)) f
    _ = _ := Finset.sum_subtype _ (by intro s; simp) f

end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Universal.TorAssociatedGraded -/
section

open scoped DirectSum
/-! # The complete associated graded Tor module and its actual group action

These constructions include every filtration grade.  The direct-sum action
is induced from the actual action on Tor and its stable submodules.  The
comparison with the barycentric Koszul strands is equivariant over an
arbitrary commutative coefficient ring.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.FilteredHomology
open Classical
variable {K G M : Type*} [CommRing K] [Group G] [AddCommGroup M] [Module K M]

def filtrationGradeRepresentation (ρ : Representation K G M)
    (F : Filtration (K := K) M) (hF : ∀ g, Preserves F F (ρ g)) (n : ℕ) :
    Representation K G (Grade F n) where
  toFun g := gradeMap F F (ρ g) (hF g) n
  map_one' := by
    apply LinearMap.ext
    intro x
    obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
    change Submodule.Quotient.mk (levelMap F F (ρ 1) (hF 1) (n + 1) x) =
      Submodule.Quotient.mk x
    apply congrArg (Submodule.Quotient.mk (p := lowerInLevel F n))
    apply Subtype.ext
    change ρ 1 x.val = x.val
    rw [map_one]
    rfl
  map_mul' g h := by
    apply LinearMap.ext
    intro x
    obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
    change Submodule.Quotient.mk (levelMap F F (ρ (g * h)) (hF (g * h)) (n + 1) x) =
      Submodule.Quotient.mk (levelMap F F (ρ g) (hF g) (n + 1)
        (levelMap F F (ρ h) (hF h) (n + 1) x))
    apply congrArg (Submodule.Quotient.mk (p := lowerInLevel F n))
    apply Subtype.ext
    change ρ (g * h) x.val = ρ g (ρ h x.val)
    rw [map_mul]
    rfl

def directSumRepresentation {I : Type*} {A : I → Type*}
    [∀ i, AddCommGroup (A i)] [∀ i, Module K (A i)]
    (ρ : ∀ i, Representation K G (A i)) : Representation K G (⨁ i, A i) where
  toFun g := DirectSum.lmap (fun i => ρ i g)
  map_one' := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    change ρ i 1 (x i) = x i
    rw [map_one]
    rfl
  map_mul' g h := by
    apply LinearMap.ext
    intro x
    apply DFinsupp.ext
    intro i
    change ρ i (g * h) (x i) = ρ i g (ρ i h (x i))
    rw [map_mul]
    rfl

end FourPapers.FilteredHomology

namespace FourPapers.Universal
open Classical FourPapers.FilteredHomology
universe u v
variable {P K : Type u} {G : Type v} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K] [Group G]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

abbrev originalRelativeTorAssociatedGraded (j i : ℕ) :=
  ⨁ n, Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n

def originalRelativeTorAssociatedBigradedSum (j i : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i ≃ₗ[K]
      (⨁ n, barycentricRelativeBigradedHomology (P := P) K d Q j n i) :=
  DirectSum.congrLinearEquiv (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i)

def originalRelativeTorAssociatedFiniteEquiv (j i : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i ≃ₗ[K]
      (∀ n : Fin (2 * d * j + 1), Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n.val) :=
  associatedGradedFiniteEquiv _ _ (originalRelativeTorFiltration_finite K hs d hrank Q hQ j i)

theorem originalRelativeTorGrade_vanishes (j i n : ℕ) (hn : 2 * d * j + 1 ≤ n) :
    Subsingleton (Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n) :=
  grade_subsingleton_of_finite _ _ (originalRelativeTorFiltration_finite K hs d hrank Q hQ j i) n hn

variable (a : PosetGroupAction G P)
variable (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)

def originalRelativeTorGradeRepresentation (j i n : ℕ) :
    Representation K G (Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n) :=
  filtrationGradeRepresentation
    (originalRelativeTorDegreeRepresentation K hs d hrank Q a hstable hQ j i)
    (originalRelativeTorFiltration K hs d hrank Q hQ j i)
    (originalRelativeTorDegreeRepresentation_filtered K hs d hrank Q a hstable hQ j i) n

def originalRelativeTorAssociatedRepresentation (j i : ℕ) :
    Representation K G (originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i) :=
  directSumRepresentation (originalRelativeTorGradeRepresentation K hs d hrank Q hQ a hstable j i)

def barycentricRelativeBigradedRepresentationAllRings (j n i : ℕ) :
    Representation K G (barycentricRelativeBigradedHomology (P := P) K d Q j n i) :=
  representationOfIntertwiningEquiv K
    (originalRelativeTorGradeRepresentation K hs d hrank Q hQ a hstable j i n)
    (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n)
    (fun g => barycentricRelativeBigradedHomologyAction K d (a.orderIso g) Q (hstable g) j n i)
    (fun g x => originalRelativeTorAssociatedBigraded_equivariant K hs d Q
      (a.orderIso g) (hstable g) hrank hQ j i n x)

def barycentricRelativeBigradedSumRepresentation (j i : ℕ) :
    Representation K G (⨁ n, barycentricRelativeBigradedHomology (P := P) K d Q j n i) :=
  directSumRepresentation (fun n =>
    barycentricRelativeBigradedRepresentationAllRings K hs d hrank Q hQ a hstable j n i)

theorem originalRelativeTorAssociatedBigradedSum_equivariant (j i : ℕ) (g : G)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i) :
    originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ j i
      (originalRelativeTorAssociatedRepresentation K hs d hrank Q hQ a hstable j i g x) =
      barycentricRelativeBigradedSumRepresentation K hs d hrank Q hQ a hstable j i g
        (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ j i x) := by
  apply DFinsupp.ext
  intro n
  exact originalRelativeTorAssociatedBigraded_equivariant K hs d Q (a.orderIso g)
    (hstable g) hrank hQ j i n (x n)

section RankSubsets

def rankSubsetDegree {d : ℕ} (S : Finset (Fin d)) : ℕ := ∑ r ∈ S, (r.val + 1)

def rankSubsetWeight (d : ℕ) (S : Finset (Fin d)) : ℕ :=
  (∑ r ∈ S, rankWeight d (r.val + 1)).toNat

theorem rankSubsetWeight_bound (d : ℕ) (S : Finset (Fin d)) :
    rankSubsetWeight d S ≤ 2 * d * rankSubsetDegree S := by
  have h := koszulExteriorWeight_linear_bound d (⟨S, rfl⟩ : Set.powersetCard (Fin d) S.card)
  have hc : ((2 * d * rankSubsetDegree S : ℕ) : ℤ) =
      2 * (d : ℤ) * (rankSubsetDegree S : ℤ) := by push_cast; rfl
  change (∑ r ∈ S, rankWeight d (r.val + 1)) ≤
    2 * (d : ℤ) * (rankSubsetDegree S : ℤ) at h
  rw [← hc] at h
  exact Int.toNat_le.mpr h

theorem rankSubsetWeight_lt_cutoff (d j : ℕ) (S : Finset (Fin d))
    (hS : rankSubsetDegree S = j) : rankSubsetWeight d S < 2 * d * j + 1 := by
  have h := rankSubsetWeight_bound d S
  rw [hS] at h
  exact Nat.lt_succ_of_le h

end RankSubsets
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.AbsoluteTorFiltration -/
section

open scoped DirectSum
/-! # The absolute filtration on ordinary derived Tor

For the empty lower ideal, the restriction ideal is the whole face ring.
The identity-on-elements parameter-module equivalence induces the actual
Tor functor isomorphism.  The homogeneous pieces below are its images of
the genuine homogeneous resolution pieces, and their direct sum exhausts
ordinary Tor.  This supplies the absolute statement without identifying
two merely isomorphic coefficient modules by definition.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
section ParameterGenerality
variable {K : Type u} {C : Type} [CommRing K] [Fintype C] [LinearOrder C]

theorem ordinaryModuleParameterTorMap_comp
    {M N L : ModuleCat.{u} (MvPolynomial C K)} (f : M ⟶ N) (g : N ⟶ L) (i : ℕ) :
    ordinaryModuleParameterTorMap (f ≫ g) i =
      ordinaryModuleParameterTorMap f i ≫ ordinaryModuleParameterTorMap g i := by
  simp only [ordinaryModuleParameterTorMap, Functor.map_comp, NatTrans.comp_app]

def ordinaryModuleParameterTorIso {M N : ModuleCat.{u} (MvPolynomial C K)}
    (e : M ≅ N) (i : ℕ) : ordinaryModuleParameterTor M i ≅ ordinaryModuleParameterTor N i :=
  (ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapIso
    (((Tor (ModuleCat (MvPolynomial C K)) i).mapIso e).app
      (CommAlg.Koszul.residueCoefficientModule (V := C) (k := K)))

end ParameterGenerality

variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)
local instance absoluteParameterAlgebra : Algebra (MvPolynomial (Fin d) K) (FaceRing K hs) :=
  (faceParameterAction K hs d).toRingHom.toAlgebra

def originalEmptyRelativeCoefficientEquiv :
    faceRestrictionIdeal K hs (∅ : Set P) ≃ₗ[MvPolynomial (Fin d) K] FaceRing K hs where
  toFun := Subtype.val
  invFun x := ⟨x, by rw [faceRestrictionIdeal_empty]; trivial⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def originalEmptyRelativeTorIso (i : ℕ) :
    originalRelativeParameterTor K hs d (∅ : Set P) i ≅ originalParameterTor K hs d i :=
  ordinaryModuleParameterTorIso (originalEmptyRelativeCoefficientEquiv K hs d).toModuleIso i

def originalTorOrderMap (e : P ≃o P) (i : ℕ) : originalParameterTor K hs d i ⟶ originalParameterTor K hs d i :=
  ordinaryParameterTorMap (faceParameterAction K hs d) (faceParameterAction K hs d)
    (faceParameterOrderMap K hs d e) i

theorem originalEmptyRelativeTorIso_equivariant (e : P ≃o P) (i : ℕ)
    (x : originalRelativeParameterTor K hs d (∅ : Set P) i) :
    (originalEmptyRelativeTorIso K hs d i).hom
      (originalRelativeTorOrderMap K hs d (∅ : Set P) e (by simp) i x) =
      originalTorOrderMap K hs d e i ((originalEmptyRelativeTorIso K hs d i).hom x) := by
  have h :
      ModuleCat.ofHom (idealParameterCoefficientMap (faceParameterAction K hs d)
        (faceRestrictionIdeal K hs (∅ : Set P)) (faceParameterOrderMap K hs d e)
        (faceRingOrderAut_relative K hs (∅ : Set P) e (by simp))) ≫
        (originalEmptyRelativeCoefficientEquiv K hs d).toModuleIso.hom =
      (originalEmptyRelativeCoefficientEquiv K hs d).toModuleIso.hom ≫
        ModuleCat.ofHom (faceParameterOrderMap K hs d e) := by
    apply ModuleCat.hom_ext
    ext x
    rfl
  have ht := congrArg (fun f => ordinaryModuleParameterTorMap f i) h
  simp only [ordinaryModuleParameterTorMap_comp] at ht
  exact congrArg (fun f => f x) ht

variable (hrank : ∀ p : P, faceRank p ≤ d)

/-- The actual internally homogeneous submodule of ordinary absolute Tor. -/
def originalTorDegreePiece (j i : ℕ) : Submodule K (originalParameterTor K hs d i) :=
  (originalRelativeTorDegreePiece K hs d hrank (∅ : Set P) j i).map
    (originalEmptyRelativeTorIso K hs d i).toLinearEquiv.toLinearMap

def originalEmptyRelativeTorDegreeEquiv (j i : ℕ) :
    originalRelativeTorDegreePiece K hs d hrank (∅ : Set P) j i ≃ₗ[K]
      originalTorDegreePiece K hs d hrank j i :=
  (originalEmptyRelativeTorIso K hs d i).toLinearEquiv.submoduleMap _

/-- All internal degrees, with no omitted ordinary Tor class. -/
def originalTorInternalDecomposition (i : ℕ) :
    originalParameterTor K hs d i ≃ₗ[K] (⨁ j, originalTorDegreePiece K hs d hrank j i) :=
  (originalEmptyRelativeTorIso K hs d i).toLinearEquiv.symm.trans
    ((originalRelativeTorInternalDecomposition K hs d hrank (∅ : Set P) (by simp) i).trans
      (DirectSum.congrLinearEquiv (fun j => originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)))

def originalTorFiltration (j i : ℕ) : Filtration (K := K) (originalTorDegreePiece K hs d hrank j i) :=
  equivalenceFiltration K (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
    (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)

theorem originalEmptyRelativeTorDegreeEquiv_filtered (j i n : ℕ)
    (x : originalRelativeTorDegreePiece K hs d hrank (∅ : Set P) j i) :
    originalEmptyRelativeTorDegreeEquiv K hs d hrank j i x ∈ (originalTorFiltration K hs d hrank j i).level n ↔
      x ∈ (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i).level n :=
  equivalenceFiltration_apply K _ _ n x

theorem originalTorFiltration_finite (j i : ℕ) :
    (originalTorFiltration K hs d hrank j i).level (2 * d * j + 1) = ⊤ := by
  ext x
  change _ ∈ (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i).level
    (2 * d * j + 1) ↔ _
  rw [originalRelativeTorFiltration_finite]
  rfl

def originalTorAssociatedBigraded (j i n : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) n ≃ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i :=
  (gradeEquiv _ _ (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i) n).symm.trans
      (originalRelativeTorAssociatedBigraded K hs d hrank (∅ : Set P) (by simp) j i n)

abbrev originalTorAssociatedGraded (j i : ℕ) := ⨁ n, Grade (originalTorFiltration K hs d hrank j i) n

def originalTorAssociatedBigradedSum (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) :=
  DirectSum.congrLinearEquiv (originalTorAssociatedBigraded K hs d hrank j i)

def originalTorAssociatedFiniteEquiv (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      (∀ n : Fin (2 * d * j + 1), Grade (originalTorFiltration K hs d hrank j i) n.val) :=
  associatedGradedFiniteEquiv _ _ (originalTorFiltration_finite K hs d hrank j i)

variable (e : P ≃o P)

def originalTorDegreeAction (j i : ℕ) : Module.End K (originalTorDegreePiece K hs d hrank j i) :=
  restrictedMap (originalTorOrderMap K hs d e i).hom _ _ (by
    rintro x ⟨y, hy, rfl⟩
    refine ⟨originalRelativeTorOrderMap K hs d (∅ : Set P) e (by simp) i y, ?_, ?_⟩
    · exact (originalRelativeTorDegreeAction K hs d (∅ : Set P) e (by simp) hrank j i ⟨y, hy⟩).property
    · exact originalEmptyRelativeTorIso_equivariant K hs d e i y)

theorem originalEmptyRelativeTorDegreeEquiv_equivariant (j i : ℕ)
    (x : originalRelativeTorDegreePiece K hs d hrank (∅ : Set P) j i) :
    originalEmptyRelativeTorDegreeEquiv K hs d hrank j i
      (originalRelativeTorDegreeAction K hs d (∅ : Set P) e (by simp) hrank j i x) =
      originalTorDegreeAction K hs d hrank e j i
        (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i x) := by
  apply Subtype.ext
  exact originalEmptyRelativeTorIso_equivariant K hs d e i x.val

theorem originalTorDegreeAction_filtered (j i : ℕ) :
    Preserves (originalTorFiltration K hs d hrank j i) (originalTorFiltration K hs d hrank j i)
      (originalTorDegreeAction K hs d hrank e j i) := by
  intro n x hx
  obtain ⟨y, rfl⟩ := (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i).surjective x
  rw [← originalEmptyRelativeTorDegreeEquiv_equivariant]
  apply (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i n _).mpr
  exact originalRelativeTorDegreeAction_filtered K hs d (∅ : Set P) e (by simp) hrank (by simp) j i n y
    ((originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i n y).mp hx)

theorem originalTorAssociatedBigraded_equivariant (j i n : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) n) :
    originalTorAssociatedBigraded K hs d hrank j i n
      (gradeMap _ _ (originalTorDegreeAction K hs d hrank e j i)
        (originalTorDegreeAction_filtered K hs d hrank e j i) n x) =
      barycentricRelativeBigradedHomologyAction K d e (∅ : Set P) (by simp) j n i
        (originalTorAssociatedBigraded K hs d hrank j i n x) := by
  let E := gradeEquiv _ _ (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i) n
  have he := gradeEquiv_commutes _ _ _ _
    (originalRelativeTorDegreeAction K hs d (∅ : Set P) e (by simp) hrank j i)
    (originalTorDegreeAction K hs d hrank e j i)
    (originalRelativeTorDegreeAction_filtered K hs d (∅ : Set P) e (by simp) hrank (by simp) j i)
    (originalTorDegreeAction_filtered K hs d hrank e j i)
    (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i)
    (fun y => (originalEmptyRelativeTorDegreeEquiv_equivariant K hs d hrank e j i y).symm) n (E.symm x)
  have hcomm : E.symm (gradeMap _ _ (originalTorDegreeAction K hs d hrank e j i)
      (originalTorDegreeAction_filtered K hs d hrank e j i) n x) =
      gradeMap _ _ (originalRelativeTorDegreeAction K hs d (∅ : Set P) e (by simp) hrank j i)
        (originalRelativeTorDegreeAction_filtered K hs d (∅ : Set P) e (by simp) hrank (by simp) j i) n (E.symm x) := by
    apply E.injective
    rw [E.apply_symm_apply]
    have hc : gradeMap (originalTorFiltration K hs d hrank j i)
        (originalTorFiltration K hs d hrank j i)
        (originalTorDegreeAction K hs d hrank e j i)
        (originalTorDegreeAction_filtered K hs d hrank e j i) n (E (E.symm x)) =
      E (gradeMap (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
        (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
        (originalRelativeTorDegreeAction K hs d (∅ : Set P) e (by simp) hrank j i)
        (originalRelativeTorDegreeAction_filtered K hs d (∅ : Set P) e (by simp) hrank (by simp) j i) n
        (E.symm x)) := he
    rw [E.apply_symm_apply] at hc
    exact hc
  simp only [originalTorAssociatedBigraded, LinearEquiv.trans_apply]
  change originalRelativeTorAssociatedBigraded K hs d hrank (∅ : Set P) (by simp) j i n
      (E.symm (gradeMap (originalTorFiltration K hs d hrank j i)
        (originalTorFiltration K hs d hrank j i)
        (originalTorDegreeAction K hs d hrank e j i)
        (originalTorDegreeAction_filtered K hs d hrank e j i) n x)) =
    barycentricRelativeBigradedHomologyAction K d e (∅ : Set P) (by simp) j n i
      (originalRelativeTorAssociatedBigraded K hs d hrank (∅ : Set P) (by simp) j i n (E.symm x))
  rw [hcomm]
  exact originalRelativeTorAssociatedBigraded_equivariant K hs d (∅ : Set P) e (by simp)
    hrank (by simp) j i n (E.symm x)

section GroupAction
variable {G : Type v} [Group G] (a : PosetGroupAction G P)

def originalTorDegreeRepresentation (j i : ℕ) : Representation K G (originalTorDegreePiece K hs d hrank j i) :=
  representationOfIntertwiningEquiv K
    (originalRelativeTorDegreeRepresentation K hs d hrank (∅ : Set P) a (by simp) (by simp) j i)
    (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (fun g => originalTorDegreeAction K hs d hrank (a.orderIso g) j i)
    (fun g x => originalEmptyRelativeTorDegreeEquiv_equivariant K hs d hrank (a.orderIso g) j i x)

def originalTorAssociatedRepresentation (j i : ℕ) :
    Representation K G (originalTorAssociatedGraded K hs d hrank j i) :=
  directSumRepresentation (fun n => filtrationGradeRepresentation
    (originalTorDegreeRepresentation K hs d hrank a j i) (originalTorFiltration K hs d hrank j i)
    (fun g => originalTorDegreeAction_filtered K hs d hrank (a.orderIso g) j i) n)

theorem originalTorAssociatedBigradedSum_equivariant (j i : ℕ) (g : G)
    (x : originalTorAssociatedGraded K hs d hrank j i) :
    originalTorAssociatedBigradedSum K hs d hrank j i
      (originalTorAssociatedRepresentation K hs d hrank a j i g x) =
      barycentricRelativeBigradedSumRepresentation K hs d hrank (∅ : Set P) (by simp) a (by simp) j i g
        (originalTorAssociatedBigradedSum K hs d hrank j i x) := by
  apply DFinsupp.ext
  intro n
  exact originalTorAssociatedBigraded_equivariant K hs d hrank (a.orderIso g) j i n (x n)

end GroupAction
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.RepresentationGrothendieck -/
section

/-! # The Grothendieck group of finite-dimensional representations

We use the standard presentation: the free abelian group on finite
dimensional representations, modulo the relations supplied by genuine
short exact sequences of representations.  The finite-filtration identity
is proved by telescoping those exact sequences, without semisimplicity or
an averaging hypothesis.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.RepresentationGrothendieck
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v w
variable (K : Type u) (G : Type v) [Field K] [Group G]

structure FiniteRepresentation where
  module : ModuleCat.{u} K
  finite : Module.Finite K module
  action : Representation K G module

attribute [instance] FiniteRepresentation.finite
instance : CoeSort (FiniteRepresentation K G) (Type u) := ⟨fun V => V.module⟩

namespace FiniteRepresentation
variable {K G}

def of (M : Type u) [AddCommGroup M] [Module K M] [Module.Finite K M]
    (ρ : Representation K G M) : FiniteRepresentation K G := ⟨ModuleCat.of K M, inferInstance, ρ⟩

def sub (V : FiniteRepresentation K G) (N : Submodule K V)
    (hN : ∀ g x, x ∈ N → V.action g x ∈ N) : FiniteRepresentation K G where
  module := ModuleCat.of K N
  finite := inferInstance
  action :=
    { toFun := fun g => FourPapers.FilteredHomology.restrictedMap (V.action g) N N (hN g)
      map_one' := by
        apply LinearMap.ext
        intro x
        apply Subtype.ext
        change V.action 1 x.val = x.val
        rw [map_one]
        rfl
      map_mul' := by
        intro g h
        apply LinearMap.ext
        intro x
        apply Subtype.ext
        change V.action (g * h) x.val = V.action g (V.action h x.val)
        rw [map_mul]
        rfl }

def quotient (V : FiniteRepresentation K G) (N : Submodule K V)
    (hN : ∀ g x, x ∈ N → V.action g x ∈ N) : FiniteRepresentation K G where
  module := ModuleCat.of K (V ⧸ N)
  finite := inferInstance
  action :=
    { toFun := fun g => Submodule.mapQ N N (V.action g) (hN g)
      map_one' := by
        apply LinearMap.ext
        intro x
        obtain ⟨x, rfl⟩ := N.mkQ_surjective x
        change Submodule.Quotient.mk (V.action 1 x) = Submodule.Quotient.mk x
        rw [map_one]
        rfl
      map_mul' := by
        intro g h
        apply LinearMap.ext
        intro x
        obtain ⟨x, rfl⟩ := N.mkQ_surjective x
        change Submodule.Quotient.mk (V.action (g * h) x) = Submodule.Quotient.mk (V.action g (V.action h x))
        rw [map_mul]
        rfl }

def prod (V W : FiniteRepresentation K G) : FiniteRepresentation K G where
  module := ModuleCat.of K (V × W)
  finite := inferInstance
  action :=
    { toFun := fun g => (V.action g).prodMap (W.action g)
      map_one' := by ext x <;> simp
      map_mul' := by intro g h; ext x <;> simp }

def pi {K' : Type (max u w)} [Field K'] {I : Type w} [Finite I] (V : I → FiniteRepresentation K' G) : FiniteRepresentation K' G where
  module := ModuleCat.of K' (∀ i, V i)
  finite := inferInstance
  action :=
    { toFun := fun g => LinearMap.pi (fun i => (V i).action g |>.comp (LinearMap.proj i))
      map_one' := by
        apply LinearMap.ext
        intro x
        funext i
        change (V i).action 1 (x i) = x i
        rw [map_one]
        rfl
      map_mul' := by
        intro g h
        apply LinearMap.ext
        intro x
        funext i
        change (V i).action (g * h) (x i) = (V i).action g ((V i).action h (x i))
        rw [map_mul]
        rfl }

end FiniteRepresentation

/-- An exact sequence uses actual equivariant linear maps, with injective
left map, exact middle, and surjective right map. -/
structure ShortExactRepresentation (U V W : FiniteRepresentation K G) where
  f : U →ₗ[K] V
  g : V →ₗ[K] W
  f_equivariant : ∀ h x, f (U.action h x) = V.action h (f x)
  g_equivariant : ∀ h x, g (V.action h x) = W.action h (g x)
  injective : Function.Injective f
  exact : LinearMap.range f = LinearMap.ker g
  surjective : Function.Surjective g

def relations : AddSubgroup (FreeAbelianGroup (FiniteRepresentation K G)) :=
  AddSubgroup.closure {r | ∃ U V W : FiniteRepresentation K G,
    Nonempty (ShortExactRepresentation K G U V W) ∧
      r = FreeAbelianGroup.of V - FreeAbelianGroup.of U - FreeAbelianGroup.of W}

abbrev GrothendieckGroup := FreeAbelianGroup (FiniteRepresentation K G) ⧸ relations K G

def classOf (V : FiniteRepresentation K G) : GrothendieckGroup K G :=
  QuotientAddGroup.mk (FreeAbelianGroup.of V)

variable {K G}

theorem class_shortExact {U V W : FiniteRepresentation K G}
    (S : ShortExactRepresentation K G U V W) :
    classOf K G V = classOf K G U + classOf K G W := by
  have hm : FreeAbelianGroup.of V - FreeAbelianGroup.of U - FreeAbelianGroup.of W ∈ relations K G :=
    AddSubgroup.subset_closure ⟨U, V, W, ⟨S⟩, rfl⟩
  have hz := (QuotientAddGroup.eq_zero_iff
    (FreeAbelianGroup.of V - FreeAbelianGroup.of U - FreeAbelianGroup.of W)).mpr hm
  change classOf K G V - classOf K G U - classOf K G W = 0 at hz
  exact (sub_eq_iff_eq_add.mp (sub_eq_zero.mp hz)).trans (add_comm _ _)

theorem class_subsingleton (V : FiniteRepresentation K G) [Subsingleton V] : classOf K G V = 0 := by
  let S : ShortExactRepresentation K G V V V :=
    { f := 0
      g := 0
      f_equivariant := fun _ _ => by simp
      g_equivariant := fun _ _ => by simp
      injective := fun _ _ _ => Subsingleton.elim _ _
      exact := Subsingleton.elim _ _
      surjective := fun x => ⟨0, Subsingleton.elim _ _⟩ }
  have h := congrArg (fun y => y - classOf K G V) (class_shortExact S)
  simpa only [sub_self, add_sub_cancel_left] using h.symm

theorem class_equiv {V W : FiniteRepresentation K G} (e : V ≃ₗ[K] W)
    (he : ∀ g x, e (V.action g x) = W.action g (e x)) : classOf K G V = classOf K G W := by
  let Z := FiniteRepresentation.sub V ⊥ (fun _ x hx => by
    have hx0 : x = 0 := hx
    rw [hx0, map_zero]
    exact Submodule.zero_mem _)
  letI : Subsingleton Z := by
    change Subsingleton (⊥ : Submodule K V)
    infer_instance
  let S : ShortExactRepresentation K G Z V W :=
    { f := 0
      g := e.toLinearMap
      f_equivariant := fun _ _ => by simp
      g_equivariant := he
      injective := fun _ _ _ => Subsingleton.elim _ _
      exact := by rw [LinearMap.range_zero, LinearMap.ker_eq_bot.mpr e.injective]
      surjective := e.surjective }
  have h := class_shortExact S
  rw [class_subsingleton Z, zero_add] at h
  exact h

def subQuotientSequence (V : FiniteRepresentation K G) (N : Submodule K V)
    (hN : ∀ g x, x ∈ N → V.action g x ∈ N) :
    ShortExactRepresentation K G (V.sub N hN) V (V.quotient N hN) where
  f := N.subtype
  g := N.mkQ
  f_equivariant := fun _ _ => rfl
  g_equivariant := fun _ _ => rfl
  injective := Subtype.val_injective
  exact := by rw [Submodule.range_subtype, Submodule.ker_mkQ]
  surjective := N.mkQ_surjective

theorem class_prod (V W : FiniteRepresentation K G) :
    classOf K G (V.prod W) = classOf K G V + classOf K G W := by
  let S : ShortExactRepresentation K G V (V.prod W) W :=
    { f := LinearMap.inl K V W
      g := LinearMap.snd K V W
      f_equivariant := fun g x => by
        change (V.action g x, 0) = (V.action g x, W.action g 0)
        rw [map_zero]
      g_equivariant := fun _ _ => rfl
      injective := fun x y h => congrArg Prod.fst h
      exact := by
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          rfl
        · intro hx
          exact ⟨x.1, Prod.ext rfl hx.symm⟩
      surjective := fun y => ⟨(0, y), rfl⟩ }
  exact class_shortExact S

theorem class_pi {K' : Type (max u w)} [Field K'] (I : Type w) [Fintype I] (V : I → FiniteRepresentation K' G) :
    classOf K' G (FiniteRepresentation.pi V) = ∑ i, classOf K' G (V i) := by
  classical
  revert V
  refine Fintype.induction_empty_option
    (P := fun I _ => ∀ V : I → FiniteRepresentation K' G,
      classOf K' G (FiniteRepresentation.pi V) = ∑ i, classOf K' G (V i)) ?_ ?_ ?_ I
  · intro A B _ e ih V
    letI : Fintype A := Fintype.ofEquiv B e.symm
    have h := class_equiv (V := FiniteRepresentation.pi V)
      (W := FiniteRepresentation.pi (fun a => V (e a)))
      (LinearEquiv.piCongrLeft' K' (fun b => V b) e.symm) (fun _ _ => rfl)
    rw [h, ih]
    exact e.sum_comp (fun b => classOf K' G (V b))
  · intro V
    letI : Subsingleton (FiniteRepresentation.pi V) := by
      change Subsingleton (∀ a : PEmpty, V a)
      infer_instance
    rw [class_subsingleton]
    simp
  · intro A _ ih V
    rw [class_equiv (V := FiniteRepresentation.pi V)
      (W := (V none).prod (FiniteRepresentation.pi (fun a => V (some a))))
      (LinearEquiv.piOptionEquivProd K') (fun _ _ => rfl), class_prod, ih]
    simp

section Filtration
variable (V : FiniteRepresentation K G) (F : Filtration (K := K) V)
    (hF : ∀ g, Preserves F F (V.action g))

def levelRepresentation (n : ℕ) : FiniteRepresentation K G :=
  V.sub (F.level n) (fun g x hx => hF g n x hx)

def gradeRepresentation (n : ℕ) : FiniteRepresentation K G :=
  (levelRepresentation V F hF (n + 1)).quotient (lowerInLevel F n)
    (fun g x hx => hF g n x.val hx)

/-- The representation action on the successive quotient is exactly the
usual induced filtration-quotient action. -/
theorem gradeRepresentation_action (n : ℕ) (g : G) :
    (gradeRepresentation V F hF n).action g = gradeMap F F (V.action g) (hF g) n := rfl

def filtrationSequence (n : ℕ) :
    ShortExactRepresentation K G (levelRepresentation V F hF n)
      (levelRepresentation V F hF (n + 1)) (gradeRepresentation V F hF n) where
  f := Submodule.inclusion (F.mono (Nat.le_succ n))
  g := (lowerInLevel F n).mkQ
  f_equivariant := fun _ _ => by apply Subtype.ext; rfl
  g_equivariant := fun _ _ => rfl
  injective := fun x y h => Subtype.ext (congrArg (fun z : F.level (n + 1) => z.val) h)
  exact := by
    rw [Submodule.ker_mkQ]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact y.property
    · intro hx
      exact ⟨⟨x.val, hx⟩, rfl⟩
  surjective := (lowerInLevel F n).mkQ_surjective

theorem level_class_sum (n : ℕ) :
    classOf K G (levelRepresentation V F hF n) =
      ∑ m ∈ Finset.range n, classOf K G (gradeRepresentation V F hF m) := by
  induction n with
  | zero =>
      haveI : Subsingleton (levelRepresentation V F hF 0) := by
        change Subsingleton (F.level 0)
        rw [F.zero]
        infer_instance
      rw [class_subsingleton]
      simp
  | succ n ih =>
      rw [class_shortExact (filtrationSequence V F hF n), ih, Finset.sum_range_succ]

/-- The Grothendieck-group class of a finite stable filtration is the sum
of its actual successive quotient classes, in every characteristic. -/
theorem finiteFiltration_class (N : ℕ) (hN : F.level N = ⊤) :
    classOf K G V = ∑ n ∈ Finset.range N, classOf K G (gradeRepresentation V F hF n) := by
  have h := class_equiv (V := levelRepresentation V F hF N) (W := V)
    (LinearEquiv.ofTop (F.level N) hN) (fun _ _ => rfl)
  exact h.symm.trans (level_class_sum V F hF N)

end Filtration
end FourPapers.RepresentationGrothendieck

end
end

/- BEGIN FourPapers.Universal.TorGrothendieck -/
section

/-! # The actual field representation-class consequence of the finite Tor filtration -/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology FourPapers.RepresentationGrothendieck
universe u v
variable {P K : Type u} {G : Type v} [PartialOrder P] [OrderBot P] [Fintype P] [Field K] [Group G]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (a : PosetGroupAction G P)
variable (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)
variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def originalRelativeTorFiniteRepresentation (j i : ℕ) : FiniteRepresentation K G := by
  letI := originalRelativeTorDegreePiece_finiteDimensional K hs d hrank Q hQ j i
  exact FiniteRepresentation.of (originalRelativeTorDegreePiece K hs d hrank Q j i)
    (originalRelativeTorDegreeRepresentation K hs d hrank Q a hstable hQ j i)

def originalRelativeTorGradeFiniteRepresentation (j i n : ℕ) : FiniteRepresentation K G :=
  gradeRepresentation (originalRelativeTorFiniteRepresentation K hs d hrank Q a hstable hQ j i)
    (originalRelativeTorFiltration K hs d hrank Q hQ j i)
    (originalRelativeTorDegreeRepresentation_filtered K hs d hrank Q a hstable hQ j i) n

def barycentricRelativeBigradedRepresentation (j n i : ℕ) :
    Representation K G (barycentricRelativeBigradedHomology (P := P) K d Q j n i) :=
  representationOfIntertwiningEquiv K
    (originalRelativeTorGradeFiniteRepresentation K hs d hrank Q a hstable hQ j i n).action
    (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n)
    (fun g => barycentricRelativeBigradedHomologyAction K d (a.orderIso g) Q (hstable g) j n i)
    (fun g x => originalRelativeTorAssociatedBigraded_equivariant K hs d Q
      (a.orderIso g) (hstable g) hrank hQ j i n x)

def barycentricRelativeBigradedFiniteRepresentation (j n i : ℕ) : FiniteRepresentation K G := by
  letI : Module.Finite K (Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n) :=
    (originalRelativeTorGradeFiniteRepresentation K hs d hrank Q a hstable hQ j i n).finite
  letI : Module.Finite K (barycentricRelativeBigradedHomology (P := P) K d Q j n i) :=
    Module.Finite.equiv (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n)
  exact FiniteRepresentation.of (barycentricRelativeBigradedHomology (P := P) K d Q j n i)
    (barycentricRelativeBigradedRepresentation K hs d hrank Q a hstable hQ j n i)

theorem originalRelativeTorGrade_class (j i n : ℕ) :
    classOf K G (originalRelativeTorGradeFiniteRepresentation K hs d hrank Q a hstable hQ j i n) =
      classOf K G (barycentricRelativeBigradedFiniteRepresentation K hs d hrank Q a hstable hQ j n i) :=
  class_equiv (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n)
    (fun g x => originalRelativeTorAssociatedBigraded_equivariant K hs d Q
      (a.orderIso g) (hstable g) hrank hQ j i n x)

/-- The field representation identity follows from the actual stable
finite filtration and the exact-sequence definition of the Grothendieck
group.  It remains valid in modular characteristic. -/
theorem originalRelativeTor_class_bigraded (j i : ℕ) :
    classOf K G (originalRelativeTorFiniteRepresentation K hs d hrank Q a hstable hQ j i) =
      ∑ n ∈ Finset.range (2 * d * j + 1),
        classOf K G (barycentricRelativeBigradedFiniteRepresentation K hs d hrank Q a hstable hQ j n i) := by
  calc
    _ = ∑ n ∈ Finset.range (2 * d * j + 1),
      classOf K G (originalRelativeTorGradeFiniteRepresentation K hs d hrank Q a hstable hQ j i n) :=
      finiteFiltration_class (originalRelativeTorFiniteRepresentation K hs d hrank Q a hstable hQ j i)
        (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorDegreeRepresentation_filtered K hs d hrank Q a hstable hQ j i)
        (2 * d * j + 1) (originalRelativeTorFiltration_finite K hs d hrank Q hQ j i)
    _ = _ := Finset.sum_congr rfl (fun n _ => originalRelativeTorGrade_class K hs d hrank Q a hstable hQ j i n)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.ParityHomology -/
section

/-! The ordinary cycles-modulo-boundaries algebra, using the parity involution
to state the Koszul Leibniz identity on elements of arbitrary degree. This is the
same quotient construction as the graded formulation in TauCeti's DG algebra
library; no grading, exactness, or generation property is assumed here. -/

set_option autoImplicit false
set_option Elab.async false
noncomputable section

namespace FourPapers
variable (K A : Type*) [CommRing K] [Ring A] [Algebra K A]

structure ParityDifferential where
  d : A →ₗ[K] A
  parity : A →ₐ[K] A
  square_zero : ∀ x, d (d x) = 0
  parity_square : ∀ x, parity (parity x) = x
  anticommute : ∀ x, d (parity x) = -parity (d x)
  map_one : d 1 = 0
  leibniz : ∀ x y, d (x * y) = d x * y + parity x * d y

namespace ParityDifferential
variable {K A} (D : ParityDifferential K A)

def cycles : Subalgebra K A :=
  (LinearMap.ker D.d).toSubalgebra D.map_one (by
    intro x y hx hy
    change D.d (x * y) = 0
    rw [D.leibniz, show D.d x = 0 from hx, show D.d y = 0 from hy]
    simp)

@[simp] lemma mem_cycles (x : A) : x ∈ D.cycles ↔ D.d x = 0 := Iff.rfl

lemma parity_cycle {x : A} (hx : D.d x = 0) : D.d (D.parity x) = 0 := by
  rw [D.anticommute, hx, map_zero, neg_zero]

def boundaries : TwoSidedIdeal D.cycles :=
  TwoSidedIdeal.mk' {z : D.cycles | z.val ∈ LinearMap.range D.d}
    (by exact ⟨0, map_zero _⟩)
    (fun {x y} hx hy => by
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by simpa only [map_add, ha, hb, Subalgebra.coe_add]⟩)
    (fun {x} hx => by
      obtain ⟨a, ha⟩ := hx
      exact ⟨-a, by simpa only [map_neg, ha, Subalgebra.coe_neg]⟩)
    (fun {x y} hy => by
      obtain ⟨b, hb⟩ := hy
      refine ⟨D.parity x.val * b, ?_⟩
      change D.d (D.parity x.val * b) = x.val * y.val
      rw [D.leibniz, D.parity_cycle x.property, D.parity_square, hb]
      simp)
    (fun {x y} hx => by
      obtain ⟨a, ha⟩ := hx
      refine ⟨a * y.val, ?_⟩
      change D.d (a * y.val) = x.val * y.val
      rw [D.leibniz, show D.d y.val = 0 from y.property, ha]
      simp)

@[simp] lemma mem_boundaries (z : D.cycles) :
    z ∈ D.boundaries ↔ z.val ∈ LinearMap.range D.d :=
  TwoSidedIdeal.mem_mk' _ _ _ _ _ _ _

abbrev Homology := D.cycles ⧸ D.boundaries.asIdeal

def classMap : D.cycles →ₐ[K] D.Homology := Ideal.Quotient.mkₐ K D.boundaries.asIdeal

@[simp] lemma classMap_eq_zero (z : D.cycles) :
    D.classMap z = 0 ↔ ∃ b : A, D.d b = z.val := by
  change Ideal.Quotient.mk D.boundaries.asIdeal z = 0 ↔ _
  rw [Ideal.Quotient.eq_zero_iff_mem, TwoSidedIdeal.mem_asIdeal, D.mem_boundaries]
  rfl

lemma classMap_surjective : Function.Surjective D.classMap :=
  Ideal.Quotient.mk_surjective

/-- Equality of the two quotient classes is exactly the usual condition that
their difference is an actual boundary. -/
lemma classMap_eq_iff (x y : D.cycles) :
    D.classMap x = D.classMap y ↔ ∃ b : A, D.d b = x.val - y.val := by
  rw [←sub_eq_zero, ←map_sub, D.classMap_eq_zero]
  rfl

/-- The quotient here is the ordinary vector/module quotient of cycles by the
image of the differential, not a quotient by a larger generated ideal. -/
lemma boundaries_exact_range :
    D.boundaries.asIdeal.restrictScalars K =
      (LinearMap.range D.d).comap D.cycles.val.toLinearMap := by
  ext z
  exact (TwoSidedIdeal.mem_asIdeal.trans (D.mem_boundaries z))

end ParityDifferential
end FourPapers

end
end

/- BEGIN FourPapers.Common.ParityHomologyBridge -/
section

/-! # Homological components inside the actual total homology algebra

This file descends a literal chain embedding to cycles modulo boundaries.
A projection onto the preceding homogeneous component proves injectivity:
an arbitrary total boundary of a homogeneous cycle has a homogeneous
primitive.  Neither exactness nor product compatibility is assumed.
-/
noncomputable section
set_option autoImplicit false

namespace FourPapers.ParityDifferential

open FilteredHomology

variable {K A X Y Z : Type*} [CommRing K] [Ring A] [Algebra K A]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z]

variable (D : ParityDifferential K A)
  (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
  (e : Y →ₗ[K] A)
  (he : ∀ y, g y = 0 → D.d (e y) = 0)
  (u : X →ₗ[K] A) (hu : ∀ x, D.d (u x) = e (f x))

def componentCycleMap : LinearMap.ker g →ₗ[K] D.cycles where
  toFun y := ⟨e y.val, he y.val y.property⟩
  map_add' x y := Subtype.ext (map_add e x.val y.val)
  map_smul' c y := Subtype.ext (map_smul e c y.val)

def componentCycleClass : LinearMap.ker g →ₗ[K] D.Homology :=
  D.classMap.toLinearMap.comp (D.componentCycleMap g e he)

include hu in
theorem componentCycleClass_boundary (x : X) :
    D.componentCycleClass g e he (boundaryMap f g hfg x) = 0 := by
  change D.classMap (D.componentCycleMap g e he (boundaryMap f g hfg x)) = 0
  exact (D.classMap_eq_zero _).mpr ⟨u x, hu x⟩

/-- The map from the genuine component kernel/image quotient to the total
cycles/boundaries algebra, induced by the given chain embedding. -/
def componentHomologyMap : FourPapers.FilteredHomology.Homology f g hfg →ₗ[K] D.Homology :=
  (LinearMap.range (boundaryMap f g hfg)).liftQ
    (D.componentCycleClass g e he) (by
      rintro z ⟨x, rfl⟩
      exact D.componentCycleClass_boundary f g hfg e he u hu x)

@[simp] theorem componentHomologyMap_class (y : LinearMap.ker g) :
    D.componentHomologyMap f g hfg e he u hu (homologyClass f g hfg y) =
      D.classMap (D.componentCycleMap g e he y) := rfl

variable (q : A →ₗ[K] Y) (p : A →ₗ[K] X)
  (hq : ∀ y, q (e y) = y) (hp : ∀ a, f (p a) = q (D.d a))

include hq hp in
/-- Projecting a total primitive onto the preceding homogeneous component
proves that the actual homology map is injective. -/
theorem componentHomologyMap_injective :
    Function.Injective (D.componentHomologyMap f g hfg e he u hu) := by
  have hzero : ∀ x : FourPapers.FilteredHomology.Homology f g hfg,
      D.componentHomologyMap f g hfg e he u hu x = 0 → x = 0 := by
    intro x hx
    obtain ⟨y, rfl⟩ := (LinearMap.range (boundaryMap f g hfg)).mkQ_surjective x
    have hy : D.classMap (D.componentCycleMap g e he y) = 0 := hx
    obtain ⟨a, ha⟩ := (D.classMap_eq_zero _).mp hy
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    refine ⟨p a, Subtype.ext ?_⟩
    calc
      f (p a) = q (D.d a) := hp a
      _ = q (e y.val) := congrArg q ha
      _ = y.val := hq y.val
  intro x y hxy
  apply sub_eq_zero.mp
  apply hzero
  rw [map_sub, hxy, sub_self]

end FourPapers.ParityDifferential

end
end

/- BEGIN FourPapers.Common.FilteredBilinearProduct -/
section

/-! # Bilinear products on the actual associated-grade quotients -/
noncomputable section
set_option autoImplicit false

namespace FourPapers.FilteredHomology

variable {K X Y Z : Type*} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z]

def PreservesPair (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (H : Filtration (K := K) Z) (p : X →ₗ[K] Y →ₗ[K] Z) : Prop :=
  ∀ r s x y, x ∈ F.level (r + 1) → y ∈ G.level (s + 1) → p x y ∈ H.level (r + s + 1)

variable (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
  (H : Filtration (K := K) Z) (p : X →ₗ[K] Y →ₗ[K] Z) (hp : PreservesPair F G H p)

include hp in
theorem preservesPair_left_lower (r s : ℕ) (x : X) (y : Y)
    (hx : x ∈ F.level r) (hy : y ∈ G.level (s + 1)) : p x y ∈ H.level (r + s) := by
  cases r with
  | zero =>
      have hx0 : x = 0 := by simpa only [F.zero, Submodule.mem_bot] using hx
      rw [hx0, map_zero, LinearMap.zero_apply]
      exact Submodule.zero_mem _
  | succ r =>
      simpa only [Nat.succ_eq_add_one, Nat.add_assoc, Nat.add_comm 1 s] using hp r s x y hx hy

include hp in
theorem preservesPair_right_lower (r s : ℕ) (x : X) (y : Y)
    (hx : x ∈ F.level (r + 1)) (hy : y ∈ G.level s) : p x y ∈ H.level (r + s) := by
  cases s with
  | zero =>
      have hy0 : y = 0 := by simpa only [G.zero, Submodule.mem_bot] using hy
      rw [hy0, map_zero]
      exact Submodule.zero_mem _
  | succ s => simpa only [Nat.succ_eq_add_one, Nat.add_assoc] using hp r s x y hx hy

def levelBilinearProduct (r s : ℕ) :
    F.level (r + 1) →ₗ[K] G.level (s + 1) →ₗ[K] H.level (r + s + 1) where
  toFun x :=
    { toFun := fun y => ⟨p x.val y.val, hp r s x.val y.val x.property y.property⟩
      map_add' y z := Subtype.ext (map_add (p x.val) y.val z.val)
      map_smul' c y := Subtype.ext (map_smul (p x.val) c y.val) }
  map_add' x z := by
    ext y
    exact LinearMap.congr_fun (map_add p x.val z.val) y.val
  map_smul' c x := by
    ext y
    exact LinearMap.congr_fun (map_smul p c x.val) y.val

def levelBilinearClass (r s : ℕ) :
    F.level (r + 1) →ₗ[K] G.level (s + 1) →ₗ[K] Grade H (r + s) :=
  (levelBilinearProduct F G H p hp r s).compr₂ (lowerInLevel H (r + s)).mkQ

theorem levelBilinearClass_left_lower (r s : ℕ) :
    lowerInLevel F r ≤ LinearMap.ker (levelBilinearClass F G H p hp r s) := by
  intro x hx
  apply LinearMap.ext
  intro y
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  exact preservesPair_left_lower F G H p hp r s x.val y.val hx y.property

theorem levelBilinearClass_right_lower (r s : ℕ) :
    lowerInLevel G s ≤ LinearMap.ker (levelBilinearClass F G H p hp r s).flip := by
  intro y hy
  apply LinearMap.ext
  intro x
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  exact preservesPair_right_lower F G H p hp r s x.val y.val x.property hy

/-- The product on two genuine consecutive filtration quotients. -/
def gradeBilinearProduct (r s : ℕ) : Grade F r →ₗ[K] Grade G s →ₗ[K] Grade H (r + s) :=
  (levelBilinearClass F G H p hp r s).liftQ₂ _ _
    (levelBilinearClass_left_lower F G H p hp r s)
    (levelBilinearClass_right_lower F G H p hp r s)

@[simp] theorem gradeBilinearProduct_mk (r s : ℕ)
    (x : F.level (r + 1)) (y : G.level (s + 1)) :
    gradeBilinearProduct F G H p hp r s (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk (levelBilinearProduct F G H p hp r s x y) := rfl

section Naturality

variable {X' Y' Z' : Type*} [AddCommGroup X'] [Module K X']
  [AddCommGroup Y'] [Module K Y'] [AddCommGroup Z'] [Module K Z']
  (F' : Filtration (K := K) X') (G' : Filtration (K := K) Y') (H' : Filtration (K := K) Z')
  (p' : X' →ₗ[K] Y' →ₗ[K] Z') (hp' : PreservesPair F' G' H' p')
  (a : X →ₗ[K] X') (b : Y →ₗ[K] Y') (c : Z →ₗ[K] Z')
  (ha : Preserves F F' a) (hb : Preserves G G' b) (hc : Preserves H H' c)

theorem gradeBilinearProduct_natural_of_lower_defect
    (hdefect : ∀ r s x y, x ∈ F.level (r + 1) → y ∈ G.level (s + 1) →
      c (p x y) - p' (a x) (b y) ∈ H'.level (r + s))
    (r s : ℕ) (x : Grade F r) (y : Grade G s) :
    gradeMap H H' c hc (r + s) (gradeBilinearProduct F G H p hp r s x y) =
      gradeBilinearProduct F' G' H' p' hp' r s (gradeMap F F' a ha r x) (gradeMap G G' b hb s y) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel F r).mkQ_surjective x
  obtain ⟨y, rfl⟩ := (lowerInLevel G s).mkQ_surjective y
  apply (Submodule.Quotient.eq _).mpr
  exact hdefect r s x.val y.val x.property y.property

end Naturality
end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Universal.CoefficientExteriorDGA -/
section

/-! # The ordinary coefficient-exterior Koszul differential algebra

This construction uses the literal exterior algebra over the coefficient
ring.  Multiplication, parity, cycles, and boundaries are all defined before
any comparison with the face ring or its associated graded.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open CliffordAlgebra
variable {K B C : Type*} [CommRing K] [CommRing B] [Algebra K B] [Fintype C]

abbrev CoefficientExterior (B C : Type*) [CommRing B] := ExteriorAlgebra B (C → B)

/-- The genuine Koszul differential graded algebra for an arbitrary family
of coefficients in an arbitrary commutative algebra. -/
def coefficientExteriorDGA (γ : C → B) :
    FourPapers.ParityDifferential K (CoefficientExterior B C) where
  d := (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm B (C → B)))
    (Fintype.linearCombination B γ)).restrictScalars K
  parity := (CliffordAlgebra.involute (Q := (0 : QuadraticForm B (C → B)))).restrictScalars K
  square_zero x := CliffordAlgebra.contractLeft_contractLeft (Fintype.linearCombination B γ) x
  parity_square x := CliffordAlgebra.involute_involute x
  anticommute x := by
    change CliffordAlgebra.contractLeft (Fintype.linearCombination B γ) (CliffordAlgebra.involute x) =
      -CliffordAlgebra.involute (CliffordAlgebra.contractLeft (Fintype.linearCombination B γ) x)
    rw [CliffordAlgebra.involute_contractLeft, neg_neg]
  map_one := CliffordAlgebra.contractLeft_one (0 : QuadraticForm B (C → B))
    (Fintype.linearCombination B γ)
  leibniz x y := CliffordAlgebra.contractLeft_mul (Fintype.linearCombination B γ) x y

@[simp] theorem coefficientExteriorDGA_scalar (γ : C → B) (b : B) :
    (coefficientExteriorDGA (K := K) γ).d (algebraMap B (CoefficientExterior B C) b) = 0 :=
  CliffordAlgebra.contractLeft_algebraMap (0 : QuadraticForm B (C → B))
    (Fintype.linearCombination B γ) b

@[simp] theorem coefficientExteriorDGA_generator (γ : C → B) (i : C) :
    (coefficientExteriorDGA (K := K) γ).d
      (ExteriorAlgebra.ι B ((Pi.basisFun B C) i)) =
      algebraMap B (CoefficientExterior B C) (γ i) := by
  classical
  change CliffordAlgebra.contractLeft (Fintype.linearCombination B γ)
    (ExteriorAlgebra.ι B ((Pi.basisFun B C) i)) = _
  rw [CliffordAlgebra.contractLeft_ι]
  congr 1
  rw [Pi.basisFun_apply, Fintype.linearCombination_apply_single, one_smul]

/-- Ordinary cycles modulo the actual image of the Koszul differential. -/
abbrev CoefficientExteriorHomology (γ : C → B) := (coefficientExteriorDGA (K := K) γ).Homology

theorem coefficientExteriorHomology_exact_boundaries (γ : C → B) :
    (coefficientExteriorDGA (K := K) γ).boundaries.asIdeal.restrictScalars K =
      (LinearMap.range (coefficientExteriorDGA (K := K) γ).d).comap
        (coefficientExteriorDGA (K := K) γ).cycles.val.toLinearMap :=
  (coefficientExteriorDGA (K := K) γ).boundaries_exact_range

end FourPapers.Universal

#print axioms FourPapers.Universal.coefficientExteriorDGA
#print axioms FourPapers.Universal.coefficientExteriorHomology_exact_boundaries

end
end

/- BEGIN FourPapers.Universal.CoefficientExteriorHomology -/
section

/-! # Actual homogeneous Koszul homology in the total exterior algebra

The maps use the ordinary exterior basis over the coefficient algebra.
The differential is the literal contraction defining `coefficientExteriorDGA`.
Projection onto exterior degree `i + 1` recovers a homogeneous primitive of
every total boundary in exterior degree `i`.
-/
noncomputable section
set_option autoImplicit false

namespace FourPapers.Universal

open Classical Finset CommAlg CategoryTheory CliffordAlgebra
open FourPapers.FilteredHomology

universe u v
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

def coefficientExteriorBasis : Module.Basis (Finset C) B (CoefficientExterior B C) :=
  (Pi.basisFun B C).ExteriorAlgebra

def coefficientExteriorLift (i : ℕ) :
    (Set.powersetCard C i →₀ B) →ₗ[K] CoefficientExterior B C :=
  ((coefficientExteriorBasis (B := B) (C := C)).repr.symm.toLinearMap.comp
    (Finsupp.lmapDomain B B Subtype.val)).restrictScalars K

def coefficientExteriorProjection (i : ℕ) :
    CoefficientExterior B C →ₗ[K] (Set.powersetCard C i →₀ B) :=
  ((Finsupp.lsubtypeDomain {F : Finset C | F.card = i}).comp
    (coefficientExteriorBasis (B := B) (C := C)).repr.toLinearMap).restrictScalars K

@[simp] theorem coefficientExteriorLift_single (i : ℕ)
    (F : Set.powersetCard C i) (b : B) :
    coefficientExteriorLift (K := K) i (Finsupp.single F b) =
      b • coefficientExteriorBasis F.val := by
  change (coefficientExteriorBasis (B := B) (C := C)).repr.symm
    ((Finsupp.single F b).mapDomain Subtype.val) = _
  rw [Finsupp.mapDomain_single, Module.Basis.repr_symm_single]

theorem coefficientExteriorLift_coefficient (i : ℕ)
    (x : Set.powersetCard C i →₀ B) (F : Finset C) :
    coefficientExteriorBasis.repr (coefficientExteriorLift (K := K) i x) F =
      if h : F.card = i then x ⟨F, h⟩ else 0 := by
  change coefficientExteriorBasis.repr
    (coefficientExteriorBasis.repr.symm (x.mapDomain Subtype.val)) F = _
  rw [LinearEquiv.apply_symm_apply]
  by_cases hF : F.card = i
  · rw [dif_pos hF]
    exact Finsupp.mapDomain_apply_of_injective Subtype.val_injective x ⟨F, hF⟩
  · rw [dif_neg hF]
    apply Finsupp.mapDomain_of_notMem_range
    rintro ⟨G, rfl⟩
    exact hF G.property

@[simp] theorem coefficientExteriorProjection_apply (i : ℕ)
    (x : CoefficientExterior B C) (F : Set.powersetCard C i) :
    coefficientExteriorProjection (K := K) i x F = coefficientExteriorBasis.repr x F.val := rfl

@[simp] theorem coefficientExteriorProjection_lift (i : ℕ)
    (x : Set.powersetCard C i →₀ B) :
    coefficientExteriorProjection (K := K) i (coefficientExteriorLift (K := K) i x) = x := by
  ext F
  change (coefficientExteriorBasis (B := B) (C := C)).repr
    ((coefficientExteriorBasis (B := B) (C := C)).repr.symm
      (x.mapDomain Subtype.val)) F.val = x F
  rw [LinearEquiv.apply_symm_apply]
  exact Finsupp.mapDomain_apply_of_injective Subtype.val_injective x F

theorem coefficientExteriorLift_injective (i : ℕ) :
    Function.Injective (coefficientExteriorLift (K := K) (B := B) (C := C) i) := by
  intro x y hxy
  have h := congrArg (coefficientExteriorProjection (K := K) i) hxy
  simpa only [coefficientExteriorProjection_lift] using h

@[simp] theorem coefficientExteriorProjection_smul_basis_apply (i : ℕ)
    (F : Finset C) (b : B) (G : Set.powersetCard C i) :
    coefficientExteriorProjection (K := K) i (b • coefficientExteriorBasis F) G =
      if F = G.val then b else 0 := by
  change coefficientExteriorBasis.repr (b • coefficientExteriorBasis F) G.val = _
  rw [map_smul, Module.Basis.repr_self]
  simp [Finsupp.single_apply]

theorem coefficientExteriorProjection_smul_basis_wrong (i : ℕ)
    (F : Finset C) (b : B) (hF : F.card ≠ i) :
    coefficientExteriorProjection (K := K) (B := B) (C := C) i
      (b • coefficientExteriorBasis (B := B) (C := C) F) = 0 := by
  ext G
  rw [coefficientExteriorProjection_smul_basis_apply, Finsupp.zero_apply]
  apply if_neg
  intro h
  exact hF (by rw [h]; exact G.property)

theorem coefficientExterior_linear_ext {N : Type*} [AddCommGroup N] [Module K N]
    (f g : CoefficientExterior B C →ₗ[K] N)
    (h : ∀ (F : Finset C) (b : B),
      f (b • coefficientExteriorBasis F) = g (b • coefficientExteriorBasis F)) : f = g := by
  apply LinearMap.ext
  intro x
  rw [← (coefficientExteriorBasis (B := B) (C := C)).linearCombination_repr x]
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
  apply Finset.sum_congr rfl
  intro F hF
  exact h F _

theorem coefficientExteriorDGA_basis (γ : C → B) (F : Finset C) :
    (coefficientExteriorDGA (K := K) γ).d (coefficientExteriorBasis F) =
      ∑ j : {j // j ∈ F},
        γ j.val • (TauCeti.ExteriorAlgebra.basisEraseSign j.val F •
          coefficientExteriorBasis (F.erase j.val)) := by
  let φ := Fintype.linearCombination B γ
  change contractLeft φ ((Pi.basisFun B C).ExteriorAlgebra F) = _
  conv_lhs => rw [← (Pi.basisFun B C).sum_dual_apply_smul_coord φ]
  rw [map_sum, LinearMap.sum_apply]
  have hs : (∑ j : C, contractLeft (φ ((Pi.basisFun B C) j) •
      (Pi.basisFun B C).coord j) ((Pi.basisFun B C).ExteriorAlgebra F)) =
      ∑ j ∈ F, γ j • (TauCeti.ExteriorAlgebra.basisEraseSign j F •
        coefficientExteriorBasis (F.erase j)) := by
    simp only [map_smul, LinearMap.smul_apply,
      TauCeti.ExteriorAlgebra.contractLeft_coord_basis]
    have hφ : ∀ j, φ ((Pi.basisFun B C) j) = γ j := by
      intro j
      change Fintype.linearCombination B γ ((Pi.basisFun B C) j) = γ j
      rw [Pi.basisFun_apply, Fintype.linearCombination_apply_single, one_smul]
    simp only [hφ, coefficientExteriorBasis, smul_ite, smul_zero]
    exact Finset.sum_ite_mem_eq F _
  rw [hs]
  exact Finset.sum_subtype F (fun _ => Iff.rfl) _

theorem coefficientExteriorDGA_smul_basis (γ : C → B) (F : Finset C) (b : B) :
    (coefficientExteriorDGA (K := K) γ).d (b • coefficientExteriorBasis F) =
      ∑ j : {j // j ∈ F},
        (γ j.val * (TauCeti.ExteriorAlgebra.basisEraseSign j.val F • b)) •
          coefficientExteriorBasis (F.erase j.val) := by
  change contractLeft (Fintype.linearCombination B γ) (b • coefficientExteriorBasis F) = _
  rw [map_smul]
  change b • (coefficientExteriorDGA (K := K) γ).d (coefficientExteriorBasis F) = _
  rw [coefficientExteriorDGA_basis, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  rcases Int.units_eq_one_or (TauCeti.ExteriorAlgebra.basisEraseSign j.val F) with h | h
  · rw [h]
    simp only [one_smul, smul_smul]
    rw [mul_comm b (γ j.val)]
  · rw [h]
    simp only [Units.neg_smul, one_smul, smul_neg, mul_neg, neg_smul, smul_smul]
    rw [mul_comm b (γ j.val)]

theorem coefficientExteriorDGA_lift (γ : C → B) (i : ℕ)
    (x : Set.powersetCard C (i + 1) →₀ B) :
    (coefficientExteriorDGA (K := K) γ).d (coefficientExteriorLift (K := K) (i + 1) x) =
      coefficientExteriorLift (K := K) i (parameterKoszulDifferential (K := K) γ i x) := by
  have h : (coefficientExteriorDGA (K := K) γ).d.comp (coefficientExteriorLift (i + 1)) =
      (coefficientExteriorLift i).comp (parameterKoszulDifferential (K := K) γ i) := by
    apply Finsupp.lhom_ext
    intro F b
    simp only [LinearMap.comp_apply, Finsupp.lsingle_apply,
      coefficientExteriorLift_single, coefficientExteriorDGA_smul_basis,
      parameterKoszulDifferential_single, map_sum]
    apply Finset.sum_congr rfl
    intro j hj
    rfl
  exact LinearMap.congr_fun h x

theorem coefficientExteriorDGA_lift_zero (γ : C → B)
    (x : Set.powersetCard C 0 →₀ B) :
    (coefficientExteriorDGA (K := K) γ).d (coefficientExteriorLift (K := K) 0 x) = 0 := by
  have h : (coefficientExteriorDGA (K := K) γ).d.comp
      (coefficientExteriorLift (K := K) 0) = 0 := by
    apply Finsupp.lhom_ext
    intro F b
    have hF : F.val = ∅ := Finset.card_eq_zero.mp F.property
    simp [coefficientExteriorLift_single, coefficientExteriorDGA_smul_basis, hF]
  exact LinearMap.congr_fun h x

/-- Projection of the actual total differential onto degree `i` is exactly
the standard coordinate differential on the degree `i + 1` projection. -/
theorem coefficientExteriorProjection_differential (γ : C → B) (i : ℕ)
    (x : CoefficientExterior B C) :
    parameterKoszulDifferential (K := K) γ i
        (coefficientExteriorProjection (K := K) (i + 1) x) =
      coefficientExteriorProjection (K := K) i ((coefficientExteriorDGA (K := K) γ).d x) := by
  have h : (parameterKoszulDifferential (K := K) γ i).comp
      (coefficientExteriorProjection (i + 1)) =
      (coefficientExteriorProjection i).comp (coefficientExteriorDGA (K := K) γ).d := by
    apply coefficientExterior_linear_ext
    intro F b
    by_cases hF : F.card = i + 1
    · let s : Set.powersetCard C (i + 1) := ⟨F, hF⟩
      change parameterKoszulDifferential (K := K) γ i
          (coefficientExteriorProjection (K := K) (i + 1)
            (b • coefficientExteriorBasis F)) =
        coefficientExteriorProjection (K := K) i
          ((coefficientExteriorDGA (K := K) γ).d (b • coefficientExteriorBasis F))
      rw [← coefficientExteriorLift_single (K := K) (i + 1) s b,
        coefficientExteriorProjection_lift, coefficientExteriorDGA_lift,
        coefficientExteriorProjection_lift]
    · change parameterKoszulDifferential (K := K) γ i
          (coefficientExteriorProjection (K := K) (i + 1)
            (b • coefficientExteriorBasis F)) =
        coefficientExteriorProjection (K := K) i
          ((coefficientExteriorDGA (K := K) γ).d (b • coefficientExteriorBasis F))
      rw [coefficientExteriorProjection_smul_basis_wrong _ _ _ hF, map_zero,
        coefficientExteriorDGA_smul_basis, map_sum]
      symm
      apply Finset.sum_eq_zero
      intro j hj
      apply coefficientExteriorProjection_smul_basis_wrong
      intro he
      exact hF ((Finset.card_erase_add_one j.property).symm.trans (by rw [he]))
  exact LinearMap.congr_fun h x

abbrev coefficientExteriorOutgoing (γ : C → B) (i : ℕ) :=
  ((parameterKoszulComplex (K := K) γ).d i (i - 1)).hom

theorem coefficientExteriorIncomingOutgoing (γ : C → B) (i : ℕ) :
    (coefficientExteriorOutgoing (K := K) γ i).comp
      (parameterKoszulDifferential (K := K) γ i) = 0 := by
  have h := congrArg (fun f => f.hom)
    ((parameterKoszulComplex (K := K) γ).d_comp_d (i + 1) i (i - 1))
  simpa only [parameterKoszulComplex_d, ModuleCat.hom_comp,
    ModuleCat.hom_ofHom, ModuleCat.hom_zero] using h

theorem coefficientExteriorLift_cycle (γ : C → B) (i : ℕ)
    (x : Set.powersetCard C i →₀ B) (hx : coefficientExteriorOutgoing (K := K) γ i x = 0) :
    (coefficientExteriorDGA (K := K) γ).d (coefficientExteriorLift (K := K) i x) = 0 := by
  cases i with
  | zero => exact coefficientExteriorDGA_lift_zero γ x
  | succ i =>
      have hh : parameterKoszulDifferential (K := K) γ i x = 0 := by
        simp only [coefficientExteriorOutgoing, Nat.succ_sub_one, Nat.add_sub_cancel,
          parameterKoszulComplex_d, ModuleCat.hom_ofHom] at hx
        change parameterKoszulDifferential (K := K) γ i x =
          (0 : Set.powersetCard C i →₀ B) at hx
        exact hx
      rw [coefficientExteriorDGA_lift, hh, map_zero]

/-- This is the actual kernel/image homology of the parameter Koszul complex,
with the degree-zero outgoing map taken from that same chain complex. -/
abbrev CoefficientKoszulHomology (γ : C → B) (i : ℕ) :=
  Homology (parameterKoszulDifferential (K := K) γ i)
    (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i)

def coefficientKoszulHomologyToTotal (γ : C → B) (i : ℕ) :
    CoefficientKoszulHomology (K := K) γ i →ₗ[K] CoefficientExteriorHomology (K := K) γ :=
  (coefficientExteriorDGA (K := K) γ).componentHomologyMap
    (parameterKoszulDifferential (K := K) γ i) (coefficientExteriorOutgoing (K := K) γ i)
    (coefficientExteriorIncomingOutgoing γ i) (coefficientExteriorLift (K := K) i)
    (coefficientExteriorLift_cycle γ i) (coefficientExteriorLift (K := K) (i + 1))
    (coefficientExteriorDGA_lift γ i)

/-- The genuine homological component embeds in the total homology algebra.
The proof uses the actual exterior-degree projections to extract primitives. -/
theorem coefficientKoszulHomologyToTotal_injective (γ : C → B) (i : ℕ) :
    Function.Injective (coefficientKoszulHomologyToTotal (K := K) γ i) :=
  (coefficientExteriorDGA (K := K) γ).componentHomologyMap_injective
    (parameterKoszulDifferential (K := K) γ i) (coefficientExteriorOutgoing (K := K) γ i)
    (coefficientExteriorIncomingOutgoing γ i) (coefficientExteriorLift (K := K) i)
    (coefficientExteriorLift_cycle γ i) (coefficientExteriorLift (K := K) (i + 1))
    (coefficientExteriorDGA_lift γ i) (coefficientExteriorProjection (K := K) i)
    (coefficientExteriorProjection (K := K) (i + 1))
    (coefficientExteriorProjection_lift i) (coefficientExteriorProjection_differential γ i)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.CoefficientExteriorMultiplication -/
section

/-! # Literal exterior products and coefficient filtrations

All products below are the original products of the coefficient exterior
algebra.  Shuffle signs are taken from Mathlib's exterior basis formula.
The filtration places the coefficient of an exterior monomial in the
coefficient-ring level shifted by the sum of its assigned exterior weights.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.Universal

open Classical Finset

universe u v
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

def exteriorShuffleSign (F G : Finset C) (h : Disjoint F G) : ℤˣ :=
  (Set.powersetCard.permOfDisjoint
    (s := (⟨F, rfl⟩ : Set.powersetCard C F.card))
    (t := (⟨G, rfl⟩ : Set.powersetCard C G.card)) h).sign

theorem coefficientExterior_smul_basis_mul (F G : Finset C) (h : Disjoint F G)
    (b c : B) :
    (b • coefficientExteriorBasis (B := B) F) * (c • coefficientExteriorBasis G) =
      exteriorShuffleSign F G h • ((b * c) • coefficientExteriorBasis (F ∪ G)) := by
  have hb : coefficientExteriorBasis (B := B) F * coefficientExteriorBasis G =
      exteriorShuffleSign F G h • coefficientExteriorBasis (F ∪ G) := by
    simpa only [coefficientExteriorBasis, exteriorShuffleSign,
      Set.powersetCard.coe_disjUnion, Finset.disjUnion_eq_union] using
      (ExteriorAlgebra.basis_mul_of_disjoint (Pi.basisFun B C)
        (⟨F, rfl⟩ : Set.powersetCard C F.card)
        (⟨G, rfl⟩ : Set.powersetCard C G.card) h)
  rw [smul_mul_assoc, mul_smul_comm, smul_smul, hb]
  exact smul_comm (b * c) (exteriorShuffleSign F G h) _

theorem coefficientExterior_smul_basis_mul_zero (F G : Finset C)
    (h : ¬Disjoint F G) (b c : B) :
    (b • coefficientExteriorBasis (B := B) F) * (c • coefficientExteriorBasis G) = 0 := by
  have hb : coefficientExteriorBasis (B := B) F * coefficientExteriorBasis G = 0 :=
    ExteriorAlgebra.basis_mul_of_not_disjoint (Pi.basisFun B C)
      (⟨F, rfl⟩ : Set.powersetCard C F.card)
      (⟨G, rfl⟩ : Set.powersetCard C G.card) h
  rw [smul_mul_assoc, mul_smul_comm, smul_smul, hb, smul_zero]

theorem coefficientExterior_bilinear_mem {N : Type*} [AddCommGroup N] [Module K N]
    (f : CoefficientExterior B C →ₗ[K] CoefficientExterior B C →ₗ[K] N)
    (S : Submodule K N) (x y : CoefficientExterior B C)
    (h : ∀ F ∈ (coefficientExteriorBasis.repr x).support,
      ∀ G ∈ (coefficientExteriorBasis.repr y).support,
      f ((coefficientExteriorBasis.repr x F) • coefficientExteriorBasis F)
        ((coefficientExteriorBasis.repr y G) • coefficientExteriorBasis G) ∈ S) :
    f x y ∈ S := by
  rw [← (coefficientExteriorBasis (B := B) (C := C)).linearCombination_repr x,
    ← (coefficientExteriorBasis (B := B) (C := C)).linearCombination_repr y]
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, LinearMap.sum_apply]
  apply Submodule.sum_mem
  intro G hG
  apply Submodule.sum_mem
  intro F hF
  exact h F hF G hG

def coefficientExteriorHomologicalPiece (i : ℕ) : Submodule K (CoefficientExterior B C) :=
  (Finsupp.supported B K {F : Finset C | F.card = i}).comap
    ((coefficientExteriorBasis (B := B) (C := C)).repr.restrictScalars K).toLinearMap

theorem coefficientExteriorHomologicalPiece_mem (i : ℕ) (x : CoefficientExterior B C) :
    x ∈ coefficientExteriorHomologicalPiece (K := K) i ↔
      ∀ F : Finset C, F.card ≠ i → coefficientExteriorBasis.repr x F = 0 := by
  change coefficientExteriorBasis.repr x ∈ Finsupp.supported B K
    {F : Finset C | F.card = i} ↔ _
  rw [Finsupp.mem_supported']
  rfl

theorem coefficientExteriorHomologicalPiece_smul_basis (i : ℕ) (F : Finset C)
    (hF : F.card = i) (b : B) :
    b • coefficientExteriorBasis (B := B) F ∈ coefficientExteriorHomologicalPiece (K := K) i := by
  rw [coefficientExteriorHomologicalPiece_mem]
  intro G hG
  rw [map_smul, Module.Basis.repr_self]
  have hFG : F ≠ G := by intro h; exact hG (h ▸ hF)
  simp [Finsupp.single_apply, hFG]

theorem coefficientExteriorLift_mem (i : ℕ) (x : Set.powersetCard C i →₀ B) :
    coefficientExteriorLift (K := K) i x ∈ coefficientExteriorHomologicalPiece (K := K) i := by
  rw [coefficientExteriorHomologicalPiece_mem]
  intro F hF
  change coefficientExteriorBasis.repr
    (coefficientExteriorBasis.repr.symm (x.mapDomain Subtype.val)) F = 0
  rw [LinearEquiv.apply_symm_apply]
  apply Finsupp.mapDomain_of_notMem_range
  rintro ⟨G, rfl⟩
  exact hF G.property

theorem coefficientExteriorLift_projection (i : ℕ) (x : CoefficientExterior B C)
    (hx : x ∈ coefficientExteriorHomologicalPiece (K := K) i) :
    coefficientExteriorLift (K := K) i (coefficientExteriorProjection (K := K) i x) = x := by
  apply (coefficientExteriorBasis (B := B) (C := C)).repr.injective
  ext F
  change coefficientExteriorBasis.repr
    (coefficientExteriorBasis.repr.symm
      ((coefficientExteriorProjection (K := K) i x).mapDomain Subtype.val)) F = _
  rw [LinearEquiv.apply_symm_apply]
  by_cases hF : F.card = i
  · let G : Set.powersetCard C i := ⟨F, hF⟩
    exact Finsupp.mapDomain_apply_of_injective Subtype.val_injective
      (coefficientExteriorProjection (K := K) i x) G
  · rw [Finsupp.mapDomain_of_notMem_range _ _ (by
      rintro ⟨G, rfl⟩
      exact hF G.property)]
    exact ((coefficientExteriorHomologicalPiece_mem i x).mp hx F hF).symm

theorem coefficientExteriorHomologicalPiece_eq_range (i : ℕ) :
    coefficientExteriorHomologicalPiece (K := K) (B := B) (C := C) i =
      LinearMap.range (coefficientExteriorLift (K := K) i) := by
  ext x
  constructor
  · intro hx
    exact ⟨coefficientExteriorProjection (K := K) i x,
      coefficientExteriorLift_projection i x hx⟩
  · rintro ⟨x, rfl⟩
    exact coefficientExteriorLift_mem i x

/-- Multiplication adds the actual exterior cardinality degrees. -/
theorem coefficientExteriorHomologicalPiece_mul (i j : ℕ)
    (x y : CoefficientExterior B C)
    (hx : x ∈ coefficientExteriorHomologicalPiece (K := K) i)
    (hy : y ∈ coefficientExteriorHomologicalPiece (K := K) j) :
    x * y ∈ coefficientExteriorHomologicalPiece (K := K) (i + j) := by
  apply coefficientExterior_bilinear_mem (LinearMap.mul K (CoefficientExterior B C))
  intro F hF G hG
  simp only [LinearMap.mul_apply']
  have hFi : F.card = i := by
    by_contra h
    exact Finsupp.mem_support_iff.mp hF
      ((coefficientExteriorHomologicalPiece_mem i x).mp hx F h)
  have hGj : G.card = j := by
    by_contra h
    exact Finsupp.mem_support_iff.mp hG
      ((coefficientExteriorHomologicalPiece_mem j y).mp hy G h)
  by_cases hFG : Disjoint F G
  · rw [coefficientExterior_smul_basis_mul F G hFG]
    have hmem := coefficientExteriorHomologicalPiece_smul_basis (K := K) (i + j)
      (F ∪ G) (by rw [Finset.card_union_of_disjoint hFG, hFi, hGj])
      (coefficientExteriorBasis.repr x F * coefficientExteriorBasis.repr y G)
    rcases Int.units_eq_one_or (exteriorShuffleSign F G hFG) with h | h
    · simpa only [h, one_smul] using hmem
    · simpa only [h, Units.neg_smul, one_smul] using Submodule.neg_mem _ hmem
  · rw [coefficientExterior_smul_basis_mul_zero F G hFG]
    exact Submodule.zero_mem _

def exteriorAssignedWeight (w : C → ℤ) (F : Finset C) : ℤ := ∑ j ∈ F, w j

theorem exteriorAssignedWeight_union (w : C → ℤ) (F G : Finset C) (h : Disjoint F G) :
    exteriorAssignedWeight w (F ∪ G) = exteriorAssignedWeight w F + exteriorAssignedWeight w G :=
  Finset.sum_union h

def coefficientExteriorCoefficient (F : Finset C) : CoefficientExterior B C →ₗ[K] B :=
  (coefficientExteriorBasis.coord F).restrictScalars K

@[simp] theorem coefficientExteriorCoefficient_apply (F : Finset C) (x : CoefficientExterior B C) :
    coefficientExteriorCoefficient (K := K) F x = coefficientExteriorBasis.repr x F := rfl

def coefficientExteriorLevel (Q : ℤ → Submodule K B) (w : C → ℤ) (r : ℤ) :
    Submodule K (CoefficientExterior B C) :=
  ⨅ F : Finset C, (Q (r - exteriorAssignedWeight w F)).comap
    (coefficientExteriorCoefficient (K := K) F)

@[simp] theorem coefficientExteriorLevel_mem (Q : ℤ → Submodule K B) (w : C → ℤ)
    (r : ℤ) (x : CoefficientExterior B C) :
    x ∈ coefficientExteriorLevel Q w r ↔
      ∀ F : Finset C, coefficientExteriorBasis.repr x F ∈ Q (r - exteriorAssignedWeight w F) := by
  simp only [coefficientExteriorLevel, Submodule.mem_iInf, Submodule.mem_comap,
    coefficientExteriorCoefficient_apply]

theorem coefficientExteriorLevel_smul_basis (Q : ℤ → Submodule K B) (w : C → ℤ)
    (r : ℤ) (F : Finset C) (b : B) (hb : b ∈ Q (r - exteriorAssignedWeight w F)) :
    b • coefficientExteriorBasis F ∈ coefficientExteriorLevel Q w r := by
  rw [coefficientExteriorLevel_mem]
  intro G
  rw [map_smul, Module.Basis.repr_self]
  by_cases hFG : F = G
  · subst G
    simpa only [Finsupp.smul_apply, Finsupp.single_eq_same, smul_eq_mul, mul_one] using hb
  · simp [Finsupp.single_apply, hFG]

/-- Exterior multiplication preserves the sum of the coefficient weights and
the individually assigned generator weights. This uses the original product. -/
theorem coefficientExteriorLevel_multiplicative
    (Q : ℤ → Submodule K B) (hQ : WeightMultiplicative Q) (w : C → ℤ) :
    WeightMultiplicative (coefficientExteriorLevel Q w) := by
  intro r s x y hx hy
  apply coefficientExterior_bilinear_mem (LinearMap.mul K (CoefficientExterior B C))
  intro F hF G hG
  simp only [LinearMap.mul_apply']
  by_cases hFG : Disjoint F G
  · rw [coefficientExterior_smul_basis_mul F G hFG]
    have hb := (coefficientExteriorLevel_mem Q w (r + 1) x).mp hx F
    have hc := (coefficientExteriorLevel_mem Q w (s + 1) y).mp hy G
    have hbc := hQ (r - exteriorAssignedWeight w F) (s - exteriorAssignedWeight w G)
      _ _ (by convert hb using 1 <;> congr 1 <;> omega)
      (by convert hc using 1 <;> congr 1 <;> omega)
    have hmem : (coefficientExteriorBasis.repr x F * coefficientExteriorBasis.repr y G) •
        coefficientExteriorBasis (F ∪ G) ∈ coefficientExteriorLevel Q w (r + s + 1) := by
      apply coefficientExteriorLevel_smul_basis
      rw [exteriorAssignedWeight_union w F G hFG]
      convert hbc using 1 <;> congr 1 <;> omega
    rcases Int.units_eq_one_or (exteriorShuffleSign F G hFG) with h | h
    · simpa only [h, one_smul] using hmem
    · simpa only [h, Units.neg_smul, one_smul] using Submodule.neg_mem _ hmem
  · rw [coefficientExterior_smul_basis_mul_zero F G hFG]
    exact Submodule.zero_mem _

/-- The same literal coefficient construction gives exact graded pieces when
the coefficient pieces multiply in exact degrees. -/
theorem coefficientExteriorLevel_graded_mul (Q : ℤ → Submodule K B)
    (hQ : ∀ r s x y, x ∈ Q r → y ∈ Q s → x * y ∈ Q (r + s))
    (w : C → ℤ) (r s : ℤ) (x y : CoefficientExterior B C)
    (hx : x ∈ coefficientExteriorLevel Q w r) (hy : y ∈ coefficientExteriorLevel Q w s) :
    x * y ∈ coefficientExteriorLevel Q w (r + s) := by
  apply coefficientExterior_bilinear_mem (LinearMap.mul K (CoefficientExterior B C))
  intro F hF G hG
  simp only [LinearMap.mul_apply']
  by_cases hFG : Disjoint F G
  · rw [coefficientExterior_smul_basis_mul F G hFG]
    have hbc := hQ (r - exteriorAssignedWeight w F) (s - exteriorAssignedWeight w G) _ _
      ((coefficientExteriorLevel_mem Q w r x).mp hx F)
      ((coefficientExteriorLevel_mem Q w s y).mp hy G)
    have hmem : (coefficientExteriorBasis.repr x F * coefficientExteriorBasis.repr y G) •
        coefficientExteriorBasis (F ∪ G) ∈ coefficientExteriorLevel Q w (r + s) := by
      apply coefficientExteriorLevel_smul_basis
      rw [exteriorAssignedWeight_union w F G hFG]
      convert hbc using 1 <;> congr 1 <;> omega
    rcases Int.units_eq_one_or (exteriorShuffleSign F G hFG) with h | h
    · simpa only [h, one_smul] using hmem
    · simpa only [h, Units.neg_smul, one_smul] using Submodule.neg_mem _ hmem
  · rw [coefficientExterior_smul_basis_mul_zero F G hFG]
    exact Submodule.zero_mem _

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.CoefficientExteriorComparison -/
section

/-! # Canonical leading multiplication in the actual coefficient exterior algebras

A coefficient-linear map acts on the actual exterior coefficients.  Its
multiplicative defect has the same strictly lower weight as the coefficient
defect, because both sides use precisely the same exterior shuffle sign.
This proves multiplicativity on the literal associated-grade quotients.
-/
noncomputable section
set_option autoImplicit false

namespace FourPapers.Universal

open Classical Finset

universe u v
section ParameterGenerality
variable {K B B' : Type u} {C : Type} [CommRing K] [CommRing B] [CommRing B']
  [Algebra K B] [Algebra K B'] [Fintype C] [LinearOrder C]

def coefficientExteriorMap (f : B →ₗ[K] B') :
    CoefficientExterior B C →ₗ[K] CoefficientExterior B' C :=
  ((coefficientExteriorBasis (B := B') (C := C)).repr.symm.restrictScalars K).toLinearMap.comp
    ((Finsupp.mapRange.linearMap f).comp
      ((coefficientExteriorBasis (B := B) (C := C)).repr.restrictScalars K).toLinearMap)

@[simp] theorem coefficientExteriorMap_coefficient (f : B →ₗ[K] B')
    (x : CoefficientExterior B C) (F : Finset C) :
    coefficientExteriorBasis.repr (coefficientExteriorMap (C := C) f x) F =
      f (coefficientExteriorBasis.repr x F) := by
  change coefficientExteriorBasis.repr (coefficientExteriorBasis.repr.symm
    (Finsupp.mapRange.linearMap f (coefficientExteriorBasis.repr x))) F = _
  rw [LinearEquiv.apply_symm_apply]
  rfl

@[simp] theorem coefficientExteriorMap_smul_basis (f : B →ₗ[K] B')
    (F : Finset C) (b : B) :
    coefficientExteriorMap f (b • coefficientExteriorBasis F) =
      f b • coefficientExteriorBasis F := by
  apply (coefficientExteriorBasis (B := B') (C := C)).repr.injective
  ext G
  rw [coefficientExteriorMap_coefficient, map_smul, map_smul,
    Module.Basis.repr_self, Module.Basis.repr_self]
  by_cases h : F = G <;> simp [Finsupp.single_apply, h]

theorem coefficientExteriorMap_lift (f : B →ₗ[K] B') (i : ℕ)
    (x : Set.powersetCard C i →₀ B) :
    coefficientExteriorMap (C := C) f (coefficientExteriorLift (K := K) i x) =
      coefficientExteriorLift (K := K) i (Finsupp.mapRange.linearMap f x) := by
  have h : (coefficientExteriorMap (C := C) f).comp (coefficientExteriorLift (K := K) i) =
      (coefficientExteriorLift (K := K) i).comp (Finsupp.mapRange.linearMap f) := by
    apply Finsupp.lhom_ext
    intro F b
    simp only [LinearMap.comp_apply, Finsupp.lsingle_apply, coefficientExteriorLift_single,
      coefficientExteriorMap_smul_basis, Finsupp.mapRange.linearMap_apply,
      Finsupp.mapRange_single]
  exact LinearMap.congr_fun h x

def coefficientExteriorEquiv (e : B ≃ₗ[K] B') :
    CoefficientExterior B C ≃ₗ[K] CoefficientExterior B' C :=
  ((coefficientExteriorBasis (B := B) (C := C)).repr.restrictScalars K).trans
    ((Finsupp.mapRange.linearEquiv e).trans
      ((coefficientExteriorBasis (B := B') (C := C)).repr.symm.restrictScalars K))

@[simp] theorem coefficientExteriorEquiv_apply (e : B ≃ₗ[K] B')
    (x : CoefficientExterior B C) :
    coefficientExteriorEquiv (C := C) e x = coefficientExteriorMap e.toLinearMap x := rfl

theorem coefficientExteriorEquiv_filtered (e : B ≃ₗ[K] B')
    (Q : ℤ → Submodule K B) (Q' : ℤ → Submodule K B')
    (he : ∀ r x, e x ∈ Q' r ↔ x ∈ Q r) (w : C → ℤ)
    (r : ℤ) (x : CoefficientExterior B C) :
    coefficientExteriorEquiv (C := C) e x ∈ coefficientExteriorLevel Q' w r ↔
      x ∈ coefficientExteriorLevel Q w r := by
  simp only [coefficientExteriorLevel_mem, coefficientExteriorEquiv_apply,
    coefficientExteriorMap_coefficient, LinearEquiv.coe_coe, he]

theorem coefficientExteriorMap_basis_product_defect (f : B →ₗ[K] B')
    (F G : Finset C) (h : Disjoint F G) (b c : B) :
    coefficientExteriorMap f ((b • coefficientExteriorBasis F) *
        (c • coefficientExteriorBasis G)) -
      coefficientExteriorMap f (b • coefficientExteriorBasis F) *
        coefficientExteriorMap f (c • coefficientExteriorBasis G) =
      exteriorShuffleSign F G h •
        ((f (b * c) - f b * f c) • coefficientExteriorBasis (F ∪ G)) := by
  rw [coefficientExterior_smul_basis_mul F G h, map_zsmul_unit,
    coefficientExteriorMap_smul_basis, coefficientExteriorMap_smul_basis,
    coefficientExteriorMap_smul_basis, coefficientExterior_smul_basis_mul F G h,
    ← smul_sub, ← sub_smul]

def coefficientExteriorProductDefect (f : B →ₗ[K] B') :
    CoefficientExterior B C →ₗ[K] CoefficientExterior B C →ₗ[K] CoefficientExterior B' C :=
  (LinearMap.mul K (CoefficientExterior B C)).compr₂ (coefficientExteriorMap f) -
    (LinearMap.mul K (CoefficientExterior B' C)).compl₁₂
      (coefficientExteriorMap f) (coefficientExteriorMap f)

/-- Strictly lower coefficient defects give strictly lower defects for the
actual exterior product, with its original signs and shifted weights. -/
theorem coefficientExteriorMap_product_lower (f : B →ₗ[K] B')
    (Q : ℤ → Submodule K B) (Q' : ℤ → Submodule K B')
    (hdefect : ∀ r s b c, b ∈ Q (r + 1) → c ∈ Q (s + 1) →
      f (b * c) - f b * f c ∈ Q' (r + s))
    (w : C → ℤ) (r s : ℤ) (x y : CoefficientExterior B C)
    (hx : x ∈ coefficientExteriorLevel Q w (r + 1))
    (hy : y ∈ coefficientExteriorLevel Q w (s + 1)) :
    coefficientExteriorMap f (x * y) - coefficientExteriorMap f x * coefficientExteriorMap f y ∈
      coefficientExteriorLevel Q' w (r + s) := by
  change coefficientExteriorProductDefect f x y ∈ _
  apply coefficientExterior_bilinear_mem
  intro F hF G hG
  change coefficientExteriorMap f
      ((coefficientExteriorBasis.repr x F • coefficientExteriorBasis F) *
        (coefficientExteriorBasis.repr y G • coefficientExteriorBasis G)) -
    coefficientExteriorMap f (coefficientExteriorBasis.repr x F • coefficientExteriorBasis F) *
      coefficientExteriorMap f (coefficientExteriorBasis.repr y G • coefficientExteriorBasis G) ∈ _
  by_cases hFG : Disjoint F G
  · rw [coefficientExteriorMap_basis_product_defect f F G hFG]
    have hb := (coefficientExteriorLevel_mem Q w (r + 1) x).mp hx F
    have hc := (coefficientExteriorLevel_mem Q w (s + 1) y).mp hy G
    have hbc := hdefect (r - exteriorAssignedWeight w F) (s - exteriorAssignedWeight w G) _ _
      (by convert hb using 1 <;> congr 1 <;> omega)
      (by convert hc using 1 <;> congr 1 <;> omega)
    have hmem :
        (f (coefficientExteriorBasis.repr x F * coefficientExteriorBasis.repr y G) -
          f (coefficientExteriorBasis.repr x F) * f (coefficientExteriorBasis.repr y G)) •
          coefficientExteriorBasis (F ∪ G) ∈ coefficientExteriorLevel Q' w (r + s) := by
      apply coefficientExteriorLevel_smul_basis
      rw [exteriorAssignedWeight_union w F G hFG]
      convert hbc using 1 <;> congr 1 <;> omega
    rcases Int.units_eq_one_or (exteriorShuffleSign F G hFG) with h | h
    · simpa only [h, one_smul] using hmem
    · simpa only [h, Units.neg_smul, one_smul] using Submodule.neg_mem _ hmem
  · rw [coefficientExterior_smul_basis_mul_zero F G hFG, map_zero,
      coefficientExteriorMap_smul_basis, coefficientExteriorMap_smul_basis,
      coefficientExterior_smul_basis_mul_zero F G hFG, sub_self]
    exact Submodule.zero_mem _

section GradeQuotients

variable {A A' : Type*} [Ring A] [Ring A'] [Algebra K A] [Algebra K A']

/-- Multiplicativity is proved on the quotients of the original products;
it is not used to define a product transported along an equivalence. -/
theorem weightFiltrationGradeEquiv_multiplicative
    (Q : ℤ → Submodule K A) (Q' : ℤ → Submodule K A')
    (hQ : WeightMultiplicative Q) (hQ' : WeightMultiplicative Q')
    (e : A ≃ₗ[K] A') (he : ∀ r x, e x ∈ Q' r ↔ x ∈ Q r)
    (hdefect : ∀ r s x y, x ∈ Q (r + 1) → y ∈ Q (s + 1) →
      e (x * y) - e x * e y ∈ Q' (r + s))
    (r s : ℤ) (x : weightFiltrationGrade Q r) (y : weightFiltrationGrade Q s) :
    weightFiltrationGradeEquiv Q Q' e he (r + s) (weightGradeProduct Q hQ r s x y) =
      weightGradeProduct Q' hQ' r s
        (weightFiltrationGradeEquiv Q Q' e he r x)
        (weightFiltrationGradeEquiv Q Q' e he s y) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  change Submodule.Quotient.mk (⟨e (x.val * y.val), _⟩ : Q' (r + s + 1)) =
    Submodule.Quotient.mk ⟨e x.val * e y.val, _⟩
  apply (Submodule.Quotient.eq _).mpr
  exact hdefect r s x.val y.val x.property y.property

end GradeQuotients

end ParameterGenerality

section Poset

variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

def canonicalOriginalExteriorComparison :
    CoefficientExterior (BarycentricRing (P := P) K) (Fin d) ≃ₗ[K]
      CoefficientExterior (FaceRing K hs) (Fin d) :=
  coefficientExteriorEquiv (canonicalOriginalComparison K hs)

theorem canonicalOriginalExteriorComparison_lift (i : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    canonicalOriginalExteriorComparison K hs d (coefficientExteriorLift (K := K) i x) =
      coefficientExteriorLift (K := K) i (canonicalKoszulCoefficientEquiv K hs d i x) :=
  coefficientExteriorMap_lift (canonicalOriginalComparison K hs).toLinearMap i x

theorem canonicalOriginalExteriorComparison_filtered (r : ℤ)
    (x : CoefficientExterior (BarycentricRing (P := P) K) (Fin d)) :
    canonicalOriginalExteriorComparison K hs d x ∈
        coefficientExteriorLevel (originalFaceWeightLevel K hs d)
          (fun j : Fin d => rankWeight d (j.val + 1)) r ↔
      x ∈ coefficientExteriorLevel (originalBarycentricWeightLevel K d)
        (fun j : Fin d => rankWeight d (j.val + 1)) r :=
  coefficientExteriorEquiv_filtered (canonicalOriginalComparison K hs)
    (originalBarycentricWeightLevel K d) (originalFaceWeightLevel K hs d)
    (canonicalOriginalComparison_filtered K hs d) _ r x

theorem canonicalOriginalExteriorComparison_product_lower (r s : ℤ)
    (x y : CoefficientExterior (BarycentricRing (P := P) K) (Fin d))
    (hx : x ∈ coefficientExteriorLevel (originalBarycentricWeightLevel K d)
      (fun j : Fin d => rankWeight d (j.val + 1)) (r + 1))
    (hy : y ∈ coefficientExteriorLevel (originalBarycentricWeightLevel K d)
      (fun j : Fin d => rankWeight d (j.val + 1)) (s + 1)) :
    canonicalOriginalExteriorComparison K hs d (x * y) -
        canonicalOriginalExteriorComparison K hs d x *
          canonicalOriginalExteriorComparison K hs d y ∈
      coefficientExteriorLevel (originalFaceWeightLevel K hs d)
        (fun j : Fin d => rankWeight d (j.val + 1)) (r + s) := by
  apply coefficientExteriorMap_product_lower
    (canonicalOriginalComparison K hs).toLinearMap
    (originalBarycentricWeightLevel K d) (originalFaceWeightLevel K hs d)
    _ _ r s x y hx hy
  intro r s b c hb hc
  have hh := canonicalOriginalComparison_product_lower K hs d r s b c
    (by rwa [usualBarycentricWeightLevel_eq]) (by rwa [usualBarycentricWeightLevel_eq])
  rwa [usualFaceWeightLevel_eq] at hh

/-- The canonical associated-graded Koszul coefficient comparison respects
literal exterior multiplication in every pair of integer weight degrees. -/
theorem canonicalOriginalExteriorGrade_multiplicative (r s : ℤ)
    (x : weightFiltrationGrade
      (coefficientExteriorLevel (originalBarycentricWeightLevel (P := P) K d)
        (fun j : Fin d => rankWeight d (j.val + 1))) r)
    (y : weightFiltrationGrade
      (coefficientExteriorLevel (originalBarycentricWeightLevel (P := P) K d)
        (fun j : Fin d => rankWeight d (j.val + 1))) s) :
    let Q := coefficientExteriorLevel (originalBarycentricWeightLevel (P := P) K d)
      (fun j : Fin d => rankWeight d (j.val + 1))
    let Q' := coefficientExteriorLevel (originalFaceWeightLevel K hs d)
      (fun j : Fin d => rankWeight d (j.val + 1))
    let hQ := coefficientExteriorLevel_multiplicative _ (originalBarycentricWeight_multiplicative K d) _
    let hQ' := coefficientExteriorLevel_multiplicative _ (originalFaceWeight_multiplicative K hs d) _
    weightFiltrationGradeEquiv Q Q' (canonicalOriginalExteriorComparison K hs d)
        (canonicalOriginalExteriorComparison_filtered K hs d) (r + s)
        (weightGradeProduct Q hQ r s x y) =
      weightGradeProduct Q' hQ' r s
        (weightFiltrationGradeEquiv Q Q' (canonicalOriginalExteriorComparison K hs d)
          (canonicalOriginalExteriorComparison_filtered K hs d) r x)
        (weightFiltrationGradeEquiv Q Q' (canonicalOriginalExteriorComparison K hs d)
          (canonicalOriginalExteriorComparison_filtered K hs d) s y) := by
  exact weightFiltrationGradeEquiv_multiplicative _ _ _ _
    (canonicalOriginalExteriorComparison K hs d)
    (canonicalOriginalExteriorComparison_filtered K hs d)
    (canonicalOriginalExteriorComparison_product_lower K hs d) r s x y

end Poset
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.CoefficientKoszulProduct -/
section

/-! # The exterior product on the actual coordinate Koszul homology

The chain product is the original exterior product followed by its homogeneous
coordinate projection.  Its lift is proved equal to that original product.
The homology product is then induced through the two ordinary quotient maps.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.Universal

open Classical Finset CategoryTheory
open FourPapers.FilteredHomology

universe u v
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

def coefficientKoszulProduct (i j : ℕ) :
    (Set.powersetCard C i →₀ B) →ₗ[K] (Set.powersetCard C j →₀ B) →ₗ[K]
      (Set.powersetCard C (i + j) →₀ B) :=
  ((LinearMap.mul K (CoefficientExterior B C)).compl₁₂
    (coefficientExteriorLift (K := K) i) (coefficientExteriorLift (K := K) j)).compr₂
      (coefficientExteriorProjection (K := K) (i + j))

theorem coefficientKoszulProduct_lift (i j : ℕ)
    (x : Set.powersetCard C i →₀ B) (y : Set.powersetCard C j →₀ B) :
    coefficientExteriorLift (K := K) (i + j) (coefficientKoszulProduct (K := K) i j x y) =
      coefficientExteriorLift (K := K) i x * coefficientExteriorLift (K := K) j y :=
  coefficientExteriorLift_projection (i + j) _
    (coefficientExteriorHomologicalPiece_mul i j _ _
      (coefficientExteriorLift_mem i x) (coefficientExteriorLift_mem j y))

theorem coefficientExteriorLift_cycle_iff (γ : C → B) (i : ℕ)
    (x : Set.powersetCard C i →₀ B) :
    (coefficientExteriorDGA (K := K) γ).d (coefficientExteriorLift (K := K) i x) = 0 ↔
      coefficientExteriorOutgoing (K := K) γ i x = 0 := by
  constructor
  · intro hx
    cases i with
    | zero =>
        have hz := (parameterKoszulComplex (K := K) γ).shape 0 0 (by decide)
        simp only [coefficientExteriorOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero,
          LinearMap.zero_apply]
    | succ i =>
        change ((parameterKoszulComplex (K := K) γ).d (i + 1) i).hom x = 0
        rw [parameterKoszulComplex_d]
        change parameterKoszulDifferential (K := K) γ i x = 0
        apply coefficientExteriorLift_injective (K := K) i
        simpa only [coefficientExteriorDGA_lift, map_zero] using hx
  · exact coefficientExteriorLift_cycle γ i x

theorem coefficientKoszulProduct_cycle (γ : C → B) (i j : ℕ)
    (x : Set.powersetCard C i →₀ B) (y : Set.powersetCard C j →₀ B)
    (hx : coefficientExteriorOutgoing (K := K) γ i x = 0)
    (hy : coefficientExteriorOutgoing (K := K) γ j y = 0) :
    coefficientExteriorOutgoing (K := K) γ (i + j) (coefficientKoszulProduct (K := K) i j x y) = 0 := by
  apply (coefficientExteriorLift_cycle_iff γ (i + j) _).mp
  rw [coefficientKoszulProduct_lift, (coefficientExteriorDGA (K := K) γ).leibniz,
    coefficientExteriorLift_cycle γ i x hx, coefficientExteriorLift_cycle γ j y hy,
    zero_mul, mul_zero, add_zero]

def coefficientKoszulCycleProduct (γ : C → B) (i j : ℕ) :
    LinearMap.ker (coefficientExteriorOutgoing (K := K) γ i) →ₗ[K]
      LinearMap.ker (coefficientExteriorOutgoing (K := K) γ j) →ₗ[K]
        LinearMap.ker (coefficientExteriorOutgoing (K := K) γ (i + j)) where
  toFun x :=
    { toFun := fun y => ⟨coefficientKoszulProduct (K := K) i j x.val y.val,
        coefficientKoszulProduct_cycle γ i j x.val y.val x.property y.property⟩
      map_add' y z := Subtype.ext (map_add (coefficientKoszulProduct (K := K) i j x.val) y.val z.val)
      map_smul' c y := Subtype.ext (map_smul (coefficientKoszulProduct (K := K) i j x.val) c y.val) }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_add (coefficientKoszulProduct (K := K) i j) x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_smul (coefficientKoszulProduct (K := K) i j) c x.val) y.val

def coefficientKoszulCycleProductClass (γ : C → B) (i j : ℕ) :
    LinearMap.ker (coefficientExteriorOutgoing (K := K) γ i) →ₗ[K]
      LinearMap.ker (coefficientExteriorOutgoing (K := K) γ j) →ₗ[K]
        CoefficientKoszulHomology (K := K) γ (i + j) :=
  (coefficientKoszulCycleProduct (K := K) γ i j).compr₂
    (homologyClass (parameterKoszulDifferential (K := K) γ (i + j))
      (coefficientExteriorOutgoing (K := K) γ (i + j))
      (coefficientExteriorIncomingOutgoing γ (i + j)))

@[simp] theorem coefficientKoszulHomologyToTotal_class (γ : C → B) (i : ℕ)
    (x : LinearMap.ker (coefficientExteriorOutgoing (K := K) γ i)) :
    coefficientKoszulHomologyToTotal (K := K) γ i
        (homologyClass (parameterKoszulDifferential (K := K) γ i)
          (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i) x) =
      (coefficientExteriorDGA (K := K) γ).classMap
        ⟨coefficientExteriorLift (K := K) i x.val,
          coefficientExteriorLift_cycle γ i x.val x.property⟩ := rfl

theorem coefficientKoszulCycleProductClass_toTotal (γ : C → B) (i j : ℕ)
    (x : LinearMap.ker (coefficientExteriorOutgoing (K := K) γ i))
    (y : LinearMap.ker (coefficientExteriorOutgoing (K := K) γ j)) :
    coefficientKoszulHomologyToTotal (K := K) γ (i + j)
        (coefficientKoszulCycleProductClass (K := K) γ i j x y) =
      coefficientKoszulHomologyToTotal (K := K) γ i
          (homologyClass (parameterKoszulDifferential (K := K) γ i)
            (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i) x) *
        coefficientKoszulHomologyToTotal (K := K) γ j
          (homologyClass (parameterKoszulDifferential (K := K) γ j)
            (coefficientExteriorOutgoing (K := K) γ j) (coefficientExteriorIncomingOutgoing γ j) y) := by
  change (coefficientExteriorDGA (K := K) γ).classMap
      ⟨coefficientExteriorLift (K := K) (i + j) (coefficientKoszulProduct (K := K) i j x.val y.val), _⟩ =
    (coefficientExteriorDGA (K := K) γ).classMap
      ⟨coefficientExteriorLift (K := K) i x.val, _⟩ *
      (coefficientExteriorDGA (K := K) γ).classMap
        ⟨coefficientExteriorLift (K := K) j y.val, _⟩
  rw [← map_mul]
  congr 1
  apply Subtype.ext
  exact coefficientKoszulProduct_lift i j x.val y.val

theorem coefficientKoszulCycleProductClass_left_boundary (γ : C → B) (i j : ℕ) :
    LinearMap.range (boundaryMap (parameterKoszulDifferential (K := K) γ i)
      (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i)) ≤
      LinearMap.ker (coefficientKoszulCycleProductClass (K := K) γ i j) := by
  rintro x ⟨a, rfl⟩
  apply LinearMap.ext
  intro y
  apply coefficientKoszulHomologyToTotal_injective (K := K) γ (i + j)
  simp only [LinearMap.zero_apply, LinearMap.flip_apply]
  rw [map_zero, coefficientKoszulCycleProductClass_toTotal]
  have hz : homologyClass (parameterKoszulDifferential (K := K) γ i)
      (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i)
      (boundaryMap (parameterKoszulDifferential (K := K) γ i)
        (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i) a) = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact ⟨a, rfl⟩
  rw [hz, map_zero, zero_mul]

theorem coefficientKoszulCycleProductClass_right_boundary (γ : C → B) (i j : ℕ) :
    LinearMap.range (boundaryMap (parameterKoszulDifferential (K := K) γ j)
      (coefficientExteriorOutgoing (K := K) γ j) (coefficientExteriorIncomingOutgoing γ j)) ≤
      LinearMap.ker (coefficientKoszulCycleProductClass (K := K) γ i j).flip := by
  rintro y ⟨a, rfl⟩
  apply LinearMap.ext
  intro x
  apply coefficientKoszulHomologyToTotal_injective (K := K) γ (i + j)
  simp only [LinearMap.zero_apply, LinearMap.flip_apply]
  rw [map_zero, coefficientKoszulCycleProductClass_toTotal]
  have hz : homologyClass (parameterKoszulDifferential (K := K) γ j)
      (coefficientExteriorOutgoing (K := K) γ j) (coefficientExteriorIncomingOutgoing γ j)
      (boundaryMap (parameterKoszulDifferential (K := K) γ j)
        (coefficientExteriorOutgoing (K := K) γ j) (coefficientExteriorIncomingOutgoing γ j) a) = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact ⟨a, rfl⟩
  rw [hz, map_zero, mul_zero]

/-- The ordinary Koszul homology product, induced from the actual coefficient
exterior DGA through the two source quotient maps. -/
def coefficientKoszulHomologyProduct (γ : C → B) (i j : ℕ) :
    CoefficientKoszulHomology (K := K) γ i →ₗ[K]
      CoefficientKoszulHomology (K := K) γ j →ₗ[K]
        CoefficientKoszulHomology (K := K) γ (i + j) :=
  (coefficientKoszulCycleProductClass (K := K) γ i j).liftQ₂ _ _
    (coefficientKoszulCycleProductClass_left_boundary γ i j)
    (coefficientKoszulCycleProductClass_right_boundary γ i j)

@[simp] theorem coefficientKoszulHomologyProduct_class (γ : C → B) (i j : ℕ)
    (x : LinearMap.ker (coefficientExteriorOutgoing (K := K) γ i))
    (y : LinearMap.ker (coefficientExteriorOutgoing (K := K) γ j)) :
    coefficientKoszulHomologyProduct (K := K) γ i j
        (homologyClass (parameterKoszulDifferential (K := K) γ i)
          (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i) x)
        (homologyClass (parameterKoszulDifferential (K := K) γ j)
          (coefficientExteriorOutgoing (K := K) γ j) (coefficientExteriorIncomingOutgoing γ j) y) =
      coefficientKoszulCycleProductClass (K := K) γ i j x y := rfl

theorem coefficientKoszulHomologyProduct_toTotal (γ : C → B) (i j : ℕ)
    (x : CoefficientKoszulHomology (K := K) γ i) (y : CoefficientKoszulHomology (K := K) γ j) :
    coefficientKoszulHomologyToTotal (K := K) γ (i + j)
        (coefficientKoszulHomologyProduct (K := K) γ i j x y) =
      coefficientKoszulHomologyToTotal (K := K) γ i x *
        coefficientKoszulHomologyToTotal (K := K) γ j y := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  exact coefficientKoszulCycleProductClass_toTotal γ i j x y

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.CoordinateExteriorFiltration -/
section

/-! # Identification with the paper's existing Koszul weight filtration

The exterior-coordinate filtration below is proved equal to the existing
chain-monomial basis filtration, with the exact quadratic rank weights.
No filtration is redefined to make the multiplication theorem hold.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.Universal

open Classical Finset FourPapers.FilteredHomology

universe u v
section ParameterGenerality
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

def coefficientKoszulLevel (Q : ℤ → Submodule K B) (w : C → ℤ) (i : ℕ) (r : ℤ) :
    Submodule K (Set.powersetCard C i →₀ B) :=
  ⨅ F : Set.powersetCard C i, (Q (r - exteriorAssignedWeight w F.val)).comap (Finsupp.lapply F)

@[simp] theorem coefficientKoszulLevel_mem (Q : ℤ → Submodule K B) (w : C → ℤ)
    (i : ℕ) (r : ℤ) (x : Set.powersetCard C i →₀ B) :
    x ∈ coefficientKoszulLevel Q w i r ↔
      ∀ F : Set.powersetCard C i, x F ∈ Q (r - exteriorAssignedWeight w F.val) := by
  simp only [coefficientKoszulLevel, Submodule.mem_iInf, Submodule.mem_comap,
    Finsupp.lapply_apply]

theorem coefficientExteriorLift_level_iff (Q : ℤ → Submodule K B) (w : C → ℤ)
    (i : ℕ) (r : ℤ) (x : Set.powersetCard C i →₀ B) :
    coefficientExteriorLift (K := K) i x ∈ coefficientExteriorLevel Q w r ↔
      x ∈ coefficientKoszulLevel Q w i r := by
  rw [coefficientExteriorLevel_mem, coefficientKoszulLevel_mem]
  constructor
  · intro hx F
    have hh := hx F.val
    rw [coefficientExteriorLift_coefficient] at hh
    have hF : F.val.card = i := F.property
    simpa only [dif_pos hF] using hh
  · intro hx F
    rw [coefficientExteriorLift_coefficient]
    split_ifs with hF
    · exact hx ⟨F, hF⟩
    · exact Submodule.zero_mem _

theorem coefficientExteriorProjection_level (Q : ℤ → Submodule K B) (w : C → ℤ)
    (i : ℕ) (r : ℤ) (x : CoefficientExterior B C)
    (hx : x ∈ coefficientExteriorLevel Q w r) :
    coefficientExteriorProjection (K := K) i x ∈ coefficientKoszulLevel Q w i r := by
  rw [coefficientKoszulLevel_mem]
  intro F
  exact (coefficientExteriorLevel_mem Q w r x).mp hx F.val

theorem coefficientKoszulProduct_preserves_weight (Q : ℤ → Submodule K B)
    (hQ : WeightMultiplicative Q) (w : C → ℤ) (i j : ℕ) (r s : ℤ)
    (x : Set.powersetCard C i →₀ B) (y : Set.powersetCard C j →₀ B)
    (hx : x ∈ coefficientKoszulLevel Q w i (r + 1))
    (hy : y ∈ coefficientKoszulLevel Q w j (s + 1)) :
    coefficientKoszulProduct (K := K) i j x y ∈ coefficientKoszulLevel Q w (i + j) (r + s + 1) := by
  apply (coefficientExteriorLift_level_iff Q w (i + j) (r + s + 1) _).mp
  rw [coefficientKoszulProduct_lift]
  exact coefficientExteriorLevel_multiplicative Q hQ w r s _ _
    ((coefficientExteriorLift_level_iff Q w i (r + 1) x).mpr hx)
    ((coefficientExteriorLift_level_iff Q w j (s + 1) y).mpr hy)

theorem coefficientKoszulProduct_preserves_exact_degree (Q : ℤ → Submodule K B)
    (hQ : ∀ r s x y, x ∈ Q r → y ∈ Q s → x * y ∈ Q (r + s))
    (w : C → ℤ) (i j : ℕ) (r s : ℤ)
    (x : Set.powersetCard C i →₀ B) (y : Set.powersetCard C j →₀ B)
    (hx : x ∈ coefficientKoszulLevel Q w i r)
    (hy : y ∈ coefficientKoszulLevel Q w j s) :
    coefficientKoszulProduct (K := K) i j x y ∈ coefficientKoszulLevel Q w (i + j) (r + s) := by
  apply (coefficientExteriorLift_level_iff Q w (i + j) (r + s) _).mp
  rw [coefficientKoszulProduct_lift]
  exact coefficientExteriorLevel_graded_mul Q hQ w r s _ _
    ((coefficientExteriorLift_level_iff Q w i r x).mpr hx)
    ((coefficientExteriorLift_level_iff Q w j s y).mpr hy)

theorem coefficientKoszulLevel_eq_basisWeightLevel {I : Type*}
    (b : Module.Basis I K B) (v : I → ℤ) (w : C → ℤ) (i : ℕ) (r : ℤ) :
    coefficientKoszulLevel (basisWeightLevel b v) w i r =
      basisWeightLevel (Finsupp.basis (fun _ : Set.powersetCard C i => b))
        (fun a => v a.2 + exteriorAssignedWeight w a.1.val) r := by
  ext x
  rw [coefficientKoszulLevel_mem]
  constructor
  · intro hx a ha
    rcases a with ⟨F, a⟩
    have hh := hx F a (by dsimp at ha; omega)
    simpa only [Finsupp.basis_repr] using hh
  · intro hx F a ha
    have hh := hx ⟨F, a⟩ (by dsimp; omega)
    simpa only [Finsupp.basis_repr] using hh

end ParameterGenerality

section Poset

variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

theorem originalKoszulCoefficientLevel_eq (i : ℕ) (r : ℤ) :
    coefficientKoszulLevel (originalFaceWeightLevel K hs d)
        (fun j : Fin d => rankWeight d (j.val + 1)) i r =
      basisWeightLevel (originalKoszulBasis K hs d i) (originalKoszulWeight d) r := by
  change coefficientKoszulLevel (basisWeightLevel (standardFaceBasis K hs)
    (standardRankWeight d)) (fun j : Fin d => rankWeight d (j.val + 1)) i r = _
  rw [coefficientKoszulLevel_eq_basisWeightLevel]
  rfl

theorem barycentricKoszulCoefficientLevel_eq (i : ℕ) (r : ℤ) :
    coefficientKoszulLevel (originalBarycentricWeightLevel (P := P) K d)
        (fun j : Fin d => rankWeight d (j.val + 1)) i r =
      basisWeightLevel (barycentricKoszulBasis (P := P) K d i) (originalKoszulWeight d) r := by
  change coefficientKoszulLevel (basisWeightLevel (barycentricGlobalStandardBasis (P := P) K)
    (standardRankWeight d)) (fun j : Fin d => rankWeight d (j.val + 1)) i r = _
  rw [coefficientKoszulLevel_eq_basisWeightLevel]
  rfl

theorem originalKoszulFiltration_eq_exterior (hrank : ∀ p : P, faceRank p ≤ d)
    (i n : ℕ) (x : Set.powersetCard (Fin d) i →₀ FaceRing K hs) :
    x ∈ (originalKoszulFiltration K hs d i).level n ↔
      coefficientExteriorLift (K := K) i x ∈
        coefficientExteriorLevel (originalFaceWeightLevel K hs d)
          (fun j : Fin d => rankWeight d (j.val + 1)) (n : ℤ) := by
  rw [coefficientExteriorLift_level_iff, originalKoszulCoefficientLevel_eq]
  change x ∈ (basisFiltration (originalKoszulBasis K hs d i)
      (fun a => (originalKoszulWeight d a).toNat)).level n ↔ _
  rw [basisFiltration_int_eq _ _ (originalKoszulWeight_nonnegative d hrank)]

theorem barycentricKoszulFiltration_eq_exterior (hrank : ∀ p : P, faceRank p ≤ d)
    (i n : ℕ) (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K) :
    x ∈ (barycentricKoszulFiltration (P := P) K d i).level n ↔
      coefficientExteriorLift (K := K) i x ∈
        coefficientExteriorLevel (originalBarycentricWeightLevel (P := P) K d)
          (fun j : Fin d => rankWeight d (j.val + 1)) (n : ℤ) := by
  rw [coefficientExteriorLift_level_iff, barycentricKoszulCoefficientLevel_eq]
  change x ∈ (basisFiltration (barycentricKoszulBasis (P := P) K d i)
      (fun a => (originalKoszulWeight d a).toNat)).level n ↔ _
  rw [basisFiltration_int_eq _ _ (originalKoszulWeight_nonnegative d hrank)]

/-- Product preservation for the exact original Koszul filtration already
used in the intrinsic associated-homology theorem. -/
theorem originalKoszulProduct_filtered (hrank : ∀ p : P, faceRank p ≤ d)
    (i j r s : ℕ) (x : Set.powersetCard (Fin d) i →₀ FaceRing K hs)
    (y : Set.powersetCard (Fin d) j →₀ FaceRing K hs)
    (hx : x ∈ (originalKoszulFiltration K hs d i).level (r + 1))
    (hy : y ∈ (originalKoszulFiltration K hs d j).level (s + 1)) :
    coefficientKoszulProduct (K := K) i j x y ∈
      (originalKoszulFiltration K hs d (i + j)).level (r + s + 1) := by
  rw [originalKoszulFiltration_eq_exterior K hs d hrank] at hx hy ⊢
  rw [coefficientKoszulProduct_lift]
  simpa only [Nat.cast_add, Nat.cast_one] using
    coefficientExteriorLevel_multiplicative (originalFaceWeightLevel K hs d)
      (originalFaceWeight_multiplicative K hs d) (fun j : Fin d => rankWeight d (j.val + 1))
      (r : ℤ) (s : ℤ) _ _
      (by simpa only [Nat.cast_add, Nat.cast_one] using hx)
      (by simpa only [Nat.cast_add, Nat.cast_one] using hy)

theorem barycentricKoszulProduct_filtered (hrank : ∀ p : P, faceRank p ≤ d)
    (i j r s : ℕ) (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (y : Set.powersetCard (Fin d) j →₀ BarycentricRing (P := P) K)
    (hx : x ∈ (barycentricKoszulFiltration (P := P) K d i).level (r + 1))
    (hy : y ∈ (barycentricKoszulFiltration (P := P) K d j).level (s + 1)) :
    coefficientKoszulProduct (K := K) i j x y ∈
      (barycentricKoszulFiltration (P := P) K d (i + j)).level (r + s + 1) := by
  rw [barycentricKoszulFiltration_eq_exterior K d hrank] at hx hy ⊢
  rw [coefficientKoszulProduct_lift]
  simpa only [Nat.cast_add, Nat.cast_one] using
    coefficientExteriorLevel_multiplicative (originalBarycentricWeightLevel (P := P) K d)
      (originalBarycentricWeight_multiplicative K d) (fun j : Fin d => rankWeight d (j.val + 1))
      (r : ℤ) (s : ℤ) _ _
      (by simpa only [Nat.cast_add, Nat.cast_one] using hx)
      (by simpa only [Nat.cast_add, Nat.cast_one] using hy)

end Poset
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.CoordinateExteriorInternalDegree -/
section

/-! # The existing internal grading is additive under the actual Koszul product

The ordinary coefficient degrees are those of the original weighted
polynomial presentations.  They are extended by zero to negative integer
degrees solely to write the exterior degree shifts uniformly.  The resulting
coordinate submodules are proved equal to the pre-existing internal pieces.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.Universal

open Classical Finset MvPolynomial
open FourPapers.BasisGrading

universe u v
section ParameterGenerality
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

def integerBasisDegreePiece {I : Type*} (b : Module.Basis I K B) (degree : I → ℕ) (r : ℤ) :
    Submodule K B := FourPapers.BasisGrading.Piece b (fun a => (degree a : ℤ)) r

theorem integerBasisDegreePiece_nat {I : Type*} (b : Module.Basis I K B)
    (degree : I → ℕ) (n : ℕ) :
    integerBasisDegreePiece b degree (n : ℤ) = basisOrdinaryDegreePiece b degree n := by
  rw [← basisDegreePiece_eq]
  ext x
  simp only [integerBasisDegreePiece, FourPapers.BasisGrading.mem_piece, Int.natCast_inj]

theorem integerBasisDegreePiece_negative {I : Type*} (b : Module.Basis I K B)
    (degree : I → ℕ) (r : ℤ) (hr : r < 0) : integerBasisDegreePiece b degree r = ⊥ := by
  ext x
  constructor
  · intro hx
    apply (Submodule.mem_bot K).mpr
    apply b.repr.injective
    ext a
    by_contra h
    have hn : b.repr x a ≠ 0 := by simpa using h
    have hd := (FourPapers.BasisGrading.mem_piece b _ r x).mp hx a hn
    have hpos : (0 : ℤ) ≤ degree a := Int.natCast_nonneg _
    omega
  · intro hx
    rw [Submodule.mem_bot] at hx
    rw [hx]
    exact Submodule.zero_mem _

theorem integerBasisDegreePiece_multiplicative {I : Type*} (b : Module.Basis I K B)
    (degree : I → ℕ)
    (hb : ∀ a a', b a * b a' ∈ basisOrdinaryDegreePiece b degree (degree a + degree a')) :
    ∀ r s x y, x ∈ integerBasisDegreePiece b degree r →
      y ∈ integerBasisDegreePiece b degree s →
        x * y ∈ integerBasisDegreePiece b degree (r + s) := by
  intro r s x y hx hy
  apply bilinear_mem_of_basis_support K b b (LinearMap.mul K B)
  intro a ha a' ha'
  have hda := (FourPapers.BasisGrading.mem_piece b _ r x).mp hx a (Finsupp.mem_support_iff.mp ha)
  have hda' := (FourPapers.BasisGrading.mem_piece b _ s y).mp hy a' (Finsupp.mem_support_iff.mp ha')
  have hprod : b a * b a' ∈ integerBasisDegreePiece b degree ((degree a + degree a' : ℕ) : ℤ) := by
    rw [integerBasisDegreePiece_nat]
    exact hb a a'
  simpa only [LinearMap.mul_apply', Nat.cast_add, hda, hda'] using hprod

theorem exteriorAssignedWeight_nat (v : C → ℕ) (F : Finset C) :
    exteriorAssignedWeight (fun c => (v c : ℤ)) F = ((∑ c ∈ F, v c : ℕ) : ℤ) := by
  simp only [exteriorAssignedWeight, Nat.cast_sum]

theorem coefficientKoszulLevel_integerDegree_eq {I : Type*}
    (b : Module.Basis I K B) (degree : I → ℕ) (v : C → ℕ) (i j : ℕ) :
    coefficientKoszulLevel (integerBasisDegreePiece b degree) (fun c => (v c : ℤ)) i (j : ℤ) =
      basisOrdinaryDegreePiece (Finsupp.basis (fun _ : Set.powersetCard C i => b))
        (fun a => degree a.2 + ∑ c ∈ a.1.val, v c) j := by
  rw [← basisDegreePiece_eq]
  ext x
  rw [coefficientKoszulLevel_mem, FourPapers.BasisGrading.mem_piece]
  constructor
  · intro hx a ha
    rcases a with ⟨F, a⟩
    have ha' : b.repr (x F) a ≠ 0 := by simpa only [Finsupp.basis_repr] using ha
    have hd := (FourPapers.BasisGrading.mem_piece b _ _ (x F)).mp (hx F) a ha'
    rw [exteriorAssignedWeight_nat] at hd
    dsimp
    omega
  · intro hx F
    rw [integerBasisDegreePiece, FourPapers.BasisGrading.mem_piece]
    intro a ha
    have hd := hx ⟨F, a⟩ (by simpa only [Finsupp.basis_repr] using ha)
    rw [exteriorAssignedWeight_nat]
    dsimp at hd
    omega

end ParameterGenerality

section Poset

variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P)

theorem usualFaceDegreePiece_mul (r s : ℕ) (x y : FaceRing K hs)
    (hx : x ∈ usualFaceDegreePiece K hs r) (hy : y ∈ usualFaceDegreePiece K hs s) :
    x * y ∈ usualFaceDegreePiece K hs (r + s) := by
  obtain ⟨f, hf, rfl⟩ := hx
  obtain ⟨g, hg, rfl⟩ := hy
  exact ⟨f * g, hf.mul hg, (Ideal.Quotient.mkₐ K (faceIdeal K hs)).map_mul f g⟩

theorem usualBarycentricDegreePiece_mul (r s : ℕ) (x y : BarycentricRing (P := P) K)
    (hx : x ∈ usualBarycentricDegreePiece (P := P) K r)
    (hy : y ∈ usualBarycentricDegreePiece (P := P) K s) :
    x * y ∈ usualBarycentricDegreePiece (P := P) K (r + s) := by
  obtain ⟨f, hf, rfl⟩ := hx
  obtain ⟨g, hg, rfl⟩ := hy
  exact ⟨f * g, hf.mul hg, (Ideal.Quotient.mkₐ K (barycentricIdeal (P := P) K)).map_mul f g⟩

theorem originalIntegerDegree_multiplicative :
    ∀ r s x y,
      x ∈ integerBasisDegreePiece (standardFaceBasis K hs) standardOrdinaryDegree r →
      y ∈ integerBasisDegreePiece (standardFaceBasis K hs) standardOrdinaryDegree s →
      x * y ∈ integerBasisDegreePiece (standardFaceBasis K hs) standardOrdinaryDegree (r + s) := by
  apply integerBasisDegreePiece_multiplicative
  intro a b
  rw [← usualFaceDegreePiece_eq]
  apply usualFaceDegreePiece_mul
  · rw [usualFaceDegreePiece_eq, ← basisDegreePiece_eq]
    exact FourPapers.BasisGrading.basis_mem_piece _ _ a
  · rw [usualFaceDegreePiece_eq, ← basisDegreePiece_eq]
    exact FourPapers.BasisGrading.basis_mem_piece _ _ b

theorem barycentricIntegerDegree_multiplicative :
    ∀ r s x y,
      x ∈ integerBasisDegreePiece (barycentricGlobalStandardBasis (P := P) K) standardOrdinaryDegree r →
      y ∈ integerBasisDegreePiece (barycentricGlobalStandardBasis (P := P) K) standardOrdinaryDegree s →
      x * y ∈ integerBasisDegreePiece (barycentricGlobalStandardBasis (P := P) K)
        standardOrdinaryDegree (r + s) := by
  apply integerBasisDegreePiece_multiplicative
  intro a b
  rw [← usualBarycentricDegreePiece_eq]
  apply usualBarycentricDegreePiece_mul
  · rw [usualBarycentricDegreePiece_eq, ← basisDegreePiece_eq]
    exact FourPapers.BasisGrading.basis_mem_piece _ _ a
  · rw [usualBarycentricDegreePiece_eq, ← basisDegreePiece_eq]
    exact FourPapers.BasisGrading.basis_mem_piece _ _ b

theorem originalKoszulDegreePiece_eq_exteriorCoefficients (d i j : ℕ) :
    originalKoszulDegreePiece K hs d i j =
      coefficientKoszulLevel (integerBasisDegreePiece (standardFaceBasis K hs) standardOrdinaryDegree)
        (fun c : Fin d => ((c.val + 1 : ℕ) : ℤ)) i (j : ℤ) := by
  rw [coefficientKoszulLevel_integerDegree_eq, originalKoszulDegreePiece, basisDegreePiece_eq]
  rfl

theorem barycentricKoszulDegreePiece_eq_exteriorCoefficients (d i j : ℕ) :
    barycentricKoszulDegreePiece (P := P) K d i j =
      coefficientKoszulLevel
        (integerBasisDegreePiece (barycentricGlobalStandardBasis (P := P) K) standardOrdinaryDegree)
        (fun c : Fin d => ((c.val + 1 : ℕ) : ℤ)) i (j : ℤ) := by
  rw [coefficientKoszulLevel_integerDegree_eq, barycentricKoszulDegreePiece, basisDegreePiece_eq]
  rfl

/-- The actual coordinate product adds the usual internal degrees of the
paper, including the rank-dependent degrees of the Koszul generators. -/
theorem originalKoszulProduct_internalDegree (d i j r s : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ FaceRing K hs)
    (y : Set.powersetCard (Fin d) j →₀ FaceRing K hs)
    (hx : x ∈ originalKoszulDegreePiece K hs d i r)
    (hy : y ∈ originalKoszulDegreePiece K hs d j s) :
    coefficientKoszulProduct (K := K) i j x y ∈ originalKoszulDegreePiece K hs d (i + j) (r + s) := by
  rw [originalKoszulDegreePiece_eq_exteriorCoefficients] at hx hy ⊢
  simpa only [Nat.cast_add] using coefficientKoszulProduct_preserves_exact_degree
    (integerBasisDegreePiece (standardFaceBasis K hs) standardOrdinaryDegree)
    (originalIntegerDegree_multiplicative K hs) (fun c : Fin d => ((c.val + 1 : ℕ) : ℤ))
    i j (r : ℤ) (s : ℤ) x y hx hy

theorem barycentricKoszulProduct_internalDegree (d i j r s : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (y : Set.powersetCard (Fin d) j →₀ BarycentricRing (P := P) K)
    (hx : x ∈ barycentricKoszulDegreePiece (P := P) K d i r)
    (hy : y ∈ barycentricKoszulDegreePiece (P := P) K d j s) :
    coefficientKoszulProduct (K := K) i j x y ∈
      barycentricKoszulDegreePiece (P := P) K d (i + j) (r + s) := by
  rw [barycentricKoszulDegreePiece_eq_exteriorCoefficients] at hx hy ⊢
  simpa only [Nat.cast_add] using coefficientKoszulProduct_preserves_exact_degree
    (integerBasisDegreePiece (barycentricGlobalStandardBasis (P := P) K) standardOrdinaryDegree)
    (barycentricIntegerDegree_multiplicative (P := P) K)
    (fun c : Fin d => ((c.val + 1 : ℕ) : ℤ)) i j (r : ℤ) (s : ℤ) x y hx hy

end Poset
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.FilteredKoszulProduct -/
section

/-! # Multiplication through the canonical filtered-homology comparison

Both products are induced from the actual coordinate Koszul product. The
source first takes ordinary homology and then its filtration quotient. The
target first takes the filtration quotients of the chain modules and then
their ordinary kernel/image homology. Compatibility is proved on actual
bounded cycles; no multiplicative compatibility is included as a hypothesis.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.FilteredHomology

variable {K Y Z : Type*} [CommRing K] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z]

theorem cycleToGradeCycle_surjective (G : Filtration (K := K) Y) (H : Filtration (K := K) Z)
    (g : Y →ₗ[K] Z) (hg : Preserves G H g) (lift : LiftsCycles G H g) (n : ℕ) :
    Function.Surjective (cycleToGradeCycle G H g hg n) := by
  intro z
  obtain ⟨y, hy⟩ := (lowerInLevel G n).mkQ_surjective z.val
  have hgy : g y.val ∈ H.level n := by
    have hh := z.property
    rw [← hy] at hh
    change (Submodule.Quotient.mk (levelMap G H g hg (n + 1) y) : Grade H n) = 0 at hh
    exact (Submodule.Quotient.mk_eq_zero (lowerInLevel H n)).mp hh
  obtain ⟨w, hw, hgw, hyw⟩ := lift n y.val y.property hgy
  refine ⟨⟨⟨w, hgw⟩, hw⟩, ?_⟩
  apply Subtype.ext
  change Submodule.Quotient.mk (⟨w, hw⟩ : G.level (n + 1)) = z.val
  rw [← hy]
  apply (Submodule.Quotient.eq _).mpr
  change w - y.val ∈ G.level n
  simpa only [neg_sub] using (G.level n).neg_mem hyw

end FourPapers.FilteredHomology

namespace FourPapers.Universal

open Classical Finset CategoryTheory FourPapers.FilteredHomology

universe u v
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

variable (γ : C → B) (F : ∀ i : ℕ, Filtration (K := K) (Set.powersetCard C i →₀ B))

abbrev coefficientHomologyFiltration (i : ℕ) :=
  homologyFiltration (F i) (parameterKoszulDifferential (K := K) γ i)
    (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i)

variable (hp : ∀ i j, PreservesPair (F i) (F j) (F (i + j))
  (coefficientKoszulProduct (K := K) i j))

include hp in
theorem coefficientKoszulHomologyProduct_filtered (i j : ℕ) :
    PreservesPair (coefficientHomologyFiltration γ F i) (coefficientHomologyFiltration γ F j)
      (coefficientHomologyFiltration γ F (i + j)) (coefficientKoszulHomologyProduct (K := K) γ i j) := by
  intro r s x y hx hy
  obtain ⟨z, hz, rfl⟩ := hx
  obtain ⟨w, hw, rfl⟩ := hy
  refine ⟨coefficientKoszulCycleProduct (K := K) γ i j z w,
    hp i j r s z.val w.val hz hw, ?_⟩
  exact (coefficientKoszulHomologyProduct_class γ i j z w).symm

def coefficientHomologyGradeProduct (i j r s : ℕ) :
    Grade (coefficientHomologyFiltration γ F i) r →ₗ[K]
      Grade (coefficientHomologyFiltration γ F j) s →ₗ[K]
        Grade (coefficientHomologyFiltration γ F (i + j)) (r + s) :=
  gradeBilinearProduct _ _ _ (coefficientKoszulHomologyProduct (K := K) γ i j)
    (coefficientKoszulHomologyProduct_filtered γ F hp i j) r s

def coefficientFilteredCycleProduct (i j r s : ℕ) :
    cycleLevel (F i) (coefficientExteriorOutgoing (K := K) γ i) (r + 1) →ₗ[K]
      cycleLevel (F j) (coefficientExteriorOutgoing (K := K) γ j) (s + 1) →ₗ[K]
        cycleLevel (F (i + j)) (coefficientExteriorOutgoing (K := K) γ (i + j)) (r + s + 1) where
  toFun x :=
    { toFun := fun y => ⟨coefficientKoszulCycleProduct (K := K) γ i j x.val y.val,
        hp i j r s x.val.val y.val.val x.property y.property⟩
      map_add' y z := by
        apply Subtype.ext
        exact map_add (coefficientKoszulCycleProduct (K := K) γ i j x.val) y.val z.val
      map_smul' c y := by
        apply Subtype.ext
        exact map_smul (coefficientKoszulCycleProduct (K := K) γ i j x.val) c y.val }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_add (coefficientKoszulCycleProduct (K := K) γ i j) x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_smul (coefficientKoszulCycleProduct (K := K) γ i j) c x.val) y.val

theorem coefficientHomologyGradeProduct_class (i j r s : ℕ)
    (x : cycleLevel (F i) (coefficientExteriorOutgoing (K := K) γ i) (r + 1))
    (y : cycleLevel (F j) (coefficientExteriorOutgoing (K := K) γ j) (s + 1)) :
    coefficientHomologyGradeProduct γ F hp i j r s
        (filteredHomologyClass (F i) (parameterKoszulDifferential (K := K) γ i)
          (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i) r x)
        (filteredHomologyClass (F j) (parameterKoszulDifferential (K := K) γ j)
          (coefficientExteriorOutgoing (K := K) γ j) (coefficientExteriorIncomingOutgoing γ j) s y) =
      filteredHomologyClass (F (i + j)) (parameterKoszulDifferential (K := K) γ (i + j))
        (coefficientExteriorOutgoing (K := K) γ (i + j)) (coefficientExteriorIncomingOutgoing γ (i + j))
        (r + s) (coefficientFilteredCycleProduct γ F hp i j r s x y) := by
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel (coefficientHomologyFiltration γ F (i + j)) (r + s)))
  apply Subtype.ext
  exact coefficientKoszulHomologyProduct_class γ i j x.val y.val

variable (hD : ∀ i, Preserves (F (i + 1)) (F i) (parameterKoszulDifferential (K := K) γ i))
  (hL : ∀ i, LiftsCycles (F (i + 1)) (F i) (parameterKoszulDifferential (K := K) γ i))

include hD in
theorem coefficientOutgoing_preserves (i : ℕ) :
    Preserves (F i) (F (i - 1)) (coefficientExteriorOutgoing (K := K) γ i) := by
  cases i with
  | zero =>
      have hz := (parameterKoszulComplex (K := K) γ).shape 0 0 (by decide)
      simp only [coefficientExteriorOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero]
      intro r x hx
      exact Submodule.zero_mem _
  | succ i =>
      simpa only [coefficientExteriorOutgoing, Nat.succ_sub_one, Nat.add_sub_cancel, parameterKoszulComplex_d, ModuleCat.hom_ofHom] using hD i

include hL in
theorem coefficientOutgoing_lifts (i : ℕ) :
    LiftsCycles (F i) (F (i - 1)) (coefficientExteriorOutgoing (K := K) γ i) := by
  cases i with
  | zero =>
      have hz := (parameterKoszulComplex (K := K) γ).shape 0 0 (by decide)
      simp only [coefficientExteriorOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero]
      intro r x hx hdx
      exact ⟨x, hx, rfl, by simpa only [sub_self] using ((F 0).level r).zero_mem⟩
  | succ i =>
      simpa only [coefficientExteriorOutgoing, Nat.succ_sub_one, Nat.add_sub_cancel, parameterKoszulComplex_d, ModuleCat.hom_ofHom] using hL i

abbrev coefficientGradedKoszulHomology (i r : ℕ) :=
  GradedHomology (F (i + 1)) (F i) (F (i - 1))
    (parameterKoszulDifferential (K := K) γ i) (coefficientExteriorOutgoing (K := K) γ i)
    (hD i) (coefficientOutgoing_preserves γ F hD i) (coefficientExteriorIncomingOutgoing γ i) r

def coefficientAssociatedHomology (i r : ℕ) :
    Grade (coefficientHomologyFiltration γ F i) r ≃ₗ[K] coefficientGradedKoszulHomology γ F hD i r :=
  associatedHomologyEquiv _ _ _ _ _ _ _ _ r (hL i) (coefficientOutgoing_lifts γ F hL i)

@[simp] theorem coefficientAssociatedHomology_class (i r : ℕ)
    (x : cycleLevel (F i) (coefficientExteriorOutgoing (K := K) γ i) (r + 1)) :
    coefficientAssociatedHomology γ F hD hL i r
        (filteredHomologyClass (F i) (parameterKoszulDifferential (K := K) γ i)
          (coefficientExteriorOutgoing (K := K) γ i) (coefficientExteriorIncomingOutgoing γ i) r x) =
      leadingHomologyClass (F (i + 1)) (F i) (F (i - 1))
        (parameterKoszulDifferential (K := K) γ i) (coefficientExteriorOutgoing (K := K) γ i)
        (hD i) (coefficientOutgoing_preserves γ F hD i) (coefficientExteriorIncomingOutgoing γ i) r x :=
  associatedHomologyEquiv_class _ _ _ _ _ _ _ _ r _ _ x

abbrev coefficientGradeCycles (i r : ℕ) :=
  LinearMap.ker (gradeMap (F i) (F (i - 1)) (coefficientExteriorOutgoing (K := K) γ i)
    (coefficientOutgoing_preserves γ F hD i) r)

def coefficientGradedCycleProduct (i j r s : ℕ) :
    coefficientGradeCycles γ F hD i r →ₗ[K] coefficientGradeCycles γ F hD j s →ₗ[K]
      coefficientGradeCycles γ F hD (i + j) (r + s) where
  toFun x :=
    { toFun := fun y => ⟨gradeBilinearProduct (F i) (F j) (F (i + j))
        (coefficientKoszulProduct (K := K) i j) (hp i j) r s x.val y.val, by
        obtain ⟨x, rfl⟩ := cycleToGradeCycle_surjective (F i) (F (i - 1))
          (coefficientExteriorOutgoing (K := K) γ i) (coefficientOutgoing_preserves γ F hD i)
          (coefficientOutgoing_lifts γ F hL i) r x
        obtain ⟨y, rfl⟩ := cycleToGradeCycle_surjective (F j) (F (j - 1))
          (coefficientExteriorOutgoing (K := K) γ j) (coefficientOutgoing_preserves γ F hD j)
          (coefficientOutgoing_lifts γ F hL j) s y
        exact (cycleToGradeCycle (F (i + j)) (F (i + j - 1))
          (coefficientExteriorOutgoing (K := K) γ (i + j))
          (coefficientOutgoing_preserves γ F hD (i + j)) (r + s)
          (coefficientFilteredCycleProduct γ F hp i j r s x y)).property⟩
      map_add' y z := by
        apply Subtype.ext
        exact map_add (gradeBilinearProduct _ _ _ _ (hp i j) r s x.val) y.val z.val
      map_smul' c y := by
        apply Subtype.ext
        exact map_smul (gradeBilinearProduct _ _ _ _ (hp i j) r s x.val) c y.val }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_add (gradeBilinearProduct _ _ _ _ (hp i j) r s) x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_smul (gradeBilinearProduct _ _ _ _ (hp i j) r s) c x.val) y.val

def coefficientGradedCycleProductClass (i j r s : ℕ) :
    coefficientGradeCycles γ F hD i r →ₗ[K] coefficientGradeCycles γ F hD j s →ₗ[K]
      coefficientGradedKoszulHomology γ F hD (i + j) (r + s) :=
  (coefficientGradedCycleProduct γ F hp hD hL i j r s).compr₂ (homologyClass _ _ _)

theorem coefficientGradedCycleProductClass_lift (i j r s : ℕ)
    (x : cycleLevel (F i) (coefficientExteriorOutgoing (K := K) γ i) (r + 1))
    (y : cycleLevel (F j) (coefficientExteriorOutgoing (K := K) γ j) (s + 1)) :
    coefficientGradedCycleProductClass γ F hp hD hL i j r s
        (cycleToGradeCycle (F i) (F (i - 1)) _ (coefficientOutgoing_preserves γ F hD i) r x)
        (cycleToGradeCycle (F j) (F (j - 1)) _ (coefficientOutgoing_preserves γ F hD j) s y) =
      leadingHomologyClass (F (i + j + 1)) (F (i + j)) (F (i + j - 1))
        (parameterKoszulDifferential (K := K) γ (i + j)) (coefficientExteriorOutgoing (K := K) γ (i + j))
        (hD (i + j)) (coefficientOutgoing_preserves γ F hD (i + j))
        (coefficientExteriorIncomingOutgoing γ (i + j)) (r + s)
        (coefficientFilteredCycleProduct γ F hp i j r s x y) := rfl

theorem coefficientAssociatedHomology_product_class (i j r s : ℕ)
    (x : cycleLevel (F i) (coefficientExteriorOutgoing (K := K) γ i) (r + 1))
    (y : cycleLevel (F j) (coefficientExteriorOutgoing (K := K) γ j) (s + 1)) :
    coefficientAssociatedHomology γ F hD hL (i + j) (r + s)
        (coefficientHomologyGradeProduct γ F hp i j r s
          (filteredHomologyClass (F i) _ _ (coefficientExteriorIncomingOutgoing γ i) r x)
          (filteredHomologyClass (F j) _ _ (coefficientExteriorIncomingOutgoing γ j) s y)) =
      coefficientGradedCycleProductClass γ F hp hD hL i j r s
        (cycleToGradeCycle (F i) (F (i - 1)) _ (coefficientOutgoing_preserves γ F hD i) r x)
        (cycleToGradeCycle (F j) (F (j - 1)) _ (coefficientOutgoing_preserves γ F hD j) s y) := by
  rw [coefficientHomologyGradeProduct_class, coefficientAssociatedHomology_class,
    coefficientGradedCycleProductClass_lift]

theorem coefficientGradedCycleProductClass_left_zero (i j r s : ℕ)
    (x : coefficientGradeCycles γ F hD i r) (y : coefficientGradeCycles γ F hD j s)
    (hx : (homologyClass _ _ _ x : coefficientGradedKoszulHomology γ F hD i r) = 0) :
    coefficientGradedCycleProductClass γ F hp hD hL i j r s x y = 0 := by
  obtain ⟨x, rfl⟩ := cycleToGradeCycle_surjective (F i) (F (i - 1)) _
    (coefficientOutgoing_preserves γ F hD i) (coefficientOutgoing_lifts γ F hL i) r x
  obtain ⟨y, rfl⟩ := cycleToGradeCycle_surjective (F j) (F (j - 1)) _
    (coefficientOutgoing_preserves γ F hD j) (coefficientOutgoing_lifts γ F hL j) s y
  have hx0 : filteredHomologyClass (F i) _ _ (coefficientExteriorIncomingOutgoing γ i) r x = 0 := by
    apply (coefficientAssociatedHomology γ F hD hL i r).injective
    rw [map_zero, coefficientAssociatedHomology_class]
    exact hx
  rw [← coefficientAssociatedHomology_product_class γ F hp hD hL i j r s x y,
    hx0, map_zero, LinearMap.zero_apply, map_zero]

theorem coefficientGradedCycleProductClass_right_zero (i j r s : ℕ)
    (x : coefficientGradeCycles γ F hD i r) (y : coefficientGradeCycles γ F hD j s)
    (hy : (homologyClass _ _ _ y : coefficientGradedKoszulHomology γ F hD j s) = 0) :
    coefficientGradedCycleProductClass γ F hp hD hL i j r s x y = 0 := by
  obtain ⟨x, rfl⟩ := cycleToGradeCycle_surjective (F i) (F (i - 1)) _
    (coefficientOutgoing_preserves γ F hD i) (coefficientOutgoing_lifts γ F hL i) r x
  obtain ⟨y, rfl⟩ := cycleToGradeCycle_surjective (F j) (F (j - 1)) _
    (coefficientOutgoing_preserves γ F hD j) (coefficientOutgoing_lifts γ F hL j) s y
  have hy0 : filteredHomologyClass (F j) _ _ (coefficientExteriorIncomingOutgoing γ j) s y = 0 := by
    apply (coefficientAssociatedHomology γ F hD hL j s).injective
    rw [map_zero, coefficientAssociatedHomology_class]
    exact hy
  rw [← coefficientAssociatedHomology_product_class γ F hp hD hL i j r s x y,
    hy0, map_zero, map_zero]

/-- This target product is induced from the actual associated-grade chain
product through the ordinary cycle/image quotient; it is not transported
along the filtered-homology comparison. -/
def coefficientGradedHomologyProduct (i j r s : ℕ) :
    coefficientGradedKoszulHomology γ F hD i r →ₗ[K]
      coefficientGradedKoszulHomology γ F hD j s →ₗ[K]
        coefficientGradedKoszulHomology γ F hD (i + j) (r + s) :=
  (coefficientGradedCycleProductClass γ F hp hD hL i j r s).liftQ₂ _ _
    (by
      rintro x ⟨a, rfl⟩
      apply LinearMap.ext
      intro y
      apply coefficientGradedCycleProductClass_left_zero γ F hp hD hL i j r s _ y
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact ⟨a, rfl⟩)
    (by
      rintro y ⟨a, rfl⟩
      apply LinearMap.ext
      intro x
      apply coefficientGradedCycleProductClass_right_zero γ F hp hD hL i j r s x _
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact ⟨a, rfl⟩)

@[simp] theorem coefficientGradedHomologyProduct_class (i j r s : ℕ)
    (x : coefficientGradeCycles γ F hD i r) (y : coefficientGradeCycles γ F hD j s) :
    coefficientGradedHomologyProduct γ F hp hD hL i j r s
        (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      coefficientGradedCycleProductClass γ F hp hD hL i j r s x y := rfl

/-- The canonical comparison `gr(H) → H(gr)` preserves the two products
induced independently from the same actual Koszul exterior multiplication. -/
theorem coefficientAssociatedHomology_multiplicative (i j r s : ℕ)
    (x : Grade (coefficientHomologyFiltration γ F i) r)
    (y : Grade (coefficientHomologyFiltration γ F j) s) :
    coefficientAssociatedHomology γ F hD hL (i + j) (r + s)
        (coefficientHomologyGradeProduct γ F hp i j r s x y) =
      coefficientGradedHomologyProduct γ F hp hD hL i j r s
        (coefficientAssociatedHomology γ F hD hL i r x)
        (coefficientAssociatedHomology γ F hD hL j s y) := by
  obtain ⟨x, rfl⟩ := filteredHomologyClass_surjective (F i) _ _ (coefficientExteriorIncomingOutgoing γ i) r x
  obtain ⟨y, rfl⟩ := filteredHomologyClass_surjective (F j) _ _ (coefficientExteriorIncomingOutgoing γ j) s y
  rw [coefficientAssociatedHomology_class, coefficientAssociatedHomology_class]
  exact coefficientAssociatedHomology_product_class γ F hp hD hL i j r s x y

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.KoszulMultiplicativeComparison -/
section

/-! # Multiplication for the canonical Koszul associated-homology comparison

The products below are the products already induced from the literal exterior
Koszul DGA.  The canonical coefficient comparison has a strictly lower product
defect.  Consequently its associated-grade map, which agrees with the
parameter-linear comparison there, preserves the actual products.  Passing
through the ordinary cycle/image quotient proves the multiplicative part of
the barycentric associated-homology comparison.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.Universal

open Classical CategoryTheory FourPapers.FilteredHomology

universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

/-- Normalize the actual incoming arrow as a linear map before placing it
inside dependent homology quotients. -/
theorem parameterKoszulComplex_incoming_eq {B : Type u} {C : Type}
    [CommRing B] [Algebra K B] [Fintype C] [LinearOrder C] (γ : C → B) (i : ℕ) :
    complexIncoming (parameterKoszulComplex (K := K) γ) i =
      parameterKoszulDifferential (K := K) γ i := by
  simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]

section IncomingNormalization
variable {X Y Z : Type*} [AddCommGroup X] [Module K X]
  [AddCommGroup Y] [Module K Y] [AddCommGroup Z] [Module K Z]

/-- Passing to a grade respects equality of the actual linear maps. -/
theorem gradeMap_eq_of_eq (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f f' : X →ₗ[K] Y) (hf : Preserves F G f) (hf' : Preserves F G f')
    (h : f = f') (n : ℕ) : gradeMap F G f hf n = gradeMap F G f' hf' n := by
  subst f'
  rfl

/-- Every graded homology class has an actual graded cycle representative. -/
theorem gradedHomologyClass_surjective
    (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (H : Filtration (K := K) Z) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hf : Preserves F G f) (hg : Preserves G H g) (hfg : g.comp f = 0) (n : ℕ) :
    Function.Surjective (homologyClass (gradeMap F G f hf n) (gradeMap G H g hg n)
      (gradeMap_comp F G H f g hf hg hfg n)) :=
  (LinearMap.range (boundaryMap (gradeMap F G f hf n) (gradeMap G H g hg n)
    (gradeMap_comp F G H f g hf hg hfg n))).mkQ_surjective

/-- Equal incoming maps have exactly equal boundary submodules.  The
resulting quotient equivalence is identity on every cycle representative. -/
def homologyIncomingNormalization (f f' : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) (hfg' : g.comp f' = 0) (h : f = f') :
    Homology f g hfg ≃ₗ[K] Homology f' g hfg' :=
  Submodule.quotEquivOfEq _ _ (by subst f'; rfl)

@[simp] theorem homologyIncomingNormalization_class
    (f f' : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) (hfg' : g.comp f' = 0) (h : f = f')
    (z : LinearMap.ker g) :
    homologyIncomingNormalization K f f' g hfg hfg' h (homologyClass f g hfg z) =
      homologyClass f' g hfg' z := rfl

@[simp] theorem homologyIncomingNormalization_symm_class
    (f f' : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) (hfg' : g.comp f' = 0) (h : f = f')
    (z : LinearMap.ker g) :
    (homologyIncomingNormalization K f f' g hfg hfg' h).symm (homologyClass f' g hfg' z) =
      homologyClass f g hfg z := rfl

theorem homologyIncomingNormalization_filtered
    (f f' : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) (hfg' : g.comp f' = 0) (h : f = f')
    (F : Filtration (K := K) Y) (n : ℕ) (x : Homology f g hfg) :
    homologyIncomingNormalization K f f' g hfg hfg' h x ∈
        (homologyFiltration F f' g hfg').level n ↔
      x ∈ (homologyFiltration F f g hfg).level n := by
  subst f'
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap f g hfg)).mkQ_surjective x
  rfl
end IncomingNormalization

section ParameterNormalization
variable {B : Type u} {C : Type} [CommRing B] [Algebra K B] [Fintype C] [LinearOrder C]
variable (γ : C → B)

/-- The coordinate and categorical versions of the same Koszul homology,
with the equality of their incoming maps used explicitly. -/
def parameterHomologyNormalization (i : ℕ) :
    CoefficientKoszulHomology (K := K) γ i ≃ₗ[K]
      complexKernelHomology (parameterKoszulComplex (K := K) γ) i :=
  homologyIncomingNormalization K
    (parameterKoszulDifferential (K := K) γ i)
    (complexIncoming (parameterKoszulComplex (K := K) γ) i)
    (complexOutgoing (parameterKoszulComplex (K := K) γ) i)
    (coefficientExteriorIncomingOutgoing γ i)
    (complexIncomingOutgoing (parameterKoszulComplex (K := K) γ) i)
    (parameterKoszulComplex_incoming_eq K γ i).symm

variable (F : ∀ i, Filtration (K := K) (Set.powersetCard C i →₀ B))

theorem parameterHomologyNormalization_filtered (i n : ℕ)
    (x : CoefficientKoszulHomology (K := K) γ i) :
    parameterHomologyNormalization K γ i x ∈
        (homologyFiltration (F i)
          (complexIncoming (parameterKoszulComplex (K := K) γ) i)
          (complexOutgoing (parameterKoszulComplex (K := K) γ) i)
          (complexIncomingOutgoing (parameterKoszulComplex (K := K) γ) i)).level n ↔
      x ∈ (coefficientHomologyFiltration γ F i).level n :=
  homologyIncomingNormalization_filtered K _ _ _ _ _ _ (F i) n x

def parameterHomologyGradeNormalization (i n : ℕ) :
    Grade (coefficientHomologyFiltration γ F i) n ≃ₗ[K]
      Grade (homologyFiltration (F i)
        (complexIncoming (parameterKoszulComplex (K := K) γ) i)
        (complexOutgoing (parameterKoszulComplex (K := K) γ) i)
        (complexIncomingOutgoing (parameterKoszulComplex (K := K) γ) i)) n :=
  gradeEquiv _ _ (parameterHomologyNormalization K γ i)
    (parameterHomologyNormalization_filtered K γ F i) n

variable (hD : ∀ i, Preserves (F (i + 1)) (F i) (parameterKoszulDifferential (K := K) γ i))
  (hI : ∀ i, Preserves (F (i + 1)) (F i)
    (complexIncoming (parameterKoszulComplex (K := K) γ) i))
  (hO : ∀ i, Preserves (F i) (F (i - 1))
    (complexOutgoing (parameterKoszulComplex (K := K) γ) i))

def parameterGradedHomologyNormalization (i n : ℕ) :
    coefficientGradedKoszulHomology γ F hD i n ≃ₗ[K]
      GradedHomology (F (i + 1)) (F i) (F (i - 1))
        (complexIncoming (parameterKoszulComplex (K := K) γ) i)
        (complexOutgoing (parameterKoszulComplex (K := K) γ) i)
        (hI i) (hO i) (complexIncomingOutgoing (parameterKoszulComplex (K := K) γ) i) n :=
  homologyIncomingNormalization K
    (gradeMap (F (i + 1)) (F i) (parameterKoszulDifferential (K := K) γ i) (hD i) n)
    (gradeMap (F (i + 1)) (F i)
      (complexIncoming (parameterKoszulComplex (K := K) γ) i) (hI i) n)
    (gradeMap (F i) (F (i - 1))
      (complexOutgoing (parameterKoszulComplex (K := K) γ) i) (hO i) n)
    (gradeMap_comp (F (i + 1)) (F i) (F (i - 1))
      (parameterKoszulDifferential (K := K) γ i)
      (complexOutgoing (parameterKoszulComplex (K := K) γ) i)
      (hD i) (hO i) (coefficientExteriorIncomingOutgoing γ i) n)
    (gradeMap_comp (F (i + 1)) (F i) (F (i - 1))
      (complexIncoming (parameterKoszulComplex (K := K) γ) i)
      (complexOutgoing (parameterKoszulComplex (K := K) γ) i)
      (hI i) (hO i) (complexIncomingOutgoing (parameterKoszulComplex (K := K) γ) i) n)
    (gradeMap_eq_of_eq K (F (i + 1)) (F i)
      (parameterKoszulDifferential (K := K) γ i)
      (complexIncoming (parameterKoszulComplex (K := K) γ) i)
      (hD i) (hI i) (parameterKoszulComplex_incoming_eq K γ i).symm n)
end ParameterNormalization

include hrank in
/-- The product defect is lower in the original coordinate filtration, not
merely in an auxiliary total-exterior filtration. -/
theorem canonicalKoszulCoefficientProduct_lower (i j r s : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (y : Set.powersetCard (Fin d) j →₀ BarycentricRing (P := P) K)
    (hx : x ∈ (barycentricKoszulFiltration (P := P) K d i).level (r + 1))
    (hy : y ∈ (barycentricKoszulFiltration (P := P) K d j).level (s + 1)) :
    canonicalKoszulCoefficientEquiv K hs d (i + j) (coefficientKoszulProduct (K := K) i j x y) -
      coefficientKoszulProduct (K := K) i j
        (canonicalKoszulCoefficientEquiv K hs d i x)
        (canonicalKoszulCoefficientEquiv K hs d j y) ∈
      (originalKoszulFiltration K hs d (i + j)).level (r + s) := by
  apply (originalKoszulFiltration_eq_exterior K hs d hrank (i + j) (r + s) _).mpr
  rw [map_sub,
    ← canonicalOriginalExteriorComparison_lift K hs d (i + j)
      (coefficientKoszulProduct (K := K) i j x y),
    coefficientKoszulProduct_lift (K := K) i j x y,
    coefficientKoszulProduct_lift (K := K) i j
      (canonicalKoszulCoefficientEquiv K hs d i x) (canonicalKoszulCoefficientEquiv K hs d j y),
    ← canonicalOriginalExteriorComparison_lift K hs d i x,
    ← canonicalOriginalExteriorComparison_lift K hs d j y]
  have hx' := (barycentricKoszulFiltration_eq_exterior K d hrank i (r + 1) x).mp hx
  have hy' := (barycentricKoszulFiltration_eq_exterior K d hrank j (s + 1) y).mp hy
  simpa only [Nat.cast_add, Nat.cast_one] using
    canonicalOriginalExteriorComparison_product_lower K hs d (r : ℤ) (s : ℤ)
      (coefficientExteriorLift (K := K) i x) (coefficientExteriorLift (K := K) j y)
      (by simpa only [Nat.cast_add, Nat.cast_one] using hx')
      (by simpa only [Nat.cast_add, Nat.cast_one] using hy')

def originalKoszulGradeProduct (i j r s : ℕ) :
    Grade (originalKoszulFiltration K hs d i) r →ₗ[K]
      Grade (originalKoszulFiltration K hs d j) s →ₗ[K]
        Grade (originalKoszulFiltration K hs d (i + j)) (r + s) :=
  gradeBilinearProduct (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d j)
    (originalKoszulFiltration K hs d (i + j))
    (coefficientKoszulProduct (K := K) (B := FaceRing K hs) (C := Fin d) i j)
    (originalKoszulProduct_filtered K hs d hrank i j) r s

def barycentricKoszulGradeProduct (i j r s : ℕ) :
    Grade (barycentricKoszulFiltration (P := P) K d i) r →ₗ[K]
      Grade (barycentricKoszulFiltration (P := P) K d j) s →ₗ[K]
        Grade (barycentricKoszulFiltration (P := P) K d (i + j)) (r + s) :=
  gradeBilinearProduct (barycentricKoszulFiltration (P := P) K d i)
    (barycentricKoszulFiltration (P := P) K d j) (barycentricKoszulFiltration (P := P) K d (i + j))
    (coefficientKoszulProduct (K := K) (B := BarycentricRing (P := P) K) (C := Fin d) i j)
    (barycentricKoszulProduct_filtered K d hrank i j) r s

theorem canonicalKoszulGradeComparison_multiplicative (i j r s : ℕ)
    (x : Grade (barycentricKoszulFiltration (P := P) K d i) r)
    (y : Grade (barycentricKoszulFiltration (P := P) K d j) s) :
    canonicalKoszulGradeComparison K hs d (i + j) (r + s)
        (barycentricKoszulGradeProduct K d hrank i j r s x y) =
      originalKoszulGradeProduct K hs d hrank i j r s
        (canonicalKoszulGradeComparison K hs d i r x)
        (canonicalKoszulGradeComparison K hs d j s y) := by
  change (canonicalKoszulGradeComparison K hs d (i + j) (r + s)).toLinearMap
      (barycentricKoszulGradeProduct K d hrank i j r s x y) =
    originalKoszulGradeProduct K hs d hrank i j r s
      ((canonicalKoszulGradeComparison K hs d i r).toLinearMap x)
      ((canonicalKoszulGradeComparison K hs d j s).toLinearMap y)
  simp only [canonicalKoszulGradeComparison, gradeEquiv_eq_gradeMap]
  exact gradeBilinearProduct_natural_of_lower_defect
    (barycentricKoszulFiltration (P := P) K d i) (barycentricKoszulFiltration (P := P) K d j)
    (barycentricKoszulFiltration (P := P) K d (i + j))
    (coefficientKoszulProduct (K := K) (B := BarycentricRing (P := P) K) (C := Fin d) i j)
    (barycentricKoszulProduct_filtered K d hrank i j)
    (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d j)
    (originalKoszulFiltration K hs d (i + j))
    (coefficientKoszulProduct (K := K) (B := FaceRing K hs) (C := Fin d) i j)
    (originalKoszulProduct_filtered K hs d hrank i j)
    (canonicalKoszulCoefficientEquiv K hs d i).toLinearMap
    (canonicalKoszulCoefficientEquiv K hs d j).toLinearMap
    (canonicalKoszulCoefficientEquiv K hs d (i + j)).toLinearMap
    (fun n x => (canonicalKoszulCoefficientEquiv_filtered K hs d i n x).mpr)
    (fun n y => (canonicalKoszulCoefficientEquiv_filtered K hs d j n y).mpr)
    (fun n z => (canonicalKoszulCoefficientEquiv_filtered K hs d (i + j) n z).mpr)
    (canonicalKoszulCoefficientProduct_lower K hs d hrank i j) r s x y

theorem koszulGradeComparison_multiplicative (i j r s : ℕ)
    (x : Grade (barycentricKoszulFiltration (P := P) K d i) r)
    (y : Grade (barycentricKoszulFiltration (P := P) K d j) s) :
    koszulGradeComparison K hs d hrank (i + j) (r + s)
        (barycentricKoszulGradeProduct K d hrank i j r s x y) =
      originalKoszulGradeProduct K hs d hrank i j r s
        (koszulGradeComparison K hs d hrank i r x)
        (koszulGradeComparison K hs d hrank j s y) := by
  simp only [koszulGradeComparison_eq_canonical]
  exact canonicalKoszulGradeComparison_multiplicative K hs d hrank i j r s x y

abbrev originalKoszulGradeCycles (i r : ℕ) :=
  LinearMap.ker (gradeMap (originalKoszulFiltration K hs d i)
    (originalKoszulFiltration K hs d (i - 1))
    (complexOutgoing (originalKoszulComplex K hs d) i)
    (originalOutgoing_preserves K hs d hrank i) r)

abbrev barycentricKoszulGradeCycles (i r : ℕ) :=
  LinearMap.ker (gradeMap (barycentricKoszulFiltration (P := P) K d i)
    (barycentricKoszulFiltration (P := P) K d (i - 1))
    (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
    (barycentricOutgoing_preserves K d i) r)

def originalKoszulGradeCycleProduct (i j r s : ℕ) :
    originalKoszulGradeCycles K hs d hrank i r →ₗ[K]
      originalKoszulGradeCycles K hs d hrank j s →ₗ[K]
        originalKoszulGradeCycles K hs d hrank (i + j) (r + s) :=
  coefficientGradedCycleProduct
    (fun k : Fin d => faceRankParameter K hs (k.val + 1))
    (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank)
    (originalKoszulDifferential_preserves K hs d hrank)
    (originalKoszulDifferential_liftsCycles K hs d hrank) i j r s

def barycentricKoszulGradeCycleProduct (i j r s : ℕ) :
    barycentricKoszulGradeCycles (P := P) K d i r →ₗ[K]
      barycentricKoszulGradeCycles (P := P) K d j s →ₗ[K]
        barycentricKoszulGradeCycles (P := P) K d (i + j) (r + s) :=
  coefficientGradedCycleProduct
    (fun k : Fin d => barycentricRankParameter (P := P) K (k.val + 1))
    (barycentricKoszulFiltration (P := P) K d) (barycentricKoszulProduct_filtered K d hrank)
    (barycentricKoszulDifferential_preserves K d)
    (barycentricKoszulDifferential_liftsCycles K d) i j r s

@[simp] theorem originalKoszulGradeCycleProduct_val (i j r s : ℕ)
    (x : originalKoszulGradeCycles K hs d hrank i r)
    (y : originalKoszulGradeCycles K hs d hrank j s) :
    (originalKoszulGradeCycleProduct K hs d hrank i j r s x y).val =
      originalKoszulGradeProduct K hs d hrank i j r s x.val y.val := rfl

@[simp] theorem barycentricKoszulGradeCycleProduct_val (i j r s : ℕ)
    (x : barycentricKoszulGradeCycles (P := P) K d i r)
    (y : barycentricKoszulGradeCycles (P := P) K d j s) :
    (barycentricKoszulGradeCycleProduct K d hrank i j r s x y).val =
      barycentricKoszulGradeProduct K d hrank i j r s x.val y.val := rfl

/-- Identity on cycles, with the coordinate incoming map explicitly
identified with the actual categorical incoming differential. -/
def originalCoefficientGradedHomologyEquiv (i n : ℕ) :
    coefficientGradedKoszulHomology
      (fun k : Fin d => faceRankParameter K hs (k.val + 1))
      (originalKoszulFiltration K hs d) (originalKoszulDifferential_preserves K hs d hrank) i n ≃ₗ[K]
      originalGradedKoszulHomology K hs d hrank i n :=
  parameterGradedHomologyNormalization K
    (fun k : Fin d => faceRankParameter K hs (k.val + 1))
    (originalKoszulFiltration K hs d) (originalKoszulDifferential_preserves K hs d hrank)
    (originalIncoming_preserves K hs d hrank) (originalOutgoing_preserves K hs d hrank) i n

def barycentricCoefficientGradedHomologyEquiv (i n : ℕ) :
    coefficientGradedKoszulHomology
      (fun k : Fin d => barycentricRankParameter (P := P) K (k.val + 1))
      (barycentricKoszulFiltration (P := P) K d) (barycentricKoszulDifferential_preserves K d) i n ≃ₗ[K]
      barycentricGradedKoszulHomology (P := P) K d i n :=
  parameterGradedHomologyNormalization K
    (fun k : Fin d => barycentricRankParameter (P := P) K (k.val + 1))
    (barycentricKoszulFiltration (P := P) K d) (barycentricKoszulDifferential_preserves K d)
    (barycentricIncoming_preserves K d) (barycentricOutgoing_preserves K d) i n

def originalGradedKoszulHomologyProduct (i j r s : ℕ) :
    originalGradedKoszulHomology K hs d hrank i r →ₗ[K]
      originalGradedKoszulHomology K hs d hrank j s →ₗ[K]
        originalGradedKoszulHomology K hs d hrank (i + j) (r + s) :=
  ((coefficientGradedHomologyProduct
      (fun k : Fin d => faceRankParameter K hs (k.val + 1))
      (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank)
      (originalKoszulDifferential_preserves K hs d hrank)
      (originalKoszulDifferential_liftsCycles K hs d hrank) i j r s).compl₁₂
    (originalCoefficientGradedHomologyEquiv K hs d hrank i r).symm.toLinearMap
    (originalCoefficientGradedHomologyEquiv K hs d hrank j s).symm.toLinearMap).compr₂
      (originalCoefficientGradedHomologyEquiv K hs d hrank (i + j) (r + s)).toLinearMap

def barycentricGradedKoszulHomologyProduct (i j r s : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i r →ₗ[K]
      barycentricGradedKoszulHomology (P := P) K d j s →ₗ[K]
        barycentricGradedKoszulHomology (P := P) K d (i + j) (r + s) :=
  ((coefficientGradedHomologyProduct
      (fun k : Fin d => barycentricRankParameter (P := P) K (k.val + 1))
      (barycentricKoszulFiltration (P := P) K d) (barycentricKoszulProduct_filtered K d hrank)
      (barycentricKoszulDifferential_preserves K d)
      (barycentricKoszulDifferential_liftsCycles K d) i j r s).compl₁₂
    (barycentricCoefficientGradedHomologyEquiv (P := P) K d i r).symm.toLinearMap
    (barycentricCoefficientGradedHomologyEquiv (P := P) K d j s).symm.toLinearMap).compr₂
      (barycentricCoefficientGradedHomologyEquiv (P := P) K d (i + j) (r + s)).toLinearMap

@[simp] theorem originalGradedKoszulHomologyProduct_class (i j r s : ℕ)
    (x : originalKoszulGradeCycles K hs d hrank i r)
    (y : originalKoszulGradeCycles K hs d hrank j s) :
    originalGradedKoszulHomologyProduct K hs d hrank i j r s
        (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _ (originalKoszulGradeCycleProduct K hs d hrank i j r s x y) := by
  rfl

@[simp] theorem barycentricGradedKoszulHomologyProduct_class (i j r s : ℕ)
    (x : barycentricKoszulGradeCycles (P := P) K d i r)
    (y : barycentricKoszulGradeCycles (P := P) K d j s) :
    barycentricGradedKoszulHomologyProduct K d hrank i j r s
        (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _ (barycentricKoszulGradeCycleProduct K d hrank i j r s x y) := by
  rfl

def koszulGradeCycleComparison (i r : ℕ) :
    barycentricKoszulGradeCycles (P := P) K d i r →ₗ[K]
      originalKoszulGradeCycles K hs d hrank i r where
  toFun x := ⟨koszulGradeComparison K hs d hrank i r x.val, by
    have h := gradeEquiv_commutes
      (barycentricKoszulFiltration (P := P) K d i) (barycentricKoszulFiltration (P := P) K d (i - 1))
      (originalKoszulFiltration K hs d i) (originalKoszulFiltration K hs d (i - 1))
      (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
      (complexOutgoing (originalKoszulComplex K hs d) i)
      (barycentricOutgoing_preserves K d i) (originalOutgoing_preserves K hs d hrank i)
      (originalKoszulCoefficientEquiv K hs d hrank i)
      (originalKoszulCoefficientEquiv K hs d hrank (i - 1))
      (originalKoszulCoefficientEquiv_filtered K hs d hrank i)
      (originalKoszulCoefficientEquiv_filtered K hs d hrank (i - 1))
      (coefficientEquiv_outgoing_commutes K hs d hrank i) r x.val
    rw [x.property, map_zero] at h
    exact h⟩
  map_add' x y := Subtype.ext (map_add _ x.val y.val)
  map_smul' c x := Subtype.ext (map_smul _ c x.val)

@[simp] theorem koszulGradedHomologyComparison_class (i r : ℕ)
    (x : barycentricKoszulGradeCycles (P := P) K d i r) :
    koszulGradedHomologyComparison K hs d hrank i r (homologyClass _ _ _ x) =
      homologyClass _ _ _ (koszulGradeCycleComparison K hs d hrank i r x) := rfl

/-- The canonical coefficient comparison preserves the independently induced
products on the actual associated-grade Koszul homology. -/
theorem koszulGradedHomologyComparison_multiplicative (i j r s : ℕ)
    (x : barycentricGradedKoszulHomology (P := P) K d i r)
    (y : barycentricGradedKoszulHomology (P := P) K d j s) :
    koszulGradedHomologyComparison K hs d hrank (i + j) (r + s)
        (barycentricGradedKoszulHomologyProduct K d hrank i j r s x y) =
      originalGradedKoszulHomologyProduct K hs d hrank i j r s
        (koszulGradedHomologyComparison K hs d hrank i r x)
        (koszulGradedHomologyComparison K hs d hrank j s y) := by
  obtain ⟨x', hx⟩ := gradedHomologyClass_surjective K
    (barycentricKoszulFiltration (P := P) K d (i + 1))
    (barycentricKoszulFiltration (P := P) K d i)
    (barycentricKoszulFiltration (P := P) K d (i - 1))
    (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
    (complexOutgoing (barycentricKoszulComplex (P := P) K d) i)
    (barycentricIncoming_preserves K d i) (barycentricOutgoing_preserves K d i)
    (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) i) r x
  obtain ⟨y', hy⟩ := gradedHomologyClass_surjective K
    (barycentricKoszulFiltration (P := P) K d (j + 1))
    (barycentricKoszulFiltration (P := P) K d j)
    (barycentricKoszulFiltration (P := P) K d (j - 1))
    (complexIncoming (barycentricKoszulComplex (P := P) K d) j)
    (complexOutgoing (barycentricKoszulComplex (P := P) K d) j)
    (barycentricIncoming_preserves K d j) (barycentricOutgoing_preserves K d j)
    (complexIncomingOutgoing (barycentricKoszulComplex (P := P) K d) j) s y
  have hcycle : koszulGradeCycleComparison K hs d hrank (i + j) (r + s)
      (barycentricKoszulGradeCycleProduct K d hrank i j r s x' y') =
    originalKoszulGradeCycleProduct K hs d hrank i j r s
      (koszulGradeCycleComparison K hs d hrank i r x')
      (koszulGradeCycleComparison K hs d hrank j s y') := by
    apply Subtype.ext
    exact koszulGradeComparison_multiplicative K hs d hrank i j r s x'.val y'.val
  have h₃ := congrArg (homologyClass
    (gradeMap (originalKoszulFiltration K hs d (i + j + 1))
      (originalKoszulFiltration K hs d (i + j))
      (complexIncoming (originalKoszulComplex K hs d) (i + j))
      (originalIncoming_preserves K hs d hrank (i + j)) (r + s))
    (gradeMap (originalKoszulFiltration K hs d (i + j))
      (originalKoszulFiltration K hs d (i + j - 1))
      (complexOutgoing (originalKoszulComplex K hs d) (i + j))
      (originalOutgoing_preserves K hs d hrank (i + j)) (r + s))
    (gradeMap_comp (originalKoszulFiltration K hs d (i + j + 1))
      (originalKoszulFiltration K hs d (i + j))
      (originalKoszulFiltration K hs d (i + j - 1))
      (complexIncoming (originalKoszulComplex K hs d) (i + j))
      (complexOutgoing (originalKoszulComplex K hs d) (i + j))
      (originalIncoming_preserves K hs d hrank (i + j))
      (originalOutgoing_preserves K hs d hrank (i + j))
      (complexIncomingOutgoing (originalKoszulComplex K hs d) (i + j)) (r + s))) hcycle
  have h₁ := congrArg (fun z => koszulGradedHomologyComparison K hs d hrank
      (i + j) (r + s) z)
    (barycentricGradedKoszulHomologyProduct_class K d hrank i j r s x' y')
  have h₂ := koszulGradedHomologyComparison_class K hs d hrank (i + j) (r + s)
    (barycentricKoszulGradeCycleProduct K d hrank i j r s x' y')
  have h₄ := (originalGradedKoszulHomologyProduct_class K hs d hrank i j r s
    (koszulGradeCycleComparison K hs d hrank i r x')
    (koszulGradeCycleComparison K hs d hrank j s y')).symm
  have h₅ := congrArg₂ (fun z w => originalGradedKoszulHomologyProduct K hs d hrank i j r s z w)
    (koszulGradedHomologyComparison_class K hs d hrank i r x').symm
    (koszulGradedHomologyComparison_class K hs d hrank j s y').symm
  have hrep := h₁.trans (h₂.trans (h₃.trans (h₄.trans h₅)))
  have hin := congrArg₂ (fun z w => koszulGradedHomologyComparison K hs d hrank
      (i + j) (r + s) (barycentricGradedKoszulHomologyProduct K d hrank i j r s z w)) hx hy
  have hout := congrArg₂ (fun z w => originalGradedKoszulHomologyProduct K hs d hrank i j r s
      (koszulGradedHomologyComparison K hs d hrank i r z)
      (koszulGradedHomologyComparison K hs d hrank j s w)) hx hy
  exact hin.symm.trans (hrep.trans hout)

def originalCoefficientHomologyGradeEquiv (i n : ℕ) :
    Grade (coefficientHomologyFiltration
      (fun k : Fin d => faceRankParameter K hs (k.val + 1)) (originalKoszulFiltration K hs d) i) n ≃ₗ[K]
      Grade (originalKoszulHomologyFiltration K hs d i) n :=
  parameterHomologyGradeNormalization K
    (fun k : Fin d => faceRankParameter K hs (k.val + 1)) (originalKoszulFiltration K hs d) i n

def originalAssociatedHomologyProduct (i j r s : ℕ) :
    Grade (originalKoszulHomologyFiltration K hs d i) r →ₗ[K]
      Grade (originalKoszulHomologyFiltration K hs d j) s →ₗ[K]
        Grade (originalKoszulHomologyFiltration K hs d (i + j)) (r + s) :=
  ((coefficientHomologyGradeProduct
      (fun k : Fin d => faceRankParameter K hs (k.val + 1))
      (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i j r s).compl₁₂
    (originalCoefficientHomologyGradeEquiv K hs d i r).symm.toLinearMap
    (originalCoefficientHomologyGradeEquiv K hs d j s).symm.toLinearMap).compr₂
      (originalCoefficientHomologyGradeEquiv K hs d (i + j) (r + s)).toLinearMap

def originalFilteredKoszulCycleProduct (i j r s : ℕ) :
    cycleLevel (originalKoszulFiltration K hs d i)
        (complexOutgoing (originalKoszulComplex K hs d) i) (r + 1) →ₗ[K]
      cycleLevel (originalKoszulFiltration K hs d j)
        (complexOutgoing (originalKoszulComplex K hs d) j) (s + 1) →ₗ[K]
        cycleLevel (originalKoszulFiltration K hs d (i + j))
          (complexOutgoing (originalKoszulComplex K hs d) (i + j)) (r + s + 1) :=
  coefficientFilteredCycleProduct
    (fun k : Fin d => faceRankParameter K hs (k.val + 1))
    (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i j r s

theorem originalAssociatedHomologyProduct_class (i j r s : ℕ)
    (x : cycleLevel (originalKoszulFiltration K hs d i)
      (complexOutgoing (originalKoszulComplex K hs d) i) (r + 1))
    (y : cycleLevel (originalKoszulFiltration K hs d j)
      (complexOutgoing (originalKoszulComplex K hs d) j) (s + 1)) :
    originalAssociatedHomologyProduct K hs d hrank i j r s
        (filteredHomologyClass (originalKoszulFiltration K hs d i) _
          (complexOutgoing (originalKoszulComplex K hs d) i)
          (complexIncomingOutgoing (originalKoszulComplex K hs d) i) r x)
        (filteredHomologyClass (originalKoszulFiltration K hs d j) _
          (complexOutgoing (originalKoszulComplex K hs d) j)
          (complexIncomingOutgoing (originalKoszulComplex K hs d) j) s y) =
      filteredHomologyClass (originalKoszulFiltration K hs d (i + j)) _
        (complexOutgoing (originalKoszulComplex K hs d) (i + j))
        (complexIncomingOutgoing (originalKoszulComplex K hs d) (i + j)) (r + s)
        (originalFilteredKoszulCycleProduct K hs d hrank i j r s x y) := by
  rfl

theorem originalKoszulAssociatedHomology_multiplicative (i j r s : ℕ)
    (x : Grade (originalKoszulHomologyFiltration K hs d i) r)
    (y : Grade (originalKoszulHomologyFiltration K hs d j) s) :
    originalKoszulAssociatedHomology K hs d hrank (i + j) (r + s)
        (originalAssociatedHomologyProduct K hs d hrank i j r s x y) =
      originalGradedKoszulHomologyProduct K hs d hrank i j r s
        (originalKoszulAssociatedHomology K hs d hrank i r x)
        (originalKoszulAssociatedHomology K hs d hrank j s y) := by
  obtain ⟨x', hx⟩ := filteredHomologyClass_surjective (originalKoszulFiltration K hs d i)
    (complexIncoming (originalKoszulComplex K hs d) i)
    (complexOutgoing (originalKoszulComplex K hs d) i)
    (complexIncomingOutgoing (originalKoszulComplex K hs d) i) r x
  obtain ⟨y', hy⟩ := filteredHomologyClass_surjective (originalKoszulFiltration K hs d j)
    (complexIncoming (originalKoszulComplex K hs d) j)
    (complexOutgoing (originalKoszulComplex K hs d) j)
    (complexIncomingOutgoing (originalKoszulComplex K hs d) j) s y
  have h₁ := congrArg (fun z => originalKoszulAssociatedHomology K hs d hrank
      (i + j) (r + s) z)
    (originalAssociatedHomologyProduct_class K hs d hrank i j r s x' y')
  have h₂ := originalKoszulAssociatedHomology_class K hs d hrank (i + j) (r + s)
    (originalFilteredKoszulCycleProduct K hs d hrank i j r s x' y')
  have h₃ := (originalGradedKoszulHomologyProduct_class K hs d hrank i j r s
    (cycleToGradeCycle (originalKoszulFiltration K hs d i)
      (originalKoszulFiltration K hs d (i - 1))
      (complexOutgoing (originalKoszulComplex K hs d) i)
      (originalOutgoing_preserves K hs d hrank i) r x')
    (cycleToGradeCycle (originalKoszulFiltration K hs d j)
      (originalKoszulFiltration K hs d (j - 1))
      (complexOutgoing (originalKoszulComplex K hs d) j)
      (originalOutgoing_preserves K hs d hrank j) s y')).symm
  have h₄ := congrArg₂ (fun z w => originalGradedKoszulHomologyProduct K hs d hrank i j r s z w)
    (originalKoszulAssociatedHomology_class K hs d hrank i r x').symm
    (originalKoszulAssociatedHomology_class K hs d hrank j s y').symm
  have hrep := h₁.trans (h₂.trans (h₃.trans h₄))
  have hin := congrArg₂ (fun z w => originalKoszulAssociatedHomology K hs d hrank
      (i + j) (r + s) (originalAssociatedHomologyProduct K hs d hrank i j r s z w)) hx hy
  have hout := congrArg₂ (fun z w => originalGradedKoszulHomologyProduct K hs d hrank i j r s
      (originalKoszulAssociatedHomology K hs d hrank i r z)
      (originalKoszulAssociatedHomology K hs d hrank j s w)) hx hy
  exact hin.symm.trans (hrep.trans hout)

/-- Multiplicativity of the same intrinsic canonical comparison used in the
associated-homology theorem, in every pair of homological and weight degrees. -/
theorem originalAssociatedBarycentricHomology_multiplicative (i j r s : ℕ)
    (x : Grade (originalKoszulHomologyFiltration K hs d i) r)
    (y : Grade (originalKoszulHomologyFiltration K hs d j) s) :
    originalAssociatedBarycentricHomology K hs d hrank (i + j) (r + s)
        (originalAssociatedHomologyProduct K hs d hrank i j r s x y) =
      barycentricGradedKoszulHomologyProduct K d hrank i j r s
        (originalAssociatedBarycentricHomology K hs d hrank i r x)
        (originalAssociatedBarycentricHomology K hs d hrank j s y) := by
  apply (koszulGradedHomologyComparison K hs d hrank (i + j) (r + s)).injective
  rw [koszulGradedHomologyComparison_multiplicative]
  simp only [originalAssociatedBarycentricHomology, LinearEquiv.trans_apply,
    LinearEquiv.apply_symm_apply]
  exact originalKoszulAssociatedHomology_multiplicative K hs d hrank i j r s x y

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RankColoredBridge -/
section

/-! # The rank-colored order complex is the actual barycentric face ring

These identifications use the quotient presentations themselves.  They identify
color sums with the rank parameters and monomials with the canonical chain basis.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical Finset MvPolynomial
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K : Type*) [CommRing K] (hs : IsSimplicialPoset P)
variable (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

/-- The two independently defined forbidden-monomial ideals agree. -/
def rankColoredRingEquiv :
    (rankColoredOrderComplex hs d hrank).Ring K ≃ₐ[K] BarycentricRing (P := P) K :=
  (barycentricPresentationEquiv K).symm

@[simp] theorem rankColoredRingEquiv_mk (f : FacePolynomial (P := P) K) :
    rankColoredRingEquiv K hs d hrank
      (Ideal.Quotient.mk (forbiddenIdeal (rankColoredOrderComplex hs d hrank).allowed) f) =
      Ideal.Quotient.mk (barycentricIdeal K) f := rfl

@[simp] theorem rankColoredRingEquiv_monomial (a : NonzeroFace P →₀ ℕ) :
    rankColoredRingEquiv K hs d hrank
      ((rankColoredOrderComplex hs d hrank).monomial K a) =
      Ideal.Quotient.mk (barycentricIdeal K) (monomial a 1) := rfl

@[simp] theorem rankColored_monomial_basis (a : StandardFaceIndex P) :
    rankColoredRingEquiv K hs d hrank
      ((rankColoredOrderComplex hs d hrank).monomial K a.val) =
      barycentricGlobalStandardBasis K a :=
  barycentricGlobalStandardBasis_monomial K a

/-- Rank `i+1` is exactly color `i`; the bottom face contributes to neither sum. -/
theorem rankColored_parameter (i : Fin d) :
    rankColoredRingEquiv K hs d hrank
      ((rankColoredOrderComplex hs d hrank).colorParameter K i) =
      barycentricRankParameter K (i.val + 1) := by
  classical
  letI : DecidableEq (Fin d) := Classical.decEq (Fin d)
  unfold ProperlyColoredComplex.colorParameter barycentricRankParameter
  rw [map_sum]
  apply Finset.sum_bij (fun p _ => p.val)
  · intro p hp
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
    have hc := congrArg Fin.val (Finset.mem_filter.mp hp).2
    have hpos : 0 < faceRank p.val := by
      simpa only [faceRank_bot] using
        (faceRank_strictMono hs) (bot_lt_iff_ne_bot.mpr p.property)
    change faceRank p.val - 1 = i.val at hc
    omega
  · intro p hp q hq hpq
    exact Subtype.ext hpq
  · intro p hp
    have hpr := (Finset.mem_filter.mp hp).2
    have hpb : p ≠ ⊥ := by
      intro h
      rw [h, faceRank_bot] at hpr
      omega
    refine ⟨⟨p, hpb⟩, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, rfl⟩
    apply Fin.ext
    change faceRank p - 1 = i.val
    omega
  · intro p hp
    change Ideal.Quotient.mk (barycentricIdeal K) (X p) =
      Ideal.Quotient.mk (barycentricIdeal K) (faceSymbol K p.val)
    rw [faceSymbol_nonzero]

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ColorfulRelativeModule -/
section

/-! # The actual relative face module and its monomial basis

The relative module is the kernel of the ordinary quotient restriction from
the face ring of Λ to the face ring of a downward subcomplex Λ₀. The subcomplex
is permitted to be void. Its basis and parameter operators are derived on
this actual kernel, rather than introduced as a replacement model.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset MvPolynomial

variable {V C K : Type*} [Fintype V] [Fintype C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C)

/-- A downward subcomplex, including the void complex (no empty face). -/
structure Subcomplex where
  face : Finset V → Prop
  downward : ∀ ⦃s t : Finset V⦄, s ⊆ t → face t → face s
  subface : ∀ s, face s → D.face s

namespace Subcomplex
variable {D} (Q : D.Subcomplex)

def toColoredComplex : FourPapers.Universal.ProperlyColoredComplex V C where
  face := Q.face
  downward := Q.downward
  color := D.color
  proper s hs := D.proper s (Q.subface s hs)

theorem allowed_le (a : V →₀ ℕ) (ha : Q.toColoredComplex.allowed a) : D.allowed a :=
  Q.subface a.support ha

theorem forbiddenIdeal_le (K : Type*) [CommRing K] :
    forbiddenIdeal (K := K) D.allowed ≤ forbiddenIdeal Q.toColoredComplex.allowed := by
  apply Ideal.span_le.mpr
  rintro x ⟨a, ha, rfl⟩
  exact Ideal.subset_span ⟨a, (fun h => ha (Q.allowed_le a h)), rfl⟩

/-- Restriction between the two original quotient rings. -/
def restriction (K : Type*) [CommRing K] : D.Ring K →ₐ[K] Q.toColoredComplex.Ring K :=
  Ideal.Quotient.factorₐ K (Q.forbiddenIdeal_le K)

@[simp] theorem restriction_mk (f : MvPolynomial V K) :
    Q.restriction K (Ideal.Quotient.mk (forbiddenIdeal D.allowed) f) =
      Ideal.Quotient.mk (forbiddenIdeal Q.toColoredComplex.allowed) f := rfl

theorem restriction_monomial (a : V →₀ ℕ) :
    Q.restriction K (D.monomial K a) = Q.toColoredComplex.monomial K a := rfl

theorem restriction_colorParameter (i : C) :
    Q.restriction K (D.colorParameter K i) = Q.toColoredComplex.colorParameter K i := by
  rw [colorParameter, map_sum]
  rfl

/-- The conventional relative face module, literally a restriction kernel. -/
abbrev Relative (K : Type*) [CommRing K] := LinearMap.ker (Q.restriction K).toLinearMap

abbrev RelativeIndex := {a : {a : V →₀ ℕ // D.allowed a} // ¬ Q.face a.val.support}

abbrev RelativeFaceWithColors (S : Finset C) :=
  {s : Finset V // D.face s ∧ ¬ Q.face s ∧ s.image D.color = S}

abbrev RelativeMonomialOfColorDegree (β : C →₀ ℕ) :=
  {a : V →₀ ℕ // D.allowed a ∧ ¬ Q.face a.support ∧ D.colorDegree a = β}

/-- The genuine color-degree indices of the relative kernel correspond to
faces of the simplicial pair with exactly the positive colors. -/
def relativeMonomialColorEquiv (β : C →₀ ℕ) :
    Q.RelativeMonomialOfColorDegree β ≃ Q.RelativeFaceWithColors β.support where
  toFun a := ⟨a.val.support, a.property.1, a.property.2.1, by
    rw [← D.colorDegree_support, a.property.2.2]⟩
  invFun s :=
    let t : D.FaceWithColors β.support := ⟨s.val, s.property.1, s.property.2.2⟩
    ⟨D.exponentOnFace β s.val, D.exponentOnFace_allowed β t,
      (by
        have hs : (D.exponentOnFace β s.val).support = s.val :=
          D.exponentOnFace_support β ⟨s.val, s.property.1, s.property.2.2⟩
        exact fun h => s.property.2.1 (hs ▸ h)),
      D.exponentOnFace_colorDegree β t⟩
  left_inv a := by
    apply Subtype.ext
    change D.exponentOnFace β a.val.support = a.val
    ext v
    rw [D.exponentOnFace_apply]
    by_cases hv : v ∈ a.val.support
    · rw [if_pos hv]
      have hh := congrArg (fun γ : C →₀ ℕ => γ (D.color v)) a.property.2.2
      exact hh.symm.trans (D.colorDegree_at_vertex a.val a.property.1 v hv)
    · rw [if_neg hv, Finsupp.notMem_support_iff.mp hv]
  right_inv s := by
    apply Subtype.ext
    exact D.exponentOnFace_support β ⟨s.val, s.property.1, s.property.2.2⟩

theorem restriction_coordinates (x : D.Ring K)
    (a : {a : V →₀ ℕ // Q.toColoredComplex.allowed a}) :
    standardMonomialEquiv Q.toColoredComplex.allowed Q.toColoredComplex.allowed_divisorClosed
        (Q.restriction K x) a =
      standardMonomialEquiv D.allowed D.allowed_divisorClosed x
        ⟨a.val, Q.allowed_le a.val a.property⟩ := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

theorem relative_mem_iff (x : D.Ring K) :
    x ∈ Q.Relative K ↔
      ∀ a : {a : V →₀ ℕ // D.allowed a}, Q.face a.val.support →
        standardMonomialEquiv D.allowed D.allowed_divisorClosed x a = 0 := by
  constructor
  · intro hx a ha
    have hh := Q.restriction_coordinates x ⟨a.val, ha⟩
    change Q.restriction K x = 0 at hx
    rw [hx, LinearEquiv.map_zero, Finsupp.zero_apply] at hh
    exact hh.symm
  · intro hx
    change Q.restriction K x = 0
    apply (standardMonomialEquiv Q.toColoredComplex.allowed
      Q.toColoredComplex.allowed_divisorClosed).injective
    ext a
    rw [Q.restriction_coordinates, LinearEquiv.map_zero, Finsupp.zero_apply]
    exact hx _ a.property

/-- Actual kernel elements are exactly the coordinates supported outside the
subcomplex, in the already-proved standard monomial basis. -/
def relativeSupportedEquiv (K : Type*) [CommRing K] :
    Q.Relative K ≃ₗ[K]
      Finsupp.supported K K {a : {a : V →₀ ℕ // D.allowed a} | ¬ Q.face a.val.support} where
  toFun x := ⟨standardMonomialEquiv D.allowed D.allowed_divisorClosed x.val, by
    rw [Finsupp.mem_supported']
    intro a ha
    exact (Q.relative_mem_iff x.val).mp x.property a (by simpa using ha)⟩
  invFun x := ⟨(standardMonomialEquiv D.allowed D.allowed_divisorClosed).symm x.val, by
    rw [Q.relative_mem_iff]
    intro a ha
    rw [LinearEquiv.apply_symm_apply]
    exact (Finsupp.mem_supported' K x.val).mp x.property a (by simpa using ha)⟩
  left_inv x := by
    apply Subtype.ext
    exact LinearEquiv.symm_apply_apply _ x.val
  right_inv x := by
    apply Subtype.ext
    exact LinearEquiv.apply_symm_apply _ x.val
  map_add' x y := by
    apply Subtype.ext
    exact map_add (standardMonomialEquiv D.allowed D.allowed_divisorClosed) x.val y.val
  map_smul' c x := by
    apply Subtype.ext
    exact map_smul (standardMonomialEquiv D.allowed D.allowed_divisorClosed) c x.val

def relativeCoordinates (K : Type*) [CommRing K] :
    Q.Relative K ≃ₗ[K] (Q.RelativeIndex →₀ K) :=
  (Q.relativeSupportedEquiv K).trans
    (Finsupp.supportedEquivFinsupp
      {a : {a : V →₀ ℕ // D.allowed a} | ¬ Q.face a.val.support})

def relativeBasis (K : Type*) [CommRing K] : Module.Basis Q.RelativeIndex K (Q.Relative K) :=
  Finsupp.basisSingleOne.map (Q.relativeCoordinates K).symm

theorem relative_monomial_mem (a : Q.RelativeIndex) : D.monomial K a.val.val ∈ Q.Relative K := by
  change Q.restriction K (D.monomial K a.val.val) = 0
  rw [Q.restriction_monomial]
  exact Q.toColoredComplex.monomial_eq_zero_of_forbidden K a.val.val a.property

/-- The resulting basis vectors are precisely the surviving relative monomials
inside the original ambient face ring. -/
theorem relativeBasis_apply (a : Q.RelativeIndex) :
    (Q.relativeBasis K a).val = D.monomial K a.val.val := by
  apply (standardMonomialEquiv D.allowed D.allowed_divisorClosed).injective
  change standardMonomialEquiv D.allowed D.allowed_divisorClosed
      ((Q.relativeCoordinates K).symm (Finsupp.single a 1)).val =
    standardMonomialEquiv D.allowed D.allowed_divisorClosed (D.monomial K a.val.val)
  have hm : standardMonomialEquiv D.allowed D.allowed_divisorClosed
      (D.monomial K a.val.val) = Finsupp.single a.val (1 : K) := by
    change standardMonomialEquiv D.allowed D.allowed_divisorClosed
      (Ideal.Quotient.mk (forbiddenIdeal D.allowed) (MvPolynomial.monomial a.val.val 1)) = _
    rw [← standardMonomialBasis_apply D.allowed D.allowed_divisorClosed a.val]
    exact (standardMonomialBasis D.allowed D.allowed_divisorClosed).repr_self a.val
  rw [hm]
  change standardMonomialEquiv D.allowed D.allowed_divisorClosed
    ((standardMonomialEquiv D.allowed D.allowed_divisorClosed).symm
      ((Finsupp.supportedEquivFinsupp (R := K) (M := K) _).symm
        (Finsupp.single a (1 : K))).val) = _
  rw [LinearEquiv.apply_symm_apply]
  exact Finsupp.supportedEquivFinsupp_symm_single (R := K) _ a (1 : K)

theorem colorParameter_mul_mem (i : C) (x : D.Ring K) (hx : x ∈ Q.Relative K) :
    D.colorParameter K i * x ∈ Q.Relative K := by
  change Q.restriction K (D.colorParameter K i * x) = 0
  change Q.restriction K x = 0 at hx
  rw [map_mul, hx, mul_zero]

/-- Rank/color parameter multiplication on the actual relative kernel. -/
def relativeColorOperator (K : Type*) [CommRing K] (i : C) : Module.End K (Q.Relative K) where
  toFun x := ⟨D.colorParameter K i * x.val, Q.colorParameter_mul_mem i x.val x.property⟩
  map_add' x y := by
    apply Subtype.ext
    exact mul_add _ _ _
  map_smul' c x := by
    apply Subtype.ext
    change D.colorParameter K i * (c • x.val) = c • (D.colorParameter K i * x.val)
    exact mul_smul_comm _ _ _

@[simp] theorem relativeColorOperator_val (i : C) (x : Q.Relative K) :
    (Q.relativeColorOperator K i x).val = D.colorParameter K i * x.val := rfl

theorem relativeColorOperator_commute (i j : C) :
    Function.Commute (Q.relativeColorOperator K i) (Q.relativeColorOperator K j) := by
  intro x
  apply Subtype.ext
  exact mul_left_comm _ _ _

end Subcomplex
end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.RankColoredRelativeBridge -/
section

/-! # Lower ideals and genuine relative rank-colored face modules

The empty lower ideal gives the void subcomplex and the whole relative module.
For every other lower ideal, the construction is its usual order complex.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical
variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K : Type*) [CommRing K] (hs : IsSimplicialPoset P)
variable (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

/-- The actual order subcomplex, with the void convention when `Q` is empty. -/
def rankColoredSubcomplex (Q : Set P) : (rankColoredOrderComplex hs d hrank).Subcomplex where
  face s := (⊥ : P) ∈ Q ∧ (rankColoredOrderComplex hs d hrank).face s ∧
    ∀ p ∈ s, p.val ∈ Q
  downward := by
    intro s t hst ht
    exact ⟨ht.1, (rankColoredOrderComplex hs d hrank).downward hst ht.2.1,
      fun p hp => ht.2.2 p (hst hp)⟩
  subface s hs := hs.2.1

@[simp] theorem rankColoredSubcomplex_empty_face (s : Finset (NonzeroFace P)) :
    ¬ (rankColoredSubcomplex hs d hrank (∅ : Set P)).face s := by
  rintro ⟨h, _⟩
  exact h

/-- On a chain, membership in the lower ideal is detected by its actual carrier. -/
lemma rankColoredSubcomplex_face_iff (Q : Set P)
    (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q) (a : StandardFaceIndex P) :
    (rankColoredSubcomplex hs d hrank Q).face a.val.support ↔ standardCarrier a ∈ Q := by
  constructor
  · intro h
    rcases standardCarrier_mem_or_bot a with hb | ⟨p, hp, he⟩
    · simpa only [hb] using h.1
    · rw [he]
      exact h.2.2 p hp
  · intro h
    refine ⟨hQ bot_le h, a.property, ?_⟩
    intro p hp
    exact hQ ((standardCarrier_le_iff hs a _).mp le_rfl p hp) h

lemma rankColoredRingEquiv_coordinates
    (x : (rankColoredOrderComplex hs d hrank).Ring K) :
    barycentricMonomialEquiv K (rankColoredRingEquiv K hs d hrank x) =
      standardMonomialEquiv (rankColoredOrderComplex hs d hrank).allowed
        (rankColoredOrderComplex hs d hrank).allowed_divisorClosed x := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- The relative colored module maps to the paper's actual restriction ideal. -/
lemma rankColored_relative_mem_iff (Q : Set P)
    (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
    (x : (rankColoredOrderComplex hs d hrank).Ring K) :
    x ∈ (rankColoredSubcomplex hs d hrank Q).Relative K ↔
      rankColoredRingEquiv K hs d hrank x ∈ barycentricRestrictionIdeal K Q := by
  rw [ProperlyColoredComplex.Subcomplex.relative_mem_iff,
    barycentricRestrictionIdeal_mem_iff_coefficient K hs Q hQ,
    rankColoredRingEquiv_coordinates]
  constructor
  · intro h a ha
    exact h a ((rankColoredSubcomplex_face_iff hs d hrank Q hQ a).mpr ha)
  · intro h a ha
    exact h a ((rankColoredSubcomplex_face_iff hs d hrank Q hQ a).mp ha)

def rankColoredRelativeEquiv (Q : Set P)
    (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q) :
    (rankColoredSubcomplex hs d hrank Q).Relative K ≃ₗ[K]
      (barycentricRestrictionIdeal K Q).restrictScalars K where
  toFun x := ⟨rankColoredRingEquiv K hs d hrank x.val,
    (rankColored_relative_mem_iff K hs d hrank Q hQ x.val).mp x.property⟩
  invFun y := ⟨(rankColoredRingEquiv K hs d hrank).symm y.val,
    (rankColored_relative_mem_iff K hs d hrank Q hQ _).mpr (by
      rw [AlgEquiv.apply_symm_apply]
      exact y.property)⟩
  left_inv x := Subtype.ext ((rankColoredRingEquiv K hs d hrank).symm_apply_apply x.val)
  right_inv y := Subtype.ext ((rankColoredRingEquiv K hs d hrank).apply_symm_apply y.val)
  map_add' x y := Subtype.ext (map_add (rankColoredRingEquiv K hs d hrank) x.val y.val)
  map_smul' c x := Subtype.ext (map_smul (rankColoredRingEquiv K hs d hrank).toLinearMap c x.val)

lemma rankColoredRelativeEquiv_parameter (Q : Set P)
    (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q) (i : Fin d)
    (x : (rankColoredSubcomplex hs d hrank Q).Relative K) :
    (rankColoredRelativeEquiv K hs d hrank Q hQ
      ((rankColoredSubcomplex hs d hrank Q).relativeColorOperator K i x)).val =
      barycentricRankParameter K (i.val + 1) * (rankColoredRelativeEquiv K hs d hrank Q hQ x).val := by
  change rankColoredRingEquiv K hs d hrank
    ((rankColoredOrderComplex hs d hrank).colorParameter K i * x.val) = _
  rw [map_mul, rankColored_parameter]
  rfl

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.KoszulScalarHomotopy -/
section

/-! # Scalar null-homotopies in the actual coefficient Koszul complex

The homotopy is the ordinary exterior multiplication homotopy, transported
through the identity comparison with the checked contraction complex and
through the genuine exterior-basis coordinates.  No homology is postulated.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory CommAlg
open scoped TensorProduct
universe u
variable {R : Type u} {V : Type} [CommRing R] [Fintype V] [LinearOrder V]

/-- Mathlib's Koszul differential is the checked exterior contraction. -/
def koszulContractionIso (x : V → R) :
    _root_.koszulComplex (Fintype.linearCombination R x) ≅
      TauCeti.koszulComplex (Fintype.linearCombination R x) :=
  HomologicalComplex.Hom.isoOfComponents (fun _ => Iso.refl _) (by
    intro i j hij
    obtain rfl : i = j + 1 := hij.symm
    simp only [Iso.refl_hom, Category.id_comp, Category.comp_id,
      koszulComplex.d_eq_d, TauCeti.koszulComplex_d]
    exact ModuleCat.hom_ext (Koszul.differential_eq_contraction _ j).symm)

def ordinaryKoszulSmulHomotopy (x : V → R) (v : V) :
    Homotopy (x v • 𝟙 (_root_.koszulComplex (Fintype.linearCombination R x))) 0 := by
  let e := koszulContractionIso x
  have h := ((TauCeti.koszulComplex.smulHomotopy
    (Fintype.linearCombination R x) ((Pi.basisFun R V) v)).compLeft e.hom).compRight e.inv
  have hv : (Fintype.linearCombination R x) ((Pi.basisFun R V) v) = x v := by
    simp [Fintype.linearCombination_apply, Pi.basisFun_apply, Pi.single_apply, ite_mul]
  simpa only [hv, Linear.comp_smul, Linear.smul_comp, Category.id_comp,
    Category.comp_id, e.hom_inv_id, comp_zero, zero_comp] using h

def coefficientKoszulSmulHomotopy (x : V → R) (M : ModuleCat.{u} R) (v : V) :
    Homotopy (x v • 𝟙 (Koszul.familyCoefficientComplex x M)) 0 := by
  let F := (tensoringRight (ModuleCat R)).obj M
  have h := F.mapHomotopy (ordinaryKoszulSmulHomotopy x v)
  have he : (F.mapHomologicalComplex (ComplexShape.down ℕ)).map
      (x v • 𝟙 (_root_.koszulComplex (Fintype.linearCombination R x))) =
      x v • 𝟙 (Koszul.familyCoefficientComplex x M) := by
    apply HomologicalComplex.Hom.ext
    funext n
    apply ModuleCat.hom_ext
    apply TensorProduct.ext
    apply LinearMap.ext
    intro a
    apply LinearMap.ext
    intro b
    change (x v • a) ⊗ₜ[R] b = x v • (a ⊗ₜ[R] b)
    exact TensorProduct.smul_tmul' (x v) a b
  rw [he, Functor.map_zero] at h
  exact h

def coordinateKoszulSmulHomotopy (x : V → R) (M : ModuleCat.{u} R) (v : V) :
    Homotopy (x v • 𝟙 (Koszul.coordinateComplex x M)) 0 := by
  let e := Koszul.coordinateComplexIso x M
  have h := ((coefficientKoszulSmulHomotopy x M v).compLeft e.inv).compRight e.hom
  simpa only [Linear.comp_smul, Linear.smul_comp, Category.id_comp,
    Category.comp_id, e.inv_hom_id, comp_zero, zero_comp] using h

theorem coordinateKoszul_homology_variable_zero (x : V → R) (M : ModuleCat.{u} R)
    (v : V) (n : ℕ) (z : (Koszul.coordinateComplex x M).homology n) :
    x v • z = 0 := by
  have h := (coordinateKoszulSmulHomotopy x M v).homologyMap_eq n
  rw [HomologicalComplex.homologyMap_smul, HomologicalComplex.homologyMap_id,
    HomologicalComplex.homologyMap_zero] at h
  simpa using congrArg (fun f => f.hom z) h

end FourPapers.Universal

#print axioms FourPapers.Universal.coordinateKoszulSmulHomotopy
#print axioms FourPapers.Universal.coordinateKoszul_homology_variable_zero

end
end

/- BEGIN FourPapers.Universal.RepeatedColorShift -/
section

/-! # Invertible color shifts in a repeated color strand

For a repeated color, multiplication by its color sum preserves the supporting
face and is an actual degreewise isomorphism.  Its homology map is nevertheless
zero by the ordinary Koszul scalar homotopy.  Consequently the repeated-color
strand is acyclic over every commutative coefficient ring.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset CategoryTheory CategoryTheory.Limits CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)
local instance : DecidableEq C := Classical.decEq C
local instance repeatedColorShiftParameterAlgebra : Algebra (MvPolynomial C K) (D.Ring K) :=
  (D.parameterAction K).toRingHom.toAlgebra

lemma faceExponent_le_shift_iff (β : C →₀ ℕ) (c : C) (hc : 1 ≤ β c) (U : Finset C) :
    Koszul.faceExponent U ≤ β + Finsupp.single c 1 ↔ Koszul.faceExponent U ≤ β := by
  constructor
  · intro h j
    have hj := h j
    by_cases he : j = c
    · subst j
      simp only [Koszul.faceExponent_apply]
      split_ifs <;> omega
    · simpa only [Finsupp.add_apply, Finsupp.single_apply, if_neg (Ne.symm he), add_zero] using hj
  · intro h
    exact h.trans le_self_add

lemma residual_shift_support (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (U : Finset C) :
    ((β + Finsupp.single c 1) - Koszul.faceExponent U).support =
      (β - Koszul.faceExponent U).support := by
  ext j
  simp only [Finsupp.mem_support_iff, Finsupp.tsub_apply, Finsupp.add_apply,
    Finsupp.single_apply, Koszul.faceExponent_apply]
  by_cases he : c = j <;> by_cases hj : j ∈ U <;> simp only [he, hj, if_true, if_false]
  all_goals subst_vars <;> omega

def repeatedResidualShift (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ) :
    D.ResidualFaceIndex β i ≃ D.ResidualFaceIndex (β + Finsupp.single c 1) i where
  toFun t := ⟨⟨t.1.val, t.1.property.trans le_self_add⟩,
    ⟨t.2.val, t.2.property.1, t.2.property.2.trans (residual_shift_support β c hc _).symm⟩⟩
  invFun t := ⟨⟨t.1.val, (faceExponent_le_shift_iff β c (by omega) _).mp t.1.property⟩,
    ⟨t.2.val, t.2.property.1, t.2.property.2.trans (residual_shift_support β c hc _)⟩⟩
  left_inv t := D.residualFaceIndex_ext rfl rfl
  right_inv t := D.residualFaceIndex_ext rfl rfl

def repeatedIndexShift (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ) :
    D.ColorStrandIndex β i ≃ D.ColorStrandIndex (β + Finsupp.single c 1) i :=
  (D.strandFaceEquiv β i).trans ((D.repeatedResidualShift β c hc i).trans
    (D.strandFaceEquiv (β + Finsupp.single c 1) i).symm)

theorem repeated_color_vertex (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ)
    (t : D.ColorStrandIndex β i) : ∃ v ∈ t.val.2.val.support, D.color v = c := by
  have he := congrArg (fun a : C →₀ ℕ => a c) (D.strandIndex_residual t)
  have hp : D.colorDegree t.val.2.val c ≠ 0 := by
    rw [he, Finsupp.tsub_apply, Koszul.faceExponent_apply]
    split_ifs <;> omega
  have hm : c ∈ t.val.2.val.support.image D.color := by
    rw [← D.colorDegree_support]
    exact Finsupp.mem_support_iff.mpr hp
  exact Finset.mem_image.mp hm

theorem allowed_add_existing_vertex (a : V →₀ ℕ) (ha : D.allowed a) (v : V)
    (hv : v ∈ a.support) : D.allowed (Finsupp.single v 1 + a) := by
  change D.face (Finsupp.single v 1 + a).support
  rw [Finsupp.support_add_eq_union, Finsupp.support_single_ne_zero v (by decide),
    Finset.singleton_union, Finset.insert_eq_of_mem hv]
  exact ha

/-- The abstract face-index bijection is precisely multiplication at the
unique vertex carrying the repeated color, not a separately chosen map. -/
theorem repeatedIndexShift_eq (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ)
    (t : D.ColorStrandIndex β i) (v : V) (hv : v ∈ t.val.2.val.support)
    (hcolor : D.color v = c) :
    D.repeatedIndexShift β c hc i t =
      ⟨⟨t.val.1, ⟨Finsupp.single v 1 + t.val.2.val,
        D.allowed_add_existing_vertex _ t.val.2.property v hv⟩⟩, by
        change D.colorDegree (Finsupp.single v 1 + t.val.2.val) +
          Koszul.faceExponent t.val.1.val = β + Finsupp.single c 1
        rw [D.colorDegree_add, D.colorDegree_single, hcolor, add_assoc,
          show D.colorDegree t.val.2.val + Koszul.faceExponent t.val.1.val = β from t.property,
          add_comm]⟩ := by
  apply (D.strandFaceEquiv (β + Finsupp.single c 1) i).injective
  change (D.strandFaceEquiv (β + Finsupp.single c 1) i)
    ((D.strandFaceEquiv (β + Finsupp.single c 1) i).symm _) = _
  rw [Equiv.apply_symm_apply]
  apply D.residualFaceIndex_ext
  · rfl
  · change t.val.2.val.support = (Finsupp.single v 1 + t.val.2.val).support
    rw [Finsupp.support_add_eq_union, Finsupp.support_single_ne_zero v (by decide),
      Finset.singleton_union, Finset.insert_eq_of_mem hv]

/-- A genuine linear equivalence on the actual homogeneous coefficient
Koszul modules, whose underlying map is scalar multiplication by `X c`. -/
def repeatedColorShiftEquiv (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ) :
    D.colorKoszulPiece K β i ≃ₗ[K] D.colorKoszulPiece K (β + Finsupp.single c 1) i :=
  (D.colorKoszulPieceBasis K β i).equiv
    (D.colorKoszulPieceBasis K (β + Finsupp.single c 1) i) (D.repeatedIndexShift β c hc i)

theorem repeatedColorShiftEquiv_val (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ)
    (x : D.colorKoszulPiece K β i) :
    (D.repeatedColorShiftEquiv K β c hc i x).val = (MvPolynomial.X c : MvPolynomial C K) • x.val := by
  suffices he : (D.colorKoszulPiece K (β + Finsupp.single c 1) i).subtype.comp
      (D.repeatedColorShiftEquiv K β c hc i).toLinearMap =
      (((LinearMap.lsmul (MvPolynomial C K) (Set.powersetCard C i →₀ D.Ring K))
        (MvPolynomial.X c)).restrictScalars K).comp (D.colorKoszulPiece K β i).subtype by
    exact LinearMap.congr_fun he x
  apply (D.colorKoszulPieceBasis K β i).ext
  intro t
  obtain ⟨v, hv, hcolor⟩ := D.repeated_color_vertex β c hc i t
  simp only [LinearMap.comp_apply, Submodule.subtype_apply, LinearEquiv.coe_coe,
    repeatedColorShiftEquiv, Module.Basis.equiv_apply,
    LinearMap.restrictScalars_apply, LinearMap.lsmul_apply]
  rw [D.repeatedIndexShift_eq β c hc i t v hv hcolor,
    D.colorKoszulPieceBasis_val K, D.colorKoszulPieceBasis_val K]
  rw [D.koszulBasis_apply K, D.koszulBasis_apply K, Finsupp.smul_single,
    D.parameter_variable_smul K, ← hcolor, D.colorParameter_mul_of_present K _ t.val.2.property v hv]

/-- Scalar multiplication commutes with the actual coefficient differential,
so the repeated-color shifts give a genuine chain isomorphism. -/
def repeatedColorShiftIso (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) :
    D.colorKoszulComplex K β ≅ D.colorKoszulComplex K (β + Finsupp.single c 1) :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (D.repeatedColorShiftEquiv K β c hc i).toModuleIso) (by
      intro i j hij
      obtain rfl : i = j + 1 := hij.symm
      rw [D.colorKoszulComplex_d K, D.colorKoszulComplex_d K]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      change D.koszulDifferential K j (D.repeatedColorShiftEquiv K β c hc (j + 1) x).val =
        (D.repeatedColorShiftEquiv K β c hc j (D.colorKoszulDifferential K β j x)).val
      rw [D.repeatedColorShiftEquiv_val K, D.repeatedColorShiftEquiv_val K]
      exact (map_smul (Koszul.coordinateDifferential (MvPolynomial.X : C → MvPolynomial C K)
        (ModuleCat.of (MvPolynomial C K) (D.Ring K)) j) (MvPolynomial.X c) x.val))


/-- The actual parameter action on the full coefficient complex after scalar
restriction; its components are ordinary multiplication by the color sum. -/
def colorTotalParameterMap (c : C) : D.colorUnderlyingComplex K ⟶ D.colorUnderlyingComplex K :=
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let e := D.colorRestrictionComplexIso K
  e.inv ≫ (F.mapHomologicalComplex (ComplexShape.down ℕ)).map
    ((MvPolynomial.X c : MvPolynomial C K) • 𝟙 (Koszul.coordinateComplex
      (MvPolynomial.X : C → MvPolynomial C K)
      (ModuleCat.of (MvPolynomial C K) (D.Ring K)))) ≫ e.hom

@[simp] theorem colorTotalParameterMap_apply (c : C) (i : ℕ)
    (x : Set.powersetCard C i →₀ D.Ring K) :
    (D.colorTotalParameterMap K c).f i x = (MvPolynomial.X c : MvPolynomial C K) • x := rfl

/-- The usual scalar null-homotopy remains an actual homotopy after restriction
of scalars and passage to the independently defined coordinate complex. -/
def colorTotalParameterHomotopy (c : C) : Homotopy (D.colorTotalParameterMap K c) 0 := by
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let e := D.colorRestrictionComplexIso K
  let h := F.mapHomotopy (coordinateKoszulSmulHomotopy
    (MvPolynomial.X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) (D.Ring K)) c)
  have hh := (h.compLeft e.inv).compRight e.hom
  simpa only [colorTotalParameterMap, Category.assoc, Functor.map_zero,
    comp_zero, zero_comp] using hh

theorem repeatedColorShift_inclusion (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) :
    D.colorInclusion K β ≫ D.colorTotalParameterMap K c =
      (D.repeatedColorShiftIso K β c hc).hom ≫
        D.colorInclusion K (β + Finsupp.single c 1) := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  simp only [HomologicalComplex.comp_f, ModuleCat.hom_comp, LinearMap.comp_apply]
  change (MvPolynomial.X c : MvPolynomial C K) • x.val =
    (D.repeatedColorShiftEquiv K β c hc i x).val
  exact (D.repeatedColorShiftEquiv_val K β c hc i x).symm

/-- Every repeated-color strand has zero actual homology.  The argument uses
an invertible actual chain map which is zero on homology, with no division by
an integer and no restriction on the characteristic. -/
theorem repeatedColorHomology_subsingleton (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c)
    (i : ℕ) : Subsingleton ((D.colorKoszulComplex K β).homology i) := by
  have hz : ∀ z : (D.colorKoszulComplex K β).homology i, z = 0 := by
    intro z
    have hzero := (D.colorTotalParameterHomotopy K c).homologyMap_eq i
    rw [HomologicalComplex.homologyMap_zero] at hzero
    have hcomm := congrArg (fun f => HomologicalComplex.homologyMap f i)
      (D.repeatedColorShift_inclusion K β c hc)
    rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp,
      hzero, comp_zero] at hcomm
    have hmapzero : HomologicalComplex.homologyMap
        (D.repeatedColorShiftIso K β c hc).hom i z = 0 := by
      apply D.colorHomology_injective K (β + Finsupp.single c 1) i
      rw [map_zero]
      exact (congrArg (fun f => f.hom z) hcomm).symm
    let e := (HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).mapIso
      (D.repeatedColorShiftIso K β c hc)
    apply e.toLinearEquiv.injective
    change HomologicalComplex.homologyMap (D.repeatedColorShiftIso K β c hc).hom i z = _
    simpa only [map_zero] using hmapzero
  exact ⟨fun x y => (hz x).trans (hz y).symm⟩

/-- Vanishing is asserted inside the genuine derived Tor module. -/
theorem repeatedColorTorPiece_subsingleton (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c)
    (i : ℕ) : Subsingleton (D.colorTorPiece K β i) := by
  letI := D.repeatedColorHomology_subsingleton K β c hc i
  exact ⟨fun x y => (D.colorTorPieceIso K β i).symm.toLinearEquiv.injective
    (Subsingleton.elim _ _)⟩

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.SquarefreeCochainMap -/
section

/-! # The signed squarefree strand comparison on actual cochains

The codomain is the independently defined dual of the usual augmented face
chains.  The complementary face determines the cohomological degree, and the
complement sign reconciles its usual simplicial orientation with Koszul order.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical Finset CommAlg
section Cochain
variable {K V : Type*} [CommRing K] [Fintype V] [LinearOrder V]

def relativeCochainBasis (Λ Λ₀ : Finset V → Prop) (i : ℕ) :
    Module.Basis (RelativeFaceIndex Λ Λ₀ i) K
      (Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i)) :=
  (Pi.basisFun K (RelativeFaceIndex Λ Λ₀ i)).map
    (relativeCochainCoordinateEquiv (K := K) Λ Λ₀ i).symm

@[simp] theorem relativeCochainBasis_coordinate (Λ Λ₀ : Finset V → Prop) (i : ℕ)
    (F G : RelativeFaceIndex Λ Λ₀ i) :
    relativeCochainCoordinates (K := K) Λ Λ₀ i (relativeCochainBasis Λ Λ₀ i F) G =
      if F = G then 1 else 0 := by
  change (relativeCochainCoordinateEquiv (K := K) Λ Λ₀ i)
    ((relativeCochainCoordinateEquiv (K := K) Λ Λ₀ i).symm
      ((Pi.basisFun K (RelativeFaceIndex Λ Λ₀ i)) F)) G = _
  rw [LinearEquiv.apply_symm_apply]
  simp only [Pi.basisFun_apply, Pi.single_apply, eq_comm]

/-- Evaluation of the actual coboundary on an actual oriented face. -/
theorem relativeAugmentedCoboundary_face (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (i : ℕ)
    (f : Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i))
    (F : AugmentedFaceIndex Λ (i + 1)) :
    relativeAugmentedCoboundary Λ Λ₀ hΛ hΛ₀ i f (relativeFaceClass Λ Λ₀ (i + 1) F) =
      ∑ v : {v // v ∈ F.val}, TauCeti.ExteriorAlgebra.basisEraseSign v.val F.val •
        f (relativeFaceClass Λ Λ₀ i (eraseAugmentedFace Λ hΛ i F v)) := by
  change f (Submodule.Quotient.mk
    (augmentedFaceBoundary Λ hΛ i (augmentedChainBasis Λ (i + 1) F))) = _
  rw [augmentedFaceBoundary_basis]
  simp only [relativeFaceClass, ← Submodule.mkQ_apply, map_sum, map_zsmul_unit]


/-- The ordinary relative coboundary matrix, with no choice of Koszul
coordinates in its definition.  Vanished subcomplex faces contribute zero. -/
theorem relativeAugmentedCoboundary_basis_coordinate (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀) (i : ℕ)
    (F : RelativeFaceIndex Λ Λ₀ i) (G : RelativeFaceIndex Λ Λ₀ (i + 1)) :
    relativeCochainCoordinates (K := K) Λ Λ₀ (i + 1)
      (relativeAugmentedCoboundary Λ Λ₀ hΛ hΛ₀ i (relativeCochainBasis Λ Λ₀ i F)) G =
      ∑ v : {v // v ∈ G.val}, TauCeti.ExteriorAlgebra.basisEraseSign v.val G.val •
        (if G.val.erase v.val = F.val then (1 : K) else 0) := by
  change relativeAugmentedCoboundary Λ Λ₀ hΛ hΛ₀ i (relativeCochainBasis Λ Λ₀ i F)
    (relativeFaceClass Λ Λ₀ (i + 1) ⟨G.val, G.property.1, G.property.2.1⟩) = _
  rw [relativeAugmentedCoboundary_face]
  apply Finset.sum_congr rfl
  intro v hv
  congr 1
  by_cases h0 : Λ₀ (G.val.erase v.val)
  · rw [relativeFaceClass_zero Λ Λ₀ i _ h0, map_zero, if_neg]
    intro he
    exact F.property.2.2 (he ▸ h0)
  · let H : RelativeFaceIndex Λ Λ₀ i :=
      ⟨G.val.erase v.val, hΛ (Finset.erase_subset _ _) G.property.1,
        by simpa only [G.property.2.1, Nat.add_sub_cancel] using Finset.card_erase_of_mem v.property,
        h0⟩
    change relativeCochainCoordinates (K := K) Λ Λ₀ i
      (relativeCochainBasis Λ Λ₀ i F) H = _
    rw [relativeCochainBasis_coordinate]
    have hFH : F = H ↔ G.val.erase v.val = F.val := by
      constructor
      · intro h
        exact (congrArg Subtype.val h).symm
      · intro h
        exact Subtype.ext h.symm
    simp only [hFH]

end Cochain

attribute [class] ProperlyColoredComplex

namespace ProperlyColoredComplex
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype C] [LinearOrder C] [Fintype V] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (K)
local instance : DecidableEq C := Classical.decEq C

set_option synthInstance.checkSynthOrder false in
local instance squarefreeCochainMapVertexOrder : LinearOrder V := D.colorLinearOrder

/-- The complementary cardinality is the ordinary cochain degree, including
cardinality zero, which is reduced cohomological degree minus one. -/
def squarefreeFaceCochainIndex (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    D.SquarefreeFaceIndex S i ≃ RelativeFaceIndex (rankSelection D S) (fun _ => False) j where
  toFun F := ⟨F.val, ⟨F.property.1, F.property.2.1⟩, by omega, not_false⟩
  invFun F := ⟨F.val, F.property.1.1, F.property.1.2, by omega⟩
  left_inv F := Subtype.ext rfl
  right_inv F := Subtype.ext rfl

def squarefreeCochainIndex (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    D.ColorStrandIndex (Koszul.faceExponent S) i ≃
      RelativeFaceIndex (rankSelection D S) (fun _ => False) j :=
  (D.squarefreeStrandFaceEquiv S i).trans (D.squarefreeFaceCochainIndex S i j hij)


@[simp] theorem squarefreeCochainIndex_face (S : Finset C) (i j : ℕ)
    (hij : j + i = S.card) (t : D.ColorStrandIndex (Koszul.faceExponent S) i) :
    (D.squarefreeCochainIndex S i j hij t).val = t.val.2.val.support := rfl

/-- Exterior colors and coefficient-support colors are literal complements
inside the squarefree support. -/
theorem squarefree_strand_support_colors (S : Finset C) (i : ℕ)
    (t : D.ColorStrandIndex (Koszul.faceExponent S) i) :
    t.val.2.val.support.image D.color = S \ t.val.1.val := by
  have h := congrArg Finsupp.support (D.strandIndex_residual t)
  rw [D.colorDegree_support, faceExponent_sub, faceExponent_support] at h
  exact h

theorem squarefree_strand_exterior_notMem (S : Finset C) (i : ℕ)
    (t : D.ColorStrandIndex (Koszul.faceExponent S) i) {v : V}
    (hv : D.color v ∈ t.val.1.val) : v ∉ t.val.2.val.support := by
  intro h
  have hc : D.color v ∈ t.val.2.val.support.image D.color := Finset.mem_image.mpr ⟨v, h, rfl⟩
  rw [D.squarefree_strand_support_colors S i t] at hc
  exact (Finset.mem_sdiff.mp hc).2 hv

theorem addedExponent_support (a : V →₀ ℕ) (v : V) :
    (Finsupp.single v 1 + a).support = insert v a.support := by
  rw [Finsupp.support_add_eq_union, Finsupp.support_single_ne_zero v (by decide)]
  exact Finset.singleton_union _ _

/-- The basis index after applying one actual Koszul term, with its unchanged
color degree proved from the quotient-ring multiplication. -/
def nextColorStrandIndex {β : C →₀ ℕ} {i : ℕ} (t : D.ColorStrandIndex β (i + 1))
    (j : {j // j ∈ t.val.1.val}) (v : V) (hc : D.color v = j.val)
    (hv : D.allowed (Finsupp.single v 1 + t.val.2.val)) : D.ColorStrandIndex β i :=
  ⟨D.nextKoszulIndex t.val j v hv, (D.nextKoszulIndex_degree t.val j v hc hv).trans t.property⟩

/-- The exterior index is the same finite set for every equality decision. -/
@[simp] theorem nextColorStrandIndex_exterior {β : C →₀ ℕ} {i : ℕ}
    (t : D.ColorStrandIndex β (i + 1)) (c : {c // c ∈ t.val.1.val})
    (v : V) (hc : D.color v = c.val)
    (hv : D.allowed (Finsupp.single v 1 + t.val.2.val)) :
    (D.nextColorStrandIndex t c v hc hv).val.1.val = t.val.1.val.erase c.val := by
  change (Koszul.eraseIndex t.val.1 c).val = t.val.1.val.erase c.val
  ext j
  simp only [Koszul.eraseIndex, Finset.mem_erase]

theorem colorKoszulDifferential_basis (β : C →₀ ℕ) (i : ℕ)
    (t : D.ColorStrandIndex β (i + 1)) :
    D.colorKoszulDifferential K β i (D.colorKoszulPieceBasis K β (i + 1) t) =
      ∑ j : {j // j ∈ t.val.1.val},
        ∑ v : {v : V // D.color v = j.val},
          if h : D.allowed (Finsupp.single v.val 1 + t.val.2.val) then
            TauCeti.ExteriorAlgebra.basisEraseSign j.val t.val.1.val •
              D.colorKoszulPieceBasis K β i (D.nextColorStrandIndex t j v.val v.property h)
          else 0 := by
  letI : LinearOrder V := D.colorLinearOrder
  apply Subtype.ext
  change D.koszulDifferential K i ((D.colorKoszulPieceBasis K β (i + 1) t).val) = _
  rw [D.colorKoszulPieceBasis_val K]
  rw [D.koszulDifferential_basis K i t.val]
  simp only [Submodule.coe_sum, Submodule.coe_smul_of_tower]
  apply Finset.sum_congr rfl
  intro j hj
  trans ∑ v : {v : V // D.color v = j.val}, if h : D.allowed (Finsupp.single v.val 1 + t.val.2.val) then
      TauCeti.ExteriorAlgebra.basisEraseSign j.val t.val.1.val •
        D.koszulBasis K i (D.nextKoszulIndex t.val j v.val h) else 0
  · apply Finset.sum_subtype
    intro v
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  · apply Finset.sum_congr rfl
    intro v hv
    split_ifs with h
    · simp only [Submodule.coe_smul_of_tower, D.colorKoszulPieceBasis_val K,
        nextColorStrandIndex]
    · rfl

/-- The actual degreewise linear isomorphism to the ordinary cochain module.
The sign is applied to an independent ordinary cochain basis. -/
def squarefreeCochainEquiv (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    D.colorKoszulPiece K (Koszul.faceExponent S) i ≃ₗ[K]
      Module.Dual K (RelativeAugmentedChains (K := K) (rankSelection D S) (fun _ => False) j) :=
  (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i).equiv
    (((relativeCochainBasis (K := K) (rankSelection D S) (fun _ => False) j).reindex
      (D.squarefreeCochainIndex S i j hij).symm).groupSMul
        (fun t => complementSign S t.val.1.val)) (Equiv.refl _)

@[simp] theorem squarefreeCochainEquiv_basis (S : Finset C) (i j : ℕ)
    (hij : j + i = S.card) (t : D.ColorStrandIndex (Koszul.faceExponent S) i) :
    D.squarefreeCochainEquiv K S i j hij
      (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i t) =
      complementSign S t.val.1.val •
        relativeCochainBasis (K := K) (rankSelection D S) (fun _ => False) j
          (D.squarefreeCochainIndex S i j hij t) := by
  simp only [squarefreeCochainEquiv, Module.Basis.equiv_apply, Equiv.refl_apply,
    Module.Basis.groupSMul_apply, Pi.smul_apply', Pi.smul_apply, Module.Basis.reindex_apply,
    Equiv.symm_symm]

@[simp] theorem squarefreeCochainEquiv_basis_coordinate (S : Finset C) (i j : ℕ)
    (hij : j + i = S.card) (t : D.ColorStrandIndex (Koszul.faceExponent S) i)
    (F : RelativeFaceIndex (rankSelection D S) (fun _ => False) j) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) j
      (D.squarefreeCochainEquiv K S i j hij
        (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i t)) F =
      complementSign S t.val.1.val •
        (if D.squarefreeCochainIndex S i j hij t = F then (1 : K) else 0) := by
  rw [squarefreeCochainEquiv_basis, map_zsmul_unit]
  exact congrArg (fun x : K => complementSign S t.val.1.val • x)
    (relativeCochainBasis_coordinate (rankSelection D S) (fun _ => False) j _ F)

end ProperlyColoredComplex
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.ColorIncidenceSigns -/
section

/-! # Ordinary simplicial orientation agrees with color orientation

The global order is chosen once by color, with ties broken by a finite
vertex enumeration.  Proper coloring makes the tie-break irrelevant on every
face.  All sign identities are integral identities of units.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical Finset
variable {C : Type*} [LinearOrder C] [DecidableEq C]

theorem basisEraseSign_insert_self (i : C) (F : Finset C) :
    TauCeti.ExteriorAlgebra.basisEraseSign i (insert i F) =
      TauCeti.ExteriorAlgebra.basisEraseSign i F := by
  rw [TauCeti.ExteriorAlgebra.basisEraseSign_eq_neg_one_pow_card_filter_lt,
    TauCeti.ExteriorAlgebra.basisEraseSign_eq_neg_one_pow_card_filter_lt]
  simp only [Finset.filter_insert, lt_self_iff_false, if_false]


section FiberSums
variable {V M : Type*} [Fintype V] [Fintype C] [AddCommMonoid M]

def colorFiberSigmaEquiv (color : V → C) (U : Finset C) :
    (Σ j : {j // j ∈ U}, {v : V // color v = j.val}) ≃ {v : V // color v ∈ U} where
  toFun x := ⟨x.2.val, x.2.property.symm ▸ x.1.property⟩
  invFun v := ⟨⟨color v.val, v.property⟩, ⟨v.val, rfl⟩⟩
  left_inv x := by
    obtain ⟨⟨j, hj⟩, ⟨v, hv⟩⟩ := x
    dsimp at hv
    subst j
    rfl
  right_inv v := Subtype.ext rfl

theorem sum_color_fibers (color : V → C) (U : Finset C) (f : C → V → M) :
    (∑ j : {j // j ∈ U}, ∑ v : {v : V // color v = j.val}, f j.val v.val) =
      ∑ v : {v : V // color v ∈ U}, f (color v.val) v.val := by
  rw [← Fintype.sum_sigma' (fun (j : {j // j ∈ U}) (v : {v : V // color v = j.val}) => f j.val v.val)]
  apply Fintype.sum_equiv (colorFiberSigmaEquiv color U)
  intro x
  dsimp [colorFiberSigmaEquiv]
  rw [x.2.property]
end FiberSums

namespace ProperlyColoredComplex
variable {V : Type*} [Fintype V]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C]
set_option synthInstance.checkSynthOrder false in
local instance colorIncidenceSignsVertexOrder : LinearOrder V := D.colorLinearOrder

/-- Equality with the usual exterior basis sign, proved by the actual
order-preserving bijection of vertices of the face with their colors. -/
theorem face_basisEraseSign_eq_color (F : Finset V) (hF : D.face F)
    (v : V) (hv : v ∈ F) :
    TauCeti.ExteriorAlgebra.basisEraseSign v F =
      TauCeti.ExteriorAlgebra.basisEraseSign (D.color v) (F.image D.color) := by
  rw [TauCeti.ExteriorAlgebra.basisEraseSign_eq_neg_one_pow_card_filter_lt,
    TauCeti.ExteriorAlgebra.basisEraseSign_eq_neg_one_pow_card_filter_lt]
  have he : (F.image D.color).filter (fun j => j < D.color v) =
      (F.filter (fun w => w < v)).image D.color := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_image]
    constructor
    · rintro ⟨⟨w, hw, rfl⟩, hj⟩
      exact ⟨w, ⟨hw, (D.colorLinearOrder_lt_iff F hF hw hv).mpr hj⟩, rfl⟩
    · rintro ⟨w, ⟨hw, hwv⟩, rfl⟩
      exact ⟨⟨w, hw, rfl⟩, (D.colorLinearOrder_lt_iff F hF hw hv).mp hwv⟩
  rw [he, Finset.card_image_of_injOn ((D.proper F hF).mono (Finset.filter_subset _ _))]

/-- The precise comparison needed when a Koszul exterior deletion inserts
one vertex into the complementary simplicial face. -/
theorem complementSign_simplicial_boundary (S U : Finset C) (hU : U ⊆ S)
    (F : Finset V) (hcolors : F.image D.color = S \ U)
    (v : V) (hv : D.color v ∈ U) (hface : D.face (insert v F)) :
    TauCeti.ExteriorAlgebra.basisEraseSign (D.color v) U *
        complementSign S (U.erase (D.color v)) =
      complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign v (insert v F) := by
  rw [D.face_basisEraseSign_eq_color (insert v F) hface v (Finset.mem_insert_self _ _),
    Finset.image_insert, basisEraseSign_insert_self, hcolors]
  exact complementSign_boundary S U hU hv


/-- The incidence condition is unchanged by taking the complementary color
set: inserting a missing-color vertex is exactly deleting that vertex from
the larger face. -/
theorem complementary_incidence_iff (S U : Finset C) (hU : U ⊆ S)
    (F G : Finset V) (hcolors : F.image D.color = S \ U)
    (hG : D.face G) (hGS : G.image D.color ⊆ S) (v : V) :
    (D.color v ∈ U ∧ insert v F = G) ↔ (v ∈ G ∧ G.erase v = F) := by
  constructor
  · rintro ⟨hc, rfl⟩
    have hv : v ∉ F := by
      intro h
      have hcv : D.color v ∈ F.image D.color := Finset.mem_image.mpr ⟨v, h, rfl⟩
      rw [hcolors] at hcv
      exact (Finset.mem_sdiff.mp hcv).2 hc
    exact ⟨Finset.mem_insert_self _ _, Finset.erase_insert hv⟩
  · rintro ⟨hv, he⟩
    have hF : F ⊆ G := he ▸ Finset.erase_subset v G
    have hnot : D.color v ∉ F.image D.color := by
      rintro h
      obtain ⟨w, hw, hc⟩ := Finset.mem_image.mp h
      have heq := D.proper G hG (hF hw) hv hc
      subst w
      rw [← he] at hw
      exact Finset.notMem_erase v G hw
    have hS : D.color v ∈ S := hGS (Finset.mem_image.mpr ⟨v, hv, rfl⟩)
    have hc : D.color v ∈ U := by
      by_contra hn
      apply hnot
      rw [hcolors]
      exact Finset.mem_sdiff.mpr ⟨hS, hn⟩
    exact ⟨hc, by rw [← he, Finset.insert_erase hv]⟩

section Matrix
variable {K : Type*} [CommRing K] [Fintype C]

/-- The entire Koszul-to-coboundary matrix identity.  Both sums use their
actual orientation signs; equality follows term by term on vertices. -/
theorem complementary_incidence_matrix (S U : Finset C) (hU : U ⊆ S)
    (F G : Finset V) (hcolors : F.image D.color = S \ U)
    (hG : D.face G) (hGS : G.image D.color ⊆ S) :
    (∑ j : {j // j ∈ U}, ∑ v : {v : V // D.color v = j.val},
      if insert v.val F = G then
        (TauCeti.ExteriorAlgebra.basisEraseSign j.val U *
          complementSign S (U.erase j.val)) • (1 : K) else 0) =
    ∑ v : {v // v ∈ G},
      if G.erase v.val = F then
        (complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign v.val G) • (1 : K) else 0 := by
  letI : LinearOrder V := D.colorLinearOrder
  rw [sum_color_fibers D.color U
    (fun c v => if insert v F = G then
      (TauCeti.ExteriorAlgebra.basisEraseSign c U *
        complementSign S (U.erase c)) • (1 : K) else 0)]
  rw [← Finset.sum_subtype (p := fun v : V => D.color v ∈ U)
    (Finset.univ.filter (fun v => D.color v ∈ U)) (fun v => by simp)
    (fun v => if insert v F = G then
      (TauCeti.ExteriorAlgebra.basisEraseSign (D.color v) U *
        complementSign S (U.erase (D.color v))) • (1 : K) else 0),
    ← Finset.sum_subtype (p := fun v : V => v ∈ G) G (fun _ => Iff.rfl)
      (fun v => if G.erase v = F then
        (complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign v G) • (1 : K) else 0)]
  rw [Finset.sum_filter]
  have he : (∑ v ∈ G,
      if G.erase v = F then
        (complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign v G) • (1 : K) else 0) =
      ∑ v : V, if v ∈ G then
        (if G.erase v = F then
          (complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign v G) • (1 : K) else 0) else 0 := by
    exact (Finset.sum_ite_mem_eq G
      (fun v => if G.erase v = F then
        (complementSign S U * TauCeti.ExteriorAlgebra.basisEraseSign v G) • (1 : K)
        else 0)).symm
  rw [he]
  apply Finset.sum_congr rfl
  intro v hv
  have hi := D.complementary_incidence_iff S U hU F G hcolors hG hGS v
  by_cases hleft : D.color v ∈ U ∧ insert v F = G
  · have hright := hi.mp hleft
    rw [if_pos hleft.1, if_pos hleft.2, if_pos hright.1, if_pos hright.2]
    have hsign := D.complementSign_simplicial_boundary S U hU F hcolors v hleft.1
      (hleft.2.symm ▸ hG)
    rw [hleft.2] at hsign
    rw [hsign]
  · have hright : ¬ (v ∈ G ∧ G.erase v = F) := fun h => hleft (hi.mpr h)
    by_cases hc : D.color v ∈ U <;> by_cases hg : v ∈ G
    all_goals simp only [hc, hg, if_true, if_false]
    · rw [if_neg (fun h => hleft ⟨hc, h⟩), if_neg (fun h => hright ⟨hg, h⟩)]
    · rw [if_neg (fun h => hleft ⟨hc, h⟩)]
    · rw [if_neg (fun h => hright ⟨hg, h⟩)]
end Matrix

end ProperlyColoredComplex
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.SquarefreeCochainDifferential -/
section

/-! # The signed comparison intertwines the actual differentials

The proof expands the already defined quotient-ring Koszul differential and
the independently defined simplicial coboundary.  Their matrices agree by
complementary incidence and the integral complement-sign identity.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (K)
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance squarefreeCochainDifferentialVertexOrder : LinearOrder V := D.colorLinearOrder

lemma squarefree_next_face_eq_iff (S : Finset C) (i j : ℕ) (hij : (j + 1) + i = S.card)
    (t : D.ColorStrandIndex (Koszul.faceExponent S) (i + 1))
    (c : {c // c ∈ t.val.1.val}) (v : {v : V // D.color v = c.val})
    (ha : D.allowed (Finsupp.single v.val 1 + t.val.2.val))
    (G : RelativeFaceIndex (rankSelection D S) (fun _ => False) (j + 1)) :
    D.squarefreeCochainIndex S i (j + 1) hij
      (D.nextColorStrandIndex t c v.val v.property ha) = G ↔
      insert v.val t.val.2.val.support = G.val := by
  rw [Subtype.ext_iff, D.squarefreeCochainIndex_face]
  change (Finsupp.single v.val 1 + t.val.2.val).support = G.val ↔ _
  rw [D.addedExponent_support]

lemma squarefree_differential_coordinate (S : Finset C) (i j : ℕ)
    (hij : (j + 1) + i = S.card)
    (t : D.ColorStrandIndex (Koszul.faceExponent S) (i + 1))
    (G : RelativeFaceIndex (rankSelection D S) (fun _ => False) (j + 1)) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) (j + 1)
      (D.squarefreeCochainEquiv K S i (j + 1) hij
        (D.colorKoszulDifferential K (Koszul.faceExponent S) i
          (D.colorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1) t))) G =
      ∑ c : {c // c ∈ t.val.1.val}, ∑ v : {v : V // D.color v = c.val},
        if insert v.val t.val.2.val.support = G.val then
          (TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val *
            complementSign S (t.val.1.val.erase c.val)) • (1 : K) else 0 := by
  letI : LinearOrder V := D.colorLinearOrder
  rw [D.colorKoszulDifferential_basis K]
  simp only [map_sum, LinearMap.sum_apply, Finset.sum_apply]
  apply Finset.sum_congr rfl
  intro c hc
  apply Finset.sum_congr rfl
  intro v hv
  by_cases ha : D.allowed (Finsupp.single v.val 1 + t.val.2.val)
  · rw [dif_pos ha]
    have hs := (D.squarefreeCochainEquiv K S i (j + 1) hij).map_smul_of_tower
      (TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val)
      (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i
        (D.nextColorStrandIndex t c v.val v.property ha))
    have h₁ := congrArg (fun z =>
      relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) (j + 1) z G) hs
    have h₂ := congrArg
      (fun f : RelativeFaceIndex (rankSelection D S) (fun _ => False) (j + 1) → K => f G)
      ((relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False)
        (j + 1)).map_smul_of_tower
        (TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val)
        (D.squarefreeCochainEquiv K S i (j + 1) hij
          (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i
            (D.nextColorStrandIndex t c v.val v.property ha))))
    refine h₁.trans (h₂.trans ?_)
    change TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
      relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) (j + 1)
        (D.squarefreeCochainEquiv K S i (j + 1) hij
          (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i
            (D.nextColorStrandIndex t c v.val v.property ha))) G = _
    rw [D.squarefreeCochainEquiv_basis_coordinate K]
    simp only [D.squarefree_next_face_eq_iff S i j hij t c v ha]
    rw [D.nextColorStrandIndex_exterior]
    change TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
      (complementSign S (t.val.1.val.erase c.val) •
        (if insert v.val t.val.2.val.support = G.val then (1 : K) else 0)) = _
    simp only [smul_smul, smul_ite, smul_zero]
  · have hn : insert v.val t.val.2.val.support ≠ G.val := by
      intro he
      apply ha
      change D.face (Finsupp.single v.val 1 + t.val.2.val).support
      rw [D.addedExponent_support, he]
      exact G.property.1.1
    simp only [dif_neg ha, map_zero, LinearMap.zero_apply, Pi.zero_apply, if_neg hn]

lemma squarefree_coboundary_coordinate (S : Finset C) (i j : ℕ)
    (hij : j + (i + 1) = S.card)
    (t : D.ColorStrandIndex (Koszul.faceExponent S) (i + 1))
    (G : RelativeFaceIndex (rankSelection D S) (fun _ => False) (j + 1)) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) (j + 1)
      (relativeAugmentedCoboundary (rankSelection D S) (fun _ => False)
        (rankSelection_downward D S) (by intro s t h ht; exact ht) j
        (D.squarefreeCochainEquiv K S (i + 1) j hij
          (D.colorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1) t))) G =
      ∑ v : {v // v ∈ G.val},
        if G.val.erase v.val = t.val.2.val.support then
          (complementSign S t.val.1.val *
            TauCeti.ExteriorAlgebra.basisEraseSign v.val G.val) • (1 : K) else 0 := by
  rw [D.squarefreeCochainEquiv_basis K, map_zsmul_unit, map_zsmul_unit]
  change complementSign S t.val.1.val •
    relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) (j + 1)
      (relativeAugmentedCoboundary (rankSelection D S) (fun _ => False)
        (rankSelection_downward D S) (by intro s t h ht; exact ht) j
        (relativeCochainBasis (K := K) (rankSelection D S) (fun _ => False) j
          (D.squarefreeCochainIndex S (i + 1) j hij t))) G = _
  rw [relativeAugmentedCoboundary_basis_coordinate, D.squarefreeCochainIndex_face]
  simp only [Finset.smul_sum, smul_smul, smul_ite, smul_zero]

/-- The chain comparison uses the ordinary signed simplicial coboundary,
with complementary degrees `j+i=|S|`. -/
theorem squarefreeCochainEquiv_differential (S : Finset C) (i j : ℕ)
    (hij : j + (i + 1) = S.card)
    (x : D.colorKoszulPiece K (Koszul.faceExponent S) (i + 1)) :
    D.squarefreeCochainEquiv K S i (j + 1) (by omega)
      (D.colorKoszulDifferential K (Koszul.faceExponent S) i x) =
    relativeAugmentedCoboundary (rankSelection D S) (fun _ => False)
      (rankSelection_downward D S) (by intro s t h ht; exact ht) j
      (D.squarefreeCochainEquiv K S (i + 1) j hij x) := by
  suffices he : (D.squarefreeCochainEquiv K S i (j + 1) (by omega)).toLinearMap.comp
      (D.colorKoszulDifferential K (Koszul.faceExponent S) i) =
      (relativeAugmentedCoboundary (K := K) (rankSelection D S) (fun _ => False)
        (rankSelection_downward D S) (by intro s t h ht; exact ht) j).comp
          (D.squarefreeCochainEquiv K S (i + 1) j hij).toLinearMap by
    exact LinearMap.congr_fun he x
  apply (D.colorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1)).ext
  intro t
  apply relativeCochainCoordinates_injective (rankSelection D S) (fun _ => False) (j + 1)
  funext G
  change relativeCochainCoordinates (K := K) (rankSelection D S) (fun _ => False) (j + 1)
      (D.squarefreeCochainEquiv K S i (j + 1) _
        (D.colorKoszulDifferential K (Koszul.faceExponent S) i
          (D.colorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1) t))) G = _
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
  rw [D.squarefree_differential_coordinate K S i j (by omega) t G,
    D.squarefree_coboundary_coordinate K S i j hij t G]
  exact D.complementary_incidence_matrix S t.val.1.val
    ((faceExponent_le_iff _ _).mp (D.strandIndex_exterior_le t))
    t.val.2.val.support G.val (D.squarefree_strand_support_colors S (i + 1) t)
    G.property.1.1 G.property.1.2

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.SquarefreeCochainHomology -/
section

/-! # All degrees of the squarefree colorful Hochster comparison

The homology is the ordinary categorical homology of the actual Koszul and
augmented simplicial cochain complexes.  The degree-zero ends are handled by
literal kernels and images; no artificial identification of adjacent objects
is used.  Degrees below reduced degree minus one are included explicitly.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical CategoryTheory CategoryTheory.Limits CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (K)
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance squarefreeHomologyVertexOrder : LinearOrder V := D.colorLinearOrder

abbrev rankCochainComplex (S : Finset C) : CochainComplex (ModuleCat.{u} K) ℕ :=
  relativeAugmentedCochainComplex (K := K) (rankSelection D S) (fun _ => False)
    (rankSelection_downward D S) (by intro s t h ht; exact ht)

@[simp] theorem rankCochainComplex_d (S : Finset C) (j : ℕ) :
    (D.rankCochainComplex K S).d j (j + 1) = ModuleCat.ofHom
      (relativeAugmentedCoboundary (K := K) (rankSelection D S) (fun _ => False)
        (rankSelection_downward D S) (by intro s t h ht; exact ht) j) := by
  simp [rankCochainComplex, relativeAugmentedCochainComplex]

lemma squarefreeStrandIndex_isEmpty (S : Finset C) (i : ℕ) (hi : S.card < i) :
    IsEmpty (D.ColorStrandIndex (Koszul.faceExponent S) i) := by
  refine ⟨fun t => ?_⟩
  have hu := (faceExponent_le_iff _ _).mp (D.strandIndex_exterior_le t)
  have hcard := Finset.card_le_card hu
  have ht : t.val.1.val.card = i := t.val.1.property
  omega

lemma squarefreePiece_subsingleton (S : Finset C) (i : ℕ) (hi : S.card < i) :
    Subsingleton (D.colorKoszulPiece K (Koszul.faceExponent S) i) := by
  letI := D.squarefreeStrandIndex_isEmpty S i hi
  exact (D.colorKoszulPieceBasis K (Koszul.faceExponent S) i).repr.injective.subsingleton

lemma rankCochainIndex_isEmpty (S : Finset C) (j : ℕ) (hj : S.card < j) :
    IsEmpty (RelativeFaceIndex (rankSelection D S) (fun _ => False) j) := by
  refine ⟨fun F => ?_⟩
  have hcard := Finset.card_le_card F.property.1.2
  rw [D.face_card_eq_colors F.val F.property.1.1, F.property.2.1] at hcard
  omega

lemma rankCochain_subsingleton (S : Finset C) (j : ℕ) (hj : S.card < j) :
    Subsingleton ((D.rankCochainComplex K S).X j) := by
  letI := D.rankCochainIndex_isEmpty S j hj
  exact (relativeCochainCoordinateEquiv (K := K) (rankSelection D S)
    (fun _ => False) j).injective.subsingleton

lemma squarefree_cycles_iff (S : Finset C) (i j : ℕ) (hij : j + i = S.card)
    (y : D.colorKoszulPiece K (Koszul.faceExponent S) i) :
    (D.rankCochainComplex K S).d j (j + 1)
      (D.squarefreeCochainEquiv K S i j hij y) = 0 ↔
      (D.colorKoszulComplex K (Koszul.faceExponent S)).d i (i - 1) y = 0 := by
  cases i with
  | zero =>
      have hj : j = S.card := by omega
      letI := D.rankCochain_subsingleton K S (j + 1) (by omega)
      constructor
      · intro _
        rw [HomologicalComplex.shape _ 0 0 (by simp [ComplexShape.down])]
        rfl
      · intro _
        exact Subsingleton.elim _ _
  | succ i =>
      change ((D.rankCochainComplex K S).d j (j + 1)).hom
          (D.squarefreeCochainEquiv K S (i + 1) j hij y) = 0 ↔
        ((D.colorKoszulComplex K (Koszul.faceExponent S)).d (i + 1) i).hom y = 0
      rw [D.rankCochainComplex_d K S j, D.colorKoszulComplex_d K (Koszul.faceExponent S) i]
      change relativeAugmentedCoboundary (K := K) (rankSelection D S) (fun _ => False)
          (rankSelection_downward D S) (by intro s t h ht; exact ht) j
          (D.squarefreeCochainEquiv K S (i + 1) j hij y) = 0 ↔
        D.colorKoszulDifferential K (Koszul.faceExponent S) i y = 0
      rw [← D.squarefreeCochainEquiv_differential K S i j hij]
      exact (D.squarefreeCochainEquiv K S i (j + 1) (by omega)).map_eq_zero_iff

lemma squarefree_boundaries_iff (S : Finset C) (i j : ℕ) (hij : j + i = S.card)
    (y : D.colorKoszulPiece K (Koszul.faceExponent S) i) :
    (∃ x : (D.rankCochainComplex K S).X (j - 1),
      (D.rankCochainComplex K S).d (j - 1) j x = D.squarefreeCochainEquiv K S i j hij y) ↔
    ∃ x : D.colorKoszulPiece K (Koszul.faceExponent S) (i + 1),
      (D.colorKoszulComplex K (Koszul.faceExponent S)).d (i + 1) i x = y := by
  cases j with
  | zero =>
      letI := D.squarefreePiece_subsingleton K S (i + 1) (by omega)
      constructor
      · rintro ⟨x, hx⟩
        have hy : y = 0 := by
          apply (D.squarefreeCochainEquiv K S i 0 hij).injective
          rw [map_zero]
          rw [HomologicalComplex.shape _ 0 0 (by simp [ComplexShape.up])] at hx
          exact hx.symm
        exact ⟨0, by rw [map_zero, hy]⟩
      · rintro ⟨x, hx⟩
        have hx0 : x = 0 := Subsingleton.elim _ _
        have hy : y = 0 := by simpa only [hx0, map_zero] using hx.symm
        exact ⟨0, by rw [map_zero, hy, map_zero]⟩
  | succ j =>
      change (∃ x : (D.rankCochainComplex K S).X j,
        ((D.rankCochainComplex K S).d j (j + 1)).hom x =
          D.squarefreeCochainEquiv K S i (j + 1) hij y) ↔
        ∃ x : D.colorKoszulPiece K (Koszul.faceExponent S) (i + 1),
          ((D.colorKoszulComplex K (Koszul.faceExponent S)).d (i + 1) i).hom x = y
      rw [D.rankCochainComplex_d K S j, D.colorKoszulComplex_d K (Koszul.faceExponent S) i]
      change (∃ x : Module.Dual K (RelativeAugmentedChains (K := K)
          (rankSelection D S) (fun _ => False) j),
        relativeAugmentedCoboundary (K := K) (rankSelection D S) (fun _ => False)
          (rankSelection_downward D S) (by intro s t h ht; exact ht) j x =
          D.squarefreeCochainEquiv K S i (j + 1) hij y) ↔
        ∃ x : D.colorKoszulPiece K (Koszul.faceExponent S) (i + 1),
          D.colorKoszulDifferential K (Koszul.faceExponent S) i x = y
      constructor
      · rintro ⟨x, hx⟩
        obtain ⟨z, rfl⟩ := (D.squarefreeCochainEquiv K S (i + 1) j (by omega)).surjective x
        refine ⟨z, ?_⟩
        apply (D.squarefreeCochainEquiv K S i (j + 1) hij).injective
        exact (D.squarefreeCochainEquiv_differential K S i j (by omega) z).trans hx
      · rintro ⟨x, hx⟩
        refine ⟨D.squarefreeCochainEquiv K S (i + 1) j (by omega) x, ?_⟩
        rw [← D.squarefreeCochainEquiv_differential K S i j (by omega), hx]

/-- The comparison on genuine homology in all complementary nonnegative
augmented degrees.  It is induced by the explicit signed face map. -/
def squarefreeHomologyIso (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    (D.colorKoszulComplex K (Koszul.faceExponent S)).homology i ≅
      (D.rankCochainComplex K S).homology j :=
  (D.colorKoszulComplex K (Koszul.faceExponent S)).homologyIsoSc'
      (i + 1) i (i - 1) (by simp) (by cases i <;> simp) ≪≫
    shortComplexMiddleHomologyIso
      ((D.colorKoszulComplex K (Koszul.faceExponent S)).sc' (i + 1) i (i - 1))
      ((D.rankCochainComplex K S).sc' (j - 1) j (j + 1))
      (D.squarefreeCochainEquiv K S i j hij)
      (D.squarefree_cycles_iff K S i j hij)
      (D.squarefree_boundaries_iff K S i j hij) ≪≫
    ((D.rankCochainComplex K S).homologyIsoSc'
      (j - 1) j (j + 1) (by cases j <;> simp) (by simp)).symm

lemma squarefreeHomology_subsingleton (S : Finset C) (i : ℕ) (hi : S.card < i) :
    Subsingleton ((D.colorKoszulComplex K (Koszul.faceExponent S)).homology i) := by
  apply ModuleCat.isZero_iff_subsingleton.mp
  apply ShortComplex.isZero_homology_of_isZero_X₂
  exact ModuleCat.isZero_iff_subsingleton.mpr (D.squarefreePiece_subsingleton K S i hi)

/-- The complete squarefree colorful formula uses the ordinary derived Tor
submodule and the ordinary reduced cohomology, over every commutative ring.
The empty color set and every homological degree are included. -/
def squarefreeColorTorIso (S : Finset C) (i : ℕ) :
    ModuleCat.of K (D.colorTorPiece K (Koszul.faceExponent S) i) ≅
      reducedRelativeCohomology (K := K) (rankSelection D S) (fun _ => False)
        (rankSelection_downward D S) (by intro s t h ht; exact ht)
          ((S.card : ℤ) - i - 1) := by
  refine (D.colorTorPieceIso K (Koszul.faceExponent S) i).symm ≪≫ ?_
  by_cases hi : i ≤ S.card
  · have hq : -1 ≤ (S.card : ℤ) - i - 1 := by omega
    have hn : (((S.card : ℤ) - i - 1) + 1).toNat = S.card - i := by omega
    simp only [reducedRelativeCohomology, if_pos hq, hn]
    exact D.squarefreeHomologyIso K S i (S.card - i) (Nat.sub_add_cancel hi)
  · have hq : ¬ -1 ≤ (S.card : ℤ) - i - 1 := by omega
    simp only [reducedRelativeCohomology, if_neg hq]
    letI := D.squarefreeHomology_subsingleton K S i (by omega)
    exact
      { hom := 0
        inv := 0
        hom_inv_id := by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          exact Subsingleton.elim _ _
        inv_hom_id := by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          exact Subsingleton.elim _ _ }

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.ColorfulHomologyDecomposition -/
section

/-! # Completeness of the colorful Hochster decomposition

The homogeneous summands exhaust the actual Koszul homology.  Repeated colors
vanish, leaving a finite direct sum indexed by all subsets of the color set.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset CategoryTheory CategoryTheory.Limits CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)

lemma colorInclusion_retraction_ne (α β : C →₀ ℕ) (h : α ≠ β) :
    D.colorInclusion K α ≫ D.colorRetraction K β = 0 := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact Grading.projection_eq_zero (Ne.symm h) x.property

def colorProjector (β : C →₀ ℕ) : D.colorUnderlyingComplex K ⟶ D.colorUnderlyingComplex K :=
  D.colorRetraction K β ≫ D.colorInclusion K β

@[simp] lemma colorProjector_f (β : C →₀ ℕ) (i : ℕ) :
    (D.colorProjector K β).f i = ModuleCat.ofHom (D.colorProjection K β i) := rfl

/-- Every actual class is a finite sum of its homogeneous projections. -/
lemma color_homology_decomposition (i : ℕ) (x : (D.colorUnderlyingComplex K).homology i) :
    ∃ s : Finset (C →₀ ℕ),
      ∑ β ∈ s, HomologicalComplex.homologyMap (D.colorProjector K β) i x = x := by
  let Cx := D.colorUnderlyingComplex K
  obtain ⟨z, rfl⟩ := (ModuleCat.epi_iff_surjective (Cx.homologyπ i)).mp inferInstance x
  let s := ((D.koszulBasis K i).repr (Cx.iCycles i z)).support.image D.koszulColorDegree
  have hz : ∑ β ∈ s, HomologicalComplex.cyclesMap (D.colorProjector K β) i z = z := by
    apply (ModuleCat.mono_iff_injective (Cx.iCycles i)).mp inferInstance
    rw [map_sum]
    calc
      ∑ β ∈ s, Cx.iCycles i (HomologicalComplex.cyclesMap (D.colorProjector K β) i z) =
          ∑ β ∈ s, D.colorProjection K β i (Cx.iCycles i z) := by
        apply Finset.sum_congr rfl
        intro β hβ
        exact congrArg (fun f : Cx.cycles i ⟶ Cx.X i => f z)
          (HomologicalComplex.cyclesMap_i (D.colorProjector K β) i)
      _ = _ := Grading.sum_projections (D.koszulBasis K i) D.koszulColorDegree (Cx.iCycles i z)
  refine ⟨s, ?_⟩
  calc
    ∑ β ∈ s, HomologicalComplex.homologyMap (D.colorProjector K β) i (Cx.homologyπ i z) =
        ∑ β ∈ s, Cx.homologyπ i (HomologicalComplex.cyclesMap (D.colorProjector K β) i z) := by
      apply Finset.sum_congr rfl
      intro β hβ
      exact congrArg (fun f : Cx.cycles i ⟶ Cx.homology i => f z)
        (HomologicalComplex.homologyπ_naturality (D.colorProjector K β) i)
    _ = Cx.homologyπ i (∑ β ∈ s, HomologicalComplex.cyclesMap (D.colorProjector K β) i z) :=
      (map_sum _ _ _).symm
    _ = _ := congrArg (Cx.homologyπ i) hz

lemma colorHomology_retract_include (β : C →₀ ℕ) (i : ℕ)
    (x : (D.colorKoszulComplex K β).homology i) :
    HomologicalComplex.homologyMap (D.colorRetraction K β) i
      (HomologicalComplex.homologyMap (D.colorInclusion K β) i x) = x := by
  change (HomologicalComplex.homologyMap (D.colorInclusion K β) i ≫
    HomologicalComplex.homologyMap (D.colorRetraction K β) i) x = x
  rw [← HomologicalComplex.homologyMap_comp, D.colorInclusion_retraction K β,
    HomologicalComplex.homologyMap_id]
  rfl

lemma colorHomology_retract_include_ne (α β : C →₀ ℕ) (h : α ≠ β) (i : ℕ)
    (x : (D.colorKoszulComplex K α).homology i) :
    HomologicalComplex.homologyMap (D.colorRetraction K β) i
      (HomologicalComplex.homologyMap (D.colorInclusion K α) i x) = 0 := by
  change (HomologicalComplex.homologyMap (D.colorInclusion K α) i ≫
    HomologicalComplex.homologyMap (D.colorRetraction K β) i) x = 0
  rw [← HomologicalComplex.homologyMap_comp, D.colorInclusion_retraction_ne K α β h,
    HomologicalComplex.homologyMap_zero]
  rfl

lemma faceExponent_ne_of_ne {S T : Finset C} (h : S ≠ T) :
    Koszul.faceExponent S ≠ Koszul.faceExponent T := by
  intro he
  have he' := congrArg Finsupp.support he
  rw [faceExponent_support, faceExponent_support] at he'
  exact h he'

abbrev SquarefreeColorHomology (i : ℕ) :=
  ∀ S : Finset C, (D.colorKoszulComplex K (Koszul.faceExponent S)).homology i

def squarefreeAssembly (i : ℕ) :
    D.SquarefreeColorHomology K i →ₗ[K] (D.colorUnderlyingComplex K).homology i :=
  ∑ S : Finset C, (HomologicalComplex.homologyMap (D.colorInclusion K (Koszul.faceExponent S)) i).hom
    ∘ₗ LinearMap.proj S

def squarefreeDecomposition (i : ℕ) :
    (D.colorUnderlyingComplex K).homology i →ₗ[K] D.SquarefreeColorHomology K i :=
  LinearMap.pi fun S =>
    (HomologicalComplex.homologyMap (D.colorRetraction K (Koszul.faceExponent S)) i).hom

lemma squarefreeDecomposition_assembly (i : ℕ) (x : D.SquarefreeColorHomology K i) :
    D.squarefreeDecomposition K i (D.squarefreeAssembly K i x) = x := by
  funext T
  simp only [squarefreeAssembly, squarefreeDecomposition, LinearMap.pi_apply,
    LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply, map_sum]
  rw [Finset.sum_eq_single T]
  · exact D.colorHomology_retract_include K _ i _
  · intro S hS hST
    exact D.colorHomology_retract_include_ne K _ _ (faceExponent_ne_of_ne hST) i _
  · intro hT
    exact (hT (Finset.mem_univ T)).elim

lemma squarefreeAssembly_decomposition_include (S : Finset C) (i : ℕ)
    (x : (D.colorKoszulComplex K (Koszul.faceExponent S)).homology i) :
    D.squarefreeAssembly K i (D.squarefreeDecomposition K i
      (HomologicalComplex.homologyMap (D.colorInclusion K (Koszul.faceExponent S)) i x)) =
      HomologicalComplex.homologyMap (D.colorInclusion K (Koszul.faceExponent S)) i x := by
  simp only [squarefreeAssembly, squarefreeDecomposition, LinearMap.pi_apply,
    LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply]
  rw [Finset.sum_eq_single S]
  · rw [D.colorHomology_retract_include K (Koszul.faceExponent S) i]
  · intro T hT hTS
    rw [D.colorHomology_retract_include_ne K _ _ (faceExponent_ne_of_ne (Ne.symm hTS)), map_zero]
  · intro hS
    exact (hS (Finset.mem_univ S)).elim

lemma squarefreeAssembly_decomposition (i : ℕ) (x : (D.colorUnderlyingComplex K).homology i) :
    D.squarefreeAssembly K i (D.squarefreeDecomposition K i x) = x := by
  obtain ⟨s, hs⟩ := D.color_homology_decomposition K i x
  rw [← hs, map_sum, map_sum]
  apply Finset.sum_congr rfl
  intro β hβ
  by_cases h : ∀ c, β c ≤ 1
  · have he : Koszul.faceExponent β.support = β := by
      ext c
      rw [Koszul.faceExponent_apply]
      by_cases hc : c ∈ β.support
      · rw [if_pos hc]
        have hn := Finsupp.mem_support_iff.mp hc
        have hb := h c
        omega
      · rw [if_neg hc]
        exact (Finsupp.notMem_support_iff.mp hc).symm
    rw [← he, colorProjector, HomologicalComplex.homologyMap_comp]
    exact D.squarefreeAssembly_decomposition_include K β.support i _
  · push_neg at h
    obtain ⟨c, hc⟩ := h
    letI := D.repeatedColorHomology_subsingleton K β c (by omega) i
    have hz : HomologicalComplex.homologyMap (D.colorProjector K β) i x = 0 := by
      rw [colorProjector, HomologicalComplex.homologyMap_comp]
      change HomologicalComplex.homologyMap (D.colorInclusion K β) i
        (HomologicalComplex.homologyMap (D.colorRetraction K β) i x) = 0
      have hr : HomologicalComplex.homologyMap (D.colorRetraction K β) i x = 0 :=
        Subsingleton.elim _ _
      rw [hr, map_zero]
    rw [hz, map_zero, map_zero]

/-- A finite decomposition of the entire actual homology, with no missing colors. -/
def squarefreeHomologyEquiv (i : ℕ) :
    (D.colorUnderlyingComplex K).homology i ≃ₗ[K] D.SquarefreeColorHomology K i where
  toLinearMap := D.squarefreeDecomposition K i
  invFun := D.squarefreeAssembly K i
  left_inv := D.squarefreeAssembly_decomposition K i
  right_inv := D.squarefreeDecomposition_assembly K i

/-- The same decomposition inside Mathlib's ordinary derived tensor module. -/
def squarefreeOrdinaryTorEquiv (i : ℕ) :
    D.ordinaryColorTor K i ≃ₗ[K] D.SquarefreeColorHomology K i :=
  (D.colorTorIso K i).toLinearEquiv.trans (D.squarefreeHomologyEquiv K i)

end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.RelativeColorKoszul -/
section

/-! # Color strands of the Koszul complex of the actual relative face module

The coefficient module is the literal restriction ideal, with its inherited
parameter action.  Its basis, differential and grading are identified inside
the absolute coefficient complex.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical Finset CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable {D : FourPapers.Universal.ProperlyColoredComplex V C} (Q : D.Subcomplex) (K)

local instance relativeColorParameterAlgebra : Algebra (MvPolynomial C K) (D.Ring K) :=
  (D.parameterAction K).toRingHom.toAlgebra

local instance relativeColorScalarTower : IsScalarTower K (MvPolynomial C K) (D.Ring K) :=
  IsScalarTower.of_algHom (D.parameterAction K)

/-- The ideal kernel with its actual restricted polynomial-parameter action. -/
def relativeParameterKernel : Submodule (MvPolynomial C K) (D.Ring K) :=
  (RingHom.ker (Q.restriction K).toRingHom).restrictScalars (MvPolynomial C K)

local instance relativeColorKernelScalarTower :
    IsScalarTower K (MvPolynomial C K) (Q.relativeParameterKernel K) :=
  inferInstance

/-- The inherited parameter module has exactly the independently defined
restriction-kernel carrier and coefficient scalar action. -/
def relativeParameterEquiv : Q.relativeParameterKernel K ≃ₗ[K] Q.Relative K where
  toFun x := ⟨x.val, x.property⟩
  invFun x := ⟨x.val, x.property⟩
  left_inv x := rfl
  right_inv x := rfl
  map_add' x y := rfl
  map_smul' c x := rfl

def relativeRingBasis : Module.Basis Q.RelativeIndex K (Q.relativeParameterKernel K) :=
  (Q.relativeBasis K).map (Q.relativeParameterEquiv K).symm

@[simp] theorem relativeRingBasis_val (a : Q.RelativeIndex) :
    (Q.relativeRingBasis K a).val = D.monomial K a.val.val := by
  change (Q.relativeBasis K a).val = _
  exact Q.relativeBasis_apply a

abbrev RelativeKoszulIndex (i : ℕ) := Σ s : Set.powersetCard C i, Q.RelativeIndex

def relativeKoszulBasis (i : ℕ) :
    Module.Basis (Q.RelativeKoszulIndex i) K
      (Set.powersetCard C i →₀ Q.relativeParameterKernel K) :=
  Finsupp.basis fun _ : Set.powersetCard C i => Q.relativeRingBasis K

@[simp] theorem relativeKoszulBasis_apply (i : ℕ) (t : Q.RelativeKoszulIndex i) :
    Q.relativeKoszulBasis K i t = Finsupp.single t.1 (Q.relativeRingBasis K t.2) := by
  simp only [relativeKoszulBasis, Finsupp.coe_basis]

def relativeCoefficientInclusion (i : ℕ) :
    (Set.powersetCard C i →₀ Q.relativeParameterKernel K) →ₗ[K]
      (Set.powersetCard C i →₀ D.Ring K) :=
  Finsupp.mapRange.linearMap ((Q.relativeParameterKernel K).subtype.restrictScalars K)

@[simp] theorem relativeCoefficientInclusion_apply (i : ℕ)
    (x : Set.powersetCard C i →₀ Q.relativeParameterKernel K) (s : Set.powersetCard C i) :
    Q.relativeCoefficientInclusion K i x s = (x s).val := rfl

lemma relativeCoefficientInclusion_injective (i : ℕ) :
    Function.Injective (Q.relativeCoefficientInclusion K i) := by
  intro x y h
  apply Finsupp.ext
  intro s
  apply Subtype.ext
  exact congrArg (fun z : Set.powersetCard C i →₀ D.Ring K => z s) h

@[simp] theorem relativeCoefficientInclusion_basis (i : ℕ) (t : Q.RelativeKoszulIndex i) :
    Q.relativeCoefficientInclusion K i (Q.relativeKoszulBasis K i t) =
      D.koszulBasis K i ⟨t.1, t.2.val⟩ := by
  rw [Q.relativeKoszulBasis_apply (K := K), D.koszulBasis_apply (K := K)]
  simp only [relativeCoefficientInclusion, Finsupp.mapRange.linearMap_apply,
    Finsupp.mapRange_single, LinearMap.restrictScalars_apply, Submodule.subtype_apply,
    Q.relativeRingBasis_val (K := K)]

/-- The ordinary tensor-resolution differential on these actual coefficients. -/
def relativeKoszulDifferential (i : ℕ) :
    (Set.powersetCard C (i + 1) →₀ Q.relativeParameterKernel K) →ₗ[K]
      (Set.powersetCard C i →₀ Q.relativeParameterKernel K) :=
  (Koszul.coordinateDifferential (MvPolynomial.X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) (Q.relativeParameterKernel K)) i).restrictScalars K

lemma relativeKoszulDifferential_comp (i : ℕ) :
    (Q.relativeKoszulDifferential K i).comp (Q.relativeKoszulDifferential K (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  exact LinearMap.congr_fun (Koszul.coordinateDifferential_comp
    (MvPolynomial.X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) (Q.relativeParameterKernel K)) i) x

lemma relativeCoefficientInclusion_differential (i : ℕ) :
    (Q.relativeCoefficientInclusion K i).comp (Q.relativeKoszulDifferential K i) =
      (D.koszulDifferential K i).comp (Q.relativeCoefficientInclusion K (i + 1)) := by
  apply LinearMap.ext
  intro x
  exact LinearMap.congr_fun
    (coordinateDifferential_natural (MvPolynomial.X : C → MvPolynomial C K)
      (ModuleCat.ofHom (Q.relativeParameterKernel K).subtype) i) x

def relativeKoszulComplex : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of
    (fun i => ModuleCat.of K (Set.powersetCard C i →₀ Q.relativeParameterKernel K))
    (fun i => ModuleCat.ofHom (Q.relativeKoszulDifferential K i))
    (fun i => ModuleCat.hom_ext (Q.relativeKoszulDifferential_comp K i))

@[simp] theorem relativeKoszulComplex_d (i : ℕ) :
    (Q.relativeKoszulComplex K).d (i + 1) i = ModuleCat.ofHom (Q.relativeKoszulDifferential K i) := by
  simp [relativeKoszulComplex]

def relativeKoszulInclusion : Q.relativeKoszulComplex K ⟶ D.colorUnderlyingComplex K where
  f i := ModuleCat.ofHom (Q.relativeCoefficientInclusion K i)
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [Q.relativeKoszulComplex_d (K := K), D.colorUnderlyingComplex_d (K := K)]
    exact ModuleCat.hom_ext (Q.relativeCoefficientInclusion_differential K j).symm

def relativeKoszulColorDegree {i : ℕ} (t : Q.RelativeKoszulIndex i) : C →₀ ℕ :=
  D.koszulColorDegree ⟨t.1, t.2.val⟩

def relativeColorKoszulPiece (β : C →₀ ℕ) (i : ℕ) :
    Submodule K (Set.powersetCard C i →₀ Q.relativeParameterKernel K) :=
  Grading.Piece (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree β

/-- A module over the coefficient ring carries its canonical additive inverses.
This exposes that structure through the opaque homogeneous-submodule definition. -/
instance relativeColorKoszulPieceAddCommGroup (β : C →₀ ℕ) (i : ℕ) :
    AddCommGroup (Q.relativeColorKoszulPiece K β i) :=
  Module.addCommMonoidToAddCommGroup K

def relativeColorKoszulPieceBasis (β : C →₀ ℕ) (i : ℕ) :
    Module.Basis {t : Q.RelativeKoszulIndex i // Q.relativeKoszulColorDegree t = β} K
      (Q.relativeColorKoszulPiece K β i) :=
  Grading.restrictedBasis (Q.relativeKoszulBasis K i) (fun t => Q.relativeKoszulColorDegree t = β)

@[simp] theorem relativeColorKoszulPieceBasis_val (β : C →₀ ℕ) (i : ℕ)
    (t : {t : Q.RelativeKoszulIndex i // Q.relativeKoszulColorDegree t = β}) :
    (Q.relativeColorKoszulPieceBasis K β i t).val = Q.relativeKoszulBasis K i t.val := by
  exact Grading.restrictedBasis_val (Q.relativeKoszulBasis K i)
    (fun t => Q.relativeKoszulColorDegree t = β) t

def nextRelativeKoszulIndex {i : ℕ} (t : Q.RelativeKoszulIndex (i + 1))
    (j : {j // j ∈ t.1.val}) (v : V)
    (hv : D.allowed (Finsupp.single v 1 + t.2.val.val)) : Q.RelativeKoszulIndex i :=
  ⟨Koszul.eraseIndex t.1 j, ⟨⟨Finsupp.single v 1 + t.2.val.val, hv⟩, fun h =>
    t.2.property (Q.downward (Finsupp.support_mono le_add_self) h)⟩⟩

lemma nextRelativeKoszulIndex_degree {i : ℕ} (t : Q.RelativeKoszulIndex (i + 1))
    (j : {j // j ∈ t.1.val}) (v : V) (hc : D.color v = j.val)
    (hv : D.allowed (Finsupp.single v 1 + t.2.val.val)) :
    Q.relativeKoszulColorDegree (Q.nextRelativeKoszulIndex t j v hv) =
      Q.relativeKoszulColorDegree t :=
  D.nextKoszulIndex_degree ⟨t.1, t.2.val⟩ j v hc hv

lemma relativeKoszulDifferential_basis (i : ℕ) (t : Q.RelativeKoszulIndex (i + 1)) :
    Q.relativeKoszulDifferential K i (Q.relativeKoszulBasis K (i + 1) t) =
      ∑ j : {j // j ∈ t.1.val},
        ∑ v ∈ Finset.univ.filter (fun v => D.color v = j.val),
          if h : D.allowed (Finsupp.single v 1 + t.2.val.val) then
            TauCeti.ExteriorAlgebra.basisEraseSign j.val t.1.val •
              Q.relativeKoszulBasis K i (Q.nextRelativeKoszulIndex t j v h)
          else 0 := by
  apply Q.relativeCoefficientInclusion_injective K i
  have he := LinearMap.congr_fun (Q.relativeCoefficientInclusion_differential K i)
    (Q.relativeKoszulBasis K (i + 1) t)
  rw [LinearMap.comp_apply, LinearMap.comp_apply] at he
  rw [he, Q.relativeCoefficientInclusion_basis (K := K), D.koszulDifferential_basis (K := K)]
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro j hj
  apply Finset.sum_congr rfl
  intro v hv
  split_ifs with h
  · exact ((map_zsmul_unit (Q.relativeCoefficientInclusion K i)
      (TauCeti.ExteriorAlgebra.basisEraseSign j.val t.1.val)
      (Q.relativeKoszulBasis K i (Q.nextRelativeKoszulIndex t j v h))).trans
        (congrArg (fun x => TauCeti.ExteriorAlgebra.basisEraseSign j.val t.1.val • x)
          (Q.relativeCoefficientInclusion_basis K i (Q.nextRelativeKoszulIndex t j v h)))).symm
  · rw [map_zero]

lemma relativeKoszulDifferential_homogeneous (β : C →₀ ℕ) (i : ℕ)
    {x : Set.powersetCard C (i + 1) →₀ Q.relativeParameterKernel K}
    (hx : x ∈ Q.relativeColorKoszulPiece K β (i + 1)) :
    Q.relativeKoszulDifferential K i x ∈ Q.relativeColorKoszulPiece K β i := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨t, ht, rfl⟩ := hx
      rw [Q.relativeKoszulDifferential_basis (K := K)]
      apply Submodule.sum_mem
      intro j hj
      apply Submodule.sum_mem
      intro v hv
      split_ifs with h
      · apply (Submodule.smul_mem_iff' _ (TauCeti.ExteriorAlgebra.basisEraseSign j.val t.1.val)).2
        exact Submodule.subset_span ⟨Q.nextRelativeKoszulIndex t j v h,
          (Q.nextRelativeKoszulIndex_degree t j v (Finset.mem_filter.mp hv).2 h).trans ht, rfl⟩
      · exact Submodule.zero_mem _
  | zero => simpa only [map_zero] using (Q.relativeColorKoszulPiece K β i).zero_mem
  | add x y hx hy ihx ihy => simpa only [map_add] using (Q.relativeColorKoszulPiece K β i).add_mem ihx ihy
  | smul c x hx ih => simpa only [map_smul] using (Q.relativeColorKoszulPiece K β i).smul_mem c ih

def relativeColorKoszulDifferential (β : C →₀ ℕ) (i : ℕ) :
    Q.relativeColorKoszulPiece K β (i + 1) →ₗ[K] Q.relativeColorKoszulPiece K β i :=
  ((Q.relativeKoszulDifferential K i).domRestrict _).codRestrict _
    (fun x => Q.relativeKoszulDifferential_homogeneous K β i x.property)

lemma relativeColorKoszulDifferential_comp (β : C →₀ ℕ) (i : ℕ) :
    (Q.relativeColorKoszulDifferential K β i).comp
      (Q.relativeColorKoszulDifferential K β (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  exact Subtype.ext (LinearMap.congr_fun (Q.relativeKoszulDifferential_comp K i) x.val)

def relativeColorKoszulComplex (β : C →₀ ℕ) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (Q.relativeColorKoszulPiece K β i))
    (fun i => ModuleCat.ofHom (Q.relativeColorKoszulDifferential K β i))
    (fun i => ModuleCat.hom_ext (Q.relativeColorKoszulDifferential_comp K β i))

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeColorGrading -/
section

/-! # Actual color projections on the relative Koszul complex -/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable {D : FourPapers.Universal.ProperlyColoredComplex V C} (Q : D.Subcomplex) (K)

@[simp] theorem relativeColorKoszulComplex_d (β : C →₀ ℕ) (i : ℕ) :
    (Q.relativeColorKoszulComplex K β).d (i + 1) i =
      ModuleCat.ofHom (Q.relativeColorKoszulDifferential K β i) := by
  simp [relativeColorKoszulComplex]

def relativeColorProjection (β : C →₀ ℕ) (i : ℕ) :
    Module.End K (Set.powersetCard C i →₀ Q.relativeParameterKernel K) :=
  Grading.projection (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree β

theorem relativeColorProjection_commutes (β : C →₀ ℕ) (i : ℕ) :
    (Q.relativeColorProjection K β i).comp (Q.relativeKoszulDifferential K i) =
      (Q.relativeKoszulDifferential K i).comp (Q.relativeColorProjection K β (i + 1)) := by
  apply (Q.relativeKoszulBasis K (i + 1)).ext
  intro t
  change Q.relativeColorProjection K β i (Q.relativeKoszulDifferential K i (Q.relativeKoszulBasis K (i + 1) t)) =
    Q.relativeKoszulDifferential K i (Q.relativeColorProjection K β (i + 1) (Q.relativeKoszulBasis K (i + 1) t))
  have hm := Q.relativeKoszulDifferential_homogeneous K (Q.relativeKoszulColorDegree t) i
    (Grading.basis_mem_piece (Q.relativeKoszulBasis K (i + 1)) Q.relativeKoszulColorDegree t)
  change Grading.projection _ _ β _ = Q.relativeKoszulDifferential K i (Grading.projection _ _ β _)
  rw [Grading.projection_basis]
  by_cases ht : Q.relativeKoszulColorDegree t = β
  · rw [if_pos ht]
    exact Grading.projection_eq_self (ht ▸ hm)
  · rw [if_neg ht, map_zero]
    exact Grading.projection_eq_zero (Ne.symm ht) hm

def relativeColorInclusion (β : C →₀ ℕ) : Q.relativeColorKoszulComplex K β ⟶ Q.relativeKoszulComplex K where
  f i := ModuleCat.ofHom (Q.relativeColorKoszulPiece K β i).subtype
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [relativeKoszulComplex_d (K := K), relativeColorKoszulComplex_d (K := K)]
    rfl

def relativeColorRetraction (β : C →₀ ℕ) : Q.relativeKoszulComplex K ⟶ Q.relativeColorKoszulComplex K β where
  f i := ModuleCat.ofHom ((Q.relativeColorProjection K β i).codRestrict _
    (fun x => Grading.projection_mem (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree β x))
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [relativeKoszulComplex_d (K := K), relativeColorKoszulComplex_d (K := K)]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact (LinearMap.congr_fun (Q.relativeColorProjection_commutes K β j) x).symm

theorem relativeColorInclusion_retraction (β : C →₀ ℕ) :
    Q.relativeColorInclusion K β ≫ Q.relativeColorRetraction K β = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact Grading.projection_eq_self x.property

theorem relativeColorHomology_injective (β : C →₀ ℕ) (i : ℕ) :
    Function.Injective (HomologicalComplex.homologyMap (Q.relativeColorInclusion K β) i).hom := by
  have hs : HomologicalComplex.homologyMap (Q.relativeColorInclusion K β) i ≫
      HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i = 𝟙 _ := by
    rw [← HomologicalComplex.homologyMap_comp, relativeColorInclusion_retraction,
      HomologicalComplex.homologyMap_id]
  intro x y h
  have hh := congrArg (HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i) h
  simpa only [← ModuleCat.comp_apply, hs, ModuleCat.id_apply] using hh


end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeSquarefreeCochainMap -/
section

/-! # The squarefree relative Koszul strand and actual relative cochains

The relative basis consists of the ambient monomials whose supports are
outside the subcomplex.  Restricting the absolute complementary-face index
gives exactly the usual basis of the dual relative chain quotient.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical Finset CommAlg CategoryTheory
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (Q : D.Subcomplex) (K)
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance relativeSquarefreeCochainMapVertexOrder : LinearOrder V := D.colorLinearOrder

abbrev RelativeColorStrandIndex (β : C →₀ ℕ) (i : ℕ) :=
  {t : Q.RelativeKoszulIndex i // Q.relativeKoszulColorDegree t = β}

def relativeColorStrandAbsolute {β : C →₀ ℕ} {i : ℕ}
    (t : Q.RelativeColorStrandIndex β i) : D.ColorStrandIndex β i :=
  ⟨⟨t.val.1, t.val.2.val⟩, t.property⟩

def relativeColorStrandSubtypeEquiv (β : C →₀ ℕ) (i : ℕ) :
    Q.RelativeColorStrandIndex β i ≃
      {t : D.ColorStrandIndex β i // ¬ Q.face t.val.2.val.support} where
  toFun t := ⟨Q.relativeColorStrandAbsolute t, t.val.2.property⟩
  invFun t := ⟨⟨t.val.val.1, ⟨t.val.val.2, t.property⟩⟩, t.val.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

def relativeSelectedFaceEquiv (S : Finset C) (j : ℕ) :
    {F : RelativeFaceIndex (rankSelection D S) (fun _ => False) j // ¬ Q.face F.val} ≃
      RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j where
  toFun F := ⟨F.val.val, F.val.property.1, F.val.property.2.1, fun h => F.property h.1⟩
  invFun F := ⟨⟨F.val, F.property.1, F.property.2.1, not_false⟩,
    fun h => F.property.2.2 ⟨h, F.property.1.2⟩⟩
  left_inv _ := rfl
  right_inv _ := rfl

def squarefreeCochainIndex (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    Q.RelativeColorStrandIndex (Koszul.faceExponent S) i ≃
      RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j :=
  (Q.relativeColorStrandSubtypeEquiv (Koszul.faceExponent S) i).trans
    (((D.squarefreeCochainIndex S i j hij).subtypeEquiv (by
      intro t
      change (¬ Q.face t.val.2.val.support) ↔
        ¬ Q.face (D.squarefreeCochainIndex S i j hij t).val
      rw [D.squarefreeCochainIndex_face])).trans (Q.relativeSelectedFaceEquiv S j))

@[simp] theorem squarefreeCochainIndex_face (S : Finset C) (i j : ℕ)
    (hij : j + i = S.card) (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) i) :
    (Q.squarefreeCochainIndex S i j hij t).val = t.val.2.val.val.support := rfl

theorem squarefree_strand_support_colors (S : Finset C) (i : ℕ)
    (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) i) :
    t.val.2.val.val.support.image D.color = S \ t.val.1.val :=
  D.squarefree_strand_support_colors S i (Q.relativeColorStrandAbsolute t)

theorem strandIndex_exterior_le {β : C →₀ ℕ} {i : ℕ} (t : Q.RelativeColorStrandIndex β i) :
    Koszul.faceExponent t.val.1.val ≤ β :=
  D.strandIndex_exterior_le (Q.relativeColorStrandAbsolute t)

def nextRelativeColorStrandIndex {β : C →₀ ℕ} {i : ℕ}
    (t : Q.RelativeColorStrandIndex β (i + 1))
    (c : {c // c ∈ t.val.1.val}) (v : V) (hc : D.color v = c.val)
    (hv : D.allowed (Finsupp.single v 1 + t.val.2.val.val)) :
    Q.RelativeColorStrandIndex β i :=
  ⟨Q.nextRelativeKoszulIndex t.val c v hv,
    (Q.nextRelativeKoszulIndex_degree t.val c v hc hv).trans t.property⟩

/-- Exterior deletion is independent of the equality decision on colors. -/
@[simp] theorem nextRelativeColorStrandIndex_exterior {β : C →₀ ℕ} {i : ℕ}
    (t : Q.RelativeColorStrandIndex β (i + 1)) (c : {c // c ∈ t.val.1.val})
    (v : V) (hc : D.color v = c.val)
    (hv : D.allowed (Finsupp.single v 1 + t.val.2.val.val)) :
    (Q.nextRelativeColorStrandIndex t c v hc hv).val.1.val = t.val.1.val.erase c.val := by
  change (Koszul.eraseIndex t.val.1 c).val = t.val.1.val.erase c.val
  ext j
  simp only [Koszul.eraseIndex, Finset.mem_erase]

theorem relativeColorKoszulDifferential_basis (β : C →₀ ℕ) (i : ℕ)
    (t : Q.RelativeColorStrandIndex β (i + 1)) :
    Q.relativeColorKoszulDifferential K β i
      (Q.relativeColorKoszulPieceBasis K β (i + 1) t) =
      ∑ c : {c // c ∈ t.val.1.val}, ∑ v : {v : V // D.color v = c.val},
        if h : D.allowed (Finsupp.single v.val 1 + t.val.2.val.val) then
          TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
            Q.relativeColorKoszulPieceBasis K β i (Q.nextRelativeColorStrandIndex t c v.val v.property h)
        else 0 := by
  letI : LinearOrder V := D.colorLinearOrder
  apply Subtype.ext
  change Q.relativeKoszulDifferential K i
    ((Q.relativeColorKoszulPieceBasis K β (i + 1) t).val) = _
  rw [Q.relativeColorKoszulPieceBasis_val K]
  rw [Q.relativeKoszulDifferential_basis K i t.val]
  simp only [Submodule.coe_sum, Submodule.coe_smul_of_tower]
  apply Finset.sum_congr rfl
  intro c hc
  trans ∑ v : {v : V // D.color v = c.val}, if h : D.allowed (Finsupp.single v.val 1 + t.val.2.val.val) then
      TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
        Q.relativeKoszulBasis K i (Q.nextRelativeKoszulIndex t.val c v.val h) else 0
  · apply Finset.sum_subtype
    intro v
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  · apply Finset.sum_congr rfl
    intro v hv
    split_ifs with h
    · calc
        TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
            Q.relativeKoszulBasis K i (Q.nextRelativeKoszulIndex t.val c v.val h) =
          TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
            (Q.relativeColorKoszulPieceBasis K β i
              (Q.nextRelativeColorStrandIndex t c v.val v.property h)).val := by
            rw [Q.relativeColorKoszulPieceBasis_val K]
            rfl
        _ = (TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
            Q.relativeColorKoszulPieceBasis K β i
              (Q.nextRelativeColorStrandIndex t c v.val v.property h)).val :=
          ((Q.relativeColorKoszulPiece K β i).subtype.map_smul_of_tower
            (TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val)
            (Q.relativeColorKoszulPieceBasis K β i
              (Q.nextRelativeColorStrandIndex t c v.val v.property h))).symm
    · rfl

/-- The explicit complement sign acts on the independently defined ordinary
relative cochain basis. -/
def squarefreeCochainEquiv (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    Q.relativeColorKoszulPiece K (Koszul.faceExponent S) i ≃ₗ[K]
      Module.Dual K (RelativeAugmentedChains (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S) j) :=
  (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i).equiv
    (((relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j).reindex
      (Q.squarefreeCochainIndex S i j hij).symm).groupSMul
        (fun t => complementSign S t.val.1.val)) (Equiv.refl _)

@[simp] theorem squarefreeCochainEquiv_basis (S : Finset C) (i j : ℕ)
    (hij : j + i = S.card) (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) i) :
    Q.squarefreeCochainEquiv K S i j hij
      (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i t) =
      complementSign S t.val.1.val •
        relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j
          (Q.squarefreeCochainIndex S i j hij t) := by
  simp only [squarefreeCochainEquiv, Module.Basis.equiv_apply, Equiv.refl_apply,
    Module.Basis.groupSMul_apply, Pi.smul_apply', Pi.smul_apply, Module.Basis.reindex_apply, Equiv.symm_symm]

@[simp] theorem squarefreeCochainEquiv_basis_coordinate (S : Finset C) (i j : ℕ)
    (hij : j + i = S.card) (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) i)
    (F : RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j
      (Q.squarefreeCochainEquiv K S i j hij
        (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i t)) F =
      complementSign S t.val.1.val •
        (if Q.squarefreeCochainIndex S i j hij t = F then (1 : K) else 0) := by
  rw [Q.squarefreeCochainEquiv_basis K, map_zsmul_unit]
  exact congrArg (fun x : K => complementSign S t.val.1.val • x)
    (relativeCochainBasis_coordinate (rankSelection D S) (rankSelection Q.toColoredComplex S) j _ F)

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeSquarefreeCochainDifferential -/
section

/-! # The relative signed comparison intertwines the actual differentials

The proof expands the already defined quotient-ring Koszul differential and
the independently defined simplicial coboundary.  Their matrices agree by
complementary incidence and the integral complement-sign identity.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical Finset CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (Q : D.Subcomplex) (K)
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance relativeSquarefreeCochainDifferentialVertexOrder : LinearOrder V := D.colorLinearOrder

lemma squarefree_next_face_eq_iff (S : Finset C) (i j : ℕ) (hij : (j + 1) + i = S.card)
    (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) (i + 1))
    (c : {c // c ∈ t.val.1.val}) (v : {v : V // D.color v = c.val})
    (ha : D.allowed (Finsupp.single v.val 1 + t.val.2.val.val))
    (G : RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)) :
    Q.squarefreeCochainIndex S i (j + 1) hij
      (Q.nextRelativeColorStrandIndex t c v.val v.property ha) = G ↔
      insert v.val t.val.2.val.val.support = G.val := by
  rw [Subtype.ext_iff, Q.squarefreeCochainIndex_face]
  change (Finsupp.single v.val 1 + t.val.2.val.val).support = G.val ↔ _
  rw [D.addedExponent_support]

lemma squarefree_differential_coordinate (S : Finset C) (i j : ℕ)
    (hij : (j + 1) + i = S.card)
    (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) (i + 1))
    (G : RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)
      (Q.squarefreeCochainEquiv K S i (j + 1) hij
        (Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i
          (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1) t))) G =
      ∑ c : {c // c ∈ t.val.1.val}, ∑ v : {v : V // D.color v = c.val},
        if insert v.val t.val.2.val.val.support = G.val then
          (TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val *
            complementSign S (t.val.1.val.erase c.val)) • (1 : K) else 0 := by
  rw [Q.relativeColorKoszulDifferential_basis K]
  simp only [map_sum, LinearMap.sum_apply, Finset.sum_apply]
  apply Finset.sum_congr rfl
  intro c hc
  apply Finset.sum_congr rfl
  intro v hv
  by_cases ha : D.allowed (Finsupp.single v.val 1 + t.val.2.val.val)
  · rw [dif_pos ha, map_zsmul_unit, map_zsmul_unit]
    change TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
      relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)
        (Q.squarefreeCochainEquiv K S i (j + 1) hij
          (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i
            (Q.nextRelativeColorStrandIndex t c v.val v.property ha))) G = _
    rw [Q.squarefreeCochainEquiv_basis_coordinate K]
    simp only [Q.squarefree_next_face_eq_iff S i j hij t c v ha]
    rw [Q.nextRelativeColorStrandIndex_exterior]
    change TauCeti.ExteriorAlgebra.basisEraseSign c.val t.val.1.val •
      (complementSign S (t.val.1.val.erase c.val) •
        (if insert v.val t.val.2.val.val.support = G.val then (1 : K) else 0)) = _
    simp only [smul_smul, smul_ite, smul_zero]
  · have hn : insert v.val t.val.2.val.val.support ≠ G.val := by
      intro he
      apply ha
      change D.face (Finsupp.single v.val 1 + t.val.2.val.val).support
      rw [D.addedExponent_support, he]
      exact G.property.1.1
    simp only [dif_neg ha, map_zero, LinearMap.zero_apply, Pi.zero_apply, if_neg hn]

lemma squarefree_coboundary_coordinate (S : Finset C) (i j : ℕ)
    (hij : j + (i + 1) = S.card)
    (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) (i + 1))
    (G : RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)
      (relativeAugmentedCoboundary (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j
        (Q.squarefreeCochainEquiv K S (i + 1) j hij
          (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1) t))) G =
      ∑ v : {v // v ∈ G.val},
        if G.val.erase v.val = t.val.2.val.val.support then
          (complementSign S t.val.1.val *
            TauCeti.ExteriorAlgebra.basisEraseSign v.val G.val) • (1 : K) else 0 := by
  rw [Q.squarefreeCochainEquiv_basis K, map_zsmul_unit, map_zsmul_unit]
  change complementSign S t.val.1.val •
    relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)
      (relativeAugmentedCoboundary (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j
        (relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j
          (Q.squarefreeCochainIndex S (i + 1) j hij t))) G = _
  rw [relativeAugmentedCoboundary_basis_coordinate, Q.squarefreeCochainIndex_face]
  simp only [Finset.smul_sum, smul_smul, smul_ite, smul_zero]

/-- The chain comparison uses the ordinary signed simplicial coboundary,
with complementary degrees `j+i=|S|`. -/
theorem squarefreeCochainEquiv_differential (S : Finset C) (i j : ℕ)
    (hij : j + (i + 1) = S.card)
    (x : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) (i + 1)) :
    Q.squarefreeCochainEquiv K S i (j + 1) (by omega)
      (Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i x) =
    relativeAugmentedCoboundary (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j
      (Q.squarefreeCochainEquiv K S (i + 1) j hij x) := by
  suffices he : (Q.squarefreeCochainEquiv K S i (j + 1) (by omega)).toLinearMap.comp
      (Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i) =
      (relativeAugmentedCoboundary (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j).comp
          (Q.squarefreeCochainEquiv K S (i + 1) j hij).toLinearMap by
    exact LinearMap.congr_fun he x
  apply (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1)).ext
  intro t
  apply relativeCochainCoordinates_injective (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)
  funext G
  change relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) (j + 1)
      (Q.squarefreeCochainEquiv K S i (j + 1) _
        (Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i
          (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) (i + 1) t))) G = _
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
  rw [Q.squarefree_differential_coordinate K S i j (by omega) t G,
    Q.squarefree_coboundary_coordinate K S i j hij t G]
  exact D.complementary_incidence_matrix S t.val.1.val
    ((faceExponent_le_iff _ _).mp (Q.strandIndex_exterior_le t))
    t.val.2.val.val.support G.val (Q.squarefree_strand_support_colors S (i + 1) t)
    G.property.1.1 G.property.1.2

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeSquarefreeCochainHomology -/
section

/-! # All degrees of the relative squarefree colorful Hochster comparison

The homology is the ordinary categorical homology of the actual Koszul and
augmented simplicial cochain complexes.  The degree-zero ends are handled by
literal kernels and images; no artificial identification of adjacent objects
is used.  Degrees below reduced degree minus one are included explicitly.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CategoryTheory.Limits CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (Q : D.Subcomplex) (K)
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance relativeSquarefreeHomologyVertexOrder : LinearOrder V := D.colorLinearOrder

abbrev rankCochainComplex (S : Finset C) : CochainComplex (ModuleCat.{u} K) ℕ :=
  relativeAugmentedCochainComplex (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
    (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)

@[simp] theorem rankCochainComplex_d (S : Finset C) (j : ℕ) :
    (Q.rankCochainComplex K S).d j (j + 1) = ModuleCat.ofHom
      (relativeAugmentedCoboundary (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j) := by
  simp [rankCochainComplex, relativeAugmentedCochainComplex]

lemma squarefreeStrandIndex_isEmpty (S : Finset C) (i : ℕ) (hi : S.card < i) :
    IsEmpty (Q.RelativeColorStrandIndex (Koszul.faceExponent S) i) := by
  refine ⟨fun t => ?_⟩
  have hu := (faceExponent_le_iff _ _).mp (Q.strandIndex_exterior_le t)
  have hcard := Finset.card_le_card hu
  have ht : t.val.1.val.card = i := t.val.1.property
  omega

lemma squarefreePiece_subsingleton (S : Finset C) (i : ℕ) (hi : S.card < i) :
    Subsingleton (Q.relativeColorKoszulPiece K (Koszul.faceExponent S) i) := by
  letI := Q.squarefreeStrandIndex_isEmpty S i hi
  exact (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i).repr.injective.subsingleton

lemma rankCochainIndex_isEmpty (S : Finset C) (j : ℕ) (hj : S.card < j) :
    IsEmpty (RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j) := by
  refine ⟨fun F => ?_⟩
  have hcard := Finset.card_le_card F.property.1.2
  rw [D.face_card_eq_colors F.val F.property.1.1, F.property.2.1] at hcard
  omega

lemma rankCochain_subsingleton (S : Finset C) (j : ℕ) (hj : S.card < j) :
    Subsingleton ((Q.rankCochainComplex K S).X j) := by
  letI := Q.rankCochainIndex_isEmpty S j hj
  exact (relativeCochainCoordinateEquiv (K := K) (rankSelection D S)
    (rankSelection Q.toColoredComplex S) j).injective.subsingleton

lemma squarefree_cycles_iff (S : Finset C) (i j : ℕ) (hij : j + i = S.card)
    (y : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) i) :
    (Q.rankCochainComplex K S).d j (j + 1)
      (Q.squarefreeCochainEquiv K S i j hij y) = 0 ↔
      (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).d i (i - 1) y = 0 := by
  cases i with
  | zero =>
      have hj : j = S.card := by omega
      letI := Q.rankCochain_subsingleton K S (j + 1) (by omega)
      constructor
      · intro _
        rw [HomologicalComplex.shape _ 0 0 (by simp [ComplexShape.down])]
        rfl
      · intro _
        exact Subsingleton.elim _ _
  | succ i =>
      change ((Q.rankCochainComplex K S).d j (j + 1)).hom
          (Q.squarefreeCochainEquiv K S (i + 1) j hij y) = 0 ↔
        ((Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).d (i + 1) i).hom y = 0
      rw [Q.rankCochainComplex_d K S j, Q.relativeColorKoszulComplex_d K (Koszul.faceExponent S) i]
      change relativeAugmentedCoboundary (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
          (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j
          (Q.squarefreeCochainEquiv K S (i + 1) j hij y) = 0 ↔
        Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i y = 0
      rw [← Q.squarefreeCochainEquiv_differential K S i j hij]
      exact (Q.squarefreeCochainEquiv K S i (j + 1) (by omega)).map_eq_zero_iff

lemma squarefree_boundaries_iff (S : Finset C) (i j : ℕ) (hij : j + i = S.card)
    (y : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) i) :
    (∃ x : (Q.rankCochainComplex K S).X (j - 1),
      (Q.rankCochainComplex K S).d (j - 1) j x = Q.squarefreeCochainEquiv K S i j hij y) ↔
    ∃ x : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) (i + 1),
      (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).d (i + 1) i x = y := by
  cases j with
  | zero =>
      letI := Q.squarefreePiece_subsingleton K S (i + 1) (by omega)
      constructor
      · rintro ⟨x, hx⟩
        have hy : y = 0 := by
          apply (Q.squarefreeCochainEquiv K S i 0 hij).injective
          rw [map_zero]
          rw [HomologicalComplex.shape _ 0 0 (by simp [ComplexShape.up])] at hx
          exact hx.symm
        exact ⟨0, by rw [map_zero, hy]⟩
      · rintro ⟨x, hx⟩
        have hx0 : x = 0 := Subsingleton.elim _ _
        have hy : y = 0 := by simpa only [hx0, map_zero] using hx.symm
        exact ⟨0, by rw [map_zero, hy, map_zero]⟩
  | succ j =>
      change (∃ x : (Q.rankCochainComplex K S).X j,
        ((Q.rankCochainComplex K S).d j (j + 1)).hom x =
          Q.squarefreeCochainEquiv K S i (j + 1) hij y) ↔
        ∃ x : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) (i + 1),
          ((Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).d (i + 1) i).hom x = y
      rw [Q.rankCochainComplex_d K S j, Q.relativeColorKoszulComplex_d K (Koszul.faceExponent S) i]
      change (∃ x : Module.Dual K (RelativeAugmentedChains (K := K)
          (rankSelection D S) (rankSelection Q.toColoredComplex S) j),
        relativeAugmentedCoboundary (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
          (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) j x =
          Q.squarefreeCochainEquiv K S i (j + 1) hij y) ↔
        ∃ x : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) (i + 1),
          Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i x = y
      constructor
      · rintro ⟨x, hx⟩
        obtain ⟨z, rfl⟩ := (Q.squarefreeCochainEquiv K S (i + 1) j (by omega)).surjective x
        refine ⟨z, ?_⟩
        apply (Q.squarefreeCochainEquiv K S i (j + 1) hij).injective
        exact (Q.squarefreeCochainEquiv_differential K S i j (by omega) z).trans hx
      · rintro ⟨x, hx⟩
        refine ⟨Q.squarefreeCochainEquiv K S (i + 1) j (by omega) x, ?_⟩
        rw [← Q.squarefreeCochainEquiv_differential K S i j (by omega), hx]

/-- The comparison on genuine homology in all complementary nonnegative
augmented degrees.  It is induced by the explicit signed face map. -/
def squarefreeHomologyIso (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).homology i ≅
      (Q.rankCochainComplex K S).homology j :=
  (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).homologyIsoSc'
      (i + 1) i (i - 1) (by simp) (by cases i <;> simp) ≪≫
    shortComplexMiddleHomologyIso
      ((Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).sc' (i + 1) i (i - 1))
      ((Q.rankCochainComplex K S).sc' (j - 1) j (j + 1))
      (Q.squarefreeCochainEquiv K S i j hij)
      (Q.squarefree_cycles_iff K S i j hij)
      (Q.squarefree_boundaries_iff K S i j hij) ≪≫
    ((Q.rankCochainComplex K S).homologyIsoSc'
      (j - 1) j (j + 1) (by cases j <;> simp) (by simp)).symm

lemma squarefreeHomology_subsingleton (S : Finset C) (i : ℕ) (hi : S.card < i) :
    Subsingleton ((Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).homology i) := by
  apply ModuleCat.isZero_iff_subsingleton.mp
  apply ShortComplex.isZero_homology_of_isZero_X₂
  exact ModuleCat.isZero_iff_subsingleton.mpr (Q.squarefreePiece_subsingleton K S i hi)

/-- The complete squarefree colorful formula identifies genuine relative
Koszul homology with ordinary reduced relative cohomology, over every commutative ring.
The empty color set and every homological degree are included. -/
def squarefreeRelativeKoszulHomologyIso (S : Finset C) (i : ℕ) :
    (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).homology i ≅
      reducedRelativeCohomology (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
          ((S.card : ℤ) - i - 1) := by
  by_cases hi : i ≤ S.card
  · have hq : -1 ≤ (S.card : ℤ) - i - 1 := by omega
    have hn : (((S.card : ℤ) - i - 1) + 1).toNat = S.card - i := by omega
    simp only [reducedRelativeCohomology, if_pos hq, hn]
    exact Q.squarefreeHomologyIso K S i (S.card - i) (Nat.sub_add_cancel hi)
  · have hq : ¬ -1 ≤ (S.card : ℤ) - i - 1 := by omega
    simp only [reducedRelativeCohomology, if_neg hq]
    letI := Q.squarefreeHomology_subsingleton K S i (by omega)
    exact
      { hom := 0
        inv := 0
        hom_inv_id := by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          exact Subsingleton.elim _ _
        inv_hom_id := by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          exact Subsingleton.elim _ _ }

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeRepeatedColorShift -/
section

/-! # Repeated-color acyclicity for the actual relative coefficient module

Multiplication in a repeated color preserves the supporting face.  Hence the
absolute bijection restricts to monomials outside any downward subcomplex,
including the void subcomplex.  It induces a chain isomorphism on the actual
restriction kernel.  The ordinary coefficient Koszul homotopy makes the same
map zero on homology, so these relative strands are acyclic over every
commutative ring.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset CategoryTheory CategoryTheory.Limits CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C)

lemma repeatedIndexShift_support (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ)
    (t : D.ColorStrandIndex β i) :
    (D.repeatedIndexShift β c hc i t).val.2.val.support = t.val.2.val.support := by
  obtain ⟨v, hv, hcolor⟩ := D.repeated_color_vertex β c hc i t
  rw [D.repeatedIndexShift_eq β c hc i t v hv hcolor]
  change (Finsupp.single v 1 + t.val.2.val).support = t.val.2.val.support
  rw [Finsupp.support_add_eq_union, Finsupp.support_single_ne_zero v (by decide),
    Finset.singleton_union, Finset.insert_eq_of_mem hv]

namespace Subcomplex
variable {D} (Q : D.Subcomplex) (K)
local instance relativeRepeatedColorShiftParameterAlgebra : Algebra (MvPolynomial C K) (D.Ring K) :=
  (D.parameterAction K).toRingHom.toAlgebra

/-- The support-preserving absolute shift restricts to the genuine relative
basis, since membership in the subcomplex depends only on that support. -/
def relativeRepeatedIndexShift (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ) :
    Q.RelativeColorStrandIndex β i ≃
      Q.RelativeColorStrandIndex (β + Finsupp.single c 1) i :=
  (Q.relativeColorStrandSubtypeEquiv β i).trans
    (((D.repeatedIndexShift β c hc i).subtypeEquiv (by
      intro t
      change (¬ Q.face t.val.2.val.support) ↔
        ¬ Q.face (D.repeatedIndexShift β c hc i t).val.2.val.support
      rw [D.repeatedIndexShift_support])).trans
      (Q.relativeColorStrandSubtypeEquiv (β + Finsupp.single c 1) i).symm)

@[simp] theorem relativeRepeatedIndexShift_absolute (β : C →₀ ℕ) (c : C)
    (hc : 2 ≤ β c) (i : ℕ) (t : Q.RelativeColorStrandIndex β i) :
    Q.relativeColorStrandAbsolute (Q.relativeRepeatedIndexShift β c hc i t) =
      D.repeatedIndexShift β c hc i (Q.relativeColorStrandAbsolute t) := rfl

@[simp] theorem relativeCoefficientInclusion_smul (i : ℕ)
    (r : MvPolynomial C K) (x : Set.powersetCard C i →₀ Q.relativeParameterKernel K) :
    Q.relativeCoefficientInclusion K i (r • x) = r • Q.relativeCoefficientInclusion K i x := by
  ext s
  rfl

@[simp] theorem relativeColorBasis_inclusion (β : C →₀ ℕ) (i : ℕ)
    (t : Q.RelativeColorStrandIndex β i) :
    Q.relativeCoefficientInclusion K i ((Q.relativeColorKoszulPieceBasis K β i t).val) =
      (D.colorKoszulPieceBasis K β i (Q.relativeColorStrandAbsolute t)).val := by
  rw [Q.relativeColorKoszulPieceBasis_val K, D.colorKoszulPieceBasis_val K,
    Q.relativeCoefficientInclusion_basis K]
  rfl

def relativeRepeatedColorShiftEquiv (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) (i : ℕ) :
    Q.relativeColorKoszulPiece K β i ≃ₗ[K]
      Q.relativeColorKoszulPiece K (β + Finsupp.single c 1) i :=
  (Q.relativeColorKoszulPieceBasis K β i).equiv
    (Q.relativeColorKoszulPieceBasis K (β + Finsupp.single c 1) i)
    (Q.relativeRepeatedIndexShift β c hc i)

/-- The relative shift is ordinary parameter multiplication on the inherited
kernel module, as certified by its injective inclusion in the ambient ring. -/
theorem relativeRepeatedColorShiftEquiv_val (β : C →₀ ℕ) (c : C)
    (hc : 2 ≤ β c) (i : ℕ) (x : Q.relativeColorKoszulPiece K β i) :
    (Q.relativeRepeatedColorShiftEquiv K β c hc i x).val =
      (MvPolynomial.X c : MvPolynomial C K) • x.val := by
  suffices he : (Q.relativeColorKoszulPiece K (β + Finsupp.single c 1) i).subtype.comp
      (Q.relativeRepeatedColorShiftEquiv K β c hc i).toLinearMap =
      (((LinearMap.lsmul (MvPolynomial C K)
        (Set.powersetCard C i →₀ Q.relativeParameterKernel K))
          (MvPolynomial.X c)).restrictScalars K).comp
        (Q.relativeColorKoszulPiece K β i).subtype by
    exact LinearMap.congr_fun he x
  apply (Q.relativeColorKoszulPieceBasis K β i).ext
  intro t
  simp only [LinearMap.comp_apply, Submodule.subtype_apply, LinearEquiv.coe_coe,
    LinearMap.restrictScalars_apply, LinearMap.lsmul_apply,
    relativeRepeatedColorShiftEquiv, Module.Basis.equiv_apply]
  apply Q.relativeCoefficientInclusion_injective K i
  rw [Q.relativeColorBasis_inclusion K, Q.relativeCoefficientInclusion_smul K,
    Q.relativeColorBasis_inclusion K, Q.relativeRepeatedIndexShift_absolute]
  have h := D.repeatedColorShiftEquiv_val K β c hc i
    (D.colorKoszulPieceBasis K β i (Q.relativeColorStrandAbsolute t))
  simpa only [repeatedColorShiftEquiv, Module.Basis.equiv_apply] using h

def relativeRepeatedColorShiftIso (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) :
    Q.relativeColorKoszulComplex K β ≅
      Q.relativeColorKoszulComplex K (β + Finsupp.single c 1) :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (Q.relativeRepeatedColorShiftEquiv K β c hc i).toModuleIso) (by
      intro i j hij
      obtain rfl : i = j + 1 := hij.symm
      rw [Q.relativeColorKoszulComplex_d K, Q.relativeColorKoszulComplex_d K]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      change Q.relativeKoszulDifferential K j
          (Q.relativeRepeatedColorShiftEquiv K β c hc (j + 1) x).val =
        (Q.relativeRepeatedColorShiftEquiv K β c hc j
          (Q.relativeColorKoszulDifferential K β j x)).val
      rw [Q.relativeRepeatedColorShiftEquiv_val K, Q.relativeRepeatedColorShiftEquiv_val K]
      exact map_smul (Koszul.coordinateDifferential
        (MvPolynomial.X : C → MvPolynomial C K)
        (ModuleCat.of (MvPolynomial C K) (Q.relativeParameterKernel K)) j)
          (MvPolynomial.X c) x.val)

/-- Identity on coefficients compares scalar restriction with the independent
relative coordinate complex; no replacement coefficient module is introduced. -/
def relativeColorRestrictionEquiv (i : ℕ) :
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).obj
      (ModuleCat.of (MvPolynomial C K)
        (Set.powersetCard C i →₀ Q.relativeParameterKernel K))) ≃ₗ[K]
      (Set.powersetCard C i →₀ Q.relativeParameterKernel K) where
  toFun := id
  invFun := id
  left_inv := fun _ => rfl
  right_inv := fun _ => rfl
  map_add' := fun _ _ => rfl
  map_smul' r z := by
    change (algebraMap K (MvPolynomial C K) r) •
      (show Set.powersetCard C i →₀ Q.relativeParameterKernel K from z) =
      r • (show Set.powersetCard C i →₀ Q.relativeParameterKernel K from z)
    exact algebraMap_smul (MvPolynomial C K) r
      (show Set.powersetCard C i →₀ Q.relativeParameterKernel K from z)

def relativeColorRestrictionComplexIso :
    ((ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))).mapHomologicalComplex
      (ComplexShape.down ℕ)).obj
      (Koszul.coordinateComplex (MvPolynomial.X : C → MvPolynomial C K)
        (ModuleCat.of (MvPolynomial C K) (Q.relativeParameterKernel K))) ≅
      Q.relativeKoszulComplex K :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (Q.relativeColorRestrictionEquiv K i).toModuleIso) (by
      intro i j hij
      obtain rfl : i = j + 1 := hij.symm
      simp only [Functor.mapHomologicalComplex_obj_d, Koszul.coordinateComplex_d,
        relativeKoszulComplex_d]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro z
      simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_ofHom,
        relativeColorRestrictionEquiv, LinearEquiv.toModuleIso]
      rfl)

def relativeColorTotalParameterMap (c : C) :
    Q.relativeKoszulComplex K ⟶ Q.relativeKoszulComplex K :=
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let e := Q.relativeColorRestrictionComplexIso K
  e.inv ≫ (F.mapHomologicalComplex (ComplexShape.down ℕ)).map
    ((MvPolynomial.X c : MvPolynomial C K) • 𝟙 (Koszul.coordinateComplex
      (MvPolynomial.X : C → MvPolynomial C K)
      (ModuleCat.of (MvPolynomial C K) (Q.relativeParameterKernel K)))) ≫ e.hom

@[simp] theorem relativeColorTotalParameterMap_apply (c : C) (i : ℕ)
    (x : Set.powersetCard C i →₀ Q.relativeParameterKernel K) :
    (Q.relativeColorTotalParameterMap K c).f i x =
      (MvPolynomial.X c : MvPolynomial C K) • x := rfl

def relativeColorTotalParameterHomotopy (c : C) :
    Homotopy (Q.relativeColorTotalParameterMap K c) 0 := by
  let F := ModuleCat.restrictScalars (algebraMap K (MvPolynomial C K))
  let e := Q.relativeColorRestrictionComplexIso K
  let h := F.mapHomotopy (coordinateKoszulSmulHomotopy
    (MvPolynomial.X : C → MvPolynomial C K)
    (ModuleCat.of (MvPolynomial C K) (Q.relativeParameterKernel K)) c)
  have hh := (h.compLeft e.inv).compRight e.hom
  simpa only [relativeColorTotalParameterMap, Category.assoc, Functor.map_zero,
    comp_zero, zero_comp] using hh

theorem relativeRepeatedColorShift_inclusion (β : C →₀ ℕ) (c : C) (hc : 2 ≤ β c) :
    Q.relativeColorInclusion K β ≫ Q.relativeColorTotalParameterMap K c =
      (Q.relativeRepeatedColorShiftIso K β c hc).hom ≫
        Q.relativeColorInclusion K (β + Finsupp.single c 1) := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  simp only [HomologicalComplex.comp_f, ModuleCat.hom_comp, LinearMap.comp_apply]
  change (MvPolynomial.X c : MvPolynomial C K) • x.val =
    (Q.relativeRepeatedColorShiftEquiv K β c hc i x).val
  exact (Q.relativeRepeatedColorShiftEquiv_val K β c hc i x).symm

/-- All repeated-color relative strands have zero actual homology. -/
theorem relativeRepeatedColorHomology_subsingleton (β : C →₀ ℕ) (c : C)
    (hc : 2 ≤ β c) (i : ℕ) :
    Subsingleton ((Q.relativeColorKoszulComplex K β).homology i) := by
  have hz : ∀ z : (Q.relativeColorKoszulComplex K β).homology i, z = 0 := by
    intro z
    have hzero := (Q.relativeColorTotalParameterHomotopy K c).homologyMap_eq i
    rw [HomologicalComplex.homologyMap_zero] at hzero
    have hcomm := congrArg (fun f => HomologicalComplex.homologyMap f i)
      (Q.relativeRepeatedColorShift_inclusion K β c hc)
    rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp,
      hzero, comp_zero] at hcomm
    have hmapzero : HomologicalComplex.homologyMap
        (Q.relativeRepeatedColorShiftIso K β c hc).hom i z = 0 := by
      apply Q.relativeColorHomology_injective K (β + Finsupp.single c 1) i
      rw [map_zero]
      exact (congrArg (fun f => f.hom z) hcomm).symm
    let e := (HomologicalComplex.homologyFunctor (ModuleCat K) (ComplexShape.down ℕ) i).mapIso
      (Q.relativeRepeatedColorShiftIso K β c hc)
    apply e.toLinearEquiv.injective
    change HomologicalComplex.homologyMap (Q.relativeRepeatedColorShiftIso K β c hc).hom i z = _
    simpa only [map_zero] using hmapzero
  exact ⟨fun x y => (hz x).trans (hz y).symm⟩

end Subcomplex
end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.RelativeColorHomologyDecomposition -/
section

/-! # Completeness of the relative squarefree homology decomposition -/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable {D : FourPapers.Universal.ProperlyColoredComplex V C} (Q : D.Subcomplex) (K)

lemma relativeColorInclusion_retraction_ne (α β : C →₀ ℕ) (h : α ≠ β) :
    Q.relativeColorInclusion K α ≫ Q.relativeColorRetraction K β = 0 := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact Grading.projection_eq_zero (Ne.symm h) x.property

def relativeColorProjector (β : C →₀ ℕ) : Q.relativeKoszulComplex K ⟶ Q.relativeKoszulComplex K :=
  Q.relativeColorRetraction K β ≫ Q.relativeColorInclusion K β

@[simp] lemma relativeColorProjector_f (β : C →₀ ℕ) (i : ℕ) :
    (Q.relativeColorProjector K β).f i = ModuleCat.ofHom (Q.relativeColorProjection K β i) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  rfl

/-- Every actual class is a finite sum of its homogeneous projections. -/
lemma relativeColor_homology_decomposition (i : ℕ) (x : (Q.relativeKoszulComplex K).homology i) :
    ∃ s : Finset (C →₀ ℕ),
      ∑ β ∈ s, HomologicalComplex.homologyMap (Q.relativeColorProjector K β) i x = x := by
  let Cx := Q.relativeKoszulComplex K
  obtain ⟨z, rfl⟩ := (ModuleCat.epi_iff_surjective (Cx.homologyπ i)).mp inferInstance x
  let s := ((Q.relativeKoszulBasis K i).repr (Cx.iCycles i z)).support.image Q.relativeKoszulColorDegree
  have hz : ∑ β ∈ s, HomologicalComplex.cyclesMap (Q.relativeColorProjector K β) i z = z := by
    apply (ModuleCat.mono_iff_injective (Cx.iCycles i)).mp inferInstance
    rw [map_sum]
    calc
      ∑ β ∈ s, Cx.iCycles i (HomologicalComplex.cyclesMap (Q.relativeColorProjector K β) i z) =
          ∑ β ∈ s, Q.relativeColorProjection K β i (Cx.iCycles i z) := by
        apply Finset.sum_congr rfl
        intro β hβ
        calc
          Cx.iCycles i (HomologicalComplex.cyclesMap (Q.relativeColorProjector K β) i z) =
              ((Q.relativeColorProjector K β).f i) (Cx.iCycles i z) := by
            exact congrArg (fun f : Cx.cycles i ⟶ Cx.X i => f z)
              (HomologicalComplex.cyclesMap_i (Q.relativeColorProjector K β) i)
          _ = Q.relativeColorProjection K β i (Cx.iCycles i z) := by
            exact congrArg (fun f : Cx.X i ⟶ Cx.X i => f (Cx.iCycles i z))
              (Q.relativeColorProjector_f K β i)
      _ = _ := Grading.sum_projections (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree (Cx.iCycles i z)
  refine ⟨s, ?_⟩
  calc
    ∑ β ∈ s, HomologicalComplex.homologyMap (Q.relativeColorProjector K β) i (Cx.homologyπ i z) =
        ∑ β ∈ s, Cx.homologyπ i (HomologicalComplex.cyclesMap (Q.relativeColorProjector K β) i z) := by
      apply Finset.sum_congr rfl
      intro β hβ
      exact congrArg (fun f : Cx.cycles i ⟶ Cx.homology i => f z)
        (HomologicalComplex.homologyπ_naturality (Q.relativeColorProjector K β) i)
    _ = Cx.homologyπ i (∑ β ∈ s, HomologicalComplex.cyclesMap (Q.relativeColorProjector K β) i z) :=
      (map_sum _ _ _).symm
    _ = _ := congrArg (Cx.homologyπ i) hz

lemma relativeColorHomology_retract_include (β : C →₀ ℕ) (i : ℕ)
    (x : (Q.relativeColorKoszulComplex K β).homology i) :
    HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i
      (HomologicalComplex.homologyMap (Q.relativeColorInclusion K β) i x) = x := by
  change (HomologicalComplex.homologyMap (Q.relativeColorInclusion K β) i ≫
    HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i) x = x
  rw [← HomologicalComplex.homologyMap_comp, Q.relativeColorInclusion_retraction K β,
    HomologicalComplex.homologyMap_id]
  rfl

lemma relativeColorHomology_retract_include_ne (α β : C →₀ ℕ) (h : α ≠ β) (i : ℕ)
    (x : (Q.relativeColorKoszulComplex K α).homology i) :
    HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i
      (HomologicalComplex.homologyMap (Q.relativeColorInclusion K α) i x) = 0 := by
  change (HomologicalComplex.homologyMap (Q.relativeColorInclusion K α) i ≫
    HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i) x = 0
  rw [← HomologicalComplex.homologyMap_comp, Q.relativeColorInclusion_retraction_ne K α β h,
    HomologicalComplex.homologyMap_zero]
  rfl

lemma faceExponent_ne_of_ne {S T : Finset C} (h : S ≠ T) :
    Koszul.faceExponent S ≠ Koszul.faceExponent T := by
  intro he
  have he' := congrArg Finsupp.support he
  rw [faceExponent_support, faceExponent_support] at he'
  exact h he'

abbrev RelativeSquarefreeColorHomology (i : ℕ) :=
  ∀ S : Finset C, (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).homology i

def relativeSquarefreeAssembly (i : ℕ) :
    Q.RelativeSquarefreeColorHomology K i →ₗ[K] (Q.relativeKoszulComplex K).homology i :=
  ∑ S : Finset C, (HomologicalComplex.homologyMap (Q.relativeColorInclusion K (Koszul.faceExponent S)) i).hom
    ∘ₗ LinearMap.proj S

def relativeSquarefreeDecomposition (i : ℕ) :
    (Q.relativeKoszulComplex K).homology i →ₗ[K] Q.RelativeSquarefreeColorHomology K i :=
  LinearMap.pi fun S =>
    (HomologicalComplex.homologyMap (Q.relativeColorRetraction K (Koszul.faceExponent S)) i).hom

lemma relativeSquarefreeDecomposition_assembly (i : ℕ) (x : Q.RelativeSquarefreeColorHomology K i) :
    Q.relativeSquarefreeDecomposition K i (Q.relativeSquarefreeAssembly K i x) = x := by
  funext T
  simp only [relativeSquarefreeAssembly, relativeSquarefreeDecomposition, LinearMap.pi_apply,
    LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply, map_sum]
  rw [Finset.sum_eq_single T]
  · exact Q.relativeColorHomology_retract_include K _ i _
  · intro S hS hST
    exact Q.relativeColorHomology_retract_include_ne K _ _ (faceExponent_ne_of_ne hST) i _
  · intro hT
    exact (hT (Finset.mem_univ T)).elim

lemma relativeSquarefreeAssembly_decomposition_include (S : Finset C) (i : ℕ)
    (x : (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)).homology i) :
    Q.relativeSquarefreeAssembly K i (Q.relativeSquarefreeDecomposition K i
      (HomologicalComplex.homologyMap (Q.relativeColorInclusion K (Koszul.faceExponent S)) i x)) =
      HomologicalComplex.homologyMap (Q.relativeColorInclusion K (Koszul.faceExponent S)) i x := by
  simp only [relativeSquarefreeAssembly, relativeSquarefreeDecomposition, LinearMap.pi_apply,
    LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply]
  rw [Finset.sum_eq_single S]
  · rw [Q.relativeColorHomology_retract_include K (Koszul.faceExponent S) i]
  · intro T hT hTS
    rw [Q.relativeColorHomology_retract_include_ne K _ _ (faceExponent_ne_of_ne (Ne.symm hTS)), map_zero]
  · intro hS
    exact (hS (Finset.mem_univ S)).elim

lemma relativeSquarefreeAssembly_decomposition (i : ℕ) (x : (Q.relativeKoszulComplex K).homology i) :
    Q.relativeSquarefreeAssembly K i (Q.relativeSquarefreeDecomposition K i x) = x := by
  obtain ⟨s, hs⟩ := Q.relativeColor_homology_decomposition K i x
  rw [← hs, map_sum, map_sum]
  apply Finset.sum_congr rfl
  intro β hβ
  by_cases h : ∀ c, β c ≤ 1
  · have he : Koszul.faceExponent β.support = β := by
      ext c
      rw [Koszul.faceExponent_apply]
      by_cases hc : c ∈ β.support
      · rw [if_pos hc]
        have hn := Finsupp.mem_support_iff.mp hc
        have hb := h c
        omega
      · rw [if_neg hc]
        exact (Finsupp.notMem_support_iff.mp hc).symm
    rw [← he, relativeColorProjector, HomologicalComplex.homologyMap_comp]
    exact Q.relativeSquarefreeAssembly_decomposition_include K β.support i _
  · push_neg at h
    obtain ⟨c, hc⟩ := h
    letI := Q.relativeRepeatedColorHomology_subsingleton K β c (by omega) i
    have hz : HomologicalComplex.homologyMap (Q.relativeColorProjector K β) i x = 0 := by
      rw [relativeColorProjector, HomologicalComplex.homologyMap_comp]
      change HomologicalComplex.homologyMap (Q.relativeColorInclusion K β) i
        (HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i x) = 0
      have hr : HomologicalComplex.homologyMap (Q.relativeColorRetraction K β) i x = 0 :=
        Subsingleton.elim _ _
      rw [hr, map_zero]
    rw [hz, map_zero, map_zero]

/-- A finite decomposition of the entire actual homology, with no missing colors. -/
def relativeSquarefreeHomologyEquiv (i : ℕ) :
    (Q.relativeKoszulComplex K).homology i ≃ₗ[K] Q.RelativeSquarefreeColorHomology K i where
  toLinearMap := Q.relativeSquarefreeDecomposition K i
  invFun := Q.relativeSquarefreeAssembly K i
  left_inv := Q.relativeSquarefreeAssembly_decomposition K i
  right_inv := Q.relativeSquarefreeDecomposition_assembly K i


end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Common.SplitProjectionEquiv -/
section

/-! # A split projection in homogeneous coordinates

A projection which acts as the identity on specified homogeneous coordinates
and as zero on the remaining coordinates identifies its actual image with
exactly the specified product. No surjectivity of a guessed comparison is
assumed.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers
open Classical
variable {K H M I : Type*} [CommRing K]
variable [AddCommGroup H] [Module K H] [AddCommGroup M] [Module K M]
variable {T : I → Type*} [∀ i, AddCommGroup (T i)] [∀ i, Module K (T i)]

def extendPiByZero (P : I → Prop) :
    (∀ i : {i // P i}, T i.val) →ₗ[K] (∀ i, T i) where
  toFun x i := if hi : P i then x ⟨i, hi⟩ else 0
  map_add' x y := by
    funext i
    by_cases hi : P i <;> simp [hi]
  map_smul' c x := by
    funext i
    by_cases hi : P i <;> simp [hi]

@[simp] theorem extendPiByZero_apply (P : I → Prop)
    (x : ∀ i : {i // P i}, T i.val) (i : I) :
    extendPiByZero (K := K) P x i = if hi : P i then x ⟨i, hi⟩ else 0 := by
  rfl

/-- Restrict the actual split image of a diagonal projection to its nonzero
homogeneous coordinates. -/
def splitProjectionPieceEquiv
    (E : H ≃ₗ[K] ∀ i, T i) (inc : M →ₗ[K] H) (ret : H →ₗ[K] M)
    (hs : ret.comp inc = LinearMap.id) (P : I → Prop)
    (hdiag : ∀ (x : H) (i : I), E (inc (ret x)) i = if P i then E x i else 0) :
    M ≃ₗ[K] (∀ i : {i // P i}, T i.val) := by
  classical
  have hs' (x : M) : ret (inc x) = x := LinearMap.congr_fun hs x
  have hi : Function.Injective inc := by
    intro x y h
    simpa only [hs'] using congrArg ret h
  refine
    { toLinearMap := LinearMap.pi fun i =>
        (LinearMap.proj i.val).comp (E.toLinearMap.comp inc)
      invFun := fun x => ret (E.symm (extendPiByZero (K := K) P x))
      left_inv := ?_
      right_inv := ?_ }
  · intro x
    apply hi
    apply E.injective
    funext i
    rw [hdiag]
    by_cases hp : P i
    · simp only [if_pos hp, LinearEquiv.apply_symm_apply, extendPiByZero_apply,
        dif_pos hp, LinearMap.pi_apply, LinearMap.comp_apply,
        LinearMap.proj_apply, LinearEquiv.coe_coe]
      rfl
    · rw [if_neg hp]
      have he := hdiag (inc x) i
      rw [hs', if_neg hp] at he
      exact he.symm
  · intro x
    funext i
    change E (inc (ret (E.symm (extendPiByZero (K := K) P x)))) i.val = x i
    rw [hdiag, if_pos i.property, LinearEquiv.apply_symm_apply,
      extendPiByZero_apply, dif_pos i.property]

end FourPapers

end
end

/- BEGIN FourPapers.Universal.RelativeCoarseColorGrading -/
section

/-! # Coarsening the genuine relative color grading

An arbitrary function on color degrees gives a coarser grading because the
Koszul differential preserves the complete color vector. Its homology is
exactly the sum of the squarefree summands with the specified coarse degree.
This supplies both the ordinary internal degree and the independent rank
weight, without a restriction on their values.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable {D : FourPapers.Universal.ProperlyColoredComplex V C} (Q : D.Subcomplex) (K)
variable {A : Type*} (g : (C →₀ ℕ) → A)

def relativeCoarseKoszulPiece (a : A) (i : ℕ) :=
  Grading.Piece (Q.relativeKoszulBasis K i) (g ∘ Q.relativeKoszulColorDegree) a

instance relativeCoarseKoszulPieceAddCommGroup (a : A) (i : ℕ) :
    AddCommGroup (Q.relativeCoarseKoszulPiece K g a i) :=
  Module.addCommMonoidToAddCommGroup K

lemma relativeColorPiece_le_coarse (β : C →₀ ℕ) (i : ℕ) :
    Q.relativeColorKoszulPiece K β i ≤ Q.relativeCoarseKoszulPiece K g (g β) i := by
  apply Submodule.span_le.mpr
  rintro x ⟨t, ht, rfl⟩
  exact Submodule.subset_span ⟨t, congrArg g ht, rfl⟩

lemma relativeCoarseDifferential_homogeneous (a : A) (i : ℕ)
    {x : Set.powersetCard C (i + 1) →₀ Q.relativeParameterKernel K}
    (hx : x ∈ Q.relativeCoarseKoszulPiece K g a (i + 1)) :
    Q.relativeKoszulDifferential K i x ∈ Q.relativeCoarseKoszulPiece K g a i := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨t, ht, rfl⟩ := hx
      have h := Q.relativeColorPiece_le_coarse K g (Q.relativeKoszulColorDegree t) i
        (Q.relativeKoszulDifferential_homogeneous K (Q.relativeKoszulColorDegree t) i
          (Grading.basis_mem_piece (Q.relativeKoszulBasis K (i + 1)) Q.relativeKoszulColorDegree t))
      change g (Q.relativeKoszulColorDegree t) = a at ht
      exact ht ▸ h
  | zero => simpa only [map_zero] using (Q.relativeCoarseKoszulPiece K g a i).zero_mem
  | add x y hx hy ihx ihy =>
      simpa only [map_add] using (Q.relativeCoarseKoszulPiece K g a i).add_mem ihx ihy
  | smul c x hx ih =>
      simpa only [map_smul] using (Q.relativeCoarseKoszulPiece K g a i).smul_mem c ih

def relativeCoarseKoszulDifferential (a : A) (i : ℕ) :
    Q.relativeCoarseKoszulPiece K g a (i + 1) →ₗ[K] Q.relativeCoarseKoszulPiece K g a i :=
  ((Q.relativeKoszulDifferential K i).domRestrict _).codRestrict _
    (fun x => Q.relativeCoarseDifferential_homogeneous K g a i x.property)

lemma relativeCoarseKoszulDifferential_comp (a : A) (i : ℕ) :
    (Q.relativeCoarseKoszulDifferential K g a i).comp
      (Q.relativeCoarseKoszulDifferential K g a (i + 1)) = 0 := by
  apply LinearMap.ext
  intro x
  exact Subtype.ext (LinearMap.congr_fun (Q.relativeKoszulDifferential_comp K i) x.val)

def relativeCoarseKoszulComplex (a : A) : ChainComplex (ModuleCat.{u} K) ℕ :=
  ChainComplex.of (fun i => ModuleCat.of K (Q.relativeCoarseKoszulPiece K g a i))
    (fun i => ModuleCat.ofHom (Q.relativeCoarseKoszulDifferential K g a i))
    (fun i => ModuleCat.hom_ext (Q.relativeCoarseKoszulDifferential_comp K g a i))

@[simp] theorem relativeCoarseKoszulComplex_d (a : A) (i : ℕ) :
    (Q.relativeCoarseKoszulComplex K g a).d (i + 1) i =
      ModuleCat.ofHom (Q.relativeCoarseKoszulDifferential K g a i) := by
  simp [relativeCoarseKoszulComplex]

def relativeCoarseProjection (a : A) (i : ℕ) :
    Module.End K (Set.powersetCard C i →₀ Q.relativeParameterKernel K) :=
  Grading.projection (Q.relativeKoszulBasis K i) (g ∘ Q.relativeKoszulColorDegree) a

lemma relativeCoarseProjection_commutes (a : A) (i : ℕ) :
    (Q.relativeCoarseProjection K g a i).comp (Q.relativeKoszulDifferential K i) =
      (Q.relativeKoszulDifferential K i).comp (Q.relativeCoarseProjection K g a (i + 1)) := by
  apply (Q.relativeKoszulBasis K (i + 1)).ext
  intro t
  change Grading.projection _ _ a _ = Q.relativeKoszulDifferential K i
    (Grading.projection _ _ a (Q.relativeKoszulBasis K (i + 1) t))
  rw [Grading.projection_basis]
  simp only [Function.comp_apply]
  have ht := Q.relativeCoarseDifferential_homogeneous K g
    (g (Q.relativeKoszulColorDegree t)) i
    (Grading.basis_mem_piece (Q.relativeKoszulBasis K (i + 1))
      (g ∘ Q.relativeKoszulColorDegree) t)
  by_cases h : g (Q.relativeKoszulColorDegree t) = a
  · rw [if_pos h]
    exact Grading.projection_eq_self (h ▸ ht)
  · rw [if_neg h, map_zero]
    exact Grading.projection_eq_zero (Ne.symm h) ht

def relativeCoarseInclusion (a : A) :
    Q.relativeCoarseKoszulComplex K g a ⟶ Q.relativeKoszulComplex K where
  f i := ModuleCat.ofHom (Q.relativeCoarseKoszulPiece K g a i).subtype
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [Q.relativeCoarseKoszulComplex_d (K := K), Q.relativeKoszulComplex_d (K := K)]
    rfl

def relativeCoarseRetraction (a : A) :
    Q.relativeKoszulComplex K ⟶ Q.relativeCoarseKoszulComplex K g a where
  f i := ModuleCat.ofHom ((Q.relativeCoarseProjection K g a i).codRestrict _
    (fun x => Grading.projection_mem (Q.relativeKoszulBasis K i)
      (g ∘ Q.relativeKoszulColorDegree) a x))
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    rw [Q.relativeCoarseKoszulComplex_d (K := K), Q.relativeKoszulComplex_d (K := K)]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact Subtype.ext (LinearMap.congr_fun (Q.relativeCoarseProjection_commutes K g a j) x).symm

lemma relativeCoarseInclusion_retraction (a : A) :
    Q.relativeCoarseInclusion K g a ≫ Q.relativeCoarseRetraction K g a = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact Subtype.ext (Grading.projection_eq_self x.property)

/-- Fine projections diagonalize the actual coarse chain projection. -/
lemma relativeCoarseProjection_colorRetraction (a : A) (β : C →₀ ℕ) :
    (Q.relativeCoarseRetraction K g a ≫ Q.relativeCoarseInclusion K g a) ≫
      Q.relativeColorRetraction K β =
        if g β = a then Q.relativeColorRetraction K β else 0 := by
  by_cases ha : g β = a
  · rw [if_pos ha]
    apply HomologicalComplex.Hom.ext
    funext i
    apply ModuleCat.hom_ext
    apply (Q.relativeKoszulBasis K i).ext
    intro t
    apply Subtype.ext
    change Q.relativeColorProjection K β i
      (Q.relativeCoarseProjection K g a i (Q.relativeKoszulBasis K i t)) =
        Q.relativeColorProjection K β i (Q.relativeKoszulBasis K i t)
    rw [relativeCoarseProjection, Grading.projection_basis]
    simp only [Function.comp_apply]
    by_cases ht : Q.relativeKoszulColorDegree t = β
    · rw [if_pos ((congrArg g ht).trans ha)]
    · split_ifs <;>
        simp only [relativeColorProjection, Grading.projection_basis, if_neg ht, map_zero]
  · rw [if_neg ha]
    apply HomologicalComplex.Hom.ext
    funext i
    apply ModuleCat.hom_ext
    apply (Q.relativeKoszulBasis K i).ext
    intro t
    apply Subtype.ext
    change Q.relativeColorProjection K β i
      (Q.relativeCoarseProjection K g a i (Q.relativeKoszulBasis K i t)) = 0
    rw [relativeCoarseProjection, Grading.projection_basis]
    simp only [Function.comp_apply]
    by_cases ht : Q.relativeKoszulColorDegree t = β
    · have hga : ¬ g (Q.relativeKoszulColorDegree t) = a :=
        fun h => ha ((congrArg g ht).symm.trans h)
      rw [if_neg hga, map_zero]
    · split_ifs <;>
        simp only [relativeColorProjection, Grading.projection_basis, if_neg ht, map_zero]

def relativeCoarseHomologyEquiv (a : A) (i : ℕ) :
    (Q.relativeCoarseKoszulComplex K g a).homology i ≃ₗ[K]
      (∀ S : {S : Finset C // g (Koszul.faceExponent S) = a},
        (Q.relativeColorKoszulComplex K (Koszul.faceExponent S.val)).homology i) := by
  refine FourPapers.splitProjectionPieceEquiv (Q.relativeSquarefreeHomologyEquiv K i)
    (HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i).hom
    (HomologicalComplex.homologyMap (Q.relativeCoarseRetraction K g a) i).hom ?_
    (fun S => g (Koszul.faceExponent S) = a) ?_
  · have h : HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i ≫
        HomologicalComplex.homologyMap (Q.relativeCoarseRetraction K g a) i = 𝟙 _ := by
      rw [← HomologicalComplex.homologyMap_comp, Q.relativeCoarseInclusion_retraction K g a,
        HomologicalComplex.homologyMap_id]
    exact congrArg ModuleCat.Hom.hom h
  · intro x S
    have h := congrArg (fun f => HomologicalComplex.homologyMap f i)
      (Q.relativeCoarseProjection_colorRetraction K g a (Koszul.faceExponent S))
    by_cases hs : g (Koszul.faceExponent S) = a
    · rw [if_pos hs] at h ⊢
      change HomologicalComplex.homologyMap
        (Q.relativeColorRetraction K (Koszul.faceExponent S)) i
          (HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i
            (HomologicalComplex.homologyMap (Q.relativeCoarseRetraction K g a) i x)) =
        HomologicalComplex.homologyMap
          (Q.relativeColorRetraction K (Koszul.faceExponent S)) i x
      simpa only [HomologicalComplex.homologyMap_comp, ModuleCat.comp_apply]
        using congrArg (fun f => f x) h
    · rw [if_neg hs, HomologicalComplex.homologyMap_zero] at h
      rw [if_neg hs]
      change HomologicalComplex.homologyMap
        (Q.relativeColorRetraction K (Koszul.faceExponent S)) i
          (HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i
            (HomologicalComplex.homologyMap (Q.relativeCoarseRetraction K g a) i x)) = 0
      simpa only [HomologicalComplex.homologyMap_comp, ModuleCat.comp_apply,
        ModuleCat.hom_zero, LinearMap.zero_apply]
        using congrArg (fun f => f x) h

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.ColorFiberComponents -/
section

/-! # Actual parameter fibers and their active-flag components

The fiber is the ordinary quotient by the color parameters minus their
specified scalar values.  Its partition of the identity is obtained by
expanding the product of the active color sums.  Forbidden assignments vanish
in the original Stanley--Reisner quotient.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset MvPolynomial
section General
variable {V C K : Type*} [Fintype V] [Fintype C] [CommRing K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)

def characterIdeal (c : C → K) : Ideal (D.Ring K) :=
  Ideal.span (Set.range (fun i => D.colorParameter K i - algebraMap K (D.Ring K) (c i)))

abbrev CharacterFiber (c : C → K) := D.Ring K ⧸ D.characterIdeal K c

instance characterFiberCommRing (c : C → K) : CommRing (D.CharacterFiber K c) :=
  inferInstanceAs (CommRing (D.Ring K ⧸ D.characterIdeal K c))

instance characterFiberAlgebra (c : C → K) : Algebra K (D.CharacterFiber K c) :=
  inferInstanceAs (Algebra K (D.Ring K ⧸ D.characterIdeal K c))

def fiberVariable (c : C → K) (v : V) : D.CharacterFiber K c :=
  Ideal.Quotient.mk (D.characterIdeal K c)
    (Ideal.Quotient.mk (forbiddenIdeal (K := K) D.allowed) (X v : MvPolynomial V K))

theorem fiber_parameter (c : C → K) (i : C) :
    Ideal.Quotient.mk (D.characterIdeal K c) (D.colorParameter K i) =
      algebraMap K (D.CharacterFiber K c) (c i) := by
  have hz : Ideal.Quotient.mk (D.characterIdeal K c)
      (D.colorParameter K i - algebraMap K (D.Ring K) (c i)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
  rw [map_sub, sub_eq_zero] at hz
  exact hz

theorem sum_fiberVariable (c : C → K) (i : C) :
    (∑ v : {v : V // D.color v = i}, D.fiberVariable K c v.val) =
      algebraMap K (D.CharacterFiber K c) (c i) := by
  rw [← D.fiber_parameter K c i, colorParameter, map_sum]
  exact (Finset.sum_subtype (Finset.univ.filter (fun v => D.color v = i))
    (fun v => by simp) (D.fiberVariable K c)).symm

variable {K}

abbrev ActiveColor (c : C → K) := {i : C // c i ≠ 0}

abbrev FiberAssignment (c : C → K) :=
  (i : ActiveColor c) → {v : V // D.color v = i.val}

def assignmentVertices (c : C → K) (a : D.FiberAssignment c) : Finset V :=
  Finset.univ.image (fun i => (a i).val)

def assignmentExponents (c : C → K) (a : D.FiberAssignment c) : V →₀ ℕ :=
  ∑ i : ActiveColor c, Finsupp.single (a i).val 1

theorem assignmentExponents_support (c : C → K) (a : D.FiberAssignment c) :
    (D.assignmentExponents c a).support = D.assignmentVertices c a := by
  ext v
  simp only [assignmentExponents, Finsupp.mem_support_iff, Finsupp.finset_sum_apply,
    Finsupp.single_apply, assignmentVertices, Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · intro h
    by_contra hn
    push_neg at hn
    exact h (Finset.sum_eq_zero (fun i hi => by rw [if_neg (hn i)]))
  · rintro ⟨i, hi⟩
    have hp : 0 < ∑ j : ActiveColor c, if (a j).val = v then 1 else 0 := by
      apply lt_of_lt_of_le (show 0 < (if (a i).val = v then 1 else 0 : ℕ) by simp [hi])
      exact Finset.single_le_sum
        (f := fun j : ActiveColor c => if (a j).val = v then 1 else 0)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    exact Nat.ne_of_gt hp

end General

section Field
variable {V C K : Type*} [Fintype V] [Fintype C] [Field K]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)

def fiberAssignmentProduct (c : C → K) (a : D.FiberAssignment c) : D.CharacterFiber K c :=
  ∏ i : ActiveColor c, (c i.val)⁻¹ • D.fiberVariable K c (a i).val

theorem fiberAssignmentProduct_forbidden (c : C → K) (a : D.FiberAssignment c)
    (ha : ¬ D.face (D.assignmentVertices c a)) : D.fiberAssignmentProduct K c a = 0 := by
  have hmono : D.monomial K (D.assignmentExponents c a) = 0 :=
    D.monomial_eq_zero_of_forbidden K _ (by
      unfold allowed
      rwa [D.assignmentExponents_support])
  have hprod : (∏ i : ActiveColor c, D.fiberVariable K c (a i).val) = 0 := by
    unfold fiberVariable
    rw [← map_prod, ← map_prod]
    have he : (∏ i : ActiveColor c, X (a i).val : MvPolynomial V K) =
        MvPolynomial.monomial (D.assignmentExponents c a) 1 := by
      rw [assignmentExponents, MvPolynomial.monomial_sum_one]
      apply Finset.prod_congr rfl
      intro i hi
      rfl
    rw [he]
    change Ideal.Quotient.mk (D.characterIdeal K c)
      (D.monomial K (D.assignmentExponents c a)) = 0
    rw [hmono, map_zero]
  unfold fiberAssignmentProduct
  rw [Finset.prod_smul, hprod, smul_zero]

theorem sum_fiberAssignmentProduct (c : C → K) :
    (∑ a : D.FiberAssignment c, D.fiberAssignmentProduct K c a) = 1 := by
  unfold fiberAssignmentProduct
  rw [← Fintype.prod_sum (fun (i : ActiveColor c)
    (v : {v : V // D.color v = i.val}) =>
      (c i.val)⁻¹ • D.fiberVariable K c v.val)]
  apply Finset.prod_eq_one
  intro i hi
  rw [← Finset.smul_sum, D.sum_fiberVariable K c i.val]
  rw [Algebra.smul_def, ← map_mul, inv_mul_cancel₀ i.property, map_one]

variable {K}

abbrev ActiveFlag (c : C → K) :=
  {a : D.FiberAssignment c // D.face (D.assignmentVertices c a)}

variable (K)

def activeFlagComponent (c : C → K) (a : D.ActiveFlag c) : D.CharacterFiber K c :=
  D.fiberAssignmentProduct K c a.val

/-- Actual active flags partition the identity in the specialized ring. -/
theorem sum_activeFlagComponent (c : C → K) :
    (∑ a : D.ActiveFlag c, D.activeFlagComponent K c a) = 1 := by
  rw [← D.sum_fiberAssignmentProduct K c]
  change (∑ a : D.ActiveFlag c, D.fiberAssignmentProduct K c a.val) = _
  rw [← Finset.sum_subtype (Finset.univ.filter (fun a : D.FiberAssignment c =>
    D.face (D.assignmentVertices c a))) (fun a => by simp)]
  apply Finset.sum_subset (Finset.filter_subset _ _)
  intro a ha hn
  exact D.fiberAssignmentProduct_forbidden K c a (by simpa using hn)

/-- Multiplication by the active-flag components is a literal partition of the
identity into linear operators, as required by the modular obstruction. -/
def activeFlagOperator (c : C → K) (a : D.ActiveFlag c) :
    Module.End K (D.CharacterFiber K c) := LinearMap.mulLeft K (D.activeFlagComponent K c a)

theorem sum_activeFlagOperator (c : C → K) (x : D.CharacterFiber K c) :
    (∑ a : D.ActiveFlag c, D.activeFlagOperator K c a x) = x := by
  change (∑ a : D.ActiveFlag c, D.activeFlagComponent K c a * x) = x
  rw [← Finset.sum_mul, D.sum_activeFlagComponent K c]
  exact one_mul x

end Field
end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.ColoredAutomorphisms -/
section

/-! # Literal automorphisms of the colored ring and its parameter fibers

Vertex permutations act by renaming the variables in the actual polynomial
presentation.  Both the nonface ideal and every color-character ideal are
proved stable.  The active-flag components transform by the same permutation.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal.ProperlyColoredComplex
open Classical Finset MvPolynomial
section General
variable {V C K G : Type*} [Fintype V] [Fintype C] [CommRing K] [Group G]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C) (K)

def colorRename (e : Equiv.Perm V)
    (hface : ∀ s, D.face (s.image e) ↔ D.face s) : D.Ring K →ₐ[K] D.Ring K := by
  let f := (Ideal.Quotient.mkₐ K (forbiddenIdeal D.allowed)).comp (MvPolynomial.rename e)
  apply Ideal.Quotient.liftₐ (forbiddenIdeal D.allowed) f
  have hh : forbiddenIdeal D.allowed ≤ RingHom.ker f.toRingHom := by
    apply Ideal.span_le.mpr
    rintro p ⟨a, ha, rfl⟩
    change Ideal.Quotient.mk (forbiddenIdeal D.allowed)
      (MvPolynomial.rename e (MvPolynomial.monomial a (1 : K))) = 0
    rw [MvPolynomial.rename_monomial]
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply Ideal.subset_span
    refine ⟨a.mapDomain e, ?_, rfl⟩
    intro h
    apply ha
    change D.face (a.mapDomain e).support at h
    rw [Finsupp.support_mapDomain_of_nonneg (fun _ => Nat.zero_le _)] at h
    exact (hface a.support).mp h
  exact fun p hp => hh hp

@[simp] theorem colorRename_mk (e : Equiv.Perm V)
    (hface : ∀ s, D.face (s.image e) ↔ D.face s) (p : MvPolynomial V K) :
    D.colorRename K e hface (Ideal.Quotient.mk (forbiddenIdeal D.allowed) p) =
      Ideal.Quotient.mk (forbiddenIdeal D.allowed) (MvPolynomial.rename e p) := rfl

def colorFiberEquiv (e : Equiv.Perm V) (hcolor : ∀ v, D.color (e v) = D.color v) (i : C) :
    {v : V // D.color v = i} ≃ {v : V // D.color v = i} where
  toFun v := ⟨e v.val, (hcolor v.val).trans v.property⟩
  invFun v := ⟨e.symm v.val, by
    have hh := hcolor (e.symm v.val)
    rw [Equiv.apply_symm_apply] at hh
    exact hh.symm.trans v.property⟩
  left_inv v := Subtype.ext (e.symm_apply_apply v.val)
  right_inv v := Subtype.ext (e.apply_symm_apply v.val)

theorem colorRename_parameter (e : Equiv.Perm V)
    (hface : ∀ s, D.face (s.image e) ↔ D.face s)
    (hcolor : ∀ v, D.color (e v) = D.color v) (i : C) :
    D.colorRename K e hface (D.colorParameter K i) = D.colorParameter K i := by
  have hexp : D.colorParameter K i = ∑ v : {v : V // D.color v = i},
      Ideal.Quotient.mk (forbiddenIdeal D.allowed) (X v.val) := by
    exact Finset.sum_subtype (Finset.univ.filter (fun v => D.color v = i))
      (fun v => by simp) _
  rw [hexp, map_sum]
  simp only [D.colorRename_mk K e hface, MvPolynomial.rename_X]
  exact Fintype.sum_equiv (D.colorFiberEquiv e hcolor i) _ _ (fun _ => rfl)

def characterRename (c : C → K) (e : Equiv.Perm V)
    (hface : ∀ s, D.face (s.image e) ↔ D.face s)
    (hcolor : ∀ v, D.color (e v) = D.color v) :
    D.CharacterFiber K c →ₐ[K] D.CharacterFiber K c := by
  let f := (Ideal.Quotient.mkₐ K (D.characterIdeal K c)).comp (D.colorRename K e hface)
  apply Ideal.Quotient.liftₐ (D.characterIdeal K c) f
  have hh : D.characterIdeal K c ≤ RingHom.ker f.toRingHom := by
    apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    change Ideal.Quotient.mk (D.characterIdeal K c)
      (D.colorRename K e hface (D.colorParameter K i - algebraMap K (D.Ring K) (c i))) = 0
    rw [map_sub, D.colorRename_parameter K e hface hcolor, AlgHom.commutes,
      map_sub, D.fiber_parameter K c]
    change algebraMap K (D.CharacterFiber K c) (c i) -
      algebraMap K (D.CharacterFiber K c) (c i) = 0
    exact sub_self _
  exact fun p hp => hh hp

@[simp] theorem characterRename_mk (c : C → K) (e : Equiv.Perm V)
    (hface : ∀ s, D.face (s.image e) ↔ D.face s)
    (hcolor : ∀ v, D.color (e v) = D.color v) (p : D.Ring K) :
    D.characterRename K c e hface hcolor (Ideal.Quotient.mk (D.characterIdeal K c) p) =
      Ideal.Quotient.mk (D.characterIdeal K c) (D.colorRename K e hface p) := rfl

@[simp] theorem characterRename_variable (c : C → K) (e : Equiv.Perm V)
    (hface : ∀ s, D.face (s.image e) ↔ D.face s)
    (hcolor : ∀ v, D.color (e v) = D.color v) (v : V) :
    D.characterRename K c e hface hcolor (D.fiberVariable K c v) =
      D.fiberVariable K c (e v) := by
  simp only [fiberVariable, D.characterRename_mk K c e hface hcolor,
    D.colorRename_mk K e hface, MvPolynomial.rename_X]

variable (ρ : G →* Equiv.Perm V)
  (hface : ∀ g s, D.face (s.image (ρ g)) ↔ D.face s)
  (hcolor : ∀ g v, D.color (ρ g v) = D.color v)

def characterRepresentation (c : C → K) : G →* Module.End K (D.CharacterFiber K c) where
  toFun g := (D.characterRename K c (ρ g) (hface g) (hcolor g)).toLinearMap
  map_one' := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    change Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.rename (ρ 1) p)) = _
    rw [ρ.map_one]
    change Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.rename id p)) = _
    rw [MvPolynomial.rename_id_apply]
    rfl
  map_mul' g h := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    change Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.rename (ρ (g * h)) p)) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.rename (ρ g)
        (MvPolynomial.rename (ρ h) p)))
    rw [MvPolynomial.rename_rename, ρ.map_mul]
    rfl

end General

section Field
variable {V C K G : Type*} [Fintype V] [Fintype C] [Field K] [Group G]
variable (D : FourPapers.Universal.ProperlyColoredComplex V C)
variable (ρ : G →* Equiv.Perm V)
  (hface : ∀ g s, D.face (s.image (ρ g)) ↔ D.face s)
  (hcolor : ∀ g v, D.color (ρ g v) = D.color v)

def assignmentRename (c : C → K) (e : Equiv.Perm V)
    (hcolor : ∀ v, D.color (e v) = D.color v) (a : D.FiberAssignment c) : D.FiberAssignment c :=
  fun i => D.colorFiberEquiv e hcolor i.val (a i)

theorem assignmentRename_vertices (c : C → K) (e : Equiv.Perm V)
    (hcolor : ∀ v, D.color (e v) = D.color v) (a : D.FiberAssignment c) :
    D.assignmentVertices c (D.assignmentRename c e hcolor a) =
      (D.assignmentVertices c a).image e := by
  simp only [assignmentVertices, assignmentRename, colorFiberEquiv, Finset.image_image]
  rfl

def activeFlagAction (c : C → K) : MulAction G (D.ActiveFlag c) where
  smul g a := ⟨D.assignmentRename c (ρ g) (hcolor g) a.val,
    by
      rw [D.assignmentRename_vertices]
      exact (hface g (D.assignmentVertices c a.val)).mpr a.property⟩
  one_smul a := by
    apply Subtype.ext
    funext i
    apply Subtype.ext
    change ρ 1 ((a.val i).val) = (a.val i).val
    rw [ρ.map_one]
    rfl
  mul_smul g h a := by
    apply Subtype.ext
    funext i
    apply Subtype.ext
    change ρ (g * h) ((a.val i).val) = ρ g (ρ h ((a.val i).val))
    rw [ρ.map_mul]
    rfl

variable (K)

theorem characterRename_component (c : C → K) (g : G) (a : D.ActiveFlag c) :
    D.characterRename K c (ρ g) (hface g) (hcolor g) (D.activeFlagComponent K c a) =
      D.activeFlagComponent K c ((D.activeFlagAction ρ hface hcolor c).smul g a) := by
  change D.characterRename K c (ρ g) (hface g) (hcolor g)
      (∏ i : ActiveColor c, (c i.val)⁻¹ • D.fiberVariable K c (a.val i).val) = _
  rw [map_prod]
  apply Finset.prod_congr rfl
  intro i hi
  rw [map_smul, D.characterRename_variable K c (ρ g) (hface g) (hcolor g)]
  rfl

/-- The covariance required by the finite free-orbit obstruction is proved
for the actual operators in the actual character fiber. -/
theorem activeFlagOperator_covariant (c : C → K) (g : G) (a : D.ActiveFlag c)
    (x : D.CharacterFiber K c) :
    D.activeFlagOperator K c ((D.activeFlagAction ρ hface hcolor c).smul g a)
      (D.characterRepresentation K ρ hface hcolor c g x) =
      D.characterRepresentation K ρ hface hcolor c g (D.activeFlagOperator K c a x) := by
  change _ * D.characterRename K c (ρ g) (hface g) (hcolor g) x =
    D.characterRename K c (ρ g) (hface g) (hcolor g) (_ * x)
  rw [map_mul, D.characterRename_component K ρ hface hcolor c]

end Field
end FourPapers.Universal.ProperlyColoredComplex

end
end

/- BEGIN FourPapers.Universal.RelativeColorAutomorphisms -/
section

/-! # Genuine permutation actions on the relative coefficient complex

The input consists of a vertex permutation preserving faces, the subcomplex,
and colors.  Its coefficient map is the ordinary variable-renaming map on
the original quotient ring, restricted to the actual restriction kernel.
The color-strand action is proved to be its restriction, using the genuine
monomial basis.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical Finset CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable {D : FourPapers.Universal.ProperlyColoredComplex V C} (Q : D.Subcomplex)

structure ColorPairAutomorphism where
  vertex : Equiv.Perm V
  face_iff : ∀ F, D.face (F.image vertex) ↔ D.face F
  subface_iff : ∀ F, Q.face (F.image vertex) ↔ Q.face F
  color_eq : ∀ v, D.color (vertex v) = D.color v

namespace ColorPairAutomorphism
variable {Q} (e : Q.ColorPairAutomorphism)

def refl : Q.ColorPairAutomorphism where
  vertex := Equiv.refl V
  face_iff _ := by simp
  subface_iff _ := by simp
  color_eq _ := rfl

def symm : Q.ColorPairAutomorphism where
  vertex := e.vertex.symm
  face_iff F := by
    have h := e.face_iff (F.image e.vertex.symm)
    simpa only [Finset.image_image, Function.comp_def, Equiv.apply_symm_apply, Finset.image_id, Finset.image_id'] using h.symm
  subface_iff F := by
    have h := e.subface_iff (F.image e.vertex.symm)
    simpa only [Finset.image_image, Function.comp_def, Equiv.apply_symm_apply, Finset.image_id, Finset.image_id'] using h.symm
  color_eq v := by
    have h := e.color_eq (e.vertex.symm v)
    simpa only [Equiv.apply_symm_apply] using h.symm

/-- Composition in the usual left-action order: first `f`, then `e`. -/
def comp (f : Q.ColorPairAutomorphism) : Q.ColorPairAutomorphism where
  vertex := f.vertex.trans e.vertex
  face_iff F := by
    change D.face (F.image ((e.vertex : V → V) ∘ (f.vertex : V → V))) ↔ D.face F
    rw [← Finset.image_image, e.face_iff, f.face_iff]
  subface_iff F := by
    change Q.face (F.image ((e.vertex : V → V) ∘ (f.vertex : V → V))) ↔ Q.face F
    rw [← Finset.image_image, e.subface_iff, f.subface_iff]
  color_eq v := (e.color_eq (f.vertex v)).trans (f.color_eq v)

lemma image_colors (F : Finset V) :
    (F.image e.vertex).image D.color = F.image D.color := by
  simp only [Finset.image_image]
  congr 1
  funext v
  exact e.color_eq v

lemma exponent_support (a : V →₀ ℕ) :
    (a.mapDomain e.vertex).support = a.support.image e.vertex :=
  Finsupp.support_mapDomain_of_nonneg (fun _ => Nat.zero_le _) e.vertex

lemma exponent_colorDegree (a : V →₀ ℕ) :
    D.colorDegree (a.mapDomain e.vertex) = D.colorDegree a := by
  change (a.mapDomain e.vertex).mapDomain D.color = a.mapDomain D.color
  rw [← Finsupp.mapDomain_comp]
  congr 1
  funext v
  exact e.color_eq v

def exponentEquiv : Q.RelativeIndex ≃ Q.RelativeIndex where
  toFun a := ⟨⟨a.val.val.mapDomain e.vertex, by
    change D.face (a.val.val.mapDomain e.vertex).support
    rw [e.exponent_support]
    exact (e.face_iff a.val.val.support).mpr a.val.property⟩, by
    rw [e.exponent_support]
    exact fun h => a.property ((e.subface_iff a.val.val.support).mp h)⟩
  invFun a := ⟨⟨a.val.val.mapDomain e.vertex.symm, by
    change D.face (a.val.val.mapDomain e.vertex.symm).support
    rw [Finsupp.support_mapDomain_of_nonneg (fun _ => Nat.zero_le _) e.vertex.symm]
    exact (e.symm.face_iff a.val.val.support).mpr a.val.property⟩, by
    rw [Finsupp.support_mapDomain_of_nonneg (fun _ => Nat.zero_le _) e.vertex.symm]
    exact fun h => a.property ((e.symm.subface_iff a.val.val.support).mp h)⟩
  left_inv a := by
    apply Subtype.ext
    apply Subtype.ext
    change (a.val.val.mapDomain e.vertex).mapDomain e.vertex.symm = a.val.val
    rw [← Finsupp.mapDomain_comp]
    simpa only [Function.comp_def, Equiv.symm_apply_apply] using
      (Finsupp.mapDomain_fun_id (v := a.val.val))
  right_inv a := by
    apply Subtype.ext
    apply Subtype.ext
    change (a.val.val.mapDomain e.vertex.symm).mapDomain e.vertex = a.val.val
    rw [← Finsupp.mapDomain_comp]
    simpa only [Function.comp_def, Equiv.apply_symm_apply] using
      (Finsupp.mapDomain_fun_id (v := a.val.val))

def koszulIndexEquiv (i : ℕ) : Q.RelativeKoszulIndex i ≃ Q.RelativeKoszulIndex i :=
  Equiv.sigmaCongrRight (fun _ => e.exponentEquiv)

@[simp] lemma koszulIndexEquiv_colorDegree (i : ℕ) (t : Q.RelativeKoszulIndex i) :
    Q.relativeKoszulColorDegree (e.koszulIndexEquiv i t) = Q.relativeKoszulColorDegree t := by
  change D.colorDegree (t.2.val.val.mapDomain e.vertex) + _ = D.colorDegree t.2.val.val + _
  rw [e.exponent_colorDegree]
  rfl

def strandIndexEquiv (β : C →₀ ℕ) (i : ℕ) :
    Q.RelativeColorStrandIndex β i ≃ Q.RelativeColorStrandIndex β i :=
  (e.koszulIndexEquiv i).subtypeEquiv (fun t => by rw [e.koszulIndexEquiv_colorDegree])

variable (K)
local instance pairAutomorphismParameterAlgebra : Algebra (MvPolynomial C K) (D.Ring K) :=
  (D.parameterAction K).toRingHom.toAlgebra

local instance pairAutomorphismScalarTower : IsScalarTower K (MvPolynomial C K) (D.Ring K) :=
  IsScalarTower.of_algHom (D.parameterAction K)

local instance pairAutomorphismKernelScalarTower :
    IsScalarTower K (MvPolynomial C K) (Q.relativeParameterKernel K) :=
  inferInstance

abbrev ringMap : D.Ring K →ₐ[K] D.Ring K :=
  D.colorRename K e.vertex e.face_iff

@[simp] theorem ringMap_monomial (a : V →₀ ℕ) :
    e.ringMap K (D.monomial K a) = D.monomial K (a.mapDomain e.vertex) := by
  change D.colorRename K e.vertex e.face_iff (Ideal.Quotient.mk _ (MvPolynomial.monomial a 1)) = _
  rw [D.colorRename_mk (K := K), MvPolynomial.rename_monomial]
  rfl

theorem ringMap_parameterAction (t : MvPolynomial C K) :
    e.ringMap K (D.parameterAction K t) = D.parameterAction K t := by
  have h : (e.ringMap K).comp (D.parameterAction K) = D.parameterAction K := by
    apply MvPolynomial.algHom_ext
    intro c
    simp only [AlgHom.comp_apply, ProperlyColoredComplex.parameterAction, MvPolynomial.aeval_X]
    exact D.colorRename_parameter K e.vertex e.face_iff e.color_eq c
  exact DFunLike.congr_fun h t

def parameterMap : D.Ring K →ₗ[MvPolynomial C K] D.Ring K where
  toFun := e.ringMap K
  map_add' := map_add _
  map_smul' t x := by
    change e.ringMap K (D.parameterAction K t * x) =
      D.parameterAction K t * e.ringMap K x
    rw [map_mul, e.ringMap_parameterAction (K := K)]

theorem restriction_ringMap (x : D.Ring K) :
    Q.restriction K (e.ringMap K x) =
      Q.toColoredComplex.colorRename K e.vertex e.subface_iff (Q.restriction K x) := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

def relativeParameterMap :
    Q.relativeParameterKernel K →ₗ[MvPolynomial C K] Q.relativeParameterKernel K :=
  ((e.parameterMap K).domRestrict _).codRestrict _ (by
    intro x
    change Q.restriction K (e.ringMap K x.val) = 0
    rw [e.restriction_ringMap (K := K)]
    have hx : Q.restriction K x.val = 0 := x.property
    rw [hx, map_zero])

@[simp] theorem relativeParameterMap_val (x : Q.relativeParameterKernel K) :
    (e.relativeParameterMap K x).val = e.ringMap K x.val := rfl

@[simp] theorem relativeParameterMap_basis (a : Q.RelativeIndex) :
    e.relativeParameterMap K (Q.relativeRingBasis K a) =
      Q.relativeRingBasis K (e.exponentEquiv a) := by
  apply Subtype.ext
  rw [e.relativeParameterMap_val (K := K), Q.relativeRingBasis_val (K := K), e.ringMap_monomial (K := K),
    Q.relativeRingBasis_val (K := K)]
  rfl

def koszulTermMap (i : ℕ) :
    Module.End K (Set.powersetCard C i →₀ Q.relativeParameterKernel K) :=
  (Finsupp.mapRange.linearMap (e.relativeParameterMap K)).restrictScalars K

@[simp] theorem koszulTermMap_apply (i : ℕ)
    (x : Set.powersetCard C i →₀ Q.relativeParameterKernel K) (s : Set.powersetCard C i) :
    e.koszulTermMap K i x s = e.relativeParameterMap K (x s) := rfl

@[simp] theorem koszulTermMap_basis (i : ℕ) (t : Q.RelativeKoszulIndex i) :
    e.koszulTermMap K i (Q.relativeKoszulBasis K i t) =
      Q.relativeKoszulBasis K i (e.koszulIndexEquiv i t) := by
  rw [Q.relativeKoszulBasis_apply (K := K), Q.relativeKoszulBasis_apply (K := K)]
  change Finsupp.mapRange (e.relativeParameterMap K) (map_zero (e.relativeParameterMap K))
    (Finsupp.single t.1 (Q.relativeRingBasis K t.2)) = _
  rw [Finsupp.mapRange_single, e.relativeParameterMap_basis (K := K)]
  rfl

theorem koszulTermMap_differential (i : ℕ) :
    (e.koszulTermMap K i).comp (Q.relativeKoszulDifferential K i) =
      (Q.relativeKoszulDifferential K i).comp (e.koszulTermMap K (i + 1)) := by
  apply LinearMap.ext
  intro x
  exact LinearMap.congr_fun (coordinateDifferential_natural
    (MvPolynomial.X : C → MvPolynomial C K)
    (ModuleCat.ofHom (e.relativeParameterMap K)) i) x

def koszulMap : Q.relativeKoszulComplex K ⟶ Q.relativeKoszulComplex K where
  f i := ModuleCat.ofHom (e.koszulTermMap K i)
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    simp only [Q.relativeKoszulComplex_d (K := K)]
    exact ModuleCat.hom_ext (e.koszulTermMap_differential K j).symm

def strandEquiv (β : C →₀ ℕ) (i : ℕ) :
    Q.relativeColorKoszulPiece K β i ≃ₗ[K] Q.relativeColorKoszulPiece K β i :=
  (Q.relativeColorKoszulPieceBasis K β i).equiv
    (Q.relativeColorKoszulPieceBasis K β i) (e.strandIndexEquiv β i)

@[simp] theorem strandEquiv_basis (β : C →₀ ℕ) (i : ℕ) (t : Q.RelativeColorStrandIndex β i) :
    e.strandEquiv K β i (Q.relativeColorKoszulPieceBasis K β i t) =
      Q.relativeColorKoszulPieceBasis K β i (e.strandIndexEquiv β i t) := by
  simp only [strandEquiv, Module.Basis.equiv_apply]

theorem strandEquiv_val (β : C →₀ ℕ) (i : ℕ) (x : Q.relativeColorKoszulPiece K β i) :
    (e.strandEquiv K β i x).val = e.koszulTermMap K i x.val := by
  suffices he : (Q.relativeColorKoszulPiece K β i).subtype.comp (e.strandEquiv K β i).toLinearMap =
      (e.koszulTermMap K i).comp (Q.relativeColorKoszulPiece K β i).subtype by
    exact LinearMap.congr_fun he x
  apply (Q.relativeColorKoszulPieceBasis K β i).ext
  intro t
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Submodule.subtype_apply,
    e.strandEquiv_basis (K := K), Q.relativeColorKoszulPieceBasis_val (K := K),
    e.koszulTermMap_basis (K := K)]
  rfl

def strandMap (β : C →₀ ℕ) : Q.relativeColorKoszulComplex K β ⟶ Q.relativeColorKoszulComplex K β where
  f i := (e.strandEquiv K β i).toModuleIso.hom
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    simp only [Q.relativeColorKoszulComplex_d (K := K)]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    change Q.relativeKoszulDifferential K j (e.strandEquiv K β (j + 1) x).val =
      (e.strandEquiv K β j (Q.relativeColorKoszulDifferential K β j x)).val
    rw [e.strandEquiv_val (K := K), e.strandEquiv_val (K := K)]
    exact (LinearMap.congr_fun (e.koszulTermMap_differential K j) x.val).symm

theorem strandInclusion_natural (β : C →₀ ℕ) :
    Q.relativeColorInclusion K β ≫ e.koszulMap K =
      e.strandMap K β ≫ Q.relativeColorInclusion K β := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact (e.strandEquiv_val K β i x).symm

end ColorPairAutomorphism
end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeCochainAutomorphisms -/
section

/-! # Ordinary relative cochain actions and squarefree naturality

The cochain action is defined independently by permuting the usual oriented
face basis.  Its evaluation formula is pullback along the inverse vertex
permutation.  Proper coloring orders every face by its distinct colors, so
color-preserving permutations introduce no orientation sign.  Naturality of
the signed squarefree comparison is proved on the actual monomial basis.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex.ColorPairAutomorphism
open Classical Finset CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] {Q : D.Subcomplex}
variable (e : Q.ColorPairAutomorphism) (K)
set_option synthInstance.checkSynthOrder false in
local instance relativeCochainAutomorphismsVertexOrder : LinearOrder V := D.colorLinearOrder
local instance relativeCochainAutomorphismsColorDecidableEq : DecidableEq C := Classical.decEq _
local instance relativeCochainAutomorphismsVertexDecidableEq : DecidableEq V := Classical.decEq _

lemma cochain_image_colors (F : Finset V) :
    (F.image e.vertex).image D.color = F.image D.color := by
  simp only [Finset.image_image]
  congr 1
  funext v
  exact e.color_eq v

lemma rankSelection_iff (S : Finset C) (F : Finset V) :
    rankSelection D S (F.image e.vertex) ↔ rankSelection D S F := by
  unfold rankSelection
  rw [e.face_iff, e.cochain_image_colors]

lemma relativeRankSelection_iff (S : Finset C) (F : Finset V) :
    rankSelection Q.toColoredComplex S (F.image e.vertex) ↔
      rankSelection Q.toColoredComplex S F := by
  change (Q.face (F.image e.vertex) ∧ (F.image e.vertex).image D.color ⊆ S) ↔
    Q.face F ∧ F.image D.color ⊆ S
  rw [e.subface_iff, e.cochain_image_colors]

def cochainIndexEquiv (S : Finset C) (j : ℕ) :
    RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j ≃
      RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j where
  toFun F := ⟨F.val.image e.vertex, (e.rankSelection_iff S F.val).mpr F.property.1,
    (Finset.card_image_of_injective F.val e.vertex.injective).trans F.property.2.1,
    fun h => F.property.2.2 ((e.relativeRankSelection_iff S F.val).mp h)⟩
  invFun F := ⟨F.val.image e.vertex.symm, (e.symm.rankSelection_iff S F.val).mpr F.property.1,
    (Finset.card_image_of_injective F.val e.vertex.symm.injective).trans F.property.2.1,
    fun h => F.property.2.2 ((e.symm.relativeRankSelection_iff S F.val).mp h)⟩
  left_inv F := by
    apply Subtype.ext
    simp only [Finset.image_image, Function.comp_def, Equiv.symm_apply_apply, Finset.image_id, Finset.image_id']
  right_inv F := by
    apply Subtype.ext
    simp only [Finset.image_image, Function.comp_def, Equiv.apply_symm_apply, Finset.image_id, Finset.image_id']

def cochainEquiv (S : Finset C) (j : ℕ) :
    (Q.rankCochainComplex K S).X j ≃ₗ[K] (Q.rankCochainComplex K S).X j :=
  (relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j).equiv
    (relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j)
    (e.cochainIndexEquiv S j)

@[simp] theorem cochainEquiv_basis (S : Finset C) (j : ℕ)
    (F : RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j) :
    e.cochainEquiv K S j
      (relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j F) =
    relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j
      (e.cochainIndexEquiv S j F) := by
  exact Module.Basis.equiv_apply
    (relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j)
    F
    (relativeCochainBasis (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j)
    (e.cochainIndexEquiv S j)

/-- Evaluation of the actual cochain map on actual relative face classes:
it is the usual pullback by the inverse permutation. -/
theorem cochainEquiv_coordinate (S : Finset C) (j : ℕ)
    (f : (Q.rankCochainComplex K S).X j)
    (F : RelativeFaceIndex (rankSelection D S) (rankSelection Q.toColoredComplex S) j) :
    relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j
      (e.cochainEquiv K S j f) F =
    relativeCochainCoordinates (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S) j
      f ((e.cochainIndexEquiv S j).symm F) := by
  let L : (Q.rankCochainComplex K S).X j →ₗ[K] K :=
    (LinearMap.proj F).comp
      ((relativeCochainCoordinates (K := K) (rankSelection D S)
        (rankSelection Q.toColoredComplex S) j).comp (e.cochainEquiv K S j).toLinearMap)
  let R : (Q.rankCochainComplex K S).X j →ₗ[K] K :=
    (LinearMap.proj ((e.cochainIndexEquiv S j).symm F)).comp
      (relativeCochainCoordinates (K := K) (rankSelection D S)
        (rankSelection Q.toColoredComplex S) j)
  have he : L = R := by
    apply (relativeCochainBasis (K := K) (rankSelection D S)
      (rankSelection Q.toColoredComplex S) j).ext
    intro A
    change relativeCochainCoordinates _ _ j (e.cochainEquiv K S j
      (relativeCochainBasis _ _ j A)) F = relativeCochainCoordinates _ _ j
        (relativeCochainBasis _ _ j A) ((e.cochainIndexEquiv S j).symm F)
    rw [e.cochainEquiv_basis (K := K), relativeCochainBasis_coordinate, relativeCochainBasis_coordinate]
    simp only [(e.cochainIndexEquiv S j).apply_eq_iff_eq_symm_apply]
    split_ifs <;> rfl
  exact LinearMap.congr_fun he f

theorem squarefreeCochainIndex_natural (S : Finset C) (i j : ℕ) (hij : j + i = S.card)
    (t : Q.RelativeColorStrandIndex (Koszul.faceExponent S) i) :
    Q.squarefreeCochainIndex S i j hij (e.strandIndexEquiv (Koszul.faceExponent S) i t) =
      e.cochainIndexEquiv S j (Q.squarefreeCochainIndex S i j hij t) := by
  apply Subtype.ext
  rw [Q.squarefreeCochainIndex_face]
  change (t.val.2.val.val.mapDomain e.vertex).support =
    (Q.squarefreeCochainIndex S i j hij t).val.image e.vertex
  rw [e.exponent_support, Q.squarefreeCochainIndex_face]

/-- The explicit complement sign is invariant because the exterior color
subset stays fixed; the supporting face is literally relabeled. -/
theorem squarefreeCochainEquiv_natural (S : Finset C) (i j : ℕ) (hij : j + i = S.card)
    (x : Q.relativeColorKoszulPiece K (Koszul.faceExponent S) i) :
    Q.squarefreeCochainEquiv K S i j hij (e.strandEquiv K (Koszul.faceExponent S) i x) =
      e.cochainEquiv K S j (Q.squarefreeCochainEquiv K S i j hij x) := by
  suffices he : (Q.squarefreeCochainEquiv K S i j hij).toLinearMap.comp
      (e.strandEquiv K (Koszul.faceExponent S) i).toLinearMap =
      (e.cochainEquiv K S j).toLinearMap.comp
        (Q.squarefreeCochainEquiv K S i j hij).toLinearMap by
    exact LinearMap.congr_fun he x
  apply (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i).ext
  intro t
  change Q.squarefreeCochainEquiv K S i j hij
      (e.strandEquiv K (Koszul.faceExponent S) i
        (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i t)) =
    e.cochainEquiv K S j
      (Q.squarefreeCochainEquiv K S i j hij
        (Q.relativeColorKoszulPieceBasis K (Koszul.faceExponent S) i t))
  simp only [e.strandEquiv_basis (K := K),
    Q.squarefreeCochainEquiv_basis (K := K), map_zsmul_unit, e.cochainEquiv_basis (K := K),
    e.squarefreeCochainIndex_natural]
  rfl

/-- The independently defined ordinary cochain action commutes with the
ordinary coboundary.  Above the maximal possible face size, the target is
literally zero.  In the remaining degrees, the established squarefree chain
comparison supplies the commutative square. -/
theorem cochainEquiv_differential (S : Finset C) (j : ℕ)
    (f : (Q.rankCochainComplex K S).X j) :
    (Q.rankCochainComplex K S).d j (j + 1) (e.cochainEquiv K S j f) =
      e.cochainEquiv K S (j + 1) ((Q.rankCochainComplex K S).d j (j + 1) f) := by
  by_cases hj : j + 1 ≤ S.card
  · let i := S.card - (j + 1)
    have hij : j + (i + 1) = S.card := by dsimp [i]; omega
    have hij' : (j + 1) + i = S.card := by omega
    obtain ⟨x, rfl⟩ := (Q.squarefreeCochainEquiv K S (i + 1) j hij).surjective f
    rw [← e.squarefreeCochainEquiv_natural K S (i + 1) j hij]
    simp only [Q.rankCochainComplex_d (K := K), ModuleCat.ofHom_apply]
    change relativeAugmentedCoboundary (K := K) (rankSelection D S)
        (rankSelection Q.toColoredComplex S) (rankSelection_downward D S)
        (rankSelection_downward Q.toColoredComplex S) j
        (Q.squarefreeCochainEquiv K S (i + 1) j hij
          (e.strandEquiv K (Koszul.faceExponent S) (i + 1) x)) =
      e.cochainEquiv K S (j + 1)
        (relativeAugmentedCoboundary (K := K) (rankSelection D S)
          (rankSelection Q.toColoredComplex S) (rankSelection_downward D S)
          (rankSelection_downward Q.toColoredComplex S) j
          (Q.squarefreeCochainEquiv K S (i + 1) j hij x))
    rw [← Q.squarefreeCochainEquiv_differential K S i j hij]
    have hd : Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i
        (e.strandEquiv K (Koszul.faceExponent S) (i + 1) x) =
      e.strandEquiv K (Koszul.faceExponent S) i
        (Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i x) := by
      apply Subtype.ext
      change Q.relativeKoszulDifferential K i
          (e.strandEquiv K (Koszul.faceExponent S) (i + 1) x).val =
        (e.strandEquiv K (Koszul.faceExponent S) i
          (Q.relativeColorKoszulDifferential K (Koszul.faceExponent S) i x)).val
      rw [e.strandEquiv_val (K := K), e.strandEquiv_val (K := K)]
      exact (LinearMap.congr_fun (e.koszulTermMap_differential K i) x.val).symm
    rw [hd, e.squarefreeCochainEquiv_natural (K := K)]
    rw [← Q.squarefreeCochainEquiv_differential K S i j hij]
  · letI := Q.rankCochain_subsingleton K S (j + 1) (by omega)
    exact Subsingleton.elim _ _

def cochainMap (S : Finset C) : Q.rankCochainComplex K S ⟶ Q.rankCochainComplex K S where
  f j := (e.cochainEquiv K S j).toModuleIso.hom
  comm' i j hij := by
    obtain rfl : j = i + 1 := hij.symm
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    exact e.cochainEquiv_differential K S i

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex.ColorPairAutomorphism

end
end

/- BEGIN FourPapers.Universal.MiddleHomologyNaturality -/
section

/-! # Naturality of the middle-module homology comparison

This identifies the explicit maps on kernels modulo images with the actual
categorical homology maps, and then descends a commuting middle-module square.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
variable {K : Type u} [CommRing K]

private def shortComplexKernelMapData {S T : ShortComplex (ModuleCat.{v} K)} (a : S ⟶ T) :
    ShortComplex.LeftHomologyMapData a S.moduleCatLeftHomologyData T.moduleCatLeftHomologyData where
  φK := ModuleCat.ofHom (inducedCycleMap S.g.hom T.g.hom a.τ₂.hom a.τ₃.hom
    (congrArg (fun q => q.hom) a.comm₂₃).symm)
  φH := ModuleCat.ofHom (inducedHomologyMap S.f.hom S.g.hom
    (congrArg (fun q => q.hom) S.zero)
    T.f.hom T.g.hom (congrArg (fun q => q.hom) T.zero)
    a.τ₁.hom a.τ₂.hom a.τ₃.hom
    (congrArg (fun q => q.hom) a.comm₁₂).symm
    (congrArg (fun q => q.hom) a.comm₂₃).symm)
  commi := rfl
  commf' := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact (congrArg (fun q => q x) a.comm₁₂).symm
  commπ := rfl

theorem shortComplexMiddleHomologyIso_natural
    (S T : ShortComplex (ModuleCat.{v} K))
    (e : S.X₂ ≃ₗ[K] T.X₂)
    (hcycles : ∀ y, T.g (e y) = 0 ↔ S.g y = 0)
    (hboundaries : ∀ y, (∃ x', T.f x' = e y) ↔ ∃ x, S.f x = y)
    (a : S ⟶ S) (b : T ⟶ T)
    (hcomm : ∀ y, e (a.τ₂ y) = b.τ₂ (e y)) :
    ShortComplex.homologyMap a ≫ (shortComplexMiddleHomologyIso S T e hcycles hboundaries).hom =
      (shortComplexMiddleHomologyIso S T e hcycles hboundaries).hom ≫ ShortComplex.homologyMap b := by
  let A := shortComplexKernelMapData a
  let B := shortComplexKernelMapData b
  let E := (middleHomologyEquiv S.f.hom S.g.hom (congrArg (fun q => q.hom) S.zero)
    T.f.hom T.g.hom (congrArg (fun q => q.hom) T.zero) e hcycles hboundaries).toModuleIso
  have he : A.φH ≫ E.hom = E.hom ≫ B.φH := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact (middleHomologyEquiv_intertwines S.f.hom S.g.hom
      (congrArg (fun q => q.hom) S.zero) T.f.hom T.g.hom
      (congrArg (fun q => q.hom) T.zero) e hcycles hboundaries
      a.τ₁.hom a.τ₂.hom a.τ₃.hom
      (congrArg (fun q => q.hom) a.comm₁₂).symm
      (congrArg (fun q => q.hom) a.comm₂₃).symm
      b.τ₁.hom b.τ₂.hom b.τ₃.hom
      (congrArg (fun q => q.hom) b.comm₁₂).symm
      (congrArg (fun q => q.hom) b.comm₂₃).symm hcomm x)
  have ha := A.homologyMap_comm
  have hb := B.homologyMap_comm
  change ShortComplex.homologyMap a ≫ S.moduleCatHomologyIso.hom =
    S.moduleCatHomologyIso.hom ≫ A.φH at ha
  change ShortComplex.homologyMap b ≫ T.moduleCatHomologyIso.hom =
    T.moduleCatHomologyIso.hom ≫ B.φH at hb
  change ShortComplex.homologyMap a ≫
      (S.moduleCatHomologyIso.hom ≫ E.hom ≫ T.moduleCatHomologyIso.inv) =
    (S.moduleCatHomologyIso.hom ≫ E.hom ≫ T.moduleCatHomologyIso.inv) ≫
      ShortComplex.homologyMap b
  apply (cancel_mono T.moduleCatHomologyIso.hom).mp
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  rw [hb]
  simp only [Iso.inv_hom_id_assoc]
  rw [← Category.assoc, ha, Category.assoc, he]


/-- Naturality of a homology comparison specified only in the middle degree.
The abstract complexes keep the categorical homology construction opaque
when this lemma is applied to concrete homogeneous strands. -/
theorem complexMiddleHomologyIso_natural
    (C₁ : ChainComplex (ModuleCat.{v} K) ℕ)
    (D₁ : CochainComplex (ModuleCat.{v} K) ℕ) (i j : ℕ)
    (e : C₁.X i ≃ₗ[K] D₁.X j)
    (hcycles : ∀ y, D₁.d j (j + 1) (e y) = 0 ↔ C₁.d i (i - 1) y = 0)
    (hboundaries : ∀ y, (∃ x', D₁.d (j - 1) j x' = e y) ↔
      ∃ x, C₁.d (i + 1) i x = y)
    (a : C₁ ⟶ C₁) (b : D₁ ⟶ D₁)
    (hcomm : ∀ y, e (a.f i y) = b.f j (e y)) :
    let E := C₁.homologyIsoSc' (i + 1) i (i - 1) (by simp) (by cases i <;> simp) ≪≫
      shortComplexMiddleHomologyIso (C₁.sc' (i + 1) i (i - 1))
        (D₁.sc' (j - 1) j (j + 1)) e hcycles hboundaries ≪≫
      (D₁.homologyIsoSc' (j - 1) j (j + 1) (by cases j <;> simp) (by simp)).symm
    HomologicalComplex.homologyMap a i ≫ E.hom =
      E.hom ≫ HomologicalComplex.homologyMap b j := by
  let a' := (HomologicalComplex.shortComplexFunctor' (ModuleCat K) (ComplexShape.down ℕ)
    (i + 1) i (i - 1)).map a
  let b' := (HomologicalComplex.shortComplexFunctor' (ModuleCat K) (ComplexShape.up ℕ)
    (j - 1) j (j + 1)).map b
  let E := shortComplexMiddleHomologyIso (C₁.sc' (i + 1) i (i - 1))
    (D₁.sc' (j - 1) j (j + 1)) e hcycles hboundaries
  let A := C₁.homologyIsoSc' (i + 1) i (i - 1) (by simp) (by cases i <;> simp)
  let B := D₁.homologyIsoSc' (j - 1) j (j + 1) (by cases j <;> simp) (by simp)
  have hE := shortComplexMiddleHomologyIso_natural (K := K)
    (C₁.sc' (i + 1) i (i - 1)) (D₁.sc' (j - 1) j (j + 1))
    e hcycles hboundaries a' b' hcomm
  have hA : HomologicalComplex.homologyMap a i ≫ A.hom =
      A.hom ≫ ShortComplex.homologyMap a' :=
    (HomologicalComplex.homologyFunctorIso' (ModuleCat K) (ComplexShape.down ℕ)
      (i + 1) i (i - 1) (by simp) (by cases i <;> simp)).hom.naturality a
  have hB : HomologicalComplex.homologyMap b j ≫ B.hom =
      B.hom ≫ ShortComplex.homologyMap b' :=
    (HomologicalComplex.homologyFunctorIso' (ModuleCat K) (ComplexShape.up ℕ)
      (j - 1) j (j + 1) (by cases j <;> simp) (by simp)).hom.naturality b
  change HomologicalComplex.homologyMap a i ≫ (A.hom ≫ E.hom ≫ B.inv) =
    (A.hom ≫ E.hom ≫ B.inv) ≫ HomologicalComplex.homologyMap b j
  apply (cancel_mono B.hom).mp
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  rw [hB]
  simp only [Iso.inv_hom_id_assoc]
  rw [← Category.assoc, hA, Category.assoc, hE]

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeSquarefreeNaturality -/
section

/-! # Equivariance of the genuine relative colorful Hochster isomorphism

The morphisms in this file are ordinary categorical homology maps of the
actual kernel-coefficient Koszul complex and ordinary relative cochain
complex.  The comparison commutes with the independently specified vertex
permutation actions in every degree, including reduced degree minus one and
all zero degrees below it.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex.ColorPairAutomorphism
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] {Q : D.Subcomplex}
variable (e : Q.ColorPairAutomorphism) (K)
set_option synthInstance.checkSynthOrder false in
local instance relativeSquarefreeNaturalityVertexOrder : LinearOrder V := D.colorLinearOrder
local instance relativeSquarefreeNaturalityColorDecidableEq : DecidableEq C := Classical.decEq _
local instance relativeSquarefreeNaturalityVertexDecidableEq : DecidableEq V := Classical.decEq _

theorem squarefreeHomologyIso_natural (S : Finset C) (i j : ℕ) (hij : j + i = S.card) :
    HomologicalComplex.homologyMap (e.strandMap K (Koszul.faceExponent S)) i ≫
      (Q.squarefreeHomologyIso K S i j hij).hom =
    (Q.squarefreeHomologyIso K S i j hij).hom ≫
      HomologicalComplex.homologyMap (e.cochainMap K S) j := by
  exact complexMiddleHomologyIso_natural
    (Q.relativeColorKoszulComplex K (Koszul.faceExponent S)) (Q.rankCochainComplex K S)
    i j (Q.squarefreeCochainEquiv K S i j hij)
    (Q.squarefree_cycles_iff K S i j hij) (Q.squarefree_boundaries_iff K S i j hij)
    (e.strandMap K (Koszul.faceExponent S)) (e.cochainMap K S)
    (e.squarefreeCochainEquiv_natural K S i j hij)

/-- The usual induced map on reduced relative cohomology in all integer
cohomological degrees. -/
def reducedCohomologyMap (S : Finset C) (q : ℤ) :
    reducedRelativeCohomology (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) q ⟶
    reducedRelativeCohomology (K := K) (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) q := by
  by_cases hq : -1 ≤ q
  · simp only [reducedRelativeCohomology, if_pos hq]
    exact HomologicalComplex.homologyMap (e.cochainMap K S) (q + 1).toNat
  · simp only [reducedRelativeCohomology, if_neg hq]
    exact 𝟙 _

/-- The full relative squarefree Hochster isomorphism is equivariant for the
literal ring and cohomology actions induced by each color-preserving vertex
permutation. -/
theorem squarefreeRelativeKoszulHomologyIso_natural (S : Finset C) (i : ℕ) :
    HomologicalComplex.homologyMap (e.strandMap K (Koszul.faceExponent S)) i ≫
      (Q.squarefreeRelativeKoszulHomologyIso K S i).hom =
    (Q.squarefreeRelativeKoszulHomologyIso K S i).hom ≫
      e.reducedCohomologyMap K S ((S.card : ℤ) - i - 1) := by
  by_cases hi : i ≤ S.card
  · have hq : -1 ≤ (S.card : ℤ) - i - 1 := by omega
    have hn : (((S.card : ℤ) - i - 1) + 1).toNat = S.card - i := by omega
    have hB : reducedRelativeCohomology (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        ((S.card : ℤ) - i - 1) =
        (Q.rankCochainComplex K S).homology (S.card - i) := by
      simp only [reducedRelativeCohomology, if_pos hq, hn]
    have hE : HEq (Q.squarefreeRelativeKoszulHomologyIso K S i)
        (Q.squarefreeHomologyIso K S i (S.card - i) (Nat.sub_add_cancel hi)) := by
      simp only [Subcomplex.squarefreeRelativeKoszulHomologyIso, dif_pos hi,
        eq_mpr_eq_cast]
      exact cast_heq _ _
    have index_heq (n m : ℕ) (h : n = m) :
        HEq (HomologicalComplex.homologyMap (e.cochainMap K S) n)
          (HomologicalComplex.homologyMap (e.cochainMap K S) m) := by
      cases h
      rfl
    have hmap : HEq (e.reducedCohomologyMap K S ((S.card : ℤ) - i - 1))
        (HomologicalComplex.homologyMap (e.cochainMap K S) (S.card - i)) := by
      simp only [reducedCohomologyMap, dif_pos hq, eq_mpr_eq_cast]
      exact (cast_heq _ _).trans (index_heq _ _ hn)
    have hom_heq {X Y Y' : ModuleCat.{u} K} (hY : Y = Y')
        {E : X ≅ Y} {E' : X ≅ Y'} (h : HEq E E') : HEq E.hom E'.hom := by
      cases hY
      cases h
      rfl
    have hEhom := hom_heq hB hE
    apply eq_of_heq
    exact (CategoryTheory.heq_comp rfl rfl hB (HEq.rfl) hEhom).trans
      ((heq_of_eq (e.squarefreeHomologyIso_natural K S i (S.card - i)
        (Nat.sub_add_cancel hi))).trans
        (CategoryTheory.heq_comp rfl hB hB hEhom hmap).symm)
  · have hq : ¬ -1 ≤ (S.card : ℤ) - i - 1 := by omega
    simp only [Subcomplex.squarefreeRelativeKoszulHomologyIso, dif_neg hi,
      reducedCohomologyMap, dif_neg hq]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    haveI : Subsingleton (reducedRelativeCohomology (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        ((S.card : ℤ) - i - 1)) := by
      simp only [reducedRelativeCohomology, if_neg hq]
      infer_instance
    exact Subsingleton.elim _ _

end FourPapers.Universal.ProperlyColoredComplex.Subcomplex.ColorPairAutomorphism

end
end

/- BEGIN FourPapers.Universal.RankColoredNaturality -/
section

/-! # Order automorphisms are the literal rank-colored simplicial actions

The actual nonzero-face permutation preserves the order complex, every
invariant lower ideal and every rank color.  The ring and relative-kernel
identifications commute with its ordinary variable-renaming action.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal
open Classical Finset CategoryTheory
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

local instance rankColoredNaturalNonzeroDecidableEq : DecidableEq (NonzeroFace P) :=
  Classical.decEq _

lemma rankColored_face_order_iff (F : Finset (NonzeroFace P)) :
    (rankColoredOrderComplex hs d hrank).face (F.image (nonzeroFaceOrderEquiv e)) ↔
      (rankColoredOrderComplex hs d hrank).face F := by
  constructor
  · intro h p hp q hq
    have hh := h (nonzeroFaceOrderEquiv e p) (Finset.mem_image.mpr ⟨p, hp, rfl⟩)
      (nonzeroFaceOrderEquiv e q) (Finset.mem_image.mpr ⟨q, hq, rfl⟩)
    exact hh.imp (fun hpq => e.le_iff_le.mp hpq) (fun hqp => e.le_iff_le.mp hqp)
  · intro h p hp q hq
    obtain ⟨a, ha, hap⟩ := Finset.mem_image.mp hp
    obtain ⟨b, hb, hbq⟩ := Finset.mem_image.mp hq
    rw [← hap, ← hbq]
    exact (h a ha b hb).imp (fun hab => e.monotone hab) (fun hba => e.monotone hba)

/-- Every order automorphism stabilizing the lower ideal gives the genuine
color-preserving automorphism of its order-complex pair. -/
def rankColoredPairOrderAut :
    (rankColoredSubcomplex hs d hrank Q).ColorPairAutomorphism where
  vertex := nonzeroFaceOrderEquiv e
  face_iff := rankColored_face_order_iff hs d hrank e
  subface_iff F := by
    constructor
    · rintro ⟨hb, hF, hQ⟩
      refine ⟨hb, (rankColored_face_order_iff hs d hrank e F).mp hF, ?_⟩
      intro p hp
      exact (hstable p.val).mp
        (hQ (nonzeroFaceOrderEquiv e p) (Finset.mem_image.mpr ⟨p, hp, rfl⟩))
    · rintro ⟨hb, hF, hQ⟩
      refine ⟨hb, (rankColored_face_order_iff hs d hrank e F).mpr hF, ?_⟩
      intro p hp
      obtain ⟨a, ha, hap⟩ := Finset.mem_image.mp hp
      rw [← hap]
      exact (hstable a.val).mpr (hQ a ha)
  color_eq p := by
    apply Fin.ext
    change faceRank (e p.val) - 1 = faceRank p.val - 1
    rw [faceRank_eq_of_orderIso]

/-- The colored-ring presentation map commutes with the previously defined
natural barycentric-ring action, on the original quotient representatives. -/
theorem rankColoredRingEquiv_natural
    (x : (rankColoredOrderComplex hs d hrank).Ring K) :
    rankColoredRingEquiv K hs d hrank
      ((rankColoredPairOrderAut hs d hrank Q e hstable).ringMap K x) =
      barycentricRingOrderAut K e (rankColoredRingEquiv K hs d hrank x) := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

theorem rankColoredRelativeEquiv_natural
    (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeParameterKernel K) :
    (rankColoredRelativeEquiv K hs d hrank Q hQ
      ((rankColoredSubcomplex hs d hrank Q).relativeParameterEquiv K
        ((rankColoredPairOrderAut hs d hrank Q e hstable).relativeParameterMap K x))).val =
      barycentricRingOrderAut K e
        (rankColoredRelativeEquiv K hs d hrank Q hQ
          ((rankColoredSubcomplex hs d hrank Q).relativeParameterEquiv K x)).val :=
  rankColoredRingEquiv_natural K hs d hrank Q e hstable x.val

/-- The same identification holds coordinatewise on the actual coefficient
Koszul modules and fixes the exterior rank generators. -/
theorem rankColoredKoszulTerm_natural (i : ℕ)
    (x : Set.powersetCard (Fin d) i →₀
      (rankColoredSubcomplex hs d hrank Q).relativeParameterKernel K)
    (s : Set.powersetCard (Fin d) i) :
    rankColoredRingEquiv K hs d hrank
      (((rankColoredPairOrderAut hs d hrank Q e hstable).koszulTermMap K i x) s).val =
      barycentricRingOrderAut K e (rankColoredRingEquiv K hs d hrank (x s).val) :=
  rankColoredRingEquiv_natural K hs d hrank Q e hstable (x s).val

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeColorDecompositionNaturality -/
section

/-! # Equivariance of the full relative color decomposition

The decomposition uses actual homogeneous projections.  Their commutation
with variable renaming is proved before passing to homology.  Combining the
full decomposition with the ordinary squarefree cochain comparison therefore
gives a canonical equivariant isomorphism on the entire relative homology.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (Q : D.Subcomplex) (K)
set_option synthInstance.checkSynthOrder false in
local instance relativeColorDecompositionNaturalityVertexOrder : LinearOrder V := D.colorLinearOrder
local instance relativeColorDecompositionNaturalityColorDecidableEq : DecidableEq C := Classical.decEq _
local instance relativeColorDecompositionNaturalityVertexDecidableEq : DecidableEq V := Classical.decEq _

/-- The finite product is the finite direct sum over all rank selections;
its factors are independently defined ordinary reduced relative cohomology. -/
def relativeColorCohomologyEquiv (i : ℕ) :
    (Q.relativeKoszulComplex K).homology i ≃ₗ[K]
      ∀ S : Finset C, reducedRelativeCohomology (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
          ((S.card : ℤ) - i - 1) :=
  (Q.relativeSquarefreeHomologyEquiv K i).trans
    (LinearEquiv.piCongrRight (fun S => (Q.squarefreeRelativeKoszulHomologyIso K S i).toLinearEquiv))

namespace ColorPairAutomorphism
variable {Q} (e : Q.ColorPairAutomorphism)

theorem koszulTermMap_projection (β : C →₀ ℕ) (i : ℕ) :
    (e.koszulTermMap K i).comp (Q.relativeColorProjection K β i) =
      (Q.relativeColorProjection K β i).comp (e.koszulTermMap K i) := by
  apply (Q.relativeKoszulBasis K i).ext
  intro t
  change e.koszulTermMap K i
      (Grading.projection (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree β
        (Q.relativeKoszulBasis K i t)) =
    Grading.projection (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree β
      (e.koszulTermMap K i (Q.relativeKoszulBasis K i t))
  rw [e.koszulTermMap_basis (K := K), Grading.projection_basis, Grading.projection_basis,
    e.koszulIndexEquiv_colorDegree]
  split_ifs <;> simp only [e.koszulTermMap_basis (K := K), map_zero]

theorem strandRetraction_natural (β : C →₀ ℕ) :
    e.koszulMap K ≫ Q.relativeColorRetraction K β =
      Q.relativeColorRetraction K β ≫ e.strandMap K β := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change Q.relativeColorProjection K β i (e.koszulTermMap K i x) =
    (e.strandEquiv K β i
      ⟨Q.relativeColorProjection K β i x,
        Grading.projection_mem (Q.relativeKoszulBasis K i) Q.relativeKoszulColorDegree β x⟩).val
  rw [e.strandEquiv_val (K := K)]
  exact (LinearMap.congr_fun (e.koszulTermMap_projection K β i) x).symm

theorem relativeSquarefreeHomologyEquiv_natural (i : ℕ)
    (x : (Q.relativeKoszulComplex K).homology i) (S : Finset C) :
    Q.relativeSquarefreeHomologyEquiv K i
      (HomologicalComplex.homologyMap (e.koszulMap K) i x) S =
      HomologicalComplex.homologyMap (e.strandMap K (Koszul.faceExponent S)) i
        (Q.relativeSquarefreeHomologyEquiv K i x S) := by
  have h := congrArg (fun f => HomologicalComplex.homologyMap f i)
    (e.strandRetraction_natural K (Koszul.faceExponent S))
  rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp] at h
  exact congrArg (fun f => f x) h

/-- Equivariance holds for the actual cohomology maps; it is not used as the
definition of their action. -/
theorem relativeColorCohomologyEquiv_natural (i : ℕ)
    (x : (Q.relativeKoszulComplex K).homology i) (S : Finset C) :
    Q.relativeColorCohomologyEquiv K i
      (HomologicalComplex.homologyMap (e.koszulMap K) i x) S =
      e.reducedCohomologyMap K S ((S.card : ℤ) - i - 1)
        (Q.relativeColorCohomologyEquiv K i x S) := by
  change (Q.squarefreeRelativeKoszulHomologyIso K S i).hom
      (Q.relativeSquarefreeHomologyEquiv K i
        (HomologicalComplex.homologyMap (e.koszulMap K) i x) S) = _
  rw [e.relativeSquarefreeHomologyEquiv_natural (K := K)]
  exact congrArg (fun f => f (Q.relativeSquarefreeHomologyEquiv K i x S))
    (e.squarefreeRelativeKoszulHomologyIso_natural K S i)

end ColorPairAutomorphism
end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RelativeCoarseNaturality -/
section

/-! # Equivariance after arbitrary coarsening of color degrees

The coarse action is the restriction of ordinary coefficient renaming.  The
coarse homology equivalence is identified coordinatewise with the actual fine
projection, so it intertwines the usual rank-selected cohomology maps.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] (Q : D.Subcomplex) (K)
variable {A : Type*} (g : (C →₀ ℕ) → A)
set_option synthInstance.checkSynthOrder false in
local instance relativeCoarseNaturalityVertexOrder : LinearOrder V := D.colorLinearOrder
local instance relativeCoarseNaturalityColorDecidableEq : DecidableEq C := Classical.decEq _
local instance relativeCoarseNaturalityVertexDecidableEq : DecidableEq V := Classical.decEq _

@[simp] theorem relativeCoarseHomologyEquiv_apply (a : A) (i : ℕ)
    (x : (Q.relativeCoarseKoszulComplex K g a).homology i)
    (S : {S : Finset C // g (Koszul.faceExponent S) = a}) :
    Q.relativeCoarseHomologyEquiv K g a i x S =
      Q.relativeSquarefreeHomologyEquiv K i
        (HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i x) S.val := rfl

def relativeCoarseCohomologyEquiv (a : A) (i : ℕ) :
    (Q.relativeCoarseKoszulComplex K g a).homology i ≃ₗ[K]
      ∀ S : {S : Finset C // g (Koszul.faceExponent S) = a},
        reducedRelativeCohomology (K := K) (rankSelection D S.val)
          (rankSelection Q.toColoredComplex S.val) (rankSelection_downward D S.val)
          (rankSelection_downward Q.toColoredComplex S.val) ((S.val.card : ℤ) - i - 1) :=
  (Q.relativeCoarseHomologyEquiv K g a i).trans
    (LinearEquiv.piCongrRight fun S =>
      (Q.squarefreeRelativeKoszulHomologyIso K S.val i).toLinearEquiv)

namespace ColorPairAutomorphism
variable {Q} (e : Q.ColorPairAutomorphism)

lemma koszulTermMap_coarse (a : A) (i : ℕ)
    (x : Set.powersetCard C i →₀ Q.relativeParameterKernel K)
    (hx : x ∈ Q.relativeCoarseKoszulPiece K g a i) :
    e.koszulTermMap K i x ∈ Q.relativeCoarseKoszulPiece K g a i := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨t, ht, rfl⟩ := hx
      rw [e.koszulTermMap_basis (K := K)]
      apply Submodule.subset_span
      refine ⟨e.koszulIndexEquiv i t, ?_, rfl⟩
      change g (Q.relativeKoszulColorDegree (e.koszulIndexEquiv i t)) = a
      rw [e.koszulIndexEquiv_colorDegree]
      exact ht
  | zero => simpa only [map_zero] using (Q.relativeCoarseKoszulPiece K g a i).zero_mem
  | add x y hx hy ihx ihy =>
      simpa only [map_add] using (Q.relativeCoarseKoszulPiece K g a i).add_mem ihx ihy
  | smul c x hx ih =>
      simpa only [map_smul] using (Q.relativeCoarseKoszulPiece K g a i).smul_mem c ih

def coarseTermMap (a : A) (i : ℕ) :
    Module.End K (Q.relativeCoarseKoszulPiece K g a i) :=
  ((e.koszulTermMap K i).domRestrict _).codRestrict _
    (fun x => e.koszulTermMap_coarse K g a i x.val x.property)

@[simp] theorem coarseTermMap_val (a : A) (i : ℕ) (x : Q.relativeCoarseKoszulPiece K g a i) :
    (e.coarseTermMap K g a i x).val = e.koszulTermMap K i x.val := rfl

def coarseMap (a : A) :
    Q.relativeCoarseKoszulComplex K g a ⟶ Q.relativeCoarseKoszulComplex K g a where
  f i := ModuleCat.ofHom (e.coarseTermMap K g a i)
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    simp only [Q.relativeCoarseKoszulComplex_d (K := K)]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact Subtype.ext (LinearMap.congr_fun (e.koszulTermMap_differential K j) x.val).symm

theorem coarseInclusion_natural (a : A) :
    Q.relativeCoarseInclusion K g a ≫ e.koszulMap K =
      e.coarseMap K g a ≫ Q.relativeCoarseInclusion K g a := by
  apply HomologicalComplex.Hom.ext
  funext i
  rfl

theorem koszulTermMap_coarseProjection (a : A) (i : ℕ) :
    (e.koszulTermMap K i).comp (Q.relativeCoarseProjection K g a i) =
      (Q.relativeCoarseProjection K g a i).comp (e.koszulTermMap K i) := by
  apply (Q.relativeKoszulBasis K i).ext
  intro t
  change e.koszulTermMap K i
      (Grading.projection (Q.relativeKoszulBasis K i) (g ∘ Q.relativeKoszulColorDegree) a
        (Q.relativeKoszulBasis K i t)) =
    Grading.projection (Q.relativeKoszulBasis K i) (g ∘ Q.relativeKoszulColorDegree) a
      (e.koszulTermMap K i (Q.relativeKoszulBasis K i t))
  rw [e.koszulTermMap_basis (K := K), Grading.projection_basis, Grading.projection_basis]
  simp only [Function.comp_apply, e.koszulIndexEquiv_colorDegree]
  split_ifs <;> simp only [e.koszulTermMap_basis (K := K), map_zero]

theorem coarseRetraction_natural (a : A) :
    e.koszulMap K ≫ Q.relativeCoarseRetraction K g a =
      Q.relativeCoarseRetraction K g a ≫ e.coarseMap K g a := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact Subtype.ext (LinearMap.congr_fun (e.koszulTermMap_coarseProjection K g a i) x).symm

theorem relativeCoarseHomologyEquiv_natural (a : A) (i : ℕ)
    (x : (Q.relativeCoarseKoszulComplex K g a).homology i)
    (S : {S : Finset C // g (Koszul.faceExponent S) = a}) :
    Q.relativeCoarseHomologyEquiv K g a i
      (HomologicalComplex.homologyMap (e.coarseMap K g a) i x) S =
      HomologicalComplex.homologyMap (e.strandMap K (Koszul.faceExponent S.val)) i
        (Q.relativeCoarseHomologyEquiv K g a i x S) := by
  rw [Q.relativeCoarseHomologyEquiv_apply (K := K), Q.relativeCoarseHomologyEquiv_apply (K := K)]
  have h := congrArg (fun f => HomologicalComplex.homologyMap f i)
    (e.coarseInclusion_natural K g a)
  rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp] at h
  have hx := congrArg (fun f => f x) h
  change HomologicalComplex.homologyMap (e.koszulMap K) i
      (HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i x) =
    HomologicalComplex.homologyMap (Q.relativeCoarseInclusion K g a) i
      (HomologicalComplex.homologyMap (e.coarseMap K g a) i x) at hx
  rw [← hx]
  exact e.relativeSquarefreeHomologyEquiv_natural K i _ S.val

/-- The coarsened isomorphism intertwines ordinary induced cohomology maps,
with no extra condition on the internal degree or rank weight. -/
theorem relativeCoarseCohomologyEquiv_natural (a : A) (i : ℕ)
    (x : (Q.relativeCoarseKoszulComplex K g a).homology i)
    (S : {S : Finset C // g (Koszul.faceExponent S) = a}) :
    Q.relativeCoarseCohomologyEquiv K g a i
      (HomologicalComplex.homologyMap (e.coarseMap K g a) i x) S =
      e.reducedCohomologyMap K S.val ((S.val.card : ℤ) - i - 1)
        (Q.relativeCoarseCohomologyEquiv K g a i x S) := by
  change (Q.squarefreeRelativeKoszulHomologyIso K S.val i).hom
      (Q.relativeCoarseHomologyEquiv K g a i
        (HomologicalComplex.homologyMap (e.coarseMap K g a) i x) S) = _
  rw [e.relativeCoarseHomologyEquiv_natural (K := K)]
  exact congrArg (fun f => f (Q.relativeCoarseHomologyEquiv K g a i x S))
    (e.squarefreeRelativeKoszulHomologyIso_natural K S.val i)

end ColorPairAutomorphism
end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
end

/- BEGIN FourPapers.Universal.RankColorDegree -/
section

/-! # Ordinary degrees and rank weights are coarsenings of the color grading

The color numbered `c` represents rank `c.val + 1`.  The two formulas below
identify the independently defined gradings on the literal Koszul basis;
neither the internal degree nor the filtration degree is transported by fiat.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical Finset CommAlg

def rankColorInternalDegree {d : ℕ} (β : Fin d →₀ ℕ) : ℕ :=
  β.sum (fun c n => n * (c.val + 1))

def rankColorWeight (d : ℕ) (β : Fin d →₀ ℕ) : ℤ :=
  β.sum (fun c n => (n : ℤ) * rankWeight d (c.val + 1))

def rankColorCoarsening (d : ℕ) (β : Fin d →₀ ℕ) : ℕ × ℕ :=
  (rankColorInternalDegree β, (rankColorWeight d β).toNat)

theorem rankColorInternalDegree_add {d : ℕ} (α β : Fin d →₀ ℕ) :
    rankColorInternalDegree (α + β) =
      rankColorInternalDegree α + rankColorInternalDegree β := by
  exact Finsupp.sum_add_index' (fun _ => zero_mul _)
    (fun _ _ _ => add_mul _ _ _)

theorem rankColorWeight_add (d : ℕ) (α β : Fin d →₀ ℕ) :
    rankColorWeight d (α + β) = rankColorWeight d α + rankColorWeight d β := by
  exact Finsupp.sum_add_index' (fun _ => by simp)
    (fun _ _ _ => by simp only [Nat.cast_add, add_mul])

theorem rankColorInternalDegree_squarefree {d : ℕ} (S : Finset (Fin d)) :
    rankColorInternalDegree (Koszul.faceExponent S) = rankSubsetDegree S := by
  unfold rankColorInternalDegree rankSubsetDegree
  rw [Finsupp.sum_fintype _ _ (fun _ => by simp)]
  simp [Koszul.faceExponent_apply]

theorem rankColorWeight_squarefree (d : ℕ) (S : Finset (Fin d)) :
    rankColorWeight d (Koszul.faceExponent S) =
      ∑ c ∈ S, rankWeight d (c.val + 1) := by
  unfold rankColorWeight
  rw [Finsupp.sum_fintype _ _ (fun _ => by simp)]
  simp [Koszul.faceExponent_apply]

theorem rankColorCoarsening_squarefree (d : ℕ) (S : Finset (Fin d)) :
    rankColorCoarsening d (Koszul.faceExponent S) =
      (rankSubsetDegree S, rankSubsetWeight d S) := by
  simp only [rankColorCoarsening, rankColorInternalDegree_squarefree,
    rankColorWeight_squarefree, rankSubsetWeight]

variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]
variable (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

theorem rankColored_color_succ (p : NonzeroFace P) :
    ((rankColoredOrderComplex hs d hrank).color p).val + 1 = faceRank p.val := by
  have hpos : 0 < faceRank p.val := by
    simpa only [faceRank_bot] using
      (faceRank_strictMono hs) (bot_lt_iff_ne_bot.mpr p.property)
  change faceRank p.val - 1 + 1 = faceRank p.val
  omega

theorem rankColorInternalDegree_color (a : StandardFaceIndex P) :
    rankColorInternalDegree ((rankColoredOrderComplex hs d hrank).colorDegree a.val) =
      standardOrdinaryDegree a := by
  unfold rankColorInternalDegree ProperlyColoredComplex.colorDegree
  rw [Finsupp.sum_mapDomain_index (fun _ => by simp)
    (fun _ _ _ => by simp only [add_mul])]
  simp only [rankColored_color_succ, standardOrdinaryDegree]

theorem rankColorWeight_color (a : StandardFaceIndex P) :
    rankColorWeight d ((rankColoredOrderComplex hs d hrank).colorDegree a.val) =
      standardRankWeight d a := by
  unfold rankColorWeight ProperlyColoredComplex.colorDegree
  rw [Finsupp.sum_mapDomain_index (fun _ => by simp)
    (fun _ _ _ => by simp only [Nat.cast_add, add_mul])]
  simp only [rankColored_color_succ, standardRankWeight]

/-- Equality with the original internal degree and the actual rank weight. -/
theorem rankColorCoarsening_koszul {i : ℕ} (a : OriginalKoszulIndex P d i) :
    rankColorCoarsening d
      ((rankColoredOrderComplex hs d hrank).koszulColorDegree ⟨a.1, a.2⟩) =
      (originalKoszulDegree a, (originalKoszulWeight d a).toNat) := by
  simp only [rankColorCoarsening, ProperlyColoredComplex.koszulColorDegree,
    rankColorInternalDegree_add, rankColorWeight_add,
    rankColorInternalDegree_color, rankColorWeight_color,
    rankColorInternalDegree_squarefree, rankColorWeight_squarefree,
    originalKoszulDegree, originalKoszulWeight, koszulExteriorDegree,
    koszulExteriorWeight, rankSubsetDegree]

theorem rankColorCoarsening_relative (Q : Set P) {i : ℕ}
    (a : (rankColoredSubcomplex hs d hrank Q).RelativeKoszulIndex i) :
    rankColorCoarsening d
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulColorDegree a) =
      (originalKoszulDegree ⟨a.1, a.2.val⟩,
        (originalKoszulWeight d ⟨a.1, a.2.val⟩).toNat) :=
  rankColorCoarsening_koszul hs d hrank ⟨a.1, a.2.val⟩

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RankColoredCoarseBridge -/
section

/-! # The relative rank-colored strands are the actual barycentric strands

The coefficient map is the quotient-presentation equivalence on each exterior
coordinate.  It identifies the genuine relative kernel with the literal
restriction ideal, and its basis-coordinate formula proves that the two
independently defined internal and weight conditions agree.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def rankColoredRelativeCoefficientEquiv :
    (rankColoredSubcomplex hs d hrank Q).relativeParameterKernel K ≃ₗ[K]
      (barycentricRestrictionIdeal K Q).restrictScalars K :=
  ((rankColoredSubcomplex hs d hrank Q).relativeParameterEquiv K).trans
    (rankColoredRelativeEquiv K hs d hrank Q hQ)

/-- This is the actual ideal-valued coefficient equivalence, followed by the
identity identification of ideal-valued functions with ambient functions. -/
def rankColoredRelativeKoszulTermEquiv (i : ℕ) :
    ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i ≃ₗ[K]
      barycentricRelativeKoszulTerm (P := P) K d Q i :=
  (Finsupp.mapRange.linearEquiv
    (rankColoredRelativeCoefficientEquiv K hs d hrank Q hQ)).trans
      (idealCoefficientEquiv (K := K) (Set.powersetCard (Fin d) i)
        (barycentricRestrictionIdeal K Q))

@[simp] theorem rankColoredRelativeKoszulTermEquiv_apply (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i)
    (s : Set.powersetCard (Fin d) i) :
    (show Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K from
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val) s =
      rankColoredRingEquiv K hs d hrank
        ((show Set.powersetCard (Fin d) i →₀
          (rankColoredSubcomplex hs d hrank Q).relativeParameterKernel K from x) s).val := rfl

theorem rankColoredRelativeKoszulTermEquiv_val (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i) :
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val =
      Finsupp.mapRange.linearMap (rankColoredRingEquiv K hs d hrank).toLinearMap
        ((rankColoredSubcomplex hs d hrank Q).relativeCoefficientInclusion K i x) := by
  apply Finsupp.ext
  intro s
  rfl

def rankColoredRelativeKoszulIndex (i : ℕ)
    (t : (rankColoredSubcomplex hs d hrank Q).RelativeKoszulIndex i) :
    OriginalKoszulIndex P d i := ⟨t.1, t.2.val⟩

theorem rankColoredRelativeKoszulIndex_injective (i : ℕ) :
    Function.Injective (rankColoredRelativeKoszulIndex hs d hrank Q i) := by
  rintro ⟨s, a⟩ ⟨t, b⟩ h
  have hst : s = t := congrArg Sigma.fst h
  subst t
  have hab : a.val = b.val := by
    exact congrArg (fun z : OriginalKoszulIndex P d i => z.2) h
  have hab' : a = b := Subtype.ext hab
  subst b
  rfl

theorem rankColoredRelativeKoszulTermEquiv_basis (i : ℕ)
    (t : (rankColoredSubcomplex hs d hrank Q).RelativeKoszulIndex i) :
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i t)).val =
      barycentricKoszulBasis (P := P) K d i
        (rankColoredRelativeKoszulIndex hs d hrank Q i t) := by
  rw [(rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis_apply (K := K)]
  simp only [barycentricKoszulBasis, Finsupp.coe_basis]
  change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
    (Finsupp.single t.1 ((rankColoredSubcomplex hs d hrank Q).relativeRingBasis K t.2))).val =
      Finsupp.single t.1 (barycentricGlobalStandardBasis K t.2.val)
  apply Finsupp.ext
  intro s
  rw [rankColoredRelativeKoszulTermEquiv_apply]
  simp only [Finsupp.single_apply]
  split_ifs with h
  · rw [(rankColoredSubcomplex hs d hrank Q).relativeRingBasis_val (K := K)]
    exact rankColored_monomial_basis K hs d hrank t.2.val
  · exact map_zero (rankColoredRingEquiv K hs d hrank)

/-- Coordinates are literally extended by zero from the surviving relative
monomial indices.  This also covers the zero coefficient ring. -/
theorem rankColoredRelativeKoszulTermEquiv_repr (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i) :
    (barycentricKoszulBasis (P := P) K d i).repr
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val =
      Finsupp.mapDomain (rankColoredRelativeKoszulIndex hs d hrank Q i)
        (((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i).repr x) := by
  let L := (barycentricKoszulBasis (P := P) K d i).repr.toLinearMap.comp
    ((barycentricRelativeKoszulTerm (P := P) K d Q i).subtype.comp
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).toLinearMap)
  let R := (Finsupp.lmapDomain K K (rankColoredRelativeKoszulIndex hs d hrank Q i)).comp
    ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i).repr.toLinearMap
  have he : L = R := by
    apply ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i).ext
    intro t
    change (barycentricKoszulBasis (P := P) K d i).repr
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
        ((rankColoredSubcomplex hs d hrank Q).relativeKoszulBasis K i t)).val = _
    rw [rankColoredRelativeKoszulTermEquiv_basis]
    simp only [R, LinearMap.comp_apply, LinearEquiv.coe_coe,
      Module.Basis.repr_self, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
  exact LinearMap.congr_fun he x

theorem rankColoredRelativeKoszulTermEquiv_coarse (j n i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X i) :
    x ∈ (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
        (rankColorCoarsening d) (j, n) i ↔
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val ∈
          barycentricKoszulDegreePiece (P := P) K d i j ∧
        (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val ∈
          FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
            (fun a => (originalKoszulWeight d a).toNat) n := by
  change x ∈ Grading.Piece _ _ (j, n) ↔
    _ ∈ FourPapers.BasisGrading.Piece _ _ j ∧
      _ ∈ FourPapers.BasisGrading.Piece _ _ n
  rw [Grading.mem_piece, FourPapers.BasisGrading.mem_piece,
    FourPapers.BasisGrading.mem_piece]
  constructor
  · intro hx
    have hindex (a : OriginalKoszulIndex P d i)
        (ha : (barycentricKoszulBasis (P := P) K d i).repr
          (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val a ≠ 0) :
        originalKoszulDegree a = j ∧ (originalKoszulWeight d a).toNat = n := by
      rw [rankColoredRelativeKoszulTermEquiv_repr] at ha
      obtain ⟨t, rfl⟩ := Finsupp.mem_range_of_mapDomain_ne_zero ha
      rw [Finsupp.mapDomain_apply_of_injective
        (rankColoredRelativeKoszulIndex_injective hs d hrank Q i)] at ha
      have ht := hx t ha
      change rankColorCoarsening d
        ((rankColoredSubcomplex hs d hrank Q).relativeKoszulColorDegree t) = (j, n) at ht
      rw [rankColorCoarsening_relative] at ht
      exact ⟨congrArg Prod.fst ht, congrArg Prod.snd ht⟩
    exact ⟨fun a ha => (hindex a ha).1, fun a ha => (hindex a ha).2⟩
  · rintro ⟨hj, hn⟩ t ht
    have hnonzero : (barycentricKoszulBasis (P := P) K d i).repr
        (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x).val
          (rankColoredRelativeKoszulIndex hs d hrank Q i t) ≠ 0 := by
      rw [rankColoredRelativeKoszulTermEquiv_repr,
        Finsupp.mapDomain_apply_of_injective
          (rankColoredRelativeKoszulIndex_injective hs d hrank Q i)]
      exact ht
    change rankColorCoarsening d
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulColorDegree t) = (j, n)
    rw [rankColorCoarsening_relative]
    exact Prod.ext (hj _ hnonzero) (hn _ hnonzero)

def rankColoredCoarseTermEquiv (j n i : ℕ) :
    (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
        (rankColorCoarsening d) (j, n) i ≃ₗ[K]
      barycentricRelativeBigradedTerm (P := P) K d Q j n i where
  toFun x :=
    ⟨⟨(rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).val,
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).property,
      ((rankColoredRelativeKoszulTermEquiv_coarse K hs d hrank Q hQ j n i x.val).mp
        x.property).1⟩,
      ((rankColoredRelativeKoszulTermEquiv_coarse K hs d hrank Q hQ j n i x.val).mp
        x.property).2⟩
  invFun y :=
    ⟨(rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).symm
      ⟨y.val.val, y.val.property.1⟩,
      (rankColoredRelativeKoszulTermEquiv_coarse K hs d hrank Q hQ j n i _).mpr (by
        simpa only [LinearEquiv.apply_symm_apply] using
          (show y.val.val ∈ barycentricKoszulDegreePiece (P := P) K d i j ∧
            y.val.val ∈ FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
              (fun a => (originalKoszulWeight d a).toNat) n from
            ⟨y.val.property.2, y.property⟩))⟩
  left_inv x := Subtype.ext
    ((rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).symm_apply_apply x.val)
  right_inv y := by
    apply Subtype.ext
    apply Subtype.ext
    change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).symm
        ⟨y.val.val, y.val.property.1⟩)).val = y.val.val
    exact congrArg Subtype.val
      ((rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i).apply_symm_apply
        ⟨y.val.val, y.val.property.1⟩)
  map_add' x y := by
    apply Subtype.ext
    apply Subtype.ext
    change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i (x.val + y.val)).val =
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).val +
        (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i y.val).val
    exact congrArg Subtype.val (map_add
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i) x.val y.val)
  map_smul' c x := by
    apply Subtype.ext
    apply Subtype.ext
    change (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i (c • x.val)).val =
      c • (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i x.val).val
    exact congrArg Subtype.val (map_smul
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i) c x.val)

@[simp] theorem rankColoredCoarseTermEquiv_apply (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) i) (s : Set.powersetCard (Fin d) i) :
    (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i x).val.val s =
      rankColoredRingEquiv K hs d hrank (x.val s).val := rfl

theorem rankColoredRelativeKoszulTermEquiv_differential (i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeKoszulComplex K).X (i + 1)) :
    complexIncoming (barycentricRelativeKoszulComplex (P := P) K d Q) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x) =
      rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
        ((rankColoredSubcomplex hs d hrank Q).relativeKoszulDifferential K i x) := by
  apply Subtype.ext
  simp only [complexIncoming, barycentricRelativeKoszulComplex, submoduleComplex_d,
    parameterKoszulComplex_d, ModuleCat.hom_ofHom]
  change parameterKoszulDifferential (K := K) (fun c : Fin d =>
      barycentricRankParameter (P := P) K (c.val + 1)) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x).val = _
  rw [rankColoredRelativeKoszulTermEquiv_val, rankColoredRelativeKoszulTermEquiv_val]
  have hinc := LinearMap.congr_fun
    ((rankColoredSubcomplex hs d hrank Q).relativeCoefficientInclusion_differential K i) x
  simp only [LinearMap.comp_apply] at hinc
  rw [hinc]
  have hd : (rankColoredOrderComplex hs d hrank).koszulDifferential K i =
      parameterKoszulDifferential (K := K)
        ((rankColoredOrderComplex hs d hrank).colorParameter K) i := by
    simpa only [ProperlyColoredComplex.koszulDifferential,
      ProperlyColoredComplex.parameterAction, MvPolynomial.aeval_X] using
      parameterRestriction_differential ((rankColoredOrderComplex hs d hrank).parameterAction K) i
  rw [hd]
  exact (LinearMap.congr_fun
    (parameterKoszul_map_commutes
      ((rankColoredOrderComplex hs d hrank).colorParameter K)
      (fun c : Fin d => barycentricRankParameter (P := P) K (c.val + 1))
      (rankColoredRingEquiv K hs d hrank).toLinearMap
      (fun c z => by
        change rankColoredRingEquiv K hs d hrank
          ((rankColoredOrderComplex hs d hrank).colorParameter K c * z) = _
        rw [map_mul, rankColored_parameter]
        rfl) i)
    ((rankColoredSubcomplex hs d hrank Q).relativeCoefficientInclusion K (i + 1) x)).symm

theorem rankColoredCoarseTermEquiv_incoming (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) (i + 1)) :
    barycentricRelativeBigradedIncoming (P := P) K d Q j n i
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i + 1) x) =
      rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i
        (complexIncoming ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
          (rankColorCoarsening d) (j, n)) i x) := by
  apply Subtype.ext
  apply Subtype.ext
  simp only [complexIncoming,
    (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex_d (K := K),
    ModuleCat.hom_ofHom]
  change complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x.val).val =
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulDifferential K i x.val)).val
  have h := congrArg Subtype.val
    (rankColoredRelativeKoszulTermEquiv_differential K hs d hrank Q hQ i x.val)
  simp only [complexIncoming, barycentricRelativeKoszulComplex, submoduleComplex_d,
    ModuleCat.hom_ofHom] at h
  change complexIncoming (barycentricKoszulComplex (P := P) K d) i
      (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ (i + 1) x.val).val =
    (rankColoredRelativeKoszulTermEquiv K hs d hrank Q hQ i
      ((rankColoredSubcomplex hs d hrank Q).relativeKoszulDifferential K i x.val)).val at h
  exact h

theorem rankColoredCoarseTermEquiv_outgoing (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) i) :
    barycentricRelativeBigradedOutgoing (P := P) K d Q j n i
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i x) =
      rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i - 1)
        (complexOutgoing ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
          (rankColorCoarsening d) (j, n)) i x) := by
  cases i with
  | zero =>
      have hz := ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
        (rankColorCoarsening d) (j, n)).shape 0 0 (by decide)
      simp only [complexOutgoing, Nat.zero_sub, hz, ModuleCat.hom_zero,
        LinearMap.zero_apply, map_zero]
      apply Subtype.ext
      apply Subtype.ext
      change (barycentricKoszulComplex (P := P) K d).d 0 0
        (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n 0 x).val.val = 0
      rw [(barycentricKoszulComplex (P := P) K d).shape 0 0 (by decide)]
      rfl
  | succ i =>
      simpa only [barycentricRelativeBigradedOutgoing, barycentricRelativeBigradedIncoming,
        complexOutgoing, complexIncoming, Nat.succ_sub_one, Nat.add_sub_cancel] using
        rankColoredCoarseTermEquiv_incoming K hs d hrank Q hQ j n i x

def rankColoredCoarseKernelHomologyEquiv (j n i : ℕ) :
    complexKernelHomology
    ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)) i ≃ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
    chainHomologyEquiv _ _ _ _ _ _
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i + 1))
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i)
      (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n (i - 1))
      (rankColoredCoarseTermEquiv_incoming K hs d hrank Q hQ j n i)
      (rankColoredCoarseTermEquiv_outgoing K hs d hrank Q hQ j n i)

/-- The ordinary categorical homology of the coarse color strand is the
literal kernel/image quotient used by the intrinsic filtration theorem. -/
def rankColoredCoarseHomologyEquiv (j n i : ℕ) :
    ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)).homology i ≃ₗ[K]
        barycentricRelativeBigradedHomology (P := P) K d Q j n i :=
  (complexKernelHomologyIso
    ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)) i).toLinearEquiv |>.trans
    (rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i)

section Naturality
variable (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q)

theorem rankColoredCoarseTermEquiv_natural (j n i : ℕ)
    (x : (rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulPiece K
      (rankColorCoarsening d) (j, n) i) :
    rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i
      ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseTermMap (D := rankColoredOrderComplex hs d hrank) K
        (rankColorCoarsening d) (j, n) i x) =
      barycentricRelativeBigradedOrderMap K d e Q hstable j n i
        (rankColoredCoarseTermEquiv K hs d hrank Q hQ j n i x) := by
  apply Subtype.ext
  apply Subtype.ext
  apply Finsupp.ext
  intro s
  exact rankColoredKoszulTerm_natural K hs d hrank Q e hstable i x.val s

theorem rankColoredCoarseKernelHomologyEquiv_natural (j n i : ℕ)
    (x : complexKernelHomology
      ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
        (rankColorCoarsening d) (j, n)) i) :
    rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i
      (complexKernelHomologyMap
        ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
          (rankColorCoarsening d) (j, n)) i x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i x) :=
  chainHomologyEquiv_intertwines _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
    (rankColoredCoarseTermEquiv_natural K hs d hrank Q hQ e hstable j n i) x

theorem rankColoredCoarseHomologyEquiv_natural (j n i : ℕ)
    (x : ((rankColoredSubcomplex hs d hrank Q).relativeCoarseKoszulComplex K
      (rankColorCoarsening d) (j, n)).homology i) :
    rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i
      (HomologicalComplex.homologyMap
        ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
          (rankColorCoarsening d) (j, n)) i x) =
      barycentricRelativeBigradedHomologyAction K d e Q hstable j n i
        (rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i x) := by
  have hx := congrArg (fun f => f x)
    (complexKernelHomologyIso_natural
      ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
        (rankColorCoarsening d) (j, n)) i)
  simp only [ModuleCat.comp_apply, ModuleCat.ofHom_apply] at hx
  exact (congrArg (rankColoredCoarseKernelHomologyEquiv K hs d hrank Q hQ j n i) hx).trans
    (rankColoredCoarseKernelHomologyEquiv_natural K hs d hrank Q hQ e hstable j n i _)

end Naturality

/-- Ordinary reduced relative cohomology of the actual rank-selected order
complex pair, with the void-subcomplex convention for the empty lower ideal. -/
abbrev rankSelectedRelativeCohomology (S : Finset (Fin d)) (i : ℕ) :=
  letI : LinearOrder (NonzeroFace P) :=
    (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  reducedRelativeCohomology (K := K)
    (rankSelection (rankColoredOrderComplex hs d hrank) S)
    (rankSelection (rankColoredSubcomplex hs d hrank Q).toColoredComplex S)
    (rankSelection_downward (rankColoredOrderComplex hs d hrank) S)
    (rankSelection_downward (rankColoredSubcomplex hs d hrank Q).toColoredComplex S)
    ((S.card : ℤ) - i - 1)

def rankColoredCoarseCohomologyReindex (j n i : ℕ) :
    (∀ S : {S : Finset (Fin d) // rankColorCoarsening d (Koszul.faceExponent S) = (j, n)},
      rankSelectedRelativeCohomology K hs d hrank Q S.val i) ≃ₗ[K]
    (∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
      rankSelectedRelativeCohomology K hs d hrank Q S.val i) where
  toFun x S := x ⟨S.val, by
    rw [rankColorCoarsening_squarefree]
    exact Prod.ext S.property.1 S.property.2⟩
  invFun x S := x ⟨S.val, by
    have h := S.property
    rw [rankColorCoarsening_squarefree] at h
    exact ⟨congrArg Prod.fst h, congrArg Prod.snd h⟩⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The exact cohomology formula for every genuine relative barycentric
bigraded homology term.  All coefficient rings and all degrees are retained. -/
def barycentricRelativeBigradedCohomologyEquiv (j n i : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d Q j n i ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i :=
  (rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i).symm.trans
    (((rankColoredSubcomplex hs d hrank Q).relativeCoarseCohomologyEquiv (D := rankColoredOrderComplex hs d hrank) K
      (rankColorCoarsening d) (j, n) i).trans
        (rankColoredCoarseCohomologyReindex K hs d hrank Q j n i))

theorem barycentricRelativeBigradedCohomologyEquiv_natural
    (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q) (j n i : ℕ)
    (x : barycentricRelativeBigradedHomology (P := P) K d Q j n i)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n}) :
    barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i
      (barycentricRelativeBigradedHomologyAction K d e Q hstable j n i x) S =
      (rankColoredPairOrderAut hs d hrank Q e hstable).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i x S) := by
  let E := rankColoredCoarseHomologyEquiv K hs d hrank Q hQ j n i
  have hinv : E.symm (barycentricRelativeBigradedHomologyAction K d e Q hstable j n i x) =
      HomologicalComplex.homologyMap
        ((rankColoredPairOrderAut hs d hrank Q e hstable).coarseMap (D := rankColoredOrderComplex hs d hrank) K
          (rankColorCoarsening d) (j, n)) i (E.symm x) := by
    apply E.injective
    rw [LinearEquiv.apply_symm_apply]
    simpa only [E, LinearEquiv.apply_symm_apply] using
      (rankColoredCoarseHomologyEquiv_natural K hs d hrank Q hQ e hstable j n i
        (E.symm x)).symm
  change (rankColoredSubcomplex hs d hrank Q).relativeCoarseCohomologyEquiv (D := rankColoredOrderComplex hs d hrank) K
    (rankColorCoarsening d) (j, n) i
      (E.symm (barycentricRelativeBigradedHomologyAction K d e Q hstable j n i x))
      ⟨S.val, _⟩ = _
  rw [hinv]
  exact (rankColoredPairOrderAut hs d hrank Q e hstable).relativeCoarseCohomologyEquiv_natural
    (D := rankColoredOrderComplex hs d hrank) K (rankColorCoarsening d) (j, n) i (E.symm x) ⟨S.val, _⟩

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.PaperTorFormula -/
section

/-! # Theorem 1.2: the actual Tor filtration and rank-selected cohomology

The weight-by-weight comparison is assembled over all weights, and the
weight index is then eliminated. The surviving condition is precisely that
the sum of the selected ranks equals the internal degree. The group maps
on the two sides are the ordinary Tor functor maps and ordinary simplicial
cohomology maps, respectively.
-/
noncomputable section
open scoped DirectSum
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def relativeTorRankSelectedGradeEquiv (j i n : ℕ) :
    Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i :=
  (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n).trans
    (barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i)

/-- Every filtration grade is included. The second index on the right is
exactly the sum of the selected ranks, with no restriction on weight. -/
def relativeTorRankSelectedEquiv (j i : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i :=
  gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank Q S i)
    (fun n => Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n)
    (relativeTorRankSelectedGradeEquiv K hs d hrank Q hQ j i)

/-- The relative formula, written as the direct sum occurring in the paper. -/
def theorem_1_2_relative (j i : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i) :=
  (relativeTorRankSelectedEquiv K hs d hrank Q hQ j i).trans
    (DirectSum.linearEquivFunOnFintype K _ _).symm

theorem relativeTorRankSelectedGradeEquiv_natural
    (e : P ≃o P) (hstable : ∀ p, e p ∈ Q ↔ p ∈ Q) (j i n : ℕ)
    (x : Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n}) :
    relativeTorRankSelectedGradeEquiv K hs d hrank Q hQ j i n
      (gradeMap _ _ (originalRelativeTorDegreeAction K hs d Q e hstable hrank j i)
        (originalRelativeTorDegreeAction_filtered K hs d Q e hstable hrank hQ j i) n x) S =
      (rankColoredPairOrderAut hs d hrank Q e hstable).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (relativeTorRankSelectedGradeEquiv K hs d hrank Q hQ j i n x S) := by
  change barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i
    (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n _) S = _
  rw [originalRelativeTorAssociatedBigraded_equivariant]
  exact barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank Q hQ
    e hstable j n i _ S

variable {G : Type v} [Group G] (a : PosetGroupAction G P)
variable (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)

theorem relativeTorRankSelectedEquiv_equivariant (j i : ℕ) (g : G)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j}) :
    relativeTorRankSelectedEquiv K hs d hrank Q hQ j i
      (originalRelativeTorAssociatedRepresentation K hs d hrank Q hQ a hstable j i g x) S =
      (rankColoredPairOrderAut hs d hrank Q (a.orderIso g) (hstable g)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (relativeTorRankSelectedEquiv K hs d hrank Q hQ j i x S) := by
  simp only [relativeTorRankSelectedEquiv, gradedSumConditionEquiv_apply]
  exact relativeTorRankSelectedGradeEquiv_natural K hs d hrank Q hQ
    (a.orderIso g) (hstable g) j i (rankSubsetWeight d S.val)
      (x (rankSubsetWeight d S.val)) ⟨S.val, S.property, rfl⟩

/-- The direct-sum formulation intertwines the actual induced maps. -/
theorem theorem_1_2_relative_equivariant (j i : ℕ) (g : G)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i) :
    theorem_1_2_relative K hs d hrank Q hQ j i
      (originalRelativeTorAssociatedRepresentation K hs d hrank Q hQ a hstable j i g x) =
      DirectSum.lmap (fun S : {S : Finset (Fin d) // rankSubsetDegree S = j} =>
        ((rankColoredPairOrderAut hs d hrank Q (a.orderIso g) (hstable g)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
          ((S.val.card : ℤ) - i - 1)).hom)
        (theorem_1_2_relative K hs d hrank Q hQ j i x) := by
  apply DFinsupp.ext
  intro S
  exact relativeTorRankSelectedEquiv_equivariant K hs d hrank Q hQ a hstable j i g x S

/-- The relative formula uses this finite filtration, stable under the
actual derived Tor action for every stable downward subset, including empty. -/
theorem theorem_1_2_relative_finite_stable (j i : ℕ) :
    (originalRelativeTorFiltration K hs d hrank Q hQ j i).level (2 * d * j + 1) = ⊤ ∧
      ∀ g, Preserves (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorFiltration K hs d hrank Q hQ j i)
        (originalRelativeTorDegreeRepresentation K hs d hrank Q a hstable hQ j i g) :=
  ⟨originalRelativeTorFiltration_finite K hs d hrank Q hQ j i,
    fun g => originalRelativeTorDegreeRepresentation_filtered K hs d hrank Q a hstable hQ j i g⟩

section Absolute
omit Q hQ a hstable in
def originalTorRankSelectedEquiv (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      ∀ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S.val i :=
  gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i)
    (fun n => Grade (originalTorFiltration K hs d hrank j i) n)
    (fun n => (originalTorAssociatedBigraded K hs d hrank j i n).trans
      (barycentricRelativeBigradedCohomologyEquiv K hs d hrank (∅ : Set P) (by simp) j n i))

omit Q hQ a hstable in
def originalTorRankSelectedDirectSumEquiv (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S.val i) :=
  (originalTorRankSelectedEquiv K hs d hrank j i).trans
    (DirectSum.linearEquivFunOnFintype K _ _).symm

omit Q hQ hstable in
theorem originalTorRankSelectedEquiv_equivariant (j i : ℕ) (g : G)
    (x : originalTorAssociatedGraded K hs d hrank j i)
    (S : {S : Finset (Fin d) // rankSubsetDegree S = j}) :
    originalTorRankSelectedEquiv K hs d hrank j i
      (originalTorAssociatedRepresentation K hs d hrank a j i g x) S =
      (rankColoredPairOrderAut hs d hrank (∅ : Set P) (a.orderIso g) (by simp)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S.val
        ((S.val.card : ℤ) - i - 1)
        (originalTorRankSelectedEquiv K hs d hrank j i x S) := by
  simp only [originalTorRankSelectedEquiv, gradedSumConditionEquiv_apply, LinearEquiv.trans_apply]
  have h₁ := congrArg (fun z => barycentricRelativeBigradedCohomologyEquiv K hs d hrank
      (∅ : Set P) (by simp) j (rankSubsetWeight d S.val) i z ⟨S.val, S.property, rfl⟩)
    (originalTorAssociatedBigraded_equivariant K hs d hrank (a.orderIso g)
      j i (rankSubsetWeight d S.val) (x (rankSubsetWeight d S.val)))
  have h₂ := barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank (∅ : Set P)
    (by simp) (a.orderIso g) (by simp) j (rankSubsetWeight d S.val) i
      (originalTorAssociatedBigraded K hs d hrank j i (rankSubsetWeight d S.val)
        (x (rankSubsetWeight d S.val))) ⟨S.val, S.property, rfl⟩
  exact h₁.trans h₂
end Absolute

section RepresentationDescent
variable {M N : Type*} [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]

/-- Actual prescribed maps descend along a surjection; the group laws are
proved from the source representation and the intertwining equations. -/
def representationOfSurjectiveIntertwining (ρ : Representation K G M)
    (f : M →ₗ[K] N) (hf : Function.Surjective f) (σ : G → Module.End K N)
    (h : ∀ g x, f (ρ g x) = σ g (f x)) : Representation K G N where
  toFun := σ
  map_one' := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := hf x
    rw [← h, map_one]
    rfl
  map_mul' g k := by
    apply LinearMap.ext
    intro x
    obtain ⟨y, rfl⟩ := hf x
    change σ (g * k) (f y) = σ g (σ k (f y))
    rw [← h, ← h, ← h, map_mul]
    rfl
end RepresentationDescent

/-- The representation uses the independently defined cochain action. -/
def rankSelectedRelativeRepresentation (S : Finset (Fin d)) (i : ℕ) :
    Representation K G (rankSelectedRelativeCohomology K hs d hrank Q S i) := by
  let E := barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ
    (rankSubsetDegree S) (rankSubsetWeight d S) i
  let π : (∀ T : {T : Finset (Fin d) //
      rankSubsetDegree T = rankSubsetDegree S ∧ rankSubsetWeight d T = rankSubsetWeight d S},
      rankSelectedRelativeCohomology K hs d hrank Q T.val i) →ₗ[K]
      rankSelectedRelativeCohomology K hs d hrank Q S i :=
    LinearMap.proj (⟨S, rfl, rfl⟩ : {T : Finset (Fin d) //
      rankSubsetDegree T = rankSubsetDegree S ∧ rankSubsetWeight d T = rankSubsetWeight d S})
  have hπ : Function.Surjective π := LinearMap.proj_surjective
    (⟨S, rfl, rfl⟩ : {T : Finset (Fin d) //
      rankSubsetDegree T = rankSubsetDegree S ∧ rankSubsetWeight d T = rankSubsetWeight d S})
  exact representationOfSurjectiveIntertwining K
    (barycentricRelativeBigradedRepresentationAllRings K hs d hrank Q hQ a hstable
      (rankSubsetDegree S) (rankSubsetWeight d S) i)
    (π.comp E.toLinearMap) (hπ.comp E.surjective)
    (fun g => ((rankColoredPairOrderAut hs d hrank Q (a.orderIso g) (hstable g)).reducedCohomologyMap
      (D := rankColoredOrderComplex hs d hrank) K S ((S.card : ℤ) - i - 1)).hom)
    (fun g x => barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank Q hQ
      (a.orderIso g) (hstable g) (rankSubsetDegree S) (rankSubsetWeight d S) i x ⟨S, rfl, rfl⟩)

end FourPapers.Universal

namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology FourPapers.RepresentationGrothendieck
universe u v
variable {P K : Type u} {G : Type v} [PartialOrder P] [OrderBot P] [Fintype P] [Field K] [Group G]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (a : PosetGroupAction G P) (hstable : ∀ g p, a.orderIso g p ∈ Q ↔ p ∈ Q)

def rankSelectedRelativeFiniteRepresentation (S : Finset (Fin d)) (i : ℕ) :
    FiniteRepresentation K G := by
  let j := rankSubsetDegree S
  let n := rankSubsetWeight d S
  let V := barycentricRelativeBigradedFiniteRepresentation K hs d hrank Q a hstable hQ j n i
  letI : Module.Finite K (barycentricRelativeBigradedHomology (P := P) K d Q j n i) := V.finite
  let E := barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i
  letI := Module.Finite.equiv E
  let π : (∀ T : {T : Finset (Fin d) // rankSubsetDegree T = j ∧ rankSubsetWeight d T = n},
      rankSelectedRelativeCohomology K hs d hrank Q T.val i) →ₗ[K]
      rankSelectedRelativeCohomology K hs d hrank Q S i :=
    LinearMap.proj (⟨S, rfl, rfl⟩ :
      {T : Finset (Fin d) // rankSubsetDegree T = j ∧ rankSubsetWeight d T = n})
  have hπ : Function.Surjective π := LinearMap.proj_surjective
    (⟨S, rfl, rfl⟩ :
      {T : Finset (Fin d) // rankSubsetDegree T = j ∧ rankSubsetWeight d T = n})
  letI : Module.Finite K (rankSelectedRelativeCohomology K hs d hrank Q S i) :=
    Module.Finite.of_surjective π hπ
  exact FiniteRepresentation.of (rankSelectedRelativeCohomology K hs d hrank Q S i)
    (rankSelectedRelativeRepresentation K hs d hrank Q hQ a hstable S i)

theorem barycentricRelativeBigraded_class_cohomology (j n i : ℕ) :
    classOf K G (barycentricRelativeBigradedFiniteRepresentation K hs d hrank Q a hstable hQ j n i) =
      ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n},
        classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S.val i) := by
  calc
    _ = classOf K G (FiniteRepresentation.pi (fun S :
        {S : Finset (Fin d) // rankSubsetDegree S = j ∧ rankSubsetWeight d S = n} =>
          rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S.val i)) := by
      apply class_equiv (barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i)
      intro g x
      funext S
      exact barycentricRelativeBigradedCohomologyEquiv_natural K hs d hrank Q hQ
        (a.orderIso g) (hstable g) j n i x S
    _ = _ := class_pi _ _

/-- The representation-ring conclusion, including modular characteristic,
has precisely the rank-selected reduced relative cohomology summands. -/
theorem theorem_1_2_relative_grothendieck (j i : ℕ) :
    classOf K G (originalRelativeTorFiniteRepresentation K hs d hrank Q a hstable hQ j i) =
      ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S.val i) := by
  rw [originalRelativeTor_class_bigraded]
  simp_rw [barycentricRelativeBigraded_class_cohomology K hs d hrank Q hQ a hstable]
  have h := sum_finite_weight_fibers (fun S : Finset (Fin d) => rankSubsetDegree S = j)
    (rankSubsetWeight d)
    (fun S => classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank Q hQ a hstable S i))
    (2 * d * j + 1) (rankSubsetWeight_lt_cutoff d j)
  -- The abstract fiber lemma chooses a classical decision procedure for its
  -- predicate.  Its finite sets are extensionally the same actual fibers.
  refine Eq.trans ?_ (Eq.trans h ?_)
  · apply Finset.sum_congr rfl
    intro n hn
    apply Finset.sum_congr
    · ext S
      simp only [Finset.mem_univ]
    · intro S hS
      rfl
  · apply Finset.sum_congr
    · ext S
      simp only [Finset.mem_univ]
    · intro S hS
      rfl

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.AbsoluteCochains -/
section

/-! # Ordinary absolute cochains and the void relative complex

Absolute cochains are defined directly as the duals of the augmented face
chain modules.  The comparison with a void relative subcomplex is the dual
of the canonical quotient-by-zero equivalence.  It preserves the ordinary
inverse-permutation pullback, including the reduced augmentation degree.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory CommAlg
universe u v
variable {K : Type u} {V : Type v} [CommRing K] [Fintype V] [LinearOrder V]

theorem augmentedChains_eq_bot_of_void (Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) : Simplicial.Chains (k := K) Λ₀ i = ⊥ := by
  have hempty : {F : Finset V | Λ₀ F ∧ F.card = i} = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro F hF
    exact hvoid F hF.1
  rw [Simplicial.Chains, hempty, Set.image_empty, Submodule.span_empty]

theorem relativeFaceSubmodule_eq_bot_of_void (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) : relativeFaceSubmodule (K := K) Λ Λ₀ i = ⊥ := by
  rw [relativeFaceSubmodule, augmentedChains_eq_bot_of_void Λ₀ hvoid,
    Submodule.comap_bot, Submodule.ker_subtype]

def relativeVoidChainsEquiv (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) :
    RelativeAugmentedChains (K := K) Λ Λ₀ i ≃ₗ[K] Simplicial.Chains (k := K) Λ i :=
  (relativeFaceSubmodule (K := K) Λ Λ₀ i).quotEquivOfEqBot
    (relativeFaceSubmodule_eq_bot_of_void Λ Λ₀ hvoid i)

@[simp] theorem relativeVoidChainsEquiv_mk (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) (x : Simplicial.Chains (k := K) Λ i) :
    relativeVoidChainsEquiv Λ Λ₀ hvoid i (Submodule.Quotient.mk x) = x := rfl

@[simp] theorem relativeVoidChainsEquiv_symm (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) (x : Simplicial.Chains (k := K) Λ i) :
    (relativeVoidChainsEquiv Λ Λ₀ hvoid i).symm x = Submodule.Quotient.mk x := rfl

def augmentedCoboundary (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    Module.Dual K (Simplicial.Chains (k := K) Λ i) →ₗ[K]
      Module.Dual K (Simplicial.Chains (k := K) Λ (i + 1)) :=
  (augmentedFaceBoundary Λ hΛ i).dualMap

theorem augmentedCoboundary_square (Λ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    (augmentedCoboundary (K := K) Λ hΛ (i + 1)).comp
      (augmentedCoboundary (K := K) Λ hΛ i) = 0 := by
  apply LinearMap.ext
  intro f
  apply LinearMap.ext
  intro x
  change f (augmentedFaceBoundary Λ hΛ i (augmentedFaceBoundary Λ hΛ (i + 1) x)) = 0
  have hz : augmentedFaceBoundary (K := K) Λ hΛ i
      (augmentedFaceBoundary Λ hΛ (i + 1) x) = 0 :=
    Subtype.ext (Simplicial.boundary_boundary x.val)
  rw [hz, map_zero]

def augmentedCochainComplex (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) :
    CochainComplex (ModuleCat.{max u v} K) ℕ :=
  CochainComplex.of
    (fun i => ModuleCat.of K (Module.Dual K (Simplicial.Chains (k := K) Λ i)))
    (fun i => ModuleCat.ofHom (augmentedCoboundary Λ hΛ i))
    (fun i => ModuleCat.hom_ext (augmentedCoboundary_square Λ hΛ i))

@[simp] theorem augmentedCochainComplex_d (Λ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (i : ℕ) :
    (augmentedCochainComplex (K := K) Λ hΛ).d i (i + 1) =
      ModuleCat.ofHom (augmentedCoboundary Λ hΛ i) := by
  simp [augmentedCochainComplex]

/-- Reduced cohomology directly from the ordinary augmented chain modules. -/
def reducedCohomology (Λ : Finset V → Prop) (hΛ : Simplicial.Downward Λ) (q : ℤ) :
    ModuleCat.{max u v} K :=
  if -1 ≤ q then (augmentedCochainComplex (K := K) Λ hΛ).homology (q + 1).toNat
  else ModuleCat.of K (ULift.{v} (Fin 0 → K))

def relativeVoidCochainsEquiv (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ) :
    Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i) ≃ₗ[K]
      Module.Dual K (Simplicial.Chains (k := K) Λ i) :=
  (relativeVoidChainsEquiv Λ Λ₀ hvoid i).symm.dualMap

@[simp] theorem relativeVoidCochainsEquiv_apply (Λ Λ₀ : Finset V → Prop)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ)
    (f : Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i))
    (x : Simplicial.Chains (k := K) Λ i) :
    relativeVoidCochainsEquiv Λ Λ₀ hvoid i f x = f (Submodule.Quotient.mk x) := rfl

theorem relativeVoidCochainsEquiv_differential (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀)
    (hvoid : ∀ F, ¬ Λ₀ F) (i : ℕ)
    (f : Module.Dual K (RelativeAugmentedChains (K := K) Λ Λ₀ i)) :
    augmentedCoboundary Λ hΛ i (relativeVoidCochainsEquiv Λ Λ₀ hvoid i f) =
      relativeVoidCochainsEquiv Λ Λ₀ hvoid (i + 1)
        (relativeAugmentedCoboundary Λ Λ₀ hΛ hΛ₀ i f) := by
  ext x
  rfl

def relativeVoidCochainComplexIso (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀)
    (hvoid : ∀ F, ¬ Λ₀ F) :
    relativeAugmentedCochainComplex (K := K) Λ Λ₀ hΛ hΛ₀ ≅ augmentedCochainComplex Λ hΛ :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (relativeVoidCochainsEquiv Λ Λ₀ hvoid i).toModuleIso) (by
      intro i j hij
      obtain rfl : j = i + 1 := hij.symm
      simp only [relativeAugmentedCochainComplex, CochainComplex.of_d,
        augmentedCochainComplex_d]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      exact relativeVoidCochainsEquiv_differential Λ Λ₀ hΛ hΛ₀ hvoid i)

def relativeVoidReducedCohomologyIso (Λ Λ₀ : Finset V → Prop)
    (hΛ : Simplicial.Downward Λ) (hΛ₀ : Simplicial.Downward Λ₀)
    (hvoid : ∀ F, ¬ Λ₀ F) (q : ℤ) :
    reducedRelativeCohomology (K := K) Λ Λ₀ hΛ hΛ₀ q ≅ reducedCohomology Λ hΛ q := by
  by_cases hq : -1 ≤ q
  · simpa only [reducedRelativeCohomology, reducedCohomology, if_pos hq] using
      HomologicalComplex.homologyMapIso
        (relativeVoidCochainComplexIso (K := K) Λ Λ₀ hΛ hΛ₀ hvoid) (q + 1).toNat
  · simp only [reducedRelativeCohomology, reducedCohomology, if_neg hq]
    exact Iso.refl _

end FourPapers.Universal

namespace FourPapers.Universal.ProperlyColoredComplex.Subcomplex
open Classical CategoryTheory CommAlg
universe u v
variable {V : Type u} {C : Type} {K : Type u} [Fintype V] [Fintype C] [LinearOrder C] [CommRing K]
variable [D : FourPapers.Universal.ProperlyColoredComplex V C] {Q : D.Subcomplex}
local instance : DecidableEq C := Classical.decEq C
set_option synthInstance.checkSynthOrder false in
local instance absoluteCochainsVertexOrder : LinearOrder V := D.colorLinearOrder
local instance : DecidableEq V := Classical.decEq V

theorem rankSelection_void (hvoid : ∀ F, ¬ Q.face F) (S : Finset C) (F : Finset V) :
    ¬ rankSelection Q.toColoredComplex S F := fun h => hvoid F h.1

namespace ColorPairAutomorphism
variable (e : Q.ColorPairAutomorphism) (K)

def absoluteInverseFace (S : Finset C) (i : ℕ)
    (F : AugmentedFaceIndex (rankSelection D S) i) :
    AugmentedFaceIndex (rankSelection D S) i :=
  ⟨F.val.image e.vertex.symm, by
    simpa only [ColorPairAutomorphism.symm] using
      (e.symm.rankSelection_iff S F.val).mpr F.property.1,
    (Finset.card_image_of_injective F.val e.vertex.symm.injective).trans F.property.2⟩

/-- The ordinary inverse-permutation map on oriented faces.  Proper coloring
orders a face by its distinct colors, so its orientation is preserved. -/
def absoluteChainPullback (S : Finset C) (i : ℕ) :
    Module.End K (Simplicial.Chains (k := K) (rankSelection D S) i) :=
  (augmentedChainBasis (K := K) (rankSelection D S) i).constr K
    (fun F => augmentedChainBasis (rankSelection D S) i (e.absoluteInverseFace S i F))

/-- Absolute cochains act by ordinary pullback along the inverse face map. -/
def absoluteCochainTermMap (S : Finset C) (i : ℕ) :
    Module.End K (Module.Dual K (Simplicial.Chains (k := K) (rankSelection D S) i)) :=
  (e.absoluteChainPullback K S i).dualMap

@[simp] theorem absoluteCochainTermMap_basis (S : Finset C) (i : ℕ)
    (f : Module.Dual K (Simplicial.Chains (k := K) (rankSelection D S) i))
    (F : AugmentedFaceIndex (rankSelection D S) i) :
    e.absoluteCochainTermMap K S i f (augmentedChainBasis (rankSelection D S) i F) =
      f (augmentedChainBasis (rankSelection D S) i (e.absoluteInverseFace S i F)) := by
  change f ((augmentedChainBasis (K := K) (rankSelection D S) i).constr K _
    (augmentedChainBasis (rankSelection D S) i F)) = _
  rw [Module.Basis.constr_basis]

variable (hvoid : ∀ F, ¬ Q.face F)

theorem relativeVoidCochainsEquiv_natural (S : Finset C) (i : ℕ)
    (f : (Q.rankCochainComplex K S).X i) :
    relativeVoidCochainsEquiv (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_void hvoid S) i (e.cochainEquiv K S i f) =
    e.absoluteCochainTermMap K S i
      (relativeVoidCochainsEquiv (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_void hvoid S) i f) := by
  apply (augmentedChainBasis (K := K) (rankSelection D S) i).ext
  intro F
  rw [relativeVoidCochainsEquiv_apply (K := K), e.absoluteCochainTermMap_basis K S i,
    relativeVoidCochainsEquiv_apply (K := K)]
  exact e.cochainEquiv_coordinate K S i f
    ⟨F.val, F.property.1, F.property.2, rankSelection_void hvoid S F.val⟩

include hvoid in
theorem absoluteCochainTermMap_differential (S : Finset C) (i : ℕ)
    (f : Module.Dual K (Simplicial.Chains (k := K) (rankSelection D S) i)) :
    augmentedCoboundary (rankSelection D S) (rankSelection_downward D S) i
      (e.absoluteCochainTermMap K S i f) =
    e.absoluteCochainTermMap K S (i + 1)
      (augmentedCoboundary (rankSelection D S) (rankSelection_downward D S) i f) := by
  obtain ⟨f, rfl⟩ := (relativeVoidCochainsEquiv (K := K)
    (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_void hvoid S) i).surjective f
  rw [← e.relativeVoidCochainsEquiv_natural K hvoid S i,
    relativeVoidCochainsEquiv_differential (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
      (rankSelection_void hvoid S) i]
  have hd := e.cochainEquiv_differential K S i f
  change ((Q.rankCochainComplex K S).d i (i + 1)).hom
      (e.cochainEquiv K S i f) =
    e.cochainEquiv K S (i + 1) (((Q.rankCochainComplex K S).d i (i + 1)).hom f) at hd
  rw [Q.rankCochainComplex_d K S i] at hd
  change relativeAugmentedCoboundary (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) i
      (e.cochainEquiv K S i f) =
    e.cochainEquiv K S (i + 1)
      (relativeAugmentedCoboundary (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) i f) at hd
  rw [hd, e.relativeVoidCochainsEquiv_natural K hvoid S (i + 1),
    ← relativeVoidCochainsEquiv_differential (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
      (rankSelection_void hvoid S) i]

def absoluteCochainMap (S : Finset C) :
    augmentedCochainComplex (K := K) (rankSelection D S) (rankSelection_downward D S) ⟶
      augmentedCochainComplex (K := K) (rankSelection D S) (rankSelection_downward D S) where
  f i := ModuleCat.ofHom (e.absoluteCochainTermMap K S i)
  comm' i j hij := by
    obtain rfl : j = i + 1 := hij.symm
    simp only [augmentedCochainComplex_d (K := K)]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    exact e.absoluteCochainTermMap_differential K hvoid S i

theorem relativeVoidCochainComplexIso_natural (S : Finset C) :
    e.cochainMap K S ≫
      (relativeVoidCochainComplexIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S)).hom =
      (relativeVoidCochainComplexIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S)).hom ≫ e.absoluteCochainMap K hvoid S := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  exact e.relativeVoidCochainsEquiv_natural K hvoid S i

def absoluteReducedCohomologyMap (S : Finset C) (q : ℤ) :
    reducedCohomology (K := K) (rankSelection D S) (rankSelection_downward D S) q ⟶
      reducedCohomology (K := K) (rankSelection D S) (rankSelection_downward D S) q :=
  if hq : -1 ≤ q then by
    simp only [reducedCohomology, if_pos hq]
    exact HomologicalComplex.homologyMap (e.absoluteCochainMap K hvoid S) (q + 1).toNat
  else by
    simp only [reducedCohomology, if_neg hq]
    exact 𝟙 _

theorem relativeVoidReducedCohomologyIso_natural (S : Finset C) (q : ℤ) :
    e.reducedCohomologyMap K S q ≫
      (relativeVoidReducedCohomologyIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S) q).hom =
      (relativeVoidReducedCohomologyIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S) q).hom ≫ e.absoluteReducedCohomologyMap K hvoid S q := by
  by_cases hq : -1 ≤ q
  · have h := congrArg (fun f => HomologicalComplex.homologyMap f (q + 1).toNat)
      (e.relativeVoidCochainComplexIso_natural K hvoid S)
    rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp] at h
    let ER := relativeVoidCochainComplexIso (K := K)
      (rankSelection D S) (rankSelection Q.toColoredComplex S)
      (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
      (rankSelection_void hvoid S)
    have hR : reducedRelativeCohomology (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S) q =
        (Q.rankCochainComplex K S).homology (q + 1).toNat := by
      simpa only [reducedRelativeCohomology, if_pos hq]
    have hA : reducedCohomology (K := K)
        (rankSelection D S) (rankSelection_downward D S) q =
        (augmentedCochainComplex (K := K) (rankSelection D S)
          (rankSelection_downward D S)).homology (q + 1).toNat := by
      simp only [reducedCohomology, if_pos hq]
    have hleft : HEq (e.reducedCohomologyMap K S q)
        (HomologicalComplex.homologyMap (e.cochainMap K S) (q + 1).toNat) := by
      simp only [reducedCohomologyMap, dif_pos hq, eq_mpr_eq_cast]
      exact cast_heq _ _
    have hright : HEq (e.absoluteReducedCohomologyMap K hvoid S q)
        (HomologicalComplex.homologyMap (e.absoluteCochainMap K hvoid S) (q + 1).toNat) := by
      simp only [absoluteReducedCohomologyMap, dif_pos hq, eq_mpr_eq_cast]
      exact cast_heq _ _
    have he : HEq (relativeVoidReducedCohomologyIso (K := K)
        (rankSelection D S) (rankSelection Q.toColoredComplex S)
        (rankSelection_downward D S) (rankSelection_downward Q.toColoredComplex S)
        (rankSelection_void hvoid S) q)
        (HomologicalComplex.homologyMapIso ER (q + 1).toNat) := by
      simp only [relativeVoidReducedCohomologyIso, dif_pos hq, eq_mpr_eq_cast]
      exact cast_heq _ _
    have hom_heq {X Y X' Y' : ModuleCat.{u} K} (hX : X = X') (hY : Y = Y')
        {E : X ≅ Y} {E' : X' ≅ Y'} (hE : HEq E E') : HEq E.hom E'.hom := by
      cases hX
      cases hY
      cases hE
      rfl
    have hehom := hom_heq hR hA he
    apply eq_of_heq
    exact (CategoryTheory.heq_comp hR hR hA hleft hehom).trans
      ((heq_of_eq h).trans (CategoryTheory.heq_comp hR hA hA hehom hright).symm)
  · apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    haveI : Subsingleton (reducedCohomology (K := K)
        (rankSelection D S) (rankSelection_downward D S) q) := by
      simp only [reducedCohomology, if_neg hq]
      infer_instance
    exact Subsingleton.elim _ _

end ColorPairAutomorphism
end FourPapers.Universal.ProperlyColoredComplex.Subcomplex

end
