/- BEGIN FourPapers/Universal/ColorfulMonomials.lean -/
section

section
/-! # Proper coloring and the actual color-graded monomial basis

The indexing equivalence in this file uses the usual sum of vertex exponents
of each color.  Its inverse assigns the given color exponent to the unique
vertex of that color in a face.  It applies to arbitrary finite properly
colored complexes, including rank-colored order complexes.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.Universal
open Classical Finset MvPolynomial

variable {V C : Type*} [Fintype V] [Fintype C]

structure ProperlyColoredComplex (V C : Type*) where
  face : Finset V → Prop
  downward : ∀ ⦃s t : Finset V⦄, s ⊆ t → face t → face s
  color : V → C
  proper : ∀ s, face s → Set.InjOn color (s : Set V)

namespace ProperlyColoredComplex
variable (D : ProperlyColoredComplex V C)

def allowed (a : V →₀ ℕ) : Prop := D.face a.support

theorem allowed_divisorClosed : IsDivisorClosed D.allowed := by
  intro a b hab hb
  exact D.downward (Finsupp.support_mono hab) hb

def colorDegree (a : V →₀ ℕ) : C →₀ ℕ := a.mapDomain D.color

theorem colorDegree_support (a : V →₀ ℕ) :
    (D.colorDegree a).support = a.support.image D.color :=
  Finsupp.support_mapDomain_of_nonneg (fun _ => Nat.zero_le _) D.color

theorem colorDegree_at_vertex (a : V →₀ ℕ) (ha : D.allowed a) (v : V)
    (hv : v ∈ a.support) : D.colorDegree a (D.color v) = a v := by
  exact Finsupp.mapDomain_apply' (a.support : Set V) a (fun _ h => h)
    (D.proper a.support ha) hv

abbrev FaceWithColors (S : Finset C) :=
  {s : Finset V // D.face s ∧ s.image D.color = S}

abbrev MonomialOfColorDegree (β : C →₀ ℕ) :=
  {a : V →₀ ℕ // D.allowed a ∧ D.colorDegree a = β}

def exponentOnFace (β : C →₀ ℕ) (s : Finset V) : V →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun v => if v ∈ s then β (D.color v) else 0)

@[simp] theorem exponentOnFace_apply (β : C →₀ ℕ) (s : Finset V) (v : V) :
    D.exponentOnFace β s v = if v ∈ s then β (D.color v) else 0 := rfl

theorem exponentOnFace_support (β : C →₀ ℕ) (s : D.FaceWithColors β.support) :
    (D.exponentOnFace β s.val).support = s.val := by
  ext v
  rw [Finsupp.mem_support_iff, exponentOnFace_apply]
  by_cases hv : v ∈ s.val
  · rw [if_pos hv]
    have hc : D.color v ∈ β.support := by
      rw [← s.property.2]
      exact Finset.mem_image.mpr ⟨v, hv, rfl⟩
    exact iff_of_true (Finsupp.mem_support_iff.mp hc) hv
  · simp [hv]

theorem exponentOnFace_allowed (β : C →₀ ℕ) (s : D.FaceWithColors β.support) :
    D.allowed (D.exponentOnFace β s.val) := by
  unfold allowed
  rw [exponentOnFace_support]
  exact s.property.1

theorem exponentOnFace_colorDegree (β : C →₀ ℕ) (s : D.FaceWithColors β.support) :
    D.colorDegree (D.exponentOnFace β s.val) = β := by
  ext i
  by_cases hi : i ∈ β.support
  · have his : i ∈ s.val.image D.color := s.property.2.symm ▸ hi
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp his
    rw [D.colorDegree_at_vertex _ (D.exponentOnFace_allowed β s) v
      (by rw [D.exponentOnFace_support]; exact hv), exponentOnFace_apply, if_pos hv]
  · have hi' : i ∉ (D.colorDegree (D.exponentOnFace β s.val)).support := by
      rw [D.colorDegree_support, D.exponentOnFace_support, s.property.2]
      exact hi
    rw [Finsupp.notMem_support_iff.mp hi', Finsupp.notMem_support_iff.mp hi]

/-- The genuine color degree piece is indexed by faces having exactly the
positive colors, for arbitrary exponents and arbitrary coefficient rings. -/
def monomialColorEquiv (β : C →₀ ℕ) :
    D.MonomialOfColorDegree β ≃ D.FaceWithColors β.support where
  toFun a := ⟨a.val.support, a.property.1, by
    rw [← D.colorDegree_support, a.property.2]⟩
  invFun s := ⟨D.exponentOnFace β s.val, D.exponentOnFace_allowed β s,
    D.exponentOnFace_colorDegree β s⟩
  left_inv a := by
    apply Subtype.ext
    ext v
    rw [D.exponentOnFace_apply]
    by_cases hv : v ∈ a.val.support
    · rw [if_pos hv]
      have hh := congrArg (fun γ : C →₀ ℕ => γ (D.color v)) a.property.2
      exact hh.symm.trans (D.colorDegree_at_vertex a.val a.property.1 v hv)
    · rw [if_neg hv, Finsupp.notMem_support_iff.mp hv]
  right_inv s := Subtype.ext (D.exponentOnFace_support β s)

variable (K : Type*) [CommRing K]

abbrev Ring := MonomialQuotient (K := K) D.allowed

def monomial (a : V →₀ ℕ) : D.Ring K :=
  Ideal.Quotient.mk (forbiddenIdeal D.allowed) (MvPolynomial.monomial a (1 : K))

def colorParameter (i : C) : D.Ring K :=
  ∑ v ∈ Finset.univ.filter (fun v => D.color v = i),
    Ideal.Quotient.mk (forbiddenIdeal D.allowed) (X v)

theorem monomial_eq_zero_of_forbidden (a : V →₀ ℕ) (ha : ¬ D.allowed a) :
    D.monomial K a = 0 := by
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact Ideal.subset_span ⟨a, ha, rfl⟩

theorem variable_mul_monomial (v : V) (a : V →₀ ℕ) :
    Ideal.Quotient.mk (forbiddenIdeal D.allowed) (X v) * D.monomial K a =
      D.monomial K (Finsupp.single v 1 + a) := by
  rw [monomial, ← map_mul]
  simp only [MvPolynomial.X, MvPolynomial.monomial_mul, one_mul]
  rfl

theorem color_collision_forbidden (a : V →₀ ℕ) (ha : D.allowed a)
    (v w : V) (hw : w ∈ a.support) (hc : D.color v = D.color w) (hne : v ≠ w) :
    ¬ D.allowed (Finsupp.single v 1 + a) := by
  intro hall
  have hface : D.face ((Finsupp.single v 1 + a).support) := hall
  have hproper := D.proper ((Finsupp.single v 1 + a).support) hface
  have hv : v ∈ (Finsupp.single v 1 + a).support := by
    simp only [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_eq_same]
    omega
  have hw' : w ∈ (Finsupp.single v 1 + a).support :=
    Finsupp.support_mono (le_add_self : a ≤ Finsupp.single v 1 + a) hw
  exact hne (hproper hv hw' hc)

/-- Once a color is already present, multiplication by its color sum raises
exactly the exponent of its unique vertex; every other summand is a nonface. -/
theorem colorParameter_mul_of_present (a : V →₀ ℕ) (ha : D.allowed a)
    (w : V) (hw : w ∈ a.support) :
    D.colorParameter K (D.color w) * D.monomial K a =
      D.monomial K (Finsupp.single w 1 + a) := by
  rw [colorParameter, Finset.sum_mul]
  rw [Finset.sum_eq_single w]
  · exact D.variable_mul_monomial K w a
  · intro v hv hvw
    rw [D.variable_mul_monomial]
    exact D.monomial_eq_zero_of_forbidden K _
      (D.color_collision_forbidden a ha v w hw (Finset.mem_filter.mp hv).2 hvw)
  · intro hn
    exact (hn (Finset.mem_filter.mpr ⟨Finset.mem_univ w, rfl⟩)).elim

end ProperlyColoredComplex

variable {P : Type*} [PartialOrder P] [OrderBot P] [Fintype P]

/-- The rank-selected order complex, with its actual proper rank coloring. -/
def rankColoredOrderComplex (hs : IsSimplicialPoset P) (d : ℕ)
    (hrank : ∀ p : P, faceRank p ≤ d) :
    ProperlyColoredComplex (NonzeroFace P) (Fin d) where
  face s := ∀ p ∈ s, ∀ q ∈ s, p.val ≤ q.val ∨ q.val ≤ p.val
  downward := by
    intro s t hst ht p hp q hq
    exact ht p (hst hp) q (hst hq)
  color p := ⟨faceRank p.val - 1, by
    have hpos : 0 < faceRank p.val := by
      simpa only [faceRank_bot] using
        (faceRank_strictMono hs) (bot_lt_iff_ne_bot.mpr p.property)
    have hbound := hrank p.val
    omega⟩
  proper s hs' p hp q hq he := by
    have hpos (v : NonzeroFace P) : 0 < faceRank v.val := by
      simpa only [faceRank_bot] using
        (faceRank_strictMono hs) (bot_lt_iff_ne_bot.mpr v.property)
    have hr : faceRank p.val = faceRank q.val := by
      have hh := congrArg Fin.val he
      have hp' := hpos p
      have hq' := hpos q
      dsimp at hh
      omega
    apply Subtype.ext
    rcases hs' p hp q hq with hpq | hqp
    · by_contra hn
      exact (Nat.ne_of_lt ((faceRank_strictMono hs) (lt_of_le_of_ne hpq hn))) hr
    · by_contra hn
      exact (Nat.ne_of_lt ((faceRank_strictMono hs) (lt_of_le_of_ne hqp (Ne.symm hn)))) hr.symm

end FourPapers.Universal

end
end
end

/- BEGIN FourPapers/Universal/FiniteOrbitObstruction.lean -/
section

section

/-! # A direct modular obstruction from freely permuted components

An invariant functional vanishes on invariant vectors when the identity is a
sum of freely permuted component operators and the group order is zero in the
coefficient ring. No group-algebra projectivity criterion is required.
-/

set_option autoImplicit false

noncomputable section

namespace FourPapers.Universal

open Classical Finset

variable {G T K M N : Type*} [Group G] [Fintype G] [Fintype T]
  [MulAction G T] [CommRing K]

/-- A free orbit is explicitly in bijection with the acting group. -/
def freeOrbitEquiv (hfree : ∀ t : T, Function.Injective (fun g : G => g • t)) (t : T) :
    G ≃ MulAction.orbit G t :=
  Equiv.ofBijective (fun g => ⟨g • t, MulAction.mem_orbit t g⟩)
    ⟨fun g h he => hfree t (congrArg Subtype.val he), by
      rintro ⟨s, hs⟩
      obtain ⟨g, hg⟩ := MulAction.mem_orbit_iff.mp hs
      exact ⟨g, Subtype.ext hg⟩⟩

theorem sum_eq_zero_of_free_action
    (hfree : ∀ t : T, Function.Injective (fun g : G => g • t))
    (horder : (Fintype.card G : K) = 0) (f : T → K)
    (hf : ∀ (g : G) (t : T), f (g • t) = f t) : ∑ t, f t = 0 := by
  let Q := MulAction.orbitRel.Quotient G T
  letI : Fintype Q := Fintype.ofFinite _
  letI (q : Q) : Fintype (MulAction.orbit G q.out) := Fintype.ofFinite _
  calc
    (∑ t, f t) = ∑ q : (Σ q : Q, MulAction.orbit G q.out), f q.2.val :=
      Fintype.sum_equiv (MulAction.selfEquivSigmaOrbits G T) _ _ (fun _ => rfl)
    _ = ∑ q : Q, ∑ t : MulAction.orbit G q.out, f t.val := Fintype.sum_sigma _
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro q hq
      have he := Fintype.sum_equiv (freeOrbitEquiv hfree q.out)
        (fun g : G => f (g • q.out))
        (fun t : MulAction.orbit G q.out => f t.val) (fun _ => rfl)
      rw [← he]
      simp only [hf, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, horder, zero_mul]

variable [AddCommGroup M] [Module K M]

/-- A partition of the identity into component operators is enough for the
obstruction; orthogonality and idempotence need not be assumed here. -/
theorem invariantFunctional_eq_zero_of_free_components
    (ρ : G →* Module.End K M) (component : T → Module.End K M)
    (hidentity : ∀ x, ∑ t, component t x = x)
    (hcovariant : ∀ g t x, component (g • t) (ρ g x) = ρ g (component t x))
    (hfree : ∀ t : T, Function.Injective (fun g : G => g • t))
    (horder : (Fintype.card G : K) = 0)
    (ℓ : M →ₗ[K] K) (hℓ : ∀ g x, ℓ (ρ g x) = ℓ x)
    (v : M) (hv : ∀ g, ρ g v = v) : ℓ v = 0 := by
  have hf : ∀ (g : G) (t : T), ℓ (component (g • t) v) = ℓ (component t v) := by
    intro g t
    calc
      ℓ (component (g • t) v) = ℓ (component (g • t) (ρ g v)) := by rw [hv]
      _ = ℓ (ρ g (component t v)) := congrArg ℓ (hcovariant g t v)
      _ = ℓ (component t v) := hℓ g (component t v)
  calc
    ℓ v = ℓ (∑ t, component t v) := congrArg ℓ (hidentity v).symm
    _ = ∑ t, ℓ (component t v) := map_sum ℓ _ _
    _ = 0 := sum_eq_zero_of_free_action hfree horder _ hf

variable [AddCommGroup N] [Module K N] [Nontrivial K]

/-- An equivariant augmentation split by an invariant vector cannot be
transported to such a freely decomposed module in modular characteristic. -/
theorem no_equivariant_equiv_of_free_components
    (ρM : G →* Module.End K M) (ρN : G →* Module.End K N)
    (component : T → Module.End K N)
    (hidentity : ∀ x, ∑ t, component t x = x)
    (hcovariant : ∀ g t x, component (g • t) (ρN g x) = ρN g (component t x))
    (hfree : ∀ t : T, Function.Injective (fun g : G => g • t))
    (horder : (Fintype.card G : K) = 0)
    (ℓ : M →ₗ[K] K) (hℓ : ∀ g x, ℓ (ρM g x) = ℓ x)
    (v : M) (hv : ∀ g, ρM g v = v) (hvalue : ℓ v = 1)
    (e : M ≃ₗ[K] N) (he : ∀ g x, e (ρM g x) = ρN g (e x)) : False := by
  have hinv : ∀ g, ρN g (e v) = e v := by
    intro g
    rw [← he, hv]
  have heInv : ∀ g x, e.symm (ρN g x) = ρM g (e.symm x) := by
    intro g x
    apply e.injective
    rw [LinearEquiv.apply_symm_apply, he, LinearEquiv.apply_symm_apply]
  have hfunctional : ∀ g x, (ℓ.comp e.symm.toLinearMap) (ρN g x) =
      (ℓ.comp e.symm.toLinearMap) x := by
    intro g x
    change ℓ (e.symm (ρN g x)) = ℓ (e.symm x)
    rw [heInv, hℓ]
  have hzero := invariantFunctional_eq_zero_of_free_components ρN component
    hidentity hcovariant hfree horder (ℓ.comp e.symm.toLinearMap) hfunctional (e v) hinv
  have hone : (1 : K) = 0 := by
    simpa only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply,
      hvalue] using hzero
  exact one_ne_zero hone

end FourPapers.Universal
end
end
end

/- BEGIN FourPapers/Common/FilteredHomology.lean -/
section

section
set_option maxRecDepth 4000
set_option maxHeartbeats 300000
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
/-! # Homology of an exhaustive filtered complex with actual cycle lifts

All quotients in this file are literal submodule quotients.  The comparison
identifies the associated graded of `ker g / range f` with the homology of
the associated graded differential.  Its hypothesis is the ability to lift
each leading cycle to an actual cycle with the same leading term.
-/
noncomputable section
set_option autoImplicit false
namespace FourPapers.FilteredHomology
open Classical
variable {K : Type*} [CommRing K]

structure Filtration (M : Type*) [AddCommGroup M] [Module K M] where
  level : ℕ → Submodule K M
  zero : level 0 = ⊥
  mono : Monotone level
  exhaustive : ∀ x : M, ∃ n, x ∈ level n

variable {X Y Z : Type*} [AddCommGroup X] [Module K X]
  [AddCommGroup Y] [Module K Y] [AddCommGroup Z] [Module K Z]

def Preserves (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) : Prop := ∀ n x, x ∈ F.level n → f x ∈ G.level n

def LiftsCycles (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) : Prop :=
  ∀ n x, x ∈ F.level (n + 1) → f x ∈ G.level n →
    ∃ z, z ∈ F.level (n + 1) ∧ f z = 0 ∧ x - z ∈ F.level n

/-- Leading cycle lifts make the differential strict, by finite downward
correction of an arbitrary preimage. -/
theorem strict_of_liftsCycles (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (lift : LiftsCycles F G f) (n : ℕ) (x : X)
    (hx : f x ∈ G.level n) : ∃ y, y ∈ F.level n ∧ f y = f x := by
  obtain ⟨m, hm⟩ := F.exhaustive x
  induction m generalizing x with
  | zero =>
      have hz : x = 0 := by simpa only [F.zero, Submodule.mem_bot] using hm
      exact ⟨0, (F.level n).zero_mem, by simp [hz]⟩
  | succ m ih =>
      by_cases hmn : m + 1 ≤ n
      · exact ⟨x, F.mono hmn hm, rfl⟩
      · have hnm : n ≤ m := Nat.le_of_lt_succ (Nat.lt_of_not_ge hmn)
        obtain ⟨z, hz, hfz, hxz⟩ := lift m x hm (G.mono hnm hx)
        have he : f (x - z) = f x := by rw [map_sub, hfz, sub_zero]
        obtain ⟨y, hy, hey⟩ := ih (x - z) (by rwa [he]) hxz
        exact ⟨y, hy, hey.trans he⟩

def lowerInLevel (F : Filtration (K := K) X) (n : ℕ) : Submodule K (F.level (n + 1)) :=
  (F.level n).comap (F.level (n + 1)).subtype

abbrev Grade (F : Filtration (K := K) X) (n : ℕ) :=
  F.level (n + 1) ⧸ lowerInLevel F n

def levelMap (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (n : ℕ) : F.level n →ₗ[K] G.level n :=
  (f.domRestrict _).codRestrict _ (fun x => hf n x.val x.property)

def gradeMap (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (n : ℕ) : Grade F n →ₗ[K] Grade G n :=
  Submodule.mapQ _ _ (levelMap F G f hf (n + 1)) (fun x hx => hf n x.val hx)

@[simp] theorem gradeMap_mk (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f) (n : ℕ) (x : F.level (n + 1)) :
    gradeMap F G f hf n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (levelMap F G f hf (n + 1) x) := rfl

theorem gradeMap_comp (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (H : Filtration (K := K) Z) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hf : Preserves F G f) (hg : Preserves G H g) (hfg : g.comp f = 0) (n : ℕ) :
    (gradeMap G H g hg n).comp (gradeMap F G f hf n) = 0 := by
  apply LinearMap.ext
  intro x
  obtain ⟨x, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
  change Submodule.Quotient.mk
    (levelMap G H g hg (n + 1) (levelMap F G f hf (n + 1) x)) = 0
  have he : levelMap G H g hg (n + 1) (levelMap F G f hf (n + 1) x) = 0 :=
    Subtype.ext (LinearMap.congr_fun hfg x.val)
  rw [he]
  exact Submodule.Quotient.mk_zero _

def boundaryMap (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0) :
    X →ₗ[K] LinearMap.ker g :=
  f.codRestrict _ (fun x => LinearMap.congr_fun hfg x)

abbrev Homology (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0) :=
  LinearMap.ker g ⧸ LinearMap.range (boundaryMap f g hfg)

def homologyClass (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0) :
    LinearMap.ker g →ₗ[K] Homology f g hfg := (LinearMap.range (boundaryMap f g hfg)).mkQ

theorem homologyClass_eq_iff (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z) (hfg : g.comp f = 0)
    (z w : LinearMap.ker g) : homologyClass f g hfg z = homologyClass f g hfg w ↔
      ∃ x, f x = z.val - w.val := by
  rw [homologyClass, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨x, congrArg Subtype.val hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨x, Subtype.ext hx⟩

def cycleLevel (F : Filtration (K := K) Y) (g : Y →ₗ[K] Z) (n : ℕ) :
    Submodule K (LinearMap.ker g) := (F.level n).comap (LinearMap.ker g).subtype

def homologyLevel (F : Filtration (K := K) Y) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) (n : ℕ) : Submodule K (Homology f g hfg) :=
  (cycleLevel F g n).map (homologyClass f g hfg)

def homologyFiltration (F : Filtration (K := K) Y) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
    (hfg : g.comp f = 0) : Filtration (K := K) (Homology f g hfg) where
  level := homologyLevel F f g hfg
  zero := by simp [homologyLevel, cycleLevel, F.zero]
  mono := fun _ _ h => Submodule.map_mono (Submodule.comap_mono (F.mono h))
  exhaustive x := by
    obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap f g hfg)).mkQ_surjective x
    obtain ⟨n, hn⟩ := F.exhaustive z.val
    exact ⟨n, z, hn, rfl⟩

section Comparison
variable (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
  (H : Filtration (K := K) Z) (f : X →ₗ[K] Y) (g : Y →ₗ[K] Z)
  (hf : Preserves F G f) (hg : Preserves G H g) (hfg : g.comp f = 0) (n : ℕ)

abbrev GradedHomology := Homology (gradeMap F G f hf n) (gradeMap G H g hg n)
  (gradeMap_comp F G H f g hf hg hfg n)

def cycleToLevel : cycleLevel G g (n + 1) →ₗ[K] G.level (n + 1) :=
  (((LinearMap.ker g).subtype).comp (cycleLevel G g (n + 1)).subtype).codRestrict _
    (fun z => z.property)

def cycleToGradeCycle : cycleLevel G g (n + 1) →ₗ[K] LinearMap.ker (gradeMap G H g hg n) :=
  (((lowerInLevel G n).mkQ).comp (cycleToLevel G g n)).codRestrict _ (by
    intro z
    change Submodule.Quotient.mk (levelMap G H g hg (n + 1) (cycleToLevel G g n z)) = 0
    have he : levelMap G H g hg (n + 1) (cycleToLevel G g n z) = 0 :=
      Subtype.ext z.val.property
    rw [he]
    exact Submodule.Quotient.mk_zero _)

def leadingHomologyClass : cycleLevel G g (n + 1) →ₗ[K] GradedHomology F G H f g hf hg hfg n :=
  (homologyClass _ _ (gradeMap_comp F G H f g hf hg hfg n)).comp (cycleToGradeCycle G H g hg n)

def filteredHomologyClass : cycleLevel G g (n + 1) →ₗ[K]
    Grade (homologyFiltration G f g hfg) n :=
  (lowerInLevel (homologyFiltration G f g hfg) n).mkQ.comp
    (((homologyClass f g hfg).comp (cycleLevel G g (n + 1)).subtype).codRestrict _
      (fun z => ⟨z.val, z.property, rfl⟩))

theorem leadingHomologyClass_surjective (lift : LiftsCycles G H g) :
    Function.Surjective (leadingHomologyClass F G H f g hf hg hfg n) := by
  intro x
  obtain ⟨z, rfl⟩ := (LinearMap.range (boundaryMap _ _
    (gradeMap_comp F G H f g hf hg hfg n))).mkQ_surjective x
  obtain ⟨y, hy⟩ := (lowerInLevel G n).mkQ_surjective z.val
  have hgy : g y.val ∈ H.level n := by
    have hh := z.property
    rw [← hy] at hh
    change (Submodule.Quotient.mk (levelMap G H g hg (n + 1) y) : Grade H n) = 0 at hh
    exact (Submodule.Quotient.mk_eq_zero (lowerInLevel H n)).mp hh
  obtain ⟨w, hw, hgw, hyw⟩ := lift n y.val y.property hgy
  refine ⟨⟨⟨w, hgw⟩, hw⟩, ?_⟩
  apply congrArg (homologyClass _ _ (gradeMap_comp F G H f g hf hg hfg n))
  apply Subtype.ext
  change Submodule.Quotient.mk (⟨w, hw⟩ : G.level (n + 1)) = z.val
  rw [← hy]
  apply (Submodule.Quotient.eq _).mpr
  change w - y.val ∈ G.level n
  simpa only [neg_sub] using (G.level n).neg_mem hyw

theorem filteredHomologyClass_surjective :
    Function.Surjective (filteredHomologyClass G f g hfg n) := by
  intro x
  obtain ⟨y, rfl⟩ := (lowerInLevel (homologyFiltration G f g hfg) n).mkQ_surjective x
  obtain ⟨z, hz, he⟩ := y.property
  refine ⟨⟨z, hz⟩, ?_⟩
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel (homologyFiltration G f g hfg) n))
  exact Subtype.ext he

theorem leadingHomologyClass_eq_zero_iff (z : cycleLevel G g (n + 1)) :
    leadingHomologyClass F G H f g hf hg hfg n z = 0 ↔
      ∃ x, x ∈ F.level (n + 1) ∧ z.val.val - f x ∈ G.level n := by
  change Submodule.Quotient.mk (cycleToGradeCycle G H g hg n z) = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  constructor
  · rintro ⟨x, hx⟩
    obtain ⟨y, rfl⟩ := (lowerInLevel F n).mkQ_surjective x
    refine ⟨y.val, y.property, ?_⟩
    have he := congrArg Subtype.val hx
    have hh := (Submodule.Quotient.eq _).mp he.symm
    exact hh
  · rintro ⟨x, hx, hz⟩
    refine ⟨Submodule.Quotient.mk (⟨x, hx⟩ : F.level (n + 1)), ?_⟩
    apply Subtype.ext
    apply Eq.symm
    exact (Submodule.Quotient.eq _).mpr hz

theorem filteredHomologyClass_eq_zero_iff (z : cycleLevel G g (n + 1)) :
    filteredHomologyClass G f g hfg n z = 0 ↔
      ∃ x, z.val.val - f x ∈ G.level n := by
  change Submodule.Quotient.mk _ = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  change (homologyClass f g hfg z.val) ∈ homologyLevel G f g hfg n ↔ _
  constructor
  · rintro ⟨w, hw, he⟩
    obtain ⟨x, hx⟩ := (homologyClass_eq_iff f g hfg z.val w).mp he.symm
    refine ⟨x, ?_⟩
    have he' : z.val.val - f x = w.val := by rw [hx]; abel
    rwa [he']
  · rintro ⟨x, hx⟩
    have hcycle : g (z.val.val - f x) = 0 := by
      have hgf : g (f x) = 0 := LinearMap.congr_fun hfg x
      rw [map_sub, z.val.property, hgf, sub_self]
    refine ⟨⟨z.val.val - f x, hcycle⟩, hx, ?_⟩
    apply (homologyClass_eq_iff f g hfg _ _).mpr
    refine ⟨-x, ?_⟩
    rw [map_neg]
    exact (sub_sub_cancel_left z.val.val (f x)).symm

theorem leading_filtered_kernel_eq (lift : LiftsCycles F G f) :
    LinearMap.ker (leadingHomologyClass F G H f g hf hg hfg n) =
      LinearMap.ker (filteredHomologyClass G f g hfg n) := by
  ext z
  rw [LinearMap.mem_ker, LinearMap.mem_ker,
    leadingHomologyClass_eq_zero_iff, filteredHomologyClass_eq_zero_iff]
  constructor
  · rintro ⟨x, hx, hz⟩
    exact ⟨x, hz⟩
  · rintro ⟨x, hx⟩
    have hfx : f x ∈ G.level (n + 1) := by
      have hh := (G.level (n + 1)).sub_mem z.property (G.mono (Nat.le_succ n) hx)
      change z.val.val - (z.val.val - f x) ∈ G.level (n + 1) at hh
      have he : z.val.val - (z.val.val - f x) = f x := by abel
      rwa [he] at hh
    obtain ⟨y, hy, he⟩ := strict_of_liftsCycles F G f lift (n + 1) x hfx
    exact ⟨y, hy, by simpa only [he] using hx⟩

/-- The canonical comparison, independent of any choice of cycle lifts. -/
def associatedHomologyEquiv (liftf : LiftsCycles F G f) (liftg : LiftsCycles G H g) :
    Grade (homologyFiltration G f g hfg) n ≃ₗ[K] GradedHomology F G H f g hf hg hfg n :=
  ((filteredHomologyClass G f g hfg n).quotKerEquivOfSurjective
    (filteredHomologyClass_surjective G f g hfg n)).symm |>.trans
    ((Submodule.quotEquivOfEq _ _ (leading_filtered_kernel_eq F G H f g hf hg hfg n liftf).symm).trans
      ((leadingHomologyClass F G H f g hf hg hfg n).quotKerEquivOfSurjective
        (leadingHomologyClass_surjective F G H f g hf hg hfg n liftg)))

@[simp] theorem associatedHomologyEquiv_class
    (liftf : LiftsCycles F G f) (liftg : LiftsCycles G H g)
    (z : cycleLevel G g (n + 1)) :
    associatedHomologyEquiv F G H f g hf hg hfg n liftf liftg
      (filteredHomologyClass G f g hfg n z) =
      leadingHomologyClass F G H f g hf hg hfg n z := by
  simp [associatedHomologyEquiv]

end Comparison

section Categorical
open CategoryTheory
universe u v
variable {R : Type u} [CommRing R]
  {M N L : Type v} [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N] [AddCommGroup L] [Module R L]

def linearShortComplex (f : M →ₗ[R] N) (g : N →ₗ[R] L) (hfg : g.comp f = 0) :
    ShortComplex (ModuleCat.{v} R) :=
  ShortComplex.mk (ModuleCat.ofHom f) (ModuleCat.ofHom g) (ModuleCat.hom_ext hfg)

/-- The quotient used above is precisely the standard categorical homology. -/
def categoricalHomologyIso (f : M →ₗ[R] N) (g : N →ₗ[R] L) (hfg : g.comp f = 0) :
    (linearShortComplex f g hfg).homology ≅ ModuleCat.of R (Homology f g hfg) :=
  (linearShortComplex f g hfg).moduleCatHomologyIso

end Categorical
end FourPapers.FilteredHomology

