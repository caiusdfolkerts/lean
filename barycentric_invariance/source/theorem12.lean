/- BEGIN FourPapers.Common.FilteredHomologyBilinear -/
section

/-! # Bilinear multiplication through three filtered homology windows

The products here are induced from an actual bilinear map on chain modules.
Cycle preservation and actual boundary primitives suffice; no unital algebra
structure is required. This permits the relative ideal product and products
between different internal degrees. The target product is constructed on the
associated chain grades and descended through their own boundary quotients.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.FilteredHomology
open CategoryTheory
universe u
variable {K : Type u} [CommRing K]

/-- Three consecutive actual chain modules with their filtrations and the
proved cycle-lifting properties. -/
structure BilinearHomologyWindow (K : Type u) [CommRing K] where
  left : ModuleCat.{u} K
  middle : ModuleCat.{u} K
  right : ModuleCat.{u} K
  incoming : left →ₗ[K] middle
  outgoing : middle →ₗ[K] right
  square_zero : outgoing.comp incoming = 0
  leftFiltration : Filtration (K := K) left
  middleFiltration : Filtration (K := K) middle
  rightFiltration : Filtration (K := K) right
  incoming_preserves : Preserves leftFiltration middleFiltration incoming
  outgoing_preserves : Preserves middleFiltration rightFiltration outgoing
  incoming_lifts : LiftsCycles leftFiltration middleFiltration incoming
  outgoing_lifts : LiftsCycles middleFiltration rightFiltration outgoing

namespace BilinearHomologyWindow
variable (W : BilinearHomologyWindow K)
abbrev cycles := LinearMap.ker W.outgoing
abbrev homology := Homology W.incoming W.outgoing W.square_zero
abbrev classMap : W.cycles →ₗ[K] W.homology :=
  homologyClass W.incoming W.outgoing W.square_zero
abbrev homologyFiltration :=
  FourPapers.FilteredHomology.homologyFiltration W.middleFiltration W.incoming W.outgoing W.square_zero
abbrev boundedCycles (n : ℕ) := cycleLevel W.middleFiltration W.outgoing n
abbrev filteredClass (n : ℕ) : W.boundedCycles (n + 1) →ₗ[K] Grade W.homologyFiltration n :=
  filteredHomologyClass W.middleFiltration W.incoming W.outgoing W.square_zero n
abbrev gradeCycles (n : ℕ) :=
  LinearMap.ker (gradeMap W.middleFiltration W.rightFiltration W.outgoing W.outgoing_preserves n)
abbrev gradedHomology (n : ℕ) :=
  GradedHomology W.leftFiltration W.middleFiltration W.rightFiltration W.incoming W.outgoing
    W.incoming_preserves W.outgoing_preserves W.square_zero n
abbrev gradedClass (n : ℕ) : W.gradeCycles n →ₗ[K] W.gradedHomology n :=
  homologyClass _ _ _
abbrev cycleProjection (n : ℕ) : W.boundedCycles (n + 1) →ₗ[K] W.gradeCycles n :=
  cycleToGradeCycle W.middleFiltration W.rightFiltration W.outgoing W.outgoing_preserves n
abbrev leadingClass (n : ℕ) : W.boundedCycles (n + 1) →ₗ[K] W.gradedHomology n :=
  leadingHomologyClass W.leftFiltration W.middleFiltration W.rightFiltration W.incoming W.outgoing
    W.incoming_preserves W.outgoing_preserves W.square_zero n

def associated (n : ℕ) : Grade W.homologyFiltration n ≃ₗ[K] W.gradedHomology n :=
  associatedHomologyEquiv W.leftFiltration W.middleFiltration W.rightFiltration
    W.incoming W.outgoing W.incoming_preserves W.outgoing_preserves W.square_zero n
    W.incoming_lifts W.outgoing_lifts

@[simp] theorem associated_class (n : ℕ) (x : W.boundedCycles (n + 1)) :
    W.associated n (W.filteredClass n x) = W.leadingClass n x :=
  associatedHomologyEquiv_class _ _ _ _ _ _ _ _ n _ _ x

theorem filteredClass_surjective (n : ℕ) : Function.Surjective (W.filteredClass n) :=
  filteredHomologyClass_surjective _ _ _ _ n

theorem cycleProjection_surjective (n : ℕ) : Function.Surjective (W.cycleProjection n) := by
  intro z
  obtain ⟨y, hy⟩ := (lowerInLevel W.middleFiltration n).mkQ_surjective z.val
  have hgy : W.outgoing y.val ∈ W.rightFiltration.level n := by
    have hh := z.property
    rw [← hy] at hh
    change (Submodule.Quotient.mk
      (levelMap W.middleFiltration W.rightFiltration W.outgoing W.outgoing_preserves (n + 1) y) :
        Grade W.rightFiltration n) = 0 at hh
    exact (Submodule.Quotient.mk_eq_zero (lowerInLevel W.rightFiltration n)).mp hh
  obtain ⟨w, hw, hgw, hyw⟩ := W.outgoing_lifts n y.val y.property hgy
  refine ⟨⟨⟨w, hgw⟩, hw⟩, ?_⟩
  apply Subtype.ext
  change Submodule.Quotient.mk (⟨w, hw⟩ : W.middleFiltration.level (n + 1)) = z.val
  rw [← hy]
  apply (Submodule.Quotient.eq _).mpr
  change w - y.val ∈ W.middleFiltration.level n
  simpa only [neg_sub] using (W.middleFiltration.level n).neg_mem hyw
end BilinearHomologyWindow

/-- An actual filtered chain-module product, with actual boundary primitives.
No multiplication is defined by transport through a desired comparison. -/
structure FilteredWindowProduct (A B C : BilinearHomologyWindow K) where
  chainProduct : A.middle →ₗ[K] B.middle →ₗ[K] C.middle
  cycles : ∀ x y, A.outgoing x = 0 → B.outgoing y = 0 →
    C.outgoing (chainProduct x y) = 0
  left_boundary : ∀ (a : A.left) (y : B.cycles),
    ∃ c : C.left, C.incoming c = chainProduct (A.incoming a) y.val
  right_boundary : ∀ (x : A.cycles) (b : B.left),
    ∃ c : C.left, C.incoming c = chainProduct x.val (B.incoming b)
  filtered : PreservesPair A.middleFiltration B.middleFiltration C.middleFiltration chainProduct

namespace FilteredWindowProduct
variable {A B C : BilinearHomologyWindow K} (P : FilteredWindowProduct A B C)

def cycleProduct : A.cycles →ₗ[K] B.cycles →ₗ[K] C.cycles where
  toFun x :=
    { toFun := fun y => ⟨P.chainProduct x.val y.val, P.cycles x.val y.val x.property y.property⟩
      map_add' y z := Subtype.ext (map_add (P.chainProduct x.val) y.val z.val)
      map_smul' c y := Subtype.ext (map_smul (P.chainProduct x.val) c y.val) }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (LinearMap.congr_fun (map_add P.chainProduct x.val z.val) y.val)
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (LinearMap.congr_fun (map_smul P.chainProduct c x.val) y.val)

def cycleProductClass : A.cycles →ₗ[K] B.cycles →ₗ[K] C.homology :=
  P.cycleProduct.compr₂ C.classMap

def homologyProduct : A.homology →ₗ[K] B.homology →ₗ[K] C.homology :=
  P.cycleProductClass.liftQ₂ _ _
    (by
      rintro x ⟨a, rfl⟩
      apply LinearMap.ext
      intro y
      obtain ⟨c, hc⟩ := P.left_boundary a y
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact ⟨c, Subtype.ext hc⟩)
    (by
      rintro y ⟨b, rfl⟩
      apply LinearMap.ext
      intro x
      obtain ⟨c, hc⟩ := P.right_boundary x b
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact ⟨c, Subtype.ext hc⟩)

@[simp] theorem homologyProduct_class (x : A.cycles) (y : B.cycles) :
    P.homologyProduct (A.classMap x) (B.classMap y) = C.classMap (P.cycleProduct x y) := rfl

theorem homologyProduct_filtered :
    PreservesPair A.homologyFiltration B.homologyFiltration C.homologyFiltration P.homologyProduct := by
  intro r s x y hx hy
  obtain ⟨z, hz, rfl⟩ := hx
  obtain ⟨w, hw, rfl⟩ := hy
  refine ⟨P.cycleProduct z w, P.filtered r s z.val w.val hz hw, ?_⟩
  exact (P.homologyProduct_class z w).symm

def homologyGradeProduct (r s : ℕ) :
    Grade A.homologyFiltration r →ₗ[K] Grade B.homologyFiltration s →ₗ[K]
      Grade C.homologyFiltration (r + s) :=
  gradeBilinearProduct _ _ _ P.homologyProduct P.homologyProduct_filtered r s

def boundedCycleProduct (r s : ℕ) :
    A.boundedCycles (r + 1) →ₗ[K] B.boundedCycles (s + 1) →ₗ[K] C.boundedCycles (r + s + 1) where
  toFun x :=
    { toFun := fun y => ⟨P.cycleProduct x.val y.val,
        P.filtered r s x.val.val y.val.val x.property y.property⟩
      map_add' y z := by
        apply Subtype.ext
        exact map_add (P.cycleProduct x.val) y.val z.val
      map_smul' c y := by
        apply Subtype.ext
        exact map_smul (P.cycleProduct x.val) c y.val }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_add P.cycleProduct x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_smul P.cycleProduct c x.val) y.val

@[simp] theorem homologyGradeProduct_class (r s : ℕ)
    (x : A.boundedCycles (r + 1)) (y : B.boundedCycles (s + 1)) :
    P.homologyGradeProduct r s (A.filteredClass r x) (B.filteredClass s y) =
      C.filteredClass (r + s) (P.boundedCycleProduct r s x y) := by
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel C.homologyFiltration (r + s)))
  apply Subtype.ext
  exact P.homologyProduct_class x.val y.val

/-- The product on the actual associated chain grades, restricted to cycles. -/
def gradedCycleProduct (r s : ℕ) :
    A.gradeCycles r →ₗ[K] B.gradeCycles s →ₗ[K] C.gradeCycles (r + s) where
  toFun x :=
    { toFun := fun y => ⟨gradeBilinearProduct A.middleFiltration B.middleFiltration C.middleFiltration
        P.chainProduct P.filtered r s x.val y.val, by
        obtain ⟨x, rfl⟩ := A.cycleProjection_surjective r x
        obtain ⟨y, rfl⟩ := B.cycleProjection_surjective s y
        exact (C.cycleProjection (r + s) (P.boundedCycleProduct r s x y)).property⟩
      map_add' y z := by
        apply Subtype.ext
        exact map_add (gradeBilinearProduct _ _ _ _ P.filtered r s x.val) y.val z.val
      map_smul' c y := by
        apply Subtype.ext
        exact map_smul (gradeBilinearProduct _ _ _ _ P.filtered r s x.val) c y.val }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_add (gradeBilinearProduct _ _ _ _ P.filtered r s) x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_smul (gradeBilinearProduct _ _ _ _ P.filtered r s) c x.val) y.val

def gradedCycleProductClass (r s : ℕ) :
    A.gradeCycles r →ₗ[K] B.gradeCycles s →ₗ[K] C.gradedHomology (r + s) :=
  (P.gradedCycleProduct r s).compr₂ (C.gradedClass (r + s))

theorem gradedCycleProductClass_lift (r s : ℕ)
    (x : A.boundedCycles (r + 1)) (y : B.boundedCycles (s + 1)) :
    P.gradedCycleProductClass r s (A.cycleProjection r x) (B.cycleProjection s y) =
      C.leadingClass (r + s) (P.boundedCycleProduct r s x y) := rfl

theorem associated_product_class (r s : ℕ)
    (x : A.boundedCycles (r + 1)) (y : B.boundedCycles (s + 1)) :
    C.associated (r + s) (P.homologyGradeProduct r s (A.filteredClass r x) (B.filteredClass s y)) =
      P.gradedCycleProductClass r s (A.cycleProjection r x) (B.cycleProjection s y) := by
  rw [P.homologyGradeProduct_class, C.associated_class, P.gradedCycleProductClass_lift]

theorem gradedCycleProductClass_left_zero (r s : ℕ) (x : A.gradeCycles r) (y : B.gradeCycles s)
    (hx : A.gradedClass r x = 0) : P.gradedCycleProductClass r s x y = 0 := by
  obtain ⟨x, rfl⟩ := A.cycleProjection_surjective r x
  obtain ⟨y, rfl⟩ := B.cycleProjection_surjective s y
  have hx0 : A.filteredClass r x = 0 := by
    apply (A.associated r).injective
    rw [map_zero, A.associated_class]
    exact hx
  rw [← P.associated_product_class r s x y, hx0, map_zero, LinearMap.zero_apply, map_zero]

theorem gradedCycleProductClass_right_zero (r s : ℕ) (x : A.gradeCycles r) (y : B.gradeCycles s)
    (hy : B.gradedClass s y = 0) : P.gradedCycleProductClass r s x y = 0 := by
  obtain ⟨x, rfl⟩ := A.cycleProjection_surjective r x
  obtain ⟨y, rfl⟩ := B.cycleProjection_surjective s y
  have hy0 : B.filteredClass s y = 0 := by
    apply (B.associated s).injective
    rw [map_zero, B.associated_class]
    exact hy
  rw [← P.associated_product_class r s x y, hy0, map_zero, map_zero]

def gradedHomologyProduct (r s : ℕ) :
    A.gradedHomology r →ₗ[K] B.gradedHomology s →ₗ[K] C.gradedHomology (r + s) :=
  (P.gradedCycleProductClass r s).liftQ₂ _ _
    (by
      rintro x ⟨a, rfl⟩
      apply LinearMap.ext
      intro y
      apply P.gradedCycleProductClass_left_zero r s _ y
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact ⟨a, rfl⟩)
    (by
      rintro y ⟨a, rfl⟩
      apply LinearMap.ext
      intro x
      apply P.gradedCycleProductClass_right_zero r s x _
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact ⟨a, rfl⟩)

@[simp] theorem gradedHomologyProduct_class (r s : ℕ) (x : A.gradeCycles r) (y : B.gradeCycles s) :
    P.gradedHomologyProduct r s (A.gradedClass r x) (B.gradedClass s y) =
      P.gradedCycleProductClass r s x y := rfl

/-- The canonical gr(H) to H(gr) identification respects independently
constructed products, including those on nonunital relative coefficient ideals. -/
theorem associated_multiplicative (r s : ℕ)
    (x : Grade A.homologyFiltration r) (y : Grade B.homologyFiltration s) :
    C.associated (r + s) (P.homologyGradeProduct r s x y) =
      P.gradedHomologyProduct r s (A.associated r x) (B.associated s y) := by
  obtain ⟨x, rfl⟩ := A.filteredClass_surjective r x
  obtain ⟨y, rfl⟩ := B.filteredClass_surjective s y
  rw [A.associated_class, B.associated_class]
  exact P.associated_product_class r s x y

end FilteredWindowProduct
end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Common.RestrictedGradeProduct -/
section

/-! # Products and inclusions for literally restricted filtrations

The inclusion of a submodule is injective on the associated grades of the
restricted filtration. This is a statement about chain modules and their
filtration quotients; it makes no assertion about inclusion on homology.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 500000
namespace FourPapers.FilteredHomology
open Classical
variable {K X Y Z : Type*} [CommRing K]
  [AddCommGroup X] [Module K X] [AddCommGroup Y] [Module K Y]
  [AddCommGroup Z] [Module K Z]

/-- The actual inclusion on consecutive quotients of an intersection filtration. -/
def restrictedGradeInclusion (F : Filtration (K := K) X) (N : Submodule K X) (n : ℕ) :
    Grade (submoduleFiltration F N) n →ₗ[K] Grade F n :=
  gradeMap (submoduleFiltration F N) F N.subtype (fun _ _ hx => hx) n

@[simp] theorem restrictedGradeInclusion_mk (F : Filtration (K := K) X)
    (N : Submodule K X) (n : ℕ)
    (x : (submoduleFiltration F N).level (n + 1)) :
    restrictedGradeInclusion F N n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (⟨x.val.val, x.property⟩ : F.level (n + 1)) := rfl

theorem restrictedGradeInclusion_injective (F : Filtration (K := K) X)
    (N : Submodule K X) (n : ℕ) :
    Function.Injective (restrictedGradeInclusion F N n) := by
  intro x y h
  obtain ⟨x, rfl⟩ := (lowerInLevel (submoduleFiltration F N) n).mkQ_surjective x
  obtain ⟨y, rfl⟩ := (lowerInLevel (submoduleFiltration F N) n).mkQ_surjective y
  change (Submodule.Quotient.mk (⟨x.val.val, x.property⟩ : F.level (n + 1)) : Grade F n) =
    Submodule.Quotient.mk (⟨y.val.val, y.property⟩ : F.level (n + 1)) at h
  apply (Submodule.Quotient.eq _).mpr
  exact (Submodule.Quotient.eq (lowerInLevel F n)).mp h

/-- Literal restriction of a bilinear map to three preserved submodules. -/
def restrictedBilinearProduct (p : X →ₗ[K] Y →ₗ[K] Z)
    (N : Submodule K X) (M : Submodule K Y) (L : Submodule K Z)
    (hNML : ∀ x, x ∈ N → ∀ y, y ∈ M → p x y ∈ L) :
    N →ₗ[K] M →ₗ[K] L where
  toFun x :=
    { toFun := fun y => ⟨p x.val y.val, hNML x.val x.property y.val y.property⟩
      map_add' y z := Subtype.ext (map_add (p x.val) y.val z.val)
      map_smul' c y := Subtype.ext (map_smul (p x.val) c y.val) }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_add p x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun (map_smul p c x.val) y.val

@[simp] theorem restrictedBilinearProduct_val (p : X →ₗ[K] Y →ₗ[K] Z)
    (N : Submodule K X) (M : Submodule K Y) (L : Submodule K Z)
    (hNML : ∀ x, x ∈ N → ∀ y, y ∈ M → p x y ∈ L) (x : N) (y : M) :
    (restrictedBilinearProduct p N M L hNML x y).val = p x.val y.val := rfl

theorem restrictedBilinearProduct_preservesPair
    (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (H : Filtration (K := K) Z) (p : X →ₗ[K] Y →ₗ[K] Z)
    (hp : PreservesPair F G H p)
    (N : Submodule K X) (M : Submodule K Y) (L : Submodule K Z)
    (hNML : ∀ x, x ∈ N → ∀ y, y ∈ M → p x y ∈ L) :
    PreservesPair (submoduleFiltration F N) (submoduleFiltration G M)
      (submoduleFiltration H L) (restrictedBilinearProduct p N M L hNML) :=
  fun r s x y hx hy => hp r s x.val y.val hx hy

/-- Restricted chain products give exactly the ambient product after the
injective inclusion of chain grades. -/
theorem restrictedGradeInclusion_product
    (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (H : Filtration (K := K) Z) (p : X →ₗ[K] Y →ₗ[K] Z)
    (hp : PreservesPair F G H p)
    (N : Submodule K X) (M : Submodule K Y) (L : Submodule K Z)
    (hNML : ∀ x, x ∈ N → ∀ y, y ∈ M → p x y ∈ L)
    (r s : ℕ) (x : Grade (submoduleFiltration F N) r)
    (y : Grade (submoduleFiltration G M) s) :
    restrictedGradeInclusion H L (r + s)
      (gradeBilinearProduct (submoduleFiltration F N) (submoduleFiltration G M)
        (submoduleFiltration H L) (restrictedBilinearProduct p N M L hNML)
        (restrictedBilinearProduct_preservesPair F G H p hp N M L hNML) r s x y) =
      gradeBilinearProduct F G H p hp r s
        (restrictedGradeInclusion F N r x) (restrictedGradeInclusion G M s y) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel (submoduleFiltration F N) r).mkQ_surjective x
  obtain ⟨y, rfl⟩ := (lowerInLevel (submoduleFiltration G M) s).mkQ_surjective y
  rfl

/-- The square between the actual restricted map and the ambient map
commutes already on chain grades. -/
theorem restrictedGradeInclusion_map
    (F : Filtration (K := K) X) (G : Filtration (K := K) Y)
    (f : X →ₗ[K] Y) (hf : Preserves F G f)
    (N : Submodule K X) (M : Submodule K Y)
    (hNM : ∀ x, x ∈ N → f x ∈ M) (n : ℕ)
    (x : Grade (submoduleFiltration F N) n) :
    restrictedGradeInclusion G M n
      (gradeMap (submoduleFiltration F N) (submoduleFiltration G M)
        (restrictedMap f N M hNM) (restrictedMap_preserves F G f hf N M hNM) n x) =
      gradeMap F G f hf n (restrictedGradeInclusion F N n x) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel (submoduleFiltration F N) n).mkQ_surjective x
  rfl

end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Universal.RelativeCoefficientKoszulProduct -/
section

/-! # The product on the actual ideal-coefficient Koszul homology

The coefficient ideal need not contain one or any parameter. Its product is
restricted from the ordinary coefficient exterior product. Boundaries are
removed using explicit primitives whose coefficients remain in the ideal;
no injection from relative to absolute homology is used.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace FourPapers.Universal
open Classical Finset CategoryTheory FourPapers.FilteredHomology

universe u
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

/-- The exterior elements all of whose actual basis coefficients lie in `I`. -/
def coefficientExteriorIdeal (I : Ideal B) : Submodule K (CoefficientExterior B C) :=
  coefficientExteriorLevel (fun _ : ℤ => I.restrictScalars K) (fun _ : C => 0) 0

@[simp] theorem coefficientExteriorIdeal_mem (I : Ideal B) (x : CoefficientExterior B C) :
    x ∈ coefficientExteriorIdeal (K := K) I ↔
      ∀ F : Finset C, coefficientExteriorBasis.repr x F ∈ I := by
  simp only [coefficientExteriorIdeal, coefficientExteriorLevel_mem, Submodule.restrictScalars_mem]

theorem coefficientExteriorIdeal_mul (I : Ideal B) (x y : CoefficientExterior B C)
    (hx : x ∈ coefficientExteriorIdeal (K := K) I)
    (hy : y ∈ coefficientExteriorIdeal (K := K) I) :
    x * y ∈ coefficientExteriorIdeal (K := K) I := by
  exact coefficientExteriorLevel_graded_mul
    (fun _ : ℤ => I.restrictScalars K)
    (fun _ _ a b _ hb => I.mul_mem_left a hb) (fun _ : C => 0) 0 0 x y hx hy

theorem coefficientExteriorIdeal_parity (γ : C → B) (I : Ideal B)
    (x : CoefficientExterior B C) (hx : x ∈ coefficientExteriorIdeal (K := K) I) :
    (coefficientExteriorDGA (K := K) γ).parity x ∈ coefficientExteriorIdeal (K := K) I := by
  change CliffordAlgebra.involute (Q := (0 : QuadraticForm B (C → B))) x ∈
    coefficientExteriorIdeal (K := K) I
  have hc := (coefficientExteriorIdeal_mem I x).mp hx
  rw [← (coefficientExteriorBasis (B := B) (C := C)).linearCombination_repr x]
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
  apply (coefficientExteriorIdeal (K := K) I).sum_mem
  intro F hF
  change CliffordAlgebra.involute (Q := (0 : QuadraticForm B (C → B)))
      ((coefficientExteriorBasis.repr x F) • (Pi.basisFun B C).ExteriorAlgebra F) ∈ _
  rw [map_smul, TauCeti.ExteriorAlgebra.involute_basis, smul_smul]
  apply coefficientExteriorLevel_smul_basis
  exact I.mul_mem_right _ (hc F)

abbrev idealCoefficientKoszulTerm (I : Ideal B) (i : ℕ) :=
  idealCoefficientSubmodule (K := K) (Set.powersetCard C i) I

theorem coefficientExteriorIdeal_lift (I : Ideal B) (i : ℕ)
    (x : Set.powersetCard C i →₀ B) (hx : x ∈ idealCoefficientKoszulTerm (K := K) I i) :
    coefficientExteriorLift (K := K) i x ∈ coefficientExteriorIdeal (K := K) I := by
  apply (coefficientExteriorLift_level_iff (fun _ : ℤ => I.restrictScalars K)
    (fun _ : C => 0) i 0 x).mpr
  rw [coefficientKoszulLevel_mem]
  exact hx

theorem coefficientExteriorIdeal_projection (I : Ideal B) (i : ℕ)
    (x : CoefficientExterior B C) (hx : x ∈ coefficientExteriorIdeal (K := K) I) :
    coefficientExteriorProjection (K := K) i x ∈ idealCoefficientKoszulTerm (K := K) I i := by
  intro F
  exact (coefficientExteriorIdeal_mem I x).mp hx F.val

theorem coefficientKoszulProduct_ideal (I : Ideal B) (i j : ℕ)
    (x : Set.powersetCard C i →₀ B) (y : Set.powersetCard C j →₀ B)
    (hx : x ∈ idealCoefficientKoszulTerm (K := K) I i)
    (hy : y ∈ idealCoefficientKoszulTerm (K := K) I j) :
    coefficientKoszulProduct (K := K) i j x y ∈ idealCoefficientKoszulTerm (K := K) I (i + j) := by
  exact coefficientExteriorIdeal_projection I (i + j) _
    (coefficientExteriorIdeal_mul I _ _
      (coefficientExteriorIdeal_lift I i x hx) (coefficientExteriorIdeal_lift I j y hy))

/-- The literal, generally nonunital, ideal-valued coordinate product. -/
def idealCoefficientKoszulProduct (I : Ideal B) (i j : ℕ) :
    idealCoefficientKoszulTerm (K := K) (C := C) I i →ₗ[K]
      idealCoefficientKoszulTerm (K := K) (C := C) I j →ₗ[K]
        idealCoefficientKoszulTerm (K := K) (C := C) I (i + j) where
  toFun x :=
    { toFun := fun y => ⟨coefficientKoszulProduct (K := K) i j x.val y.val,
        coefficientKoszulProduct_ideal I i j x.val y.val x.property y.property⟩
      map_add' y z := Subtype.ext (map_add (coefficientKoszulProduct (K := K) i j x.val) y.val z.val)
      map_smul' c y := Subtype.ext (map_smul (coefficientKoszulProduct (K := K) i j x.val) c y.val) }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (LinearMap.congr_fun
      (map_add (coefficientKoszulProduct (K := K) i j) x.val z.val) y.val)
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (LinearMap.congr_fun
      (map_smul (coefficientKoszulProduct (K := K) i j) c x.val) y.val)

@[simp] theorem idealCoefficientKoszulProduct_val (I : Ideal B) (i j : ℕ)
    (x : idealCoefficientKoszulTerm (K := K) (C := C) I i)
    (y : idealCoefficientKoszulTerm (K := K) (C := C) I j) :
    (idealCoefficientKoszulProduct (K := K) I i j x y).val =
      coefficientKoszulProduct (K := K) i j x.val y.val := rfl

/-- The actual subcomplex with ideal-valued coordinates. -/
def idealCoefficientKoszulComplex (γ : C → B) (I : Ideal B) :
    ChainComplex (ModuleCat.{u} K) ℕ :=
  submoduleComplex (parameterKoszulComplex (K := K) γ)
    (idealCoefficientKoszulTerm (K := K) (C := C) I) (by
      intro i x hx
      simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
      change parameterKoszulDifferential (K := K) γ i x ∈
        idealCoefficientSubmodule (K := K) _ I
      exact parameterKoszulDifferential_ideal (K := K) γ I i x hx)

@[simp] theorem idealCoefficientKoszulIncoming_val (γ : C → B) (I : Ideal B) (i : ℕ)
    (x : idealCoefficientKoszulTerm (K := K) (C := C) I (i + 1)) :
    (complexIncoming (idealCoefficientKoszulComplex (K := K) γ I) i x).val =
      parameterKoszulDifferential (K := K) γ i x.val := by
  simp only [complexIncoming, idealCoefficientKoszulComplex, submoduleComplex_d,
    parameterKoszulComplex_d, ModuleCat.hom_ofHom] <;> rfl

@[simp] theorem idealCoefficientKoszulOutgoing_val (γ : C → B) (I : Ideal B) (i : ℕ)
    (x : idealCoefficientKoszulTerm (K := K) (C := C) I i) :
    (complexOutgoing (idealCoefficientKoszulComplex (K := K) γ I) i x).val =
      coefficientExteriorOutgoing (K := K) γ i x.val := by
  exact submoduleComplex_outgoing_val
    (parameterKoszulComplex (K := K) γ)
    (idealCoefficientKoszulTerm (K := K) (C := C) I)
    (by
      intro j y hy
      simp only [complexIncoming, parameterKoszulComplex_d, ModuleCat.hom_ofHom]
      change parameterKoszulDifferential (K := K) γ j y ∈
        idealCoefficientSubmodule (K := K) _ I
      exact parameterKoszulDifferential_ideal (K := K) γ I j y hy) i x

abbrev IdealCoefficientKoszulCycles (γ : C → B) (I : Ideal B) (i : ℕ) :=
  LinearMap.ker (complexOutgoing (idealCoefficientKoszulComplex (K := K) γ I) i)

lemma idealCoefficientKoszulCycle_val (γ : C → B) (I : Ideal B) (i : ℕ)
    (x : IdealCoefficientKoszulCycles (K := K) γ I i) :
    coefficientExteriorOutgoing (K := K) γ i x.val.val = 0 := by
  have h : complexOutgoing (idealCoefficientKoszulComplex (K := K) γ I) i x.val = 0 := x.property
  have hh := congrArg (fun y : idealCoefficientKoszulTerm (K := K) (C := C) I (i - 1) => y.val) h
  simpa only [idealCoefficientKoszulOutgoing_val, Submodule.coe_zero] using hh

/-- Product of actual relative cycles. -/
def idealCoefficientKoszulCycleProduct (γ : C → B) (I : Ideal B) (i j : ℕ) :
    IdealCoefficientKoszulCycles (K := K) γ I i →ₗ[K]
      IdealCoefficientKoszulCycles (K := K) γ I j →ₗ[K]
        IdealCoefficientKoszulCycles (K := K) γ I (i + j) where
  toFun x :=
    { toFun := fun y => ⟨idealCoefficientKoszulProduct (K := K) I i j x.val y.val, by
        apply Subtype.ext
        change (complexOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j)
          (idealCoefficientKoszulProduct (K := K) I i j x.val y.val)).val = 0
        rw [idealCoefficientKoszulOutgoing_val, idealCoefficientKoszulProduct_val]
        exact coefficientKoszulProduct_cycle γ i j x.val.val y.val.val
          (idealCoefficientKoszulCycle_val γ I i x) (idealCoefficientKoszulCycle_val γ I j y)⟩
      map_add' y z := Subtype.ext (map_add (idealCoefficientKoszulProduct (K := K) I i j x.val) y.val z.val)
      map_smul' c y := Subtype.ext (map_smul (idealCoefficientKoszulProduct (K := K) I i j x.val) c y.val) }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (LinearMap.congr_fun
      (map_add (idealCoefficientKoszulProduct (K := K) I i j) x.val z.val) y.val)
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    exact Subtype.ext (LinearMap.congr_fun
      (map_smul (idealCoefficientKoszulProduct (K := K) I i j) c x.val) y.val)

@[simp] theorem idealCoefficientKoszulCycleProduct_val (γ : C → B) (I : Ideal B) (i j : ℕ)
    (x : IdealCoefficientKoszulCycles (K := K) γ I i)
    (y : IdealCoefficientKoszulCycles (K := K) γ I j) :
    (idealCoefficientKoszulCycleProduct (K := K) γ I i j x y).val =
      idealCoefficientKoszulProduct (K := K) I i j x.val y.val := rfl

/-- A primitive for a product whose first input is a boundary. -/
def coefficientKoszulLeftPrimitive (i j : ℕ)
    (a : Set.powersetCard C (i + 1) →₀ B) (y : Set.powersetCard C j →₀ B) :
    Set.powersetCard C (i + j + 1) →₀ B :=
  coefficientExteriorProjection (K := K) (i + j + 1)
    (coefficientExteriorLift (K := K) (i + 1) a * coefficientExteriorLift (K := K) j y)

/-- A primitive for a product whose second input is a boundary. The parity
involution supplies the usual sign without a homological-degree cast. -/
def coefficientKoszulRightPrimitive (γ : C → B) (i j : ℕ)
    (x : Set.powersetCard C i →₀ B) (b : Set.powersetCard C (j + 1) →₀ B) :
    Set.powersetCard C (i + j + 1) →₀ B :=
  coefficientExteriorProjection (K := K) (i + j + 1)
    ((coefficientExteriorDGA (K := K) γ).parity (coefficientExteriorLift (K := K) i x) *
      coefficientExteriorLift (K := K) (j + 1) b)

theorem coefficientKoszulLeftPrimitive_differential (γ : C → B) (i j : ℕ)
    (a : Set.powersetCard C (i + 1) →₀ B) (y : Set.powersetCard C j →₀ B)
    (hy : coefficientExteriorOutgoing (K := K) γ j y = 0) :
    parameterKoszulDifferential (K := K) γ (i + j)
      (coefficientKoszulLeftPrimitive (K := K) i j a y) =
    coefficientKoszulProduct (K := K) i j (parameterKoszulDifferential (K := K) γ i a) y := by
  rw [coefficientKoszulLeftPrimitive, coefficientExteriorProjection_differential,
    (coefficientExteriorDGA (K := K) γ).leibniz,
    coefficientExteriorDGA_lift, coefficientExteriorLift_cycle γ j y hy,
    mul_zero, add_zero] <;> rfl

theorem coefficientKoszulRightPrimitive_differential (γ : C → B) (i j : ℕ)
    (x : Set.powersetCard C i →₀ B) (b : Set.powersetCard C (j + 1) →₀ B)
    (hx : coefficientExteriorOutgoing (K := K) γ i x = 0) :
    parameterKoszulDifferential (K := K) γ (i + j)
      (coefficientKoszulRightPrimitive (K := K) γ i j x b) =
    coefficientKoszulProduct (K := K) i j x (parameterKoszulDifferential (K := K) γ j b) := by
  rw [coefficientKoszulRightPrimitive, coefficientExteriorProjection_differential,
    (coefficientExteriorDGA (K := K) γ).leibniz,
    (coefficientExteriorDGA (K := K) γ).parity_cycle (coefficientExteriorLift_cycle γ i x hx),
    (coefficientExteriorDGA (K := K) γ).parity_square,
    coefficientExteriorDGA_lift, zero_mul, zero_add] <;> rfl

theorem coefficientKoszulLeftPrimitive_ideal (I : Ideal B) (i j : ℕ)
    (a : Set.powersetCard C (i + 1) →₀ B) (y : Set.powersetCard C j →₀ B)
    (ha : a ∈ idealCoefficientKoszulTerm (K := K) I (i + 1))
    (hy : y ∈ idealCoefficientKoszulTerm (K := K) I j) :
    coefficientKoszulLeftPrimitive (K := K) i j a y ∈
      idealCoefficientKoszulTerm (K := K) I (i + j + 1) :=
  coefficientExteriorIdeal_projection I (i + j + 1) _
    (coefficientExteriorIdeal_mul I _ _
      (coefficientExteriorIdeal_lift I (i + 1) a ha) (coefficientExteriorIdeal_lift I j y hy))

theorem coefficientKoszulRightPrimitive_ideal (γ : C → B) (I : Ideal B) (i j : ℕ)
    (x : Set.powersetCard C i →₀ B) (b : Set.powersetCard C (j + 1) →₀ B)
    (hx : x ∈ idealCoefficientKoszulTerm (K := K) I i)
    (hb : b ∈ idealCoefficientKoszulTerm (K := K) I (j + 1)) :
    coefficientKoszulRightPrimitive (K := K) γ i j x b ∈
      idealCoefficientKoszulTerm (K := K) I (i + j + 1) :=
  coefficientExteriorIdeal_projection I (i + j + 1) _
    (coefficientExteriorIdeal_mul I _ _
      (coefficientExteriorIdeal_parity γ I _ (coefficientExteriorIdeal_lift I i x hx))
      (coefficientExteriorIdeal_lift I (j + 1) b hb))

/-- The primitive remains in the actual relative complex. -/
theorem idealCoefficientKoszulCycleProduct_left_boundary_eq (γ : C → B) (I : Ideal B) (i j : ℕ)
    (a : idealCoefficientKoszulTerm (K := K) (C := C) I (i + 1))
    (y : IdealCoefficientKoszulCycles (K := K) γ I j) :
    ∃ z : idealCoefficientKoszulTerm (K := K) (C := C) I (i + j + 1),
      boundaryMap _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j)) z =
        idealCoefficientKoszulCycleProduct (K := K) γ I i j
          (boundaryMap _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) i) a) y := by
  let z : idealCoefficientKoszulTerm (K := K) (C := C) I (i + j + 1) :=
    ⟨coefficientKoszulLeftPrimitive (K := K) i j a.val y.val.val,
      coefficientKoszulLeftPrimitive_ideal I i j a.val y.val.val a.property y.val.property⟩
  refine ⟨z, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  change (complexIncoming (idealCoefficientKoszulComplex (K := K) γ I) (i + j) z).val =
    coefficientKoszulProduct (K := K) i j
      (complexIncoming (idealCoefficientKoszulComplex (K := K) γ I) i a).val y.val.val
  rw [idealCoefficientKoszulIncoming_val, idealCoefficientKoszulIncoming_val]
  exact coefficientKoszulLeftPrimitive_differential γ i j a.val y.val.val
    (idealCoefficientKoszulCycle_val γ I j y)

theorem idealCoefficientKoszulCycleProduct_right_boundary_eq (γ : C → B) (I : Ideal B) (i j : ℕ)
    (x : IdealCoefficientKoszulCycles (K := K) γ I i)
    (b : idealCoefficientKoszulTerm (K := K) (C := C) I (j + 1)) :
    ∃ z : idealCoefficientKoszulTerm (K := K) (C := C) I (i + j + 1),
      boundaryMap _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j)) z =
        idealCoefficientKoszulCycleProduct (K := K) γ I i j x
          (boundaryMap _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) j) b) := by
  let z : idealCoefficientKoszulTerm (K := K) (C := C) I (i + j + 1) :=
    ⟨coefficientKoszulRightPrimitive (K := K) γ i j x.val.val b.val,
      coefficientKoszulRightPrimitive_ideal γ I i j x.val.val b.val x.val.property b.property⟩
  refine ⟨z, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  change (complexIncoming (idealCoefficientKoszulComplex (K := K) γ I) (i + j) z).val =
    coefficientKoszulProduct (K := K) i j x.val.val
      (complexIncoming (idealCoefficientKoszulComplex (K := K) γ I) j b).val
  rw [idealCoefficientKoszulIncoming_val, idealCoefficientKoszulIncoming_val]
  exact coefficientKoszulRightPrimitive_differential γ i j x.val.val b.val
    (idealCoefficientKoszulCycle_val γ I i x)

def idealCoefficientKoszulCycleProductClass (γ : C → B) (I : Ideal B) (i j : ℕ) :
    IdealCoefficientKoszulCycles (K := K) γ I i →ₗ[K]
      IdealCoefficientKoszulCycles (K := K) γ I j →ₗ[K]
        complexKernelHomology (idealCoefficientKoszulComplex (K := K) γ I) (i + j) :=
  (idealCoefficientKoszulCycleProduct (K := K) γ I i j).compr₂
    (homologyClass _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j)))

theorem idealCoefficientKoszulCycleProductClass_left_boundary (γ : C → B) (I : Ideal B) (i j : ℕ) :
    LinearMap.range (boundaryMap _ _
      (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) i)) ≤
      LinearMap.ker (idealCoefficientKoszulCycleProductClass (K := K) γ I i j) := by
  rintro x ⟨a, rfl⟩
  apply LinearMap.ext
  intro y
  change homologyClass _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j))
    (idealCoefficientKoszulCycleProduct (K := K) γ I i j (boundaryMap _ _ _ a) y) = 0
  exact (Submodule.Quotient.mk_eq_zero _).mpr
    (idealCoefficientKoszulCycleProduct_left_boundary_eq γ I i j a y)

theorem idealCoefficientKoszulCycleProductClass_right_boundary (γ : C → B) (I : Ideal B) (i j : ℕ) :
    LinearMap.range (boundaryMap _ _
      (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) j)) ≤
      LinearMap.ker (idealCoefficientKoszulCycleProductClass (K := K) γ I i j).flip := by
  rintro y ⟨b, rfl⟩
  apply LinearMap.ext
  intro x
  change homologyClass _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j))
    (idealCoefficientKoszulCycleProduct (K := K) γ I i j x (boundaryMap _ _ _ b)) = 0
  exact (Submodule.Quotient.mk_eq_zero _).mpr
    (idealCoefficientKoszulCycleProduct_right_boundary_eq γ I i j x b)

/-- The product on the relative homology itself, formed by its own two
boundary quotients. The ambient homology is absent from this definition. -/
def idealCoefficientKoszulHomologyProduct (γ : C → B) (I : Ideal B) (i j : ℕ) :
    complexKernelHomology (idealCoefficientKoszulComplex (K := K) γ I) i →ₗ[K]
      complexKernelHomology (idealCoefficientKoszulComplex (K := K) γ I) j →ₗ[K]
        complexKernelHomology (idealCoefficientKoszulComplex (K := K) γ I) (i + j) :=
  (idealCoefficientKoszulCycleProductClass (K := K) γ I i j).liftQ₂ _ _
    (idealCoefficientKoszulCycleProductClass_left_boundary γ I i j)
    (idealCoefficientKoszulCycleProductClass_right_boundary γ I i j)

@[simp] theorem idealCoefficientKoszulHomologyProduct_class (γ : C → B) (I : Ideal B) (i j : ℕ)
    (x : IdealCoefficientKoszulCycles (K := K) γ I i)
    (y : IdealCoefficientKoszulCycles (K := K) γ I j) :
    idealCoefficientKoszulHomologyProduct (K := K) γ I i j
        (homologyClass _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) i) x)
        (homologyClass _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) j) y) =
      homologyClass _ _ (complexIncomingOutgoing (idealCoefficientKoszulComplex (K := K) γ I) (i + j))
        (idealCoefficientKoszulCycleProduct (K := K) γ I i j x y) := rfl

section OriginalRelativeIdentification
variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (Q : Set P)

/-- The generic ideal complex is the already defined original relative complex. -/
theorem originalRelativeKoszulComplex_eq_ideal :
    originalRelativeKoszulComplex K hs d Q =
      idealCoefficientKoszulComplex (K := K)
        (fun r : Fin d => faceRankParameter K hs (r.val + 1))
        (faceRestrictionIdeal K hs Q) := rfl

/-- The barycentric relative complex is independently the same ideal construction. -/
theorem barycentricRelativeKoszulComplex_eq_ideal :
    barycentricRelativeKoszulComplex (P := P) K d Q =
      idealCoefficientKoszulComplex (K := K)
        (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1))
        (barycentricRestrictionIdeal (P := P) K Q) := rfl

end OriginalRelativeIdentification
end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeKoszulProductComparison -/
section

/-! # The actual relative products in every internal degree

The products are restrictions of the coefficient/exterior Koszul product to
actual restriction ideals intersected with ordinary-degree submodules.  The
strictly lower product defect of the parameter-linear comparison proves
multiplicativity on their chain grades.  No homology inclusion is assumed to
be injective, and no product is defined by transport through the comparison.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

/-- Triangularity transfers the canonical lower product defect to the actual
parameter-linear coefficient comparison. -/
theorem originalKoszulCoefficientProduct_lower (i l r s : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (y : Set.powersetCard (Fin d) l →₀ BarycentricRing (P := P) K)
    (hx : x ∈ (barycentricKoszulFiltration (P := P) K d i).level (r + 1))
    (hy : y ∈ (barycentricKoszulFiltration (P := P) K d l).level (s + 1)) :
    originalKoszulCoefficientEquiv K hs d hrank (i + l)
        (coefficientKoszulProduct (K := K) i l x y) -
      coefficientKoszulProduct (K := K) i l
        (originalKoszulCoefficientEquiv K hs d hrank i x)
        (originalKoszulCoefficientEquiv K hs d hrank l y) ∈
      (originalKoszulFiltration K hs d (i + l)).level (r + s) := by
  let e₁ := originalKoszulCoefficientEquiv K hs d hrank i
  let e₂ := originalKoszulCoefficientEquiv K hs d hrank l
  let e₃ := originalKoszulCoefficientEquiv K hs d hrank (i + l)
  let c₁ := canonicalKoszulCoefficientEquiv K hs d i
  let c₂ := canonicalKoszulCoefficientEquiv K hs d l
  let c₃ := canonicalKoszulCoefficientEquiv K hs d (i + l)
  let p := coefficientKoszulProduct (K := K) (B := FaceRing K hs) (C := Fin d) i l
  let q := coefficientKoszulProduct (K := K) (B := BarycentricRing (P := P) K) (C := Fin d) i l
  let L := (originalKoszulFiltration K hs d (i + l)).level (r + s)
  have hxlow : e₁ x - c₁ x ∈ (originalKoszulFiltration K hs d i).level r :=
    originalKoszulCoefficientEquiv_error_lower K hs d hrank i r x hx
  have hylow : e₂ y - c₂ y ∈ (originalKoszulFiltration K hs d l).level s :=
    originalKoszulCoefficientEquiv_error_lower K hs d hrank l s y hy
  have hey : e₂ y ∈ (originalKoszulFiltration K hs d l).level (s + 1) :=
    (originalKoszulCoefficientEquiv_filtered K hs d hrank l (s + 1) y).mpr hy
  have hcx : c₁ x ∈ (originalKoszulFiltration K hs d i).level (r + 1) :=
    (canonicalKoszulCoefficientEquiv_filtered K hs d i (r + 1) x).mpr hx
  have hfirst : e₃ (q x y) - c₃ (q x y) ∈ L :=
    originalKoszulCoefficientEquiv_error_lower K hs d hrank (i + l) (r + s) (q x y)
      (barycentricKoszulProduct_filtered K d hrank i l r s x y hx hy)
  have hcanonical : c₃ (q x y) - p (c₁ x) (c₂ y) ∈ L :=
    canonicalKoszulCoefficientProduct_lower K hs d hrank i l r s x y hx hy
  have hleft : p (e₁ x - c₁ x) (e₂ y) ∈ L :=
    preservesPair_left_lower (originalKoszulFiltration K hs d i)
      (originalKoszulFiltration K hs d l) (originalKoszulFiltration K hs d (i + l))
      p (originalKoszulProduct_filtered K hs d hrank i l) r s _ _ hxlow hey
  have hright : p (c₁ x) (e₂ y - c₂ y) ∈ L :=
    preservesPair_right_lower (originalKoszulFiltration K hs d i)
      (originalKoszulFiltration K hs d l) (originalKoszulFiltration K hs d (i + l))
      p (originalKoszulProduct_filtered K hs d hrank i l) r s _ _ hcx hylow
  have hid : e₃ (q x y) - p (e₁ x) (e₂ y) =
      ((e₃ (q x y) - c₃ (q x y)) + (c₃ (q x y) - p (c₁ x) (c₂ y))) -
        p (e₁ x - c₁ x) (e₂ y) - p (c₁ x) (e₂ y - c₂ y) := by
    simp only [map_sub, LinearMap.sub_apply]
    abel
  change e₃ (q x y) - p (e₁ x) (e₂ y) ∈ L
  rw [hid]
  exact L.sub_mem (L.sub_mem (L.add_mem hfirst hcanonical) hleft) hright

/-- The actual ideal and ordinary internal degree are both preserved. -/
theorem originalRelativeDegreeProduct_mem (j k i l : ℕ)
    (x : (originalKoszulComplex K hs d).X i)
    (y : (originalKoszulComplex K hs d).X l)
    (hx : x ∈ originalRelativeDegreeTerm K hs d Q j i)
    (hy : y ∈ originalRelativeDegreeTerm K hs d Q k l) :
    coefficientKoszulProduct (K := K) i l x y ∈
      originalRelativeDegreeTerm K hs d Q (j + k) (i + l) :=
  ⟨coefficientKoszulProduct_ideal (faceRestrictionIdeal K hs Q) i l x y hx.1 hy.1,
    originalKoszulProduct_internalDegree K hs d i l j k x y hx.2 hy.2⟩

theorem barycentricRelativeDegreeProduct_mem (j k i l : ℕ)
    (x : (barycentricKoszulComplex (P := P) K d).X i)
    (y : (barycentricKoszulComplex (P := P) K d).X l)
    (hx : x ∈ barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (hy : y ∈ barycentricRelativeDegreeTerm (P := P) K d Q k l) :
    coefficientKoszulProduct (K := K) i l x y ∈
      barycentricRelativeDegreeTerm (P := P) K d Q (j + k) (i + l) :=
  ⟨coefficientKoszulProduct_ideal (barycentricRestrictionIdeal K Q) i l x y hx.1 hy.1,
    barycentricKoszulProduct_internalDegree K d i l j k x y hx.2 hy.2⟩

/-- Literal restriction of the original coefficient/exterior product. -/
def originalRelativeInternalProduct (j k i l : ℕ) :
    originalRelativeDegreeTerm K hs d Q j i →ₗ[K]
      originalRelativeDegreeTerm K hs d Q k l →ₗ[K]
        originalRelativeDegreeTerm K hs d Q (j + k) (i + l) :=
  restrictedBilinearProduct (coefficientKoszulProduct (K := K) i l)
    (originalRelativeDegreeTerm K hs d Q j i) (originalRelativeDegreeTerm K hs d Q k l)
    (originalRelativeDegreeTerm K hs d Q (j + k) (i + l))
    (fun x hx y hy => originalRelativeDegreeProduct_mem K hs d Q j k i l x y hx hy)

/-- Literal restriction of the barycentric coefficient/exterior product. -/
def barycentricRelativeInternalProduct (j k i l : ℕ) :
    barycentricRelativeDegreeTerm (P := P) K d Q j i →ₗ[K]
      barycentricRelativeDegreeTerm (P := P) K d Q k l →ₗ[K]
        barycentricRelativeDegreeTerm (P := P) K d Q (j + k) (i + l) :=
  restrictedBilinearProduct (coefficientKoszulProduct (K := K) i l)
    (barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (barycentricRelativeDegreeTerm (P := P) K d Q k l)
    (barycentricRelativeDegreeTerm (P := P) K d Q (j + k) (i + l))
    (fun x hx y hy => barycentricRelativeDegreeProduct_mem K d Q j k i l x y hx hy)

@[simp] theorem originalRelativeInternalProduct_val (j k i l : ℕ)
    (x : originalRelativeDegreeTerm K hs d Q j i)
    (y : originalRelativeDegreeTerm K hs d Q k l) :
    (originalRelativeInternalProduct K hs d Q j k i l x y).val =
      coefficientKoszulProduct (K := K) i l x.val y.val := rfl

@[simp] theorem barycentricRelativeInternalProduct_val (j k i l : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (y : barycentricRelativeDegreeTerm (P := P) K d Q k l) :
    (barycentricRelativeInternalProduct K d Q j k i l x y).val =
      coefficientKoszulProduct (K := K) i l x.val y.val := rfl

include hrank in
theorem originalRelativeInternalProduct_filtered (j k i l : ℕ) :
    PreservesPair (originalRelativeDegreeFiltration K hs d Q j i)
      (originalRelativeDegreeFiltration K hs d Q k l)
      (originalRelativeDegreeFiltration K hs d Q (j + k) (i + l))
      (originalRelativeInternalProduct K hs d Q j k i l) :=
  fun r s x y hx hy => originalKoszulProduct_filtered K hs d hrank i l r s x.val y.val hx hy

include hrank in
theorem barycentricRelativeInternalProduct_filtered (j k i l : ℕ) :
    PreservesPair (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
      (barycentricRelativeDegreeFiltration (P := P) K d Q k l)
      (barycentricRelativeDegreeFiltration (P := P) K d Q (j + k) (i + l))
      (barycentricRelativeInternalProduct K d Q j k i l) :=
  fun r s x y hx hy => barycentricKoszulProduct_filtered K d hrank i l r s x.val y.val hx hy

/-- The actual relative parameter-linear comparison has lower product defect
inside the restricted filtration, in every pair of ordinary internal degrees. -/
theorem relativeInternalCoefficientProduct_lower (j k i l r s : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (y : barycentricRelativeDegreeTerm (P := P) K d Q k l)
    (hx : x ∈ (barycentricRelativeDegreeFiltration (P := P) K d Q j i).level (r + 1))
    (hy : y ∈ (barycentricRelativeDegreeFiltration (P := P) K d Q k l).level (s + 1)) :
    relativeInternalCoefficientEquiv K hs d Q hQ hrank (j + k) (i + l)
        (barycentricRelativeInternalProduct K d Q j k i l x y) -
      originalRelativeInternalProduct K hs d Q j k i l
        (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i x)
        (relativeInternalCoefficientEquiv K hs d Q hQ hrank k l y) ∈
      (originalRelativeDegreeFiltration K hs d Q (j + k) (i + l)).level (r + s) := by
  change originalKoszulCoefficientEquiv K hs d hrank (i + l)
      (coefficientKoszulProduct (K := K) i l x.val y.val) -
    coefficientKoszulProduct (K := K) i l
      (originalKoszulCoefficientEquiv K hs d hrank i x.val)
      (originalKoszulCoefficientEquiv K hs d hrank l y.val) ∈
    (originalKoszulFiltration K hs d (i + l)).level (r + s)
  exact originalKoszulCoefficientProduct_lower K hs d hrank i l r s x.val y.val hx hy

def originalRelativeInternalGradeProduct (j k i l r s : ℕ) :
    Grade (originalRelativeDegreeFiltration K hs d Q j i) r →ₗ[K]
      Grade (originalRelativeDegreeFiltration K hs d Q k l) s →ₗ[K]
        Grade (originalRelativeDegreeFiltration K hs d Q (j + k) (i + l)) (r + s) :=
  gradeBilinearProduct (originalRelativeDegreeFiltration K hs d Q j i)
    (originalRelativeDegreeFiltration K hs d Q k l)
    (originalRelativeDegreeFiltration K hs d Q (j + k) (i + l))
    (originalRelativeInternalProduct K hs d Q j k i l)
    (originalRelativeInternalProduct_filtered K hs d Q hrank j k i l) r s

def barycentricRelativeInternalGradeProduct (j k i l r s : ℕ) :
    Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) r →ₗ[K]
      Grade (barycentricRelativeDegreeFiltration (P := P) K d Q k l) s →ₗ[K]
        Grade (barycentricRelativeDegreeFiltration (P := P) K d Q (j + k) (i + l)) (r + s) :=
  gradeBilinearProduct (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
    (barycentricRelativeDegreeFiltration (P := P) K d Q k l)
    (barycentricRelativeDegreeFiltration (P := P) K d Q (j + k) (i + l))
    (barycentricRelativeInternalProduct K d Q j k i l)
    (barycentricRelativeInternalProduct_filtered K d Q hrank j k i l) r s

/-- The same actual strict comparison used by the relative Tor formula,
restricted to its consecutive chain quotients. -/
def relativeInternalGradeCoefficientEquiv (j i n : ℕ) :
    Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n ≃ₗ[K]
      Grade (originalRelativeDegreeFiltration K hs d Q j i) n :=
  gradeEquiv _ _ (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i)
    (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j i) n

theorem relativeInternalGradeCoefficientEquiv_multiplicative (j k i l r s : ℕ)
    (x : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) r)
    (y : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q k l) s) :
    relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank (j + k) (i + l) (r + s)
      (barycentricRelativeInternalGradeProduct K d Q hrank j k i l r s x y) =
    originalRelativeInternalGradeProduct K hs d Q hrank j k i l r s
      (relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank j i r x)
      (relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank k l s y) := by
  change (relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank
      (j + k) (i + l) (r + s)).toLinearMap
        (barycentricRelativeInternalGradeProduct K d Q hrank j k i l r s x y) =
    originalRelativeInternalGradeProduct K hs d Q hrank j k i l r s
      ((relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank j i r).toLinearMap x)
      ((relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank k l s).toLinearMap y)
  simp only [relativeInternalGradeCoefficientEquiv, gradeEquiv_eq_gradeMap]
  exact gradeBilinearProduct_natural_of_lower_defect
    (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
    (barycentricRelativeDegreeFiltration (P := P) K d Q k l)
    (barycentricRelativeDegreeFiltration (P := P) K d Q (j + k) (i + l))
    (barycentricRelativeInternalProduct K d Q j k i l)
    (barycentricRelativeInternalProduct_filtered K d Q hrank j k i l)
    (originalRelativeDegreeFiltration K hs d Q j i)
    (originalRelativeDegreeFiltration K hs d Q k l)
    (originalRelativeDegreeFiltration K hs d Q (j + k) (i + l))
    (originalRelativeInternalProduct K hs d Q j k i l)
    (originalRelativeInternalProduct_filtered K hs d Q hrank j k i l)
    (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i).toLinearMap
    (relativeInternalCoefficientEquiv K hs d Q hQ hrank k l).toLinearMap
    (relativeInternalCoefficientEquiv K hs d Q hQ hrank (j + k) (i + l)).toLinearMap
    (fun n x => (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j i n x).mpr)
    (fun n y => (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank k l n y).mpr)
    (fun n z => (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank (j + k) (i + l) n z).mpr)
    (relativeInternalCoefficientProduct_lower K hs d Q hQ hrank j k i l) r s x y

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeInternalHomologyProduct -/
section

/-! # The actual relative homology product in every internal degree

The relative chain product is descended through its own cycle and boundary
quotients.  Boundary primitives lie in the actual restriction ideal; projecting
them to the required ordinary internal degree gives primitives in that strand.
The associated-chain product is constructed independently and the generic
filtered-window theorem proves compatibility with the associated homology map.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

/-- The three literal modules around one degree of an actual filtered complex. -/
def complexBilinearHomologyWindow (C : ChainComplex (ModuleCat.{u} K) ℕ)
    (F : ∀ i, Filtration (K := K) (C.X i))
    (hf : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hl : ∀ i, LiftsCycles (F (i + 1)) (F i) (complexIncoming C i))
    (i : ℕ) : BilinearHomologyWindow K where
  left := C.X (i + 1)
  middle := C.X i
  right := C.X (i - 1)
  incoming := complexIncoming C i
  outgoing := complexOutgoing C i
  square_zero := complexIncomingOutgoing C i
  leftFiltration := F (i + 1)
  middleFiltration := F i
  rightFiltration := F (i - 1)
  incoming_preserves := hf i
  outgoing_preserves := complexOutgoing_preserves C F hf i
  incoming_lifts := hl i
  outgoing_lifts := complexOutgoing_liftsCycles C F hl i

@[simp] theorem complexBilinearHomologyWindow_associated
    (C : ChainComplex (ModuleCat.{u} K) ℕ) (F : ∀ i, Filtration (K := K) (C.X i))
    (hf : ∀ i, Preserves (F (i + 1)) (F i) (complexIncoming C i))
    (hl : ∀ i, LiftsCycles (F (i + 1)) (F i) (complexIncoming C i)) (i n : ℕ) :
    (complexBilinearHomologyWindow C F hf hl i).associated n =
      complexAssociatedHomologyEquiv C F hf hl i n := rfl

variable {P : Type u} [PartialOrder P] [OrderBot P] [Fintype P]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

def originalRelativeInternalWindow (j i : ℕ) : BilinearHomologyWindow K :=
  complexBilinearHomologyWindow (originalRelativeDegreeComplex K hs d Q hrank j)
    (originalRelativeDegreeFiltration K hs d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (originalRelativeDegreeIncoming_liftsCycles K hs d Q hQ hrank j) i

def barycentricRelativeInternalWindow (j i : ℕ) : BilinearHomologyWindow K :=
  complexBilinearHomologyWindow (barycentricRelativeDegreeComplex (P := P) K d Q j)
    (barycentricRelativeDegreeFiltration (P := P) K d Q j)
    (barycentricRelativeDegreeIncoming_preserves K d Q j)
    (barycentricRelativeDegreeIncoming_liftsCycles K hs d Q hQ j) i

@[simp] theorem originalRelativeDegreeIncoming_val (j i : ℕ)
    (x : originalRelativeDegreeTerm K hs d Q j (i + 1)) :
    (complexIncoming (originalRelativeDegreeComplex K hs d Q hrank j) i x).val =
      originalKoszulDifferential K hs d i x.val := by
  simp only [complexIncoming, originalRelativeDegreeComplex, submoduleComplex_d,
    parameterKoszulComplex_d, ModuleCat.hom_ofHom] <;> rfl

@[simp] theorem barycentricRelativeDegreeIncoming_val (j i : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j (i + 1)) :
    (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i x).val =
      parameterKoszulDifferential (K := K)
        (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i x.val := by
  simp only [complexIncoming, barycentricRelativeDegreeComplex, submoduleComplex_d,
    parameterKoszulComplex_d, ModuleCat.hom_ofHom] <;> rfl

@[simp] theorem originalRelativeDegreeOutgoing_val (j i : ℕ)
    (x : originalRelativeDegreeTerm K hs d Q j i) :
    (complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank j) i x).val =
      coefficientExteriorOutgoing (K := K)
        (fun r : Fin d => faceRankParameter K hs (r.val + 1)) i x.val :=
  submoduleComplex_outgoing_val _ _ _ i x

@[simp] theorem barycentricRelativeDegreeOutgoing_val (j i : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j i) :
    (complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q j) i x).val =
      coefficientExteriorOutgoing (K := K)
        (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i x.val :=
  submoduleComplex_outgoing_val _ _ _ i x

include hQ in
/-- Projection of a genuine ideal-valued primitive supplies a primitive in
its target ordinary-degree strand. -/
theorem originalRelativeDegreeBoundary_lift (j i : ℕ)
    (w : Set.powersetCard (Fin d) (i + 1) →₀ FaceRing K hs)
    (z : originalRelativeDegreeTerm K hs d Q j i)
    (hwI : w ∈ originalRelativeKoszulTerm K hs d Q (i + 1))
    (hw : originalKoszulDifferential K hs d i w = z.val) :
    ∃ a : originalRelativeDegreeTerm K hs d Q j (i + 1),
      complexIncoming (originalRelativeDegreeComplex K hs d Q hrank j) i a = z := by
  let a : originalRelativeDegreeTerm K hs d Q j (i + 1) :=
    ⟨originalKoszulDegreeProjection K hs d j (i + 1) w,
      originalKoszulDegreeProjection_relative K hs d hrank Q hQ j (i + 1) w hwI,
      FourPapers.BasisGrading.projection_mem _ _ _ w⟩
  refine ⟨a, ?_⟩
  apply Subtype.ext
  rw [originalRelativeDegreeIncoming_val]
  change originalKoszulDifferential K hs d i
    (originalKoszulDegreeProjection K hs d j (i + 1) w) = z.val
  have hc := LinearMap.congr_fun (originalKoszulDegreeProjection_commutes K hs d hrank j i) w
  change originalKoszulDifferential K hs d i
      (originalKoszulDegreeProjection K hs d j (i + 1) w) =
    originalKoszulDegreeProjection K hs d j i (originalKoszulDifferential K hs d i w) at hc
  rw [hc, hw]
  exact FourPapers.BasisGrading.projection_eq_self z.property.2

include hs hQ in
theorem barycentricRelativeDegreeBoundary_lift (j i : ℕ)
    (w : Set.powersetCard (Fin d) (i + 1) →₀ BarycentricRing (P := P) K)
    (z : barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (hwI : w ∈ barycentricRelativeKoszulTerm (P := P) K d Q (i + 1))
    (hw : parameterKoszulDifferential (K := K)
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i w = z.val) :
    ∃ a : barycentricRelativeDegreeTerm (P := P) K d Q j (i + 1),
      complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i a = z := by
  let a : barycentricRelativeDegreeTerm (P := P) K d Q j (i + 1) :=
    ⟨FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i + 1))
        originalKoszulDegree j w,
      barycentricProjection_relative K hs d Q hQ (i + 1) originalKoszulDegree j w hwI,
      FourPapers.BasisGrading.projection_mem _ _ _ w⟩
  refine ⟨a, ?_⟩
  apply Subtype.ext
  rw [barycentricRelativeDegreeIncoming_val]
  have hc := LinearMap.congr_fun (basisProjection_commutes
    (barycentricKoszulBasis (P := P) K d (i + 1)) (barycentricKoszulBasis (P := P) K d i)
    originalKoszulDegree originalKoszulDegree (complexIncoming (barycentricKoszulComplex (P := P) K d) i)
    (barycentricIncoming_degree K d i) j) w
  simp only [LinearMap.comp_apply, complexIncoming, parameterKoszulComplex_d,
    ModuleCat.hom_ofHom] at hc
  change parameterKoszulDifferential (K := K)
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i
      (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i + 1))
        originalKoszulDegree j w) =
    FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
      originalKoszulDegree j
      (parameterKoszulDifferential (K := K)
        (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i w) at hc
  change parameterKoszulDifferential (K := K)
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i
      (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i + 1))
        originalKoszulDegree j w) = z.val
  rw [hc, hw]
  exact FourPapers.BasisGrading.projection_eq_self z.property.2

theorem originalRelativeInternalProduct_cycle (j k i l : ℕ)
    (x : originalRelativeDegreeTerm K hs d Q j i)
    (y : originalRelativeDegreeTerm K hs d Q k l)
    (hx : complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank j) i x = 0)
    (hy : complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank k) l y = 0) :
    complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank (j + k)) (i + l)
      (originalRelativeInternalProduct K hs d Q j k i l x y) = 0 := by
  have hx' := congrArg (fun z : originalRelativeDegreeTerm K hs d Q j (i - 1) => z.val) hx
  have hy' := congrArg (fun z : originalRelativeDegreeTerm K hs d Q k (l - 1) => z.val) hy
  simp only [originalRelativeDegreeOutgoing_val, Submodule.coe_zero] at hx' hy'
  apply Subtype.ext
  rw [originalRelativeDegreeOutgoing_val, originalRelativeInternalProduct_val, Submodule.coe_zero]
  exact coefficientKoszulProduct_cycle (fun r : Fin d => faceRankParameter K hs (r.val + 1))
    i l x.val y.val hx' hy'

theorem barycentricRelativeInternalProduct_cycle (j k i l : ℕ)
    (x : barycentricRelativeDegreeTerm (P := P) K d Q j i)
    (y : barycentricRelativeDegreeTerm (P := P) K d Q k l)
    (hx : complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q j) i x = 0)
    (hy : complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q k) l y = 0) :
    complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q (j + k)) (i + l)
      (barycentricRelativeInternalProduct K d Q j k i l x y) = 0 := by
  have hx' := congrArg (fun z : barycentricRelativeDegreeTerm (P := P) K d Q j (i - 1) => z.val) hx
  have hy' := congrArg (fun z : barycentricRelativeDegreeTerm (P := P) K d Q k (l - 1) => z.val) hy
  simp only [barycentricRelativeDegreeOutgoing_val, Submodule.coe_zero] at hx' hy'
  apply Subtype.ext
  rw [barycentricRelativeDegreeOutgoing_val, barycentricRelativeInternalProduct_val, Submodule.coe_zero]
  exact coefficientKoszulProduct_cycle
    (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i l x.val y.val hx' hy'

include hQ in
theorem originalRelativeInternalProduct_left_boundary (j k i l : ℕ)
    (a : originalRelativeDegreeTerm K hs d Q j (i + 1))
    (y : LinearMap.ker (complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank k) l)) :
    ∃ z : originalRelativeDegreeTerm K hs d Q (j + k) (i + l + 1),
      complexIncoming (originalRelativeDegreeComplex K hs d Q hrank (j + k)) (i + l) z =
        originalRelativeInternalProduct K hs d Q j k i l
          (complexIncoming (originalRelativeDegreeComplex K hs d Q hrank j) i a) y.val := by
  have hy := congrArg (fun z : originalRelativeDegreeTerm K hs d Q k (l - 1) => z.val) y.property
  simp only [originalRelativeDegreeOutgoing_val, Submodule.coe_zero] at hy
  apply originalRelativeDegreeBoundary_lift K hs d Q hQ hrank (j + k) (i + l)
    (coefficientKoszulLeftPrimitive (K := K) i l a.val y.val.val)
  · exact coefficientKoszulLeftPrimitive_ideal (faceRestrictionIdeal K hs Q)
      i l a.val y.val.val a.property.1 y.val.property.1
  · rw [originalRelativeInternalProduct_val, originalRelativeDegreeIncoming_val]
    exact coefficientKoszulLeftPrimitive_differential
      (fun r : Fin d => faceRankParameter K hs (r.val + 1)) i l a.val y.val.val hy

include hQ in
theorem originalRelativeInternalProduct_right_boundary (j k i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank j) i))
    (b : originalRelativeDegreeTerm K hs d Q k (l + 1)) :
    ∃ z : originalRelativeDegreeTerm K hs d Q (j + k) (i + l + 1),
      complexIncoming (originalRelativeDegreeComplex K hs d Q hrank (j + k)) (i + l) z =
        originalRelativeInternalProduct K hs d Q j k i l x.val
          (complexIncoming (originalRelativeDegreeComplex K hs d Q hrank k) l b) := by
  have hx := congrArg (fun z : originalRelativeDegreeTerm K hs d Q j (i - 1) => z.val) x.property
  simp only [originalRelativeDegreeOutgoing_val, Submodule.coe_zero] at hx
  apply originalRelativeDegreeBoundary_lift K hs d Q hQ hrank (j + k) (i + l)
    (coefficientKoszulRightPrimitive (K := K)
      (fun r : Fin d => faceRankParameter K hs (r.val + 1)) i l x.val.val b.val)
  · exact coefficientKoszulRightPrimitive_ideal
      (fun r : Fin d => faceRankParameter K hs (r.val + 1)) (faceRestrictionIdeal K hs Q)
      i l x.val.val b.val x.val.property.1 b.property.1
  · rw [originalRelativeInternalProduct_val, originalRelativeDegreeIncoming_val]
    exact coefficientKoszulRightPrimitive_differential
      (fun r : Fin d => faceRankParameter K hs (r.val + 1)) i l x.val.val b.val hx

include hs hQ in
theorem barycentricRelativeInternalProduct_left_boundary (j k i l : ℕ)
    (a : barycentricRelativeDegreeTerm (P := P) K d Q j (i + 1))
    (y : LinearMap.ker (complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q k) l)) :
    ∃ z : barycentricRelativeDegreeTerm (P := P) K d Q (j + k) (i + l + 1),
      complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q (j + k)) (i + l) z =
        barycentricRelativeInternalProduct K d Q j k i l
          (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q j) i a) y.val := by
  have hy := congrArg (fun z : barycentricRelativeDegreeTerm (P := P) K d Q k (l - 1) => z.val) y.property
  simp only [barycentricRelativeDegreeOutgoing_val, Submodule.coe_zero] at hy
  apply barycentricRelativeDegreeBoundary_lift K hs d Q hQ (j + k) (i + l)
    (coefficientKoszulLeftPrimitive (K := K) i l a.val y.val.val)
  · exact coefficientKoszulLeftPrimitive_ideal (barycentricRestrictionIdeal (P := P) K Q)
      i l a.val y.val.val a.property.1 y.val.property.1
  · rw [barycentricRelativeInternalProduct_val, barycentricRelativeDegreeIncoming_val]
    exact coefficientKoszulLeftPrimitive_differential
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i l a.val y.val.val hy

include hs hQ in
theorem barycentricRelativeInternalProduct_right_boundary (j k i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q j) i))
    (b : barycentricRelativeDegreeTerm (P := P) K d Q k (l + 1)) :
    ∃ z : barycentricRelativeDegreeTerm (P := P) K d Q (j + k) (i + l + 1),
      complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q (j + k)) (i + l) z =
        barycentricRelativeInternalProduct K d Q j k i l x.val
          (complexIncoming (barycentricRelativeDegreeComplex (P := P) K d Q k) l b) := by
  have hx := congrArg (fun z : barycentricRelativeDegreeTerm (P := P) K d Q j (i - 1) => z.val) x.property
  simp only [barycentricRelativeDegreeOutgoing_val, Submodule.coe_zero] at hx
  apply barycentricRelativeDegreeBoundary_lift K hs d Q hQ (j + k) (i + l)
    (coefficientKoszulRightPrimitive (K := K)
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i l x.val.val b.val)
  · exact coefficientKoszulRightPrimitive_ideal
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1))
      (barycentricRestrictionIdeal (P := P) K Q) i l x.val.val b.val x.val.property.1 b.property.1
  · rw [barycentricRelativeInternalProduct_val, barycentricRelativeDegreeIncoming_val]
    exact coefficientKoszulRightPrimitive_differential
      (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i l x.val.val b.val hx

/-- The original relative strand product with honest cycle and boundary data. -/
def originalRelativeInternalWindowProduct (j k i l : ℕ) :
    FilteredWindowProduct (originalRelativeInternalWindow K hs d Q hQ hrank j i)
      (originalRelativeInternalWindow K hs d Q hQ hrank k l)
      (originalRelativeInternalWindow K hs d Q hQ hrank (j + k) (i + l)) where
  chainProduct := originalRelativeInternalProduct K hs d Q j k i l
  cycles := originalRelativeInternalProduct_cycle K hs d Q hrank j k i l
  left_boundary := originalRelativeInternalProduct_left_boundary K hs d Q hQ hrank j k i l
  right_boundary := originalRelativeInternalProduct_right_boundary K hs d Q hQ hrank j k i l
  filtered := originalRelativeInternalProduct_filtered K hs d Q hrank j k i l

/-- The independent barycentric relative strand product. -/
def barycentricRelativeInternalWindowProduct (j k i l : ℕ) :
    FilteredWindowProduct (barycentricRelativeInternalWindow K hs d Q hQ j i)
      (barycentricRelativeInternalWindow K hs d Q hQ k l)
      (barycentricRelativeInternalWindow K hs d Q hQ (j + k) (i + l)) where
  chainProduct := barycentricRelativeInternalProduct K d Q j k i l
  cycles := barycentricRelativeInternalProduct_cycle K d Q j k i l
  left_boundary := barycentricRelativeInternalProduct_left_boundary K hs d Q hQ j k i l
  right_boundary := barycentricRelativeInternalProduct_right_boundary K hs d Q hQ j k i l
  filtered := barycentricRelativeInternalProduct_filtered K d Q hrank j k i l

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Common.FilteredWindowNaturality -/
section

/-! # Naturality of the products on literal homology quotients

These lemmas descend an actual product identity on cycles through the
surjective cycle-class maps. They apply independently to ordinary homology
and to the homology of associated chain grades.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.FilteredHomology
universe u
variable {K : Type u} [CommRing K]

namespace BilinearHomologyWindow
variable (W : BilinearHomologyWindow K)

theorem classMap_surjective : Function.Surjective W.classMap :=
  (LinearMap.range (boundaryMap W.incoming W.outgoing W.square_zero)).mkQ_surjective

theorem gradedClass_surjective (n : ℕ) : Function.Surjective (W.gradedClass n) :=
  (LinearMap.range (boundaryMap
    (gradeMap W.leftFiltration W.middleFiltration W.incoming W.incoming_preserves n)
    (gradeMap W.middleFiltration W.rightFiltration W.outgoing W.outgoing_preserves n)
    (gradeMap_comp W.leftFiltration W.middleFiltration W.rightFiltration
      W.incoming W.outgoing W.incoming_preserves W.outgoing_preserves W.square_zero n))).mkQ_surjective
end BilinearHomologyWindow

namespace FilteredWindowProduct
variable {A B C A' B' C' : BilinearHomologyWindow K}
variable (P : FilteredWindowProduct A B C) (Q : FilteredWindowProduct A' B' C')

/-- Naturality is proved on the actual cycle product, then on its quotient. -/
theorem homologyProduct_natural
    (a : A.homology →ₗ[K] A'.homology)
    (b : B.homology →ₗ[K] B'.homology)
    (c : C.homology →ₗ[K] C'.homology)
    (ac : A.cycles →ₗ[K] A'.cycles)
    (bc : B.cycles →ₗ[K] B'.cycles)
    (cc : C.cycles →ₗ[K] C'.cycles)
    (ha : ∀ x, a (A.classMap x) = A'.classMap (ac x))
    (hb : ∀ y, b (B.classMap y) = B'.classMap (bc y))
    (hc : ∀ z, c (C.classMap z) = C'.classMap (cc z))
    (hp : ∀ x y, cc (P.cycleProduct x y) = Q.cycleProduct (ac x) (bc y))
    (x : A.homology) (y : B.homology) :
    c (P.homologyProduct x y) = Q.homologyProduct (a x) (b y) := by
  obtain ⟨x, rfl⟩ := A.classMap_surjective x
  obtain ⟨y, rfl⟩ := B.classMap_surjective y
  have h₁ := congrArg c (P.homologyProduct_class x y)
  have h₂ := hc (P.cycleProduct x y)
  have h₃ := congrArg C'.classMap (hp x y)
  have h₄ := (Q.homologyProduct_class (ac x) (bc y)).symm
  have h₅ := congrArg₂ (fun z w => Q.homologyProduct z w) (ha x).symm (hb y).symm
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans h₅)))

/-- The same representative calculation on the actual chain-grade quotient. -/
theorem gradedHomologyProduct_natural (r s : ℕ)
    (a : A.gradedHomology r →ₗ[K] A'.gradedHomology r)
    (b : B.gradedHomology s →ₗ[K] B'.gradedHomology s)
    (c : C.gradedHomology (r + s) →ₗ[K] C'.gradedHomology (r + s))
    (ac : A.gradeCycles r →ₗ[K] A'.gradeCycles r)
    (bc : B.gradeCycles s →ₗ[K] B'.gradeCycles s)
    (cc : C.gradeCycles (r + s) →ₗ[K] C'.gradeCycles (r + s))
    (ha : ∀ x, a (A.gradedClass r x) = A'.gradedClass r (ac x))
    (hb : ∀ y, b (B.gradedClass s y) = B'.gradedClass s (bc y))
    (hc : ∀ z, c (C.gradedClass (r + s) z) = C'.gradedClass (r + s) (cc z))
    (hp : ∀ x y, cc (P.gradedCycleProduct r s x y) =
      Q.gradedCycleProduct r s (ac x) (bc y))
    (x : A.gradedHomology r) (y : B.gradedHomology s) :
    c (P.gradedHomologyProduct r s x y) = Q.gradedHomologyProduct r s (a x) (b y) := by
  obtain ⟨x, rfl⟩ := A.gradedClass_surjective r x
  obtain ⟨y, rfl⟩ := B.gradedClass_surjective s y
  have h₁ := congrArg c (P.gradedHomologyProduct_class r s x y)
  have h₂ := hc (P.gradedCycleProduct r s x y)
  have h₃ := congrArg (C'.gradedClass (r + s)) (hp x y)
  have h₄ := (Q.gradedHomologyProduct_class r s (ac x) (bc y)).symm
  have h₅ := congrArg₂ (fun z w => Q.gradedHomologyProduct r s z w)
    (ha x).symm (hb y).symm
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans h₅)))

end FilteredWindowProduct
end FourPapers.FilteredHomology

end
end

/- BEGIN FourPapers.Universal.RelativeTorMultiplication -/
section

/-! # The nonunital product on ordinary relative Tor

The coefficient ideal is closed under the literal exterior Koszul product.
The resulting product descends by explicit ideal-valued boundary primitives
and is transported through the genuine resolution isomorphism to ordinary
relative Tor. Every internal-degree product below is proved to be the
restriction of that same product, and its filtration is the one already
used in Theorem 1.2.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (Q : Set P)

/-- The actual relative Koszul homology product, with its original coefficient
ideal. The two complex definitions agree literally. -/
def originalRelativeKoszulHomologyProduct (i l : ℕ) :
    complexKernelHomology (originalRelativeKoszulComplex K hs d Q) i →ₗ[K]
      complexKernelHomology (originalRelativeKoszulComplex K hs d Q) l →ₗ[K]
        complexKernelHomology (originalRelativeKoszulComplex K hs d Q) (i + l) :=
  idealCoefficientKoszulHomologyProduct (K := K)
    (fun c : Fin d => faceRankParameter K hs (c.val + 1))
    (faceRestrictionIdeal K hs Q) i l

@[simp] theorem originalRelativeKoszulHomologyProduct_class (i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalRelativeKoszulComplex K hs d Q) i))
    (y : LinearMap.ker (complexOutgoing (originalRelativeKoszulComplex K hs d Q) l)) :
    originalRelativeKoszulHomologyProduct K hs d Q i l
        (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _ (idealCoefficientKoszulCycleProduct (K := K)
        (fun c : Fin d => faceRankParameter K hs (c.val + 1))
        (faceRestrictionIdeal K hs Q) i l x y) := rfl

/-- The standard resolution product on actual derived relative Tor. It need
not have a unit, since its coefficients form the actual relative ideal. -/
def originalRelativeTorProduct (i l : ℕ) :
    originalRelativeParameterTor K hs d Q i →ₗ[K]
      originalRelativeParameterTor K hs d Q l →ₗ[K]
        originalRelativeParameterTor K hs d Q (i + l) :=
  ((originalRelativeKoszulHomologyProduct K hs d Q i l).compl₁₂
    (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.toLinearMap
    (originalRelativeParameterTorKernelIso K hs d Q l).toLinearEquiv.toLinearMap).compr₂
      (originalRelativeParameterTorKernelIso K hs d Q (i + l)).symm.toLinearEquiv.toLinearMap

@[simp] theorem originalRelativeTorProduct_resolution (i l : ℕ)
    (x : originalRelativeParameterTor K hs d Q i)
    (y : originalRelativeParameterTor K hs d Q l) :
    (originalRelativeParameterTorKernelIso K hs d Q (i + l)).hom
        (originalRelativeTorProduct K hs d Q i l x y) =
      originalRelativeKoszulHomologyProduct K hs d Q i l
        ((originalRelativeParameterTorKernelIso K hs d Q i).hom x)
        ((originalRelativeParameterTorKernelIso K hs d Q l).hom y) := by
  exact (originalRelativeParameterTorKernelIso K hs d Q (i + l)).toLinearEquiv.apply_symm_apply _

variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

def originalRelativeInternalHomologyInclusion (j i : ℕ) :
    originalRelativeInternalHomology K hs d Q hrank j i →ₗ[K]
      complexKernelHomology (originalRelativeKoszulComplex K hs d Q) i :=
  complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank Q j) i

/-- The internal product comes from the actual ideal-valued cycle product. -/
def originalRelativeInternalHomologyProduct (j k i l : ℕ) :
    originalRelativeInternalHomology K hs d Q hrank j i →ₗ[K]
      originalRelativeInternalHomology K hs d Q hrank k l →ₗ[K]
        originalRelativeInternalHomology K hs d Q hrank (j + k) (i + l) :=
  (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyProduct

/-- This is an identity of products under the actual homogeneous inclusion.
It does not assert injectivity of relative homology into absolute homology. -/
theorem originalRelativeInternalHomologyProduct_inclusion (j k i l : ℕ)
    (x : originalRelativeInternalHomology K hs d Q hrank j i)
    (y : originalRelativeInternalHomology K hs d Q hrank k l) :
    originalRelativeInternalHomologyInclusion K hs d Q hrank (j + k) (i + l)
        (originalRelativeInternalHomologyProduct K hs d Q hQ hrank j k i l x y) =
      originalRelativeKoszulHomologyProduct K hs d Q i l
        (originalRelativeInternalHomologyInclusion K hs d Q hrank j i x)
        (originalRelativeInternalHomologyInclusion K hs d Q hrank k l y) := by
  obtain ⟨x, rfl⟩ := (originalRelativeInternalWindow K hs d Q hQ hrank j i).classMap_surjective x
  obtain ⟨y, rfl⟩ := (originalRelativeInternalWindow K hs d Q hQ hrank k l).classMap_surjective y
  have hp := (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyProduct_class x y
  have h₁ := congrArg (originalRelativeInternalHomologyInclusion K hs d Q hrank (j + k) (i + l)) hp
  have h₂ := complexKernelHomologyMap_class
    (originalRelativeDegreeInclusion K hs d hrank Q (j + k)) (i + l)
    ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).cycleProduct x y)
  have hx := complexKernelHomologyMap_class
    (originalRelativeDegreeInclusion K hs d hrank Q j) i x
  have hy := complexKernelHomologyMap_class
    (originalRelativeDegreeInclusion K hs d hrank Q k) l y
  have h₃ := congrArg₂ (fun z w => originalRelativeKoszulHomologyProduct K hs d Q i l z w) hx hy
  have h₄ := originalRelativeKoszulHomologyProduct_class K hs d Q i l
    (inducedCycleMap _ _ ((originalRelativeDegreeInclusion K hs d hrank Q j).f i).hom
      ((originalRelativeDegreeInclusion K hs d hrank Q j).f (i - 1)).hom
      (congrArg (fun f => f.hom) ((originalRelativeDegreeInclusion K hs d hrank Q j).comm i (i - 1))).symm x)
    (inducedCycleMap _ _ ((originalRelativeDegreeInclusion K hs d hrank Q k).f l).hom
      ((originalRelativeDegreeInclusion K hs d hrank Q k).f (l - 1)).hom
      (congrArg (fun f => f.hom) ((originalRelativeDegreeInclusion K hs d hrank Q k).comm l (l - 1))).symm y)
  have hcycle :
      inducedCycleMap _ _ ((originalRelativeDegreeInclusion K hs d hrank Q (j + k)).f (i + l)).hom
        ((originalRelativeDegreeInclusion K hs d hrank Q (j + k)).f (i + l - 1)).hom
        (congrArg (fun f => f.hom)
          ((originalRelativeDegreeInclusion K hs d hrank Q (j + k)).comm (i + l) (i + l - 1))).symm
        ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).cycleProduct x y) =
      idealCoefficientKoszulCycleProduct (K := K)
        (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (faceRestrictionIdeal K hs Q) i l
        (inducedCycleMap _ _ ((originalRelativeDegreeInclusion K hs d hrank Q j).f i).hom
          ((originalRelativeDegreeInclusion K hs d hrank Q j).f (i - 1)).hom
          (congrArg (fun f => f.hom) ((originalRelativeDegreeInclusion K hs d hrank Q j).comm i (i - 1))).symm x)
        (inducedCycleMap _ _ ((originalRelativeDegreeInclusion K hs d hrank Q k).f l).hom
          ((originalRelativeDegreeInclusion K hs d hrank Q k).f (l - 1)).hom
          (congrArg (fun f => f.hom) ((originalRelativeDegreeInclusion K hs d hrank Q k).comm l (l - 1))).symm y) := by
    apply Subtype.ext
    apply Subtype.ext
    rfl
  exact (h₁.trans h₂).trans ((congrArg (homologyClass _ _ _) hcycle).trans (h₃.trans h₄).symm)

theorem originalRelativeTorDegreeEquiv_resolution (j i : ℕ)
    (x : originalRelativeInternalHomology K hs d Q hrank j i) :
    (originalRelativeParameterTorKernelIso K hs d Q i).hom
        (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i x).val =
      originalRelativeInternalHomologyInclusion K hs d Q hrank j i x := by
  exact (originalRelativeParameterTorKernelIso K hs d Q i).toLinearEquiv.apply_symm_apply _

def originalRelativeTorInternalProduct (j k i l : ℕ) :
    originalRelativeTorDegreePiece K hs d hrank Q j i →ₗ[K]
      originalRelativeTorDegreePiece K hs d hrank Q k l →ₗ[K]
        originalRelativeTorDegreePiece K hs d hrank Q (j + k) (i + l) :=
  ((originalRelativeInternalHomologyProduct K hs d Q hQ hrank j k i l).compl₁₂
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i).symm.toLinearMap
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ k l).symm.toLinearMap).compr₂
      (originalRelativeTorDegreeEquiv K hs d hrank Q hQ (j + k) (i + l)).toLinearMap

@[simp] theorem originalRelativeTorInternalProduct_equiv (j k i l : ℕ)
    (x : originalRelativeInternalHomology K hs d Q hrank j i)
    (y : originalRelativeInternalHomology K hs d Q hrank k l) :
    originalRelativeTorInternalProduct K hs d Q hQ hrank j k i l
        (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i x)
        (originalRelativeTorDegreeEquiv K hs d hrank Q hQ k l y) =
      originalRelativeTorDegreeEquiv K hs d hrank Q hQ (j + k) (i + l)
        (originalRelativeInternalHomologyProduct K hs d Q hQ hrank j k i l x y) := by
  simp only [originalRelativeTorInternalProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]

theorem originalRelativeTorInternalProduct_val (j k i l : ℕ)
    (x : originalRelativeTorDegreePiece K hs d hrank Q j i)
    (y : originalRelativeTorDegreePiece K hs d hrank Q k l) :
    (originalRelativeTorInternalProduct K hs d Q hQ hrank j k i l x y).val =
      originalRelativeTorProduct K hs d Q i l x.val y.val := by
  obtain ⟨x, rfl⟩ := (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i).surjective x
  obtain ⟨y, rfl⟩ := (originalRelativeTorDegreeEquiv K hs d hrank Q hQ k l).surjective y
  apply (originalRelativeParameterTorKernelIso K hs d Q (i + l)).toLinearEquiv.injective
  have h₁ := congrArg (fun z : originalRelativeTorDegreePiece K hs d hrank Q (j + k) (i + l) =>
    (originalRelativeParameterTorKernelIso K hs d Q (i + l)).hom z.val)
    (originalRelativeTorInternalProduct_equiv K hs d Q hQ hrank j k i l x y)
  have h₂ := originalRelativeTorDegreeEquiv_resolution K hs d Q hQ hrank (j + k) (i + l)
    (originalRelativeInternalHomologyProduct K hs d Q hQ hrank j k i l x y)
  have h₃ := originalRelativeInternalHomologyProduct_inclusion K hs d Q hQ hrank j k i l x y
  have h₄ := congrArg₂ (fun z w => originalRelativeKoszulHomologyProduct K hs d Q i l z w)
    (originalRelativeTorDegreeEquiv_resolution K hs d Q hQ hrank j i x).symm
    (originalRelativeTorDegreeEquiv_resolution K hs d Q hQ hrank k l y).symm
  have h₅ := (originalRelativeTorProduct_resolution K hs d Q i l
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i x).val
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ k l y).val).symm
  exact h₁.trans (h₂.trans (h₃.trans (h₄.trans h₅)))

theorem originalRelativeTorInternalProduct_filtered (j k i l : ℕ) :
    PreservesPair (originalRelativeTorFiltration K hs d hrank Q hQ j i)
      (originalRelativeTorFiltration K hs d hrank Q hQ k l)
      (originalRelativeTorFiltration K hs d hrank Q hQ (j + k) (i + l))
      (originalRelativeTorInternalProduct K hs d Q hQ hrank j k i l) := by
  intro r s x y hx hy
  obtain ⟨x, rfl⟩ := (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i).surjective x
  obtain ⟨y, rfl⟩ := (originalRelativeTorDegreeEquiv K hs d hrank Q hQ k l).surjective y
  rw [originalRelativeTorInternalProduct_equiv]
  apply (equivalenceFiltration_apply K _
    (originalRelativeTorDegreeEquiv K hs d hrank Q hQ (j + k) (i + l)) (r + s + 1) _).mpr
  exact (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyProduct_filtered
    r s x y
    ((equivalenceFiltration_apply K _ (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)
      (r + 1) x).mp hx)
    ((equivalenceFiltration_apply K _ (originalRelativeTorDegreeEquiv K hs d hrank Q hQ k l)
      (s + 1) y).mp hy)

def originalRelativeTorAssociatedProduct (j k i l r s : ℕ) :
    Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) r →ₗ[K]
      Grade (originalRelativeTorFiltration K hs d hrank Q hQ k l) s →ₗ[K]
        Grade (originalRelativeTorFiltration K hs d hrank Q hQ (j + k) (i + l)) (r + s) :=
  gradeBilinearProduct _ _ _ (originalRelativeTorInternalProduct K hs d Q hQ hrank j k i l)
    (originalRelativeTorInternalProduct_filtered K hs d Q hQ hrank j k i l) r s

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeBarycentricWeightProduct -/
section

/-! # Literal multiplication on relative barycentric weight strands

The quadratic rank weight is an exact grading of the barycentric ring.
Consequently the exterior product restricts to the actual relative internal
and weight pieces.  The usual top-weight coordinate equivalence preserves
this literal product.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u

section General
variable {K B : Type u} {C : Type} [CommRing K] [CommRing B] [Algebra K B]
  [Fintype C] [LinearOrder C]

/-- Exact coefficient degrees, unlike filtration bounds, are equalities. -/
theorem coefficientKoszulLevel_piece_eq {I : Type*} (b : Module.Basis I K B)
    (v : I → ℤ) (w : C → ℤ) (i : ℕ) (r : ℤ) :
    coefficientKoszulLevel (FourPapers.BasisGrading.Piece b v) w i r =
      FourPapers.BasisGrading.Piece
        (Finsupp.basis (fun _ : Set.powersetCard C i => b))
        (fun a => v a.2 + exteriorAssignedWeight w a.1.val) r := by
  ext x
  rw [coefficientKoszulLevel_mem, FourPapers.BasisGrading.mem_piece]
  constructor
  · intro hx a ha
    rcases a with ⟨F, a⟩
    have ha' : b.repr (x F) a ≠ 0 := by simpa only [Finsupp.basis_repr] using ha
    have hd := (FourPapers.BasisGrading.mem_piece b v _ (x F)).mp (hx F) a ha'
    dsimp
    omega
  · intro hx F
    rw [FourPapers.BasisGrading.mem_piece]
    intro a ha
    have hd := hx ⟨F, a⟩ (by simpa only [Finsupp.basis_repr] using ha)
    dsimp at hd
    omega
end General

variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (d : ℕ) (Q : Set P)
variable (hs : IsSimplicialPoset P)
variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

/-- Barycentric multiplication adds the exact integer rank weights. -/
theorem barycentricExactWeight_multiplicative (r s : ℤ)
    (x y : BarycentricRing (P := P) K)
    (hx : x ∈ FourPapers.BasisGrading.Piece (barycentricGlobalStandardBasis K)
      (standardRankWeight d) r)
    (hy : y ∈ FourPapers.BasisGrading.Piece (barycentricGlobalStandardBasis K)
      (standardRankWeight d) s) :
    x * y ∈ FourPapers.BasisGrading.Piece (barycentricGlobalStandardBasis K)
      (standardRankWeight d) (r + s) := by
  apply bilinear_mem_of_basis_support K (barycentricGlobalStandardBasis K)
    (barycentricGlobalStandardBasis K) (LinearMap.mul K (BarycentricRing (P := P) K))
  intro a ha b hb
  have hwa := (FourPapers.BasisGrading.mem_piece _ _ r x).mp hx a
    (Finsupp.mem_support_iff.mp ha)
  have hwb := (FourPapers.BasisGrading.mem_piece _ _ s y).mp hy b
    (Finsupp.mem_support_iff.mp hb)
  change barycentricGlobalStandardBasis K a * barycentricGlobalStandardBasis K b ∈ _
  rw [barycentricStandardBasis_product]
  by_cases hab : BarycentricAllowed (a.val + b.val)
  · rw [barycentricGlobalStandardBasis_monomial K ⟨a.val + b.val, hab⟩]
    have hw : standardRankWeight d (⟨a.val + b.val, hab⟩ : StandardFaceIndex P) = r + s := by
      rw [show standardRankWeight d (⟨a.val + b.val, hab⟩ : StandardFaceIndex P) =
        standardRankWeight d a + standardRankWeight d b from originalPolynomialWeight_add d a.val b.val]
      rw [hwa, hwb]
    simpa only [hw] using FourPapers.BasisGrading.basis_mem_piece
      (barycentricGlobalStandardBasis K) (standardRankWeight d)
      (⟨a.val + b.val, hab⟩ : StandardFaceIndex P)
  · rw [barycentricMonomial_forbidden K _ hab]
    exact Submodule.zero_mem _

include hrank in
theorem barycentricKoszulWeightPiece_eq_coefficients (i n : ℕ) :
    FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
        (fun a => (originalKoszulWeight d a).toNat) n =
      coefficientKoszulLevel
        (FourPapers.BasisGrading.Piece (barycentricGlobalStandardBasis K) (standardRankWeight d))
        (fun c : Fin d => rankWeight d (c.val + 1)) i (n : ℤ) := by
  rw [coefficientKoszulLevel_piece_eq]
  change FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
      (fun a => (originalKoszulWeight d a).toNat) n =
    FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
      (originalKoszulWeight d) (n : ℤ)
  ext x
  simp only [FourPapers.BasisGrading.mem_piece]
  constructor
  · intro hx a ha
    have h := hx a ha
    have hn := originalKoszulWeight_nonnegative d hrank a
    omega
  · intro hx a ha
    have h := hx a ha
    omega

include hrank in
theorem barycentricKoszulProduct_exactWeight (i l r s : ℕ)
    (x : Set.powersetCard (Fin d) i →₀ BarycentricRing (P := P) K)
    (y : Set.powersetCard (Fin d) l →₀ BarycentricRing (P := P) K)
    (hx : x ∈ FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d i)
      (fun a => (originalKoszulWeight d a).toNat) r)
    (hy : y ∈ FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d l)
      (fun a => (originalKoszulWeight d a).toNat) s) :
    coefficientKoszulProduct (K := K) i l x y ∈
      FourPapers.BasisGrading.Piece (barycentricKoszulBasis (P := P) K d (i + l))
        (fun a => (originalKoszulWeight d a).toNat) (r + s) := by
  rw [barycentricKoszulWeightPiece_eq_coefficients K d hrank] at hx hy ⊢
  simpa only [Nat.cast_add] using coefficientKoszulProduct_preserves_exact_degree
    (FourPapers.BasisGrading.Piece (barycentricGlobalStandardBasis K) (standardRankWeight d))
    (barycentricExactWeight_multiplicative K d)
    (fun c : Fin d => rankWeight d (c.val + 1)) i l (r : ℤ) (s : ℤ) x y hx hy

/-- Multiplication on the actual ideal-valued, internally homogeneous,
weight-homogeneous barycentric terms. -/
def barycentricRelativeBigradedChainProduct (j k i l r s : ℕ) :
    barycentricRelativeBigradedTerm (P := P) K d Q j r i →ₗ[K]
      barycentricRelativeBigradedTerm (P := P) K d Q k s l →ₗ[K]
        barycentricRelativeBigradedTerm (P := P) K d Q (j + k) (r + s) (i + l) :=
  restrictedBilinearProduct (barycentricRelativeInternalProduct K d Q j k i l)
    (barycentricRelativeBigradedTerm (P := P) K d Q j r i)
    (barycentricRelativeBigradedTerm (P := P) K d Q k s l)
    (barycentricRelativeBigradedTerm (P := P) K d Q (j + k) (r + s) (i + l))
    (fun x hx y hy => barycentricKoszulProduct_exactWeight K d hrank i l r s x.val y.val hx hy)

@[simp] theorem barycentricRelativeBigradedChainProduct_val (j k i l r s : ℕ)
    (x : barycentricRelativeBigradedTerm (P := P) K d Q j r i)
    (y : barycentricRelativeBigradedTerm (P := P) K d Q k s l) :
    (barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s x y).val.val =
      coefficientKoszulProduct (K := K) i l x.val.val y.val.val := rfl

theorem barycentricRelativeBigraded_bounded (j i n : ℕ)
    (x : barycentricRelativeBigradedTerm (P := P) K d Q j n i) :
    x.val ∈ (barycentricRelativeDegreeFiltration (P := P) K d Q j i).level (n + 1) := by
  have h := basisProjection_level (barycentricKoszulBasis (P := P) K d i)
    (fun a => (originalKoszulWeight d a).toNat) n x.val.val
  have hx : FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
      (fun a => (originalKoszulWeight d a).toNat) n x.val.val = x.val.val :=
    FourPapers.BasisGrading.projection_eq_self x.property
  rwa [hx] at h

@[simp] theorem barycentricRelativeGradeWeightEquiv_symm (j i n : ℕ)
    (x : barycentricRelativeBigradedTerm (P := P) K d Q j n i) :
    (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n).symm x =
      Submodule.Quotient.mk
        (⟨x.val, barycentricRelativeBigraded_bounded K d Q j i n x⟩ :
          (barycentricRelativeDegreeFiltration (P := P) K d Q j i).level (n + 1)) := by
  apply (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n).injective
  rw [LinearEquiv.apply_symm_apply]
  apply Subtype.ext
  apply Subtype.ext
  change x.val.val = FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
    (fun a => (originalKoszulWeight d a).toNat) n x.val.val
  exact (FourPapers.BasisGrading.projection_eq_self x.property).symm

theorem barycentricRelativeGradeWeightEquiv_multiplicative (j k i l r s : ℕ)
    (x : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) r)
    (y : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q k l) s) :
    barycentricRelativeGradeWeightEquiv K d Q hs hQ (j + k) (i + l) (r + s)
      (barycentricRelativeInternalGradeProduct K d Q hrank j k i l r s x y) =
    barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s
      (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i r x)
      (barycentricRelativeGradeWeightEquiv K d Q hs hQ k l s y) := by
  obtain ⟨x, rfl⟩ := (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i r).symm.surjective x
  obtain ⟨y, rfl⟩ := (barycentricRelativeGradeWeightEquiv K d Q hs hQ k l s).symm.surjective y
  rw [LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
  rw [barycentricRelativeGradeWeightEquiv_symm K d Q hs hQ j i r x,
    barycentricRelativeGradeWeightEquiv_symm K d Q hs hQ k l s y]
  apply Subtype.ext
  apply Subtype.ext
  change FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i + l))
      (fun a => (originalKoszulWeight d a).toNat) (r + s)
      (coefficientKoszulProduct (K := K) i l x.val.val y.val.val) =
    coefficientKoszulProduct (K := K) i l x.val.val y.val.val
  exact FourPapers.BasisGrading.projection_eq_self
    (barycentricKoszulProduct_exactWeight K d hrank i l r s
      x.val.val y.val.val x.property y.property)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeBarycentricProduct -/
section

/-! # Independent multiplication on relative barycentric bigraded homology

The product uses only the barycentric Koszul DGA and its own homogeneous
weight coordinates.  The cycle-class formula below identifies it with
literal multiplication on the actual relative weight strands.  It is never
defined from the original Tor comparison.
-/
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxRecDepth 4000
set_option maxHeartbeats 700000
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (d : ℕ) (Q : Set P) (hs : IsSimplicialPoset P)
variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

abbrev barycentricRelativeBigradedCycles (j n i : ℕ) :=
  LinearMap.ker (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i)

@[simp] theorem barycentricRelativeBigradedOutgoing_val (j n i : ℕ)
    (x : barycentricRelativeBigradedTerm (P := P) K d Q j n i) :
    (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i x).val.val =
      coefficientExteriorOutgoing (K := K)
        (fun r : Fin d => barycentricRankParameter (P := P) K (r.val + 1)) i x.val.val := rfl

/-- Literal multiplication of cycles in the actual relative weight strands. -/
def barycentricRelativeBigradedCycleProduct (j k i l r s : ℕ) :
    barycentricRelativeBigradedCycles (P := P) K d Q j r i →ₗ[K]
      barycentricRelativeBigradedCycles (P := P) K d Q k s l →ₗ[K]
        barycentricRelativeBigradedCycles (P := P) K d Q (j + k) (r + s) (i + l) where
  toFun x :=
    { toFun := fun y => ⟨barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s
        x.val y.val, by
        have hx := congrArg
          (fun z : barycentricRelativeBigradedTerm (P := P) K d Q j r (i - 1) => z.val.val)
          x.property
        have hy := congrArg
          (fun z : barycentricRelativeBigradedTerm (P := P) K d Q k s (l - 1) => z.val.val)
          y.property
        simp only [barycentricRelativeBigradedOutgoing_val, Submodule.coe_zero] at hx hy
        apply Subtype.ext
        apply Subtype.ext
        exact coefficientKoszulProduct_cycle
          (fun c : Fin d => barycentricRankParameter (P := P) K (c.val + 1)) i l
          x.val.val.val y.val.val.val hx hy⟩
      map_add' y z := Subtype.ext
        (map_add (barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s x.val) y.val z.val)
      map_smul' c y := Subtype.ext
        (map_smul (barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s x.val) c y.val) }
  map_add' x z := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun
      (map_add (barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s) x.val z.val) y.val
  map_smul' c x := by
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    exact LinearMap.congr_fun
      (map_smul (barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s) c x.val) y.val

@[simp] theorem barycentricRelativeBigradedCycleProduct_val (j k i l r s : ℕ)
    (x : barycentricRelativeBigradedCycles (P := P) K d Q j r i)
    (y : barycentricRelativeBigradedCycles (P := P) K d Q k s l) :
    (barycentricRelativeBigradedCycleProduct K d Q hrank j k i l r s x y).val =
      barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s x.val y.val := rfl

theorem barycentricRelativeGradeWeightEquiv_outgoing (j i n : ℕ)
    (x : Grade (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n) :
    barycentricRelativeBigradedOutgoing (P := P) K d Q j n i
        (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n x) =
      barycentricRelativeGradeWeightEquiv K d Q hs hQ j (i - 1) n
        (gradeMap
          (barycentricRelativeInternalWindow K hs d Q hQ j i).middleFiltration
          (barycentricRelativeInternalWindow K hs d Q hQ j i).rightFiltration
          (barycentricRelativeInternalWindow K hs d Q hQ j i).outgoing
          (barycentricRelativeInternalWindow K hs d Q hQ j i).outgoing_preserves n x) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d Q j i) n).mkQ_surjective x
  simp only [barycentricRelativeGradeWeightEquiv, gradeMap_mk, basisRestrictedGradeEquiv_mk]
  apply Subtype.ext
  apply Subtype.ext
  simp only [barycentricRelativeInternalWindow, complexBilinearHomologyWindow,
    barycentricRelativeDegreeComplex, submoduleComplex_outgoing_eq]
  change complexOutgoing (barycentricKoszulComplex (P := P) K d) i
      (FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
        (fun a => (originalKoszulWeight d a).toNat) n x.val.val) =
    FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d (i - 1))
      (fun a => (originalKoszulWeight d a).toNat) n
      (complexOutgoing (barycentricKoszulComplex (P := P) K d) i x.val.val)
  exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
    (barycentricOutgoing_weight K d i) n) x.val.val

/-- The actual weight-coordinate equivalence on cycle submodules. -/
def barycentricRelativeGradeWeightCycles (j i n : ℕ) :
    (barycentricRelativeInternalWindow K hs d Q hQ j i).gradeCycles n ≃ₗ[K]
      barycentricRelativeBigradedCycles (P := P) K d Q j n i :=
  middleCycleEquiv
    (gradeMap (barycentricRelativeInternalWindow K hs d Q hQ j i).middleFiltration
      (barycentricRelativeInternalWindow K hs d Q hQ j i).rightFiltration
      (barycentricRelativeInternalWindow K hs d Q hQ j i).outgoing
      (barycentricRelativeInternalWindow K hs d Q hQ j i).outgoing_preserves n)
    (barycentricRelativeBigradedOutgoing (P := P) K d Q j n i)
    (barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n)
    (fun x => by
      have he := barycentricRelativeGradeWeightEquiv_outgoing K d Q hs hQ j i n x
      constructor
      · intro hx
        exact (barycentricRelativeGradeWeightEquiv K d Q hs hQ j (i - 1) n).map_eq_zero_iff.mp
          (he.symm.trans hx)
      · intro hx
        exact he.trans ((congrArg (barycentricRelativeGradeWeightEquiv K d Q hs hQ j (i - 1) n) hx).trans
          (map_zero _)))

@[simp] theorem barycentricRelativeGradeWeightCycles_val (j i n : ℕ)
    (x : (barycentricRelativeInternalWindow K hs d Q hQ j i).gradeCycles n) :
    (barycentricRelativeGradeWeightCycles K d Q hs hQ j i n x).val =
      barycentricRelativeGradeWeightEquiv K d Q hs hQ j i n x.val := rfl

@[simp] theorem barycentricRelativeGradeWeightHomology_class (j i n : ℕ)
    (x : (barycentricRelativeInternalWindow K hs d Q hQ j i).gradeCycles n) :
    barycentricRelativeGradeWeightHomology K d Q hs hQ j i n
      ((barycentricRelativeInternalWindow K hs d Q hQ j i).gradedClass n x) =
      homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q j n i)
        (barycentricRelativeGradeWeightCycles K d Q hs hQ j i n x) := rfl

@[simp] theorem barycentricRelativeGradeWeightHomology_symm_class (j i n : ℕ)
    (x : barycentricRelativeBigradedCycles (P := P) K d Q j n i) :
    (barycentricRelativeGradeWeightHomology K d Q hs hQ j i n).symm
      (homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q j n i) x) =
      (barycentricRelativeInternalWindow K hs d Q hQ j i).gradedClass n
        ((barycentricRelativeGradeWeightCycles K d Q hs hQ j i n).symm x) := rfl

/-- Product induced by the barycentric DGA, written in its own actual
homogeneous-weight coordinates.  The following class formula identifies it
with multiplication of representatives in the actual relative ideal. -/
def barycentricRelativeBigradedHomologyProduct (j k i l r s : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d Q j r i →ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d Q k s l →ₗ[K]
        barycentricRelativeBigradedHomology (P := P) K d Q (j + k) (r + s) (i + l) :=
  (((barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s).compl₁₂
    (barycentricRelativeGradeWeightHomology K d Q hs hQ j i r).symm.toLinearMap
    (barycentricRelativeGradeWeightHomology K d Q hs hQ k l s).symm.toLinearMap).compr₂
      (barycentricRelativeGradeWeightHomology K d Q hs hQ (j + k) (i + l) (r + s)).toLinearMap

/-- Explicit representative formula: this independently defined target
product is the class of the actual exterior product of relative cycles. -/
theorem barycentricRelativeBigradedHomologyProduct_class (j k i l r s : ℕ)
    (x : barycentricRelativeBigradedCycles (P := P) K d Q j r i)
    (y : barycentricRelativeBigradedCycles (P := P) K d Q k s l) :
    barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l r s
      (homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q j r i) x)
      (homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q k s l) y) =
    homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q (j + k) (r + s) (i + l))
      (barycentricRelativeBigradedCycleProduct K d Q hrank j k i l r s x y) := by
  change barycentricRelativeGradeWeightHomology K d Q hs hQ (j + k) (i + l) (r + s)
    ((barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s
      ((barycentricRelativeGradeWeightHomology K d Q hs hQ j i r).symm
        (homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q j r i) x))
      ((barycentricRelativeGradeWeightHomology K d Q hs hQ k l s).symm
        (homologyClass _ _ (barycentricRelativeBigraded_complex (P := P) K d Q k s l) y))) = _
  let X := (barycentricRelativeGradeWeightCycles K d Q hs hQ j i r).symm x
  let Y := (barycentricRelativeGradeWeightCycles K d Q hs hQ k l s).symm y
  let T := barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l
  have hx := barycentricRelativeGradeWeightHomology_symm_class K d Q hs hQ j i r x
  have hy := barycentricRelativeGradeWeightHomology_symm_class K d Q hs hQ k l s y
  have h₁ := congrArg₂ (fun a b => T.gradedHomologyProduct r s a b) hx hy
  have h₂ := T.gradedHomologyProduct_class r s X Y
  have h₃ := congrArg (barycentricRelativeGradeWeightHomology K d Q hs hQ
    (j + k) (i + l) (r + s)) (h₁.trans h₂)
  have h₄ := barycentricRelativeGradeWeightHomology_class K d Q hs hQ
    (j + k) (i + l) (r + s) (T.gradedCycleProduct r s X Y)
  have hxv := congrArg
    (fun z : barycentricRelativeBigradedCycles (P := P) K d Q j r i => z.val)
    ((barycentricRelativeGradeWeightCycles K d Q hs hQ j i r).apply_symm_apply x)
  have hyv := congrArg
    (fun z : barycentricRelativeBigradedCycles (P := P) K d Q k s l => z.val)
    ((barycentricRelativeGradeWeightCycles K d Q hs hQ k l s).apply_symm_apply y)
  have hchain₀ := barycentricRelativeGradeWeightEquiv_multiplicative K d Q hs hQ hrank
    j k i l r s X.val Y.val
  have hchain₁ := congrArg₂
    (fun a b => barycentricRelativeBigradedChainProduct K d Q hrank j k i l r s a b) hxv hyv
  have hcycle : barycentricRelativeGradeWeightCycles K d Q hs hQ
      (j + k) (i + l) (r + s) (T.gradedCycleProduct r s X Y) =
      barycentricRelativeBigradedCycleProduct K d Q hrank j k i l r s x y := by
    apply Subtype.ext
    exact hchain₀.trans hchain₁
  have h₅ := congrArg
    (homologyClass
      (barycentricRelativeBigradedIncoming (P := P) K d Q (j + k) (r + s) (i + l))
      (barycentricRelativeBigradedOutgoing (P := P) K d Q (j + k) (r + s) (i + l))
      (barycentricRelativeBigraded_complex (P := P) K d Q (j + k) (r + s) (i + l))) hcycle
  exact (h₃.trans h₄).trans h₅

/-- Multiplicativity of the existing barycentric graded-homology/weight
comparison in every relative, internal, homological and weight degree. -/
theorem barycentricRelativeGradeWeightHomology_multiplicative (j k i l r s : ℕ)
    (x : (barycentricRelativeInternalWindow K hs d Q hQ j i).gradedHomology r)
    (y : (barycentricRelativeInternalWindow K hs d Q hQ k l).gradedHomology s) :
    barycentricRelativeGradeWeightHomology K d Q hs hQ (j + k) (i + l) (r + s)
      ((barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s x y) =
    barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l r s
      (barycentricRelativeGradeWeightHomology K d Q hs hQ j i r x)
      (barycentricRelativeGradeWeightHomology K d Q hs hQ k l s y) := by
  change _ = barycentricRelativeGradeWeightHomology K d Q hs hQ (j + k) (i + l) (r + s)
    ((barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s
      ((barycentricRelativeGradeWeightHomology K d Q hs hQ j i r).symm
        (barycentricRelativeGradeWeightHomology K d Q hs hQ j i r x))
      ((barycentricRelativeGradeWeightHomology K d Q hs hQ k l s).symm
        (barycentricRelativeGradeWeightHomology K d Q hs hQ k l s y)))
  rw [LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply]

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.RelativeTorMultiplicativeComparison -/
section

/-! # Multiplicativity of the same relative associated-Tor comparison

The relative coefficient comparison has a strictly lower product defect.
Its induced map on chain grades is therefore multiplicative. The following
proof descends that identity through the actual relative cycle and boundary
quotients, then composes the intrinsic associated-homology and weight-strand
identifications already used in the displayed Tor formula.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (Q : Set P)
variable (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)
variable (hrank : ∀ p : P, faceRank p ≤ d)

def relativeInternalGradedHomologyComparison (j i n : ℕ) :
    (barycentricRelativeInternalWindow K hs d Q hQ j i).gradedHomology n ≃ₗ[K]
      (originalRelativeInternalWindow K hs d Q hQ hrank j i).gradedHomology n :=
  complexGradedHomologyEquiv _ _
    (barycentricRelativeDegreeIncoming_preserves K d Q j)
    (originalRelativeDegreeIncoming_preserves K hs d Q hrank j)
    (relativeInternalKoszulComparison K hs d Q hQ hrank j)
    (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j) i n

/-- The actual chain-grade comparison restricted to cycles. -/
def relativeInternalGradedCycleMap (j i n : ℕ) :
    (barycentricRelativeInternalWindow K hs d Q hQ j i).gradeCycles n →ₗ[K]
      (originalRelativeInternalWindow K hs d Q hQ hrank j i).gradeCycles n :=
  ((relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank j i n).toLinearMap.domRestrict _).codRestrict _ (by
    intro x
    have h := gradeEquiv_commutes
      (barycentricRelativeDegreeFiltration (P := P) K d Q j i)
      (barycentricRelativeDegreeFiltration (P := P) K d Q j (i - 1))
      (originalRelativeDegreeFiltration K hs d Q j i)
      (originalRelativeDegreeFiltration K hs d Q j (i - 1))
      (complexOutgoing (barycentricRelativeDegreeComplex (P := P) K d Q j) i)
      (complexOutgoing (originalRelativeDegreeComplex K hs d Q hrank j) i)
      (complexOutgoing_preserves (barycentricRelativeDegreeComplex (P := P) K d Q j)
        (barycentricRelativeDegreeFiltration (P := P) K d Q j)
        (barycentricRelativeDegreeIncoming_preserves K d Q j) i)
      (complexOutgoing_preserves (originalRelativeDegreeComplex K hs d Q hrank j)
        (originalRelativeDegreeFiltration K hs d Q j)
        (originalRelativeDegreeIncoming_preserves K hs d Q hrank j) i)
      (relativeInternalCoefficientEquiv K hs d Q hQ hrank j i)
      (relativeInternalCoefficientEquiv K hs d Q hQ hrank j (i - 1))
      (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j i)
      (relativeInternalCoefficientEquiv_filtered K hs d Q hQ hrank j (i - 1))
      (complexIso_commutes (relativeInternalKoszulComparison K hs d Q hQ hrank j) i (i - 1)) n x.val
    exact h.trans ((congrArg
      (relativeInternalGradeCoefficientEquiv K hs d Q hQ hrank j (i - 1) n) x.property).trans
        (map_zero _)))

@[simp] theorem relativeInternalGradedHomologyComparison_class (j i n : ℕ)
    (x : (barycentricRelativeInternalWindow K hs d Q hQ j i).gradeCycles n) :
    relativeInternalGradedHomologyComparison K hs d Q hQ hrank j i n
        ((barycentricRelativeInternalWindow K hs d Q hQ j i).gradedClass n x) =
      (originalRelativeInternalWindow K hs d Q hQ hrank j i).gradedClass n
        (relativeInternalGradedCycleMap K hs d Q hQ hrank j i n x) := rfl

theorem relativeInternalGradedHomologyComparison_multiplicative (j k i l r s : ℕ)
    (x : (barycentricRelativeInternalWindow K hs d Q hQ j i).gradedHomology r)
    (y : (barycentricRelativeInternalWindow K hs d Q hQ k l).gradedHomology s) :
    relativeInternalGradedHomologyComparison K hs d Q hQ hrank (j + k) (i + l) (r + s)
      ((barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s x y) =
    (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s
      (relativeInternalGradedHomologyComparison K hs d Q hQ hrank j i r x)
      (relativeInternalGradedHomologyComparison K hs d Q hQ hrank k l s y) := by
  apply FilteredWindowProduct.gradedHomologyProduct_natural
    (barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l)
    (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l) r s
    (relativeInternalGradedHomologyComparison K hs d Q hQ hrank j i r).toLinearMap
    (relativeInternalGradedHomologyComparison K hs d Q hQ hrank k l s).toLinearMap
    (relativeInternalGradedHomologyComparison K hs d Q hQ hrank (j + k) (i + l) (r + s)).toLinearMap
    (relativeInternalGradedCycleMap K hs d Q hQ hrank j i r)
    (relativeInternalGradedCycleMap K hs d Q hQ hrank k l s)
    (relativeInternalGradedCycleMap K hs d Q hQ hrank (j + k) (i + l) (r + s))
    (relativeInternalGradedHomologyComparison_class K hs d Q hQ hrank j i r)
    (relativeInternalGradedHomologyComparison_class K hs d Q hQ hrank k l s)
    (relativeInternalGradedHomologyComparison_class K hs d Q hQ hrank (j + k) (i + l) (r + s))
    _ x y
  intro x y
  apply Subtype.ext
  exact relativeInternalGradeCoefficientEquiv_multiplicative K hs d Q hQ hrank j k i l r s x.val y.val

/-- Multiplicativity of the existing relative gr(H) to barycentric H(gr) map. -/
theorem relativeInternalAssociatedGradedComparison_multiplicative (j k i l r s : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) r)
    (y : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank k l) s) :
    relativeInternalAssociatedGradedComparison K hs d Q hQ hrank (j + k) (i + l) (r + s)
      ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyGradeProduct r s x y) =
    (barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s
      (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank j i r x)
      (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank k l s y) := by
  let E₁ := relativeInternalGradedHomologyComparison K hs d Q hQ hrank j i r
  let E₂ := relativeInternalGradedHomologyComparison K hs d Q hQ hrank k l s
  let E₃ := relativeInternalGradedHomologyComparison K hs d Q hQ hrank (j + k) (i + l) (r + s)
  let ax := (originalRelativeInternalWindow K hs d Q hQ hrank j i).associated r x
  let ay := (originalRelativeInternalWindow K hs d Q hQ hrank k l).associated s y
  apply E₃.injective
  change E₃ (E₃.symm
      ((originalRelativeInternalWindow K hs d Q hQ hrank (j + k) (i + l)).associated (r + s)
        ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyGradeProduct r s x y))) =
    E₃ ((barycentricRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s
      (E₁.symm ax) (E₂.symm ay))
  have h₁ := E₃.apply_symm_apply
    ((originalRelativeInternalWindow K hs d Q hQ hrank (j + k) (i + l)).associated (r + s)
      ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyGradeProduct r s x y))
  have h₂ := (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).associated_multiplicative r s x y
  have h₃ := relativeInternalGradedHomologyComparison_multiplicative K hs d Q hQ hrank
    j k i l r s (E₁.symm ax) (E₂.symm ay)
  have h₄ := congrArg₂
    (fun z w => (originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).gradedHomologyProduct r s z w)
    (E₁.apply_symm_apply ax) (E₂.apply_symm_apply ay)
  exact (h₁.trans h₂).trans (h₃.trans h₄).symm


/-- The comparison with literal barycentric bidegrees is multiplicative for
its independently defined relative coefficient product. -/
theorem originalRelativeAssociatedBigradedHomology_multiplicative (j k i l r s : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) r)
    (y : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank k l) s) :
    originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank (j + k) (i + l) (r + s)
      ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyGradeProduct r s x y) =
    barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l r s
      (originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank j i r x)
      (originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank k l s y) := by
  have h₁ := congrArg (barycentricRelativeGradeWeightHomology K d Q hs hQ (j + k) (i + l) (r + s))
    (relativeInternalAssociatedGradedComparison_multiplicative K hs d Q hQ hrank j k i l r s x y)
  have h₂ := barycentricRelativeGradeWeightHomology_multiplicative K d Q hs hQ hrank j k i l r s
    (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank j i r x)
    (relativeInternalAssociatedGradedComparison K hs d Q hQ hrank k l s y)
  exact h₁.trans h₂

def originalRelativeTorHomologyGradeEquiv (j i n : ℕ) :
    Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) n ≃ₗ[K]
      Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n :=
  gradeEquiv _ _ (originalRelativeTorDegreeEquiv K hs d hrank Q hQ j i)
    (equivalenceFiltration_apply K _ _) n

/-- The same filtration on actual Tor is multiplicative under the actual
homogeneous resolution inclusion. -/
theorem originalRelativeTorHomologyGradeEquiv_product (j k i l r s : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) r)
    (y : Grade (originalRelativeInternalHomologyFiltration K hs d Q hrank k l) s) :
    originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank (j + k) (i + l) (r + s)
      ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyGradeProduct r s x y) =
    originalRelativeTorAssociatedProduct K hs d Q hQ hrank j k i l r s
      (originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank j i r x)
      (originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank k l s y) := by
  obtain ⟨x, rfl⟩ := (lowerInLevel (originalRelativeInternalHomologyFiltration K hs d Q hrank j i) r).mkQ_surjective x
  obtain ⟨y, rfl⟩ := (lowerInLevel (originalRelativeInternalHomologyFiltration K hs d Q hrank k l) s).mkQ_surjective y
  apply congrArg (Submodule.Quotient.mk
    (p := lowerInLevel (originalRelativeTorFiltration K hs d hrank Q hQ (j + k) (i + l)) (r + s)))
  apply Subtype.ext
  exact (originalRelativeTorInternalProduct_equiv K hs d Q hQ hrank j k i l x.val y.val).symm

/-- The existing Tor comparison uses this very homogeneous resolution and
its intrinsic filtration; this is its literal defining factorization. -/
theorem originalRelativeTorAssociatedBigraded_factor (j i n : ℕ)
    (x : Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) n) :
    originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n x =
      originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank j i n
        ((originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank j i n).symm x) := rfl

/-- The exact associated-grade map occurring in Theorem 1.2 preserves the
relative product on ordinary Tor. -/
theorem originalRelativeTorAssociatedBigraded_multiplicative (j k i l r s : ℕ)
    (x : Grade (originalRelativeTorFiltration K hs d hrank Q hQ j i) r)
    (y : Grade (originalRelativeTorFiltration K hs d hrank Q hQ k l) s) :
    originalRelativeTorAssociatedBigraded K hs d hrank Q hQ (j + k) (i + l) (r + s)
      (originalRelativeTorAssociatedProduct K hs d Q hQ hrank j k i l r s x y) =
    barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l r s
      (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i r x)
      (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ k l s y) := by
  let E₁ := originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank j i r
  let E₂ := originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank k l s
  let E₃ := originalRelativeTorHomologyGradeEquiv K hs d Q hQ hrank (j + k) (i + l) (r + s)
  let x' := E₁.symm x
  let y' := E₂.symm y
  have hprod₀ := originalRelativeTorHomologyGradeEquiv_product K hs d Q hQ hrank j k i l r s x' y'
  have hprod₁ := congrArg₂
    (fun z w => originalRelativeTorAssociatedProduct K hs d Q hQ hrank j k i l r s z w)
    (E₁.apply_symm_apply x) (E₂.apply_symm_apply y)
  have hprod := hprod₀.trans hprod₁
  have h₀ := (congrArg E₃.symm hprod).symm
  have hinv := h₀.trans (E₃.symm_apply_apply
    ((originalRelativeInternalWindowProduct K hs d Q hQ hrank j k i l).homologyGradeProduct r s x' y'))
  have h₁ := originalRelativeTorAssociatedBigraded_factor K hs d Q hQ hrank (j + k) (i + l) (r + s)
    (originalRelativeTorAssociatedProduct K hs d Q hQ hrank j k i l r s x y)
  have h₂ := congrArg (originalRelativeAssociatedBigradedHomology K d Q hs hQ hrank
    (j + k) (i + l) (r + s)) hinv
  have h₃ := originalRelativeAssociatedBigradedHomology_multiplicative K hs d Q hQ hrank j k i l r s x' y'
  have h₄ := congrArg₂
    (fun z w => barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l r s z w)
    (originalRelativeTorAssociatedBigraded_factor K hs d Q hQ hrank j i r x).symm
    (originalRelativeTorAssociatedBigraded_factor K hs d Q hQ hrank k l s y).symm
  exact h₁.trans (h₂.trans (h₃.trans h₄))

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.PaperTorRelativeMultiplication -/
section

open scoped DirectSum
/-! # The relative multiplicative clause of Theorem 1.2

For every downward closed subposet, the actual restriction ideal has a
nonunital Koszul product. Its ordinary Tor product preserves the internal
filtration. The same relative isomorphism displayed in the Tor theorem
preserves the products on the complete associated graded, including every
weight, homological degree, and internal degree.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (Q : Set P) (hQ : ∀ ⦃p q : P⦄, p ≤ q → q ∈ Q → p ∈ Q)

def originalRelativeTorAssociatedGradedProduct (j k i l : ℕ) :
    originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i →ₗ[K]
      originalRelativeTorAssociatedGraded K hs d hrank Q hQ k l →ₗ[K]
        originalRelativeTorAssociatedGraded K hs d hrank Q hQ (j + k) (i + l) :=
  gradedDirectSumProduct (originalRelativeTorAssociatedProduct K hs d Q hQ hrank j k i l)

def barycentricRelativeBigradedSumProduct (j k i l : ℕ) :
    (⨁ n, barycentricRelativeBigradedHomology (P := P) K d Q j n i) →ₗ[K]
      (⨁ n, barycentricRelativeBigradedHomology (P := P) K d Q k n l) →ₗ[K]
        (⨁ n, barycentricRelativeBigradedHomology (P := P) K d Q (j + k) n (i + l)) :=
  gradedDirectSumProduct (barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l)

theorem originalRelativeTorAssociatedBigradedSum_multiplicative (j k i l : ℕ)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i)
    (y : originalRelativeTorAssociatedGraded K hs d hrank Q hQ k l) :
    originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ (j + k) (i + l)
      (originalRelativeTorAssociatedGradedProduct K hs d hrank Q hQ j k i l x y) =
    barycentricRelativeBigradedSumProduct K hs d hrank Q hQ j k i l
      (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ j i x)
      (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ k l y) := by
  simpa only [originalRelativeTorAssociatedBigradedSum, DirectSum.coe_congrLinearEquiv,
    originalRelativeTorAssociatedGradedProduct, barycentricRelativeBigradedSumProduct] using
    gradedDirectSumProduct_natural
      (originalRelativeTorAssociatedProduct K hs d Q hQ hrank j k i l)
      (barycentricRelativeBigradedHomologyProduct K d Q hs hQ hrank j k i l)
      (fun n => (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ j i n).toLinearMap)
      (fun n => (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ k l n).toLinearMap)
      (fun n => (originalRelativeTorAssociatedBigraded K hs d hrank Q hQ (j + k) (i + l) n).toLinearMap)
      (originalRelativeTorAssociatedBigraded_multiplicative K hs d Q hQ hrank j k i l) x y

/-- The signed colorful cochain comparison and the finite rank-subset
reindexing, constructed solely from barycentric relative Koszul homology. -/
def barycentricRelativeBigradedCohomologySumEquiv (j i : ℕ) :
    (⨁ n, barycentricRelativeBigradedHomology (P := P) K d Q j n i) ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedRelativeCohomology K hs d hrank Q S.val i) :=
  (gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank Q S i)
    (fun n => barycentricRelativeBigradedHomology (P := P) K d Q j n i)
    (fun n => barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i)).trans
      (DirectSum.linearEquivFunOnFintype K _ _).symm

theorem theorem_1_2_relative_factor (j i : ℕ)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i) :
    theorem_1_2_relative K hs d hrank Q hQ j i x =
      barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ j i
        (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ j i x) := by
  apply DFinsupp.ext
  intro S
  change relativeTorRankSelectedEquiv K hs d hrank Q hQ j i x S =
    gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
      (fun S => rankSelectedRelativeCohomology K hs d hrank Q S i)
      (fun n => barycentricRelativeBigradedHomology (P := P) K d Q j n i)
      (fun n => barycentricRelativeBigradedCohomologyEquiv K hs d hrank Q hQ j n i)
      (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ j i x) S
  simp only [relativeTorRankSelectedEquiv, gradedSumConditionEquiv_apply,
    relativeTorRankSelectedGradeEquiv, LinearEquiv.trans_apply]
  rfl

/-- The actual relative cohomology product induced by the barycentric ideal
Koszul DGA. The original face ring and its Tor comparison do not enter its
definition. -/
def rankSelectedRelativeCohomologyProduct (j k i l : ℕ) :
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
      rankSelectedRelativeCohomology K hs d hrank Q S.val i) →ₗ[K]
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = k},
      rankSelectedRelativeCohomology K hs d hrank Q S.val l) →ₗ[K]
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j + k},
      rankSelectedRelativeCohomology K hs d hrank Q S.val (i + l)) :=
  ((barycentricRelativeBigradedSumProduct K hs d hrank Q hQ j k i l).compl₁₂
    (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ j i).symm.toLinearMap
    (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ k l).symm.toLinearMap).compr₂
      (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ (j + k) (i + l)).toLinearMap

/-- **Theorem 1.2, relative multiplicativity.** For every downward closed
relative subposet, the same full associated-Tor isomorphism preserves the
nonunital products induced by the actual coefficient ideals. -/
theorem theorem_1_2_relative_multiplicative (j k i l : ℕ)
    (x : originalRelativeTorAssociatedGraded K hs d hrank Q hQ j i)
    (y : originalRelativeTorAssociatedGraded K hs d hrank Q hQ k l) :
    theorem_1_2_relative K hs d hrank Q hQ (j + k) (i + l)
      (originalRelativeTorAssociatedGradedProduct K hs d hrank Q hQ j k i l x y) =
    rankSelectedRelativeCohomologyProduct K hs d hrank Q hQ j k i l
      (theorem_1_2_relative K hs d hrank Q hQ j i x)
      (theorem_1_2_relative K hs d hrank Q hQ k l y) := by
  have h₁ := theorem_1_2_relative_factor K hs d hrank Q hQ (j + k) (i + l)
    (originalRelativeTorAssociatedGradedProduct K hs d hrank Q hQ j k i l x y)
  have h₂ := congrArg (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ (j + k) (i + l))
    (originalRelativeTorAssociatedBigradedSum_multiplicative K hs d hrank Q hQ j k i l x y)
  have hx₀ := congrArg (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ j i).symm
    (theorem_1_2_relative_factor K hs d hrank Q hQ j i x)
  have hx := hx₀.trans ((barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ j i).symm_apply_apply
    (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ j i x))
  have hy₀ := congrArg (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ k l).symm
    (theorem_1_2_relative_factor K hs d hrank Q hQ k l y)
  have hy := hy₀.trans ((barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ k l).symm_apply_apply
    (originalRelativeTorAssociatedBigradedSum K hs d hrank Q hQ k l y))
  have hp := congrArg₂ (fun z w => barycentricRelativeBigradedSumProduct K hs d hrank Q hQ j k i l z w) hx hy
  have h₃ := congrArg (barycentricRelativeBigradedCohomologySumEquiv K hs d hrank Q hQ (j + k) (i + l)) hp
  exact (h₁.trans h₂).trans h₃.symm

end FourPapers.Universal

end
end

end

end
