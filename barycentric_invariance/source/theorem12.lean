/- BEGIN FourPapers.Universal.TorMultiplicativeComparison -/
section

/-! # Multiplicativity of the actual internal Tor comparison

The barycentric product is obtained from its own coefficient exterior DGA.
The homogeneous inclusion has an actual coefficient projection as a
retraction.  The canonical comparison commutes with these inclusions; this
proves compatibility with multiplication in every internal and weight
degree, for the very filtration used in Theorem 1.2.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def originalEmptyDegreeInclusion (j : ℕ) :
    originalRelativeDegreeComplex K hs d (∅ : Set P) hrank j ⟶ originalKoszulComplex K hs d :=
  submoduleComplexInclusion _ _ (originalRelativeDegreeTerm_preserved K hs d (∅ : Set P) hrank j)

def barycentricEmptyDegreeInclusion (j : ℕ) :
    barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j ⟶ barycentricKoszulComplex (P := P) K d :=
  submoduleComplexInclusion _ _ (barycentricRelativeDegreeTerm_preserved K d (∅ : Set P) j)

def barycentricEmptyDegreeRetraction (j : ℕ) :
    barycentricKoszulComplex (P := P) K d ⟶ barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j where
  f i := ModuleCat.ofHom
    ((FourPapers.BasisGrading.projection (barycentricKoszulBasis (P := P) K d i)
      originalKoszulDegree j).codRestrict _ (by
        intro x
        rw [barycentricRelativeDegreeTerm_empty]
        exact FourPapers.BasisGrading.projection_mem _ _ _ x))
  comm' i l hil := by
    obtain rfl : i = l + 1 := hil.symm
    simp only [barycentricRelativeDegreeComplex, submoduleComplex_d]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact LinearMap.congr_fun (basisProjection_commutes _ _ _ _ _
      (barycentricIncoming_degree K d l) j) x

theorem barycentricEmptyDegreeInclusion_retraction (j : ℕ) :
    barycentricEmptyDegreeInclusion (P := P) K d j ≫ barycentricEmptyDegreeRetraction (P := P) K d j = 𝟙 _ := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self x.property.2

def originalEmptyGradedHomologyInclusion (j i n : ℕ) :
    complexGradedHomology (originalRelativeDegreeComplex K hs d (∅ : Set P) hrank j)
      (originalRelativeDegreeFiltration K hs d (∅ : Set P) j)
      (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j) i n →ₗ[K]
        originalGradedKoszulHomology K hs d hrank i n :=
  complexGradedHomologyMap (originalEmptyDegreeInclusion K hs d hrank j)
    (originalRelativeDegreeFiltration K hs d (∅ : Set P) j) (originalKoszulFiltration K hs d)
    (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j)
    (originalIncoming_preserves K hs d hrank) (fun _ _ _ hx => hx) i n

def barycentricEmptyGradedHomologyInclusion (j i n : ℕ) :
    complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n →ₗ[K]
        barycentricGradedKoszulHomology (P := P) K d i n :=
  complexGradedHomologyMap (barycentricEmptyDegreeInclusion (P := P) K d j)
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
    (barycentricKoszulFiltration (P := P) K d)
    (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j)
    (barycentricIncoming_preserves K d) (fun _ _ _ hx => hx) i n

def barycentricEmptyGradedHomologyRetraction (j i n : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i n →ₗ[K]
      complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
        (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
        (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n :=
  complexGradedHomologyMap (barycentricEmptyDegreeRetraction (P := P) K d j)
    (barycentricKoszulFiltration (P := P) K d)
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
    (barycentricIncoming_preserves K d)
    (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j)
    (fun i => basisProjection_preserves_other (barycentricKoszulBasis (P := P) K d i)
      originalKoszulDegree j (fun a => (originalKoszulWeight d a).toNat)) i n

theorem barycentricEmptyGradedHomology_retract_include (j i n : ℕ)
    (x : complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n) :
    barycentricEmptyGradedHomologyRetraction (P := P) K d j i n
      (barycentricEmptyGradedHomologyInclusion (P := P) K d j i n x) = x := by
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  apply congrArg (homologyClass _ _ _)
  apply Subtype.ext
  obtain ⟨w, hw⟩ := (lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j i) n).mkQ_surjective z.val
  change gradeMap _ _ _ _ n (gradeMap _ _ _ _ n z.val) = z.val
  rw [← hw]
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j i) n))
  apply Subtype.ext
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self w.val.property.2

def originalEmptyAssociatedHomologyInclusion (j i n : ℕ) :
    Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n →ₗ[K]
      Grade (originalKoszulHomologyFiltration K hs d i) n :=
  gradeMap _ _ (complexKernelHomologyMap (originalEmptyDegreeInclusion K hs d hrank j) i)
    (complexKernelHomologyMap_preserves (originalEmptyDegreeInclusion K hs d hrank j)
      (originalRelativeDegreeFiltration K hs d (∅ : Set P) j)
      (originalKoszulFiltration K hs d) (fun _ _ _ hx => hx) i) n

theorem relativeKoszulGradedComparison_inclusion (j i n : ℕ)
    (x : complexGradedHomology (barycentricRelativeDegreeComplex (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j)
      (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j) i n) :
    koszulGradedHomologyComparison K hs d hrank i n
      (barycentricEmptyGradedHomologyInclusion (P := P) K d j i n x) =
    originalEmptyGradedHomologyInclusion K hs d hrank j i n
      (complexGradedHomologyEquiv _ _
        (barycentricRelativeDegreeIncoming_preserves K d (∅ : Set P) j)
        (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j)
        (relativeInternalKoszulComparison K hs d (∅ : Set P) (by simp) hrank j)
        (relativeInternalCoefficientEquiv_filtered K hs d (∅ : Set P) (by simp) hrank j) i n x) := by
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  apply congrArg (homologyClass _ _ _)
  apply Subtype.ext
  obtain ⟨w, hw⟩ := (lowerInLevel
    (barycentricRelativeDegreeFiltration (P := P) K d (∅ : Set P) j i) n).mkQ_surjective z.val
  change koszulGradeComparison K hs d hrank i n (gradeMap _ _ _ _ n z.val) =
    gradeMap _ _ _ _ n
      (gradeEquiv _ _ (complexIsoLinearEquiv
        (relativeInternalKoszulComparison K hs d (∅ : Set P) (by simp) hrank j) i) _ n z.val)
  rw [← hw]
  rfl

theorem relativeAssociatedComparison_inclusion (j i n : ℕ)
    (x : Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n) :
    barycentricEmptyGradedHomologyInclusion (P := P) K d j i n
      (relativeInternalAssociatedGradedComparison K hs d (∅ : Set P) (by simp) hrank j i n x) =
      originalAssociatedBarycentricHomology K hs d hrank i n
        (originalEmptyAssociatedHomologyInclusion K hs d hrank j i n x) := by
  apply (koszulGradedHomologyComparison K hs d hrank i n).injective
  rw [relativeKoszulGradedComparison_inclusion]
  simp only [relativeInternalAssociatedGradedComparison, originalAssociatedBarycentricHomology,
    LinearEquiv.trans_apply, LinearEquiv.apply_symm_apply]
  exact (complexAssociatedHomologyEquiv_natural
    (originalEmptyDegreeInclusion K hs d hrank j)
    (originalRelativeDegreeFiltration K hs d (∅ : Set P) j) (originalKoszulFiltration K hs d)
    (originalRelativeDegreeIncoming_preserves K hs d (∅ : Set P) hrank j)
    (originalIncoming_preserves K hs d hrank) (fun _ _ _ hx => hx)
    (originalRelativeDegreeIncoming_liftsCycles K hs d (∅ : Set P) (by simp) hrank j)
    (originalIncoming_liftsCycles K hs d hrank) i n x).symm

def originalTorHomologyInclusion (j i : ℕ) :
    originalTorDegreePiece K hs d hrank j i →ₗ[K] originalKoszulHomology K hs d i :=
  (originalTorProductResolutionIso K hs d i).toLinearEquiv.toLinearMap.comp
    (originalTorDegreePiece K hs d hrank j i).subtype

theorem originalTorHomologyInclusion_filtered (j i : ℕ) :
    Preserves (originalTorFiltration K hs d hrank j i)
      (originalKoszulHomologyFiltration K hs d i)
      (originalTorHomologyInclusion K hs d hrank j i) := by
  intro n x hx
  obtain ⟨x, rfl⟩ := (originalInternalTorEquiv K hs d hrank j i).surjective x
  change (originalTorProductResolutionIso K hs d i).hom
    (originalInternalTorEquiv K hs d hrank j i x).val ∈ _
  rw [originalInternalTorEquiv_resolution]
  exact originalInternalHomologyInclusion_filtered K hs d hrank j i n x
    ((originalInternalTorEquiv_filtered K hs d hrank j i n x).mp hx)

def originalTorGradeInclusion (j i n : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) n →ₗ[K]
      Grade (originalKoszulHomologyFiltration K hs d i) n :=
  gradeMap _ _ (originalTorHomologyInclusion K hs d hrank j i)
    (originalTorHomologyInclusion_filtered K hs d hrank j i) n

theorem originalTorHomologyInclusion_product (j k i l : ℕ)
    (x : originalTorDegreePiece K hs d hrank j i)
    (y : originalTorDegreePiece K hs d hrank k l) :
    originalTorHomologyInclusion K hs d hrank (j + k) (i + l)
        (originalTorInternalProduct K hs d hrank j k i l x y) =
      originalKoszulHomologyProduct K hs d i l
        (originalTorHomologyInclusion K hs d hrank j i x)
        (originalTorHomologyInclusion K hs d hrank k l y) := by
  change (originalTorProductResolutionIso K hs d (i + l)).hom
      (originalTorInternalProduct K hs d hrank j k i l x y).val = _
  rw [originalTorInternalProduct_val, originalTorProduct_resolution]
  rfl

theorem originalTorGradeInclusion_product (j k i l r s : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) r)
    (y : Grade (originalTorFiltration K hs d hrank k l) s) :
    originalTorGradeInclusion K hs d hrank (j + k) (i + l) (r + s)
        (originalTorAssociatedProduct K hs d hrank j k i l r s x y) =
      originalAssociatedHomologyProduct K hs d hrank i l r s
        (originalTorGradeInclusion K hs d hrank j i r x)
        (originalTorGradeInclusion K hs d hrank k l s y) := by
  have h := gradeBilinearProduct_natural_of_lower_defect
    (originalTorFiltration K hs d hrank j i)
    (originalTorFiltration K hs d hrank k l)
    (originalTorFiltration K hs d hrank (j + k) (i + l))
    (originalTorInternalProduct K hs d hrank j k i l)
    (originalTorInternalProduct_filtered K hs d hrank j k i l)
    (originalKoszulHomologyFiltration K hs d i)
    (originalKoszulHomologyFiltration K hs d l)
    (originalKoszulHomologyFiltration K hs d (i + l))
    (originalKoszulHomologyProduct K hs d i l)
    (originalKoszulHomologyProduct_filtered K hs d hrank i l)
    (originalTorHomologyInclusion K hs d hrank j i)
    (originalTorHomologyInclusion K hs d hrank k l)
    (originalTorHomologyInclusion K hs d hrank (j + k) (i + l))
    (originalTorHomologyInclusion_filtered K hs d hrank j i)
    (originalTorHomologyInclusion_filtered K hs d hrank k l)
    (originalTorHomologyInclusion_filtered K hs d hrank (j + k) (i + l))
    (by
      intro r s x y hx hy
      rw [originalTorHomologyInclusion_product, sub_self]
      exact Submodule.zero_mem _) r s x y
  rw [originalAssociatedHomologyProduct_eq_gradeProduct]
  exact h

def originalTorRelativeHomologyGradeEquiv (j i n : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) n ≃ₗ[K]
      Grade (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n :=
  (gradeEquiv _ _ (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i) n).symm.trans
      (gradeEquiv _ _ (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i)
        (equivalenceFiltration_apply K _ _) n).symm

theorem originalTorHomologyInclusion_relative (j i : ℕ)
    (x : originalRelativeInternalHomology K hs d (∅ : Set P) hrank j i) :
    originalTorHomologyInclusion K hs d hrank j i
      (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i
        (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i x)) =
      complexKernelHomologyMap (originalEmptyDegreeInclusion K hs d hrank j) i x := by
  have hc : originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j ≫
      (originalEmptyRelativeTotalComplexIso K hs d).hom =
      originalEmptyDegreeInclusion K hs d hrank j := by
    apply HomologicalComplex.Hom.ext
    funext k
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    change (show Set.powersetCard (Fin d) k →₀ FaceRing K hs from z.val) = z.val
    rfl
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
    ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).hom
      ((originalEmptyRelativeTorIso K hs d i).inv
        ((originalEmptyRelativeTorIso K hs d i).hom
          ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).inv
            (complexKernelHomologyMap
              (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i x))))) = _
  simp only [← ModuleCat.comp_apply, Iso.hom_inv_id, Iso.inv_hom_id, ModuleCat.id_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
      ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv.symm
          (complexKernelHomologyMap
            (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i x))) = _
  rw [LinearEquiv.apply_symm_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i).toLinearMap
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i x) = _
  rw [complexKernelHomologyEquiv_toLinearMap, ← LinearMap.comp_apply,
    ← complexKernelHomologyMap_comp, hc]

theorem originalTorGradeInclusion_relative (j i n : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) n) :
    originalTorGradeInclusion K hs d hrank j i n x =
      originalEmptyAssociatedHomologyInclusion K hs d hrank j i n
        (originalTorRelativeHomologyGradeEquiv K hs d hrank j i n x) := by
  let E := gradeEquiv
    (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
    (originalTorFiltration K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
    (originalEmptyRelativeTorDegreeEquiv_filtered K hs d hrank j i) n
  let D := gradeEquiv
    (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i)
    (originalRelativeTorFiltration K hs d hrank (∅ : Set P) (by simp) j i)
    (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i)
    (equivalenceFiltration_apply K
      (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i)
      (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i)) n
  obtain ⟨x, rfl⟩ := E.surjective x
  obtain ⟨x, rfl⟩ := D.surjective x
  change originalTorGradeInclusion K hs d hrank j i n (E (D x)) =
    originalEmptyAssociatedHomologyInclusion K hs d hrank j i n (D.symm (E.symm (E (D x))))
  rw [LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply]
  obtain ⟨z, rfl⟩ := (lowerInLevel
    (originalRelativeInternalHomologyFiltration K hs d (∅ : Set P) hrank j i) n).mkQ_surjective x
  change Submodule.Quotient.mk
      (p := lowerInLevel (originalKoszulHomologyFiltration K hs d i) n)
      ⟨originalTorHomologyInclusion K hs d hrank j i
        (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i
          (originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i z.val)), _⟩ =
    Submodule.Quotient.mk
      (p := lowerInLevel (originalKoszulHomologyFiltration K hs d i) n)
      ⟨complexKernelHomologyMap (originalEmptyDegreeInclusion K hs d hrank j) i z.val, _⟩
  apply congrArg (Submodule.Quotient.mk (p := lowerInLevel (originalKoszulHomologyFiltration K hs d i) n))
  exact Subtype.ext (originalTorHomologyInclusion_relative K hs d hrank j i z.val)

/-- This map is the literal homogeneous inclusion on the barycentric side,
after undoing its top-weight coordinate isomorphism. -/
def barycentricBigradedHomologyInclusion (j n i : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i →ₗ[K]
      barycentricGradedKoszulHomology (P := P) K d i n :=
  (barycentricEmptyGradedHomologyInclusion (P := P) K d j i n).comp
    (barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n).symm.toLinearMap

def barycentricBigradedHomologyRetraction (j n i : ℕ) :
    barycentricGradedKoszulHomology (P := P) K d i n →ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i :=
  (barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n).toLinearMap.comp
    (barycentricEmptyGradedHomologyRetraction (P := P) K d j i n)

theorem barycentricBigradedHomology_retract_include (j n i : ℕ)
    (x : barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) :
    barycentricBigradedHomologyRetraction K hs d j n i
      (barycentricBigradedHomologyInclusion K hs d j n i x) = x := by
  simp only [barycentricBigradedHomologyRetraction, barycentricBigradedHomologyInclusion,
    LinearMap.comp_apply, LinearEquiv.coe_coe, barycentricEmptyGradedHomology_retract_include,
    LinearEquiv.apply_symm_apply]

theorem barycentricBigradedHomologyInclusion_injective (j n i : ℕ) :
    Function.Injective (barycentricBigradedHomologyInclusion K hs d j n i) := by
  intro x y h
  have h' := congrArg (barycentricBigradedHomologyRetraction K hs d j n i) h
  simpa only [barycentricBigradedHomology_retract_include] using h'

theorem originalTorAssociatedBigraded_inclusion (j i n : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) n) :
    barycentricBigradedHomologyInclusion K hs d j n i
      (originalTorAssociatedBigraded K hs d hrank j i n x) =
      originalAssociatedBarycentricHomology K hs d hrank i n
        (originalTorGradeInclusion K hs d hrank j i n x) := by
  rw [originalTorGradeInclusion_relative]
  change barycentricEmptyGradedHomologyInclusion (P := P) K d j i n
    ((barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n).symm
      ((barycentricRelativeGradeWeightHomology K d (∅ : Set P) hs (by simp) j i n)
        (relativeInternalAssociatedGradedComparison K hs d (∅ : Set P) (by simp) hrank j i n
          (originalTorRelativeHomologyGradeEquiv K hs d hrank j i n x)))) = _
  rw [LinearEquiv.symm_apply_apply]
  exact relativeAssociatedComparison_inclusion K hs d hrank j i n _

/-- The independent barycentric DGA product, restricted by its actual
internal-degree projection.  The inclusion theorem below verifies that
this projection removes no product term. -/
def barycentricBigradedHomologyProduct (j k i l r s : ℕ) :
    barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j r i →ₗ[K]
      barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) k s l →ₗ[K]
        barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) (j + k) (r + s) (i + l) :=
  ((barycentricGradedKoszulHomologyProduct K d hrank i l r s).compl₁₂
    (barycentricBigradedHomologyInclusion K hs d j r i)
    (barycentricBigradedHomologyInclusion K hs d k s l)).compr₂
      (barycentricBigradedHomologyRetraction K hs d (j + k) (r + s) (i + l))

/-- Multiplicativity for the exact filtration and comparison appearing in
the absolute Theorem 1.2, in every internal, homological, and weight degree. -/
theorem originalTorAssociatedBigraded_multiplicative (j k i l r s : ℕ)
    (x : Grade (originalTorFiltration K hs d hrank j i) r)
    (y : Grade (originalTorFiltration K hs d hrank k l) s) :
    originalTorAssociatedBigraded K hs d hrank (j + k) (i + l) (r + s)
        (originalTorAssociatedProduct K hs d hrank j k i l r s x y) =
      barycentricBigradedHomologyProduct K hs d hrank j k i l r s
        (originalTorAssociatedBigraded K hs d hrank j i r x)
        (originalTorAssociatedBigraded K hs d hrank k l s y) := by
  have h₁ := originalTorAssociatedBigraded_inclusion K hs d hrank (j + k) (i + l) (r + s)
    (originalTorAssociatedProduct K hs d hrank j k i l r s x y)
  have h₂ := congrArg (fun z => originalAssociatedBarycentricHomology K hs d hrank
      (i + l) (r + s) z)
    (originalTorGradeInclusion_product K hs d hrank j k i l r s x y)
  have h₃ := originalAssociatedBarycentricHomology_multiplicative K hs d hrank i l r s
    (originalTorGradeInclusion K hs d hrank j i r x)
    (originalTorGradeInclusion K hs d hrank k l s y)
  have hxy := h₁.trans (h₂.trans h₃)
  have hx := originalTorAssociatedBigraded_inclusion K hs d hrank j i r x
  have hy := originalTorAssociatedBigraded_inclusion K hs d hrank k l s y
  rw [← hx, ← hy] at hxy
  have h := congrArg (barycentricBigradedHomologyRetraction K hs d
    (j + k) (r + s) (i + l)) hxy
  rw [barycentricBigradedHomology_retract_include] at h
  exact h

/-- Faithfulness of the homogeneous barycentric product: its image is the
actual product on the exterior Koszul associated homology. -/
theorem barycentricBigradedHomologyProduct_inclusion (j k i l r s : ℕ)
    (x : barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j r i)
    (y : barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) k s l) :
    barycentricBigradedHomologyInclusion K hs d (j + k) (r + s) (i + l)
        (barycentricBigradedHomologyProduct K hs d hrank j k i l r s x y) =
      barycentricGradedKoszulHomologyProduct K d hrank i l r s
        (barycentricBigradedHomologyInclusion K hs d j r i x)
        (barycentricBigradedHomologyInclusion K hs d k s l y) := by
  let x' := (originalTorAssociatedBigraded K hs d hrank j i r).symm x
  let y' := (originalTorAssociatedBigraded K hs d hrank k l s).symm y
  have hm := originalTorAssociatedBigraded_multiplicative K hs d hrank j k i l r s x' y'
  have h₀ := congrArg (barycentricBigradedHomologyInclusion K hs d
    (j + k) (r + s) (i + l)) hm.symm
  have h₁ := originalTorAssociatedBigraded_inclusion K hs d hrank (j + k) (i + l) (r + s)
    (originalTorAssociatedProduct K hs d hrank j k i l r s x' y')
  have h₂ := congrArg (fun z => originalAssociatedBarycentricHomology K hs d hrank
      (i + l) (r + s) z)
    (originalTorGradeInclusion_product K hs d hrank j k i l r s x' y')
  have h₃ := originalAssociatedBarycentricHomology_multiplicative K hs d hrank i l r s
    (originalTorGradeInclusion K hs d hrank j i r x')
    (originalTorGradeInclusion K hs d hrank k l s y')
  have hxy := h₀.trans (h₁.trans (h₂.trans h₃))
  have hx := originalTorAssociatedBigraded_inclusion K hs d hrank j i r x'
  have hy := originalTorAssociatedBigraded_inclusion K hs d hrank k l s y'
  have h₄ := congrArg₂ (fun z w => barycentricGradedKoszulHomologyProduct K d hrank i l r s z w)
    hx.symm hy.symm
  have hrep := hxy.trans h₄
  have hx' : originalTorAssociatedBigraded K hs d hrank j i r x' = x :=
    (originalTorAssociatedBigraded K hs d hrank j i r).apply_symm_apply x
  have hy' : originalTorAssociatedBigraded K hs d hrank k l s y' = y :=
    (originalTorAssociatedBigraded K hs d hrank k l s).apply_symm_apply y
  have hin := congrArg₂ (fun z w => barycentricBigradedHomologyInclusion K hs d
      (j + k) (r + s) (i + l) (barycentricBigradedHomologyProduct K hs d hrank j k i l r s z w))
    hx' hy'
  have hout := congrArg₂ (fun z w => barycentricGradedKoszulHomologyProduct K d hrank i l r s
      (barycentricBigradedHomologyInclusion K hs d j r i z)
      (barycentricBigradedHomologyInclusion K hs d k s l w)) hx' hy'
  exact hin.symm.trans (hrep.trans hout)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.PaperTorMultiplication -/
section

open scoped DirectSum
/-! # The multiplicative clause of Theorem 1.2

The product on the cohomology direct sum is the one induced by the
barycentric coefficient Koszul DGA under the signed colorful cochain
comparison.  This is the product relevant to the paper's associated-Tor
claim.  Both products below are constructed before invoking the original
face-ring comparison, and their equality is proved for all finite sums.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology

section GradedProducts
variable {K : Type*} [CommRing K]
variable {A B C : ℕ → Type*} [∀ n, AddCommGroup (A n)] [∀ n, Module K (A n)]
  [∀ n, AddCommGroup (B n)] [∀ n, Module K (B n)]
  [∀ n, AddCommGroup (C n)] [∀ n, Module K (C n)]

/-- Extend homogeneous bilinear products by the universal property of the
direct sum.  Its value is a finite sum of the original products. -/
def gradedDirectSumProduct (p : ∀ r s, A r →ₗ[K] B s →ₗ[K] C (r + s)) :
    (⨁ r, A r) →ₗ[K] (⨁ s, B s) →ₗ[K] (⨁ n, C n) :=
  DirectSum.toModule K ℕ ((⨁ s, B s) →ₗ[K] (⨁ n, C n)) (fun r =>
    (DirectSum.toModule K ℕ (A r →ₗ[K] (⨁ n, C n)) (fun s =>
      ((p r s).compr₂ (DirectSum.lof K ℕ C (r + s))).flip)).flip)

@[simp] theorem gradedDirectSumProduct_lof
    (p : ∀ r s, A r →ₗ[K] B s →ₗ[K] C (r + s)) (r s : ℕ) (x : A r) (y : B s) :
    gradedDirectSumProduct p (DirectSum.lof K ℕ A r x) (DirectSum.lof K ℕ B s y) =
      DirectSum.lof K ℕ C (r + s) (p r s x y) := by
  simp only [gradedDirectSumProduct, DirectSum.toModule_lof, LinearMap.flip_apply,
    LinearMap.compr₂_apply]

variable {A' B' C' : ℕ → Type*} [∀ n, AddCommGroup (A' n)] [∀ n, Module K (A' n)]
  [∀ n, AddCommGroup (B' n)] [∀ n, Module K (B' n)]
  [∀ n, AddCommGroup (C' n)] [∀ n, Module K (C' n)]

theorem gradedDirectSumProduct_natural
    (p : ∀ r s, A r →ₗ[K] B s →ₗ[K] C (r + s))
    (q : ∀ r s, A' r →ₗ[K] B' s →ₗ[K] C' (r + s))
    (a : ∀ r, A r →ₗ[K] A' r) (b : ∀ s, B s →ₗ[K] B' s) (c : ∀ n, C n →ₗ[K] C' n)
    (h : ∀ r s x y, c (r + s) (p r s x y) = q r s (a r x) (b s y))
    (x : ⨁ r, A r) (y : ⨁ s, B s) :
    DirectSum.lmap c (gradedDirectSumProduct p x y) =
      gradedDirectSumProduct q (DirectSum.lmap a x) (DirectSum.lmap b y) := by
  have heq : (gradedDirectSumProduct p).compr₂ (DirectSum.lmap c) =
      (gradedDirectSumProduct q).compl₁₂ (DirectSum.lmap a) (DirectSum.lmap b) := by
    apply DirectSum.linearMap_ext
    intro r
    apply LinearMap.ext
    intro xr
    apply DirectSum.linearMap_ext
    intro s
    apply LinearMap.ext
    intro ys
    simpa only [LinearMap.comp_apply, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
      gradedDirectSumProduct_lof, DirectSum.lmap_lof] using
      congrArg (DirectSum.lof K ℕ C' (r + s)) (h r s xr ys)
  exact LinearMap.congr_fun (LinearMap.congr_fun heq x) y
end GradedProducts

universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)

def originalTorAssociatedGradedProduct (j k i l : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i →ₗ[K]
      originalTorAssociatedGraded K hs d hrank k l →ₗ[K]
        originalTorAssociatedGraded K hs d hrank (j + k) (i + l) :=
  gradedDirectSumProduct (originalTorAssociatedProduct K hs d hrank j k i l)

def barycentricBigradedSumProduct (j k i l : ℕ) :
    (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) →ₗ[K]
      (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) k n l) →ₗ[K]
        (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) (j + k) n (i + l)) :=
  gradedDirectSumProduct (barycentricBigradedHomologyProduct K hs d hrank j k i l)

theorem originalTorAssociatedBigradedSum_multiplicative (j k i l : ℕ)
    (x : originalTorAssociatedGraded K hs d hrank j i)
    (y : originalTorAssociatedGraded K hs d hrank k l) :
    originalTorAssociatedBigradedSum K hs d hrank (j + k) (i + l)
        (originalTorAssociatedGradedProduct K hs d hrank j k i l x y) =
      barycentricBigradedSumProduct K hs d hrank j k i l
        (originalTorAssociatedBigradedSum K hs d hrank j i x)
        (originalTorAssociatedBigradedSum K hs d hrank k l y) := by
  simpa only [originalTorAssociatedBigradedSum, DirectSum.coe_congrLinearEquiv,
    originalTorAssociatedGradedProduct, barycentricBigradedSumProduct] using
    gradedDirectSumProduct_natural
      (originalTorAssociatedProduct K hs d hrank j k i l)
      (barycentricBigradedHomologyProduct K hs d hrank j k i l)
      (fun n => (originalTorAssociatedBigraded K hs d hrank j i n).toLinearMap)
      (fun n => (originalTorAssociatedBigraded K hs d hrank k l n).toLinearMap)
      (fun n => (originalTorAssociatedBigraded K hs d hrank (j + k) (i + l) n).toLinearMap)
      (originalTorAssociatedBigraded_multiplicative K hs d hrank j k i l) x y

/-- The colorful cochain comparison, including the passage to ordinary
absolute augmented cohomology and the elimination of the weight index.
This is defined on the barycentric side, independently of original Tor. -/
def barycentricBigradedCohomologySumEquiv (j i : ℕ) :
    (⨁ n, barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i) ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedCohomology K hs d hrank S.val i) :=
  (gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
    (fun S => rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i)
    (fun n => barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i)
    (fun n => barycentricRelativeBigradedCohomologyEquiv K hs d hrank (∅ : Set P) (by simp) j n i)).trans
      ((DirectSum.linearEquivFunOnFintype K _ _).symm.trans
        (DirectSum.congrLinearEquiv (fun S =>
          (rankSelectedEmptyRelativeIso K hs d hrank S.val i).toLinearEquiv)))

theorem theorem_1_2_factor (j i : ℕ) (x : originalTorAssociatedGraded K hs d hrank j i) :
    theorem_1_2 K hs d hrank j i x =
      barycentricBigradedCohomologySumEquiv K hs d hrank j i
        (originalTorAssociatedBigradedSum K hs d hrank j i x) := by
  apply DFinsupp.ext
  intro S
  change (rankSelectedEmptyRelativeIso K hs d hrank S.val i).hom
      (originalTorRankSelectedEquiv K hs d hrank j i x S) =
    (rankSelectedEmptyRelativeIso K hs d hrank S.val i).hom
      (gradedSumConditionEquiv K (fun S => rankSubsetDegree S = j) (rankSubsetWeight d)
        (fun S => rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i)
        (fun n => barycentricRelativeBigradedHomology (P := P) K d (∅ : Set P) j n i)
        (fun n => barycentricRelativeBigradedCohomologyEquiv K hs d hrank
          (∅ : Set P) (by simp) j n i)
        (originalTorAssociatedBigradedSum K hs d hrank j i x) S)
  simp only [originalTorRankSelectedEquiv, gradedSumConditionEquiv_apply,
    LinearEquiv.trans_apply]
  rfl

/-- The cohomology product induced by the barycentric Koszul DGA and the
explicit colorful cochain isomorphism.  No map from original Tor is used
to define it. -/
def rankSelectedCohomologyProduct (j k i l : ℕ) :
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
      rankSelectedCohomology K hs d hrank S.val i) →ₗ[K]
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = k},
      rankSelectedCohomology K hs d hrank S.val l) →ₗ[K]
    (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j + k},
      rankSelectedCohomology K hs d hrank S.val (i + l)) :=
  ((barycentricBigradedSumProduct K hs d hrank j k i l).compl₁₂
    (barycentricBigradedCohomologySumEquiv K hs d hrank j i).symm.toLinearMap
    (barycentricBigradedCohomologySumEquiv K hs d hrank k l).symm.toLinearMap).compr₂
      (barycentricBigradedCohomologySumEquiv K hs d hrank (j + k) (i + l)).toLinearMap

/-- **Theorem 1.2, multiplicativity.** The same displayed isomorphism,
on the complete associated graded of ordinary Tor, preserves the products
induced by the actual exterior Koszul DGA. -/
theorem theorem_1_2_multiplicative (j k i l : ℕ)
    (x : originalTorAssociatedGraded K hs d hrank j i)
    (y : originalTorAssociatedGraded K hs d hrank k l) :
    theorem_1_2 K hs d hrank (j + k) (i + l)
        (originalTorAssociatedGradedProduct K hs d hrank j k i l x y) =
      rankSelectedCohomologyProduct K hs d hrank j k i l
        (theorem_1_2 K hs d hrank j i x)
        (theorem_1_2 K hs d hrank k l y) := by
  have h₁ := theorem_1_2_factor K hs d hrank (j + k) (i + l)
    (originalTorAssociatedGradedProduct K hs d hrank j k i l x y)
  have h₂ := congrArg (fun z => barycentricBigradedCohomologySumEquiv K hs d hrank
      (j + k) (i + l) z)
    (originalTorAssociatedBigradedSum_multiplicative K hs d hrank j k i l x y)
  have hx₀ := congrArg (fun z => (barycentricBigradedCohomologySumEquiv K hs d hrank j i).symm z)
    (theorem_1_2_factor K hs d hrank j i x)
  have hx := hx₀.trans ((barycentricBigradedCohomologySumEquiv K hs d hrank j i).symm_apply_apply
    (originalTorAssociatedBigradedSum K hs d hrank j i x))
  have hy₀ := congrArg (fun z => (barycentricBigradedCohomologySumEquiv K hs d hrank k l).symm z)
    (theorem_1_2_factor K hs d hrank k l y)
  have hy := hy₀.trans ((barycentricBigradedCohomologySumEquiv K hs d hrank k l).symm_apply_apply
    (originalTorAssociatedBigradedSum K hs d hrank k l y))
  have hp := congrArg₂ (fun z w => barycentricBigradedSumProduct K hs d hrank j k i l z w) hx hy
  have h₃ := congrArg (fun z => barycentricBigradedCohomologySumEquiv K hs d hrank
    (j + k) (i + l) z) hp
  exact (h₁.trans h₂).trans h₃.symm

end FourPapers.Universal

end
end

