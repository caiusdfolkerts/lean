/- BEGIN FourPapers.Universal.PaperTorAbsolute -/
section

/-! # The absolute form of Theorem 1.2

Both sides are the ordinary absolute objects: actual derived Tor of the
original face ring, and cohomology defined directly from augmented chains.
The intervening empty relative ideal is removed by explicit isomorphisms.
-/
noncomputable section
open scoped DirectSum
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 800000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u v
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
abbrev rankSelectedCohomology (S : Finset (Fin d)) (i : ℕ) :=
  letI : LinearOrder (NonzeroFace P) := (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  reducedCohomology (K := K) (rankSelection (rankColoredOrderComplex hs d hrank) S)
    (rankSelection_downward (rankColoredOrderComplex hs d hrank) S)
    ((S.card : ℤ) - i - 1)

def rankSelectedEmptyRelativeIso (S : Finset (Fin d)) (i : ℕ) :
    rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i ≅
      rankSelectedCohomology K hs d hrank S i := by
  letI : LinearOrder (NonzeroFace P) := (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  exact relativeVoidReducedCohomologyIso (K := K)
    (rankSelection (rankColoredOrderComplex hs d hrank) S)
    (rankSelection (rankColoredSubcomplex hs d hrank (∅ : Set P)).toColoredComplex S)
    (rankSelection_downward (rankColoredOrderComplex hs d hrank) S)
    (rankSelection_downward (rankColoredSubcomplex hs d hrank (∅ : Set P)).toColoredComplex S)
    (ProperlyColoredComplex.Subcomplex.rankSelection_void
      (D := rankColoredOrderComplex hs d hrank)
      (Q := rankColoredSubcomplex hs d hrank (∅ : Set P))
      (rankColoredSubcomplex_empty_face hs d hrank) S) ((S.card : ℤ) - i - 1)

def rankSelectedCohomologyAction (e : P ≃o P) (S : Finset (Fin d)) (i : ℕ) :
    rankSelectedCohomology K hs d hrank S i ⟶ rankSelectedCohomology K hs d hrank S i :=
  (rankColoredPairOrderAut hs d hrank (∅ : Set P) e (by simp)).absoluteReducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K
    (rankColoredSubcomplex_empty_face hs d hrank) S ((S.card : ℤ) - i - 1)

theorem rankSelectedEmptyRelativeIso_natural (e : P ≃o P) (S : Finset (Fin d)) (i : ℕ)
    (x : rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i) :
    (rankSelectedEmptyRelativeIso K hs d hrank S i).hom
      ((rankColoredPairOrderAut hs d hrank (∅ : Set P) e (by simp)).reducedCohomologyMap (D := rankColoredOrderComplex hs d hrank) K S
        ((S.card : ℤ) - i - 1) x) =
      rankSelectedCohomologyAction K hs d hrank e S i
        ((rankSelectedEmptyRelativeIso K hs d hrank S i).hom x) := by
  letI : LinearOrder (NonzeroFace P) := (rankColoredOrderComplex hs d hrank).colorLinearOrder
  letI : DecidableEq (Fin d) := Classical.decEq _
  letI : DecidableEq (NonzeroFace P) := Classical.decEq _
  exact congrArg (fun f => f x)
    ((rankColoredPairOrderAut hs d hrank (∅ : Set P) e (by simp)).relativeVoidReducedCohomologyIso_natural (D := rankColoredOrderComplex hs d hrank) K
      (rankColoredSubcomplex_empty_face hs d hrank) S ((S.card : ℤ) - i - 1))

/-- **Theorem 1.2.** The entire associated graded of the actual internal Tor
piece is the direct sum of ordinary rank-selected reduced cohomology. -/
def theorem_1_2 (j i : ℕ) :
    originalTorAssociatedGraded K hs d hrank j i ≃ₗ[K]
      (⨁ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        rankSelectedCohomology K hs d hrank S.val i) :=
  (originalTorRankSelectedDirectSumEquiv K hs d hrank j i).trans
    (DirectSum.congrLinearEquiv (fun S =>
      (rankSelectedEmptyRelativeIso K hs d hrank S.val i).toLinearEquiv))

variable {G : Type v} [Group G] (a : PosetGroupAction G P)

theorem theorem_1_2_equivariant (j i : ℕ) (g : G)
    (x : originalTorAssociatedGraded K hs d hrank j i) :
    theorem_1_2 K hs d hrank j i
      (originalTorAssociatedRepresentation K hs d hrank a j i g x) =
      DirectSum.lmap (fun S : {S : Finset (Fin d) // rankSubsetDegree S = j} =>
        (rankSelectedCohomologyAction K hs d hrank (a.orderIso g) S.val i).hom)
        (theorem_1_2 K hs d hrank j i x) := by
  apply DFinsupp.ext
  intro S
  change (rankSelectedEmptyRelativeIso K hs d hrank S.val i).hom
      (originalTorRankSelectedEquiv K hs d hrank j i
        (originalTorAssociatedRepresentation K hs d hrank a j i g x) S) = _
  rw [originalTorRankSelectedEquiv_equivariant]
  exact rankSelectedEmptyRelativeIso_natural K hs d hrank (a.orderIso g) S.val i _

/-- The exact finite, stable filtration used in the displayed isomorphism. -/
theorem theorem_1_2_finite_stable (j i : ℕ) :
    (originalTorFiltration K hs d hrank j i).level (2 * d * j + 1) = ⊤ ∧
      ∀ g, Preserves (originalTorFiltration K hs d hrank j i)
        (originalTorFiltration K hs d hrank j i)
        (originalTorDegreeRepresentation K hs d hrank a j i g) :=
  ⟨originalTorFiltration_finite K hs d hrank j i,
    fun g => originalTorDegreeAction_filtered K hs d hrank (a.orderIso g) j i⟩

end FourPapers.Universal

namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology FourPapers.RepresentationGrothendieck
universe u v
variable {P K : Type u} {G : Type v} [PartialOrder P] [OrderBot P] [Fintype P] [Field K] [Group G]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ) (hrank : ∀ p : P, faceRank p ≤ d)
variable (a : PosetGroupAction G P)

def originalTorFiniteRepresentation (j i : ℕ) : FiniteRepresentation K G := by
  letI := originalRelativeTorDegreePiece_finiteDimensional K hs d hrank (∅ : Set P) (by simp) j i
  letI := Module.Finite.equiv (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
  exact FiniteRepresentation.of (originalTorDegreePiece K hs d hrank j i)
    (originalTorDegreeRepresentation K hs d hrank a j i)

def rankSelectedFiniteRepresentation (S : Finset (Fin d)) (i : ℕ) : FiniteRepresentation K G := by
  let V := rankSelectedRelativeFiniteRepresentation K hs d hrank (∅ : Set P) (by simp) a (by simp) S i
  letI : Module.Finite K (rankSelectedRelativeCohomology K hs d hrank (∅ : Set P) S i) := V.finite
  let E := (rankSelectedEmptyRelativeIso K hs d hrank S i).toLinearEquiv
  letI := Module.Finite.equiv E
  exact FiniteRepresentation.of (rankSelectedCohomology K hs d hrank S i)
    (representationOfIntertwiningEquiv K V.action E
      (fun g => (rankSelectedCohomologyAction K hs d hrank (a.orderIso g) S i).hom)
      (fun g x => rankSelectedEmptyRelativeIso_natural K hs d hrank (a.orderIso g) S i x))

/-- **Theorem 1.2, representation-ring consequence.** The ordinary Tor
representation and ordinary cohomology representations have the stated
classes over every field, including modular characteristic. -/
theorem theorem_1_2_grothendieck (j i : ℕ) :
    classOf K G (originalTorFiniteRepresentation K hs d hrank a j i) =
      ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        classOf K G (rankSelectedFiniteRepresentation K hs d hrank a S.val i) := by
  calc
    _ = classOf K G (originalRelativeTorFiniteRepresentation K hs d hrank
        (∅ : Set P) a (by simp) (by simp) j i) := by
      symm
      exact class_equiv (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i)
        (fun g x => originalEmptyRelativeTorDegreeEquiv_equivariant K hs d hrank (a.orderIso g) j i x)
    _ = ∑ S : {S : Finset (Fin d) // rankSubsetDegree S = j},
        classOf K G (rankSelectedRelativeFiniteRepresentation K hs d hrank (∅ : Set P)
          (by simp) a (by simp) S.val i) :=
      theorem_1_2_relative_grothendieck K hs d hrank (∅ : Set P) (by simp) a (by simp) j i
    _ = _ := by
      apply Finset.sum_congr rfl
      intro S hS
      exact class_equiv (rankSelectedEmptyRelativeIso K hs d hrank S.val i).toLinearEquiv
        (fun g x => rankSelectedEmptyRelativeIso_natural K hs d hrank (a.orderIso g) S.val i x)

end FourPapers.Universal

end
end

/- BEGIN FourPapers.Universal.TorMultiplication -/
section

/-! # The resolution product on ordinary Tor and its internal filtration

The product is induced from the literal coefficient exterior Koszul DGA via
the proved resolution isomorphism.  The empty-relative coefficient identity
is used so that the internal submodules agree with the ones in the Tor
formula.  Their products are restrictions of this same ordinary Tor product.
-/
noncomputable section
set_option autoImplicit false
set_option maxRecDepth 4000
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
namespace FourPapers.Universal
open Classical CategoryTheory FourPapers.FilteredHomology
universe u
variable {P K : Type u} [PartialOrder P] [OrderBot P] [Fintype P] [CommRing K]
variable (K) (hs : IsSimplicialPoset P) (d : ℕ)

def originalCoefficientHomologyEquiv (i : ℕ) :
    CoefficientKoszulHomology (K := K)
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i ≃ₗ[K]
      originalKoszulHomology K hs d i :=
  parameterHomologyNormalization K (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i

def originalKoszulHomologyProduct (i l : ℕ) :
    originalKoszulHomology K hs d i →ₗ[K] originalKoszulHomology K hs d l →ₗ[K]
      originalKoszulHomology K hs d (i + l) :=
  ((coefficientKoszulHomologyProduct (K := K)
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l).compl₁₂
    (originalCoefficientHomologyEquiv K hs d i).symm.toLinearMap
    (originalCoefficientHomologyEquiv K hs d l).symm.toLinearMap).compr₂
      (originalCoefficientHomologyEquiv K hs d (i + l)).toLinearMap

@[simp] theorem originalKoszulHomologyProduct_class (i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalKoszulComplex K hs d) i))
    (y : LinearMap.ker (complexOutgoing (originalKoszulComplex K hs d) l)) :
    originalKoszulHomologyProduct K hs d i l (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _
        ⟨coefficientKoszulProduct (K := K) i l x.val y.val,
          coefficientKoszulProduct_cycle
            (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l
              x.val y.val x.property y.property⟩ := by
  rfl

def originalKoszulHomologyToTotal (i : ℕ) :
    originalKoszulHomology K hs d i →ₗ[K]
      CoefficientExteriorHomology (K := K) (fun c : Fin d => faceRankParameter K hs (c.val + 1)) :=
  (coefficientKoszulHomologyToTotal (K := K)
    (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i).comp
      (originalCoefficientHomologyEquiv K hs d i).symm.toLinearMap

theorem originalKoszulHomologyToTotal_product (i l : ℕ)
    (x : originalKoszulHomology K hs d i) (y : originalKoszulHomology K hs d l) :
    originalKoszulHomologyToTotal K hs d (i + l) (originalKoszulHomologyProduct K hs d i l x y) =
      originalKoszulHomologyToTotal K hs d i x * originalKoszulHomologyToTotal K hs d l y := by
  simp only [originalKoszulHomologyToTotal, originalKoszulHomologyProduct,
    LinearMap.comp_apply, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  exact coefficientKoszulHomologyProduct_toTotal
    (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l _ _

def originalEmptyRelativeTotalTermEquiv (i : ℕ) :
    originalRelativeKoszulTerm K hs d (∅ : Set P) i ≃ₗ[K] (originalKoszulComplex K hs d).X i where
  toFun := Subtype.val
  invFun x := ⟨x, by rw [originalRelativeKoszulTerm_empty]; trivial⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def originalEmptyRelativeTotalComplexIso :
    originalRelativeKoszulComplex K hs d (∅ : Set P) ≅ originalKoszulComplex K hs d :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => (originalEmptyRelativeTotalTermEquiv K hs d i).toModuleIso) (by
      intro i j hij
      obtain rfl : i = j + 1 := hij.symm
      rw [parameterKoszulComplex_d]
      simp only [originalRelativeKoszulComplex, submoduleComplex_d]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      change parameterKoszulDifferential (K := K)
          (fun c : Fin d => faceRankParameter K hs (c.val + 1)) j x.val =
        complexIncoming (originalKoszulComplex K hs d) j x.val
      exact (LinearMap.congr_fun (parameterKoszulComplex_incoming_eq K
        (fun c : Fin d => faceRankParameter K hs (c.val + 1)) j) x.val).symm)

/-- An actual derived-functor resolution isomorphism; its final chain map is
the identity on every coefficient of the ordinary Koszul resolution. -/
def originalTorProductResolutionIso (i : ℕ) :
    originalParameterTor K hs d i ≅ ModuleCat.of K (originalKoszulHomology K hs d i) :=
  (originalEmptyRelativeTorIso K hs d i).symm ≪≫
    originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i ≪≫
      (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i).toModuleIso

/-- The ordinary Tor product computed by the genuine coefficient Koszul
resolution, independently of the colorful cohomology description. -/
def originalTorProduct (i l : ℕ) :
    originalParameterTor K hs d i →ₗ[K] originalParameterTor K hs d l →ₗ[K]
      originalParameterTor K hs d (i + l) :=
  ((originalKoszulHomologyProduct K hs d i l).compl₁₂
    (originalTorProductResolutionIso K hs d i).toLinearEquiv.toLinearMap
    (originalTorProductResolutionIso K hs d l).toLinearEquiv.toLinearMap).compr₂
      (originalTorProductResolutionIso K hs d (i + l)).symm.toLinearEquiv.toLinearMap

@[simp] theorem originalTorProduct_resolution (i l : ℕ)
    (x : originalParameterTor K hs d i) (y : originalParameterTor K hs d l) :
    (originalTorProductResolutionIso K hs d (i + l)).hom (originalTorProduct K hs d i l x y) =
      originalKoszulHomologyProduct K hs d i l
        ((originalTorProductResolutionIso K hs d i).hom x)
        ((originalTorProductResolutionIso K hs d l).hom y) := by
  exact (originalTorProductResolutionIso K hs d (i + l)).toLinearEquiv.apply_symm_apply _

theorem originalTorProduct_exterior (i l : ℕ)
    (x : originalParameterTor K hs d i) (y : originalParameterTor K hs d l) :
    originalKoszulHomologyToTotal K hs d (i + l)
      ((originalTorProductResolutionIso K hs d (i + l)).hom (originalTorProduct K hs d i l x y)) =
      originalKoszulHomologyToTotal K hs d i ((originalTorProductResolutionIso K hs d i).hom x) *
        originalKoszulHomologyToTotal K hs d l ((originalTorProductResolutionIso K hs d l).hom y) := by
  rw [originalTorProduct_resolution, originalKoszulHomologyToTotal_product]

variable (hrank : ∀ p : P, faceRank p ≤ d)

theorem originalKoszulDegreeOutgoing_val (j i : ℕ)
    (x : originalKoszulDegreePiece K hs d i j) :
    (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i x).val =
      complexOutgoing (originalKoszulComplex K hs d) i x.val :=
  (congrArg (fun f : (originalKoszulDegreeComplex K hs d hrank j).X i ⟶
      (originalKoszulComplex K hs d).X (i - 1) => f x)
    ((originalKoszulDegreeInclusion K hs d hrank j).comm i (i - 1))).symm

def originalInternalHomologyInclusion (j i : ℕ) :
    originalInternalKoszulHomology K hs d hrank j i →ₗ[K] originalKoszulHomology K hs d i :=
  complexKernelHomologyMap (originalKoszulDegreeInclusion K hs d hrank j) i

def originalInternalHomologyRetraction (j i : ℕ) :
    originalKoszulHomology K hs d i →ₗ[K] originalInternalKoszulHomology K hs d hrank j i :=
  complexKernelHomologyMap (originalKoszulDegreeRetraction K hs d hrank j) i

theorem originalInternalHomology_retract_include (j i : ℕ) :
    (originalInternalHomologyRetraction K hs d hrank j i).comp
      (originalInternalHomologyInclusion K hs d hrank j i) = LinearMap.id := by
  rw [originalInternalHomologyRetraction, originalInternalHomologyInclusion,
    ← complexKernelHomologyMap_comp, originalKoszulDegreeInclusion_retraction,
    complexKernelHomologyMap_id]

theorem originalInternalHomologyInclusion_injective (j i : ℕ) :
    Function.Injective (originalInternalHomologyInclusion K hs d hrank j i) := by
  intro x y h
  have hh := congrArg (originalInternalHomologyRetraction K hs d hrank j i) h
  simpa only [← LinearMap.comp_apply, originalInternalHomology_retract_include,
    LinearMap.id_apply] using hh

theorem originalInternalHomologyInclusion_filtered (j i : ℕ) :
    Preserves (originalInternalHomologyFiltration K hs d hrank j i)
      (originalKoszulHomologyFiltration K hs d i)
      (originalInternalHomologyInclusion K hs d hrank j i) :=
  complexKernelHomologyMap_preserves (originalKoszulDegreeInclusion K hs d hrank j)
    (originalDegreeTermFiltration K hs d j) (originalKoszulFiltration K hs d)
    (fun _ _ _ hx => hx) i

theorem originalInternalHomologyRetraction_filtered (j i : ℕ) :
    Preserves (originalKoszulHomologyFiltration K hs d i)
      (originalInternalHomologyFiltration K hs d hrank j i)
      (originalInternalHomologyRetraction K hs d hrank j i) :=
  complexKernelHomologyMap_preserves (originalKoszulDegreeRetraction K hs d hrank j)
    (originalKoszulFiltration K hs d) (originalDegreeTermFiltration K hs d j)
    (fun k => basisProjection_preserves_other (originalKoszulBasis K hs d k)
      originalKoszulDegree j (fun a => (originalKoszulWeight d a).toNat)) i

include hrank in
theorem originalKoszulHomologyProduct_filtered (i l : ℕ) :
    PreservesPair (originalKoszulHomologyFiltration K hs d i)
      (originalKoszulHomologyFiltration K hs d l)
      (originalKoszulHomologyFiltration K hs d (i + l))
      (originalKoszulHomologyProduct K hs d i l) := by
  intro r s x y hx hy
  obtain ⟨x, rfl⟩ := (originalCoefficientHomologyEquiv K hs d i).surjective x
  obtain ⟨y, rfl⟩ := (originalCoefficientHomologyEquiv K hs d l).surjective y
  simp only [originalKoszulHomologyProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  apply (parameterHomologyNormalization_filtered K
    (fun c : Fin d => faceRankParameter K hs (c.val + 1))
    (originalKoszulFiltration K hs d) (i + l) (r + s + 1) _).mpr
  apply coefficientKoszulHomologyProduct_filtered
    (fun c : Fin d => faceRankParameter K hs (c.val + 1))
    (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i l
  · exact (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) i (r + 1) x).mp hx
  · exact (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) l (s + 1) y).mp hy

/-- The identity normalization of cycles induces the same associated product
as filtering the actual categorical Koszul homology product. -/
theorem originalAssociatedHomologyProduct_eq_gradeProduct (i l r s : ℕ)
    (x : Grade (originalKoszulHomologyFiltration K hs d i) r)
    (y : Grade (originalKoszulHomologyFiltration K hs d l) s) :
    originalAssociatedHomologyProduct K hs d hrank i l r s x y =
      gradeBilinearProduct (originalKoszulHomologyFiltration K hs d i)
        (originalKoszulHomologyFiltration K hs d l)
        (originalKoszulHomologyFiltration K hs d (i + l))
        (originalKoszulHomologyProduct K hs d i l)
        (originalKoszulHomologyProduct_filtered K hs d hrank i l) r s x y := by
  obtain ⟨x, rfl⟩ := (originalCoefficientHomologyGradeEquiv K hs d i r).surjective x
  obtain ⟨y, rfl⟩ := (originalCoefficientHomologyGradeEquiv K hs d l s).surjective y
  simp only [originalAssociatedHomologyProduct, LinearMap.compr₂_apply,
    LinearMap.compl₁₂_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  change (originalCoefficientHomologyGradeEquiv K hs d (i + l) (r + s)).toLinearMap
      (coefficientHomologyGradeProduct
        (fun c : Fin d => faceRankParameter K hs (c.val + 1))
        (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i l r s x y) =
    gradeBilinearProduct (originalKoszulHomologyFiltration K hs d i)
      (originalKoszulHomologyFiltration K hs d l)
      (originalKoszulHomologyFiltration K hs d (i + l))
      (originalKoszulHomologyProduct K hs d i l)
      (originalKoszulHomologyProduct_filtered K hs d hrank i l) r s
      ((originalCoefficientHomologyGradeEquiv K hs d i r).toLinearMap x)
      ((originalCoefficientHomologyGradeEquiv K hs d l s).toLinearMap y)
  simp only [originalCoefficientHomologyGradeEquiv, parameterHomologyGradeNormalization,
    gradeEquiv_eq_gradeMap]
  exact gradeBilinearProduct_natural_of_lower_defect
    (coefficientHomologyFiltration (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) i)
    (coefficientHomologyFiltration (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) l)
    (coefficientHomologyFiltration (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) (i + l))
    (coefficientKoszulHomologyProduct (K := K)
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l)
    (coefficientKoszulHomologyProduct_filtered
      (fun c : Fin d => faceRankParameter K hs (c.val + 1))
      (originalKoszulFiltration K hs d) (originalKoszulProduct_filtered K hs d hrank) i l)
    (originalKoszulHomologyFiltration K hs d i) (originalKoszulHomologyFiltration K hs d l)
    (originalKoszulHomologyFiltration K hs d (i + l))
    (originalKoszulHomologyProduct K hs d i l)
    (originalKoszulHomologyProduct_filtered K hs d hrank i l)
    (originalCoefficientHomologyEquiv K hs d i).toLinearMap
    (originalCoefficientHomologyEquiv K hs d l).toLinearMap
    (originalCoefficientHomologyEquiv K hs d (i + l)).toLinearMap
    (fun n z => (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (originalKoszulFiltration K hs d) i n z).mpr)
    (fun n z => (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (originalKoszulFiltration K hs d) l n z).mpr)
    (fun n z => (parameterHomologyNormalization_filtered K
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) (originalKoszulFiltration K hs d) (i + l) n z).mpr)
    (by
      intro r s z w hz hw
      simp only [originalKoszulHomologyProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
        LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply, sub_self]
      exact Submodule.zero_mem _) r s x y

/-- Restrict the actual product by the actual internal-degree projection.
The following inclusion formula proves that no product term is discarded. -/
def originalInternalHomologyProduct (j k i l : ℕ) :
    originalInternalKoszulHomology K hs d hrank j i →ₗ[K]
      originalInternalKoszulHomology K hs d hrank k l →ₗ[K]
        originalInternalKoszulHomology K hs d hrank (j + k) (i + l) :=
  ((originalKoszulHomologyProduct K hs d i l).compl₁₂
    (originalInternalHomologyInclusion K hs d hrank j i)
    (originalInternalHomologyInclusion K hs d hrank k l)).compr₂
      (originalInternalHomologyRetraction K hs d hrank (j + k) (i + l))

def originalInternalCycleProduct (j k i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i))
    (y : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank k) l)) :
    LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank (j + k)) (i + l)) :=
  ⟨⟨coefficientKoszulProduct (K := K) i l x.val.val y.val.val,
    originalKoszulProduct_internalDegree K hs d i l j k x.val.val y.val.val
      x.val.property y.val.property⟩, by
    apply Subtype.ext
    rw [originalKoszulDegreeOutgoing_val]
    exact coefficientKoszulProduct_cycle
      (fun c : Fin d => faceRankParameter K hs (c.val + 1)) i l x.val.val y.val.val
      (by rw [← originalKoszulDegreeOutgoing_val K hs d hrank j i x.val, x.property]; rfl)
      (by rw [← originalKoszulDegreeOutgoing_val K hs d hrank k l y.val, y.property]; rfl)⟩

@[simp] theorem originalInternalHomologyProduct_class (j k i l : ℕ)
    (x : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank j) i))
    (y : LinearMap.ker (complexOutgoing (originalKoszulDegreeComplex K hs d hrank k) l)) :
    originalInternalHomologyProduct K hs d hrank j k i l
      (homologyClass _ _ _ x) (homologyClass _ _ _ y) =
      homologyClass _ _ _ (originalInternalCycleProduct K hs d hrank j k i l x y) := by
  change complexKernelHomologyMap (originalKoszulDegreeRetraction K hs d hrank (j + k)) (i + l)
    (originalKoszulHomologyProduct K hs d i l
      (complexKernelHomologyMap (originalKoszulDegreeInclusion K hs d hrank j) i
        (homologyClass _ _ _ x))
      (complexKernelHomologyMap (originalKoszulDegreeInclusion K hs d hrank k) l
        (homologyClass _ _ _ y))) = _
  rw [complexKernelHomologyMap_class, complexKernelHomologyMap_class,
    originalKoszulHomologyProduct_class]
  apply congrArg (homologyClass _ _ _)
  apply Subtype.ext
  apply Subtype.ext
  exact FourPapers.BasisGrading.projection_eq_self
    (originalKoszulProduct_internalDegree K hs d i l j k x.val.val y.val.val
      x.val.property y.val.property)

theorem originalInternalHomologyProduct_inclusion (j k i l : ℕ)
    (x : originalInternalKoszulHomology K hs d hrank j i)
    (y : originalInternalKoszulHomology K hs d hrank k l) :
    originalInternalHomologyInclusion K hs d hrank (j + k) (i + l)
      (originalInternalHomologyProduct K hs d hrank j k i l x y) =
      originalKoszulHomologyProduct K hs d i l
        (originalInternalHomologyInclusion K hs d hrank j i x)
        (originalInternalHomologyInclusion K hs d hrank k l y) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  change originalInternalHomologyInclusion K hs d hrank (j + k) (i + l)
      (originalInternalHomologyProduct K hs d hrank j k i l
        (homologyClass _ _ _ x) (homologyClass _ _ _ y)) =
    originalKoszulHomologyProduct K hs d i l
      (originalInternalHomologyInclusion K hs d hrank j i (homologyClass _ _ _ x))
      (originalInternalHomologyInclusion K hs d hrank k l (homologyClass _ _ _ y))
  rw [originalInternalHomologyProduct_class]
  change complexKernelHomologyMap _ _ (homologyClass _ _ _ _) =
    originalKoszulHomologyProduct K hs d i l
      (complexKernelHomologyMap _ _ (homologyClass _ _ _ x))
      (complexKernelHomologyMap _ _ (homologyClass _ _ _ y))
  rw [complexKernelHomologyMap_class, complexKernelHomologyMap_class,
    complexKernelHomologyMap_class, originalKoszulHomologyProduct_class]
  rfl

theorem originalInternalHomologyProduct_filtered (j k i l : ℕ) :
    PreservesPair (originalInternalHomologyFiltration K hs d hrank j i)
      (originalInternalHomologyFiltration K hs d hrank k l)
      (originalInternalHomologyFiltration K hs d hrank (j + k) (i + l))
      (originalInternalHomologyProduct K hs d hrank j k i l) := by
  intro r s x y hx hy
  apply originalInternalHomologyRetraction_filtered K hs d hrank (j + k) (i + l)
  apply originalKoszulHomologyProduct_filtered K hs d hrank i l
  · exact originalInternalHomologyInclusion_filtered K hs d hrank j i (r + 1) x hx
  · exact originalInternalHomologyInclusion_filtered K hs d hrank k l (s + 1) y hy

def originalInternalTorEquiv (j i : ℕ) :
    originalInternalKoszulHomology K hs d hrank j i ≃ₗ[K] originalTorDegreePiece K hs d hrank j i :=
  (originalEmptyRelativeHomologyEquiv K hs d hrank j i).symm.trans
    ((originalRelativeTorDegreeEquiv K hs d hrank (∅ : Set P) (by simp) j i).trans
      (originalEmptyRelativeTorDegreeEquiv K hs d hrank j i))

theorem originalInternalTorEquiv_filtered (j i n : ℕ)
    (x : originalInternalKoszulHomology K hs d hrank j i) :
    originalInternalTorEquiv K hs d hrank j i x ∈ (originalTorFiltration K hs d hrank j i).level n ↔
      x ∈ (originalInternalHomologyFiltration K hs d hrank j i).level n := by
  rw [originalInternalTorEquiv, LinearEquiv.trans_apply, LinearEquiv.trans_apply,
    originalEmptyRelativeTorDegreeEquiv_filtered]
  rw [originalRelativeTorFiltration, equivalenceFiltration_apply]
  have h := originalEmptyRelativeHomologyEquiv_filtered K hs d hrank j i n
    ((originalEmptyRelativeHomologyEquiv K hs d hrank j i).symm x)
  simpa only [LinearEquiv.apply_symm_apply] using h.symm

theorem originalEmptyRelative_inclusion_square (j : ℕ) :
    originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j ≫
      (originalEmptyRelativeTotalComplexIso K hs d).hom =
    (originalEmptyRelativeComplexIso K hs d hrank j).hom ≫
      originalKoszulDegreeInclusion K hs d hrank j := by
  apply HomologicalComplex.Hom.ext
  funext i
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change x.val = (originalEmptyRelativeTermEquiv K hs d j i x).val
  exact (LinearEquiv.coe_ofEq_apply
    (originalRelativeDegreeTerm_empty K hs d j i) x).symm

/-- The homogeneous-submodule equivalence really is the homogeneous
inclusion under the same resolution map that defines multiplication. -/
theorem originalInternalTorEquiv_resolution (j i : ℕ)
    (x : originalInternalKoszulHomology K hs d hrank j i) :
    (originalTorProductResolutionIso K hs d i).hom (originalInternalTorEquiv K hs d hrank j i x).val =
      originalInternalHomologyInclusion K hs d hrank j i x := by
  let y := (originalEmptyRelativeHomologyEquiv K hs d hrank j i).symm x
  have hc := congrArg (fun f => complexKernelHomologyMap f i)
    (originalEmptyRelative_inclusion_square K hs d hrank j)
  rw [complexKernelHomologyMap_comp, complexKernelHomologyMap_comp] at hc
  have hx := LinearMap.congr_fun hc y
  change complexKernelHomologyMap (originalEmptyRelativeTotalComplexIso K hs d).hom i
      (complexKernelHomologyMap (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y) =
    originalInternalHomologyInclusion K hs d hrank j i
      (originalEmptyRelativeHomologyEquiv K hs d hrank j i y) at hx
  rw [LinearEquiv.apply_symm_apply] at hx
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
    ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).hom
      ((originalEmptyRelativeTorIso K hs d i).inv
        ((originalEmptyRelativeTorIso K hs d i).hom
          ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).inv
            (complexKernelHomologyMap
              (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y))))) = _
  simp only [← ModuleCat.comp_apply, Iso.hom_inv_id, Iso.inv_hom_id, ModuleCat.id_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i)
      ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv
        ((originalRelativeParameterTorKernelIso K hs d (∅ : Set P) i).toLinearEquiv.symm
          (complexKernelHomologyMap
            (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y))) = _
  rw [LinearEquiv.apply_symm_apply]
  change (complexKernelHomologyEquiv (originalEmptyRelativeTotalComplexIso K hs d) i).toLinearMap
      (complexKernelHomologyMap
        (originalRelativeDegreeInclusion K hs d hrank (∅ : Set P) j) i y) = _
  rw [complexKernelHomologyEquiv_toLinearMap]
  exact hx

def originalTorInternalProduct (j k i l : ℕ) :
    originalTorDegreePiece K hs d hrank j i →ₗ[K]
      originalTorDegreePiece K hs d hrank k l →ₗ[K]
        originalTorDegreePiece K hs d hrank (j + k) (i + l) :=
  ((originalInternalHomologyProduct K hs d hrank j k i l).compl₁₂
    (originalInternalTorEquiv K hs d hrank j i).symm.toLinearMap
    (originalInternalTorEquiv K hs d hrank k l).symm.toLinearMap).compr₂
      (originalInternalTorEquiv K hs d hrank (j + k) (i + l)).toLinearMap

theorem originalTorInternalProduct_val (j k i l : ℕ)
    (x : originalTorDegreePiece K hs d hrank j i) (y : originalTorDegreePiece K hs d hrank k l) :
    (originalTorInternalProduct K hs d hrank j k i l x y).val =
      originalTorProduct K hs d i l x.val y.val := by
  obtain ⟨x, rfl⟩ := (originalInternalTorEquiv K hs d hrank j i).surjective x
  obtain ⟨y, rfl⟩ := (originalInternalTorEquiv K hs d hrank k l).surjective y
  apply (originalTorProductResolutionIso K hs d (i + l)).toLinearEquiv.injective
  simp only [originalTorInternalProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  change (originalTorProductResolutionIso K hs d (i + l)).hom
      (originalInternalTorEquiv K hs d hrank (j + k) (i + l)
        (originalInternalHomologyProduct K hs d hrank j k i l x y)).val =
    (originalTorProductResolutionIso K hs d (i + l)).hom
      (originalTorProduct K hs d i l
        (originalInternalTorEquiv K hs d hrank j i x).val
        (originalInternalTorEquiv K hs d hrank k l y).val)
  rw [originalInternalTorEquiv_resolution, originalTorProduct_resolution,
    originalInternalTorEquiv_resolution, originalInternalTorEquiv_resolution]
  exact originalInternalHomologyProduct_inclusion K hs d hrank j k i l x y

theorem originalTorInternalProduct_filtered (j k i l : ℕ) :
    PreservesPair (originalTorFiltration K hs d hrank j i)
      (originalTorFiltration K hs d hrank k l)
      (originalTorFiltration K hs d hrank (j + k) (i + l))
      (originalTorInternalProduct K hs d hrank j k i l) := by
  intro r s x y hx hy
  obtain ⟨x, rfl⟩ := (originalInternalTorEquiv K hs d hrank j i).surjective x
  obtain ⟨y, rfl⟩ := (originalInternalTorEquiv K hs d hrank k l).surjective y
  simp only [originalTorInternalProduct, LinearMap.compr₂_apply, LinearMap.compl₁₂_apply,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  apply (originalInternalTorEquiv_filtered K hs d hrank (j + k) (i + l) (r + s + 1) _).mpr
  apply originalInternalHomologyProduct_filtered K hs d hrank j k i l
  · exact (originalInternalTorEquiv_filtered K hs d hrank j i (r + 1) x).mp hx
  · exact (originalInternalTorEquiv_filtered K hs d hrank k l (s + 1) y).mp hy

def originalTorAssociatedProduct (j k i l r s : ℕ) :
    Grade (originalTorFiltration K hs d hrank j i) r →ₗ[K]
      Grade (originalTorFiltration K hs d hrank k l) s →ₗ[K]
        Grade (originalTorFiltration K hs d hrank (j + k) (i + l)) (r + s) :=
  gradeBilinearProduct _ _ _ (originalTorInternalProduct K hs d hrank j k i l)
    (originalTorInternalProduct_filtered K hs d hrank j k i l) r s

end FourPapers.Universal

