  -- w è l'estremo inferiore: nessuna coordinata negativa
  have hwex : w ∈ e.extremePoints ℝ := vertice_estremo_in_faccia P he hwV hwe
  have hmin : ∀ z ∈ e, ∀ s : ℝ, z = w + s • d → 0 ≤ s := by
