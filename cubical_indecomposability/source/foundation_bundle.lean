  obtain ⟨a, ha⟩ := hA.2
  have hint : P.IsFace (Ci ∩ Cj) :=
    ⟨hCi.1.inter hCj.1, ⟨a, hAi.1 ha, hAj.1 ha⟩⟩
  have hinter_strict : Ci ∩ Cj ⊂ Ci := by
    refine ⟨Set.inter_subset_left, fun hsup => ?_⟩
    have hij : Ci ⊆ Cj := fun z hz => (hsup hz).2
