    obtain ⟨δ, hδ, hdδ, hqaδ, hδY, hδZ⟩ := hsp
    have hYsub : Y ⊆ Q.toSet := face_subset_toSet Q hY.1
    have hZsub : Z ⊆ Q.toSet := face_subset_toSet Q hZ.1
    have hδsub : δ ⊆ Q.toSet := face_subset_toSet Q hδ
