  have hAinter : A ⊆ Ci ∩ Cj := fun z hz => ⟨hAi.1 hz, hAj.1 hz⟩
  have hdim_le : faceDim A ≤ faceDim (Ci ∩ Cj) := by
    exact Submodule.finrank_mono (vectorSpan_mono Real hAinter)
