    rw [this]
    exact W.sub_mem hv1W (hUW hq1d)
  have hq2W : q2 ∈ W := by
    have : q2 = v2 - (v2 - q2) := by abel
    rw [this]
    exact W.sub_mem hv2W (hUW hq2d)
  have hq3W : q3 ∈ W := by
    have : q3 = v3 - (v3 - q3) := by abel
    rw [this]
    exact W.sub_mem hv3W (hUW hq3d)
