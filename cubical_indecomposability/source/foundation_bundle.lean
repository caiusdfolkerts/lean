    · linarith
    · exact hdne h
  have haPV : a ∈ P.vertices := by
    have h1 := haV
    rw [hV] at h1
    exact (Finset.mem_filter.mp h1).1
  refine ⟨a, haPV, hae, ?_, ?_⟩
  · intro h
    rw [h] at hsa
    have h0 : sa • d = 0 := by
      have := congrArg (fun q => q - w) hsa
      simpa using this.symm
    rcases smul_eq_zero.mp h0 with h1 | h1
