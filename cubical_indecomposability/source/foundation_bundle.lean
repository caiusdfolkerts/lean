      hLYB, hLZB, hdLY, hdLZ,
      lift δ, hLδ, hLAδ, hLδY, hLδZ, hdLδ⟩
  have valid_path : ∀ {Y Z : Set (E 3)}, Valid Y →
      Relation.ReflTransGen
        (fun S T => (Q.IsFace T ∧ faceDim T = 2 ∧ q a ∈ T) ∧
