section CompleteAuditSource001










/-!
# Export the proof's transitive dependency graph

This inspection command is separate from the mathematical development.
It follows every constant in the types and proof terms of local declarations,
including private auxiliary declarations. It stops at the pinned Lean/Mathlib
boundary, recording each boundary declaration and the axioms on which it
transitively depends. It does not add a theorem or alter the environment.

Run with `lake env lean -t0 tools/ExportDependencies.lean` from the project root.
-/

open Lean Elab Command

private def projectModule (name : Name) : Bool :=
  let s := name.toString
  s == "foundation_bundle" || s == "incidence_bundle" || s == "verification_bundle" ||
    s == "block_verification_bundle" || s.startsWith "CubicalIndecomposability" ||
    s.startsWith "Cubical." || s.startsWith "Papers."

private def declarationKind : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "definition"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quotient primitive"
  | .inductInfo _ => "inductive type"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

private def namesJson (names : Array Name) : Json :=
  .arr (names.map (fun n => .str n.toString))

set_option maxHeartbeats 0 in
run_cmd do
  let env := (← getEnv).setExporting false
  let roots := #[`CubicalIndecomposability.theorem_one,
    `CubicalIndecomposability.parallel_vertex_assignment_iff,
    `CubicalIndecomposability.minkowski_summands,
    `CubicalIndecomposability.minkowski_indecomposable,
    `CubicalIndecomposability.facetCubeCompleteOrderIso,
    `CubicalIndecomposability.generalVertexStep_iff_edge,
    `CubicalIndecomposability.lemma_two,
    `CubicalIndecomposability.lemma_three_one,
    `Papers.Polytopes.redrawing_zero_of_two_neighbors,
    `CubicalIndecomposability.deformation_dimension,
    `CubicalIndecomposability.redrawing_dimension,
    `CubicalIndecomposability.Block.proposition_five,
    `CubicalIndecomposability.Block.generalVertexStep_iff_edge,
    `CubicalIndecomposability.Block.H_determines,
    `CubicalIndecomposability.Block.G_determines,
    `CubicalIndecomposability.Block.F_restriction_dimension,
    `CubicalIndecomposability.Block.affine_interface_normalization,
    `CubicalIndecomposability.Block.G_projectively_parallelepiped]
  let mut pending := roots
  let mut seen : NameSet := {}
  let mut nodes : Array Json := #[]
  let mut localCount : Nat := 0
  let mut boundaryCount : Nat := 0
  while !pending.isEmpty do
    let name := pending.back!
    pending := pending.pop
    if seen.contains name then continue
    seen := seen.insert name
    let some info := env.checked.get.find? name
      | throwError "Missing declaration while auditing {name}"
    let moduleName := match env.getModuleIdxFor? name with
      | some idx => env.header.moduleNames[idx.toNat]!
      | none => Name.anonymous
    let isLocal := projectModule moduleName
    let termDeps : NameSet := if isLocal then
      info.type.getUsedConstantsAsSet ++
        (match info.value? (allowOpaque := true) with
        | some value => value.getUsedConstantsAsSet
        | none => {})
      else {}
    let deps := if isLocal then
      info.getUsedConstantsAsSet.toArray.qsort Name.lt
      else #[]
    let structuralDeps := deps.filter (fun dependency => !termDeps.contains dependency)
    let axioms ← liftCoreM (collectAxioms name)
    let ranges ← findDeclarationRanges? name
    let location := match ranges with
      | none => Json.null
      | some r => Json.mkObj [
          ("start_line", toJson r.range.pos.line),
          ("start_column", toJson r.range.pos.column),
          ("end_line", toJson r.range.endPos.line),
          ("end_column", toJson r.range.endPos.column)]
    nodes := nodes.push (Json.mkObj [
      ("name", .str name.toString),
      ("module", .str moduleName.toString),
      ("kind", .str (declarationKind info)),
      ("range", location),
      ("boundary", .bool (!isLocal)),
      ("dependencies", namesJson deps),
      ("term_dependencies", namesJson (termDeps.toArray.qsort Name.lt)),
      ("structural_dependencies", namesJson structuralDeps),
      ("unsafe", .bool info.isUnsafe),
      ("partial", .bool info.isPartial),
      ("transitive_axioms", namesJson axioms)])
    if isLocal then
      localCount := localCount + 1
      pending := pending ++ deps
    else
      boundaryCount := boundaryCount + 1
  let report := Json.mkObj [
    ("format_version", toJson (1 : Nat)),
    ("roots", namesJson roots),
    ("lean", .str Lean.versionString),
    ("boundary_policy", .str "Recursively inspect local types and proof/value terms; record pinned imported declarations with their complete axiom closures."),
    ("mathlib", .str "56a005855ea17e0b0958f73ec801ae140b0a1679"),
    ("local_declarations", toJson localCount),
    ("boundary_declarations", toJson boundaryCount),
    ("nodes", .arr nodes)]
  liftIO <| IO.FS.createDirAll ".lake/reports"
  liftIO <| IO.FS.writeFile ".lake/reports/declaration_dependencies.json" (report.pretty ++ "\n")
  logInfo m!"DEPENDENCY_EXPORT_COMPLETE: {localCount} local declarations and {boundaryCount} boundary declarations."
end CompleteAuditSource001

/- Original source: tools/KernelBodyRecheck.lean -/
section CompleteAuditSource002











/-!
# Independent checking of serialized declaration bodies

This inspection tool calls the C++ kernel's checking entry point directly.
For each safe definition, theorem, or opaque declaration in the four
mathematical bundles, it copies the original universe parameters, type,
and value under a fresh name. The returned environment is discarded after
each call. No declaration is added to the mathematical environment.

The check is relative to the imported environment. Before replay, the tool
checks that the actual type/value dependency graph of every local declaration
is acyclic, including declarations outside the principal roots' closure.
It complements the source frontend checks and the independently recomputed
local axiom closures. Inductive types, constructors,
and recursors have no ordinary term body to replay this way; they are
listed separately, with the source frontend's kernel checks as authority.

Run only after all four clean bundles have been built:
`lake env lean -t0 -s65536 -DElab.async=false tools/KernelBodyRecheck.lean`.
The completed JSON report and completion marker are emitted only if every
requested body passes. A progress journal identifies an interrupted check.
-/

open Lean Elab Command

private def recheckKind : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "definition"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quotient primitive"
  | .inductInfo _ => "inductive type"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

/-- Only the name and the non-kernel mutual-block bookkeeping are changed.
In particular, the original type, universe parameters, and body are copied
without rewriting references or replacing a proof by its theorem constant. -/
private def freshBodyDeclaration (fresh : Name) : ConstantInfo → Option Declaration
  | .defnInfo value => some (.defnDecl { value with name := fresh, all := [fresh] })
  | .thmInfo value => some (.thmDecl { value with name := fresh, all := [fresh] })
  | .opaqueInfo value => some (.opaqueDecl { value with name := fresh, all := [fresh] })
  | _ => none

private def recheckNamesJson (names : Array Name) : Json :=
  .arr (names.map (fun name => .str name.toString))

set_option maxHeartbeats 0 in
run_cmd do
  -- The launcher also invalidates this report before module imports, which
  -- covers failures occurring before this command can execute.
  liftIO <| IO.FS.createDirAll ".lake/reports"
  let reportPath : System.FilePath := ".lake/reports/kernel_body_recheck.json"
  liftIO <| IO.FS.writeFile reportPath
    ((Json.mkObj [("status", .str "running; no completed recheck receipt")]).pretty ++ "\n")
  let env := (← getEnv).setExporting false
  let kernelEnv := env.checked.get
  unless kernelEnv.header.trustLevel == 0 do
    throwError "Kernel body recheck requires trust level zero"
  if (← getOptions).getBool `debug.skipKernelTC false then
    throwError "Kernel body recheck refuses disabled kernel checking"
  let modules : Array Name :=
    #[`foundation_bundle, `incidence_bundle, `verification_bundle, `block_verification_bundle]
  let names := (kernelEnv.constants.fold (fun names name _ =>
    match env.getModuleIdxFor? name with
    | some idx =>
      if modules.contains env.header.moduleNames[idx.toNat]! then names.push name
      else names
    | none => names) (#[] : Array Name)).qsort Name.lt
  unless !names.isEmpty do
    throwError "Kernel body recheck found no bundle declarations"
  for moduleName in modules do
    unless names.any (fun name => match env.getModuleIdxFor? name with
        | some idx => env.header.moduleNames[idx.toNat]! == moduleName
        | none => false) do
      throwError "Kernel body recheck found no declarations in {moduleName}"
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  -- Reject every forbidden local declaration before replaying any body.
  for name in names do
    let some info := kernelEnv.find? name
      | throwError "Missing original declaration {name}"
    if info.isUnsafe || info.isPartial then
      throwError "Unsafe or partial local declaration: {name}"
    match info with
    | .axiomInfo _ => throwError "Local axiom is forbidden: {name}"
    | _ => pure ()
    let axioms ← collectAxioms name
    let rejected := axioms.filter (fun axiomName => !allowed.contains axiomName)
    unless rejected.isEmpty do
      throwError "Forbidden axioms in {name}: {rejected}"
  -- Do not use ConstantInfo.getUsedConstantsAsSet here: in addition to
  -- expression dependencies it includes inductive-family bookkeeping links.
  -- Those links can form legitimate structural cycles. Actual types and
  -- bodies have an acyclic graph, including safe mutually recursive source
  -- functions after the frontend has translated them into kernel terms.
  let localNames := NameSet.ofArray names
  let mut dependencyCounts : NameMap Nat := {}
  let mut reverseUsers : NameMap (Array Name) := {}
  let mut dependencyEntries : Array Json := #[]
  let mut edgeCount : Nat := 0
  let mut order : Array Name := #[]
  for name in names do
    let some info := kernelEnv.find? name
      | throwError "Missing declaration in dependency preflight: {name}"
    let termDependencies := info.type.getUsedConstantsAsSet ++
      (match info.value? (allowOpaque := true) with
      | some value => value.getUsedConstantsAsSet
      | none => {})
    let dependencies := (termDependencies.toArray.filter localNames.contains).qsort Name.lt
    dependencyCounts := dependencyCounts.insert name dependencies.size
    edgeCount := edgeCount + dependencies.size
    dependencyEntries := dependencyEntries.push (Json.mkObj [
      ("name", .str name.toString),
      ("dependencies", recheckNamesJson dependencies)])
    if dependencies.isEmpty then
      order := order.push name
    for dependency in dependencies do
      let users := (reverseUsers.find? dependency).getD #[]
      reverseUsers := reverseUsers.insert dependency (users.push name)
  let mut cursor : Nat := 0
  while cursor < order.size do
    let completed := order[cursor]!
    cursor := cursor + 1
    for user in (reverseUsers.find? completed).getD #[] do
      let some remaining := dependencyCounts.find? user
        | throwError "Dependency graph has an unknown user: {user}"
      if remaining == 0 then
        throwError "Dependency count underflow for {user}"
      let remaining := remaining - 1
      dependencyCounts := dependencyCounts.insert user remaining
      if remaining == 0 then
        order := order.push user
  unless order.size == names.size do
    let unresolved := names.filter (fun name =>
      (dependencyCounts.find? name).getD 0 != 0)
    throwError "Local type/value dependency graph is cyclic: {unresolved}"
  let journal ← liftIO <| IO.FS.Handle.mk ".lake/reports/kernel_body_recheck_progress.jsonl" .write
  let mut checkedBodies : Array Json := #[]
  let mut structural : Array Json := #[]
  for index in [:order.size] do
    let name := order[index]!
    let some info := kernelEnv.find? name
      | throwError "Original declaration disappeared: {name}"
    let some moduleIndex := env.getModuleIdxFor? name
      | throwError "Original declaration has no module: {name}"
    let moduleName := env.header.moduleNames[moduleIndex.toNat]!
    let entry := Json.mkObj [
      ("name", .str name.toString),
      ("module", .str moduleName.toString),
      ("kind", .str (recheckKind info))]
    let fresh := Name.num `_kernelBodyRecheckFresh index
    if (kernelEnv.find? fresh).isSome then
      throwError "Recheck name is not fresh: {fresh}"
    match freshBodyDeclaration fresh info with
    | none =>
      structural := structural.push entry
    | some declaration =>
      if declaration.hasSorry then
        throwError "A serialized body contains an admitted proof: {name}"
      liftIO <| journal.putStrLn (Json.mkObj [
        ("event", .str "checking"), ("declaration", entry),
        ("fresh_name", .str fresh.toString)]).compress
      liftIO journal.flush
      -- This entry point always checks the declaration. The fixed base
      -- environment is reused; the returned extension is never installed.
      match Lean.Kernel.Environment.addDeclCore kernelEnv 0 1000000 declaration none with
      | .error exception =>
        liftIO <| journal.putStrLn (Json.mkObj [
          ("event", .str "failed"), ("declaration", entry)]).compress
        liftIO journal.flush
        throwKernelException exception
      | .ok _ =>
        checkedBodies := checkedBodies.push entry
        liftIO <| journal.putStrLn (Json.mkObj [
          ("event", .str "passed"), ("declaration", entry)]).compress
        liftIO journal.flush
  let report := Json.mkObj [
    ("status", .str "passed"),
    ("lean", .str Lean.versionString),
    ("mathlib", .str "56a005855ea17e0b0958f73ec801ae140b0a1679"),
    ("modules", recheckNamesJson modules),
    ("trust_level", toJson (0 : Nat)),
    ("kernel_entry_point", .str "Lean.Kernel.Environment.addDeclCore"),
    ("max_recursion_depth", toJson (1000000 : Nat)),
    ("local_declarations", toJson names.size),
    ("all_local_type_value_dependencies_acyclic", .bool true),
    ("local_type_value_dependency_edges", toJson edgeCount),
    ("local_type_value_dependencies", .arr dependencyEntries),
    ("topological_order", recheckNamesJson order),
    ("body_declarations_checked", toJson checkedBodies.size),
    ("structural_declarations_recorded", toJson structural.size),
    ("body_declarations", .arr checkedBodies),
    ("structural_declarations", .arr structural),
    ("scope", .str "Every local bundle declaration was checked for forbidden safety flags and axioms. The actual type/value dependency graph of all these declarations was checked acyclic. Every serialized definition/theorem/opaque type and body was then rechecked under a fresh name relative to the fixed imported environment; every returned extension was discarded. The separate principal-root dependency audit independently recomputes local axiom closures in that roots' transitive closure."),
    ("dependency_policy", .str "Edges are constants occurring in actual types and ordinary values, restricted to the four local bundles. Inductive-family and mutual-block bookkeeping links are excluded from this acyclicity test; ordinary type references of structural declarations are included."),
    ("datatype_authority", .str "Inductive types, constructors, recursors, and quotient primitives have no ordinary term body replayed here. Their formation and kernel rules remain covered by the checked source frontend; their exact names are recorded above.")]
  liftIO <| IO.FS.writeFile reportPath (report.pretty ++ "\n")
  logInfo m!"KERNEL_BODY_RECHECK_COMPLETE: {checkedBodies.size} bodies checked directly; {structural.size} structural declarations recorded; {names.size} local declarations total."
end CompleteAuditSource002

