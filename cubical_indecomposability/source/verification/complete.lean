/-!
Kernel dependency audit for the principal result and its geometric parts.

The final command inspects every declaration in all four checked bundles, including
unused and private auxiliary declarations. It fails if any declaration is an
axiom, is unsafe, or depends on an axiom beyond Lean's three usual classical
foundations. Printing a successful theorem's type is not the acceptance test.
-/

#print axioms CubicalIndecomposability.theorem_one
#print axioms CubicalIndecomposability.polytope_dimension
#print axioms CubicalIndecomposability.rational_coordinates
#print axioms CubicalIndecomposability.indexedFace_complete
#print axioms CubicalIndecomposability.face_vector
#print axioms CubicalIndecomposability.polytope_isCubical
#print axioms CubicalIndecomposability.parallel_redrawings_homothetic
#print axioms CubicalIndecomposability.parallel_vertex_assignment_iff
#print axioms CubicalIndecomposability.generalVertexStep_iff_edge
#print axioms CubicalIndecomposability.minkowski_summands
#print axioms CubicalIndecomposability.minkowski_indecomposable
#print axioms CubicalIndecomposability.lemma_two
#print axioms CubicalIndecomposability.lemma_three_one
#print axioms Papers.Polytopes.redrawing_zero_of_two_neighbors
#print axioms CubicalIndecomposability.deformation_dimension
#print axioms CubicalIndecomposability.redrawing_dimension
#print axioms CubicalIndecomposability.Block.proposition_five
#print axioms CubicalIndecomposability.Block.H_determines
#print axioms CubicalIndecomposability.Block.G_determines
#print axioms CubicalIndecomposability.Block.generalVertexStep_iff_edge
#print axioms CubicalIndecomposability.Block.F_restriction_dimension
#print axioms CubicalIndecomposability.Block.affine_interface_normalization
#print axioms CubicalIndecomposability.Block.G_projectively_parallelepiped

#check @CubicalIndecomposability.theorem_one
#check @CubicalIndecomposability.parallel_vertex_assignment_iff
#check @CubicalIndecomposability.minkowski_summands
#check @CubicalIndecomposability.lemma_two
#check @CubicalIndecomposability.lemma_three_one
#check @Papers.Polytopes.redrawing_zero_of_two_neighbors
#check @CubicalIndecomposability.Block.proposition_five
#check @Papers.Polytopes.deformationDimension_eq_one_iff
#check @Papers.Polytopes.restriction_rank_le_of_difference_determination

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env := (← getEnv).setExporting false
  let modules : Array Name :=
    #[`foundation_bundle, `incidence_bundle, `verification_bundle, `block_verification_bundle]
  let names := env.checked.get.constants.fold (fun names name _ =>
    match env.getModuleIdxFor? name with
    | some idx =>
      if modules.contains env.header.moduleNames[idx.toNat]! then names.push name
      else names
    | none => names) (#[] : Array Name)
  unless !names.isEmpty do
    throwError "Audit found no declarations in the checked bundles"
  for moduleName in modules do
    unless names.any (fun name => match env.getModuleIdxFor? name with
        | some idx => env.header.moduleNames[idx.toNat]! == moduleName
        | none => false) do
      throwError "Audit found no declarations in {moduleName}"
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  for name in names do
    let some info := env.checked.get.find? name
      | throwError "Missing declaration {name}"
    if info.isUnsafe || info.isPartial then
      throwError "Unsafe or partial local declaration is forbidden: {name}"
    match info with
    | .axiomInfo _ => throwError "Local axiom is forbidden: {name}"
    | _ => pure ()
    let axioms ← collectAxioms name
    let rejected := axioms.filter (fun axiomName => !allowed.contains axiomName)
    unless rejected.isEmpty do
      throwError "{name} depends on forbidden axioms: {rejected}"
  logInfo m!"AUDIT_COMPLETE: {names.size} bundle declarations; only propext, Classical.choice, Quot.sound are permitted."
end CompleteAuditSource000

