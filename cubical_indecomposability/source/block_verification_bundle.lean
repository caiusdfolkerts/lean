      norm_num
    · change (-1 : ℝ) / 2 + 1 / 2 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
    · change (-1 : ℝ) / 2 + 1 / 2 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
    · change (0 : ℝ) + 0 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
  · ext i
    fin_cases i
    · change (1 : ℝ) / 2 + 1 / 2 = ((1 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
    · change (-1 : ℝ) / 2 + 1 / 2 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
    · change (-1 : ℝ) / 2 + 1 / 2 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
    · change (0 : ℝ) + 0 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
  · ext i
    fin_cases i
    · change (-1 : ℝ) / 2 + 1 / 2 = ((0 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
      norm_num
    · change (1 : ℝ) / 2 + 1 / 2 = ((1 : ℤ) : ℝ) / ((1 : ℤ) : ℝ)
