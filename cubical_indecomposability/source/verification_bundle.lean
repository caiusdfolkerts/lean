def bundle_5707eade40_finiteCheckIndex {n lo width : ℕ} (h : lo + width ≤ n)
    (j : Fin width) : Fin n :=
  ⟨lo + j.val, by have := j.isLt; omega⟩

theorem bundle_5707eade40_finiteCheck_cover {n lo width : ℕ} {P : Fin n → Prop}
