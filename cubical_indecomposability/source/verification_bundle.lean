/- Original source: Papers/ParallelMaps.lean -/
section VerificationSource020







/-!
# Parallel maps on actual polytope edges

The edge relation is the geometric one: two distinct extreme vertices on an
exposed one-dimensional face. The local maximum principle is derived from
the finite face pivot, and all statements below concern this actual graph.
-/

noncomputable section
namespace Papers.Polytopes
open Set
open scoped Pointwise RealInnerProductSpace
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope

variable {d : ℕ}

def IsParallelMap (P : ConvexPolytope d) (f : E d → E d) : Prop :=
  ∀ x ∈ P.vertices, ∀ y ∈ P.vertices, GeneralVertexStep P x y →
    ∃ c : ℝ, f y - f x = c • (y - x)

def IsPositiveParallelMap (P : ConvexPolytope d) (f : E d → E d) : Prop :=
  ∀ x ∈ P.vertices, ∀ y ∈ P.vertices, GeneralVertexStep P x y →
    ∃ c : ℝ, 0 < c ∧ f y - f x = c • (y - x)

theorem IsPositiveParallelMap.parallel {P : ConvexPolytope d} {f : E d → E d}
    (h : IsPositiveParallelMap P f) : IsParallelMap P f := by
  intro x hx y hy hxy
  obtain ⟨c, _, hc⟩ := h x hx y hy hxy
  exact ⟨c, hc⟩

def IsHomothetyOnVertices (P : ConvexPolytope d) (f : E d → E d) : Prop :=
  ∃ a : ℝ, ∃ b : E d, ∀ v ∈ P.vertices, f v = a • v + b

/-- Failure of a global linear maximum gives an actual increasing edge. -/
theorem exists_increasing_edge (P : ConvexPolytope d) (l : E d →L[ℝ] ℝ)
    {x z : E d} (hx : x ∈ P.vertices) (hz : z ∈ P.vertices) (hlt : l x < l z) :
    ∃ y : E d, GeneralVertexStep P x y ∧ l x < l y := by
  have hxFace : P.IsFace ({x} : Set (E d)) := vertex_isFace P hx
  obtain ⟨g, hg⟩ := hxFace.1 hxFace.2
  let w : E d := (InnerProductSpace.toDual ℝ (E d)).symm l
  have hw (y : E d) : inner ℝ w y = l y := InnerProductSpace.toDual_symm_apply
  have hconst : ∀ y ∈ ({x} : Set (E d)), inner ℝ w y = inner ℝ w x := by
    rintro y rfl
    rfl
  obtain ⟨F, hF, hproper, himprove⟩ := perno_parametrico_crescente_monotono
    P hxFace g hg x (Set.mem_singleton x) w hconst ⟨z, hz, by simpa only [hw] using hlt⟩
  have hdim : 1 ≤ faceDim F := by
    have h := faceDim_lt_of_ssubset P hxFace hF hproper
    rw [faceDim_singleton] at h
    omega
  obtain ⟨e, he, hde, hxe, heF⟩ := edge_inside_face_at_vertex P hF hx
    (hproper.1 (Set.mem_singleton x)) hdim
  obtain ⟨y, hy, hye, hyx, _⟩ := spigolo_segmento P he hde hx hxe
  refine ⟨y, ⟨hy, hyx.symm, e, he, hde, hxe, hye⟩, ?_⟩
  have hyout : y ∉ ({x} : Set (E d)) := by simpa only [Set.mem_singleton_iff] using hyx
  simpa only [hw] using himprove y (heF hye) hyout

theorem positive_parallel_max_reflect {P : ConvexPolytope d} {f : E d → E d}
    (hf : IsPositiveParallelMap P f) (l : E d →L[ℝ] ℝ)
    {x : E d} (hx : x ∈ P.vertices)
    (hmax : ∀ y ∈ P.vertices, l (f y) ≤ l (f x)) :
    ∀ y ∈ P.vertices, l y ≤ l x := by
  intro z hz
  by_contra hnot
  obtain ⟨y, hxy, hlt⟩ := exists_increasing_edge P l hx hz (lt_of_not_ge hnot)
  obtain ⟨c, hc, heq⟩ := hf x hx y hxy.1 hxy
  have h := congrArg l heq
  simp only [map_sub, map_smul, smul_eq_mul] at h
  have hle := hmax y hxy.1
  nlinarith

/-- A parallel map remains constant under a supporting functional along
each face on which that functional is constant. -/
theorem parallel_constant_on_face {P : ConvexPolytope d} {f : E d → E d}
    (hf : IsParallelMap P f) {F : Set (E d)} (hF : P.IsFace F)
    (l : E d →L[ℝ] ℝ) (hconst : ∀ x ∈ F, ∀ y ∈ F, l x = l y)
    {x y : E d} (hx : x ∈ P.vertices) (hy : y ∈ P.vertices)
    (hxF : x ∈ F) (hyF : y ∈ F) : l (f x) = l (f y) := by
  classical
  let Q := facePolytope P hF
  have hxQ : x ∈ Q.vertices := Finset.mem_filter.mpr ⟨hx, hxF⟩
  have hyQ : y ∈ Q.vertices := Finset.mem_filter.mpr ⟨hy, hyF⟩
  have hw := balinski_light_general Q hxQ hyQ
  have hwalk : ∀ z, Relation.ReflTransGen (GeneralVertexStep Q) x z →
      z ∈ Q.vertices ∧ l (f z) = l (f x) := by
    intro z hpath
    induction hpath with
    | refl => exact ⟨hxQ, rfl⟩
    | @tail u v hpath huv ih =>
      have hu := Finset.mem_filter.mp ih.1
      have hv := Finset.mem_filter.mp huv.1
      obtain ⟨_, hne, e, he, hde, hue, hve⟩ := huv
      have hstep : GeneralVertexStep P u v :=
        ⟨hv.1, hne, e, isFace_of_facePolytope P hF he, hde, hue, hve⟩
      obtain ⟨c, hc⟩ := hf u hu.1 v hv.1 hstep
      have h := congrArg l hc
      simp only [map_sub, map_smul, smul_eq_mul, hconst v hv.2 u hu.2,
        sub_self, mul_zero, sub_eq_zero] at h
      exact ⟨Finset.mem_filter.mpr hv, h.trans ih.2⟩
  exact (hwalk y hw).2.symm

theorem positive_parallel_max_preserve {P : ConvexPolytope d} {f : E d → E d}
    (hf : IsPositiveParallelMap P f) (l : E d →L[ℝ] ℝ)
    {x : E d} (hx : x ∈ P.vertices)
    (hmax : ∀ y ∈ P.vertices, l y ≤ l x) :
    ∀ y ∈ P.vertices, l (f y) ≤ l (f x) := by
  classical
  obtain ⟨w, hw, hwm⟩ := P.vertices.exists_max_image (fun y => l (f y)) P.vertices_nonempty
  have hwmax := positive_parallel_max_reflect hf l hw hwm
  let F : Set (E d) := {z ∈ P.toSet | ∀ y ∈ P.toSet, l y ≤ l z}
  have hxF : x ∈ F := ⟨subset_convexHull ℝ _ hx, le_su_toSet P l hmax⟩
  have hwF : w ∈ F := ⟨subset_convexHull ℝ _ hw, le_su_toSet P l hwmax⟩
  have hF : P.IsFace F := ⟨by intro _; exact ⟨l, rfl⟩, ⟨x, hxF⟩⟩
  have hconst : ∀ a ∈ F, ∀ b ∈ F, l a = l b := by
    intro a ha b hb
    exact le_antisymm (hb.2 a ha.1) (ha.2 b hb.1)
  have heq := parallel_constant_on_face hf.parallel hF l hconst hx hw hxF hwF
  intro y hy
  exact (hwm y hy).trans_eq heq.symm

theorem positive_parallel_strict_max_preserve {P : ConvexPolytope d} {f : E d → E d}
    (hf : IsPositiveParallelMap P f) (l : E d →L[ℝ] ℝ)
    {x : E d} (hx : x ∈ P.vertices)
    (hstrict : ∀ y ∈ P.vertices, y ≠ x → l y < l x) :
    ∀ y ∈ P.vertices, y ≠ x → l (f y) < l (f x) := by
  have hmax : ∀ y ∈ P.vertices, l y ≤ l x := by
    intro y hy
    by_cases h : y = x
    · simp [h]
    · exact (hstrict y hy h).le
  have hfm := positive_parallel_max_preserve hf l hx hmax
  intro y hy hyx
  refine lt_of_le_of_ne (hfm y hy) ?_
  intro heq
  have hym : ∀ z ∈ P.vertices, l (f z) ≤ l (f y) := by
    intro z hz
    exact (hfm z hz).trans_eq heq.symm
  have h := positive_parallel_max_reflect hf l hy hym x hx
  exact (not_le_of_gt (hstrict y hy hyx)) h

theorem exists_vertex_exposer (P : ConvexPolytope d) {x : E d} (hx : x ∈ P.vertices) :
    ∃ l : E d →L[ℝ] ℝ, ∀ y ∈ P.vertices, y ≠ x → l y < l x := by
  obtain ⟨l, hl⟩ := (vertex_isFace P hx).1 (Set.singleton_nonempty x)
  have hm : x ∈ {z ∈ P.toSet | ∀ y ∈ P.toSet, l y ≤ l z} := by
    rw [← hl]
    exact Set.mem_singleton x
  refine ⟨l, ?_⟩
  intro y hy hyx
  have hybody : y ∈ P.toSet := subset_convexHull ℝ _ hy
  refine lt_of_le_of_ne (hm.2 y hybody) ?_
  intro heq
  apply hyx
  have hyface : y ∈ ({x} : Set (E d)) := by
    rw [hl]
    exact ⟨hybody, fun z hz => (hm.2 z hz).trans_eq heq.symm⟩
  exact hyface

def positiveMapPolytope (P : ConvexPolytope d) (f : E d → E d)
    (hf : IsPositiveParallelMap P f) : ConvexPolytope d := by
  classical
  apply polytopeOfStrictMinima (P.vertices.image f) (P.vertices_nonempty.image f)
  intro x hx
  obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hx
  obtain ⟨l, hl⟩ := exists_vertex_exposer P hv
  refine ⟨-l, ?_⟩
  intro y hy hyne
  obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hy
  have hwv : w ≠ v := by intro h; exact hyne (congrArg f h)
  simpa only [ContinuousLinearMap.neg_apply, neg_lt_neg_iff] using
    positive_parallel_strict_max_preserve hf l hv hl w hw hwv

@[simp] theorem positiveMapPolytope_vertices (P : ConvexPolytope d) (f : E d → E d)
    (hf : IsPositiveParallelMap P f) :
    (positiveMapPolytope P f hf).vertices = P.vertices.image f := rfl

end Papers.Polytopes
end
end VerificationSource020

/- Original source: CubicalIndecomposability/Redrawings.lean -/
section VerificationSource021








/-!
# Every parallel redrawing is a homothety and a translation

The algebraic certificates concern arbitrary real assignments at all 144
vertices.  This file connects their equations to the actual exposed edges
of the convex polytope, so the resulting rigidity statement has its usual
geometric meaning.
-/

set_option autoImplicit false

noncomputable section

namespace CubicalIndecomposability

open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope
open Papers.Polytopes

/-- The primitive integer direction and the actual edge difference span
the same line.  This equality also records the precise positive factor. -/
theorem edge_difference (e : Fin 404) (i : Fin 4) :
    p (edgeVertex e 1) i - p (edgeVertex e 0) i =
      (Rigidity.multiplier e : ℝ) /
        ((q (edgeVertex e 0) 4 : ℝ) * (q (edgeVertex e 1) 4 : ℝ)) *
          (Rigidity.direction e i : ℝ) := by
  have h0 : (q (edgeVertex e 0) 4 : ℝ) ≠ 0 :=
    ne_of_gt (homogeneous_last_real_pos _)
  have h1 : (q (edgeVertex e 1) 4 : ℝ) ≠ 0 :=
    ne_of_gt (homogeneous_last_real_pos _)
  have hs :
      (q (edgeVertex e 1) i.castSucc : ℝ) * (q (edgeVertex e 0) 4 : ℝ) -
        (q (edgeVertex e 0) i.castSucc : ℝ) * (q (edgeVertex e 1) 4 : ℝ) =
          (Rigidity.multiplier e : ℝ) * (Rigidity.direction e i : ℝ) := by
    exact_mod_cast Rigidity.direction_scale e i
  simp only [p_apply]
  field_simp [h0, h1]
  nlinarith [hs]

/-- A parallel redrawing in the paper's vertex-indexed notation. The
adjacency relation is the actual edge relation of the real convex hull. -/
def IsParallelVertexAssignment (h : Fin 144 → E 4) : Prop :=
  ∀ u v, GeneralVertexStep polytope (p u) (p v) →
    ∃ a : ℝ, h v - h u = a • (p v - p u)

/-- Parallelism on actual edges implies the exact algebraic constraints. -/
theorem constraints_of_vertex_assignment (h : Fin 144 → E 4)
    (hh : IsParallelVertexAssignment h) :
    Rigidity.Constraints (fun v i => h v i) := by
  intro e i
  obtain ⟨a, ha⟩ := hh (edgeVertex e 0) (edgeVertex e 1) (declaredEdge e)
  have hc (j : Fin 4) :
      h (edgeVertex e 1) j - h (edgeVertex e 0) j =
        a * (p (edgeVertex e 1) j - p (edgeVertex e 0) j) := by
    have hj := congrArg (fun x : E 4 => x j) ha
    simpa only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul] using hj
  unfold Rigidity.crossRow
  rw [hc i, hc (Rigidity.pivot e), edge_difference e i,
    edge_difference e (Rigidity.pivot e)]
  ring

/-- The rigidity formula for every real assignment to the vertices.
The domain here is exactly the vertex labels, as in equation (1) of the paper. -/
theorem parallel_vertex_assignment_formula (h : Fin 144 → E 4)
    (hh : IsParallelVertexAssignment h) (v : Fin 144) :
    h v = (h 3 0 - h 1 0) • p v + h 1 := by
  ext i
  have hi := Rigidity.constraints_homothetic (fun v i => h v i)
    (constraints_of_vertex_assignment h hh) v i
  simpa only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, p_apply,
    mul_comm, add_comm] using hi

/-- Exact classification of the vertex-indexed redrawing space. -/
theorem parallel_vertex_assignment_iff (h : Fin 144 → E 4) :
    IsParallelVertexAssignment h ↔
      ∃ a : ℝ, ∃ b : E 4, ∀ v, h v = a • p v + b := by
  constructor
  · intro hh
    exact ⟨h 3 0 - h 1 0, h 1, parallel_vertex_assignment_formula h hh⟩
  · rintro ⟨a, b, hh⟩
    intro u v _
    refine ⟨a, ?_⟩
    rw [hh v, hh u, smul_sub]
    abel

/-- Restriction of a parallel map to the enumerated vertices. -/
theorem parallel_vertex_assignment_of_map (f : E 4 → E 4)
    (hf : IsParallelMap polytope f) :
    IsParallelVertexAssignment (fun v => f (p v)) := by
  intro u v huv
  exact hf (p u) (vertex_mem _) (p v) (vertex_mem _) huv

/-- Parallelism on the listed actual edges implies all certified linear
constraints. No converse or completeness assertion is assumed here. -/
theorem constraints_of_parallel (f : E 4 → E 4)
    (hf : IsParallelMap polytope f) :
    Rigidity.Constraints (fun v i => f (p v) i) :=
  constraints_of_vertex_assignment _ (parallel_vertex_assignment_of_map f hf)

/-- A fully explicit rigidity formula.  Vertex 1 is the origin and
vertex 3 is the first coordinate unit vector, so their values determine
the translation and the scale. -/
theorem parallel_redrawing_formula (f : E 4 → E 4)
    (hf : IsParallelMap polytope f) (v : Fin 144) :
    f (p v) = (f (p 3) 0 - f (p 1) 0) • p v + f (p 1) := by
  exact parallel_vertex_assignment_formula _ (parallel_vertex_assignment_of_map f hf) v

/-- Every parallel redrawing of the actual edge graph is a uniform
scaling and a translation, with no restriction on its real edge scalars. -/
theorem parallel_redrawings_homothetic (f : E 4 → E 4)
    (hf : IsParallelMap polytope f) : IsHomothetyOnVertices polytope f := by
  refine ⟨f (p 3) 0 - f (p 1) 0, f (p 1), ?_⟩
  intro v hv
  rw [polytope_vertices] at hv
  obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hv
  exact parallel_redrawing_formula f hf i

end CubicalIndecomposability
end
end VerificationSource021

/- Original source: Papers/ParallelMinkowski.lean -/
section VerificationSource022






/-!
# The convex-geometric bridge for parallel maps

Supporting functionals connect the edge equations to actual Minkowski sums.
The hull equalities here are equalities of sets in Euclidean space, not
formal sums or relations added to the definition of a parallel map.
-/

noncomputable section
namespace Papers.Polytopes
open Set
open scoped Pointwise Classical
open LeanEval.Geometry.PlatonicClassification
open LeanEval.Geometry.PlatonicClassification.ConvexPolytope

variable {d : ℕ}

theorem exists_vertex_exposer_body (P : ConvexPolytope d) {v : E d}
    (hv : v ∈ P.vertices) :
    ∃ l : E d →L[ℝ] ℝ,
      (∀ x ∈ P.toSet, l x ≤ l v) ∧
      (∀ x ∈ P.toSet, l x = l v → x = v) := by
  obtain ⟨l, hl⟩ := (vertex_isFace P hv).1 (Set.singleton_nonempty v)
  have hvmax : v ∈ {x ∈ P.toSet | ∀ y ∈ P.toSet, l y ≤ l x} := by
    rw [← hl]
    exact Set.mem_singleton v
  refine ⟨l, hvmax.2, ?_⟩
  intro x hx heq
  have hxf : x ∈ ({v} : Set (E d)) := by
    rw [hl]
    exact ⟨hx, fun y hy => (hvmax.2 y hy).trans_eq heq.symm⟩
  exact hxf

/-- Two positive parallel maps summing to each original vertex produce
an equality of the corresponding convex bodies. -/
theorem positive_parallel_sum_eq (P : ConvexPolytope d) (f g : E d → E d)
    (hf : IsPositiveParallelMap P f) (hg : IsPositiveParallelMap P g)
    (hsum : ∀ v ∈ P.vertices, f v + g v = v) :
    P.toSet = (positiveMapPolytope P f hf).toSet +
      (positiveMapPolytope P g hg).toSet := by
  let A := positiveMapPolytope P f hf
  let B := positiveMapPolytope P g hg
  apply Set.Subset.antisymm
  · apply convexHull_min _ ((convex_convexHull ℝ _).add (convex_convexHull ℝ _))
    intro v hv
    exact Set.mem_add.mpr ⟨f v, subset_convexHull ℝ _ (Finset.mem_image_of_mem f hv),
      g v, subset_convexHull ℝ _ (Finset.mem_image_of_mem g hv), hsum v hv⟩
  · rintro z ⟨a, ha, b, hb, rfl⟩
    by_contra hout
    obtain ⟨l, c, hbound, hc⟩ := geometric_hahn_banach_closed_point
      (convex_convexHull ℝ (P.vertices : Set (E d)))
      (P.vertices.finite_toSet.isClosed_convexHull ℝ) hout
    obtain ⟨v, hv, hvm⟩ := P.vertices.exists_max_image l P.vertices_nonempty
    have hfa : ∀ q ∈ A.vertices, l q ≤ l (f v) := by
      intro q hq
      obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      exact positive_parallel_max_preserve hf l hv hvm w hw
    have hgb : ∀ q ∈ B.vertices, l q ≤ l (g v) := by
      intro q hq
      obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
      exact positive_parallel_max_preserve hg l hv hvm w hw
    have hla := le_su_toSet A l hfa a ha
    have hlb := le_su_toSet B l hgb b hb
    have hvlt := hbound v (subset_convexHull ℝ _ hv)
    have hlv : l (f v) + l (g v) = l v := by rw [← map_add, hsum v hv]
    rw [map_add] at hc
    linarith

theorem positiveMap_homothetic_on_vertices (P : ConvexPolytope d) (f : E d → E d)
    (hf : IsPositiveParallelMap P f)
    (hcopy : IsHomotheticCopy P (positiveMapPolytope P f hf)) :
    IsHomothetyOnVertices P f := by
  obtain ⟨r, hr, b, hcopy⟩ := hcopy
  refine ⟨r, b, ?_⟩
  intro v hv
  obtain ⟨l, hmax, hunique⟩ := exists_vertex_exposer_body P hv
  have hvmax : ∀ w ∈ P.vertices, l w ≤ l v :=
    fun w hw => hmax w (subset_convexHull ℝ _ hw)
  have hfmax := positive_parallel_max_preserve hf l hv hvmax
  have hfv : f v ∈ (positiveMapPolytope P f hf).toSet :=
    subset_convexHull ℝ _ (Finset.mem_image_of_mem f hv)
  rw [hcopy] at hfv
  obtain ⟨u, hu, heq⟩ := hfv
  have hrv : r • v + b ∈ (positiveMapPolytope P f hf).toSet := by
    rw [hcopy]
    exact Set.mem_image_of_mem _ (subset_convexHull ℝ _ hv)
  have hrvle : l (r • v + b) ≤ l (f v) := by
    apply le_su_toSet (positiveMapPolytope P f hf) l _ _ hrv
    intro q hq
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hq
    exact hfmax w hw
  have hlu : l u = l v := by
    rw [← heq] at hrvle
    simp only [map_add, map_smul, smul_eq_mul] at hrvle
    have := hmax u hu
    nlinarith
  have huv := hunique u hu hlu
  simpa only [huv] using heq.symm

/-- For any vertexwise choices in a Minkowski decomposition, their first
coordinates generate the entire first summand. -/
theorem minkowski_component_hull (P A B : ConvexPolytope d)
    (hP : P.toSet = A.toSet + B.toSet) (f g : E d → E d)
    (hf : ∀ v ∈ P.vertices, f v ∈ A.toSet)
    (hg : ∀ v ∈ P.vertices, g v ∈ B.toSet)
    (hsum : ∀ v ∈ P.vertices, f v + g v = v) :
    A.toSet = convexHull ℝ (f '' (P.vertices : Set (E d))) := by
  apply Set.Subset.antisymm
  · intro a ha
    by_contra hout
    have hfinite : (f '' (P.vertices : Set (E d))).Finite := P.vertices.finite_toSet.image f
    obtain ⟨l, c, hbound, hc⟩ := geometric_hahn_banach_closed_point
      (convex_convexHull ℝ _) (hfinite.isClosed_convexHull ℝ) hout
    obtain ⟨v, hv, hvm⟩ := P.vertices.exists_max_image l P.vertices_nonempty
    have habody : a + g v ∈ P.toSet := by
      rw [hP]
      exact Set.mem_add.mpr ⟨a, ha, g v, hg v hv, rfl⟩
    have hle := le_su_toSet P l hvm (a + g v) habody
    have hlt := hbound (f v) (subset_convexHull ℝ _ (Set.mem_image_of_mem f hv))
    have hvalue := congrArg l (hsum v hv)
    simp only [map_add] at hle hvalue
    linarith
  · apply convexHull_min _ (convex_convexHull ℝ _)
    rintro _ ⟨v, hv, rfl⟩
    exact hf v hv

/-- The choice of the component at a vertex induces a parallel map on
every actual edge of the sum. -/
theorem minkowski_component_parallel (P A B : ConvexPolytope d)
    (hP : P.toSet = A.toSet + B.toSet) (f g : E d → E d)
    (hf : ∀ v ∈ P.vertices, f v ∈ A.toSet)
    (hg : ∀ v ∈ P.vertices, g v ∈ B.toSet)
    (hsum : ∀ v ∈ P.vertices, f v + g v = v) :
    IsParallelMap P f := by
  intro x hx y hy hxy
  obtain ⟨_, hne, F, hF, hdF, hxF, hyF⟩ := hxy
  obtain ⟨l, hl⟩ := hF.1 hF.2
  have hxmax := hxF
  have hymax := hyF
  rw [hl] at hxmax hymax
  have hswap₁ : f x + g y ∈ P.toSet := by
    rw [hP]
    exact Set.mem_add.mpr ⟨f x, hf x hx, g y, hg y hy, rfl⟩
  have hswap₂ : f y + g x ∈ P.toSet := by
    rw [hP]
    exact Set.mem_add.mpr ⟨f y, hf y hy, g x, hg x hx, rfl⟩
  have hle₁ := hxmax.2 (f x + g y) hswap₁
  have hle₂ := hymax.2 (f y + g x) hswap₂
  have hvalx : l (f x) + l (g x) = l x := by rw [← map_add, hsum x hx]
  have hvaly : l (f y) + l (g y) = l y := by rw [← map_add, hsum y hy]
  have hxyval : l x = l y := le_antisymm (hymax.2 x hxmax.1) (hxmax.2 y hymax.1)
  have hswapval : l (f x + g y) = l x := by
    simp only [map_add] at hle₁ hle₂ ⊢
    linarith
  have hswapF : f x + g y ∈ F := by
    rw [hl]
    exact ⟨hswap₁, fun z hz => (hxmax.2 z hz).trans_eq hswapval.symm⟩
  rw [edge_eq_segment P hF hdF hx hy hxF hyF hne] at hswapF
  obtain ⟨a, b, _, _, hab, hpoint⟩ := hswapF
  refine ⟨a, ?_⟩
  have hyid := hsum y hy
  calc
    f y - f x = (f y+g y) - (f x + g y) := by abel
    _ = y - (f x + g y) := by rw [hyid]
    _ = y - (a • x + b • y) := by rw [hpoint]
    _ = a • (y - x) := by
      have hb : b = 1 - a := by linarith
      rw [hb]
      module

def homothetyAffineMap (r : ℝ) (b : E d) : E d →ᵃ[ℝ] E d where
  toFun x := r • x + b
  linear := r • LinearMap.id
  map_vadd' p v := by
    simp only [vadd_eq_add, smul_add, LinearMap.smul_apply, LinearMap.id_apply]
    abel

theorem hull_homothety_on_vertices (P : ConvexPolytope d) (f : E d → E d)
    (r : ℝ) (b : E d) (h : ∀ v ∈ P.vertices, f v = r • v + b) :
    convexHull ℝ (f '' (P.vertices : Set (E d))) =
      (fun x => r • x + b) '' P.toSet := by
  have himage : f '' (P.vertices : Set (E d)) =
      homothetyAffineMap r b '' (P.vertices : Set (E d)) := by
    apply Set.image_congr
    exact h
  rw [himage, ← (homothetyAffineMap r b).image_convexHull]
  rfl

/-- A genuine nontrivial Minkowski decomposition yields a nonhomothetic
parallel map. No summand-reconstruction theorem is assumed here. -/
theorem parallel_map_of_minkowski_decomposable (P : ConvexPolytope d)
    (hP : MinkowskiDecomposable P) :
    ∃ f : E d → E d, IsParallelMap P f ∧ ¬IsHomothetyOnVertices P f := by
  obtain ⟨A, B, hsum, hA, hB⟩ := hP
  have hex : ∀ v : E d, ∃ a b : E d, v ∈ P.vertices →
      a ∈ A.toSet ∧ b ∈ B.toSet ∧ a + b = v := by
    intro v
    by_cases hv : v ∈ P.vertices
    · have hmem : v ∈ A.toSet + B.toSet := by
        rw [← hsum]
        exact subset_convexHull ℝ _ hv
      obtain ⟨a, ha, b, hb, hab⟩ := hmem
      exact ⟨a, b, fun _ => ⟨ha, hb, hab⟩⟩
    · exact ⟨0, 0, fun h => (hv h).elim⟩
  choose f g hfg using hex
  have hf := fun v hv => (hfg v hv).1
  have hg := fun v hv => (hfg v hv).2.1
  have hid := fun v hv => (hfg v hv).2.2
  refine ⟨f, minkowski_component_parallel P A B hsum f g hf hg hid, ?_⟩
  rintro ⟨r, b, hrb⟩
  have hAhull := minkowski_component_hull P A B hsum f g hf hg hid
  by_cases hr : 0 < r
  · apply hA
    refine ⟨r, hr, b, ?_⟩
    rw [hAhull, hull_homothety_on_vertices P f r b hrb]
  · have hBsum : P.toSet = B.toSet + A.toSet := hsum.trans (add_comm _ _)
    have hBident : ∀ v ∈ P.vertices, g v + f v = v := by
      intro v hv
      rw [add_comm, hid v hv]
    have hBhull := minkowski_component_hull P B A hBsum g f hg hf hBident
    have hgformula : ∀ v ∈ P.vertices, g v = (1 - r) • v + -b := by
      intro v hv
      have h := hid v hv
      rw [hrb v hv] at h
      calc
        g v = v - (r • v + b) := by
          apply eq_sub_iff_add_eq.mpr
          simpa only [add_comm] using h
        _ = (1 - r) • v + -b := by module
    apply hB
    refine ⟨1 - r, by linarith, -b, ?_⟩
    rw [hBhull, hull_homothety_on_vertices P g (1 - r) (-b) hgformula]

end Papers.Polytopes
end
