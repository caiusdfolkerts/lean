/- The top face contains every vertex. A structural proof avoids
normalizing the union of all anchor buckets and repeatedly testing subset
membership in the full vertex set. Only the short interval table is checked. -/
theorem bundle_a018773121_lowerTop_interval :
    lowerFacets (1068 : Fin 1069) = Finset.Ico (938 : Fin 1069) 1068 := by
  decide +kernel

theorem bundle_a018773121_lowerTop_rank (j : Fin 1069) :
    j ∈ lowerFacets (1068 : Fin 1069) ↔ (faceRank j).val = 3 := by
  rw [bundle_a018773121_lowerTop_interval, Finset.mem_Ico]
  change (938 ≤ j.val ∧ j.val < 1068) ↔ (faceRank j).val = 3
  unfold faceRank
  split_ifs <;> simp_all <;> omega

theorem bundle_a018773121_lower1068 :
    bundle_a018773121_lowerComputed (1068 : Fin 1069) = lowerFacets (1068 : Fin 1069) := by
  ext j
  change j ∈ (bundle_a018773121_lowerCandidates (1068 : Fin 1069)).filter _ ↔ _
  rw [Finset.mem_filter, bundle_a018773121_lowerTop_rank]
  constructor
  · intro h
    have hr := h.2.1
    change (faceRank j).val + 1 = 4 at hr
    omega
  · intro h
    have hr : faceRank j = bundle_a018773121_previousRank (1068 : Fin 1069) := by
      apply Fin.ext
      change (faceRank j).val = 3
      exact h
    have hb := bundle_a018773121_anchoredFaces_self j
    rw [hr] at hb
    refine ⟨Finset.mem_biUnion.mpr ?_, ?_, ?_⟩
    · exact ⟨faceAnchor j, Finset.mem_univ _, hb⟩
    · change (faceRank j).val + 1 = 4
      omega
    · change faceMask j ⊆ Finset.univ
      exact Finset.subset_univ _

