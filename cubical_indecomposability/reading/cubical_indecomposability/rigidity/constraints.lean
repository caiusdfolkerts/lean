def multiplier (e : Fin 404) : ℤ := multiplierTable e.val

def crossRow (h : Assignment) (e : Fin 404) (i : Fin 4) : ℝ :=
  (direction e (pivot e) : ℝ) *
      (h (edgeVertex e 1) i - h (edgeVertex e 0) i) -
    (direction e i : ℝ) *
      (h (edgeVertex e 1) (pivot e) - h (edgeVertex e 0) (pivot e))

/-- All coordinate equations forced by parallel redrawings of the listed edges. -/
def Constraints (h : Assignment) : Prop := ∀ e i, crossRow h e i = 0

end CubicalIndecomposability.Rigidity
