def direction (e : Fin 80) : Fin 4 → ℤ := directionTable e.val

def pivot (e : Fin 80) : Fin 4 := pivotTable e.val

def multiplier (e : Fin 80) : ℤ := multiplierTable e.val

theorem direction_scale : ∀ (e : Fin 80) (i : Fin 4),
    q (edgeVertex e 1) i.castSucc * q (edgeVertex e 0) 4 -
      q (edgeVertex e 0) i.castSucc * q (edgeVertex e 1) 4 =
        multiplier e * direction e i := by decide +kernel

theorem direction_pivot_ne : ∀ e : Fin 80, direction e (pivot e) ≠ 0 := by decide +kernel

theorem multiplier_pos : ∀ e : Fin 80, 0 < multiplier e := by decide +kernel

def crossRow (h : Assignment) (e : Fin 80) (i : Fin 4) : ℝ :=
  (direction e (pivot e) : ℝ) * (h (edgeVertex e 1) i - h (edgeVertex e 0) i) -
    (direction e i : ℝ) * (h (edgeVertex e 1) (pivot e) - h (edgeVertex e 0) (pivot e))

def Constraints (h : Assignment) : Prop := ∀ e i, crossRow h e i = 0

def seeds (h : Assignment) : Fin 7 → ℝ := ![h 1 0, h 1 1, h 1 2, h 1 3, h 3 0, h 5 1, h 9 2]

def hSeeds (h : Assignment) : Fin 7 → ℝ := ![h 8 0, h 8 1, h 8 2, h 8 3, h 10 0, h 12 1, h 24 0]

def fSeeds (h : Assignment) : Fin 6 → ℝ := ![h 24 0, h 24 1, h 24 2, h 24 3, h 25 0, h 28 1]

def coefficients (v : Fin 32) (i : Fin 4) : Fin 7 → ℝ :=
  coefficientTable (4 * v.val + i.val)

def fCoefficients (v : Fin 32) (i : Fin 4) : Fin 6 → ℝ :=
  fCoefficientTable (4 * v.val + i.val)

