theorem zero_of_seeds (h : Assignment) (H : Constraints h)
    (hz : ∀ j : Fin 7, seeds h j = 0) : ∀ v i, h v i = 0 := by
  intro v i
  rw [coordinate_formula h H v i]
  apply Finset.sum_eq_zero
  intro j _
  rw [hz j, mul_zero]

/-- Vanishing on the unit cube G forces the whole redrawing to vanish. -/
theorem determined_by_G (h : Assignment) (H : Constraints h)
    (hG : ∀ v ∈ facetLabels 1, ∀ i, h v i = 0) : ∀ v i, h v i = 0 := by
  apply zero_of_seeds h H
  intro j
  fin_cases j
  · exact hG 1 (by decide +kernel) 0
  · exact hG 1 (by decide +kernel) 1
  · exact hG 1 (by decide +kernel) 2
  · exact hG 1 (by decide +kernel) 3
  · exact hG 3 (by decide +kernel) 0
  · exact hG 5 (by decide +kernel) 1
  · exact hG 9 (by decide +kernel) 2

/-- Vanishing on H also forces the whole redrawing to vanish. -/
theorem determined_by_H (h : Assignment) (H : Constraints h)
    (hH : ∀ v ∈ facetLabels 21, ∀ i, h v i = 0) : ∀ v i, h v i = 0 := by
  have hzero : ∀ k : Fin 7, hSeeds h k = 0 := by
    intro k
    fin_cases k
    · exact hH 8 (by decide +kernel) 0
    · exact hH 8 (by decide +kernel) 1
    · exact hH 8 (by decide +kernel) 2
    · exact hH 8 (by decide +kernel) 3
    · exact hH 10 (by decide +kernel) 0
    · exact hH 12 (by decide +kernel) 1
    · exact hH 24 (by decide +kernel) 0
  apply zero_of_seeds h H
  intro j
  rw [seed_from_H h H j]
  apply Finset.sum_eq_zero
  intro k _
  rw [hzero k, mul_zero]

