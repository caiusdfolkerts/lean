/-- Six evaluations reconstruct the entire restriction to F. Four are
its value at vertex 24, leaving only two scalars after translation. -/
theorem f_reconstruction (h : Assignment) (H : Constraints h)
    (v : Fin 32) (hv : v ∈ facetLabels 5) (i : Fin 4) :
    h v i = ∑ k : Fin 6, fCoefficients v i k * fSeeds h k := by
  change v ∈ ({24, 25, 26, 27, 28, 29, 30, 31} : Finset (Fin 32)) at hv
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact f_reconstruction_vertex024 h H i
  · exact f_reconstruction_vertex025 h H i
  · exact f_reconstruction_vertex026 h H i
  · exact f_reconstruction_vertex027 h H i
  · exact f_reconstruction_vertex028 h H i
  · exact f_reconstruction_vertex029 h H i
  · exact f_reconstruction_vertex030 h H i
  · exact f_reconstruction_vertex031 h H i

/-- The six-evaluation uniqueness criterion used after anchoring a restriction. -/
theorem zero_on_F_of_six (h : Assignment) (H : Constraints h)
    (h24 : ∀ i, h 24 i = 0) (h25 : h 25 0 = 0) (h28 : h 28 1 = 0) :
    ∀ v ∈ facetLabels 5, ∀ i, h v i = 0 := by
  have hz : ∀ k : Fin 6, fSeeds h k = 0 := by
    intro k
    fin_cases k
    · exact h24 0
    · exact h24 1
    · exact h24 2
    · exact h24 3
    · exact h25
    · exact h28
  intro v hv i
  rw [f_reconstruction h H v hv i]
  apply Finset.sum_eq_zero
  intro k _
  rw [hz k, mul_zero]

end CubicalIndecomposability.Block.Rigidity
