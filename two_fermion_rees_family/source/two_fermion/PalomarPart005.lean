  rw [superPolynomialBasis_smul,superSpecialization_polynomial_wedge,map_smul,
    LinearMap.smul_apply,coefficientPairing_basis_left,smul_eq_mul]

theorem strictMultiplicityCreator_diagonal (d : StrictData (K := F) (n := n))
