        · simp [indexLinear,Pi.single_apply,h,Ne.symm h]
    | inr j =>
        by_cases h : j=i
        · subst j; simp [indexLinear,Pi.single_apply]
        · simp [indexLinear,Pi.single_apply,h,Ne.symm h]
  intro j
