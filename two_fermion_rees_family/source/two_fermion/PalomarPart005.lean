/- Literal source: PaperVerification/FermionStrictDescent.lean -/


/-!
# The full strict basis over the original arbitrary coefficient ring

The actual finite quotient has the proved field basis at every maximal
residue field. Reduced Jacobson descent gives a universal basis, and the
literal quotient base-change comparison transports its exact classes to
the original ring, including rings with nilpotents and the zero ring.

-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace PaperVerification.Fermion

open Exterior
open scoped TensorProduct

variable {R : Type*} [CommRing R] {n : ℕ}

local instance FermionStrictDescent_localInst_1 : LinearOrder (Fin n ⊕ Fin n) :=
  LinearOrder.lift' modeRank modeRank_injective

theorem strictCoupledClasses_hasResidueBases (d : StrictData (K := R) (n := n)) :
    HasResidueBases (R := R) (strictCoupledClasses d) := by
  classical
  intro I hI
  letI : I.IsMaximal := hI
  letI : Field (R ⧸ I) := Ideal.Quotient.field I
  let e := strictQuotientBaseChangeEquiv R (R ⧸ I) d
  let b := strictCoupledBasis (d.map (algebraMap R (R ⧸ I)))
  refine ⟨b.map e.symm,?_⟩
  intro z
  apply e.injective
  rw [Module.Basis.map_apply,e.apply_symm_apply]
  change b z=e ((1 : R ⧸ I) ⊗ₜ[R] strictCoupledClasses d z)
  rw [strictQuotientBaseChangeEquiv_class,strictCoupledBasis_apply]

def strictReducedJacobsonBasis [IsReduced R] [IsJacobsonRing R]
    (d : StrictData (K := R) (n := n)) :
    Module.Basis (StrictPowerIndex d.r) R (StrictQuotient d.beta d.phi) := by
  letI := strictCoupled_quotient_finite d
  exact basisOfResidueBases (strictCoupledClasses d) (strictCoupledClasses_hasResidueBases d)

@[simp] theorem strictReducedJacobsonBasis_apply [IsReduced R] [IsJacobsonRing R]
    (d : StrictData (K := R) (n := n)) (z : StrictPowerIndex d.r) :
    strictReducedJacobsonBasis d z=strictCoupledClasses d z := by
  letI := strictCoupled_quotient_finite d
  unfold strictReducedJacobsonBasis
  exact basisOfResidueBases_apply _ _ _

namespace Universal

abbrev StrictRing (d : StrictData (K := R) (n := n)) := Ring d.pairedExtension

/-- The universal coefficient ring already contains all strict phi
coefficients and weights. The unused paired prefactor variables impose no
condition on this strict datum and are harmless polynomial parameters. -/
def strictData (d : StrictData (K := R) (n := n)) :
    StrictData (K := StrictRing d) (n := n) where
  positive_n := d.positive_n
  r := d.r
  positive_r := d.positive_r
  beta := (data d.pairedExtension).beta
  allowed_weights := (data d.pairedExtension).allowed_weights
  phi := (data d.pairedExtension).phi
  highest_phi := (data d.pairedExtension).highest_phi

theorem strictData_specialize (d : StrictData (K := R) (n := n)) :
    (strictData d).map (specialize d.pairedExtension)=d := by
  have hβ : (specialize d.pairedExtension) ∘ (strictData d).beta=d.beta := by
    funext i
    exact specialize_weight d.pairedExtension i
  have hφ : (fun i ↦ MvPolynomial.map (specialize d.pairedExtension)
      ((strictData d).phi i))=d.phi := by
    funext i
    exact data_specialize_phi d.pairedExtension i
  cases d
  simp only [StrictData.map,strictData,data,StrictData.pairedExtension] at hβ hφ ⊢
  congr 1 <;> first | assumption | rfl

end Universal

theorem exists_strictArbitraryRingBasis (d : StrictData (K := R) (n := n)) :
    ∃ b : Module.Basis (StrictPowerIndex d.r) R (StrictQuotient d.beta d.phi),
      ∀ z,b z=strictCoupledClasses d z := by
  classical
  let U := Universal.StrictRing d
  letI : Algebra U R := (Universal.specialize d.pairedExtension).toAlgebra
  let du := Universal.strictData d
  let ds := du.map (algebraMap U R)
  let bu := strictReducedJacobsonBasis du
  let e := strictQuotientBaseChangeEquiv U R du
  have h : ∃ b : Module.Basis (StrictPowerIndex ds.r) R (StrictQuotient ds.beta ds.phi),
      ∀ z,b z=strictCoupledClasses ds z := by
    refine ⟨(bu.baseChange R).map e,?_⟩
    intro z
    simp only [Module.Basis.map_apply, Module.Basis.baseChange_apply]
    change strictQuotientBaseChangeEquiv U R du
      ((1 : R) ⊗ₜ[U] strictReducedJacobsonBasis du
        (show StrictPowerIndex du.r from z)) =
      strictCoupledClasses (du.map (algebraMap U R)) (show StrictPowerIndex du.r from z)
    rw [strictReducedJacobsonBasis_apply,strictQuotientBaseChangeEquiv_class]
  have hd : ds=d := Universal.strictData_specialize d
  exact hd ▸ h

/-- The unrestricted original-ring strict basis, before reindexing by the
paper's ordered pair of exterior supports. -/
def strictArbitraryRingBasis (d : StrictData (K := R) (n := n)) :
    Module.Basis (StrictPowerIndex d.r) R (StrictQuotient d.beta d.phi) :=
  Classical.choose (exists_strictArbitraryRingBasis d)

@[simp] theorem strictArbitraryRingBasis_apply (d : StrictData (K := R) (n := n))
    (z : StrictPowerIndex d.r) : strictArbitraryRingBasis d z=strictCoupledClasses d z :=
  Classical.choose_spec (exists_strictArbitraryRingBasis d) z

end PaperVerification.Fermion
end
end
end BatchFile_265

section BatchFile_266
/- Literal source: PaperVerification/FermionStrictIndex.lean -/


/-!
# Exact original strict monomials over every coefficient ring

The nonnegative prefix-cardinality formulation is equivalent to the paper's
integer arrival heights. A rectangle containing an exponent automatically
has strictly positive arrival height at every step. The exterior order is
the original increasing theta order followed by increasing xi order.

-/

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace PaperVerification.Fermion

open MvPolynomial Exterior Endpoint Newton
open scoped BigOperators TensorProduct

variable {R : Type*} [CommRing R] {n : ℕ}

local instance FermionStrictIndex_localInst_1 : DecidableEq (Fin n ⊕ Fin n) :=
  (interleavedOddOrder n).toDecidableEq

theorem wordHeight_arrival_cast (T S : Finset (Fin n))
    (h : ValidWord (T.disjSum S)) (i : Fin n) :
    (wordHeight (T.disjSum S) (i.val+1) : ℤ)=height T S i := by
  rw [height_eq_prefix_card,wordHeight,Nat.cast_sub (h (i.val+1) (Nat.succ_le_of_lt i.isLt))]
  push_cast
  rfl

theorem strictWordBoxBounds_disjSum_cast (r : Fin n → ℕ) (T S : Finset (Fin n))
    (h : ValidWord (T.disjSum S)) (i : Fin n) :
    (strictWordBoxBounds r (T.disjSum S) i : ℤ)=(r i : ℤ)*height T S i := by
  rw [strictWordBoxBounds,Nat.cast_mul,wordHeight_arrival_cast T S h i]

/-- Actual admissibility of the strict index's two exterior supports. -/
theorem strictIndexValid (d : StrictData (K := R) (n := n)) (z : StrictIndex d) : ValidWord (z.val.1.1.disjSum z.val.1.2) := (validWord_disjSum_iff _ _).mpr (fun i => le_trans (by decide : (0 : ℤ)≤1) (z.property.1 i))
/-- Exact strict power-box inequalities for the unchanged coordinate function. -/
theorem strictIndexPowerBounds (d : StrictData (K := R) (n := n)) (z : StrictIndex d) : ∀ i, Finsupp.equivFunOnFinite.symm z.val.2 i < strictWordBoxBounds d.r (z.val.1.1.disjSum z.val.1.2) i := by
  intro i; have hi := z.property.2 i
  rw [← strictWordBoxBounds_disjSum_cast d.r _ _ (strictIndexValid d z) i] at hi
  exact_mod_cast hi
def strictIndexToPower (d : StrictData (K := R) (n := n)) (z : StrictIndex d) : StrictPowerIndex d.r :=
  ⟨z.val.1.1.disjSum z.val.1.2,⟨⟨Finsupp.equivFunOnFinite.symm z.val.2,strictIndexPowerBounds d z⟩,strictIndexValid d z⟩⟩

def strictPowerToIndex (d : StrictData (K := R) (n := n)) (z : StrictPowerIndex d.r) :
    StrictIndex d := by
  have hW : ValidWord (z.1.toLeft.disjSum z.1.toRight) := by
    rw [Finset.toLeft_disjSum_toRight]
    exact z.2.property
  have hstrict := strictWord_of_polynomialIndex d.r z.1 z.2
  refine ⟨((z.1.toLeft,z.1.toRight),fun i ↦ z.2.val.val i),?_,?_⟩
  · intro i
    rw [←wordHeight_arrival_cast _ _ hW i,Finset.toLeft_disjSum_toRight]
    have hh := hstrict (i.val+1) (Nat.succ_pos _) (Nat.succ_le_of_lt i.isLt)
    have hp : 1≤wordHeight z.1 (i.val+1) := by unfold wordHeight; omega
    exact_mod_cast hp
  · intro i
    rw [←strictWordBoxBounds_disjSum_cast d.r _ _ hW i,Finset.toLeft_disjSum_toRight]
    exact_mod_cast z.2.val.property i

theorem strictPowerIndex_ext {r : Fin n → ℕ}
    {a b : StrictPowerIndex r} (hW : a.1 = b.1)
    (he : a.2.val.val = b.2.val.val) : a = b := by
  rcases a with ⟨W, ⟨⟨e, he'⟩, hW'⟩⟩
  rcases b with ⟨U, ⟨⟨f, hf'⟩, hU'⟩⟩
  dsimp at hW he
  subst U
  subst f
  rfl

def strictIndexEquiv (d : StrictData (K := R) (n := n)) :
    StrictIndex d ≃ StrictPowerIndex d.r where
  toFun := strictIndexToPower d
  invFun := strictPowerToIndex d
  left_inv z := by
    apply Subtype.ext
    simp only [strictIndexToPower,strictPowerToIndex,Finset.toLeft_disjSum,
      Finset.toRight_disjSum,Finsupp.coe_equivFunOnFinite_symm]
  right_inv z := by
    rcases z with ⟨W,⟨⟨e,he⟩,hW⟩⟩
    apply strictPowerIndex_ext
    · exact Finset.toLeft_disjSum_toRight
    · exact Finsupp.equivFunOnFinite_symm_coe e

-- Actual basis monomials put every theta generator before every xi generator.
local instance FermionStrictIndex_localInst_2 : LinearOrder (Fin n ⊕ Fin n) :=
  LinearOrder.lift' modeRank modeRank_injective
local instance FermionStrictIndex_localInst_3 : PartialOrder (Fin n ⊕ Fin n) :=
  (LinearOrder.lift' modeRank modeRank_injective).toPartialOrder
local instance FermionStrictIndex_localInst_4 : Preorder (Fin n ⊕ Fin n) :=
  (LinearOrder.lift' modeRank modeRank_injective).toPreorder
local instance FermionStrictIndex_localInst_5 : LE (Fin n ⊕ Fin n) :=
  (LinearOrder.lift' modeRank modeRank_injective).toLE
local instance FermionStrictIndex_localInst_6 : LT (Fin n ⊕ Fin n) :=
  (LinearOrder.lift' modeRank modeRank_injective).toLT
local instance FermionStrictIndex_localInst_7 : DecidableEq (Fin n ⊕ Fin n) :=
  (LinearOrder.lift' modeRank modeRank_injective).toDecidableEq

@[simp] theorem strictCoupledClasses_indexEquiv (d : StrictData (K := R) (n := n))
    (z : StrictIndex d) : strictCoupledClasses d (strictIndexEquiv d z)=strictClasses d z := by
  rw [strictClasses,boxMonomial_eq_tensor]
  rfl

def strictPaperBasis (d : StrictData (K := R) (n := n)) :
    Module.Basis (StrictIndex d) R (StrictQuotient d.beta d.phi) :=
  (strictArbitraryRingBasis d).reindex (strictIndexEquiv d).symm

@[simp] theorem strictPaperBasis_apply (d : StrictData (K := R) (n := n))
    (z : StrictIndex d) : strictPaperBasis d z=strictClasses d z := by
  rw [strictPaperBasis,Module.Basis.reindex_apply,Equiv.symm_symm,
    strictArbitraryRingBasis_apply,strictCoupledClasses_indexEquiv]

/-- The exact frozen statement of the original strict basis clause, with
all coupled coefficients and every original commutative base ring. -/
theorem strict_basis_claim (d : StrictData (K := R) (n := n)) : StrictBasisClaim d := by
  have he : (strictPaperBasis d : StrictIndex d → StrictQuotient d.beta d.phi)=
      strictClasses d := funext (strictPaperBasis_apply d)
  constructor
  · rw [←he]
    exact (strictPaperBasis d).linearIndependent
  · rw [←he]
    exact (strictPaperBasis d).span_eq

end PaperVerification.Fermion
end
end
end BatchFile_266

