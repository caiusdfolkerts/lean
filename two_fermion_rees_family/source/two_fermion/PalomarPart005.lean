  rw [map_mul,mul_comm]

theorem strictMultiplicityTest_higher (d : StrictData (K := F) (n := n))
    (S T : Finset (OddIndex n)) (hST : S≠T)
    (hweight : multiplicityWordWeight S≤multiplicityWordWeight T)
