    (d : StrictData (K := F) (n := n)) (T : Finset (OddIndex n)) :
    (strictMultiplicityPresentation d).diagonal T=
      multiplyIntoQuotient (K := F) (coupledOrdinaryIdeal d.pairedExtension)
        (creatorWordPolynomial d.creatorData T) := rfl

